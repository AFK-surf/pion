///| t04_trait_fmt: traits, generic static dispatch, enum-wrapped heterogeneous collection

pub trait Summary {
  summary(self : Self) -> String
}

pub trait Serializable {
  to_kv(self : Self) -> String
}

pub struct Article {
  title : String
  author : String
  words : Int
}

pub struct Tweet {
  user : String
  text : String
  likes : Int
}

pub struct Metric {
  name : String
  value : Int
  unit : String
}

/// Closed set of renderable items (Pion has no trait objects).
pub enum Item {
  ArticleItem(Article)
  TweetItem(Tweet)
  MetricItem(Metric)
}

fn shorten(s : String) -> String {
  if s.length() > 20 {
    s.slice(0, 17) + "..."
  } else {
    s
  }
}

impl Summary for Article {
  fn summary(self : Article) -> String {
    "Article: \{self.title} by \{self.author} (\{self.words} words)"
  }
}

impl Serializable for Article {
  fn to_kv(self : Article) -> String {
    "type=article;title=\{self.title};author=\{self.author};words=\{self.words}"
  }
}

impl Summary for Tweet {
  fn summary(self : Tweet) -> String {
    let unit = if self.likes == 1 { "like" } else { "likes" }
    "@\{self.user}: " + shorten(self.text) + " [\{self.likes} " + unit + "]"
  }
}

impl Serializable for Tweet {
  fn to_kv(self : Tweet) -> String {
    "type=tweet;user=\{self.user};likes=\{self.likes}"
  }
}

impl Summary for Metric {
  fn summary(self : Metric) -> String {
    "\{self.name} = \{self.value} \{self.unit}"
  }
}

impl Serializable for Metric {
  fn to_kv(self : Metric) -> String {
    "type=metric;name=\{self.name};value=\{self.value};unit=\{self.unit}"
  }
}

impl Summary for Item {
  fn summary(self : Item) -> String {
    match self {
      ArticleItem(a) => a.summary()
      TweetItem(t) => t.summary()
      MetricItem(m) => m.summary()
    }
  }
}

impl Serializable for Item {
  fn to_kv(self : Item) -> String {
    match self {
      ArticleItem(a) => a.to_kv()
      TweetItem(t) => t.to_kv()
      MetricItem(m) => m.to_kv()
    }
  }
}

pub fn render_all[T : Summary](items : Array[T]) -> String {
  let lines : Array[String] = []
  let mut i = 0
  while i < items.length() {
    lines.push((i + 1).to_string() + ". " + items[i].summary())
    i = i + 1
  }
  lines.join("\n")
}

pub fn describe[T : Summary + Serializable](x : T) -> String {
  x.summary() + " | " + x.to_kv()
}

pub fn mixed() -> Array[Item] {
  [
    ArticleItem(Article::{ title: "Agents and Compilers", author: "Ada", words: 1200 }),
    TweetItem(Tweet::{ user: "grace", text: "shipping structured diagnostics today", likes: 42 }),
    TweetItem(Tweet::{ user: "linus", text: "ok", likes: 1 }),
    MetricItem(Metric::{ name: "p99_latency", value: 87, unit: "ms" }),
  ]
}

pub fn main(world : World) -> Int {
  let items = mixed()
  io_println(world, render_all(items))
  for it in items {
    io_println(world, describe(it))
  }
  let metrics : Array[Metric] = [
    Metric::{ name: "p99_latency", value: 87, unit: "ms" },
    Metric::{ name: "cpu", value: 63, unit: "%" },
  ]
  io_println(world, render_all(metrics))
  0
}

test "tweet truncation boundary" {
  let t20 = Tweet::{ user: "u", text: "12345678901234567890", likes: 0 }
  let t21 = Tweet::{ user: "u", text: "123456789012345678901", likes: 2 }
  debug_assert(t20.summary() == "@u: 12345678901234567890 [0 likes]", "20 chars kept")
  debug_assert(t21.summary() == "@u: 12345678901234567... [2 likes]", "21 chars cut")
}

test "render_all" {
  let empty : Array[Metric] = []
  debug_assert(render_all(empty) == "", "empty")
  debug_assert(render_all(mixed()).starts_with("1. Article: Agents"), "first line")
  debug_assert(describe(mixed()[2]) == "@linus: ok [1 like] | type=tweet;user=linus;likes=1", "describe")
}
