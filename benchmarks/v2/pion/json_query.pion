///| V2 Benchmark 1: json_query (Pion, hand-written lexer + recursive-descent JSON AST)

pub struct JsonEntry {
  key : String
  value : JsonValue
}

pub enum JsonValue {
  JNull
  JBool(Bool)
  JInt(Int)
  JStr(String)
  JArr(Array[JsonValue])
  JObj(Array[JsonEntry])
}

struct Parser {
  src : String
  len : Int
  mut pos : Int
}

fn skip_ws(p : Parser) -> Unit {
  while p.pos < p.len {
    let c = p.src.code_unit_at(p.pos)
    if c == 32 || c == 10 || c == 13 || c == 9 {
      p.pos = p.pos + 1
    } else {
      break
    }
  }
}

fn parse_string_raw(p : Parser) -> String {
  p.pos = p.pos + 1
  let start = p.pos
  let mut has_escape = false
  let mut scan = start
  while scan < p.len {
    let c = p.src.code_unit_at(scan)
    if c == 34 {
      break
    }
    if c == 92 {
      has_escape = true
      break
    }
    scan = scan + 1
  }
  if !has_escape {
    let s = p.src.slice(start, scan)
    p.pos = scan + 1
    return s
  }
  let sb = StringBuilder::new()
  while p.pos < p.len {
    let c = p.src.code_unit_at(p.pos)
    p.pos = p.pos + 1
    if c == 34 {
      return sb.to_string()
    }
    if c == 92 && p.pos < p.len {
      let e = p.src.code_unit_at(p.pos)
      p.pos = p.pos + 1
      if e == 34 {
        sb.write_char('"')
      } else if e == 92 {
        sb.write_char('\\')
      } else if e == 47 {
        sb.write_char('/')
      } else if e == 98 {
        sb.write_char(8.unsafe_to_char())
      } else if e == 102 {
        sb.write_char(12.unsafe_to_char())
      } else if e == 110 {
        sb.write_char('\n')
      } else if e == 114 {
        sb.write_char('\r')
      } else if e == 116 {
        sb.write_char('\t')
      } else {
        sb.write_char(e.unsafe_to_char())
      }
    } else {
      sb.write_char(c.unsafe_to_char())
    }
  }
  sb.to_string()
}

fn parse_array(p : Parser) -> JsonValue {
  p.pos = p.pos + 1
  let items : Array[JsonValue] = []
  skip_ws(p)
  if p.pos < p.len && p.src.code_unit_at(p.pos) == 93 {
    p.pos = p.pos + 1
    return JArr(items)
  }
  while p.pos < p.len {
    items.push(parse_value(p))
    skip_ws(p)
    if p.pos < p.len {
      let c = p.src.code_unit_at(p.pos)
      if c == 44 {
        p.pos = p.pos + 1
        skip_ws(p)
      } else if c == 93 {
        p.pos = p.pos + 1
        return JArr(items)
      } else {
        break
      }
    }
  }
  JArr(items)
}

fn parse_object(p : Parser) -> JsonValue {
  p.pos = p.pos + 1
  let entries : Array[JsonEntry] = []
  skip_ws(p)
  if p.pos < p.len && p.src.code_unit_at(p.pos) == 125 {
    p.pos = p.pos + 1
    return JObj(entries)
  }
  while p.pos < p.len {
    skip_ws(p)
    let key = parse_string_raw(p)
    skip_ws(p)
    if p.pos < p.len && p.src.code_unit_at(p.pos) == 58 {
      p.pos = p.pos + 1
    }
    let v = parse_value(p)
    entries.push(JsonEntry::{ key: key, value: v })
    skip_ws(p)
    if p.pos < p.len {
      let c = p.src.code_unit_at(p.pos)
      if c == 44 {
        p.pos = p.pos + 1
        skip_ws(p)
      } else if c == 125 {
        p.pos = p.pos + 1
        return JObj(entries)
      } else {
        break
      }
    }
  }
  JObj(entries)
}

fn parse_value(p : Parser) -> JsonValue {
  skip_ws(p)
  if p.pos >= p.len {
    return JNull
  }
  let c = p.src.code_unit_at(p.pos)
  if c == 123 {
    return parse_object(p)
  }
  if c == 91 {
    return parse_array(p)
  }
  if c == 34 {
    return JStr(parse_string_raw(p))
  }
  if c == 116 {
    p.pos = p.pos + 4
    return JBool(true)
  }
  if c == 102 {
    p.pos = p.pos + 5
    return JBool(false)
  }
  if c == 110 {
    p.pos = p.pos + 4
    return JNull
  }
  let mut neg = false
  if c == 45 {
    neg = true
    p.pos = p.pos + 1
  }
  let mut acc = 0
  while p.pos < p.len {
    let d = p.src.code_unit_at(p.pos)
    if d >= 48 && d <= 57 {
      acc = acc * 10 + (d - 48)
      p.pos = p.pos + 1
    } else {
      break
    }
  }
  if neg {
    JInt(0 - acc)
  } else {
    JInt(acc)
  }
}

fn obj_get(obj : JsonValue, key : String) -> Option[JsonValue] {
  match obj {
    JObj(entries) => {
      let n = entries.length()
      let mut i = 0
      while i < n {
        if entries[i].key == key {
          return Some(entries[i].value)
        }
        i = i + 1
      }
      None
    }
    _ => None
  }
}

fn map_inc(m : Map[String, Int], k : String) -> Unit {
  match m.get(k) {
    Some(v) => m.set(k, v + 1)
    None => m.set(k, 1)
  }
}

fn write_json_escaped(sb : StringBuilder, s : String) -> Unit {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 34 {
      sb.write_string("\\\"")
    } else if c == 92 {
      sb.write_string("\\\\")
    } else if c == 10 {
      sb.write_string("\\n")
    } else if c == 13 {
      sb.write_string("\\r")
    } else if c == 9 {
      sb.write_string("\\t")
    } else {
      sb.write_char(c.unsafe_to_char())
    }
    i = i + 1
  }
}

fn poly_hash(s : String) -> Int {
  let n = s.length()
  let mut h = 0
  let mut i = 0
  while i < n {
    h = (h * 31 + s.code_unit_at(i)) & 0x3fffffff
    i = i + 1
  }
  h
}

pub fn main(world : World) -> Int {
  let args = args_get(world)
  if args.length() < 2 {
    io_eprintln(world, "usage: json_query <dataset.json>")
    return 2
  }
  let src = match fs_read(world, args[1]) {
    Ok(s) => s
    Err(e) => {
      io_eprintln(world, "read error: " + e)
      return 1
    }
  }
  let p = Parser::{ src: src, len: src.length(), pos: 0 }
  let root = parse_value(p)

  let records = match obj_get(root, "records") {
    Some(JArr(arr)) => arr
    _ => {
      io_eprintln(world, "missing records array")
      return 1
    }
  }

  let role_counts : Map[String, Int] = Map::new()
  let tag_counts : Map[String, Int] = Map::new()
  let out_sb = StringBuilder::new()

  let mut total = 0
  let mut matched = 0
  let mut sum_lat = 0

  let nrec = records.length()
  let mut i = 0
  while i < nrec {
    total = total + 1
    let rec = records[i]
    let user = match obj_get(rec, "user") {
      Some(v) => v
      None => JNull
    }
    let metrics = match obj_get(rec, "metrics") {
      Some(v) => v
      None => JNull
    }
    let note = match obj_get(rec, "note") {
      Some(JStr(s)) => s
      _ => ""
    }
    let id_val = match obj_get(user, "id") {
      Some(JInt(v)) => v
      _ => 0
    }
    let role = match obj_get(user, "role") {
      Some(JStr(s)) => s
      _ => ""
    }
    let active = match obj_get(user, "active") {
      Some(JBool(b)) => b
      _ => false
    }
    let lat = match obj_get(metrics, "latency_ms") {
      Some(JInt(v)) => v
      _ => 0
    }
    let tags = match obj_get(metrics, "tags") {
      Some(JArr(a)) => a
      _ => []
    }

    map_inc(role_counts, role)
    let mut has_prod = false
    let mut t = 0
    while t < tags.length() {
      match tags[t] {
        JStr(ts) => {
          map_inc(tag_counts, ts)
          if ts == "prod" {
            has_prod = true
          }
        }
        _ => ()
      }
      t = t + 1
    }

    if active && lat >= 150 && has_prod {
      matched = matched + 1
      sum_lat = sum_lat + lat
      out_sb.write_string("{\"id\":")
      out_sb.write_string(id_val.to_string())
      out_sb.write_string(",\"role\":\"")
      write_json_escaped(out_sb, role)
      out_sb.write_string("\",\"lat\":")
      out_sb.write_string(lat.to_string())
      out_sb.write_string(",\"note\":\"")
      write_json_escaped(out_sb, note)
      out_sb.write_string("\"}\n")
    }
    i = i + 1
  }

  let mut role_tag_hash = 0
  let rkeys = role_counts.keys()
  let mut ri = 0
  while ri < rkeys.length() {
    let k = rkeys[ri]
    let v = match role_counts.get(k) {
      Some(x) => x
      None => 0
    }
    let kh = poly_hash(k)
    let eh = ((kh * 17 + v) ^ 0x13579) & 0x3fffffff
    role_tag_hash = role_tag_hash ^ eh
    ri = ri + 1
  }
  let tkeys = tag_counts.keys()
  let mut ti = 0
  while ti < tkeys.length() {
    let k = tkeys[ti]
    let v = match tag_counts.get(k) {
      Some(x) => x
      None => 0
    }
    let kh = poly_hash(k)
    let eh = ((kh * 29 + v) ^ 0x2468a) & 0x3fffffff
    role_tag_hash = role_tag_hash ^ eh
    ti = ti + 1
  }

  let out_str = out_sb.to_string()
  let out_hash = poly_hash(out_str)

  io_println(
    world,
    total.to_string() +
    " " +
    matched.to_string() +
    " " +
    sum_lat.to_string() +
    " " +
    role_tag_hash.to_string() +
    " " +
    out_str.length().to_string() +
    " " +
    out_hash.to_string(),
  )
  0
}
