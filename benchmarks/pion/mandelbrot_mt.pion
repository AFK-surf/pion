///| Benchmarks Game: Mandelbrot MT (N = 4000, 1 or 4 threads via scope/spawn/Channel) in Pion
pub val struct StripeResult {
  in_set : Int
  xhash : Int
}

fn compute_stripe(n : Int, y_start : Int, y_end : Int) -> StripeResult {
  let inv_n = 2.0 / (n as Double)
  let mut in_set = 0
  let mut xhash = 0
  let mut y = y_start
  while y < y_end {
    let ci = (y as Double) * inv_n - 1.0
    let mut row_h = 0
    let mut byte_acc = 0
    let mut bit_num = 0
    let mut x = 0
    while x < n {
      let cr = (x as Double) * inv_n - 1.5
      let mut zr = 0.0
      let mut zi = 0.0
      let mut escaped = false
      let mut iter = 0
      while iter < 50 {
        let tr = zr * zr - zi * zi + cr
        let ti = 2.0 * zr * zi + ci
        zr = tr
        zi = ti
        if zr * zr + zi * zi > 4.0 {
          escaped = true
          break
        }
        iter = iter + 1
      }
      byte_acc = (byte_acc << 1) | (if escaped { 0 } else { 1 })
      if !escaped {
        in_set = in_set + 1
      }
      bit_num = bit_num + 1
      if bit_num == 8 {
        row_h = (row_h * 31 + byte_acc) & 0x3fffffff
        byte_acc = 0
        bit_num = 0
      }
      x = x + 1
    }
    if bit_num > 0 {
      byte_acc = byte_acc << (8 - bit_num)
      row_h = (row_h * 31 + byte_acc) & 0x3fffffff
    }
    let row_mix = (row_h ^ ((y * 2654435) & 0x3fffffff)) & 0x3fffffff
    xhash = xhash ^ row_mix
    y = y + 1
  }
  StripeResult::{ in_set: in_set, xhash: xhash }
}

fn spawn_stripe(
  s : Scope,
  ch : Channel[StripeResult],
  n : Int,
  y_start : Int,
  y_end : Int,
) -> Unit {
  spawn(s, fn() -> Unit {
    let res = compute_stripe(n, y_start, y_end)
    let _ = ch.send(res)
  })
}

pub fn main(world : World) -> Int {
  let args = args_get(world)
  let mut threads = 1
  if args.length() > 1 {
    if args[1] == "4" {
      threads = 4
    } else if args[1] == "2" {
      threads = 2
    } else if args[1] == "8" {
      threads = 8
    }
  }
  let n = 4000
  if threads == 1 {
    let r = compute_stripe(n, 0, n)
    io_println(world, r.in_set.to_string() + " " + r.xhash.to_string())
    return 0
  }
  let ch : Channel[StripeResult] = Channel::new(threads)
  scope(world, fn(s : Scope) -> Unit {
    let mut t = 0
    while t < threads {
      let y_start = (n * t) / threads
      let y_end = (n * (t + 1)) / threads
      spawn_stripe(s, ch, n, y_start, y_end)
      t = t + 1
    }
  })
  ch.close()
  let mut total_in_set = 0
  let mut total_xhash = 0
  let mut got = 0
  while got < threads {
    match ch.recv() {
      Some(r) => {
        total_in_set = total_in_set + r.in_set
        total_xhash = total_xhash ^ r.xhash
      }
      None => break
    }
    got = got + 1
  }
  io_println(world, total_in_set.to_string() + " " + total_xhash.to_string())
  0
}
