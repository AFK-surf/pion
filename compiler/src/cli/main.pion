///| Pure Pion native compiler driver (zero MoonBit runtime dependency)

///|
struct DrvLoaded {
  pkg_name : String
  paths : Array[String]
  sources : Array[String]
}

///|
struct AppleTools {
  ok : Bool
  clang_bin : String
  ld_bin : String
  sdk_path : String
  macos_ver : String
}

///|
fn drv_starts_with(s : String, pre : String) -> Bool {
  let sl = s.length()
  let pl = pre.length()
  if sl < pl {
    return false
  }
  let mut i = 0
  while i < pl {
    if str_code_at(s, i) != str_code_at(pre, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_find_substr(s : String, needle : String, start : Int) -> Int {
  let sl = s.length()
  let nl = needle.length()
  if nl == 0 || start + nl > sl {
    return -1
  }
  let mut i = start
  while i + nl <= sl {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if str_code_at(s, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn drv_parse_macos_ver_from_plist(plist : String) -> String {
  let kpos = drv_find_substr(plist, "<key>ProductVersion</key>", 0)
  if kpos < 0 {
    return "15.0"
  }
  let spos = drv_find_substr(plist, "<string>", kpos + 25)
  if spos < 0 {
    return "15.0"
  }
  let vstart = spos + 8
  let vend = drv_find_substr(plist, "</string>", vstart)
  if vend <= vstart {
    return "15.0"
  }
  let sb = StringBuilder()
  let mut dots = 0
  let mut i = vstart
  while i < vend {
    let c = str_code_at(plist, i)
    if c == 46 {
      dots = dots + 1
      if dots >= 2 {
        break
      }
      sb.write_char('.')
    } else if c >= 48 && c <= 57 {
      sb.write_char(c.unsafe_to_char())
    } else {
      break
    }
    i = i + 1
  }
  let v = sb.to_string()
  if v.length() == 0 {
    "15.0"
  } else if dots == 0 {
    v + ".0"
  } else {
    v
  }
}

///|
/// Pure filesystem probe (0 subprocesses, <0.2ms) for real clang (-cc1as), ld, and MacOSX.sdk
/// on macOS arm64_apple when CC is not overridden.
fn drv_probe_apple_tools(world : World, qbe_target : String) -> AppleTools {
  let empty = AppleTools::{
    ok: false,
    clang_bin: "",
    ld_bin: "",
    sdk_path: "",
    macos_ver: "",
  }
  if qbe_target != "arm64_apple" {
    return empty
  }
  if drv_env_str(world, "CC").length() > 0 {
    return empty
  }
  let mut clang_bin = ""
  let mut ld_bin = ""
  let mut sdk_path = ""

  let clt_c = "/Library/Developer/CommandLineTools/usr/bin/clang"
  let clt_l = "/Library/Developer/CommandLineTools/usr/bin/ld"
  let clt_s = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
  if fs_exists(world, clt_c) && fs_exists(world, clt_l) && fs_exists(world, clt_s) {
    clang_bin = clt_c
    ld_bin = clt_l
    sdk_path = clt_s
  } else if fs_is_dir(world, "/Applications") {
    let apps = fs_list_dir(world, "/Applications")
    let mut i = 0
    while i < apps.length() {
      let name = apps[i]
      if drv_starts_with(name, "Xcode") && drv_ends_with(name, ".app") {
        let dev = "/Applications/" + name + "/Contents/Developer"
        let xc_c = dev + "/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang"
        let xc_l = dev + "/Toolchains/XcodeDefault.xctoolchain/usr/bin/ld"
        let xc_s = dev + "/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
        if fs_exists(world, xc_c) && fs_exists(world, xc_l) && fs_exists(world, xc_s) {
          clang_bin = xc_c
          ld_bin = xc_l
          sdk_path = xc_s
          break
        }
      }
      i = i + 1
    }
  }
  if clang_bin == "" {
    return empty
  }
  let macos_ver = match fs_read(world, "/System/Library/CoreServices/SystemVersion.plist") {
    Ok(txt) => drv_parse_macos_ver_from_plist(txt)
    Err(_) => "15.0"
  }
  AppleTools::{
    ok: true,
    clang_bin: clang_bin,
    ld_bin: ld_bin,
    sdk_path: sdk_path,
    macos_ver: macos_ver,
  }
}

///|
fn drv_ends_with(s : String, suf : String) -> Bool {
  let sl = s.length()
  let sufl = suf.length()
  if sl < sufl {
    return false
  }
  let off = sl - sufl
  let mut i = 0
  while i < sufl {
    if str_code_at(s, off + i) != str_code_at(suf, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_is_source_file(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  if str_code_at(name, 0) == 46 {
    return false
  }
  let is_src = drv_ends_with(name, ".pion")
  let is_test = drv_ends_with(name, "_test.pion")
  is_src && !is_test
}

///|
fn drv_is_test_source_file(name : String) -> Bool {
  name.length() > 0 &&
  str_code_at(name, 0) != 46 &&
  drv_ends_with(name, "_test.pion")
}

///|
/// Appends the package's `*_test.pion` files (in `dir`, `dir/src`, and `dir/tests`
/// when `dir/tests` is not itself a nested package with `pion.toml`), which only
/// `pionc test` compiles.
fn drv_append_test_sources_for(
  world : World,
  dir : String,
  target_rules : Map[String, Array[String]],
  active_target : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[Unit, String] {
  let dirs : Array[String] = [dir]
  let rel_prefixes : Array[String] = [""]
  let src_dir = drv_join_path(dir, "src")
  if fs_is_dir(world, src_dir) {
    dirs.push(src_dir)
    rel_prefixes.push("src/")
  }
  let tests_dir = drv_join_path(dir, "tests")
  if fs_is_dir(world, tests_dir) && !fs_exists(world, drv_join_path(tests_dir, "pion.toml")) {
    dirs.push(tests_dir)
    rel_prefixes.push("tests/")
  }
  let mut di = 0
  while di < dirs.length() {
    let entries = fs_list_dir(world, dirs[di])
    let mut i = 0
    while i < entries.length() {
      if drv_is_test_source_file(entries[i]) {
        let rel = rel_prefixes[di] + entries[i]
        if manifest_target_file_active(target_rules, rel, active_target) {
          let fpath = drv_join_path(dirs[di], entries[i])
          match fs_read(world, fpath) {
            Err(msg) => return Err("failed to read " + fpath + ": " + msg)
            Ok(content) => {
              paths.push(fpath)
              sources.push(content)
            }
          }
        }
      }
      i = i + 1
    }
    di = di + 1
  }
  Ok(())
}

///|
/// Same as `drv_append_test_sources_for`, but snapshots each enumerated directory
/// (`dir`, `dir/src`, `dir/tests`) from the exact `fs_list_dir` result (or
/// `"<absent>"` when missing) so `pionc lint` has zero post-load re-list gap.
fn drv_append_test_sources_for_snap(
  world : World,
  dir : String,
  target_rules : Map[String, Array[String]],
  active_target : String,
  paths : Array[String],
  sources : Array[String],
  scanned_dirs : Array[String],
  dir_snapshots : Map[String, String],
) -> Result[Unit, String] {
  let check_dirs : Array[String] = [
    dir,
    drv_join_path(dir, "src"),
    drv_join_path(dir, "tests"),
  ]
  let rel_prefixes : Array[String] = ["", "src/", "tests/"]
  let mut di = 0
  while di < check_dirs.length() {
    let cur_dir = check_dirs[di]
    if di > 0 && !fs_is_dir(world, cur_dir) {
      match drv_lint_record_dir_snap_value(scanned_dirs, dir_snapshots, cur_dir, "<absent>") {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      di = di + 1
      continue
    }
    let entries = fs_list_dir(world, cur_dir)
    let snap = drv_lint_snapshot_entries(entries)
    match drv_lint_record_dir_snap_value(scanned_dirs, dir_snapshots, cur_dir, snap) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    // Skip nested `tests/pion.toml` sub-package using the exact same `entries`.
    if di == 2 && drv_str_arr_contains(entries, "pion.toml") {
      di = di + 1
      continue
    }
    let mut i = 0
    while i < entries.length() {
      if drv_is_test_source_file(entries[i]) {
        let rel = rel_prefixes[di] + entries[i]
        if manifest_target_file_active(target_rules, rel, active_target) {
          let fpath = drv_join_path(cur_dir, entries[i])
          match fs_read(world, fpath) {
            Err(msg) => return Err("failed to read " + fpath + ": " + msg)
            Ok(content) => {
              paths.push(fpath)
              sources.push(content)
            }
          }
        }
      }
      i = i + 1
    }
    di = di + 1
  }
  Ok(())
}

///|
fn drv_append_test_sources(
  world : World,
  dir : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[Unit, String] {
  drv_append_test_sources_for(world, dir, Map([]), "", paths, sources)
}

///|
fn drv_is_path_sep(ch : Int) -> Bool {
  ch == 47 || ch == 92
}

///|
fn drv_join_path(dir : String, name : String) -> String {
  if dir.length() == 0 {
    return name
  }
  if drv_is_path_sep(str_code_at(dir, dir.length() - 1)) {
    dir + name
  } else {
    dir + "/" + name
  }
}

///|
fn drv_parent_dir(path : String) -> String {
  let mut idx = path.length() - 1
  while idx >= 0 && !drv_is_path_sep(str_code_at(path, idx)) {
    idx = idx - 1
  }
  if idx <= 0 {
    return ""
  }
  slice_str(path, 0, idx)
}

///|
fn drv_ensure_parent_dir(world : World, path : String) -> Unit {
  let (dir, _) = drv_split_dir_base(world, path)
  if dir.length() > 0 && dir != "." && dir != "/" {
    let _ = fs_mkdir_p(world, dir)
  }
}

///|
fn drv_basename_pkg(path : String) -> String {
  let mut end = path.length()
  while end > 1 && drv_is_path_sep(str_code_at(path, end - 1)) {
    end = end - 1
  }
  let mut start = end - 1
  while start >= 0 && !drv_is_path_sep(str_code_at(path, start)) {
    start = start - 1
  }
  let mut i = start + 1
  while i < end && str_code_at(path, i) != 46 {
    i = i + 1
  }
  let name = slice_str(path, start + 1, i)
  if name.length() == 0 {
    "main"
  } else {
    name
  }
}

///|
fn drv_prefix16(s : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < 16 && i < s.length() {
    sb.write_char(str_code_at(s, i).unsafe_to_char())
    i = i + 1
  }
  sb.to_string()
}

///|
fn drv_parse_pos_int64(s : String, fallback : Int64) -> Int64 {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0L
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    } else {
      return fallback
    }
    i = i + 1
  }
  if acc > 0L {
    acc
  } else {
    fallback
  }
}

///|
fn drv_parse_pos_int(s : String, fallback : Int) -> Int {
  let v = drv_parse_pos_int64(s, fallback.to_int64()).to_int()
  if v > 0 {
    v
  } else {
    fallback
  }
}

///|
fn drv_env_str(world : World, name : String) -> String {
  match env_get(world, name) {
    Some(v) => v
    None => ""
  }
}

///|
/// Parse `PION_J2_DISABLE` into a bitmask for per-layer Wave J2 RC elision
/// benchmarks (default 0 = all layers enabled):
/// - bit 0 (1): disable Layer 1 (borrowed immutable struct field-chain `let`)
/// - bit 1 (2): disable Layer 2 (borrowed multi-level immutable field-chain args)
/// - bit 2 (4): disable Layer 3a (`inline_rc` safe load whitelist)
/// - bit 3 (8): disable Layer 3b (`inline_rc` CFG trap-branch penetration)
/// - bit 4 (16): disable PR-2A shared early-exit RC cleanup chains (`2a` / `shared_cleanup`)
/// - bit 5 (32): disable PR-2B unified AST inline budget (`2b` / `inline_budget`)
/// Accepts comma-separated tokens: `1`, `2`, `3`, `3a`, `3b`, `all`, `2a`, `2b`.
fn drv_j2_disable_mask(world : World) -> Int {
  let raw = drv_env_str(world, "PION_J2_DISABLE")
  if raw.length() == 0 {
    return 0
  }
  let mut mask = 0
  let n = raw.length()
  let mut i = 0
  while i < n {
    let mut j = i
    while j < n && str_code_at(raw, j) != 44 {
      j = j + 1
    }
    let tok = slice_str(raw, i, j)
    if tok == "all" {
      mask = mask | 15
    } else if tok == "1" {
      mask = mask | 1
    } else if tok == "2" {
      mask = mask | 2
    } else if tok == "3" {
      mask = mask | 12
    } else if tok == "3a" {
      mask = mask | 4
    } else if tok == "3b" {
      mask = mask | 8
    } else if tok == "2a" || tok == "shared_cleanup" {
      mask = mask | 16
    } else if tok == "2b" || tok == "inline_budget" {
      mask = mask | 32
    }
    i = j + 1
  }
  mask
}

///|
fn drv_temp_dir(world : World) -> String {
  let t1 = drv_env_str(world, "TEMP")
  if t1.length() > 0 {
    return t1
  }
  let t2 = drv_env_str(world, "TMP")
  if t2.length() > 0 {
    return t2
  }
  if drv_env_str(world, "OS") == "Windows_NT" {
    "."
  } else {
    "/tmp"
  }
}

///|
fn drv_resolve_cache_dir(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  if custom.length() > 0 {
    return custom
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    drv_join_path(home, ".cache/pion/cas")
  } else {
    drv_join_path(drv_temp_dir(world), "pion-cas")
  }
}

///|
fn drv_resolve_cache_max_bytes(world : World) -> Int64 {
  let kb_s = drv_env_str(world, "PION_CACHE_MAX_KB")
  if kb_s.length() > 0 {
    return drv_parse_pos_int64(kb_s, 1024L) * 1024L
  }
  let mb_s = drv_env_str(world, "PION_CACHE_MAX_MB")
  drv_parse_pos_int64(mb_s, 2048L) * 1024L * 1024L
}

///|
fn drv_has_path_sep(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if drv_is_path_sep(str_code_at(s, i)) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_os_self_exe_path() -> String {
  let ptr = c_cli_self_exe_path()
  if ptr_is_null(ptr) {
    ""
  } else {
    let res = cstr_to_str(ptr)
    ptr_free(ptr)
    res
  }
}

///|
fn drv_self_image_id() -> String {
  let ptr = c_cli_self_image_id()
  if ptr_is_null(ptr) {
    ""
  } else {
    let res = cstr_to_str(ptr)
    ptr_free(ptr)
    res
  }
}

///|
fn drv_is_ascii_str(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) >= 128 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_self_exe_path(world : World) -> String {
  let os_exe = drv_os_self_exe_path()
  if os_exe.length() > 0 {
    return os_exe
  }
  let args = world_args(world)
  if args.length() == 0 {
    return ""
  }
  let a0 = args[0]
  if a0.length() == 0 {
    return ""
  }
  if drv_has_path_sep(a0) {
    return a0
  }
  let found = drv_find_in_path(world, a0)
  if found.length() > 0 {
    return found
  }
  if drv_env_str(world, "OS") == "Windows_NT" &&
    !drv_ends_with(a0, ".exe") &&
    !drv_ends_with(a0, ".EXE") {
    let found_exe = drv_find_in_path(world, a0 + ".exe")
    if found_exe.length() > 0 {
      return found_exe
    }
  }
  a0
}

///|
/// The directory of the real `pionc` executable: `drv_self_exe_path` with
/// every symlink resolved (`pion_fs_canon_path`, falling back to the path as
/// found), so a `pionc` symlinked from another directory (`~/.local/bin`,
/// multi-hop or relative links) still finds its sibling `qbe`, `libpionrt.a`
/// and `share/pion`. Explicit `PION_*` overrides are checked before this.
fn drv_self_exe_dir(world : World) -> String {
  let p = drv_self_exe_path(world)
  if p.length() == 0 || !drv_has_path_sep(p) {
    return ""
  }
  let real = match drv_canon_out_path(world, p) {
    Ok(v) => v
    Err(_) => p
  }
  drv_parent_dir(real)
}

///|
fn drv_parent_rel(dir : String, rel : String) -> String {
  let pd = drv_parent_dir(dir)
  if pd.length() > 0 {
    drv_join_path(pd, rel)
  } else {
    drv_join_path(dir, "../" + rel)
  }
}

///|
fn drv_resolve_qbe_bin(world : World) -> String {
  let env_qbe = drv_env_str(world, "PION_QBE")
  if env_qbe.length() > 0 {
    return env_qbe
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let e1 = drv_join_path(exe_dir, "qbe")
    if fs_exists(world, e1) {
      return e1
    }
    let e2 = drv_join_path(exe_dir, "qbe.exe")
    if fs_exists(world, e2) {
      return e2
    }
    let e3 = drv_parent_rel(exe_dir, "libexec/pion/qbe")
    if fs_exists(world, e3) {
      return e3
    }
    let e4 = drv_parent_rel(exe_dir, "libexec/pion/qbe.exe")
    if fs_exists(world, e4) {
      return e4
    }
  }
  if fs_exists(world, "out/qbe") {
    return "out/qbe"
  }
  if fs_exists(world, "out/qbe.exe") {
    return "out/qbe.exe"
  }
  if fs_exists(world, "../out/qbe") {
    return "../out/qbe"
  }
  if fs_exists(world, "../out/qbe.exe") {
    return "../out/qbe.exe"
  }
  "qbe"
}

///|
fn drv_find_pion_rt_c(world : World) -> String {
  let env_src = drv_env_str(world, "PION_SRC")
  if env_src.length() > 0 {
    let c0 = drv_join_path(env_src, "runtime/pion_rt.c")
    if fs_exists(world, c0) {
      return c0
    }
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let c1 = drv_parent_rel(exe_dir, "share/pion/runtime/pion_rt.c")
    if fs_exists(world, c1) {
      return c1
    }
    let c2 = drv_parent_rel(exe_dir, "runtime/pion_rt.c")
    if fs_exists(world, c2) {
      return c2
    }
  }
  if fs_exists(world, "runtime/pion_rt.c") {
    return "runtime/pion_rt.c"
  }
  if fs_exists(world, "../runtime/pion_rt.c") {
    return "../runtime/pion_rt.c"
  }
  ""
}

///|
fn drv_ensure_msvc_rt_obj(
  world : World,
  cc_bin : String,
  quiet : Bool,
  pin : DrvCasPinSession,
) -> Result[Option[String], String] {
  let rt_c = drv_find_pion_rt_c(world)
  if rt_c.length() == 0 {
    return Ok(None)
  }
  let c_txt = match fs_read(world, rt_c) {
    Ok(t) => t
    Err(_) => return Ok(None)
  }
  let c_hash = sha256_hex(c_txt)
  let rt_h = drv_join_path(drv_parent_dir(rt_c), "pion_rt.h")
  let h_hash = if fs_exists(world, rt_h) {
    match fs_read(world, rt_h) {
      Ok(t) => sha256_hex(t)
      Err(_) => ""
    }
  } else {
    ""
  }
  let key = sha256_hex("pion-rt-msvc-v1|" + cc_bin + "|" + c_hash + "|" + h_hash)
  let cas_key = "pion_rt_msvc_" + key
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let obj_path = cache_dir + "/obj/" + cas_key + ".o"
  if drv_is_nonempty_regular_file(world, obj_path) &&
    drv_cas_pin_and_verify(world, cache_dir, pin, [cas_key], [obj_path]) {
    return Ok(Some(obj_path))
  }
  let stamp = drv_tmp_tag(world, obj_path)
  let obj_tmp = obj_path + ".tmp." + stamp
  let argv : Array[String] = [
    cc_bin,
    "-std=c11",
    "-O2",
    "-fno-asynchronous-unwind-tables",
    "-D_CRT_SECURE_NO_WARNINGS",
    "-c",
    rt_c,
    "-o",
    obj_tmp,
  ]
  let rc = drv_exec_quiet(world, argv, quiet)
  if rc != 0 {
    let _ = fs_remove(world, obj_tmp)
    return Ok(None)
  }
  if drv_cas_publish_file_pinned(world, cache_dir, pin, [cas_key], obj_tmp, obj_path) {
    let sz = fs_size(world, obj_path)
    drv_cas_record_and_evict_pinned(
      world,
      cache_dir,
      cas_key,
      if sz > 0L { sz } else { 0L },
      pin,
    )
    Ok(Some(obj_path))
  } else {
    pin.temp_files.push(obj_tmp)
    Ok(Some(obj_tmp))
  }
}

///|
fn drv_ensure_cross_rt_lib(
  world : World,
  qbe_target : String,
  sysroot : String,
  quiet : Bool,
  pin : DrvCasPinSession,
) -> Result[Option[String], String] {
  let rt_c = drv_find_pion_rt_c(world)
  if rt_c.length() == 0 {
    return Ok(None)
  }
  let c_txt = match fs_read(world, rt_c) {
    Ok(t) => t
    Err(_) => return Ok(None)
  }
  let c_hash = sha256_hex(c_txt)
  let rt_h = drv_join_path(drv_parent_dir(rt_c), "pion_rt.h")
  let h_hash = if fs_exists(world, rt_h) {
    match fs_read(world, rt_h) {
      Ok(t) => sha256_hex(t)
      Err(_) => ""
    }
  } else {
    ""
  }
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
  let tflags_str = drv_join_char(tflags, "\n")
  let key = sha256_hex(
    "pion-rt-cross-v1|" +
    qbe_target +
    "|" +
    cc_bin +
    "|" +
    tflags_str +
    "|" +
    c_hash +
    "|" +
    h_hash,
  )
  let cas_key = "pion_rt_" + qbe_target + "_" + key
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let ar_path = cache_dir + "/obj/" + cas_key + ".a"
  if drv_is_nonempty_regular_file(world, ar_path) &&
    drv_cas_pin_and_verify(world, cache_dir, pin, [cas_key], [ar_path]) {
    return Ok(Some(ar_path))
  }
  let stamp = drv_tmp_tag(world, ar_path)
  // Compile in a private staging directory (drv_make_out_stage) under a fixed
  // file name, so the archive member is always `pion_rt.o` and two cold CAS
  // produce the same archive.
  let tmp_dir = match drv_make_out_stage(world, cache_dir + "/obj") {
    Err(e) => return Err(e)
    Ok(d) => d
  }
  let obj_tmp = tmp_dir + "/pion_rt.o"
  let ar_tmp = ar_path + ".tmp." + stamp
  let argv : Array[String] = [cc_bin]
  let mut fi = 0
  while fi < tflags.length() {
    argv.push(tflags[fi])
    fi = fi + 1
  }
  argv.push("-std=c11")
  argv.push("-O2")
  if !drv_target_is_windows(qbe_target) {
    argv.push("-fPIC")
  }
  argv.push("-fno-asynchronous-unwind-tables")
  argv.push("-c")
  argv.push(rt_c)
  argv.push("-o")
  argv.push(obj_tmp)
  let rc = drv_exec_quiet(world, argv, quiet)
  if rc != 0 {
    // No usable cross compiler: fall back, but only after a clean stage.
    match drv_drop_out_stage(world, tmp_dir) {
      Err(e) => return Err(e)
      Ok(_) => return Ok(None)
    }
  }
  let archived = drv_archive_static_lib(world, qbe_target, [obj_tmp], ar_tmp, quiet)
  let dropped = drv_drop_out_stage(world, tmp_dir)
  match dropped {
    Err(e) => {
      let _ = fs_remove(world, ar_tmp)
      return Err(e)
    }
    Ok(_) => ()
  }
  match archived {
    Err(_) => {
      let _ = fs_remove(world, ar_tmp)
      return Ok(None)
    }
    Ok(_) => ()
  }
  if drv_cas_publish_file_pinned(world, cache_dir, pin, [cas_key], ar_tmp, ar_path) {
    let sz = fs_size(world, ar_path)
    drv_cas_record_and_evict_pinned(
      world,
      cache_dir,
      cas_key,
      if sz > 0L { sz } else { 0L },
      pin,
    )
    Ok(Some(ar_path))
  } else {
    pin.temp_files.push(ar_tmp)
    Ok(Some(ar_tmp))
  }
}

///|
/// The runtime library to link for `qbe_target` (see `drv_resolve_rt_lib_for`).
fn drv_resolve_rt_lib(world : World, qbe_target : String) -> Result[String, String] {
  drv_resolve_rt_lib_for_quiet(world, qbe_target, "", false)
}

///|
fn drv_resolve_rt_lib_quiet(world : World, qbe_target : String, quiet : Bool) -> Result[String, String] {
  drv_resolve_rt_lib_for_quiet(world, qbe_target, "", quiet)
}

///|
fn drv_resolve_rt_lib_for(
  world : World,
  qbe_target : String,
  sysroot : String,
) -> Result[String, String] {
  drv_resolve_rt_lib_for_quiet(world, qbe_target, sysroot, false)
}

///|
fn drv_resolve_rt_lib_for_quiet(
  world : World,
  qbe_target : String,
  sysroot : String,
  quiet : Bool,
) -> Result[String, String] {
  drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, quiet, drv_cas_pin_none())
}

///|
fn drv_resolve_rt_lib_for_pinned(
  world : World,
  qbe_target : String,
  sysroot : String,
  quiet : Bool,
  pin : DrvCasPinSession,
) -> Result[String, String] {
  let env_rt = drv_env_str(world, "PION_RT_LIB")
  if env_rt.length() > 0 {
    return Ok(env_rt)
  }
  if drv_target_is_windows(qbe_target) {
    let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
    if drv_is_windows_msvc_cc(world, qbe_target, cc_bin) {
      match drv_ensure_msvc_rt_obj(world, cc_bin, quiet, pin) {
        Err(e) => return Err(e)
        Ok(Some(obj_path)) => return Ok(obj_path)
        Ok(None) => ()
      }
    }
  }
  if qbe_target != drv_resolve_qbe_target(world) && !drv_target_is_wasm(qbe_target) {
    // A runtime that was compiled but could not be published is an error,
    // never a reason to fall back to the host library below.
    match drv_ensure_cross_rt_lib(world, qbe_target, sysroot, quiet, pin) {
      Err(e) => return Err(e)
      Ok(Some(ar_path)) => return Ok(ar_path)
      Ok(None) => ()
    }
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let r1 = drv_parent_rel(exe_dir, "lib/libpionrt.a")
    if fs_exists(world, r1) {
      return Ok(r1)
    }
    let r2 = drv_join_path(exe_dir, "libpionrt.a")
    if fs_exists(world, r2) {
      return Ok(r2)
    }
  }
  if fs_exists(world, "out/libpionrt.a") {
    return Ok("out/libpionrt.a")
  }
  if fs_exists(world, "../out/libpionrt.a") {
    return Ok("../out/libpionrt.a")
  }
  Ok("out/libpionrt.a")
}

///|
fn drv_target_is_valid(t : String) -> Bool {
  t == "arm64_apple" ||
  t == "amd64_apple" ||
  t == "amd64_sysv" ||
  t == "amd64_win" ||
  t == "arm64" ||
  t == "rv64" ||
  t == "ios_arm64" ||
  t == "ios_sim_arm64" ||
  t == "android_arm64" ||
  t == "android_x64" ||
  t == "wasm32"
}

///|
fn drv_target_qbe_arch(t : String) -> String {
  if t == "ios_arm64" || t == "ios_sim_arm64" {
    "arm64_apple"
  } else if t == "android_arm64" {
    "arm64"
  } else if t == "android_x64" {
    "amd64_sysv"
  } else {
    t
  }
}

///|
/// Microsoft x64 unwind tables (`qbe --seh`: .pdata / .xdata) only where
/// the linker drops them with their functions (MSVC link / lld-link
/// /OPT:REF). MinGW GNU ld `KEEP()`s every `.pdata`, which would keep each
/// dead function alive under `--gc-sections` (p98 / p120).
fn drv_win_seh(world : World, qbe_target : String) -> Bool {
  qbe_target == "amd64_win" &&
  drv_is_windows_msvc_cc(world, qbe_target, drv_resolve_cc_driver(world, qbe_target, false))
}

///|
fn drv_qbe_text_argv(
  qbe_bin : String,
  qbe_arch : String,
  seh : Bool,
  out_path : String,
  in_path : String,
) -> Array[String] {
  let argv : Array[String] = [qbe_bin, "--strict-jnz"]
  if seh {
    argv.push("--seh")
  }
  argv.push("-t")
  argv.push(qbe_arch)
  argv.push("-o")
  argv.push(out_path)
  argv.push(in_path)
  argv
}

///|
fn drv_target_os(t : String) -> String {
  if t == "arm64_apple" || t == "amd64_apple" {
    "macos"
  } else if t == "ios_arm64" || t == "ios_sim_arm64" {
    "ios"
  } else if t == "android_arm64" || t == "android_x64" {
    "android"
  } else if t == "amd64_win" {
    "windows"
  } else if t == "wasm32" {
    "wasm"
  } else {
    "linux"
  }
}

///|
fn drv_target_is_wasm(t : String) -> Bool {
  t == "wasm32"
}

///|
fn drv_resolve_wasm_rt(world : World) -> String {
  let env_rt = drv_env_str(world, "PION_WASM_RT")
  if env_rt.length() > 0 && fs_exists(world, env_rt) {
    return env_rt
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let c0 = drv_parent_rel(exe_dir, "share/pion/pion_wasm_rt.mjs")
    if fs_exists(world, c0) {
      return c0
    }
    let c1 = drv_parent_rel(exe_dir, "runtime/pion_wasm_rt.mjs")
    if fs_exists(world, c1) {
      return c1
    }
    let c2 = drv_join_path(exe_dir, "pion_wasm_rt.mjs")
    if fs_exists(world, c2) {
      return c2
    }
    let c3 = drv_join_path(exe_dir, "runtime/pion_wasm_rt.mjs")
    if fs_exists(world, c3) {
      return c3
    }
  }
  if fs_exists(world, "runtime/pion_wasm_rt.mjs") {
    return "runtime/pion_wasm_rt.mjs"
  }
  "runtime/pion_wasm_rt.mjs"
}

///|
fn drv_path_dirname(p : String) -> String {
  let n = p.length()
  let mut last = -1
  let mut i = 0
  while i < n {
    let c = str_code_at(p, i)
    if c == 47 || c == 92 {
      last = i
    }
    i = i + 1
  }
  if last < 0 {
    ""
  } else if last == 0 {
    "/"
  } else {
    slice_str(p, 0, last)
  }
}

///|
fn drv_resolve_wasm_web_rt(world : World) -> String {
  let env_web = drv_env_str(world, "PION_WASM_WEB_RT")
  if env_web.length() > 0 && fs_exists(world, env_web) {
    return env_web
  }
  let env_rt = drv_env_str(world, "PION_WASM_RT")
  if env_rt.length() > 0 {
    let dir = drv_path_dirname(env_rt)
    let sib = if dir.length() > 0 {
      drv_join_path(dir, "pion_wasm_rt_web.mjs")
    } else {
      "pion_wasm_rt_web.mjs"
    }
    if fs_exists(world, sib) {
      return sib
    }
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let c0 = drv_parent_rel(exe_dir, "share/pion/pion_wasm_rt_web.mjs")
    if fs_exists(world, c0) {
      return c0
    }
    let c1 = drv_parent_rel(exe_dir, "runtime/pion_wasm_rt_web.mjs")
    if fs_exists(world, c1) {
      return c1
    }
    let c2 = drv_join_path(exe_dir, "pion_wasm_rt_web.mjs")
    if fs_exists(world, c2) {
      return c2
    }
    let c3 = drv_join_path(exe_dir, "runtime/pion_wasm_rt_web.mjs")
    if fs_exists(world, c3) {
      return c3
    }
  }
  if fs_exists(world, "runtime/pion_wasm_rt_web.mjs") {
    return "runtime/pion_wasm_rt_web.mjs"
  }
  "runtime/pion_wasm_rt_web.mjs"
}

///|
fn drv_web_rt_matches_abi(content : String, want_abi : Int) -> Bool {
  let n = content.length()
  let mut i = 0
  // Skip optional UTF-8 BOM
  if n >= 3 &&
    str_code_at(content, 0) == 239 &&
    str_code_at(content, 1) == 187 &&
    str_code_at(content, 2) == 191 {
    i = 3
  }
  while i < n {
    let c = str_code_at(content, i)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      i = i + 1
    } else if c == 47 && i + 1 < n && str_code_at(content, i + 1) == 47 {
      i = i + 2
      while i < n && str_code_at(content, i) != 10 {
        i = i + 1
      }
    } else if c == 47 && i + 1 < n && str_code_at(content, i + 1) == 42 {
      i = i + 2
      let mut closed = false
      while i + 1 < n {
        if str_code_at(content, i) == 42 && str_code_at(content, i + 1) == 47 {
          i = i + 2
          closed = true
          break
        }
        i = i + 1
      }
      if !closed {
        return false
      }
    } else {
      break
    }
  }
  let want = "export const PION_WASM_RT_ABI = " + want_abi.to_string()
  let wlen = want.length()
  if i + wlen > n {
    return false
  }
  let mut k = 0
  while k < wlen {
    if str_code_at(content, i + k) != str_code_at(want, k) {
      return false
    }
    k = k + 1
  }
  let mut j = i + wlen
  while j < n && (str_code_at(content, j) == 32 || str_code_at(content, j) == 9) {
    j = j + 1
  }
  j < n && str_code_at(content, j) == 59
}

///|
fn drv_has_js_ext(p : String) -> Bool {
  let lp = drv_ascii_lower(p)
  drv_ends_with(lp, ".mjs") || drv_ends_with(lp, ".js")
}

///|
extern "C" fn c_fs_canon_path(path : Ptr) -> Ptr = "pion_fs_canon_path"

///|
extern "C" fn c_cli_sha256_file(path : Ptr) -> Ptr = "pion_cli_sha256_file"

///|
extern "C" fn c_cli_path_change_ms(path : Ptr) -> Int64 = "pion_cli_path_change_ms"

///|
extern "C" fn c_cli_lpath_change_ms(path : Ptr) -> Int64 = "pion_cli_lpath_change_ms"

///|
extern "C" fn c_fs_readlink(path : Ptr) -> Ptr = "pion_fs_readlink"

///|
fn drv_fs_readlink(path : String) -> Option[String] {
  let p = path
  let ptr = c_fs_readlink(drv_cpath(p))
  if ptr_is_null(ptr) {
    return None
  }
  let res = cstr_to_str(ptr)
  ptr_free(ptr)
  if res.length() > 0 {
    Some(res)
  } else {
    None
  }
}

///|
/// Streams a file through native C SHA-256 (64 KiB buffer, raw bytes, O(1) memory),
/// bypassing any in-process memoization (used on cold CAS publish verification).
fn drv_cas_sha256_file_uncached(path : String) -> Option[String] {
  let p = path
  let ptr = c_cli_sha256_file(drv_cpath(p))
  if ptr_is_null(ptr) {
    return None
  }
  let hex = cstr_to_str(ptr)
  ptr_free(ptr)
  if hex.length() == 64 {
    Some(hex)
  } else {
    None
  }
}

///|
/// Streams a file through native C SHA-256 (64 KiB buffer, raw bytes, O(1) memory),
/// memoized in-process for the duration of this `pionc` invocation (zero disk cache).
fn drv_sha256_file(path : String, memo : Map[String, String]) -> Option[String] {
  match memo.get(path) {
    Some(h) => return Some(h)
    None => ()
  }
  match drv_cas_sha256_file_uncached(path) {
    Some(hex) => {
      memo.set(path, hex)
      Some(hex)
    }
    None => None
  }
}

///|
/// Pure lexical absolute path normalization: prepends cwd for relative paths,
/// normalizes `\` -> `/` on Windows, and collapses redundant `//` and `/./`,
/// while PRESERVING `..` segments and symlinks verbatim so OS filesystem
/// resolution is never altered when a symlinked directory precedes `..`.
fn drv_cstub_abs_lexical_path(world : World, raw_path : String) -> String {
  let mut p = raw_path
  if c_cli_is_windows() != 0 || drv_is_drive_abs(p) {
    let sb = StringBuilder()
    let n = p.length()
    let mut run = 0
    let mut i = 0
    while i < n {
      if str_code_at(p, i) == 92 {
        if i > run {
          sb.write_string(slice_str(p, run, i))
        }
        sb.write_char('/')
        run = i + 1
      }
      i = i + 1
    }
    if n > run {
      sb.write_string(slice_str(p, run, n))
    }
    p = sb.to_string()
  }
  if p.length() == 0 || (str_code_at(p, 0) != 47 && !drv_is_drive_abs(p)) {
    let cwd = drv_cwd(world)
    if cwd.length() > 0 && (str_code_at(cwd, 0) == 47 || drv_is_drive_abs(cwd)) {
      p = drv_join_path(cwd, p)
      if c_cli_is_windows() != 0 || drv_is_drive_abs(p) {
        let sb2 = StringBuilder()
        let n2 = p.length()
        let mut run2 = 0
        let mut i2 = 0
        while i2 < n2 {
          if str_code_at(p, i2) == 92 {
            if i2 > run2 {
              sb2.write_string(slice_str(p, run2, i2))
            }
            sb2.write_char('/')
            run2 = i2 + 1
          }
          i2 = i2 + 1
        }
        if n2 > run2 {
          sb2.write_string(slice_str(p, run2, n2))
        }
        p = sb2.to_string()
      }
    }
  }
  let mut root = ""
  let mut body = p
  if drv_is_drive_abs(p) {
    root = slice_str(p, 0, 2) + "/"
    body = slice_str(p, 2, p.length())
  } else if p.length() > 0 && str_code_at(p, 0) == 47 {
    root = "/"
    body = slice_str(p, 1, p.length())
  }
  let parts : Array[String] = []
  let mut seg_start = 0
  let mut i = 0
  let bn = body.length()
  while i <= bn {
    if i == bn || str_code_at(body, i) == 47 {
      let seg = slice_str(body, seg_start, i)
      seg_start = i + 1
      if seg.length() > 0 && seg != "." {
        parts.push(seg)
      }
    }
    i = i + 1
  }
  let out = StringBuilder()
  out.write_string(root)
  let mut j = 0
  while j < parts.length() {
    if j > 0 {
      out.write_char('/')
    }
    out.write_string(parts[j])
    j = j + 1
  }
  out.to_string()
}

///|
/// Resolves symlinks via `pion_fs_canon_path` before folding `..`, falling back
/// to lexical normalization only if canonicalization fails.
fn drv_cstub_canon_path(world : World, p : String) -> String {
  let raw = p
  let ptr = c_fs_canon_path(drv_cpath(raw))
  if !ptr_is_null(ptr) {
    let res = cstr_to_str(ptr)
    ptr_free(ptr)
    return drv_normalize_path(res)
  }
  drv_normalize_path(drv_abs_path(world, p))
}

///|
fn drv_canon_out_path(_world : World, p : String) -> Result[String, String] {
  let ptr = c_fs_canon_path(drv_cpath(p))
  if ptr_is_null(ptr) {
    Err("error: cannot resolve path: " + p)
  } else {
    let res = cstr_to_str(ptr)
    ptr_free(ptr)
    Ok(res)
  }
}

///|
fn drv_check_web_rt_loaded_paths(
  world : World,
  web_rt_dst : String,
  paths : Array[String],
) -> Result[Unit, String] {
  if web_rt_dst.length() == 0 {
    return Ok(())
  }
  let dst_canon = match drv_canon_out_path(world, web_rt_dst) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dst_key = drv_ascii_lower(dst_canon)
  let mut i = 0
  while i < paths.length() {
    let p_canon = match drv_canon_out_path(world, paths[i]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if drv_ascii_lower(p_canon) == dst_key {
      return Err(
        "error: --emit-web-rt destination collides with loaded source file: " +
        web_rt_dst,
      )
    }
    i = i + 1
  }
  Ok(())
}

///|
fn drv_resolve_web_rt_dst(
  world : World,
  raw_targets : Array[String],
  targets : Array[String],
  out_bin : String,
  emit_ssa : String,
  emit_asm : String,
  emit_obj : String,
  emit_staticlib : String,
  emit_cdylib : String,
  emit_web_rt_path : String,
) -> Result[String, String] {
  let dst = if emit_web_rt_path.length() > 0 {
    emit_web_rt_path
  } else if out_bin.length() > 0 {
    let dir = drv_path_dirname(out_bin)
    if dir.length() > 0 && dir != "." {
      drv_join_path(dir, "pion_wasm_rt_web.mjs")
    } else {
      "pion_wasm_rt_web.mjs"
    }
  } else {
    "pion_wasm_rt_web.mjs"
  }
  if !drv_has_js_ext(dst) {
    return Err(
      "error: --emit-web-rt output path must end with .mjs or .js: " + dst,
    )
  }
  if fs_is_dir(world, dst) {
    return Err("error: --emit-web-rt destination is an existing directory: " + dst)
  }
  let dst_canon = match drv_canon_out_path(world, dst) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dst_key = drv_ascii_lower(dst_canon)
  let outs : Array[String] = [
    out_bin,
    emit_ssa,
    emit_asm,
    emit_obj,
    emit_staticlib,
    emit_cdylib,
  ]
  let mut oi = 0
  while oi < outs.length() {
    if outs[oi].length() > 0 {
      let oc = match drv_canon_out_path(world, outs[oi]) {
        Ok(v) => v
        Err(e) => return Err(e)
      }
      if dst_key == drv_ascii_lower(oc) {
        return Err(
          "error: --emit-web-rt destination collides with build output path: " +
          dst,
        )
      }
    }
    oi = oi + 1
  }
  let mut ti = 0
  while ti < raw_targets.length() {
    let tc = match drv_canon_out_path(world, raw_targets[ti]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dst_key == drv_ascii_lower(tc) {
      return Err(
        "error: --emit-web-rt destination collides with input path: " + dst,
      )
    }
    ti = ti + 1
  }
  ti = 0
  while ti < targets.length() {
    let tc = match drv_canon_out_path(world, targets[ti]) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    if dst_key == drv_ascii_lower(tc) {
      return Err(
        "error: --emit-web-rt destination collides with input path: " + dst,
      )
    }
    ti = ti + 1
  }
  Ok(dst)
}

///|
fn drv_emit_web_rt_file(
  world : World,
  dst : String,
) -> Result[String, String] {
  let src = drv_resolve_wasm_web_rt(world)
  if !fs_exists(world, src) {
    return Err("error: could not locate pion_wasm_rt_web.mjs (tried " + src + ")")
  }
  match fs_read(world, src) {
    Err(e) => Err("error: failed to read " + src + ": " + e)
    Ok(content) => {
      if !drv_web_rt_matches_abi(content, WASM_RT_ABI_VERSION) {
        return Err(
          "error: " +
          src +
          " does not match compiler Wasm runtime ABI v" +
          WASM_RT_ABI_VERSION.to_string(),
        )
      }
      drv_ensure_parent_dir(world, dst)
      if !drv_write_text_atomic(world, dst, content) {
        return Err("error: failed to write --emit-web-rt file: " + dst)
      }
      Ok(dst)
    }
  }
}

///|
fn drv_target_is_apple(t : String) -> Bool {
  let os = drv_target_os(t)
  os == "macos" || os == "ios"
}

///|
fn drv_target_is_linux(t : String) -> Bool {
  drv_target_os(t) == "linux"
}

///|
fn drv_target_is_ios(t : String) -> Bool {
  drv_target_os(t) == "ios"
}

///|
fn drv_target_is_android(t : String) -> Bool {
  drv_target_os(t) == "android"
}

///|
fn drv_target_is_windows(t : String) -> Bool {
  drv_target_os(t) == "windows"
}

///|
fn drv_resolve_ios_sdk(
  world : World,
  qbe_target : String,
  sysroot : String,
) -> String {
  if sysroot.length() > 0 {
    return sysroot
  }
  let sdk_name = if qbe_target == "ios_sim_arm64" {
    "iphonesimulator"
  } else {
    "iphoneos"
  }
  match proc_exec_capture(world, ["xcrun", "--sdk", sdk_name, "--show-sdk-path"]) {
    Ok(out) => drv_trim_ws(out)
    Err(_) => ""
  }
}

///|
fn drv_probe_ndk_root_bin(world : World, ndk_root : String) -> String {
  if ndk_root.length() == 0 {
    return ""
  }
  let hosts : Array[String] = ["darwin-x86_64", "linux-x86_64", "darwin-arm64"]
  let mut i = 0
  while i < hosts.length() {
    let bin_dir = ndk_root + "/toolchains/llvm/prebuilt/" + hosts[i] + "/bin"
    if fs_exists(world, bin_dir) {
      return bin_dir
    }
    i = i + 1
  }
  ""
}

///|
fn drv_probe_ndk_parent_bin(world : World, ndk_parent : String) -> String {
  if ndk_parent.length() == 0 || !fs_exists(world, ndk_parent) {
    return ""
  }
  let entries = fs_list_dir(world, ndk_parent)
  let mut best_ver = ""
  let mut best_bin = ""
  let mut i = 0
  while i < entries.length() {
    let ver = entries[i]
    if ver.length() > 0 && !drv_starts_with(ver, ".") {
      let b = drv_probe_ndk_root_bin(world, drv_join_path(ndk_parent, ver))
      if b.length() > 0 && (best_ver.length() == 0 || ver > best_ver) {
        best_ver = ver
        best_bin = b
      }
    }
    i = i + 1
  }
  best_bin
}

///|
fn drv_find_android_ndk_bin_dir(world : World) -> String {
  let b1 = drv_probe_ndk_root_bin(world, drv_env_str(world, "ANDROID_NDK_HOME"))
  if b1.length() > 0 {
    return b1
  }
  let b2 = drv_probe_ndk_root_bin(world, drv_env_str(world, "ANDROID_NDK_ROOT"))
  if b2.length() > 0 {
    return b2
  }
  let ah = drv_env_str(world, "ANDROID_HOME")
  if ah.length() > 0 {
    let b3 = drv_probe_ndk_parent_bin(world, ah + "/ndk")
    if b3.length() > 0 {
      return b3
    }
  }
  let asr = drv_env_str(world, "ANDROID_SDK_ROOT")
  if asr.length() > 0 {
    let b4 = drv_probe_ndk_parent_bin(world, asr + "/ndk")
    if b4.length() > 0 {
      return b4
    }
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    let b5 = drv_probe_ndk_parent_bin(world, home + "/Library/Android/sdk/ndk")
    if b5.length() > 0 {
      return b5
    }
    let b6 = drv_probe_ndk_parent_bin(world, home + "/Android/Sdk/ndk")
    if b6.length() > 0 {
      return b6
    }
  }
  ""
}

///|
fn drv_resolve_android_ndk_tool(
  world : World,
  qbe_target : String,
  is_cxx : Bool,
) -> String {
  let bin_dir = drv_find_android_ndk_bin_dir(world)
  if bin_dir.length() == 0 {
    return ""
  }
  let triple = if qbe_target == "android_x64" {
    "x86_64-linux-android24"
  } else {
    "aarch64-linux-android24"
  }
  let tool = if is_cxx { triple + "-clang++" } else { triple + "-clang" }
  let cand = bin_dir + "/" + tool
  if fs_exists(world, cand) {
    cand
  } else {
    ""
  }
}

///|
fn drv_check_android_toolchain(
  world : World,
  qbe_target : String,
) -> Result[Unit, String] {
  if !drv_target_is_android(qbe_target) {
    return Ok(())
  }
  if drv_env_str(world, "PION_ANDROID_CC").length() > 0 ||
    drv_env_str(world, "CC").length() > 0 ||
    drv_find_android_ndk_bin_dir(world).length() > 0 {
    return Ok(())
  }
  Err(
    "Android target '" +
    qbe_target +
    "' requires Android NDK: set ANDROID_NDK_HOME / ANDROID_NDK_ROOT / PION_ANDROID_CC / CC (or install NDK under ANDROID_HOME/ndk)",
  )
}

///|
fn drv_win_translate_msvc_flags(
  flags : Array[String],
  is_cdylib : Bool,
) -> Array[String] {
  win_translate_msvc_flags(flags, is_cdylib)
}

///|
fn drv_is_clang_cl_driver(driver : String) -> Bool {
  let n = driver.length()
  let mut sep = n - 1
  while sep >= 0 {
    let c = str_code_at(driver, sep)
    if c == 47 || c == 92 {
      break
    }
    sep = sep - 1
  }
  let base = slice_str(driver, sep + 1, n)
  let sb = StringBuilder()
  let mut i = 0
  while i < base.length() {
    let c = str_code_at(base, i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_string(slice_str(base, i, i + 1))
    }
    i = i + 1
  }
  let lower = sb.to_string()
  lower == "clang-cl" || lower == "clang-cl.exe"
}

///|
fn drv_is_cl_exe_driver(driver : String) -> Bool {
  let n = driver.length()
  let mut sep = n - 1
  while sep >= 0 {
    let c = str_code_at(driver, sep)
    if c == 47 || c == 92 {
      break
    }
    sep = sep - 1
  }
  let base = slice_str(driver, sep + 1, n)
  let sb = StringBuilder()
  let mut i = 0
  while i < base.length() {
    let c = str_code_at(base, i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else {
      sb.write_string(slice_str(base, i, i + 1))
    }
    i = i + 1
  }
  let lower = sb.to_string()
  lower == "cl" || lower == "cl.exe"
}

///|
fn drv_is_windows_msvc_cc(
  world : World,
  qbe_target : String,
  cc_bin : String,
) -> Bool {
  if !drv_target_is_windows(qbe_target) {
    return false
  }
  let abi = drv_env_str(world, "PION_WIN_ABI")
  if abi == "msvc" {
    return true
  }
  if abi == "mingw" || abi == "gnu" {
    return false
  }
  if drv_is_clang_cl_driver(cc_bin) {
    return true
  }
  match proc_exec_capture(world, [cc_bin, "-dumpmachine"]) {
    Ok(out) =>
      drv_find_substr(out, "msvc", 0) >= 0 ||
      drv_find_substr(out, "MSVC", 0) >= 0
    Err(_) => false
  }
}

///|
fn drv_resolve_cc_driver(
  world : World,
  qbe_target : String,
  is_cxx : Bool,
) -> String {
  if drv_target_is_android(qbe_target) {
    let env_name = if is_cxx { "PION_ANDROID_CXX" } else { "PION_ANDROID_CC" }
    let env_a = drv_env_str(world, env_name)
    if env_a.length() > 0 {
      return env_a
    }
    let ndk_tool = drv_resolve_android_ndk_tool(world, qbe_target, is_cxx)
    if ndk_tool.length() > 0 {
      return ndk_tool
    }
  }
  if is_cxx {
    let e = drv_env_str(world, "CXX")
    if e.length() > 0 {
      e
    } else if drv_target_is_windows(qbe_target) {
      let derived = win_derive_cxx_from_cc(drv_env_str(world, "CC"))
      if derived.length() > 0 {
        derived
      } else {
        "g++"
      }
    } else {
      "c++"
    }
  } else {
    let e = drv_env_str(world, "CC")
    if e.length() > 0 {
      e
    } else if drv_target_is_windows(qbe_target) {
      "gcc"
    } else {
      "cc"
    }
  }
}

///|
fn drv_target_cc_flags(
  world : World,
  qbe_target : String,
  sysroot : String,
) -> Array[String] {
  let flags : Array[String] = []
  if qbe_target == "amd64_apple" {
    flags.push("-arch")
    flags.push("x86_64")
    if sysroot.length() > 0 {
      flags.push("-isysroot")
      flags.push(sysroot)
    }
  } else if qbe_target == "arm64_apple" {
    if sysroot.length() > 0 {
      flags.push("-isysroot")
      flags.push(sysroot)
    }
  } else if qbe_target == "ios_arm64" {
    let ios_min_env = drv_env_str(world, "PION_IOS_DEPLOYMENT_TARGET")
    let ios_min = if ios_min_env.length() > 0 {
      ios_min_env
    } else {
      let iph_env = drv_env_str(world, "IPHONEOS_DEPLOYMENT_TARGET")
      if iph_env.length() > 0 { iph_env } else { "16.0" }
    }
    flags.push("-arch")
    flags.push("arm64")
    flags.push("-miphoneos-version-min=" + ios_min)
    let sdk = drv_resolve_ios_sdk(world, qbe_target, sysroot)
    if sdk.length() > 0 {
      flags.push("-isysroot")
      flags.push(sdk)
    }
  } else if qbe_target == "ios_sim_arm64" {
    let ios_min_env = drv_env_str(world, "PION_IOS_DEPLOYMENT_TARGET")
    let ios_min = if ios_min_env.length() > 0 {
      ios_min_env
    } else {
      let iph_env = drv_env_str(world, "IPHONEOS_DEPLOYMENT_TARGET")
      if iph_env.length() > 0 { iph_env } else { "16.0" }
    }
    flags.push("-arch")
    flags.push("arm64")
    flags.push("-mios-simulator-version-min=" + ios_min)
    let sdk = drv_resolve_ios_sdk(world, qbe_target, sysroot)
    if sdk.length() > 0 {
      flags.push("-isysroot")
      flags.push(sdk)
    }
  } else if qbe_target == "android_arm64" {
    flags.push("--target=aarch64-linux-android24")
    if sysroot.length() > 0 {
      flags.push("--sysroot=" + sysroot)
    }
  } else if qbe_target == "android_x64" {
    flags.push("--target=x86_64-linux-android24")
    if sysroot.length() > 0 {
      flags.push("--sysroot=" + sysroot)
    }
  } else if sysroot.length() > 0 {
    flags.push("--sysroot=" + sysroot)
  }
  flags
}

///|
fn drv_target_as_flags(
  world : World,
  qbe_target : String,
  sysroot : String,
  driver : String,
) -> Array[String] {
  let flags = drv_target_cc_flags(world, qbe_target, sysroot)
  if qbe_target == "amd64_win" && !drv_is_clang_cl_driver(driver) {
    flags.push("-Wa,-mbig-obj")
  }
  flags
}

///|
fn drv_exec_quiet(world : World, argv : Array[String], quiet : Bool) -> Int {
  if quiet {
    match proc_exec_capture(world, argv) {
      Ok(_) => 0
      Err(_) => 1
    }
  } else {
    proc_exec(world, argv)
  }
}

///|
fn drv_assemble_file(
  world : World,
  qbe_target : String,
  apple_tools : AppleTools,
  cc1as_triple : String,
  sysroot : String,
  asm_path : String,
  obj_tmp : String,
  quiet : Bool,
) -> Int {
  if apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0 {
    drv_exec_quiet(
      world,
      [
        apple_tools.clang_bin,
        "-cc1as",
        "-triple",
        cc1as_triple,
        "-filetype",
        "obj",
        "-o",
        obj_tmp,
        asm_path,
      ],
      quiet,
    )
  } else {
    let driver = drv_resolve_cc_driver(world, qbe_target, false)
    let argv : Array[String] = [driver]
    let tflags = drv_target_as_flags(world, qbe_target, sysroot, driver)
    let mut fi = 0
    while fi < tflags.length() {
      argv.push(tflags[fi])
      fi = fi + 1
    }
    argv.push("-c")
    argv.push("-x")
    argv.push("assembler")
    argv.push("-o")
    argv.push(obj_tmp)
    argv.push(asm_path)
    drv_exec_quiet(world, argv, quiet)
  }
}

///|
/// Detects the real host native target strictly from OS / `uname -sm`,
/// ignoring `PION_TARGET`.
fn drv_host_native_target(world : World) -> String {
  if drv_env_str(world, "OS") == "Windows_NT" {
    return "amd64_win"
  }
  match proc_exec_capture(world, ["uname", "-sm"]) {
    Ok(raw) => {
      let info = drv_trim_ws(raw)
      if drv_find_substr(info, "MINGW", 0) >= 0 ||
        drv_find_substr(info, "MSYS", 0) >= 0 ||
        drv_find_substr(info, "CYGWIN", 0) >= 0 {
        return "amd64_win"
      } else if drv_find_substr(info, "Darwin", 0) >= 0 {
        if drv_find_substr(info, "x86_64", 0) >= 0 {
          return "amd64_apple"
        } else {
          return "arm64_apple"
        }
      } else if drv_find_substr(info, "Linux", 0) >= 0 {
        if drv_find_substr(info, "aarch64", 0) >= 0 ||
          drv_find_substr(info, "arm64", 0) >= 0 {
          return "arm64"
        } else if drv_find_substr(info, "riscv64", 0) >= 0 {
          return "rv64"
        } else {
          return "amd64_sysv"
        }
      }
    }
    Err(_) => ()
  }
  if fs_exists(world, "/System/Library") {
    "arm64_apple"
  } else {
    "amd64_sysv"
  }
}

///|
fn drv_resolve_qbe_target(world : World) -> String {
  let env_t = drv_env_str(world, "PION_TARGET")
  if env_t.length() > 0 {
    return env_t
  }
  drv_host_native_target(world)
}

///|
/// This process's id (`libpionrt_cli.a`), unique among live processes.
extern "C" fn c_cli_getpid() -> Int64 = "pion_cli_getpid"

///|
/// Parent process id (`libpionrt_cli.a`; 0 on Windows).
extern "C" fn c_cli_getppid() -> Int64 = "pion_cli_getppid"

///|
/// Process-wide, thread-safe, strictly increasing sequence (from 0).
extern "C" fn c_cli_next_seq() -> Int64 = "pion_cli_next_seq"

///|
/// 1 when this `pionc` was built for a Windows host (`libpionrt_cli.a`); a
/// compile-time fact, unlike the `OS` environment variable.
extern "C" fn c_cli_is_windows() -> Int = "pion_cli_is_windows"

///|
/// Number of online logical CPUs on this host (>= 1).
extern "C" fn c_cli_cpu_count() -> Int = "pion_cli_cpu_count"

///|
/// 1 if process `pid` is alive (or conservative unknown), 0 if confirmed dead.
extern "C" fn c_cli_pid_alive(pid : Int64) -> Int = "pion_cli_pid_alive"

///|
/// Registers OS parent-death termination for a worker subprocess.
extern "C" fn c_cli_watch_parent(expected_ppid : Int64) -> Int = "pion_cli_watch_parent"

///|
/// OS-verified canonical path of the running `pionc` executable (caller frees).
extern "C" fn c_cli_self_exe_path() -> Ptr = "pion_cli_self_exe_path"

///|
/// Zero-I/O in-memory identity of the running `pionc` image (LC_UUID / ELF
/// build-id / PE headers, cached once per process; caller frees).
extern "C" fn c_cli_self_image_id() -> Ptr = "pion_cli_self_image_id"

///|
/// Single-threaded async worker subprocess launcher & reaper (`libpionrt_cli.a`).
/// Keeps parent `pionc` in ST biased-RC mode without entering `pion_enter_mt()`.
extern "C" fn c_cli_spawn_ws_worker(
  exe : Ptr,
  spec_path : Ptr,
  res_path : Ptr,
  expected_fp : Ptr,
  parent_pid_str : Ptr,
) -> Int64 = "pion_cli_spawn_ws_worker"

///|
extern "C" fn c_cli_wait_any_ws_worker() -> Int64 = "pion_cli_wait_any_ws_worker"

///|
extern "C" fn c_cli_last_ws_worker_rc() -> Int = "pion_cli_last_ws_worker_rc"

///|
/// 1 if this process can reap children with `waitpid` (SIGCHLD not SIG_IGN/SA_NOCLDWAIT).
extern "C" fn c_cli_can_reap_children() -> Int = "pion_cli_can_reap_children"

///|
fn drv_spawn_ws_worker(
  exe : String,
  spec_path : String,
  res_path : String,
  expected_fp : String,
  parent_pid_str : String,
) -> Int64 {
  let e = exe
  let s = spec_path
  let r = res_path
  let f = expected_fp
  let p = parent_pid_str
  c_cli_spawn_ws_worker(
    drv_cpath(e),
    drv_cpath(s),
    drv_cpath(r),
    drv_cpath(f),
    drv_cpath(p),
  )
}

///|
/// `lstat` kind of a path (`libpionrt_cli.a`): 0 confirmed missing, 1 regular
/// file, 2 directory, 3 symlink / reparse point, 4 other, -1 query error
/// (permissions, I/O, a bad path) — never mistaken for "missing".
extern "C" fn c_fs_lstat_kind(path : Ptr) -> Int = "pion_fs_lstat_kind"

///|
fn drv_lstat_kind(path : String) -> Int {
  let p = path
  c_fs_lstat_kind(drv_cpath(p))
}

///|
/// Builds a process-unique temporary suffix so concurrent `pionc` processes
/// running in the same millisecond never collide on shared CAS `.tmp.*` files.
fn drv_tmp_tag(world : World, salt : String) -> String {
  let ms = clock_now_ms(world).to_string()
  let pid_hint = c_cli_getpid().to_string()
  let args_sb = StringBuilder()
  let argv = world_args(world)
  let mut i = 0
  while i < argv.length() {
    if i > 0 {
      args_sb.write_char('\n')
    }
    args_sb.write_string(argv[i])
    i = i + 1
  }
  let h = sha256_hex(ms + "|" + pid_hint + "|" + args_sb.to_string() + "|" + salt)
  ms + "_" + slice_str(h, 0, 12)
}

///|
/// Atomically publishes the finished `tmp` as `dst` (rename), removing `tmp`
/// when that fails. `shared` is only for content-addressed CAS paths that
/// concurrent `pionc` processes publish with identical bytes: there a failed
/// rename (e.g. Windows refusing to replace a file another process has open)
/// still succeeds when the winner's complete `dst` exists (a non-empty regular
/// file, never a directory, symlink or 0-byte file). Paths the user named
/// (`-o`, `--emit-*`, sources, manifests, the CAS `index.tsv`) are never
/// `shared`: a stale `dst` left from before must not pass for this run's
/// output.
fn drv_publish_tmp(world : World, tmp : String, dst : String, shared : Bool) -> Bool {
  if fs_rename(world, tmp, dst) {
    true
  } else {
    let _ = fs_remove(world, tmp)
    shared && drv_is_nonempty_regular_file(world, dst)
  }
}

///|
/// Removes `paths[start..]`, ignoring files that are already gone.
fn drv_remove_files(world : World, paths : Array[String], start : Int) -> Unit {
  let mut j = start
  while j < paths.length() {
    let _ = fs_remove(world, paths[j])
    j = j + 1
  }
}

///|
/// Publishes the finished unit objects `tmps[j]` as the CAS entries `objs[j]`
/// (`drv_publish_tmp`, shared). On the first failure the remaining
/// temporaries are removed and the error is returned; "" when all published.
fn drv_publish_unit_objs(world : World, tmps : Array[String], objs : Array[String]) -> String {
  let mut j = 0
  while j < tmps.length() {
    if !drv_publish_tmp(world, tmps[j], objs[j], true) {
      drv_remove_files(world, tmps, j + 1)
      return "failed to publish CAS object: " + objs[j]
    }
    j = j + 1
  }
  ""
}

///|
/// A CAS text entry (`.pionsig`, `.pionstub`, unit `.sig` / `.stub`, which may
/// legitimately be empty) counts as present only as a regular file: never a
/// directory, symlink or other file type left at its path.
fn drv_is_regular_file(path : String) -> Bool {
  drv_lstat_kind(path) == 1
}

///|
/// A CAS entry counts as present (a hit, or a lost publish race's winner)
/// only as a non-empty regular file: a directory, symlink or 0-byte file
/// left at its path is never mistaken for a finished output.
fn drv_is_nonempty_regular_file(world : World, path : String) -> Bool {
  match drv_lstat_regular_size(world, path) {
    Some(_) => true
    None => false
  }
}

///|
/// Writes `content` to the user-named `path` atomically (temp + rename); false
/// when it could not be replaced, even if an older `path` exists.
fn drv_write_text_atomic(world : World, path : String, content : String) -> Bool {
  let tmp = path + ".tmp." + drv_tmp_tag(world, path)
  match fs_write(world, tmp, content) {
    Err(_) => {
      let _ = fs_remove(world, tmp)
      return false
    }
    Ok(_) => ()
  }
  drv_publish_tmp(world, tmp, path, false)
}

///|
/// Publishes a content-addressed CAS text file (`tmp` -> `dst`) where `expected_len`
/// may legitimately be 0 (e.g. an empty `.pionsig` or `.pionstub`). A lost
/// rename race still succeeds iff the winner's regular file matches `expected_len`.
fn drv_publish_cas_text_tmp(
  world : World,
  tmp : String,
  dst : String,
  expected_len : Int,
) -> Bool {
  if fs_rename(world, tmp, dst) {
    true
  } else {
    let _ = fs_remove(world, tmp)
    if expected_len == 0 {
      drv_is_regular_file(dst) && fs_size(world, dst) == 0L
    } else {
      drv_is_nonempty_regular_file(world, dst) &&
      fs_size(world, dst) == expected_len.to_int64()
    }
  }
}

///|
/// `drv_write_text_atomic` for a content-addressed CAS path (see
/// `drv_publish_cas_text_tmp`): losing the publish race to an identical file
/// (including legitimate 0-byte `.pionsig` / `.pionstub`) succeeds.
fn drv_write_cas_text_atomic(world : World, path : String, content : String) -> Bool {
  let tmp = path + ".tmp." + drv_tmp_tag(world, path)
  match fs_write(world, tmp, content) {
    Err(_) => {
      let _ = fs_remove(world, tmp)
      return false
    }
    Ok(_) => ()
  }
  drv_publish_cas_text_tmp(world, tmp, path, content.length())
}

///|
/// The file a link to `final_bin` produces: GCC/Clang drivers targeting
/// Windows append `.exe` when the `-o` basename has no extension.
fn drv_linked_exe_path(qbe_target : String, final_bin : String) -> String {
  cas_linked_exe_name(drv_target_is_windows(qbe_target), final_bin)
}

///|
fn drv_load_targets(
  world : World,
  targets : Array[String],
) -> Result[DrvLoaded, String] {
  if targets.length() == 0 {
    return Err("no input files specified")
  }
  let pkg_name = drv_basename_pkg(targets[0])
  let paths : Array[String] = []
  let sources : Array[String] = []
  let mut t = 0
  while t < targets.length() {
    let target = targets[t]
    if !fs_exists(world, target) {
      return Err("path does not exist: " + target)
    }
    if fs_is_dir(world, target) {
      let entries = fs_list_dir(world, target)
      let mut i = 0
      while i < entries.length() {
        let name = entries[i]
        if drv_is_source_file(name) {
          let fpath = drv_join_path(target, name)
          match fs_read(world, fpath) {
            Err(msg) => return Err("failed to read " + fpath + ": " + msg)
            Ok(content) => {
              paths.push(fpath)
              sources.push(content)
            }
          }
        }
        i = i + 1
      }
    } else {
      match fs_read(world, target) {
        Err(msg) => return Err("failed to read " + target + ": " + msg)
        Ok(content) => {
          paths.push(target)
          sources.push(content)
        }
      }
    }
    t = t + 1
  }
  Ok(DrvLoaded::{ pkg_name: pkg_name, paths: paths, sources: sources })
}

///|
/// Same as `drv_load_targets`, but records each enumerated directory's snapshot
/// directly from its `fs_list_dir` entries (used by `pionc lint`).
fn drv_load_targets_with_snaps(
  world : World,
  targets : Array[String],
  scanned_dirs : Array[String],
  dir_snapshots : Map[String, String],
) -> Result[DrvLoaded, String] {
  if targets.length() == 0 {
    return Err("no input files specified")
  }
  let pkg_name = drv_basename_pkg(targets[0])
  let paths : Array[String] = []
  let sources : Array[String] = []
  let mut t = 0
  while t < targets.length() {
    let target = targets[t]
    if !fs_exists(world, target) {
      return Err("path does not exist: " + target)
    }
    if fs_is_dir(world, target) {
      let entries = fs_list_dir(world, target)
      match drv_lint_record_dir_snap_value(
        scanned_dirs,
        dir_snapshots,
        target,
        drv_lint_snapshot_entries(entries),
      ) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      let mut i = 0
      while i < entries.length() {
        let name = entries[i]
        if drv_is_source_file(name) {
          let fpath = drv_join_path(target, name)
          match fs_read(world, fpath) {
            Err(msg) => return Err("failed to read " + fpath + ": " + msg)
            Ok(content) => {
              paths.push(fpath)
              sources.push(content)
            }
          }
        }
        i = i + 1
      }
    } else {
      match fs_read(world, target) {
        Err(msg) => return Err("failed to read " + target + ": " + msg)
        Ok(content) => {
          paths.push(target)
          sources.push(content)
        }
      }
    }
    t = t + 1
  }
  Ok(DrvLoaded::{ pkg_name: pkg_name, paths: paths, sources: sources })
}

///|
/// Parallel per-file SHA-256 pre-hash using Pion native OS threads (scope + spawn + Channel + AtomicInt).
/// Results are always reassembled in deterministic input index order.
fn drv_parallel_prehash(
  world : World,
  sources : Array[String],
  jobs : Int,
) -> Array[String] {
  let n = sources.length()
  let out : Array[String] = []
  let mut k = 0
  while k < n {
    out.push("")
    k = k + 1
  }
  if n <= 1 || jobs <= 1 {
    let mut i = 0
    while i < n {
      out[i] = sha256_hex(sources[i])
      i = i + 1
    }
    return out
  }
  let mut base = 0
  while base < n {
    let mut batch = n - base
    if batch > jobs {
      batch = jobs
    }
    let ch : Channel[String] = Channel::new(batch + 1)
    let done = AtomicInt::new(0)
    scope(world, fn(s : Scope) -> Unit {
      let mut off = 0
      while off < batch {
        let idx = base + off
        let src = sources[idx]
        spawn(s, fn() -> Unit {
          let h = sha256_hex(src)
          let _ = ch.send(idx.to_string() + ":" + h)
          let _ = done.fetch_add(1)
        })
        off = off + 1
      }
    })
    ch.close()
    while true {
      match ch.recv() {
        Some(msg) => {
          let mut colon = -1
          let mut j = 0
          while j < msg.length() {
            if str_code_at(msg, j) == 58 {
              colon = j
              break
            }
            j = j + 1
          }
          if colon > 0 {
            let idx_sb = StringBuilder()
            let mut a = 0
            while a < colon {
              idx_sb.write_char(str_code_at(msg, a).unsafe_to_char())
              a = a + 1
            }
            let h_sb = StringBuilder()
            let mut b = colon + 1
            while b < msg.length() {
              h_sb.write_char(str_code_at(msg, b).unsafe_to_char())
              b = b + 1
            }
            let idx = drv_parse_pos_int64(idx_sb.to_string(), 0L).to_int()
            if idx >= 0 && idx < n {
              out[idx] = h_sb.to_string()
            }
          }
        }
        None => break
      }
    }
    let _ = done.load()
    base = base + batch
  }
  out
}

///|
fn drv_default_jobs(world : World) -> Int {
  let env_j = drv_env_str(world, "PION_JOBS")
  if env_j.length() > 0 {
    drv_parse_pos_int(env_j, 16)
  } else {
    16
  }
}

///|
fn drv_sort_strings(arr : Array[String]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && key < arr[j] {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///|
extern "C" fn c_fs_lock(path : Ptr) -> Int64 = "pion_fs_lock"

///|
/// Serializes every read-modify-write of `<cache_dir>/index.tsv` across
/// `pionc` processes: a blocking exclusive lock (`flock` / `LockFileEx`) on
/// `index.tsv.lock`, released with `c_fs_unlock` (the kernel drops it if the
/// holder dies). -1 when the lock file cannot be opened (an unwritable
/// cache), in which case the caller proceeds unlocked.
fn drv_cas_index_lock(world : World, cache_dir : String) -> Int64 {
  let _ = fs_mkdir_p(world, cache_dir)
  let lock_path = cache_dir + "/index.tsv.lock"
  c_fs_lock(drv_cpath(lock_path))
}

///|
/// The CAS index entries, `Some([])` when `index_path` is confirmed missing,
/// or `None` when something is there that is not a readable regular file (a
/// directory, a symlink — dangling ones included — or a read error) or its
/// `lstat` itself fails: callers must then leave it alone rather than
/// overwrite it with an empty index.
fn drv_cas_read_index(world : World, index_path : String) -> Option[Array[CasEntry]] {
  let kind = drv_lstat_kind(index_path)
  if kind == 0 {
    Some([])
  } else if kind == 1 {
    match fs_read(world, index_path) {
      Ok(txt) => Some(cas_parse_index(txt))
      Err(_) => None
    }
  } else {
    None
  }
}

///|
/// Per-process kernel-locked CAS pin session (`$PION_CACHE_DIR/pins/<pid>_<seq>.pin`
/// + `.pin.lock`). While locked, concurrent `pionc` processes read the pin file
/// under `index.tsv.lock` and never evict its keys; if this process crashes or is
/// SIGKILLed, the kernel drops the lock and the next `pionc` cleans the stale files.
struct DrvCasPinSession {
  cache_dir : String
  data_path : String
  lock_path : String
  mut lock_handle : Int64
  keys : Array[String]
  seen : Map[String, Bool]
  mut flushed_len : Int
  temp_dirs : Array[String]
  temp_files : Array[String]
}

///|
fn drv_cas_pin_none() -> DrvCasPinSession {
  DrvCasPinSession::{
    cache_dir: "",
    data_path: "",
    lock_path: "",
    lock_handle: -1L,
    keys: [],
    seen: Map([]),
    flushed_len: 0,
    temp_dirs: [],
    temp_files: [],
  }
}

///|
fn drv_cas_pin_open(world : World, cache_dir : String) -> DrvCasPinSession {
  let pins_dir = cache_dir + "/pins"
  let kind = drv_lstat_kind(pins_dir)
  if kind == 0 {
    let _ = fs_mkdir_p(world, pins_dir)
  }
  if drv_lstat_kind(pins_dir) != 2 {
    return DrvCasPinSession::{
      cache_dir: cache_dir,
      data_path: "",
      lock_path: "",
      lock_handle: -1L,
      keys: [],
      seen: Map([]),
      flushed_len: 0,
      temp_dirs: [],
      temp_files: [],
    }
  }
  let id = c_cli_getpid().to_string() + "_" + c_cli_next_seq().to_string()
  let lock_path = pins_dir + "/" + id + ".pin.lock"
  let data_path = pins_dir + "/" + id + ".pin"
  // Briefly serialize creation+locking of `.pin.lock` with `index.tsv.lock` so
  // concurrent `drv_cas_collect_peer_pins` cannot delete a newly created lock
  // file in the gap between `open(O_CREAT)` and `flock`.
  let idx_lk = drv_cas_index_lock(world, cache_dir)
  if idx_lk < 0L {
    return DrvCasPinSession::{
      cache_dir: cache_dir,
      data_path: "",
      lock_path: "",
      lock_handle: -1L,
      keys: [],
      seen: Map([]),
      flushed_len: 0,
      temp_dirs: [],
      temp_files: [],
    }
  }
  let lp = lock_path
  let lk = c_fs_lock(drv_cpath(lp))
  c_fs_unlock(idx_lk)
  DrvCasPinSession::{
    cache_dir: cache_dir,
    data_path: data_path,
    lock_path: lock_path,
    lock_handle: lk,
    keys: [],
    seen: Map([]),
    flushed_len: 0,
    temp_dirs: [],
    temp_files: [],
  }
}

///|
fn drv_cas_pin_add(pin : DrvCasPinSession, key : String) -> Unit {
  if !cas_is_safe_key(key) {
    return
  }
  if !pin.seen.contains(key) {
    pin.seen.set(key, true)
    pin.keys.push(key)
  }
}

///|
fn drv_cas_pin_flush(world : World, pin : DrvCasPinSession) -> Bool {
  if pin.lock_handle < 0L || pin.data_path.length() == 0 {
    return false
  }
  if pin.keys.length() == pin.flushed_len {
    return true
  }
  let sb = StringBuilder()
  let mut i = 0
  while i < pin.keys.length() {
    sb.write_string(pin.keys[i])
    sb.write_char('\n')
    i = i + 1
  }
  if drv_write_text_atomic(world, pin.data_path, sb.to_string()) {
    pin.flushed_len = pin.keys.length()
    true
  } else {
    false
  }
}

///|
/// Linearizes a CAS HIT with concurrent eviction: records & atomically flushes
/// `keys` into this process's kernel-locked pin file, then verifies under
/// `index.tsv.lock` that every path in `verify_paths` still exists as a
/// non-empty regular file. Returns `false` (caller must downgrade to MISS) if
/// pinning fails or any path was concurrently evicted before our pin landed.
fn drv_cas_pin_and_verify(
  world : World,
  cache_dir : String,
  pin : DrvCasPinSession,
  keys : Array[String],
  verify_paths : Array[String],
) -> Bool {
  let mut ki = 0
  while ki < keys.length() {
    drv_cas_pin_add(pin, keys[ki])
    ki = ki + 1
  }
  // When no active pin session exists (`drv_cas_pin_none()` or read-only/unflockable
  // cache), degrade to direct regular-file verification rather than invalidating
  // every hot CAS HIT.
  if pin.lock_handle < 0L {
    let mut vi = 0
    while vi < verify_paths.length() {
      match drv_lstat_regular_size(world, verify_paths[vi]) {
        Some(_) => ()
        None => return false
      }
      vi = vi + 1
    }
    return true
  }
  if !drv_cas_pin_flush(world, pin) {
    return false
  }
  let lk = drv_cas_index_lock(world, cache_dir)
  if lk < 0L {
    return false
  }
  let mut ok = true
  let mut vi = 0
  while vi < verify_paths.length() {
    match drv_lstat_regular_size(world, verify_paths[vi]) {
      Some(_) => ()
      None => {
        ok = false
        break
      }
    }
    vi = vi + 1
  }
  c_fs_unlock(lk)
  ok
}

///|
/// Linearizes a cold CAS publish with concurrent eviction:
/// 1. Requires an active pin session (`pin.lock_handle >= 0L`);
/// 2. Adds all `keys` and atomically flushes the pin file;
/// 3. Acquires `index.tsv.lock` and atomically renames `src_tmp` -> `dst_cas`
///    while holding the lock.
/// Returns `false` if pinning or locking fails (leaving `src_tmp` intact so
/// the caller can fall back to using `src_tmp` privately for this run).
fn drv_cas_publish_file_pinned(
  world : World,
  cache_dir : String,
  pin : DrvCasPinSession,
  keys : Array[String],
  src_tmp : String,
  dst_cas : String,
) -> Bool {
  if pin.lock_handle < 0L {
    return false
  }
  let mut ki = 0
  while ki < keys.length() {
    drv_cas_pin_add(pin, keys[ki])
    ki = ki + 1
  }
  if !drv_cas_pin_flush(world, pin) {
    return false
  }
  let lk = drv_cas_index_lock(world, cache_dir)
  if lk < 0L {
    return false
  }
  let ok = match drv_lstat_regular_size(world, src_tmp) {
    None => false
    Some(_) =>
      if fs_rename(world, src_tmp, dst_cas) {
        match drv_lstat_regular_size(world, dst_cas) {
          Some(_) => true
          None => false
        }
      } else {
        match drv_lstat_regular_size(world, dst_cas) {
          Some(_) => {
            let _ = fs_remove(world, src_tmp)
            true
          }
          None => false
        }
      }
  }
  c_fs_unlock(lk)
  ok
}

///|
fn drv_cas_pin_clean_temp_dirs(world : World, pin : DrvCasPinSession) -> Unit {
  let mut i = 0
  while i < pin.temp_dirs.length() {
    let d = pin.temp_dirs[i]
    if d.length() > 0 {
      let _ = drv_clean_cstub_stage_dir(world, d)
    }
    i = i + 1
  }
  pin.temp_dirs.clear()
  i = 0
  while i < pin.temp_files.length() {
    let f = pin.temp_files[i]
    if f.length() > 0 {
      let _ = fs_remove(world, f)
    }
    i = i + 1
  }
  pin.temp_files.clear()
}

///|
/// Releases this process's pin files while the caller already holds
/// `index.tsv.lock` (avoids self-deadlocking on `index.tsv.lock`).
fn drv_cas_pin_close_unlocked(world : World, pin : DrvCasPinSession) -> Unit {
  drv_cas_pin_clean_temp_dirs(world, pin)
  if pin.data_path.length() > 0 {
    let _ = fs_remove(world, pin.data_path)
  }
  if pin.lock_handle >= 0L {
    c_fs_unlock(pin.lock_handle)
    pin.lock_handle = -1L
  }
  if pin.lock_path.length() > 0 {
    let _ = fs_remove(world, pin.lock_path)
  }
}

///|
fn drv_cas_pin_close(world : World, pin : DrvCasPinSession) -> Unit {
  drv_cas_pin_clean_temp_dirs(world, pin)
  if pin.data_path.length() > 0 {
    let _ = fs_remove(world, pin.data_path)
  }
  let idx_lk = if pin.cache_dir.length() > 0 &&
    (pin.lock_handle >= 0L || pin.lock_path.length() > 0) {
    drv_cas_index_lock(world, pin.cache_dir)
  } else {
    -1L
  }
  if pin.lock_handle >= 0L {
    c_fs_unlock(pin.lock_handle)
    pin.lock_handle = -1L
  }
  if pin.lock_path.length() > 0 {
    let _ = fs_remove(world, pin.lock_path)
  }
  if idx_lk >= 0L {
    c_fs_unlock(idx_lk)
  }
}

///|
/// Scans `$cache_dir/pins/` while holding `index.tsv.lock`: removes stale pin
/// files whose process has exited/crashed (trylock succeeds) and collects all
/// keys pinned by still-live peer processes into `out_protected`.
fn drv_cas_collect_peer_pins(
  world : World,
  cache_dir : String,
  self_lock_path : String,
  out_protected : Array[String],
) -> Unit {
  let pins_dir = cache_dir + "/pins"
  if drv_lstat_kind(pins_dir) != 2 {
    return
  }
  let entries = fs_list_dir(world, pins_dir)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if drv_ends_with(name, ".pin.lock") {
      let lp = pins_dir + "/" + name
      if lp != self_lock_path {
        let dp = pins_dir + "/" + slice_str(name, 0, name.length() - 5)
        let lp_c = lp
        let lk = c_fs_trylock(drv_cpath(lp_c))
        if lk >= 0L {
          c_fs_unlock(lk)
          let _ = fs_remove(world, dp)
          let _ = fs_remove(world, lp)
        } else if drv_lstat_kind(dp) == 1 {
          match fs_read(world, dp) {
            Ok(txt) => {
              let lines = drv_split_lines(txt)
              let mut li = 0
              while li < lines.length() {
                let k = lines[li]
                if cas_is_safe_key(k) {
                  out_protected.push(k)
                }
                li = li + 1
              }
            }
            Err(_) => ()
          }
        }
      }
    }
    i = i + 1
  }
}

///|
fn drv_cas_remove_in_bucket(
  world : World,
  cache_dir : String,
  bucket : String,
  rel_file : String,
) -> Unit {
  let bdir = cache_dir + "/" + bucket
  if drv_lstat_kind(bdir) != 2 {
    return
  }
  let _ = fs_remove(world, bdir + "/" + rel_file)
}

///|
/// Removes all on-disk CAS artifacts belonging to one index key `ek`.
/// Enforces key whitelist (`cas_is_safe_key`) and refuses to follow symlinked
/// bucket directories.
fn drv_cas_remove_entry(world : World, cache_dir : String, ek : String) -> Unit {
  if !cas_is_safe_key(ek) {
    return
  }
  if drv_starts_with(ek, "testbin:") {
    drv_cas_remove_in_bucket(
      world,
      cache_dir,
      "testbin",
      slice_str(ek, 8, ek.length()),
    )
    return
  }
  if drv_starts_with(ek, "wasmbin:") {
    drv_cas_remove_in_bucket(
      world,
      cache_dir,
      "bin",
      "wasm_" + slice_str(ek, 8, ek.length()) + ".wasm",
    )
    return
  }
  drv_cas_remove_in_bucket(world, cache_dir, "sig", ek + ".pionsig")
  drv_cas_remove_in_bucket(world, cache_dir, "sig", ek + ".pionstub")
  drv_cas_remove_in_bucket(world, cache_dir, "ssa", ek + ".ssa")
  drv_cas_remove_in_bucket(world, cache_dir, "obj", ek + ".o")
  drv_cas_remove_in_bucket(world, cache_dir, "obj", ek + ".a")
  drv_cas_remove_in_bucket(world, cache_dir, "obj", ek + ".res")
  drv_cas_remove_in_bucket(world, cache_dir, "obj", ek + ".deps")
  drv_cas_remove_in_bucket(world, cache_dir, "bin", ek)
  drv_cas_remove_in_bucket(world, cache_dir, "bin", "wasm_" + ek + ".wasm")
}

///|
/// Records `keys` in the CAS index and evicts down to the size budget while
/// protecting every key in `keys ∪ pin.keys ∪ active_peer_pins` (and refreshing
/// LRU timestamps of hot HITs).
fn drv_cas_record_batch_and_evict_pinned(
  world : World,
  cache_dir : String,
  keys : Array[String],
  sizes : Array[Int64],
  pin : DrvCasPinSession,
) -> Unit {
  let mut ki = 0
  while ki < keys.length() {
    drv_cas_pin_add(pin, keys[ki])
    ki = ki + 1
  }
  let _ = drv_cas_pin_flush(world, pin)
  if keys.length() == 0 && pin.keys.length() == 0 {
    return
  }
  let index_path = cache_dir + "/index.tsv"
  let lk = drv_cas_index_lock(world, cache_dir)
  if lk < 0L {
    return
  }
  let entries = match drv_cas_read_index(world, index_path) {
    Some(v) => v
    None => {
      c_fs_unlock(lk)
      return
    }
  }
  let protected : Array[String] = []
  let mut pi = 0
  while pi < pin.keys.length() {
    protected.push(pin.keys[pi])
    pi = pi + 1
  }
  drv_cas_collect_peer_pins(world, cache_dir, pin.lock_path, protected)
  let now = clock_now_ms(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let ev = cas_touch_batch_and_evict(
    entries,
    keys,
    sizes,
    now,
    max_bytes,
    protected,
  )
  let mut i = 0
  while i < ev.evicted.length() {
    drv_cas_remove_entry(world, cache_dir, ev.evicted[i])
    i = i + 1
  }
  let _ = drv_write_text_atomic(world, index_path, cas_format_index(ev.kept))
  c_fs_unlock(lk)
}

///|
/// Records `key` in the CAS index and evicts down to the size budget while
/// protecting `pin` and active peer pins.
fn drv_cas_record_and_evict_pinned(
  world : World,
  cache_dir : String,
  key : String,
  entry_bytes : Int64,
  pin : DrvCasPinSession,
) -> Unit {
  drv_cas_record_batch_and_evict_pinned(
    world,
    cache_dir,
    [key],
    [entry_bytes],
    pin,
  )
}

///|
/// Records `key` in the CAS index and evicts down to the size budget. Only
/// under the index lock and from a readable index: when either is missing
/// the index (and every cached file) is left untouched.
fn drv_cas_record_and_evict(
  world : World,
  cache_dir : String,
  key : String,
  entry_bytes : Int64,
) -> Unit {
  drv_cas_record_batch_and_evict_pinned(
    world,
    cache_dir,
    [key],
    [entry_bytes],
    drv_cas_pin_none(),
  )
}

///|
fn drv_cas_record_batch_and_evict(
  world : World,
  cache_dir : String,
  keys : Array[String],
  sizes : Array[Int64],
) -> Unit {
  if keys.length() == 0 {
    return
  }
  drv_cas_record_batch_and_evict_pinned(
    world,
    cache_dir,
    keys,
    sizes,
    drv_cas_pin_none(),
  )
}

///|
/// Post-run CAS budget trim executed only after a command finishes linking,
/// copying outputs, or running all test child processes. Atomically releases
/// this process's pin under `index.tsv.lock`, refreshes LRU timestamps on all
/// keys used by this run, and trims down to 80% watermark while never evicting
/// `keep_keys` (returned output paths) or any active concurrent peer's pins.
fn drv_cas_post_run_evict(
  world : World,
  cache_dir : String,
  pin : DrvCasPinSession,
  keep_keys : Array[String],
) -> Unit {
  let index_path = cache_dir + "/index.tsv"
  let lk = drv_cas_index_lock(world, cache_dir)
  if lk < 0L {
    drv_cas_pin_close(world, pin)
    return
  }
  drv_cas_pin_close_unlocked(world, pin)
  if pin.keys.length() == 0 && keep_keys.length() == 0 {
    c_fs_unlock(lk)
    return
  }
  let entries = match drv_cas_read_index(world, index_path) {
    Some(v) => v
    None => {
      c_fs_unlock(lk)
      return
    }
  }
  let protected : Array[String] = []
  let mut ki = 0
  while ki < keep_keys.length() {
    if cas_is_safe_key(keep_keys[ki]) {
      protected.push(keep_keys[ki])
    }
    ki = ki + 1
  }
  drv_cas_collect_peer_pins(world, cache_dir, "", protected)
  let now = clock_now_ms(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let ev = cas_evict_post_run(entries, now, max_bytes, pin.keys, protected)
  let mut i = 0
  while i < ev.evicted.length() {
    drv_cas_remove_entry(world, cache_dir, ev.evicted[i])
    i = i + 1
  }
  if ev.kept.length() > 0 || ev.evicted.length() > 0 {
    let _ = drv_write_text_atomic(world, index_path, cas_format_index(ev.kept))
  }
  c_fs_unlock(lk)
}

///|
fn drv_split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == 10 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < s.length() {
    out.push(slice_str(s, start, s.length()))
  }
  out
}

///|
fn drv_compute_compiler_fp(
  world : World,
  qbe_bin : String,
  rt_lib : String,
  qbe_target : String,
  sysroot : String,
) -> String {
  let qsz = fs_size(world, qbe_bin)
  let rsz = fs_size(world, rt_lib)
  let env_salt_raw = drv_env_str(world, "PION_CACHE_SALT")
  let j2_dis = drv_env_str(world, "PION_J2_DISABLE")
  let env_salt = if j2_dis.length() > 0 {
    env_salt_raw + "|j2dis=" + j2_dis
  } else {
    env_salt_raw
  }
  let as_driver = drv_resolve_cc_driver(world, qbe_target, false)
  let as_flags = drv_target_as_flags(world, qbe_target, sysroot, as_driver)
  let obj_pol = "|objpol:k1a-v1|as:" +
    drv_join_char(as_flags, ",") +
    (if drv_win_seh(world, qbe_target) { "|seh" } else { "" })
  let self_id = drv_self_image_id()
  let self_bin = if self_id.length() == 0 { drv_self_exe_path(world) } else { "" }
  let salt = if self_id.length() > 0 {
    "selfid:" + self_id + obj_pol + "|" + env_salt
  } else if self_bin.length() > 0 && fs_exists(world, self_bin) {
    "self:" +
    fs_size(world, self_bin).to_string() +
    ":" +
    fs_mtime_ms(world, self_bin).to_string() +
    obj_pol +
    "|" +
    env_salt
  } else {
    obj_pol + "|" + env_salt
  }
  cas_compiler_fp(qsz, rsz, salt)
}

///|
/// Lightweight compiler fingerprint that depends on the running `pionc`
/// executable's in-memory image identity (`pion_cli_self_image_id`, 0 disk I/O),
/// version, `tag`, and `$PION_CACHE_SALT`, without probing `qbe` or `libpionrt.a`
/// (used by `pionc check` and zero-toolchain `--target wasm32` CAS).
fn drv_compute_self_fp(world : World, tag : String) -> String {
  let self_id = drv_self_image_id()
  let env_salt_raw = drv_env_str(world, "PION_CACHE_SALT")
  let j2_dis = drv_env_str(world, "PION_J2_DISABLE")
  let env_salt = if j2_dis.length() > 0 {
    env_salt_raw + "|j2dis=" + j2_dis
  } else {
    env_salt_raw
  }
  if self_id.length() > 0 {
    return cas_compiler_fp(
      0L,
      0L,
      tag + "|0.1.0|selfid:" + self_id + "|" + env_salt,
    )
  }
  let self_bin = drv_self_exe_path(world)
  let self_sz = if self_bin.length() > 0 && fs_exists(world, self_bin) {
    fs_size(world, self_bin)
  } else {
    0L
  }
  let self_mt = if self_bin.length() > 0 && fs_exists(world, self_bin) {
    fs_mtime_ms(world, self_bin)
  } else {
    0L
  }
  cas_compiler_fp(
    self_sz,
    0L,
    tag + "|0.1.0|self:" + self_sz.to_string() + ":" + self_mt.to_string() + "|" + env_salt,
  )
}

///|
fn drv_normalize_path(path_in : String) -> String {
  // A Windows drive path (`C:`, `C:/...`, `C:\...`): `\` is a separator too
  // and the drive root `C:/` is never popped.
  let mut path = path_in
  let mut root = ""
  if drv_is_drive_abs(path_in) {
    root = slice_str(path_in, 0, 2) + "/"
    let rb = StringBuilder()
    let mut run = 2
    let mut q = 2
    while q < path_in.length() {
      if str_code_at(path_in, q) == 92 {
        rb.write_string(slice_str(path_in, run, q))
        rb.write_string("/")
        run = q + 1
      }
      q = q + 1
    }
    rb.write_string(slice_str(path_in, run, path_in.length()))
    path = "/" + rb.to_string()
  }
  let is_abs = path.length() > 0 && str_code_at(path, 0) == 47
  let parts : Array[String] = []
  let mut seg_start = 0
  let mut i = 0
  while i <= path.length() {
    let is_sep = i == path.length() || str_code_at(path, i) == 47
    if is_sep {
      // Segments are copied as whole byte ranges so UTF-8 names stay intact.
      let seg = slice_str(path, seg_start, i)
      seg_start = i + 1
      if seg.length() == 0 || seg == "." {
        ()
      } else if seg == ".." {
        if parts.length() > 0 && parts[parts.length() - 1] != ".." {
          let _ = parts.pop()
        } else if !is_abs {
          parts.push("..")
        }
      } else {
        parts.push(seg)
      }
    }
    i = i + 1
  }
  let out = StringBuilder()
  if root.length() > 0 {
    out.write_string(root)
  } else if is_abs {
    out.write_char('/')
  }
  let mut j = 0
  while j < parts.length() {
    if j > 0 {
      out.write_char('/')
    }
    out.write_string(parts[j])
    j = j + 1
  }
  let res = out.to_string()
  if res.length() == 0 {
    "."
  } else {
    res
  }
}

///|
/// True for a Windows drive root or drive-absolute path: `C:`, `C:/...` or
/// `C:\...` (not `g:repo.git`, an scp-style remote).
fn drv_is_drive_abs(p : String) -> Bool {
  if p.length() < 2 || str_code_at(p, 1) != 58 {
    return false
  }
  let c = str_code_at(p, 0)
  if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {
    return false
  }
  if p.length() == 2 {
    return true
  }
  let s = str_code_at(p, 2)
  s == 47 || s == 92
}

///|
fn drv_resolve_rel_path(base_dir : String, rel : String) -> String {
  if rel.length() > 0 && (str_code_at(rel, 0) == 47 || drv_is_drive_abs(rel)) {
    drv_normalize_path(rel)
  } else {
    drv_normalize_path(drv_join_path(base_dir, rel))
  }
}

///|
fn drv_detect_manifest_dir(world : World, target : String) -> Option[String] {
  if target == "pion.toml" || drv_ends_with(target, "/pion.toml") {
    let pd = drv_parent_dir(target)
    return Some(if pd.length() == 0 { "." } else { pd })
  }
  if fs_is_dir(world, target) {
    let mf = drv_join_path(target, "pion.toml")
    if fs_exists(world, mf) {
      return Some(drv_normalize_path(target))
    }
  }
  None
}

///|
struct DrvSrcPair {
  paths : Array[String]
  sources : Array[String]
  root_dir_snap : String
  src_dir_snap : String
}

///|
fn drv_validate_manifest_target_files(
  world : World,
  pkg_dir : String,
  target_rules : Map[String, Array[String]],
) -> Result[Unit, String] {
  let keys = target_rules.keys()
  let mut i = 0
  while i < keys.length() {
    let rel = keys[i]
    let full = drv_join_path(pkg_dir, rel)
    if !fs_exists(world, full) || fs_is_dir(world, full) {
      return Err(
        "pion.toml [targets]: file `" + rel + "` does not exist in " + pkg_dir,
      )
    }
    i = i + 1
  }
  Ok(())
}

///|
fn drv_load_pkg_dir_sources_for(
  world : World,
  pkg_dir : String,
  target_rules : Map[String, Array[String]],
  active_target : String,
  capture_snaps : Bool,
) -> Result[DrvSrcPair, String] {
  let paths : Array[String] = []
  let sources : Array[String] = []
  let entries = fs_list_dir(world, pkg_dir)
  let root_dir_snap = if capture_snaps {
    drv_lint_snapshot_entries(entries)
  } else {
    ""
  }
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if drv_is_source_file(name) &&
      manifest_target_file_active(target_rules, name, active_target) {
      let fpath = drv_join_path(pkg_dir, name)
      match fs_read(world, fpath) {
        Err(msg) => return Err("failed to read " + fpath + ": " + msg)
        Ok(content) => {
          paths.push(fpath)
          sources.push(content)
        }
      }
    }
    i = i + 1
  }
  let src_dir = drv_join_path(pkg_dir, "src")
  let mut src_dir_snap = if capture_snaps { "<absent>" } else { "" }
  if fs_is_dir(world, src_dir) {
    let sentries = fs_list_dir(world, src_dir)
    if capture_snaps {
      src_dir_snap = drv_lint_snapshot_entries(sentries)
    }
    let mut j = 0
    while j < sentries.length() {
      let name = sentries[j]
      if drv_is_source_file(name) &&
        manifest_target_file_active(target_rules, "src/" + name, active_target) {
        let fpath = drv_join_path(src_dir, name)
        match fs_read(world, fpath) {
          Err(msg) => return Err("failed to read " + fpath + ": " + msg)
          Ok(content) => {
            paths.push(fpath)
            sources.push(content)
          }
        }
      }
      j = j + 1
    }
  }
  Ok(DrvSrcPair::{
    paths: paths,
    sources: sources,
    root_dir_snap: root_dir_snap,
    src_dir_snap: src_dir_snap,
  })
}

///|
fn drv_load_pkg_dir_sources(
  world : World,
  pkg_dir : String,
) -> Result[DrvSrcPair, String] {
  drv_load_pkg_dir_sources_for(world, pkg_dir, Map([]), "", false)
}

///|
/// Git dependency cache: `$PION_CACHE_DIR/git`, else `$HOME/.cache/pion/git`.
/// `repos/<sha256(url)>.git` are bare mirrors, `checkouts/<rev>` the shared
/// read-only source trees every worktree builds from.
fn drv_git_cache_root(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  let raw = if custom.length() > 0 {
    drv_normalize_path(custom + "/git")
  } else {
    let home = drv_env_str(world, "HOME")
    if home.length() > 0 {
      drv_normalize_path(drv_join_path(home, ".cache/pion/git"))
    } else {
      drv_join_path(drv_temp_dir(world), "pion-git")
    }
  }
  drv_canon_dir(world, raw)
}

///|
fn drv_trim_ws(s : String) -> String {
  let mut a = 0
  let mut b = s.length()
  while a < b {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      a = a + 1
    } else {
      break
    }
  }
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      b = b - 1
    } else {
      break
    }
  }
  slice_str(s, a, b)
}

///|
/// Runs `git <args>` without a terminal prompt and with only the
/// `file`/`http`/`https`/`ssh` transports allowed (no `ext::` helpers); stdout
/// is captured and trimmed (never mixed into pionc's own JSON output).
fn drv_git(world : World, args : Array[String]) -> Result[String, String] {
  match drv_git_raw(world, args) {
    Ok(out) => Ok(drv_trim_ws(out))
    Err(e) => Err(e)
  }
}

///|
/// Marker between git's stdout and its captured stderr in a failed run.
fn drv_git_err_mark() -> String {
  let rs = 30
  let sb = StringBuilder()
  sb.write_char(rs.unsafe_to_char())
  sb.write_string("PION_GIT_STDERR")
  sb.write_char(rs.unsafe_to_char())
  sb.to_string()
}

///|
/// Runs `git <args>` like `drv_git` but returns stdout byte for byte (no
/// trimming; NUL bytes kept). git's stderr never reaches the terminal raw: on
/// POSIX it is captured and, on failure, appended to the error with every
/// control character neutralized (`drv_term_safe`); on Windows it is dropped.
fn drv_git_raw(world : World, args : Array[String]) -> Result[String, String] {
  let windows = drv_env_str(world, "OS") == "Windows_NT"
  let argv : Array[String] = if windows {
    []
  } else {
    ["sh", "-c", drv_git_sh_wrap("\"$@\""), "pionc-git"]
  }
  argv.push("env")
  argv.push("GIT_TERMINAL_PROMPT=0")
  argv.push("GIT_ALLOW_PROTOCOL=file:http:https:ssh")
  argv.push("git")
  let mut i = 0
  while i < args.length() {
    argv.push(args[i])
    i = i + 1
  }
  let r = if windows {
    match proc_exec_capture_bytes(world, argv) {
      Ok(b) => Ok(b.to_string())
      Err(e) => Err(e)
    }
  } else {
    proc_exec_capture(world, argv)
  }
  match r {
    Ok(out) => Ok(out)
    Err(e) => Err(drv_git_err_text(e))
  }
}

///|
/// The `sh` prologue/epilogue around a git command (`$f` holds its stderr):
/// on failure the stderr is printed after `drv_git_err_mark()`.
fn drv_git_sh_wrap(cmd : String) -> String {
  "f=$(mktemp) || exit 125; " +
  cmd +
  " 2>\"$f\"; rc=$?; if [ $rc -ne 0 ]; then printf '\\036PION_GIT_STDERR\\036'; cat \"$f\"; fi; rm -f \"$f\"; exit $rc"
}

///|
/// A failed wrapped git run as one line: exit status, stdout, then the
/// captured stderr, every control character neutralized.
fn drv_git_err_text(e : String) -> String {
  let m = drv_find_substr(e, drv_git_err_mark(), 0)
  let msg = if m >= 0 {
    drv_trim_ws(slice_str(e, 0, m)) +
    " " +
    drv_trim_ws(slice_str(e, m + drv_git_err_mark().length(), e.length()))
  } else {
    e
  }
  drv_trim_ws(drv_term_safe(msg))
}

///|
fn drv_rm_rf(world : World, path : String) -> Unit {
  let _ = proc_exec_capture(world, ["chmod", "-R", "u+w", path])
  let _ = proc_exec_capture(world, ["rm", "-rf", path])
}

///|
struct DrvEnclosingWs {
  root_dir : String
  manifest : PackageManifest
  manifest_text : String
}

///|
struct DrvGitCtx {
  git_root : String
  old_lock : Array[LockEntry]
  new_lock : Array[LockEntry]
  fetched : Map[String, Bool]
  ws_root : Option[DrvEnclosingWs]
  ws_member_canon : Map[String, Bool]
  anchor_root : String
  root_pins : Map[String, String]
  root_pin_origins : Map[String, DrvGitOrigin]
  root_pin_ambiguous : Map[String, Bool]
  locked : Bool
  offline : Bool
  active_target : String
}

///|
struct DrvGitOrigin {
  git_url : String
  rev : String
  checkout_root : String
}

///|
struct DrvGitResolved {
  dir : String
  origin : DrvGitOrigin
}

///|
fn drv_record_root_pin(
  ctx : DrvGitCtx,
  pkg_name : String,
  dir : String,
  origin : Option[DrvGitOrigin],
) -> Unit {
  if pkg_name.length() == 0 || ctx.root_pin_ambiguous.contains(pkg_name) {
    return
  }
  match ctx.root_pins.get(pkg_name) {
    Some(prev) =>
      if prev != dir {
        ctx.root_pin_ambiguous.set(pkg_name, true)
      } else {
        match origin {
          Some(o) =>
            if !ctx.root_pin_origins.contains(pkg_name) {
              ctx.root_pin_origins.set(pkg_name, o)
            }
          None => ()
        }
      }
    None => {
      ctx.root_pins.set(pkg_name, dir)
      match origin {
        Some(o) => ctx.root_pin_origins.set(pkg_name, o)
        None => ()
      }
    }
  }
}

///|
fn drv_cwd(world : World) -> String {
  match drv_canon_out_path(world, ".") {
    Ok(p) => drv_normalize_path(p)
    Err(_) =>
      if c_cli_is_windows() == 0 {
        drv_env_str(world, "PWD")
      } else {
        ""
      }
  }
}

///|
fn drv_abs_path(world : World, path : String) -> String {
  if path.length() > 0 && (str_code_at(path, 0) == 47 || drv_is_drive_abs(path)) {
    return drv_normalize_path(path)
  }
  let cwd = drv_cwd(world)
  if cwd.length() > 0 && (str_code_at(cwd, 0) == 47 || drv_is_drive_abs(cwd)) {
    drv_normalize_path(drv_join_path(cwd, path))
  } else {
    drv_normalize_path(path)
  }
}

///|
fn drv_ws_declares_member(
  world : World,
  ws_root : String,
  ws_mf : PackageManifest,
  target_canon : String,
) -> Bool {
  let norm_root = drv_normalize_path(ws_root)
  if drv_canon_dir(world, norm_root) == target_canon {
    return true
  }
  let mut i = 0
  while i < ws_mf.workspace_members.length() {
    let norm_pat = drv_normalize_path(ws_mf.workspace_members[i])
    if drv_str_has_star(norm_pat) {
      let seen : Map[String, Bool] = Map([])
      let matched : Array[String] = []
      let pat_segs = drv_split_rel_segs(norm_pat)
      drv_glob_member_dirs(
        world,
        norm_root,
        "",
        0,
        pat_segs,
        norm_pat,
        seen,
        matched,
      )
      let mut mi = 0
      while mi < matched.length() {
        if drv_canon_dir(world, matched[mi]) == target_canon {
          return true
        }
        mi = mi + 1
      }
    } else {
      let cand = drv_resolve_rel_path(norm_root, norm_pat)
      if drv_canon_dir(world, cand) == target_canon {
        return true
      }
    }
    i = i + 1
  }
  false
}

///|
fn drv_walk_enclosing_workspace(
  world : World,
  start_cur : String,
  target_canon : String,
) -> Option[DrvEnclosingWs] {
  let mut cur = start_cur
  let mut depth = 0
  while depth < 16 {
    let mf_path = drv_join_path(cur, "pion.toml")
    if fs_exists(world, mf_path) {
      match fs_read(world, mf_path) {
        Ok(txt) =>
          match parse_pion_toml(txt) {
            Ok(mf) =>
              if mf.is_workspace &&
                drv_ws_declares_member(world, cur, mf, target_canon) {
                return Some(DrvEnclosingWs::{ root_dir: cur, manifest: mf, manifest_text: txt })
              }
            Err(_) => ()
          }
        Err(_) => ()
      }
    }
    if cur == "/" || cur == "." || cur.length() == 0 {
      break
    }
    let parent = drv_parent_dir(cur)
    if parent == cur || parent.length() == 0 {
      break
    }
    cur = parent
    depth = depth + 1
  }
  None
}

///|
/// Walks upward from `start_dir` (up to 16 parent levels) to find the nearest
/// enclosing directory whose `pion.toml` declares `[workspace]` and explicitly
/// includes `start_dir` (matched by canonical physical directory). Checks
/// literal ancestors first (preserving caller path spelling and supporting
/// outward member symlinks like `ws/ma -> /external/ma`), then falls back to
/// physical ancestors (supporting inward symlinks like `view/ma -> ws/ma`).
fn drv_find_enclosing_workspace(
  world : World,
  start_dir : String,
) -> Option[DrvEnclosingWs] {
  let target_canon = drv_canon_dir(world, start_dir)
  let literal_abs = drv_abs_path(world, start_dir)
  match drv_walk_enclosing_workspace(world, literal_abs, target_canon) {
    Some(ws) => Some(ws)
    None =>
      if target_canon != literal_abs {
        drv_walk_enclosing_workspace(world, target_canon, target_canon)
      } else {
        None
      }
  }
}

///|
fn drv_str_has_star(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == 42 {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_split_rel_segs(norm : String) -> Array[String] {
  let segs : Array[String] = []
  let n = norm.length()
  let mut start = 0
  if n > 0 && str_code_at(norm, 0) == 47 {
    start = 1
  }
  let mut i = start
  while i <= n {
    if i == n || str_code_at(norm, i) == 47 {
      if i > start {
        let seg = slice_str(norm, start, i)
        if seg != "." {
          segs.push(seg)
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  segs
}

///|
fn drv_glob_member_dirs(
  world : World,
  ws_root : String,
  cur_rel : String,
  depth : Int,
  pat_segs : Array[String],
  pat : String,
  seen : Map[String, Bool],
  out : Array[String],
) -> Unit {
  if depth == pat_segs.length() {
    if manifest_match_member_pattern(pat, cur_rel) {
      let full = drv_resolve_rel_path(ws_root, cur_rel)
      if fs_exists(world, drv_join_path(full, "pion.toml")) && !seen.contains(full) {
        seen.set(full, true)
        out.push(full)
      }
    }
    return
  }
  let dir_to_list = if cur_rel.length() == 0 {
    ws_root
  } else {
    drv_join_path(ws_root, cur_rel)
  }
  if !fs_is_dir(world, dir_to_list) {
    return
  }
  let seg_pat = pat_segs[depth]
  let seg_is_exact = !drv_str_has_star(seg_pat)
  let entries = fs_list_dir(world, dir_to_list)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name.length() > 0 &&
      str_code_at(name, 0) != 46 &&
      name != "_build" &&
      name != "target" &&
      name != "out" &&
      name != "vendor" {
      if !seg_is_exact || name == seg_pat {
        let next_rel = if cur_rel.length() == 0 { name } else { cur_rel + "/" + name }
        let full = drv_join_path(ws_root, next_rel)
        if fs_is_dir(world, full) {
          drv_glob_member_dirs(
            world,
            ws_root,
            next_rel,
            depth + 1,
            pat_segs,
            pat,
            seen,
            out,
          )
        }
      }
    }
    i = i + 1
  }
}

///|
/// Expands `[workspace] members` patterns (exact paths and single-segment globs
/// such as `packages/*`) under `ws_root_dir`, sorted lexicographically and
/// deduplicated. Hybrid roots (both `[package]` and `[workspace]`) include
/// `ws_root_dir` itself.
fn drv_expand_workspace_members(
  world : World,
  ws_root_dir : String,
  ws_mf : PackageManifest,
) -> Result[Array[String], String] {
  let norm_root = drv_normalize_path(ws_root_dir)
  let seen : Map[String, Bool] = Map([])
  let out : Array[String] = []
  if ws_mf.name.length() > 0 {
    seen.set(norm_root, true)
    out.push(norm_root)
  }
  let mut i = 0
  while i < ws_mf.workspace_members.length() {
    let pat = ws_mf.workspace_members[i]
    let norm_pat = drv_normalize_path(pat)
    if drv_str_has_star(norm_pat) {
      let pat_segs = drv_split_rel_segs(norm_pat)
      drv_glob_member_dirs(world, norm_root, "", 0, pat_segs, norm_pat, seen, out)
    } else {
      let cand = drv_resolve_rel_path(norm_root, norm_pat)
      if !fs_exists(world, drv_join_path(cand, "pion.toml")) {
        return Err(
          "workspace member `" + pat + "` has no pion.toml at " + cand,
        )
      }
      if !seen.contains(cand) {
        seen.set(cand, true)
        out.push(cand)
      }
    }
    i = i + 1
  }
  drv_sort_strings(out)
  Ok(out)
}

///|
fn drv_pkg_dir_has_main(
  world : World,
  pkg_dir : String,
  pkg_name : String,
  target_rules : Map[String, Array[String]],
  active_target : String,
) -> Bool {
  match drv_load_pkg_dir_sources_for(world, pkg_dir, target_rules, active_target, false) {
    Err(_) => false
    Ok(loaded) => {
      let pkg = parse_package(pkg_name, loaded.paths, loaded.sources)
      let mut fi = 0
      while fi < pkg.files.length() {
        let f = pkg.files[fi]
        let mut di = 0
        while di < f.decls.length() {
          match f.decls[di] {
            DFn(fd) =>
              if fd.name == "main" {
                return true
              }
            _ => ()
          }
          di = di + 1
        }
        fi = fi + 1
      }
      false
    }
  }
}

///|
fn drv_join_comma(items : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(items[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Resolves `root_dir` + optional `--package <name>` into a single concrete
/// package directory for `pionc build` / `pionc run`.
fn drv_resolve_build_pkg_dir(
  world : World,
  root_dir : String,
  only_pkg : String,
  active_target : String,
) -> Result[String, String] {
  let mf_path = drv_join_path(drv_normalize_path(root_dir), "pion.toml")
  let mf_txt = match fs_read(world, mf_path) {
    Err(e) => return Err("failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(mf_txt) {
    Err(e) => return Err(e)
    Ok(m) => m
  }
  if only_pkg.length() > 0 {
    if mf.is_workspace {
      let ws_abs = drv_abs_path(world, root_dir)
      let members = match drv_expand_workspace_members(world, ws_abs, mf) {
        Err(e) => return Err(e)
        Ok(ms) => ms
      }
      let avail : Array[String] = []
      let mut i = 0
      while i < members.length() {
        let mdir = members[i]
        match fs_read(world, drv_join_path(mdir, "pion.toml")) {
          Ok(mt) =>
            match parse_pion_toml(mt) {
              Ok(mmf) => {
                if mmf.name == only_pkg {
                  return Ok(mdir)
                }
                if mmf.name.length() > 0 {
                  avail.push(mmf.name)
                }
              }
              Err(_) => ()
            }
          Err(_) => ()
        }
        i = i + 1
      }
      return Err(
        "no workspace member named `" +
        only_pkg +
        "` in " +
        root_dir +
        " (available: " +
        drv_join_comma(avail) +
        ")",
      )
    }
    if mf.name == only_pkg {
      return Ok(root_dir)
    }
    match drv_find_enclosing_workspace(world, root_dir) {
      Some(ws) =>
        return drv_resolve_build_pkg_dir(world, ws.root_dir, only_pkg, active_target)
      None =>
        return Err("no package `" + only_pkg + "` in " + root_dir)
    }
  }
  if !mf.is_workspace || mf.name.length() > 0 {
    return Ok(root_dir)
  }
  // Pure virtual workspace root without --package: pick the unique member with `fn main`.
  let ws_abs = drv_abs_path(world, root_dir)
  let members = match drv_expand_workspace_members(world, ws_abs, mf) {
    Err(e) => return Err(e)
    Ok(ms) => ms
  }
  let main_dirs : Array[String] = []
  let main_names : Array[String] = []
  let all_names : Array[String] = []
  let mut i = 0
  while i < members.length() {
    let mdir = members[i]
    match fs_read(world, drv_join_path(mdir, "pion.toml")) {
      Ok(mt) =>
        match parse_pion_toml(mt) {
          Ok(mmf) => {
            if mmf.name.length() > 0 {
              all_names.push(mmf.name)
              if drv_pkg_dir_has_main(world, mdir, mmf.name, mmf.target_rules, active_target) {
                main_dirs.push(mdir)
                main_names.push(mmf.name)
              }
            }
          }
          Err(_) => ()
        }
      Err(_) => ()
    }
    i = i + 1
  }
  if main_dirs.length() == 1 {
    return Ok(main_dirs[0])
  }
  if main_dirs.length() > 1 {
    return Err(
      "virtual workspace has multiple binary members (" +
      drv_join_comma(main_names) +
      "); specify one with --package <name>",
    )
  }
  Err(
    "virtual workspace has no member with `fn main`; specify a member with --package <name> (members: " +
    drv_join_comma(all_names) +
    ")",
  )
}

///|
fn drv_git_resolve_rev(
  world : World,
  repo : String,
  dep : ManifestDep,
) -> Result[String, String] {
  let spec = if dep.tag.length() > 0 {
    "refs/tags/" + dep.tag + "^{commit}"
  } else if dep.rev.length() > 0 {
    dep.rev + "^{commit}"
  } else if dep.branch.length() > 0 {
    "refs/heads/" + dep.branch + "^{commit}"
  } else {
    "HEAD^{commit}"
  }
  if drv_starts_with(spec, "-") {
    return Err("refusing git revision `" + spec + "`: it must not start with `-`")
  }
  drv_git(world, ["--git-dir", repo, "rev-parse", "--verify", "--quiet", spec])
}

///|
fn drv_git_has_commit(world : World, repo : String, rev : String) -> Bool {
  match drv_git(world, ["--git-dir", repo, "cat-file", "-e", rev + "^{commit}"]) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn drv_git_fetch_once(
  world : World,
  ctx : DrvGitCtx,
  repo : String,
  url : String,
) -> Result[Unit, String] {
  if ctx.fetched.contains(repo) {
    return Ok(())
  }
  if ctx.offline {
    return Err("cannot fetch git dependency `" + url + "` in --offline mode")
  }
  ctx.fetched.set(repo, true)
  if drv_starts_with(url, "-") {
    return Err("refusing git URL `" + url + "`: it must not start with `-`")
  }
  if !fs_is_dir(world, repo) {
    let _ = fs_mkdir_p(world, ctx.git_root + "/repos")
    let tmp = match drv_mktemp_dir_near(world, repo) {
      Err(e) => return Err(e)
      Ok(d) => d
    }
    match drv_git(world, ["clone", "--quiet", "--mirror", "--", url, tmp]) {
      Err(e) => {
        drv_rm_rf(world, tmp)
        return Err("git clone " + url + " failed: " + e)
      }
      Ok(_) => ()
    }
    if !fs_rename(world, tmp, repo) {
      drv_rm_rf(world, tmp)
      if !fs_is_dir(world, repo) {
        return Err("failed to move git mirror into " + repo)
      }
    }
    return Ok(())
  }
  match drv_git(world, ["--git-dir", repo, "fetch", "--quiet", "--prune", "--tags", "origin"]) {
    Err(e) => Err("git fetch " + url + " failed: " + e)
    Ok(_) => Ok(())
  }
}

///|
/// Materializes `rev` once into the shared `checkouts/<rev>` tree (files made
/// read-only, no `.git`), atomically via rename.
fn drv_git_checkout(
  world : World,
  ctx : DrvGitCtx,
  repo : String,
  rev : String,
) -> Result[String, String] {
  if !lock_is_hex_oid(rev) {
    return Err("refusing git revision `" + rev + "`: not a full hex commit id")
  }
  let co = ctx.git_root + "/checkouts/" + rev
  if fs_is_dir(world, co) {
    return Ok(co)
  }
  let _ = fs_mkdir_p(world, ctx.git_root + "/checkouts")
  let tmp = co + ".tmp." + drv_tmp_tag(world, co)
  match drv_git(world, ["clone", "--quiet", "--shared", "--no-checkout", "--", repo, tmp]) {
    Err(e) => {
      drv_rm_rf(world, tmp)
      return Err("git clone of cached mirror failed: " + e)
    }
    Ok(_) => ()
  }
  match drv_git(world, ["-C", tmp, "-c", "advice.detachedHead=false", "checkout", "--quiet", "--detach", rev]) {
    Err(e) => {
      drv_rm_rf(world, tmp)
      return Err("git checkout " + rev + " failed: " + e)
    }
    Ok(_) => ()
  }
  drv_rm_rf(world, tmp + "/.git")
  if !fs_rename(world, tmp, co) {
    drv_rm_rf(world, tmp)
    if !fs_is_dir(world, co) {
      return Err("failed to move git checkout into " + co)
    }
    return Ok(co)
  }
  let _ = proc_exec_capture(world, ["find", co, "-type", "f", "-exec", "chmod", "a-w", "{}", "+"])
  Ok(co)
}

///|
/// Resolves a git dependency to its package directory inside the shared git
/// cache, reusing the `pion.lock` pin when it still matches `pion.toml` (then
/// no git command runs at all once the checkout exists).
fn drv_git_dep_dir(
  world : World,
  ctx : DrvGitCtx,
  dep : ManifestDep,
) -> Result[DrvGitResolved, String] {
  let url = dep.git
  let pkg_name = manifest_dep_pkg_name(dep)
  if drv_starts_with(url, "-") {
    return Err(
      "git dependency `" + dep.name + "`: refusing git URL `" + url + "`: it must not start with `-`",
    )
  }
  let repo = ctx.git_root + "/repos/" + sha256_hex(pkg_normalize_git_url(url)) + ".git"
  let reference = manifest_dep_ref(dep)
  let mut rev = match lock_find_checked(ctx.new_lock, dep) {
    Err(e) => return Err(e)
    Ok(Some(e)) => e.rev
    Ok(None) =>
      match lock_find_checked(ctx.old_lock, dep) {
        Err(e) => return Err(e)
        Ok(Some(e)) => e.rev
        Ok(None) => ""
      }
  }
  if rev.length() == 0 && ctx.locked {
    return Err(
      "git dependency `" +
      dep.name +
      "` is not locked in pion.lock (re-run without --locked to update pion.lock)",
    )
  }
  if rev.length() == 0 && ctx.offline {
    return Err(
      "git dependency `" +
      dep.name +
      "` is not locked in pion.lock and --offline prevents fetching",
    )
  }
  if rev.length() > 0 && !lock_is_hex_oid(rev) {
    return Err(
      "git dependency `" + dep.name + "`: locked rev `" + rev + "` is not a full hex commit id",
    )
  }
  let co_ready = rev.length() > 0 &&
    fs_is_dir(world, ctx.git_root + "/checkouts/" + rev)
  if !co_ready {
    if rev.length() > 0 {
      // Locked, but this machine has no checkout yet: make sure the commit is local.
      let mut have = fs_is_dir(world, repo) && drv_git_has_commit(world, repo, rev)
      if !have {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        have = drv_git_has_commit(world, repo, rev)
      }
      if !have {
        return Err(
          "git dependency `" + dep.name + "`: locked rev " + rev + " not found in " + url,
        )
      }
    } else {
      // Unlocked: tags and full revs resolve from the mirror; branches and HEAD always fetch.
      let floating = dep.tag.length() == 0 && dep.rev.length() == 0
      if floating || !fs_is_dir(world, repo) {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
      let mut resolved = match drv_git_resolve_rev(world, repo, dep) {
        Ok(r) => r
        Err(_) => ""
      }
      if resolved.length() == 0 {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        resolved = match drv_git_resolve_rev(world, repo, dep) {
          Ok(r) => r
          Err(_) => ""
        }
      }
      if resolved.length() == 0 {
        return Err(
          "git dependency `" + dep.name + "`: cannot resolve " + reference + " in " + url,
        )
      }
      rev = resolved
    }
    match drv_git_checkout(world, ctx, repo, rev) {
      Err(e) => return Err("git dependency `" + dep.name + "`: " + e)
      Ok(_) => ()
    }
  }
  let norm_sub = pkg_normalize_subdir(dep.subdir)
  match lock_add(ctx.new_lock, lock_entry_new_pkg(pkg_name, "", url, reference, rev, norm_sub)) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let co = drv_canon_dir(world, ctx.git_root + "/checkouts/" + rev)
  let dir_raw = if norm_sub.length() > 0 {
    drv_resolve_rel_path(co, norm_sub)
  } else {
    co
  }
  let dir = drv_canon_dir(world, dir_raw)
  if !drv_starts_with(dir + "/", co + "/") {
    return Err("git dependency `" + dep.name + "`: subdir escapes the repository")
  }
  if !fs_exists(world, drv_join_path(dir, "pion.toml")) {
    return Err(
      "git dependency `" +
      dep.name +
      "`: no pion.toml at " +
      (if norm_sub.length() > 0 { "subdir `" + norm_sub + "` of " } else { "" }) +
      url +
      " (" +
      rev +
      ")",
    )
  }
  Ok(DrvGitResolved::{
    dir: dir,
    origin: DrvGitOrigin::{ git_url: url, rev: rev, checkout_root: co },
  })
}

///|
fn drv_canon_dir(world : World, p : String) -> String {
  match drv_canon_out_path(world, p) {
    Ok(c) => drv_normalize_path(c)
    Err(_) => drv_normalize_path(drv_abs_path(world, p))
  }
}

///|
fn drv_load_workspace_dfs(
  world : World,
  ctx : DrvGitCtx,
  pkg_dir : String,
  expected_pkg_name : String,
  dep_alias : String,
  git_origin : Option[DrvGitOrigin],
  visited_canon : Map[String, String],
  visited_declared : Map[String, String],
  out : Array[PkgNodeInput],
  manifest_paths : Array[String],
  manifest_texts : Map[String, String],
  scanned_dirs : Array[String],
  dir_snapshots : Map[String, String],
  capture_snaps : Bool,
) -> Result[String, String] {
  let display_dir = drv_normalize_path(drv_abs_path(world, pkg_dir))
  let norm_dir = drv_canon_dir(world, pkg_dir)
  let mf_path = drv_join_path(display_dir, "pion.toml")
  if !fs_exists(world, mf_path) {
    return Err("missing pion.toml in " + display_dir)
  }
  let mf_txt = match fs_read(world, mf_path) {
    Err(e) => return Err("failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(mf_txt) {
    Err(e) => return Err(e)
    Ok(m) => m
  }
  if expected_pkg_name.length() > 0 && mf.name != expected_pkg_name {
    return Err(
      "dependency `" +
      dep_alias +
      "` (" +
      mf_path +
      ") does not declare package `" +
      expected_pkg_name +
      "` (found `[package].name = \"" +
      mf.name +
      "\"`)",
    )
  }
  let (source_id, is_root_anchor) = match git_origin {
    Some(go) => {
      let co_canon = drv_canon_dir(world, go.checkout_root)
      let co_rel = pkg_rebase_rel_path(co_canon, norm_dir)
      let sub = if co_rel == "." { "" } else { co_rel }
      (pkg_source_id_git(go.git_url, go.rev, sub, mf.name), false)
    }
    None => {
      let rel_loc = pkg_rebase_rel_path(ctx.anchor_root, norm_dir)
      (pkg_source_id_path(rel_loc, mf.name), rel_loc == ".")
    }
  }
  match visited_canon.get(source_id) {
    Some(existing_canon) => {
      if expected_pkg_name.length() > 0 {
        match visited_declared.get(source_id) {
          Some(decl_name) =>
            if decl_name != expected_pkg_name {
              return Err(
                "dependency `" +
                dep_alias +
                "` (" +
                mf_path +
                ") does not declare package `" +
                expected_pkg_name +
                "` (found `[package].name = \"" +
                decl_name +
                "\"`)",
              )
            }
          None => ()
        }
      }
      return Ok(existing_canon)
    }
    None => ()
  }
  manifest_paths.push(mf_path)
  manifest_texts.set(mf_path, mf_txt)
  let canon_id = pkg_canon_id(mf.name, source_id, is_root_anchor)
  visited_canon.set(source_id, canon_id)
  visited_declared.set(source_id, mf.name)
  let dep_targets : Array[String] = []
  let dep_aliases : Array[String] = []
  // `{ workspace = true }` inherits from the workspace that encloses *this*
  // package, not the consumer's: an external path/git package belonging to its
  // own `[workspace]` resolves against that one, and a package no workspace
  // declares as a member gets an error. Members of the consumer's workspace
  // reuse `ctx.ws_root` (no extra I/O); others are looked up lazily, once.
  let mut pkg_ws_looked_up = false
  let mut pkg_ws : Option[DrvEnclosingWs] = None
  let mut i = 0
  while i < mf.deps.length() {
    let raw_dep = mf.deps[i]
    if raw_dep.workspace && !pkg_ws_looked_up {
      pkg_ws_looked_up = true
      pkg_ws = if ctx.ws_member_canon.contains(norm_dir) {
        ctx.ws_root
      } else {
        drv_find_enclosing_workspace(world, display_dir)
      }
      match pkg_ws {
        Some(ws) => {
          let ws_mf_path = drv_join_path(ws.root_dir, "pion.toml")
          if !manifest_texts.contains(ws_mf_path) {
            manifest_paths.push(ws_mf_path)
            manifest_texts.set(ws_mf_path, ws.manifest_text)
          }
        }
        None => ()
      }
    }
    let dep = if raw_dep.workspace {
      match pkg_ws {
        Some(ws) =>
          match manifest_resolve_ws_dep(
            raw_dep,
            ws.root_dir,
            norm_dir,
            ws.manifest.workspace_deps,
          ) {
            Ok(d) => d
            Err(e) => return Err(e)
          }
        None =>
          return Err(
            "dependency '" +
            raw_dep.name +
            "' marked workspace = true but no enclosing [workspace] pion.toml found for " +
            norm_dir,
          )
      }
    } else {
      raw_dep
    }
    let want_pkg = manifest_dep_pkg_name(dep)
    let mut dep_dir = ""
    let mut child_git_origin : Option[DrvGitOrigin] = None
    // Dependencies inherited from the package's own workspace are never redirected
    // onto a same-named consumer root pin.
    let can_use_root_pin = !raw_dep.workspace &&
      drv_is_external_pkg(ctx.git_root, norm_dir) &&
      !manifest_dep_is_git(dep) &&
      dep.package.length() == 0 &&
      !ctx.root_pin_ambiguous.contains(dep.name) &&
      ctx.root_pins.contains(dep.name)
    if can_use_root_pin {
      match ctx.root_pins.get(dep.name) {
        Some(pinned) => {
          dep_dir = pinned
          match ctx.root_pin_origins.get(dep.name) {
            Some(o) => child_git_origin = Some(o)
            None => ()
          }
        }
        None => {
          let phys_dep = drv_resolve_rel_path(norm_dir, dep.path)
          let disp_dep = drv_resolve_rel_path(display_dir, dep.path)
          dep_dir = if drv_canon_dir(world, disp_dep) == drv_canon_dir(world, phys_dep) {
            disp_dep
          } else {
            phys_dep
          }
        }
      }
    } else if manifest_dep_is_git(dep) {
      match drv_git_dep_dir(world, ctx, dep) {
        Err(e) => return Err(e)
        Ok(gr) => {
          dep_dir = gr.dir
          child_git_origin = Some(gr.origin)
        }
      }
    } else {
      let phys_dep = drv_resolve_rel_path(norm_dir, dep.path)
      let disp_dep = drv_resolve_rel_path(display_dir, dep.path)
      dep_dir = if drv_canon_dir(world, disp_dep) == drv_canon_dir(world, phys_dep) {
        disp_dep
      } else {
        phys_dep
      }
      match git_origin {
        Some(go) => {
          let dep_canon = drv_canon_dir(world, dep_dir)
          let co_canon = drv_canon_dir(world, go.checkout_root)
          if drv_starts_with(dep_canon + "/", co_canon + "/") {
            child_git_origin = Some(go)
          }
        }
        None => ()
      }
    }
    let child_canon = match drv_load_workspace_dfs(
      world,
      ctx,
      dep_dir,
      want_pkg,
      dep.name,
      child_git_origin,
      visited_canon,
      visited_declared,
      out,
      manifest_paths,
      manifest_texts,
      scanned_dirs,
      dir_snapshots,
      capture_snaps,
    ) {
      Err(e) => return Err(e)
      Ok(cid) => cid
    }
    dep_targets.push(child_canon)
    dep_aliases.push(dep.name)
    i = i + 1
  }
  match drv_validate_manifest_target_files(world, display_dir, mf.target_rules) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let loaded_src = match drv_load_pkg_dir_sources_for(
    world,
    display_dir,
    mf.target_rules,
    ctx.active_target,
    capture_snaps,
  ) {
    Err(e) => return Err(e)
    Ok(v) => v
  }
  if capture_snaps {
    match drv_lint_record_dir_snap_value(
      scanned_dirs,
      dir_snapshots,
      display_dir,
      loaded_src.root_dir_snap,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    match drv_lint_record_dir_snap_value(
      scanned_dirs,
      dir_snapshots,
      drv_join_path(display_dir, "src"),
      loaded_src.src_dir_snap,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  out.push(PkgNodeInput::{
    name: canon_id,
    declared_name: mf.name,
    source_id: source_id,
    dir: display_dir,
    deps: dep_targets,
    dep_aliases: dep_aliases,
    paths: loaded_src.paths,
    sources: manifest_apply_verify(loaded_src.sources, mf.verify_enabled),
    link_libs: mf.link_libs,
    link_common: mf.link_common,
    link_macos: mf.link_macos,
    link_linux: mf.link_linux,
    link_ios: mf.link_ios,
    link_android: mf.link_android,
    link_windows: mf.link_windows,
    link_wasm: mf.link_wasm,
    verify_enabled: mf.verify_enabled,
    target_rules: mf.target_rules,
  })
  Ok(canon_id)
}

///|
struct DrvWsLoad {
  nodes : Array[PkgNodeInput]
  lock : Array[LockEntry]
  lock_path : String
  lock_existed : Bool
  lock_text : String
  git_root : String
  manifest_paths : Array[String]
  manifest_texts : Map[String, String]
  scanned_dirs : Array[String]
  dir_snapshots : Map[String, String]
}

///|
/// Loads every package of the workspace rooted at `root_dir` (dependencies
/// first, root last), fetching git dependencies into the shared cache and
/// rewriting `<root>/pion.lock` only when its content changes.
fn drv_load_workspace(world : World, root_dir : String) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(world, root_dir, false, "", None, "", false, false, "", false)
}

///|
fn drv_load_workspace_opts(
  world : World,
  root_dir : String,
  locked : Bool,
  offline : Bool,
  web_rt_dst : String,
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(world, root_dir, false, "", None, web_rt_dst, locked, offline, "", false)
}

///|
fn drv_load_workspace_opts_target(
  world : World,
  root_dir : String,
  locked : Bool,
  offline : Bool,
  web_rt_dst : String,
  active_target : String,
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(
    world,
    root_dir,
    false,
    "",
    None,
    web_rt_dst,
    locked,
    offline,
    active_target,
    false,
  )
}

///|
fn drv_load_workspace_opts_target_ro(
  world : World,
  root_dir : String,
  locked : Bool,
  offline : Bool,
  web_rt_dst : String,
  active_target : String,
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(
    world,
    root_dir,
    false,
    "",
    None,
    web_rt_dst,
    locked,
    offline,
    active_target,
    true,
  )
}

///|
fn drv_load_workspace_with_guard(
  world : World,
  root_dir : String,
  web_rt_dst : String,
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(world, root_dir, false, "", None, web_rt_dst, false, false, "", false)
}

///|
/// `drv_load_workspace`, first dropping the `pion.lock` pins of every git
/// dependency (`unlock_all`) or of `unlock_name`, so they re-resolve to their
/// newest target ref (`pionc add` / `pionc update`).
fn drv_load_workspace_ex(
  world : World,
  root_dir : String,
  unlock_all : Bool,
  unlock_name : String,
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(world, root_dir, unlock_all, unlock_name, None, "", false, false, "", false)
}

///|
fn drv_load_workspace_unlock_dep(
  world : World,
  root_dir : String,
  unlock_all : Bool,
  unlock_dep : Option[ManifestDep],
) -> Result[DrvWsLoad, String] {
  drv_load_workspace_core(world, root_dir, unlock_all, "", unlock_dep, "", false, false, "", false)
}

///|
fn drv_load_workspace_core(
  world : World,
  root_dir : String,
  unlock_all : Bool,
  unlock_name : String,
  unlock_dep : Option[ManifestDep],
  web_rt_dst : String,
  locked : Bool,
  offline : Bool,
  active_target_in : String,
  no_write_lock : Bool,
) -> Result[DrvWsLoad, String] {
  let root_mf_path = drv_join_path(drv_normalize_path(root_dir), "pion.toml")
  if !fs_exists(world, root_mf_path) {
    return Err("missing pion.toml in " + drv_normalize_path(root_dir))
  }
  let root_mf_txt = match fs_read(world, root_mf_path) {
    Err(e) => return Err("failed to read " + root_mf_path + ": " + e)
    Ok(t) => t
  }
  let root_mf = match parse_pion_toml(root_mf_txt) {
    Err(e) => return Err(e)
    Ok(m) => m
  }
  let enclosing_ws = if root_mf.is_workspace {
    Some(DrvEnclosingWs::{
      root_dir: drv_abs_path(world, root_dir),
      manifest: root_mf,
      manifest_text: root_mf_txt,
    })
  } else {
    drv_find_enclosing_workspace(world, root_dir)
  }
  let manifest_paths : Array[String] = [root_mf_path]
  let manifest_texts : Map[String, String] = Map([])
  let scanned_dirs : Array[String] = []
  let dir_snapshots : Map[String, String] = Map([])
  manifest_texts.set(root_mf_path, root_mf_txt)
  match enclosing_ws {
    Some(ws) => {
      let ws_mf_path = drv_join_path(ws.root_dir, "pion.toml")
      if ws_mf_path != root_mf_path {
        manifest_paths.push(ws_mf_path)
        manifest_texts.set(ws_mf_path, ws.manifest_text)
      }
    }
    None => ()
  }
  let lock_base = match enclosing_ws {
    Some(ws) => ws.root_dir
    None => drv_normalize_path(root_dir)
  }
  let lock_path = drv_join_path(lock_base, "pion.lock")
  let has_lock = fs_exists(world, lock_path)
  let old_text = if has_lock {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(e) => return Err("failed to read " + lock_path + ": " + e)
    }
  } else {
    ""
  }
  let parsed_lock = if has_lock {
    match parse_pion_lock(old_text) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
  } else {
    []
  }
  let old_lock : Array[LockEntry] = []
  if !unlock_all {
    let mut li = 0
    while li < parsed_lock.length() {
      let le = parsed_lock[li]
      let drop_it = match unlock_dep {
        Some(ud) =>
          lock_entry_pkg_name(le) == manifest_dep_pkg_name(ud) &&
          pkg_normalize_git_url(le.git) == pkg_normalize_git_url(ud.git) &&
          pkg_normalize_subdir(le.subdir) == pkg_normalize_subdir(ud.subdir) &&
          le.reference == manifest_dep_ref(ud)
        None => unlock_name.length() > 0 && lock_entry_pkg_name(le) == unlock_name
      }
      if !drop_it {
        old_lock.push(le)
      }
      li = li + 1
    }
  }
  let anchor_root = match enclosing_ws {
    Some(ws) => drv_canon_dir(world, ws.root_dir)
    None => drv_canon_dir(world, root_dir)
  }
  let active_target = if active_target_in.length() > 0 {
    active_target_in
  } else {
    drv_resolve_qbe_target(world)
  }
  let ctx = DrvGitCtx::{
    git_root: drv_git_cache_root(world),
    old_lock: old_lock,
    new_lock: [],
    fetched: Map([]),
    ws_root: enclosing_ws,
    ws_member_canon: Map([]),
    anchor_root: anchor_root,
    root_pins: Map([]),
    root_pin_origins: Map([]),
    root_pin_ambiguous: Map([]),
    locked: locked,
    offline: offline,
    active_target: active_target,
  }
  // Collect explicit unaliased root/workspace package pins before DFS so external
  // git-cached packages unify unaliased relative `../<dep>` paths onto the root's
  // unique chosen version without folding explicitly aliased or multi-source deps.
  match enclosing_ws {
    Some(ws) => {
      ctx.ws_member_canon.set(drv_canon_dir(world, ws.root_dir), true)
      match drv_expand_workspace_members(world, ws.root_dir, ws.manifest) {
        Ok(ws_members) => {
          let mut wmi = 0
          while wmi < ws_members.length() {
            let mdir = drv_canon_dir(world, ws_members[wmi])
            ctx.ws_member_canon.set(mdir, true)
            let mmf_path = drv_join_path(mdir, "pion.toml")
            if fs_exists(world, mmf_path) {
              manifest_paths.push(mmf_path)
              match fs_read(world, mmf_path) {
                Ok(mtxt) => {
                  manifest_texts.set(mmf_path, mtxt)
                  match parse_pion_toml(mtxt) {
                    Ok(mmf) =>
                      if mmf.name.length() > 0 {
                        drv_record_root_pin(ctx, mmf.name, mdir, None)
                      }
                    Err(_) => ()
                  }
                }
                Err(_) => ()
              }
            }
            wmi = wmi + 1
          }
        }
        Err(_) => ()
      }
      let mut wdi = 0
      while wdi < ws.manifest.workspace_deps.length() {
        let wdep = ws.manifest.workspace_deps[wdi]
        if wdep.package.length() == 0 {
          if manifest_dep_is_git(wdep) {
            match drv_git_dep_dir(world, ctx, wdep) {
              Err(e) => return Err(e)
              Ok(gr) =>
                drv_record_root_pin(
                  ctx,
                  wdep.name,
                  drv_canon_dir(world, gr.dir),
                  Some(gr.origin),
                )
            }
          } else {
            drv_record_root_pin(
              ctx,
              wdep.name,
              drv_canon_dir(world, drv_resolve_rel_path(ws.root_dir, wdep.path)),
              None,
            )
          }
        }
        wdi = wdi + 1
      }
    }
    None => ()
  }
  if !root_mf.is_workspace {
    let pin_root_dir = drv_canon_dir(world, root_dir)
    if root_mf.name.length() > 0 {
      drv_record_root_pin(ctx, root_mf.name, pin_root_dir, None)
    }
    let mut rdi = 0
    while rdi < root_mf.deps.length() {
      let raw_dep = root_mf.deps[rdi]
      let rdep = if raw_dep.workspace {
        match ctx.ws_root {
          Some(ws) =>
            match manifest_resolve_ws_dep(
              raw_dep,
              ws.root_dir,
              pin_root_dir,
              ws.manifest.workspace_deps,
            ) {
              Ok(d) => d
              Err(e) => return Err(e)
            }
          None =>
            return Err(
              "dependency '" +
              raw_dep.name +
              "' marked workspace = true but no enclosing [workspace] pion.toml found for " +
              pin_root_dir,
            )
        }
      } else {
        raw_dep
      }
      if rdep.package.length() == 0 {
        if manifest_dep_is_git(rdep) {
          match drv_git_dep_dir(world, ctx, rdep) {
            Err(e) => return Err(e)
            Ok(gr) =>
              drv_record_root_pin(
                ctx,
                rdep.name,
                drv_canon_dir(world, gr.dir),
                Some(gr.origin),
              )
          }
        } else {
          drv_record_root_pin(
            ctx,
            rdep.name,
            drv_canon_dir(world, drv_resolve_rel_path(pin_root_dir, rdep.path)),
            None,
          )
        }
      }
      rdi = rdi + 1
    }
  }
  let visited_canon : Map[String, String] = Map([])
  let visited_declared : Map[String, String] = Map([])
  let out : Array[PkgNodeInput] = []
  if root_mf.is_workspace {
    let ws_abs = drv_abs_path(world, root_dir)
    let members = match drv_expand_workspace_members(world, ws_abs, root_mf) {
      Err(e) => return Err(e)
      Ok(ms) => ms
    }
    let mut mi = 0
    while mi < members.length() {
      match drv_load_workspace_dfs(
        world,
        ctx,
        members[mi],
        "",
        "",
        None,
        visited_canon,
        visited_declared,
        out,
        manifest_paths,
        manifest_texts,
        scanned_dirs,
        dir_snapshots,
        no_write_lock,
      ) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      mi = mi + 1
    }
    let mut wi = 0
    while wi < root_mf.workspace_deps.length() {
      let wdep = root_mf.workspace_deps[wi]
      if manifest_dep_is_git(wdep) {
        match drv_git_dep_dir(world, ctx, wdep) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
      wi = wi + 1
    }
  } else {
    let start_dir = drv_abs_path(world, root_dir)
    match drv_load_workspace_dfs(
      world,
      ctx,
      start_dir,
      "",
      "",
      None,
      visited_canon,
      visited_declared,
      out,
      manifest_paths,
      manifest_texts,
      scanned_dirs,
      dir_snapshots,
      no_write_lock,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  // Guard against canonical ID collisions across distinct source identities.
  let seen_canon_src : Map[String, String] = Map([])
  let mut dup_i = 0
  while dup_i < out.length() {
    let node = out[dup_i]
    match seen_canon_src.get(node.name) {
      Some(prev_src) =>
        if prev_src != node.source_id {
          return Err(
            "duplicate canonical package id '" +
            node.name +
            "' resolved from multiple sources:\n  1) " +
            prev_src +
            "\n  2) " +
            node.source_id,
          )
        }
      None => seen_canon_src.set(node.name, node.source_id)
    }
    dup_i = dup_i + 1
  }
  let final_lock : Array[LockEntry] = []
  let mut nl_i = 0
  while nl_i < ctx.new_lock.length() {
    final_lock.push(ctx.new_lock[nl_i])
    nl_i = nl_i + 1
  }
  let partial_member_load = !root_mf.is_workspace &&
    (match enclosing_ws {
      Some(_) => true
      None => false
    })
  if partial_member_load {
    let mut ol_i = 0
    while ol_i < ctx.old_lock.length() {
      let oe = ctx.old_lock[ol_i]
      let mut present = false
      let mut fl_i = 0
      while fl_i < final_lock.length() {
        let fe = final_lock[fl_i]
        if lock_entry_pkg_name(fe) == lock_entry_pkg_name(oe) &&
          pkg_normalize_git_url(fe.git) == pkg_normalize_git_url(oe.git) &&
          pkg_normalize_subdir(fe.subdir) == pkg_normalize_subdir(oe.subdir) &&
          fe.reference == oe.reference {
          present = true
          break
        }
        fl_i = fl_i + 1
      }
      if !present {
        final_lock.push(oe)
      }
      ol_i = ol_i + 1
    }
  }
  if web_rt_dst.length() > 0 {
    match drv_check_web_rt_loaded_paths(world, web_rt_dst, manifest_paths) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if lock_path.length() > 0 {
      match drv_check_web_rt_loaded_paths(world, web_rt_dst, [lock_path]) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
  }
  if has_lock || final_lock.length() > 0 {
    let sem_same = has_lock && lock_entries_equiv(parsed_lock, final_lock)
    let new_text = format_pion_lock(final_lock)
    if locked || offline {
      if !sem_same {
        if locked {
          return Err(
            "pion.lock is out of date (run without --locked to update " +
            lock_path +
            ")",
          )
        }
        return Err(
          "pion.lock would be modified in --offline mode (" + lock_path + ")",
        )
      }
    } else if !no_write_lock && new_text != old_text && !sem_same {
      if !drv_write_text_atomic(world, lock_path, new_text) {
        return Err("failed to write " + lock_path)
      }
    }
  }
  Ok(DrvWsLoad::{
    nodes: out,
    lock: final_lock,
    lock_path: lock_path,
    lock_existed: has_lock,
    lock_text: old_text,
    git_root: ctx.git_root,
    manifest_paths: manifest_paths,
    manifest_texts: manifest_texts,
    scanned_dirs: scanned_dirs,
    dir_snapshots: dir_snapshots,
  })
}

///|
fn drv_load_workspace_nodes_target(
  world : World,
  root_dir : String,
  active_target : String,
) -> Result[Array[PkgNodeInput], String] {
  match drv_load_workspace_opts_target(world, root_dir, false, false, "", active_target) {
    Err(e) => Err(e)
    Ok(ws) => Ok(ws.nodes)
  }
}

///|
fn drv_load_workspace_nodes(
  world : World,
  root_dir : String,
) -> Result[Array[PkgNodeInput], String] {
  drv_load_workspace_nodes_target(world, root_dir, "")
}

///|
/// Packages fetched into the git cache are external: `pionc test` skips them.
fn drv_is_external_pkg(git_root : String, dir : String) -> Bool {
  drv_starts_with(drv_normalize_path(dir) + "/", git_root + "/")
}

///|
struct DrvLinkOpts {
  libs : Array[String]
  frameworks : Array[String]
  search_paths : Array[String]
  rpaths : Array[String]
  objects : Array[String]
  flags : Array[String]
  mut has_cxx : Bool
}

///|
fn drv_link_opts_empty() -> DrvLinkOpts {
  DrvLinkOpts::{
    libs: [],
    frameworks: [],
    search_paths: [],
    rpaths: [],
    objects: [],
    flags: [],
    has_cxx: false,
  }
}

///|
fn drv_is_cxx_lib(lib : String) -> Bool {
  lib == "c++" || lib == "stdc++"
}

///|
fn drv_is_cxx_source(path : String) -> Bool {
  drv_ends_with(path, ".cc") ||
  drv_ends_with(path, ".cpp") ||
  drv_ends_with(path, ".mm")
}

///|
fn drv_link_opts_from_libs(libs : Array[String]) -> DrvLinkOpts {
  let opts = drv_link_opts_empty()
  let mut i = 0
  while i < libs.length() {
    let lib = libs[i]
    push_unique_lib(opts.libs, lib)
    if drv_is_cxx_lib(lib) {
      opts.has_cxx = true
    }
    i = i + 1
  }
  opts
}

///|
fn drv_resolve_pkg_path(pkg_dir : String, p : String) -> String {
  if p.length() > 0 && str_code_at(p, 0) == 47 {
    p
  } else {
    drv_resolve_rel_path(pkg_dir, p)
  }
}

///|
fn drv_resolve_rpath(pkg_dir : String, p : String) -> String {
  if p.length() > 0 {
    let c0 = str_code_at(p, 0)
    if c0 == 47 || c0 == 64 || c0 == 36 {
      return p
    }
  }
  drv_resolve_rel_path(pkg_dir, p)
}

///|
fn drv_resolve_cc_flag(pkg_dir : String, flag : String) -> String {
  if flag.length() > 2 && drv_starts_with(flag, "-I") {
    let inc = slice_str(flag, 2, flag.length())
    if str_code_at(inc, 0) != 47 {
      return "-I" + drv_resolve_rel_path(pkg_dir, inc)
    }
  }
  flag
}

///|
fn drv_collect_link_spec(
  pkg_dir : String,
  spec : LinkSpec,
  is_macos : Bool,
  opts : DrvLinkOpts,
) -> Unit {
  let mut i = 0
  while i < spec.libs.length() {
    let lib = spec.libs[i]
    push_unique_lib(opts.libs, lib)
    if drv_is_cxx_lib(lib) {
      opts.has_cxx = true
    }
    i = i + 1
  }
  if is_macos {
    i = 0
    while i < spec.frameworks.length() {
      push_unique_lib(opts.frameworks, spec.frameworks[i])
      i = i + 1
    }
  }
  i = 0
  while i < spec.search_paths.length() {
    push_unique_lib(
      opts.search_paths,
      drv_resolve_pkg_path(pkg_dir, spec.search_paths[i]),
    )
    i = i + 1
  }
  i = 0
  while i < spec.rpaths.length() {
    push_unique_lib(opts.rpaths, drv_resolve_rpath(pkg_dir, spec.rpaths[i]))
    i = i + 1
  }
  i = 0
  while i < spec.objects.length() {
    push_unique_lib(
      opts.objects,
      drv_resolve_pkg_path(pkg_dir, spec.objects[i]),
    )
    i = i + 1
  }
  i = 0
  while i < spec.flags.length() {
    if spec.flags[i].length() > 0 {
      opts.flags.push(spec.flags[i])
    }
    i = i + 1
  }
}

///|
fn drv_collect_node_link_opts(
  node : PkgNodeInput,
  qbe_target : String,
  opts : DrvLinkOpts,
) -> Unit {
  let is_apple = drv_target_is_apple(qbe_target)
  let os = drv_target_os(qbe_target)
  drv_collect_link_spec(node.dir, node.link_common, is_apple, opts)
  if os == "macos" {
    drv_collect_link_spec(node.dir, node.link_macos, is_apple, opts)
  } else if os == "ios" {
    drv_collect_link_spec(node.dir, node.link_ios, is_apple, opts)
  } else if os == "android" {
    drv_collect_link_spec(node.dir, node.link_android, is_apple, opts)
  } else if os == "windows" {
    drv_collect_link_spec(node.dir, node.link_windows, is_apple, opts)
  } else if os == "wasm" {
    drv_collect_link_spec(node.dir, node.link_wasm, is_apple, opts)
  } else {
    drv_collect_link_spec(node.dir, node.link_linux, is_apple, opts)
  }
}

///|
fn drv_cstub_cc_version_fp(
  world : World,
  compiler : String,
  ver_cache : Map[String, String],
) -> String {
  match ver_cache.get(compiler) {
    Some(fp) => return fp
    None => ()
  }
  let argv : Array[String] = if drv_is_cl_exe_driver(compiler) {
    [compiler]
  } else {
    [compiler, "--version"]
  }
  let fp = match proc_exec_capture(world, argv) {
    Ok(out) =>
      if drv_trim_ws(out).length() > 0 {
        "ver:" + sha256_hex(out)
      } else {
        let resolved = if fs_exists(world, compiler) {
          compiler
        } else {
          let found = drv_find_in_path(world, compiler)
          if found.length() > 0 { found } else { compiler }
        }
        "bin:" +
        resolved +
        ":" +
        fs_size(world, resolved).to_string() +
        ":" +
        fs_mtime_ms(world, resolved).to_string()
      }
    Err(_) => {
      let resolved = if fs_exists(world, compiler) {
        compiler
      } else {
        let found = drv_find_in_path(world, compiler)
        if found.length() > 0 { found } else { compiler }
      }
      "bin:" +
      resolved +
      ":" +
      fs_size(world, resolved).to_string() +
      ":" +
      fs_mtime_ms(world, resolved).to_string()
    }
  }
  ver_cache.set(compiler, fp)
  fp
}

///|
fn drv_cstub_is_drive_root(p : String) -> Bool {
  if p.length() != 2 && p.length() != 3 {
    return false
  }
  if str_code_at(p, 1) != 58 {
    return false
  }
  let c = str_code_at(p, 0)
  if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {
    return false
  }
  if p.length() == 2 {
    return true
  }
  let s = str_code_at(p, 2)
  s == 47 || s == 92
}

///|
fn drv_cstub_path_eq(a : String, b : String) -> Bool {
  if c_cli_is_windows() != 0 {
    drv_ascii_lower(a) == drv_ascii_lower(b)
  } else {
    a == b
  }
}

///|
fn drv_cstub_path_has_prefix(path : String, prefix : String) -> Bool {
  if c_cli_is_windows() != 0 {
    drv_starts_with(drv_ascii_lower(path), drv_ascii_lower(prefix))
  } else {
    drv_starts_with(path, prefix)
  }
}

///|
fn drv_cstub_rt_inc_dirs(
  world : World,
  rt_lib : String,
  cache_dir : String,
) -> Array[String] {
  let dirs : Array[String] = []
  let add_unique = fn(d : String) -> Unit {
    let mut i = 0
    while i < dirs.length() {
      if drv_cstub_path_eq(dirs[i], d) {
        return
      }
      i = i + 1
    }
    dirs.push(d)
  }
  let rt_dir_raw = drv_parent_dir(rt_lib)
  let rt_dir = if rt_dir_raw.length() > 0 { rt_dir_raw } else { "." }
  if fs_exists(world, drv_join_path(rt_dir, "pion_rt.h")) {
    add_unique(rt_dir)
  }
  let alt_rt_dir = drv_resolve_rel_path(rt_dir, "../runtime")
  if alt_rt_dir.length() > 0 &&
    fs_exists(world, drv_join_path(alt_rt_dir, "pion_rt.h")) {
    add_unique(alt_rt_dir)
  }
  if dirs.length() == 0 {
    let rt_c = drv_find_pion_rt_c(world)
    if rt_c.length() > 0 {
      let src_rt_dir = drv_parent_dir(rt_c)
      if src_rt_dir.length() > 0 &&
        fs_exists(world, drv_join_path(src_rt_dir, "pion_rt.h")) {
        add_unique(src_rt_dir)
      }
    }
  }
  if dirs.length() == 0 {
    let rt_lex = drv_cstub_abs_lexical_path(world, rt_dir)
    let obj_lex = drv_cstub_abs_lexical_path(world, cache_dir + "/obj")
    if !drv_cstub_path_eq(rt_lex, obj_lex) {
      add_unique(rt_dir)
    }
  }
  dirs
}

///|
fn drv_cstub_base_key(
  qbe_target : String,
  pkg_name : String,
  compiler : String,
  cc_ver_fp : String,
  eff_cc_flags_joined : String,
  rt_inc_dirs_joined : String,
  norm_src : String,
  src_hash : String,
) -> String {
  sha256_hex(
    "cstub-v3|" +
    qbe_target +
    "|" +
    pkg_name +
    "|" +
    compiler +
    "|" +
    cc_ver_fp +
    "|" +
    eff_cc_flags_joined +
    "|" +
    rt_inc_dirs_joined +
    "|" +
    norm_src +
    "|" +
    src_hash,
  )
}

///|
fn drv_cstub_final_key(base_key : String, hdrs_fp : String) -> String {
  sha256_hex("cstub-v3-obj|" + base_key + "|" + hdrs_fp)
}

///|
fn drv_cstub_hash_dep_headers(
  world : World,
  hdrs : Array[String],
  file_hash_memo : Map[String, String],
) -> Option[String] {
  let sb = StringBuilder()
  let mut i = 0
  while i < hdrs.length() {
    let p = hdrs[i]
    if p.length() == 0 || fs_is_dir(world, p) {
      return None
    }
    let h = match drv_sha256_file(p, file_hash_memo) {
      Some(v) => v
      None => return None
    }
    sb.write_string(p)
    sb.write_string(":")
    sb.write_string(h)
    sb.write_string("\n")
    i = i + 1
  }
  Some(sha256_hex(sb.to_string()))
}

///|
/// Hashes dependency headers bypassing `file_hash_memo` (for cold CAS publish
/// so stale memo entries from earlier `try_hit` or other `.c` files are never
/// paired with a newly compiled `.o`).
fn drv_cstub_hash_dep_headers_uncached(
  world : World,
  hdrs : Array[String],
) -> Option[String] {
  let sb = StringBuilder()
  let mut i = 0
  while i < hdrs.length() {
    let p = hdrs[i]
    if p.length() == 0 || fs_is_dir(world, p) {
      return None
    }
    let h = match drv_cas_sha256_file_uncached(p) {
      Some(v) => v
      None => return None
    }
    sb.write_string(p)
    sb.write_string(":")
    sb.write_string(h)
    sb.write_string("\n")
    i = i + 1
  }
  Some(sha256_hex(sb.to_string()))
}

///|
fn drv_cstub_collect_search_dirs(
  world : World,
  src_path : String,
  eff_cc_flags : Array[String],
  rt_inc_dirs : Array[String],
) -> Array[String] {
  // Collect include directories in true GCC/Clang compiler search order:
  // `[src_dir]` -> `-iquote` -> `-I`/`/I` -> `-isystem` -> `rt_inc_dirs`.
  let iquote_dirs : Array[String] = []
  let i_dirs : Array[String] = []
  let isystem_dirs : Array[String] = []
  let mut i = 0
  while i < eff_cc_flags.length() {
    let fl = eff_cc_flags[i]
    if fl == "-iquote" && i + 1 < eff_cc_flags.length() {
      iquote_dirs.push(eff_cc_flags[i + 1])
      i = i + 2
      continue
    }
    if (fl == "-I" || fl == "/I") && i + 1 < eff_cc_flags.length() {
      i_dirs.push(eff_cc_flags[i + 1])
      i = i + 2
      continue
    }
    if fl == "-isystem" && i + 1 < eff_cc_flags.length() {
      isystem_dirs.push(eff_cc_flags[i + 1])
      i = i + 2
      continue
    }
    if drv_starts_with(fl, "-iquote") && fl.length() > 7 {
      iquote_dirs.push(slice_str(fl, 7, fl.length()))
    } else if drv_starts_with(fl, "-I") && fl.length() > 2 {
      i_dirs.push(slice_str(fl, 2, fl.length()))
    } else if drv_starts_with(fl, "/I") && fl.length() > 2 {
      i_dirs.push(slice_str(fl, 2, fl.length()))
    } else if drv_starts_with(fl, "-isystem") && fl.length() > 8 {
      isystem_dirs.push(slice_str(fl, 8, fl.length()))
    }
    i = i + 1
  }
  let out : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  let add_dir = fn(d : String) -> Unit {
    if d.length() == 0 {
      return
    }
    let cd = drv_cstub_abs_lexical_path(world, d)
    if cd.length() > 0 && !seen.contains(cd) {
      seen.set(cd, true)
      out.push(cd)
    }
  }
  let src_dir = drv_parent_dir(src_path)
  add_dir(if src_dir.length() > 0 { src_dir } else { "." })
  i = 0
  while i < iquote_dirs.length() {
    add_dir(iquote_dirs[i])
    i = i + 1
  }
  i = 0
  while i < i_dirs.length() {
    add_dir(i_dirs[i])
    i = i + 1
  }
  i = 0
  while i < rt_inc_dirs.length() {
    add_dir(rt_inc_dirs[i])
    i = i + 1
  }
  i = 0
  while i < isystem_dirs.length() {
    add_dir(isystem_dirs[i])
    i = i + 1
  }
  out
}

///|
fn drv_path_basename(p : String) -> String {
  let n = p.length()
  let mut i = n - 1
  while i >= 0 {
    let c = str_code_at(p, i)
    if c == 47 || c == 92 {
      return slice_str(p, i + 1, n)
    }
    i = i - 1
  }
  p
}

///|
/// Finds the last `/include/` segment in `p` (ASCII case-insensitive, matching
/// Windows Kits `Include/` as well as POSIX `/include/`) and returns the start
/// index of the relative path after it, or `-1` if none exists.
fn drv_cstub_after_include_seg(p : String) -> Int {
  let lp = drv_ascii_lower(p)
  let needle = "/include/"
  let nlen = needle.length()
  let n = lp.length()
  let mut last = -1
  let mut i = 0
  while i + nlen <= n {
    if slice_str(lp, i, i + nlen) == needle {
      last = i + nlen
    }
    i = i + 1
  }
  last
}

///|
fn drv_cstub_is_system_header(h : String) -> Bool {
  if drv_starts_with(h, "/usr/") ||
    drv_starts_with(h, "/Library/") ||
    drv_starts_with(h, "/System/") ||
    drv_starts_with(h, "/Applications/") {
    return true
  }
  let lh = drv_ascii_lower(h)
  if drv_starts_with(lh, "/ucrt64/") ||
    drv_starts_with(lh, "/mingw64/") ||
    drv_starts_with(lh, "/clang64/") {
    return true
  }
  if drv_is_drive_abs(lh) && lh.length() >= 3 {
    let rest = slice_str(lh, 2, lh.length())
    if drv_starts_with(rest, "/program files/") ||
      drv_starts_with(rest, "/program files (x86)/") ||
      drv_starts_with(rest, "/windows/") ||
      drv_starts_with(rest, "/msys64/") {
      return true
    }
  }
  false
}

///|
/// Generates all sorted, deduplicated candidate shadow header paths across
/// higher-priority `search_dirs` and project header parent directories
/// (`proj_hdr_dirs`, covering transitive `#include "..."` siblings including
/// quoted includes of system headers). During cold publish, ONLY candidates
/// that do NOT exist at compile time (`!fs_exists`) are stored in the `.deps`
/// `absent:` negative cache — giving 0 false positives on pre-existing dual
/// headers (`#include_next`, MinGW, vendored configs) and 0 false negatives on
/// newly introduced shadowing headers.
fn drv_cstub_shadow_candidates(
  hdrs : Array[String],
  search_dirs : Array[String],
) -> Array[String] {
  let proj_hdr_dirs : Array[String] = []
  let seen_hdir : Map[String, Bool] = Map([])
  let mut hi = 0
  while hi < hdrs.length() {
    let h = hdrs[hi]
    let mut in_search = false
    let mut di = 0
    while di < search_dirs.length() {
      if drv_cstub_path_has_prefix(h, search_dirs[di] + "/") {
        in_search = true
        break
      }
      di = di + 1
    }
    if in_search || !drv_cstub_is_system_header(h) {
      let pd = drv_parent_dir(h)
      if pd.length() > 0 && !seen_hdir.contains(pd) {
        seen_hdir.set(pd, true)
        proj_hdr_dirs.push(pd)
      }
    }
    hi = hi + 1
  }
  let out : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  let add_cand = fn(c : String) -> Unit {
    if c.length() > 0 && !seen.contains(c) {
      seen.set(c, true)
      out.push(c)
    }
  }
  hi = 0
  while hi < hdrs.length() {
    let h = hdrs[hi]
    let mut matched_any = false
    let mut di = 0
    while di < search_dirs.length() {
      let pref = search_dirs[di] + "/"
      if drv_cstub_path_has_prefix(h, pref) {
        matched_any = true
        let rel = slice_str(h, search_dirs[di].length() + 1, h.length())
        if rel.length() > 0 {
          let mut j = 0
          while j < di {
            add_cand(search_dirs[j] + "/" + rel)
            j = j + 1
          }
          let mut hdi = 0
          while hdi < proj_hdr_dirs.length() {
            add_cand(proj_hdr_dirs[hdi] + "/" + rel)
            hdi = hdi + 1
          }
        }
      }
      di = di + 1
    }
    if !matched_any {
      let inc_off = drv_cstub_after_include_seg(h)
      let rel = if inc_off >= 0 {
        slice_str(h, inc_off, h.length())
      } else {
        drv_path_basename(h)
      }
      if rel.length() > 0 {
        let mut j = 0
        while j < search_dirs.length() {
          add_cand(search_dirs[j] + "/" + rel)
          j = j + 1
        }
        let mut hdi = 0
        while hdi < proj_hdr_dirs.length() {
          add_cand(proj_hdr_dirs[hdi] + "/" + rel)
          hdi = hdi + 1
        }
      }
    }
    hi = hi + 1
  }
  drv_sort_strings(out)
  out
}

///|
fn drv_cstub_ts_is_racy(mt : Int64, start_ms : Int64) -> Bool {
  mt < 0L ||
  mt >= start_ms ||
  (mt % 1000L == 0L && mt >= start_ms - 2000L)
}

fn drv_strip_trailing_slash(p : String) -> String {
  let mut n = p.length()
  while n > 1 && str_code_at(p, n - 1) == 47 {
    if n == 3 && str_code_at(p, 1) == 58 {
      break
    }
    n = n - 1
  }
  if n == p.length() { p } else { slice_str(p, 0, n) }
}

///|
/// Shared OS / per-user temp root directories whose mtime changes whenever
/// unrelated concurrent processes create sibling temp dirs (`mktemp -d`),
/// including macOS `$TMPDIR` (`/private/var/folders/.../T`) and `%TEMP%`.
/// Still checked if a component itself is a symlink (`kind == 3`).
fn drv_cstub_is_shared_os_root(world : World, raw_p : String) -> Bool {
  let p = drv_strip_trailing_slash(raw_p)
  if p.length() == 0 ||
    p == "/" ||
    p == "/tmp" ||
    p == "/var" ||
    p == "/var/tmp" ||
    p == "/private" ||
    p == "/private/tmp" ||
    p == "/Users" ||
    p == "/home" ||
    p == "/root" {
    return true
  }
  if (p.length() == 2 && str_code_at(p, 1) == 58) ||
    (p.length() == 3 && str_code_at(p, 1) == 58 && str_code_at(p, 2) == 47) {
    return true
  }
  if (drv_starts_with(p, "/var/folders/") ||
    drv_starts_with(p, "/private/var/folders/")) &&
    drv_ends_with(p, "/T") {
    return true
  }
  let env_names : Array[String] = ["TMPDIR", "TEMP", "TMP"]
  let mut ei = 0
  while ei < env_names.length() {
    let ev = drv_env_str(world, env_names[ei])
    if ev.length() > 0 {
      let lex = drv_strip_trailing_slash(drv_cstub_abs_lexical_path(world, ev))
      if p == lex {
        return true
      }
      let can = drv_strip_trailing_slash(drv_cstub_canon_path(world, ev))
      if p == can {
        return true
      }
    }
    ei = ei + 1
  }
  false
}

///|
/// Walks `path` and all of its ancestor prefixes (deduplicated via
/// `checked_paths`), checking `pion_cli_lpath_change_ms` at every prefix and,
/// whenever any component (leaf or intermediate directory) is a symlink,
/// expanding it hop-by-hop via `pion_fs_readlink` (up to 40 hops; fail-closed
/// on readlink failure or > 40 hops) so every intermediate hop in a multi-hop
/// symlink chain (`a -> b -> c`) and all of its ancestors are checked.
fn drv_cstub_racy_ancestors(
  world : World,
  path : String,
  start_ms : Int64,
  checked_paths : Map[String, Bool],
  depth : Int,
) -> Bool {
  if depth > 40 {
    return true
  }
  if path.length() == 0 {
    return false
  }
  let mut cur = path
  while cur.length() > 0 && cur != "/" {
    if drv_cstub_is_drive_root(cur) {
      break
    }
    if checked_paths.contains(cur) {
      break
    }
    checked_paths.set(cur, true)
    let kind = drv_lstat_kind(cur)
    if kind == 3 {
      let lp = cur
      let lmt = c_cli_lpath_change_ms(drv_cpath(lp))
      if drv_cstub_ts_is_racy(lmt, start_ms) {
        return true
      }
      match drv_fs_readlink(cur) {
        None => return true
        Some(raw_target) => {
          let hop = if str_code_at(raw_target, 0) == 47 || drv_is_drive_abs(raw_target) {
            drv_cstub_abs_lexical_path(world, raw_target)
          } else {
            let pdir = drv_parent_dir(cur)
            let joined = if pdir.length() > 0 {
              drv_join_path(pdir, raw_target)
            } else if str_code_at(cur, 0) == 47 {
              "/" + raw_target
            } else {
              drv_join_path(".", raw_target)
            }
            drv_cstub_abs_lexical_path(world, joined)
          }
          if drv_cstub_racy_ancestors(world, hop, start_ms, checked_paths, depth + 1) {
            return true
          }
        }
      }
    } else if !drv_cstub_is_shared_os_root(world, cur) {
      let lp = cur
      let lmt = c_cli_lpath_change_ms(drv_cpath(lp))
      if drv_cstub_ts_is_racy(lmt, start_ms) {
        return true
      }
    }
    let next = drv_parent_dir(cur)
    if next.length() == 0 || next == cur {
      break
    }
    cur = next
  }
  false
}

///|
fn drv_cstub_racy_file(
  world : World,
  path : String,
  start_ms : Int64,
  checked_paths : Map[String, Bool],
) -> Bool {
  drv_cstub_racy_ancestors(world, path, start_ms, checked_paths, 0)
}

///|
fn drv_cstub_parse_nonneg_int(s : String) -> Int {
  let n = s.length()
  if n == 0 || n > 9 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

///|
/// Reads a `v3` `.deps` manifest (`v3\n<n>\n<hdrs...>\nabsent:<m>\n<absent...>\nsha256:<hex>\n`),
/// strictly validating format version, both section counts, trailing newline,
/// and whole-body SHA-256 integrity digest. Rejects any `v1`/`v2`/truncated/tampered file.
fn drv_cstub_read_dep_manifest(
  world : World,
  dep_manifest_path : String,
) -> Option[(Array[String], Array[String])] {
  match drv_lstat_regular_size(world, dep_manifest_path) {
    Some(_) => ()
    None => return None
  }
  let txt = match fs_read(world, dep_manifest_path) {
    Ok(t) => t
    Err(_) => return None
  }
  if txt.length() == 0 || str_code_at(txt, txt.length() - 1) != 10 {
    return None
  }
  let lines = drv_split_lines(txt)
  if lines.length() < 4 || lines[0] != "v3" {
    return None
  }
  let hcount = drv_cstub_parse_nonneg_int(lines[1])
  if hcount < 0 || lines.length() < hcount + 4 {
    return None
  }
  let abs_hdr = lines[hcount + 2]
  if !drv_starts_with(abs_hdr, "absent:") {
    return None
  }
  let acount = drv_cstub_parse_nonneg_int(slice_str(abs_hdr, 7, abs_hdr.length()))
  if acount < 0 || lines.length() != hcount + acount + 4 {
    return None
  }
  let body_sb = StringBuilder()
  body_sb.write_string("v3\n")
  body_sb.write_string(lines[1])
  body_sb.write_string("\n")
  let hdrs : Array[String] = []
  let mut i = 0
  while i < hcount {
    let l = lines[i + 2]
    if l.length() == 0 {
      return None
    }
    hdrs.push(l)
    body_sb.write_string(l)
    body_sb.write_string("\n")
    i = i + 1
  }
  body_sb.write_string(abs_hdr)
  body_sb.write_string("\n")
  let absent : Array[String] = []
  i = 0
  while i < acount {
    let l = lines[hcount + 3 + i]
    if l.length() == 0 {
      return None
    }
    absent.push(l)
    body_sb.write_string(l)
    body_sb.write_string("\n")
    i = i + 1
  }
  let expected_tail = "sha256:" + sha256_hex(body_sb.to_string())
  if lines[hcount + acount + 3] != expected_tail {
    return None
  }
  Some((hdrs, absent))
}

///|
fn drv_cstub_format_dep_manifest(
  hdrs : Array[String],
  absent : Array[String],
) -> String {
  let sb = StringBuilder()
  sb.write_string("v3\n")
  sb.write_string(hdrs.length().to_string())
  sb.write_string("\n")
  let mut i = 0
  while i < hdrs.length() {
    sb.write_string(hdrs[i])
    sb.write_string("\n")
    i = i + 1
  }
  sb.write_string("absent:")
  sb.write_string(absent.length().to_string())
  sb.write_string("\n")
  i = 0
  while i < absent.length() {
    sb.write_string(absent[i])
    sb.write_string("\n")
    i = i + 1
  }
  let body = sb.to_string()
  body + "sha256:" + sha256_hex(body) + "\n"
}

///|
fn drv_cstub_try_hit(
  world : World,
  cache_dir : String,
  src_path : String,
  base_key : String,
  trace_cas : Bool,
  file_hash_memo : Map[String, String],
) -> Option[String] {
  let dep_manifest_path = cache_dir + "/obj/cstub_dep_" + base_key + ".deps"
  let (hdrs, absent) = match drv_cstub_read_dep_manifest(world, dep_manifest_path) {
    Some(v) => v
    None => return None
  }
  let mut ai = 0
  while ai < absent.length() {
    let cand = absent[ai]
    if fs_exists(world, cand) && !fs_is_dir(world, cand) {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] cstub=" + src_path + " SHADOW by=" + cand,
        )
      }
      return None
    }
    ai = ai + 1
  }
  let hdrs_fp = match drv_cstub_hash_dep_headers(world, hdrs, file_hash_memo) {
    Some(v) => v
    None => return None
  }
  let final_key = drv_cstub_final_key(base_key, hdrs_fp)
  let obj_path = cache_dir + "/obj/cstub_" + final_key + ".o"
  match drv_lstat_regular_size(world, obj_path) {
    Some(_) => Some(final_key)
    None => None
  }
}

///|
fn drv_cstub_append_dep_args(
  argv : Array[String],
  compiler : String,
  dep_tmp : String,
  obj_tmp : String,
) -> Unit {
  if drv_is_cl_exe_driver(compiler) {
    argv.push("/sourceDependencies")
    argv.push(dep_tmp)
  } else if drv_is_clang_cl_driver(compiler) {
    argv.push("/clang:-MD")
    argv.push("/clang:-MF")
    argv.push("/clang:" + dep_tmp)
  } else {
    argv.push("-MD")
    argv.push("-MF")
    argv.push(dep_tmp)
  }
  argv.push("-o")
  argv.push(obj_tmp)
}

///|
fn drv_cstub_parse_and_hash_deps(
  world : World,
  src_path : String,
  norm_src : String,
  obj_tmp : String,
  is_cl_exe : Bool,
  dep_tmp : String,
  pre_hash_ms : Int64,
  search_dirs : Array[String],
) -> Result[(Array[String], Array[String], String), String] {
  match drv_lstat_regular_size(world, dep_tmp) {
    Some(_) => ()
    None => return Err("depfile_missing")
  }
  let txt = match fs_read(world, dep_tmp) {
    Ok(t) => t
    Err(_) => return Err("depfile_missing")
  }
  let mut saw_src = false
  let raw_deps : Array[String] = if is_cl_exe {
    match cas_parse_msvc_source_deps(txt) {
      Some((msvc_src, incs)) => {
        if !drv_cstub_path_eq(drv_cstub_canon_path(world, msvc_src), norm_src) {
          return Err("src_missing")
        }
        saw_src = true
        incs
      }
      None => return Err("depfile_parse")
    }
  } else {
    match cas_parse_depfile(txt) {
      Some((targets, deps)) => {
        let obj_lex = drv_cstub_abs_lexical_path(world, obj_tmp)
        let obj_canon = drv_cstub_canon_path(world, obj_tmp)
        let mut target_ok = false
        let mut ti = 0
        while ti < targets.length() {
          let t = targets[ti]
          if drv_cstub_path_eq(t, obj_tmp) ||
            drv_cstub_path_eq(drv_cstub_abs_lexical_path(world, t), obj_lex) ||
            drv_cstub_path_eq(drv_cstub_canon_path(world, t), obj_canon) {
            target_ok = true
            break
          }
          ti = ti + 1
        }
        if !target_ok {
          return Err("target_mismatch")
        }
        deps
      }
      None => return Err("depfile_parse")
    }
  }
  let hdrs : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  let mut i = 0
  while i < raw_deps.length() {
    let cp = drv_cstub_canon_path(world, raw_deps[i])
    if drv_cstub_path_eq(cp, norm_src) {
      saw_src = true
    } else {
      let lp = drv_cstub_abs_lexical_path(world, raw_deps[i])
      if lp.length() > 0 && !seen.contains(lp) {
        seen.set(lp, true)
        hdrs.push(lp)
      }
    }
    i = i + 1
  }
  if !saw_src {
    return Err("src_missing")
  }
  // 1. Hash all headers uncached FIRST.
  drv_sort_strings(hdrs)
  let hdrs_fp = match drv_cstub_hash_dep_headers_uncached(world, hdrs) {
    Some(v) => v
    None => return Err("hdr_hash")
  }
  // 2. Sample negative-cache shadow candidates (partition into absent vs existing).
  let cands = drv_cstub_shadow_candidates(hdrs, search_dirs)
  let absent : Array[String] = []
  let existing_cands : Array[String] = []
  let mut ci = 0
  while ci < cands.length() {
    let cand = cands[ci]
    if !fs_exists(world, cand) {
      absent.push(cand)
    } else {
      existing_cands.push(cand)
    }
    ci = ci + 1
  }
  // 3. Run unified post-hash, post-sample racy check across src, hdrs,
  //    search_dirs, and existing shadow candidates (deduped via checked_paths).
  let checked_paths : Map[String, Bool] = Map([])
  if drv_cstub_racy_file(world, src_path, pre_hash_ms, checked_paths) {
    return Err("racy_src")
  }
  i = 0
  while i < hdrs.length() {
    if drv_cstub_racy_file(world, hdrs[i], pre_hash_ms, checked_paths) {
      return Err("racy_hdr")
    }
    i = i + 1
  }
  i = 0
  while i < search_dirs.length() {
    let sd = search_dirs[i]
    if drv_lstat_kind(sd) != 0 {
      if drv_cstub_racy_file(world, sd, pre_hash_ms, checked_paths) {
        return Err("racy_search_dir")
      }
    } else {
      let pd = drv_parent_dir(sd)
      if pd.length() > 0 && drv_cstub_racy_file(world, pd, pre_hash_ms, checked_paths) {
        return Err("racy_search_dir")
      }
    }
    i = i + 1
  }
  i = 0
  while i < existing_cands.length() {
    if drv_cstub_racy_file(world, existing_cands[i], pre_hash_ms, checked_paths) {
      return Err("racy_shadow_cand")
    }
    i = i + 1
  }
  Ok((hdrs, absent, hdrs_fp))
}

///|
/// Publishes a freshly compiled `c_source` object to CAS under `index.tsv.lock`
/// after pinning (or keeps the local staged `obj_tmp` and defers `stage_dir`
/// cleanup to `pin.temp_dirs` when `post_src_hash != src_hash` or pinning fails).
/// Returns `Ok((final_key, obj_path, kept_local_stage))`.
fn drv_cstub_publish_one(
  world : World,
  cache_dir : String,
  stage_dir : String,
  src_path : String,
  norm_src : String,
  src_hash : String,
  base_key : String,
  is_cl_exe : Bool,
  obj_tmp : String,
  dep_tmp : String,
  pre_hash_ms : Int64,
  search_dirs : Array[String],
  trace_cas : Bool,
  out_new_keys : Array[String],
  out_new_sizes : Array[Int64],
  pin : DrvCasPinSession,
) -> Result[(String, String, Bool), String] {
  match drv_lstat_regular_size(world, obj_tmp) {
    Some(_) => ()
    None => return Err("empty or invalid c_source object " + obj_tmp)
  }
  // Re-hash `src_path` uncached after compile: if it changed since `src_hash`
  // or we cannot pin CAS entries, skip CAS publishing completely and link
  // directly from `obj_tmp` (deferring `stage_dir` cleanup to `pin_close`).
  let post_src_ok = match drv_cas_sha256_file_uncached(src_path) {
    Some(h) => h == src_hash
    None => false
  }
  if !post_src_ok || pin.lock_handle < 0L {
    let obj_hash = match drv_cas_sha256_file_uncached(obj_tmp) {
      Some(h) => h
      None => drv_tmp_tag(world, obj_tmp)
    }
    let local_key = drv_cstub_final_key(base_key, "local:" + obj_hash)
    if trace_cas {
      io_eprintln(
        world,
        "[cas] cstub=" + src_path + " MISS key=" + drv_prefix16(local_key),
      )
    }
    return Ok((local_key, obj_tmp, true))
  }
  let (hdrs, absent, hdrs_fp) = match
    drv_cstub_parse_and_hash_deps(
      world,
      src_path,
      norm_src,
      obj_tmp,
      is_cl_exe,
      dep_tmp,
      pre_hash_ms,
      search_dirs,
    )
  {
    Ok(v) => v
    Err(reason) => {
      let obj_hash = match drv_cas_sha256_file_uncached(obj_tmp) {
        Some(h) => h
        None => drv_tmp_tag(world, obj_tmp)
      }
      let local_key = drv_cstub_final_key(base_key, "local:" + obj_hash)
      if trace_cas {
        io_eprintln(
          world,
          "[cas] cstub=" +
          src_path +
          " MISS key=" +
          drv_prefix16(local_key) +
          " (local: " +
          reason +
          ")",
        )
      }
      return Ok((local_key, obj_tmp, true))
    }
  }
  let final_key = drv_cstub_final_key(base_key, hdrs_fp)
  if trace_cas {
    io_eprintln(
      world,
      "[cas] cstub=" + src_path + " MISS key=" + drv_prefix16(final_key),
    )
  }
  let obj_cas_key = "cstub_" + final_key
  let dep_cas_key = "cstub_dep_" + base_key
  let dst_p = cache_dir + "/obj/cstub_" + final_key + ".o"
  if drv_lstat_kind(dst_p) == 2 {
    return Err("failed to publish c_source object " + dst_p)
  }
  let pin_keys : Array[String] = [obj_cas_key, dep_cas_key]
  if !drv_cas_publish_file_pinned(world, cache_dir, pin, pin_keys, obj_tmp, dst_p) {
    return Ok((final_key, obj_tmp, true))
  }
  let pub_sz : Int64 = match drv_lstat_regular_size(world, dst_p) {
    Some(sz) => sz
    None => return Err("empty or invalid c_source object " + dst_p)
  }
  out_new_keys.push(obj_cas_key)
  out_new_sizes.push(pub_sz)
  let dep_manifest_path = cache_dir + "/obj/" + dep_cas_key + ".deps"
  let manifest_tmp = stage_dir + "/manifest_" + base_key + ".deps"
  match fs_write(world, manifest_tmp, drv_cstub_format_dep_manifest(hdrs, absent)) {
    Ok(_) =>
      if drv_cas_publish_file_pinned(
        world,
        cache_dir,
        pin,
        [dep_cas_key],
        manifest_tmp,
        dep_manifest_path,
      ) {
        match drv_lstat_regular_size(world, dep_manifest_path) {
          Some(dsz) => {
            out_new_keys.push(dep_cas_key)
            out_new_sizes.push(dsz)
          }
          None => ()
        }
      } else {
        let _ = fs_remove(world, manifest_tmp)
      }
    Err(_) => {
      let _ = fs_remove(world, manifest_tmp)
    }
  }
  Ok((final_key, dst_p, false))
}

///|
fn drv_c_source_section_flags(
  compiler : String,
  qbe_target : String,
  user_flags : Array[String],
) -> Array[String] {
  let out : Array[String] = []
  let is_clang_cl = drv_is_clang_cl_driver(compiler)
  if is_clang_cl {
    let mut has_gy = false
    let mut has_gw = false
    let mut has_bigobj = false
    let mut i = 0
    while i < user_flags.length() {
      let fl = user_flags[i]
      if fl == "/Gy" || fl == "/Gy-" || fl == "-Gy" || fl == "-Gy-" {
        has_gy = true
      } else if fl == "/Gw" || fl == "/Gw-" || fl == "-Gw" || fl == "-Gw-" {
        has_gw = true
      } else if fl == "/bigobj" || fl == "-bigobj" {
        has_bigobj = true
      }
      i = i + 1
    }
    if !has_gy {
      out.push("/Gy")
    }
    if !has_gw {
      out.push("/Gw")
    }
    if qbe_target == "amd64_win" && !has_bigobj {
      out.push("/bigobj")
    }
  } else {
    let mut has_fn = false
    let mut has_data = false
    let mut has_bigobj = false
    let mut i = 0
    while i < user_flags.length() {
      let fl = user_flags[i]
      if fl == "-ffunction-sections" || fl == "-fno-function-sections" {
        has_fn = true
      } else if fl == "-fdata-sections" || fl == "-fno-data-sections" {
        has_data = true
      } else if fl == "-Wa,-mbig-obj" {
        has_bigobj = true
      }
      i = i + 1
    }
    if !has_fn {
      out.push("-ffunction-sections")
    }
    if !has_data {
      out.push("-fdata-sections")
    }
    if qbe_target == "amd64_win" && !has_bigobj {
      out.push("-Wa,-mbig-obj")
    }
  }
  out
}

///|
/// Compiles a package's active `c_sources` (`[link]` + platform section) into
/// `$PION_CACHE_DIR/obj/cstub_<key>.o` (ccache Direct Mode with real compiler
/// header dependencies + compiler version fingerprint, atomic temp + rename,
/// LRU-tracked).
/// Returns `Ok(true)` if any compiled source is C++/ObjC++ (`.cc`/`.cpp`/`.mm`).
fn drv_compile_pkg_c_sources(
  world : World,
  node : PkgNodeInput,
  qbe_target : String,
  sysroot : String,
  need_pic : Bool,
  release : Bool,
  rt_lib : String,
  cache_dir : String,
  trace_cas : Bool,
  ver_cache : Map[String, String],
  file_hash_memo : Map[String, String],
  out_objs : Array[String],
  out_keys : Array[String],
  out_new_keys : Array[String],
  out_new_sizes : Array[Int64],
  pin : DrvCasPinSession,
) -> Result[Bool, String] {
  let os = drv_target_os(qbe_target)
  let plat = if os == "macos" {
    node.link_macos
  } else if os == "ios" {
    node.link_ios
  } else if os == "android" {
    node.link_android
  } else if os == "windows" {
    node.link_windows
  } else if os == "wasm" {
    node.link_wasm
  } else {
    node.link_linux
  }
  let c_sources : Array[String] = []
  let mut i = 0
  while i < node.link_common.c_sources.length() {
    push_unique_lib(
      c_sources,
      drv_resolve_pkg_path(node.dir, node.link_common.c_sources[i]),
    )
    i = i + 1
  }
  i = 0
  while i < plat.c_sources.length() {
    push_unique_lib(c_sources, drv_resolve_pkg_path(node.dir, plat.c_sources[i]))
    i = i + 1
  }
  if c_sources.length() == 0 {
    return Ok(false)
  }
  let user_cc_flags : Array[String] = []
  let mut user_has_opt = false
  i = 0
  while i < node.link_common.cc_flags.length() {
    let fl = drv_resolve_cc_flag(node.dir, node.link_common.cc_flags[i])
    if fl == "-O" || drv_starts_with(fl, "-O") || drv_starts_with(fl, "/O") {
      user_has_opt = true
    }
    user_cc_flags.push(fl)
    i = i + 1
  }
  i = 0
  while i < plat.cc_flags.length() {
    let fl = drv_resolve_cc_flag(node.dir, plat.cc_flags[i])
    if fl == "-O" || drv_starts_with(fl, "-O") || drv_starts_with(fl, "/O") {
      user_has_opt = true
    }
    user_cc_flags.push(fl)
    i = i + 1
  }
  let cc_flags : Array[String] = drv_target_cc_flags(world, qbe_target, sysroot)
  if need_pic && !drv_target_is_windows(qbe_target) {
    cc_flags.push("-fPIC")
  }
  if release && !user_has_opt {
    cc_flags.push("-O3")
  }
  i = 0
  while i < user_cc_flags.length() {
    cc_flags.push(user_cc_flags[i])
    i = i + 1
  }
  let rt_inc_dirs = drv_cstub_rt_inc_dirs(world, rt_lib, cache_dir)
  let rt_inc_dirs_joined = drv_join_char(rt_inc_dirs, "\n")
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let cxx_bin = drv_resolve_cc_driver(world, qbe_target, true)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let mut stage_dir = ""
  let mut keep_stage = false
  let mut any_cxx = false
  let mut si = 0
  while si < c_sources.length() {
    let src_path = c_sources[si]
    if !fs_exists(world, src_path) {
      if stage_dir.length() > 0 && !keep_stage {
        let _ = drv_clean_cstub_stage_dir(world, stage_dir)
      }
      return Err("c_source does not exist: " + src_path)
    }
    let is_cxx = drv_is_cxx_source(src_path)
    if is_cxx {
      any_cxx = true
    }
    let compiler = if is_cxx { cxx_bin } else { cc_bin }
    let cc_ver_fp = drv_cstub_cc_version_fp(world, compiler, ver_cache)
    let eff_cc_flags : Array[String] = []
    let mut efi = 0
    while efi < cc_flags.length() {
      eff_cc_flags.push(cc_flags[efi])
      efi = efi + 1
    }
    let sec_flags = drv_c_source_section_flags(compiler, qbe_target, user_cc_flags)
    efi = 0
    while efi < sec_flags.length() {
      eff_cc_flags.push(sec_flags[efi])
      efi = efi + 1
    }
    let eff_cc_flags_joined = drv_join_char(eff_cc_flags, "\n")
    let pre_hash_ms = clock_now_ms(world)
    let src_hash = match drv_sha256_file(src_path, file_hash_memo) {
      Some(h) => h
      None => {
        if stage_dir.length() > 0 && !keep_stage {
          let _ = drv_clean_cstub_stage_dir(world, stage_dir)
        }
        return Err("failed to read c_source " + src_path)
      }
    }
    let norm_src = drv_cstub_canon_path(world, src_path)
    let search_dirs = drv_cstub_collect_search_dirs(
      world,
      src_path,
      eff_cc_flags,
      rt_inc_dirs,
    )
    let base_key = drv_cstub_base_key(
      qbe_target,
      node.name,
      compiler,
      cc_ver_fp,
      eff_cc_flags_joined,
      rt_inc_dirs_joined,
      norm_src,
      src_hash,
    )
    let mut hit_final_key = ""
    match drv_cstub_try_hit(world, cache_dir, src_path, base_key, trace_cas, file_hash_memo) {
      Some(fk) => {
        let obj_path = cache_dir + "/obj/cstub_" + fk + ".o"
        if drv_cas_pin_and_verify(
          world,
          cache_dir,
          pin,
          ["cstub_" + fk, "cstub_dep_" + base_key],
          [obj_path],
        ) {
          hit_final_key = fk
        }
      }
      None => ()
    }
    if hit_final_key.length() > 0 {
      let obj_path = cache_dir + "/obj/cstub_" + hit_final_key + ".o"
      if trace_cas {
        io_eprintln(
          world,
          "[cas] cstub=" + src_path + " HIT key=" + drv_prefix16(hit_final_key),
        )
      }
      out_objs.push(obj_path)
      out_keys.push(hit_final_key)
    } else {
      if stage_dir.length() == 0 {
        stage_dir = match
          drv_mktemp_dir_near(world, cache_dir + "/obj/cstub_stage")
        {
          Ok(d) => d
          Err(e) => return Err(e)
        }
      }
      let obj_tmp = stage_dir + "/obj_" + si.to_string() + ".o"
      let dep_tmp = stage_dir + "/dep_" + si.to_string() + ".d"
      let argv : Array[String] = [compiler]
      let mut fi = 0
      while fi < eff_cc_flags.length() {
        argv.push(eff_cc_flags[fi])
        fi = fi + 1
      }
      let mut ri = 0
      while ri < rt_inc_dirs.length() {
        argv.push("-I" + rt_inc_dirs[ri])
        ri = ri + 1
      }
      argv.push("-c")
      argv.push(src_path)
      drv_cstub_append_dep_args(argv, compiler, dep_tmp, obj_tmp)
      let is_cl_exe = drv_is_cl_exe_driver(compiler)
      let rc = proc_exec(world, argv)
      if rc != 0 {
        if !keep_stage {
          let _ = drv_clean_cstub_stage_dir(world, stage_dir)
        }
        return Err(
          "failed to compile c_source " +
          src_path +
          " with " +
          compiler +
          " (exit code " +
          rc.to_string() +
          ")",
        )
      }
      match
        drv_cstub_publish_one(
          world,
          cache_dir,
          stage_dir,
          src_path,
          norm_src,
          src_hash,
          base_key,
          is_cl_exe,
          obj_tmp,
          dep_tmp,
          pre_hash_ms,
          search_dirs,
          trace_cas,
          out_new_keys,
          out_new_sizes,
          pin,
        )
      {
        Err(e) => {
          if !keep_stage {
            let _ = drv_clean_cstub_stage_dir(world, stage_dir)
          }
          return Err(e)
        }
        Ok((final_key, obj_path, kept_local)) => {
          if kept_local && !keep_stage {
            keep_stage = true
            pin.temp_dirs.push(stage_dir)
          }
          out_objs.push(obj_path)
          out_keys.push(final_key)
        }
      }
    }
    si = si + 1
  }
  if stage_dir.length() > 0 && !keep_stage {
    match drv_clean_cstub_stage_dir(world, stage_dir) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  Ok(any_cxx)
}

///|
fn drv_find_in_path(world : World, bin_name : String) -> String {
  let path_env = drv_env_str(world, "PATH")
  if path_env.length() == 0 {
    return ""
  }
  let sep = if drv_env_str(world, "OS") == "Windows_NT" ||
    drv_find_substr(path_env, ";", 0) >= 0 {
    59
  } else {
    58
  }
  let dirs = drv_split_char(path_env, sep)
  let mut i = 0
  while i < dirs.length() {
    let d = dirs[i]
    if d.length() > 0 {
      let cand = drv_join_path(d, bin_name)
      if fs_exists(world, cand) {
        return cand
      }
    }
    i = i + 1
  }
  ""
}

///|
fn drv_resolve_win_rc_bin(
  world : World,
  cc_bin : String,
  is_msvc : Bool,
) -> String {
  let cc_dir = drv_parent_dir(cc_bin)
  if is_msvc {
    if cc_dir.length() > 0 {
      let c1 = drv_join_path(cc_dir, "llvm-rc.exe")
      if fs_exists(world, c1) {
        return c1
      }
      let c2 = drv_join_path(cc_dir, "llvm-rc")
      if fs_exists(world, c2) {
        return c2
      }
    }
    let p1 = drv_find_in_path(world, "llvm-rc.exe")
    if p1.length() > 0 {
      return p1
    }
    let p2 = drv_find_in_path(world, "llvm-rc")
    if p2.length() > 0 {
      return p2
    }
    let p3 = drv_find_in_path(world, "rc.exe")
    if p3.length() > 0 {
      return p3
    }
    "llvm-rc"
  } else {
    if cc_dir.length() > 0 {
      let w1 = drv_join_path(cc_dir, "windres.exe")
      if fs_exists(world, w1) {
        return w1
      }
      let w2 = drv_join_path(cc_dir, "windres")
      if fs_exists(world, w2) {
        return w2
      }
    }
    "windres"
  }
}

///|
/// Pure-content SHA-256 fingerprint for an external file (e.g. prebuilt `.a`/`.o`
/// in `[link] objects`) via native streaming `pion_cli_sha256_file`, memoized
/// in-process for this invocation (zero `mtime`, zero disk `stat_hash/`).
fn drv_cas_file_content_fp(
  world : World,
  path : String,
  file_hash_memo : Map[String, String],
) -> String {
  match drv_sha256_file(path, file_hash_memo) {
    Some(h) => "sha256:" + h
    None => {
      let norm_path = drv_normalize_path(drv_abs_path(world, path))
      let sz = fs_size(world, path)
      if sz < 0L {
        "missing:" + norm_path
      } else {
        "unreadable:" + norm_path + ":" + sz.to_string()
      }
    }
  }
}

///|
fn drv_rc_dir_fp(
  world : World,
  rc_dir : String,
  file_hash_memo : Map[String, String],
) -> String {
  if rc_dir.length() == 0 || !fs_is_dir(world, rc_dir) {
    return ""
  }
  let entries = fs_list_dir(world, rc_dir)
  drv_sort_strings(entries)
  let parts : Array[String] = []
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name.length() > 0 && str_code_at(name, 0) != 46 {
      let full = drv_join_path(rc_dir, name)
      if !fs_is_dir(world, full) {
        let sz = fs_size(world, full)
        let content_h = match drv_sha256_file(full, file_hash_memo) {
          Some(h) => h
          None => "unreadable"
        }
        parts.push(name + ":" + sz.to_string() + ":" + content_h)
      }
    }
    i = i + 1
  }
  sha256_hex(drv_join_char(parts, "\n"))
}

///|
/// Compiles a package's Windows `.rc` resource scripts (`[link.windows] rc_sources`)
/// into CAS-cached `$PION_CACHE_DIR/obj/rc_<key>.res` objects (Windows targets only).
fn drv_compile_pkg_rc_sources(
  world : World,
  node : PkgNodeInput,
  qbe_target : String,
  cache_dir : String,
  trace_cas : Bool,
  file_hash_memo : Map[String, String],
  out_res : Array[String],
  out_keys : Array[String],
  out_new_keys : Array[String],
  out_new_sizes : Array[Int64],
  pin : DrvCasPinSession,
  quiet : Bool,
) -> Result[Unit, String] {
  if !drv_target_is_windows(qbe_target) {
    return Ok(())
  }
  let rc_sources : Array[String] = []
  let mut i = 0
  while i < node.link_common.rc_sources.length() {
    push_unique_lib(
      rc_sources,
      drv_resolve_pkg_path(node.dir, node.link_common.rc_sources[i]),
    )
    i = i + 1
  }
  i = 0
  while i < node.link_windows.rc_sources.length() {
    push_unique_lib(
      rc_sources,
      drv_resolve_pkg_path(node.dir, node.link_windows.rc_sources[i]),
    )
    i = i + 1
  }
  if rc_sources.length() == 0 {
    return Ok(())
  }
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let is_msvc = drv_is_windows_msvc_cc(world, qbe_target, cc_bin)
  let rc_bin = drv_resolve_win_rc_bin(world, cc_bin, is_msvc)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let mut ri = 0
  while ri < rc_sources.length() {
    let rc_path = rc_sources[ri]
    if !fs_exists(world, rc_path) {
      return Err("rc_source does not exist: " + rc_path)
    }
    let rc_txt = match fs_read(world, rc_path) {
      Ok(t) => t
      Err(e) => return Err("failed to read rc_source " + rc_path + ": " + e)
    }
    let rc_hash = sha256_hex(rc_txt)
    let rc_dir_raw = drv_parent_dir(rc_path)
    let rc_dir = if rc_dir_raw.length() > 0 { rc_dir_raw } else { "." }
    let res_fp = drv_rc_dir_fp(world, rc_dir, file_hash_memo)
    let key = sha256_hex(
      "rc-v1|" +
      qbe_target +
      "|" +
      (if is_msvc { "msvc" } else { "mingw" }) +
      "|" +
      rc_bin +
      "|" +
      rc_path +
      "|" +
      rc_hash +
      "|" +
      res_fp,
    )
    let res_path = cache_dir + "/obj/rc_" + key + ".res"
    let mut final_res_path = res_path
    if drv_is_nonempty_regular_file(world, res_path) &&
      drv_cas_pin_and_verify(world, cache_dir, pin, ["rc_" + key], [res_path]) {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] rc=" + rc_path + " HIT key=" + drv_prefix16(key),
        )
      }
    } else {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] rc=" + rc_path + " MISS key=" + drv_prefix16(key),
        )
      }
      let stamp = drv_tmp_tag(world, res_path + ":" + ri.to_string())
      let res_tmp = res_path + ".tmp." + stamp + "_" + ri.to_string()
      let argv : Array[String] = if is_msvc {
        [rc_bin, "-I", rc_dir, "-fo", res_tmp, rc_path]
      } else {
        [rc_bin, "-I", rc_dir, rc_path, "-O", "coff", "-o", res_tmp]
      }
      let rc = drv_exec_quiet(world, argv, quiet)
      if rc != 0 {
        let _ = fs_remove(world, res_tmp)
        return Err(
          "failed to compile rc_source " +
          rc_path +
          " with " +
          rc_bin +
          " (exit code " +
          rc.to_string() +
          ")",
        )
      }
      if drv_cas_publish_file_pinned(world, cache_dir, pin, ["rc_" + key], res_tmp, res_path) {
        let sz = fs_size(world, res_path)
        out_new_keys.push("rc_" + key)
        out_new_sizes.push(if sz > 0L { sz } else { 0L })
      } else {
        pin.temp_files.push(res_tmp)
        final_res_path = res_tmp
      }
    }
    out_res.push(final_res_path)
    out_keys.push(key)
    ri = ri + 1
  }
  Ok(())
}

///|
struct DrvWsBuilt {
  root_pkg_name : String
  root_checked : Option[CheckedPackage]
  obj_paths : Array[String]
  dep_pkg_names : Array[String]
  link_key : String
  link_opts : DrvLinkOpts
}

///|
/// `qbe -t <target> --obj|--obj-batch`, plus `--macos-ver` only for Mach-O.
fn drv_qbe_obj_argv(
  qbe_bin : String,
  qbe_target : String,
  qbe_macos_ver : String,
  batch : Bool,
) -> Array[String] {
  let mode = if batch { "--obj-batch" } else { "--obj" }
  let qbe_arch = drv_target_qbe_arch(qbe_target)
  let argv : Array[String] = [qbe_bin, "--strict-jnz", "-t", qbe_arch, mode]
  if qbe_target == "arm64_apple" {
    argv.push("--macos-ver")
    argv.push(qbe_macos_ver)
  }
  argv
}

///|
/// QBE writes `.o` itself (Mach-O arm64 or ELF64 x86_64), skipping `as`.
fn drv_direct_obj_target(world : World, qbe_target : String) -> Bool {
  (qbe_target == "arm64_apple" || qbe_target == "amd64_sysv") &&
  drv_env_str(world, "PION_NO_DIRECT_OBJ") != "1"
}

///|
fn drv_pick_target(world : World, target_override : String) -> String {
  if target_override.length() > 0 {
    target_override
  } else {
    drv_resolve_qbe_target(world)
  }
}

///|
/// Cache-key suffix for extra link options ("" when empty, so keys stay stable).
/// Includes every `objects` file's content fingerprint (`drv_cas_file_content_fp`,
/// zero `mtime`) so rebuilt `.a`/`.o`/`.dylib` invalidate the linked binary while
/// cross-runner cache restores keep 100% hit rate.
fn drv_link_opts_key(world : World, opts : DrvLinkOpts) -> String {
  if opts.libs.length() == 0 &&
    opts.frameworks.length() == 0 &&
    opts.search_paths.length() == 0 &&
    opts.rpaths.length() == 0 &&
    opts.objects.length() == 0 &&
    opts.flags.length() == 0 &&
    !opts.has_cxx {
    return ""
  }
  let sb = StringBuilder()
  if opts.libs.length() > 0 {
    sb.write_string("|link:")
    sb.write_string(drv_join_char(opts.libs, ","))
  }
  if opts.frameworks.length() > 0 {
    sb.write_string("|fw:")
    sb.write_string(drv_join_char(opts.frameworks, ","))
  }
  if opts.search_paths.length() > 0 {
    sb.write_string("|L:")
    sb.write_string(drv_join_char(opts.search_paths, ","))
  }
  if opts.rpaths.length() > 0 {
    sb.write_string("|rpath:")
    sb.write_string(drv_join_char(opts.rpaths, ","))
  }
  if opts.objects.length() > 0 {
    let file_hash_memo : Map[String, String] = Map([])
    sb.write_string("|obj:")
    let mut i = 0
    while i < opts.objects.length() {
      if i > 0 {
        sb.write_string(",")
      }
      let op = opts.objects[i]
      sb.write_string(op)
      sb.write_string(":")
      sb.write_string(drv_cas_file_content_fp(world, op, file_hash_memo))
      i = i + 1
    }
  }
  if opts.flags.length() > 0 {
    sb.write_string("|flags:")
    sb.write_string(drv_join_char(opts.flags, "\n"))
  }
  if opts.has_cxx {
    sb.write_string("|cxx:1")
  }
  sb.to_string()
}

///|
fn drv_flags_has_no_gc_sections(flags : Array[String]) -> Bool {
  let mut i = 0
  while i < flags.length() {
    let fl = flags[i]
    if fl == "-Wl,--no-gc-sections" {
      return true
    }
    if drv_starts_with(fl, "-Wl,") {
      let body = slice_str(fl, 4, fl.length())
      let n = body.length()
      let mut start = 0
      let mut j = 0
      while j <= n {
        if j == n || str_code_at(body, j) == 44 {
          if slice_str(body, start, j) == "--no-gc-sections" {
            return true
          }
          start = j + 1
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  false
}

///|
fn drv_use_direct_apple_ld(
  apple_tools : AppleTools,
  qbe_target : String,
  sysroot : String,
  opts : DrvLinkOpts,
) -> Bool {
  let is_simple = opts.frameworks.length() == 0 &&
    opts.search_paths.length() == 0 &&
    opts.rpaths.length() == 0 &&
    opts.objects.length() == 0 &&
    opts.flags.length() == 0 &&
    !opts.has_cxx
  apple_tools.ok &&
    is_simple &&
    qbe_target == "arm64_apple" &&
    sysroot.length() == 0
}

///|
fn drv_effective_link_context_key(
  world : World,
  qbe_target : String,
  sysroot : String,
  opts : DrvLinkOpts,
) -> String {
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  if drv_use_direct_apple_ld(apple_tools, qbe_target, sysroot, opts) {
    let ver = if apple_tools.macos_ver.length() > 0 {
      apple_tools.macos_ver
    } else {
      "15.0"
    }
    return "|linkctx:k1a-v3|tgt:" +
      qbe_target +
      "|linkmode:apple_ld|ld:" +
      apple_tools.ld_bin +
      "|sdk:" +
      apple_tools.sdk_path +
      "|ver:" +
      ver
  }
  let driver = drv_resolve_cc_driver(world, qbe_target, opts.has_cxx)
  let is_win_msvc = drv_is_windows_msvc_cc(world, qbe_target, driver)
  let eff : Array[String] = drv_target_cc_flags(world, qbe_target, sysroot)
  if drv_target_is_apple(qbe_target) {
    eff.push("-Wl,-dead_strip")
  } else if is_win_msvc {
    let t_flags = drv_win_translate_msvc_flags(opts.flags, false)
    let mut i = 0
    while i < t_flags.length() {
      eff.push(t_flags[i])
      i = i + 1
    }
  } else {
    if !drv_flags_has_no_gc_sections(opts.flags) {
      eff.push("-Wl,--gc-sections")
    }
    let mut i = 0
    while i < opts.flags.length() {
      eff.push(opts.flags[i])
      i = i + 1
    }
    eff.push("-lm")
    if drv_target_is_windows(qbe_target) {
      eff.push("-lws2_32")
      eff.push("-Wl,--stack,16777216")
    } else if !drv_target_is_android(qbe_target) {
      eff.push("-lpthread")
    }
  }
  "|linkctx:k1a-v3|tgt:" +
  qbe_target +
  "|linkmode:cc|drv:" +
  driver +
  "|msvc:" +
  (if is_win_msvc { "1" } else { "0" }) +
  "|eff:" +
  drv_join_char(eff, ",")
}

///|
fn drv_is_bare_msvc_link_opt(fl : String) -> Bool {
  let sb = StringBuilder()
  let mut i = 0
  while i < fl.length() {
    let c = str_code_at(fl, i)
    if c >= 97 && c <= 122 {
      sb.write_char((c - 32).unsafe_to_char())
    } else {
      sb.write_string(slice_str(fl, i, i + 1))
    }
    i = i + 1
  }
  let up = sb.to_string()
  drv_starts_with(up, "/OPT:") ||
  drv_starts_with(up, "-OPT:") ||
  up == "/INCREMENTAL" ||
  up == "-INCREMENTAL" ||
  drv_starts_with(up, "/INCREMENTAL:") ||
  drv_starts_with(up, "-INCREMENTAL:") ||
  drv_starts_with(up, "/STACK:") ||
  drv_starts_with(up, "-STACK:")
}

///|
fn drv_push_msvc_link_tail(
  ld_argv : Array[String],
  driver : String,
  t_flags : Array[String],
  out_path : String,
) -> Unit {
  if drv_is_clang_cl_driver(driver) {
    let link_args : Array[String] = []
    let mut i = 0
    while i < t_flags.length() {
      let fl = t_flags[i]
      if fl == "-Xlinker" && i + 1 < t_flags.length() {
        link_args.push(t_flags[i + 1])
        i = i + 2
        continue
      } else if drv_starts_with(fl, "-Wl,") {
        let body = slice_str(fl, 4, fl.length())
        let n = body.length()
        let mut start = 0
        let mut j = 0
        while j <= n {
          if j == n || str_code_at(body, j) == 44 {
            let tok = slice_str(body, start, j)
            if tok.length() > 0 {
              link_args.push(tok)
            }
            start = j + 1
          }
          j = j + 1
        }
      } else if fl.length() > 2 && drv_starts_with(fl, "-l") {
        link_args.push(slice_str(fl, 2, fl.length()) + ".lib")
      } else if drv_is_bare_msvc_link_opt(fl) {
        link_args.push(fl)
      } else {
        ld_argv.push(fl)
      }
      i = i + 1
    }
    ld_argv.push("-o")
    ld_argv.push(out_path)
    if link_args.length() > 0 {
      ld_argv.push("/link")
      i = 0
      while i < link_args.length() {
        ld_argv.push(link_args[i])
        i = i + 1
      }
    }
  } else {
    let mut i = 0
    while i < t_flags.length() {
      ld_argv.push(t_flags[i])
      i = i + 1
    }
    ld_argv.push("-o")
    ld_argv.push(out_path)
  }
}

///|
fn drv_bin_key(
  world : World,
  qbe_target : String,
  sysroot : String,
  key : String,
  opts : DrvLinkOpts,
) -> String {
  let suffix = drv_link_opts_key(world, opts)
  let ctx = drv_effective_link_context_key(world, qbe_target, sysroot, opts)
  sha256_hex(key + suffix + ctx)
}

///|
fn drv_copy_file(world : World, src : String, dst : String) -> Result[String, String] {
  drv_ensure_parent_dir(world, dst)
  let b = match fs_read_bytes(world, src) {
    Err(e) => return Err("failed to read " + src + ": " + e)
    Ok(v) => v
  }
  let (dst_dir, dst_base) = drv_split_dir_base(world, dst)
  let stage = match drv_make_out_stage(world, dst_dir) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let tmp = stage + "/" + dst_base
  let res : Result[String, String] = match fs_write_bytes(world, tmp, b) {
    Err(e) => Err("failed to write " + dst + ": " + e)
    Ok(_) =>
      if drv_publish_tmp(world, tmp, dst, false) {
        Ok(dst)
      } else {
        Err("failed to replace " + dst)
      }
  }
  drv_staged_result(res, drv_drop_out_stage(world, stage))
}

///|
/// Parses `-l <lib>`, `-l<lib>` and `--link <lib>` at `args[i]`; returns how many
/// arguments were consumed (0 when `args[i]` is not a link flag).
fn drv_parse_link_flag(args : Array[String], i : Int, libs : Array[String]) -> Int {
  let a = args[i]
  if (a == "-l" || a == "--link") && i + 1 < args.length() {
    push_unique_lib(libs, args[i + 1])
    2
  } else if a.length() > 2 && drv_starts_with(a, "-l") {
    push_unique_lib(libs, slice_str(a, 2, a.length()))
    1
  } else {
    0
  }
}

///|
fn drv_compile_ssa_to_obj(
  world : World,
  qbe_bin : String,
  qbe_target : String,
  apple_tools : AppleTools,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  sysroot : String,
  ssa_path : String,
  obj_path : String,
  stamp : String,
  quiet : Bool,
) -> Result[Unit, String] {
  let obj_tmp = obj_path + ".tmp." + stamp
  if direct_obj {
    let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
    argv.push("-o")
    argv.push(obj_tmp)
    argv.push(ssa_path)
    let rc_qbe = drv_exec_quiet(world, argv, quiet)
    if rc_qbe != 0 {
      let _ = fs_remove(world, obj_tmp)
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    if !drv_publish_tmp(world, obj_tmp, obj_path, true) {
      return Err("failed to publish CAS object: " + obj_path)
    }
    Ok(())
  } else {
    let asm_path = obj_path + ".s." + stamp
    let qbe_arch = drv_target_qbe_arch(qbe_target)
    let qbe_seh = drv_win_seh(world, qbe_target)
    let rc_qbe = drv_exec_quiet(world, drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, asm_path, ssa_path), quiet)
    if rc_qbe != 0 {
      let _ = fs_remove(world, asm_path)
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    let rc_as = drv_assemble_file(
      world,
      qbe_target,
      apple_tools,
      cc1as_triple,
      sysroot,
      asm_path,
      obj_tmp,
      quiet,
    )
    let _ = fs_remove(world, asm_path)
    if rc_as != 0 {
      let _ = fs_remove(world, obj_tmp)
      return Err("as failed with exit code " + rc_as.to_string())
    }
    if !drv_publish_tmp(world, obj_tmp, obj_path, true) {
      return Err("failed to publish CAS object: " + obj_path)
    }
    Ok(())
  }
}

///|
fn drv_resolve_ar_tool(world : World, qbe_target : String) -> String {
  let env_ar = drv_env_str(world, "AR")
  if env_ar.length() > 0 {
    return env_ar
  }
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  if drv_find_substr(cc_bin, "/", 0) >= 0 {
    let dir = drv_parent_dir(cc_bin)
    if dir.length() > 0 {
      let llvm_ar = drv_join_path(dir, "llvm-ar")
      if fs_exists(world, llvm_ar) {
        return llvm_ar
      }
      if drv_ends_with(cc_bin, "-gcc") {
        let cand = slice_str(cc_bin, 0, cc_bin.length() - 3) + "ar"
        if fs_exists(world, cand) {
          return cand
        }
      } else if drv_ends_with(cc_bin, "-clang") {
        let cand = slice_str(cc_bin, 0, cc_bin.length() - 5) + "ar"
        if fs_exists(world, cand) {
          return cand
        }
      }
    }
  }
  if drv_target_is_android(qbe_target) {
    let ndk_bin = drv_find_android_ndk_bin_dir(world)
    if ndk_bin.length() > 0 {
      let cand = ndk_bin + "/llvm-ar"
      if fs_exists(world, cand) {
        return cand
      }
    }
  }
  if !drv_target_is_apple(qbe_target) &&
    !drv_target_is_windows(qbe_target) &&
    drv_target_is_apple(drv_resolve_qbe_target(world)) {
    if fs_exists(world, "/opt/homebrew/opt/llvm/bin/llvm-ar") {
      return "/opt/homebrew/opt/llvm/bin/llvm-ar"
    }
    if fs_exists(world, "/usr/local/opt/llvm/bin/llvm-ar") {
      return "/usr/local/opt/llvm/bin/llvm-ar"
    }
  }
  "ar"
}

///|
fn drv_archive_static_lib(
  world : World,
  qbe_target : String,
  obj_paths : Array[String],
  out_path : String,
  quiet : Bool,
) -> Result[String, String] {
  drv_ensure_parent_dir(world, out_path)
  if fs_exists(world, out_path) {
    let _ = fs_remove(world, out_path)
  }
  let ar_bin = drv_resolve_ar_tool(world, qbe_target)
  let argv : Array[String] = [ar_bin, "rcs", out_path]
  let mut i = 0
  while i < obj_paths.length() {
    argv.push(obj_paths[i])
    i = i + 1
  }
  let rc = drv_exec_quiet(world, argv, quiet)
  if rc != 0 {
    Err(ar_bin + " failed with exit code " + rc.to_string())
  } else {
    Ok(out_path)
  }
}

///|
fn drv_link_shared_lib(
  world : World,
  qbe_target : String,
  sysroot : String,
  obj_paths : Array[String],
  rt_lib : String,
  opts : DrvLinkOpts,
  out_path : String,
) -> Result[String, String] {
  drv_ensure_parent_dir(world, out_path)
  let driver = drv_resolve_cc_driver(world, qbe_target, opts.has_cxx)
  let ld_argv : Array[String] = [driver]
  let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
  let mut ti = 0
  while ti < tflags.length() {
    ld_argv.push(tflags[ti])
    ti = ti + 1
  }
  if drv_target_is_apple(qbe_target) {
    ld_argv.push("-dynamiclib")
  } else {
    ld_argv.push("-shared")
  }
  let mut oi = 0
  while oi < obj_paths.length() {
    ld_argv.push(obj_paths[oi])
    oi = oi + 1
  }
  ld_argv.push(rt_lib)
  let mut exi = 0
  while exi < opts.objects.length() {
    ld_argv.push(opts.objects[exi])
    exi = exi + 1
  }
  let mut spi = 0
  while spi < opts.search_paths.length() {
    ld_argv.push("-L" + opts.search_paths[spi])
    spi = spi + 1
  }
  if !drv_target_is_windows(qbe_target) {
    let mut rpi = 0
    while rpi < opts.rpaths.length() {
      ld_argv.push("-Wl,-rpath," + opts.rpaths[rpi])
      rpi = rpi + 1
    }
  }
  if drv_target_is_apple(qbe_target) {
    let mut fwi = 0
    while fwi < opts.frameworks.length() {
      ld_argv.push("-framework")
      ld_argv.push(opts.frameworks[fwi])
      fwi = fwi + 1
    }
  }
  let is_win_msvc = drv_is_windows_msvc_cc(world, qbe_target, driver)
  let mut li = 0
  while li < opts.libs.length() {
    let lib = opts.libs[li]
    if !is_win_msvc || (lib != "m" && lib != "pthread") {
      if is_win_msvc && drv_is_clang_cl_driver(driver) {
        ld_argv.push(lib + ".lib")
      } else {
        ld_argv.push("-l" + lib)
      }
    }
    li = li + 1
  }
  if is_win_msvc {
    let t_flags = drv_win_translate_msvc_flags(opts.flags, true)
    drv_push_msvc_link_tail(ld_argv, driver, t_flags, out_path)
  } else {
    let mut fli = 0
    while fli < opts.flags.length() {
      ld_argv.push(opts.flags[fli])
      fli = fli + 1
    }
    if !drv_target_is_apple(qbe_target) {
      ld_argv.push("-lm")
      if drv_target_is_windows(qbe_target) {
        ld_argv.push("-lws2_32")
      } else if !drv_target_is_android(qbe_target) {
        ld_argv.push("-lpthread")
      }
    }
    ld_argv.push("-o")
    ld_argv.push(out_path)
  }
  let rc_ld = proc_exec(world, ld_argv)
  if rc_ld != 0 {
    Err("shared linker failed with exit code " + rc_ld.to_string())
  } else {
    Ok(out_path)
  }
}

///|
/// Splits `path` at its last separator into (directory, basename); the
/// directory is `"."` without a separator and `"/"` for a root-level path.
/// Separators are the host's: `/` and backslash on Windows, only `/`
/// elsewhere (where a backslash is an ordinary file-name character).
fn drv_split_dir_base(_world : World, path : String) -> (String, String) {
  let win = c_cli_is_windows() != 0
  let mut i = path.length() - 1
  while i >= 0 {
    let ch = str_code_at(path, i)
    if ch == 47 || (win && ch == 92) {
      break
    }
    i = i - 1
  }
  if i < 0 {
    (".", path)
  } else if i == 0 {
    (slice_str(path, 0, 1), slice_str(path, 1, path.length()))
  } else {
    (slice_str(path, 0, i), slice_str(path, i + 1, path.length()))
  }
}

///|
/// Exclusively creates a short private staging directory
/// `<dir>/.pion_ld.<pid>.<seq>` next to an output that a tool (linker,
/// `wasm-opt`) or a copy writes before `drv_publish_tmp` renames it into
/// place: the same filesystem keeps the rename atomic, and the staged file
/// keeps the output's own basename (no longer than the final name).
/// `seq` comes from the process-wide `c_cli_next_seq` counter on every
/// attempt, so two threads of one `pionc` (`test --jobs N`) never try the
/// same name and a name is never reused after its owner removed it. Only a
/// name already taken (`1`: a leftover of an older process with the same
/// pid, a foreign directory) moves on to the next `seq`, up to 4096 tries;
/// any other failure (`-1`: no permission, missing directory) is an
/// immediate error, decided by the `mkdir` itself (no racy re-probe).
fn drv_make_out_stage(_world : World, dir : String) -> Result[String, String] {
  let base = dir + "/.pion_ld." + c_cli_getpid().to_string() + "."
  let mut k = 0
  while k < 4096 {
    let cand = base + c_cli_next_seq().to_string()
    let st = c_fs_mkdir_excl_status(drv_cpath(cand))
    if st == 0 {
      return Ok(cand)
    }
    if st != 1 {
      return Err("cannot create a staging directory in " + dir + " (" + cand + ")")
    }
    k = k + 1
  }
  Err("cannot create a staging directory in " + dir + ": 4096 names taken")
}

///|
/// Removes whatever is left in a `drv_make_out_stage` directory (the output
/// after a failed publish, tool side files such as a `.dSYM` tree) and then
/// the directory itself, recursively but never through a symlink (`lstat`:
/// links and files are unlinked, only real directories are descended).
fn drv_drop_out_stage(world : World, stage : String) -> Result[Unit, String] {
  let removed = drv_remove_tree_nofollow(world, stage)
  if removed && drv_lstat_kind(stage) == 0 {
    Ok(())
  } else {
    Err("failed to remove staging directory " + stage)
  }
}

///|
/// Removes `path` without following symlinks: its kind is checked with
/// `lstat` before anything else; only a real directory is listed and
/// descended, a symlink (or a Windows junction, which `fs_remove` cannot
/// delete and `rmdir` can) is removed itself, a confirmed-missing path is
/// done, and a failed `lstat` is a failure (never "already removed").
fn drv_remove_tree_nofollow(world : World, path : String) -> Bool {
  let kind = drv_lstat_kind(path)
  let p = path
  if kind == 0 {
    true
  } else if kind < 0 {
    false
  } else if kind == 2 {
    let entries = fs_list_dir(world, path)
    let mut ok = true
    let mut i = 0
    while i < entries.length() {
      if !drv_remove_tree_nofollow(world, path + "/" + entries[i]) {
        ok = false
      }
      i = i + 1
    }
    c_fs_rmdir(drv_cpath(p)) == 0 && ok
  } else if kind == 3 {
    fs_remove(world, path) || c_fs_rmdir(drv_cpath(p)) == 0
  } else {
    fs_remove(world, path)
  }
}

///|
/// The result of a staged write once its staging directory is gone: a
/// cleanup failure after a successful publish fails the command but names
/// the published output and the leftover directory; after a failure it is
/// appended to (never replaces) the original error.
fn drv_staged_result(
  res : Result[String, String],
  drop : Result[Unit, String],
) -> Result[String, String] {
  match drop {
    Ok(_) => res
    Err(d) =>
      match res {
        Ok(published) => Err("published " + published + ", but " + d)
        Err(e) => Err(e + "; " + d)
      }
  }
}

///|
/// Publishes a tool's staged output `tmp` as `dst` only when the tool really
/// produced one (a non-empty regular file): a tool that exits 0 but leaves
/// nothing, an empty file or a symlink never replaces `dst`.
fn drv_publish_tool_output(
  world : World,
  tmp : String,
  dst : String,
  shared : Bool,
  what : String,
) -> Result[String, String] {
  if !drv_is_nonempty_regular_file(world, tmp) {
    let _ = fs_remove(world, tmp)
    return Err(what + " produced no output for " + dst)
  }
  if drv_publish_tmp(world, tmp, dst, shared) {
    Ok(dst)
  } else {
    Err("failed to move " + what + " output into " + dst)
  }
}

///|
/// Links `obj_paths` into the executable `final_bin` atomically: the linker
/// writes `<dir>/.pion_ld.<pid>.<seq>/<basename>` (a private staging
/// directory, so `-o` carries the final basename: Apple ld64 records it as
/// the ad-hoc code-signature identifier, and the name is no longer than the
/// final one), which is renamed into place only after a successful link; the
/// staging directory is removed on every path, so a concurrent
/// `pionc run`/`build` never sees a half-written binary. `shared` marks a
/// content-addressed CAS `final_bin` (see `drv_publish_tmp`); an explicit
/// `-o` path is never `shared`. Returns the published path
/// (`drv_linked_exe_path`).
fn drv_link_objects(
  world : World,
  qbe_target : String,
  apple_tools : AppleTools,
  ld_ver : String,
  sysroot : String,
  obj_paths : Array[String],
  rt_lib : String,
  opts : DrvLinkOpts,
  final_bin : String,
  shared : Bool,
  quiet : Bool,
) -> Result[String, String] {
  let out_bin = drv_linked_exe_path(qbe_target, final_bin)
  let (out_dir, out_base) = drv_split_dir_base(world, out_bin)
  let stage = match drv_make_out_stage(world, out_dir) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let tmp = stage + "/" + out_base
  let linked = drv_link_objects_to(
    world,
    qbe_target,
    apple_tools,
    ld_ver,
    sysroot,
    obj_paths,
    rt_lib,
    opts,
    tmp,
    quiet,
  )
  let res : Result[String, String] = match linked {
    Err(e) => Err(e)
    Ok(_) => drv_publish_tool_output(world, tmp, out_bin, shared, "linker")
  }
  drv_staged_result(res, drv_drop_out_stage(world, stage))
}

///|
/// Runs the linker with `-o final_bin` (no publishing; see `drv_link_objects`).
fn drv_link_objects_to(
  world : World,
  qbe_target : String,
  apple_tools : AppleTools,
  ld_ver : String,
  sysroot : String,
  obj_paths : Array[String],
  rt_lib : String,
  opts : DrvLinkOpts,
  final_bin : String,
  quiet : Bool,
) -> Result[Unit, String] {
  let rc_ld = if drv_use_direct_apple_ld(apple_tools, qbe_target, sysroot, opts) {
    let ld_argv : Array[String] = [
      apple_tools.ld_bin,
      "-arch",
      "arm64",
      "-platform_version",
      "macos",
      ld_ver,
      ld_ver,
      "-syslibroot",
      apple_tools.sdk_path,
      "-dead_strip",
      "-o",
      final_bin,
    ]
    let mut oi = 0
    while oi < obj_paths.length() {
      ld_argv.push(obj_paths[oi])
      oi = oi + 1
    }
    ld_argv.push(rt_lib)
    let mut li = 0
    while li < opts.libs.length() {
      ld_argv.push("-l" + opts.libs[li])
      li = li + 1
    }
    ld_argv.push("-lSystem")
    drv_exec_quiet(world, ld_argv, quiet)
  } else {
    let driver = drv_resolve_cc_driver(world, qbe_target, opts.has_cxx)
    let ld_argv : Array[String] = [driver]
    let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
    let mut ti = 0
    while ti < tflags.length() {
      ld_argv.push(tflags[ti])
      ti = ti + 1
    }
    let mut oi = 0
    while oi < obj_paths.length() {
      ld_argv.push(obj_paths[oi])
      oi = oi + 1
    }
    ld_argv.push(rt_lib)
    let mut exi = 0
    while exi < opts.objects.length() {
      ld_argv.push(opts.objects[exi])
      exi = exi + 1
    }
    let mut spi = 0
    while spi < opts.search_paths.length() {
      ld_argv.push("-L" + opts.search_paths[spi])
      spi = spi + 1
    }
    if !drv_target_is_windows(qbe_target) {
      let mut rpi = 0
      while rpi < opts.rpaths.length() {
        ld_argv.push("-Wl,-rpath," + opts.rpaths[rpi])
        rpi = rpi + 1
      }
    }
    let is_win_msvc = drv_is_windows_msvc_cc(world, qbe_target, driver)
    if drv_target_is_apple(qbe_target) {
      ld_argv.push("-Wl,-dead_strip")
      let mut fwi = 0
      while fwi < opts.frameworks.length() {
        ld_argv.push("-framework")
        ld_argv.push(opts.frameworks[fwi])
        fwi = fwi + 1
      }
    } else if !is_win_msvc && !drv_flags_has_no_gc_sections(opts.flags) {
      ld_argv.push("-Wl,--gc-sections")
    }
    let mut li = 0
    while li < opts.libs.length() {
      let lib = opts.libs[li]
      if !is_win_msvc || (lib != "m" && lib != "pthread") {
        if is_win_msvc && drv_is_clang_cl_driver(driver) {
          ld_argv.push(lib + ".lib")
        } else {
          ld_argv.push("-l" + lib)
        }
      }
      li = li + 1
    }
    if is_win_msvc {
      let t_flags = drv_win_translate_msvc_flags(opts.flags, false)
      drv_push_msvc_link_tail(ld_argv, driver, t_flags, final_bin)
    } else {
      let mut fli = 0
      while fli < opts.flags.length() {
        ld_argv.push(opts.flags[fli])
        fli = fli + 1
      }
      if !drv_target_is_apple(qbe_target) {
        ld_argv.push("-lm")
        if drv_target_is_windows(qbe_target) {
          ld_argv.push("-lws2_32")
          // MinGW-w64 defaults the main thread to a 1 MB stack (macOS/Linux: 8 MB);
          // deep recursion (e.g. self-hosting 43K lines) needs 16 MB.
          ld_argv.push("-Wl,--stack,16777216")
        } else if !drv_target_is_android(qbe_target) {
          ld_argv.push("-lpthread")
        }
      }
      ld_argv.push("-o")
      ld_argv.push(final_bin)
    }
    drv_exec_quiet(world, ld_argv, quiet)
  }
  if rc_ld != 0 {
    Err("linker failed with exit code " + rc_ld.to_string())
  } else {
    Ok(())
  }
}

///|
fn drv_effective_sig_hash(
  sig_text : String,
  node : PkgNodeInput,
  sig_hashes : Map[String, String],
) -> String {
  let sb = StringBuilder()
  sb.write_string("esig-v1|")
  sb.write_string(sha256_hex(sig_text))
  let pairs : Array[String] = []
  let mut i = 0
  while i < node.dep_aliases.length() && i < node.deps.length() {
    let target = node.deps[i]
    let dep_h = match sig_hashes.get(target) {
      Some(h) => h
      None => ""
    }
    pairs.push(node.dep_aliases[i] + "=" + target + ":" + dep_h)
    i = i + 1
  }
  drv_sort_strings(pairs)
  i = 0
  while i < pairs.length() {
    sb.write_string("|")
    sb.write_string(pairs[i])
    i = i + 1
  }
  sha256_hex(sb.to_string())
}

///|
fn drv_cas_rel_paths(node : PkgNodeInput) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < node.paths.length() {
    out.push(pkg_rebase_rel_path(node.dir, node.paths[i]))
    i = i + 1
  }
  out
}

///|
fn drv_append_dep_alias_sigs(
  upstream_sigs : Array[String],
  node : PkgNodeInput,
) -> Unit {
  let pairs : Array[String] = []
  let mut i = 0
  while i < node.dep_aliases.length() && i < node.deps.length() {
    pairs.push("alias:" + node.dep_aliases[i] + "=" + node.deps[i])
    i = i + 1
  }
  drv_sort_strings(pairs)
  i = 0
  while i < pairs.length() {
    upstream_sigs.push(pairs[i])
    i = i + 1
  }
}

///|
/// Mode-aware workspace import loader shared by parent and parallel workers:
/// - `was_preexisting_hit[u] == true`: loads from `stub_paths[u]` (falling back
///   to immutable snapshot/in-memory source if empty or parse fails), matching
///   serial CAS-HIT behavior.
/// - `was_preexisting_hit[u] == false`: always rebuilds full `cr.tc` from
///   immutable snapshot/in-memory source (and caches into `loaded_imported[u]`),
///   matching serial CAS-MISS behavior (closing P96 Case 6 parity when an
///   upstream MISS was compiled in a worker and a downstream runs in the parent).
fn drv_ensure_ws_imports_mode(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  stub_paths : Array[String],
  was_preexisting_hit : Array[Bool],
  loaded_imported : Array[Option[ImportedPkg]],
  pkg_topo_idx : Int,
  pkg_cwd : String,
) -> Array[ImportedPkg] {
  drv_ensure_ws_imports_mode_ex(
    world,
    nodes,
    topo_order,
    trans_dep_topo,
    stub_paths,
    was_preexisting_hit,
    loaded_imported,
    pkg_topo_idx,
    pkg_cwd,
    None,
  )
}

///|
fn drv_ensure_ws_imports_ex(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  stub_paths : Array[String],
  loaded_imported : Array[Option[ImportedPkg]],
  pkg_topo_idx : Int,
  diag_out : Option[Array[Diagnostic]],
) -> Array[ImportedPkg] {
  let all_hit : Array[Bool] = []
  let mut k = 0
  while k < stub_paths.length() {
    all_hit.push(true)
    k = k + 1
  }
  let pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
  drv_ensure_ws_imports_mode_ex(
    world,
    nodes,
    topo_order,
    trans_dep_topo,
    stub_paths,
    all_hit,
    loaded_imported,
    pkg_topo_idx,
    pkg_cwd,
    diag_out,
  )
}

///|
fn drv_ensure_ws_imports_mode_ex(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  stub_paths : Array[String],
  was_preexisting_hit : Array[Bool],
  loaded_imported : Array[Option[ImportedPkg]],
  pkg_topo_idx : Int,
  pkg_cwd : String,
  diag_out : Option[Array[Diagnostic]],
) -> Array[ImportedPkg] {
  let deps_topo = trans_dep_topo[pkg_topo_idx]
  let out : Array[ImportedPkg] = []
  let mut i = 0
  while i < deps_topo.length() {
    let u = deps_topo[i]
    match loaded_imported[u] {
      Some(ipkg) => out.push(ipkg)
      None => {
        let unode = nodes[topo_order[u]]
        let u_deps = trans_dep_topo[u]
        let u_imports : Array[ImportedPkg] = []
        let mut ui = 0
        while ui < u_deps.length() {
          match loaded_imported[u_deps[ui]] {
            Some(dep_imp) => u_imports.push(dep_imp)
            None => ()
          }
          ui = ui + 1
        }
        let mut loaded_opt : Option[ImportedPkg] = None
        let allow_stub = u < was_preexisting_hit.length() && was_preexisting_hit[u]
        let sp = stub_paths[u]
        if allow_stub && sp.length() > 0 {
          match fs_read(world, sp) {
            Ok(stub_txt) =>
              if stub_txt.length() > 0 {
                let scr = check_source_files_with_imports_mapped_dep(
                  unode.name,
                  [unode.name + ".pionstub"],
                  [stub_txt],
                  u_imports,
                  unode.dep_aliases,
                  unode.deps,
                  true,
                  false,
                )
                if scr.diagnostics.length() == 0 {
                  scr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, unode.dir))
                  scr.tc.pkg_cwd = pkg_cwd
                  loaded_opt = Some(ImportedPkg::{ name: unode.name, tc: scr.tc })
                }
              }
            Err(_) => ()
          }
        }
        let ipkg = match loaded_opt {
          Some(v) => v
          None => {
            let fcr = check_source_files_with_imports_mapped_dep(
              unode.name,
              unode.paths,
              unode.sources,
              u_imports,
              unode.dep_aliases,
              unode.deps,
              true,
              false,
            )
            match diag_out {
              Some(darr) => {
                let mut di = 0
                while di < fcr.diagnostics.length() {
                  darr.push(fcr.diagnostics[di])
                  di = di + 1
                }
              }
              None => ()
            }
            fcr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, unode.dir))
            fcr.tc.pkg_cwd = pkg_cwd
            ImportedPkg::{ name: unode.name, tc: fcr.tc }
          }
        }
        loaded_imported[u] = Some(ipkg)
        out.push(ipkg)
      }
    }
    i = i + 1
  }
  out
}

///|
fn drv_ensure_ws_imports(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  stub_paths : Array[String],
  loaded_imported : Array[Option[ImportedPkg]],
  pkg_topo_idx : Int,
) -> Array[ImportedPkg] {
  let all_hit : Array[Bool] = []
  let mut k = 0
  while k < stub_paths.length() {
    all_hit.push(true)
    k = k + 1
  }
  let pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
  drv_ensure_ws_imports_mode(
    world,
    nodes,
    topo_order,
    trans_dep_topo,
    stub_paths,
    all_hit,
    loaded_imported,
    pkg_topo_idx,
    pkg_cwd,
  )
}

///|
fn drv_parse_nonneg_int64(s : String, fallback : Int64) -> Int64 {
  if s.length() == 0 {
    return fallback
  }
  let cap : Int64 = 900000000000000000L
  let cap_div10 : Int64 = 90000000000000000L
  let mut acc : Int64 = 0L
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return fallback
    }
    if acc >= cap_div10 {
      acc = cap
    } else {
      acc = acc * 10L + (c - 48).to_int64()
      if acc > cap {
        acc = cap
      }
    }
    i = i + 1
  }
  acc
}

///|
/// UTF-8-safe spec escaper: copies contiguous unescaped byte runs with
/// `slice_str(s, run_start, i)` so multi-byte UTF-8 sequences are preserved
/// verbatim, escaping only ASCII `\`, `\n`, `\r`, `\t`.
fn drv_ws_spec_escape(s : String) -> String {
  let sb = StringBuilder()
  let n = s.length()
  let mut run_start = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c == 92 || c == 10 || c == 13 || c == 9 {
      if i > run_start {
        sb.write_string(slice_str(s, run_start, i))
      }
      if c == 92 {
        sb.write_string("\\\\")
      } else if c == 10 {
        sb.write_string("\\n")
      } else if c == 13 {
        sb.write_string("\\r")
      } else {
        sb.write_string("\\t")
      }
      run_start = i + 1
    }
    i = i + 1
  }
  if run_start < n {
    sb.write_string(slice_str(s, run_start, n))
  }
  sb.to_string()
}

///|
/// UTF-8-safe spec unescaper: preserves multi-byte UTF-8 runs verbatim.
fn drv_ws_spec_unescape(s : String) -> String {
  let sb = StringBuilder()
  let n = s.length()
  let mut run_start = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c == 92 && i + 1 < n {
      let nx = str_code_at(s, i + 1)
      if nx == 92 || nx == 110 || nx == 114 || nx == 116 {
        if i > run_start {
          sb.write_string(slice_str(s, run_start, i))
        }
        if nx == 92 {
          sb.write_char('\\')
        } else if nx == 110 {
          sb.write_char('\n')
        } else if nx == 114 {
          sb.write_char('\r')
        } else {
          sb.write_char('\t')
        }
        i = i + 2
        run_start = i
        continue
      }
    }
    i = i + 1
  }
  if run_start < n {
    sb.write_string(slice_str(s, run_start, n))
  }
  sb.to_string()
}

///|
struct WsStageHandle {
  dir : String
  lock_fd : Int64
}

///|
fn drv_ws_split_tab(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  let n = s.length()
  while i < n {
    if str_code_at(s, i) == 9 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(s, start, n))
  out
}

///|
/// Creates an exclusive workspace staging directory and immediately acquires
/// an exclusive advisory lock on `<stage>/.lock` under the short-lived root
/// lock `<stage_root>/.gc.lock`, closing the `mkdir`→`flock` TOCTOU window
/// against concurrent `drv_cleanup_stale_ws_stages` runs.
fn drv_make_ws_stage(world : World, stage_root : String) -> Result[WsStageHandle, String] {
  let _ = fs_mkdir_p(world, stage_root)
  let gc_lk = c_fs_lock(drv_cpath(stage_root + "/.gc.lock"))
  if gc_lk < 0L {
    return Err("failed to acquire ws_stage/.gc.lock")
  }
  let base = stage_root + "/.pion_ws." + c_cli_getpid().to_string() + "."
  let mut k = 0
  while k < 4096 {
    let cand = base + c_cli_next_seq().to_string()
    let st = c_fs_mkdir_excl_status(drv_cpath(cand))
    if st == 0 {
      let lk = c_fs_trylock(drv_cpath(cand + "/.lock"))
      if lk < 0L {
        let _ = drv_remove_tree_nofollow(world, cand)
        c_fs_unlock(gc_lk)
        return Err("cannot lock workspace stage directory " + cand)
      }
      c_fs_unlock(gc_lk)
      return Ok(WsStageHandle::{ dir: cand, lock_fd: lk })
    }
    if st != 1 {
      c_fs_unlock(gc_lk)
      return Err("cannot create workspace stage directory in " + stage_root)
    }
    k = k + 1
  }
  c_fs_unlock(gc_lk)
  Err("cannot create workspace stage directory in " + stage_root + ": 4096 names taken")
}

///|
/// Lazily removes orphaned `.pion_ws.<pid>.<seq>` stage directories (and
/// abandoned `.reaping.*` leftovers > 60s old) using `<stage_root>/.gc.lock` +
/// non-blocking `.lock` probing (safe across PID namespaces and containers):
/// fail-closed if `.gc.lock` cannot be acquired; stale directories are
/// atomically renamed to a private `.reaping.<pid>.<seq>` name under `.gc.lock`
/// and deleted after the root lock is released.
fn drv_cleanup_stale_ws_stages(world : World, stage_root : String) -> Unit {
  if !fs_is_dir(world, stage_root) {
    return
  }
  let gc_lk = c_fs_lock(drv_cpath(stage_root + "/.gc.lock"))
  if gc_lk < 0L {
    return
  }
  let now_ms = clock_now_ms(world)
  let entries = fs_list_dir(world, stage_root)
  let to_delete : Array[String] = []
  let pid_s = c_cli_getpid().to_string()
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name != ".gc.lock" {
      let entry_path = stage_root + "/" + name
      let mut stale = false
      if drv_starts_with(name, ".pion_ws.") {
        let lock_path = entry_path + "/.lock"
        if drv_is_regular_file(lock_path) {
          let lk = c_fs_trylock(drv_cpath(lock_path))
          if lk >= 0L {
            c_fs_unlock(lk)
            stale = true
          }
        } else {
          let mt = fs_mtime_ms(world, entry_path)
          if mt > 0L && now_ms - mt > 60000L {
            stale = true
          }
        }
      } else if drv_starts_with(name, ".reaping.") {
        let mt = fs_mtime_ms(world, entry_path)
        if mt > 0L && now_ms - mt > 60000L {
          stale = true
        }
      }
      if stale {
        let reap_path = stage_root + "/.reaping." + pid_s + "." + c_cli_next_seq().to_string()
        if fs_rename(world, entry_path, reap_path) {
          to_delete.push(reap_path)
        }
      }
    }
    i = i + 1
  }
  c_fs_unlock(gc_lk)
  let mut di = 0
  while di < to_delete.length() {
    let _ = drv_remove_tree_nofollow(world, to_delete[di])
    di = di + 1
  }
}

///|
/// Lazily writes immutable source snapshots for a single package `idx` into
/// `stage_dir` at most once per build, avoiding upfront I/O for cached or
/// in-process packages.
fn drv_ws_ensure_pkg_snapshot(
  world : World,
  stage_dir : String,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  snap_paths : Array[Array[String]],
  snap_written : Array[Bool],
  idx : Int,
) -> Result[Unit, String] {
  if snap_written[idx] {
    return Ok(())
  }
  let node = nodes[topo_order[idx]]
  let k_snaps : Array[String] = []
  let mut fi = 0
  while fi < node.sources.length() {
    let sp = stage_dir + "/s_" + idx.to_string() + "_" + fi.to_string() + ".pion"
    match fs_write(world, sp, node.sources[fi]) {
      Err(e) => return Err("failed to write workspace snapshot " + sp + ": " + e)
      Ok(_) => k_snaps.push(sp)
    }
    fi = fi + 1
  }
  snap_paths[idx] = k_snaps
  snap_written[idx] = true
  Ok(())
}

///|
fn drv_ws_write_pkg_spec(
  world : World,
  stage_dir : String,
  spec_path : String,
  is_wasm : Bool,
  release : Bool,
  is_entry : Bool,
  qbe_target : String,
  entry_symbol : String,
  no_main : Bool,
  j2_mask : Int,
  pkg_cwd : String,
  sig_path : String,
  stub_path : String,
  ssa_path : String,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  topo_dep_names : Array[String],
  stub_paths : Array[String],
  was_preexisting_hit : Array[Bool],
  snap_paths : Array[Array[String]],
  snap_written : Array[Bool],
  pkg_topo_idx : Int,
) -> Result[Unit, String] {
  let pkg_indices : Array[Int] = []
  let deps_t = trans_dep_topo[pkg_topo_idx]
  let mut di = 0
  while di < deps_t.length() {
    pkg_indices.push(deps_t[di])
    di = di + 1
  }
  pkg_indices.push(pkg_topo_idx)
  let mut si = 0
  while si < pkg_indices.length() {
    match drv_ws_ensure_pkg_snapshot(
      world,
      stage_dir,
      nodes,
      topo_order,
      snap_paths,
      snap_written,
      pkg_indices[si],
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    si = si + 1
  }
  let sb = StringBuilder()
  sb.write_string("MODE\t")
  sb.write_string(if is_wasm { "wasm" } else { "native" })
  sb.write_char('\n')
  sb.write_string("RELEASE\t")
  sb.write_string(if release { "1" } else { "0" })
  sb.write_char('\n')
  sb.write_string("IS_ENTRY\t")
  sb.write_string(if is_entry { "1" } else { "0" })
  sb.write_char('\n')
  sb.write_string("QBE_TARGET\t")
  sb.write_string(drv_ws_spec_escape(qbe_target))
  sb.write_char('\n')
  sb.write_string("ENTRY_SYMBOL\t")
  sb.write_string(drv_ws_spec_escape(entry_symbol))
  sb.write_char('\n')
  sb.write_string("NO_MAIN\t")
  sb.write_string(if no_main { "1" } else { "0" })
  sb.write_char('\n')
  sb.write_string("J2_MASK\t")
  sb.write_string(j2_mask.to_string())
  sb.write_char('\n')
  sb.write_string("PKG_CWD\t")
  sb.write_string(drv_ws_spec_escape(pkg_cwd))
  sb.write_char('\n')
  sb.write_string("SIG_PATH\t")
  sb.write_string(drv_ws_spec_escape(sig_path))
  sb.write_char('\n')
  sb.write_string("STUB_PATH\t")
  sb.write_string(drv_ws_spec_escape(stub_path))
  sb.write_char('\n')
  sb.write_string("SSA_PATH\t")
  sb.write_string(drv_ws_spec_escape(ssa_path))
  sb.write_char('\n')
  let mut ti = 0
  while ti < topo_dep_names.length() {
    sb.write_string("TOPO_NAME\t")
    sb.write_string(drv_ws_spec_escape(topo_dep_names[ti]))
    sb.write_char('\n')
    ti = ti + 1
  }
  let mut pi = 0
  while pi < pkg_indices.length() {
    let idx = pkg_indices[pi]
    let nd = nodes[topo_order[idx]]
    sb.write_string("PKG_BEGIN\n")
    sb.write_string("NAME\t")
    sb.write_string(drv_ws_spec_escape(nd.name))
    sb.write_char('\n')
    sb.write_string("PKG_ROOT\t")
    sb.write_string(drv_ws_spec_escape(drv_normalize_path(drv_abs_path(world, nd.dir))))
    sb.write_char('\n')
    sb.write_string("WAS_HIT\t")
    sb.write_string(if was_preexisting_hit[idx] { "1" } else { "0" })
    sb.write_char('\n')
    sb.write_string("STUB_FILE\t")
    sb.write_string(drv_ws_spec_escape(stub_paths[idx]))
    sb.write_char('\n')
    let mut dep_i = 0
    while dep_i < nd.deps.length() {
      let alias_name = if dep_i < nd.dep_aliases.length() {
        nd.dep_aliases[dep_i]
      } else {
        nd.deps[dep_i]
      }
      sb.write_string("DEP\t")
      sb.write_string(drv_ws_spec_escape(alias_name))
      sb.write_char('\t')
      sb.write_string(drv_ws_spec_escape(nd.deps[dep_i]))
      sb.write_char('\n')
      dep_i = dep_i + 1
    }
    let k_snaps = snap_paths[idx]
    let mut fi = 0
    while fi < nd.paths.length() && fi < k_snaps.length() {
      sb.write_string("FILE\t")
      sb.write_string(drv_ws_spec_escape(nd.paths[fi]))
      sb.write_char('\t')
      sb.write_string(drv_ws_spec_escape(k_snaps[fi]))
      sb.write_char('\n')
      fi = fi + 1
    }
    sb.write_string("PKG_END\n")
    pi = pi + 1
  }
  match fs_write(world, spec_path, sb.to_string()) {
    Err(e) => Err("failed to write worker spec " + spec_path + ": " + e)
    Ok(_) => Ok(())
  }
}

///|
fn drv_ws_write_worker_result(world : World, result_path : String, body : String) -> Bool {
  if result_path.length() == 0 {
    return false
  }
  drv_write_text_atomic(world, result_path, body)
}

///|
/// Internal worker entry (`pionc --internal-ws-pkg-worker ...`) compiling one
/// workspace package from immutable stage snapshots with `jobs = 1`, verifying
/// image content SHA-256 and parent liveness before publishing CAS artifacts.
fn drv_run_ws_pkg_worker(world : World, args : Array[String]) -> Int {
  let mut spec_path = ""
  let mut result_path = ""
  let mut expected_fp = ""
  let mut parent_pid : Int64 = 0L
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--spec" && i + 1 < args.length() {
      spec_path = args[i + 1]
      i = i + 2
    } else if a == "--result" && i + 1 < args.length() {
      result_path = args[i + 1]
      i = i + 2
    } else if a == "--expected-fp" && i + 1 < args.length() {
      expected_fp = args[i + 1]
      i = i + 2
    } else if a == "--parent-pid" && i + 1 < args.length() {
      parent_pid = drv_parse_pos_int64(args[i + 1], 0L)
      i = i + 2
    } else {
      i = i + 1
    }
  }
  if parent_pid > 0L && c_cli_watch_parent(parent_pid) < 0 {
    return 86
  }
  let my_fp = drv_self_image_id()
  if expected_fp.length() == 0 || my_fp.length() == 0 || my_fp != expected_fp {
    return 86
  }
  if spec_path.length() == 0 || result_path.length() == 0 {
    return 2
  }
  let spec_txt = match fs_read(world, spec_path) {
    Ok(t) => t
    Err(e) => {
      let _ = drv_ws_write_worker_result(world, result_path, "ERR\nfailed to read spec: " + e)
      return 2
    }
  }
  let mut is_wasm = false
  let mut release = false
  let mut is_entry = false
  let mut qbe_target = ""
  let mut entry_symbol = "main"
  let mut no_main = false
  let mut j2_mask = 0
  let mut pkg_cwd = ""
  let mut sig_path = ""
  let mut stub_path = ""
  let mut ssa_path = ""
  let topo_dep_names : Array[String] = []
  let nodes : Array[PkgNodeInput] = []
  let stub_paths : Array[String] = []
  let was_preexisting_hit : Array[Bool] = []

  let mut in_pkg = false
  let mut cur_name = ""
  let mut cur_root = ""
  let mut cur_hit = false
  let mut cur_stub = ""
  let mut cur_deps : Array[String] = []
  let mut cur_aliases : Array[String] = []
  let mut cur_paths : Array[String] = []
  let mut cur_sources : Array[String] = []

  let lines = drv_split_lines(spec_txt)
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    if line.length() == 0 {
      li = li + 1
      continue
    }
    let parts = drv_ws_split_tab(line)
    let tag = parts[0]
    if !in_pkg {
      if tag == "MODE" && parts.length() >= 2 {
        is_wasm = parts[1] == "wasm"
      } else if tag == "RELEASE" && parts.length() >= 2 {
        release = parts[1] == "1"
      } else if tag == "IS_ENTRY" && parts.length() >= 2 {
        is_entry = parts[1] == "1"
      } else if tag == "QBE_TARGET" && parts.length() >= 2 {
        qbe_target = drv_ws_spec_unescape(parts[1])
      } else if tag == "ENTRY_SYMBOL" && parts.length() >= 2 {
        entry_symbol = drv_ws_spec_unescape(parts[1])
      } else if tag == "NO_MAIN" && parts.length() >= 2 {
        no_main = parts[1] == "1"
      } else if tag == "J2_MASK" && parts.length() >= 2 {
        j2_mask = drv_parse_nonneg_int64(parts[1], 0L).to_int()
      } else if tag == "PKG_CWD" && parts.length() >= 2 {
        pkg_cwd = drv_ws_spec_unescape(parts[1])
      } else if tag == "SIG_PATH" && parts.length() >= 2 {
        sig_path = drv_ws_spec_unescape(parts[1])
      } else if tag == "STUB_PATH" && parts.length() >= 2 {
        stub_path = drv_ws_spec_unescape(parts[1])
      } else if tag == "SSA_PATH" && parts.length() >= 2 {
        ssa_path = drv_ws_spec_unescape(parts[1])
      } else if tag == "TOPO_NAME" && parts.length() >= 2 {
        topo_dep_names.push(drv_ws_spec_unescape(parts[1]))
      } else if tag == "PKG_BEGIN" {
        in_pkg = true
        cur_name = ""
        cur_root = ""
        cur_hit = false
        cur_stub = ""
        cur_deps = []
        cur_aliases = []
        cur_paths = []
        cur_sources = []
      }
    } else if tag == "NAME" && parts.length() >= 2 {
      cur_name = drv_ws_spec_unescape(parts[1])
    } else if tag == "PKG_ROOT" && parts.length() >= 2 {
      cur_root = drv_ws_spec_unescape(parts[1])
    } else if tag == "WAS_HIT" && parts.length() >= 2 {
      cur_hit = parts[1] == "1"
    } else if tag == "STUB_FILE" && parts.length() >= 2 {
      cur_stub = drv_ws_spec_unescape(parts[1])
    } else if tag == "DEP" && parts.length() >= 3 {
      cur_aliases.push(drv_ws_spec_unescape(parts[1]))
      cur_deps.push(drv_ws_spec_unescape(parts[2]))
    } else if tag == "FILE" && parts.length() >= 3 {
      let lpath = drv_ws_spec_unescape(parts[1])
      let spath = drv_ws_spec_unescape(parts[2])
      match fs_read(world, spath) {
        Ok(src) => {
          cur_paths.push(lpath)
          cur_sources.push(src)
        }
        Err(e) => {
          let _ = drv_ws_write_worker_result(
            world,
            result_path,
            "ERR\nfailed to read snapshot " + spath + ": " + e,
          )
          return 2
        }
      }
    } else if tag == "PKG_END" {
      let base_node = pkg_node_input_new(cur_name, cur_root, cur_deps, cur_paths, cur_sources)
      nodes.push(PkgNodeInput::{ ..base_node, dep_aliases: cur_aliases })
      stub_paths.push(cur_stub)
      was_preexisting_hit.push(cur_hit)
      in_pkg = false
    }
    li = li + 1
  }

  let m = nodes.length()
  if m == 0 {
    let _ = drv_ws_write_worker_result(world, result_path, "ERR\nempty worker spec")
    return 2
  }
  let order : Array[Int] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let mut idx = 0
  while idx < m {
    order.push(idx)
    loaded_imported.push(None)
    idx = idx + 1
  }
  let trans = drv_trans_deps(nodes, order)
  let target_idx = m - 1
  let node = nodes[target_idx]
  let k_imports = drv_ensure_ws_imports_mode(
    world,
    nodes,
    order,
    trans.topo,
    stub_paths,
    was_preexisting_hit,
    loaded_imported,
    target_idx,
    pkg_cwd,
  )
  let cr = check_source_files_with_imports_mapped(
    node.name,
    node.paths,
    node.sources,
    k_imports,
    node.dep_aliases,
    node.deps,
    true,
    false,
  )
  if cr.diagnostics.length() > 0 {
    let _ = drv_ws_write_worker_result(
      world,
      result_path,
      "DIAG\n" + check_result_to_json(cr.diagnostics),
    )
    return 1
  }
  cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
  cr.tc.pkg_cwd = pkg_cwd
  let pionsig = emit_pionsig(cr.pkg)
  let pionstub = emit_pion_stub(cr.pkg)
  let final_ssa = if is_wasm {
    let res = emit_qbe_package_multi_entry_target_opts(
      cr.pkg,
      cr.tc,
      release,
      is_entry,
      topo_dep_names,
      true,
      "wasm32",
      "main",
      false,
      j2_mask,
    )
    let ns_prefix = "p_" + drv_wasm_ns_ident(node.name) + "__"
    wasm_namespace_local_ssa(res.ssa, ns_prefix)
  } else {
    let res = emit_qbe_package_multi_entry_target_opts(
      cr.pkg,
      cr.tc,
      release,
      is_entry,
      topo_dep_names,
      false,
      qbe_target,
      entry_symbol,
      no_main,
      j2_mask,
    )
    if release {
      inline_native_rc_ssa_opts(res.ssa, j2_mask)
    } else {
      // Worker always uses jobs = 1 to avoid N x 16 thread oversubscription.
      drv_cleanup_ssa(world, res.ssa, j2_mask, 1)
    }
  }

  // Deterministic pre-publish barrier hook for parent-kill E2E tests (FIFO, zero sleep).
  let barrier_dir = drv_env_str(world, "PION_TEST_WS_PRE_PUBLISH_BARRIER")
  if barrier_dir.length() > 0 {
    let pid_s = c_cli_getpid().to_string()
    let _ = fs_append(world, barrier_dir + "/ready.fifo", pid_s + "\n")
    let _ = fs_read(world, barrier_dir + "/release.fifo")
  }

  if parent_pid > 0L && c_cli_is_windows() == 0 && c_cli_getppid() != parent_pid {
    return 1
  }
  if !drv_write_cas_text_atomic(world, sig_path, pionsig) {
    let _ = drv_ws_write_worker_result(
      world,
      result_path,
      "ERR\nfailed to write CAS sig: " + sig_path,
    )
    return 2
  }
  if !drv_write_cas_text_atomic(world, stub_path, pionstub) {
    let _ = drv_ws_write_worker_result(
      world,
      result_path,
      "ERR\nfailed to write CAS stub: " + stub_path,
    )
    return 2
  }
  if !drv_write_cas_text_atomic(world, ssa_path, final_ssa) {
    let _ = drv_ws_write_worker_result(
      world,
      result_path,
      "ERR\nfailed to write CAS ssa: " + ssa_path,
    )
    return 2
  }
  if !drv_ws_write_worker_result(world, result_path, "OK\n") {
    return 2
  }
  0
}

///|
struct DrvWsDagOut {
  pkg_keys : Array[String]
  pkg_was_miss : Array[Bool]
  pkg_ssa_paths : Array[String]
  pkg_ssa_mem : Array[String]
  pkg_obj_paths : Array[String]
  pkg_sig_paths : Array[String]
  pkg_stub_paths : Array[String]
  pkg_entry_sizes : Array[Int64]
  root_checked : Option[CheckedPackage]
}

///|
fn drv_ws_insert_sorted(arr : Array[Int], v : Int) -> Unit {
  arr.push(v)
  let mut i = arr.length() - 1
  while i > 0 && arr[i] < arr[i - 1] {
    let tmp = arr[i - 1]
    arr[i - 1] = arr[i]
    arr[i] = tmp
    i = i - 1
  }
}

///|
fn drv_ws_pop_front(arr : Array[Int]) -> Int {
  let v = arr[0]
  let mut i = 1
  while i < arr.length() {
    arr[i - 1] = arr[i]
    i = i + 1
  }
  let _ = arr.pop()
  v
}

///|
fn drv_ws_remove_at(arr : Array[Int], pos : Int) -> Int {
  let v = arr[pos]
  let mut i = pos + 1
  while i < arr.length() {
    arr[i - 1] = arr[i]
    i = i + 1
  }
  let _ = arr.pop()
  v
}

///|
fn drv_ws_pkg_source_bytes(node : PkgNodeInput) -> Int64 {
  let mut total : Int64 = 0L
  let mut i = 0
  while i < node.sources.length() {
    total = total + node.sources[i].length().to_int64()
    i = i + 1
  }
  total
}

///|
fn drv_ws_min_pkg_bytes(world : World) -> Int64 {
  let env_min = drv_env_str(world, "PION_WS_PAR_MIN_PKG_BYTES")
  if env_min.length() > 0 {
    drv_parse_nonneg_int64(env_min, 65536L)
  } else {
    65536L
  }
}

///|
fn drv_ws_should_fallback_parent(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  was_preexisting_hit : Array[Bool],
  pkg_topo_idx : Int,
) -> Bool {
  let deps = trans_dep_topo[pkg_topo_idx]
  let mut miss_anc_bytes : Int64 = 0L
  let mut i = 0
  while i < deps.length() {
    let u = deps[i]
    if !was_preexisting_hit[u] {
      miss_anc_bytes = miss_anc_bytes + drv_ws_pkg_source_bytes(nodes[topo_order[u]])
    }
    i = i + 1
  }
  if miss_anc_bytes == 0L {
    return false
  }
  let env_cap = drv_env_str(world, "PION_WS_PAR_MAX_ANC_BYTES")
  if env_cap.length() > 0 {
    let cap = drv_parse_nonneg_int64(env_cap, 65536L)
    return miss_anc_bytes > cap
  }
  let self_bytes = drv_ws_pkg_source_bytes(nodes[topo_order[pkg_topo_idx]])
  miss_anc_bytes > 65536L && miss_anc_bytes > self_bytes
}

///|
fn drv_ws_pkg_worth_worker(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  was_preexisting_hit : Array[Bool],
  min_pkg_bytes : Int64,
  pkg_topo_idx : Int,
) -> Bool {
  let self_bytes = drv_ws_pkg_source_bytes(nodes[topo_order[pkg_topo_idx]])
  if self_bytes < min_pkg_bytes {
    return false
  }
  !drv_ws_should_fallback_parent(
    world,
    nodes,
    topo_order,
    trans_dep_topo,
    was_preexisting_hit,
    pkg_topo_idx,
  )
}

///|
/// Authoritative parent-scheduled workspace DAG compiler (shared by Native and
/// Wasm32). Dispatches worker processes only when >= 2 MISS packages are ready
/// simultaneously and `eff_jobs > 1`, preserving P96 Case 6 parity, exact
/// topological error arbitration, and atomic CAS publishing.
fn drv_ws_run_dag(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans : DrvTrans,
  cache_dir : String,
  is_wasm : Bool,
  release : Bool,
  include_entry : Bool,
  qbe_target : String,
  entry_symbol : String,
  no_main : Bool,
  compiler_fp : String,
  jobs : Int,
  trace_cas : Bool,
  pin : DrvCasPinSession,
) -> Result[DrvWsDagOut, String] {
  let stage_root = cache_dir + "/ws_stage"
  drv_cleanup_stale_ws_stages(world, stage_root)

  let n = topo_order.length()
  let trans_dep_topo = trans.topo
  let trans_dep_names = trans.names
  let pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
  let j2_mask = drv_j2_disable_mask(world)

  // Build direct dependency adjacency and in-degrees in topo index space.
  let name_to_topo : Map[String, Int] = Map([])
  let mut k = 0
  while k < n {
    name_to_topo.set(nodes[topo_order[k]].name, k)
    k = k + 1
  }
  let in_deg : Array[Int] = []
  let dependents : Array[Array[Int]] = []
  k = 0
  while k < n {
    in_deg.push(0)
    dependents.push([])
    k = k + 1
  }
  k = 0
  while k < n {
    let node = nodes[topo_order[k]]
    let seen_dep : Map[Int, Bool] = Map([])
    let mut di = 0
    while di < node.deps.length() {
      match name_to_topo.get(node.deps[di]) {
        Some(didx) =>
          match seen_dep.get(didx) {
            Some(_) => ()
            None => {
              seen_dep.set(didx, true)
              in_deg[k] = in_deg[k] + 1
              dependents[didx].push(k)
            }
          }
        None => ()
      }
      di = di + 1
    }
    k = k + 1
  }

  let sig_hashes : Map[String, String] = Map([])
  let stub_hashes : Map[String, String] = Map([])
  let stub_paths : Array[String] = []
  let was_preexisting_hit : Array[Bool] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let pkg_keys : Array[String] = []
  let pkg_was_miss : Array[Bool] = []
  let pkg_ssa_paths : Array[String] = []
  let pkg_ssa_mem : Array[String] = []
  let pkg_obj_paths : Array[String] = []
  let pkg_sig_paths : Array[String] = []
  let pkg_entry_sizes : Array[Int64] = []
  let fail_diag : Array[String] = []
  let pkg_done : Array[Bool] = []
  let ready_queue : Array[Int] = []
  k = 0
  while k < n {
    stub_paths.push("")
    was_preexisting_hit.push(false)
    loaded_imported.push(None)
    pkg_keys.push("")
    pkg_was_miss.push(false)
    pkg_ssa_paths.push("")
    pkg_ssa_mem.push("")
    pkg_obj_paths.push("")
    pkg_sig_paths.push("")
    pkg_entry_sizes.push(0L)
    fail_diag.push("")
    pkg_done.push(false)
    if in_deg[k] == 0 {
      drv_ws_insert_sorted(ready_queue, k)
    }
    k = k + 1
  }

  let eff_jobs = if jobs > 0 { jobs } else { drv_default_jobs(world) }
  let host_cpus = c_cli_cpu_count()
  let raw_workers = if eff_jobs < host_cpus { eff_jobs } else { host_cpus }
  let max_workers = if raw_workers > 64 { 64 } else { raw_workers }
  let self_exe = if max_workers > 1 { drv_os_self_exe_path() } else { "" }
  let mut can_spawn = max_workers > 1 &&
    self_exe.length() > 0 &&
    drv_is_regular_file(self_exe) &&
    c_cli_can_reap_children() != 0
  if can_spawn && c_cli_is_windows() != 0 {
    if !drv_is_ascii_str(self_exe) || !drv_is_ascii_str(cache_dir) {
      can_spawn = false
    }
  }
  let min_pkg_bytes = drv_ws_min_pkg_bytes(world)

  let mut root_checked : Option[CheckedPackage] = None
  let mut min_fail_idx = n
  let ready_miss : Array[Int] = []
  let mut stage_dir = ""
  let mut stage_lock_fd : Int64 = -1L
  let snap_paths : Array[Array[String]] = []
  let snap_written : Array[Bool] = []
  k = 0
  while k < n {
    snap_paths.push([])
    snap_written.push(false)
    k = k + 1
  }

  let compute_pkg_key = fn(idx : Int) -> String {
    let node = nodes[topo_order[idx]]
    let is_entry = idx == n - 1
    let upstream_sigs : Array[String] = []
    let t_names = trans_dep_names[idx]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      let stub_h = match stub_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh + ":" + stub_h)
      u = u + 1
    }
    drv_append_dep_alias_sigs(upstream_sigs, node)
    let target_key = if is_wasm {
      let t_topo_names = trans.topo_names[idx]
      if is_entry {
        "wasm32_entry:" + drv_join_comma(t_topo_names)
      } else if t_topo_names.length() > 0 {
        "wasm32:" + drv_join_comma(t_topo_names)
      } else {
        "wasm32"
      }
    } else {
      if is_entry {
        if no_main {
          upstream_sigs.push("__pion_entry__:no_main")
        } else if entry_symbol.length() > 0 && entry_symbol != "main" {
          upstream_sigs.push("__pion_entry__:" + entry_symbol)
        }
      }
      qbe_target
    }
    cas_compute_key(
      node.name,
      drv_cas_rel_paths(node),
      node.sources,
      upstream_sigs,
      target_key,
      release,
      compiler_fp,
    )
  }

  let unlock_dependents = fn(idx : Int) -> Unit {
    pkg_done[idx] = true
    let deps_of = dependents[idx]
    let mut di = 0
    while di < deps_of.length() {
      let child = deps_of[di]
      in_deg[child] = in_deg[child] - 1
      if in_deg[child] == 0 {
        drv_ws_insert_sorted(ready_queue, child)
      }
      di = di + 1
    }
  }

  let drain_ready = fn() -> Unit {
    while ready_queue.length() > 0 {
      let idx = drv_ws_pop_front(ready_queue)
      if idx >= min_fail_idx {
        continue
      }
      let node = nodes[topo_order[idx]]
      let is_entry = idx == n - 1
      if !is_wasm && is_entry && !include_entry {
        let k_imports = drv_ensure_ws_imports_mode(
          world,
          nodes,
          topo_order,
          trans_dep_topo,
          stub_paths,
          was_preexisting_hit,
          loaded_imported,
          idx,
          pkg_cwd,
        )
        let cr = check_source_files_with_imports_mapped(
          node.name,
          node.paths,
          node.sources,
          k_imports,
          node.dep_aliases,
          node.deps,
          true,
          false,
        )
        if cr.diagnostics.length() > 0 {
          if idx < min_fail_idx {
            min_fail_idx = idx
          }
          fail_diag[idx] = check_result_to_json(cr.diagnostics)
        } else {
          cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
          cr.tc.pkg_cwd = pkg_cwd
          root_checked = Some(cr)
          unlock_dependents(idx)
        }
        continue
      }
      let key = compute_pkg_key(idx)
      pkg_keys[idx] = key
      let obj_path = cache_dir + "/obj/" + key + ".o"
      let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
      let sig_path = cache_dir + "/sig/" + key + ".pionsig"
      let stub_path = cache_dir + "/sig/" + key + ".pionstub"
      pkg_obj_paths[idx] = obj_path
      pkg_ssa_paths[idx] = ssa_path
      pkg_sig_paths[idx] = sig_path
      let mut cas_hit = false
      let primary_path = if is_wasm { ssa_path } else { obj_path }
      let primary_ok = drv_is_nonempty_regular_file(world, primary_path)
      if primary_ok &&
        drv_is_regular_file(sig_path) &&
        drv_is_regular_file(stub_path) &&
        drv_cas_pin_and_verify(world, cache_dir, pin, [key], [primary_path]) {
        match (fs_read(world, sig_path), fs_read(world, stub_path)) {
          (Ok(sig_text), Ok(stub_text)) => {
            sig_hashes.set(node.name, drv_effective_sig_hash(sig_text, node, sig_hashes))
            stub_hashes.set(node.name, drv_stub_hash(stub_text, node.sources))
            stub_paths[idx] = stub_path
            was_preexisting_hit[idx] = true
            cas_hit = true
            if trace_cas {
              let tag = if is_wasm { "[cas-wasm]" } else { "[cas]" }
              io_eprintln(
                world,
                tag + " pkg=" + node.declared_name + " HIT key=" + drv_prefix16(key),
              )
            }
          }
          _ => ()
        }
      }
      if cas_hit {
        unlock_dependents(idx)
      } else {
        if trace_cas {
          let tag = if is_wasm { "[cas-wasm]" } else { "[cas]" }
          io_eprintln(
            world,
            tag + " pkg=" + node.declared_name + " MISS key=" + drv_prefix16(key),
          )
        }
        drv_ws_insert_sorted(ready_miss, idx)
      }
    }
  }

  let compile_in_proc = fn(idx : Int) -> Unit {
    if idx >= min_fail_idx {
      return
    }
    let node = nodes[topo_order[idx]]
    let is_entry = idx == n - 1
    let key = pkg_keys[idx]
    let ssa_path = pkg_ssa_paths[idx]
    let sig_path = pkg_sig_paths[idx]
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"
    let k_imports = drv_ensure_ws_imports_mode(
      world,
      nodes,
      topo_order,
      trans_dep_topo,
      stub_paths,
      was_preexisting_hit,
      loaded_imported,
      idx,
      pkg_cwd,
    )
    let cr = check_source_files_with_imports_mapped(
      node.name,
      node.paths,
      node.sources,
      k_imports,
      node.dep_aliases,
      node.deps,
      true,
      false,
    )
    if cr.diagnostics.length() > 0 {
      if idx < min_fail_idx {
        min_fail_idx = idx
      }
      fail_diag[idx] = check_result_to_json(cr.diagnostics)
      return
    }
    cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
    cr.tc.pkg_cwd = pkg_cwd
    loaded_imported[idx] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
    let pionsig = emit_pionsig(cr.pkg)
    sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
    let pionstub = emit_pion_stub(cr.pkg)
    stub_hashes.set(node.name, drv_stub_hash(pionstub, node.sources))
    let final_ssa = if is_wasm {
      let res = emit_qbe_package_multi_entry_target_opts(
        cr.pkg,
        cr.tc,
        release,
        is_entry,
        trans.topo_names[idx],
        true,
        "wasm32",
        "main",
        false,
        j2_mask,
      )
      let ns_prefix = "p_" + drv_wasm_ns_ident(node.name) + "__"
      wasm_namespace_local_ssa(res.ssa, ns_prefix)
    } else {
      let res = emit_qbe_package_multi_entry_target_opts(
        cr.pkg,
        cr.tc,
        release,
        is_entry,
        trans.topo_names[idx],
        false,
        qbe_target,
        entry_symbol,
        no_main,
        j2_mask,
      )
      if release {
        inline_native_rc_ssa_opts(res.ssa, j2_mask)
      } else {
        // Keep parent process in ST biased-RC mode (spawning threads here would
        // permanently flip the parent into atomic RC for all remaining packages).
        drv_cleanup_ssa(world, res.ssa, j2_mask, 1)
      }
    }
    if !drv_write_cas_text_atomic(world, sig_path, pionsig) {
      if idx < min_fail_idx {
        min_fail_idx = idx
      }
      fail_diag[idx] = "failed to write CAS sig: " + sig_path
      return
    }
    if !drv_write_cas_text_atomic(world, stub_path, pionstub) {
      if idx < min_fail_idx {
        min_fail_idx = idx
      }
      fail_diag[idx] = "failed to write CAS stub: " + stub_path
      return
    }
    if !drv_write_cas_text_atomic(world, ssa_path, final_ssa) {
      if idx < min_fail_idx {
        min_fail_idx = idx
      }
      fail_diag[idx] = "failed to write CAS ssa: " + ssa_path
      return
    }
    stub_paths[idx] = stub_path
    pkg_was_miss[idx] = true
    if is_wasm {
      pkg_ssa_mem[idx] = final_ssa
      let sig_sz = fs_size(world, sig_path)
      let stub_sz = fs_size(world, stub_path)
      let ssa_sz = fs_size(world, ssa_path)
      pkg_entry_sizes[idx] = (if sig_sz > 0L { sig_sz } else { 0L }) +
        (if stub_sz > 0L { stub_sz } else { 0L }) +
        (if ssa_sz > 0L { ssa_sz } else { 0L })
    }
    unlock_dependents(idx)
  }

  let count_worth_ready = fn() -> Int {
    let mut cnt = 0
    let mut ri = 0
    while ri < ready_miss.length() {
      let ridx = ready_miss[ri]
      if ridx < min_fail_idx &&
        drv_ws_pkg_worth_worker(
          world,
          nodes,
          topo_order,
          trans_dep_topo,
          was_preexisting_hit,
          min_pkg_bytes,
          ridx,
        ) {
        cnt = cnt + 1
      }
      ri = ri + 1
    }
    cnt
  }

  // Serial fast-loop until >= 2 worker-worthy MISS packages are simultaneously ready.
  let mut enter_parallel = false
  while true {
    drain_ready()
    while ready_miss.length() > 0 && ready_miss[ready_miss.length() - 1] >= min_fail_idx {
      let _ = ready_miss.pop()
    }
    if ready_miss.length() == 0 {
      break
    }
    if !can_spawn || count_worth_ready() < 2 {
      let idx = drv_ws_pop_front(ready_miss)
      compile_in_proc(idx)
    } else {
      enter_parallel = true
      break
    }
  }

  if enter_parallel {
    // Obtain zero-I/O in-memory image identity lazily only when entering parallel mode.
    let self_id = drv_self_image_id()
    if self_id.length() == 0 {
      can_spawn = false
    } else {
      match drv_make_ws_stage(world, stage_root) {
        Err(_) => {
          can_spawn = false
        }
        Ok(sh) => {
          stage_dir = sh.dir
          stage_lock_fd = sh.lock_fd
        }
      }
    }
    if can_spawn {
      let nw = max_workers
      let my_pid_str = c_cli_getpid().to_string()
      let exe_for_workers = self_exe
      let fp_for_workers = self_id
      let inflight_handles : Array[Int64] = []
      let inflight_idxs : Array[Int] = []
      let mut in_flight = 0
      while true {
        drain_ready()
        while ready_miss.length() > 0 && ready_miss[ready_miss.length() - 1] >= min_fail_idx {
          let _ = ready_miss.pop()
        }
        if in_flight == 0 && ready_miss.length() == 0 {
          break
        }
        if in_flight == 0 && (!can_spawn || count_worth_ready() < 2) {
          let idx = drv_ws_pop_front(ready_miss)
          compile_in_proc(idx)
          continue
        }
        while can_spawn && in_flight < nw && ready_miss.length() > 0 {
          let mut pick_pos = -1
          let mut ri = 0
          while ri < ready_miss.length() {
            let cand = ready_miss[ri]
            if cand < min_fail_idx &&
              drv_ws_pkg_worth_worker(
                world,
                nodes,
                topo_order,
                trans_dep_topo,
                was_preexisting_hit,
                min_pkg_bytes,
                cand,
              ) {
              pick_pos = ri
              break
            }
            ri = ri + 1
          }
          if pick_pos < 0 {
            break
          }
          let idx = drv_ws_remove_at(ready_miss, pick_pos)
          let is_entry = idx == n - 1
          let key = pkg_keys[idx]
          let sig_path = pkg_sig_paths[idx]
          let stub_path = cache_dir + "/sig/" + key + ".pionstub"
          let ssa_path = pkg_ssa_paths[idx]
          let spec_path = stage_dir + "/spec_" + idx.to_string() + ".txt"
          let res_path = stage_dir + "/res_" + idx.to_string() + ".txt"
          match drv_ws_write_pkg_spec(
            world,
            stage_dir,
            spec_path,
            is_wasm,
            release,
            is_entry,
            qbe_target,
            entry_symbol,
            no_main,
            j2_mask,
            pkg_cwd,
            sig_path,
            stub_path,
            ssa_path,
            nodes,
            topo_order,
            trans_dep_topo,
            trans.topo_names[idx],
            stub_paths,
            was_preexisting_hit,
            snap_paths,
            snap_written,
            idx,
          ) {
            Err(_) => {
              can_spawn = false
              drv_ws_insert_sorted(ready_miss, idx)
              break
            }
            Ok(_) => {
              let h = drv_spawn_ws_worker(
                exe_for_workers,
                spec_path,
                res_path,
                fp_for_workers,
                my_pid_str,
              )
              if h <= 0L {
                can_spawn = false
                drv_ws_insert_sorted(ready_miss, idx)
                break
              }
              inflight_handles.push(h)
              inflight_idxs.push(idx)
              in_flight = in_flight + 1
            }
          }
        }
        if in_flight == 0 {
          continue
        }
        // If only small/fallback packages remain in ready_miss while workers are busy,
        // compile one in-process on the main thread (staying in ST biased-RC mode).
        if ready_miss.length() > 0 && ready_miss[0] < min_fail_idx {
          let cand = ready_miss[0]
          if !drv_ws_pkg_worth_worker(
            world,
            nodes,
            topo_order,
            trans_dep_topo,
            was_preexisting_hit,
            min_pkg_bytes,
            cand,
          ) {
            let idx = drv_ws_pop_front(ready_miss)
            compile_in_proc(idx)
            continue
          }
        }
        let done_h = c_cli_wait_any_ws_worker()
        if done_h <= 0L {
          // Wait failure (e.g. ECHILD under SIGCHLD=SIG_IGN): never silently return
          // an incomplete DAG; disable spawning and re-queue all in-flight packages.
          can_spawn = false
          let mut ri = 0
          while ri < inflight_idxs.length() {
            let ridx = inflight_idxs[ri]
            if ridx >= 0 && ridx < n && ridx < min_fail_idx {
              drv_ws_insert_sorted(ready_miss, ridx)
            }
            ri = ri + 1
          }
          while inflight_handles.length() > 0 {
            let _ = inflight_handles.pop()
            let _ = inflight_idxs.pop()
          }
          in_flight = 0
          continue
        }
        let rc = c_cli_last_ws_worker_rc()
        let mut found_pos = -1
        let mut fi = 0
        while fi < inflight_handles.length() {
          if inflight_handles[fi] == done_h {
            found_pos = fi
            break
          }
          fi = fi + 1
        }
        if found_pos < 0 {
          continue
        }
        let idx = inflight_idxs[found_pos]
        let last_pos = inflight_handles.length() - 1
        inflight_handles[found_pos] = inflight_handles[last_pos]
        inflight_idxs[found_pos] = inflight_idxs[last_pos]
        let _ = inflight_handles.pop()
        let _ = inflight_idxs.pop()
        in_flight = in_flight - 1
        if idx < 0 || idx >= n {
          continue
        }
        let res_path = stage_dir + "/res_" + idx.to_string() + ".txt"
        if rc == 86 {
          // Image identity mismatch or watch_parent failure: degrade deterministically to serial.
          can_spawn = false
          if idx < min_fail_idx {
            drv_ws_insert_sorted(ready_miss, idx)
          }
          continue
        }
        let node = nodes[topo_order[idx]]
        let key = pkg_keys[idx]
        let sig_path = pkg_sig_paths[idx]
        let stub_path = cache_dir + "/sig/" + key + ".pionstub"
        let ssa_path = pkg_ssa_paths[idx]
        if rc == 0 {
          let res_ok = match fs_read(world, res_path) {
            Ok(t) => drv_starts_with(t, "OK")
            Err(_) => false
          }
          let mut accepted = false
          if res_ok {
            match (fs_read(world, sig_path), fs_read(world, stub_path)) {
              (Ok(sig_text), Ok(stub_text)) =>
                if is_wasm {
                  match fs_read(world, ssa_path) {
                    Ok(ssa_text) => {
                      pkg_ssa_mem[idx] = ssa_text
                      let sig_sz = fs_size(world, sig_path)
                      let stub_sz = fs_size(world, stub_path)
                      let ssa_sz = fs_size(world, ssa_path)
                      pkg_entry_sizes[idx] = (if sig_sz > 0L { sig_sz } else { 0L }) +
                        (if stub_sz > 0L { stub_sz } else { 0L }) +
                        (if ssa_sz > 0L { ssa_sz } else { 0L })
                      sig_hashes.set(
                        node.name,
                        drv_effective_sig_hash(sig_text, node, sig_hashes),
                      )
                      stub_hashes.set(node.name, drv_stub_hash(stub_text, node.sources))
                      stub_paths[idx] = stub_path
                      was_preexisting_hit[idx] = false
                      pkg_was_miss[idx] = true
                      accepted = true
                      unlock_dependents(idx)
                    }
                    Err(_) => ()
                  }
                } else {
                  sig_hashes.set(
                    node.name,
                    drv_effective_sig_hash(sig_text, node, sig_hashes),
                  )
                  stub_hashes.set(node.name, drv_stub_hash(stub_text, node.sources))
                  stub_paths[idx] = stub_path
                  was_preexisting_hit[idx] = false
                  pkg_was_miss[idx] = true
                  accepted = true
                  unlock_dependents(idx)
                }
              _ => ()
            }
          }
          if !accepted {
            // Worker did not produce a valid OK + readable CAS artifacts: fall back deterministically.
            can_spawn = false
            if idx < min_fail_idx {
              drv_ws_insert_sorted(ready_miss, idx)
            }
          }
        } else {
          let mut handled_diag_or_err = false
          match fs_read(world, res_path) {
            Ok(res_txt) =>
              if drv_starts_with(res_txt, "DIAG\n") {
                if idx < min_fail_idx {
                  min_fail_idx = idx
                }
                fail_diag[idx] = slice_str(res_txt, 5, res_txt.length())
                handled_diag_or_err = true
              } else if drv_starts_with(res_txt, "ERR\n") {
                if idx < min_fail_idx {
                  min_fail_idx = idx
                }
                fail_diag[idx] = slice_str(res_txt, 4, res_txt.length())
                handled_diag_or_err = true
              }
            Err(_) => ()
          }
          if !handled_diag_or_err {
            // Any abnormal worker exit without a valid DIAG/ERR result (SIGKILL,
            // replaced binary, spawn failure) degrades deterministically to parent.
            can_spawn = false
            if idx < min_fail_idx {
              drv_ws_insert_sorted(ready_miss, idx)
            }
          }
        }
      }
      while in_flight > 0 {
        if c_cli_wait_any_ws_worker() <= 0L {
          break
        }
        in_flight = in_flight - 1
      }
    } else {
      // Fallback if stage creation or image identity failed.
      while true {
        drain_ready()
        while ready_miss.length() > 0 && ready_miss[ready_miss.length() - 1] >= min_fail_idx {
          let _ = ready_miss.pop()
        }
        if ready_miss.length() == 0 {
          break
        }
        let idx = drv_ws_pop_front(ready_miss)
        compile_in_proc(idx)
      }
    }
  }

  if stage_dir.length() > 0 {
    let gc_lk = c_fs_lock(drv_cpath(stage_root + "/.gc.lock"))
    if gc_lk < 0L {
      if stage_lock_fd >= 0L {
        c_fs_unlock(stage_lock_fd)
      }
    } else {
      if stage_lock_fd >= 0L {
        c_fs_unlock(stage_lock_fd)
      }
      let reap_path = stage_root +
        "/.reaping." +
        c_cli_getpid().to_string() +
        "." +
        c_cli_next_seq().to_string()
      let moved = fs_rename(world, stage_dir, reap_path)
      c_fs_unlock(gc_lk)
      if moved {
        let _ = drv_remove_tree_nofollow(world, reap_path)
      }
    }
  } else if stage_lock_fd >= 0L {
    c_fs_unlock(stage_lock_fd)
  }
  if min_fail_idx < n {
    return Err(fail_diag[min_fail_idx])
  }
  let mut chk = 0
  while chk < n {
    if !pkg_done[chk] {
      return Err(
        "internal error: workspace DAG did not complete package " +
        nodes[topo_order[chk]].declared_name,
      )
    }
    chk = chk + 1
  }
  Ok(DrvWsDagOut::{
    pkg_keys: pkg_keys,
    pkg_was_miss: pkg_was_miss,
    pkg_ssa_paths: pkg_ssa_paths,
    pkg_ssa_mem: pkg_ssa_mem,
    pkg_obj_paths: pkg_obj_paths,
    pkg_sig_paths: pkg_sig_paths,
    pkg_stub_paths: stub_paths,
    pkg_entry_sizes: pkg_entry_sizes,
    root_checked: root_checked,
  })
}

///|
fn drv_build_workspace_objects_entry(
  world : World,
  root_dir : String,
  release : Bool,
  include_entry : Bool,
  jobs : Int,
  target_override : String,
  sysroot : String,
  need_pic : Bool,
  root_tests : Bool,
  entry_symbol : String,
  no_main : Bool,
  locked : Bool,
  offline : Bool,
  pin : DrvCasPinSession,
) -> Result[DrvWsBuilt, String] {
  let ws = match drv_load_workspace_opts_target(
    world,
    root_dir,
    locked,
    offline,
    "",
    drv_pick_target(world, target_override),
  ) {
    Err(e) => return Err(e)
    Ok(v) => v
  }
  drv_build_nodes_objects_entry(
    world,
    ws.nodes,
    release,
    include_entry,
    jobs,
    target_override,
    sysroot,
    need_pic,
    root_tests,
    entry_symbol,
    no_main,
    pin,
  )
}

///| Cut only after complete ASCII lines at neutral QBE lexical state.
fn drv_cleanup_ssa(world : World, ssa : String, mask : Int, jobs : Int) -> String {
  let n = ssa.length()
  if jobs <= 1 || n < 1048576 || ssa.code_unit_at(n - 1) != 10 {
    return cleanup_native_rc_ssa_opts(ssa, mask)
  }
  if !ssa.contains("$pion_rc_inc") && !ssa.contains("$pion_rc_dec") { return ssa }
  let per_job = n / jobs
  let stride = if per_job > 1048576 { per_job } else { 1048576 }
  let cuts : Array[Int] = [0]
  let mut start = 0
  let mut i = 0
  let mut quoted = false
  let mut escaped = false
  let mut comment = false
  let mut depth = 0
  while i < n {
    let c = ssa.code_unit_at(i)
    if c >= 128 { return cleanup_native_rc_ssa_opts(ssa, mask) }
    if comment {
      if c == 10 { comment = false }
    } else if quoted {
      if escaped { escaped = false } else if c == 92 { escaped = true } else if c == 34 { quoted = false }
    } else if c == 34 {
      quoted = true
    } else if c == 35 {
      comment = true
    } else if c == 123 {
      depth = depth + 1
    } else if c == 125 && depth > 0 {
      depth = depth - 1
    }
    if c == 10 {
      if i - start == 1 && ssa.code_unit_at(start) == 125 &&
        !quoted && depth == 0 && cuts.length() < jobs &&
        i + 1 < n && i - cuts[cuts.length() - 1] >= stride {
        cuts.push(i + 1)
      }
      start = i + 1
    }
    i = i + 1
  }
  if cuts.length() == 1 { return cleanup_native_rc_ssa_opts(ssa, mask) }
  cuts.push(n)
  let replies : Array[Channel[String]] = []
  scope(world, fn(s : Scope) -> Unit {
    let mut k = 0
    while k + 1 < cuts.length() {
      let lo = cuts[k]
      let hi = cuts[k + 1]
      let reply : Channel[String] = Channel::new(1)
      replies.push(reply)
      spawn(s, fn() -> Unit {
        let chunk = ssa.slice(lo, hi)
        let _ = reply.send(cleanup_native_rc_ssa_opts(chunk, mask))
      })
      k = k + 1
    }
  })
  let out = StringBuilder()
  let mut k = 0
  while k < replies.length() {
    match replies[k].recv() {
      Some(text) => out.write_string(text)
      None => panic("missing unit cleanup result")
    }
    k = k + 1
  }
  out.to_string()
}

///|
/// Compiles CAS-missed `.ssa` units to `.o` (parallel `--obj-batch` on direct-object
/// targets, parallel qbe+as otherwise).
fn drv_compile_missed(
  world : World,
  qbe_bin : String,
  qbe_target : String,
  apple_tools : AppleTools,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  sysroot : String,
  miss_ssa_paths : Array[String],
  miss_obj_paths : Array[String],
  jobs : Int,
  quiet : Bool,
) -> Result[Unit, String] {
  let n_miss = miss_obj_paths.length()
  let eff_jobs = if jobs > 0 { jobs } else { drv_default_jobs(world) }
  if n_miss == 1 || (n_miss > 1 && !direct_obj && eff_jobs <= 1) {
    let stamp = drv_tmp_tag(world, "qbe_miss_seq")
    let mut mi = 0
    while mi < n_miss {
      match drv_compile_ssa_to_obj(
        world,
        qbe_bin,
        qbe_target,
        apple_tools,
        direct_obj,
        qbe_macos_ver,
        cc1as_triple,
        sysroot,
        miss_ssa_paths[mi],
        miss_obj_paths[mi],
        stamp + "_" + mi.to_string(),
        quiet,
      ) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      mi = mi + 1
    }
  } else if n_miss > 1 && direct_obj {
    let nw = if eff_jobs <= 1 {
      1
    } else if n_miss < eff_jobs {
      n_miss
    } else {
      eff_jobs
    }
    let stamp_base = drv_tmp_tag(world, "qbe_miss_batch")
    if nw == 1 {
      let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, true)
      let tmps : Array[String] = []
      let objs : Array[String] = []
      let mut mi = 0
      while mi < n_miss {
        let u_ssa = miss_ssa_paths[mi]
        let u_obj = miss_obj_paths[mi]
        let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
        argv.push(u_ssa)
        argv.push(u_tmp)
        tmps.push(u_tmp)
        objs.push(u_obj)
        mi = mi + 1
      }
      let rc_qbe = drv_exec_quiet(world, argv, quiet)
      if rc_qbe != 0 {
        drv_remove_files(world, tmps, 0)
        return Err("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
      }
      let pub_err = drv_publish_unit_objs(world, tmps, objs)
      if pub_err != "" {
        return Err(pub_err)
      }
    } else {
      let err_ch : Channel[String] = Channel::new(nw + 1)
      // Every batch's temporaries; the main thread publishes them below.
      let all_tmps : Array[String] = []
      let all_objs : Array[String] = []
      let qmv = qbe_macos_ver
      let qb = qbe_bin
      let qt = qbe_target
      scope(world, fn(s : Scope) -> Unit {
        let mut wi = 0
        while wi < nw {
          let start = drv_batch_start(wi, n_miss, nw)
          let end = drv_batch_start(wi + 1, n_miss, nw)
          let spec_sb = StringBuilder()
          let mut mi = start
          while mi < end {
            let u_ssa = miss_ssa_paths[mi]
            let u_obj = miss_obj_paths[mi]
            let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
            spec_sb.write_string(u_ssa)
            spec_sb.write_char('\n')
            spec_sb.write_string(u_tmp)
            spec_sb.write_char('\n')
            all_tmps.push(u_tmp)
            all_objs.push(u_obj)
            mi = mi + 1
          }
          let spec = spec_sb.to_string()
          spawn(s, fn() -> Unit {
            let lines = drv_split_lines(spec)
            let argv = drv_qbe_obj_argv(qb, qt, qmv, true)
            let mut li = 0
            while li + 1 < lines.length() {
              argv.push(lines[li])
              argv.push(lines[li + 1])
              li = li + 2
            }
            let rc_qbe = drv_exec_quiet(world, argv, quiet)
            if rc_qbe != 0 {
              let _ = err_ch.send(
                "qbe --obj-batch failed with exit code " + rc_qbe.to_string(),
              )
            }
          })
          wi = wi + 1
        }
      })
      // Every worker has exited: publish only when every batch succeeded.
      err_ch.close()
      match err_ch.recv() {
        Some(err_msg) => {
          drv_remove_files(world, all_tmps, 0)
          return Err(err_msg)
        }
        None => ()
      }
      let pub_err = drv_publish_unit_objs(world, all_tmps, all_objs)
      if pub_err != "" {
        return Err(pub_err)
      }
    }
  } else if n_miss > 1 {
    let qbe_arch = drv_target_qbe_arch(qbe_target)
    let qbe_seh = drv_win_seh(world, qbe_target)
    let use_cc1as = apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0
    let cc1as_bin = apple_tools.clang_bin
    let cc1as_tr = cc1as_triple
    let as_driver = drv_resolve_cc_driver(world, qbe_target, false)
    let as_flags_str = drv_join_char(drv_target_as_flags(world, qbe_target, sysroot, as_driver), "\n")
    let mut base = 0
    while base < n_miss {
      let mut batch = n_miss - base
      if batch > eff_jobs {
        batch = eff_jobs
      }
      let err_ch : Channel[String] = Channel::new(batch + 1)
      let stamp_base = drv_tmp_tag(world, "qbe_miss_asm_" + base.to_string())
      let batch_tmps : Array[String] = []
      let batch_objs : Array[String] = []
      scope(world, fn(s : Scope) -> Unit {
        let mut off = 0
        while off < batch {
          let mi = base + off
          let u_ssa = miss_ssa_paths[mi]
          let u_obj = miss_obj_paths[mi]
          let u_asm = u_obj + ".s." + stamp_base + "_" + mi.to_string()
          let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
          batch_tmps.push(u_tmp)
          batch_objs.push(u_obj)
          let qb = qbe_bin
          let qa = qbe_arch
          let qs = qbe_seh
          spawn(s, fn() -> Unit {
            let rc_qbe = drv_exec_quiet(world, drv_qbe_text_argv(qb, qa, qs, u_asm, u_ssa), quiet)
            if rc_qbe != 0 {
              let _ = fs_remove(u_asm)
              let _ = err_ch.send(
                "qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa,
              )
            } else {
              let rc_as = if use_cc1as {
                drv_exec_quiet(world, [
                  cc1as_bin,
                  "-cc1as",
                  "-triple",
                  cc1as_tr,
                  "-filetype",
                  "obj",
                  "-o",
                  u_tmp,
                  u_asm,
                ], quiet)
              } else {
                let argv : Array[String] = [as_driver]
                let fls = drv_split_lines(as_flags_str)
                let mut fi = 0
                while fi < fls.length() {
                  if fls[fi].length() > 0 {
                    argv.push(fls[fi])
                  }
                  fi = fi + 1
                }
                argv.push("-c")
                argv.push("-x")
                argv.push("assembler")
                argv.push("-o")
                argv.push(u_tmp)
                argv.push(u_asm)
                drv_exec_quiet(world, argv, quiet)
              }
              let _ = fs_remove(u_asm)
              if rc_as != 0 {
                let _ = fs_remove(u_tmp)
                let _ = err_ch.send(
                  "as failed with exit code " + rc_as.to_string() + " on " + u_asm,
                )
              }
            }
          })
          off = off + 1
        }
      })
      err_ch.close()
      match err_ch.recv() {
        Some(err_msg) => {
          drv_remove_files(world, batch_tmps, 0)
          return Err(err_msg)
        }
        None => ()
      }
      let pub_err = drv_publish_unit_objs(world, batch_tmps, batch_objs)
      if pub_err != "" {
        return Err(pub_err)
      }
      base = base + batch
    }
  }
  Ok(())
}

///|
/// Hash the `.pionstub` text for codegen CAS invalidation when cross-package
/// inlined function bodies change. Falls back to hashing package sources when
/// `emit_pion_stub` returned `""` (e.g. `pub` generic fn loaded from source).
fn drv_stub_hash(stub_text : String, sources : Array[String]) -> String {
  if stub_text.length() > 0 {
    sha256_hex(stub_text)
  } else {
    let sb = StringBuilder()
    let mut i = 0
    while i < sources.length() {
      sb.write_string(sources[i])
      sb.write_string("\n")
      i = i + 1
    }
    sha256_hex(sb.to_string())
  }
}

///|
fn drv_build_nodes_objects_entry(
  world : World,
  nodes : Array[PkgNodeInput],
  release : Bool,
  include_entry : Bool,
  jobs : Int,
  target_override : String,
  sysroot : String,
  need_pic : Bool,
  root_tests : Bool,
  entry_symbol : String,
  no_main : Bool,
  pin : DrvCasPinSession,
) -> Result[DrvWsBuilt, String] {
  if root_tests && nodes.length() > 0 {
    // The root package is pushed last by the DFS; it is never CAS-cached here.
    let rn = nodes[nodes.length() - 1]
    match drv_append_test_sources_for(
      world,
      rn.dir,
      rn.target_rules,
      drv_pick_target(world, target_override),
      rn.paths,
      rn.sources,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut i = 0
  while i < nodes.length() {
    names.push(nodes[i].name)
    dep_lists.push(nodes[i].deps)
    i = i + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return Err(check_result_to_json(topo.diagnostics))
  }

  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let _ = fs_mkdir_p(world, cache_dir + "/bin")

  let qbe_target = drv_pick_target(world, target_override)
  match drv_check_android_toolchain(world, qbe_target) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, false, pin) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib, qbe_target, sysroot)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"

  let n = topo.order.length()
  let trans = drv_trans_deps(nodes, topo.order)
  let dag = match drv_ws_run_dag(
    world,
    nodes,
    topo.order,
    trans,
    cache_dir,
    false,
    release,
    include_entry,
    qbe_target,
    entry_symbol,
    no_main,
    compiler_fp,
    jobs,
    trace_cas,
    pin,
  ) {
    Err(e) => return Err(e)
    Ok(v) => v
  }

  let obj_paths : Array[String] = []
  let dep_pkg_names : Array[String] = []
  let miss_ssa_paths : Array[String] = []
  let miss_obj_paths : Array[String] = []
  let miss_keys : Array[String] = []
  let root_checked : Option[CheckedPackage] = dag.root_checked
  let link_key_sb = StringBuilder()
  link_key_sb.write_string(compiler_fp)

  let mut k = 0
  while k < n {
    let node = nodes[topo.order[k]]
    let is_entry = k == n - 1
    if is_entry && !include_entry {
      k = k + 1
      continue
    }
    drv_cas_pin_add(pin, dag.pkg_keys[k])
    if dag.pkg_was_miss[k] {
      miss_ssa_paths.push(dag.pkg_ssa_paths[k])
      miss_obj_paths.push(dag.pkg_obj_paths[k])
      miss_keys.push(dag.pkg_keys[k])
    }
    obj_paths.push(dag.pkg_obj_paths[k])
    if !is_entry {
      dep_pkg_names.push(node.name)
    }
    link_key_sb.write_string(":")
    link_key_sb.write_string(dag.pkg_keys[k])
    k = k + 1
  }
  let _ = drv_cas_pin_flush(world, pin)

  // Compile all CAS-missed packages (parallel --obj-batch on direct_obj, parallel qbe+as otherwise)
  let n_miss = miss_keys.length()
  match drv_compile_missed(
    world,
    qbe_bin,
    qbe_target,
    apple_tools,
    direct_obj,
    qbe_macos_ver,
    cc1as_triple,
    sysroot,
    miss_ssa_paths,
    miss_obj_paths,
    jobs,
    false,
  ) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }

  if n_miss > 0 {
    let miss_sizes : Array[Int64] = []
    let mut mi = 0
    while mi < n_miss {
      let sz = fs_size(world, miss_obj_paths[mi])
      miss_sizes.push(if sz > 0L { sz } else { 0L })
      mi = mi + 1
    }
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      miss_keys,
      miss_sizes,
      pin,
    )
  }

  let root_pkg_name = nodes[topo.order[n - 1]].name
  // Collect `[link]` / `[link.<os>]` options and compile `c_sources` in topo order (deps first).
  let ws_link_opts = drv_link_opts_empty()
  let cstub_new_keys : Array[String] = []
  let cstub_new_sizes : Array[Int64] = []
  let cc_ver_cache : Map[String, String] = Map([])
  let file_hash_memo : Map[String, String] = Map([])
  k = 0
  while k < n {
    let node = nodes[topo.order[k]]
    drv_collect_node_link_opts(node, qbe_target, ws_link_opts)
    let cstub_objs : Array[String] = []
    let cstub_keys : Array[String] = []
    match drv_compile_pkg_c_sources(
      world,
      node,
      qbe_target,
      sysroot,
      need_pic,
      release,
      rt_lib,
      cache_dir,
      trace_cas,
      cc_ver_cache,
      file_hash_memo,
      cstub_objs,
      cstub_keys,
      cstub_new_keys,
      cstub_new_sizes,
      pin,
    ) {
      Err(e) => return Err(e)
      Ok(has_cxx) =>
        if has_cxx {
          ws_link_opts.has_cxx = true
        }
    }
    let mut ci = 0
    while ci < cstub_objs.length() {
      obj_paths.push(cstub_objs[ci])
      link_key_sb.write_string(":cstub:")
      link_key_sb.write_string(cstub_keys[ci])
      ci = ci + 1
    }
    let rc_objs : Array[String] = []
    let rc_keys : Array[String] = []
    match drv_compile_pkg_rc_sources(
      world,
      node,
      qbe_target,
      cache_dir,
      trace_cas,
      file_hash_memo,
      rc_objs,
      rc_keys,
      cstub_new_keys,
      cstub_new_sizes,
      pin,
      false,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    let mut rci = 0
    while rci < rc_objs.length() {
      push_unique_lib(ws_link_opts.objects, rc_objs[rci])
      link_key_sb.write_string(":rc:")
      link_key_sb.write_string(rc_keys[rci])
      rci = rci + 1
    }
    k = k + 1
  }
  let _ = drv_cas_pin_flush(world, pin)
  if cstub_new_keys.length() > 0 {
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      cstub_new_keys,
      cstub_new_sizes,
      pin,
    )
  }
  Ok(DrvWsBuilt::{
    root_pkg_name: root_pkg_name,
    root_checked: root_checked,
    obj_paths: obj_paths,
    dep_pkg_names: dep_pkg_names,
    link_key: sha256_hex(link_key_sb.to_string()),
    link_opts: ws_link_opts,
  })
}

///|
fn drv_wasm_ns_ident(name : String) -> String {
  let sb = StringBuilder()
  let n = name.length()
  let mut i = 0
  while i < n {
    let c = str_code_at(name, i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      sb.write_string(slice_str(name, i, i + 1))
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  sb.to_string()
}

fn drv_build_wasm_targets(
  world : World,
  targets : Array[String],
  release : Bool,
  emit_ssa_path : String,
  out_bin_arg : String,
  jobs : Int,
  wasm_names : Bool,
  web_rt_dst : String,
  locked : Bool,
  offline : Bool,
) -> Result[String, String] {
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/bin")
  let trace_cas = drv_env_str(world, "PION_TRACE_CAS") == "1"
  let trace_time = drv_env_str(world, "PION_TRACE_WASM_TIME") == "1"
  let t_wasm_start = if trace_time { clock_now_ms(world) } else { 0L }
  let no_wasm_opt = match env_get(world, "PION_NO_WASM_OPT") {
    Some(v) => v == "1"
    None => false
  }
  let wopt_bin = if release && !no_wasm_opt {
    match proc_exec_capture(world, ["which", "wasm-opt"]) {
      Ok(found) => drv_trim_ws(found)
      Err(_) => ""
    }
  } else {
    ""
  }
  let wopt_tag = if wopt_bin != "" {
    "wopt:" + wopt_bin + ":" + fs_size(world, wopt_bin).to_string()
  } else {
    "raw"
  }

  let mut pkg_name = "app"
  let mut all_ssa = ""
  let mut handled_ws = false
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        handled_ws = true
        let ws = match drv_load_workspace_opts_target(world, root_dir, locked, offline, web_rt_dst, "wasm32") {
          Err(e) => return Err(e)
          Ok(v) => v
        }
        let nodes = ws.nodes
        if web_rt_dst.length() > 0 {
          let mut ci = 0
          while ci < nodes.length() {
            match drv_check_web_rt_loaded_paths(world, web_rt_dst, nodes[ci].paths) {
              Err(e) => return Err(e)
              Ok(_) => ()
            }
            ci = ci + 1
          }
        }
        let names : Array[String] = []
        let dep_lists : Array[Array[String]] = []
        let mut ni = 0
        while ni < nodes.length() {
          names.push(nodes[ni].name)
          dep_lists.push(nodes[ni].deps)
          ni = ni + 1
        }
        let topo = topo_sort_packages(names, dep_lists)
        if topo.diagnostics.length() > 0 {
          return Err(check_result_to_json(topo.diagnostics))
        }
        let n = topo.order.length()
        let trans = drv_trans_deps(nodes, topo.order)
        let wasm_fp = drv_compute_self_fp(world, "wasm32-v3")
        let pin = drv_cas_pin_open(world, cache_dir)
        let dag = match drv_ws_run_dag(
          world,
          nodes,
          topo.order,
          trans,
          cache_dir,
          true,
          release,
          true,
          "wasm32",
          "main",
          false,
          wasm_fp,
          jobs,
          trace_cas,
          pin,
        ) {
          Err(e) => {
            drv_cas_pin_close(world, pin)
            return Err(e)
          }
          Ok(v) => v
        }
        let pkg_ssa_paths = dag.pkg_ssa_paths
        let pkg_ssa_mem = dag.pkg_ssa_mem
        let new_keys : Array[String] = []
        let new_sizes : Array[Int64] = []
        let link_key_sb = StringBuilder()
        let mut k = 0
        while k < n {
          drv_cas_pin_add(pin, dag.pkg_keys[k])
          if dag.pkg_was_miss[k] {
            new_keys.push(dag.pkg_keys[k])
            new_sizes.push(dag.pkg_entry_sizes[k])
          }
          link_key_sb.write_string(":")
          link_key_sb.write_string(dag.pkg_keys[k])
          k = k + 1
        }
        let wasm_bin_key = sha256_hex(
          "wasm-bin-v3|" +
          wasm_fp +
          "|" +
          (if release { "rel" } else { "dbg" }) +
          "|" +
          (if wasm_names { "names" } else { "nonames" }) +
          "|" +
          wopt_tag +
          "|" +
          link_key_sb.to_string(),
        )
        let wasm_cas_key = "wasmbin:" + wasm_bin_key
        let cached_wasm = cache_dir + "/bin/wasm_" + wasm_bin_key + ".wasm"
        if emit_ssa_path == "" &&
          drv_is_nonempty_regular_file(world, cached_wasm) &&
          drv_cas_pin_and_verify(world, cache_dir, pin, [wasm_cas_key], [cached_wasm]) {
          if new_keys.length() > 0 {
            drv_cas_record_batch_and_evict_pinned(
              world,
              cache_dir,
              new_keys,
              new_sizes,
              pin,
            )
          }
          if trace_cas {
            io_eprintln(
              world,
              "[cas-wasm-bin] HIT key=" + drv_prefix16(wasm_bin_key),
            )
          }
          if out_bin_arg != "" {
            let copied = drv_copy_file(world, cached_wasm, out_bin_arg)
            drv_cas_post_run_evict(world, cache_dir, pin, [])
            return copied
          }
          drv_cas_post_run_evict(world, cache_dir, pin, [wasm_cas_key])
          return Ok(cached_wasm)
        }
        if trace_cas {
          io_eprintln(
            world,
            "[cas-wasm-bin] MISS key=" + drv_prefix16(wasm_bin_key),
          )
        }
        let t_pkgs_done = if trace_time { clock_now_ms(world) } else { 0L }
        if trace_time {
          io_eprintln(
            world,
            "[wasm-time] cas_and_pkg_emit=" + (t_pkgs_done - t_wasm_start).to_string() + "ms (pkgs=" + n.to_string() + ")",
          )
        }
        let pkg_ssas : Array[String] = []
        let mut total_ssa_bytes = 0
        k = 0
        while k < n {
          let pkg_ssa = if pkg_ssa_mem[k].length() > 0 {
            pkg_ssa_mem[k]
          } else {
            match fs_read(world, pkg_ssa_paths[k]) {
              Ok(t) => t
              Err(e) => {
                drv_cas_pin_close(world, pin)
                return Err("failed to read CAS wasm ssa " + pkg_ssa_paths[k] + ": " + e)
              }
            }
          }
          total_ssa_bytes = total_ssa_bytes + pkg_ssa.length()
          pkg_ssas.push(pkg_ssa)
          k = k + 1
        }
        if new_keys.length() > 0 {
          drv_cas_record_batch_and_evict_pinned(
            world,
            cache_dir,
            new_keys,
            new_sizes,
            pin,
          )
        }
        let t_ns_done = if trace_time { clock_now_ms(world) } else { 0L }
        if trace_time {
          io_eprintln(
            world,
            "[wasm-time] read_cas_ssa=" + (t_ns_done - t_pkgs_done).to_string() + "ms (ssa_bytes=" + total_ssa_bytes.to_string() + ")",
          )
        }
        if emit_ssa_path != "" {
          let ssa_sb = StringBuilder()
          k = 0
          while k < pkg_ssas.length() {
            ssa_sb.write_string(pkg_ssas[k])
            ssa_sb.write_char('\n')
            k = k + 1
          }
          all_ssa = ssa_sb.to_string()
          drv_ensure_parent_dir(world, emit_ssa_path)
          if !drv_write_text_atomic(world, emit_ssa_path, all_ssa) {
            drv_cas_pin_close(world, pin)
            return Err("failed to write --emit-ssa file: " + emit_ssa_path)
          }
        }
        let t_stage : Array[Int64] = [if trace_time { clock_now_ms(world) } else { 0L }]
        let wasm_bytes = if trace_time {
          emit_wasm_from_ssa_units_opts(pkg_ssas, wasm_names, fn(label : String) -> Unit {
            let now = clock_now_ms(world)
            io_eprintln(world, "[wasm-time] " + label + "=" + (now - t_stage[0]).to_string() + "ms")
            t_stage[0] = now
          })
        } else {
          emit_wasm_from_ssa_units_opts(pkg_ssas, wasm_names, fn(_s : String) -> Unit { () })
        }
        let wasm_tag = drv_tmp_tag(world, cached_wasm)
        let tmp_bin = cached_wasm + ".tmp." + wasm_tag
        if wopt_bin != "" {
          let tmp_raw = cached_wasm + ".raw." + wasm_tag
          match fs_write_bytes(world, tmp_raw, wasm_bytes) {
            Err(e) => {
              let _ = fs_remove(world, tmp_raw)
              drv_cas_pin_close(world, pin)
              return Err("failed to write raw wasm file " + tmp_raw + ": " + e)
            }
            Ok(_) => ()
          }
          let wopt_args : Array[String] = [
            wopt_bin,
            "-Oz",
            "--enable-bulk-memory",
            "--enable-sign-ext",
            "--enable-mutable-globals",
            "--enable-nontrapping-float-to-int",
          ]
          if wasm_names {
            wopt_args.push("-g")
          }
          wopt_args.push(tmp_raw)
          wopt_args.push("-o")
          wopt_args.push(tmp_bin)
          let opt_res = proc_exec_capture(world, wopt_args)
          let _ = fs_remove(world, tmp_raw)
          match opt_res {
            Ok(_) => ()
            Err(e) => {
              let _ = fs_remove(world, tmp_bin)
              drv_cas_pin_close(world, pin)
              return Err("wasm-opt failed on " + cached_wasm + ": " + e)
            }
          }
        } else {
          match fs_write_bytes(world, tmp_bin, wasm_bytes) {
            Err(e) => {
              let _ = fs_remove(world, tmp_bin)
              drv_cas_pin_close(world, pin)
              return Err("failed to write wasm file " + tmp_bin + ": " + e)
            }
            Ok(_) => ()
          }
        }
        if drv_cas_publish_file_pinned(world, cache_dir, pin, [wasm_cas_key], tmp_bin, cached_wasm) {
          let bsz = fs_size(world, cached_wasm)
          drv_cas_record_batch_and_evict_pinned(
            world,
            cache_dir,
            [wasm_cas_key],
            [if bsz > 0L { bsz } else { 0L }],
            pin,
          )
          if out_bin_arg != "" {
            let copied = drv_copy_file(world, cached_wasm, out_bin_arg)
            drv_cas_post_run_evict(world, cache_dir, pin, [])
            return copied
          }
          drv_cas_post_run_evict(world, cache_dir, pin, [wasm_cas_key])
          return Ok(cached_wasm)
        } else {
          if out_bin_arg != "" {
            let copied = drv_copy_file(world, tmp_bin, out_bin_arg)
            let _ = fs_remove(world, tmp_bin)
            drv_cas_post_run_evict(world, cache_dir, pin, [])
            return copied
          }
          drv_cas_post_run_evict(world, cache_dir, pin, [])
          return Ok(tmp_bin)
        }
      }
      None => ()
    }
  }
  if !handled_ws {
    let loaded = match drv_load_targets(world, targets) {
      Err(msg) => return Err(msg)
      Ok(v) => v
    }
    if web_rt_dst.length() > 0 {
      match drv_check_web_rt_loaded_paths(world, web_rt_dst, loaded.paths) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
    }
    pkg_name = loaded.pkg_name
    let compiled = match cli_compile_qbe_entry_opts(
      loaded.pkg_name,
      loaded.paths,
      loaded.sources,
      release,
      true,
      "main",
      false,
      drv_j2_disable_mask(world),
    ) {
      Err(diag_json) => return Err(diag_json)
      Ok(c) => c
    }
    all_ssa = compiled.ssa
  }

  if emit_ssa_path != "" {
    drv_ensure_parent_dir(world, emit_ssa_path)
    if !drv_write_text_atomic(world, emit_ssa_path, all_ssa) {
      return Err("failed to write --emit-ssa file: " + emit_ssa_path)
    }
  }

  let wasm_bytes = emit_wasm_from_ssa_opts(all_ssa, wasm_names)
  // `wopt_tag` (wasm-opt on/off and which binary) is part of the key, as in
  // the workspace path: an optimized and a raw module never share a CAS file.
  let ssa_key = drv_prefix16(
    sha256_hex(
      (if wasm_names { "names|" } else { "" }) + wopt_tag + "|" + all_ssa,
    ),
  )
  let final_wasm = if out_bin_arg != "" {
    out_bin_arg
  } else {
    cache_dir + "/bin/" + pkg_name + "_" + ssa_key + ".wasm"
  }
  if out_bin_arg != "" {
    drv_ensure_parent_dir(world, out_bin_arg)
  }
  drv_write_wasm_out(
    world,
    final_wasm,
    wasm_bytes,
    wopt_bin,
    wasm_names,
    out_bin_arg == "",
  )
}

///|
/// Writes a single-package Wasm module to `final_wasm` (through `wasm-opt`
/// when `wopt_bin` is set) inside a `drv_make_out_stage` directory and
/// publishes it with `drv_publish_tmp` (`shared` for a CAS path), so a
/// concurrent build never reads a half-written `.wasm` and a failure leaves
/// no `.raw`/temp file and the old output untouched.
fn drv_write_wasm_out(
  world : World,
  final_wasm : String,
  wasm_bytes : Bytes,
  wopt_bin : String,
  wasm_names : Bool,
  shared : Bool,
) -> Result[String, String] {
  let (out_dir, out_base) = drv_split_dir_base(world, final_wasm)
  let stage = match drv_make_out_stage(world, out_dir) {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let tmp_wasm = stage + "/" + out_base
  let out : Result[String, String] = if wopt_bin == "" {
    match fs_write_bytes(world, tmp_wasm, wasm_bytes) {
      Err(e) => Err("failed to write wasm file " + tmp_wasm + ": " + e)
      Ok(_) => drv_publish_tool_output(world, tmp_wasm, final_wasm, shared, "wasm emit")
    }
  } else {
    // wasm-opt's input lives in a second private directory, so it can never
    // be the output file (e.g. `-o RAW.WASM` on a case-insensitive volume).
    match drv_make_out_stage(world, out_dir) {
      Err(e) => Err(e)
      Ok(raw_stage) => {
        let opt = drv_run_wasm_opt(
          world,
          raw_stage + "/raw.wasm",
          tmp_wasm,
          wasm_bytes,
          wopt_bin,
          wasm_names,
        )
        let published : Result[String, String] = match opt {
          Err(e) => Err(e)
          Ok(_) => drv_publish_tool_output(world, tmp_wasm, final_wasm, shared, "wasm-opt")
        }
        drv_staged_result(published, drv_drop_out_stage(world, raw_stage))
      }
    }
  }
  drv_staged_result(out, drv_drop_out_stage(world, stage))
}

///|
/// Writes `wasm_bytes` to `tmp_raw` and runs `wasm-opt -Oz` from it into
/// `tmp_wasm` (both inside private staging directories).
fn drv_run_wasm_opt(
  world : World,
  tmp_raw : String,
  tmp_wasm : String,
  wasm_bytes : Bytes,
  wopt_bin : String,
  wasm_names : Bool,
) -> Result[Unit, String] {
  match fs_write_bytes(world, tmp_raw, wasm_bytes) {
    Err(e) => return Err("failed to write raw wasm file " + tmp_raw + ": " + e)
    Ok(_) => ()
  }
  let wopt_args : Array[String] = [
    wopt_bin,
    "-Oz",
    "--enable-bulk-memory",
    "--enable-sign-ext",
    "--enable-mutable-globals",
    "--enable-nontrapping-float-to-int",
  ]
  if wasm_names {
    wopt_args.push("-g")
  }
  wopt_args.push(tmp_raw)
  wopt_args.push("-o")
  wopt_args.push(tmp_wasm)
  match proc_exec_capture(world, wopt_args) {
    Ok(_) => Ok(())
    Err(e) => Err("wasm-opt failed on " + tmp_wasm + ": " + e)
  }
}

///| The RC pass depends only on the emitted text and the build options.
fn drv_finish_unit_ssa(raw : String, release : Bool, mask : Int) -> String {
  if release {
    inline_native_rc_ssa_opts(raw, mask)
  } else {
    cleanup_native_rc_ssa_opts(raw, mask)
  }
}

///| Emit one unit on the producer thread; the prepared type checker stays local.
fn drv_emit_unit_file(
  world : World,
  prep : PreparedPackage,
  idx : Int,
  output : String,
  release : Bool,
  target : String,
  entry_symbol : String,
  no_main : Bool,
) -> Bool {
  let mask = drv_j2_disable_mask(world)
  let raw = emit_qbe_unit_entry_target_opts(prep, idx, release, target, entry_symbol, no_main, mask)
  drv_write_cas_text_atomic(world, output, drv_finish_unit_ssa(raw, release, mask))
}

///|
fn drv_emit_isolated_unit(
  prep : PreparedPackage, idx : Int, release : Bool, target : String,
  entry_symbol : String, no_main : Bool, mask : Int,
) -> String {
  let tc = TypeChecker::{ ..prep.tc, diagnostics: [], edit_keys: Map([]) }
  let local = PreparedPackage::{ ..prep, tc: tc }
  emit_qbe_unit_entry_target_opts(local, idx, release, target, entry_symbol, no_main, mask)
}

///|
fn drv_build_targets(
  world : World,
  targets : Array[String],
  release : Bool,
  emit_ssa_path : String,
  emit_asm_path : String,
  out_bin_arg : String,
  jobs : Int,
  picked_target : String,
  emit_obj_path : String,
  emit_staticlib_path : String,
  emit_cdylib_path : String,
  sysroot : String,
  cli_libs : Array[String],
  wasm_names : Bool,
  entry_symbol : String,
  no_main : Bool,
  web_rt_dst : String,
  locked : Bool,
  offline : Bool,
) -> Result[String, String] {
  if drv_target_is_wasm(picked_target) {
    return drv_build_wasm_targets(
      world,
      targets,
      release,
      emit_ssa_path,
      out_bin_arg,
      jobs,
      wasm_names,
      web_rt_dst,
      locked,
      offline,
    )
  }
  let only_text_emit = (emit_ssa_path != "" || emit_asm_path != "") &&
    out_bin_arg == "" &&
    emit_obj_path == "" &&
    emit_staticlib_path == "" &&
    emit_cdylib_path == ""
  if !only_text_emit {
    match drv_check_android_toolchain(world, picked_target) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        let cache_dir = drv_resolve_cache_dir(world)
        let pin = drv_cas_pin_open(world, cache_dir)
        let built = match drv_build_workspace_objects_entry(
          world,
          root_dir,
          release,
          true,
          jobs,
          picked_target,
          sysroot,
          emit_cdylib_path != "" || emit_staticlib_path != "",
          false,
          entry_symbol,
          no_main,
          locked,
          offline,
          pin,
        ) {
          Err(e) => {
            drv_cas_pin_close(world, pin)
            return Err(e)
          }
          Ok(v) => v
        }
        if emit_obj_path != "" {
          if built.obj_paths.length() != 1 {
            drv_cas_pin_close(world, pin)
            return Err(
              "--emit-obj needs a single package; workspace has " +
              built.obj_paths.length().to_string() +
              " packages",
            )
          }
          let res = drv_copy_file(world, built.obj_paths[0], emit_obj_path)
          drv_cas_post_run_evict(world, cache_dir, pin, [])
          return res
        }
        let qbe_target = picked_target
        if emit_staticlib_path != "" {
          let res = drv_archive_static_lib(world, qbe_target, built.obj_paths, emit_staticlib_path, false)
          drv_cas_post_run_evict(world, cache_dir, pin, [])
          return res
        }
        let link_opts = built.link_opts
        let mut li = 0
        while li < cli_libs.length() {
          push_unique_lib(link_opts.libs, cli_libs[li])
          if drv_is_cxx_lib(cli_libs[li]) {
            link_opts.has_cxx = true
          }
          li = li + 1
        }
        let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, false, pin) {
          Err(e) => {
            drv_cas_pin_close(world, pin)
            return Err(e)
          }
          Ok(p) => p
        }
        if emit_cdylib_path != "" {
          let res = drv_link_shared_lib(
            world,
            qbe_target,
            sysroot,
            built.obj_paths,
            rt_lib,
            link_opts,
            emit_cdylib_path,
          )
          drv_cas_post_run_evict(world, cache_dir, pin, [])
          return res
        }
        let root_pkg = built.root_pkg_name
        let default_bin = cache_dir +
          "/bin/" +
          root_pkg +
          "_" +
          drv_prefix16(drv_bin_key(world, qbe_target, sysroot, built.link_key, link_opts))
        let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }
        let linked_bin = drv_linked_exe_path(qbe_target, final_bin)
        if out_bin_arg == "" && drv_is_nonempty_regular_file(world, linked_bin) {
          drv_cas_post_run_evict(world, cache_dir, pin, [])
          return Ok(linked_bin)
        }
        if out_bin_arg != "" {
          drv_ensure_parent_dir(world, out_bin_arg)
        }
        let apple_tools = drv_probe_apple_tools(world, qbe_target)
        let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
          apple_tools.macos_ver
        } else {
          "15.0"
        }
        let ld_ver = qbe_macos_ver + ".0"
        let res = drv_link_objects(
          world,
          qbe_target,
          apple_tools,
          ld_ver,
          sysroot,
          built.obj_paths,
          rt_lib,
          link_opts,
          final_bin,
          out_bin_arg == "",
          false,
        )
        drv_cas_post_run_evict(world, cache_dir, pin, [])
        return res
      }
      None => ()
    }
  }
  let loaded = match drv_load_targets(world, targets) {
    Err(msg) => return Err(msg)
    Ok(v) => v
  }
  let pkg_name = loaded.pkg_name
  let paths = loaded.paths
  let sources = loaded.sources

  // Keep parsing and type checking on the single-thread RC path.
  let src_hashes = drv_parallel_prehash(world, sources, 1)

  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let _ = fs_mkdir_p(world, cache_dir + "/bin")
  let _ = fs_mkdir_p(world, cache_dir + "/usig")
  let pin = drv_cas_pin_open(world, cache_dir)

  let qbe_target = picked_target
  let qbe_arch = drv_target_qbe_arch(qbe_target)
  let qbe_seh = drv_win_seh(world, qbe_target)
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib_fp = if only_text_emit {
    ""
  } else {
    // The same runtime the link below resolves (`--sysroot` included).
    match drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, false, pin) {
      Err(e) => {
        drv_cas_pin_close(world, pin)
        return Err(e)
      }
      Ok(p) => p
    }
  }
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib_fp, qbe_target, sysroot)
  let fp_pre = drv_prefix16(compiler_fp)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target) && emit_asm_path == ""
  let link_opts = drv_link_opts_from_libs(cli_libs)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let ld_ver = qbe_macos_ver + ".0"

  // Multi-file unit-level parallel compilation + unit-level global CAS + incremental .sig/.stub skip
  if paths.length() > 1 &&
    emit_ssa_path == "" &&
    emit_asm_path == "" &&
    emit_obj_path == "" &&
    emit_staticlib_path == "" &&
    emit_cdylib_path == "" {
    let n_units = paths.length()
    let has_usig : Array[Bool] = []
    let file_sigs : Array[String] = []
    let mut n_usig_hits = 0
    let mut ui = 0
    while ui < n_units {
      let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
      let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
      if drv_is_regular_file(usig_p) && drv_is_regular_file(ustub_p) {
        match fs_read(world, usig_p) {
          Ok(sig_txt) => {
            has_usig.push(true)
            file_sigs.push(sig_txt)
            n_usig_hits = n_usig_hits + 1
          }
          Err(_) => {
            has_usig.push(false)
            file_sigs.push("")
          }
        }
      } else {
        has_usig.push(false)
        file_sigs.push("")
      }
      ui = ui + 1
    }

    let mut sigs_hash = ""
    let mut const_units : Array[Int] = []
    let mut const_init_order : Array[String] = []
    let mut has_main = false
    let mut prep_opt : Option[PreparedPackage] = None
    let parsed_dirty : Array[Option[SourceFile]] = []

    if n_usig_hits > 0 {
      let parse_diags : Array[Diagnostic] = []
      ui = 0
      while ui < n_units {
        if has_usig[ui] {
          parsed_dirty.push(None)
        } else {
          let pr = parse_source(paths[ui], sources[ui])
          let mut di = 0
          while di < pr.diagnostics.length() {
            parse_diags.push(pr.diagnostics[di])
            di = di + 1
          }
          file_sigs[ui] = emit_file_sig_entries(pr.file)
          parsed_dirty.push(Some(pr.file))
        }
        ui = ui + 1
      }
      if parse_diags.length() > 0 {
        return Err(check_result_to_json(parse_diags))
      }
      let summary = summarize_file_sigs(pkg_name, file_sigs)
      if summary.const_has_cycle || summary.const_has_ambiguous_method {
        let prep = match cli_prepare_qbe_units(pkg_name, paths, sources) {
          Err(diag_json) => return Err(diag_json)
          Ok(p) => p
        }
        sigs_hash = prep.sigs_hash
        const_units = prep.const_units
        const_init_order = prep.const_init_order
        has_main = prep.has_main
        prep_opt = Some(prep)
      } else {
        sigs_hash = summary.sigs_hash
        const_units = summary.const_units
        const_init_order = summary.const_init_order
        has_main = summary.has_main
      }
    } else {
      let prep = match cli_prepare_qbe_units(pkg_name, paths, sources) {
        Err(diag_json) => return Err(diag_json)
        Ok(p) => p
      }
      sigs_hash = prep.sigs_hash
      const_units = prep.const_units
      const_init_order = prep.const_init_order
      has_main = prep.has_main
      prep_opt = Some(prep)
      // Populate global CAS per-file .sig and .stub for subsequent incremental builds
      ui = 0
      while ui < n_units {
        let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
        let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
        if !drv_is_regular_file(usig_p) {
          let _ = drv_write_cas_text_atomic(world, usig_p, emit_file_sig_entries(prep.pkg.files[ui]))
        }
        if !drv_is_regular_file(ustub_p) {
          let _ = drv_write_cas_text_atomic(world, ustub_p, emit_file_stub(prep.pkg.files[ui]))
        }
        ui = ui + 1
      }
    }

    let entry_tag = if no_main {
      ":no_main"
    } else if entry_symbol.length() > 0 && entry_symbol != "main" {
      ":entry:" + entry_symbol
    } else {
      ""
    }
    let unit_sigs_hash = if entry_tag.length() > 0 {
      sha256_hex(sigs_hash + entry_tag)
    } else {
      sigs_hash
    }
    let unit_keys : Array[String] = []
    let obj_paths : Array[String] = []
    let miss_indices : Array[Int] = []
    let is_miss : Array[Bool] = []
    let pkg_key_sb = StringBuilder()
    pkg_key_sb.write_string(compiler_fp)
    pkg_key_sb.write_string(":")
    pkg_key_sb.write_string(unit_sigs_hash)
    ui = 0
    while ui < n_units {
      let ukey = cas_compute_unit_key(
        pkg_name,
        ui,
        paths[ui],
        src_hashes[ui],
        unit_sigs_hash,
        qbe_target,
        release,
        compiler_fp,
      )
      unit_keys.push(ukey)
      pkg_key_sb.write_string(":")
      pkg_key_sb.write_string(ukey)
      let uobj = cache_dir + "/obj/" + ukey + ".o"
      obj_paths.push(uobj)
      if !drv_is_nonempty_regular_file(world, uobj) {
        miss_indices.push(ui)
        is_miss.push(true)
      } else {
        is_miss.push(false)
      }
      ui = ui + 1
    }
    let pkg_key = sha256_hex(pkg_key_sb.to_string())
    let default_bin = cache_dir +
      "/bin/" +
      pkg_name +
      "_" +
      drv_prefix16(drv_bin_key(world, qbe_target, sysroot, pkg_key, link_opts))
    let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }

    let linked_bin = drv_linked_exe_path(qbe_target, final_bin)
    if miss_indices.length() == 0 &&
      out_bin_arg == "" &&
      drv_is_nonempty_regular_file(world, linked_bin) {
      return Ok(linked_bin)
    }

    if miss_indices.length() > 0 {
      let prep = match prep_opt {
        Some(p) => p
        None => {
          // Incremental selective frontend: parse full source only for missed/uncached units,
          // and lightweight `.stub` for cached unchanged units!
          let files : Array[SourceFile] = []
          let check_file : Array[Bool] = []
          let parse_diags : Array[Diagnostic] = []
          ui = 0
          while ui < n_units {
            if is_miss[ui] || !has_usig[ui] {
              match parsed_dirty[ui] {
                Some(sf) => files.push(sf)
                None => {
                  let pr = parse_source(paths[ui], sources[ui])
                  let mut di = 0
                  while di < pr.diagnostics.length() {
                    parse_diags.push(pr.diagnostics[di])
                    di = di + 1
                  }
                  files.push(pr.file)
                }
              }
              check_file.push(true)
            } else {
              let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
              let stub_loaded = match fs_read(world, ustub_p) {
                Ok(stxt) => {
                  let spr = parse_source(paths[ui], stxt)
                  if spr.diagnostics.length() == 0 {
                    Some(spr.file)
                  } else {
                    None
                  }
                }
                Err(_) => None
              }
              match stub_loaded {
                Some(sf) => {
                  files.push(sf)
                  check_file.push(false)
                }
                None => {
                  let pr = parse_source(paths[ui], sources[ui])
                  let mut di = 0
                  while di < pr.diagnostics.length() {
                    parse_diags.push(pr.diagnostics[di])
                    di = di + 1
                  }
                  files.push(pr.file)
                  check_file.push(true)
                }
              }
            }
            ui = ui + 1
          }
          if parse_diags.length() > 0 {
            return Err(check_result_to_json(parse_diags))
          }
          let sel = match cli_prepare_qbe_units_selective(
            pkg_name,
            files,
            check_file,
            sigs_hash,
            const_units,
            const_init_order,
          ) {
            Err(diag_json) => return Err(diag_json)
            Ok(p) => p
          }
          has_main = sel.has_main
          // Save newly validated dirty units' .sig and .stub to CAS
          ui = 0
          while ui < n_units {
            if !has_usig[ui] {
              let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
              let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
              if !drv_is_regular_file(usig_p) {
                let _ = drv_write_cas_text_atomic(world, usig_p, file_sigs[ui])
              }
              if !drv_is_regular_file(ustub_p) {
                let _ = drv_write_cas_text_atomic(world, ustub_p, emit_file_stub(sel.pkg.files[ui]))
              }
            }
            ui = ui + 1
          }
          sel
        }
      }

      if direct_obj && jobs > 1 && miss_indices.length() > 1 {
        prep_opt = Some(prep)
      } else {
        let mut mi = 0
        while mi < miss_indices.length() {
          let idx = miss_indices[mi]
          let path = cache_dir + "/ssa/" + unit_keys[idx] + ".ssa"
          if !drv_emit_unit_file(world, prep, idx, path, release, qbe_target, entry_symbol, no_main) {
            return Err("failed to write CAS unit ssa: " + path)
          }
          mi = mi + 1
        }
      }
    }

    // Compile missed units (qbe --obj / --obj-batch or qbe + cc1as/as) in parallel across up to `jobs` OS threads
    let n_miss = miss_indices.length()
    if n_miss == 1 || (n_miss > 1 && !direct_obj && jobs <= 1) {
      let stamp = drv_tmp_tag(world, "unit_qbe_seq")
      let mut mi = 0
      while mi < n_miss {
        let idx = miss_indices[mi]
        let ukey = unit_keys[idx]
        let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
        let u_obj = obj_paths[idx]
        let u_tmp = u_obj + ".tmp." + stamp + "_" + idx.to_string()
        if direct_obj {
          let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
          argv.push("-o")
          argv.push(u_tmp)
          argv.push(u_ssa)
          let rc_qbe = proc_exec(world, argv)
          if rc_qbe != 0 {
            let _ = fs_remove(world, u_tmp)
            return Err("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
          }
          if !drv_publish_tmp(world, u_tmp, u_obj, true) {
            return Err("failed to publish CAS object: " + u_obj)
          }
        } else {
          let u_asm = cache_dir + "/obj/" + ukey + ".s." + stamp + "_" + idx.to_string()
          let rc_qbe = proc_exec(world, drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, u_asm, u_ssa))
          if rc_qbe != 0 {
            let _ = fs_remove(world, u_asm)
            return Err("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
          }
          let rc_as = drv_assemble_file(
            world,
            qbe_target,
            apple_tools,
            cc1as_triple,
            sysroot,
            u_asm,
            u_tmp,
            false,
          )
          let _ = fs_remove(world, u_asm)
          if rc_as != 0 {
            let _ = fs_remove(world, u_tmp)
            return Err("as failed with exit code " + rc_as.to_string())
          }
          if !drv_publish_tmp(world, u_tmp, u_obj, true) {
            return Err("failed to publish CAS object: " + u_obj)
          }
        }
        mi = mi + 1
      }
    } else if n_miss > 1 && direct_obj {
      let nw = if jobs <= 1 {
        1
      } else if n_miss < jobs {
        n_miss
      } else {
        jobs
      }
      let stamp_base = drv_tmp_tag(world, "unit_qbe_batch")
      if nw == 1 {
        let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, true)
        let tmps : Array[String] = []
        let objs : Array[String] = []
        let mut mi = 0
        while mi < n_miss {
          let idx = miss_indices[mi]
          let ukey = unit_keys[idx]
          let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
          let u_obj = obj_paths[idx]
          let u_tmp = u_obj + ".tmp." + stamp_base + "_" + idx.to_string()
          argv.push(u_ssa)
          argv.push(u_tmp)
          tmps.push(u_tmp)
          objs.push(u_obj)
          mi = mi + 1
        }
        let rc_qbe = proc_exec(world, argv)
        if rc_qbe != 0 {
          drv_remove_files(world, tmps, 0)
          return Err("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
        }
        let pub_err = drv_publish_unit_objs(world, tmps, objs)
        if pub_err != "" {
          return Err(pub_err)
        }
      } else {
        let err_ch : Channel[String] = Channel::new(nw + 1)
        let prep = match prep_opt {
          Some(p) => p
          None => return Err("missing prepared package for unit emission")
        }
        let emit_errors : Channel[String] = Channel::new(1)
        let all_tmps : Array[String] = []
        let all_objs : Array[String] = []
        let mask = drv_j2_disable_mask(world)
        let qmv = qbe_macos_ver
        let qb = qbe_bin
        let qt = qbe_target
        let mut largest_bytes = -1
        let mut heavy = 0
        let mut mi = 0
        while mi < n_miss {
          let size = sources[miss_indices[mi]].length()
          if size > largest_bytes {
            largest_bytes = size
            heavy = mi
          }
          mi = mi + 1
        }
        let largest = drv_find_batch_for(heavy, n_miss, nw)
        let first = drv_batch_start(largest, n_miss, nw)
        let first_text = drv_emit_isolated_unit(prep, miss_indices[first], release, qt, entry_symbol, no_main, mask)
        scope(world, fn(s : Scope) -> Unit {
          let mut turn : Channel[Bool] = Channel::new(1)
          let _ = turn.send(true)
          let inboxes : Array[Channel[String]] = []
          let mut wi = 0
          while wi < nw {
            let start = drv_batch_start(wi, n_miss, nw)
            let end = drv_batch_start(wi + 1, n_miss, nw)
            let paths : Array[String] = []
            let tmps : Array[String] = []
            let mut k = start
            while k < end {
              let idx = miss_indices[k]
              let obj = obj_paths[idx]
              let tmp = obj + ".tmp." + stamp_base + "_" + idx.to_string()
              paths.push(cache_dir + "/ssa/" + unit_keys[idx] + ".ssa")
              tmps.push(tmp)
              all_tmps.push(tmp)
              all_objs.push(obj)
              k = k + 1
            }
            let ssa_paths = paths.to_imm()
            let obj_tmps = tmps.to_imm()
            let inbox : Channel[String] = Channel::new(end - start)
            let before = turn
            let after : Channel[Bool] = Channel::new(1)
            turn = after
            let heavy_offset = heavy - start
            spawn(s, fn() -> Unit {
              let texts : Array[String] = []
              while true {
                match inbox.recv() {
                  Some(raw) => {
                    if !release && texts.length() == heavy_offset {
                      texts.push(drv_cleanup_ssa(world, raw, mask, nw))
                    } else {
                      texts.push(drv_finish_unit_ssa(raw, release, mask))
                    }
                  }
                  None => break
                }
              }
              // Propagate the first failed write; keep the baseline's SSA prefix.
              let mut ok = before.recv().unwrap_or(false)
              let argv = drv_qbe_obj_argv(qb, qt, qmv, true)
              let mut i = 0
              while ok && i < texts.length() {
                let path = ssa_paths[i]
                ok = drv_write_cas_text_atomic(world, path, texts[i])
                if ok {
                  argv.push(path)
                  argv.push(obj_tmps[i])
                } else {
                  let _ = emit_errors.send("failed to write CAS unit ssa: " + path)
                }
                i = i + 1
              }
              let _ = after.send(ok)
              if ok {
                let rc_qbe = proc_exec(world, argv)
                if rc_qbe != 0 {
                  let _ = err_ch.send("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
                }
              }
            })
            inboxes.push(inbox)
            wi = wi + 1
          }
          let mut step = 0
          while step < nw {
            let batch = if step == 0 { largest } else if step <= largest { step - 1 } else { step }
            let start = drv_batch_start(batch, n_miss, nw)
            let end = drv_batch_start(batch + 1, n_miss, nw)
            let inbox = inboxes[batch]
            let mut k = start
            while k < end {
              let raw = if k == first {
                first_text
              } else {
                drv_emit_isolated_unit(prep, miss_indices[k], release, qt, entry_symbol, no_main, mask)
              }
              let _ = inbox.send(raw)
              k = k + 1
            }
            inbox.close()
            step = step + 1
          }
        })
        emit_errors.close()
        match emit_errors.recv() {
          Some(msg) => {
            drv_remove_files(world, all_tmps, 0)
            return Err(msg)
          }
          None => ()
        }
        err_ch.close()
        match err_ch.recv() {
          Some(err_msg) => {
            drv_remove_files(world, all_tmps, 0)
            return Err(err_msg)
          }
          None => ()
        }
        let pub_err = drv_publish_unit_objs(world, all_tmps, all_objs)
        if pub_err != "" {
          return Err(pub_err)
        }
      }
    } else if n_miss > 1 {
      let use_cc1as = apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0
      let cc1as_bin = apple_tools.clang_bin
      let cc1as_tr = cc1as_triple
      let as_driver = drv_resolve_cc_driver(world, qbe_target, false)
      let as_flags_str = drv_join_char(drv_target_as_flags(world, qbe_target, sysroot, as_driver), "\n")
      let mut base = 0
      while base < n_miss {
        let mut batch = n_miss - base
        if batch > jobs {
          batch = jobs
        }
        let err_ch : Channel[String] = Channel::new(batch + 1)
        let stamp_base = drv_tmp_tag(world, "unit_qbe_par_" + base.to_string())
        let use_direct = direct_obj
        let qmv = qbe_macos_ver
        let batch_tmps : Array[String] = []
        let batch_objs : Array[String] = []
        scope(world, fn(s : Scope) -> Unit {
          let mut off = 0
          while off < batch {
            let idx = miss_indices[base + off]
            let ukey = unit_keys[idx]
            let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
            let u_obj = obj_paths[idx]
            let u_asm = cache_dir + "/obj/" + ukey + ".s." + stamp_base + "_" + idx.to_string()
            let u_tmp = u_obj + ".tmp." + stamp_base + "_" + idx.to_string()
            batch_tmps.push(u_tmp)
            batch_objs.push(u_obj)
            let qb = qbe_bin
            let qt = qbe_target
            let qa = qbe_arch
            let qs = qbe_seh
            spawn(s, fn() -> Unit {
              if use_direct {
                let argv = drv_qbe_obj_argv(qb, qt, qmv, false)
                argv.push("-o")
                argv.push(u_tmp)
                argv.push(u_ssa)
                let rc_qbe = proc_exec(argv)
                if rc_qbe != 0 {
                  let _ = fs_remove(u_tmp)
                  let _ = err_ch.send("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
                }
              } else {
                let rc_qbe = proc_exec(drv_qbe_text_argv(qb, qa, qs, u_asm, u_ssa))
                if rc_qbe != 0 {
                  let _ = fs_remove(u_asm)
                  let _ = err_ch.send("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
                } else {
                  let rc_as = if use_cc1as {
                    proc_exec([cc1as_bin, "-cc1as", "-triple", cc1as_tr, "-filetype", "obj", "-o", u_tmp, u_asm])
                  } else {
                    let argv : Array[String] = [as_driver]
                    let fls = drv_split_lines(as_flags_str)
                    let mut fi = 0
                    while fi < fls.length() {
                      if fls[fi].length() > 0 {
                        argv.push(fls[fi])
                      }
                      fi = fi + 1
                    }
                    argv.push("-c")
                    argv.push("-x")
                    argv.push("assembler")
                    argv.push("-o")
                    argv.push(u_tmp)
                    argv.push(u_asm)
                    proc_exec(argv)
                  }
                  let _ = fs_remove(u_asm)
                  if rc_as != 0 {
                    let _ = fs_remove(u_tmp)
                    let _ = err_ch.send("as failed with exit code " + rc_as.to_string() + " on " + u_asm)
                  }
                }
              }
            })
            off = off + 1
          }
        })
        err_ch.close()
        match err_ch.recv() {
          Some(err_msg) => {
            drv_remove_files(world, batch_tmps, 0)
            return Err(err_msg)
          }
          None => ()
        }
        let pub_err = drv_publish_unit_objs(world, batch_tmps, batch_objs)
        if pub_err != "" {
          return Err(pub_err)
        }
        base = base + batch
      }
    }

    if !has_main && out_bin_arg == "" {
      drv_cas_pin_close(world, pin)
      return Ok(obj_paths[0])
    }

    if out_bin_arg != "" {
      drv_ensure_parent_dir(world, out_bin_arg)
    }
    let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, false, pin) {
      Err(e) => {
        drv_cas_pin_close(world, pin)
        return Err(e)
      }
      Ok(p) => p
    }
    let link_res = drv_link_objects(
      world,
      qbe_target,
      apple_tools,
      ld_ver,
      sysroot,
      obj_paths,
      rt_lib,
      link_opts,
      final_bin,
      out_bin_arg == "",
      false,
    )
    drv_cas_post_run_evict(world, cache_dir, pin, [])
    return link_res
  }
  let single_upstream : Array[String] = []
  if no_main {
    single_upstream.push("__pion_entry__:no_main")
  } else if entry_symbol.length() > 0 && entry_symbol != "main" {
    single_upstream.push("__pion_entry__:" + entry_symbol)
  }
  let key = cas_compute_key(
    pkg_name,
    paths,
    sources,
    single_upstream,
    qbe_target,
    release,
    compiler_fp,
  )
  let sig_path = cache_dir + "/sig/" + key + ".pionsig"
  let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
  let obj_path = cache_dir + "/obj/" + key + ".o"
  let default_bin = cache_dir +
    "/bin/" +
    pkg_name +
    "_" +
    drv_prefix16(drv_bin_key(world, qbe_target, sysroot, key, link_opts))
  let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }

  let asm_only = emit_asm_path != "" &&
    out_bin_arg == "" &&
    emit_obj_path == "" &&
    emit_staticlib_path == "" &&
    emit_cdylib_path == ""
  let ssa_only = only_text_emit && emit_asm_path == ""
  let mut has_main = true
  let mut active_obj_path = obj_path
  let cache_hit = drv_is_nonempty_regular_file(world, obj_path) &&
    drv_is_nonempty_regular_file(world, ssa_path) &&
    drv_is_regular_file(sig_path) &&
    drv_cas_pin_and_verify(world, cache_dir, pin, [key], [obj_path, ssa_path])

  if ssa_only && drv_is_nonempty_regular_file(world, ssa_path) {
    drv_ensure_parent_dir(world, emit_ssa_path)
    match fs_read(world, ssa_path) {
      Err(msg) => return Err("failed to read cached ssa: " + msg)
      Ok(ssa_cached) =>
        if !drv_write_text_atomic(world, emit_ssa_path, ssa_cached) {
          return Err("failed to write --emit-ssa file: " + emit_ssa_path)
        }
    }
    return Ok(emit_ssa_path)
  }

  if asm_only && drv_is_nonempty_regular_file(world, ssa_path) {
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      match fs_read(world, ssa_path) {
        Err(msg) => return Err("failed to read cached ssa: " + msg)
        Ok(ssa_cached) =>
          if !drv_write_text_atomic(world, emit_ssa_path, ssa_cached) {
            return Err("failed to write --emit-ssa file: " + emit_ssa_path)
          }
      }
    }
    drv_ensure_parent_dir(world, emit_asm_path)
    let rc_qbe = proc_exec(
      world,
      drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, emit_asm_path, ssa_path),
    )
    if rc_qbe != 0 {
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    return Ok(emit_asm_path)
  }

  if cache_hit {
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      match fs_read(world, ssa_path) {
        Err(msg) => return Err("failed to read cached ssa: " + msg)
        Ok(ssa_cached) =>
          if !drv_write_text_atomic(world, emit_ssa_path, ssa_cached) {
            return Err("failed to write --emit-ssa file: " + emit_ssa_path)
          }
      }
    }
    if emit_asm_path != "" {
      drv_ensure_parent_dir(world, emit_asm_path)
      let rc_qbe = proc_exec(
        world,
        drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, emit_asm_path, ssa_path),
      )
      if rc_qbe != 0 {
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
        )
      }
    }
    let sz_sig = fs_size(world, sig_path)
    let sz_ssa = fs_size(world, ssa_path)
    let sz_obj = fs_size(world, obj_path)
    let total_sz = (if sz_sig > 0L { sz_sig } else { 0L }) +
      (if sz_ssa > 0L { sz_ssa } else { 0L }) +
      (if sz_obj > 0L { sz_obj } else { 0L })
    drv_cas_pin_add(pin, key)
    drv_cas_record_and_evict_pinned(world, cache_dir, key, total_sz, pin)
    if emit_obj_path == "" &&
      emit_staticlib_path == "" &&
      emit_cdylib_path == "" &&
      out_bin_arg == "" &&
      drv_is_nonempty_regular_file(world, drv_linked_exe_path(qbe_target, final_bin)) {
      drv_cas_post_run_evict(world, cache_dir, pin, [])
      return Ok(drv_linked_exe_path(qbe_target, final_bin))
    }
    if emit_obj_path == "" &&
      emit_staticlib_path == "" &&
      emit_cdylib_path == "" &&
      (emit_ssa_path != "" || emit_asm_path != "") &&
      out_bin_arg == "" {
      drv_cas_post_run_evict(world, cache_dir, pin, [key])
      return Ok(obj_path)
    }
  } else {
    let j2_mask = drv_j2_disable_mask(world)
    let compiled = match cli_compile_qbe_entry_opts(
      pkg_name,
      paths,
      sources,
      release,
      false,
      entry_symbol,
      no_main,
      j2_mask,
      // Other single-package targets retain their portable lowering.
      native_target=if qbe_target == "amd64_sysv" { qbe_target } else { "" },
    ) {
      Err(diag_json) => return Err(diag_json)
      Ok(c) => c
    }
    let final_ssa = if release {
      inline_native_rc_ssa_opts(compiled.ssa, j2_mask)
    } else {
      drv_cleanup_ssa(world, compiled.ssa, j2_mask, jobs)
    }
    has_main = compiled.has_main
    if !drv_write_cas_text_atomic(world, sig_path, compiled.sig) {
      return Err("failed to write CAS sig: " + sig_path)
    }
    let stamp = drv_tmp_tag(world, obj_path)
    let ssa_tmp = ssa_path + ".tmp." + stamp
    if !drv_write_text_atomic(world, ssa_tmp, final_ssa) {
      return Err("failed to write private ssa: " + ssa_tmp)
    }
    pin.temp_files.push(ssa_tmp)
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      if !drv_write_text_atomic(world, emit_ssa_path, final_ssa) {
        drv_cas_pin_close(world, pin)
        return Err("failed to write --emit-ssa file: " + emit_ssa_path)
      }
    }
    if ssa_only {
      let _ = drv_cas_publish_file_pinned(world, cache_dir, pin, [key], ssa_tmp, ssa_path)
      drv_cas_pin_close(world, pin)
      return Ok(emit_ssa_path)
    }
    if asm_only {
      drv_ensure_parent_dir(world, emit_asm_path)
      let rc_qbe = proc_exec(
        world,
        drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, emit_asm_path, ssa_tmp),
      )
      if rc_qbe != 0 {
        drv_cas_pin_close(world, pin)
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_tmp,
        )
      }
      let _ = drv_cas_publish_file_pinned(world, cache_dir, pin, [key], ssa_tmp, ssa_path)
      drv_cas_pin_close(world, pin)
      return Ok(emit_asm_path)
    }

    let obj_tmp = obj_path + ".tmp." + stamp
    let mut published_obj = false
    if direct_obj {
      let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
      argv.push("-o")
      argv.push(obj_tmp)
      argv.push(ssa_tmp)
      let rc_qbe = proc_exec(world, argv)
      if rc_qbe != 0 {
        let _ = fs_remove(world, obj_tmp)
        drv_cas_pin_close(world, pin)
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_tmp,
        )
      }
      published_obj = drv_cas_publish_file_pinned(
        world,
        cache_dir,
        pin,
        [key],
        obj_tmp,
        obj_path,
      )
    } else {
      let asm_path = cache_dir + "/obj/" + key + ".s." + stamp
      let rc_qbe = proc_exec(
        world,
        drv_qbe_text_argv(qbe_bin, qbe_arch, qbe_seh, asm_path, ssa_tmp),
      )
      if rc_qbe != 0 {
        let _ = fs_remove(world, asm_path)
        drv_cas_pin_close(world, pin)
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_tmp,
        )
      }
      if emit_asm_path != "" {
        drv_ensure_parent_dir(world, emit_asm_path)
        match fs_read(world, asm_path) {
          Err(msg) => {
            let _ = fs_remove(world, asm_path)
            drv_cas_pin_close(world, pin)
            return Err("failed to read asm: " + msg)
          }
          Ok(asm_text) =>
            if !drv_write_text_atomic(world, emit_asm_path, asm_text) {
              let _ = fs_remove(world, asm_path)
              drv_cas_pin_close(world, pin)
              return Err("failed to write --emit-asm file: " + emit_asm_path)
            }
        }
      }
      let rc_as = drv_assemble_file(
        world,
        qbe_target,
        apple_tools,
        cc1as_triple,
        sysroot,
        asm_path,
        obj_tmp,
        false,
      )
      let _ = fs_remove(world, asm_path)
      if rc_as != 0 {
        let _ = fs_remove(world, obj_tmp)
        drv_cas_pin_close(world, pin)
        return Err("as failed with exit code " + rc_as.to_string())
      }
      published_obj = drv_cas_publish_file_pinned(
        world,
        cache_dir,
        pin,
        [key],
        obj_tmp,
        obj_path,
      )
    }
    let _ = drv_cas_publish_file_pinned(world, cache_dir, pin, [key], ssa_tmp, ssa_path)

    if published_obj {
      let sz_sig = fs_size(world, sig_path)
      let sz_ssa = fs_size(world, ssa_path)
      let sz_obj = fs_size(world, obj_path)
      let total_sz = (if sz_sig > 0L { sz_sig } else { 0L }) +
        (if sz_ssa > 0L { sz_ssa } else { 0L }) +
        (if sz_obj > 0L { sz_obj } else { 0L })
      drv_cas_record_and_evict_pinned(world, cache_dir, key, total_sz, pin)
    } else {
      // Only register `obj_tmp` for cleanup if we will NOT return it directly
      // to the caller (no-main single-file build without `-o` / `--emit-*`).
      let returning_obj_directly = !has_main &&
        out_bin_arg == "" &&
        emit_obj_path == "" &&
        emit_staticlib_path == "" &&
        emit_cdylib_path == ""
      if !returning_obj_directly {
        pin.temp_files.push(obj_tmp)
      }
      active_obj_path = obj_tmp
    }
  }

  if emit_obj_path != "" {
    let res = drv_copy_file(world, active_obj_path, emit_obj_path)
    drv_cas_post_run_evict(world, cache_dir, pin, [])
    return res
  }
  if emit_staticlib_path != "" {
    let res = drv_archive_static_lib(world, qbe_target, [active_obj_path], emit_staticlib_path, false)
    drv_cas_post_run_evict(world, cache_dir, pin, [])
    return res
  }
  let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, sysroot, false, pin) {
    Err(e) => {
      drv_cas_pin_close(world, pin)
      return Err(e)
    }
    Ok(p) => p
  }
  if emit_cdylib_path != "" {
    let res = drv_link_shared_lib(
      world,
      qbe_target,
      sysroot,
      [active_obj_path],
      rt_lib,
      link_opts,
      emit_cdylib_path,
    )
    drv_cas_post_run_evict(world, cache_dir, pin, [])
    return res
  }

  if !has_main && out_bin_arg == "" {
    drv_cas_post_run_evict(world, cache_dir, pin, [key])
    return Ok(active_obj_path)
  }

  if out_bin_arg != "" {
    drv_ensure_parent_dir(world, out_bin_arg)
  }
  let res = drv_link_objects(
    world,
    qbe_target,
    apple_tools,
    ld_ver,
    sysroot,
    [active_obj_path],
    rt_lib,
    link_opts,
    final_bin,
    out_bin_arg == "",
    false,
  )
  drv_cas_post_run_evict(world, cache_dir, pin, [])
  res
}

///|
/// One package's tests to run: its test SSA, the transitive dependency objects
/// it links against (topo order) and the test indices selected by `--filter`.
struct DrvTestJob {
  label : String
  ssa : String
  names : Array[String]
  run_idx : Array[Int]
  dep_objs : Array[String]
  dep_obj_keys : Array[String]
  link_opts : DrvLinkOpts
}

///|
/// Splits `s` at every `code` unit ("" -> no fields).
fn drv_split_char(s : String, code : Int) -> Array[String] {
  let out : Array[String] = []
  if s.length() == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == code {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(s, start, s.length()))
  out
}

///|
fn drv_join_char(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(parts[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Names of the `test "..."` blocks of `pkg`, in emission order (the index a
/// test binary takes as its argument).
fn drv_test_names(pkg : Package) -> Array[String] {
  let out : Array[String] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DTest(td) => out.push(td.name)
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  out
}

///|
fn drv_filter_tests(names : Array[String], filter : String) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < names.length() {
    if filter.length() == 0 || drv_find_substr(names[i], filter, 0) >= 0 {
      out.push(i)
    }
    i = i + 1
  }
  out
}

///|
/// Compiles (when `need_qbe`) and links one test binary, atomically via rename.
fn drv_build_test_bin(
  world : World,
  apple_tools : AppleTools,
  qbe_bin : String,
  qbe_target : String,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  rt_lib : String,
  ssa_path : String,
  obj_path : String,
  bin_path : String,
  need_qbe : Bool,
  link_opts : DrvLinkOpts,
  deps : Array[String],
  stamp : String,
  quiet : Bool,
) -> Result[Unit, String] {
  if need_qbe {
    match drv_compile_ssa_to_obj(
      world,
      qbe_bin,
      qbe_target,
      apple_tools,
      direct_obj,
      qbe_macos_ver,
      cc1as_triple,
      "",
      ssa_path,
      obj_path,
      stamp,
      quiet,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let objs : Array[String] = []
  let mut i = 0
  while i < deps.length() {
    objs.push(deps[i])
    i = i + 1
  }
  objs.push(obj_path)
  let linked = drv_link_objects(
    world,
    qbe_target,
    apple_tools,
    qbe_macos_ver + ".0",
    "",
    objs,
    rt_lib,
    link_opts,
    bin_path,
    true,
    quiet,
  )
  match linked {
    Err(e) => Err(e)
    Ok(_) => Ok(())
  }
}

///|
/// The tab position of a `<index>\t<payload>` worker message (-1 when none).
fn drv_msg_tab(msg : String) -> Int {
  let mut i = 0
  while i < msg.length() {
    if str_code_at(msg, i) == 9 {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn drv_msg_idx(msg : String) -> Int {
  let tab = drv_msg_tab(msg)
  if tab <= 0 {
    return -1
  }
  let digits = slice_str(msg, 0, tab)
  if digits == "0" {
    return 0
  }
  drv_parse_pos_int64(digits, -1L).to_int()
}

///|
fn drv_msg_payload(msg : String) -> String {
  let tab = drv_msg_tab(msg)
  if tab < 0 {
    msg
  } else {
    slice_str(msg, tab + 1, msg.length())
  }
}

///|
/// The ASCII unit separator, joining path lists inside one worker spec line.
fn drv_unit_sep() -> String {
  let sb = StringBuilder()
  let us = 31
  sb.write_char(us.unsafe_to_char())
  sb.to_string()
}

///|
/// Builds and runs every job's tests. Test binaries live in the global CAS
/// (`$PION_CACHE_DIR/testbin/`): the test object is keyed by the test SSA, the
/// binary by that object plus every linked dependency object (CAS path, size
/// and mtime: a dependency whose source or upstream interface changed has a
/// new CAS path, so no stale binary can be reused) and the link libraries.
/// Missing binaries are compiled and linked in parallel, then every selected
/// test runs in its own process, also in parallel (bounded by `par`). Results
/// are appended in job order, then test index order.
///|
fn drv_exec_test_child(world : World, bin : String, idx : String, as_json : Bool) -> Int {
  if as_json {
    match proc_exec_capture(world, [bin, idx]) {
      Ok(_) => 0
      Err(_) => 1
    }
  } else {
    proc_exec(world, [bin, idx])
  }
}

///|
fn drv_exec_test_jobs(
  world : World,
  jobs_list : Array[DrvTestJob],
  par : Int,
  as_json : Bool,
  active_target : String,
  out_pkgs : Array[String],
  out_names : Array[String],
  out_oks : Array[Bool],
  pin : DrvCasPinSession,
) -> Result[Unit, String] {
  if jobs_list.length() == 0 {
    return Ok(())
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let tb_dir = cache_dir + "/testbin"
  let _ = fs_mkdir_p(world, tb_dir)
  let qbe_target = if active_target != "" {
    active_target
  } else {
    drv_resolve_qbe_target(world)
  }
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, "", as_json, pin) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let file_hash_memo : Map[String, String] = Map([])
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib, qbe_target, "")
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let nw_max = if par > 0 { par } else { drv_default_jobs(world) }

  let usep = drv_unit_sep()
  let bins : Array[String] = []
  let build_lines : Array[String] = []
  let new_keys : Array[String] = []
  let new_ssa : Array[String] = []
  // rcs[gi]: exit code of the gi-th selected test (job order, then index order).
  let rcs : Array[Int] = []
  let mut gi_base = 0
  let mut j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let job_gi = gi_base
    let mut ri = 0
    while ri < job.run_idx.length() {
      rcs.push(-1)
      ri = ri + 1
    }
    gi_base = gi_base + job.run_idx.length()
    let okey = sha256_hex(
      compiler_fp +
      "|testobj|" +
      qbe_target +
      "|" +
      qbe_macos_ver +
      "|" +
      sha256_hex(job.ssa),
    )
    let dsb = StringBuilder()
    dsb.write_string(compiler_fp)
    dsb.write_string("|testbin|")
    dsb.write_string(qbe_target)
    dsb.write_string("|")
    dsb.write_string(qbe_macos_ver)
    dsb.write_string("|")
    dsb.write_string(okey)
    let mut di = 0
    while di < job.dep_objs.length() {
      let dp = job.dep_objs[di]
      dsb.write_string("|")
      if di < job.dep_obj_keys.length() && job.dep_obj_keys[di].length() > 0 {
        dsb.write_string("cas:")
        dsb.write_string(job.dep_obj_keys[di])
        dsb.write_string(":")
        dsb.write_string(fs_size(world, dp).to_string())
      } else {
        dsb.write_string(drv_cas_file_content_fp(world, dp, file_hash_memo))
      }
      di = di + 1
    }
    dsb.write_string(drv_link_opts_key(world, job.link_opts))
    dsb.write_string(drv_effective_link_context_key(world, qbe_target, "", job.link_opts))
    let bkey = sha256_hex(dsb.to_string())
    let obj_path = tb_dir + "/" + okey + ".o"
    let bkey_file = drv_linked_exe_path(qbe_target, bkey)
    let bin_path = drv_linked_exe_path(qbe_target, tb_dir + "/" + bkey)
    bins.push(bin_path)
    let bin_hit = drv_is_nonempty_regular_file(world, bin_path) &&
      drv_cas_pin_and_verify(world, cache_dir, pin, ["testbin:" + bkey_file], [bin_path])
    if bin_hit {
      if trace_cas {
        io_eprintln(world, "[cas] test=" + job.label + " HIT bin=" + drv_prefix16(bkey))
      }
    } else {
      let obj_hit = drv_is_nonempty_regular_file(world, obj_path) &&
        drv_cas_pin_and_verify(world, cache_dir, pin, ["testbin:" + okey + ".o"], [obj_path])
      let need_qbe = !obj_hit
      drv_cas_pin_add(pin, "testbin:" + okey + ".o")
      drv_cas_pin_add(pin, "testbin:" + bkey_file)
      let ssa_path = tb_dir + "/" + okey + ".ssa." + drv_tmp_tag(world, okey + "_" + j.to_string())
      if need_qbe {
        if !drv_write_cas_text_atomic(world, ssa_path, job.ssa) {
          return Err("failed to write test ssa: " + ssa_path)
        }
        new_ssa.push(ssa_path)
        new_keys.push(okey + ".o")
      }
      if trace_cas {
        io_eprintln(
          world,
          "[cas] test=" +
          job.label +
          " MISS bin=" +
          drv_prefix16(bkey) +
          " okey=" +
          drv_prefix16(okey) +
          (if need_qbe { " obj=MISS" } else { " obj=HIT" }),
        )
      }
      // The real file name (`.exe` on Windows), so size accounting and
      // `testbin:` eviction hit the binary the link produced.
      new_keys.push(bkey_file)
      build_lines.push(
        ssa_path +
        "\t" +
        obj_path +
        "\t" +
        bin_path +
        "\t" +
        (if need_qbe { "1" } else { "0" }) +
        "\t" +
        drv_join_char(job.link_opts.libs, usep) +
        "\t" +
        drv_join_char(job.dep_objs, usep) +
        "\t" +
        (if job.run_idx.length() > 0 { job.run_idx[0].to_string() } else { "-" }) +
        "\t" +
        job_gi.to_string() +
        "\t" +
        drv_join_char(job.link_opts.frameworks, usep) +
        "\t" +
        drv_join_char(job.link_opts.search_paths, usep) +
        "\t" +
        drv_join_char(job.link_opts.rpaths, usep) +
        "\t" +
        drv_join_char(job.link_opts.objects, usep) +
        "\t" +
        drv_join_char(job.link_opts.flags, usep) +
        "\t" +
        (if job.link_opts.has_cxx { "1" } else { "0" }),
      )
    }
    j = j + 1
  }

  // Phase 1: compile + link the missing test binaries in parallel; each worker
  // runs its binary's first selected test right away, so the (macOS: ~150 ms
  // first-exec code-signing assessment of a new) binary overlaps other builds.
  let nb = build_lines.length()
  if nb > 0 {
    if pin.lock_handle >= 0L {
      let _ = drv_cas_pin_flush(world, pin)
    }
    let spec = drv_join_char(build_lines, "\n")
    let nw = if nb < nw_max { nb } else { nw_max }
    let cursor = AtomicInt::new(0)
    let err_ch : Channel[String] = Channel::new(nb + 1)
    let first_ch : Channel[String] = Channel::new(nb + 1)
    let stamp = drv_tmp_tag(world, "test_bins")
    let tools = apple_tools
    let qb = qbe_bin
    let qt = qbe_target
    let qmv = qbe_macos_ver
    let tr = cc1as_triple
    let rt = rt_lib
    let dobj = direct_obj
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let items = drv_split_char(spec, 10)
          while true {
            let bi = cursor.fetch_add(1)
            if bi >= items.length() {
              break
            }
            let f = drv_split_char(items[bi], 9)
            if f.length() < 14 {
              let _ = err_ch.send(bi.to_string() + "\tmalformed test build spec")
              continue
            }
            let job_opts = DrvLinkOpts::{
              libs: drv_split_char(f[4], 31),
              frameworks: drv_split_char(f[8], 31),
              search_paths: drv_split_char(f[9], 31),
              rpaths: drv_split_char(f[10], 31),
              objects: drv_split_char(f[11], 31),
              flags: drv_split_char(f[12], 31),
              has_cxx: f[13] == "1",
            }
            match drv_build_test_bin(
              world,
              tools,
              qb,
              qt,
              dobj,
              qmv,
              tr,
              rt,
              f[0],
              f[1],
              f[2],
              f[3] == "1",
              job_opts,
              drv_split_char(f[5], 31),
              stamp + "_" + bi.to_string(),
              as_json,
            ) {
              Err(e) => {
                let _ = err_ch.send(bi.to_string() + "\t" + e)
              }
              Ok(_) => {
                if f[6] != "-" {
                  let rc = drv_exec_test_child(world, f[2], f[6], as_json)
                  let _ = first_ch.send(f[7] + "\t" + rc.to_string())
                }
              }
            }
          }
        })
        wi = wi + 1
      }
    })
    err_ch.close()
    first_ch.close()
    while true {
      match first_ch.recv() {
        Some(msg) => {
          let gi = drv_msg_idx(msg)
          if gi >= 0 && gi < rcs.length() {
            rcs[gi] = if drv_msg_payload(msg) == "0" { 0 } else { 1 }
          }
        }
        None => break
      }
    }
    let mut si = 0
    while si < new_ssa.length() {
      let _ = fs_remove(world, new_ssa[si])
      si = si + 1
    }
    let mut has_err = false
    let mut first_idx = 0
    let mut first_msg = ""
    while true {
      match err_ch.recv() {
        Some(msg) => {
          let ei = drv_msg_idx(msg)
          if !has_err || ei < first_idx {
            has_err = true
            first_idx = ei
            first_msg = drv_msg_payload(msg)
          }
        }
        None => break
      }
    }
    if has_err {
      return Err(first_msg)
    }
    let sizes : Array[Int64] = []
    let mut ki = 0
    while ki < new_keys.length() {
      let sz = fs_size(world, tb_dir + "/" + new_keys[ki])
      sizes.push(if sz > 0L { sz } else { 0L })
      ki = ki + 1
    }
    let tkeys : Array[String] = []
    ki = 0
    while ki < new_keys.length() {
      tkeys.push("testbin:" + new_keys[ki])
      ki = ki + 1
    }
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      tkeys,
      sizes,
      pin,
    )
  } else {
    let _ = drv_cas_pin_flush(world, pin)
  }

  if trace_cas {
    io_eprintln(world, "[test] bins built=" + nb.to_string())
  }
  // Phase 2: run every remaining selected test in its own process, in parallel.
  let t_run0 = clock_now_ms(world)
  let run_lines : Array[String] = []
  let mut gi_run = 0
  j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let mut ri = 0
    while ri < job.run_idx.length() {
      if rcs[gi_run] < 0 {
        run_lines.push(bins[j] + "\t" + job.run_idx[ri].to_string() + "\t" + gi_run.to_string())
      }
      gi_run = gi_run + 1
      ri = ri + 1
    }
    j = j + 1
  }
  let nr = run_lines.length()
  if nr == 1 || nw_max <= 1 {
    let mut ri = 0
    while ri < nr {
      let f = drv_split_char(run_lines[ri], 9)
      let gi = drv_msg_idx(f[2] + "\t")
      let rc = drv_exec_test_child(world, f[0], f[1], as_json)
      rcs[gi] = if rc == 0 { 0 } else { 1 }
      ri = ri + 1
    }
  } else if nr > 1 {
    let spec = drv_join_char(run_lines, "\n")
    let nw = if nr < nw_max { nr } else { nw_max }
    let cursor = AtomicInt::new(0)
    let res_ch : Channel[String] = Channel::new(nr + 1)
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let items = drv_split_char(spec, 10)
          while true {
            let ri = cursor.fetch_add(1)
            if ri >= items.length() {
              break
            }
            let f = drv_split_char(items[ri], 9)
            let rc = drv_exec_test_child(world, f[0], f[1], as_json)
            let _ = res_ch.send(f[2] + "\t" + rc.to_string())
          }
        })
        wi = wi + 1
      }
    })
    res_ch.close()
    while true {
      match res_ch.recv() {
        Some(msg) => {
          let gi = drv_msg_idx(msg)
          if gi >= 0 && gi < rcs.length() {
            rcs[gi] = if drv_msg_payload(msg) == "0" { 0 } else { 1 }
          }
        }
        None => break
      }
    }
  }

  if trace_cas {
    io_eprintln(world, "[test] run=" + (clock_now_ms(world) - t_run0).to_string() + "ms tests=" + nr.to_string())
  }
  let mut gi = 0
  j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let mut ri = 0
    while ri < job.run_idx.length() {
      let tname = job.names[job.run_idx[ri]]
      let ok = rcs[gi] == 0
      out_pkgs.push(job.label)
      out_names.push(tname)
      out_oks.push(ok)
      if !as_json {
        let shown = if job.label.length() > 0 {
          job.label + "::" + tname
        } else {
          tname
        }
        io_println(world, "test " + shown + " ... " + (if ok { "ok" } else { "FAILED" }))
      }
      gi = gi + 1
      ri = ri + 1
    }
    j = j + 1
  }
  Ok(())
}

///|
struct DrvTrans {
  topo : Array[Array[Int]]
  names : Array[Array[String]]
  topo_names : Array[Array[String]]
}

///|
/// Exact transitive dependency closure of every package, in topo order (`topo` / `topo_names`)
/// and as sorted names (`names`, the CAS key's upstream list).
fn drv_trans_deps(nodes : Array[PkgNodeInput], order : Array[Int]) -> DrvTrans {
  let n = order.length()
  let name_to_topo : Map[String, Int] = Map([])
  let mut k = 0
  while k < n {
    name_to_topo.set(nodes[order[k]].name, k)
    k = k + 1
  }
  let trans_dep_topo : Array[Array[Int]] = []
  let trans_dep_names : Array[Array[String]] = []
  let trans_dep_topo_names : Array[Array[String]] = []
  k = 0
  while k < n {
    let seen : Array[Bool] = []
    let mut si = 0
    while si < n {
      seen.push(false)
      si = si + 1
    }
    let node = nodes[order[k]]
    let mut di = 0
    while di < node.deps.length() {
      match name_to_topo.get(node.deps[di]) {
        Some(didx) => {
          seen[didx] = true
          let dtrans = trans_dep_topo[didx]
          let mut ti = 0
          while ti < dtrans.length() {
            seen[dtrans[ti]] = true
            ti = ti + 1
          }
        }
        None => ()
      }
      di = di + 1
    }
    let t_topo : Array[Int] = []
    let t_names : Array[String] = []
    let t_topo_names : Array[String] = []
    let mut u = 0
    while u < k {
      if seen[u] {
        t_topo.push(u)
        let uname = nodes[order[u]].name
        t_names.push(uname)
        t_topo_names.push(uname)
      }
      u = u + 1
    }
    drv_sort_strings(t_names)
    trans_dep_topo.push(t_topo)
    trans_dep_names.push(t_names)
    trans_dep_topo_names.push(t_topo_names)
    k = k + 1
  }
  DrvTrans::{
    topo: trans_dep_topo,
    names: trans_dep_names,
    topo_names: trans_dep_topo_names,
  }
}

///|
struct DrvNeededObjs {
  obj_paths : Array[String]
  obj_keys : Array[String]
  stub_paths : Array[String]
  loaded_imported : Array[Option[ImportedPkg]]
}

///|
/// One CAS build over the whole workspace graph: every package with
/// `need[topo_idx]` gets its object (hit or compiled, all misses compiled in
/// one parallel batch) and its interface stub, shared by every tested package.
fn drv_build_needed_objects(
  world : World,
  nodes : Array[PkgNodeInput],
  order : Array[Int],
  trans : DrvTrans,
  need : Array[Bool],
  jobs : Int,
  quiet : Bool,
  active_target : String,
  pin : DrvCasPinSession,
) -> Result[DrvNeededObjs, String] {
  let n = order.length()
  let obj_paths : Array[String] = []
  let obj_keys : Array[String] = []
  let stub_paths : Array[String] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let mut k = 0
  while k < n {
    obj_paths.push("")
    obj_keys.push("")
    stub_paths.push("")
    loaded_imported.push(None)
    k = k + 1
  }
  let mut any = false
  k = 0
  while k < n {
    if need[k] {
      any = true
    }
    k = k + 1
  }
  if !any {
    return Ok(DrvNeededObjs::{
      obj_paths: obj_paths,
      obj_keys: obj_keys,
      stub_paths: stub_paths,
      loaded_imported: loaded_imported,
    })
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let qbe_target = if active_target != "" {
    active_target
  } else {
    drv_resolve_qbe_target(world)
  }
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, "", quiet, pin) {
    Err(e) => return Err(e)
    Ok(p) => p
  }
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib, qbe_target, "")
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let sig_hashes : Map[String, String] = Map([])
  let stub_hashes : Map[String, String] = Map([])
  let miss_ssa_paths : Array[String] = []
  let miss_obj_paths : Array[String] = []
  let miss_keys : Array[String] = []
  k = 0
  while k < n {
    if !need[k] {
      k = k + 1
      continue
    }
    let node = nodes[order[k]]
    let upstream_sigs : Array[String] = []
    let t_names = trans.names[k]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      let stub_h = match stub_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh + ":" + stub_h)
      u = u + 1
    }
    drv_append_dep_alias_sigs(upstream_sigs, node)
    let key = cas_compute_key(
      node.name,
      drv_cas_rel_paths(node),
      node.sources,
      upstream_sigs,
      qbe_target,
      false,
      compiler_fp,
    )
    let obj_path = cache_dir + "/obj/" + key + ".o"
    let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
    let sig_path = cache_dir + "/sig/" + key + ".pionsig"
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"
    drv_cas_pin_add(pin, key)
    obj_keys[k] = key
    let mut cas_hit = false
    if drv_is_nonempty_regular_file(world, obj_path) &&
      drv_is_regular_file(sig_path) &&
      drv_is_regular_file(stub_path) &&
      drv_cas_pin_and_verify(world, cache_dir, pin, [key], [obj_path]) {
      match (fs_read(world, sig_path), fs_read(world, stub_path)) {
        (Ok(sig_text), Ok(stub_text)) => {
          sig_hashes.set(node.name, drv_effective_sig_hash(sig_text, node, sig_hashes))
          stub_hashes.set(node.name, drv_stub_hash(stub_text, node.sources))
          stub_paths[k] = stub_path
          cas_hit = true
          if trace_cas {
            io_eprintln(world, "[cas] pkg=" + node.declared_name + " HIT key=" + drv_prefix16(key))
          }
        }
        _ => ()
      }
    }
    if !cas_hit {
      if trace_cas {
        io_eprintln(world, "[cas] pkg=" + node.declared_name + " MISS key=" + drv_prefix16(key))
      }
      let k_imports = drv_ensure_ws_imports(
        world,
        nodes,
        order,
        trans.topo,
        stub_paths,
        loaded_imported,
        k,
      )
      let cr = check_source_files_with_imports_mapped(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        node.dep_aliases,
        node.deps,
        true,
        false,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
      cr.tc.pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
      loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      let pionsig = emit_pionsig(cr.pkg)
      sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
      let pionstub = emit_pion_stub(cr.pkg)
      stub_hashes.set(node.name, drv_stub_hash(pionstub, node.sources))
      let res = emit_qbe_package_multi_entry_target(
        cr.pkg,
        cr.tc,
        false,
        false,
        trans.topo_names[k],
        false,
        qbe_target,
        "main",
        false,
      )
      let _ = drv_write_cas_text_atomic(world, sig_path, pionsig)
      let _ = drv_write_cas_text_atomic(world, stub_path, pionstub)
      stub_paths[k] = stub_path
      if !drv_write_cas_text_atomic(world, ssa_path, res.ssa) {
        return Err("failed to write CAS ssa: " + ssa_path)
      }
      miss_ssa_paths.push(ssa_path)
      miss_obj_paths.push(obj_path)
      miss_keys.push(key)
    }
    obj_paths[k] = obj_path
    k = k + 1
  }
  match drv_compile_missed(
    world,
    qbe_bin,
    qbe_target,
    apple_tools,
    direct_obj,
    qbe_macos_ver,
    cc1as_triple,
    "",
    miss_ssa_paths,
    miss_obj_paths,
    jobs,
    quiet,
  ) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let _ = drv_cas_pin_flush(world, pin)
  if miss_keys.length() > 0 {
    let miss_sizes : Array[Int64] = []
    let mut mi = 0
    while mi < miss_keys.length() {
      let sz = fs_size(world, miss_obj_paths[mi])
      miss_sizes.push(if sz > 0L { sz } else { 0L })
      mi = mi + 1
    }
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      miss_keys,
      miss_sizes,
      pin,
    )
  }
  Ok(DrvNeededObjs::{
    obj_paths: obj_paths,
    obj_keys: obj_keys,
    stub_paths: stub_paths,
    loaded_imported: loaded_imported,
  })
}

///|
fn drv_print_test_summary(world : World, oks : Array[Bool]) -> Int {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < oks.length() {
    if oks[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "test result: " +
    (if failed == 0 { "ok" } else { "FAILED" }) +
    ". " +
    passed.to_string() +
    " passed; " +
    failed.to_string() +
    " failed",
  )
  if failed == 0 { 0 } else { 1 }
}

///|
/// Length-prefixed string array serialization (`Send`-safe framing across `spawn`).
fn drv_pack_str_list(items : Array[String]) -> String {
  let sb = StringBuilder()
  sb.write_string(items.length().to_string())
  sb.write_string(":")
  let mut i = 0
  while i < items.length() {
    sb.write_string(items[i].length().to_string())
    sb.write_string(":")
    sb.write_string(items[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Internal decoder for strings produced by `drv_pack_str_list` only;
/// not intended for untrusted external input.
fn drv_unpack_str_list(s : String) -> Array[String] {
  let out : Array[String] = []
  let slen = s.length()
  let mut pos = 0
  let mut count = 0
  while pos < slen {
    let ch = str_code_at(s, pos)
    if ch == 58 {
      pos = pos + 1
      break
    }
    if ch >= 48 && ch <= 57 {
      count = count * 10 + (ch - 48)
    }
    pos = pos + 1
  }
  let mut i = 0
  while i < count && pos <= slen {
    let mut item_len = 0
    while pos < slen {
      let ch = str_code_at(s, pos)
      if ch == 58 {
        pos = pos + 1
        break
      }
      if ch >= 48 && ch <= 57 {
        item_len = item_len * 10 + (ch - 48)
      }
      pos = pos + 1
    }
    let end = if pos + item_len <= slen { pos + item_len } else { slen }
    out.push(slice_str(s, pos, end))
    pos = end
    i = i + 1
  }
  out
}

///|
fn drv_pack_int_list(items : Array[Int]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(items[i].to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn drv_unpack_int_list(s : String) -> Array[Int] {
  let out : Array[Int] = []
  if s.length() == 0 {
    return out
  }
  let parts = drv_split_char(s, 44)
  let mut i = 0
  while i < parts.length() {
    if parts[i].length() > 0 {
      let mut acc = 0
      let mut j = 0
      while j < parts[i].length() {
        let ch = str_code_at(parts[i], j)
        if ch >= 48 && ch <= 57 {
          acc = acc * 10 + (ch - 48)
        }
        j = j + 1
      }
      out.push(acc)
    }
    i = i + 1
  }
  out
}

///|
/// Internal decoder for non-negative decimal index strings produced by the
/// driver itself; not intended for untrusted external input.
fn drv_parse_nonneg_decimal(s : String) -> Int {
  let mut acc = 0
  let mut i = 0
  while i < s.length() {
    let ch = str_code_at(s, i)
    if ch >= 48 && ch <= 57 {
      acc = acc * 10 + (ch - 48)
    }
    i = i + 1
  }
  acc
}

///|
extern "C" fn c_fs_rmdir(path : Ptr) -> Int = "pion_fs_rmdir"

///|
/// Single `lstat` (never follows symlinks): returns `Some(size)` iff `path` is
/// a regular file (`kind == "file"`) with positive byte size (`size > 0L`).
fn drv_lstat_regular_size(world : World, path : String) -> Option[Int64] {
  match fs_lstat(world, path) {
    Ok(info) => {
      let parts = drv_split_char(info, 124)
      if parts.length() >= 2 && parts[0] == "file" {
        let sz = drv_parse_pos_int64(parts[1], 0L)
        if sz > 0L {
          Some(sz)
        } else {
          None
        }
      } else {
        None
      }
    }
    Err(_) => None
  }
}

///|
/// Removes every file inside `stage_dir` and then removes `stage_dir` itself
/// using cross-platform runtime file APIs (zero `rm`/`chmod` subprocesses).
fn drv_clean_cstub_stage_dir(
  world : World,
  stage_dir : String,
) -> Result[Unit, String] {
  let entries = fs_list_dir(world, stage_dir)
  let mut i = 0
  while i < entries.length() {
    let full = stage_dir + "/" + entries[i]
    if !fs_remove(world, full) {
      return Err("failed to remove c_source staging dir " + stage_dir)
    }
    i = i + 1
  }
  let dir_local = stage_dir
  if c_fs_rmdir(drv_cpath(dir_local)) != 0 {
    return Err("failed to remove c_source staging dir " + stage_dir)
  }
  Ok(())
}

///|
fn drv_cstub_fail_with_cleanup(
  world : World,
  stage_dir : String,
  msg : String,
) -> Result[Unit, String] {
  match drv_clean_cstub_stage_dir(world, stage_dir) {
    Ok(_) => Err(msg)
    Err(_) => Err(msg + "; cleanup failed for " + stage_dir)
  }
}

///|
/// Compiles all needed packages' `c_sources` for `pionc test` in parallel
/// (bounded by `jobs`), while populating `pkg_cstub_objs[k]` and `pkg_cstub_cxx[k]`
/// in deterministic `(k, si)` order so final link order never depends on thread
/// completion order. Any C stub compilation failure is propagated deterministically.
fn drv_compile_ws_c_sources_parallel(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  need_cstub : Array[Bool],
  qbe_target : String,
  rt_lib : String,
  cache_dir : String,
  trace_cas : Bool,
  jobs : Int,
  file_hash_memo : Map[String, String],
  pkg_cstub_objs : Array[Array[String]],
  pkg_cstub_keys : Array[Array[String]],
  pkg_cstub_cxx : Array[Bool],
  cstub_new_keys : Array[String],
  cstub_new_sizes : Array[Int64],
  pin : DrvCasPinSession,
  quiet : Bool,
) -> Result[Unit, String] {
  let os = drv_target_os(qbe_target)
  let rt_inc_dirs = drv_cstub_rt_inc_dirs(world, rt_lib, cache_dir)
  let rt_inc_dirs_joined = drv_join_char(rt_inc_dirs, "\n")
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let cxx_bin = drv_resolve_cc_driver(world, qbe_target, true)
  let base_cc_flags = drv_target_cc_flags(world, qbe_target, "")
  let cc_ver_cache : Map[String, String] = Map([])
  let miss_specs : Array[String] = []
  let miss_src_paths : Array[String] = []
  let miss_norm_srcs : Array[String] = []
  let miss_src_hashes : Array[String] = []
  let miss_pre_hash_ms : Array[Int64] = []
  let miss_search_dirs : Array[Array[String]] = []
  let miss_base_keys : Array[String] = []
  let miss_is_cl_exe : Array[Bool] = []
  let seen_miss_base : Map[String, Int] = Map([])
  let bf_pkg : Array[Int] = []
  let bf_slot : Array[Int] = []
  let bf_miss : Array[Int] = []
  let mut made_obj_dir = false
  let n = topo_order.length()
  let mut k = 0
  while k < n {
    if need_cstub[k] {
      let node = nodes[topo_order[k]]
      let plat = if os == "macos" {
        node.link_macos
      } else if os == "ios" {
        node.link_ios
      } else if os == "android" {
        node.link_android
      } else if os == "windows" {
        node.link_windows
      } else if os == "wasm" {
        node.link_wasm
      } else {
        node.link_linux
      }
      let c_sources : Array[String] = []
      let mut i = 0
      while i < node.link_common.c_sources.length() {
        push_unique_lib(
          c_sources,
          drv_resolve_pkg_path(node.dir, node.link_common.c_sources[i]),
        )
        i = i + 1
      }
      i = 0
      while i < plat.c_sources.length() {
        push_unique_lib(
          c_sources,
          drv_resolve_pkg_path(node.dir, plat.c_sources[i]),
        )
        i = i + 1
      }
      if c_sources.length() > 0 {
        if !made_obj_dir {
          let _ = fs_mkdir_p(world, cache_dir + "/obj")
          made_obj_dir = true
        }
        let cc_flags : Array[String] = []
        i = 0
        while i < base_cc_flags.length() {
          cc_flags.push(base_cc_flags[i])
          i = i + 1
        }
        i = 0
        while i < node.link_common.cc_flags.length() {
          cc_flags.push(drv_resolve_cc_flag(node.dir, node.link_common.cc_flags[i]))
          i = i + 1
        }
        i = 0
        while i < plat.cc_flags.length() {
          cc_flags.push(drv_resolve_cc_flag(node.dir, plat.cc_flags[i]))
          i = i + 1
        }
        let cstub_objs : Array[String] = []
        let cstub_keys : Array[String] = []
        let mut any_cxx = false
        let mut si = 0
        while si < c_sources.length() {
          let src_path = c_sources[si]
          if !fs_exists(world, src_path) {
            return Err("c_source does not exist: " + src_path)
          }
          let is_cxx = drv_is_cxx_source(src_path)
          if is_cxx {
            any_cxx = true
          }
          let compiler = if is_cxx { cxx_bin } else { cc_bin }
          let cc_ver_fp = drv_cstub_cc_version_fp(world, compiler, cc_ver_cache)
          let eff_cc_flags : Array[String] = []
          let mut efi = 0
          while efi < cc_flags.length() {
            eff_cc_flags.push(cc_flags[efi])
            efi = efi + 1
          }
          let sec_flags = drv_c_source_section_flags(compiler, qbe_target, cc_flags)
          efi = 0
          while efi < sec_flags.length() {
            eff_cc_flags.push(sec_flags[efi])
            efi = efi + 1
          }
          let eff_cc_flags_joined = drv_join_char(eff_cc_flags, "\n")
          let pre_hash_ms = clock_now_ms(world)
          let src_hash = match drv_sha256_file(src_path, file_hash_memo) {
            Some(h) => h
            None => return Err("failed to read c_source " + src_path)
          }
          let norm_src = drv_cstub_canon_path(world, src_path)
          let search_dirs = drv_cstub_collect_search_dirs(
            world,
            src_path,
            eff_cc_flags,
            rt_inc_dirs,
          )
          let base_key = drv_cstub_base_key(
            qbe_target,
            node.name,
            compiler,
            cc_ver_fp,
            eff_cc_flags_joined,
            rt_inc_dirs_joined,
            norm_src,
            src_hash,
          )
          let mut hit_final_key = ""
          match drv_cstub_try_hit(world, cache_dir, src_path, base_key, trace_cas, file_hash_memo) {
            Some(fk) => {
              let obj_path = cache_dir + "/obj/cstub_" + fk + ".o"
              if drv_cas_pin_and_verify(
                world,
                cache_dir,
                pin,
                ["cstub_" + fk, "cstub_dep_" + base_key],
                [obj_path],
              ) {
                hit_final_key = fk
              }
            }
            None => ()
          }
          if hit_final_key.length() > 0 {
            let obj_path = cache_dir + "/obj/cstub_" + hit_final_key + ".o"
            if trace_cas {
              io_eprintln(
                world,
                "[cas] cstub=" + src_path + " HIT key=" + drv_prefix16(hit_final_key),
              )
            }
            cstub_objs.push(obj_path)
            cstub_keys.push("cstub_" + hit_final_key)
          } else {
            let mi = match seen_miss_base.get(base_key) {
              Some(idx) => idx
              None => {
                let idx = miss_specs.length()
                seen_miss_base.set(base_key, idx)
                let argv : Array[String] = [compiler]
                let mut fi = 0
                while fi < eff_cc_flags.length() {
                  argv.push(eff_cc_flags[fi])
                  fi = fi + 1
                }
                let mut ri = 0
                while ri < rt_inc_dirs.length() {
                  argv.push("-I" + rt_inc_dirs[ri])
                  ri = ri + 1
                }
                argv.push("-c")
                argv.push(src_path)
                let is_cl = drv_is_cl_exe_driver(compiler)
                miss_specs.push(
                  drv_pack_str_list([
                    src_path,
                    compiler,
                    drv_pack_str_list(argv),
                  ]),
                )
                miss_src_paths.push(src_path)
                miss_norm_srcs.push(norm_src)
                miss_src_hashes.push(src_hash)
                miss_pre_hash_ms.push(pre_hash_ms)
                miss_search_dirs.push(search_dirs)
                miss_base_keys.push(base_key)
                miss_is_cl_exe.push(is_cl)
                idx
              }
            }
            let slot = cstub_objs.length()
            cstub_objs.push("")
            cstub_keys.push("")
            bf_pkg.push(k)
            bf_slot.push(slot)
            bf_miss.push(mi)
          }
          si = si + 1
        }
        pkg_cstub_objs[k] = cstub_objs
        pkg_cstub_keys[k] = cstub_keys
        pkg_cstub_cxx[k] = any_cxx
      }
    }
    k = k + 1
  }
  let nm = miss_specs.length()
  if nm == 0 {
    return Ok(())
  }
  let nw_max = if jobs > 0 { jobs } else { drv_default_jobs(world) }
  let stage_dir = match drv_mktemp_dir_near(world, cache_dir + "/obj/cstub_stage") {
    Ok(d) => d
    Err(e) => return Err(e)
  }
  let miss_tmp_paths : Array[String] = []
  let miss_dep_paths : Array[String] = []
  let mut ti = 0
  while ti < nm {
    miss_tmp_paths.push(stage_dir + "/obj_" + ti.to_string() + ".o")
    miss_dep_paths.push(stage_dir + "/dep_" + ti.to_string() + ".d")
    ti = ti + 1
  }
  let compile_start_ms = clock_now_ms(world)
  // Phase 1: compile all missed C stubs into this process's exclusive staging
  // directory only (never publish inside compile loops or worker threads so a
  // partial failure leaves zero orphan `.o` files and never touches another
  // concurrent process's staging files).
  if nm == 1 || nw_max <= 1 {
    let mut ji = 0
    while ji < nm {
      let fields = drv_unpack_str_list(miss_specs[ji])
      let src_path = fields[0]
      let compiler = fields[1]
      let argv = drv_unpack_str_list(fields[2])
      let obj_tmp = miss_tmp_paths[ji]
      let dep_tmp = miss_dep_paths[ji]
      drv_cstub_append_dep_args(argv, compiler, dep_tmp, obj_tmp)
      let rc = drv_exec_quiet(world, argv, quiet)
      if rc != 0 {
        return drv_cstub_fail_with_cleanup(
          world,
          stage_dir,
          "failed to compile c_source " +
          src_path +
          " with " +
          compiler +
          " (exit code " +
          rc.to_string() +
          ")",
        )
      }
      ji = ji + 1
    }
  } else {
    let nw = if nm < nw_max { nm } else { nw_max }
    let packed_all = drv_pack_str_list(miss_specs)
    let cursor = AtomicInt::new(0)
    let err_ch : Channel[String] = Channel::new(nm + 1)
    let sdir = stage_dir
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let items = drv_unpack_str_list(packed_all)
          while true {
            let ji = cursor.fetch_add(1)
            if ji >= items.length() {
              break
            }
            let fields = drv_unpack_str_list(items[ji])
            let src_path = fields[0]
            let compiler = fields[1]
            let argv = drv_unpack_str_list(fields[2])
            let obj_tmp = sdir + "/obj_" + ji.to_string() + ".o"
            let dep_tmp = sdir + "/dep_" + ji.to_string() + ".d"
            drv_cstub_append_dep_args(argv, compiler, dep_tmp, obj_tmp)
            let rc = drv_exec_quiet(world, argv, quiet)
            if rc != 0 {
              let _ = err_ch.send(
                ji.to_string() +
                "\tfailed to compile c_source " +
                src_path +
                " with " +
                compiler +
                " (exit code " +
                rc.to_string() +
                ")",
              )
            }
          }
        })
        wi = wi + 1
      }
    })
    err_ch.close()
    let mut has_err = false
    let mut first_idx = 0
    let mut first_msg = ""
    while true {
      match err_ch.recv() {
        Some(msg) => {
          let ei = drv_msg_idx(msg)
          if !has_err || ei < first_idx {
            has_err = true
            first_idx = ei
            first_msg = drv_msg_payload(msg)
          }
        }
        None => break
      }
    }
    if has_err {
      return drv_cstub_fail_with_cleanup(world, stage_dir, first_msg)
    }
  }
  // Phase 2: all compiles succeeded; verify each staged object via `lstat`
  // (non-empty regular file, no symlinks), parse & hash real header deps,
  // publish sequentially on the main thread, and backfill `pkg_cstub_objs`.
  let resolved_objs : Array[String] = []
  let resolved_keys : Array[String] = []
  let mut keep_stage = false
  let mut mi = 0
  while mi < nm {
    match
      drv_cstub_publish_one(
        world,
        cache_dir,
        stage_dir,
        miss_src_paths[mi],
        miss_norm_srcs[mi],
        miss_src_hashes[mi],
        miss_base_keys[mi],
        miss_is_cl_exe[mi],
        miss_tmp_paths[mi],
        miss_dep_paths[mi],
        miss_pre_hash_ms[mi],
        miss_search_dirs[mi],
        trace_cas,
        cstub_new_keys,
        cstub_new_sizes,
        pin,
      )
    {
      Err(e) => return drv_cstub_fail_with_cleanup(world, stage_dir, e)
      Ok((final_key, dst_p, kept_local)) => {
        if kept_local {
          keep_stage = true
        }
        resolved_objs.push(dst_p)
        resolved_keys.push(if kept_local { "" } else { "cstub_" + final_key })
      }
    }
    mi = mi + 1
  }
  let mut bi = 0
  while bi < bf_pkg.length() {
    pkg_cstub_objs[bf_pkg[bi]][bf_slot[bi]] = resolved_objs[bf_miss[bi]]
    pkg_cstub_keys[bf_pkg[bi]][bf_slot[bi]] = resolved_keys[bf_miss[bi]]
    bi = bi + 1
  }
  if keep_stage {
    pin.temp_dirs.push(stage_dir)
    Ok(())
  } else {
    drv_clean_cstub_stage_dir(world, stage_dir)
  }
}

///|
fn drv_test_fail(world : World, as_json : Bool, msg : String) -> Int {
  if as_json {
    if drv_starts_with(msg, "{\"ok\":") || drv_starts_with(msg, "{\"diagnostics\":") {
      io_println(world, msg)
    } else {
      io_println(world, "{\"ok\":false,\"error\":" + drv_json_q(msg) + "}")
    }
  } else if drv_starts_with(msg, "error:") || drv_starts_with(msg, "{") {
    io_eprintln(world, msg)
  } else {
    io_eprintln(world, "error: " + msg)
  }
  1
}

///|
fn drv_exec_wasm_test_units(
  world : World,
  label : String,
  ssa_units : Array[String],
  tnames : Array[String],
  run_idx : Array[Int],
  as_json : Bool,
  out_pkgs : Array[String],
  out_names : Array[String],
  out_oks : Array[Bool],
  pin : DrvCasPinSession,
) -> Result[Unit, String] {
  if run_idx.length() == 0 {
    return Ok(())
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let tb_dir = cache_dir + "/testbin"
  let _ = fs_mkdir_p(world, tb_dir)
  let wasm_fp = drv_compute_self_fp(world, "wasm32-test-v1")
  let ksb = StringBuilder()
  ksb.write_string(wasm_fp)
  ksb.write_string("|testwasm|")
  let mut ui = 0
  while ui < ssa_units.length() {
    ksb.write_string(sha256_hex(ssa_units[ui]))
    ksb.write_string("|")
    ui = ui + 1
  }
  let wkey = sha256_hex(ksb.to_string())
  let wasm_path = tb_dir + "/" + wkey + ".wasm"
  let mut active_wasm_path = wasm_path
  let wasm_tkey = "testbin:" + wkey + ".wasm"
  let wasm_hit = drv_is_nonempty_regular_file(world, wasm_path) &&
    drv_cas_pin_and_verify(world, cache_dir, pin, [wasm_tkey], [wasm_path])
  if !wasm_hit {
    let wasm_bytes = emit_wasm_from_ssa_units_opts(
      ssa_units,
      false,
      fn(_s : String) -> Unit { () },
    )
    let tmp_path = wasm_path + ".tmp." + drv_tmp_tag(world, wkey)
    match fs_write_bytes(world, tmp_path, wasm_bytes) {
      Err(e) => {
        let _ = fs_remove(world, tmp_path)
        return Err("failed to write wasm test module " + tmp_path + ": " + e)
      }
      Ok(_) => ()
    }
    if drv_cas_publish_file_pinned(world, cache_dir, pin, [wasm_tkey], tmp_path, wasm_path) {
      let sz = fs_size(world, wasm_path)
      drv_cas_record_batch_and_evict_pinned(
        world,
        cache_dir,
        [wasm_tkey],
        [if sz > 0L { sz } else { 0L }],
        pin,
      )
    } else {
      pin.temp_files.push(tmp_path)
      active_wasm_path = tmp_path
    }
  }
  let rt_mjs = drv_resolve_wasm_rt(world)
  if !fs_exists(world, rt_mjs) {
    return Err("wasm32 test runner unavailable: missing runtime " + rt_mjs)
  }
  match proc_exec_capture(world, ["node", "--version"]) {
    Err(e) => return Err("wasm32 test runner unavailable: node not found (" + e + ")")
    Ok(_) => ()
  }
  let mut ri = 0
  while ri < run_idx.length() {
    let tidx = run_idx[ri]
    let tname = tnames[tidx]
    let rc = if as_json {
      match proc_exec_capture(world, ["node", rt_mjs, active_wasm_path, tidx.to_string()]) {
        Ok(_) => 0
        Err(_) => 1
      }
    } else {
      proc_exec(world, ["node", rt_mjs, active_wasm_path, tidx.to_string()])
    }
    let ok = rc == 0
    out_pkgs.push(label)
    out_names.push(tname)
    out_oks.push(ok)
    if !as_json {
      let prefix = if label.length() > 0 { label + "::" } else { "" }
      if ok {
        io_println(world, "ok   " + prefix + tname)
      } else {
        io_println(world, "FAIL " + prefix + tname)
      }
    }
    ri = ri + 1
  }
  Ok(())
}

///|
fn drv_run_ws_tests_collect(
  world : World,
  root_dir : String,
  as_json : Bool,
  filter : String,
  cli_libs : Array[String],
  only_pkg : String,
  no_deps : Bool,
  jobs : Int,
  locked : Bool,
  offline : Bool,
  active_target : String,
  out_tested : Array[String],
  out_pkgs : Array[String],
  out_names : Array[String],
  out_oks : Array[Bool],
) -> Result[Int, String] {
  let trace = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let t_start = clock_now_ms(world)
  let ws = match drv_load_workspace_opts_target(
    world,
    root_dir,
    locked,
    offline,
    "",
    active_target,
  ) {
    Err(msg) => return Err(msg)
    Ok(v) => v
  }
  let nodes = ws.nodes
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return Err(check_result_to_json(topo.diagnostics))
  }
  let no_deps_dirs : Map[String, Bool] = Map([])
  if no_deps {
    let root_abs = drv_canon_dir(world, root_dir)
    let root_mf_path = drv_join_path(root_abs, "pion.toml")
    let mut is_virtual_ws = false
    if fs_exists(world, root_mf_path) {
      match fs_read(world, root_mf_path) {
        Ok(mf_txt) =>
          match parse_pion_toml(mf_txt) {
            Ok(mf) =>
              if mf.is_workspace {
                is_virtual_ws = true
                match drv_expand_workspace_members(world, root_abs, mf) {
                  Ok(ms) => {
                    let mut mi = 0
                    while mi < ms.length() {
                      no_deps_dirs.set(
                        drv_canon_dir(world, ms[mi]),
                        true,
                      )
                      mi = mi + 1
                    }
                  }
                  Err(_) => ()
                }
              }
            Err(_) => ()
          }
        Err(_) => ()
      }
    }
    if !is_virtual_ws {
      no_deps_dirs.set(root_abs, true)
    }
  }
  let selected : Array[Int] = []
  let mut deps_skipped = 0
  ni = 0
  while ni < nodes.length() {
    let local = !drv_is_external_pkg(ws.git_root, nodes[ni].dir)
    if only_pkg.length() > 0 {
      if nodes[ni].declared_name == only_pkg || nodes[ni].name == only_pkg {
        selected.push(ni)
      }
    } else if no_deps {
      let node_abs = drv_canon_dir(world, nodes[ni].dir)
      if no_deps_dirs.contains(node_abs) {
        selected.push(ni)
      } else if local {
        deps_skipped = deps_skipped + 1
      }
    } else if local {
      selected.push(ni)
    }
    ni = ni + 1
  }
  if only_pkg.length() > 0 && selected.length() == 0 {
    return Err("no package `" + only_pkg + "` in workspace " + root_dir)
  }
  let n = topo.order.length()
  let node_to_topo : Array[Int] = []
  ni = 0
  while ni < nodes.length() {
    node_to_topo.push(-1)
    ni = ni + 1
  }
  let mut k = 0
  while k < n {
    node_to_topo[topo.order[k]] = k
    k = k + 1
  }
  let trans = drv_trans_deps(nodes, topo.order)
  let need : Array[Bool] = []
  k = 0
  while k < n {
    need.push(false)
    k = k + 1
  }
  let mut si = 0
  while si < selected.length() {
    let tk = node_to_topo[selected[si]]
    let td = trans.topo[tk]
    let mut u = 0
    while u < td.length() {
      need[td[u]] = true
      u = u + 1
    }
    si = si + 1
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let pin = drv_cas_pin_open(world, cache_dir)
  if drv_target_is_wasm(active_target) {
    let dep_imported : Array[Option[ImportedPkg]] = []
    let dep_ssas : Array[String] = []
    k = 0
    while k < n {
      dep_imported.push(None)
      dep_ssas.push("")
      k = k + 1
    }
    k = 0
    while k < n {
      if need[k] {
        let node = nodes[topo.order[k]]
        let td = trans.topo[k]
        let k_imports : Array[ImportedPkg] = []
        let mut u = 0
        while u < td.length() {
          match dep_imported[td[u]] {
            Some(ip) => k_imports.push(ip)
            None => ()
          }
          u = u + 1
        }
        let cr = check_source_files_with_imports_mapped(
          node.name,
          node.paths,
          node.sources,
          k_imports,
          node.dep_aliases,
          node.deps,
          true,
          false,
        )
        if cr.diagnostics.length() > 0 {
          return Err(check_result_to_json(cr.diagnostics))
        }
        cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
        cr.tc.pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
        let res = emit_qbe_package_multi_for_target(
          cr.pkg,
          cr.tc,
          false,
          false,
          trans.topo_names[k],
          true,
        )
        let ns_prefix = "p_" + drv_wasm_ns_ident(node.name) + "__"
        dep_ssas[k] = wasm_namespace_local_ssa(res.ssa, ns_prefix)
        dep_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      }
      k = k + 1
    }
    si = 0
    while si < selected.length() {
      let node = nodes[selected[si]]
      let tk = node_to_topo[selected[si]]
      let tpaths : Array[String] = []
      let tsources : Array[String] = []
      let mut pi = 0
      while pi < node.paths.length() {
        tpaths.push(node.paths[pi])
        tsources.push(node.sources[pi])
        pi = pi + 1
      }
      match drv_append_test_sources_for(
        world,
        node.dir,
        node.target_rules,
        active_target,
        tpaths,
        tsources,
      ) {
        Err(msg) => return Err(msg)
        Ok(_) => ()
      }
      let td = trans.topo[tk]
      let k_imports : Array[ImportedPkg] = []
      let dep_names : Array[String] = []
      let ssa_units : Array[String] = []
      let mut u = 0
      while u < td.length() {
        let tu = td[u]
        match dep_imported[tu] {
          Some(ip) => k_imports.push(ip)
          None => ()
        }
        dep_names.push(nodes[topo.order[tu]].name)
        ssa_units.push(dep_ssas[tu])
        u = u + 1
      }
      let cr = check_source_files_with_imports_mapped(
        node.name,
        tpaths,
        tsources,
        k_imports,
        node.dep_aliases,
        node.deps,
        true,
        false,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
      cr.tc.pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
      out_tested.push(node.declared_name)
      let tnames = drv_test_names(cr.pkg)
      let run_idx = drv_filter_tests(tnames, filter)
      if run_idx.length() > 0 {
        let test_res = emit_qbe_test_package_target(cr.pkg, cr.tc, dep_names, "wasm32")
        let ns_prefix = "p_" + drv_wasm_ns_ident(node.name) + "__"
        ssa_units.push(wasm_namespace_local_ssa(test_res.ssa, ns_prefix))
        match drv_exec_wasm_test_units(
          world,
          node.declared_name,
          ssa_units,
          tnames,
          run_idx,
          as_json,
          out_pkgs,
          out_names,
          out_oks,
          pin,
        ) {
          Err(e) => {
            drv_cas_pin_close(world, pin)
            return Err(e)
          }
          Ok(_) => ()
        }
      }
      si = si + 1
    }
    drv_cas_post_run_evict(world, cache_dir, pin, [])
    return Ok(deps_skipped)
  }
  let t_loaded = clock_now_ms(world)
  let built = match drv_build_needed_objects(world, nodes, topo.order, trans, need, jobs, as_json, active_target, pin) {
    Err(msg) => {
      drv_cas_pin_close(world, pin)
      return Err(msg)
    }
    Ok(v) => v
  }
  let t_built = clock_now_ms(world)
  let qbe_target = active_target
  let rt_lib = match drv_resolve_rt_lib_for_pinned(world, qbe_target, "", as_json, pin) {
    Err(msg) => {
      drv_cas_pin_close(world, pin)
      return Err(msg)
    }
    Ok(p) => p
  }
  let need_cstub : Array[Bool] = []
  let pkg_cstub_objs : Array[Array[String]] = []
  let pkg_cstub_keys : Array[Array[String]] = []
  let pkg_cstub_cxx : Array[Bool] = []
  let pkg_rc_objs : Array[Array[String]] = []
  k = 0
  while k < n {
    need_cstub.push(need[k])
    pkg_cstub_objs.push([])
    pkg_cstub_keys.push([])
    pkg_cstub_cxx.push(false)
    pkg_rc_objs.push([])
    k = k + 1
  }
  si = 0
  while si < selected.length() {
    need_cstub[node_to_topo[selected[si]]] = true
    si = si + 1
  }
  let cstub_new_keys : Array[String] = []
  let cstub_new_sizes : Array[Int64] = []
  let file_hash_memo : Map[String, String] = Map([])
  match drv_compile_ws_c_sources_parallel(
    world,
    nodes,
    topo.order,
    need_cstub,
    qbe_target,
    rt_lib,
    cache_dir,
    trace,
    jobs,
    file_hash_memo,
    pkg_cstub_objs,
    pkg_cstub_keys,
    pkg_cstub_cxx,
    cstub_new_keys,
    cstub_new_sizes,
    pin,
    as_json,
  ) {
    Err(msg) => {
      if cstub_new_keys.length() > 0 {
        drv_cas_record_batch_and_evict_pinned(
          world,
          cache_dir,
          cstub_new_keys,
          cstub_new_sizes,
          pin,
        )
      }
      drv_cas_pin_close(world, pin)
      return Err(msg)
    }
    Ok(_) => ()
  }
  k = 0
  while k < n {
    if need_cstub[k] {
      let rc_objs : Array[String] = []
      let rc_keys : Array[String] = []
      match drv_compile_pkg_rc_sources(
        world,
        nodes[topo.order[k]],
        qbe_target,
        cache_dir,
        trace,
        file_hash_memo,
        rc_objs,
        rc_keys,
        cstub_new_keys,
        cstub_new_sizes,
        pin,
        as_json,
      ) {
        Err(msg) => {
          if cstub_new_keys.length() > 0 {
            drv_cas_record_batch_and_evict_pinned(
              world,
              cache_dir,
              cstub_new_keys,
              cstub_new_sizes,
              pin,
            )
          }
          drv_cas_pin_close(world, pin)
          return Err(msg)
        }
        Ok(_) => pkg_rc_objs[k] = rc_objs
      }
    }
    k = k + 1
  }
  let _ = drv_cas_pin_flush(world, pin)
  if cstub_new_keys.length() > 0 {
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      cstub_new_keys,
      cstub_new_sizes,
      pin,
    )
  }
  let test_jobs : Array[DrvTestJob] = []
  let nw_max = if jobs > 0 { jobs } else { drv_default_jobs(world) }
  if selected.length() <= 1 || nw_max <= 1 {
    // Use a fresh empty cache so serial and parallel branches share identical
    // stub-first dependency loading and produce identical test SSA / testobj keys.
    let serial_loaded : Array[Option[ImportedPkg]] = []
    k = 0
    while k < n {
      serial_loaded.push(None)
      k = k + 1
    }
    si = 0
    while si < selected.length() {
      let node = nodes[selected[si]]
      let tk = node_to_topo[selected[si]]
      let tpaths : Array[String] = []
      let tsources : Array[String] = []
      let mut pi = 0
      while pi < node.paths.length() {
        tpaths.push(node.paths[pi])
        tsources.push(node.sources[pi])
        pi = pi + 1
      }
      match drv_append_test_sources_for(
        world,
        node.dir,
        node.target_rules,
        active_target,
        tpaths,
        tsources,
      ) {
        Err(msg) => return Err(msg)
        Ok(_) => ()
      }
      let imports = drv_ensure_ws_imports(
        world,
        nodes,
        topo.order,
        trans.topo,
        built.stub_paths,
        serial_loaded,
        tk,
      )
      let cr = check_source_files_with_imports_mapped(
        node.name,
        tpaths,
        tsources,
        imports,
        node.dep_aliases,
        node.deps,
        true,
        false,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
      cr.tc.pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
      out_tested.push(node.declared_name)
      let tnames = drv_test_names(cr.pkg)
      let run_idx = drv_filter_tests(tnames, filter)
      if run_idx.length() > 0 {
        let td = trans.topo[tk]
        let dep_names : Array[String] = []
        let dep_objs : Array[String] = []
        let dep_obj_keys : Array[String] = []
        let job_opts = drv_link_opts_empty()
        let mut u = 0
        while u < td.length() {
          let tu = td[u]
          let dn = nodes[topo.order[tu]]
          dep_names.push(dn.name)
          dep_objs.push(built.obj_paths[tu])
          dep_obj_keys.push(built.obj_keys[tu])
          let dcstubs = pkg_cstub_objs[tu]
          let dcstub_keys = pkg_cstub_keys[tu]
          let mut ci = 0
          while ci < dcstubs.length() {
            dep_objs.push(dcstubs[ci])
            dep_obj_keys.push(if ci < dcstub_keys.length() { dcstub_keys[ci] } else { "" })
            ci = ci + 1
          }
          if pkg_cstub_cxx[tu] {
            job_opts.has_cxx = true
          }
          drv_collect_node_link_opts(dn, qbe_target, job_opts)
          let drcs = pkg_rc_objs[tu]
          let mut rci = 0
          while rci < drcs.length() {
            push_unique_lib(job_opts.objects, drcs[rci])
            rci = rci + 1
          }
          u = u + 1
        }
        let self_cstubs = pkg_cstub_objs[tk]
        let self_cstub_keys = pkg_cstub_keys[tk]
        let mut ci = 0
        while ci < self_cstubs.length() {
          dep_objs.push(self_cstubs[ci])
          dep_obj_keys.push(if ci < self_cstub_keys.length() { self_cstub_keys[ci] } else { "" })
          ci = ci + 1
        }
        if pkg_cstub_cxx[tk] {
          job_opts.has_cxx = true
        }
        drv_collect_node_link_opts(node, qbe_target, job_opts)
        let self_rcs = pkg_rc_objs[tk]
        let mut rci = 0
        while rci < self_rcs.length() {
          push_unique_lib(job_opts.objects, self_rcs[rci])
          rci = rci + 1
        }
        let mut li = 0
        while li < cli_libs.length() {
          push_unique_lib(job_opts.libs, cli_libs[li])
          if drv_is_cxx_lib(cli_libs[li]) {
            job_opts.has_cxx = true
          }
          li = li + 1
        }
        let test_res = emit_qbe_test_package_target(cr.pkg, cr.tc, dep_names, qbe_target)
        test_jobs.push(DrvTestJob::{
          label: node.declared_name,
          ssa: cleanup_native_rc_ssa(test_res.ssa),
          names: tnames,
          run_idx: run_idx,
          dep_objs: dep_objs,
          dep_obj_keys: dep_obj_keys,
          link_opts: job_opts,
        })
      }
      si = si + 1
    }
  } else {
    // Parallel multi-package frontend `check+emit` bounded by `nw_max`.
    let topo_entries : Array[String] = []
    k = 0
    while k < n {
      let unode = nodes[topo.order[k]]
      let sp = built.stub_paths[k]
      let fb_paths = if need[k] { drv_pack_str_list(unode.paths) } else { "" }
      let fb_sources = if need[k] { drv_pack_str_list(unode.sources) } else { "" }
      topo_entries.push(
        drv_pack_str_list([
          unode.name,
          sp,
          drv_pack_int_list(trans.topo[k]),
          fb_paths,
          fb_sources,
          drv_normalize_path(drv_abs_path(world, unode.dir)),
          drv_pack_str_list(unode.dep_aliases),
          drv_pack_str_list(unode.deps),
        ]),
      )
      k = k + 1
    }
    let topo_spec = drv_pack_str_list(topo_entries)
    let ws_pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
    let work_items : Array[String] = []
    si = 0
    while si < selected.length() {
      let node = nodes[selected[si]]
      let tk = node_to_topo[selected[si]]
      let tpaths : Array[String] = []
      let tsources : Array[String] = []
      let mut pi = 0
      while pi < node.paths.length() {
        tpaths.push(node.paths[pi])
        tsources.push(node.sources[pi])
        pi = pi + 1
      }
      match drv_append_test_sources_for(
        world,
        node.dir,
        node.target_rules,
        active_target,
        tpaths,
        tsources,
      ) {
        Err(msg) => return Err(msg)
        Ok(_) => ()
      }
      work_items.push(
        drv_pack_str_list([
          si.to_string(),
          tk.to_string(),
          node.name,
          drv_pack_str_list(tpaths),
          drv_pack_str_list(tsources),
          drv_pack_str_list(trans.topo_names[tk]),
          drv_normalize_path(drv_abs_path(world, node.dir)),
          drv_pack_str_list(node.dep_aliases),
          drv_pack_str_list(node.deps),
        ]),
      )
      si = si + 1
    }
    let work_spec = drv_pack_str_list(work_items)
    let nsel = selected.length()
    let nw = if nsel < nw_max { nsel } else { nw_max }
    let cursor = AtomicInt::new(0)
    let res_ch : Channel[String] = Channel::new(nsel + 1)
    let flt = filter
    let qt = qbe_target
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let t_raw = drv_unpack_str_list(topo_spec)
          let tn = t_raw.length()
          let t_names : Array[String] = []
          let t_stubs : Array[String] = []
          let t_deps : Array[Array[Int]] = []
          let t_fb_paths : Array[String] = []
          let t_fb_srcs : Array[String] = []
          let t_dirs : Array[String] = []
          let t_dep_aliases : Array[String] = []
          let t_dep_targets : Array[String] = []
          let local_loaded : Array[Option[ImportedPkg]] = []
          let mut ti = 0
          while ti < tn {
            let tf = drv_unpack_str_list(t_raw[ti])
            t_names.push(tf[0])
            t_stubs.push(tf[1])
            t_deps.push(drv_unpack_int_list(tf[2]))
            t_fb_paths.push(tf[3])
            t_fb_srcs.push(tf[4])
            t_dirs.push(tf[5])
            t_dep_aliases.push(tf[6])
            t_dep_targets.push(tf[7])
            local_loaded.push(None)
            ti = ti + 1
          }
          let items = drv_unpack_str_list(work_spec)
          while true {
            let idx = cursor.fetch_add(1)
            if idx >= items.length() {
              break
            }
            let wf = drv_unpack_str_list(items[idx])
            let cur_si = wf[0]
            let cur_tk = drv_parse_nonneg_decimal(wf[1])
            let pkg_name = wf[2]
            let tpaths = drv_unpack_str_list(wf[3])
            let tsources = drv_unpack_str_list(wf[4])
            let dep_names = drv_unpack_str_list(wf[5])
            let pkg_root = wf[6]
            let w_dep_aliases = drv_unpack_str_list(wf[7])
            let w_dep_targets = drv_unpack_str_list(wf[8])
            let deps_topo = t_deps[cur_tk]
            let imports : Array[ImportedPkg] = []
            let mut di = 0
            while di < deps_topo.length() {
              let u = deps_topo[di]
              match local_loaded[u] {
                Some(ipkg) => imports.push(ipkg)
                None => {
                  let u_deps = t_deps[u]
                  let u_imports : Array[ImportedPkg] = []
                  let mut ui = 0
                  while ui < u_deps.length() {
                    match local_loaded[u_deps[ui]] {
                      Some(dep_imp) => u_imports.push(dep_imp)
                      None => ()
                    }
                    ui = ui + 1
                  }
                  let u_da = drv_unpack_str_list(t_dep_aliases[u])
                  let u_dt = drv_unpack_str_list(t_dep_targets[u])
                  let mut loaded_opt : Option[ImportedPkg] = None
                  let sp = t_stubs[u]
                  if sp.length() > 0 {
                    match fs_read(world, sp) {
                      Ok(stub_txt) =>
                        if stub_txt.length() > 0 {
                          let scr = check_source_files_with_imports_mapped_dep(
                            t_names[u],
                            [t_names[u] + ".pionstub"],
                            [stub_txt],
                            u_imports,
                            u_da,
                            u_dt,
                            true,
                            false,
                          )
                          if scr.diagnostics.length() == 0 {
                            loaded_opt = Some(ImportedPkg::{ name: t_names[u], tc: scr.tc })
                          }
                        }
                      Err(_) => ()
                    }
                  }
                  let ipkg = match loaded_opt {
                    Some(v) => v
                    None => {
                      let fcr = check_source_files_with_imports_mapped_dep(
                        t_names[u],
                        drv_unpack_str_list(t_fb_paths[u]),
                        drv_unpack_str_list(t_fb_srcs[u]),
                        u_imports,
                        u_da,
                        u_dt,
                        true,
                        false,
                      )
                      fcr.tc.pkg_root = t_dirs[u]
                      fcr.tc.pkg_cwd = ws_pkg_cwd
                      ImportedPkg::{ name: t_names[u], tc: fcr.tc }
                    }
                  }
                  local_loaded[u] = Some(ipkg)
                  imports.push(ipkg)
                }
              }
              di = di + 1
            }
            let cr = check_source_files_with_imports_mapped(
              pkg_name,
              tpaths,
              tsources,
              imports,
              w_dep_aliases,
              w_dep_targets,
              true,
              false,
            )
            if cr.diagnostics.length() > 0 {
              let _ = res_ch.send(
                drv_pack_str_list([cur_si, "E", check_result_to_json(cr.diagnostics)]),
              )
            } else {
              cr.tc.pkg_root = pkg_root
              cr.tc.pkg_cwd = ws_pkg_cwd
              let tnames = drv_test_names(cr.pkg)
              let run_idx = drv_filter_tests(tnames, flt)
              if run_idx.length() > 0 {
                let test_res = emit_qbe_test_package_target(cr.pkg, cr.tc, dep_names, qt)
                let _ = res_ch.send(
                  drv_pack_str_list([
                    cur_si,
                    "O",
                    drv_pack_str_list(tnames),
                    drv_pack_int_list(run_idx),
                    cleanup_native_rc_ssa(test_res.ssa),
                  ]),
                )
              } else {
                let _ = res_ch.send(drv_pack_str_list([cur_si, "N"]))
              }
            }
          }
        })
        wi = wi + 1
      }
    })
    res_ch.close()
    let results : Array[String] = []
    si = 0
    while si < nsel {
      results.push("")
      si = si + 1
    }
    while true {
      match res_ch.recv() {
        Some(msg) => {
          let rf = drv_unpack_str_list(msg)
          if rf.length() >= 2 {
            let rsi = drv_parse_nonneg_decimal(rf[0])
            if rsi >= 0 && rsi < nsel {
              results[rsi] = msg
            }
          }
        }
        None => break
      }
    }
    si = 0
    while si < nsel {
      let rf = drv_unpack_str_list(results[si])
      if rf.length() >= 3 && rf[1] == "E" {
        return Err(rf[2])
      }
      let node = nodes[selected[si]]
      let tk = node_to_topo[selected[si]]
      out_tested.push(node.declared_name)
      if rf.length() >= 5 && rf[1] == "O" {
        let tnames = drv_unpack_str_list(rf[2])
        let run_idx = drv_unpack_int_list(rf[3])
        let ssa = rf[4]
        let td = trans.topo[tk]
        let dep_objs : Array[String] = []
        let dep_obj_keys : Array[String] = []
        let job_opts = drv_link_opts_empty()
        let mut u = 0
        while u < td.length() {
          let tu = td[u]
          let dn = nodes[topo.order[tu]]
          dep_objs.push(built.obj_paths[tu])
          dep_obj_keys.push(built.obj_keys[tu])
          let dcstubs = pkg_cstub_objs[tu]
          let dcstub_keys = pkg_cstub_keys[tu]
          let mut ci = 0
          while ci < dcstubs.length() {
            dep_objs.push(dcstubs[ci])
            dep_obj_keys.push(if ci < dcstub_keys.length() { dcstub_keys[ci] } else { "" })
            ci = ci + 1
          }
          if pkg_cstub_cxx[tu] {
            job_opts.has_cxx = true
          }
          drv_collect_node_link_opts(dn, qbe_target, job_opts)
          let drcs = pkg_rc_objs[tu]
          let mut rci = 0
          while rci < drcs.length() {
            push_unique_lib(job_opts.objects, drcs[rci])
            rci = rci + 1
          }
          u = u + 1
        }
        let self_cstubs = pkg_cstub_objs[tk]
        let self_cstub_keys = pkg_cstub_keys[tk]
        let mut ci = 0
        while ci < self_cstubs.length() {
          dep_objs.push(self_cstubs[ci])
          dep_obj_keys.push(if ci < self_cstub_keys.length() { self_cstub_keys[ci] } else { "" })
          ci = ci + 1
        }
        if pkg_cstub_cxx[tk] {
          job_opts.has_cxx = true
        }
        drv_collect_node_link_opts(node, qbe_target, job_opts)
        let self_rcs = pkg_rc_objs[tk]
        let mut rci = 0
        while rci < self_rcs.length() {
          push_unique_lib(job_opts.objects, self_rcs[rci])
          rci = rci + 1
        }
        let mut li = 0
        while li < cli_libs.length() {
          push_unique_lib(job_opts.libs, cli_libs[li])
          if drv_is_cxx_lib(cli_libs[li]) {
            job_opts.has_cxx = true
          }
          li = li + 1
        }
        test_jobs.push(DrvTestJob::{
          label: node.declared_name,
          ssa: ssa,
          names: tnames,
          run_idx: run_idx,
          dep_objs: dep_objs,
          dep_obj_keys: dep_obj_keys,
          link_opts: job_opts,
        })
      }
      si = si + 1
    }
  }
  let t_checked = clock_now_ms(world)
  match drv_exec_test_jobs(world, test_jobs, jobs, as_json, active_target, out_pkgs, out_names, out_oks, pin) {
    Err(e) => {
      drv_cas_pin_close(world, pin)
      return Err(e)
    }
    Ok(_) => ()
  }
  drv_cas_post_run_evict(world, cache_dir, pin, [])
  if trace {
    let t_end = clock_now_ms(world)
    io_eprintln(
      world,
      "[test] load=" +
      (t_loaded - t_start).to_string() +
      "ms objs=" +
      (t_built - t_loaded).to_string() +
      "ms check+emit=" +
      (t_checked - t_built).to_string() +
      "ms bins+run=" +
      (t_end - t_checked).to_string() +
      "ms",
    )
  }
  Ok(deps_skipped)
}

///|
fn drv_run_ws_tests(
  world : World,
  root_dir : String,
  as_json : Bool,
  filter : String,
  cli_libs : Array[String],
  only_pkg : String,
  no_deps : Bool,
  jobs : Int,
  locked : Bool,
  offline : Bool,
  active_target : String,
) -> Int {
  let tested : Array[String] = []
  let out_pkgs : Array[String] = []
  let out_names : Array[String] = []
  let out_oks : Array[Bool] = []
  let deps_skipped = match drv_run_ws_tests_collect(
    world,
    root_dir,
    as_json,
    filter,
    cli_libs,
    only_pkg,
    no_deps,
    jobs,
    locked,
    offline,
    active_target,
    tested,
    out_pkgs,
    out_names,
    out_oks,
  ) {
    Err(msg) => return drv_test_fail(world, as_json, msg)
    Ok(ds) => ds
  }
  if as_json {
    io_println(
      world,
      format_workspace_test_report_json(tested, out_pkgs, out_names, out_oks, deps_skipped),
    )
    let mut fi = 0
    while fi < out_oks.length() {
      if !out_oks[fi] {
        return 1
      }
      fi = fi + 1
    }
    0
  } else {
    let rc = drv_print_test_summary(world, out_oks)
    if deps_skipped > 0 {
      io_println(
        world,
        "note: skipped " +
        deps_skipped.to_string() +
        " local path dependency package(s); pass --deps to also test them",
      )
    }
    rc
  }
}

///|
fn drv_run_tests_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
  filter : String,
  cli_libs : Array[String],
  only_pkg : String,
  no_deps : Bool,
  jobs : Int,
  locked : Bool,
  offline : Bool,
  target_override : String,
) -> Int {
  let active_target = drv_pick_target(world, target_override)
  if !drv_target_is_valid(active_target) {
    return drv_test_fail(
      world,
      as_json,
      "unknown target `" +
      active_target +
      "` (valid: arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, wasm32)",
    )
  }
  let host_target = drv_host_native_target(world)
  if active_target != host_target && !drv_target_is_wasm(active_target) {
    return drv_test_fail(
      world,
      as_json,
      "cannot execute tests for cross-target `" +
      active_target +
      "` on host `" +
      host_target +
      "` (only host target `" +
      host_target +
      "` and `wasm32` can be executed by `pionc test`)",
    )
  }
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) =>
        return drv_run_ws_tests(
          world,
          root_dir,
          as_json,
          filter,
          cli_libs,
          only_pkg,
          no_deps,
          jobs,
          locked,
          offline,
          active_target,
        )
      None => ()
    }
  } else if targets.length() > 1 {
    let manifest_dirs : Array[String] = []
    let seen_dirs : Map[String, Bool] = Map([])
    let mut n_manifest = 0
    let mut n_plain = 0
    let mut ti = 0
    while ti < targets.length() {
      match drv_detect_manifest_dir(world, targets[ti]) {
        Some(root_dir) => {
          n_manifest = n_manifest + 1
          let norm = drv_normalize_path(root_dir)
          if !seen_dirs.contains(norm) {
            seen_dirs.set(norm, true)
            manifest_dirs.push(root_dir)
          }
        }
        None => n_plain = n_plain + 1
      }
      ti = ti + 1
    }
    if n_manifest > 0 && n_plain > 0 {
      return drv_test_fail(
        world,
        as_json,
        "cannot mix pion.toml package directories with bare .pion files in `pionc test`",
      )
    }
    if n_manifest == targets.length() {
      if as_json {
        let all_tested : Array[String] = []
        let all_pkgs : Array[String] = []
        let all_names : Array[String] = []
        let all_oks : Array[Bool] = []
        let mut total_deps_skipped = 0
        let mut mi = 0
        while mi < manifest_dirs.length() {
          match drv_run_ws_tests_collect(
            world,
            manifest_dirs[mi],
            true,
            filter,
            cli_libs,
            only_pkg,
            no_deps,
            jobs,
            locked,
            offline,
            active_target,
            all_tested,
            all_pkgs,
            all_names,
            all_oks,
          ) {
            Err(msg) => return drv_test_fail(world, true, msg)
            Ok(ds) => total_deps_skipped = total_deps_skipped + ds
          }
          mi = mi + 1
        }
        io_println(
          world,
          format_workspace_test_report_json(
            all_tested,
            all_pkgs,
            all_names,
            all_oks,
            total_deps_skipped,
          ),
        )
        let mut fi = 0
        while fi < all_oks.length() {
          if !all_oks[fi] {
            return 1
          }
          fi = fi + 1
        }
        return 0
      }
      let mut overall_rc = 0
      let mut mi = 0
      while mi < manifest_dirs.length() {
        let rc = drv_run_ws_tests(
          world,
          manifest_dirs[mi],
          false,
          filter,
          cli_libs,
          only_pkg,
          no_deps,
          jobs,
          locked,
          offline,
          active_target,
        )
        if rc != 0 {
          overall_rc = rc
        }
        mi = mi + 1
      }
      return overall_rc
    }
  }
  if only_pkg.length() > 0 {
    return drv_test_fail(world, as_json, "--package needs a pion.toml workspace")
  }
  let loaded = match drv_load_targets(world, targets) {
    Err(msg) => return drv_test_fail(world, as_json, msg)
    Ok(v) => v
  }
  let mut ti = 0
  while ti < targets.length() {
    if fs_is_dir(world, targets[ti]) {
      match drv_append_test_sources(world, targets[ti], loaded.paths, loaded.sources) {
        Err(msg) => return drv_test_fail(world, as_json, msg)
        Ok(_) => ()
      }
    }
    ti = ti + 1
  }
  let cr = check_source_files_full(loaded.pkg_name, loaded.paths, loaded.sources)
  if cr.diagnostics.length() > 0 {
    return drv_test_fail(world, as_json, check_result_to_json(cr.diagnostics))
  }
  let out_pkgs : Array[String] = []
  let out_names : Array[String] = []
  let out_oks : Array[Bool] = []
  let tnames = drv_test_names(cr.pkg)
  let run_idx = drv_filter_tests(tnames, filter)
  let cache_dir = drv_resolve_cache_dir(world)
  let pin = drv_cas_pin_open(world, cache_dir)
  if drv_target_is_wasm(active_target) {
    if run_idx.length() > 0 {
      let test_res = emit_qbe_test_package_target(cr.pkg, cr.tc, [], "wasm32")
      match drv_exec_wasm_test_units(
        world,
        "",
        [test_res.ssa],
        tnames,
        run_idx,
        as_json,
        out_pkgs,
        out_names,
        out_oks,
        pin,
      ) {
        Err(e) => {
          drv_cas_pin_close(world, pin)
          return drv_test_fail(world, as_json, e)
        }
        Ok(_) => ()
      }
    }
  } else {
    let test_jobs : Array[DrvTestJob] = []
    if run_idx.length() > 0 {
      let test_res = emit_qbe_test_package_target(cr.pkg, cr.tc, [], active_target)
      let job_opts = drv_link_opts_from_libs(cli_libs)
      test_jobs.push(DrvTestJob::{
        label: "",
        ssa: cleanup_native_rc_ssa(test_res.ssa),
        names: tnames,
        run_idx: run_idx,
        dep_objs: [],
        dep_obj_keys: [],
        link_opts: job_opts,
      })
    }
    match drv_exec_test_jobs(
      world,
      test_jobs,
      jobs,
      as_json,
      active_target,
      out_pkgs,
      out_names,
      out_oks,
      pin,
    ) {
      Err(e) => {
        drv_cas_pin_close(world, pin)
        return drv_test_fail(world, as_json, e)
      }
      Ok(_) => ()
    }
  }
  drv_cas_post_run_evict(world, cache_dir, pin, [])
  if as_json {
    io_println(world, format_test_report_json(out_names, out_oks))
    let mut fi = 0
    while fi < out_oks.length() {
      if !out_oks[fi] {
        return 1
      }
      fi = fi + 1
    }
    0
  } else {
    drv_print_test_summary(world, out_oks)
  }
}

///|
fn drv_is_fmt_file(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  if str_code_at(name, 0) == 46 {
    return false
  }
  drv_ends_with(name, ".pion")
}

///|
fn drv_collect_fmt_files_dir(
  world : World,
  dir : String,
  out : Array[String],
) -> Unit {
  let entries = fs_list_dir(world, dir)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name.length() > 0 && str_code_at(name, 0) != 46 {
      let full = drv_join_path(dir, name)
      if fs_is_dir(world, full) {
        if name != "_build" && name != "target" && name != "out" && name != "vendor" {
          drv_collect_fmt_files_dir(world, full, out)
        }
      } else if drv_is_fmt_file(name) {
        out.push(full)
      }
    }
    i = i + 1
  }
}

///|
fn drv_run_fmt_cmd(
  world : World,
  targets : Array[String],
  check_only : Bool,
  as_json : Bool,
) -> Int {
  let files : Array[String] = []
  let seen_files : Map[String, Bool] = Map([])
  let mut t = 0
  while t < targets.length() {
    let target = targets[t]
    if !fs_exists(world, target) {
      io_eprintln(world, "error: path does not exist: " + target)
      return 1
    }
    let mut expanded_ws = false
    match drv_detect_manifest_dir(world, target) {
      Some(root_dir) =>
        match fs_read(world, drv_join_path(root_dir, "pion.toml")) {
          Ok(txt) =>
            match parse_pion_toml(txt) {
              Ok(mf) =>
                if mf.is_workspace {
                  expanded_ws = true
                  let members = match drv_expand_workspace_members(
                    world,
                    drv_abs_path(world, root_dir),
                    mf,
                  ) {
                    Err(e) => {
                      io_eprintln(world, "error: " + e)
                      return 1
                    }
                    Ok(ms) => ms
                  }
                  let mut mi = 0
                  while mi < members.length() {
                    let mfiles : Array[String] = []
                    drv_collect_fmt_files_dir(world, members[mi], mfiles)
                    let mut fi = 0
                    while fi < mfiles.length() {
                      let nf = drv_normalize_path(mfiles[fi])
                      if !seen_files.contains(nf) {
                        seen_files.set(nf, true)
                        files.push(mfiles[fi])
                      }
                      fi = fi + 1
                    }
                    mi = mi + 1
                  }
                }
              Err(_) => ()
            }
          Err(_) => ()
        }
      None => ()
    }
    if !expanded_ws {
      if fs_is_dir(world, target) {
        let dfiles : Array[String] = []
        drv_collect_fmt_files_dir(world, target, dfiles)
        let mut fi = 0
        while fi < dfiles.length() {
          let nf = drv_normalize_path(dfiles[fi])
          if !seen_files.contains(nf) {
            seen_files.set(nf, true)
            files.push(dfiles[fi])
          }
          fi = fi + 1
        }
      } else {
        let nf = drv_normalize_path(target)
        if !seen_files.contains(nf) {
          seen_files.set(nf, true)
          files.push(target)
        }
      }
    }
    t = t + 1
  }
  let unformatted : Array[String] = []
  let mut i = 0
  while i < files.length() {
    let path = files[i]
    let src = match fs_read(world, path) {
      Err(msg) => {
        io_eprintln(world, "error: failed to read " + path + ": " + msg)
        return 1
      }
      Ok(s) => s
    }
    let formatted = format_source(src)
    if formatted != src {
      if check_only {
        unformatted.push(path)
      } else {
        if !drv_write_text_atomic(world, path, formatted) {
          io_eprintln(world, "error: failed to write " + path)
          return 1
        }
      }
    }
    i = i + 1
  }
  if check_only {
    if as_json {
      io_println(world, fmt_check_result_to_json(unformatted))
    } else {
      let mut j = 0
      while j < unformatted.length() {
        io_println(world, unformatted[j])
        j = j + 1
      }
    }
    if unformatted.length() == 0 { 0 } else { 1 }
  } else {
    if as_json {
      io_println(world, fmt_check_result_to_json([]))
    }
    0
  }
}

///|
/// `pionc doc [--json]`: public API of a file, directory or `pion.toml` workspace
/// (every package, dependencies first).
fn drv_run_doc_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
  target_override : String,
) -> Int {
  let pkgs : Array[Package] = []
  let diags : Array[Diagnostic] = []
  let mut handled_ws = false
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        handled_ws = true
        let nodes = match drv_load_workspace_nodes_target(
          world,
          root_dir,
          drv_pick_target(world, target_override),
        ) {
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
          Ok(v) => v
        }
        let mut ni = 0
        while ni < nodes.length() {
          let node = nodes[ni]
          let pd = parse_package_diagnostics(node.paths, node.sources)
          let mut di = 0
          while di < pd.length() {
            diags.push(pd[di])
            di = di + 1
          }
          pkgs.push(parse_package(node.declared_name, node.paths, node.sources))
          ni = ni + 1
        }
      }
      None => ()
    }
  }
  if !handled_ws {
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let pd = parse_package_diagnostics(loaded.paths, loaded.sources)
        let mut di = 0
        while di < pd.length() {
          diags.push(pd[di])
          di = di + 1
        }
        pkgs.push(parse_package(loaded.pkg_name, loaded.paths, loaded.sources))
      }
    }
  }
  if diags.length() > 0 {
    io_println(world, check_result_to_json(diags))
    return 1
  }
  if as_json {
    io_println(world, doc_packages_json(pkgs))
  } else {
    io_print(world, doc_packages_text(pkgs))
  }
  0
}

///|
/// `pionc fetch [dir]`: resolves every git dependency of the workspace into the
/// shared git cache and writes/verifies `pion.lock`; prints a JSON summary.
fn drv_run_fetch_cmd(
  world : World,
  dir : String,
  locked : Bool,
  offline : Bool,
) -> Int {
  let root_dir = match drv_detect_manifest_dir(world, dir) {
    Some(d) => d
    None => {
      io_eprintln(world, "error: no pion.toml in " + dir)
      return 1
    }
  }
  let ws = match drv_load_workspace_opts(world, root_dir, locked, offline, "") {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":true,\"lock\":")
  sb.write_string(json_quote(if ws.lock.length() > 0 || fs_exists(world, ws.lock_path) { ws.lock_path } else { "" }))
  sb.write_string(",\"git_cache\":")
  sb.write_string(json_quote(ws.git_root))
  sb.write_string(",\"packages\":[")
  let mut i = 0
  while i < ws.nodes.length() {
    let node = ws.nodes[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(node.declared_name))
    sb.write_string(",\"canon_id\":")
    sb.write_string(json_quote(node.name))
    sb.write_string(",\"dir\":")
    sb.write_string(json_quote(node.dir))
    sb.write_string(",\"source\":")
    sb.write_string(if drv_is_external_pkg(ws.git_root, node.dir) { "\"git\"" } else { "\"path\"" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("],\"git\":[")
  i = 0
  while i < ws.lock.length() {
    let e = ws.lock[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(e.name))
    sb.write_string(",\"git\":")
    sb.write_string(json_quote(e.git))
    sb.write_string(",\"ref\":")
    sb.write_string(json_quote(e.reference))
    sb.write_string(",\"rev\":")
    sb.write_string(json_quote(e.rev))
    sb.write_string(",\"subdir\":")
    sb.write_string(json_quote(e.subdir))
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  io_println(world, sb.to_string())
  0
}

///|
/// `pionc init [--template cli|service|invar-app] [--json] <dir>`: scaffolds a package;
/// refuses to touch a directory that already has any of its target files.
fn drv_run_init_cmd(
  world : World,
  dir : String,
  tmpl : String,
  as_json : Bool,
) -> Int {
  let name = init_package_name(drv_normalize_path(dir))
  let files : Array[String] = []
  let contents : Array[String] = []
  if tmpl == "cli" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_pion_toml(name))
    contents.push(init_main_source(name))
    contents.push(init_test_source(name))
  } else if tmpl == "service" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/worker.pion"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_service_pion_toml(name))
    contents.push(init_service_worker_source(name))
    contents.push(init_service_main_source(name))
    contents.push(init_service_test_source(name))
  } else if tmpl == "invar-app" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/protocol.pion"))
    files.push(drv_join_path(dir, "src/worker.pion"))
    files.push(drv_join_path(dir, "src/view.pion"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_invar_pion_toml(name))
    contents.push(init_invar_protocol_source(name))
    contents.push(init_invar_worker_source(name))
    contents.push(init_invar_view_source(name))
    contents.push(init_invar_main_source(name))
    contents.push(init_invar_test_source(name))
  } else {
    let err_msg = "unknown template `" + tmpl + "`; expected one of: cli, service, invar-app"
    if as_json {
      io_println(
        world,
        "{\"ok\":false,\"error\":" + json_quote(err_msg) + "}",
      )
    } else {
      io_eprintln(world, "error: " + err_msg)
    }
    return 1
  }
  let mut i = 0
  while i < files.length() {
    if fs_exists(world, files[i]) {
      if as_json {
        io_println(
          world,
          "{\"ok\":false,\"error\":" + json_quote(files[i] + " already exists; refusing to overwrite") + "}",
        )
      } else {
        io_eprintln(world, "error: " + files[i] + " already exists; refusing to overwrite")
      }
      return 1
    }
    i = i + 1
  }
  let _ = fs_mkdir_p(world, drv_join_path(dir, "src"))
  i = 0
  while i < files.length() {
    match fs_write(world, files[i], contents[i]) {
      Err(e) => {
        io_eprintln(world, "error: failed to write " + files[i] + ": " + e)
        return 1
      }
      Ok(_) => ()
    }
    i = i + 1
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"package\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"template\":")
    sb.write_string(json_quote(tmpl))
    sb.write_string(",\"dir\":")
    sb.write_string(json_quote(dir))
    sb.write_string(",\"files\":[")
    i = 0
    while i < files.length() {
      if i > 0 {
        sb.write_string(",")
      }
      sb.write_string(json_quote(files[i]))
      i = i + 1
    }
    sb.write_string("]}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "created package `" + name + "` (" + tmpl + ") in " + dir)
  }
  0
}

///|
/// Registry index cache: `$PION_CACHE_DIR/registry`, else `$HOME/.cache/pion/registry`;
/// `<sha256(url)>.git` is a bare mirror of each registry's index repository.
fn drv_registry_cache_root(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  if custom.length() > 0 {
    return drv_normalize_path(custom + "/registry")
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    drv_normalize_path(drv_join_path(home, ".cache/pion/registry"))
  } else {
    drv_join_path(drv_temp_dir(world), "pion-registry")
  }
}

///|
/// The official registry, used when neither `--registry`, `[registry] url`
/// nor `$PION_REGISTRY` names one.
fn drv_default_registry() -> String {
  "https://github.com/AFK-surf/pion-packages.git"
}

///|
/// `pionc search` reuses a registry mirror whose last successful clone/fetch
/// is younger than this (10 minutes); `add`/`update` always refresh.
fn drv_registry_ttl_ms() -> Int64 {
  600000L
}

///|
/// A URL (`scheme://...`) or an scp-style `[user@]host:path` (a `:` before
/// any `/`, not a Windows drive letter `C:`): kept as is. Anything else is a
/// local path.
fn drv_registry_is_remote(url : String) -> Bool {
  if drv_find_substr(url, "://", 0) >= 0 {
    return true
  }
  let colon = drv_find_substr(url, ":", 0)
  if colon <= 0 {
    return false
  }
  let slash = drv_find_substr(url, "/", 0)
  if slash >= 0 && slash < colon {
    return false
  }
  let bslash = drv_find_substr(url, "\\", 0)
  if bslash >= 0 && bslash < colon {
    return false
  }
  !drv_is_drive_abs(url)
}

///|
/// A registry given as a local path is made absolute against `base_dir` (an
/// absolute directory) and normalized; URLs are kept as they are.
fn drv_norm_registry(base_dir : String, url : String) -> String {
  if drv_registry_is_remote(url) {
    url
  } else {
    drv_resolve_rel_path(base_dir, url)
  }
}

///|
/// ASCII-only lower-casing; every other byte (UTF-8 included) is kept as is.
fn drv_ascii_lower(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c >= 65 && c <= 90 {
      break
    }
    i = i + 1
  }
  if i == n {
    return s
  }
  let sb = StringBuilder()
  let mut run = 0
  while i < n {
    let c = str_code_at(s, i)
    if c >= 65 && c <= 90 {
      sb.write_string(slice_str(s, run, i))
      sb.write_char((c + 32).unsafe_to_char())
      run = i + 1
    }
    i = i + 1
  }
  sb.write_string(slice_str(s, run, n))
  sb.to_string()
}

///|
/// Where a registry command reads its index from: `url` (a URL as given, a
/// local path made absolute and normalized) and the level that chose it
/// (`flag` / `manifest` / `env` / `default`), or a stable error `code`.
struct DrvRegistryPick {
  url : String
  source : String
  code : String
  error : String
}

///|
fn drv_registry_pick_err(code : String, error : String) -> DrvRegistryPick {
  DrvRegistryPick::{ url: "", source: "", code: code, error: error }
}

///|
/// The registry source shared by `pionc add` and `pionc search`, in fixed
/// priority order:
/// 1. `flag` (`--registry`; a local path is relative to the working directory),
/// 2. `manifest_url` (`[registry] url`; a local path is relative to
///    `manifest_dir`, the absolute directory of that `pion.toml`),
/// 3. `$PION_REGISTRY` (empty = unset; `none` / `off`, any case, disable the
///    default registry with `E_REGISTRY_DISABLED`; a local path is relative to
///    the working directory),
/// 4. the official registry `drv_default_registry()`.
/// A location starting with `-` is refused (`E_INVALID_ARGS`) so it can never
/// reach `git` as an option.
fn drv_pick_registry(
  world : World,
  flag : String,
  manifest_dir : String,
  manifest_url : String,
) -> DrvRegistryPick {
  let mut raw = ""
  let mut base = ""
  let mut source = ""
  if flag.length() > 0 {
    raw = flag
    source = "flag"
  } else if manifest_url.length() > 0 {
    raw = manifest_url
    base = manifest_dir
    source = "manifest"
  } else {
    let env = drv_env_str(world, "PION_REGISTRY")
    if env.length() > 0 {
      let low = drv_ascii_lower(env)
      if low == "none" || low == "off" {
        return drv_registry_pick_err(
          "E_REGISTRY_DISABLED",
          "$PION_REGISTRY=" +
          env +
          " disables the default registry; pass --registry <url_or_path> or set [registry] url in pion.toml",
        )
      }
      raw = env
      source = "env"
    } else {
      raw = drv_default_registry()
      source = "default"
    }
  }
  if drv_starts_with(raw, "-") {
    return drv_registry_pick_err(
      "E_INVALID_ARGS",
      "refusing registry `" + raw + "`: a registry URL or path must not start with `-`",
    )
  }
  if drv_registry_is_remote(raw) {
    return DrvRegistryPick::{ url: raw, source: source, code: "", error: "" }
  }
  if base.length() == 0 {
    base = drv_abs_path(world, ".")
  }
  DrvRegistryPick::{
    url: drv_norm_registry(base, raw),
    source: source,
    code: "",
    error: "",
  }
}

///|
/// Bare mirror of the (normalized) registry `url`, shared by `add`, `update`
/// and `search`: `<registry cache>/<sha256(url)>.git`.
fn drv_registry_repo_path(world : World, url : String) -> String {
  drv_registry_cache_root(world) + "/" + sha256_hex(url) + ".git"
}

///|
/// Stamp inside a registry mirror: wall-clock milliseconds of its last
/// successful clone/fetch (a failed fetch never renews it).
fn drv_registry_stamp_path(repo : String) -> String {
  repo + "/.pion_last_fetch"
}

///|
fn drv_registry_stamp(world : World, repo : String) -> Unit {
  let _ = drv_write_text_atomic(
    world,
    drv_registry_stamp_path(repo),
    clock_now_ms(world).to_string() + "\n",
  )
}

///|
fn drv_registry_has_mirror(world : World, repo : String) -> Bool {
  fs_is_dir(world, repo) && fs_exists(world, repo + "/HEAD")
}

///|
/// The commit the mirror's `HEAD` resolves to, or "" when there is no usable
/// mirror (missing, empty, or `HEAD` naming a branch that is gone).
fn drv_registry_mirror_oid(world : World, repo : String) -> String {
  if !drv_registry_has_mirror(world, repo) {
    return ""
  }
  match drv_git(world, ["--git-dir", repo, "rev-parse", "--verify", "--quiet", "HEAD^{commit}"]) {
    Ok(o) => o
    Err(_) => ""
  }
}

///|
/// Points the mirror's `HEAD` at the upstream default branch (a mirror clone
/// never follows a later switch on its own, and `fetch --prune` deletes the
/// old branch once upstream drops it).
/// Upstream `HEAD` is either a branch (`ref: refs/heads/<b>\tHEAD` plus its
/// `<oid>\tHEAD`) or detached (`<oid>\tHEAD` only); either way the mirror
/// publishes the advertised commit as its detached `HEAD`. An upstream `HEAD`
/// that names no commit (nothing advertised) is an error, so a stale branch is
/// never taken for a successful refresh.
fn drv_registry_sync_head(
  world : World,
  repo : String,
  old_oid : String,
) -> Result[Unit, String] {
  let out = match drv_git(world, ["--git-dir", repo, "ls-remote", "--symref", "origin", "HEAD"]) {
    Err(e) => return Err(e)
    Ok(o) => o
  }
  let lines = drv_split_char(out, 10)
  let mut target = ""
  let mut oid = ""
  let mut li = 0
  while li < lines.length() {
    let ln = drv_trim_ws(lines[li])
    let tab = drv_find_substr(ln, "\t", 0)
    if tab > 0 && slice_str(ln, tab + 1, ln.length()) == "HEAD" {
      let left = slice_str(ln, 0, tab)
      if drv_starts_with(left, "ref: refs/heads/") {
        target = slice_str(left, 5, left.length())
      } else if lock_is_hex_oid(left) {
        oid = left
      }
    }
    li = li + 1
  }
  if oid.length() == 0 {
    return Err("upstream HEAD names no commit")
  }
  // The advertised commit must be local before publishing: a detached
  // upstream HEAD outside every ref, or a branch moved after the fetch,
  // needs one explicit fetch.
  if !drv_git_has_commit(world, repo, oid) {
    let spec = if target.length() > 0 { "+" + target + ":" + target } else { "HEAD" }
    match drv_git(world, ["--git-dir", repo, "fetch", "--quiet", "--", "origin", spec]) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if !drv_git_has_commit(world, repo, oid) {
      return Err("upstream HEAD commit " + oid + " is not available")
    }
  }
  // Publishing is one atomic compare-and-swap with no network: every failure
  // above leaves the old detached HEAD in place (search then reports
  // `stale`), and a slower refresh never overwrites a newer concurrent one.
  match drv_git(world, ["--git-dir", repo, "update-ref", "--no-deref", "HEAD", oid, old_oid]) {
    Err(_) =>
      if drv_registry_mirror_oid(world, repo) != oid {
        return Err("registry mirror updated concurrently")
      }
    Ok(_) => ()
  }
  if drv_registry_mirror_oid(world, repo) != oid {
    return Err("mirror HEAD does not match upstream HEAD " + oid)
  }
  Ok(())
}

///|
extern "C" fn c_fs_mkdir_excl(path : Ptr) -> Int = "pion_fs_mkdir_excl"

///|
/// `0` created, `1` the name is taken (`EEXIST`), `-1` any other failure.
extern "C" fn c_fs_mkdir_excl_status(path : Ptr) -> Int = "pion_fs_mkdir_excl_status"

///|
extern "C" fn c_fs_trylock(path : Ptr) -> Int64 = "pion_fs_trylock"

///|
extern "C" fn c_fs_unlock(handle : Int64) -> Unit = "pion_fs_unlock"

///|
extern "C" fn c_fs_cpath(data : Ptr, len : Int64) -> Ptr = "pion_fs_cpath"

///|
/// `s` as a C path, or null when it is empty or holds an embedded NUL (which
/// would cut it short); `c_fs_mkdir_excl` / `c_fs_rmdir` / `c_fs_trylock` / `c_fs_canon_path`
/// refuse null. The pointer borrows `s`, so pass a named local.
fn drv_cpath(s : String) -> Ptr {
  c_fs_cpath(str_data_ptr(s), s.length().to_int64())
}

///|
/// Creates a fresh, exclusively owned temporary directory next to `path`
/// with the runtime's native exclusive `mkdir` (no subprocess, no shell):
/// each try takes a fresh process-wide `c_cli_next_seq`; only a taken name
/// moves on (up to 32 names), any other failure is an immediate error.
fn drv_mktemp_dir_near(world : World, path : String) -> Result[String, String] {
  let mut k = 0
  while k < 32 {
    let seq = c_cli_next_seq().to_string()
    let cand = path + ".tmp." + drv_tmp_tag(world, path + "#" + seq) + "." + seq
    let st = c_fs_mkdir_excl_status(drv_cpath(cand))
    if st == 0 {
      return Ok(cand)
    }
    if st != 1 {
      return Err("cannot create a temporary directory next to " + path + " (" + cand + ")")
    }
    k = k + 1
  }
  Err("cannot create a temporary directory next to " + path + ": 32 names taken")
}

///|
/// True when the mirror was successfully fetched less than
/// `drv_registry_ttl_ms()` ago.
fn drv_registry_is_fresh(world : World, repo : String) -> Bool {
  if !drv_registry_has_mirror(world, repo) {
    return false
  }
  let stamp = match fs_read(world, drv_registry_stamp_path(repo)) {
    Ok(t) => drv_parse_pos_int64(drv_trim_ws(t), 0L)
    Err(_) => 0L
  }
  if stamp <= 0L {
    return false
  }
  let now = clock_now_ms(world)
  now >= stamp && now - stamp < drv_registry_ttl_ms()
}

///|
/// Clones or fetches (once per run) the registry index repository `url` into
/// its bare mirror, re-points the mirror's `HEAD` at the upstream default
/// branch, and returns the mirror's path. Only a run that leaves `HEAD`
/// resolving to a commit renews the mirror's fetch stamp.
fn drv_registry_sync(
  world : World,
  url : String,
  fetched : Map[String, Bool],
) -> Result[String, String] {
  let root = drv_registry_cache_root(world)
  let repo = drv_registry_repo_path(world, url)
  if fetched.contains(repo) {
    return Ok(repo)
  }
  fetched.set(repo, true)
  if drv_starts_with(url, "-") {
    return Err("refusing registry `" + url + "`: it must not start with `-`")
  }
  let existing = fs_is_dir(world, repo)
  if !existing || drv_registry_mirror_oid(world, repo).length() == 0 {
    // No usable mirror (none, or an empty / broken one from earlier): clone
    // a fresh one aside and only put it in place once it has a commit.
    let _ = fs_mkdir_p(world, root)
    let tmp = match drv_mktemp_dir_near(world, repo) {
      Err(e) => return Err(e)
      Ok(d) => d
    }
    match drv_git(world, ["clone", "--quiet", "--mirror", "--", url, tmp]) {
      Err(e) => {
        drv_rm_rf(world, tmp)
        return Err("cannot clone registry " + url + ": " + e)
      }
      Ok(_) => ()
    }
    // A mirror is born with a detached HEAD: its only published reference.
    let init_oid = drv_registry_mirror_oid(world, tmp)
    if init_oid.length() == 0 {
      drv_rm_rf(world, tmp)
      return Err("registry " + url + " has no commit on its default branch")
    }
    match drv_git(world, ["--git-dir", tmp, "update-ref", "--no-deref", "HEAD", init_oid]) {
      Err(e) => {
        drv_rm_rf(world, tmp)
        return Err("cannot detach the HEAD of registry mirror " + tmp + ": " + e)
      }
      Ok(_) => ()
    }
    if existing {
      // Replacing is mutually exclusive (a kernel file lock, released even if
      // this process dies) and re-checked under the lock: a mirror repaired
      // concurrently wins. The lock file itself is never removed.
      // Bound to a local so the C string outlives the call (a temporary would
      // be released before c_fs_trylock reads it).
      let lock_path = repo + ".replace.flock"
      let lk = c_fs_trylock(drv_cpath(lock_path))
      if lk < 0L {
        drv_rm_rf(world, tmp)
        return Err("registry mirror " + repo + " is being replaced concurrently")
      }
      if fs_is_dir(world, repo) && drv_registry_mirror_oid(world, repo).length() > 0 {
        c_fs_unlock(lk)
        drv_rm_rf(world, tmp)
        return Err("registry mirror " + repo + " replaced concurrently")
      }
      let bak = tmp + ".old"
      let moved_old = !fs_is_dir(world, repo) || fs_rename(world, repo, bak)
      let ok = moved_old && fs_rename(world, tmp, repo)
      let mut kept = ""
      if ok {
        drv_rm_rf(world, bak)
      } else if moved_old && fs_is_dir(world, bak) {
        if fs_rename(world, bak, repo) {
          drv_rm_rf(world, bak)
        } else {
          // Rollback failed: the old mirror survives only as `bak`; keep it.
          kept = " (backup preserved at " + bak + ")"
        }
      }
      c_fs_unlock(lk)
      if !ok {
        drv_rm_rf(world, tmp)
        return Err("cannot replace the unusable registry mirror " + repo + kept)
      }
    } else if !fs_rename(world, tmp, repo) {
      drv_rm_rf(world, tmp)
      if !fs_is_dir(world, repo) {
        return Err("failed to move registry mirror into " + repo)
      }
      return Ok(repo)
    }
  } else {
    // The published snapshot is the mirror's detached HEAD (also its GC
    // root); a fetch never moves it. A mirror from an older pionc may still
    // have a symbolic HEAD: detach it once, compare-and-swap against the
    // value just read so a concurrent publish is never overwritten.
    let old_oid = drv_registry_mirror_oid(world, repo)
    if old_oid.length() == 0 {
      return Err("registry mirror " + repo + " changed concurrently")
    }
    match drv_git(world, ["--git-dir", repo, "symbolic-ref", "--quiet", "HEAD"]) {
      Ok(_) =>
        match drv_git(world, ["--git-dir", repo, "update-ref", "--no-deref", "HEAD", old_oid, old_oid]) {
          Err(e) => return Err("cannot detach the HEAD of registry mirror " + repo + ": " + e)
          Ok(_) => ()
        }
      Err(_) => ()
    }
    // One fetch; --prune only touches branches and tags.
    match drv_git(
      world,
      [
        "--git-dir", repo, "fetch", "--quiet", "--prune", "--", "origin", "+refs/heads/*:refs/heads/*",
        "+refs/tags/*:refs/tags/*",
      ],
    ) {
      Err(e) => return Err("cannot fetch registry " + url + ": " + e)
      Ok(_) => ()
    }
    match drv_registry_sync_head(world, repo, old_oid) {
      Err(e) => return Err("cannot read the default branch of registry " + url + ": " + e)
      Ok(_) => ()
    }
  }
  if drv_registry_mirror_oid(world, repo).length() == 0 {
    return Err("registry " + url + " has no commit on its default branch")
  }
  drv_registry_stamp(world, repo)
  Ok(repo)
}

///|
/// Reads `index/<name>.toml` at the registry's current `HEAD` and turns it
/// into a git dependency that remembers the registry.
fn drv_registry_lookup(
  world : World,
  url : String,
  name : String,
  fetched : Map[String, Bool],
) -> Result[ManifestDep, String] {
  let repo = match drv_registry_sync(world, url, fetched) {
    Err(e) => return Err(e)
    Ok(r) => r
  }
  let txt = match drv_git(world, ["--git-dir", repo, "show", "HEAD:" + registry_index_path(name)]) {
    Err(_) => return Err("package `" + name + "` not found in registry " + url)
    Ok(t) => t
  }
  match parse_registry_entry(name, txt) {
    Err(e) => Err("registry " + url + ": " + e)
    Ok(e) => Ok(registry_entry_dep(e, url))
  }
}

///|
/// Puts a file back as it was before a failed `add`/`update` (removes it when
/// it did not exist). Returns `true` when restoration succeeded.
fn drv_restore_file(world : World, path : String, existed : Bool, text : String) -> Bool {
  if existed {
    match fs_read(world, path) {
      Ok(cur) =>
        if cur == text {
          return true
        }
      Err(_) => ()
    }
    drv_write_text_atomic(world, path, text)
  } else {
    !fs_exists(world, path) || fs_remove(world, path)
  }
}

///|
fn drv_cmd_fail(world : World, as_json : Bool, msg : String) -> Int {
  if as_json {
    io_println(world, "{\"ok\":false,\"error\":" + json_quote(msg) + "}")
  } else {
    io_eprintln(world, "error: " + msg)
  }
  1
}

///|
/// Length of the well-formed UTF-8 sequence starting at byte `i` of `s`
/// (1 for ASCII), or 0 for a malformed / overlong / surrogate / truncated one.
fn drv_utf8_seq_len(s : String, i : Int) -> Int {
  let n = s.length()
  let c = str_code_at(s, i)
  if c < 0x80 {
    return 1
  }
  let mut need = 0
  let mut min = 0
  let mut cp = 0
  if c >= 0xC2 && c <= 0xDF {
    need = 1
    min = 0x80
    cp = c & 0x1F
  } else if c >= 0xE0 && c <= 0xEF {
    need = 2
    min = 0x800
    cp = c & 0x0F
  } else if c >= 0xF0 && c <= 0xF4 {
    need = 3
    min = 0x10000
    cp = c & 0x07
  } else {
    return 0
  }
  if i + need >= n {
    return 0
  }
  let mut k = 1
  while k <= need {
    let b = str_code_at(s, i + k)
    if (b & 0xC0) != 0x80 {
      return 0
    }
    cp = (cp << 6) | (b & 0x3F)
    k = k + 1
  }
  if cp < min || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
    return 0
  }
  need + 1
}

///|
/// Writes `s` as a quoted JSON string. Unlike `json_quote` (which re-encodes
/// every byte >= 0x80 as its own code point), well-formed UTF-8 is copied
/// through byte for byte, so non-ASCII text round-trips losslessly; `"`, `\`,
/// control characters and DEL are escaped, and a malformed UTF-8 byte becomes
/// `�` so the output is always valid JSON.
fn drv_json_write_str(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("\"")
  let n = s.length()
  let mut run = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 0x80 {
      if c == 34 || c == 92 || c < 32 || c == 127 {
        sb.write_string(slice_str(s, run, i))
        if c == 34 {
          sb.write_string("\\\"")
        } else if c == 92 {
          sb.write_string("\\\\")
        } else if c == 10 {
          sb.write_string("\\n")
        } else if c == 13 {
          sb.write_string("\\r")
        } else if c == 9 {
          sb.write_string("\\t")
        } else {
          sb.write_string("\\u00")
          sb.write_char(hex_digit((c >> 4) & 15))
          sb.write_char(hex_digit(c & 15))
        }
        run = i + 1
      }
      i = i + 1
    } else {
      let l = drv_utf8_seq_len(s, i)
      if l == 0 {
        sb.write_string(slice_str(s, run, i))
        sb.write_string("\\ufffd")
        i = i + 1
        run = i
      } else {
        i = i + l
      }
    }
  }
  sb.write_string(slice_str(s, run, n))
  sb.write_string("\"")
}

///|
fn drv_json_q(s : String) -> String {
  let sb = StringBuilder()
  drv_json_write_str(sb, s)
  sb.to_string()
}

///|
/// Makes registry text safe to print on a terminal: C0 controls, DEL and C1
/// controls (U+0080..U+009F, e.g. a bare CSI) become `?` (tab / newline /
/// carriage return become a space), and malformed UTF-8 bytes become `?`, so
/// no escape sequence from a registry can reach the terminal.
fn drv_term_safe(s : String) -> String {
  let sb = StringBuilder()
  let n = s.length()
  let mut run = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    let mut bad = 0
    let mut l = 1
    if c < 32 || c == 127 {
      bad = if c == 9 || c == 10 || c == 13 { 2 } else { 1 }
    } else if c >= 0x80 {
      l = drv_utf8_seq_len(s, i)
      if l == 0 {
        bad = 1
        l = 1
      } else if l == 2 && c == 0xC2 && str_code_at(s, i + 1) < 0xA0 {
        bad = 1
      }
    }
    if bad > 0 {
      sb.write_string(slice_str(s, run, i))
      sb.write_string(if bad == 2 { " " } else { "?" })
      run = i + l
    }
    i = i + l
  }
  sb.write_string(slice_str(s, run, n))
  sb.to_string()
}

///|
/// A parsed JSON value (catalog reader; numbers keep their source text).
enum DrvJv {
  DjNull
  DjBool(Bool)
  DjNum(String)
  DjStr(String, String)
  DjArr(Array[DrvJv])
  DjObj(Array[String], Array[DrvJv])
}

///|
struct DrvJp {
  src : String
  mut pos : Int
}

///|
fn drv_jp_err(p : DrvJp, msg : String) -> String {
  msg + " at byte " + p.pos.to_string()
}

///|
fn drv_jp_ws(p : DrvJp) -> Unit {
  let n = p.src.length()
  while p.pos < n {
    let c = str_code_at(p.src, p.pos)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      p.pos = p.pos + 1
    } else {
      break
    }
  }
}

///|
fn drv_jp_peek(p : DrvJp) -> Int {
  if p.pos < p.src.length() {
    str_code_at(p.src, p.pos)
  } else {
    -1
  }
}

///|
fn drv_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

///|
/// Reads the 4 hex digits of a `\uXXXX` escape at `p.pos` (-1 if malformed).
fn drv_jp_hex4(p : DrvJp) -> Int {
  if p.pos + 4 > p.src.length() {
    return -1
  }
  let mut v = 0
  let mut k = 0
  while k < 4 {
    let h = drv_hex_val(str_code_at(p.src, p.pos + k))
    if h < 0 {
      return -1
    }
    v = v * 16 + h
    k = k + 1
  }
  p.pos = p.pos + 4
  v
}

///|
/// Strict RFC 8259 string at `p.pos` (on the opening quote): escapes decoded
/// (surrogate pairs joined, lone surrogates rejected), raw control characters
/// and malformed UTF-8 rejected, everything else copied byte for byte.
fn drv_jp_string(p : DrvJp) -> Result[String, String] {
  let src = p.src
  let n = src.length()
  p.pos = p.pos + 1
  let sb = StringBuilder()
  let mut run = p.pos
  while p.pos < n {
    let c = str_code_at(src, p.pos)
    if c == 34 {
      sb.write_string(slice_str(src, run, p.pos))
      p.pos = p.pos + 1
      return Ok(sb.to_string())
    }
    if c == 92 {
      sb.write_string(slice_str(src, run, p.pos))
      if p.pos + 1 >= n {
        return Err(drv_jp_err(p, "unterminated escape"))
      }
      let e = str_code_at(src, p.pos + 1)
      p.pos = p.pos + 2
      if e == 34 {
        sb.write_string("\"")
      } else if e == 92 {
        sb.write_string("\\")
      } else if e == 47 {
        sb.write_string("/")
      } else if e == 98 {
        let bs = 8
        sb.write_char(bs.unsafe_to_char())
      } else if e == 102 {
        let ff = 12
        sb.write_char(ff.unsafe_to_char())
      } else if e == 110 {
        sb.write_string("\n")
      } else if e == 114 {
        sb.write_string("\r")
      } else if e == 116 {
        sb.write_string("\t")
      } else if e == 117 {
        let hi = drv_jp_hex4(p)
        if hi < 0 {
          return Err(drv_jp_err(p, "invalid \\u escape"))
        }
        let mut cp = hi
        if hi >= 0xD800 && hi <= 0xDBFF {
          if p.pos + 2 > n ||
            str_code_at(src, p.pos) != 92 ||
            str_code_at(src, p.pos + 1) != 117 {
            return Err(drv_jp_err(p, "unpaired surrogate in \\u escape"))
          }
          p.pos = p.pos + 2
          let lo = drv_jp_hex4(p)
          if lo < 0xDC00 || lo > 0xDFFF {
            return Err(drv_jp_err(p, "unpaired surrogate in \\u escape"))
          }
          cp = 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
        } else if hi >= 0xDC00 && hi <= 0xDFFF {
          return Err(drv_jp_err(p, "unpaired surrogate in \\u escape"))
        }
        sb.write_char(cp.unsafe_to_char())
      } else {
        return Err(drv_jp_err(p, "invalid escape"))
      }
      run = p.pos
      continue
    }
    if c < 32 {
      return Err(drv_jp_err(p, "control character in string"))
    }
    if c >= 0x80 {
      let l = drv_utf8_seq_len(src, p.pos)
      if l == 0 {
        return Err(drv_jp_err(p, "malformed UTF-8 in string"))
      }
      p.pos = p.pos + l
    } else {
      p.pos = p.pos + 1
    }
  }
  Err(drv_jp_err(p, "unterminated string"))
}

///|
fn drv_jp_digits(p : DrvJp) -> Int {
  let start = p.pos
  while p.pos < p.src.length() {
    let c = str_code_at(p.src, p.pos)
    if c >= 48 && c <= 57 {
      p.pos = p.pos + 1
    } else {
      break
    }
  }
  p.pos - start
}

///|
fn drv_jp_number(p : DrvJp) -> Result[DrvJv, String] {
  let start = p.pos
  if drv_jp_peek(p) == 45 {
    p.pos = p.pos + 1
  }
  let c = drv_jp_peek(p)
  if c == 48 {
    p.pos = p.pos + 1
  } else if c >= 49 && c <= 57 {
    let _ = drv_jp_digits(p)
  } else {
    return Err(drv_jp_err(p, "invalid number"))
  }
  if drv_jp_peek(p) == 46 {
    p.pos = p.pos + 1
    if drv_jp_digits(p) == 0 {
      return Err(drv_jp_err(p, "invalid number"))
    }
  }
  let e = drv_jp_peek(p)
  if e == 101 || e == 69 {
    p.pos = p.pos + 1
    let sgn = drv_jp_peek(p)
    if sgn == 43 || sgn == 45 {
      p.pos = p.pos + 1
    }
    if drv_jp_digits(p) == 0 {
      return Err(drv_jp_err(p, "invalid number"))
    }
  }
  Ok(DjNum(slice_str(p.src, start, p.pos)))
}

///|
fn drv_jp_word(p : DrvJp, w : String) -> Bool {
  let end_pos = p.pos + w.length()
  if end_pos > p.src.length() || slice_str(p.src, p.pos, end_pos) != w {
    return false
  }
  p.pos = end_pos
  true
}

///|
/// One JSON value at `p.pos` (nesting capped at 64 levels).
fn drv_jp_value(p : DrvJp, depth : Int) -> Result[DrvJv, String] {
  if depth > 64 {
    return Err(drv_jp_err(p, "nesting deeper than 64 levels"))
  }
  drv_jp_ws(p)
  let c = drv_jp_peek(p)
  if c < 0 {
    return Err(drv_jp_err(p, "unexpected end of input"))
  }
  if c == 123 {
    p.pos = p.pos + 1
    let keys : Array[String] = []
    let vals : Array[DrvJv] = []
    drv_jp_ws(p)
    if drv_jp_peek(p) == 125 {
      p.pos = p.pos + 1
      return Ok(DjObj(keys, vals))
    }
    while true {
      drv_jp_ws(p)
      if drv_jp_peek(p) != 34 {
        return Err(drv_jp_err(p, "expected object key"))
      }
      let k = match drv_jp_string(p) {
        Err(e) => return Err(e)
        Ok(s) => s
      }
      drv_jp_ws(p)
      if drv_jp_peek(p) != 58 {
        return Err(drv_jp_err(p, "expected `:`"))
      }
      p.pos = p.pos + 1
      let v = match drv_jp_value(p, depth + 1) {
        Err(e) => return Err(e)
        Ok(x) => x
      }
      keys.push(k)
      vals.push(v)
      drv_jp_ws(p)
      let d = drv_jp_peek(p)
      if d == 44 {
        p.pos = p.pos + 1
      } else if d == 125 {
        p.pos = p.pos + 1
        break
      } else {
        return Err(drv_jp_err(p, "expected `,` or `}`"))
      }
    }
    return Ok(DjObj(keys, vals))
  }
  if c == 91 {
    p.pos = p.pos + 1
    let items : Array[DrvJv] = []
    drv_jp_ws(p)
    if drv_jp_peek(p) == 93 {
      p.pos = p.pos + 1
      return Ok(DjArr(items))
    }
    while true {
      let v = match drv_jp_value(p, depth + 1) {
        Err(e) => return Err(e)
        Ok(x) => x
      }
      items.push(v)
      drv_jp_ws(p)
      let d = drv_jp_peek(p)
      if d == 44 {
        p.pos = p.pos + 1
      } else if d == 93 {
        p.pos = p.pos + 1
        break
      } else {
        return Err(drv_jp_err(p, "expected `,` or `]`"))
      }
    }
    return Ok(DjArr(items))
  }
  if c == 34 {
    let start = p.pos
    return match drv_jp_string(p) {
      Err(e) => Err(e)
      Ok(s) => Ok(DjStr(s, slice_str(p.src, start, p.pos)))
    }
  }
  if c == 45 || (c >= 48 && c <= 57) {
    return drv_jp_number(p)
  }
  if drv_jp_word(p, "true") {
    return Ok(DjBool(true))
  }
  if drv_jp_word(p, "false") {
    return Ok(DjBool(false))
  }
  if drv_jp_word(p, "null") {
    return Ok(DjNull)
  }
  Err(drv_jp_err(p, "unexpected character"))
}

///|
/// Parses a complete JSON document (no trailing bytes besides whitespace).
fn drv_json_parse(text : String) -> Result[DrvJv, String] {
  let p = DrvJp::{ src: text, pos: 0 }
  let v = match drv_jp_value(p, 0) {
    Err(e) => return Err(e)
    Ok(x) => x
  }
  drv_jp_ws(p)
  if p.pos != text.length() {
    return Err(drv_jp_err(p, "trailing characters after JSON value"))
  }
  Ok(v)
}

///|
/// One searchable registry package (the 10 `catalog.json` fields; `wasm32` /
/// `world_free` are 1 / 0, or -1 when the registry does not say).
struct DrvPkgInfo {
  name : String
  version : String
  tag : String
  subdir : String
  category : String
  summary : String
  keywords : Array[String]
  deps : Array[String]
  wasm32 : Int
  world_free : Int
}

///|
fn drv_jv_field(keys : Array[String], vals : Array[DrvJv], key : String) -> Option[DrvJv] {
  let mut i = 0
  while i < keys.length() {
    if keys[i] == key {
      return Some(vals[i])
    }
    i = i + 1
  }
  None
}

///|
fn drv_jv_str_field(
  keys : Array[String],
  vals : Array[DrvJv],
  key : String,
  ctx : String,
) -> Result[String, String] {
  match drv_jv_field(keys, vals, key) {
    None => Ok("")
    Some(DjStr(s, _)) => Ok(s)
    Some(_) => Err(ctx + ": `" + key + "` must be a string")
  }
}

///|
fn drv_jv_strs_field(
  keys : Array[String],
  vals : Array[DrvJv],
  key : String,
  ctx : String,
) -> Result[Array[String], String] {
  let out : Array[String] = []
  match drv_jv_field(keys, vals, key) {
    None => Ok(out)
    Some(DjArr(items)) => {
      let mut i = 0
      while i < items.length() {
        match items[i] {
          DjStr(s, _) => out.push(s)
          _ => return Err(ctx + ": `" + key + "` must be an array of strings")
        }
        i = i + 1
      }
      Ok(out)
    }
    Some(_) => Err(ctx + ": `" + key + "` must be an array of strings")
  }
}

///|
fn drv_jv_bool_field(
  keys : Array[String],
  vals : Array[DrvJv],
  key : String,
  ctx : String,
) -> Result[Int, String] {
  match drv_jv_field(keys, vals, key) {
    None => Ok(-1)
    Some(DjBool(b)) => Ok(if b { 1 } else { 0 })
    Some(_) => Err(ctx + ": `" + key + "` must be a boolean")
  }
}

///|
fn drv_catalog_pkg(
  keys : Array[String],
  vals : Array[DrvJv],
  idx : Int,
) -> Result[DrvPkgInfo, String] {
  let ctx = "packages[" + idx.to_string() + "]"
  let name = match drv_jv_str_field(keys, vals, "name", ctx) {
    Err(e) => return Err(e)
    Ok(s) => s
  }
  if name.length() == 0 {
    return Err(ctx + ": missing `name`")
  }
  if !manifest_valid_dep_name(name) {
    return Err(ctx + ": invalid package name `" + name + "`")
  }
  let strs : Array[String] = []
  let skeys : Array[String] = ["version", "tag", "subdir", "category", "summary"]
  let mut k = 0
  while k < skeys.length() {
    match drv_jv_str_field(keys, vals, skeys[k], ctx) {
      Err(e) => return Err(e)
      Ok(s) => strs.push(s)
    }
    k = k + 1
  }
  let keywords = match drv_jv_strs_field(keys, vals, "keywords", ctx) {
    Err(e) => return Err(e)
    Ok(a) => a
  }
  let deps = match drv_jv_strs_field(keys, vals, "deps", ctx) {
    Err(e) => return Err(e)
    Ok(a) => a
  }
  let wasm32 = match drv_jv_bool_field(keys, vals, "wasm32", ctx) {
    Err(e) => return Err(e)
    Ok(b) => b
  }
  let world_free = match drv_jv_bool_field(keys, vals, "world_free", ctx) {
    Err(e) => return Err(e)
    Ok(b) => b
  }
  Ok(DrvPkgInfo::{
    name: name,
    version: strs[0],
    tag: strs[1],
    subdir: strs[2],
    category: strs[3],
    summary: strs[4],
    keywords: keywords,
    deps: deps,
    wasm32: wasm32,
    world_free: world_free,
  })
}

///|
/// Validates and reads a registry `catalog.json`: a top-level object with
/// `"schema_version": 1` and a `packages` array of package objects.
fn drv_catalog_parse(text : String) -> Result[Array[DrvPkgInfo], String] {
  let root = match drv_json_parse(text) {
    Err(e) => return Err("invalid JSON: " + e)
    Ok(v) => v
  }
  let out : Array[DrvPkgInfo] = []
  match root {
    DjObj(keys, vals) => {
      match drv_jv_field(keys, vals, "schema_version") {
        Some(DjNum(t)) => {
          if t != "1" {
            return Err("unsupported schema_version " + t + " (this pionc reads 1)")
          }
        }
        None => return Err("missing schema_version")
        Some(_) => return Err("schema_version must be a number")
      }
      match drv_jv_field(keys, vals, "packages") {
        Some(DjArr(items)) => {
          let mut i = 0
          while i < items.length() {
            match items[i] {
              DjObj(pk, pv) =>
                match drv_catalog_pkg(pk, pv, i) {
                  Err(e) => return Err(e)
                  Ok(info) => out.push(info)
                }
              _ => return Err("packages[" + i.to_string() + "] must be an object")
            }
            i = i + 1
          }
        }
        None => return Err("missing `packages` array")
        Some(_) => return Err("`packages` must be an array")
      }
    }
    _ => return Err("top-level value must be an object")
  }
  Ok(out)
}

///|
/// One `git ls-tree -z` record: `<mode> <type> <oid>\t<name>`.
struct DrvTreeEnt {
  mode : String
  kind : String
  oid : String
  name : String
}

///|
fn drv_parse_ls_tree_z(out : String) -> Array[DrvTreeEnt] {
  let ents : Array[DrvTreeEnt] = []
  let n = out.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    if i == n || str_code_at(out, i) == 0 {
      if i > start {
        let rec = slice_str(out, start, i)
        let tab = drv_find_substr(rec, "\t", 0)
        let sp1 = drv_find_substr(rec, " ", 0)
        let sp2 = if sp1 >= 0 { drv_find_substr(rec, " ", sp1 + 1) } else { -1 }
        if tab > 0 && sp1 > 0 && sp2 > sp1 && sp2 < tab {
          ents.push(DrvTreeEnt::{
            mode: slice_str(rec, 0, sp1),
            kind: slice_str(rec, sp1 + 1, sp2),
            oid: slice_str(rec, sp2 + 1, tab),
            name: slice_str(rec, tab + 1, rec.length()),
          })
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  ents
}

///|
/// Non-negative decimal (at most 15 digits, so it cannot overflow), or -1.
fn drv_parse_size(s : String) -> Int64 {
  if s.length() == 0 || s.length() > 15 {
    return -1L
  }
  let mut v = 0L
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return -1L
    }
    v = v * 10L + (c - 48).to_int64()
    i = i + 1
  }
  v
}

///|
/// Reads the blobs `oids` of `repo` with a single `git cat-file --batch`
/// whose stdin is a temporary `<oid>\n` list file (no argv size limit), and
/// splits its output by the exact byte length of each `<oid> blob <size>`
/// header. On Windows (no `sh`) each blob is read with `git cat-file blob`.
fn drv_git_cat_batch(
  world : World,
  repo : String,
  oids : Array[String],
) -> Result[Array[String], String] {
  let res : Array[String] = []
  if oids.length() == 0 {
    return Ok(res)
  }
  if drv_env_str(world, "OS") == "Windows_NT" {
    let mut w = 0
    while w < oids.length() {
      match drv_git_raw(world, ["--git-dir", repo, "cat-file", "blob", oids[w]]) {
        Err(e) => return Err("git cat-file blob " + oids[w] + " failed: " + e)
        Ok(t) => res.push(t)
      }
      w = w + 1
    }
    return Ok(res)
  }
  let list = match proc_exec_capture(world, ["mktemp"]) {
    Err(e) => return Err("cannot create a temporary file: " + e)
    Ok(t) => drv_trim_ws(t)
  }
  let sb = StringBuilder()
  let mut i = 0
  while i < oids.length() {
    sb.write_string(oids[i])
    sb.write_string("\n")
    i = i + 1
  }
  match fs_write(world, list, sb.to_string()) {
    Err(e) => {
      let _ = fs_remove(world, list)
      return Err("cannot write " + list + ": " + e)
    }
    Ok(_) => ()
  }
  let got = proc_exec_capture(
    world,
    [
      "sh", "-c", drv_git_sh_wrap(
        "env GIT_TERMINAL_PROMPT=0 GIT_ALLOW_PROTOCOL=file:http:https:ssh git --git-dir \"$1\" cat-file --batch < \"$2\"",
      ),
      "pionc-git", repo, list,
    ],
  )
  let _ = fs_remove(world, list)
  let out = match got {
    Err(e) => return Err("git cat-file --batch failed: " + drv_git_err_text(e))
    Ok(o) => o
  }
  let mut pos = 0
  let mut k = 0
  while k < oids.length() {
    let nl = drv_find_substr(out, "\n", pos)
    if nl < 0 {
      return Err("truncated git cat-file --batch output")
    }
    let header = slice_str(out, pos, nl)
    let parts = drv_split_char(header, 32)
    if parts.length() != 3 || parts[0] != oids[k] || parts[1] != "blob" {
      return Err("unexpected git cat-file --batch header `" + drv_term_safe(header) + "`")
    }
    let size = drv_parse_size(parts[2])
    // The body and its trailing newline must fit in what is left.
    let left = (out.length() - (nl + 1)).to_int64()
    if size < 0L || size + 1L > left {
      return Err("truncated git cat-file --batch output")
    }
    let body_end = nl + 1 + size.to_int()
    if str_code_at(out, body_end) != 10 {
      return Err("malformed git cat-file --batch output")
    }
    res.push(slice_str(out, nl + 1, body_end))
    pos = body_end + 1
    k = k + 1
  }
  if pos != out.length() {
    return Err("unexpected trailing bytes in git cat-file --batch output")
  }
  Ok(res)
}

///|
/// Packages of a registry at one fixed commit `oid` of mirror `repo`:
/// `catalog.json` when the commit has one (a malformed or unsupported one is
/// an error, never a silent fallback), else the legacy `index/<name>.toml`
/// entries (regular blobs with a valid package name; read in one batch).
struct DrvRegistryPkgs {
  format : String
  pkgs : Array[DrvPkgInfo]
  /// Names with an `index/<name>.toml` in the same commit (what
  /// `pionc add <name>` can install).
  installable : Map[String, Bool]
}

///|
fn drv_registry_packages(
  world : World,
  repo : String,
  oid : String,
) -> Result[DrvRegistryPkgs, String] {
  let root_ls = match drv_git_raw(world, ["--git-dir", repo, "ls-tree", "-z", oid]) {
    Err(e) => return Err("cannot list commit " + oid + ": " + e)
    Ok(o) => o
  }
  let ents = drv_parse_ls_tree_z(root_ls)
  let mut cat_i = -1
  let mut idx_i = -1
  let mut i = 0
  while i < ents.length() {
    if ents[i].name == "catalog.json" {
      cat_i = i
    } else if ents[i].name == "index" && ents[i].kind == "tree" {
      idx_i = i
    }
    i = i + 1
  }
  if cat_i < 0 && idx_i < 0 {
    return Err("commit " + oid + " has neither catalog.json nor an index/ directory")
  }
  // index/ entries: regular blobs named `<valid name>.toml`.
  let names : Array[String] = []
  let oids : Array[String] = []
  let installable : Map[String, Bool] = Map([])
  if idx_i >= 0 {
    let idx_ls = match drv_git_raw(world, ["--git-dir", repo, "ls-tree", "-z", ents[idx_i].oid]) {
      Err(e) => return Err("cannot list index/ at " + oid + ": " + e)
      Ok(o) => o
    }
    let ients = drv_parse_ls_tree_z(idx_ls)
    i = 0
    while i < ients.length() {
      let e = ients[i]
      if (e.mode == "100644" || e.mode == "100755") &&
        e.kind == "blob" &&
        drv_ends_with(e.name, ".toml") {
        let stem = slice_str(e.name, 0, e.name.length() - 5)
        if manifest_valid_dep_name(stem) {
          names.push(stem)
          oids.push(e.oid)
          installable.set(stem, true)
        }
      }
      i = i + 1
    }
  }
  if cat_i >= 0 {
    let ce = ents[cat_i]
    if ce.kind != "blob" {
      return Err("catalog.json at " + oid + " is not a file")
    }
    let text = match drv_git_raw(world, ["--git-dir", repo, "cat-file", "blob", ce.oid]) {
      Err(e) => return Err("cannot read catalog.json at " + oid + ": " + e)
      Ok(t) => t
    }
    return match drv_catalog_parse(text) {
      Err(e) => Err("catalog.json at " + oid + ": " + e)
      Ok(pkgs) =>
        Ok(DrvRegistryPkgs::{ format: "catalog", pkgs: pkgs, installable: installable })
    }
  }
  let texts = match drv_git_cat_batch(world, repo, oids) {
    Err(e) => return Err(e)
    Ok(t) => t
  }
  let pkgs : Array[DrvPkgInfo] = []
  i = 0
  while i < names.length() {
    match parse_registry_entry(names[i], texts[i]) {
      Err(e) => return Err(e)
      Ok(re) =>
        pkgs.push(DrvPkgInfo::{
          name: re.name,
          version: re.version,
          tag: re.tag,
          subdir: re.subdir,
          category: "",
          summary: "",
          keywords: [],
          deps: [],
          wasm32: -1,
          world_free: -1,
        })
    }
    i = i + 1
  }
  Ok(DrvRegistryPkgs::{ format: "index", pkgs: pkgs, installable: installable })
}

///|
/// `s` as one POSIX shell word: unchanged when it only has safe characters,
/// else single-quoted (`'` written as `'\''`).
fn drv_shell_quote(s : String) -> String {
  let mut safe = s.length() > 0
  let mut i = 0
  while safe && i < s.length() {
    let c = str_code_at(s, i)
    safe = (c >= 48 && c <= 57) ||
      (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      c == 45 ||
      c == 46 ||
      c == 47 ||
      c == 58 ||
      c == 64 ||
      c == 95 ||
      c == 43 ||
      c == 61 ||
      c == 44 ||
      c == 37
    i = i + 1
  }
  if safe {
    return s
  }
  let sb = StringBuilder()
  sb.write_string("'")
  let mut run = 0
  i = 0
  while i < s.length() {
    if str_code_at(s, i) == 39 {
      sb.write_string(slice_str(s, run, i))
      sb.write_string("'\\''")
      run = i + 1
    }
    i = i + 1
  }
  sb.write_string(slice_str(s, run, s.length()))
  sb.write_string("'")
  sb.to_string()
}

///|
/// Splits a query argument into lower-cased words at ASCII whitespace.
fn drv_push_terms(terms : Array[String], arg : String) -> Unit {
  let n = arg.length()
  let mut start = 0
  let mut i = 0
  while i <= n {
    let c = if i == n { 32 } else { str_code_at(arg, i) }
    if c == 32 || (c >= 9 && c <= 13) {
      if i > start {
        terms.push(drv_ascii_lower(slice_str(arg, start, i)))
      }
      start = i + 1
    }
    i = i + 1
  }
}

///|
/// Every term (already lower-cased) must occur in the name, the summary or
/// one keyword (ASCII case-insensitive).
fn drv_pkg_matches(p : DrvPkgInfo, terms : Array[String]) -> Bool {
  let name = drv_ascii_lower(p.name)
  let summary = drv_ascii_lower(p.summary)
  let kws : Array[String] = []
  let mut k = 0
  while k < p.keywords.length() {
    kws.push(drv_ascii_lower(p.keywords[k]))
    k = k + 1
  }
  let mut t = 0
  while t < terms.length() {
    let term = terms[t]
    let mut hit = drv_find_substr(name, term, 0) >= 0 ||
      drv_find_substr(summary, term, 0) >= 0
    k = 0
    while !hit && k < kws.length() {
      hit = drv_find_substr(kws[k], term, 0) >= 0
      k = k + 1
    }
    if !hit {
      return false
    }
    t = t + 1
  }
  true
}

///|
/// 0: a term equals the name; 1: the name starts with a term; 2: other match.
fn drv_pkg_rank(p : DrvPkgInfo, terms : Array[String]) -> Int {
  let name = drv_ascii_lower(p.name)
  let mut best = 2
  let mut t = 0
  while t < terms.length() {
    if terms[t] == name {
      return 0
    }
    if drv_starts_with(name, terms[t]) {
      best = 1
    }
    t = t + 1
  }
  best
}

///|
fn drv_json_tri(v : Int) -> String {
  if v > 0 {
    "true"
  } else if v == 0 {
    "false"
  } else {
    "null"
  }
}

///|
fn drv_json_write_strs(sb : StringBuilder, items : Array[String]) -> Unit {
  sb.write_string("[")
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_string(",")
    }
    drv_json_write_str(sb, items[i])
    i = i + 1
  }
  sb.write_string("]")
}

///|
fn drv_pkg_write_json(sb : StringBuilder, p : DrvPkgInfo, installable : Bool) -> Unit {
  sb.write_string("{\"name\":")
  drv_json_write_str(sb, p.name)
  sb.write_string(",\"version\":")
  drv_json_write_str(sb, p.version)
  sb.write_string(",\"tag\":")
  drv_json_write_str(sb, p.tag)
  sb.write_string(",\"subdir\":")
  drv_json_write_str(sb, p.subdir)
  sb.write_string(",\"category\":")
  drv_json_write_str(sb, p.category)
  sb.write_string(",\"summary\":")
  drv_json_write_str(sb, p.summary)
  sb.write_string(",\"keywords\":")
  drv_json_write_strs(sb, p.keywords)
  sb.write_string(",\"deps\":")
  drv_json_write_strs(sb, p.deps)
  sb.write_string(",\"wasm32\":")
  sb.write_string(drv_json_tri(p.wasm32))
  sb.write_string(",\"world_free\":")
  sb.write_string(drv_json_tri(p.world_free))
  sb.write_string(",\"installable\":")
  sb.write_string(if installable { "true" } else { "false" })
  sb.write_string("}")
}

///|
/// Failure with a stable error `code`: `{"ok":false,"code":"...","error":"..."}`
/// with `--json`, else `error[CODE]: ...` on stderr; exit code 1.
fn drv_cmd_fail_code(world : World, as_json : Bool, code : String, msg : String) -> Int {
  if as_json {
    io_println(
      world,
      "{\"ok\":false,\"code\":" + drv_json_q(code) + ",\"error\":" + drv_json_q(msg) + "}",
    )
  } else {
    io_eprintln(world, "error[" + code + "]: " + drv_term_safe(msg))
  }
  1
}

///|
fn drv_pad_right(s : String, w : Int) -> String {
  if s.length() >= w {
    return s
  }
  let sb = StringBuilder()
  sb.write_string(s)
  let mut i = s.length()
  while i < w {
    sb.write_string(" ")
    i = i + 1
  }
  sb.to_string()
}

///|
/// `pionc search [--json] [--offline] [--refresh] [--registry <url_or_path>]
/// [--category <cat>] [query...]`: lists registry packages whose name, summary
/// or keywords contain every query word (ASCII case-insensitive), optionally
/// only those of one category; reads one fixed commit of the registry mirror
/// (refreshed at most every 10 minutes unless `--refresh`; never with
/// `--offline`; a failed refresh falls back to the cached mirror as `stale`).
fn drv_run_search_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut i = 2
  while i < args.length() {
    if args[i] == "--" {
      break
    }
    if args[i] == "--json" {
      as_json = true
    }
    i = i + 1
  }
  let mut offline = false
  let mut refresh = false
  let mut registry = ""
  let mut category = ""
  let terms : Array[String] = []
  let mut only_terms = false
  i = 2
  while i < args.length() {
    let a = args[i]
    if only_terms {
      drv_push_terms(terms, a)
    } else if a == "--" {
      only_terms = true
    } else if a == "--json" {
      ()
    } else if a == "--offline" {
      offline = true
    } else if a == "--refresh" {
      refresh = true
    } else if a == "--registry" || a == "--category" {
      if i + 1 >= args.length() ||
        args[i + 1].length() == 0 ||
        drv_starts_with(args[i + 1], "--") {
        return drv_cmd_fail_code(world, as_json, "E_INVALID_ARGS", "missing value for `" + a + "`")
      }
      if a == "--registry" {
        registry = args[i + 1]
      } else {
        category = args[i + 1]
      }
      i = i + 1
    } else if a.length() > 1 && drv_starts_with(a, "-") {
      return drv_cmd_fail_code(world, as_json, "E_INVALID_ARGS", "unknown option `" + a + "`")
    } else {
      drv_push_terms(terms, a)
    }
    i = i + 1
  }
  if offline && refresh {
    return drv_cmd_fail_code(world, as_json, "E_INVALID_ARGS", "--offline and --refresh cannot be combined")
  }
  let mut mf_dir = ""
  let mut mf_url = ""
  // A pion.toml in the working directory must parse even when --registry
  // makes its [registry] url irrelevant.
  match drv_detect_manifest_dir(world, ".") {
    Some(d) => {
      let mf_path = drv_join_path(d, "pion.toml")
      let text = match fs_read(world, mf_path) {
        Err(e) =>
          return drv_cmd_fail_code(world, as_json, "E_INVALID_MANIFEST", "failed to read " + mf_path + ": " + e)
        Ok(t) => t
      }
      match parse_pion_toml(text) {
        Err(e) =>
          return drv_cmd_fail_code(world, as_json, "E_INVALID_MANIFEST", mf_path + ": " + e)
        Ok(m) => {
          mf_url = m.registry
          mf_dir = drv_abs_path(world, d)
        }
      }
    }
    None => ()
  }
  let pick = drv_pick_registry(world, registry, mf_dir, mf_url)
  if pick.code.length() > 0 {
    return drv_cmd_fail_code(world, as_json, pick.code, pick.error)
  }
  let url = pick.url
  let repo = drv_registry_repo_path(world, url)
  let mut stale = false
  let mut warning = ""
  if !offline && (refresh || !drv_registry_is_fresh(world, repo)) {
    match drv_registry_sync(world, url, Map([])) {
      Ok(_) => ()
      Err(e) => {
        stale = true
        warning = e
      }
    }
  }
  // One commit for the whole query; a mirror whose HEAD resolves to no commit
  // (none cached, empty, default branch gone) is unusable.
  let oid = drv_registry_mirror_oid(world, repo)
  if oid.length() == 0 {
    let why = if offline {
      "registry " + url + " has no usable cached mirror (run `pionc search` once online)"
    } else if warning.length() > 0 {
      warning
    } else {
      "registry " + url + " has no commit on its default branch"
    }
    return drv_cmd_fail_code(world, as_json, "E_REGISTRY_UNREACHABLE", why)
  }
  let loaded = match drv_registry_packages(world, repo, oid) {
    Err(e) =>
      return drv_cmd_fail_code(world, as_json, "E_REGISTRY_INVALID_CATALOG", "registry " + url + ": " + e)
    Ok(l) => l
  }
  let cat_low = drv_ascii_lower(category)
  let hits : Array[DrvPkgInfo] = []
  let ranks : Array[Int] = []
  let mut pi = 0
  while pi < loaded.pkgs.length() {
    let p = loaded.pkgs[pi]
    let cat_ok = category.length() == 0 ||
      (p.category.length() > 0 && drv_ascii_lower(p.category) == cat_low)
    if cat_ok && drv_pkg_matches(p, terms) {
      let r = drv_pkg_rank(p, terms)
      // Stable insertion by (rank, name).
      hits.push(p)
      ranks.push(r)
      let mut j = hits.length() - 1
      while j > 0 &&
        (ranks[j - 1] > r || (ranks[j - 1] == r && p.name < hits[j - 1].name)) {
        hits[j] = hits[j - 1]
        ranks[j] = ranks[j - 1]
        j = j - 1
      }
      hits[j] = p
      ranks[j] = r
    }
    pi = pi + 1
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"registry\":")
    drv_json_write_str(sb, url)
    sb.write_string(",\"source\":")
    drv_json_write_str(sb, pick.source)
    sb.write_string(",\"commit\":")
    drv_json_write_str(sb, oid)
    sb.write_string(",\"format\":")
    drv_json_write_str(sb, loaded.format)
    sb.write_string(",\"stale\":")
    sb.write_string(if stale { "true" } else { "false" })
    if stale {
      sb.write_string(",\"warning\":")
      drv_json_write_str(sb, warning)
    }
    sb.write_string(",\"count\":")
    sb.write_string(hits.length().to_string())
    sb.write_string(",\"packages\":[")
    let mut h = 0
    while h < hits.length() {
      if h > 0 {
        sb.write_string(",")
      }
      drv_pkg_write_json(sb, hits[h], loaded.installable.contains(hits[h].name))
      h = h + 1
    }
    sb.write_string("]}")
    io_println(world, sb.to_string())
    return 0
  }
  if stale {
    io_eprintln(
      world,
      "warning: showing the cached (stale) index of registry " +
      drv_term_safe(url) +
      ": " +
      drv_term_safe(warning),
    )
  }
  if hits.length() == 0 {
    io_println(world, "no packages match (registry " + drv_term_safe(url) + ")")
    return 0
  }
  let rows_name : Array[String] = []
  let rows_ver : Array[String] = []
  let rows_cat : Array[String] = []
  let mut w_name = 0
  let mut w_ver = 0
  let mut w_cat = 0
  let mut h = 0
  while h < hits.length() {
    let nm = drv_term_safe(hits[h].name)
    let vr = drv_term_safe(hits[h].version)
    let ct = drv_term_safe(hits[h].category)
    if nm.length() > w_name {
      w_name = nm.length()
    }
    if vr.length() > w_ver {
      w_ver = vr.length()
    }
    if ct.length() > w_cat {
      w_cat = ct.length()
    }
    rows_name.push(nm)
    rows_ver.push(vr)
    rows_cat.push(ct)
    h = h + 1
  }
  let sb = StringBuilder()
  h = 0
  while h < hits.length() {
    sb.write_string(drv_pad_right(rows_name[h], w_name))
    sb.write_string("  ")
    sb.write_string(drv_pad_right(rows_ver[h], w_ver))
    if w_cat > 0 {
      sb.write_string("  ")
      sb.write_string(drv_pad_right(rows_cat[h], w_cat))
    }
    let sm = drv_term_safe(hits[h].summary)
    if sm.length() > 0 {
      sb.write_string("  ")
      sb.write_string(sm)
    }
    sb.write_string("\n")
    h = h + 1
  }
  sb.write_string(
    hits.length().to_string() +
    (if hits.length() == 1 { " package" } else { " packages" }) +
    " (registry " +
    drv_term_safe(url) +
    ")",
  )
  let mut first_ok = ""
  h = 0
  while h < hits.length() && first_ok.length() == 0 {
    // With --registry the hint must name exactly that location; one that
    // cannot be shown losslessly on a terminal gets no hint at all.
    if manifest_valid_dep_name(hits[h].name) &&
      loaded.installable.contains(hits[h].name) &&
      (pick.source != "flag" || drv_term_safe(url) == url) {
      first_ok = hits[h].name
    }
    h = h + 1
  }
  if first_ok.length() > 0 {
    sb.write_string("\ninstall: pionc add " + first_ok)
    if pick.source == "flag" {
      sb.write_string(" --registry " + drv_shell_quote(url))
    }
  }
  io_println(world, sb.to_string())
  0
}

///|
/// Type-checks every package of a loaded workspace (dependencies first);
/// returns the package-graph or type diagnostics.
fn drv_ws_diagnostics(nodes : Array[PkgNodeInput]) -> Array[Diagnostic] {
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return topo.diagnostics
  }
  let imported : Array[ImportedPkg] = []
  let all_diags : Array[Diagnostic] = []
  let mut k = 0
  while k < topo.order.length() {
    let node = nodes[topo.order[k]]
    let cr = check_source_files_with_imports_mapped(
      node.name,
      node.paths,
      node.sources,
      imported,
      node.dep_aliases,
      node.deps,
      true,
      false,
    )
    let mut di = 0
    while di < cr.diagnostics.length() {
      all_diags.push(cr.diagnostics[di])
      di = di + 1
    }
    imported.push(ImportedPkg::{ name: node.name, tc: cr.tc })
    k = k + 1
  }
  all_diags
}

///|
/// Incremental CAS-backed workspace type check: caches clean packages'
/// `.pionsig` and `.pionstub` in `$PION_CACHE_DIR/sig/` keyed by package
/// sources, upstream `.pionsig` hashes, and `pionc` self-fingerprint (never
/// probing `qbe`/`libpionrt.a`). Packages with diagnostics or errored upstream
/// dependencies are never cached.
fn drv_ws_diagnostics_cached(
  world : World,
  nodes : Array[PkgNodeInput],
) -> Array[Diagnostic] {
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return topo.diagnostics
  }
  let n = topo.order.length()
  let trans = drv_trans_deps(nodes, topo.order)
  let trans_dep_topo = trans.topo
  let trans_dep_names = trans.names
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let check_fp = drv_compute_self_fp(world, "check-v1")
  let trace_cas = drv_env_str(world, "PION_TRACE_CAS") == "1"

  let stub_paths : Array[String] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let pkg_has_err : Array[Bool] = []
  let mut k = 0
  while k < n {
    stub_paths.push("")
    loaded_imported.push(None)
    pkg_has_err.push(false)
    k = k + 1
  }
  let sig_hashes : Map[String, String] = Map([])
  let pin = drv_cas_pin_open(world, cache_dir)
  let new_keys : Array[String] = []
  let new_sizes : Array[Int64] = []
  let all_diags : Array[Diagnostic] = []

  k = 0
  while k < n {
    let node = nodes[topo.order[k]]
    let deps_k = trans_dep_topo[k]
    let mut any_dep_err = false
    let mut di = 0
    while di < deps_k.length() {
      if pkg_has_err[deps_k[di]] {
        any_dep_err = true
        break
      }
      di = di + 1
    }
    let upstream_sigs : Array[String] = []
    let t_names = trans_dep_names[k]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh)
      u = u + 1
    }
    drv_append_dep_alias_sigs(upstream_sigs, node)
    let key = cas_compute_key(
      node.name,
      drv_cas_rel_paths(node),
      node.sources,
      upstream_sigs,
      "check",
      false,
      check_fp,
    )
    let sig_path = cache_dir + "/sig/" + key + ".pionsig"
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"
    let mut cas_hit = false
    if !any_dep_err && drv_is_regular_file(sig_path) && drv_is_regular_file(stub_path) {
      match fs_read(world, sig_path) {
        Ok(sig_text) => {
          sig_hashes.set(node.name, drv_effective_sig_hash(sig_text, node, sig_hashes))
          stub_paths[k] = stub_path
          drv_cas_pin_add(pin, key)
          cas_hit = true
          if trace_cas {
            io_eprintln(
              world,
              "[cas-check] pkg=" + node.declared_name + " HIT key=" + drv_prefix16(key),
            )
          }
        }
        Err(_) => ()
      }
    }
    if !cas_hit {
      if trace_cas {
        io_eprintln(
          world,
          "[cas-check] pkg=" + node.declared_name + " MISS key=" + drv_prefix16(key),
        )
      }
      let k_imports = drv_ensure_ws_imports_ex(
        world,
        nodes,
        topo.order,
        trans_dep_topo,
        stub_paths,
        loaded_imported,
        k,
        Some(all_diags),
      )
      let cr = check_source_files_with_imports_mapped(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        node.dep_aliases,
        node.deps,
        true,
        false,
      )
      loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      if cr.diagnostics.length() > 0 {
        let mut ei = 0
        while ei < cr.diagnostics.length() {
          all_diags.push(cr.diagnostics[ei])
          ei = ei + 1
        }
        pkg_has_err[k] = true
      } else {
        let pionsig = emit_pionsig(cr.pkg)
        sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
        if !any_dep_err {
          let pionstub = emit_pion_stub(cr.pkg)
          let _ = drv_write_cas_text_atomic(world, sig_path, pionsig)
          let _ = drv_write_cas_text_atomic(world, stub_path, pionstub)
          stub_paths[k] = stub_path
          drv_cas_pin_add(pin, key)
          new_keys.push(key)
          new_sizes.push((pionsig.length() + pionstub.length()).to_int64())
        }
      }
    }
    k = k + 1
  }
  if new_keys.length() > 0 {
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      new_keys,
      new_sizes,
      pin,
    )
  }
  drv_cas_post_run_evict(world, cache_dir, pin, [])
  all_diags
}

///|
/// `pionc add [--json] <name> (--path <p> | --git <url> [--tag|--rev|--branch <r>]
/// [--subdir <s>] | [--registry <url_or_path>]) [dir]`: sets the dependency in
/// `pion.toml` (in place, idempotent), resolves it into the shared cache and
/// `pion.lock`; both files are restored when resolution fails.
fn drv_run_add_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut name = ""
  let mut dir = ""
  let mut path = ""
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut registry = ""
  let mut registry_set = false
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    let has_val = i + 1 < args.length()
    if a == "--json" {
      as_json = true
    } else if a == "--path" && has_val {
      path = args[i + 1]
      i = i + 1
    } else if a == "--git" && has_val {
      git = args[i + 1]
      i = i + 1
    } else if a == "--tag" && has_val {
      tag = args[i + 1]
      i = i + 1
    } else if a == "--rev" && has_val {
      rev = args[i + 1]
      i = i + 1
    } else if a == "--branch" && has_val {
      branch = args[i + 1]
      i = i + 1
    } else if a == "--subdir" && has_val {
      subdir = args[i + 1]
      i = i + 1
    } else if a == "--registry" && has_val {
      registry = args[i + 1]
      registry_set = true
      i = i + 1
    } else if drv_starts_with(a, "--") {
      return drv_cmd_fail(world, as_json, "unknown or incomplete option `" + a + "`")
    } else if name.length() == 0 {
      name = a
    } else if dir.length() == 0 {
      dir = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if registry_set && registry.length() == 0 {
    return drv_cmd_fail_code(world, as_json, "E_INVALID_ARGS", "--registry needs a non-empty URL or path")
  }
  if name.length() == 0 {
    return drv_cmd_fail(world, as_json, "usage: pionc add [--json] <name> (--path <p> | --git <url> [--tag <t>|--rev <r>|--branch <b>] [--subdir <s>] | [--registry <url_or_path>]) [dir]")
  }
  if !manifest_valid_dep_name(name) {
    return drv_cmd_fail(world, as_json, "invalid package name `" + name + "`")
  }
  let mut nrefs = 0
  if tag.length() > 0 {
    nrefs = nrefs + 1
  }
  if rev.length() > 0 {
    nrefs = nrefs + 1
  }
  if branch.length() > 0 {
    nrefs = nrefs + 1
  }
  if path.length() > 0 && (git.length() > 0 || registry.length() > 0) {
    return drv_cmd_fail(world, as_json, "--path cannot be combined with --git or --registry")
  }
  if git.length() > 0 && registry.length() > 0 {
    return drv_cmd_fail(world, as_json, "--git cannot be combined with --registry")
  }
  if git.length() == 0 && (nrefs > 0 || subdir.length() > 0) {
    return drv_cmd_fail(world, as_json, "--tag/--rev/--branch/--subdir require --git")
  }
  if nrefs > 1 {
    return drv_cmd_fail(world, as_json, "pass at most one of --tag, --rev, --branch")
  }
  let target_dir = if dir.length() > 0 { dir } else { "." }
  let root_dir = match drv_detect_manifest_dir(world, target_dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + target_dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  if mf.is_workspace && mf.name.length() == 0 {
    return drv_cmd_fail(
      world,
      as_json,
      "cannot run `pionc add` on a virtual workspace root; pass a member package directory",
    )
  }
  if mf.name == name {
    return drv_cmd_fail(world, as_json, "package `" + name + "` cannot depend on itself")
  }
  let fetched : Map[String, Bool] = Map([])
  let mut source = ""
  let mut location = ""
  let dep = if path.length() > 0 {
    let dep_dir = drv_resolve_rel_path(drv_canon_dir(world, root_dir), path)
    if !fs_exists(world, drv_join_path(dep_dir, "pion.toml")) {
      return drv_cmd_fail(world, as_json, "no pion.toml in " + dep_dir)
    }
    source = "path"
    location = path
    manifest_dep_new(name, path, "", "", "", "", "")
  } else if git.length() > 0 {
    source = "git"
    location = git
    manifest_dep_new(name, "", git, tag, rev, branch, subdir)
  } else {
    let pick = drv_pick_registry(world, registry, drv_abs_path(world, root_dir), mf.registry)
    if pick.code.length() > 0 {
      return drv_cmd_fail_code(
        world,
        as_json,
        pick.code,
        "no source for `" + name + "`: " + pick.error,
      )
    }
    let abs_url = pick.url
    source = "registry"
    location = abs_url
    match drv_registry_lookup(world, abs_url, name, fetched) {
      Err(e) => return drv_cmd_fail(world, as_json, e)
      Ok(d) => d
    }
  }
  let new_text = manifest_set_dependency(text, dep)
  match parse_pion_toml(new_text) {
    Err(e) => return drv_cmd_fail(world, as_json, "rewritten pion.toml does not parse: " + e)
    Ok(_) => ()
  }
  let enclosing_ws = if mf.is_workspace {
    Some(DrvEnclosingWs::{
      root_dir: drv_abs_path(world, root_dir),
      manifest: mf,
      manifest_text: text,
    })
  } else {
    drv_find_enclosing_workspace(world, root_dir)
  }
  let lock_base = match enclosing_ws {
    Some(ws) => ws.root_dir
    None => drv_normalize_path(root_dir)
  }
  let lock_path = drv_join_path(lock_base, "pion.lock")
  let lock_existed = fs_exists(world, lock_path)
  let lock_text = if lock_existed {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + lock_path + ": " + e)
    }
  } else {
    ""
  }
  let changed = new_text != text
  if changed && !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let unlock_dep : Option[ManifestDep] = if manifest_dep_is_git(dep) {
    Some(dep)
  } else {
    None
  }
  let ws = match drv_load_workspace_unlock_dep(world, lock_base, false, unlock_dep) {
    Err(e) => {
      let mut msg = e
      if changed && !drv_restore_file(world, mf_path, true, text) {
        msg = msg + "; failed to restore " + mf_path
      }
      if !drv_restore_file(world, lock_path, lock_existed, lock_text) {
        msg = msg + "; failed to restore " + lock_path
      }
      return drv_cmd_fail(world, as_json, msg)
    }
    Ok(v) => v
  }
  let root_canon = drv_canon_dir(world, root_dir)
  let mut found = false
  let mut ni = 0
  while ni < ws.nodes.length() {
    if drv_canon_dir(world, ws.nodes[ni].dir) == root_canon {
      let mut ai = 0
      while ai < ws.nodes[ni].dep_aliases.length() {
        if ws.nodes[ni].dep_aliases[ai] == name {
          found = true
          break
        }
        ai = ai + 1
      }
    }
    ni = ni + 1
  }
  if !found {
    let mut msg = "the pion.toml at " + location + " does not declare package `" + name + "`"
    if changed && !drv_restore_file(world, mf_path, true, text) {
      msg = msg + "; failed to restore " + mf_path
    }
    if !drv_restore_file(world, lock_path, lock_existed, lock_text) {
      msg = msg + "; failed to restore " + lock_path
    }
    return drv_cmd_fail(world, as_json, msg)
  }
  let locked = if manifest_dep_is_git(dep) {
    let probe = lock_entry_new(
      manifest_dep_pkg_name(dep),
      dep.git,
      manifest_dep_ref(dep),
      "",
      dep.subdir,
    )
    lock_rev_for_entry(ws.lock, probe)
  } else {
    ""
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"action\":\"add\",\"package\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"source\":")
    sb.write_string(json_quote(source))
    sb.write_string(",\"location\":")
    drv_json_write_str(sb, location)
    sb.write_string(",\"version\":")
    sb.write_string(json_quote(dep.version))
    sb.write_string(",\"rev\":")
    sb.write_string(json_quote(locked))
    sb.write_string(",\"changed\":")
    sb.write_string(if changed { "true" } else { "false" })
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(
      world,
      (if changed { "added `" } else { "unchanged `" }) +
      name +
      "` (" +
      source +
      " " +
      location +
      (if locked.length() > 0 { " @ " + locked } else { "" }) +
      ")",
    )
  }
  0
}

///|
/// `pionc update [--json] [pkg] [dir]`: re-reads registry entries, re-resolves
/// every git dependency (or only `pkg`) to its newest target ref, rewrites
/// `pion.lock`, and checks the workspace; on any failure `pion.toml` and
/// `pion.lock` are restored.
fn drv_run_update_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let pos : Array[String] = []
  let mut i = 2
  while i < args.length() {
    if args[i] == "--json" {
      as_json = true
    } else if drv_starts_with(args[i], "--") {
      return drv_cmd_fail(world, as_json, "unknown option `" + args[i] + "`")
    } else {
      pos.push(args[i])
    }
    i = i + 1
  }
  let mut pkg = ""
  let mut dir = "."
  if pos.length() == 2 {
    pkg = pos[0]
    dir = pos[1]
  } else if pos.length() == 1 {
    match drv_detect_manifest_dir(world, pos[0]) {
      Some(_) => dir = pos[0]
      None => pkg = pos[0]
    }
  } else if pos.length() > 2 {
    return drv_cmd_fail(world, as_json, "usage: pionc update [--json] [pkg] [dir]")
  }
  let root_dir = match drv_detect_manifest_dir(world, dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  let enclosing_ws = if mf.is_workspace {
    Some(DrvEnclosingWs::{
      root_dir: drv_abs_path(world, root_dir),
      manifest: mf,
      manifest_text: text,
    })
  } else {
    drv_find_enclosing_workspace(world, root_dir)
  }
  let mut target_dep_before : Option[ManifestDep] = None
  let mut target_ws_dep_name = ""
  if pkg.length() > 0 {
    let mut known = false
    let mut di = 0
    while di < mf.deps.length() {
      if mf.deps[di].name == pkg {
        known = true
        let resolved_d = if mf.deps[di].workspace {
          match enclosing_ws {
            Some(ws) => {
              let mut wdi = 0
              while wdi < ws.manifest.workspace_deps.length() {
                if ws.manifest.workspace_deps[wdi].name == mf.deps[di].name {
                  target_ws_dep_name = ws.manifest.workspace_deps[wdi].name
                  break
                }
                wdi = wdi + 1
              }
              if target_ws_dep_name.length() == 0 && mf.deps[di].package.length() > 0 {
                wdi = 0
                while wdi < ws.manifest.workspace_deps.length() {
                  if ws.manifest.workspace_deps[wdi].name == mf.deps[di].package {
                    target_ws_dep_name = ws.manifest.workspace_deps[wdi].name
                    break
                  }
                  wdi = wdi + 1
                }
              }
              match manifest_resolve_ws_dep(
                mf.deps[di],
                ws.root_dir,
                drv_abs_path(world, root_dir),
                ws.manifest.workspace_deps,
              ) {
                Ok(rd) => rd
                Err(e) => return drv_cmd_fail(world, as_json, e)
              }
            }
            None =>
              return drv_cmd_fail(
                world,
                as_json,
                "dependency '" +
                pkg +
                "' marked workspace = true but no enclosing [workspace] pion.toml found",
              )
          }
        } else {
          mf.deps[di]
        }
        if !manifest_dep_is_git(resolved_d) {
          return drv_cmd_fail(world, as_json, "`" + pkg + "` is a path dependency; nothing to update")
        }
        target_dep_before = Some(resolved_d)
      }
      di = di + 1
    }
    if !known && mf.is_workspace {
      let mut wi = 0
      while wi < mf.workspace_deps.length() {
        if mf.workspace_deps[wi].name == pkg {
          known = true
          if !manifest_dep_is_git(mf.workspace_deps[wi]) {
            return drv_cmd_fail(world, as_json, "`" + pkg + "` is a path dependency; nothing to update")
          }
          target_dep_before = Some(mf.workspace_deps[wi])
          target_ws_dep_name = mf.workspace_deps[wi].name
        }
        wi = wi + 1
      }
    }
    if !known {
      return drv_cmd_fail(world, as_json, "no dependency `" + pkg + "` in " + mf_path)
    }
  }
  let mut ws_mf_path = ""
  let mut ws_text = ""
  if !mf.is_workspace {
    match enclosing_ws {
      Some(ws) => {
        ws_mf_path = drv_join_path(ws.root_dir, "pion.toml")
        ws_text = match fs_read(world, ws_mf_path) {
          Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + ws_mf_path + ": " + e)
          Ok(t) => t
        }
      }
      None => ()
    }
  }
  let fetched : Map[String, Bool] = Map([])
  let mut new_text = text
  let mut new_ws_text = ws_text
  let mut target_dep_after : Option[ManifestDep] = target_dep_before
  let reg_old_deps : Array[ManifestDep] = []
  let reg_new_deps : Array[ManifestDep] = []
  let mut di = 0
  while di < mf.deps.length() {
    let d = mf.deps[di]
    if !d.workspace && d.registry.length() > 0 && (pkg.length() == 0 || d.name == pkg) {
      let real_pkg = manifest_dep_pkg_name(d)
      match drv_registry_lookup(world, d.registry, real_pkg, fetched) {
        Err(e) => return drv_cmd_fail(world, as_json, e)
        Ok(nd) => {
          let kept_nd = ManifestDep::{
            name: d.name,
            package: d.package,
            path: nd.path,
            git: nd.git,
            tag: nd.tag,
            rev: nd.rev,
            branch: nd.branch,
            subdir: nd.subdir,
            registry: nd.registry,
            version: nd.version,
            workspace: false,
          }
          new_text = manifest_set_dependency(new_text, kept_nd)
          reg_old_deps.push(d)
          reg_new_deps.push(kept_nd)
          if pkg.length() > 0 && d.name == pkg {
            target_dep_after = Some(kept_nd)
          }
        }
      }
    }
    di = di + 1
  }
  match enclosing_ws {
    Some(ws) => {
      let mut wi = 0
      while wi < ws.manifest.workspace_deps.length() {
        let wd = ws.manifest.workspace_deps[wi]
        let want_wd = wd.registry.length() > 0 &&
          (pkg.length() == 0 ||
          (target_ws_dep_name.length() > 0 && wd.name == target_ws_dep_name))
        if want_wd {
          let real_pkg = manifest_dep_pkg_name(wd)
          match drv_registry_lookup(world, wd.registry, real_pkg, fetched) {
            Err(e) => return drv_cmd_fail(world, as_json, e)
            Ok(nd) => {
              let kept_wd = ManifestDep::{
                name: wd.name,
                package: wd.package,
                path: nd.path,
                git: nd.git,
                tag: nd.tag,
                rev: nd.rev,
                branch: nd.branch,
                subdir: nd.subdir,
                registry: nd.registry,
                version: nd.version,
                workspace: false,
              }
              if mf.is_workspace {
                new_text = manifest_set_workspace_dependency(new_text, kept_wd)
              } else {
                new_ws_text = manifest_set_workspace_dependency(new_ws_text, kept_wd)
              }
              reg_old_deps.push(wd)
              reg_new_deps.push(kept_wd)
              if pkg.length() > 0 {
                target_dep_after = Some(kept_wd)
              }
            }
          }
        }
        wi = wi + 1
      }
    }
    None => ()
  }
  let lock_base = match enclosing_ws {
    Some(ws) => ws.root_dir
    None => drv_normalize_path(root_dir)
  }
  let lock_path = drv_join_path(lock_base, "pion.lock")
  let lock_existed = fs_exists(world, lock_path)
  let lock_text = if lock_existed {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + lock_path + ": " + e)
    }
  } else {
    ""
  }
  let old_lock = if lock_existed {
    match parse_pion_lock(lock_text) {
      Ok(v) => v
      Err(_) => []
    }
  } else {
    []
  }
  let mf_changed = new_text != text
  if mf_changed && !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let ws_mf_changed = !mf.is_workspace && ws_mf_path.length() > 0 && new_ws_text != ws_text
  if ws_mf_changed && !drv_write_text_atomic(world, ws_mf_path, new_ws_text) {
    let mut msg = "failed to write " + ws_mf_path
    if mf_changed && !drv_restore_file(world, mf_path, true, text) {
      msg = msg + "; failed to restore " + mf_path
    }
    return drv_cmd_fail(world, as_json, msg)
  }
  let load_dir = match enclosing_ws {
    Some(ws) => ws.root_dir
    None => root_dir
  }
  let unlock_target = match target_dep_after {
    Some(_) => target_dep_after
    None => target_dep_before
  }
  let ws = match drv_load_workspace_unlock_dep(
    world,
    load_dir,
    pkg.length() == 0,
    unlock_target,
  ) {
    Err(e) => {
      let mut msg = e
      if mf_changed && !drv_restore_file(world, mf_path, true, text) {
        msg = msg + "; failed to restore " + mf_path
      }
      if ws_mf_changed && !drv_restore_file(world, ws_mf_path, true, ws_text) {
        msg = msg + "; failed to restore " + ws_mf_path
      }
      if !drv_restore_file(world, lock_path, lock_existed, lock_text) {
        msg = msg + "; failed to restore " + lock_path
      }
      return drv_cmd_fail(world, as_json, msg)
    }
    Ok(v) => v
  }
  let diags = drv_ws_diagnostics_cached(world, ws.nodes)
  if diags.length() > 0 {
    let mut err_msg = "workspace does not check after update; pion.toml and pion.lock restored"
    if mf_changed && !drv_restore_file(world, mf_path, true, text) {
      err_msg = err_msg + "; failed to restore " + mf_path
    }
    if ws_mf_changed && !drv_restore_file(world, ws_mf_path, true, ws_text) {
      err_msg = err_msg + "; failed to restore " + ws_mf_path
    }
    if !drv_restore_file(world, lock_path, lock_existed, lock_text) {
      err_msg = err_msg + "; failed to restore " + lock_path
    }
    if as_json {
      io_println(
        world,
        "{\"ok\":false,\"error\":" +
        json_quote(err_msg) +
        ",\"check\":" +
        check_result_to_json(diags) +
        "}",
      )
    } else {
      io_eprintln(world, "error: " + err_msg)
      io_eprintln(world, check_result_to_json(diags))
    }
    return 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":true,\"action\":\"update\",\"packages\":[")
  let mut first = true
  let mut li = 0
  while li < ws.lock.length() {
    let e = ws.lock[li]
    let matched_target = match target_dep_after {
      None => true
      Some(td) =>
        lock_entry_pkg_name(e) == manifest_dep_pkg_name(td) &&
        pkg_normalize_git_url(e.git) == pkg_normalize_git_url(td.git) &&
        pkg_normalize_subdir(e.subdir) == pkg_normalize_subdir(td.subdir) &&
        e.reference == manifest_dep_ref(td)
    }
    if matched_target {
      let mut from = lock_rev_for_entry(old_lock, e)
      if from.length() == 0 {
        let mut rui = 0
        while rui < reg_new_deps.length() {
          let rnd = reg_new_deps[rui]
          if manifest_dep_pkg_name(rnd) == lock_entry_pkg_name(e) &&
            pkg_normalize_git_url(rnd.git) == pkg_normalize_git_url(e.git) &&
            pkg_normalize_subdir(rnd.subdir) == pkg_normalize_subdir(e.subdir) &&
            manifest_dep_ref(rnd) == e.reference {
            let rod = reg_old_deps[rui]
            let probe = lock_entry_new(
              manifest_dep_pkg_name(rod),
              rod.git,
              manifest_dep_ref(rod),
              "",
              rod.subdir,
            )
            from = lock_rev_for_entry(old_lock, probe)
            break
          }
          rui = rui + 1
        }
      }
      let upd = from != e.rev
      let report_name = if pkg.length() > 0 { pkg } else { e.name }
      if as_json {
        if !first {
          sb.write_string(",")
        }
        first = false
        sb.write_string("{\"name\":")
        sb.write_string(json_quote(report_name))
        sb.write_string(",\"ref\":")
        sb.write_string(json_quote(e.reference))
        sb.write_string(",\"from\":")
        sb.write_string(json_quote(from))
        sb.write_string(",\"to\":")
        sb.write_string(json_quote(e.rev))
        sb.write_string(",\"updated\":")
        sb.write_string(if upd { "true" } else { "false" })
        sb.write_string("}")
      } else {
        io_println(
          world,
          (if upd { "updated " } else { "unchanged " }) +
          report_name +
          " " +
          e.reference +
          " " +
          (if upd && from.length() > 0 { from + " -> " } else { "" }) +
          e.rev,
        )
      }
    }
    li = li + 1
  }
  sb.write_string("]}")
  if as_json {
    io_println(world, sb.to_string())
  }
  0
}

///|
fn drv_has_default_project(world : World) -> Bool {
  fs_exists(world, "pion.toml") || fs_is_dir(world, "src")
}

///|
struct DrvByteEdit {
  start : Int
  end : Int
  replacement : String
}

///|
fn drv_line_starts(src : String) -> Array[Int] {
  let starts : Array[Int] = [0]
  let mut i = 0
  while i < src.length() {
    if str_code_at(src, i) == 10 {
      starts.push(i + 1)
    }
    i = i + 1
  }
  starts
}

///|
fn drv_line_col_to_offset(
  src : String,
  starts : Array[Int],
  line : Int,
  col : Int,
) -> Int {
  if line < 1 || col < 1 || line > starts.length() {
    return -1
  }
  let ls = starts[line - 1]
  let off = ls + (col - 1)
  if off < ls || off > src.length() {
    return -1
  }
  off
}

///|
fn drv_sort_byte_edits_desc(edits : Array[DrvByteEdit]) -> Unit {
  let n = edits.length()
  let mut i = 1
  while i < n {
    let cur = edits[i]
    let mut j = i - 1
    while j >= 0 &&
      (edits[j].start < cur.start ||
      (edits[j].start == cur.start && edits[j].end < cur.end)) {
      edits[j + 1] = edits[j]
      j = j - 1
    }
    edits[j + 1] = cur
    i = i + 1
  }
}

///|
fn drv_collect_check_diags(
  world : World,
  targets : Array[String],
  locked : Bool,
  offline : Bool,
  target_override : String,
) -> Result[Array[Diagnostic], String] {
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) =>
        match drv_load_workspace_opts_target(
          world,
          root_dir,
          locked,
          offline,
          "",
          drv_pick_target(world, target_override),
        ) {
          Err(msg) => return Err(msg)
          Ok(ws) => return Ok(drv_ws_diagnostics_cached(world, ws.nodes))
        }
      None => ()
    }
  }
  match drv_load_targets(world, targets) {
    Err(msg) => Err(msg)
    Ok(loaded) => {
      let cr = check_source_files(loaded.pkg_name, loaded.paths, loaded.sources)
      Ok(cr.diagnostics)
    }
  }
}

///|
fn drv_str_arr_contains(arr : Array[String], needle : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_run_check_fix_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
  locked : Bool,
  offline : Bool,
  target_override : String,
) -> Int {
  let modified_files : Array[String] = []
  let mut total_applied = 0
  let mut round = 0
  while round < 3 {
    let diags = match drv_collect_check_diags(world, targets, locked, offline, target_override) {
      Err(msg) => return drv_cmd_fail(world, as_json, msg)
      Ok(ds) => ds
    }
    if diags.length() == 0 {
      break
    }
    let files : Array[String] = []
    let raw_edits : Array[TextEdit] = []
    let mut di = 0
    while di < diags.length() {
      let es = diags[di].edits
      let mut ei = 0
      while ei < es.length() {
        let e = es[ei]
        if e.file.length() > 0 {
          raw_edits.push(e)
          if !drv_str_arr_contains(files, e.file) {
            files.push(e.file)
          }
        }
        ei = ei + 1
      }
      di = di + 1
    }
    if raw_edits.length() == 0 {
      break
    }
    let mut round_applied = 0
    let mut fi = 0
    while fi < files.length() {
      let path = files[fi]
      let src = match fs_read(world, path) {
        Ok(t) => t
        Err(_) => {
          fi = fi + 1
          continue
        }
      }
      let starts = drv_line_starts(src)
      let bedits : Array[DrvByteEdit] = []
      let mut ri = 0
      while ri < raw_edits.length() {
        let re = raw_edits[ri]
        if re.file == path {
          let s_off = drv_line_col_to_offset(src, starts, re.line, re.col)
          let e_off = drv_line_col_to_offset(
            src,
            starts,
            re.end_line,
            re.end_col,
          )
          if s_off >= 0 && e_off >= s_off && e_off <= src.length() {
            let mut dup = false
            let mut bi = 0
            while bi < bedits.length() {
              if bedits[bi].start == s_off &&
                bedits[bi].end == e_off &&
                bedits[bi].replacement == re.replacement {
                dup = true
                break
              }
              bi = bi + 1
            }
            if !dup {
              bedits.push(DrvByteEdit::{
                start: s_off,
                end: e_off,
                replacement: re.replacement,
              })
            }
          }
        }
        ri = ri + 1
      }
      if bedits.length() > 0 {
        drv_sort_byte_edits_desc(bedits)
        let mut cur = src
        let mut last_start = src.length() + 1
        let mut file_applied = 0
        let mut bi = 0
        while bi < bedits.length() {
          let be = bedits[bi]
          if be.end <= last_start {
            cur = slice_str(cur, 0, be.start) +
              be.replacement +
              slice_str(cur, be.end, cur.length())
            last_start = be.start
            file_applied = file_applied + 1
          }
          bi = bi + 1
        }
        if file_applied > 0 && cur != src {
          if drv_write_text_atomic(world, path, cur) {
            round_applied = round_applied + file_applied
            total_applied = total_applied + file_applied
            if !drv_str_arr_contains(modified_files, path) {
              modified_files.push(path)
            }
          }
        }
      }
      fi = fi + 1
    }
    if round_applied == 0 {
      break
    }
    round = round + 1
  }
  let remaining = match drv_collect_check_diags(world, targets, locked, offline, target_override) {
    Err(msg) => return drv_cmd_fail(world, as_json, msg)
    Ok(ds) => ds
  }
  let ok = remaining.length() == 0
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if ok { "true" } else { "false" })
  sb.write_string(",\"fixed\":")
  sb.write_string(total_applied.to_string())
  sb.write_string(",\"files\":[")
  let mut fi = 0
  while fi < modified_files.length() {
    if fi > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(modified_files[fi]))
    fi = fi + 1
  }
  sb.write_string("],\"diagnostics\":[")
  let mut di = 0
  while di < remaining.length() {
    if di > 0 {
      sb.write_string(",")
    }
    sb.write_string(diagnostic_to_json(remaining[di]))
    di = di + 1
  }
  sb.write_string("]}")
  io_println(world, sb.to_string())
  if ok { 0 } else { 1 }
}

///|
struct DrvLintEval {
  has_errors : Bool
  diagnostics : Array[Diagnostic]
  /// Exact source file paths eligible for `--fix` (non-symlink regular files
  /// physically owned by a selected package or explicit standalone target).
  allowed_files : Map[String, Bool]
  /// Package directory and canonical directory recorded when each owned file
  /// was admitted, re-verified under `lint-fix.lock` before commit.
  owned_pkg_dir : Map[String, String]
  owned_pkg_canon : Map[String, String]
  all_pkg_canon_dirs : Array[String]
  /// On-disk snapshots of every existing file in the read set.
  disk_snapshots : Map[String, String]
  /// Ordered list of every existing file path in the read set.
  read_paths : Array[String]
  /// Files confirmed absent during load (e.g. missing `pion.lock` or nested
  /// `src/pion.toml` / `tests/pion.toml`), verified still absent before commit.
  absent_paths : Array[String]
  /// Snapshot of sorted `.pion` / `pion.toml` filenames in each scanned directory.
  dir_snapshots : Map[String, String]
  /// Ordered list of scanned source directories.
  scanned_dirs : Array[String]
}

///|
struct DrvLintExtraFiles {
  files : Array[SourceFile]
  incomplete : Bool
}

///|
struct DrvLintCheckedPkg {
  cr_prod : CheckedPackage
  cr_view : CheckedPackage
  has_tests : Bool
  test_paths : Map[String, Bool]
  test_files_parsed : Array[SourceFile]
  owned_files : Map[String, Bool]
  has_target_rules : Bool
  raw_map : Map[String, String]
  file_target_preds : Map[String, String]
  extra_files : Array[SourceFile]
  extra_incomplete : Bool
}

///|
fn drv_lint_path_within_dir(canon_file : String, canon_dir : String) -> Bool {
  let nf = drv_normalize_path(canon_file)
  let nd = drv_normalize_path(canon_dir)
  if nd.length() == 0 {
    return false
  }
  if str_code_at(nd, nd.length() - 1) == 47 {
    return drv_starts_with(nf, nd)
  }
  drv_starts_with(nf, nd + "/")
}

///|
fn drv_lint_record_read(
  read_paths : Array[String],
  disk_snapshots : Map[String, String],
  fpath : String,
  disk_txt : String,
) -> Unit {
  if !disk_snapshots.contains(fpath) {
    read_paths.push(fpath)
    disk_snapshots.set(fpath, disk_txt)
  }
}

///|
fn drv_lint_snapshot_entries(entries : Array[String]) -> String {
  let names : Array[String] = []
  let mut i = 0
  while i < entries.length() {
    let n = entries[i]
    if drv_is_source_file(n) || drv_is_test_source_file(n) || n == "pion.toml" {
      names.push(n)
    }
    i = i + 1
  }
  drv_sort_strings(names)
  let sb = StringBuilder()
  i = 0
  while i < names.length() {
    if i > 0 {
      sb.write_char('\n')
    }
    sb.write_string(names[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn drv_lint_snapshot_pion_dir(world : World, dir : String) -> String {
  if !fs_is_dir(world, dir) {
    return "<absent>"
  }
  drv_lint_snapshot_entries(fs_list_dir(world, dir))
}

///|
fn drv_lint_record_dir_snap_value(
  scanned_dirs : Array[String],
  dir_snapshots : Map[String, String],
  dir : String,
  snap : String,
) -> Result[Unit, String] {
  match dir_snapshots.get(dir) {
    Some(prev) =>
      if prev != snap {
        return Err("directory contents changed during `pionc lint`: " + dir)
      }
    None => {
      scanned_dirs.push(dir)
      dir_snapshots.set(dir, snap)
    }
  }
  Ok(())
}

///|
fn drv_lint_record_absent(absent_paths : Array[String], path : String) -> Unit {
  if !drv_str_arr_contains(absent_paths, path) {
    absent_paths.push(path)
  }
}

///|
fn drv_lint_strip_verify_suffix(src : String, verify_enabled : Bool) -> String {
  let suf = "\n#![verify]\n"
  if verify_enabled && drv_ends_with(src, suf) {
    slice_str(src, 0, src.length() - suf.length())
  } else {
    src
  }
}

///|
/// Computes the normalized `[targets]` predicate key for `rel` inside a package:
/// `"*"` when unlisted/unconditional, or sorted comma-joined target atoms.
fn drv_lint_target_pred(
  target_rules : Map[String, Array[String]],
  rel : String,
) -> String {
  match target_rules.get(rel) {
    None => "*"
    Some(ts) => {
      if ts.length() == 0 {
        return "*"
      }
      let copy : Array[String] = []
      let mut i = 0
      while i < ts.length() {
        if !drv_str_arr_contains(copy, ts[i]) {
          copy.push(ts[i])
        }
        i = i + 1
      }
      drv_sort_strings(copy)
      let sb = StringBuilder()
      i = 0
      while i < copy.length() {
        if i > 0 {
          sb.write_char(',')
        }
        sb.write_string(copy[i])
        i = i + 1
      }
      sb.to_string()
    }
  }
}

///|
fn drv_lint_rel_to_pkg(fpath : String, pkg_dir : String) -> String {
  let nf = drv_normalize_path(fpath)
  let nd = drv_normalize_path(pkg_dir)
  if nd.length() > 0 && str_code_at(nd, nd.length() - 1) == 47 {
    if drv_starts_with(nf, nd) {
      return slice_str(nf, nd.length(), nf.length())
    }
  } else if drv_starts_with(nf, nd + "/") {
    return slice_str(nf, nd.length() + 1, nf.length())
  }
  nf
}

///|
/// True iff `fpath` physically belongs to `pkg_dir` and NOT to any nested child
/// package (e.g. `src/pion.toml`, `tests/pion.toml`, or any deeper loaded package).
fn drv_lint_file_owned_by_pkg(
  world : World,
  fpath : String,
  pkg_dir : String,
  node_canon_dir : String,
  all_pkg_canon_dirs : Array[String],
) -> Bool {
  let rel = drv_lint_rel_to_pkg(fpath, pkg_dir)
  if drv_starts_with(rel, "src/") &&
    fs_exists(world, drv_join_path(drv_join_path(pkg_dir, "src"), "pion.toml")) {
    return false
  }
  if drv_starts_with(rel, "tests/") &&
    fs_exists(world, drv_join_path(drv_join_path(pkg_dir, "tests"), "pion.toml")) {
    return false
  }
  match drv_canon_out_path(world, fpath) {
    Ok(cf) => {
      if !drv_lint_path_within_dir(cf, node_canon_dir) {
        return false
      }
      let mut i = 0
      while i < all_pkg_canon_dirs.length() {
        let other = all_pkg_canon_dirs[i]
        if other != node_canon_dir &&
          drv_lint_path_within_dir(other, node_canon_dir) &&
          drv_lint_path_within_dir(cf, other) {
          return false
        }
        i = i + 1
      }
      true
    }
    Err(_) => false
  }
}

///|
fn drv_lint_strip_disallowed_edits(
  diags : Array[Diagnostic],
  allowed_files : Map[String, Bool],
) -> Array[Diagnostic] {
  let out : Array[Diagnostic] = []
  let mut i = 0
  while i < diags.length() {
    let d = diags[i]
    if d.edits.length() == 0 {
      out.push(d)
    } else {
      let kept : Array[TextEdit] = []
      let mut ei = 0
      while ei < d.edits.length() {
        if allowed_files.contains(d.edits[ei].file) {
          kept.push(d.edits[ei])
        }
        ei = ei + 1
      }
      out.push(Diagnostic::{
        file: d.file,
        line: d.line,
        col: d.col,
        code: d.code,
        message: d.message,
        expected: d.expected,
        found: d.found,
        fixit: d.fixit,
        edits: kept,
      })
    }
    i = i + 1
  }
  out
}

///|
fn drv_lint_select_pkg_dirs(world : World, root_dir : String) -> Map[String, Bool] {
  let no_deps_dirs : Map[String, Bool] = Map([])
  let root_abs = drv_canon_dir(world, root_dir)
  let root_mf_path = drv_join_path(root_abs, "pion.toml")
  let mut is_virtual_ws = false
  if fs_exists(world, root_mf_path) {
    match fs_read(world, root_mf_path) {
      Ok(mf_txt) =>
        match parse_pion_toml(mf_txt) {
          Ok(mf) =>
            if mf.is_workspace {
              is_virtual_ws = true
              match drv_expand_workspace_members(world, root_abs, mf) {
                Ok(ms) => {
                  let mut mi = 0
                  while mi < ms.length() {
                    no_deps_dirs.set(drv_canon_dir(world, ms[mi]), true)
                    mi = mi + 1
                  }
                }
                Err(_) => ()
              }
            }
          Err(_) => ()
        }
      Err(_) => ()
    }
  }
  if !is_virtual_ws {
    no_deps_dirs.set(root_abs, true)
  }
  no_deps_dirs
}

///|
fn drv_lint_collect_extra_import_files(
  world : World,
  pkg_dir : String,
  node_canon_dir : String,
  all_pkg_canon_dirs : Array[String],
  active_paths : Map[String, Bool],
  overrides : Map[String, String],
  raw_map : Map[String, String],
  read_paths : Array[String],
  disk_snapshots : Map[String, String],
  scanned_dirs : Array[String],
  dir_snapshots : Map[String, String],
) -> Result[DrvLintExtraFiles, String] {
  let out : Array[SourceFile] = []
  let mut incomplete = false
  let check_dirs : Array[String] = [
    pkg_dir,
    drv_join_path(pkg_dir, "src"),
    drv_join_path(pkg_dir, "tests"),
  ]
  let mut di = 0
  while di < check_dirs.length() {
    let cur_dir = check_dirs[di]
    if di > 0 && !fs_is_dir(world, cur_dir) {
      match drv_lint_record_dir_snap_value(scanned_dirs, dir_snapshots, cur_dir, "<absent>") {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      di = di + 1
      continue
    }
    let entries = fs_list_dir(world, cur_dir)
    match drv_lint_record_dir_snap_value(
      scanned_dirs,
      dir_snapshots,
      cur_dir,
      drv_lint_snapshot_entries(entries),
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    if di > 0 && drv_str_arr_contains(entries, "pion.toml") {
      di = di + 1
      continue
    }
    let mut i = 0
    while i < entries.length() {
      let name = entries[i]
      if drv_is_source_file(name) || drv_is_test_source_file(name) {
        let fpath = drv_join_path(cur_dir, name)
        if !active_paths.contains(fpath) &&
          drv_lint_file_owned_by_pkg(world, fpath, pkg_dir, node_canon_dir, all_pkg_canon_dirs) {
          match fs_read(world, fpath) {
            Ok(disk_txt) => {
              drv_lint_record_read(read_paths, disk_snapshots, fpath, disk_txt)
              let mem_txt = match overrides.get(fpath) {
                Some(ov) => ov
                None => disk_txt
              }
              raw_map.set(fpath, mem_txt)
              let pr = parse_source(fpath, mem_txt)
              if pr.diagnostics.length() > 0 {
                incomplete = true
              }
              out.push(pr.file)
            }
            Err(_) => incomplete = true
          }
        }
      }
      i = i + 1
    }
    di = di + 1
  }
  Ok(DrvLintExtraFiles::{ files: out, incomplete: incomplete })
}

///|
fn drv_lint_eval(
  world : World,
  targets : Array[String],
  locked : Bool,
  offline : Bool,
  target_override : String,
  overrides : Map[String, String],
) -> Result[DrvLintEval, String] {
  let allowed_files : Map[String, Bool] = Map([])
  let owned_pkg_dir : Map[String, String] = Map([])
  let owned_pkg_canon : Map[String, String] = Map([])
  let mut all_pkg_canon_dirs_out : Array[String] = []
  let disk_snapshots : Map[String, String] = Map([])
  let read_paths : Array[String] = []
  let absent_paths : Array[String] = []
  let dir_snapshots : Map[String, String] = Map([])
  let scanned_dirs : Array[String] = []
  if targets.length() > 1 {
    let mut ti = 0
    while ti < targets.length() {
      match drv_detect_manifest_dir(world, targets[ti]) {
        Some(_) =>
          return Err(
            "cannot mix manifest package root `" +
            targets[ti] +
            "` with multiple targets in `pionc lint`",
          )
        None => ()
      }
      ti = ti + 1
    }
  }
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        let active_target = drv_pick_target(world, target_override)
        let ws = match drv_load_workspace_opts_target_ro(
          world,
          root_dir,
          locked,
          offline,
          "",
          active_target,
        ) {
          Err(msg) => return Err(msg)
          Ok(v) => v
        }
        // Record exact loaded manifest texts and lockfile state (no post-load re-read gap).
        let mut mpi = 0
        while mpi < ws.manifest_paths.length() {
          let mp = ws.manifest_paths[mpi]
          match ws.manifest_texts.get(mp) {
            Some(mt) => drv_lint_record_read(read_paths, disk_snapshots, mp, mt)
            None =>
              match fs_read(world, mp) {
                Ok(mt) => drv_lint_record_read(read_paths, disk_snapshots, mp, mt)
                Err(msg) => return Err("failed to read manifest " + mp + ": " + msg)
              }
          }
          mpi = mpi + 1
        }
        let lock_p = if ws.lock_path.length() > 0 {
          ws.lock_path
        } else {
          drv_join_path(root_dir, "pion.lock")
        }
        if !ws.lock_existed {
          drv_lint_record_absent(absent_paths, lock_p)
        } else {
          drv_lint_record_read(read_paths, disk_snapshots, lock_p, ws.lock_text)
        }
        // Merge directory snapshots captured during workspace load (zero post-load re-list gap).
        let mut sdi = 0
        while sdi < ws.scanned_dirs.length() {
          let sd = ws.scanned_dirs[sdi]
          match ws.dir_snapshots.get(sd) {
            Some(snap) =>
              match drv_lint_record_dir_snap_value(scanned_dirs, dir_snapshots, sd, snap) {
                Err(e) => return Err(e)
                Ok(_) => ()
              }
            None => ()
          }
          sdi = sdi + 1
        }

        let nodes = ws.nodes
        let all_pkg_canon_dirs : Array[String] = []
        let names : Array[String] = []
        let dep_lists : Array[Array[String]] = []
        let mut ni = 0
        while ni < nodes.length() {
          all_pkg_canon_dirs.push(drv_canon_dir(world, nodes[ni].dir))
          names.push(nodes[ni].name)
          dep_lists.push(nodes[ni].deps)
          ni = ni + 1
        }
        all_pkg_canon_dirs_out = all_pkg_canon_dirs
        let topo = topo_sort_packages(names, dep_lists)
        if topo.diagnostics.length() > 0 {
          return Ok(DrvLintEval::{
            has_errors: true,
            diagnostics: drv_lint_strip_disallowed_edits(
              lint_sort_and_dedup_diags(topo.diagnostics),
              allowed_files,
            ),
            allowed_files: allowed_files,
            owned_pkg_dir: owned_pkg_dir,
            owned_pkg_canon: owned_pkg_canon,
            all_pkg_canon_dirs: all_pkg_canon_dirs_out,
            disk_snapshots: disk_snapshots,
            read_paths: read_paths,
            absent_paths: absent_paths,
            dir_snapshots: dir_snapshots,
            scanned_dirs: scanned_dirs,
          })
        }
        let selected_dirs = drv_lint_select_pkg_dirs(world, root_dir)
        let n = topo.order.length()
        let trans = drv_trans_deps(nodes, topo.order)
        let trans_dep_topo = trans.topo
        let trans_dep_names = trans.names
        let cache_dir = drv_resolve_cache_dir(world)
        let _ = fs_mkdir_p(world, cache_dir + "/sig")
        let check_fp = drv_compute_self_fp(world, "check-v1")

        let stub_paths : Array[String] = []
        let loaded_imported : Array[Option[ImportedPkg]] = []
        let pkg_has_err : Array[Bool] = []
        let mut k = 0
        while k < n {
          stub_paths.push("")
          loaded_imported.push(None)
          pkg_has_err.push(false)
          k = k + 1
        }
        let sig_hashes : Map[String, String] = Map([])
        let err_diags : Array[Diagnostic] = []
        let checked_pkgs : Array[DrvLintCheckedPkg] = []
        let mut total_selected_files = 0

        // Phase 1: full dependency-graph type checking (production + selected tests).
        k = 0
        while k < n {
          let node = nodes[topo.order[k]]
          let node_canon_dir = drv_canon_dir(world, node.dir)
          let is_selected = selected_dirs.contains(node_canon_dir)
          let deps_k = trans_dep_topo[k]
          let mut any_dep_err = false
          let mut di = 0
          while di < deps_k.length() {
            if pkg_has_err[deps_k[di]] {
              any_dep_err = true
              break
            }
            di = di + 1
          }
          if !is_selected {
            // Snapshot exact loaded dependency sources (no post-load re-read gap).
            let mut dpi = 0
            while dpi < node.paths.length() && dpi < node.sources.length() {
              let dfp = node.paths[dpi]
              let dt = drv_lint_strip_verify_suffix(node.sources[dpi], node.verify_enabled)
              drv_lint_record_read(read_paths, disk_snapshots, dfp, dt)
              dpi = dpi + 1
            }
            let upstream_sigs : Array[String] = []
            let t_names = trans_dep_names[k]
            let mut u = 0
            while u < t_names.length() {
              let un = t_names[u]
              let sh = match sig_hashes.get(un) {
                Some(h) => h
                None => ""
              }
              upstream_sigs.push(un + ":" + sh)
              u = u + 1
            }
            drv_append_dep_alias_sigs(upstream_sigs, node)
            let key = cas_compute_key(
              node.name,
              drv_cas_rel_paths(node),
              node.sources,
              upstream_sigs,
              "check",
              false,
              check_fp,
            )
            let sig_path = cache_dir + "/sig/" + key + ".pionsig"
            let stub_path = cache_dir + "/sig/" + key + ".pionstub"
            let mut cas_hit = false
            if !any_dep_err && drv_is_regular_file(sig_path) && drv_is_regular_file(stub_path) {
              match fs_read(world, sig_path) {
                Ok(sig_text) => {
                  sig_hashes.set(node.name, drv_effective_sig_hash(sig_text, node, sig_hashes))
                  stub_paths[k] = stub_path
                  cas_hit = true
                }
                Err(_) => ()
              }
            }
            if !cas_hit {
              let k_imports = drv_ensure_ws_imports(
                world,
                nodes,
                topo.order,
                trans_dep_topo,
                stub_paths,
                loaded_imported,
                k,
              )
              let cr = check_source_files_with_imports_mapped(
                node.name,
                node.paths,
                node.sources,
                k_imports,
                node.dep_aliases,
                node.deps,
                true,
                false,
              )
              loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
              if cr.diagnostics.length() > 0 {
                let mut ei = 0
                while ei < cr.diagnostics.length() {
                  err_diags.push(cr.diagnostics[ei])
                  ei = ei + 1
                }
                pkg_has_err[k] = true
              } else {
                let pionsig = emit_pionsig(cr.pkg)
                sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
                if !any_dep_err {
                  let pionstub = emit_pion_stub(cr.pkg)
                  let _ = drv_write_cas_text_atomic(world, sig_path, pionsig)
                  let _ = drv_write_cas_text_atomic(world, stub_path, pionstub)
                }
              }
            }
          } else {
            let k_imports = drv_ensure_ws_imports(
              world,
              nodes,
              topo.order,
              trans_dep_topo,
              stub_paths,
              loaded_imported,
              k,
            )
            let mut pkg_has_target_rules = node.target_rules.length() > 0
            if !pkg_has_target_rules {
              let mut tdi = 0
              while tdi < deps_k.length() {
                if nodes[topo.order[deps_k[tdi]]].target_rules.length() > 0 {
                  pkg_has_target_rules = true
                  break
                }
                tdi = tdi + 1
              }
            }
            // Register ownership and writable allowlist BEFORE type-checking, while
            // passing the full unfiltered `node.paths` to match `pionc check` 100%.
            let owned_files : Map[String, Bool] = Map([])
            let all_prod_paths : Array[String] = []
            let prod_raw_sources : Array[String] = []
            let prod_mem_sources : Array[String] = []
            let mut pi = 0
            while pi < node.paths.length() && pi < node.sources.length() {
              let fpath = node.paths[pi]
              let disk_txt = drv_lint_strip_verify_suffix(node.sources[pi], node.verify_enabled)
              drv_lint_record_read(read_paths, disk_snapshots, fpath, disk_txt)
              if drv_lint_file_owned_by_pkg(
                world,
                fpath,
                node.dir,
                node_canon_dir,
                all_pkg_canon_dirs,
              ) {
                owned_files.set(fpath, true)
                let rel_own = drv_lint_rel_to_pkg(fpath, node.dir)
                if drv_starts_with(rel_own, "src/") {
                  drv_lint_record_absent(
                    absent_paths,
                    drv_join_path(drv_join_path(node.dir, "src"), "pion.toml"),
                  )
                } else if drv_starts_with(rel_own, "tests/") {
                  drv_lint_record_absent(
                    absent_paths,
                    drv_join_path(drv_join_path(node.dir, "tests"), "pion.toml"),
                  )
                }
                if drv_lstat_kind(fpath) == 1 {
                  allowed_files.set(fpath, true)
                  owned_pkg_dir.set(fpath, node.dir)
                  owned_pkg_canon.set(fpath, node_canon_dir)
                }
              }
              let mem_txt = match overrides.get(fpath) {
                Some(ov) => ov
                None => disk_txt
              }
              all_prod_paths.push(fpath)
              prod_raw_sources.push(mem_txt)
              prod_mem_sources.push(mem_txt)
              pi = pi + 1
            }
            let prod_check_sources = manifest_apply_verify(prod_mem_sources, node.verify_enabled)
            let cr_prod = check_source_files_with_imports_mapped(
              node.name,
              all_prod_paths,
              prod_check_sources,
              k_imports,
              node.dep_aliases,
              node.deps,
              true,
              true,
            )
            loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr_prod.tc })
            if cr_prod.diagnostics.length() > 0 {
              let mut ei = 0
              while ei < cr_prod.diagnostics.length() {
                err_diags.push(cr_prod.diagnostics[ei])
                ei = ei + 1
              }
              pkg_has_err[k] = true
            } else {
              let pionsig = emit_pionsig(cr_prod.pkg)
              sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
              let raw_test_paths : Array[String] = []
              let raw_test_disk_sources : Array[String] = []
              match drv_append_test_sources_for_snap(
                world,
                node.dir,
                node.target_rules,
                active_target,
                raw_test_paths,
                raw_test_disk_sources,
                scanned_dirs,
                dir_snapshots,
              ) {
                Err(msg) => return Err(msg)
                Ok(_) => ()
              }
              let all_paths : Array[String] = []
              let all_check_sources : Array[String] = []
              let raw_map : Map[String, String] = Map([])
              let file_target_preds : Map[String, String] = Map([])
              let active_path_set : Map[String, Bool] = Map([])
              let test_path_set : Map[String, Bool] = Map([])
              pi = 0
              while pi < all_prod_paths.length() {
                let fp = all_prod_paths[pi]
                all_paths.push(fp)
                all_check_sources.push(prod_check_sources[pi])
                raw_map.set(fp, prod_raw_sources[pi])
                let rel = drv_lint_rel_to_pkg(fp, node.dir)
                file_target_preds.set(fp, drv_lint_target_pred(node.target_rules, rel))
                active_path_set.set(fp, true)
                total_selected_files = total_selected_files + 1
                pi = pi + 1
              }
              let mut ti = 0
              while ti < raw_test_paths.length() {
                let fp = raw_test_paths[ti]
                let disk_txt = raw_test_disk_sources[ti]
                drv_lint_record_read(read_paths, disk_snapshots, fp, disk_txt)
                if drv_lint_file_owned_by_pkg(
                  world,
                  fp,
                  node.dir,
                  node_canon_dir,
                  all_pkg_canon_dirs,
                ) {
                  owned_files.set(fp, true)
                  let rel_own = drv_lint_rel_to_pkg(fp, node.dir)
                  if drv_starts_with(rel_own, "src/") {
                    drv_lint_record_absent(
                      absent_paths,
                      drv_join_path(drv_join_path(node.dir, "src"), "pion.toml"),
                    )
                  } else if drv_starts_with(rel_own, "tests/") {
                    drv_lint_record_absent(
                      absent_paths,
                      drv_join_path(drv_join_path(node.dir, "tests"), "pion.toml"),
                    )
                  }
                  if drv_lstat_kind(fp) == 1 {
                    allowed_files.set(fp, true)
                    owned_pkg_dir.set(fp, node.dir)
                    owned_pkg_canon.set(fp, node_canon_dir)
                  }
                }
                let mem_txt = match overrides.get(fp) {
                  Some(ov) => ov
                  None => disk_txt
                }
                all_paths.push(fp)
                all_check_sources.push(mem_txt)
                raw_map.set(fp, mem_txt)
                let rel = drv_lint_rel_to_pkg(fp, node.dir)
                file_target_preds.set(fp, drv_lint_target_pred(node.target_rules, rel))
                active_path_set.set(fp, true)
                test_path_set.set(fp, true)
                total_selected_files = total_selected_files + 1
                ti = ti + 1
              }
              let has_tests = raw_test_paths.length() > 0
              let cr_view = if has_tests {
                check_source_files_with_imports_mapped(
                  node.name,
                  all_paths,
                  all_check_sources,
                  k_imports,
                  node.dep_aliases,
                  node.deps,
                  true,
                  true,
                )
              } else {
                cr_prod
              }
              if cr_view.diagnostics.length() > 0 {
                let mut ei = 0
                while ei < cr_view.diagnostics.length() {
                  err_diags.push(cr_view.diagnostics[ei])
                  ei = ei + 1
                }
                pkg_has_err[k] = true
              } else {
                let extra = match drv_lint_collect_extra_import_files(
                  world,
                  node.dir,
                  node_canon_dir,
                  all_pkg_canon_dirs,
                  active_path_set,
                  overrides,
                  raw_map,
                  read_paths,
                  disk_snapshots,
                  scanned_dirs,
                  dir_snapshots,
                ) {
                  Err(msg) => return Err(msg)
                  Ok(v) => v
                }
                let mut efi = 0
                while efi < extra.files.length() {
                  owned_files.set(extra.files[efi].path, true)
                  efi = efi + 1
                }
                total_selected_files = total_selected_files + extra.files.length()
                let test_files_parsed : Array[SourceFile] = []
                if has_tests {
                  let mut vfi = 0
                  while vfi < cr_view.pkg.files.length() {
                    if test_path_set.contains(cr_view.pkg.files[vfi].path) {
                      test_files_parsed.push(cr_view.pkg.files[vfi])
                    }
                    vfi = vfi + 1
                  }
                }
                checked_pkgs.push(DrvLintCheckedPkg::{
                  cr_prod: cr_prod,
                  cr_view: cr_view,
                  has_tests: has_tests,
                  test_paths: test_path_set,
                  test_files_parsed: test_files_parsed,
                  owned_files: owned_files,
                  has_target_rules: pkg_has_target_rules,
                  raw_map: raw_map,
                  file_target_preds: file_target_preds,
                  extra_files: extra.files,
                  extra_incomplete: extra.incomplete,
                })
              }
            }
          }
          k = k + 1
        }
        // Fail fast before running lint on any package if any `E_*` exists.
        if err_diags.length() > 0 {
          return Ok(DrvLintEval::{
            has_errors: true,
            diagnostics: drv_lint_strip_disallowed_edits(
              lint_sort_and_dedup_diags(err_diags),
              allowed_files,
            ),
            allowed_files: allowed_files,
            owned_pkg_dir: owned_pkg_dir,
            owned_pkg_canon: owned_pkg_canon,
            all_pkg_canon_dirs: all_pkg_canon_dirs_out,
            disk_snapshots: disk_snapshots,
            read_paths: read_paths,
            absent_paths: absent_paths,
            dir_snapshots: dir_snapshots,
            scanned_dirs: scanned_dirs,
          })
        }
        if total_selected_files == 0 {
          return Err("no .pion source files found")
        }
        // Phase 2: lint production files under `cr_prod` and test files under `cr_view`,
        // keeping active test files distinct from inactive `[targets]` files, and
        // emitting `L_*` only for files physically owned by the selected package.
        let lint_diags : Array[Diagnostic] = []
        let mut ci = 0
        while ci < checked_pkgs.length() {
          let cp = checked_pkgs[ci]
          if !cp.has_tests {
            let pds = lint_package_full(
              cp.cr_prod.pkg,
              cp.cr_prod.tc,
              cp.raw_map,
              [],
              cp.extra_files,
              cp.file_target_preds,
              cp.has_target_rules,
              cp.extra_incomplete,
            )
            let mut li = 0
            while li < pds.length() {
              if cp.owned_files.contains(pds[li].file) {
                lint_diags.push(pds[li])
              }
              li = li + 1
            }
          } else {
            let prod_ds = lint_package_full(
              cp.cr_prod.pkg,
              cp.cr_prod.tc,
              cp.raw_map,
              cp.test_files_parsed,
              cp.extra_files,
              cp.file_target_preds,
              cp.has_target_rules,
              cp.extra_incomplete,
            )
            let mut li = 0
            while li < prod_ds.length() {
              if cp.owned_files.contains(prod_ds[li].file) &&
                !cp.test_paths.contains(prod_ds[li].file) {
                lint_diags.push(prod_ds[li])
              }
              li = li + 1
            }
            let view_ds = lint_package_full(
              cp.cr_view.pkg,
              cp.cr_view.tc,
              cp.raw_map,
              [],
              cp.extra_files,
              cp.file_target_preds,
              cp.has_target_rules,
              cp.extra_incomplete,
            )
            li = 0
            while li < view_ds.length() {
              if cp.owned_files.contains(view_ds[li].file) &&
                cp.test_paths.contains(view_ds[li].file) {
                lint_diags.push(view_ds[li])
              }
              li = li + 1
            }
          }
          ci = ci + 1
        }
        return Ok(DrvLintEval::{
          has_errors: false,
          diagnostics: drv_lint_strip_disallowed_edits(
            lint_sort_and_dedup_diags(lint_diags),
            allowed_files,
          ),
          allowed_files: allowed_files,
          owned_pkg_dir: owned_pkg_dir,
          owned_pkg_canon: owned_pkg_canon,
          all_pkg_canon_dirs: all_pkg_canon_dirs_out,
          disk_snapshots: disk_snapshots,
          read_paths: read_paths,
          absent_paths: absent_paths,
          dir_snapshots: dir_snapshots,
          scanned_dirs: scanned_dirs,
        })
      }
      None => ()
    }
  }
  // Standalone file(s) or directory without pion.toml.
  let loaded = match drv_load_targets_with_snaps(
    world,
    targets,
    scanned_dirs,
    dir_snapshots,
  ) {
    Err(msg) => return Err(msg)
    Ok(v) => v
  }
  if loaded.paths.length() == 0 {
    return Err("no .pion source files found")
  }
  let mem_sources : Array[String] = []
  let raw_map : Map[String, String] = Map([])
  let mut i = 0
  while i < loaded.paths.length() && i < loaded.sources.length() {
    let fp = loaded.paths[i]
    let disk_txt = loaded.sources[i]
    drv_lint_record_read(read_paths, disk_snapshots, fp, disk_txt)
    let mem_txt = match overrides.get(fp) {
      Some(ov) => ov
      None => disk_txt
    }
    mem_sources.push(mem_txt)
    raw_map.set(fp, mem_txt)
    if drv_lstat_kind(fp) == 1 {
      allowed_files.set(fp, true)
    }
    i = i + 1
  }
  let cr = check_source_files_with_imports_mapped(
    loaded.pkg_name,
    loaded.paths,
    mem_sources,
    [],
    [],
    [],
    false,
    true,
  )
  if cr.diagnostics.length() > 0 {
    return Ok(DrvLintEval::{
      has_errors: true,
      diagnostics: drv_lint_strip_disallowed_edits(
        lint_sort_and_dedup_diags(cr.diagnostics),
        allowed_files,
      ),
      allowed_files: allowed_files,
      owned_pkg_dir: owned_pkg_dir,
      owned_pkg_canon: owned_pkg_canon,
      all_pkg_canon_dirs: all_pkg_canon_dirs_out,
      disk_snapshots: disk_snapshots,
      read_paths: read_paths,
      absent_paths: absent_paths,
      dir_snapshots: dir_snapshots,
      scanned_dirs: scanned_dirs,
    })
  }
  let lds = drv_lint_strip_disallowed_edits(
    lint_package_full(cr.pkg, cr.tc, raw_map, [], [], Map([]), false, false),
    allowed_files,
  )
  Ok(DrvLintEval::{
    has_errors: false,
    diagnostics: lds,
    allowed_files: allowed_files,
    owned_pkg_dir: owned_pkg_dir,
    owned_pkg_canon: owned_pkg_canon,
    all_pkg_canon_dirs: all_pkg_canon_dirs_out,
    disk_snapshots: disk_snapshots,
    read_paths: read_paths,
    absent_paths: absent_paths,
    dir_snapshots: dir_snapshots,
    scanned_dirs: scanned_dirs,
  })
}

///|
fn drv_lint_fix_fail(world : World, as_json : Bool, msg : String) -> Int {
  if as_json {
    io_println(
      world,
      "{\"ok\":false,\"error\":" +
      json_quote(msg) +
      ",\"fixed\":0,\"files\":[],\"diagnostics\":[]}",
    )
  } else {
    io_eprintln(world, "error: " + msg)
  }
  1
}

///|
/// Acquires the single global CAS commit lock (`$PION_CACHE_DIR/lint-fix.lock`)
/// so concurrent `pionc lint --fix` invocations serialize regardless of how
/// targets were specified. Fails closed (`Err`) if the cache dir or lock cannot
/// be created/opened.
fn drv_lint_fix_lock(world : World) -> Result[Int64, String] {
  let cache_dir = drv_resolve_cache_dir(world)
  if !fs_mkdir_p(world, cache_dir) {
    return Err("cannot create cache directory `" + cache_dir + "` for lint fix lock")
  }
  if drv_lstat_kind(cache_dir) != 2 {
    return Err("cache directory `" + cache_dir + "` is not a directory")
  }
  let lock_path = cache_dir + "/lint-fix.lock"
  let h = c_fs_lock(drv_cpath(lock_path))
  if h < 0L {
    return Err("failed to acquire exclusive lint fix lock at `" + lock_path + "`")
  }
  Ok(h)
}

///|
fn drv_lint_fix_unlock(handle : Int64) -> Unit {
  if handle >= 0L {
    c_fs_unlock(handle)
  }
}

///|
fn drv_lint_print_fix_result(
  world : World,
  ok : Bool,
  total_applied : Int,
  modified_files : Array[String],
  diags : Array[Diagnostic],
) -> Int {
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if ok { "true" } else { "false" })
  sb.write_string(",\"fixed\":")
  sb.write_string(total_applied.to_string())
  sb.write_string(",\"files\":[")
  let mut fi = 0
  while fi < modified_files.length() {
    if fi > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(modified_files[fi]))
    fi = fi + 1
  }
  sb.write_string("],\"diagnostics\":[")
  let mut di = 0
  while di < diags.length() {
    if di > 0 {
      sb.write_string(",")
    }
    sb.write_string(diagnostic_to_json(diags[di]))
    di = di + 1
  }
  sb.write_string("]}")
  io_println(world, sb.to_string())
  if ok { 0 } else { 1 }
}

///|
fn drv_lint_merge_read_set(
  ev : DrvLintEval,
  initial_read_paths : Array[String],
  initial_snapshots : Map[String, String],
  initial_lstat : Map[String, Int],
  initial_absent : Array[String],
  initial_dirs : Array[String],
  initial_dir_snaps : Map[String, String],
  initial_owned_pkg_dir : Map[String, String],
  initial_owned_pkg_canon : Map[String, String],
  initial_all_pkg_canon_dirs : Array[String],
) -> Result[Unit, String] {
  let mut i = 0
  while i < ev.read_paths.length() {
    let rp = ev.read_paths[i]
    match ev.disk_snapshots.get(rp) {
      Some(t) =>
        match initial_snapshots.get(rp) {
          Some(prev) =>
            if prev != t {
              return Err("file changed on disk during `pionc lint --fix`: " + rp)
            }
          None => {
            initial_read_paths.push(rp)
            initial_snapshots.set(rp, t)
            initial_lstat.set(rp, drv_lstat_kind(rp))
          }
        }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < ev.absent_paths.length() {
    let ap = ev.absent_paths[i]
    if !drv_str_arr_contains(initial_absent, ap) {
      initial_absent.push(ap)
    }
    i = i + 1
  }
  i = 0
  while i < ev.scanned_dirs.length() {
    let sd = ev.scanned_dirs[i]
    match ev.dir_snapshots.get(sd) {
      Some(ds) =>
        match initial_dir_snaps.get(sd) {
          Some(prev) =>
            if prev != ds {
              return Err("directory contents changed during `pionc lint --fix`: " + sd)
            }
          None => {
            initial_dirs.push(sd)
            initial_dir_snaps.set(sd, ds)
          }
        }
      None => ()
    }
    i = i + 1
  }
  let op_keys = ev.owned_pkg_dir.keys()
  i = 0
  while i < op_keys.length() {
    let fp = op_keys[i]
    if !initial_owned_pkg_dir.contains(fp) {
      match ev.owned_pkg_dir.get(fp) {
        Some(pd) => initial_owned_pkg_dir.set(fp, pd)
        None => ()
      }
      match ev.owned_pkg_canon.get(fp) {
        Some(pc) => initial_owned_pkg_canon.set(fp, pc)
        None => ()
      }
    }
    i = i + 1
  }
  i = 0
  while i < ev.all_pkg_canon_dirs.length() {
    let cd = ev.all_pkg_canon_dirs[i]
    if !drv_str_arr_contains(initial_all_pkg_canon_dirs, cd) {
      initial_all_pkg_canon_dirs.push(cd)
    }
    i = i + 1
  }
  Ok(())
}

///|
fn drv_run_lint_fix_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
  locked : Bool,
  offline : Bool,
  target_override : String,
) -> Int {
  let acc_overrides : Map[String, String] = Map([])
  let modified_files : Array[String] = []
  let initial_snapshots : Map[String, String] = Map([])
  let initial_read_paths : Array[String] = []
  let initial_lstat : Map[String, Int] = Map([])
  let initial_absent : Array[String] = []
  let initial_dirs : Array[String] = []
  let initial_dir_snaps : Map[String, String] = Map([])
  let initial_owned_pkg_dir : Map[String, String] = Map([])
  let initial_owned_pkg_canon : Map[String, String] = Map([])
  let initial_all_pkg_canon_dirs : Array[String] = []
  let mut total_applied = 0
  let mut round = 0
  while round < 3 {
    let ev = match drv_lint_eval(
      world,
      targets,
      locked,
      offline,
      target_override,
      acc_overrides,
    ) {
      Err(msg) => return drv_lint_fix_fail(world, as_json, msg)
      Ok(v) => v
    }
    match drv_lint_merge_read_set(
      ev,
      initial_read_paths,
      initial_snapshots,
      initial_lstat,
      initial_absent,
      initial_dirs,
      initial_dir_snaps,
      initial_owned_pkg_dir,
      initial_owned_pkg_canon,
      initial_all_pkg_canon_dirs,
    ) {
      Err(msg) => return drv_lint_fix_fail(world, as_json, msg)
      Ok(_) => ()
    }
    if ev.has_errors {
      return drv_lint_print_fix_result(world, false, 0, [], ev.diagnostics)
    }
    if ev.diagnostics.length() == 0 {
      break
    }
    let files : Array[String] = []
    let raw_edits : Array[TextEdit] = []
    let mut di = 0
    while di < ev.diagnostics.length() {
      let d = ev.diagnostics[di]
      if drv_starts_with(d.code, "L_") {
        let mut ei = 0
        while ei < d.edits.length() {
          let e = d.edits[ei]
          if e.file.length() > 0 &&
            e.applicability == "machine" &&
            ev.allowed_files.contains(e.file) {
            raw_edits.push(e)
            if !drv_str_arr_contains(files, e.file) {
              files.push(e.file)
            }
          }
          ei = ei + 1
        }
      }
      di = di + 1
    }
    if raw_edits.length() == 0 {
      break
    }
    let mut round_applied = 0
    let mut fi = 0
    while fi < files.length() {
      let path = files[fi]
      let src = match acc_overrides.get(path) {
        Some(t) => t
        None =>
          match initial_snapshots.get(path) {
            Some(t) => t
            None => {
              fi = fi + 1
              continue
            }
          }
      }
      let starts = drv_line_starts(src)
      let bedits : Array[DrvByteEdit] = []
      let mut ri = 0
      while ri < raw_edits.length() {
        let re = raw_edits[ri]
        if re.file == path {
          let s_off = drv_line_col_to_offset(src, starts, re.line, re.col)
          let e_off = drv_line_col_to_offset(
            src,
            starts,
            re.end_line,
            re.end_col,
          )
          if s_off >= 0 && e_off >= s_off && e_off <= src.length() {
            let mut dup = false
            let mut bi = 0
            while bi < bedits.length() {
              if bedits[bi].start == s_off &&
                bedits[bi].end == e_off &&
                bedits[bi].replacement == re.replacement {
                dup = true
                break
              }
              bi = bi + 1
            }
            if !dup {
              bedits.push(DrvByteEdit::{
                start: s_off,
                end: e_off,
                replacement: re.replacement,
              })
            }
          }
        }
        ri = ri + 1
      }
      if bedits.length() > 0 {
        drv_sort_byte_edits_desc(bedits)
        let mut cur = src
        let mut last_start = src.length() + 1
        let mut file_applied = 0
        let mut bi = 0
        while bi < bedits.length() {
          let be = bedits[bi]
          if be.end <= last_start {
            cur = slice_str(cur, 0, be.start) +
              be.replacement +
              slice_str(cur, be.end, cur.length())
            last_start = be.start
            file_applied = file_applied + 1
          }
          bi = bi + 1
        }
        if file_applied > 0 && cur != src {
          acc_overrides.set(path, cur)
          if !drv_str_arr_contains(modified_files, path) {
            modified_files.push(path)
          }
          round_applied = round_applied + file_applied
        }
      }
      fi = fi + 1
    }
    if round_applied == 0 {
      break
    }
    total_applied = total_applied + round_applied
    round = round + 1
  }
  // Final in-memory verification across the entire workspace + tests before any disk write.
  let final_ev = match drv_lint_eval(
    world,
    targets,
    locked,
    offline,
    target_override,
    acc_overrides,
  ) {
    Err(msg) => return drv_lint_fix_fail(world, as_json, msg)
    Ok(v) => v
  }
  match drv_lint_merge_read_set(
    final_ev,
    initial_read_paths,
    initial_snapshots,
    initial_lstat,
    initial_absent,
    initial_dirs,
    initial_dir_snaps,
    initial_owned_pkg_dir,
    initial_owned_pkg_canon,
    initial_all_pkg_canon_dirs,
  ) {
    Err(msg) => return drv_lint_fix_fail(world, as_json, msg)
    Ok(_) => ()
  }
  if final_ev.has_errors {
    return drv_lint_print_fix_result(world, false, 0, [], final_ev.diagnostics)
  }
  if modified_files.length() > 0 {
    let lock_h = match drv_lint_fix_lock(world) {
      Err(msg) => return drv_lint_fix_fail(world, as_json, msg)
      Ok(h) => h
    }
    // 1. Verify entire read set (contents + file kind) has not changed on disk.
    let mut ri = 0
    while ri < initial_read_paths.length() {
      let rp = initial_read_paths[ri]
      let exp_kind = match initial_lstat.get(rp) {
        Some(k) => k
        None => -1
      }
      if drv_lstat_kind(rp) != exp_kind {
        drv_lint_fix_unlock(lock_h)
        return drv_lint_fix_fail(
          world,
          as_json,
          "file identity changed on disk during `pionc lint --fix`: " + rp,
        )
      }
      let snap = match initial_snapshots.get(rp) {
        Some(t) => t
        None => {
          drv_lint_fix_unlock(lock_h)
          return drv_lint_fix_fail(world, as_json, "missing snapshot for " + rp)
        }
      }
      let cur_disk = match fs_read(world, rp) {
        Ok(t) => t
        Err(msg) => {
          drv_lint_fix_unlock(lock_h)
          return drv_lint_fix_fail(
            world,
            as_json,
            "failed to re-read " + rp + ": " + msg,
          )
        }
      }
      if cur_disk != snap {
        drv_lint_fix_unlock(lock_h)
        return drv_lint_fix_fail(
          world,
          as_json,
          "file changed on disk during `pionc lint --fix`: " + rp,
        )
      }
      ri = ri + 1
    }
    // 2. Verify previously absent lockfiles are still absent.
    ri = 0
    while ri < initial_absent.length() {
      let ap = initial_absent[ri]
      if drv_lstat_kind(ap) != 0 {
        drv_lint_fix_unlock(lock_h)
        return drv_lint_fix_fail(
          world,
          as_json,
          "file appeared on disk during `pionc lint --fix`: " + ap,
        )
      }
      ri = ri + 1
    }
    // 3. Verify scanned source directories have identical `.pion` file listings.
    ri = 0
    while ri < initial_dirs.length() {
      let sd = initial_dirs[ri]
      let exp_list = match initial_dir_snaps.get(sd) {
        Some(s) => s
        None => ""
      }
      if drv_lint_snapshot_pion_dir(world, sd) != exp_list {
        drv_lint_fix_unlock(lock_h)
        return drv_lint_fix_fail(
          world,
          as_json,
          "directory contents changed during `pionc lint --fix`: " + sd,
        )
      }
      ri = ri + 1
    }
    // 3.5. Re-verify per-file regular-file kind and package ownership under lock before writing.
    ri = 0
    while ri < modified_files.length() {
      let path = modified_files[ri]
      if drv_lstat_kind(path) != 1 {
        drv_lint_fix_unlock(lock_h)
        return drv_lint_fix_fail(
          world,
          as_json,
          "file identity changed on disk during `pionc lint --fix`: " + path,
        )
      }
      match initial_owned_pkg_dir.get(path) {
        Some(pdir) =>
          match initial_owned_pkg_canon.get(path) {
            Some(pcanon) =>
              if !drv_lint_file_owned_by_pkg(
                world,
                path,
                pdir,
                pcanon,
                initial_all_pkg_canon_dirs,
              ) {
                drv_lint_fix_unlock(lock_h)
                return drv_lint_fix_fail(
                  world,
                  as_json,
                  "file package ownership changed during `pionc lint --fix`: " + path,
                )
              }
            None => ()
          }
        None => ()
      }
      ri = ri + 1
    }
    // 4. Commit atomically with checked rollback on partial write failure.
    let mut fi = 0
    while fi < modified_files.length() {
      let path = modified_files[fi]
      match acc_overrides.get(path) {
        Some(new_txt) =>
          if !drv_write_text_atomic(world, path, new_txt) {
            let failed_rb : Array[String] = []
            let mut rb = 0
            while rb < fi {
              let rbp = modified_files[rb]
              match initial_snapshots.get(rbp) {
                Some(orig) =>
                  if !drv_write_text_atomic(world, rbp, orig) {
                    failed_rb.push(rbp)
                  }
                None => failed_rb.push(rbp)
              }
              rb = rb + 1
            }
            drv_lint_fix_unlock(lock_h)
            let err_msg = if failed_rb.length() == 0 {
              "failed to write " + path
            } else {
              let sb = StringBuilder()
              sb.write_string("failed to write ")
              sb.write_string(path)
              sb.write_string("; rollback also failed for: ")
              let mut rfi = 0
              while rfi < failed_rb.length() {
                if rfi > 0 {
                  sb.write_string(", ")
                }
                sb.write_string(failed_rb[rfi])
                rfi = rfi + 1
              }
              sb.to_string()
            }
            return drv_lint_fix_fail(world, as_json, err_msg)
          }
        None => ()
      }
      fi = fi + 1
    }
    drv_lint_fix_unlock(lock_h)
  }
  let ok = !final_ev.has_errors && final_ev.diagnostics.length() == 0
  drv_lint_print_fix_result(
    world,
    ok,
    total_applied,
    modified_files,
    final_ev.diagnostics,
  )
}
///|
struct DrvDirStats {
  files : Int
  bytes : Int64
}

///|
fn drv_dir_stats(world : World, dir : String) -> DrvDirStats {
  if !fs_is_dir(world, dir) {
    return DrvDirStats::{ files: 0, bytes: 0L }
  }
  let stack : Array[String] = [dir]
  let mut files = 0
  let mut bytes = 0L
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    let entries = fs_list_dir(world, cur)
    let mut i = 0
    while i < entries.length() {
      let name = entries[i]
      if name != "." && name != ".." {
        let p = drv_join_path(cur, name)
        if fs_is_dir(world, p) {
          stack.push(p)
        } else {
          files = files + 1
          let sz = fs_size(world, p)
          if sz > 0L {
            bytes = bytes + sz
          }
        }
      }
      i = i + 1
    }
  }
  DrvDirStats::{ files: files, bytes: bytes }
}

///|
fn drv_clear_dir_files(world : World, dir : String) -> DrvDirStats {
  if drv_lstat_kind(dir) != 2 {
    return DrvDirStats::{ files: 0, bytes: 0L }
  }
  let stack : Array[String] = [dir]
  let mut files = 0
  let mut bytes = 0L
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    let entries = fs_list_dir(world, cur)
    let mut i = 0
    while i < entries.length() {
      let name = entries[i]
      if name != "." && name != ".." {
        let p = drv_join_path(cur, name)
        let k = drv_lstat_kind(p)
        if k == 2 {
          stack.push(p)
        } else if k == 1 || k == 3 {
          let sz = if k == 1 { fs_size(world, p) } else { 0L }
          if fs_remove(world, p) {
            files = files + 1
            if sz > 0L {
              bytes = bytes + sz
            }
          }
        }
      }
      i = i + 1
    }
  }
  DrvDirStats::{ files: files, bytes: bytes }
}

///|
fn drv_cache_clear_impl(
  world : World,
  clear_all : Bool,
  as_json : Bool,
) -> Int {
  let cache_dir = drv_resolve_cache_dir(world)
  // Under the index lock, so a concurrent build cannot publish an index
  // that still lists the files being removed (`index.tsv.lock` itself stays).
  let lk = drv_cas_index_lock(world, cache_dir)
  if lk < 0L {
    return drv_cmd_fail(
      world,
      as_json,
      "cannot lock CAS index " + drv_join_path(cache_dir, "index.tsv.lock"),
    )
  }
  // An index that exists but is not a readable regular file is left alone,
  // and so is every bucket: nothing is removed.
  let index_path = drv_join_path(cache_dir, "index.tsv")
  match drv_cas_read_index(world, index_path) {
    Some(_) => ()
    None => {
      c_fs_unlock(lk)
      return drv_cmd_fail(world, as_json, "cannot read CAS index " + index_path)
    }
  }
  let s_obj = drv_clear_dir_files(world, drv_join_path(cache_dir, "obj"))
  let s_bin = drv_clear_dir_files(world, drv_join_path(cache_dir, "bin"))
  let s_tbin = drv_clear_dir_files(world, drv_join_path(cache_dir, "testbin"))
  let s_sig = drv_clear_dir_files(world, drv_join_path(cache_dir, "sig"))
  let s_ssa = drv_clear_dir_files(world, drv_join_path(cache_dir, "ssa"))
  let s_usig = drv_clear_dir_files(world, drv_join_path(cache_dir, "usig"))
  let stale_pins : Array[String] = []
  drv_cas_collect_peer_pins(world, cache_dir, "", stale_pins)
  let mut removed_files = s_obj.files +
    s_bin.files +
    s_tbin.files +
    s_sig.files +
    s_ssa.files +
    s_usig.files
  let mut removed_bytes = s_obj.bytes +
    s_bin.bytes +
    s_tbin.bytes +
    s_sig.bytes +
    s_ssa.bytes +
    s_usig.bytes
  let index_kind = drv_lstat_kind(index_path)
  if index_kind != 0 && index_kind != 1 {
    c_fs_unlock(lk)
    return drv_cmd_fail(world, as_json, "cannot remove CAS index " + index_path)
  }
  if index_kind == 1 {
    let isz = fs_size(world, index_path)
    if !fs_remove(world, index_path) {
      c_fs_unlock(lk)
      return drv_cmd_fail(world, as_json, "failed to remove CAS index " + index_path)
    }
    removed_files = removed_files + 1
    if isz > 0L {
      removed_bytes = removed_bytes + isz
    }
  }
  c_fs_unlock(lk)
  if clear_all {
    let git_root = drv_git_cache_root(world)
    let sg = drv_dir_stats(world, git_root)
    if sg.files > 0 || fs_is_dir(world, git_root) {
      drv_rm_rf(world, git_root)
      removed_files = removed_files + sg.files
      removed_bytes = removed_bytes + sg.bytes
    }
    let reg_root = drv_registry_cache_root(world)
    let sr = drv_dir_stats(world, reg_root)
    if sr.files > 0 || fs_is_dir(world, reg_root) {
      drv_rm_rf(world, reg_root)
      removed_files = removed_files + sr.files
      removed_bytes = removed_bytes + sr.bytes
    }
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"action\":\"clear\",\"cache_dir\":")
    sb.write_string(json_quote(cache_dir))
    sb.write_string(",\"all\":")
    sb.write_string(if clear_all { "true" } else { "false" })
    sb.write_string(",\"removed_files\":")
    sb.write_string(removed_files.to_string())
    sb.write_string(",\"removed_bytes\":")
    sb.write_string(removed_bytes.to_string())
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(
      world,
      "cleared " +
      removed_files.to_string() +
      " file(s) (" +
      removed_bytes.to_string() +
      " bytes) from " +
      cache_dir,
    )
  }
  0
}

///|
fn drv_run_cache_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut clear_all = false
  let mut sub = ""
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--all" {
      clear_all = true
    } else if sub.length() == 0 {
      sub = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if sub.length() == 0 {
    sub = "stats"
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let max_mb = max_bytes / (1024L * 1024L)
  if sub == "stats" {
    let s_obj = drv_dir_stats(world, drv_join_path(cache_dir, "obj"))
    let s_bin1 = drv_dir_stats(world, drv_join_path(cache_dir, "bin"))
    let s_bin2 = drv_dir_stats(world, drv_join_path(cache_dir, "testbin"))
    let s_sig1 = drv_dir_stats(world, drv_join_path(cache_dir, "sig"))
    let s_sig2 = drv_dir_stats(world, drv_join_path(cache_dir, "usig"))
    let s_sig3 = drv_dir_stats(world, drv_join_path(cache_dir, "ssa"))
    let s_git = drv_dir_stats(world, drv_git_cache_root(world))
    let bin_files = s_bin1.files + s_bin2.files
    let bin_bytes = s_bin1.bytes + s_bin2.bytes
    let sig_files = s_sig1.files + s_sig2.files + s_sig3.files
    let sig_bytes = s_sig1.bytes + s_sig2.bytes + s_sig3.bytes
    let total_files = s_obj.files + bin_files + sig_files + s_git.files
    let total_bytes = s_obj.bytes + bin_bytes + sig_bytes + s_git.bytes
    if as_json {
      let sb = StringBuilder()
      sb.write_string("{\"ok\":true,\"cache_dir\":")
      sb.write_string(json_quote(cache_dir))
      sb.write_string(",\"max_mb\":")
      sb.write_string(max_mb.to_string())
      sb.write_string(",\"total_files\":")
      sb.write_string(total_files.to_string())
      sb.write_string(",\"total_bytes\":")
      sb.write_string(total_bytes.to_string())
      sb.write_string(",\"obj\":{\"files\":")
      sb.write_string(s_obj.files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(s_obj.bytes.to_string())
      sb.write_string("},\"bin\":{\"files\":")
      sb.write_string(bin_files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(bin_bytes.to_string())
      sb.write_string("},\"sig\":{\"files\":")
      sb.write_string(sig_files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(sig_bytes.to_string())
      sb.write_string("},\"git\":{\"files\":")
      sb.write_string(s_git.files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(s_git.bytes.to_string())
      sb.write_string("}}")
      io_println(world, sb.to_string())
    } else {
      io_println(world, "cache_dir: " + cache_dir)
      io_println(world, "max_mb:    " + max_mb.to_string())
      io_println(
        world,
        "obj:       " +
        s_obj.files.to_string() +
        " files, " +
        s_obj.bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "bin:       " +
        bin_files.to_string() +
        " files, " +
        bin_bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "sig:       " +
        sig_files.to_string() +
        " files, " +
        sig_bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "git:       " +
        s_git.files.to_string() +
        " files, " +
        s_git.bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "total:     " +
        total_files.to_string() +
        " files, " +
        total_bytes.to_string() +
        " bytes",
      )
    }
    return 0
  } else if sub == "prune" {
    let index_path = drv_join_path(cache_dir, "index.tsv")
    let lk = drv_cas_index_lock(world, cache_dir)
    if lk < 0L {
      return drv_cmd_fail(world, as_json, "cannot lock CAS index " + index_path + ".lock")
    }
    let entries = match drv_cas_read_index(world, index_path) {
      Some(v) => v
      None => {
        c_fs_unlock(lk)
        return drv_cmd_fail(world, as_json, "cannot read CAS index " + index_path)
      }
    }
    let mut before_bytes = 0L
    let mut ei = 0
    while ei < entries.length() {
      before_bytes = before_bytes + entries[ei].bytes
      ei = ei + 1
    }
    let protected : Array[String] = []
    drv_cas_collect_peer_pins(world, cache_dir, "", protected)
    let ev = cas_touch_and_evict_pinned(
      entries,
      "__prune_sentinel__",
      0L,
      clock_now_ms(world),
      max_bytes,
      protected,
    )
    let kept : Array[CasEntry] = []
    let mut after_bytes = 0L
    let mut ki = 0
    while ki < ev.kept.length() {
      if ev.kept[ki].key != "__prune_sentinel__" {
        kept.push(ev.kept[ki])
        after_bytes = after_bytes + ev.kept[ki].bytes
      }
      ki = ki + 1
    }
    let mut evi = 0
    while evi < ev.evicted.length() {
      drv_cas_remove_entry(world, cache_dir, ev.evicted[evi])
      evi = evi + 1
    }
    if (fs_exists(world, index_path) || kept.length() > 0) &&
      !drv_write_text_atomic(world, index_path, cas_format_index(kept)) {
      c_fs_unlock(lk)
      return drv_cmd_fail(world, as_json, "failed to write CAS index " + index_path)
    }
    c_fs_unlock(lk)
    if as_json {
      let sb = StringBuilder()
      sb.write_string("{\"ok\":true,\"action\":\"prune\",\"cache_dir\":")
      sb.write_string(json_quote(cache_dir))
      sb.write_string(",\"evicted\":")
      sb.write_string(ev.evicted.length().to_string())
      sb.write_string(",\"before_bytes\":")
      sb.write_string(before_bytes.to_string())
      sb.write_string(",\"after_bytes\":")
      sb.write_string(after_bytes.to_string())
      sb.write_string(",\"max_bytes\":")
      sb.write_string(max_bytes.to_string())
      sb.write_string("}")
      io_println(world, sb.to_string())
    } else {
      io_println(
        world,
        "pruned " +
        ev.evicted.length().to_string() +
        " entry(s): " +
        before_bytes.to_string() +
        " -> " +
        after_bytes.to_string() +
        " bytes (limit " +
        max_bytes.to_string() +
        " bytes)",
      )
    }
    return 0
  } else if sub == "clear" {
    return drv_cache_clear_impl(world, clear_all, as_json)
  }
  drv_cmd_fail(
    world,
    as_json,
    "unknown cache subcommand `" + sub + "` (expected stats|prune|clear)",
  )
}

///|
fn drv_run_clean_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut clear_all = false
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--all" {
      clear_all = true
    } else {
      return drv_cmd_fail(world, as_json, "unknown option `" + a + "`")
    }
    i = i + 1
  }
  drv_cache_clear_impl(world, clear_all, as_json)
}

///|
fn drv_find_tool_path(world : World, name : String) -> String {
  if name.length() == 0 {
    return ""
  }
  if drv_has_path_sep(name) {
    if fs_exists(world, name) {
      return name
    }
    return ""
  }
  let p = drv_find_in_path(world, name)
  if p.length() > 0 {
    return p
  }
  if drv_env_str(world, "OS") == "Windows_NT" &&
    !drv_ends_with(name, ".exe") &&
    !drv_ends_with(name, ".EXE") {
    return drv_find_in_path(world, name + ".exe")
  }
  ""
}

///|
fn drv_run_doctor_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut i = 2
  while i < args.length() {
    if args[i] == "--json" {
      as_json = true
    } else {
      return drv_cmd_fail(world, as_json, "unknown option `" + args[i] + "`")
    }
    i = i + 1
  }
  let host_target = drv_resolve_qbe_target(world)
  let self_path = drv_self_exe_path(world)
  let qbe_raw = drv_resolve_qbe_bin(world)
  let qbe_resolved = drv_find_tool_path(world, qbe_raw)
  let qbe_exists = qbe_resolved.length() > 0
  let qbe_path = if qbe_exists { qbe_resolved } else { qbe_raw }
  let rt_lib_path = match drv_resolve_rt_lib(world, host_target) {
    Err(_) => ""
    Ok(p) => p
  }
  let rt_lib_exists = fs_exists(world, rt_lib_path)
  let rt_lib_bytes = if rt_lib_exists {
    let sz = fs_size(world, rt_lib_path)
    if sz > 0L { sz } else { 0L }
  } else {
    0L
  }
  let wasm_rt_path = drv_resolve_wasm_rt(world)
  let wasm_rt_exists = fs_exists(world, wasm_rt_path)
  let cc_raw = drv_resolve_cc_driver(world, host_target, false)
  let cc_resolved = drv_find_tool_path(world, cc_raw)
  let cc_exists = cc_resolved.length() > 0
  let cc_path = if cc_exists { cc_resolved } else { cc_raw }
  let cxx_raw = drv_resolve_cc_driver(world, host_target, true)
  let cxx_resolved = drv_find_tool_path(world, cxx_raw)
  let cxx_exists = cxx_resolved.length() > 0
  let cxx_path = if cxx_exists { cxx_resolved } else { cxx_raw }
  let win_abi = if drv_target_is_windows(host_target) {
    if drv_is_windows_msvc_cc(world, host_target, cc_path) {
      "msvc"
    } else {
      "mingw"
    }
  } else {
    "native"
  }
  let wasm_opt_path = drv_find_tool_path(world, "wasm-opt")
  let node_path = drv_find_tool_path(world, "node")
  let git_path = drv_find_tool_path(world, "git")
  let cache_dir = drv_resolve_cache_dir(world)
  let cache_max_mb = drv_resolve_cache_max_bytes(world) / (1024L * 1024L)
  let st_obj = drv_dir_stats(world, drv_join_path(cache_dir, "obj"))
  let st_bin = drv_dir_stats(world, drv_join_path(cache_dir, "bin"))
  let st_tbin = drv_dir_stats(world, drv_join_path(cache_dir, "testbin"))
  let st_sig = drv_dir_stats(world, drv_join_path(cache_dir, "sig"))
  let st_usig = drv_dir_stats(world, drv_join_path(cache_dir, "usig"))
  let st_ssa = drv_dir_stats(world, drv_join_path(cache_dir, "ssa"))
  let st_git = drv_dir_stats(world, drv_git_cache_root(world))
  let cache_files = st_obj.files +
    st_bin.files +
    st_tbin.files +
    st_sig.files +
    st_usig.files +
    st_ssa.files +
    st_git.files
  let cache_bytes = st_obj.bytes +
    st_bin.bytes +
    st_tbin.bytes +
    st_sig.bytes +
    st_usig.bytes +
    st_ssa.bytes +
    st_git.bytes
  let ok = qbe_exists && rt_lib_exists && cc_exists
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":")
    sb.write_string(if ok { "true" } else { "false" })
    sb.write_string(",\"version\":\"0.1.0\",\"host_target\":")
    sb.write_string(json_quote(host_target))
    sb.write_string(",\"pionc\":")
    sb.write_string(json_quote(self_path))
    sb.write_string(",\"qbe\":{\"path\":")
    sb.write_string(json_quote(qbe_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if qbe_exists { "true" } else { "false" })
    sb.write_string("},\"rt_lib\":{\"path\":")
    sb.write_string(json_quote(rt_lib_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if rt_lib_exists { "true" } else { "false" })
    sb.write_string(",\"bytes\":")
    sb.write_string(rt_lib_bytes.to_string())
    sb.write_string("},\"wasm_rt\":{\"path\":")
    sb.write_string(json_quote(wasm_rt_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if wasm_rt_exists { "true" } else { "false" })
    sb.write_string("},\"cc\":{\"path\":")
    sb.write_string(json_quote(cc_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if cc_exists { "true" } else { "false" })
    sb.write_string("},\"cxx\":{\"path\":")
    sb.write_string(json_quote(cxx_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if cxx_exists { "true" } else { "false" })
    sb.write_string("},\"win_abi\":")
    sb.write_string(json_quote(win_abi))
    sb.write_string(",\"wasm_opt\":")
    sb.write_string(json_quote(wasm_opt_path))
    sb.write_string(",\"node\":")
    sb.write_string(json_quote(node_path))
    sb.write_string(",\"git\":")
    sb.write_string(json_quote(git_path))
    sb.write_string(",\"cache_dir\":")
    sb.write_string(json_quote(cache_dir))
    sb.write_string(",\"cache_files\":")
    sb.write_string(cache_files.to_string())
    sb.write_string(",\"cache_bytes\":")
    sb.write_string(cache_bytes.to_string())
    sb.write_string(",\"cache_max_mb\":")
    sb.write_string(cache_max_mb.to_string())
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "pionc doctor (v0.1.0, " + host_target + ")")
    io_println(world, "  pionc:     " + self_path)
    io_println(
      world,
      "  qbe:       " +
      qbe_path +
      (if qbe_exists { " [ok]" } else { " [MISSING]" }),
    )
    io_println(
      world,
      "  rt_lib:    " +
      rt_lib_path +
      (if rt_lib_exists {
        " [ok, " + rt_lib_bytes.to_string() + " B]"
      } else {
        " [MISSING]"
      }),
    )
    io_println(
      world,
      "  wasm_rt:   " +
      wasm_rt_path +
      (if wasm_rt_exists { " [ok]" } else { " [missing]" }),
    )
    io_println(
      world,
      "  cc:        " +
      cc_path +
      (if cc_exists { " [ok]" } else { " [MISSING]" }),
    )
    io_println(
      world,
      "  cxx:       " +
      cxx_path +
      (if cxx_exists { " [ok]" } else { " [missing]" }),
    )
    io_println(world, "  win_abi:   " + win_abi)
    io_println(
      world,
      "  wasm_opt:  " +
      (if wasm_opt_path.length() > 0 { wasm_opt_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  node:      " +
      (if node_path.length() > 0 { node_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  git:       " +
      (if git_path.length() > 0 { git_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  cache:     " +
      cache_dir +
      " (" +
      cache_files.to_string() +
      " files, " +
      cache_bytes.to_string() +
      " bytes, max " +
      cache_max_mb.to_string() +
      " MB)",
    )
    io_println(
      world,
      "  status:    " + (if ok { "OK" } else { "INCOMPLETE" }),
    )
  }
  if ok { 0 } else { 1 }
}

///|
fn drv_toml_strip_comment(line : String) -> String {
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < line.length() {
    let c = str_code_at(line, i)
    if esc {
      esc = false
    } else if in_str {
      if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return slice_str(line, 0, i)
    }
    i = i + 1
  }
  line
}

///|
fn drv_manifest_remove_dependency(text : String, dep_name : String) -> String {
  let lines : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < text.length() {
    if str_code_at(text, i) == 10 {
      lines.push(slice_str(text, start, i))
      start = i + 1
    }
    i = i + 1
  }
  lines.push(slice_str(text, start, text.length()))
  let out : Array[String] = []
  let mut section = ""
  let mut li = 0
  while li < lines.length() {
    let raw = lines[li]
    let clean = drv_trim_ws(drv_toml_strip_comment(raw))
    let mut skip = false
    if clean.length() > 0 {
      if str_code_at(clean, 0) == 91 &&
        str_code_at(clean, clean.length() - 1) == 93 {
        section = drv_trim_ws(slice_str(clean, 1, clean.length() - 1))
      } else if section == "dependencies" {
        let eq = drv_find_substr(clean, "=", 0)
        if eq > 0 && drv_trim_ws(slice_str(clean, 0, eq)) == dep_name {
          skip = true
        }
      }
    }
    if !skip {
      out.push(raw)
    }
    li = li + 1
  }
  let sb = StringBuilder()
  let mut j = 0
  while j < out.length() {
    if j > 0 {
      sb.write_string("\n")
    }
    sb.write_string(out[j])
    j = j + 1
  }
  sb.to_string()
}

///|
fn drv_run_remove_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut name = ""
  let mut dir = ""
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if drv_starts_with(a, "--") {
      return drv_cmd_fail(world, as_json, "unknown option `" + a + "`")
    } else if name.length() == 0 {
      name = a
    } else if dir.length() == 0 {
      dir = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if name.length() == 0 {
    return drv_cmd_fail(
      world,
      as_json,
      "usage: pionc remove [--json] <name> [dir]",
    )
  }
  let target_dir = if dir.length() > 0 { dir } else { "." }
  let root_dir = match drv_detect_manifest_dir(world, target_dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + target_dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) =>
      return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  let mut found = false
  let mut di = 0
  while di < mf.deps.length() {
    if mf.deps[di].name == name {
      found = true
      break
    }
    di = di + 1
  }
  if !found {
    return drv_cmd_fail(
      world,
      as_json,
      "no dependency `" + name + "` in " + mf_path,
    )
  }
  let enclosing_ws = if mf.is_workspace {
    Some(DrvEnclosingWs::{
      root_dir: drv_abs_path(world, root_dir),
      manifest: mf,
      manifest_text: text,
    })
  } else {
    drv_find_enclosing_workspace(world, root_dir)
  }
  let new_text = drv_manifest_remove_dependency(text, name)
  match parse_pion_toml(new_text) {
    Err(e) =>
      return drv_cmd_fail(
        world,
        as_json,
        "rewritten pion.toml does not parse: " + e,
      )
    Ok(_) => ()
  }
  if !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let lock_base = match enclosing_ws {
    Some(ws) => ws.root_dir
    None => drv_normalize_path(root_dir)
  }
  let lock_path = drv_join_path(lock_base, "pion.lock")
  if fs_exists(world, lock_path) {
    // Only prune pion.lock when the remaining dependency graph loads cleanly;
    // when the graph is incomplete/broken, keep all existing lock entries intact.
    // However, if writing pion.lock itself fails, roll back pion.toml and fail.
    match drv_load_workspace_ex(world, lock_base, false, "") {
      Ok(_) => ()
      Err(e) =>
        if e == "failed to write " + lock_path || drv_starts_with(e, "failed to write ") {
          let mut msg = e
          if !drv_restore_file(world, mf_path, true, text) {
            msg = msg + "; failed to restore " + mf_path
          }
          return drv_cmd_fail(world, as_json, msg)
        }
    }
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"removed\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"manifest\":")
    sb.write_string(json_quote(mf_path))
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "removed `" + name + "` from " + mf_path)
  }
  0
}

///|
fn drv_is_valid_c_ident(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    let is_alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    let is_digit = c >= 48 && c <= 57
    if i == 0 {
      if !is_alpha {
        return false
      }
    } else if !is_alpha && !is_digit {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_usage_text() -> String {
  "usage:\n" +
  "  pionc check [--fix] [--locked] [--offline] [--target <target>] [--json] [input1 ...]\n" +
  "  pionc lint [--fix] [--locked] [--offline] [--target <target>] [--json] [input1 ...]\n" +
  "  pionc query defs|sig|callers|deps|analyze [--locked] [--offline] [--target <target>] [--json] [input1 ...]\n" +
  "  pionc emit-sig <input1> [input2 ...]\n" +
  "  pionc build [--package <name>|-p <name>] [--release] [--locked] [--offline] [--target arm64_apple|amd64_apple|amd64_sysv|amd64_win|arm64|rv64|ios_arm64|ios_sim_arm64|android_arm64|android_x64|wasm32] [--wasm-names] [--emit-web-rt [path]] [--sysroot <dir>] [--entry-symbol <name>] [--no-main] [--emit-ssa <path>] [--emit-asm <path>] [--emit-obj <path>] [--emit-staticlib <path.a>] [--emit-cdylib <path.so|.dylib>] [--jobs <n>] [-l <lib>|--link <lib>] [-o <out>] [input1 ...]\n" +
  "  pionc run [--package <name>|-p <name>] [--release] [--locked] [--offline] [--target <target>] [--wasm-names] [-l <lib>|--link <lib>] [input] [-- args...]\n" +
  "  pionc fmt [--check] [--json] [input1 ...]\n" +
  "  pionc test [--json] [--locked] [--offline] [--target <target>] [--package <name>|-p <name>] [--deps|--no-deps|--only-pkg] [--filter <name>] [--jobs <n>] [-l <lib>|--link <lib>] [input]\n" +
  "  pionc doc [--target <target>] [--json] [input1 ...]\n" +
  "  pionc extract-lean --out <dir> [--pkg <name>] [--json] [input]\n" +
  "  pionc init [--template cli|service|invar-app] [--json] <dir>\n" +
  "  pionc fetch [--locked] [--offline] [--json] [dir]\n" +
  "  pionc add [--json] <name> (--path <p> | --git <url> [--tag <t>|--rev <r>|--branch <b>] [--subdir <s>] | [--registry <url_or_path>]) [dir]\n" +
  "  pionc remove [--json] <name> [dir]\n" +
  "  pionc update [--json] [pkg] [dir]\n" +
  "  pionc search [--json] [--offline] [--refresh] [--registry <url_or_path>] [--category <cat>] [query...]\n" +
  "  pionc doctor [--json]\n" +
  "  pionc cache stats|prune|clear [--all] [--json]\n" +
  "  pionc clean [--all] [--json]\n" +
  "  pionc --version|-V|version [--json]\n" +
  "  pionc --help|-h|help"
}

///|
fn drv_usage(world : World) -> Unit {
  io_eprintln(world, drv_usage_text())
}

///|
pub fn main(world : World) -> Int {
  let trace_demand = drv_env_str(world, "PION_SIG_TRACE_DEMAND") == "1"
  if drv_env_str(world, "PION_SIG_VERIFY_DEMAND") == "1" {
    sig_set_verify_demand(true)
  }
  if drv_env_str(world, "PION_SIG_FORCE_FULL") == "1" {
    sig_set_force_full(true)
  }
  if trace_demand {
    sig_set_trace_demand(true)
  }
  let rc = drv_main_dispatch(world)
  if trace_demand {
    let lines = sig_take_demand_trace_lines()
    let mut ti = 0
    while ti < lines.length() {
      io_eprintln(world, lines[ti])
      ti = ti + 1
    }
  }
  rc
}

///|
fn drv_main_dispatch(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    drv_usage(world)
    return 1
  }
  let cmd = args[1]
  if cmd == "--internal-ws-pkg-worker" {
    return drv_run_ws_pkg_worker(world, args)
  }
  if cmd == "--help" || cmd == "-h" || cmd == "help" {
    io_println(world, drv_usage_text())
    return 0
  }
  if cmd == "--version" || cmd == "-V" || cmd == "version" {
    let mut as_json = false
    let mut vi = 2
    while vi < args.length() {
      if args[vi] == "--json" {
        as_json = true
      }
      vi = vi + 1
    }
    let host_target = drv_resolve_qbe_target(world)
    let abi_rev = pion_compiler_abi_rev()
    if as_json {
      io_println(
        world,
        "{\"version\":\"0.1.0\",\"target\":" +
        json_quote(host_target) +
        ",\"abi_rev\":" +
        json_quote(abi_rev) +
        "}",
      )
    } else {
      io_println(
        world,
        "pionc 0.1.0 (" + host_target + ", abi " + abi_rev + ", self-hosted)",
      )
    }
    return 0
  }
  if cmd == "doctor" {
    return drv_run_doctor_cmd(world, args)
  }
  if cmd == "extract-lean" {
    return drv_run_extract_lean_cmd(world, args)
  }
  if cmd == "cache" {
    return drv_run_cache_cmd(world, args)
  }
  if cmd == "clean" {
    return drv_run_clean_cmd(world, args)
  }
  if cmd == "add" {
    return drv_run_add_cmd(world, args)
  }
  if cmd == "remove" {
    return drv_run_remove_cmd(world, args)
  }
  if cmd == "update" {
    return drv_run_update_cmd(world, args)
  }
  if cmd == "search" {
    return drv_run_search_cmd(world, args)
  }
  if cmd == "fetch" {
    let mut dir = ""
    let mut locked = false
    let mut offline = false
    let mut i = 2
    while i < args.length() {
      if args[i] == "--locked" {
        locked = true
      } else if args[i] == "--offline" {
        offline = true
      } else if args[i] != "--json" {
        dir = args[i]
      }
      i = i + 1
    }
    return drv_run_fetch_cmd(world, if dir.length() > 0 { dir } else { "." }, locked, offline)
  }
  if cmd == "init" {
    let mut as_json = false
    let mut tmpl = "cli"
    let mut dir = ""
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if a == "--json" {
        as_json = true
      } else if a == "--template" {
        if i + 1 >= args.length() {
          drv_usage(world)
          return 1
        }
        i = i + 1
        tmpl = args[i]
      } else if drv_starts_with(a, "--template=") {
        tmpl = slice_str(a, 11, a.length())
      } else {
        dir = a
      }
      i = i + 1
    }
    if dir.length() == 0 {
      drv_usage(world)
      return 1
    }
    return drv_run_init_cmd(world, dir, tmpl, as_json)
  }
  if cmd == "check" {
    let mut as_json = false
    let mut do_fix = false
    let mut do_server = false
    let mut include_tests = false
    let mut locked = false
    let mut offline = false
    let mut target_override = ""
    let mut pkg_filter = ""
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      if args[i] == "--json" {
        as_json = true
      } else if args[i] == "--fix" {
        do_fix = true
      } else if args[i] == "--server" {
        do_server = true
      } else if args[i] == "--include-tests" {
        include_tests = true
      } else if args[i] == "--locked" {
        locked = true
      } else if args[i] == "--offline" {
        offline = true
      } else if args[i] == "--package" || args[i] == "-p" {
        if i + 1 >= args.length() {
          return drv_cmd_fail(world, as_json, "--package requires a value")
        }
        pkg_filter = args[i + 1]
        i = i + 1
      } else if drv_starts_with(args[i], "--package=") {
        pkg_filter = slice_str(args[i], 10, args[i].length())
      } else if args[i] == "--target" {
        if i + 1 >= args.length() {
          return drv_cmd_fail(world, as_json, "--target requires a value")
        }
        target_override = args[i + 1]
        i = i + 1
      } else if drv_starts_with(args[i], "--target=") {
        target_override = slice_str(args[i], 9, args[i].length())
      } else {
        targets.push(args[i])
      }
      i = i + 1
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      return drv_cmd_fail(
        world,
        as_json,
        "unknown target `" +
        target_override +
        "` (valid: arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, wasm32)",
      )
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    if do_server {
      if targets.length() != 1 {
        io_eprintln(world, "error: `pionc check --server` accepts a single target")
        return 1
      }
      return drv_run_check_server_cmd(
        world,
        targets[0],
        pkg_filter,
        include_tests,
        locked,
        offline,
        drv_pick_target(world, target_override),
      )
    }
    if do_fix {
      return drv_run_check_fix_cmd(world, targets, as_json, locked, offline, target_override)
    }
    if targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_opts_target(
            world,
            root_dir,
            locked,
            offline,
            "",
            drv_pick_target(world, target_override),
          ) {
            Err(msg) => return drv_cmd_fail(world, as_json, msg)
            Ok(ws) => {
              let all_diags = drv_ws_diagnostics_cached(world, ws.nodes)
              io_println(world, check_result_to_json(all_diags))
              if all_diags.length() > 0 {
                return 1
              }
              return 0
            }
          }
        None => ()
      }
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let _ = drv_parallel_prehash(world, loaded.sources, 4)
        match cli_check_json(loaded.pkg_name, loaded.paths, loaded.sources) {
          (ok, json) => {
            io_println(world, json)
            if !ok {
              return 1
            }
            return 0
          }
          _ => return 1
        }
      }
    }
  } else if cmd == "lint" {
    let mut as_json = false
    let mut do_fix = false
    let mut locked = false
    let mut offline = false
    let mut target_override = ""
    let mut parse_err = ""
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      if args[i] == "--json" {
        as_json = true
      } else if args[i] == "--fix" {
        do_fix = true
      } else if args[i] == "--locked" {
        locked = true
      } else if args[i] == "--offline" {
        offline = true
      } else if args[i] == "--target" {
        if i + 1 >= args.length() {
          if parse_err.length() == 0 {
            parse_err = "--target requires a value"
          }
        } else {
          target_override = args[i + 1]
          i = i + 1
        }
      } else if drv_starts_with(args[i], "--target=") {
        target_override = slice_str(args[i], 9, args[i].length())
      } else if drv_starts_with(args[i], "-") {
        if parse_err.length() == 0 {
          parse_err = "unknown option `" + args[i] + "` for `pionc lint`"
        }
      } else {
        targets.push(args[i])
      }
      i = i + 1
    }
    if parse_err.length() > 0 {
      return if do_fix {
        drv_lint_fix_fail(world, as_json, parse_err)
      } else {
        drv_cmd_fail(world, as_json, parse_err)
      }
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      let msg = "unknown target `" +
        target_override +
        "` (valid: arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, wasm32)"
      return if do_fix {
        drv_lint_fix_fail(world, as_json, msg)
      } else {
        drv_cmd_fail(world, as_json, msg)
      }
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        let msg = "no target specified and no pion.toml in current directory"
        return if do_fix {
          drv_lint_fix_fail(world, as_json, msg)
        } else {
          drv_cmd_fail(world, as_json, msg)
        }
      }
    }
    if do_fix {
      return drv_run_lint_fix_cmd(world, targets, as_json, locked, offline, target_override)
    }
    match drv_lint_eval(world, targets, locked, offline, target_override, Map([])) {
      Err(msg) => return drv_cmd_fail(world, as_json, msg)
      Ok(ev) => {
        io_println(world, check_result_to_json(ev.diagnostics))
        if ev.has_errors || ev.diagnostics.length() > 0 {
          return 1
        }
        return 0
      }
    }
  } else if cmd == "query" {
    if args.length() < 3 {
      drv_usage(world)
      return 1
    }
    let kind = args[2]
    let mut locked = false
    let mut offline = false
    let mut include_tests = false
    let mut target_override = ""
    let mut pkg_filter = ""
    let targets : Array[String] = []
    let mut i = 3
    while i < args.length() {
      if args[i] == "--locked" {
        locked = true
      } else if args[i] == "--offline" {
        offline = true
      } else if args[i] == "--include-tests" {
        include_tests = true
      } else if args[i] == "--package" || args[i] == "-p" {
        if i + 1 >= args.length() {
          io_eprintln(world, "error: --package requires a value")
          return 1
        }
        pkg_filter = args[i + 1]
        i = i + 1
      } else if drv_starts_with(args[i], "--package=") {
        pkg_filter = slice_str(args[i], 10, args[i].length())
      } else if args[i] == "--target" {
        if i + 1 >= args.length() {
          io_eprintln(world, "error: --target requires a value")
          return 1
        }
        target_override = args[i + 1]
        i = i + 1
      } else if drv_starts_with(args[i], "--target=") {
        target_override = slice_str(args[i], 9, args[i].length())
      } else if args[i] != "--json" {
        targets.push(args[i])
      }
      i = i + 1
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      io_eprintln(
        world,
        "error: unknown target `" +
        target_override +
        "` (valid: arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, wasm32)",
      )
      return 1
    }
    let query_target = drv_pick_target(world, target_override)
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        io_eprintln(
          world,
          "error: no target specified and no pion.toml in current directory",
        )
        return 1
      }
    }
    if kind == "types" {
      if targets.length() != 1 {
        io_eprintln(world, "error: `pionc query types` accepts a single target")
        return 1
      }
      return drv_run_query_types_cmd(
        world,
        targets[0],
        pkg_filter,
        include_tests,
        locked,
        offline,
        query_target,
      )
    }
    if kind == "analyze" {
      if targets.length() == 1 {
        match drv_detect_manifest_dir(world, targets[0]) {
          Some(root_dir) =>
            match drv_load_workspace_opts_target(world, root_dir, locked, offline, "", query_target) {
              Err(msg) => {
                io_eprintln(world, "error: " + msg)
                return 1
              }
              Ok(ws) => {
                let nodes = ws.nodes
                let names : Array[String] = []
                let dep_lists : Array[Array[String]] = []
                let mut ni = 0
                while ni < nodes.length() {
                  names.push(nodes[ni].name)
                  dep_lists.push(nodes[ni].deps)
                  ni = ni + 1
                }
                let topo = topo_sort_packages(names, dep_lists)
                if topo.diagnostics.length() > 0 {
                  io_println(world, query_analyze_packages_json([], topo.diagnostics))
                  return 1
                }
                let decl_counts : Map[String, Int] = Map([])
                let mut dci = 0
                while dci < nodes.length() {
                  let dn = nodes[dci].declared_name
                  let prev = match decl_counts.get(dn) {
                    Some(c) => c
                    None => 0
                  }
                  decl_counts.set(dn, prev + 1)
                  dci = dci + 1
                }
                let canon_to_aname : Map[String, String] = Map([])
                dci = 0
                while dci < nodes.length() {
                  let nd = nodes[dci]
                  let aname = match decl_counts.get(nd.declared_name) {
                    Some(c) => if c == 1 { nd.declared_name } else { nd.name }
                    None => nd.name
                  }
                  canon_to_aname.set(nd.name, aname)
                  dci = dci + 1
                }
                let imported : Array[ImportedPkg] = []
                let checked_pkgs : Array[CheckedPackage] = []
                let all_diags : Array[Diagnostic] = []
                let mut k = 0
                while k < topo.order.length() {
                  let node = nodes[topo.order[k]]
                  let aname = match canon_to_aname.get(node.name) {
                    Some(v) => v
                    None => node.name
                  }
                  let a_dep_targets : Array[String] = []
                  let mut adi = 0
                  while adi < node.deps.length() {
                    let dt = match canon_to_aname.get(node.deps[adi]) {
                      Some(v) => v
                      None => node.deps[adi]
                    }
                    a_dep_targets.push(dt)
                    adi = adi + 1
                  }
                  let cr = check_source_files_with_imports_mapped(
                    aname,
                    node.paths,
                    node.sources,
                    imported,
                    node.dep_aliases,
                    a_dep_targets,
                    true,
                    true,
                  )
                  let mut di = 0
                  while di < cr.diagnostics.length() {
                    all_diags.push(cr.diagnostics[di])
                    di = di + 1
                  }
                  imported.push(ImportedPkg::{ name: aname, tc: cr.tc })
                  checked_pkgs.push(cr)
                  k = k + 1
                }
                io_println(world, query_analyze_packages_json(checked_pkgs, all_diags))
                return if all_diags.length() == 0 { 0 } else { 1 }
              }
            }
          None => ()
        }
        if fs_is_dir(world, targets[0]) &&
          fs_is_dir(world, drv_join_path(targets[0], "src")) {
          match drv_load_pkg_dir_sources(world, targets[0]) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(pair) => {
              let cr = check_source_files_with_imports_ex(
                drv_basename_pkg(targets[0]),
                pair.paths,
                pair.sources,
                [],
                false,
                true,
              )
              io_println(world, query_analyze_packages_json([cr], cr.diagnostics))
              return if cr.diagnostics.length() == 0 { 0 } else { 1 }
            }
          }
        }
      }
      match drv_load_targets(world, targets) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(loaded) => {
          let cr = check_source_files_with_imports_ex(
            loaded.pkg_name,
            loaded.paths,
            loaded.sources,
            [],
            false,
            true,
          )
          io_println(world, query_analyze_packages_json([cr], cr.diagnostics))
          return if cr.diagnostics.length() == 0 { 0 } else { 1 }
        }
      }
    }
    if kind != "deps" && targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_opts_target(world, root_dir, locked, offline, "", query_target) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(ws) => {
              let nodes = ws.nodes
              let pkgs : Array[Package] = []
              let mut ni = 0
              while ni < nodes.length() {
                let node = nodes[ni]
                pkgs.push(parse_package(node.declared_name, node.paths, node.sources))
                ni = ni + 1
              }
              match query_workspace_json(kind, pkgs) {
                Ok(json) => {
                  io_println(world, json)
                  return 0
                }
                Err(msg) => {
                  io_eprintln(world, "error: " + msg)
                  return 1
                }
              }
            }
          }
        None => ()
      }
    }
    // A plain package directory (no pion.toml): its own files plus `src/`.
    let mut src_pair : Option[DrvSrcPair] = None
    if kind != "deps" &&
      targets.length() == 1 &&
      fs_is_dir(world, targets[0]) &&
      fs_is_dir(world, drv_join_path(targets[0], "src")) {
      match drv_load_pkg_dir_sources(world, targets[0]) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(pair) => src_pair = Some(pair)
      }
    }
    match src_pair {
      Some(pair) =>
        match cli_query_json(kind, drv_basename_pkg(targets[0]), pair.paths, pair.sources) {
          Ok(json) => {
            io_println(world, json)
            return 0
          }
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
        }
      None => ()
    }
    if kind == "deps" && targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_opts_target(world, root_dir, locked, offline, "", query_target) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(ws) => {
              let nodes = ws.nodes
              let names : Array[String] = []
              let dep_lists : Array[Array[String]] = []
              let mut ni = 0
              while ni < nodes.length() {
                names.push(nodes[ni].name)
                dep_lists.push(nodes[ni].deps)
                ni = ni + 1
              }
              let topo = topo_sort_packages(names, dep_lists)
              if topo.diagnostics.length() > 0 {
                io_println(world, check_result_to_json(topo.diagnostics))
                return 1
              }
              let ord_names : Array[String] = []
              let ord_deps : Array[Array[String]] = []
              let ord_hashes : Array[String] = []
              let mut k = 0
              while k < topo.order.length() {
                let node = nodes[topo.order[k]]
                let pkg = parse_package(node.declared_name, node.paths, node.sources)
                ord_names.push(node.declared_name)
                ord_deps.push(node.dep_aliases)
                ord_hashes.push(sig_hash_hex(emit_pionsig(pkg)))
                k = k + 1
              }
              io_println(
                world,
                query_workspace_deps_json(ord_names, ord_deps, ord_hashes),
              )
              return 0
            }
          }
        None => ()
      }
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) =>
        match cli_query_json(kind, loaded.pkg_name, loaded.paths, loaded.sources) {
          Ok(json) => {
            io_println(world, json)
            return 0
          }
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
        }
    }
  } else if cmd == "emit-sig" {
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      targets.push(args[i])
      i = i + 1
    }
    if targets.length() == 0 {
      drv_usage(world)
      return 1
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let sig = cli_emit_sig(loaded.pkg_name, loaded.paths, loaded.sources)
        io_print(world, sig)
        return 0
      }
    }
  } else if cmd == "build" {
    let mut release = false
    let mut emit_ssa = ""
    let mut emit_asm = ""
    let mut out_bin = ""
    let mut jobs = 16
    let mut target_override = ""
    let mut emit_obj = ""
    let mut emit_staticlib = ""
    let mut emit_cdylib = ""
    let mut sysroot = ""
    let mut only_pkg = ""
    let mut wasm_names = false
    let mut emit_web_rt = false
    let mut emit_web_rt_path = ""
    let mut entry_symbol = ""
    let mut no_main = false
    let mut locked = false
    let mut offline = false
    let libs : Array[String] = []
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      let nl = drv_parse_link_flag(args, i, libs)
      if nl > 0 {
        i = i + nl
        continue
      }
      if a == "--release" {
        release = true
      } else if a == "--locked" {
        locked = true
      } else if a == "--offline" {
        offline = true
      } else if a == "--wasm-names" {
        wasm_names = true
      } else if a == "--emit-web-rt" {
        emit_web_rt = true
        if i + 1 < args.length() {
          let nxt = args[i + 1]
          if !drv_starts_with(nxt, "-") && drv_has_js_ext(nxt) {
            emit_web_rt_path = nxt
            i = i + 1
          }
        }
      } else if drv_starts_with(a, "--emit-web-rt=") {
        emit_web_rt = true
        emit_web_rt_path = slice_str(a, 14, a.length())
      } else if a == "--no-main" {
        no_main = true
      } else if a == "--entry-symbol" && i + 1 < args.length() {
        entry_symbol = args[i + 1]
        i = i + 1
      } else if drv_starts_with(a, "--entry-symbol=") {
        entry_symbol = slice_str(a, 15, a.length())
      } else if (a == "--package" || a == "-p") && i + 1 < args.length() {
        only_pkg = args[i + 1]
        i = i + 1
      } else if drv_starts_with(a, "--package=") {
        only_pkg = slice_str(a, 10, a.length())
      } else if a == "--target" && i + 1 < args.length() {
        target_override = args[i + 1]
        i = i + 1
      } else if a == "--emit-obj" && i + 1 < args.length() {
        emit_obj = args[i + 1]
        i = i + 1
      } else if a == "--emit-staticlib" && i + 1 < args.length() {
        emit_staticlib = args[i + 1]
        i = i + 1
      } else if a == "--emit-cdylib" && i + 1 < args.length() {
        emit_cdylib = args[i + 1]
        i = i + 1
      } else if a == "--sysroot" && i + 1 < args.length() {
        sysroot = args[i + 1]
        i = i + 1
      } else if a == "--emit-ssa" && i + 1 < args.length() {
        emit_ssa = args[i + 1]
        i = i + 1
      } else if a == "--emit-asm" && i + 1 < args.length() {
        emit_asm = args[i + 1]
        i = i + 1
      } else if a == "--jobs" && i + 1 < args.length() {
        jobs = drv_parse_pos_int(args[i + 1], 16)
        i = i + 1
      } else if a == "-o" && i + 1 < args.length() {
        out_bin = args[i + 1]
        i = i + 1
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        io_eprintln(
          world,
          "error: no target specified and no pion.toml in current directory",
        )
        return 1
      }
    }
    let raw_targets : Array[String] = []
    let mut rti = 0
    while rti < targets.length() {
      raw_targets.push(targets[rti])
      rti = rti + 1
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      io_eprintln(
        world,
        "error: unsupported --target `" +
        target_override +
        "` (expected arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, or wasm32)",
      )
      return 1
    }
    let build_resolve_target = if target_override != "" {
      target_override
    } else {
      drv_resolve_qbe_target(world)
    }
    if targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_resolve_build_pkg_dir(world, root_dir, only_pkg, build_resolve_target) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(pkg_dir) => targets[0] = pkg_dir
          }
        None =>
          if only_pkg.length() > 0 {
            io_eprintln(world, "error: --package needs a pion.toml workspace")
            return 1
          }
      }
    } else if only_pkg.length() > 0 {
      io_eprintln(world, "error: --package needs a single pion.toml workspace")
      return 1
    }
    if no_main && entry_symbol != "" {
      io_eprintln(
        world,
        "error: --entry-symbol and --no-main are mutually exclusive",
      )
      return 1
    }
    if entry_symbol != "" && !drv_is_valid_c_ident(entry_symbol) {
      io_eprintln(
        world,
        "error: invalid --entry-symbol `" +
        entry_symbol +
        "` (must be a valid C identifier [A-Za-z_][A-Za-z0-9_]*)",
      )
      return 1
    }
    if emit_web_rt && !drv_target_is_wasm(build_resolve_target) {
      io_eprintln(world, "error: --emit-web-rt requires --target wasm32")
      return 1
    }
    let mut web_rt_dst = ""
    if emit_web_rt {
      match drv_resolve_web_rt_dst(
        world,
        raw_targets,
        targets,
        out_bin,
        emit_ssa,
        emit_asm,
        emit_obj,
        emit_staticlib,
        emit_cdylib,
        emit_web_rt_path,
      ) {
        Ok(d) => web_rt_dst = d
        Err(msg) => {
          io_eprintln(world, msg)
          return 1
        }
      }
    }
    match drv_build_targets(
      world,
      targets,
      release,
      emit_ssa,
      emit_asm,
      out_bin,
      jobs,
      build_resolve_target,
      emit_obj,
      emit_staticlib,
      emit_cdylib,
      sysroot,
      libs,
      wasm_names,
      entry_symbol,
      no_main,
      web_rt_dst,
      locked,
      offline,
    ) {
      Ok(_) => {
        if emit_web_rt {
          match drv_emit_web_rt_file(world, web_rt_dst) {
            Ok(_) => return 0
            Err(msg) => {
              io_eprintln(world, msg)
              return 1
            }
          }
        }
        return 0
      }
      Err(msg) => {
        io_eprintln(world, msg)
        return 1
      }
    }
  } else if cmd == "run" {
    let mut release = false
    let mut wasm_names = false
    let mut locked = false
    let mut offline = false
    let mut target_override = ""
    let mut only_pkg = ""
    let mut target = ""
    let libs : Array[String] = []
    let prog_args : Array[String] = []
    let mut after_sep = false
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if !after_sep && target == "" {
        let nl = drv_parse_link_flag(args, i, libs)
        if nl > 0 {
          i = i + nl
          continue
        }
      }
      if after_sep {
        prog_args.push(a)
      } else if a == "--" {
        after_sep = true
      } else if a == "--release" && target == "" {
        release = true
      } else if a == "--locked" && target == "" {
        locked = true
      } else if a == "--offline" && target == "" {
        offline = true
      } else if a == "--wasm-names" && target == "" {
        wasm_names = true
      } else if (a == "--package" || a == "-p") &&
        target == "" &&
        i + 1 < args.length() {
        only_pkg = args[i + 1]
        i = i + 1
      } else if drv_starts_with(a, "--package=") && target == "" {
        only_pkg = slice_str(a, 10, a.length())
      } else if a == "--target" && target == "" && i + 1 < args.length() {
        target_override = args[i + 1]
        i = i + 1
      } else if target == "" {
        target = a
      } else {
        prog_args.push(a)
      }
      i = i + 1
    }
    if target == "" {
      if drv_has_default_project(world) {
        target = "."
      } else {
        io_eprintln(
          world,
          "error: no target specified and no pion.toml in current directory",
        )
        return 1
      }
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      io_eprintln(
        world,
        "error: unsupported --target `" +
        target_override +
        "` (expected arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, or wasm32)",
      )
      return 1
    }
    let run_resolve_target = if target_override != "" {
      target_override
    } else {
      drv_resolve_qbe_target(world)
    }
    match drv_detect_manifest_dir(world, target) {
      Some(root_dir) =>
        match drv_resolve_build_pkg_dir(world, root_dir, only_pkg, run_resolve_target) {
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
          Ok(pkg_dir) => target = pkg_dir
        }
      None =>
        if only_pkg.length() > 0 {
          io_eprintln(world, "error: --package needs a pion.toml workspace")
          return 1
        }
    }
    match drv_build_targets(
      world,
      [target],
      release,
      "",
      "",
      "",
      drv_default_jobs(world),
      run_resolve_target,
      "",
      "",
      "",
      "",
      libs,
      wasm_names,
      "",
      false,
      "",
      locked,
      offline,
    ) {
      Err(msg) => {
        io_eprintln(world, msg)
        return 1
      }
      Ok(bin_path) => {
        if drv_target_is_wasm(run_resolve_target) {
          let rt_mjs = drv_resolve_wasm_rt(world)
          let run_argv : Array[String] = ["node", rt_mjs, bin_path]
          let mut j = 0
          while j < prog_args.length() {
            run_argv.push(prog_args[j])
            j = j + 1
          }
          return proc_exec(world, run_argv)
        }
        let run_argv : Array[String] = [bin_path]
        let mut j = 0
        while j < prog_args.length() {
          run_argv.push(prog_args[j])
          j = j + 1
        }
        return proc_exec(world, run_argv)
      }
    }
  } else if cmd == "fmt" {
    let mut check_only = false
    let mut as_json = false
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if a == "--check" {
        check_only = true
      } else if a == "--json" {
        as_json = true
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    return drv_run_fmt_cmd(world, targets, check_only, as_json)
  } else if cmd == "test" {
    let mut as_json = false
    let mut ji = 2
    while ji < args.length() {
      if args[ji] == "--json" {
        as_json = true
      }
      ji = ji + 1
    }
    let mut filter = ""
    let mut only_pkg = ""
    let mut target_override = ""
    let mut explicit_no_deps = false
    let mut explicit_deps = false
    let mut locked = false
    let mut offline = false
    let mut jobs = drv_default_jobs(world)
    let libs : Array[String] = []
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      let nl = drv_parse_link_flag(args, i, libs)
      if nl > 0 {
        i = i + nl
        continue
      }
      if a == "--json" {
        as_json = true
      } else if a == "--locked" {
        locked = true
      } else if a == "--offline" {
        offline = true
      } else if a == "--deps" {
        explicit_deps = true
      } else if a == "--no-deps" || a == "--only-pkg" {
        explicit_no_deps = true
      } else if a == "--filter" {
        if i + 1 >= args.length() {
          return drv_cmd_fail(world, as_json, "--filter requires a value")
        }
        filter = args[i + 1]
        i = i + 1
      } else if a == "--package" || a == "-p" {
        if i + 1 >= args.length() {
          return drv_cmd_fail(world, as_json, "--package requires a package name")
        }
        only_pkg = args[i + 1]
        i = i + 1
      } else if drv_starts_with(a, "--package=") {
        only_pkg = slice_str(a, 10, a.length())
      } else if a == "--target" {
        if i + 1 >= args.length() {
          return drv_test_fail(world, as_json, "--target requires a value")
        }
        target_override = args[i + 1]
        i = i + 1
      } else if drv_starts_with(a, "--target=") {
        target_override = slice_str(a, 9, a.length())
      } else if a == "--jobs" {
        if i + 1 >= args.length() {
          return drv_test_fail(world, as_json, "--jobs requires a positive integer")
        }
        let jv = drv_parse_pos_int(args[i + 1], -1)
        if jv < 1 {
          return drv_test_fail(
            world,
            as_json,
            "--jobs requires a positive integer, got `" + args[i + 1] + "`",
          )
        }
        jobs = jv
        i = i + 1
      } else if drv_starts_with(a, "--jobs=") {
        let raw_j = slice_str(a, 7, a.length())
        let jv = drv_parse_pos_int(raw_j, -1)
        if jv < 1 {
          return drv_test_fail(
            world,
            as_json,
            "--jobs requires a positive integer, got `" + raw_j + "`",
          )
        }
        jobs = jv
      } else if drv_starts_with(a, "-") {
        return drv_cmd_fail(world, as_json, "unknown option for `pionc test`: " + a)
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if explicit_deps && explicit_no_deps {
      return drv_cmd_fail(
        world,
        as_json,
        "--deps and --no-deps are mutually exclusive",
      )
    }
    if explicit_no_deps && only_pkg.length() > 0 {
      return drv_cmd_fail(
        world,
        as_json,
        "--no-deps and --package are mutually exclusive",
      )
    }
    if explicit_deps && only_pkg.length() > 0 {
      return drv_cmd_fail(
        world,
        as_json,
        "--deps and --package are mutually exclusive",
      )
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    let no_deps = !explicit_deps
    return drv_run_tests_cmd(
      world,
      targets,
      as_json,
      filter,
      libs,
      only_pkg,
      no_deps,
      jobs,
      locked,
      offline,
      target_override,
    )
  } else if cmd == "doc" {
    let mut as_json = false
    let mut target_override = ""
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      if args[i] == "--json" {
        as_json = true
      } else if args[i] == "--target" {
        if i + 1 >= args.length() {
          return drv_cmd_fail(world, as_json, "--target requires a value")
        }
        target_override = args[i + 1]
        i = i + 1
      } else if drv_starts_with(args[i], "--target=") {
        target_override = slice_str(args[i], 9, args[i].length())
      } else {
        targets.push(args[i])
      }
      i = i + 1
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      return drv_cmd_fail(
        world,
        as_json,
        "unknown target `" +
        target_override +
        "` (valid: arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, wasm32)",
      )
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    return drv_run_doc_cmd(world, targets, as_json, target_override)
  } else {
    drv_usage(world)
    return 1
  }
}

///|
/// `pionc extract-lean --out <dir> [--pkg <name>] [--json] [path]` (SPEC §5.5):
/// type-checks (including the `#verify` rules) a file, package directory or
/// workspace, builds the Pion-LLBC of its `#verify` closure and writes one
/// `<out>/<Pkg>/{Types,Funs,FunsExternal_Template}.lean` set per extracted
/// package (and `FunsExternal.lean` when it does not exist yet). Nothing is
/// written when any diagnostic is reported.
fn drv_run_extract_lean_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut out_dir = ""
  let mut only_pkg = ""
  let targets : Array[String] = []
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--out" && i + 1 < args.length() {
      out_dir = args[i + 1]
      i = i + 1
    } else if drv_starts_with(a, "--out=") {
      out_dir = slice_str(a, 6, a.length())
    } else if (a == "--pkg" || a == "--package" || a == "-p") && i + 1 < args.length() {
      only_pkg = args[i + 1]
      i = i + 1
    } else {
      targets.push(a)
    }
    i = i + 1
  }
  if out_dir.length() == 0 {
    return drv_cmd_fail(world, as_json, "extract-lean requires --out <dir>")
  }
  if targets.length() == 0 {
    if drv_has_default_project(world) {
      targets.push(".")
    } else {
      return drv_cmd_fail(world, as_json, "no target specified and no pion.toml in current directory")
    }
  }
  let inputs : Array[LlbcInput] = []
  let diags : Array[Diagnostic] = []
  let mut handled = false
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) =>
        match drv_load_workspace_nodes(world, root_dir) {
          Err(msg) => return drv_cmd_fail(world, as_json, msg)
          Ok(nodes) => {
            handled = true
            let names : Array[String] = []
            let dep_lists : Array[Array[String]] = []
            let mut ni = 0
            while ni < nodes.length() {
              names.push(nodes[ni].name)
              dep_lists.push(nodes[ni].deps)
              ni = ni + 1
            }
            let topo = topo_sort_packages(names, dep_lists)
            if topo.diagnostics.length() > 0 {
              io_println(world, check_result_to_json(topo.diagnostics))
              return 1
            }
            // With `--pkg`, resolve by exact canon_id or unique declared_name,
            // then keep only that package and its transitive dependencies.
            let keep : Map[String, Bool] = Map([])
            let mut target_canon = ""
            if only_pkg.length() > 0 {
              let mut exact = ""
              let decl_matches : Array[String] = []
              let mut qi = 0
              while qi < nodes.length() {
                if nodes[qi].name == only_pkg {
                  exact = nodes[qi].name
                  break
                }
                if nodes[qi].declared_name == only_pkg {
                  decl_matches.push(nodes[qi].name)
                }
                qi = qi + 1
              }
              if exact.length() > 0 {
                target_canon = exact
              } else if decl_matches.length() == 1 {
                target_canon = decl_matches[0]
              } else if decl_matches.length() > 1 {
                return drv_cmd_fail(
                  world,
                  as_json,
                  "ambiguous package `" +
                  only_pkg +
                  "` (matches: " +
                  drv_join_comma(decl_matches) +
                  "); pass one of the canonical ids to --pkg",
                )
              } else {
                return drv_cmd_fail(world, as_json, "unknown package `" + only_pkg + "`")
              }
              let stack : Array[String] = [target_canon]
              while stack.length() > 0 {
                let n = match stack.pop() {
                  Some(x) => x
                  None => break
                }
                if keep.contains(n) {
                  continue
                }
                keep.set(n, true)
                let mut q = 0
                while q < nodes.length() {
                  if nodes[q].name == n {
                    let mut di = 0
                    while di < nodes[q].deps.length() {
                      stack.push(nodes[q].deps[di])
                      di = di + 1
                    }
                  }
                  q = q + 1
                }
              }
            }
            // Pass 1: count ASCII-lowercased Lean module name occurrences across the extracted subgraph
            // so case-insensitive filesystems (macOS/Windows) never collide on directory names.
            let mod_counts : Map[String, Int] = Map([])
            let mut ci = 0
            while ci < topo.order.length() {
              let node = nodes[topo.order[ci]]
              if only_pkg.length() == 0 || keep.contains(node.name) {
                let mkey = drv_ascii_lower(lean_module_name(node.declared_name))
                let prev = match mod_counts.get(mkey) {
                  Some(n) => n
                  None => 0
                }
                mod_counts.set(mkey, prev + 1)
              }
              ci = ci + 1
            }
            // Pass 2: reserve clean declared names for all case-insensitively unique Lean module names.
            let lean_pkg_names : Map[String, String] = Map([])
            let used_lean_mods : Map[String, Bool] = Map([])
            ci = 0
            while ci < topo.order.length() {
              let node = nodes[topo.order[ci]]
              if only_pkg.length() == 0 || keep.contains(node.name) {
                let mkey = drv_ascii_lower(lean_module_name(node.declared_name))
                let cnt = match mod_counts.get(mkey) {
                  Some(n) => n
                  None => 0
                }
                if cnt == 1 {
                  lean_pkg_names.set(node.name, node.declared_name)
                  used_lean_mods.set(mkey, true)
                }
              }
              ci = ci + 1
            }
            // Pass 3: deterministically assign remaining colliding nodes without colliding
            // (even case-insensitively) with any reserved or previously assigned module name.
            ci = 0
            while ci < topo.order.length() {
              let node = nodes[topo.order[ci]]
              if (only_pkg.length() == 0 || keep.contains(node.name)) &&
                !lean_pkg_names.contains(node.name) {
                let mut cand = node.name
                let mut suffix = 2
                while used_lean_mods.contains(drv_ascii_lower(lean_module_name(cand))) {
                  cand = node.name + "__" + suffix.to_string()
                  suffix = suffix + 1
                }
                used_lean_mods.set(drv_ascii_lower(lean_module_name(cand)), true)
                lean_pkg_names.set(node.name, cand)
              }
              ci = ci + 1
            }
            let imported : Array[ImportedPkg] = []
            let mut k = 0
            while k < topo.order.length() {
              let node = nodes[topo.order[k]]
              if only_pkg.length() == 0 || keep.contains(node.name) {
                let lean_name = match lean_pkg_names.get(node.name) {
                  Some(n) => n
                  None => node.name
                }
                let mapped_deps : Array[String] = []
                let mut mdi = 0
                while mdi < node.deps.length() {
                  let dn = node.deps[mdi]
                  mapped_deps.push(
                    match lean_pkg_names.get(dn) {
                      Some(ln) => ln
                      None => dn
                    },
                  )
                  mdi = mdi + 1
                }
                let cr = check_source_files_with_imports_mapped(
                  lean_name,
                  node.paths,
                  node.sources,
                  imported,
                  node.dep_aliases,
                  mapped_deps,
                  true,
                  false,
                )
                let mut di = 0
                while di < cr.diagnostics.length() {
                  diags.push(cr.diagnostics[di])
                  di = di + 1
                }
                imported.push(ImportedPkg::{ name: lean_name, tc: cr.tc })
                inputs.push(llbc_input_new(lean_name, cr.pkg, cr.tc, only_pkg.length() == 0 || node.name == target_canon))
              }
              k = k + 1
            }
          }
        }
      None => ()
    }
  }
  if !handled {
    match drv_load_targets(world, targets) {
      Err(msg) => return drv_cmd_fail(world, as_json, msg)
      Ok(loaded) => {
        let cr = check_source_files_full(loaded.pkg_name, loaded.paths, loaded.sources)
        let mut di = 0
        while di < cr.diagnostics.length() {
          diags.push(cr.diagnostics[di])
          di = di + 1
        }
        inputs.push(llbc_input_new(loaded.pkg_name, cr.pkg, cr.tc, true))
      }
    }
  }
  if diags.length() > 0 {
    drv_print_extract_diags(world, as_json, diags)
    return 1
  }
  let outs = lean_extract(inputs, diags)
  if diags.length() > 0 {
    drv_print_extract_diags(world, as_json, diags)
    return 1
  }
  let mut oi = 0
  while oi < outs.length() {
    let o = outs[oi]
    let _ = fs_mkdir_p(world, drv_join_path(out_dir, o.lean_mod))
    // `FunsExternal.lean` is the user's: it is (re)written only when absent or
    // still identical to the previously generated template (never edited).
    let old_tmpl = match fs_read(world, drv_join_path(out_dir, o.lean_mod + "/FunsExternal_Template.lean")) {
      Ok(t) => t
      Err(_) => ""
    }
    let mut fi = 0
    while fi < o.files.length() {
      let f = o.files[fi]
      let path = drv_join_path(out_dir, f.path)
      let mut write = !f.only_if_absent || !fs_exists(world, path)
      if !write && old_tmpl.length() > 0 {
        match fs_read(world, path) {
          Ok(cur) => write = cur == old_tmpl
          Err(_) => ()
        }
      }
      if write {
        if !drv_write_text_atomic(world, path, f.content) {
          return drv_cmd_fail(world, as_json, "failed to write " + path)
        }
      }
      fi = fi + 1
    }
    oi = oi + 1
  }
  if as_json {
    io_println(world, lean_extract_json(out_dir, outs))
  } else {
    oi = 0
    while oi < outs.length() {
      let o = outs[oi]
      io_println(
        world,
        "extracted " + o.name + " -> " + drv_join_path(out_dir, o.lean_mod) + " (types=" + o.types.to_string() + ", funs=" + o.funs.to_string() + ", externals=" + o.externals.length().to_string() + ")",
      )
      oi = oi + 1
    }
  }
  0
}

///|
fn l_name_in(names : Array[String], n : String) -> Bool {
  let mut i = 0
  while i < names.length() {
    if names[i] == n {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_print_extract_diags(world : World, as_json : Bool, diags : Array[Diagnostic]) -> Unit {
  if as_json {
    io_println(world, check_result_to_json(diags))
  } else {
    let mut i = 0
    while i < diags.length() {
      let d = diags[i]
      io_eprintln(world, d.file + ":" + d.line.to_string() + ":" + d.col.to_string() + ": " + d.code + ": " + d.message)
      i = i + 1
    }
  }
}


///|
extern "C" fn c_cli_malloc(n : Int64) -> Ptr = "malloc"

///|
extern "C" fn c_cli_read_line_bounded(
  max_bytes : Int64,
  out_buf_slot : Ptr,
  out_len_slot : Ptr,
) -> Int = "pion_cli_read_line_bounded"

///|
extern "C" fn c_cli_free_buf(buf : Ptr) -> Unit = "pion_cli_free_buf"

///|
extern "C" fn c_cli_write_line(data : Ptr, len : Int64) -> Int = "pion_cli_write_line"

///|
fn drv_write_server_line(s : String) -> Bool {
  c_cli_write_line(str_data_ptr(s), s.length().to_int64()) == 0
}

///|
struct DrvPreparedUpstream {
  upstream_diags : Array[Diagnostic]
  root_imports : Array[ImportedPkg]
  topo_diags : Array[Diagnostic]
}

///|
/// Shared upstream loader for `pionc query types` and `pionc check --server`.
/// Checks/caches only the transitive upstream dependencies of `nodes[root_idx]`
/// using the exact same CAS `.pionsig`/`.pionstub` keys as `drv_ws_diagnostics_cached`,
/// preserves all `upstream_diags` (including on source fallback), and loads
/// `ImportedPkg`s for the root package.
fn drv_ws_prepare_upstream(
  world : World,
  nodes : Array[PkgNodeInput],
  root_idx : Int,
) -> DrvPreparedUpstream {
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return DrvPreparedUpstream::{
      upstream_diags: [],
      root_imports: [],
      topo_diags: topo.diagnostics,
    }
  }
  let n = topo.order.length()
  let mut root_topo = -1
  let mut k = 0
  while k < n {
    if topo.order[k] == root_idx {
      root_topo = k
      break
    }
    k = k + 1
  }
  if root_topo < 0 {
    return DrvPreparedUpstream::{
      upstream_diags: [],
      root_imports: [],
      topo_diags: [],
    }
  }
  let trans = drv_trans_deps(nodes, topo.order)
  let trans_dep_topo = trans.topo
  let trans_dep_names = trans.names
  let needed : Array[Bool] = []
  k = 0
  while k < n {
    needed.push(false)
    k = k + 1
  }
  let root_deps_topo = trans_dep_topo[root_topo]
  let mut rdi = 0
  while rdi < root_deps_topo.length() {
    needed[root_deps_topo[rdi]] = true
    rdi = rdi + 1
  }

  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let check_fp = drv_compute_self_fp(world, "check-v1")
  let trace_cas = drv_env_str(world, "PION_TRACE_CAS") == "1"

  let stub_paths : Array[String] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let pkg_has_err : Array[Bool] = []
  k = 0
  while k < n {
    stub_paths.push("")
    loaded_imported.push(None)
    pkg_has_err.push(false)
    k = k + 1
  }
  let sig_hashes : Map[String, String] = Map([])
  let pin = drv_cas_pin_open(world, cache_dir)
  let new_keys : Array[String] = []
  let new_sizes : Array[Int64] = []
  let upstream_diags : Array[Diagnostic] = []

  k = 0
  while k < n {
    if !needed[k] {
      k = k + 1
      continue
    }
    let node = nodes[topo.order[k]]
    let deps_k = trans_dep_topo[k]
    let mut any_dep_err = false
    let mut di = 0
    while di < deps_k.length() {
      if pkg_has_err[deps_k[di]] {
        any_dep_err = true
        break
      }
      di = di + 1
    }
    let upstream_sigs : Array[String] = []
    let t_names = trans_dep_names[k]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh)
      u = u + 1
    }
    drv_append_dep_alias_sigs(upstream_sigs, node)
    let key = cas_compute_key(
      node.name,
      drv_cas_rel_paths(node),
      node.sources,
      upstream_sigs,
      "check",
      false,
      check_fp,
    )
    let sig_path = cache_dir + "/sig/" + key + ".pionsig"
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"
    let mut cas_hit = false
    if !any_dep_err && drv_is_regular_file(sig_path) && drv_is_regular_file(stub_path) {
      match fs_read(world, sig_path) {
        Ok(sig_text) => {
          sig_hashes.set(node.name, drv_effective_sig_hash(sig_text, node, sig_hashes))
          stub_paths[k] = stub_path
          drv_cas_pin_add(pin, key)
          cas_hit = true
          if trace_cas {
            io_eprintln(
              world,
              "[cas-check] pkg=" + node.declared_name + " HIT key=" + drv_prefix16(key),
            )
          }
        }
        Err(_) => ()
      }
    }
    if !cas_hit {
      if trace_cas {
        io_eprintln(
          world,
          "[cas-check] pkg=" + node.declared_name + " MISS key=" + drv_prefix16(key),
        )
      }
      let k_imports = drv_ensure_ws_imports_ex(
        world,
        nodes,
        topo.order,
        trans_dep_topo,
        stub_paths,
        loaded_imported,
        k,
        Some(upstream_diags),
      )
      let cr = check_source_files_with_imports_mapped(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        node.dep_aliases,
        node.deps,
        true,
        false,
      )
      cr.tc.pkg_root = drv_normalize_path(drv_abs_path(world, node.dir))
      cr.tc.pkg_cwd = drv_normalize_path(drv_abs_path(world, "."))
      loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      if cr.diagnostics.length() > 0 {
        let mut ei = 0
        while ei < cr.diagnostics.length() {
          upstream_diags.push(cr.diagnostics[ei])
          ei = ei + 1
        }
        pkg_has_err[k] = true
      } else {
        let pionsig = emit_pionsig(cr.pkg)
        sig_hashes.set(node.name, drv_effective_sig_hash(pionsig, node, sig_hashes))
        if !any_dep_err {
          let pionstub = emit_pion_stub(cr.pkg)
          let _ = drv_write_cas_text_atomic(world, sig_path, pionsig)
          let _ = drv_write_cas_text_atomic(world, stub_path, pionstub)
          stub_paths[k] = stub_path
          drv_cas_pin_add(pin, key)
          new_keys.push(key)
          new_sizes.push((pionsig.length() + pionstub.length()).to_int64())
        }
      }
    }
    k = k + 1
  }
  let _ = drv_cas_pin_flush(world, pin)
  if new_keys.length() > 0 {
    drv_cas_record_batch_and_evict_pinned(
      world,
      cache_dir,
      new_keys,
      new_sizes,
      pin,
    )
  }
  let root_imports = drv_ensure_ws_imports_ex(
    world,
    nodes,
    topo.order,
    trans_dep_topo,
    stub_paths,
    loaded_imported,
    root_topo,
    Some(upstream_diags),
  )
  drv_cas_post_run_evict(world, cache_dir, pin, [])
  DrvPreparedUpstream::{
    upstream_diags: upstream_diags,
    root_imports: root_imports,
    topo_diags: [],
  }
}

///|
struct DrvServerSnapshot {
  pkg_name : String
  root_dir : String
  manifest_mode : Bool
  manifest_dir : String
  pinned_pkg_dir : String
  multi_pkg : Bool
  dep_aliases : Array[String]
  deps : Array[String]
  root_imports : Array[ImportedPkg]
  upstream_diags : Array[Diagnostic]
  base_rels : Array[String]
  base_paths : Array[String]
  base_sources : Array[String]
  base_parsed : Map[String, ParseResult]
  test_rels : Array[String]
  test_paths : Array[String]
  test_sources : Array[String]
  test_parsed : Map[String, ParseResult]
}

///|
fn drv_load_server_snapshot(
  world : World,
  target : String,
  pkg_filter : String,
  locked : Bool,
  offline : Bool,
  active_target : String,
  require_manifest : Int,
  pinned_manifest_dir : String,
  pinned_pkg_dir : String,
) -> Result[DrvServerSnapshot, String] {
  let detected_mf = if require_manifest == 1 {
    let mf_file = drv_join_path(pinned_manifest_dir, "pion.toml")
    if !fs_exists(world, mf_file) {
      return Err("missing `pion.toml` in `" + pinned_manifest_dir + "`")
    }
    Some(pinned_manifest_dir)
  } else if require_manifest == 2 {
    None
  } else {
    drv_detect_manifest_dir(world, target)
  }
  match detected_mf {
    Some(root_dir) => {
      let root_abs = drv_canon_dir(world, root_dir)
      let root_mf_path = drv_join_path(root_abs, "pion.toml")
      if fs_exists(world, root_mf_path) {
        match fs_read(world, root_mf_path) {
          Ok(mf_txt) =>
            match parse_pion_toml(mf_txt) {
              Ok(mf) =>
                if mf.is_workspace && pkg_filter.length() == 0 {
                  return Err("virtual workspace requires `--package <name>`")
                }
              Err(e) => return Err("invalid `pion.toml`: " + e)
            }
          Err(e) => return Err("failed to read `pion.toml`: " + e)
        }
      } else if require_manifest == 1 {
        return Err("missing `pion.toml` in `" + root_abs + "`")
      }
      let ws = match drv_load_workspace_opts_target(
        world,
        root_dir,
        locked,
        offline,
        "",
        active_target,
      ) {
        Err(msg) => return Err(msg)
        Ok(v) => v
      }
      let nodes = ws.nodes
      if nodes.length() == 0 {
        return Err("workspace contains no packages")
      }
      let mut root_idx = -1
      if pkg_filter.length() > 0 {
        let mut ni = 0
        while ni < nodes.length() {
          if nodes[ni].declared_name == pkg_filter || nodes[ni].name == pkg_filter {
            root_idx = ni
            break
          }
          ni = ni + 1
        }
        if root_idx < 0 {
          return Err("package `" + pkg_filter + "` not found in workspace")
        }
      } else {
        let mut ni = 0
        while ni < nodes.length() {
          if drv_canon_dir(world, nodes[ni].dir) == root_abs {
            root_idx = ni
            break
          }
          ni = ni + 1
        }
        if root_idx < 0 {
          root_idx = nodes.length() - 1
        }
      }
      let root_node = nodes[root_idx]
      let pkg_dir_abs = drv_canon_dir(world, root_node.dir)
      if require_manifest == 1 && pinned_pkg_dir.length() > 0 && pkg_dir_abs != pinned_pkg_dir {
        return Err(
          "package root directory changed on reload (expected `" + pinned_pkg_dir + "`, found `" + pkg_dir_abs + "`)",
        )
      }
      let prep = drv_ws_prepare_upstream(world, nodes, root_idx)
      if prep.topo_diags.length() > 0 {
        return Err("cyclic package dependency in workspace")
      }
      let base_rels : Array[String] = []
      let base_paths : Array[String] = []
      let base_sources : Array[String] = []
      let mut bi = 0
      while bi < root_node.paths.length() && bi < root_node.sources.length() {
        base_rels.push(pkg_rebase_rel_path(root_node.dir, root_node.paths[bi]))
        base_paths.push(root_node.paths[bi])
        base_sources.push(root_node.sources[bi])
        bi = bi + 1
      }
      let test_paths : Array[String] = []
      let test_sources : Array[String] = []
      match drv_append_test_sources_for(
        world,
        root_node.dir,
        root_node.target_rules,
        active_target,
        test_paths,
        test_sources,
      ) {
        Err(msg) => return Err(msg)
        Ok(_) => ()
      }
      let test_rels : Array[String] = []
      let mut ti = 0
      while ti < test_paths.length() {
        test_rels.push(pkg_rebase_rel_path(root_node.dir, test_paths[ti]))
        ti = ti + 1
      }
      let base_parsed : Map[String, ParseResult] = Map([])
      let mut pi = 0
      while pi < base_rels.length() {
        base_parsed.set(base_rels[pi], parse_source(base_paths[pi], base_sources[pi]))
        pi = pi + 1
      }
      Ok(DrvServerSnapshot::{
        pkg_name: root_node.name,
        root_dir: root_node.dir,
        manifest_mode: true,
        manifest_dir: root_abs,
        pinned_pkg_dir: pkg_dir_abs,
        multi_pkg: true,
        dep_aliases: root_node.dep_aliases,
        deps: root_node.deps,
        root_imports: prep.root_imports,
        upstream_diags: prep.upstream_diags,
        base_rels: base_rels,
        base_paths: base_paths,
        base_sources: base_sources,
        base_parsed: base_parsed,
        test_rels: test_rels,
        test_paths: test_paths,
        test_sources: test_sources,
        test_parsed: Map([]),
      })
    }
    None => {
      if pkg_filter.length() > 0 {
        return Err("`--package` requires a `pion.toml` workspace/package target")
      }
      let loaded = match drv_load_targets(world, [target]) {
        Err(msg) => return Err(msg)
        Ok(v) => v
      }
      let rdir = if fs_is_dir(world, target) { target } else { drv_parent_dir(target) }
      let base_rels : Array[String] = []
      let mut i = 0
      while i < loaded.paths.length() {
        let rel = if rdir.length() > 0 {
          pkg_rebase_rel_path(rdir, loaded.paths[i])
        } else {
          loaded.paths[i]
        }
        base_rels.push(rel)
        i = i + 1
      }
      let test_paths : Array[String] = []
      let test_sources : Array[String] = []
      let test_rels : Array[String] = []
      if fs_is_dir(world, target) {
        match drv_append_test_sources_for(
          world,
          target,
          Map([]),
          active_target,
          test_paths,
          test_sources,
        ) {
          Err(msg) => return Err(msg)
          Ok(_) => ()
        }
        let mut ti = 0
        while ti < test_paths.length() {
          test_rels.push(pkg_rebase_rel_path(target, test_paths[ti]))
          ti = ti + 1
        }
      }
      let base_parsed : Map[String, ParseResult] = Map([])
      let mut pi = 0
      while pi < base_rels.length() {
        base_parsed.set(base_rels[pi], parse_source(loaded.paths[pi], loaded.sources[pi]))
        pi = pi + 1
      }
      Ok(DrvServerSnapshot::{
        pkg_name: loaded.pkg_name,
        root_dir: rdir,
        manifest_mode: false,
        manifest_dir: "",
        pinned_pkg_dir: "",
        multi_pkg: false,
        dep_aliases: [],
        deps: [],
        root_imports: [],
        upstream_diags: [],
        base_rels: base_rels,
        base_paths: loaded.paths,
        base_sources: loaded.sources,
        base_parsed: base_parsed,
        test_rels: test_rels,
        test_paths: test_paths,
        test_sources: test_sources,
        test_parsed: Map([]),
      })
    }
  }
}

///|
fn drv_merge_sort_strs(arr : Array[String]) -> Array[String] {
  let n = arr.length()
  if n <= 1 {
    return arr
  }
  let mid = n / 2
  let left : Array[String] = []
  let right : Array[String] = []
  let mut i = 0
  while i < mid {
    left.push(arr[i])
    i = i + 1
  }
  while i < n {
    right.push(arr[i])
    i = i + 1
  }
  let sl = drv_merge_sort_strs(left)
  let sr = drv_merge_sort_strs(right)
  let out : Array[String] = []
  let mut li = 0
  let mut ri = 0
  while li < sl.length() && ri < sr.length() {
    if drv_str_lt(sl[li], sr[ri]) {
      out.push(sl[li])
      li = li + 1
    } else {
      out.push(sr[ri])
      ri = ri + 1
    }
  }
  while li < sl.length() {
    out.push(sl[li])
    li = li + 1
  }
  while ri < sr.length() {
    out.push(sr[ri])
    ri = ri + 1
  }
  out
}

///|
fn drv_str_lt(a : String, b : String) -> Bool {
  let la = a.length()
  let lb = b.length()
  let n = if la < lb { la } else { lb }
  let mut i = 0
  while i < n {
    let ca = str_code_at(a, i)
    let cb = str_code_at(b, i)
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  la < lb
}

///|
fn drv_validate_server_rel_path(p : String) -> Result[Unit, String] {
  let n = p.length()
  if n == 0 {
    return Err("invalid path: empty path")
  }
  if str_code_at(p, 0) == 47 || str_code_at(p, n - 1) == 47 {
    return Err("invalid path `" + p + "`: must be root-relative without leading or trailing `/`")
  }
  if n >= 2 {
    let c0 = str_code_at(p, 0)
    let c1 = str_code_at(p, 1)
    if c1 == 58 && ((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)) {
      return Err("invalid path `" + p + "`: drive prefix not allowed")
    }
  }
  if n <= 5 || !drv_ends_with(p, ".pion") {
    return Err("invalid path `" + p + "`: must end with `.pion`")
  }
  let mut seg_start = 0
  let mut i = 0
  while i <= n {
    let is_sep = i == n || str_code_at(p, i) == 47
    if i < n {
      let c = str_code_at(p, i)
      if c == 92 {
        return Err("invalid path `" + p + "`: backslash not allowed")
      }
      if c == 0 {
        return Err("invalid path `" + p + "`: NUL byte not allowed")
      }
    }
    if is_sep {
      let slen = i - seg_start
      if slen == 0 {
        return Err("invalid path `" + p + "`: empty path segment")
      }
      if slen == 1 && str_code_at(p, seg_start) == 46 {
        return Err("invalid path `" + p + "`: `.` segment not allowed")
      }
      if slen == 2 && str_code_at(p, seg_start) == 46 && str_code_at(p, seg_start + 1) == 46 {
        return Err("invalid path `" + p + "`: `..` segment not allowed")
      }
      seg_start = i + 1
    }
    i = i + 1
  }
  Ok(())
}

///|
fn drv_jv_has_dup_key(v : DrvJv) -> Bool {
  match v {
    DjObj(keys, vals) => {
      let seen : Map[String, Bool] = Map([])
      let mut i = 0
      while i < keys.length() {
        if seen.contains(keys[i]) {
          return true
        }
        seen.set(keys[i], true)
        if drv_jv_has_dup_key(vals[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    DjArr(items) => {
      let mut i = 0
      while i < items.length() {
        if drv_jv_has_dup_key(items[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn drv_jv_id_raw(v : DrvJv) -> Result[String, String] {
  match v {
    DjStr(_, raw) => Ok(raw)
    DjNum(raw) => Ok(raw)
    DjBool(b) => Ok(if b { "true" } else { "false" })
    DjNull => Ok("null")
    _ => Err("`id` must be a JSON scalar (string, number, boolean, or null)")
  }
}

///|
fn drv_is_blank_line(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c != 32 && c != 9 && c != 13 && c != 10 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_server_proto_err(id_raw : String, msg : String) -> String {
  let sb = StringBuilder()
  sb.write_string("{")
  if id_raw.length() > 0 {
    sb.write_string("\"id\":")
    sb.write_string(id_raw)
    sb.write_string(",")
  }
  sb.write_string("\"ok\":false,\"protocol_error\":")
  sb.write_string(json_quote(msg))
  sb.write_string(",\"diagnostics\":[]}")
  sb.to_string()
}

///|
fn drv_run_query_types_cmd(
  world : World,
  target : String,
  pkg_filter : String,
  include_tests : Bool,
  locked : Bool,
  offline : Bool,
  active_target : String,
) -> Int {
  let snap = match drv_load_server_snapshot(
    world,
    target,
    pkg_filter,
    locked,
    offline,
    active_target,
    0,
    "",
    "",
  ) {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let parsed_files : Array[SourceFile] = []
  let parse_diags : Array[Diagnostic] = []
  let sources : Array[String] = []
  let rels : Array[String] = []
  let mut i = 0
  while i < snap.base_paths.length() {
    let r = snap.base_rels[i]
    let pr = match snap.base_parsed.get(r) {
      Some(cached) => cached
      None => parse_source(snap.base_paths[i], snap.base_sources[i])
    }
    parsed_files.push(pr.file)
    let mut di = 0
    while di < pr.diagnostics.length() {
      parse_diags.push(pr.diagnostics[di])
      di = di + 1
    }
    sources.push(snap.base_sources[i])
    rels.push(r)
    i = i + 1
  }
  if include_tests {
    let mut ti = 0
    while ti < snap.test_paths.length() {
      let pr = parse_source(snap.test_paths[ti], snap.test_sources[ti])
      parsed_files.push(pr.file)
      let mut di = 0
      while di < pr.diagnostics.length() {
        parse_diags.push(pr.diagnostics[di])
        di = di + 1
      }
      sources.push(snap.test_sources[ti])
      rels.push(snap.test_rels[ti])
      ti = ti + 1
    }
  }
  let cr = check_parsed_files_with_imports_types(
    snap.pkg_name,
    parsed_files,
    parse_diags,
    snap.root_imports,
    snap.dep_aliases,
    snap.deps,
    snap.multi_pkg,
    0,
    Map([]),
  )
  let all_diags : Array[Diagnostic] = []
  i = 0
  while i < snap.upstream_diags.length() {
    all_diags.push(snap.upstream_diags[i])
    i = i + 1
  }
  i = 0
  while i < cr.diagnostics.length() {
    all_diags.push(cr.diagnostics[i])
    i = i + 1
  }
  let json = query_types_response_json(cr.pkg, sources, rels, cr.tc, all_diags, 0, Map([]))
  io_println(world, json)
  if all_diags.length() > 0 {
    1
  } else {
    0
  }
}

///|
fn drv_run_check_server_cmd(
  world : World,
  target : String,
  pkg_filter : String,
  default_include_tests : Bool,
  locked : Bool,
  offline : Bool,
  active_target : String,
) -> Int {
  let mut snap = match drv_load_server_snapshot(
    world,
    target,
    pkg_filter,
    locked,
    offline,
    active_target,
    0,
    "",
    "",
  ) {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let max_frame_bytes = 67108864L
  let buf_slot = c_cli_malloc(8L)
  let len_slot = c_cli_malloc(8L)
  if ptr_is_null(buf_slot) || ptr_is_null(len_slot) {
    if !ptr_is_null(buf_slot) {
      ptr_free(buf_slot)
    }
    if !ptr_is_null(len_slot) {
      ptr_free(len_slot)
    }
    io_eprintln(world, "error: out of memory")
    return 1
  }

  let mut exit_code = 0
  while true {
    let status = c_cli_read_line_bounded(max_frame_bytes, buf_slot, len_slot)
    if status == 1 {
      exit_code = 0
      break
    }
    if status == 3 {
      io_eprintln(world, "error: failed to read stdin")
      exit_code = 1
      break
    }
    if status == 2 {
      if !drv_write_server_line(
        drv_server_proto_err("", "request exceeds 64 MiB limit"),
      ) {
        exit_code = 1
        break
      }
      continue
    }
    let line_len = ptr_read_i64(len_slot, 0L)
    let line_ptr = ptr_read_ptr(buf_slot, 0L)
    if line_len == 0L {
      if !ptr_is_null(line_ptr) {
        c_cli_free_buf(line_ptr)
      }
      continue
    }
    let line = cstr_to_str(line_ptr)
    c_cli_free_buf(line_ptr)
    if line.length().to_int64() != line_len {
      if !drv_write_server_line(
        drv_server_proto_err("", "invalid JSON: NUL byte in request"),
      ) {
        exit_code = 1
        break
      }
      continue
    }
    if drv_is_blank_line(line) {
      continue
    }
    let jv = match drv_json_parse(line) {
      Err(msg) => {
        if !drv_write_server_line(drv_server_proto_err("", "invalid JSON: " + msg)) {
          exit_code = 1
          break
        }
        continue
      }
      Ok(v) => v
    }
    let (keys, vals) = match jv {
      DjObj(ks, vs) => (ks, vs)
      _ => {
        if !drv_write_server_line(
          drv_server_proto_err("", "request must be a JSON object"),
        ) {
          exit_code = 1
          break
        }
        continue
      }
    }

    // Extract unique top-level `id` BEFORE recursive duplicate-key validation so
    // nested duplicate-key errors still echo the caller's `id`.
    let mut id_raw = ""
    let mut id_count = 0
    let mut id_idx = -1
    let mut idk = 0
    while idk < keys.length() {
      if keys[idk] == "id" {
        id_count = id_count + 1
        id_idx = idk
      }
      idk = idk + 1
    }
    if id_count == 1 && id_idx >= 0 {
      match drv_jv_id_raw(vals[id_idx]) {
        Ok(raw) => id_raw = raw
        Err(_) => ()
      }
    }
    if drv_jv_has_dup_key(jv) {
      if !drv_write_server_line(
        drv_server_proto_err(id_raw, "duplicate key in JSON object"),
      ) {
        exit_code = 1
        break
      }
      continue
    }

    let mut has_quit = false
    let mut quit_val = false
    let mut has_reload = false
    let mut reload_val = false
    let mut has_check_field = false
    let mut full_replace = false
    let mut include_tests = default_include_tests
    let mut include_types = false
    let mut filter_mode = 0
    let mut files_jv : Option[DrvJv] = None
    let mut removed_jv : Option[DrvJv] = None
    let mut filter_jv : Option[DrvJv] = None
    let mut req_err = ""

    // Extract `id` first so error responses for other invalid fields still echo `id`.
    let mut ki = 0
    while ki < keys.length() && req_err.length() == 0 {
      if keys[ki] == "id" {
        match drv_jv_id_raw(vals[ki]) {
          Ok(raw) => id_raw = raw
          Err(msg) => req_err = msg
        }
        break
      }
      ki = ki + 1
    }

    ki = 0
    while ki < keys.length() && req_err.length() == 0 {
      let k = keys[ki]
      let v = vals[ki]
      if k == "id" {
        ()
      } else if k == "quit" {
        match v {
          DjBool(b) => {
            has_quit = true
            quit_val = b
          }
          _ => req_err = "`quit` must be a boolean"
        }
      } else if k == "reload" {
        match v {
          DjBool(b) => {
            has_reload = true
            reload_val = b
          }
          _ => req_err = "`reload` must be a boolean"
        }
      } else if k == "files" {
        has_check_field = true
        files_jv = Some(v)
      } else if k == "removed" {
        has_check_field = true
        removed_jv = Some(v)
      } else if k == "full_replace" {
        has_check_field = true
        match v {
          DjBool(b) => full_replace = b
          _ => req_err = "`full_replace` must be a boolean"
        }
      } else if k == "include_tests" {
        has_check_field = true
        match v {
          DjBool(b) => include_tests = b
          _ => req_err = "`include_tests` must be a boolean"
        }
      } else if k == "include_types" {
        has_check_field = true
        match v {
          DjBool(b) => include_types = b
          _ => req_err = "`include_types` must be a boolean"
        }
      } else if k == "filter_files" {
        has_check_field = true
        filter_jv = Some(v)
      } else {
        req_err = "unknown request field `" + k + "`"
      }
      ki = ki + 1
    }

    if req_err.length() == 0 {
      if has_quit && (has_reload || has_check_field) {
        req_err = "`quit` cannot be combined with `reload` or check fields"
      } else if has_reload && has_check_field {
        req_err = "`reload` cannot be combined with check fields"
      }
    }
    if req_err.length() > 0 {
      if !drv_write_server_line(drv_server_proto_err(id_raw, req_err)) {
        exit_code = 1
        break
      }
      continue
    }

    if has_quit {
      if quit_val {
        let sb = StringBuilder()
        sb.write_string("{")
        if id_raw.length() > 0 {
          sb.write_string("\"id\":")
          sb.write_string(id_raw)
          sb.write_string(",")
        }
        sb.write_string("\"ok\":true,\"quit\":true}")
        if !drv_write_server_line(sb.to_string()) {
          exit_code = 1
        } else {
          exit_code = 0
        }
        break
      } else {
        if !drv_write_server_line(
          drv_server_proto_err(id_raw, "`quit` must be `true`"),
        ) {
          exit_code = 1
          break
        }
        continue
      }
    }

    if has_reload {
      if !reload_val {
        if !drv_write_server_line(
          drv_server_proto_err(id_raw, "`reload` must be `true`"),
        ) {
          exit_code = 1
          break
        }
        continue
      }
      match drv_load_server_snapshot(
        world,
        target,
        pkg_filter,
        locked,
        offline,
        active_target,
        if snap.manifest_mode { 1 } else { 2 },
        snap.manifest_dir,
        snap.pinned_pkg_dir,
      ) {
        Err(msg) => {
          // Atomic: retain previous `snap` intact on reload failure!
          if !drv_write_server_line(drv_server_proto_err(id_raw, "reload failed: " + msg)) {
            exit_code = 1
            break
          }
          continue
        }
        Ok(new_snap) => {
          snap = new_snap
          let sb = StringBuilder()
          sb.write_string("{")
          if id_raw.length() > 0 {
            sb.write_string("\"id\":")
            sb.write_string(id_raw)
            sb.write_string(",")
          }
          sb.write_string("\"ok\":")
          sb.write_string(if snap.upstream_diags.length() == 0 { "true" } else { "false" })
          sb.write_string(",\"reloaded\":true,\"diagnostics\":")
          sb.write_string(diagnostics_array_to_json(snap.upstream_diags))
          sb.write_string("}")
          if !drv_write_server_line(sb.to_string()) {
            exit_code = 1
            break
          }
          continue
        }
      }
    }

    // Parse and validate `files`, `removed`, `filter_files`
    let overlay_rels : Array[String] = []
    let overlay_srcs : Array[String] = []
    let overlay_set : Map[String, Bool] = Map([])
    let files_lower : Map[String, String] = Map([])
    match files_jv {
      Some(DjObj(fks, fvs)) => {
        let mut fi = 0
        while fi < fks.length() && req_err.length() == 0 {
          let rel = fks[fi]
          match drv_validate_server_rel_path(rel) {
            Err(m) => req_err = m
            Ok(_) => {
              let lrel = drv_ascii_lower(rel)
              match files_lower.get(lrel) {
                Some(prev) =>
                  req_err = "case-insensitive path collision in `files` between `" + prev + "` and `" + rel + "`"
                None =>
                  match fvs[fi] {
                    DjStr(src, _) => {
                      files_lower.set(lrel, rel)
                      overlay_rels.push(rel)
                      overlay_srcs.push(src)
                      overlay_set.set(rel, true)
                    }
                    _ => req_err = "`files[\"" + rel + "\"]` must be a string"
                  }
              }
            }
          }
          fi = fi + 1
        }
      }
      Some(_) => req_err = "`files` must be a JSON object mapping relative paths to strings"
      None => ()
    }

    let removed_set : Map[String, Bool] = Map([])
    let removed_list : Array[String] = []
    let removed_lower : Map[String, String] = Map([])
    if req_err.length() == 0 {
      match removed_jv {
        Some(DjArr(items)) => {
          let mut ri = 0
          while ri < items.length() && req_err.length() == 0 {
            match items[ri] {
              DjStr(rel, _) =>
                match drv_validate_server_rel_path(rel) {
                  Err(m) => req_err = m
                  Ok(_) => {
                    let lrel = drv_ascii_lower(rel)
                    if removed_set.contains(rel) {
                      req_err = "duplicate path in `removed`: `" + rel + "`"
                    } else if overlay_set.contains(rel) {
                      req_err = "path `" + rel + "` cannot appear in both `files` and `removed`"
                    } else {
                      match removed_lower.get(lrel) {
                        Some(prev) =>
                          req_err = "case-insensitive path collision in `removed` between `" + prev + "` and `" + rel + "`"
                        None =>
                          match files_lower.get(lrel) {
                            Some(prev) =>
                              req_err = "case-insensitive path collision between `files` (`" + prev + "`) and `removed` (`" + rel + "`)"
                            None => {
                              removed_lower.set(lrel, rel)
                              removed_set.set(rel, true)
                              removed_list.push(rel)
                            }
                          }
                      }
                    }
                  }
                }
              _ => req_err = "`removed` entries must be strings"
            }
            ri = ri + 1
          }
        }
        Some(_) => req_err = "`removed` must be an array of strings"
        None => ()
      }
    }

    let filter_rel_set : Map[String, Bool] = Map([])
    let filter_lower : Map[String, String] = Map([])
    let filter_list : Array[String] = []
    if req_err.length() == 0 {
      match filter_jv {
        Some(DjArr(items)) =>
          if items.length() == 0 {
            filter_mode = 1
          } else {
            filter_mode = 2
            let mut fi = 0
            while fi < items.length() && req_err.length() == 0 {
              match items[fi] {
                DjStr(rel, _) =>
                  match drv_validate_server_rel_path(rel) {
                    Err(m) => req_err = m
                    Ok(_) => {
                      let lrel = drv_ascii_lower(rel)
                      if filter_rel_set.contains(rel) {
                        req_err = "duplicate path in `filter_files`: `" + rel + "`"
                      } else {
                        match filter_lower.get(lrel) {
                          Some(prev) =>
                            req_err = "case-insensitive path collision in `filter_files` between `" + prev + "` and `" + rel + "`"
                          None =>
                            match files_lower.get(lrel) {
                              Some(prev) =>
                                if prev != rel {
                                  req_err = "case-insensitive path collision between `files` (`" + prev + "`) and `filter_files` (`" + rel + "`)"
                                } else {
                                  filter_lower.set(lrel, rel)
                                  filter_rel_set.set(rel, true)
                                  filter_list.push(rel)
                                }
                              None =>
                                match removed_lower.get(lrel) {
                                  Some(prev) =>
                                    if prev != rel {
                                      req_err = "case-insensitive path collision between `removed` (`" + prev + "`) and `filter_files` (`" + rel + "`)"
                                    } else {
                                      filter_lower.set(lrel, rel)
                                      filter_rel_set.set(rel, true)
                                      filter_list.push(rel)
                                    }
                                  None => {
                                    filter_lower.set(lrel, rel)
                                    filter_rel_set.set(rel, true)
                                    filter_list.push(rel)
                                  }
                                }
                            }
                        }
                      }
                    }
                  }
                _ => req_err = "`filter_files` entries must be strings"
              }
              fi = fi + 1
            }
          }
        Some(_) => req_err = "`filter_files` must be an array of strings"
        None => filter_mode = 0
      }
    }

    // Build stateless active file map in O(F)
    let file_src : Map[String, String] = Map([])
    let file_path : Map[String, String] = Map([])
    let active_rels : Array[String] = []
    if req_err.length() == 0 {
      if !full_replace {
        let mut bi = 0
        while bi < snap.base_rels.length() {
          let r = snap.base_rels[bi]
          file_src.set(r, snap.base_sources[bi])
          file_path.set(r, snap.base_paths[bi])
          bi = bi + 1
        }
        if include_tests {
          let mut ti = 0
          while ti < snap.test_rels.length() {
            let r = snap.test_rels[ti]
            file_src.set(r, snap.test_sources[ti])
            file_path.set(r, snap.test_paths[ti])
            ti = ti + 1
          }
        }
      }
      // Validate every `removed` entry exists in baseline
      let mut ri = 0
      while ri < removed_list.length() && req_err.length() == 0 {
        let r = removed_list[ri]
        if !file_src.contains(r) {
          req_err = "`removed` path `" + r + "` does not exist in package"
        } else {
          file_src.remove(r)
          file_path.remove(r)
        }
        ri = ri + 1
      }
      // Apply `files` overlay
      if req_err.length() == 0 {
        let mut oi = 0
        while oi < overlay_rels.length() {
          let r = overlay_rels[oi]
          file_src.set(r, overlay_srcs[oi])
          if !file_path.contains(r) {
            let full_p = if snap.root_dir.length() > 0 {
              drv_join_path(snap.root_dir, r)
            } else {
              r
            }
            file_path.set(r, full_p)
          }
          oi = oi + 1
        }
      }
      // Collect active keys & check macOS case-insensitive collision
      if req_err.length() == 0 {
        let seen_rel : Map[String, Bool] = Map([])
        if !full_replace {
          let mut bi = 0
          while bi < snap.base_rels.length() {
            let r = snap.base_rels[bi]
            if file_src.contains(r) && !seen_rel.contains(r) {
              seen_rel.set(r, true)
              active_rels.push(r)
            }
            bi = bi + 1
          }
          if include_tests {
            let mut ti = 0
            while ti < snap.test_rels.length() {
              let r = snap.test_rels[ti]
              if file_src.contains(r) && !seen_rel.contains(r) {
                seen_rel.set(r, true)
                active_rels.push(r)
              }
              ti = ti + 1
            }
          }
        }
        let mut oi = 0
        while oi < overlay_rels.length() {
          let r = overlay_rels[oi]
          if file_src.contains(r) && !seen_rel.contains(r) {
            seen_rel.set(r, true)
            active_rels.push(r)
          }
          oi = oi + 1
        }
        let lower_map : Map[String, String] = Map([])
        let mut ai = 0
        while ai < active_rels.length() {
          let r = active_rels[ai]
          let lr = drv_ascii_lower(r)
          match lower_map.get(lr) {
            Some(prev) => {
              req_err = "case-insensitive path collision between `" + prev + "` and `" + r + "`"
              break
            }
            None => lower_map.set(lr, r)
          }
          ai = ai + 1
        }
        if req_err.length() == 0 && filter_mode == 2 {
          let mut fli = 0
          while fli < filter_list.length() {
            let fr = filter_list[fli]
            let lfr = drv_ascii_lower(fr)
            match lower_map.get(lfr) {
              Some(active_r) =>
                if active_r != fr {
                  req_err = "case-insensitive path collision between active file `" + active_r + "` and `filter_files` (`" + fr + "`)"
                  break
                }
              None => ()
            }
            fli = fli + 1
          }
        }
      }
    }

    if req_err.length() > 0 {
      if !drv_write_server_line(drv_server_proto_err(id_raw, req_err)) {
        exit_code = 1
        break
      }
      continue
    }

    let sorted_rels = drv_merge_sort_strs(active_rels)
    let check_sources : Array[String] = []
    let parsed_files : Array[SourceFile] = []
    let parse_diags : Array[Diagnostic] = []
    let qt_filter_paths : Map[String, Bool] = Map([])
    let mut si = 0
    while si < sorted_rels.length() {
      let r = sorted_rels[si]
      let p = match file_path.get(r) {
        Some(v) => v
        None => r
      }
      let s = match file_src.get(r) {
        Some(v) => v
        None => ""
      }
      check_sources.push(s)
      let pr = if !overlay_set.contains(r) {
        match snap.base_parsed.get(r) {
          Some(cached) => cached
          None =>
            match snap.test_parsed.get(r) {
              Some(cached_t) => cached_t
              None => {
                let fresh = parse_source(p, s)
                snap.test_parsed.set(r, fresh)
                fresh
              }
            }
        }
      } else {
        parse_source(p, s)
      }
      let mut pdi = 0
      while pdi < pr.diagnostics.length() {
        parse_diags.push(pr.diagnostics[pdi])
        pdi = pdi + 1
      }
      parsed_files.push(pr.file)
      if filter_mode == 2 && filter_rel_set.contains(r) {
        qt_filter_paths.set(p, true)
      }
      si = si + 1
    }

    let cr = if include_types {
      check_parsed_files_with_imports_types(
        snap.pkg_name,
        parsed_files,
        parse_diags,
        snap.root_imports,
        snap.dep_aliases,
        snap.deps,
        snap.multi_pkg,
        filter_mode,
        qt_filter_paths,
      )
    } else {
      check_parsed_files_with_imports_mapped(
        snap.pkg_name,
        parsed_files,
        parse_diags,
        snap.root_imports,
        snap.dep_aliases,
        snap.deps,
        snap.multi_pkg,
        false,
      )
    }

    let all_diags : Array[Diagnostic] = []
    let mut di = 0
    while di < snap.upstream_diags.length() {
      all_diags.push(snap.upstream_diags[di])
      di = di + 1
    }
    di = 0
    while di < cr.diagnostics.length() {
      all_diags.push(cr.diagnostics[di])
      di = di + 1
    }

    let sb = StringBuilder()
    sb.write_string("{")
    if id_raw.length() > 0 {
      sb.write_string("\"id\":")
      sb.write_string(id_raw)
      sb.write_string(",")
    }
    sb.write_string("\"ok\":")
    sb.write_string(if all_diags.length() == 0 { "true" } else { "false" })
    sb.write_string(",\"diagnostics\":")
    sb.write_string(diagnostics_array_to_json(all_diags))
    if include_types {
      sb.write_string(",\"types\":")
      query_types_files_json_into(
        sb,
        cr.pkg,
        check_sources,
        sorted_rels,
        cr.tc,
        filter_mode,
        qt_filter_paths,
      )
    }
    sb.write_string("}")
    if !drv_write_server_line(sb.to_string()) {
      exit_code = 1
      break
    }
  }

  ptr_free(buf_slot)
  ptr_free(len_slot)
  exit_code
}
