///| Pure Pion native compiler driver (zero MoonBit runtime dependency)

///|
struct DrvLoaded {
  pkg_name : String
  paths : Array[String]
  sources : Array[String]
}

///|
struct AppleTools {
  ok : Bool
  clang_bin : String
  ld_bin : String
  sdk_path : String
  macos_ver : String
}

///|
fn drv_starts_with(s : String, pre : String) -> Bool {
  let sl = s.length()
  let pl = pre.length()
  if sl < pl {
    return false
  }
  let mut i = 0
  while i < pl {
    if str_code_at(s, i) != str_code_at(pre, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_find_substr(s : String, needle : String, start : Int) -> Int {
  let sl = s.length()
  let nl = needle.length()
  if nl == 0 || start + nl > sl {
    return -1
  }
  let mut i = start
  while i + nl <= sl {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if str_code_at(s, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn drv_parse_macos_ver_from_plist(plist : String) -> String {
  let kpos = drv_find_substr(plist, "<key>ProductVersion</key>", 0)
  if kpos < 0 {
    return "15.0"
  }
  let spos = drv_find_substr(plist, "<string>", kpos + 25)
  if spos < 0 {
    return "15.0"
  }
  let vstart = spos + 8
  let vend = drv_find_substr(plist, "</string>", vstart)
  if vend <= vstart {
    return "15.0"
  }
  let sb = StringBuilder()
  let mut dots = 0
  let mut i = vstart
  while i < vend {
    let c = str_code_at(plist, i)
    if c == 46 {
      dots = dots + 1
      if dots >= 2 {
        break
      }
      sb.write_char('.')
    } else if c >= 48 && c <= 57 {
      sb.write_char(c.unsafe_to_char())
    } else {
      break
    }
    i = i + 1
  }
  let v = sb.to_string()
  if v.length() == 0 {
    "15.0"
  } else if dots == 0 {
    v + ".0"
  } else {
    v
  }
}

///|
/// Pure filesystem probe (0 subprocesses, <0.2ms) for real clang (-cc1as), ld, and MacOSX.sdk
/// on macOS arm64_apple when CC is not overridden.
fn drv_probe_apple_tools(world : World, qbe_target : String) -> AppleTools {
  let empty = AppleTools::{
    ok: false,
    clang_bin: "",
    ld_bin: "",
    sdk_path: "",
    macos_ver: "",
  }
  if qbe_target != "arm64_apple" {
    return empty
  }
  if drv_env_str(world, "CC").length() > 0 {
    return empty
  }
  let mut clang_bin = ""
  let mut ld_bin = ""
  let mut sdk_path = ""

  let clt_c = "/Library/Developer/CommandLineTools/usr/bin/clang"
  let clt_l = "/Library/Developer/CommandLineTools/usr/bin/ld"
  let clt_s = "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk"
  if fs_exists(world, clt_c) && fs_exists(world, clt_l) && fs_exists(world, clt_s) {
    clang_bin = clt_c
    ld_bin = clt_l
    sdk_path = clt_s
  } else if fs_is_dir(world, "/Applications") {
    let apps = fs_list_dir(world, "/Applications")
    let mut i = 0
    while i < apps.length() {
      let name = apps[i]
      if drv_starts_with(name, "Xcode") && drv_ends_with(name, ".app") {
        let dev = "/Applications/" + name + "/Contents/Developer"
        let xc_c = dev + "/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang"
        let xc_l = dev + "/Toolchains/XcodeDefault.xctoolchain/usr/bin/ld"
        let xc_s = dev + "/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk"
        if fs_exists(world, xc_c) && fs_exists(world, xc_l) && fs_exists(world, xc_s) {
          clang_bin = xc_c
          ld_bin = xc_l
          sdk_path = xc_s
          break
        }
      }
      i = i + 1
    }
  }
  if clang_bin == "" {
    return empty
  }
  let macos_ver = match fs_read(world, "/System/Library/CoreServices/SystemVersion.plist") {
    Ok(txt) => drv_parse_macos_ver_from_plist(txt)
    Err(_) => "15.0"
  }
  AppleTools::{
    ok: true,
    clang_bin: clang_bin,
    ld_bin: ld_bin,
    sdk_path: sdk_path,
    macos_ver: macos_ver,
  }
}

///|
fn drv_ends_with(s : String, suf : String) -> Bool {
  let sl = s.length()
  let sufl = suf.length()
  if sl < sufl {
    return false
  }
  let off = sl - sufl
  let mut i = 0
  while i < sufl {
    if str_code_at(s, off + i) != str_code_at(suf, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn drv_is_source_file(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  if str_code_at(name, 0) == 46 {
    return false
  }
  let is_src = drv_ends_with(name, ".pion")
  let is_test = drv_ends_with(name, "_test.pion")
  is_src && !is_test
}

///|
fn drv_is_test_source_file(name : String) -> Bool {
  name.length() > 0 &&
  str_code_at(name, 0) != 46 &&
  drv_ends_with(name, "_test.pion")
}

///|
/// Appends the package's `*_test.pion` files (in `dir` and `dir/src`), which only
/// `pionc test` compiles.
fn drv_append_test_sources(
  world : World,
  dir : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[Unit, String] {
  let dirs : Array[String] = [dir]
  let src_dir = drv_join_path(dir, "src")
  if fs_is_dir(world, src_dir) {
    dirs.push(src_dir)
  }
  let mut di = 0
  while di < dirs.length() {
    let entries = fs_list_dir(world, dirs[di])
    let mut i = 0
    while i < entries.length() {
      if drv_is_test_source_file(entries[i]) {
        let fpath = drv_join_path(dirs[di], entries[i])
        match fs_read(world, fpath) {
          Err(msg) => return Err("failed to read " + fpath + ": " + msg)
          Ok(content) => {
            paths.push(fpath)
            sources.push(content)
          }
        }
      }
      i = i + 1
    }
    di = di + 1
  }
  Ok(())
}

///|
fn drv_is_path_sep(ch : Int) -> Bool {
  ch == 47 || ch == 92
}

///|
fn drv_join_path(dir : String, name : String) -> String {
  if dir.length() == 0 {
    return name
  }
  if drv_is_path_sep(str_code_at(dir, dir.length() - 1)) {
    dir + name
  } else {
    dir + "/" + name
  }
}

///|
fn drv_parent_dir(path : String) -> String {
  let mut idx = path.length() - 1
  while idx >= 0 && !drv_is_path_sep(str_code_at(path, idx)) {
    idx = idx - 1
  }
  if idx <= 0 {
    return ""
  }
  let sb = StringBuilder()
  let mut i = 0
  while i < idx {
    sb.write_char(str_code_at(path, i).unsafe_to_char())
    i = i + 1
  }
  sb.to_string()
}

///|
fn drv_ensure_parent_dir(world : World, path : String) -> Unit {
  let dir = drv_parent_dir(path)
  if dir.length() > 0 {
    let _ = fs_mkdir_p(world, dir)
  }
}

///|
fn drv_basename_pkg(path : String) -> String {
  let mut end = path.length()
  while end > 1 && drv_is_path_sep(str_code_at(path, end - 1)) {
    end = end - 1
  }
  let mut start = end - 1
  while start >= 0 && !drv_is_path_sep(str_code_at(path, start)) {
    start = start - 1
  }
  let sb = StringBuilder()
  let mut i = start + 1
  while i < end {
    let ch = str_code_at(path, i)
    if ch == 46 {
      break
    }
    sb.write_char(ch.unsafe_to_char())
    i = i + 1
  }
  let name = sb.to_string()
  if name.length() == 0 {
    "main"
  } else {
    name
  }
}

///|
fn drv_prefix16(s : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < 16 && i < s.length() {
    sb.write_char(str_code_at(s, i).unsafe_to_char())
    i = i + 1
  }
  sb.to_string()
}

///|
fn drv_parse_pos_int64(s : String, fallback : Int64) -> Int64 {
  if s.length() == 0 {
    return fallback
  }
  let mut acc = 0L
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c >= 48 && c <= 57 {
      acc = acc * 10L + (c - 48).to_int64()
    } else {
      return fallback
    }
    i = i + 1
  }
  if acc > 0L {
    acc
  } else {
    fallback
  }
}

///|
fn drv_parse_pos_int(s : String, fallback : Int) -> Int {
  let v = drv_parse_pos_int64(s, fallback.to_int64()).to_int()
  if v > 0 {
    v
  } else {
    fallback
  }
}

///|
fn drv_env_str(world : World, name : String) -> String {
  match env_get(world, name) {
    Some(v) => v
    None => ""
  }
}

///|
fn drv_temp_dir(world : World) -> String {
  let t1 = drv_env_str(world, "TEMP")
  if t1.length() > 0 {
    return t1
  }
  let t2 = drv_env_str(world, "TMP")
  if t2.length() > 0 {
    return t2
  }
  if drv_env_str(world, "OS") == "Windows_NT" {
    "."
  } else {
    "/tmp"
  }
}

///|
fn drv_resolve_cache_dir(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  if custom.length() > 0 {
    return custom
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    drv_join_path(home, ".cache/pion/cas")
  } else {
    drv_join_path(drv_temp_dir(world), "pion-cas")
  }
}

///|
fn drv_resolve_cache_max_bytes(world : World) -> Int64 {
  let kb_s = drv_env_str(world, "PION_CACHE_MAX_KB")
  if kb_s.length() > 0 {
    return drv_parse_pos_int64(kb_s, 1024L) * 1024L
  }
  let mb_s = drv_env_str(world, "PION_CACHE_MAX_MB")
  drv_parse_pos_int64(mb_s, 2048L) * 1024L * 1024L
}

///|
fn drv_has_path_sep(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if drv_is_path_sep(str_code_at(s, i)) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_self_exe_path(world : World) -> String {
  let args = world_args(world)
  if args.length() == 0 {
    return ""
  }
  let a0 = args[0]
  if a0.length() == 0 {
    return ""
  }
  if drv_has_path_sep(a0) {
    return a0
  }
  let found = drv_find_in_path(world, a0)
  if found.length() > 0 {
    return found
  }
  if drv_env_str(world, "OS") == "Windows_NT" &&
    !drv_ends_with(a0, ".exe") &&
    !drv_ends_with(a0, ".EXE") {
    let found_exe = drv_find_in_path(world, a0 + ".exe")
    if found_exe.length() > 0 {
      return found_exe
    }
  }
  a0
}

///|
fn drv_self_exe_dir(world : World) -> String {
  let p = drv_self_exe_path(world)
  if p.length() == 0 || !drv_has_path_sep(p) {
    return ""
  }
  drv_parent_dir(p)
}

///|
fn drv_parent_rel(dir : String, rel : String) -> String {
  let pd = drv_parent_dir(dir)
  if pd.length() > 0 {
    drv_join_path(pd, rel)
  } else {
    drv_join_path(dir, "../" + rel)
  }
}

///|
fn drv_resolve_qbe_bin(world : World) -> String {
  let env_qbe = drv_env_str(world, "PION_QBE")
  if env_qbe.length() > 0 {
    return env_qbe
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let e1 = drv_join_path(exe_dir, "qbe")
    if fs_exists(world, e1) {
      return e1
    }
    let e2 = drv_join_path(exe_dir, "qbe.exe")
    if fs_exists(world, e2) {
      return e2
    }
    let e3 = drv_parent_rel(exe_dir, "libexec/pion/qbe")
    if fs_exists(world, e3) {
      return e3
    }
    let e4 = drv_parent_rel(exe_dir, "libexec/pion/qbe.exe")
    if fs_exists(world, e4) {
      return e4
    }
  }
  if fs_exists(world, "out/qbe") {
    return "out/qbe"
  }
  if fs_exists(world, "out/qbe.exe") {
    return "out/qbe.exe"
  }
  if fs_exists(world, "../out/qbe") {
    return "../out/qbe"
  }
  if fs_exists(world, "../out/qbe.exe") {
    return "../out/qbe.exe"
  }
  "qbe"
}

///|
fn drv_find_pion_rt_c(world : World) -> String {
  let env_src = drv_env_str(world, "PION_SRC")
  if env_src.length() > 0 {
    let c0 = drv_join_path(env_src, "runtime/pion_rt.c")
    if fs_exists(world, c0) {
      return c0
    }
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let c1 = drv_parent_rel(exe_dir, "share/pion/runtime/pion_rt.c")
    if fs_exists(world, c1) {
      return c1
    }
    let c2 = drv_parent_rel(exe_dir, "runtime/pion_rt.c")
    if fs_exists(world, c2) {
      return c2
    }
  }
  if fs_exists(world, "runtime/pion_rt.c") {
    return "runtime/pion_rt.c"
  }
  if fs_exists(world, "../runtime/pion_rt.c") {
    return "../runtime/pion_rt.c"
  }
  ""
}

///|
fn drv_ensure_msvc_rt_obj(world : World, cc_bin : String) -> Option[String] {
  let rt_c = drv_find_pion_rt_c(world)
  if rt_c.length() == 0 {
    return None
  }
  let c_txt = match fs_read(world, rt_c) {
    Ok(t) => t
    Err(_) => return None
  }
  let c_hash = sha256_hex(c_txt)
  let rt_h = drv_join_path(drv_parent_dir(rt_c), "pion_rt.h")
  let h_hash = if fs_exists(world, rt_h) {
    match fs_read(world, rt_h) {
      Ok(t) => sha256_hex(t)
      Err(_) => ""
    }
  } else {
    ""
  }
  let key = sha256_hex("pion-rt-msvc-v1|" + cc_bin + "|" + c_hash + "|" + h_hash)
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let obj_path = cache_dir + "/obj/pion_rt_msvc_" + key + ".o"
  if fs_exists(world, obj_path) {
    return Some(obj_path)
  }
  let stamp = clock_now_ms(world).to_string()
  let obj_tmp = obj_path + ".tmp." + stamp
  let argv : Array[String] = [
    cc_bin,
    "-std=c11",
    "-O2",
    "-fno-asynchronous-unwind-tables",
    "-D_CRT_SECURE_NO_WARNINGS",
    "-c",
    rt_c,
    "-o",
    obj_tmp,
  ]
  let rc = proc_exec(world, argv)
  if rc != 0 {
    let _ = fs_remove(world, obj_tmp)
    return None
  }
  let _ = fs_rename(world, obj_tmp, obj_path)
  let sz = fs_size(world, obj_path)
  drv_cas_record_and_evict(
    world,
    cache_dir,
    "pion_rt_msvc_" + key,
    if sz > 0L { sz } else { 0L },
  )
  Some(obj_path)
}

///|
fn drv_resolve_rt_lib(world : World, qbe_target : String) -> String {
  let env_rt = drv_env_str(world, "PION_RT_LIB")
  if env_rt.length() > 0 {
    return env_rt
  }
  if drv_target_is_windows(qbe_target) {
    let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
    if drv_is_windows_msvc_cc(world, qbe_target, cc_bin) {
      match drv_ensure_msvc_rt_obj(world, cc_bin) {
        Some(obj_path) => return obj_path
        None => ()
      }
    }
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let r1 = drv_parent_rel(exe_dir, "lib/libpionrt.a")
    if fs_exists(world, r1) {
      return r1
    }
    let r2 = drv_join_path(exe_dir, "libpionrt.a")
    if fs_exists(world, r2) {
      return r2
    }
  }
  if fs_exists(world, "out/libpionrt.a") {
    return "out/libpionrt.a"
  }
  if fs_exists(world, "../out/libpionrt.a") {
    return "../out/libpionrt.a"
  }
  "out/libpionrt.a"
}

///|
fn drv_target_is_valid(t : String) -> Bool {
  t == "arm64_apple" ||
  t == "amd64_apple" ||
  t == "amd64_sysv" ||
  t == "amd64_win" ||
  t == "arm64" ||
  t == "rv64" ||
  t == "ios_arm64" ||
  t == "ios_sim_arm64" ||
  t == "android_arm64" ||
  t == "android_x64" ||
  t == "wasm32"
}

///|
fn drv_target_qbe_arch(t : String) -> String {
  if t == "ios_arm64" || t == "ios_sim_arm64" {
    "arm64_apple"
  } else if t == "android_arm64" {
    "arm64"
  } else if t == "android_x64" {
    "amd64_sysv"
  } else {
    t
  }
}

///|
fn drv_target_os(t : String) -> String {
  if t == "arm64_apple" || t == "amd64_apple" {
    "macos"
  } else if t == "ios_arm64" || t == "ios_sim_arm64" {
    "ios"
  } else if t == "android_arm64" || t == "android_x64" {
    "android"
  } else if t == "amd64_win" {
    "windows"
  } else if t == "wasm32" {
    "wasm"
  } else {
    "linux"
  }
}

///|
fn drv_target_is_wasm(t : String) -> Bool {
  t == "wasm32"
}

///|
fn drv_resolve_wasm_rt(world : World) -> String {
  let env_rt = drv_env_str(world, "PION_WASM_RT")
  if env_rt.length() > 0 && fs_exists(world, env_rt) {
    return env_rt
  }
  let exe_dir = drv_self_exe_dir(world)
  if exe_dir.length() > 0 {
    let c0 = drv_parent_rel(exe_dir, "share/pion/pion_wasm_rt.mjs")
    if fs_exists(world, c0) {
      return c0
    }
    let c1 = drv_parent_rel(exe_dir, "runtime/pion_wasm_rt.mjs")
    if fs_exists(world, c1) {
      return c1
    }
    let c2 = drv_join_path(exe_dir, "pion_wasm_rt.mjs")
    if fs_exists(world, c2) {
      return c2
    }
    let c3 = drv_join_path(exe_dir, "runtime/pion_wasm_rt.mjs")
    if fs_exists(world, c3) {
      return c3
    }
  }
  if fs_exists(world, "runtime/pion_wasm_rt.mjs") {
    return "runtime/pion_wasm_rt.mjs"
  }
  "runtime/pion_wasm_rt.mjs"
}

///|
fn drv_target_is_apple(t : String) -> Bool {
  let os = drv_target_os(t)
  os == "macos" || os == "ios"
}

///|
fn drv_target_is_linux(t : String) -> Bool {
  drv_target_os(t) == "linux"
}

///|
fn drv_target_is_ios(t : String) -> Bool {
  drv_target_os(t) == "ios"
}

///|
fn drv_target_is_android(t : String) -> Bool {
  drv_target_os(t) == "android"
}

///|
fn drv_target_is_windows(t : String) -> Bool {
  drv_target_os(t) == "windows"
}

///|
fn drv_resolve_ios_sdk(
  world : World,
  qbe_target : String,
  sysroot : String,
) -> String {
  if sysroot.length() > 0 {
    return sysroot
  }
  let sdk_name = if qbe_target == "ios_sim_arm64" {
    "iphonesimulator"
  } else {
    "iphoneos"
  }
  match proc_exec_capture(world, ["xcrun", "--sdk", sdk_name, "--show-sdk-path"]) {
    Ok(out) => drv_trim_ws(out)
    Err(_) => ""
  }
}

///|
fn drv_resolve_android_ndk_tool(
  world : World,
  qbe_target : String,
  is_cxx : Bool,
) -> String {
  let ndk = drv_env_str(world, "ANDROID_NDK_HOME")
  if ndk.length() == 0 {
    return ""
  }
  let triple = if qbe_target == "android_x64" {
    "x86_64-linux-android24"
  } else {
    "aarch64-linux-android24"
  }
  let tool = if is_cxx { triple + "-clang++" } else { triple + "-clang" }
  let hosts : Array[String] = ["darwin-x86_64", "linux-x86_64", "darwin-arm64"]
  let mut i = 0
  while i < hosts.length() {
    let cand = ndk + "/toolchains/llvm/prebuilt/" + hosts[i] + "/bin/" + tool
    if fs_exists(world, cand) {
      return cand
    }
    i = i + 1
  }
  ""
}

///|
fn drv_win_translate_msvc_flags(
  flags : Array[String],
  is_cdylib : Bool,
) -> Array[String] {
  win_translate_msvc_flags(flags, is_cdylib)
}

///|
fn drv_is_windows_msvc_cc(
  world : World,
  qbe_target : String,
  cc_bin : String,
) -> Bool {
  if !drv_target_is_windows(qbe_target) {
    return false
  }
  let abi = drv_env_str(world, "PION_WIN_ABI")
  if abi == "msvc" {
    return true
  }
  if abi == "mingw" || abi == "gnu" {
    return false
  }
  if drv_ends_with(cc_bin, "clang-cl") ||
    drv_ends_with(cc_bin, "clang-cl.exe") ||
    drv_ends_with(cc_bin, "clang-cl.EXE") {
    return true
  }
  match proc_exec_capture(world, [cc_bin, "-dumpmachine"]) {
    Ok(out) =>
      drv_find_substr(out, "msvc", 0) >= 0 ||
      drv_find_substr(out, "MSVC", 0) >= 0
    Err(_) => false
  }
}

///|
fn drv_resolve_cc_driver(
  world : World,
  qbe_target : String,
  is_cxx : Bool,
) -> String {
  if drv_target_is_android(qbe_target) {
    let env_name = if is_cxx { "PION_ANDROID_CXX" } else { "PION_ANDROID_CC" }
    let env_a = drv_env_str(world, env_name)
    if env_a.length() > 0 {
      return env_a
    }
    let ndk_tool = drv_resolve_android_ndk_tool(world, qbe_target, is_cxx)
    if ndk_tool.length() > 0 {
      return ndk_tool
    }
  }
  if is_cxx {
    let e = drv_env_str(world, "CXX")
    if e.length() > 0 {
      e
    } else if drv_target_is_windows(qbe_target) {
      let derived = win_derive_cxx_from_cc(drv_env_str(world, "CC"))
      if derived.length() > 0 {
        derived
      } else {
        "g++"
      }
    } else {
      "c++"
    }
  } else {
    let e = drv_env_str(world, "CC")
    if e.length() > 0 {
      e
    } else if drv_target_is_windows(qbe_target) {
      "gcc"
    } else {
      "cc"
    }
  }
}

///|
fn drv_target_cc_flags(
  world : World,
  qbe_target : String,
  sysroot : String,
) -> Array[String] {
  let flags : Array[String] = []
  if qbe_target == "amd64_apple" {
    flags.push("-arch")
    flags.push("x86_64")
    if sysroot.length() > 0 {
      flags.push("-isysroot")
      flags.push(sysroot)
    }
  } else if qbe_target == "arm64_apple" {
    if sysroot.length() > 0 {
      flags.push("-isysroot")
      flags.push(sysroot)
    }
  } else if qbe_target == "ios_arm64" {
    flags.push("-arch")
    flags.push("arm64")
    flags.push("-miphoneos-version-min=15.0")
    let sdk = drv_resolve_ios_sdk(world, qbe_target, sysroot)
    if sdk.length() > 0 {
      flags.push("-isysroot")
      flags.push(sdk)
    }
  } else if qbe_target == "ios_sim_arm64" {
    flags.push("-arch")
    flags.push("arm64")
    flags.push("-mios-simulator-version-min=15.0")
    let sdk = drv_resolve_ios_sdk(world, qbe_target, sysroot)
    if sdk.length() > 0 {
      flags.push("-isysroot")
      flags.push(sdk)
    }
  } else if qbe_target == "android_arm64" {
    flags.push("--target=aarch64-linux-android24")
    if sysroot.length() > 0 {
      flags.push("--sysroot=" + sysroot)
    }
  } else if qbe_target == "android_x64" {
    flags.push("--target=x86_64-linux-android24")
    if sysroot.length() > 0 {
      flags.push("--sysroot=" + sysroot)
    }
  } else if sysroot.length() > 0 {
    flags.push("--sysroot=" + sysroot)
  }
  flags
}

///|
fn drv_assemble_file(
  world : World,
  qbe_target : String,
  apple_tools : AppleTools,
  cc1as_triple : String,
  sysroot : String,
  asm_path : String,
  obj_tmp : String,
) -> Int {
  if apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0 {
    proc_exec(
      world,
      [
        apple_tools.clang_bin,
        "-cc1as",
        "-triple",
        cc1as_triple,
        "-filetype",
        "obj",
        "-o",
        obj_tmp,
        asm_path,
      ],
    )
  } else {
    let driver = drv_resolve_cc_driver(world, qbe_target, false)
    let argv : Array[String] = [driver]
    let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
    let mut fi = 0
    while fi < tflags.length() {
      argv.push(tflags[fi])
      fi = fi + 1
    }
    argv.push("-c")
    argv.push("-x")
    argv.push("assembler")
    argv.push("-o")
    argv.push(obj_tmp)
    argv.push(asm_path)
    proc_exec(world, argv)
  }
}

///|
fn drv_resolve_qbe_target(world : World) -> String {
  let env_t = drv_env_str(world, "PION_TARGET")
  if env_t.length() > 0 {
    return env_t
  }
  if drv_env_str(world, "OS") == "Windows_NT" {
    return "amd64_win"
  }
  match proc_exec_capture(world, ["uname", "-sm"]) {
    Ok(raw) => {
      let info = drv_trim_ws(raw)
      if drv_find_substr(info, "MINGW", 0) >= 0 ||
        drv_find_substr(info, "MSYS", 0) >= 0 ||
        drv_find_substr(info, "CYGWIN", 0) >= 0 {
        return "amd64_win"
      } else if drv_find_substr(info, "Darwin", 0) >= 0 {
        if drv_find_substr(info, "x86_64", 0) >= 0 {
          return "amd64_apple"
        } else {
          return "arm64_apple"
        }
      } else if drv_find_substr(info, "Linux", 0) >= 0 {
        if drv_find_substr(info, "aarch64", 0) >= 0 ||
          drv_find_substr(info, "arm64", 0) >= 0 {
          return "arm64"
        } else if drv_find_substr(info, "riscv64", 0) >= 0 {
          return "rv64"
        } else {
          return "amd64_sysv"
        }
      }
    }
    Err(_) => ()
  }
  if fs_exists(world, "/System/Library") {
    "arm64_apple"
  } else {
    "amd64_sysv"
  }
}

///|
fn drv_write_text_atomic(world : World, path : String, content : String) -> Bool {
  let tmp = path + ".tmp." + clock_now_ms(world).to_string()
  match fs_write(world, tmp, content) {
    Err(_) => return false
    Ok(_) => ()
  }
  fs_rename(world, tmp, path)
}

///|
fn drv_load_targets(
  world : World,
  targets : Array[String],
) -> Result[DrvLoaded, String] {
  if targets.length() == 0 {
    return Err("no input files specified")
  }
  let pkg_name = drv_basename_pkg(targets[0])
  let paths : Array[String] = []
  let sources : Array[String] = []
  let mut t = 0
  while t < targets.length() {
    let target = targets[t]
    if !fs_exists(world, target) {
      return Err("path does not exist: " + target)
    }
    if fs_is_dir(world, target) {
      let entries = fs_list_dir(world, target)
      let mut i = 0
      while i < entries.length() {
        let name = entries[i]
        if drv_is_source_file(name) {
          let fpath = drv_join_path(target, name)
          match fs_read(world, fpath) {
            Err(msg) => return Err("failed to read " + fpath + ": " + msg)
            Ok(content) => {
              paths.push(fpath)
              sources.push(content)
            }
          }
        }
        i = i + 1
      }
    } else {
      match fs_read(world, target) {
        Err(msg) => return Err("failed to read " + target + ": " + msg)
        Ok(content) => {
          paths.push(target)
          sources.push(content)
        }
      }
    }
    t = t + 1
  }
  Ok(DrvLoaded::{ pkg_name: pkg_name, paths: paths, sources: sources })
}

///|
/// Parallel per-file SHA-256 pre-hash using Pion native OS threads (scope + spawn + Channel + AtomicInt).
/// Results are always reassembled in deterministic input index order.
fn drv_parallel_prehash(
  world : World,
  sources : Array[String],
  jobs : Int,
) -> Array[String] {
  let n = sources.length()
  let out : Array[String] = []
  let mut k = 0
  while k < n {
    out.push("")
    k = k + 1
  }
  if n <= 1 || jobs <= 1 {
    let mut i = 0
    while i < n {
      out[i] = sha256_hex(sources[i])
      i = i + 1
    }
    return out
  }
  let mut base = 0
  while base < n {
    let mut batch = n - base
    if batch > jobs {
      batch = jobs
    }
    let ch : Channel[String] = Channel::new(batch + 1)
    let done = AtomicInt::new(0)
    scope(world, fn(s : Scope) -> Unit {
      let mut off = 0
      while off < batch {
        let idx = base + off
        let src = sources[idx]
        spawn(s, fn() -> Unit {
          let h = sha256_hex(src)
          let _ = ch.send(idx.to_string() + ":" + h)
          let _ = done.fetch_add(1)
        })
        off = off + 1
      }
    })
    ch.close()
    while true {
      match ch.recv() {
        Some(msg) => {
          let mut colon = -1
          let mut j = 0
          while j < msg.length() {
            if str_code_at(msg, j) == 58 {
              colon = j
              break
            }
            j = j + 1
          }
          if colon > 0 {
            let idx_sb = StringBuilder()
            let mut a = 0
            while a < colon {
              idx_sb.write_char(str_code_at(msg, a).unsafe_to_char())
              a = a + 1
            }
            let h_sb = StringBuilder()
            let mut b = colon + 1
            while b < msg.length() {
              h_sb.write_char(str_code_at(msg, b).unsafe_to_char())
              b = b + 1
            }
            let idx = drv_parse_pos_int64(idx_sb.to_string(), 0L).to_int()
            if idx >= 0 && idx < n {
              out[idx] = h_sb.to_string()
            }
          }
        }
        None => break
      }
    }
    let _ = done.load()
    base = base + batch
  }
  out
}

///|
fn drv_default_jobs(world : World) -> Int {
  let env_j = drv_env_str(world, "PION_JOBS")
  if env_j.length() > 0 {
    drv_parse_pos_int(env_j, 16)
  } else {
    16
  }
}

///|
fn drv_sort_strings(arr : Array[String]) -> Unit {
  let n = arr.length()
  let mut i = 1
  while i < n {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && key < arr[j] {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///|
fn drv_cas_record_and_evict(
  world : World,
  cache_dir : String,
  key : String,
  entry_bytes : Int64,
) -> Unit {
  let index_path = cache_dir + "/index.tsv"
  let entries : Array[CasEntry] = if fs_exists(world, index_path) {
    match fs_read(world, index_path) {
      Ok(txt) => cas_parse_index(txt)
      Err(_) => []
    }
  } else {
    []
  }
  let now = clock_now_ms(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let ev = cas_touch_and_evict(entries, key, entry_bytes, now, max_bytes)
  let mut i = 0
  while i < ev.evicted.length() {
    let ek = ev.evicted[i]
    if drv_starts_with(ek, "testbin:") {
      let _ = fs_remove(world, cache_dir + "/testbin/" + slice_str(ek, 8, ek.length()))
      i = i + 1
      continue
    }
    let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionsig")
    let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionstub")
    let _ = fs_remove(world, cache_dir + "/ssa/" + ek + ".ssa")
    let _ = fs_remove(world, cache_dir + "/obj/" + ek + ".o")
    i = i + 1
  }
  let _ = drv_write_text_atomic(world, index_path, cas_format_index(ev.kept))
}

///|
fn drv_cas_record_batch_and_evict(
  world : World,
  cache_dir : String,
  keys : Array[String],
  sizes : Array[Int64],
) -> Unit {
  if keys.length() == 0 {
    return
  }
  let index_path = cache_dir + "/index.tsv"
  let mut entries : Array[CasEntry] = if fs_exists(world, index_path) {
    match fs_read(world, index_path) {
      Ok(txt) => cas_parse_index(txt)
      Err(_) => []
    }
  } else {
    []
  }
  let now = clock_now_ms(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let all_evicted : Array[String] = []
  let mut ki = 0
  while ki < keys.length() && ki < sizes.length() {
    let ev = cas_touch_and_evict(entries, keys[ki], sizes[ki], now, max_bytes)
    entries = ev.kept
    let mut ei = 0
    while ei < ev.evicted.length() {
      all_evicted.push(ev.evicted[ei])
      ei = ei + 1
    }
    ki = ki + 1
  }
  let mut i = 0
  while i < all_evicted.length() {
    let ek = all_evicted[i]
    if drv_starts_with(ek, "testbin:") {
      let _ = fs_remove(world, cache_dir + "/testbin/" + slice_str(ek, 8, ek.length()))
      i = i + 1
      continue
    }
    let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionsig")
    let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionstub")
    let _ = fs_remove(world, cache_dir + "/ssa/" + ek + ".ssa")
    let _ = fs_remove(world, cache_dir + "/obj/" + ek + ".o")
    i = i + 1
  }
  let _ = drv_write_text_atomic(world, index_path, cas_format_index(entries))
}

///|
fn drv_split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut cur = StringBuilder()
  let mut has_any = false
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c == 10 {
      out.push(cur.to_string())
      cur = StringBuilder()
      has_any = false
    } else {
      cur.write_char(c.unsafe_to_char())
      has_any = true
    }
    i = i + 1
  }
  if has_any {
    out.push(cur.to_string())
  }
  out
}

///|
fn drv_compute_compiler_fp(
  world : World,
  qbe_bin : String,
  rt_lib : String,
) -> String {
  let qsz = fs_size(world, qbe_bin)
  let rsz = fs_size(world, rt_lib)
  let env_salt = drv_env_str(world, "PION_CACHE_SALT")
  let self_bin = drv_self_exe_path(world)
  let salt = if self_bin.length() > 0 && fs_exists(world, self_bin) {
    "self:" +
    fs_size(world, self_bin).to_string() +
    ":" +
    fs_mtime_ms(world, self_bin).to_string() +
    "|" +
    env_salt
  } else {
    env_salt
  }
  cas_compiler_fp(qsz, rsz, salt)
}

///|
fn drv_normalize_path(path : String) -> String {
  let is_abs = path.length() > 0 && str_code_at(path, 0) == 47
  let parts : Array[String] = []
  let mut sb = StringBuilder()
  let mut i = 0
  while i <= path.length() {
    let is_sep = i == path.length() || str_code_at(path, i) == 47
    if is_sep {
      let seg = sb.to_string()
      sb = StringBuilder()
      if seg.length() == 0 || seg == "." {
        ()
      } else if seg == ".." {
        if parts.length() > 0 && parts[parts.length() - 1] != ".." {
          let _ = parts.pop()
        } else if !is_abs {
          parts.push("..")
        }
      } else {
        parts.push(seg)
      }
    } else {
      sb.write_char(str_code_at(path, i).unsafe_to_char())
    }
    i = i + 1
  }
  let out = StringBuilder()
  if is_abs {
    out.write_char('/')
  }
  let mut j = 0
  while j < parts.length() {
    if j > 0 {
      out.write_char('/')
    }
    out.write_string(parts[j])
    j = j + 1
  }
  let res = out.to_string()
  if res.length() == 0 {
    "."
  } else {
    res
  }
}

///|
fn drv_resolve_rel_path(base_dir : String, rel : String) -> String {
  if rel.length() > 0 && str_code_at(rel, 0) == 47 {
    drv_normalize_path(rel)
  } else {
    drv_normalize_path(drv_join_path(base_dir, rel))
  }
}

///|
fn drv_detect_manifest_dir(world : World, target : String) -> Option[String] {
  if target == "pion.toml" || drv_ends_with(target, "/pion.toml") {
    let pd = drv_parent_dir(target)
    return Some(if pd.length() == 0 { "." } else { pd })
  }
  if fs_is_dir(world, target) {
    let mf = drv_join_path(target, "pion.toml")
    if fs_exists(world, mf) {
      return Some(drv_normalize_path(target))
    }
  }
  None
}

///|
struct DrvSrcPair {
  paths : Array[String]
  sources : Array[String]
}

///|
fn drv_load_pkg_dir_sources(
  world : World,
  pkg_dir : String,
) -> Result[DrvSrcPair, String] {
  let paths : Array[String] = []
  let sources : Array[String] = []
  let entries = fs_list_dir(world, pkg_dir)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if drv_is_source_file(name) {
      let fpath = drv_join_path(pkg_dir, name)
      match fs_read(world, fpath) {
        Err(msg) => return Err("failed to read " + fpath + ": " + msg)
        Ok(content) => {
          paths.push(fpath)
          sources.push(content)
        }
      }
    }
    i = i + 1
  }
  let src_dir = drv_join_path(pkg_dir, "src")
  if fs_is_dir(world, src_dir) {
    let sentries = fs_list_dir(world, src_dir)
    let mut j = 0
    while j < sentries.length() {
      let name = sentries[j]
      if drv_is_source_file(name) {
        let fpath = drv_join_path(src_dir, name)
        match fs_read(world, fpath) {
          Err(msg) => return Err("failed to read " + fpath + ": " + msg)
          Ok(content) => {
            paths.push(fpath)
            sources.push(content)
          }
        }
      }
      j = j + 1
    }
  }
  Ok(DrvSrcPair::{ paths: paths, sources: sources })
}

///|
/// Git dependency cache: `$PION_CACHE_DIR/git`, else `$HOME/.cache/pion/git`.
/// `repos/<sha256(url)>.git` are bare mirrors, `checkouts/<rev>` the shared
/// read-only source trees every worktree builds from.
fn drv_git_cache_root(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  if custom.length() > 0 {
    return drv_normalize_path(custom + "/git")
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    drv_normalize_path(drv_join_path(home, ".cache/pion/git"))
  } else {
    drv_join_path(drv_temp_dir(world), "pion-git")
  }
}

///|
fn drv_trim_ws(s : String) -> String {
  let mut a = 0
  let mut b = s.length()
  while a < b {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      a = a + 1
    } else {
      break
    }
  }
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 10 || c == 13 {
      b = b - 1
    } else {
      break
    }
  }
  slice_str(s, a, b)
}

///|
/// Runs `git <args>` without a terminal prompt; stdout is captured (never
/// mixed into pionc's own JSON output), stderr passes through.
fn drv_git(world : World, args : Array[String]) -> Result[String, String] {
  let argv : Array[String] = ["env", "GIT_TERMINAL_PROMPT=0", "git"]
  let mut i = 0
  while i < args.length() {
    argv.push(args[i])
    i = i + 1
  }
  match proc_exec_capture(world, argv) {
    Ok(out) => Ok(drv_trim_ws(out))
    Err(e) => Err(e)
  }
}

///|
fn drv_rm_rf(world : World, path : String) -> Unit {
  let _ = proc_exec_capture(world, ["chmod", "-R", "u+w", path])
  let _ = proc_exec_capture(world, ["rm", "-rf", path])
}

///|
struct DrvGitCtx {
  git_root : String
  old_lock : Array[LockEntry]
  new_lock : Array[LockEntry]
  fetched : Map[String, Bool]
}

///|
fn drv_git_resolve_rev(
  world : World,
  repo : String,
  dep : ManifestDep,
) -> Result[String, String] {
  let spec = if dep.tag.length() > 0 {
    "refs/tags/" + dep.tag + "^{commit}"
  } else if dep.rev.length() > 0 {
    dep.rev + "^{commit}"
  } else if dep.branch.length() > 0 {
    "refs/heads/" + dep.branch + "^{commit}"
  } else {
    "HEAD^{commit}"
  }
  drv_git(world, ["--git-dir", repo, "rev-parse", "--verify", "--quiet", spec])
}

///|
fn drv_git_has_commit(world : World, repo : String, rev : String) -> Bool {
  match drv_git(world, ["--git-dir", repo, "cat-file", "-e", rev + "^{commit}"]) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
fn drv_git_fetch_once(
  world : World,
  ctx : DrvGitCtx,
  repo : String,
  url : String,
) -> Result[Unit, String] {
  if ctx.fetched.contains(repo) {
    return Ok(())
  }
  ctx.fetched.set(repo, true)
  if !fs_is_dir(world, repo) {
    let _ = fs_mkdir_p(world, ctx.git_root + "/repos")
    let tmp = repo + ".tmp." + clock_now_ms(world).to_string()
    match drv_git(world, ["clone", "--quiet", "--mirror", url, tmp]) {
      Err(e) => {
        drv_rm_rf(world, tmp)
        return Err("git clone " + url + " failed: " + e)
      }
      Ok(_) => ()
    }
    if !fs_rename(world, tmp, repo) {
      drv_rm_rf(world, tmp)
      if !fs_is_dir(world, repo) {
        return Err("failed to move git mirror into " + repo)
      }
    }
    return Ok(())
  }
  match drv_git(world, ["--git-dir", repo, "fetch", "--quiet", "--prune", "--tags", "origin"]) {
    Err(e) => Err("git fetch " + url + " failed: " + e)
    Ok(_) => Ok(())
  }
}

///|
/// Materializes `rev` once into the shared `checkouts/<rev>` tree (files made
/// read-only, no `.git`), atomically via rename.
fn drv_git_checkout(
  world : World,
  ctx : DrvGitCtx,
  repo : String,
  rev : String,
) -> Result[String, String] {
  let co = ctx.git_root + "/checkouts/" + rev
  if fs_is_dir(world, co) {
    return Ok(co)
  }
  let _ = fs_mkdir_p(world, ctx.git_root + "/checkouts")
  let tmp = co + ".tmp." + clock_now_ms(world).to_string()
  match drv_git(world, ["clone", "--quiet", "--shared", "--no-checkout", repo, tmp]) {
    Err(e) => {
      drv_rm_rf(world, tmp)
      return Err("git clone of cached mirror failed: " + e)
    }
    Ok(_) => ()
  }
  match drv_git(world, ["-C", tmp, "-c", "advice.detachedHead=false", "checkout", "--quiet", "--detach", rev]) {
    Err(e) => {
      drv_rm_rf(world, tmp)
      return Err("git checkout " + rev + " failed: " + e)
    }
    Ok(_) => ()
  }
  drv_rm_rf(world, tmp + "/.git")
  if !fs_rename(world, tmp, co) {
    drv_rm_rf(world, tmp)
    if !fs_is_dir(world, co) {
      return Err("failed to move git checkout into " + co)
    }
    return Ok(co)
  }
  let _ = proc_exec_capture(world, ["find", co, "-type", "f", "-exec", "chmod", "a-w", "{}", "+"])
  Ok(co)
}

///|
/// Resolves a git dependency to its package directory inside the shared git
/// cache, reusing the `pion.lock` pin when it still matches `pion.toml` (then
/// no git command runs at all once the checkout exists).
fn drv_git_dep_dir(
  world : World,
  ctx : DrvGitCtx,
  dep : ManifestDep,
) -> Result[String, String] {
  let url = dep.git
  let repo = ctx.git_root + "/repos/" + sha256_hex(url) + ".git"
  let reference = manifest_dep_ref(dep)
  let mut rev = match lock_find(ctx.new_lock, dep) {
    Some(e) => e.rev
    None =>
      match lock_find(ctx.old_lock, dep) {
        Some(e) => e.rev
        None => ""
      }
  }
  let co_ready = rev.length() > 0 &&
    fs_is_dir(world, ctx.git_root + "/checkouts/" + rev)
  if !co_ready {
    if rev.length() > 0 {
      // Locked, but this machine has no checkout yet: make sure the commit is local.
      let mut have = fs_is_dir(world, repo) && drv_git_has_commit(world, repo, rev)
      if !have {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        have = drv_git_has_commit(world, repo, rev)
      }
      if !have {
        return Err(
          "git dependency `" + dep.name + "`: locked rev " + rev + " not found in " + url,
        )
      }
    } else {
      // Unlocked: tags and full revs resolve from the mirror; branches and HEAD always fetch.
      let floating = dep.tag.length() == 0 && dep.rev.length() == 0
      if floating || !fs_is_dir(world, repo) {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
      }
      let mut resolved = match drv_git_resolve_rev(world, repo, dep) {
        Ok(r) => r
        Err(_) => ""
      }
      if resolved.length() == 0 {
        match drv_git_fetch_once(world, ctx, repo, url) {
          Err(e) => return Err(e)
          Ok(_) => ()
        }
        resolved = match drv_git_resolve_rev(world, repo, dep) {
          Ok(r) => r
          Err(_) => ""
        }
      }
      if resolved.length() == 0 {
        return Err(
          "git dependency `" + dep.name + "`: cannot resolve " + reference + " in " + url,
        )
      }
      rev = resolved
    }
    match drv_git_checkout(world, ctx, repo, rev) {
      Err(e) => return Err("git dependency `" + dep.name + "`: " + e)
      Ok(_) => ()
    }
  }
  match lock_add(ctx.new_lock, lock_entry_new(dep.name, url, reference, rev, dep.subdir)) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  let co = ctx.git_root + "/checkouts/" + rev
  let dir = if dep.subdir.length() > 0 {
    drv_resolve_rel_path(co, dep.subdir)
  } else {
    co
  }
  if !drv_starts_with(dir + "/", co + "/") {
    return Err("git dependency `" + dep.name + "`: subdir escapes the repository")
  }
  if !fs_exists(world, drv_join_path(dir, "pion.toml")) {
    return Err(
      "git dependency `" +
      dep.name +
      "`: no pion.toml at " +
      (if dep.subdir.length() > 0 { "subdir `" + dep.subdir + "` of " } else { "" }) +
      url +
      " (" +
      rev +
      ")",
    )
  }
  Ok(dir)
}

///|
fn drv_load_workspace_dfs(
  world : World,
  ctx : DrvGitCtx,
  pkg_dir : String,
  visited : Map[String, Bool],
  out : Array[PkgNodeInput],
) -> Result[Unit, String] {
  let norm_dir = drv_normalize_path(pkg_dir)
  if visited.contains(norm_dir) {
    return Ok(())
  }
  visited.set(norm_dir, true)
  let mf_path = drv_join_path(norm_dir, "pion.toml")
  if !fs_exists(world, mf_path) {
    return Err("missing pion.toml in " + norm_dir)
  }
  let mf_txt = match fs_read(world, mf_path) {
    Err(e) => return Err("failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(mf_txt) {
    Err(e) => return Err(e)
    Ok(m) => m
  }
  let dep_names : Array[String] = []
  let mut i = 0
  while i < mf.deps.length() {
    let dep = mf.deps[i]
    dep_names.push(dep.name)
    let dep_dir = if manifest_dep_is_git(dep) {
      match drv_git_dep_dir(world, ctx, dep) {
        Err(e) => return Err(e)
        Ok(d) => d
      }
    } else {
      drv_resolve_rel_path(norm_dir, dep.path)
    }
    match drv_load_workspace_dfs(world, ctx, dep_dir, visited, out) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    i = i + 1
  }
  let loaded_src = match drv_load_pkg_dir_sources(world, norm_dir) {
    Err(e) => return Err(e)
    Ok(v) => v
  }
  out.push(PkgNodeInput::{
    name: mf.name,
    dir: norm_dir,
    deps: dep_names,
    paths: loaded_src.paths,
    sources: loaded_src.sources,
    link_libs: mf.link_libs,
    link_common: mf.link_common,
    link_macos: mf.link_macos,
    link_linux: mf.link_linux,
    link_ios: mf.link_ios,
    link_android: mf.link_android,
    link_windows: mf.link_windows,
    link_wasm: mf.link_wasm,
  })
  Ok(())
}

///|
struct DrvWsLoad {
  nodes : Array[PkgNodeInput]
  lock : Array[LockEntry]
  lock_path : String
  git_root : String
}

///|
/// Loads every package of the workspace rooted at `root_dir` (dependencies
/// first, root last), fetching git dependencies into the shared cache and
/// rewriting `<root>/pion.lock` only when its content changes.
fn drv_load_workspace(world : World, root_dir : String) -> Result[DrvWsLoad, String] {
  drv_load_workspace_ex(world, root_dir, false, "")
}

///|
/// `drv_load_workspace`, first dropping the `pion.lock` pins of every git
/// dependency (`unlock_all`) or of `unlock_name`, so they re-resolve to their
/// newest target ref (`pionc add` / `pionc update`).
fn drv_load_workspace_ex(
  world : World,
  root_dir : String,
  unlock_all : Bool,
  unlock_name : String,
) -> Result[DrvWsLoad, String] {
  let lock_path = drv_join_path(drv_normalize_path(root_dir), "pion.lock")
  let has_lock = fs_exists(world, lock_path)
  let old_text = if has_lock {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(e) => return Err("failed to read " + lock_path + ": " + e)
    }
  } else {
    ""
  }
  let parsed_lock = if has_lock {
    match parse_pion_lock(old_text) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
  } else {
    []
  }
  let old_lock : Array[LockEntry] = []
  if !unlock_all {
    let mut li = 0
    while li < parsed_lock.length() {
      if unlock_name.length() == 0 || parsed_lock[li].name != unlock_name {
        old_lock.push(parsed_lock[li])
      }
      li = li + 1
    }
  }
  let ctx = DrvGitCtx::{
    git_root: drv_git_cache_root(world),
    old_lock: old_lock,
    new_lock: [],
    fetched: Map([]),
  }
  let visited : Map[String, Bool] = Map([])
  let out : Array[PkgNodeInput] = []
  match drv_load_workspace_dfs(world, ctx, root_dir, visited, out) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  if has_lock || ctx.new_lock.length() > 0 {
    let new_text = format_pion_lock(ctx.new_lock)
    if new_text != old_text {
      if !drv_write_text_atomic(world, lock_path, new_text) {
        return Err("failed to write " + lock_path)
      }
    }
  }
  Ok(DrvWsLoad::{
    nodes: out,
    lock: ctx.new_lock,
    lock_path: lock_path,
    git_root: ctx.git_root,
  })
}

///|
fn drv_load_workspace_nodes(
  world : World,
  root_dir : String,
) -> Result[Array[PkgNodeInput], String] {
  match drv_load_workspace(world, root_dir) {
    Err(e) => Err(e)
    Ok(ws) => Ok(ws.nodes)
  }
}

///|
/// Packages fetched into the git cache are external: `pionc test` skips them.
fn drv_is_external_pkg(git_root : String, dir : String) -> Bool {
  drv_starts_with(drv_normalize_path(dir) + "/", git_root + "/")
}

///|
struct DrvLinkOpts {
  libs : Array[String]
  frameworks : Array[String]
  search_paths : Array[String]
  rpaths : Array[String]
  objects : Array[String]
  flags : Array[String]
  mut has_cxx : Bool
}

///|
fn drv_link_opts_empty() -> DrvLinkOpts {
  DrvLinkOpts::{
    libs: [],
    frameworks: [],
    search_paths: [],
    rpaths: [],
    objects: [],
    flags: [],
    has_cxx: false,
  }
}

///|
fn drv_is_cxx_lib(lib : String) -> Bool {
  lib == "c++" || lib == "stdc++"
}

///|
fn drv_is_cxx_source(path : String) -> Bool {
  drv_ends_with(path, ".cc") ||
  drv_ends_with(path, ".cpp") ||
  drv_ends_with(path, ".mm")
}

///|
fn drv_link_opts_from_libs(libs : Array[String]) -> DrvLinkOpts {
  let opts = drv_link_opts_empty()
  let mut i = 0
  while i < libs.length() {
    let lib = libs[i]
    push_unique_lib(opts.libs, lib)
    if drv_is_cxx_lib(lib) {
      opts.has_cxx = true
    }
    i = i + 1
  }
  opts
}

///|
fn drv_resolve_pkg_path(pkg_dir : String, p : String) -> String {
  if p.length() > 0 && str_code_at(p, 0) == 47 {
    p
  } else {
    drv_resolve_rel_path(pkg_dir, p)
  }
}

///|
fn drv_resolve_rpath(pkg_dir : String, p : String) -> String {
  if p.length() > 0 {
    let c0 = str_code_at(p, 0)
    if c0 == 47 || c0 == 64 || c0 == 36 {
      return p
    }
  }
  drv_resolve_rel_path(pkg_dir, p)
}

///|
fn drv_resolve_cc_flag(pkg_dir : String, flag : String) -> String {
  if flag.length() > 2 && drv_starts_with(flag, "-I") {
    let inc = slice_str(flag, 2, flag.length())
    if str_code_at(inc, 0) != 47 {
      return "-I" + drv_resolve_rel_path(pkg_dir, inc)
    }
  }
  flag
}

///|
fn drv_collect_link_spec(
  pkg_dir : String,
  spec : LinkSpec,
  is_macos : Bool,
  opts : DrvLinkOpts,
) -> Unit {
  let mut i = 0
  while i < spec.libs.length() {
    let lib = spec.libs[i]
    push_unique_lib(opts.libs, lib)
    if drv_is_cxx_lib(lib) {
      opts.has_cxx = true
    }
    i = i + 1
  }
  if is_macos {
    i = 0
    while i < spec.frameworks.length() {
      push_unique_lib(opts.frameworks, spec.frameworks[i])
      i = i + 1
    }
  }
  i = 0
  while i < spec.search_paths.length() {
    push_unique_lib(
      opts.search_paths,
      drv_resolve_pkg_path(pkg_dir, spec.search_paths[i]),
    )
    i = i + 1
  }
  i = 0
  while i < spec.rpaths.length() {
    push_unique_lib(opts.rpaths, drv_resolve_rpath(pkg_dir, spec.rpaths[i]))
    i = i + 1
  }
  i = 0
  while i < spec.objects.length() {
    push_unique_lib(
      opts.objects,
      drv_resolve_pkg_path(pkg_dir, spec.objects[i]),
    )
    i = i + 1
  }
  i = 0
  while i < spec.flags.length() {
    if spec.flags[i].length() > 0 {
      opts.flags.push(spec.flags[i])
    }
    i = i + 1
  }
}

///|
fn drv_collect_node_link_opts(
  node : PkgNodeInput,
  qbe_target : String,
  opts : DrvLinkOpts,
) -> Unit {
  let is_apple = drv_target_is_apple(qbe_target)
  let os = drv_target_os(qbe_target)
  drv_collect_link_spec(node.dir, node.link_common, is_apple, opts)
  if os == "macos" {
    drv_collect_link_spec(node.dir, node.link_macos, is_apple, opts)
  } else if os == "ios" {
    drv_collect_link_spec(node.dir, node.link_ios, is_apple, opts)
  } else if os == "android" {
    drv_collect_link_spec(node.dir, node.link_android, is_apple, opts)
  } else if os == "windows" {
    drv_collect_link_spec(node.dir, node.link_windows, is_apple, opts)
  } else if os == "wasm" {
    drv_collect_link_spec(node.dir, node.link_wasm, is_apple, opts)
  } else {
    drv_collect_link_spec(node.dir, node.link_linux, is_apple, opts)
  }
}

///|
fn drv_collect_dir_headers(
  world : World,
  dir : String,
  out : Array[String],
) -> Unit {
  if dir.length() == 0 || !fs_is_dir(world, dir) {
    return
  }
  let entries = fs_list_dir(world, dir)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if drv_ends_with(name, ".h") || drv_ends_with(name, ".hpp") {
      let full = drv_join_path(dir, name)
      out.push(
        full +
        ":" +
        fs_size(world, full).to_string() +
        ":" +
        fs_mtime_ms(world, full).to_string(),
      )
    }
    i = i + 1
  }
}

///|
fn drv_local_headers_fp(
  world : World,
  pkg_dir : String,
  src_dir : String,
) -> String {
  let entries : Array[String] = []
  drv_collect_dir_headers(world, pkg_dir, entries)
  if src_dir.length() > 0 && src_dir != pkg_dir {
    drv_collect_dir_headers(world, src_dir, entries)
  }
  drv_sort_strings(entries)
  sha256_hex(drv_join_char(entries, "\n"))
}

///|
/// Compiles a package's active `c_sources` (`[link]` + platform section) into
/// `$PION_CACHE_DIR/obj/cstub_<key>.o` (atomic temp + rename, LRU-tracked).
/// Returns `Ok(true)` if any compiled source is C++/ObjC++ (`.cc`/`.cpp`/`.mm`).
fn drv_compile_pkg_c_sources(
  world : World,
  node : PkgNodeInput,
  qbe_target : String,
  sysroot : String,
  need_pic : Bool,
  rt_lib : String,
  cache_dir : String,
  trace_cas : Bool,
  out_objs : Array[String],
  out_keys : Array[String],
  out_new_keys : Array[String],
  out_new_sizes : Array[Int64],
) -> Result[Bool, String] {
  let os = drv_target_os(qbe_target)
  let plat = if os == "macos" {
    node.link_macos
  } else if os == "ios" {
    node.link_ios
  } else if os == "android" {
    node.link_android
  } else if os == "windows" {
    node.link_windows
  } else if os == "wasm" {
    node.link_wasm
  } else {
    node.link_linux
  }
  let c_sources : Array[String] = []
  let mut i = 0
  while i < node.link_common.c_sources.length() {
    push_unique_lib(
      c_sources,
      drv_resolve_pkg_path(node.dir, node.link_common.c_sources[i]),
    )
    i = i + 1
  }
  i = 0
  while i < plat.c_sources.length() {
    push_unique_lib(c_sources, drv_resolve_pkg_path(node.dir, plat.c_sources[i]))
    i = i + 1
  }
  if c_sources.length() == 0 {
    return Ok(false)
  }
  let cc_flags : Array[String] = drv_target_cc_flags(world, qbe_target, sysroot)
  if need_pic && !drv_target_is_windows(qbe_target) {
    cc_flags.push("-fPIC")
  }
  i = 0
  while i < node.link_common.cc_flags.length() {
    cc_flags.push(drv_resolve_cc_flag(node.dir, node.link_common.cc_flags[i]))
    i = i + 1
  }
  i = 0
  while i < plat.cc_flags.length() {
    cc_flags.push(drv_resolve_cc_flag(node.dir, plat.cc_flags[i]))
    i = i + 1
  }
  let rt_dir_raw = drv_parent_dir(rt_lib)
  let rt_dir = if rt_dir_raw.length() > 0 { rt_dir_raw } else { "." }
  let rt_inc_dirs : Array[String] = [rt_dir]
  let alt_rt_dir = drv_resolve_rel_path(rt_dir, "../runtime")
  if alt_rt_dir != rt_dir &&
    fs_exists(world, drv_join_path(alt_rt_dir, "pion_rt.h")) {
    rt_inc_dirs.push(alt_rt_dir)
  } else if !fs_exists(world, drv_join_path(rt_dir, "pion_rt.h")) {
    let rt_c = drv_find_pion_rt_c(world)
    if rt_c.length() > 0 {
      let src_rt_dir = drv_parent_dir(rt_c)
      if src_rt_dir.length() > 0 &&
        src_rt_dir != rt_dir &&
        fs_exists(world, drv_join_path(src_rt_dir, "pion_rt.h")) {
        rt_inc_dirs.push(src_rt_dir)
      }
    }
  }
  let cc_flags_joined = drv_join_char(cc_flags, "\n")
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let cxx_bin = drv_resolve_cc_driver(world, qbe_target, true)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let mut any_cxx = false
  let mut si = 0
  while si < c_sources.length() {
    let src_path = c_sources[si]
    if !fs_exists(world, src_path) {
      return Err("c_source does not exist: " + src_path)
    }
    let is_cxx = drv_is_cxx_source(src_path)
    if is_cxx {
      any_cxx = true
    }
    let compiler = if is_cxx { cxx_bin } else { cc_bin }
    let src_txt = match fs_read(world, src_path) {
      Ok(t) => t
      Err(e) => return Err("failed to read c_source " + src_path + ": " + e)
    }
    let src_hash = sha256_hex(src_txt)
    let headers_fp = drv_local_headers_fp(
      world,
      node.dir,
      drv_parent_dir(src_path),
    )
    let key = sha256_hex(
      "cstub-v1|" +
      qbe_target +
      "|" +
      compiler +
      "|" +
      cc_flags_joined +
      "|" +
      src_path +
      "|" +
      src_hash +
      "|" +
      headers_fp,
    )
    let obj_path = cache_dir + "/obj/cstub_" + key + ".o"
    if fs_exists(world, obj_path) {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] cstub=" + src_path + " HIT key=" + drv_prefix16(key),
        )
      }
    } else {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] cstub=" + src_path + " MISS key=" + drv_prefix16(key),
        )
      }
      let stamp = clock_now_ms(world).to_string()
      let obj_tmp = obj_path + ".tmp." + stamp + "_" + si.to_string()
      let argv : Array[String] = [compiler]
      let mut fi = 0
      while fi < cc_flags.length() {
        argv.push(cc_flags[fi])
        fi = fi + 1
      }
      let mut ri = 0
      while ri < rt_inc_dirs.length() {
        argv.push("-I" + rt_inc_dirs[ri])
        ri = ri + 1
      }
      argv.push("-c")
      argv.push(src_path)
      argv.push("-o")
      argv.push(obj_tmp)
      let rc = proc_exec(world, argv)
      if rc != 0 {
        let _ = fs_remove(world, obj_tmp)
        return Err(
          "failed to compile c_source " +
          src_path +
          " with " +
          compiler +
          " (exit code " +
          rc.to_string() +
          ")",
        )
      }
      let _ = fs_rename(world, obj_tmp, obj_path)
      let sz = fs_size(world, obj_path)
      out_new_keys.push("cstub_" + key)
      out_new_sizes.push(if sz > 0L { sz } else { 0L })
    }
    out_objs.push(obj_path)
    out_keys.push(key)
    si = si + 1
  }
  Ok(any_cxx)
}

///|
fn drv_find_in_path(world : World, bin_name : String) -> String {
  let path_env = drv_env_str(world, "PATH")
  if path_env.length() == 0 {
    return ""
  }
  let sep = if drv_env_str(world, "OS") == "Windows_NT" ||
    drv_find_substr(path_env, ";", 0) >= 0 {
    59
  } else {
    58
  }
  let dirs = drv_split_char(path_env, sep)
  let mut i = 0
  while i < dirs.length() {
    let d = dirs[i]
    if d.length() > 0 {
      let cand = drv_join_path(d, bin_name)
      if fs_exists(world, cand) {
        return cand
      }
    }
    i = i + 1
  }
  ""
}

///|
fn drv_resolve_win_rc_bin(
  world : World,
  cc_bin : String,
  is_msvc : Bool,
) -> String {
  let cc_dir = drv_parent_dir(cc_bin)
  if is_msvc {
    if cc_dir.length() > 0 {
      let c1 = drv_join_path(cc_dir, "llvm-rc.exe")
      if fs_exists(world, c1) {
        return c1
      }
      let c2 = drv_join_path(cc_dir, "llvm-rc")
      if fs_exists(world, c2) {
        return c2
      }
    }
    let p1 = drv_find_in_path(world, "llvm-rc.exe")
    if p1.length() > 0 {
      return p1
    }
    let p2 = drv_find_in_path(world, "llvm-rc")
    if p2.length() > 0 {
      return p2
    }
    let p3 = drv_find_in_path(world, "rc.exe")
    if p3.length() > 0 {
      return p3
    }
    "llvm-rc"
  } else {
    if cc_dir.length() > 0 {
      let w1 = drv_join_path(cc_dir, "windres.exe")
      if fs_exists(world, w1) {
        return w1
      }
      let w2 = drv_join_path(cc_dir, "windres")
      if fs_exists(world, w2) {
        return w2
      }
    }
    "windres"
  }
}

///|
fn drv_rc_dir_fp(world : World, rc_dir : String) -> String {
  if rc_dir.length() == 0 || !fs_is_dir(world, rc_dir) {
    return ""
  }
  let entries = fs_list_dir(world, rc_dir)
  drv_sort_strings(entries)
  let parts : Array[String] = []
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name.length() > 0 && str_code_at(name, 0) != 46 {
      let full = drv_join_path(rc_dir, name)
      if !fs_is_dir(world, full) {
        let sz = fs_size(world, full)
        let mt = fs_mtime_ms(world, full)
        let content_h = if sz >= 0L && sz <= 4194304L {
          match fs_read_bytes(world, full) {
            Ok(bs) => sha256_hex(bs.to_string())
            Err(_) => ""
          }
        } else {
          ""
        }
        parts.push(
          name + ":" + sz.to_string() + ":" + mt.to_string() + ":" + content_h,
        )
      }
    }
    i = i + 1
  }
  sha256_hex(drv_join_char(parts, "\n"))
}

///|
/// Compiles a package's Windows `.rc` resource scripts (`[link.windows] rc_sources`)
/// into CAS-cached `$PION_CACHE_DIR/obj/rc_<key>.res` objects (Windows targets only).
fn drv_compile_pkg_rc_sources(
  world : World,
  node : PkgNodeInput,
  qbe_target : String,
  cache_dir : String,
  trace_cas : Bool,
  out_res : Array[String],
  out_keys : Array[String],
  out_new_keys : Array[String],
  out_new_sizes : Array[Int64],
) -> Result[Unit, String] {
  if !drv_target_is_windows(qbe_target) {
    return Ok(())
  }
  let rc_sources : Array[String] = []
  let mut i = 0
  while i < node.link_common.rc_sources.length() {
    push_unique_lib(
      rc_sources,
      drv_resolve_pkg_path(node.dir, node.link_common.rc_sources[i]),
    )
    i = i + 1
  }
  i = 0
  while i < node.link_windows.rc_sources.length() {
    push_unique_lib(
      rc_sources,
      drv_resolve_pkg_path(node.dir, node.link_windows.rc_sources[i]),
    )
    i = i + 1
  }
  if rc_sources.length() == 0 {
    return Ok(())
  }
  let cc_bin = drv_resolve_cc_driver(world, qbe_target, false)
  let is_msvc = drv_is_windows_msvc_cc(world, qbe_target, cc_bin)
  let rc_bin = drv_resolve_win_rc_bin(world, cc_bin, is_msvc)
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let mut ri = 0
  while ri < rc_sources.length() {
    let rc_path = rc_sources[ri]
    if !fs_exists(world, rc_path) {
      return Err("rc_source does not exist: " + rc_path)
    }
    let rc_txt = match fs_read(world, rc_path) {
      Ok(t) => t
      Err(e) => return Err("failed to read rc_source " + rc_path + ": " + e)
    }
    let rc_hash = sha256_hex(rc_txt)
    let rc_dir_raw = drv_parent_dir(rc_path)
    let rc_dir = if rc_dir_raw.length() > 0 { rc_dir_raw } else { "." }
    let res_fp = drv_rc_dir_fp(world, rc_dir)
    let key = sha256_hex(
      "rc-v1|" +
      qbe_target +
      "|" +
      (if is_msvc { "msvc" } else { "mingw" }) +
      "|" +
      rc_bin +
      "|" +
      rc_path +
      "|" +
      rc_hash +
      "|" +
      res_fp,
    )
    let res_path = cache_dir + "/obj/rc_" + key + ".res"
    if fs_exists(world, res_path) {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] rc=" + rc_path + " HIT key=" + drv_prefix16(key),
        )
      }
    } else {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] rc=" + rc_path + " MISS key=" + drv_prefix16(key),
        )
      }
      let stamp = clock_now_ms(world).to_string()
      let res_tmp = res_path + ".tmp." + stamp + "_" + ri.to_string()
      let argv : Array[String] = if is_msvc {
        [rc_bin, "-I", rc_dir, "-fo", res_tmp, rc_path]
      } else {
        [rc_bin, "-I", rc_dir, rc_path, "-O", "coff", "-o", res_tmp]
      }
      let rc = proc_exec(world, argv)
      if rc != 0 {
        let _ = fs_remove(world, res_tmp)
        return Err(
          "failed to compile rc_source " +
          rc_path +
          " with " +
          rc_bin +
          " (exit code " +
          rc.to_string() +
          ")",
        )
      }
      let _ = fs_rename(world, res_tmp, res_path)
      let sz = fs_size(world, res_path)
      out_new_keys.push("rc_" + key)
      out_new_sizes.push(if sz > 0L { sz } else { 0L })
    }
    out_res.push(res_path)
    out_keys.push(key)
    ri = ri + 1
  }
  Ok(())
}

///|
struct DrvWsBuilt {
  root_pkg_name : String
  root_checked : Option[CheckedPackage]
  obj_paths : Array[String]
  dep_pkg_names : Array[String]
  link_key : String
  link_opts : DrvLinkOpts
}

///|
/// `qbe -t <target> --obj|--obj-batch`, plus `--macos-ver` only for Mach-O.
fn drv_qbe_obj_argv(
  qbe_bin : String,
  qbe_target : String,
  qbe_macos_ver : String,
  batch : Bool,
) -> Array[String] {
  let mode = if batch { "--obj-batch" } else { "--obj" }
  let qbe_arch = drv_target_qbe_arch(qbe_target)
  let argv : Array[String] = [qbe_bin, "-t", qbe_arch, mode]
  if qbe_target == "arm64_apple" {
    argv.push("--macos-ver")
    argv.push(qbe_macos_ver)
  }
  argv
}

///|
/// QBE writes `.o` itself (Mach-O arm64 or ELF64 x86_64), skipping `as`.
fn drv_direct_obj_target(world : World, qbe_target : String) -> Bool {
  (qbe_target == "arm64_apple" || qbe_target == "amd64_sysv") &&
  drv_env_str(world, "PION_NO_DIRECT_OBJ") != "1"
}

///|
fn drv_pick_target(world : World, target_override : String) -> String {
  if target_override.length() > 0 {
    target_override
  } else {
    drv_resolve_qbe_target(world)
  }
}

///|
/// Cache-key suffix for extra link options ("" when empty, so keys stay stable).
/// Includes every `objects` file's `(path, size, mtime_ms)` so rebuilt `.a`/`.o`/`.dylib`
/// invalidate the linked binary automatically.
fn drv_link_opts_key(world : World, opts : DrvLinkOpts) -> String {
  if opts.libs.length() == 0 &&
    opts.frameworks.length() == 0 &&
    opts.search_paths.length() == 0 &&
    opts.rpaths.length() == 0 &&
    opts.objects.length() == 0 &&
    opts.flags.length() == 0 &&
    !opts.has_cxx {
    return ""
  }
  let sb = StringBuilder()
  if opts.libs.length() > 0 {
    sb.write_string("|link:")
    sb.write_string(drv_join_char(opts.libs, ","))
  }
  if opts.frameworks.length() > 0 {
    sb.write_string("|fw:")
    sb.write_string(drv_join_char(opts.frameworks, ","))
  }
  if opts.search_paths.length() > 0 {
    sb.write_string("|L:")
    sb.write_string(drv_join_char(opts.search_paths, ","))
  }
  if opts.rpaths.length() > 0 {
    sb.write_string("|rpath:")
    sb.write_string(drv_join_char(opts.rpaths, ","))
  }
  if opts.objects.length() > 0 {
    sb.write_string("|obj:")
    let mut i = 0
    while i < opts.objects.length() {
      if i > 0 {
        sb.write_string(",")
      }
      let op = opts.objects[i]
      sb.write_string(op)
      sb.write_string(":")
      sb.write_string(fs_size(world, op).to_string())
      sb.write_string(":")
      sb.write_string(fs_mtime_ms(world, op).to_string())
      i = i + 1
    }
  }
  if opts.flags.length() > 0 {
    sb.write_string("|flags:")
    sb.write_string(drv_join_char(opts.flags, "\n"))
  }
  if opts.has_cxx {
    sb.write_string("|cxx:1")
  }
  sb.to_string()
}

///|
fn drv_bin_key(world : World, key : String, opts : DrvLinkOpts) -> String {
  let suffix = drv_link_opts_key(world, opts)
  if suffix.length() == 0 {
    key
  } else {
    sha256_hex(key + suffix)
  }
}

///|
fn drv_copy_file(world : World, src : String, dst : String) -> Result[String, String] {
  drv_ensure_parent_dir(world, dst)
  match fs_read_bytes(world, src) {
    Err(e) => Err("failed to read " + src + ": " + e)
    Ok(b) =>
      match fs_write_bytes(world, dst, b) {
        Err(e) => Err("failed to write " + dst + ": " + e)
        Ok(_) => Ok(dst)
      }
  }
}

///|
/// Parses `-l <lib>`, `-l<lib>` and `--link <lib>` at `args[i]`; returns how many
/// arguments were consumed (0 when `args[i]` is not a link flag).
fn drv_parse_link_flag(args : Array[String], i : Int, libs : Array[String]) -> Int {
  let a = args[i]
  if (a == "-l" || a == "--link") && i + 1 < args.length() {
    push_unique_lib(libs, args[i + 1])
    2
  } else if a.length() > 2 && drv_starts_with(a, "-l") {
    push_unique_lib(libs, slice_str(a, 2, a.length()))
    1
  } else {
    0
  }
}

///|
fn drv_compile_ssa_to_obj(
  world : World,
  qbe_bin : String,
  qbe_target : String,
  apple_tools : AppleTools,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  sysroot : String,
  ssa_path : String,
  obj_path : String,
  stamp : String,
) -> Result[Unit, String] {
  let obj_tmp = obj_path + ".tmp." + stamp
  if direct_obj {
    let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
    argv.push("-o")
    argv.push(obj_tmp)
    argv.push(ssa_path)
    let rc_qbe = proc_exec(world, argv)
    if rc_qbe != 0 {
      let _ = fs_remove(world, obj_tmp)
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    let _ = fs_rename(world, obj_tmp, obj_path)
    Ok(())
  } else {
    let asm_path = obj_path + ".s." + stamp
    let qbe_arch = drv_target_qbe_arch(qbe_target)
    let rc_qbe = proc_exec(world, [qbe_bin, "-t", qbe_arch, "-o", asm_path, ssa_path])
    if rc_qbe != 0 {
      let _ = fs_remove(world, asm_path)
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    let rc_as = drv_assemble_file(
      world,
      qbe_target,
      apple_tools,
      cc1as_triple,
      sysroot,
      asm_path,
      obj_tmp,
    )
    let _ = fs_remove(world, asm_path)
    if rc_as != 0 {
      let _ = fs_remove(world, obj_tmp)
      return Err("as failed with exit code " + rc_as.to_string())
    }
    let _ = fs_rename(world, obj_tmp, obj_path)
    Ok(())
  }
}

///|
fn drv_archive_static_lib(
  world : World,
  obj_paths : Array[String],
  out_path : String,
) -> Result[String, String] {
  drv_ensure_parent_dir(world, out_path)
  if fs_exists(world, out_path) {
    let _ = fs_remove(world, out_path)
  }
  let argv : Array[String] = ["ar", "rcs", out_path]
  let mut i = 0
  while i < obj_paths.length() {
    argv.push(obj_paths[i])
    i = i + 1
  }
  let rc = proc_exec(world, argv)
  if rc != 0 {
    Err("ar failed with exit code " + rc.to_string())
  } else {
    Ok(out_path)
  }
}

///|
fn drv_link_shared_lib(
  world : World,
  qbe_target : String,
  sysroot : String,
  obj_paths : Array[String],
  rt_lib : String,
  opts : DrvLinkOpts,
  out_path : String,
) -> Result[String, String] {
  drv_ensure_parent_dir(world, out_path)
  let driver = drv_resolve_cc_driver(world, qbe_target, opts.has_cxx)
  let ld_argv : Array[String] = [driver]
  let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
  let mut ti = 0
  while ti < tflags.length() {
    ld_argv.push(tflags[ti])
    ti = ti + 1
  }
  if drv_target_is_apple(qbe_target) {
    ld_argv.push("-dynamiclib")
  } else {
    ld_argv.push("-shared")
  }
  let mut oi = 0
  while oi < obj_paths.length() {
    ld_argv.push(obj_paths[oi])
    oi = oi + 1
  }
  ld_argv.push(rt_lib)
  let mut exi = 0
  while exi < opts.objects.length() {
    ld_argv.push(opts.objects[exi])
    exi = exi + 1
  }
  let mut spi = 0
  while spi < opts.search_paths.length() {
    ld_argv.push("-L" + opts.search_paths[spi])
    spi = spi + 1
  }
  if !drv_target_is_windows(qbe_target) {
    let mut rpi = 0
    while rpi < opts.rpaths.length() {
      ld_argv.push("-Wl,-rpath," + opts.rpaths[rpi])
      rpi = rpi + 1
    }
  }
  if drv_target_is_apple(qbe_target) {
    let mut fwi = 0
    while fwi < opts.frameworks.length() {
      ld_argv.push("-framework")
      ld_argv.push(opts.frameworks[fwi])
      fwi = fwi + 1
    }
  }
  let is_win_msvc = drv_is_windows_msvc_cc(world, qbe_target, driver)
  let mut li = 0
  while li < opts.libs.length() {
    let lib = opts.libs[li]
    if !is_win_msvc || (lib != "m" && lib != "pthread") {
      ld_argv.push("-l" + lib)
    }
    li = li + 1
  }
  if is_win_msvc {
    let t_flags = drv_win_translate_msvc_flags(opts.flags, true)
    let mut fli = 0
    while fli < t_flags.length() {
      ld_argv.push(t_flags[fli])
      fli = fli + 1
    }
  } else {
    let mut fli = 0
    while fli < opts.flags.length() {
      ld_argv.push(opts.flags[fli])
      fli = fli + 1
    }
    if !drv_target_is_apple(qbe_target) {
      ld_argv.push("-lm")
      if drv_target_is_windows(qbe_target) {
        ld_argv.push("-lws2_32")
      } else if !drv_target_is_android(qbe_target) {
        ld_argv.push("-lpthread")
      }
    }
  }
  ld_argv.push("-o")
  ld_argv.push(out_path)
  let rc_ld = proc_exec(world, ld_argv)
  if rc_ld != 0 {
    Err("shared linker failed with exit code " + rc_ld.to_string())
  } else {
    Ok(out_path)
  }
}

///|
fn drv_link_objects(
  world : World,
  qbe_target : String,
  apple_tools : AppleTools,
  ld_ver : String,
  sysroot : String,
  obj_paths : Array[String],
  rt_lib : String,
  opts : DrvLinkOpts,
  final_bin : String,
) -> Result[Unit, String] {
  let is_simple = opts.frameworks.length() == 0 &&
    opts.search_paths.length() == 0 &&
    opts.rpaths.length() == 0 &&
    opts.objects.length() == 0 &&
    opts.flags.length() == 0 &&
    !opts.has_cxx
  let rc_ld = if apple_tools.ok &&
    is_simple &&
    qbe_target == "arm64_apple" &&
    sysroot.length() == 0 {
    let ld_argv : Array[String] = [
      apple_tools.ld_bin,
      "-arch",
      "arm64",
      "-platform_version",
      "macos",
      ld_ver,
      ld_ver,
      "-syslibroot",
      apple_tools.sdk_path,
      "-dead_strip",
      "-o",
      final_bin,
    ]
    let mut oi = 0
    while oi < obj_paths.length() {
      ld_argv.push(obj_paths[oi])
      oi = oi + 1
    }
    ld_argv.push(rt_lib)
    let mut li = 0
    while li < opts.libs.length() {
      ld_argv.push("-l" + opts.libs[li])
      li = li + 1
    }
    ld_argv.push("-lSystem")
    proc_exec(world, ld_argv)
  } else {
    let driver = drv_resolve_cc_driver(world, qbe_target, opts.has_cxx)
    let ld_argv : Array[String] = [driver]
    let tflags = drv_target_cc_flags(world, qbe_target, sysroot)
    let mut ti = 0
    while ti < tflags.length() {
      ld_argv.push(tflags[ti])
      ti = ti + 1
    }
    let mut oi = 0
    while oi < obj_paths.length() {
      ld_argv.push(obj_paths[oi])
      oi = oi + 1
    }
    ld_argv.push(rt_lib)
    let mut exi = 0
    while exi < opts.objects.length() {
      ld_argv.push(opts.objects[exi])
      exi = exi + 1
    }
    let mut spi = 0
    while spi < opts.search_paths.length() {
      ld_argv.push("-L" + opts.search_paths[spi])
      spi = spi + 1
    }
    if !drv_target_is_windows(qbe_target) {
      let mut rpi = 0
      while rpi < opts.rpaths.length() {
        ld_argv.push("-Wl,-rpath," + opts.rpaths[rpi])
        rpi = rpi + 1
      }
    }
    if drv_target_is_apple(qbe_target) {
      let mut fwi = 0
      while fwi < opts.frameworks.length() {
        ld_argv.push("-framework")
        ld_argv.push(opts.frameworks[fwi])
        fwi = fwi + 1
      }
    }
    let is_win_msvc = drv_is_windows_msvc_cc(world, qbe_target, driver)
    let mut li = 0
    while li < opts.libs.length() {
      let lib = opts.libs[li]
      if !is_win_msvc || (lib != "m" && lib != "pthread") {
        ld_argv.push("-l" + lib)
      }
      li = li + 1
    }
    if is_win_msvc {
      let t_flags = drv_win_translate_msvc_flags(opts.flags, false)
      let mut fli = 0
      while fli < t_flags.length() {
        ld_argv.push(t_flags[fli])
        fli = fli + 1
      }
    } else {
      let mut fli = 0
      while fli < opts.flags.length() {
        ld_argv.push(opts.flags[fli])
        fli = fli + 1
      }
      if !drv_target_is_apple(qbe_target) {
        ld_argv.push("-lm")
        if drv_target_is_windows(qbe_target) {
          ld_argv.push("-lws2_32")
          // MinGW-w64 defaults the main thread to a 1 MB stack (macOS/Linux: 8 MB);
          // deep recursion (e.g. self-hosting 43K lines) needs 16 MB.
          ld_argv.push("-Wl,--stack,16777216")
        } else if !drv_target_is_android(qbe_target) {
          ld_argv.push("-lpthread")
        }
      }
    }
    ld_argv.push("-o")
    ld_argv.push(final_bin)
    proc_exec(world, ld_argv)
  }
  if rc_ld != 0 {
    Err("linker failed with exit code " + rc_ld.to_string())
  } else {
    Ok(())
  }
}

///|
fn drv_ensure_ws_imports(
  world : World,
  nodes : Array[PkgNodeInput],
  topo_order : Array[Int],
  trans_dep_topo : Array[Array[Int]],
  stub_paths : Array[String],
  loaded_imported : Array[Option[ImportedPkg]],
  pkg_topo_idx : Int,
) -> Array[ImportedPkg] {
  let deps_topo = trans_dep_topo[pkg_topo_idx]
  let out : Array[ImportedPkg] = []
  let mut i = 0
  while i < deps_topo.length() {
    let u = deps_topo[i]
    match loaded_imported[u] {
      Some(ipkg) => out.push(ipkg)
      None => {
        let unode = nodes[topo_order[u]]
        let u_deps = trans_dep_topo[u]
        let u_imports : Array[ImportedPkg] = []
        let mut ui = 0
        while ui < u_deps.length() {
          match loaded_imported[u_deps[ui]] {
            Some(dep_imp) => u_imports.push(dep_imp)
            None => ()
          }
          ui = ui + 1
        }
        let mut loaded_opt : Option[ImportedPkg] = None
        let sp = stub_paths[u]
        if sp.length() > 0 {
          match fs_read(world, sp) {
            Ok(stub_txt) =>
              if stub_txt.length() > 0 {
                let scr = check_source_files_with_imports(
                  unode.name,
                  [unode.name + ".pionstub"],
                  [stub_txt],
                  u_imports,
                  true,
                )
                if scr.diagnostics.length() == 0 {
                  loaded_opt = Some(ImportedPkg::{ name: unode.name, tc: scr.tc })
                }
              }
            Err(_) => ()
          }
        }
        let ipkg = match loaded_opt {
          Some(v) => v
          None => {
            let fcr = check_source_files_with_imports(
              unode.name,
              unode.paths,
              unode.sources,
              u_imports,
              true,
            )
            ImportedPkg::{ name: unode.name, tc: fcr.tc }
          }
        }
        loaded_imported[u] = Some(ipkg)
        out.push(ipkg)
      }
    }
    i = i + 1
  }
  out
}

///|
fn drv_build_workspace_objects(
  world : World,
  root_dir : String,
  release : Bool,
  include_entry : Bool,
  jobs : Int,
  target_override : String,
  sysroot : String,
  need_pic : Bool,
  root_tests : Bool,
) -> Result[DrvWsBuilt, String] {
  let nodes = match drv_load_workspace_nodes(world, root_dir) {
    Err(e) => return Err(e)
    Ok(v) => v
  }
  drv_build_nodes_objects(
    world,
    nodes,
    release,
    include_entry,
    jobs,
    target_override,
    sysroot,
    need_pic,
    root_tests,
  )
}

///|
/// Compiles CAS-missed `.ssa` units to `.o` (parallel `--obj-batch` on direct-object
/// targets, parallel qbe+as otherwise).
fn drv_compile_missed(
  world : World,
  qbe_bin : String,
  qbe_target : String,
  apple_tools : AppleTools,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  sysroot : String,
  miss_ssa_paths : Array[String],
  miss_obj_paths : Array[String],
  jobs : Int,
) -> Result[Unit, String] {
  let n_miss = miss_obj_paths.length()
  let eff_jobs = if jobs > 0 { jobs } else { drv_default_jobs(world) }
  if n_miss == 1 || (n_miss > 1 && !direct_obj && eff_jobs <= 1) {
    let stamp = clock_now_ms(world).to_string()
    let mut mi = 0
    while mi < n_miss {
      match drv_compile_ssa_to_obj(
        world,
        qbe_bin,
        qbe_target,
        apple_tools,
        direct_obj,
        qbe_macos_ver,
        cc1as_triple,
        sysroot,
        miss_ssa_paths[mi],
        miss_obj_paths[mi],
        stamp + "_" + mi.to_string(),
      ) {
        Err(e) => return Err(e)
        Ok(_) => ()
      }
      mi = mi + 1
    }
  } else if n_miss > 1 && direct_obj {
    let nw = if eff_jobs <= 1 {
      1
    } else if n_miss < eff_jobs {
      n_miss
    } else {
      eff_jobs
    }
    let stamp_base = clock_now_ms(world).to_string()
    if nw == 1 {
      let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, true)
      let tmps : Array[String] = []
      let objs : Array[String] = []
      let mut mi = 0
      while mi < n_miss {
        let u_ssa = miss_ssa_paths[mi]
        let u_obj = miss_obj_paths[mi]
        let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
        argv.push(u_ssa)
        argv.push(u_tmp)
        tmps.push(u_tmp)
        objs.push(u_obj)
        mi = mi + 1
      }
      let rc_qbe = proc_exec(world, argv)
      if rc_qbe != 0 {
        let mut j = 0
        while j < tmps.length() {
          let _ = fs_remove(world, tmps[j])
          j = j + 1
        }
        return Err("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
      }
      let mut j = 0
      while j < tmps.length() {
        let _ = fs_rename(world, tmps[j], objs[j])
        j = j + 1
      }
    } else {
      let err_ch : Channel[String] = Channel::new(nw + 1)
      let qmv = qbe_macos_ver
      let qb = qbe_bin
      let qt = qbe_target
      scope(world, fn(s : Scope) -> Unit {
        let mut wi = 0
        while wi < nw {
          let start = wi * n_miss / nw
          let end = (wi + 1) * n_miss / nw
          let spec_sb = StringBuilder()
          let mut mi = start
          while mi < end {
            let u_ssa = miss_ssa_paths[mi]
            let u_obj = miss_obj_paths[mi]
            let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
            spec_sb.write_string(u_ssa)
            spec_sb.write_char('\n')
            spec_sb.write_string(u_tmp)
            spec_sb.write_char('\n')
            spec_sb.write_string(u_obj)
            spec_sb.write_char('\n')
            mi = mi + 1
          }
          let spec = spec_sb.to_string()
          spawn(s, fn() -> Unit {
            let lines = drv_split_lines(spec)
            let argv = drv_qbe_obj_argv(qb, qt, qmv, true)
            let tmps : Array[String] = []
            let objs : Array[String] = []
            let mut li = 0
            while li + 2 < lines.length() {
              argv.push(lines[li])
              argv.push(lines[li + 1])
              tmps.push(lines[li + 1])
              objs.push(lines[li + 2])
              li = li + 3
            }
            let rc_qbe = proc_exec(argv)
            if rc_qbe != 0 {
              let mut j = 0
              while j < tmps.length() {
                let _ = fs_remove(tmps[j])
                j = j + 1
              }
              let _ = err_ch.send(
                "qbe --obj-batch failed with exit code " + rc_qbe.to_string(),
              )
            } else {
              let mut j = 0
              while j < tmps.length() {
                let _ = fs_rename(tmps[j], objs[j])
                j = j + 1
              }
            }
          })
          wi = wi + 1
        }
      })
      err_ch.close()
      match err_ch.recv() {
        Some(err_msg) => return Err(err_msg)
        None => ()
      }
    }
  } else if n_miss > 1 {
    let qbe_arch = drv_target_qbe_arch(qbe_target)
    let use_cc1as = apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0
    let cc1as_bin = apple_tools.clang_bin
    let cc1as_tr = cc1as_triple
    let as_driver = drv_resolve_cc_driver(world, qbe_target, false)
    let as_flags_str = drv_join_char(drv_target_cc_flags(world, qbe_target, sysroot), "\n")
    let mut base = 0
    while base < n_miss {
      let mut batch = n_miss - base
      if batch > eff_jobs {
        batch = eff_jobs
      }
      let err_ch : Channel[String] = Channel::new(batch + 1)
      let stamp_base = clock_now_ms(world).to_string()
      scope(world, fn(s : Scope) -> Unit {
        let mut off = 0
        while off < batch {
          let mi = base + off
          let u_ssa = miss_ssa_paths[mi]
          let u_obj = miss_obj_paths[mi]
          let u_asm = u_obj + ".s." + stamp_base + "_" + mi.to_string()
          let u_tmp = u_obj + ".tmp." + stamp_base + "_" + mi.to_string()
          let qb = qbe_bin
          let qa = qbe_arch
          spawn(s, fn() -> Unit {
            let rc_qbe = proc_exec([qb, "-t", qa, "-o", u_asm, u_ssa])
            if rc_qbe != 0 {
              let _ = fs_remove(u_asm)
              let _ = err_ch.send(
                "qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa,
              )
            } else {
              let rc_as = if use_cc1as {
                proc_exec([
                  cc1as_bin,
                  "-cc1as",
                  "-triple",
                  cc1as_tr,
                  "-filetype",
                  "obj",
                  "-o",
                  u_tmp,
                  u_asm,
                ])
              } else {
                let argv : Array[String] = [as_driver]
                let fls = drv_split_lines(as_flags_str)
                let mut fi = 0
                while fi < fls.length() {
                  if fls[fi].length() > 0 {
                    argv.push(fls[fi])
                  }
                  fi = fi + 1
                }
                argv.push("-c")
                argv.push("-x")
                argv.push("assembler")
                argv.push("-o")
                argv.push(u_tmp)
                argv.push(u_asm)
                proc_exec(argv)
              }
              let _ = fs_remove(u_asm)
              if rc_as != 0 {
                let _ = fs_remove(u_tmp)
                let _ = err_ch.send(
                  "as failed with exit code " + rc_as.to_string() + " on " + u_asm,
                )
              } else {
                let _ = fs_rename(u_tmp, u_obj)
              }
            }
          })
          off = off + 1
        }
      })
      err_ch.close()
      match err_ch.recv() {
        Some(err_msg) => return Err(err_msg)
        None => ()
      }
      base = base + batch
    }
  }
  Ok(())
}

///|
/// Builds already-loaded workspace `nodes` (dependencies first, entry package
/// last): CAS-cached objects for every package, plus the checked entry package.
fn drv_build_nodes_objects(
  world : World,
  nodes : Array[PkgNodeInput],
  release : Bool,
  include_entry : Bool,
  jobs : Int,
  target_override : String,
  sysroot : String,
  need_pic : Bool,
  root_tests : Bool,
) -> Result[DrvWsBuilt, String] {
  if root_tests && nodes.length() > 0 {
    // The root package is pushed last by the DFS; it is never CAS-cached here.
    let rn = nodes[nodes.length() - 1]
    match drv_append_test_sources(world, rn.dir, rn.paths, rn.sources) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut i = 0
  while i < nodes.length() {
    names.push(nodes[i].name)
    dep_lists.push(nodes[i].deps)
    i = i + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return Err(check_result_to_json(topo.diagnostics))
  }

  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let _ = fs_mkdir_p(world, cache_dir + "/bin")

  let qbe_target = drv_pick_target(world, target_override)
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = drv_resolve_rt_lib(world, qbe_target)
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"

  let n = topo.order.length()
  let trans = drv_trans_deps(nodes, topo.order)
  let trans_dep_topo = trans.topo
  let trans_dep_names = trans.names
  let mut k = 0

  let sig_hashes : Map[String, String] = Map([])
  let stub_paths : Array[String] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  k = 0
  while k < n {
    stub_paths.push("")
    loaded_imported.push(None)
    k = k + 1
  }

  let obj_paths : Array[String] = []
  let dep_pkg_names : Array[String] = []
  let miss_ssa_paths : Array[String] = []
  let miss_obj_paths : Array[String] = []
  let miss_keys : Array[String] = []
  let mut root_checked : Option[CheckedPackage] = None
  let link_key_sb = StringBuilder()
  link_key_sb.write_string(compiler_fp)

  k = 0
  while k < n {
    let node = nodes[topo.order[k]]
    let is_entry = k == n - 1
    if is_entry && !include_entry {
      let k_imports = drv_ensure_ws_imports(
        world,
        nodes,
        topo.order,
        trans_dep_topo,
        stub_paths,
        loaded_imported,
        k,
      )
      let cr = check_source_files_with_imports(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        true,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      root_checked = Some(cr)
      k = k + 1
      continue
    }

    let upstream_sigs : Array[String] = []
    let t_names = trans_dep_names[k]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh)
      u = u + 1
    }
    let key = cas_compute_key(
      node.name,
      node.paths,
      node.sources,
      upstream_sigs,
      qbe_target,
      release,
      compiler_fp,
    )
    let obj_path = cache_dir + "/obj/" + key + ".o"
    let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
    let sig_path = cache_dir + "/sig/" + key + ".pionsig"
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"

    let mut cas_hit = false
    if fs_exists(world, obj_path) && fs_exists(world, sig_path) && fs_exists(world, stub_path) {
      match fs_read(world, sig_path) {
        Ok(sig_text) => {
          sig_hashes.set(node.name, sha256_hex(sig_text))
          stub_paths[k] = stub_path
          cas_hit = true
          if trace_cas {
            io_eprintln(
              world,
              "[cas] pkg=" + node.name + " HIT key=" + drv_prefix16(key),
            )
          }
        }
        Err(_) => ()
      }
    }

    if !cas_hit {
      if trace_cas {
        io_eprintln(
          world,
          "[cas] pkg=" + node.name + " MISS key=" + drv_prefix16(key),
        )
      }
      let k_imports = drv_ensure_ws_imports(
        world,
        nodes,
        topo.order,
        trans_dep_topo,
        stub_paths,
        loaded_imported,
        k,
      )
      let cr = check_source_files_with_imports(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        true,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      let pionsig = emit_pionsig(cr.pkg)
      sig_hashes.set(node.name, sha256_hex(pionsig))
      let pionstub = emit_pion_stub(cr.pkg)
      let res = emit_qbe_package_multi(
        cr.pkg,
        cr.tc,
        release,
        is_entry,
        dep_pkg_names,
      )
      let final_ssa = if release { inline_native_rc_ssa(res.ssa) } else { res.ssa }
      let _ = drv_write_text_atomic(world, sig_path, pionsig)
      let _ = drv_write_text_atomic(world, stub_path, pionstub)
      stub_paths[k] = stub_path
      if !drv_write_text_atomic(world, ssa_path, final_ssa) {
        return Err("failed to write CAS ssa: " + ssa_path)
      }
      miss_ssa_paths.push(ssa_path)
      miss_obj_paths.push(obj_path)
      miss_keys.push(key)
    }

    obj_paths.push(obj_path)
    if !is_entry {
      dep_pkg_names.push(node.name)
    }
    link_key_sb.write_string(":")
    link_key_sb.write_string(key)
    k = k + 1
  }

  // Compile all CAS-missed packages (parallel --obj-batch on direct_obj, parallel qbe+as otherwise)
  let n_miss = miss_keys.length()
  match drv_compile_missed(
    world,
    qbe_bin,
    qbe_target,
    apple_tools,
    direct_obj,
    qbe_macos_ver,
    cc1as_triple,
    sysroot,
    miss_ssa_paths,
    miss_obj_paths,
    jobs,
  ) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }

  if n_miss > 0 {
    let miss_sizes : Array[Int64] = []
    let mut mi = 0
    while mi < n_miss {
      let sz = fs_size(world, miss_obj_paths[mi])
      miss_sizes.push(if sz > 0L { sz } else { 0L })
      mi = mi + 1
    }
    drv_cas_record_batch_and_evict(world, cache_dir, miss_keys, miss_sizes)
  }

  let root_pkg_name = nodes[topo.order[n - 1]].name
  // Collect `[link]` / `[link.<os>]` options and compile `c_sources` in topo order (deps first).
  let ws_link_opts = drv_link_opts_empty()
  let cstub_new_keys : Array[String] = []
  let cstub_new_sizes : Array[Int64] = []
  k = 0
  while k < n {
    let node = nodes[topo.order[k]]
    drv_collect_node_link_opts(node, qbe_target, ws_link_opts)
    let cstub_objs : Array[String] = []
    let cstub_keys : Array[String] = []
    match drv_compile_pkg_c_sources(
      world,
      node,
      qbe_target,
      sysroot,
      need_pic,
      rt_lib,
      cache_dir,
      trace_cas,
      cstub_objs,
      cstub_keys,
      cstub_new_keys,
      cstub_new_sizes,
    ) {
      Err(e) => return Err(e)
      Ok(has_cxx) =>
        if has_cxx {
          ws_link_opts.has_cxx = true
        }
    }
    let mut ci = 0
    while ci < cstub_objs.length() {
      obj_paths.push(cstub_objs[ci])
      link_key_sb.write_string(":cstub:")
      link_key_sb.write_string(cstub_keys[ci])
      ci = ci + 1
    }
    let rc_objs : Array[String] = []
    let rc_keys : Array[String] = []
    match drv_compile_pkg_rc_sources(
      world,
      node,
      qbe_target,
      cache_dir,
      trace_cas,
      rc_objs,
      rc_keys,
      cstub_new_keys,
      cstub_new_sizes,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    let mut rci = 0
    while rci < rc_objs.length() {
      push_unique_lib(ws_link_opts.objects, rc_objs[rci])
      link_key_sb.write_string(":rc:")
      link_key_sb.write_string(rc_keys[rci])
      rci = rci + 1
    }
    k = k + 1
  }
  if cstub_new_keys.length() > 0 {
    drv_cas_record_batch_and_evict(world, cache_dir, cstub_new_keys, cstub_new_sizes)
  }
  Ok(DrvWsBuilt::{
    root_pkg_name: root_pkg_name,
    root_checked: root_checked,
    obj_paths: obj_paths,
    dep_pkg_names: dep_pkg_names,
    link_key: sha256_hex(link_key_sb.to_string()),
    link_opts: ws_link_opts,
  })
}

///|
fn drv_build_wasm_targets(
  world : World,
  targets : Array[String],
  release : Bool,
  emit_ssa_path : String,
  out_bin_arg : String,
) -> Result[String, String] {
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/bin")
  let mut pkg_name = "app"
  let mut all_ssa = ""

  let mut handled_ws = false
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        handled_ws = true
        let ws = match drv_load_workspace(world, root_dir) {
          Err(e) => return Err(e)
          Ok(v) => v
        }
        let nodes = ws.nodes
        let names : Array[String] = []
        let dep_lists : Array[Array[String]] = []
        let mut ni = 0
        while ni < nodes.length() {
          names.push(nodes[ni].name)
          dep_lists.push(nodes[ni].deps)
          ni = ni + 1
        }
        let topo = topo_sort_packages(names, dep_lists)
        if topo.diagnostics.length() > 0 {
          return Err(check_result_to_json(topo.diagnostics))
        }
        let n = topo.order.length()
        let trans = drv_trans_deps(nodes, topo.order)
        let trans_dep_topo = trans.topo
        let loaded_imported : Array[Option[ImportedPkg]] = []
        let mut k = 0
        while k < n {
          loaded_imported.push(None)
          k = k + 1
        }
        let dep_pkg_names : Array[String] = []
        let ssa_sb = StringBuilder()
        k = 0
        while k < n {
          let node = nodes[topo.order[k]]
          let is_entry = k == n - 1
          let k_imports : Array[ImportedPkg] = []
          let deps_k = trans_dep_topo[k]
          let mut di = 0
          while di < deps_k.length() {
            match loaded_imported[deps_k[di]] {
              Some(ip) => k_imports.push(ip)
              None => ()
            }
            di = di + 1
          }
          let cr = check_source_files_with_imports(
            node.name,
            node.paths,
            node.sources,
            k_imports,
            true,
          )
          if cr.diagnostics.length() > 0 {
            return Err(check_result_to_json(cr.diagnostics))
          }
          loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
          let res = emit_qbe_package_multi(
            cr.pkg,
            cr.tc,
            release,
            is_entry,
            dep_pkg_names,
          )
          ssa_sb.write_string(wasm_namespace_local_ssa(res.ssa, "u" + k.to_string() + "__"))
          ssa_sb.write_char('\n')
          if !is_entry {
            dep_pkg_names.push(node.name)
          }
          k = k + 1
        }
        pkg_name = nodes[topo.order[n - 1]].name
        all_ssa = ssa_sb.to_string()
      }
      None => ()
    }
  }
  if !handled_ws {
    let loaded = match drv_load_targets(world, targets) {
      Err(msg) => return Err(msg)
      Ok(v) => v
    }
    pkg_name = loaded.pkg_name
    let compiled = match cli_compile_qbe(loaded.pkg_name, loaded.paths, loaded.sources, release) {
      Err(diag_json) => return Err(diag_json)
      Ok(c) => c
    }
    all_ssa = compiled.ssa
  }

  if emit_ssa_path != "" {
    drv_ensure_parent_dir(world, emit_ssa_path)
    if !drv_write_text_atomic(world, emit_ssa_path, all_ssa) {
      return Err("failed to write --emit-ssa file: " + emit_ssa_path)
    }
  }

  let wasm_bytes = emit_wasm_from_ssa(all_ssa)
  let ssa_key = drv_prefix16(sha256_hex(all_ssa))
  let final_wasm = if out_bin_arg != "" {
    out_bin_arg
  } else {
    cache_dir + "/bin/" + pkg_name + "_" + ssa_key + ".wasm"
  }
  if out_bin_arg != "" {
    drv_ensure_parent_dir(world, out_bin_arg)
  }
  let no_wasm_opt = match env_get(world, "PION_NO_WASM_OPT") {
    Some(v) => v == "1"
    None => false
  }
  if release && !no_wasm_opt {
    match proc_exec_capture(world, ["which", "wasm-opt"]) {
      Ok(found) => {
        let wopt_bin = drv_trim_ws(found)
        if wopt_bin != "" {
          let tmp_raw = final_wasm + ".raw.wasm"
          match fs_write_bytes(world, tmp_raw, wasm_bytes) {
            Err(e) => return Err("failed to write raw wasm file " + tmp_raw + ": " + e)
            Ok(_) => ()
          }
          let opt_res = proc_exec_capture(
            world,
            [
              wopt_bin,
              "-Oz",
              "--enable-bulk-memory",
              "--enable-sign-ext",
              "--enable-mutable-globals",
              tmp_raw,
              "-o",
              final_wasm,
            ],
          )
          let _ = fs_remove(world, tmp_raw)
          match opt_res {
            Ok(_) => return Ok(final_wasm)
            Err(e) => return Err("wasm-opt failed on " + final_wasm + ": " + e)
          }
        }
      }
      Err(_) => ()
    }
  }
  match fs_write_bytes(world, final_wasm, wasm_bytes) {
    Err(e) => return Err("failed to write wasm file " + final_wasm + ": " + e)
    Ok(_) => Ok(final_wasm)
  }
}

///|
fn drv_build_targets(
  world : World,
  targets : Array[String],
  release : Bool,
  emit_ssa_path : String,
  emit_asm_path : String,
  out_bin_arg : String,
  jobs : Int,
  target_override : String,
  emit_obj_path : String,
  emit_staticlib_path : String,
  emit_cdylib_path : String,
  sysroot : String,
  cli_libs : Array[String],
) -> Result[String, String] {
  if drv_target_is_wasm(drv_pick_target(world, target_override)) {
    return drv_build_wasm_targets(world, targets, release, emit_ssa_path, out_bin_arg)
  }
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        let built = match drv_build_workspace_objects(
          world,
          root_dir,
          release,
          true,
          jobs,
          target_override,
          sysroot,
          emit_cdylib_path != "",
          false,
        ) {
          Err(e) => return Err(e)
          Ok(v) => v
        }
        if emit_obj_path != "" {
          if built.obj_paths.length() != 1 {
            return Err(
              "--emit-obj needs a single package; workspace has " +
              built.obj_paths.length().to_string() +
              " packages",
            )
          }
          return drv_copy_file(world, built.obj_paths[0], emit_obj_path)
        }
        if emit_staticlib_path != "" {
          return drv_archive_static_lib(world, built.obj_paths, emit_staticlib_path)
        }
        let link_opts = built.link_opts
        let mut li = 0
        while li < cli_libs.length() {
          push_unique_lib(link_opts.libs, cli_libs[li])
          if drv_is_cxx_lib(cli_libs[li]) {
            link_opts.has_cxx = true
          }
          li = li + 1
        }
        let qbe_target = drv_pick_target(world, target_override)
        let rt_lib = drv_resolve_rt_lib(world, qbe_target)
        if emit_cdylib_path != "" {
          return drv_link_shared_lib(
            world,
            qbe_target,
            sysroot,
            built.obj_paths,
            rt_lib,
            link_opts,
            emit_cdylib_path,
          )
        }
        let root_pkg = built.root_pkg_name
        let cache_dir = drv_resolve_cache_dir(world)
        let default_bin = cache_dir +
          "/bin/" +
          root_pkg +
          "_" +
          drv_prefix16(drv_bin_key(world, built.link_key, link_opts))
        let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }
        if out_bin_arg == "" && fs_exists(world, final_bin) {
          return Ok(final_bin)
        }
        if out_bin_arg != "" {
          drv_ensure_parent_dir(world, out_bin_arg)
        }
        let apple_tools = drv_probe_apple_tools(world, qbe_target)
        let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
          apple_tools.macos_ver
        } else {
          "15.0"
        }
        let ld_ver = qbe_macos_ver + ".0"
        match drv_link_objects(
          world,
          qbe_target,
          apple_tools,
          ld_ver,
          sysroot,
          built.obj_paths,
          rt_lib,
          link_opts,
          final_bin,
        ) {
          Err(e) => return Err(e)
          Ok(_) => return Ok(final_bin)
        }
      }
      None => ()
    }
  }
  let loaded = match drv_load_targets(world, targets) {
    Err(msg) => return Err(msg)
    Ok(v) => v
  }
  let pkg_name = loaded.pkg_name
  let paths = loaded.paths
  let sources = loaded.sources

  // Dogfood Pion native multithreading on multi-file builds (deterministic order)
  let src_hashes = drv_parallel_prehash(world, sources, jobs)

  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let _ = fs_mkdir_p(world, cache_dir + "/bin")
  let _ = fs_mkdir_p(world, cache_dir + "/usig")

  let qbe_target = drv_pick_target(world, target_override)
  let qbe_arch = drv_target_qbe_arch(qbe_target)
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib_fp = drv_resolve_rt_lib(world, qbe_target)
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib_fp)
  let fp_pre = drv_prefix16(compiler_fp)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target) && emit_asm_path == ""
  let link_opts = drv_link_opts_from_libs(cli_libs)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let ld_ver = qbe_macos_ver + ".0"

  // Multi-file unit-level parallel compilation + unit-level global CAS + incremental .sig/.stub skip
  if paths.length() > 1 &&
    emit_ssa_path == "" &&
    emit_asm_path == "" &&
    emit_obj_path == "" &&
    emit_staticlib_path == "" &&
    emit_cdylib_path == "" {
    let n_units = paths.length()
    let has_usig : Array[Bool] = []
    let file_sigs : Array[String] = []
    let mut n_usig_hits = 0
    let mut ui = 0
    while ui < n_units {
      let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
      let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
      if fs_exists(world, usig_p) && fs_exists(world, ustub_p) {
        match fs_read(world, usig_p) {
          Ok(sig_txt) => {
            has_usig.push(true)
            file_sigs.push(sig_txt)
            n_usig_hits = n_usig_hits + 1
          }
          Err(_) => {
            has_usig.push(false)
            file_sigs.push("")
          }
        }
      } else {
        has_usig.push(false)
        file_sigs.push("")
      }
      ui = ui + 1
    }

    let mut sigs_hash = ""
    let mut const_units : Array[Int] = []
    let mut has_main = false
    let mut prep_opt : Option[PreparedPackage] = None
    let parsed_dirty : Array[Option[SourceFile]] = []

    if n_usig_hits > 0 {
      let parse_diags : Array[Diagnostic] = []
      ui = 0
      while ui < n_units {
        if has_usig[ui] {
          parsed_dirty.push(None)
        } else {
          let pr = parse_source(paths[ui], sources[ui])
          let mut di = 0
          while di < pr.diagnostics.length() {
            parse_diags.push(pr.diagnostics[di])
            di = di + 1
          }
          file_sigs[ui] = emit_file_sig_entries(pr.file)
          parsed_dirty.push(Some(pr.file))
        }
        ui = ui + 1
      }
      if parse_diags.length() > 0 {
        return Err(check_result_to_json(parse_diags))
      }
      let summary = summarize_file_sigs(pkg_name, file_sigs)
      sigs_hash = summary.sigs_hash
      const_units = summary.const_units
      has_main = summary.has_main
    } else {
      let prep = match cli_prepare_qbe_units(pkg_name, paths, sources) {
        Err(diag_json) => return Err(diag_json)
        Ok(p) => p
      }
      sigs_hash = prep.sigs_hash
      const_units = prep.const_units
      has_main = prep.has_main
      prep_opt = Some(prep)
      // Populate global CAS per-file .sig and .stub for subsequent incremental builds
      ui = 0
      while ui < n_units {
        let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
        let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
        if !fs_exists(world, usig_p) {
          let _ = drv_write_text_atomic(world, usig_p, emit_file_sig_entries(prep.pkg.files[ui]))
        }
        if !fs_exists(world, ustub_p) {
          let _ = drv_write_text_atomic(world, ustub_p, emit_file_stub(prep.pkg.files[ui]))
        }
        ui = ui + 1
      }
    }

    let unit_keys : Array[String] = []
    let obj_paths : Array[String] = []
    let miss_indices : Array[Int] = []
    let is_miss : Array[Bool] = []
    let pkg_key_sb = StringBuilder()
    pkg_key_sb.write_string(compiler_fp)
    pkg_key_sb.write_string(":")
    pkg_key_sb.write_string(sigs_hash)
    ui = 0
    while ui < n_units {
      let ukey = cas_compute_unit_key(
        pkg_name,
        ui,
        paths[ui],
        src_hashes[ui],
        sigs_hash,
        qbe_target,
        release,
        compiler_fp,
      )
      unit_keys.push(ukey)
      pkg_key_sb.write_string(":")
      pkg_key_sb.write_string(ukey)
      let uobj = cache_dir + "/obj/" + ukey + ".o"
      obj_paths.push(uobj)
      if !fs_exists(world, uobj) {
        miss_indices.push(ui)
        is_miss.push(true)
      } else {
        is_miss.push(false)
      }
      ui = ui + 1
    }
    let pkg_key = sha256_hex(pkg_key_sb.to_string())
    let default_bin = cache_dir +
      "/bin/" +
      pkg_name +
      "_" +
      drv_prefix16(drv_bin_key(world, pkg_key, link_opts))
    let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }

    if miss_indices.length() == 0 && out_bin_arg == "" && fs_exists(world, final_bin) {
      return Ok(final_bin)
    }

    if miss_indices.length() > 0 {
      let prep = match prep_opt {
        Some(p) => p
        None => {
          // Incremental selective frontend: parse full source only for missed/uncached units,
          // and lightweight `.stub` for cached unchanged units!
          let files : Array[SourceFile] = []
          let check_file : Array[Bool] = []
          let parse_diags : Array[Diagnostic] = []
          ui = 0
          while ui < n_units {
            if is_miss[ui] || !has_usig[ui] {
              match parsed_dirty[ui] {
                Some(sf) => files.push(sf)
                None => {
                  let pr = parse_source(paths[ui], sources[ui])
                  let mut di = 0
                  while di < pr.diagnostics.length() {
                    parse_diags.push(pr.diagnostics[di])
                    di = di + 1
                  }
                  files.push(pr.file)
                }
              }
              check_file.push(true)
            } else {
              let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
              let stub_loaded = match fs_read(world, ustub_p) {
                Ok(stxt) => {
                  let spr = parse_source(paths[ui], stxt)
                  if spr.diagnostics.length() == 0 {
                    Some(spr.file)
                  } else {
                    None
                  }
                }
                Err(_) => None
              }
              match stub_loaded {
                Some(sf) => {
                  files.push(sf)
                  check_file.push(false)
                }
                None => {
                  let pr = parse_source(paths[ui], sources[ui])
                  let mut di = 0
                  while di < pr.diagnostics.length() {
                    parse_diags.push(pr.diagnostics[di])
                    di = di + 1
                  }
                  files.push(pr.file)
                  check_file.push(true)
                }
              }
            }
            ui = ui + 1
          }
          if parse_diags.length() > 0 {
            return Err(check_result_to_json(parse_diags))
          }
          let sel = match cli_prepare_qbe_units_selective(
            pkg_name,
            files,
            check_file,
            sigs_hash,
            const_units,
          ) {
            Err(diag_json) => return Err(diag_json)
            Ok(p) => p
          }
          has_main = sel.has_main
          // Save newly validated dirty units' .sig and .stub to CAS
          ui = 0
          while ui < n_units {
            if !has_usig[ui] {
              let usig_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".sig"
              let ustub_p = cache_dir + "/usig/" + fp_pre + "_" + src_hashes[ui] + ".stub"
              if !fs_exists(world, usig_p) {
                let _ = drv_write_text_atomic(world, usig_p, file_sigs[ui])
              }
              if !fs_exists(world, ustub_p) {
                let _ = drv_write_text_atomic(world, ustub_p, emit_file_stub(sel.pkg.files[ui]))
              }
            }
            ui = ui + 1
          }
          sel
        }
      }

      // Emit QBE SSA only for cache-missed units
      let mut mi = 0
      while mi < miss_indices.length() {
        let idx = miss_indices[mi]
        let ukey = unit_keys[idx]
        let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
        let raw_ssa = emit_qbe_unit(prep, idx, release)
        let ssa_text = if release { inline_native_rc_ssa(raw_ssa) } else { raw_ssa }
        if !drv_write_text_atomic(world, u_ssa, ssa_text) {
          return Err("failed to write CAS unit ssa: " + u_ssa)
        }
        mi = mi + 1
      }
    }

    // Compile missed units (qbe --obj / --obj-batch or qbe + cc1as/as) in parallel across up to `jobs` OS threads
    let n_miss = miss_indices.length()
    if n_miss == 1 || (n_miss > 1 && !direct_obj && jobs <= 1) {
      let stamp = clock_now_ms(world).to_string()
      let mut mi = 0
      while mi < n_miss {
        let idx = miss_indices[mi]
        let ukey = unit_keys[idx]
        let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
        let u_obj = obj_paths[idx]
        let u_tmp = u_obj + ".tmp." + stamp + "_" + idx.to_string()
        if direct_obj {
          let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
          argv.push("-o")
          argv.push(u_tmp)
          argv.push(u_ssa)
          let rc_qbe = proc_exec(world, argv)
          if rc_qbe != 0 {
            let _ = fs_remove(world, u_tmp)
            return Err("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
          }
          let _ = fs_rename(world, u_tmp, u_obj)
        } else {
          let u_asm = cache_dir + "/obj/" + ukey + ".s." + stamp + "_" + idx.to_string()
          let rc_qbe = proc_exec(world, [qbe_bin, "-t", qbe_arch, "-o", u_asm, u_ssa])
          if rc_qbe != 0 {
            let _ = fs_remove(world, u_asm)
            return Err("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
          }
          let rc_as = drv_assemble_file(
            world,
            qbe_target,
            apple_tools,
            cc1as_triple,
            sysroot,
            u_asm,
            u_tmp,
          )
          let _ = fs_remove(world, u_asm)
          if rc_as != 0 {
            let _ = fs_remove(world, u_tmp)
            return Err("as failed with exit code " + rc_as.to_string())
          }
          let _ = fs_rename(world, u_tmp, u_obj)
        }
        mi = mi + 1
      }
    } else if n_miss > 1 && direct_obj {
      let nw = if jobs <= 1 {
        1
      } else if n_miss < jobs {
        n_miss
      } else {
        jobs
      }
      let stamp_base = clock_now_ms(world).to_string()
      if nw == 1 {
        let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, true)
        let tmps : Array[String] = []
        let objs : Array[String] = []
        let mut mi = 0
        while mi < n_miss {
          let idx = miss_indices[mi]
          let ukey = unit_keys[idx]
          let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
          let u_obj = obj_paths[idx]
          let u_tmp = u_obj + ".tmp." + stamp_base + "_" + idx.to_string()
          argv.push(u_ssa)
          argv.push(u_tmp)
          tmps.push(u_tmp)
          objs.push(u_obj)
          mi = mi + 1
        }
        let rc_qbe = proc_exec(world, argv)
        if rc_qbe != 0 {
          let mut j = 0
          while j < tmps.length() {
            let _ = fs_remove(world, tmps[j])
            j = j + 1
          }
          return Err("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
        }
        let mut j = 0
        while j < tmps.length() {
          let _ = fs_rename(world, tmps[j], objs[j])
          j = j + 1
        }
      } else {
        let err_ch : Channel[String] = Channel::new(nw + 1)
        let qmv = qbe_macos_ver
        let qb = qbe_bin
        let qt = qbe_target
        scope(world, fn(s : Scope) -> Unit {
          let mut wi = 0
          while wi < nw {
            let start = wi * n_miss / nw
            let end = (wi + 1) * n_miss / nw
            let spec_sb = StringBuilder()
            let mut k = start
            while k < end {
              let idx = miss_indices[k]
              let ukey = unit_keys[idx]
              let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
              let u_obj = obj_paths[idx]
              let u_tmp = u_obj + ".tmp." + stamp_base + "_" + idx.to_string()
              spec_sb.write_string(u_ssa)
              spec_sb.write_char('\n')
              spec_sb.write_string(u_tmp)
              spec_sb.write_char('\n')
              spec_sb.write_string(u_obj)
              spec_sb.write_char('\n')
              k = k + 1
            }
            let spec = spec_sb.to_string()
            spawn(s, fn() -> Unit {
              let lines = drv_split_lines(spec)
              let argv = drv_qbe_obj_argv(qb, qt, qmv, true)
              let tmps : Array[String] = []
              let objs : Array[String] = []
              let mut li = 0
              while li + 2 < lines.length() {
                argv.push(lines[li])
                argv.push(lines[li + 1])
                tmps.push(lines[li + 1])
                objs.push(lines[li + 2])
                li = li + 3
              }
              let rc_qbe = proc_exec(argv)
              if rc_qbe != 0 {
                let mut j = 0
                while j < tmps.length() {
                  let _ = fs_remove(tmps[j])
                  j = j + 1
                }
                let _ = err_ch.send("qbe --obj-batch failed with exit code " + rc_qbe.to_string())
              } else {
                let mut j = 0
                while j < tmps.length() {
                  let _ = fs_rename(tmps[j], objs[j])
                  j = j + 1
                }
              }
            })
            wi = wi + 1
          }
        })
        err_ch.close()
        match err_ch.recv() {
          Some(err_msg) => return Err(err_msg)
          None => ()
        }
      }
    } else if n_miss > 1 {
      let use_cc1as = apple_tools.ok && qbe_target == "arm64_apple" && sysroot.length() == 0
      let cc1as_bin = apple_tools.clang_bin
      let cc1as_tr = cc1as_triple
      let as_driver = drv_resolve_cc_driver(world, qbe_target, false)
      let as_flags_str = drv_join_char(drv_target_cc_flags(world, qbe_target, sysroot), "\n")
      let mut base = 0
      while base < n_miss {
        let mut batch = n_miss - base
        if batch > jobs {
          batch = jobs
        }
        let err_ch : Channel[String] = Channel::new(batch + 1)
        let stamp_base = clock_now_ms(world).to_string()
        let use_direct = direct_obj
        let qmv = qbe_macos_ver
        scope(world, fn(s : Scope) -> Unit {
          let mut off = 0
          while off < batch {
            let idx = miss_indices[base + off]
            let ukey = unit_keys[idx]
            let u_ssa = cache_dir + "/ssa/" + ukey + ".ssa"
            let u_obj = obj_paths[idx]
            let u_asm = cache_dir + "/obj/" + ukey + ".s." + stamp_base + "_" + idx.to_string()
            let u_tmp = u_obj + ".tmp." + stamp_base + "_" + idx.to_string()
            let qb = qbe_bin
            let qt = qbe_target
            let qa = qbe_arch
            spawn(s, fn() -> Unit {
              if use_direct {
                let argv = drv_qbe_obj_argv(qb, qt, qmv, false)
                argv.push("-o")
                argv.push(u_tmp)
                argv.push(u_ssa)
                let rc_qbe = proc_exec(argv)
                if rc_qbe != 0 {
                  let _ = fs_remove(u_tmp)
                  let _ = err_ch.send("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
                } else {
                  let _ = fs_rename(u_tmp, u_obj)
                }
              } else {
                let rc_qbe = proc_exec([qb, "-t", qa, "-o", u_asm, u_ssa])
                if rc_qbe != 0 {
                  let _ = fs_remove(u_asm)
                  let _ = err_ch.send("qbe failed with exit code " + rc_qbe.to_string() + " on " + u_ssa)
                } else {
                  let rc_as = if use_cc1as {
                    proc_exec([cc1as_bin, "-cc1as", "-triple", cc1as_tr, "-filetype", "obj", "-o", u_tmp, u_asm])
                  } else {
                    let argv : Array[String] = [as_driver]
                    let fls = drv_split_lines(as_flags_str)
                    let mut fi = 0
                    while fi < fls.length() {
                      if fls[fi].length() > 0 {
                        argv.push(fls[fi])
                      }
                      fi = fi + 1
                    }
                    argv.push("-c")
                    argv.push("-x")
                    argv.push("assembler")
                    argv.push("-o")
                    argv.push(u_tmp)
                    argv.push(u_asm)
                    proc_exec(argv)
                  }
                  let _ = fs_remove(u_asm)
                  if rc_as != 0 {
                    let _ = fs_remove(u_tmp)
                    let _ = err_ch.send("as failed with exit code " + rc_as.to_string() + " on " + u_asm)
                  } else {
                    let _ = fs_rename(u_tmp, u_obj)
                  }
                }
              }
            })
            off = off + 1
          }
        })
        err_ch.close()
        match err_ch.recv() {
          Some(err_msg) => return Err(err_msg)
          None => ()
        }
        base = base + batch
      }
    }

    if !has_main && out_bin_arg == "" {
      return Ok(obj_paths[0])
    }

    if out_bin_arg != "" {
      drv_ensure_parent_dir(world, out_bin_arg)
    }
    let rt_lib = drv_resolve_rt_lib(world, qbe_target)
    match drv_link_objects(world, qbe_target, apple_tools, ld_ver, sysroot, obj_paths, rt_lib, link_opts, final_bin) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
    return Ok(final_bin)
  }
  let key = cas_compute_key(
    pkg_name,
    paths,
    sources,
    [],
    qbe_target,
    release,
    compiler_fp,
  )
  let sig_path = cache_dir + "/sig/" + key + ".pionsig"
  let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
  let obj_path = cache_dir + "/obj/" + key + ".o"
  let default_bin = cache_dir +
    "/bin/" +
    pkg_name +
    "_" +
    drv_prefix16(drv_bin_key(world, key, link_opts))
  let final_bin = if out_bin_arg != "" { out_bin_arg } else { default_bin }

  let asm_only = emit_asm_path != "" &&
    out_bin_arg == "" &&
    emit_obj_path == "" &&
    emit_staticlib_path == "" &&
    emit_cdylib_path == ""
  let mut has_main = true
  let cache_hit = fs_exists(world, obj_path) &&
    fs_exists(world, ssa_path) &&
    fs_exists(world, sig_path)

  if asm_only && fs_exists(world, ssa_path) {
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      match fs_read(world, ssa_path) {
        Err(msg) => return Err("failed to read cached ssa: " + msg)
        Ok(ssa_cached) =>
          if !drv_write_text_atomic(world, emit_ssa_path, ssa_cached) {
            return Err("failed to write --emit-ssa file: " + emit_ssa_path)
          }
      }
    }
    drv_ensure_parent_dir(world, emit_asm_path)
    let rc_qbe = proc_exec(
      world,
      [qbe_bin, "-t", qbe_arch, "-o", emit_asm_path, ssa_path],
    )
    if rc_qbe != 0 {
      return Err(
        "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
      )
    }
    return Ok(emit_asm_path)
  }

  if cache_hit {
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      match fs_read(world, ssa_path) {
        Err(msg) => return Err("failed to read cached ssa: " + msg)
        Ok(ssa_cached) =>
          if !drv_write_text_atomic(world, emit_ssa_path, ssa_cached) {
            return Err("failed to write --emit-ssa file: " + emit_ssa_path)
          }
      }
    }
    if emit_asm_path != "" {
      drv_ensure_parent_dir(world, emit_asm_path)
      let rc_qbe = proc_exec(
        world,
        [qbe_bin, "-t", qbe_arch, "-o", emit_asm_path, ssa_path],
      )
      if rc_qbe != 0 {
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
        )
      }
    }
    let sz_sig = fs_size(world, sig_path)
    let sz_ssa = fs_size(world, ssa_path)
    let sz_obj = fs_size(world, obj_path)
    let total_sz = (if sz_sig > 0L { sz_sig } else { 0L }) +
      (if sz_ssa > 0L { sz_ssa } else { 0L }) +
      (if sz_obj > 0L { sz_obj } else { 0L })
    drv_cas_record_and_evict(world, cache_dir, key, total_sz)
    if emit_obj_path == "" &&
      emit_staticlib_path == "" &&
      emit_cdylib_path == "" &&
      out_bin_arg == "" &&
      fs_exists(world, final_bin) {
      return Ok(final_bin)
    }
    if emit_obj_path == "" &&
      emit_staticlib_path == "" &&
      emit_cdylib_path == "" &&
      (emit_ssa_path != "" || emit_asm_path != "") &&
      out_bin_arg == "" {
      return Ok(obj_path)
    }
  } else {
    let compiled = match cli_compile_qbe(pkg_name, paths, sources, release) {
      Err(diag_json) => return Err(diag_json)
      Ok(c) => c
    }
    let final_ssa = if release { inline_native_rc_ssa(compiled.ssa) } else { compiled.ssa }
    has_main = compiled.has_main
    if !drv_write_text_atomic(world, sig_path, compiled.sig) {
      return Err("failed to write CAS sig: " + sig_path)
    }
    if !drv_write_text_atomic(world, ssa_path, final_ssa) {
      return Err("failed to write CAS ssa: " + ssa_path)
    }
    if emit_ssa_path != "" {
      drv_ensure_parent_dir(world, emit_ssa_path)
      if !drv_write_text_atomic(world, emit_ssa_path, final_ssa) {
        return Err("failed to write --emit-ssa file: " + emit_ssa_path)
      }
    }
    if asm_only {
      drv_ensure_parent_dir(world, emit_asm_path)
      let rc_qbe = proc_exec(
        world,
        [qbe_bin, "-t", qbe_arch, "-o", emit_asm_path, ssa_path],
      )
      if rc_qbe != 0 {
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
        )
      }
      return Ok(emit_asm_path)
    }

    let stamp = clock_now_ms(world).to_string()
    let obj_tmp = obj_path + ".tmp." + stamp
    if direct_obj {
      let argv = drv_qbe_obj_argv(qbe_bin, qbe_target, qbe_macos_ver, false)
      argv.push("-o")
      argv.push(obj_tmp)
      argv.push(ssa_path)
      let rc_qbe = proc_exec(world, argv)
      if rc_qbe != 0 {
        let _ = fs_remove(world, obj_tmp)
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
        )
      }
      let _ = fs_rename(world, obj_tmp, obj_path)
    } else {
      let asm_path = cache_dir + "/obj/" + key + ".s." + stamp
      let rc_qbe = proc_exec(
        world,
        [qbe_bin, "-t", qbe_arch, "-o", asm_path, ssa_path],
      )
      if rc_qbe != 0 {
        let _ = fs_remove(world, asm_path)
        return Err(
          "qbe failed with exit code " + rc_qbe.to_string() + " on " + ssa_path,
        )
      }
      if emit_asm_path != "" {
        drv_ensure_parent_dir(world, emit_asm_path)
        match fs_read(world, asm_path) {
          Err(msg) => {
            let _ = fs_remove(world, asm_path)
            return Err("failed to read asm: " + msg)
          }
          Ok(asm_text) =>
            if !drv_write_text_atomic(world, emit_asm_path, asm_text) {
              let _ = fs_remove(world, asm_path)
              return Err("failed to write --emit-asm file: " + emit_asm_path)
            }
        }
      }
      let rc_as = drv_assemble_file(
        world,
        qbe_target,
        apple_tools,
        cc1as_triple,
        sysroot,
        asm_path,
        obj_tmp,
      )
      let _ = fs_remove(world, asm_path)
      if rc_as != 0 {
        let _ = fs_remove(world, obj_tmp)
        return Err("as failed with exit code " + rc_as.to_string())
      }
      let _ = fs_rename(world, obj_tmp, obj_path)
    }

    let sz_sig = fs_size(world, sig_path)
    let sz_ssa = fs_size(world, ssa_path)
    let sz_obj = fs_size(world, obj_path)
    let total_sz = (if sz_sig > 0L { sz_sig } else { 0L }) +
      (if sz_ssa > 0L { sz_ssa } else { 0L }) +
      (if sz_obj > 0L { sz_obj } else { 0L })
    drv_cas_record_and_evict(world, cache_dir, key, total_sz)
  }

  if emit_obj_path != "" {
    return drv_copy_file(world, obj_path, emit_obj_path)
  }
  if emit_staticlib_path != "" {
    return drv_archive_static_lib(world, [obj_path], emit_staticlib_path)
  }
  let rt_lib = drv_resolve_rt_lib(world, qbe_target)
  if emit_cdylib_path != "" {
    return drv_link_shared_lib(
      world,
      qbe_target,
      sysroot,
      [obj_path],
      rt_lib,
      link_opts,
      emit_cdylib_path,
    )
  }

  if !has_main && out_bin_arg == "" {
    return Ok(obj_path)
  }

  if out_bin_arg != "" {
    drv_ensure_parent_dir(world, out_bin_arg)
  }
  match drv_link_objects(world, qbe_target, apple_tools, ld_ver, sysroot, [obj_path], rt_lib, link_opts, final_bin) {
    Err(e) => Err(e)
    Ok(_) => Ok(final_bin)
  }
}

///|
/// One package's tests to run: its test SSA, the transitive dependency objects
/// it links against (topo order) and the test indices selected by `--filter`.
struct DrvTestJob {
  label : String
  ssa : String
  names : Array[String]
  run_idx : Array[Int]
  dep_objs : Array[String]
  link_opts : DrvLinkOpts
}

///|
/// Splits `s` at every `code` unit ("" -> no fields).
fn drv_split_char(s : String, code : Int) -> Array[String] {
  let out : Array[String] = []
  if s.length() == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == code {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(s, start, s.length()))
  out
}

///|
fn drv_join_char(parts : Array[String], sep : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < parts.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(parts[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Names of the `test "..."` blocks of `pkg`, in emission order (the index a
/// test binary takes as its argument).
fn drv_test_names(pkg : Package) -> Array[String] {
  let out : Array[String] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DTest(td) => out.push(td.name)
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  out
}

///|
fn drv_filter_tests(names : Array[String], filter : String) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < names.length() {
    if filter.length() == 0 || drv_find_substr(names[i], filter, 0) >= 0 {
      out.push(i)
    }
    i = i + 1
  }
  out
}

///|
/// Compiles (when `need_qbe`) and links one test binary, atomically via rename.
fn drv_build_test_bin(
  world : World,
  apple_tools : AppleTools,
  qbe_bin : String,
  qbe_target : String,
  direct_obj : Bool,
  qbe_macos_ver : String,
  cc1as_triple : String,
  rt_lib : String,
  ssa_path : String,
  obj_path : String,
  bin_path : String,
  need_qbe : Bool,
  link_opts : DrvLinkOpts,
  deps : Array[String],
  stamp : String,
) -> Result[Unit, String] {
  if need_qbe {
    match drv_compile_ssa_to_obj(
      world,
      qbe_bin,
      qbe_target,
      apple_tools,
      direct_obj,
      qbe_macos_ver,
      cc1as_triple,
      "",
      ssa_path,
      obj_path,
      stamp,
    ) {
      Err(e) => return Err(e)
      Ok(_) => ()
    }
  }
  let objs : Array[String] = []
  let mut i = 0
  while i < deps.length() {
    objs.push(deps[i])
    i = i + 1
  }
  objs.push(obj_path)
  let tmp = bin_path + ".tmp." + stamp
  match drv_link_objects(world, qbe_target, apple_tools, qbe_macos_ver + ".0", "", objs, rt_lib, link_opts, tmp) {
    Err(e) => {
      let _ = fs_remove(world, tmp)
      return Err(e)
    }
    Ok(_) => ()
  }
  if !fs_rename(world, tmp, bin_path) {
    let _ = fs_remove(world, tmp)
    if !fs_exists(world, bin_path) {
      return Err("failed to move test binary into " + bin_path)
    }
  }
  Ok(())
}

///|
/// The tab position of a `<index>\t<payload>` worker message (-1 when none).
fn drv_msg_tab(msg : String) -> Int {
  let mut i = 0
  while i < msg.length() {
    if str_code_at(msg, i) == 9 {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn drv_msg_idx(msg : String) -> Int {
  let tab = drv_msg_tab(msg)
  if tab <= 0 {
    return -1
  }
  let digits = slice_str(msg, 0, tab)
  if digits == "0" {
    return 0
  }
  drv_parse_pos_int64(digits, -1L).to_int()
}

///|
fn drv_msg_payload(msg : String) -> String {
  let tab = drv_msg_tab(msg)
  if tab < 0 {
    msg
  } else {
    slice_str(msg, tab + 1, msg.length())
  }
}

///|
/// The ASCII unit separator, joining path lists inside one worker spec line.
fn drv_unit_sep() -> String {
  let sb = StringBuilder()
  let us = 31
  sb.write_char(us.unsafe_to_char())
  sb.to_string()
}

///|
/// Builds and runs every job's tests. Test binaries live in the global CAS
/// (`$PION_CACHE_DIR/testbin/`): the test object is keyed by the test SSA, the
/// binary by that object plus every linked dependency object (CAS path, size
/// and mtime: a dependency whose source or upstream interface changed has a
/// new CAS path, so no stale binary can be reused) and the link libraries.
/// Missing binaries are compiled and linked in parallel, then every selected
/// test runs in its own process, also in parallel (bounded by `par`). Results
/// are appended in job order, then test index order.
fn drv_exec_test_jobs(
  world : World,
  jobs_list : Array[DrvTestJob],
  par : Int,
  as_json : Bool,
  out_pkgs : Array[String],
  out_names : Array[String],
  out_oks : Array[Bool],
) -> Result[Unit, String] {
  if jobs_list.length() == 0 {
    return Ok(())
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let tb_dir = cache_dir + "/testbin"
  let _ = fs_mkdir_p(world, tb_dir)
  let qbe_target = drv_resolve_qbe_target(world)
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = drv_resolve_rt_lib(world, qbe_target)
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let nw_max = if par > 0 { par } else { drv_default_jobs(world) }

  let usep = drv_unit_sep()
  let bins : Array[String] = []
  let build_lines : Array[String] = []
  let new_keys : Array[String] = []
  let new_ssa : Array[String] = []
  // rcs[gi]: exit code of the gi-th selected test (job order, then index order).
  let rcs : Array[Int] = []
  let mut gi_base = 0
  let mut j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let job_gi = gi_base
    let mut ri = 0
    while ri < job.run_idx.length() {
      rcs.push(-1)
      ri = ri + 1
    }
    gi_base = gi_base + job.run_idx.length()
    let okey = sha256_hex(
      compiler_fp +
      "|testobj|" +
      qbe_target +
      "|" +
      qbe_macos_ver +
      "|" +
      sha256_hex(job.ssa),
    )
    let dsb = StringBuilder()
    dsb.write_string(compiler_fp)
    dsb.write_string("|testbin|")
    dsb.write_string(qbe_target)
    dsb.write_string("|")
    dsb.write_string(qbe_macos_ver)
    dsb.write_string("|")
    dsb.write_string(okey)
    let mut di = 0
    while di < job.dep_objs.length() {
      let dp = job.dep_objs[di]
      dsb.write_string("|")
      dsb.write_string(dp)
      dsb.write_string(":")
      dsb.write_string(fs_size(world, dp).to_string())
      dsb.write_string(":")
      dsb.write_string(fs_mtime_ms(world, dp).to_string())
      di = di + 1
    }
    dsb.write_string(drv_link_opts_key(world, job.link_opts))
    let bkey = sha256_hex(dsb.to_string())
    let obj_path = tb_dir + "/" + okey + ".o"
    let bin_path = tb_dir + "/" + bkey
    bins.push(bin_path)
    if fs_exists(world, bin_path) {
      if trace_cas {
        io_eprintln(world, "[cas] test=" + job.label + " HIT bin=" + drv_prefix16(bkey))
      }
    } else {
      let need_qbe = !fs_exists(world, obj_path)
      let ssa_path = tb_dir + "/" + okey + ".ssa." + clock_now_ms(world).to_string() + "_" + j.to_string()
      if need_qbe {
        if !drv_write_text_atomic(world, ssa_path, job.ssa) {
          return Err("failed to write test ssa: " + ssa_path)
        }
        new_ssa.push(ssa_path)
        new_keys.push(okey + ".o")
      }
      if trace_cas {
        io_eprintln(
          world,
          "[cas] test=" +
          job.label +
          " MISS bin=" +
          drv_prefix16(bkey) +
          (if need_qbe { " obj=MISS" } else { " obj=HIT" }),
        )
      }
      new_keys.push(bkey)
      build_lines.push(
        ssa_path +
        "\t" +
        obj_path +
        "\t" +
        bin_path +
        "\t" +
        (if need_qbe { "1" } else { "0" }) +
        "\t" +
        drv_join_char(job.link_opts.libs, usep) +
        "\t" +
        drv_join_char(job.dep_objs, usep) +
        "\t" +
        (if job.run_idx.length() > 0 { job.run_idx[0].to_string() } else { "-" }) +
        "\t" +
        job_gi.to_string() +
        "\t" +
        drv_join_char(job.link_opts.frameworks, usep) +
        "\t" +
        drv_join_char(job.link_opts.search_paths, usep) +
        "\t" +
        drv_join_char(job.link_opts.rpaths, usep) +
        "\t" +
        drv_join_char(job.link_opts.objects, usep) +
        "\t" +
        drv_join_char(job.link_opts.flags, usep) +
        "\t" +
        (if job.link_opts.has_cxx { "1" } else { "0" }),
      )
    }
    j = j + 1
  }

  // Phase 1: compile + link the missing test binaries in parallel; each worker
  // runs its binary's first selected test right away, so the (macOS: ~150 ms
  // first-exec code-signing assessment of a new) binary overlaps other builds.
  let nb = build_lines.length()
  if nb > 0 {
    let spec = drv_join_char(build_lines, "\n")
    let nw = if nb < nw_max { nb } else { nw_max }
    let cursor = AtomicInt::new(0)
    let err_ch : Channel[String] = Channel::new(nb + 1)
    let first_ch : Channel[String] = Channel::new(nb + 1)
    let stamp = clock_now_ms(world).to_string()
    let tools = apple_tools
    let qb = qbe_bin
    let qt = qbe_target
    let qmv = qbe_macos_ver
    let tr = cc1as_triple
    let rt = rt_lib
    let dobj = direct_obj
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let items = drv_split_char(spec, 10)
          while true {
            let bi = cursor.fetch_add(1)
            if bi >= items.length() {
              break
            }
            let f = drv_split_char(items[bi], 9)
            if f.length() < 14 {
              let _ = err_ch.send(bi.to_string() + "\tmalformed test build spec")
              continue
            }
            let job_opts = DrvLinkOpts::{
              libs: drv_split_char(f[4], 31),
              frameworks: drv_split_char(f[8], 31),
              search_paths: drv_split_char(f[9], 31),
              rpaths: drv_split_char(f[10], 31),
              objects: drv_split_char(f[11], 31),
              flags: drv_split_char(f[12], 31),
              has_cxx: f[13] == "1",
            }
            match drv_build_test_bin(
              world,
              tools,
              qb,
              qt,
              dobj,
              qmv,
              tr,
              rt,
              f[0],
              f[1],
              f[2],
              f[3] == "1",
              job_opts,
              drv_split_char(f[5], 31),
              stamp + "_" + bi.to_string(),
            ) {
              Err(e) => {
                let _ = err_ch.send(bi.to_string() + "\t" + e)
              }
              Ok(_) => {
                if f[6] != "-" {
                  let rc = proc_exec(world, [f[2], f[6]])
                  let _ = first_ch.send(f[7] + "\t" + rc.to_string())
                }
              }
            }
          }
        })
        wi = wi + 1
      }
    })
    err_ch.close()
    first_ch.close()
    while true {
      match first_ch.recv() {
        Some(msg) => {
          let gi = drv_msg_idx(msg)
          if gi >= 0 && gi < rcs.length() {
            rcs[gi] = if drv_msg_payload(msg) == "0" { 0 } else { 1 }
          }
        }
        None => break
      }
    }
    let mut si = 0
    while si < new_ssa.length() {
      let _ = fs_remove(world, new_ssa[si])
      si = si + 1
    }
    let mut has_err = false
    let mut first_idx = 0
    let mut first_msg = ""
    while true {
      match err_ch.recv() {
        Some(msg) => {
          let ei = drv_msg_idx(msg)
          if !has_err || ei < first_idx {
            has_err = true
            first_idx = ei
            first_msg = drv_msg_payload(msg)
          }
        }
        None => break
      }
    }
    if has_err {
      return Err(first_msg)
    }
    let sizes : Array[Int64] = []
    let mut ki = 0
    while ki < new_keys.length() {
      let sz = fs_size(world, tb_dir + "/" + new_keys[ki])
      sizes.push(if sz > 0L { sz } else { 0L })
      ki = ki + 1
    }
    let tkeys : Array[String] = []
    ki = 0
    while ki < new_keys.length() {
      tkeys.push("testbin:" + new_keys[ki])
      ki = ki + 1
    }
    drv_cas_record_batch_and_evict(world, cache_dir, tkeys, sizes)
  }

  if trace_cas {
    io_eprintln(world, "[test] bins built=" + nb.to_string())
  }
  // Phase 2: run every remaining selected test in its own process, in parallel.
  let t_run0 = clock_now_ms(world)
  let run_lines : Array[String] = []
  let mut gi_run = 0
  j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let mut ri = 0
    while ri < job.run_idx.length() {
      if rcs[gi_run] < 0 {
        run_lines.push(bins[j] + "\t" + job.run_idx[ri].to_string() + "\t" + gi_run.to_string())
      }
      gi_run = gi_run + 1
      ri = ri + 1
    }
    j = j + 1
  }
  let nr = run_lines.length()
  if nr == 1 || nw_max <= 1 {
    let mut ri = 0
    while ri < nr {
      let f = drv_split_char(run_lines[ri], 9)
      let gi = drv_msg_idx(f[2] + "\t")
      let rc = proc_exec(world, [f[0], f[1]])
      rcs[gi] = if rc == 0 { 0 } else { 1 }
      ri = ri + 1
    }
  } else if nr > 1 {
    let spec = drv_join_char(run_lines, "\n")
    let nw = if nr < nw_max { nr } else { nw_max }
    let cursor = AtomicInt::new(0)
    let res_ch : Channel[String] = Channel::new(nr + 1)
    scope(world, fn(s : Scope) -> Unit {
      let mut wi = 0
      while wi < nw {
        spawn(s, fn() -> Unit {
          let items = drv_split_char(spec, 10)
          while true {
            let ri = cursor.fetch_add(1)
            if ri >= items.length() {
              break
            }
            let f = drv_split_char(items[ri], 9)
            let rc = proc_exec(world, [f[0], f[1]])
            let _ = res_ch.send(f[2] + "\t" + rc.to_string())
          }
        })
        wi = wi + 1
      }
    })
    res_ch.close()
    while true {
      match res_ch.recv() {
        Some(msg) => {
          let gi = drv_msg_idx(msg)
          if gi >= 0 && gi < rcs.length() {
            rcs[gi] = if drv_msg_payload(msg) == "0" { 0 } else { 1 }
          }
        }
        None => break
      }
    }
  }

  if trace_cas {
    io_eprintln(world, "[test] run=" + (clock_now_ms(world) - t_run0).to_string() + "ms tests=" + nr.to_string())
  }
  let mut gi = 0
  j = 0
  while j < jobs_list.length() {
    let job = jobs_list[j]
    let mut ri = 0
    while ri < job.run_idx.length() {
      let tname = job.names[job.run_idx[ri]]
      let ok = rcs[gi] == 0
      out_pkgs.push(job.label)
      out_names.push(tname)
      out_oks.push(ok)
      if !as_json {
        let shown = if job.label.length() > 0 {
          job.label + "::" + tname
        } else {
          tname
        }
        io_println(world, "test " + shown + " ... " + (if ok { "ok" } else { "FAILED" }))
      }
      gi = gi + 1
      ri = ri + 1
    }
    j = j + 1
  }
  Ok(())
}

///|
struct DrvTrans {
  topo : Array[Array[Int]]
  names : Array[Array[String]]
}

///|
/// Exact transitive dependency closure of every package, in topo order (`topo`)
/// and as sorted names (`names`, the CAS key's upstream list).
fn drv_trans_deps(nodes : Array[PkgNodeInput], order : Array[Int]) -> DrvTrans {
  let n = order.length()
  let name_to_topo : Map[String, Int] = Map([])
  let mut k = 0
  while k < n {
    name_to_topo.set(nodes[order[k]].name, k)
    k = k + 1
  }
  let trans_dep_topo : Array[Array[Int]] = []
  let trans_dep_names : Array[Array[String]] = []
  k = 0
  while k < n {
    let seen : Array[Bool] = []
    let mut si = 0
    while si < n {
      seen.push(false)
      si = si + 1
    }
    let node = nodes[order[k]]
    let mut di = 0
    while di < node.deps.length() {
      match name_to_topo.get(node.deps[di]) {
        Some(didx) => {
          seen[didx] = true
          let dtrans = trans_dep_topo[didx]
          let mut ti = 0
          while ti < dtrans.length() {
            seen[dtrans[ti]] = true
            ti = ti + 1
          }
        }
        None => ()
      }
      di = di + 1
    }
    let t_topo : Array[Int] = []
    let t_names : Array[String] = []
    let mut u = 0
    while u < k {
      if seen[u] {
        t_topo.push(u)
        t_names.push(nodes[order[u]].name)
      }
      u = u + 1
    }
    drv_sort_strings(t_names)
    trans_dep_topo.push(t_topo)
    trans_dep_names.push(t_names)
    k = k + 1
  }
  DrvTrans::{ topo: trans_dep_topo, names: trans_dep_names }
}

///|
struct DrvNeededObjs {
  obj_paths : Array[String]
  stub_paths : Array[String]
  loaded_imported : Array[Option[ImportedPkg]]
}

///|
/// One CAS build over the whole workspace graph: every package with
/// `need[topo_idx]` gets its object (hit or compiled, all misses compiled in
/// one parallel batch) and its interface stub, shared by every tested package.
fn drv_build_needed_objects(
  world : World,
  nodes : Array[PkgNodeInput],
  order : Array[Int],
  trans : DrvTrans,
  need : Array[Bool],
  jobs : Int,
) -> Result[DrvNeededObjs, String] {
  let n = order.length()
  let obj_paths : Array[String] = []
  let stub_paths : Array[String] = []
  let loaded_imported : Array[Option[ImportedPkg]] = []
  let mut k = 0
  while k < n {
    obj_paths.push("")
    stub_paths.push("")
    loaded_imported.push(None)
    k = k + 1
  }
  let mut any = false
  k = 0
  while k < n {
    if need[k] {
      any = true
    }
    k = k + 1
  }
  if !any {
    return Ok(DrvNeededObjs::{
      obj_paths: obj_paths,
      stub_paths: stub_paths,
      loaded_imported: loaded_imported,
    })
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let _ = fs_mkdir_p(world, cache_dir + "/sig")
  let _ = fs_mkdir_p(world, cache_dir + "/ssa")
  let _ = fs_mkdir_p(world, cache_dir + "/obj")
  let qbe_target = drv_resolve_qbe_target(world)
  let qbe_bin = drv_resolve_qbe_bin(world)
  let rt_lib = drv_resolve_rt_lib(world, qbe_target)
  let compiler_fp = drv_compute_compiler_fp(world, qbe_bin, rt_lib)
  let apple_tools = drv_probe_apple_tools(world, qbe_target)
  let direct_obj = drv_direct_obj_target(world, qbe_target)
  let qbe_macos_ver = if apple_tools.macos_ver.length() > 0 {
    apple_tools.macos_ver
  } else {
    "15.0"
  }
  let cc1as_triple = "arm64-apple-macosx" + qbe_macos_ver + ".0"
  let trace_cas = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let sig_hashes : Map[String, String] = Map([])
  let miss_ssa_paths : Array[String] = []
  let miss_obj_paths : Array[String] = []
  let miss_keys : Array[String] = []
  k = 0
  while k < n {
    if !need[k] {
      k = k + 1
      continue
    }
    let node = nodes[order[k]]
    let upstream_sigs : Array[String] = []
    let t_names = trans.names[k]
    let mut u = 0
    while u < t_names.length() {
      let un = t_names[u]
      let sh = match sig_hashes.get(un) {
        Some(h) => h
        None => ""
      }
      upstream_sigs.push(un + ":" + sh)
      u = u + 1
    }
    let key = cas_compute_key(
      node.name,
      node.paths,
      node.sources,
      upstream_sigs,
      qbe_target,
      false,
      compiler_fp,
    )
    let obj_path = cache_dir + "/obj/" + key + ".o"
    let ssa_path = cache_dir + "/ssa/" + key + ".ssa"
    let sig_path = cache_dir + "/sig/" + key + ".pionsig"
    let stub_path = cache_dir + "/sig/" + key + ".pionstub"
    let mut cas_hit = false
    if fs_exists(world, obj_path) && fs_exists(world, sig_path) && fs_exists(world, stub_path) {
      match fs_read(world, sig_path) {
        Ok(sig_text) => {
          sig_hashes.set(node.name, sha256_hex(sig_text))
          stub_paths[k] = stub_path
          cas_hit = true
          if trace_cas {
            io_eprintln(world, "[cas] pkg=" + node.name + " HIT key=" + drv_prefix16(key))
          }
        }
        Err(_) => ()
      }
    }
    if !cas_hit {
      if trace_cas {
        io_eprintln(world, "[cas] pkg=" + node.name + " MISS key=" + drv_prefix16(key))
      }
      let k_imports = drv_ensure_ws_imports(
        world,
        nodes,
        order,
        trans.topo,
        stub_paths,
        loaded_imported,
        k,
      )
      let cr = check_source_files_with_imports(
        node.name,
        node.paths,
        node.sources,
        k_imports,
        true,
      )
      if cr.diagnostics.length() > 0 {
        return Err(check_result_to_json(cr.diagnostics))
      }
      loaded_imported[k] = Some(ImportedPkg::{ name: node.name, tc: cr.tc })
      let pionsig = emit_pionsig(cr.pkg)
      sig_hashes.set(node.name, sha256_hex(pionsig))
      let pionstub = emit_pion_stub(cr.pkg)
      let res = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, [])
      let _ = drv_write_text_atomic(world, sig_path, pionsig)
      let _ = drv_write_text_atomic(world, stub_path, pionstub)
      stub_paths[k] = stub_path
      if !drv_write_text_atomic(world, ssa_path, res.ssa) {
        return Err("failed to write CAS ssa: " + ssa_path)
      }
      miss_ssa_paths.push(ssa_path)
      miss_obj_paths.push(obj_path)
      miss_keys.push(key)
    }
    obj_paths[k] = obj_path
    k = k + 1
  }
  match drv_compile_missed(
    world,
    qbe_bin,
    qbe_target,
    apple_tools,
    direct_obj,
    qbe_macos_ver,
    cc1as_triple,
    "",
    miss_ssa_paths,
    miss_obj_paths,
    jobs,
  ) {
    Err(e) => return Err(e)
    Ok(_) => ()
  }
  if miss_keys.length() > 0 {
    let miss_sizes : Array[Int64] = []
    let mut mi = 0
    while mi < miss_keys.length() {
      let sz = fs_size(world, miss_obj_paths[mi])
      miss_sizes.push(if sz > 0L { sz } else { 0L })
      mi = mi + 1
    }
    drv_cas_record_batch_and_evict(world, cache_dir, miss_keys, miss_sizes)
  }
  Ok(DrvNeededObjs::{
    obj_paths: obj_paths,
    stub_paths: stub_paths,
    loaded_imported: loaded_imported,
  })
}

///|
fn drv_print_test_summary(world : World, oks : Array[Bool]) -> Int {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < oks.length() {
    if oks[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  io_println(
    world,
    "test result: " +
    (if failed == 0 { "ok" } else { "FAILED" }) +
    ". " +
    passed.to_string() +
    " passed; " +
    failed.to_string() +
    " failed",
  )
  if failed == 0 { 0 } else { 1 }
}

///|
/// `pionc test <workspace>`: runs the tests of every local package (dependencies
/// first, git-cache packages excluded), or only `only_pkg`, in one merged report.
/// The workspace graph is loaded, CAS-built and interface-checked once; packages
/// without (matching) tests stop after their type check; test binaries come
/// from the CAS and build and run in parallel (`drv_exec_test_jobs`).
fn drv_run_ws_tests(
  world : World,
  root_dir : String,
  as_json : Bool,
  filter : String,
  cli_libs : Array[String],
  only_pkg : String,
  jobs : Int,
) -> Int {
  let trace = drv_env_str(world, "PION_CAS_TRACE") == "1"
  let t_start = clock_now_ms(world)
  let ws = match drv_load_workspace(world, root_dir) {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let nodes = ws.nodes
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    io_println(world, check_result_to_json(topo.diagnostics))
    return 1
  }
  let selected : Array[Int] = []
  ni = 0
  while ni < nodes.length() {
    let local = !drv_is_external_pkg(ws.git_root, nodes[ni].dir)
    if only_pkg.length() > 0 {
      if nodes[ni].name == only_pkg {
        selected.push(ni)
      }
    } else if local {
      selected.push(ni)
    }
    ni = ni + 1
  }
  if only_pkg.length() > 0 && selected.length() == 0 {
    io_eprintln(world, "error: no package `" + only_pkg + "` in workspace " + root_dir)
    return 1
  }
  let n = topo.order.length()
  let node_to_topo : Array[Int] = []
  ni = 0
  while ni < nodes.length() {
    node_to_topo.push(-1)
    ni = ni + 1
  }
  let mut k = 0
  while k < n {
    node_to_topo[topo.order[k]] = k
    k = k + 1
  }
  let trans = drv_trans_deps(nodes, topo.order)
  let need : Array[Bool] = []
  k = 0
  while k < n {
    need.push(false)
    k = k + 1
  }
  let mut si = 0
  while si < selected.length() {
    let tk = node_to_topo[selected[si]]
    let td = trans.topo[tk]
    let mut u = 0
    while u < td.length() {
      need[td[u]] = true
      u = u + 1
    }
    si = si + 1
  }
  let t_loaded = clock_now_ms(world)
  let built = match drv_build_needed_objects(world, nodes, topo.order, trans, need, jobs) {
    Err(msg) => {
      io_eprintln(world, msg)
      return 1
    }
    Ok(v) => v
  }
  let t_built = clock_now_ms(world)
  let qbe_target = drv_resolve_qbe_target(world)
  let rt_lib = drv_resolve_rt_lib(world, qbe_target)
  let cache_dir = drv_resolve_cache_dir(world)
  let need_cstub : Array[Bool] = []
  let pkg_cstub_objs : Array[Array[String]] = []
  let pkg_cstub_cxx : Array[Bool] = []
  let pkg_rc_objs : Array[Array[String]] = []
  k = 0
  while k < n {
    need_cstub.push(need[k])
    pkg_cstub_objs.push([])
    pkg_cstub_cxx.push(false)
    pkg_rc_objs.push([])
    k = k + 1
  }
  si = 0
  while si < selected.length() {
    need_cstub[node_to_topo[selected[si]]] = true
    si = si + 1
  }
  let cstub_new_keys : Array[String] = []
  let cstub_new_sizes : Array[Int64] = []
  k = 0
  while k < n {
    if need_cstub[k] {
      let cstub_objs : Array[String] = []
      let cstub_keys : Array[String] = []
      match drv_compile_pkg_c_sources(
        world,
        nodes[topo.order[k]],
        qbe_target,
        "",
        false,
        rt_lib,
        cache_dir,
        trace,
        cstub_objs,
        cstub_keys,
        cstub_new_keys,
        cstub_new_sizes,
      ) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(has_cxx) => {
          pkg_cstub_objs[k] = cstub_objs
          pkg_cstub_cxx[k] = has_cxx
        }
      }
      let rc_objs : Array[String] = []
      let rc_keys : Array[String] = []
      match drv_compile_pkg_rc_sources(
        world,
        nodes[topo.order[k]],
        qbe_target,
        cache_dir,
        trace,
        rc_objs,
        rc_keys,
        cstub_new_keys,
        cstub_new_sizes,
      ) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(_) => pkg_rc_objs[k] = rc_objs
      }
    }
    k = k + 1
  }
  if cstub_new_keys.length() > 0 {
    drv_cas_record_batch_and_evict(world, cache_dir, cstub_new_keys, cstub_new_sizes)
  }
  let tested : Array[String] = []
  let test_jobs : Array[DrvTestJob] = []
  si = 0
  while si < selected.length() {
    let node = nodes[selected[si]]
    let tk = node_to_topo[selected[si]]
    let tpaths : Array[String] = []
    let tsources : Array[String] = []
    let mut pi = 0
    while pi < node.paths.length() {
      tpaths.push(node.paths[pi])
      tsources.push(node.sources[pi])
      pi = pi + 1
    }
    match drv_append_test_sources(world, node.dir, tpaths, tsources) {
      Err(msg) => {
        io_eprintln(world, msg)
        return 1
      }
      Ok(_) => ()
    }
    let imports = drv_ensure_ws_imports(
      world,
      nodes,
      topo.order,
      trans.topo,
      built.stub_paths,
      built.loaded_imported,
      tk,
    )
    let cr = check_source_files_with_imports(node.name, tpaths, tsources, imports, true)
    if cr.diagnostics.length() > 0 {
      io_eprintln(world, check_result_to_json(cr.diagnostics))
      return 1
    }
    tested.push(node.name)
    let tnames = drv_test_names(cr.pkg)
    let run_idx = drv_filter_tests(tnames, filter)
    if run_idx.length() > 0 {
      let td = trans.topo[tk]
      let dep_names : Array[String] = []
      let dep_objs : Array[String] = []
      let job_opts = drv_link_opts_empty()
      let mut u = 0
      while u < td.length() {
        let tu = td[u]
        let dn = nodes[topo.order[tu]]
        dep_names.push(dn.name)
        dep_objs.push(built.obj_paths[tu])
        let dcstubs = pkg_cstub_objs[tu]
        let mut ci = 0
        while ci < dcstubs.length() {
          dep_objs.push(dcstubs[ci])
          ci = ci + 1
        }
        if pkg_cstub_cxx[tu] {
          job_opts.has_cxx = true
        }
        drv_collect_node_link_opts(dn, qbe_target, job_opts)
        let drcs = pkg_rc_objs[tu]
        let mut rci = 0
        while rci < drcs.length() {
          push_unique_lib(job_opts.objects, drcs[rci])
          rci = rci + 1
        }
        u = u + 1
      }
      let self_cstubs = pkg_cstub_objs[tk]
      let mut ci = 0
      while ci < self_cstubs.length() {
        dep_objs.push(self_cstubs[ci])
        ci = ci + 1
      }
      if pkg_cstub_cxx[tk] {
        job_opts.has_cxx = true
      }
      drv_collect_node_link_opts(node, qbe_target, job_opts)
      let self_rcs = pkg_rc_objs[tk]
      let mut rci = 0
      while rci < self_rcs.length() {
        push_unique_lib(job_opts.objects, self_rcs[rci])
        rci = rci + 1
      }
      let mut li = 0
      while li < cli_libs.length() {
        push_unique_lib(job_opts.libs, cli_libs[li])
        if drv_is_cxx_lib(cli_libs[li]) {
          job_opts.has_cxx = true
        }
        li = li + 1
      }
      let test_res = emit_qbe_test_package(cr.pkg, cr.tc, dep_names)
      test_jobs.push(DrvTestJob::{
        label: node.name,
        ssa: test_res.ssa,
        names: tnames,
        run_idx: run_idx,
        dep_objs: dep_objs,
        link_opts: job_opts,
      })
    }
    si = si + 1
  }
  let out_pkgs : Array[String] = []
  let out_names : Array[String] = []
  let out_oks : Array[Bool] = []
  let t_checked = clock_now_ms(world)
  match drv_exec_test_jobs(world, test_jobs, jobs, as_json, out_pkgs, out_names, out_oks) {
    Err(e) => {
      io_eprintln(world, "error: " + e)
      return 1
    }
    Ok(_) => ()
  }
  if trace {
    let t_end = clock_now_ms(world)
    io_eprintln(
      world,
      "[test] load=" +
      (t_loaded - t_start).to_string() +
      "ms objs=" +
      (t_built - t_loaded).to_string() +
      "ms check+emit=" +
      (t_checked - t_built).to_string() +
      "ms bins+run=" +
      (t_end - t_checked).to_string() +
      "ms",
    )
  }
  if as_json {
    io_println(
      world,
      format_workspace_test_report_json(tested, out_pkgs, out_names, out_oks),
    )
    let mut fi = 0
    while fi < out_oks.length() {
      if !out_oks[fi] {
        return 1
      }
      fi = fi + 1
    }
    0
  } else {
    drv_print_test_summary(world, out_oks)
  }
}

///|
fn drv_run_tests_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
  filter : String,
  cli_libs : Array[String],
  only_pkg : String,
  jobs : Int,
) -> Int {
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) =>
        return drv_run_ws_tests(world, root_dir, as_json, filter, cli_libs, only_pkg, jobs)
      None => ()
    }
  }
  if only_pkg.length() > 0 {
    io_eprintln(world, "error: --package needs a pion.toml workspace")
    return 1
  }
  let loaded = match drv_load_targets(world, targets) {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let mut ti = 0
  while ti < targets.length() {
    if fs_is_dir(world, targets[ti]) {
      match drv_append_test_sources(world, targets[ti], loaded.paths, loaded.sources) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(_) => ()
      }
    }
    ti = ti + 1
  }
  let cr = check_source_files_full(loaded.pkg_name, loaded.paths, loaded.sources)
  if cr.diagnostics.length() > 0 {
    io_println(world, check_result_to_json(cr.diagnostics))
    return 1
  }
  let out_pkgs : Array[String] = []
  let out_names : Array[String] = []
  let out_oks : Array[Bool] = []
  let tnames = drv_test_names(cr.pkg)
  let run_idx = drv_filter_tests(tnames, filter)
  let test_jobs : Array[DrvTestJob] = []
  if run_idx.length() > 0 {
    let test_res = emit_qbe_test_package(cr.pkg, cr.tc, [])
    let job_opts = drv_link_opts_from_libs(cli_libs)
    test_jobs.push(DrvTestJob::{
      label: "",
      ssa: test_res.ssa,
      names: tnames,
      run_idx: run_idx,
      dep_objs: [],
      link_opts: job_opts,
    })
  }
  match drv_exec_test_jobs(
    world,
    test_jobs,
    jobs,
    as_json,
    out_pkgs,
    out_names,
    out_oks,
  ) {
    Err(e) => {
      io_eprintln(world, "error: " + e)
      return 1
    }
    Ok(_) => ()
  }
  if as_json {
    io_println(world, format_test_report_json(out_names, out_oks))
    let mut fi = 0
    while fi < out_oks.length() {
      if !out_oks[fi] {
        return 1
      }
      fi = fi + 1
    }
    0
  } else {
    drv_print_test_summary(world, out_oks)
  }
}

///|
fn drv_is_fmt_file(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  if str_code_at(name, 0) == 46 {
    return false
  }
  drv_ends_with(name, ".pion")
}

///|
fn drv_collect_fmt_files_dir(
  world : World,
  dir : String,
  out : Array[String],
) -> Unit {
  let entries = fs_list_dir(world, dir)
  let mut i = 0
  while i < entries.length() {
    let name = entries[i]
    if name.length() > 0 && str_code_at(name, 0) != 46 {
      let full = drv_join_path(dir, name)
      if fs_is_dir(world, full) {
        if name != "_build" && name != "target" && name != "out" && name != "vendor" {
          drv_collect_fmt_files_dir(world, full, out)
        }
      } else if drv_is_fmt_file(name) {
        out.push(full)
      }
    }
    i = i + 1
  }
}

///|
fn drv_run_fmt_cmd(
  world : World,
  targets : Array[String],
  check_only : Bool,
  as_json : Bool,
) -> Int {
  let files : Array[String] = []
  let mut t = 0
  while t < targets.length() {
    let target = targets[t]
    if !fs_exists(world, target) {
      io_eprintln(world, "error: path does not exist: " + target)
      return 1
    }
    if fs_is_dir(world, target) {
      drv_collect_fmt_files_dir(world, target, files)
    } else {
      files.push(target)
    }
    t = t + 1
  }
  let unformatted : Array[String] = []
  let mut i = 0
  while i < files.length() {
    let path = files[i]
    let src = match fs_read(world, path) {
      Err(msg) => {
        io_eprintln(world, "error: failed to read " + path + ": " + msg)
        return 1
      }
      Ok(s) => s
    }
    let formatted = format_source(src)
    if formatted != src {
      if check_only {
        unformatted.push(path)
      } else {
        if !drv_write_text_atomic(world, path, formatted) {
          io_eprintln(world, "error: failed to write " + path)
          return 1
        }
      }
    }
    i = i + 1
  }
  if check_only {
    if as_json {
      io_println(world, fmt_check_result_to_json(unformatted))
    } else {
      let mut j = 0
      while j < unformatted.length() {
        io_println(world, unformatted[j])
        j = j + 1
      }
    }
    if unformatted.length() == 0 { 0 } else { 1 }
  } else {
    if as_json {
      io_println(world, fmt_check_result_to_json([]))
    }
    0
  }
}

///|
/// `pionc doc [--json]`: public API of a file, directory or `pion.toml` workspace
/// (every package, dependencies first).
fn drv_run_doc_cmd(world : World, targets : Array[String], as_json : Bool) -> Int {
  let pkgs : Array[Package] = []
  let diags : Array[Diagnostic] = []
  let mut handled_ws = false
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) => {
        handled_ws = true
        let nodes = match drv_load_workspace_nodes(world, root_dir) {
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
          Ok(v) => v
        }
        let mut ni = 0
        while ni < nodes.length() {
          let node = nodes[ni]
          let pd = parse_package_diagnostics(node.paths, node.sources)
          let mut di = 0
          while di < pd.length() {
            diags.push(pd[di])
            di = di + 1
          }
          pkgs.push(parse_package(node.name, node.paths, node.sources))
          ni = ni + 1
        }
      }
      None => ()
    }
  }
  if !handled_ws {
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let pd = parse_package_diagnostics(loaded.paths, loaded.sources)
        let mut di = 0
        while di < pd.length() {
          diags.push(pd[di])
          di = di + 1
        }
        pkgs.push(parse_package(loaded.pkg_name, loaded.paths, loaded.sources))
      }
    }
  }
  if diags.length() > 0 {
    io_println(world, check_result_to_json(diags))
    return 1
  }
  if as_json {
    io_println(world, doc_packages_json(pkgs))
  } else {
    io_print(world, doc_packages_text(pkgs))
  }
  0
}

///|
/// `pionc fetch [dir]`: resolves every git dependency of the workspace into the
/// shared git cache and writes/verifies `pion.lock`; prints a JSON summary.
fn drv_run_fetch_cmd(world : World, dir : String) -> Int {
  let root_dir = match drv_detect_manifest_dir(world, dir) {
    Some(d) => d
    None => {
      io_eprintln(world, "error: no pion.toml in " + dir)
      return 1
    }
  }
  let ws = match drv_load_workspace(world, root_dir) {
    Err(msg) => {
      io_eprintln(world, "error: " + msg)
      return 1
    }
    Ok(v) => v
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":true,\"lock\":")
  sb.write_string(json_quote(if ws.lock.length() > 0 || fs_exists(world, ws.lock_path) { ws.lock_path } else { "" }))
  sb.write_string(",\"git_cache\":")
  sb.write_string(json_quote(ws.git_root))
  sb.write_string(",\"packages\":[")
  let mut i = 0
  while i < ws.nodes.length() {
    let node = ws.nodes[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(node.name))
    sb.write_string(",\"dir\":")
    sb.write_string(json_quote(node.dir))
    sb.write_string(",\"source\":")
    sb.write_string(if drv_is_external_pkg(ws.git_root, node.dir) { "\"git\"" } else { "\"path\"" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("],\"git\":[")
  i = 0
  while i < ws.lock.length() {
    let e = ws.lock[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(e.name))
    sb.write_string(",\"git\":")
    sb.write_string(json_quote(e.git))
    sb.write_string(",\"ref\":")
    sb.write_string(json_quote(e.reference))
    sb.write_string(",\"rev\":")
    sb.write_string(json_quote(e.rev))
    sb.write_string(",\"subdir\":")
    sb.write_string(json_quote(e.subdir))
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  io_println(world, sb.to_string())
  0
}

///|
/// `pionc init [--template cli|service|invar-app] [--json] <dir>`: scaffolds a package;
/// refuses to touch a directory that already has any of its target files.
fn drv_run_init_cmd(
  world : World,
  dir : String,
  tmpl : String,
  as_json : Bool,
) -> Int {
  let name = init_package_name(drv_normalize_path(dir))
  let files : Array[String] = []
  let contents : Array[String] = []
  if tmpl == "cli" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_pion_toml(name))
    contents.push(init_main_source(name))
    contents.push(init_test_source(name))
  } else if tmpl == "service" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/worker.pion"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_service_pion_toml(name))
    contents.push(init_service_worker_source(name))
    contents.push(init_service_main_source(name))
    contents.push(init_service_test_source(name))
  } else if tmpl == "invar-app" {
    files.push(drv_join_path(dir, "pion.toml"))
    files.push(drv_join_path(dir, "src/protocol.pion"))
    files.push(drv_join_path(dir, "src/worker.pion"))
    files.push(drv_join_path(dir, "src/view.pion"))
    files.push(drv_join_path(dir, "src/main.pion"))
    files.push(drv_join_path(dir, "main_test.pion"))
    contents.push(init_invar_pion_toml(name))
    contents.push(init_invar_protocol_source(name))
    contents.push(init_invar_worker_source(name))
    contents.push(init_invar_view_source(name))
    contents.push(init_invar_main_source(name))
    contents.push(init_invar_test_source(name))
  } else {
    let err_msg = "unknown template `" + tmpl + "`; expected one of: cli, service, invar-app"
    if as_json {
      io_println(
        world,
        "{\"ok\":false,\"error\":" + json_quote(err_msg) + "}",
      )
    } else {
      io_eprintln(world, "error: " + err_msg)
    }
    return 1
  }
  let mut i = 0
  while i < files.length() {
    if fs_exists(world, files[i]) {
      if as_json {
        io_println(
          world,
          "{\"ok\":false,\"error\":" + json_quote(files[i] + " already exists; refusing to overwrite") + "}",
        )
      } else {
        io_eprintln(world, "error: " + files[i] + " already exists; refusing to overwrite")
      }
      return 1
    }
    i = i + 1
  }
  let _ = fs_mkdir_p(world, drv_join_path(dir, "src"))
  i = 0
  while i < files.length() {
    match fs_write(world, files[i], contents[i]) {
      Err(e) => {
        io_eprintln(world, "error: failed to write " + files[i] + ": " + e)
        return 1
      }
      Ok(_) => ()
    }
    i = i + 1
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"package\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"template\":")
    sb.write_string(json_quote(tmpl))
    sb.write_string(",\"dir\":")
    sb.write_string(json_quote(dir))
    sb.write_string(",\"files\":[")
    i = 0
    while i < files.length() {
      if i > 0 {
        sb.write_string(",")
      }
      sb.write_string(json_quote(files[i]))
      i = i + 1
    }
    sb.write_string("]}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "created package `" + name + "` (" + tmpl + ") in " + dir)
  }
  0
}

///|
/// Registry index cache: `$PION_CACHE_DIR/registry`, else `$HOME/.cache/pion/registry`;
/// `<sha256(url)>.git` is a bare mirror of each registry's index repository.
fn drv_registry_cache_root(world : World) -> String {
  let custom = drv_env_str(world, "PION_CACHE_DIR")
  if custom.length() > 0 {
    return drv_normalize_path(custom + "/registry")
  }
  let home = drv_env_str(world, "HOME")
  if home.length() > 0 {
    drv_normalize_path(drv_join_path(home, ".cache/pion/registry"))
  } else {
    drv_join_path(drv_temp_dir(world), "pion-registry")
  }
}

///|
/// A registry given as a relative local path is made absolute (it is written
/// into `pion.toml`); URLs and absolute paths are kept as they are.
fn drv_abs_registry(world : World, url : String) -> String {
  if url.length() == 0 ||
    drv_find_substr(url, "://", 0) >= 0 ||
    str_code_at(url, 0) == 47 ||
    drv_starts_with(url, "git@") {
    return url
  }
  let pwd = drv_env_str(world, "PWD")
  if pwd.length() == 0 {
    url
  } else {
    drv_resolve_rel_path(pwd, url)
  }
}

///|
/// Clones or fetches (once per run) the registry index repository `url` into
/// its bare mirror and returns the mirror's path.
fn drv_registry_sync(
  world : World,
  url : String,
  fetched : Map[String, Bool],
) -> Result[String, String] {
  let root = drv_registry_cache_root(world)
  let repo = root + "/" + sha256_hex(url) + ".git"
  if fetched.contains(repo) {
    return Ok(repo)
  }
  fetched.set(repo, true)
  if !fs_is_dir(world, repo) {
    let _ = fs_mkdir_p(world, root)
    let tmp = repo + ".tmp." + clock_now_ms(world).to_string()
    match drv_git(world, ["clone", "--quiet", "--mirror", url, tmp]) {
      Err(e) => {
        drv_rm_rf(world, tmp)
        return Err("cannot clone registry " + url + ": " + e)
      }
      Ok(_) => ()
    }
    if !fs_rename(world, tmp, repo) {
      drv_rm_rf(world, tmp)
      if !fs_is_dir(world, repo) {
        return Err("failed to move registry mirror into " + repo)
      }
    }
    return Ok(repo)
  }
  match drv_git(world, ["--git-dir", repo, "fetch", "--quiet", "--prune", "origin"]) {
    Err(e) => Err("cannot fetch registry " + url + ": " + e)
    Ok(_) => Ok(repo)
  }
}

///|
/// Reads `index/<name>.toml` at the registry's current `HEAD` and turns it
/// into a git dependency that remembers the registry.
fn drv_registry_lookup(
  world : World,
  url : String,
  name : String,
  fetched : Map[String, Bool],
) -> Result[ManifestDep, String] {
  let repo = match drv_registry_sync(world, url, fetched) {
    Err(e) => return Err(e)
    Ok(r) => r
  }
  let txt = match drv_git(world, ["--git-dir", repo, "show", "HEAD:" + registry_index_path(name)]) {
    Err(_) => return Err("package `" + name + "` not found in registry " + url)
    Ok(t) => t
  }
  match parse_registry_entry(name, txt) {
    Err(e) => Err("registry " + url + ": " + e)
    Ok(e) => Ok(registry_entry_dep(e, url))
  }
}

///|
/// Puts a file back as it was before a failed `add`/`update` (removes it when
/// it did not exist).
fn drv_restore_file(world : World, path : String, existed : Bool, text : String) -> Unit {
  if existed {
    let _ = drv_write_text_atomic(world, path, text)
  } else {
    let _ = fs_remove(world, path)
  }
}

///|
fn drv_cmd_fail(world : World, as_json : Bool, msg : String) -> Int {
  if as_json {
    io_println(world, "{\"ok\":false,\"error\":" + json_quote(msg) + "}")
  } else {
    io_eprintln(world, "error: " + msg)
  }
  1
}

///|
/// Type-checks every package of a loaded workspace (dependencies first);
/// returns the package-graph or type diagnostics.
fn drv_ws_diagnostics(nodes : Array[PkgNodeInput]) -> Array[Diagnostic] {
  let names : Array[String] = []
  let dep_lists : Array[Array[String]] = []
  let mut ni = 0
  while ni < nodes.length() {
    names.push(nodes[ni].name)
    dep_lists.push(nodes[ni].deps)
    ni = ni + 1
  }
  let topo = topo_sort_packages(names, dep_lists)
  if topo.diagnostics.length() > 0 {
    return topo.diagnostics
  }
  let imported : Array[ImportedPkg] = []
  let all_diags : Array[Diagnostic] = []
  let mut k = 0
  while k < topo.order.length() {
    let node = nodes[topo.order[k]]
    let cr = check_source_files_with_imports(
      node.name,
      node.paths,
      node.sources,
      imported,
      true,
    )
    let mut di = 0
    while di < cr.diagnostics.length() {
      all_diags.push(cr.diagnostics[di])
      di = di + 1
    }
    imported.push(ImportedPkg::{ name: node.name, tc: cr.tc })
    k = k + 1
  }
  all_diags
}

///|
/// `pionc add [--json] <name> (--path <p> | --git <url> [--tag|--rev|--branch <r>]
/// [--subdir <s>] | [--registry <url_or_path>]) [dir]`: sets the dependency in
/// `pion.toml` (in place, idempotent), resolves it into the shared cache and
/// `pion.lock`; both files are restored when resolution fails.
fn drv_run_add_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut name = ""
  let mut dir = ""
  let mut path = ""
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut registry = ""
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    let has_val = i + 1 < args.length()
    if a == "--json" {
      as_json = true
    } else if a == "--path" && has_val {
      path = args[i + 1]
      i = i + 1
    } else if a == "--git" && has_val {
      git = args[i + 1]
      i = i + 1
    } else if a == "--tag" && has_val {
      tag = args[i + 1]
      i = i + 1
    } else if a == "--rev" && has_val {
      rev = args[i + 1]
      i = i + 1
    } else if a == "--branch" && has_val {
      branch = args[i + 1]
      i = i + 1
    } else if a == "--subdir" && has_val {
      subdir = args[i + 1]
      i = i + 1
    } else if a == "--registry" && has_val {
      registry = args[i + 1]
      i = i + 1
    } else if drv_starts_with(a, "--") {
      return drv_cmd_fail(world, as_json, "unknown or incomplete option `" + a + "`")
    } else if name.length() == 0 {
      name = a
    } else if dir.length() == 0 {
      dir = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if name.length() == 0 {
    return drv_cmd_fail(world, as_json, "usage: pionc add [--json] <name> (--path <p> | --git <url> [--tag <t>|--rev <r>|--branch <b>] [--subdir <s>] | [--registry <url_or_path>]) [dir]")
  }
  if !manifest_valid_dep_name(name) {
    return drv_cmd_fail(world, as_json, "invalid package name `" + name + "`")
  }
  let mut nrefs = 0
  if tag.length() > 0 {
    nrefs = nrefs + 1
  }
  if rev.length() > 0 {
    nrefs = nrefs + 1
  }
  if branch.length() > 0 {
    nrefs = nrefs + 1
  }
  if path.length() > 0 && (git.length() > 0 || registry.length() > 0) {
    return drv_cmd_fail(world, as_json, "--path cannot be combined with --git or --registry")
  }
  if git.length() > 0 && registry.length() > 0 {
    return drv_cmd_fail(world, as_json, "--git cannot be combined with --registry")
  }
  if git.length() == 0 && (nrefs > 0 || subdir.length() > 0) {
    return drv_cmd_fail(world, as_json, "--tag/--rev/--branch/--subdir require --git")
  }
  if nrefs > 1 {
    return drv_cmd_fail(world, as_json, "pass at most one of --tag, --rev, --branch")
  }
  let target_dir = if dir.length() > 0 { dir } else { "." }
  let root_dir = match drv_detect_manifest_dir(world, target_dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + target_dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  if mf.name == name {
    return drv_cmd_fail(world, as_json, "package `" + name + "` cannot depend on itself")
  }
  let fetched : Map[String, Bool] = Map([])
  let mut source = ""
  let mut location = ""
  let dep = if path.length() > 0 {
    let dep_dir = drv_resolve_rel_path(root_dir, path)
    if !fs_exists(world, drv_join_path(dep_dir, "pion.toml")) {
      return drv_cmd_fail(world, as_json, "no pion.toml in " + dep_dir)
    }
    source = "path"
    location = path
    manifest_dep_new(name, path, "", "", "", "", "")
  } else if git.length() > 0 {
    source = "git"
    location = git
    manifest_dep_new(name, "", git, tag, rev, branch, subdir)
  } else {
    let mut url = registry
    if url.length() == 0 {
      url = mf.registry
    }
    if url.length() == 0 {
      url = drv_env_str(world, "PION_REGISTRY")
    }
    if url.length() == 0 {
      return drv_cmd_fail(
        world,
        as_json,
        "no source for `" + name + "`: pass --path, --git or --registry, or set [registry] url in pion.toml or $PION_REGISTRY",
      )
    }
    let abs_url = drv_abs_registry(world, url)
    source = "registry"
    location = abs_url
    match drv_registry_lookup(world, abs_url, name, fetched) {
      Err(e) => return drv_cmd_fail(world, as_json, e)
      Ok(d) => d
    }
  }
  let new_text = manifest_set_dependency(text, dep)
  match parse_pion_toml(new_text) {
    Err(e) => return drv_cmd_fail(world, as_json, "rewritten pion.toml does not parse: " + e)
    Ok(_) => ()
  }
  let lock_path = drv_join_path(drv_normalize_path(root_dir), "pion.lock")
  let lock_existed = fs_exists(world, lock_path)
  let lock_text = if lock_existed {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(_) => ""
    }
  } else {
    ""
  }
  let changed = new_text != text
  if changed && !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let ws = match drv_load_workspace_ex(world, root_dir, false, name) {
    Err(e) => {
      drv_restore_file(world, mf_path, true, text)
      drv_restore_file(world, lock_path, lock_existed, lock_text)
      return drv_cmd_fail(world, as_json, e)
    }
    Ok(v) => v
  }
  let mut found = false
  let mut ni = 0
  while ni < ws.nodes.length() {
    if ws.nodes[ni].name == name {
      found = true
    }
    ni = ni + 1
  }
  if !found {
    drv_restore_file(world, mf_path, true, text)
    drv_restore_file(world, lock_path, lock_existed, lock_text)
    return drv_cmd_fail(
      world,
      as_json,
      "the pion.toml at " + location + " does not declare package `" + name + "`",
    )
  }
  let locked = lock_rev_of(ws.lock, name)
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"action\":\"add\",\"package\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"source\":")
    sb.write_string(json_quote(source))
    sb.write_string(",\"location\":")
    sb.write_string(json_quote(location))
    sb.write_string(",\"version\":")
    sb.write_string(json_quote(dep.version))
    sb.write_string(",\"rev\":")
    sb.write_string(json_quote(locked))
    sb.write_string(",\"changed\":")
    sb.write_string(if changed { "true" } else { "false" })
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(
      world,
      (if changed { "added `" } else { "unchanged `" }) +
      name +
      "` (" +
      source +
      " " +
      location +
      (if locked.length() > 0 { " @ " + locked } else { "" }) +
      ")",
    )
  }
  0
}

///|
/// `pionc update [--json] [pkg] [dir]`: re-reads registry entries, re-resolves
/// every git dependency (or only `pkg`) to its newest target ref, rewrites
/// `pion.lock`, and checks the workspace; on any failure `pion.toml` and
/// `pion.lock` are restored.
fn drv_run_update_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let pos : Array[String] = []
  let mut i = 2
  while i < args.length() {
    if args[i] == "--json" {
      as_json = true
    } else if drv_starts_with(args[i], "--") {
      return drv_cmd_fail(world, as_json, "unknown option `" + args[i] + "`")
    } else {
      pos.push(args[i])
    }
    i = i + 1
  }
  let mut pkg = ""
  let mut dir = "."
  if pos.length() == 2 {
    pkg = pos[0]
    dir = pos[1]
  } else if pos.length() == 1 {
    match drv_detect_manifest_dir(world, pos[0]) {
      Some(_) => dir = pos[0]
      None => pkg = pos[0]
    }
  } else if pos.length() > 2 {
    return drv_cmd_fail(world, as_json, "usage: pionc update [--json] [pkg] [dir]")
  }
  let root_dir = match drv_detect_manifest_dir(world, dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) => return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  if pkg.length() > 0 {
    let mut known = false
    let mut di = 0
    while di < mf.deps.length() {
      if mf.deps[di].name == pkg {
        known = true
        if !manifest_dep_is_git(mf.deps[di]) {
          return drv_cmd_fail(world, as_json, "`" + pkg + "` is a path dependency; nothing to update")
        }
      }
      di = di + 1
    }
    if !known {
      return drv_cmd_fail(world, as_json, "no dependency `" + pkg + "` in " + mf_path)
    }
  }
  let fetched : Map[String, Bool] = Map([])
  let mut new_text = text
  let mut di = 0
  while di < mf.deps.length() {
    let d = mf.deps[di]
    if d.registry.length() > 0 && (pkg.length() == 0 || d.name == pkg) {
      match drv_registry_lookup(world, d.registry, d.name, fetched) {
        Err(e) => return drv_cmd_fail(world, as_json, e)
        Ok(nd) => new_text = manifest_set_dependency(new_text, nd)
      }
    }
    di = di + 1
  }
  let lock_path = drv_join_path(drv_normalize_path(root_dir), "pion.lock")
  let lock_existed = fs_exists(world, lock_path)
  let lock_text = if lock_existed {
    match fs_read(world, lock_path) {
      Ok(t) => t
      Err(_) => ""
    }
  } else {
    ""
  }
  let old_lock = if lock_existed {
    match parse_pion_lock(lock_text) {
      Ok(v) => v
      Err(_) => []
    }
  } else {
    []
  }
  if new_text != text && !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let ws = match drv_load_workspace_ex(world, root_dir, pkg.length() == 0, pkg) {
    Err(e) => {
      drv_restore_file(world, mf_path, true, text)
      drv_restore_file(world, lock_path, lock_existed, lock_text)
      return drv_cmd_fail(world, as_json, e)
    }
    Ok(v) => v
  }
  let diags = drv_ws_diagnostics(ws.nodes)
  if diags.length() > 0 {
    drv_restore_file(world, mf_path, true, text)
    drv_restore_file(world, lock_path, lock_existed, lock_text)
    if as_json {
      io_println(
        world,
        "{\"ok\":false,\"error\":\"workspace does not check after update; pion.toml and pion.lock restored\",\"check\":" +
        check_result_to_json(diags) +
        "}",
      )
    } else {
      io_eprintln(world, "error: workspace does not check after update; pion.toml and pion.lock restored")
      io_eprintln(world, check_result_to_json(diags))
    }
    return 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":true,\"action\":\"update\",\"packages\":[")
  let mut first = true
  let mut li = 0
  while li < ws.lock.length() {
    let e = ws.lock[li]
    if pkg.length() == 0 || e.name == pkg {
      let from = lock_rev_of(old_lock, e.name)
      let upd = from != e.rev
      if as_json {
        if !first {
          sb.write_string(",")
        }
        first = false
        sb.write_string("{\"name\":")
        sb.write_string(json_quote(e.name))
        sb.write_string(",\"ref\":")
        sb.write_string(json_quote(e.reference))
        sb.write_string(",\"from\":")
        sb.write_string(json_quote(from))
        sb.write_string(",\"to\":")
        sb.write_string(json_quote(e.rev))
        sb.write_string(",\"updated\":")
        sb.write_string(if upd { "true" } else { "false" })
        sb.write_string("}")
      } else {
        io_println(
          world,
          (if upd { "updated " } else { "unchanged " }) +
          e.name +
          " " +
          e.reference +
          " " +
          (if upd && from.length() > 0 { from + " -> " } else { "" }) +
          e.rev,
        )
      }
    }
    li = li + 1
  }
  sb.write_string("]}")
  if as_json {
    io_println(world, sb.to_string())
  }
  0
}

///|
fn drv_has_default_project(world : World) -> Bool {
  fs_exists(world, "pion.toml") || fs_is_dir(world, "src")
}

///|
struct DrvByteEdit {
  start : Int
  end : Int
  replacement : String
}

///|
fn drv_line_starts(src : String) -> Array[Int] {
  let starts : Array[Int] = [0]
  let mut i = 0
  while i < src.length() {
    if str_code_at(src, i) == 10 {
      starts.push(i + 1)
    }
    i = i + 1
  }
  starts
}

///|
fn drv_line_col_to_offset(
  src : String,
  starts : Array[Int],
  line : Int,
  col : Int,
) -> Int {
  if line < 1 || col < 1 || line > starts.length() {
    return -1
  }
  let ls = starts[line - 1]
  let off = ls + (col - 1)
  if off < ls || off > src.length() {
    return -1
  }
  off
}

///|
fn drv_sort_byte_edits_desc(edits : Array[DrvByteEdit]) -> Unit {
  let n = edits.length()
  let mut i = 1
  while i < n {
    let cur = edits[i]
    let mut j = i - 1
    while j >= 0 &&
      (edits[j].start < cur.start ||
      (edits[j].start == cur.start && edits[j].end < cur.end)) {
      edits[j + 1] = edits[j]
      j = j - 1
    }
    edits[j + 1] = cur
    i = i + 1
  }
}

///|
fn drv_collect_check_diags(
  world : World,
  targets : Array[String],
) -> Result[Array[Diagnostic], String] {
  if targets.length() == 1 {
    match drv_detect_manifest_dir(world, targets[0]) {
      Some(root_dir) =>
        match drv_load_workspace_nodes(world, root_dir) {
          Err(msg) => return Err(msg)
          Ok(nodes) => return Ok(drv_ws_diagnostics(nodes))
        }
      None => ()
    }
  }
  match drv_load_targets(world, targets) {
    Err(msg) => Err(msg)
    Ok(loaded) => {
      let cr = check_source_files(loaded.pkg_name, loaded.paths, loaded.sources)
      Ok(cr.diagnostics)
    }
  }
}

///|
fn drv_str_arr_contains(arr : Array[String], needle : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == needle {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn drv_run_check_fix_cmd(
  world : World,
  targets : Array[String],
  as_json : Bool,
) -> Int {
  let modified_files : Array[String] = []
  let mut total_applied = 0
  let mut round = 0
  while round < 3 {
    let diags = match drv_collect_check_diags(world, targets) {
      Err(msg) => return drv_cmd_fail(world, as_json, msg)
      Ok(ds) => ds
    }
    if diags.length() == 0 {
      break
    }
    let files : Array[String] = []
    let raw_edits : Array[TextEdit] = []
    let mut di = 0
    while di < diags.length() {
      let es = diags[di].edits
      let mut ei = 0
      while ei < es.length() {
        let e = es[ei]
        if e.file.length() > 0 {
          raw_edits.push(e)
          if !drv_str_arr_contains(files, e.file) {
            files.push(e.file)
          }
        }
        ei = ei + 1
      }
      di = di + 1
    }
    if raw_edits.length() == 0 {
      break
    }
    let mut round_applied = 0
    let mut fi = 0
    while fi < files.length() {
      let path = files[fi]
      let src = match fs_read(world, path) {
        Ok(t) => t
        Err(_) => {
          fi = fi + 1
          continue
        }
      }
      let starts = drv_line_starts(src)
      let bedits : Array[DrvByteEdit] = []
      let mut ri = 0
      while ri < raw_edits.length() {
        let re = raw_edits[ri]
        if re.file == path {
          let s_off = drv_line_col_to_offset(src, starts, re.line, re.col)
          let e_off = drv_line_col_to_offset(
            src,
            starts,
            re.end_line,
            re.end_col,
          )
          if s_off >= 0 && e_off >= s_off && e_off <= src.length() {
            let mut dup = false
            let mut bi = 0
            while bi < bedits.length() {
              if bedits[bi].start == s_off &&
                bedits[bi].end == e_off &&
                bedits[bi].replacement == re.replacement {
                dup = true
                break
              }
              bi = bi + 1
            }
            if !dup {
              bedits.push(DrvByteEdit::{
                start: s_off,
                end: e_off,
                replacement: re.replacement,
              })
            }
          }
        }
        ri = ri + 1
      }
      if bedits.length() > 0 {
        drv_sort_byte_edits_desc(bedits)
        let mut cur = src
        let mut last_start = src.length() + 1
        let mut file_applied = 0
        let mut bi = 0
        while bi < bedits.length() {
          let be = bedits[bi]
          if be.end <= last_start {
            cur = slice_str(cur, 0, be.start) +
              be.replacement +
              slice_str(cur, be.end, cur.length())
            last_start = be.start
            file_applied = file_applied + 1
          }
          bi = bi + 1
        }
        if file_applied > 0 && cur != src {
          if drv_write_text_atomic(world, path, cur) {
            round_applied = round_applied + file_applied
            total_applied = total_applied + file_applied
            if !drv_str_arr_contains(modified_files, path) {
              modified_files.push(path)
            }
          }
        }
      }
      fi = fi + 1
    }
    if round_applied == 0 {
      break
    }
    round = round + 1
  }
  let remaining = match drv_collect_check_diags(world, targets) {
    Err(msg) => return drv_cmd_fail(world, as_json, msg)
    Ok(ds) => ds
  }
  let ok = remaining.length() == 0
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if ok { "true" } else { "false" })
  sb.write_string(",\"fixed\":")
  sb.write_string(total_applied.to_string())
  sb.write_string(",\"files\":[")
  let mut fi = 0
  while fi < modified_files.length() {
    if fi > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(modified_files[fi]))
    fi = fi + 1
  }
  sb.write_string("],\"diagnostics\":[")
  let mut di = 0
  while di < remaining.length() {
    if di > 0 {
      sb.write_string(",")
    }
    sb.write_string(diagnostic_to_json(remaining[di]))
    di = di + 1
  }
  sb.write_string("]}")
  io_println(world, sb.to_string())
  if ok { 0 } else { 1 }
}

///|
struct DrvDirStats {
  files : Int
  bytes : Int64
}

///|
fn drv_dir_stats(world : World, dir : String) -> DrvDirStats {
  if !fs_is_dir(world, dir) {
    return DrvDirStats::{ files: 0, bytes: 0L }
  }
  let stack : Array[String] = [dir]
  let mut files = 0
  let mut bytes = 0L
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    let entries = fs_list_dir(world, cur)
    let mut i = 0
    while i < entries.length() {
      let name = entries[i]
      if name != "." && name != ".." {
        let p = drv_join_path(cur, name)
        if fs_is_dir(world, p) {
          stack.push(p)
        } else {
          files = files + 1
          let sz = fs_size(world, p)
          if sz > 0L {
            bytes = bytes + sz
          }
        }
      }
      i = i + 1
    }
  }
  DrvDirStats::{ files: files, bytes: bytes }
}

///|
fn drv_clear_dir_files(world : World, dir : String) -> DrvDirStats {
  if !fs_is_dir(world, dir) {
    return DrvDirStats::{ files: 0, bytes: 0L }
  }
  let stack : Array[String] = [dir]
  let mut files = 0
  let mut bytes = 0L
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    let entries = fs_list_dir(world, cur)
    let mut i = 0
    while i < entries.length() {
      let name = entries[i]
      if name != "." && name != ".." {
        let p = drv_join_path(cur, name)
        if fs_is_dir(world, p) {
          stack.push(p)
        } else {
          let sz = fs_size(world, p)
          if fs_remove(world, p) {
            files = files + 1
            if sz > 0L {
              bytes = bytes + sz
            }
          }
        }
      }
      i = i + 1
    }
  }
  DrvDirStats::{ files: files, bytes: bytes }
}

///|
fn drv_cache_clear_impl(
  world : World,
  clear_all : Bool,
  as_json : Bool,
) -> Int {
  let cache_dir = drv_resolve_cache_dir(world)
  let s_obj = drv_clear_dir_files(world, drv_join_path(cache_dir, "obj"))
  let s_bin = drv_clear_dir_files(world, drv_join_path(cache_dir, "bin"))
  let s_tbin = drv_clear_dir_files(world, drv_join_path(cache_dir, "testbin"))
  let s_sig = drv_clear_dir_files(world, drv_join_path(cache_dir, "sig"))
  let s_ssa = drv_clear_dir_files(world, drv_join_path(cache_dir, "ssa"))
  let s_usig = drv_clear_dir_files(world, drv_join_path(cache_dir, "usig"))
  let mut removed_files = s_obj.files +
    s_bin.files +
    s_tbin.files +
    s_sig.files +
    s_ssa.files +
    s_usig.files
  let mut removed_bytes = s_obj.bytes +
    s_bin.bytes +
    s_tbin.bytes +
    s_sig.bytes +
    s_ssa.bytes +
    s_usig.bytes
  let index_path = drv_join_path(cache_dir, "index.tsv")
  if fs_exists(world, index_path) {
    let isz = fs_size(world, index_path)
    if fs_remove(world, index_path) {
      removed_files = removed_files + 1
      if isz > 0L {
        removed_bytes = removed_bytes + isz
      }
    }
  }
  if clear_all {
    let git_root = drv_git_cache_root(world)
    let sg = drv_dir_stats(world, git_root)
    if sg.files > 0 || fs_is_dir(world, git_root) {
      drv_rm_rf(world, git_root)
      removed_files = removed_files + sg.files
      removed_bytes = removed_bytes + sg.bytes
    }
    let reg_root = drv_registry_cache_root(world)
    let sr = drv_dir_stats(world, reg_root)
    if sr.files > 0 || fs_is_dir(world, reg_root) {
      drv_rm_rf(world, reg_root)
      removed_files = removed_files + sr.files
      removed_bytes = removed_bytes + sr.bytes
    }
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"action\":\"clear\",\"cache_dir\":")
    sb.write_string(json_quote(cache_dir))
    sb.write_string(",\"all\":")
    sb.write_string(if clear_all { "true" } else { "false" })
    sb.write_string(",\"removed_files\":")
    sb.write_string(removed_files.to_string())
    sb.write_string(",\"removed_bytes\":")
    sb.write_string(removed_bytes.to_string())
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(
      world,
      "cleared " +
      removed_files.to_string() +
      " file(s) (" +
      removed_bytes.to_string() +
      " bytes) from " +
      cache_dir,
    )
  }
  0
}

///|
fn drv_run_cache_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut clear_all = false
  let mut sub = ""
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--all" {
      clear_all = true
    } else if sub.length() == 0 {
      sub = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if sub.length() == 0 {
    sub = "stats"
  }
  let cache_dir = drv_resolve_cache_dir(world)
  let max_bytes = drv_resolve_cache_max_bytes(world)
  let max_mb = max_bytes / (1024L * 1024L)
  if sub == "stats" {
    let s_obj = drv_dir_stats(world, drv_join_path(cache_dir, "obj"))
    let s_bin1 = drv_dir_stats(world, drv_join_path(cache_dir, "bin"))
    let s_bin2 = drv_dir_stats(world, drv_join_path(cache_dir, "testbin"))
    let s_sig1 = drv_dir_stats(world, drv_join_path(cache_dir, "sig"))
    let s_sig2 = drv_dir_stats(world, drv_join_path(cache_dir, "usig"))
    let s_sig3 = drv_dir_stats(world, drv_join_path(cache_dir, "ssa"))
    let s_git = drv_dir_stats(world, drv_git_cache_root(world))
    let bin_files = s_bin1.files + s_bin2.files
    let bin_bytes = s_bin1.bytes + s_bin2.bytes
    let sig_files = s_sig1.files + s_sig2.files + s_sig3.files
    let sig_bytes = s_sig1.bytes + s_sig2.bytes + s_sig3.bytes
    let total_files = s_obj.files + bin_files + sig_files + s_git.files
    let total_bytes = s_obj.bytes + bin_bytes + sig_bytes + s_git.bytes
    if as_json {
      let sb = StringBuilder()
      sb.write_string("{\"ok\":true,\"cache_dir\":")
      sb.write_string(json_quote(cache_dir))
      sb.write_string(",\"max_mb\":")
      sb.write_string(max_mb.to_string())
      sb.write_string(",\"total_files\":")
      sb.write_string(total_files.to_string())
      sb.write_string(",\"total_bytes\":")
      sb.write_string(total_bytes.to_string())
      sb.write_string(",\"obj\":{\"files\":")
      sb.write_string(s_obj.files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(s_obj.bytes.to_string())
      sb.write_string("},\"bin\":{\"files\":")
      sb.write_string(bin_files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(bin_bytes.to_string())
      sb.write_string("},\"sig\":{\"files\":")
      sb.write_string(sig_files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(sig_bytes.to_string())
      sb.write_string("},\"git\":{\"files\":")
      sb.write_string(s_git.files.to_string())
      sb.write_string(",\"bytes\":")
      sb.write_string(s_git.bytes.to_string())
      sb.write_string("}}")
      io_println(world, sb.to_string())
    } else {
      io_println(world, "cache_dir: " + cache_dir)
      io_println(world, "max_mb:    " + max_mb.to_string())
      io_println(
        world,
        "obj:       " +
        s_obj.files.to_string() +
        " files, " +
        s_obj.bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "bin:       " +
        bin_files.to_string() +
        " files, " +
        bin_bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "sig:       " +
        sig_files.to_string() +
        " files, " +
        sig_bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "git:       " +
        s_git.files.to_string() +
        " files, " +
        s_git.bytes.to_string() +
        " bytes",
      )
      io_println(
        world,
        "total:     " +
        total_files.to_string() +
        " files, " +
        total_bytes.to_string() +
        " bytes",
      )
    }
    return 0
  } else if sub == "prune" {
    let index_path = drv_join_path(cache_dir, "index.tsv")
    let entries : Array[CasEntry] = if fs_exists(world, index_path) {
      match fs_read(world, index_path) {
        Ok(txt) => cas_parse_index(txt)
        Err(_) => []
      }
    } else {
      []
    }
    let mut before_bytes = 0L
    let mut ei = 0
    while ei < entries.length() {
      before_bytes = before_bytes + entries[ei].bytes
      ei = ei + 1
    }
    let ev = cas_touch_and_evict(
      entries,
      "__prune_sentinel__",
      0L,
      clock_now_ms(world),
      max_bytes,
    )
    let kept : Array[CasEntry] = []
    let mut after_bytes = 0L
    let mut ki = 0
    while ki < ev.kept.length() {
      if ev.kept[ki].key != "__prune_sentinel__" {
        kept.push(ev.kept[ki])
        after_bytes = after_bytes + ev.kept[ki].bytes
      }
      ki = ki + 1
    }
    let mut evi = 0
    while evi < ev.evicted.length() {
      let ek = ev.evicted[evi]
      if drv_starts_with(ek, "testbin:") {
        let _ = fs_remove(
          world,
          cache_dir + "/testbin/" + slice_str(ek, 8, ek.length()),
        )
      } else {
        let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionsig")
        let _ = fs_remove(world, cache_dir + "/sig/" + ek + ".pionstub")
        let _ = fs_remove(world, cache_dir + "/ssa/" + ek + ".ssa")
        let _ = fs_remove(world, cache_dir + "/obj/" + ek + ".o")
        let _ = fs_remove(world, cache_dir + "/bin/" + ek)
      }
      evi = evi + 1
    }
    if fs_exists(world, index_path) || kept.length() > 0 {
      let _ = drv_write_text_atomic(world, index_path, cas_format_index(kept))
    }
    if as_json {
      let sb = StringBuilder()
      sb.write_string("{\"ok\":true,\"action\":\"prune\",\"cache_dir\":")
      sb.write_string(json_quote(cache_dir))
      sb.write_string(",\"evicted\":")
      sb.write_string(ev.evicted.length().to_string())
      sb.write_string(",\"before_bytes\":")
      sb.write_string(before_bytes.to_string())
      sb.write_string(",\"after_bytes\":")
      sb.write_string(after_bytes.to_string())
      sb.write_string(",\"max_bytes\":")
      sb.write_string(max_bytes.to_string())
      sb.write_string("}")
      io_println(world, sb.to_string())
    } else {
      io_println(
        world,
        "pruned " +
        ev.evicted.length().to_string() +
        " entry(s): " +
        before_bytes.to_string() +
        " -> " +
        after_bytes.to_string() +
        " bytes (limit " +
        max_bytes.to_string() +
        " bytes)",
      )
    }
    return 0
  } else if sub == "clear" {
    return drv_cache_clear_impl(world, clear_all, as_json)
  }
  drv_cmd_fail(
    world,
    as_json,
    "unknown cache subcommand `" + sub + "` (expected stats|prune|clear)",
  )
}

///|
fn drv_run_clean_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut clear_all = false
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if a == "--all" {
      clear_all = true
    } else {
      return drv_cmd_fail(world, as_json, "unknown option `" + a + "`")
    }
    i = i + 1
  }
  drv_cache_clear_impl(world, clear_all, as_json)
}

///|
fn drv_find_tool_path(world : World, name : String) -> String {
  if name.length() == 0 {
    return ""
  }
  if drv_has_path_sep(name) {
    if fs_exists(world, name) {
      return name
    }
    return ""
  }
  let p = drv_find_in_path(world, name)
  if p.length() > 0 {
    return p
  }
  if drv_env_str(world, "OS") == "Windows_NT" &&
    !drv_ends_with(name, ".exe") &&
    !drv_ends_with(name, ".EXE") {
    return drv_find_in_path(world, name + ".exe")
  }
  ""
}

///|
fn drv_run_doctor_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut i = 2
  while i < args.length() {
    if args[i] == "--json" {
      as_json = true
    } else {
      return drv_cmd_fail(world, as_json, "unknown option `" + args[i] + "`")
    }
    i = i + 1
  }
  let host_target = drv_resolve_qbe_target(world)
  let self_path = drv_self_exe_path(world)
  let qbe_raw = drv_resolve_qbe_bin(world)
  let qbe_resolved = drv_find_tool_path(world, qbe_raw)
  let qbe_exists = qbe_resolved.length() > 0
  let qbe_path = if qbe_exists { qbe_resolved } else { qbe_raw }
  let rt_lib_path = drv_resolve_rt_lib(world, host_target)
  let rt_lib_exists = fs_exists(world, rt_lib_path)
  let rt_lib_bytes = if rt_lib_exists {
    let sz = fs_size(world, rt_lib_path)
    if sz > 0L { sz } else { 0L }
  } else {
    0L
  }
  let wasm_rt_path = drv_resolve_wasm_rt(world)
  let wasm_rt_exists = fs_exists(world, wasm_rt_path)
  let cc_raw = drv_resolve_cc_driver(world, host_target, false)
  let cc_resolved = drv_find_tool_path(world, cc_raw)
  let cc_exists = cc_resolved.length() > 0
  let cc_path = if cc_exists { cc_resolved } else { cc_raw }
  let cxx_raw = drv_resolve_cc_driver(world, host_target, true)
  let cxx_resolved = drv_find_tool_path(world, cxx_raw)
  let cxx_exists = cxx_resolved.length() > 0
  let cxx_path = if cxx_exists { cxx_resolved } else { cxx_raw }
  let win_abi = if drv_target_is_windows(host_target) {
    if drv_is_windows_msvc_cc(world, host_target, cc_path) {
      "msvc"
    } else {
      "mingw"
    }
  } else {
    "native"
  }
  let wasm_opt_path = drv_find_tool_path(world, "wasm-opt")
  let node_path = drv_find_tool_path(world, "node")
  let git_path = drv_find_tool_path(world, "git")
  let cache_dir = drv_resolve_cache_dir(world)
  let cache_max_mb = drv_resolve_cache_max_bytes(world) / (1024L * 1024L)
  let st_obj = drv_dir_stats(world, drv_join_path(cache_dir, "obj"))
  let st_bin = drv_dir_stats(world, drv_join_path(cache_dir, "bin"))
  let st_tbin = drv_dir_stats(world, drv_join_path(cache_dir, "testbin"))
  let st_sig = drv_dir_stats(world, drv_join_path(cache_dir, "sig"))
  let st_usig = drv_dir_stats(world, drv_join_path(cache_dir, "usig"))
  let st_ssa = drv_dir_stats(world, drv_join_path(cache_dir, "ssa"))
  let st_git = drv_dir_stats(world, drv_git_cache_root(world))
  let cache_files = st_obj.files +
    st_bin.files +
    st_tbin.files +
    st_sig.files +
    st_usig.files +
    st_ssa.files +
    st_git.files
  let cache_bytes = st_obj.bytes +
    st_bin.bytes +
    st_tbin.bytes +
    st_sig.bytes +
    st_usig.bytes +
    st_ssa.bytes +
    st_git.bytes
  let ok = qbe_exists && rt_lib_exists && cc_exists
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":")
    sb.write_string(if ok { "true" } else { "false" })
    sb.write_string(",\"version\":\"0.1.0\",\"host_target\":")
    sb.write_string(json_quote(host_target))
    sb.write_string(",\"pionc\":")
    sb.write_string(json_quote(self_path))
    sb.write_string(",\"qbe\":{\"path\":")
    sb.write_string(json_quote(qbe_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if qbe_exists { "true" } else { "false" })
    sb.write_string("},\"rt_lib\":{\"path\":")
    sb.write_string(json_quote(rt_lib_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if rt_lib_exists { "true" } else { "false" })
    sb.write_string(",\"bytes\":")
    sb.write_string(rt_lib_bytes.to_string())
    sb.write_string("},\"wasm_rt\":{\"path\":")
    sb.write_string(json_quote(wasm_rt_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if wasm_rt_exists { "true" } else { "false" })
    sb.write_string("},\"cc\":{\"path\":")
    sb.write_string(json_quote(cc_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if cc_exists { "true" } else { "false" })
    sb.write_string("},\"cxx\":{\"path\":")
    sb.write_string(json_quote(cxx_path))
    sb.write_string(",\"exists\":")
    sb.write_string(if cxx_exists { "true" } else { "false" })
    sb.write_string("},\"win_abi\":")
    sb.write_string(json_quote(win_abi))
    sb.write_string(",\"wasm_opt\":")
    sb.write_string(json_quote(wasm_opt_path))
    sb.write_string(",\"node\":")
    sb.write_string(json_quote(node_path))
    sb.write_string(",\"git\":")
    sb.write_string(json_quote(git_path))
    sb.write_string(",\"cache_dir\":")
    sb.write_string(json_quote(cache_dir))
    sb.write_string(",\"cache_files\":")
    sb.write_string(cache_files.to_string())
    sb.write_string(",\"cache_bytes\":")
    sb.write_string(cache_bytes.to_string())
    sb.write_string(",\"cache_max_mb\":")
    sb.write_string(cache_max_mb.to_string())
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "pionc doctor (v0.1.0, " + host_target + ")")
    io_println(world, "  pionc:     " + self_path)
    io_println(
      world,
      "  qbe:       " +
      qbe_path +
      (if qbe_exists { " [ok]" } else { " [MISSING]" }),
    )
    io_println(
      world,
      "  rt_lib:    " +
      rt_lib_path +
      (if rt_lib_exists {
        " [ok, " + rt_lib_bytes.to_string() + " B]"
      } else {
        " [MISSING]"
      }),
    )
    io_println(
      world,
      "  wasm_rt:   " +
      wasm_rt_path +
      (if wasm_rt_exists { " [ok]" } else { " [missing]" }),
    )
    io_println(
      world,
      "  cc:        " +
      cc_path +
      (if cc_exists { " [ok]" } else { " [MISSING]" }),
    )
    io_println(
      world,
      "  cxx:       " +
      cxx_path +
      (if cxx_exists { " [ok]" } else { " [missing]" }),
    )
    io_println(world, "  win_abi:   " + win_abi)
    io_println(
      world,
      "  wasm_opt:  " +
      (if wasm_opt_path.length() > 0 { wasm_opt_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  node:      " +
      (if node_path.length() > 0 { node_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  git:       " +
      (if git_path.length() > 0 { git_path } else { "(not found)" }),
    )
    io_println(
      world,
      "  cache:     " +
      cache_dir +
      " (" +
      cache_files.to_string() +
      " files, " +
      cache_bytes.to_string() +
      " bytes, max " +
      cache_max_mb.to_string() +
      " MB)",
    )
    io_println(
      world,
      "  status:    " + (if ok { "OK" } else { "INCOMPLETE" }),
    )
  }
  if ok { 0 } else { 1 }
}

///|
fn drv_toml_strip_comment(line : String) -> String {
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < line.length() {
    let c = str_code_at(line, i)
    if esc {
      esc = false
    } else if in_str {
      if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return slice_str(line, 0, i)
    }
    i = i + 1
  }
  line
}

///|
fn drv_manifest_remove_dependency(text : String, dep_name : String) -> String {
  let lines : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < text.length() {
    if str_code_at(text, i) == 10 {
      lines.push(slice_str(text, start, i))
      start = i + 1
    }
    i = i + 1
  }
  lines.push(slice_str(text, start, text.length()))
  let out : Array[String] = []
  let mut section = ""
  let mut li = 0
  while li < lines.length() {
    let raw = lines[li]
    let clean = drv_trim_ws(drv_toml_strip_comment(raw))
    let mut skip = false
    if clean.length() > 0 {
      if str_code_at(clean, 0) == 91 &&
        str_code_at(clean, clean.length() - 1) == 93 {
        section = drv_trim_ws(slice_str(clean, 1, clean.length() - 1))
      } else if section == "dependencies" {
        let eq = drv_find_substr(clean, "=", 0)
        if eq > 0 && drv_trim_ws(slice_str(clean, 0, eq)) == dep_name {
          skip = true
        }
      }
    }
    if !skip {
      out.push(raw)
    }
    li = li + 1
  }
  let sb = StringBuilder()
  let mut j = 0
  while j < out.length() {
    if j > 0 {
      sb.write_string("\n")
    }
    sb.write_string(out[j])
    j = j + 1
  }
  sb.to_string()
}

///|
fn drv_run_remove_cmd(world : World, args : Array[String]) -> Int {
  let mut as_json = false
  let mut name = ""
  let mut dir = ""
  let mut i = 2
  while i < args.length() {
    let a = args[i]
    if a == "--json" {
      as_json = true
    } else if drv_starts_with(a, "--") {
      return drv_cmd_fail(world, as_json, "unknown option `" + a + "`")
    } else if name.length() == 0 {
      name = a
    } else if dir.length() == 0 {
      dir = a
    } else {
      return drv_cmd_fail(world, as_json, "unexpected argument `" + a + "`")
    }
    i = i + 1
  }
  if name.length() == 0 {
    return drv_cmd_fail(
      world,
      as_json,
      "usage: pionc remove [--json] <name> [dir]",
    )
  }
  let target_dir = if dir.length() > 0 { dir } else { "." }
  let root_dir = match drv_detect_manifest_dir(world, target_dir) {
    Some(d) => d
    None => return drv_cmd_fail(world, as_json, "no pion.toml in " + target_dir)
  }
  let mf_path = drv_join_path(root_dir, "pion.toml")
  let text = match fs_read(world, mf_path) {
    Err(e) =>
      return drv_cmd_fail(world, as_json, "failed to read " + mf_path + ": " + e)
    Ok(t) => t
  }
  let mf = match parse_pion_toml(text) {
    Err(e) => return drv_cmd_fail(world, as_json, e)
    Ok(m) => m
  }
  let mut found = false
  let mut di = 0
  while di < mf.deps.length() {
    if mf.deps[di].name == name {
      found = true
      break
    }
    di = di + 1
  }
  if !found {
    return drv_cmd_fail(
      world,
      as_json,
      "no dependency `" + name + "` in " + mf_path,
    )
  }
  let new_text = drv_manifest_remove_dependency(text, name)
  match parse_pion_toml(new_text) {
    Err(e) =>
      return drv_cmd_fail(
        world,
        as_json,
        "rewritten pion.toml does not parse: " + e,
      )
    Ok(_) => ()
  }
  if !drv_write_text_atomic(world, mf_path, new_text) {
    return drv_cmd_fail(world, as_json, "failed to write " + mf_path)
  }
  let lock_path = drv_join_path(drv_normalize_path(root_dir), "pion.lock")
  if fs_exists(world, lock_path) {
    match drv_load_workspace_ex(world, root_dir, false, "") {
      Ok(_) => ()
      Err(_) =>
        // Fallback: filter out the removed package from pion.lock directly.
        match fs_read(world, lock_path) {
          Ok(ltxt) =>
            match parse_pion_lock(ltxt) {
              Ok(entries) => {
                let kept : Array[LockEntry] = []
                let mut li = 0
                while li < entries.length() {
                  if entries[li].name != name {
                    kept.push(entries[li])
                  }
                  li = li + 1
                }
                let _ = drv_write_text_atomic(
                  world,
                  lock_path,
                  format_pion_lock(kept),
                )
              }
              Err(_) => ()
            }
          Err(_) => ()
        }
    }
  }
  if as_json {
    let sb = StringBuilder()
    sb.write_string("{\"ok\":true,\"removed\":")
    sb.write_string(json_quote(name))
    sb.write_string(",\"manifest\":")
    sb.write_string(json_quote(mf_path))
    sb.write_string("}")
    io_println(world, sb.to_string())
  } else {
    io_println(world, "removed `" + name + "` from " + mf_path)
  }
  0
}

///|
fn drv_usage_text() -> String {
  "usage:\n" +
  "  pionc check [--fix] [--json] [input1 ...]\n" +
  "  pionc query defs|sig|callers|deps [--json] <input1> [input2 ...]\n" +
  "  pionc emit-sig <input1> [input2 ...]\n" +
  "  pionc build [--release] [--target arm64_apple|amd64_apple|amd64_sysv|amd64_win|arm64|rv64|ios_arm64|ios_sim_arm64|android_arm64|android_x64|wasm32] [--sysroot <dir>] [--emit-ssa <path>] [--emit-asm <path>] [--emit-obj <path>] [--emit-staticlib <path.a>] [--emit-cdylib <path.so|.dylib>] [--jobs <n>] [-l <lib>|--link <lib>] [-o <out>] [input1 ...]\n" +
  "  pionc run [--release] [--target <target>] [-l <lib>|--link <lib>] [input] [-- args...]\n" +
  "  pionc fmt [--check] [--json] [input1 ...]\n" +
  "  pionc test [--json] [--package <name>] [--filter <name>] [--jobs <n>] [-l <lib>|--link <lib>] [input]\n" +
  "  pionc doc [--json] [input1 ...]\n" +
  "  pionc init [--template cli|service|invar-app] [--json] <dir>\n" +
  "  pionc fetch [--json] [dir]\n" +
  "  pionc add [--json] <name> (--path <p> | --git <url> [--tag <t>|--rev <r>|--branch <b>] [--subdir <s>] | [--registry <url_or_path>]) [dir]\n" +
  "  pionc remove [--json] <name> [dir]\n" +
  "  pionc update [--json] [pkg] [dir]\n" +
  "  pionc doctor [--json]\n" +
  "  pionc cache stats|prune|clear [--all] [--json]\n" +
  "  pionc clean [--all] [--json]\n" +
  "  pionc --version|-V|version [--json]\n" +
  "  pionc --help|-h|help"
}

///|
fn drv_usage(world : World) -> Unit {
  io_eprintln(world, drv_usage_text())
}

///|
pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() < 2 {
    drv_usage(world)
    return 1
  }
  let cmd = args[1]
  if cmd == "--help" || cmd == "-h" || cmd == "help" {
    io_println(world, drv_usage_text())
    return 0
  }
  if cmd == "--version" || cmd == "-V" || cmd == "version" {
    let mut as_json = false
    let mut vi = 2
    while vi < args.length() {
      if args[vi] == "--json" {
        as_json = true
      }
      vi = vi + 1
    }
    let host_target = drv_resolve_qbe_target(world)
    if as_json {
      io_println(
        world,
        "{\"version\":\"0.1.0\",\"target\":" + json_quote(host_target) + "}",
      )
    } else {
      io_println(world, "pionc 0.1.0 (" + host_target + ", self-hosted)")
    }
    return 0
  }
  if cmd == "doctor" {
    return drv_run_doctor_cmd(world, args)
  }
  if cmd == "cache" {
    return drv_run_cache_cmd(world, args)
  }
  if cmd == "clean" {
    return drv_run_clean_cmd(world, args)
  }
  if cmd == "add" {
    return drv_run_add_cmd(world, args)
  }
  if cmd == "remove" {
    return drv_run_remove_cmd(world, args)
  }
  if cmd == "update" {
    return drv_run_update_cmd(world, args)
  }
  if cmd == "fetch" {
    let mut dir = ""
    let mut i = 2
    while i < args.length() {
      if args[i] != "--json" {
        dir = args[i]
      }
      i = i + 1
    }
    return drv_run_fetch_cmd(world, if dir.length() > 0 { dir } else { "." })
  }
  if cmd == "init" {
    let mut as_json = false
    let mut tmpl = "cli"
    let mut dir = ""
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if a == "--json" {
        as_json = true
      } else if a == "--template" {
        if i + 1 >= args.length() {
          drv_usage(world)
          return 1
        }
        i = i + 1
        tmpl = args[i]
      } else if drv_starts_with(a, "--template=") {
        tmpl = slice_str(a, 11, a.length())
      } else {
        dir = a
      }
      i = i + 1
    }
    if dir.length() == 0 {
      drv_usage(world)
      return 1
    }
    return drv_run_init_cmd(world, dir, tmpl, as_json)
  }
  if cmd == "check" {
    let mut as_json = false
    let mut do_fix = false
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      if args[i] == "--json" {
        as_json = true
      } else if args[i] == "--fix" {
        do_fix = true
      } else {
        targets.push(args[i])
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    if do_fix {
      return drv_run_check_fix_cmd(world, targets, as_json)
    }
    if targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_nodes(world, root_dir) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(nodes) => {
              let all_diags = drv_ws_diagnostics(nodes)
              io_println(world, check_result_to_json(all_diags))
              if all_diags.length() > 0 {
                return 1
              }
              return 0
            }
          }
        None => ()
      }
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let _ = drv_parallel_prehash(world, loaded.sources, 4)
        match cli_check_json(loaded.pkg_name, loaded.paths, loaded.sources) {
          (ok, json) => {
            io_println(world, json)
            if !ok {
              return 1
            }
            return 0
          }
          _ => return 1
        }
      }
    }
  } else if cmd == "query" {
    if args.length() < 4 {
      drv_usage(world)
      return 1
    }
    let kind = args[2]
    let targets : Array[String] = []
    let mut i = 3
    while i < args.length() {
      if args[i] != "--json" {
        targets.push(args[i])
      }
      i = i + 1
    }
    if targets.length() == 0 {
      drv_usage(world)
      return 1
    }
    if kind != "deps" && targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_nodes(world, root_dir) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(nodes) => {
              let pkgs : Array[Package] = []
              let mut ni = 0
              while ni < nodes.length() {
                let node = nodes[ni]
                pkgs.push(parse_package(node.name, node.paths, node.sources))
                ni = ni + 1
              }
              match query_workspace_json(kind, pkgs) {
                Ok(json) => {
                  io_println(world, json)
                  return 0
                }
                Err(msg) => {
                  io_eprintln(world, "error: " + msg)
                  return 1
                }
              }
            }
          }
        None => ()
      }
    }
    // A plain package directory (no pion.toml): its own files plus `src/`.
    let mut src_pair : Option[DrvSrcPair] = None
    if kind != "deps" &&
      targets.length() == 1 &&
      fs_is_dir(world, targets[0]) &&
      fs_is_dir(world, drv_join_path(targets[0], "src")) {
      match drv_load_pkg_dir_sources(world, targets[0]) {
        Err(msg) => {
          io_eprintln(world, "error: " + msg)
          return 1
        }
        Ok(pair) => src_pair = Some(pair)
      }
    }
    match src_pair {
      Some(pair) =>
        match cli_query_json(kind, drv_basename_pkg(targets[0]), pair.paths, pair.sources) {
          Ok(json) => {
            io_println(world, json)
            return 0
          }
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
        }
      None => ()
    }
    if kind == "deps" && targets.length() == 1 {
      match drv_detect_manifest_dir(world, targets[0]) {
        Some(root_dir) =>
          match drv_load_workspace_nodes(world, root_dir) {
            Err(msg) => {
              io_eprintln(world, "error: " + msg)
              return 1
            }
            Ok(nodes) => {
              let names : Array[String] = []
              let dep_lists : Array[Array[String]] = []
              let mut ni = 0
              while ni < nodes.length() {
                names.push(nodes[ni].name)
                dep_lists.push(nodes[ni].deps)
                ni = ni + 1
              }
              let topo = topo_sort_packages(names, dep_lists)
              if topo.diagnostics.length() > 0 {
                io_println(world, check_result_to_json(topo.diagnostics))
                return 1
              }
              let ord_names : Array[String] = []
              let ord_deps : Array[Array[String]] = []
              let ord_hashes : Array[String] = []
              let mut k = 0
              while k < topo.order.length() {
                let node = nodes[topo.order[k]]
                let pkg = parse_package(node.name, node.paths, node.sources)
                ord_names.push(node.name)
                ord_deps.push(node.deps)
                ord_hashes.push(sig_hash_hex(emit_pionsig(pkg)))
                k = k + 1
              }
              io_println(
                world,
                query_workspace_deps_json(ord_names, ord_deps, ord_hashes),
              )
              return 0
            }
          }
        None => ()
      }
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) =>
        match cli_query_json(kind, loaded.pkg_name, loaded.paths, loaded.sources) {
          Ok(json) => {
            io_println(world, json)
            return 0
          }
          Err(msg) => {
            io_eprintln(world, "error: " + msg)
            return 1
          }
        }
    }
  } else if cmd == "emit-sig" {
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      targets.push(args[i])
      i = i + 1
    }
    if targets.length() == 0 {
      drv_usage(world)
      return 1
    }
    match drv_load_targets(world, targets) {
      Err(msg) => {
        io_eprintln(world, "error: " + msg)
        return 1
      }
      Ok(loaded) => {
        let sig = cli_emit_sig(loaded.pkg_name, loaded.paths, loaded.sources)
        io_print(world, sig)
        return 0
      }
    }
  } else if cmd == "build" {
    let mut release = false
    let mut emit_ssa = ""
    let mut emit_asm = ""
    let mut out_bin = ""
    let mut jobs = 16
    let mut target_override = ""
    let mut emit_obj = ""
    let mut emit_staticlib = ""
    let mut emit_cdylib = ""
    let mut sysroot = ""
    let libs : Array[String] = []
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      let nl = drv_parse_link_flag(args, i, libs)
      if nl > 0 {
        i = i + nl
        continue
      }
      if a == "--release" {
        release = true
      } else if a == "--target" && i + 1 < args.length() {
        target_override = args[i + 1]
        i = i + 1
      } else if a == "--emit-obj" && i + 1 < args.length() {
        emit_obj = args[i + 1]
        i = i + 1
      } else if a == "--emit-staticlib" && i + 1 < args.length() {
        emit_staticlib = args[i + 1]
        i = i + 1
      } else if a == "--emit-cdylib" && i + 1 < args.length() {
        emit_cdylib = args[i + 1]
        i = i + 1
      } else if a == "--sysroot" && i + 1 < args.length() {
        sysroot = args[i + 1]
        i = i + 1
      } else if a == "--emit-ssa" && i + 1 < args.length() {
        emit_ssa = args[i + 1]
        i = i + 1
      } else if a == "--emit-asm" && i + 1 < args.length() {
        emit_asm = args[i + 1]
        i = i + 1
      } else if a == "--jobs" && i + 1 < args.length() {
        jobs = drv_parse_pos_int(args[i + 1], 16)
        i = i + 1
      } else if a == "-o" && i + 1 < args.length() {
        out_bin = args[i + 1]
        i = i + 1
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        io_eprintln(
          world,
          "error: no target specified and no pion.toml in current directory",
        )
        return 1
      }
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      io_eprintln(
        world,
        "error: unsupported --target `" +
        target_override +
        "` (expected arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, or wasm32)",
      )
      return 1
    }
    match drv_build_targets(
      world,
      targets,
      release,
      emit_ssa,
      emit_asm,
      out_bin,
      jobs,
      target_override,
      emit_obj,
      emit_staticlib,
      emit_cdylib,
      sysroot,
      libs,
    ) {
      Ok(_) => return 0
      Err(msg) => {
        io_eprintln(world, msg)
        return 1
      }
    }
  } else if cmd == "run" {
    let mut release = false
    let mut target_override = ""
    let mut target = ""
    let libs : Array[String] = []
    let prog_args : Array[String] = []
    let mut after_sep = false
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if !after_sep && target == "" {
        let nl = drv_parse_link_flag(args, i, libs)
        if nl > 0 {
          i = i + nl
          continue
        }
      }
      if after_sep {
        prog_args.push(a)
      } else if a == "--" {
        after_sep = true
      } else if a == "--release" && target == "" {
        release = true
      } else if a == "--target" && target == "" && i + 1 < args.length() {
        target_override = args[i + 1]
        i = i + 1
      } else if target == "" {
        target = a
      } else {
        prog_args.push(a)
      }
      i = i + 1
    }
    if target == "" {
      if drv_has_default_project(world) {
        target = "."
      } else {
        io_eprintln(
          world,
          "error: no target specified and no pion.toml in current directory",
        )
        return 1
      }
    }
    if target_override != "" && !drv_target_is_valid(target_override) {
      io_eprintln(
        world,
        "error: unsupported --target `" +
        target_override +
        "` (expected arm64_apple, amd64_apple, amd64_sysv, amd64_win, arm64, rv64, ios_arm64, ios_sim_arm64, android_arm64, android_x64, or wasm32)",
      )
      return 1
    }
    match drv_build_targets(
      world,
      [target],
      release,
      "",
      "",
      "",
      drv_default_jobs(world),
      target_override,
      "",
      "",
      "",
      "",
      libs,
    ) {
      Err(msg) => {
        io_eprintln(world, msg)
        return 1
      }
      Ok(bin_path) => {
        if drv_target_is_wasm(drv_pick_target(world, target_override)) {
          let rt_mjs = drv_resolve_wasm_rt(world)
          let run_argv : Array[String] = ["node", rt_mjs, bin_path]
          let mut j = 0
          while j < prog_args.length() {
            run_argv.push(prog_args[j])
            j = j + 1
          }
          return proc_exec(world, run_argv)
        }
        let run_argv : Array[String] = [bin_path]
        let mut j = 0
        while j < prog_args.length() {
          run_argv.push(prog_args[j])
          j = j + 1
        }
        return proc_exec(world, run_argv)
      }
    }
  } else if cmd == "fmt" {
    let mut check_only = false
    let mut as_json = false
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      if a == "--check" {
        check_only = true
      } else if a == "--json" {
        as_json = true
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    return drv_run_fmt_cmd(world, targets, check_only, as_json)
  } else if cmd == "test" {
    let mut as_json = false
    let mut filter = ""
    let mut only_pkg = ""
    let mut jobs = drv_default_jobs(world)
    let libs : Array[String] = []
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      let a = args[i]
      let nl = drv_parse_link_flag(args, i, libs)
      if nl > 0 {
        i = i + nl
        continue
      }
      if a == "--json" {
        as_json = true
      } else if a == "--filter" && i + 1 < args.length() {
        filter = args[i + 1]
        i = i + 1
      } else if a == "--package" && i + 1 < args.length() {
        only_pkg = args[i + 1]
        i = i + 1
      } else if a == "--jobs" && i + 1 < args.length() {
        jobs = drv_parse_pos_int(args[i + 1], jobs)
        i = i + 1
      } else {
        targets.push(a)
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    return drv_run_tests_cmd(world, targets, as_json, filter, libs, only_pkg, jobs)
  } else if cmd == "doc" {
    let mut as_json = false
    let targets : Array[String] = []
    let mut i = 2
    while i < args.length() {
      if args[i] == "--json" {
        as_json = true
      } else {
        targets.push(args[i])
      }
      i = i + 1
    }
    if targets.length() == 0 {
      if drv_has_default_project(world) {
        targets.push(".")
      } else {
        return drv_cmd_fail(
          world,
          as_json,
          "no target specified and no pion.toml in current directory",
        )
      }
    }
    return drv_run_doc_cmd(world, targets, as_json)
  } else {
    drv_usage(world)
    return 1
  }
}
