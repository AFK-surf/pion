///|
fn irct_count(s : String, needle : String) -> Int {
  let mut c = 0
  let mut i = 0
  while i + needle.length() <= s.length() {
    if slice_str(s, i, i + needle.length()) == needle {
      c = c + 1
      i = i + needle.length()
    } else {
      i = i + 1
    }
  }
  c
}

///|
test "p101_silent_rc_null_phi_copy" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %z =l copy 0
    #|    %z2 =l copy %z
    #|    call $pion_rc_dec(l 0)
    #|    call $pion_rc_dec(l %z2)
    #|    %lit =l add $pion_str_0_hdr, 24
    #|    jnz %c, @a, @b
    #|@a
    #|    jmp @m
    #|@b
    #|    jmp @m
    #|@m
    #|    %p =l phi @a %lit, @b 0
    #|    %q =l phi @a %lit, @b %x
    #|    %r =w phi @a 0, @b 0
    #|    call $pion_rc_inc(l %p)
    #|    call $pion_rc_dec(l %q)
    #|    jmp @l
    #|@l
    #|    %i =l phi @m 0, @l %j
    #|    %j =l copy %i
    #|    call $pion_rc_dec(l %j)
    #|    jnz %c, @l, @e
    #|@e
    #|    ret %p
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l 0)"), false)
  assert_eq(out.contains("(l %z2)"), false)
  assert_eq(out.contains("rc_inc(l %p)"), false)
  // One unproven phi input, or a cycle that would have to prove itself: kept.
  assert_eq(out.contains("rc_dec(l %q)"), true)
  assert_eq(out.contains("rc_dec(l %j)"), true)
}

///|
test "p101_silent_rc_private_slots" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %ok =l alloc8 8
    #|    storel 0, %ok
    #|    %mix =l alloc8 8
    #|    storel 0, %mix
    #|    %esc =l alloc8 8
    #|    storel 0, %esc
    #|    %nar =l alloc8 8
    #|    storel 0, %nar
    #|    %leak =l alloc8 8
    #|    storel 0, %leak
    #|    storel %leak, %x
    #|    %noinit =l alloc8 8
    #|    %big =l alloc8 16
    #|    storel 0, %big
    #|    %lit =l add $pion_enum_0_hdr, 24
    #|    call $use(l %esc)
    #|    jnz %c, @a, @b
    #|@a
    #|    storel %lit, %ok
    #|    storel %x, %mix
    #|    %m0 =l loadl %mix
    #|    call $pion_rc_dec(l %m0)
    #|    storel 0, %mix
    #|    call $g()
    #|    %m1 =l loadl %mix
    #|    call $pion_rc_dec(l %m1)
    #|    storel 0, %noinit
    #|    storeb 1, %nar
    #|    jmp @b
    #|@b
    #|    %o1 =l loadl %ok
    #|    call $pion_rc_dec(l %o1)
    #|    %m2 =l loadl %mix
    #|    call $pion_rc_dec(l %m2)
    #|    %e1 =l loadl %esc
    #|    call $pion_rc_dec(l %e1)
    #|    %n1 =l loadl %nar
    #|    call $pion_rc_dec(l %n1)
    #|    %l1 =l loadl %leak
    #|    call $pion_rc_dec(l %l1)
    #|    %u1 =l loadl %noinit
    #|    call $pion_rc_dec(l %u1)
    #|    %b1 =l loadl %big
    #|    call $pion_rc_dec(l %b1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l %o1)"), false)
  // Latest store of the same block wins over the slot-wide facts.
  assert_eq(out.contains("rc_dec(l %m1)"), false)
  assert_eq(out.contains("rc_dec(l %m0)"), true)
  assert_eq(out.contains("rc_dec(l %m2)"), true)
  assert_eq(out.contains("rc_dec(l %e1)"), true)
  assert_eq(out.contains("rc_dec(l %n1)"), true)
  assert_eq(out.contains("rc_dec(l %l1)"), true)
  assert_eq(out.contains("rc_dec(l %u1)"), true)
  assert_eq(out.contains("rc_dec(l %b1)"), true)
}

///|
test "p101_silent_rc_entry_and_multi_def" {
  // The entry block loads before it stores; a multiply defined temporary or slot
  // and a slot allocated outside the entry block prove nothing.
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    %early =l loadl %s
    #|    call $pion_rc_dec(l %early)
    #|    storel 0, %s
    #|    %late =l loadl %s
    #|    call $pion_rc_dec(l %late)
    #|    %d =l copy 0
    #|    %d =l copy %x
    #|    call $pion_rc_dec(l %d)
    #|    %dd =l copy %d
    #|    call $pion_rc_dec(l %dd)
    #|    jmp @l
    #|@l
    #|    %t =l alloc8 8
    #|    storel 0, %t
    #|    jmp @n
    #|@n
    #|    %t1 =l loadl %t
    #|    call $pion_rc_dec(l %t1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("(l %early)"), true)
  assert_eq(out.contains("(l %late)"), false)
  assert_eq(out.contains("(l %d)"), true)
  assert_eq(out.contains("(l %dd)"), true)
  assert_eq(out.contains("(l %t1)"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 4)
  // A jump back to the entry label breaks entry initialization of other blocks.
  let back =
    #|export function l $g(w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    storel 0, %s
    #|    jmp @b
    #|@b
    #|    %v =l loadl %s
    #|    call $pion_rc_dec(l %v)
    #|    jnz %c, @start, @e
    #|@e
    #|    ret 0
    #|}
  assert_eq(cleanup_native_rc_ssa(back).contains("(l %v)"), true)
}

///|
test "irc_scan_fast_path_boundaries" {
  // ASCII ranges slice bytes; any non-ASCII range keeps scalar decoding.
  assert_eq(irc_slice("abcdef", 1, 4), "bcd")
  assert_eq(irc_slice("abc", 0, 3), "abc")
  assert_eq(irc_slice("abc", 2, 2), "")
  assert_eq(irc_slice("abc", 3, 1), "")
  let u = "a\u{4E2D}b"
  assert_eq(irc_slice(u, 0, u.length()), u)
  assert_eq(irc_slice(u, 1, u.length() - 1), "\u{4E2D}")
  assert_eq(irc_slice(u, u.length() - 1, u.length()), "b")
  // Comments: the `#`-free shortcut and quote-aware stripping agree.
  assert_eq(irc_strip_comment("  call $f() \t"), "call $f()")
  assert_eq(irc_strip_comment("  ret %x # done"), "ret %x")
  assert_eq(irc_strip_comment("b \"a#b\" # c"), "b \"a#b\"")
  assert_eq(irc_strip_comment("# only"), "")
  // A lone `}` may carry whitespace and a trailing comment, nothing else.
  let lines = ["}", "  }\t\r", "} # end", "}#x", "}x", "} %x", "  ", "", "# }", "x }", "} \"#\""]
  let want = [true, true, true, true, false, false, false, false, false, false, false]
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    assert_eq(irc_is_close_brace_range(l, 0, l.length()), want[i])
    i = i + 1
  }
  // Function boundaries: braces and `#` inside data strings, comment lines in a
  // body and a commented closing brace do not hide or merge functions.
  let ssa =
    #|data $s = { b "}{#\"", b 0 }
    #|export function l $f(l %x) {
    #|@start
    #|    # a comment with } and "
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|} # end of $f
    #|export function l $g(l %x) {
    #|@start
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("data $s = { b \"}{#\\\"\", b 0 }\n"), true)
  assert_eq(out.contains("function l $f(l %x) {"), true)
  assert_eq(out.contains("function l $g(l %x) {"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 0)
}

///|
fn irct_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == 10 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < s.length() {
    out.push(slice_str(s, start, s.length()))
  }
  out
}

///|
fn irct_same(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "irc_cancel_skips_blocks_without_window_or_inc" {
  // Prefix gate: leading blanks are skipped, comments and decs never count,
  // and only lines inside [start, end) are examined.
  let probe = [
    "\t  call $pion_rc_inc(l %a) # c", "    # call $pion_rc_inc(l %a)", "    call $pion_rc_dec(l %a)",
    "    call $pion_rc_inc_n(l %a)",
  ]
  assert_eq(irc_block_has_inc(probe, 0, 1), true)
  assert_eq(irc_block_has_inc(probe, 1, 4), false)
  assert_eq(irc_block_has_inc(probe, 0, 0), false)
  // A function without any inc is returned untouched, decs included.
  let no_inc_src =
    #|@start
    #|    %a =l copy %x
    #|    call $pion_rc_dec(l %a)
    #|    call $pion_rc_dec(l %a)
    #|    jnz %c, @oob, @ok
    #|@oob
    #|    call $pion_panic(l 0)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %a)
    #|    ret %a
  let no_inc = irct_lines(no_inc_src)
  assert_eq(irct_same(irc_cancel_same_block_rc("function l $f(l %x, w %c) {", no_inc, 0), no_inc), true)
  // A window opened in @start passes the trap branch into @ok, which has no inc
  // of its own: its dec still cancels. @tail is reached by a plain jump, has
  // neither an incoming window nor an inc, so its dec stays.
  let pass_src =
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    jnz %c, @oob, @ok
    #|@oob
    #|    call $pion_panic(l 0)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %x)
    #|    jmp @tail
    #|@tail
    #|    call $pion_rc_dec(l %x)
    #|    ret %x
  let pass = irct_lines(pass_src)
  let got = irc_cancel_same_block_rc("function l $f(l %x, w %c) {", pass, 0)
  assert_eq(got.length(), pass.length() - 2)
  let mut joined = ""
  let mut gi = 0
  while gi < got.length() {
    joined = joined + got[gi] + "\n"
    gi = gi + 1
  }
  assert_eq(irct_count(joined, "call $pion_rc_inc"), 0)
  assert_eq(irct_count(joined, "call $pion_rc_dec(l %x)"), 1)
  assert_eq(joined.contains("@tail\n    call $pion_rc_dec(l %x)"), true)
  // Same CFG with trap penetration disabled (mask 8): nothing crosses blocks.
  let off = irc_cancel_same_block_rc("function l $f(l %x, w %c) {", pass, 8)
  assert_eq(irct_same(off, pass), true)
}

///|
fn irct_pair(s : String) -> Bool {
  irc_has_candidate_pair(irct_lines(s))
}

///|
test "irc_candidate_pair_is_ordered_and_per_tmp" {
  let hdr = "function l $f(l %x, l %y, w %c) {"
  // Only incs, only decs, different temporaries, and a lone dec before an inc:
  // no candidate, and the pass returns the function untouched.
  let no_pair = [
    "@start\n    call $pion_rc_inc(l %x)\n    ret %x",
    "@start\n    call $pion_rc_dec(l %x)\n    ret 0",
    "@start\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %y)\n    ret %x",
    "@start\n    call $pion_rc_dec(l %x)\n    call $pion_rc_inc(l %x)\n    ret %x",
    // `%x` is not a prefix match of `%x1`; comments and non-tmp args never count.
    "@start\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x1)\n    ret %x",
    "@start\n    # call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x)\n    ret 0",
    "@start\n    call $pion_rc_inc(l 0)\n    call $pion_rc_dec(l 0)\n    ret 0",
    "@start\n    call $pion_rc_inc(l $g)\n    call $pion_rc_dec(l $g)\n    ret 0",
    "",
  ]
  let mut i = 0
  while i < no_pair.length() {
    let lines = irct_lines(no_pair[i])
    assert_eq(irc_has_candidate_pair(lines), false)
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, lines, 0), lines), true)
    i = i + 1
  }
  // A legal pair, with blanks and comments around the calls, is found and cancelled.
  let legal = "@start\n\t  call $pion_rc_inc(l  %x ) # a\n    %n =l add %y, 1\n    call $pion_rc_dec(l %x) # b\n    ret %n"
  assert_eq(irct_pair(legal), true)
  let cancelled = irc_cancel_same_block_rc(hdr, irct_lines(legal), 0)
  assert_eq(irct_same(cancelled, irct_lines("@start\n    %n =l add %y, 1\n    ret %n")), true)
  // dec, inc, dec of one temporary: the trailing pair still counts.
  let trailing = "@start\n    call $pion_rc_dec(l %x)\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x)\n    ret 0"
  assert_eq(irct_pair(trailing), true)
  let kept_dec = irc_cancel_same_block_rc(hdr, irct_lines(trailing), 0)
  assert_eq(irct_same(kept_dec, irct_lines("@start\n    call $pion_rc_dec(l %x)\n    ret 0")), true)
}

///|
test "irc_candidate_pair_across_blocks" {
  let hdr = "function l $f(l %x, w %c) {"
  // inc and dec in different blocks joined by a plain jump: a candidate, but the
  // full checks keep both.
  let plain = irct_lines("@start\n    call $pion_rc_inc(l %x)\n    jmp @next\n@next\n    call $pion_rc_dec(l %x)\n    ret %x")
  assert_eq(irc_has_candidate_pair(plain), true)
  assert_eq(irct_same(irc_cancel_same_block_rc(hdr, plain, 0), plain), true)
  // Forward trap successor, either branch polarity: the window crosses and cancels.
  let forward = irct_lines("@start\n    call $pion_rc_inc(l %x)\n    jnz %c, @ok, @oob\n@oob\n    call $pion_panic(l 0)\n    hlt\n@ok\n    call $pion_rc_dec(l %x)\n    ret %x")
  assert_eq(irc_has_candidate_pair(forward), true)
  assert_eq(irc_cancel_same_block_rc(hdr, forward, 0).length(), forward.length() - 2)
  // The single-predecessor trap successor laid out BEFORE its branching block,
  // either polarity: windows never propagate backward, so skipping the function
  // because the dec comes first changes nothing.
  let jumps = ["jnz %c, @oob, @ok", "jnz %c, @ok, @oob"]
  let mut i = 0
  while i < jumps.length() {
    let dec_first = "@start\n    jmp @chk\n@ok\n    call $pion_rc_dec(l %x)\n    ret %x\n@chk\n    call $pion_rc_inc(l %x)\n    " + jumps[i] + "\n@oob\n    call $pion_panic(l 0)\n    hlt"
    let back = irct_lines(dec_first)
    assert_eq(irc_has_candidate_pair(back), false)
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, back, 0), back), true)
    // Force the full pass with an unrelated legal pair: still nothing crosses
    // backward, only that pair disappears.
    let forced = irct_lines(dec_first + "\n@un\n    call $pion_rc_inc(l %c)\n    call $pion_rc_dec(l %c)\n    ret 0")
    assert_eq(irc_has_candidate_pair(forced), true)
    let forced_want = irct_lines(dec_first + "\n@un\n    ret 0")
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, forced, 0), forced_want), true)
    i = i + 1
  }
}
