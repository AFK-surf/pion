///|
fn irct_count(s : String, needle : String) -> Int {
  let mut c = 0
  let mut i = 0
  while i + needle.length() <= s.length() {
    if slice_str(s, i, i + needle.length()) == needle {
      c = c + 1
      i = i + needle.length()
    } else {
      i = i + 1
    }
  }
  c
}

///|
test "p101_silent_rc_null_phi_copy" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %z =l copy 0
    #|    %z2 =l copy %z
    #|    call $pion_rc_dec(l 0)
    #|    call $pion_rc_dec(l %z2)
    #|    %lit =l add $pion_str_0_hdr, 24
    #|    jnz %c, @a, @b
    #|@a
    #|    jmp @m
    #|@b
    #|    jmp @m
    #|@m
    #|    %p =l phi @a %lit, @b 0
    #|    %q =l phi @a %lit, @b %x
    #|    %r =w phi @a 0, @b 0
    #|    call $pion_rc_inc(l %p)
    #|    call $pion_rc_dec(l %q)
    #|    jmp @l
    #|@l
    #|    %i =l phi @m 0, @l %j
    #|    %j =l copy %i
    #|    call $pion_rc_dec(l %j)
    #|    jnz %c, @l, @e
    #|@e
    #|    ret %p
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l 0)"), false)
  assert_eq(out.contains("(l %z2)"), false)
  assert_eq(out.contains("rc_inc(l %p)"), false)
  // One unproven phi input, or a cycle that would have to prove itself: kept.
  assert_eq(out.contains("rc_dec(l %q)"), true)
  assert_eq(out.contains("rc_dec(l %j)"), true)
}

///|
test "p101_silent_rc_private_slots" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %ok =l alloc8 8
    #|    storel 0, %ok
    #|    %mix =l alloc8 8
    #|    storel 0, %mix
    #|    %esc =l alloc8 8
    #|    storel 0, %esc
    #|    %nar =l alloc8 8
    #|    storel 0, %nar
    #|    %leak =l alloc8 8
    #|    storel 0, %leak
    #|    storel %leak, %x
    #|    %noinit =l alloc8 8
    #|    %big =l alloc8 16
    #|    storel 0, %big
    #|    %lit =l add $pion_enum_0_hdr, 24
    #|    call $use(l %esc)
    #|    jnz %c, @a, @b
    #|@a
    #|    storel %lit, %ok
    #|    storel %x, %mix
    #|    %m0 =l loadl %mix
    #|    call $pion_rc_dec(l %m0)
    #|    storel 0, %mix
    #|    call $g()
    #|    %m1 =l loadl %mix
    #|    call $pion_rc_dec(l %m1)
    #|    storel 0, %noinit
    #|    storeb 1, %nar
    #|    jmp @b
    #|@b
    #|    %o1 =l loadl %ok
    #|    call $pion_rc_dec(l %o1)
    #|    %m2 =l loadl %mix
    #|    call $pion_rc_dec(l %m2)
    #|    %e1 =l loadl %esc
    #|    call $pion_rc_dec(l %e1)
    #|    %n1 =l loadl %nar
    #|    call $pion_rc_dec(l %n1)
    #|    %l1 =l loadl %leak
    #|    call $pion_rc_dec(l %l1)
    #|    %u1 =l loadl %noinit
    #|    call $pion_rc_dec(l %u1)
    #|    %b1 =l loadl %big
    #|    call $pion_rc_dec(l %b1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l %o1)"), false)
  // Latest store of the same block wins over the slot-wide facts.
  assert_eq(out.contains("rc_dec(l %m1)"), false)
  assert_eq(out.contains("rc_dec(l %m0)"), true)
  assert_eq(out.contains("rc_dec(l %m2)"), true)
  assert_eq(out.contains("rc_dec(l %e1)"), true)
  assert_eq(out.contains("rc_dec(l %n1)"), true)
  assert_eq(out.contains("rc_dec(l %l1)"), true)
  assert_eq(out.contains("rc_dec(l %u1)"), true)
  assert_eq(out.contains("rc_dec(l %b1)"), true)
}

///|
test "p101_silent_rc_entry_and_multi_def" {
  // The entry block loads before it stores; a multiply defined temporary or slot
  // and a slot allocated outside the entry block prove nothing.
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    %early =l loadl %s
    #|    call $pion_rc_dec(l %early)
    #|    storel 0, %s
    #|    %late =l loadl %s
    #|    call $pion_rc_dec(l %late)
    #|    %d =l copy 0
    #|    %d =l copy %x
    #|    call $pion_rc_dec(l %d)
    #|    %dd =l copy %d
    #|    call $pion_rc_dec(l %dd)
    #|    jmp @l
    #|@l
    #|    %t =l alloc8 8
    #|    storel 0, %t
    #|    jmp @n
    #|@n
    #|    %t1 =l loadl %t
    #|    call $pion_rc_dec(l %t1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("(l %early)"), true)
  assert_eq(out.contains("(l %late)"), false)
  assert_eq(out.contains("(l %d)"), true)
  assert_eq(out.contains("(l %dd)"), true)
  assert_eq(out.contains("(l %t1)"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 4)
  // A jump back to the entry label breaks entry initialization of other blocks.
  let back =
    #|export function l $g(w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    storel 0, %s
    #|    jmp @b
    #|@b
    #|    %v =l loadl %s
    #|    call $pion_rc_dec(l %v)
    #|    jnz %c, @start, @e
    #|@e
    #|    ret 0
    #|}
  assert_eq(cleanup_native_rc_ssa(back).contains("(l %v)"), true)
}

///|
test "irc_scan_fast_path_boundaries" {
  // ASCII ranges slice bytes; any non-ASCII range keeps scalar decoding.
  assert_eq(irc_slice("abcdef", 1, 4), "bcd")
  assert_eq(irc_slice("abc", 0, 3), "abc")
  assert_eq(irc_slice("abc", 2, 2), "")
  assert_eq(irc_slice("abc", 3, 1), "")
  let u = "a\u{4E2D}b"
  assert_eq(irc_slice(u, 0, u.length()), u)
  assert_eq(irc_slice(u, 1, u.length() - 1), "\u{4E2D}")
  assert_eq(irc_slice(u, u.length() - 1, u.length()), "b")
  // Comments: the `#`-free shortcut and quote-aware stripping agree.
  assert_eq(irc_strip_comment("  call $f() \t"), "call $f()")
  assert_eq(irc_strip_comment("  ret %x # done"), "ret %x")
  assert_eq(irc_strip_comment("b \"a#b\" # c"), "b \"a#b\"")
  assert_eq(irc_strip_comment("# only"), "")
  // A lone `}` may carry whitespace and a trailing comment, nothing else.
  let lines = ["}", "  }\t\r", "} # end", "}#x", "}x", "} %x", "  ", "", "# }", "x }", "} \"#\""]
  let want = [true, true, true, true, false, false, false, false, false, false, false]
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    assert_eq(irc_is_close_brace_range(l, 0, l.length()), want[i])
    i = i + 1
  }
  // Function boundaries: braces and `#` inside data strings, comment lines in a
  // body and a commented closing brace do not hide or merge functions.
  let ssa =
    #|data $s = { b "}{#\"", b 0 }
    #|export function l $f(l %x) {
    #|@start
    #|    # a comment with } and "
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|} # end of $f
    #|export function l $g(l %x) {
    #|@start
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("data $s = { b \"}{#\\\"\", b 0 }\n"), true)
  assert_eq(out.contains("function l $f(l %x) {"), true)
  assert_eq(out.contains("function l $g(l %x) {"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 0)
}
