///|
fn irct_count(s : String, needle : String) -> Int {
  let mut c = 0
  let mut i = 0
  while i + needle.length() <= s.length() {
    if slice_str(s, i, i + needle.length()) == needle {
      c = c + 1
      i = i + needle.length()
    } else {
      i = i + 1
    }
  }
  c
}

///|
test "p101_silent_rc_null_phi_copy" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %z =l copy 0
    #|    %z2 =l copy %z
    #|    call $pion_rc_dec(l 0)
    #|    call $pion_rc_dec(l %z2)
    #|    %lit =l add $pion_str_0_hdr, 24
    #|    jnz %c, @a, @b
    #|@a
    #|    jmp @m
    #|@b
    #|    jmp @m
    #|@m
    #|    %p =l phi @a %lit, @b 0
    #|    %q =l phi @a %lit, @b %x
    #|    %r =w phi @a 0, @b 0
    #|    call $pion_rc_inc(l %p)
    #|    call $pion_rc_dec(l %q)
    #|    jmp @l
    #|@l
    #|    %i =l phi @m 0, @l %j
    #|    %j =l copy %i
    #|    call $pion_rc_dec(l %j)
    #|    jnz %c, @l, @e
    #|@e
    #|    ret %p
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l 0)"), false)
  assert_eq(out.contains("(l %z2)"), false)
  assert_eq(out.contains("rc_inc(l %p)"), false)
  // One unproven phi input, or a cycle that would have to prove itself: kept.
  assert_eq(out.contains("rc_dec(l %q)"), true)
  assert_eq(out.contains("rc_dec(l %j)"), true)
}

///|
test "p101_silent_rc_private_slots" {
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %ok =l alloc8 8
    #|    storel 0, %ok
    #|    %mix =l alloc8 8
    #|    storel 0, %mix
    #|    %esc =l alloc8 8
    #|    storel 0, %esc
    #|    %nar =l alloc8 8
    #|    storel 0, %nar
    #|    %leak =l alloc8 8
    #|    storel 0, %leak
    #|    storel %leak, %x
    #|    %noinit =l alloc8 8
    #|    %big =l alloc8 16
    #|    storel 0, %big
    #|    %lit =l add $pion_enum_0_hdr, 24
    #|    call $use(l %esc)
    #|    jnz %c, @a, @b
    #|@a
    #|    storel %lit, %ok
    #|    storel %x, %mix
    #|    %m0 =l loadl %mix
    #|    call $pion_rc_dec(l %m0)
    #|    storel 0, %mix
    #|    call $g()
    #|    %m1 =l loadl %mix
    #|    call $pion_rc_dec(l %m1)
    #|    storel 0, %noinit
    #|    storeb 1, %nar
    #|    jmp @b
    #|@b
    #|    %o1 =l loadl %ok
    #|    call $pion_rc_dec(l %o1)
    #|    %m2 =l loadl %mix
    #|    call $pion_rc_dec(l %m2)
    #|    %e1 =l loadl %esc
    #|    call $pion_rc_dec(l %e1)
    #|    %n1 =l loadl %nar
    #|    call $pion_rc_dec(l %n1)
    #|    %l1 =l loadl %leak
    #|    call $pion_rc_dec(l %l1)
    #|    %u1 =l loadl %noinit
    #|    call $pion_rc_dec(l %u1)
    #|    %b1 =l loadl %big
    #|    call $pion_rc_dec(l %b1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("rc_dec(l %o1)"), false)
  // Latest store of the same block wins over the slot-wide facts.
  assert_eq(out.contains("rc_dec(l %m1)"), false)
  assert_eq(out.contains("rc_dec(l %m0)"), true)
  assert_eq(out.contains("rc_dec(l %m2)"), true)
  assert_eq(out.contains("rc_dec(l %e1)"), true)
  assert_eq(out.contains("rc_dec(l %n1)"), true)
  assert_eq(out.contains("rc_dec(l %l1)"), true)
  assert_eq(out.contains("rc_dec(l %u1)"), true)
  assert_eq(out.contains("rc_dec(l %b1)"), true)
}

///|
test "p101_silent_rc_entry_and_multi_def" {
  // The entry block loads before it stores; a multiply defined temporary or slot
  // and a slot allocated outside the entry block prove nothing.
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    %early =l loadl %s
    #|    call $pion_rc_dec(l %early)
    #|    storel 0, %s
    #|    %late =l loadl %s
    #|    call $pion_rc_dec(l %late)
    #|    %d =l copy 0
    #|    %d =l copy %x
    #|    call $pion_rc_dec(l %d)
    #|    %dd =l copy %d
    #|    call $pion_rc_dec(l %dd)
    #|    jmp @l
    #|@l
    #|    %t =l alloc8 8
    #|    storel 0, %t
    #|    jmp @n
    #|@n
    #|    %t1 =l loadl %t
    #|    call $pion_rc_dec(l %t1)
    #|    ret 0
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("(l %early)"), true)
  assert_eq(out.contains("(l %late)"), false)
  assert_eq(out.contains("(l %d)"), true)
  assert_eq(out.contains("(l %dd)"), true)
  assert_eq(out.contains("(l %t1)"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 4)
  // A jump back to the entry label breaks entry initialization of other blocks.
  let back =
    #|export function l $g(w %c) {
    #|@start
    #|    %s =l alloc8 8
    #|    storel 0, %s
    #|    jmp @b
    #|@b
    #|    %v =l loadl %s
    #|    call $pion_rc_dec(l %v)
    #|    jnz %c, @start, @e
    #|@e
    #|    ret 0
    #|}
  assert_eq(cleanup_native_rc_ssa(back).contains("(l %v)"), true)
}

///|
test "irc_scan_fast_path_boundaries" {
  // ASCII ranges slice bytes; any non-ASCII range keeps scalar decoding.
  assert_eq(irc_slice("abcdef", 1, 4), "bcd")
  assert_eq(irc_slice("abc", 0, 3), "abc")
  assert_eq(irc_slice("abc", 2, 2), "")
  assert_eq(irc_slice("abc", 3, 1), "")
  let u = "a\u{4E2D}b"
  assert_eq(irc_slice(u, 0, u.length()), u)
  assert_eq(irc_slice(u, 1, u.length() - 1), "\u{4E2D}")
  assert_eq(irc_slice(u, u.length() - 1, u.length()), "b")
  // Comments: the `#`-free shortcut and quote-aware stripping agree.
  assert_eq(irc_strip_comment("  call $f() \t"), "call $f()")
  assert_eq(irc_strip_comment("  ret %x # done"), "ret %x")
  assert_eq(irc_strip_comment("b \"a#b\" # c"), "b \"a#b\"")
  assert_eq(irc_strip_comment("# only"), "")
  // A lone `}` may carry whitespace and a trailing comment, nothing else.
  let lines = ["}", "  }\t\r", "} # end", "}#x", "}x", "} %x", "  ", "", "# }", "x }", "} \"#\""]
  let want = [true, true, true, true, false, false, false, false, false, false, false]
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    assert_eq(irc_is_close_brace_range(l, 0, l.length()), want[i])
    i = i + 1
  }
  // Function boundaries: braces and `#` inside data strings, comment lines in a
  // body and a commented closing brace do not hide or merge functions.
  let ssa =
    #|data $s = { b "}{#\"", b 0 }
    #|export function l $f(l %x) {
    #|@start
    #|    # a comment with } and "
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|} # end of $f
    #|export function l $g(l %x) {
    #|@start
    #|    call $pion_rc_dec(l 0)
    #|    ret %x
    #|}
  let out = cleanup_native_rc_ssa(ssa)
  assert_eq(out.contains("data $s = { b \"}{#\\\"\", b 0 }\n"), true)
  assert_eq(out.contains("function l $f(l %x) {"), true)
  assert_eq(out.contains("function l $g(l %x) {"), true)
  assert_eq(irct_count(out, "call $pion_rc_dec"), 0)
}

///|
fn irct_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == 10 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < s.length() {
    out.push(slice_str(s, start, s.length()))
  }
  out
}

///|
fn irct_same(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "irc_cancel_skips_blocks_without_window_or_inc" {
  // Prefix gate: leading blanks are skipped, comments and decs never count,
  // and only lines inside [start, end) are examined.
  let probe = [
    "\t  call $pion_rc_inc(l %a) # c", "    # call $pion_rc_inc(l %a)", "    call $pion_rc_dec(l %a)",
    "    call $pion_rc_inc_n(l %a)",
  ]
  assert_eq(irc_block_has_inc(probe, 0, 1), true)
  assert_eq(irc_block_has_inc(probe, 1, 4), false)
  assert_eq(irc_block_has_inc(probe, 0, 0), false)
  // A function without any inc is returned untouched, decs included.
  let no_inc_src =
    #|@start
    #|    %a =l copy %x
    #|    call $pion_rc_dec(l %a)
    #|    call $pion_rc_dec(l %a)
    #|    jnz %c, @oob, @ok
    #|@oob
    #|    call $pion_panic(l 0)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %a)
    #|    ret %a
  let no_inc = irct_lines(no_inc_src)
  assert_eq(irct_same(irc_cancel_same_block_rc("function l $f(l %x, w %c) {", no_inc, 0), no_inc), true)
  // A window opened in @start passes the trap branch into @ok, which has no inc
  // of its own: its dec still cancels. @tail is reached by a plain jump, has
  // neither an incoming window nor an inc, so its dec stays.
  let pass_src =
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    jnz %c, @oob, @ok
    #|@oob
    #|    call $pion_panic(l 0)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %x)
    #|    jmp @tail
    #|@tail
    #|    call $pion_rc_dec(l %x)
    #|    ret %x
  let pass = irct_lines(pass_src)
  let got = irc_cancel_same_block_rc("function l $f(l %x, w %c) {", pass, 0)
  assert_eq(got.length(), pass.length() - 2)
  let mut joined = ""
  let mut gi = 0
  while gi < got.length() {
    joined = joined + got[gi] + "\n"
    gi = gi + 1
  }
  assert_eq(irct_count(joined, "call $pion_rc_inc"), 0)
  assert_eq(irct_count(joined, "call $pion_rc_dec(l %x)"), 1)
  assert_eq(joined.contains("@tail\n    call $pion_rc_dec(l %x)"), true)
  // Same CFG with trap penetration disabled (mask 8): nothing crosses blocks.
  let off = irc_cancel_same_block_rc("function l $f(l %x, w %c) {", pass, 8)
  assert_eq(irct_same(off, pass), true)
}

///|
fn irct_pair(s : String) -> Bool {
  irc_has_candidate_pair(irct_lines(s))
}

///|
test "irc_candidate_pair_is_ordered_and_per_tmp" {
  let hdr = "function l $f(l %x, l %y, w %c) {"
  // Only incs, only decs, different temporaries, and a lone dec before an inc:
  // no candidate, and the pass returns the function untouched.
  let no_pair = [
    "@start\n    call $pion_rc_inc(l %x)\n    ret %x",
    "@start\n    call $pion_rc_dec(l %x)\n    ret 0",
    "@start\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %y)\n    ret %x",
    "@start\n    call $pion_rc_dec(l %x)\n    call $pion_rc_inc(l %x)\n    ret %x",
    // `%x` is not a prefix match of `%x1`; comments and non-tmp args never count.
    "@start\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x1)\n    ret %x",
    "@start\n    # call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x)\n    ret 0",
    "@start\n    call $pion_rc_inc(l 0)\n    call $pion_rc_dec(l 0)\n    ret 0",
    "@start\n    call $pion_rc_inc(l $g)\n    call $pion_rc_dec(l $g)\n    ret 0",
    "",
  ]
  let mut i = 0
  while i < no_pair.length() {
    let lines = irct_lines(no_pair[i])
    assert_eq(irc_has_candidate_pair(lines), false)
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, lines, 0), lines), true)
    i = i + 1
  }
  // A legal pair, with blanks and comments around the calls, is found and cancelled.
  let legal = "@start\n\t  call $pion_rc_inc(l  %x ) # a\n    %n =l add %y, 1\n    call $pion_rc_dec(l %x) # b\n    ret %n"
  assert_eq(irct_pair(legal), true)
  let cancelled = irc_cancel_same_block_rc(hdr, irct_lines(legal), 0)
  assert_eq(irct_same(cancelled, irct_lines("@start\n    %n =l add %y, 1\n    ret %n")), true)
  // dec, inc, dec of one temporary: the trailing pair still counts.
  let trailing = "@start\n    call $pion_rc_dec(l %x)\n    call $pion_rc_inc(l %x)\n    call $pion_rc_dec(l %x)\n    ret 0"
  assert_eq(irct_pair(trailing), true)
  let kept_dec = irc_cancel_same_block_rc(hdr, irct_lines(trailing), 0)
  assert_eq(irct_same(kept_dec, irct_lines("@start\n    call $pion_rc_dec(l %x)\n    ret 0")), true)
}

///|
test "irc_candidate_pair_across_blocks" {
  let hdr = "function l $f(l %x, w %c) {"
  // inc and dec in different blocks joined by a plain jump: a candidate, but the
  // full checks keep both.
  let plain = irct_lines("@start\n    call $pion_rc_inc(l %x)\n    jmp @next\n@next\n    call $pion_rc_dec(l %x)\n    ret %x")
  assert_eq(irc_has_candidate_pair(plain), true)
  assert_eq(irct_same(irc_cancel_same_block_rc(hdr, plain, 0), plain), true)
  // Forward trap successor, either branch polarity: the window crosses and cancels.
  let forward = irct_lines("@start\n    call $pion_rc_inc(l %x)\n    jnz %c, @ok, @oob\n@oob\n    call $pion_panic(l 0)\n    hlt\n@ok\n    call $pion_rc_dec(l %x)\n    ret %x")
  assert_eq(irc_has_candidate_pair(forward), true)
  assert_eq(irc_cancel_same_block_rc(hdr, forward, 0).length(), forward.length() - 2)
  // The single-predecessor trap successor laid out BEFORE its branching block,
  // either polarity: windows never propagate backward, so skipping the function
  // because the dec comes first changes nothing.
  let jumps = ["jnz %c, @oob, @ok", "jnz %c, @ok, @oob"]
  let mut i = 0
  while i < jumps.length() {
    let dec_first = "@start\n    jmp @chk\n@ok\n    call $pion_rc_dec(l %x)\n    ret %x\n@chk\n    call $pion_rc_inc(l %x)\n    " + jumps[i] + "\n@oob\n    call $pion_panic(l 0)\n    hlt"
    let back = irct_lines(dec_first)
    assert_eq(irc_has_candidate_pair(back), false)
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, back, 0), back), true)
    // Force the full pass with an unrelated legal pair: still nothing crosses
    // backward, only that pair disappears.
    let forced = irct_lines(dec_first + "\n@un\n    call $pion_rc_inc(l %c)\n    call $pion_rc_dec(l %c)\n    ret 0")
    assert_eq(irc_has_candidate_pair(forced), true)
    let forced_want = irct_lines(dec_first + "\n@un\n    ret 0")
    assert_eq(irct_same(irc_cancel_same_block_rc(hdr, forced, 0), forced_want), true)
    i = i + 1
  }
}

///|
fn irct_ends(hdr : String, body : String) -> Array[Int] {
  irc_unique_lhs_ends(irct_lines(body), hdr)
}

///|
test "irc_unique_lhs_ends_accepts_canonical_names" {
  let hdr = "function l $f(l %x, w %c) {"
  // The end offset of every defined name, 0 elsewhere (labels, calls, `%` operands).
  let ok = irct_ends(hdr, "@start\n%t0 =l copy 0\n%t10 =w ceqw %c, 0\ncall $g(l %t0)\n%t123456789 =l copy %t0\nret %t0\n\n")
  let want = [0, 3, 4, 0, 11, 0, 0]
  assert_eq(ok.length(), want.length())
  let mut i = 0
  while i < want.length() {
    assert_eq(ok[i], want[i])
    i = i + 1
  }
  // No definition at all: trivially unique. No line at all: fallback.
  assert_eq(irct_ends(hdr, "@start\nret 0").length(), 2)
  assert_eq(irct_ends(hdr, "").length(), 0)
  // Shortest definition the census takes, and a `%t` in a header comment.
  assert_eq(irct_ends(hdr, "%t1 =").length(), 1)
  assert_eq(irct_ends(hdr + " # %t1", "%t1 =l copy 0").length(), 1)
}

///|
test "irc_unique_lhs_ends_falls_back" {
  let hdr = "function l $f(l %x, w %c) {"
  // A parameter named like a definition, or merely starting with `%t`.
  assert_eq(irct_ends("function l $f(l %t0) {", "%t0 =l copy 0\nret 0").length(), 0)
  assert_eq(irct_ends("function l $f(l %tag) {", "%t0 =l copy 0\nret 0").length(), 0)
  let bad = [
    // Repeated names, next to each other or far apart.
    "%t1 =l copy 0\n%t1 =l copy 1\nret 0",
    "%t1 =l copy 0\n@a\n%t2 =l copy 0\n@b\n%t1 =l copy 1",
    // Different names in one bucket: equal values, or equal modulo the line count.
    "%t01 =l copy 0\n%t1 =l copy 1\nret 0",
    "%t0 =l copy 0\n%t000000000 =l copy 1\nret 0",
    "%t1 =l copy 0\n%t4 =l copy 1\nret 0",
    // Ten digits.
    "%t1234567890 =l copy 0",
    "%t0000000001 =l copy 0",
    // Names of another shape.
    "%foo =l copy 0",
    "%t =l copy 0",
    "%tx1 =l copy 0",
    "%t1x =l copy 0",
    "%t1.2 =l copy 0",
    "%u1 =l copy 0",
    "%t1\u{4E2D} =l copy 0",
    "%\u{4E2D}1 =l copy 0",
    // Anything but exactly one blank before `=`.
    "%t1=l copy 0",
    "%t1  =l copy 0",
    "%t1\t=l copy 0",
    "%t1 \t=l copy 0",
    "%t1 l copy 0",
    "%t1 ",
    "%t1",
    "%t",
    "%",
    // One bad line spoils the function.
    "%t1 =l copy 0\n%t2 =l copy 0\n%v =l copy 0",
  ]
  let mut i = 0
  while i < bad.length() {
    assert_eq(irct_ends(hdr, bad[i]).length(), 0)
    i = i + 1
  }
}

///|
test "irc_may_define_safe_opcodes" {
  let yes = [
    "%t1 =l alloc4 4",
    "%t1 =l alloc8 8",
    "%t1 =l alloc16 16",
    "%t1 =l copy %x",
    "%t1 =l add %x, 24",
    "%foo =l add %x, 24",
    "%t1 =l  \t copy %x",
    "%\u{4E2D} =l copy %x",
    // Conservative: a shared prefix or a non-ASCII opcode byte goes to the parser.
    "%t1 =l alloc32 32",
    "%t1 =l addx %x, 1",
    "%t1 =l \u{4E2D}",
    "%t1 =l a\u{4E2D}",
    "%t1 =l c\u{4E2D}",
  ]
  let no = [
    "%t1 =w copy %x",
    "%t1 =w add %x, 1",
    "%t1 =d copy %x",
    "%t1 =l loadl %x",
    "%t1 =l phi @a %x, @b %y",
    "%t1 =l and %x, 7",
    "%t1 =l sub %x, 24",
    "%t1 =l extsw %x",
    "%t1 =l cugel %x, %y",
    "%t1 =l call $f(l %x)",
    "%t1 =l a",
    "%t1 =l c",
    "%t1 =l ",
    "%t1 =l",
    "%t1=l copy %x",
    "%t1\t=l copy %x",
    "%t1  =l copy %x",
    "%t1",
    "%",
  ]
  let mut i = 0
  while i < yes.length() {
    assert_eq(irc_may_define_safe(yes[i]), true)
    i = i + 1
  }
  i = 0
  while i < no.length() {
    assert_eq(irc_may_define_safe(no[i]), false)
    i = i + 1
  }
  // The tables the prefilter guards are complete.
  let lines = irct_lines(
    "@start\n    call $pion_rc_inc(l %x)\n    %a4 =l alloc4 4\n    %a8 =l alloc8 8\n    %a16 =l alloc16 16 # c\n    %c =l copy %x\n    %d =l add %c, 24\n    %e =l  add %x, 16\n    %o =l add %x, 8\n    %w =w copy %x\n    %s =l sub %x, 24\n    %l =l loadl %d\n    ret 0",
  )
  let info = irc_collect_safe_load_info("function l $f(l %x) {", lines)
  let safe = ["%x", "%a4", "%a8", "%a16", "%c", "%d", "%e", "%o"]
  i = 0
  while i < safe.length() {
    assert_eq(info.safe_addrs.contains(safe[i]), true)
    i = i + 1
  }
  assert_eq(info.safe_addrs.length(), safe.length())
  assert_eq(info.valid_rc_objs.length(), 2)
  assert_eq(info.dp_addr_of.length(), 2)
  assert_eq(info.dp_addr_of.get("%d").unwrap_or(""), "%c|2")
  assert_eq(info.dp_addr_of.get("%e").unwrap_or(""), "%x|1")
}

///|
test "irc_line_has_phi_prefilter" {
  let yes = [
    "    %t1 =l phi @a %x, @b 0",
    "%t1 =w phi @a 1, @b 0 # phi",
    "\t%phi =d  phi @a d_0, @b d_1",
    "%t1 =:pt phi @a %x, @b %y",
    "%t1=l phi@a %x",
  ]
  let no = [
    "    %phi =l copy %x",
    "    %t1 =l copy %phi",
    "    %t1 =l call $phi(l %x)",
    "    %t1 =l phix %x",
    "    %t1 =l copy %x # %t2 =l phi @a 0",
    "    # %t1 =l phi @a %x, @b 0",
    "    call $\"x =l phi @a\"(l %x)",
    "    data $\"=l phi\" = { b \"=l phi @a 0\" }",
    "    %t1 =l add %x, 1",
    "    jmp @phi",
    "ph",
    "",
  ]
  let mut i = 0
  while i < yes.length() {
    assert_eq(irc_line_has_phi(yes[i]), true)
    i = i + 1
  }
  i = 0
  while i < no.length() {
    assert_eq(irc_line_has_phi(no[i]), false)
    i = i + 1
  }
}

///|
fn irct_code(body : String) -> Array[String] {
  let out : Array[String] = []
  let raw = irct_lines(body)
  let mut i = 0
  while i < raw.length() {
    out.push(irc_strip_comment(raw[i]))
    i = i + 1
  }
  out
}

///|
test "irc_census_and_map_paths_agree" {
  let body =
    #|@start
    #|    %t1 =l alloc8 8
    #|    storel 0, %t1
    #|    %t2 =l alloc8 8
    #|    storel 0, %t2
    #|    %t3 =l alloc8 8
    #|    storel 0, %t3
    #|    call $use(l %t3)
    #|    %t4 =l add $pion_str_0_hdr, 24
    #|    %t5 =l copy %t4
    #|    call $pion_rc_inc(l %t5)
    #|    call $pion_rc_inc(l %x)
    #|    %t6 =l add %x, 24
    #|    %t7 =l loadl %t6
    #|    call $pion_rc_dec(l %x)
    #|    jnz %c, @a, @b
    #|@a
    #|    storel %t4, %t1
    #|    storel %x, %t2
    #|    %t8 =l loadl %t2
    #|    call $pion_rc_dec(l %t8)
    #|    storel 0, %t2
    #|    %t9 =l  loadl %t2 # two blanks
    #|    call $pion_rc_dec(l %t9)
    #|    jmp @b
    #|@b
    #|    %t10 =l phi @start 0, @a %t4
    #|    %t11 =l phi @start 0, @a %x
    #|    call $pion_rc_dec(l %t10)
    #|    call $pion_rc_dec(l %t11)
    #|    %t12 =l loadl %t1
    #|    call $pion_rc_dec(l %t12)
    #|    %t13 =l loadl %t2
    #|    call $pion_rc_dec(l %t13)
    #|    %t14 =l loadl %t3
    #|    call $pion_rc_dec(l %t14)
    #|    %t15 =w loadw %t1
    #|    ret 0
  let hdr = "export function l $f(l %x, w %c) {"
  let code = irct_code(body)
  let mut i = 0
  assert_eq(irc_unique_lhs_ends(code, hdr).length(), code.length())
  let ssa = hdr + "\n" + body + "\n}\n"
  // Renaming all temporaries, or a parameter, moves the function to the Map path.
  let prefixes = ["%foo", "%v.", "%t0123456789"]
  let masks = [0, 4, 8, 12]
  let mut k = 0
  while k < masks.length() {
    let fast_c = cleanup_native_rc_ssa_opts(ssa, masks[k])
    let fast_i = inline_native_rc_ssa_opts(ssa, masks[k])
    let mut p = 0
    while p < prefixes.length() {
      let renamed = ssa.replace("%t", prefixes[p])
      assert_eq(irc_unique_lhs_ends(irct_code(body.replace("%t", prefixes[p])), hdr).length(), 0)
      assert_eq(cleanup_native_rc_ssa_opts(renamed, masks[k]), fast_c.replace("%t", prefixes[p]))
      assert_eq(inline_native_rc_ssa_opts(renamed, masks[k]), fast_i.replace("%t", prefixes[p]))
      p = p + 1
    }
    let par = ssa.replace("%x", "%tx")
    assert_eq(irc_unique_lhs_ends(code, "export function l $f(l %tx, w %c) {").length(), 0)
    assert_eq(cleanup_native_rc_ssa_opts(par, masks[k]), fast_c.replace("%x", "%tx"))
    assert_eq(inline_native_rc_ssa_opts(par, masks[k]), fast_i.replace("%x", "%tx"))
    k = k + 1
  }
  // The proven calls are gone, the unproven ones stay.
  let out = cleanup_native_rc_ssa(ssa)
  let gone = ["(l %t5)", "(l %t9)", "(l %t10)"]
  let kept = ["rc_dec(l %t8)", "rc_dec(l %t11)", "rc_dec(l %t12)", "rc_dec(l %t13)", "rc_dec(l %t14)"]
  i = 0
  while i < gone.length() {
    assert_eq(out.contains(gone[i]), false)
    i = i + 1
  }
  i = 0
  while i < kept.length() {
    assert_eq(out.contains(kept[i]), true)
    i = i + 1
  }
  // Without the narrow read `%t1` is private and its cross-block load is proven.
  let private_ssa = ssa.replace("    %t15 =w loadw %t1\n", "")
  assert_eq(cleanup_native_rc_ssa(private_ssa).contains("(l %t12)"), false)
}

///|
test "irc_census_fallback_keeps_multi_defs_unproven" {
  // The same shapes on canonical `%tN` names: a second definition or a shadowed
  // parameter proves nothing, with or without a colliding spelling next to it.
  let lines = [
    "export function l $f(l %x) {\n@start\n    %t1 =l copy 0\n    %t1 =l copy %x\n    call $pion_rc_dec(l %t1)\n    ret 0\n}\n",
    "export function l $f(l %t1) {\n@start\n    %t1 =l copy 0\n    call $pion_rc_dec(l %t1)\n    ret 0\n}\n",
    "export function l $f(l %x) {\n@start\n    %t01 =l copy 0\n    %t1 =l copy 0\n    %t1 =l copy %x\n    call $pion_rc_dec(l %t1)\n    ret 0\n}\n",
    "export function l $f(l %x) {\n@start\n    %t1 =l alloc8 8\n    %t1 =l alloc8 8\n    storel 0, %t1\n    %t2 =l loadl %t1\n    call $pion_rc_dec(l %t2)\n    ret 0\n}\n",
  ]
  let mut i = 0
  while i < lines.length() {
    assert_eq(cleanup_native_rc_ssa(lines[i]), lines[i])
    i = i + 1
  }
  // A collision of distinct names falls back without losing the proof.
  let coll = "export function l $f(l %x) {\n@start\n    %t01 =l copy 0\n    %t1 =l copy %t01\n    call $pion_rc_dec(l %t1)\n    ret 0\n}\n"
  assert_eq(cleanup_native_rc_ssa(coll).contains("rc_dec"), false)
}

///|
test "irc_trim_slice_cases" {
  // Empty and reversed ranges.
  assert_eq(irc_trim_slice("", 0, 0), "")
  assert_eq(irc_trim_slice("abc", 0, 0), "")
  assert_eq(irc_trim_slice("abc", 3, 3), "")
  assert_eq(irc_trim_slice("abc", 2, 1), "")
  assert_eq(irc_trim_slice("abc", 20, 2), "")
  // Blank ranges: only space, tab and CR are trimmed.
  assert_eq(irc_trim_slice(" \t\r ", 0, 4), "")
  assert_eq(irc_trim_slice("a \t\r b", 1, 5), "")
  assert_eq(irc_trim_slice(" \n ", 0, 3), "\n")
  // The whole string, kept or trimmed.
  assert_eq(irc_trim_slice("%t1", 0, 3), "%t1")
  assert_eq(irc_trim_slice("a b", 0, 3), "a b")
  assert_eq(irc_trim_slice("  %t1\t\r", 0, 7), "%t1")
  // ASCII operands inside a line; DEL is the last ASCII byte.
  let line = "    %t1 =l add  %x , 24 # tail"
  assert_eq(irc_trim_slice(line, 14, 19), "%x")
  assert_eq(irc_trim_slice(line, 20, 24), "24")
  assert_eq(irc_trim_slice(line, 16, 18), "%x")
  assert_eq(irc_trim_slice("ab\u{4E2D}cd", 0, 2), "ab")
  assert_eq(irc_trim_slice(" \u{7F} ", 0, 3), "\u{7F}")
  // Multi-byte scalars take the decoding path.
  let wide = " \t%\u{4E2D}\u{E9}\u{1F600} \r"
  assert_eq(irc_trim_slice(wide, 0, wide.length()), "%\u{4E2D}\u{E9}\u{1F600}")
  assert_eq(irc_trim_slice("\u{80}", 0, "\u{80}".length()), "\u{80}")
  // Unicode spaces are not blanks here.
  let nbsp = " \u{A0} \u{3000} "
  assert_eq(irc_trim_slice(nbsp, 0, nbsp.length()), "\u{A0} \u{3000}")
}

///|
test "irc_trim_slice_matches_slice_then_trim" {
  let srcs = [
    "",
    "   ",
    " \t\r",
    "%t1",
    "  a\tb \r",
    "x , y,\t24 ",
    " \u{4E2D} ",
    "a\u{E9} b\u{4E2D}\t",
    "\u{1F600} x \u{80}\r",
    "\tq\n\u{A0} ",
  ]
  let mut k = 0
  while k < srcs.length() {
    let s = srcs[k]
    let n = s.length()
    let mut lo = 0
    while lo <= n {
      let mut hi = 0
      while hi <= n {
        assert_eq(irc_trim_slice(s, lo, hi), irc_trim(irc_slice(s, lo, hi)))
        hi = hi + 1
      }
      lo = lo + 1
    }
    k = k + 1
  }
}

///|
fn irct_join(lines : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    sb.write_string("[")
    sb.write_string(lines[i])
    sb.write_string("]")
    i = i + 1
  }
  sb.to_string()
}

///|
fn irct_split(s : String) -> String {
  irct_join(irc_split_lines_range(s, 0, s.length()))
}

///|
test "irc_split_lines_range_cases" {
  // ASCII lines; a final newline does not add an empty line.
  assert_eq(irct_split(""), "")
  assert_eq(irct_split("\n"), "[]")
  assert_eq(irct_split("a"), "[a]")
  assert_eq(irct_split("a\n"), "[a]")
  assert_eq(irct_split("@start\n    ret 0"), "[@start][    ret 0]")
  assert_eq(irct_split("@start\n    ret 0\n"), "[@start][    ret 0]")
  assert_eq(irct_split("a\n\n\r\nb\n\n"), "[a][][\r][b][]")
  // Lines with multi-byte scalars.
  assert_eq(irct_split("\u{4E2D}"), "[\u{4E2D}]")
  assert_eq(irct_split("\u{4E2D}\u{E9}\n\u{1F600}\n"), "[\u{4E2D}\u{E9}][\u{1F600}]")
  // The flag restarts on every line.
  assert_eq(
    irct_split("ascii\nx\u{4E2D}y\nascii2\n\n\u{E9}\ntail"),
    "[ascii][x\u{4E2D}y][ascii2][][\u{E9}][tail]",
  )
  assert_eq(irct_split("\u{E9}\na\n\u{4E2D}"), "[\u{E9}][a][\u{4E2D}]")
}

///|
test "irc_split_lines_range_subranges" {
  let s = "ab\n\u{4E2D}c\n\nd\u{E9}\u{1F600}\nef\n"
  let n = s.length()
  let mut lo = 0
  while lo <= n {
    let mut hi = lo
    while hi <= n {
      let want : Array[String] = []
      let mut cur = lo
      let mut i = lo
      while i < hi {
        if str_code_at(s, i) == 10 {
          want.push(irc_slice(s, cur, i))
          cur = i + 1
        }
        i = i + 1
      }
      if cur < hi {
        want.push(irc_slice(s, cur, hi))
      }
      let got = irc_split_lines_range(s, lo, hi)
      assert_eq(got.length(), want.length())
      assert_eq(irct_join(got), irct_join(want))
      hi = hi + 1
    }
    lo = lo + 1
  }
}

///|
fn irct_ascii(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) >= 128 {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "z1_irc_body_lines_matches_split_lines_range" {
  // ASCII bodies take the batch `split("\n")` path, others the byte scanner;
  // both must give the lines of `irc_split_lines_range`.
  let cases : Array[String] = [
    "", "\n", "\n\n", "a", "a\n", "a\n\n\r\nb\n\n", "@start\n    ret 0",
    "@start\n    ret 0\n", "    call $f()\n@b\n", "x\u{4E2D}y\nascii\n",
    "\u{E9}\n\n", "a\n\u{1F600}",
  ]
  let mut k = 0
  while k < cases.length() {
    let s = cases[k]
    let got = irc_body_lines(s, 0, s.length(), s, irct_ascii(s))
    assert_eq(irct_join(got), irct_split(s))
    assert_eq(got.length(), irc_split_lines_range(s, 0, s.length()).length())
    k = k + 1
  }
}

///|
test "z1_irc_body_has_call_cases" {
  assert_eq(irc_body_has_call(""), false)
  assert_eq(irc_body_has_call("    call $f()\n"), true)
  assert_eq(irc_body_has_call("call\n"), true)
  // A bare `call` at the very end of the body has no separator: not a call
  // (as in the old scanner, which needed one more byte).
  assert_eq(irc_body_has_call("    %x =l copy 0\ncall"), false)
  // Identifier suffixes (letters, digits, `_`, `.`, `$`) are not calls.
  assert_eq(irc_body_has_call("    %callfoo =l copy 1\n    %call_ =l copy 2\n"), false)
  assert_eq(irc_body_has_call("    %call9 =l copy %call.x\n    %call$ =l copy 0\n"), false)
  // The first `call` literal is an identifier, a later one is a real call.
  assert_eq(irc_body_has_call("    %callx =l copy 1\n    call $g(l %callx)\n"), true)
  // Only the suffix is checked (as in the old scanner): `%xcall ` matches.
  assert_eq(irc_body_has_call("    %xcall =l copy 1\n"), true)
  assert_eq(irc_body_has_call("    %v =l copy \"\u{4E2D}\"\n    call $h()\n"), true)
}

///|
fn irct_swap(s : String, from : String, to : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < s.length() {
    if i + from.length() <= s.length() &&
      slice_str(s, i, i + from.length()) == from {
      sb.write_string(to)
      i = i + from.length()
    } else {
      sb.write_string(slice_str(s, i, i + 1))
      i = i + 1
    }
  }
  sb.to_string()
}

///|
test "z1_irc_non_ascii_body_matches_ascii_body" {
  // A function body with a non-ASCII byte takes the `irc_split_lines_range`
  // fallback; apart from that byte sequence it must be processed exactly like
  // the same body with an ASCII placeholder, in dev cleanup and release inlining.
  let ssa =
    #|export function l $f(l %x, w %c) {
    #|@start
    #|    # MARK
    #|    %z =l copy 0
    #|    call $pion_rc_dec(l 0)
    #|    %s =l call $pion_str_concat(l %x, l %x)
    #|    jnz %c, @a, @b
    #|@a
    #|    call $pion_rc_inc(l %s)
    #|    call $pion_rc_dec(l %s)
    #|    jmp @b
    #|@b
    #|    ret %s
    #|}
    #|function w $g(w %a) {
    #|@start
    #|    # MARK
    #|    %r =w call $h(w %a)
    #|    ret %r
    #|}
  let ascii = irct_swap(ssa, "MARK", "zz")
  let wide = irct_swap(ssa, "MARK", "\u{4E2D}\u{E9}")
  assert_eq(irct_ascii(ascii), true)
  assert_eq(irct_ascii(wide), false)
  assert_eq(irct_swap(cleanup_native_rc_ssa(wide), "\u{4E2D}\u{E9}", "zz"), cleanup_native_rc_ssa(ascii))
  assert_eq(irct_swap(inline_native_rc_ssa(wide), "\u{4E2D}\u{E9}", "zz"), inline_native_rc_ssa(ascii))
  assert_eq(cleanup_native_rc_ssa(ascii).contains("rc_dec(l 0)"), false)
}
