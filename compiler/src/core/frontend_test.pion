test "p30a_float_literal_context_and_double_var_rejected" {
  let ok_src =
    #|struct BoxF {
    #|  v : Float
    #|}
    #|fn take_f(x : Float) -> Float {
    #|  x
    #|}
    #|pub fn f() -> Float {
    #|  let a : Float = 1.0
    #|  let b : Float = -2.5
    #|  let c = take_f(3.0)
    #|  let d = BoxF::{ v: 4.0 }
    #|  a + b + c + d.v
    #|}
  let (ok1, json1, _) = check_one(ok_src)
  assert_true(ok1, json1)

  let bad_src =
    #|fn take_f(x : Float) -> Float {
    #|  x
    #|}
    #|pub fn f(d : Double) -> Float {
    #|  let a : Float = d
    #|  take_f(d) + a
    #|}
  let (ok2, json2, diags2) = check_one(bad_src)
  assert_true(!ok2 && diags2.length() >= 2 && diags2[0].code == "E_TYPE_MISMATCH", json2)
}

///|
test "p30a_unicode_escape_lexing" {
  let lr = lex("test.pion", "\"\\u{0C}\" \"\\u{4E2D}\" \"\\u{1F600}\" '\\u{0C}'")
  assert_true(lr.diagnostics.length() == 0, check_result_to_json(lr.diagnostics))
  match lr.tokens[0].kind {
    StringLit(s) => assert_true(s.length() == 1 && str_code_at(s, 0) == 12, "u0C")
    _ => assert_true(false, "expected StringLit 0")
  }
  match lr.tokens[1].kind {
    StringLit(s) => assert_true(s == "中", "u4E2D")
    _ => assert_true(false, "expected StringLit 1")
  }
  match lr.tokens[2].kind {
    StringLit(s) => assert_true(s == "😀", "u1F600")
    _ => assert_true(false, "expected StringLit 2")
  }
  match lr.tokens[3].kind {
    CharLit(s) => assert_true(s == "\\u{0C}", "char u0C")
    _ => assert_true(false, "expected CharLit 3")
  }

  let bad1 = lex("bad1.pion", "\"\\u{}\"")
  assert_true(bad1.diagnostics.length() == 1 && bad1.diagnostics[0].code == "E_PARSE", "empty u")
  let bad2 = lex("bad2.pion", "\"\\u{110000}\"")
  assert_true(bad2.diagnostics.length() == 1 && bad2.diagnostics[0].code == "E_PARSE", "oob u")
  let bad3 = lex("bad3.pion", "\"\\u{D800}\"")
  assert_true(bad3.diagnostics.length() == 1 && bad3.diagnostics[0].code == "E_PARSE", "surrogate u")
  let bad4 = lex("bad4.pion", "\"\\u0041\"")
  assert_true(bad4.diagnostics.length() == 1 && bad4.diagnostics[0].code == "E_PARSE", "missing brace u")
}

