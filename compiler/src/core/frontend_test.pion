///|
test "p30c_bug16a_generic_higher_order_closure_infer" {
  let src =
    #|trait ViewEq {
    #|  fn veq(self : Self, other : Self) -> Bool
    #|}
    #|impl ViewEq for Bool {
    #|  fn veq(self : Bool, other : Bool) -> Bool {
    #|    self == other
    #|  }
    #|}
    #|enum HoldRead {
    #|  Stay
    #|  Go(Int)
    #|}
    #|impl ViewEq for HoldRead {
    #|  fn veq(self : HoldRead, other : HoldRead) -> Bool {
    #|    match self {
    #|      Stay =>
    #|        match other {
    #|          Stay => true
    #|          Go(_) => false
    #|        }
    #|      Go(a) =>
    #|        match other {
    #|          Stay => false
    #|          Go(b) => a == b
    #|        }
    #|    }
    #|  }
    #|}
    #|struct View {
    #|  flag : Bool
    #|}
    #|fn View::leaving(self : View) -> Bool {
    #|  self.flag
    #|}
    #|fn View::reacts[T : ViewEq](self : View, read : () -> T, f : (T) -> Unit) -> Unit {
    #|  let v = read()
    #|  if v.veq(v) {
    #|    f(v)
    #|  }
    #|}
    #|fn View::reacts_any[T](self : View, read : () -> T, f : (T) -> Unit) -> Unit {
    #|  let v = read()
    #|  f(v)
    #|}
    #|fn my_map[T, U](xs : Array[T], f : (T) -> U) -> Array[U] {
    #|  let out : Array[U] = []
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    out.push(f(xs[i]))
    #|    i += 1
    #|  }
    #|  out
    #|}
    #|fn outer[T](v : View, x : T, sink : (T) -> Unit) -> Unit {
    #|  v.reacts_any(fn() { x }, fn(y) { sink(y) })
    #|}
    #|struct Acc {
    #|  mut v : Int
    #|}
    #|pub fn run_all(v : View) -> Int {
    #|  let acc = Acc::{ v: 0 }
    #|  v.reacts(fn() { v.leaving() }, fn(leaving) {
    #|    if leaving {
    #|      acc.v += 1
    #|    }
    #|  })
    #|  v.reacts(fn() {
    #|    if v.leaving() {
    #|      return HoldRead::Stay
    #|    }
    #|    HoldRead::Go(7)
    #|  }, fn(h) {
    #|    match h {
    #|      Stay => acc.v += 2
    #|      Go(n) => acc.v += n
    #|    }
    #|  })
    #|  v.reacts(fn() {
    #|    if v.leaving() {
    #|      return HoldRead::Stay
    #|    } else {
    #|      return HoldRead::Go(9)
    #|    }
    #|  }, fn(h) {
    #|    match h {
    #|      Stay => acc.v += 3
    #|      Go(n) => acc.v += n
    #|    }
    #|  })
    #|  v.reacts_any(fn() { (Some(4), 5) }, fn(pair) {
    #|    let (opt, n) = pair
    #|    match opt {
    #|      Some(k) => acc.v += k + n
    #|      None => ()
    #|    }
    #|  })
    #|  let flags = my_map(my_map([1, 2, 3], fn(x) { x + 1 }), fn(y) { y > 2 })
    #|  if flags[1] {
    #|    acc.v += 10
    #|  }
    #|  outer(v, 42, fn(n) { acc.v += n })
    #|  acc.v
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, json)
}

///|
test "p30c_bug16b_struct_method_own_tparam_not_receiver_targs" {
  let src =
    #|struct Sight[T] {
    #|  item : T
    #|}
    #|struct ListKeys[K] {
    #|  keys : Array[K]
    #|}
    #|struct SliceIds {
    #|  off : Int
    #|}
    #|fn Sight::keyed[K](self : Sight[Int], ids : ListKeys[K], sl : SliceIds) -> Sight[K] {
    #|  let idx = self.item + sl.off
    #|  Sight::{ item: ids.keys[idx] }
    #|}
    #|struct ListPlace[K] {
    #|  ids : ListKeys[K]
    #|}
    #|fn apply_sight[K](s : Sight[Int], f : (Sight[Int]) -> Sight[K]) -> Sight[K] {
    #|  f(s)
    #|}
    #|fn ListPlace::on_sight[K](self : ListPlace[K], s : Sight[Int], sl : SliceIds) -> Sight[K] {
    #|  let ids = self.ids
    #|  apply_sight(s, fn(cur) { cur.keyed(ids, sl) })
    #|}
    #|pub fn test_keyed() -> String {
    #|  let lp = ListPlace::{ ids: ListKeys::{ keys: ["a", "b", "c"] } }
    #|  let s = Sight::{ item: 1 }
    #|  let res = lp.on_sight(s, SliceIds::{ off: 1 })
    #|  res.item
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, json)
}

///|
test "p30c_bug17_unannotated_none_binding_infer_and_missing_err" {
  let ok_src =
    #|fn find_int(xs : Array[Int], target : Int) -> Option[Int] {
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    if xs[i] == target {
    #|      return Some(i)
    #|    }
    #|    i += 1
    #|  }
    #|  None
    #|}
    #|fn take_opt_str(x : Option[String]) -> Int {
    #|  match x {
    #|    Some(s) => s.length()
    #|    None => 0
    #|  }
    #|}
    #|pub fn f(xs : Array[Int]) -> Int {
    #|  let mut before = None
    #|  let mut p = xs.length() - 1
    #|  while p >= 0 && before.is_none() {
    #|    before = find_int(xs, xs[p])
    #|    p = p - 1
    #|  }
    #|  let a = match before {
    #|    Some(i) => i + 1
    #|    None => 0
    #|  }
    #|  let empty_s = None
    #|  a + take_opt_str(empty_s)
    #|}
  let (ok1, json1, _) = check_one(ok_src)
  assert_true(ok1, json1)

  let bad_src =
    #|pub fn g() -> Int {
    #|  let x = None
    #|  if x.is_none() { 1 } else { 0 }
    #|}
  let (ok2, json2, diags2) = check_one(bad_src)
  assert_true(!ok2 && diags2.length() >= 1 && diags2[0].code == "E_MISSING_TYPE", json2)
}

///|
test "p30c_bug19_cross_pkg_default_args_and_arith_type_guard" {
  let pkg_a_src =
    #|pub fn base_val() -> Double {
    #|  12.5
    #|}
  let cr_a = check_source_files_with_imports("pkgA", ["lib.pion"], [pkg_a_src], [], true)
  assert_true(cr_a.diagnostics.length() == 0, check_result_to_json(cr_a.diagnostics))

  let pkg_b_src =
    #|import "pkgA"
    #|pub enum Side {
    #|  Top
    #|  Bottom
    #|}
    #|pub enum Pivot {
    #|  Center
    #|  At(Double, Double)
    #|}
    #|pub enum Along {
    #|  Start
    #|  Middle
    #|  End
    #|}
    #|let flag_a : Int = 1
    #|let flag_b : Int = 4
    #|pub struct Widget {
    #|  pub id : Int
    #|}
    #|pub fn make_val(
    #|  side~ : Side = Bottom,
    #|  about~ : Pivot = At(0.5, 0.5),
    #|  along~ : Along = Along::Middle,
    #|  mask~ : Int = flag_a | flag_b,
    #|  bound~ : () -> Double = fn() { pkgA::base_val() },
    #|) -> Double {
    #|  let s = match side { Top => 1.0; Bottom => 2.0 }
    #|  let p = match about { Center => 0.0; At(x, y) => x + y }
    #|  let a = match along { Start => 10.0; Middle => 20.0; End => 30.0 }
    #|  s + p + a + mask.to_double() + bound()
    #|}
    #|pub fn Widget::score(
    #|  self : Widget,
    #|  side~ : Side = Bottom,
    #|  about~ : Pivot = At(0.5, 0.5),
    #|  along~ : Along = Along::Middle,
    #|  mask~ : Int = flag_a | flag_b,
    #|  bound~ : () -> Double = fn() { pkgA::base_val() },
    #|) -> Double {
    #|  self.id.to_double() + make_val(side=side, about=about, along=along, mask=mask, bound=bound)
    #|}
  let cr_b = check_source_files_with_imports(
    "pkgB",
    ["lib.pion"],
    [pkg_b_src],
    [imported_pkg_new("pkgA", cr_a.tc)],
    true,
  )
  assert_true(cr_b.diagnostics.length() == 0, check_result_to_json(cr_b.diagnostics))

  // pkgC imports pkgB as alias `b`, and does NOT directly import pkgA
  let pkg_c_src =
    #|import "pkgB" as b
    #|pub fn run() -> Double {
    #|  let w = b::Widget::{ id: 3 }
    #|  b::make_val() + w.score()
    #|}
  let cr_c = check_source_files_with_imports(
    "pkgC",
    ["main.pion"],
    [pkg_c_src],
    [imported_pkg_new("pkgB", cr_b.tc)],
    true,
  )
  assert_true(cr_c.diagnostics.length() == 0, check_result_to_json(cr_c.diagnostics))

  // Arithmetic operator type guard: Array + Array, Struct + Struct, Bool + Bool rejected
  let bad_arr =
    #|pub fn f(a : Array[Int], b : Array[Int]) -> Array[Int] {
    #|  a + b
    #|}
  let (ok_a, json_a, diags_a) = check_one(bad_arr)
  assert_true(!ok_a && diags_a.length() >= 1 && diags_a[0].code == "E_TYPE_MISMATCH", json_a)

  let bad_bool =
    #|pub fn f(a : Bool, b : Bool) -> Bool {
    #|  a + b
    #|}
  let (ok_b, json_b, diags_b) = check_one(bad_bool)
  assert_true(!ok_b && diags_b.length() >= 1 && diags_b[0].code == "E_TYPE_MISMATCH", json_b)

  let bad_str_sub =
    #|pub fn f(a : String, b : String) -> String {
    #|  a - b
    #|}
  let (ok_s, json_s, diags_s) = check_one(bad_str_sub)
  assert_true(!ok_s && diags_s.length() >= 1 && diags_s[0].code == "E_TYPE_MISMATCH", json_s)

  let bad_bit =
    #|pub fn f(a : Double, b : Double) -> Double {
    #|  a | b
    #|}
  let (ok_f, json_f, diags_f) = check_one(bad_bit)
  assert_true(!ok_f && diags_f.length() >= 1 && diags_f[0].code == "E_TYPE_MISMATCH", json_f)
}

///|
test "p30c_bug20_diamond_dag_no_double_prefix_and_o1_transitive" {
  // 4-package diamond: pkgD -> {pkgB, pkgC} -> pkgA (pkgD does NOT directly import pkgA;
  // pkgC imports pkgB (which imports pkgA) without directly importing pkgA either)
  let pkg_a_src =
    #|pub struct Node {
    #|  pub v : Int
    #|}
    #|pub fn Node::get(self : Node, bias~ : Int = 1) -> Int {
    #|  self.v + bias
    #|}
    #|pub fn mk_node(v : Int) -> Node {
    #|  Node::{ v: v }
    #|}
  let cr_a = check_source_files_with_imports("pkgA", ["lib.pion"], [pkg_a_src], [], true)
  assert_true(cr_a.diagnostics.length() == 0, check_result_to_json(cr_a.diagnostics))

  let pkg_b_src =
    #|import "pkgA"
    #|pub fn wrap_b(v : Int) -> pkgA::Node {
    #|  pkgA::mk_node(v + 10)
    #|}
  let cr_b = check_source_files_with_imports(
    "pkgB",
    ["lib.pion"],
    [pkg_b_src],
    [imported_pkg_new("pkgA", cr_a.tc)],
    true,
  )
  assert_true(cr_b.diagnostics.length() == 0, check_result_to_json(cr_b.diagnostics))

  // pkgC imports pkgB ONLY (not pkgA): exercises Bug #20a where pkgB.tc.methods
  // holds `pkgA::Node::get` and pkgC does not have `pkgA` in `imported_pkgs`.
  let pkg_c_src =
    #|import "pkgB"
    #|pub fn wrap_c(v : Int) -> Int {
    #|  let n = pkgB::wrap_b(v)
    #|  n.get()
    #|}
  let cr_c = check_source_files_with_imports(
    "pkgC",
    ["lib.pion"],
    [pkg_c_src],
    [imported_pkg_new("pkgB", cr_b.tc)],
    true,
  )
  assert_true(cr_c.diagnostics.length() == 0, check_result_to_json(cr_c.diagnostics))

  // pkgD imports both pkgB and pkgC (diamond), does NOT directly import pkgA
  let pkg_d_src =
    #|import "pkgB"
    #|import "pkgC"
    #|pub fn run_d() -> Int {
    #|  let n = pkgB::wrap_b(5)
    #|  n.get() + pkgC::wrap_c(3)
    #|}
  let cr_d = check_source_files_with_imports(
    "pkgD",
    ["main.pion"],
    [pkg_d_src],
    [imported_pkg_new("pkgB", cr_b.tc), imported_pkg_new("pkgC", cr_c.tc)],
    true,
  )
  assert_true(cr_d.diagnostics.length() == 0, check_result_to_json(cr_d.diagnostics))

  // Bug #20a: no double-prefixed method keys in pkgC or pkgD
  assert_true(cr_d.tc.methods.contains("pkgA::Node::get"), "pkgA::Node::get present")
  assert_true(!cr_c.tc.methods.contains("pkgB::pkgA::Node::get"), "no pkgB::pkgA double prefix in pkgC")
  assert_true(!cr_d.tc.methods.contains("pkgB::pkgA::Node::get"), "no pkgB::pkgA double prefix in pkgD")
  assert_true(!cr_d.tc.methods.contains("pkgC::pkgA::Node::get"), "no pkgC::pkgA double prefix in pkgD")

  // Bug #20b: O(1) transitive lookup finds pkgA via all_imported_pkgs, while direct import_aliases stays isolated
  match lookup_imported_pkg_transitive(cr_d.tc, "pkgA") {
    Some(p) => assert_true(p.name == "pkgA", "transitive hit pkgA")
    None => assert_true(false, "expected transitive hit for pkgA")
  }
  match resolve_alias_pkg(cr_d.tc, "pkgA") {
    Some(_) => assert_true(false, "pkgA must NOT be in pkgD direct import_aliases")
    None => ()
  }
}

///|
test "p30c_bug21_recursive_derive_eq_no_blowup_and_bad_sibling_rejected" {
  // Test A: recursive #derive(Eq) enum with 4 self-edges must not blow up O(4^16)
  let ok_src =
    #|#derive(Eq)
    #|enum E {
    #|  A(E, E)
    #|  B(E, E)
    #|  Leaf(Int)
    #|}
    #|pub fn main() -> Unit {
    #|  let x = E::Leaf(1)
    #|  let _ = x == x
    #|}
  let (ok1, json1, _) = check_one(ok_src)
  assert_true(ok1, json1)

  // Test B: recursive #derive(Eq) enum with a non-Eq sibling variant must still be rejected
  let bad_src =
    #|struct NoEq {
    #|  x : Int
    #|}
    #|#derive(Eq)
    #|enum BadRec {
    #|  Node(BadRec, BadRec)
    #|  Bad(NoEq)
    #|}
    #|pub fn main() -> Unit {
    #|  let a = BadRec::Bad(NoEq::{ x: 1 })
    #|  let _ = a == a
    #|}
  let (ok2, json2, diags2) = check_one(bad_src)
  assert_true(!ok2 && diags2.length() >= 1 && diags2[0].code == "E_TYPE_MISMATCH", json2)
}

///|
test "p30g_no_io_and_render_thread_diagnostics" {
  // 1. #render_thread and #no_io reject World parameter with E_NO_IO_VIOLATION and no edits
  let bad_param_src =
    #|#render_thread
    #|pub fn bad_render(world : World) -> Unit {
    #|  let _ = world
    #|}
    #|#[no_io]
    #|pub fn bad_no_io(w : World) -> Unit {
    #|  let _ = w
    #|}
  let (ok1, json1, diags1) = check_one(bad_param_src)
  assert_true(!ok1 && diags1.length() == 2, json1)
  assert_true(diags1[0].code == "E_NO_IO_VIOLATION" && diags1[0].edits.length() == 0, json1)
  assert_true(diags1[1].code == "E_NO_IO_VIOLATION" && diags1[1].edits.length() == 0, json1)

  // 2. Direct World IO calls (fs_read, sleep_ms, io_println, scope) and nested closure IO inside #render_thread
  let bad_calls_src =
    #|#render_thread
    #|pub fn ui_tick() -> Unit {
    #|  let _ = fs_read("a.txt")
    #|  sleep_ms(10)
    #|  io_println("hi")
    #|  let on_click : () -> Unit = fn() -> Unit {
    #|    let _ = fs_read("b.txt")
    #|    sleep_ms(5)
    #|  }
    #|  on_click()
    #|}
    #|#no_io
    #|pub fn ui_scope(x : Int) -> Unit {
    #|  scope(x, fn(s : Scope) -> Unit {
    #|    let _ = s
    #|  })
    #|}
  let (ok2, json2, diags2) = check_one(bad_calls_src)
  assert_true(!ok2 && diags2.length() >= 6, json2)
  let mut i = 0
  while i < diags2.length() {
    assert_true(diags2[i].code == "E_NO_IO_VIOLATION", json2)
    assert_true(diags2[i].edits.length() == 0, "E_NO_IO_VIOLATION must never emit world insertion edits: " + json2)
    i = i + 1
  }

  // 3. Pure compute, Channel::send/recv, AtomicInt, and non-World extern "C" pass with 0 diagnostics
  let ok_src =
    #|extern "C" fn invar_draw_rect(x : Int, y : Int) -> Unit
    #|pub enum Cmd {
    #|  Click(Int)
    #|}
    #|trait View {
    #|  fn render(self : Self, ch : Channel[Cmd]) -> Int
    #|}
    #|struct Panel {
    #|  id : Int
    #|}
    #|impl View for Panel {
    #|  #render_thread
    #|  fn render(self : Panel, ch : Channel[Cmd]) -> Int {
    #|    invar_draw_rect(self.id, 10)
    #|    let _ = ch.send(Cmd::Click(self.id))
    #|    let _ = ch.recv()
    #|    self.id + 1
    #|  }
    #|}
    #|#[render_thread]
    #|pub fn build_ui(ch : Channel[Cmd], a : AtomicInt) -> Int {
    #|  invar_draw_rect(0, 0)
    #|  let on_tap : () -> Unit = fn() -> Unit {
    #|    let _ = ch.send(Cmd::Click(1))
    #|  }
    #|  on_tap()
    #|  a.load() + 42
    #|}
  let (ok3, json3, _) = check_one(ok_src)
  assert_true(ok3, json3)
}

///|
test "p31a_ergonomics_unit_discard_fn_field_with_capacity" {
  // 1. -> Unit implicit tail discard for non-Result values (fn, closure, if, match),
  //    while Result in tail position still strictly reports E_UNHANDLED_RESULT.
  let ok_unit =
    #|struct Builder { n : Int }
    #|fn Builder::add(self : Builder, x : Int) -> Builder { Builder::{ n: self.n + x } }
    #|fn run_u(cb : () -> Unit) -> Unit { cb() }
    #|pub fn build_it(flag : Bool, k : Int) -> Unit {
    #|  let b = Builder::{ n: 0 }
    #|  run_u(fn() -> Unit { b.add(1) })
    #|  if flag { b.add(2) } else { b.add(3) }
    #|  match k {
    #|    0 => b.add(4)
    #|    _ => b.add(5)
    #|  }
    #|}
  let (ok1, json1, _) = check_one(ok_unit)
  assert_true(ok1, json1)

  let bad_unit_res =
    #|fn fallible() -> Result[Int, String] { Err("boom") }
    #|pub fn drop_res() -> Unit {
    #|  fallible()
    #|}
  let (ok2, json2, diags2) = check_one(bad_unit_res)
  assert_true(!ok2 && diags2.length() == 1 && diags2[0].code == "E_UNHANDLED_RESULT", json2)

  let bad_match_res =
    #|fn fallible() -> Result[Int, String] { Err("boom") }
    #|pub fn drop_match_res(x : Int) -> Unit {
    #|  match x {
    #|    0 => fallible()
    #|    _ => ()
    #|  }
    #|}
  let (ok2b, json2b, diags2b) = check_one(bad_match_res)
  assert_true(!ok2b && diags2b.length() == 1 && diags2b[0].code == "E_UNHANDLED_RESULT", json2b)

  let bad_non_unit =
    #|pub fn want_int() -> Int {
    #|  "not an int"
    #|}
  let (ok2c, json2c, diags2c) = check_one(bad_non_unit)
  assert_true(!ok2c && diags2c.length() == 1 && diags2c[0].code == "E_TYPE_MISMATCH", json2c)

  // 2. Struct function-typed field direct call + generic struct + method precedence
  let ok_fn_field =
    #|struct Device[T] {
    #|  refresh : () -> T
    #|  set_dpi : (Int, Int) -> Int
    #|  apply : ((Int) -> Int) -> Int
    #|}
    #|fn Device::set_dpi(self : Device[Int], a : Int, b : Int) -> Int { a * 10 + b }
    #|pub fn use_dev(d : Device[Int]) -> Int {
    #|  let a = d.refresh()
    #|  let b = d.set_dpi(1, 2)
    #|  let c = d.apply(fn(x) { x + 1 })
    #|  a + b + c
    #|}
  let (ok3, json3, _) = check_one(ok_fn_field)
  assert_true(ok3, json3)

  // 3. Array::with_capacity & Map::with_capacity unannotated inference + non-Int rejection
  let ok_cap =
    #|pub fn caps() -> Int {
    #|  let a = Array::with_capacity(64)
    #|  a.push(10)
    #|  let m = Map::with_capacity(32)
    #|  m.set("k", 20)
    #|  a.length() + m.length()
    #|}
  let (ok4, json4, _) = check_one(ok_cap)
  assert_true(ok4, json4)

  let bad_cap =
    #|pub fn bad_caps() -> Unit {
    #|  let a : Array[Int] = Array::with_capacity("64")
    #|  let m : Map[String, Int] = Map::with_capacity("32")
    #|  let _ = a.length() + m.length()
    #|}
  let (ok5, json5, diags5) = check_one(bad_cap)
  assert_true(!ok5 && diags5.length() == 2 && diags5[0].code == "E_TYPE_MISMATCH" && diags5[1].code == "E_TYPE_MISMATCH", json5)
}

///|
test "p31c_leading_dot_variants_and_pion_jsx" {
  // 1. Leading-dot enum / Option / Result inference, bidirectional ==, optional named param, dot patterns
  let ok_dot =
    #|enum Along {
    #|  Start
    #|  Middle
    #|  Between
    #|}
    #|enum Flag {
    #|  Off
    #|  Is(Bool)
    #|}
    #|fn place(along? : Along, flag~ : Flag = .Off) -> Int {
    #|  let a = match along {
    #|    .Some(.Middle) => 10
    #|    .Some(.Between) => 20
    #|    _ => 0
    #|  }
    #|  let b = if flag is .Is(true) { 1 } else { 0 }
    #|  a + b
    #|}
    #|pub fn test_dot() -> Int {
    #|  let x : Along = .Middle
    #|  let eq1 = x == .Middle
    #|  let eq2 = .Middle == x
    #|  let eq3 = .Start != x
    #|  let o : Option[Int] = .Some(7)
    #|  let n : Option[Int] = .None
    #|  let r : Result[Int, String] = .Ok(5)
    #|  let _ = (eq1, eq2, eq3, o, n, r)
    #|  place(along=.Middle, flag=.Is(true))
    #|}
  let (ok1, json1, _) = check_one(ok_dot)
  assert_true(ok1, json1)

  // 2. Negative: leading-dot variant without expected type
  let bad_dot =
    #|pub fn bad() -> Unit {
    #|  let x = .Unknown
    #|  let _ = x
    #|}
  let (ok2, json2, diags2) = check_one(bad_dot)
  assert_true(!ok2 && diags2.length() >= 1 && diags2[0].code == "E_TYPE_MISMATCH", json2)

  // 3. Pion-JSX full desugaring: in={root}, bool attrs, interp strings, =>{...}, for/if, <>, View tail, <For> in={item_v}
  let ok_jsx =
    #|struct View { id : Int }
    #|enum Along { Start; Middle; Between }
    #|fn Box(p : View, row~ : Bool = false, along? : Along, children? : (View) -> Unit) -> View {
    #|  match children { .Some(f) => f(p); .None => () }
    #|  p
    #|}
    #|fn Text(p : View, label~ : String = "", text? : () -> String) -> View {
    #|  let _ = (label, text)
    #|  p
    #|}
    #|fn For[T](p : View, items~ : Array[T], render~ : (View, T) -> Unit) -> View {
    #|  for x in items { render(p, x) }
    #|  p
    #|}
    #|pub fn build(root : View, pct : Int, xs : Array[Int], cond : Bool) -> Unit {
    #|  <Box in={root} row along={.Between}>
    #|    <>
    #|      <Text label="电量 \{pct}%" />
    #|      <Text text=>{pct.to_string()} />
    #|    </>
    #|    if cond {
    #|      <Text label="cond" />
    #|    }
    #|    for x in xs {
    #|      <Text label="\{x}" />
    #|    }
    #|    <For items={xs} render={fn(item_v, v) {
    #|      <Text in={item_v} label="\{v}" />
    #|    }} />
    #|    <Text label="tail_view_discarded" />
    #|  </Box>
    #|}
  let (ok3, json3, _) = check_one(ok_jsx)
  assert_true(ok3, json3)

  // 4. Negative: mismatched JSX closing tag
  let bad_close =
    #|fn Box(children? : (Int) -> Unit) -> Unit { let _ = children }
    #|pub fn f() -> Unit {
    #|  <Box></Row>
    #|}
  let (ok4, json4, diags4) = check_one(bad_close)
  assert_true(!ok4 && diags4.length() >= 1 && diags4[0].code == "E_PARSE", json4)

  // 5. Negative: JSX inside attribute expression must NOT inherit outer parent stack
  let bad_attr_parent =
    #|fn Icon(p : Int) -> Int { p }
    #|fn Box(p : Int, icon~ : Int = 0, children? : (Int) -> Unit) -> Unit {
    #|  let _ = (p, icon, children)
    #|}
    #|pub fn f() -> Unit {
    #|  <Box in={1}>
    #|    <Box icon={<Icon />} />
    #|  </Box>
    #|}
  let (ok5, json5, diags5) = check_one(bad_attr_parent)
  assert_true(!ok5 && diags5.length() >= 1 && diags5[0].code == "E_TYPE_MISMATCH", json5)

  // 6. P31-C2: same-package fn takes precedence over unqualified enum variant in ECall / JSX
  let ok_fn_over_variant =
    #|enum Dir {
    #|  Row
    #|  Col
    #|}
    #|struct View { id : Int }
    #|pub fn Row(parent : View, gap~ : Int = 0, children? : (View) -> Unit) -> View {
    #|  let _ = gap
    #|  match children {
    #|    .Some(f) => f(parent)
    #|    .None => ()
    #|  }
    #|  parent
    #|}
    #|pub fn build_row(root : View) -> Int {
    #|  let d1 : Dir = .Row
    #|  let d2 = Dir::Row
    #|  let _ = <Row in={root} gap={8}>
    #|    <Row gap={4} />
    #|  </Row>
    #|  if d1 == d2 && d1 == .Row { 1 } else { 0 }
    #|}
  let (ok6, json6, _) = check_one(ok_fn_over_variant)
  assert_true(ok6, json6)
}

///|
test "p33c_local_closure_and_param_shadow_top_level_fn" {
  let src =
    #|fn clamp_u8(x : Int) -> String {
    #|  x.to_string()
    #|}
    #|fn helper(x : Int) -> Int {
    #|  x + 1
    #|}
    #|pub fn use_local_closure(v : Double) -> Byte {
    #|  let clamp_u8 = fn(v : Double) -> Byte {
    #|    let iv = (v * 255.0 + 0.5).to_int()
    #|    iv as Byte
    #|  }
    #|  clamp_u8(v)
    #|}
    #|pub fn apply(clamp_u8 : (Double) -> Byte, v : Double) -> Byte {
    #|  clamp_u8(v)
    #|}
    #|pub fn non_fn_local_still_calls_top_fn() -> Int {
    #|  let helper = 10
    #|  helper(helper)
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, json)
}

///|
fn p35_check(src : String) -> CheckedPackage {
  check_source_files_with_imports("p35", ["p35.pion"], [src], [], false)
}

///|
fn p35_json(src : String) -> String {
  check_result_to_json(p35_check(src).diagnostics)
}

///|
fn p35_count(hay : String, needle : String) -> Int {
  let mut n = 0
  let mut rest = hay
  while true {
    match t_str_find(rest, needle) {
      Some(i) => {
        n = n + 1
        rest = t_str_from(rest, i + needle.length())
      }
      None => break
    }
  }
  n
}

///|
test "p35a: mut params / #verify parse, fmt, pionsig and stub round-trip" {
  let src =
    #|pub struct S {
    #|  mut x : Int
    #|}
    #|
    #|#verify
    #|pub fn bump(mut x : Int, by : Int) -> Unit {
    #|  x = x + by
    #|}
    #|
    #|#verify_opaque
    #|pub fn S::reset(mut self : S) -> Unit {
    #|  self = S::{ x: 0 }
    #|}
    #|
    #|pub trait T {
    #|  tick(mut self : Self) -> Unit
    #|}
    #|
    #|impl T for S {
    #|  fn tick(mut self : S) -> Unit {
    #|    self.x = self.x + 1
    #|  }
    #|}
    #|
    #|pub fn plain(a : Int, b : Int) -> Int {
    #|  let mut v = a
    #|  bump(mut v, b)
    #|  v
    #|}
    #|
  let fmted = format_source(src)
  debug_assert(format_source(fmted) == fmted, "fmt idempotent")
  debug_assert(str_contains(fmted, "#verify\npub fn bump(mut x : Int, by : Int) -> Unit {"), "fmt keeps #verify + mut param")
  debug_assert(str_contains(fmted, "  bump(mut v, b)\n"), "fmt keeps mut argument")
  let cr = p35_check(src)
  debug_assert(cr.diagnostics.length() == 0, "p35 sig source checks: " + check_result_to_json(cr.diagnostics))
  let sig = cli_emit_sig("p35", ["p35.pion"], [src])
  debug_assert(str_contains(sig, "#verify fn bump(mut x: Int, by: Int) -> Unit"), "sig: #verify + mut param")
  debug_assert(str_contains(sig, "#verify_opaque fn S::reset(mut self: S) -> Unit"), "sig: #verify_opaque method")
  debug_assert(str_contains(sig, "fn plain(a: Int, b: Int) -> Int"), "sig: plain fn unchanged")
  debug_assert(!str_contains(sig, "#verify fn plain"), "sig: no marker on plain fn")
  debug_assert(str_contains(sig, "tick(mut self: Self) -> Unit"), "sig: trait mut self")
  match parse_pionsig(sig) {
    Ok(parsed) => {
      debug_assert(serialize_pionsig(parsed) == sig, "pionsig round-trip")
      let mut saw_bump = false
      let mut i = 0
      while i < parsed.entries.length() {
        if parsed.entries[i].name == "bump" && parsed.entries[i].kind == "fn" {
          saw_bump = true
        }
        i = i + 1
      }
      debug_assert(saw_bump, "parse_pionsig names `#verify fn bump`")
    }
    Err(e) => abort("parse_pionsig failed: " + e)
  }
  // Signatures without `mut` / `#verify` stay byte-identical to the pre-P35 format.
  let legacy = cli_emit_sig("old", ["old.pion"], ["pub fn add(a : Int, b~ : Int = 1) -> Int { a + b }\n"])
  debug_assert(legacy == "pionsig v1\npkg old\nfn add(a: Int, b~: Int = 1) -> Int\n", "legacy sig bytes: " + legacy)
  let stub = emit_pion_stub(cr.pkg)
  debug_assert(str_contains(stub, "#verify\npub fn bump(mut x : Int, by : Int) -> Unit { panic() }"), "stub: #verify fn")
  debug_assert(str_contains(stub, "  fn tick(mut self : S) -> Unit { panic() }"), "stub: impl mut self")
  let spr = parse_source("p35.pionstub", stub)
  debug_assert(spr.diagnostics.length() == 0, "stub re-parses")
  let mut found = false
  let mut di = 0
  while di < spr.file.decls.length() {
    match spr.file.decls[di] {
      DFn(fd) =>
        if fd.name == "bump" {
          found = true
          debug_assert(fd.is_verify && !fd.is_verify_opaque, "stub keeps #verify")
          debug_assert(fd.params[0].is_mut && !fd.params[1].is_mut, "stub keeps mut flags")
        } else if fd.name == "reset" {
          debug_assert(fd.is_verify_opaque && !fd.is_verify, "stub keeps #verify_opaque")
        }
      _ => ()
    }
    di = di + 1
  }
  debug_assert(found, "stub has bump")
}

///|
test "p35a: E_PARSE for mut on labeled/optional/default/extern/closure params" {
  let bad = [
    "fn f(mut x~ : Int) -> Unit { }\n", "fn f(mut x? : Int) -> Unit { }\n", "fn f(mut x : Int = 1) -> Unit { }\n",
    "extern \"C\" fn f(mut x : Int) -> Int\n", "fn g() -> Unit { let c = fn(mut x : Int) { x }\n }\n",
  ]
  let mut i = 0
  while i < bad.length() {
    let pr = parse_source("bad.pion", bad[i])
    debug_assert(pr.diagnostics.length() > 0, "expected E_PARSE for case " + i.to_string())
    debug_assert(pr.diagnostics[0].code == "E_PARSE", "E_PARSE code for case " + i.to_string())
    i = i + 1
  }
}

///|
test "p35a: mut arguments in ordinary code" {
  let ok =
    #|struct S {
    #|  mut x : Int
    #|  mut y : Int
    #|  mut v : Array[Int]
    #|}
    #|fn two(mut a : Int, mut b : Int) -> Unit {
    #|  let t = a
    #|  a = b
    #|  b = t
    #|}
    #|fn S::grow(mut self : S) -> Unit {
    #|  self = S::{ x: self.x + 1, y: self.y, v: self.v }
    #|}
    #|fn run() -> Int {
    #|  let mut s = S::{ x: 1, y: 2, v: [1, 2] }
    #|  two(mut s.x, mut s.y)
    #|  let i = 0
    #|  let j = 1
    #|  two(mut s.v[i], mut s.y)
    #|  s.grow()
    #|  let mut w = 3
    #|  two(mut w, mut s.x)
    #|  w + s.x
    #|}
  let okj = p35_json(ok)
  debug_assert(okj == "{\"ok\":true,\"diagnostics\":[]}", "ordinary mut code passes: " + okj)
  let bad =
    #|struct S {
    #|  mut x : Int
    #|  y : Int
    #|}
    #|fn bump(mut x : Int) -> Unit {
    #|  x = x + 1
    #|}
    #|fn plain(x : Int) -> Int {
    #|  x
    #|}
    #|fn S::m(mut self : S) -> Unit {
    #|  self.x = 0
    #|}
    #|fn run() -> Unit {
    #|  let v = 1
    #|  bump(mut v)
    #|  let mut w = 1
    #|  bump(w)
    #|  let _ = plain(mut w)
    #|  let f = bump
    #|  let mut s = S::{ x: 1, y: 2 }
    #|  bump(mut s.y)
    #|  let t = S::{ x: 1, y: 2 }
    #|  t.m()
    #|  bump(mut plain(1))
    #|  let k = fn() -> Int { 1 }
    #|  let _ = k
    #|}
    #|fn cap(mut x : Int) -> Int {
    #|  let g = fn() -> Int { x }
    #|  g()
    #|}
  let bj = p35_json(bad)
  debug_assert(str_contains(bj, "cannot pass immutable `v` as a `mut` argument"), "immutable root: " + bj)
  debug_assert(str_contains(bj, "must be written `mut <place>`"), "missing mut keyword")
  debug_assert(str_contains(bj, "\"replacement\":\"mut \""), "missing mut keyword fix-it edit")
  debug_assert(str_contains(bj, "parameter `x` of `plain` is not `mut`"), "mut on plain param")
  debug_assert(str_contains(bj, "has `mut` parameters and cannot be used as a value"), "fn value")
  debug_assert(str_contains(bj, "field `y` of `S` is not `mut`"), "immutable field")
  debug_assert(str_contains(bj, "cannot pass immutable `t` as a `mut` argument"), "mut self on immutable binding")
  debug_assert(str_contains(bj, "a `mut` argument must be a place"), "temporary as mut arg")
  debug_assert(str_contains(bj, "closure cannot capture `mut` parameter `x`"), "closure capture of mut param")
}

///|
test "p35a: E_VERIFY_UNSUPPORTED" {
  let body =
    #|fn f(x : Float, w : World, p : Ptr, a : AtomicInt) -> Int {
    #|  0
    #|}
  debug_assert(p35_count(p35_json(body), "E_VERIFY_UNSUPPORTED") == 0, "no #verify: not checked")
  let j = p35_json("#verify\n" + body)
  debug_assert(p35_count(j, "E_VERIFY_UNSUPPORTED") == 4, "4 forbidden types: " + j)
  let dynj = p35_json(
    "trait D {\n  d(self : Self) -> Int\n}\n#verify\nfn g(x : dyn D) -> Int {\n  0\n}\n",
  )
  debug_assert(str_contains(dynj, "type `dyn D` is not supported"), "dyn Trait: " + dynj)
}

///|
test "p35a: E_VERIFY_MOVE with branch merge, copy() ok" {
  let body =
    #|fn f(c : Bool) -> Int {
    #|  let a = [1, 2]
    #|  if c {
    #|    let b = a
    #|    let _ = b
    #|  }
    #|  a.length()
    #|}
    #|fn g(c : Bool) -> Int {
    #|  let a = [1, 2]
    #|  let b = match c {
    #|    true => a
    #|    false => [3]
    #|  }
    #|  a.length() + b.length()
    #|}
  debug_assert(p35_count(p35_json(body), "E_VERIFY_MOVE") == 0, "no #verify: not checked")
  let vj = p35_json("#verify\n" + body)
  debug_assert(p35_count(vj, "E_VERIFY_MOVE") == 1, "if-branch move merges: " + vj)
  let vj2 = p35_json(
    "#verify\nfn g(c : Bool) -> Int {\n  let a = [1, 2]\n  let b = match c {\n    true => a\n    false => [3]\n  }\n  a.length() + b.length()\n}\n",
  )
  debug_assert(p35_count(vj2, "E_VERIFY_MOVE") == 1, "match-arm move merges: " + vj2)
  let ok =
    #|#verify
    #|fn h() -> Int {
    #|  let mut a = [1, 2]
    #|  let b = a.copy()
    #|  let c = a
    #|  a = [5]
    #|  a.length() + b.length() + c.length()
    #|}
  let okj = p35_json(ok)
  debug_assert(okj == "{\"ok\":true,\"diagnostics\":[]}", "copy + reassign restore: " + okj)
  let lp =
    #|#verify
    #|fn k(n : Int) -> Int {
    #|  let a = [1]
    #|  let mut i = 0
    #|  let mut t = 0
    #|  while i < n {
    #|    let b = a
    #|    t = t + b.length()
    #|    i = i + 1
    #|  }
    #|  t
    #|}
  debug_assert(p35_count(p35_json(lp), "E_VERIFY_MOVE") == 1, "move in loop body is caught")
}

///|
test "p35a: E_VERIFY_BORROW_ESCAPE / E_VERIFY_MUT_ESCAPE" {
  let body =
    #|struct Box {
    #|  items : Array[Int]
    #|}
    #|fn f(a : Array[Int]) -> Array[Int] {
    #|  a
    #|}
    #|fn g(a : Array[Int]) -> Box {
    #|  Box::{ items: a }
    #|}
    #|fn h(a : Array[Int]) -> Unit {
    #|  a[0] = 1
    #|  a.push(2)
    #|}
    #|fn ok(a : Array[Int]) -> Int {
    #|  let c = a.copy()
    #|  a[0] + a.length() + c.length() + f2(a)
    #|}
    #|fn f2(a : Array[Int]) -> Int {
    #|  a.length()
    #|}
  let plain = p35_json(body)
  debug_assert(p35_count(plain, "E_VERIFY_") == 0, "no #verify: not checked")
  let vbody =
    "struct Box {\n  items : Array[Int]\n}\n" +
    "#verify\nfn f(a : Array[Int]) -> Array[Int] {\n  a\n}\n" +
    "#verify\nfn g(a : Array[Int]) -> Box {\n  Box::{ items: a }\n}\n" +
    "#verify\nfn h(a : Array[Int]) -> Unit {\n  a[0] = 1\n  a.push(2)\n}\n" +
    "#verify\nfn ok(a : Array[Int]) -> Int {\n  let c = a.copy()\n  a[0] + a.length() + c.length() + f2(a)\n}\n" +
    "#verify\nfn f2(a : Array[Int]) -> Int {\n  a.length()\n}\n" +
    "#verify\nfn m1(mut a : Array[Int]) -> Array[Int] {\n  a\n}\n" +
    "#verify\nfn m2(mut a : Array[Int]) -> Box {\n  a.push(1)\n  Box::{ items: a }\n}\n" +
    "#verify\nfn m3(mut a : Array[Int]) -> Int {\n  let b = a.copy()\n  a.push(1)\n  a = [1]\n  b.length()\n}\n"
  let vj = p35_json(vbody)
  debug_assert(p35_count(vj, "E_VERIFY_BORROW_ESCAPE") == 4, "return/store/write/push on borrowed: " + vj)
  debug_assert(p35_count(vj, "E_VERIFY_MUT_ESCAPE") == 2, "return/store of mut param: " + vj)
  debug_assert(p35_count(vj, "\"code\"") == 6, "nothing else: " + vj)
}

///|
test "p35a: E_VERIFY_ALIASING and disjoint fields" {
  let src =
    #|struct S {
    #|  mut x : Int
    #|  mut y : Int
    #|}
    #|fn two(mut a : Int, mut b : Int) -> Unit {
    #|  a = b
    #|}
    #|fn whole(mut s : S, mut x : Int) -> Unit {
    #|  x = s.x
    #|}
    #|fn rd(mut x : Int, s : S) -> Unit {
    #|  x = s.y
    #|}
    #|fn run() -> Unit {
    #|  let mut v = 1
    #|  two(mut v, mut v)
    #|  let mut s = S::{ x: 1, y: 2 }
    #|  whole(mut s, mut s.x)
    #|  rd(mut s.x, s)
    #|  let mut arr = [1, 2, 3]
    #|  let i = 0
    #|  let j = 1
    #|  two(mut arr[i], mut arr[j])
    #|  let mut k = 0
    #|  two(mut arr[k], mut k)
    #|  two(mut s.x, mut s.y)
    #|}
  let j = p35_json(src)
  debug_assert(p35_count(j, "E_VERIFY_ALIASING") == 5, "5 overlapping calls: " + j)
  debug_assert(p35_count(j, "\"code\"") == 5, "disjoint s.x / s.y accepted: " + j)
}

///|
test "p35a: E_VERIFY_CLOSURE_CAPTURE" {
  let body =
    #|fn f() -> Int {
    #|  let mut n = 1
    #|  let g = fn() -> Int { n }
    #|  let a = [1]
    #|  let h = fn() -> Int { a.length() }
    #|  let k = 3
    #|  let ok = fn(x : Int) -> Int { k + x }
    #|  g() + h() + ok(1)
    #|}
  debug_assert(p35_count(p35_json(body), "E_VERIFY_") == 0, "no #verify: not checked")
  let vj = p35_json("#verify\n" + body)
  debug_assert(p35_count(vj, "E_VERIFY_CLOSURE_CAPTURE") == 2, "let mut + Unique captures: " + vj)
  debug_assert(p35_count(vj, "\"code\"") == 2, "Copy capture accepted: " + vj)
}

///|
test "p35a: E_VERIFY_UNVERIFIED_CALLEE, opaque/extern/builtin ok, normal -> verify ok" {
  let src =
    #|extern "C" fn labs(x : Int) -> Int
    #|fn plain(x : Int) -> Int {
    #|  x
    #|}
    #|#verify_opaque
    #|fn trusted(x : Int) -> Int {
    #|  plain(x)
    #|}
    #|#verify
    #|fn v(x : Int) -> Int {
    #|  x
    #|}
    #|#verify
    #|fn f(x : Int) -> Int {
    #|  plain(x) + trusted(x) + v(x) + labs(x) + [x].length()
    #|}
    #|fn normal() -> Int {
    #|  v(1) + f(2)
    #|}
    #|struct P {
    #|  mut a : Int
    #|}
    #|fn P::get(self : P) -> Int {
    #|  self.a
    #|}
    #|#verify impl Show for P {
    #|  fn show(self : P) -> Int {
    #|    self.get()
    #|  }
    #|}
    #|trait Show {
    #|  show(self : Self) -> Int
    #|}
  let j = p35_json(src)
  debug_assert(p35_count(j, "E_VERIFY_UNVERIFIED_CALLEE") == 2, "plain fn + plain method: " + j)
  debug_assert(str_contains(j, "calls unverified function `p35::plain`"), "target name")
  debug_assert(str_contains(j, "calls unverified function `p35::P::get`"), "method target via #verify impl")
  debug_assert(p35_count(j, "\"code\"") == 2, "opaque / extern / builtin / normal->verify accepted: " + j)
}

///|
test "p35a: ResolvedInfo side tables" {
  let src =
    #|fn id[T](x : T) -> T {
    #|  x
    #|}
    #|#verify_opaque
    #|fn opt(a : Int, b~ : Int = 5, c? : Int) -> Int {
    #|  a + b
    #|}
    #|#verify
    #|fn f(xs : Array[Int]) -> Int {
    #|  let n = xs.length()
    #|  let y = opt(1, c=2)
    #|  n + y
    #|}
    #|#verify
    #|fn g(s : String) -> Int {
    #|  idv(s, 1)
    #|}
    #|#verify
    #|fn idv[T](x : T, y : Int) -> Int {
    #|  y
    #|}
  let cr = p35_check(src)
  debug_assert(cr.diagnostics.length() == 0, "side table source checks: " + check_result_to_json(cr.diagnostics))
  let tc = cr.tc
  // `xs.length()` at line 10: method-call span is the `.` (col 14).
  match tc.call_targets.get(span_key(span_new("p35.pion", 10, 13))) {
    Some(t) => debug_assert(t == "builtin::Array::length", "builtin target: " + t)
    None => abort("missing call_targets for xs.length()")
  }
  match tc.expr_tys.get(span_key(span_new("p35.pion", 10, 11))) {
    Some(t) => debug_assert(ty_to_string(t) == "Array[Int]", "expr_tys xs: " + ty_to_string(t))
    None => abort("missing expr_tys for xs")
  }
  match tc.call_targets.get(span_key(span_new("p35.pion", 11, 14))) {
    Some(t) => debug_assert(t == "p35::opt", "user fn target: " + t)
    None => abort("missing call_targets for opt(...)")
  }
  match tc.call_arg_order.get(span_key(span_new("p35.pion", 11, 14))) {
    Some(o) => {
      debug_assert(o.length() == 3, "3 resolved slots")
      debug_assert(o[0] == 0 && o[1] == -1 && o[2] == 1, "named/default order")
    }
    None => abort("missing call_arg_order")
  }
  match tc.expr_tys.get(span_key(span_new("p35.pion", 12, 5))) {
    Some(t) => debug_assert(ty_to_string(t) == "Int", "expr_tys n + y")
    None => abort("missing expr_tys for n + y")
  }
  match tc.call_type_args.get(span_key(span_new("p35.pion", 16, 6))) {
    Some(ts) => debug_assert(ts.length() == 1 && ty_to_string(ts[0]) == "String", "type args of idv")
    None => abort("missing call_type_args for idv(s)")
  }
  // Non-`#verify` functions record nothing (zero cost for ordinary code).
  debug_assert(!tc.expr_tys.contains(span_key(span_new("p35.pion", 2, 3))), "no expr_tys outside #verify")
}

///|
test "p35a: [verify] enabled = true and #![verify]" {
  let toml = "[package]\nname = \"v\"\n\n[verify]\nenabled = true\n"
  match parse_pion_toml(toml) {
    Ok(m) => debug_assert(m.verify_enabled, "[verify] enabled = true")
    Err(e) => abort("manifest: " + e)
  }
  match parse_pion_toml("[package]\nname = \"v\"\n") {
    Ok(m) => debug_assert(!m.verify_enabled, "default off")
    Err(e) => abort("manifest: " + e)
  }
  match parse_pion_toml("[package]\nname = \"v\"\n[verify]\nstrict = true\n") {
    Ok(_) => abort("unknown [verify] key must fail")
    Err(e) => debug_assert(str_contains(e, "line 4") && str_contains(e, "unknown key `strict` in [verify]"), e)
  }
  let srcs = manifest_apply_verify(["fn a() -> Int {\n  1\n}\n#verify_opaque\nfn b() -> Int {\n  2\n}\n"], true)
  debug_assert(manifest_apply_verify(["x"], false)[0] == "x", "disabled: sources unchanged")
  let pr = parse_source("v.pion", srcs[0])
  debug_assert(pr.diagnostics.length() == 0, "#![verify] parses")
  match pr.file.decls[0] {
    DFn(fd) => debug_assert(fd.is_verify, "package switch marks fn #verify")
    _ => abort("decl 0")
  }
  match pr.file.decls[1] {
    DFn(fd) => debug_assert(!fd.is_verify && fd.is_verify_opaque, "#verify_opaque wins")
    _ => abort("decl 1")
  }
  let j = p35_json("fn plain() -> Int {\n  1\n}\nfn f() -> Int {\n  plain()\n}\n\n#![verify]\n")
  debug_assert(p35_count(j, "E_VERIFY_UNVERIFIED_CALLEE") == 0, "all fns verified: calls are fine: " + j)
  let j2 = p35_json("fn f(x : Float) -> Int {\n  0\n}\n\n#![verify]\n")
  debug_assert(p35_count(j2, "E_VERIFY_UNSUPPORTED") == 1, "rules apply under #![verify]: " + j2)
}

///|
test "p68a: #verify StringBuilder, Map and Double bit-pattern rules" {
  let ok_src =
    #|#verify
    #|fn ok_sb(mut sb : StringBuilder) -> String {
    #|  sb.write_string("hi")
    #|  sb.write_byte(b'!')
    #|  sb.write_substring("abcdef", 1, 4)
    #|  let _n = sb.length()
    #|  sb.to_string()
    #|}
    #|#verify
    #|fn ok_map(mut m : Map[String, Int]) -> Int {
    #|  m.set("a", 1)
    #|  let has = m.contains("a")
    #|  let v = match m.get("a") { Some(x) => x; None => 0 }
    #|  m.remove("a")
    #|  if has { v + m.length() } else { 0 }
    #|}
    #|#verify
    #|fn ok_dbl(bits : Int64) -> UInt64 {
    #|  let d = Double::from_bits(bits)
    #|  let b2 = d.to_bits()
    #|  let u = d.reinterpret_as_uint64()
    #|  let d2 = u.reinterpret_as_double()
    #|  if b2 == bits { d2.reinterpret_as_uint64() } else { 0UL }
    #|}
  let j_ok = p35_json(ok_src)
  debug_assert(str_contains(j_ok, "\"ok\":true"), "p68a valid code must pass: " + j_ok)

  let bad_sb_borrow =
    #|#verify
    #|fn bad(sb : StringBuilder) -> Unit {
    #|  sb.write_string("x")
    #|}
  let j_sbb = p35_json(bad_sb_borrow)
  debug_assert(p35_count(j_sbb, "E_VERIFY_BORROW_ESCAPE") == 1, "sb read-only write: " + j_sbb)

  let bad_map_move =
    #|#verify
    #|fn bad() -> Int {
    #|  let m : Map[String, Int] = Map::new()
    #|  let m2 = m
    #|  let _ = m2
    #|  m.length()
    #|}
  let j_mm = p35_json(bad_map_move)
  debug_assert(p35_count(j_mm, "E_VERIFY_MOVE") == 1, "map move-after-use: " + j_mm)

  let bad_dbl_arith =
    #|#verify
    #|fn bad1(a : Double, b : Double) -> Double {
    #|  a + b
    #|}
    #|#verify
    #|fn bad2(a : Double, b : Double) -> Bool {
    #|  a < b
    #|}
    #|#verify
    #|fn bad3() -> Double {
    #|  1.5
    #|}
  let j_da = p35_json(bad_dbl_arith)
  debug_assert(p35_count(j_da, "E_VERIFY_UNSUPPORTED") == 3, "Double arith/cmp/lit rejected: " + j_da)
}

///|
test "p35a: E_VERIFY_ALIASING for writes under a live for / match / is view" {
  let bad =
    #|struct C {
    #|  mut v : Int
    #|}
    #|#verify
    #|fn touch(mut a : Array[Int]) -> Unit {
    #|  a.push(0)
    #|}
    #|#verify
    #|fn f1(mut arr : Array[C]) -> Int {
    #|  let mut t = 0
    #|  for x in arr {
    #|    arr[0].v = 99
    #|    t = t + x.v
    #|  }
    #|  t
    #|}
    #|#verify
    #|fn f2(mut arr : Array[Int]) -> Int {
    #|  let mut t = 0
    #|  for x in arr {
    #|    arr.push(x)
    #|    touch(mut arr)
    #|    t = t + x
    #|  }
    #|  t
    #|}
    #|#verify
    #|fn f3(mut opt : Option[Array[Int]]) -> Int {
    #|  match opt {
    #|    Some(xs) => {
    #|      opt = None
    #|      xs.length()
    #|    }
    #|    None => 0
    #|  }
    #|}
    #|#verify
    #|fn f4(mut opt : Option[Array[Int]]) -> Int {
    #|  if opt is Some(xs) {
    #|    opt = None
    #|    return xs.length()
    #|  }
    #|  0
    #|}
  let j = p35_json(bad)
  debug_assert(p35_count(j, "E_VERIFY_ALIASING") == 5, "5 writes under a live view: " + j)
  debug_assert(p35_count(j, "\"code\"") == 5, "nothing else: " + j)
  let ok =
    #|#verify
    #|fn g1(arr : Array[Int]) -> Int {
    #|  let mut t = 0
    #|  for x in arr {
    #|    t = t + x + arr.length()
    #|  }
    #|  t
    #|}
    #|#verify
    #|fn g2(mut arr : Array[Int]) -> Int {
    #|  let mut t = 0
    #|  for x in arr {
    #|    t = t + x
    #|  }
    #|  arr.push(t)
    #|  t
    #|}
    #|#verify
    #|fn g3(mut opt : Option[Array[Int]]) -> Int {
    #|  let n = match opt {
    #|    Some(xs) => xs.length()
    #|    None => 0
    #|  }
    #|  opt = None
    #|  n
    #|}
    #|#verify
    #|fn g4(mut opt : Option[Int]) -> Int {
    #|  match opt {
    #|    Some(v) => {
    #|      opt = None
    #|      v
    #|    }
    #|    None => 0
    #|  }
    #|}
  let okj = p35_json(ok)
  debug_assert(okj == "{\"ok\":true,\"diagnostics\":[]}", "read-only views / Copy bindings pass: " + okj)
}

///|
test "p35a: E_VERIFY_UNVERIFIED_CALLEE through a generic trait bound" {
  let src =
    #|trait Step {
    #|  step(self : Self) -> Int
    #|}
    #|struct Evil {
    #|  v : Int
    #|}
    #|struct Good {
    #|  v : Int
    #|}
    #|impl Step for Evil {
    #|  fn step(self : Evil) -> Int {
    #|    self.v
    #|  }
    #|}
    #|#verify impl Step for Good {
    #|  fn step(self : Good) -> Int {
    #|    self.v
    #|  }
    #|}
    #|#verify
    #|fn run[T : Step](t : T) -> Int {
    #|  t.step()
    #|}
    #|#verify
    #|fn bad() -> Int {
    #|  run(Evil::{ v: 1 })
    #|}
    #|#verify
    #|fn good() -> Int {
    #|  run(Good::{ v: 1 })
    #|}
    #|fn plain() -> Int {
    #|  run(Evil::{ v: 1 })
    #|}
  let j = p35_json(src)
  debug_assert(p35_count(j, "E_VERIFY_UNVERIFIED_CALLEE") == 1, "unverified impl via bound: " + j)
  debug_assert(str_contains(j, "trait method `Step::Evil::step` is unverified"), "names the impl method: " + j)
  debug_assert(p35_count(j, "\"code\"") == 1, "#verify impl and non-#verify caller pass: " + j)
}

///|
test "p49c: StringBuilder::with_capacity and write_substring typechecking" {
  let ok_src =
    #|fn ok_fn(s : String) -> String {
    #|  let sb = StringBuilder::with_capacity(1024)
    #|  sb.write_substring(s, 1, 5)
    #|  sb.to_string()
    #|}
  let ok_cr = check_source_files_full("p49c_ok", ["p49c_ok.pion"], [ok_src])
  assert_true(
    ok_cr.diagnostics.length() == 0,
    check_result_to_json(ok_cr.diagnostics),
  )

  let bad_src =
    #|fn bad_fn(s : String) -> Unit {
    #|  let sb1 = StringBuilder::with_capacity("nope")
    #|  let sb2 = StringBuilder::with_capacity(1, 2)
    #|  sb1.write_substring(123, "a", true)
    #|  sb2.write_substring(s, 0)
    #|}
  let bad_cr = check_source_files_full("p49c_bad", ["p49c_bad.pion"], [bad_src])
  let bad_json = check_result_to_json(bad_cr.diagnostics)
  assert_true(bad_cr.diagnostics.length() >= 5, bad_json)
  assert_true(str_contains(bad_json, "E_TYPE_MISMATCH"), bad_json)
  assert_true(str_contains(bad_json, "E_ARITY"), bad_json)
}

///|
test "p71b_dup_def_user_fn_precedence_and_log1p" {
  // 1. Recursive ty_prefer_concrete merges partial compound types
  let merged = ty_prefer_concrete(
    TTuple([TBool, TOption(TError), TArray(TString)]),
    TTuple([TBool, TOption(TString), TArray(TError)]),
  )
  assert_true(!ty_has_unresolved(merged), ty_to_string(merged))
  assert_true(ty_to_string(merged) == "(Bool, Option[String], Array[String])", ty_to_string(merged))

  // 2. User-defined sha256_hex(Bytes) strictly precedes builtin sha256_hex(String) + math_log1p
  let ok_src =
    #|pub fn sha256_hex(b : Bytes) -> String {
    #|  b.length().to_string()
    #|}
    #|pub fn use_both(b : Bytes, x : Double) -> (String, Double) {
    #|  (sha256_hex(b), math_log1p(x))
    #|}
  let ok_cr = check_source_files_full("p71b_ok", ["p71b_ok.pion"], [ok_src])
  assert_true(
    ok_cr.diagnostics.length() == 0,
    check_result_to_json(ok_cr.diagnostics),
  )

  // 3. Cross-file duplicate top-level fn / method / extern / const -> E_DUP_DEF
  let f1 =
    #|pub fn dup_f(x : Int) -> Int { x }
    #|struct S { v : Int }
    #|fn S::m(self : S) -> Int { self.v }
    #|extern "C" fn dup_e(x : Int) -> Int
    #|let DUP_C : Int = 1
  let f2 =
    #|pub fn dup_f(x : Int) -> Int { x + 1 }
    #|fn S::m(self : S) -> Int { self.v + 1 }
    #|extern "C" fn dup_e(x : Int) -> Int
    #|let DUP_C : Int = 2
  let dup_cr = check_source_files_full("p71b_dup", ["a.pion", "b.pion"], [f1, f2])
  let dup_json = check_result_to_json(dup_cr.diagnostics)
  assert_true(dup_cr.diagnostics.length() == 4, dup_json)
  assert_true(str_contains(dup_json, "E_DUP_DEF"), dup_json)
  assert_true(str_contains(dup_json, "a.pion:1"), dup_json)
  assert_true(str_contains(dup_json, "a.pion:3"), dup_json)
  assert_true(str_contains(dup_json, "a.pion:4"), dup_json)
  assert_true(str_contains(dup_json, "a.pion:5"), dup_json)
}

///|
test "p72b_immut_priv_and_enum_methods" {
  // 1. Immutable struct field `=` and `+=` rejected; `mut` field allowed; `priv : Int` field name allowed
  let bad_immut =
    #|struct Boxed {
    #|  x : Int
    #|  mut y : Int
    #|  priv : Int
    #|}
    #|fn f(b : Boxed) -> Int {
    #|  b.x = 1
    #|  b.x += 2
    #|  b.y = 3
    #|  b.y += 4
    #|  b.priv
    #|}
  let cr1 = check_source_files_full("p72b_immut", ["main.pion"], [bad_immut])
  let j1 = check_result_to_json(cr1.diagnostics)
  assert_true(cr1.diagnostics.length() == 2, j1)
  assert_true(str_contains(j1, "cannot assign to immutable field `x`"), j1)

  // 2. Cross-package `pub struct` with `priv` fields + `enum` methods
  let lib_src =
    #|pub struct KeyPair {
    #|  pub_id : Int
    #|  priv scalar : String
    #|  priv mut counter : Int
    #|}
    #|
    #|pub fn KeyPair::new(id : Int, s : String) -> KeyPair {
    #|  KeyPair::{ pub_id: id, scalar: s, counter: 0 }
    #|}
    #|
    #|pub fn KeyPair::bump(self : KeyPair) -> Int {
    #|  self.counter += 1
    #|  self.counter + self.scalar.length()
    #|}
    #|
    #|pub enum Base64Error {
    #|  BadLen(Int)
    #|  BadChar(Int)
    #|}
    #|
    #|pub fn Base64Error::message(self : Base64Error) -> String {
    #|  match self {
    #|    BadLen(n) => "len:" + n.to_string()
    #|    BadChar(c) => "char:" + c.to_string()
    #|  }
    #|}
  let lib_cr = check_source_files_with_imports("crypto", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  // Verify .pionsig and .pionstub preserve `priv `
  let psig = emit_pionsig(lib_cr.pkg)
  let pstub = emit_pion_stub(lib_cr.pkg)
  assert_true(str_contains(psig, "priv scalar"), psig)
  assert_true(str_contains(psig, "priv mut counter"), psig)
  assert_true(str_contains(pstub, "priv scalar"), pstub)
  assert_true(str_contains(pstub, "priv mut counter"), pstub)

  let imp = [ImportedPkg::{ name: "crypto", tc: lib_cr.tc }]

  // 2a. Valid cross-package usage: public constructor, public field read, method, enum dot & path methods
  let ok_app =
    #|import "crypto"
    #|pub fn run() -> String {
    #|  let kp = crypto::KeyPair::new(7, "abcd")
    #|  let n = kp.pub_id + kp.bump()
    #|  let e1 = crypto::Base64Error::BadLen(n)
    #|  let s1 = e1.message()
    #|  let s2 = crypto::Base64Error::message(e1)
    #|  s1 + "|" + s2
    #|}
  let ok_cr = check_source_files_with_imports("app", ["main.pion"], [ok_app], imp, true)
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  // 2b. Invalid cross-package usage: priv read, priv write, immut pub write, direct struct lit
  let bad_app =
    #|import "crypto"
    #|pub fn bad() -> Int {
    #|  let kp = crypto::KeyPair::{ pub_id: 1, scalar: "x", counter: 2 }
    #|  kp.pub_id = 9
    #|  kp.counter = 5
    #|  kp.scalar.length()
    #|}
  let bad_cr = check_source_files_with_imports("app_bad", ["main.pion"], [bad_app], imp, true)
  let bad_j = check_result_to_json(bad_cr.diagnostics)
  assert_true(bad_cr.diagnostics.length() >= 4, bad_j)
  assert_true(str_contains(bad_j, "E_PRIVATE_FIELD"), bad_j)
  assert_true(str_contains(bad_j, "cannot assign to immutable field `pub_id`"), bad_j)
}

///|
test "p74a: E_UNKNOWN_VARIANT on local/cross-pkg/Option/Result/match/is + Enum::method positive" {
  let lib_src =
    #|pub enum RemoteKind {
    #|  Alpha
    #|  Beta(Int)
    #|}
    #|pub fn RemoteKind::tag(self : RemoteKind) -> Int {
    #|  match self {
    #|    Alpha => 1
    #|    Beta(n) => n
    #|  }
    #|}
  let lib_cr = check_source_files_with_imports("rlib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let imp = [ImportedPkg::{ name: "rlib", tc: lib_cr.tc }]

  // Positive: Enum::method as call and function value
  let ok_src =
    #|import "rlib"
    #|enum LocalKind {
    #|  One
    #|  Two(Int)
    #|}
    #|fn LocalKind::code(self : LocalKind) -> Int {
    #|  match self {
    #|    One => 1
    #|    Two(x) => x
    #|  }
    #|}
    #|pub fn run() -> Int {
    #|  let f : (LocalKind) -> Int = LocalKind::code
    #|  let g : (rlib::RemoteKind) -> Int = rlib::RemoteKind::tag
    #|  f(LocalKind::One) + g(rlib::RemoteKind::Beta(2))
    #|}
  let ok_cr = check_source_files_with_imports("ok_app", ["main.pion"], [ok_src], imp, true)
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  // Negative cases: each must emit E_UNKNOWN_VARIANT
  let cases : Array[String] = [
    "enum E { A\n B(Int) }\npub fn main() -> Int { let _ = E::Bogus(1)\n 0 }",
    "enum E { A }\npub fn main() -> Int { let _ = E::Bogus\n 0 }",
    "import \"rlib\"\npub fn main() -> Int { let _ = rlib::RemoteKind::Bogus(1)\n 0 }",
    "import \"rlib\"\npub fn main() -> Int { let _ = rlib::RemoteKind::Bogus\n 0 }",
    "pub fn main() -> Int { let _ = Option::Bogus\n 0 }",
    "pub fn main() -> Int { let _ = Option::Bogus(1)\n 0 }",
    "pub fn main() -> Int { let _ = Result::Bogus\n 0 }",
    "pub fn main() -> Int { let _ = Result::Bogus(1)\n 0 }",
    "enum E { A }\npub fn f(e : E) -> Int { match e { Bogus => 1\n _ => 0 } }",
    "pub fn f(o : Option[Int]) -> Int { match o { Bogus(_) => 1\n _ => 0 } }",
    "pub fn f(r : Result[Int, String]) -> Int { match r { Bogus(_) => 1\n _ => 0 } }",
    "enum E { A }\npub fn f(e : E) -> Bool { e is Bogus }",
    "import \"rlib\"\npub fn f(e : rlib::RemoteKind) -> Bool { e is Bogus }",
  ]
  let mut ci = 0
  while ci < cases.length() {
    let cr = check_source_files_with_imports("neg_" + ci.to_string(), ["main.pion"], [cases[ci]], imp, true)
    let j = check_result_to_json(cr.diagnostics)
    assert_true(str_contains(j, "E_UNKNOWN_VARIANT"), "case " + ci.to_string() + ": " + j)
    ci = ci + 1
  }
}

///|
test "p75a_int8_float32_bytes_frontend" {
  let src =
    #|pub fn f(x : Int8, y : Float32, b : Bytes) -> String {
    #|  let a : Int8 = -128
    #|  let c : Int8 = a.min(x).max(-100).clamp(-50, 50).abs()
    #|  let arr_i8 : Array[Int8] = [-5, 0, 127]
    #|  let arr_f32 : Array[Float32] = [1.0, -2.5f, y]
    #|  let r1 : Int8 = b.read_i8(0)
    #|  let r2 : Float = b.read_f32_le(1)
    #|  let _ : Int8 = (42).to_int8()
    #|  let _ : Int8 = (100L).to_int8()
    #|  let _ : Int8 = (255U).to_int8()
    #|  let _ : Int8 = (255UL).to_int8()
    #|  let _ : Int8 = b'\xff'.to_int8()
    #|  let _ : Int8 = (3.5f).to_int8()
    #|  let _ : Int8 = (-3.5).to_int8()
    #|  let _ : Float32 = Float32::from_int(3)
    #|  "\{c}:\{arr_i8[0]}:\{r1}:\{arr_f32[0] + r2}"
    #|}
    #|pub fn main() -> Int { 0 }
  let cr = check_source_files("p75a_fe", ["p75a_fe.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))

  // Array[Int8]::sort() must be rejected (no silent unsigned mis-sort)
  let bad_sort =
    #|pub fn main() -> Int {
    #|  let a : Array[Int8] = [-1, 1]
    #|  a.sort()
    #|  0
    #|}
  let cr_bad = check_source_files("p75a_bad_sort", ["p75a_bad_sort.pion"], [bad_sort])
  assert_true(cr_bad.diagnostics.length() > 0, "expected Array[Int8]::sort() type error")
}

///|
test "wave2f_bytes_be_and_blit_frontend" {
  let src =
    #|pub fn decode_all(b : Bytes, dst : Bytes, s : String) -> Int {
    #|  let v : BytesView = b.view(1, 20)
    #|  let _a1 : Int8 = b.read_i8(0)
    #|  let _a2 : Int = b.read_u8(0)
    #|  let _a3 : Int = b.read_i16_le(0)
    #|  let _a4 : Int = b.read_u16_le(0)
    #|  let _a5 : Int = b.read_i16_be(0)
    #|  let _a6 : Int = b.read_u16_be(0)
    #|  let _a7 : Int = b.read_i32_le(0)
    #|  let _a8 : UInt = b.read_u32_le(0)
    #|  let _a9 : Int = b.read_i32_be(0)
    #|  let _a10 : UInt = b.read_u32_be(0)
    #|  let _a11 : Int64 = b.read_i64_le(0)
    #|  let _a12 : UInt64 = b.read_u64_le(0)
    #|  let _a13 : Int64 = b.read_i64_be(0)
    #|  let _a14 : UInt64 = b.read_u64_be(0)
    #|  let _a15 : Float = b.read_f32_le(0)
    #|  let _a16 : Float = b.read_f32_be(0)
    #|  let _a17 : Double = b.read_f64_le(0)
    #|  let _a18 : Double = b.read_f64_be(0)
    #|  let _v1 : Int8 = v.read_i8(0)
    #|  let _v2 : Int = v.read_u8(0)
    #|  let _v3 : Int = v.read_i16_le(0)
    #|  let _v4 : Int = v.read_u16_le(0)
    #|  let _v5 : Int = v.read_i16_be(0)
    #|  let _v6 : Int = v.read_u16_be(0)
    #|  let _v7 : Int = v.read_i32_le(0)
    #|  let _v8 : UInt = v.read_u32_le(0)
    #|  let _v9 : Int = v.read_i32_be(0)
    #|  let _v10 : UInt = v.read_u32_be(0)
    #|  let _v11 : Int64 = v.read_i64_le(0)
    #|  let _v12 : UInt64 = v.read_u64_le(0)
    #|  let _v13 : Int64 = v.read_i64_be(0)
    #|  let _v14 : UInt64 = v.read_u64_be(0)
    #|  let _v15 : Float = v.read_f32_le(0)
    #|  let _v16 : Float = v.read_f32_be(0)
    #|  let _v17 : Double = v.read_f64_le(0)
    #|  let _v18 : Double = v.read_f64_be(0)
    #|  b.blit_to(dst, 0, 0, 4)
    #|  v.blit_to(dst, 0, 4, 4)
    #|  dst.copy_from_string(0, s, 0, 2)
    #|  _a2 + _v2
    #|}
    #|pub fn main() -> Int { 0 }
  let cr = check_source_files("wave2f_fe_ok", ["wave2f_fe_ok.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))

  let bad_cases : Array[String] = [
    "pub fn f(b : Bytes) -> Int { b.read_u16_be() }",
    "pub fn f(b : Bytes) -> Int { b.read_u16_be(\"0\") }",
    "pub fn f(b : Bytes) -> Int { let v = b.as_view(); v.read_i32_be(0, 1) }",
    "pub fn f(b : Bytes, d : Bytes) -> Unit { b.blit_to(d, 0, 0) }",
    "pub fn f(b : Bytes) -> Unit { b.blit_to(\"not_bytes\", 0, 0, 1) }",
    "pub fn f(b : Bytes) -> Unit { b.copy_from_string(0, 123, 0, 1) }",
    "pub fn f(b : Bytes, s : String) -> Unit { b.copy_from_string(0, s, 0) }",
  ]
  let mut i = 0
  while i < bad_cases.length() {
    let crb = check_source_files("wave2f_fe_bad_" + i.to_string(), ["main.pion"], [bad_cases[i]])
    assert_true(crb.diagnostics.length() > 0, "expected error for bad case " + i.to_string())
    i = i + 1
  }
}

///|
test "p85_method_arity_and_bitops_frontend" {
  // 1. Same-package struct & enum method calls with missing / extra args must emit E_TYPE_MISMATCH
  let local_cases : Array[String] = [
    "struct S { v : Int }\nfn S::add(self : S, a : Int, b : Int) -> Int { self.v + a + b }\npub fn main() -> Int { let s = S { v: 1 }\n s.add(2) }",
    "struct S { v : Int }\nfn S::add(self : S, a : Int, b : Int) -> Int { self.v + a + b }\npub fn main() -> Int { let s = S { v: 1 }\n s.add(2, 3, 4) }",
    "enum E { A(Int) }\nfn E::mix(self : E, a : Int, b : Int) -> Int { a + b }\npub fn main() -> Int { let e = E::A(1)\n e.mix(2) }",
    "enum E { A(Int) }\nfn E::mix(self : E, a : Int, b : Int) -> Int { a + b }\npub fn main() -> Int { let e = E::A(1)\n e.mix(2, 3, 4) }",
  ]
  let mut i = 0
  while i < local_cases.length() {
    let cr = check_source_files("p85_arity_local_" + i.to_string(), ["main.pion"], [local_cases[i]])
    let j = check_result_to_json(cr.diagnostics)
    assert_true(str_contains(j, "E_TYPE_MISMATCH"), "local case " + i.to_string() + ": " + j)
    i = i + 1
  }

  // 2. Cross-package struct & enum method calls with missing / extra args must emit E_TYPE_MISMATCH
  let lib_src =
    #|pub struct Box { pub v : Int }
    #|pub fn Box::combine(self : Box, x : Int, y : Int) -> Int { self.v + x + y }
    #|pub enum Tag {
    #|  On(Int)
    #|  Off
    #|}
    #|pub fn Tag::calc(self : Tag, x : Int, y : Int) -> Int { x + y }
  let lib_cr = check_source_files_with_imports("alib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let imp = [ImportedPkg::{ name: "alib", tc: lib_cr.tc }]
  let xpkg_cases : Array[String] = [
    "import \"alib\"\npub fn main() -> Int { let b = alib::Box { v: 1 }\n b.combine(2) }",
    "import \"alib\"\npub fn main() -> Int { let b = alib::Box { v: 1 }\n b.combine(2, 3, 4) }",
    "import \"alib\"\npub fn main() -> Int { let t = alib::Tag::Off\n t.calc(2) }",
    "import \"alib\"\npub fn main() -> Int { let t = alib::Tag::Off\n t.calc(2, 3, 4) }",
  ]
  let mut j = 0
  while j < xpkg_cases.length() {
    let cr = check_source_files_with_imports("p85_arity_xpkg_" + j.to_string(), ["main.pion"], [xpkg_cases[j]], imp, true)
    let dj = check_result_to_json(cr.diagnostics)
    assert_true(str_contains(dj, "E_TYPE_MISMATCH"), "xpkg case " + j.to_string() + ": " + dj)
    j = j + 1
  }

  // 3. Bitwise primitive methods type-check on Int / UInt / Int64 / UInt64 and reject wrong arity/arg types
  let bitops_ok =
    #|pub fn f(a : Int, b : UInt, c : Int64, d : UInt64) -> Int {
    #|  let a1 : Int = a.rotate_left(3).rotate_right(5)
    #|  let b1 : UInt = b.rotate_left(7).rotate_right(11)
    #|  let c1 : Int64 = c.rotate_left(13).rotate_right(17)
    #|  let d1 : UInt64 = d.rotate_left(19).rotate_right(23)
    #|  let s = a1.leading_zeros() + a1.trailing_zeros() + a1.count_ones() +
    #|    b1.leading_zeros() + b1.trailing_zeros() + b1.count_ones() +
    #|    c1.leading_zeros() + c1.trailing_zeros() + c1.count_ones() +
    #|    d1.leading_zeros() + d1.trailing_zeros() + d1.count_ones()
    #|  s
    #|}
    #|pub fn main() -> Int { 0 }
  let cr_ok = check_source_files("p85_bitops_ok", ["main.pion"], [bitops_ok])
  assert_true(cr_ok.diagnostics.length() == 0, check_result_to_json(cr_ok.diagnostics))

  // 4. R3-A + R4 shift RHS type inference: signed div, nested shift & shadowed local closure
  let shift_rhs_ok =
    #|fn amount() -> Int { 1 }
    #|pub fn sh_signed_div(x : UInt, n : Int) -> UInt { x << (1 + (1 / n)) }
    #|pub fn sh_nested_uint(x : UInt, k : UInt, n : Int) -> UInt { x >> (1 + (k << n)) }
    #|pub fn sh_shadow_closure(x : UInt, amount : () -> UInt) -> UInt { x >> (1 + amount()) }
    #|pub fn main() -> Int { 0 }
  let cr_sh = check_source_files("p85_shift_rhs_ok", ["main.pion"], [shift_rhs_ok])
  assert_true(cr_sh.diagnostics.length() == 0, check_result_to_json(cr_sh.diagnostics))

  let bitops_bad : Array[String] = [
    "pub fn f(x : Int) -> Int { x.rotate_left() }",
    "pub fn f(x : Int) -> Int { x.rotate_right(1L) }",
    "pub fn f(x : UInt64) -> Int { x.count_ones(1) }",
  ]
  let mut k = 0
  while k < bitops_bad.length() {
    let cr = check_source_files("p85_bitops_bad_" + k.to_string(), ["main.pion"], [bitops_bad[k]])
    assert_true(cr.diagnostics.length() > 0, "expected bitop type error for case " + k.to_string())
    k = k + 1
  }
}

///|
test "p91_data_ptr_temp_check" {
  let ok_src =
    #|let G_STR : String = "global"
    #|struct Inner { s : String, bs : Bytes, arr : Array[Int], fa : FixedArray[Int] }
    #|struct Outer { inner : Inner }
    #|pub fn ok_cases(s : String, bs : Bytes, arr : Array[Int], fa : FixedArray[Int], o : Outer) -> Ptr {
    #|  let loc = s + "!"
    #|  let _p1 : Ptr = str_data_ptr(s)
    #|  let _p2 : Ptr = str_data_ptr(loc)
    #|  let _p3 : Ptr = str_data_ptr("immortal")
    #|  let _p4 : Ptr = str_data_ptr(G_STR)
    #|  let _p5 : Ptr = str_data_ptr(o.inner.s)
    #|  let _p6 : Ptr = bytes_data_ptr(bs)
    #|  let _p7 : Ptr = bytes_data_ptr(o.inner.bs)
    #|  let _p8 : Ptr = array_data_ptr(arr)
    #|  let _p9 : Ptr = array_data_ptr(fa)
    #|  let _p10 : Ptr = fixed_array_data_ptr(fa)
    #|  let _p11 : Ptr = array_data_ptr(o.inner.arr)
    #|  fixed_array_data_ptr(o.inner.fa)
    #|}
  let (ok_r, ok_json, _) = check_one(ok_src)
  assert_true(ok_r, ok_json)

  let bad_cases : Array[String] = [
    "pub fn f(a : String, b : String) -> Ptr { str_data_ptr(a + b) }",
    "fn mk() -> String { \"x\" }\npub fn f() -> Ptr { str_data_ptr(mk()) }",
    "struct B { s : String }\nfn mk() -> B { B::{ s: \"x\" } }\npub fn f() -> Ptr { str_data_ptr(mk().s) }",
    "pub fn f(xs : Array[String]) -> Ptr { str_data_ptr(xs[0]) }",
    "pub fn f(n : Int) -> Ptr { str_data_ptr(\"v=\\{n}\") }",
    "fn mk() -> Bytes { Bytes::new(4) }\npub fn f() -> Ptr { bytes_data_ptr(mk()) }",
    "pub fn f(xs : Array[Bytes]) -> Ptr { bytes_data_ptr(xs[0]) }",
    "fn mk() -> Array[Int] { [1, 2] }\npub fn f() -> Ptr { array_data_ptr(mk()) }",
    "pub fn f(xs : Array[Array[Int]]) -> Ptr { array_data_ptr(xs[0]) }",
    "fn mk() -> FixedArray[Int] { FixedArray::make(2, 1) }\npub fn f() -> Ptr { fixed_array_data_ptr(mk()) }",
  ]
  let mut bi = 0
  while bi < bad_cases.length() {
    let (ok_b, json_b, _) = check_one(bad_cases[bi])
    assert_eq(ok_b, false)
    assert_true(json_b.contains("\"code\":\"E_TEMP_DATA_PTR\""), json_b)
    assert_true(json_b.contains("local variable"), json_b)
    bi = bi + 1
  }

  let arity_bad : Array[String] = [
    "pub fn f() -> Ptr { str_data_ptr() }",
    "pub fn f(s : String) -> Ptr { str_data_ptr(s, s) }",
    "pub fn f() -> Ptr { bytes_data_ptr() }",
    "pub fn f(b : Bytes) -> Ptr { bytes_data_ptr(b, b) }",
    "pub fn f() -> Ptr { array_data_ptr() }",
    "pub fn f(a : Array[Int]) -> Ptr { array_data_ptr(a, a) }",
    "pub fn f() -> Ptr { fixed_array_data_ptr() }",
    "pub fn f(a : FixedArray[Int]) -> Ptr { fixed_array_data_ptr(a, a) }",
  ]
  let mut ai = 0
  while ai < arity_bad.length() {
    let (ok_a, json_a, _) = check_one(arity_bad[ai])
    assert_eq(ok_a, false)
    assert_true(json_a.contains("\"code\":\"E_ARITY_MISMATCH\""), json_a)
    ai = ai + 1
  }
}

///|
test "j3_imm_array_typecheck_send_verify" {
  // Positive: constructors, literals, methods, val struct, Send, ==, #verify Copy
  let ok_src =
    #|#derive(Eq)
    #|val struct Bundle {
    #|  name : String
    #|  tags : ImmArray[String]
    #|}
    #|
    #|fn id_imm[T](xs : ImmArray[T]) -> ImmArray[T] { xs }
    #|fn eq_imm[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { a == b }
    #|
    #|pub fn ok_imm(w : World) -> Int {
    #|  let empty1 : ImmArray[Int] = ImmArray::new()
    #|  let empty2 : ImmArray[String] = []
    #|  let lit : ImmArray[Int] = [1, 2, 3]
    #|  let mk = ImmArray::make(3, "hi")
    #|  let a : Array[Int] = [10, 20]
    #|  let ia1 = ImmArray::from_array(a)
    #|  let ia2 = a.to_imm()
    #|  let mut b = ia1.to_array()
    #|  b.push(30)
    #|  let cp = lit.copy()
    #|  let _eq1 = lit == cp
    #|  let _eq2 = eq_imm(lit, cp)
    #|  let _eq3 = ia1 != ia2
    #|  let _id = id_imm(mk)
    #|  let bundle = Bundle::{ name: "b", tags: ["x", "y"] }
    #|  let ch : Channel[Bundle] = Channel::new(4)
    #|  let m : Mutex[ImmArray[String]] = Mutex::new(mk)
    #|  scope(w, fn(s : Scope) -> Unit {
    #|    spawn(s, fn() -> Unit {
    #|      ch.send(bundle)
    #|      let _ = m.with_lock(fn(xs : ImmArray[String]) -> Int { xs.length() })
    #|    })
    #|  })
    #|  let _ = ch.recv()
    #|  // ImmArray[Array[Int]] is constructible locally (just !Send)
    #|  let nested : ImmArray[Array[Int]] = [[1, 2]]
    #|  let mut sum = 0
    #|  for i, x in lit {
    #|    sum = sum + i + x
    #|  }
    #|  if empty1.is_empty() && empty2.is_empty() && nested.length() == 1 { sum } else { 0 }
    #|}
    #|
    #|#verify
    #|pub fn verify_imm_ok(xs : ImmArray[Int], ss : ImmArray[String]) -> Int {
    #|  let a = xs
    #|  let b = xs
    #|  let eq = a == b
    #|  let empty : ImmArray[Int] = ImmArray::new()
    #|  let made = ImmArray::make(2, 5)
    #|  let mut acc = 0
    #|  for v in made {
    #|    acc = acc + v
    #|  }
    #|  if eq && empty.is_empty() && ss.length() >= 0 { acc + a[0] } else { 0 }
    #|}
  let (ok_r, ok_json, _) = check_one(ok_src)
  assert_true(ok_r, ok_json)
  let ok_vj = p35_json(ok_src)
  assert_true(ok_vj.contains("\"ok\":true"), ok_vj)

  // Mutation, data_ptr, and implicit conversion rejections
  let bad_mut : Array[String] = [
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.push(1) }",
    "pub fn f(xs : ImmArray[Int]) -> Option[Int] { xs.pop() }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.set(0, 1) }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.clear() }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.reverse() }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.sort() }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs.swap(0, 1) }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs[0] = 1 }",
    "pub fn f(xs : ImmArray[Int]) -> Unit { xs[0] += 1 }",
    "fn bump(mut x : Int) -> Unit { x = x + 1 }\npub fn f(xs : ImmArray[Int]) -> Unit { bump(mut xs[0]) }",
    "pub fn f(xs : ImmArray[Int]) -> Ptr { array_data_ptr(xs) }",
    "pub fn f(xs : ImmArray[Int]) -> Ptr { fixed_array_data_ptr(xs) }",
    "pub fn f(xs : ImmArray[Int]) -> Array[Int] { xs }",
    "pub fn f(xs : Array[Int]) -> ImmArray[Int] { xs }",
  ]
  let mut mi = 0
  while mi < bad_mut.length() {
    let (ok_m, json_m, _) = check_one(bad_mut[mi])
    assert_true(!ok_m, "expected error for bad_mut[" + mi.to_string() + "]: " + json_m)
    assert_true(json_m.contains("\"ok\":false"), json_m)
    mi = mi + 1
  }

  // Send rejections: ImmArray[Array[Int]] and Mutex[ImmArray[Array[Int]]] MUST be E_NOT_SEND
  let bad_send : Array[String] = [
    "val struct BadVal { xs : ImmArray[Array[Int]] }",
    "pub fn f(w : World) -> Unit {\n  let xs : ImmArray[Array[Int]] = [[1]]\n  scope(w, fn(s : Scope) -> Unit { spawn(s, fn() -> Unit { let _ = xs.length() }) })\n}",
    "pub fn f() -> Unit {\n  let ch : Channel[ImmArray[Array[Int]]] = Channel::new(1)\n  let xs : ImmArray[Array[Int]] = [[1]]\n  ch.send(xs)\n}",
    "val struct BadMutexVal { m : Mutex[ImmArray[Array[Int]]] }",
    "pub fn f(w : World) -> Unit {\n  let xs : ImmArray[Array[Int]] = [[1]]\n  let m : Mutex[ImmArray[Array[Int]]] = Mutex::new(xs)\n  scope(w, fn(s : Scope) -> Unit { spawn(s, fn() -> Unit { let _ = m.with_lock(fn(v : ImmArray[Array[Int]]) -> Int { v.length() }) }) })\n}",
  ]
  let mut si = 0
  while si < bad_send.length() {
    let (ok_s, json_s, _) = check_one(bad_send[si])
    assert_true(!ok_s, "expected E_NOT_SEND for bad_send[" + si.to_string() + "]: " + json_s)
    assert_true(json_s.contains("\"code\":\"E_NOT_SEND\""), json_s)
    si = si + 1
  }

  // #verify rejections: ImmArray[Unique] and ImmArray[Forbidden]
  let bad_verify : Array[String] = [
    "#verify\npub fn f(xs : ImmArray[Array[Int]]) -> Int { xs.length() }",
    "#verify\npub fn f[T](xs : ImmArray[T]) -> Int { xs.length() }",
    "struct MutBox { mut x : Int }\n#verify\npub fn f(xs : ImmArray[MutBox]) -> Int { xs.length() }",
    "#verify\npub fn f(xs : ImmArray[Ptr]) -> Int { xs.length() }",
  ]
  let mut vi = 0
  while vi < bad_verify.length() {
    let json_v = p35_json(bad_verify[vi])
    assert_true(json_v.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "bad_verify[" + vi.to_string() + "]: " + json_v)
    vi = vi + 1
  }

  // Review item 1: Nested generic Wrap[Wrap[...]] cycle detection in Send & #verify
  let nested_send_bad1 =
    #|struct Wrap[T] { inner : T }
    #|pub fn f(w : World) -> Unit {
    #|  let xs : ImmArray[Wrap[Wrap[Array[Int]]]] = [Wrap::{ inner: Wrap::{ inner: [1] } }]
    #|  scope(w, fn(s : Scope) -> Unit { spawn(s, fn() -> Unit { let _ = xs.length() }) })
    #|}
  let (ok_ns1, json_ns1, _) = check_one(nested_send_bad1)
  assert_true(!ok_ns1 && json_ns1.contains("\"code\":\"E_NOT_SEND\""), json_ns1)

  let nested_send_bad2 =
    #|struct Wrap[T] { inner : T }
    #|pub fn f() -> Unit {
    #|  let ch : Channel[ImmArray[Wrap[Wrap[Array[Int]]]]] = Channel::new(1)
    #|  let xs : ImmArray[Wrap[Wrap[Array[Int]]]] = [Wrap::{ inner: Wrap::{ inner: [1] } }]
    #|  ch.send(xs)
    #|}
  let (ok_ns2, json_ns2, _) = check_one(nested_send_bad2)
  assert_true(!ok_ns2 && json_ns2.contains("\"code\":\"E_NOT_SEND\""), json_ns2)

  let nested_send_ok =
    #|struct Wrap[T] { inner : T }
    #|pub fn f(w : World) -> Unit {
    #|  let xs : ImmArray[Wrap[Wrap[Int]]] = [Wrap::{ inner: Wrap::{ inner: 42 } }]
    #|  let ch : Channel[ImmArray[Wrap[Wrap[Int]]]] = Channel::new(1)
    #|  scope(w, fn(s : Scope) -> Unit { spawn(s, fn() -> Unit { ch.send(xs) }) })
    #|}
  let (ok_ns3, json_ns3, _) = check_one(nested_send_ok)
  assert_true(ok_ns3, json_ns3)

  let nested_verify_bad =
    #|struct Wrap[T] { inner : T }
    #|#verify
    #|pub fn f(xs : ImmArray[Wrap[Wrap[Ptr]]]) -> Int { xs.length() }
  let json_nv = p35_json(nested_verify_bad)
  assert_true(json_nv.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_nv)

  // Review item 2: Strict arity checking for ImmArray type args, constructors, and methods
  let bad_arity : Array[String] = [
    "pub fn f() -> ImmArray[Int] { ImmArray::new(1) }",
    "pub fn f() -> ImmArray[Int] { ImmArray::make(1) }",
    "pub fn f() -> ImmArray[Int] { ImmArray::make(1, 2, 3) }",
    "pub fn f() -> ImmArray[Int] { ImmArray::from_array() }",
    "pub fn f(a : Array[Int]) -> ImmArray[Int] { ImmArray::from_array(a, a) }",
    "pub fn f(a : Array[Int]) -> ImmArray[Int] { a.to_imm(1) }",
    "pub fn f(xs : ImmArray[Int]) -> Int { xs.length(1) }",
    "pub fn f(xs : ImmArray[Int]) -> Bool { xs.is_empty(1) }",
    "pub fn f(xs : ImmArray[Int]) -> ImmArray[Int] { xs.copy(1) }",
    "pub fn f(xs : ImmArray[Int]) -> Array[Int] { xs.to_array(1) }",
    "pub fn f(xs : ImmArray[Int, Bool]) -> Int { 0 }",
  ]
  let mut ari = 0
  while ari < bad_arity.length() {
    let (ok_ar, json_ar, _) = check_one(bad_arity[ari])
    assert_true(!ok_ar && json_ar.contains("\"code\":\"E_ARITY_MISMATCH\""), "bad_arity[" + ari.to_string() + "]: " + json_ar)
    ari = ari + 1
  }

  // Review item 4: Generic == propagation through ImmArray[U] + >16 depth conservative reject
  let relay_eq_bad =
    #|fn equal[T](a : T, b : T) -> Bool { a == b }
    #|fn relay[U](a : ImmArray[U], b : ImmArray[U]) -> Bool { equal(a, b) }
    #|pub fn f() -> Bool {
    #|  let a : ImmArray[Map[String, Int]] = [Map::new()]
    #|  let b : ImmArray[Map[String, Int]] = [Map::new()]
    #|  relay(a, b)
    #|}
  let (ok_rb, json_rb, _) = check_one(relay_eq_bad)
  assert_true(!ok_rb && json_rb.contains("\"code\":\"E_TYPE_MISMATCH\""), json_rb)

  let relay_eq_ok =
    #|fn equal[T](a : T, b : T) -> Bool { a == b }
    #|fn relay[U](a : ImmArray[U], b : ImmArray[U]) -> Bool { equal(a, b) }
    #|pub fn f() -> Bool {
    #|  let a : ImmArray[Int] = [1, 2]
    #|  let b : ImmArray[Int] = [1, 2]
    #|  relay(a, b)
    #|}
  let (ok_ro, json_ro, _) = check_one(relay_eq_ok)
  assert_true(ok_ro, json_ro)

  // Deep nesting around non-comparable Map[String, Int] must be rejected
  let deep_eq_bad =
    #|pub fn f(
    #|  a : ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[Map[String, Int]]]]]]]]]]]]]]]]]],
    #|  b : ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[ImmArray[Map[String, Int]]]]]]]]]]]]]]]]]],
    #|) -> Bool {
    #|  a == b
    #|}
  let (ok_db, json_db, _) = check_one(deep_eq_bad)
  assert_true(!ok_db && json_db.contains("\"code\":\"E_TYPE_MISMATCH\""), json_db)

  // Review item 5: #verify rejects ==/!= on ImmArray[Double] and #derive(Eq) struct with Double
  let verify_dbl_eq1 =
    #|#verify
    #|pub fn f(xs : ImmArray[Double]) -> Bool { xs == xs }
  let json_vd1 = p35_json(verify_dbl_eq1)
  assert_true(json_vd1.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_vd1)

  let verify_dbl_eq2 =
    #|#derive(Eq)
    #|struct DBox { d : Double }
    #|#verify
    #|pub fn g(a : DBox, b : DBox) -> Bool { a == b }
  let json_vd2 = p35_json(verify_dbl_eq2)
  assert_true(json_vd2.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_vd2)

  // R2 item 2: #verify float equality through generic call & .contains
  let verify_gen_dbl_bad =
    #|#verify
    #|fn same[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|pub fn caller(x : ImmArray[Double]) -> Bool { same(x, x) }
  let json_vgd_bad = p35_json(verify_gen_dbl_bad)
  assert_true(json_vgd_bad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_vgd_bad)

  let verify_gen_int_ok =
    #|#verify
    #|fn same[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|pub fn caller(x : ImmArray[Int]) -> Bool { same(x, x) }
  let json_vgi_ok = p35_json(verify_gen_int_ok)
  assert_true(json_vgi_ok.contains("\"ok\":true"), json_vgi_ok)

  let verify_contains_dbl_bad =
    #|#verify
    #|pub fn has_d(xs : Array[ImmArray[Double]], target : ImmArray[Double]) -> Bool {
    #|  xs.contains(target)
    #|}
  let json_vcd_bad = p35_json(verify_contains_dbl_bad)
  assert_true(json_vcd_bad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_vcd_bad)

  // R2 item 3a: 20-deep outer-to-inner generic relay chain comparing ImmArray[T]
  let chain20_bad =
    #|fn r01[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r02(a, b) }
    #|fn r02[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r03(a, b) }
    #|fn r03[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r04(a, b) }
    #|fn r04[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r05(a, b) }
    #|fn r05[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r06(a, b) }
    #|fn r06[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r07(a, b) }
    #|fn r07[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r08(a, b) }
    #|fn r08[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r09(a, b) }
    #|fn r09[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r10(a, b) }
    #|fn r10[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r11(a, b) }
    #|fn r11[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r12(a, b) }
    #|fn r12[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r13(a, b) }
    #|fn r13[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r14(a, b) }
    #|fn r14[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r15(a, b) }
    #|fn r15[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r16(a, b) }
    #|fn r16[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r17(a, b) }
    #|fn r17[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r18(a, b) }
    #|fn r18[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r19(a, b) }
    #|fn r19[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { r20(a, b) }
    #|fn r20[T](a : ImmArray[T], b : ImmArray[T]) -> Bool { a == b }
    #|pub fn f() -> Bool {
    #|  let a : ImmArray[Map[String, Int]] = [Map::new()]
    #|  let b : ImmArray[Map[String, Int]] = [Map::new()]
    #|  r01(a, b)
    #|}
  let (ok_c20, json_c20, _) = check_one(chain20_bad)
  assert_true(!ok_c20 && json_c20.contains("\"code\":\"E_TYPE_MISMATCH\""), json_c20)

  // R2 item 3b: generic method comparing ImmArray[T] instantiated with non-Eq Map[String, Int]
  let gen_method_eq_bad =
    #|struct Cmp { id : Int }
    #|fn Cmp::eq_imm[T](self : Cmp, a : ImmArray[T], b : ImmArray[T]) -> Bool {
    #|  let _ = self.id
    #|  a == b
    #|}
    #|pub fn f() -> Bool {
    #|  let c = Cmp::{ id: 1 }
    #|  let a : ImmArray[Map[String, Int]] = [Map::new()]
    #|  let b : ImmArray[Map[String, Int]] = [Map::new()]
    #|  c.eq_imm(a, b)
    #|}
  let (ok_gm, json_gm, _) = check_one(gen_method_eq_bad)
  assert_true(!ok_gm && json_gm.contains("\"code\":\"E_TYPE_MISMATCH\""), json_gm)

  // R2 item 3c: phantom type param in #derive(Eq) struct Marker[T] { tag : Int }
  let phantom_eq_ok =
    #|#derive(Eq)
    #|struct Marker[T] { tag : Int }
    #|fn eq_markers[T](a : ImmArray[Marker[T]], b : ImmArray[Marker[T]]) -> Bool { a == b }
    #|pub fn f() -> Bool {
    #|  let a : ImmArray[Marker[Array[Int]]] = [Marker::{ tag: 1 }]
    #|  let b : ImmArray[Marker[Array[Int]]] = [Marker::{ tag: 1 }]
    #|  eq_markers(a, b)
    #|}
  let (ok_ph, json_ph, _) = check_one(phantom_eq_ok)
  assert_true(ok_ph, json_ph)

  // R4 item 2: Array/FixedArray .contains on Box[T] propagates T via collect_eq_tparams_in_ty
  let verify_arr_box_contains_bad =
    #|#derive(Eq)
    #|struct Box[T] { value : T }
    #|#verify
    #|fn has_arr[T](xs : Array[Box[T]], x : Box[T]) -> Bool { xs.contains(x) }
    #|#verify
    #|pub fn caller(xs : Array[Box[ImmArray[Double]]], x : Box[ImmArray[Double]]) -> Bool {
    #|  has_arr(xs, x)
    #|}
  let json_abc_bad = p35_json(verify_arr_box_contains_bad)
  assert_true(json_abc_bad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_abc_bad)

  let verify_farr_box_contains_bad =
    #|#derive(Eq)
    #|struct Box[T] { value : T }
    #|#verify
    #|fn has_farr[T](xs : FixedArray[Box[T]], x : Box[T]) -> Bool { xs.contains(x) }
    #|#verify
    #|pub fn caller(xs : FixedArray[Box[ImmArray[Double]]], x : Box[ImmArray[Double]]) -> Bool {
    #|  has_farr(xs, x)
    #|}
  let json_fbc_bad = p35_json(verify_farr_box_contains_bad)
  assert_true(json_fbc_bad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_fbc_bad)

  let verify_arr_box_contains_ok =
    #|#derive(Eq)
    #|struct Box[T] { value : T }
    #|#verify
    #|fn has_arr[T](xs : Array[Box[T]], x : Box[T]) -> Bool { xs.contains(x) }
    #|#verify
    #|pub fn caller(xs : Array[Box[Int]], x : Box[Int]) -> Bool {
    #|  has_arr(xs, x)
    #|}
  let json_abc_ok = p35_json(verify_arr_box_contains_ok)
  assert_true(json_abc_ok.contains("\"ok\":true"), json_abc_ok)

  let verify_phantom_contains_ok =
    #|#derive(Eq)
    #|struct Marker[T] { tag : Int }
    #|fn has_m[T](xs : Array[Marker[T]], x : Marker[T]) -> Bool { xs.contains(x) }
    #|pub fn caller(xs : Array[Marker[Array[Int]]], x : Marker[Array[Int]]) -> Bool {
    #|  has_m(xs, x)
    #|}
  let (ok_pm, json_pm, _) = check_one(verify_phantom_contains_ok)
  assert_true(ok_pm, json_pm)

  // R4 item 3: #verify_opaque generic callee skips #verify float-eq propagation error
  let verify_opaque_dbl_ok =
    #|#verify_opaque
    #|fn eq_any[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|pub fn caller(x : ImmArray[Double]) -> Bool { eq_any(x, x) }
  let json_vo_ok = p35_json(verify_opaque_dbl_ok)
  assert_true(json_vo_ok.contains("\"ok\":true"), json_vo_ok)

  // R5 item 2: Cross-package enum payload with shadowed local Box[T] qualifies imported fields
  let r5_lib_src =
    #|#derive(Eq)
    #|pub struct Box[T] { value : T }
    #|#derive(Eq)
    #|pub enum E[T] { Wrap(Box[T]) }
  let r5_lib_cr = check_source_files_with_imports("r5lib", ["lib.pion"], [r5_lib_src], [], true)
  assert_true(r5_lib_cr.diagnostics.length() == 0, check_result_to_json(r5_lib_cr.diagnostics))
  let r5_imp = [ImportedPkg::{ name: "r5lib", tc: r5_lib_cr.tc }]

  let r5_shadow_bad =
    #|import "r5lib"
    #|#derive(Eq)
    #|struct Box[T] { tag : Int }
    #|#verify
    #|fn has[T](xs : Array[r5lib::E[T]], x : r5lib::E[T]) -> Bool { xs.contains(x) }
    #|#verify
    #|pub fn caller(xs : Array[r5lib::E[ImmArray[Double]]], x : r5lib::E[ImmArray[Double]]) -> Bool {
    #|  has(xs, x)
    #|}
  let r5_bad_cr = check_source_files_with_imports("r5app", ["main.pion"], [r5_shadow_bad], r5_imp, true)
  let r5_bad_json = check_result_to_json(r5_bad_cr.diagnostics)
  assert_true(r5_bad_json.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), r5_bad_json)

  let r5_shadow_ok =
    #|import "r5lib"
    #|#derive(Eq)
    #|struct Box[T] { tag : Int }
    #|#verify
    #|fn has[T](xs : Array[r5lib::E[T]], x : r5lib::E[T]) -> Bool { xs.contains(x) }
    #|#verify
    #|pub fn caller(xs : Array[r5lib::E[Int]], x : r5lib::E[Int]) -> Bool {
    #|  has(xs, x)
    #|}
  let r5_ok_cr = check_source_files_with_imports("r5app", ["main.pion"], [r5_shadow_ok], r5_imp, true)
  assert_true(r5_ok_cr.diagnostics.length() == 0, check_result_to_json(r5_ok_cr.diagnostics))

  // R5 item 3: Multi-layer #verify_opaque relay stops verify float-eq propagation, keeps comparability
  let r5_relay_ok =
    #|#verify_opaque
    #|fn eq_any[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|fn relay[T](a : T, b : T) -> Bool { eq_any(a, b) }
    #|#verify
    #|pub fn caller(x : ImmArray[Double]) -> Bool { relay(x, x) }
  let json_r5_relay_ok = p35_json(r5_relay_ok)
  assert_true(json_r5_relay_ok.contains("\"ok\":true"), json_r5_relay_ok)

  let r5_relay_self_bad =
    #|#verify_opaque
    #|fn eq_any[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|fn relay_self[T](a : T, b : T) -> Bool { a == b && eq_any(a, b) }
    #|#verify
    #|pub fn caller(x : ImmArray[Double]) -> Bool { relay_self(x, x) }
  let json_r5_self_bad = p35_json(r5_relay_self_bad)
  assert_true(json_r5_self_bad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), json_r5_self_bad)

  let r5_relay_non_eq =
    #|#verify_opaque
    #|fn eq_any[T](a : T, b : T) -> Bool { a == b }
    #|#verify
    #|fn relay[T](a : T, b : T) -> Bool { eq_any(a, b) }
    #|pub fn caller(a : Map[String, Int], b : Map[String, Int]) -> Bool { relay(a, b) }
  let (ok_r5_neq, json_r5_neq, _) = check_one(r5_relay_non_eq)
  assert_true(!ok_r5_neq && json_r5_neq.contains("\"code\":\"E_TYPE_MISMATCH\""), json_r5_neq)
}

///|
fn anon_lit_expect_reject(src : String, msg : String) -> Unit {
  let (ok, json, diags) = check_one(src)
  assert_true(!ok, "anonymous struct literal must be rejected: " + src)
  let mut hit = false
  let mut i = 0
  while i < diags.length() {
    if diags[i].code == "E_TYPE_MISMATCH" && str_contains(diags[i].message, msg) {
      hit = true
    }
    i = i + 1
  }
  assert_true(hit, "expected E_TYPE_MISMATCH `" + msg + "`: " + json)
}

///|
test "negative: anonymous struct literal without struct context fails closed" {
  let infer = "cannot infer struct type for anonymous struct literal"
  anon_lit_expect_reject("pub fn f() -> Int {\n  let ln = { x: 1, y: 2 }\n  0\n}\n", infer)
  anon_lit_expect_reject(
    "pub fn f() -> Int {\n  let parts = []\n  parts.push({ x: 1, y: 2 })\n  parts.length()\n}\n",
    infer,
  )
  anon_lit_expect_reject("pub fn f() -> Int {\n  let x : Int = { x: 1, y: 2 }\n  x\n}\n", infer)
  anon_lit_expect_reject(
    "struct Pt { x : Int, y : Int }\npub fn f() -> Int {\n  let a = [{ x: 1, y: 2 }, Pt::{ x: 3, y: 4 }]\n  a.length()\n}\n",
    infer,
  )
  anon_lit_expect_reject(
    "fn id[T](v : T) -> T { v }\npub fn f() -> Int {\n  let _ = id({ x: 1, y: 2 })\n  0\n}\n",
    infer,
  )
  anon_lit_expect_reject(
    "pub fn f() -> Int {\n  let x = { ..42, x: 1 }\n  0\n}\n",
    "struct update base must be a struct type, found `Int`",
  )
  // `found Int`: the annotation is reported as the expected type.
  let (_, json_int, _) = check_one("pub fn f() -> Int {\n  let x : Int = { x: 1 }\n  x\n}\n")
  assert_true(str_contains(json_int, "\"expected\":\"Int\""), json_int)
  // A spread base that already failed is not reported a second time.
  let (ok_u, _, diags_u) = check_one("pub fn f() -> Int {\n  let x = { ..nope, x: 1 }\n  0\n}\n")
  assert_true(!ok_u, "undefined spread base rejected")
  assert_true(diags_u.length() == 1, "exactly one diagnostic for an undefined spread base")
  assert_true(str_contains(diags_u[0].message, "undefined identifier"), diags_u[0].message)
  // Field values are still checked.
  let (_, json_fv, _) = check_one("pub fn f() -> Int {\n  let p = { x: nope2 }\n  0\n}\n")
  assert_true(str_contains(json_fv, "undefined identifier `nope2`"), json_fv)
  assert_true(str_contains(json_fv, infer), json_fv)
}

///|
test "positive: anonymous struct literal in every struct-typed context" {
  let src =
    #|struct Pt { x : Int, y : Int }
    #|struct Outer { inner : Pt, opt : Option[Pt] }
    #|struct Box[T] { a : T, b : Int }
    #|struct Holder { mut p : Pt }
    #|enum Shape {
    #|  Dot(Pt)
    #|}
    #|let ORIGIN : Pt = { x: 7, y: 8 }
    #|fn Pt::add(self : Pt, o : Pt) -> Pt { { x: self.x + o.x, y: self.y + o.y } }
    #|fn mk() -> Pt { { x: 1, y: 2 } }
    #|fn mk_ret(c : Bool) -> Pt {
    #|  if c {
    #|    return { x: 3, y: 4 }
    #|  }
    #|  { x: 5, y: 6 }
    #|}
    #|fn wrap[T](v : T) -> Box[T] { { a: v, b: 1 } }
    #|fn take(p : Pt) -> Int { p.x + p.y }
    #|fn take_def(p : Pt = { x: 4, y: 2 }) -> Int { p.x }
    #|fn take_lbl(d~ : Pt) -> Int { d.x }
    #|pub fn f(c : Bool) -> Int {
    #|  let a : Pt = { x: 1, y: 2 }
    #|  let arr : Array[Pt] = [{ x: 1, y: 1 }]
    #|  arr.push({ x: 2, y: 3 })
    #|  arr[0] = { x: 0, y: 1 }
    #|  let arr3 = [Pt::{ x: 3, y: 3 }, { x: 4, y: 4 }]
    #|  let imm : ImmArray[Pt] = [{ x: 5, y: 5 }]
    #|  let m : Map[String, Pt] = Map([])
    #|  m.set("k", { x: 9, y: 1 })
    #|  let o : Option[Pt] = Some({ x: 1, y: 9 })
    #|  let r : Result[Pt, Int] = Ok({ x: 2, y: 8 })
    #|  let ip : Pt = if c { { x: 1, y: 0 } } else { { x: 0, y: 1 } }
    #|  let mp : Pt = match c {
    #|    true => { x: 2, y: 0 }
    #|    false => { x: 0, y: 2 }
    #|  }
    #|  let t : (Int, Pt) = (1, { x: 3, y: 1 })
    #|  let sp1 : Pt = { ..a, y: 6 }
    #|  let sp2 = { ..a, x: 9 }
    #|  let cl : () -> Pt = fn() -> Pt { { x: 6, y: 1 } }
    #|  let ou = Outer::{ inner: { x: 1, y: 3 }, opt: Some({ x: 2, y: 4 }) }
    #|  let bx : Box[Int] = { a: 41, b: 1 }
    #|  let bp : Box[Pt] = { a: { x: 1, y: 1 }, b: 2 }
    #|  let h = Holder::{ p: { x: 0, y: 0 } }
    #|  h.p = { x: 7, y: 7 }
    #|  let s = Dot({ x: 1, y: 2 })
    #|  take(a) + take(arr[0]) + arr3.length() + imm.length() + take(ip) + take(mp) + take(t.1) +
    #|    take(sp1) + take(sp2) + take(cl()) + take(ou.inner) + bx.a + take(bp.a) + take(h.p) +
    #|    take(mk()) + take(mk_ret(c)) + wrap(1).a + take_def() + take_lbl(d={ x: 1, y: 1 }) +
    #|    take({ x: 8, y: 2 }) + take(a.add({ x: 1, y: 1 })) + take(ORIGIN) + m.length() +
    #|    (match o { Some(p) => p.x
    #|      None => 0 }) + (match r { Ok(p) => p.x
    #|      Err(e) => e }) + (match s { Dot(p) => p.y })
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, "legal anonymous struct literal contexts must check clean: " + json)
}

///|
test "wave_l0: nested tuple patterns, Array is_empty/truncate, Double methods/hash, Int lnot" {
  let ok_src =
    #|struct Pair { x : Double, y : Int }
    #|pub fn test_nested_pat(
    #|  o : Option[(Int, String)],
    #|  r : Result[(Int, (Int, String)), String],
    #|  p : (Option[(Int, Int)], Option[Int]),
    #|) -> Int {
    #|  let a = match o {
    #|    Some((1, s)) => s.length()
    #|    Some((k, _)) if k > 0 => k
    #|    Some((_, s)) => s.length()
    #|    None => 0
    #|  }
    #|  let b = match r {
    #|    Ok((x, (y, z))) => x + y + z.length()
    #|    Err(e) => e.length()
    #|  }
    #|  let c = match p {
    #|    (Some((x, y)), None) => x + y
    #|    _ => 0
    #|  }
    #|  let d = if let Some((x, s)) = o && x > 0 { x + s.length() } else if let Some((x, s)) = o && x <= 0 { s.length() } else { 0 }
    #|  let mut acc = 0
    #|  let mut cur : Option[(Int, Int)] = Some((3, 4))
    #|  while let Some((x, y)) = cur && x > 0 {
    #|    acc = acc + x + y
    #|    cur = None
    #|  }
    #|  let t = match (1, 2) {
    #|    (u, v) => u + v
    #|  }
    #|  a + b + c + d + acc + t
    #|}
    #|pub fn test_stdlib(d : Double, e : Double, n : Int, n64 : Int64, u : UInt, u64 : UInt64) -> Int {
    #|  let arr : Array[Int] = [1, 2, 3]
    #|  arr.truncate(2)
    #|  let empty = arr.is_empty()
    #|  let nan = d.is_nan()
    #|  let cmp = d.compare(e)
    #|  let bits : Int64 = d.reinterpret_as_int64()
    #|  let m : Map[Double, Int] = Map([])
    #|  m.set(-0.0, 1)
    #|  let pm : Map[Pair, Int] = Map([])
    #|  pm.set(Pair::{ x: -0.0, y: 1 }, 2)
    #|  let i1 : Int = n.lnot()
    #|  let i2 : Int64 = n64.lnot()
    #|  let u1 : UInt = u.lnot()
    #|  let u2 : UInt64 = u64.lnot()
    #|  if empty || nan { 0 } else { cmp + i1 + bits.to_int() + i2.to_int() + u1.to_int() + u2.to_int() + m.length() + pm.length() }
    #|}
  let (ok, json, _) = check_one(ok_src)
  assert_true(ok, "Wave L0 valid code must check clean: " + json)

  // Negative checks: arity/type errors, variant pattern arity, and non-exhaustive refutable nested patterns
  let bad_cases : Array[String] = [
    "pub fn f(xs : Array[Int]) -> Bool { xs.is_empty(1) }",
    "pub fn f(xs : Array[Int]) -> Unit { xs.truncate() }",
    "pub fn f(xs : Array[Int]) -> Unit { xs.truncate(\"2\") }",
    "pub fn f(d : Double) -> Bool { d.is_nan(1.0) }",
    "pub fn f(d : Double) -> Int { d.compare() }",
    "pub fn f(d : Double) -> Int { d.compare(1) }",
    "pub fn f(d : Double) -> Int64 { d.reinterpret_as_int64(1) }",
    "pub fn f(x : Int) -> Int { x.lnot(1) }",
    "pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((a, b)) => a + b } }",
    "pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((1, b)) => b\n None => 0 } }",
    "pub fn f(r : Result[(Int, Option[Int]), Int]) -> Int { match r { Ok((a, Some(b))) => a + b\n Err(e) => e } }",
    "pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((a, b, c)) => a + b + c\n None => 0 } }",
    "pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((a, b), 9) => a + b\n None => 0 } }",
    "pub fn f(o : Option[Int]) -> Int { match o { Some(a) => a\n None(1) => 0 } }",
  ]
  let mut i = 0
  while i < bad_cases.length() {
    let (ok_b, json_b, _) = check_one(bad_cases[i])
    assert_true(!ok_b, "expected error for bad_cases[" + i.to_string() + "]: " + json_b)
    i = i + 1
  }
  // Specific error code assertions for Wave L0 R2 review items
  let (_, j_ne1, _) = check_one("pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((1, b)) => b\n None => 0 } }")
  assert_true(j_ne1.contains("\"code\":\"E_NON_EXHAUSTIVE\""), j_ne1)
  let (_, j_ne2, _) = check_one("pub fn f(r : Result[(Int, Option[Int]), Int]) -> Int { match r { Ok((a, Some(b))) => a + b\n Err(e) => e } }")
  assert_true(j_ne2.contains("\"code\":\"E_NON_EXHAUSTIVE\""), j_ne2)
  let (_, j_ar, _) = check_one("pub fn f(o : Option[(Int, Int)]) -> Int { match o { Some((a, b), 9) => a + b\n None => 0 } }")
  assert_true(j_ar.contains("\"code\":\"E_TYPE_MISMATCH\""), j_ar)

  // #verify must reject Map keys containing Double or Float (standalone or composite)
  let bad_verify_maps : Array[String] = [
    "#verify\npub fn f(m : Map[Double, Int]) -> Int { m.length() }",
    "#verify\npub fn f(m : Map[(Int, Double), Int]) -> Int { m.length() }",
    "struct DKey { x : Double, y : Int }\n#verify\npub fn f(m : Map[DKey, Int]) -> Int { m.length() }",
  ]
  let mut vi = 0
  while vi < bad_verify_maps.length() {
    let vj = p35_json(bad_verify_maps[vi])
    assert_true(vj.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "bad_verify_maps[" + vi.to_string() + "]: " + vj)
    vi = vi + 1
  }

  // Wave L0 R3: Maranget multi-column pattern matrix exhaustiveness
  let ok_maranget =
    #|enum Two { Pair(Bool, Option[Int]) }
    #|pub fn f_bool2(a : Bool, b : Bool) -> Int {
    #|  match (a, b) {
    #|    (true, _) => 1
    #|    (false, true) => 2
    #|    (false, false) => 3
    #|  }
    #|}
    #|pub fn f_two(t : Two) -> Int {
    #|  match t {
    #|    Two::Pair(true, _) => 1
    #|    Two::Pair(false, Some(x)) => x
    #|    Two::Pair(false, None) => 0
    #|  }
    #|}
  let (ok_m, json_m, _) = check_one(ok_maranget)
  assert_true(ok_m, "Maranget multi-column exhaustive match must pass: " + json_m)

  let (_, j_m1, _) = check_one("pub fn f(a : Bool, b : Bool) -> Int { match (a, b) { (true, _) => 1\n (false, true) => 2 } }")
  assert_true(j_m1.contains("\"code\":\"E_NON_EXHAUSTIVE\""), j_m1)
  let (_, j_m2, _) = check_one("enum Two { Pair(Bool, Option[Int]) }\npub fn f(t : Two) -> Int { match t { Two::Pair(true, _) => 1\n Two::Pair(false, Some(x)) => x } }")
  assert_true(j_m2.contains("\"code\":\"E_NON_EXHAUSTIVE\""), j_m2)

  // Wave L0 R3: unparenthesized `|>` pipe in `if let` / `while let`
  let ok_pipe_let =
    #|fn wrap(n : Int) -> Option[Int] { if n > 0 { Some(n) } else { None } }
    #|fn step(n : Int) -> Option[Int] { if n > 0 { Some(n - 1) } else { None } }
    #|pub fn f_pipe(n : Int) -> Int {
    #|  let a = if let Some(x) = n |> wrap { x } else { 0 }
    #|  let b = if let Some(x) = n |> wrap && x > 1 { x } else { 0 }
    #|  let c = if let Some(x) = (n |> wrap) && x > 2 { x } else { 0 }
    #|  let mut cur = n
    #|  let mut acc = 0
    #|  while let Some(x) = cur |> step && x > 0 {
    #|    acc = acc + x
    #|    cur = x
    #|  }
    #|  a + b + c + acc
    #|}
  let (ok_pl, json_pl, _) = check_one(ok_pipe_let)
  assert_true(ok_pl, "if let / while let with |> pipe must check clean: " + json_pl)

  // Wave L0 R3: #verify generic Map[K, V] float key cross-callsite propagation
  let v_gen_bad1 =
    #|#verify
    #|pub fn probe[K](k : K) -> Bool {
    #|  let m : Map[K, Int] = Map::new()
    #|  m.contains(k)
    #|}
    #|#verify
    #|pub fn caller(d : Double) -> Bool {
    #|  probe(d)
    #|}
  let vj_gb1 = p35_json(v_gen_bad1)
  assert_true(vj_gb1.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), vj_gb1)

  let v_gen_bad2 =
    #|#verify
    #|pub fn probe[K](k : K) -> Bool {
    #|  let m : Map[K, Int] = Map::new()
    #|  m.contains(k)
    #|}
    #|#verify
    #|pub fn wrap[T](x : T) -> Bool {
    #|  probe(x)
    #|}
    #|#verify
    #|pub fn caller(d : Double) -> Bool {
    #|  wrap(d)
    #|}
  let vj_gb2 = p35_json(v_gen_bad2)
  assert_true(vj_gb2.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), vj_gb2)

  let v_gen_ok =
    #|#verify
    #|pub fn probe[K](k : K) -> Bool {
    #|  let m : Map[K, Int] = Map::new()
    #|  m.contains(k)
    #|}
    #|#verify
    #|pub fn wrap[T](x : T) -> Bool {
    #|  probe(x)
    #|}
    #|#verify
    #|pub fn caller(n : Int) -> Bool {
    #|  probe(n) && wrap(n) && probe((1, 2)) && wrap((1, 2))
    #|}
  let vj_gok = p35_json(v_gen_ok)
  assert_true(vj_gok.contains("\"ok\":true"), vj_gok)

  // Wave L0 R4/R5: 12-column Bool Maranget heuristic adversarial test (first 11 arms also constrain col 11,
  // triggering 2^11 branching without max-refutable-column selection).
  let mat12_ok =
    #|pub fn f12(t : (Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)) -> Int {
    #|  match t {
    #|    (true, _, _, _, _, _, _, _, _, _, _, true) => 1
    #|    (_, true, _, _, _, _, _, _, _, _, _, true) => 2
    #|    (_, _, true, _, _, _, _, _, _, _, _, true) => 3
    #|    (_, _, _, true, _, _, _, _, _, _, _, true) => 4
    #|    (_, _, _, _, true, _, _, _, _, _, _, true) => 5
    #|    (_, _, _, _, _, true, _, _, _, _, _, true) => 6
    #|    (_, _, _, _, _, _, true, _, _, _, _, true) => 7
    #|    (_, _, _, _, _, _, _, true, _, _, _, true) => 8
    #|    (_, _, _, _, _, _, _, _, true, _, _, true) => 9
    #|    (_, _, _, _, _, _, _, _, _, true, _, true) => 10
    #|    (_, _, _, _, _, _, _, _, _, _, true, true) => 11
    #|    (_, _, _, _, _, _, _, _, _, _, _, true) => 12
    #|    (_, _, _, _, _, _, _, _, _, _, _, false) => 13
    #|  }
    #|}
  let (ok_m12, json_m12, _) = check_one(mat12_ok)
  assert_true(ok_m12, "12-col Bool adversarial matrix must be exhaustive in ms: " + json_m12)

  let mat12_bad =
    #|pub fn f12_bad(t : (Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool, Bool)) -> Int {
    #|  match t {
    #|    (true, _, _, _, _, _, _, _, _, _, _, true) => 1
    #|    (_, true, _, _, _, _, _, _, _, _, _, true) => 2
    #|    (_, _, true, _, _, _, _, _, _, _, _, true) => 3
    #|    (_, _, _, true, _, _, _, _, _, _, _, true) => 4
    #|    (_, _, _, _, true, _, _, _, _, _, _, true) => 5
    #|    (_, _, _, _, _, true, _, _, _, _, _, true) => 6
    #|    (_, _, _, _, _, _, true, _, _, _, _, true) => 7
    #|    (_, _, _, _, _, _, _, true, _, _, _, true) => 8
    #|    (_, _, _, _, _, _, _, _, true, _, _, true) => 9
    #|    (_, _, _, _, _, _, _, _, _, true, _, true) => 10
    #|    (_, _, _, _, _, _, _, _, _, _, true, true) => 11
    #|    (_, _, _, _, _, _, _, _, _, _, _, true) => 12
    #|  }
    #|}
  let (ok_m12b, json_m12b, _) = check_one(mat12_bad)
  assert_true(!ok_m12b && json_m12b.contains("E_NON_EXHAUSTIVE"), json_m12b)
}

///|
test "xpkg qualify_fn_info bounds: methods, static methods, generic fn-values, no_io preservation & alias isolation" {
  let dep_src =
    "pub trait ViewEq { fn view_eq(self : Self, other : Self) -> Bool }\n" +
    "impl ViewEq for Int { fn view_eq(self : Int, other : Int) -> Bool { self == other } }\n" +
    "pub struct View { v : Int }\n" +
    "#no_io\n" +
    "pub fn View::memo[T : ViewEq](self : View, a : T, b : T) -> Int { if a.view_eq(b) { self.v } else { 0 } }\n" +
    "pub fn View::each[K : ViewEq](a : K, b : K) -> Int { if a.view_eq(b) { 1 } else { 0 } }\n" +
    "#no_io\n" +
    "pub fn check_eq[T : ViewEq](a : T, b : T) -> Bool { a.view_eq(b) }\n"
  let dep_cr = check_source_files_with_imports("dep", ["dep.pion"], [dep_src], [], true)
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))

  let decoy_src =
    "pub trait ViewEq { fn view_eq(self : Self, other : Self) -> Bool }\n" +
    "pub fn noop() -> Int { 0 }\n"
  let decoy_cr = check_source_files_with_imports("decoy", ["decoy.pion"], [decoy_src], [], true)
  assert_true(decoy_cr.diagnostics.length() == 0, check_result_to_json(decoy_cr.diagnostics))

  let imported = [
    imported_pkg_new("dep", dep_cr.tc),
    imported_pkg_new("decoy", decoy_cr.tc),
  ]

  // Positive: instance method, static method, generic fn-values, generic caller bound forwarding,
  // `#no_io` preserved across qualified `type_bounds`, and caller `import "decoy" as dep` cannot hijack `@canon:dep::ViewEq`.
  let ok_app =
    "import \"dep\" as v\n" +
    "import \"decoy\" as dep\n" +
    "#no_io\n" +
    "fn render_step[U : v::ViewEq](vw : v::View, x : U, y : U) -> Int {\n" +
    "  let _ = v::check_eq(x, y)\n" +
    "  vw.memo(x, y)\n" +
    "}\n" +
    "pub fn run() -> Int {\n" +
    "  let _ = dep::noop()\n" +
    "  let vw = v::View::{ v: 7 }\n" +
    "  let f : (Int, Int) -> Int = v::View::each\n" +
    "  let g : (Int, Int) -> Bool = v::check_eq\n" +
    "  let r1 = vw.memo(3, 3)\n" +
    "  let r2 = v::View::each(4, 4)\n" +
    "  let r3 = f(5, 5)\n" +
    "  let r4 = if g(6, 6) { 1 } else { 0 }\n" +
    "  let r5 = render_step(vw, 8, 8)\n" +
    "  r1 + r2 + r3 + r4 + r5\n" +
    "}\n"
  let ok_cr = check_source_files_with_imports("app", ["app.pion"], [ok_app], imported, true)
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  // Negative 1: unsatisfied instance method bound
  let bad_meth =
    "import \"dep\" as v\n" +
    "pub fn bad() -> Int { let vw = v::View::{ v: 1 }; vw.memo(\"a\", \"b\") }\n"
  let bm_cr = check_source_files_with_imports("app_bm", ["app.pion"], [bad_meth], imported, true)
  assert_true(
    bm_cr.diagnostics.length() >= 1 && bm_cr.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED",
    check_result_to_json(bm_cr.diagnostics),
  )

  // Negative 2: unsatisfied static method generic fn-value bound
  let bad_fnval =
    "import \"dep\" as v\n" +
    "pub fn bad() -> Int { let f : (String, String) -> Int = v::View::each; f(\"a\", \"b\") }\n"
  let bf_cr = check_source_files_with_imports("app_bf", ["app.pion"], [bad_fnval], imported, true)
  assert_true(
    bf_cr.diagnostics.length() >= 1 && bf_cr.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED",
    check_result_to_json(bf_cr.diagnostics),
  )

  // Verify `qualify_fn_info` preserves `no_io` on imported bounded methods/fns (regression for old `qualify_fn_bounds` `no_io: false`)
  match ok_cr.tc.methods.get("dep::View::memo") {
    Some(mi) => assert_true(mi.decl.no_io, "expected dep::View::memo to preserve no_io=true")
    None => assert_true(false, "expected dep::View::memo in ok_cr.tc.methods")
  }
  match ok_cr.tc.methods.get("dep::View::each") {
    Some(mi) => assert_true(!mi.decl.no_io, "expected dep::View::each to preserve no_io=false")
    None => assert_true(false, "expected dep::View::each in ok_cr.tc.methods")
  }
  match dep_cr.tc.fns.get("check_eq") {
    Some(fi) => {
      let qfi = qualify_fn_info(imported[0], fi)
      assert_true(qfi.decl.no_io, "expected qualify_fn_info(dep::check_eq) to preserve no_io=true")
    }
    None => assert_true(false, "expected dep::check_eq in dep_cr.tc.fns")
  }

  // Transitive 3-package check (`app -> mid -> dep`) with aliased import in `mid` and decoy alias in `app`
  let mid_src =
    "import \"dep\" as d\n" +
    "pub struct Wrapper { n : Int }\n" +
    "pub fn Wrapper::wrap[T : d::ViewEq](self : Wrapper, a : T, b : T) -> Int { if d::check_eq(a, b) { self.n } else { 0 } }\n"
  let mid_cr = check_source_files_with_imports("mid", ["mid.pion"], [mid_src], [imported[0]], true)
  assert_true(mid_cr.diagnostics.length() == 0, check_result_to_json(mid_cr.diagnostics))
  let app3_src =
    "import \"mid\" as m\n" +
    "import \"decoy\" as dep\n" +
    "pub fn run() -> Int {\n" +
    "  let _ = dep::noop()\n" +
    "  let w = m::Wrapper::{ n: 9 }\n" +
    "  w.wrap(1, 1)\n" +
    "}\n"
  let app3_cr = check_source_files_with_imports(
    "app3",
    ["app3.pion"],
    [app3_src],
    [imported_pkg_new("mid", mid_cr.tc), imported[1]],
    true,
  )
  assert_true(app3_cr.diagnostics.length() == 0, check_result_to_json(app3_cr.diagnostics))
}

///|
test "j1.2: guard else control-flow divergence check (E_GUARD_ELSE_NOT_DIVERGE)" {
  let good_cases : Array[String] = [
    // Direct return + unreachable trailing statement
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    return 0\n    let _ = 1\n  }\n  x\n}\n",
    // panic / abort
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    panic(\"bad\")\n  }\n  x\n}\n",
    // Enclosing loop break / continue
    "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  let mut i = 0\n  while i < n {\n    i = i + 1\n    guard i != 3 else { continue }\n    guard i != 5 else { break }\n    s = s + i\n  }\n  s\n}\n",
    // All-branch diverging if/else
    "pub fn f(x : Int, flag : Bool) -> Int {\n  guard x > 0 else {\n    if flag { return 1 } else { panic(\"no\") }\n  }\n  x\n}\n",
    // Exhaustive all-arm diverging match
    "enum E { A, B }\npub fn f(x : Int, e : E) -> Int {\n  guard x > 0 else {\n    match e {\n      A => return 1\n      B => return 2\n    }\n  }\n  x\n}\n",
    // while true with no reachable break (including inner-loop break and unreachable break after return)
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    while true {\n      while false { break }\n    }\n  }\n  x\n}\n",
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    while true {\n      return 0\n      break\n    }\n  }\n  x\n}\n",
  ]
  let mut gi = 0
  while gi < good_cases.length() {
    let (ok, json, _) = check_one(good_cases[gi])
    assert_true(ok, "expected valid guard case #" + gi.to_string() + ": " + json)
    gi = gi + 1
  }

  let bad_cases : Array[String] = [
    // Falls through empty / expression block
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    let _ = 1\n  }\n  x\n}\n",
    // Return inside closure does NOT diverge outer guard else
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    let _ = fn() -> Int { return 1 }\n  }\n  x\n}\n",
    // Break inside nested loop does NOT diverge outer guard else
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    while x < 0 { break }\n  }\n  x\n}\n",
    // Single-arm if can fall through
    "pub fn f(x : Int, flag : Bool) -> Int {\n  guard x > 0 else {\n    if flag { return 1 }\n  }\n  x\n}\n",
    // if/else where one branch falls through
    "pub fn f(x : Int, flag : Bool) -> Int {\n  guard x > 0 else {\n    if flag { return 1 } else { let _ = 2 }\n  }\n  x\n}\n",
    // match where one arm falls through
    "enum E { A, B }\npub fn f(x : Int, e : E) -> Int {\n  guard x > 0 else {\n    match e {\n      A => return 1\n      B => { let _ = 2 }\n    }\n  }\n  x\n}\n",
    // while true with reachable break can fall through
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    while true { break }\n  }\n  x\n}\n",
  ]
  let mut bi = 0
  while bi < bad_cases.length() {
    let (ok, json, diags) = check_one(bad_cases[bi])
    assert_eq(ok, false)
    assert_true(
      diags.length() == 1 && diags[0].code == "E_GUARD_ELSE_NOT_DIVERGE",
      "expected E_GUARD_ELSE_NOT_DIVERGE on bad case #" + bi.to_string() + ": " + json,
    )
    // Advisory fix-it only, no semantic-changing machine edit
    assert_eq(diags[0].edits.length(), 0)
    bi = bi + 1
  }

  // break / continue outside any loop (also inside a closure inside a loop)
  // are rejected themselves, which suppresses the cascading guard diagnostic.
  let outside_cases : Array[(String, String)] = [
    ("pub fn f(x : Int) -> Int {\n  guard x > 0 else { break }\n  x\n}\n", "break"),
    ("pub fn f(x : Int) -> Int {\n  guard x > 0 else { continue }\n  x\n}\n", "continue"),
    (
      "pub fn f(x : Int) -> Int {\n  let mut i = 0\n  while i < 1 {\n    let _ = fn(y : Int) -> Int {\n      guard y > 0 else { break }\n      y\n    }\n    i = i + 1\n  }\n  x\n}\n",
      "break",
    ),
  ]
  let mut oi = 0
  while oi < outside_cases.length() {
    let (src, kw) = outside_cases[oi]
    let (ok, json, diags) = check_one(src)
    assert_eq(ok, false)
    assert_true(
      diags.length() == 1 && diags[0].code == "E_TYPE_MISMATCH" &&
      diags[0].message == "cannot use `" + kw + "` outside a loop",
      "expected `" + kw + "` outside a loop on case #" + oi.to_string() + ": " + json,
    )
    oi = oi + 1
  }

  // TError inside else body suppresses cascading E_GUARD_ELSE_NOT_DIVERGE
  let (ok_err, json_err, _) = check_one(
    "pub fn f(x : Int) -> Int {\n  guard x > 0 else {\n    let _ = undefined_sym\n  }\n  x\n}\n",
  )
  assert_eq(ok_err, false)
  assert_true(!json_err.contains("E_GUARD_ELSE_NOT_DIVERGE"), json_err)
}

///|
test "j1.3: cross-package generic method trait bounds qualified (cold source & hot stub) and no_io preserved" {
  let lib_src =
    #|pub trait K {
    #|  score(self : Self) -> Int
    #|}
    #|pub struct M {
    #|  tag : Int
    #|}
    #|#no_io
    #|pub fn M::make[A : K, B](a : A, _b : B) -> Int {
    #|  a.score()
    #|}
    #|pub fn M::use_it[A : K](self : M, a : A) -> Int {
    #|  self.tag + a.score()
    #|}
    #|pub fn fn_k[A : K](a : A) -> Int {
    #|  a.score()
    #|}
    #|pub struct OkItem {
    #|  n : Int
    #|}
    #|impl K for OkItem {
    #|  fn score(self : OkItem) -> Int { self.n }
    #|}
  let lib_cr = check_source_files_with_imports("libk", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))

  // Also test hot .pionstub path (parse stub of a non-generic wrapper + direct libk tc)
  let stub_text = emit_file_stub(lib_cr.pkg.files[0])
  let stub_cr = check_source_files_with_imports("libk", ["lib.pion"], [stub_text], [], true)
  assert_true(stub_cr.diagnostics.length() == 0, check_result_to_json(stub_cr.diagnostics))

  // Caller defines its OWN same-named trait K, plus a type with libk::K and one without
  let app_ok =
    #|import "libk" as l
    #|pub trait K {
    #|  other(self : Self) -> Int
    #|}
    #|pub struct LocalGood {
    #|  v : Int
    #|}
    #|impl l::K for LocalGood {
    #|  fn score(self : LocalGood) -> Int { self.v }
    #|}
    #|pub fn run() -> Int {
    #|  let g = LocalGood::{ v: 10 }
    #|  let m = l::M::{ tag: 5 }
    #|  l::M::make(g, 1) + m.use_it(g) + l::fn_k(g)
    #|}
  let app_bad =
    #|import "libk" as l
    #|pub trait K {
    #|  score(self : Self) -> Int
    #|}
    #|pub struct LocalBad {
    #|  v : Int
    #|}
    #|impl K for LocalBad {
    #|  fn score(self : LocalBad) -> Int { self.v }
    #|}
    #|pub fn run() -> Int {
    #|  let b = LocalBad::{ v: 10 }
    #|  let m = l::M::{ tag: 5 }
    #|  l::M::make(b, 1) + m.use_it(b) + l::fn_k(b)
    #|}

  // Cold source path
  let ok_cold = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_ok],
    [imported_pkg_new("libk", lib_cr.tc)],
    true,
  )
  assert_true(ok_cold.diagnostics.length() == 0, check_result_to_json(ok_cold.diagnostics))
  let bad_cold = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_bad],
    [imported_pkg_new("libk", lib_cr.tc)],
    true,
  )
  assert_true(
    bad_cold.diagnostics.length() == 3 &&
    bad_cold.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED" &&
    bad_cold.diagnostics[1].code == "E_TRAIT_NOT_IMPLEMENTED" &&
    bad_cold.diagnostics[2].code == "E_TRAIT_NOT_IMPLEMENTED",
    check_result_to_json(bad_cold.diagnostics),
  )

  // Hot stub path
  let ok_hot = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_ok],
    [imported_pkg_new("libk", stub_cr.tc)],
    true,
  )
  assert_true(ok_hot.diagnostics.length() == 0, check_result_to_json(ok_hot.diagnostics))
  let bad_hot = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_bad],
    [imported_pkg_new("libk", stub_cr.tc)],
    true,
  )
  assert_true(
    bad_hot.diagnostics.length() == 3 &&
    bad_hot.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED",
    check_result_to_json(bad_hot.diagnostics),
  )

  // Verify `no_io` metadata is preserved by qualify_fn_info
  match lib_cr.tc.methods.get("M::make") {
    Some(mi) => {
      let qmi = qualify_fn_info(imported_pkg_new("libk", lib_cr.tc), mi)
      assert_eq(qmi.decl.no_io, true)
    }
    None => assert_true(false, "M::make missing")
  }
}

///|
test "j1.5: top-level let topological init plan, E_CONST_CYCLE, recursion & hot CAS invalidation" {
  // 1. Same-file forward indirect reference
  let fwd_src =
    #|let A : Int = get_b() + 1
    #|fn get_b() -> Int { B }
    #|let B : Int = 41
    #|pub fn main() -> Int { A }
  let fwd_cr = check_source_files_full("fwd", ["fwd.pion"], [fwd_src])
  assert_true(fwd_cr.diagnostics.length() == 0, check_result_to_json(fwd_cr.diagnostics))
  assert_eq(fwd_cr.tc.const_init_order.length(), 2)
  assert_eq(fwd_cr.tc.const_init_order[0], "B")
  assert_eq(fwd_cr.tc.const_init_order[1], "A")

  // 2. Cross-file interleaved deps: A (unit0) -> B (unit1) -> C (unit0)
  let u0 =
    #|let A : Int = get_b() + 1
    #|let C : Int = 10
    #|pub fn main() -> Int { A }
  let u1 =
    #|let B : Int = C + 5
    #|fn get_b() -> Int { B }
  let xfile_cr = check_source_files_full("xfile", ["u0.pion", "u1.pion"], [u0, u1])
  assert_true(xfile_cr.diagnostics.length() == 0, check_result_to_json(xfile_cr.diagnostics))
  assert_eq(xfile_cr.tc.const_init_order.length(), 3)
  assert_eq(xfile_cr.tc.const_init_order[0], "C")
  assert_eq(xfile_cr.tc.const_init_order[1], "B")
  assert_eq(xfile_cr.tc.const_init_order[2], "A")

  // 3. True cycle reports E_CONST_CYCLE with full cycle chain
  let cyc_src =
    #|let A : Int = get_b()
    #|fn get_b() -> Int { B }
    #|let B : Int = A + 1
    #|pub fn main() -> Int { A }
  let cyc_cr = check_source_files_full("cyc", ["cyc.pion"], [cyc_src])
  assert_true(
    cyc_cr.diagnostics.length() >= 1 &&
    cyc_cr.diagnostics[0].code == "E_CONST_CYCLE" &&
    cyc_cr.diagnostics[0].message.contains("->"),
    check_result_to_json(cyc_cr.diagnostics),
  )

  // 4. Legal recursive function in const init is NOT a cycle
  let rec_src =
    #|fn fact(n : Int) -> Int {
    #|  if n <= 1 { 1 } else { n * fact(n - 1) }
    #|}
    #|let F5 : Int = fact(5)
    #|pub fn main() -> Int { F5 }
  let rec_cr = check_source_files_full("rec", ["rec.pion"], [rec_src])
  assert_true(rec_cr.diagnostics.length() == 0, check_result_to_json(rec_cr.diagnostics))

  // 4b. Forward call to top-level closure `let` binding records dependency on the closure const
  let clo_src =
    #|let A : Int = F()
    #|let F : () -> Int = fn() -> Int { 42 }
    #|pub fn main() -> Int { A }
  let clo_cr = check_source_files_full("clo", ["clo.pion"], [clo_src])
  assert_true(clo_cr.diagnostics.length() == 0, check_result_to_json(clo_cr.diagnostics))
  assert_eq(clo_cr.tc.const_init_order.length(), 2)
  assert_eq(clo_cr.tc.const_init_order[0], "F")
  assert_eq(clo_cr.tc.const_init_order[1], "A")

  // 5. Hot CAS summary invalidates sigs_hash when ONLY helper's constant read-set changes
  let u1_before =
    #|let B : Int = C + 5
    #|fn get_b() -> Int { 99 }
  let pr0 = parse_source("u0.pion", u0)
  let pr1_before = parse_source("u1.pion", u1_before)
  let pr1_after = parse_source("u1.pion", u1)
  let sig0 = emit_file_sig_entries(pr0.file)
  let sum_before = summarize_file_sigs("xfile", [sig0, emit_file_sig_entries(pr1_before.file)])
  let sum_after = summarize_file_sigs("xfile", [sig0, emit_file_sig_entries(pr1_after.file)])
  assert_true(sum_before.sigs_hash != sum_after.sigs_hash, "sigs_hash must change when helper const reads change")
  assert_eq(sum_before.const_init_order[0], "A")
  assert_eq(sum_after.const_init_order[0], "C")
  assert_eq(sum_after.const_init_order[1], "B")
  assert_eq(sum_after.const_init_order[2], "A")
}

///|
test "j1.r3: default-arg #fdef, named closure body, fn alias, closure arity & exact method resolution" {
  // 1a. Default-arg expression reads B: `let A = get()` depends on B, `let B = get(1)` has NO cycle
  let def_src =
    #|let A : Int = get()
    #|fn get(x : Int = B) -> Int { x }
    #|let B : Int = get(1) + 40
    #|let C : Int = get(x = 2)
    #|pub fn main() -> Int { A + C }
  let def_cr = check_source_files_full("def_ok", ["def_ok.pion"], [def_src])
  assert_true(def_cr.diagnostics.length() == 0, check_result_to_json(def_cr.diagnostics))
  assert_eq(def_cr.tc.const_init_order[0], "B")
  assert_eq(def_cr.tc.const_init_order[1], "A")

  // 1b. Named top-level closure body reads B: B must initialize before A
  let clo_body_src =
    #|let A : String = F()
    #|let F : () -> String = fn() -> String { B }
    #|let B : String = "ok"
    #|pub fn main() -> Int { A.length() }
  let cb_cr = check_source_files_full("cb", ["cb.pion"], [clo_body_src])
  assert_true(cb_cr.diagnostics.length() == 0, check_result_to_json(cb_cr.diagnostics))
  let mut idx_a = -1
  let mut idx_b = -1
  let mut idx_f = -1
  let mut oi = 0
  while oi < cb_cr.tc.const_init_order.length() {
    if cb_cr.tc.const_init_order[oi] == "A" { idx_a = oi }
    if cb_cr.tc.const_init_order[oi] == "B" { idx_b = oi }
    if cb_cr.tc.const_init_order[oi] == "F" { idx_f = oi }
    oi = oi + 1
  }
  assert_true(idx_b >= 0 && idx_f >= 0 && idx_b < idx_a && idx_f < idx_a, "B and F must precede A")

  // 1c. Function value alias & higher-order argument (`let H = helper`, `apply(helper)`)
  let alias_src =
    #|fn helper() -> Int { B }
    #|fn apply(f : () -> Int) -> Int { f() }
    #|let H : () -> Int = helper
    #|let A1 : Int = H()
    #|let A2 : Int = apply(helper)
    #|let B : Int = 7
    #|pub fn main() -> Int { A1 + A2 }
  let al_cr = check_source_files_full("al", ["al.pion"], [alias_src])
  assert_true(al_cr.diagnostics.length() == 0, check_result_to_json(al_cr.diagnostics))
  let mut ia1 = -1
  let mut ia2 = -1
  let mut ib = -1
  oi = 0
  while oi < al_cr.tc.const_init_order.length() {
    if al_cr.tc.const_init_order[oi] == "A1" { ia1 = oi }
    if al_cr.tc.const_init_order[oi] == "A2" { ia2 = oi }
    if al_cr.tc.const_init_order[oi] == "B" { ib = oi }
    oi = oi + 1
  }
  assert_true(ib >= 0 && ib < ia1 && ib < ia2, "B must precede A1 and A2")

  // 1d. Closure call arity mismatch on both local closure and top-level const closure
  let (ok_la, json_la, _) = check_one(
    "pub fn f() -> Int { let g = fn(x : Int) -> Int { x }; g() }\n",
  )
  assert_eq(ok_la, false)
  assert_true(json_la.contains("E_ARITY_MISMATCH"), json_la)
  let (ok_ca, json_ca, _) = check_one(
    "let G : (Int) -> Int = fn(x : Int) -> Int { x }\npub fn f() -> Int { G(1, 2) }\n",
  )
  assert_eq(ok_ca, false)
  assert_true(json_ca.contains("E_ARITY_MISMATCH"), json_ca)

  // 2. Same-named instance methods: X::get does NOT read A, unrelated Y::get DOES read A -> no false cycle
  let meth_ok_src =
    #|struct X { v : Int }
    #|struct Y { v : Int }
    #|fn X::get(self : X) -> Int { self.v }
    #|fn Y::get(self : Y) -> Int { A }
    #|let A : Int = X::{ v: 42 }.get()
    #|pub fn main() -> Int { A }
  let mok_cr = check_source_files_full("mok", ["mok.pion"], [meth_ok_src])
  assert_true(mok_cr.diagnostics.length() == 0, check_result_to_json(mok_cr.diagnostics))
  // Raw AST sig summary must flag const_has_ambiguous_method = true so hot CAS falls back to tc
  let pr_mok = parse_source("mok.pion", meth_ok_src)
  let sum_mok = summarize_file_sigs("mok", [emit_file_sig_entries(pr_mok.file)])
  assert_eq(sum_mok.const_has_ambiguous_method, true)

  // When X::get itself reads A, true cycle IS reported
  let meth_cyc_src =
    #|struct X { v : Int }
    #|struct Y { v : Int }
    #|fn X::get(self : X) -> Int { A + self.v }
    #|fn Y::get(self : Y) -> Int { 1 }
    #|let A : Int = X::{ v: 42 }.get()
    #|pub fn main() -> Int { A }
  let mcyc_cr = check_source_files_full("mcyc", ["mcyc.pion"], [meth_cyc_src])
  assert_true(
    mcyc_cr.diagnostics.length() >= 1 && mcyc_cr.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(mcyc_cr.diagnostics),
  )
}

///|
test "j1.r3: first-class Never, uninhabited T, scoped never_calls, debug_assert & binary expr_tys" {
  // 3a. debug_assert does NOT prove divergence
  let (ok_da, json_da, _) = check_one(
    "pub fn f(c : Bool) -> Int {\n  guard c else {\n    debug_assert(true, panic(\"x\"))\n  }\n  1\n}\n",
  )
  assert_eq(ok_da, false)
  assert_true(json_da.contains("E_GUARD_ELSE_NOT_DIVERGE"), json_da)

  // 3b. Shadowed local `panic` does NOT prove divergence
  let (ok_sh, json_sh, _) = check_one(
    "pub fn f(c : Bool) -> Int {\n  guard c else {\n    let panic = fn(_s : String) -> Unit { () }\n    panic(\"x\")\n  }\n  1\n}\n",
  )
  assert_eq(ok_sh, false)
  assert_true(json_sh.contains("E_GUARD_ELSE_NOT_DIVERGE"), json_sh)

  // 3c. First-class `-> Never` fn, method, unconstrained `halt_like[T]`, and bad `-> Never` body
  let never_ok_src =
    #|struct Boom { tag : Int }
    #|fn Boom::fail(self : Boom) -> Never { panic("boom") }
    #|fn my_die() -> Never { panic("die") }
    #|fn halt_like[T](m : String) -> T { panic(m) }
    #|pub fn run(c : Bool, b : Boom) -> Int {
    #|  guard c else { my_die() }
    #|  guard c else { b.fail() }
    #|  guard c else { let _ : Int = halt_like("stop"); 0 }
    #|  1
    #|}
  let (ok_nv, json_nv, _) = check_one(never_ok_src)
  assert_true(ok_nv, json_nv)

  let (ok_bad_nv, json_bad_nv, _) = check_one("fn bad_never() -> Never { let x = 1 }\n")
  assert_eq(ok_bad_nv, false)
  assert_true(json_bad_nv.contains("E_TYPE_MISMATCH"), json_bad_nv)

  // 3d. Cross-package `-> Never` (cold source & hot stub)
  let nlib_src = "pub fn die() -> Never { panic(\"xpkg\") }\n"
  let nlib_cr = check_source_files_with_imports("nlib", ["nlib.pion"], [nlib_src], [], true)
  assert_true(nlib_cr.diagnostics.length() == 0, check_result_to_json(nlib_cr.diagnostics))
  let nstub_text = emit_file_stub(nlib_cr.pkg.files[0])
  let nstub_cr = check_source_files_with_imports("nlib", ["nlib.pion"], [nstub_text], [], true)
  assert_true(nstub_cr.diagnostics.length() == 0, check_result_to_json(nstub_cr.diagnostics))
  let napp_src =
    #|import "nlib"
    #|pub fn f(c : Bool) -> Int {
    #|  guard c else { nlib::die() }
    #|  1
    #|}
  let napp_cold = check_source_files_with_imports(
    "napp", ["napp.pion"], [napp_src], [imported_pkg_new("nlib", nlib_cr.tc)], true,
  )
  assert_true(napp_cold.diagnostics.length() == 0, check_result_to_json(napp_cold.diagnostics))
  let napp_hot = check_source_files_with_imports(
    "napp", ["napp.pion"], [napp_src], [imported_pkg_new("nlib", nstub_cr.tc)], true,
  )
  assert_true(napp_hot.diagnostics.length() == 0, check_result_to_json(napp_hot.diagnostics))

  // 4. Iterative binary checker preserves tc.expr_tys for BOTH inner `+` and outer `*`
  let ver_src =
    #|#verify
    #|pub fn f(a : Int, b : Int, c : Int) -> Int { (a + b) * c }
  let ver_cr = check_source_files_full("ver_bin", ["ver_bin.pion"], [ver_src])
  assert_true(ver_cr.diagnostics.length() == 0, check_result_to_json(ver_cr.diagnostics))
  let mut bin_int_hits = 0
  match ver_cr.pkg.files[0].decls[0] {
    DFn(fd) =>
      match fd.body[0] {
        SExpr(EBinary("*", EBinary("+", _, _, sp_add), _, sp_mul), _) => {
          match ver_cr.tc.expr_tys.get(span_key(sp_add)) {
            Some(TInt) => bin_int_hits = bin_int_hits + 1
            _ => assert_true(false, "inner + missing TInt in tc.expr_tys")
          }
          match ver_cr.tc.expr_tys.get(span_key(sp_mul)) {
            Some(TInt) => bin_int_hits = bin_int_hits + 1
            _ => assert_true(false, "outer * missing TInt in tc.expr_tys")
          }
        }
        _ => assert_true(false, "unexpected AST shape")
      }
    _ => assert_true(false, "unexpected decl")
  }
  assert_eq(bin_int_hits, 2)
}

///|
test "j1.r4: Never bottom/invariance/return/closure, as TParam, expr-closure mk()(), builtins & #fcallp" {
  // 1a. `-> Never` rejects normal return (`return 7`, closure returning 7), accepts `while true {}`
  let (ok_r7, json_r7, _) = check_one("fn bad() -> Never { return 7 }\n")
  assert_eq(ok_r7, false)
  assert_true(json_r7.contains("E_TYPE_MISMATCH"), json_r7)

  let (ok_cnv, json_cnv, _) = check_one("pub fn f() -> Unit { let _ = fn() -> Never { 7 }; () }\n")
  assert_eq(ok_cnv, false)
  assert_true(json_cnv.contains("E_TYPE_MISMATCH"), json_cnv)

  let (ok_srv, json_srv, _) = check_one("pub fn serve() -> Never { while true { } }\n")
  assert_true(ok_srv, json_srv)

  // 1b. Mutable container invariance: Array[Never] cannot alias Array[Int]
  let (ok_inv, json_inv, _) = check_one(
    "pub fn f() -> Unit {\n  let a : Array[Never] = []\n  let _b : Array[Int] = a\n  ()\n}\n",
  )
  assert_eq(ok_inv, false)
  assert_true(json_inv.contains("E_TYPE_MISMATCH"), json_inv)

  // 1c. `x as TParam` rejected
  let (ok_astp, json_astp, _) = check_one("fn conv[T](x : Int) -> T { x as T }\n")
  assert_eq(ok_astp, false)
  assert_true(json_astp.contains("E_TYPE_MISMATCH"), json_astp)

  // 1d. `while true { debug_assert(true, { break }) }` conservatively has reachable break -> not diverging
  let (ok_dab, json_dab, _) = check_one(
    "pub fn f(c : Bool) -> Int {\n  guard c else {\n    while true {\n      debug_assert(true, { break; \"x\" })\n    }\n  }\n  1\n}\n",
  )
  assert_eq(ok_dab, false)
  assert_true(json_dab.contains("E_GUARD_ELSE_NOT_DIVERGE"), json_dab)

  // 2. Expression-returned closure call `mk()()`: arity, arg type, and `-> Never` divergence
  let mk_hdr = "fn mk() -> (Int) -> Int { fn(x : Int) -> Int { x } }\n"
  let (ok_mk0, json_mk0, _) = check_one(mk_hdr + "pub fn f() -> Int { mk()() }\n")
  assert_eq(ok_mk0, false)
  assert_true(json_mk0.contains("E_ARITY_MISMATCH"), json_mk0)

  let (ok_mk2, json_mk2, _) = check_one(mk_hdr + "pub fn f() -> Int { mk()(1, 2) }\n")
  assert_eq(ok_mk2, false)
  assert_true(json_mk2.contains("E_ARITY_MISMATCH"), json_mk2)

  let (ok_mks, json_mks, _) = check_one(mk_hdr + "pub fn f() -> Int { mk()(\"s\") }\n")
  assert_eq(ok_mks, false)
  assert_true(json_mks.contains("E_TYPE_MISMATCH"), json_mks)

  let (ok_mkn, json_mkn, _) = check_one(
    "fn mk_never() -> () -> Never { fn() -> Never { panic(\"x\") } }\npub fn f(c : Bool) -> Int {\n  guard c else { mk_never()() }\n  1\n}\n",
  )
  assert_true(ok_mkn, json_mkn)

  // 4a. Builtin `.length()` does not collide with unrelated user `X::length`
  let bi_src =
    #|struct X { n : Int }
    #|fn X::length(self : X) -> Int { A + self.n }
    #|let A : Int = [1, 2].length()
    #|pub fn main() -> Int { A }
  let bi_cr = check_source_files_full("bi_len", ["bi_len.pion"], [bi_src])
  assert_true(bi_cr.diagnostics.length() == 0, check_result_to_json(bi_cr.diagnostics))

  // 4b. `x is Some(v) && v > 0` binds `v` on RHS -> no false cycle; without `is Some(v)` -> E_CONST_CYCLE
  let is_ok_src =
    #|let v : Int = f(Some(1))
    #|fn f(x : Option[Int]) -> Int {
    #|  if x is Some(v) && v > 0 { v } else { 0 }
    #|}
    #|pub fn main() -> Int { v }
  let is_ok_cr = check_source_files_full("is_ok", ["is_ok.pion"], [is_ok_src])
  assert_true(is_ok_cr.diagnostics.length() == 0, check_result_to_json(is_ok_cr.diagnostics))

  let is_cyc_src =
    #|let v : Int = f(Some(1))
    #|fn f(x : Option[Int]) -> Int {
    #|  if x.is_some() && v > 0 { 1 } else { 0 }
    #|}
    #|pub fn main() -> Int { v }
  let is_cyc_cr = check_source_files_full("is_cyc", ["is_cyc.pion"], [is_cyc_src])
  assert_true(
    is_cyc_cr.diagnostics.length() >= 1 && is_cyc_cr.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(is_cyc_cr.diagnostics),
  )

  // 5. `#fcallp`: `ignore_cb(read_a)` does not create a cycle; `apply(fn() -> Int { B })` orders B before A
  let cb_src =
    #|fn ignore_cb(_f : () -> Int) -> Int { 1 }
    #|fn apply(f : () -> Int) -> Int { f() }
    #|fn read_a() -> Int { A }
    #|let A : Int = ignore_cb(read_a) + apply(fn() -> Int { B })
    #|let B : Int = 9
    #|pub fn main() -> Int { A }
  let cb_cr = check_source_files_full("cb_ok", ["cb_ok.pion"], [cb_src])
  assert_true(cb_cr.diagnostics.length() == 0, check_result_to_json(cb_cr.diagnostics))
  assert_eq(cb_cr.tc.const_init_order[0], "B")
  assert_eq(cb_cr.tc.const_init_order[1], "A")
}

///|
test "j1.r5: EAs cast soundness, variance, non-fn mk()(), and #fcallp escape/closure/shadowing" {
  // 1. EAs cast legality: reject `1 as Never` and `1 as Array[T]`
  let (ok_forge, json_forge, _) = check_one("fn forge[T]() -> T { 1 as Never }\n")
  assert_eq(ok_forge, false)
  assert_true(json_forge.contains("E_TYPE_MISMATCH"), json_forge)

  let (ok_arr, json_arr, _) = check_one("fn bad_arr[T]() -> Array[T] { 1 as Array[T] }\n")
  assert_eq(ok_arr, false)
  assert_true(json_arr.contains("E_TYPE_MISMATCH"), json_arr)

  // Valid casts remain accepted
  let (ok_valid_as, json_valid_as, _) = check_one(
    "pub fn ok_as(x : Int) -> Double { let _ = x as Byte; x as Double }\n" +
    "pub fn ok_nv() -> Int { panic(\"x\") as Int }\n",
  )
  assert_true(ok_valid_as, json_valid_as)

  // 2. Variance: fn params contravariant, nominal struct/enum invariant
  let (ok_fnv, json_fnv, _) = check_one(
    "pub fn f() -> Unit {\n  let h : (Never) -> Unit = fn(_x : Never) -> Unit { () }\n  let _g : (Int) -> Unit = h\n  ()\n}\n",
  )
  assert_eq(ok_fnv, false)
  assert_true(json_fnv.contains("E_TYPE_MISMATCH"), json_fnv)

  let (ok_cell, json_cell, _) = check_one(
    "struct Cell[T] { mut v : Option[T] }\npub fn f() -> Unit {\n  let c : Cell[Never] = Cell::{ v: None }\n  let _d : Cell[Int] = c\n  ()\n}\n",
  )
  assert_eq(ok_cell, false)
  assert_true(json_cell.contains("E_TYPE_MISMATCH"), json_cell)

  // 3. Non-function expression call `mk()()` must emit E_TYPE_MISMATCH (not silent TError)
  let (ok_nonfn, json_nonfn, _) = check_one(
    "fn mk() -> Int { 1 }\npub fn f() -> Int { mk()() }\n",
  )
  assert_eq(ok_nonfn, false)
  assert_true(json_nonfn.contains("E_TYPE_MISMATCH"), json_nonfn)
  assert_true(json_nonfn.contains("non-function"), json_nonfn)

  // 4. `#fcallp` 5 edge cases:
  // 4a. `keep(read_b)()` (param returned) orders B before A; `keep(read_a)()` -> E_CONST_CYCLE
  let keep_ok = check_source_files_full(
    "keep_ok",
    ["keep_ok.pion"],
    [
      "fn keep(f : () -> Int) -> () -> Int { f }\n" +
      "fn read_b() -> Int { B }\n" +
      "let A : Int = keep(read_b)()\n" +
      "let B : Int = 7\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(keep_ok.diagnostics.length() == 0, check_result_to_json(keep_ok.diagnostics))
  assert_eq(keep_ok.tc.const_init_order[0], "B")
  assert_eq(keep_ok.tc.const_init_order[1], "A")

  let keep_cyc = check_source_files_full(
    "keep_cyc",
    ["keep_cyc.pion"],
    [
      "fn keep(f : () -> Int) -> () -> Int { f }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = keep(read_a)()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    keep_cyc.diagnostics.length() >= 1 && keep_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(keep_cyc.diagnostics),
  )

  // 4b. `wrap(read_b)()` (param captured in returned closure) orders B before A; self -> cycle
  let wrap_ok = check_source_files_full(
    "wrap_ok",
    ["wrap_ok.pion"],
    [
      "fn wrap(f : () -> Int) -> () -> Int { fn() -> Int { f() } }\n" +
      "fn read_b() -> Int { B }\n" +
      "let A : Int = wrap(read_b)()\n" +
      "let B : Int = 8\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(wrap_ok.diagnostics.length() == 0, check_result_to_json(wrap_ok.diagnostics))
  assert_eq(wrap_ok.tc.const_init_order[0], "B")
  assert_eq(wrap_ok.tc.const_init_order[1], "A")

  let wrap_cyc = check_source_files_full(
    "wrap_cyc",
    ["wrap_cyc.pion"],
    [
      "fn wrap(f : () -> Int) -> () -> Int { fn() -> Int { f() } }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = wrap(read_a)()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    wrap_cyc.diagnostics.length() >= 1 && wrap_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(wrap_cyc.diagnostics),
  )

  // 4c. `apply_alias(f) { let g = f; g() }` orders B before A; self -> cycle
  let alias_ok = check_source_files_full(
    "alias_ok",
    ["alias_ok.pion"],
    [
      "fn apply_alias(f : () -> Int) -> Int { let g = f; g() }\n" +
      "let A : Int = apply_alias(fn() -> Int { B })\n" +
      "let B : Int = 9\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(alias_ok.diagnostics.length() == 0, check_result_to_json(alias_ok.diagnostics))
  assert_eq(alias_ok.tc.const_init_order[0], "B")
  assert_eq(alias_ok.tc.const_init_order[1], "A")

  let alias_cyc = check_source_files_full(
    "alias_cyc",
    ["alias_cyc.pion"],
    [
      "fn apply_alias(f : () -> Int) -> Int { let g = f; g() }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = apply_alias(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    alias_cyc.diagnostics.length() >= 1 && alias_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(alias_cyc.diagnostics),
  )

  // 4d. Top-level closure const `let apply_clo = fn(f) { f() }` emits `#fcallp`
  let clo_ok = check_source_files_full(
    "clo_ok",
    ["clo_ok.pion"],
    [
      "let apply_clo : (() -> Int) -> Int = fn(f : () -> Int) -> Int { f() }\n" +
      "let A : Int = apply_clo(fn() -> Int { B })\n" +
      "let B : Int = 10\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(clo_ok.diagnostics.length() == 0, check_result_to_json(clo_ok.diagnostics))
  let mut idx_a = -1
  let mut idx_b = -1
  let mut ci = 0
  while ci < clo_ok.tc.const_init_order.length() {
    if clo_ok.tc.const_init_order[ci] == "A" {
      idx_a = ci
    }
    if clo_ok.tc.const_init_order[ci] == "B" {
      idx_b = ci
    }
    ci = ci + 1
  }
  assert_true(idx_b >= 0 && idx_a > idx_b, "B must init before A via top-level closure apply_clo")

  let clo_cyc = check_source_files_full(
    "clo_cyc",
    ["clo_cyc.pion"],
    [
      "let apply_clo : (() -> Int) -> Int = fn(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = apply_clo(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    clo_cyc.diagnostics.length() >= 1 && clo_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(clo_cyc.diagnostics),
  )

  // 4e. Callback closure arg inherits outer lexical `bound`: local `let A = 7` does not self-cycle
  let shad_ok = check_source_files_full(
    "shad_ok",
    ["shad_ok.pion"],
    [
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn helper() -> Int { let A = 7; apply(fn() -> Int { A }) }\n" +
      "let A : Int = helper()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(shad_ok.diagnostics.length() == 0, check_result_to_json(shad_ok.diagnostics))
}

///|
test "j1.r6: ty_compat_eq O(N) & Option[Never] invariance, #falias, and indirect call callbacks" {
  // 1a. Option[Never] cannot widen to Option[String] (implicit or via `as`)
  let (ok_opt_imp, json_opt_imp, _) = check_one(
    "fn take(x : Option[String]) -> Int { match x { Some(_) => 1; None => 0 } }\n" +
    "pub fn f() -> Int { let n : Option[Never] = None; take(n) }\n",
  )
  assert_eq(ok_opt_imp, false)
  assert_true(json_opt_imp.contains("E_TYPE_MISMATCH"), json_opt_imp)

  let (ok_opt_as, json_opt_as, _) = check_one(
    "pub fn f() -> Option[String] { let n : Option[Never] = None; n as Option[String] }\n",
  )
  assert_eq(ok_opt_as, false)
  assert_true(json_opt_as.contains("E_TYPE_MISMATCH"), json_opt_as)

  // 1b. 30-level nested Box[...Box[Int]...]: same accepted, inner mismatch rejected (linear O(N))
  let sb_t1 = StringBuilder()
  let sb_t2 = StringBuilder()
  let mut d = 0
  while d < 30 {
    sb_t1.write_string("Box[")
    sb_t2.write_string("Box[")
    d = d + 1
  }
  sb_t1.write_string("Int")
  sb_t2.write_string("String")
  d = 0
  while d < 30 {
    sb_t1.write_string("]")
    sb_t2.write_string("]")
    d = d + 1
  }
  let deep_int = sb_t1.to_string()
  let deep_str = sb_t2.to_string()
  let (ok_d30, json_d30, _) = check_one(
    "struct Box[T] { v : Option[T] }\n" +
    "pub fn same(x : " + deep_int + ") -> " + deep_int + " { x }\n",
  )
  assert_true(ok_d30, json_d30)

  let (ok_d30_bad, json_d30_bad, _) = check_one(
    "struct Box[T] { v : Option[T] }\n" +
    "pub fn bad(x : " + deep_int + ") -> " + deep_str + " { x }\n",
  )
  assert_eq(ok_d30_bad, false)
  assert_true(json_d30_bad.contains("E_TYPE_MISMATCH"), json_d30_bad)

  // 3. Indirect parameter call `twice(f) { f(read_b) }` orders B before A, self -> E_CONST_CYCLE
  let tw_ok = check_source_files_full(
    "tw_ok",
    ["tw_ok.pion"],
    [
      "fn twice(f : (() -> Int) -> Int) -> Int { f(read_b) }\n" +
      "fn read_b() -> Int { B }\n" +
      "let A : Int = twice(fn(g : () -> Int) -> Int { g() })\n" +
      "let B : Int = 11\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(tw_ok.diagnostics.length() == 0, check_result_to_json(tw_ok.diagnostics))
  assert_eq(tw_ok.tc.const_init_order[0], "B")
  assert_eq(tw_ok.tc.const_init_order[1], "A")

  let tw_cyc = check_source_files_full(
    "tw_cyc",
    ["tw_cyc.pion"],
    [
      "fn twice(f : (() -> Int) -> Int) -> Int { f(read_a) }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = twice(fn(g : () -> Int) -> Int { g() })\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    tw_cyc.diagnostics.length() >= 1 && tw_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(tw_cyc.diagnostics),
  )

  // 4. Top-level function value alias `#falias`: single-hop, multi-hop, self-cycle, and ignore_cb
  let al_ok = check_source_files_full(
    "al_ok",
    ["al_ok.pion"],
    [
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let alias1 : (() -> Int) -> Int = apply\n" +
      "let alias2 : (() -> Int) -> Int = alias1\n" +
      "let ign : (() -> Int) -> Int = ignore_cb\n" +
      "let A : Int = ign(read_a) + alias2(fn() -> Int { B })\n" +
      "let B : Int = 12\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(al_ok.diagnostics.length() == 0, check_result_to_json(al_ok.diagnostics))
  let mut idx_a = -1
  let mut idx_b = -1
  let mut ci = 0
  while ci < al_ok.tc.const_init_order.length() {
    if al_ok.tc.const_init_order[ci] == "A" {
      idx_a = ci
    }
    if al_ok.tc.const_init_order[ci] == "B" {
      idx_b = ci
    }
    ci = ci + 1
  }
  assert_true(idx_b >= 0 && idx_a > idx_b, "B must init before A via multi-hop alias2")

  let al_cyc = check_source_files_full(
    "al_cyc",
    ["al_cyc.pion"],
    [
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "let alias1 : (() -> Int) -> Int = apply\n" +
      "let A : Int = alias1(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    al_cyc.diagnostics.length() >= 1 && al_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(al_cyc.diagnostics),
  )
}

///|
test "j1.r7: local callable bindings, nested closures, and branch/expr callback extraction" {
  // 1a. Local zero-arg closure call `let f = fn() { B }; f()` orders B before A
  let lc_ok = check_source_files_full(
    "lc_ok",
    ["lc_ok.pion"],
    [
      "fn run() -> Int { let f = fn() -> Int { B }; f() }\n" +
      "let A : Int = run()\n" +
      "let B : Int = 7\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(lc_ok.diagnostics.length() == 0, check_result_to_json(lc_ok.diagnostics))
  assert_eq(lc_ok.tc.const_init_order[0], "B")
  assert_eq(lc_ok.tc.const_init_order[1], "A")

  // 1b. Local closure self-cycle triggers E_CONST_CYCLE
  let lc_cyc = check_source_files_full(
    "lc_cyc",
    ["lc_cyc.pion"],
    [
      "fn run() -> Int { let f = fn() -> Int { A }; f() }\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    lc_cyc.diagnostics.length() >= 1 && lc_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(lc_cyc.diagnostics),
  )

  // 1c. Local closure passed to ignore_cb does NOT create false cycle
  let lc_ign = check_source_files_full(
    "lc_ign",
    ["lc_ign.pion"],
    [
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn run() -> Int { let f = fn() -> Int { A }; ignore_cb(f) }\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(lc_ign.diagnostics.length() == 0, check_result_to_json(lc_ign.diagnostics))

  // 1d. Nested local closure `let f = fn() { B }; let g = fn() { f() }; g()` orders B before A
  let lc_nest = check_source_files_full(
    "lc_nest",
    ["lc_nest.pion"],
    [
      "fn run() -> Int { let f = fn() -> Int { B }; let g = fn() -> Int { f() }; g() }\n" +
      "let A : Int = run()\n" +
      "let B : Int = 8\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(lc_nest.diagnostics.length() == 0, check_result_to_json(lc_nest.diagnostics))
  assert_eq(lc_nest.tc.const_init_order[0], "B")
  assert_eq(lc_nest.tc.const_init_order[1], "A")

  // 2a. Branch-selected callback `apply(if flag { read_b } else { read_c })` orders B & C before A
  let br_ok = check_source_files_full(
    "br_ok",
    ["br_ok.pion"],
    [
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn read_c() -> Int { C }\n" +
      "fn pick(flag : Bool) -> Int { apply(if flag { read_b } else { read_c }) }\n" +
      "let A : Int = pick(true)\n" +
      "let B : Int = 10\n" +
      "let C : Int = 20\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(br_ok.diagnostics.length() == 0, check_result_to_json(br_ok.diagnostics))
  assert_eq(br_ok.tc.const_init_order[2], "A")

  // 2b. `ignore_cb(if flag { read_a } else { read_b })` has ZERO false cycle
  let br_ign = check_source_files_full(
    "br_ign",
    ["br_ign.pion"],
    [
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn read_b() -> Int { B }\n" +
      "let A : Int = ignore_cb(if true { read_a } else { read_b })\n" +
      "let B : Int = 2\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(br_ign.diagnostics.length() == 0, check_result_to_json(br_ign.diagnostics))
}

///|
test "j1.r8: local higher-order closure #fcallp, shared mut slots, and exact/non-exact callees" {
  // 1a. Local higher-order closure `let apply = fn(f) { f() }; apply(fn() { B })` orders B before A
  let ho_ok = check_source_files_full(
    "ho_ok",
    ["ho_ok.pion"],
    [
      "fn run() -> Int {\n" +
      "  let apply = fn(f : () -> Int) -> Int { f() }\n" +
      "  apply(fn() -> Int { B })\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "let B : Int = 7\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(ho_ok.diagnostics.length() == 0, check_result_to_json(ho_ok.diagnostics))
  assert_eq(ho_ok.tc.const_init_order[0], "B")
  assert_eq(ho_ok.tc.const_init_order[1], "A")

  // 1b. Local higher-order closure self-cycle -> E_CONST_CYCLE
  let ho_cyc = check_source_files_full(
    "ho_cyc",
    ["ho_cyc.pion"],
    [
      "fn run() -> Int {\n" +
      "  let apply = fn(f : () -> Int) -> Int { f() }\n" +
      "  apply(fn() -> Int { A })\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    ho_cyc.diagnostics.length() >= 1 && ho_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(ho_cyc.diagnostics),
  )

  // 1c. Local ignoring higher-order closure -> zero false cycle
  let ho_ign = check_source_files_full(
    "ho_ign",
    ["ho_ign.pion"],
    [
      "fn run() -> Int {\n" +
      "  let ign = fn(_f : () -> Int) -> Int { 1 }\n" +
      "  ign(fn() -> Int { A })\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(ho_ign.diagnostics.length() == 0, check_result_to_json(ho_ign.diagnostics))

  // 2a. Captured `let mut` closure reassigned after capture
  let mut_cap = check_source_files_full(
    "mut_cap",
    ["mut_cap.pion"],
    [
      "fn make_b() -> Int { 7 }\n" +
      "fn run() -> Int {\n" +
      "  let mut f = fn() -> Int { 0 }\n" +
      "  let g = fn() -> Int { f() }\n" +
      "  f = fn() -> Int { B }\n" +
      "  g()\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(mut_cap.diagnostics.length() == 0, check_result_to_json(mut_cap.diagnostics))
  assert_eq(mut_cap.tc.const_init_order[0], "B")
  assert_eq(mut_cap.tc.const_init_order[1], "A")

  // 2b. Reassigned inside captured closure: `let mut f = noop; let set = fn() { f = run }; set(); f(read_b)`
  let mut_set = check_source_files_full(
    "mut_set",
    ["mut_set.pion"],
    [
      "fn noop(_g : () -> Int) -> Int { 0 }\n" +
      "fn run_cb(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn go() -> Int {\n" +
      "  let mut f = noop\n" +
      "  let set = fn() -> Unit { f = run_cb }\n" +
      "  set()\n" +
      "  f(read_b)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = 9\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(mut_set.diagnostics.length() == 0, check_result_to_json(mut_set.diagnostics))
  assert_eq(mut_set.tc.const_init_order[0], "B")
  assert_eq(mut_set.tc.const_init_order[1], "A")

  // 3a. Incomplete local targets: `let mut f = noop; f = [run_cb][0]; f(read_b)` and `let f = if flag { noop } else { fs[0] }`
  let inc1 = check_source_files_full(
    "inc1",
    ["inc1.pion"],
    [
      "fn noop(_g : () -> Int) -> Int { 0 }\n" +
      "fn run_cb(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn go() -> Int {\n" +
      "  let mut f = noop\n" +
      "  f = [run_cb][0]\n" +
      "  f(read_b)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = 11\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(inc1.diagnostics.length() == 0, check_result_to_json(inc1.diagnostics))
  assert_eq(inc1.tc.const_init_order[0], "B")
  assert_eq(inc1.tc.const_init_order[1], "A")

  let inc2 = check_source_files_full(
    "inc2",
    ["inc2.pion"],
    [
      "fn noop(_g : () -> Int) -> Int { 0 }\n" +
      "fn run_cb(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let fs : Array[(() -> Int) -> Int] = [run_cb]\n" +
      "  let f = if flag { noop } else { fs[0] }\n" +
      "  f(read_b)\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = 12\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(inc2.diagnostics.length() == 0, check_result_to_json(inc2.diagnostics))
  assert_eq(inc2.tc.const_init_order[0], "B")
  assert_eq(inc2.tc.const_init_order[1], "A")

  // 3b. Exhaustive branch expression callee: `(if flag { ignore1 } else { ignore2 })(read_a)` -> zero false cycle;
  //     `(if flag { ignore1 } else { apply })(read_b)` -> B before A
  let ex_ign = check_source_files_full(
    "ex_ign",
    ["ex_ign.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn ignore2(_g : () -> Int) -> Int { 2 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let A : Int = (if true { ignore1 } else { ignore2 })(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(ex_ign.diagnostics.length() == 0, check_result_to_json(ex_ign.diagnostics))

  let ex_app = check_source_files_full(
    "ex_app",
    ["ex_app.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn apply(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "let A : Int = (if false { ignore1 } else { apply })(read_b)\n" +
      "let B : Int = 13\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(ex_app.diagnostics.length() == 0, check_result_to_json(ex_app.diagnostics))
  assert_eq(ex_app.tc.const_init_order[0], "B")
  assert_eq(ex_app.tc.const_init_order[1], "A")
}

///|
test "j1.r9: closure param depth, container-indexed callables, #fslot exactness & $slot_ namespace" {
  // 1. Closure param shadowing outer local: `let f = 0; let apply = fn(f) { f() }; apply(fn() { B })`
  let sh_ok = check_source_files_full(
    "sh_ok",
    ["sh_ok.pion"],
    [
      "fn run() -> Int {\n" +
      "  let f = 0\n" +
      "  let _ = f\n" +
      "  let apply = fn(f : () -> Int) -> Int { f() }\n" +
      "  apply(fn() -> Int { B })\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "let B : Int = 7\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(sh_ok.diagnostics.length() == 0, check_result_to_json(sh_ok.diagnostics))
  assert_eq(sh_ok.tc.const_init_order[0], "B")
  assert_eq(sh_ok.tc.const_init_order[1], "A")

  let sh_cyc = check_source_files_full(
    "sh_cyc",
    ["sh_cyc.pion"],
    [
      "fn run() -> Int {\n" +
      "  let f = 0\n" +
      "  let _ = f\n" +
      "  let apply = fn(f : () -> Int) -> Int { f() }\n" +
      "  apply(fn() -> Int { A })\n" +
      "}\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    sh_cyc.diagnostics.length() >= 1 && sh_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(sh_cyc.diagnostics),
  )

  // 2. Container-indexed zero-arg call: `let f = [read_b][0]; f()` and `let fs = [read_b]; let f = fs[0]; f()`
  let idx_ok = check_source_files_full(
    "idx_ok",
    ["idx_ok.pion"],
    [
      "fn read_b() -> Int { B }\n" +
      "fn run() -> Int { let f = [read_b][0]; f() }\n" +
      "let A : Int = run()\n" +
      "let B : Int = 9\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(idx_ok.diagnostics.length() == 0, check_result_to_json(idx_ok.diagnostics))
  assert_eq(idx_ok.tc.const_init_order[0], "B")
  assert_eq(idx_ok.tc.const_init_order[1], "A")

  let idx_cyc = check_source_files_full(
    "idx_cyc",
    ["idx_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn run() -> Int { let fs : Array[() -> Int] = [read_a]; let f = fs[0]; f() }\n" +
      "let A : Int = run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    idx_cyc.diagnostics.length() >= 1 && idx_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(idx_cyc.diagnostics),
  )

  // 3. Exact `#fslot`: `let mut f = ignore1; f = ignore2; f(read_a)` -> zero false cycle;
  //    `let mut f = ignore1; f = apply; f(read_b)` -> B before A
  let sl_ign = check_source_files_full(
    "sl_ign",
    ["sl_ign.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn ignore2(_g : () -> Int) -> Int { 2 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let mut f = ignore1; f = ignore2; f(read_a) }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(sl_ign.diagnostics.length() == 0, check_result_to_json(sl_ign.diagnostics))

  let sl_app = check_source_files_full(
    "sl_app",
    ["sl_app.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn apply(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn go() -> Int { let mut f = ignore1; f = apply; f(read_b) }\n" +
      "let A : Int = go()\n" +
      "let B : Int = 14\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(sl_app.diagnostics.length() == 0, check_result_to_json(sl_app.diagnostics))
  assert_eq(sl_app.tc.const_init_order[0], "B")
  assert_eq(sl_app.tc.const_init_order[1], "A")

  // 4. User function named `__slot_ignore` does NOT collide with `$slot_` namespace
  let usr_sl = check_source_files_full(
    "usr_sl",
    ["usr_sl.pion"],
    [
      "fn __slot_ignore(_g : () -> Int) -> Int { 1 }\n" +
      "let A : Int = __slot_ignore(fn() -> Int { A })\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(usr_sl.diagnostics.length() == 0, check_result_to_json(usr_sl.diagnostics))
}

///|
test "j1.r10: EMutArg slot invalidation, container projection/writes, decl-kind prefix & #fslot alias" {
  // 1. Opus: `EMutArg` invalidates `mut_slot_exact`
  let em_ok = check_source_files_full(
    "em_ok",
    ["em_ok.pion"],
    [
      "fn noop(_g : () -> String) -> String { \"x\" }\n" +
      "fn run_cb(g : () -> String) -> String { g() }\n" +
      "fn reassign(mut f : (() -> String) -> String) -> Unit { f = run_cb }\n" +
      "fn read_b() -> String { B }\n" +
      "fn go() -> String { let mut f = noop; reassign(mut f); f(read_b) }\n" +
      "let A : String = go()\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(em_ok.diagnostics.length() == 0, check_result_to_json(em_ok.diagnostics))
  assert_eq(em_ok.tc.const_init_order[0], "B")
  assert_eq(em_ok.tc.const_init_order[1], "A")

  // 2a. Container index write `fs[0] = fn() { B }` orders B before A; self -> E_CONST_CYCLE
  let cw_ok = check_source_files_full(
    "cw_ok",
    ["cw_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int { let fs = [zero]; fs[0] = fn() -> Int { B }; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(cw_ok.diagnostics.length() == 0, check_result_to_json(cw_ok.diagnostics))
  assert_eq(cw_ok.tc.const_init_order[0], "B")
  assert_eq(cw_ok.tc.const_init_order[1], "A")

  let cw_cyc = check_source_files_full(
    "cw_cyc",
    ["cw_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn go() -> Int { let fs = [zero]; fs[0] = fn() -> Int { A }; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    cw_cyc.diagnostics.length() >= 1 && cw_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(cw_cyc.diagnostics),
  )

  // 2b. Exact index projection: `[seven, read_a]` -> `fs[0]` no cycle, `fs[1]` E_CONST_CYCLE
  let ip_ok = check_source_files_full(
    "ip_ok",
    ["ip_ok.pion"],
    [
      "fn seven() -> Int { 7 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let fs = [seven, read_a]; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(ip_ok.diagnostics.length() == 0, check_result_to_json(ip_ok.diagnostics))

  let ip_cyc = check_source_files_full(
    "ip_cyc",
    ["ip_cyc.pion"],
    [
      "fn seven() -> Int { 7 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let fs = [seven, read_a]; let f = fs[1]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    ip_cyc.diagnostics.length() >= 1 && ip_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(ip_cyc.diagnostics),
  )

  // 2c. Exact struct field projection: `Holder::{ ok: seven, bad: read_a }`
  let fp_ok = check_source_files_full(
    "fp_ok",
    ["fp_ok.pion"],
    [
      "struct Holder { ok : () -> Int; bad : () -> Int }\n" +
      "fn seven() -> Int { 7 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let h = Holder::{ ok: seven, bad: read_a }; let f = h.ok; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(fp_ok.diagnostics.length() == 0, check_result_to_json(fp_ok.diagnostics))

  let fp_cyc = check_source_files_full(
    "fp_cyc",
    ["fp_cyc.pion"],
    [
      "struct Holder { ok : () -> Int; bad : () -> Int }\n" +
      "fn seven() -> Int { 7 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let h = Holder::{ ok: seven, bad: read_a }; let f = h.bad; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    fp_cyc.diagnostics.length() >= 1 && fp_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(fp_cyc.diagnostics),
  )

  // 3. Decl-kind prefix isolation: `fn helper_body` vs `let helper = fn() { ... }` in both orders
  let pfx1 = check_source_files_full(
    "pfx1",
    ["pfx1.pion"],
    [
      "fn helper_body() -> Int { 7 }\n" +
      "let helper : () -> Int = fn() -> Int { let inner = fn() -> Int { A }; inner() }\n" +
      "let A : Int = helper_body()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(pfx1.diagnostics.length() == 0, check_result_to_json(pfx1.diagnostics))

  let pfx2 = check_source_files_full(
    "pfx2",
    ["pfx2.pion"],
    [
      "let helper : () -> Int = fn() -> Int { let inner = fn() -> Int { A }; inner() }\n" +
      "fn helper_body() -> Int { 7 }\n" +
      "let A : Int = helper_body()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(pfx2.diagnostics.length() == 0, check_result_to_json(pfx2.diagnostics))

  // 4. Immutable alias of exact mut slot + chained `#fslot` fixed-point
  let sa_ign = check_source_files_full(
    "sa_ign",
    ["sa_ign.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn ignore2(_g : () -> Int) -> Int { 2 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut f1 = ignore1\n" +
      "  f1 = ignore2\n" +
      "  let mut f2 = f1\n" +
      "  let g = f2\n" +
      "  g(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(sa_ign.diagnostics.length() == 0, check_result_to_json(sa_ign.diagnostics))

  let sa_app = check_source_files_full(
    "sa_app",
    ["sa_app.pion"],
    [
      "fn ignore1(_g : () -> Int) -> Int { 1 }\n" +
      "fn apply(g : () -> Int) -> Int { g() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn go() -> Int { let mut f = ignore1; f = apply; let g = f; g(read_b) }\n" +
      "let A : Int = go()\n" +
      "let B : Int = 21\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(sa_app.diagnostics.length() == 0, check_result_to_json(sa_app.diagnostics))
  assert_eq(sa_app.tc.const_init_order[0], "B")
  assert_eq(sa_app.tc.const_init_order[1], "A")
}

///|
test "j1.r11: shared container slots ($cslot_), array reverse, mut-param #fmutw/#fmutlink & let mut fs" {
  // 1. Container alias write: `let fs = [zero]; let alias = fs; alias[0] = read_b; let f = fs[0]; f()`
  let al_ok = check_source_files_full(
    "r11_al_ok",
    ["r11_al_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int { let fs = [zero]; let alias = fs; alias[0] = read_b; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(al_ok.diagnostics.length() == 0, check_result_to_json(al_ok.diagnostics))
  assert_eq(al_ok.tc.const_init_order[0], "B")
  assert_eq(al_ok.tc.const_init_order[1], "A")

  let al_cyc = check_source_files_full(
    "r11_al_cyc",
    ["r11_al_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let fs = [zero]; let alias = fs; alias[0] = read_a; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    al_cyc.diagnostics.length() >= 1 && al_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(al_cyc.diagnostics),
  )

  // 2. Closure captured container mutated after capture:
  //    `let fs = [zero]; let g = fn() -> Int { let f = fs[0]; f() }; fs[0] = read_b; g()`
  let cap_ok = check_source_files_full(
    "r11_cap_ok",
    ["r11_cap_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int {\n" +
      "  let fs = [zero]\n" +
      "  let g = fn() -> Int { let f = fs[0]; f() }\n" +
      "  fs[0] = read_b\n" +
      "  g()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(cap_ok.diagnostics.length() == 0, check_result_to_json(cap_ok.diagnostics))
  assert_eq(cap_ok.tc.const_init_order[0], "B")
  assert_eq(cap_ok.tc.const_init_order[1], "A")

  let cap_cyc = check_source_files_full(
    "r11_cap_cyc",
    ["r11_cap_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let fs = [zero]\n" +
      "  let g = fn() -> Int { let f = fs[0]; f() }\n" +
      "  fs[0] = read_a\n" +
      "  g()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    cap_cyc.diagnostics.length() >= 1 && cap_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(cap_cyc.diagnostics),
  )

  // 3. Array reordering method `fs.reverse()` invalidates exact index slot
  let rev_ok = check_source_files_full(
    "r11_rev_ok",
    ["r11_rev_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int { let fs = [zero, read_b]; fs.reverse(); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(rev_ok.diagnostics.length() == 0, check_result_to_json(rev_ok.diagnostics))
  assert_eq(rev_ok.tc.const_init_order[0], "B")
  assert_eq(rev_ok.tc.const_init_order[1], "A")

  let rev_cyc = check_source_files_full(
    "r11_rev_cyc",
    ["r11_rev_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let fs = [zero, read_a]; fs.reverse(); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    rev_cyc.diagnostics.length() >= 1 && rev_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(rev_cyc.diagnostics),
  )

  // 4. `mut` param write-back `#fmutw` + `#fmutlink`: `install(mut f); f()`
  let mw_ok = check_source_files_full(
    "r11_mw_ok",
    ["r11_mw_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn install(mut f : () -> Int) -> Unit { f = read_b }\n" +
      "fn go() -> Int { let mut f = zero; install(mut f); f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(mw_ok.diagnostics.length() == 0, check_result_to_json(mw_ok.diagnostics))
  assert_eq(mw_ok.tc.const_init_order[0], "B")
  assert_eq(mw_ok.tc.const_init_order[1], "A")

  let mw_cyc = check_source_files_full(
    "r11_mw_cyc",
    ["r11_mw_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(mut f : () -> Int) -> Unit { f = read_a }\n" +
      "fn go() -> Int { let mut f = zero; install(mut f); f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    mw_cyc.diagnostics.length() >= 1 && mw_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(mw_cyc.diagnostics),
  )

  // 5. `let mut fs = [zero]; let set = fn() { fs[0] = read_b }; set(); let f = fs[0]; f()`
  let mfs_ok = check_source_files_full(
    "r11_mfs_ok",
    ["r11_mfs_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int {\n" +
      "  let mut fs = [zero]\n" +
      "  let set = fn() -> Unit { fs[0] = read_b }\n" +
      "  set()\n" +
      "  let f = fs[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(mfs_ok.diagnostics.length() == 0, check_result_to_json(mfs_ok.diagnostics))
  assert_eq(mfs_ok.tc.const_init_order[0], "B")
  assert_eq(mfs_ok.tc.const_init_order[1], "A")

  let mfs_cyc = check_source_files_full(
    "r11_mfs_cyc",
    ["r11_mfs_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut fs = [zero]\n" +
      "  let set = fn() -> Unit { fs[0] = read_a }\n" +
      "  set()\n" +
      "  let f = fs[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    mfs_cyc.diagnostics.length() >= 1 && mfs_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(mfs_cyc.diagnostics),
  )

  // 6. Non-mut ref container param write-back: `fn install(fs : Array[() -> Int]) { fs[0] = read_b }`
  let rarr_ok = check_source_files_full(
    "r11_rarr_ok",
    ["r11_rarr_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { fs[0] = read_b }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(rarr_ok.diagnostics.length() == 0, check_result_to_json(rarr_ok.diagnostics))
  assert_eq(rarr_ok.tc.const_init_order[0], "B")
  assert_eq(rarr_ok.tc.const_init_order[1], "A")

  let rarr_cyc = check_source_files_full(
    "r11_rarr_cyc",
    ["r11_rarr_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { fs[0] = read_a }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    rarr_cyc.diagnostics.length() >= 1 && rarr_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(rarr_cyc.diagnostics),
  )

  // 7. Method receiver `self` (slot 0) write-back: `fn Holder::install(self : Holder) { self.f = read_b }`
  let mself_ok = check_source_files_full(
    "r11_mself_ok",
    ["r11_mself_ok.pion"],
    [
      "struct Holder { mut f : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn Holder::install(self : Holder) -> Unit { self.f = read_b }\n" +
      "fn go() -> Int { let h = Holder::{ f: zero }; h.install(); let g = h.f; g() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(mself_ok.diagnostics.length() == 0, check_result_to_json(mself_ok.diagnostics))
  assert_eq(mself_ok.tc.const_init_order[0], "B")
  assert_eq(mself_ok.tc.const_init_order[1], "A")

  let mself_cyc = check_source_files_full(
    "r11_mself_cyc",
    ["r11_mself_cyc.pion"],
    [
      "struct Holder { mut f : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn Holder::install(self : Holder) -> Unit { self.f = read_a }\n" +
      "fn go() -> Int { let h = Holder::{ f: zero }; h.install(); let g = h.f; g() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    mself_cyc.diagnostics.length() >= 1 && mself_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(mself_cyc.diagnostics),
  )
}

test "j1.r12: reassigned mut container, param local alias, user get method & assign lhs precision" {
  // 1. Reassigned mutable container: `let mut fs = [zero]; fs = [read_b]; let f = fs[0]; f()`
  let r1_ok = check_source_files_full(
    "r12_rebind_ok",
    ["r12_rebind_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int { let mut fs = [zero]; fs = [read_b]; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let r1_cyc = check_source_files_full(
    "r12_rebind_cyc",
    ["r12_rebind_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let mut fs = [zero]; fs = [read_a]; let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2. Local alias of parameter write-back: `fn install(fs : Array[() -> Int]) { let a = fs; a[0] = read_b }`
  let r2_ok = check_source_files_full(
    "r12_palias_ok",
    ["r12_palias_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let a = fs; a[0] = read_b }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r12_palias_cyc",
    ["r12_palias_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let a = fs; a[0] = read_a }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. User-defined method named `get` mutating `self.f` must not be exempted as builtin readonly
  let r3_ok = check_source_files_full(
    "r12_userget_ok",
    ["r12_userget_ok.pion"],
    [
      "struct Holder { mut f : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn Holder::get(self : Holder) -> Unit { self.f = read_b }\n" +
      "fn go() -> Int { let h = Holder::{ f: zero }; h.get(); let g = h.f; g() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r12_userget_cyc",
    ["r12_userget_cyc.pion"],
    [
      "struct Holder { mut f : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn Holder::get(self : Holder) -> Unit { self.f = read_a }\n" +
      "fn go() -> Int { let h = Holder::{ f: zero }; h.get(); let g = h.f; g() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. `SAssign` LHS container write (`fs[0] = read_a`) without invoking `fs[0]()` must NOT trigger false E_CONST_CYCLE,
  //    while invoking `fs[0]()` afterwards MUST report E_CONST_CYCLE.
  let r4_nocyc = check_source_files_full(
    "r12_nocall_ok",
    ["r12_nocall_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { fs[0] = read_a }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); 1 }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_nocyc.diagnostics.length() == 0, check_result_to_json(r4_nocyc.diagnostics))

  let r4_cyc = check_source_files_full(
    "r12_call_cyc",
    ["r12_call_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { fs[0] = read_a }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

}

test "j1.r13: rebind old/new aliases, assigned param alias, conditional closure write-back & alias direct_callp" {
  // 1a. Rebind preserves old alias (`old_a[0]()` -> 0, no cycle even if `fs = [read_a]`)
  let r1_old = check_source_files_full(
    "r13_old_alias",
    ["r13_old_alias.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let mut fs = [zero]; let old_a = fs; fs = [read_a]; let _ = fs; let f = old_a[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_old.diagnostics.length() == 0, check_result_to_json(r1_old.diagnostics))

  // 1b. Rebind new alias sees rebound container (`B` before `A`, and `read_a` -> E_CONST_CYCLE)
  let r1_new_ok = check_source_files_full(
    "r13_new_alias_ok",
    ["r13_new_alias_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int { let mut fs = [zero]; let _old_a = fs; fs = [read_b]; let new_a = fs; let f = new_a[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_new_ok.diagnostics.length() == 0, check_result_to_json(r1_new_ok.diagnostics))
  assert_eq(r1_new_ok.tc.const_init_order[0], "B")
  assert_eq(r1_new_ok.tc.const_init_order[1], "A")

  let r1_new_cyc = check_source_files_full(
    "r13_new_alias_cyc",
    ["r13_new_alias_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let mut fs = [zero]; let _old_a = fs; fs = [read_a]; let new_a = fs; let f = new_a[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_new_cyc.diagnostics.length() >= 1 && r1_new_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_new_cyc.diagnostics),
  )

  // 2. Param alias via assignment: `let mut a = [zero]; a = fs; a[0] = read_b`
  let r2_ok = check_source_files_full(
    "r13_assign_palias_ok",
    ["r13_assign_palias_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let mut a = [zero]; a = fs; a[0] = read_b }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r13_assign_palias_cyc",
    ["r13_assign_palias_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let mut a = [zero]; a = fs; a[0] = read_a }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3a. Closure capturing outer param alias and called: propagates write-back
  let r3_called_ok = check_source_files_full(
    "r13_cb_called_ok",
    ["r13_cb_called_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let a = fs; let set = fn() -> Unit { a[0] = read_b }; set() }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_called_ok.diagnostics.length() == 0, check_result_to_json(r3_called_ok.diagnostics))
  assert_eq(r3_called_ok.tc.const_init_order[0], "B")
  assert_eq(r3_called_ok.tc.const_init_order[1], "A")

  let r3_called_cyc = check_source_files_full(
    "r13_cb_called_cyc",
    ["r13_cb_called_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let a = fs; let set = fn() -> Unit { a[0] = read_a }; set() }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_called_cyc.diagnostics.length() >= 1 && r3_called_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_called_cyc.diagnostics),
  )

  // 3b. Closure capturing outer param alias but NEVER called: 0 diagnostics (no false cycle)
  let r3_uncalled = check_source_files_full(
    "r13_cb_uncalled_ok",
    ["r13_cb_uncalled_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let a = fs; let _set = fn() -> Unit { a[0] = read_a }; () }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_uncalled.diagnostics.length() == 0, check_result_to_json(r3_uncalled.diagnostics))

  // 4. `let a = fs; a[0] = zero` does not mark `fs` in direct_callp, while calling `a[0]()` does
  let r4_nocyc = check_source_files_full(
    "r13_clear_nocyc",
    ["r13_clear_nocyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn clear_first(fs : Array[() -> Int]) -> Unit { let a = fs; a[0] = zero }\n" +
      "fn go() -> Int { let fs = [read_a]; clear_first(fs); 1 }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_nocyc.diagnostics.length() == 0, check_result_to_json(r4_nocyc.diagnostics))

  let r4_cyc = check_source_files_full(
    "r13_clear_cyc",
    ["r13_clear_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn clear_first(fs : Array[() -> Int]) -> Int { let a = fs; let f = a[0]; a[0] = zero; f() }\n" +
      "fn go() -> Int { let fs = [read_a]; clear_first(fs) }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

}

test "j1.r14: rebound shared cslot write-back, closure param-alias call #fcbcall, block env shadowing & alias forwarding" {
  // 1. Rebound mut container shares new $cslot with new_a while old_a keeps old $cslot
  let r1_ok = check_source_files_full(
    "r14_rebind_share_ok",
    ["r14_rebind_share_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int {\n" +
      "  let mut fs = [zero]\n" +
      "  let old_a = fs\n" +
      "  fs = [zero]\n" +
      "  let new_a = fs\n" +
      "  new_a[0] = read_b\n" +
      "  let f0 = old_a[0]\n" +
      "  let f1 = fs[0]\n" +
      "  f0() + f1()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let r1_old_isolated = check_source_files_full(
    "r14_rebind_old_iso",
    ["r14_rebind_old_iso.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut fs = [zero]\n" +
      "  let old_a = fs\n" +
      "  fs = [zero]\n" +
      "  let new_a = fs\n" +
      "  new_a[0] = read_a\n" +
      "  let _ = fs\n" +
      "  let f0 = old_a[0]\n" +
      "  f0()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_old_isolated.diagnostics.length() == 0,
    check_result_to_json(r1_old_isolated.diagnostics),
  )

  let r1_cyc = check_source_files_full(
    "r14_rebind_share_cyc",
    ["r14_rebind_share_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut fs = [zero]\n" +
      "  fs = [zero]\n" +
      "  let new_a = fs\n" +
      "  new_a[0] = read_a\n" +
      "  let f1 = fs[0]\n" +
      "  f1()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2a. Closure capturing outer param alias and calling it (`#fcbcall`): propagates B before A & cycle
  let r2_ok = check_source_files_full(
    "r14_cbcall_ok",
    ["r14_cbcall_ok.pion"],
    [
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 23 }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let h = fn() -> Int { g() }; h() }\n" +
      "let A : Int = relay(read_b)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_nested_ok = check_source_files_full(
    "r14_cbcall_nested_ok",
    ["r14_cbcall_nested_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 29 }\n" +
      "fn relay(f : () -> Int) -> Int {\n" +
      "  let g = f\n" +
      "  let mut a = zero\n" +
      "  a = g\n" +
      "  let h1 = fn() -> Int { let h2 = fn() -> Int { a() }; h2() }\n" +
      "  h1()\n" +
      "}\n" +
      "let A : Int = relay(read_b)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_nested_ok.diagnostics.length() == 0, check_result_to_json(r2_nested_ok.diagnostics))
  assert_eq(r2_nested_ok.tc.const_init_order[0], "B")
  assert_eq(r2_nested_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r14_cbcall_cyc",
    ["r14_cbcall_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let h = fn() -> Int { g() }; h() }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 2b. Uncalled closure capturing outer param alias: 0 diagnostics (no false cycle)
  let r2_uncalled = check_source_files_full(
    "r14_cbcall_uncalled",
    ["r14_cbcall_uncalled.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let _h = fn() -> Int { g() }; 1 }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_uncalled.diagnostics.length() == 0, check_result_to_json(r2_uncalled.diagnostics))

  // 3. Lexical block/branch env & shadowing in `sig_collect_expr_param_srcs`
  let r3_blk_ok = check_source_files_full(
    "r14_blk_psrc_ok",
    ["r14_blk_psrc_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 31 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit {\n" +
      "  let mut a = [zero]\n" +
      "  a = { let t = fs; t }\n" +
      "  a[0] = read_b\n" +
      "}\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_blk_ok.diagnostics.length() == 0, check_result_to_json(r3_blk_ok.diagnostics))
  assert_eq(r3_blk_ok.tc.const_init_order[0], "B")
  assert_eq(r3_blk_ok.tc.const_init_order[1], "A")

  let r3_shadow_ok = check_source_files_full(
    "r14_blk_shadow_ok",
    ["r14_blk_shadow_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit {\n" +
      "  let _ = fs\n" +
      "  let mut a = [zero]\n" +
      "  a = { let fs = [zero]; fs }\n" +
      "  a[0] = read_a\n" +
      "}\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_shadow_ok.diagnostics.length() == 0, check_result_to_json(r3_shadow_ok.diagnostics))

  // 4. Forwarding param alias to known callee: `ignore_cb(g)` 0 diagnostics vs `apply(g)` E_CONST_CYCLE
  let r4_ign = check_source_files_full(
    "r14_fwd_alias_ign",
    ["r14_fwd_alias_ign.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; ignore_cb(g) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ign.diagnostics.length() == 0, check_result_to_json(r4_ign.diagnostics))

  let r4_app = check_source_files_full(
    "r14_fwd_alias_app",
    ["r14_fwd_alias_app.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; apply(g) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_app.diagnostics.length() >= 1 && r4_app.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_app.diagnostics),
  )
}

test "j1.r15: escaping anon closure alias, conditional cslots union, SLetTuple positional param_srcs & #fcbcallfwd" {
  // 1. Escaping anonymous closures capturing param alias (tail, return, struct field)
  let r1_tail = check_source_files_full(
    "r15_esc_tail",
    ["r15_esc_tail.pion"],
    [
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> () -> String { let a = f; fn() -> String { a() } }\n" +
      "let A : String = mk(read_b)()\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_tail.diagnostics.length() == 0, check_result_to_json(r1_tail.diagnostics))
  assert_eq(r1_tail.tc.const_init_order[0], "B")
  assert_eq(r1_tail.tc.const_init_order[1], "A")

  let r1_ret = check_source_files_full(
    "r15_esc_ret",
    ["r15_esc_ret.pion"],
    [
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> () -> String { let a = f; return fn() -> String { a() } }\n" +
      "let A : String = mk(read_b)()\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_ret.diagnostics.length() == 0, check_result_to_json(r1_ret.diagnostics))
  assert_eq(r1_ret.tc.const_init_order[0], "B")
  assert_eq(r1_ret.tc.const_init_order[1], "A")

  let r1_fld = check_source_files_full(
    "r15_esc_fld",
    ["r15_esc_fld.pion"],
    [
      "struct Holder { cb : () -> String }\n" +
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> Holder { let a = f; Holder::{ cb: fn() -> String { a() } } }\n" +
      "let A : String = { let h = mk(read_b); (h.cb)() }\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_fld.diagnostics.length() == 0, check_result_to_json(r1_fld.diagnostics))
  assert_eq(r1_fld.tc.const_init_order[0], "B")
  assert_eq(r1_fld.tc.const_init_order[1], "A")

  // 2. Conditional container rebind merges cslots (`if flag { fs = right }`)
  let r2_ok = check_source_files_full(
    "r15_cond_cslots_ok",
    ["r15_cond_cslots_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  if flag { fs = right }\n" +
      "  let a = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = a[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  // 3. `SLetTuple` positional param_srcs propagation (block & top-level)
  let r3_blk = check_source_files_full(
    "r15_tuple_blk_ok",
    ["r15_tuple_blk_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 41 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit {\n" +
      "  let mut a = [zero]\n" +
      "  a = { let (t, _n) = (fs, 0); t }\n" +
      "  a[0] = read_b\n" +
      "}\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_blk.diagnostics.length() == 0, check_result_to_json(r3_blk.diagnostics))
  assert_eq(r3_blk.tc.const_init_order[0], "B")
  assert_eq(r3_blk.tc.const_init_order[1], "A")

  let r3_top = check_source_files_full(
    "r15_tuple_top_ok",
    ["r15_tuple_top_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 41 }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit { let (t, _n) = (fs, 0); t[0] = read_b }\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_top.diagnostics.length() == 0, check_result_to_json(r3_top.diagnostics))
  assert_eq(r3_top.tc.const_init_order[0], "B")
  assert_eq(r3_top.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r15_tuple_cyc",
    ["r15_tuple_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(fs : Array[() -> Int]) -> Unit {\n" +
      "  let mut a = [zero]\n" +
      "  a = { let (t, _n) = (fs, 0); t }\n" +
      "  a[0] = read_a\n" +
      "}\n" +
      "fn go() -> Int { let fs = [zero]; install(fs); let f = fs[0]; f() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Conditional closure param forwarding `#fcbcallfwd`: ignore_cb(g) 0 diagnostics vs apply(g)/mid(g) E_CONST_CYCLE
  let r4_ign = check_source_files_full(
    "r15_cbfwd_ign",
    ["r15_cbfwd_ign.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let h = fn() -> Int { ignore_cb(g) }; h() }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ign.diagnostics.length() == 0, check_result_to_json(r4_ign.diagnostics))

  let r4_app = check_source_files_full(
    "r15_cbfwd_app",
    ["r15_cbfwd_app.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let h = fn() -> Int { apply(g) }; h() }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_app.diagnostics.length() >= 1 && r4_app.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_app.diagnostics),
  )

  let r4_mid = check_source_files_full(
    "r15_cbfwd_mid",
    ["r15_cbfwd_mid.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn mid(f : () -> Int) -> Int { apply(f) }\n" +
      "fn relay(f : () -> Int) -> Int { let g = f; let h = fn() -> Int { mid(g) }; h() }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_mid.diagnostics.length() >= 1 && r4_mid.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_mid.diagnostics),
  )
}

test "j1.r16: escaping named closure local & loop cond_depth cslots union" {
  // 1a. Escaping named closure (`let h = fn() { a() }; h`, `return h`, `Holder::{ cb: h }`)
  let r1_tail = check_source_files_full(
    "r16_named_tail",
    ["r16_named_tail.pion"],
    [
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> () -> String { let a = f; let h = fn() -> String { a() }; h }\n" +
      "let A : String = mk(read_b)()\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_tail.diagnostics.length() == 0, check_result_to_json(r1_tail.diagnostics))
  assert_eq(r1_tail.tc.const_init_order[0], "B")
  assert_eq(r1_tail.tc.const_init_order[1], "A")

  let r1_ret = check_source_files_full(
    "r16_named_ret",
    ["r16_named_ret.pion"],
    [
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> () -> String { let h = fn() -> String { f() }; return h }\n" +
      "let A : String = mk(read_b)()\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_ret.diagnostics.length() == 0, check_result_to_json(r1_ret.diagnostics))
  assert_eq(r1_ret.tc.const_init_order[0], "B")
  assert_eq(r1_ret.tc.const_init_order[1], "A")

  let r1_fld = check_source_files_full(
    "r16_named_fld",
    ["r16_named_fld.pion"],
    [
      "struct Holder { cb : () -> String }\n" +
      "fn read_b() -> String { B }\n" +
      "fn mk(f : () -> String) -> Holder { let a = f; let h = fn() -> String { a() }; Holder::{ cb: h } }\n" +
      "let A : String = { let x = mk(read_b); (x.cb)() }\n" +
      "let B : String = \"b\"\n" +
      "pub fn main() -> Int { A.length() }\n",
    ],
  )
  assert_true(r1_fld.diagnostics.length() == 0, check_result_to_json(r1_fld.diagnostics))
  assert_eq(r1_fld.tc.const_init_order[0], "B")
  assert_eq(r1_fld.tc.const_init_order[1], "A")

  // 1b. Named closure passed to `ignore_cb(h)` (0 diagnostics) vs `apply(h)` (E_CONST_CYCLE)
  let r1_ign = check_source_files_full(
    "r16_named_ign",
    ["r16_named_ign.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn relay(f : () -> Int) -> Int { let a = f; let h = fn() -> Int { a() }; ignore_cb(h) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ign.diagnostics.length() == 0, check_result_to_json(r1_ign.diagnostics))

  let r1_app = check_source_files_full(
    "r16_named_app",
    ["r16_named_app.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn relay(f : () -> Int) -> Int { let a = f; let h = fn() -> Int { a() }; apply(h) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_app.diagnostics.length() >= 1 && r1_app.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_app.diagnostics),
  )

  // 2. Loop `while flag { fs = right }` merges cslots so `flag = false` keeps `left`
  let r2_while = check_source_files_full(
    "r16_while_cslots",
    ["r16_while_cslots.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  while flag { fs = right }\n" +
      "  let a = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = a[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_while.diagnostics.length() == 0, check_result_to_json(r2_while.diagnostics))
  assert_eq(r2_while.tc.const_init_order[0], "B")
  assert_eq(r2_while.tc.const_init_order[1], "A")
}

test "j1.r17: loop back-edge cslots, &&/|| cond_depth, SLetTuple simultaneous eval & escaping closure->named cb" {
  // 1. Loop back-edge propagates `fs = right` back to `fs[0] = read_b`
  let r1_ok = check_source_files_full(
    "r17_loop_be_ok",
    ["r17_loop_be_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let mut i = 0\n" +
      "  while i < 2 { fs[0] = read_b; fs = right; i = i + 1 }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let r1_cyc = check_source_files_full(
    "r17_loop_be_cyc",
    ["r17_loop_be_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let mut i = 0\n" +
      "  while i < 2 { fs[0] = read_a; fs = right; i = i + 1 }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2. Short-circuit `&&` and `||` RHS under `cond_depth`
  let r2_and = check_source_files_full(
    "r17_and_cond",
    ["r17_and_cond.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 19 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let _ = flag && { fs = right; true }\n" +
      "  let a = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = a[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_and.diagnostics.length() == 0, check_result_to_json(r2_and.diagnostics))
  assert_eq(r2_and.tc.const_init_order[0], "B")
  assert_eq(r2_and.tc.const_init_order[1], "A")

  let r2_or = check_source_files_full(
    "r17_or_cond",
    ["r17_or_cond.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 23 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let _ = flag || { fs = right; false }\n" +
      "  let a = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = a[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_or.diagnostics.length() == 0, check_result_to_json(r2_or.diagnostics))
  assert_eq(r2_or.tc.const_init_order[0], "B")
  assert_eq(r2_or.tc.const_init_order[1], "A")

  // 3. `SLetTuple` simultaneous RHS evaluation (`let f = read_b; let (f, g) = (zero, f); g()`)
  let r3_ok = check_source_files_full(
    "r17_tuple_swap_ok",
    ["r17_tuple_swap_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 29 }\n" +
      "fn go() -> Int { let f = read_b; let (f, g) = (zero, f); let _ = f; g() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r17_tuple_swap_cyc",
    ["r17_tuple_swap_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let f = read_a; let (f, g) = (zero, f); let _ = f; g() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Escaping anon closure calling named closure `h()` + direct closure arg to `ignore_cb` vs `apply`
  let r4_esc = check_source_files_full(
    "r17_esc_cb_ok",
    ["r17_esc_cb_ok.pion"],
    [
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 31 }\n" +
      "fn mk(f : () -> Int) -> () -> Int { let h = fn() -> Int { f() }; fn() -> Int { h() } }\n" +
      "let A : Int = mk(read_b)()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_esc.diagnostics.length() == 0, check_result_to_json(r4_esc.diagnostics))
  assert_eq(r4_esc.tc.const_init_order[0], "B")
  assert_eq(r4_esc.tc.const_init_order[1], "A")

  let r4_esc_cyc = check_source_files_full(
    "r17_esc_cb_cyc",
    ["r17_esc_cb_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn mk(f : () -> Int) -> () -> Int { let h = fn() -> Int { f() }; fn() -> Int { h() } }\n" +
      "let A : Int = mk(read_a)()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_esc_cyc.diagnostics.length() >= 1 && r4_esc_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_esc_cyc.diagnostics),
  )

  let r4_ign = check_source_files_full(
    "r17_ign_cb_ok",
    ["r17_ign_cb_ok.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn ignore_cb(_f : () -> Int) -> Int { 1 }\n" +
      "fn relay(f : () -> Int) -> Int { let h = fn() -> Int { f() }; ignore_cb(fn() -> Int { h() }) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ign.diagnostics.length() == 0, check_result_to_json(r4_ign.diagnostics))

  let r4_app = check_source_files_full(
    "r17_app_cb_cyc",
    ["r17_app_cb_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn apply(f : () -> Int) -> Int { f() }\n" +
      "fn relay(f : () -> Int) -> Int { let h = fn() -> Int { f() }; apply(fn() -> Int { h() }) }\n" +
      "let A : Int = relay(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_app.diagnostics.length() >= 1 && r4_app.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_app.diagnostics),
  )
}

test "j1.r18: 9-step shift loop fixed-point, while-cond & SFor back-edge, match guard cond_depth & SLetTuple block/if eval" {
  // 1. 9-step shift chain (`f0..f8 -> right`) converges past 8 rounds & writes `read_b` into `right`
  let r1_ok = check_source_files_full(
    "r18_shift9_ok",
    ["r18_shift9_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 17 }\n" +
      "fn go() -> Int {\n" +
      "  let mut f0 = [zero]; let mut f1 = [zero]; let mut f2 = [zero]\n" +
      "  let mut f3 = [zero]; let mut f4 = [zero]; let mut f5 = [zero]\n" +
      "  let mut f6 = [zero]; let mut f7 = [zero]; let mut f8 = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut i = 0\n" +
      "  while i < 10 {\n" +
      "    f0[0] = read_b\n" +
      "    f0 = f1; f1 = f2; f2 = f3; f3 = f4; f4 = f5; f5 = f6; f6 = f7; f7 = f8; f8 = right\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let r1_cyc = check_source_files_full(
    "r18_shift9_cyc",
    ["r18_shift9_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut f0 = [zero]; let mut f1 = [zero]; let mut f2 = [zero]\n" +
      "  let mut f3 = [zero]; let mut f4 = [zero]; let mut f5 = [zero]\n" +
      "  let mut f6 = [zero]; let mut f7 = [zero]; let mut f8 = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut i = 0\n" +
      "  while i < 10 {\n" +
      "    f0[0] = read_a\n" +
      "    f0 = f1; f1 = f2; f2 = f3; f3 = f4; f4 = f5; f5 = f6; f6 = f7; f7 = f8; f8 = right\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2a. `while ({ fs[0] = read_b; i < 1 })` back-edge condition evaluation
  let r2a_ok = check_source_files_full(
    "r18_wcond_ok",
    ["r18_wcond_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 19 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let mut i = 0\n" +
      "  while ({ fs[0] = read_b; i < 1 }) { fs = right; i = i + 1 }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2a_ok.diagnostics.length() == 0, check_result_to_json(r2a_ok.diagnostics))
  assert_eq(r2a_ok.tc.const_init_order[0], "B")
  assert_eq(r2a_ok.tc.const_init_order[1], "A")

  // 2b. C-style `for let mut fs = left; i < 2; i = i + 1 { fs[0] = read_b; fs = right }`
  let r2b_ok = check_source_files_full(
    "r18_sfor_ok",
    ["r18_sfor_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 23 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut i = 0\n" +
      "  for let mut fs = left; i < 2; i = i + 1 { fs[0] = read_b; fs = right }\n" +
      "  let f = right[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2b_ok.diagnostics.length() == 0, check_result_to_json(r2b_ok.diagnostics))
  assert_eq(r2b_ok.tc.const_init_order[0], "B")
  assert_eq(r2b_ok.tc.const_init_order[1], "A")

  // 3. `EMatch` guard under `cond_depth` (`flag = false` preserves `left`)
  let r3_ok = check_source_files_full(
    "r18_mguard_ok",
    ["r18_mguard_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 29 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let _ = match flag { true if { fs = right; true } => 1; _ => 0 }\n" +
      "  let a = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = a[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  // 4. `SLetTuple` with block & `if` RHS preserves full `SigLocalLetEval`
  let r4_blk = check_source_files_full(
    "r18_tup_blk_ok",
    ["r18_tup_blk_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 31 }\n" +
      "fn go() -> Int { let f = read_b; let (f, g) = { let t = f; (zero, t) }; let _ = f; g() }\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_blk.diagnostics.length() == 0, check_result_to_json(r4_blk.diagnostics))
  assert_eq(r4_blk.tc.const_init_order[0], "B")
  assert_eq(r4_blk.tc.const_init_order[1], "A")

  let r4_if = check_source_files_full(
    "r18_tup_if_ok",
    ["r18_tup_if_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 37 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let f = read_b\n" +
      "  let (f, g) = if flag { (zero, zero) } else { (zero, f) }\n" +
      "  let _ = f\n" +
      "  g()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_if.diagnostics.length() == 0, check_result_to_json(r4_if.diagnostics))
  assert_eq(r4_if.tc.const_init_order[0], "B")
  assert_eq(r4_if.tc.const_init_order[1], "A")

  let r4_cyc = check_source_files_full(
    "r18_tup_blk_cyc",
    ["r18_tup_blk_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let f = read_a; let (f, g) = { (zero, f) }; let _ = f; g() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

  // 5. Pure function-variable loop shift chain (`f0 = f1; f1 = read_b`) without containers
  let r5_ok = check_source_files_full(
    "r18_fnshift_ok",
    ["r18_fnshift_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 47 }\n" +
      "fn go() -> Int {\n" +
      "  let mut f0 = zero\n" +
      "  let mut f1 = zero\n" +
      "  let mut i = 0\n" +
      "  while i < 2 { f0 = f1; f1 = read_b; i = i + 1 }\n" +
      "  f0()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5_ok.diagnostics.length() == 0, check_result_to_json(r5_ok.diagnostics))
  assert_eq(r5_ok.tc.const_init_order[0], "B")
  assert_eq(r5_ok.tc.const_init_order[1], "A")

  let r5_cyc = check_source_files_full(
    "r18_fnshift_cyc",
    ["r18_fnshift_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mut f0 = zero\n" +
      "  let mut f1 = zero\n" +
      "  let mut i = 0\n" +
      "  while i < 2 { f0 = f1; f1 = read_a; i = i + 1 }\n" +
      "  f0()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5_cyc.diagnostics.length() >= 1 && r5_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5_cyc.diagnostics),
  )

  // 6. `SLetTuple` with `if` branch reassigning outer `mut fs` must run under `cond_depth + 1`
  let r6_ok = check_source_files_full(
    "r18_tup_if_cond_ok",
    ["r18_tup_if_cond_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 53 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let (_a, _b) = if flag { fs = right; (zero, zero) } else { (zero, zero) }\n" +
      "  let alias = fs\n" +
      "  left[0] = read_b\n" +
      "  let f = alias[0]\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r6_ok.diagnostics.length() == 0, check_result_to_json(r6_ok.diagnostics))
  assert_eq(r6_ok.tc.const_init_order[0], "B")
  assert_eq(r6_ok.tc.const_init_order[1], "A")
}

///|
test "j1.r19 fallback cslot merge, closure loop rescan, single-pass SLetTuple, match payload binding" {
  // 1. 65-step shift chain (> 64-round cap): fallback must propagate cslot targets to immutable `right`
  let sb1 = StringBuilder()
  sb1.write_string("fn zero() -> Int { 0 }\nfn read_b() -> Int { B }\nfn make_b() -> Int { 61 }\nfn go() -> Int {\n")
  let mut k = 0
  while k < 65 {
    sb1.write_string("  let mut f" + k.to_string() + " = [zero]\n")
    k = k + 1
  }
  sb1.write_string("  let right = [zero]\n  let mut i = 0\n  while i < 66 {\n    f0[0] = read_b\n")
  k = 0
  while k < 64 {
    sb1.write_string("    f" + k.to_string() + " = f" + (k + 1).to_string() + "\n")
    k = k + 1
  }
  sb1.write_string("    f64 = right\n    i = i + 1\n  }\n  right[0]()\n}\nlet A : Int = go()\nlet B : Int = make_b()\npub fn main() -> Int { A }\n")
  let r1_ok = check_source_files_full("r19_shift65_ok", ["r19_shift65_ok.pion"], [sb1.to_string()])
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let sb1c = StringBuilder()
  sb1c.write_string("fn zero() -> Int { 0 }\nfn read_a() -> Int { A }\nfn go() -> Int {\n")
  k = 0
  while k < 65 {
    sb1c.write_string("  let mut f" + k.to_string() + " = [zero]\n")
    k = k + 1
  }
  sb1c.write_string("  let right = [zero]\n  let mut i = 0\n  while i < 66 {\n    f0[0] = read_a\n")
  k = 0
  while k < 64 {
    sb1c.write_string("    f" + k.to_string() + " = f" + (k + 1).to_string() + "\n")
    k = k + 1
  }
  sb1c.write_string("    f64 = right\n    i = i + 1\n  }\n  right[0]()\n}\nlet A : Int = go()\npub fn main() -> Int { A }\n")
  let r1_cyc = check_source_files_full("r19_shift65_cyc", ["r19_shift65_cyc.pion"], [sb1c.to_string()])
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2. Closure inside loop capturing loop-varying `a = fs` must re-scan & update in place
  let r2_ok = check_source_files_full(
    "r19_cb_loop_ok",
    ["r19_cb_loop_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 67 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let mut i = 0\n" +
      "  while i < 2 {\n" +
      "    let a = fs\n" +
      "    let install = fn() -> Unit { a[0] = read_b }\n" +
      "    install()\n" +
      "    fs = right\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r19_cb_loop_cyc",
    ["r19_cb_loop_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let mut i = 0\n" +
      "  while i < 2 {\n" +
      "    let a = fs\n" +
      "    let install = fn() -> Unit { a[0] = read_a }\n" +
      "    install()\n" +
      "    fs = right\n" +
      "    i = i + 1\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. Single-pass `SLetTuple` preserves pre-mutation binding `{ let old = fs; fs = right; (old, 0) }`
  let r3_ok = check_source_files_full(
    "r19_tup_1pass_ok",
    ["r19_tup_1pass_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 71 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let (saved, _n) = { let old = fs; fs = right; (old, 0) }\n" +
      "  let _ = fs\n" +
      "  left[0] = read_b\n" +
      "  saved[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r19_tup_1pass_cyc",
    ["r19_tup_1pass_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut fs = left\n" +
      "  let (saved, _n) = { let old = fs; fs = right; (old, 0) }\n" +
      "  let _ = fs\n" +
      "  left[0] = read_a\n" +
      "  saved[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. `EMatch` pattern payload binding (direct `match Some(left)` and indirect `let opt = Some(left); match opt`)
  let r4_ok = check_source_files_full(
    "r19_match_pat_ok",
    ["r19_match_pat_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 73 }\n" +
      "fn go_direct() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let (saved, _n) = match Some(left) { Some(t) => (t, 0), None => (right, 0) }\n" +
      "  left[0] = read_b\n" +
      "  saved[0]()\n" +
      "}\n" +
      "fn go_indirect() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  left[0] = read_b\n" +
      "  match opt { Some(t) => t[0](), None => 0 }\n" +
      "}\n" +
      "let A : Int = go_direct() + go_indirect()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ok.diagnostics.length() == 0, check_result_to_json(r4_ok.diagnostics))
  assert_eq(r4_ok.tc.const_init_order[0], "B")
  assert_eq(r4_ok.tc.const_init_order[1], "A")

  let r4_cyc = check_source_files_full(
    "r19_match_pat_cyc",
    ["r19_match_pat_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  left[0] = read_a\n" +
      "  match opt { Some(t) => t[0](), None => 0 }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )
}

///|
test "j1.r20 two-phase pat bind, positional payload_evals, is/guard cond pat bind & acyclic SigCbState" {
  // 1. Multi-field pattern must evaluate all fields before committing (no shadowing of outer `right`)
  let r1_ok = check_source_files_full(
    "r20_shadow_pat_ok",
    ["r20_shadow_pat_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 71 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  match (left, right) {\n" +
      "    (right, dst) => {\n" +
      "      let _ = right\n" +
      "      dst[0] = read_b\n" +
      "    }\n" +
      "    _ => ()\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let r1_cyc = check_source_files_full(
    "r20_shadow_pat_cyc",
    ["r20_shadow_pat_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  match (left, right) {\n" +
      "    (right, dst) => {\n" +
      "      let _ = right\n" +
      "      dst[0] = read_a\n" +
      "    }\n" +
      "    _ => ()\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  // 2. Indirect multi-payload variant preserves per-position payload_evals (no false cycle on `b[0]()`)
  let r2_ok = check_source_files_full(
    "r20_pos_payload_ok",
    ["r20_pos_payload_ok.pion"],
    [
      "enum Pair {\n" +
      "  Both(Array[() -> Int], Array[() -> Int])\n" +
      "}\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let pair = Pair::Both(left, right)\n" +
      "  match pair {\n" +
      "    Pair::Both(a, b) => {\n" +
      "      a[0] = read_a\n" +
      "      b[0]()\n" +
      "    }\n" +
      "  }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))

  let r2_cyc = check_source_files_full(
    "r20_pos_payload_cyc",
    ["r20_pos_payload_cyc.pion"],
    [
      "enum Pair {\n" +
      "  Both(Array[() -> Int], Array[() -> Int])\n" +
      "}\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let pair = Pair::Both(left, right)\n" +
      "  match pair {\n" +
      "    Pair::Both(a, b) => {\n" +
      "      let _ = b\n" +
      "      a[0] = read_a\n" +
      "      a[0]()\n" +
      "    }\n" +
      "  }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. `if opt is Some(t)` and `guard opt is Some(t)` bind pattern payload identity
  let r3a_ok = check_source_files_full(
    "r20_if_is_ok",
    ["r20_if_is_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 79 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  let (dst, _n) = if opt is Some(t) { (t, 0) } else { (right, 0) }\n" +
      "  dst[0] = read_b\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3a_ok.diagnostics.length() == 0, check_result_to_json(r3a_ok.diagnostics))
  assert_eq(r3a_ok.tc.const_init_order[0], "B")
  assert_eq(r3a_ok.tc.const_init_order[1], "A")

  let r3a_cyc = check_source_files_full(
    "r20_if_is_cyc",
    ["r20_if_is_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  let (dst, _n) = if opt is Some(t) { (t, 0) } else { (right, 0) }\n" +
      "  dst[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3a_cyc.diagnostics.length() >= 1 && r3a_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3a_cyc.diagnostics),
  )

  let r3b_ok = check_source_files_full(
    "r20_guard_is_ok",
    ["r20_guard_is_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 83 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  guard opt is Some(t) else { return 0 }\n" +
      "  t[0] = read_b\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3b_ok.diagnostics.length() == 0, check_result_to_json(r3b_ok.diagnostics))
  assert_eq(r3b_ok.tc.const_init_order[0], "B")
  assert_eq(r3b_ok.tc.const_init_order[1], "A")

  let r3b_cyc = check_source_files_full(
    "r20_guard_is_cyc",
    ["r20_guard_is_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  guard opt is Some(t) else { return 0 }\n" +
      "  t[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3b_cyc.diagnostics.length() >= 1 && r3b_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3b_cyc.diagnostics),
  )

  // 4. Repeatedly build signatures with loop closures (exercises acyclic SigCbState)
  let mut rep = 0
  while rep < 10 {
    let rr = check_source_files_full(
      "r20_cb_acyclic",
      ["r20_cb_acyclic.pion"],
      [
        "fn zero() -> Int { 0 }\n" +
        "fn read_b() -> Int { B }\n" +
        "fn make_b() -> Int { 89 }\n" +
        "fn go() -> Int {\n" +
        "  let left = [zero]\n" +
        "  let right = [zero]\n" +
        "  let mut fs = left\n" +
        "  let mut i = 0\n" +
        "  while i < 2 {\n" +
        "    let a = fs\n" +
        "    let install = fn() -> Unit { a[0] = read_b }\n" +
        "    install()\n" +
        "    fs = right\n" +
        "    i = i + 1\n" +
        "  }\n" +
        "  right[0]()\n" +
        "}\n" +
        "let A : Int = go()\n" +
        "let B : Int = make_b()\n" +
        "pub fn main() -> Int { A }\n",
      ],
    )
    assert_true(rr.diagnostics.length() == 0, check_result_to_json(rr.diagnostics))
    assert_eq(rr.tc.const_init_order[0], "B")
    rep = rep + 1
  }

  // 5. Opus (a): indirect tuple match `let p = (left, right); match p { (a, b) => b[0]() }`
  let r5_ok = check_source_files_full(
    "r20_tup_match_ok",
    ["r20_tup_match_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 91 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let p = (left, right)\n" +
      "  right[0] = read_b\n" +
      "  match p { (_a, b) => b[0](), _ => 0 }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5_ok.diagnostics.length() == 0, check_result_to_json(r5_ok.diagnostics))
  assert_eq(r5_ok.tc.const_init_order[0], "B")
  assert_eq(r5_ok.tc.const_init_order[1], "A")

  // 6. Opus (b): `if opt is Some(t) && t[0]() == 0` binds `t` on RHS of `&&`
  let r6_ok = check_source_files_full(
    "r20_and_is_ok",
    ["r20_and_is_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 97 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  left[0] = read_b\n" +
      "  if opt is Some(t) && t[0]() == 97 { 1 } else { 0 }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r6_ok.diagnostics.length() == 0, check_result_to_json(r6_ok.diagnostics))
  assert_eq(r6_ok.tc.const_init_order[0], "B")
  assert_eq(r6_ok.tc.const_init_order[1], "A")

  let r6_cyc = check_source_files_full(
    "r20_and_is_cyc",
    ["r20_and_is_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = Some(left)\n" +
      "  left[0] = read_a\n" +
      "  if opt is Some(t) && t[0]() == 0 { 1 } else { 0 }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r6_cyc.diagnostics.length() >= 1 && r6_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r6_cyc.diagnostics),
  )

  // 7. Opus (c): `let opt = if flag { Some(left) } else { None }; match opt { Some(t) => t[0](), None => 0 }`
  let r7_ok = check_source_files_full(
    "r20_if_ctor_ok",
    ["r20_if_ctor_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 101 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = if flag { Some(left) } else { None }\n" +
      "  left[0] = read_b\n" +
      "  match opt { Some(t) => t[0](), None => 0 }\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r7_ok.diagnostics.length() == 0, check_result_to_json(r7_ok.diagnostics))
  assert_eq(r7_ok.tc.const_init_order[0], "B")
  assert_eq(r7_ok.tc.const_init_order[1], "A")

  let r7_cyc = check_source_files_full(
    "r20_if_ctor_cyc",
    ["r20_if_ctor_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = if flag { Some(left) } else { None }\n" +
      "  left[0] = read_a\n" +
      "  match opt { Some(t) => t[0](), None => 0 }\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r7_cyc.diagnostics.length() >= 1 && r7_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r7_cyc.diagnostics),
  )
}

///|
test "j1.r20b ground-truth ctor_call & cslot_unknown write/method propagation" {
  // 1a. PascalCase top-level fn `Mutate(left)` must NOT be treated as variant ctor
  let r1a = check_source_files_full(
    "r20b_pascal_fn_cyc",
    ["r20b_pascal_fn_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn Mutate(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  Mutate(left)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1a.diagnostics.length() >= 1 && r1a.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1a.diagnostics),
  )

  // 1b. PascalCase top-level closure const `Wrap(left)` must NOT be treated as variant ctor
  let r1b = check_source_files_full(
    "r20b_pascal_const_cyc",
    ["r20b_pascal_const_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let Wrap : (Array[() -> Int]) -> Unit = fn(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  Wrap(left)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1b.diagnostics.length() >= 1 && r1b.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1b.diagnostics),
  )

  // 1c. PascalCase static method `S::Mutate(left)` must NOT be treated as variant ctor
  let r1c = check_source_files_full(
    "r20b_pascal_method_cyc",
    ["r20b_pascal_method_cyc.pion"],
    [
      "struct S { x : Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn S::Mutate(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  S::Mutate(left)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1c.diagnostics.length() >= 1 && r1c.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1c.diagnostics),
  )

  // 2. Single-letter variant `enum E { A(Array[() -> Int], Array[() -> Int]) }` preserves positional payload_evals
  let r2_ok = check_source_files_full(
    "r20b_1char_var_ok",
    ["r20b_1char_var_ok.pion"],
    [
      "enum E {\n" +
      "  V(Array[() -> Int], Array[() -> Int])\n" +
      "}\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let e = V(left, right)\n" +
      "  match e {\n" +
      "    V(a, b) => {\n" +
      "      a[0] = read_a\n" +
      "      b[0]()\n" +
      "    }\n" +
      "  }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))

  let r2_cyc = check_source_files_full(
    "r20b_1char_var_cyc",
    ["r20b_1char_var_cyc.pion"],
    [
      "enum E {\n" +
      "  V(Array[() -> Int], Array[() -> Int])\n" +
      "}\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let e = V(left, right)\n" +
      "  match e {\n" +
      "    V(a, b) => {\n" +
      "      let _ = b\n" +
      "      a[0] = read_a\n" +
      "      a[0]()\n" +
      "    }\n" +
      "  }\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. `cslot_unknown` index write via `match opt` where `opt = if flag { Some(left) } else { None }`
  let r3_cyc = check_source_files_full(
    "r20b_unk_write_cyc",
    ["r20b_unk_write_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = if flag { Some(left) } else { None }\n" +
      "  match opt {\n" +
      "    Some(dst) => { dst[0] = read_a }\n" +
      "    None => ()\n" +
      "  }\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. `cslot_unknown` method call `dst.push(read_a)` via `match opt`
  let r4_cyc = check_source_files_full(
    "r20b_unk_push_cyc",
    ["r20b_unk_push_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let opt = if flag { Some(left) } else { None }\n" +
      "  match opt {\n" +
      "    Some(dst) => { dst.push(read_a) }\n" +
      "    None => ()\n" +
      "  }\n" +
      "  left[1]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

  // 5. `let dst = if flag { left } else { right }; dst[0] = read_b; left[0]()` (ok + cycle)
  let r5_ok = check_source_files_full(
    "r20b_if_dst_ok",
    ["r20b_if_dst_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 107 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let dst = if flag { left } else { right }\n" +
      "  dst[0] = read_b\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5_ok.diagnostics.length() == 0, check_result_to_json(r5_ok.diagnostics))
  assert_eq(r5_ok.tc.const_init_order[0], "B")
  assert_eq(r5_ok.tc.const_init_order[1], "A")

  let r5_cyc = check_source_files_full(
    "r20b_if_dst_cyc",
    ["r20b_if_dst_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let dst = if flag { left } else { right }\n" +
      "  dst[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5_cyc.diagnostics.length() >= 1 && r5_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5_cyc.diagnostics),
  )
}

///|
test "j1.r21 hot/cold ctor? fallback, Factory::V guard, SLetTuple payload_evals, extract_callable if/match & precise branch cslots" {
  // 1. Opus hot/cold consistency: emit_file_sig_entries (no tc) flags `has_ambiguous_method` on custom enum ctors
  let wrap_src =
    "enum W {\n  Wrap(Array[() -> Int])\n}\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 7 }\n" +
    "fn go() -> Int {\n" +
    "  let arr = [zero]\n" +
    "  let w = Wrap(arr)\n" +
    "  arr[0] = read_b\n" +
    "  match w { Wrap(t) => t[0]() }\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n"
  let p_wrap = parse_source("r21_wrap.pion", wrap_src)
  assert_true(p_wrap.diagnostics.length() == 0, "parse r21_wrap")
  let hot_plan = compute_const_init_plan_from_sigs([emit_file_sig_entries(p_wrap.file)])
  assert_true(hot_plan.has_ambiguous_method, "hot path must flag ctor? fallback on Wrap(arr)")
  let r1_ok = check_source_files_full("r21_wrap_ok", ["r21_wrap_ok.pion"], [wrap_src])
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  // 2. Astra #1: static method `Factory::V(left, right)` returning `E::V(right)` must NOT be treated as ctor
  let r2_ok = check_source_files_full(
    "r21_factory_v_ok",
    ["r21_factory_v_ok.pion"],
    [
      "enum E {\n  V(Array[() -> Int])\n}\n" +
      "struct Factory { x : Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 19 }\n" +
      "fn Factory::V(_l : Array[() -> Int], r : Array[() -> Int]) -> E { E::V(r) }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  match Factory::V(left, right) {\n" +
      "    V(dst) => { dst[0] = read_b }\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r21_factory_v_cyc",
    ["r21_factory_v_cyc.pion"],
    [
      "enum E {\n  V(Array[() -> Int])\n}\n" +
      "struct Factory { x : Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn Factory::V(_l : Array[() -> Int], r : Array[() -> Int]) -> E { E::V(r) }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  match Factory::V(left, right) {\n" +
      "    V(dst) => { dst[0] = read_a }\n" +
      "  }\n" +
      "  right[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. Astra #2: `let p = (left, right); let (dst, _u) = p; dst[0] = read_b; left[0]()`
  let r3_ok = check_source_files_full(
    "r21_tup_ident_ok",
    ["r21_tup_ident_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 23 }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let p = (left, right)\n" +
      "  let (dst, _u) = p\n" +
      "  dst[0] = read_b\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r21_tup_ident_cyc",
    ["r21_tup_ident_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let p = (left, right)\n" +
      "  let (dst, _u) = p\n" +
      "  dst[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Astra #3: `let f = match opt { Some(t) => t, None => zero }; f()` and `if opt is Some(t) { t } else { zero }; f()`
  let r4_ok = check_source_files_full(
    "r21_extract_if_match_ok",
    ["r21_extract_if_match_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 29 }\n" +
      "fn go_m() -> Int {\n" +
      "  let opt = Some(read_b)\n" +
      "  let f = match opt { Some(t) => t, None => zero }\n" +
      "  f()\n" +
      "}\n" +
      "fn go_i() -> Int {\n" +
      "  let opt = Some(read_b)\n" +
      "  let f = if opt is Some(t) { t } else { zero }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go_m() + go_i()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ok.diagnostics.length() == 0, check_result_to_json(r4_ok.diagnostics))
  assert_eq(r4_ok.tc.const_init_order[0], "B")
  assert_eq(r4_ok.tc.const_init_order[1], "A")

  let r4_nocall = check_source_files_full(
    "r21_extract_nocall_ok",
    ["r21_extract_nocall_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let opt = Some(read_a)\n" +
      "  let f = match opt { Some(t) => t, None => zero }\n" +
      "  let g = if opt is Some(t) { t } else { zero }\n" +
      "  let _ = f\n" +
      "  let _ = g\n" +
      "  0\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_nocall.diagnostics.length() == 0, check_result_to_json(r4_nocall.diagnostics))

  let r4_cyc_m = check_source_files_full(
    "r21_extract_match_cyc",
    ["r21_extract_match_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let opt = Some(read_a)\n" +
      "  let f = match opt { Some(t) => t, None => zero }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc_m.diagnostics.length() >= 1 && r4_cyc_m.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc_m.diagnostics),
  )

  let r4_cyc_i = check_source_files_full(
    "r21_extract_if_cyc",
    ["r21_extract_if_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let opt = Some(read_a)\n" +
      "  let f = if opt is Some(t) { t } else { zero }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc_i.diagnostics.length() >= 1 && r4_cyc_i.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc_i.diagnostics),
  )

  // 5. Astra #4: precise branch cslots (`third[0]()` ok + `install(dst)` cycle) + opaque `pick(left)` cslot_unknown
  let r5a_ok = check_source_files_full(
    "r21_branch_third_ok",
    ["r21_branch_third_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let third = [zero]\n" +
      "  let dst = if flag { left } else { right }\n" +
      "  dst[0] = read_a\n" +
      "  third[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5a_ok.diagnostics.length() == 0, check_result_to_json(r5a_ok.diagnostics))

  let r5b_ok = check_source_files_full(
    "r21_branch_install_ok",
    ["r21_branch_install_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 31 }\n" +
      "fn install(a : Array[() -> Int]) -> Unit { a[0] = read_b }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let dst = if flag { left } else { right }\n" +
      "  install(dst)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5b_ok.diagnostics.length() == 0, check_result_to_json(r5b_ok.diagnostics))
  assert_eq(r5b_ok.tc.const_init_order[0], "B")
  assert_eq(r5b_ok.tc.const_init_order[1], "A")

  let r5b_cyc = check_source_files_full(
    "r21_branch_install_cyc",
    ["r21_branch_install_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let dst = if flag { left } else { right }\n" +
      "  install(dst)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5b_cyc.diagnostics.length() >= 1 && r5b_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5b_cyc.diagnostics),
  )

  let r5c_cyc = check_source_files_full(
    "r21_opaque_pick_cyc",
    ["r21_opaque_pick_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn pick(x : Array[() -> Int]) -> Array[() -> Int] { x }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let t = pick(left)\n" +
      "  t[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5c_cyc.diagnostics.length() >= 1 && r5c_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5c_cyc.diagnostics),
  )
}

///|
test "j1.r22 lowercase enum ctor?: fallback, Array::new fresh cslot, branch call-arg, extract_callable cond_depth & block SLetTuple/SGuard" {
  // 1. Lowercase enum variants: `wrap(arr)`, `Box::wrap(arr)`, `FWrap::wrap(read_b)` trigger hot-path `has_ambiguous_method`
  let lwrap_src =
    "enum Box {\n  wrap(Array[() -> Int])\n}\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 11 }\n" +
    "fn go1() -> Int {\n" +
    "  let arr = [zero]\n" +
    "  let w = wrap(arr)\n" +
    "  arr[0] = read_b\n" +
    "  match w { wrap(t) => t[0]() }\n" +
    "}\n" +
    "fn go2() -> Int {\n" +
    "  let arr = [zero]\n" +
    "  let w = Box::wrap(arr)\n" +
    "  arr[0] = read_b\n" +
    "  match w { Box::wrap(t) => t[0]() }\n" +
    "}\n" +
    "let A : Int = go1() + go2()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n"
  let p_lw = parse_source("r22_lwrap.pion", lwrap_src)
  assert_true(p_lw.diagnostics.length() == 0, "parse r22_lwrap")
  let lw_plan = compute_const_init_plan_from_sigs([emit_file_sig_entries(p_lw.file)])
  assert_true(lw_plan.has_ambiguous_method, "hot path must flag lowercase enum variant wrap")
  let r1_ok = check_source_files_full("r22_lwrap_ok", ["r22_lwrap_ok.pion"], [lwrap_src])
  assert_true(r1_ok.diagnostics.length() == 0, check_result_to_json(r1_ok.diagnostics))
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let lfwrap_src =
    "enum FWrap {\n  wrap(() -> Int)\n}\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 17 }\n" +
    "fn go() -> Int {\n" +
    "  let w = FWrap::wrap(read_b)\n" +
    "  match w { FWrap::wrap(f) => f() }\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n"
  let p_lfw = parse_source("r22_lfwrap.pion", lfwrap_src)
  assert_true(p_lfw.diagnostics.length() == 0, "parse r22_lfwrap")
  let lfw_plan = compute_const_init_plan_from_sigs([emit_file_sig_entries(p_lfw.file)])
  assert_true(lfw_plan.has_ambiguous_method, "hot path must flag FWrap::wrap")
  let r1b_ok = check_source_files_full("r22_lfwrap_ok", ["r22_lfwrap_ok.pion"], [lfwrap_src])
  assert_true(r1b_ok.diagnostics.length() == 0, check_result_to_json(r1b_ok.diagnostics))
  assert_eq(r1b_ok.tc.const_init_order[0], "B")
  assert_eq(r1b_ok.tc.const_init_order[1], "A")

  // 2. Fresh builtin container `Array::new()` gets its own cslot (no false cycle on unrelated `left`)
  let r2_ok = check_source_files_full(
    "r22_arr_new_ok",
    ["r22_arr_new_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let left = [zero]\n" +
      "  let out : Array[() -> Int] = Array::new()\n" +
      "  out.push(read_a)\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))

  // 3. Direct branch expression as call argument `install(if flag { left } else { right })`
  let r3_ok = check_source_files_full(
    "r22_branch_arg_ok",
    ["r22_branch_arg_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 31 }\n" +
      "fn install(a : Array[() -> Int]) -> Unit { a[0] = read_b }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  install(if flag { left } else { right })\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_ok.diagnostics.length() == 0, check_result_to_json(r3_ok.diagnostics))
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_third = check_source_files_full(
    "r22_branch_arg_third_ok",
    ["r22_branch_arg_third_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let third = [zero]\n" +
      "  install(if flag { left } else { right })\n" +
      "  third[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r3_third.diagnostics.length() == 0, check_result_to_json(r3_third.diagnostics))

  let r3_cyc = check_source_files_full(
    "r22_branch_arg_cyc",
    ["r22_branch_arg_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn install(a : Array[() -> Int]) -> Unit { a[0] = read_a }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  install(if flag { left } else { right })\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(true)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Multi-statement branch in `let n = if flag { dst = right; 1 } else { 0 }` must NOT clobber outer `mut dst`
  let r4_ok = check_source_files_full(
    "r22_cond_depth_extract_ok",
    ["r22_cond_depth_extract_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 37 }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut dst = left\n" +
      "  let _n = if flag { dst = right; 1 } else { 0 }\n" +
      "  dst[0] = read_b\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r4_ok.diagnostics.length() == 0, check_result_to_json(r4_ok.diagnostics))
  assert_eq(r4_ok.tc.const_init_order[0], "B")
  assert_eq(r4_ok.tc.const_init_order[1], "A")

  let r4_cyc = check_source_files_full(
    "r22_cond_depth_extract_cyc",
    ["r22_cond_depth_extract_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut dst = left\n" +
      "  let _n = if flag { dst = right; 1 } else { 0 }\n" +
      "  dst[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

  // 5. Block `SLetTuple` and `SGuard is` returning callback
  let r5_ok = check_source_files_full(
    "r22_blk_tup_guard_ok",
    ["r22_blk_tup_guard_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 41 }\n" +
      "fn go_t() -> Int {\n" +
      "  let p = (read_b, zero)\n" +
      "  let f = { let (g, _u) = p; g }\n" +
      "  f()\n" +
      "}\n" +
      "fn go_g() -> Int {\n" +
      "  let opt = Some(read_b)\n" +
      "  let f = { guard opt is Some(g) else { return 0 }; g }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go_t() + go_g()\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5_ok.diagnostics.length() == 0, check_result_to_json(r5_ok.diagnostics))
  assert_eq(r5_ok.tc.const_init_order[0], "B")
  assert_eq(r5_ok.tc.const_init_order[1], "A")

  let r5_nocall = check_source_files_full(
    "r22_blk_nocall_ok",
    ["r22_blk_nocall_ok.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let p = (read_a, zero)\n" +
      "  let f = { let (g, _u) = p; g }\n" +
      "  let opt = Some(read_a)\n" +
      "  let h = { guard opt is Some(g) else { return 0 }; g }\n" +
      "  let _ = f\n" +
      "  let _ = h\n" +
      "  0\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(r5_nocall.diagnostics.length() == 0, check_result_to_json(r5_nocall.diagnostics))

  let r5_cyc_t = check_source_files_full(
    "r22_blk_tup_cyc",
    ["r22_blk_tup_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let p = (read_a, zero)\n" +
      "  let f = { let (g, _u) = p; g }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5_cyc_t.diagnostics.length() >= 1 && r5_cyc_t.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5_cyc_t.diagnostics),
  )

  let r5_cyc_g = check_source_files_full(
    "r22_blk_guard_cyc",
    ["r22_blk_guard_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let opt = Some(read_a)\n" +
      "  let f = { guard opt is Some(g) else { return 0 }; g }\n" +
      "  f()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r5_cyc_g.diagnostics.length() >= 1 && r5_cyc_g.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r5_cyc_g.diagnostics),
  )
}

///|
fn assert_j1_cold_hot_parity(tag : String, src : String) -> CheckedPackage {
  let cr = check_source_files_full(tag, [tag + ".pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let pr = parse_source(tag + ".pion", src)
  assert_true(pr.diagnostics.length() == 0, "parse " + tag)
  let hot = compute_const_init_plan_from_sigs([emit_file_sig_entries(pr.file)])
  let cold = compute_const_init_plan_from_sigs([
    emit_file_sig_entries_resolved(pr.file, cr.tc.resolved_method_calls),
  ])
  if !hot.has_ambiguous_method && !hot.has_cycle {
    assert_eq(hot.order.length(), cold.order.length())
    let mut i = 0
    while i < hot.order.length() {
      assert_eq(hot.order[i], cold.order[i])
      i = i + 1
    }
    assert_eq(hot.plan_hash, cold.plan_hash)
  }
  cr
}

///|
test "j1.r23 hot/cold push & Option/Result parity, eval_let cond_depth & Array/FixedArray::make" {
  // 1. Opus hot/cold parity for `.push(read_b)` (no false B-before-A when uncalled)
  let r1 = assert_j1_cold_hot_parity(
    "r23_push_parity",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 11 }\n" +
    "fn go() -> Int {\n" +
    "  let arr : Array[() -> Int] = Array::new()\n" +
    "  arr.push(read_b)\n" +
    "  0\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A + B }\n",
  )
  assert_eq(r1.tc.const_init_order[0], "A")
  assert_eq(r1.tc.const_init_order[1], "B")

  // 2. Astra #1: `match flag { true => { dst = right; 1 }, false => 0 }; dst[0] = read_b; left[0]()`
  let r2_ok = assert_j1_cold_hot_parity(
    "r23_match_cond_depth_ok",
    "fn zero() -> Int { 0 }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 23 }\n" +
    "fn go(flag : Bool) -> Int {\n" +
    "  let left = [zero]\n" +
    "  let right = [zero]\n" +
    "  let mut dst = left\n" +
    "  let _n = match flag {\n" +
    "    true => { dst = right; 1 }\n" +
    "    false => 0\n" +
    "  }\n" +
    "  dst[0] = read_b\n" +
    "  left[0]()\n" +
    "}\n" +
    "let A : Int = go(false)\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  let r2_cyc = check_source_files_full(
    "r23_match_cond_depth_cyc",
    ["r23_match_cond_depth_cyc.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go(flag : Bool) -> Int {\n" +
      "  let left = [zero]\n" +
      "  let right = [zero]\n" +
      "  let mut dst = left\n" +
      "  let _n = match flag {\n" +
      "    true => { dst = right; 1 }\n" +
      "    false => 0\n" +
      "  }\n" +
      "  dst[0] = read_a\n" +
      "  left[0]()\n" +
      "}\n" +
      "let A : Int = go(false)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. Astra #2: `Option::Some(read_b)` / `Result::Ok(read_b)` / `Result::Err(read_b)` cold/hot parity == [A, B]
  let r3_opt = assert_j1_cold_hot_parity(
    "r23_opt_some_parity",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 29 }\n" +
    "fn go() -> Int { let _o = Option::Some(read_b); 0 }\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A + B }\n",
  )
  assert_eq(r3_opt.tc.const_init_order[0], "A")
  assert_eq(r3_opt.tc.const_init_order[1], "B")

  let r3_ok = assert_j1_cold_hot_parity(
    "r23_res_ok_parity",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 31 }\n" +
    "fn go() -> Int { let _r : Result[() -> Int, Int] = Result::Ok(read_b); 0 }\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A + B }\n",
  )
  assert_eq(r3_ok.tc.const_init_order[0], "A")
  assert_eq(r3_ok.tc.const_init_order[1], "B")

  let r3_err = assert_j1_cold_hot_parity(
    "r23_res_err_parity",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 37 }\n" +
    "fn go() -> Int { let _r : Result[Int, () -> Int] = Result::Err(read_b); 0 }\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A + B }\n",
  )
  assert_eq(r3_err.tc.const_init_order[0], "A")
  assert_eq(r3_err.tc.const_init_order[1], "B")

  // 4. Astra #3: `Array::make` & `FixedArray::make` — save-only ok, `xs[0]()` with `read_a` cycles, with `read_b` B before A
  let _r4a = assert_j1_cold_hot_parity(
    "r23_arr_make_save",
    "fn read_a() -> Int { A }\n" +
    "fn go() -> Int {\n" +
    "  let _xs = Array::make(1, read_a)\n" +
    "  let _ys = FixedArray::make(1, read_a)\n" +
    "  0\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "pub fn main() -> Int { A }\n",
  )

  let r4b_arr = check_source_files_full(
    "r23_arr_make_cyc",
    ["r23_arr_make_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let xs = Array::make(1, read_a); xs[0]() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4b_arr.diagnostics.length() >= 1 && r4b_arr.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4b_arr.diagnostics),
  )

  let r4b_fix = check_source_files_full(
    "r23_fix_make_cyc",
    ["r23_fix_make_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { let xs = FixedArray::make(1, read_a); xs[0]() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4b_fix.diagnostics.length() >= 1 && r4b_fix.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4b_fix.diagnostics),
  )

  let r4c = assert_j1_cold_hot_parity(
    "r23_make_read_b",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 41 }\n" +
    "fn go1() -> Int { let xs = Array::make(1, read_b); xs[0]() }\n" +
    "fn go2() -> Int { let xs = FixedArray::make(1, read_b); xs[0]() }\n" +
    "let A : Int = go1() + go2()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r4c.tc.const_init_order[0], "B")
  assert_eq(r4c.tc.const_init_order[1], "A")
}

///|
test "j1.r24 struct fn field push parity, direct Array/FixedArray::make index & param fill" {
  // 1. Astra #1: struct function field named `push` (`holder.push(read_a)`) MUST cycle;
  //    `holder.push(read_b)` MUST order B before A on both cold and hot paths;
  //    builtin `arr.push(read_a); 0` stays ok and `arr.push(read_b); 0` stays [A, B].
  let r1_cyc = check_source_files_full(
    "r24_holder_push_cyc",
    ["r24_holder_push_cyc.pion"],
    [
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ push: invoke }\n" +
      "  holder.push(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  let r1_ok = assert_j1_cold_hot_parity(
    "r24_holder_push_ok",
    "struct Holder { push : (() -> Int) -> Int }\n" +
    "fn invoke(f : () -> Int) -> Int { f() }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 53 }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ push: invoke }\n" +
    "  holder.push(read_b)\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  let _r1_arr = assert_j1_cold_hot_parity(
    "r24_arr_push_save",
    "fn read_a() -> Int { A }\n" +
    "fn go() -> Int {\n" +
    "  let arr : Array[() -> Int] = Array::new()\n" +
    "  arr.push(read_a)\n" +
    "  0\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // 2. Astra #2: direct indexing of temporary `Array::make(1, read_a)[0]()` / `FixedArray::make(1, read_a)[0]()`
  let r2_arr_cyc = check_source_files_full(
    "r24_arr_make_idx_cyc",
    ["r24_arr_make_idx_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { Array::make(1, read_a)[0]() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_arr_cyc.diagnostics.length() >= 1 && r2_arr_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_arr_cyc.diagnostics),
  )

  let r2_fix_cyc = check_source_files_full(
    "r24_fix_make_idx_cyc",
    ["r24_fix_make_idx_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int { FixedArray::make(1, read_a)[0]() }\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_fix_cyc.diagnostics.length() >= 1 && r2_fix_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_fix_cyc.diagnostics),
  )

  let r2_ok = assert_j1_cold_hot_parity(
    "r24_make_idx_ok",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 59 }\n" +
    "fn go1() -> Int { Array::make(1, read_b)[0]() }\n" +
    "fn go2() -> Int { FixedArray::make(1, read_b)[0]() }\n" +
    "let A : Int = go1() + go2()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  // 3. Astra #3: function param as fill value in `Array::make(1, f)` / `FixedArray::make(1, f)`
  let _r3_save = assert_j1_cold_hot_parity(
    "r24_param_make_save",
    "fn read_a() -> Int { A }\n" +
    "fn stash(f : () -> Int) -> Int {\n" +
    "  let _xs = Array::make(1, f)\n" +
    "  let _ys = FixedArray::make(1, f)\n" +
    "  0\n" +
    "}\n" +
    "let A : Int = stash(read_a)\n" +
    "pub fn main() -> Int { A }\n",
  )

  let r3_arr_cyc = check_source_files_full(
    "r24_param_arr_make_cyc",
    ["r24_param_arr_make_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn invoke(f : () -> Int) -> Int {\n" +
      "  let xs = Array::make(1, f)\n" +
      "  xs[0]()\n" +
      "}\n" +
      "let A : Int = invoke(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_arr_cyc.diagnostics.length() >= 1 && r3_arr_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_arr_cyc.diagnostics),
  )

  let r3_fix_cyc = check_source_files_full(
    "r24_param_fix_make_cyc",
    ["r24_param_fix_make_cyc.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn invoke(f : () -> Int) -> Int {\n" +
      "  let xs = FixedArray::make(1, f)\n" +
      "  xs[0]()\n" +
      "}\n" +
      "let A : Int = invoke(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_fix_cyc.diagnostics.length() >= 1 && r3_fix_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_fix_cyc.diagnostics),
  )

  let r3_ok = assert_j1_cold_hot_parity(
    "r24_param_make_ok",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 61 }\n" +
    "fn invoke1(f : () -> Int) -> Int { let xs = Array::make(1, f); xs[0]() }\n" +
    "fn invoke2(f : () -> Int) -> Int { let xs = FixedArray::make(1, f); xs[0]() }\n" +
    "let A : Int = invoke1(read_b) + invoke2(read_b)\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  // 4. Opus cold/hot parity expansion across R19-R22 valid samples
  let p_r21 = assert_j1_cold_hot_parity(
    "r24_parity_r21_tuple_if",
    "fn zero() -> Int { 0 }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 67 }\n" +
    "fn go(flag : Bool) -> Int {\n" +
    "  let (f, _g) = if flag { (read_b, zero) } else { (zero, read_b) }\n" +
    "  f()\n" +
    "}\n" +
    "let A : Int = go(true)\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(p_r21.tc.const_init_order[0], "B")
  assert_eq(p_r21.tc.const_init_order[1], "A")

  let p_r22_ctor = assert_j1_cold_hot_parity(
    "r24_parity_r22_local_ctor",
    "enum LocalWrap { Mk(() -> Int) }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 71 }\n" +
    "fn go() -> Int { let _w = LocalWrap::Mk(read_b); 0 }\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A + B }\n",
  )
  assert_eq(p_r22_ctor.tc.const_init_order[0], "A")
  assert_eq(p_r22_ctor.tc.const_init_order[1], "B")

  let p_r22_blk = assert_j1_cold_hot_parity(
    "r24_parity_r22_blk_guard",
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 73 }\n" +
    "fn go() -> Int {\n" +
    "  let opt = Some(read_b)\n" +
    "  let f = { guard opt is Some(g) else { return 0 }; g }\n" +
    "  f()\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(p_r22_blk.tc.const_init_order[0], "B")
  assert_eq(p_r22_blk.tc.const_init_order[1], "A")
}

///|
test "j1.r24b struct fn field shadowing unrelated method & 0-arg holder.run() / fire(holder)" {
  // 1. Unrelated `Other::push` in same pkg must NOT mask `Holder::{ push: invoke }; holder.push(read_a)`
  let r1_cyc = check_source_files_full(
    "r24b_other_push_cyc",
    ["r24b_other_push_cyc.pion"],
    [
      "struct Other { x : Int }\n" +
      "fn Other::push(self : Other, v : Int) -> Int { v }\n" +
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ push: invoke }\n" +
      "  holder.push(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  let r1_ok = assert_j1_cold_hot_parity(
    "r24b_other_push_ok",
    "struct Other { x : Int }\n" +
    "fn Other::push(self : Other, v : Int) -> Int { v }\n" +
    "struct Holder { push : (() -> Int) -> Int }\n" +
    "fn invoke(f : () -> Int) -> Int { f() }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 79 }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ push: invoke }\n" +
    "  holder.push(read_b)\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  // 2. Unrelated `Other::run` in same pkg must NOT mask `Holder::{ run: invoke }; holder.run(read_a)`
  let r2_cyc = check_source_files_full(
    "r24b_other_run_cyc",
    ["r24b_other_run_cyc.pion"],
    [
      "struct Other { x : Int }\n" +
      "fn Other::run(self : Other, v : Int) -> Int { v }\n" +
      "struct Holder { run : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ run: invoke }\n" +
      "  holder.run(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  let r2_ok = assert_j1_cold_hot_parity(
    "r24b_other_run_ok",
    "struct Other { x : Int }\n" +
    "fn Other::run(self : Other, v : Int) -> Int { v }\n" +
    "struct Holder { run : (() -> Int) -> Int }\n" +
    "fn invoke(f : () -> Int) -> Int { f() }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 83 }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ run: invoke }\n" +
    "  holder.run(read_b)\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r2_ok.tc.const_init_order[0], "B")
  assert_eq(r2_ok.tc.const_init_order[1], "A")

  // 3. 0-arg `Holder::{ run: read_a }; holder.run()` + helper `fire(Holder::{ run: read_a })`
  let r3a_cyc = check_source_files_full(
    "r24b_zero_arg_cyc",
    ["r24b_zero_arg_cyc.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ run: read_a }\n" +
      "  holder.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3a_cyc.diagnostics.length() >= 1 && r3a_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3a_cyc.diagnostics),
  )

  let r3a_ok = assert_j1_cold_hot_parity(
    "r24b_zero_arg_ok",
    "struct Holder { run : () -> Int }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 89 }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ run: read_b }\n" +
    "  holder.run()\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r3a_ok.tc.const_init_order[0], "B")
  assert_eq(r3a_ok.tc.const_init_order[1], "A")

  let r3b_cyc = check_source_files_full(
    "r24b_fire_holder_cyc",
    ["r24b_fire_holder_cyc.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn fire(h : Holder) -> Int { h.run() }\n" +
      "let A : Int = fire(Holder::{ run: read_a })\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3b_cyc.diagnostics.length() >= 1 && r3b_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3b_cyc.diagnostics),
  )

  let r3b_ok = assert_j1_cold_hot_parity(
    "r24b_fire_holder_ok",
    "struct Holder { run : () -> Int }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 97 }\n" +
    "fn fire(h : Holder) -> Int { h.run() }\n" +
    "let A : Int = fire(Holder::{ run: read_b })\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r3b_ok.tc.const_init_order[0], "B")
  assert_eq(r3b_ok.tc.const_init_order[1], "A")
}

///|
fn assert_j1_cold_hot_parity_files(
  tag : String,
  fnames : Array[String],
  srcs : Array[String],
) -> CheckedPackage {
  let cr = check_source_files_full(tag, fnames, srcs)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let hot_sigs : Array[String] = []
  let cold_sigs : Array[String] = []
  let mut i = 0
  while i < fnames.length() {
    let pr = parse_source(fnames[i], srcs[i])
    assert_true(pr.diagnostics.length() == 0, "parse " + fnames[i])
    hot_sigs.push(emit_file_sig_entries(pr.file))
    cold_sigs.push(emit_file_sig_entries_resolved(pr.file, cr.tc.resolved_method_calls))
    i = i + 1
  }
  let hot = compute_const_init_plan_from_sigs(hot_sigs)
  let cold = compute_const_init_plan_from_sigs(cold_sigs)
  if !hot.has_ambiguous_method && !hot.has_cycle {
    assert_eq(hot.order.length(), cold.order.length())
    let mut k = 0
    while k < hot.order.length() {
      assert_eq(hot.order[k], cold.order[k])
      k = k + 1
    }
    assert_eq(hot.plan_hash, cold.plan_hash)
  }
  cr
}

///|
test "j1.r25 dyn/generic trait dispatch, exact struct fn field projection, generic Holder[T].get & top-level const struct" {
  // 1. `dyn Read` & `via[T : Read]` dispatch must propagate `impl Read` deps (B before A + E_CONST_CYCLE)
  let r1_dyn_ok = assert_j1_cold_hot_parity(
    "r25_dyn_trait_ok",
    "trait Read { fn read(self : Self) -> Int }\n" +
    "struct R { x : Int }\n" +
    "impl Read for R { fn read(self : R) -> Int { B } }\n" +
    "fn via(x : dyn Read) -> Int { x.read() }\n" +
    "fn make_b() -> Int { 101 }\n" +
    "let A : Int = via(R::{ x: 0 } as dyn Read)\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r1_dyn_ok.tc.const_init_order[0], "B")
  assert_eq(r1_dyn_ok.tc.const_init_order[1], "A")

  let r1_dyn_cyc = check_source_files_full(
    "r25_dyn_trait_cyc",
    ["r25_dyn_trait_cyc.pion"],
    [
      "trait Read { fn read(self : Self) -> Int }\n" +
      "struct R { x : Int }\n" +
      "impl Read for R { fn read(self : R) -> Int { A } }\n" +
      "fn via(x : dyn Read) -> Int { x.read() }\n" +
      "let A : Int = via(R::{ x: 0 } as dyn Read)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_dyn_cyc.diagnostics.length() >= 1 && r1_dyn_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_dyn_cyc.diagnostics),
  )

  let r1_gen_ok = assert_j1_cold_hot_parity(
    "r25_gen_trait_ok",
    "trait Read { fn read(self : Self) -> Int }\n" +
    "struct R { x : Int }\n" +
    "impl Read for R { fn read(self : R) -> Int { B } }\n" +
    "fn via[T : Read](x : T) -> Int { x.read() }\n" +
    "fn make_b() -> Int { 103 }\n" +
    "let A : Int = via(R::{ x: 0 })\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r1_gen_ok.tc.const_init_order[0], "B")
  assert_eq(r1_gen_ok.tc.const_init_order[1], "A")

  let r1_gen_cyc = check_source_files_full(
    "r25_gen_trait_cyc",
    ["r25_gen_trait_cyc.pion"],
    [
      "trait Read { fn read(self : Self) -> Int }\n" +
      "struct R { x : Int }\n" +
      "impl Read for R { fn read(self : R) -> Int { A } }\n" +
      "fn via[T : Read](x : T) -> Int { x.read() }\n" +
      "let A : Int = via(R::{ x: 0 })\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_gen_cyc.diagnostics.length() >= 1 && r1_gen_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_gen_cyc.diagnostics),
  )

  // 2. Exact struct fn field projection: `Holder::{ run: zero, spare: read_a }; holder.run()` -> ok 0; swapped -> E_CONST_CYCLE
  let _r2_ok = assert_j1_cold_hot_parity(
    "r25_exact_field_ok",
    "struct Holder { run : () -> Int; spare : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ run: zero, spare: read_a }\n" +
    "  holder.run()\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "pub fn main() -> Int { A }\n",
  )

  let r2_cyc = check_source_files_full(
    "r25_exact_field_cyc",
    ["r25_exact_field_cyc.pion"],
    [
      "struct Holder { run : () -> Int; spare : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ run: read_a, spare: zero }\n" +
      "  holder.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. 2-file pkg `struct Holder[T] { get : T }` cold/hot parity (B before A) + cycle
  let r3_ok = assert_j1_cold_hot_parity_files(
    "r25_gen_get_ok",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder[T] { get : T }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 107 }\n" +
      "fn go() -> Int {\n" +
      "  let h : Holder[() -> Int] = Holder::{ get: read_b }\n" +
      "  h.get()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r3_ok.tc.const_init_order[0], "B")
  assert_eq(r3_ok.tc.const_init_order[1], "A")

  let r3_cyc = check_source_files_full(
    "r25_gen_get_cyc",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder[T] { get : T }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let h : Holder[() -> Int] = Holder::{ get: read_a }\n" +
      "  h.get()\n" +
      "}\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Top-level `let H : Holder = Holder::{ run: zero, spare: read_a }`: save ok, H.run() ok, H.spare() cycle, H.run() -> B before A
  let _r4_ok = assert_j1_cold_hot_parity(
    "r25_top_const_field_ok",
    "struct Holder { run : () -> Int; spare : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Holder = Holder::{ run: zero, spare: read_a }\n" +
    "let A : Int = H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  let r4_cyc = check_source_files_full(
    "r25_top_const_field_cyc",
    ["r25_top_const_field_cyc.pion"],
    [
      "struct Holder { run : () -> Int; spare : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Holder = Holder::{ run: zero, spare: read_a }\n" +
      "let A : Int = H.spare()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )

  let r4_ord = assert_j1_cold_hot_parity_files(
    "r25_top_const_field_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.run()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 109 }\n" +
      "let H : Holder = Holder::{ run: read_b }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_true(
    r4_ord.tc.const_init_order[0] == "B" || r4_ord.tc.const_init_order[1] == "B",
    "B must be before A",
  )
  assert_eq(r4_ord.tc.const_init_order[2], "A")
}

///|
test "j1.r25b non-exact struct fn field init & top-level #cfdef callback param propagation" {
  // 1. Non-exact struct field init `get_invoker()`: local + direct literal must cycle on `read_a`
  let r1_local = check_source_files_full(
    "r25b_nonexact_local_cyc",
    ["r25b_nonexact_local_cyc.pion"],
    [
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn get_invoker() -> ((() -> Int) -> Int) { invoke }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let holder = Holder::{ push: get_invoker() }\n" +
      "  holder.push(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_local.diagnostics.length() >= 1 && r1_local.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_local.diagnostics),
  )

  let r1_lit = check_source_files_full(
    "r25b_nonexact_lit_cyc",
    ["r25b_nonexact_lit_cyc.pion"],
    [
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn get_invoker() -> ((() -> Int) -> Int) { invoke }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  Holder::{ push: get_invoker() }.push(read_a)\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_lit.diagnostics.length() >= 1 && r1_lit.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_lit.diagnostics),
  )

  let r1_ok = assert_j1_cold_hot_parity(
    "r25b_nonexact_ok",
    "struct Holder { push : (() -> Int) -> Int }\n" +
    "fn invoke(f : () -> Int) -> Int { f() }\n" +
    "fn get_invoker() -> ((() -> Int) -> Int) { invoke }\n" +
    "fn read_b() -> Int { B }\n" +
    "fn make_b() -> Int { 131 }\n" +
    "fn go() -> Int {\n" +
    "  let holder = Holder::{ push: get_invoker() }\n" +
    "  holder.push(read_b)\n" +
    "}\n" +
    "let A : Int = go()\n" +
    "let B : Int = make_b()\n" +
    "pub fn main() -> Int { A }\n",
  )
  assert_eq(r1_ok.tc.const_init_order[0], "B")
  assert_eq(r1_ok.tc.const_init_order[1], "A")

  // 2. Top-level `let H = Holder::{ push: invoke }; let A = H.push(read_a)` cycles; `read_b` orders B before A
  let r2_cyc = check_source_files_full(
    "r25b_top_push_invoke_cyc",
    ["r25b_top_push_invoke_cyc.pion"],
    [
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Holder = Holder::{ push: invoke }\n" +
      "let A : Int = H.push(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  let r2_ok = assert_j1_cold_hot_parity_files(
    "r25b_top_push_invoke_ok",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.push(read_b)\npub fn main() -> Int { A }\n",
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 137 }\n" +
      "let H : Holder = Holder::{ push: invoke }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r2_ok.tc.const_init_order[2], "A")

  // 3. Top-level `let H = Holder::{ push: get_invoker() }; let A = H.push(read_a)` cycles; `read_b` orders B before A
  let r3_cyc = check_source_files_full(
    "r25b_top_push_nonexact_cyc",
    ["r25b_top_push_nonexact_cyc.pion"],
    [
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn get_invoker() -> ((() -> Int) -> Int) { invoke }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Holder = Holder::{ push: get_invoker() }\n" +
      "let A : Int = H.push(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  let r3_ok = assert_j1_cold_hot_parity_files(
    "r25b_top_push_nonexact_ok",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.push(read_b)\npub fn main() -> Int { A }\n",
      "struct Holder { push : (() -> Int) -> Int }\n" +
      "fn invoke(f : () -> Int) -> Int { f() }\n" +
      "fn get_invoker() -> ((() -> Int) -> Int) { invoke }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 139 }\n" +
      "let H : Holder = Holder::{ push: get_invoker() }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r3_ok.tc.const_init_order[2], "A")
}

///|
test "j1.r26 unified @field::, #fret, #fieldw/#fieldp & #cfspread (16 Opus probes + 5 Astra blockers)" {
  let holder = "struct Holder { mut run : () -> Int }\nfn zero() -> Int { 0 }\n"
  let probe_names : Array[String] = [
    "call_recv",
    "nested_field",
    "array_elem",
    "const_call",
    "const_alias",
    "const_spread",
    "reassign",
    "field_write",
    "alias_write",
    "method_write",
    "fn_write",
    "closure_write",
    "loop_reassign",
    "arr_alias_write",
    "outer_alias_write",
    "const_mut_write",
  ]
  let probe_bodies : Array[String] = [
    holder + "fn mk() -> Holder { Holder::{ run: read_x } }\nfn go() -> Int { mk().run() }\n",
    holder + "struct Outer { h : Holder }\nfn go() -> Int { let o = Outer::{ h: Holder::{ run: read_x } }; o.h.run() }\n",
    holder + "fn go() -> Int { let hs = [Holder::{ run: read_x }]; hs[0].run() }\n",
    holder + "fn mk() -> Holder { Holder::{ run: read_x } }\nlet H : Holder = mk()\nfn go() -> Int { H.run() }\n",
    holder + "let H1 : Holder = Holder::{ run: read_x }\nlet H2 : Holder = H1\nfn go() -> Int { H2.run() }\n",
    "struct Holder { run : () -> Int; spare : () -> Int }\nfn zero() -> Int { 0 }\nlet H0 : Holder = Holder::{ run: read_x, spare: zero }\nlet H : Holder = Holder::{ ..H0, spare: zero }\nfn go() -> Int { H.run() }\n",
    holder + "fn go() -> Int { let mut h = Holder::{ run: zero }; h = Holder::{ run: read_x }; h.run() }\n",
    holder + "fn go() -> Int { let h = Holder::{ run: zero }; h.run = read_x; h.run() }\n",
    holder + "fn go() -> Int { let h = Holder::{ run: zero }; let g = h; g.run = read_x; h.run() }\n",
    holder + "fn Holder::install(self : Holder) -> Unit { self.run = read_x }\nfn go() -> Int { let h = Holder::{ run: zero }; h.install(); h.run() }\n",
    holder + "fn poke(h : Holder) -> Unit { h.run = read_x }\nfn go() -> Int { let h = Holder::{ run: zero }; poke(h); h.run() }\n",
    holder + "fn go() -> Int { let h = Holder::{ run: zero }; let set = fn() -> Unit { h.run = read_x }; set(); h.run() }\n",
    holder + "fn go() -> Int { let mut h = Holder::{ run: zero }; let mut r = 0; let mut i = 0; while i < 2 { r = r + h.run(); h = Holder::{ run: read_x }; i = i + 1 }; r }\n",
    holder + "fn go() -> Int { let h = Holder::{ run: zero }; let hs = [h]; hs[0].run = read_x; h.run() }\n",
    holder + "struct Outer { h : Holder }\nfn go() -> Int { let h = Holder::{ run: zero }; let o = Outer::{ h: h }; o.h.run = read_x; h.run() }\n",
    holder + "let H : Holder = Holder::{ run: zero }\nfn go() -> Int { H.run = read_x; H.run() }\n",
  ]
  let mut pi = 0
  while pi < probe_names.length() {
    let pname = probe_names[pi]
    let body = probe_bodies[pi]
    let cyc = check_source_files_full(
      "r26_cyc_" + pname,
      ["main.pion"],
      ["fn read_x() -> Int { A }\n" + body + "let A : Int = go()\npub fn main() -> Int { A }\n"],
    )
    assert_true(
      cyc.diagnostics.length() >= 1 && cyc.diagnostics[0].code == "E_CONST_CYCLE",
      pname + ": " + check_result_to_json(cyc.diagnostics),
    )
    let ord = assert_j1_cold_hot_parity_files(
      "r26_ord_" + pname,
      ["a.pion", "b.pion"],
      [
        "let A : Int = go()\npub fn main() -> Int { A }\n",
        "fn read_x() -> Int { B }\nfn make_b() -> Int { 7 }\n" + body + "let B : Int = make_b()\n",
      ],
    )
    let mut pos_a = -1
    let mut pos_b = -1
    let mut oi = 0
    while oi < ord.tc.const_init_order.length() {
      if ord.tc.const_init_order[oi] == "A" {
        pos_a = oi
      }
      if ord.tc.const_init_order[oi] == "B" {
        pos_b = oi
      }
      oi = oi + 1
    }
    assert_true(pos_b >= 0 && pos_a > pos_b, pname + ": B must precede A")
    pi = pi + 1
  }

  // Astra #2: top-level struct closure field — save-only ok, call cycles, 2-file read B cold/hot parity
  let _a2_save = assert_j1_cold_hot_parity(
    "r26_a2_closure_save",
    "struct Holder { run : () -> Int }\n" +
    "let H : Holder = Holder::{ run: fn() -> Int { A } }\n" +
    "let A : Int = 0\n" +
    "pub fn main() -> Int { A }\n",
  )
  let a2_cyc = check_source_files_full(
    "r26_a2_closure_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "let H : Holder = Holder::{ run: fn() -> Int { A } }\n" +
      "let A : Int = H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    a2_cyc.diagnostics.length() >= 1 && a2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(a2_cyc.diagnostics),
  )
  let a2_ord = assert_j1_cold_hot_parity_files(
    "r26_a2_closure_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.run()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn make_b() -> Int { 151 }\n" +
      "let H : Holder = Holder::{ run: fn() -> Int { B } }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(a2_ord.tc.const_init_order[2], "A")

  // Astra #3: const_spread with explicit override `run: zero` must stay 0 (no false cycle)
  let _a3_ok = assert_j1_cold_hot_parity(
    "r26_a3_spread_override_ok",
    "struct Holder { run : () -> Int; spare : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H0 : Holder = Holder::{ run: read_a, spare: zero }\n" +
    "let H : Holder = Holder::{ ..H0, run: zero }\n" +
    "let A : Int = H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // Astra #4: factory `fn maker() -> () -> Int { read_a }; let H = Holder::{ run: maker() }; let A = H.run()`
  let a4_cyc = check_source_files_full(
    "r26_a4_maker_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn maker() -> () -> Int { read_a }\n" +
      "let H : Holder = Holder::{ run: maker() }\n" +
      "let A : Int = H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    a4_cyc.diagnostics.length() >= 1 && a4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(a4_cyc.diagnostics),
  )
  let a4_ord = assert_j1_cold_hot_parity_files(
    "r26_a4_maker_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.run()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 157 }\n" +
      "fn maker() -> () -> Int { read_b }\n" +
      "let H : Holder = Holder::{ run: maker() }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(a4_ord.tc.const_init_order[2], "A")

  // Astra #5: `struct __field__` inherent method must NOT collide with `@field::` tag
  let a5_cyc = check_source_files_full(
    "r26_a5_dunder_field_cyc",
    ["main.pion"],
    [
      "struct __field__ { n : Int }\n" +
      "fn __field__::run(self : __field__) -> Int { A }\n" +
      "let A : Int = __field__::{ n: 0 }.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    a5_cyc.diagnostics.length() >= 1 && a5_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(a5_cyc.diagnostics),
  )
  let a5_ord = assert_j1_cold_hot_parity_files(
    "r26_a5_dunder_field_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = __field__::{ n: 0 }.run()\npub fn main() -> Int { A }\n",
      "struct __field__ { n : Int }\n" +
      "fn __field__::run(self : __field__) -> Int { B }\n" +
      "fn make_b() -> Int { 163 }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(a5_ord.tc.const_init_order[0], "B")
  assert_eq(a5_ord.tc.const_init_order[1], "A")

  // R26b #1: top-level closure returning inner anon closure `let MAKER = fn() -> (() -> Int) { fn() -> Int { A } }`
  let b1_cyc = check_source_files_full(
    "r26b_const_closure_maker_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "let MAKER : () -> (() -> Int) = fn() -> (() -> Int) { fn() -> Int { A } }\n" +
      "let H : Holder = Holder::{ run: MAKER() }\n" +
      "let A : Int = H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    b1_cyc.diagnostics.length() >= 1 && b1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(b1_cyc.diagnostics),
  )
  let b1_ord = assert_j1_cold_hot_parity_files(
    "r26b_const_closure_maker_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.run()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn make_b() -> Int { 167 }\n" +
      "let MAKER : () -> (() -> Int) = fn() -> (() -> Int) { fn() -> Int { B } }\n" +
      "let H : Holder = Holder::{ run: MAKER() }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  let mut b1_pa = -1
  let mut b1_pb = -1
  let mut b1_i = 0
  while b1_i < b1_ord.tc.const_init_order.length() {
    if b1_ord.tc.const_init_order[b1_i] == "A" {
      b1_pa = b1_i
    }
    if b1_ord.tc.const_init_order[b1_i] == "B" {
      b1_pb = b1_i
    }
    b1_i = b1_i + 1
  }
  assert_true(b1_pb >= 0 && b1_pa > b1_pb, "r26b MAKER: B must precede A")

  // R26b #2: named arg `set_it(f=read_a, h=h)` + 2-hop forwarding `wrap(h, f) -> set_it(h, f)`
  let b2_named_cyc = check_source_files_full(
    "r26b_fieldwp_named_cyc",
    ["main.pion"],
    [
      "struct Holder { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn set_it(h~ : Holder, f~ : () -> Int) -> Unit { h.run = f }\n" +
      "fn go() -> Int {\n" +
      "  let h = Holder::{ run: zero }\n" +
      "  set_it(f=read_a, h=h)\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    b2_named_cyc.diagnostics.length() >= 1 && b2_named_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(b2_named_cyc.diagnostics),
  )
  let b2_named_ord = assert_j1_cold_hot_parity_files(
    "r26b_fieldwp_named_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 173 }\n" +
      "fn set_it(h~ : Holder, f~ : () -> Int) -> Unit { h.run = f }\n" +
      "fn go() -> Int {\n" +
      "  let h = Holder::{ run: zero }\n" +
      "  set_it(f=read_b, h=h)\n" +
      "  h.run()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(b2_named_ord.tc.const_init_order[0], "B")
  assert_eq(b2_named_ord.tc.const_init_order[1], "A")

  let b2_fwd_cyc = check_source_files_full(
    "r26b_fieldwp_fwd_cyc",
    ["main.pion"],
    [
      "struct Holder { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn set_it(h : Holder, f : () -> Int) -> Unit { h.run = f }\n" +
      "fn wrap(h : Holder, f : () -> Int) -> Unit { set_it(h, f) }\n" +
      "fn go() -> Int {\n" +
      "  let h = Holder::{ run: zero }\n" +
      "  wrap(h, read_a)\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    b2_fwd_cyc.diagnostics.length() >= 1 && b2_fwd_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(b2_fwd_cyc.diagnostics),
  )
  let b2_fwd_ord = assert_j1_cold_hot_parity_files(
    "r26b_fieldwp_fwd_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 179 }\n" +
      "fn set_it(h : Holder, f : () -> Int) -> Unit { h.run = f }\n" +
      "fn wrap(h : Holder, f : () -> Int) -> Unit { set_it(h, f) }\n" +
      "fn go() -> Int {\n" +
      "  let h = Holder::{ run: zero }\n" +
      "  wrap(h, read_b)\n" +
      "  h.run()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(b2_fwd_ord.tc.const_init_order[0], "B")
  assert_eq(b2_fwd_ord.tc.const_init_order[1], "A")
}

///|
test "j1.r27 alias factory $ret:, shadowed local ret & type-qualified reachability-gated #fieldw/#fieldp" {
  // 1. Astra #1: local alias `let mk = maker; Holder::{ run: mk() }` + local anon closure factory
  let r1_cyc = check_source_files_full(
    "r27_alias_factory_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn maker() -> () -> Int { read_a }\n" +
      "fn go() -> Int {\n" +
      "  let mk = maker\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )

  let r1_anon_cyc = check_source_files_full(
    "r27_anon_factory_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn go() -> Int {\n" +
      "  let mk = fn() -> (() -> Int) { read_a }\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_anon_cyc.diagnostics.length() >= 1 && r1_anon_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_anon_cyc.diagnostics),
  )

  let r1_ord = assert_j1_cold_hot_parity_files(
    "r27_alias_factory_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 7 }\n" +
      "fn maker() -> () -> Int { read_b }\n" +
      "fn go() -> Int {\n" +
      "  let mk = maker\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r1_ord.tc.const_init_order[0], "B")
  assert_eq(r1_ord.tc.const_init_order[1], "A")

  // 2. Astra #2: shadowed local `let danger = zero; danger` (and inside `if` block) must NOT false-cycle
  let _r2_ok = assert_j1_cold_hot_parity(
    "r27_shadow_ret_ok",
    "struct Holder { run : () -> Int }\n" +
    "fn danger() -> Int { A }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn maker() -> () -> Int { let danger = zero; danger }\n" +
    "fn maker_if(flag : Bool) -> () -> Int {\n" +
    "  if flag { let danger = zero; danger } else { zero }\n" +
    "}\n" +
    "let H1 : Holder = Holder::{ run: maker() }\n" +
    "let H2 : Holder = Holder::{ run: maker_if(true) }\n" +
    "let A : Int = H1.run() + H2.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // 3. Astra #3: unrelated `Other.run` write (even reachable!) + dead `Live.run` write must NOT pollute `Live.run`
  let _r3_other_ok = assert_j1_cold_hot_parity(
    "r27_other_struct_write_ok",
    "struct Live { mut run : () -> Int }\n" +
    "struct Other { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "fn unused(x : Other) -> Unit { x.run = read_a }\n" +
    "fn touch_other() -> Int { let o = Other::{ run: zero }; o.run = read_a; 0 }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "let A : Int = touch_other() + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  let _r3_dead_live_ok = assert_j1_cold_hot_parity(
    "r27_dead_live_write_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "fn unused(x : Live) -> Unit { x.run = read_a }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "let A : Int = H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )
}

///|
test "j1.r28 param factory $retp:, multi-level outer()(), @ci: domain, gated fdef & isolated struct locals" {
  // 1a. Astra #1a: param factory `go(mk)` + `A = go(maker)`
  let r1a_cyc = check_source_files_full(
    "r28_param_factory_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn maker() -> () -> Int { read_a }\n" +
      "fn go(mk : () -> (() -> Int)) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go(maker)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1a_cyc.diagnostics.length() >= 1 && r1a_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1a_cyc.diagnostics),
  )
  let r1a_ord = assert_j1_cold_hot_parity_files(
    "r28_param_factory_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go(maker)\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 7 }\n" +
      "fn maker() -> () -> Int { read_b }\n" +
      "fn go(mk : () -> (() -> Int)) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r1a_ord.tc.const_init_order[0], "B")
  assert_eq(r1a_ord.tc.const_init_order[1], "A")

  // 1b. Astra #1b: multi-level `outer()()` returning `maker` -> `read_a`/`read_b`
  let r1b_cyc = check_source_files_full(
    "r28_multilevel_ret_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn maker() -> () -> Int { read_a }\n" +
      "fn outer() -> () -> (() -> Int) { maker }\n" +
      "let H : Holder = Holder::{ run: outer()() }\n" +
      "let A : Int = H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1b_cyc.diagnostics.length() >= 1 && r1b_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1b_cyc.diagnostics),
  )
  let r1b_ord = assert_j1_cold_hot_parity_files(
    "r28_multilevel_ret_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = H.run()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 7 }\n" +
      "fn maker() -> () -> Int { read_b }\n" +
      "fn outer() -> () -> (() -> Int) { maker }\n" +
      "let H : Holder = Holder::{ run: outer()() }\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r1b_ord.tc.const_init_order[2], "A")

  // 2. Astra #2: user function named `ci_unused_live` must NOT collide with `@ci:` domain
  let _r2_ok = assert_j1_cold_hot_parity(
    "r28_ci_prefix_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "fn ci_unused_live(x : Live) -> Unit { x.run = read_a }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "let A : Int = H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // 3. Astra #3: default arg `choose(x : Int = install())` — `choose(0)` ok, `choose()` cycles
  let _r3_ok = assert_j1_cold_hot_parity(
    "r28_gated_fdef_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "fn install() -> Int { H.run = read_a; 0 }\n" +
    "fn choose(x : Int = install()) -> Int { x }\n" +
    "let A : Int = choose(0) + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r3_cyc = check_source_files_full(
    "r28_gated_fdef_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn install() -> Int { H.run = read_a; 0 }\n" +
      "fn choose(x : Int = install()) -> Int { x }\n" +
      "let A : Int = choose() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Astra #4: non-escaping fresh local struct write must NOT pollute `H.run()`,
  //    while aliased `let o = H; o.run = read_a` MUST cycle!
  let _r4_ok = assert_j1_cold_hot_parity(
    "r28_isolated_local_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "fn touch_live() -> Int {\n" +
    "  let o = Live::{ run: zero }\n" +
    "  o.run = read_a\n" +
    "  0\n" +
    "}\n" +
    "let A : Int = touch_live() + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r4_cyc = check_source_files_full(
    "r28_aliased_local_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn touch_live() -> Int {\n" +
      "  let o = H\n" +
      "  o.run = read_a\n" +
      "  0\n" +
      "}\n" +
      "let A : Int = touch_live() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )
}

///|
test "j1.r29 EIs isolated shadow + workstack, @fdef: def_ctx, #fdefcb & context-sensitive $retp:" {
  // 1a. Astra #1: `EIs` pattern binding shadows `o` -> must NOT treat `o.run = read_a` as isolated
  let r1_cyc = check_source_files_full(
    "r29_eis_shadow_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn touch() -> Int {\n" +
      "  let o = Live::{ run: zero }\n" +
      "  if Some(H) is Some(o) { o.run = read_a }\n" +
      "  0\n" +
      "}\n" +
      "let A : Int = touch() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_cyc.diagnostics.length() >= 1 && r1_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_cyc.diagnostics),
  )
  let r1_ord = assert_j1_cold_hot_parity_files(
    "r29_eis_shadow_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = touch() + H.run()\npub fn main() -> Int { A }\n",
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 7 }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn touch() -> Int {\n" +
      "  let o = Live::{ run: zero }\n" +
      "  if Some(H) is Some(o) { o.run = read_b }\n" +
      "  0\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r1_ord.tc.const_init_order[2], "A")

  // 1b. Explicit workstack stress: 2,500-term `&&` chain + isolated struct local (no stack overflow)
  let sb = StringBuilder()
  sb.write_string("struct Holder { mut run : () -> Int }\n")
  sb.write_string("fn zero() -> Int { 0 }\n")
  sb.write_string("fn deep_iso(x : Bool) -> Int {\n")
  sb.write_string("  let _iso = Holder::{ run: zero }\n")
  sb.write_string("  let ok = x")
  let mut di = 0
  while di < 2500 {
    sb.write_string(" && x")
    di = di + 1
  }
  sb.write_string("\n  if ok { 1 } else { 0 }\n}\n")
  sb.write_string("let A : Int = deep_iso(true)\npub fn main() -> Int { A }\n")
  let _r1_deep = assert_j1_cold_hot_parity("r29_deep_iso_2500", sb.to_string())

  // 2. Astra #2: inline default arg block `{ H.run = read_a; 0 }` isolated in `@fdef:`
  let _r2_ok = assert_j1_cold_hot_parity(
    "r29_inline_fdef_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "fn choose(x : Int = { H.run = read_a; 0 }) -> Int { x }\n" +
    "let A : Int = choose(0) + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r2_cyc = check_source_files_full(
    "r29_inline_fdef_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn choose(x : Int = { H.run = read_a; 0 }) -> Int { x }\n" +
      "let A : Int = choose() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )

  // 3. Astra #3: `#fdefcb` default callback parameter `fn go(mk : () -> (() -> Int) = maker)`
  let r3_cyc = check_source_files_full(
    "r29_fdefcb_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn maker() -> () -> Int { read_a }\n" +
      "fn go(mk : () -> (() -> Int) = maker) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )
  let r3_ord = assert_j1_cold_hot_parity_files(
    "r29_fdefcb_ord",
    ["a.pion", "b.pion"],
    [
      "let A : Int = go()\npub fn main() -> Int { A }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn read_b() -> Int { B }\n" +
      "fn make_b() -> Int { 7 }\n" +
      "fn maker() -> () -> Int { read_b }\n" +
      "fn go(mk : () -> (() -> Int) = maker) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let B : Int = make_b()\n",
    ],
  )
  assert_eq(r3_ord.tc.const_init_order[0], "B")
  assert_eq(r3_ord.tc.const_init_order[1], "A")

  // 4. Astra #4: context-sensitive `$retp:` — `let A = go(safe_maker); let B = go(reader_maker)` -> [A, B], no false cycle!
  let r4_ok = assert_j1_cold_hot_parity_files(
    "r29_ctx_retp_ok",
    ["a.pion", "b.pion"],
    [
      "let B : Int = go(reader_maker)\npub fn main() -> Int { B }\n",
      "struct Holder { run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A + 5 }\n" +
      "fn safe_maker() -> () -> Int { zero }\n" +
      "fn reader_maker() -> () -> Int { read_a }\n" +
      "fn go(mk : () -> (() -> Int)) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go(safe_maker)\n",
    ],
  )
  assert_eq(r4_ok.tc.const_init_order[0], "A")
  assert_eq(r4_ok.tc.const_init_order[1], "B")

  let r4_cyc = check_source_files_full(
    "r29_ctx_retp_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn reader_maker() -> () -> Int { read_a }\n" +
      "fn go(mk : () -> (() -> Int)) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let A : Int = go(reader_maker)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )
}

///|
test "j1.r30 default arg prior-param scope (#19), nested fdef cbs, 8/9-level $retp: & alias $retp:" {
  // 1. Default parameter expressions can reference prior parameters (PR #19 semantics),
  //    shadowing any same-named top-level fn; unshadowed top-level fn defaults still track deps/cycles.
  let _r1a_shadow_ok = assert_j1_cold_hot_parity(
    "r30_fdef_prior_shadow_ok",
    "fn f() -> Int { A }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn use_cb(f : () -> Int, g : () -> Int = f) -> Int { g() }\n" +
    "let A : Int = use_cb(zero)\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r1a_prior_cyc = check_source_files_full(
    "r30_fdef_prior_val_cyc",
    ["main.pion"],
    [
      "fn f() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn use_cb(f : () -> Int, g : () -> Int = f) -> Int { g() }\n" +
      "let A : Int = use_cb(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1a_prior_cyc.diagnostics.length() >= 1 && r1a_prior_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1a_prior_cyc.diagnostics),
  )
  let _r1b_shadow_ok = assert_j1_cold_hot_parity(
    "r30_fdef_prior_call_shadow_ok",
    "fn f() -> Int { A }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn use_cb_call(f : () -> Int, x : Int = f()) -> Int { x }\n" +
    "let A : Int = use_cb_call(zero)\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r1b_prior_cyc = check_source_files_full(
    "r30_fdef_prior_call_cyc",
    ["main.pion"],
    [
      "fn f() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn use_cb_call(f : () -> Int, x : Int = f()) -> Int { x }\n" +
      "let A : Int = use_cb_call(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1b_prior_cyc.diagnostics.length() >= 1 && r1b_prior_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1b_prior_cyc.diagnostics),
  )
  let _r1b_explicit_ok = assert_j1_cold_hot_parity(
    "r30_fdef_prior_call_explicit_ok",
    "fn read_a() -> Int { A }\n" +
    "fn use_cb_call(f : () -> Int, x : Int = f()) -> Int { x }\n" +
    "let A : Int = use_cb_call(read_a, 0)\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r1c_top_cyc = check_source_files_full(
    "r30_fdef_unshadowed_top_cyc",
    ["main.pion"],
    [
      "fn top_f() -> Int { A }\n" +
      "fn use_top(x : Int, g : () -> Int = top_f) -> Int { x + g() }\n" +
      "let A : Int = use_top(0)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1c_top_cyc.diagnostics.length() >= 1 && r1c_top_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1c_top_cyc.diagnostics),
  )

  // 2. Astra #2: nested default arg activating sub-call default callback (`outer(x = run())`, `run(cb = install)`)
  let r2_cyc = check_source_files_full(
    "r30_nested_fdef_cb_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn install() -> Int { H.run = read_a; 0 }\n" +
      "fn run(cb : () -> Int = install) -> Int { cb() }\n" +
      "fn outer(x : Int = run()) -> Int { x }\n" +
      "let A : Int = outer() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )
  let _r2_ok = assert_j1_cold_hot_parity(
    "r30_nested_fdef_cb_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "fn install() -> Int { H.run = read_a; 0 }\n" +
    "fn run(cb : () -> Int = install) -> Int { cb() }\n" +
    "fn outer(x : Int = run()) -> Int { x }\n" +
    "let A : Int = outer(0) + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // 3. Astra #3: 9-level factory chain (`go(mk)` calls `mk()()()()()()()()()`) no longer silently truncated at depth 8
  let r3_cyc = check_source_files_full(
    "r30_retp_depth9_cyc",
    ["main.pion"],
    [
      "fn f0() -> Int { A }\n" +
      "fn f1() -> () -> Int { f0 }\n" +
      "fn f2() -> () -> (() -> Int) { f1 }\n" +
      "fn f3() -> () -> (() -> (() -> Int)) { f2 }\n" +
      "fn f4() -> () -> (() -> (() -> (() -> Int))) { f3 }\n" +
      "fn f5() -> () -> (() -> (() -> (() -> (() -> Int)))) { f4 }\n" +
      "fn f6() -> () -> (() -> (() -> (() -> (() -> (() -> Int))))) { f5 }\n" +
      "fn f7() -> () -> (() -> (() -> (() -> (() -> (() -> (() -> Int)))))) { f6 }\n" +
      "fn f8() -> () -> (() -> (() -> (() -> (() -> (() -> (() -> (() -> Int))))))) { f7 }\n" +
      "fn go(mk : () -> (() -> (() -> (() -> (() -> (() -> (() -> (() -> (() -> Int))))))))) -> Int {\n" +
      "  mk()()()()()()()()()\n" +
      "}\n" +
      "let A : Int = go(f8)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r3_cyc.diagnostics.length() >= 1 && r3_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r3_cyc.diagnostics),
  )

  // 4. Astra #4: top-level alias propagates `fn_called_ret_depths` (`let alias = go; alias(reader_maker)`)
  let r4_cyc = check_source_files_full(
    "r30_alias_retp_cyc",
    ["main.pion"],
    [
      "struct Holder { run : () -> Int }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn reader_maker() -> () -> Int { read_a }\n" +
      "fn go(mk : () -> (() -> Int)) -> Int {\n" +
      "  let h = Holder::{ run: mk() }\n" +
      "  h.run()\n" +
      "}\n" +
      "let alias : (() -> (() -> Int)) -> Int = go\n" +
      "let A : Int = alias(reader_maker)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r4_cyc.diagnostics.length() >= 1 && r4_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r4_cyc.diagnostics),
  )
  let _r4_ok = assert_j1_cold_hot_parity(
    "r30_alias_retp_ok",
    "struct Holder { run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn safe_maker() -> () -> Int { zero }\n" +
    "fn go(mk : () -> (() -> Int)) -> Int {\n" +
    "  let h = Holder::{ run: mk() }\n" +
    "  h.run()\n" +
    "}\n" +
    "let alias : (() -> (() -> Int)) -> Int = go\n" +
    "let A : Int = alias(safe_maker)\n" +
    "pub fn main() -> Int { A }\n",
  )
}

///|
test "j1.r31 default arg lexical hygiene, active_fdef fixed-point rescan & 65/66-level transitive ret closure" {
  // 1. Astra #1: lexical hygiene — caller local `f` must NOT hijack default arg `g = f`
  let _r1_dir1 = assert_j1_cold_hot_parity(
    "r31_hygiene_dir1_ok",
    "fn f() -> Int { 0 }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "fn use_cb(f : () -> Int, g : () -> Int = f) -> Int { g() }\n" +
    "let A : Int = { let f = read_a; use_cb(zero) }\n" +
    "pub fn main() -> Int { A }\n",
  )
  let r1_dir2 = check_source_files_full(
    "r31_hygiene_dir2_cyc",
    ["main.pion"],
    [
      "fn f() -> Int { A }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn use_cb(x : Int, g : () -> Int = f) -> Int { x + g() }\n" +
      "let A : Int = { let f = zero; use_cb(0) }\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_dir2.diagnostics.length() >= 1 && r1_dir2.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_dir2.diagnostics),
  )
  let r1_dir3 = check_source_files_full(
    "r31_hygiene_dir3_explicit_cyc",
    ["main.pion"],
    [
      "fn f() -> Int { 0 }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "fn use_cb(f : () -> Int, g : () -> Int = f) -> Int { g() }\n" +
      "let A : Int = { let f = read_a; use_cb(zero, f) }\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r1_dir3.diagnostics.length() >= 1 && r1_dir3.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r1_dir3.diagnostics),
  )
  // Declaration-site hygiene: default arg referencing a later (not yet declared) param is rejected cleanly
  let r1_decl_err = check_source_files_full(
    "r31_hygiene_decl_err",
    ["main.pion"],
    [
      "fn zero() -> Int { 0 }\n" +
      "fn use_cb(g : () -> Int = later_f, later_f : () -> Int = zero) -> Int { g() }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
  )
  assert_true(
    r1_decl_err.diagnostics.length() >= 1 && r1_decl_err.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(r1_decl_err.diagnostics),
  )

  // 2. Astra #2: active_fdef_idxs re-scan when `cb` is invoked indirectly via closure inside `run`
  let r2_cyc = check_source_files_full(
    "r31_fdef_rescan_cyc",
    ["main.pion"],
    [
      "struct Live { mut run : () -> Int }\n" +
      "fn zero() -> Int { 0 }\n" +
      "fn read_a() -> Int { A }\n" +
      "let H : Live = Live::{ run: zero }\n" +
      "fn install() -> Int { H.run = read_a; 0 }\n" +
      "fn run(cb : () -> Int = install) -> Int { let g = cb; let h = fn() -> Int { g() }; h() }\n" +
      "fn outer(x : Int = run()) -> Int { x }\n" +
      "let A : Int = outer() + H.run()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(
    r2_cyc.diagnostics.length() >= 1 && r2_cyc.diagnostics[0].code == "E_CONST_CYCLE",
    check_result_to_json(r2_cyc.diagnostics),
  )
  let _r2_ok = assert_j1_cold_hot_parity(
    "r31_fdef_rescan_ok",
    "struct Live { mut run : () -> Int }\n" +
    "fn zero() -> Int { 0 }\n" +
    "fn read_a() -> Int { A }\n" +
    "let H : Live = Live::{ run: zero }\n" +
    "fn install() -> Int { H.run = read_a; 0 }\n" +
    "fn run(cb : () -> Int = install) -> Int { let g = cb; let h = fn() -> Int { g() }; h() }\n" +
    "fn outer(x : Int = run()) -> Int { x }\n" +
    "let A : Int = outer(0) + H.run()\n" +
    "pub fn main() -> Int { A }\n",
  )

  // 3. Astra #3 + Opus #2: 65-level and 66-level factory chains via finite transitive ret closure
  let mut depth_case = 65
  while depth_case <= 66 {
    let sb = StringBuilder()
    sb.write_string("fn f0() -> Int { A }\n")
    let mut ty_s = "() -> Int"
    let mut di = 1
    while di < depth_case {
      sb.write_string("fn f" + di.to_string() + "() -> " + ty_s + " { f" + (di - 1).to_string() + " }\n")
      ty_s = "() -> (" + ty_s + ")"
      di = di + 1
    }
    sb.write_string("fn go(mk : " + ty_s + ") -> Int {\n  mk")
    di = 0
    while di < depth_case {
      sb.write_string("()")
      di = di + 1
    }
    sb.write_string("\n}\nlet A : Int = go(f" + (depth_case - 1).to_string() + ")\npub fn main() -> Int { A }\n")
    let r3 = check_source_files_full(
      "r31_retp_depth" + depth_case.to_string() + "_cyc",
      ["main.pion"],
      [sb.to_string()],
    )
    assert_true(
      r3.diagnostics.length() >= 1 && r3.diagnostics[0].code == "E_CONST_CYCLE",
      check_result_to_json(r3.diagnostics),
    )
    depth_case = depth_case + 1
  }
}

///|
test "j1.r32 default arg decl privacy, llbc isolation, forbid return & generic default type_params/subst" {
  // 1. Astra #1: declaration-site default_expr must NOT bypass cross-pkg privacy;
  //    dependency's own pub fn default_expr calling private helper still expands cleanly.
  let dep_cr = check_source_files_full(
    "dep",
    ["dep.pion"],
    [
      "fn hidden() -> Int { 7 }\n" +
      "pub fn ok(x : Int = hidden()) -> Int { x }\n",
    ],
  )
  assert_eq(dep_cr.diagnostics.length(), 0)
  let imp = [ImportedPkg::{ name: "dep", tc: dep_cr.tc }]
  let priv_bad = check_source_files_with_imports(
    "app_bad",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "fn g(x : Int = dep::hidden()) -> Int { x }\n" +
      "pub fn main() -> Int { g() }\n",
    ],
    imp,
    true,
  )
  assert_true(
    priv_bad.diagnostics.length() >= 1 && priv_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(priv_bad.diagnostics),
  )
  let priv_ok = check_source_files_with_imports(
    "app_ok",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "pub fn main() -> Int { dep::ok() }\n",
    ],
    imp,
    true,
  )
  assert_eq(priv_ok.diagnostics.length(), 0)

  // 2. Astra #2: llbc.pion isolates default_expr from caller parameter `K`
  let cr2 = lt_check(
    "r32_llbc",
    "let K : Int = 7\n" +
    "#verify fn g(x : Int = K) -> Int { x }\n" +
    "#verify fn outer(K : Int) -> Int { g() }\n",
    [],
  )
  let lres = llbc_build([llbc_input_new("r32_llbc", cr2.pkg, cr2.tc, true)])
  assert_eq(lres.diagnostics.length(), 0)
  let mut found_const_arg = false
  let mut pi = 0
  while pi < lres.pkgs.length() {
    let mut fi = 0
    while fi < lres.pkgs[pi].fns.length() {
      let lf = lres.pkgs[pi].fns[fi]
      if lf.lean_name == "outer" {
        let mut si = 0
        while si < lf.body.stmts.length() {
          match lf.body.stmts[si] {
            LSLet(_, _, LConstRef(_, _)) => found_const_arg = true
            LSCall(_, _, _, args, _, _) =>
              if args.length() == 1 {
                match args[0] {
                  AVal(LConstRef(_, _)) => found_const_arg = true
                  _ => ()
                }
              }
            _ => ()
          }
          si = si + 1
        }
      }
      fi = fi + 1
    }
    pi = pi + 1
  }
  assert_true(found_const_arg, "expected `outer` LLBC call to `g` to pass LConstRef K, not param LVar K")

  // 3. Astra #3: forbid `return` directly in default_expr; allow `return` inside closure in default_expr
  let ret_bad = check_source_files_full(
    "r32_def_ret_bad",
    ["main.pion"],
    [
      "fn g(x : Int = { if true { return 1 }; 0 }) -> Int { x }\n" +
      "pub fn main() -> Int { g() }\n",
    ],
  )
  assert_true(
    ret_bad.diagnostics.length() >= 1 && ret_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(ret_bad.diagnostics),
  )
  let ret_clo_ok = check_source_files_full(
    "r32_def_clo_ret_ok",
    ["main.pion"],
    [
      "fn g(f : () -> Int = fn() -> Int { return 42 }) -> Int { f() }\n" +
      "pub fn main() -> Int { g() }\n",
    ],
  )
  assert_eq(ret_clo_ok.diagnostics.length(), 0)

  // 4. Astra #4: generic callee default_expr uses callee's type_params & subst
  let gen_ok = check_source_files_full(
    "r32_gen_def_ok",
    ["main.pion"],
    [
      "fn g[T](x : T, n : Int = { let xs : Array[T] = []; xs.length() }) -> Int { let _ = x; n }\n" +
      "fn caller[T](y : T) -> Int { let _ = y; g(7) }\n" +
      "pub fn main() -> Int { g(7) + caller(\"hi\") }\n",
    ],
  )
  assert_eq(gen_ok.diagnostics.length(), 0)
  let gen_bad = check_source_files_full(
    "r32_gen_def_bad",
    ["main.pion"],
    [
      "fn g[T](x : T, n : Int = \"oops\") -> Int { let _ = x; n }\n" +
      "pub fn main() -> Int { g(7) }\n",
    ],
  )
  assert_true(
    gen_bad.diagnostics.length() >= 1 && gen_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(gen_bad.diagnostics),
  )
}

///|
test "j1.r33 cross-pkg llbc default pkg switch, qualify TypeExpr/Pat, DImpl default check & forbid ? in default_expr" {
  // 1. Astra #1: cross-pkg LLBC evaluates default_expr in defining package `dep` (not caller `app`)
  let dep_cr = lt_check(
    "dep",
    "let K : Int = 7\n" +
    "#verify pub fn g(x : Int = K) -> Int { x }\n",
    [],
  )
  let imp1 = [ImportedPkg::{ name: "dep", tc: dep_cr.tc }]
  let app_cr = lt_check(
    "app",
    "import \"dep\"\n" +
    "let K : Int = 9\n" +
    "#verify pub fn caller() -> Int { dep::g() }\n",
    imp1,
  )
  let lres = llbc_build([
    llbc_input_new("dep", dep_cr.pkg, dep_cr.tc, false),
    llbc_input_new("app", app_cr.pkg, app_cr.tc, true),
  ])
  assert_eq(lres.diagnostics.length(), 0)
  let mut found_dep_k = false
  let mut pi = 0
  while pi < lres.pkgs.length() {
    if lres.pkgs[pi].name == "app" {
      let mut fi = 0
      while fi < lres.pkgs[pi].fns.length() {
        let lf = lres.pkgs[pi].fns[fi]
        if lf.lean_name == "caller" {
          let mut si = 0
          while si < lf.body.stmts.length() {
            match lf.body.stmts[si] {
              LSLet(_, _, LConstRef(ck, _)) =>
                if ck == "const:dep::K" {
                  found_dep_k = true
                }
              LSCall(_, _, _, args, _, _) =>
                if args.length() == 1 {
                  match args[0] {
                    AVal(LConstRef(ck, _)) =>
                      if ck == "const:dep::K" {
                        found_dep_k = true
                      }
                    _ => ()
                  }
                }
              _ => ()
            }
            si = si + 1
          }
        }
        fi = fi + 1
      }
    }
    pi = pi + 1
  }
  assert_true(found_dep_k, "expected `app::caller` LLBC call to `dep::g` to pass LConstRef `dep::K`")

  // 2. Astra #2: qualify_imported_expr qualifies TypeExpr (SLet/EAs/EClosure) without qualifying callee's generic `T`
  let dep2_cr = check_source_files_full(
    "dep2",
    ["dep2.pion"],
    [
      "pub struct Item { v : Int }\n" +
      "pub fn g(n : Int = { let xs : Array[Item] = []; xs.length() }) -> Int { n }\n" +
      "pub fn id_len[T](x : T, n : Int = { let xs : Array[T] = []; xs.length() }) -> Int { let _ = x; n }\n",
    ],
  )
  assert_eq(dep2_cr.diagnostics.length(), 0)
  let imp2 = [ImportedPkg::{ name: "dep2", tc: dep2_cr.tc }]
  // Case A: app has NO `Item`
  let app2a = check_source_files_with_imports(
    "app2a",
    ["main.pion"],
    ["import \"dep2\"\npub fn main() -> Int { dep2::g() + dep2::id_len(7) }\n"],
    imp2,
    true,
  )
  assert_eq(app2a.diagnostics.length(), 0)
  // Case B: app defines incompatible `struct Item { s : String }`
  let app2b = check_source_files_with_imports(
    "app2b",
    ["main.pion"],
    [
      "import \"dep2\"\n" +
      "struct Item { s : String }\n" +
      "pub fn main() -> Int { let _ = Item::{ s: \"x\" }; dep2::g() + dep2::id_len(\"hi\") }\n",
    ],
    imp2,
    true,
  )
  assert_eq(app2b.diagnostics.length(), 0)

  // 3. Astra #3: DImpl checks default_expr at declaration time even when method is never called
  let impl_ret_bad = check_source_files_full(
    "r33_impl_ret_bad",
    ["main.pion"],
    [
      "trait Tr { fn m(self : Self, x : Int) -> Int }\n" +
      "struct S { v : Int }\n" +
      "impl Tr for S { fn m(self : S, x : Int = { return 1; 0 }) -> Int { self.v + x } }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
  )
  assert_true(
    impl_ret_bad.diagnostics.length() >= 1 && impl_ret_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(impl_ret_bad.diagnostics),
  )
  let dep3_cr = check_source_files_full(
    "dep3",
    ["dep3.pion"],
    ["fn hidden() -> Int { 7 }\npub fn ok() -> Int { hidden() }\n"],
  )
  assert_eq(dep3_cr.diagnostics.length(), 0)
  let impl_priv_bad = check_source_files_with_imports(
    "r33_impl_priv_bad",
    ["main.pion"],
    [
      "import \"dep3\"\n" +
      "trait Tr { fn m(self : Self, x : Int) -> Int }\n" +
      "struct S { v : Int }\n" +
      "impl Tr for S { fn m(self : S, x : Int = dep3::hidden()) -> Int { self.v + x } }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
    [ImportedPkg::{ name: "dep3", tc: dep3_cr.tc }],
    true,
  )
  assert_true(
    impl_priv_bad.diagnostics.length() >= 1 && impl_priv_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(impl_priv_bad.diagnostics),
  )

  // 4. Opus #4: forbid `?` directly in default_expr (decl & call), allow `?` inside closure in default_expr
  let try_bad = check_source_files_full(
    "r33_def_try_bad",
    ["main.pion"],
    [
      "fn parse(flag : Bool) -> Result[Int, String] { if flag { Ok(1) } else { Err(\"bad\") } }\n" +
      "fn g(x : Int = parse(false)?) -> Result[Int, String] { Ok(x) }\n" +
      "fn caller() -> Result[Int, String] { g() }\n" +
      "pub fn main() -> Int { let _ = caller(); 0 }\n",
    ],
  )
  assert_true(
    try_bad.diagnostics.length() >= 1 && try_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(try_bad.diagnostics),
  )
  let try_clo_ok = check_source_files_full(
    "r33_def_clo_try_ok",
    ["main.pion"],
    [
      "fn parse(flag : Bool) -> Result[Int, String] { if flag { Ok(42) } else { Err(\"bad\") } }\n" +
      "fn g(f : () -> Result[Int, String] = fn() -> Result[Int, String] { let n = parse(true)?; Ok(n) }) -> Int {\n" +
      "  match f() { Ok(v) => v, Err(_) => -1 }\n" +
      "}\n" +
      "pub fn main() -> Int { g() }\n",
    ],
  )
  assert_eq(try_clo_ok.diagnostics.length(), 0)
}

///|
test "j1.r34 default arg forbid bare break/continue, qualify is-bindings & cross-pkg private type lazy import" {
  // 1. Astra #1: forbid bare `break`/`continue` in default_expr (decl & inside caller loop); allow inside default's own loop
  let brk_decl = check_source_files_full(
    "r34_def_brk_decl",
    ["main.pion"],
    ["fn f(x : Int = { break; 7 }) -> Int { x }\npub fn main() -> Int { 0 }\n"],
  )
  assert_true(
    brk_decl.diagnostics.length() >= 1 && brk_decl.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(brk_decl.diagnostics),
  )
  let cont_decl = check_source_files_full(
    "r34_def_cont_decl",
    ["main.pion"],
    ["fn g(x : Int = { continue; 7 }) -> Int { x }\npub fn main() -> Int { 0 }\n"],
  )
  assert_true(
    cont_decl.diagnostics.length() >= 1 && cont_decl.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(cont_decl.diagnostics),
  )
  let brk_in_loop = check_source_files_full(
    "r34_def_brk_loop",
    ["main.pion"],
    [
      "fn f(x : Int = { break; 7 }) -> Int { x }\n" +
      "pub fn main() -> Int { let mut i = 0; while i < 1 { i = i + 1; let _ = f() }; i }\n",
    ],
  )
  assert_true(
    brk_in_loop.diagnostics.length() >= 1 && brk_in_loop.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(brk_in_loop.diagnostics),
  )
  let own_loop_ok = check_source_files_full(
    "r34_def_own_loop_ok",
    ["main.pion"],
    [
      "fn f(x : Int = { let mut s = 0; let mut i = 0; while i < 5 { i = i + 1; if i == 2 { continue }; if i == 4 { break }; s = s + i }; s }) -> Int { x }\n" +
      "pub fn main() -> Int { f() }\n",
    ],
  )
  assert_true(own_loop_ok.diagnostics.length() == 0, check_result_to_json(own_loop_ok.diagnostics))

  // 2. Astra #2: qualify_imported_expr propagates `is`-bindings in `&&`, `if`, `while`, `guard`
  let dep_is = check_source_files_full(
    "dep_is",
    ["dep_is.pion"],
    [
      "let k : Int = 99\n" +
      "pub fn pick_if(x : Int = if Some(7) is Some(k) && k > 0 { k } else { k }) -> Int { x }\n" +
      "pub fn pick_else(x : Int = { let o : Option[Int] = None; if o is Some(k) { k } else { k } }) -> Int { x }\n" +
      "pub fn pick_guard(x : Int = { guard Some(7) is Some(k) else { panic(\"no\") }; k }) -> Int { x }\n",
    ],
  )
  assert_true(dep_is.diagnostics.length() == 0, check_result_to_json(dep_is.diagnostics))
  let app_is = check_source_files_with_imports(
    "app_is",
    ["main.pion"],
    ["import \"dep_is\"\npub fn main() -> Int { dep_is::pick_if() + dep_is::pick_else() + dep_is::pick_guard() }\n"],
    [ImportedPkg::{ name: "dep_is", tc: dep_is.tc }],
    true,
  )
  assert_true(app_is.diagnostics.length() == 0, check_result_to_json(app_is.diagnostics))

  // 3. Astra #3: cross-pkg default_expr may use defining pkg's private struct/enum,
  //    while direct reference in consumer code (even AFTER calling `dep::g()`) still reports `E_PRIVATE_SYMBOL`!
  let dep_priv = check_source_files_full(
    "dep_priv",
    ["dep_priv.pion"],
    [
      "struct Item { v : Int }\n" +
      "pub fn g(n : Int = { let xs : Array[Item] = []; xs.length() }) -> Int { n }\n",
    ],
  )
  assert_true(dep_priv.diagnostics.length() == 0, check_result_to_json(dep_priv.diagnostics))
  let imp_priv = [ImportedPkg::{ name: "dep_priv", tc: dep_priv.tc }]
  let app_priv_ok = check_source_files_with_imports(
    "app_priv_ok",
    ["main.pion"],
    ["import \"dep_priv\"\npub fn main() -> Int { dep_priv::g() }\n"],
    imp_priv,
    true,
  )
  assert_true(app_priv_ok.diagnostics.length() == 0, check_result_to_json(app_priv_ok.diagnostics))
  let app_priv_bad = check_source_files_with_imports(
    "app_priv_bad",
    ["main.pion"],
    [
      "import \"dep_priv\"\n" +
      "pub fn main() -> Int { let _ = dep_priv::g(); let xs : Array[dep_priv::Item] = []; xs.length() }\n",
    ],
    imp_priv,
    true,
  )
  assert_true(
    app_priv_bad.diagnostics.length() >= 1 && app_priv_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app_priv_bad.diagnostics),
  )
}

///|
test "j1.r35 private enum ctors, transitive dep->bridge->app isolation, alias hijack & value && is-scoping" {
  // 1. Astra #1: private enum ctors (value & call positions) must still report E_PRIVATE_SYMBOL even after default-arg call
  let dep1 = check_source_files_full(
    "dep1",
    ["dep1.pion"],
    [
      "enum Secret { Empty; Wrap(Int) }\n" +
      "struct Item { v : Int }\n" +
      "let K : Int = 7\n" +
      "pub fn g(n : Int = { let xs : Array[Item] = []; xs.length() }) -> Int { n }\n" +
      "pub fn use_secret(n : Int = { let xs : Array[Secret] = []; xs.length() }) -> Int { n }\n" +
      "pub fn g_k(x : Int = K) -> Int { x }\n",
    ],
  )
  assert_true(dep1.diagnostics.length() == 0, check_result_to_json(dep1.diagnostics))
  let imp_dep1 = [ImportedPkg::{ name: "dep1", tc: dep1.tc }]

  let app1_val = check_source_files_with_imports(
    "app1_val",
    ["main.pion"],
    [
      "import \"dep1\"\n" +
      "pub fn main() -> Int { let _ = dep1::use_secret(); let _ = dep1::Secret::Empty; 0 }\n",
    ],
    imp_dep1,
    true,
  )
  assert_true(
    app1_val.diagnostics.length() >= 1 && app1_val.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app1_val.diagnostics),
  )
  let app1_call = check_source_files_with_imports(
    "app1_call",
    ["main.pion"],
    [
      "import \"dep1\"\n" +
      "pub fn main() -> Int { let _ = dep1::use_secret(); let _ = dep1::Secret::Wrap(1); 0 }\n",
    ],
    imp_dep1,
    true,
  )
  assert_true(
    app1_call.diagnostics.length() >= 1 && app1_call.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app1_call.diagnostics),
  )

  // 2. Astra #2: dep1 -> bridge -> app transitive import must NOT leak private Item / Secret into app
  let bridge = check_source_files_with_imports(
    "bridge",
    ["bridge.pion"],
    [
      "import \"dep1\"\n" +
      "pub fn run_bridge() -> Int { dep1::g() + dep1::use_secret() }\n",
    ],
    imp_dep1,
    true,
  )
  assert_true(bridge.diagnostics.length() == 0, check_result_to_json(bridge.diagnostics))
  let imp_b_and_d = [
    ImportedPkg::{ name: "bridge", tc: bridge.tc },
    ImportedPkg::{ name: "dep1", tc: dep1.tc },
  ]
  let app2_item = check_source_files_with_imports(
    "app2_item",
    ["main.pion"],
    [
      "import \"bridge\"\n" +
      "import \"dep1\"\n" +
      "pub fn main() -> Int { let _ = bridge::run_bridge(); let xs : Array[dep1::Item] = []; xs.length() }\n",
    ],
    imp_b_and_d,
    true,
  )
  assert_true(
    app2_item.diagnostics.length() >= 1 && app2_item.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app2_item.diagnostics),
  )
  let app2_sec = check_source_files_with_imports(
    "app2_sec",
    ["main.pion"],
    [
      "import \"bridge\"\n" +
      "import \"dep1\"\n" +
      "pub fn main() -> Int { let _ = bridge::run_bridge(); let _ = dep1::Secret::Empty; 0 }\n",
    ],
    imp_b_and_d,
    true,
  )
  assert_true(
    app2_sec.diagnostics.length() >= 1 && app2_sec.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app2_sec.diagnostics),
  )

  // 3. Astra #3: `import "dep1" as lib` + `import "decoy" as dep1` must NOT hijack dep1's default_expr
  let decoy_a = check_source_files_full("decoy_a", ["decoy.pion"], ["pub fn noop() -> Int { 0 }\n"])
  assert_true(decoy_a.diagnostics.length() == 0, check_result_to_json(decoy_a.diagnostics))
  let app3_a = check_source_files_with_imports(
    "app3_a",
    ["main.pion"],
    [
      "import \"dep1\" as lib\n" +
      "import \"decoy_a\" as dep1\n" +
      "pub fn main() -> Int { let _ = dep1::noop(); lib::g() + lib::g_k() }\n",
    ],
    [
      ImportedPkg::{ name: "dep1", tc: dep1.tc },
      ImportedPkg::{ name: "decoy_a", tc: decoy_a.tc },
    ],
    true,
  )
  assert_true(app3_a.diagnostics.length() == 0, check_result_to_json(app3_a.diagnostics))

  let decoy_b = check_source_files_full(
    "decoy_b",
    ["decoy.pion"],
    ["pub struct Item { s : String }\npub let K : Int = 999\n"],
  )
  assert_true(decoy_b.diagnostics.length() == 0, check_result_to_json(decoy_b.diagnostics))
  let app3_b = check_source_files_with_imports(
    "app3_b",
    ["main.pion"],
    [
      "import \"dep1\" as lib\n" +
      "import \"decoy_b\" as dep1\n" +
      "pub fn main() -> Int { let x = lib::g() + lib::g_k(); let d = dep1::Item::{ s: \"ok\" }; x + d.s.length() }\n",
    ],
    [
      ImportedPkg::{ name: "dep1", tc: dep1.tc },
      ImportedPkg::{ name: "decoy_b", tc: decoy_b.tc },
    ],
    true,
  )
  assert_true(app3_b.diagnostics.length() == 0, check_result_to_json(app3_b.diagnostics))

  // 4. Astra #4: value-position `(Some(false) is Some(k)) && k` must qualify RHS `k` as `dep4::k`
  let dep4 = check_source_files_full(
    "dep4",
    ["dep4.pion"],
    [
      "let k : Bool = true\n" +
      "pub fn val_and(b : Bool = (Some(false) is Some(k)) && k) -> Bool { b }\n",
    ],
  )
  assert_true(dep4.diagnostics.length() == 0, check_result_to_json(dep4.diagnostics))
  let imp_dep4 = [ImportedPkg::{ name: "dep4", tc: dep4.tc }]
  let app4_no_k = check_source_files_with_imports(
    "app4_no_k",
    ["main.pion"],
    ["import \"dep4\"\npub fn main() -> Int { if dep4::val_and() { 1 } else { 0 } }\n"],
    imp_dep4,
    true,
  )
  assert_true(app4_no_k.diagnostics.length() == 0, check_result_to_json(app4_no_k.diagnostics))
  let app4_with_k = check_source_files_with_imports(
    "app4_with_k",
    ["main.pion"],
    ["import \"dep4\"\nlet k : Bool = false\npub fn main() -> Int { let _ = k; if dep4::val_and() { 1 } else { 0 } }\n"],
    imp_dep4,
    true,
  )
  assert_true(app4_with_k.diagnostics.length() == 0, check_result_to_json(app4_with_k.diagnostics))
}

///|
test "j1.r36 canonical Ty lookup vs alias, missing struct in aliased pkg, PVariant resolved visibility & FnInfo.is_imported" {
  // 1. Astra #1: resolved canonical TStruct/TEnum must never be alias-redirected (dep::Item vs decoy::Item reversed fields)
  let dep1 = check_source_files_full(
    "dep",
    ["dep.pion"],
    [
      "pub struct Item { first : Int; second : Int }\n" +
      "pub fn make() -> Item { let mut s = 0; let mut i = 0; while i < 1 { s = s + 11; i = i + 1 }; Item::{ first: s, second: 22 } }\n",
    ],
  )
  assert_true(dep1.diagnostics.length() == 0, check_result_to_json(dep1.diagnostics))
  let decoy1 = check_source_files_full(
    "decoy",
    ["decoy.pion"],
    ["pub struct Item { second : Int; first : Int }\n"],
  )
  assert_true(decoy1.diagnostics.length() == 0, check_result_to_json(decoy1.diagnostics))
  let app1 = check_source_files_with_imports(
    "app1",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { let it = lib::make(); it.first + it.second }\n",
    ],
    [
      ImportedPkg::{ name: "dep", tc: dep1.tc },
      ImportedPkg::{ name: "decoy", tc: decoy1.tc },
    ],
    true,
  )
  assert_true(app1.diagnostics.length() == 0, check_result_to_json(app1.diagnostics))

  // 2. Astra #2: `dep::Item::{ v: 7 }` where `dep` aliases `decoy` (which has no `Item`) must fail, NOT fall back to `dep::Item`!
  let dep2 = check_source_files_full("dep", ["dep.pion"], ["pub struct Item { v : Int }\n"])
  assert_true(dep2.diagnostics.length() == 0, check_result_to_json(dep2.diagnostics))
  let decoy2 = check_source_files_full("decoy", ["decoy.pion"], ["pub fn noop() -> Int { 0 }\n"])
  assert_true(decoy2.diagnostics.length() == 0, check_result_to_json(decoy2.diagnostics))
  let imp2 = [
    ImportedPkg::{ name: "dep", tc: dep2.tc },
    ImportedPkg::{ name: "decoy", tc: decoy2.tc },
  ]
  let app2_bad = check_source_files_with_imports(
    "app2_bad",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { let _ = lib::Item::{ v: 1 }; let x = dep::Item::{ v: 7 }; x.v }\n",
    ],
    imp2,
    true,
  )
  assert_true(
    app2_bad.diagnostics.length() >= 1 && app2_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(app2_bad.diagnostics),
  )
  let app2_ok = check_source_files_with_imports(
    "app2_ok",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { let _ = dep::noop(); let x = lib::Item::{ v: 7 }; x.v }\n",
    ],
    imp2,
    true,
  )
  assert_true(app2_ok.diagnostics.length() == 0, check_result_to_json(app2_ok.diagnostics))

  // 3. Astra #3: PVariant checks visibility against resolved target pkg, NOT raw alias string
  let dep3 = check_source_files_full(
    "dep",
    ["dep.pion"],
    [
      "enum Secret { Empty }\n" +
      "pub fn use_secret(n : Int = { let xs : Array[Secret] = []; xs.length() }) -> Int { n }\n",
    ],
  )
  assert_true(dep3.diagnostics.length() == 0, check_result_to_json(dep3.diagnostics))
  let decoy3 = check_source_files_full(
    "decoy",
    ["decoy.pion"],
    ["pub enum Secret { Empty }\npub fn make() -> Secret { Secret::Empty }\n"],
  )
  assert_true(decoy3.diagnostics.length() == 0, check_result_to_json(decoy3.diagnostics))
  let imp3 = [
    ImportedPkg::{ name: "dep", tc: dep3.tc },
    ImportedPkg::{ name: "decoy", tc: decoy3.tc },
  ]
  let app3_ok = check_source_files_with_imports(
    "app3_ok",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int {\n" +
      "  let a = match dep::make() { dep::Secret::Empty => 1 }\n" +
      "  let _ = lib::use_secret()\n" +
      "  let b = match dep::make() { dep::Secret::Empty => 2 }\n" +
      "  a + b\n" +
      "}\n",
    ],
    imp3,
    true,
  )
  assert_true(app3_ok.diagnostics.length() == 0, check_result_to_json(app3_ok.diagnostics))
  let app3_bad = check_source_files_with_imports(
    "app3_bad",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { let _ = lib::use_secret(); let _ = lib::Secret::Empty; 0 }\n",
    ],
    imp3,
    true,
  )
  assert_true(
    app3_bad.diagnostics.length() >= 1 && app3_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app3_bad.diagnostics),
  )

  // 4. Astra #4: FnInfo.is_imported avoids local struct name collision with imported pkg name (`struct Lib` + `import "Lib" as actual; import "decoy" as Lib`)
  let dep4 = check_source_files_full(
    "Lib",
    ["lib.pion"],
    ["let K : Int = 7\npub fn g(x : Int = K) -> Int { x }\n"],
  )
  assert_true(dep4.diagnostics.length() == 0, check_result_to_json(dep4.diagnostics))
  let decoy4 = check_source_files_full("decoy", ["decoy.pion"], ["pub let K : String = \"bad\"\n"])
  assert_true(decoy4.diagnostics.length() == 0, check_result_to_json(decoy4.diagnostics))
  let app4 = check_source_files_with_imports(
    "app4",
    ["main.pion"],
    [
      "import \"Lib\" as actual\n" +
      "import \"decoy\" as Lib\n" +
      "struct Lib { x : Int }\n" +
      "pub fn main() -> Int { let l = Lib::{ x: actual::g() }; let _ = Lib::K; l.x }\n",
    ],
    [
      ImportedPkg::{ name: "Lib", tc: dep4.tc },
      ImportedPkg::{ name: "decoy", tc: decoy4.tc },
    ],
    true,
  )
  assert_true(app4.diagnostics.length() == 0, check_result_to_json(app4.diagnostics))
}

///|
test "j1.r37 omitted struct lit alias safety, static method fn-value alias & PVariant enum identity check" {
  // 1. Astra #2: omitted struct lit `{ v: 7 }` and `{ ..x, v: 8 }` must NOT alias-redirect canonical inferred `dep::Item`
  let dep1 = check_source_files_full("dep", ["dep.pion"], ["pub struct Item { v : Int }\n"])
  assert_true(dep1.diagnostics.length() == 0, check_result_to_json(dep1.diagnostics))
  let decoy1 = check_source_files_full("decoy", ["decoy.pion"], ["pub fn noop() -> Int { 0 }\n"])
  assert_true(decoy1.diagnostics.length() == 0, check_result_to_json(decoy1.diagnostics))
  let app1 = check_source_files_with_imports(
    "app1",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { let _ = dep::noop(); let x : lib::Item = { v: 7 }; let y = { ..x, v: 8 }; x.v + y.v }\n",
    ],
    [
      ImportedPkg::{ name: "dep", tc: dep1.tc },
      ImportedPkg::{ name: "decoy", tc: decoy1.tc },
    ],
    true,
  )
  assert_true(app1.diagnostics.length() == 0, check_result_to_json(app1.diagnostics))

  // 2. Astra #4: qualified PVariant must match scrutinee enum canonical identity
  let dep2 = check_source_files_full("dep", ["dep.pion"], ["pub enum Secret { Empty }\n"])
  assert_true(dep2.diagnostics.length() == 0, check_result_to_json(dep2.diagnostics))
  let decoy2 = check_source_files_full("decoy", ["decoy.pion"], ["pub enum Secret { Empty }\n"])
  assert_true(decoy2.diagnostics.length() == 0, check_result_to_json(decoy2.diagnostics))
  let imp2 = [
    ImportedPkg::{ name: "dep", tc: dep2.tc },
    ImportedPkg::{ name: "decoy", tc: decoy2.tc },
  ]
  let app2_bad = check_source_files_with_imports(
    "app2_bad",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int { match lib::Secret::Empty { dep::Secret::Empty => 1; _ => 0 } }\n",
    ],
    imp2,
    true,
  )
  assert_true(
    app2_bad.diagnostics.length() >= 1 && app2_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(app2_bad.diagnostics),
  )
  let app2_ok = check_source_files_with_imports(
    "app2_ok",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "pub fn main() -> Int {\n" +
      "  let a = match lib::Secret::Empty { lib::Secret::Empty => 1 }\n" +
      "  let b = match dep::Secret::Empty { dep::Secret::Empty => 2 }\n" +
      "  a + b\n" +
      "}\n",
    ],
    imp2,
    true,
  )
  assert_true(app2_ok.diagnostics.length() == 0, check_result_to_json(app2_ok.diagnostics))
}

///|
test "j1.r38 trait alias vs canonical lookup_trait & unqualified .Variant pattern in cross-pkg default_expr" {
  // 1. Astra #2: `impl dep::Tag` / `dyn dep::Tag` vs `impl lib::Tag` / `dyn lib::Tag` under `import "dep" as lib; import "decoy" as dep`
  let dep1 = check_source_files_full("dep", ["dep.pion"], ["pub trait Tag { fn first(self : Self) -> Int }\n"])
  assert_true(dep1.diagnostics.length() == 0, check_result_to_json(dep1.diagnostics))
  let decoy1 = check_source_files_full("decoy", ["decoy.pion"], ["pub trait Tag { fn second(self : Self) -> Int }\n"])
  assert_true(decoy1.diagnostics.length() == 0, check_result_to_json(decoy1.diagnostics))
  let app1 = check_source_files_with_imports(
    "app1",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "struct X { v : Int }\n" +
      "struct Y { v : Int }\n" +
      "impl dep::Tag for X { fn second(self : X) -> Int { self.v + 20 } }\n" +
      "impl lib::Tag for Y { fn first(self : Y) -> Int { self.v + 10 } }\n" +
      "fn call_decoy(t : dyn dep::Tag) -> Int { t.second() }\n" +
      "fn call_dep(t : dyn lib::Tag) -> Int { t.first() }\n" +
      "pub fn main() -> Int { call_decoy(X::{ v: 2 }) + call_dep(Y::{ v: 1 }) }\n",
    ],
    [
      ImportedPkg::{ name: "dep", tc: dep1.tc },
      ImportedPkg::{ name: "decoy", tc: decoy1.tc },
    ],
    true,
  )
  assert_true(app1.diagnostics.length() == 0, check_result_to_json(app1.diagnostics))

  // 2. Astra #3: qualify_imported_pat preserves unqualified `.Hit` without guessing `bridge::Local::Hit`
  let other = check_source_files_full("other", ["other.pion"], ["pub enum E { Hit }\npub fn make() -> E { E::Hit }\n"])
  assert_true(other.diagnostics.length() == 0, check_result_to_json(other.diagnostics))
  let imp_other = [ImportedPkg::{ name: "other", tc: other.tc }]
  let bridge = check_source_files_with_imports(
    "bridge",
    ["bridge.pion"],
    [
      "import \"other\"\n" +
      "enum Local { Hit }\n" +
      "pub fn g(x : Int = match other::make() { .Hit => 7 }) -> Int { x }\n" +
      "pub fn self_call() -> Int { let _ = Local::Hit; g() }\n",
    ],
    imp_other,
    true,
  )
  assert_true(bridge.diagnostics.length() == 0, check_result_to_json(bridge.diagnostics))
  let app2 = check_source_files_with_imports(
    "app2",
    ["main.pion"],
    ["import \"bridge\"\npub fn main() -> Int { bridge::g() + bridge::self_call() }\n"],
    [
      ImportedPkg::{ name: "bridge", tc: bridge.tc },
      ImportedPkg::{ name: "other", tc: other.tc },
    ],
    true,
  )
  assert_true(app2.diagnostics.length() == 0, check_result_to_json(app2.diagnostics))
  // Contrast: explicit wrong enum `Local::Hit` on `other::E` still fails `E_TYPE_MISMATCH`
  let bridge_bad = check_source_files_with_imports(
    "bridge_bad",
    ["bridge.pion"],
    [
      "import \"other\"\n" +
      "enum Local { Hit }\n" +
      "pub fn bad() -> Int { match other::make() { Local::Hit => 7; _ => 0 } }\n",
    ],
    imp_other,
    true,
  )
  assert_true(
    bridge_bad.diagnostics.length() >= 1 && bridge_bad.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(bridge_bad.diagnostics),
  )
}

///|
test "j1.r39 lookup_source_trait_ex: private impl, aliased generic bound & cross-pkg private dyn default" {
  // 1. Case A: private trait `impl dep::Hidden for X` -> E_PRIVATE_SYMBOL; `pub trait Hidden` -> ok
  let dep_priv = check_source_files_full(
    "dep",
    ["dep.pion"],
    [
      "trait Hidden { fn tag(self : Self) -> Int }\n" +
      "pub trait Tag { fn first(self : Self) -> Int }\n" +
      "pub fn use_dyn(n : Int = { let xs : Array[dyn Hidden] = []; xs.length() }) -> Int { n }\n",
    ],
  )
  assert_true(dep_priv.diagnostics.length() == 0, check_result_to_json(dep_priv.diagnostics))
  let imp_dep = [ImportedPkg::{ name: "dep", tc: dep_priv.tc }]
  let app_impl_priv = check_source_files_with_imports(
    "app_impl_priv",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "struct X { v : Int }\n" +
      "impl dep::Hidden for X { fn tag(self : X) -> Int { self.v } }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
    imp_dep,
    true,
  )
  assert_true(
    app_impl_priv.diagnostics.length() >= 1 && app_impl_priv.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app_impl_priv.diagnostics),
  )
  let dep_pub = check_source_files_full("dep", ["dep.pion"], ["pub trait Hidden { fn tag(self : Self) -> Int }\n"])
  assert_true(dep_pub.diagnostics.length() == 0, check_result_to_json(dep_pub.diagnostics))
  let app_impl_pub = check_source_files_with_imports(
    "app_impl_pub",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "struct X { v : Int }\n" +
      "impl dep::Hidden for X { fn tag(self : X) -> Int { self.v } }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
    [ImportedPkg::{ name: "dep", tc: dep_pub.tc }],
    true,
  )
  assert_true(app_impl_pub.diagnostics.length() == 0, check_result_to_json(app_impl_pub.diagnostics))

  // 2. Case B: uncalled generic fn bound `fn f[T : dep::Tag]` under `import "dep" as lib; import "decoy" as dep` (decoy has no Tag) -> E_UNKNOWN_TRAIT; `lib::Tag` -> ok; `dep::Hidden` -> E_PRIVATE_SYMBOL
  let decoy = check_source_files_full("decoy", ["decoy.pion"], ["pub fn noop() -> Int { 0 }\n"])
  assert_true(decoy.diagnostics.length() == 0, check_result_to_json(decoy.diagnostics))
  let imp_alias = [
    ImportedPkg::{ name: "dep", tc: dep_priv.tc },
    ImportedPkg::{ name: "decoy", tc: decoy.tc },
  ]
  let app_bound_bad = check_source_files_with_imports(
    "app_bound_bad",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "fn f[T : dep::Tag](x : T) -> Int { let _ = x; 0 }\n" +
      "pub fn main() -> Int { let _ = dep::noop(); 0 }\n",
    ],
    imp_alias,
    true,
  )
  assert_true(
    app_bound_bad.diagnostics.length() >= 1 && app_bound_bad.diagnostics[0].code == "E_UNKNOWN_TRAIT",
    check_result_to_json(app_bound_bad.diagnostics),
  )
  let app_bound_ok = check_source_files_with_imports(
    "app_bound_ok",
    ["main.pion"],
    [
      "import \"dep\" as lib\n" +
      "import \"decoy\" as dep\n" +
      "fn f[T : lib::Tag](x : T) -> Int { let _ = x; 0 }\n" +
      "pub fn main() -> Int { let _ = dep::noop(); 0 }\n",
    ],
    imp_alias,
    true,
  )
  assert_true(app_bound_ok.diagnostics.length() == 0, check_result_to_json(app_bound_ok.diagnostics))
  let app_bound_priv = check_source_files_with_imports(
    "app_bound_priv",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "fn g[T : dep::Hidden](x : T) -> Int { let _ = x; 0 }\n" +
      "pub fn main() -> Int { 0 }\n",
    ],
    imp_dep,
    true,
  )
  assert_true(
    app_bound_priv.diagnostics.length() >= 1 && app_bound_priv.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app_bound_priv.diagnostics),
  )

  // 3. Case C: cross-pkg default_expr using private `Array[dyn Hidden]` passes, while direct `Array[dyn dep::Hidden]` in app (even after `dep::use_dyn()`) fails E_PRIVATE_SYMBOL
  let app_dyn_ok = check_source_files_with_imports(
    "app_dyn_ok",
    ["main.pion"],
    ["import \"dep\"\npub fn main() -> Int { dep::use_dyn() }\n"],
    imp_dep,
    true,
  )
  assert_true(app_dyn_ok.diagnostics.length() == 0, check_result_to_json(app_dyn_ok.diagnostics))
  let app_dyn_bad = check_source_files_with_imports(
    "app_dyn_bad",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "pub fn main() -> Int { let _ = dep::use_dyn(); let xs : Array[dyn dep::Hidden] = []; xs.length() }\n",
    ],
    imp_dep,
    true,
  )
  assert_true(
    app_dyn_bad.diagnostics.length() == 1 && app_dyn_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app_dyn_bad.diagnostics),
  )
}

///|
test "j1.r40 cross-pkg default_expr calling private dyn Trait methods with qualified Item param/ret" {
  let dep = check_source_files_full(
    "dep",
    ["dep.pion"],
    [
      "pub struct Item { v : Int }\n" +
      "trait Hidden {\n" +
      "  fn tag(self : Self) -> Int\n" +
      "  fn score(self : Self, p : Item) -> Int\n" +
      "  fn get(self : Self) -> Item\n" +
      "}\n" +
      "struct X { v : Int }\n" +
      "impl Hidden for X {\n" +
      "  fn tag(self : X) -> Int { self.v }\n" +
      "  fn score(self : X, p : Item) -> Int { self.v + p.v }\n" +
      "  fn get(self : X) -> Item { Item::{ v: self.v + 1 } }\n" +
      "}\n" +
      "pub fn run_dyn(n : Int = {\n" +
      "  let h : dyn Hidden = X::{ v: 7 }\n" +
      "  h.tag() * 100 + h.score(Item::{ v: 3 }) * 10 + h.get().v\n" +
      "}) -> Int { n }\n",
    ],
  )
  assert_true(dep.diagnostics.length() == 0, check_result_to_json(dep.diagnostics))
  let imp_dep = [ImportedPkg::{ name: "dep", tc: dep.tc }]

  // app defines incompatible local `struct Item { pad : String; v : Int }`
  let app_ok = check_source_files_with_imports(
    "app_ok",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "struct Item { pad : String; v : Int }\n" +
      "pub fn main() -> Int { let local_it = Item::{ pad: \"x\", v: 1 }; dep::run_dyn() + local_it.v }\n",
    ],
    imp_dep,
    true,
  )
  assert_true(app_ok.diagnostics.length() == 0, check_result_to_json(app_ok.diagnostics))

  // direct `dyn dep::Hidden` in app still reports E_PRIVATE_SYMBOL even after `dep::run_dyn()`
  let app_bad = check_source_files_with_imports(
    "app_bad",
    ["main.pion"],
    [
      "import \"dep\"\n" +
      "pub fn main() -> Int { let _ = dep::run_dyn(); let xs : Array[dyn dep::Hidden] = []; xs.length() }\n",
    ],
    imp_dep,
    true,
  )
  assert_true(
    app_bad.diagnostics.length() == 1 && app_bad.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(app_bad.diagnostics),
  )
}

///|
test "j1.r56: call?: ambig & tc_nonlocal_builtin (no method calls)" {
  // Case 1: shadowed local `let B = f; B()` with no method calls -> untyped flags ambig, typed keeps order ["A", "B"]
  let c1 = check_source_files_full(
    "r56_c1",
    ["main.pion"],
    [
      "fn f0() -> Int { 1 }\n" +
      "fn go(f : () -> Int) -> Int { let B = f; B() }\n" +
      "let A : Int = go(f0)\n" +
      "let B : Int = f0()\n" +
      "pub fn main() -> Int { A + B }\n",
    ],
  )
  assert_true(c1.diagnostics.length() == 0, check_result_to_json(c1.diagnostics))
  let p1_untyped = compute_const_init_plan_from_pkg(c1.pkg)
  let p1_typed = compute_const_init_plan_from_pkg_tc(c1.pkg, c1.tc)
  assert_true(p1_untyped.has_ambiguous_method, "c1 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p1_typed.has_cycle && p1_typed.order.length() == 2 && p1_typed.order[0] == "A" && p1_typed.order[1] == "B",
    "c1 typed order must be [A, B]",
  )

  // Case 2: shadowed enum ctor `let Hit = f; let _ = Hit(7); 0` (generic T) -> untyped flags ambig, typed keeps order ["A", "B"]
  let c2 = check_source_files_full(
    "r56_c2",
    ["main.pion"],
    [
      "enum E { Hit(Int) }\n" +
      "fn read_b(x : Int) -> Int { B + x }\n" +
      "fn go[T](f : T) -> Int { let Hit = f; let _ = Hit; let _ = Hit(7); 0 }\n" +
      "let A : Int = go(read_b)\n" +
      "let B : Int = 1\n" +
      "pub fn main() -> Int { A + B }\n",
    ],
  )
  assert_true(c2.diagnostics.length() == 0, check_result_to_json(c2.diagnostics))
  let p2_untyped = compute_const_init_plan_from_pkg(c2.pkg)
  let p2_typed = compute_const_init_plan_from_pkg_tc(c2.pkg, c2.tc)
  assert_true(p2_untyped.has_ambiguous_method, "c2 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p2_typed.has_cycle && p2_typed.order.length() == 2 && p2_typed.order[0] == "A" && p2_typed.order[1] == "B",
    "c2 typed order must be [A, B]",
  )

  // Case 3: shadowed builtin `let ignore = f; ignore(7); 0` (generic T) -> untyped flags ambig, typed has no false cycle & order ["A"]
  let c3 = check_source_files_full(
    "r56_c3",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go[T](f : T) -> Int { let ignore = f; let _ = ignore; ignore(7); 0 }\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c3.diagnostics.length() == 0, check_result_to_json(c3.diagnostics))
  let p3_untyped = compute_const_init_plan_from_pkg(c3.pkg)
  let p3_typed = compute_const_init_plan_from_pkg_tc(c3.pkg, c3.tc)
  assert_true(p3_untyped.has_ambiguous_method, "c3 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p3_typed.has_cycle && p3_typed.order.length() == 1 && p3_typed.order[0] == "A",
    "c3 typed must have no false cycle and order [A]",
  )

  // Case 4 (R57): original Some(f) + ignore(7) positive (no method calls)
  let c4 = check_source_files_full(
    "r57_c4",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int { let ignore = Some(f); ignore(7); 0 }\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c4.diagnostics.length() == 0, check_result_to_json(c4.diagnostics))
  let p4_untyped = compute_const_init_plan_from_pkg(c4.pkg)
  let p4_typed = compute_const_init_plan_from_pkg_tc(c4.pkg, c4.tc)
  assert_true(p4_untyped.has_ambiguous_method, "c4 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p4_typed.has_cycle && p4_typed.order.length() == 1 && p4_typed.order[0] == "A",
    "c4 typed must have no false cycle and order [A]",
  )

  // Case 5 (R57): original Some(f) + Hit(7) positive (no method calls)
  let c5 = check_source_files_full(
    "r57_c5",
    ["main.pion"],
    [
      "enum E { Hit(Int) }\n" +
      "fn read_b(x : Int) -> Int { B + x }\n" +
      "fn go(f : (Int) -> Int) -> Int { let Hit = Some(f); let _ = Hit(7); 0 }\n" +
      "let A : Int = go(read_b)\n" +
      "let B : Int = 1\n" +
      "pub fn main() -> Int { A + B }\n",
    ],
  )
  assert_true(c5.diagnostics.length() == 0, check_result_to_json(c5.diagnostics))
  let p5_untyped = compute_const_init_plan_from_pkg(c5.pkg)
  let p5_typed = compute_const_init_plan_from_pkg_tc(c5.pkg, c5.tc)
  assert_true(p5_untyped.has_ambiguous_method, "c5 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p5_typed.has_cycle && p5_typed.order.length() == 2 && p5_typed.order[0] == "A" && p5_typed.order[1] == "B",
    "c5 typed order must be [A, B]",
  )

  // Case 6 (R57): negative pair — unpacking Some(f) and calling g(7) must still detect E_CONST_CYCLE
  let c6 = check_source_files_full(
    "r57_c6",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int {\n" +
      "  let ignore = Some(f)\n" +
      "  ignore(7)\n" +
      "  match ignore { Some(g) => g(7) None => 0 }\n" +
      "}\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  let p6_typed = compute_const_init_plan_from_pkg_tc(c6.pkg, c6.tc)
  assert_true(p6_typed.has_cycle, "c6 typed must detect const cycle when unpacked closure is called")
  let c6_json = check_result_to_json(c6.diagnostics)
  assert_true(c6_json.contains("E_CONST_CYCLE"), "c6 must emit E_CONST_CYCLE: " + c6_json)

  // Case 7 (R58): .Some(f) + ignore(7) positive (no method calls)
  let c7 = check_source_files_full(
    "r58_c7",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int { let ignore : Option[(Int) -> Int] = .Some(f); ignore(7); 0 }\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c7.diagnostics.length() == 0, check_result_to_json(c7.diagnostics))
  let p7_untyped = compute_const_init_plan_from_pkg(c7.pkg)
  let p7_typed = compute_const_init_plan_from_pkg_tc(c7.pkg, c7.tc)
  assert_true(p7_untyped.has_ambiguous_method, "c7 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p7_typed.has_cycle && p7_typed.order.length() == 1 && p7_typed.order[0] == "A",
    "c7 typed must have no false cycle and order [A]",
  )

  // Case 8 (R58): Some(move f) + ignore(7) positive (no method calls)
  let c8 = check_source_files_full(
    "r58_c8",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int { let ignore = Some(move f); ignore(7); 0 }\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c8.diagnostics.length() == 0, check_result_to_json(c8.diagnostics))
  let p8_untyped = compute_const_init_plan_from_pkg(c8.pkg)
  let p8_typed = compute_const_init_plan_from_pkg_tc(c8.pkg, c8.tc)
  assert_true(p8_untyped.has_ambiguous_method, "c8 untyped must flag has_ambiguous_method via call?:")
  assert_true(
    !p8_typed.has_cycle && p8_typed.order.length() == 1 && p8_typed.order[0] == "A",
    "c8 typed must have no false cycle and order [A]",
  )

  // Case 9a (R58): Some(f(7)) negative — calling f inside ctor arg must emit E_CONST_CYCLE
  let c9a = check_source_files_full(
    "r58_c9a",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int { let ignore = Some(f(7)); ignore(7); 0 }\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  let p9a_typed = compute_const_init_plan_from_pkg_tc(c9a.pkg, c9a.tc)
  assert_true(p9a_typed.has_cycle, "c9a typed must detect const cycle for Some(f(7))")
  let c9a_json = check_result_to_json(c9a.diagnostics)
  assert_true(c9a_json.contains("E_CONST_CYCLE"), "c9a must emit E_CONST_CYCLE: " + c9a_json)

  // Case 9b (R58): .Some(move f) unpacked & called must emit E_CONST_CYCLE
  let c9b = check_source_files_full(
    "r58_c9b",
    ["main.pion"],
    [
      "fn read_a(x : Int) -> Int { A + x }\n" +
      "fn go(f : (Int) -> Int) -> Int {\n" +
      "  let ignore : Option[(Int) -> Int] = .Some(move f)\n" +
      "  ignore(7)\n" +
      "  match ignore { Some(g) => g(7) None => 0 }\n" +
      "}\n" +
      "let A : Int = go(read_a)\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  let p9b_typed = compute_const_init_plan_from_pkg_tc(c9b.pkg, c9b.tc)
  assert_true(p9b_typed.has_cycle, "c9b typed must detect const cycle for unpacked .Some(move f)")
  let c9b_json = check_result_to_json(c9b.diagnostics)
  assert_true(c9b_json.contains("E_CONST_CYCLE"), "c9b must emit E_CONST_CYCLE: " + c9b_json)

  // Case 10 (R59): escaping ctor param_forward_ctor (`fn wrap(f) { Some(f) }`) must detect E_CONST_CYCLE
  let c10 = check_source_files_full(
    "r59_c10",
    ["main.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "fn wrap(f : () -> Int) -> Option[() -> Int] { Some(f) }\n" +
      "let A : Int = match wrap(read_a) { Some(g) => g() None => 0 }\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  let p10_typed = compute_const_init_plan_from_pkg_tc(c10.pkg, c10.tc)
  assert_true(p10_typed.has_cycle, "c10 typed must detect const cycle for escaping Some(f)")
  let c10_json = check_result_to_json(c10.diagnostics)
  assert_true(c10_json.contains("E_CONST_CYCLE"), "c10 must emit E_CONST_CYCLE: " + c10_json)

  // Case 11a (R59): top-level const_opt_closure (`let HC = Some(fn() { read_a() })`) called via match -> E_CONST_CYCLE
  let c11a = check_source_files_full(
    "r59_c11a",
    ["main.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "let HC : Option[() -> Int] = Some(fn() -> Int { read_a() })\n" +
      "let A : Int = match HC { Some(f) => f() None => 0 }\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  let p11a_typed = compute_const_init_plan_from_pkg_tc(c11a.pkg, c11a.tc)
  assert_true(p11a_typed.has_cycle, "c11a typed must detect const cycle for const_opt_closure")
  let c11a_json = check_result_to_json(c11a.diagnostics)
  assert_true(c11a_json.contains("E_CONST_CYCLE"), "c11a must emit E_CONST_CYCLE: " + c11a_json)

  // Case 11b (R59): precision — matching HC without calling f must NOT report cycle
  let c11b = check_source_files_full(
    "r59_c11b",
    ["main.pion"],
    [
      "fn read_a() -> Int { A }\n" +
      "let HC : Option[() -> Int] = Some(fn() -> Int { read_a() })\n" +
      "let A : Int = match HC { Some(_) => 0 None => 0 }\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c11b.diagnostics.length() == 0, check_result_to_json(c11b.diagnostics))
  let p11b_typed = compute_const_init_plan_from_pkg_tc(c11b.pkg, c11b.tc)
  assert_true(!p11b_typed.has_cycle, "c11b typed must not report false cycle when HC payload is not called")

  // Case 12 (R61): package-level `let Some : (Int) -> Int = read_b` shadowing builtin Some ctor (no method calls)
  let c12 = check_source_files_full(
    "r61_c12",
    ["main.pion"],
    [
      "fn read_b(x : Int) -> Int { B + x }\n" +
      "fn make_b() -> Int { 9 }\n" +
      "let Some : (Int) -> Int = read_b\n" +
      "let A : Int = Some(7)\n" +
      "let B : Int = make_b()\n" +
      "pub fn main() -> Int { A }\n",
    ],
  )
  assert_true(c12.diagnostics.length() == 0, check_result_to_json(c12.diagnostics))
  let p12_untyped = compute_const_init_plan_from_pkg(c12.pkg)
  let p12_typed = compute_const_init_plan_from_pkg_tc(c12.pkg, c12.tc)
  assert_true(p12_untyped.has_ambiguous_method, "c12 untyped must flag has_ambiguous_method via ctor?:Some")
  assert_true(!p12_typed.has_cycle, "c12 typed must not report false cycle")
  let mut idx_a12 = -1
  let mut idx_b12 = -1
  let mut k12 = 0
  while k12 < p12_typed.order.length() {
    if p12_typed.order[k12] == "A" {
      idx_a12 = k12
    } else if p12_typed.order[k12] == "B" {
      idx_b12 = k12
    }
    k12 = k12 + 1
  }
  assert_true(idx_b12 >= 0 && idx_a12 >= 0 && idx_b12 < idx_a12, "c12 typed must order B before A")
}

///|
test "wave_l1a: A1 constant patterns, fail-closed, exhaustiveness, stub roundtrip & hot-path precision" {
  // 1. Supported constant pattern types: Int, Int64, UInt, UInt64, Byte, Int8, Char, Bool, String, StrView, unit Enum
  let ok_src =
    #|enum Mode { Alpha; Beta; Gamma }
    #|let C_INT : Int = 7
    #|let C_I64 : Int64 = 70L
    #|let C_UINT : UInt = 3U
    #|let C_U64 : UInt64 = 9UL
    #|let C_BYTE : Byte = b'a'
    #|let C_I8 : Int8 = 4
    #|let C_CHAR : Char = 'z'
    #|let C_BOOL : Bool = true
    #|let C_STR : String = "ok"
    #|let C_SV : StrView = "ok".as_view()
    #|let DEFAULT_MODE : Mode = Mode::Alpha
    #|fn check_all(
    #|  i : Int, i64 : Int64, u : UInt, u64 : UInt64, b : Byte, i8 : Int8,
    #|  c : Char, bo : Bool, s : String, sv : StrView, m : Mode
    #|) -> Int {
    #|  let a = match i { C_INT => 1; _ => 0 }
    #|  let d = match i64 { C_I64 => 1; _ => 0 }
    #|  let e = match u { C_UINT => 1; _ => 0 }
    #|  let f = match u64 { C_U64 => 1; _ => 0 }
    #|  let g = match b { C_BYTE => 1; _ => 0 }
    #|  let h = match i8 { C_I8 => 1; _ => 0 }
    #|  let k = match c { C_CHAR => 1; _ => 0 }
    #|  let l = match bo { C_BOOL => 1; _ => 0 }
    #|  let n = match s { C_STR => 1; _ => 0 }
    #|  let o = match sv { C_SV => 1; _ => 0 }
    #|  let p = match m { DEFAULT_MODE => 1; Mode::Beta => 2; _ => 0 }
    #|  a + d + e + f + g + h + k + l + n + o + p
    #|}
  let ok_cr = check_source_files_full("l1a_a1_ok", ["main.pion"], [ok_src])
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  // 2. Reject .MATCH, MATCH(), Double, TParam scrutinee, struct const, undefined uppercase
  let bad_cases : Array[String] = [
    "let MATCH : Int = 1\nfn f(x : Int) -> Int { match x { .MATCH => 1; _ => 0 } }\n",
    "let MATCH : Int = 1\nfn f(x : Int) -> Int { match x { MATCH() => 1; _ => 0 } }\n",
    "let D : Double = 1.5\nfn f(x : Double) -> Int { match x { D => 1; _ => 0 } }\n",
    "let MATCH : Int = 1\nfn f[T](x : T) -> Int { match x { MATCH => 1; _ => 0 } }\n",
    "struct S { v : Int }\nlet CS : S = S::{ v: 1 }\nfn f(x : S) -> Int { match x { CS => 1; _ => 0 } }\n",
    "fn f(x : Int) -> Int { match x { UNDEF_CONST => 1; _ => 0 } }\n",
  ]
  let mut bi = 0
  while bi < bad_cases.length() {
    let bcr = check_source_files_full("l1a_a1_bad_" + bi.to_string(), ["main.pion"], [bad_cases[bi]])
    let bj = check_result_to_json(bcr.diagnostics)
    assert_true(bj.contains("E_TYPE_MISMATCH"), "bad case " + bi.to_string() + ": " + bj)
    assert_true(
      bj.contains("uppercase identifiers in patterns match variants or constants; use a lowercase name to bind a variable"),
      "bad case fixit " + bi.to_string() + ": " + bj,
    )
    bi = bi + 1
  }

  // 3. Exhaustiveness: Some(MATCH) and unit enum const must NOT satisfy exhaustiveness
  let exh1 = check_source_files_full(
    "l1a_a1_exh1",
    ["main.pion"],
    ["let MATCH : Int = 1\nfn f(x : Option[Int]) -> Int { match x { Some(MATCH) => 1; None => 0 } }\n"],
  )
  assert_true(check_result_to_json(exh1.diagnostics).contains("E_NON_EXHAUSTIVE"), check_result_to_json(exh1.diagnostics))
  let exh2 = check_source_files_full(
    "l1a_a1_exh2",
    ["main.pion"],
    ["enum Mode { A; B }\nlet DEFAULT_MODE : Mode = Mode::A\nfn f(m : Mode) -> Int { match m { DEFAULT_MODE => 1; Mode::B => 2 } }\n"],
  )
  assert_true(check_result_to_json(exh2.diagnostics).contains("E_NON_EXHAUSTIVE"), check_result_to_json(exh2.diagnostics))

  // 4. .pionstub round-trip preserves explicit_ctor (`Name()` vs `NAME`) & xpkg_pat_link_safe recognizes scalar const
  let stub_src =
    #|pub enum E { Zero; One(Int) }
    #|pub let MATCH : Int = 7
    #|pub fn f_const(x : Int) -> Int { match x { MATCH => 1; _ => 0 } }
    #|pub fn f_ctor(e : E) -> Int { match e { Zero() => 1; One(v) => v } }
  let stub_cr = check_source_files_with_imports("stub_a1", ["stub.pion"], [stub_src], [], true)
  assert_true(stub_cr.diagnostics.length() == 0, check_result_to_json(stub_cr.diagnostics))
  let stub_txt = emit_pion_stub(stub_cr.pkg)
  assert_true(stub_txt.contains("Zero()"), "stub must preserve explicit_ctor Zero(): " + stub_txt)
  assert_true(stub_txt.contains("MATCH =>"), "stub must keep bare const pattern MATCH: " + stub_txt)
  let stub_recheck = check_source_files_with_imports("stub_a1", ["stub_a1.pionstub"], [stub_txt], [], true)
  assert_true(stub_recheck.diagnostics.length() == 0, check_result_to_json(stub_recheck.diagnostics))

  // 5. Hot-path precision: bare unit enum variants with NO same-named const must NOT trigger has_ambiguous_method
  let prec_cr = check_source_files_full(
    "l1a_a1_prec",
    ["main.pion"],
    [
      "enum Color { Red; Green; Blue }\n" +
      "let OTHER : Int = 42\n" +
      "fn pick(c : Color) -> Int { match c { Red => 1; Green => 2; Blue => 3 } }\n" +
      "let A : Int = pick(Color::Red)\n",
    ],
  )
  assert_true(prec_cr.diagnostics.length() == 0, check_result_to_json(prec_cr.diagnostics))
  let prec_plan = compute_const_init_plan_from_pkg(prec_cr.pkg)
  assert_true(!prec_plan.has_ambiguous_method, "bare unit enum variants must not trigger hot-path fallback")

  // 6. E_CONST_CYCLE through match constant pattern
  let cyc_cr = check_source_files_full(
    "l1a_a1_cyc",
    ["main.pion"],
    [
      "fn hit(x : Int) -> Int { match x { A => 1; _ => 2 } }\n" +
      "let A : Int = hit(1)\n",
    ],
  )
  assert_true(check_result_to_json(cyc_cr.diagnostics).contains("E_CONST_CYCLE"), check_result_to_json(cyc_cr.diagnostics))
}

///|
test "wave_l1a: A2 unified EIs scoping in &&, !, ||, value pos, match guard & #verify" {
  let ok_src =
    #|struct G { set : Bool, tag : String }
    #|fn check_neg(g : Option[G]) -> Int {
    #|  if !(g is Some(g) && g.set) {
    #|    match g { Some(v) => v.tag.length(); None => 0 }
    #|  } else {
    #|    99
    #|  }
    #|}
    #|fn check_or_and(flag : Bool, p : Option[G]) -> Bool {
    #|  flag || (p is Some(x) && x.set)
    #|}
    #|fn check_val(p : Option[G]) -> Bool {
    #|  let b = (p is Some(x) && x.set)
    #|  b
    #|}
    #|fn check_guard(a : Option[Int], b : Option[G]) -> Int {
    #|  match a {
    #|    Some(n) if b is Some(g) && g.set => n + g.tag.length()
    #|    _ => 0
    #|  }
    #|}
    #|#verify fn check_verify(a : Option[Int], b : Option[Int]) -> Int {
    #|  let ok = !(a is Some(x) && x > 0)
    #|  let m = match a {
    #|    Some(v) if b is Some(w) && w > v => v + w
    #|    _ => 0
    #|  }
    #|  if ok { m } else { m + 1 }
    #|}
  let ok_cr = check_source_files_full("l1a_a2_ok", ["main.pion"], [ok_src])
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  // Negative 1: `p is Some(x) || x > 0` must fail (x undefined in || rhs)
  let bad_or = check_source_files_full(
    "l1a_a2_bad_or",
    ["main.pion"],
    ["fn f(p : Option[Int]) -> Bool { p is Some(x) || x > 0 }\n"],
  )
  assert_true(bad_or.diagnostics.length() > 0, "p is Some(x) || x > 0 must fail")

  // Negative 2: `if !(p is Some(x) && x > 0) { x }` must fail (x does not escape !(...))
  let bad_esc = check_source_files_full(
    "l1a_a2_bad_esc",
    ["main.pion"],
    ["fn f(p : Option[Int]) -> Int { if !(p is Some(x) && x > 0) { x } else { 0 } }\n"],
  )
  assert_true(bad_esc.diagnostics.length() > 0, "x must not escape !(p is Some(x) && ...)")
}

///|
test "wave_l1a: A3 unannotated closure fail-closed & two-pass generic inference" {
  let ok_src =
    #|fn fold[T, U](xs : Array[T], init : U, f : (U, T) -> U) -> U {
    #|  let mut acc = init
    #|  for x in xs { acc = f(acc, x) }
    #|  acc
    #|}
    #|fn apply[T, U](f : (T) -> U, x : T) -> U { f(x) }
    #|fn run() -> Int {
    #|  let a = fold([1, 2, 3], 0, fn(acc, x) { acc + x })
    #|  let b = apply(fn(x) { x + 1 }, 3)
    #|  a + b
    #|}
  let ok_cr = check_source_files_full("l1a_a3_ok", ["main.pion"], [ok_src])
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  let bad1 = check_source_files_full(
    "l1a_a3_bad1",
    ["main.pion"],
    ["fn run() -> Int { let g = fn(x) { x + 7 }; g(1) }\n"],
  )
  assert_true(check_result_to_json(bad1.diagnostics).contains("E_TYPE_MISMATCH"), check_result_to_json(bad1.diagnostics))

  let bad2 = check_source_files_full(
    "l1a_a3_bad2",
    ["main.pion"],
    ["fn id[T](f : (T) -> Int) -> Int { 0 }\nfn run() -> Int { id(fn(x) { x + 1 }) }\n"],
  )
  assert_true(check_result_to_json(bad2.diagnostics).contains("E_TYPE_MISMATCH"), check_result_to_json(bad2.diagnostics))
}

///|
test "wave_l1a: A4 builtin ::new and ::with_capacity strict arity and named-arg checks" {
  let arity_bad : Array[String] = [
    "fn f() -> Unit { let _ = StringBuilder::new(1) }\n",
    "fn f() -> Unit { let _ : Map[String, Int] = Map::new(1) }\n",
    "fn f() -> Unit { let _ : Array[Int] = Array::new(1) }\n",
    "fn f() -> Unit { let _ = Bytes::new(1, 2) }\n",
    "fn f() -> Unit { let _ : Channel[Int] = Channel::new(1, 2) }\n",
    "fn f() -> Unit { let _ : Mutex[Int] = Mutex::new() }\n",
    "fn f() -> Unit { let _ = Mutex::new(1, 2) }\n",
    "fn f() -> Unit { let _ = AtomicInt::new() }\n",
    "fn f() -> Unit { let _ = AtomicInt::new(1, 2) }\n",
    "fn f() -> Unit { let _ = StringBuilder::with_capacity() }\n",
    "fn f() -> Unit { let _ : Map[String, Int] = Map::with_capacity() }\n",
    "fn f() -> Unit { let _ : Array[Int] = Array::with_capacity() }\n",
  ]
  let mut i = 0
  while i < arity_bad.length() {
    let cr = check_source_files_full("l1a_a4_a_" + i.to_string(), ["main.pion"], [arity_bad[i]])
    assert_true(check_result_to_json(cr.diagnostics).contains("E_ARITY_MISMATCH"), "arity case " + i.to_string() + ": " + check_result_to_json(cr.diagnostics))
    i = i + 1
  }
  let named_bad = check_source_files_full(
    "l1a_a4_named",
    ["main.pion"],
    ["fn f() -> Unit { let _ = Bytes::new(cap=4); let _ = Array::with_capacity(cap=4); let _ = AtomicInt::new(val=\"x\") }\n"],
  )
  assert_true(named_bad.diagnostics.length() >= 3, check_result_to_json(named_bad.diagnostics))
  let ok_zero = check_source_files_full(
    "l1a_a4_ok",
    ["main.pion"],
    ["fn f() -> Unit { let _ = Bytes::new(); let _ : Channel[Int] = Channel::new(); let _ = StringBuilder::new(); let _ = AtomicInt::new(0); let _ = Mutex::new(1) }\n"],
  )
  assert_true(ok_zero.diagnostics.length() == 0, check_result_to_json(ok_zero.diagnostics))
}

///|
test "wave_l1a: A6 struct literal dup/missing fields & add_missing_impl_edit alias rendering" {
  // 1. Duplicate field (with and without spread) + missing fields in declaration order
  let s_bad = check_source_files_full(
    "l1a_a6_struct",
    ["main.pion"],
    [
      "struct Pt { a : Int, b : Int, c : Int }\n" +
      "fn f(p : Pt) -> Unit {\n" +
      "  let _ = Pt::{ a: 1, a: 2, b: 3, c: 4 }\n" +
      "  let _ = Pt::{ ..p, b: 1, b: 2 }\n" +
      "  let _ = Pt::{ b: 2 }\n" +
      "}\n",
    ],
  )
  let sj = check_result_to_json(s_bad.diagnostics)
  assert_true(sj.contains("duplicate field `a`"), sj)
  assert_true(sj.contains("duplicate field `b`"), sj)
  assert_true(sj.contains("missing fields `a`, `c`"), sj)

  // 2. add_missing_impl_edit renders visible import alias + `mut` params & produces 0 diagnostics when applied
  let tlib_src =
    #|pub struct Val { n : Int }
    #|pub trait ShowVal {
    #|  show(self : Self, v : Val) -> Val
    #|  tick(mut self : Self) -> Unit
    #|}
    #|pub fn run_show[T : ShowVal](mut x : T, v : Val) -> Val {
    #|  x.tick()
    #|  x.show(v)
    #|}
  let tlib_cr = check_source_files_with_imports("tlib__a1b2c3d4", ["tlib.pion"], [tlib_src], [], true)
  assert_true(tlib_cr.diagnostics.length() == 0, check_result_to_json(tlib_cr.diagnostics))
  let app_src =
    #|import "tlib" as tl
    #|struct MyItem { x : Int }
    #|fn go(mut m : MyItem, v : tl::Val) -> tl::Val { tl::run_show(mut m, v) }
  let app_cr = check_source_files_with_imports_mapped(
    "app_a6",
    ["main.pion"],
    [app_src],
    [imported_pkg_new("tlib__a1b2c3d4", tlib_cr.tc)],
    ["tlib"],
    ["tlib__a1b2c3d4"],
    true,
    false,
  )
  assert_true(app_cr.diagnostics.length() > 0, "expected E_TRAIT_NOT_IMPLEMENTED")
  let mut edit_rep = ""
  let mut di = 0
  while di < app_cr.diagnostics.length() {
    let d = app_cr.diagnostics[di]
    if d.code == "E_TRAIT_NOT_IMPLEMENTED" && d.edits.length() > 0 {
      edit_rep = d.edits[0].replacement
    }
    di = di + 1
  }
  assert_true(edit_rep.contains("impl tl::ShowVal for MyItem"), "edit must use alias tl::ShowVal: " + edit_rep)
  assert_true(edit_rep.contains("tl::Val"), "edit must use alias tl::Val: " + edit_rep)
  assert_true(edit_rep.contains("fn tick(mut self : MyItem) -> Unit"), "edit must preserve mut param: " + edit_rep)
  assert_true(!edit_rep.contains("tlib__a1b2c3d4"), "edit must not leak canon id: " + edit_rep)
  let fixed_src = app_src + edit_rep + "\n"
  let recheck_cr = check_source_files_with_imports_mapped(
    "app_a6",
    ["main.pion"],
    [fixed_src],
    [imported_pkg_new("tlib__a1b2c3d4", tlib_cr.tc)],
    ["tlib"],
    ["tlib__a1b2c3d4"],
    true,
    false,
  )
  assert_true(recheck_cr.diagnostics.length() == 0, "recheck after applying edit must have 0 diagnostics: " + check_result_to_json(recheck_cr.diagnostics))

  // 3. Transitively-only-visible trait must NOT emit broken edits and must suggest importing the trait pkg
  let mid_src =
    #|import "tlib"
    #|pub fn relay[T : tlib::ShowVal](mut x : T, v : tlib::Val) -> tlib::Val { tlib::run_show(mut x, v) }
    #|pub fn mk_val() -> tlib::Val { tlib::Val::{ n: 1 } }
  let mid_cr = check_source_files_with_imports_mapped(
    "mid_a6",
    ["mid.pion"],
    [mid_src],
    [imported_pkg_new("tlib__a1b2c3d4", tlib_cr.tc)],
    ["tlib"],
    ["tlib__a1b2c3d4"],
    true,
    false,
  )
  assert_true(mid_cr.diagnostics.length() == 0, check_result_to_json(mid_cr.diagnostics))
  let trans_app_src =
    #|import "mid"
    #|struct LocalS { x : Int }
    #|fn go(mut s : LocalS) -> Int { mid::relay(mut s, mid::mk_val()).n }
  let trans_cr = check_source_files_with_imports_mapped(
    "trans_app_a6",
    ["main.pion"],
    [trans_app_src],
    [imported_pkg_new("tlib__a1b2c3d4", tlib_cr.tc), imported_pkg_new("mid_a6", mid_cr.tc)],
    ["mid"],
    ["mid_a6"],
    true,
    false,
  )
  let mut saw_not_impl = false
  let mut saw_edit = false
  let mut saw_import_hint = false
  di = 0
  while di < trans_cr.diagnostics.length() {
    if trans_cr.diagnostics[di].code == "E_TRAIT_NOT_IMPLEMENTED" {
      saw_not_impl = true
      if trans_cr.diagnostics[di].edits.length() > 0 {
        saw_edit = true
      }
      if trans_cr.diagnostics[di].fixit.contains("add `tlib` to pion.toml dependencies") &&
        !trans_cr.diagnostics[di].fixit.contains("tlib__a1b2c3d4") {
        saw_import_hint = true
      }
    }
    di = di + 1
  }
  assert_true(saw_not_impl && !saw_edit && saw_import_hint, "transitively-only trait must suggest adding base dep to pion.toml without leaking canon id")

  // 4. Direct manifest dep `vendor` -> `tlib__deadbeef`: caller `a.pion` imports `vendor as tl`,
  //    struct defined in `b.pion` without import -> fixit suggests `import "vendor"` (never `tlib__deadbeef`),
  //    then adding `import "vendor"` to `b.pion` emits a machine edit that checks cleanly when applied!
  let a_src =
    #|import "vendor" as tl
    #|fn go(mut m : MyItem2, v : tl::Val) -> tl::Val { tl::run_show(mut m, v) }
  let b_src =
    #|struct MyItem2 { x : Int }
  let ab_cr = check_source_files_with_imports_mapped(
    "app_a6_vendor",
    ["a.pion", "b.pion"],
    [a_src, b_src],
    [imported_pkg_new("tlib__deadbeef", tlib_cr.tc)],
    ["vendor"],
    ["tlib__deadbeef"],
    true,
    false,
  )
  let mut saw_vendor_hint = false
  let mut saw_vendor_edit = false
  di = 0
  while di < ab_cr.diagnostics.length() {
    let d = ab_cr.diagnostics[di]
    if d.code == "E_TRAIT_NOT_IMPLEMENTED" {
      if d.fixit.contains("import \"vendor\"") && !d.fixit.contains("tlib__deadbeef") {
        saw_vendor_hint = true
      }
      if d.edits.length() > 0 {
        saw_vendor_edit = true
      }
    }
    di = di + 1
  }
  assert_true(saw_vendor_hint && !saw_vendor_edit, "missing file-level import must suggest manifest key `vendor` without canon hash: " + check_result_to_json(ab_cr.diagnostics))
  let b_with_imp = "import \"vendor\"\n" + b_src
  let ab_cr2 = check_source_files_with_imports_mapped(
    "app_a6_vendor",
    ["a.pion", "b.pion"],
    [a_src, b_with_imp],
    [imported_pkg_new("tlib__deadbeef", tlib_cr.tc)],
    ["vendor"],
    ["tlib__deadbeef"],
    true,
    false,
  )
  let mut vendor_edit_rep = ""
  di = 0
  while di < ab_cr2.diagnostics.length() {
    let d = ab_cr2.diagnostics[di]
    if d.code == "E_TRAIT_NOT_IMPLEMENTED" && d.edits.length() > 0 {
      assert_true(d.edits[0].file == "b.pion", "edit target must be b.pion: " + d.edits[0].file)
      vendor_edit_rep = d.edits[0].replacement
    }
    di = di + 1
  }
  assert_true(vendor_edit_rep.contains("impl vendor::ShowVal for MyItem2"), "edit must use vendor::ShowVal: " + vendor_edit_rep)
  let b_fixed = b_with_imp + vendor_edit_rep + "\n"
  let ab_recheck = check_source_files_with_imports_mapped(
    "app_a6_vendor",
    ["a.pion", "b.pion"],
    [a_src, b_fixed],
    [imported_pkg_new("tlib__deadbeef", tlib_cr.tc)],
    ["vendor"],
    ["tlib__deadbeef"],
    true,
    false,
  )
  assert_true(ab_recheck.diagnostics.length() == 0, "recheck after applying vendor edit must have 0 diagnostics: " + check_result_to_json(ab_recheck.diagnostics))
}

///|
test "wave_l1a: A2-5 verify aliasing in right-hand && is-chain & A3-6/A3-7 move order + opt-arg closure" {
  // A2-5 negative: mutating pinned root inside nested `flag && (opt is Some(xs) && { opt = None; ... })`
  let v_bad = check_source_files_full(
    "l1a_a2_vbad",
    ["main.pion"],
    [
      "#verify\n" +
      "fn bad(flag : Bool, mut opt : Option[Array[Int]]) -> Bool {\n" +
      "  let b = flag && (opt is Some(xs) && { opt = None; xs.length() > 0 })\n" +
      "  b\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(v_bad.diagnostics).contains("E_VERIFY_ALIASING"),
    "expected E_VERIFY_ALIASING: " + check_result_to_json(v_bad.diagnostics),
  )

  // A2-5 positive: mutating root after the && expression is allowed
  let v_ok = check_source_files_full(
    "l1a_a2_vok",
    ["main.pion"],
    [
      "#verify\n" +
      "fn good(flag : Bool, mut opt : Option[Array[Int]]) -> Bool {\n" +
      "  let b = flag && (opt is Some(xs) && xs.length() > 0)\n" +
      "  opt = None\n" +
      "  b\n" +
      "}\n",
    ],
  )
  assert_true(v_ok.diagnostics.length() == 0, check_result_to_json(v_ok.diagnostics))

  // A3-6 positive 1: concrete closure param not deferred past later `move v`
  // A3-6 positive 2: generic closure param deferred for T inference preserves source-order `env.moved`
  // A3-7 positive: optional parameter `f? : (T) -> Int` with unannotated closure inferred from later `v : T`
  let a3_ok = check_source_files_full(
    "l1a_a3_move_opt",
    ["main.pion"],
    [
      "fn f[T](g : (Int) -> Int, s : T) -> Int { let _ = s; g(1) }\n" +
      "fn fg[T](g : (T) -> Int, s : T) -> Int { g(s) }\n" +
      "fn apply_opt[T](f? : (T) -> Int, v : T) -> Int {\n" +
      "  match f { Some(cb) => cb(v); None => 0 }\n" +
      "}\n" +
      "fn run() -> Int {\n" +
      "  let v1 = [1, 2, 3]\n" +
      "  let r1 = f(fn(x) { x + v1.length() }, move v1)\n" +
      "  let v2 = [1, 2, 3]\n" +
      "  let r2 = fg(fn(x) { let _ = x; v2.length() }, move v2)\n" +
      "  let r3 = apply_opt(3, f=fn(x) { x + 1 })\n" +
      "  r1 + r2 + r3\n" +
      "}\n",
    ],
  )
  assert_true(a3_ok.diagnostics.length() == 0, check_result_to_json(a3_ok.diagnostics))

  // A3-6 negative: reverse order `move v` BEFORE closure MUST still report E_USE_AFTER_MOVE
  let a3_bad = check_source_files_full(
    "l1a_a3_uam",
    ["main.pion"],
    [
      "fn fr[T](s : T, g : (T) -> Int) -> Int { g(s) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2, 3]\n" +
      "  fr(move v, fn(x) { let _ = x; v.length() })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(a3_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "expected E_USE_AFTER_MOVE: " + check_result_to_json(a3_bad.diagnostics),
  )

  // R2 Opus h1: deferred closure moves `v`, later arg uses `v` -> E_USE_AFTER_MOVE
  let h1_bad = check_source_files_full(
    "l1a_a3_h1",
    ["main.pion"],
    [
      "fn f[T](g : (T) -> Int, x : T, a : Array[Int]) -> Int { g(x) + a.length() }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2, 3]\n" +
      "  f(fn(x) { let u = move v; u.length() + x }, 1, v)\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(h1_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "h1 expected E_USE_AFTER_MOVE: " + check_result_to_json(h1_bad.diagnostics),
  )

  // R2 Opus h4: deferred closure moves `v`, later arg moves `v` again -> E_USE_AFTER_MOVE (already moved)
  let h4_bad = check_source_files_full(
    "l1a_a3_h4",
    ["main.pion"],
    [
      "fn f[T](g : (T) -> Int, x : T, a : Array[Int]) -> Int { g(x) + a.length() }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2, 3]\n" +
      "  f(fn(x) { let u = move v; u.length() + x }, 1, move v)\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(h4_bad.diagnostics).contains("E_USE_AFTER_MOVE") &&
    check_result_to_json(h4_bad.diagnostics).contains("already moved"),
    "h4 expected E_USE_AFTER_MOVE already moved: " + check_result_to_json(h4_bad.diagnostics),
  )

  // R2 Opus h3 + Astra #1 + Astra #2:
  // - h3: deferred closure reads `v`, later arg reads `v` -> OK
  // - Astra #1: named args `take(s=move s, n=s.length(), ...)` -> E_USE_AFTER_MOVE; swapped -> OK
  // - Astra #2: re-init `{ s = "new"; 1 }` clears moved state after deferred closure call -> OK
  let r2_ok = check_source_files_full(
    "l1a_a3_r2_ok",
    ["main.pion"],
    [
      "fn f[T](g : (T) -> Int, x : T, a : Array[Int]) -> Int { g(x) + a.length() }\n" +
      "fn take[T](n~ : Int, s~ : String, v~ : T, f~ : (T) -> Int) -> Int { n + s.length() + f(v) }\n" +
      "fn apply[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2, 3]\n" +
      "  let r1 = f(fn(x) { v.length() + x }, 1, v)\n" +
      "  let s1 = \"abc\"\n" +
      "  let r2 = take(n=s1.length(), s=move s1, v=0, f=fn(i) { i })\n" +
      "  let mut s2 = \"old\"\n" +
      "  let _ = move s2\n" +
      "  let _ = apply(fn(x) { x + 1 }, { s2 = \"new\"; 1 })\n" +
      "  r1 + r2 + s2.length()\n" +
      "}\n",
    ],
  )
  assert_true(r2_ok.diagnostics.length() == 0, check_result_to_json(r2_ok.diagnostics))

  let astra1_bad = check_source_files_full(
    "l1a_a3_astra1",
    ["main.pion"],
    [
      "fn take[T](n~ : Int, s~ : String, v~ : T, f~ : (T) -> Int) -> Int { n + s.length() + f(v) }\n" +
      "fn run() -> Int {\n" +
      "  let s = \"abc\"\n" +
      "  take(s=move s, n=s.length(), v=0, f=fn(i) { i })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(astra1_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra #1 expected E_USE_AFTER_MOVE: " + check_result_to_json(astra1_bad.diagnostics),
  )

  // Final Astra #1: inner lexical shadow (`let v = [9]` in closure/block or closure param `fn(v)`)
  // must NEVER erase outer moved state of `v`, and moving an inner shadow must NEVER mark outer `v` moved.
  let shadow_cl_bad = check_source_files_full(
    "l1a_a3_shadow_cl",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  let _ = move v\n" +
      "  let _ = keep(fn(x) { let v = [9]; let _ = v; x }, 1)\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(shadow_cl_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra #1 closure shadow must preserve outer moved v: " + check_result_to_json(shadow_cl_bad.diagnostics),
  )

  let shadow_blk_bad = check_source_files_full(
    "l1a_a3_shadow_blk",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  let _ = move v\n" +
      "  { let v = [9]; let _ = v }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(shadow_blk_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra #1 block shadow must preserve outer moved v: " + check_result_to_json(shadow_blk_bad.diagnostics),
  )

  let shadow_param_bad = check_source_files_full(
    "l1a_a3_shadow_param",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  let _ = move v\n" +
      "  let _ = keep(fn(v) { v.length() }, [9])\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(shadow_param_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra #1 closure param shadow must preserve outer moved v: " + check_result_to_json(shadow_param_bad.diagnostics),
  )

  // Final Astra #1 positive + #2 (deferred closure moves `s`, later arg re-inits `s = "new"`)
  // + #3 (package fn `count()` called while local `let count = [1]` is moved)
  let final_ok = check_source_files_full(
    "l1a_a3_final_ok",
    ["main.pion"],
    [
      "fn count() -> Int { 7 }\n" +
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  { let v = [9]; let _ = move v }\n" +
      "  let r0 = v.length()\n" +
      "  let mut s = \"old\"\n" +
      "  let r1 = keep(fn(x) { let _ = move s; x }, { s = \"new\"; 1 })\n" +
      "  let r2 = s.length()\n" +
      "  let count = [1]\n" +
      "  let r3 = keep(fn(x) { let _ = move count; x }, count())\n" +
      "  r0 + r1 + r2 + r3\n" +
      "}\n",
    ],
  )
  assert_true(final_ok.diagnostics.length() == 0, check_result_to_json(final_ok.diagnostics))

  // Final Astra #3 negative: calling a truly moved local closure variable MUST still report E_USE_AFTER_MOVE
  let moved_cl_bad = check_source_files_full(
    "l1a_a3_moved_cl",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let f_cl = fn() -> Int { 7 }\n" +
      "  keep(fn(x) { let _ = move f_cl; x }, f_cl())\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(moved_cl_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra #3 calling moved local closure must report E_USE_AFTER_MOVE: " + check_result_to_json(moved_cl_bad.diagnostics),
  )

  // Astra R4 #1: uncalled closure reassigning outer moved var must NOT clear outer moved state (both deferred and non-deferred)
  let cl_reinit_def_bad = check_source_files_full(
    "l1a_r4_cl_reinit_def",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { let _ = f; let _ = x; 0 }\n" +
      "fn run() -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  let _ = keep(fn(x) { s = \"new\"; x }, 1)\n" +
      "  s.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(cl_reinit_def_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #1 deferred closure must not clear outer moved s: " + check_result_to_json(cl_reinit_def_bad.diagnostics),
  )
  let cl_reinit_norm_bad = check_source_files_full(
    "l1a_r4_cl_reinit_norm",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  let _ = fn(x : Int) -> Int { s = \"new\"; x }\n" +
      "  s.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(cl_reinit_norm_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #1 normal closure must not clear outer moved s: " + check_result_to_json(cl_reinit_norm_bad.diagnostics),
  )

  // Astra R4 #2: SAssign index/field eval order (lhs before rhs)
  let idx_bad = check_source_files_full(
    "l1a_r4_idx_bad",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let a = [0, 1]\n" +
      "  let s = \"hi\"\n" +
      "  keep(fn(x) { x }, { a[{ let _ = move s; 0 }] = s.length(); 1 })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(idx_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #2 index move before rhs must report E_USE_AFTER_MOVE: " + check_result_to_json(idx_bad.diagnostics),
  )
  let idx_field_ok = check_source_files_full(
    "l1a_r4_idx_ok",
    ["main.pion"],
    [
      "struct Box { mut n : Int }\n" +
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let a = [0, 1]\n" +
      "  let s1 = \"hi\"\n" +
      "  let r1 = keep(fn(x) { x }, { a[s1.length() - 2] = { let _ = move s1; 1 }; 1 })\n" +
      "  let b = Box::{ n: 0 }\n" +
      "  let r2 = keep(fn(x) { x }, { b.n = { let _ = move b; 2 }; 1 })\n" +
      "  r1 + r2\n" +
      "}\n",
    ],
  )
  assert_true(idx_field_ok.diagnostics.length() == 0, check_result_to_json(idx_field_ok.diagnostics))

  // Astra R4 #3: && RHS moving pattern-bound `v` persists into then-branch & guard continuation
  let and_move_bad = check_source_files_full(
    "l1a_r4_and_move",
    ["main.pion"],
    [
      "fn consume(v : Array[Int]) -> Bool { v.length() > 0 }\n" +
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run(p : Option[Array[Int]]) -> Int {\n" +
      "  keep(fn(x) { x }, if p is Some(v) && consume(move v) { v.length() } else { 0 })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(and_move_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #3 move of is-bound v in && RHS must persist into then: " + check_result_to_json(and_move_bad.diagnostics),
  )

  // Astra R4 #4: match guard failure edge & loop back-edge
  let guard_fail_bad = check_source_files_full(
    "l1a_r4_guard_fail",
    ["main.pion"],
    [
      "fn reject(v : Array[Int]) -> Bool { let _ = v; false }\n" +
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  keep(fn(x) { x }, match 0 { _ if reject(move v) => 0; _ => v.length() })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(guard_fail_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #4 match guard move must propagate to next arm: " + check_result_to_json(guard_fail_bad.diagnostics),
  )
  let loop_bad = check_source_files_full(
    "l1a_r4_loop_bad",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move v }; 1 })\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(loop_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "Astra R4 #4 loop back-edge move must report E_USE_AFTER_MOVE: " + check_result_to_json(loop_bad.diagnostics),
  )
  let loop_ok = check_source_files_full(
    "l1a_r4_loop_ok",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let mut s = \"a\"\n" +
      "  keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move s; s = \"next\" }; s.length() })\n" +
      "}\n",
    ],
  )
  assert_true(loop_ok.diagnostics.length() == 0, check_result_to_json(loop_ok.diagnostics))

  // Unified post-typecheck MoveState regressions (Astra R5 #1–#4):
  // 1. `for i in 0..<2 { let _ = move v; break }` -> 0 diagnostics (top-level, annotated, deferred),
  //    but reading `v` after the loop -> E_USE_AFTER_MOVE.
  let break_ok = check_source_files_full(
    "l1a_r5_break_ok",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run() -> Int {\n" +
      "  let v1 = [1, 2]\n" +
      "  for i in 0..<2 { let _ = i; let _ = move v1; break }\n" +
      "  let v2 = [1, 2]\n" +
      "  let _ = keep(fn(x : Int) -> Int { x }, { for i in 0..<2 { let _ = i; let _ = move v2; break }; 1 })\n" +
      "  let v3 = [1, 2]\n" +
      "  let _ = keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move v3; break }; 1 })\n" +
      "  0\n" +
      "}\n",
    ],
  )
  assert_true(break_ok.diagnostics.length() == 0, check_result_to_json(break_ok.diagnostics))

  let break_after_bad = check_source_files_full(
    "l1a_r5_break_after",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  for i in 0..<2 { let _ = i; let _ = move v; break }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(break_after_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "reading v after break-move must report E_USE_AFTER_MOVE: " + check_result_to_json(break_after_bad.diagnostics),
  )

  // 2. `continue` before re-init MUST report E_USE_AFTER_MOVE on both annotated and deferred calls
  let cont_ann_bad = check_source_files_full(
    "l1a_r5_cont_ann",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run(skip : Bool) -> Int {\n" +
      "  let mut s = \"a\"\n" +
      "  keep(fn(x : Int) -> Int { x }, { for i in 0..<2 { let _ = i; let _ = move s; if skip { continue }; s = \"next\" }; 1 })\n" +
      "}\n",
    ],
  )
  let cont_def_bad = check_source_files_full(
    "l1a_r5_cont_def",
    ["main.pion"],
    [
      "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\n" +
      "fn run(skip : Bool) -> Int {\n" +
      "  let mut s = \"a\"\n" +
      "  keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move s; if skip { continue }; s = \"next\" }; 1 })\n" +
      "}\n",
    ],
  )
  assert_true(check_result_to_json(cont_ann_bad.diagnostics).contains("E_USE_AFTER_MOVE"), check_result_to_json(cont_ann_bad.diagnostics))
  assert_true(check_result_to_json(cont_def_bad.diagnostics).contains("E_USE_AFTER_MOVE"), check_result_to_json(cont_def_bad.diagnostics))

  // 3. Early return in `if` branch does not leak move into continuation
  let ret_if_ok = check_source_files_full(
    "l1a_r5_ret_if",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  if flag { let _ = move v; return 0 }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(ret_if_ok.diagnostics.length() == 0, check_result_to_json(ret_if_ok.diagnostics))

  // 4. Value-position 3-term && chain reports E_USE_AFTER_MOVE (both annotated and deferred)
  let and3_ann_bad = check_source_files_full(
    "l1a_r5_and3_ann",
    ["main.pion"],
    [
      "fn consume(v : Array[Int]) -> Bool { v.length() > 0 }\n" +
      "fn keep[T](f : (T) -> Bool, x : T) -> Bool { f(x) }\n" +
      "fn run(p : Option[Array[Int]]) -> Bool {\n" +
      "  keep(fn(x : Bool) -> Bool { x }, (p is Some(v) && consume(move v)) && v.length() > 0)\n" +
      "}\n",
    ],
  )
  let and3_def_bad = check_source_files_full(
    "l1a_r5_and3_def",
    ["main.pion"],
    [
      "fn consume(v : Array[Int]) -> Bool { v.length() > 0 }\n" +
      "fn keep[T](f : (T) -> Bool, x : T) -> Bool { f(x) }\n" +
      "fn run(p : Option[Array[Int]]) -> Bool {\n" +
      "  keep(fn(x) { x }, (p is Some(v) && consume(move v)) && v.length() > 0)\n" +
      "}\n",
    ],
  )
  assert_true(check_result_to_json(and3_ann_bad.diagnostics).contains("E_USE_AFTER_MOVE"), check_result_to_json(and3_ann_bad.diagnostics))
  assert_true(check_result_to_json(and3_def_bad.diagnostics).contains("E_USE_AFTER_MOVE"), check_result_to_json(and3_def_bad.diagnostics))

  // 5. Irrefutable match guard re-init clears moved state for subsequent arm; refutable guard does not
  let irref_guard_ok = check_source_files_full(
    "l1a_r5_irref_ok",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  match 0 {\n" +
      "    _ if { s = \"new\"; flag } => 0\n" +
      "    _ => s.length()\n" +
      "  }\n" +
      "}\n",
    ],
  )
  assert_true(irref_guard_ok.diagnostics.length() == 0, check_result_to_json(irref_guard_ok.diagnostics))

  let refut_guard_bad = check_source_files_full(
    "l1a_r5_refut_bad",
    ["main.pion"],
    [
      "fn run(x : Int, flag : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  match x {\n" +
      "    0 if { s = \"new\"; flag } => 0\n" +
      "    _ => s.length()\n" +
      "  }\n" +
      "}\n",
    ],
  )
  assert_true(check_result_to_json(refut_guard_bad.diagnostics).contains("E_USE_AFTER_MOVE"), check_result_to_json(refut_guard_bad.diagnostics))

  // 6. Parity between annotated and deferred closures on both fn call & inherent method call
  let parity_cases : Array[String] = [
    "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\nfn run() -> Int { let v = [1]; keep(fn(x : Int) -> Int { x }, { for i in 0..<2 { let _ = i; let _ = move v }; 1 }) }\n",
    "fn keep[T](f : (T) -> Int, x : T) -> Int { f(x) }\nfn run() -> Int { let v = [1]; keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move v }; 1 }) }\n",
    "struct K { n : Int }\nfn K::keep[T](self : K, f : (T) -> Int, x : T) -> Int { self.n + f(x) }\nfn run() -> Int { let k = K::{ n: 0 }; let v = [1]; k.keep(fn(x : Int) -> Int { x }, { for i in 0..<2 { let _ = i; let _ = move v }; 1 }) }\n",
    "struct K { n : Int }\nfn K::keep[T](self : K, f : (T) -> Int, x : T) -> Int { self.n + f(x) }\nfn run() -> Int { let k = K::{ n: 0 }; let v = [1]; k.keep(fn(x) { x }, { for i in 0..<2 { let _ = i; let _ = move v }; 1 }) }\n",
  ]
  let mut pci = 0
  while pci < parity_cases.length() {
    let pcr = check_source_files_full("l1a_r5_parity_" + pci.to_string(), ["main.pion"], [parity_cases[pci]])
    assert_true(
      check_result_to_json(pcr.diagnostics).contains("E_USE_AFTER_MOVE"),
      "parity case " + pci.to_string() + ": " + check_result_to_json(pcr.diagnostics),
    )
    pci = pci + 1
  }

  // Astra R6 #1: package-level `fn panic() -> Unit { () }` shadows builtin panic -> must NOT diverge;
  // builtin `panic("x")` still diverges via `tc.never_calls`.
  let shadow_panic_bad = check_source_files_full(
    "l1a_r6_shadow_panic_bad",
    ["main.pion"],
    [
      "fn panic() -> Unit { () }\n" +
      "fn run() -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  let _ = move v\n" +
      "  panic()\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(shadow_panic_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "shadowed panic must not diverge: " + check_result_to_json(shadow_panic_bad.diagnostics),
  )
  let builtin_panic_ok = check_source_files_full(
    "l1a_r6_builtin_panic_ok",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  if flag { let _ = move v; panic(\"x\") }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(builtin_panic_ok.diagnostics.length() == 0, check_result_to_json(builtin_panic_ok.diagnostics))

  // Astra R6 #2: `debug_assert` must not clear moved state (erased in --release),
  // while re-init after `debug_assert` succeeds.
  let da_reinit_bad = check_source_files_full(
    "l1a_r6_da_bad",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  debug_assert({ s = \"new\"; true }, \"ok\")\n" +
      "  s.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(da_reinit_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "re-init inside debug_assert must not clear moved state: " + check_result_to_json(da_reinit_bad.diagnostics),
  )
  let da_reinit_ok = check_source_files_full(
    "l1a_r6_da_ok",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  debug_assert(true, \"ok\")\n" +
      "  s = \"new\"\n" +
      "  s.length()\n" +
      "}\n",
    ],
  )
  assert_true(da_reinit_ok.diagnostics.length() == 0, check_result_to_json(da_reinit_ok.diagnostics))

  // Astra R6 #3: closure early-return moving outer captured variable must propagate out,
  // while moving a same-named closure-local variable with early return stays 0 diagnostics.
  let cl_ret_outer_bad = check_source_files_full(
    "l1a_r6_cl_ret_bad",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  let f = fn() -> Int { if flag { let _ = move v; return 0 }; 1 }\n" +
      "  let _ = f()\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(cl_ret_outer_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "closure early-return move of outer v must report E_USE_AFTER_MOVE: " + check_result_to_json(cl_ret_outer_bad.diagnostics),
  )
  let cl_ret_local_ok = check_source_files_full(
    "l1a_r6_cl_ret_local_ok",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  let f = fn() -> Int { let v = [3, 4]; if flag { let _ = move v; return 0 }; v.length() }\n" +
      "  let _ = f()\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(cl_ret_local_ok.diagnostics.length() == 0, check_result_to_json(cl_ret_local_ok.diagnostics))

  // Astra R6 #4: `||` condition exact true/false edges
  let or_else_ok = check_source_files_full(
    "l1a_r6_or_else_ok",
    ["main.pion"],
    [
      "fn run(a : Bool, b : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  if a || { s = \"new\"; b } { 0 } else { s.length() }\n" +
      "}\n",
    ],
  )
  assert_true(or_else_ok.diagnostics.length() == 0, check_result_to_json(or_else_ok.diagnostics))
  let or_then_bad = check_source_files_full(
    "l1a_r6_or_then_bad",
    ["main.pion"],
    [
      "fn run(a : Bool, b : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  if a || { s = \"new\"; b } { s.length() } else { 0 }\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(or_then_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "s.length() in then branch of `a || { s = ...; b }` must report E_USE_AFTER_MOVE: " + check_result_to_json(or_then_bad.diagnostics),
  )

  // Astra R6 #5: `while true {}` without break diverges; `while true { break }` does not
  let while_true_div_ok = check_source_files_full(
    "l1a_r6_while_true_ok",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  if flag { let _ = move v; while true {} }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(while_true_div_ok.diagnostics.length() == 0, check_result_to_json(while_true_div_ok.diagnostics))
  let while_true_break_bad = check_source_files_full(
    "l1a_r6_while_true_break_bad",
    ["main.pion"],
    [
      "fn run(flag : Bool) -> Int {\n" +
      "  let v = [1, 2]\n" +
      "  if flag { let _ = move v; while true { break } }\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(while_true_break_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "while true { break } must not diverge: " + check_result_to_json(while_true_break_bad.diagnostics),
  )

  // Astra R7 #1: `tc_check_moves_in_cond` unwinds `false_depth` across nested `||` and match arm shadowing
  let match_or_shadow_bad = check_source_files_full(
    "l1a_r7_match_or_shadow_bad",
    ["main.pion"],
    [
      "fn run(a : Bool, b : Bool) -> Int {\n" +
      "  let v = [1]\n" +
      "  let _ = move v\n" +
      "  match 0 {\n" +
      "    v if a || b => v\n" +
      "    _ => v.length()\n" +
      "  }\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(match_or_shadow_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "match arm `v if a || b` must restore outer moved `v` for next arm: " + check_result_to_json(match_or_shadow_bad.diagnostics),
  )
  let match_or_shadow_ok = check_source_files_full(
    "l1a_r7_match_or_shadow_ok",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  let _ = move v\n" +
      "  match 0 {\n" +
      "    v if (v == 0) || (v == 1) => v\n" +
      "    _ => 0\n" +
      "  }\n" +
      "}\n",
    ],
  )
  assert_true(match_or_shadow_ok.diagnostics.length() == 0, check_result_to_json(match_or_shadow_ok.diagnostics))

  // Astra R7 #2: diverging `debug_assert` keeps only erased path `pre_da`; non-diverging move propagates
  let da_div_ok = check_source_files_full(
    "l1a_r7_da_div_ok",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  debug_assert({ let _ = move v; return 0 }, \"ok\")\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(da_div_ok.diagnostics.length() == 0, check_result_to_json(da_div_ok.diagnostics))
  let da_move_bad = check_source_files_full(
    "l1a_r7_da_move_bad",
    ["main.pion"],
    [
      "fn run() -> Int {\n" +
      "  let v = [1]\n" +
      "  debug_assert({ let _ = move v; true }, \"ok\")\n" +
      "  v.length()\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(da_move_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "non-diverging move in debug_assert must propagate: " + check_result_to_json(da_move_bad.diagnostics),
  )

  // Astra R7 #3: `EUnary("!", inner)` swaps true/false condition exits
  let not_or_then_ok = check_source_files_full(
    "l1a_r7_not_or_then_ok",
    ["main.pion"],
    [
      "fn run(a : Bool, b : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  if !(a || { s = \"new\"; b }) { s.length() } else { 0 }\n" +
      "}\n",
    ],
  )
  assert_true(not_or_then_ok.diagnostics.length() == 0, check_result_to_json(not_or_then_ok.diagnostics))
  let not_or_else_bad = check_source_files_full(
    "l1a_r7_not_or_else_bad",
    ["main.pion"],
    [
      "fn run(a : Bool, b : Bool) -> Int {\n" +
      "  let mut s = \"old\"\n" +
      "  let _ = move s\n" +
      "  if !(a || { s = \"new\"; b }) { 0 } else { s.length() }\n" +
      "}\n",
    ],
  )
  assert_true(
    check_result_to_json(not_or_else_bad.diagnostics).contains("E_USE_AFTER_MOVE"),
    "else branch of `!(a || { s = ...; b })` must report E_USE_AFTER_MOVE: " + check_result_to_json(not_or_else_bad.diagnostics),
  )
}

///|
test "wave_l1b: physical_equal typing, arity, named-arg rejection, shadowing, and #verify rejection" {
  let ok_src =
    #|struct Box { x : Int }
    #|fn f(a : Box, b : Box, d : Double) -> Bool {
    #|  let _ = physical_equal(a, b)
    #|  let _ = physical_equal(d, d)
    #|  physical_equal((), ())
    #|}
    #|fn shadow() -> Int {
    #|  let physical_equal = fn(x : Int) -> Int { x + 1 }
    #|  physical_equal(41)
    #|}
  let ok_cr = check_source_files("t_pe_ok", ["t.pion"], [ok_src])
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  let bad_arity = check_source_files("t_pe_a", ["t.pion"], ["fn f(x : Int) -> Bool { physical_equal(x) }"])
  assert_true(bad_arity.diagnostics.length() > 0 && bad_arity.diagnostics[0].code == "E_ARITY_MISMATCH", check_result_to_json(bad_arity.diagnostics))

  let bad_named = check_source_files("t_pe_n", ["t.pion"], ["fn f(x : Int) -> Bool { physical_equal(a=x, x) }"])
  assert_true(bad_named.diagnostics.length() > 0 && bad_named.diagnostics[0].code == "E_TYPE_MISMATCH", check_result_to_json(bad_named.diagnostics))

  let bad_mismatch = check_source_files("t_pe_m", ["t.pion"], ["fn f(x : Int, s : String) -> Bool { physical_equal(x, s) }"])
  assert_true(bad_mismatch.diagnostics.length() > 0 && bad_mismatch.diagnostics[0].code == "E_TYPE_MISMATCH", check_result_to_json(bad_mismatch.diagnostics))

  let bad_verify = check_source_files("t_pe_v", ["t.pion"], ["#verify\nfn f(a : Int, b : Int) -> Bool { physical_equal(a, b) }"])
  assert_true(bad_verify.diagnostics.length() > 0 && bad_verify.diagnostics[0].code == "E_VERIFY_UNSUPPORTED", check_result_to_json(bad_verify.diagnostics))
}

test "wave_l1b: Double/Float is_nan/is_inf/is_finite typing and #verify boundary" {
  let ok_src =
    #|fn f(d : Double, x : Float) -> Bool {
    #|  d.is_nan() || d.is_inf() || d.is_finite() || x.is_nan() || x.is_inf() || x.is_finite()
    #|}
    #|#verify
    #|fn vf(d : Double) -> Bool {
    #|  d.is_nan() || d.is_inf() || d.is_finite()
    #|}
  let ok_cr = check_source_files("t_flt_ok", ["t.pion"], [ok_src])
  assert_true(ok_cr.diagnostics.length() == 0, check_result_to_json(ok_cr.diagnostics))

  let bad_vflt = check_source_files("t_vflt", ["t.pion"], ["#verify\nfn vf(x : Float) -> Bool { x.is_finite() }"])
  assert_true(bad_vflt.diagnostics.length() > 0 && bad_vflt.diagnostics[0].code == "E_VERIFY_UNSUPPORTED", check_result_to_json(bad_vflt.diagnostics))
}

test "wave_l1b: @builtin:Eq bound, anti-hijacking, structural == and mutable cycle rejection" {
  // 1. Built-in Eq bound checked even when body does not use ==
  let beq_ok = check_source_files(
    "t_beq",
    ["t.pion"],
    [
      #|#derive(Eq)
      #|struct Pt { x : Int, y : Int }
      #|fn req_eq[T : Eq](x : T) -> Int { 1 }
      #|fn f() -> Int {
      #|  let a = req_eq(1)
      #|  let b = req_eq(Some(Pt::{ x: 1, y: 2 }))
      #|  let c = req_eq([1, 2])
      #|  let d = req_eq((1, "hi"))
      #|  a + b + c + d
      #|}
    ],
  )
  assert_true(beq_ok.diagnostics.length() == 0, check_result_to_json(beq_ok.diagnostics))

  // Non-Eq struct rejected even when body has no ==, and diagnostic does not leak @builtin:
  let beq_bad = check_source_files(
    "t_beq_bad",
    ["t.pion"],
    [
      #|struct NoEq { x : Int }
      #|fn req_eq[T : Eq](x : T) -> Int { 1 }
      #|fn f() -> Int { req_eq(NoEq::{ x: 1 }) }
    ],
  )
  let beq_json = check_result_to_json(beq_bad.diagnostics)
  assert_true(beq_bad.diagnostics.length() > 0 && beq_bad.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED", beq_json)
  assert_true(!beq_json.contains("@builtin:") && !beq_json.contains("@canon:"), beq_json)

  // 2. Path-level mutable cycle rejection vs immutable cycle & diamond DAG
  let ok_graph = check_source_files(
    "t_eq_ok_g",
    ["t.pion"],
    [
      #|#derive(Eq)
      #|enum List[T] { Nil; Cons(T, List[T]) }
      #|#derive(Eq)
      #|struct Leaf { xs : Array[Int] }
      #|#derive(Eq)
      #|struct Diamond { a : Leaf, b : Leaf }
      #|fn f(al : Array[List[Int]], d : Diamond) -> Bool {
      #|  al == al && d == d
      #|}
    ],
  )
  assert_true(ok_graph.diagnostics.length() == 0, check_result_to_json(ok_graph.diagnostics))

  let bad_arr_cyc = check_source_files(
    "t_eq_bad_ac",
    ["t.pion"],
    [
      #|#derive(Eq)
      #|struct Node { children : Array[Node] }
    ],
  )
  assert_true(bad_arr_cyc.diagnostics.length() > 0, check_result_to_json(bad_arr_cyc.diagnostics))

  let bad_mut_cyc = check_source_files(
    "t_eq_bad_mc",
    ["t.pion"],
    [
      #|#derive(Eq)
      #|struct MNode { mut next : Option[MNode] }
    ],
  )
  assert_true(bad_mut_cyc.diagnostics.length() > 0, check_result_to_json(bad_mut_cyc.diagnostics))

  // 3. Cross-package anti-hijacking: dep uses built-in Eq, app defines custom trait Eq
  let dep_cr = check_source_files_with_imports(
    "dep_beq",
    ["dep.pion"],
    ["pub fn check_eq[T : Eq](a : T, b : T) -> Bool { a == b }\npub fn bound_only[T : Eq](_a : T) -> Int { 7 }"],
    [],
    true,
  )
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))
  let app_cr = check_source_files_with_imports(
    "app_ceq",
    ["app.pion"],
    [
      #|import "dep_beq"
      #|trait Eq { fn custom_eq(self : Self, other : Self) -> Bool }
      #|pub fn f() -> Bool { dep_beq::check_eq(1, 1) && dep_beq::bound_only(2) == 7 }
    ],
    [imported_pkg_new("dep_beq", dep_cr.tc)],
    true,
  )
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))

  // 4. Under-specified LHS (`None`, `Option::None`, `[]`, `Ok(1)`, `(None, 1)`) against non-Eq RHS and FixedArray symmetry
  let bad_lhs_cases : Array[String] = [
    "struct NoEq { x : Int }\nfn f() -> Bool { None == Some(NoEq::{ x: 1 }) }",
    "struct NoEq { x : Int }\nfn f() -> Bool { Option::None == Some(NoEq::{ x: 1 }) }",
    "struct NoEq { x : Int }\nfn f() -> Bool { [] == [NoEq::{ x: 1 }] }",
    "struct NoEq { x : Int }\nfn f() -> Bool { let r : Result[Int, NoEq] = Err(NoEq::{ x: 1 })\n Ok(1) == r }",
    "struct NoEq { x : Int }\nfn f(n : Option[NoEq]) -> Bool { (None, 1) == (n, 1) }",
  ]
  let mut li = 0
  while li < bad_lhs_cases.length() {
    let (ok_l, json_l, _) = check_one(bad_lhs_cases[li])
    assert_true(!ok_l && json_l.contains("\"code\":\"E_TYPE_MISMATCH\""), "bad_lhs[" + li.to_string() + "]: " + json_l)
    li = li + 1
  }
  let (ok_fa_sym, json_fa_sym, _) = check_one(
    "fn f(xs : FixedArray[Int], n : Option[Int]) -> Bool { [] == xs && xs == [] && Option::None == n && (None, 1) == (n, 1) && physical_equal([], xs) && physical_equal(Option::None, n) }",
  )
  assert_true(ok_fa_sym, "FixedArray/Option::None/tuple LHS symmetry: " + json_fa_sym)

  // 5. #verify physical_equal non-callable param cannot bypass ban; callable param is allowed
  let (ok_vbad, json_vbad, _) = check_one(
    "#verify\nfn f(physical_equal : Int) -> Bool { physical_equal(1, 1) }",
  )
  assert_true(!ok_vbad && json_vbad.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "verify non-callable physical_equal param: " + json_vbad)
  let (ok_vgood, json_vgood, _) = check_one(
    "#verify\nfn g(physical_equal : (Int, Int) -> Bool) -> Bool { physical_equal(1, 1) }",
  )
  assert_true(ok_vgood, "verify callable physical_equal param: " + json_vgood)

  // 6. Compound argument forwarding to explicit `@builtin:Eq` bound propagates Eq obligation
  let (ok_wrap_bad, json_wrap_bad, _) = check_one(
    "struct NoEq { v : Int }\nfn req[T : Eq](_x : T) -> Int { 1 }\nfn wrap[U](xs : Array[U]) -> Int { req(xs) }\nfn main_f() -> Int { wrap([NoEq::{ v: 1 }]) }",
  )
  assert_true(
    !ok_wrap_bad &&
    (json_wrap_bad.contains("\"code\":\"E_TYPE_MISMATCH\"") || json_wrap_bad.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\"")),
    "wrap([NoEq]) must fail: " + json_wrap_bad,
  )
  let (ok_wrap_good, json_wrap_good, _) = check_one(
    "fn req[T : Eq](_x : T) -> Int { 1 }\nfn wrap[U](xs : Array[U]) -> Int { req(xs) }\nfn main_f() -> Int { wrap([1, 2]) }",
  )
  assert_true(ok_wrap_good, "wrap([1, 2]) must pass: " + json_wrap_good)

  // 7. Cross-package private nested struct fields keep their defining package qualification
  let dep_priv_ok = check_source_files_with_imports(
    "dep_priv_ok",
    ["dep.pion"],
    [
      #|#derive(Eq)
      #|struct Leaf { x : Int }
      #|#derive(Eq)
      #|struct Middle { l : Leaf }
      #|#derive(Eq)
      #|pub struct Outer { m : Middle }
      #|pub fn mk_outer(x : Int) -> Outer { Outer::{ m: Middle::{ l: Leaf::{ x: x } } } }
    ],
    [],
    true,
  )
  assert_true(dep_priv_ok.diagnostics.length() == 0, check_result_to_json(dep_priv_ok.diagnostics))
  let app_priv_ok = check_source_files_with_imports(
    "app_priv_ok",
    ["app.pion"],
    [
      #|import "dep_priv_ok"
      #|struct Leaf { x : Int }
      #|pub fn f() -> Bool { dep_priv_ok::mk_outer(1) == dep_priv_ok::mk_outer(1) }
    ],
    [imported_pkg_new("dep_priv_ok", dep_priv_ok.tc)],
    true,
  )
  assert_true(app_priv_ok.diagnostics.length() == 0, "app non-Eq Leaf must not shadow dep Eq Leaf: " + check_result_to_json(app_priv_ok.diagnostics))

  let dep_priv_bad = check_source_files_with_imports(
    "dep_priv_bad",
    ["dep.pion"],
    [
      #|struct Leaf { x : Int }
      #|struct Middle { l : Leaf }
      #|#derive(Eq)
      #|pub struct Outer { m : Middle }
      #|pub fn mk_outer(x : Int) -> Outer { Outer::{ m: Middle::{ l: Leaf::{ x: x } } } }
    ],
    [],
    true,
  )
  let app_priv_bad = check_source_files_with_imports(
    "app_priv_bad",
    ["app.pion"],
    [
      #|import "dep_priv_bad"
      #|#derive(Eq)
      #|struct Leaf { x : Int }
      #|#derive(Eq)
      #|struct Middle { l : Leaf }
      #|pub fn f() -> Bool { dep_priv_bad::mk_outer(1) == dep_priv_bad::mk_outer(1) }
    ],
    [imported_pkg_new("dep_priv_bad", dep_priv_bad.tc)],
    true,
  )
  assert_true(app_priv_bad.diagnostics.length() > 0, "app Eq Leaf must not make dep non-Eq Outer comparable")

  // 8. 25-layer diamond DAG (no exponential blowup) and 70-layer acyclic chain (>64 depth)
  let dag_sb = StringBuilder()
  dag_sb.write_string("#derive(Eq)\nstruct D24 { v : Int }\n")
  let mut di = 23
  while di >= 0 {
    let nxt = "D" + (di + 1).to_string()
    dag_sb.write_string("#derive(Eq)\nstruct D" + di.to_string() + " { a : " + nxt + ", b : " + nxt + " }\n")
    di = di - 1
  }
  dag_sb.write_string("fn req_dag[T : Eq](_x : T) -> Int { 1 }\n")
  dag_sb.write_string("fn cmp_dag(x : D0, y : D0) -> Bool { let _ = req_dag(x)\n x == y }\n")
  let (ok_dag, json_dag, _) = check_one(dag_sb.to_string())
  assert_true(ok_dag, "25-layer diamond DAG (== and Eq bound): " + json_dag)

  let chain_sb = StringBuilder()
  chain_sb.write_string("#derive(Eq)\nstruct C70 { v : Int }\n")
  let mut ci = 69
  while ci >= 0 {
    chain_sb.write_string("#derive(Eq)\nstruct C" + ci.to_string() + " { next : C" + (ci + 1).to_string() + " }\n")
    ci = ci - 1
  }
  chain_sb.write_string("fn cmp_chain(x : C0, y : C0) -> Bool { x == y }\n")
  let (ok_chain, json_chain, _) = check_one(chain_sb.to_string())
  assert_true(ok_chain, "70-layer acyclic chain: " + json_chain)

  // 9. 34-layer generic wrapper W0[U]..W33[U] through collect_eq_tparams_in_ty (no 32-level cutoff)
  let w34_sb = StringBuilder()
  w34_sb.write_string("struct NoEq { v : Int }\n")
  w34_sb.write_string("#derive(Eq)\nstruct W33[U] { u : U }\n")
  let mut wi = 32
  while wi >= 0 {
    w34_sb.write_string("#derive(Eq)\nstruct W" + wi.to_string() + "[U] { next : W" + (wi + 1).to_string() + "[U] }\n")
    wi = wi - 1
  }
  w34_sb.write_string("fn req34[T : Eq](_x : T) -> Int { 1 }\n")
  w34_sb.write_string("fn wrap34[U](x : W0[U]) -> Int { req34(x) }\n")
  let w34_base = w34_sb.to_string()
  let (ok_w34_bad, json_w34_bad, _) = check_one(w34_base + "fn f_bad(x : W0[NoEq]) -> Int { wrap34(x) }\n")
  assert_true(!ok_w34_bad, "34-layer wrap34(W0[NoEq]) must fail: " + json_w34_bad)
  let (ok_w34_good, json_w34_good, _) = check_one(w34_base + "fn f_good(x : W0[Int], y : W0[Int]) -> Bool { let _ = wrap34(x)\n x == y }\n")
  assert_true(ok_w34_good, "34-layer wrap34(W0[Int]) and == must pass: " + json_w34_good)

  // 10. Move-checking order when LHS needs RHS type hint (`physical_equal` and `==`)
  let mv_bad_lr_pe = "fn f(s : String, n : Option[Int]) -> Bool { physical_equal({ let _ = move s\n None }, { let _ = s.length()\n n }) }"
  let (ok_m1, j_m1, _) = check_one(mv_bad_lr_pe)
  assert_true(!ok_m1 && j_m1.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_bad_lr_pe: " + j_m1)
  let mv_bad_lr_eq = "fn f(s : String, n : Option[Int]) -> Bool { ({ let _ = move s\n None }) == ({ let _ = s.length()\n n }) }"
  let (ok_m2, j_m2, _) = check_one(mv_bad_lr_eq)
  assert_true(!ok_m2 && j_m2.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_bad_lr_eq: " + j_m2)

  let mv_ok_rl_pe = "fn f(s : String, n : Option[Int]) -> Bool { physical_equal({ let _ = s.length()\n None }, { let _ = move s\n n }) }"
  let (ok_m3, j_m3, _) = check_one(mv_ok_rl_pe)
  assert_true(ok_m3, "mv_ok_rl_pe: " + j_m3)
  let mv_ok_rl_pe_after = "fn f(s : String, n : Option[Int]) -> Int { let _ = physical_equal({ let _ = s.length()\n None }, { let _ = move s\n n })\n s.length() }"
  let (ok_m3b, j_m3b, _) = check_one(mv_ok_rl_pe_after)
  assert_true(!ok_m3b && j_m3b.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_ok_rl_pe_after: " + j_m3b)
  let mv_ok_rl_eq = "fn f(s : String, n : Option[Int]) -> Bool { ({ let _ = s.length()\n None }) == ({ let _ = move s\n n }) }"
  let (ok_m4, j_m4, _) = check_one(mv_ok_rl_eq)
  assert_true(ok_m4, "mv_ok_rl_eq: " + j_m4)
  let mv_ok_rl_eq_after = "fn f(s : String, n : Option[Int]) -> Int { let _ = ({ let _ = s.length()\n None }) == ({ let _ = move s\n n })\n s.length() }"
  let (ok_m4b, j_m4b, _) = check_one(mv_ok_rl_eq_after)
  assert_true(!ok_m4b && j_m4b.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_ok_rl_eq_after: " + j_m4b)

  let mv_reinit_pe = "fn f(n : Option[Int]) -> Bool { let mut s = \"hi\"\n let _ = move s\n physical_equal({ s = \"new\"\n None }, { let _ = s.length()\n n }) }"
  let (ok_m5, j_m5, _) = check_one(mv_reinit_pe)
  assert_true(ok_m5, "mv_reinit_pe: " + j_m5)
  let mv_reinit_eq = "fn f(n : Option[Int]) -> Bool { let mut s = \"hi\"\n let _ = move s\n ({ s = \"new\"\n None }) == ({ let _ = s.length()\n n }) }"
  let (ok_m6, j_m6, _) = check_one(mv_reinit_eq)
  assert_true(ok_m6, "mv_reinit_eq: " + j_m6)

  let mv_rhs_self_pe = "fn f(t : String, n : Option[Int]) -> Bool { physical_equal(None, { let _ = move t\n let _ = t.length()\n n }) }"
  let (ok_m7, j_m7, _) = check_one(mv_rhs_self_pe)
  assert_true(!ok_m7 && j_m7.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_rhs_self_pe: " + j_m7)
  let mv_rhs_self_eq = "fn f(t : String, n : Option[Int]) -> Bool { None == ({ let _ = move t\n let _ = t.length()\n n }) }"
  let (ok_m8, j_m8, _) = check_one(mv_rhs_self_eq)
  assert_true(!ok_m8 && j_m8.contains("\"code\":\"E_USE_AFTER_MOVE\""), "mv_rhs_self_eq: " + j_m8)

  // 11. #verify separation: [T : Eq] bound without `==` in body allows Double; actual `==` in body rejects Double
  let v_bound_only_ok =
    #|#verify
    #|fn req_v[T : Eq](_x : T) -> Int { 1 }
    #|#verify
    #|fn wrap_v[U](x : Option[U]) -> Int { req_v(x) }
    #|#verify
    #|fn entry_v(x : Double) -> Int { wrap_v(Some(x)) }
  let (ok_vb, j_vb, _) = check_one(v_bound_only_ok)
  assert_true(ok_vb, "verify bound-only Eq with Double must pass: " + j_vb)

  let v_cmp_bad =
    #|#verify
    #|fn req_cmp[T : Eq](x : T) -> Bool { x == x }
    #|#verify
    #|fn wrap_cmp[U](x : Option[U]) -> Bool { req_cmp(x) }
    #|#verify
    #|fn entry_cmp(x : Double) -> Bool { wrap_cmp(Some(x)) }
  let (ok_vc, j_vc, _) = check_one(v_cmp_bad)
  assert_true(!ok_vc && j_vc.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "verify actual == with Double must fail: " + j_vc)

  // 12. Non-regular growing polymorphic recursion terminates with E_TYPE_MISMATCH; finite nesting, Box[Wide], Reset[Int], & swapped params pass
  let (ok_nest, j_nest, _) = check_one(
    "#derive(Eq)\nenum Nest[T] { End; More(Nest[Option[T]]) }\nfn f(a : Nest[Int], b : Nest[Int]) -> Bool { a == b }",
  )
  assert_true(!ok_nest && j_nest.contains("\"code\":\"E_TYPE_MISMATCH\""), "Nest[Option[T]] must fail in finite time: " + j_nest)
  let (ok_mut_grow, j_mut_grow, _) = check_one(
    "#derive(Eq)\nenum MutA[T] { AEnd; AGo(MutB[Option[T]]) }\n#derive(Eq)\nenum MutB[T] { BEnd; BGo(MutA[T]) }\nfn f(a : MutA[Int], b : MutA[Int]) -> Bool { a == b }",
  )
  assert_true(!ok_mut_grow && j_mut_grow.contains("\"code\":\"E_TYPE_MISMATCH\""), "MutA/MutB growing recursion must fail: " + j_mut_grow)
  let (ok_fin_nest, j_fin_nest, _) = check_one(
    "#derive(Eq)\nstruct Box[T] { v : T }\n#derive(Eq)\nenum SwapTree[A, B] { Leaf(A); Node(SwapTree[B, A]) }\nfn f(a : Box[Box[Int]], b : Box[Box[Int]], t1 : SwapTree[Int, String], t2 : SwapTree[Int, String]) -> Bool { a == b && t1 == t2 }",
  )
  assert_true(ok_fin_nest, "finite Box[Box[Int]] and SwapTree[A, B] must pass: " + j_fin_nest)
  let (ok_box_wide, j_box_wide, _) = check_one(
    "#derive(Eq)\nstruct Box[T] { v : T }\n#derive(Eq)\nstruct Wide { leaf : Box[Option[Int]] }\nfn same(a : Box[Wide], b : Box[Wide]) -> Bool { a == b }",
  )
  assert_true(ok_box_wide, "finite acyclic Box[Wide] containing Box[Option[Int]] must pass: " + j_box_wide)
  let (ok_reset, j_reset, _) = check_one(
    "#derive(Eq)\nenum Reset[T] { End(T); Next(Reset[Option[Int]]) }\nfn same_r(a : Reset[Int], b : Reset[Int]) -> Bool { a == b }",
  )
  assert_true(ok_reset, "finite instantiation graph Reset[Int] must pass: " + j_reset)
  let (ok_delay, j_delay, _) = check_one(
    "#derive(Eq)\nenum Delay[A, B] { End(A, B); Next(Delay[Option[B], Option[Int]]) }\nfn same_d(x : Delay[Int, Int], y : Delay[Int, Int]) -> Bool { x == y }",
  )
  assert_true(ok_delay, "finite instantiation graph Delay[Int, Int] must pass: " + j_delay)
  let (ok_delay4, j_delay4, _) = check_one(
    "#derive(Eq)\nenum Delay4[A, B, C, D] { End4(A, B, C, D); Next4(Delay4[Option[B], Option[C], Option[D], Option[Int]]) }\nfn same_d4(x : Delay4[Int, Int, Int, Int], y : Delay4[Int, Int, Int, Int]) -> Bool { x == y }",
  )
  assert_true(ok_delay4, "finite 4-step chain Delay4 must pass: " + j_delay4)
  let (ok_sneaky, j_sneaky, _) = check_one(
    "#derive(Eq)\nstruct Phantom[X] { tag : Int }\n#derive(Eq)\nenum Sneaky[T] { SEnd(T); SNext(Phantom[Sneaky[Option[T]]]) }\nfn same_s(x : Sneaky[Int], y : Sneaky[Int]) -> Bool { x == y }",
  )
  assert_true(ok_sneaky, "phantom-guarded Sneaky[Int] must pass: " + j_sneaky)
  let (ok_grow_ab, j_grow_ab, _) = check_one(
    "#derive(Eq)\nenum Grow[A, B] { GEnd(A, B); GNext(Grow[Option[B], Option[A]]) }\nfn bad_g(x : Grow[Int, Int], y : Grow[Int, Int]) -> Bool { x == y }",
  )
  assert_true(!ok_grow_ab && j_grow_ab.contains("\"code\":\"E_TYPE_MISMATCH\""), "Grow[A, B] expansive cycle must fail: " + j_grow_ab)
  let (ok_wrap_grow, j_wrap_grow, _) = check_one(
    "#derive(Eq)\nstruct Box[X] { v : X }\n#derive(Eq)\nenum WrapGrow[T] { WEnd(T); WNext(Box[WrapGrow[Option[T]]]) }\nfn bad_w(x : WrapGrow[Int], y : WrapGrow[Int]) -> Bool { x == y }",
  )
  assert_true(!ok_wrap_grow && j_wrap_grow.contains("\"code\":\"E_TYPE_MISMATCH\""), "WrapGrow through active Box must fail: " + j_wrap_grow)
  let (ok_ph_grow, j_ph_grow, _) = check_one(
    "#derive(Eq)\nstruct Phantom[X] { tag : Int }\n#derive(Eq)\nenum PhantomGrow[T] { PEnd(T); PNext(PhantomGrow[Phantom[T]]) }\nfn bad_p(x : PhantomGrow[Int], y : PhantomGrow[Int]) -> Bool { x == y }",
  )
  assert_true(!ok_ph_grow && j_ph_grow.contains("\"code\":\"E_TYPE_MISMATCH\""), "PhantomGrow wrapping T in Phantom must fail: " + j_ph_grow)
  let (ok_bad_fn, j_bad_fn, _) = check_one(
    "#derive(Eq)\nenum BadFn[T] { FEnd; FNext(BadFn[(T) -> Int]) }\nfn bad_f(x : BadFn[Int], y : BadFn[Int]) -> Bool { x == y }",
  )
  assert_true(!ok_bad_fn && j_bad_fn.contains("\"code\":\"E_TYPE_MISMATCH\""), "BadFn wrapping T in fn type must fail: " + j_bad_fn)
}

///|
test "unit pattern, self-referencing generic closure infer, and unannotated closure early return" {
  // 1. PTuple([]) matches TUnit: Ok(()) => () and match () { () => 1 }; non-empty tuple on Unit rejects
  let unit_pat_ok =
    #|fn f(r : Result[Unit, String]) -> Int {
    #|  let a = match r {
    #|    Ok(()) => 1
    #|    Err(_) => 0
    #|  }
    #|  let b = match () {
    #|    () => 2
    #|  }
    #|  let () = ()
    #|  a + b
    #|}
  let (ok_u1, j_u1, _) = check_one(unit_pat_ok)
  assert_true(ok_u1, "Ok(()) and match () should pass: " + j_u1)

  let unit_pat_bad =
    #|fn f(r : Result[Unit, Int]) -> Int {
    #|  match r {
    #|    Ok((a, b)) => 1
    #|    Err(e) => e
    #|  }
    #|}
  let (ok_u2, j_u2, _) = check_one(unit_pat_bad)
  assert_true(!ok_u2 && j_u2.contains("\"code\":\"E_TYPE_MISMATCH\""), "Ok((a, b)) on Result[Unit, Int] must fail: " + j_u2)

  // 2. Self-referencing generic closure callback (free fn + method + multi-arg same)
  let self_ref_fn =
    #|struct Computed[T] { item : T }
    #|fn computed_by[T](getter : (Option[T]) -> T, same~ : (T, T) -> Bool) -> Computed[T] {
    #|  let v = getter(None)
    #|  let v2 = getter(Some(v))
    #|  if same(v, v2) { Computed::{ item: v } } else { Computed::{ item: v2 } }
    #|}
    #|fn wrap[U](getter : (Option[U]) -> U, same : (U, U) -> Bool) -> Computed[(Int64, U)] {
    #|  computed_by(
    #|    fn(last) {
    #|      match last {
    #|        None => (0L, getter(None))
    #|        Some((up_rev, before)) => {
    #|          let next = getter(Some(before))
    #|          if same(before, next) { (up_rev, next) } else { (up_rev + 1L, next) }
    #|        }
    #|      }
    #|    },
    #|    same=fn(a, b) { a.0 == b.0 },
    #|  )
    #|}
  let (ok_sr1, j_sr1, _) = check_one(self_ref_fn)
  assert_true(ok_sr1, "computed_by self-ref generic closure must pass: " + j_sr1)

  let self_ref_meth =
    #|struct Graph { id : Int }
    #|struct Computed[T] { item : T }
    #|fn Graph::computed_by[T](self : Graph, getter : (Option[T]) -> T, same~ : (T, T) -> Bool) -> Computed[T] {
    #|  let _ = self.id
    #|  let v = getter(None)
    #|  let v2 = getter(Some(v))
    #|  if same(v, v2) { Computed::{ item: v } } else { Computed::{ item: v2 } }
    #|}
    #|fn use_graph(g : Graph) -> Computed[(Int64, Int)] {
    #|  g.computed_by(
    #|    fn(last) {
    #|      match last {
    #|        None => (1L, 10)
    #|        Some((rev, prev)) => (rev + 1L, prev + 5)
    #|      }
    #|    },
    #|    same=fn(a, b) { a.0 == b.0 },
    #|  )
    #|}
  let (ok_sr2, j_sr2, _) = check_one(self_ref_meth)
  assert_true(ok_sr2, "Graph::computed_by self-ref generic closure must pass: " + j_sr2)

  // Fail-closed: truly unconstrained unannotated closure still rejects
  let self_ref_unconstrained =
    #|fn id_cb[T](f : (T) -> T) -> Int {
    #|  let _ = f
    #|  0
    #|}
    #|fn bad() -> Int {
    #|  id_cb(fn(x) { x })
    #|}
  let (ok_sr3, j_sr3, _) = check_one(self_ref_unconstrained)
  assert_true(
    !ok_sr3 && j_sr3.contains("cannot infer type for closure parameter"),
    "unconstrained closure param must fail closed: " + j_sr3,
  )

  // 3. Unannotated closure early return + tail expression merging & mismatch diagnostics
  let clo_ret_ok =
    #|enum MyErr { A; B(Int) }
    #|fn f(cond : Bool) -> Int {
    #|  let r1 = fn() {
    #|    if cond { return Err("bad") }
    #|    Ok(42)
    #|  }
    #|  let a = match r1() {
    #|    Ok(v) => v
    #|    Err(e) => e.length()
    #|  }
    #|  let r2 = fn() {
    #|    if cond { return Err(MyErr::A) }
    #|    Ok(7)
    #|  }
    #|  let b = match r2() {
    #|    Ok(v) => v
    #|    Err(MyErr::A) => -1
    #|    Err(MyErr::B(n)) => n
    #|  }
    #|  let o1 = fn() {
    #|    if cond { return None }
    #|    Some("hi")
    #|  }
    #|  let c = match o1() {
    #|    Some(s) => s.length()
    #|    None => 0
    #|  }
    #|  let o2 = fn() {
    #|    if cond { return Some("ok") }
    #|    None
    #|  }
    #|  let d = match o2() {
    #|    Some(s) => s.length()
    #|    None => 0
    #|  }
    #|  let r3 = fn() {
    #|    if cond { return Err("e") }
    #|    return Ok(9)
    #|  }
    #|  let e = match r3() {
    #|    Ok(v) => v
    #|    Err(s) => s.length()
    #|  }
    #|  a + b + c + d + e
    #|}
  let (ok_cr1, j_cr1, _) = check_one(clo_ret_ok)
  assert_true(ok_cr1, "unannotated closure early return merge must pass: " + j_cr1)

  let clo_ret_bad_tail =
    #|fn f(cond : Bool) -> Int {
    #|  let g = fn() {
    #|    if cond { return 1 }
    #|    "oops"
    #|  }
    #|  let _ = g
    #|  0
    #|}
  let (ok_cr2, j_cr2, _) = check_one(clo_ret_bad_tail)
  assert_true(
    !ok_cr2 && j_cr2.contains("\"code\":\"E_TYPE_MISMATCH\""),
    "incompatible early return vs tail expr must fail: " + j_cr2,
  )

  let clo_ret_bad_two =
    #|fn f(cond : Bool) -> Int {
    #|  let g = fn() {
    #|    if cond { return 1 }
    #|    return "oops"
    #|  }
    #|  let _ = g
    #|  0
    #|}
  let (ok_cr3, j_cr3, _) = check_one(clo_ret_bad_two)
  assert_true(
    !ok_cr3 && j_cr3.contains("\"code\":\"E_TYPE_MISMATCH\""),
    "incompatible two early returns must fail: " + j_cr3,
  )
}

///|
test "unary minus rejects non-numeric types and accepts numeric types" {
  let (ok_num, j_num, _) = check_one(
    "fn neg_ok[T](a : Int, b : Int64, c : UInt, d : UInt64, e : Double, f : Float, g : Byte, h : Int8, t : T, n : Never) -> Int {\n  let _ = -a\n  let _ = -b\n  let _ = -c\n  let _ = -d\n  let _ = -e\n  let _ = -f\n  let _ = -g\n  let _ = -h\n  let _ = -t\n  let _ = -n\n  0\n}",
  )
  assert_true(ok_num, "unary `-` must accept all numeric types, TParam, and TNever: " + j_num)
  let (ok_st, j_st, _) = check_one(
    "struct Point { x : Int; y : Int }\nfn bad(p : Point) -> Int { let _ = -p; 0 }",
  )
  assert_true(!ok_st && j_st.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on struct must fail: " + j_st)
  let (ok_str, j_str, _) = check_one(
    "fn bad(s : String) -> Int { let _ = -s; 0 }",
  )
  assert_true(!ok_str && j_str.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on String must fail: " + j_str)
  let (ok_bool, j_bool, _) = check_one(
    "fn bad(b : Bool) -> Int { let _ = -b; 0 }",
  )
  assert_true(!ok_bool && j_bool.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on Bool must fail: " + j_bool)
  let (ok_opt, j_opt, _) = check_one(
    "fn bad(o : Option[Int]) -> Int { let _ = -o; 0 }",
  )
  assert_true(!ok_opt && j_opt.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on Option must fail: " + j_opt)
  let (ok_arr, j_arr, _) = check_one(
    "fn bad(xs : Array[Int]) -> Int { let _ = -xs; 0 }",
  )
  assert_true(!ok_arr && j_arr.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on Array must fail: " + j_arr)
  let (ok_unit, j_unit, _) = check_one(
    "fn bad() -> Int { let u : Unit = (); let _ = -u; 0 }",
  )
  assert_true(!ok_unit && j_unit.contains("\"code\":\"E_TYPE_MISMATCH\""), "unary `-` on Unit must fail: " + j_unit)
}

///|
test "generic arithmetic operator instantiation checks" {
  let (ok_good, j_good, _) = check_one(
    "fn neg[T](x : T) -> T { -x }\nfn wrap_neg[U](x : U) -> U { neg(x) }\nfn add[T](a : T, b : T) -> T { a + b }\nfn sub[T](a : T, b : T) -> T { a - b }\nfn bit_and[T](a : T, b : T) -> T { a & b }\nfn inc_sub[T](x : T, y : T) -> T { let mut a = x; a -= y; a }\nfn main() -> Int {\n  let _ = neg(2.5)\n  let _ = wrap_neg(2.5)\n  let _ = add(\"a\", \"b\")\n  let _ = add(1.5, 2.0)\n  let _ = sub(0.0, 2.5)\n  let _ = bit_and(6, 3)\n  let _ = inc_sub(10.0, 2.5)\n  0\n}",
  )
  assert_true(ok_good, "valid generic arithmetic instantiations must pass: " + j_good)
  let (ok_neg_str, j_neg_str, _) = check_one(
    "fn neg[T](x : T) -> T { -x }\nfn main() -> Int { let _ = neg(\"abc\"); 0 }",
  )
  assert_true(!ok_neg_str && j_neg_str.contains("\"code\":\"E_TYPE_MISMATCH\""), "neg(\"abc\") must fail: " + j_neg_str)
  let (ok_neg_bool, j_neg_bool, _) = check_one(
    "fn neg[T](x : T) -> T { -x }\nfn main() -> Int { let _ = neg(true); 0 }",
  )
  assert_true(!ok_neg_bool && j_neg_bool.contains("\"code\":\"E_TYPE_MISMATCH\""), "neg(true) must fail: " + j_neg_bool)
  let (ok_add_bool, j_add_bool, _) = check_one(
    "fn add[T](a : T, b : T) -> T { a + b }\nfn main() -> Int { let _ = add(true, false); 0 }",
  )
  assert_true(!ok_add_bool && j_add_bool.contains("\"code\":\"E_TYPE_MISMATCH\""), "add(true, false) must fail: " + j_add_bool)
  let (ok_sub_str, j_sub_str, _) = check_one(
    "fn sub[T](a : T, b : T) -> T { a - b }\nfn main() -> Int { let _ = sub(\"a\", \"b\"); 0 }",
  )
  assert_true(!ok_sub_str && j_sub_str.contains("\"code\":\"E_TYPE_MISMATCH\""), "sub(\"a\", \"b\") must fail: " + j_sub_str)
  let (ok_bit_dbl, j_bit_dbl, _) = check_one(
    "fn bit_and[T](a : T, b : T) -> T { a & b }\nfn main() -> Int { let _ = bit_and(1.5, 2.5); 0 }",
  )
  assert_true(!ok_bit_dbl && j_bit_dbl.contains("\"code\":\"E_TYPE_MISMATCH\""), "bit_and(1.5, 2.5) must fail: " + j_bit_dbl)
  let (ok_shl_dbl, j_shl_dbl, _) = check_one(
    "fn shl[T](a : T, n : Int) -> T { a << n }\nfn main() -> Int { let _ = shl(1.5, 1); 0 }",
  )
  assert_true(!ok_shl_dbl && j_shl_dbl.contains("\"code\":\"E_TYPE_MISMATCH\""), "shl(1.5, 1) must fail: " + j_shl_dbl)
  let (ok_ca_str, j_ca_str, _) = check_one(
    "fn inc_sub[T](x : T, y : T) -> T { let mut a = x; a -= y; a }\nfn main() -> Int { let _ = inc_sub(\"a\", \"b\"); 0 }",
  )
  assert_true(!ok_ca_str && j_ca_str.contains("\"code\":\"E_TYPE_MISMATCH\""), "compound -= on String must fail: " + j_ca_str)
  let (ok_wrap, j_wrap, _) = check_one(
    "fn neg[T](x : T) -> T { -x }\nfn wrap_neg[U](x : U) -> U { neg(x) }\nfn main() -> Int { let _ = wrap_neg(\"abc\"); 0 }",
  )
  assert_true(!ok_wrap && j_wrap.contains("\"code\":\"E_TYPE_MISMATCH\""), "wrap_neg(\"abc\") must fail: " + j_wrap)
  let (ok_ord_good, j_ord_good, _) = check_one(
    "enum Lv { Lo; Hi }\nfn lt[T](a : T, b : T) -> Bool { a < b }\nfn main() -> Int { let _ = lt(1.5, 2.0); let _ = lt(\"a\", \"b\"); let _ = false < true; let _ = Lv::Lo < Lv::Hi; let _ = lt(false, true); let _ = lt(Lv::Lo, Lv::Hi); 0 }",
  )
  assert_true(ok_ord_good, "lt on Double/String/Bool/unit-enum must pass: " + j_ord_good)
  let (ok_ord_struct, j_ord_struct, _) = check_one(
    "struct P { x : Int }\nfn lt[T](a : T, b : T) -> Bool { a < b }\nfn main() -> Int { let _ = lt(P::{ x: 1 }, P::{ x: 2 }); 0 }",
  )
  assert_true(!ok_ord_struct && j_ord_struct.contains("\"code\":\"E_TYPE_MISMATCH\""), "lt(P, P) must fail: " + j_ord_struct)
  let (ok_ord_direct, j_ord_direct, _) = check_one(
    "struct P { x : Int }\nfn main() -> Int { let _ = P::{ x: 1 } < P::{ x: 2 }; 0 }",
  )
  assert_true(!ok_ord_direct && j_ord_direct.contains("\"code\":\"E_TYPE_MISMATCH\""), "direct P < P must fail: " + j_ord_direct)
  let (ok_ord_penum, j_ord_penum, _) = check_one(
    "enum E { A(Int); B(Int) }\nfn main() -> Int { let _ = E::A(1) < E::B(2); 0 }",
  )
  assert_true(!ok_ord_penum && j_ord_penum.contains("\"code\":\"E_TYPE_MISMATCH\""), "direct payload enum < must fail: " + j_ord_penum)
  let (ok_ord_penum_g, j_ord_penum_g, _) = check_one(
    "enum E { A(Int); B(Int) }\nfn lt[T](a : T, b : T) -> Bool { a < b }\nfn main() -> Int { let _ = lt(E::A(1), E::B(2)); 0 }",
  )
  assert_true(!ok_ord_penum_g && j_ord_penum_g.contains("\"code\":\"E_TYPE_MISMATCH\""), "generic payload enum < must fail: " + j_ord_penum_g)
  // Pass-1 deferred closure rollback must not leak speculative op_tparams onto outer generic T
  let (ok_sr_rollback, j_sr_rollback, _) = check_one(
    "fn fix[T](f : (Option[T]) -> T) -> T { let v = f(None); f(Some(v)) }\nfn outer[T](x : T) -> (T, Int) {\n  let n = fix(fn(prev) { match prev { None => 1; Some(v) => v + 1 } })\n  (x, n)\n}\nfn main() -> Int { let _ = outer(\"abc\"); 0 }",
  )
  assert_true(ok_sr_rollback, "outer(\"abc\") must not fail from pass-1 closure op_tparams leak: " + j_sr_rollback)
}

///|
test "pkg::Variant shorthand pattern matches enum, disambiguates shared variants, respects alias & privacy" {
  let flex_pkg = check_source_files_full(
    "flex",
    ["style.pion"],
    [
      "pub enum Dim { Auto; Pt(Double) }\n" +
      "pub enum Align { Auto; Start }\n" +
      "enum PrivE { Secret }\n" +
      "pub fn mk_priv() -> PrivE { Secret }\n",
    ],
  )
  assert_true(flex_pkg.diagnostics.length() == 0, check_result_to_json(flex_pkg.diagnostics))
  let other_pkg = check_source_files_full(
    "other",
    ["other.pion"],
    ["pub enum Dim { Auto; Pt(Double) }\n"],
  )
  assert_true(other_pkg.diagnostics.length() == 0, check_result_to_json(other_pkg.diagnostics))
  let imps = [
    ImportedPkg::{ name: "flex", tc: flex_pkg.tc },
    ImportedPkg::{ name: "other", tc: other_pkg.tc },
  ]
  // 1. Direct `flex::Pt(x)` & `flex::Auto` (disambiguated against `flex::Align::Auto`) + exhaustiveness
  let app_ok = check_source_files_with_imports(
    "app_ok",
    ["main.pion"],
    [
      "import \"flex\"\n" +
      "fn same(a : flex::Dim, b : flex::Dim) -> Bool {\n" +
      "  match (a, b) {\n" +
      "    (flex::Auto, flex::Auto) => true\n" +
      "    (flex::Pt(x), flex::Pt(y)) => x == y\n" +
      "    _ => false\n" +
      "  }\n" +
      "}\n" +
      "fn full(d : flex::Dim) -> Double {\n" +
      "  match d {\n" +
      "    flex::Auto => 0.0\n" +
      "    flex::Pt(v) => v\n" +
      "  }\n" +
      "}\n" +
      "pub fn main() -> Int { let _ = same(flex::Pt(1.0), flex::Dim::Auto); let _ = full(flex::Pt(2.0)); 0 }\n",
    ],
    imps,
    true,
  )
  assert_true(app_ok.diagnostics.length() == 0, check_result_to_json(app_ok.diagnostics))
  // 2. Package alias `import "flex" as f; f::Pt(x)` & `f::Auto`
  let app_alias = check_source_files_with_imports(
    "app_alias",
    ["main.pion"],
    [
      "import \"flex\" as f\n" +
      "fn full(d : f::Dim) -> Double {\n" +
      "  match d {\n" +
      "    f::Auto => 0.0\n" +
      "    f::Pt(v) => v\n" +
      "  }\n" +
      "}\n" +
      "pub fn main() -> Int { let _ = full(f::Pt(3.0)); 0 }\n",
    ],
    imps,
    true,
  )
  assert_true(app_alias.diagnostics.length() == 0, check_result_to_json(app_alias.diagnostics))
  // 3. Wrong package `other::Pt(x)` matching `flex::Dim` must be rejected
  let app_wrong = check_source_files_with_imports(
    "app_wrong",
    ["main.pion"],
    [
      "import \"flex\"\n" +
      "import \"other\"\n" +
      "fn bad(d : flex::Dim) -> Double {\n" +
      "  match d {\n" +
      "    other::Pt(v) => v\n" +
      "    _ => 0.0\n" +
      "  }\n" +
      "}\n",
    ],
    imps,
    true,
  )
  let j_wrong = check_result_to_json(app_wrong.diagnostics)
  assert_true(
    app_wrong.diagnostics.length() > 0 && j_wrong.contains("\"code\":\"E_TYPE_MISMATCH\""),
    "other::Pt matching flex::Dim must fail: " + j_wrong,
  )
  // 4. Private enum variant via `flex::Secret` must emit E_PRIVATE_SYMBOL
  let app_priv = check_source_files_with_imports(
    "app_priv",
    ["main.pion"],
    [
      "import \"flex\"\n" +
      "fn bad() -> Int {\n" +
      "  match flex::mk_priv() {\n" +
      "    flex::Secret => 1\n" +
      "  }\n" +
      "}\n",
    ],
    imps,
    true,
  )
  let j_priv = check_result_to_json(app_priv.diagnostics)
  assert_true(
    app_priv.diagnostics.length() > 0 && j_priv.contains("\"code\":\"E_PRIVATE_SYMBOL\""),
    "flex::Secret on private enum must fail with E_PRIVATE_SYMBOL: " + j_priv,
  )
}

///|
fn ott_strs_eq(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn ott_plan_eq(a : ConstInitPlan, b : ConstInitPlan) -> Bool {
  ott_strs_eq(a.order, b.order) &&
  a.has_cycle == b.has_cycle &&
  ott_strs_eq(a.cycle_path, b.cycle_path) &&
  a.plan_hash == b.plan_hash &&
  a.has_ambiguous_method == b.has_ambiguous_method
}

///|
fn ott_plan_str(p : ConstInitPlan) -> String {
  "order=" + join_strs(p.order, ",") + " cycle=" + p.has_cycle.to_string() +
  " path=" + join_strs(p.cycle_path, ",") + " hash=" + p.plan_hash +
  " ambig=" + p.has_ambiguous_method.to_string()
}

///|
fn ott_resolved_sigs(c : CheckedPackage) -> Array[String] {
  let sigs : Array[String] = []
  let mut fi = 0
  while fi < c.pkg.files.length() {
    sigs.push(emit_file_sig_entries_resolved(c.pkg.files[fi], c.tc.resolved_method_calls))
    fi = fi + 1
  }
  sigs
}

///|
fn ott_takes_rows(sigs : Array[String]) -> Bool {
  match sig_const_rows_without_calls(sigs) {
    Some(_) => true
    None => false
  }
}

///|
/// Checks one package: `compute_const_init_plan_from_pkg_tc` (fast `#cdep` rows
/// or fallback) must equal the full planner over every resolved summary line.
fn ott_check_case(
  name : String,
  paths : Array[String],
  sources : Array[String],
  want_rows : Bool,
  want_order : Array[String],
  want_codes : Array[String],
) -> Unit {
  let c = check_source_files_full(name, paths, sources)
  let json = check_result_to_json(c.diagnostics)
  if want_codes.length() == 0 {
    assert_true(c.diagnostics.length() == 0, name + ": " + json)
  }
  let mut wi = 0
  while wi < want_codes.length() {
    assert_true(json.contains(want_codes[wi]), name + " must report " + want_codes[wi] + ": " + json)
    wi = wi + 1
  }
  let sigs = ott_resolved_sigs(c)
  assert_true(ott_takes_rows(sigs) == want_rows, name + ": #cdep fast path taken != " + want_rows.to_string())
  let got = compute_const_init_plan_from_pkg_tc(c.pkg, c.tc)
  let full = compute_const_init_plan_from_sigs(sigs)
  assert_true(ott_plan_eq(got, full), name + ": " + ott_plan_str(got) + " vs full " + ott_plan_str(full))
  assert_true(ott_strs_eq(got.order, want_order), name + ": order " + join_strs(got.order, ","))
}

///|
test "opt_t: front_const_rows fast #cdep rows == full planner (order, cycle, hash, ambiguity)" {
  // Pure direct constant reads across two files: fast path, Kahn tie break by source index.
  ott_check_case(
    "ott_direct",
    ["a.pion", "b.pion"],
    [
      "let A : Int = B + C\nlet C : Int = B * 2\npub fn main() -> Int { A }\n",
      "let B : Int = 1\nlet D : Int = A - C\n",
    ],
    true,
    ["B", "C", "A", "D"],
    [],
  )
  // A call in an initializer: fallback, the callee's read of B orders B first.
  ott_check_case(
    "ott_call",
    ["main.pion"],
    ["fn f() -> Int { B }\nlet A : Int = f()\nlet B : Int = 2\npub fn main() -> Int { A }\n"],
    false,
    ["B", "A"],
    [],
  )
  // Non-ASCII string literals never reach #cdep rows (identifiers are ASCII).
  ott_check_case(
    "ott_utf8",
    ["main.pion"],
    ["let S : String = \"h\u{e9}llo\" + T\nlet T : String = \"\u{fc}\u{4e2d}\"\npub fn main() -> Int { S.length() }\n"],
    true,
    ["T", "S"],
    [],
  )
  // Direct cycle: fast path, same E_CONST_CYCLE path.
  ott_check_case(
    "ott_cycle_direct",
    ["main.pion"],
    ["let A : Int = B + 1\nlet B : Int = A + 1\npub fn main() -> Int { 0 }\n"],
    true,
    ["A", "B"],
    ["E_CONST_CYCLE"],
  )
  // Cross-file cycle through a function: fallback.
  ott_check_case(
    "ott_cycle_call",
    ["a.pion", "b.pion"],
    ["let A : Int = g()\npub fn main() -> Int { 0 }\n", "fn g() -> Int { B }\nlet B : Int = A\n"],
    false,
    ["A", "B"],
    ["E_CONST_CYCLE"],
  )
  // No constants at all.
  ott_check_case("ott_none", ["main.pion"], ["pub fn main() -> Int { 0 }\n"], true, [], [])
  // A type error next to the constant plan: diagnostics keep both.
  ott_check_case(
    "ott_type_error",
    ["main.pion"],
    ["let A : Int = B\nlet B : Int = \"x\"\npub fn main() -> Int { A }\n"],
    true,
    ["B", "A"],
    ["E_TYPE_MISMATCH"],
  )
  // `call?:` ambiguity is a call descriptor: fallback keeps has_ambiguous_method decisions.
  ott_check_case(
    "ott_ambig",
    ["main.pion"],
    [
      "fn f0() -> Int { 1 }\n" +
      "fn go(f : () -> Int) -> Int { let B = f; B() }\n" +
      "let A : Int = go(f0)\n" +
      "let B : Int = f0()\n" +
      "pub fn main() -> Int { A + B }\n",
    ],
    false,
    ["A", "B"],
    [],
  )
}

///|
test "opt_t: front_const_rows row filter shapes and first-record semantics" {
  // Accepted: only #cdep rows survive, in order; the planner keeps the first A (file 1).
  let sigs = [
    "fn f() -> Int\n#cdep A|B,X|\n#fdep f|A|\nstruct S { a : Int }\n",
    "#cdep B||\n#cdep A|Z|\n#cdep Z|A|\n",
  ]
  let rows = match sig_const_rows_without_calls(sigs) {
    Some(r) => r
    None => abort("rows must be accepted")
  }
  assert_true(ott_strs_eq(rows, ["#cdep A|B,X|", "#cdep B||", "#cdep A|Z|", "#cdep Z|A|"]), join_strs(rows, ";"))
  let fast = compute_const_init_plan_from_sigs(rows)
  let full = compute_const_init_plan_from_sigs(sigs)
  assert_true(ott_plan_eq(fast, full), ott_plan_str(fast) + " vs " + ott_plan_str(full))
  assert_true(ott_strs_eq(fast.order, ["B", "A", "Z"]), ott_plan_str(fast))
  // Rejected shapes fall back to the full planner.
  assert_true(!ott_takes_rows(["#cdep A|B|f\n"]), "call column")
  assert_true(!ott_takes_rows(["#cdep A|B,C|f,g\n#cdep B||\n"]), "calls")
  assert_true(!ott_takes_rows(["#cdep B||\n#cdep A|B\n"]), "missing second separator")
  assert_true(!ott_takes_rows(["#cdep |B|\n"]), "empty name")
  assert_true(!ott_takes_rows(["#cdep A\n"]), "no separator")
  assert_true(!ott_takes_rows(["#cdep A|B||\n"]), "extra separator")
  assert_true(!ott_takes_rows(["#cdep \u{c4}|B|\n"]), "non-ASCII name")
  assert_true(!ott_takes_rows(["#cdep A|B\u{0D}|\n"]), "control byte")
  // No rows / no constants: accepted with zero rows, empty plan either way.
  let empty = compute_const_init_plan_from_sigs(["fn f() -> Int\n"])
  assert_true(ott_takes_rows(["fn f() -> Int\n"]) && empty.plan_hash == "" && empty.order.length() == 0, ott_plan_str(empty))
}

///|
test "opt_t: front_plan_once cold preparation reuses the checked plan" {
  let a = "let A : Int = B + f()\npub fn main() -> Int { A + C }\n"
  let b = "fn f() -> Int { C }\nlet C : Int = 3\nlet B : Int = C * 2\n"
  let prep = match cli_prepare_qbe_units("ott_prep", ["a.pion", "b.pion"], [a, b]) {
    Ok(p) => p
    Err(e) => abort(e)
  }
  let again = compute_const_init_plan_from_pkg_tc(prep.pkg, prep.tc)
  assert_true(ott_strs_eq(prep.const_init_order, again.order), join_strs(prep.const_init_order, ","))
  assert_true(ott_strs_eq(prep.const_init_order, ["C", "B", "A"]), join_strs(prep.const_init_order, ","))
  let sig0 = emit_file_sig_entries(prep.pkg.files[0])
  let sig1 = emit_file_sig_entries(prep.pkg.files[1])
  let summary = summarize_file_sigs("ott_prep", [sig0, sig1])
  assert_eq(summary.sigs_hash, prep.sigs_hash)
  // No top-level constant: the recorded plan is the planner's empty plan.
  let nc = "fn helper(x : Int) -> Int { x * 3 }\npub fn main() -> Int { helper(2) }\n"
  let prep0 = match cli_prepare_qbe_units("ott_prep_none", ["main.pion"], [nc]) {
    Ok(p) => p
    Err(e) => abort(e)
  }
  let again0 = compute_const_init_plan_from_pkg_tc(prep0.pkg, prep0.tc)
  assert_true(
    again0.order.length() == 0 && !again0.has_cycle && again0.cycle_path.length() == 0 &&
    again0.plan_hash == "" && !again0.has_ambiguous_method && prep0.const_init_order.length() == 0,
    ott_plan_str(again0),
  )
  let summary0 = summarize_file_sigs("ott_prep_none", [emit_file_sig_entries(prep0.pkg.files[0])])
  assert_eq(summary0.sigs_hash, prep0.sigs_hash)
  // The full check itself records exactly that plan (not left to the
  // recompute fallback); a selective check records nothing.
  let nc_pkg = Package::{ name: "ott_rec_none", files: [parse_source("main.pion", nc).file] }
  let rec_full : Array[ConstInitPlan] = []
  let _ = check_package_with_imports_mapped_plan(nc_pkg, [], [], [], [], false, false, Some(rec_full))
  assert_true(rec_full.length() == 1, "full check records " + rec_full.length().to_string() + " plans")
  let c_nc = check_source_files_full("ott_rec_none", ["main.pion"], [nc])
  assert_true(
    ott_plan_eq(rec_full[0], compute_const_init_plan_from_pkg_tc(c_nc.pkg, c_nc.tc)),
    ott_plan_str(rec_full[0]),
  )
  let sel_pkg = Package::{ name: "ott_rec_sel", files: [parse_source("main.pion", nc).file] }
  let rec_sel : Array[ConstInitPlan] = []
  let _ = check_package_with_imports_mapped_plan(sel_pkg, [true], [], [], [], false, false, Some(rec_sel))
  assert_true(rec_sel.length() == 0, "selective check records " + rec_sel.length().to_string() + " plans")
  // Diagnostics still come first: cycle + type error is an Err with both codes.
  let bad = cli_prepare_qbe_units(
    "ott_prep_bad",
    ["main.pion"],
    ["let A : Int = B\nlet B : Int = A\nlet C : Int = \"x\"\npub fn main() -> Int { 0 }\n"],
  )
  match bad {
    Ok(_) => abort("cycle + type error must fail")
    Err(e) => {
      assert_true(e.contains("E_CONST_CYCLE"), e)
      assert_true(e.contains("E_TYPE_MISMATCH"), e)
    }
  }
}

///|
/// A loop that rotates n + 1 container-holding `mut` locals by one per run
/// (`a<n> = a<n-1>; ...; a1 = a0; a0 = [read_b]`). `sig_assign_local` copies
/// the current `cslots` of the source local, so the new `[read_b]` cslot moves
/// one local further per dependency pass: the fixed point needs n + 1 passes
/// (n + 1 <= 63 converges; n >= 63 exhausts the 64-pass budget and takes
/// `sig_fallback_dirty_outer_cslots`). `other = [read_c]` is an unrelated
/// container: only the fallback (which unions every cslot's targets) makes
/// `A` depend on `C`.
fn ott_cslot_chain_src(kind : String, n : Int) -> String {
  let sb = StringBuilder()
  sb.write_string("fn zero() -> Int { 0 }\nfn read_b() -> Int { B }\nfn read_c() -> Int { C }\n")
  sb.write_string("fn make_b() -> Int { 11 }\nfn make_c() -> Int { 13 }\nfn go() -> Int {\n")
  sb.write_string("  let other = [read_c]\n")
  let mut j = 0
  while j <= n {
    sb.write_string("  let mut a" + j.to_string() + " = [zero]\n")
    j = j + 1
  }
  let shift = StringBuilder()
  j = n
  while j >= 1 {
    shift.write_string("a" + j.to_string() + " = a" + (j - 1).to_string() + "; ")
    j = j - 1
  }
  shift.write_string("a0 = [read_b]")
  let runs = (n + 1).to_string()
  if kind == "while" {
    sb.write_string("  let mut i = 0\n  while i < " + runs + " { " + shift.to_string() + "; i = i + 1 }\n")
  } else if kind == "while_is" {
    sb.write_string("  let mut it : Option[Int] = Some(" + runs + ")\n")
    sb.write_string(
      "  while it is Some(m) { " + shift.to_string() + "; it = if m > 1 { Some(m - 1) } else { None } }\n",
    )
  } else if kind == "cfor" {
    sb.write_string("  for i = 0; i < " + runs + "; i = i + 1 { " + shift.to_string() + " }\n")
  } else if kind == "range" {
    sb.write_string("  for i in 0..<" + runs + " { " + shift.to_string() + " }\n")
  } else {
    sb.write_string("  let xs : Array[Int] = []\n  let mut q = 0\n  while q < " + runs + " { xs.push(q); q = q + 1 }\n")
    sb.write_string("  for x in xs { " + shift.to_string() + " }\n")
  }
  sb.write_string("  let f = a" + n.to_string() + "[0]\n  f() + 0 * other.length()\n}\n")
  sb.write_string("let A : Int = go()\nlet B : Int = make_b()\nlet C : Int = make_c()\npub fn main() -> Int { A }\n")
  sb.to_string()
}

///|
test "opt_t: front_loop_fp multi-pass fixed points and the 64-pass fallback" {
  let kinds = ["while", "while_is", "cfor", "range", "for_in"]
  let mut ki = 0
  while ki < kinds.length() {
    let kind = kinds[ki]
    // 6 passes: B must precede A (a shorter fixed point would miss read_b).
    let c5 = check_source_files_full("ott_fp5_" + kind, ["main.pion"], [ott_cslot_chain_src(kind, 5)])
    assert_true(c5.diagnostics.length() == 0, kind + "5: " + check_result_to_json(c5.diagnostics))
    assert_true(
      ott_strs_eq(c5.tc.const_init_order, ["B", "A", "C"]),
      kind + "5 order " + join_strs(c5.tc.const_init_order, ","),
    )
    // 71 passes needed: the budget runs out, the fallback unions every cslot,
    // so A also waits for C (read_c reaches a70 only through the fallback).
    let c70 = check_source_files_full("ott_fp70_" + kind, ["main.pion"], [ott_cslot_chain_src(kind, 70)])
    assert_true(c70.diagnostics.length() == 0, kind + "70: " + check_result_to_json(c70.diagnostics))
    assert_true(
      ott_strs_eq(c70.tc.const_init_order, ["B", "C", "A"]),
      kind + "70 order " + join_strs(c70.tc.const_init_order, ","),
    )
    ki = ki + 1
  }
  // 41 passes (< 64) still converge exactly: no fallback over-approximation.
  let c40 = check_source_files_full("ott_fp40", ["main.pion"], [ott_cslot_chain_src("while", 40)])
  assert_true(
    ott_strs_eq(c40.tc.const_init_order, ["B", "A", "C"]),
    "while40 order " + join_strs(c40.tc.const_init_order, ","),
  )
  // Budget boundary: n = 62 converges on pass 63, n = 63 exhausts all 64.
  let c62 = check_source_files_full("ott_fp62", ["main.pion"], [ott_cslot_chain_src("while", 62)])
  assert_true(
    ott_strs_eq(c62.tc.const_init_order, ["B", "A", "C"]),
    "while62 order " + join_strs(c62.tc.const_init_order, ","),
  )
  let c63 = check_source_files_full("ott_fp63", ["main.pion"], [ott_cslot_chain_src("while", 63)])
  assert_true(
    ott_strs_eq(c63.tc.const_init_order, ["B", "C", "A"]),
    "while63 order " + join_strs(c63.tc.const_init_order, ","),
  )
}

///|
fn ott_fmutlink_rows(src : String) -> Array[String] {
  let pr = parse_source("dup.pion", src)
  let rows : Array[String] = []
  let lines = split_lines(emit_file_sig_entries(pr.file))
  let mut li = 0
  while li < lines.length() {
    if starts_with_str(lines[li], "#fmutlink ") {
      rows.push(lines[li])
    }
    li = li + 1
  }
  rows
}

///|
test "opt_t: front_slot_seen keeps #fmutlink rows unique in first-occurrence order" {
  let head = "fn zero() -> Int { 0 }\nfn r1() -> Int { 1 }\nfn r2() -> Int { 2 }\n" +
    "fn i1(mut f : () -> Int) -> Unit { f = r1 }\nfn i2(mut f : () -> Int) -> Unit { f = r2 }\n" +
    "fn go() -> Int {\n  let mut f = zero\n  let mut g = zero\n"
  // Every link repeated (three rounds, later rounds in reverse order).
  let dup = head +
    "  i2(mut f)\n  i1(mut g)\n  i1(mut f)\n" +
    "  i1(mut f)\n  i1(mut g)\n  i2(mut f)\n" +
    "  i2(mut f)\n  i1(mut f)\n  i1(mut g)\n" +
    "  let cb = fn() -> Int { i1(mut g); i2(mut f); f() }\n  cb() + g()\n}\n"
  let rows = ott_fmutlink_rows(dup)
  assert_true(
    ott_strs_eq(
      rows,
      ["#fmutlink $slot_fn_go_0|i2|0", "#fmutlink $slot_fn_go_1|i1|0", "#fmutlink $slot_fn_go_0|i1|0"],
    ),
    join_strs(rows, ";"),
  )
  // Same rows as the source without the repeats.
  let once = head + "  i2(mut f)\n  i1(mut g)\n  i1(mut f)\n  let cb = fn() -> Int { f() }\n  cb() + g()\n}\n"
  assert_true(ott_strs_eq(rows, ott_fmutlink_rows(once)), join_strs(ott_fmutlink_rows(once), ";"))
}

///|
fn r242_prelude() -> String {
  "struct Seq[T] {\n  items : Array[T]\n}\n" +
  "fn Seq::map[T, U](self : Seq[T], f : (T) -> U) -> Seq[U] {\n  let out : Array[U] = []\n  for x in self.items {\n    out.push(f(x))\n  }\n  Seq::{ items: out }\n}\n" +
  "fn total(s : Seq[Double]) -> Double {\n  let mut t = 0.0\n  for x in s.items {\n    t = t + x\n  }\n  t\n}\n" +
  "fn apply[T, U](xs : Array[T], f : (T) -> U) -> Array[U] {\n  let out : Array[U] = []\n  for x in xs {\n    out.push(f(x))\n  }\n  out\n}\n" +
  "fn sum_d(xs : Array[Double]) -> Double {\n  let mut t = 0.0\n  for x in xs {\n    t = t + x\n  }\n  t\n}\n" +
  "fn may_fail(x : Int) -> Result[Int, String] {\n  Ok(x)\n}\n"
}

///|
fn r242_expect_reject(body : String, msg : String) -> Unit {
  let (ok, json, diags) = check_one(r242_prelude() + "pub fn go() -> Double {\n" + body + "\n}\n")
  assert_true(!ok, msg + ": expected E_TYPE_MISMATCH, got none")
  assert_true(diags[0].code == "E_TYPE_MISMATCH", msg + ": " + json)
}

///|
fn r242_expect_ok(body : String, msg : String) -> Unit {
  let (ok, json, _) = check_one(r242_prelude() + "pub fn go() -> Double {\n" + body + "\n}\n")
  assert_true(ok, msg + ": " + json)
}

///|
test "r242: closure body type is never swallowed by the expected / declared return type" {
  r242_expect_reject("  Seq::{ items: [1, 2] }.map(fn(_x) { 7 / 2 }) |> total", "method map + pipe")
  r242_expect_reject("  total(Seq::{ items: [1, 2] }.map(fn(_x) { 7 / 2 }))", "method map + call")
  r242_expect_reject("  let f : (Int) -> Double = fn(_x) { 7 / 2 }\n  f(1)", "let with fn type")
  r242_expect_reject("  let f = fn(_x : Int) -> Double { 7 / 2 }\n  f(1)", "explicit return annotation")
  r242_expect_reject("  let d : Array[Double] = apply([1, 2], fn(_x) { 7 / 2 })\n  sum_d(d)", "generic HOF, let")
  r242_expect_reject("  sum_d(apply([1, 2], fn(_x) { 7 / 2 }))", "generic HOF, nested call")
  let (_, json, diags) = check_one(r242_prelude() + "pub fn go() -> Double {\n  let f = fn(_x : Int) -> Double { 7 / 2 }\n  f(1)\n}\n")
  assert_true(diags.length() == 1, json)
  assert_true(diags[0].expected == "Double" && diags[0].found == "Int", json)
}

///|
test "r242: closures matching their expected return type still infer from context" {
  r242_expect_ok("  Seq::{ items: [1, 2] }.map(fn(_x) { 7.0 / 2.0 }) |> total", "Double body")
  r242_expect_ok("  sum_d(apply([1, 2], fn(_x) { 7.0 / 2.0 }))", "generic HOF Double body")
  r242_expect_ok(
    "  let f : (Int) -> Option[Int] = fn(_x) { None }\n" +
    "  let g : (Int) -> Array[Int] = fn(_x) { [] }\n" +
    "  let h : (Int) -> Double = fn(_x) { panic(\"boom\") }\n" +
    "  let u : (Int) -> Unit = fn(x) { x + 1 }\n" +
    "  let v = fn(x : Int) -> Unit { x + 1 }\n" +
    "  u(1)\n  v(1)\n" +
    "  let _ = h\n" +
    "  if f(1).is_none() && g(1).length() == 0 { 1.0 } else { 0.0 }",
    "context-inferred None / [] / panic / Unit discard",
  )
  // The `-> Unit` discard still refuses to drop a `Result` tail.
  for body in [
    "  let u : (Int) -> Unit = fn(x) { may_fail(x) }\n  u(1)\n  0.0",
    "  let v = fn(x : Int) -> Unit { may_fail(x) }\n  v(1)\n  0.0",
  ] {
    let (ok, json, diags) = check_one(r242_prelude() + "pub fn go() -> Double {\n" + body + "\n}\n")
    assert_true(!ok && diags[0].code == "E_UNHANDLED_RESULT", body + ": " + json)
  }
}

///|
test "f3d0: builtin impl Eq identity, anti-hijacking, orphan, conflicts, generics, sig and #verify" {
  // 1. Basic concrete + generic impl Eq, pub impl, private helper, inherent equal coexistence
  let ok_basic = check_source_files_full(
    "f3d0_basic",
    ["a.pion"],
    [
      #|fn priv_cmp(a : Int, b : Int) -> Bool { a == b }
      #|pub struct Picked { tag : Int, cb : () -> Unit }
      #|pub impl Eq for Picked {
      #|  fn equal(a : Picked, b : Picked) -> Bool { priv_cmp(a.tag, b.tag) }
      #|}
      #|fn Picked::equal(self : Picked, other : Picked) -> Bool { self.tag != other.tag }
      #|struct TheseItems[T] { item : T }
      #|impl[T] Eq for TheseItems[T] {
      #|  fn equal(a : TheseItems[T], b : TheseItems[T]) -> Bool { physical_equal(a, b) }
      #|}
      #|struct Box[T] { v : T }
      #|impl[T : Eq] Eq for Box[T] {
      #|  fn equal(a : Box[T], b : Box[T]) -> Bool { a.v == b.v }
      #|}
      #|struct Pair[A, B] { first : A, second : B }
      #|impl[A, B : Eq] Eq for Pair[A, B] {
      #|  fn equal(a : Pair[A, B], b : Pair[A, B]) -> Bool { a.second == b.second }
      #|}
      #|fn req_eq[T : Eq](_x : T) -> Int { 1 }
      #|fn use_all(p : Picked, ti : TheseItems[() -> Unit], pr : Pair[() -> Unit, Int], bx : Box[Int]) -> Bool {
      #|  let _ = req_eq(ti)
      #|  let _ = req_eq(pr)
      #|  let _ = req_eq(bx)
      #|  p == p && p.equal(p) && ti == ti && pr == pr && bx == bx
      #|}
    ],
  )
  assert_true(ok_basic.diagnostics.length() == 0, check_result_to_json(ok_basic.diagnostics))

  // 2. Anti-hijacking: custom trait Eq declared in a later file binds impl Eq to custom trait
  let ah_local = check_source_files(
    "f3d0_ah_local",
    ["a.pion", "b.pion"],
    [
      #|struct S { x : Int }
      #|impl Eq for S { fn my_eq(self : S, other : S) -> Bool { self.x == other.x } }
      #|fn f(a : S, b : S) -> Bool { a.my_eq(b) }
      ,
      #|trait Eq { fn my_eq(self : Self, other : Self) -> Bool }
    ],
  )
  assert_true(ah_local.diagnostics.length() == 0, check_result_to_json(ah_local.diagnostics))

  // Cross-package anti-hijacking: dep has builtin impl Eq, app defines custom trait Eq
  let dep_eq = check_source_files_with_imports(
    "dep_beq2",
    ["dep.pion"],
    [
      #|pub struct K { x : Int }
      #|pub impl Eq for K { fn equal(a : K, b : K) -> Bool { a.x == b.x } }
    ],
    [],
    true,
  )
  assert_true(dep_eq.diagnostics.length() == 0, check_result_to_json(dep_eq.diagnostics))
  let app_ah = check_source_files_with_imports(
    "app_ah2",
    ["app.pion"],
    [
      #|import "dep_beq2"
      #|trait Eq { fn custom_eq(self : Self, other : Self) -> Bool }
      #|pub fn f(a : dep_beq2::K, b : dep_beq2::K) -> Bool { a == b }
    ],
    [imported_pkg_new("dep_beq2", dep_eq.tc)],
    true,
  )
  assert_true(app_ah.diagnostics.length() == 0, check_result_to_json(app_ah.diagnostics))

  // 3. Orphan rule, derive+impl conflict, duplicate across files, partial spec, bad sigs
  let bad_cases : Array[String] = [
    "impl Eq for Int { fn equal(a : Int, b : Int) -> Bool { a == b } }",
    "#derive(Eq)\nstruct S { x : Int }\nimpl Eq for S { fn equal(a : S, b : S) -> Bool { a.x == b.x } }",
    "#derive(Eq)\nenum E { A; B }\nimpl Eq for E { fn equal(a : E, b : E) -> Bool { true } }",
    "struct Box[T] { v : T }\nimpl Eq for Box[Int] { fn equal(a : Box[Int], b : Box[Int]) -> Bool { a.v == b.v } }",
    "struct Pair[A, B] { a : A, b : B }\nimpl[T] Eq for Pair[T, T] { fn equal(x : Pair[T, T], y : Pair[T, T]) -> Bool { true } }",
    "struct S { x : Int }\nimpl[T] Eq for S { fn equal(a : S, b : S) -> Bool { true } }",
    "struct Box[T] { v : T }\nimpl[T, U] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }",
    "struct S { x : Int }\nimpl Eq for S { fn equal(a : S, b : S) -> Int { 1 } }",
    "struct S { x : Int }\nimpl Eq for S { fn equal(mut a : S, b : S) -> Bool { true } }",
    "struct S { x : Int }\nimpl Eq for S { fn equal(a : S, b : S) -> Bool { true }\n fn extra(a : S) -> Bool { true } }",
    "struct S { x : Int }\nimpl Eq for S { fn eq(a : S, b : S) -> Bool { true } }",
    "struct Box[T] { v : T }\nimpl[T] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { a.v == b.v } }",
    "struct Box[T] { v : T }\nimpl[T : Eq] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nfn req[U : Eq](_x : U) -> Int { 1 }\nfn f(b : Box[() -> Unit]) -> Int { req(b) }",
    "struct Pair[A, B] { a : A, b : B }\nimpl[A, B : Eq] Eq for Pair[A, B] { fn equal(x : Pair[A, B], y : Pair[A, B]) -> Bool { x.b == y.b } }\nfn f(p : Pair[Int, () -> Unit]) -> Bool { p == p }",
  ]
  let mut bi = 0
  while bi < bad_cases.length() {
    let (ok_b, j_b, _) = check_one(bad_cases[bi])
    assert_true(!ok_b, "bad_cases[" + bi.to_string() + "] must fail: " + j_b)
    bi = bi + 1
  }

  // Duplicate impl Eq across two files in same package
  let dup_2f = check_source_files(
    "f3d0_dup2f",
    ["a.pion", "b.pion"],
    [
      #|struct S { x : Int }
      #|impl Eq for S { fn equal(a : S, b : S) -> Bool { a.x == b.x } }
      ,
      #|impl Eq for S { fn equal(a : S, b : S) -> Bool { a.x == b.x } }
    ],
  )
  assert_true(dup_2f.diagnostics.length() > 0, "duplicate impl Eq across files must fail")

  // Orphan impl Eq on imported type and on local `type` alias of imported type
  let orphan_imp = check_source_files_with_imports(
    "app_orphan",
    ["app.pion"],
    [
      #|import "dep_beq2"
      #|impl Eq for dep_beq2::K { fn equal(a : dep_beq2::K, b : dep_beq2::K) -> Bool { true } }
    ],
    [imported_pkg_new("dep_beq2", dep_eq.tc)],
    true,
  )
  assert_true(orphan_imp.diagnostics.length() > 0, "orphan impl Eq on imported type must fail")

  let orphan_alias = check_source_files_with_imports(
    "app_orphan_alias",
    ["app.pion"],
    [
      #|import "dep_beq2"
      #|type LocalK = dep_beq2::K
      #|impl Eq for LocalK { fn equal(a : LocalK, b : LocalK) -> Bool { true } }
    ],
    [imported_pkg_new("dep_beq2", dep_eq.tc)],
    true,
  )
  assert_true(orphan_alias.diagnostics.length() > 0, "orphan impl Eq on local type alias of imported type must fail")

  // P1-2: Non-regular polymorphic recursion through constrained `impl[T : Eq] Eq for Grow[T]` must be rejected,
  // while unconstrained `impl[T] Eq for TheseItems[T]` remains valid.
  let (ok_exp_bad, j_exp_bad, _) = check_one(
    "struct Grow[T] { x : T }\nimpl[T : Eq] Eq for Grow[T] { fn equal(a : Grow[T], b : Grow[T]) -> Bool { a.x == b.x } }\n#derive(Eq)\nenum Bad[T] { End; More(Grow[Bad[Option[T]]]) }\nfn f(a : Bad[Int], b : Bad[Int]) -> Bool { a == b }",
  )
  assert_true(!ok_exp_bad, "non-regular recursion through constrained impl Eq must fail: " + j_exp_bad)
  let (ok_exp_good, j_exp_good, _) = check_one(
    "struct TheseItems[T] { x : T }\nimpl[T] Eq for TheseItems[T] { fn equal(a : TheseItems[T], b : TheseItems[T]) -> Bool { physical_equal(a, b) } }\n#derive(Eq)\nenum Good[T] { End; More(TheseItems[Good[Option[T]]]) }\nfn f(a : Good[Int], b : Good[Int]) -> Bool { a == b }",
  )
  assert_true(ok_exp_good, "unconstrained impl Eq breaking recursion must pass: " + j_exp_good)

  // P1-3: Map keys reject types with custom impl Eq (unit enum, POD struct, wrapper struct, and tuple containing them)
  let map_bad_cases : Array[String] = [
    "struct Key { a : Int, b : Int }\nimpl Eq for Key { fn equal(x : Key, y : Key) -> Bool { x.a == y.a } }\nfn f() -> Map[Key, Int] { Map::new() }",
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nfn f() -> Map[Color, Int] { Map::new() }",
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nfn f() -> Map[(Color, Int), Int] { Map::new() }",
    "struct Key { a : Int, b : Int }\nimpl Eq for Key { fn equal(x : Key, y : Key) -> Bool { x.a == y.a } }\nstruct Holder { m : Map[Key, Int] }",
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nstruct Wrap { c : Color }\nfn f() -> Map[Wrap, Int] { Map::new() }",
    "struct Key { a : Int, b : Int }\nimpl Eq for Key { fn equal(x : Key, y : Key) -> Bool { x.a == y.a } }\nfn f() -> Int { let m : Map[Key, Int] = Map::new(); m.length() }",
    "struct Key { a : Int, b : Int }\nimpl Eq for Key { fn equal(x : Key, y : Key) -> Bool { x.a == y.a } }\nfn wrap[T](k : T) -> Int { let m : Map[T, Int] = Map([]); m.set(k, 7); m.get(k).unwrap_or(0) }\nfn f() -> Int { wrap(Key::{ a: 1, b: 2 }) }",
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nfn mk2[K : Eq](k : K, j : K) -> Int { let m : Map[K, Int] = Map([]); m.set(k, 1); m.set(j, 2); m.length() }\nfn f() -> Int { mk2(Color::Red, Color::Green) }",
    // Opus P1: generic struct and generic enum payload containing Map[K, Int] instantiated with custom-Eq Color
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nstruct Bag[K] { m : Map[K, Int] }\nfn add[K](b : Bag[K], k : K) -> Unit { b.m.set(k, 1) }\nfn f() -> Int { let b : Bag[Color] = Bag::{ m: Map([]) }; add(b, Color::Red); b.m.length() }",
    "enum Color { Red; Green }\nimpl Eq for Color { fn equal(a : Color, b : Color) -> Bool { true } }\nenum Holder[K] { One(Map[K, Int]); Empty }\nfn f() -> Holder[Color] { Holder::One(Map([])) }",
    // Astra P1-1: nested generic forwarding via[T](a : Box[T]) -> put(a) must preserve outer Box[T]
    "struct Box[T] { v : T }\nimpl[T : Eq] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { a.v == b.v } }\nfn put[K](k : K) -> Int { let m : Map[K, Int] = Map([]); m.set(k, 1); m.length() }\nfn via[T](a : Box[T]) -> Int { put(a) }\nfn f() -> Int { via(Box::{ v: 1 }) }",
  ]
  let mut mbi = 0
  while mbi < map_bad_cases.length() {
    let (ok_mb, j_mb, _) = check_one(map_bad_cases[mbi])
    assert_true(!ok_mb && j_mb.contains("\"code\":\"E_MAP_KEY_TYPE\""), "map_bad[" + mbi.to_string() + "]: " + j_mb)
    mbi = mbi + 1
  }

  // Astra P1-3: phantom type parameter in POD struct Map key must NOT be falsely rejected
  let (ok_phantom, j_phantom, _) = check_one(
    "struct Tag[T] { id : Int }\nfn look[T](k : Tag[T]) -> Int { let m : Map[Tag[T], Int] = Map([]); m.set(k, 1); m.length() }\nfn f() -> Int { let t : Tag[String] = Tag::{ id: 7 }; look(t) }",
  )
  assert_true(ok_phantom, "phantom type parameter POD Map key must pass: " + j_phantom)

  // Astra cap-1: 65 distinct Map key obligations in one generic fn must NOT truncate the 65th
  let sb65 = StringBuilder::new()
  sb65.write_string("struct K65 { id : Int }\nimpl Eq for K65 { fn equal(a : K65, b : K65) -> Bool { a.id == b.id } }\n")
  let mut t65 = 0
  while t65 < 64 {
    sb65.write_string("struct Tag" + t65.to_string() + "[T] { id : Int }\n")
    t65 = t65 + 1
  }
  sb65.write_string("fn many[T](k : T) -> Int {\n")
  t65 = 0
  while t65 < 64 {
    sb65.write_string("  let m" + t65.to_string() + " : Map[Tag" + t65.to_string() + "[T], Int] = Map([])\n")
    t65 = t65 + 1
  }
  sb65.write_string("  let bad : Map[T, Int] = Map([])\n  bad.set(k, 1)\n  bad.length()\n}\nfn f() -> Int { many(K65::{ id: 1 }) }\n")
  let (ok_65, j_65, _) = check_one(sb65.to_string())
  assert_true(!ok_65 && j_65.contains("\"code\":\"E_MAP_KEY_TYPE\""), "65th Map key obligation must not be truncated: " + j_65)

  // Astra cap-2: 26-layer acyclic generic wrapper around Bag[T] in enum payload must NOT be silently skipped
  let sb26 = StringBuilder::new()
  sb26.write_string("struct K26 { id : Int }\nimpl Eq for K26 { fn equal(a : K26, b : K26) -> Bool { a.id == b.id } }\nstruct Bag26[T] { m : Map[T, Int] }\n")
  sb26.write_string("struct W0[T] { v : Bag26[T] }\n")
  let mut w26 = 1
  while w26 < 26 {
    sb26.write_string("struct W" + w26.to_string() + "[T] { v : W" + (w26 - 1).to_string() + "[T] }\n")
    w26 = w26 + 1
  }
  sb26.write_string("enum Load26[T] { One(W25[T]); Empty }\nfn f() -> Load26[K26] { Load26::Empty }\n")
  let (ok_26, j_26, _) = check_one(sb26.to_string())
  assert_true(!ok_26 && j_26.contains("\"code\":\"E_MAP_KEY_TYPE\""), "26-layer acyclic wrapper around Map[T, Int] must emit E_MAP_KEY_TYPE: " + j_26)

  // Astra size-1: 10-layer same-name wrapper W[W[...Box[T]...]] must still enforce leaf Mark bound
  let (ok_w10, j_w10, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\n#derive(Eq)\nstruct W[T] { v : T }\nfn cmp[T](a : W[W[W[W[W[W[W[W[W[W[Box[T]]]]]]]]]]]) -> Bool { a == a }\nfn f() -> Bool { cmp(W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: W::{ v: Box::{ v: 1 } } } } } } } } } } }) }",
  )
  assert_true(!ok_w10 && j_w10.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "10-layer same-name wrapper W must enforce leaf Mark bound: " + j_w10)

  // Astra size-2: 9-param finite permutation recursion Ring[A..I] must pass without false E_MAP_KEY_TYPE
  let (ok_ring9, j_ring9, _) = check_one(
    "enum Ring[A, B, C, D, E, F, G, H, I] { Empty; More(Ring[B, C, D, E, F, G, H, I, A]); Data(Map[Int, Int]) }\nfn f() -> Ring[Int, String, Bool, Char, Byte, Int64, UInt, UInt64, Int8] { Ring::Empty }",
  )
  assert_true(ok_ring9, "9-param finite permutation Ring must pass: " + j_ring9)

  // Astra exact-1: acyclic finite growth via phantom P in W[A, P] must still reach leaf Box[Int] Mark bound
  let (ok_fg, j_fg, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\n#derive(Eq)\nstruct W[A, P] { v : A }\n#derive(Eq)\nstruct Step3[T, P] { v : W[Box[T], Array[P]] }\n#derive(Eq)\nstruct Step2[T, P] { v : W[Step3[T, Array[P]], Array[P]] }\n#derive(Eq)\nstruct Step1[T, P] { v : W[Step2[T, Array[P]], Array[P]] }\n#derive(Eq)\nstruct Step0[T, P] { v : W[Step1[T, Array[P]], Array[P]] }\nfn cmp[T](a : Step0[T, Int]) -> Bool { a == a }\nfn f() -> Bool { cmp(Step0::{ v: W::{ v: Step1::{ v: W::{ v: Step2::{ v: W::{ v: Step3::{ v: W::{ v: Box::{ v: 1 } } } } } } } } }) }",
  )
  assert_true(!ok_fg && j_fg.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "acyclic finite growth must enforce leaf Mark bound: " + j_fg)

  // Astra exact-2: finite shift Ring[A,B,C,D,E] -> Ring[Array[B],Array[C],Array[D],Array[E],Int] must pass
  let (ok_shift, j_shift, _) = check_one(
    "enum RingS[A, B, C, D, E] { Empty; More(RingS[Array[B], Array[C], Array[D], Array[E], Int]); Data(Map[Int, Int]) }\nfn f() -> RingS[Int, Int, Int, Int, Int] { RingS::Empty }",
  )
  assert_true(ok_shift, "finite shift RingS must pass without false E_MAP_KEY_TYPE: " + j_shift)

  // Astra exact-3: truly expansive polymorphic recursion with parameterized Map key must fail closed
  let (ok_exp_map, j_exp_map, _) = check_one(
    "enum ExpBad[T] { Empty; More(ExpBad[(T, T)]); Data(Map[T, Int]) }\nfn f() -> ExpBad[Int] { ExpBad::Empty }",
  )
  assert_true(!ok_exp_map && j_exp_map.contains("\"code\":\"E_MAP_KEY_TYPE\""), "expansive recursion with Map[T, Int] must emit E_MAP_KEY_TYPE: " + j_exp_map)

  // Astra exact-4: custom impl Eq on expansive Grow[T] must not truncate nested Grow[Grow[Box[T]]] Mark obligation
  let (ok_grow_box, j_grow_box, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nenum Grow[T] { Empty; Next(Grow[Array[T]]) }\nimpl[T : Eq] Eq for Grow[T] { fn equal(a : Grow[T], b : Grow[T]) -> Bool { true } }\nfn cmp[T](a : Grow[Grow[Box[T]]]) -> Bool { a == a }\nfn f() -> Bool { let x : Grow[Grow[Box[Int]]] = Grow::Empty; cmp(x) }",
  )
  assert_true(!ok_grow_box && j_grow_box.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "Grow[Grow[Box[T]]] must enforce leaf Mark bound: " + j_grow_box)

  // Astra exact-5: expansive E[T] with Data(Bag[Int]) must pass (K=Int concrete), while Data(Bag[T]) must emit E_MAP_KEY_TYPE
  let (ok_ebag_int, j_ebag_int, _) = check_one(
    "struct Bag[K] { m : Map[K, Int] }\nenum E[T] { End; More(E[Array[T]]); Data(Bag[Int]) }\nfn f() -> E[Int] { E::End }",
  )
  assert_true(ok_ebag_int, "expansive E[T] with concrete Bag[Int] must pass: " + j_ebag_int)
  let (ok_ebag_t, j_ebag_t, _) = check_one(
    "struct Bag[K] { m : Map[K, Int] }\nenum E[T] { End; More(E[Array[T]]); Data(Bag[T]) }\nfn f() -> E[Int] { E::End }",
  )
  assert_true(!ok_ebag_t && j_ebag_t.contains("\"code\":\"E_MAP_KEY_TYPE\""), "expansive E[T] with parameterized Bag[T] must emit E_MAP_KEY_TYPE: " + j_ebag_t)

  // Astra param-1: per-parameter expansive_params: E[T, K] with More(E[Array[T], Int]) + Data(Bag[K]) passes for E[Int, Int],
  // while More(E[Array[T], BadK]) + Data(Bag[K]) emits E_MAP_KEY_TYPE, and More(E[Array[T], T]) + Data(Bag[K]) emits E_MAP_KEY_TYPE
  let (ok_eparam_ok, j_eparam_ok, _) = check_one(
    "struct Bag[K] { m : Map[K, Int] }\nenum E[T, K] { Empty; More(E[Array[T], Int]); Data(Bag[K]) }\nfn f() -> E[Int, Int] { E::Empty }",
  )
  assert_true(ok_eparam_ok, "non-expansive param K=Int in E[T, K] must pass: " + j_eparam_ok)
  let (ok_eparam_badk, j_eparam_badk, _) = check_one(
    "struct BadK { x : Int }\nimpl Eq for BadK { fn equal(a : BadK, b : BadK) -> Bool { a.x == b.x } }\nstruct Bag[K] { m : Map[K, Int] }\nenum E[T, K] { Empty; More(E[Array[T], BadK]); Data(Bag[K]) }\nfn f() -> E[Int, Int] { E::Empty }",
  )
  assert_true(!ok_eparam_badk && j_eparam_badk.contains("\"code\":\"E_MAP_KEY_TYPE\""), "non-expansive param K reset to BadK in E[T, K] must emit E_MAP_KEY_TYPE: " + j_eparam_badk)
  let (ok_eparam_flow, j_eparam_flow, _) = check_one(
    "struct Bag[K] { m : Map[K, Int] }\nenum E[T, K] { Empty; More(E[Array[T], T]); Data(Bag[K]) }\nfn f() -> E[Int, Int] { E::Empty }",
  )
  assert_true(!ok_eparam_flow && j_eparam_flow.contains("\"code\":\"E_MAP_KEY_TYPE\""), "downstream expansive param K fed from T in E[T, K] must emit E_MAP_KEY_TYPE: " + j_eparam_flow)

  // Astra param-2: strictly shrinking path through expansive Grow[Grow[Box[Int]]] via Val(T) must not truncate leaf Mark bound
  let (ok_grow_shrink, j_grow_shrink, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nstruct Phantom[T] { id : Int }\nimpl[T] Eq for Phantom[T] { fn equal(a : Phantom[T], b : Phantom[T]) -> Bool { a.id == b.id } }\n#derive(Eq)\nenum Grow[T] { Empty; Val(T); Next(Phantom[Grow[Array[T]]]) }\nfn cmp[T](a : Grow[Grow[Box[T]]]) -> Bool { a == a }\nfn f() -> Bool { let x : Grow[Grow[Box[Int]]] = Grow::Empty; cmp(x) }",
  )
  assert_true(!ok_grow_shrink && j_grow_shrink.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "strictly shrinking path in Grow[Grow[Box[Int]]] must enforce leaf Mark bound: " + j_grow_shrink)

  // Astra R2-1: unused expansive N[U] referencing finite G[A, B] must NOT pollute G into expansive_defs
  let (ok_r2_nollute, j_r2_nollute, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\n#derive(Eq)\nenum G[A, B] { Empty; Val(A); Flip(G[B, A]) }\nenum N[U] { End; More(N[Array[U]]); Exit(G[U, Int]) }\nfn cmp[T](a : G[Int, Box[T]]) -> Bool { a == a }\nfn f() -> Bool { let x : G[Int, Box[Int]] = G::Empty; cmp(x) }",
  )
  assert_true(!ok_r2_nollute && j_r2_nollute.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "unused expansive N[U] must not pollute finite G[A, B]: " + j_r2_nollute)

  // Astra R2-2: phantom type param in Map[Key[T], Int] inside expansive E[T] must pass, while Map[Wrap[T], Int] must emit E_MAP_KEY_TYPE
  let (ok_r2_phkey, j_r2_phkey, _) = check_one(
    "struct Key[T] { tag : Int }\nenum E[T] { Empty; Next(E[Array[T]]); Data(Map[Key[T], Int]) }\nfn f() -> E[Int] { E::Empty }",
  )
  assert_true(ok_r2_phkey, "phantom Key[T] in Map key inside expansive E[T] must pass: " + j_r2_phkey)
  let (ok_r2_wrapkey, j_r2_wrapkey, _) = check_one(
    "struct Wrap[T] { v : T }\nenum E[T] { Empty; Next(E[Array[T]]); Data(Map[Wrap[T], Int]) }\nfn f() -> E[Int] { E::Empty }",
  )
  assert_true(!ok_r2_wrapkey && j_r2_wrapkey.contains("\"code\":\"E_MAP_KEY_TYPE\""), "non-phantom Wrap[T] in Map key inside expansive E[T] must emit E_MAP_KEY_TYPE: " + j_r2_wrapkey)

  // Astra R2-final: Eq-graph-aligned collect_eq_trait_obligations_rec must never truncate finite Flip/Next behind Phantom/Phantom2
  let (ok_r2f_1, j_r2f_1, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nstruct Phantom[T] { id : Int }\nimpl[T] Eq for Phantom[T] { fn equal(a : Phantom[T], b : Phantom[T]) -> Bool { a.id == b.id } }\n#derive(Eq)\nenum G[A, B] { Empty; Val(A); Flip(G[B, A]); Next(Phantom[G[Array[A], B]]) }\nfn cmp[T](a : G[Int, Box[T]]) -> Bool { a == a }\nfn f() -> Bool { let x : G[Int, Box[Int]] = G::Flip(G::Val(Box::{ v: 7 })); cmp(x) }",
  )
  assert_true(!ok_r2f_1 && j_r2f_1.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "G[Int, Box[Int]] with Flip(G[B, A]) + Next(Phantom[...]) must enforce Mark: " + j_r2f_1)
  let (ok_r2f_1_ok, j_r2f_1_ok, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nimpl Mark for Int { fn ok(self : Int) -> Bool { true } }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nstruct Phantom[T] { id : Int }\nimpl[T] Eq for Phantom[T] { fn equal(a : Phantom[T], b : Phantom[T]) -> Bool { a.id == b.id } }\n#derive(Eq)\nenum G[A, B] { Empty; Val(A); Flip(G[B, A]); Next(Phantom[G[Array[A], B]]) }\nfn cmp[T](a : G[Int, Box[T]]) -> Bool { a == a }\nfn f() -> Bool { let x : G[Int, Box[Int]] = G::Flip(G::Val(Box::{ v: 7 })); cmp(x) }",
  )
  assert_true(ok_r2f_1_ok, "G[Int, Box[Int]] with impl Mark for Int must pass: " + j_r2f_1_ok)
  let (ok_r2f_2, j_r2f_2, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nstruct Phantom[T] { id : Int }\nimpl[T] Eq for Phantom[T] { fn equal(a : Phantom[T], b : Phantom[T]) -> Bool { a.id == b.id } }\n#derive(Eq)\nenum G[A, B] { Empty; Val(A); Flip(G[B, Option[Int]]); Next(Phantom[G[Array[A], Array[B]]]) }\nfn cmp[T](a : G[Int, Box[T]]) -> Bool { a == a }\nfn f() -> Bool { let x : G[Int, Box[Int]] = G::Flip(G::Val(Box::{ v: 7 })); cmp(x) }",
  )
  assert_true(!ok_r2f_2 && j_r2f_2.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "G[Int, Box[Int]] with Flip(G[B, Option[Int]]) + Next(Phantom[...]) must enforce Mark: " + j_r2f_2)
  let (ok_r2f_3, j_r2f_3, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\n#derive(Eq)\nstruct Phantom2[T] { id : Int }\n#derive(Eq)\nenum G[A, B] { Empty; Val(A); Flip(G[B, A]); Next(Phantom2[G[Array[A], B]]) }\nfn cmp[T](a : G[Int, Box[T]]) -> Bool { a == a }\nfn f() -> Bool { let x : G[Int, Box[Int]] = G::Flip(G::Val(Box::{ v: 7 })); cmp(x) }",
  )
  assert_true(!ok_r2f_3 && j_r2f_3.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "G[Int, Box[Int]] with #derive(Eq) Phantom2[T] must enforce Mark: " + j_r2f_3)

  // Astra R2-cycle: cyclic wrapper Box[R[T]] in Map key must terminate cleanly (active+memo+hit_cycle),
  // phantom wrapper Ph[R2[T]] must terminate and pass, and mutually recursive sibling args Outer[A[T], B[T]] must emit E_MAP_KEY_TYPE
  let (ok_r2c_1, j_r2c_1, _) = check_one(
    "struct Box[X] { v : X }\nenum R[T] { Empty; Wrap(Box[R[T]]) }\nenum E[T] { Empty; Next(E[Array[T]]); Data(Map[R[T], Int]) }\nfn f() -> E[Int] { E::Empty }",
  )
  assert_true(!ok_r2c_1 && j_r2c_1.contains("\"code\":\"E_MAP_KEY_TYPE\""), "cyclic wrapper Box[R[T]] in Map key must terminate and emit E_MAP_KEY_TYPE: " + j_r2c_1)
  let (ok_r2c_2, j_r2c_2, _) = check_one(
    "struct Ph[X] { tag : Int }\nenum R2[T] { Empty; Wrap(Ph[R2[T]]) }\nenum E2[T] { Empty; Next(E2[Array[T]]); Data(Map[Ph[R2[T]], Int]) }\nfn f() -> E2[Int] { E2::Empty }",
  )
  assert_true(ok_r2c_2, "phantom wrapper Ph[R2[T]] in Map key must terminate and pass: " + j_r2c_2)
  let (ok_r2c_3, j_r2c_3, _) = check_one(
    "enum A[T] { F1(B[T]); F2(T) }\nenum B[T] { G(A[T]) }\nstruct Outer[X, Y] { y : Y }\nenum E3[T] { Empty; Next(E3[Array[T]]); Data(Map[Outer[A[T], B[T]], Int]) }\nfn f() -> E3[Int] { E3::Empty }",
  )
  assert_true(!ok_r2c_3 && j_r2c_3.contains("\"code\":\"E_MAP_KEY_TYPE\""), "mutually recursive sibling args Outer[A[T], B[T]] must emit E_MAP_KEY_TYPE: " + j_r2c_3)

  // P1-2: Generic forwarding must preserve user trait bounds on `impl[T : Mark] Eq for Box[T]`
  let (ok_tr_fwd, j_tr_fwd, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nfn wrap[T](k : Box[T]) -> Bool { k == k }\nfn f() -> Bool { wrap(Box::{ v: 1 }) }",
  )
  assert_true(!ok_tr_fwd && j_tr_fwd.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "generic forwarding lost Mark bound: " + j_tr_fwd)

  // Astra P1-2: Generic forwarding through compound type `Box[Shell[T]]` must still enforce `Mark` on `Shell[Int]`
  let (ok_tr_shell, j_tr_shell, _) = check_one(
    "trait Mark { fn ok(self : Self) -> Bool }\nstruct Box[T] { v : T }\nimpl[T : Mark] Eq for Box[T] { fn equal(a : Box[T], b : Box[T]) -> Bool { true } }\nstruct Shell[T] { v : T }\nfn cmp[T](a : Box[T]) -> Bool { a == a }\nfn via[T](a : Box[Shell[T]]) -> Bool { cmp(a) }\nfn f() -> Bool { via(Box::{ v: Shell::{ v: 1 } }) }",
  )
  assert_true(!ok_tr_shell && j_tr_shell.contains("\"code\":\"E_TRAIT_NOT_IMPLEMENTED\""), "compound generic forwarding lost Mark bound on Shell: " + j_tr_shell)

  // P1-3: Explicit `#verify impl Eq` must be rejected with E_VERIFY_UNSUPPORTED
  let (ok_v_impl, j_v_impl, _) = check_one(
    "struct K { id : Int }\n#verify\nimpl Eq for K { fn equal(a : K, b : K) -> Bool { a.id == b.id } }",
  )
  assert_true(!ok_v_impl && j_v_impl.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "#verify impl Eq must be rejected: " + j_v_impl)

  // 4. .pionsig roundtrip for generic impl Eq
  let sig_text = emit_pionsig(ok_basic.pkg)
  assert_true(sig_text.contains("impl[A, B : Eq] Eq for Pair[A, B]"), sig_text)
  match parse_pionsig(sig_text) {
    Ok(psig) => assert_true(psig.entries.length() > 0, "parsed pionsig entries")
    Err(e) => assert_true(false, "parse_pionsig failed: " + e)
  }

  // 5. #verify rejects custom impl Eq directly, via #derive(Eq) wrapper, via .contains, via generic forwarding, and cross-package
  let v_bad_cases : Array[String] = [
    "struct K { x : Int }\nimpl Eq for K { fn equal(a : K, b : K) -> Bool { a.x == b.x } }\n#verify\nfn f(a : K, b : K) -> Bool { a == b }",
    "struct K { x : Int }\nimpl Eq for K { fn equal(a : K, b : K) -> Bool { a.x == b.x } }\n#derive(Eq)\nstruct W { k : K }\n#verify\nfn f(a : W, b : W) -> Bool { a == b }",
    "struct K { x : Int }\nimpl Eq for K { fn equal(a : K, b : K) -> Bool { a.x == b.x } }\n#verify\nfn f(xs : Array[K], k : K) -> Bool { xs.contains(k) }",
    "struct K { x : Int }\nimpl Eq for K { fn equal(a : K, b : K) -> Bool { a.x == b.x } }\n#verify\nfn g[T : Eq](a : T, b : T) -> Bool { a == b }\n#verify\nfn f(a : K, b : K) -> Bool { g(a, b) }",
  ]
  let mut vi = 0
  while vi < v_bad_cases.length() {
    let (ok_v, j_v, _) = check_one(v_bad_cases[vi])
    assert_true(!ok_v && j_v.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), "v_bad[" + vi.to_string() + "]: " + j_v)
    vi = vi + 1
  }
  let v_xpkg = check_source_files_with_imports(
    "app_vxpkg",
    ["app.pion"],
    [
      #|import "dep_beq2"
      #|#verify
      #|pub fn f(a : dep_beq2::K, b : dep_beq2::K) -> Bool { a == b }
    ],
    [imported_pkg_new("dep_beq2", dep_eq.tc)],
    true,
  )
  let v_xpkg_j = check_result_to_json(v_xpkg.diagnostics)
  assert_true(v_xpkg.diagnostics.length() > 0 && v_xpkg_j.contains("\"code\":\"E_VERIFY_UNSUPPORTED\""), v_xpkg_j)
}

///|
test "break / continue outside a loop body are rejected; init / bounds / iterables use the enclosing loop" {
  let bad : Array[(String, String)] = [
    ("pub fn f(x : Int) -> Int {\n  if x > 0 { break }\n  x\n}\n", "break"),
    ("pub fn f(x : Int) -> Int {\n  if x > 0 { continue }\n  x\n}\n", "continue"),
    // Outermost `while` condition, C-style `for` condition and step.
    (
      "pub fn f(n : Int) -> Int {\n  let mut j = 0\n  while j != (if j > n { break } else { 100 }) {\n    j = j + 1\n  }\n  j\n}\n",
      "break",
    ),
    (
      "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  for i = 0; (if i > n { continue } else { i < 9 }); i = i + 1 {\n    s = s + i\n  }\n  s\n}\n",
      "continue",
    ),
    (
      "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  for i = 0; i < 9; (if i > n { break } else { i = i + 1 }) {\n    s = s + i\n  }\n  s\n}\n",
      "break",
    ),
    // Outermost `for x in` iterable: no enclosing loop.
    (
      "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for x in (if xs.length() > 3 { break } else { xs }) {\n    s = s + x\n  }\n  s\n}\n",
      "break",
    ),
    // Nested `while` condition, nested `for` condition and step.
    (
      "pub fn f(n : Int) -> Int {\n  let mut i = 0\n  while i < n {\n    i = i + 1\n    let mut j = 0\n    while j != (if j > i { break } else { 9 }) {\n      j = j + 1\n    }\n  }\n  i\n}\n",
      "break",
    ),
    (
      "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  for k in 0..<n {\n    for i = 0; (if i > k { continue } else { i < 3 }); i = i + 1 {\n      s = s + i\n    }\n  }\n  s\n}\n",
      "continue",
    ),
    (
      "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  for k in 0..<n {\n    for i = 0; i < 3; (if i > k { continue } else { i = i + 1 }) {\n      s = s + i\n    }\n  }\n  s\n}\n",
      "continue",
    ),
    // A closure inside a loop does not reach that loop.
    (
      "pub fn f(n : Int) -> Int {\n  let mut i = 0\n  while i < n {\n    let g = fn(y : Int) -> Int {\n      if y > 2 { break }\n      y\n    }\n    i = i + g(i) + 1\n  }\n  i\n}\n",
      "break",
    ),
  ]
  let mut i = 0
  while i < bad.length() {
    let (src, kw) = bad[i]
    let (ok, json, diags) = check_one(src)
    assert_eq(ok, false)
    assert_true(
      diags.length() == 1 && diags[0].code == "E_TYPE_MISMATCH" &&
      diags[0].message == "cannot use `" + kw + "` outside a loop",
      "case #" + i.to_string() + ": " + json,
    )
    i = i + 1
  }
  // A C-style `for` `init`, range bounds and the iterable run in the
  // enclosing loop body; a loop nested inside a condition has its own body.
  let good : Array[String] = [
    "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  for k in 0..<n {\n    for i = (if k == 2 { continue } else { 0 }); i < 3; i = i + 1 {\n      s = s + i\n    }\n  }\n  s\n}\n",
    "pub fn f(n : Int) -> Int {\n  let mut s = 0\n  let mut k = 0\n  while k < n {\n    k = k + 1\n    for i in 0..<(if k > 3 { break } else { k }) {\n      s = s + i\n    }\n  }\n  s\n}\n",
    "pub fn f(xs : Array[Int]) -> Int {\n  let mut s = 0\n  for k in 0..<3 {\n    for x in (if k == 1 { continue } else { xs }) {\n      s = s + x\n    }\n  }\n  s\n}\n",
    "pub fn f(n : Int) -> Int {\n  let mut j = 0\n  while j < ({\n    let mut m = 0\n    while true {\n      if m >= n { break }\n      m = m + 1\n    }\n    m\n  }) {\n    j = j + 1\n  }\n  j\n}\n",
  ]
  let mut gi = 0
  while gi < good.length() {
    let (ok, json, _) = check_one(good[gi])
    assert_true(ok, "good case #" + gi.to_string() + ": " + json)
    gi = gi + 1
  }
  // A `break` in a nested `for` `init` leaves the `while true` around it, so
  // the guard can fall through; with only a `return` in the body it cannot.
  let (ok_g, json_g, diags_g) = check_one(
    "pub fn f(flag : Bool, c : Bool) -> Int {\n  guard flag else {\n    while true {\n      for i = (if c { break } else { 0 }); i < 1; i = i + 1 {\n        let _ = i\n      }\n    }\n  }\n  1\n}\n",
  )
  assert_eq(ok_g, false)
  assert_true(diags_g.length() == 1 && diags_g[0].code == "E_GUARD_ELSE_NOT_DIVERGE", json_g)
  let (ok_r, json_r, _) = check_one(
    "pub fn f(flag : Bool) -> Int {\n  guard flag else {\n    while true {\n      for i = 0; i < 1; i = i + 1 {\n        return 0\n      }\n    }\n  }\n  1\n}\n",
  )
  assert_true(ok_r, json_r)
}

///|
test "p134_unresolved_symbol_preserves_frontend_diag" {
  let (ok, json, diags) = check_one(
    "pub fn f() -> Int {\n  missing_fn() + NoSuchPkg::missing_val\n}\n",
  )
  assert_eq(ok, false)
  assert_true(diags.length() >= 1, json)
}

///|
test "extern_c_fn_first_class_value_checks" {
  // 1. Local extern "C" fn as first-class value + inside closure + passed to HOF
  let (ok_local, json_local, _) = check_one(
    "extern \"C\" fn c_add(a : Int, b : Int) -> Int = \"my_c_add\"\n" +
    "extern \"C\" fn c_void(x : Int) -> Unit = \"my_c_void\"\n" +
    "fn apply2(f : (Int, Int) -> Int, a : Int, b : Int) -> Int { f(a, b) }\n" +
    "pub fn run(k : Int) -> Int {\n" +
    "  let f : (Int, Int) -> Int = c_add\n" +
    "  let v : (Int) -> Unit = c_void\n" +
    "  v(k)\n" +
    "  let clo = fn(x : Int) -> Int { apply2(c_add, x, k) }\n" +
    "  f(1, 2) + clo(3)\n" +
    "}\n",
  )
  assert_true(ok_local, json_local)

  // 2. Local variadic extern "C" fn rejected with E_TYPE_MISMATCH
  let (ok_va_local, json_va_local, diags_va_local) = check_one(
    "extern \"C\" fn c_printf(fmt : Ptr, ...) -> Int = \"printf\"\n" +
    "pub fn bad() -> Unit {\n" +
    "  let _ = c_printf\n" +
    "}\n",
  )
  assert_eq(ok_va_local, false)
  assert_true(
    diags_va_local.length() >= 1 && diags_va_local[0].code == "E_TYPE_MISMATCH",
    json_va_local,
  )

  // 3. Cross-package pub extern "C" fn passes, private reports E_PRIVATE_SYMBOL, variadic reports E_TYPE_MISMATCH
  let lib_src =
    "pub extern \"C\" fn pub_ext(x : Double) -> Double = \"c_pub_ext\"\n" +
    "extern \"C\" fn priv_ext(x : Int) -> Int = \"c_priv_ext\"\n" +
    "pub extern \"C\" fn pub_va(x : Int, ...) -> Int = \"c_pub_va\"\n"
  let lib_cr = check_source_files_with_imports("clib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))

  let ok_app_src =
    "import \"clib\" as c\n" +
    "fn apply1(f : (Double) -> Double, x : Double) -> Double { f(x) }\n" +
    "pub fn main() -> Double {\n" +
    "  let g : (Double) -> Double = c::pub_ext\n" +
    "  apply1(c::pub_ext, g(2.0))\n" +
    "}\n"
  let ok_app_cr = check_source_files_with_imports(
    "app_ok",
    ["app.pion"],
    [ok_app_src],
    [imported_pkg_new("clib", lib_cr.tc)],
    true,
  )
  assert_true(ok_app_cr.diagnostics.length() == 0, check_result_to_json(ok_app_cr.diagnostics))

  let priv_app_src =
    "import \"clib\" as c\n" +
    "pub fn main() -> (Int) -> Int { c::priv_ext }\n"
  let priv_app_cr = check_source_files_with_imports(
    "app_priv",
    ["app.pion"],
    [priv_app_src],
    [imported_pkg_new("clib", lib_cr.tc)],
    true,
  )
  assert_true(
    priv_app_cr.diagnostics.length() >= 1 && priv_app_cr.diagnostics[0].code == "E_PRIVATE_SYMBOL",
    check_result_to_json(priv_app_cr.diagnostics),
  )

  let va_app_src =
    "import \"clib\" as c\n" +
    "pub fn main() -> Unit {\n" +
    "  let _ = c::pub_va\n" +
    "}\n"
  let va_app_cr = check_source_files_with_imports(
    "app_va",
    ["app.pion"],
    [va_app_src],
    [imported_pkg_new("clib", lib_cr.tc)],
    true,
  )
  assert_true(
    va_app_cr.diagnostics.length() >= 1 && va_app_cr.diagnostics[0].code == "E_TYPE_MISMATCH",
    check_result_to_json(va_app_cr.diagnostics),
  )

  // 4. Three-package default argument referencing a third-party `extern "C" fn` value
  //    via alias `e` must rewrite to `@canon:clib::pub_ext` even when caller has a conflicting alias `e`.
  let mid_src =
    "import \"clib\" as e\n" +
    "pub fn run_def(x : Double, f : (Double) -> Double = e::pub_ext) -> Double { f(x) }\n"
  let mid_cr = check_source_files_with_imports(
    "mid",
    ["mid.pion"],
    [mid_src],
    [imported_pkg_new("clib", lib_cr.tc)],
    true,
  )
  assert_true(mid_cr.diagnostics.length() == 0, check_result_to_json(mid_cr.diagnostics))

  let decoy_src = "pub fn other() -> Int { 1 }\n"
  let decoy_cr = check_source_files_with_imports("decoy", ["decoy.pion"], [decoy_src], [], true)
  assert_true(decoy_cr.diagnostics.length() == 0, check_result_to_json(decoy_cr.diagnostics))

  let app3_src =
    "import \"mid\"\n" +
    "import \"decoy\" as e\n" +
    "pub fn main() -> Double {\n" +
    "  let _ = e::other()\n" +
    "  mid::run_def(3.0)\n" +
    "}\n"
  let app3_cr = check_source_files_with_imports(
    "app3",
    ["app3.pion"],
    [app3_src],
    [
      imported_pkg_new("clib", lib_cr.tc),
      imported_pkg_new("mid", mid_cr.tc),
      imported_pkg_new("decoy", decoy_cr.tc),
    ],
    true,
  )
  assert_true(app3_cr.diagnostics.length() == 0, check_result_to_json(app3_cr.diagnostics))
}

///|
fn ft_gen_nested_fix_closures(n : Int, ret_ann : Bool, use_method : Bool) -> String {
  let sb = StringBuilder()
  if use_method {
    sb.write_string("struct Box { v : Int }\n")
    sb.write_string("fn Box::fix[T](self : Box, f : (T) -> T) -> T { let _ = self; panic(\"stub\") }\n")
  } else {
    sb.write_string("fn fix[T](f : (T) -> T) -> T { panic(\"stub\") }\n")
  }
  sb.write_string("fn main() -> Unit {\n")
  if use_method {
    sb.write_string("  let b = Box::{ v: 0 }\n")
  }
  let ra = if ret_ann { " -> Int" } else { "" }
  let call_head = if use_method { "b.fix" } else { "fix" }
  let mut i = 0
  while i < n {
    sb.write_string("  let _x" + i.to_string() + " = " + call_head + "(fn(p" + i.to_string() + ")" + ra + " {\n")
    i = i + 1
  }
  sb.write_string("  let _ = p" + (n - 1).to_string() + "; 1\n")
  i = n - 1
  while i >= 0 {
    sb.write_string("  })\n")
    if i > 0 {
      sb.write_string("  let _ = _x" + i.to_string() + "; 1\n")
    }
    i = i - 1
  }
  sb.write_string("}\n")
  sb.to_string()
}

///|
fn ft_gen_nested_fix_closures_cap(n : Int, alias_chain : Bool, use_method : Bool) -> String {
  let sb = StringBuilder()
  if use_method {
    sb.write_string("struct Box { v : Int }\n")
    sb.write_string("fn Box::fix[T](self : Box, f : (T) -> T) -> T { let _ = self; panic(\"stub\") }\n")
  } else {
    sb.write_string("fn fix[T](f : (T) -> T) -> T { panic(\"stub\") }\n")
  }
  sb.write_string("fn main() -> Unit {\n")
  if use_method {
    sb.write_string("  let b = Box::{ v: 0 }\n")
  }
  let call_head = if use_method { "b.fix" } else { "fix" }
  let mut i = 0
  while i < n {
    sb.write_string("  let _x" + i.to_string() + " = " + call_head + "(fn(p" + i.to_string() + ") {\n")
    if i > 0 {
      if alias_chain {
        sb.write_string("    let y" + i.to_string() + " = y" + (i - 1).to_string() + "\n")
        sb.write_string("    let _ = y" + i.to_string() + "\n")
      } else {
        sb.write_string("    let _ = p" + (i - 1).to_string() + "\n")
      }
    } else if alias_chain {
      sb.write_string("    let y0 = p0\n")
      sb.write_string("    let _ = y0\n")
    }
    i = i + 1
  }
  sb.write_string("  let _ = p" + (n - 1).to_string() + "; 1\n")
  i = n - 1
  while i >= 0 {
    sb.write_string("  })\n")
    if i > 0 {
      sb.write_string("  let _ = _x" + i.to_string() + "; 1\n")
    }
    i = i - 1
  }
  sb.write_string("}\n")
  sb.to_string()
}

///|
test "issue60_nested_closure_check_cache_linear_and_sound" {
  // 1. Deep nesting (N=20 and N=24) must complete in linear time (would OOM/hang at 2^24 without cache).
  let cr20 = check_source_files("nested20", ["nested20.pion"], [ft_gen_nested_fix_closures(20, false, false)])
  assert_true(cr20.diagnostics.length() == 0, check_result_to_json(cr20.diagnostics))

  let cr24 = check_source_files("nested24", ["nested24.pion"], [ft_gen_nested_fix_closures(24, true, false)])
  assert_true(cr24.diagnostics.length() == 0, check_result_to_json(cr24.diagnostics))

  let cr20_m = check_source_files("nested20m", ["nested20m.pion"], [ft_gen_nested_fix_closures(20, false, true)])
  assert_true(cr20_m.diagnostics.length() == 0, check_result_to_json(cr20_m.diagnostics))

  // 1b. Capturing outer unannotated param `p_{i-1}` (and `let y = p0` alias chain) at N=20 must stay linear.
  let cr20_cap = check_source_files("nested20_cap", ["nested20_cap.pion"], [ft_gen_nested_fix_closures_cap(20, false, false)])
  assert_true(cr20_cap.diagnostics.length() == 0, check_result_to_json(cr20_cap.diagnostics))

  let cr20_alias = check_source_files("nested20_alias", ["nested20_alias.pion"], [ft_gen_nested_fix_closures_cap(20, true, false)])
  assert_true(cr20_alias.diagnostics.length() == 0, check_result_to_json(cr20_alias.diagnostics))

  let cr20_cap_m = check_source_files("nested20_cap_m", ["nested20_cap_m.pion"], [ft_gen_nested_fix_closures_cap(20, false, true)])
  assert_true(cr20_cap_m.diagnostics.length() == 0, check_result_to_json(cr20_cap_m.diagnostics))

  // 1c. Local `let v = []; v.push(1)` resolved inside every nested closure at N=20 must still cache linearly.
  let sb_loc = StringBuilder()
  sb_loc.write_string("fn fix[T](f : (T) -> T) -> T { panic(\"stub\") }\n")
  sb_loc.write_string("fn main() -> Unit {\n")
  let mut li = 0
  while li < 20 {
    sb_loc.write_string("  let _x" + li.to_string() + " = fix(fn(p" + li.to_string() + ") {\n")
    sb_loc.write_string("    let v = []\n")
    sb_loc.write_string("    v.push(1)\n")
    sb_loc.write_string("    let _ = v[0]\n")
    li = li + 1
  }
  sb_loc.write_string("  let _ = p19; 1\n")
  li = 19
  while li >= 0 {
    sb_loc.write_string("  })\n")
    if li > 0 {
      sb_loc.write_string("  let _ = _x" + li.to_string() + "; 1\n")
    }
    li = li - 1
  }
  sb_loc.write_string("}\n")
  let cr20_loc = check_source_files("nested20_local_vec", ["nested20_local_vec.pion"], [sb_loc.to_string()])
  assert_true(cr20_loc.diagnostics.length() == 0, check_result_to_json(cr20_loc.diagnostics))

  // 2. Soundness: inner closure capturing outer unannotated param `p0` (whose type changes
  //    TError -> Int on outer retry) must miss the stale cache entry and re-check with `p0 : Int`.
  let cap_ok_src =
  #|fn fix[T](f : (T) -> T) -> T { panic("stub") }
  #|fn main() -> Unit {
  #|  let _x0 = fix(fn(p0) {
  #|    let _x1 = fix(fn(p1) { let _ = p0 + p1; 1 })
  #|    let _ = _x1
  #|    1
  #|  })
  #|}
  let cr_cap_ok = check_source_files("cap_ok", ["cap_ok.pion"], [cap_ok_src])
  assert_true(cr_cap_ok.diagnostics.length() == 0, check_result_to_json(cr_cap_ok.diagnostics))

  let cap_err_src =
  #|fn fix[T](f : (T) -> T) -> T { panic("stub") }
  #|fn main() -> Unit {
  #|  let _x0 = fix(fn(p0) {
  #|    let _x1 = fix(fn(p1) {
  #|      let _s : String = p0
  #|      let _ = p1
  #|      1
  #|    })
  #|    _x1 + 1
  #|  })
  #|}
  let cr_cap_err = check_source_files("cap_err", ["cap_err.pion"], [cap_err_src])
  assert_true(
    cr_cap_err.diagnostics.length() >= 1 && cr_cap_err.diagnostics[0].code == "E_TYPE_MISMATCH",
    "captured param type mismatch must not be swallowed: " + check_result_to_json(cr_cap_err.diagnostics),
  )

  // 3. Soundness: real diagnostic inside an inner closure must be replayed after outer retry rollback.
  let inner_err_src =
  #|fn fix[T](f : (T) -> T) -> T { panic("stub") }
  #|fn main() -> Unit {
  #|  let _x0 = fix(fn(p0) {
  #|    let _x1 = fix(fn(p1) {
  #|      let _bad : String = 123
  #|      let _ = p1
  #|      1
  #|    })
  #|    let _ = p0
  #|    _x1
  #|  })
  #|}
  let cr_inner_err = check_source_files("inner_err", ["inner_err.pion"], [inner_err_src])
  assert_true(
    cr_inner_err.diagnostics.length() >= 1 && cr_inner_err.diagnostics[0].code == "E_TYPE_MISMATCH",
    "inner closure diagnostic must be replayed on cache hit: " + check_result_to_json(cr_inner_err.diagnostics),
  )

  // 4. Soundness: `Eq` obligation (`tc.eq_uses`) inside an inner closure must be replayed after rollback.
  let eq_err_src =
  #|struct NoEq { x : Int }
  #|fn fix[T](f : (T) -> T) -> T { panic("stub") }
  #|fn main() -> Unit {
  #|  let _x0 = fix(fn(p0) {
  #|    let _x1 = fix(fn(p1) {
  #|      let a = NoEq::{ x: 1 }
  #|      let b = NoEq::{ x: 2 }
  #|      let _ = a == b
  #|      let _ = p1
  #|      1
  #|    })
  #|    let _ = p0
  #|    _x1
  #|  })
  #|}
  let cr_eq_err = check_source_files("eq_err", ["eq_err.pion"], [eq_err_src])
  assert_true(
    cr_eq_err.diagnostics.length() >= 1,
    "inner closure Eq obligation must be replayed on cache hit",
  )

  // 5. Soundness: capturing an unresolved `let arr = []` must bypass cache so element inference works.
  let unres_src =
  #|fn fix[T](f : (T) -> T) -> T { panic("stub") }
  #|fn main() -> Unit {
  #|  let arr = []
  #|  let _x0 = fix(fn(p0) {
  #|    let _x1 = fix(fn(p1) {
  #|      arr.push(1)
  #|      let _ = p1
  #|      1
  #|    })
  #|    let _ = p0
  #|    _x1
  #|  })
  #|  let _v : Int = arr[0]
  #|}
  let cr_unres = check_source_files("unres", ["unres.pion"], [unres_src])
  assert_true(cr_unres.diagnostics.length() == 0, check_result_to_json(cr_unres.diagnostics))
}

///|
test "deferred_infer_eblock_and_generic_call_fail_closed" {
  // 1. EBlock empty array + closure read-before-push
  let eblock_ok =
  #|fn repro_eblock_arr(n : Int) -> Double {
  #|  let adv = { let _ = n; [] }
  #|  let push_one = fn(x : Double) -> Unit {
  #|    if adv.length() > 0 {
  #|      adv[0] = adv[0] + x * 0.125
  #|    }
  #|    adv.push(x)
  #|  }
  #|  push_one(4.0)
  #|  push_one(8.0)
  #|  adv[0]
  #|}
  let cr1 = check_source_files("eblock_ok", ["eblock_ok.pion"], [eblock_ok])
  assert_true(cr1.diagnostics.length() == 0, check_result_to_json(cr1.diagnostics))

  // 2. Unused EBlock empty array must fail with E_MISSING_TYPE
  let eblock_unused =
  #|fn bad_eblock_arr(n : Int) -> Int {
  #|  let adv = { let _ = n; [] }
  #|  adv.length()
  #|}
  let cr2 = check_source_files("eblock_unused", ["eblock_unused.pion"], [eblock_unused])
  assert_true(
    cr2.diagnostics.length() >= 1 && cr2.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unused EBlock empty array, got: " + check_result_to_json(cr2.diagnostics),
  )

  // 3. Deferred generic zero-arg constructor: full inference, trait-bound check, and fail-closed
  let box_defs =
  #|trait KeyTrait {
  #|  fn key_id(self) -> Int
  #|}
  #|impl KeyTrait for Int {
  #|  fn key_id(self) -> Int { self }
  #|}
  #|struct MyBox[K, V] {
  #|  keys : Array[K]
  #|  vals : Array[V]
  #|}
  #|fn make_box[K : KeyTrait, V]() -> MyBox[K, V] {
  #|  MyBox::{ keys: [], vals: [] }
  #|}
  #|fn MyBox::put[K, V](self : MyBox[K, V], k : K, v : V) -> Unit {
  #|  self.keys.push(k)
  #|  self.vals.push(v)
  #|}
  #|fn MyBox::get_opt[K, V](self : MyBox[K, V], k : K) -> Option[V] {
  #|  let _ = k
  #|  if self.vals.length() > 0 { Some(self.vals[0]) } else { None }
  #|}
  #|fn MyBox::set_val[K, V](self : MyBox[K, V], v : V) -> Unit {
  #|  self.vals.push(v)
  #|}
  #|fn MyBox::len[K, V](self : MyBox[K, V]) -> Int {
  #|  self.keys.length()
  #|}
  #|

  // 3a & 3b: full inference, built-in collection 0-arg queries before refinement, and expected-type refinement
  let box_ok = box_defs +
  #|fn test_ok() -> Int {
  #|  let m = make_box()
  #|  m.put(1, "hi")
  #|  let xs = []
  #|  let _ = xs.is_empty()
  #|  xs.push(1)
  #|  let mp = Map()
  #|  let n0 = mp.length()
  #|  mp.set(1, "a")
  #|  let m3 = make_box()
  #|  let _v : Option[String] = m3.get_opt(1)
  #|  m3.put(3, "typed")
  #|  m.len() + n0 + xs.length() + m3.len()
  #|}
  let cr3a = check_source_files("box_ok", ["box_ok.pion"], [box_ok])
  assert_true(cr3a.diagnostics.length() == 0, check_result_to_json(cr3a.diagnostics))

  // Bounded method with unbound V must emit E_MISSING_TYPE (never bypass V : KeyTrait)
  let box_bound_meth = box_defs +
  #|fn MyBox::inspect_val[K, V : KeyTrait](self : MyBox[K, V], k : K) -> Int {
  #|  let _ = k
  #|  if self.vals.length() > 0 { self.vals[0].key_id() } else { 0 }
  #|}
  #|fn test_bound_meth() -> Int {
  #|  let m = make_box()
  #|  let x = m.inspect_val(1)
  #|  m.put(1, "not_a_key")
  #|  x
  #|}
  let cr_bm = check_source_files("box_bm", ["box_bm.pion"], [box_bound_meth])
  let mut saw_bm_err = false
  let mut p0i = 0
  while p0i < cr_bm.diagnostics.length() {
    if cr_bm.diagnostics[p0i].code == "E_MISSING_TYPE" {
      saw_bm_err = true
    }
    p0i = p0i + 1
  }
  assert_true(
    saw_bm_err,
    "expected E_MISSING_TYPE for m.inspect_val(1) with unbound V : KeyTrait, got: " + check_result_to_json(cr_bm.diagnostics),
  )

  // Unannotated get_opt on pending binding must emit E_MISSING_TYPE (never leak Option[TError])
  let box_untyped_ret = box_defs +
  #|fn test_untyped_ret() -> Int {
  #|  let b2 = make_box()
  #|  let empty_v = b2.get_opt(1)
  #|  b2.put(1, "world")
  #|  let bogus : Int = match empty_v {
  #|    Some(s) => s
  #|    None => 0
  #|  }
  #|  bogus
  #|}
  let cr_ur = check_source_files("box_ur", ["box_ur.pion"], [box_untyped_ret])
  let mut saw_ur_err = false
  p0i = 0
  while p0i < cr_ur.diagnostics.length() {
    if cr_ur.diagnostics[p0i].code == "E_MISSING_TYPE" {
      saw_ur_err = true
    }
    p0i = p0i + 1
  }
  assert_true(
    saw_ur_err,
    "expected E_MISSING_TYPE for unannotated b2.get_opt(1), got: " + check_result_to_json(cr_ur.diagnostics),
  )

  // Unrelated free type param U must not be masked by arg xs : Array[T]
  let extra_tp_src = box_defs +
  #|fn drop_with_extra[T, U : KeyTrait](xs : Array[T]) -> Unit {
  #|  let _ = xs.length()
  #|}
  #|fn drop_with_extra_ret[T, U](xs : Array[T]) -> Option[U] {
  #|  let _ = xs.length()
  #|  None
  #|}
  #|fn test_extra_tp() -> Unit {
  #|  let xs : Array[Int] = []
  #|  drop_with_extra(xs)
  #|  let _ = drop_with_extra_ret(xs)
  #|}
  let cr_ext = check_source_files("extra_tp", ["extra_tp.pion"], [extra_tp_src])
  let mut ext_u_errs = 0
  p0i = 0
  while p0i < cr_ext.diagnostics.length() {
    if cr_ext.diagnostics[p0i].code == "E_MISSING_TYPE" &&
      str_contains(cr_ext.diagnostics[p0i].message, "`U`") {
      ext_u_errs = ext_u_errs + 1
    }
    p0i = p0i + 1
  }
  assert_true(
    ext_u_errs == 2,
    "expected 2 E_MISSING_TYPE diagnostics mentioning `U`, got: " + check_result_to_json(cr_ext.diagnostics),
  )

  // Unconstrained phantom type param passes, bounded phantom rejects with E_MISSING_TYPE
  let phantom_ok_src = box_defs +
  #|fn phantom_tp[K](x : Int) -> Int { x + 1 }
  #|fn test_phantom_ok() -> Int { phantom_tp(41) }
  let cr_ph_ok = check_source_files("phantom_ok", ["phantom_ok.pion"], [phantom_ok_src])
  assert_true(cr_ph_ok.diagnostics.length() == 0, check_result_to_json(cr_ph_ok.diagnostics))

  let phantom_bad_src = box_defs +
  #|fn bounded_phantom[K : KeyTrait](x : Int) -> Int { x + 1 }
  #|fn test_phantom_bad() -> Int { bounded_phantom(41) }
  let cr_ph_bad = check_source_files("phantom_bad", ["phantom_bad.pion"], [phantom_bad_src])
  assert_true(
    cr_ph_bad.diagnostics.length() == 1 && cr_ph_bad.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for bounded_phantom, got: " + check_result_to_json(cr_ph_bad.diagnostics),
  )

  // Pending binding must never escape as an untyped value (alias, field, call arg, array elem, closure capture, untyped index)
  let escape_cases : Array[String] = [
    box_defs + "fn f() -> Unit { let m = make_box(); let _m2 = m; m.put(1, 2.5) }",
    box_defs + "fn f() -> Unit { let m = make_box(); let _k0 = m.keys; m.put(1, 2.5) }",
    box_defs + "fn f() -> Unit { let m = make_box(); m.keys.push(\"str\"); m.put(1, 2.5) }",
    box_defs + "fn ident[T](x : T) -> T { x }\nfn f() -> Unit { let m = make_box(); let _m2 = ident(m); m.put(1, 2.5) }",
    box_defs + "fn f() -> Unit { let m = make_box(); let _arr = [m]; m.put(1, 2.5) }",
    "fn f(n : Int) -> Unit { let xs = { let _ = n; [] }; let _ys = xs; xs.push(1) }",
    box_defs + "fn dup[T](x : T) -> (T, T) { (x, x) }\nfn f() -> Unit { let m = make_box(); let _w = dup(m.vals); m.put(1, 2.5) }",
    box_defs + "fn f() -> Unit { let m = make_box(); let _g = fn() -> String { m.keys[0] }; m.put(1, 2.5) }",
    "fn f(n : Int) -> Unit { let adv = { let _ = n; [] }; let _x = adv[0]; adv.push(1.0) }",
    box_defs + "fn MyBox::keys_of[K, V](self : MyBox[K, V]) -> Array[K] { self.keys }\nfn f() -> Unit { let m = make_box(); let k0 = m.keys_of(); k0.push(\"x\"); m.put(1, 2.5) }",
    box_defs + "fn MyBox::me[K, V](self : MyBox[K, V]) -> MyBox[K, V] { self }\nfn f() -> Unit { let m = make_box(); let m2 = m.me(); m2.put(\"s\", 1); m.put(1, 2.5) }",
    box_defs + "fn MyBox::vals_of[K, V](self : MyBox[K, V]) -> Array[V] { self.vals }\nfn f() -> Unit { let m = make_box(); let v0 = m.vals_of(); m.put(1, 2.5); let _s : String = v0[0] }",
    box_defs + "fn MyBox::add_key[K, V](self : MyBox[K, V], k : K) -> Unit { self.keys.push(k) }\nfn f() -> Unit { let m = make_box(); m.add_key(\"s\"); m.put(1, 2.5) }",
    box_defs + "impl KeyTrait for String { fn key_id(self) -> Int { self.length() } }\nfn MyBox::keys_of[K, V](self : MyBox[K, V]) -> Array[K] { self.keys }\nfn f() -> Unit { let m = make_box(); let _k : Array[Int] = m.keys_of(); m.put(\"hello\", 1.5) }",
    box_defs + "fn MyBox::vals_of[K, V](self : MyBox[K, V]) -> Array[V] { self.vals }\nfn f() -> Unit { let m = make_box(); let _v : Array[String] = m.vals_of(); m.put(1, 2.5) }",
    box_defs + "fn f() -> Unit { let m = make_box(); let _ = m.len(); m.put(1, 2.5) }",
    "fn f() -> Unit { let m = Map(); m[1] = None; m.set(\"a\", Some(1)) }",
    "fn f() -> Unit { let adv = []; adv[0] = None; adv.push(1.0) }",
  ]
  let mut eci = 0
  while eci < escape_cases.length() {
    let cr_esc = check_source_files("esc_" + eci.to_string(), ["esc.pion"], [escape_cases[eci]])
    let mut saw_esc_err = false
    let mut ej = 0
    while ej < cr_esc.diagnostics.length() {
      if cr_esc.diagnostics[ej].code == "E_MISSING_TYPE" {
        saw_esc_err = true
      }
      ej = ej + 1
    }
    assert_true(
      saw_esc_err,
      "escape case " + eci.to_string() + " must fail closed with E_MISSING_TYPE, got: " + check_result_to_json(cr_esc.diagnostics),
    )
    eci = eci + 1
  }

  // Typed index refines pending array to String, so subsequent Double push is E_TYPE_MISMATCH
  let typed_idx_bad =
  #|fn f(n : Int) -> Unit {
  #|  let adv = { let _ = n; [] }
  #|  let _x : String = adv[0]
  #|  adv.push(1.0)
  #|}
  let cr_tidx = check_source_files("tidx_bad", ["tidx_bad.pion"], [typed_idx_bad])
  assert_true(
    cr_tidx.diagnostics.length() >= 1 && cr_tidx.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH when typed index conflicts with push, got: " + check_result_to_json(cr_tidx.diagnostics),
  )

  // Deferred inference for generic Option return (`let o = none_of(); let v : Option[Int] = o`)
  let opt_gen_src =
  #|fn none_of[T]() -> Option[T] { None }
  #|fn f() -> Option[Int] {
  #|  let o = none_of()
  #|  let v : Option[Int] = o
  #|  v
  #|}
  let cr_og = check_source_files("opt_gen", ["opt_gen.pion"], [opt_gen_src])
  assert_true(cr_og.diagnostics.length() == 0, check_result_to_json(cr_og.diagnostics))

  // Unused EIf generic call reports a single E_MISSING_TYPE without branch duplicates
  let if_unused_src = box_defs +
  #|fn f(c : Bool) -> Unit {
  #|  let m = if c { make_box() } else { make_box() }
  #|  let _ = m.len()
  #|}
  let cr_ifu = check_source_files("if_unused", ["if_unused.pion"], [if_unused_src])
  assert_true(
    cr_ifu.diagnostics.length() == 1 && cr_ifu.diagnostics[0].code == "E_MISSING_TYPE",
    "expected single E_MISSING_TYPE for unused EIf generic call, got: " + check_result_to_json(cr_ifu.diagnostics),
  )

  // Leading-None array literal refines element type from subsequent concrete elements
  let arr_none_ok =
  #|fn f() -> Int {
  #|  let xs = [None, Some(1), Some(2)]
  #|  xs.length()
  #|}
  let cr_ano = check_source_files("arr_none_ok", ["arr_none_ok.pion"], [arr_none_ok])
  assert_true(cr_ano.diagnostics.length() == 0, check_result_to_json(cr_ano.diagnostics))

  let arr_none_bad =
  #|fn f() -> Int {
  #|  let xs = [None, Some(1), Some("bad")]
  #|  xs.length()
  #|}
  let cr_anb = check_source_files("arr_none_bad", ["arr_none_bad.pion"], [arr_none_bad])
  assert_true(
    cr_anb.diagnostics.length() >= 1 && cr_anb.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for [None, Some(1), Some(\"bad\")], got: " + check_result_to_json(cr_anb.diagnostics),
  )

  // 3c: expected-type use site triggers E_TRAIT_NOT_IMPLEMENTED at make_box()
  let box_bound_err = box_defs +
  #|fn test_bound_err() -> Unit {
  #|  let outer : MyBox[Int, MyBox[(Int, Int), Bool]] = make_box()
  #|  let m = make_box()
  #|  outer.put(1, m)
  #|}
  let cr3c = check_source_files("box_bound", ["box_bound.pion"], [box_bound_err])
  let mut saw_trait_err = false
  let mut di = 0
  while di < cr3c.diagnostics.length() {
    if cr3c.diagnostics[di].code == "E_TRAIT_NOT_IMPLEMENTED" {
      saw_trait_err = true
    }
    di = di + 1
  }
  assert_true(
    saw_trait_err,
    "expected E_TRAIT_NOT_IMPLEMENTED for (Int, Int) : KeyTrait, got: " + check_result_to_json(cr3c.diagnostics),
  )

  // 3d: fail-closed E_MISSING_TYPE for unused let, let _, chained call, and partial-only let
  let box_unused = box_defs +
  #|fn test_unused() -> Unit {
  #|  let m = make_box()
  #|  let _ = m.len()
  #|}
  let cr3d1 = check_source_files("box_unused", ["box_unused.pion"], [box_unused])
  assert_true(
    cr3d1.diagnostics.length() == 1 && cr3d1.diagnostics[0].code == "E_MISSING_TYPE",
    "expected single E_MISSING_TYPE for unused let m = make_box(), got: " + check_result_to_json(cr3d1.diagnostics),
  )

  let box_discard = box_defs +
  #|fn test_discard() -> Unit {
  #|  let _ = make_box()
  #|}
  let cr3d2 = check_source_files("box_discard", ["box_discard.pion"], [box_discard])
  assert_true(
    cr3d2.diagnostics.length() == 1 && cr3d2.diagnostics[0].code == "E_MISSING_TYPE",
    "expected single E_MISSING_TYPE for let _ = make_box(), got: " + check_result_to_json(cr3d2.diagnostics),
  )

  let box_chain = box_defs +
  #|fn test_chain() -> Int {
  #|  make_box().len()
  #|}
  let cr3d3 = check_source_files("box_chain", ["box_chain.pion"], [box_chain])
  assert_true(
    cr3d3.diagnostics.length() == 1 && cr3d3.diagnostics[0].code == "E_MISSING_TYPE",
    "expected single E_MISSING_TYPE for make_box().len(), got: " + check_result_to_json(cr3d3.diagnostics),
  )

  let box_partial_only = box_defs +
  #|fn test_partial_only() -> Unit {
  #|  let m = make_box()
  #|  let _ = m.get_opt(1)
  #|}
  let cr3d4 = check_source_files("box_partial_only", ["box_partial_only.pion"], [box_partial_only])
  assert_true(
    cr3d4.diagnostics.length() >= 1 && cr3d4.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unresolved let m = make_box(); m.get_opt(1), got: " + check_result_to_json(cr3d4.diagnostics),
  )

  // 3e: Cross-package trait bound rejection at pkg_a::make_box()
  let pkg_a_src =
  #|pub trait KeyTrait {
  #|  fn key_id(self) -> Int
  #|}
  #|impl KeyTrait for Int {
  #|  fn key_id(self) -> Int { self }
  #|}
  #|pub struct MyBox[K, V] {
  #|  keys : Array[K]
  #|  vals : Array[V]
  #|}
  #|pub fn make_box[K : KeyTrait, V]() -> MyBox[K, V] {
  #|  MyBox::{ keys: [], vals: [] }
  #|}
  #|pub fn MyBox::put[K, V](self : MyBox[K, V], k : K, v : V) -> Unit {
  #|  self.keys.push(k)
  #|  self.vals.push(v)
  #|}
  let cr_a = check_source_files_full("pkg_a", ["a.pion"], [pkg_a_src])
  assert_true(cr_a.diagnostics.length() == 0, check_result_to_json(cr_a.diagnostics))
  let imp_a = ImportedPkg::{ name: "pkg_a", tc: cr_a.tc }
  let pkg_b_bad =
  #|import "pkg_a"
  #|pub fn bad() -> Unit {
  #|  let outer : pkg_a::MyBox[Int, pkg_a::MyBox[(Int, Int), Bool]] = pkg_a::make_box()
  #|  let m = pkg_a::make_box()
  #|  outer.put(1, m)
  #|}
  let cr_b_bad = check_source_files_with_imports_mapped(
    "pkg_b",
    ["b.pion"],
    [pkg_b_bad],
    [imp_a],
    ["pkg_a"],
    ["pkg_a"],
    false,
    false,
  )
  let mut saw_xpkg_trait_err = false
  di = 0
  while di < cr_b_bad.diagnostics.length() {
    if cr_b_bad.diagnostics[di].code == "E_TRAIT_NOT_IMPLEMENTED" &&
      cr_b_bad.diagnostics[di].line == 4 {
      saw_xpkg_trait_err = true
    }
    di = di + 1
  }
  assert_true(
    saw_xpkg_trait_err,
    "expected cross-pkg E_TRAIT_NOT_IMPLEMENTED at line 4 (`pkg_a::make_box()`), got: " + check_result_to_json(cr_b_bad.diagnostics),
  )
}

///|
test "deferred_let_struct_hint_branch_prop_field_assign_opt_tag_and_contains" {
  // Repro 1: generic WrittenCell::{ item: None } hinted by tail DerivedSignal::{ ... }
  let repro1_src =
  #|struct WrittenCell[T] { mut item : Option[(Int64, T)] }
  #|struct DerivedSignal[T] { upstream : Int, value : T, written : WrittenCell[T] }
  #|fn computed_by[T](f : () -> T) -> Int { let _ = f(); 1 }
  #|pub fn derived_signal_by[T](init : T) -> DerivedSignal[T] {
  #|  let written = WrittenCell::{ item: None }
  #|  let upstream = computed_by(fn() {
  #|    written.item = None
  #|    init
  #|  })
  #|  DerivedSignal::{ upstream: upstream, value: init, written: written }
  #|}
  #|pub fn use_both() -> Int {
  #|  let a = derived_signal_by(42)
  #|  let b = derived_signal_by("ok")
  #|  a.value + b.value.length()
  #|}
  let cr1 = check_source_files("repro1", ["repro1.pion"], [repro1_src])
  assert_true(cr1.diagnostics.length() == 0, check_result_to_json(cr1.diagnostics))

  // Repro 2a: Units::make with EBlock empty array + nested if/else-if/binary + tail struct
  let repro2a_src =
  #|struct Units { ri_run : Array[Int] }
  #|fn cap_check(n : Int) -> Unit { let _ = n }
  #|pub fn make_units(n : Int, cls : Array[Int]) -> Units {
  #|  let ri_run = { cap_check(n); [] }
  #|  let mut m = 0
  #|  while m < cls.length() {
  #|    let c_cls = cls[m]
  #|    ri_run.push(
  #|      if c_cls != 1 {
  #|        0
  #|      } else if m > 0 {
  #|        ri_run[m - 1] + 1
  #|      } else {
  #|        1
  #|      },
  #|    )
  #|    m = m + 1
  #|  }
  #|  Units::{ ri_run: ri_run }
  #|}
  let cr2a = check_source_files("repro2a", ["repro2a.pion"], [repro2a_src])
  assert_true(cr2a.diagnostics.length() == 0, check_result_to_json(cr2a.diagnostics))

  // Repro 2b: NO tail struct — EBinary, EIf, EMatch must independently propagate concrete branch/RHS types under Some(TError)
  let repro2b_src =
  #|pub fn no_tail_if_bin(n : Int, c : Bool, m : Int) -> Int {
  #|  let ri_run = { let _ = n; [] }
  #|  ri_run.push(if c { 0 } else if m > 0 { ri_run[m - 1] + 1 } else { 1 })
  #|  ri_run.length()
  #|}
  #|pub fn no_tail_if_idx(n : Int, c : Bool, m : Int) -> Int {
  #|  let ri_run = { let _ = n; [] }
  #|  ri_run.push(if c { 0 } else { ri_run[m - 1] })
  #|  ri_run.length()
  #|}
  #|pub fn no_tail_if_rev_bin(n : Int, m : Int) -> Int {
  #|  let ri_run = { let _ = n; [] }
  #|  ri_run.push(if m > 0 { ri_run[m - 1] + 1 } else { 0 })
  #|  ri_run.length()
  #|}
  #|pub fn no_tail_match_bin(n : Int, k : Int, m : Int) -> Int {
  #|  let ri_run = { let _ = n; [] }
  #|  ri_run.push(match k { 0 => 0, _ => ri_run[m - 1] + 1 })
  #|  ri_run.length()
  #|}
  let cr2b = check_source_files("repro2b", ["repro2b.pion"], [repro2b_src])
  assert_true(cr2b.diagnostics.length() == 0, check_result_to_json(cr2b.diagnostics))

  // Return-wrapped hints (Some / Ok / Tuple)
  let wrap_hint_src =
  #|struct Cell[T] { mut v : Option[T] }
  #|pub fn ret_some[T](x : T) -> Option[Cell[T]] {
  #|  let c = Cell::{ v: None }
  #|  c.v = Some(x)
  #|  Some(c)
  #|}
  #|pub fn ret_ok_tuple[T](x : T) -> Result[(Int, Cell[T]), String] {
  #|  let c = Cell::{ v: None }
  #|  c.v = Some(x)
  #|  return Ok((1, c))
  #|}
  let cr_wh = check_source_files("wrap_hint", ["wrap_hint.pion"], [wrap_hint_src])
  assert_true(cr_wh.diagnostics.length() == 0, check_result_to_json(cr_wh.diagnostics))

  // Boundary: incompatible struct still emits E_TYPE_MISMATCH (no masked diagnostic)
  let bad_struct_src =
  #|struct WrittenCell[T] { mut item : Option[T] }
  #|struct OtherStruct { x : Int }
  #|struct DerivedSignal[T] { written : WrittenCell[T] }
  #|pub fn bad[T]() -> DerivedSignal[T] {
  #|  let w = OtherStruct::{ x: 1 }
  #|  DerivedSignal::{ written: w }
  #|}
  let cr_bs = check_source_files("bad_struct", ["bad_struct.pion"], [bad_struct_src])
  assert_true(
    cr_bs.diagnostics.length() >= 1 && cr_bs.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for incompatible struct, got: " + check_result_to_json(cr_bs.diagnostics),
  )

  // Boundary: scalar `let x = 0; Bar::{ count: x }` (count : Int64) must NOT implicitly coerce
  let bad_scalar_src =
  #|struct Bar { count : Int64 }
  #|pub fn bad_scalar() -> Bar {
  #|  let x = 0
  #|  Bar::{ count: x }
  #|}
  let cr_sc = check_source_files("bad_scalar", ["bad_scalar.pion"], [bad_scalar_src])
  assert_true(
    cr_sc.diagnostics.length() >= 1 && cr_sc.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for scalar let x = 0 passed to Int64 field, got: " + check_result_to_json(cr_sc.diagnostics),
  )

  // Addendum 1 positive: pending generic struct field assignment refines Ref[Option[T]]
  let field_ref_ok =
  #|struct Ref[T] { mut value : T }
  #|fn Ref::new[T](v : T) -> Ref[T] { Ref::{ value: v } }
  #|fn run_cb(f : () -> Unit) -> Unit { f() }
  #|pub fn ok_ref_field(x : Int) -> Int {
  #|  let made = Ref::new(None)
  #|  run_cb(fn() { made.value = Some(x) })
  #|  match made.value { Some(v) => v, None => 0 }
  #|}
  let cr_fr_ok = check_source_files("field_ref_ok", ["field_ref_ok.pion"], [field_ref_ok])
  assert_true(cr_fr_ok.diagnostics.length() == 0, check_result_to_json(cr_fr_ok.diagnostics))

  // Addendum 1 negative: unresolved field assignment & partial 2-param struct field assignment fail closed
  let field_ref_bad1 =
  #|struct Ref[T] { mut value : T }
  #|fn Ref::new[T](v : T) -> Ref[T] { Ref::{ value: v } }
  #|pub fn bad_ref_none() -> Unit {
  #|  let made = Ref::new(None)
  #|  made.value = None
  #|  made.value = Some(1)
  #|}
  let cr_fr_b1 = check_source_files("field_ref_bad1", ["field_ref_bad1.pion"], [field_ref_bad1])
  assert_true(
    cr_fr_b1.diagnostics.length() >= 1 && cr_fr_b1.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for made.val = None, got: " + check_result_to_json(cr_fr_b1.diagnostics),
  )

  let field_ref_bad2 =
  #|struct Pair[A, B] { mut first : A, mut second : B }
  #|fn make_pair[A, B]() -> Pair[A, B] { panic("unreached") }
  #|pub fn bad_pair() -> Unit {
  #|  let pair = make_pair()
  #|  pair.first = 1
  #|  pair.second = "a"
  #|}
  let cr_fr_b2 = check_source_files("field_ref_bad2", ["field_ref_bad2.pion"], [field_ref_bad2])
  assert_true(
    cr_fr_b2.diagnostics.length() >= 1 && cr_fr_b2.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for partial 2-param struct field assign, got: " + check_result_to_json(cr_fr_b2.diagnostics),
  )

  // Addendum 2 positive: pure tag-only Option match and `is None` / `is Some(_)` on pending Option
  let opt_tag_ok =
  #|pub fn ok_match_tag(n : Int) -> Int {
  #|  let mut before = None
  #|  let mut p = n
  #|  while p >= 0 && match before { None => true, _ => false } {
  #|    before = Some(p)
  #|    p = p - 1
  #|  }
  #|  match before { Some(v) => v, None => -1 }
  #|}
  #|pub fn ok_is_tag(n : Int) -> Int {
  #|  let mut before = None
  #|  let mut p = n
  #|  while p >= 0 && before is None {
  #|    before = Some(p)
  #|    p = p - 1
  #|  }
  #|  match before { Some(v) => v, None => -1 }
  #|}
  let cr_ot_ok = check_source_files("opt_tag_ok", ["opt_tag_ok.pion"], [opt_tag_ok])
  assert_true(cr_ot_ok.diagnostics.length() == 0, check_result_to_json(cr_ot_ok.diagnostics))

  // Addendum 2 negative: binding payload or unrefined at block end fails closed
  let opt_tag_bad1 =
  #|pub fn bad_match_bind() -> Int {
  #|  let mut before = None
  #|  let r = match before { Some(v) => v, None => 0 }
  #|  before = Some(1)
  #|  r
  #|}
  let cr_ot_b1 = check_source_files("opt_tag_bad1", ["opt_tag_bad1.pion"], [opt_tag_bad1])
  assert_true(
    cr_ot_b1.diagnostics.length() >= 1 && cr_ot_b1.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for match before { Some(v) => ... }, got: " + check_result_to_json(cr_ot_b1.diagnostics),
  )

  let opt_tag_bad2 =
  #|pub fn bad_is_bind() -> Unit {
  #|  let mut before = None
  #|  if before is Some(v) { let _ = v }
  #|  before = Some(1)
  #|}
  let cr_ot_b2 = check_source_files("opt_tag_bad2", ["opt_tag_bad2.pion"], [opt_tag_bad2])
  assert_true(
    cr_ot_b2.diagnostics.length() >= 1 && cr_ot_b2.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for if before is Some(v), got: " + check_result_to_json(cr_ot_b2.diagnostics),
  )

  let opt_tag_bad3 =
  #|pub fn bad_tag_unrefined() -> Unit {
  #|  let before = None
  #|  let _ = before is None
  #|}
  let cr_ot_b3 = check_source_files("opt_tag_bad3", ["opt_tag_bad3.pion"], [opt_tag_bad3])
  assert_true(
    cr_ot_b3.diagnostics.length() >= 1 && cr_ot_b3.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unrefined before is None, got: " + check_result_to_json(cr_ot_b3.diagnostics),
  )

  // Addendum 3 positive & negative: Array::contains refines element type; unresolved arg fails closed
  let contains_ok =
  #|pub fn ok_contains() -> Int {
  #|  let under_way = []
  #|  let on_way = fn(k : Int) {
  #|    if !under_way.contains(k) { under_way.push(k) }
  #|  }
  #|  on_way(1)
  #|  on_way(1)
  #|  on_way(2)
  #|  under_way.length()
  #|}
  let cr_c_ok = check_source_files("contains_ok", ["contains_ok.pion"], [contains_ok])
  assert_true(cr_c_ok.diagnostics.length() == 0, check_result_to_json(cr_c_ok.diagnostics))

  let contains_bad =
  #|pub fn bad_contains() -> Unit {
  #|  let xs = []
  #|  let _ = xs.contains(None)
  #|  xs.push(1)
  #|}
  let cr_c_bad = check_source_files("contains_bad", ["contains_bad.pion"], [contains_bad])
  assert_true(
    cr_c_bad.diagnostics.length() >= 1 && cr_c_bad.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for xs.contains(None), got: " + check_result_to_json(cr_c_bad.diagnostics),
  )

  // P0 shadowing regressions in infer_let_hint: guard / block-guard / match-guard / while-is / for-let-mut
  let shadow_ok_src =
  #|struct Box[T] { mut v : Option[T] }
  #|pub fn s1_guard(o : Option[Box[String]]) -> Box[String] {
  #|  let b = Box::{ v: Some(1) }
  #|  let _ = match b.v { Some(x) => x, None => 0 }
  #|  guard o is Some(b) else { return Box::{ v: None } }
  #|  b
  #|}
  #|pub fn s2_match_guard(o : Option[Box[String]], k : Int) -> Box[String] {
  #|  let b = Box::{ v: Some(1) }
  #|  let n = match b.v { Some(x) => x, None => 0 }
  #|  match k {
  #|    0 if o is Some(b) => b,
  #|    _ => Box::{ v: Some(n.to_string()) },
  #|  }
  #|}
  #|pub fn s3_while_is(o : Option[Box[String]]) -> Box[String] {
  #|  let b = Box::{ v: Some(1) }
  #|  let n = match b.v { Some(x) => x, None => 0 }
  #|  let cur = o
  #|  while cur is Some(b) {
  #|    return b
  #|  }
  #|  Box::{ v: Some(n.to_string()) }
  #|}
  #|pub fn s6_for_let_mut(o : Box[String]) -> Box[String] {
  #|  let b = Box::{ v: Some(1) }
  #|  let n = match b.v { Some(x) => x, None => 0 }
  #|  for let mut b = o; n < 0; b = o {
  #|    return b
  #|  }
  #|  o
  #|}
  #|pub fn s7_block_guard(o : Option[Box[String]]) -> Box[String] {
  #|  let b = Box::{ v: Some(1) }
  #|  let _ = match b.v { Some(x) => x, None => 0 }
  #|  {
  #|    guard o is Some(b) else { return Box::{ v: None } }
  #|    b
  #|  }
  #|}
  #|pub fn s8_guard_no_uint_coerce(o : Option[Box[UInt]]) -> (Int, Box[UInt]) {
  #|  let b = Box::{ v: Some(-1) }
  #|  let out = match b.v { Some(x) => x, None => 0 }
  #|  guard o is Some(b) else { return (out, Box::{ v: None }) }
  #|  (out, b)
  #|}
  #|pub fn pe1_guard_empty_arr(o : Option[Array[UInt]]) -> (Int, Array[UInt]) {
  #|  let xs = []
  #|  xs.push(-1)
  #|  let out = xs[0]
  #|  guard o is Some(xs) else { return (out, []) }
  #|  (out, xs)
  #|}
  let cr_sh = check_source_files("shadow_ok", ["shadow_ok.pion"], [shadow_ok_src])
  assert_true(cr_sh.diagnostics.length() == 0, check_result_to_json(cr_sh.diagnostics))

  // P2-3: pending struct with already-concrete field reports E_TYPE_MISMATCH (not E_MISSING_TYPE) on wrong RHS
  let field_concrete_mismatch =
  #|struct Pair[K, V] { mut k : K, mut v : Option[V] }
  #|fn make_pair[K, V](k : K) -> Pair[K, V] { Pair::{ k: k, v: None } }
  #|pub fn bad_concrete_field() -> Unit {
  #|  let p = make_pair(1)
  #|  p.k = Some("s")
  #|}
  let cr_fcm = check_source_files("field_cm", ["field_cm.pion"], [field_concrete_mismatch])
  assert_true(
    cr_fcm.diagnostics.length() >= 1 && cr_fcm.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for concrete field mismatch on pending struct, got: " + check_result_to_json(cr_fcm.diagnostics),
  )
}

///|
test "deferred infer: gcall pending arg, non-indexable struct, closure param refine, and try stmt/typed" {
  // Case 1: pending let binding passed as earlier arg to generic fn/method
  let case1_ok =
  #|struct MyIter[T] { items : Array[T] }
  #|fn make_iter[T](xs : Array[T]) -> MyIter[T] { MyIter::{ items: xs } }
  #|fn push_iter[T](out : Array[T], it : MyIter[T]) -> Unit {
  #|  let mut i = 0
  #|  while i < it.items.length() {
  #|    out.push(it.items[i])
  #|    i = i + 1
  #|  }
  #|}
  #|fn push_mut[T](mut out : Array[T], v : T) -> Unit {
  #|  out.push(v)
  #|}
  #|struct Recv { tag : Int }
  #|fn Recv::push_iter[T](self : Recv, out : Array[T], it : MyIter[T]) -> Int {
  #|  push_iter(out, it)
  #|  self.tag + out.length()
  #|}
  #|pub fn run_case1(files : Array[String]) -> Int {
  #|  let out = []
  #|  push_iter(out, make_iter(files))
  #|  let mut out2 = []
  #|  push_mut(mut out2, 42)
  #|  let out3 = []
  #|  let r = Recv::{ tag: 1 }
  #|  let n = r.push_iter(out3, make_iter(files))
  #|  out.length() + out2.length() + n
  #|}
  let cr1_ok = check_source_files("c1_ok", ["c1_ok.pion"], [case1_ok])
  assert_true(cr1_ok.diagnostics.length() == 0, check_result_to_json(cr1_ok.diagnostics))

  let case1_bad =
  #|fn pair_arr[T](a : Array[T], b : Array[T]) -> Int { a.length() + b.length() }
  #|pub fn run_case1_bad() -> Int {
  #|  let a = []
  #|  let b = []
  #|  pair_arr(a, b)
  #|}
  let cr1_bad = check_source_files("c1_bad", ["c1_bad.pion"], [case1_bad])
  assert_true(
    cr1_bad.diagnostics.length() >= 1 && cr1_bad.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unconstrained generic pending args, got: " + check_result_to_json(cr1_bad.diagnostics),
  )

  // Case 2: pending non-indexable generic struct at index / index-assign / compound-assign
  let case2_assign =
  #|struct OrderedMap[K, V] { keys : Array[K], vals : Array[V] }
  #|fn ordered_map_new[K, V]() -> OrderedMap[K, V] { OrderedMap::{ keys: [], vals: [] } }
  #|pub fn run_c2_assign() -> Unit {
  #|  let m = ordered_map_new()
  #|  m[0] = 1
  #|}
  let cr2_a = check_source_files("c2_assign", ["c2_assign.pion"], [case2_assign])
  assert_true(
    cr2_a.diagnostics.length() == 1 &&
      cr2_a.diagnostics[0].code == "E_TYPE_MISMATCH" &&
      cr2_a.diagnostics[0].message.contains("cannot assign to indexed type"),
    "expected single E_TYPE_MISMATCH cannot assign to indexed type, got: " + check_result_to_json(cr2_a.diagnostics),
  )

  let case2_cassign =
  #|struct OrderedMap[K, V] { keys : Array[K], vals : Array[V] }
  #|fn ordered_map_new[K, V]() -> OrderedMap[K, V] { OrderedMap::{ keys: [], vals: [] } }
  #|pub fn run_c2_cassign() -> Unit {
  #|  let m = ordered_map_new()
  #|  m[0] += 1
  #|}
  let cr2_ca = check_source_files("c2_cassign", ["c2_cassign.pion"], [case2_cassign])
  assert_true(
    cr2_ca.diagnostics.length() == 1 &&
      cr2_ca.diagnostics[0].code == "E_TYPE_MISMATCH" &&
      cr2_ca.diagnostics[0].message.contains("cannot assign to indexed type"),
    "expected single E_TYPE_MISMATCH cannot assign to indexed type for +=, got: " + check_result_to_json(cr2_ca.diagnostics),
  )

  let case2_read =
  #|struct OrderedMap[K, V] { keys : Array[K], vals : Array[V] }
  #|fn ordered_map_new[K, V]() -> OrderedMap[K, V] { OrderedMap::{ keys: [], vals: [] } }
  #|pub fn run_c2_read() -> Unit {
  #|  let m = ordered_map_new()
  #|  let _ = m[0]
  #|}
  let cr2_r = check_source_files("c2_read", ["c2_read.pion"], [case2_read])
  assert_true(
    cr2_r.diagnostics.length() == 1 &&
      cr2_r.diagnostics[0].code == "E_TYPE_MISMATCH" &&
      cr2_r.diagnostics[0].message.contains("cannot index into type"),
    "expected single E_TYPE_MISMATCH cannot index into type, got: " + check_result_to_json(cr2_r.diagnostics),
  )

  // Case 3: unannotated closure param refined from body usage
  let case3_ok =
  #|enum Exit[X] { Done(X) }
  #|struct Fiber[X] { item : Option[X] }
  #|struct TaskScope { id : Int }
  #|fn TaskScope::fork[X](self : TaskScope, f : ((Exit[X]) -> Unit) -> Unit, name~ : String = "") -> Fiber[X] {
  #|  let _ = self.id
  #|  let _ = name
  #|  f(fn(_e) { () })
  #|  Fiber::{ item: None }
  #|}
  #|fn fork_fn[X](s : TaskScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  #|  s.fork(f)
  #|}
  #|fn run_thunk(t : () -> Unit) -> Unit { t() }
  #|fn handle(s : TaskScope, k : (Exit[Unit]) -> Unit) -> Unit {
  #|  let _ = s.id
  #|  k(Exit::Done(()))
  #|}
  #|pub fn run_case3(s : TaskScope, key : String) -> Unit {
  #|  let _ = s.fork(fn(k) { handle(s, k) }, name=key)
  #|  let _ = s.fork(fn(k) { run_thunk(fn() { handle(s, k) }) }, name=key)
  #|  let _ = fork_fn(s, fn(k) { handle(s, k) })
  #|}
  let cr3_ok = check_source_files("c3_ok", ["c3_ok.pion"], [case3_ok])
  assert_true(cr3_ok.diagnostics.length() == 0, check_result_to_json(cr3_ok.diagnostics))

  let case3_bad1 =
  #|enum Exit[X] { Done(X) }
  #|struct Fiber[X] { item : Option[X] }
  #|struct TaskScope { id : Int }
  #|fn TaskScope::fork[X](self : TaskScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  #|  let _ = self.id
  #|  f(fn(_e) { () })
  #|  Fiber::{ item: None }
  #|}
  #|pub fn run_c3_bad1(s : TaskScope) -> Unit {
  #|  let _ = s.fork(fn(_k) { () })
  #|}
  let cr3_bad1 = check_source_files("c3_bad1", ["c3_bad1.pion"], [case3_bad1])
  assert_true(
    cr3_bad1.diagnostics.length() >= 1 && cr3_bad1.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unconstrained fork closure (_k), got: " + check_result_to_json(cr3_bad1.diagnostics),
  )

  let case3_bad2 =
  #|enum Exit[X] { Done(X) }
  #|struct Fiber[X] { item : Option[X] }
  #|struct TaskScope { id : Int }
  #|fn TaskScope::fork[X](self : TaskScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  #|  let _ = self.id
  #|  f(fn(_e) { () })
  #|  Fiber::{ item: None }
  #|}
  #|fn ignore_any[T](_v : T) -> Unit { () }
  #|pub fn run_c3_bad2(s : TaskScope) -> Unit {
  #|  let _ = s.fork(fn(k) { ignore_any(k) })
  #|}
  let cr3_bad2 = check_source_files("c3_bad2", ["c3_bad2.pion"], [case3_bad2])
  assert_true(
    cr3_bad2.diagnostics.length() >= 1 && cr3_bad2.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for unconstrained fork closure (ignore_any), got: " + check_result_to_json(cr3_bad2.diagnostics),
  )

  // Case 4: `?` in statement position and typed context
  let case4_ok =
  #|struct Parser { i : Int }
  #|fn Parser::fail[T](self : Parser, msg : String) -> Result[T, String] {
  #|  Err(msg + self.i.to_string())
  #|}
  #|fn Parser::parse_int(self : Parser) -> Result[Int, String] {
  #|  Ok(self.i)
  #|}
  #|fn opt_fail[T]() -> Option[T] { None }
  #|pub fn run_c4_res(p : Parser, c1 : Bool, c2 : Bool) -> Result[Int, String] {
  #|  if c1 {
  #|    p.fail("a name wanted")?
  #|  }
  #|  if c2 {
  #|    (if c1 { Ok(42) } else { Err("e") })?
  #|  }
  #|  if c2 {
  #|    p.parse_int()?
  #|  }
  #|  let mut k = 0
  #|  while k < 1 {
  #|    p.fail("in while")?
  #|    k = k + 1
  #|  }
  #|  for let mut j = 0; j < 1; j = j + 1 {
  #|    p.fail("in for")?
  #|  }
  #|  p.fail("non-tail")?
  #|  let x : Int = p.fail("typed")?
  #|  Ok(x)
  #|}
  #|pub fn run_c4_opt(c : Bool) -> Option[Int] {
  #|  if c {
  #|    opt_fail()?
  #|  }
  #|  let x : Int = opt_fail()?
  #|  Some(x)
  #|}
  let cr4_ok = check_source_files("c4_ok", ["c4_ok.pion"], [case4_ok])
  assert_true(cr4_ok.diagnostics.length() == 0, check_result_to_json(cr4_ok.diagnostics))

  let case4_unhandled =
  #|struct Parser { i : Int }
  #|fn Parser::parse_int(self : Parser) -> Result[Int, String] { Ok(self.i) }
  #|pub fn run_c4_unhandled(p : Parser, c : Bool) -> Result[Int, String] {
  #|  if c {
  #|    p.parse_int()
  #|  }
  #|  Ok(0)
  #|}
  let cr4_uh = check_source_files("c4_uh", ["c4_uh.pion"], [case4_unhandled])
  assert_true(
    cr4_uh.diagnostics.length() >= 1 && cr4_uh.diagnostics[0].code == "E_UNHANDLED_RESULT",
    "expected E_UNHANDLED_RESULT for unhandled Result in if-without-else, got: " + check_result_to_json(cr4_uh.diagnostics),
  )

  let case4_val_missing =
  #|struct Parser { i : Int }
  #|fn Parser::fail[T](self : Parser, msg : String) -> Result[T, String] { Err(msg + self.i.to_string()) }
  #|pub fn run_c4_val(p : Parser) -> Result[Unit, String] {
  #|  let x = p.fail("val")?
  #|  let _ = x
  #|  Ok(())
  #|}
  let cr4_vm = check_source_files("c4_vm", ["c4_vm.pion"], [case4_val_missing])
  assert_true(
    cr4_vm.diagnostics.length() >= 1 && cr4_vm.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for untyped value-position `?`, got: " + check_result_to_json(cr4_vm.diagnostics),
  )

  let case4_trait_err =
  #|trait MyTrait { fn tag(self) -> Int }
  #|fn bad_fail[T : MyTrait]() -> Result[T, String] { Err("boom") }
  #|pub fn run_c4_trait(c : Bool) -> Result[Unit, String] {
  #|  if c {
  #|    bad_fail()?
  #|  }
  #|  Ok(())
  #|}
  let cr4_tr = check_source_files("c4_tr", ["c4_tr.pion"], [case4_trait_err])
  assert_true(
    cr4_tr.diagnostics.length() >= 1 && cr4_tr.diagnostics[0].code == "E_TRAIT_NOT_IMPLEMENTED",
    "expected E_TRAIT_NOT_IMPLEMENTED for statement-position `?` with unsatisfied trait bound, got: " + check_result_to_json(cr4_tr.diagnostics),
  )

  // R2 P1-1 positive: shadowing refined closure param with same-name `let` must preserve param's refined type
  let p1_1_pos =
  #|fn run_opt[T](f : (Option[T]) -> Int) -> Int { f(None) }
  #|fn use_int(o : Option[Int]) -> Int { match o { Some(v) => v, None => 0 } }
  #|fn run_arr[T](f : (Array[T]) -> Int) -> Int { f([]) }
  #|fn fork1[T](f : (Option[T]) -> Unit) -> Unit { f(None) }
  #|pub fn run_p1_1_pos() -> Int {
  #|  let a = run_opt(fn(o) {
  #|    let r = use_int(o)
  #|    let o = "shadow"
  #|    r + o.length()
  #|  })
  #|  let b = run_arr(fn(xs) {
  #|    let total : Array[Int] = xs
  #|    let xs = total.length()
  #|    xs + 1
  #|  })
  #|  fork1(fn(k) {
  #|    let _z : Option[Int] = k
  #|    let k = 4
  #|    let _ = k
  #|    ()
  #|  })
  #|  a + b
  #|}
  let cr_p1_1_pos = check_source_files("p1_1_pos", ["p1_1_pos.pion"], [p1_1_pos])
  assert_true(cr_p1_1_pos.diagnostics.length() == 0, check_result_to_json(cr_p1_1_pos.diagnostics))

  // R2 P1-1 negative: shadowing unrefined param before use must NOT refine param via the shadow `let`
  let p1_1_neg =
  #|enum Exit[X] { Done(X) }
  #|struct Fiber[X] { item : Option[X] }
  #|struct TaskScope { id : Int }
  #|fn TaskScope::fork[X](self : TaskScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  #|  let _ = self.id
  #|  f(fn(_e) { () })
  #|  Fiber::{ item: None }
  #|}
  #|fn handle_int(k : (Exit[Int]) -> Unit) -> Unit { k(Exit::Done(1)) }
  #|pub fn run_p1_1_neg(s : TaskScope) -> Unit {
  #|  let _ = s.fork(fn(k) {
  #|    let k = fn(_e : Exit[Int]) { () }
  #|    handle_int(k)
  #|  })
  #|}
  let cr_p1_1_neg = check_source_files("p1_1_neg", ["p1_1_neg.pion"], [p1_1_neg])
  assert_true(
    cr_p1_1_neg.diagnostics.length() >= 1 && cr_p1_1_neg.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE when closure param is shadowed before use, got: " + check_result_to_json(cr_p1_1_neg.diagnostics),
  )

  // R2 P1-2: 20-level nested fork capturing refined outer k0 must stay O(N) via closure cache
  let p1_2_sb = StringBuilder()
  p1_2_sb.write_string("enum Exit[X] { Done(X) }\n")
  p1_2_sb.write_string("struct Fiber[X] { item : Option[X] }\n")
  p1_2_sb.write_string("struct TaskScope { id : Int }\n")
  p1_2_sb.write_string("fn TaskScope::fork[X](self : TaskScope, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {\n")
  p1_2_sb.write_string("  let _ = self.id\n  f(fn(_e) { () })\n  Fiber::{ item: None }\n}\n")
  p1_2_sb.write_string("fn handle_int(k : (Exit[Int]) -> Unit) -> Unit { k(Exit::Done(1)) }\n")
  p1_2_sb.write_string("pub fn run_p1_2_nested(s : TaskScope) -> Unit {\n")
  let mut nl = 0
  while nl < 20 {
    p1_2_sb.write_string("  let _ = s.fork(fn(k")
    p1_2_sb.write_string(nl.to_string())
    p1_2_sb.write_string(") { handle_int(k")
    p1_2_sb.write_string(nl.to_string())
    p1_2_sb.write_string("); ")
    nl = nl + 1
  }
  p1_2_sb.write_string("handle_int(k0)")
  nl = 0
  while nl < 20 {
    p1_2_sb.write_string(" })")
    nl = nl + 1
  }
  p1_2_sb.write_string("\n}\n")
  let cr_p1_2 = check_source_files("p1_2_nested", ["p1_2_nested.pion"], [p1_2_sb.to_string()])
  assert_true(cr_p1_2.diagnostics.length() == 0, check_result_to_json(cr_p1_2.diagnostics))

  // R2 P2-1: if-without-else non-`?` generic calls remain fail-closed E_MISSING_TYPE, while unhandled Result stays E_UNHANDLED_RESULT
  let p2_1_pick =
  #|fn pick[T](xs : Array[T]) -> Array[T] { xs }
  #|pub fn run_p2_1_pick(c : Bool) -> Unit {
  #|  if c { pick([]) }
  #|}
  let cr_p2_1_pick = check_source_files("p2_1_pick", ["p2_1_pick.pion"], [p2_1_pick])
  assert_true(
    cr_p2_1_pick.diagnostics.length() >= 1 && cr_p2_1_pick.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for if c { pick([]) }, got: " + check_result_to_json(cr_p2_1_pick.diagnostics),
  )

  let p2_1_id =
  #|fn id_opt[T](x : Option[T]) -> Option[T] { x }
  #|pub fn run_p2_1_id(c : Bool) -> Unit {
  #|  if c { id_opt(None) }
  #|}
  let cr_p2_1_id = check_source_files("p2_1_id", ["p2_1_id.pion"], [p2_1_id])
  assert_true(
    cr_p2_1_id.diagnostics.length() >= 1 && cr_p2_1_id.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for if c { id_opt(None) }, got: " + check_result_to_json(cr_p2_1_id.diagnostics),
  )

  let p2_1_mk =
  #|trait MyBound { fn val_id(self) -> Int }
  #|fn mk[T : MyBound]() -> Option[T] { None }
  #|pub fn run_p2_1_mk(c : Bool) -> Unit {
  #|  if c { mk() }
  #|}
  let cr_p2_1_mk = check_source_files("p2_1_mk", ["p2_1_mk.pion"], [p2_1_mk])
  assert_true(
    cr_p2_1_mk.diagnostics.length() >= 1 && cr_p2_1_mk.diagnostics[0].code == "E_MISSING_TYPE",
    "expected E_MISSING_TYPE for if c { mk() }, got: " + check_result_to_json(cr_p2_1_mk.diagnostics),
  )
}


///|
test "closure param refine: direct call args and expected result fill TError holes" {
  let prelude =
  #|enum Exit[X] { Succeeded(X), Cancelled }
  #|struct Fiber[X] { item : Option[X] }
  #|fn Fiber::interrupt[X](self : Fiber[X]) -> Unit { let _ = self.item }
  #|struct Rt { id : Int }
  #|fn Rt::fork[X](self : Rt, f : ((Exit[X]) -> Unit) -> Unit) -> Fiber[X] {
  #|  let _ = self.id
  #|  f(fn(_e) { () })
  #|  Fiber::{ item: None }
  #|}
  #|fn next_frame_k(cb : (Exit[Unit]) -> Unit) -> Unit { cb(Exit::Succeeded(())) }
  #|fn work() -> Unit { () }
  #|

  // Direct call in the closure body refines `k : (Exit[Unit]) -> Unit`.
  let direct_ok =
  #|pub fn run_direct(rt : Rt) -> () -> Unit {
  #|  let f = rt.fork(fn(k) { k(Exit::Succeeded(())) })
  #|  fn() { f.interrupt() }
  #|}
  let cr_direct = check_source_files("cpr_direct", ["cpr_direct.pion"], [
    prelude + direct_ok,
  ])
  assert_true(cr_direct.diagnostics.length() == 0, check_result_to_json(cr_direct.diagnostics))

  // Direct call from inside a nested CPS closure refines the outer `k`.
  let nested_ok =
  #|pub fn run_nested(rt : Rt) -> Unit {
  #|  let f = rt.fork(fn(k) {
  #|    next_frame_k(fn(ex) {
  #|      match ex {
  #|        Exit::Succeeded(_) => { work(); k(Exit::Succeeded(())) }
  #|        _ => k(ex)
  #|      }
  #|    })
  #|  })
  #|  f.interrupt()
  #|}
  let cr_nested = check_source_files("cpr_nested", ["cpr_nested.pion"], [
    prelude + nested_ok,
  ])
  assert_true(cr_nested.diagnostics.length() == 0, check_result_to_json(cr_nested.diagnostics))

  // The expected result type of a direct call refines the closure param's return type.
  let ret_ok =
  #|struct Box[T] { v : Option[T] }
  #|fn Box::size[T](self : Box[T]) -> Int { match self.v { Some(_) => 1, None => 0 } }
  #|fn with_cb[T](f : (() -> T) -> Unit) -> Box[T] { let _ = f; Box::{ v: None } }
  #|pub fn run_ret() -> Int {
  #|  let b = with_cb(fn(g) { let x : Int = g(); let _ = x })
  #|  b.size()
  #|}
  let cr_ret = check_source_files("cpr_ret", ["cpr_ret.pion"], [ret_ok])
  assert_true(cr_ret.diagnostics.length() == 0, check_result_to_json(cr_ret.diagnostics))

  // A conflicting second call sees the refined type and is rejected.
  let conflict_bad =
  #|pub fn run_conflict(rt : Rt) -> Unit {
  #|  let f = rt.fork(fn(k) { k(Exit::Succeeded(1)); k(Exit::Succeeded("s")) })
  #|  f.interrupt()
  #|}
  let cr_conflict = check_source_files("cpr_conflict", ["cpr_conflict.pion"], [
    prelude + conflict_bad,
  ])
  assert_true(
    cr_conflict.diagnostics.length() >= 1 &&
    cr_conflict.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for conflicting direct calls, got: " +
    check_result_to_json(cr_conflict.diagnostics),
  )

  // Calls that leave the hole unconstrained stay fail-closed.
  let unconstrained = [
    "pub fn run_bad(rt : Rt) -> Unit {\n  let f = rt.fork(fn(k) { k(Exit::Cancelled) })\n  f.interrupt()\n}\n",
    "pub fn run_bad(rt : Rt) -> Unit {\n  let f = rt.fork(fn(_k) { () })\n  f.interrupt()\n}\n",
    "pub fn run_bad(rt : Rt) -> Unit {\n  let f = rt.fork(fn(k) {\n    let k = fn(_e : Exit[Int]) { () }\n    k(Exit::Succeeded(1))\n  })\n  f.interrupt()\n}\n",
    "pub fn run_bad(rt : Rt) -> Unit {\n  let f = rt.fork(fn(k) { k(abort(\"\")) })\n  f.interrupt()\n}\n",
  ]
  let mut ui = 0
  while ui < unconstrained.length() {
    let cr_bad = check_source_files("cpr_bad", ["cpr_bad.pion"], [
      prelude + unconstrained[ui],
    ])
    assert_true(
      cr_bad.diagnostics.length() >= 1 &&
      cr_bad.diagnostics[0].code == "E_MISSING_TYPE",
      "expected E_MISSING_TYPE for unconstrained case " +
      ui.to_string() +
      ", got: " +
      check_result_to_json(cr_bad.diagnostics),
    )
    ui = ui + 1
  }

  // Re-entrant calls: an argument that itself calls (and refines) the same
  // parameter must never have its refinement erased or bypassed.
  let reent_prelude =
  #|enum Exit[X] { Succeeded(X), Cancelled }
  #|struct Pair[X, Y] { a : Option[X], b : Option[Y] }
  #|fn Pair::count[X, Y](self : Pair[X, Y]) -> Int { match self.a { Some(_) => 1, None => 0 } }
  #|fn with_xy[X, Y](f : ((Exit[X]) -> Y) -> Unit) -> Pair[X, Y] { let _ = f; Pair::{ a: None, b: None } }
  #|fn with_two[X](f : ((Int, Exit[X]) -> Unit) -> Unit) -> Pair[X, Int] { let _ = f; Pair::{ a: None, b: None } }
  #|
  let reent_ok = [
    "pub fn run_reent() -> Int {\n  let p = with_xy(fn(k) {\n    let _ : Int = k({ let _ = k(Exit::Succeeded(1)); Exit::Cancelled })\n  })\n  let q : Pair[Int, Int] = p\n  q.count()\n}\n",
    // The outer call's expected `Unit` must not overwrite the `Int` result the
    // inner call already filled in.
    "pub fn run_reent() -> Int {\n  let p = with_xy(fn(k) {\n    k({ let _ : Int = k(Exit::Succeeded(1)); Exit::Cancelled })\n  })\n  let q : Pair[Int, Int] = p\n  q.count()\n}\n",
  ]
  let mut ri = 0
  while ri < reent_ok.length() {
    let cr_reent = check_source_files("cpr_reent", ["cpr_reent.pion"], [
      reent_prelude + reent_ok[ri],
    ])
    assert_true(
      cr_reent.diagnostics.length() == 0,
      "re-entrant case " +
      ri.to_string() +
      ": " +
      check_result_to_json(cr_reent.diagnostics),
    )
    ri = ri + 1
  }
  let reent_bad1 =
  #|pub fn run_reent_bad1() -> Int {
  #|  let p = with_xy(fn(k) {
  #|    let _ : Int = k({ let _ = k(Exit::Succeeded(1)); Exit::Succeeded("bad") })
  #|  })
  #|  p.count()
  #|}
  let cr_rb1 = check_source_files("cpr_rb1", ["cpr_rb1.pion"], [
    reent_prelude + reent_bad1,
  ])
  assert_true(
    cr_rb1.diagnostics.length() >= 1 &&
    cr_rb1.diagnostics[0].code == "E_TYPE_MISMATCH",
    "expected E_TYPE_MISMATCH for conflicting re-entrant call, got: " +
    check_result_to_json(cr_rb1.diagnostics),
  )
  // Re-entrant and sequential spellings report the same conflict at `7`.
  let reent_bad2 =
  #|pub fn run_reent_bad2() -> Int {
  #|  let p = with_two(fn(k) {
  #|    k({ k(1, Exit::Succeeded("bad")); 2 }, Exit::Cancelled)
  #|    k(3, Exit::Succeeded(7))
  #|  })
  #|  p.count()
  #|}
  let seq_bad2 =
  #|pub fn run_reent_bad2() -> Int {
  #|  let p = with_two(fn(k) {
  #|    k(1, Exit::Succeeded("bad")); k(2, Exit::Cancelled)
  #|    k(3, Exit::Succeeded(7))
  #|  })
  #|  p.count()
  #|}
  let bad2_srcs = [reent_bad2, seq_bad2]
  let mut bi = 0
  while bi < bad2_srcs.length() {
    let cr_rb2 = check_source_files("cpr_rb2", ["cpr_rb2.pion"], [
      reent_prelude + bad2_srcs[bi],
    ])
    assert_true(
      cr_rb2.diagnostics.length() >= 1 &&
      cr_rb2.diagnostics[0].code == "E_TYPE_MISMATCH" &&
      cr_rb2.diagnostics[0].line == 9 &&
      cr_rb2.diagnostics[0].col == 26 &&
      cr_rb2.diagnostics[0].expected == "String",
      "expected E_TYPE_MISMATCH at `7` (String) for case " +
      bi.to_string() +
      ", got: " +
      check_result_to_json(cr_rb2.diagnostics),
    )
    bi = bi + 1
  }

  // 20 nested forks, each refined by its own direct call, plus a call of the
  // outermost `k0` from the innermost body: must stay linear (closure cache).
  let sb = StringBuilder()
  sb.write_string(prelude)
  sb.write_string("pub fn run_deep(rt : Rt) -> Unit {\n")
  let mut nl = 0
  while nl < 20 {
    sb.write_string("  let _ = rt.fork(fn(k")
    sb.write_string(nl.to_string())
    sb.write_string(") { k")
    sb.write_string(nl.to_string())
    sb.write_string("(Exit::Succeeded(1)); ")
    nl = nl + 1
  }
  sb.write_string("k0(Exit::Succeeded(1))")
  nl = 0
  while nl < 20 {
    sb.write_string(" })")
    nl = nl + 1
  }
  sb.write_string("\n}\n")
  let cr_deep = check_source_files("cpr_deep", ["cpr_deep.pion"], [
    sb.to_string(),
  ])
  assert_true(cr_deep.diagnostics.length() == 0, check_result_to_json(cr_deep.diagnostics))
}
