    str_contains(bad_json, "E_TYPE_MISMATCH") && str_contains(bad_json, "String"),
    "closure bad return should check against closure return type: " + bad_json,
  )
}

///|
test "p20a: dyn Trait implicit/explicit boxing, collections, Option, cross-pkg, and error checks" {
  let ok_src =
    #|pub trait Describe {
    #|  describe(self : Self) -> String
    #|  score(self : Self, bonus : Int) -> Int
    #|}
    #|pub struct Dog {
    #|  name : String
    #|}
    #|impl Describe for Dog {
    #|  fn describe(self : Dog) -> String {
    #|    "dog:" + self.name
    #|  }
    #|  fn score(self : Dog, bonus : Int) -> Int {
    #|    self.name.length() + bonus
    #|  }
    #|}
    #|impl Describe for Int {
    #|  fn describe(self : Int) -> String {
    #|    "int:" + self.to_string()
    #|  }
    #|  fn score(self : Int, bonus : Int) -> Int {
    #|    self + bonus
    #|  }
    #|}
    #|pub struct Boxed {
    #|  item : dyn Describe
    #|}
    #|fn render(x : dyn Describe) -> String {
    #|  x.describe() + ":" + x.score(1).to_string()
    #|}
    #|fn make_dyn(flag : Bool) -> dyn Describe {
    #|  if flag {
    #|    Dog::{ name: "rex" }
    #|  } else {
    #|    42
    #|  }
    #|}
    #|pub fn main() -> Int {
    #|  let a : dyn Describe = Dog::{ name: "fido" }
    #|  let b = 7 as dyn Describe
    #|  let items : Array[dyn Describe] = [Dog::{ name: "a" }, 10]
    #|  items.push(Dog::{ name: "b" })
    #|  items.push(99)
    #|  let opt : Option[dyn Describe] = Some(Dog::{ name: "c" })
    #|  let opt2 : Option[dyn Describe] = None
    #|  let w = Boxed::{ item: 5 }
    #|  let _ = render(Dog::{ name: "d" })
    #|  let _ = render(a)
    #|  let _ = render(b)
    #|  let _ = render(w.item)
    #|  let _ = render(make_dyn(true))
    #|  let _ = match opt {
    #|    Some(v) => v.describe()
    #|    None => ""
    #|  }
    #|  let _ = match opt2 {
    #|    Some(v) => v.describe()
    #|    None => ""
    #|  }
    #|  items.length()
    #|}
  let (ok, json, _) = check_one(ok_src)
  assert_true(ok, "dyn Trait ok: " + json)
  let pkg = parse_package("demo", ["demo.pion"], [ok_src])
  let sig = emit_pionsig(pkg)
  assert_true(str_contains(sig, "dyn Describe"), "pionsig dyn: " + sig)

  // Cross-package `dyn pkg::Trait`
  let lib_src =
    #|pub trait Greet {
    #|  greet(self : Self) -> String
    #|}
    #|pub struct Bot {
    #|  id : Int
    #|}
    #|impl Greet for Bot {
    #|  fn greet(self : Bot) -> String {
    #|    "bot" + self.id.to_string()
    #|  }
    #|}
  let app_src =
    #|import "lib" as l
    #|pub fn say(x : dyn l::Greet) -> String {
    #|  x.greet()
    #|}
    #|pub fn main() -> Int {
    #|  let b = l::Bot::{ id: 1 }
    #|  let xs : Array[dyn l::Greet] = [b]
    #|  say(xs[0]).length()
    #|}
  let lib_cr = check_source_files_with_imports("lib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, "lib check")
  let app_cr = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_src],
    [imported_pkg_new("lib", lib_cr.tc)],
    true,
  )
  assert_true(
    app_cr.diagnostics.length() == 0,
    "cross-pkg dyn: " + check_result_to_json(app_cr.diagnostics),
  )

  // Reject == on dyn Trait
  let eq_src =
    #|trait T {
    #|  f(self : Self) -> Int
    #|}
    #|impl T for Int {
    #|  fn f(self : Int) -> Int { self }
    #|}
    #|pub fn bad(a : dyn T, b : dyn T) -> Bool {
    #|  a == b
    #|}
  let (eq_ok, eq_json, _) = check_one(eq_src)
  assert_true(!eq_ok && str_contains(eq_json, "no implicit pointer-identity comparison"), eq_json)

  // Reject non-object-safe trait (returning Self)
  let nos_src =
    #|trait Clone {
    #|  clone(self : Self) -> Self
    #|}
    #|pub fn bad(x : dyn Clone) -> Int {
    #|  0
    #|}
  let (nos_ok, nos_json, _) = check_one(nos_src)
  assert_true(!nos_ok && str_contains(nos_json, "not object-safe"), nos_json)

  // Reject non-Send dyn Trait in spawn
  let send_src =
    #|trait T {
    #|  f(self : Self) -> Int
    #|}
    #|impl T for Int {
    #|  fn f(self : Int) -> Int { self }
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let x : dyn T = 1
    #|  scope(world, fn(s : Scope) -> Unit {
    #|    spawn(s, fn() -> Unit {
    #|      let _ = x.f()
    #|    })
    #|  })
    #|  0
    #|}
  let (send_ok, send_json, _) = check_one(send_src)
  assert_true(!send_ok && str_contains(send_json, "E_NOT_SEND"), send_json)

  // Unimplemented type for dyn Trait emits E_TRAIT_NOT_IMPLEMENTED with impl edit
  let unimpl_src =
    "trait Describe {\n" +
    "  describe(self : Self) -> String\n" +
    "}\n" +
    "struct Cat {\n" +
    "  name : String\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let x : dyn Describe = Cat::{ name: \"m\" }\n" +
    "  x.describe().length()\n" +
    "}\n"
  expect_edit_fixes(unimpl_src, "E_TRAIT_NOT_IMPLEMENTED", "impl Describe for Cat {")
}

///|
test "p20a: 6 new machine-applicable edits complete 12/12 coverage" {
  // e01_type_mismatch: fn declared return type vs body type
  let e01 =
    "fn label(n : Int) -> Int {\n" +
    "  \"n=\" + n.to_string()\n" +
    "}\n" +
    "pub fn main(world : World) -> Int {\n" +
    "  io_println(world, label(3).to_string())\n" +
    "  0\n" +
    "}\n"
  expect_edit_fixes(e01, "E_TYPE_MISMATCH", "fn label(n : Int) -> String {")

  // e02_wrong_arity (extra argument)
  let e02_extra =
    "fn add(a : Int, b : Int) -> Int {\n" +
    "  a + b\n" +
    "}\n" +
    "pub fn main(world : World) -> Int {\n" +
    "  io_println(world, add(1, 2, 3).to_string())\n" +
    "  0\n" +
    "}\n"
  expect_edit_fixes(e02_extra, "E_TYPE_MISMATCH", "add(1, 2).to_string()")

  // e02_wrong_arity (missing argument)
  let e02_missing =
    "fn add(a : Int, b : Int) -> Int {\n" +
    "  a + b\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  add(1)\n" +
    "}\n"
  expect_edit_fixes(e02_missing, "E_TYPE_MISMATCH", "add(1, 0)")

  // e03_unknown_field (Levenshtein <= 2 typo)
  let e03 =
    "pub struct User {\n" +
    "  name : String\n" +
    "  age : Int\n" +
    "}\n" +
    "pub fn main(world : World) -> Int {\n" +
    "  let u = User::{ name: \"ada\", age: 36 }\n" +
    "  io_println(world, u.agee.to_string())\n" +
    "  0\n" +
    "}\n"
  expect_edit_fixes(e03, "E_TYPE_MISMATCH", "u.age.to_string()")

  // e06_missing_trait_impl (generic bound)
  let e06 =
    "pub trait Describe {\n" +
    "  describe(self : Self) -> String\n" +
    "}\n" +
    "pub struct Point {\n" +
    "  x : Int\n" +
    "  y : Int\n" +
    "}\n" +
    "impl Describe for Int {\n" +
    "  fn describe(self : Int) -> String {\n" +
    "    \"int \" + self.to_string()\n" +
    "  }\n" +
    "}\n" +
    "fn show_all[T : Describe](x : T) -> String {\n" +
    "  x.describe()\n" +
    "}\n" +
    "pub fn main(world : World) -> Int {\n" +
    "  io_println(world, show_all(1))\n" +
    "  io_println(world, show_all(Point::{ x: 1, y: 2 }))\n" +
    "  0\n" +
    "}\n"
  expect_edit_fixes(e06, "E_TRAIT_NOT_IMPLEMENTED", "impl Describe for Point {")

  // e10_missing_capability (adds `world : World, ` to enclosing function)
  let e10 =
    "fn load_config(path : String) -> String {\n" +
    "  match fs_read(path) {\n" +
    "    Ok(s) => s\n" +
    "    Err(_) => \"\"\n" +
    "  }\n" +
    "}\n" +
    "pub fn main(world : World) -> Int {\n" +
    "  io_println(world, load_config(\"/etc/hosts\"))\n" +
    "  0\n" +
    "}\n"
  let (ok10, json10, diags10) = check_one(e10)
  assert_true(!ok10 && str_contains(json10, "E_CAPABILITY_MISSING"), json10)
  assert_true(all_edits(diags10).length() > 0, "e10 edits: " + json10)
  let patched10 = apply_edits(e10, "test.pion", all_edits(diags10))
  assert_true(
    str_contains(patched10, "fn load_config(world : World, path : String) -> String {"),
    patched10,
  )
  // Applying the edit removes E_CAPABILITY_MISSING; only caller arity remains.
  let (_, json10_2, _) = check_one(patched10)
  assert_true(!str_contains(json10_2, "E_CAPABILITY_MISSING"), json10_2)

  // e08_data_race_send (wraps non-Send Array in Mutex::new(...))
  let e08 =
    "pub fn main(world : World) -> Int {\n" +
    "  let hits : Array[Int] = []\n" +
    "  scope(world, fn(s : Scope) -> Unit {\n" +
    "    for w in 0..4 {\n" +
    "      spawn(s, fn() -> Unit {\n" +
    "        hits.push(w)\n" +
    "      })\n" +
    "    }\n" +
    "  })\n" +
    "  io_println(world, hits.length().to_string())\n" +
    "  0\n" +
    "}\n"
  let (ok08, json08, diags08) = check_one(e08)
  assert_true(!ok08 && str_contains(json08, "E_NOT_SEND"), json08)
  assert_true(all_edits(diags08).length() > 0, "e08 edits: " + json08)
  let patched08 = apply_edits(e08, "test.pion", all_edits(diags08))
  assert_true(
    str_contains(patched08, "let hits : Mutex[Array[Int]] = Mutex::new([])"),
    patched08,
  )
}

///|
test "p24a_map_key_and_empty_branch" {
  // Bug 5 / P27-C1: Map[K, V] rejects unsupported keys with E_MAP_KEY_TYPE
  let bad_map =
    #|pub fn f(m : Map[Double, String]) -> Int {
    #|  m.length()
    #|}
  let (ok_m, json_m, _) = check_one(bad_map)
  assert_true(!ok_m && str_contains(json_m, "E_MAP_KEY_TYPE"), json_m)

  // Map[String, Int], Map[Int, String], Map[Int64, String] and generic Map[K, V] are accepted
  let ok_map =
    #|pub fn g[K, V](m : Map[K, V]) -> Int {
    #|  m.length()
    #|}
    #|pub fn h(m : Map[String, Int]) -> Int {
    #|  m.length()
    #|}
    #|pub fn hi(m : Map[Int, String]) -> Int {
    #|  m.length()
    #|}
    #|pub fn hi64(m : Map[Int64, String]) -> Int {
    #|  m.length()
    #|}
  let (ok_g, json_g, _) = check_one(ok_map)
  assert_true(ok_g, json_g)

  // Bug 2: if/match with empty [] first branch infers concrete element type from other branch
  let ok_if =
    #|pub fn pick(cond : Bool, k : Int) -> Int {
    #|  let xs = if cond { [] } else { ["a", "b"] }
    #|  xs.push("c")
    #|  let ys = match k {
    #|    0 => []
    #|    _ => ["x", "y"]
    #|  }
    #|  ys.push("z")
    #|  xs.length() + ys.length()
    #|}
  let (ok_b2, json_b2, _) = check_one(ok_if)
  assert_true(ok_b2, json_b2)

  // Pushing wrong type into inferred Array[String] must fail type check
  let bad_if =
    #|pub fn bad_pick(cond : Bool) -> Int {
    #|  let xs = if cond { [] } else { ["a", "b"] }
    #|  xs.push(123)
    #|  xs.length()
    #|}
  let (ok_bad, json_bad, _) = check_one(bad_if)
  assert_true(!ok_bad && str_contains(json_bad, "E_TYPE_MISMATCH"), json_bad)
}

///|
test "p25a_extern_c_varargs_parse_and_sig" {
  let good =
    #|pub extern "C" fn sq3_config_i(op : Int, ..., v : Int) -> Int = "sqlite3_config"
    #|pub extern "C" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = "snprintf"
    #|pub fn call_em(buf : Ptr, fmt : Ptr) -> Int {
    #|  let a = sq3_config_i(9, 0)
    #|  let b = c_snprintf_0(buf, 64L, fmt)
    #|  a + b
    #|}
  let (ok_g, json_g, _) = check_one(good)
  assert_true(ok_g, json_g)
  let cr = check_source_files_full("p25a_va", ["p25a_va.pion"], [good])
  let sig = emit_pionsig(cr.pkg)
  assert_true(
    str_contains(
      sig,
      "extern \"C\" fn sq3_config_i(op: Int, ..., v: Int) -> Int = \"sqlite3_config\"",
    ),
    sig,
  )
  assert_true(
    str_contains(
      sig,
      "extern \"C\" fn c_snprintf_0(buf: Ptr, cap: Int64, fmt: Ptr, ...) -> Int = \"snprintf\"",
    ),
    sig,
  )
  let stub = emit_file_stub(cr.pkg.files[0])
  assert_true(
    str_contains(
      stub,
      "pub extern \"C\" fn sq3_config_i(op : Int, ..., v : Int) -> Int = \"sqlite3_config\"",
    ),
    stub,
  )
  assert_true(
    str_contains(
      stub,
      "pub extern \"C\" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = \"snprintf\"",
    ),
    stub,
  )

  // Leading `...` with no fixed parameter must be a syntax error
  let bad_leading =
    #|extern "C" fn bad(..., x : Int) -> Int = "bad"
  let (ok_l, json_l, _) = check_one(bad_leading)
  assert_true(!ok_l && str_contains(json_l, "at least one fixed parameter"), json_l)

  // Duplicate `...` must be a syntax error
  let bad_dup =
    #|extern "C" fn bad2(a : Int, ..., x : Int, ..., y : Int) -> Int = "bad2"
  let (ok_d, json_d, _) = check_one(bad_dup)
  assert_true(!ok_d && str_contains(json_d, "duplicate `...`"), json_d)

  // Range `0..n` still lexes as DotDot
  let ok_range =
    #|pub fn sum_n(n : Int) -> Int {
    #|  let mut acc = 0
    #|  for i in 0..n {
    #|    acc = acc + i
    #|  }
    #|  acc
    #|}
  let (ok_r, json_r, _) = check_one(ok_range)
  assert_true(ok_r, json_r)
}

///|
test "p26b_extern_c_body_c_fn_ptr_zero_copy_math_sb_debug_assert" {
  let good =
    #|pub extern "C" fn cb_add(a : Int, b : Int) -> Int = "my_cb_add" {
    #|  a + b
    #|}
    #|extern "C" fn cb_void(p : Ptr, x : Int) -> Unit {
    #|  ptr_write_i32(p, 0L, x)
    #|}
    #|extern "C" fn cb_str(s : String) -> String {
    #|  s + "!"
    #|}
    #|pub fn use_all(s : String, bs : Bytes, arr : Array[Double], p : Ptr) -> Double {
    #|  let _f1 : Ptr = c_fn_ptr(cb_add)
    #|  let _f2 : Ptr = c_fn_ptr(cb_void)
    #|  let _f3 : Ptr = c_fn_ptr(cb_str)
    #|  let _sp : Ptr = str_data_ptr(s)
    #|  let _bp : Ptr = bytes_data_ptr(bs)
    #|  let _ap : Ptr = array_data_ptr(arr)
    #|  ptr_write_f64(p, 0L, 1.5)
    #|  ptr_write_f32(p, 8L, 2.25)
    #|  let v = ptr_read_f64(p, 0L) + ptr_read_f32(p, 8L)
    #|  let sb = StringBuilder()
    #|  sb.write_byte(b'A')
    #|  sb.write_bytes(bs)
    #|  debug_assert(sb.length() >= 1, "sb len", )
    #|  v + math_tan(0.5) + math_asin(0.5) + math_acos(0.5) + math_atan(0.5) +
    #|    math_atan2(1.0, 2.0) + math_exp(1.0) + math_log(2.0) + math_round(1.6) + math_trunc(1.6)
    #|}
  let (ok_g, json_g, _) = check_one(good)
  assert_true(ok_g, json_g)

  // c_fn_ptr on a normal Pion fn must fail with E_TYPE_MISMATCH
  let bad_ptr =
    #|fn normal(x : Int) -> Int { x }
    #|fn f() -> Ptr { c_fn_ptr(normal) }
  let (ok_bp, json_bp, _) = check_one(bad_ptr)
  assert_true(
    !ok_bp && str_contains(json_bp, "E_TYPE_MISMATCH") && str_contains(json_bp, "c_fn_ptr requires an extern"),
    json_bp,
  )

  // variadic extern "C" fn with body must be a syntax error
  let bad_va_body =
    #|extern "C" fn bad_va(x : Int, ..., y : Int) -> Int { x + y }
  let (ok_va, json_va, _) = check_one(bad_va_body)
  assert_true(!ok_va && str_contains(json_va, "cannot be variadic"), json_va)
}

///|
test "p27a_ergonomics_and_bug4_frontend" {
  let src =
    #|struct Node {
    #|  id : Int
    #|  label : String
    #|}
    #|struct Pt {
    #|  mut x : Int
    #|  y : Int
    #|  tag : String
    #|}
    #|fn mk_pair(n : Node, flag : Bool) -> (Node, Option[Node]) {
    #|  if flag { (n, None) } else { (n, Some(n)) }
    #|}
    #|fn add2(a : Int, b : Int) -> Int { a + b }
    #|fn test_all(opt : Option[Int], arr : Array[Int], p : Pt) -> Int {
    #|  let a = 1e-9 + 1E9 + 1.797e308 + 1.0e+5 + 0.5e-3
    #|  let s = "\x41\x00\x42\xff"
    #|  let b = 42.to_double() + 10L.to_double() + a.abs().floor().ceil().round().trunc().sqrt()
    #|  let bits = b.to_bits()
    #|  let _b2 = Double::from_bits(bits)
    #|  let _i1 = b.to_int() + b.to_int64().to_int() + (-7).abs() + (-9L).abs().to_int()
    #|  let m : Map[String, Int] = Map::new()
    #|  m.set("k", 1)
    #|  m.clear()
    #|  42 |> add2(8) |> ignore
    #|  let mut acc = 0
    #|  acc += 10
    #|  acc -= 2
    #|  acc *= 3
    #|  acc /= 4
    #|  acc %= 5
    #|  acc |= 8
    #|  acc &= 15
    #|  acc ^= 1
    #|  let mut msg = "hi"
    #|  msg += s
    #|  arr[0] += 1
    #|  p.x += 2
    #|  guard acc >= 0 else { return -1 }
    #|  guard opt is Some(v) else { return 0 }
    #|  let mut sum = v
    #|  if opt is Some(w) && w > 0 {
    #|    sum += w
    #|  }
    #|  let _ok : Bool = opt is Some(_)
    #|  let mut cur : Option[Int] = Some(3)
    #|  while cur is Some(n) {
    #|    sum += n
    #|    cur = if n > 1 { Some(n - 1) } else { None }
    #|  }
    #|  for i in 0..<5 {
    #|    sum += i
    #|  }
    #|  for i in 0..=5 {
    #|    sum += i
    #|  }
    #|  for idx, elem in arr {
    #|    sum += idx + elem
    #|  }
    #|  let x = 1
    #|  let y = 2
    #|  let tag = "t"
    #|  let _p1 = Pt::{ x, y, tag }
    #|  let _p2 = Pt::{ ..p, x: 99 }
    #|  let n = Node::{ id: 1, label: "a" }
    #|  let (_, before) = mk_pair(n, true)
    #|  if before.is_none() { sum } else { 0 }
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, json)

  // Invalid \x escape in string literal must fail lexing
  let bad_hex =
    #|fn f() -> String { "\x4G" }
  let (ok_hx, json_hx, _) = check_one(bad_hex)
  assert_true(!ok_hx && str_contains(json_hx, "invalid hex escape"), json_hx)

  // Compound assignment on immutable variable must fail
  let bad_mut =
    #|fn f() -> Int { let x = 1; x += 2; x }
  let (ok_bm, json_bm, _) = check_one(bad_mut)
  assert_true(!ok_bm && str_contains(json_bm, "immutable"), json_bm)
}

///|
test "p27b_named_and_optional_params" {
  let src =
    #|struct View {
    #|  w : Double
    #|  h : Double
    #|  bg : Int64
    #|}
    #|fn View::pad(self : View, x~ : Double = 0.0, y~ : Double = 0.0) -> View {
    #|  View::{ w: self.w + x, h: self.h + y, bg: self.bg }
    #|}
    #|fn View::ground(self : View, color? : Int64) -> View {
    #|  let c = match color { Some(v) => v; None => self.bg }
    #|  View::{ w: self.w, h: self.h, bg: c }
    #|}
    #|fn box(w~ : Double = 0.0, h~ : Double = 0.0, bg? : Int64, label? : String) -> String {
    #|  let b = match bg { Some(v) => v.to_string(); None => "none" }
    #|  let l = match label { Some(s) => s; None => "-" }
    #|  "\{w}:\{h}:\{b}:\{l}"
    #|}
    #|fn req_labeled(w~ : Double, scale~ : Double = 1.0) -> Double {
    #|  w * scale
    #|}
    #|fn scale_val(x : Double, factor~ : Double = 2.0) -> Double {
    #|  x * factor
    #|}
    #|fn pick[T](base : T, alt? : T) -> T {
    #|  match alt { Some(v) => v; None => base }
    #|}
    #|fn main() -> Int {
    #|  let _s0 = box()
    #|  let _s1 = box(bg=255L, w=120.0)
    #|  let w = 64.0
    #|  let _s2 = box(w~, label="hi")
    #|  let opt_bg : Option[Int64] = Some(16L)
    #|  let _s3 = box(bg?=opt_bg)
    #|  let _r1 = req_labeled(w=5.0)
    #|  let _r2 = 10.0 |> scale_val(factor=2.5)
    #|  let _p1 = pick(1)
    #|  let _p2 = pick(1, alt=2)
    #|  let v = View::{ w: 10.0, h: 20.0, bg: 0L }
    #|  let v2 = v.pad(x=12.0, y=8.0).ground(color=0xFFFFFFL)
    #|  v2.w.to_int()
    #|}
  let (ok, json, _) = check_one(src)
  assert_true(ok, json)

  // Negative: unknown named argument with typo suggestion
  let bad_unknown =
    #|fn f(width~ : Double = 0.0) -> Double { width }
    #|fn main() -> Double { f(widht=1.0) }
  let (ok_u, json_u, _) = check_one(bad_unknown)
  assert_true(
    !ok_u && str_contains(json_u, "unknown named argument") && str_contains(json_u, "width"),
    json_u,
  )

  // Negative: duplicate named argument
  let bad_dup =
    #|fn f(w~ : Double = 0.0) -> Double { w }
    #|fn main() -> Double { f(w=1.0, w=2.0) }
  let (ok_d, json_d, _) = check_one(bad_dup)
  assert_true(!ok_d && str_contains(json_d, "duplicate argument"), json_d)

  // Negative: missing required labeled argument
  let bad_missing =
    #|fn f(w~ : Double, h~ : Double = 1.0) -> Double { w + h }
    #|fn main() -> Double { f(h=2.0) }
  let (ok_m, json_m, _) = check_one(bad_missing)
  assert_true(
    !ok_m && str_contains(json_m, "missing required argument") && str_contains(json_m, "w"),
    json_m,
  )

  // Negative: default value type mismatch
  let bad_def =
    #|fn f(w~ : Double = "oops") -> Double { w }
  let (ok_def, json_def, _) = check_one(bad_def)
  assert_true(!ok_def && str_contains(json_def, "default value type mismatch"), json_def)
}

///|
test "p27c1_intmap_and_derive_eq" {
  let ok_src =
    #|#derive(Eq)
    #|pub struct NodeId {
    #|  id : Int
    #|  tag : String
    #|}
    #|#[derive(Eq, Hash, Debug)]
    #|pub enum Token {
    #|  Empty
    #|  Num(Int, Double)
    #|  Ref(NodeId)
    #|}
    #|pub fn test_all() -> Bool {
    #|  let m : Map[Int, String] = Map::new()
    #|  m.set(0, "zero")
    #|  m.set(-5, "neg")
    #|  let ks : Array[Int] = m.keys()
    #|  let m64 : Map[Int64, Int] = Map([])
    #|  m64.set(100L, 1)
    #|  let mx : Mutex[Map[Int, String]] = Mutex::new(m)
    #|  let _ = mx
    #|  let a = NodeId::{ id: 1, tag: "x" }
    #|  let b = NodeId::{ id: 1, tag: "x" }
    #|  let t1 = Ref(a)
    #|  let t2 = Ref(b)
    #|  a == b && t1 == t2 && t1 != Empty && ks.length() == 2
    #|}
  let (ok, json, _) = check_one(ok_src)
  assert_true(ok, json)

  // Negative: #derive(Eq) with non-Eq field must fail with E_TYPE_MISMATCH
  let bad_eq =
    #|struct Plain { x : Int }
    #|#derive(Eq)
    #|struct BadWrap { p : Plain }
  let (ok_bad, json_bad, _) = check_one(bad_eq)
  assert_true(!ok_bad && str_contains(json_bad, "E_TYPE_MISMATCH"), json_bad)
}

///|
test "p27c2_float_uint_fixedarray_frontend" {
  let ok_src =
    #|#derive(Eq)
    #|pub struct Color {
    #|  r : Float
    #|  g : Float
    #|  rgba : UInt
    #|  hash : UInt64
    #|}
    #|extern "C" fn c_scale(x : Float, mask : UInt, big : UInt64) -> Float
    #|pub fn test_all() -> Bool {
    #|  let mut f : Float = 1.5
    #|  f += 0.5
    #|  let f2 = 2.0f + Float::from_int(3) + Float::from_double(0.25)
    #|  let bits : Int = f2.to_bits()
    #|  let f3 : Float = Float::from_bits(bits)
    #|  let d : Double = f3.to_double()
    #|  let f4 : Float = d.to_float().abs().sqrt().floor().ceil().round().trunc()
    #|  let opt_f : Option[Float] = Some(f4)
    #|  let _ = opt_f
    #|  let mut u : UInt = 0xFFFF_FFFFU
    #|  u >>= 1
    #|  u /= 2U
    #|  let u64 : UInt64 = 0xFFFF_FFFF_FFFF_FFFFUL
    #|  let q64 : UInt64 = u64 / 10UL
    #|  let r64 : UInt64 = u64 % 10UL
    #|  let s64 : String = q64.to_string() + r64.to_string() + u.to_string() + f.to_string()
    #|  let fa : FixedArray[Float] = [1.0, 2.0, 3.0]
    #|  let fb : FixedArray[Float] = FixedArray::make(3, 0.5)
    #|  let fc : FixedArray[Int] = FixedArray::makei(4, fn(i : Int) -> Int { i * 2 })
    #|  let fd : FixedArray[Int] = FixedArray::from_array([10, 20])
    #|  let am : Array[Int] = Array::make(3, 7)
    #|  fa.fill(1.25)
    #|  fa.blit_to(fb, len=2, src_offset=0, dst_offset=1)
    #|  let cp : FixedArray[Float] = fa.copy()
    #|  let p : Ptr = array_data_ptr(fa)
    #|  let _ = (p, cp, fc, fd, am, s64)
    #|  let c1 = Color::{ r: 1.0, g: 0.5, rgba: 0xFF00FF00U, hash: 123UL }
    #|  let c2 = Color::{ r: 1.0, g: 0.5, rgba: 0xFF00FF00U, hash: 123UL }
    #|  let _ = c_scale(1.0, 1U, 1UL)
    #|  c1 == c2 && fb.length() == 3
    #|}
  let (ok, json, _) = check_one(ok_src)
  assert_true(ok, json)

  // Negative: FixedArray[T] must reject .push()
  let bad_push =
    #|fn f() -> Unit {
    #|  let fa : FixedArray[Int] = FixedArray::make(2, 0)
    #|  fa.push(1)
    #|}
  let (ok_p, json_p, _) = check_one(bad_push)
  assert_true(!ok_p && str_contains(json_p, "E_TYPE_MISMATCH"), json_p)

  // Negative: FixedArray[Int] is distinct from Array[Int]
  let bad_mix =
    #|fn f(a : Array[Int]) -> Int { a.length() }
    #|fn g() -> Int {
    #|  let fa : FixedArray[Int] = FixedArray::make(2, 0)
    #|  f(fa)
    #|}
  let (ok_m, json_m, _) = check_one(bad_mix)
  assert_true(!ok_m && str_contains(json_m, "E_TYPE_MISMATCH"), json_m)
}

///|
test "p29b2_bug8_infer_empty_collection_let" {
  // `let out = []` takes its element type from the first `push`.
  let push_src =
    #|pub fn collect(n : Int) -> Array[String] {
    #|  let out = []
    #|  let mut i = 0
    #|  while i < n {
    #|    let s = "item-" + i.to_string()
    #|    out.push(s)
    #|    i += 1
    #|  }
    #|  out
    #|}
    #|pub fn first_len() -> Int {
    #|  let names = []
    #|  if true {
    #|    names.push("x")
    #|  }
    #|  let n : Int = names.length()
    #|  let w : Array[String] = names
    #|  n + w.length()
    #|}
  let (ok_p, json_p, _) = check_one(push_src)
  assert_true(ok_p, json_p)

  // ... or from the return type when it is returned / is the block's tail.
  let ret_src =
    #|pub fn empty_tail() -> Array[Int] {
    #|  let out = []
    #|  out
    #|}
    #|pub fn early(flag : Bool) -> Array[String] {
    #|  let out = []
    #|  if flag {
    #|    return out
    #|  }
    #|  ["a"]
    #|}
    #|pub fn map_tail() -> Map[String, Int] {
    #|  let m = Map([])
    #|  m
    #|}
    #|pub fn map_set() -> Int {
    #|  let m = Map([])
    #|  m.set(1, "one")
    #|  let m2 = Map::new()
    #|  m2["k"] = [1, 2]
    #|  let a : Map[Int, String] = m
    #|  let b : Map[String, Array[Int]] = m2
    #|  a.length() + b.length()
    #|}
  let (ok_r, json_r, _) = check_one(ret_src)
  assert_true(ok_r, json_r)

  // Element types inferred this way are enforced like annotations.
  let mismatch_src =
    #|pub fn f() -> Int {
    #|  let out = []
    #|  out.push("x")
    #|  out.push(1)
    #|  out.length()
    #|}
  let (ok_m, json_m, _) = check_one(mismatch_src)
  assert_true(!ok_m && str_contains(json_m, "E_TYPE_MISMATCH"), json_m)

  // Nothing to infer from: E_MISSING_TYPE instead of a silent `Array[?]`.
  let bad_src =
    #|pub fn f() -> Int {
    #|  let x = []
    #|  let m = Map([])
    #|  x.length() + m.length()
    #|}
  let (ok_b, json_b, diags_b) = check_one(bad_src)
  assert_true(!ok_b, json_b)
  assert_true(diags_b.length() == 2, json_b)
  assert_true(diags_b[0].code == "E_MISSING_TYPE" && diags_b[0].line == 2, json_b)
  assert_true(diags_b[1].code == "E_MISSING_TYPE" && diags_b[1].line == 3, json_b)
  assert_true(str_contains(json_b, "Array[T]"), json_b)
  assert_true(str_contains(json_b, "Map[K, V]"), json_b)

  // A shadowing rebinding hides the outer `out` from the tail witness.
  let shadow_src =
    #|pub fn f() -> Array[Int] {
    #|  let out = []
    #|  let out : Array[Int] = [1]
    #|  out
    #|}
  let (ok_s, json_s, diags_s) = check_one(shadow_src)
  assert_true(!ok_s && diags_s[0].code == "E_MISSING_TYPE" && diags_s[0].line == 2, json_s)
}

///|
test "p30a_closure_mut_capture_assign_rejected" {
  // P31-A: local non-spawn closures auto-box captured `let mut` variables for shared read/write.
  let ok_assign =
    #|fn run_fn(cb : () -> Unit) -> Unit {
    #|  cb()
    #|}
    #|pub fn f() -> Bool {
    #|  let mut hit = false
    #|  run_fn(fn() -> Unit {
    #|    hit = true
    #|  })
    #|  hit
    #|}
  let (ok1, json1, _) = check_one(ok_assign)
  assert_true(ok1, json1)

  let ok_compound =
    #|fn run_fn(cb : () -> Unit) -> Unit {
    #|  cb()
    #|}
    #|pub fn f() -> Int {
    #|  let mut n = 0
    #|  run_fn(fn() -> Unit {
    #|    n += 1
    #|  })
    #|  n
    #|}
  let (ok2, json2, _) = check_one(ok_compound)
  assert_true(ok2, json2)

  // Concurrency red line: `spawn` still strictly rejects capturing outer `let mut`
  // (both directly and through a nested closure).
  let bad_spawn_mut =
    #|pub fn bad(world : World) -> Int {
    #|  let mut n = 0
    #|  scope(world, fn(s : Scope) -> Unit {
    #|    spawn(s, fn() -> Unit {
    #|      let bump = fn() -> Unit { n += 1 }
    #|      bump()
    #|    })
    #|  })
    #|  n
    #|}
  let (ok_sp, json_sp, diags_sp) = check_one(bad_spawn_mut)
  assert_true(!ok_sp && diags_sp.length() >= 1 && diags_sp[0].code == "E_NOT_SEND", json_sp)

  // Local `let mut` inside the closure, and mutating a `mut` struct field or Array element, are allowed.
  let ok_src =
    #|struct Cell {
    #|  mut v : Int
    #|}
    #|fn run_fn(cb : () -> Unit) -> Unit {
    #|  cb()
    #|}
    #|pub fn f() -> Int {
    #|  let c = Cell::{ v: 0 }
    #|  let a : Array[Int] = [0]
    #|  run_fn(fn() -> Unit {
    #|    let mut local_n = 1
    #|    local_n += 2
    #|    c.v = local_n
    #|    a[0] = local_n
    #|  })
    #|  c.v + a[0]
    #|}
  let (ok3, json3, _) = check_one(ok_src)
  assert_true(ok3, json3)
}

