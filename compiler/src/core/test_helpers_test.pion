///|
fn assert_eq[T](a : T, b : T) -> Unit {
  if a != b {
    abort("assert_eq failed")
  }
}

///|
fn assert_not_eq[T](a : T, b : T) -> Unit {
  if a == b {
    abort("assert_not_eq failed")
  }
}

///|
fn t_str_find(haystack : String, needle : String) -> Option[Int] {
  let hl = haystack.length()
  let nl = needle.length()
  if nl == 0 {
    return Some(0)
  }
  if nl > hl {
    return None
  }
  let mut i = 0
  while i + nl <= hl {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if str_code_at(haystack, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return Some(i)
    }
    i = i + 1
  }
  None
}

///|
fn t_str_slice(s : String, start : Int, end : Int) -> String {
  let sl = s.length()
  let mut a = start
  if a < 0 {
    a = 0
  }
  if a > sl {
    a = sl
  }
  let mut b = end
  if b < a {
    b = a
  }
  if b > sl {
    b = sl
  }
  let sb = StringBuilder()
  sb_write_range(sb, s, a, b)
  sb.to_string()
}

///|
fn t_str_from(s : String, start : Int) -> String {
  t_str_slice(s, start, s.length())
}

///|
fn t_str_to(s : String, end : Int) -> String {
  t_str_slice(s, 0, end)
}

///|
test "lexer: multiline raw string #| literals and #derive coexistence" {
  let raw =
    #|line 1 with "quotes" and \n \x41 \{no_interp}
    #|
    #|line 3 UTF-8: 你好🚀
  assert_eq(
    raw,
    "line 1 with \"quotes\" and \\n \\x41 \\{no_interp}\n\nline 3 UTF-8: 你好🚀",
  )
  let crlf_lex = lex("raw.pion", "#|alpha\r\n  #|beta\r\n#derive(Eq)")
  assert_eq(crlf_lex.diagnostics.length(), 0)
  let mut saw_str = false
  let mut saw_hash = false
  let mut i = 0
  while i < crlf_lex.tokens.length() {
    match crlf_lex.tokens[i].kind {
      StringLit(v) => {
        assert_eq(v, "alpha\nbeta")
        saw_str = true
      }
      Hash => saw_hash = true
      _ => ()
    }
    i = i + 1
  }
  assert_eq(saw_str, true)
  assert_eq(saw_hash, true)
}
