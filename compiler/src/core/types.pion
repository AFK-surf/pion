                  )
                }
              } else {
                let ity = check_expr(tc, env, args[ai], Some(TInt))
                if !ty_compat(TInt, ity) {
                  tc_err(
                    tc,
                    expr_span(args[ai]),
                    "E_TYPE_MISMATCH",
                    "`FixedArray::blit_to` offset/length expects `Int`",
                    "Int",
                    ty_to_string(ity),
                    "pass an `Int` value",
                  )
                }
              }
              pos_idx = pos_idx + 1
            }
          }
          ai = ai + 1
        }
        return TUnit
      }
    }
    TImmArray(elem) => {
      if method_name == "length" || method_name == "is_empty" || method_name == "copy" || method_name == "to_array" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`ImmArray::" + method_name + "` expects 0 arguments, found " + args.length().to_string(),
            "0 args",
            args.length().to_string() + " args",
            "call `." + method_name + "()` with no arguments",
          )
        }
        if method_name == "length" {
          return TInt
        }
        if method_name == "is_empty" {
          return TBool
        }
        if method_name == "copy" {
          return TImmArray(elem)
        }
        return TArray(elem)
      }
    }
    TMap(kty, vty) => {
      if method_name == "length" {
        return TInt
      }
      if method_name == "set" {
        if args.length() >= 2 {
          let ak = check_expr(tc, env, args[0], Some(kty))
          let av = check_expr(tc, env, args[1], Some(vty))
          if !ty_compat(kty, ak) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`Map::set` key type mismatch",
              ty_to_string(kty),
              ty_to_string(ak),
              "use a key of type `" + ty_to_string(kty) + "`",
            )
          }
          if !ty_compat(vty, av) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`Map::set` value type mismatch",
              ty_to_string(vty),
              ty_to_string(av),
              "use a value of type `" + ty_to_string(vty) + "`",
            )
          }
          if ty_has_unresolved(kty) || ty_has_unresolved(vty) {
            tc.infer_hit.clear()
            tc.infer_hit.push(ak)
            tc.infer_hit.push(av)
          }
        }
        return TUnit
      }
      if method_name == "get" {
        if args.length() >= 1 {
          let _ = check_expr(tc, env, args[0], Some(kty))
        }
        return TOption(vty)
      }
      if method_name == "contains" || method_name == "remove" {
        if args.length() >= 1 {
          let _ = check_expr(tc, env, args[0], Some(kty))
        }
        return if method_name == "contains" { TBool } else { TUnit }
      }
      if method_name == "keys" {
        return TArray(kty)
      }
      if method_name == "copy" {
        return TMap(kty, vty)
      }
      if method_name == "clear" {
        check_no_args(tc, env, method_name, args, sp)
        return TUnit
      }
    }
    TChannel(elem) => {
      if method_name == "send" {
        if args.length() >= 1 {
          let arg = args[0]
          let is_explicit_move = match arg {
            EMove(_, _) => true
            _ => false
          }
          let aty = check_expr(tc, env, arg, Some(elem))
          if !ty_compat(elem, aty) {
            tc_err(
              tc,
              expr_span(arg),
              "E_TYPE_MISMATCH",
              "`Channel::send` value type mismatch",
              ty_to_string(elem),
              ty_to_string(aty),
              "send a value of type `" + ty_to_string(elem) + "`",
            )
          }
          if !is_explicit_move && !is_send_ty(tc, aty, []) {
            tc_err(
              tc,
              expr_span(arg),
              "E_NOT_SEND",
              "cannot send non-Send value of type `" +
              ty_to_string(aty) +
              "` over `Channel`",
              "Send",
              ty_to_string(aty),
              "wrap value in `Mutex::new(...)` or transfer ownership with `move`",
            )
          }
        }
        return TBool
      }
      if method_name == "recv" {
        return TOption(elem)
      }
      if method_name == "close" {
        return TUnit
      }
    }
    TMutex(elem) => {
      if method_name == "lock" {
        return elem
      }
      if method_name == "set" {
        if args.length() >= 1 {
          let aty = check_expr(tc, env, args[0], Some(elem))
          if !ty_compat(elem, aty) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`Mutex::set` value type mismatch",
              ty_to_string(elem),
              ty_to_string(aty),
              "pass a value of type `" + ty_to_string(elem) + "`",
            )
          }
        }
        return TUnit
      }
      if method_name == "unlock" {
        return TUnit
      }
      if method_name == "with_lock" {
        if args.length() >= 1 {
          let exp_ret = match expected {
            Some(t) => t
            None => TError
          }
          let fty = check_expr(tc, env, args[0], Some(TFn([elem], exp_ret)))
          match fty {
            TFn(_, ret) => return ret
            _ => ()
          }
        }
        return match expected {
          Some(t) => t
          None => TUnit
        }
      }
    }
    TAtomicInt => {
      if method_name == "load" {
        return TInt
      }
      if method_name == "store" {
        if args.length() >= 1 {
          let _ = check_expr(tc, env, args[0], Some(TInt))
        }
        return TUnit
      }
      if method_name == "fetch_add" {
        if args.length() >= 1 {
          let _ = check_expr(tc, env, args[0], Some(TInt))
        }
        return TInt
      }
    }
    TStruct(sname, sargs) | TEnum(sname, sargs) => {
      let key = sname + "::" + method_name
      match tc.methods.get(key) {
        Some(minfo) => {
          let subst : Map[String, Ty] = Map([])
          if minfo.param_tys.length() > 0 {
            unify_tparams(minfo.param_tys[0], recv_ty, subst)
          }
          match expected {
            Some(exp_ty) => unify_tparams(minfo.ret_ty, exp_ty, subst)
            None => ()
          }
          // Skip `self` parameter (index 0)
          let use_named = params_need_named_resolution(minfo.decl.params, 1, args)
          let mut resolved_args = args
          let mut missing_flags : Array[Bool] = []
          let mut default_flags : Array[Bool] = []
          let mut raw_indices : Array[Int] = []
          let mut opt_wrapped_flags : Array[Bool] = []
          if use_named {
            let res = resolve_call_args_impl(
              Some(tc),
              minfo.decl.params,
              1,
              args,
              key,
              sp,
            )
            resolved_args = res.args
            missing_flags = res.missing
            default_flags = res.from_default
            raw_indices = res.raw_idx
            opt_wrapped_flags = res.opt_wrapped
          } else {
            let want_args = if minfo.param_tys.length() > 0 {
              minfo.param_tys.length() - 1
            } else {
              0
            }
            if args.length() != want_args {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "method `" +
                key +
                "` expects " +
                want_args.to_string() +
                " argument(s), found " +
                args.length().to_string(),
                want_args.to_string() + " args",
                args.length().to_string() + " args",
                "pass " + want_args.to_string() + " argument(s)",
              )
            }
          }
          let fnval_exp : Array[String] = []
          let mut fi_init = 0
          while fi_init < resolved_args.length() {
            fnval_exp.push("")
            fi_init = fi_init + 1
          }
          let defer_flags : Array[Bool] = []
          let mut has_deferred = false
          let mut di_init = 0
          while di_init < resolved_args.length() {
            let is_miss = di_init < missing_flags.length() && missing_flags[di_init]
            let is_def = di_init < default_flags.length() && default_flags[di_init]
            let is_opt_wrap = use_named && di_init < opt_wrapped_flags.length() && opt_wrapped_flags[di_init]
            let p_idx_i = di_init + 1
            let p_has_tp = p_idx_i < minfo.param_tys.length() &&
              ty_has_tparam(subst_ty(minfo.param_tys[p_idx_i], subst))
            let dcl = !is_miss &&
              !is_def &&
              p_has_tp &&
              expr_is_unannotated_closure_arg(resolved_args[di_init], is_opt_wrap)
            defer_flags.push(dcl)
            if dcl {
              has_deferred = true
            }
            di_init = di_init + 1
          }
          let check_order : Array[Int] = []
          if !use_named {
            let mut si = 0
            while si < resolved_args.length() {
              if !(si < missing_flags.length() && missing_flags[si]) {
                check_order.push(si)
              }
              si = si + 1
            }
          } else {
            let raw_to_slot : Array[Int] = []
            let mut rinit = 0
            while rinit < args.length() {
              raw_to_slot.push(-1)
              rinit = rinit + 1
            }
            let def_slots : Array[Int] = []
            let mut si = 0
            while si < resolved_args.length() {
              if !(si < missing_flags.length() && missing_flags[si]) {
                let ridx = if si < raw_indices.length() { raw_indices[si] } else { -1 }
                if ridx >= 0 && ridx < raw_to_slot.length() && raw_to_slot[ridx] < 0 {
                  raw_to_slot[ridx] = si
                } else {
                  def_slots.push(si)
                }
              }
              si = si + 1
            }
            let mut rk = 0
            while rk < raw_to_slot.length() {
              if raw_to_slot[rk] >= 0 {
                check_order.push(raw_to_slot[rk])
              }
              rk = rk + 1
            }
            let mut dsi = 0
            while dsi < def_slots.length() {
              check_order.push(def_slots[dsi])
              dsi = dsi + 1
            }
          }
          let mut pass = 0
          while pass < 2 {
          if pass == 1 && !has_deferred {
            break
          }
          let mut ci = 0
          while ci < check_order.length() {
            let i = check_order[ci]
            let p_idx = i + 1
            let is_def = i < default_flags.length() && default_flags[i]
            let defer_cl = defer_flags[i]
            if (pass == 0 && defer_cl) || (pass == 1 && !defer_cl) {
              ci = ci + 1
              continue
            }
            let p_is_into = !is_def && param_is_into_at(minfo.decl.params, p_idx)
            let raw_i = if use_named {
              if i < raw_indices.length() { raw_indices[i] } else { -1 }
            } else {
              i
            }
            let is_opt_wrap = use_named && i < opt_wrapped_flags.length() && opt_wrapped_flags[i]
            let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
              Some(subst_ty_mask_unbound(minfo.param_tys[p_idx], minfo.decl.type_params, subst))
            } else {
              None
            }
            let arg_env = if is_def {
              let mtp : Array[String] = []
              match tc.structs.get(sname) {
                Some(si) => {
                  let mut ti = 0
                  while ti < si.decl.type_params.length() {
                    mtp.push(si.decl.type_params[ti])
                    ti = ti + 1
                  }
                }
                None =>
                  match tc.enums.get(sname) {
                    Some(ei) => {
                      let mut ti = 0
                      while ti < ei.decl.type_params.length() {
                        mtp.push(ei.decl.type_params[ti])
                        ti = ti + 1
                      }
                    }
                    None => ()
                  }
              }
              let mut ti = 0
              while ti < minfo.decl.type_params.length() {
                if !str_arr_contains(mtp, minfo.decl.type_params[ti]) {
                  mtp.push(minfo.decl.type_params[ti])
                }
                ti = ti + 1
              }
              make_default_arg_env(tc, env, minfo.decl, minfo.param_tys, subst, p_idx, mtp, minfo.is_imported)
            } else {
              env
            }
            let mut handled_opt_into = false
            if p_is_into && is_opt_wrap && raw_i >= 0 {
              match resolved_args[i] {
                ECall(_, some_args, _) =>
                  if some_args.length() == 1 {
                    match exp_p {
                      Some(TOption(inner_target)) => {
                        handled_opt_into = true
                        let inner_arg = some_args[0]
                        let inner_exp = into_adjust_arg_expected(tc, inner_arg, Some(inner_target), true)
                        let inner_aty = check_expr(tc, arg_env, inner_arg, inner_exp)
                        if !ty_compat(inner_target, inner_aty) {
                          let ir = resolve_into_conversion(tc, arg_env, inner_aty, inner_target, expr_span(inner_arg))
                          match ir.conv {
                            Some(conv) =>
                              tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
                            None =>
                              if !ir.errored {
                                tc_err(
                                  tc,
                                  expr_span(inner_arg),
                                  "E_TYPE_MISMATCH",
                                  "argument type mismatch in method `" + key + "`",
                                  ty_to_string(inner_target),
                                  ty_to_string(inner_aty),
                                  "pass a value of type `" + ty_to_string(inner_target) + "`" + ir.available_hint,
                                )
                              }
                          }
                        }
                        if p_idx < minfo.param_tys.length() {
                          unify_tparams(minfo.param_tys[p_idx], TOption(inner_target), subst)
                        }
                      }
                      _ => ()
                    }
                  }
                _ => ()
              }
            }
            if !handled_opt_into {
              let unbound_param_tps : Array[String] = if pass == 1 &&
                defer_cl &&
                !is_def &&
                p_idx < minfo.param_tys.length() {
                collect_unbound_fn_param_tparams(
                  minfo.param_tys[p_idx],
                  is_opt_wrap,
                  minfo.decl.type_params,
                  subst,
                )
              } else {
                []
              }
              let diag_mark = tc.diagnostics.length()
              let eq_uses_mark = tc.eq_uses.length()
              let op_key_mark = tc.op_keys.length()
              let op_cur_len = if env.fn_key != "" {
                match tc.op_tparams.get(env.fn_key) {
                  Some(a) => a.length()
                  None => 0
                }
              } else {
                0
              }
              let arg_exp = if is_def && p_idx < minfo.param_tys.length() {
                Some(minfo.param_tys[p_idx])
              } else {
                into_adjust_arg_expected(tc, resolved_args[i], exp_p, p_is_into)
              }
              let saved_tc_def = tc.in_default_arg_expansion
              let saved_tc_imp_def = tc.in_imported_default_arg
              if is_def {
                tc.in_default_arg_expansion = true
                if minfo.is_imported {
                  tc.in_imported_default_arg = true
                }
              }
              let mut aty = check_call_arg(
                tc,
                arg_env,
                param_at(minfo.decl.params, p_idx),
                resolved_args[i],
                arg_exp,
                key,
              )
              tc.in_default_arg_expansion = saved_tc_def
              tc.in_imported_default_arg = saved_tc_imp_def
              if !is_def {
                fnval_exp[i] = tc_fnval_exp_key(arg_exp)
              }
              if p_idx < minfo.param_tys.length() {
                let mut eff_aty = if is_def { subst_ty(aty, subst) } else { aty }
                let pre_pty = subst_ty(minfo.param_tys[p_idx], subst)
                let mut into_errored = false
                let mut into_hint = ""
                if p_is_into && raw_i >= 0 && !ty_compat(pre_pty, aty) && !ty_has_unresolved(pre_pty) {
                  let ir = resolve_into_conversion(tc, env, aty, pre_pty, expr_span(resolved_args[i]))
                  match ir.conv {
                    Some(conv) => {
                      tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
                      eff_aty = pre_pty
                    }
                    None => {
                      into_errored = ir.errored
                      into_hint = ir.available_hint
                    }
                  }
                }
                unify_tparams(minfo.param_tys[p_idx], eff_aty, subst)
                if unbound_param_tps.length() > 0 && any_tparam_now_concrete(unbound_param_tps, subst) {
                  while tc.diagnostics.length() > diag_mark {
                    let _ = tc.diagnostics.pop()
                  }
                  while tc.eq_uses.length() > eq_uses_mark {
                    let _ = tc.eq_uses.pop()
                  }
                  if env.fn_key != "" {
                    match tc.op_tparams.get(env.fn_key) {
                      Some(a) => {
                        while a.length() > op_cur_len {
                          let _ = a.pop()
                        }
                        if op_cur_len == 0 {
                          tc.op_tparams.remove(env.fn_key)
                        }
                      }
                      None => ()
                    }
                  }
                  while tc.op_keys.length() > op_key_mark {
                    let _ = tc.op_keys.pop()
                  }
                  let exp_p2 : Option[Ty] = Some(
                    subst_ty_mask_unbound(minfo.param_tys[p_idx], minfo.decl.type_params, subst),
                  )
                  let arg_exp2 = into_adjust_arg_expected(tc, resolved_args[i], exp_p2, p_is_into)
                  aty = check_call_arg(
                    tc,
                    arg_env,
                    param_at(minfo.decl.params, p_idx),
                    resolved_args[i],
                    arg_exp2,
                    key,
                  )
                  fnval_exp[i] = tc_fnval_exp_key(arg_exp2)
                  eff_aty = aty
                  into_errored = false
                  into_hint = ""
                  let pre_pty2 = subst_ty(minfo.param_tys[p_idx], subst)
                  if p_is_into && raw_i >= 0 && !ty_compat(pre_pty2, aty) && !ty_has_unresolved(pre_pty2) {
                    let ir = resolve_into_conversion(tc, env, aty, pre_pty2, expr_span(resolved_args[i]))
                    match ir.conv {
                      Some(conv) => {
                        tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
                        eff_aty = pre_pty2
                      }
                      None => {
                        into_errored = ir.errored
                        into_hint = ir.available_hint
                      }
                    }
                  }
                  unify_tparams(minfo.param_tys[p_idx], eff_aty, subst)
                }
                let pty = subst_ty(minfo.param_tys[p_idx], subst)
                if !into_errored &&
                  (!ty_compat(pty, eff_aty) ||
                  (param_is_mut_at(minfo.decl.params, p_idx) && !ty_compat(eff_aty, pty))) {
                  tc_err(
                    tc,
                    expr_span(resolved_args[i]),
                    "E_TYPE_MISMATCH",
                    "argument type mismatch in method `" + key + "`",
                    ty_to_string(pty),
                    ty_to_string(eff_aty),
                    "pass a value of type `" + ty_to_string(pty) + "`" + into_hint,
                  )
                }
              }
            }
            ci = ci + 1
          }
          pass = pass + 1
          }
          tc_recheck_fn_value_args(
            tc,
            env,
            minfo.decl,
            minfo.param_tys,
            1,
            resolved_args,
            fnval_exp,
            subst,
            "in method `" + key + "`",
            false,
          )
          tc_check_type_bounds(tc, env, minfo.decl, subst, sp, minfo.is_imported)
          tc.resolved_method_calls.set(span_key(sp), sname + "::" + method_name)
          if fn_statically_diverges(minfo) {
            tc.never_calls.set(span_key(sp), true)
          }
          let mtarget = tc_qualify_local_name(tc, sname) + "::" + method_name
          tc_check_verify_callee(tc, env, minfo.decl, mtarget, sp)
          tc_record_call(tc, env, sp, mtarget, minfo.decl.type_params, subst)
          tc_record_arg_order(tc, env, sp, args, resolved_args)
          if use_named {
            tc_record_named_targs(tc, minfo.decl, subst, sp)
          }
          tc_push_eq_uses(tc, env, minfo.decl, key, subst, sp)
          if minfo.decl.type_params.length() > 0 {
            tc_record_gcall(tc, minfo.decl, subst, sp)
            tc.let_infer.set(span_key(sp) + "#gmeth", TStruct(sname, []))
          }
          return subst_ty_mask_unbound(minfo.ret_ty, minfo.decl.type_params, subst)
        }
        None => {
          let qp = split_qual_name(sname)
          let canon_pkg = qp.prefix
          let st_name = qp.name
          if canon_pkg.length() > 0 {
            match tc.imported_pkgs.get(canon_pkg) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(st_name + "::" + method_name) {
                  Some(mi) =>
                    if !mi.decl.is_pub {
                      emit_private_err(
                        tc,
                        sp,
                        "fn",
                        canon_pkg,
                        st_name + "::" + method_name,
                      )
                      return qualify_imported_ty(canon_pkg, mi.ret_ty)
                    }
                  None => ()
                }
              None => ()
            }
          }
          // Fallback: callable function-typed struct field (`d.refresh()`, `d.set_dpi(v, lod)`)
          let sinfo_opt : Option[StructInfo] = match tc.structs.get(sname) {
            Some(si) => Some(si)
            None =>
              if canon_pkg.length() > 0 {
                match lookup_imported_pkg_transitive(tc, canon_pkg) {
                  Some(ipkg) => ipkg.tc.structs.get(st_name)
                  None => None
                }
              } else {
                None
              }
          }
          match sinfo_opt {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut fi = 0
              while fi < sinfo.field_names.length() {
                if sinfo.field_names[fi] == method_name {
                  let raw_fty = if !tc.structs.contains(sname) && canon_pkg.length() > 0 {
                    qualify_imported_ty(canon_pkg, sinfo.field_tys[fi])
                  } else {
                    sinfo.field_tys[fi]
                  }
                  let fty = subst_ty(raw_fty, subst)
                  match fty {
                    TFn(ptys, rty) => {
                      if args.length() != ptys.length() {
                        tc_err(
                          tc,
                          sp,
                          "E_TYPE_MISMATCH",
                          "field `" +
                          sname +
                          "." +
                          method_name +
                          "` expects " +
                          ptys.length().to_string() +
                          " argument(s), found " +
                          args.length().to_string(),
                          ptys.length().to_string() + " args",
                          args.length().to_string() + " args",
                          "pass " + ptys.length().to_string() + " argument(s)",
                        )
                      }
                      let mut ai = 0
                      while ai < args.length() {
                        let exp_p : Option[Ty] = if ai < ptys.length() {
                          Some(ptys[ai])
                        } else {
                          None
                        }
                        let aty = check_expr(tc, env, args[ai], exp_p)
                        if ai < ptys.length() && !ty_compat(ptys[ai], aty) {
                          tc_err(
                            tc,
                            expr_span(args[ai]),
                            "E_TYPE_MISMATCH",
                            "argument type mismatch in call to `" + sname + "." + method_name + "`",
                            ty_to_string(ptys[ai]),
                            ty_to_string(aty),
                            "pass a value of type `" + ty_to_string(ptys[ai]) + "`",
                          )
                        }
                        ai = ai + 1
                      }
                      match rty {
                        TNever => tc.never_calls.set(span_key(sp), true)
                        _ => ()
                      }
                      tc.resolved_method_calls.set(span_key(sp), "@field::" + sname + "::" + method_name)
                      return rty
                    }
                    _ => ()
                  }
                  break
                }
                fi = fi + 1
              }
            }
            None => ()
          }
        }
      }
    }
    TDynTrait(tname) =>
      match lookup_trait_allow_private(tc, tname) {
        Some(tinfo) => {
          let mut mi = 0
          while mi < tinfo.methods.length() {
            let tm = tinfo.methods[mi]
            if tm.name == method_name {
              let want_args = if tm.param_tys.length() > 0 {
                tm.param_tys.length() - 1
              } else {
                0
              }
              if args.length() != want_args {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "trait method `dyn " +
                  tname +
                  "::" +
                  method_name +
                  "` expects " +
                  want_args.to_string() +
                  " argument(s), found " +
                  args.length().to_string(),
                  want_args.to_string() + " args",
                  args.length().to_string() + " args",
                  "pass " + want_args.to_string() + " argument(s)",
                )
              }
              let mut ai = 0
              while ai < args.length() {
                let p_idx = ai + 1
                let exp_p : Option[Ty] = if p_idx < tm.param_tys.length() {
                  Some(tm.param_tys[p_idx])
                } else {
                  None
                }
                let aty = check_expr(tc, env, args[ai], exp_p)
                if p_idx < tm.param_tys.length() && !ty_compat(tm.param_tys[p_idx], aty) {
                  tc_err(
                    tc,
                    expr_span(args[ai]),
                    "E_TYPE_MISMATCH",
                    "argument type mismatch in `dyn " +
                    tname +
                    "::" +
                    method_name +
                    "`",
                    ty_to_string(tm.param_tys[p_idx]),
                    ty_to_string(aty),
                    "pass a value of type `" + ty_to_string(tm.param_tys[p_idx]) + "`",
                  )
                }
                ai = ai + 1
              }
              match tm.ret_ty {
                TNever => tc.never_calls.set(span_key(sp), true)
                _ => ()
              }
              return tm.ret_ty
            }
            mi = mi + 1
          }
        }
        None => ()
      }
    TParam(tp_name) => {
      match env.type_bounds.get(tp_name) {
        Some(bound_traits) => {
          let self_subst : Map[String, Ty] = Map([])
          self_subst.set("Self", TParam(tp_name))
          let mut bi = 0
          while bi < bound_traits.length() {
            match lookup_trait(tc, bound_traits[bi]) {
              Some(tinfo) => {
                let mut mi = 0
                while mi < tinfo.methods.length() {
                  let tm = tinfo.methods[mi]
                  if tm.name == method_name {
                    let tm_params = if mi < tinfo.decl.methods.length() {
                      tinfo.decl.methods[mi].params
                    } else {
                      []
                    }
                    let mut ai = 0
                    while ai < args.length() {
                      let p_idx = ai + 1
                      let exp_p : Option[Ty] = if p_idx < tm.param_tys.length() {
                        Some(subst_ty(tm.param_tys[p_idx], self_subst))
                      } else {
                        None
                      }
                      let aty = check_call_arg(
                        tc,
                        env,
                        param_at(tm_params, p_idx),
                        args[ai],
                        exp_p,
                        bound_traits[bi] + "::" + method_name,
                      )
                      if p_idx < tm.param_tys.length() {
                        let pty = subst_ty(tm.param_tys[p_idx], self_subst)
                        if !ty_compat(pty, aty) {
                          tc_err(
                            tc,
                            expr_span(args[ai]),
                            "E_TYPE_MISMATCH",
                            "argument type mismatch in trait method `" +
                            bound_traits[bi] +
                            "::" +
                            method_name +
                            "`",
                            ty_to_string(pty),
                            ty_to_string(aty),
                            "pass a value of type `" + ty_to_string(pty) + "`",
                          )
                        }
                      }
                      ai = ai + 1
                    }
                    tc.resolved_trait_methods.set(
                      span_key(sp),
                      canon_trait_name(tc, bound_traits[bi]),
                    )
                    if env.in_verify || tc.record_analyze {
                      tc.call_targets.set(
                        span_key(sp),
                        bound_traits[bi] + "::" + tp_name + "::" + method_name,
                      )
                    }
                    let subst_rt = subst_ty(tm.ret_ty, self_subst)
                    match subst_rt {
                      TNever => tc.never_calls.set(span_key(sp), true)
                      _ => ()
                    }
                    return subst_rt
                  }
                  mi = mi + 1
                }
              }
              None => ()
            }
            bi = bi + 1
          }
        }
        None => ()
      }
    }
    _ => ()
  }
  match find_impl_method(tc, recv_ty, method_name) {
    Some(minfo) => {
      let itarget = find_impl_trait_name(tc, recv_ty, method_name) +
        "::" +
        ty_base_name(recv_ty) +
        "::" +
        method_name
      let mut i = 0
      while i < args.length() {
        let p_idx = i + 1
        let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
          Some(minfo.param_tys[p_idx])
        } else {
          None
        }
        let aty = check_call_arg(
          tc,
          env,
          param_at(minfo.decl.params, p_idx),
          args[i],
          exp_p,
          itarget,
        )
        if p_idx < minfo.param_tys.length() &&
          (
            !ty_compat(minfo.param_tys[p_idx], aty) ||
            (param_is_mut_at(minfo.decl.params, p_idx) && !ty_compat(aty, minfo.param_tys[p_idx]))
          ) {
          tc_err(
            tc,
            expr_span(args[i]),
            "E_TYPE_MISMATCH",
            "argument type mismatch in trait method `" + method_name + "`",
            ty_to_string(minfo.param_tys[p_idx]),
            ty_to_string(aty),
            "pass a value of type `" + ty_to_string(minfo.param_tys[p_idx]) + "`",
          )
        }
        i = i + 1
      }
      tc.resolved_method_calls.set(span_key(sp), ty_base_name(recv_ty) + "::" + method_name)
      if fn_statically_diverges(minfo) {
        tc.never_calls.set(span_key(sp), true)
      }
      tc_check_verify_callee(tc, env, minfo.decl, itarget, sp)
      if env.in_verify || tc.record_analyze {
        tc.call_targets.set(span_key(sp), itarget)
      }
      return minfo.ret_ty
    }
    None => ()
  }
  tc_err(
    tc,
    sp,
    "E_TYPE_MISMATCH",
    "unknown method `" + method_name + "` on type `" + ty_to_string(recv_ty) + "`",
    "defined method",
    method_name,
    "define `fn " + ty_to_string(recv_ty) + "::" + method_name + "` or check method name",
  )
  TError
}

///|
fn check_binary_combine(
  tc : TypeChecker,
  env : Env,
  op : String,
  lty : Ty,
  rty : Ty,
  sp : Span,
) -> Ty {
  if op == "&&" || op == "||" {
    if !ty_compat(TBool, lty) || !ty_compat(TBool, rty) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "operator `" + op + "` requires `Bool` operands",
        "Bool",
        ty_to_string(lty) + " and " + ty_to_string(rty),
        "use `Bool` operands with `" + op + "`",
      )
    }
    TBool
  } else if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
    if op == "==" || op == "!=" {
      let op_ty = match lty {
        TError | TNever => rty
        _ =>
          match rty {
            TError | TNever => lty
            _ => if ty_has_unresolved(lty) && !ty_has_unresolved(rty) { rty } else { lty }
          }
      }
      match op_ty {
        TError | TNever => ()
        _ => tc.let_infer.set(span_key(sp) + "#eq_op", op_ty)
      }
      let tps : Array[String] = []
      collect_eq_tparams_in_ty(tc, lty, tps, Map([]))
      collect_eq_tparams_in_ty(tc, rty, tps, Map([]))
      let mut ti = 0
      while ti < tps.length() {
        if env.fn_key != "" && str_arr_contains(env.type_params, tps[ti]) {
          let _ = eq_tparams_add(tc, env.fn_key, tps[ti])
          if env.in_verify {
            let _ = verify_eq_tparams_add(tc, env.fn_key, tps[ti])
          }
        }
        ti = ti + 1
      }
      let _ = record_eq_trait_obligations(tc, env.fn_key, lty)
      let _ = record_eq_trait_obligations(tc, env.fn_key, rty)
    } else {
      op_tparams_record(tc, env, "ord", lty)
      op_tparams_record(tc, env, "ord", rty)
    }
    if (op == "==" || op == "!=") && (!eq_comparable(tc, lty) || !eq_comparable(tc, rty)) {
      let bad_ty = if !eq_comparable(tc, lty) { lty } else { rty }
      let lname = ty_to_string(bad_ty)
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "operator `" +
        op +
        "` is not supported on `" +
        lname +
        "` (no implicit pointer-identity comparison)",
        "value-comparable type",
        lname,
        "use `match` to inspect `" + lname + "` values",
      )
    } else if (op == "<" || op == "<=" || op == ">" || op == ">=") &&
      (!op_ty_satisfies(tc, "ord", lty) || !op_ty_satisfies(tc, "ord", rty)) {
      let bad_ty = if !op_ty_satisfies(tc, "ord", lty) { lty } else { rty }
      let lname = ty_to_string(bad_ty)
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "operator `" + op + "` is not supported on `" + lname + "`",
        "ordered type",
        lname,
        "compare numeric, `Bool`, `Char`, `String`, `StrView`, or payload-less `enum` values with `" + op + "`",
      )
    } else if !ty_compat(lty, rty) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "comparison `" + op + "` operand type mismatch",
        ty_to_string(lty),
        ty_to_string(rty),
        "compare values of the same type",
      )
    }
    TBool
  } else if op == "<<" || op == ">>" {
    if !ty_compat(TInt, rty) && !ty_compat(lty, rty) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "shift operator `" + op + "` count must be `Int`",
        "Int",
        ty_to_string(rty),
        "use an `Int` shift count for `" + op + "`",
      )
    }
    op_tparams_record(tc, env, "int", lty)
    lty
  } else {
    let op_ok = if op == "+" {
      op_tparams_record(tc, env, "add", lty)
      op_tparams_record(tc, env, "add", rty)
      match lty {
        TInt
        | TInt64
        | TUInt
        | TUInt64
        | TDouble
        | TFloat
        | TByte
        | TInt8
        | TString
        | TParam(_)
        | TError
        | TNever => true
        _ => false
      }
    } else if op == "-" || op == "*" || op == "/" || op == "%" {
      op_tparams_record(tc, env, "num", lty)
      op_tparams_record(tc, env, "num", rty)
      match lty {
        TInt
        | TInt64
        | TUInt
        | TUInt64
        | TDouble
        | TFloat
        | TByte
        | TInt8
        | TParam(_)
        | TError
        | TNever => true
        _ => false
      }
    } else if op == "&" || op == "|" || op == "^" {
      op_tparams_record(tc, env, "int", lty)
      op_tparams_record(tc, env, "int", rty)
      match lty {
        TInt
        | TInt64
        | TUInt
        | TUInt64
        | TByte
        | TInt8
        | TParam(_)
        | TError
        | TNever => true
        _ => false
      }
    } else {
      true
    }
    if !op_ok {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "operator `" + op + "` is not supported on `" + ty_to_string(lty) + "`",
        if op == "+" {
          "numeric type or String"
        } else if op == "&" || op == "|" || op == "^" {
          "integer type"
        } else {
          "numeric type"
        },
        ty_to_string(lty),
        "use a supported operand type for `" + op + "`",
      )
    } else if !ty_compat(lty, rty) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "binary operator `" + op + "` operand type mismatch",
        ty_to_string(lty),
        ty_to_string(rty),
        "use matching operand types for `" + op + "`",
      )
    }
    lty
  }
}

///|
struct CheckBinaryFrame {
  mut state : Int
  op : String
  lhs : Expr
  rhs : Expr
  span : Span
  mut operand_ty : Ty
}

///|
/// Iterative `EBinary` type-checker using an explicit heap stack so 4,000+ deep
/// binary expression chains/trees never overflow the stack in `check_expr_inner`.
fn check_binary_chain(
  tc : TypeChecker,
  env : Env,
  root_op : String,
  root_lhs : Expr,
  root_rhs : Expr,
  root_sp : Span,
  root_expected : Option[Ty],
) -> Ty {
  // state 0: waiting for lhs; state 1: waiting for rhs;
  // state 2: under-specified `==`/`!=` waiting for rhs type hint first; state 3: waiting for lhs
  let frames : Array[CheckBinaryFrame] = []
  let mut cur : Expr = EBinary(root_op, root_lhs, root_rhs, root_sp)
  let mut cur_exp : Option[Ty] = root_expected
  let mut has_val = false
  let mut cur_ty : Ty = TError
  while true {
    if !has_val {
      match cur {
        EBinary(op, lhs, rhs, sp) => {
          if op == "&&" && expr_has_is(lhs) {
            env_push(env)
            let lty = check_cond_with_bindings(tc, env, lhs)
            let rty = check_expr(tc, env, rhs, Some(TBool))
            env_pop(env)
            cur_ty = check_binary_combine(tc, env, op, lty, rty, sp)
            if env.in_verify || tc.record_analyze {
              tc.expr_tys.set(span_key(sp), cur_ty)
            }
            has_val = true
            continue
          }
          let is_arith_or_bit = op != "&&" &&
            op != "||" &&
            op != "==" &&
            op != "!=" &&
            op != "<" &&
            op != "<=" &&
            op != ">" &&
            op != ">="
          let lhs_exp : Option[Ty] = if is_arith_or_bit { cur_exp } else { None }
          if (op == "==" || op == "!=") && expr_needs_rhs_ty_hint(lhs) {
            frames.push(CheckBinaryFrame::{
              state: 2,
              op: op,
              lhs: lhs,
              rhs: rhs,
              span: sp,
              operand_ty: TError,
            })
            cur = rhs
            cur_exp = None
          } else {
            frames.push(CheckBinaryFrame::{
              state: 0,
              op: op,
              lhs: lhs,
              rhs: rhs,
              span: sp,
              operand_ty: TError,
            })
            cur = lhs
            cur_exp = lhs_exp
          }
          continue
        }
        _ => {
          cur_ty = check_expr(tc, env, cur, cur_exp)
          has_val = true
        }
      }
    }
    if frames.length() == 0 {
      return cur_ty
    }
    let frame = frames[frames.length() - 1]
    let st = frame.state
    let op = frame.op
    let lhs = frame.lhs
    let rhs = frame.rhs
    let sp = frame.span
    if st == 0 {
      frame.state = 1
      frame.operand_ty = cur_ty
      let rhs_exp : Option[Ty] = if op == "<<" || op == ">>" {
        match cur_ty {
          TUInt | TUInt64 | TInt64 =>
            match shift_rhs_ty_hint(tc, env, rhs) {
              Some(ht) =>
                match ht {
                  TInt | TUInt | TUInt64 | TInt64 => Some(ht)
                  _ => Some(cur_ty)
                }
              None => Some(cur_ty)
            }
          _ => Some(cur_ty)
        }
      } else {
        Some(cur_ty)
      }
      cur = rhs
      cur_exp = rhs_exp
      has_val = false
    } else if st == 1 {
      let lty = frame.operand_ty
      let rty = cur_ty
      let _ = frames.pop()
      if op == "<<" || op == ">>" {
        match rty {
          TError => ()
          _ => tc.shift_rhs_infer.set(span_key(sp), rty)
        }
      }
      cur_ty = check_binary_combine(tc, env, op, lty, rty, sp)
      if env.in_verify || tc.record_analyze {
        tc.expr_tys.set(span_key(sp), cur_ty)
      }
      has_val = true
    } else if st == 2 {
      frame.state = 3
      frame.operand_ty = cur_ty
      cur = lhs
      cur_exp = Some(cur_ty)
      has_val = false
    } else {
      let rty = frame.operand_ty
      let lty = cur_ty
      let _ = frames.pop()
      cur_ty = check_binary_combine(tc, env, op, lty, rty, sp)
      if env.in_verify || tc.record_analyze {
        tc.expr_tys.set(span_key(sp), cur_ty)
      }
      has_val = true
    }
  }
  cur_ty
}

///|
fn check_builtin_no_named_args(
  tc : TypeChecker,
  env : Env,
  args : Array[Expr],
  callee_name : String,
) -> Bool {
  let mut had_named = false
  let mut i = 0
  while i < args.length() {
    match args[i] {
      ENamedArg(name, _, inner, nsp) => {
        had_named = true
        tc_err(
          tc,
          nsp,
          "E_TYPE_MISMATCH",
          "`" + callee_name + "` does not accept named argument `" + name + "`",
          "positional argument",
          "named argument `" + name + "`",
          "pass positional arguments without labels",
        )
        let _ = check_expr(tc, env, inner, None)
      }
      _ => ()
    }
    i = i + 1
  }
  had_named
}

///|
fn expr_needs_rhs_ty_hint(e : Expr) -> Bool {
  match e {
    EDotVariant(_, _, _) => true
    EIdent(n, _) => n == "None"
    EPath(q, m, _) => q == "Option" && m == "None"
    EArrayLit(elems, _) => {
      if elems.length() == 0 {
        return true
      }
      let mut i = 0
      while i < elems.length() {
        if expr_needs_rhs_ty_hint(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if expr_needs_rhs_ty_hint(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    ECall(EIdent(n, _), args, _) =>
      n == "Ok" ||
      n == "Err" ||
      (n == "Some" && args.length() == 1 && expr_needs_rhs_ty_hint(args[0]))
    ECall(EPath(q, m, _), args, _) =>
      (q == "Result" && (m == "Ok" || m == "Err")) ||
      (q == "Option" && m == "Some" && args.length() == 1 && expr_needs_rhs_ty_hint(args[0]))
    EStructLit(sname, spread, fields, _) => {
      if sname == "" {
        return true
      }
      match spread {
        Some(se) => if expr_needs_rhs_ty_hint(se) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if expr_needs_rhs_ty_hint(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) =>
      if stmts.length() > 0 {
        match stmts[stmts.length() - 1] {
          SExpr(e, _) => expr_needs_rhs_ty_hint(e)
          _ => false
        }
      } else {
        false
      }
    EIf(_, then_stmts, else_opt, _) => {
      let then_needs = if then_stmts.length() > 0 {
        match then_stmts[then_stmts.length() - 1] {
          SExpr(e, _) => expr_needs_rhs_ty_hint(e)
          _ => false
        }
      } else {
        false
      }
      if then_needs {
        return true
      }
      match else_opt {
        Some(ee) => expr_needs_rhs_ty_hint(ee)
        None => false
      }
    }
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        if expr_needs_rhs_ty_hint(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn check_expr(
  tc : TypeChecker,
  env : Env,
  expr : Expr,
  expected : Option[Ty],
) -> Ty {
  let ty0 = check_expr_inner(tc, env, expr, expected)
  let ty = check_expr_dyn_coerce(tc, env, expr, expected, ty0)
  if env.in_verify || tc.record_analyze {
    tc.expr_tys.set(span_key(expr_span(expr)), ty)
    tc_record_fallback_target(tc, env, expr)
  }
  ty
}

///|
/// Inside `#verify` code, calls not resolved to a user function / method get
/// a `builtin::...` / `closure::...` target.
fn tc_record_fallback_target(tc : TypeChecker, env : Env, expr : Expr) -> Unit {
  match expr {
    ECall(callee, _, sp) => {
      let k = span_key(sp)
      if !tc.call_targets.contains(k) {
        match callee {
          EIdent(n, _) =>
            match env_lookup(env, n) {
              Some(_) => tc.call_targets.set(k, "closure::" + n)
              None => tc.call_targets.set(k, "builtin::" + n)
            }
          EPath(q, m, _) => tc.call_targets.set(k, "builtin::" + q + "::" + m)
          _ => tc.call_targets.set(k, "closure::<expr>")
        }
      }
    }
    EMethodCall(obj, m, _, sp) => {
      let k = span_key(sp)
      if !tc.call_targets.contains(k) {
        let base = match tc.expr_tys.get(span_key(expr_span(obj))) {
          Some(t) => ty_base_name(t)
          None => "?"
        }
        tc.call_targets.set(k, "builtin::" + base + "::" + m)
      }
    }
    EScope(_, _, sp) =>
      if tc.record_analyze {
        tc.call_targets.set(span_key(sp), "builtin::scope")
      }
    ESpawn(_, _, sp) =>
      if tc.record_analyze {
        tc.call_targets.set(span_key(sp), "builtin::spawn")
      }
    _ => ()
  }
}

///|
fn check_expr_dyn_coerce(
  tc : TypeChecker,
  env : Env,
  expr : Expr,
  expected : Option[Ty],
  ty : Ty,
) -> Ty {
  let _ = env
  match expected {
    Some(TDynTrait(tname)) =>
      match ty {
        TDynTrait(_) | TError | TNever => ty
        _ => {
          let impl_key = tname + "::" + ty_base_name(ty)
          if tc.impls.contains(impl_key) {
            TDynTrait(tname)
          } else {
            tc_err(
              tc,
              expr_span(expr),
              "E_TRAIT_NOT_IMPLEMENTED",
              "type `" +
              ty_to_string(ty) +
              "` does not implement trait `" +
              tname +
              "` required for `dyn " +
              tname +
              "`",
              "impl " + tname + " for " + ty_to_string(ty),
              ty_to_string(ty),
              "add `impl " + tname + " for " + ty_to_string(ty) + " { ... }`",
            )
            add_missing_impl_edit(tc, tname, ty)
            TError
          }
        }
      }
    _ => ty
  }
}

///|
fn check_expr_inner(
  tc : TypeChecker,
  env : Env,
  expr : Expr,
  expected : Option[Ty],
) -> Ty {
  match expr {
    EInt(_, _) =>
      match expected {
        Some(TUInt) => TUInt
        Some(TUInt64) => TUInt64
        Some(TInt8) => TInt8
        _ => TInt
      }
    EInt64(_, _) => TInt64
    EUInt(_, _) => TUInt
    EUInt64(_, _) => TUInt64
    EDouble(_, _) =>
      match expected {
        Some(TFloat) => TFloat
        _ => TDouble
      }
    EFloat(_, _) => TFloat
    EBool(_, _) => TBool
    EByte(_, _) => TByte
    EChar(_, _) => TChar
    EString(_, _) => TString
    EUnit(_) => TUnit
    EMutArg(inner, sp) => {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`mut <place>` is only allowed as the argument of a `mut` parameter in a function or method call",
        "expression",
        "`mut` argument",
        "remove `mut`, or pass it to a parameter declared `mut name : T`",
      )
      check_expr(tc, env, inner, expected)
    }
    ENamedArg(label, _, inner, sp) => {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "named argument `" + label + "` is only allowed in function or method calls",
        "expression",
        "named argument `" + label + "`",
        "pass `" + label + "=...` directly to a function or method call",
      )
      check_expr(tc, env, inner, expected)
    }
    EIdent(name, sp) => {
      match env_lookup(env, name) {
        Some(b) => {
          if env.in_no_io {
            match b.ty {
              TWorld => {
                tc_err(
                  tc,
                  sp,
                  "E_NO_IO_VIOLATION",
                  "`#no_io` / `#render_thread` function `" + env.no_io_fn_name + "` cannot reference a `World` capability (blocking IO is forbidden on the render thread)",
                  "no World value",
                  "World",
                  "move blocking IO/compute into a background worker thread (`spawn` + `Channel` + `wake_now`) and pass only a command sender into the render function",
                )
                return TError
              }
              _ => ()
            }
          }
          if b.decl_span.line > 0 && tc.infer_pending.contains(span_key(b.decl_span)) {
            match expected {
              Some(exp_ty) =>
                if !ty_has_unresolved(exp_ty) &&
                  !ty_contains_never(exp_ty) &&
                  ty_compat(b.ty, exp_ty) {
                  infer_refine_binding(tc, env, name, exp_ty)
                  return exp_ty
                }
              None => ()
            }
          }
          return b.ty
        }
        None => ()
      }
      match tc.consts.get(name) {
        Some(cty) => return cty
        None => ()
      }
      match tc.fns.get(name) {
        Some(finfo) => {
          tc_check_fn_value_no_mut(tc, finfo.decl, name, sp)
          return tc_fn_value_ty(tc, env, finfo.decl, name, finfo.param_tys, finfo.ret_ty, expected, sp)
        }
        None => ()
      }
      match tc.extern_fns.get(name) {
        Some(einfo) => return TFn(einfo.param_tys, einfo.ret_ty)
        None => ()
      }
      if name == "None" {
        return check_variant_ctor(tc, env, "Option", "None", [], expected, sp)
      }
      if tc.variant_to_enum.contains(name) {
        return check_variant_ctor(tc, env, "", name, [], expected, sp)
      }
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "undefined identifier `" + name + "`",
        "defined variable or function",
        name,
        "declare `" + name + "` before use",
      )
      TError
    }
    EPath(qual, mem, sp) => {
      if qual == "Option" && (mem == "None" || mem != "Some") {
        return check_variant_ctor(tc, env, "Option", mem, [], expected, sp)
      }
      if qual == "Result" && mem != "Ok" && mem != "Err" {
        return check_variant_ctor(tc, env, "Result", mem, [], expected, sp)
      }
      if !tc_is_imported_pkg_alias(tc, qual) &&
        tc.enums.contains(qual) &&
        (tc_enum_has_variant(tc, qual, mem) || !tc.methods.contains(qual + "::" + mem)) {
        if !env.in_default_arg && tc.priv_imported_types.contains(qual) {
          let qp_p = split_qual_name(qual)
          emit_private_err(tc, sp, "enum", qp_p.prefix, qp_p.name)
        }
        return check_variant_ctor(tc, env, qual, mem, [], expected, sp)
      }
      let qp = split_qual_name(qual)
      let q_alias = qp.prefix
      let q_sub = qp.name
      if q_alias.length() > 0 {
        match resolve_pkg_for_lookup(tc, q_alias, env.in_default_arg) {
          Some(ipkg) => {
            match ipkg.tc.enums.get(q_sub) {
              Some(ei) =>
                if enum_info_has_variant(ei, mem) || !ipkg.tc.methods.contains(q_sub + "::" + mem) {
                  if !ei.decl.is_pub {
                    if !env.in_default_arg {
                      emit_private_err(tc, sp, "enum", ipkg.name, q_sub)
                    } else {
                      tc_ensure_priv_enum_registered(tc, ipkg, q_sub, ei)
                    }
                  }
                  return check_variant_ctor(
                    tc,
                    env,
                    ipkg.name + "::" + q_sub,
                    mem,
                    [],
                    expected,
                    sp,
                  )
                }
              None => ()
            }
            match ipkg.tc.methods.get(q_sub + "::" + mem) {
              Some(mi) => {
                if !mi.decl.is_pub && !env.in_default_arg {
                  emit_private_err(tc, sp, "fn", ipkg.name, q_sub + "::" + mem)
                }
                let qmi = qualify_fn_info(ipkg, mi)
                tc_check_fn_value_no_mut(tc, mi.decl, q_sub + "::" + mem, sp)
                return tc_fn_value_ty(
                  tc,
                  env,
                  qmi.decl,
                  q_sub + "::" + mem,
                  qmi.param_tys,
                  qmi.ret_ty,
                  expected,
                  sp,
                )
              }
              None => ()
            }
          }
          None => ()
        }
      }
      match resolve_pkg_for_lookup(tc, qual, env.in_default_arg) {
        Some(ipkg) => {
          match ipkg.tc.consts.get(mem) {
            Some(cty) => {
              let is_p = match ipkg.tc.const_pub.get(mem) {
                Some(b) => b
                None => false
              }
              if !is_p && !env.in_default_arg {
                emit_private_err(tc, sp, "let", ipkg.name, mem)
              }
              return qualify_imported_ty(ipkg.name, cty)
            }
            None => ()
          }
          match ipkg.tc.fns.get(mem) {
            Some(fi) => {
              if !fi.decl.is_pub && !env.in_default_arg {
                emit_private_err_at(tc, sp, "fn", ipkg.name, mem, fi.decl.span)
              }
              let qfi = qualify_fn_info(ipkg, fi)
              tc_check_fn_value_no_mut(tc, fi.decl, mem, sp)
              return tc_fn_value_ty(tc, env, qfi.decl, mem, qfi.param_tys, qfi.ret_ty, expected, sp)
            }
            None => ()
          }
          match ipkg.tc.variant_to_enum.get(mem) {
            Some(en) => {
              match ipkg.tc.enums.get(en) {
                Some(ei) =>
                  if !ei.decl.is_pub && !env.in_default_arg {
                    emit_private_err(tc, sp, "enum", ipkg.name, en)
                  }
                None => ()
              }
              return check_variant_ctor(
                tc,
                env,
                ipkg.name + "::" + en,
                mem,
                [],
                expected,
                sp,
              )
            }
            None => ()
          }
        }
        None => ()
      }
      let key = qual + "::" + mem
      let local_mi = if tc_is_imported_pkg_alias(tc, qual) { None } else { tc.methods.get(key) }
      match local_mi {
        Some(minfo) => {
          tc_check_fn_value_no_mut(tc, minfo.decl, key, sp)
          return tc_fn_value_ty(tc, env, minfo.decl, key, minfo.param_tys, minfo.ret_ty, expected, sp)
        }
        None => ()
      }
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "unknown path `" + key + "`",
        "defined item",
        key,
        "check type and member name `" + key + "`",
      )
      TError
    }
    EDotVariant(vname, args, sp) =>
      match expected {
        Some(TEnum(ename, eargs)) => {
          let einfo_opt : Option[EnumInfo] = match tc.enums.get(ename) {
            Some(ei) => Some(ei)
            None =>
              if has_qual_sep(ename) {
                let qpe = split_qual_name(ename)
                match lookup_imported_pkg_transitive(tc, qpe.prefix) {
                  Some(ipkg) => ipkg.tc.enums.get(qpe.name)
                  None => None
                }
              } else {
                None
              }
          }
          match einfo_opt {
            None => {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "cannot infer enum type for leading-dot variant `." + vname + "`",
                "known enum, Option, or Result type",
                ename,
                "qualify the variant with its enum name (e.g. `Enum::" + vname + "`) or add a type annotation",
              )
              TError
            }
            Some(einfo) => {
              let mut found_idx = -1
              let mut vi = 0
              while vi < einfo.variants.length() {
                if einfo.variants[vi].name == vname {
                  found_idx = vi
                  break
                }
                vi = vi + 1
              }
              if found_idx < 0 {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "enum `" + ename + "` has no variant `" + vname + "`",
                  "valid variant of `" + ename + "`",
                  "." + vname,
                  "check the variant name on enum `" + ename + "`",
                )
                return TError
              }
              tc.dot_variant_resolve.set(span_key(sp), ename)
              if tc.record_analyze {
                tc.call_targets.set(
                  span_key(sp),
                  tc_qualify_local_name(tc, ename) + "::" + vname,
                )
              }
              let subst : Map[String, Ty] = Map([])
              let mut k = 0
              while k < einfo.decl.type_params.length() && k < eargs.length() {
                subst.set(einfo.decl.type_params[k], eargs[k])
                k = k + 1
              }
              let v = einfo.variants[found_idx]
              if args.length() != v.field_tys.length() {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "variant `" +
                  vname +
                  "` expects " +
                  v.field_tys.length().to_string() +
                  " argument(s), found " +
                  args.length().to_string(),
                  v.field_tys.length().to_string() + " args",
                  args.length().to_string() + " args",
                  "pass the exact number of fields for `." + vname + "`",
                )
              }
              let mut fi = 0
              while fi < args.length() && fi < v.field_tys.length() {
                let exp_f = subst_ty(v.field_tys[fi], subst)
                let aty = check_expr(tc, env, args[fi], Some(exp_f))
                unify_tparams(v.field_tys[fi], aty, subst)
                let exp_f2 = subst_ty(v.field_tys[fi], subst)
                if !ty_compat(exp_f2, aty) {
                  tc_err(
                    tc,
                    expr_span(args[fi]),
                    "E_TYPE_MISMATCH",
                    "variant `" + vname + "` argument type mismatch",
                    ty_to_string(exp_f2),
                    ty_to_string(aty),
                    "pass a value of type `" + ty_to_string(exp_f2) + "`",
                  )
                }
                fi = fi + 1
              }
              let targs : Array[Ty] = []
              let mut ti = 0
              while ti < einfo.decl.type_params.length() {
                match subst.get(einfo.decl.type_params[ti]) {
                  Some(t) => targs.push(t)
                  None => targs.push(TError)
                }
                ti = ti + 1
              }
              let res_ty = TEnum(ename, targs)
              if targs.length() > 0 {
                tc_check_map_keys_in_ty_rec(tc, env.fn_key, res_ty, sp, true, Map([]), Map([]))
              }
              res_ty
            }
          }
        }
        Some(TOption(inner)) =>
          if vname == "None" {
            if args.length() != 0 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `None` expects 0 argument(s), found " + args.length().to_string(),
                "0 args",
                args.length().to_string() + " args",
                "write `.None` with no arguments",
              )
            }
            tc.dot_variant_resolve.set(span_key(sp), "Option")
            TOption(inner)
          } else if vname == "Some" {
            if args.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Some` expects 1 argument(s), found " + args.length().to_string(),
                "1 arg",
                args.length().to_string() + " args",
                "write `.Some(value)`",
              )
              tc.dot_variant_resolve.set(span_key(sp), "Option")
              return TOption(inner)
            }
            tc.dot_variant_resolve.set(span_key(sp), "Option")
            let aty = check_expr(tc, env, args[0], Some(inner))
            if !ty_compat(inner, aty) {
              tc_err(
                tc,
                expr_span(args[0]),
                "E_TYPE_MISMATCH",
                "variant `Some` argument type mismatch",
                ty_to_string(inner),
                ty_to_string(aty),
                "pass a value of type `" + ty_to_string(inner) + "`",
              )
            }
            TOption(ty_prefer_concrete(inner, aty))
          } else {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`Option` has no variant `" + vname + "`",
              "`Some` or `None`",
              "." + vname,
              "use `.Some(v)` or `.None`",
            )
            TError
          }
        Some(TResult(ok_t, err_t)) =>
          if vname == "Ok" {
            if args.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Ok` expects 1 argument(s), found " + args.length().to_string(),
                "1 arg",
                args.length().to_string() + " args",
                "write `.Ok(value)`",
              )
              tc.dot_variant_resolve.set(span_key(sp), "Result")
              return TResult(ok_t, err_t)
            }
            tc.dot_variant_resolve.set(span_key(sp), "Result")
            let aty = check_expr(tc, env, args[0], Some(ok_t))
            if !ty_compat(ok_t, aty) {
              tc_err(
                tc,
                expr_span(args[0]),
                "E_TYPE_MISMATCH",
                "variant `Ok` argument type mismatch",
                ty_to_string(ok_t),
                ty_to_string(aty),
                "pass a value of type `" + ty_to_string(ok_t) + "`",
              )
            }
            TResult(ty_prefer_concrete(ok_t, aty), err_t)
          } else if vname == "Err" {
            if args.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Err` expects 1 argument(s), found " + args.length().to_string(),
                "1 arg",
                args.length().to_string() + " args",
                "write `.Err(error)`",
              )
              tc.dot_variant_resolve.set(span_key(sp), "Result")
              return TResult(ok_t, err_t)
            }
            tc.dot_variant_resolve.set(span_key(sp), "Result")
            let aty = check_expr(tc, env, args[0], Some(err_t))
            if !ty_compat(err_t, aty) {
              tc_err(
                tc,
                expr_span(args[0]),
                "E_TYPE_MISMATCH",
                "variant `Err` argument type mismatch",
                ty_to_string(err_t),
                ty_to_string(aty),
                "pass a value of type `" + ty_to_string(err_t) + "`",
              )
            }
            TResult(ok_t, ty_prefer_concrete(err_t, aty))
          } else {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`Result` has no variant `" + vname + "`",
              "`Ok` or `Err`",
              "." + vname,
              "use `.Ok(v)` or `.Err(e)`",
            )
            TError
          }
        _ => {
          let found_ty = match expected {
            Some(t) => ty_to_string(t)
            None => "unknown expected type"
          }
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "cannot infer enum type for leading-dot variant `." + vname + "`",
            "known enum, Option, or Result type",
            found_ty,
            "qualify the variant with its enum name (e.g. `Enum::" + vname + "`) or add a type annotation",
          )
          TError
        }
      }
    EMove(inner, sp) =>
      match inner {
        EIdent(name, isp) => {
          let _ = sp
          let ty = match env_lookup(env, name) {
            Some(b) => b.ty
            None => {
              tc_err(
                tc,
                isp,
                "E_TYPE_MISMATCH",
                "undefined variable `" + name + "` in `move`",
                "defined variable",
                name,
                "declare `" + name + "` before moving it",
              )
              TError
            }
          }
          ty
        }
        _ => check_expr(tc, env, inner, expected)
      }
    EUnary(op, inner, sp) => {
      let ity = check_expr(tc, env, inner, expected)
      if op == "!" {
        if !ty_compat(TBool, ity) {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "unary `!` expects `Bool`",
            "Bool",
            ty_to_string(ity),
            "apply `!` to a `Bool` expression",
          )
        }
        TBool
      } else if op == "-" {
        op_tparams_record(tc, env, "num", ity)
        let neg_ok = match ity {
          TInt
          | TInt64
          | TUInt
          | TUInt64
          | TDouble
          | TFloat
          | TByte
          | TInt8
          | TParam(_)
          | TError
          | TNever => true
          _ => false
        }
        if !neg_ok {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "unary `-` is not supported on `" + ty_to_string(ity) + "`",
            "numeric type",
            ty_to_string(ity),
            "apply `-` to a numeric expression",
          )
          TError
        } else {
          ity
        }
      } else {
        ity
      }
    }
    EBinary(op, lhs, rhs, sp) =>
      check_binary_chain(tc, env, op, lhs, rhs, sp, expected)
    ECall(callee, args, sp) =>
      match callee {
        EIdent(name, _) => {
          if name == "StringBuilder" {
            return TStringBuilder
          }
          if name == "Map" {
            return check_map_init(tc, env, args, expected, sp)
          }
          let has_local_fn = match env_lookup(env, name) {
            Some(b) =>
              match b.ty {
                TFn(_, _) => true
                _ => false
              }
            None => false
          }
          if !has_local_fn {
            // Invariant: generic bodies and default_exprs are checked under unsubstituted
            // `TParam`s before monomorphization, so a call-site span has identical
            // local-vs-nonlocal resolution across all contexts.
            tc.resolved_method_calls.set("call_nonlocal:" + span_key(sp), name)
          }
          let has_const_fn = match tc.consts.get(name) {
            Some(TFn(_, _)) => true
            _ => false
          }
          let has_user_callee = if tc.in_imported_default_arg {
            has_local_fn
          } else {
            has_local_fn ||
              has_const_fn ||
              tc.fns.contains(name) ||
              tc.extern_fns.contains(name)
          }
          if !has_user_callee {
          if is_world_builtin(name) {
            return check_world_builtin_call(tc, env, name, args, sp)
          }
          if name == "sha256_hex" {
            if args.length() >= 1 {
              let _ = check_expr(tc, env, args[0], Some(TString))
            }
            return TString
          }
          if name == "fs_mmap_ro" {
            if args.length() >= 1 {
              let aty = check_expr(tc, env, args[0], Some(TString))
              if !ty_compat(TString, aty) {
                tc_err(
                  tc,
                  expr_span(args[0]),
                  "E_TYPE_MISMATCH",
                  "`fs_mmap_ro` expects `String` path",
                  "String",
                  ty_to_string(aty),
                  "pass a `String` path",
                )
              }
            }
            return TResult(TBytes, TString)
          }
          if name == "fs_write_atomic_bytes" {
            if args.length() >= 1 {
              let pty = check_expr(tc, env, args[0], Some(TString))
              if !ty_compat(TString, pty) {
                tc_err(
                  tc,
                  expr_span(args[0]),
                  "E_TYPE_MISMATCH",
                  "`fs_write_atomic_bytes` expects `String` path",
                  "String",
                  ty_to_string(pty),
                  "pass a `String` path",
                )
              }
            }
            if args.length() >= 2 {
              let dty = check_expr(tc, env, args[1], Some(TBytes))
              if !ty_compat(TBytes, dty) {
                tc_err(
                  tc,
                  expr_span(args[1]),
                  "E_TYPE_MISMATCH",
                  "`fs_write_atomic_bytes` expects `Bytes` data",
                  "Bytes",
                  ty_to_string(dty),
                  "pass a `Bytes` value",
                )
              }
            }
            return TResult(TUnit, TString)
          }
          match rt_prim_info(name) {
            Some(pr) => return check_rt_prim_call(tc, env, name, pr, args, sp)
            None => ()
          }
          if name == "ptr_null" {
            if args.length() != 0 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "`ptr_null` takes 0 arguments",
                "0 args",
                args.length().to_string() + " args",
                "call `ptr_null()` with no arguments",
              )
            }
            return TPtr
          }
          if name == "ptr_is_null" {
            if args.length() >= 1 {
              let aty = check_expr(tc, env, args[0], Some(TPtr))
              if !ty_compat(TPtr, aty) {
