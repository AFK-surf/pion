                    expr_span(args[i]),
                    "E_TYPE_MISMATCH",
                    "closure argument type mismatch",
                    ty_to_string(ptys[i]),
                    ty_to_string(aty),
                    "pass `" + ty_to_string(ptys[i]) + "`",
                  )
                }
                i = i + 1
              }
              match rty {
                TNever => tc.never_calls.set(span_key(sp), true)
                _ => ()
              }
              rty
            }
            TError => TError
            _ => {
              let mut i = 0
              while i < args.length() {
                let _ = check_expr(tc, env, args[i], None)
                i = i + 1
              }
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "cannot call value of non-function type `" + ty_to_string(cty) + "`",
                "function type",
                ty_to_string(cty),
                "call a function or closure value",
              )
              TError
            }
          }
        }
      }
    EField(obj, field_name, sp) => {
      let oty = check_expr(tc, env, obj, None)
      match oty {
        TError => TError
        TTuple(elems) => {
          let idx = parse_tuple_index(field_name)
          if idx >= 0 && idx < elems.length() {
            elems[idx]
          } else {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "tuple `" + ty_to_string(oty) + "` has no element `." + field_name + "`",
              "index in 0.." + elems.length().to_string(),
              field_name,
              "use a valid tuple element index",
            )
            TError
          }
        }
        TStruct(sname, sargs) =>
          match tc_lookup_struct_info(tc, sname) {
            None => TError
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == field_name {
                  if has_qual_sep(sname) &&
                    !env.in_default_arg &&
                    i < sinfo.field_privs.length() &&
                    sinfo.field_privs[i] {
                    tc_err(
                      tc,
                      sp,
                      "E_PRIVATE_FIELD",
                      "cannot access private field `" +
                      field_name +
                      "` of `" +
                      sname +
                      "` outside its defining package",
                      "public field",
                      "private field `" + field_name + "`",
                      "use a public method on `" + sname + "` instead",
                    )
                  }
                  return subst_ty(sinfo.field_tys[i], subst)
                }
                i = i + 1
              }
              let fix_hint = match find_closest_name(field_name, sinfo.field_names, 2) {
                Some(best) => "did you mean `" + best + "`?"
                None => "check field name on `" + sname + "`"
              }
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "struct `" + sname + "` has no field `" + field_name + "`",
                "valid field of `" + sname + "`",
                field_name,
                fix_hint,
              )
              match find_closest_name(field_name, sinfo.field_names, 2) {
                Some(best) =>
                  tc_add_edit(tc, TextEdit::{
                    file: sp.file,
                    line: sp.line,
                    col: sp.col + 1,
                    end_line: sp.line,
                    end_col: sp.col + 1 + field_name.length(),
                    replacement: best,
                    applicability: "machine",
                  })
                None => ()
              }
              TError
            }
          }
        _ => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "cannot access field `" + field_name + "` on `" + ty_to_string(oty) + "`",
            "struct",
            ty_to_string(oty),
            "access fields only on struct values",
          )
          TError
        }
      }
    }
    EMethodCall(obj, method_name, args, sp) => {
      let oty = check_expr(tc, env, obj, None)
      tc.infer_hit.clear()
      let rty = check_method_call(tc, env, oty, method_name, args, expected, sp)
      if !tc.resolved_method_calls.contains(span_key(sp)) {
        match oty {
          TStruct(_, _) | TEnum(_, _) | TDynTrait(_) | TParam(_) | TError => ()
          _ => tc.resolved_method_calls.set(span_key(sp), "__builtin__::" + method_name)
        }
      }
      infer_refine_call(tc, env, obj, oty, method_name)
      let mut recv_mut = false
      match oty {
        TError => ()
        _ =>
          match method_params_for(tc, env, oty, method_name) {
            Some(mps) =>
              if mps.length() > 0 && mps[0].is_mut {
                recv_mut = true
                let _ = check_mut_place(tc, env, obj, false)
                tc.mut_recv_calls.set(span_key(sp), true)
              }
            None => ()
          }
      }
      let mut has_mut_arg = recv_mut
      let mut ai = 0
      while ai < args.length() {
        match args[ai] {
          EMutArg(_, _) => has_mut_arg = true
          _ => ()
        }
        ai = ai + 1
      }
      if has_mut_arg {
        let all_args : Array[Expr] = [obj]
        let muts : Array[Bool] = [recv_mut]
        ai = 0
        while ai < args.length() {
          all_args.push(args[ai])
          match args[ai] {
            EMutArg(_, _) => muts.push(true)
            _ => muts.push(false)
          }
          ai = ai + 1
        }
        check_mut_call_aliasing(tc, all_args, muts, method_name)
      }
      rty
    }
    EIndex(obj, idx, sp) => {
      let oty = check_expr(tc, env, obj, None)
      match oty {
        TError => {
          let _ = check_expr(tc, env, idx, None)
          TError
        }
        TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
          let ity = check_expr(tc, env, idx, Some(TInt))
          if !ty_compat(TInt, ity) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "array index must be `Int`",
              "Int",
              ty_to_string(ity),
              "use an `Int` index",
            )
          }
          elem
        }
        TMap(kty, vty) => {
          let ity = check_expr(tc, env, idx, Some(kty))
          if !ty_compat(kty, ity) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "map index key type mismatch",
              ty_to_string(kty),
              ty_to_string(ity),
              "use a key of type `" + ty_to_string(kty) + "`",
            )
          }
          vty
        }
        TString | TStrView => {
          let _ = check_expr(tc, env, idx, Some(TInt))
          TInt
        }
        TBytes | TBytesView => {
          let _ = check_expr(tc, env, idx, Some(TInt))
          TByte
        }
        _ => {
          let _ = check_expr(tc, env, idx, None)
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "cannot index into type `" + ty_to_string(oty) + "`",
            "Array, Map, String, or Bytes",
            ty_to_string(oty),
            "index only into indexable collections",
          )
          TError
        }
      }
    }
    EArrayLit(elems, sp) => {
      let is_fixed = match expected {
        Some(TFixedArray(_)) => true
        _ => false
      }
      let is_imm = match expected {
        Some(TImmArray(_)) => true
        _ => false
      }
      let exp_elem : Option[Ty] = match expected {
        Some(TArray(e)) | Some(TFixedArray(e)) | Some(TImmArray(e)) => Some(e)
        _ => None
      }
      if elems.length() == 0 {
        let e = match exp_elem {
          Some(et) => et
          None => TError
        }
        return if is_fixed {
          TFixedArray(e)
        } else if is_imm {
          TImmArray(e)
        } else {
          TArray(e)
        }
      }
      let first_ty = check_expr(tc, env, elems[0], exp_elem)
      let target_elem = match exp_elem {
        Some(TDynTrait(tn)) => TDynTrait(tn)
        _ => first_ty
      }
      let mut i = 1
      while i < elems.length() {
        let ety = check_expr(tc, env, elems[i], Some(target_elem))
        if !ty_compat(target_elem, ety) {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "array literal element type mismatch",
            ty_to_string(target_elem),
            ty_to_string(ety),
            "ensure all array elements have type `" + ty_to_string(target_elem) + "`",
          )
        }
        i = i + 1
      }
      if is_fixed {
        TFixedArray(target_elem)
      } else if is_imm {
        TImmArray(target_elem)
      } else {
        TArray(target_elem)
      }
    }
    EStructLit(sname, spread_opt, fields, sp) => {
      let diags_before = tc.diagnostics.length()
      let base_ty_opt : Option[Ty] = match spread_opt {
        Some(base_e) => Some(check_expr(tc, env, base_e, expected))
        None => None
      }
      let diags_after_base = tc.diagnostics.length()
      let mut resolved_name = if sname != "" {
        sname
      } else {
        match base_ty_opt {
          Some(TStruct(bn, _)) => bn
          _ =>
            match expected {
              Some(TStruct(en, _)) => en
              _ => ""
            }
        }
      }
      let mut resolved_sinfo_opt : Option[StructInfo] = None
      let mut is_canon_struct = false
      // `sname` names a package imported here that has no such struct.
      let mut alias_missing = false
      let via_alias = tc_is_imported_pkg_alias(tc, sname)
      if resolved_name != "" && (via_alias || !tc.structs.contains(resolved_name)) {
        let qp = split_qual_name(resolved_name)
        let q_alias = qp.prefix
        let q_st = qp.name
        if q_alias.length() > 0 {
          is_canon_struct = starts_with_str(q_alias, "@canon:")
          if is_canon_struct && slice_str(q_alias, 7, q_alias.length()) == tc.pkg_name {
            if tc.structs.contains(q_st) {
              resolved_name = q_st
            }
          } else {
            match resolve_pkg_for_lookup(tc, q_alias, env.in_default_arg) {
              Some(ipkg) =>
                match ipkg.tc.structs.get(q_st) {
                  Some(si) => {
                    let qk = ipkg.name + "::" + q_st
                    if !si.decl.is_pub {
                      if !env.in_default_arg && !is_canon_struct {
                        emit_private_err(tc, sp, "struct", ipkg.name, q_st)
                      } else {
                        tc_ensure_priv_struct_registered(tc, ipkg, q_st, si)
                      }
                    }
                    resolved_name = qk
                    if is_canon_struct || env.in_default_arg {
                      resolved_sinfo_opt = Some(qualify_imported_struct_info(ipkg.name, si))
                    }
                  }
                  None => {
                    alias_missing = via_alias
                    resolved_name = ipkg.name + "::" + q_st
                  }
                }
              None => ()
            }
          }
        }
      }
      if resolved_name == "" {
        // Anonymous `{ ... }` with no struct context: fail closed. Field values are
        // still checked so their own errors surface; a spread base that already
        // reported its own error is not reported twice.
        let mut i = 0
        while i < fields.length() {
          let _ = check_expr(tc, env, fields[i].value, None)
          i = i + 1
        }
        let base_already_reported = match base_ty_opt {
          Some(TError) => diags_after_base > diags_before
          _ => false
        }
        match base_ty_opt {
          Some(bty) =>
            if !base_already_reported {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "struct update base must be a struct type, found `" + ty_to_string(bty) + "`",
                "struct type",
                ty_to_string(bty),
                "provide a struct value after `..` or qualify the struct literal as `StructName::{ ... }`",
              )
            }
          None => {
            let exp_s = match expected {
              Some(TError) => "explicit struct type"
              Some(exp_ty) => ty_to_string(exp_ty)
              None => "explicit struct type"
            }
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "cannot infer struct type for anonymous struct literal `{ ... }`",
              exp_s,
              "anonymous struct literal",
              "qualify the literal as `StructName::{ ... }` or add a struct type annotation (e.g. `let v : StructName = { ... }`)",
            )
          }
        }
        return TError
      }
      let sinfo_lookup = if alias_missing {
        None
      } else {
        match tc.structs.get(resolved_name) {
          Some(si) => Some(si)
          None =>
            if is_canon_struct || env.in_default_arg {
              resolved_sinfo_opt
            } else {
              None
            }
        }
      }
      match sinfo_lookup {
        None => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "unknown struct `" + resolved_name + "`",
            "defined struct",
            resolved_name,
            "declare `struct " + resolved_name + "`",
          )
          TError
        }
        Some(sinfo) => {
          if !env.in_default_arg && !is_canon_struct && tc.priv_imported_types.contains(resolved_name) {
            let qp_p = split_qual_name(resolved_name)
            emit_private_err(tc, sp, "struct", qp_p.prefix, qp_p.name)
          }
          tc.resolved_method_calls.set("st:" + span_key(sp), resolved_name)
          if has_qual_sep(resolved_name) && !env.in_default_arg && !is_canon_struct {
            let mut has_priv = false
            let mut pi = 0
            while pi < sinfo.field_privs.length() {
              if sinfo.field_privs[pi] {
                has_priv = true
                break
              }
              pi = pi + 1
            }
            if has_priv {
              tc_err(
                tc,
                sp,
                "E_PRIVATE_FIELD",
                "cannot construct `" +
                resolved_name +
                "` directly outside its defining package because it has private field(s); use a public constructor function",
                "public constructor call",
                "direct struct literal of `" + resolved_name + "`",
                "call a public constructor function for `" + resolved_name + "`",
              )
            }
          }
          let subst : Map[String, Ty] = Map([])
          match expected {
            Some(TStruct(en, eargs)) =>
              if en == resolved_name {
                let mut k = 0
                while k < sinfo.decl.type_params.length() && k < eargs.length() {
                  match eargs[k] {
                    TError => ()
                    _ => subst.set(sinfo.decl.type_params[k], eargs[k])
                  }
                  k = k + 1
                }
              }
            _ => ()
          }
          match base_ty_opt {
            Some(bty) =>
              match bty {
                TStruct(bn, bargs) =>
                  if bn != resolved_name {
                    tc_err(
                      tc,
                      sp,
                      "E_TYPE_MISMATCH",
                      "struct update base type mismatch: expected `" +
                      resolved_name +
                      "`, found `" +
                      bn +
                      "`",
                      resolved_name,
                      bn,
                      "use a base value of struct `" + resolved_name + "`",
                    )
                  } else {
                    let mut k = 0
                    while k < sinfo.decl.type_params.length() && k < bargs.length() {
                      subst.set(sinfo.decl.type_params[k], bargs[k])
                      k = k + 1
                    }
                  }
                TError => ()
                _ =>
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "struct update base must be a struct of type `" + resolved_name + "`",
                    resolved_name,
                    ty_to_string(bty),
                    "provide a `" + resolved_name + "` value after `..`",
                  )
              }
            None => ()
          }
          let seen_fields : Map[String, Bool] = Map([])
          let mut fi = 0
          while fi < fields.length() {
            let f = fields[fi]
            if seen_fields.contains(f.name) {
              tc_err(
                tc,
                f.span,
                "E_TYPE_MISMATCH",
                "duplicate field `" + f.name + "` in struct literal `" + resolved_name + "`",
                "unique field",
                f.name,
                "remove the duplicate `" + f.name + "` initializer",
              )
            } else {
              seen_fields.set(f.name, true)
            }
            let mut found_idx = -1
            let mut j = 0
            while j < sinfo.field_names.length() {
              if sinfo.field_names[j] == f.name {
                found_idx = j
                break
              }
              j = j + 1
            }
            if found_idx < 0 {
              let fix_hint = match find_closest_name(f.name, sinfo.field_names, 2) {
                Some(best) => "did you mean `" + best + "`?"
                None => "remove or rename field `" + f.name + "`"
              }
              tc_err(
                tc,
                f.span,
                "E_TYPE_MISMATCH",
                "unknown field `" + f.name + "` on struct `" + resolved_name + "`",
                "valid field",
                f.name,
                fix_hint,
              )
              match find_closest_name(f.name, sinfo.field_names, 2) {
                Some(best) =>
                  tc_add_edit(tc, TextEdit::{
                    file: f.span.file,
                    line: f.span.line,
                    col: f.span.col,
                    end_line: f.span.line,
                    end_col: f.span.col + f.name.length(),
                    replacement: best,
                    applicability: "machine",
                  })
                None => ()
              }
              let _ = check_expr(tc, env, f.value, None)
            } else {
              let exp_f = subst_ty_mask_unbound(
                sinfo.field_tys[found_idx],
                sinfo.decl.type_params,
                subst,
              )
              let vty = check_expr(tc, env, f.value, Some(exp_f))
              unify_tparams(sinfo.field_tys[found_idx], vty, subst)
              let exp_f2 = subst_ty(sinfo.field_tys[found_idx], subst)
              if !ty_compat(exp_f2, vty) {
                tc_err(
                  tc,
                  f.span,
                  "E_TYPE_MISMATCH",
                  "field `" + f.name + "` type mismatch in `" + resolved_name + "`",
                  ty_to_string(exp_f2),
                  ty_to_string(vty),
                  "provide a value of type `" + ty_to_string(exp_f2) + "`",
                )
              }
            }
            fi = fi + 1
          }
          match spread_opt {
            None => {
              let missing : Array[String] = []
              let missing_bt : Array[String] = []
              let mut mj = 0
              while mj < sinfo.field_names.length() {
                let fn_m = sinfo.field_names[mj]
                if !seen_fields.contains(fn_m) {
                  missing.push(fn_m)
                  missing_bt.push("`" + fn_m + "`")
                }
                mj = mj + 1
              }
              if missing.length() > 0 {
                let miss_str = join_strs(missing_bt, ", ")
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "missing field" +
                  (if missing.length() == 1 { " " } else { "s " }) +
                  miss_str +
                  " in struct literal `" +
                  resolved_name +
                  "`",
                  "all fields of `" + resolved_name + "`",
                  "missing " + join_strs(missing, ", "),
                  "initialize " + miss_str + " in `" + resolved_name + "::{ ... }`",
                )
              }
            }
            Some(_) => ()
          }
          let targs : Array[Ty] = []
          let mut ti = 0
          while ti < sinfo.decl.type_params.length() {
            match subst.get(sinfo.decl.type_params[ti]) {
              Some(t) => targs.push(t)
              None => targs.push(TError)
            }
            ti = ti + 1
          }
          let res_ty = TStruct(resolved_name, targs)
          if targs.length() > 0 {
            tc_check_map_keys_in_ty_rec(tc, env.fn_key, res_ty, sp, true, Map([]), Map([]))
          }
          res_ty
        }
      }
    }
    ETuple(elems, _) => {
      let exp_elems : Array[Ty] = match expected {
        Some(TTuple(etys)) => etys
        _ => []
      }
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        let e_exp : Option[Ty] = if i < exp_elems.length() {
          Some(exp_elems[i])
        } else {
          None
        }
        out.push(check_expr(tc, env, elems[i], e_exp))
        i = i + 1
      }
      TTuple(out)
    }
    EBlock(stmts, _) => {
      env_push(env)
      let t = check_stmts(tc, env, stmts, expected)
      env_pop(env)
      t
    }
    EIf(cond, then_stmts, else_opt, sp) => {
      env_push(env)
      let cty = check_cond_with_bindings(tc, env, cond)
      if !ty_compat(TBool, cty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`if` condition must be `Bool`",
          "Bool",
          ty_to_string(cty),
          "use a `Bool` condition",
        )
      }
      let then_ty = check_stmts(tc, env, then_stmts, expected)
      env_pop(env)
      match else_opt {
        None => TUnit
        Some(el) => {
          let else_ty = check_expr(tc, env, el, expected)
          let branch_ok = match then_ty {
            TNever => true
            _ => ty_compat(then_ty, else_ty)
          }
          if !branch_ok {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "`if` and `else` branch types do not match",
              ty_to_string(then_ty),
              ty_to_string(else_ty),
              "make both branches return `" + ty_to_string(then_ty) + "`",
            )
          }
          ty_prefer_concrete(then_ty, else_ty)
        }
      }
    }
    EIs(scrut, pat, _) => {
      let sty = check_expr(tc, env, scrut, None)
      env_push(env)
      bind_pattern(tc, env, pat, sty)
      env_pop(env)
      TBool
    }
    EMatch(scrut, arms, sp) => {
      let scrut_ty = check_expr(tc, env, scrut, None)
      let mut res_ty : Option[Ty] = expected
      let mut i = 0
      while i < arms.length() {
        env_push(env)
        bind_pattern(tc, env, arms[i].pat, scrut_ty)
        match arms[i].guard_expr {
          Some(ge) => {
            let gty = check_cond_with_bindings(tc, env, ge)
            if !ty_compat(TBool, gty) {
              tc_err(
                tc,
                expr_span(ge),
                "E_TYPE_MISMATCH",
                "`match` guard condition must be `Bool`",
                "Bool",
                ty_to_string(gty),
                "use a boolean expression after `if` in match arm",
              )
            }
          }
          None => ()
        }
        let bty = check_expr(tc, env, arms[i].body, res_ty)
        env_pop(env)
        match res_ty {
          None =>
            match bty {
              TNever => ()
              _ => res_ty = Some(bty)
            }
          Some(TUnit) =>
            match bty {
              TUnit | TError | TNever => ()
              TResult(_, _) => {
                let bsp = expr_span(arms[i].body)
                tc_err(
                  tc,
                  bsp,
                  "E_UNHANDLED_RESULT",
                  "value of type `" +
                  ty_to_string(bty) +
                  "` is silently discarded",
                  "handled Result",
                  ty_to_string(bty),
                  "handle the Result with `match`, `?`, or explicitly discard with `let _ = ...`",
                )
                tc_add_edit(tc, text_edit_insert(bsp, 0, "let _ = "))
              }
              _ => ()
            }
          Some(rt) => {
            if !ty_compat(rt, bty) {
              tc_err(
                tc,
                arms[i].span,
                "E_TYPE_MISMATCH",
                "`match` arm type mismatch",
                ty_to_string(rt),
                ty_to_string(bty),
                "return `" + ty_to_string(rt) + "` from every arm",
              )
            }
            res_ty = Some(ty_prefer_concrete(rt, bty))
          }
        }
        i = i + 1
      }
      check_match_exhaustiveness(tc, scrut_ty, arms, sp)
      match res_ty {
        Some(t) => t
        None => TUnit
      }
    }
    EClosure(params, ret_te, body, sp) => {
      let exp_ptys : Array[Ty] = match expected {
        Some(TFn(ep, _)) => ep
        _ => []
      }
      let ptys : Array[Ty] = []
          let mut i = 0
          while i < params.length() {
            let pty = match params[i].ty {
              TyMissing(psp) => {
                let inf = if i < exp_ptys.length() {
                  exp_ptys[i]
                } else {
                  TError
                }
                match inf {
                  TError => {
                    tc_err(
                      tc,
                      psp,
                      "E_TYPE_MISMATCH",
                      "cannot infer type for closure parameter `" + params[i].name + "`",
                      "explicit parameter type annotation",
                      "unannotated parameter",
                      "add a type annotation, e.g. `" + params[i].name + " : Int`",
                    )
                    TError
                  }
                  _ => inf
                }
              }
              _ => resolve_type_expr(tc, params[i].ty, env.type_params)
            }
            ptys.push(pty)
            i = i + 1
          }
      let has_explicit_ret = match ret_te {
        TyMissing(_) => false
        _ => true
      }
      let ret_opt : Option[Ty] = match ret_te {
        TyMissing(_) =>
          match expected {
            Some(TFn(_, er)) =>
              match er {
                TError => None
                _ => Some(er)
              }
            _ => None
          }
        _ => Some(resolve_type_expr(tc, ret_te, env.type_params))
      }
      let saved_ret_ty = env.ret_ty
      let saved_inferred_ret = env.inferred_ret
      let saved_closure_floor = env.closure_scope_floor
      let saved_loop_depth = env.in_loop_depth
      let saved_in_def_expr = env.in_default_expr
      env.ret_ty = match ret_opt {
        Some(r) => r
        None => TError
      }
      env.inferred_ret = None
      env.closure_scope_floor = env.scopes.length()
      env.in_loop_depth = 0
      env.in_default_expr = false
      env_push(env)
      let mut j = 0
      while j < params.length() {
        let mut pty_def = ptys[j]
        if env.in_no_io {
          match ptys[j] {
            TWorld => {
              tc_err(
                tc,
                params[j].span,
                "E_NO_IO_VIOLATION",
                "`#no_io` / `#render_thread` function `" + env.no_io_fn_name + "` cannot accept a `World` capability (blocking IO is forbidden on the render thread)",
                "no World parameter",
                "World",
                "move blocking IO/compute into a background worker thread (`spawn` + `Channel` + `wake_now`) and pass only a command sender into the render function",
              )
              pty_def = TError
            }
            _ => ()
          }
        }
        env_define_line(env, params[j].name, pty_def, false, params[j].span.line)
        j = j + 1
      }
      let body_ty = check_stmts(tc, env, body, ret_opt)
      match ret_opt {
        Some(TNever) =>
          if !stmts_diverge(tc, env, body, 1, false) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "closure declared to return `Never` may return normally",
              "Never",
              ty_to_string(body_ty),
              "ensure all paths diverge (e.g. `panic(...)`)",
            )
          }
        _ => ()
      }
      let clo_inferred_ret = env.inferred_ret
      env_pop(env)
      if env.mut_params.length() > 0 || (tc.record_analyze && !env.in_default_arg) {
        let cl_locals : Map[String, Bool] = Map([])
        let mut cj = 0
        while cj < params.length() {
          cl_locals.set(params[cj].name, true)
          cj = cj + 1
        }
        let caps : Array[CaptureInfo] = []
        collect_stmts_captures(body, cl_locals, caps)
        let seen_caps : Map[String, Bool] = Map([])
        let analyze_caps : Array[AnalyzeCapture] = []
        let mut ck = 0
        while ck < caps.length() {
          let cn = caps[ck].name
          if !seen_caps.contains(cn) {
            seen_caps.set(cn, true)
            match env_lookup(env, cn) {
              Some(b) => {
                if tc.record_analyze && !env.in_default_arg {
                  analyze_caps.push(AnalyzeCapture::{
                    name: cn,
                    is_mut: b.is_mut,
                    ty: b.ty,
                    decl_line: b.decl_line,
                  })
                }
                if env.mut_params.contains(cn) &&
                  b.is_mut &&
                  b.decl_span.line == 0 &&
                  env_lookup_depth(env, cn) == 0 {
                  tc_err(
                    tc,
                    caps[ck].span,
                    if env.in_verify { "E_VERIFY_CLOSURE_CAPTURE" } else { "E_TYPE_MISMATCH" },
                    "closure cannot capture `mut` parameter `" + cn + "`",
                    "local copy",
                    "mut parameter `" + cn + "`",
                    "copy it first: `let " + cn + "_v = " + cn + "` and capture `" + cn + "_v`",
                  )
                }
              }
              None => ()
            }
          }
          ck = ck + 1
        }
        if tc.record_analyze && !env.in_default_arg {
          tc.analyze_closure_captures.set(span_key(sp), analyze_caps)
        }
      }
      env.closure_scope_floor = saved_closure_floor
      env.in_loop_depth = saved_loop_depth
      env.in_default_expr = saved_in_def_expr
      env.ret_ty = saved_ret_ty
      env.inferred_ret = saved_inferred_ret
      let eff_body_ty = match body_ty {
        TNever =>
          match clo_inferred_ret {
            Some(ir) => ir
            None => body_ty
          }
        _ =>
          match clo_inferred_ret {
            Some(ir) => {
              let has_ret_opt = match ret_opt {
                Some(_) => true
                None => false
              }
              if !has_explicit_ret && !has_ret_opt && !ty_compat(ir, body_ty) {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "closure return type mismatch",
                  ty_to_string(ir),
                  ty_to_string(body_ty),
                  "ensure early `return` and tail expression have compatible types",
                )
              }
              ty_prefer_concrete(body_ty, ir)
            }
            None => body_ty
          }
      }
      let final_ret = match ret_opt {
        Some(r) => {
          // Never let the expected / declared return type swallow an
          // incompatible body type: `fn(_x) { 7 / 2 }` against an expected
          // `(Int) -> Double` must not become `(Int) -> Double`. `Never` is
          // checked above, and a `Unit` return implicitly discards a
          // non-`Result` tail (SPEC §3.3).
          let ret_mismatch = match r {
            TNever | TUnit => false
            _ => !ty_compat(r, eff_body_ty)
          }
          if ret_mismatch && has_explicit_ret {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "closure body type does not match declared return type",
              ty_to_string(r),
              ty_to_string(eff_body_ty),
              "make the closure body produce the declared return type",
            )
            r
          } else if ret_mismatch {
            // Keep the real body type so the enclosing `let` / argument /
            // pipe check reports the mismatch.
            eff_body_ty
          } else if !has_explicit_ret {
            match eff_body_ty {
              TNever => r
              _ => ty_prefer_concrete(r, eff_body_ty)
            }
          } else {
            r
          }
        }
        None => eff_body_ty
      }
      let clo_ty = TFn(ptys, final_ret)
      tc.closure_infer.set(span_key(sp), clo_ty)
      clo_ty
    }
    EScope(w_expr, f_expr, sp) => {
      if env.in_no_io {
        tc_err(
          tc,
          sp,
          "E_NO_IO_VIOLATION",
          "calling `scope` is forbidden inside `#no_io` / `#render_thread` function `" + env.no_io_fn_name + "`",
          "non-blocking UI logic (no World IO)",
          "World IO call `scope`",
          "send a command over `Channel` to a background worker thread (`spawn`) that owns `World`, then wake the render thread with the result",
        )
        let _ = check_expr(tc, env, f_expr, Some(TFn([TScope], TUnit)))
        return TUnit
      }
      let wty = check_expr(tc, env, w_expr, Some(TWorld))
      if !ty_compat(TWorld, wty) {
        tc_err(
          tc,
          sp,
          "E_CAPABILITY_MISSING",
          "`scope` requires a `World` capability as its first argument",
          "World",
          ty_to_string(wty),
          "pass `world : World` to `scope(world, fn(s : Scope) -> Unit { ... })`",
        )
      }
      let _ = check_expr(tc, env, f_expr, Some(TFn([TScope], TUnit)))
      TUnit
    }
    ESpawn(s_expr, f_expr, sp) => {
      let sty = check_expr(tc, env, s_expr, Some(TScope))
      if !ty_compat(TScope, sty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`spawn` requires a `Scope` as its first argument",
          "Scope",
          ty_to_string(sty),
          "pass the `Scope` from `scope(world, fn(s : Scope) -> Unit { ... })`",
        )
      }
      // Static Send / linear-move capture check for spawned closure
      match f_expr {
        EClosure(params, _, body, _) => {
          let locals : Map[String, Bool] = Map([])
          let mut pi = 0
          while pi < params.length() {
            locals.set(params[pi].name, true)
            pi = pi + 1
          }
          let caps : Array[CaptureInfo] = []
          collect_stmts_captures(body, locals, caps)
          let checked : Map[String, Bool] = Map([])
          let mut ci = 0
          while ci < caps.length() {
            let cap = caps[ci]
            if checked.contains(cap.name) {
              ci = ci + 1
              continue
            }
            match env_lookup(env, cap.name) {
              Some(b) => {
                checked.set(cap.name, true)
                if cap.is_moved {
                  // Linear ownership transfer into spawned thread is allowed;
                  // inner check_expr will mark `cap.name` as moved in `env`.
                  ()
                } else if b.is_mut {
                  tc_err(
                    tc,
                    cap.span,
                    "E_NOT_SEND",
                    "cannot capture mutable variable `" + cap.name + "` inside `spawn`",
                    "Send",
                    "mut " + ty_to_string(b.ty),
                    "wrap `" + cap.name + "` in `Mutex::new(...)` or `AtomicInt::new(...)`",
                  )
                  if b.init_span.line > 0 && b.init_end_col > 0 && is_send_ty(tc, TMutex(b.ty), []) {
                    if b.ty_span.line > 0 && b.ty_end_col > 0 {
                      tc_add_edit(tc, text_edit_insert_maybe(b.ty_span, 0, "Mutex["))
                      tc_add_edit(tc, TextEdit::{
                        file: b.ty_span.file,
                        line: b.ty_span.line,
                        col: b.ty_end_col,
                        end_line: b.ty_span.line,
                        end_col: b.ty_end_col,
                        replacement: "]",
                        applicability: "maybe",
                      })
                    }
                    tc_add_edit(tc, text_edit_insert_maybe(b.init_span, 0, "Mutex::new("))
                    tc_add_edit(tc, TextEdit::{
                      file: b.init_span.file,
                      line: b.init_span.line,
                      col: b.init_end_col,
                      end_line: b.init_span.line,
                      end_col: b.init_end_col,
                      replacement: ")",
                      applicability: "maybe",
                    })
                  }
                } else if !is_send_ty(tc, b.ty, []) {
                  tc_err(
                    tc,
                    cap.span,
                    "E_NOT_SEND",
                    "cannot capture non-Send value `" + cap.name + "` inside `spawn`",
                    "Send",
                    ty_to_string(b.ty),
                    "wrap `" + cap.name + "` in `Mutex::new(...)` or transfer ownership with `move " + cap.name + "`",
                  )
                  if b.init_span.line > 0 &&
                    b.init_end_col > 0 &&
                    is_send_ty(tc, TMutex(b.ty), []) {
                    if b.ty_span.line > 0 && b.ty_end_col > 0 {
                      tc_add_edit(tc, text_edit_insert_maybe(b.ty_span, 0, "Mutex["))
                      tc_add_edit(tc, TextEdit::{
                        file: b.ty_span.file,
                        line: b.ty_span.line,
                        col: b.ty_end_col,
                        end_line: b.ty_span.line,
                        end_col: b.ty_end_col,
                        replacement: "]",
                        applicability: "maybe",
                      })
                    }
                    tc_add_edit(tc, text_edit_insert_maybe(b.init_span, 0, "Mutex::new("))
                    tc_add_edit(tc, TextEdit::{
                      file: b.init_span.file,
                      line: b.init_span.line,
                      col: b.init_end_col,
                      end_line: b.init_span.line,
                      end_col: b.init_end_col,
                      replacement: ")",
                      applicability: "maybe",
                    })
                  } else if cap.span.line > 0 {
                    tc_add_edit(tc, text_edit_insert_maybe(cap.span, 0, "move "))
                  }
                }
              }
              None => ()
            }
            ci = ci + 1
          }
        }
        _ => ()
      }
      let _ = check_expr(tc, env, f_expr, Some(TFn([], TUnit)))
      TUnit
    }
    EAs(inner, target, sp) => {
      let rty = resolve_type_expr(tc, target, env.type_params)
      match rty {
        TDynTrait(_) => check_expr(tc, env, inner, Some(rty))
        _ => {
          let ity = check_expr(tc, env, inner, None)
          let rty_err = match rty {
            TError => true
            _ => false
          }
          let ity_err = match ity {
            TError => true
            _ => false
          }
          if rty_err || ity_err {
            rty
          } else {
            let rty_never = match rty {
              TNever => true
              _ => false
            }
            let ity_never = match ity {
              TNever => true
              _ => false
            }
            if rty_never {
              if ity_never {
                TNever
              } else {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "cannot cast `" + ty_to_string(ity) + "` to `Never`",
                  "Never",
                  ty_to_string(ity),
                  "only a diverging expression of type `Never` can be cast to `Never`",
                )
                TError
              }
            } else if (ty_is_cast_scalar(ity) && ty_is_cast_scalar(rty)) ||
              ty_is_valid_ptr_cast(ity, rty) ||
              ty_compat(rty, ity) {
              rty
            } else {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "cannot cast `" + ty_to_string(ity) + "` to `" + ty_to_string(rty) + "`",
                "compatible cast target",
                ty_to_string(rty),
                "remove invalid `as " + ty_to_string(rty) + "` cast",
              )
              TError
            }
          }
        }
      }
    }
    ETry(inner, sp) => {
      if env.in_default_expr {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "cannot use `?` in a default parameter expression",
          "expression",
          "`?`",
          "remove `?` from the default parameter expression",
        )
        return TError
      }
      let ity = check_expr(tc, env, inner, None)
      match ity {
        TError => TError
        TResult(ok_ty, err_ty) =>
          match env.ret_ty {
            TResult(_, fn_err_ty) => {
              if !ty_compat(fn_err_ty, err_ty) {
                let ir = resolve_into_conversion(tc, env, err_ty, fn_err_ty, sp)
                match ir.conv {
                  Some(conv) => tc.try_into_convs.set(span_key(sp), conv)
                  None =>
                    if !ir.errored {
                      tc_err(
                        tc,
                        sp,
                        "E_TYPE_MISMATCH",
                        "`?` error type `" +
                        ty_to_string(err_ty) +
                        "` does not match enclosing function error type `" +
                        ty_to_string(fn_err_ty) +
                        "`",
                        ty_to_string(fn_err_ty),
                        ty_to_string(err_ty),
                        "return a matching error type `" + ty_to_string(fn_err_ty) + "`" + ir.available_hint,
                      )
                    }
                }
              }
              ok_ty
            }
            _ => {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "`?` on `Result` requires enclosing function to return `Result[_, " +
                ty_to_string(err_ty) +
                "]`",
                "Result[_, " + ty_to_string(err_ty) + "]",
                ty_to_string(env.ret_ty),
                "change the function return type to `Result[_, " +
                ty_to_string(err_ty) +
                "]` or handle with `match`",
              )
              ok_ty
            }
          }
        TOption(inner_ty) =>
          match env.ret_ty {
            TOption(_) => inner_ty
            _ => {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "`?` on `Option` requires enclosing function to return `Option[_]`",
                "Option[_]",
                ty_to_string(env.ret_ty),
                "change the function return type to `Option[_]` or handle with `match`",
              )
              inner_ty
            }
          }
        _ => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "`?` operator requires `Result[T, E]` or `Option[T]`",
            "Result[T, E] or Option[T]",
            ty_to_string(ity),
            "apply `?` only to `Result` or `Option` expressions",
          )
          TError
        }
      }
    }
    EInterp(parts, sp) => {
      let mut i = 0
      while i < parts.length() {
        let pty = check_expr(tc, env, parts[i], None)
        let ok = match pty {
          TString | TStrView | TInt | TInt64 | TUInt | TUInt64 | TInt8 | TDouble | TFloat | TBool | TChar | TError => true
          _ => false
        }
        if !ok {
          tc_err(
            tc,
            expr_span(parts[i]),
            "E_TYPE_MISMATCH",
            "string interpolation does not support type `" +
            ty_to_string(pty) +
            "`",
            "String, Int, Int64, Double, Bool, or Char",
            ty_to_string(pty),
            "convert the value to `String` before interpolating",
          )
        }
        i = i + 1
      }
      let _ = sp
      TString
    }
  }
}

///|
///|
pub struct CheckedPackage {
  pkg : Package
  tc : TypeChecker
  diagnostics : Array[Diagnostic]
}

///|
pub fn check_package_with_imports(
  pkg : Package,
  check_file : Array[Bool],
  imported : Array[ImportedPkg],
  multi_pkg : Bool,
) -> CheckedPackage {
  check_package_with_imports_ex(pkg, check_file, imported, multi_pkg, false)
}

///|
pub fn check_package_with_imports_ex(
  pkg : Package,
  check_file : Array[Bool],
  imported : Array[ImportedPkg],
  multi_pkg : Bool,
  record_analyze : Bool,
) -> CheckedPackage {
  check_package_with_imports_mapped(
    pkg,
    check_file,
    imported,
    [],
    [],
    multi_pkg,
    record_analyze,
  )
}

///|
pub fn check_package_with_imports_mapped(
  pkg : Package,
  check_file : Array[Bool],
  imported : Array[ImportedPkg],
  dep_aliases : Array[String],
  dep_targets : Array[String],
  multi_pkg : Bool,
  record_analyze : Bool,
) -> CheckedPackage {
  check_package_with_imports_mapped_plan(
    pkg,
    check_file,
    imported,
    dep_aliases,
    dep_targets,
    multi_pkg,
    record_analyze,
    None,
  )
}

///|
fn check_package_with_imports_mapped_plan(
  pkg : Package,
  check_file : Array[Bool],
  imported : Array[ImportedPkg],
  dep_aliases : Array[String],
  dep_targets : Array[String],
  multi_pkg : Bool,
  record_analyze : Bool,
  plan_out : Option[Array[ConstInitPlan]],
) -> CheckedPackage {
  let dep_map : Map[String, String] = Map([])
  let mut dmi = 0
  while dmi < dep_aliases.length() && dmi < dep_targets.length() {
    dep_map.set(dep_aliases[dmi], dep_targets[dmi])
    dmi = dmi + 1
  }
  let tc = TypeChecker::{
    pkg_name: pkg.name,
    pkg_root: "",
    pkg_cwd: "",
    multi_pkg: multi_pkg,
    structs: Map([]),
    struct_names: [],
    enums: Map([]),
    enum_names: [],
    variant_to_enum: Map([]),
    fns: Map([]),
    extern_fns: Map([]),
    extern_fn_names: [],
    methods: Map([]),
    method_names: [],
    traits: Map([]),
    trait_names: [],
    impls: Map([]),
    impl_keys: [],
    consts: Map([]),
    const_pub: Map([]),
    scalar_const_exprs: Map([]),
    const_init_order: [],
    import_aliases: Map([]),
    file_import_aliases: Map([]),
    dep_map: dep_map,
    canon_display_keys: [],
    canon_display_vals: [],
    exported_c_syms: Map([]),
    exported_c_sym_names: [],
    imported_pkgs: Map([]),
    imported_pkg_names: [],
    all_imported_pkgs: Map([]),
    all_imported_pkg_names: [],
    diagnostics: [],
    eq_tparams: Map([]),
    eq_keys: [],
    verify_eq_tparams: Map([]),
    verify_eq_keys: [],
    op_tparams: Map([]),
    op_keys: [],
    map_key_obligations: Map([]),
    map_key_ob_keys: [],
    eq_trait_obligations: Map([]),
    eq_trait_ob_keys: [],
    generic_call_sites: [],
    cur_fn_key: "",
    in_pass3: false,
    expansive_ready: false,
    expansive_defs: Map([]),
    expansive_params: Map([]),
    eq_uses: [],
    resolved_trait_methods: Map([]),
    edit_keys: Map([]),
    let_infer: Map([]),
    shift_rhs_infer: Map([]),
    closure_infer: Map([]),
    dot_variant_resolve: Map([]),
    infer_pending: Map([]),
    infer_hit: [],
    expr_tys: Map([]),
    call_targets: Map([]),
    call_type_args: Map([]),
    call_arg_order: Map([]),
    mut_recv_calls: Map([]),
    record_analyze: record_analyze,
    analyze_closure_captures: Map([]),
    call_into_convs: Map([]),
    try_into_convs: Map([]),
    resolved_method_calls: Map([]),
    never_calls: Map([]),
    in_default_arg_expansion: false,
    in_imported_default_arg: false,
    priv_imported_types: Map([]),
  }

  let mut ipi = 0
  while ipi < imported.length() {
    import_pkg_into_tc(tc, imported[ipi])
    ipi = ipi + 1
  }

  // Register file-level imports and validate package existence
  let has_dep_map = dep_aliases.length() > 0
  let direct_targets : Map[String, Bool] = Map([])
  let mut dti = 0
  while dti < dep_targets.length() {
    direct_targets.set(dep_targets[dti], true)
    dti = dti + 1
  }
  let mut fi_imp = 0
  while fi_imp < pkg.files.length() {
    let f = pkg.files[fi_imp]
    let mut ii = 0
    while ii < f.imports.length() {
      let imp = f.imports[ii]
      let resolved_canon = match tc.dep_map.get(imp.path) {
        Some(canon) =>
          if tc.imported_pkgs.contains(canon) {
            Some(canon)
          } else {
            None
          }
        None =>
          if !has_dep_map && tc.imported_pkgs.contains(imp.path) {
            Some(imp.path)
          } else {
            // Backward-compatible transitive import: if a unique non-directly-aliased
            // transitive package has declared base name `imp.path` (i.e. `imp.path`
            // or `imp.path + "__<8hex>"`), allow importing it unambiguously.
            let prefix = imp.path + "__"
            let mut match_canon = ""
            let mut match_count = 0
            let mut ti = 0
            while ti < tc.imported_pkg_names.length() {
              let cand = tc.imported_pkg_names[ti]
              if !direct_targets.contains(cand) &&
                (cand == imp.path || (cand.length() == prefix.length() + 8 && starts_with_str(cand, prefix))) {
                match_canon = cand
                match_count = match_count + 1
              }
              ti = ti + 1
            }
            if match_count == 1 {
              Some(match_canon)
            } else {
              None
            }
          }
      }
      match resolved_canon {
        Some(canon) => {
          tc.import_aliases.set(imp.alias_name, canon)
          let f_al = match tc.file_import_aliases.get(f.path) {
            Some(m) => m
            None => {
              let m : Map[String, String] = Map([])
              tc.file_import_aliases.set(f.path, m)
              m
            }
          }
          f_al.set(imp.alias_name, canon)
        }
        None =>
          tc_err(
            tc,
            imp.span,
            "E_UNKNOWN_PACKAGE",
            "unknown imported package `" + imp.path + "`",
            "declared dependency in pion.toml",
            imp.path,
            "add `" + imp.path + " = { path = \"...\" }` to `[dependencies]` in `pion.toml`",
          )
      }
      ii = ii + 1
    }
    fi_imp = fi_imp + 1
  }
  tc_build_canon_display_map(tc)

  // Pass 1: register type names (structs & enums)
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          if !tc.structs.contains(sd.name) {
            tc.struct_names.push(sd.name)
          }
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: [],
              field_muts: [],
              field_privs: [],
              field_tys: [],
            },
          )
        }
        DEnum(ed) => {
          if !tc.enums.contains(ed.name) {
            tc.enum_names.push(ed.name)
          }
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: [] })
          let mut vi = 0
          while vi < ed.variants.length() {
            tc.variant_to_enum.set(ed.variants[vi].name, ed.name)
            vi = vi + 1
          }
        }
        DTrait(td) => {
          if !tc.traits.contains(td.name) {
            tc.trait_names.push(td.name)
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: [] })
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  // Pass 2: resolve struct fields, enum variants, function signatures, const types
  let const_spans : Map[String, Span] = Map([])
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          let fnames : Array[String] = []
          let fmuts : Array[Bool] = []
          let fprivs : Array[Bool] = []
          let ftys : Array[Ty] = []
          let mut j = 0
          while j < sd.fields.length() {
            let fld = sd.fields[j]
            fnames.push(fld.name)
            fmuts.push(fld.is_mut)
            fprivs.push(fld.is_priv)
            ftys.push(resolve_type_expr(tc, fld.ty, sd.type_params))
            j = j + 1
          }
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: fnames,
              field_muts: fmuts,
              field_privs: fprivs,
              field_tys: ftys,
            },
          )
        }
        DEnum(ed) => {
          let vinfos : Array[VariantInfo] = []
          let mut vi = 0
          while vi < ed.variants.length() {
            let v = ed.variants[vi]
            let vftys : Array[Ty] = []
            let mut j = 0
            while j < v.fields.length() {
              vftys.push(resolve_type_expr(tc, v.fields[j], ed.type_params))
              j = j + 1
            }
            vinfos.push(VariantInfo::{ name: v.name, field_tys: vftys })
            vi = vi + 1
          }
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: vinfos })
        }
        DFn(fd) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < fd.params.length() {
            let param = fd.params[pi]
            match param.ty {
              TyMissing(psp) => {
                tc_err(
                  tc,
                  psp,
                  "E_MISSING_TYPE",
                  "missing explicit type annotation on parameter `" + param.name + "` of `" + fd.name + "`",
                  "explicit parameter type",
                  "missing",
                  "add `: Type` to parameter `" + param.name + "`",
                )
                ptys.push(TError)
              }
              _ => {
                let raw_pty = resolve_type_expr(tc, param.ty, fd.type_params)
                if param.label_kind == 2 {
                  ptys.push(TOption(raw_pty))
                } else {
                  ptys.push(raw_pty)
                }
              }
            }
            pi = pi + 1
          }
          let rty = match fd.ret_ty {
            TyMissing(rsp) => {
              tc_err(
                tc,
                rsp,
                "E_MISSING_TYPE",
                "missing explicit return type on function `" + fd.name + "`",
                "explicit return type `-> Type`",
                "missing",
                "add `-> ReturnType` to `" + fd.name + "`",
              )
              TError
            }
            _ => resolve_type_expr(tc, fd.ret_ty, fd.type_params)
          }
          let finfo = FnInfo::{ decl: fd, param_tys: ptys, ret_ty: rty, is_imported: false }
          validate_into_fn_decl(tc, fd, finfo)
          let mut bi = 0
          while bi < fd.type_bounds.length() {
            let tb = fd.type_bounds[bi]
            let mut ti = 0
            while ti < tb.traits.length() {
              let tr_name = tb.traits[ti]
              if tr_name == "@builtin:Eq" || (tr_name == "Eq" && !tc.traits.contains("Eq")) {
                ti = ti + 1
                continue
              }
              let stl = lookup_source_trait_ex(tc, tr_name, fd.span, false)
              match stl.info {
                Some(_) => ()
                None =>
                  if !stl.errored {
                    tc_err(
                      tc,
                      fd.span,
                      "E_UNKNOWN_TRAIT",
                      "unknown trait `" + tr_name + "` in generic bound of `" + fd.name + "`",
                      "defined trait",
                      tr_name,
                      "declare `trait " + tr_name + " { ... }` before using it as a bound",
                    )
                  }
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if fd.receiver_type != "" {
            let mk = fd.receiver_type + "::" + fd.name
            match tc.methods.get(mk) {
              Some(prev) =>
                tc_err(
                  tc,
                  fd.span,
                  "E_DUP_DEF",
                  "duplicate method `" +
                  mk +
                  "` (first defined at " +
                  prev.decl.span.file +
                  ":" +
                  prev.decl.span.line.to_string() +
                  ")",
                  "unique method name",
                  mk,
                  "rename or remove the duplicate method `" + mk + "`",
                )
              None => tc.method_names.push(mk)
            }
            tc.methods.set(mk, finfo)
          } else {
            match tc.fns.get(fd.name) {
              Some(prev) =>
                tc_err(
                  tc,
                  fd.span,
                  "E_DUP_DEF",
                  "duplicate top-level function `" +
                  fd.name +
                  "` (first defined at " +
                  prev.decl.span.file +
                  ":" +
                  prev.decl.span.line.to_string() +
                  ")",
                  "unique function name",
                  fd.name,
                  "rename or remove the duplicate function `" + fd.name + "`",
                )
              None =>
                match tc.extern_fns.get(fd.name) {
                  Some(prev_e) =>
                    tc_err(
                      tc,
                      fd.span,
                      "E_DUP_DEF",
                      "duplicate top-level function `" +
                      fd.name +
                      "` (first defined as extern fn at " +
                      prev_e.decl.span.file +
                      ":" +
                      prev_e.decl.span.line.to_string() +
                      ")",
                      "unique function name",
                      fd.name,
                      "rename or remove the conflicting function `" + fd.name + "`",
                    )
                  None => ()
                }
            }
            tc.fns.set(fd.name, finfo)
          }
        }
        DExternFn(ed) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < ed.params.length() {
            let param = ed.params[pi]
            let pty = match param.ty {
              TyMissing(psp) => {
                tc_err(
                  tc,
                  psp,
                  "E_MISSING_TYPE",
                  "missing explicit type annotation on extern parameter `" + param.name + "` of `" + ed.name + "`",
                  "explicit C-ABI parameter type",
                  "missing",
                  "add `: Type` to parameter `" + param.name + "`",
                )
                TError
              }
              _ => resolve_type_expr(tc, param.ty, [])
            }
            if !ed.has_body && !is_c_abi_param_ty(pty) {
              let fix = match pty {
                TString =>
                  "change parameter `" + param.name + "` to `Ptr` and pass `s.as_cstr()` at call sites"
                _ =>
                  "use a C-ABI safe type (`Int`, `Int64`, `Double`, `Bool`, `Byte`, or `Ptr`)"
              }
              tc_err(
                tc,
                param.span,
                "E_TYPE_MISMATCH",
                "extern \"C\" parameter `" + param.name + "` has non-C-ABI type `" + ty_to_string(pty) + "`",
                "Int, Int64, Double, Bool, Byte, or Ptr",
                ty_to_string(pty),
                fix,
              )
            }
            ptys.push(pty)
            pi = pi + 1
          }
          let rty = match ed.ret_ty {
            TyMissing(rsp) => {
              tc_err(
                tc,
                rsp,
                "E_MISSING_TYPE",
                "missing explicit return type on extern function `" + ed.name + "`",
                "explicit C-ABI return type `-> Type`",
                "missing",
                "add `-> ReturnType` to `" + ed.name + "`",
              )
              TError
            }
            _ => resolve_type_expr(tc, ed.ret_ty, [])
          }
          if !ed.has_body && !is_c_abi_ret_ty(rty) {
            let fix = match rty {
              TString => "return `Ptr` from `extern \"C\" fn` instead of managed `String`"
              _ => "use a C-ABI safe return type (`Int`, `Int64`, `Double`, `Bool`, `Byte`, `Ptr`, or `Unit`)"
            }
            tc_err(
              tc,
              ed.span,
              "E_TYPE_MISMATCH",
              "extern \"C\" function `" + ed.name + "` has non-C-ABI return type `" + ty_to_string(rty) + "`",
              "Int, Int64, Double, Bool, Byte, Ptr, or Unit",
              ty_to_string(rty),
              fix,
            )
          }
          match tc.extern_fns.get(ed.name) {
            Some(prev_e) =>
              tc_err(
                tc,
                ed.span,
                "E_DUP_DEF",
                "duplicate extern function `" +
                ed.name +
                "` (first defined at " +
                prev_e.decl.span.file +
                ":" +
                prev_e.decl.span.line.to_string() +
                ")",
                "unique extern function name",
                ed.name,
                "rename or remove the duplicate extern function `" + ed.name + "`",
              )
            None => {
              match tc.fns.get(ed.name) {
                Some(prev_f) =>
                  tc_err(
                    tc,
                    ed.span,
                    "E_DUP_DEF",
                    "duplicate extern function `" +
                    ed.name +
                    "` (conflicts with function defined at " +
                    prev_f.decl.span.file +
                    ":" +
                    prev_f.decl.span.line.to_string() +
                    ")",
                    "unique function name",
                    ed.name,
                    "rename or remove the conflicting extern function `" + ed.name + "`",
                  )
                None => ()
              }
              tc.extern_fn_names.push(ed.name)
            }
          }
          tc.extern_fns.set(
            ed.name,
            ExternFnInfo::{ decl: ed, param_tys: ptys, ret_ty: rty },
          )
          if ed.has_body {
            match tc.exported_c_syms.get(ed.c_symbol) {
              Some(prev_pkg) =>
                tc_err(
                  tc,
                  ed.span,
                  "E_DUPLICATE_C_SYMBOL",
                  "duplicate C export symbol `" +
                  ed.c_symbol +
                  "` already defined in package `" +
                  prev_pkg +
                  "`",
                  "unique C export symbol across packages",
                  ed.c_symbol,
                  "change the C export symbol with `= \"<unique_name>\"`",
                )
              None => {
                tc.exported_c_syms.set(ed.c_symbol, tc.pkg_name)
                tc.exported_c_sym_names.push(ed.c_symbol)
              }
            }
          }
        }
        DTrait(td) => {
          let tmethods : Array[TraitMethodInfo] = []
          let self_tp : Array[String] = ["Self"]
          let mut mi = 0
          while mi < td.methods.length() {
            let tm = td.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < tm.params.length() {
              ptys.push(resolve_type_expr(tc, tm.params[pi].ty, self_tp))
              pi = pi + 1
            }
            let rty = resolve_type_expr(tc, tm.ret_ty, self_tp)
            tmethods.push(TraitMethodInfo::{
              name: tm.name,
              param_tys: ptys,
              ret_ty: rty,
              span: tm.span,
            })
            mi = mi + 1
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: tmethods })
        }
        DImpl(_) => ()
        DConst(cd) => {
          let cty = match cd.ty {
            TyMissing(csp) => {
              tc_err(
                tc,
                csp,
                "E_MISSING_TYPE",
                "missing explicit type annotation on top-level constant `" + cd.name + "`",
                "explicit type `: Type`",
                "missing",
                "add `: Type` to `let " + cd.name + "`",
              )
              TError
            }
            _ => resolve_type_expr(tc, cd.ty, [])
          }
          match const_spans.get(cd.name) {
            Some(prev_sp) =>
              tc_err(
                tc,
                cd.span,
                "E_DUP_DEF",
                "duplicate top-level constant `" +
                cd.name +
                "` (first defined at " +
                prev_sp.file +
                ":" +
                prev_sp.line.to_string() +
                ")",
                "unique constant name",
                cd.name,
                "rename or remove the duplicate constant `" + cd.name + "`",
              )
            None => const_spans.set(cd.name, cd.span)
          }
          tc.consts.set(cd.name, cty)
          tc.const_pub.set(cd.name, cd.is_pub)
          if !cd.is_pub && xpkg_is_const_scalar_expr(cd.value) {
            tc.scalar_const_exprs.set(cd.name, cd.value)
          }
        }
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  // Pass 2.2: resolve and validate `impl Trait for Type` declarations
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DImpl(id) => {
          let mut imi = 0
          while imi < id.methods.length() {
            let imd = id.methods[imi]
            if imd.is_into {
              tc_err(
                tc,
                imd.span,
                "E_INVALID_INTO",
                "`#into` cannot be used on trait `impl` method `" + id.trait_name + "::" + imd.name + "`",
                "inherent `Target::from_...` or `Src::to_...`",
                "`#into` on trait `impl` method",
                "move the `#into` converter to an inherent function/method on the target or source type",
              )
            }
            imi = imi + 1
          }
          let c_trait = canon_trait_name(tc, id.trait_name)
          let c_target = canon_target_type_name(tc, id.target_type)
          let impl_key = c_trait + "::" + c_target
          if c_trait == "@builtin:Eq" {
            // Reject `#verify` / `#verify_opaque` on built-in `impl Eq` (custom `Eq` is unsupported in `#verify`).
            let mut has_verify_attr = id.is_verify
            let mut vmi = 0
            while vmi < id.methods.length() {
              if id.methods[vmi].is_verify || id.methods[vmi].is_verify_opaque {
                has_verify_attr = true
              }
              vmi = vmi + 1
            }
            if has_verify_attr {
              tc_err(
                tc,
                id.span,
                "E_VERIFY_UNSUPPORTED",
                "built-in `impl Eq for " + id.target_type + "` cannot be marked `#verify` or `#verify_opaque`",
                "unannotated `impl Eq` or `#derive(Eq)`",
                "`#verify` on built-in `impl Eq`",
                "remove `#verify` / `#verify_opaque` from `impl Eq for " + id.target_type + "` (or use `#derive(Eq)` for verified equality)",
              )
            }
            // Validate built-in `impl Eq`: orphan rule, derive conflict, duplicate,
            // generic header / target type arguments, and exact `equal` signature.
            let mut target_is_struct = false
            let mut target_is_enum = false
            let mut target_derive_eq = false
            let mut target_decl_tps : Array[String] = []
            if !has_qual_sep(id.target_type) {
              match tc.structs.get(id.target_type) {
                Some(si) => {
                  target_is_struct = true
                  target_derive_eq = si.decl.derive_eq
                  target_decl_tps = si.decl.type_params
                }
                None =>
                  match tc.enums.get(id.target_type) {
                    Some(ei) => {
                      target_is_enum = true
                      target_derive_eq = ei.decl.derive_eq
                      target_decl_tps = ei.decl.type_params
                    }
                    None => ()
                  }
              }
            }
            if !target_is_struct && !target_is_enum {
              tc_err(
                tc,
                id.span,
                "E_TYPE_MISMATCH",
                "built-in `impl Eq` is only allowed for a `struct` or `enum` defined in the current package, found `" +
                id.target_type +
                "`",
                "local `struct` or `enum`",
                id.target_type,
                "define `impl Eq` in the package that declares `" + id.target_type + "`",
              )
            } else {
              if target_derive_eq {
                tc_err(
                  tc,
                  id.span,
                  "E_DUP_DEF",
                  "cannot define both `#derive(Eq)` and `impl Eq` for `" + id.target_type + "`",
                  "either `#derive(Eq)` or `impl Eq`",
                  "both `#derive(Eq)` and `impl Eq`",
                  "remove `#derive(Eq)` from `" + id.target_type + "` or remove `impl Eq`",
                )
              }
              let is_dup_impl = tc.impls.contains(impl_key)
              if is_dup_impl {
                tc_err(
                  tc,
                  id.span,
                  "E_DUP_DEF",
                  "duplicate `impl Eq` for `" + id.target_type + "`",
                  "single `impl Eq` per type",
                  "duplicate `impl Eq`",
                  "remove the duplicate `impl Eq for " + id.target_type + "`",
                )
              }
              // Validate generic header type parameters and bounds
              let seen_impl_tps : Map[String, Bool] = Map([])
              let mut tpi = 0
              while tpi < id.type_params.length() {
                let tpn = id.type_params[tpi]
                if seen_impl_tps.contains(tpn) {
                  tc_err(
                    tc,
                    id.span,
                    "E_DUP_DEF",
                    "duplicate type parameter `" + tpn + "` in `impl Eq for " + id.target_type + "`",
                    "distinct type parameters",
                    tpn,
                    "rename or remove the duplicate type parameter `" + tpn + "`",
                  )
                } else {
                  seen_impl_tps.set(tpn, true)
                }
                tpi = tpi + 1
              }
              let bound_map : Map[String, Array[String]] = Map([])
              let mut bi = 0
              while bi < id.type_bounds.length() {
                let tb = id.type_bounds[bi]
                if !seen_impl_tps.contains(tb.param) {
                  tc_err(
                    tc,
                    id.span,
                    "E_TYPE_MISMATCH",
                    "unbound type parameter `" + tb.param + "` in `impl Eq` bounds",
                    "declared impl type parameter",
                    tb.param,
                    "declare `" + tb.param + "` in `impl[...]`",
                  )
                }
                let ctrs : Array[String] = match bound_map.get(tb.param) {
                  Some(prev) => prev
                  None => []
                }
                let mut ti = 0
                while ti < tb.traits.length() {
                  let raw_tr = tb.traits[ti]
                  let ctr = canon_trait_name(tc, raw_tr)
                  if ctr != "@builtin:Eq" {
                    let stl_b = lookup_source_trait_ex(tc, raw_tr, id.span, false)
                    match stl_b.info {
                      None =>
                        if !stl_b.errored {
                          tc_err(
                            tc,
                            id.span,
                            "E_UNKNOWN_TRAIT",
                            "unknown trait `" + raw_tr + "` in `impl Eq` bound",
                            "defined trait",
                            raw_tr,
                            "declare `trait " + raw_tr + "` or use `Eq`",
                          )
                        }
                      Some(_) => ()
                    }
                  }
                  if str_arr_contains(ctrs, ctr) {
                    tc_err(
                      tc,
                      id.span,
                      "E_TYPE_MISMATCH",
                      "duplicate trait bound `" + display_trait_name(ctr) + "` on `" + tb.param + "` in `impl Eq`",
                      "unique trait bound",
                      raw_tr,
                      "remove the duplicate bound",
                    )
                  } else {
                    ctrs.push(ctr)
                  }
                  ti = ti + 1
                }
                bound_map.set(tb.param, ctrs)
                bi = bi + 1
              }
              // Validate target type arguments: must cover every formal type param once,
              // with no partial specialization, duplicate params, or unbound impl params.
              let target_param_names : Array[String] = []
              let target_param_bounds : Array[Array[String]] = []
              let target_ty_args : Array[Ty] = []
              let mut header_ok = true
              if id.target_type_args.length() != target_decl_tps.length() {
                header_ok = false
                tc_err(
                  tc,
                  id.span,
                  "E_TYPE_MISMATCH",
                  "`impl Eq for " +
                  id.target_type +
                  "` has " +
                  id.target_type_args.length().to_string() +
                  " type argument(s), expected " +
                  target_decl_tps.length().to_string(),
                  target_decl_tps.length().to_string() + " type arguments",
                  id.target_type_args.length().to_string() + " type arguments",
                  "supply all type parameters of `" + id.target_type + "`",
                )
              } else if id.type_params.length() != target_decl_tps.length() {
                header_ok = false
                tc_err(
                  tc,
                  id.span,
                  "E_TYPE_MISMATCH",
                  "`impl Eq for " +
                  id.target_type +
                  "` must declare exactly " +
                  target_decl_tps.length().to_string() +
                  " type parameter(s) (partial specialization and unused type parameters are not supported)",
                  target_decl_tps.length().to_string() + " type parameters",
                  id.type_params.length().to_string() + " type parameters",
                  "match the type parameters of `" + id.target_type + "` one-to-one",
                )
              } else {
                let used_target_tps : Map[String, Bool] = Map([])
                let mut ai = 0
                while ai < id.target_type_args.length() {
                  match id.target_type_args[ai] {
                    TyName(aname, aargs, asp) =>
                      if aargs.length() != 0 || !seen_impl_tps.contains(aname) {
                        header_ok = false
                        tc_err(
                          tc,
                          asp,
                          "E_TYPE_MISMATCH",
                          "partial specialization `" +
                          type_expr_to_string(id.target_type_args[ai]) +
                          "` is not supported in `impl Eq for " +
                          id.target_type +
                          "`",
                          "unspecialized type parameter from `impl[...]`",
                          type_expr_to_string(id.target_type_args[ai]),
                          "use a distinct type parameter from `impl[...]` for each type argument",
                        )
                      } else if used_target_tps.contains(aname) {
                        header_ok = false
                        tc_err(
                          tc,
                          asp,
                          "E_TYPE_MISMATCH",
                          "duplicate type parameter `" +
                          aname +
                          "` in `impl Eq for " +
                          id.target_type +
                          "` target arguments",
                          "distinct type parameters",
                          aname,
                          "use distinct type parameters for each type argument",
                        )
                      } else {
                        used_target_tps.set(aname, true)
                        target_param_names.push(aname)
                        let pbs = match bound_map.get(aname) {
                          Some(b) => b
                          None => []
                        }
                        target_param_bounds.push(pbs)
                        target_ty_args.push(TParam(aname))
                      }
                    other => {
                      header_ok = false
                      tc_err(
                        tc,
                        type_expr_span(other),
                        "E_TYPE_MISMATCH",
                        "partial specialization `" +
                        type_expr_to_string(other) +
                        "` is not supported in `impl Eq for " +
                        id.target_type +
                        "`",
                        "unspecialized type parameter from `impl[...]`",
                        type_expr_to_string(other),
                        "use a distinct type parameter from `impl[...]` for each type argument",
                      )
                    }
                  }
                  ai = ai + 1
                }
              }
              let target_ty = if target_is_struct {
                TStruct(id.target_type, target_ty_args)
              } else {
                TEnum(id.target_type, target_ty_args)
              }
              let self_subst : Map[String, Ty] = Map([])
              self_subst.set("Self", target_ty)
              let resolve_tps : Array[String] = ["Self"]
              tpi = 0
              while tpi < id.type_params.length() {
                resolve_tps.push(id.type_params[tpi])
                tpi = tpi + 1
              }
              let impl_methods : Map[String, FnInfo] = Map([])
              let impl_mnames : Array[String] = []
              if id.methods.length() == 0 {
                tc_err(
                  tc,
                  id.span,
                  "E_TRAIT_METHOD_MISSING",
                  "`impl Eq for " + id.target_type + "` is missing required method `equal`",
                  "fn equal(self : " + ty_to_string(target_ty) + ", other : " + ty_to_string(target_ty) + ") -> Bool",
                  "missing `equal`",
                  "add `fn equal(self : " + ty_to_string(target_ty) + ", other : " + ty_to_string(target_ty) + ") -> Bool { ... }`",
                )
              } else {
                let mut mi = 0
                while mi < id.methods.length() {
                  let md = id.methods[mi]
                  if md.name != "equal" {
                    tc_err(
                      tc,
                      md.span,
                      "E_TRAIT_METHOD_SIGNATURE",
                      "unexpected method `" + md.name + "` in built-in `impl Eq for " + id.target_type + "` (only `equal` is allowed)",
                      "fn equal(self : " + ty_to_string(target_ty) + ", other : " + ty_to_string(target_ty) + ") -> Bool",
                      md.name,
                      "remove `" + md.name + "` or move it to an inherent method",
                    )
                  } else if impl_methods.contains("equal") {
                    tc_err(
                      tc,
                      md.span,
                      "E_TRAIT_METHOD_SIGNATURE",
                      "duplicate method `equal` in `impl Eq for " + id.target_type + "`",
                      "single `equal` method",
                      "duplicate `equal`",
                      "keep only one `equal` method",
                    )
                  } else {
                    if md.type_params.length() > 0 {
                      tc_err(
                        tc,
                        md.span,
                        "E_TRAIT_METHOD_SIGNATURE",
                        "method `equal` in `impl Eq for " + id.target_type + "` cannot declare its own type parameters",
                        "non-generic `equal` method",
                        "generic `equal`",
                        "place type parameters on `impl[...]` instead",
                      )
                    }
                    let ptys : Array[Ty] = []
                    let mut pi = 0
                    let mut params_valid = true
                    while pi < md.params.length() {
                      let mp = md.params[pi]
                      if mp.is_mut {
                        params_valid = false
                        tc_err(
                          tc,
                          mp.span,
                          "E_TRAIT_METHOD_SIGNATURE",
                          "parameter `" + mp.name + "` of `equal` in `impl Eq for " + id.target_type + "` must not be `mut`",
                          "plain parameter",
                          "mut parameter",
                          "remove `mut` from `" + mp.name + "`",
                        )
                      }
                      if mp.is_into || mp.label_kind != 0 || match mp.default_expr { Some(_) => true; None => false } {
                        params_valid = false
                        tc_err(
                          tc,
                          mp.span,
                          "E_TRAIT_METHOD_SIGNATURE",
                          "parameter `" + mp.name + "` of `equal` in `impl Eq for " + id.target_type + "` must be a plain positional parameter",
                          "plain positional parameter",
                          mp.name,
                          "remove labels, defaults, and `into` from `" + mp.name + "`",
                        )
                      }
                      match mp.ty {
                        TyMissing(_) => {
                          params_valid = false
                          ptys.push(TError)
                        }
                        _ => {
                          let raw_p = resolve_type_expr(tc, mp.ty, resolve_tps)
                          ptys.push(subst_ty(raw_p, self_subst))
                        }
                      }
                      pi = pi + 1
                    }
                    let ret_missing = match md.ret_ty {
                      TyMissing(_) => true
                      _ => false
                    }
                    let rty = if ret_missing {
                      TError
                    } else {
                      subst_ty(resolve_type_expr(tc, md.ret_ty, resolve_tps), self_subst)
                    }
                    let exp_sig = "fn equal(" + ty_to_string(target_ty) + ", " + ty_to_string(target_ty) + ") -> Bool"
                    let sig_ok = params_valid &&
                      !ret_missing &&
                      ptys.length() == 2 &&
                      ty_to_string(ptys[0]) == ty_to_string(target_ty) &&
                      ty_to_string(ptys[1]) == ty_to_string(target_ty) &&
                      ty_to_string(rty) == "Bool"
                    if !sig_ok && header_ok {
                      tc_err(
                        tc,
                        md.span,
                        "E_TRAIT_METHOD_SIGNATURE",
                        "method `equal` in `impl Eq for " + id.target_type + "` does not match `Eq` signature",
                        exp_sig,
                        format_method_sig_types(md.name, ptys, rty),
                        "change signature to `" + exp_sig + "`",
                      )
                    }
                    let md_for_fi = if id.type_params.length() > 0 {
                      FnDecl::{
                        is_pub: md.is_pub,
                        no_io: md.no_io,
                        is_into: md.is_into,
                        is_verify: md.is_verify,
                        is_verify_opaque: md.is_verify_opaque,
                        receiver_type: md.receiver_type,
                        name: md.name,
                        type_params: id.type_params,
                        type_bounds: id.type_bounds,
                        params: md.params,
                        ret_ty: md.ret_ty,
                        body: md.body,
                        span: md.span,
                        lparen_span: md.lparen_span,
                      }
                    } else {
                      md
                    }
                    impl_mnames.push("equal")
                    impl_methods.set(
                      "equal",
                      FnInfo::{ decl: md_for_fi, param_tys: ptys, ret_ty: rty, is_imported: false },
                    )
                  }
                  mi = mi + 1
                }
                if !impl_methods.contains("equal") {
                  tc_err(
                    tc,
                    id.span,
                    "E_TRAIT_METHOD_MISSING",
                    "`impl Eq for " + id.target_type + "` is missing required method `equal`",
                    "fn equal(self : " + ty_to_string(target_ty) + ", other : " + ty_to_string(target_ty) + ") -> Bool",
                    "missing `equal`",
                    "add `fn equal(self : " + ty_to_string(target_ty) + ", other : " + ty_to_string(target_ty) + ") -> Bool { ... }`",
                  )
                }
              }
              if !is_dup_impl {
                tc.impl_keys.push(impl_key)
                tc.impls.set(
                  impl_key,
                  ImplInfo::{
                    decl: id,
                    pkg_name: pkg.name,
                    trait_name: "@builtin:Eq",
                    target_type: c_target,
                    target_param_names: target_param_names,
                    target_param_bounds: target_param_bounds,
                    methods: impl_methods,
                    method_names: impl_mnames,
                  },
                )
              }
            }
          } else {
          let target_ty = resolve_type_expr(
            tc,
            TyName(id.target_type, [], id.span),
            [],
          )
          let self_subst : Map[String, Ty] = Map([])
          self_subst.set("Self", target_ty)
          let self_tp : Array[String] = ["Self"]
          let impl_methods : Map[String, FnInfo] = Map([])
          let impl_mnames : Array[String] = []
          let mut mi = 0
          while mi < id.methods.length() {
            let md = id.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < md.params.length() {
              let raw_p = resolve_type_expr(tc, md.params[pi].ty, self_tp)
              ptys.push(subst_ty(raw_p, self_subst))
              pi = pi + 1
            }
            let raw_r = resolve_type_expr(tc, md.ret_ty, self_tp)
            let rty = subst_ty(raw_r, self_subst)
            let finfo = FnInfo::{ decl: md, param_tys: ptys, ret_ty: rty, is_imported: false }
            if !impl_methods.contains(md.name) {
              impl_mnames.push(md.name)
            }
            impl_methods.set(md.name, finfo)
            mi = mi + 1
          }
          if !tc.impls.contains(impl_key) {
            tc.impl_keys.push(impl_key)
          }
          tc.impls.set(
            impl_key,
            ImplInfo::{
              decl: id,
              pkg_name: pkg.name,
              trait_name: c_trait,
              target_type: c_target,
              target_param_names: [],
              target_param_bounds: [],
              methods: impl_methods,
              method_names: impl_mnames,
            },
          )
          let stl_impl = lookup_source_trait_ex(tc, id.trait_name, id.span, false)
          match stl_impl.info {
            None =>
              if !stl_impl.errored {
                tc_err(
                  tc,
                  id.span,
                  "E_UNKNOWN_TRAIT",
                  "unknown trait `" + id.trait_name + "` in `impl`",
                  "defined trait",
                  id.trait_name,
                  "declare `trait " + id.trait_name + " { ... }` or check its spelling",
                )
              }
            Some(tinfo) => {
              let mut tmi = 0
              while tmi < tinfo.methods.length() {
                let tm = tinfo.methods[tmi]
                let exp_ptys : Array[Ty] = []
                let mut j = 0
                while j < tm.param_tys.length() {
                  exp_ptys.push(subst_ty(tm.param_tys[j], self_subst))
                  j = j + 1
                }
                let exp_rty = subst_ty(tm.ret_ty, self_subst)
                let exp_sig = format_method_sig_types(tm.name, exp_ptys, exp_rty)
                match impl_methods.get(tm.name) {
                  None =>
                    tc_err(
                      tc,
                      id.span,
                      "E_TRAIT_METHOD_MISSING",
                      "`impl " +
                      id.trait_name +
                      " for " +
                      id.target_type +
                      "` is missing required method `" +
                      tm.name +
                      "`",
                      exp_sig,
                      "missing `" + tm.name + "`",
                      "add `" + exp_sig + " { ... }` to `impl " + id.trait_name + " for " + id.target_type + "`",
                    )
                  Some(impl_fi) => {
                    let tm_decl_params = if tmi < tinfo.decl.methods.length() {
                      tinfo.decl.methods[tmi].params
                    } else {
                      []
                    }
                    let mut mq = 0
                    while mq < impl_fi.decl.params.length() && mq < tm_decl_params.length() {
                      if impl_fi.decl.params[mq].is_mut != tm_decl_params[mq].is_mut {
                        tc_err(
                          tc,
                          impl_fi.decl.params[mq].span,
                          "E_TRAIT_METHOD_SIGNATURE",
                          "parameter `" + impl_fi.decl.params[mq].name + "` of `" + tm.name + "` in `impl " + id.trait_name + " for " + id.target_type + "` must " + (if tm_decl_params[mq].is_mut { "" } else { "not " }) + "be `mut` to match the trait",
                          if tm_decl_params[mq].is_mut { "mut parameter" } else { "plain parameter" },
                          if impl_fi.decl.params[mq].is_mut { "mut parameter" } else { "plain parameter" },
                          "make the `mut` markers of `" + tm.name + "` match the trait declaration",
                        )
                      }
                      mq = mq + 1
                    }
                    let mut sig_ok = impl_fi.param_tys.length() == exp_ptys.length() &&
                      ty_compat(exp_rty, impl_fi.ret_ty)
                    if sig_ok {
                      let mut k = 0
                      while k < exp_ptys.length() {
                        if !ty_compat(exp_ptys[k], impl_fi.param_tys[k]) {
                          sig_ok = false
                          break
                        }
                        k = k + 1
                      }
                    }
                    if !sig_ok {
                      let act_sig = format_method_sig_types(
                        tm.name,
                        impl_fi.param_tys,
                        impl_fi.ret_ty,
                      )
                      tc_err(
                        tc,
                        impl_fi.decl.span,
                        "E_TRAIT_METHOD_SIGNATURE",
                        "method `" +
                        tm.name +
                        "` in `impl " +
                        id.trait_name +
                        " for " +
                        id.target_type +
                        "` does not match trait signature",
                        exp_sig,
                        act_sig,
                        "change signature to `" + exp_sig + "`",
                      )
                      // Return type alone differs: replace it in place.
                      let mut params_ok = impl_fi.param_tys.length() ==
                        exp_ptys.length()
                      let mut k2 = 0
                      while params_ok && k2 < exp_ptys.length() {
                        if !ty_compat(exp_ptys[k2], impl_fi.param_tys[k2]) {
                          params_ok = false
                        }
                        k2 = k2 + 1
                      }
                      let exp_rs = ty_to_string(exp_rty)
                      if params_ok && !has_qual_sep(exp_rs) {
                        let rte = impl_fi.decl.ret_ty
                        let rsp = type_expr_span(rte)
                        let end_col = type_expr_end_col(rte)
                        if end_col > 0 {
                          tc_add_edit(tc, TextEdit::{
                            file: rsp.file,
                            line: rsp.line,
                            col: rsp.col,
                            end_line: rsp.line,
                            end_col: end_col,
                            replacement: exp_rs,
                            applicability: "machine",
                          })
                        }
                      }
                    }
                  }
                }
                tmi = tmi + 1
              }
            }
          }
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  // Pass 2.5: check `val struct` invariants (zero `mut` fields, all fields `Send`)
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          if sd.is_val {
            match tc.structs.get(sd.name) {
              Some(sinfo) => {
                let mut j = 0
                while j < sinfo.field_tys.length() {
                  let fld = sd.fields[j]
                  if fld.is_mut {
                    tc_err(
                      tc,
                      fld.span,
                      "E_NOT_SEND",
                      "`val struct` `" + sd.name + "` cannot have `mut` field `" + fld.name + "`",
                      "immutable Send field",
                      "mut " + ty_to_string(sinfo.field_tys[j]),
                      "remove `mut` from `" + fld.name + "` or remove `val` from `" + sd.name + "`",
                    )
                  } else if !is_send_ty(tc, sinfo.field_tys[j], []) {
                    tc_err(
                      tc,
                      fld.span,
                      "E_NOT_SEND",
                      "`val struct` `" + sd.name + "` field `" + fld.name + "` has non-Send type `" + ty_to_string(sinfo.field_tys[j]) + "`",
                      "Send",
                      ty_to_string(sinfo.field_tys[j]),
                      "replace `" + fld.name + "` with a `Send` type or remove `val` from `" + sd.name + "`",
                    )
                  }
                  j = j + 1
                }
              }
              None => ()
            }
          }
          if sd.derive_eq {
            match tc.structs.get(sd.name) {
              Some(sinfo) => {
                let mut j = 0
                while j < sinfo.field_tys.length() {
                  let fty = sinfo.field_tys[j]
                  if !eq_comparable(tc, fty) {
                    let fld = sd.fields[j]
                    tc_err(
                      tc,
                      fld.span,
                      "E_TYPE_MISMATCH",
                      "`#derive(Eq)` struct `" + sd.name + "` field `" + fld.name + "` has non-Eq type `" + ty_to_string(fty) + "`",
                      "Eq-comparable field type",
                      ty_to_string(fty),
                      "add `#derive(Eq)` to `" + ty_to_string(fty) + "` or remove `#derive(Eq)` from `" + sd.name + "`",
                    )
                  }
                  j = j + 1
                }
              }
              None => ()
            }
          }
          match tc.structs.get(sd.name) {
            Some(sinfo) => {
              let mut j = 0
              while j < sinfo.field_tys.length() {
                tc_check_custom_eq_map_keys_in_ty(tc, sinfo.field_tys[j], sd.fields[j].span)
                j = j + 1
              }
            }
            None => ()
          }
        }
        DEnum(ed) => {
          if ed.derive_eq {
            match tc.enums.get(ed.name) {
              Some(einfo) => {
                let mut vi = 0
                while vi < einfo.variants.length() {
                  let v = einfo.variants[vi]
                  let mut j = 0
                  while j < v.field_tys.length() {
                    let fty = v.field_tys[j]
                    if !eq_comparable(tc, fty) {
                      tc_err(
                        tc,
                        ed.variants[vi].span,
                        "E_TYPE_MISMATCH",
                        "`#derive(Eq)` enum `" + ed.name + "` variant `" + v.name + "` has non-Eq field type `" + ty_to_string(fty) + "`",
                        "Eq-comparable field type",
                        ty_to_string(fty),
                        "add `#derive(Eq)` to `" + ty_to_string(fty) + "` or remove `#derive(Eq)` from `" + ed.name + "`",
                      )
                    }
                    j = j + 1
                  }
                  vi = vi + 1
                }
              }
              None => ()
            }
          }
          match tc.enums.get(ed.name) {
            Some(einfo) => {
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                let mut j = 0
                while j < v.field_tys.length() {
                  tc_check_custom_eq_map_keys_in_ty(tc, v.field_tys[j], ed.variants[vi].span)
                  j = j + 1
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        }
        DFn(fd) => {
          let finfo_opt = if fd.receiver_type != "" {
            tc.methods.get(fd.receiver_type + "::" + fd.name)
          } else {
            tc.fns.get(fd.name)
          }
          match finfo_opt {
            Some(finfo) => {
              let fn_key = if fd.type_params.length() > 0 { span_key(fd.span) } else { "" }
              let mut pi = 0
              while pi < finfo.param_tys.length() {
                let psp = if pi < fd.params.length() { fd.params[pi].span } else { fd.span }
                tc_check_custom_eq_map_keys_in_ty(tc, finfo.param_tys[pi], psp)
                record_map_key_tparams_in_ty(tc, fn_key, finfo.param_tys[pi])
                pi = pi + 1
              }
              tc_check_custom_eq_map_keys_in_ty(tc, finfo.ret_ty, fd.span)
              record_map_key_tparams_in_ty(tc, fn_key, finfo.ret_ty)
            }
            None => ()
          }
        }
        DExternFn(ed) =>
          match tc.extern_fns.get(ed.name) {
            Some(einfo) => {
              let mut pi = 0
              while pi < einfo.param_tys.length() {
                let psp = if pi < ed.params.length() { ed.params[pi].span } else { ed.span }
                tc_check_custom_eq_map_keys_in_ty(tc, einfo.param_tys[pi], psp)
                pi = pi + 1
              }
              tc_check_custom_eq_map_keys_in_ty(tc, einfo.ret_ty, ed.span)
            }
            None => ()
          }
        DConst(cd) =>
          match tc.consts.get(cd.name) {
            Some(cty) => tc_check_custom_eq_map_keys_in_ty(tc, cty, cd.span)
            None => ()
          }
        DTrait(td) =>
          match tc.traits.get(td.name) {
            Some(tinfo) => {
              let mut mi = 0
              while mi < tinfo.methods.length() {
                let tm = tinfo.methods[mi]
                let mut pi = 0
                while pi < tm.param_tys.length() {
                  tc_check_custom_eq_map_keys_in_ty(tc, tm.param_tys[pi], tm.span)
                  pi = pi + 1
                }
                tc_check_custom_eq_map_keys_in_ty(tc, tm.ret_ty, tm.span)
                mi = mi + 1
              }
            }
            None => ()
          }
        DImpl(id) => {
          let ikey = canon_trait_name(tc, id.trait_name) + "::" + canon_target_type_name(tc, id.target_type)
          match tc.impls.get(ikey) {
            Some(iinfo) => {
              let mut mi = 0
              while mi < iinfo.method_names.length() {
                match iinfo.methods.get(iinfo.method_names[mi]) {
                  Some(finfo) => {
                    let mut pi = 0
                    while pi < finfo.param_tys.length() {
                      tc_check_custom_eq_map_keys_in_ty(tc, finfo.param_tys[pi], finfo.decl.span)
                      pi = pi + 1
                    }
                    tc_check_custom_eq_map_keys_in_ty(tc, finfo.ret_ty, finfo.decl.span)
                  }
                  None => ()
                }
                mi = mi + 1
              }
            }
            None => ()
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  // Pass 3: type-check function bodies and constant initializers
  tc.in_pass3 = true
  fi = 0
  while fi < pkg.files.length() {
    if fi < check_file.length() && !check_file[fi] {
      fi = fi + 1
      continue
    }
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => {
          let finfo_opt = if fd.receiver_type != "" {
            tc.methods.get(fd.receiver_type + "::" + fd.name)
          } else {
            tc.fns.get(fd.name)
          }
          match finfo_opt {
            Some(finfo) => {
              let env = env_new(finfo.ret_ty, fd.type_params)
              env.fn_lparen_span = fd.lparen_span
              env.fn_has_params = fd.params.length() > 0
              env.in_no_io = fd.no_io
              env.no_io_fn_name = if fd.receiver_type != "" {
                fd.receiver_type + "::" + fd.name
              } else {
                fd.name
              }
              env.in_verify = fd.is_verify
              env.verify_fn_name = env.no_io_fn_name
              if fd.type_params.length() > 0 {
                env.fn_key = span_key(fd.span)
              }
              let saved_fn_key = tc.cur_fn_key
              tc.cur_fn_key = env.fn_key
              let mut bi = 0
              while bi < fd.type_bounds.length() {
                let tb = fd.type_bounds[bi]
                let ctrs : Array[String] = []
                let mut ti = 0
                while ti < tb.traits.length() {
                  ctrs.push(canon_trait_name(tc, tb.traits[ti]))
                  ti = ti + 1
                }
                env.type_bounds.set(tb.param, ctrs)
                bi = bi + 1
              }
              let mut pi = 0
              while pi < fd.params.length() && pi < finfo.param_tys.length() {
                match fd.params[pi].default_expr {
                  Some(def) => {
                    let saved_in_def_expr = env.in_default_expr
                    env.in_default_expr = true
                    let dty = check_expr(tc, env, def, Some(finfo.param_tys[pi]))
                    env.in_default_expr = saved_in_def_expr
                    if !ty_compat(finfo.param_tys[pi], dty) {
                      tc_err(
                        tc,
                        expr_span(def),
                        "E_TYPE_MISMATCH",
                        "default value type mismatch for parameter `" +
                        fd.params[pi].name +
                        "` of `" +
                        fd.name +
                        "`",
                        ty_to_string(finfo.param_tys[pi]),
                        ty_to_string(dty),
                        "provide a default value of type `" +
                        ty_to_string(finfo.param_tys[pi]) +
                        "`",
                      )
                    }
                  }
                  None => ()
                }
                let mut pty_def = finfo.param_tys[pi]
                if fd.no_io {
                  match finfo.param_tys[pi] {
                    TWorld => {
                      tc_err(
                        tc,
                        fd.params[pi].span,
                        "E_NO_IO_VIOLATION",
                        "`#no_io` / `#render_thread` function `" + env.no_io_fn_name + "` cannot accept a `World` capability (blocking IO is forbidden on the render thread)",
                        "no World parameter",
                        "World",
                        "move blocking IO/compute into a background worker thread (`spawn` + `Channel` + `wake_now`) and pass only a command sender into the render function",
                      )
                      pty_def = TError
                    }
                    _ => ()
                  }
                }
                env_define_line(env, fd.params[pi].name, pty_def, fd.params[pi].is_mut, fd.params[pi].span.line)
                if fd.params[pi].is_mut {
                  env.mut_params.set(fd.params[pi].name, true)
                }
                pi = pi + 1
              }
              let body_ty = check_stmts(tc, env, fd.body, Some(finfo.ret_ty))
              tc_check_moves_fn_decl(tc, fd.params, fd.body)
              if fd.is_verify {
                verify_check_fn(tc, fd, finfo, env.verify_fn_name, env.fn_key)
              }
              match fd.ret_ty {
                // Missing `-> T`: patch in the type the body actually produces.
                TyMissing(rsp) =>
                  match body_ty {
                    TError | TNever => ()
                    _ => {
                      let rs = ty_to_string(body_ty)
                      if !has_qual_sep(rs) {
                        tc_add_edit_at(
                          tc,
                          tc_find_diag(tc, "E_MISSING_TYPE", rsp),
                          text_edit_insert(rsp, 0, "-> " + rs + " "),
                        )
                      }
                    }
                  }
                _ => ()
              }
              let is_never_ret = match finfo.ret_ty {
                TNever => true
                _ => false
              }
              if is_never_ret {
                if !stmts_diverge(tc, env, fd.body, 1, false) {
                  tc_err(
                    tc,
                    fd.span,
                    "E_TYPE_MISMATCH",
                    "function `" + fd.name + "` declared to return `Never` may return normally",
                    "Never",
                    ty_to_string(body_ty),
                    "ensure all paths diverge (e.g. `panic(...)`)",
                  )
                }
              } else if !ty_compat(finfo.ret_ty, body_ty) {
                tc_err(
                  tc,
                  fd.span,
                  "E_TYPE_MISMATCH",
                  "function `" + fd.name + "` body type does not match declared return type",
                  ty_to_string(finfo.ret_ty),
                  ty_to_string(body_ty),
                  "return a value of type `" + ty_to_string(finfo.ret_ty) + "`",
                )
                match fd.ret_ty {
                  TyMissing(_) => ()
                  _ =>
                    match body_ty {
                      TError | TNever => ()
                      _ => {
                        let body_rs = ty_to_string(body_ty)
                        if !has_qual_sep(body_rs) {
                          let rsp = type_expr_span(fd.ret_ty)
                          let end_col = type_expr_end_col(fd.ret_ty)
                          if end_col > 0 {
                            tc_add_edit(tc, TextEdit::{
                              file: rsp.file,
                              line: rsp.line,
                              col: rsp.col,
                              end_line: rsp.line,
                              end_col: end_col,
                              replacement: body_rs,
                              applicability: "machine",
                            })
                          }
                        }
                      }
                    }
                }
              }
              tc.cur_fn_key = saved_fn_key
            }
            None => ()
          }
        }
        DExternFn(ed) =>
          if ed.has_body {
            match tc.extern_fns.get(ed.name) {
              Some(einfo) => {
                let env = env_new(einfo.ret_ty, [])
                let mut pi = 0
                while pi < ed.params.length() && pi < einfo.param_tys.length() {
                  env_define_line(env, ed.params[pi].name, einfo.param_tys[pi], false, ed.params[pi].span.line)
                  pi = pi + 1
                }
                let body_ty = check_stmts(tc, env, ed.body, Some(einfo.ret_ty))
                tc_check_moves_fn_decl(tc, ed.params, ed.body)
                if !ty_compat(einfo.ret_ty, body_ty) {
                  tc_err(
                    tc,
                    ed.span,
                    "E_TYPE_MISMATCH",
                    "extern \"C\" function `" + ed.name + "` body type does not match declared return type",
                    ty_to_string(einfo.ret_ty),
                    ty_to_string(body_ty),
                    "return a value of type `" + ty_to_string(einfo.ret_ty) + "`",
                  )
                }
              }
              None => ()
            }
          }
        DImpl(id) => {
          let impl_key = canon_trait_name(tc, id.trait_name) +
            "::" +
            canon_target_type_name(tc, id.target_type)
          match tc.impls.get(impl_key) {
            Some(iinfo) => {
              let mut mi = 0
              while mi < id.methods.length() {
                let md = id.methods[mi]
                match iinfo.methods.get(md.name) {
                  Some(finfo) => {
                    let impl_tps = if id.type_params.length() > 0 {
                      id.type_params
                    } else {
                      md.type_params
                    }
                    let env = env_new(finfo.ret_ty, impl_tps)
                    env.fn_key = span_key(md.span)
                    let saved_fn_key = tc.cur_fn_key
                    tc.cur_fn_key = env.fn_key
                    let mut bi = 0
                    while bi < id.type_bounds.length() {
                      let tb = id.type_bounds[bi]
                      let ctrs : Array[String] = []
                      let mut ti = 0
                      while ti < tb.traits.length() {
                        ctrs.push(canon_trait_name(tc, tb.traits[ti]))
                        ti = ti + 1
                      }
                      env.type_bounds.set(tb.param, ctrs)
                      bi = bi + 1
                    }
                    bi = 0
                    while bi < md.type_bounds.length() {
                      let tb = md.type_bounds[bi]
                      let ctrs : Array[String] = []
                      let mut ti = 0
                      while ti < tb.traits.length() {
                        ctrs.push(canon_trait_name(tc, tb.traits[ti]))
                        ti = ti + 1
                      }
                      env.type_bounds.set(tb.param, ctrs)
                      bi = bi + 1
                    }
                    env.in_no_io = md.no_io
                    env.no_io_fn_name = if md.receiver_type != "" {
                      md.receiver_type + "::" + md.name
                    } else {
                      md.name
                    }
                    env.in_verify = md.is_verify
                    env.verify_fn_name = id.trait_name + "::" + id.target_type + "::" + md.name
                    let mut pi = 0
                    while pi < md.params.length() && pi < finfo.param_tys.length() {
                      match md.params[pi].default_expr {
                        Some(def) => {
                          let saved_in_def_expr = env.in_default_expr
                          env.in_default_expr = true
                          let dty = check_expr(tc, env, def, Some(finfo.param_tys[pi]))
                          env.in_default_expr = saved_in_def_expr
                          if !ty_compat(finfo.param_tys[pi], dty) {
                            tc_err(
                              tc,
                              expr_span(def),
                              "E_TYPE_MISMATCH",
                              "default value type mismatch for parameter `" +
                              md.params[pi].name +
                              "` of `" +
                              md.name +
                              "`",
                              ty_to_string(finfo.param_tys[pi]),
                              ty_to_string(dty),
                              "provide a default value of type `" +
                              ty_to_string(finfo.param_tys[pi]) +
                              "`",
                            )
                          }
                        }
                        None => ()
                      }
                      let mut pty_def = finfo.param_tys[pi]
                      if md.no_io {
                        match finfo.param_tys[pi] {
                          TWorld => {
                            tc_err(
                              tc,
                              md.params[pi].span,
                              "E_NO_IO_VIOLATION",
                              "`#no_io` / `#render_thread` function `" + env.no_io_fn_name + "` cannot accept a `World` capability (blocking IO is forbidden on the render thread)",
                              "no World parameter",
                              "World",
                              "move blocking IO/compute into a background worker thread (`spawn` + `Channel` + `wake_now`) and pass only a command sender into the render function",
                            )
                            pty_def = TError
                          }
                          _ => ()
                        }
                      }
                      env_define_line(env, md.params[pi].name, pty_def, md.params[pi].is_mut, md.params[pi].span.line)
                      if md.params[pi].is_mut {
                        env.mut_params.set(md.params[pi].name, true)
                      }
                      pi = pi + 1
                    }
                    let body_ty = check_stmts(tc, env, md.body, Some(finfo.ret_ty))
                    tc_check_moves_fn_decl(tc, md.params, md.body)
                    if md.is_verify {
                      verify_check_fn(tc, md, finfo, env.verify_fn_name, env.fn_key)
                    }
                    let is_never_ret = match finfo.ret_ty {
                      TNever => true
                      _ => false
                    }
                    if is_never_ret {
                      if !stmts_diverge(tc, env, md.body, 1, false) {
                        tc_err(
                          tc,
                          md.span,
                          "E_TYPE_MISMATCH",
                          "impl method `" +
                          id.trait_name +
                          "::" +
                          md.name +
                          "` declared to return `Never` may return normally",
                          "Never",
                          ty_to_string(body_ty),
                          "ensure all paths diverge (e.g. `panic(...)`)",
                        )
                      }
                    } else if !ty_compat(finfo.ret_ty, body_ty) {
                      tc_err(
                        tc,
                        md.span,
                        "E_TYPE_MISMATCH",
                        "impl method `" +
                        id.trait_name +
                        "::" +
                        md.name +
                        "` body type does not match declared return type",
                        ty_to_string(finfo.ret_ty),
                        ty_to_string(body_ty),
                        "return a value of type `" + ty_to_string(finfo.ret_ty) + "`",
                      )
                    }
                    tc.cur_fn_key = saved_fn_key
                  }
                  None => ()
                }
                mi = mi + 1
              }
            }
            None => ()
          }
        }
        DConst(cd) => {
          let cty = match tc.consts.get(cd.name) {
            Some(t) => t
            None => TError
          }
          let env = env_new(TUnit, [])
          let vty = check_expr(tc, env, cd.value, Some(cty))
          let cms = move_state_new()
          tc_check_moves_in_expr(tc, cms, cd.value)
          if !ty_compat(cty, vty) {
            tc_err(
              tc,
              cd.span,
              "E_TYPE_MISMATCH",
              "constant `" + cd.name + "` initializer type mismatch",
              ty_to_string(cty),
              ty_to_string(vty),
              "initialize `" + cd.name + "` with a value of type `" + ty_to_string(cty) + "`",
            )
          }
        }
        DTest(td) => {
          let env = env_new(TUnit, [])
          let _ = check_stmts_ex(tc, env, td.body, None, false)
          let tms = move_state_new()
          tc_check_moves_in_stmts(tc, tms, td.body)
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  if check_file.length() == 0 && const_spans.length() > 0 {
    let plan = compute_const_init_plan_from_pkg_tc(pkg, tc)
    match plan_out {
      Some(out) => out.push(plan)
      None => ()
    }
    let mut pi = 0
    while pi < plan.order.length() {
      tc.const_init_order.push(plan.order[pi])
      pi = pi + 1
    }
    if plan.has_cycle && plan.cycle_path.length() >= 2 {
      let cyc_str = join_strs(plan.cycle_path, " -> ")
      let cyc_sp = match const_spans.get(plan.cycle_path[0]) {
        Some(sp) => sp
        None => Span::{ file: "", line: 1, col: 1 }
      }
      tc_err(
        tc,
        cyc_sp,
        "E_CONST_CYCLE",
        "cyclic top-level constant initialization: " + cyc_str,
        "acyclic top-level constant initialization order",
        cyc_str,
        "break the dependency cycle between top-level constants (e.g. move computation into a function called at runtime)",
      )
    }
  } else if check_file.length() == 0 {
    // No top-level constant means no `#cdep` row, so the planner would return
    // its empty plan (n_consts == 0); record that instead of emitting every
    // resolved file summary again in `cli_prepare_qbe_units`.
    match plan_out {
      Some(out) =>
        out.push(ConstInitPlan::{
          order: [],
          has_cycle: false,
          cycle_path: [],
          plan_hash: "",
          has_ambiguous_method: false,
        })
      None => ()
    }
  }

  resolve_eq_uses(tc)
  // Verify that generic built-in `impl Eq` bodies do not compare unbounded type parameters.
  fi = 0
  while fi < pkg.files.length() {
    if fi < check_file.length() && !check_file[fi] {
      fi = fi + 1
      continue
    }
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DImpl(id) =>
          if canon_trait_name(tc, id.trait_name) == "@builtin:Eq" &&
            id.type_params.length() > 0 &&
            id.methods.length() == 1 {
            let md = id.methods[0]
            match tc.eq_tparams.get(span_key(md.span)) {
              Some(used_tps) => {
                let mut ui = 0
                while ui < used_tps.length() {
                  let utp = used_tps[ui]
                  let mut has_eq_bound = false
                  let mut bi = 0
                  while bi < id.type_bounds.length() {
                    if id.type_bounds[bi].param == utp {
                      let mut ti = 0
                      while ti < id.type_bounds[bi].traits.length() {
                        if canon_trait_name(tc, id.type_bounds[bi].traits[ti]) == "@builtin:Eq" {
                          has_eq_bound = true
                        }
                        ti = ti + 1
                      }
                    }
                    bi = bi + 1
                  }
                  if !has_eq_bound {
                    tc_err(
                      tc,
                      md.span,
                      "E_TRAIT_NOT_IMPLEMENTED",
                      "`impl Eq for " +
                      id.target_type +
                      "` compares type parameter `" +
                      utp +
                      "` with `==`/`!=`, but `" +
                      utp +
                      "` is not bounded by `Eq`",
                      utp + " : Eq",
                      utp,
                      "add `" + utp + " : Eq` to the `impl[...]` header",
                    )
                  }
                  ui = ui + 1
                }
              }
              None => ()
            }
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  CheckedPackage::{ pkg: pkg, tc: tc, diagnostics: tc.diagnostics }
}

///|
pub fn check_package_selective(
  pkg : Package,
  check_file : Array[Bool],
) -> CheckedPackage {
  check_package_with_imports(pkg, check_file, [], false)
}

///|
pub fn check_package_full(pkg : Package) -> CheckedPackage {
  check_package_selective(pkg, [])
}

///|
pub fn check_package(pkg : Package) -> CheckResult {
  let r = check_package_full(pkg)
  CheckResult::{ diagnostics: r.diagnostics }
}

///|
pub fn check_source_files_with_imports(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  imported : Array[ImportedPkg],
  multi_pkg : Bool,
) -> CheckedPackage {
  check_source_files_with_imports_ex(
    pkg_name,
    paths,
    sources,
    imported,
    multi_pkg,
    false,
  )
}

///|
pub fn check_source_files_with_imports_ex(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  imported : Array[ImportedPkg],
  multi_pkg : Bool,
  record_analyze : Bool,
) -> CheckedPackage {
  check_source_files_with_imports_mapped(
    pkg_name,
    paths,
    sources,
    imported,
    [],
    [],
    multi_pkg,
    record_analyze,
  )
}

///|
pub fn check_source_files_with_imports_mapped(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  imported : Array[ImportedPkg],
  dep_aliases : Array[String],
  dep_targets : Array[String],
  multi_pkg : Bool,
  record_analyze : Bool,
) -> CheckedPackage {
  check_source_files_with_imports_mapped_plan(
    pkg_name,
    paths,
    sources,
    imported,
    dep_aliases,
    dep_targets,
    multi_pkg,
    record_analyze,
    None,
  )
}

///|
fn check_source_files_with_imports_mapped_plan(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  imported : Array[ImportedPkg],
  dep_aliases : Array[String],
  dep_targets : Array[String],
  multi_pkg : Bool,
  record_analyze : Bool,
  plan_out : Option[Array[ConstInitPlan]],
) -> CheckedPackage {
  let all_diags : Array[Diagnostic] = []
  let files : Array[SourceFile] = []
  let mut i = 0
  while i < paths.length() && i < sources.length() {
    let pr = parse_source(paths[i], sources[i])
    let mut j = 0
    while j < pr.diagnostics.length() {
      all_diags.push(pr.diagnostics[j])
      j = j + 1
    }
    files.push(pr.file)
    i = i + 1
  }
  let pkg = Package::{ name: pkg_name, files: files }
  let cr = check_package_with_imports_mapped_plan(
    pkg,
    [],
    imported,
    dep_aliases,
    dep_targets,
    multi_pkg,
    record_analyze,
    plan_out,
  )
  let mut k = 0
  while k < cr.diagnostics.length() {
    all_diags.push(cr.diagnostics[k])
    k = k + 1
  }
  CheckedPackage::{ pkg: pkg, tc: cr.tc, diagnostics: all_diags }
}

///|
pub fn check_source_files_full(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> CheckedPackage {
  check_source_files_with_imports(pkg_name, paths, sources, [], false)
}

///|
pub fn check_source_files(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> CheckResult {
  let cr = check_source_files_full(pkg_name, paths, sources)
  CheckResult::{ diagnostics: cr.diagnostics }
}
