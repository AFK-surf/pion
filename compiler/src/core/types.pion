///|
pub enum Ty {
  TInt
  TInt64
  TUInt
  TUInt64
  TDouble
  TFloat
  TBool
  TByte
  TInt8
  TChar
  TString
  TUnit
  TPtr
  TStringBuilder
  TBytes
  TStrView
  TBytesView
  TWorld
  TScope
  TAtomicInt
  TArray(Ty)
  TFixedArray(Ty)
  TImmArray(Ty)
  TOption(Ty)
  TResult(Ty, Ty)
  TMap(Ty, Ty)
  TChannel(Ty)
  TMutex(Ty)
  TStruct(String, Array[Ty])
  TEnum(String, Array[Ty])
  TFn(Array[Ty], Ty)
  TTuple(Array[Ty])
  TDynTrait(String)
  TParam(String)
  TNever
  TError
}

///|
pub fn ty_to_string(t : Ty) -> String {
  match t {
    TInt => "Int"
    TInt64 => "Int64"
    TUInt => "UInt"
    TUInt64 => "UInt64"
    TDouble => "Double"
    TFloat => "Float"
    TBool => "Bool"
    TByte => "Byte"
    TInt8 => "Int8"
    TChar => "Char"
    TString => "String"
    TUnit => "Unit"
    TPtr => "Ptr"
    TStringBuilder => "StringBuilder"
    TBytes => "Bytes"
    TStrView => "StrView"
    TBytesView => "BytesView"
    TWorld => "World"
    TScope => "Scope"
    TAtomicInt => "AtomicInt"
    TArray(e) => "Array[" + ty_to_string(e) + "]"
    TFixedArray(e) => "FixedArray[" + ty_to_string(e) + "]"
    TImmArray(e) => "ImmArray[" + ty_to_string(e) + "]"
    TOption(e) => "Option[" + ty_to_string(e) + "]"
    TResult(ok, err) =>
      "Result[" + ty_to_string(ok) + ", " + ty_to_string(err) + "]"
    TMap(k, v) => "Map[" + ty_to_string(k) + ", " + ty_to_string(v) + "]"
    TChannel(e) => "Channel[" + ty_to_string(e) + "]"
    TMutex(e) => "Mutex[" + ty_to_string(e) + "]"
    TStruct(name, args) => format_named_ty(name, args)
    TEnum(name, args) => format_named_ty(name, args)
    TFn(params, ret) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < params.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_string(ty_to_string(params[i]))
        i = i + 1
      }
      sb.write_string(") -> ")
      sb.write_string(ty_to_string(ret))
      sb.to_string()
    }
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_string(ty_to_string(elems[i]))
        i = i + 1
      }
      sb.write_string(")")
      sb.to_string()
    }
    TDynTrait(n) => "dyn " + n
    TParam(n) => n
    TNever => "Never"
    TError => "<error>"
  }
}

///|
fn format_named_ty(name : String, args : Array[Ty]) -> String {
  if args.length() == 0 {
    return name
  }
  let sb = StringBuilder()
  sb.write_string(name)
  sb.write_string("[")
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(ty_to_string(args[i]))
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
pub struct StructInfo {
  decl : StructDecl
  field_names : Array[String]
  field_muts : Array[Bool]
  field_privs : Array[Bool]
  field_tys : Array[Ty]
}

///|
fn qualify_imported_struct_info(pkg_name : String, si : StructInfo) -> StructInfo {
  let qftys : Array[Ty] = []
  let mut j = 0
  while j < si.field_tys.length() {
    qftys.push(qualify_imported_ty(pkg_name, si.field_tys[j]))
    j = j + 1
  }
  StructInfo::{
    decl: si.decl,
    field_names: si.field_names,
    field_muts: si.field_muts,
    field_privs: si.field_privs,
    field_tys: qftys,
  }
}

///|
fn qualify_imported_trait_info(pkg_name : String, ti : TraitInfo) -> TraitInfo {
  let qms : Array[TraitMethodInfo] = []
  let mut mi = 0
  while mi < ti.methods.length() {
    let m = ti.methods[mi]
    let qptys : Array[Ty] = []
    let mut j = 0
    while j < m.param_tys.length() {
      qptys.push(qualify_imported_ty(pkg_name, m.param_tys[j]))
      j = j + 1
    }
    qms.push(TraitMethodInfo::{
      name: m.name,
      param_tys: qptys,
      ret_ty: qualify_imported_ty(pkg_name, m.ret_ty),
      span: m.span,
    })
    mi = mi + 1
  }
  TraitInfo::{ decl: ti.decl, methods: qms }
}

///|
pub fn tc_lookup_builtin_eq_impl(
  tc : TypeChecker,
  name : String,
) -> Option[ImplInfo] {
  match tc.impls.get("@builtin:Eq::" + name) {
    Some(ii) => return Some(ii)
    None => ()
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    if tc.pkg_name != "" && qp.prefix == tc.pkg_name {
      match tc.impls.get("@builtin:Eq::" + qp.name) {
        Some(ii) => return Some(ii)
        None => ()
      }
    }
    match lookup_imported_pkg_transitive(tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.impls.get("@builtin:Eq::" + qp.name) {
          Some(ii) => {
            let qms : Map[String, FnInfo] = Map([])
            let mut mi = 0
            while mi < ii.method_names.length() {
              let mn = ii.method_names[mi]
              match ii.methods.get(mn) {
                Some(mf) => qms.set(mn, qualify_fn_info(ipkg, mf))
                None => ()
              }
              mi = mi + 1
            }
            let q_bounds = qualify_impl_param_bounds(ipkg, ii.target_param_bounds)
            return Some(ImplInfo::{
              decl: ii.decl,
              pkg_name: ii.pkg_name,
              trait_name: "@builtin:Eq",
              target_type: ipkg.name + "::" + qp.name,
              target_param_names: ii.target_param_names,
              target_param_bounds: q_bounds,
              methods: qms,
              method_names: ii.method_names,
            })
          }
          None => ()
        }
      None => ()
    }
  }
  None
}

///|
fn qualify_impl_param_bounds(
  ipkg : ImportedPkg,
  bounds : Array[Array[String]],
) -> Array[Array[String]] {
  let out : Array[Array[String]] = []
  let mut i = 0
  while i < bounds.length() {
    let row = bounds[i]
    let qrow : Array[String] = []
    let mut j = 0
    while j < row.length() {
      let tr = row[j]
      if tr == "@builtin:Eq" {
        qrow.push("@builtin:Eq")
      } else if !has_qual_sep(tr) && ipkg.tc.traits.contains(tr) {
        qrow.push(ipkg.name + "::" + tr)
      } else {
        qrow.push(tr)
      }
      j = j + 1
    }
    out.push(qrow)
    i = i + 1
  }
  out
}

///|
fn tc_lookup_struct_info(tc : TypeChecker, sname : String) -> Option[StructInfo] {
  match tc.structs.get(sname) {
    Some(si) => Some(si)
    None => {
      let qp = split_qual_name(sname)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.structs.get(qp.name) {
              Some(si) => Some(qualify_imported_struct_info(ipkg.name, si))
              None => None
            }
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
fn qualify_imported_enum_info(pkg_name : String, ei : EnumInfo) -> EnumInfo {
  let qvars : Array[VariantInfo] = []
  let mut vi = 0
  while vi < ei.variants.length() {
    let v = ei.variants[vi]
    let qftys : Array[Ty] = []
    let mut fi = 0
    while fi < v.field_tys.length() {
      qftys.push(qualify_imported_ty(pkg_name, v.field_tys[fi]))
      fi = fi + 1
    }
    qvars.push(VariantInfo::{ name: v.name, field_tys: qftys })
    vi = vi + 1
  }
  EnumInfo::{ decl: ei.decl, variants: qvars }
}

///|
fn tc_lookup_enum_info(tc : TypeChecker, ename : String) -> Option[EnumInfo] {
  match tc.enums.get(ename) {
    Some(ei) => Some(ei)
    None => {
      let qp = split_qual_name(ename)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) => ipkg.tc.enums.get(qp.name)
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
fn tc_is_unboxed_unit_enum(tc : TypeChecker, t : Ty) -> Bool {
  match t {
    TEnum(ename, eargs) =>
      if eargs.length() != 0 {
        false
      } else {
        match tc_lookup_enum_info(tc, ename) {
          Some(ei) => {
            if ei.decl.type_params.length() != 0 || ei.decl.variants.length() == 0 {
              return false
            }
            let mut vi = 0
            while vi < ei.decl.variants.length() {
              if ei.decl.variants[vi].fields.length() > 0 {
                return false
              }
              vi = vi + 1
            }
            true
          }
          None => false
        }
      }
    _ => false
  }
}

///|
fn tc_is_hashable_scalar_ty(tc : TypeChecker, t : Ty) -> Bool {
  is_hashable_scalar_ty(t) ||
  (tc_is_unboxed_unit_enum(tc, t) && !v_has_custom_eq_in(tc, t, []))
}

///|
fn enum_info_has_variant(ei : EnumInfo, mem : String) -> Bool {
  let mut i = 0
  while i < ei.variants.length() {
    if ei.variants[i].name == mem {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn tc_enum_has_variant(tc : TypeChecker, ename : String, mem : String) -> Bool {
  match tc.enums.get(ename) {
    Some(ei) => enum_info_has_variant(ei, mem)
    None => false
  }
}

///|
fn check_field_assign_target(
  tc : TypeChecker,
  env : Env,
  obj : Expr,
  fname : String,
  lsp : Span,
) -> Ty {
  let oty = check_expr(tc, env, obj, None)
  match oty {
    TError => TError
    TStruct(sname, sargs) =>
      match tc_lookup_struct_info(tc, sname) {
        None => TError
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_names.length() {
            if sinfo.field_names[fi] == fname {
              tc.resolved_method_calls.set("fw:" + span_key(lsp), sname)
              if has_qual_sep(sname) &&
                !env.in_default_arg &&
                fi < sinfo.field_privs.length() &&
                sinfo.field_privs[fi] {
                tc_err(
                  tc,
                  lsp,
                  "E_PRIVATE_FIELD",
                  "cannot access private field `" +
                  fname +
                  "` of `" +
                  sname +
                  "` outside its defining package",
                  "public field",
                  "private field `" + fname + "`",
                  "use a public method on `" + sname + "` instead",
                )
              } else if !sinfo.field_muts[fi] {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "cannot assign to immutable field `" +
                  fname +
                  "` of struct `" +
                  sname +
                  "`",
                  "`mut` field",
                  "immutable field `" + fname + "`",
                  "declare the field as `mut " + fname + " : ...`",
                )
              }
              return subst_ty(sinfo.field_tys[fi], subst)
            }
            fi = fi + 1
          }
          tc_err(
            tc,
            lsp,
            "E_TYPE_MISMATCH",
            "struct `" + sname + "` has no field `" + fname + "`",
            "valid field of `" + sname + "`",
            fname,
            "check field name on `" + sname + "`",
          )
          TError
        }
      }
    _ => {
      tc_err(
        tc,
        lsp,
        "E_TYPE_MISMATCH",
        "cannot assign to field `" + fname + "` on `" + ty_to_string(oty) + "`",
        "struct",
        ty_to_string(oty),
        "assign fields only on struct values",
      )
      TError
    }
  }
}

///|
pub struct VariantInfo {
  name : String
  field_tys : Array[Ty]
}

///|
pub struct EnumInfo {
  decl : EnumDecl
  variants : Array[VariantInfo]
}

///|
pub struct FnInfo {
  decl : FnDecl
  param_tys : Array[Ty]
  ret_ty : Ty
  is_imported : Bool
}

///|
pub struct ExternFnInfo {
  decl : ExternFnDecl
  param_tys : Array[Ty]
  ret_ty : Ty
}

///|
pub struct TraitMethodInfo {
  name : String
  param_tys : Array[Ty]
  ret_ty : Ty
  span : Span
}

///|
pub struct TraitInfo {
  decl : TraitDecl
  methods : Array[TraitMethodInfo]
}

///|
pub struct ImplInfo {
  decl : ImplDecl
  pkg_name : String
  trait_name : String
  target_type : String
  target_param_names : Array[String]
  target_param_bounds : Array[Array[String]]
  methods : Map[String, FnInfo]
  method_names : Array[String]
}

///|
pub struct AnalyzeCapture {
  name : String
  is_mut : Bool
  ty : Ty
  decl_line : Int
}

///|
pub struct VarBinding {
  name : String
  ty : Ty
  is_mut : Bool
  /// Span of the `let` keyword that introduced the binding (line 0 for
  /// parameters, loop variables and pattern bindings).
  decl_span : Span
  /// 1-based declaration line for any binding (`let`, param, loop var, pattern).
  decl_line : Int
  ty_span : Span
  ty_end_col : Int
  init_span : Span
  init_end_col : Int
}

///|
pub struct Env {
  scopes : Array[Map[String, VarBinding]]
  moved : Map[String, Span]
  mut has_world : Bool
  mut ret_ty : Ty
  type_params : Array[String]
  type_bounds : Map[String, Array[String]]
  /// Decl key (`span_key`) of the generic fn whose body is being checked.
  mut fn_key : String
  mut fn_lparen_span : Span
  mut fn_has_params : Bool
  /// Scope index floor of the innermost enclosing closure (0 at function level).
  mut closure_scope_floor : Int
  /// Active enclosing loop depth inside the current function/closure (0 outside loops).
  mut in_loop_depth : Int
  /// Return type inferred from `return expr` statements inside an unannotated closure.
  mut inferred_ret : Option[Ty]
  /// True while checking a callee's default parameter expression (allows transitive/package-private symbols).
  mut in_default_arg : Bool
  /// True while checking any default parameter expression (declaration or call-site); forbids `return`.
  mut in_default_expr : Bool
  /// True while checking a `#no_io` / `#render_thread` function (or any closure inside it).
  mut in_no_io : Bool
  mut no_io_fn_name : String
  /// True while checking a `#verify` function (or any closure inside it).
  mut in_verify : Bool
  mut verify_fn_name : String
  /// Names of the enclosing function's `mut` parameters.
  mut_params : Map[String, Bool]
  /// Outer moved bindings shadowed by each lexical scope (1:1 with `scopes`).
  moved_shadow_stack : Array[Map[String, Span]]
}

///|
/// A generic fn value's instantiated type and the type params it binds.
pub struct TcFnValInst {
  ty : Ty
  bound : Array[String]
}

///|
/// A call `callee[tparam := concrete]` whose validity depends on whether the
/// callee compares `tparam` values with `==` / `!=`.
pub struct EqUse {
  callee_key : String
  callee_name : String
  tparam : String
  concrete : Ty
  caller_key : String
  caller_is_verify : Bool
  callee_is_verify_opaque : Bool
  span : Span
}

///|
pub struct IntoConv {
  /// 0 = builtin `.as_view()`, 1 = static `Target::fn(x)`, 2 = instance `x.method()`
  kind : Int
  qual : String
  name : String
  target_ty : Ty
}

///|
pub struct GenericCallSite {
  caller_key : String
  callee_key : String
  callee_name : String
  subst : Map[String, Ty]
  span : Span
}

///|
pub struct TraitObligation {
  target_ty : Ty
  trait_name : String
}

///|
pub struct ImportedPkg {
  name : String
  tc : TypeChecker
}

///|
pub fn imported_pkg_new(name : String, tc : TypeChecker) -> ImportedPkg {
  ImportedPkg::{ name: name, tc: tc }
}

///|
pub struct TypeChecker {
  pkg_name : String
  mut pkg_root : String
  mut pkg_cwd : String
  multi_pkg : Bool
  structs : Map[String, StructInfo]
  struct_names : Array[String]
  enums : Map[String, EnumInfo]
  enum_names : Array[String]
  variant_to_enum : Map[String, String]
  fns : Map[String, FnInfo]
  extern_fns : Map[String, ExternFnInfo]
  extern_fn_names : Array[String]
  methods : Map[String, FnInfo]
  method_names : Array[String]
  traits : Map[String, TraitInfo]
  trait_names : Array[String]
  impls : Map[String, ImplInfo]
  impl_keys : Array[String]
  consts : Map[String, Ty]
  const_pub : Map[String, Bool]
  scalar_const_exprs : Map[String, Expr]
  const_init_order : Array[String]
  import_aliases : Map[String, String]
  file_import_aliases : Map[String, Map[String, String]]
  dep_map : Map[String, String]
  canon_display_keys : Array[String]
  canon_display_vals : Array[String]
  exported_c_syms : Map[String, String]
  exported_c_sym_names : Array[String]
  imported_pkgs : Map[String, ImportedPkg]
  imported_pkg_names : Array[String]
  all_imported_pkgs : Map[String, ImportedPkg]
  all_imported_pkg_names : Array[String]
  diagnostics : Array[Diagnostic]
  /// Generic fn decl key -> type params its body compares with `==` / `!=`.
  eq_tparams : Map[String, Array[String]]
  eq_keys : Array[String]
  /// Generic fn decl key -> type params compared with `==` / `!=` inside transparent `#verify` bodies (stops at `#verify_opaque`).
  verify_eq_tparams : Map[String, Array[String]]
  verify_eq_keys : Array[String]
  /// Generic fn decl key -> operator-constrained type params (`"num:" + tp`, `"add:" + tp`, `"int:" + tp`, `"ord:" + tp`).
  op_tparams : Map[String, Array[String]]
  op_keys : Array[String]
  /// Generic fn decl key -> full `Ty` Map keys containing `TParam`s to validate on instantiation.
  map_key_obligations : Map[String, Array[Ty]]
  map_key_ob_keys : Array[String]
  /// Generic fn decl key -> full `(target_ty, trait_name)` obligations from generic `impl Eq` bounds.
  eq_trait_obligations : Map[String, Array[TraitObligation]]
  eq_trait_ob_keys : Array[String]
  /// Generic call sites with full `Map[String, Ty]` substitution for obligation propagation.
  generic_call_sites : Array[GenericCallSite]
  mut cur_fn_key : String
  mut in_pass3 : Bool
  mut expansive_ready : Bool
  expansive_defs : Map[String, Bool]
  expansive_params : Map[String, Bool]
  eq_uses : Array[EqUse]
  /// `span_key` of a method call on a `TParam` with trait bounds -> canonical bound trait name.
  resolved_trait_methods : Map[String, String]
  /// Dedup keys of machine-applicable edits already attached.
  edit_keys : Map[String, Bool]
  /// `span_key` of an unannotated `let x = []` / `Map([])` -> the collection
  /// type inferred for it (read by codegen, which shares this checker).
  let_infer : Map[String, Ty]
  /// `span_key` of a shift `EBinary("<<" | ">>", ...)` -> inferred RHS shift-count type.
  shift_rhs_infer : Map[String, Ty]
  /// `span_key` of a closure expression -> its inferred `TFn(params, ret)` type.
  closure_infer : Map[String, Ty]
  /// `span_key` of a leading-dot `.Variant` expression -> canonical enum name.
  dot_variant_resolve : Map[String, String]
  /// `span_key`s of such `let`s whose element type is still unknown.
  infer_pending : Map[String, Bool]
  /// Argument types of the `push` / `set` just checked on a collection with an
  /// unknown element type (consumed by the enclosing method call).
  infer_hit : Array[Ty]
  /// ResolvedInfo side tables, recorded for every expression / call inside a
  /// `#verify` function (consumed by the Lean extractor):
  /// `span_key(expr_span(e))` -> the expression's final type.
  expr_tys : Map[String, Ty]
  /// `span_key(call span)` -> canonical callee (`pkg::fn`, `pkg::Type::method`,
  /// `Trait::Type::method`, `builtin::...`, `closure::name`).
  call_targets : Map[String, String]
  /// `span_key(call span)` -> instantiated type arguments of a generic callee.
  call_type_args : Map[String, Array[Ty]]
  /// `span_key(call span)` -> for each resolved parameter slot, the index of
  /// the written argument that fills it (-1: default value / implicit `None`).
  call_arg_order : Map[String, Array[Int]]
  /// `span_key(method-call span)` of every `recv.m(...)` whose method takes
  /// `mut self` (codegen passes `recv` as an in-out place).
  mut_recv_calls : Map[String, Bool]
  /// True only during `pionc query analyze`: records `call_targets` for every
  /// function/method/closure and captures for every `EClosure`.
  record_analyze : Bool
  /// `span_key(closure span)` -> captured outer bindings in first-seen order.
  analyze_closure_captures : Map[String, Array[AnalyzeCapture]]
  /// `span_key(call span) + "#" + raw_arg_index` -> `#into` conversion for that argument.
  call_into_convs : Map[String, IntoConv]
  /// `span_key(ETry span)` -> `#into` error conversion for `?`.
  try_into_convs : Map[String, IntoConv]
  /// `span_key(EMethodCall span)` -> exact `"RecvType::method"` when receiver is concrete.
  resolved_method_calls : Map[String, String]
  /// `span_key(ECall/EMethodCall span)` -> true when the call statically diverges (`-> Never` or uninhabited unconstrained `TParam`).
  never_calls : Map[String, Bool]
  /// True while checking a callee's expanded default argument at a call site.
  mut in_default_arg_expansion : Bool
  /// True while checking an imported callee's expanded default argument (canonical pkg names must not be hijacked by caller aliases).
  mut in_imported_default_arg : Bool
  /// Qualified names (`pkg::Type`) of private imported types lazily registered for expanded default args;
  /// direct references outside default-arg expansion must still emit `E_PRIVATE_SYMBOL`.
  priv_imported_types : Map[String, Bool]
}

///|
pub struct CheckResult {
  diagnostics : Array[Diagnostic]
}

///|
fn str_arr_contains(arr : Array[String], target : String) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == target {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn env_new(ret_ty : Ty, type_params : Array[String]) -> Env {
  let scopes : Array[Map[String, VarBinding]] = []
  scopes.push(Map([]))
  Env::{
    scopes: scopes,
    moved: Map([]),
    has_world: false,
    ret_ty: ret_ty,
    type_params: type_params,
    type_bounds: Map([]),
    fn_key: "",
    fn_lparen_span: span_empty(),
    fn_has_params: false,
    closure_scope_floor: 0,
    in_loop_depth: 0,
    inferred_ret: None,
    in_default_arg: false,
    in_default_expr: false,
    in_no_io: false,
    no_io_fn_name: "",
    in_verify: false,
    verify_fn_name: "",
    mut_params: Map([]),
    moved_shadow_stack: [Map([])],
  }
}

///|
fn env_for_default_arg(env : Env, is_expanded : Bool) -> Env {
  let def_env = env_new(TError, env.type_params)
  let tb_keys = env.type_bounds.keys()
  let mut i = 0
  while i < tb_keys.length() {
    let k = tb_keys[i]
    match env.type_bounds.get(k) {
      Some(v) => def_env.type_bounds.set(k, v)
      None => ()
    }
    i = i + 1
  }
  def_env.in_default_arg = is_expanded
  def_env.in_default_expr = true
  def_env.in_no_io = env.in_no_io
  def_env.no_io_fn_name = env.no_io_fn_name
  def_env.in_verify = env.in_verify
  def_env.verify_fn_name = env.verify_fn_name
  def_env
}

///|
fn env_for_default_arg_callee(
  tc : TypeChecker,
  env : Env,
  type_params : Array[String],
  type_bounds : Array[TypeBound],
  is_expanded : Bool,
  is_imported : Bool,
) -> Env {
  let def_env = env_new(TError, type_params)
  let mut bi = 0
  while bi < type_bounds.length() {
    let tb = type_bounds[bi]
    let ctrs : Array[String] = []
    let mut ti = 0
    while ti < tb.traits.length() {
      let raw_tr = tb.traits[ti]
      let tr_n = if starts_with_str(raw_tr, "@canon:") || !is_imported {
        canon_trait_name(tc, raw_tr)
      } else {
        raw_tr
      }
      ctrs.push(tr_n)
      ti = ti + 1
    }
    def_env.type_bounds.set(tb.param, ctrs)
    bi = bi + 1
  }
  def_env.in_default_arg = is_expanded
  def_env.in_default_expr = true
  def_env.in_no_io = env.in_no_io
  def_env.no_io_fn_name = env.no_io_fn_name
  def_env.in_verify = env.in_verify
  def_env.verify_fn_name = env.verify_fn_name
  def_env
}

///|
fn env_push(env : Env) -> Unit {
  env.scopes.push(Map([]))
  env.moved_shadow_stack.push(Map([]))
}

///|
fn env_pop(env : Env) -> Unit {
  if env.scopes.length() > 1 {
    match env.scopes.pop() {
      Some(popped_scope) => {
        let ks = popped_scope.keys()
        let mut i = 0
        while i < ks.length() {
          env.moved.remove(ks[i])
          i = i + 1
        }
      }
      None => ()
    }
    match env.moved_shadow_stack.pop() {
      Some(popped_shadows) => {
        let sks = popped_shadows.keys()
        let mut i = 0
        while i < sks.length() {
          let k = sks[i]
          match popped_shadows.get(k) {
            Some(sp) => env.moved.set(k, sp)
            None => ()
          }
          i = i + 1
        }
      }
      None => ()
    }
  }
}

///|
fn env_record_define_moved_shadow(env : Env, name : String, already_in_top : Bool) -> Unit {
  if env.moved.contains(name) {
    if !already_in_top && env.moved_shadow_stack.length() > 0 {
      let top_sh = env.moved_shadow_stack[env.moved_shadow_stack.length() - 1]
      if !top_sh.contains(name) {
        match env.moved.get(name) {
          Some(sp) => top_sh.set(name, sp)
          None => ()
        }
      }
    }
    env.moved.remove(name)
  }
}

///|
fn env_define(env : Env, name : String, ty : Ty, is_mut : Bool) -> Unit {
  env_define_line(env, name, ty, is_mut, 0)
}

///|
fn env_define_line(
  env : Env,
  name : String,
  ty : Ty,
  is_mut : Bool,
  decl_line : Int,
) -> Unit {
  let top = env.scopes[env.scopes.length() - 1]
  let already_in_top = top.contains(name)
  top.set(name, VarBinding::{
    name: name,
    ty: ty,
    is_mut: is_mut,
    decl_span: span_empty(),
    decl_line: decl_line,
    ty_span: span_empty(),
    ty_end_col: -1,
    init_span: span_empty(),
    init_end_col: -1,
  })
  match ty {
    TWorld => env.has_world = true
    _ => ()
  }
  env_record_define_moved_shadow(env, name, already_in_top)
}

///|
fn env_define_at(
  env : Env,
  name : String,
  ty : Ty,
  is_mut : Bool,
  decl_span : Span,
) -> Unit {
  env_define_let(
    env,
    name,
    ty,
    is_mut,
    decl_span,
    span_empty(),
    -1,
    span_empty(),
    -1,
  )
}

///|
fn env_define_let(
  env : Env,
  name : String,
  ty : Ty,
  is_mut : Bool,
  decl_span : Span,
  ty_span : Span,
  ty_end_col : Int,
  init_span : Span,
  init_end_col : Int,
) -> Unit {
  let top = env.scopes[env.scopes.length() - 1]
  let already_in_top = top.contains(name)
  top.set(name, VarBinding::{
    name: name,
    ty: ty,
    is_mut: is_mut,
    decl_span: decl_span,
    decl_line: decl_span.line,
    ty_span: ty_span,
    ty_end_col: ty_end_col,
    init_span: init_span,
    init_end_col: init_end_col,
  })
  match ty {
    TWorld => env.has_world = true
    _ => ()
  }
  env_record_define_moved_shadow(env, name, already_in_top)
}

///|
///|
fn tc_data_ptr_arg_is_owned_place(
  tc : TypeChecker,
  env : Env,
  e : Expr,
  allow_str_lit : Bool,
) -> Bool {
  match e {
    EString(_, _) => allow_str_lit
    EIdent(vname, _) =>
      match env_lookup(env, vname) {
        Some(_) => true
        None => tc.consts.contains(vname)
      }
    EPath(qual, mem, _) =>
      match resolve_pkg_for_lookup(tc, qual, env.in_default_arg) {
        Some(ipkg) => ipkg.tc.consts.contains(mem)
        None => false
      }
    EField(base, _, _) => tc_data_ptr_arg_is_owned_place(tc, env, base, false)
    _ => false
  }
}

///|
fn env_lookup(env : Env, name : String) -> Option[VarBinding] {
  let mut i = env.scopes.length() - 1
  while i >= 0 {
    match env.scopes[i].get(name) {
      Some(b) => return Some(b)
      None => ()
    }
    i = i - 1
  }
  None
}

///|
fn shift_rhs_ty_hint(tc : TypeChecker, env : Env, e : Expr) -> Option[Ty] {
  match e {
    EInt(_, _) => None
    EInt64(_, _) => Some(TInt64)
    EUInt(_, _) => Some(TUInt)
    EUInt64(_, _) => Some(TUInt64)
    EByte(_, _) => Some(TByte)
    EIdent(v, _) =>
      match env_lookup(env, v) {
        Some(b) => Some(b.ty)
        None => tc.consts.get(v)
      }
    EUnary(_, x, _) => shift_rhs_ty_hint(tc, env, x)
    EAs(_, ty_e, _) => Some(resolve_type_expr(tc, ty_e, env.type_params))
    ECall(EIdent(fnm, _), _, _) =>
      match env_lookup(env, fnm) {
        Some(b) =>
          match b.ty {
            TFn(_, rty) => Some(rty)
            _ => None
          }
        None =>
          match tc.fns.get(fnm) {
            Some(fi) =>
              if fi.decl.type_params.length() == 0 {
                Some(fi.ret_ty)
              } else {
                None
              }
            None => None
          }
      }
    EBinary(bop, l, r, _) =>
      if bop == "<<" || bop == ">>" {
        shift_rhs_ty_hint(tc, env, l)
      } else {
        match shift_rhs_ty_hint(tc, env, l) {
          Some(t) => Some(t)
          None => shift_rhs_ty_hint(tc, env, r)
        }
      }
    _ => None
  }
}

///|
fn env_lookup_depth(env : Env, name : String) -> Int {
  let mut i = env.scopes.length() - 1
  while i >= 0 {
    if env.scopes[i].contains(name) {
      return i
    }
    i = i - 1
  }
  -1
}

///|
pub struct QualParts {
  prefix : String
  name : String
}

///|
pub fn split_qual_name(s : String) -> QualParts {
  let len = s.length()
  let mut i = 0
  while i + 1 < len {
    if str_code_at(s, i) == 58 && str_code_at(s, i + 1) == 58 {
      return QualParts::{
        prefix: slice_str(s, 0, i),
        name: slice_str(s, i + 2, len),
      }
    }
    i = i + 1
  }
  QualParts::{ prefix: "", name: s }
}

///|
fn has_qual_sep(s : String) -> Bool {
  split_qual_name(s).prefix.length() > 0
}

///|
pub fn qualify_imported_ty(pkg_name : String, t : Ty) -> Ty {
  match t {
    TArray(e) => TArray(qualify_imported_ty(pkg_name, e))
    TFixedArray(e) => TFixedArray(qualify_imported_ty(pkg_name, e))
    TImmArray(e) => TImmArray(qualify_imported_ty(pkg_name, e))
    TOption(e) => TOption(qualify_imported_ty(pkg_name, e))
    TResult(ok, err) =>
      TResult(
        qualify_imported_ty(pkg_name, ok),
        qualify_imported_ty(pkg_name, err),
      )
    TMap(k, v) =>
      TMap(qualify_imported_ty(pkg_name, k), qualify_imported_ty(pkg_name, v))
    TChannel(e) => TChannel(qualify_imported_ty(pkg_name, e))
    TMutex(e) => TMutex(qualify_imported_ty(pkg_name, e))
    TStruct(name, args) => {
      let qname = if has_qual_sep(name) {
        name
      } else {
        pkg_name + "::" + name
      }
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(qualify_imported_ty(pkg_name, args[i]))
        i = i + 1
      }
      TStruct(qname, out)
    }
    TEnum(name, args) => {
      let qname = if has_qual_sep(name) {
        name
      } else {
        pkg_name + "::" + name
      }
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(qualify_imported_ty(pkg_name, args[i]))
        i = i + 1
      }
      TEnum(qname, out)
    }
    TFn(params, ret) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < params.length() {
        out.push(qualify_imported_ty(pkg_name, params[i]))
        i = i + 1
      }
      TFn(out, qualify_imported_ty(pkg_name, ret))
    }
    TTuple(elems) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        out.push(qualify_imported_ty(pkg_name, elems[i]))
        i = i + 1
      }
      TTuple(out)
    }
    TDynTrait(name) => {
      let qname = if has_qual_sep(name) {
        name
      } else {
        pkg_name + "::" + name
      }
      TDynTrait(qname)
    }
    _ => t
  }
}

///|
fn str_arr_clone(arr : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < arr.length() {
    out.push(arr[i])
    i = i + 1
  }
  out
}

///|
fn qualify_pat_bindings(pat : Pattern, bound : Array[String]) -> Unit {
  match pat {
    PIdent(n, _) => bound.push(n)
    PVariant(_, _, subs, _, _) | PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        qualify_pat_bindings(subs[i], bound)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qualify_struct_lit_name(ipkg : ImportedPkg, sname : String) -> String {
  if sname == "" || starts_with_str(sname, "@canon:") {
    return sname
  }
  if has_qual_sep(sname) {
    let qp = split_qual_name(sname)
    match resolve_alias_pkg(ipkg.tc, qp.prefix) {
      Some(dep) => "@canon:" + dep.name + "::" + qp.name
      None => sname
    }
  } else if ipkg.tc.structs.contains(sname) {
    "@canon:" + ipkg.name + "::" + sname
  } else {
    sname
  }
}

///|
fn qualify_imported_path(
  ipkg : ImportedPkg,
  qual : String,
  mem : String,
  sp : Span,
  is_call : Bool,
) -> Expr {
  if starts_with_str(qual, "@canon:") {
    return EPath(qual, mem, sp)
  }
  if is_call {
    if (qual == "Double" && mem == "from_bits") ||
      (
        (qual == "Float" || qual == "Float32") &&
        (mem == "from_double" || mem == "from_int" || mem == "from_bits")
      ) ||
      (qual == "StringBuilder" && (mem == "new" || mem == "with_capacity")) ||
      (qual == "Bytes" && mem == "new") ||
      (qual == "Map" && (mem == "new" || mem == "with_capacity")) ||
      (
        qual == "Array" &&
        (mem == "new" || mem == "with_capacity" || mem == "make")
      ) ||
      (
        qual == "FixedArray" &&
        (mem == "make" || mem == "makei" || mem == "from_array")
      ) ||
      (
        qual == "ImmArray" &&
        (mem == "new" || mem == "make" || mem == "from_array")
      ) ||
      (
        (qual == "Channel" || qual == "Mutex" || qual == "AtomicInt") &&
        mem == "new"
      ) {
      return EPath(qual, mem, sp)
    }
    if qual == "Option" || qual == "Result" {
      return EPath(qual, mem, sp)
    }
    if ipkg.tc.enums.contains(qual) &&
      (
        tc_enum_has_variant(ipkg.tc, qual, mem) ||
        !ipkg.tc.methods.contains(qual + "::" + mem)
      ) {
      return EPath("@canon:" + ipkg.name + "::" + qual, mem, sp)
    }
  } else {
    if qual == "Option" && (mem == "None" || mem != "Some") {
      return EPath(qual, mem, sp)
    }
    if qual == "Result" && mem != "Ok" && mem != "Err" {
      return EPath(qual, mem, sp)
    }
    if ipkg.tc.enums.contains(qual) &&
      (
        tc_enum_has_variant(ipkg.tc, qual, mem) ||
        !ipkg.tc.methods.contains(qual + "::" + mem)
      ) {
      return EPath("@canon:" + ipkg.name + "::" + qual, mem, sp)
    }
  }
  if has_qual_sep(qual) {
    let qp = split_qual_name(qual)
    match resolve_alias_pkg(ipkg.tc, qp.prefix) {
      Some(dep) => {
        let dep_has_enum_mem = match dep.tc.enums.get(qp.name) {
          Some(ei) =>
            enum_info_has_variant(ei, mem) ||
            !dep.tc.methods.contains(qp.name + "::" + mem)
          None => false
        }
        if dep_has_enum_mem || dep.tc.methods.contains(qp.name + "::" + mem) {
          return EPath("@canon:" + dep.name + "::" + qp.name, mem, sp)
        }
      }
      None => ()
    }
  } else {
    match resolve_alias_pkg(ipkg.tc, qual) {
      Some(dep) => {
        let dep_has_mem = if is_call {
          dep.tc.fns.contains(mem) ||
          dep.tc.extern_fns.contains(mem) ||
          dep.tc.variant_to_enum.contains(mem)
        } else {
          dep.tc.consts.contains(mem) ||
          dep.tc.fns.contains(mem) ||
          dep.tc.variant_to_enum.contains(mem)
        }
        if dep_has_mem {
          return EPath("@canon:" + dep.name, mem, sp)
        }
      }
      None => ()
    }
  }
  if ipkg.tc.methods.contains(qual + "::" + mem) ||
    ipkg.tc.enums.contains(qual) ||
    ipkg.tc.structs.contains(qual) {
    return EPath("@canon:" + ipkg.name + "::" + qual, mem, sp)
  }
  EPath(qual, mem, sp)
}

///|
/// Rewrites package-local references in an imported default-argument expression
/// using the reserved `@canon:<pkg>` prefix so they cannot be hijacked by
/// caller/defining-package aliases. All `EPath` consumers must route package
/// lookup through `resolve_alias_pkg` / `resolve_pkg_for_lookup` /
/// `qbe_resolve_pkg_in_scope` so `@canon:` paths resolve directly.
fn qualify_imported_type_expr(
  ipkg : ImportedPkg,
  te : TypeExpr,
  tparams : Array[String],
) -> TypeExpr {
  match te {
    TyMissing(_) => te
    TyTuple(elems, sp) => {
      let out : Array[TypeExpr] = []
      let mut i = 0
      while i < elems.length() {
        out.push(qualify_imported_type_expr(ipkg, elems[i], tparams))
        i = i + 1
      }
      TyTuple(out, sp)
    }
    TyFn(params, ret, sp) => {
      let out : Array[TypeExpr] = []
      let mut i = 0
      while i < params.length() {
        out.push(qualify_imported_type_expr(ipkg, params[i], tparams))
        i = i + 1
      }
      TyFn(out, qualify_imported_type_expr(ipkg, ret, tparams), sp)
    }
    TyDynTrait(tname, sp) => {
      if starts_with_str(tname, "@canon:") {
        return te
      }
      let qp = split_qual_name(tname)
      if qp.prefix.length() > 0 {
        match resolve_alias_pkg(ipkg.tc, qp.prefix) {
          Some(dep) => TyDynTrait("@canon:" + dep.name + "::" + qp.name, sp)
          None => te
        }
      } else if ipkg.tc.traits.contains(tname) {
        TyDynTrait("@canon:" + ipkg.name + "::" + tname, sp)
      } else {
        te
      }
    }
    TyName(name, args, sp) => {
      let qargs : Array[TypeExpr] = []
      let mut i = 0
      while i < args.length() {
        qargs.push(qualify_imported_type_expr(ipkg, args[i], tparams))
        i = i + 1
      }
      if str_arr_contains(tparams, name) || starts_with_str(name, "@canon:") {
        return TyName(name, qargs, sp)
      }
      let qp = split_qual_name(name)
      if qp.prefix.length() > 0 {
        match resolve_alias_pkg(ipkg.tc, qp.prefix) {
          Some(dep) => TyName("@canon:" + dep.name + "::" + qp.name, qargs, sp)
          None => TyName(name, qargs, sp)
        }
      } else if ipkg.tc.structs.contains(name) ||
        ipkg.tc.enums.contains(name) ||
        ipkg.tc.traits.contains(name) {
        TyName("@canon:" + ipkg.name + "::" + name, qargs, sp)
      } else {
        TyName(name, qargs, sp)
      }
    }
  }
}

///|
fn qualify_imported_type_expr_opt(
  ipkg : ImportedPkg,
  te_opt : Option[TypeExpr],
  tparams : Array[String],
) -> Option[TypeExpr] {
  match te_opt {
    Some(te) => Some(qualify_imported_type_expr(ipkg, te, tparams))
    None => None
  }
}

///|
fn qualify_imported_pat(ipkg : ImportedPkg, pat : Pattern) -> Pattern {
  match pat {
    PVariant(enum_name, vname, subs, explicit_ctor, sp) => {
      let qsubs : Array[Pattern] = []
      let mut i = 0
      while i < subs.length() {
        qsubs.push(qualify_imported_pat(ipkg, subs[i]))
        i = i + 1
      }
      if !explicit_ctor && subs.length() == 0 {
        match ipkg.tc.resolved_method_calls.get("pat_const:" + span_key(sp)) {
          Some(ckey) =>
            if has_qual_sep(ckey) {
              let qp = split_qual_name(ckey)
              return PVariant("@canon:" + qp.prefix, qp.name, qsubs, false, sp)
            } else {
              return PVariant("@canon:" + ipkg.name, ckey, qsubs, false, sp)
            }
          None => ()
        }
      }
      let qenum = if enum_name != "" {
        if starts_with_str(enum_name, "@canon:") {
          enum_name
        } else if has_qual_sep(enum_name) {
          let qp = split_qual_name(enum_name)
          match resolve_alias_pkg(ipkg.tc, qp.prefix) {
            Some(dep) => dep.name + "::" + qp.name
            None => enum_name
          }
        } else if ipkg.tc.enums.contains(enum_name) {
          ipkg.name + "::" + enum_name
        } else {
          enum_name
        }
      } else {
        ""
      }
      PVariant(qenum, vname, qsubs, explicit_ctor, sp)
    }
    PTuple(subs, sp) => {
      let qsubs : Array[Pattern] = []
      let mut i = 0
      while i < subs.length() {
        qsubs.push(qualify_imported_pat(ipkg, subs[i]))
        i = i + 1
      }
      PTuple(qsubs, sp)
    }
    _ => pat
  }
}

///|
/// Single-pass O(n) qualification for condition contexts (`if` / `while` / `guard`),
/// where `EIs` pattern bindings propagate left-to-right across `&&` and into the guarded body.
fn qualify_imported_cond(
  ipkg : ImportedPkg,
  e : Expr,
  bound : Array[String],
  tparams : Array[String],
) -> Expr {
  match e {
    EBinary("&&", l, r, sp) => {
      let ql = qualify_imported_cond(ipkg, l, bound, tparams)
      let qr = qualify_imported_cond(ipkg, r, bound, tparams)
      EBinary("&&", ql, qr, sp)
    }
    EIs(scrut, pat, sp) => {
      let qs = qualify_imported_expr(ipkg, scrut, bound, tparams)
      let qp = qualify_imported_pat(ipkg, pat)
      qualify_pat_bindings(pat, bound)
      EIs(qs, qp, sp)
    }
    _ => qualify_imported_expr(ipkg, e, bound, tparams)
  }
}

///|
fn qualify_imported_expr(
  ipkg : ImportedPkg,
  e : Expr,
  bound : Array[String],
  tparams : Array[String],
) -> Expr {
  match e {
    EIdent(name, sp) =>
      if !str_arr_contains(bound, name) &&
        name != "Some" &&
        name != "None" &&
        name != "Ok" &&
        name != "Err" &&
        (
          ipkg.tc.consts.contains(name) ||
          ipkg.tc.fns.contains(name) ||
          ipkg.tc.extern_fns.contains(name) ||
          ipkg.tc.variant_to_enum.contains(name)
        ) {
        EPath("@canon:" + ipkg.name, name, sp)
      } else {
        e
      }
    EPath(qual, mem, sp) => qualify_imported_path(ipkg, qual, mem, sp, false)
    EStructLit(sname, spread_opt, fields, sp) => {
      let qname = qualify_struct_lit_name(ipkg, sname)
      let qspread = match spread_opt {
        Some(se) => Some(qualify_imported_expr(ipkg, se, bound, tparams))
        None => None
      }
      let qfields : Array[FieldInit] = []
      let mut i = 0
      while i < fields.length() {
        let f = fields[i]
        qfields.push(FieldInit::{
          name: f.name,
          value: qualify_imported_expr(ipkg, f.value, bound, tparams),
          span: f.span,
        })
        i = i + 1
      }
      EStructLit(qname, qspread, qfields, sp)
    }
    EUnary(op, inner, sp) => EUnary(op, qualify_imported_expr(ipkg, inner, bound, tparams), sp)
    EBinary(op, l, r, sp) =>
      if op == "&&" {
        let rb = str_arr_clone(bound)
        let ql = qualify_imported_cond(ipkg, l, rb, tparams)
        let qr = qualify_imported_expr(ipkg, r, rb, tparams)
        EBinary(op, ql, qr, sp)
      } else {
        EBinary(
          op,
          qualify_imported_expr(ipkg, l, bound, tparams),
          qualify_imported_expr(ipkg, r, bound, tparams),
          sp,
        )
      }
    ECall(callee, args, sp) => {
      let qc = match callee {
        EPath(qual, mem, psp) => qualify_imported_path(ipkg, qual, mem, psp, true)
        EIdent(cname, csp) => {
          let is_pkg_const_fn = match ipkg.tc.consts.get(cname) {
            Some(TFn(_, _)) => true
            _ => false
          }
          let has_pkg_callable = ipkg.tc.fns.contains(cname) ||
            ipkg.tc.extern_fns.contains(cname) ||
            is_pkg_const_fn
          if has_pkg_callable &&
            (ipkg.tc.resolved_method_calls.contains("call_pkg:" + span_key(sp)) ||
              !str_arr_contains(bound, cname)) {
            EPath("@canon:" + ipkg.name, cname, csp)
          } else if ipkg.tc.resolved_method_calls.contains("ctor:" + span_key(sp)) &&
            cname != "Some" &&
            cname != "Ok" &&
            cname != "Err" &&
            ipkg.tc.variant_to_enum.contains(cname) {
            EPath("@canon:" + ipkg.name, cname, csp)
          } else {
            qualify_imported_expr(ipkg, callee, bound, tparams)
          }
        }
        _ => qualify_imported_expr(ipkg, callee, bound, tparams)
      }
      let qargs : Array[Expr] = []
      let mut i = 0
      while i < args.length() {
        qargs.push(qualify_imported_expr(ipkg, args[i], bound, tparams))
        i = i + 1
      }
      ECall(qc, qargs, sp)
    }
    EField(obj, fname, sp) => EField(qualify_imported_expr(ipkg, obj, bound, tparams), fname, sp)
    EMethodCall(obj, mname, args, sp) => {
      let qo = qualify_imported_expr(ipkg, obj, bound, tparams)
      let qargs : Array[Expr] = []
      let mut i = 0
      while i < args.length() {
        qargs.push(qualify_imported_expr(ipkg, args[i], bound, tparams))
        i = i + 1
      }
      EMethodCall(qo, mname, qargs, sp)
    }
    EIndex(obj, idx, sp) =>
      EIndex(
        qualify_imported_expr(ipkg, obj, bound, tparams),
        qualify_imported_expr(ipkg, idx, bound, tparams),
        sp,
      )
    EArrayLit(elems, sp) => {
      let qelems : Array[Expr] = []
      let mut i = 0
      while i < elems.length() {
        qelems.push(qualify_imported_expr(ipkg, elems[i], bound, tparams))
        i = i + 1
      }
      EArrayLit(qelems, sp)
    }
    ETuple(elems, sp) => {
      let qelems : Array[Expr] = []
      let mut i = 0
      while i < elems.length() {
        qelems.push(qualify_imported_expr(ipkg, elems[i], bound, tparams))
        i = i + 1
      }
      ETuple(qelems, sp)
    }
    EInterp(elems, sp) => {
      let qelems : Array[Expr] = []
      let mut i = 0
      while i < elems.length() {
        qelems.push(qualify_imported_expr(ipkg, elems[i], bound, tparams))
        i = i + 1
      }
      EInterp(qelems, sp)
    }
    EDotVariant(vname, args, sp) => {
      let qargs : Array[Expr] = []
      let mut i = 0
      while i < args.length() {
        qargs.push(qualify_imported_expr(ipkg, args[i], bound, tparams))
        i = i + 1
      }
      EDotVariant(vname, qargs, sp)
    }
    EBlock(stmts, sp) => EBlock(qualify_imported_stmts(ipkg, stmts, bound, tparams), sp)
    EIf(cond, then_s, else_opt, sp) => {
      let tb = str_arr_clone(bound)
      let qc = qualify_imported_cond(ipkg, cond, tb, tparams)
      let qt = qualify_imported_stmts(ipkg, then_s, tb, tparams)
      let qe = match else_opt {
        Some(ee) => Some(qualify_imported_expr(ipkg, ee, bound, tparams))
        None => None
      }
      EIf(qc, qt, qe, sp)
    }
    EMatch(scrut, arms, sp) => {
      let qs = qualify_imported_expr(ipkg, scrut, bound, tparams)
      let qarms : Array[MatchArm] = []
      let mut i = 0
      while i < arms.length() {
        let a = arms[i]
        let ab = str_arr_clone(bound)
        qualify_pat_bindings(a.pat, ab)
        let qg = match a.guard_expr {
          Some(ge) => Some(qualify_imported_cond(ipkg, ge, ab, tparams))
          None => None
        }
        qarms.push(MatchArm::{
          pat: qualify_imported_pat(ipkg, a.pat),
          guard_expr: qg,
          body: qualify_imported_expr(ipkg, a.body, ab, tparams),
          span: a.span,
        })
        i = i + 1
      }
      EMatch(qs, qarms, sp)
    }
    EIs(scrut, pat, sp) =>
      EIs(qualify_imported_expr(ipkg, scrut, bound, tparams), qualify_imported_pat(ipkg, pat), sp)
    EClosure(ps, rty, body, sp) => {
      let cb = str_arr_clone(bound)
      let qps : Array[Param] = []
      let mut i = 0
      while i < ps.length() {
        let p = ps[i]
        cb.push(p.name)
        qps.push(Param::{
          name: p.name,
          is_mut: p.is_mut,
          is_into: p.is_into,
          ty: qualify_imported_type_expr(ipkg, p.ty, tparams),
          label_kind: p.label_kind,
          default_expr: p.default_expr,
          span: p.span,
        })
        i = i + 1
      }
      let qrty = qualify_imported_type_expr(ipkg, rty, tparams)
      EClosure(qps, qrty, qualify_imported_stmts(ipkg, body, cb, tparams), sp)
    }
    EScope(w, f, sp) =>
      EScope(
        qualify_imported_expr(ipkg, w, bound, tparams),
        qualify_imported_expr(ipkg, f, bound, tparams),
        sp,
      )
    ESpawn(s, f, sp) =>
      ESpawn(
        qualify_imported_expr(ipkg, s, bound, tparams),
        qualify_imported_expr(ipkg, f, bound, tparams),
        sp,
      )
    EMove(inner, sp) => EMove(qualify_imported_expr(ipkg, inner, bound, tparams), sp)
    EAs(inner, ty, sp) =>
      EAs(
        qualify_imported_expr(ipkg, inner, bound, tparams),
        qualify_imported_type_expr(ipkg, ty, tparams),
        sp,
      )
    ETry(inner, sp) => ETry(qualify_imported_expr(ipkg, inner, bound, tparams), sp)
    ENamedArg(n, pun, inner, sp) =>
      ENamedArg(n, pun, qualify_imported_expr(ipkg, inner, bound, tparams), sp)
    EMutArg(inner, sp) => EMutArg(qualify_imported_expr(ipkg, inner, bound, tparams), sp)
    _ => e
  }
}

///|
fn qualify_cond_with_bindings(
  ipkg : ImportedPkg,
  cond : Expr,
  bound : Array[String],
  tparams : Array[String],
) -> Expr {
  match cond {
    EIs(scrut, pat, sp) => {
      let qs = qualify_imported_expr(ipkg, scrut, bound, tparams)
      qualify_pat_bindings(pat, bound)
      EIs(qs, pat, sp)
    }
    EBinary("&&", l, r, sp) => {
      let ql = qualify_cond_with_bindings(ipkg, l, bound, tparams)
      let qr = qualify_cond_with_bindings(ipkg, r, bound, tparams)
      EBinary("&&", ql, qr, sp)
    }
    _ => qualify_imported_expr(ipkg, cond, bound, tparams)
  }
}

///|
fn qualify_imported_stmts(
  ipkg : ImportedPkg,
  stmts : Array[Stmt],
  bound : Array[String],
  tparams : Array[String],
) -> Array[Stmt] {
  let lb = str_arr_clone(bound)
  let out : Array[Stmt] = []
  let mut i = 0
  while i < stmts.length() {
    let st = stmts[i]
    match st {
      SLet(n, is_mut, ty, init, sp) => {
        let qi = qualify_imported_expr(ipkg, init, lb, tparams)
        let qty = qualify_imported_type_expr(ipkg, ty, tparams)
        lb.push(n)
        out.push(SLet(n, is_mut, qty, qi, sp))
      }
      SLetTuple(ns, ty, init, sp) => {
        let qi = qualify_imported_expr(ipkg, init, lb, tparams)
        let qty = qualify_imported_type_expr(ipkg, ty, tparams)
        let mut j = 0
        while j < ns.length() {
          lb.push(ns[j])
          j = j + 1
        }
        out.push(SLetTuple(ns, qty, qi, sp))
      }
      SAssign(l, r, sp) =>
        out.push(
          SAssign(
            qualify_imported_expr(ipkg, l, lb, tparams),
            qualify_imported_expr(ipkg, r, lb, tparams),
            sp,
          ),
        )
      SCompoundAssign(op, l, r, sp) =>
        out.push(
          SCompoundAssign(
            op,
            qualify_imported_expr(ipkg, l, lb, tparams),
            qualify_imported_expr(ipkg, r, lb, tparams),
            sp,
          ),
        )
      SGuard(c, body, sp) => {
        let gb = str_arr_clone(lb)
        let qc = qualify_imported_cond(ipkg, c, gb, tparams)
        let qbody = qualify_imported_stmts(ipkg, body, lb, tparams)
        let mut gi = lb.length()
        while gi < gb.length() {
          lb.push(gb[gi])
          gi = gi + 1
        }
        out.push(SGuard(qc, qbody, sp))
      }
      SWhile(c, body, sp) => {
        let wb = str_arr_clone(lb)
        let qc = qualify_imported_cond(ipkg, c, wb, tparams)
        let qbody = qualify_imported_stmts(ipkg, body, wb, tparams)
        out.push(SWhile(qc, qbody, sp))
      }
      SFor(init, c, step, body, sp) => {
        let fb = str_arr_clone(lb)
        let qi_arr = qualify_imported_stmts(ipkg, [init], fb, tparams)
        match init {
          SLet(n, _, _, _, _) => fb.push(n)
          _ => ()
        }
        let qc = qualify_imported_expr(ipkg, c, fb, tparams)
        let qs_arr = qualify_imported_stmts(ipkg, [step], fb, tparams)
        let qbody = qualify_imported_stmts(ipkg, body, fb, tparams)
        out.push(SFor(qi_arr[0], qc, qs_arr[0], qbody, sp))
      }
      SForRange(n, a, b, incl, body, sp) => {
        let qa = qualify_imported_expr(ipkg, a, lb, tparams)
        let qb = qualify_imported_expr(ipkg, b, lb, tparams)
        let fb = str_arr_clone(lb)
        fb.push(n)
        out.push(SForRange(n, qa, qb, incl, qualify_imported_stmts(ipkg, body, fb, tparams), sp))
      }
      SForIn(idx, v, it, body, sp) => {
        let qit = qualify_imported_expr(ipkg, it, lb, tparams)
        let fb = str_arr_clone(lb)
        if idx != "" {
          fb.push(idx)
        }
        fb.push(v)
        out.push(SForIn(idx, v, qit, qualify_imported_stmts(ipkg, body, fb, tparams), sp))
      }
      SReturn(ro, sp) =>
        match ro {
          Some(re) => out.push(SReturn(Some(qualify_imported_expr(ipkg, re, lb, tparams)), sp))
          None => out.push(st)
        }
      SDebugAssert(c, m, sp) =>
        out.push(
          SDebugAssert(
            qualify_imported_expr(ipkg, c, lb, tparams),
            qualify_imported_expr(ipkg, m, lb, tparams),
            sp,
          ),
        )
      SExpr(e, sp) => out.push(SExpr(qualify_imported_expr(ipkg, e, lb, tparams), sp))
      SBreak(_) | SContinue(_) => out.push(st)
    }
    i = i + 1
  }
  out
}

///|
///|
pub fn qualify_extern_fn_info(ipkg : ImportedPkg, ei : ExternFnInfo) -> ExternFnInfo {
  let pkg_name = ipkg.name
  let ptys : Array[Ty] = []
  let mut i = 0
  while i < ei.param_tys.length() {
    ptys.push(qualify_imported_ty(pkg_name, ei.param_tys[i]))
    i = i + 1
  }
  ExternFnInfo::{
    decl: ei.decl,
    param_tys: ptys,
    ret_ty: qualify_imported_ty(pkg_name, ei.ret_ty),
  }
}

///|
fn qualify_fn_info(ipkg : ImportedPkg, fi : FnInfo) -> FnInfo {
  let pkg_name = ipkg.name
  let ptys : Array[Ty] = []
  let mut i = 0
  while i < fi.param_tys.length() {
    ptys.push(qualify_imported_ty(pkg_name, fi.param_tys[i]))
    i = i + 1
  }
  let d = fi.decl
  let mut has_def = false
  i = 0
  while i < d.params.length() {
    match d.params[i].default_expr {
      Some(_) => {
        has_def = true
        break
      }
      None => ()
    }
    i = i + 1
  }
  let has_bounds = d.type_bounds.length() > 0
  let qdecl = if has_def || has_bounds {
    let qparams : Array[Param] = if has_def {
      let q_tparams : Array[String] = []
      if d.receiver_type != "" {
        match ipkg.tc.structs.get(d.receiver_type) {
          Some(si) => {
            let mut ti = 0
            while ti < si.decl.type_params.length() {
              q_tparams.push(si.decl.type_params[ti])
              ti = ti + 1
            }
          }
          None =>
            match ipkg.tc.enums.get(d.receiver_type) {
              Some(ei) => {
                let mut ti = 0
                while ti < ei.decl.type_params.length() {
                  q_tparams.push(ei.decl.type_params[ti])
                  ti = ti + 1
                }
              }
              None => ()
            }
        }
      }
      let mut ti = 0
      while ti < d.type_params.length() {
        if !str_arr_contains(q_tparams, d.type_params[ti]) {
          q_tparams.push(d.type_params[ti])
        }
        ti = ti + 1
      }
      let qp : Array[Param] = []
      let prior_names : Array[String] = []
      i = 0
      while i < d.params.length() {
        let p = d.params[i]
        let qdef = match p.default_expr {
          Some(def) => Some(qualify_imported_expr(ipkg, def, prior_names, q_tparams))
          None => None
        }
        prior_names.push(p.name)
        qp.push(Param::{
          name: p.name,
          is_mut: p.is_mut,
          is_into: p.is_into,
          ty: p.ty,
          label_kind: p.label_kind,
          default_expr: qdef,
          span: p.span,
        })
        i = i + 1
      }
      qp
    } else {
      d.params
    }
    let qbounds : Array[TypeBound] = if has_bounds {
      let qb : Array[TypeBound] = []
      let mut bi = 0
      while bi < d.type_bounds.length() {
        let tb = d.type_bounds[bi]
        let qtrs : Array[String] = []
        let mut ti = 0
        while ti < tb.traits.length() {
          let tn = tb.traits[ti]
          if tn == "@builtin:Eq" {
            qtrs.push("@builtin:Eq")
          } else if starts_with_str(tn, "@canon:") {
            qtrs.push(tn)
          } else if !has_qual_sep(tn) && ipkg.tc.traits.contains(tn) {
            qtrs.push("@canon:" + ipkg.name + "::" + tn)
          } else if tn == "Eq" {
            qtrs.push("@builtin:Eq")
          } else {
            let cn = canon_trait_name(ipkg.tc, tn)
            if cn == "@builtin:Eq" {
              qtrs.push("@builtin:Eq")
            } else if has_qual_sep(cn) {
              qtrs.push("@canon:" + cn)
            } else {
              qtrs.push(cn)
            }
          }
          ti = ti + 1
        }
        qb.push(TypeBound::{ param: tb.param, traits: qtrs })
        bi = bi + 1
      }
      qb
    } else {
      d.type_bounds
    }
    FnDecl::{
      is_pub: d.is_pub,
      no_io: d.no_io,
      is_into: d.is_into,
      is_verify: d.is_verify,
      is_verify_opaque: d.is_verify_opaque,
      receiver_type: d.receiver_type,
      name: d.name,
      type_params: d.type_params,
      type_bounds: qbounds,
      params: qparams,
      ret_ty: d.ret_ty,
      body: d.body,
      span: d.span,
      lparen_span: d.lparen_span,
    }
  } else {
    d
  }
  FnInfo::{
    decl: qdecl,
    param_tys: ptys,
    ret_ty: qualify_imported_ty(pkg_name, fi.ret_ty),
    is_imported: true,
  }
}

///|
fn import_pkg_into_tc(tc : TypeChecker, ipkg : ImportedPkg) -> Unit {
  if !tc.imported_pkgs.contains(ipkg.name) {
    tc.imported_pkg_names.push(ipkg.name)
  }
  tc.imported_pkgs.set(ipkg.name, ipkg)
  if !tc.all_imported_pkgs.contains(ipkg.name) {
    tc.all_imported_pkg_names.push(ipkg.name)
    tc.all_imported_pkgs.set(ipkg.name, ipkg)
  }
  let mut ai = 0
  while ai < ipkg.tc.all_imported_pkg_names.length() {
    let aname = ipkg.tc.all_imported_pkg_names[ai]
    if !tc.all_imported_pkgs.contains(aname) {
      match ipkg.tc.all_imported_pkgs.get(aname) {
        Some(apkg) => {
          tc.all_imported_pkg_names.push(aname)
          tc.all_imported_pkgs.set(aname, apkg)
        }
        None => ()
      }
    }
    ai = ai + 1
  }
  let mut ci_sym = 0
  while ci_sym < ipkg.tc.exported_c_sym_names.length() {
    let csym = ipkg.tc.exported_c_sym_names[ci_sym]
    match ipkg.tc.exported_c_syms.get(csym) {
      Some(def_pkg) =>
        match tc.exported_c_syms.get(csym) {
          Some(prev_pkg) =>
            if prev_pkg != def_pkg {
              tc_err(
                tc,
                span_new(tc.pkg_name + "/pion.toml", 1, 1),
                "E_DUPLICATE_C_SYMBOL",
                "duplicate C export symbol `" +
                csym +
                "` defined in both `" +
                prev_pkg +
                "` and `" +
                def_pkg +
                "`",
                "unique C export symbol across packages",
                csym,
                "rename one `extern \"C\" fn ... = \"...\"` symbol to avoid linker collision",
              )
            }
          None => {
            tc.exported_c_syms.set(csym, def_pkg)
            tc.exported_c_sym_names.push(csym)
          }
        }
      None => ()
    }
    ci_sym = ci_sym + 1
  }
  tc.expansive_ready = false
  tc.expansive_defs.clear()
  tc.expansive_params.clear()
  let mut ei = 0
  while ei < ipkg.tc.eq_keys.length() {
    let ek = ipkg.tc.eq_keys[ei]
    match ipkg.tc.eq_tparams.get(ek) {
      Some(tps) => eq_tparams_add_all(tc, ek, tps)
      None => ()
    }
    ei = ei + 1
  }
  let mut vei = 0
  while vei < ipkg.tc.verify_eq_keys.length() {
    let vek = ipkg.tc.verify_eq_keys[vei]
    match ipkg.tc.verify_eq_tparams.get(vek) {
      Some(tps) => verify_eq_tparams_add_all(tc, vek, tps)
      None => ()
    }
    vei = vei + 1
  }
  let mut oi = 0
  while oi < ipkg.tc.op_keys.length() {
    let ok = ipkg.tc.op_keys[oi]
    match ipkg.tc.op_tparams.get(ok) {
      Some(tps) => op_tparams_add_all(tc, ok, tps)
      None => ()
    }
    oi = oi + 1
  }
  let mut mki = 0
  while mki < ipkg.tc.map_key_ob_keys.length() {
    let mk = ipkg.tc.map_key_ob_keys[mki]
    match ipkg.tc.map_key_obligations.get(mk) {
      Some(ktys) => {
        let mut kj = 0
        while kj < ktys.length() {
          let _ = map_key_ob_add(tc, mk, qualify_imported_ty(ipkg.name, ktys[kj]))
          kj = kj + 1
        }
      }
      None => ()
    }
    mki = mki + 1
  }
  let mut eti = 0
  while eti < ipkg.tc.eq_trait_ob_keys.length() {
    let ek = ipkg.tc.eq_trait_ob_keys[eti]
    match ipkg.tc.eq_trait_obligations.get(ek) {
      Some(obs) => {
        let mut oj = 0
        while oj < obs.length() {
          let ob = obs[oj]
          let qtr = if has_qual_sep(ob.trait_name) || starts_with_str(ob.trait_name, "@builtin:") {
            ob.trait_name
          } else {
            ipkg.name + "::" + ob.trait_name
          }
          let _ = eq_trait_ob_add(tc, ek, TraitObligation::{
            target_ty: qualify_imported_ty(ipkg.name, ob.target_ty),
            trait_name: qtr,
          })
          oj = oj + 1
        }
      }
      None => ()
    }
    eti = eti + 1
  }
  let skeys = ipkg.tc.struct_names
  let mut i = 0
  while i < skeys.length() {
    let k = skeys[i]
    match ipkg.tc.structs.get(k) {
      Some(si) =>
        if has_qual_sep(k) {
          if !ipkg.tc.priv_imported_types.contains(k) && !tc.structs.contains(k) {
            tc.structs.set(k, si)
            tc.struct_names.push(k)
          }
        } else if si.decl.is_pub {
          let qk = ipkg.name + "::" + k
          if !tc.structs.contains(qk) {
            tc.struct_names.push(qk)
            tc.structs.set(qk, qualify_imported_struct_info(ipkg.name, si))
          }
        }
      None => ()
    }
    i = i + 1
  }
  let ekeys = ipkg.tc.enum_names
  i = 0
  while i < ekeys.length() {
    let k = ekeys[i]
    match ipkg.tc.enums.get(k) {
      Some(ei) =>
        if has_qual_sep(k) {
          if !ipkg.tc.priv_imported_types.contains(k) && !tc.enums.contains(k) {
            tc.enums.set(k, ei)
            tc.enum_names.push(k)
          }
        } else if ei.decl.is_pub {
          let qk = ipkg.name + "::" + k
          if !tc.enums.contains(qk) {
            let qvars : Array[VariantInfo] = []
            let mut vi = 0
            while vi < ei.variants.length() {
              let v = ei.variants[vi]
              let qvftys : Array[Ty] = []
              let mut j = 0
              while j < v.field_tys.length() {
                qvftys.push(qualify_imported_ty(ipkg.name, v.field_tys[j]))
                j = j + 1
              }
              qvars.push(VariantInfo::{ name: v.name, field_tys: qvftys })
              vi = vi + 1
            }
            tc.enum_names.push(qk)
            tc.enums.set(qk, EnumInfo::{ decl: ei.decl, variants: qvars })
          }
        }
      None => ()
    }
    i = i + 1
  }
  let mkeys = ipkg.tc.method_names
  i = 0
  while i < mkeys.length() {
    let k = mkeys[i]
    match ipkg.tc.methods.get(k) {
      Some(mi) => {
        let qp = split_qual_name(k)
        let is_already_pkg_qual = has_qual_sep(qp.name) ||
          ipkg.tc.imported_pkgs.contains(qp.prefix)
        if is_already_pkg_qual {
          if !tc.methods.contains(k) {
            tc.methods.set(k, mi)
            tc.method_names.push(k)
          }
        } else if mi.decl.is_pub {
          let qk = ipkg.name + "::" + k
          if !tc.methods.contains(qk) {
            tc.method_names.push(qk)
            tc.methods.set(qk, qualify_fn_info(ipkg, mi))
          }
        }
      }
      None => ()
    }
    i = i + 1
  }
  let tkeys = ipkg.tc.trait_names
  i = 0
  while i < tkeys.length() {
    let k = tkeys[i]
    match ipkg.tc.traits.get(k) {
      Some(ti) =>
        if has_qual_sep(k) {
          if !tc.traits.contains(k) {
            tc.traits.set(k, ti)
            tc.trait_names.push(k)
          }
        } else if ti.decl.is_pub {
          let qk = ipkg.name + "::" + k
          if !tc.traits.contains(qk) {
            tc.trait_names.push(qk)
            tc.traits.set(qk, qualify_imported_trait_info(ipkg.name, ti))
          }
        }
      None => ()
    }
    i = i + 1
  }
  let ikeys = ipkg.tc.impl_keys
  i = 0
  while i < ikeys.length() {
    let k = ikeys[i]
    match ipkg.tc.impls.get(k) {
      Some(ii) =>
        if ii.pkg_name != ipkg.name {
          // Already normalized when `ipkg` imported it from its own dependency.
          if !tc.impls.contains(k) {
            tc.impls.set(k, ii)
            tc.impl_keys.push(k)
          }
        } else {
          let q_trait = if !has_qual_sep(ii.trait_name) &&
            ipkg.tc.traits.contains(ii.trait_name) {
            ipkg.name + "::" + ii.trait_name
          } else {
            ii.trait_name
          }
          let q_target = if !has_qual_sep(ii.target_type) &&
            (
              ipkg.tc.structs.contains(ii.target_type) ||
              ipkg.tc.enums.contains(ii.target_type)
            ) {
            ipkg.name + "::" + ii.target_type
          } else {
            ii.target_type
          }
          let qk = q_trait + "::" + q_target
          if !tc.impls.contains(qk) {
            let qms : Map[String, FnInfo] = Map([])
            let mut mi = 0
            while mi < ii.method_names.length() {
              let mn = ii.method_names[mi]
              match ii.methods.get(mn) {
                Some(mf) => qms.set(mn, qualify_fn_info(ipkg, mf))
                None => ()
              }
              mi = mi + 1
            }
            tc.impls.set(
              qk,
              ImplInfo::{
                decl: ii.decl,
                pkg_name: ii.pkg_name,
                trait_name: q_trait,
                target_type: q_target,
                target_param_names: ii.target_param_names,
                target_param_bounds: qualify_impl_param_bounds(ipkg, ii.target_param_bounds),
                methods: qms,
                method_names: ii.method_names,
              },
            )
            tc.impl_keys.push(qk)
          }
        }
      None => ()
    }
    i = i + 1
  }
}

///|
pub fn resolve_alias_pkg(
  tc : TypeChecker,
  alias_name : String,
) -> Option[ImportedPkg] {
  if starts_with_str(alias_name, "@canon:") {
    return lookup_imported_pkg_transitive(tc, slice_str(alias_name, 7, alias_name.length()))
  }
  match tc.import_aliases.get(alias_name) {
    Some(canon) => tc.imported_pkgs.get(canon)
    None => None
  }
}

///|
pub fn lookup_imported_pkg_transitive(
  tc : TypeChecker,
  canon_name : String,
) -> Option[ImportedPkg] {
  match tc.imported_pkgs.get(canon_name) {
    Some(p) => Some(p)
    None => tc.all_imported_pkgs.get(canon_name)
  }
}

///|
pub fn is_caller_alias_redirected(tc : TypeChecker, qual_name : String) -> Bool {
  if tc.in_imported_default_arg || !has_qual_sep(qual_name) {
    return false
  }
  let qp = split_qual_name(qual_name)
  match resolve_alias_pkg(tc, qp.prefix) {
    Some(ip) => ip.name != qp.prefix
    None => false
  }
}

///|
fn tc_ensure_priv_struct_registered(
  tc : TypeChecker,
  ipkg : ImportedPkg,
  q_st : String,
  si : StructInfo,
) -> Unit {
  let qk = ipkg.name + "::" + q_st
  if !tc.structs.contains(qk) {
    let qftys : Array[Ty] = []
    let mut j = 0
    while j < si.field_tys.length() {
      qftys.push(qualify_imported_ty(ipkg.name, si.field_tys[j]))
      j = j + 1
    }
    tc.struct_names.push(qk)
    tc.structs.set(
      qk,
      StructInfo::{
        decl: si.decl,
        field_names: si.field_names,
        field_muts: si.field_muts,
        field_privs: si.field_privs,
        field_tys: qftys,
      },
    )
    tc.priv_imported_types.set(qk, true)
  }
}

///|
fn tc_ensure_priv_enum_registered(
  tc : TypeChecker,
  ipkg : ImportedPkg,
  q_en : String,
  ei : EnumInfo,
) -> Unit {
  let qk = ipkg.name + "::" + q_en
  if !tc.enums.contains(qk) {
    let qvars : Array[VariantInfo] = []
    let mut vi = 0
    while vi < ei.variants.length() {
      let v = ei.variants[vi]
      let qvftys : Array[Ty] = []
      let mut j = 0
      while j < v.field_tys.length() {
        qvftys.push(qualify_imported_ty(ipkg.name, v.field_tys[j]))
        j = j + 1
      }
      qvars.push(VariantInfo::{ name: v.name, field_tys: qvftys })
      vi = vi + 1
    }
    tc.enum_names.push(qk)
    tc.enums.set(qk, EnumInfo::{ decl: ei.decl, variants: qvars })
    tc.priv_imported_types.set(qk, true)
  }
}

///|
fn resolve_pkg_for_lookup(
  tc : TypeChecker,
  qual : String,
  allow_transitive : Bool,
) -> Option[ImportedPkg] {
  if starts_with_str(qual, "@canon:") {
    return lookup_imported_pkg_transitive(tc, slice_str(qual, 7, qual.length()))
  }
  if tc.in_imported_default_arg {
    match lookup_imported_pkg_transitive(tc, qual) {
      Some(p) => return Some(p)
      None => ()
    }
  }
  match resolve_alias_pkg(tc, qual) {
    Some(p) => Some(p)
    None =>
      if allow_transitive {
        lookup_imported_pkg_transitive(tc, qual)
      } else {
        None
      }
  }
}

///|
/// Private symbol with a known declaration: also patch `pub ` onto it.
fn emit_private_err_at(
  tc : TypeChecker,
  sp : Span,
  kind : String,
  pkg_name : String,
  sym : String,
  decl_span : Span,
) -> Unit {
  emit_private_err(tc, sp, kind, pkg_name, sym)
  if decl_span.file != "" {
    tc_add_edit(tc, text_edit_insert(decl_span, 0, "pub "))
  }
}

///|
fn emit_private_err(
  tc : TypeChecker,
  sp : Span,
  kind : String,
  pkg_name : String,
  sym : String,
) -> Unit {
  tc_err(
    tc,
    sp,
    "E_PRIVATE_SYMBOL",
    kind + " `" + sym + "` in package `" + pkg_name + "` is private",
    "pub " + kind,
    "private " + kind + " `" + pkg_name + "::" + sym + "`",
    "mark `" + kind + " " + sym + "` as `pub` in package `" + pkg_name + "`",
  )
}

///|
/// Attaches a machine-applicable edit to the diagnostic just reported (once
/// per distinct edit, so repeated errors never yield conflicting patches).
fn tc_add_edit(tc : TypeChecker, edit : TextEdit) -> Unit {
  tc_add_edit_at(tc, tc.diagnostics.length() - 1, edit)
}

///|
fn tc_add_edit_at(tc : TypeChecker, idx : Int, edit : TextEdit) -> Unit {
  if idx < 0 || idx >= tc.diagnostics.length() || edit.line <= 0 || edit.col <= 0 {
    return
  }
  let key = edit.file +
    ":" +
    edit.line.to_string() +
    ":" +
    edit.col.to_string() +
    ":" +
    edit.end_line.to_string() +
    ":" +
    edit.end_col.to_string() +
    ":" +
    edit.replacement
  if tc.edit_keys.contains(key) {
    return
  }
  tc.edit_keys.set(key, true)
  tc.diagnostics[idx].edits.push(edit)
}

///|
/// Index of the latest diagnostic `code` reported at `sp`, or -1.
fn tc_find_diag(tc : TypeChecker, code : String, sp : Span) -> Int {
  let mut i = tc.diagnostics.length() - 1
  while i >= 0 {
    let d = tc.diagnostics[i]
    if d.code == code && d.line == sp.line && d.col == sp.col && d.file == sp.file {
      return i
    }
    i = i - 1
  }
  -1
}

///|
pub fn span_key(sp : Span) -> String {
  sp.file + ":" + sp.line.to_string() + ":" + sp.col.to_string()
}

///|
/// Column just past a single-line type expression written in canonical
/// (`pionc fmt`) spacing, or -1 when it cannot be located exactly.
fn type_expr_end_col(te : TypeExpr) -> Int {
  match te {
    TyName(name, args, sp) => {
      if args.length() == 0 {
        return sp.col + name.length()
      }
      let mut i = 0
      while i < args.length() {
        if type_expr_span(args[i]).line != sp.line {
          return -1
        }
        i = i + 1
      }
      let last_end = type_expr_end_col(args[args.length() - 1])
      if last_end < 0 {
        -1
      } else {
        last_end + 1
      }
    }
    TyDynTrait(name, sp) => sp.col + 4 + name.length()
    _ => -1
  }
}

///|
/// Column just past a single-line expression, or -1 when it cannot be located
/// exactly.
fn expr_end_col(e : Expr) -> Int {
  match e {
    EInt(raw, sp)
    | EInt64(raw, sp)
    | EUInt(raw, sp)
    | EUInt64(raw, sp)
    | EDouble(raw, sp)
    | EFloat(raw, sp)
    | EIdent(raw, sp) =>
      sp.col + raw.length()
    EBool(b, sp) => sp.col + (if b { 4 } else { 5 })
    EString(s, sp) => {
      let mut i = 0
      while i < s.length() {
        let ch = str_code_at(s, i)
        if ch == 34 || ch == 92 || ch == 10 || ch == 13 || ch == 9 || ch < 32 {
          return -1
        }
        i = i + 1
      }
      sp.col + s.length() + 2
    }
    EChar(s, sp) => sp.col + s.length() + 2
    EByte(s, sp) => sp.col + s.length() + 3
    EUnit(sp) => sp.col + 2
    EPath(q, m, sp) => sp.col + q.length() + 2 + m.length()
    EDotVariant(vname, args, sp) =>
      if args.length() == 0 {
        sp.col + 1 + vname.length()
      } else {
        -1
      }
    EField(obj, fname, sp) =>
      if expr_span(obj).line == sp.line {
        sp.col + 1 + fname.length()
      } else {
        -1
      }
    EUnary(_, inner, sp) | EMove(inner, sp) =>
      if expr_span(inner).line == sp.line {
        expr_end_col(inner)
      } else {
        -1
      }
    EBinary(_, _, rhs, sp) =>
      if expr_span(rhs).line == sp.line {
        expr_end_col(rhs)
      } else {
        -1
      }
    ETry(inner, sp) =>
      if expr_span(inner).line == sp.line {
        sp.col + 1
      } else {
        -1
      }
    EArrayLit(elems, sp) =>
      if elems.length() == 0 {
        sp.col + 2
      } else {
        let last = elems[elems.length() - 1]
        if expr_span(last).line == sp.line {
          let ec = expr_end_col(last)
          if ec > 0 { ec + 1 } else { -1 }
        } else {
          -1
        }
      }
    ECall(_, args, sp) =>
      if args.length() == 0 {
        sp.col + 2
      } else {
        let last = args[args.length() - 1]
        if expr_span(last).line == sp.line {
          let ec = expr_end_col(last)
          if ec > 0 { ec + 1 } else { -1 }
        } else {
          -1
        }
      }
    EMethodCall(_, mname, args, sp) =>
      if args.length() == 0 {
        sp.col + 1 + mname.length() + 2
      } else {
        let last = args[args.length() - 1]
        if expr_span(last).line == sp.line {
          let ec = expr_end_col(last)
          if ec > 0 { ec + 1 } else { -1 }
        } else {
          -1
        }
      }
    _ => -1
  }
}

///|
fn levenshtein_dist(a : String, b : String) -> Int {
  let m = a.length()
  let n = b.length()
  if m == 0 {
    return n
  }
  if n == 0 {
    return m
  }
  let prev : Array[Int] = []
  let curr : Array[Int] = []
  let mut j = 0
  while j <= n {
    prev.push(j)
    curr.push(0)
    j = j + 1
  }
  let mut i = 1
  while i <= m {
    curr[0] = i
    let ca = str_code_at(a, i - 1)
    j = 1
    while j <= n {
      let cb = str_code_at(b, j - 1)
      let cost = if ca == cb { 0 } else { 1 }
      let del = prev[j] + 1
      let ins = curr[j - 1] + 1
      let sub = prev[j - 1] + cost
      let mut best = del
      if ins < best {
        best = ins
      }
      if sub < best {
        best = sub
      }
      curr[j] = best
      j = j + 1
    }
    j = 0
    while j <= n {
      prev[j] = curr[j]
      j = j + 1
    }
    i = i + 1
  }
  prev[n]
}

///|
fn find_closest_name(
  target : String,
  candidates : Array[String],
  max_dist : Int,
) -> Option[String] {
  let mut best_name = ""
  let mut best_dist = max_dist + 1
  let mut tie = false
  let mut i = 0
  while i < candidates.length() {
    let cand = candidates[i]
    let d = levenshtein_dist(target, cand)
    if d < best_dist {
      best_dist = d
      best_name = cand
      tie = false
    } else if d == best_dist {
      tie = true
    }
    i = i + 1
  }
  if best_dist <= max_dist && !tie && best_name.length() > 0 {
    Some(best_name)
  } else {
    None
  }
}

///|
fn default_val_for_ty(t : Ty) -> String {
  match t {
    TInt => "0"
    TInt64 => "0L"
    TUInt => "0U"
    TUInt64 => "0UL"
    TDouble => "0.0"
    TFloat => "0.0f"
    TBool => "false"
    TString => "\"\""
    TUnit => "()"
    TByte => "b'\\0'"
    TInt8 => "0"
    TChar => "'a'"
    TWorld => "world"
    TArray(_) | TFixedArray(_) | TImmArray(_) => "[]"
    TOption(_) => "None"
    _ => "panic(\"todo\")"
  }
}

///|
fn add_arity_edit(
  tc : TypeChecker,
  sp : Span,
  args : Array[Expr],
  param_tys : Array[Ty],
) -> Unit {
  let want = param_tys.length()
  if args.length() > want {
    let last = args[args.length() - 1]
    let last_sp = expr_span(last)
    let last_end = expr_end_col(last)
    if last_end <= 0 {
      return
    }
    if want == 0 {
      let first_sp = expr_span(args[0])
      if first_sp.line == last_sp.line {
        tc_add_edit(tc, TextEdit::{
          file: sp.file,
          line: first_sp.line,
          col: first_sp.col,
          end_line: last_sp.line,
          end_col: last_end,
          replacement: "",
          applicability: "maybe",
        })
      }
    } else {
      let prev = args[want - 1]
      let prev_sp = expr_span(prev)
      let prev_end = expr_end_col(prev)
      if prev_sp.line == last_sp.line && prev_end > 0 {
        tc_add_edit(tc, TextEdit::{
          file: sp.file,
          line: prev_sp.line,
          col: prev_end,
          end_line: last_sp.line,
          end_col: last_end,
          replacement: "",
          applicability: "maybe",
        })
      }
    }
  } else if args.length() < want {
    let sb = StringBuilder()
    let mut k = args.length()
    while k < want {
      if k > args.length() {
        sb.write_string(", ")
      }
      sb.write_string(default_val_for_ty(param_tys[k]))
      k = k + 1
    }
    if args.length() == 0 {
      if sp.line > 0 && sp.col > 0 {
        tc_add_edit(tc, text_edit_insert_maybe(sp, 1, sb.to_string()))
      }
    } else {
      let last = args[args.length() - 1]
      let last_sp = expr_span(last)
      let last_end = expr_end_col(last)
      if last_end > 0 {
        tc_add_edit(tc, TextEdit::{
          file: sp.file,
          line: last_sp.line,
          col: last_end,
          end_line: last_sp.line,
          end_col: last_end,
          replacement: ", " + sb.to_string(),
          applicability: "maybe",
        })
      }
    }
  }
}

///|
fn tc_visible_alias_for_pkg(
  tc : TypeChecker,
  canon_pkg : String,
  file : String,
) -> Option[String] {
  if canon_pkg == "" || canon_pkg == tc.pkg_name {
    return Some("")
  }
  let base = tc_strip_canon_hash(canon_pkg)
  match tc.file_import_aliases.get(file) {
    Some(f_al) => {
      let keys = f_al.keys()
      let mut best = ""
      let mut i = 0
      while i < keys.length() {
        let al = keys[i]
        match f_al.get(al) {
          Some(t) =>
            if t == canon_pkg {
              if al == base {
                best = base
              } else if best != base && (best == "" || al < best) {
                best = al
              }
            }
          None => ()
        }
        i = i + 1
      }
      if best != "" {
        Some(best)
      } else {
        None
      }
    }
    None => None
  }
}

///|
fn tc_render_qual_name_for_file(
  tc : TypeChecker,
  name : String,
  file : String,
) -> Option[String] {
  if !has_qual_sep(name) {
    return Some(name)
  }
  let qp = split_qual_name(name)
  match tc_visible_alias_for_pkg(tc, qp.prefix, file) {
    Some(al) =>
      if al == "" {
        Some(qp.name)
      } else {
        Some(al + "::" + qp.name)
      }
    None => None
  }
}

///|
fn tc_render_ty_for_file(
  tc : TypeChecker,
  t : Ty,
  file : String,
) -> Option[String] {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TString | TStrView | TBytes | TBytesView | TStringBuilder | TUnit | TNever | TWorld | TScope | TAtomicInt | TPtr | TError =>
      Some(ty_to_string(t))
    TParam(n) => Some(n)
    TArray(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("Array[" + es + "]")
        None => None
      }
    TFixedArray(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("FixedArray[" + es + "]")
        None => None
      }
    TImmArray(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("ImmArray[" + es + "]")
        None => None
      }
    TMap(k, v) =>
      match (tc_render_ty_for_file(tc, k, file), tc_render_ty_for_file(tc, v, file)) {
        (Some(ks), Some(vs)) => Some("Map[" + ks + ", " + vs + "]")
        _ => None
      }
    TOption(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("Option[" + es + "]")
        None => None
      }
    TResult(ok, err) =>
      match (tc_render_ty_for_file(tc, ok, file), tc_render_ty_for_file(tc, err, file)) {
        (Some(os), Some(es)) => Some("Result[" + os + ", " + es + "]")
        _ => None
      }
    TChannel(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("Channel[" + es + "]")
        None => None
      }
    TMutex(e) =>
      match tc_render_ty_for_file(tc, e, file) {
        Some(es) => Some("Mutex[" + es + "]")
        None => None
      }
    TDynTrait(name) =>
      match tc_render_qual_name_for_file(tc, name, file) {
        Some(rn) => Some("dyn " + rn)
        None => None
      }
    TStruct(name, args) | TEnum(name, args) =>
      match tc_render_qual_name_for_file(tc, name, file) {
        Some(rn) =>
          if args.length() == 0 {
            Some(rn)
          } else {
            let sb = StringBuilder()
            sb.write_string(rn)
            sb.write_string("[")
            let mut i = 0
            while i < args.length() {
              if i > 0 {
                sb.write_string(", ")
              }
              match tc_render_ty_for_file(tc, args[i], file) {
                Some(as_s) => sb.write_string(as_s)
                None => return None
              }
              i = i + 1
            }
            sb.write_string("]")
            Some(sb.to_string())
          }
        None => None
      }
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        match tc_render_ty_for_file(tc, elems[i], file) {
          Some(es) => sb.write_string(es)
          None => return None
        }
        i = i + 1
      }
      sb.write_string(")")
      Some(sb.to_string())
    }
    TFn(params, ret) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < params.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        match tc_render_ty_for_file(tc, params[i], file) {
          Some(ps) => sb.write_string(ps)
          None => return None
        }
        i = i + 1
      }
      sb.write_string(") -> ")
      match tc_render_ty_for_file(tc, ret, file) {
        Some(rs) => sb.write_string(rs)
        None => return None
      }
      Some(sb.to_string())
    }
  }
}

///|
fn add_missing_impl_edit(
  tc : TypeChecker,
  trait_name : String,
  concrete_ty : Ty,
) -> Unit {
  if trait_name == "@builtin:Eq" {
    return
  }
  let tinfo = match lookup_trait(tc, trait_name) {
    Some(ti) => ti
    None => return
  }
  let target_name = ty_base_name(concrete_ty)
  let mut insert_span = span_empty()
  match tc.structs.get(target_name) {
    Some(si) =>
      if !has_qual_sep(target_name) && si.decl.end_span.line > 0 {
        insert_span = si.decl.end_span
      }
    None => ()
  }
  if insert_span.line == 0 {
    match tc.enums.get(target_name) {
      Some(ei) =>
        if !has_qual_sep(target_name) && ei.decl.end_span.line > 0 {
          insert_span = ei.decl.end_span
        }
      None => ()
    }
  }
  if insert_span.line == 0 {
    return
  }
  let rendered_trait = match tc_render_qual_name_for_file(tc, trait_name, insert_span.file) {
    Some(rn) => rn
    None => {
      if has_qual_sep(trait_name) && tc.diagnostics.length() > 0 {
        let tpkg = split_qual_name(trait_name).prefix
        let base = tc_strip_canon_hash(tpkg)
        let mut dep_key = ""
        let dep_keys = tc.dep_map.keys()
        let mut di = 0
        while di < dep_keys.length() {
          let al = dep_keys[di]
          match tc.dep_map.get(al) {
            Some(t) =>
              if t == tpkg {
                if al == base {
                  dep_key = base
                } else if dep_key != base && (dep_key == "" || al < dep_key) {
                  dep_key = al
                }
              }
            None => ()
          }
          di = di + 1
        }
        let import_hint = if dep_key != "" {
          " (add `import \"" + dep_key + "\"` in `" + insert_span.file + "` first)"
        } else {
          " (add `" + base + "` to pion.toml dependencies and import it in `" + insert_span.file + "` first)"
        }
        let last_i = tc.diagnostics.length() - 1
        let d = tc.diagnostics[last_i]
        tc.diagnostics[last_i] = Diagnostic::{
          file: d.file,
          line: d.line,
          col: d.col,
          code: d.code,
          message: d.message,
          expected: d.expected,
          found: d.found,
          fixit: d.fixit + import_hint,
          edits: d.edits,
        }
      }
      return
    }
  }
  let rendered_target = match tc_render_ty_for_file(tc, concrete_ty, insert_span.file) {
    Some(rt) => rt
    None => return
  }
  let self_subst : Map[String, Ty] = Map([])
  self_subst.set("Self", concrete_ty)
  let sb = StringBuilder()
  sb.write_string("\n\nimpl ")
  sb.write_string(rendered_trait)
  sb.write_string(" for ")
  sb.write_string(rendered_target)
  sb.write_string(" {\n")
  let mut mi = 0
  while mi < tinfo.methods.length() {
    let tm = tinfo.methods[mi]
    let decl_m = tinfo.decl.methods[mi]
    sb.write_string("  fn ")
    sb.write_string(tm.name)
    sb.write_string("(")
    let mut pi = 0
    while pi < tm.param_tys.length() {
      if pi > 0 {
        sb.write_string(", ")
      }
      let pname = if pi < decl_m.params.length() {
        decl_m.params[pi].name
      } else {
        "arg" + pi.to_string()
      }
      if pi < decl_m.params.length() && decl_m.params[pi].is_mut {
        sb.write_string("mut ")
      }
      sb.write_string(pname)
      sb.write_string(" : ")
      match tc_render_ty_for_file(tc, subst_ty(tm.param_tys[pi], self_subst), insert_span.file) {
        Some(pts) => sb.write_string(pts)
        None => return
      }
      pi = pi + 1
    }
    sb.write_string(") -> ")
    match tc_render_ty_for_file(tc, subst_ty(tm.ret_ty, self_subst), insert_span.file) {
      Some(rts) => sb.write_string(rts)
      None => return
    }
    sb.write_string(" {\n    panic(\"todo\")\n  }\n")
    mi = mi + 1
  }
  sb.write_string("}")
  tc_add_edit(tc, text_edit_insert_maybe(insert_span, 1, sb.to_string()))
}

///|
fn ty_mentions_self(t : Ty) -> Bool {
  match t {
    TParam(n) => n == "Self"
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) => ty_mentions_self(e)
    TResult(o, e) | TMap(o, e) => ty_mentions_self(o) || ty_mentions_self(e)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if ty_mentions_self(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        if ty_mentions_self(ps[i]) {
          return true
        }
        i = i + 1
      }
      ty_mentions_self(r)
    }
    _ => false
  }
}

///|
fn check_trait_object_safe(
  tc : TypeChecker,
  tname : String,
  tinfo : TraitInfo,
  sp : Span,
) -> Bool {
  let mut mi = 0
  while mi < tinfo.methods.length() {
    let tm = tinfo.methods[mi]
    let has_self_recv = if tm.param_tys.length() > 0 {
      match tm.param_tys[0] {
        TParam(p) => p == "Self"
        _ => false
      }
    } else {
      false
    }
    if !has_self_recv {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "trait `" + tname + "` is not object-safe for `dyn " + tname + "`: method `" + tm.name + "` must take `self : Self` as its first parameter",
        "object-safe trait",
        "dyn " + tname,
        "make `self : Self` the first parameter of `" + tm.name + "`",
      )
      return false
    }
    let mut pi = 1
    while pi < tm.param_tys.length() {
      if ty_mentions_self(tm.param_tys[pi]) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "trait `" + tname + "` is not object-safe for `dyn " + tname + "`: method `" + tm.name + "` references `Self` in parameter " + (pi + 1).to_string(),
          "object-safe trait",
          "dyn " + tname,
          "avoid `Self` in non-receiver parameters of `" + tm.name + "`",
        )
        return false
      }
      pi = pi + 1
    }
    if mi < tinfo.decl.methods.length() && params_have_mut(tinfo.decl.methods[mi].params) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "trait `" + tname + "` is not object-safe for `dyn " + tname + "`: method `" + tm.name + "` has `mut` parameters",
        "object-safe trait",
        "dyn " + tname,
        "call `" + tm.name + "` through a generic bound (`T : " + tname + "`) instead of `dyn " + tname + "`",
      )
      return false
    }
    if ty_mentions_self(tm.ret_ty) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "trait `" + tname + "` is not object-safe for `dyn " + tname + "`: method `" + tm.name + "` returns `Self`",
        "object-safe trait",
        "dyn " + tname,
        "return a concrete type or `dyn " + tname + "` instead of `Self` in `" + tm.name + "`",
      )
      return false
    }
    mi = mi + 1
  }
  true
}

///|
fn eq_tparams_has(tc : TypeChecker, key : String, tparam : String) -> Bool {
  match tc.eq_tparams.get(key) {
    Some(tps) => str_arr_contains(tps, tparam)
    None => false
  }
}

///|
fn eq_tparams_add(tc : TypeChecker, key : String, tparam : String) -> Bool {
  match tc.eq_tparams.get(key) {
    Some(tps) =>
      if str_arr_contains(tps, tparam) {
        false
      } else {
        tps.push(tparam)
        true
      }
    None => {
      tc.eq_tparams.set(key, [tparam])
      tc.eq_keys.push(key)
      true
    }
  }
}

///|
fn eq_tparams_add_all(tc : TypeChecker, key : String, tps : Array[String]) -> Unit {
  let mut i = 0
  while i < tps.length() {
    let _ = eq_tparams_add(tc, key, tps[i])
    i = i + 1
  }
}

///|
fn verify_eq_tparams_has(tc : TypeChecker, key : String, tparam : String) -> Bool {
  match tc.verify_eq_tparams.get(key) {
    Some(tps) => str_arr_contains(tps, tparam)
    None => false
  }
}

///|
fn verify_eq_tparams_add(tc : TypeChecker, key : String, tparam : String) -> Bool {
  match tc.verify_eq_tparams.get(key) {
    Some(tps) =>
      if str_arr_contains(tps, tparam) {
        false
      } else {
        tps.push(tparam)
        true
      }
    None => {
      tc.verify_eq_tparams.set(key, [tparam])
      tc.verify_eq_keys.push(key)
      true
    }
  }
}

///|
fn verify_eq_tparams_add_all(tc : TypeChecker, key : String, tps : Array[String]) -> Unit {
  let mut i = 0
  while i < tps.length() {
    let _ = verify_eq_tparams_add(tc, key, tps[i])
    i = i + 1
  }
}

///|
fn op_tparams_has(tc : TypeChecker, key : String, tag : String) -> Bool {
  match tc.op_tparams.get(key) {
    Some(tps) => str_arr_contains(tps, tag)
    None => false
  }
}

///|
fn op_tparams_add(tc : TypeChecker, key : String, tag : String) -> Bool {
  match tc.op_tparams.get(key) {
    Some(tps) =>
      if str_arr_contains(tps, tag) {
        false
      } else {
        tps.push(tag)
        true
      }
    None => {
      tc.op_tparams.set(key, [tag])
      tc.op_keys.push(key)
      true
    }
  }
}

///|
fn op_tparams_add_all(tc : TypeChecker, key : String, tps : Array[String]) -> Unit {
  let mut i = 0
  while i < tps.length() {
    let _ = op_tparams_add(tc, key, tps[i])
    i = i + 1
  }
}

///|
fn op_tparams_record(tc : TypeChecker, env : Env, kind : String, ty : Ty) -> Unit {
  match ty {
    TParam(tp) =>
      if env.fn_key != "" && str_arr_contains(env.type_params, tp) {
        let _ = op_tparams_add(tc, env.fn_key, kind + ":" + tp)
      }
    _ => ()
  }
}

///|
fn op_ty_satisfies(tc : TypeChecker, kind : String, ty : Ty) -> Bool {
  match ty {
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TByte
    | TInt8
    | TParam(_)
    | TError
    | TNever => true
    TDouble | TFloat => kind == "num" || kind == "add" || kind == "ord"
    TString => kind == "add" || kind == "ord"
    TBool | TChar | TStrView => kind == "ord"
    TEnum(_, _) => kind == "ord" && tc_is_unboxed_unit_enum(tc, ty)
    _ => false
  }
}

///|
fn ty_has_nominal(t : Ty) -> Bool {
  match t {
    TStruct(_, _) | TEnum(_, _) => true
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) => ty_has_nominal(e)
    TResult(a, b) => ty_has_nominal(a) || ty_has_nominal(b)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if ty_has_nominal(es[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn ty_collect_tparams(t : Ty, out : Array[String]) -> Unit {
  match t {
    TParam(p) =>
      if !str_arr_contains(out, p) {
        out.push(p)
      }
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      ty_collect_tparams(e, out)
    TResult(a, b) | TMap(a, b) => {
      ty_collect_tparams(a, out)
      ty_collect_tparams(b, out)
    }
    TTuple(args) | TStruct(_, args) | TEnum(_, args) => {
      let mut i = 0
      while i < args.length() {
        ty_collect_tparams(args[i], out)
        i = i + 1
      }
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        ty_collect_tparams(ps[i], out)
        i = i + 1
      }
      ty_collect_tparams(r, out)
    }
    _ => ()
  }
}

///|
fn tc_lookup_enum_info_qualified(tc : TypeChecker, ename : String) -> Option[EnumInfo] {
  match tc.enums.get(ename) {
    Some(ei) => Some(ei)
    None => {
      let qp = split_qual_name(ename)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.enums.get(qp.name) {
              Some(ei) => Some(qualify_imported_enum_info(ipkg.name, ei))
              None => None
            }
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
fn eq_canonical_nominal_name(tc : TypeChecker, is_struct : Bool, name : String) -> String {
  if is_struct {
    if tc.structs.contains(name) {
      return name
    }
  } else {
    if tc.enums.contains(name) {
      return name
    }
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    match lookup_imported_pkg_transitive(tc, qp.prefix) {
      Some(ipkg) => ipkg.name + "::" + qp.name
      None => name
    }
  } else {
    name
  }
}

///|
fn eq_nominal_key(tc : TypeChecker, is_struct : Bool, name : String) -> String {
  let canon = eq_canonical_nominal_name(tc, is_struct, name)
  if is_struct {
    "S:" + canon
  } else {
    "E:" + canon
  }
}

///|
fn eq_enqueue_nominals_in_ty(
  tc : TypeChecker,
  t : Ty,
  def_ids : Map[String, Int],
  def_is_struct : Array[Bool],
  def_names : Array[String],
) -> Unit {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      eq_enqueue_nominals_in_ty(tc, e, def_ids, def_is_struct, def_names)
    TResult(a, b) | TMap(a, b) => {
      eq_enqueue_nominals_in_ty(tc, a, def_ids, def_is_struct, def_names)
      eq_enqueue_nominals_in_ty(tc, b, def_ids, def_is_struct, def_names)
    }
    TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        eq_enqueue_nominals_in_ty(tc, args[i], def_ids, def_is_struct, def_names)
        i = i + 1
      }
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        eq_enqueue_nominals_in_ty(tc, ps[i], def_ids, def_is_struct, def_names)
        i = i + 1
      }
      eq_enqueue_nominals_in_ty(tc, r, def_ids, def_is_struct, def_names)
    }
    TStruct(name, args) => {
      let key = eq_nominal_key(tc, true, name)
      if !def_ids.contains(key) {
        let id = def_names.length()
        def_ids.set(key, id)
        def_is_struct.push(true)
        def_names.push(eq_canonical_nominal_name(tc, true, name))
      }
      let mut i = 0
      while i < args.length() {
        eq_enqueue_nominals_in_ty(tc, args[i], def_ids, def_is_struct, def_names)
        i = i + 1
      }
    }
    TEnum(name, args) => {
      let key = eq_nominal_key(tc, false, name)
      if !def_ids.contains(key) {
        let id = def_names.length()
        def_ids.set(key, id)
        def_is_struct.push(false)
        def_names.push(eq_canonical_nominal_name(tc, false, name))
      }
      let mut i = 0
      while i < args.length() {
        eq_enqueue_nominals_in_ty(tc, args[i], def_ids, def_is_struct, def_names)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn eq_find_tparam_idx(tparams : Array[String], name : String) -> Int {
  let mut i = 0
  while i < tparams.length() {
    if tparams[i] == name {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn eq_mark_used_in_ty(
  tc : TypeChecker,
  t : Ty,
  def_ids : Map[String, Int],
  def_tparams : Array[Array[String]],
  param_used : Array[Array[Bool]],
  owner_d : Int,
  changed : Array[Bool],
) -> Unit {
  match t {
    TParam(p) => {
      let idx = eq_find_tparam_idx(def_tparams[owner_d], p)
      if idx >= 0 && !param_used[owner_d][idx] {
        param_used[owner_d][idx] = true
        changed[0] = true
      }
    }
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) =>
      eq_mark_used_in_ty(tc, e, def_ids, def_tparams, param_used, owner_d, changed)
    TResult(a, b) => {
      eq_mark_used_in_ty(tc, a, def_ids, def_tparams, param_used, owner_d, changed)
      eq_mark_used_in_ty(tc, b, def_ids, def_tparams, param_used, owner_d, changed)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        eq_mark_used_in_ty(tc, es[i], def_ids, def_tparams, param_used, owner_d, changed)
        i = i + 1
      }
    }
    TStruct(en, args) => {
      let key = eq_nominal_key(tc, true, en)
      match def_ids.get(key) {
        Some(ed) => {
          let mut k = 0
          while k < args.length() && k < param_used[ed].length() {
            if param_used[ed][k] {
              eq_mark_used_in_ty(tc, args[k], def_ids, def_tparams, param_used, owner_d, changed)
            }
            k = k + 1
          }
        }
        None => ()
      }
    }
    TEnum(en, args) => {
      let key = eq_nominal_key(tc, false, en)
      match def_ids.get(key) {
        Some(ed) => {
          let mut k = 0
          while k < args.length() && k < param_used[ed].length() {
            if param_used[ed][k] {
              eq_mark_used_in_ty(tc, args[k], def_ids, def_tparams, param_used, owner_d, changed)
            }
            k = k + 1
          }
        }
        None => ()
      }
    }
    _ => ()
  }
}

///|
fn eq_mark_reachable_in_ty(
  tc : TypeChecker,
  t : Ty,
  def_ids : Map[String, Int],
  param_used : Array[Array[Bool]],
  reachable : Array[Bool],
  reach_queue : Array[Int],
) -> Unit {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) =>
      eq_mark_reachable_in_ty(tc, e, def_ids, param_used, reachable, reach_queue)
    TResult(a, b) => {
      eq_mark_reachable_in_ty(tc, a, def_ids, param_used, reachable, reach_queue)
      eq_mark_reachable_in_ty(tc, b, def_ids, param_used, reachable, reach_queue)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        eq_mark_reachable_in_ty(tc, es[i], def_ids, param_used, reachable, reach_queue)
        i = i + 1
      }
    }
    TStruct(en, args) => {
      let key = eq_nominal_key(tc, true, en)
      match def_ids.get(key) {
        Some(ed) => {
          if !reachable[ed] {
            reachable[ed] = true
            reach_queue.push(ed)
          }
          let mut k = 0
          while k < args.length() && k < param_used[ed].length() {
            if param_used[ed][k] {
              eq_mark_reachable_in_ty(tc, args[k], def_ids, param_used, reachable, reach_queue)
            }
            k = k + 1
          }
        }
        None => ()
      }
    }
    TEnum(en, args) => {
      let key = eq_nominal_key(tc, false, en)
      match def_ids.get(key) {
        Some(ed) => {
          if !reachable[ed] {
            reachable[ed] = true
            reach_queue.push(ed)
          }
          let mut k = 0
          while k < args.length() && k < param_used[ed].length() {
            if param_used[ed][k] {
              eq_mark_reachable_in_ty(tc, args[k], def_ids, param_used, reachable, reach_queue)
            }
            k = k + 1
          }
        }
        None => ()
      }
    }
    _ => ()
  }
}

///|
fn eq_add_param_edges(
  tc : TypeChecker,
  t : Ty,
  owner_d : Int,
  def_ids : Map[String, Int],
  def_tparams : Array[Array[String]],
  param_used : Array[Array[Bool]],
  reachable : Array[Bool],
  node_base : Array[Int],
  edge_u : Array[Int],
  edge_v : Array[Int],
  edge_w : Array[Int],
) -> Unit {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) =>
      eq_add_param_edges(tc, e, owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
    TResult(a, b) => {
      eq_add_param_edges(tc, a, owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
      eq_add_param_edges(tc, b, owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        eq_add_param_edges(tc, es[i], owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
        i = i + 1
      }
    }
    TStruct(en, args) => {
      let key = eq_nominal_key(tc, true, en)
      match def_ids.get(key) {
        Some(ed) =>
          if reachable[ed] {
            let mut k = 0
            while k < args.length() && k < def_tparams[ed].length() {
              match args[k] {
                TParam(p) => {
                  let pi = eq_find_tparam_idx(def_tparams[owner_d], p)
                  if pi >= 0 {
                    edge_u.push(node_base[owner_d] + pi)
                    edge_v.push(node_base[ed] + k)
                    edge_w.push(0)
                  }
                }
                _ => {
                  let tps : Array[String] = []
                  ty_collect_tparams(args[k], tps)
                  let mut ti = 0
                  while ti < tps.length() {
                    let pi = eq_find_tparam_idx(def_tparams[owner_d], tps[ti])
                    if pi >= 0 {
                      edge_u.push(node_base[owner_d] + pi)
                      edge_v.push(node_base[ed] + k)
                      edge_w.push(1)
                    }
                    ti = ti + 1
                  }
                }
              }
              if param_used[ed][k] {
                eq_add_param_edges(tc, args[k], owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
              }
              k = k + 1
            }
          }
        None => ()
      }
    }
    TEnum(en, args) => {
      let key = eq_nominal_key(tc, false, en)
      match def_ids.get(key) {
        Some(ed) =>
          if reachable[ed] {
            let mut k = 0
            while k < args.length() && k < def_tparams[ed].length() {
              match args[k] {
                TParam(p) => {
                  let pi = eq_find_tparam_idx(def_tparams[owner_d], p)
                  if pi >= 0 {
                    edge_u.push(node_base[owner_d] + pi)
                    edge_v.push(node_base[ed] + k)
                    edge_w.push(0)
                  }
                }
                _ => {
                  let tps : Array[String] = []
                  ty_collect_tparams(args[k], tps)
                  let mut ti = 0
                  while ti < tps.length() {
                    let pi = eq_find_tparam_idx(def_tparams[owner_d], tps[ti])
                    if pi >= 0 {
                      edge_u.push(node_base[owner_d] + pi)
                      edge_v.push(node_base[ed] + k)
                      edge_w.push(1)
                    }
                    ti = ti + 1
                  }
                }
              }
              if param_used[ed][k] {
                eq_add_param_edges(tc, args[k], owner_d, def_ids, def_tparams, param_used, reachable, node_base, edge_u, edge_v, edge_w)
              }
              k = k + 1
            }
          }
        None => ()
      }
    }
    _ => ()
  }
}

///|
/// Decides whether expanding structural equality from `root_ty` hits an
/// expansive (non-regular) polymorphic recursion cycle that would require
/// infinitely many distinct monomorphized instantiations.
/// Uses exact parameter-usage liveness + Bellman-Ford positive-weight cycle detection.
fn eq_has_expansive_cycle(
  tc : TypeChecker,
  root_ty : Ty,
  only_derive_eq : Bool,
) -> Bool {
  // Phase 1: Load closure of candidate nominal definitions reachable syntactically from root_ty.
  let def_ids : Map[String, Int] = Map([])
  let def_is_struct : Array[Bool] = []
  let def_names : Array[String] = []
  let def_tparams : Array[Array[String]] = []
  let def_fields : Array[Array[Ty]] = []
  eq_enqueue_nominals_in_ty(tc, root_ty, def_ids, def_is_struct, def_names)
  let mut qi = 0
  while qi < def_names.length() {
    let is_st = def_is_struct[qi]
    let dname = def_names[qi]
    if is_st {
      match tc_lookup_builtin_eq_impl(tc, dname) {
        Some(iinfo) => {
          def_tparams.push(iinfo.target_param_names)
          let flds : Array[Ty] = []
          let mut pi = 0
          while pi < iinfo.target_param_names.length() && pi < iinfo.target_param_bounds.length() {
            if str_arr_contains(iinfo.target_param_bounds[pi], "@builtin:Eq") {
              flds.push(TParam(iinfo.target_param_names[pi]))
            }
            pi = pi + 1
          }
          def_fields.push(flds)
        }
        None =>
          match tc_lookup_struct_info(tc, dname) {
            Some(sinfo) =>
              if !only_derive_eq || sinfo.decl.derive_eq {
                def_tparams.push(sinfo.decl.type_params)
                def_fields.push(sinfo.field_tys)
                let mut fi = 0
                while fi < sinfo.field_tys.length() {
                  eq_enqueue_nominals_in_ty(tc, sinfo.field_tys[fi], def_ids, def_is_struct, def_names)
                  fi = fi + 1
                }
              } else {
                def_tparams.push([])
                def_fields.push([])
              }
            None => {
              def_tparams.push([])
              def_fields.push([])
            }
          }
      }
    } else {
      match tc_lookup_builtin_eq_impl(tc, dname) {
        Some(iinfo) => {
          def_tparams.push(iinfo.target_param_names)
          let flds : Array[Ty] = []
          let mut pi = 0
          while pi < iinfo.target_param_names.length() && pi < iinfo.target_param_bounds.length() {
            if str_arr_contains(iinfo.target_param_bounds[pi], "@builtin:Eq") {
              flds.push(TParam(iinfo.target_param_names[pi]))
            }
            pi = pi + 1
          }
          def_fields.push(flds)
        }
        None =>
          match tc_lookup_enum_info_qualified(tc, dname) {
            Some(einfo) =>
              if !only_derive_eq || einfo.decl.derive_eq {
                def_tparams.push(einfo.decl.type_params)
                let flds : Array[Ty] = []
                let mut vi = 0
                while vi < einfo.variants.length() {
                  let v = einfo.variants[vi]
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    flds.push(v.field_tys[fi])
                    eq_enqueue_nominals_in_ty(tc, v.field_tys[fi], def_ids, def_is_struct, def_names)
                    fi = fi + 1
                  }
                  vi = vi + 1
                }
                def_fields.push(flds)
              } else {
                def_tparams.push([])
                def_fields.push([])
              }
            None => {
              def_tparams.push([])
              def_fields.push([])
            }
          }
      }
    }
    qi = qi + 1
  }
  let num_defs = def_names.length()
  if num_defs == 0 {
    return false
  }

  // Phase 2: Monotone least fixed point for param_used[d][k] (true iff Eq(d[...]) enters arg k).
  let param_used : Array[Array[Bool]] = []
  let mut di = 0
  while di < num_defs {
    let row : Array[Bool] = []
    let mut k = 0
    while k < def_tparams[di].length() {
      row.push(false)
      k = k + 1
    }
    param_used.push(row)
    di = di + 1
  }
  let changed : Array[Bool] = [true]
  while changed[0] {
    changed[0] = false
    let mut d = 0
    while d < num_defs {
      let mut fi = 0
      while fi < def_fields[d].length() {
        eq_mark_used_in_ty(tc, def_fields[d][fi], def_ids, def_tparams, param_used, d, changed)
        fi = fi + 1
      }
      d = d + 1
    }
  }

  // Phase 3: Compute truly Eq-reachable definitions from root_ty (respecting param_used).
  let reachable : Array[Bool] = []
  let mut ri = 0
  while ri < num_defs {
    reachable.push(false)
    ri = ri + 1
  }
  let reach_queue : Array[Int] = []
  eq_mark_reachable_in_ty(tc, root_ty, def_ids, param_used, reachable, reach_queue)
  let mut rqi = 0
  while rqi < reach_queue.length() {
    let d = reach_queue[rqi]
    let mut fi = 0
    while fi < def_fields[d].length() {
      eq_mark_reachable_in_ty(tc, def_fields[d][fi], def_ids, param_used, reachable, reach_queue)
      fi = fi + 1
    }
    rqi = rqi + 1
  }

  // Phase 4: Build weighted parameter dependency graph on reachable definitions + Bellman-Ford.
  let node_base : Array[Int] = []
  let mut total_v = 0
  let mut bi = 0
  while bi < num_defs {
    if reachable[bi] {
      node_base.push(total_v)
      total_v = total_v + def_tparams[bi].length()
    } else {
      node_base.push(-1)
    }
    bi = bi + 1
  }
  if total_v == 0 {
    return false
  }
  let edge_u : Array[Int] = []
  let edge_v : Array[Int] = []
  let edge_w : Array[Int] = []
  let mut gd = 0
  while gd < num_defs {
    if reachable[gd] {
      let mut fi = 0
      while fi < def_fields[gd].length() {
        eq_add_param_edges(
          tc,
          def_fields[gd][fi],
          gd,
          def_ids,
          def_tparams,
          param_used,
          reachable,
          node_base,
          edge_u,
          edge_v,
          edge_w,
        )
        fi = fi + 1
      }
    }
    gd = gd + 1
  }
  if edge_u.length() == 0 {
    return false
  }
  let dist : Array[Int] = []
  let mut vi = 0
  while vi < total_v {
    dist.push(0)
    vi = vi + 1
  }
  let mut round = 0
  while round < total_v {
    let mut any_relaxed = false
    let mut ei = 0
    while ei < edge_u.length() {
      let u = edge_u[ei]
      let v = edge_v[ei]
      let w = edge_w[ei]
      if dist[u] + w > dist[v] {
        dist[v] = dist[u] + w
        any_relaxed = true
      }
      ei = ei + 1
    }
    if !any_relaxed {
      return false
    }
    if round == total_v - 1 {
      return true
    }
    round = round + 1
  }
  false
}

///|
fn collect_eq_tparams_rec(
  tc : TypeChecker,
  t : Ty,
  out : Array[String],
  visited : Map[String, Bool],
) -> Unit {
  match t {
    TParam(n) =>
      if !str_arr_contains(out, n) {
        out.push(n)
      }
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) =>
      collect_eq_tparams_rec(tc, e, out, visited)
    TResult(a, b) => {
      collect_eq_tparams_rec(tc, a, out, visited)
      collect_eq_tparams_rec(tc, b, out, visited)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        collect_eq_tparams_rec(tc, es[i], out, visited)
        i = i + 1
      }
    }
    TStruct(name, sargs) => {
      let key = ty_to_string(t)
      if visited.contains(key) {
        return
      }
      visited.set(key, true)
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let mut i = 0
          while i < sargs.length() && i < iinfo.target_param_bounds.length() {
            if str_arr_contains(iinfo.target_param_bounds[i], "@builtin:Eq") {
              collect_eq_tparams_rec(tc, sargs[i], out, visited)
            }
            i = i + 1
          }
          return
        }
        None => ()
      }
      match tc_lookup_struct_info(tc, name) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            collect_eq_tparams_rec(tc, subst_ty(sinfo.field_tys[fi], subst), out, visited)
            fi = fi + 1
          }
        }
        None => {
          let mut i = 0
          while i < sargs.length() {
            collect_eq_tparams_rec(tc, sargs[i], out, visited)
            i = i + 1
          }
        }
      }
    }
    TEnum(name, eargs) => {
      let key = ty_to_string(t)
      if visited.contains(key) {
        return
      }
      visited.set(key, true)
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let mut i = 0
          while i < eargs.length() && i < iinfo.target_param_bounds.length() {
            if str_arr_contains(iinfo.target_param_bounds[i], "@builtin:Eq") {
              collect_eq_tparams_rec(tc, eargs[i], out, visited)
            }
            i = i + 1
          }
          return
        }
        None => ()
      }
      match tc_lookup_enum_info_qualified(tc, name) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              collect_eq_tparams_rec(tc, subst_ty(v.field_tys[fi], subst), out, visited)
              fi = fi + 1
            }
            vi = vi + 1
          }
        }
        None => {
          let mut i = 0
          while i < eargs.length() {
            collect_eq_tparams_rec(tc, eargs[i], out, visited)
            i = i + 1
          }
        }
      }
    }
    _ => ()
  }
}

///|
fn collect_eq_tparams_in_ty(
  tc : TypeChecker,
  t : Ty,
  out : Array[String],
  visited : Map[String, Bool],
) -> Unit {
  if ty_has_nominal(t) && eq_has_expansive_cycle(tc, t, false) {
    ty_collect_tparams(t, out)
    return
  }
  collect_eq_tparams_rec(tc, t, out, visited)
}

///|
fn ty_top_is_concrete(t : Ty) -> Bool {
  match t {
    TParam(_) | TError | TNever => false
    _ => true
  }
}

///|
fn map_key_ob_add(tc : TypeChecker, fn_key : String, k : Ty) -> Bool {
  if fn_key == "" || !ty_has_tparam(k) {
    return false
  }
  let ks = ty_to_string(k)
  match tc.map_key_obligations.get(fn_key) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if ty_to_string(arr[i]) == ks {
          return false
        }
        i = i + 1
      }
      arr.push(k)
      true
    }
    None => {
      tc.map_key_obligations.set(fn_key, [k])
      tc.map_key_ob_keys.push(fn_key)
      true
    }
  }
}

///|
fn eq_trait_ob_add(tc : TypeChecker, fn_key : String, ob : TraitObligation) -> Bool {
  if fn_key == "" {
    return false
  }
  let ks = ob.trait_name + "|" + ty_to_string(ob.target_ty)
  match tc.eq_trait_obligations.get(fn_key) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if arr[i].trait_name + "|" + ty_to_string(arr[i].target_ty) == ks {
          return false
        }
        i = i + 1
      }
      arr.push(ob)
      true
    }
    None => {
      tc.eq_trait_obligations.set(fn_key, [ob])
      tc.eq_trait_ob_keys.push(fn_key)
      true
    }
  }
}

///|
fn tc_map_key_depends_on_tparam(
  tc : TypeChecker,
  k : Ty,
  active : Map[String, Bool],
  memo : Map[String, Bool],
  hit_cycle : Array[Bool],
) -> Bool {
  match k {
    TParam(_) => true
    TArray(e) | TImmArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      tc_map_key_depends_on_tparam(tc, e, active, memo, hit_cycle)
    TResult(a, b) | TMap(a, b) =>
      tc_map_key_depends_on_tparam(tc, a, active, memo, hit_cycle) ||
      tc_map_key_depends_on_tparam(tc, b, active, memo, hit_cycle)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if tc_map_key_depends_on_tparam(tc, es[i], active, memo, hit_cycle) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, ret) => {
      let mut i = 0
      while i < ps.length() {
        if tc_map_key_depends_on_tparam(tc, ps[i], active, memo, hit_cycle) {
          return true
        }
        i = i + 1
      }
      tc_map_key_depends_on_tparam(tc, ret, active, memo, hit_cycle)
    }
    TStruct(name, args) => {
      let mask_sb = StringBuilder()
      let abs_args : Array[Ty] = []
      let mut mi = 0
      while mi < args.length() {
        if tc_map_key_depends_on_tparam(tc, args[mi], active, memo, hit_cycle) {
          mask_sb.write_string("1")
          abs_args.push(TParam("__p"))
        } else {
          mask_sb.write_string("0")
          abs_args.push(TInt)
        }
        mi = mi + 1
      }
      let dk = "S:" + name + "|" + mask_sb.to_string()
      match memo.get(dk) {
        Some(v) => return v
        None => ()
      }
      if active.contains(dk) {
        hit_cycle[0] = true
        return false
      }
      active.set(dk, true)
      let prev_cyc = hit_cycle[0]
      hit_cycle[0] = false
      let mut res = false
      match tc_lookup_struct_info(tc, name) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, abs_args)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if tc_map_key_depends_on_tparam(tc, subst_ty(sinfo.field_tys[fi], subst), active, memo, hit_cycle) {
              res = true
              break
            }
            fi = fi + 1
          }
        }
        None => ()
      }
      active.remove(dk)
      if res || !hit_cycle[0] {
        memo.set(dk, res)
      }
      if res {
        hit_cycle[0] = prev_cyc
      } else {
        hit_cycle[0] = prev_cyc || hit_cycle[0]
      }
      res
    }
    TEnum(name, args) => {
      let mask_sb = StringBuilder()
      let abs_args : Array[Ty] = []
      let mut mi = 0
      while mi < args.length() {
        if tc_map_key_depends_on_tparam(tc, args[mi], active, memo, hit_cycle) {
          mask_sb.write_string("1")
          abs_args.push(TParam("__p"))
        } else {
          mask_sb.write_string("0")
          abs_args.push(TInt)
        }
        mi = mi + 1
      }
      let dk = "E:" + name + "|" + mask_sb.to_string()
      match memo.get(dk) {
        Some(v) => return v
        None => ()
      }
      if active.contains(dk) {
        hit_cycle[0] = true
        return false
      }
      active.set(dk, true)
      let prev_cyc = hit_cycle[0]
      hit_cycle[0] = false
      let mut res = false
      match tc_lookup_enum_info_qualified(tc, name) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, abs_args)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if tc_map_key_depends_on_tparam(tc, subst_ty(v.field_tys[fi], subst), active, memo, hit_cycle) {
                res = true
                break
              }
              fi = fi + 1
            }
            if res {
              break
            }
            vi = vi + 1
          }
        }
        None => ()
      }
      active.remove(dk)
      if res || !hit_cycle[0] {
        memo.set(dk, res)
      }
      if res {
        hit_cycle[0] = prev_cyc
      } else {
        hit_cycle[0] = prev_cyc || hit_cycle[0]
      }
      res
    }
    _ => false
  }
}

///|
fn tc_ty_mentions_param_map_rec(tc : TypeChecker, t : Ty, seen_defs : Map[String, Bool]) -> Bool {
  match t {
    TMap(k, v) =>
      tc_map_key_depends_on_tparam(tc, k, Map([]), Map([]), [false]) ||
      tc_ty_mentions_param_map_rec(tc, k, seen_defs) ||
      tc_ty_mentions_param_map_rec(tc, v, seen_defs)
    TArray(e) | TImmArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      tc_ty_mentions_param_map_rec(tc, e, seen_defs)
    TResult(a, b) =>
      tc_ty_mentions_param_map_rec(tc, a, seen_defs) || tc_ty_mentions_param_map_rec(tc, b, seen_defs)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if tc_ty_mentions_param_map_rec(tc, es[i], seen_defs) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, ret) => {
      let mut i = 0
      while i < ps.length() {
        if tc_ty_mentions_param_map_rec(tc, ps[i], seen_defs) {
          return true
        }
        i = i + 1
      }
      tc_ty_mentions_param_map_rec(tc, ret, seen_defs)
    }
    TStruct(name, args) => {
      let mut i = 0
      while i < args.length() {
        if tc_ty_mentions_param_map_rec(tc, args[i], seen_defs) {
          return true
        }
        i = i + 1
      }
      let mask_sb = StringBuilder()
      let abs_args : Array[Ty] = []
      let mut mi = 0
      while mi < args.length() {
        if ty_has_tparam(args[mi]) {
          mask_sb.write_string("1")
          abs_args.push(TParam("__p"))
        } else {
          mask_sb.write_string("0")
          abs_args.push(TInt)
        }
        mi = mi + 1
      }
      let dk = "S:" + name + "|" + mask_sb.to_string()
      if seen_defs.contains(dk) {
        return false
      }
      seen_defs.set(dk, true)
      match tc_lookup_struct_info(tc, name) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, abs_args)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if tc_ty_mentions_param_map_rec(tc, subst_ty(sinfo.field_tys[fi], subst), seen_defs) {
              return true
            }
            fi = fi + 1
          }
          false
        }
        None => false
      }
    }
    TEnum(name, args) => {
      let mut i = 0
      while i < args.length() {
        if tc_ty_mentions_param_map_rec(tc, args[i], seen_defs) {
          return true
        }
        i = i + 1
      }
      let mask_sb = StringBuilder()
      let abs_args : Array[Ty] = []
      let mut mi = 0
      while mi < args.length() {
        if ty_has_tparam(args[mi]) {
          mask_sb.write_string("1")
          abs_args.push(TParam("__p"))
        } else {
          mask_sb.write_string("0")
          abs_args.push(TInt)
        }
        mi = mi + 1
      }
      let dk = "E:" + name + "|" + mask_sb.to_string()
      if seen_defs.contains(dk) {
        return false
      }
      seen_defs.set(dk, true)
      match tc_lookup_enum_info_qualified(tc, name) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, abs_args)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if tc_ty_mentions_param_map_rec(tc, subst_ty(v.field_tys[fi], subst), seen_defs) {
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          false
        }
        None => false
      }
    }
    _ => false
  }
}

///|
fn tc_expansive_def_mentions_param_map(tc : TypeChecker, is_struct : Bool, name : String) -> Bool {
  if !tc.expansive_ready {
    tc_build_expansive_cache(tc)
  }
  let dk_base = eq_nominal_key(tc, is_struct, name)
  let seen_defs : Map[String, Bool] = Map([])
  if is_struct {
    match tc_lookup_struct_info(tc, name) {
      Some(sinfo) => {
        let mask_sb = StringBuilder()
        let abs_args : Array[Ty] = []
        let mut mi = 0
        while mi < sinfo.decl.type_params.length() {
          if tc.expansive_params.contains(dk_base + "#" + mi.to_string()) {
            mask_sb.write_string("1")
            abs_args.push(TParam("__p"))
          } else {
            mask_sb.write_string("0")
            abs_args.push(TInt)
          }
          mi = mi + 1
        }
        seen_defs.set("S:" + name + "|" + mask_sb.to_string(), true)
        let subst = make_subst(sinfo.decl.type_params, abs_args)
        let mut fi = 0
        while fi < sinfo.field_tys.length() {
          if tc_ty_mentions_param_map_rec(tc, subst_ty(sinfo.field_tys[fi], subst), seen_defs) {
            return true
          }
          fi = fi + 1
        }
        false
      }
      None => false
    }
  } else {
    match tc_lookup_enum_info_qualified(tc, name) {
      Some(einfo) => {
        let mask_sb = StringBuilder()
        let abs_args : Array[Ty] = []
        let mut mi = 0
        while mi < einfo.decl.type_params.length() {
          if tc.expansive_params.contains(dk_base + "#" + mi.to_string()) {
            mask_sb.write_string("1")
            abs_args.push(TParam("__p"))
          } else {
            mask_sb.write_string("0")
            abs_args.push(TInt)
          }
          mi = mi + 1
        }
        seen_defs.set("E:" + name + "|" + mask_sb.to_string(), true)
        let subst = make_subst(einfo.decl.type_params, abs_args)
        let mut vi = 0
        while vi < einfo.variants.length() {
          let v = einfo.variants[vi]
          let mut fi = 0
          while fi < v.field_tys.length() {
            if tc_ty_mentions_param_map_rec(tc, subst_ty(v.field_tys[fi], subst), seen_defs) {
              return true
            }
            fi = fi + 1
          }
          vi = vi + 1
        }
        false
      }
      None => false
    }
  }
}

///|
fn tc_add_all_param_edges(
  tc : TypeChecker,
  t : Ty,
  owner_d : Int,
  def_ids : Map[String, Int],
  def_tparams : Array[Array[String]],
  node_base : Array[Int],
  edge_u : Array[Int],
  edge_v : Array[Int],
  edge_w : Array[Int],
) -> Unit {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      tc_add_all_param_edges(tc, e, owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
    TResult(a, b) | TMap(a, b) => {
      tc_add_all_param_edges(tc, a, owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
      tc_add_all_param_edges(tc, b, owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        tc_add_all_param_edges(tc, es[i], owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
        i = i + 1
      }
    }
    TFn(ps, ret) => {
      let mut i = 0
      while i < ps.length() {
        tc_add_all_param_edges(tc, ps[i], owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
        i = i + 1
      }
      tc_add_all_param_edges(tc, ret, owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
    }
    TStruct(name, args) => {
      let key = eq_nominal_key(tc, true, name)
      match def_ids.get(key) {
        Some(td) => {
          let mut j = 0
          while j < args.length() && j < def_tparams[td].length() {
            match args[j] {
              TParam(pn) => {
                let pi = eq_find_tparam_idx(def_tparams[owner_d], pn)
                if pi >= 0 {
                  edge_u.push(node_base[owner_d] + pi)
                  edge_v.push(node_base[td] + j)
                  edge_w.push(0)
                }
              }
              _ => {
                let tps : Array[String] = []
                ty_collect_tparams(args[j], tps)
                let mut ti = 0
                while ti < tps.length() {
                  let pi = eq_find_tparam_idx(def_tparams[owner_d], tps[ti])
                  if pi >= 0 {
                    edge_u.push(node_base[owner_d] + pi)
                    edge_v.push(node_base[td] + j)
                    edge_w.push(1)
                  }
                  ti = ti + 1
                }
              }
            }
            tc_add_all_param_edges(tc, args[j], owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
            j = j + 1
          }
        }
        None => ()
      }
    }
    TEnum(name, args) => {
      let key = eq_nominal_key(tc, false, name)
      match def_ids.get(key) {
        Some(td) => {
          let mut j = 0
          while j < args.length() && j < def_tparams[td].length() {
            match args[j] {
              TParam(pn) => {
                let pi = eq_find_tparam_idx(def_tparams[owner_d], pn)
                if pi >= 0 {
                  edge_u.push(node_base[owner_d] + pi)
                  edge_v.push(node_base[td] + j)
                  edge_w.push(0)
                }
              }
              _ => {
                let tps : Array[String] = []
                ty_collect_tparams(args[j], tps)
                let mut ti = 0
                while ti < tps.length() {
                  let pi = eq_find_tparam_idx(def_tparams[owner_d], tps[ti])
                  if pi >= 0 {
                    edge_u.push(node_base[owner_d] + pi)
                    edge_v.push(node_base[td] + j)
                    edge_w.push(1)
                  }
                  ti = ti + 1
                }
              }
            }
            tc_add_all_param_edges(tc, args[j], owner_d, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
            j = j + 1
          }
        }
        None => ()
      }
    }
    _ => ()
  }
}

///|
/// Builds `tc.expansive_defs` once in O(V + E) using iterative Tarjan SCC on
/// the static type-parameter flow graph across all structs/enums in `tc`.
/// A nominal definition is expansive iff any of its type-parameter vertices
/// belongs to an SCC containing a 1-weight (compound-wrapped) edge.
fn tc_build_expansive_cache(tc : TypeChecker) -> Unit {
  tc.expansive_defs.clear()
  tc.expansive_params.clear()
  let def_ids : Map[String, Int] = Map([])
  let def_is_struct : Array[Bool] = []
  let def_names : Array[String] = []
  let def_keys : Array[String] = []
  let def_tparams : Array[Array[String]] = []
  let def_fields : Array[Array[Ty]] = []
  let mut si = 0
  while si < tc.struct_names.length() {
    let sn = tc.struct_names[si]
    let sk = eq_nominal_key(tc, true, sn)
    if !def_ids.contains(sk) {
      def_ids.set(sk, def_names.length())
      def_is_struct.push(true)
      def_names.push(eq_canonical_nominal_name(tc, true, sn))
    }
    si = si + 1
  }
  let mut ei = 0
  while ei < tc.enum_names.length() {
    let en = tc.enum_names[ei]
    let ek = eq_nominal_key(tc, false, en)
    if !def_ids.contains(ek) {
      def_ids.set(ek, def_names.length())
      def_is_struct.push(false)
      def_names.push(eq_canonical_nominal_name(tc, false, en))
    }
    ei = ei + 1
  }
  let mut qi = 0
  while qi < def_names.length() {
    let is_st = def_is_struct[qi]
    let dname = def_names[qi]
    def_keys.push(if is_st { "S:" + dname } else { "E:" + dname })
    if is_st {
      match tc_lookup_struct_info(tc, dname) {
        Some(sinfo) => {
          def_tparams.push(sinfo.decl.type_params)
          def_fields.push(sinfo.field_tys)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            eq_enqueue_nominals_in_ty(tc, sinfo.field_tys[fi], def_ids, def_is_struct, def_names)
            fi = fi + 1
          }
        }
        None => {
          def_tparams.push([])
          def_fields.push([])
        }
      }
    } else {
      match tc_lookup_enum_info_qualified(tc, dname) {
        Some(einfo) => {
          def_tparams.push(einfo.decl.type_params)
          let all_f : Array[Ty] = []
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              all_f.push(v.field_tys[fi])
              eq_enqueue_nominals_in_ty(tc, v.field_tys[fi], def_ids, def_is_struct, def_names)
              fi = fi + 1
            }
            vi = vi + 1
          }
          def_fields.push(all_f)
        }
        None => {
          def_tparams.push([])
          def_fields.push([])
        }
      }
    }
    qi = qi + 1
  }
  let node_base : Array[Int] = []
  let node_def_key : Array[String] = []
  let node_param_idx : Array[Int] = []
  let mut total_v = 0
  let mut di = 0
  while di < def_names.length() {
    node_base.push(total_v)
    let mut pi = 0
    while pi < def_tparams[di].length() {
      node_def_key.push(def_keys[di])
      node_param_idx.push(pi)
      total_v = total_v + 1
      pi = pi + 1
    }
    di = di + 1
  }
  if total_v == 0 {
    tc.expansive_ready = true
    return
  }
  let edge_u : Array[Int] = []
  let edge_v : Array[Int] = []
  let edge_w : Array[Int] = []
  di = 0
  while di < def_names.length() {
    let mut fi = 0
    while fi < def_fields[di].length() {
      tc_add_all_param_edges(tc, def_fields[di][fi], di, def_ids, def_tparams, node_base, edge_u, edge_v, edge_w)
      fi = fi + 1
    }
    di = di + 1
  }
  let adj : Array[Array[Int]] = []
  let disc : Array[Int] = []
  let low : Array[Int] = []
  let on_stk : Array[Bool] = []
  let comp : Array[Int] = []
  let mut vi = 0
  while vi < total_v {
    adj.push([])
    disc.push(-1)
    low.push(0)
    on_stk.push(false)
    comp.push(-1)
    vi = vi + 1
  }
  let mut k = 0
  while k < edge_u.length() {
    adj[edge_u[k]].push(edge_v[k])
    k = k + 1
  }
  // Iterative Tarjan SCC: O(V + E), zero recursion-stack limit.
  let tarjan_stk : Array[Int] = []
  let dfs_v : Array[Int] = []
  let dfs_ei : Array[Int] = []
  let mut next_disc = 0
  let mut num_comp = 0
  let mut start = 0
  while start < total_v {
    if disc[start] < 0 {
      disc[start] = next_disc
      low[start] = next_disc
      next_disc = next_disc + 1
      tarjan_stk.push(start)
      on_stk[start] = true
      dfs_v.push(start)
      dfs_ei.push(0)
      while dfs_v.length() > 0 {
        let top = dfs_v.length() - 1
        let u = dfs_v[top]
        let idx = dfs_ei[top]
        if idx < adj[u].length() {
          dfs_ei[top] = idx + 1
          let w = adj[u][idx]
          if disc[w] < 0 {
            disc[w] = next_disc
            low[w] = next_disc
            next_disc = next_disc + 1
            tarjan_stk.push(w)
            on_stk[w] = true
            dfs_v.push(w)
            dfs_ei.push(0)
          } else if on_stk[w] && disc[w] < low[u] {
            low[u] = disc[w]
          }
        } else {
          let _ = dfs_v.pop()
          let _ = dfs_ei.pop()
          if low[u] == disc[u] {
            let cid = num_comp
            num_comp = num_comp + 1
            while tarjan_stk.length() > 0 {
              match tarjan_stk.pop() {
                Some(x) => {
                  on_stk[x] = false
                  comp[x] = cid
                  if x == u {
                    break
                  }
                }
                None => break
              }
            }
          }
          if dfs_v.length() > 0 {
            let p = dfs_v[dfs_v.length() - 1]
            if low[u] < low[p] {
              low[p] = low[u]
            }
          }
        }
      }
    }
    start = start + 1
  }
  let scc_exp : Array[Bool] = []
  let mut ci = 0
  while ci < num_comp {
    scc_exp.push(false)
    ci = ci + 1
  }
  k = 0
  while k < edge_w.length() {
    if edge_w[k] == 1 {
      let cu = comp[edge_u[k]]
      let cv = comp[edge_v[k]]
      if cu >= 0 && cu == cv {
        scc_exp[cu] = true
      }
    }
    k = k + 1
  }
  let node_exp : Array[Bool] = []
  let exp_q : Array[Int] = []
  vi = 0
  while vi < total_v {
    let c = comp[vi]
    if c >= 0 && scc_exp[c] {
      tc.expansive_defs.set(node_def_key[vi], true)
      node_exp.push(true)
      exp_q.push(vi)
    } else {
      node_exp.push(false)
    }
    vi = vi + 1
  }
  // Propagate expansiveness forward along parameter-flow edges in O(V + E),
  // but ONLY record `expansive_params` for defs already in `tc.expansive_defs`
  // (i.e. defs owning a vertex in a 1-weight SCC). Acyclic/finite downstream
  // defs (e.g. `G[A, B]` referenced by an unused expansive `N[U]`) are never
  // polluted into `tc.expansive_defs`.
  let mut qh = 0
  while qh < exp_q.length() {
    let u = exp_q[qh]
    qh = qh + 1
    let mut ei2 = 0
    while ei2 < adj[u].length() {
      let w = adj[u][ei2]
      if !node_exp[w] {
        node_exp[w] = true
        exp_q.push(w)
      }
      ei2 = ei2 + 1
    }
  }
  vi = 0
  while vi < total_v {
    if node_exp[vi] && tc.expansive_defs.contains(node_def_key[vi]) {
      tc.expansive_params.set(node_def_key[vi] + "#" + node_param_idx[vi].to_string(), true)
    }
    vi = vi + 1
  }
  tc.expansive_ready = true
}

///|
fn ty_ast_size(t : Ty) -> Int {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      1 + ty_ast_size(e)
    TResult(a, b) | TMap(a, b) => 1 + ty_ast_size(a) + ty_ast_size(b)
    TTuple(es) => {
      let mut s = 1
      let mut i = 0
      while i < es.length() {
        s = s + ty_ast_size(es[i])
        i = i + 1
      }
      s
    }
    TFn(ps, ret) => {
      let mut s = 1 + ty_ast_size(ret)
      let mut i = 0
      while i < ps.length() {
        s = s + ty_ast_size(ps[i])
        i = i + 1
      }
      s
    }
    TStruct(_, args) | TEnum(_, args) => {
      let mut s = 1
      let mut i = 0
      while i < args.length() {
        s = s + ty_ast_size(args[i])
        i = i + 1
      }
      s
    }
    _ => 1
  }
}

///|
fn tc_expansive_proj_key(tc : TypeChecker, is_struct : Bool, name : String, args : Array[Ty]) -> String {
  if !tc.expansive_ready {
    tc_build_expansive_cache(tc)
  }
  let dk_base = eq_nominal_key(tc, is_struct, name)
  let sb = StringBuilder()
  sb.write_string(dk_base)
  sb.write_string("[")
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      sb.write_string(",")
    }
    if tc.expansive_params.contains(dk_base + "#" + i.to_string()) {
      sb.write_string("__exp")
    } else {
      sb.write_string(ty_to_string(args[i]))
    }
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
fn tc_def_is_expansive(tc : TypeChecker, root_is_struct : Bool, root_name : String) -> Bool {
  if !tc.expansive_ready {
    tc_build_expansive_cache(tc)
  }
  tc.expansive_defs.contains(eq_nominal_key(tc, root_is_struct, root_name))
}

///|
fn collect_eq_trait_obligations_rec(
  tc : TypeChecker,
  t : Ty,
  out_obs : Array[TraitObligation],
  visited : Map[String, Bool],
) -> Unit {
  match t {
    TImmArray(e) | TArray(e) | TFixedArray(e) | TOption(e) =>
      collect_eq_trait_obligations_rec(tc, e, out_obs, visited)
    TResult(a, b) => {
      collect_eq_trait_obligations_rec(tc, a, out_obs, visited)
      collect_eq_trait_obligations_rec(tc, b, out_obs, visited)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        collect_eq_trait_obligations_rec(tc, es[i], out_obs, visited)
        i = i + 1
      }
    }
    TStruct(name, sargs) => {
      let key = ty_to_string(t)
      if visited.contains(key) {
        return
      }
      visited.set(key, true)
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let mut i = 0
          while i < sargs.length() && i < iinfo.target_param_bounds.length() {
            let btrs = iinfo.target_param_bounds[i]
            let mut bi = 0
            while bi < btrs.length() {
              let tr = btrs[bi]
              if tr == "@builtin:Eq" {
                collect_eq_trait_obligations_rec(tc, sargs[i], out_obs, visited)
              } else {
                out_obs.push(TraitObligation::{ target_ty: sargs[i], trait_name: tr })
              }
              bi = bi + 1
            }
            i = i + 1
          }
          return
        }
        None => ()
      }
      match tc_lookup_struct_info(tc, name) {
        Some(sinfo) =>
          if sinfo.decl.derive_eq {
            let subst = make_subst(sinfo.decl.type_params, sargs)
            let mut fi = 0
            while fi < sinfo.field_tys.length() {
              collect_eq_trait_obligations_rec(tc, subst_ty(sinfo.field_tys[fi], subst), out_obs, visited)
              fi = fi + 1
            }
          }
        None => ()
      }
    }
    TEnum(name, eargs) => {
      let key = ty_to_string(t)
      if visited.contains(key) {
        return
      }
      visited.set(key, true)
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let mut i = 0
          while i < eargs.length() && i < iinfo.target_param_bounds.length() {
            let btrs = iinfo.target_param_bounds[i]
            let mut bi = 0
            while bi < btrs.length() {
              let tr = btrs[bi]
              if tr == "@builtin:Eq" {
                collect_eq_trait_obligations_rec(tc, eargs[i], out_obs, visited)
              } else {
                out_obs.push(TraitObligation::{ target_ty: eargs[i], trait_name: tr })
              }
              bi = bi + 1
            }
            i = i + 1
          }
          return
        }
        None => ()
      }
      match tc_lookup_enum_info_qualified(tc, name) {
        Some(einfo) =>
          if einfo.decl.derive_eq {
            let subst = make_subst(einfo.decl.type_params, eargs)
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                collect_eq_trait_obligations_rec(tc, subst_ty(v.field_tys[fi], subst), out_obs, visited)
                fi = fi + 1
              }
              vi = vi + 1
            }
          }
        None => ()
      }
    }
    _ => ()
  }
}

///|
fn record_eq_trait_obligations(tc : TypeChecker, fn_key : String, t : Ty) -> Bool {
  if fn_key == "" {
    return false
  }
  if ty_has_nominal(t) && eq_has_expansive_cycle(tc, t, true) {
    return false
  }
  let obs : Array[TraitObligation] = []
  collect_eq_trait_obligations_rec(tc, t, obs, Map([]))
  let mut added = false
  let mut i = 0
  while i < obs.length() {
    if ty_has_tparam(obs[i].target_ty) {
      if eq_trait_ob_add(tc, fn_key, obs[i]) {
        added = true
      }
    }
    i = i + 1
  }
  added
}

///|
fn record_map_key_tparams(tc : TypeChecker, fn_key : String, k : Ty) -> Unit {
  if fn_key == "" {
    return
  }
  if ty_has_tparam(k) {
    let _ = map_key_ob_add(tc, fn_key, k)
  }
}

///|
fn record_map_key_tparams_in_ty_rec(
  tc : TypeChecker,
  fn_key : String,
  t : Ty,
  visited : Map[String, Bool],
  active_exp_sz : Map[String, Int],
) -> Unit {
  if fn_key == "" {
    return
  }
  match t {
    TMap(k, v) => {
      record_map_key_tparams(tc, fn_key, k)
      record_map_key_tparams_in_ty_rec(tc, fn_key, k, visited, active_exp_sz)
      record_map_key_tparams_in_ty_rec(tc, fn_key, v, visited, active_exp_sz)
    }
    TArray(e) | TImmArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      record_map_key_tparams_in_ty_rec(tc, fn_key, e, visited, active_exp_sz)
    TResult(a, b) => {
      record_map_key_tparams_in_ty_rec(tc, fn_key, a, visited, active_exp_sz)
      record_map_key_tparams_in_ty_rec(tc, fn_key, b, visited, active_exp_sz)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        record_map_key_tparams_in_ty_rec(tc, fn_key, es[i], visited, active_exp_sz)
        i = i + 1
      }
    }
    TFn(ps, ret) => {
      let mut i = 0
      while i < ps.length() {
        record_map_key_tparams_in_ty_rec(tc, fn_key, ps[i], visited, active_exp_sz)
        i = i + 1
      }
      record_map_key_tparams_in_ty_rec(tc, fn_key, ret, visited, active_exp_sz)
    }
    TStruct(name, args) => {
      let mut i = 0
      while i < args.length() {
        record_map_key_tparams_in_ty_rec(tc, fn_key, args[i], visited, active_exp_sz)
        i = i + 1
      }
      if args.length() > 0 {
        let vk = "S:" + ty_to_string(t)
        if !visited.contains(vk) {
          let is_exp = tc_def_is_expansive(tc, true, name)
          let mut pk = ""
          let mut prev_sz = -1
          if is_exp {
            pk = tc_expansive_proj_key(tc, true, name, args)
            let sz = ty_ast_size(t)
            prev_sz = match active_exp_sz.get(pk) {
              Some(v) => v
              None => -1
            }
            if prev_sz >= 0 && sz >= prev_sz {
              return
            }
            active_exp_sz.set(pk, sz)
          }
          visited.set(vk, true)
          match tc_lookup_struct_info(tc, name) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, args)
              let mut fi = 0
              while fi < sinfo.field_tys.length() {
                record_map_key_tparams_in_ty_rec(tc, fn_key, subst_ty(sinfo.field_tys[fi], subst), visited, active_exp_sz)
                fi = fi + 1
              }
            }
            None => ()
          }
          if is_exp {
            if prev_sz >= 0 {
              active_exp_sz.set(pk, prev_sz)
            } else {
              active_exp_sz.remove(pk)
            }
          }
        }
      }
    }
    TEnum(name, args) => {
      let mut i = 0
      while i < args.length() {
        record_map_key_tparams_in_ty_rec(tc, fn_key, args[i], visited, active_exp_sz)
        i = i + 1
      }
      if args.length() > 0 {
        let vk = "E:" + ty_to_string(t)
        if !visited.contains(vk) {
          let is_exp = tc_def_is_expansive(tc, false, name)
          let mut pk = ""
          let mut prev_sz = -1
          if is_exp {
            pk = tc_expansive_proj_key(tc, false, name, args)
            let sz = ty_ast_size(t)
            prev_sz = match active_exp_sz.get(pk) {
              Some(v) => v
              None => -1
            }
            if prev_sz >= 0 && sz >= prev_sz {
              return
            }
            active_exp_sz.set(pk, sz)
          }
          visited.set(vk, true)
          match tc_lookup_enum_info_qualified(tc, name) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, args)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                let mut fi = 0
                while fi < v.field_tys.length() {
                  record_map_key_tparams_in_ty_rec(tc, fn_key, subst_ty(v.field_tys[fi], subst), visited, active_exp_sz)
                  fi = fi + 1
                }
                vi = vi + 1
              }
            }
            None => ()
          }
          if is_exp {
            if prev_sz >= 0 {
              active_exp_sz.set(pk, prev_sz)
            } else {
              active_exp_sz.remove(pk)
            }
          }
        }
      }
    }
    _ => ()
  }
}

///|
fn record_map_key_tparams_in_ty(tc : TypeChecker, fn_key : String, t : Ty) -> Unit {
  record_map_key_tparams_in_ty_rec(tc, fn_key, t, Map([]), Map([]))
}

///|
/// Closes the generic `==` / `!=` check: a type parameter compared in a
/// generic body must be instantiated with a value-comparable type.
/// Requirements propagate through generic callers before reporting.
fn resolve_eq_uses(tc : TypeChecker) -> Unit {
  let max_rounds = tc.eq_uses.length() + 16
  let mut changed = true
  let mut rounds = 0
  while changed && rounds < max_rounds {
    changed = false
    let mut i = 0
    while i < tc.eq_uses.length() {
      let u = tc.eq_uses[i]
      if u.caller_key != "" && eq_tparams_has(tc, u.callee_key, u.tparam) {
        let tps : Array[String] = []
        collect_eq_tparams_in_ty(tc, u.concrete, tps, Map([]))
        let mut ti = 0
        while ti < tps.length() {
          if eq_tparams_add(tc, u.caller_key, tps[ti]) {
            changed = true
          }
          ti = ti + 1
        }
        if record_eq_trait_obligations(tc, u.caller_key, u.concrete) {
          changed = true
        }
      }
      i = i + 1
    }
    rounds = rounds + 1
  }
  let mut v_changed = true
  let mut v_rounds = 0
  while v_changed && v_rounds < max_rounds {
    v_changed = false
    let mut i = 0
    while i < tc.eq_uses.length() {
      let u = tc.eq_uses[i]
      if u.caller_key != "" &&
        !u.callee_is_verify_opaque &&
        verify_eq_tparams_has(tc, u.callee_key, u.tparam) {
        let tps : Array[String] = []
        collect_eq_tparams_in_ty(tc, u.concrete, tps, Map([]))
        let mut ti = 0
        while ti < tps.length() {
          if verify_eq_tparams_add(tc, u.caller_key, tps[ti]) {
            v_changed = true
          }
          ti = ti + 1
        }
      }
      i = i + 1
    }
    v_rounds = v_rounds + 1
  }
  let mut o_changed = true
  let mut o_rounds = 0
  while o_changed && o_rounds < max_rounds {
    o_changed = false
    let mut i = 0
    while i < tc.eq_uses.length() {
      let u = tc.eq_uses[i]
      if u.caller_key != "" {
        match u.concrete {
          TParam(caller_tp) => {
            if op_tparams_has(tc, u.callee_key, "num:" + u.tparam) &&
              op_tparams_add(tc, u.caller_key, "num:" + caller_tp) {
              o_changed = true
            }
            if op_tparams_has(tc, u.callee_key, "add:" + u.tparam) &&
              op_tparams_add(tc, u.caller_key, "add:" + caller_tp) {
              o_changed = true
            }
            if op_tparams_has(tc, u.callee_key, "int:" + u.tparam) &&
              op_tparams_add(tc, u.caller_key, "int:" + caller_tp) {
              o_changed = true
            }
            if op_tparams_has(tc, u.callee_key, "ord:" + u.tparam) &&
              op_tparams_add(tc, u.caller_key, "ord:" + caller_tp) {
              o_changed = true
            }
          }
          _ => ()
        }
      }
      i = i + 1
    }
    o_rounds = o_rounds + 1
  }
  let mut i = 0
  while i < tc.eq_uses.length() {
    let u = tc.eq_uses[i]
    if eq_tparams_has(tc, u.callee_key, u.tparam) && !eq_comparable(tc, u.concrete) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_TYPE_MISMATCH",
        "generic `" +
        u.callee_name +
        "` compares `" +
        u.tparam +
        "` values with `==`/`!=`, but `" +
        u.tparam +
        "` = `" +
        cname +
        "` is not value-comparable (no implicit pointer-identity comparison)",
        "value-comparable type for `" + u.tparam + "`",
        cname,
        "instantiate `" +
        u.callee_name +
        "` with a scalar, `String` or payload-less enum, or compare `" +
        cname +
        "` values with `match`",
      )
    } else if u.caller_is_verify &&
      !u.callee_is_verify_opaque &&
      verify_eq_tparams_has(tc, u.callee_key, u.tparam) &&
      v_has_float_in(tc, u.concrete, []) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_VERIFY_UNSUPPORTED",
        "generic `" +
        u.callee_name +
        "` compares `" +
        u.tparam +
        "` with `==`/`!=`, which is not supported on float-containing type `" +
        cname +
        "` in `#verify`",
        "non-float value-comparable type for `" + u.tparam + "`",
        cname,
        "compare bit patterns (`to_bits()`) or move floating-point equality into a `#verify_opaque` helper",
      )
    } else if u.caller_is_verify &&
      !u.callee_is_verify_opaque &&
      verify_eq_tparams_has(tc, u.callee_key, u.tparam) &&
      v_has_custom_eq_in(tc, u.concrete, []) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_VERIFY_UNSUPPORTED",
        "generic `" +
        u.callee_name +
        "` compares `" +
        u.tparam +
        "` with `==`/`!=`, which is not supported on custom `impl Eq` type `" +
        cname +
        "` in `#verify`",
        "structural `#derive(Eq)` or primitive type for `" + u.tparam + "`",
        cname,
        "move custom `impl Eq` comparisons into a `#verify_opaque` helper",
      )
    }
    if op_tparams_has(tc, u.callee_key, "int:" + u.tparam) && !op_ty_satisfies(tc, "int", u.concrete) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_TYPE_MISMATCH",
        "generic `" +
        u.callee_name +
        "` applies an integer-only operator to `" +
        u.tparam +
        "`, but `" +
        u.tparam +
        "` = `" +
        cname +
        "` is not an integer type",
        "integer type for `" + u.tparam + "`",
        cname,
        "instantiate `" + u.callee_name + "` with an integer type",
      )
    } else if op_tparams_has(tc, u.callee_key, "num:" + u.tparam) && !op_ty_satisfies(tc, "num", u.concrete) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_TYPE_MISMATCH",
        "generic `" +
        u.callee_name +
        "` applies a numeric arithmetic operator to `" +
        u.tparam +
        "`, but `" +
        u.tparam +
        "` = `" +
        cname +
        "` is not a numeric type",
        "numeric type for `" + u.tparam + "`",
        cname,
        "instantiate `" + u.callee_name + "` with a numeric type",
      )
    } else if op_tparams_has(tc, u.callee_key, "add:" + u.tparam) && !op_ty_satisfies(tc, "add", u.concrete) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_TYPE_MISMATCH",
        "generic `" +
        u.callee_name +
        "` applies `+` to `" +
        u.tparam +
        "`, but `" +
        u.tparam +
        "` = `" +
        cname +
        "` is neither a numeric type nor `String`",
        "numeric type or String for `" + u.tparam + "`",
        cname,
        "instantiate `" + u.callee_name + "` with a numeric type or `String`",
      )
    } else if op_tparams_has(tc, u.callee_key, "ord:" + u.tparam) && !op_ty_satisfies(tc, "ord", u.concrete) {
      let cname = ty_to_string(u.concrete)
      tc_err(
        tc,
        u.span,
        "E_TYPE_MISMATCH",
        "generic `" +
        u.callee_name +
        "` compares `" +
        u.tparam +
        "` with `<`/`<=`/`>`/`>=`, but `" +
        u.tparam +
        "` = `" +
        cname +
        "` is not an ordered type",
        "ordered type for `" + u.tparam + "`",
        cname,
        "instantiate `" +
        u.callee_name +
        "` with a numeric type, `Bool`, `Char`, `String`, `StrView`, or a payload-less `enum`",
      )
    }
    i = i + 1
  }
  // Propagate full-Ty Map key obligations and generic `impl Eq` user-trait
  // obligations across generic call sites via `subst_ty` (preserving outer
  // nominal/compound types and ignoring phantom type parameters).
  let max_ob_rounds = tc.generic_call_sites.length() * 4 + 64
  let mut ob_changed = true
  let mut ob_rounds = 0
  while ob_changed && ob_rounds < max_ob_rounds {
    ob_changed = false
    let mut ci = 0
    while ci < tc.generic_call_sites.length() {
      let cs = tc.generic_call_sites[ci]
      if cs.caller_key != "" {
        match tc.map_key_obligations.get(cs.callee_key) {
          Some(ktys) => {
            let mut ki = 0
            while ki < ktys.length() {
              let nk = subst_ty(ktys[ki], cs.subst)
              if ty_has_tparam(nk) && map_key_ob_add(tc, cs.caller_key, nk) {
                ob_changed = true
              }
              ki = ki + 1
            }
          }
          None => ()
        }
        match tc.eq_trait_obligations.get(cs.callee_key) {
          Some(obs) => {
            let mut oi = 0
            while oi < obs.length() {
              let nty = subst_ty(obs[oi].target_ty, cs.subst)
              if ty_has_tparam(nty) &&
                eq_trait_ob_add(tc, cs.caller_key, TraitObligation::{
                  target_ty: nty,
                  trait_name: obs[oi].trait_name,
                }) {
                ob_changed = true
              }
              oi = oi + 1
            }
          }
          None => ()
        }
      }
      ci = ci + 1
    }
    ob_rounds = ob_rounds + 1
  }
  if ob_changed && tc.generic_call_sites.length() > 0 {
    tc_err(
      tc,
      tc.generic_call_sites[0].span,
      "E_TYPE_MISMATCH",
      "generic obligation propagation did not converge (non-regular polymorphic recursion)",
      "regular generic recursion",
      "non-converging generic obligations",
      "break the polymorphic type-argument growth cycle in generic calls",
    )
  }
  let mut ci = 0
  while ci < tc.generic_call_sites.length() {
    let cs = tc.generic_call_sites[ci]
    match tc.map_key_obligations.get(cs.callee_key) {
      Some(ktys) => {
        let mut ki = 0
        while ki < ktys.length() {
          let nk = subst_ty(ktys[ki], cs.subst)
          if !ty_has_tparam(nk) && !is_valid_map_key_ty(tc, nk) {
            let cname = ty_to_string(nk)
            tc_err(
              tc,
              cs.span,
              "E_MAP_KEY_TYPE",
              "generic `" +
              cs.callee_name +
              "` uses `" +
              cname +
              "` as a `Map` key, which is not a valid `Map` key type",
              "String, scalar integer/char/bool, or immutable pure-scalar tuple/struct without custom `impl Eq`",
              cname,
              "instantiate `" + cs.callee_name + "` with a supported `Map` key type without custom `impl Eq`",
            )
          }
          ki = ki + 1
        }
      }
      None => ()
    }
    match tc.eq_trait_obligations.get(cs.callee_key) {
      Some(obs) => {
        let mut oi = 0
        while oi < obs.length() {
          let ob = obs[oi]
          let nty = subst_ty(ob.target_ty, cs.subst)
          if ty_top_is_concrete(nty) && !tc.impls.contains(ob.trait_name + "::" + ty_base_name(nty)) {
            let cname = ty_to_string(nty)
            let disp_tr = display_trait_name(ob.trait_name)
            tc_err(
              tc,
              cs.span,
              "E_TRAIT_NOT_IMPLEMENTED",
              "type `" +
              cname +
              "` does not implement trait `" +
              disp_tr +
              "` required by `Eq` comparison in `" +
              cs.callee_name +
              "`",
              "impl " + disp_tr + " for " + cname,
              cname,
              "add `impl " + disp_tr + " for " + cname + " { ... }`",
            )
          }
          oi = oi + 1
        }
      }
      None => ()
    }
    ci = ci + 1
  }
}

///|
fn tc_is_lower_hex(c : Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 97 && c <= 102)
}

///|
fn tc_is_ident_char(c : Int) -> Bool {
  (c >= 65 && c <= 90) ||
  (c >= 97 && c <= 122) ||
  (c >= 48 && c <= 57) ||
  c == 95
}

///|
fn tc_strip_canon_hash(s : String) -> String {
  let n = s.length()
  if n <= 10 {
    return s
  }
  if str_code_at(s, n - 10) != 95 || str_code_at(s, n - 9) != 95 {
    return s
  }
  let mut i = n - 8
  while i < n {
    if !tc_is_lower_hex(str_code_at(s, i)) {
      return s
    }
    i = i + 1
  }
  slice_str(s, 0, n - 10)
}

///|
fn tc_build_canon_display_map(tc : TypeChecker) -> Unit {
  let base_counts : Map[String, Int] = Map([])
  let mut i = 0
  while i < tc.all_imported_pkg_names.length() {
    let cid = tc.all_imported_pkg_names[i]
    let base = tc_strip_canon_hash(cid)
    let prev = match base_counts.get(base) {
      Some(c) => c
      None => 0
    }
    base_counts.set(base, prev + 1)
    i = i + 1
  }
  let cand_keys : Array[String] = []
  let cand_vals : Array[String] = []
  let disp_counts : Map[String, Int] = Map([])
  let alias_keys = tc.import_aliases.keys()
  let dep_keys = tc.dep_map.keys()
  i = 0
  while i < tc.all_imported_pkg_names.length() {
    let cid = tc.all_imported_pkg_names[i]
    let base = tc_strip_canon_hash(cid)
    if base != cid {
      let mut best = ""
      let mut ai = 0
      while ai < alias_keys.length() {
        let al = alias_keys[ai]
        match tc.import_aliases.get(al) {
          Some(t) =>
            if t == cid {
              if al == base {
                best = base
              } else if best != base && (best == "" || al < best) {
                best = al
              }
            }
          None => ()
        }
        ai = ai + 1
      }
      if best == "" {
        let mut di = 0
        while di < dep_keys.length() {
          let al = dep_keys[di]
          match tc.dep_map.get(al) {
            Some(t) =>
              if t == cid {
                if al == base {
                  best = base
                } else if best != base && (best == "" || al < best) {
                  best = al
                }
              }
            None => ()
          }
          di = di + 1
        }
      }
      if best == "" {
        let bc = match base_counts.get(base) {
          Some(c) => c
          None => 0
        }
        if bc == 1 {
          best = base
        }
      }
      if best != "" && best != cid {
        cand_keys.push(cid)
        cand_vals.push(best)
        let dc = match disp_counts.get(best) {
          Some(c) => c
          None => 0
        }
        disp_counts.set(best, dc + 1)
      }
    }
    i = i + 1
  }
  i = 0
  while i < cand_keys.length() {
    let disp = cand_vals[i]
    let dc = match disp_counts.get(disp) {
      Some(c) => c
      None => 0
    }
    if dc == 1 {
      tc.canon_display_keys.push(cand_keys[i])
      tc.canon_display_vals.push(disp)
    }
    i = i + 1
  }
}

///|
fn tc_replace_canon_qual(s : String, cid : String, disp : String) -> String {
  let needle = cid + "::"
  let nlen = needle.length()
  let slen = s.length()
  if slen < nlen || !s.contains(needle) {
    return s
  }
  let sb = StringBuilder()
  let mut last = 0
  let mut i = 0
  while i < slen {
    if i + nlen <= slen &&
      (i == 0 || !tc_is_ident_char(str_code_at(s, i - 1))) &&
      slice_str(s, i, i + nlen) == needle {
      if i > last {
        sb.write_string(slice_str(s, last, i))
      }
      sb.write_string(disp)
      sb.write_string("::")
      i = i + nlen
      last = i
    } else {
      i = i + 1
    }
  }
  if last < slen {
    sb.write_string(slice_str(s, last, slen))
  }
  sb.to_string()
}

///|
fn tc_display_diag_str(tc : TypeChecker, s : String) -> String {
  if tc.canon_display_keys.length() == 0 || !s.contains("::") {
    return s
  }
  let mut out = s
  let mut i = 0
  while i < tc.canon_display_keys.length() {
    out = tc_replace_canon_qual(out, tc.canon_display_keys[i], tc.canon_display_vals[i])
    i = i + 1
  }
  out
}

///|
fn tc_err(
  tc : TypeChecker,
  span : Span,
  code : String,
  message : String,
  expected : String,
  found : String,
  fixit : String,
) -> Unit {
  tc.diagnostics.push(
    diag_new(
      span,
      code,
      tc_display_diag_str(tc, message),
      tc_display_diag_str(tc, expected),
      tc_display_diag_str(tc, found),
      tc_display_diag_str(tc, fixit),
    ),
  )
}

///|
fn resolve_type_expr(
  tc : TypeChecker,
  te : TypeExpr,
  tparams : Array[String],
) -> Ty {
  match te {
    TyMissing(_) => TError
    TyTuple(elems, _) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        out.push(resolve_type_expr(tc, elems[i], tparams))
        i = i + 1
      }
      TTuple(out)
    }
    TyFn(params, ret, _) => {
      let ptys : Array[Ty] = []
      let mut i = 0
      while i < params.length() {
        ptys.push(resolve_type_expr(tc, params[i], tparams))
        i = i + 1
      }
      TFn(ptys, resolve_type_expr(tc, ret, tparams))
    }
    TyDynTrait(tname, sp) => {
      let stl = lookup_source_trait_ex(
        tc,
        tname,
        sp,
        tc.in_default_arg_expansion || tc.in_imported_default_arg || starts_with_str(tname, "@canon:"),
      )
      match stl.info {
        None => {
          if !stl.errored {
            tc_err(
              tc,
              sp,
              "E_UNKNOWN_TRAIT",
              "unknown trait `" + tname + "` in `dyn` type",
              "defined trait",
              tname,
              "declare `trait " + tname + " { ... }` or check its spelling",
            )
          }
          TError
        }
        Some(tinfo) =>
          if check_trait_object_safe(tc, tname, tinfo, sp) {
            TDynTrait(stl.canon_name)
          } else {
            TError
          }
      }
    }
    TyName(name, args, sp) => {
      if str_arr_contains(tparams, name) {
        return TParam(name)
      }
      if name == "Int" {
        return TInt
      }
      if name == "Int64" {
        return TInt64
      }
      if name == "UInt" {
        return TUInt
      }
      if name == "UInt64" {
        return TUInt64
      }
      if name == "Double" {
        return TDouble
      }
      if name == "Float" || name == "Float32" {
        return TFloat
      }
      if name == "Bool" {
        return TBool
      }
      if name == "Byte" {
        return TByte
      }
      if name == "Int8" {
        return TInt8
      }
      if name == "Char" {
        return TChar
      }
      if name == "String" {
        return TString
      }
      if name == "Unit" {
        return TUnit
      }
      if name == "Never" {
        return TNever
      }
      if name == "Ptr" {
        return TPtr
      }
      if name == "StringBuilder" {
        return TStringBuilder
      }
      if name == "Bytes" {
        return TBytes
      }
      if name == "StrView" {
        return TStrView
      }
      if name == "BytesView" {
        return TBytesView
      }
      if name == "World" {
        return TWorld
      }
      if name == "Scope" {
        return TScope
      }
      if name == "AtomicInt" {
        return TAtomicInt
      }
      let rargs : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        rargs.push(resolve_type_expr(tc, args[i], tparams))
        i = i + 1
      }
      if name == "Array" {
        let elem = if rargs.length() >= 1 { rargs[0] } else { TError }
        return TArray(elem)
      }
      if name == "FixedArray" {
        let elem = if rargs.length() >= 1 { rargs[0] } else { TError }
        return TFixedArray(elem)
      }
      if name == "ImmArray" {
        if rargs.length() != 1 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`ImmArray` expects 1 type argument, found " + rargs.length().to_string(),
            "1 type arg",
            rargs.length().to_string() + " type args",
            "write `ImmArray[T]` with 1 element type argument",
          )
          return TError
        }
        return TImmArray(rargs[0])
      }
      if name == "Option" {
        let elem = if rargs.length() >= 1 { rargs[0] } else { TError }
        return TOption(elem)
      }
      if name == "Result" {
        let ok = if rargs.length() >= 1 { rargs[0] } else { TError }
        let err = if rargs.length() >= 2 { rargs[1] } else { TError }
        return TResult(ok, err)
      }
      if name == "Map" {
        let k = if rargs.length() >= 1 { rargs[0] } else { TError }
        let v = if rargs.length() >= 2 { rargs[1] } else { TError }
        record_map_key_tparams(tc, tc.cur_fn_key, k)
        if !is_valid_map_key_ty(tc, k) {
          tc_err(
            tc,
            sp,
            "E_MAP_KEY_TYPE",
            "`Map` keys must be `String`, an integer/char/bool scalar, or an immutable pure-scalar tuple/POD struct (1..6 fields), got `" +
            ty_to_string(k) +
            "`",
            "String, scalar integer/char/bool, or immutable pure-scalar tuple/struct",
            ty_to_string(k),
            "use a supported scalar, tuple, or immutable POD struct key for `Map[K, " +
            ty_to_string(v) +
            "]`",
          )
        }
        return TMap(k, v)
      }
      if name == "Channel" {
        let elem = if rargs.length() >= 1 { rargs[0] } else { TError }
        return TChannel(elem)
      }
      if name == "Mutex" {
        let elem = if rargs.length() >= 1 { rargs[0] } else { TError }
        return TMutex(elem)
      }
      let via_alias = tc_is_imported_pkg_alias(tc, name)
      if !via_alias && tc.structs.contains(name) {
        if !tc.in_default_arg_expansion && tc.priv_imported_types.contains(name) {
          let qp_p = split_qual_name(name)
          emit_private_err(tc, sp, "struct", qp_p.prefix, qp_p.name)
        }
        let res_ty = TStruct(name, rargs)
        if tc.in_pass3 && rargs.length() > 0 {
          tc_check_map_keys_in_ty_rec(tc, tc.cur_fn_key, res_ty, sp, true, Map([]), Map([]))
        }
        return res_ty
      }
      if !via_alias && tc.enums.contains(name) {
        if !tc.in_default_arg_expansion && tc.priv_imported_types.contains(name) {
          let qp_p = split_qual_name(name)
          emit_private_err(tc, sp, "enum", qp_p.prefix, qp_p.name)
        }
        match tc.enums.get(name) {
          Some(ei) =>
            if rargs.length() > 0 && ei.decl.type_params.length() == 0 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "enum `" + name + "` takes 0 type argument(s), found " + rargs.length().to_string(),
                name,
                name + "[...]",
                "remove type arguments from non-generic enum `" + name + "`",
              )
              return TError
            }
          None => ()
        }
        let res_ty = TEnum(name, rargs)
        if tc.in_pass3 && rargs.length() > 0 {
          tc_check_map_keys_in_ty_rec(tc, tc.cur_fn_key, res_ty, sp, true, Map([]), Map([]))
        }
        return res_ty
      }
      let qp = split_qual_name(name)
      let q_alias = qp.prefix
      let q_type = qp.name
      if q_alias.length() > 0 {
        let is_canon = starts_with_str(q_alias, "@canon:")
        if is_canon && slice_str(q_alias, 7, q_alias.length()) == tc.pkg_name {
          if tc.structs.contains(q_type) {
            return TStruct(q_type, rargs)
          }
          if tc.enums.contains(q_type) {
            return TEnum(q_type, rargs)
          }
        }
        match resolve_pkg_for_lookup(tc, q_alias, tc.in_default_arg_expansion) {
          Some(ipkg) => {
            match ipkg.tc.structs.get(q_type) {
              Some(si) => {
                let qk = ipkg.name + "::" + q_type
                if !si.decl.is_pub {
                  if !tc.in_default_arg_expansion && !is_canon {
                    emit_private_err_at(tc, sp, "struct", ipkg.name, q_type, si.decl.span)
                  } else {
                    tc_ensure_priv_struct_registered(tc, ipkg, q_type, si)
                  }
                }
                return TStruct(qk, rargs)
              }
              None => ()
            }
            match ipkg.tc.enums.get(q_type) {
              Some(ei) => {
                let qk = ipkg.name + "::" + q_type
                if !ei.decl.is_pub {
                  if !tc.in_default_arg_expansion && !is_canon {
                    emit_private_err_at(tc, sp, "enum", ipkg.name, q_type, ei.decl.span)
                  } else {
                    tc_ensure_priv_enum_registered(tc, ipkg, q_type, ei)
                  }
                }
                if rargs.length() > 0 && ei.decl.type_params.length() == 0 {
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "enum `" + name + "` takes 0 type argument(s), found " + rargs.length().to_string(),
                    name,
                    name + "[...]",
                    "remove type arguments from non-generic enum `" + name + "`",
                  )
                  return TError
                }
                return TEnum(qk, rargs)
              }
              None => ()
            }
          }
          None => ()
        }
      }
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "unknown type `" + name + "`",
        "defined type",
        name,
        "declare `" + name + "` or check its spelling",
      )
      TError
    }
  }
}

///|
fn subst_ty(t : Ty, subst : Map[String, Ty]) -> Ty {
  match t {
    TParam(n) =>
      match subst.get(n) {
        Some(rep) => rep
        None => t
      }
    TArray(e) => TArray(subst_ty(e, subst))
    TFixedArray(e) => TFixedArray(subst_ty(e, subst))
    TImmArray(e) => TImmArray(subst_ty(e, subst))
    TOption(e) => TOption(subst_ty(e, subst))
    TResult(ok, err) => TResult(subst_ty(ok, subst), subst_ty(err, subst))
    TMap(k, v) => TMap(subst_ty(k, subst), subst_ty(v, subst))
    TChannel(e) => TChannel(subst_ty(e, subst))
    TMutex(e) => TMutex(subst_ty(e, subst))
    TStruct(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(subst_ty(args[i], subst))
        i = i + 1
      }
      TStruct(name, out)
    }
    TEnum(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(subst_ty(args[i], subst))
        i = i + 1
      }
      TEnum(name, out)
    }
    TFn(params, ret) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < params.length() {
        out.push(subst_ty(params[i], subst))
        i = i + 1
      }
      TFn(out, subst_ty(ret, subst))
    }
    TTuple(elems) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        out.push(subst_ty(elems[i], subst))
        i = i + 1
      }
      TTuple(out)
    }
    _ => t
  }
}

///|
fn subst_ty_mask_unbound(
  t : Ty,
  decl_tparams : Array[String],
  subst : Map[String, Ty],
) -> Ty {
  match t {
    TParam(n) =>
      match subst.get(n) {
        Some(rep) => rep
        None =>
          if str_arr_contains(decl_tparams, n) {
            TError
          } else {
            t
          }
      }
    TArray(e) => TArray(subst_ty_mask_unbound(e, decl_tparams, subst))
    TFixedArray(e) => TFixedArray(subst_ty_mask_unbound(e, decl_tparams, subst))
    TImmArray(e) => TImmArray(subst_ty_mask_unbound(e, decl_tparams, subst))
    TOption(e) => TOption(subst_ty_mask_unbound(e, decl_tparams, subst))
    TResult(ok, err) =>
      TResult(
        subst_ty_mask_unbound(ok, decl_tparams, subst),
        subst_ty_mask_unbound(err, decl_tparams, subst),
      )
    TMap(k, v) =>
      TMap(
        subst_ty_mask_unbound(k, decl_tparams, subst),
        subst_ty_mask_unbound(v, decl_tparams, subst),
      )
    TChannel(e) => TChannel(subst_ty_mask_unbound(e, decl_tparams, subst))
    TMutex(e) => TMutex(subst_ty_mask_unbound(e, decl_tparams, subst))
    TStruct(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(subst_ty_mask_unbound(args[i], decl_tparams, subst))
        i = i + 1
      }
      TStruct(name, out)
    }
    TEnum(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(subst_ty_mask_unbound(args[i], decl_tparams, subst))
        i = i + 1
      }
      TEnum(name, out)
    }
    TFn(params, ret) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < params.length() {
        out.push(subst_ty_mask_unbound(params[i], decl_tparams, subst))
        i = i + 1
      }
      TFn(out, subst_ty_mask_unbound(ret, decl_tparams, subst))
    }
    TTuple(elems) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        out.push(subst_ty_mask_unbound(elems[i], decl_tparams, subst))
        i = i + 1
      }
      TTuple(out)
    }
    _ => t
  }
}

///|
fn make_subst(tparams : Array[String], targs : Array[Ty]) -> Map[String, Ty] {
  let m : Map[String, Ty] = Map([])
  let mut i = 0
  while i < tparams.length() && i < targs.length() {
    m.set(tparams[i], targs[i])
    i = i + 1
  }
  m
}

///|
fn unify_tparams(pattern : Ty, actual : Ty, subst : Map[String, Ty]) -> Unit {
  match pattern {
    TParam(n) =>
      match actual {
        TError => ()
        _ =>
          match subst.get(n) {
            None => subst.set(n, actual)
            Some(TParam(_)) =>
              match actual {
                TParam(_) => ()
                _ => subst.set(n, actual)
              }
            Some(prev) =>
              if ty_has_unresolved(prev) && !ty_has_unresolved(actual) {
                match actual {
                  TNever => ()
                  _ => subst.set(n, actual)
                }
              }
          }
      }
    TArray(pe) =>
      match actual {
        TArray(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TFixedArray(pe) =>
      match actual {
        TFixedArray(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TImmArray(pe) =>
      match actual {
        TImmArray(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TOption(pe) =>
      match actual {
        TOption(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TResult(po, pe) =>
      match actual {
        TResult(ao, ae) => {
          unify_tparams(po, ao, subst)
          unify_tparams(pe, ae, subst)
        }
        _ => ()
      }
    TMap(pk, pv) =>
      match actual {
        TMap(ak, av) => {
          unify_tparams(pk, ak, subst)
          unify_tparams(pv, av, subst)
        }
        _ => ()
      }
    TChannel(pe) =>
      match actual {
        TChannel(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TMutex(pe) =>
      match actual {
        TMutex(ae) => unify_tparams(pe, ae, subst)
        _ => ()
      }
    TStruct(pn, pargs) =>
      match actual {
        TStruct(an, aargs) =>
          if pn == an {
            let mut i = 0
            while i < pargs.length() && i < aargs.length() {
              unify_tparams(pargs[i], aargs[i], subst)
              i = i + 1
            }
          }
        _ => ()
      }
    TEnum(pn, pargs) =>
      match actual {
        TEnum(an, aargs) =>
          if pn == an {
            let mut i = 0
            while i < pargs.length() && i < aargs.length() {
              unify_tparams(pargs[i], aargs[i], subst)
              i = i + 1
            }
          }
        _ => ()
      }
    TFn(pp, pr) =>
      match actual {
        TFn(ap, ar) => {
          let mut i = 0
          while i < pp.length() && i < ap.length() {
            unify_tparams(pp[i], ap[i], subst)
            i = i + 1
          }
          unify_tparams(pr, ar, subst)
        }
        _ => ()
      }
    TTuple(pe) =>
      match actual {
        TTuple(ae) => {
          let mut i = 0
          while i < pe.length() && i < ae.length() {
            unify_tparams(pe[i], ae[i], subst)
            i = i + 1
          }
        }
        _ => ()
      }
    _ => ()
  }
}

///|
fn ty_has_unresolved(t : Ty) -> Bool {
  match t {
    TError => true
    TArray(e) => ty_has_unresolved(e)
    TFixedArray(e) => ty_has_unresolved(e)
    TImmArray(e) => ty_has_unresolved(e)
    TMap(k, v) => ty_has_unresolved(k) || ty_has_unresolved(v)
    TOption(e) => ty_has_unresolved(e)
    TResult(ok, err) => ty_has_unresolved(ok) || ty_has_unresolved(err)
    TChannel(e) => ty_has_unresolved(e)
    TMutex(e) => ty_has_unresolved(e)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if ty_has_unresolved(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if ty_has_unresolved(r) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if ty_has_unresolved(ps[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn ty_prefer_concrete(a : Ty, b : Ty) -> Ty {
  match a {
    TNever | TError => return b
    _ => ()
  }
  match b {
    TNever | TError => return a
    _ => ()
  }
  match a {
    TTuple(as_arr) =>
      match b {
        TTuple(bs_arr) =>
          if as_arr.length() == bs_arr.length() {
            let out : Array[Ty] = []
            let mut i = 0
            while i < as_arr.length() {
              out.push(ty_prefer_concrete(as_arr[i], bs_arr[i]))
              i = i + 1
            }
            return TTuple(out)
          }
        _ => ()
      }
    TOption(ai) =>
      match b {
        TOption(bi) => return TOption(ty_prefer_concrete(ai, bi))
        _ => ()
      }
    TResult(ao, ae) =>
      match b {
        TResult(bo, be) =>
          return TResult(ty_prefer_concrete(ao, bo), ty_prefer_concrete(ae, be))
        _ => ()
      }
    TArray(ae) =>
      match b {
        TArray(be) => return TArray(ty_prefer_concrete(ae, be))
        _ => ()
      }
    TFixedArray(ae) =>
      match b {
        TFixedArray(be) => return TFixedArray(ty_prefer_concrete(ae, be))
        _ => ()
      }
    TImmArray(ae) =>
      match b {
        TImmArray(be) => return TImmArray(ty_prefer_concrete(ae, be))
        _ => ()
      }
    TMap(ak, av) =>
      match b {
        TMap(bk, bv) =>
          return TMap(ty_prefer_concrete(ak, bk), ty_prefer_concrete(av, bv))
        _ => ()
      }
    TStruct(sn, sa) =>
      match b {
        TStruct(sn2, sb) =>
          if sn == sn2 && sa.length() == sb.length() {
            let out : Array[Ty] = []
            let mut i = 0
            while i < sa.length() {
              out.push(ty_prefer_concrete(sa[i], sb[i]))
              i = i + 1
            }
            return TStruct(sn, out)
          }
        _ => ()
      }
    TEnum(en, ea) =>
      match b {
        TEnum(en2, eb) =>
          if en == en2 && ea.length() == eb.length() {
            let out : Array[Ty] = []
            let mut i = 0
            while i < ea.length() {
              out.push(ty_prefer_concrete(ea[i], eb[i]))
              i = i + 1
            }
            return TEnum(en, out)
          }
        _ => ()
      }
    _ => ()
  }
  if ty_has_unresolved(a) && !ty_has_unresolved(b) {
    b
  } else {
    a
  }
}

///|
fn ty_compat(expected : Ty, found : Ty) -> Bool {
  match expected {
    TError => return true
    _ => ()
  }
  match found {
    TError | TNever => return true
    _ => ()
  }
  match expected {
    TInt =>
      match found {
        TInt => true
        _ => false
      }
    TInt64 =>
      match found {
        TInt64 => true
        _ => false
      }
    TUInt =>
      match found {
        TUInt => true
        _ => false
      }
    TUInt64 =>
      match found {
        TUInt64 => true
        _ => false
      }
    TDouble =>
      match found {
        TDouble => true
        _ => false
      }
    TFloat =>
      match found {
        TFloat => true
        _ => false
      }
    TBool =>
      match found {
        TBool => true
        _ => false
      }
    TByte =>
      match found {
        TByte => true
        _ => false
      }
    TInt8 =>
      match found {
        TInt8 => true
        _ => false
      }
    TChar =>
      match found {
        TChar => true
        _ => false
      }
    TString =>
      match found {
        TString => true
        _ => false
      }
    TUnit =>
      match found {
        TUnit => true
        _ => false
      }
    TPtr =>
      match found {
        TPtr => true
        _ => false
      }
    TStringBuilder =>
      match found {
        TStringBuilder => true
        _ => false
      }
    TBytes =>
      match found {
        TBytes => true
        _ => false
      }
    TStrView =>
      match found {
        TStrView => true
        _ => false
      }
    TBytesView =>
      match found {
        TBytesView => true
        _ => false
      }
    TWorld =>
      match found {
        TWorld => true
        _ => false
      }
    TScope =>
      match found {
        TScope => true
        _ => false
      }
    TAtomicInt =>
      match found {
        TAtomicInt => true
        _ => false
      }
    TParam(a) =>
      match found {
        TParam(b) => a == b
        _ => false
      }
    TArray(e1) =>
      match found {
        TArray(e2) => ty_compat_eq(e1, e2)
        _ => false
      }
    TFixedArray(e1) =>
      match found {
        TFixedArray(e2) => ty_compat_eq(e1, e2)
        _ => false
      }
    TImmArray(e1) =>
      match found {
        TImmArray(e2) => ty_compat(e1, e2)
        _ => false
      }
    TOption(e1) =>
      match found {
        TOption(e2) => ty_compat_eq(e1, e2)
        _ => false
      }
    TResult(o1, e1) =>
      match found {
        TResult(o2, e2) => ty_compat_eq(o1, o2) && ty_compat_eq(e1, e2)
        _ => false
      }
    TMap(k1, v1) =>
      match found {
        TMap(k2, v2) => ty_compat_eq(k1, k2) && ty_compat_eq(v1, v2)
        _ => false
      }
    TChannel(e1) =>
      match found {
        TChannel(e2) => ty_compat_eq(e1, e2)
        _ => false
      }
    TMutex(e1) =>
      match found {
        TMutex(e2) => ty_compat_eq(e1, e2)
        _ => false
      }
    TStruct(n1, a1) =>
      match found {
        TStruct(n2, a2) => {
          if n1 != n2 || a1.length() != a2.length() {
            return false
          }
          let mut i = 0
          while i < a1.length() {
            if !ty_compat_eq(a1[i], a2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TEnum(n1, a1) =>
      match found {
        TEnum(n2, a2) => {
          if n1 != n2 || a1.length() != a2.length() {
            return false
          }
          let mut i = 0
          while i < a1.length() {
            if !ty_compat_eq(a1[i], a2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TFn(p1, r1) =>
      match found {
        TFn(p2, r2) => {
          if p1.length() != p2.length() {
            return false
          }
          let mut i = 0
          while i < p1.length() {
            if !ty_compat(p2[i], p1[i]) {
              return false
            }
            i = i + 1
          }
          ty_compat(r1, r2)
        }
        _ => false
      }
    TTuple(e1) =>
      match found {
        TTuple(e2) => {
          if e1.length() != e2.length() {
            return false
          }
          let mut i = 0
          while i < e1.length() {
            if !ty_compat_eq(e1[i], e2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TDynTrait(t1) =>
      match found {
        TDynTrait(t2) => t1 == t2
        _ => false
      }
    TError => true
    TNever =>
      match found {
        TNever | TError => true
        _ => false
      }
  }
}

///|
/// Single-pass O(N) invariant type equality (with `TError` wildcard on either side).
fn ty_compat_eq(a : Ty, b : Ty) -> Bool {
  match a {
    TError => return true
    _ => ()
  }
  match b {
    TError => return true
    _ => ()
  }
  match a {
    TInt => match b { TInt => true; _ => false }
    TInt64 => match b { TInt64 => true; _ => false }
    TUInt => match b { TUInt => true; _ => false }
    TUInt64 => match b { TUInt64 => true; _ => false }
    TDouble => match b { TDouble => true; _ => false }
    TFloat => match b { TFloat => true; _ => false }
    TBool => match b { TBool => true; _ => false }
    TByte => match b { TByte => true; _ => false }
    TInt8 => match b { TInt8 => true; _ => false }
    TChar => match b { TChar => true; _ => false }
    TString => match b { TString => true; _ => false }
    TUnit => match b { TUnit => true; _ => false }
    TPtr => match b { TPtr => true; _ => false }
    TStringBuilder => match b { TStringBuilder => true; _ => false }
    TBytes => match b { TBytes => true; _ => false }
    TStrView => match b { TStrView => true; _ => false }
    TBytesView => match b { TBytesView => true; _ => false }
    TWorld => match b { TWorld => true; _ => false }
    TScope => match b { TScope => true; _ => false }
    TAtomicInt => match b { TAtomicInt => true; _ => false }
    TNever => match b { TNever => true; _ => false }
    TParam(p1) => match b { TParam(p2) => p1 == p2; _ => false }
    TDynTrait(t1) => match b { TDynTrait(t2) => t1 == t2; _ => false }
    TArray(e1) => match b { TArray(e2) => ty_compat_eq(e1, e2); _ => false }
    TFixedArray(e1) => match b { TFixedArray(e2) => ty_compat_eq(e1, e2); _ => false }
    TImmArray(e1) => match b { TImmArray(e2) => ty_compat_eq(e1, e2); _ => false }
    TOption(e1) => match b { TOption(e2) => ty_compat_eq(e1, e2); _ => false }
    TResult(o1, e1) =>
      match b {
        TResult(o2, e2) => ty_compat_eq(o1, o2) && ty_compat_eq(e1, e2)
        _ => false
      }
    TMap(k1, v1) =>
      match b {
        TMap(k2, v2) => ty_compat_eq(k1, k2) && ty_compat_eq(v1, v2)
        _ => false
      }
    TChannel(e1) => match b { TChannel(e2) => ty_compat_eq(e1, e2); _ => false }
    TMutex(e1) => match b { TMutex(e2) => ty_compat_eq(e1, e2); _ => false }
    TStruct(n1, a1) =>
      match b {
        TStruct(n2, a2) => {
          if n1 != n2 || a1.length() != a2.length() {
            return false
          }
          let mut i = 0
          while i < a1.length() {
            if !ty_compat_eq(a1[i], a2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TEnum(n1, a1) =>
      match b {
        TEnum(n2, a2) => {
          if n1 != n2 || a1.length() != a2.length() {
            return false
          }
          let mut i = 0
          while i < a1.length() {
            if !ty_compat_eq(a1[i], a2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TTuple(e1) =>
      match b {
        TTuple(e2) => {
          if e1.length() != e2.length() {
            return false
          }
          let mut i = 0
          while i < e1.length() {
            if !ty_compat_eq(e1[i], e2[i]) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    TFn(p1, r1) =>
      match b {
        TFn(p2, r2) => {
          if p1.length() != p2.length() {
            return false
          }
          let mut i = 0
          while i < p1.length() {
            if !ty_compat_eq(p1[i], p2[i]) {
              return false
            }
            i = i + 1
          }
          ty_compat_eq(r1, r2)
        }
        _ => false
      }
    TError => true
  }
}

///|
fn ty_is_cast_scalar(t : Ty) -> Bool {
  match t {
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TDouble
    | TFloat
    | TByte
    | TInt8
    | TChar
    | TBool => true
    _ => false
  }
}

///|
fn ty_is_ptr_cast_int(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 => true
    _ => false
  }
}

///|
fn ty_is_valid_ptr_cast(from : Ty, to : Ty) -> Bool {
  let from_ptr = match from {
    TPtr => true
    _ => false
  }
  let to_ptr = match to {
    TPtr => true
    _ => false
  }
  (from_ptr && (to_ptr || ty_is_ptr_cast_int(to))) ||
  (to_ptr && ty_is_ptr_cast_int(from))
}

///|
/// Containers a `Mutex` may share across threads: `Array[T]` and
/// `Map[String, V]` whose elements are `Send` or themselves such containers
/// (`Mutex[Map[String, Array[String]]]`). The runtime freezes them
/// recursively on `Mutex::new` / `set`, and every object later stored into a
/// frozen container is frozen on insertion, so element RC stays atomic.
/// Bare `Array` / `Map` (no `Mutex`), `Ptr` and closures stay `!Send`.
///|
fn is_hashable_scalar_ty(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar => true
    _ => false
  }
}

///|
fn is_vmap_key_ty(tc : TypeChecker, t : Ty) -> Bool {
  match t {
    TTuple(elems) => {
      if elems.length() < 2 || elems.length() > 6 {
        return false
      }
      let mut i = 0
      while i < elems.length() {
        if !tc_is_hashable_scalar_ty(tc, elems[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    TStruct(sname, sargs) => {
      match tc_lookup_builtin_eq_impl(tc, sname) {
        Some(_) => return false
        None => ()
      }
      match tc_lookup_struct_info(tc, sname) {
        Some(si) => {
          let n = si.field_tys.length()
          if n < 1 || n > 6 {
            return false
          }
          let subst = make_subst(si.decl.type_params, sargs)
          let mut i = 0
          while i < n {
            if si.field_muts[i] {
              return false
            }
            let fty = subst_ty(si.field_tys[i], subst)
            if !tc_is_hashable_scalar_ty(tc, fty) {
              return false
            }
            i = i + 1
          }
          true
        }
        None => false
      }
    }
    _ => false
  }
}

///|
fn is_valid_map_key_ty(tc : TypeChecker, k : Ty) -> Bool {
  match k {
    TString | TParam(_) | TError => true
    _ => tc_is_hashable_scalar_ty(tc, k) || is_vmap_key_ty(tc, k)
  }
}

///|
/// Re-checks `TMap(k, v)` types resolved during Pass 2 (before Pass 2.2
/// registers local `impl Eq` declarations) so custom-`Eq` keys in struct
/// fields, enum variants, function signatures, consts, aliases, traits, and
/// impls are rejected with `E_MAP_KEY_TYPE`.
fn tc_check_map_keys_in_ty_rec(
  tc : TypeChecker,
  fn_key : String,
  t : Ty,
  sp : Span,
  check_all_invalid : Bool,
  visited : Map[String, Bool],
  active_exp_sz : Map[String, Int],
) -> Unit {
  match t {
    TMap(k, v) => {
      if ty_has_tparam(k) {
        let _ = map_key_ob_add(tc, fn_key, k)
      } else if !is_valid_map_key_ty(tc, k) && (check_all_invalid || v_has_custom_eq_in(tc, k, [])) {
        let mut already = false
        let mut di = 0
        while di < tc.diagnostics.length() {
          let d = tc.diagnostics[di]
          if d.code == "E_MAP_KEY_TYPE" && d.file == sp.file && d.line == sp.line {
            already = true
            break
          }
          di = di + 1
        }
        if !already {
          tc_err(
            tc,
            sp,
            "E_MAP_KEY_TYPE",
            "`Map` keys must be `String`, an integer/char/bool scalar, or an immutable pure-scalar tuple/POD struct (1..6 fields) without custom `impl Eq`, got `" +
            ty_to_string(k) +
            "`",
            "String, scalar integer/char/bool, or immutable pure-scalar tuple/struct",
            ty_to_string(k),
            "use a supported scalar, tuple, or immutable POD struct key without custom `impl Eq` for `Map[K, " +
            ty_to_string(v) +
            "]`",
          )
        }
      }
      tc_check_map_keys_in_ty_rec(tc, fn_key, k, sp, check_all_invalid, visited, active_exp_sz)
      tc_check_map_keys_in_ty_rec(tc, fn_key, v, sp, check_all_invalid, visited, active_exp_sz)
    }
    TArray(e) | TImmArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      tc_check_map_keys_in_ty_rec(tc, fn_key, e, sp, check_all_invalid, visited, active_exp_sz)
    TResult(ok, err) => {
      tc_check_map_keys_in_ty_rec(tc, fn_key, ok, sp, check_all_invalid, visited, active_exp_sz)
      tc_check_map_keys_in_ty_rec(tc, fn_key, err, sp, check_all_invalid, visited, active_exp_sz)
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        tc_check_map_keys_in_ty_rec(tc, fn_key, es[i], sp, check_all_invalid, visited, active_exp_sz)
        i = i + 1
      }
    }
    TFn(ps, ret) => {
      let mut i = 0
      while i < ps.length() {
        tc_check_map_keys_in_ty_rec(tc, fn_key, ps[i], sp, check_all_invalid, visited, active_exp_sz)
        i = i + 1
      }
      tc_check_map_keys_in_ty_rec(tc, fn_key, ret, sp, check_all_invalid, visited, active_exp_sz)
    }
    TStruct(name, args) => {
      let mut i = 0
      while i < args.length() {
        tc_check_map_keys_in_ty_rec(tc, fn_key, args[i], sp, check_all_invalid, visited, active_exp_sz)
        i = i + 1
      }
      if args.length() > 0 {
        let vk = "S:" + ty_to_string(t)
        if !visited.contains(vk) {
          let is_exp = tc_def_is_expansive(tc, true, name)
          let mut pk = ""
          let mut prev_sz = -1
          if is_exp {
            pk = tc_expansive_proj_key(tc, true, name, args)
            let sz = ty_ast_size(t)
            prev_sz = match active_exp_sz.get(pk) {
              Some(v) => v
              None => -1
            }
            if prev_sz >= 0 && sz >= prev_sz {
              if tc_expansive_def_mentions_param_map(tc, true, name) {
                tc_err(
                  tc,
                  sp,
                  "E_MAP_KEY_TYPE",
                  "non-regular polymorphic recursion in `" + ty_to_string(t) + "` prevents validating nested `Map` key types",
                  "regular generic type",
                  ty_to_string(t),
                  "avoid expansive polymorphic recursion around `Map` keys",
                )
              }
              return
            }
            active_exp_sz.set(pk, sz)
          }
          visited.set(vk, true)
          match tc_lookup_struct_info(tc, name) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, args)
              let mut fi = 0
              while fi < sinfo.field_tys.length() {
                tc_check_map_keys_in_ty_rec(tc, fn_key, subst_ty(sinfo.field_tys[fi], subst), sp, true, visited, active_exp_sz)
                fi = fi + 1
              }
            }
            None => ()
          }
          if is_exp {
            if prev_sz >= 0 {
              active_exp_sz.set(pk, prev_sz)
            } else {
              active_exp_sz.remove(pk)
            }
          }
        }
      }
    }
    TEnum(name, args) => {
      let mut i = 0
      while i < args.length() {
        tc_check_map_keys_in_ty_rec(tc, fn_key, args[i], sp, check_all_invalid, visited, active_exp_sz)
        i = i + 1
      }
      if args.length() > 0 {
        let vk = "E:" + ty_to_string(t)
        if !visited.contains(vk) {
          let is_exp = tc_def_is_expansive(tc, false, name)
          let mut pk = ""
          let mut prev_sz = -1
          if is_exp {
            pk = tc_expansive_proj_key(tc, false, name, args)
            let sz = ty_ast_size(t)
            prev_sz = match active_exp_sz.get(pk) {
              Some(v) => v
              None => -1
            }
            if prev_sz >= 0 && sz >= prev_sz {
              if tc_expansive_def_mentions_param_map(tc, false, name) {
                tc_err(
                  tc,
                  sp,
                  "E_MAP_KEY_TYPE",
                  "non-regular polymorphic recursion in `" + ty_to_string(t) + "` prevents validating nested `Map` key types",
                  "regular generic type",
                  ty_to_string(t),
                  "avoid expansive polymorphic recursion around `Map` keys",
                )
              }
              return
            }
            active_exp_sz.set(pk, sz)
          }
          visited.set(vk, true)
          match tc_lookup_enum_info_qualified(tc, name) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, args)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                let mut fi = 0
                while fi < v.field_tys.length() {
                  tc_check_map_keys_in_ty_rec(tc, fn_key, subst_ty(v.field_tys[fi], subst), sp, true, visited, active_exp_sz)
                  fi = fi + 1
                }
                vi = vi + 1
              }
            }
            None => ()
          }
          if is_exp {
            if prev_sz >= 0 {
              active_exp_sz.set(pk, prev_sz)
            } else {
              active_exp_sz.remove(pk)
            }
          }
        }
      }
    }
    _ => ()
  }
}

///|
fn tc_check_custom_eq_map_keys_in_ty(tc : TypeChecker, t : Ty, sp : Span) -> Unit {
  tc_check_map_keys_in_ty_rec(tc, tc.cur_fn_key, t, sp, false, Map([]), Map([]))
}

///|
fn is_mutex_inner_send(tc : TypeChecker, t : Ty, visiting : Array[String]) -> Bool {
  match t {
    TArray(e) | TFixedArray(e) =>
      is_send_ty(tc, e, visiting) || is_mutex_inner_send(tc, e, visiting)
    TMap(k, v) =>
      (match k {
        TString => true
        _ => tc_is_hashable_scalar_ty(tc, k) || is_vmap_key_ty(tc, k)
      }) &&
      (is_send_ty(tc, v, visiting) || is_mutex_inner_send(tc, v, visiting))
    _ => false
  }
}

///|
fn is_send_ty(tc : TypeChecker, t : Ty, visiting : Array[String]) -> Bool {
  if visiting.length() > 32 {
    return false
  }
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TString | TStrView | TUnit => true
    TAtomicInt | TScope | TNever | TError => true
    // The `World` capability is a frozen, immutable handle whose IO/TCP
    // primitives are thread-safe syscalls: spawned workers may capture it.
    TWorld => true
    TPtr | TArray(_) | TFixedArray(_) | TBytes | TBytesView | TMap(_, _) | TStringBuilder => false
    TDynTrait(_) => false
    TParam(_) => false
    TImmArray(e) => is_send_ty(tc, e, visiting)
    TOption(e) => is_send_ty(tc, e, visiting)
    TResult(ok, err) =>
      is_send_ty(tc, ok, visiting) && is_send_ty(tc, err, visiting)
    TChannel(e) => is_send_ty(tc, e, visiting)
    TMutex(e) =>
      is_send_ty(tc, e, visiting) || is_mutex_inner_send(tc, e, visiting)
    TFn(_, _) => false
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if !is_send_ty(tc, elems[i], visiting) {
          return false
        }
        i = i + 1
      }
      true
    }
    TStruct(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return true
      }
      match tc.structs.get(name) {
        None => false
        Some(sinfo) => {
          let next_vis = visiting.copy()
          next_vis.push(key)
          let subst = make_subst(sinfo.decl.type_params, args)
          let mut i = 0
          while i < sinfo.field_tys.length() {
            if sinfo.field_muts[i] {
              return false
            }
            let fty = subst_ty(sinfo.field_tys[i], subst)
            if !is_send_ty(tc, fty, next_vis) {
              return false
            }
            i = i + 1
          }
          true
        }
      }
    }
    TEnum(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return true
      }
      match tc.enums.get(name) {
        None => false
        Some(einfo) => {
          let next_vis = visiting.copy()
          next_vis.push(key)
          let subst = make_subst(einfo.decl.type_params, args)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              let fty = subst_ty(v.field_tys[fi], subst)
              if !is_send_ty(tc, fty, next_vis) {
                return false
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          true
        }
      }
    }
  }
}

///|
fn is_world_builtin(name : String) -> Bool {
  name == "io_print" ||
  name == "io_println" ||
  name == "io_eprintln" ||
  name == "io_read_line" ||
  name == "fs_read" ||
  name == "fs_write" ||
  name == "fs_read_bytes" ||
  name == "fs_write_bytes" ||
  name == "fs_append" ||
  name == "fs_mtime_ms" ||
  name == "fs_exists" ||
  name == "fs_is_dir" ||
  name == "fs_mkdir_p" ||
  name == "fs_list_dir" ||
  name == "fs_remove" ||
  name == "fs_rename" ||
  name == "fs_size" ||
  name == "fs_lstat" ||
  name == "fs_readlink" ||
  name == "fs_symlink" ||
  name == "fs_chmod" ||
  name == "fs_read_range_nofollow" ||
  name == "clock_now_ms" ||
  name == "proc_exec" ||
  name == "proc_exec_capture" ||
  name == "proc_exec_capture_bytes" ||
  name == "env_get" ||
  name == "args_get" ||
  name == "world_args" ||
  name == "world_argc" ||
  name == "world_argv"
}

///|
pub struct RtPrim {
  c_sym : String
  world : Bool
  param_tys : Array[Ty]
  ret_ty : Ty
}

///|
/// Runtime primitives that lower to one direct `$pion_*` C call. `world` ones take an
/// explicit leading `World` argument (not part of `param_tys`).
fn rt_prim_info(name : String) -> Option[RtPrim] {
  if name == "ptr_alloc" {
    Some(RtPrim::{ c_sym: "pion_ptr_alloc", world: false, param_tys: [TInt64], ret_ty: TPtr })
  } else if name == "ptr_free" {
    Some(RtPrim::{ c_sym: "pion_ptr_free", world: false, param_tys: [TPtr], ret_ty: TUnit })
  } else if name == "ptr_offset" {
    Some(RtPrim::{ c_sym: "pion_ptr_offset", world: false, param_tys: [TPtr, TInt64], ret_ty: TPtr })
  } else if name == "ptr_read_ptr" {
    Some(RtPrim::{ c_sym: "pion_ptr_read_ptr", world: false, param_tys: [TPtr, TInt64], ret_ty: TPtr })
  } else if name == "ptr_write_ptr" {
    Some(RtPrim::{ c_sym: "pion_ptr_write_ptr", world: false, param_tys: [TPtr, TInt64, TPtr], ret_ty: TUnit })
  } else if name == "ptr_read_u8" {
    Some(RtPrim::{ c_sym: "pion_ptr_read_u8", world: false, param_tys: [TPtr, TInt64], ret_ty: TInt })
  } else if name == "ptr_write_u8" {
    Some(RtPrim::{ c_sym: "pion_ptr_write_u8", world: false, param_tys: [TPtr, TInt64, TInt], ret_ty: TUnit })
  } else if name == "ptr_read_i32" {
    Some(RtPrim::{ c_sym: "pion_ptr_read_i32", world: false, param_tys: [TPtr, TInt64], ret_ty: TInt })
  } else if name == "ptr_write_i32" {
    Some(RtPrim::{ c_sym: "pion_ptr_write_i32", world: false, param_tys: [TPtr, TInt64, TInt], ret_ty: TUnit })
  } else if name == "ptr_read_i64" {
    Some(RtPrim::{ c_sym: "pion_ptr_read_i64", world: false, param_tys: [TPtr, TInt64], ret_ty: TInt64 })
  } else if name == "ptr_write_i64" {
    Some(RtPrim::{ c_sym: "pion_ptr_write_i64", world: false, param_tys: [TPtr, TInt64, TInt64], ret_ty: TUnit })
  } else if name == "bytes_from_ptr" {
    Some(RtPrim::{ c_sym: "pion_bytes_from_ptr", world: false, param_tys: [TPtr, TInt], ret_ty: TBytes })
  } else if name == "bytes_copy_to_ptr" {
    Some(RtPrim::{ c_sym: "pion_bytes_copy_to_ptr", world: false, param_tys: [TBytes, TInt, TPtr, TInt], ret_ty: TUnit })
  } else if name == "cstr_to_str" {
    Some(RtPrim::{ c_sym: "pion_cstr_to_str", world: false, param_tys: [TPtr], ret_ty: TString })
  } else if name == "tcp_listen" {
    Some(RtPrim::{ c_sym: "pion_tcp_listen", world: true, param_tys: [TString, TInt], ret_ty: TInt })
  } else if name == "tcp_local_port" {
    Some(RtPrim::{ c_sym: "pion_tcp_local_port", world: true, param_tys: [TInt], ret_ty: TInt })
  } else if name == "tcp_accept" {
    Some(RtPrim::{ c_sym: "pion_tcp_accept", world: true, param_tys: [TInt], ret_ty: TInt })
  } else if name == "tcp_connect" {
    Some(RtPrim::{ c_sym: "pion_tcp_connect", world: true, param_tys: [TString, TInt], ret_ty: TInt })
  } else if name == "tcp_read" {
    Some(RtPrim::{ c_sym: "pion_tcp_read", world: true, param_tys: [TInt, TInt], ret_ty: TString })
  } else if name == "tcp_write" {
    Some(RtPrim::{ c_sym: "pion_tcp_write", world: true, param_tys: [TInt, TString], ret_ty: TInt })
  } else if name == "tcp_close" {
    Some(RtPrim::{ c_sym: "pion_tcp_close", world: true, param_tys: [TInt], ret_ty: TUnit })
  } else if name == "sleep_ms" {
    Some(RtPrim::{ c_sym: "pion_sleep_ms", world: true, param_tys: [TInt], ret_ty: TUnit })
  } else if name == "tcp_listen_reuse" {
    Some(RtPrim::{ c_sym: "pion_tcp_listen_reuse", world: true, param_tys: [TString, TInt], ret_ty: TInt })
  } else if name == "tcp_set_nonblock" {
    Some(RtPrim::{ c_sym: "pion_tcp_set_nonblock", world: true, param_tys: [TInt, TBool], ret_ty: TBool })
  } else if name == "tcp_accept_nb" {
    Some(RtPrim::{ c_sym: "pion_tcp_accept_nb", world: true, param_tys: [TInt], ret_ty: TInt })
  } else if name == "tcp_read_nb" {
    Some(RtPrim::{ c_sym: "pion_tcp_read_nb", world: true, param_tys: [TInt, TStringBuilder, TInt], ret_ty: TInt })
  } else if name == "tcp_write_nb" {
    Some(RtPrim::{ c_sym: "pion_tcp_write_nb", world: true, param_tys: [TInt, TString, TInt], ret_ty: TInt })
  } else if name == "poll_create" {
    Some(RtPrim::{ c_sym: "pion_poll_create", world: true, param_tys: [], ret_ty: TInt })
  } else if name == "poll_ctl" {
    Some(RtPrim::{ c_sym: "pion_poll_ctl", world: true, param_tys: [TInt, TInt, TInt, TInt], ret_ty: TBool })
  } else if name == "poll_wait" {
    Some(
      RtPrim::{
        c_sym: "pion_poll_wait",
        world: true,
        param_tys: [TInt, TArray(TInt), TArray(TInt), TInt, TInt],
        ret_ty: TInt,
      },
    )
  } else if name == "poll_close" {
    Some(RtPrim::{ c_sym: "pion_poll_close", world: true, param_tys: [TInt], ret_ty: TUnit })
  } else if name == "simd_dot_i8" {
    Some(RtPrim::{ c_sym: "pion_simd_dot_i8", world: false, param_tys: [TArray(TInt8), TInt, TArray(TInt8), TInt, TInt], ret_ty: TInt })
  } else if name == "simd_dot_i8_bytes" {
    Some(RtPrim::{ c_sym: "pion_simd_dot_i8_bytes", world: false, param_tys: [TBytes, TInt, TArray(TInt8), TInt, TInt], ret_ty: TInt })
  } else if name == "simd_matvec_i8_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_matvec_i8_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TInt8), TInt, TArray(TInt8), TInt, TArray(TFloat), TInt, TFloat, TInt, TInt], ret_ty: TUnit })
  } else if name == "simd_matvec_i8_bytes_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_matvec_i8_bytes_f32", world: false, param_tys: [TArray(TFloat), TInt, TBytes, TInt, TArray(TInt8), TInt, TArray(TFloat), TInt, TFloat, TInt, TInt], ret_ty: TUnit })
  } else if name == "simd_dot_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_dot_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TInt], ret_ty: TFloat })
  } else if name == "simd_axpy_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_axpy_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TFloat, TInt], ret_ty: TUnit })
  } else if name == "simd_mul_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_mul_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TArray(TFloat), TInt, TInt], ret_ty: TUnit })
  } else if name == "simd_add_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_add_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TArray(TFloat), TInt, TInt], ret_ty: TUnit })
  } else if name == "simd_scale_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_scale_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TFloat, TInt], ret_ty: TUnit })
  } else if name == "simd_mul_dot_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_mul_dot_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TArray(TFloat), TInt, TInt], ret_ty: TFloat })
  } else if name == "clock_monotonic_us" {
    Some(RtPrim::{ c_sym: "pion_clock_monotonic_us", world: false, param_tys: [], ret_ty: TInt64 })
  } else if name == "simd_axpy_dot_f32" {
    Some(RtPrim::{ c_sym: "pion_simd_axpy_dot_f32", world: false, param_tys: [TArray(TFloat), TInt, TArray(TFloat), TInt, TFloat, TArray(TFloat), TInt, TInt], ret_ty: TFloat })
  } else {
    None
  }
}

///|
fn is_world_rt_prim(name : String) -> Bool {
  match rt_prim_info(name) {
    Some(pr) => pr.world
    None => false
  }
}

///|
fn check_rt_prim_call(
  tc : TypeChecker,
  env : Env,
  name : String,
  pr : RtPrim,
  args : Array[Expr],
  sp : Span,
) -> Ty {
  let off = if pr.world { 1 } else { 0 }
  let want = pr.param_tys.length() + off
  if pr.world {
    if env.in_no_io {
      tc_err(
        tc,
        sp,
        "E_NO_IO_VIOLATION",
        "calling `" + name + "` is forbidden inside `#no_io` / `#render_thread` function `" + env.no_io_fn_name + "`",
        "non-blocking UI logic (no World IO)",
        "World IO call `" + name + "`",
        "send a command over `Channel` to a background worker thread (`spawn`) that owns `World`, then wake the render thread with the result",
      )
      return pr.ret_ty
    }
    let mut has_world = false
    if args.length() > 0 {
      match check_expr(tc, env, args[0], Some(TWorld)) {
        TWorld => has_world = true
        _ => ()
      }
    }
    if !has_world {
      tc_err(
        tc,
        sp,
        "E_CAPABILITY_MISSING",
        "calling `" + name + "` requires an explicit `World` capability as its first argument",
        "World",
        "none",
        "pass the `World` value as the first argument of `" + name + "`",
      )
      if !env.has_world && env.fn_lparen_span.line > 0 {
        let ins = if env.fn_has_params { "world : World, " } else { "world : World" }
        tc_add_edit(tc, text_edit_insert_maybe(env.fn_lparen_span, 1, ins))
      }
    }
  }
  if args.length() != want {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "`" + name + "` expects " + want.to_string() + " argument(s), found " + args.length().to_string(),
      want.to_string() + " args",
      args.length().to_string() + " args",
      "pass " + want.to_string() + " argument(s) to `" + name + "`",
    )
  }
  let mut i = off
  while i < args.length() {
    let pi = i - off
    if pi < pr.param_tys.length() {
      let pty = pr.param_tys[pi]
      let aty = check_expr(tc, env, args[i], Some(pty))
      if !ty_compat(pty, aty) {
        tc_err(
          tc,
          expr_span(args[i]),
          "E_TYPE_MISMATCH",
          "argument " + (i + 1).to_string() + " of `" + name + "` expects `" + ty_to_string(pty) + "`",
          ty_to_string(pty),
          ty_to_string(aty),
          "pass a `" + ty_to_string(pty) + "` value",
        )
      }
    } else {
      let _ = check_expr(tc, env, args[i], None)
    }
    i = i + 1
  }
  pr.ret_ty
}

///|
fn check_world_builtin_call(
  tc : TypeChecker,
  env : Env,
  name : String,
  args : Array[Expr],
  sp : Span,
) -> Ty {
  let arg_tys : Array[Ty] = []
  let mut i = 0
  while i < args.length() {
    arg_tys.push(check_expr(tc, env, args[i], None))
    i = i + 1
  }
  let mut has_world_arg = false
  if arg_tys.length() > 0 {
    match arg_tys[0] {
      TWorld => has_world_arg = true
      _ => ()
    }
  }
  if env.in_no_io {
    tc_err(
      tc,
      sp,
      "E_NO_IO_VIOLATION",
      "calling `" + name + "` is forbidden inside `#no_io` / `#render_thread` function `" + env.no_io_fn_name + "`",
      "non-blocking UI logic (no World IO)",
      "World IO call `" + name + "`",
      "send a command over `Channel` to a background worker thread (`spawn`) that owns `World`, then wake the render thread with the result",
    )
  } else if !env.has_world && !has_world_arg {
    tc_err(
      tc,
      sp,
      "E_CAPABILITY_MISSING",
      "calling `" + name + "` requires a `World` capability in scope",
      "World",
      "none",
      "add `world : World` parameter to the enclosing function",
    )
    if env.fn_lparen_span.line > 0 {
      let ins = if env.fn_has_params { "world : World, " } else { "world : World" }
      tc_add_edit(tc, text_edit_insert_maybe(env.fn_lparen_span, 1, ins))
    }
  }
  let offset = if has_world_arg { 1 } else { 0 }
  if name == "io_print" || name == "io_println" || name == "io_eprintln" {
    if arg_tys.length() > offset && !ty_compat(TString, arg_tys[offset]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`" + name + "` expects `String` argument",
        "String",
        ty_to_string(arg_tys[offset]),
        "pass a `String` value",
      )
    }
    TUnit
  } else if name == "io_read_line" {
    TOption(TString)
  } else if name == "fs_read" || name == "fs_lstat" || name == "fs_readlink" {
    TResult(TString, TString)
  } else if name == "fs_write" || name == "fs_append" {
    TResult(TUnit, TString)
  } else if name == "fs_read_bytes" {
    TResult(TBytes, TString)
  } else if name == "fs_read_range_nofollow" {
    if arg_tys.length() > offset && !ty_compat(TString, arg_tys[offset]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_read_range_nofollow` expects `String` path argument",
        "String",
        ty_to_string(arg_tys[offset]),
        "pass a `String` path",
      )
    }
    if arg_tys.length() > offset + 1 && !ty_compat(TInt64, arg_tys[offset + 1]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_read_range_nofollow` expects `Int64` offset argument",
        "Int64",
        ty_to_string(arg_tys[offset + 1]),
        "pass an `Int64` offset",
      )
    }
    if arg_tys.length() > offset + 2 && !ty_compat(TInt, arg_tys[offset + 2]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_read_range_nofollow` expects `Int` length argument",
        "Int",
        ty_to_string(arg_tys[offset + 2]),
        "pass an `Int` length",
      )
    }
    if arg_tys.length() > offset + 3 && !ty_compat(TInt64, arg_tys[offset + 3]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_read_range_nofollow` expects `Int64` expected_size argument",
        "Int64",
        ty_to_string(arg_tys[offset + 3]),
        "pass an `Int64` expected_size",
      )
    }
    TResult(TBytes, TString)
  } else if name == "fs_write_bytes" {
    if arg_tys.length() > offset + 1 && !ty_compat(TBytes, arg_tys[offset + 1]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_write_bytes` expects `Bytes` data argument",
        "Bytes",
        ty_to_string(arg_tys[offset + 1]),
        "pass a `Bytes` value",
      )
    }
    TResult(TUnit, TString)
  } else if name == "fs_mtime_ms" {
    TInt64
  } else if name == "fs_exists" || name == "fs_is_dir" || name == "fs_mkdir_p" || name == "fs_remove" || name == "fs_rename" || name == "fs_symlink" {
    TBool
  } else if name == "fs_chmod" {
    if arg_tys.length() > offset + 1 && !ty_compat(TInt, arg_tys[offset + 1]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`fs_chmod` expects `Int` mode argument",
        "Int",
        ty_to_string(arg_tys[offset + 1]),
        "pass an `Int` mode",
      )
    }
    TBool
  } else if name == "fs_size" {
    TInt64
  } else if name == "fs_list_dir" || name == "args_get" || name == "world_args" {
    TArray(TString)
  } else if name == "clock_now_ms" {
    TInt64
  } else if name == "proc_exec" || name == "world_argc" {
    TInt
  } else if name == "proc_exec_capture" {
    if arg_tys.length() > offset && !ty_compat(TArray(TString), arg_tys[offset]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`proc_exec_capture` expects `Array[String]` argv argument",
        "Array[String]",
        ty_to_string(arg_tys[offset]),
        "pass an `Array[String]`",
      )
    }
    TResult(TString, TString)
  } else if name == "proc_exec_capture_bytes" {
    if arg_tys.length() > offset && !ty_compat(TArray(TString), arg_tys[offset]) {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "`proc_exec_capture_bytes` expects `Array[String]` argv argument",
        "Array[String]",
        ty_to_string(arg_tys[offset]),
        "pass an `Array[String]`",
      )
    }
    TResult(TBytes, TString)
  } else if name == "world_argv" {
    TString
  } else if name == "env_get" {
    TOption(TString)
  } else {
    TUnit
  }
}

///|
pub struct CaptureInfo {
  name : String
  is_moved : Bool
  span : Span
}

///|
fn collect_pat_bindings(pat : Pattern, bound : Map[String, Bool]) -> Unit {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
    PIdent(n, _) => bound.set(n, true)
    PVariant(_, _, sub, _, _) => {
      let mut i = 0
      while i < sub.length() {
        collect_pat_bindings(sub[i], bound)
        i = i + 1
      }
    }
    PTuple(sub, _) => {
      let mut i = 0
      while i < sub.length() {
        collect_pat_bindings(sub[i], bound)
        i = i + 1
      }
    }
  }
}

///|
fn collect_stmts_captures(
  stmts : Array[Stmt],
  locals : Map[String, Bool],
  out : Array[CaptureInfo],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, _, _, init, _) => {
        collect_expr_captures(init, locals, out)
        locals.set(name, true)
      }
      SLetTuple(names, _, init, _) => {
        collect_expr_captures(init, locals, out)
        let mut ni = 0
        while ni < names.length() {
          if names[ni] != "_" {
            locals.set(names[ni], true)
          }
          ni = ni + 1
        }
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        collect_expr_captures(lhs, locals, out)
        collect_expr_captures(rhs, locals, out)
      }
      SGuard(cond, else_body, _) => {
        collect_expr_captures(cond, locals, out)
        let else_locals = locals.copy()
        collect_stmts_captures(else_body, else_locals, out)
        collect_cond_is_locals(cond, locals)
      }
      SWhile(cond, body, _) => {
        let body_locals = locals.copy()
        collect_cond_captures_with_is(cond, body_locals, out)
        collect_stmts_captures(body, body_locals, out)
      }
      SFor(init_s, cond, step_s, body, _) => {
        collect_stmts_captures([init_s], locals, out)
        collect_expr_captures(cond, locals, out)
        collect_stmts_captures([step_s], locals, out)
        collect_stmts_captures(body, locals, out)
      }
      SForRange(vname, start_e, end_e, _, body, _) => {
        collect_expr_captures(start_e, locals, out)
        collect_expr_captures(end_e, locals, out)
        let inner_locals = locals.copy()
        inner_locals.set(vname, true)
        collect_stmts_captures(body, inner_locals, out)
      }
      SForIn(idx_name, vname, iter_e, body, _) => {
        collect_expr_captures(iter_e, locals, out)
        let inner_locals = locals.copy()
        if idx_name != "" && idx_name != "_" {
          inner_locals.set(idx_name, true)
        }
        inner_locals.set(vname, true)
        collect_stmts_captures(body, inner_locals, out)
      }
      SReturn(opt, _) =>
        match opt {
          Some(e) => collect_expr_captures(e, locals, out)
          None => ()
        }
      SBreak(_) | SContinue(_) => ()
      SDebugAssert(c, m, _) => {
        collect_expr_captures(c, locals, out)
        collect_expr_captures(m, locals, out)
      }
      SExpr(e, _) => collect_expr_captures(e, locals, out)
    }
    i = i + 1
  }
}

///|
fn collect_expr_captures(
  e : Expr,
  locals : Map[String, Bool],
  out : Array[CaptureInfo],
) -> Unit {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EDouble(_, _) | EFloat(_, _) | EBool(_, _) => ()
    EByte(_, _) | EChar(_, _) | EString(_, _) | EUnit(_) | EPath(_, _, _) => ()
    EIdent(name, sp) =>
      if !locals.contains(name) {
        out.push(CaptureInfo::{ name: name, is_moved: false, span: sp })
      }
    EMove(inner, sp) =>
      match inner {
        EIdent(name, _) =>
          if !locals.contains(name) {
            out.push(CaptureInfo::{ name: name, is_moved: true, span: sp })
          }
        _ => collect_expr_captures(inner, locals, out)
      }
    EUnary(_, inner, _) => collect_expr_captures(inner, locals, out)
    EBinary(op, l, r, _) =>
      if op == "&&" && expr_has_is(l) {
        let and_locals = locals.copy()
        collect_cond_captures_with_is(l, and_locals, out)
        collect_expr_captures(r, and_locals, out)
      } else {
        collect_expr_captures(l, locals, out)
        collect_expr_captures(r, locals, out)
      }
    ECall(callee, args, _) => {
      collect_expr_captures(callee, locals, out)
      let mut i = 0
      while i < args.length() {
        collect_expr_captures(args[i], locals, out)
        i = i + 1
      }
    }
    EField(obj, _, _) => collect_expr_captures(obj, locals, out)
    EMethodCall(obj, _, args, _) => {
      collect_expr_captures(obj, locals, out)
      let mut i = 0
      while i < args.length() {
        collect_expr_captures(args[i], locals, out)
        i = i + 1
      }
    }
    EIndex(obj, idx, _) => {
      collect_expr_captures(obj, locals, out)
      collect_expr_captures(idx, locals, out)
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        collect_expr_captures(elems[i], locals, out)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => collect_expr_captures(base, locals, out)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        collect_expr_captures(fields[i].value, locals, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => {
      let blk_locals = locals.copy()
      collect_stmts_captures(stmts, blk_locals, out)
    }
    EIf(cond, then_s, else_opt, _) => {
      let then_locals = locals.copy()
      collect_cond_captures_with_is(cond, then_locals, out)
      collect_stmts_captures(then_s, then_locals, out)
      match else_opt {
        Some(el) => collect_expr_captures(el, locals, out)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      collect_expr_captures(scrut, locals, out)
      let mut i = 0
      while i < arms.length() {
        let arm_locals = locals.copy()
        collect_pat_bindings(arms[i].pat, arm_locals)
        match arms[i].guard_expr {
          Some(ge) => collect_cond_captures_with_is(ge, arm_locals, out)
          None => ()
        }
        collect_expr_captures(arms[i].body, arm_locals, out)
        i = i + 1
      }
    }
    EIs(scrut, _, _) => collect_expr_captures(scrut, locals, out)
    EClosure(params, _, body, _) => {
      let inner_locals = locals.copy()
      let mut i = 0
      while i < params.length() {
        inner_locals.set(params[i].name, true)
        i = i + 1
      }
      collect_stmts_captures(body, inner_locals, out)
    }
    EScope(w, f, _) => {
      collect_expr_captures(w, locals, out)
      collect_expr_captures(f, locals, out)
    }
    ESpawn(s, f, _) => {
      collect_expr_captures(s, locals, out)
      collect_expr_captures(f, locals, out)
    }
    EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      collect_expr_captures(inner, locals, out)
    EInterp(parts, _) | EDotVariant(_, parts, _) => {
      let mut i = 0
      while i < parts.length() {
        collect_expr_captures(parts[i], locals, out)
        i = i + 1
      }
    }
  }
}

///|
/// Inserts the missing arms (one per line, `panic`-bodied) before the first
/// existing arm, keeping its indentation.
fn add_missing_arms_edit(
  tc : TypeChecker,
  arms : Array[MatchArm],
  pats : Array[String],
) -> Unit {
  if arms.length() == 0 || pats.length() == 0 {
    return
  }
  let first = arms[0].span
  let indent = StringBuilder()
  let mut k = 1
  while k < first.col {
    indent.write_string(" ")
    k = k + 1
  }
  let ind = indent.to_string()
  let sb = StringBuilder()
  let mut i = 0
  while i < pats.length() {
    sb.write_string(pats[i])
    sb.write_string(" => panic(\"unhandled ")
    sb.write_string(pats[i])
    sb.write_string("\")\n")
    sb.write_string(ind)
    i = i + 1
  }
  tc_add_edit(tc, text_edit_insert_maybe(first, 0, sb.to_string()))
}

///|
fn pat_is_irrefutable(pat : Pattern) -> Bool {
  match pat {
    PWild(_) | PIdent(_, _) => true
    PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if !pat_is_irrefutable(subs[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///|
fn lookup_enum_info_for_match(tc : TypeChecker, ename : String) -> Option[EnumInfo] {
  match tc.enums.get(ename) {
    Some(ei) => Some(ei)
    None =>
      if has_qual_sep(ename) {
        let qpe = split_qual_name(ename)
        match lookup_imported_pkg_transitive(tc, qpe.prefix) {
          Some(ipkg) => ipkg.tc.enums.get(qpe.name)
          None => None
        }
      } else {
        None
      }
  }
}

///|
fn pat_matrix_splice_tys(col_tys : Array[Ty], c : Int, extra : Array[Ty]) -> Array[Ty] {
  let out : Array[Ty] = []
  let mut i = 0
  while i < c {
    out.push(col_tys[i])
    i = i + 1
  }
  i = 0
  while i < extra.length() {
    out.push(extra[i])
    i = i + 1
  }
  i = c + 1
  while i < col_tys.length() {
    out.push(col_tys[i])
    i = i + 1
  }
  out
}

///|
fn pat_matrix_splice_row(row : Array[Pattern], c : Int, extra : Array[Pattern]) -> Array[Pattern] {
  let out : Array[Pattern] = []
  let mut i = 0
  while i < c {
    out.push(row[i])
    i = i + 1
  }
  i = 0
  while i < extra.length() {
    out.push(extra[i])
    i = i + 1
  }
  i = c + 1
  while i < row.length() {
    out.push(row[i])
    i = i + 1
  }
  out
}

///|
fn pat_wilds(n : Int) -> Array[Pattern] {
  let out : Array[Pattern] = []
  let sp = span_new("", 0, 0)
  let mut i = 0
  while i < n {
    out.push(PWild(sp))
    i = i + 1
  }
  out
}

///|
/// Specialize pattern matrix `rows` on column `c`:
/// - `kind == 0`: tuple of length `arity`
/// - `kind == 1`: `Bool` (`ctor_name == "true"` or `"false"`)
/// - `kind == 2`: `PVariant` named `ctor_name` with `arity` payload patterns
/// - `kind == 3`: default (infinite type): keep only rows irrefutable at `c`
fn pat_matrix_specialize(
  tc : TypeChecker,
  rows : Array[Array[Pattern]],
  c : Int,
  kind : Int,
  ctor_name : String,
  arity : Int,
  want_enum : String,
) -> Array[Array[Pattern]] {
  let out : Array[Array[Pattern]] = []
  let mut r = 0
  while r < rows.length() {
    let row = rows[r]
    let cell = row[c]
    if kind == 0 {
      match cell {
        PTuple(sub, _) =>
          if sub.length() == arity {
            out.push(pat_matrix_splice_row(row, c, sub))
          }
        _ =>
          if pat_is_irrefutable(cell) {
            out.push(pat_matrix_splice_row(row, c, pat_wilds(arity)))
          }
      }
    } else if kind == 1 {
      let want_b = ctor_name == "true"
      match cell {
        PBool(b, _) =>
          if b == want_b {
            out.push(pat_matrix_splice_row(row, c, []))
          }
        _ =>
          if pat_is_irrefutable(cell) {
            out.push(pat_matrix_splice_row(row, c, []))
          }
      }
    } else if kind == 2 {
      match cell {
        PVariant(pat_enum, vn, sub, _, sp2) =>
          if !tc.resolved_method_calls.contains("pat_const:" + span_key(sp2)) {
            let pat_ok = if pat_enum == "" || want_enum == "" {
              true
            } else {
              canon_pat_enum_name(tc, pat_enum, vn, want_enum, tc.in_default_arg_expansion) == want_enum
            }
            if pat_ok && vn == ctor_name && sub.length() == arity {
              out.push(pat_matrix_splice_row(row, c, sub))
            }
          }
        _ =>
          if pat_is_irrefutable(cell) {
            out.push(pat_matrix_splice_row(row, c, pat_wilds(arity)))
          }
      }
    } else if pat_is_irrefutable(cell) {
      out.push(pat_matrix_splice_row(row, c, []))
    }
    r = r + 1
  }
  out
}

///|
/// Full Maranget-style recursive pattern matrix exhaustiveness check.
fn check_pat_matrix_covers(
  tc : TypeChecker,
  col_tys : Array[Ty],
  rows : Array[Array[Pattern]],
) -> Bool {
  if rows.length() == 0 {
    return false
  }
  let ncols = col_tys.length()
  if ncols == 0 {
    return true
  }
  // If any row is wholly irrefutable, the matrix covers every value.
  let mut r = 0
  while r < rows.length() {
    let mut all_irref = true
    let mut j = 0
    while j < ncols {
      if !pat_is_irrefutable(rows[r][j]) {
        all_irref = false
        break
      }
      j = j + 1
    }
    if all_irref {
      return true
    }
    r = r + 1
  }
  // Maranget heuristic: pick the column with the most refutable patterns (ties -> leftmost).
  let mut c = -1
  let mut best_ref = 0
  let mut ci = 0
  while ci < ncols {
    let mut ref_cnt = 0
    r = 0
    while r < rows.length() {
      if !pat_is_irrefutable(rows[r][ci]) {
        ref_cnt = ref_cnt + 1
      }
      r = r + 1
    }
    if ref_cnt > best_ref {
      best_ref = ref_cnt
      c = ci
    }
    ci = ci + 1
  }
  if c < 0 {
    return true
  }
  match col_tys[c] {
    TError | TNever => true
    TTuple(sub_tys) => {
      let n_tys = pat_matrix_splice_tys(col_tys, c, sub_tys)
      let n_rows = pat_matrix_specialize(tc, rows, c, 0, "", sub_tys.length(), "")
      check_pat_matrix_covers(tc, n_tys, n_rows)
    }
    TBool => {
      let n_tys = pat_matrix_splice_tys(col_tys, c, [])
      let t_rows = pat_matrix_specialize(tc, rows, c, 1, "true", 0, "")
      let f_rows = pat_matrix_specialize(tc, rows, c, 1, "false", 0, "")
      check_pat_matrix_covers(tc, n_tys, t_rows) &&
      check_pat_matrix_covers(tc, n_tys, f_rows)
    }
    TOption(inner) => {
      let none_tys = pat_matrix_splice_tys(col_tys, c, [])
      let some_tys = pat_matrix_splice_tys(col_tys, c, [inner])
      let none_rows = pat_matrix_specialize(tc, rows, c, 2, "None", 0, "Option")
      let some_rows = pat_matrix_specialize(tc, rows, c, 2, "Some", 1, "Option")
      check_pat_matrix_covers(tc, none_tys, none_rows) &&
      check_pat_matrix_covers(tc, some_tys, some_rows)
    }
    TResult(ok, err) => {
      let ok_tys = pat_matrix_splice_tys(col_tys, c, [ok])
      let err_tys = pat_matrix_splice_tys(col_tys, c, [err])
      let ok_rows = pat_matrix_specialize(tc, rows, c, 2, "Ok", 1, "Result")
      let err_rows = pat_matrix_specialize(tc, rows, c, 2, "Err", 1, "Result")
      check_pat_matrix_covers(tc, ok_tys, ok_rows) &&
      check_pat_matrix_covers(tc, err_tys, err_rows)
    }
    TEnum(ename, eargs) =>
      match lookup_enum_info_for_match(tc, ename) {
        None => true
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let ftys : Array[Ty] = []
            let mut fi = 0
            while fi < v.field_tys.length() {
              ftys.push(subst_ty(v.field_tys[fi], subst))
              fi = fi + 1
            }
            let v_tys = pat_matrix_splice_tys(col_tys, c, ftys)
            let v_rows = pat_matrix_specialize(tc, rows, c, 2, v.name, ftys.length(), ename)
            if !check_pat_matrix_covers(tc, v_tys, v_rows) {
              return false
            }
            vi = vi + 1
          }
          true
        }
      }
    _ => {
      let n_tys = pat_matrix_splice_tys(col_tys, c, [])
      let d_rows = pat_matrix_specialize(tc, rows, c, 3, "", 0, "")
      check_pat_matrix_covers(tc, n_tys, d_rows)
    }
  }
}

///|
fn enum_has_variant_name(ei : EnumInfo, vname : String) -> Bool {
  let mut i = 0
  while i < ei.variants.length() {
    if ei.variants[i].name == vname {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn canon_pat_enum_name(
  tc : TypeChecker,
  pat_enum : String,
  vname : String,
  want_enum : String,
  allow_transitive : Bool,
) -> String {
  if !has_qual_sep(pat_enum) {
    // Package-qualified variant shorthand `pkg::Variant` (including package aliases):
    // prefer `want_enum` when it belongs to `ipkg` and defines `vname` (disambiguates
    // shared variant names across enums in the same package), else fall back to
    // `ipkg.tc.variant_to_enum.get(vname)`.
    match resolve_pkg_for_lookup(tc, pat_enum, allow_transitive) {
      Some(ipkg) => {
        let prefix = ipkg.name + "::"
        if want_enum.length() > prefix.length() && starts_with_str(want_enum, prefix) {
          let short_en = slice_str(want_enum, prefix.length(), want_enum.length())
          match ipkg.tc.enums.get(short_en) {
            Some(ei) =>
              if enum_has_variant_name(ei, vname) {
                return want_enum
              }
            None => ()
          }
        }
        match ipkg.tc.variant_to_enum.get(vname) {
          Some(en) => return prefix + en
          None => ()
        }
      }
      None => ()
    }
    return pat_enum
  }
  let qp = split_qual_name(pat_enum)
  match resolve_pkg_for_lookup(tc, qp.prefix, allow_transitive) {
    Some(ipkg) => ipkg.name + "::" + qp.name
    None => pat_enum
  }
}

///|
fn check_pats_cover_ty(
  tc : TypeChecker,
  scrut_ty : Ty,
  pats : Array[Pattern],
) -> Bool {
  let rows : Array[Array[Pattern]] = []
  let mut i = 0
  while i < pats.length() {
    rows.push([pats[i]])
    i = i + 1
  }
  check_pat_matrix_covers(tc, [scrut_ty], rows)
}

///|
fn check_match_exhaustiveness(
  tc : TypeChecker,
  scrut_ty : Ty,
  arms : Array[MatchArm],
  sp : Span,
) -> Unit {
  let unguarded : Array[Pattern] = []
  let mut i = 0
  while i < arms.length() {
    let has_guard = match arms[i].guard_expr {
      Some(_) => true
      None => false
    }
    if !has_guard {
      if pat_is_irrefutable(arms[i].pat) {
        return
      }
      unguarded.push(arms[i].pat)
    }
    i = i + 1
  }
  match scrut_ty {
    TError | TNever => ()
    TBool => {
      let mut has_t = false
      let mut has_f = false
      i = 0
      while i < unguarded.length() {
        match unguarded[i] {
          PBool(true, _) => has_t = true
          PBool(false, _) => has_f = true
          _ => ()
        }
        i = i + 1
      }
      let missing : Array[String] = []
      if !has_t {
        missing.push("true")
      }
      if !has_f {
        missing.push("false")
      }
      if missing.length() > 0 {
        let miss_str = join_strs(missing, ", ")
        tc_err(
          tc,
          sp,
          "E_NON_EXHAUSTIVE",
          "non-exhaustive `match` on `Bool`: missing " + miss_str,
          "exhaustive match",
          "missing " + miss_str,
          "add missing match arm(s): " + miss_str + " => ...",
        )
        add_missing_arms_edit(tc, arms, missing)
      }
    }
    TOption(inner) => {
      let mut has_none = false
      let some_subs : Array[Pattern] = []
      i = 0
      while i < unguarded.length() {
        match unguarded[i] {
          PVariant(_, vname, sub, _, _) =>
            if vname == "None" && sub.length() == 0 {
              has_none = true
            } else if vname == "Some" && sub.length() == 1 {
              some_subs.push(sub[0])
            }
          _ => ()
        }
        i = i + 1
      }
      let missing : Array[String] = []
      if !check_pats_cover_ty(tc, inner, some_subs) {
        missing.push("Some(_)")
      }
      if !has_none {
        missing.push("None")
      }
      if missing.length() > 0 {
        let miss_str = join_strs(missing, ", ")
        tc_err(
          tc,
          sp,
          "E_NON_EXHAUSTIVE",
          "non-exhaustive `match` on `Option`: missing " + miss_str,
          "exhaustive match",
          "missing " + miss_str,
          "add missing match arm(s): " + miss_str + " => ...",
        )
        add_missing_arms_edit(tc, arms, missing)
      }
    }
    TResult(ok, err) => {
      let ok_subs : Array[Pattern] = []
      let err_subs : Array[Pattern] = []
      i = 0
      while i < unguarded.length() {
        match unguarded[i] {
          PVariant(_, vname, sub, _, _) =>
            if vname == "Ok" && sub.length() == 1 {
              ok_subs.push(sub[0])
            } else if vname == "Err" && sub.length() == 1 {
              err_subs.push(sub[0])
            }
          _ => ()
        }
        i = i + 1
      }
      let missing : Array[String] = []
      if !check_pats_cover_ty(tc, ok, ok_subs) {
        missing.push("Ok(_)")
      }
      if !check_pats_cover_ty(tc, err, err_subs) {
        missing.push("Err(_)")
      }
      if missing.length() > 0 {
        let miss_str = join_strs(missing, ", ")
        tc_err(
          tc,
          sp,
          "E_NON_EXHAUSTIVE",
          "non-exhaustive `match` on `Result`: missing " + miss_str,
          "exhaustive match",
          "missing " + miss_str,
          "add missing match arm(s): " + miss_str + " => ...",
        )
        add_missing_arms_edit(tc, arms, missing)
      }
    }
    TEnum(ename, eargs) =>
      match lookup_enum_info_for_match(tc, ename) {
        None => ()
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let missing : Array[String] = []
          let missing_pats : Array[String] = []
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let nf = v.field_tys.length()
            let covered_v = if nf == 0 {
              let mut hit = false
              i = 0
              while i < unguarded.length() {
                match unguarded[i] {
                  PVariant(_, vn, sub, _, sp2) =>
                    if !tc.resolved_method_calls.contains("pat_const:" + span_key(sp2)) &&
                      vn == v.name &&
                      sub.length() == 0 {
                      hit = true
                      break
                    }
                  _ => ()
                }
                i = i + 1
              }
              hit
            } else if nf == 1 {
              let subs : Array[Pattern] = []
              i = 0
              while i < unguarded.length() {
                match unguarded[i] {
                  PVariant(_, vn, sub, _, sp2) =>
                    if !tc.resolved_method_calls.contains("pat_const:" + span_key(sp2)) &&
                      vn == v.name &&
                      sub.length() == 1 {
                      subs.push(sub[0])
                    }
                  _ => ()
                }
                i = i + 1
              }
              check_pats_cover_ty(tc, subst_ty(v.field_tys[0], subst), subs)
            } else {
              let ftys : Array[Ty] = []
              let mut fi = 0
              while fi < nf {
                ftys.push(subst_ty(v.field_tys[fi], subst))
                fi = fi + 1
              }
              let subs : Array[Pattern] = []
              i = 0
              while i < unguarded.length() {
                match unguarded[i] {
                  PVariant(_, vn, sub, _, sp2) =>
                    if !tc.resolved_method_calls.contains("pat_const:" + span_key(sp2)) &&
                      vn == v.name &&
                      sub.length() == nf {
                      subs.push(PTuple(sub, sp2))
                    }
                  _ => ()
                }
                i = i + 1
              }
              check_pats_cover_ty(tc, TTuple(ftys), subs)
            }
            if !covered_v {
              missing.push(v.name)
              if nf == 0 {
                missing_pats.push(v.name)
              } else {
                let psb = StringBuilder()
                psb.write_string(v.name)
                psb.write_string("(")
                let mut fj = 0
                while fj < nf {
                  if fj > 0 {
                    psb.write_string(", ")
                  }
                  psb.write_string("_")
                  fj = fj + 1
                }
                psb.write_string(")")
                missing_pats.push(psb.to_string())
              }
            }
            vi = vi + 1
          }
          if missing.length() > 0 {
            let miss_str = join_strs(missing, ", ")
            tc_err(
              tc,
              sp,
              "E_NON_EXHAUSTIVE",
              "non-exhaustive `match` on `" + ename + "`: missing " + miss_str,
              "exhaustive match",
              "missing " + miss_str,
              "add missing match arm(s): " + miss_str + " => ...",
            )
            add_missing_arms_edit(tc, arms, missing_pats)
          }
        }
      }
    TTuple(_) =>
      if !check_pats_cover_ty(tc, scrut_ty, unguarded) {
        tc_err(
          tc,
          sp,
          "E_NON_EXHAUSTIVE",
          "non-exhaustive `match` on `" + ty_to_string(scrut_ty) + "`",
          "exhaustive match",
          "missing wildcard `_`",
          "add a wildcard arm `_ => ...`",
        )
      }
    _ =>
      tc_err(
        tc,
        sp,
        "E_NON_EXHAUSTIVE",
        "non-exhaustive `match` on `" + ty_to_string(scrut_ty) + "`",
        "exhaustive match",
        "missing wildcard `_`",
        "add a wildcard arm `_ => ...`",
      )
  }
}

///|
pub fn parse_tuple_index(s : String) -> Int {
  let n = s.length()
  if n == 0 {
    return -1
  }
  let mut acc = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return -1
    }
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

///|
fn join_strs(items : Array[String], sep : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < items.length() {
    if i > 0 {
      sb.write_string(sep)
    }
    sb.write_string(items[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn bind_pattern(
  tc : TypeChecker,
  env : Env,
  pat : Pattern,
  scrut_ty : Ty,
) -> Unit {
  match pat {
    PWild(_) => ()
    PIdent(name, psp) => {
      env_define_line(env, name, scrut_ty, false, psp.line)
      if env.in_verify {
        tc.expr_tys.set(span_key(psp), scrut_ty)
      }
    }
    PBool(_, sp) =>
      if !ty_compat(TBool, scrut_ty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "bool pattern cannot match `" + ty_to_string(scrut_ty) + "`",
          "Bool",
          ty_to_string(scrut_ty),
          "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
        )
      }
    PInt(_, sp) =>
      if !ty_compat(TInt, scrut_ty) &&
        !ty_compat(TInt64, scrut_ty) &&
        !ty_compat(TUInt, scrut_ty) &&
        !ty_compat(TUInt64, scrut_ty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "integer pattern cannot match `" + ty_to_string(scrut_ty) + "`",
          "Int",
          ty_to_string(scrut_ty),
          "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
        )
      }
    PString(_, sp) =>
      if !ty_compat(TString, scrut_ty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "string pattern cannot match `" + ty_to_string(scrut_ty) + "`",
          "String",
          ty_to_string(scrut_ty),
          "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
        )
      }
    PChar(_, sp) =>
      if !ty_compat(TChar, scrut_ty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "char pattern cannot match `" + ty_to_string(scrut_ty) + "`",
          "Char",
          ty_to_string(scrut_ty),
          "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
        )
      }
    PTuple(sub, sp) =>
      match scrut_ty {
        TTuple(elems) => {
          if sub.length() != elems.length() {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "tuple pattern has " +
              sub.length().to_string() +
              " element(s), but scrutinee `" +
              ty_to_string(scrut_ty) +
              "` has " +
              elems.length().to_string(),
              elems.length().to_string() + " tuple elements",
              sub.length().to_string() + " tuple elements",
              "match the tuple pattern length to `" + ty_to_string(scrut_ty) + "`",
            )
          }
          let mut i = 0
          while i < sub.length() && i < elems.length() {
            bind_pattern(tc, env, sub[i], elems[i])
            i = i + 1
          }
        }
        TUnit =>
          if sub.length() != 0 {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "tuple pattern cannot match `" + ty_to_string(scrut_ty) + "`",
              "tuple",
              ty_to_string(scrut_ty),
              "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
            )
          }
        TError => ()
        _ =>
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "tuple pattern cannot match `" + ty_to_string(scrut_ty) + "`",
            "tuple",
            ty_to_string(scrut_ty),
            "use a pattern matching `" + ty_to_string(scrut_ty) + "`",
          )
      }
    PVariant(pat_enum, vname, sub, explicit_ctor, sp) => {
      let const_pat_fix = "uppercase identifiers in patterns match variants or constants; use a lowercase name to bind a variable"
      let pat_disp = if pat_enum != "" { pat_enum + "::" + vname } else { vname }
      let scrut_enum = match scrut_ty {
        TEnum(en, _) => en
        _ => ""
      }
      let canon_pat_enum = if pat_enum != "" {
        canon_pat_enum_name(tc, pat_enum, vname, scrut_enum, env.in_default_arg)
      } else {
        ""
      }
      if pat_enum != "" && !env.in_default_arg {
        if has_qual_sep(pat_enum) {
          let qp_p = split_qual_name(pat_enum)
          match resolve_pkg_for_lookup(tc, qp_p.prefix, false) {
            Some(ipkg) =>
              match ipkg.tc.enums.get(qp_p.name) {
                Some(ei) =>
                  if !ei.decl.is_pub {
                    emit_private_err(tc, sp, "enum", ipkg.name, qp_p.name)
                  }
                None => ()
              }
            None =>
              if !is_caller_alias_redirected(tc, pat_enum) &&
                tc.priv_imported_types.contains(pat_enum) {
                emit_private_err(tc, sp, "enum", qp_p.prefix, qp_p.name)
              }
          }
        } else if has_qual_sep(canon_pat_enum) {
          let qp_c = split_qual_name(canon_pat_enum)
          match resolve_pkg_for_lookup(tc, pat_enum, false) {
            Some(ipkg) =>
              match ipkg.tc.enums.get(qp_c.name) {
                Some(ei) =>
                  if !ei.decl.is_pub {
                    emit_private_err(tc, sp, "enum", ipkg.name, qp_c.name)
                  }
                None => ()
              }
            None => ()
          }
        } else if tc.priv_imported_types.contains(pat_enum) {
          let qp_p = split_qual_name(pat_enum)
          emit_private_err(tc, sp, "enum", qp_p.prefix, qp_p.name)
        }
      }
      match scrut_ty {
        TOption(inner) => {
          if canon_pat_enum != "" && canon_pat_enum != "Option" {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "pattern enum `" + canon_pat_enum + "` does not match scrutinee type `Option`",
              "Option",
              canon_pat_enum,
              "use `Option::" + vname + "` or `" + vname + "`",
            )
            return
          }
          if vname == "Some" {
            if sub.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Some` expects 1 pattern argument(s), found " + sub.length().to_string(),
                "1 pattern argument",
                sub.length().to_string() + " pattern arguments",
                "write `Some(pat)` with 1 pattern",
              )
            }
            if sub.length() >= 1 {
              bind_pattern(tc, env, sub[0], inner)
            }
          } else if vname == "None" {
            if sub.length() != 0 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `None` expects 0 pattern argument(s), found " + sub.length().to_string(),
                "0 pattern arguments",
                sub.length().to_string() + " pattern arguments",
                "write `None` with no arguments",
              )
            }
          } else {
            tc_err(
              tc,
              sp,
              "E_UNKNOWN_VARIANT",
              "enum `Option` has no variant `" + vname + "`",
              "valid variant of `Option`",
              vname,
              "use `Some(...)` or `None`",
            )
          }
        }
        TResult(ok, err) => {
          if canon_pat_enum != "" && canon_pat_enum != "Result" {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "pattern enum `" + canon_pat_enum + "` does not match scrutinee type `Result`",
              "Result",
              canon_pat_enum,
              "use `Result::" + vname + "` or `" + vname + "`",
            )
            return
          }
          if vname == "Ok" {
            if sub.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Ok` expects 1 pattern argument(s), found " + sub.length().to_string(),
                "1 pattern argument",
                sub.length().to_string() + " pattern arguments",
                "write `Ok(pat)` with 1 pattern",
              )
            }
            if sub.length() >= 1 {
              bind_pattern(tc, env, sub[0], ok)
            }
          } else if vname == "Err" {
            if sub.length() != 1 {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                "variant `Err` expects 1 pattern argument(s), found " + sub.length().to_string(),
                "1 pattern argument",
                sub.length().to_string() + " pattern arguments",
                "write `Err(pat)` with 1 pattern",
              )
            }
            if sub.length() >= 1 {
              bind_pattern(tc, env, sub[0], err)
            }
          } else {
            tc_err(
              tc,
              sp,
              "E_UNKNOWN_VARIANT",
              "enum `Result` has no variant `" + vname + "`",
              "valid variant of `Result`",
              vname,
              "use `Ok(...)` or `Err(...)`",
            )
          }
        }
        TEnum(ename, args) => {
          let einfo_opt = lookup_enum_info_for_match(tc, ename)
          let mut hit_variant = false
          if canon_pat_enum == "" || canon_pat_enum == ename {
            match einfo_opt {
              Some(einfo) => {
                let subst = make_subst(einfo.decl.type_params, args)
                let mut vi = 0
                while vi < einfo.variants.length() {
                  let v = einfo.variants[vi]
                  if v.name == vname {
                    hit_variant = true
                    if sub.length() != v.field_tys.length() {
                      tc_err(
                        tc,
                        sp,
                        "E_TYPE_MISMATCH",
                        "variant `" +
                        vname +
                        "` expects " +
                        v.field_tys.length().to_string() +
                        " pattern argument(s), found " +
                        sub.length().to_string(),
                        v.field_tys.length().to_string() + " pattern arguments",
                        sub.length().to_string() + " pattern arguments",
                        "match the pattern count to variant `" + vname + "`",
                      )
                    }
                    let mut fi = 0
                    while fi < sub.length() && fi < v.field_tys.length() {
                      let fty = subst_ty(v.field_tys[fi], subst)
                      bind_pattern(tc, env, sub[fi], fty)
                      fi = fi + 1
                    }
                    break
                  }
                  vi = vi + 1
                }
              }
              None => ()
            }
          }
          if hit_variant {
            return
          }
          if !explicit_ctor && sub.length() == 0 {
            match resolve_const_pat(tc, env, pat_enum, vname, sp) {
              Some((cty, canon_key)) => {
                if !ty_is_const_pat_allowed(tc, cty) {
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "constant `" + pat_disp + "` of type `" + ty_to_string(cty) + "` cannot be used as a pattern",
                    ty_to_string(scrut_ty),
                    ty_to_string(cty),
                    const_pat_fix,
                  )
                } else if !ty_compat(cty, scrut_ty) {
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "constant pattern `" + pat_disp + "` has type `" + ty_to_string(cty) + "`, expected `" + ty_to_string(scrut_ty) + "`",
                    ty_to_string(scrut_ty),
                    ty_to_string(cty),
                    const_pat_fix,
                  )
                } else {
                  tc.resolved_method_calls.set("pat_const:" + span_key(sp), canon_key)
                }
                return
              }
              None => ()
            }
          }
          if canon_pat_enum != "" && canon_pat_enum != ename {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "pattern enum `" + canon_pat_enum + "` does not match scrutinee enum `" + ename + "`",
              ename,
              canon_pat_enum,
              "match against a variant of `" + ename + "`",
            )
            return
          }
          match einfo_opt {
            Some(_) =>
              tc_err(
                tc,
                sp,
                "E_UNKNOWN_VARIANT",
                "enum `" + ename + "` has no variant `" + vname + "`",
                "valid variant of `" + ename + "`",
                vname,
                "check the variant name on enum `" + ename + "`",
              )
            None => ()
          }
        }
        TError | TNever => ()
        TParam(_) =>
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "pattern `" + pat_disp + "` cannot match generic type parameter `" + ty_to_string(scrut_ty) + "`",
            "concrete pattern type",
            ty_to_string(scrut_ty),
            const_pat_fix,
          )
        _ =>
          if !explicit_ctor && sub.length() == 0 {
            match resolve_const_pat(tc, env, pat_enum, vname, sp) {
              Some((cty, canon_key)) =>
                if !ty_is_const_pat_allowed(tc, cty) {
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "constant `" + pat_disp + "` of type `" + ty_to_string(cty) + "` cannot be used as a pattern",
                    "supported constant pattern type",
                    ty_to_string(cty),
                    const_pat_fix,
                  )
                } else if !ty_compat(cty, scrut_ty) {
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "constant pattern `" + pat_disp + "` has type `" + ty_to_string(cty) + "`, expected `" + ty_to_string(scrut_ty) + "`",
                    ty_to_string(scrut_ty),
                    ty_to_string(cty),
                    const_pat_fix,
                  )
                } else {
                  tc.resolved_method_calls.set("pat_const:" + span_key(sp), canon_key)
                }
              None =>
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "pattern `" + pat_disp + "` cannot match `" + ty_to_string(scrut_ty) + "`",
                  ty_to_string(scrut_ty),
                  pat_disp,
                  const_pat_fix,
                )
            }
          } else {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "variant pattern `" + pat_disp + "` cannot match `" + ty_to_string(scrut_ty) + "`",
              ty_to_string(scrut_ty),
              pat_disp,
              const_pat_fix,
            )
          }
      }
    }
  }
}

///|
///|
fn ty_is_const_pat_allowed(tc : TypeChecker, ty : Ty) -> Bool {
  match ty {
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TByte
    | TInt8
    | TChar
    | TBool
    | TString
    | TStrView => true
    TEnum(ename, _) =>
      match lookup_enum_info_for_match(tc, ename) {
        Some(einfo) => {
          if einfo.variants.length() == 0 {
            return false
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            if einfo.variants[vi].field_tys.length() > 0 {
              return false
            }
            vi = vi + 1
          }
          true
        }
        None => false
      }
    _ => false
  }
}

///|
fn resolve_const_pat(
  tc : TypeChecker,
  env : Env,
  pat_enum : String,
  vname : String,
  sp : Span,
) -> Option[(Ty, String)] {
  if pat_enum == "" {
    match tc.consts.get(vname) {
      Some(cty) => Some((cty, vname))
      None => None
    }
  } else if starts_with_str(pat_enum, "@canon:") {
    let owner_pkg = slice_str(pat_enum, 7, pat_enum.length())
    if owner_pkg == tc.pkg_name {
      match tc.consts.get(vname) {
        Some(cty) => Some((cty, vname))
        None => None
      }
    } else {
      match lookup_imported_pkg_transitive(tc, owner_pkg) {
        Some(ipkg) =>
          match ipkg.tc.consts.get(vname) {
            Some(cty) => Some((qualify_imported_ty(ipkg.name, cty), ipkg.name + "::" + vname))
            None => None
          }
        None => None
      }
    }
  } else if !has_qual_sep(pat_enum) {
    match resolve_pkg_for_lookup(tc, pat_enum, env.in_default_arg) {
      Some(ipkg) =>
        match ipkg.tc.consts.get(vname) {
          Some(cty) => {
            let is_p = match ipkg.tc.const_pub.get(vname) {
              Some(b) => b
              None => false
            }
            if !is_p && !env.in_default_arg {
              emit_private_err(tc, sp, "let", ipkg.name, vname)
            }
            Some((qualify_imported_ty(ipkg.name, cty), ipkg.name + "::" + vname))
          }
          None => None
        }
      None => None
    }
  } else {
    None
  }
}

///|
fn check_stmts(
  tc : TypeChecker,
  env : Env,
  stmts : Array[Stmt],
  expected : Option[Ty],
) -> Ty {
  check_stmts_ex(tc, env, stmts, expected, true)
}

///|
/// `tail_used` is false for bodies whose tail value is discarded (loop and
/// test bodies): there the tail statement is also checked for an unhandled
/// `Result`.
fn check_stmts_ex(
  tc : TypeChecker,
  env : Env,
  stmts : Array[Stmt],
  expected : Option[Ty],
  tail_used : Bool,
) -> Ty {
  if stmts.length() == 0 {
    return TUnit
  }
  let mut i = 0
  let mut last_ty = TUnit
  let pending_keys : Array[String] = []
  let pending_lets : Array[Stmt] = []
  while i < stmts.length() {
    let is_last = i == stmts.length() - 1
    let exp = if is_last { expected } else { None }
    match stmts[i] {
      SLet(name, is_mut, TyMissing(tsp), init, sp) =>
        if name != "_" && infer_empty_kind(init) != 0 {
          let hint = infer_let_hint(env, stmts, i, name, expected, tail_used)
          last_ty = check_let(tc, env, name, is_mut, TyMissing(tsp), init, sp, hint)
          if tc.infer_pending.contains(span_key(sp)) {
            pending_keys.push(span_key(sp))
            pending_lets.push(stmts[i])
          }
        } else {
          last_ty = check_stmt(tc, env, stmts[i], exp)
        }
      _ => last_ty = check_stmt(tc, env, stmts[i], exp)
    }
    if !is_last || !tail_used {
      check_unhandled_result(tc, stmts[i], last_ty)
    }
    i = i + 1
  }
  let mut pi = 0
  while pi < pending_keys.length() {
    if tc.infer_pending.contains(pending_keys[pi]) {
      tc.infer_pending.remove(pending_keys[pi])
      match pending_lets[pi] {
        SLet(name, _, _, init, sp) => infer_missing_type_err(tc, name, init, sp)
        _ => ()
      }
    }
    pi = pi + 1
  }
  // When a block expects `Unit`, implicitly discard a non-`Result` tail expression;
  // an unhandled `Result` in tail position still triggers `E_UNHANDLED_RESULT`.
  match expected {
    Some(TUnit) =>
      match stmts[stmts.length() - 1] {
        SExpr(_, _) =>
          match last_ty {
            TUnit | TError | TNever => ()
            TResult(_, _) => {
              if tail_used {
                check_unhandled_result(tc, stmts[stmts.length() - 1], last_ty)
              }
              last_ty = TUnit
            }
            _ => last_ty = TUnit
          }
        _ => ()
      }
    _ => ()
  }
  last_ty
}

///|
/// `Map()`, `Map([])`, `Map([(k, v), ..])` and `Map(pairs)` (`Array[(K, V)]`).
fn check_map_init(
  tc : TypeChecker,
  env : Env,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> Ty {
  let t = check_map_init_ty(tc, env, args, expected, sp)
  if args.length() == 1 {
    // Codegen picks the runtime map from this type.
    tc.let_infer.set(span_key(sp) + "#map", t)
  }
  t
}

///|
fn check_map_init_ty(
  tc : TypeChecker,
  env : Env,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> Ty {
  if args.length() > 1 {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "`Map` expects at most 1 argument, found " + args.length().to_string(),
      "0 or 1 args",
      args.length().to_string() + " args",
      "pass one array of pairs: `Map([(k, v), ..])`",
    )
  }
  let default_ty = match expected {
    Some(TMap(k, v)) => TMap(k, v)
    _ => TMap(TString, TError)
  }
  if args.length() != 1 {
    let mut i = 0
    while i < args.length() {
      let _ = check_expr(tc, env, args[i], None)
      i = i + 1
    }
    return default_ty
  }
  match args[0] {
    EArrayLit(elems, _) => if elems.length() == 0 { return default_ty }
    _ => ()
  }
  let want : Option[Ty] = match expected {
    Some(TMap(k, v)) => Some(TArray(TTuple([k, v])))
    _ => None
  }
  let got = check_expr(tc, env, args[0], want)
  match want {
    Some(wt) => {
      if !ty_compat(wt, got) {
        tc_err(
          tc,
          expr_span(args[0]),
          "E_TYPE_MISMATCH",
          "`Map` initializer type mismatch",
          ty_to_string(wt),
          ty_to_string(got),
          "pass `(key, value)` pairs of the map's key and value types",
        )
      }
      match got {
        TArray(TTuple(kv)) =>
          if kv.length() == 2 && ty_has_unresolved(default_ty) {
            return ty_prefer_concrete(default_ty, TMap(kv[0], kv[1]))
          }
        _ => ()
      }
      default_ty
    }
    None =>
      match got {
        TArray(TTuple(kv)) =>
          if kv.length() == 2 {
            record_map_key_tparams(tc, tc.cur_fn_key, kv[0])
            if !is_valid_map_key_ty(tc, kv[0]) {
              tc_err(
                tc,
                expr_span(args[0]),
                "E_MAP_KEY_TYPE",
                "`Map` keys must be `String`, an integer/char/bool scalar, or an immutable pure-scalar tuple/POD struct (1..6 fields), got `" +
                ty_to_string(kv[0]) +
                "`",
                "String, scalar integer/char/bool, or immutable pure-scalar tuple/struct",
                ty_to_string(kv[0]),
                "use a supported scalar, tuple, or immutable POD struct key",
              )
            }
            if ty_has_unresolved(kv[0]) || ty_has_unresolved(kv[1]) {
              tc_err(
                tc,
                expr_span(args[0]),
                "E_MISSING_TYPE",
                "cannot infer key/value types of `Map` initializer",
                "Map[K, V]",
                ty_to_string(TMap(kv[0], kv[1])),
                "add a `Map[K, V]` type annotation",
              )
            }
            TMap(kv[0], kv[1])
          } else {
            map_init_shape_err(tc, args[0], got)
          }
        TError | TNever => default_ty
        _ => map_init_shape_err(tc, args[0], got)
      }
  }
}

///|
fn map_init_shape_err(tc : TypeChecker, arg : Expr, got : Ty) -> Ty {
  tc_err(
    tc,
    expr_span(arg),
    "E_TYPE_MISMATCH",
    "`Map` initializer must be an array of `(key, value)` pairs",
    "Array[(K, V)]",
    ty_to_string(got),
    "pass `(key, value)` pairs: `Map([(k, v), ..])`",
  )
  TMap(TString, TError)
}

///|
/// 1 for an empty array initializer (`[]`, `Array::new()`, `Array::with_capacity(n)`),
/// 2 for an empty map (`Map([])`, `Map()`, `Map::new()`, `Map::with_capacity(n)`),
/// 3 for an untyped `None` (`None`, `Option::None`), 0 otherwise.
fn infer_empty_kind(init : Expr) -> Int {
  match init {
    EArrayLit(elems, _) => if elems.length() == 0 { 1 } else { 0 }
    ECall(EIdent("Map", _), args, _) =>
      if args.length() == 0 {
        2
      } else if args.length() == 1 {
        match args[0] {
          EArrayLit(elems, _) => if elems.length() == 0 { 2 } else { 0 }
          _ => 0
        }
      } else {
        0
      }
    ECall(EPath("Map", "new", _), args, _) => if args.length() == 0 { 2 } else { 0 }
    ECall(EPath("Map", "with_capacity", _), args, _) => if args.length() == 1 { 2 } else { 0 }
    ECall(EPath("Array", "new", _), args, _) => if args.length() == 0 { 1 } else { 0 }
    ECall(EPath("Array", "with_capacity", _), args, _) => if args.length() == 1 { 1 } else { 0 }
    ECall(EPath("ImmArray", "new", _), args, _) => if args.length() == 0 { 4 } else { 0 }
    EIdent("None", _) => 3
    EPath("Option", "None", _) => 3
    _ => 0
  }
}

///|
fn infer_kind_fits(kind : Int, t : Ty) -> Bool {
  if ty_has_unresolved(t) {
    return false
  }
  match t {
    TArray(_) | TFixedArray(_) => kind == 1
    TImmArray(_) => kind == 1 || kind == 4
    TMap(_, _) => kind == 2
    TOption(_) => kind == 3
    _ => false
  }
}

///|
/// Type an unannotated empty collection `let` takes from how it leaves its
/// block: the block's tail expression is `name` (block type `expected`), or a
/// later `return name` (the enclosing fn's return type). Pushes are handled
/// later by refinement on the first `push` / `set`.
fn infer_let_hint(
  env : Env,
  stmts : Array[Stmt],
  idx : Int,
  name : String,
  expected : Option[Ty],
  tail_used : Bool,
) -> Option[Ty] {
  let kind = infer_empty_kind(
    match stmts[idx] {
      SLet(_, _, _, init, _) => init
      _ => EUnit(span_empty())
    },
  )
  let last = stmts.length() - 1
  if tail_used && last > idx && !infer_stmts_shadow(stmts, idx + 1, last, name) {
    match stmts[last] {
      SExpr(EIdent(n, _), _) =>
        if n == name {
          match expected {
            Some(t) => if infer_kind_fits(kind, t) { return Some(t) }
            None => ()
          }
        }
      _ => ()
    }
  }
  if infer_kind_fits(kind, env.ret_ty) &&
    infer_stmts_return(stmts, idx + 1, name) {
    return Some(env.ret_ty)
  }
  None
}

///|
/// Whether `stmts[from..to)` rebinds `name` (so later uses refer elsewhere).
fn infer_stmts_shadow(
  stmts : Array[Stmt],
  from : Int,
  to : Int,
  name : String,
) -> Bool {
  let mut i = from
  while i < to {
    if infer_stmt_binds(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn infer_stmt_binds(st : Stmt, name : String) -> Bool {
  match st {
    SLet(n, _, _, _, _) => n == name
    SLetTuple(ns, _, _, _) => str_arr_contains(ns, name)
    _ => false
  }
}

///|
/// Whether `stmts[from..]` contains `return name` for this binding (descending
/// into nested blocks, branches and loops, not closures; stops at a rebinding).
fn infer_stmts_return(stmts : Array[Stmt], from : Int, name : String) -> Bool {
  let mut i = from
  while i < stmts.length() {
    let st = stmts[i]
    match st {
      SReturn(Some(EIdent(n, _)), _) => if n == name { return true }
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        if infer_expr_return(init, name) {
          return true
        }
      SAssign(_, rhs, _) | SCompoundAssign(_, _, rhs, _) =>
        if infer_expr_return(rhs, name) {
          return true
        }
      SGuard(c, body, _) | SWhile(c, body, _) =>
        if infer_expr_return(c, name) || infer_stmts_return(body, 0, name) {
          return true
        }
      SFor(_, c, _, body, _) =>
        if infer_expr_return(c, name) || infer_stmts_return(body, 0, name) {
          return true
        }
      SForRange(v, _, _, _, body, _) =>
        if v != name && infer_stmts_return(body, 0, name) {
          return true
        }
      SForIn(k, v, _, body, _) =>
        if k != name && v != name && infer_stmts_return(body, 0, name) {
          return true
        }
      SExpr(e, _) => if infer_expr_return(e, name) { return true }
      _ => ()
    }
    if infer_stmt_binds(st, name) {
      return false
    }
    i = i + 1
  }
  false
}

///|
fn infer_expr_return(e : Expr, name : String) -> Bool {
  match e {
    EBlock(stmts, _) => infer_stmts_return(stmts, 0, name)
    EIf(c, then_s, else_e, _) =>
      infer_expr_return(c, name) ||
      infer_stmts_return(then_s, 0, name) ||
      (match else_e {
        Some(el) => infer_expr_return(el, name)
        None => false
      })
    EMatch(scrut, arms, _) => {
      if infer_expr_return(scrut, name) {
        return true
      }
      let mut ai = 0
      while ai < arms.length() {
        if infer_expr_return(arms[ai].body, name) {
          return true
        }
        ai = ai + 1
      }
      false
    }
    _ => false
  }
}

///|
fn infer_missing_type_err(
  tc : TypeChecker,
  name : String,
  init : Expr,
  sp : Span,
) -> Unit {
  let kind = infer_empty_kind(init)
  if kind == 2 {
    tc_err(
      tc,
      sp,
      "E_MISSING_TYPE",
      "cannot infer the key/value types of empty map `" + name + "`",
      "Map[K, V]",
      "Map[?, ?]",
      "annotate it (`let " + name + " : Map[K, V] = Map([])`), or `set` an entry / return it as `Map[K, V]` in the same block",
    )
  } else if kind == 3 {
    tc_err(
      tc,
      sp,
      "E_MISSING_TYPE",
      "cannot infer the inner type of `None` binding `" + name + "`",
      "Option[T]",
      "Option[?]",
      "annotate it (`let " + name + " : Option[T] = None`), or assign/pass/return it as `Option[T]` in the same block",
    )
  } else {
    tc_err(
      tc,
      sp,
      "E_MISSING_TYPE",
      "cannot infer the element type of empty array `" + name + "`",
      "Array[T]",
      "Array[?]",
      "annotate it (`let " + name + " : Array[T] = []`), or `push` a value / return it as `Array[T]` in the same block",
    )
  }
}

///|
/// After a method call on `obj`: an unannotated empty collection binding whose
/// element type was unknown takes it from the first `push` / `set`.
fn infer_refine_call(
  tc : TypeChecker,
  env : Env,
  obj : Expr,
  recv_ty : Ty,
  method_name : String,
) -> Unit {
  if tc.infer_hit.length() == 0 {
    return
  }
  let hit : Array[Ty] = []
  let mut hi = 0
  while hi < tc.infer_hit.length() {
    hit.push(tc.infer_hit[hi])
    hi = hi + 1
  }
  tc.infer_hit.clear()
  let new_ty = match recv_ty {
    TArray(_) => if method_name == "push" && hit.length() == 1 { TArray(hit[0]) } else { TError }
    TMap(_, _) =>
      if method_name == "set" && hit.length() == 2 {
        record_map_key_tparams(tc, env.fn_key, hit[0])
        TMap(hit[0], hit[1])
      } else {
        TError
      }
    _ => TError
  }
  match obj {
    EIdent(n, _) => infer_refine_binding(tc, env, n, new_ty)
    _ => ()
  }
}

///|
fn infer_refine_binding(tc : TypeChecker, env : Env, name : String, new_ty : Ty) -> Unit {
  if ty_has_unresolved(new_ty) || ty_contains_never(new_ty) {
    return
  }
  let mut i = env.scopes.length() - 1
  while i >= 0 {
    match env.scopes[i].get(name) {
      Some(b) => {
        let key = span_key(b.decl_span)
        if b.decl_span.line > 0 && tc.infer_pending.contains(key) {
          tc.infer_pending.remove(key)
          tc.let_infer.set(key, new_ty)
          env.scopes[i].set(name, VarBinding::{
            name: b.name,
            ty: new_ty,
            is_mut: b.is_mut,
            decl_span: b.decl_span,
            decl_line: b.decl_line,
            ty_span: b.ty_span,
            ty_end_col: b.ty_end_col,
            init_span: b.init_span,
            init_end_col: b.init_end_col,
          })
        }
        return
      }
      None => ()
    }
    i = i - 1
  }
}

///|
fn infer_map_pending(tc : TypeChecker, env : Env, name : String) -> Bool {
  match env_lookup(env, name) {
    Some(b) =>
      match b.ty {
        TMap(_, _) =>
          b.decl_span.line > 0 && tc.infer_pending.contains(span_key(b.decl_span))
        _ => false
      }
    None => false
  }
}

///|
fn ty_contains_never(t : Ty) -> Bool {
  match t {
    TNever => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) => ty_contains_never(e)
    TMap(k, v) => ty_contains_never(k) || ty_contains_never(v)
    _ => false
  }
}

///|
fn check_unhandled_result(tc : TypeChecker, stmt : Stmt, ty : Ty) -> Unit {
  match stmt {
    SExpr(_, sp) =>
      match ty {
        TResult(_, _) => {
          tc_err(
            tc,
            sp,
            "E_UNHANDLED_RESULT",
            "value of type `" +
            ty_to_string(ty) +
            "` is silently discarded",
            "handled Result",
            ty_to_string(ty),
            "handle the Result with `match`, `?`, or explicitly discard with `let _ = ...`",
          )
          tc_add_edit(tc, text_edit_insert(sp, 0, "let _ = "))
        }
        _ => ()
      }
    _ => ()
  }
}

///|
/// Types `==`/`!=` compare by value: scalars, `String`, `Ptr`, `Option`, `Result`,
/// `Tuple`, `ImmArray`, `Array`, `FixedArray`, enums whose variants carry no payload,
/// and structs/enums marked `#derive(Eq)` whose fields are themselves value-comparable
/// and do not form a cycle through a mutable edge (`Array`, `FixedArray`, `mut` field).
fn eq_stack_find(stack_keys : Array[String], key : String) -> Int {
  let mut i = 0
  while i < stack_keys.length() {
    if stack_keys[i] == key {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn eq_cycle_has_mut(stack_mut : Array[Bool], from_idx : Int) -> Bool {
  let mut i = from_idx
  while i < stack_mut.length() {
    if stack_mut[i] {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn eq_comparable_path(
  tc : TypeChecker,
  t : Ty,
  depth : Int,
  stack_keys : Array[String],
  stack_mut : Array[Bool],
  ok_cache : Map[String, Bool],
  min_back : Array[Int],
) -> Bool {
  let _ = depth
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TString | TStrView | TPtr => true
    TUnit | TParam(_) | TNever | TError => true
    TImmArray(e) | TOption(e) =>
      eq_comparable_path(tc, e, depth + 1, stack_keys, stack_mut, ok_cache, min_back)
    TArray(e) | TFixedArray(e) => {
      stack_keys.push("")
      stack_mut.push(true)
      let ok = eq_comparable_path(tc, e, depth + 1, stack_keys, stack_mut, ok_cache, min_back)
      let _ = stack_keys.pop()
      let _ = stack_mut.pop()
      ok
    }
    TResult(a, b) =>
      eq_comparable_path(tc, a, depth + 1, stack_keys, stack_mut, ok_cache, min_back) &&
      eq_comparable_path(tc, b, depth + 1, stack_keys, stack_mut, ok_cache, min_back)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if !eq_comparable_path(tc, es[i], depth + 1, stack_keys, stack_mut, ok_cache, min_back) {
          return false
        }
        i = i + 1
      }
      true
    }
    TStruct(name, sargs) => {
      let key = ty_to_string(t)
      if ok_cache.contains(key) {
        return true
      }
      let cyc_idx = eq_stack_find(stack_keys, key)
      if cyc_idx >= 0 {
        if cyc_idx < min_back[0] {
          min_back[0] = cyc_idx
        }
        return !eq_cycle_has_mut(stack_mut, cyc_idx)
      }
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let self_idx = stack_keys.length()
          let sub_back : Array[Int] = [999999]
          stack_keys.push(key)
          stack_mut.push(false)
          let mut all_ok = true
          let mut ai = 0
          while ai < sargs.length() && ai < iinfo.target_param_bounds.length() {
            let btrs = iinfo.target_param_bounds[ai]
            let mut bi = 0
            while bi < btrs.length() {
              let tr = btrs[bi]
              if tr == "@builtin:Eq" {
                if !eq_comparable_path(tc, sargs[ai], depth + 1, stack_keys, stack_mut, ok_cache, sub_back) {
                  all_ok = false
                  break
                }
              } else {
                let ok_tr = match sargs[ai] {
                  TParam(_) | TError | TNever => true
                  _ => tc.impls.contains(tr + "::" + ty_base_name(sargs[ai]))
                }
                if !ok_tr {
                  all_ok = false
                  break
                }
              }
              bi = bi + 1
            }
            if !all_ok {
              break
            }
            ai = ai + 1
          }
          let _ = stack_keys.pop()
          let _ = stack_mut.pop()
          if sub_back[0] < min_back[0] {
            min_back[0] = sub_back[0]
          }
          if all_ok && sub_back[0] >= self_idx {
            ok_cache.set(key, true)
          }
          return all_ok
        }
        None => ()
      }
      let found : Option[StructInfo] = tc_lookup_struct_info(tc, name)
      match found {
        None => false
        Some(sinfo) => {
          if !sinfo.decl.derive_eq {
            return false
          }
          let self_idx = stack_keys.length()
          let sub_back : Array[Int] = [999999]
          stack_keys.push(key)
          stack_mut.push(false)
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          let mut all_ok = true
          while fi < sinfo.field_tys.length() {
            let fty = subst_ty(sinfo.field_tys[fi], subst)
            let is_mut_fld = fi < sinfo.decl.fields.length() && sinfo.decl.fields[fi].is_mut
            if is_mut_fld {
              stack_keys.push("")
              stack_mut.push(true)
            }
            let ok = eq_comparable_path(tc, fty, depth + 1, stack_keys, stack_mut, ok_cache, sub_back)
            if is_mut_fld {
              let _ = stack_keys.pop()
              let _ = stack_mut.pop()
            }
            if !ok {
              all_ok = false
              break
            }
            fi = fi + 1
          }
          let _ = stack_keys.pop()
          let _ = stack_mut.pop()
          if sub_back[0] < min_back[0] {
            min_back[0] = sub_back[0]
          }
          if all_ok && sub_back[0] >= self_idx {
            ok_cache.set(key, true)
          }
          all_ok
        }
      }
    }
    TEnum(name, eargs) => {
      let key = ty_to_string(t)
      if ok_cache.contains(key) {
        return true
      }
      let cyc_idx = eq_stack_find(stack_keys, key)
      if cyc_idx >= 0 {
        if cyc_idx < min_back[0] {
          min_back[0] = cyc_idx
        }
        return !eq_cycle_has_mut(stack_mut, cyc_idx)
      }
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(iinfo) => {
          let self_idx = stack_keys.length()
          let sub_back : Array[Int] = [999999]
          stack_keys.push(key)
          stack_mut.push(false)
          let mut all_ok = true
          let mut ai = 0
          while ai < eargs.length() && ai < iinfo.target_param_bounds.length() {
            let btrs = iinfo.target_param_bounds[ai]
            let mut bi = 0
            while bi < btrs.length() {
              let tr = btrs[bi]
              if tr == "@builtin:Eq" {
                if !eq_comparable_path(tc, eargs[ai], depth + 1, stack_keys, stack_mut, ok_cache, sub_back) {
                  all_ok = false
                  break
                }
              } else {
                let ok_tr = match eargs[ai] {
                  TParam(_) | TError | TNever => true
                  _ => tc.impls.contains(tr + "::" + ty_base_name(eargs[ai]))
                }
                if !ok_tr {
                  all_ok = false
                  break
                }
              }
              bi = bi + 1
            }
            if !all_ok {
              break
            }
            ai = ai + 1
          }
          let _ = stack_keys.pop()
          let _ = stack_mut.pop()
          if sub_back[0] < min_back[0] {
            min_back[0] = sub_back[0]
          }
          if all_ok && sub_back[0] >= self_idx {
            ok_cache.set(key, true)
          }
          return all_ok
        }
        None => ()
      }
      let found : Option[EnumInfo] = tc_lookup_enum_info_qualified(tc, name)
      match found {
        None => true
        Some(einfo) => {
          if einfo.decl.derive_eq {
            let self_idx = stack_keys.length()
            let sub_back : Array[Int] = [999999]
            stack_keys.push(key)
            stack_mut.push(false)
            let subst = make_subst(einfo.decl.type_params, eargs)
            let mut vi = 0
            let mut all_ok = true
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                let fty = subst_ty(v.field_tys[fi], subst)
                if !eq_comparable_path(tc, fty, depth + 1, stack_keys, stack_mut, ok_cache, sub_back) {
                  all_ok = false
                  break
                }
                fi = fi + 1
              }
              if !all_ok {
                break
              }
              vi = vi + 1
            }
            let _ = stack_keys.pop()
            let _ = stack_mut.pop()
            if sub_back[0] < min_back[0] {
              min_back[0] = sub_back[0]
            }
            if all_ok && sub_back[0] >= self_idx {
              ok_cache.set(key, true)
            }
            return all_ok
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            if einfo.variants[vi].field_tys.length() != 0 {
              return false
            }
            vi = vi + 1
          }
          true
        }
      }
    }
    _ => false
  }
}

///|
fn eq_comparable(tc : TypeChecker, t : Ty) -> Bool {
  if ty_has_nominal(t) && eq_has_expansive_cycle(tc, t, true) {
    return false
  }
  eq_comparable_path(tc, t, 0, [], [], Map([]), [999999])
}

///|
fn collect_cond_is_locals(cond : Expr, locals : Map[String, Bool]) -> Unit {
  match cond {
    EIs(_, pat, _) => collect_pat_bindings(pat, locals)
    EBinary("&&", lhs, rhs, _) => {
      collect_cond_is_locals(lhs, locals)
      collect_cond_is_locals(rhs, locals)
    }
    _ => ()
  }
}

///|
fn expr_has_is(e : Expr) -> Bool {
  let work : Array[Expr] = [e]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EIs(_, _, _) => return true
          EBinary("&&", lhs, rhs, _) => {
            work.push(rhs)
            work.push(lhs)
          }
          _ => ()
        }
      None => break
    }
  }
  false
}

///|
fn collect_cond_captures_with_is(
  cond : Expr,
  locals : Map[String, Bool],
  out : Array[CaptureInfo],
) -> Unit {
  match cond {
    EIs(scrut, pat, _) => {
      collect_expr_captures(scrut, locals, out)
      collect_pat_bindings(pat, locals)
    }
    EBinary("&&", lhs, rhs, _) => {
      collect_cond_captures_with_is(lhs, locals, out)
      collect_cond_captures_with_is(rhs, locals, out)
    }
    _ => collect_expr_captures(cond, locals, out)
  }
}

///|
fn check_cond_with_bindings(
  tc : TypeChecker,
  env : Env,
  cond : Expr,
) -> Ty {
  // Iterative post-order traversal over `&&` trees to preserve exact left-to-right
  // `EIs` binding order and diagnostics without overflowing the native stack.
  let f_state : Array[Int] = []
  let f_rhs : Array[Expr] = []
  let f_sp : Array[Span] = []
  let f_lty : Array[Ty] = []
  let mut cur = cond
  let mut has_val = false
  let mut cur_ty = TBool
  while true {
    if !has_val {
      match cur {
        EBinary("&&", lhs, rhs, sp) => {
          f_state.push(0)
          f_rhs.push(rhs)
          f_sp.push(sp)
          f_lty.push(TError)
          cur = lhs
          continue
        }
        EIs(scrut, pat, _) => {
          let sty = check_expr(tc, env, scrut, None)
          bind_pattern(tc, env, pat, sty)
          cur_ty = TBool
          has_val = true
        }
        _ => {
          cur_ty = check_expr(tc, env, cur, Some(TBool))
          has_val = true
        }
      }
    }
    if f_state.length() == 0 {
      return cur_ty
    }
    let idx = f_state.length() - 1
    if f_state[idx] == 0 {
      f_state[idx] = 1
      f_lty[idx] = cur_ty
      cur = f_rhs[idx]
      has_val = false
    } else {
      let lty = f_lty[idx]
      let rty = cur_ty
      let sp = f_sp[idx]
      let _ = f_state.pop()
      let _ = f_rhs.pop()
      let _ = f_sp.pop()
      let _ = f_lty.pop()
      if !ty_compat(TBool, lty) || !ty_compat(TBool, rty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "logical `&&` expects `Bool` operands",
          "Bool",
          ty_to_string(lty) + " && " + ty_to_string(rty),
          "use boolean operands with `&&`",
        )
      }
      cur_ty = TBool
      has_val = true
    }
  }
  cur_ty
}

///|
/// `hint` types an unannotated empty collection initializer (from how the
/// binding leaves its block); without one such a binding stays pending until
/// its first `push` / `set` (`infer_refine_call`).
fn check_let(
  tc : TypeChecker,
  env : Env,
  name : String,
  is_mut : Bool,
  ty_expr : TypeExpr,
  init : Expr,
  sp : Span,
  hint : Option[Ty],
) -> Ty {
  let ann_opt : Option[Ty] = match ty_expr {
    TyMissing(_) => None
    _ => Some(resolve_type_expr(tc, ty_expr, env.type_params))
  }
  let exp = match ann_opt {
    Some(_) => ann_opt
    None => hint
  }
  let init_ty = check_expr(tc, env, init, exp)
  let mut final_ty = match ann_opt {
    Some(ann) => {
      if !ty_compat(ann, init_ty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "type mismatch in `let " + name + "`",
          ty_to_string(ann),
          ty_to_string(init_ty),
          "change the initializer or the type annotation to `" +
          ty_to_string(ann) +
          "`",
        )
      }
      ann
    }
    None => init_ty
  }
  match ann_opt {
    None =>
      if name != "_" {
        let kind = infer_empty_kind(init)
        if kind != 0 {
          if !ty_has_unresolved(final_ty) {
            tc.let_infer.set(span_key(sp), final_ty)
          } else {
            tc.infer_pending.set(span_key(sp), true)
            final_ty = if kind == 2 {
              TMap(TError, TError)
            } else if kind == 3 {
              TOption(TError)
            } else if kind == 4 {
              TImmArray(TError)
            } else {
              TArray(TError)
            }
          }
        }
      }
    Some(_) => ()
  }
  if name != "_" {
    let ty_sp = match ty_expr {
      TyMissing(_) => span_empty()
      _ => type_expr_span(ty_expr)
    }
    let ty_ec = match ty_expr {
      TyMissing(_) => -1
      _ => type_expr_end_col(ty_expr)
    }
    env_define_let(
      env,
      name,
      final_ty,
      is_mut,
      sp,
      ty_sp,
      ty_ec,
      expr_span(init),
      expr_end_col(init),
    )
  }
  TUnit
}

///|
fn ty_mentions_tparam(ty : Ty, tp : String) -> Bool {
  match ty {
    TParam(n) => n == tp
    TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      ty_mentions_tparam(e, tp)
    TResult(ok_t, err_t) | TMap(ok_t, err_t) =>
      ty_mentions_tparam(ok_t, tp) || ty_mentions_tparam(err_t, tp)
    TTuple(xs) | TStruct(_, xs) | TEnum(_, xs) => {
      let mut i = 0
      while i < xs.length() {
        if ty_mentions_tparam(xs[i], tp) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, rt) => {
      let mut i = 0
      while i < ps.length() {
        if ty_mentions_tparam(ps[i], tp) {
          return true
        }
        i = i + 1
      }
      ty_mentions_tparam(rt, tp)
    }
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TDouble
    | TFloat
    | TBool
    | TByte
    | TInt8
    | TChar
    | TString
    | TUnit
    | TPtr
    | TStringBuilder
    | TBytes
    | TStrView
    | TBytesView
    | TWorld
    | TScope
    | TAtomicInt
    | TDynTrait(_)
    | TNever
    | TError => false
    _ => true
  }
}

///|
/// A pure-Pion generic function/method whose declared return type is an
/// unconstrained type parameter `T` that never appears in any parameter type
/// cannot construct a `T` and therefore statically diverges (e.g. `halt::saying[T](...) -> T`).
fn fn_ret_is_uninhabited_tparam(finfo : FnInfo) -> Bool {
  if finfo.decl.type_params.length() == 0 {
    return false
  }
  match finfo.ret_ty {
    TParam(tp) => {
      if !str_arr_contains(finfo.decl.type_params, tp) {
        return false
      }
      let mut bi = 0
      while bi < finfo.decl.type_bounds.length() {
        let tb = finfo.decl.type_bounds[bi]
        if tb.param == tp && tb.traits.length() > 0 {
          return false
        }
        bi = bi + 1
      }
      let mut pi = 0
      while pi < finfo.param_tys.length() {
        if ty_mentions_tparam(finfo.param_tys[pi], tp) {
          return false
        }
        pi = pi + 1
      }
      true
    }
    _ => false
  }
}

///|
fn fn_statically_diverges(finfo : FnInfo) -> Bool {
  match finfo.ret_ty {
    TNever => true
    _ => fn_ret_is_uninhabited_tparam(finfo)
  }
}

///|
fn exprs_diverge(
  tc : TypeChecker,
  env : Env,
  exprs : Array[Expr],
  loop_depth : Int,
  allow_return : Bool,
) -> Bool {
  let mut i = 0
  while i < exprs.length() {
    if expr_diverge(tc, env, exprs[i], loop_depth, allow_return) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn expr_diverge(
  tc : TypeChecker,
  env : Env,
  e : Expr,
  loop_depth : Int,
  allow_return : Bool,
) -> Bool {
  match e {
    EBlock(stmts, _) => stmts_diverge(tc, env, stmts, loop_depth, allow_return)
    EIf(cond, then_stmts, else_opt, _) => {
      if expr_diverge(tc, env, cond, loop_depth, allow_return) {
        return true
      }
      match else_opt {
        None => false
        Some(else_e) =>
          stmts_diverge(tc, env, then_stmts, loop_depth, allow_return) &&
          expr_diverge(tc, env, else_e, loop_depth, allow_return)
      }
    }
    EMatch(scrut, arms, _) => {
      if expr_diverge(tc, env, scrut, loop_depth, allow_return) {
        return true
      }
      if arms.length() == 0 {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !expr_diverge(tc, env, arms[i].body, loop_depth, allow_return) {
          return false
        }
        i = i + 1
      }
      true
    }
    ECall(callee, args, sp) => {
      if expr_diverge(tc, env, callee, loop_depth, allow_return) {
        return true
      }
      if exprs_diverge(tc, env, args, loop_depth, allow_return) {
        return true
      }
      tc.never_calls.contains(span_key(sp))
    }
    EMethodCall(recv, _, args, sp) =>
      expr_diverge(tc, env, recv, loop_depth, allow_return) ||
      exprs_diverge(tc, env, args, loop_depth, allow_return) ||
      tc.never_calls.contains(span_key(sp))
    EClosure(_, _, _, _) => false
    EUnary(_, inner, _)
    | EField(inner, _, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => expr_diverge(tc, env, inner, loop_depth, allow_return)
    EBinary(op, lhs, rhs, _) =>
      if op == "&&" || op == "||" {
        expr_diverge(tc, env, lhs, loop_depth, allow_return)
      } else {
        expr_diverge(tc, env, lhs, loop_depth, allow_return) ||
        expr_diverge(tc, env, rhs, loop_depth, allow_return)
      }
    EIndex(a, b, _) | EScope(a, b, _) | ESpawn(a, b, _) =>
      expr_diverge(tc, env, a, loop_depth, allow_return) ||
      expr_diverge(tc, env, b, loop_depth, allow_return)
    EArrayLit(xs, _) | ETuple(xs, _) | EInterp(xs, _) | EDotVariant(_, xs, _) =>
      exprs_diverge(tc, env, xs, loop_depth, allow_return)
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(se) =>
          if expr_diverge(tc, env, se, loop_depth, allow_return) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if expr_diverge(tc, env, fields[i].value, loop_depth, allow_return) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn exprs_has_reachable_break(
  tc : TypeChecker,
  env : Env,
  exprs : Array[Expr],
  target_depth : Int,
) -> Bool {
  let mut i = 0
  while i < exprs.length() {
    if expr_has_reachable_break(tc, env, exprs[i], target_depth) {
      return true
    }
    if expr_diverge(tc, env, exprs[i], 0, true) {
      return false
    }
    i = i + 1
  }
  false
}

///|
fn expr_has_reachable_break(
  tc : TypeChecker,
  env : Env,
  e : Expr,
  target_depth : Int,
) -> Bool {
  match e {
    EBlock(stmts, _) => stmts_has_reachable_break(tc, env, stmts, target_depth)
    EIf(cond, then_stmts, else_opt, _) => {
      if expr_has_reachable_break(tc, env, cond, target_depth) {
        return true
      }
      if expr_diverge(tc, env, cond, 0, true) {
        return false
      }
      if stmts_has_reachable_break(tc, env, then_stmts, target_depth) {
        return true
      }
      match else_opt {
        Some(else_e) => expr_has_reachable_break(tc, env, else_e, target_depth)
        None => false
      }
    }
    EMatch(scrut, arms, _) => {
      if expr_has_reachable_break(tc, env, scrut, target_depth) {
        return true
      }
      if expr_diverge(tc, env, scrut, 0, true) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if expr_has_reachable_break(tc, env, ge, target_depth) {
              return true
            }
          None => ()
        }
        if expr_has_reachable_break(tc, env, arms[i].body, target_depth) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) => false
    ECall(callee, args, _) =>
      expr_has_reachable_break(tc, env, callee, target_depth) ||
      (!expr_diverge(tc, env, callee, 0, true) &&
        exprs_has_reachable_break(tc, env, args, target_depth))
    EMethodCall(recv, _, args, _) =>
      expr_has_reachable_break(tc, env, recv, target_depth) ||
      (!expr_diverge(tc, env, recv, 0, true) &&
        exprs_has_reachable_break(tc, env, args, target_depth))
    EUnary(_, inner, _)
    | EField(inner, _, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => expr_has_reachable_break(tc, env, inner, target_depth)
    EBinary(_, lhs, rhs, _) | EIndex(lhs, rhs, _) | EScope(lhs, rhs, _) | ESpawn(lhs, rhs, _) =>
      expr_has_reachable_break(tc, env, lhs, target_depth) ||
      (!expr_diverge(tc, env, lhs, 0, true) &&
        expr_has_reachable_break(tc, env, rhs, target_depth))
    EArrayLit(xs, _) | ETuple(xs, _) | EInterp(xs, _) | EDotVariant(_, xs, _) =>
      exprs_has_reachable_break(tc, env, xs, target_depth)
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(se) => {
          if expr_has_reachable_break(tc, env, se, target_depth) {
            return true
          }
          if expr_diverge(tc, env, se, 0, true) {
            return false
          }
        }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if expr_has_reachable_break(tc, env, fields[i].value, target_depth) {
          return true
        }
        if expr_diverge(tc, env, fields[i].value, 0, true) {
          return false
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn stmt_has_reachable_break(
  tc : TypeChecker,
  env : Env,
  s : Stmt,
  target_depth : Int,
) -> Bool {
  match s {
    SBreak(_) => target_depth == 0
    SContinue(_) => false
    SReturn(opt, _) =>
      match opt {
        Some(e) => expr_has_reachable_break(tc, env, e, target_depth)
        None => false
      }
    SLet(_, _, _, e, _) | SLetTuple(_, _, e, _) | SExpr(e, _) =>
      expr_has_reachable_break(tc, env, e, target_depth)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      expr_has_reachable_break(tc, env, lhs, target_depth) ||
      (!expr_diverge(tc, env, lhs, 0, true) &&
        expr_has_reachable_break(tc, env, rhs, target_depth))
    SDebugAssert(cond, msg, _) =>
      expr_has_reachable_break(tc, env, cond, target_depth) ||
      (!expr_diverge(tc, env, cond, 0, true) &&
        expr_has_reachable_break(tc, env, msg, target_depth))
    SGuard(cond, eb, _) =>
      expr_has_reachable_break(tc, env, cond, target_depth) ||
      (!expr_diverge(tc, env, cond, 0, true) &&
        stmts_has_reachable_break(tc, env, eb, target_depth))
    SWhile(cond, body, _) =>
      expr_has_reachable_break(tc, env, cond, target_depth) ||
      (!expr_diverge(tc, env, cond, 0, true) &&
        stmts_has_reachable_break(tc, env, body, target_depth + 1))
    SFor(init_s, cond, step_s, body, _) =>
      stmt_has_reachable_break(tc, env, init_s, target_depth) ||
      (!stmt_diverge(tc, env, init_s, 0, true) &&
        (expr_has_reachable_break(tc, env, cond, target_depth) ||
          (!expr_diverge(tc, env, cond, 0, true) &&
            (stmts_has_reachable_break(tc, env, body, target_depth + 1) ||
              stmt_has_reachable_break(tc, env, step_s, target_depth + 1)))))
    SForRange(_, s_e, e_e, _, body, _) =>
      expr_has_reachable_break(tc, env, s_e, target_depth) ||
      (!expr_diverge(tc, env, s_e, 0, true) &&
        (expr_has_reachable_break(tc, env, e_e, target_depth) ||
          (!expr_diverge(tc, env, e_e, 0, true) &&
            stmts_has_reachable_break(tc, env, body, target_depth + 1))))
    SForIn(_, _, iter_e, body, _) =>
      expr_has_reachable_break(tc, env, iter_e, target_depth) ||
      (!expr_diverge(tc, env, iter_e, 0, true) &&
        stmts_has_reachable_break(tc, env, body, target_depth + 1))
  }
}

///|
fn stmts_has_reachable_break(
  tc : TypeChecker,
  env : Env,
  stmts : Array[Stmt],
  target_depth : Int,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if stmt_has_reachable_break(tc, env, stmts[i], target_depth) {
      return true
    }
    if stmt_diverge(tc, env, stmts[i], 0, true) {
      return false
    }
    i = i + 1
  }
  false
}

///|
fn stmt_diverge(
  tc : TypeChecker,
  env : Env,
  s : Stmt,
  loop_depth : Int,
  allow_return : Bool,
) -> Bool {
  match s {
    SReturn(opt, _) =>
      if allow_return {
        true
      } else {
        match opt {
          Some(e) => expr_diverge(tc, env, e, loop_depth, false)
          None => false
        }
      }
    SBreak(_) | SContinue(_) => loop_depth == 0
    SLet(_, _, _, e, _) | SLetTuple(_, _, e, _) | SExpr(e, _) =>
      expr_diverge(tc, env, e, loop_depth, allow_return)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      expr_diverge(tc, env, lhs, loop_depth, allow_return) ||
      expr_diverge(tc, env, rhs, loop_depth, allow_return)
    SDebugAssert(_, _, _) => false
    SGuard(cond, _, _) => expr_diverge(tc, env, cond, loop_depth, allow_return)
    SWhile(cond, body, _) => {
      if expr_diverge(tc, env, cond, loop_depth, allow_return) {
        return true
      }
      match cond {
        EBool(true, _) => !stmts_has_reachable_break(tc, env, body, 0)
        _ => false
      }
    }
    SFor(init_s, cond, _, _, _) =>
      stmt_diverge(tc, env, init_s, loop_depth, allow_return) ||
      expr_diverge(tc, env, cond, loop_depth, allow_return)
    SForRange(_, s_e, e_e, _, _, _) =>
      expr_diverge(tc, env, s_e, loop_depth, allow_return) ||
      expr_diverge(tc, env, e_e, loop_depth, allow_return)
    SForIn(_, _, iter_e, _, _) => expr_diverge(tc, env, iter_e, loop_depth, allow_return)
  }
}

///|
fn stmts_diverge(
  tc : TypeChecker,
  env : Env,
  stmts : Array[Stmt],
  loop_depth : Int,
  allow_return : Bool,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if stmt_diverge(tc, env, stmts[i], loop_depth, allow_return) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn check_stmt(
  tc : TypeChecker,
  env : Env,
  stmt : Stmt,
  expected : Option[Ty],
) -> Ty {
  match stmt {
    SLet(name, is_mut, ty_expr, init, sp) =>
      check_let(tc, env, name, is_mut, ty_expr, init, sp, None)
    SLetTuple(names, ty_expr, init, sp) => {
      let ann_opt : Option[Ty] = match ty_expr {
        TyMissing(_) => None
        _ => Some(resolve_type_expr(tc, ty_expr, env.type_params))
      }
      let init_ty = check_expr(tc, env, init, ann_opt)
      let final_ty = match ann_opt {
        Some(ann) => {
          if !ty_compat(ann, init_ty) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "type mismatch in tuple destructuring `let (...)`",
              ty_to_string(ann),
              ty_to_string(init_ty),
              "change the initializer or the type annotation to `" +
              ty_to_string(ann) +
              "`",
            )
          }
          ann
        }
        None => init_ty
      }
      match final_ty {
        TTuple(elem_tys) =>
          if elem_tys.length() != names.length() {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "tuple destructuring arity mismatch: expected " +
              names.length().to_string() +
              " element(s), found " +
              elem_tys.length().to_string(),
              names.length().to_string() + "-tuple",
              ty_to_string(final_ty),
              "match the number of bindings to the tuple's length",
            )
          } else {
            let mut ni = 0
            while ni < names.length() {
              if names[ni] != "_" {
                env_define_line(env, names[ni], elem_tys[ni], false, sp.line)
              }
              ni = ni + 1
            }
          }
        TUnit =>
          if names.length() != 0 {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "cannot destructure non-tuple type `" + ty_to_string(final_ty) + "`",
              "tuple of " + names.length().to_string() + " element(s)",
              ty_to_string(final_ty),
              "destructure a tuple value or use a plain `let x = ...` binding",
            )
          }
        TError => {
          let mut ni = 0
          while ni < names.length() {
            if names[ni] != "_" {
              env_define_line(env, names[ni], TError, false, sp.line)
            }
            ni = ni + 1
          }
        }
        _ =>
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "cannot destructure non-tuple type `" + ty_to_string(final_ty) + "`",
            "tuple of " + names.length().to_string() + " element(s)",
            ty_to_string(final_ty),
            "destructure a tuple value or use a plain `let x = ...` binding",
          )
      }
      TUnit
    }
    SAssign(lhs, rhs, sp) => {
      match lhs {
        EIdent(name, lsp) =>
          match env_lookup(env, name) {
            Some(b) => {
              if !b.is_mut {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "cannot assign to immutable variable `" + name + "`",
                  "mutable binding",
                  "immutable `" + name + "`",
                  "declare `" + name + "` with `let mut " + name + "`",
                )
                // `let x` -> `let mut x` at the declaration.
                if b.decl_span.line > 0 {
                  tc_add_edit(tc, text_edit_insert(b.decl_span, 4, "mut "))
                }
              }
              let is_pending = b.decl_span.line > 0 &&
                tc.infer_pending.contains(span_key(b.decl_span))
              let rty = check_expr(tc, env, rhs, if is_pending { None } else { Some(b.ty) })
              if !ty_compat(b.ty, rty) {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "type mismatch in assignment to `" + name + "`",
                  ty_to_string(b.ty),
                  ty_to_string(rty),
                  "assign a value of type `" + ty_to_string(b.ty) + "`",
                )
              } else if is_pending {
                infer_refine_binding(tc, env, name, rty)
              }
            }
            None => {
              // Allow `for i = 0; ...` style init if not yet bound
              let rty = check_expr(tc, env, rhs, None)
              env_define(env, name, rty, true)
            }
          }
        EIndex(EIdent(mname, _), kexpr, _) if infer_map_pending(tc, env, mname) => {
          let kty = check_expr(tc, env, kexpr, None)
          let rty = check_expr(tc, env, rhs, None)
          infer_refine_binding(tc, env, mname, TMap(kty, rty))
        }
        EField(obj, fname, lsp) => {
          let lty = check_field_assign_target(tc, env, obj, fname, lsp)
          let rty = check_expr(tc, env, rhs, Some(lty))
          if !ty_compat(lty, rty) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "type mismatch in assignment",
              ty_to_string(lty),
              ty_to_string(rty),
              "assign a value of type `" + ty_to_string(lty) + "`",
            )
          }
        }
        EIndex(obj, idx, lsp) => {
          let oty = check_expr(tc, env, obj, None)
          let lty = match oty {
            TImmArray(elem) => {
              let _ = check_expr(tc, env, idx, Some(TInt))
              tc_err(
                tc,
                lsp,
                "E_TYPE_MISMATCH",
                "cannot assign to element of immutable `" + ty_to_string(oty) + "`",
                "mutable Array or FixedArray",
                ty_to_string(oty),
                "convert to a mutable `Array` with `.to_array()` before modifying elements",
              )
              elem
            }
            TArray(elem) | TFixedArray(elem) => {
              let ity = check_expr(tc, env, idx, Some(TInt))
              if !ty_compat(TInt, ity) {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "array index must be `Int`",
                  "Int",
                  ty_to_string(ity),
                  "use an `Int` index",
                )
              }
              elem
            }
            TMap(kty, vty) => {
              let ity = check_expr(tc, env, idx, Some(kty))
              if !ty_compat(kty, ity) {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "map index key type mismatch",
                  ty_to_string(kty),
                  ty_to_string(ity),
                  "use a key of type `" + ty_to_string(kty) + "`",
                )
              }
              vty
            }
            TBytes => {
              let _ = check_expr(tc, env, idx, Some(TInt))
              TByte
            }
            TError => {
              let _ = check_expr(tc, env, idx, None)
              TError
            }
            _ => {
              let _ = check_expr(tc, env, idx, None)
              tc_err(
                tc,
                lsp,
                "E_TYPE_MISMATCH",
                "cannot assign to indexed type `" + ty_to_string(oty) + "`",
                "mutable Array, FixedArray, Map, or Bytes",
                ty_to_string(oty),
                "index-assign only into mutable collections",
              )
              TError
            }
          }
          if env.in_verify || tc.record_analyze {
            tc.expr_tys.set(span_key(lsp), lty)
          }
          let rty = check_expr(tc, env, rhs, Some(lty))
          if !ty_compat(lty, rty) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "type mismatch in assignment",
              ty_to_string(lty),
              ty_to_string(rty),
              "assign a value of type `" + ty_to_string(lty) + "`",
            )
          }
        }
        _ => {
          let lty = check_expr(tc, env, lhs, None)
          let rty = check_expr(tc, env, rhs, Some(lty))
          if !ty_compat(lty, rty) {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "type mismatch in assignment",
              ty_to_string(lty),
              ty_to_string(rty),
              "assign a value of type `" + ty_to_string(lty) + "`",
            )
          }
        }
      }
      TUnit
    }
    SCompoundAssign(op, lhs, rhs, sp) => {
      let lty = match lhs {
        EIdent(name, lsp) =>
          match env_lookup(env, name) {
            Some(b) => {
              if !b.is_mut {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "cannot assign to immutable variable `" + name + "`",
                  "mutable binding",
                  "immutable `" + name + "`",
                  "declare `" + name + "` with `let mut " + name + "`",
                )
              }
              b.ty
            }
            None => check_expr(tc, env, lhs, None)
          }
        EField(obj, fname, lsp) => check_field_assign_target(tc, env, obj, fname, lsp)
        EIndex(obj, idx, lsp) => {
          let oty = check_expr(tc, env, obj, None)
          let t = match oty {
            TImmArray(elem) => {
              let _ = check_expr(tc, env, idx, Some(TInt))
              tc_err(
                tc,
                lsp,
                "E_TYPE_MISMATCH",
                "cannot assign to element of immutable `" + ty_to_string(oty) + "`",
                "mutable Array or FixedArray",
                ty_to_string(oty),
                "convert to a mutable `Array` with `.to_array()` before modifying elements",
              )
              elem
            }
            TArray(elem) | TFixedArray(elem) => {
              let ity = check_expr(tc, env, idx, Some(TInt))
              if !ty_compat(TInt, ity) {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "array index must be `Int`",
                  "Int",
                  ty_to_string(ity),
                  "use an `Int` index",
                )
              }
              elem
            }
            TMap(kty, vty) => {
              let ity = check_expr(tc, env, idx, Some(kty))
              if !ty_compat(kty, ity) {
                tc_err(
                  tc,
                  lsp,
                  "E_TYPE_MISMATCH",
                  "map index key type mismatch",
                  ty_to_string(kty),
                  ty_to_string(ity),
                  "use a key of type `" + ty_to_string(kty) + "`",
                )
              }
              vty
            }
            TBytes => {
              let _ = check_expr(tc, env, idx, Some(TInt))
              TByte
            }
            TError => {
              let _ = check_expr(tc, env, idx, None)
              TError
            }
            _ => {
              let _ = check_expr(tc, env, idx, None)
              tc_err(
                tc,
                lsp,
                "E_TYPE_MISMATCH",
                "cannot assign to indexed type `" + ty_to_string(oty) + "`",
                "mutable Array, FixedArray, Map, or Bytes",
                ty_to_string(oty),
                "index-assign only into mutable collections",
              )
              TError
            }
          }
          if env.in_verify || tc.record_analyze {
            tc.expr_tys.set(span_key(lsp), t)
          }
          t
        }
        _ => check_expr(tc, env, lhs, None)
      }
      let rty = check_expr(tc, env, rhs, Some(lty))
      if !ty_compat(lty, rty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "type mismatch in compound assignment `" + op + "=`",
          ty_to_string(lty),
          ty_to_string(rty),
          "use a right-hand side of type `" + ty_to_string(lty) + "`",
        )
      } else {
        let valid_op = match lty {
          TInt | TInt64 | TUInt | TUInt64 | TInt8 | TByte | TError | TNever => true
          TDouble | TFloat => op == "+" || op == "-" || op == "*" || op == "/"
          TString => op == "+"
          TParam(_) => {
            if op == "+" {
              op_tparams_record(tc, env, "add", lty)
              true
            } else if op == "-" || op == "*" || op == "/" {
              op_tparams_record(tc, env, "num", lty)
              true
            } else if op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
              op_tparams_record(tc, env, "int", lty)
              true
            } else {
              false
            }
          }
          _ => false
        }
        if !valid_op {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "operator `" + op + "=` is not supported for type `" + ty_to_string(lty) + "`",
            "numeric or String type",
            ty_to_string(lty),
            "use a supported operand type for `" + op + "=`",
          )
        }
      }
      TUnit
    }
    SGuard(cond, else_body, sp) => {
      env_push(env)
      let diag_before = tc.diagnostics.length()
      let else_ty = check_stmts_ex(tc, env, else_body, None, false)
      env_pop(env)
      let else_has_err = tc.diagnostics.length() > diag_before ||
        match else_ty {
          TError => true
          _ => false
        }
      let init_loop_depth = if env.in_loop_depth > 0 { 0 } else { 1 }
      if !else_has_err && !stmts_diverge(tc, env, else_body, init_loop_depth, true) {
        tc_err(
          tc,
          sp,
          "E_GUARD_ELSE_NOT_DIVERGE",
          "`guard ... else` body must diverge (`return`, `break`, `continue`, or `panic`)",
          "diverging control flow",
          "block that may fall through",
          "end the `else` block with `return`, `break`, `continue`, or `panic(...)`",
        )
      }
      let cty = check_cond_with_bindings(tc, env, cond)
      if !ty_compat(TBool, cty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`guard` condition must be `Bool`",
          "Bool",
          ty_to_string(cty),
          "use a boolean condition or `expr is Pattern`",
        )
      }
      TUnit
    }
    SWhile(cond, body, sp) => {
      env_push(env)
      let cty = check_cond_with_bindings(tc, env, cond)
      if !ty_compat(TBool, cty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`while` condition must be `Bool`",
          "Bool",
          ty_to_string(cty),
          "use a boolean condition",
        )
      }
      env.in_loop_depth = env.in_loop_depth + 1
      let _ = check_stmts_ex(tc, env, body, None, false)
      env.in_loop_depth = env.in_loop_depth - 1
      env_pop(env)
      TUnit
    }
    SFor(init_s, cond, step_s, body, sp) => {
      env_push(env)
      let _ = check_stmt(tc, env, init_s, None)
      let cty = check_expr(tc, env, cond, Some(TBool))
      if !ty_compat(TBool, cty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`for` condition must be `Bool`",
          "Bool",
          ty_to_string(cty),
          "use a boolean condition",
        )
      }
      let _ = check_stmt(tc, env, step_s, None)
      env.in_loop_depth = env.in_loop_depth + 1
      let _ = check_stmts_ex(tc, env, body, None, false)
      env.in_loop_depth = env.in_loop_depth - 1
      env_pop(env)
      TUnit
    }
    SForRange(vname, start_e, end_e, _, body, sp) => {
      let sty = check_expr(tc, env, start_e, Some(TInt))
      let expected_end = match sty {
        TInt64 => TInt64
        _ => TInt
      }
      let ety = check_expr(tc, env, end_e, Some(expected_end))
      let valid_start = match sty {
        TInt | TInt64 | TError => true
        _ => false
      }
      if !valid_start {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`for ... in start..end` range start must be `Int` or `Int64`",
          "Int or Int64",
          ty_to_string(sty),
          "use an `Int` or `Int64` range bound",
        )
      }
      if valid_start && !ty_compat(sty, ety) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`for ... in start..end` range bounds must have the same type",
          ty_to_string(sty),
          ty_to_string(ety),
          "make both range bounds `" + ty_to_string(sty) + "`",
        )
      }
      let loop_var_ty = if valid_start { sty } else { TInt }
      env_push(env)
      env_define_line(env, vname, loop_var_ty, false, sp.line)
      env.in_loop_depth = env.in_loop_depth + 1
      let _ = check_stmts_ex(tc, env, body, None, false)
      env.in_loop_depth = env.in_loop_depth - 1
      env_pop(env)
      TUnit
    }
    SForIn(idx_name, vname, iter_e, body, sp) => {
      let ity = check_expr(tc, env, iter_e, None)
      let elem_ty = match ity {
        TArray(et) | TFixedArray(et) | TImmArray(et) => et
        TError => TError
        _ => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "`for ... in` requires an `Array[T]`",
            "Array[T]",
            ty_to_string(ity),
            "iterate over an `Array` or use `start..end` range",
          )
          TError
        }
      }
      env_push(env)
      if idx_name != "" && idx_name != "_" {
        env_define_line(env, idx_name, TInt, false, sp.line)
      }
      env_define_line(env, vname, elem_ty, false, sp.line)
      env.in_loop_depth = env.in_loop_depth + 1
      let _ = check_stmts_ex(tc, env, body, None, false)
      env.in_loop_depth = env.in_loop_depth - 1
      env_pop(env)
      TUnit
    }
    SReturn(opt, sp) => {
      if env.in_default_expr {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "cannot return from a default parameter expression",
          "expression",
          "return",
          "remove `return` from the default parameter expression",
        )
        return TNever
      }
      let exp_r : Option[Ty] = match env.ret_ty {
        TError => None
        _ => Some(env.ret_ty)
      }
      let rty = match opt {
        Some(e) => check_expr(tc, env, e, exp_r)
        None => TUnit
      }
      if !ty_compat(env.ret_ty, rty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "return type mismatch",
          ty_to_string(env.ret_ty),
          ty_to_string(rty),
          "return a value of type `" + ty_to_string(env.ret_ty) + "`",
        )
      }
      match env.inferred_ret {
        None =>
          match rty {
            TNever => ()
            _ => env.inferred_ret = Some(rty)
          }
        Some(prev) =>
          match rty {
            TNever => ()
            _ => {
              match env.ret_ty {
                TError =>
                  if !ty_compat(prev, rty) {
                    tc_err(
                      tc,
                      sp,
                      "E_TYPE_MISMATCH",
                      "return type mismatch",
                      ty_to_string(prev),
                      ty_to_string(rty),
                      "return a value of type `" + ty_to_string(prev) + "`",
                    )
                  }
                _ => ()
              }
              env.inferred_ret = Some(ty_prefer_concrete(prev, rty))
            }
          }
      }
      TNever
    }
    SBreak(sp) => {
      if env.in_default_expr && env.in_loop_depth == 0 {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "cannot use `break` outside a loop in a default parameter expression",
          "expression",
          "`break`",
          "remove `break` from the default parameter expression",
        )
      }
      TNever
    }
    SContinue(sp) => {
      if env.in_default_expr && env.in_loop_depth == 0 {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "cannot use `continue` outside a loop in a default parameter expression",
          "expression",
          "`continue`",
          "remove `continue` from the default parameter expression",
        )
      }
      TNever
    }
    SDebugAssert(cond, msg, sp) => {
      let cty = check_expr(tc, env, cond, Some(TBool))
      if !ty_compat(TBool, cty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`debug_assert` condition must be `Bool`",
          "Bool",
          ty_to_string(cty),
          "pass a `Bool` expression as the first argument",
        )
      }
      let mty = check_expr(tc, env, msg, Some(TString))
      if !ty_compat(TString, mty) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "`debug_assert` message must be `String`",
          "String",
          ty_to_string(mty),
          "pass a `String` message as the second argument",
        )
      }
      TUnit
    }
    SExpr(e, _) => check_expr(tc, env, e, expected)
  }
}

///|
fn check_variant_ctor(
  tc : TypeChecker,
  env : Env,
  enum_name : String,
  vname : String,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> Ty {
  if sp.line > 0 {
    tc.resolved_method_calls.set("ctor:" + span_key(sp), "1")
  }
  if enum_name == "Option" || (enum_name == "" && (vname == "Some" || vname == "None")) {
    if vname != "Some" && vname != "None" {
      let mut ai = 0
      while ai < args.length() {
        let _ = check_expr(tc, env, args[ai], None)
        ai = ai + 1
      }
      tc_err(
        tc,
        sp,
        "E_UNKNOWN_VARIANT",
        "enum `Option` has no variant `" + vname + "`",
        "valid variant of `Option`",
        vname,
        "use `Option::Some(...)` or `Option::None`",
      )
      return TError
    }
    let exp_inner : Option[Ty] = match expected {
      Some(TOption(inner)) => Some(inner)
      _ => None
    }
    if vname == "None" {
      if tc.record_analyze {
        tc.call_targets.set(span_key(sp), "Option::None")
      }
      return match exp_inner {
        Some(t) => TOption(t)
        None => TOption(TError)
      }
    }
    let aty = if args.length() >= 1 {
      check_expr(tc, env, args[0], exp_inner)
    } else {
      TError
    }
    if tc.record_analyze {
      tc.call_targets.set(span_key(sp), "Option::" + vname)
    }
    return TOption(aty)
  }
  if enum_name == "Result" || (enum_name == "" && (vname == "Ok" || vname == "Err")) {
    if vname != "Ok" && vname != "Err" {
      let mut ai = 0
      while ai < args.length() {
        let _ = check_expr(tc, env, args[ai], None)
        ai = ai + 1
      }
      tc_err(
        tc,
        sp,
        "E_UNKNOWN_VARIANT",
        "enum `Result` has no variant `" + vname + "`",
        "valid variant of `Result`",
        vname,
        "use `Result::Ok(...)` or `Result::Err(...)`",
      )
      return TError
    }
    let mut exp_ok : Option[Ty] = None
    let mut exp_err : Option[Ty] = None
    match expected {
      Some(TResult(o, e)) => {
        exp_ok = Some(o)
        exp_err = Some(e)
      }
      _ => ()
    }
    if vname == "Ok" {
      let oty = if args.length() >= 1 {
        check_expr(tc, env, args[0], exp_ok)
      } else {
        TError
      }
      let ety = match exp_err {
        Some(e) => e
        None => TError
      }
      if tc.record_analyze {
        tc.call_targets.set(span_key(sp), "Result::Ok")
      }
      return TResult(oty, ety)
    } else {
      let ety = if args.length() >= 1 {
        check_expr(tc, env, args[0], exp_err)
      } else {
        TError
      }
      let oty = match exp_ok {
        Some(o) => o
        None => TError
      }
      if tc.record_analyze {
        tc.call_targets.set(span_key(sp), "Result::Err")
      }
      return TResult(oty, ety)
    }
  }
  let resolved_enum = if enum_name != "" {
    enum_name
  } else {
    match tc.variant_to_enum.get(vname) {
      Some(en) => en
      None => ""
    }
  }
  if resolved_enum == "" {
    return TError
  }
  let einfo_opt : Option[EnumInfo] = match tc.enums.get(resolved_enum) {
    Some(ei) => Some(ei)
    None =>
      if env.in_default_arg && has_qual_sep(resolved_enum) {
        let qpe = split_qual_name(resolved_enum)
        match lookup_imported_pkg_transitive(tc, qpe.prefix) {
          Some(ipkg) => ipkg.tc.enums.get(qpe.name)
          None => None
        }
      } else {
        None
      }
  }
  match einfo_opt {
    None => TError
    Some(einfo) => {
      let subst : Map[String, Ty] = Map([])
      match expected {
        Some(TEnum(en, eargs)) =>
          if en == resolved_enum {
            let mut k = 0
            while k < einfo.decl.type_params.length() && k < eargs.length() {
              subst.set(einfo.decl.type_params[k], eargs[k])
              k = k + 1
            }
          }
        _ => ()
      }
      let mut found = false
      let mut vi = 0
      while vi < einfo.variants.length() {
        let v = einfo.variants[vi]
        if v.name == vname {
          found = true
          if args.length() != v.field_tys.length() {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "variant `" +
              vname +
              "` expects " +
              v.field_tys.length().to_string() +
              " argument(s), found " +
              args.length().to_string(),
              v.field_tys.length().to_string() + " args",
              args.length().to_string() + " args",
              "pass the exact number of fields for `" + vname + "`",
            )
          }
          let mut fi = 0
          while fi < args.length() && fi < v.field_tys.length() {
            let exp_f = subst_ty(v.field_tys[fi], subst)
            let aty = check_expr(tc, env, args[fi], Some(exp_f))
            unify_tparams(v.field_tys[fi], aty, subst)
            let exp_f2 = subst_ty(v.field_tys[fi], subst)
            if !ty_compat(exp_f2, aty) {
              tc_err(
                tc,
                expr_span(args[fi]),
                "E_TYPE_MISMATCH",
                "variant `" + vname + "` argument type mismatch",
                ty_to_string(exp_f2),
                ty_to_string(aty),
                "pass a value of type `" + ty_to_string(exp_f2) + "`",
              )
            }
            fi = fi + 1
          }
          break
        }
        vi = vi + 1
      }
      if !found {
        let mut ai = 0
        while ai < args.length() {
          let _ = check_expr(tc, env, args[ai], None)
          ai = ai + 1
        }
        tc_err(
          tc,
          sp,
          "E_UNKNOWN_VARIANT",
          "enum `" + resolved_enum + "` has no variant `" + vname + "`",
          "valid variant of `" + resolved_enum + "`",
          vname,
          "check the variant name on enum `" + resolved_enum + "`",
        )
        return TError
      }
      if tc.record_analyze {
        tc.call_targets.set(
          span_key(sp),
          tc_qualify_local_name(tc, resolved_enum) + "::" + vname,
        )
      }
      let targs : Array[Ty] = []
      let mut ti = 0
      while ti < einfo.decl.type_params.length() {
        match subst.get(einfo.decl.type_params[ti]) {
          Some(t) => targs.push(t)
          None => targs.push(TError)
        }
        ti = ti + 1
      }
      let res_ty = TEnum(resolved_enum, targs)
      if targs.length() > 0 {
        tc_check_map_keys_in_ty_rec(tc, env.fn_key, res_ty, sp, true, Map([]), Map([]))
      }
      res_ty
    }
  }
}

///|
pub fn ty_base_name(t : Ty) -> String {
  match t {
    TInt => "Int"
    TInt64 => "Int64"
    TUInt => "UInt"
    TUInt64 => "UInt64"
    TDouble => "Double"
    TFloat => "Float"
    TBool => "Bool"
    TByte => "Byte"
    TInt8 => "Int8"
    TChar => "Char"
    TString => "String"
    TUnit => "Unit"
    TPtr => "Ptr"
    TStringBuilder => "StringBuilder"
    TBytes => "Bytes"
    TStrView => "StrView"
    TBytesView => "BytesView"
    TWorld => "World"
    TScope => "Scope"
    TAtomicInt => "AtomicInt"
    TArray(_) => "Array"
    TFixedArray(_) => "FixedArray"
    TImmArray(_) => "ImmArray"
    TOption(_) => "Option"
    TResult(_, _) => "Result"
    TMap(_, _) => "Map"
    TChannel(_) => "Channel"
    TMutex(_) => "Mutex"
    TStruct(name, _) => name
    TEnum(name, _) => name
    _ => ty_to_string(t)
  }
}

///|
fn is_c_abi_param_ty(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TPtr | TError => true
    _ => false
  }
}

///|
fn is_c_abi_ret_ty(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TPtr | TUnit | TError => true
    _ => false
  }
}

///|
fn display_trait_name(name : String) -> String {
  if name == "@builtin:Eq" {
    "Eq"
  } else if starts_with_str(name, "@canon:") {
    slice_str(name, 7, name.length())
  } else {
    name
  }
}

///|
fn canon_trait_name(tc : TypeChecker, name : String) -> String {
  if name == "@builtin:Eq" {
    return "@builtin:Eq"
  }
  if !is_caller_alias_redirected(tc, name) && tc.traits.contains(name) {
    return name
  }
  if name == "Eq" {
    return "@builtin:Eq"
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    if starts_with_str(qp.prefix, "@canon:") {
      let raw_pkg = slice_str(qp.prefix, 7, qp.prefix.length())
      if raw_pkg == tc.pkg_name {
        return qp.name
      }
      return raw_pkg + "::" + qp.name
    }
    match resolve_pkg_for_lookup(tc, qp.prefix, tc.in_imported_default_arg) {
      Some(ipkg) => return ipkg.name + "::" + qp.name
      None => ()
    }
  }
  name
}

///|
pub fn resolve_canonical_trait_name(tc : TypeChecker, name : String) -> String {
  if tc.traits.contains(name) {
    return name
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    if tc.pkg_name != "" && qp.prefix == tc.pkg_name && tc.traits.contains(qp.name) {
      return qp.name
    }
    match lookup_imported_pkg_transitive(tc, qp.prefix) {
      Some(ipkg) =>
        if ipkg.tc.traits.contains(qp.name) {
          return ipkg.name + "::" + qp.name
        }
      None => ()
    }
  }
  name
}

///|
struct SourceTraitLookup {
  info : Option[TraitInfo]
  canon_name : String
  errored : Bool
}

///|
/// Resolve a trait name written in source code (e.g. `dyn T`, `impl T for X`, `fn f[A : T]`).
/// Enforces package aliasing (never falls back to another package's cache) and visibility.
fn lookup_source_trait_ex(
  tc : TypeChecker,
  name : String,
  sp : Span,
  allow_priv : Bool,
) -> SourceTraitLookup {
  if has_qual_sep(name) {
    let qp = split_qual_name(name)
    if starts_with_str(qp.prefix, "@canon:") &&
      slice_str(qp.prefix, 7, qp.prefix.length()) == tc.pkg_name {
      return SourceTraitLookup::{ info: tc.traits.get(qp.name), canon_name: qp.name, errored: false }
    }
    let allow_priv = allow_priv || starts_with_str(qp.prefix, "@canon:")
    match resolve_pkg_for_lookup(tc, qp.prefix, allow_priv) {
      Some(ipkg) =>
        match ipkg.tc.traits.get(qp.name) {
          Some(ti) => {
            let cname = ipkg.name + "::" + qp.name
            if !ti.decl.is_pub && !allow_priv {
              emit_private_err_at(tc, sp, "trait", ipkg.name, qp.name, ti.decl.span)
              SourceTraitLookup::{ info: None, canon_name: cname, errored: true }
            } else {
              let rti = match tc.traits.get(cname) {
                Some(qti) => qti
                None => qualify_imported_trait_info(ipkg.name, ti)
              }
              SourceTraitLookup::{ info: Some(rti), canon_name: cname, errored: false }
            }
          }
          None =>
            SourceTraitLookup::{
              info: None,
              canon_name: ipkg.name + "::" + qp.name,
              errored: false,
            }
        }
      None => SourceTraitLookup::{ info: None, canon_name: name, errored: false }
    }
  } else {
    SourceTraitLookup::{ info: tc.traits.get(name), canon_name: name, errored: false }
  }
}

///|
fn lookup_trait(tc : TypeChecker, name : String) -> Option[TraitInfo] {
  match tc.traits.get(name) {
    Some(ti) => return Some(ti)
    None => ()
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    if tc.pkg_name != "" && qp.prefix == tc.pkg_name {
      match tc.traits.get(qp.name) {
        Some(ti) => return Some(ti)
        None => ()
      }
    }
    match lookup_imported_pkg_transitive(tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.traits.get(qp.name) {
          Some(ti) =>
            if ti.decl.is_pub || tc.in_default_arg_expansion || tc.in_imported_default_arg {
              return Some(qualify_imported_trait_info(ipkg.name, ti))
            }
          None => ()
        }
      None => ()
    }
  }
  let cname = canon_trait_name(tc, name)
  tc.traits.get(cname)
}

///|
pub fn lookup_trait_canonical(
  tc : TypeChecker,
  name : String,
) -> Option[TraitInfo] {
  match tc.traits.get(name) {
    Some(ti) => return Some(ti)
    None => ()
  }
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    if tc.pkg_name != "" && qp.prefix == tc.pkg_name {
      match tc.traits.get(qp.name) {
        Some(ti) => return Some(ti)
        None => ()
      }
    }
    match lookup_imported_pkg_transitive(tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.traits.get(qp.name) {
          Some(ti) => return Some(qualify_imported_trait_info(ipkg.name, ti))
          None => ()
        }
      None => ()
    }
  }
  None
}

///|
pub fn lookup_trait_allow_private(tc : TypeChecker, name : String) -> Option[TraitInfo] {
  let clean = if starts_with_str(name, "@canon:") {
    slice_str(name, 7, name.length())
  } else {
    name
  }
  lookup_trait_canonical(tc, clean)
}

///|
/// Whether source-level `name` is `alias::T` with `alias` imported here. Such a name
/// means that package only, even when a root-anchor package has the canonical id
/// `alias` and declares a `T`.
fn tc_is_imported_pkg_alias(tc : TypeChecker, name : String) -> Bool {
  if tc.in_imported_default_arg {
    return false
  }
  let qp = split_qual_name(name)
  qp.prefix != "" &&
  !starts_with_str(qp.prefix, "@canon:") &&
  (match resolve_alias_pkg(tc, qp.prefix) { Some(_) => true
  None => false })
}

///|
fn canon_target_type_name(tc : TypeChecker, name : String) -> String {
  let qp = split_qual_name(name)
  if qp.prefix.length() > 0 {
    match resolve_pkg_for_lookup(tc, qp.prefix, tc.in_imported_default_arg) {
      Some(ipkg) => return ipkg.name + "::" + qp.name
      None => ()
    }
  }
  name
}

///|
fn format_method_sig_types(
  name : String,
  ptys : Array[Ty],
  rty : Ty,
) -> String {
  let sb = StringBuilder()
  sb.write_string("fn ")
  sb.write_string(name)
  sb.write_string("(")
  let mut i = 0
  while i < ptys.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(ty_to_string(ptys[i]))
    i = i + 1
  }
  sb.write_string(") -> ")
  sb.write_string(ty_to_string(rty))
  sb.to_string()
}

///|
fn find_impl_method(
  tc : TypeChecker,
  recv_ty : Ty,
  method_name : String,
) -> Option[FnInfo] {
  let tname = ty_base_name(recv_ty)
  let mut i = 0
  while i < tc.impl_keys.length() {
    let k = tc.impl_keys[i]
    match tc.impls.get(k) {
      Some(ii) =>
        if ii.trait_name != "@builtin:Eq" && ii.target_type == tname {
          match ii.methods.get(method_name) {
            Some(fi) => return Some(fi)
            None => ()
          }
        }
      None => ()
    }
    i = i + 1
  }
  None
}

///|
fn check_extern_fn_call(
  tc : TypeChecker,
  env : Env,
  einfo : ExternFnInfo,
  args : Array[Expr],
  sp : Span,
) -> Ty {
  if args.length() != einfo.param_tys.length() {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "extern function `" +
      einfo.decl.name +
      "` expects " +
      einfo.param_tys.length().to_string() +
      " argument(s), found " +
      args.length().to_string(),
      einfo.param_tys.length().to_string() + " args",
      args.length().to_string() + " args",
      "pass " + einfo.param_tys.length().to_string() + " argument(s)",
    )
    add_arity_edit(tc, sp, args, einfo.param_tys)
  }
  let mut i = 0
  while i < args.length() {
    let exp_p : Option[Ty] = if i < einfo.param_tys.length() {
      Some(einfo.param_tys[i])
    } else {
      None
    }
    let aty = check_expr(tc, env, args[i], exp_p)
    if i < einfo.param_tys.length() && !ty_compat(einfo.param_tys[i], aty) {
      let fix = match einfo.param_tys[i] {
        TPtr =>
          match aty {
            TString => "pass `s.as_cstr()` to convert `String` to `Ptr`"
            _ => "pass a value of type `Ptr`"
          }
        _ => "pass a value of type `" + ty_to_string(einfo.param_tys[i]) + "`"
      }
      tc_err(
        tc,
        expr_span(args[i]),
        "E_TYPE_MISMATCH",
        "argument " +
        (i + 1).to_string() +
        " type mismatch in call to extern function `" +
        einfo.decl.name +
        "`",
        ty_to_string(einfo.param_tys[i]),
        ty_to_string(aty),
        fix,
      )
    }
    i = i + 1
  }
  einfo.ret_ty
}

///|
fn tc_record_ty(tc : TypeChecker, env : Env, e : Expr, ty : Ty) -> Unit {
  if env.in_verify {
    tc.expr_tys.set(span_key(expr_span(e)), ty)
  }
}

///|
pub fn params_have_mut(params : Array[Param]) -> Bool {
  let mut i = 0
  while i < params.length() {
    if params[i].is_mut {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn param_at(params : Array[Param], i : Int) -> Option[Param] {
  if i >= 0 && i < params.length() {
    Some(params[i])
  } else {
    None
  }
}

///|
fn param_is_mut_at(params : Array[Param], i : Int) -> Bool {
  i >= 0 && i < params.length() && params[i].is_mut
}

///|
/// Path of a place expression for `mut` aliasing checks: `x` -> ["x"],
/// `x.f` -> ["x", "f"], `a[i]` -> ["a", "[*]"]; [] when it is not a place.
pub fn mut_place_path(e : Expr) -> Array[String] {
  match e {
    EIdent(n, _) => [n]
    EField(o, f, _) => {
      let p = mut_place_path(o)
      if p.length() > 0 {
        p.push(f)
      }
      p
    }
    EIndex(o, _, _) => {
      let p = mut_place_path(o)
      if p.length() > 0 {
        p.push("[*]")
      }
      p
    }
    EMutArg(inner, _) => mut_place_path(inner)
    _ => []
  }
}

///|
fn mut_path_to_string(p : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < p.length() {
    if i > 0 && p[i] != "[*]" {
      sb.write_string(".")
    }
    sb.write_string(p[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Two place paths alias when one is a prefix of the other (`s` / `s.x`,
/// `a` / `a[*]`, `a[*]` / `a[*]`); distinct fields (`s.x` / `s.y`) do not.
pub fn mut_paths_overlap(a : Array[String], b : Array[String]) -> Bool {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  let mut i = 0
  while i < n {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// Locals read by the index expressions of a place (`a[i].x[j + 1]` -> i, j).
fn mut_place_index_idents(e : Expr, out : Array[String]) -> Unit {
  match e {
    EField(o, _, _) => mut_place_index_idents(o, out)
    EIndex(o, idx, _) => {
      mut_place_index_idents(o, out)
      let caps : Array[CaptureInfo] = []
      collect_expr_captures(idx, Map([]), caps)
      let mut i = 0
      while i < caps.length() {
        out.push(caps[i].name)
        i = i + 1
      }
    }
    EMutArg(inner, _) => mut_place_index_idents(inner, out)
    _ => ()
  }
}

///|
/// `E_VERIFY_ALIASING`: within one call (receiver included), a `mut`
/// argument's place must not equal, contain or be contained in any other
/// argument's place, and must not be rooted at a local that another `mut`
/// argument's index reads. Enforced in all code (in-out arguments are
/// copied in and written back, so overlapping places would alias).
fn check_mut_call_aliasing(
  tc : TypeChecker,
  args : Array[Expr],
  muts : Array[Bool],
  fn_name : String,
) -> Unit {
  let mut any_mut = false
  let mut k = 0
  while k < muts.length() {
    if muts[k] {
      any_mut = true
    }
    k = k + 1
  }
  if !any_mut {
    return
  }
  let paths : Array[Array[String]] = []
  let mut i = 0
  while i < args.length() {
    paths.push(mut_place_path(args[i]))
    i = i + 1
  }
  let mut j = 1
  while j < args.length() {
    let mut i2 = 0
    while i2 < j {
      let mi = i2 < muts.length() && muts[i2]
      let mj = j < muts.length() && muts[j]
      if (mi || mj) &&
        paths[i2].length() > 0 &&
        paths[j].length() > 0 &&
        mut_paths_overlap(paths[i2], paths[j]) {
        let a = mut_path_to_string(paths[i2])
        let b = mut_path_to_string(paths[j])
        tc_err(
          tc,
          expr_span(args[j]),
          "E_VERIFY_ALIASING",
          "arguments `" + a + "` and `" + b + "` of call to `" + fn_name + "` overlap: a `mut` argument must not alias another argument of the same call",
          "disjoint argument places",
          a + " / " + b,
          "pass disjoint places (distinct fields are fine), or copy one side into a local first",
        )
        break
      }
      i2 = i2 + 1
    }
    j = j + 1
  }
  i = 0
  while i < args.length() {
    if i < muts.length() && muts[i] {
      let idents : Array[String] = []
      mut_place_index_idents(args[i], idents)
      if idents.length() > 0 {
        let mut j2 = 0
        while j2 < args.length() {
          if j2 != i && j2 < muts.length() && muts[j2] && paths[j2].length() > 0 {
            if str_arr_contains(idents, paths[j2][0]) {
              tc_err(
                tc,
                expr_span(args[j2]),
                "E_VERIFY_ALIASING",
                "`mut` argument `" + mut_path_to_string(paths[j2]) + "` of call to `" + fn_name + "` overlaps the index of `mut` argument `" + mut_path_to_string(paths[i]) + "`",
                "disjoint argument places",
                mut_path_to_string(paths[j2]),
                "copy the index into a separate local first",
              )
            }
          }
          j2 = j2 + 1
        }
      }
    }
    i = i + 1
  }
}

///|
fn mut_index_is_simple(e : Expr) -> Bool {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EIdent(_, _) | EPath(_, _, _) =>
      true
    EUnary(_, inner, _) => mut_index_is_simple(inner)
    EBinary(_, l, r, _) => mut_index_is_simple(l) && mut_index_is_simple(r)
    EField(o, _, _) => mut_index_is_simple(o)
    _ => false
  }
}

///|
/// Type-checks a `mut <place>` argument (or a `mut self` receiver when
/// `check_index` is false, its index expressions being checked already): `x`,
/// `x.f`, `a[i]` and their combinations, rooted at a mutable binding (`let mut`
/// or a `mut` parameter); fields written through it must be `mut` fields.
fn check_mut_place(tc : TypeChecker, env : Env, e : Expr, check_index : Bool) -> Ty {
  let ty = match e {
    EIdent(name, sp) => {
      match env_lookup(env, name) {
        Some(b) => {
          if !b.is_mut {
            tc_err(
              tc,
              sp,
              "E_TYPE_MISMATCH",
              "cannot pass immutable `" + name + "` as a `mut` argument",
              "mutable binding (`let mut` or `mut` parameter)",
              "immutable `" + name + "`",
              "declare `" + name + "` with `let mut " + name + "`",
            )
            if b.decl_span.line > 0 {
              tc_add_edit(tc, text_edit_insert(b.decl_span, 4, "mut "))
            }
          }
          b.ty
        }
        None => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "undefined variable `" + name + "` in `mut` argument",
            "local variable",
            name,
            "declare `let mut " + name + "` before passing it as `mut`",
          )
          TError
        }
      }
    }
    EField(obj, fname, sp) => {
      let oty = check_mut_place(tc, env, obj, check_index)
      match oty {
        TError => TError
        TStruct(sname, sargs) =>
          match tc_lookup_struct_info(tc, sname) {
            None => TError
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut fi = 0
              let mut fty = TError
              let mut found = false
              while fi < sinfo.field_names.length() {
                if sinfo.field_names[fi] == fname {
                  found = true
                  fty = subst_ty(sinfo.field_tys[fi], subst)
                  if has_qual_sep(sname) &&
                    !env.in_default_arg &&
                    fi < sinfo.field_privs.length() &&
                    sinfo.field_privs[fi] {
                    tc_err(
                      tc,
                      sp,
                      "E_PRIVATE_FIELD",
                      "cannot access private field `" +
                      fname +
                      "` of `" +
                      sname +
                      "` outside its defining package",
                      "public field",
                      "private field `" + fname + "`",
                      "use a public method on `" + sname + "` instead",
                    )
                  } else if !sinfo.field_muts[fi] {
                    tc_err(
                      tc,
                      sp,
                      "E_TYPE_MISMATCH",
                      "field `" + fname + "` of `" + sname + "` is not `mut` and cannot be passed as a `mut` argument",
                      "`mut` field",
                      "immutable field `" + fname + "`",
                      "declare the field as `mut " + fname + " : ...` or pass a local copy",
                    )
                  }
                  break
                }
                fi = fi + 1
              }
              if !found {
                tc_err(
                  tc,
                  sp,
                  "E_TYPE_MISMATCH",
                  "struct `" + sname + "` has no field `" + fname + "`",
                  "valid field of `" + sname + "`",
                  fname,
                  "check field name on `" + sname + "`",
                )
              }
              fty
            }
          }
        _ => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "`mut` place `." + fname + "` requires a struct, found `" + ty_to_string(oty) + "`",
            "struct",
            ty_to_string(oty),
            "pass a struct field path as `mut` argument",
          )
          TError
        }
      }
    }
    EIndex(obj, idx, sp) => {
      let oty = check_mut_place(tc, env, obj, check_index)
      if check_index {
        let ity = check_expr(tc, env, idx, Some(TInt))
        if !ty_compat(TInt, ity) {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "array index must be `Int`",
            "Int",
            ty_to_string(ity),
            "use an `Int` index",
          )
        }
      }
      if !mut_index_is_simple(idx) {
        tc_err(
          tc,
          sp,
          "E_TYPE_MISMATCH",
          "the index of a `mut` place must be a simple expression (locals, literals, fields, arithmetic)",
          "simple index expression",
          "call or assignment in index",
          "bind the index to a local first: `let k = ...; f(mut a[k])`",
        )
      }
      match oty {
        TArray(elem) | TFixedArray(elem) => elem
        TBytes => TByte
        TError => TError
        _ => {
          tc_err(
            tc,
            sp,
            "E_TYPE_MISMATCH",
            "`mut` place `[...]` requires an `Array`, `FixedArray` or `Bytes`, found `" + ty_to_string(oty) + "`",
            "Array, FixedArray or Bytes",
            ty_to_string(oty),
            "pass an array element as `mut` argument",
          )
          TError
        }
      }
    }
    _ => {
      tc_err(
        tc,
        expr_span(e),
        "E_TYPE_MISMATCH",
        "a `mut` argument must be a place (`x`, `x.field`, `a[i]`)",
        "place expression",
        "temporary value",
        "bind the value to `let mut tmp = ...` and pass `mut tmp`",
      )
      check_expr(tc, env, e, None)
    }
  }
  tc_record_ty(tc, env, e, ty)
  ty
}

///|
/// Checks one call argument against its parameter, handling `mut <place>`.
fn check_call_arg(
  tc : TypeChecker,
  env : Env,
  p_opt : Option[Param],
  arg : Expr,
  exp : Option[Ty],
  fn_name : String,
) -> Ty {
  let p_is_mut = match p_opt {
    Some(p) => p.is_mut
    None => false
  }
  let pname = match p_opt {
    Some(p) => p.name
    None => "_"
  }
  match arg {
    EMutArg(inner, msp) =>
      if p_is_mut {
        let ty = check_mut_place(tc, env, inner, true)
        tc_record_ty(tc, env, arg, ty)
        ty
      } else {
        tc_err(
          tc,
          msp,
          "E_TYPE_MISMATCH",
          "parameter `" + pname + "` of `" + fn_name + "` is not `mut`",
          "plain argument",
          "`mut` argument",
          "remove `mut` before this argument",
        )
        check_expr(tc, env, inner, exp)
      }
    _ => {
      if p_is_mut {
        tc_err(
          tc,
          expr_span(arg),
          "E_TYPE_MISMATCH",
          "argument for `mut` parameter `" + pname + "` of `" + fn_name + "` must be written `mut <place>`",
          "`mut <place>`",
          "plain argument",
          "write `mut ` before the argument (it must be a mutable place)",
        )
        match arg {
          EIdent(_, isp) => tc_add_edit(tc, text_edit_insert(isp, 0, "mut "))
          _ => ()
        }
      }
      check_expr(tc, env, arg, exp)
    }
  }
}

///|
/// Records `call_arg_order` for a resolved call (inside `#verify` code only).
fn tc_record_arg_order(
  tc : TypeChecker,
  env : Env,
  sp : Span,
  raw_args : Array[Expr],
  resolved : Array[Expr],
) -> Unit {
  if !env.in_verify {
    return
  }
  let order : Array[Int] = []
  let mut i = 0
  while i < resolved.length() {
    let rk = span_key(expr_span(resolved[i]))
    let mut found = -1
    let mut j = 0
    while j < raw_args.length() {
      match raw_args[j] {
        ENamedArg(_, _, inner, asp) =>
          if span_key(expr_span(inner)) == rk || span_key(asp) == rk {
            found = j
          }
        _ => if span_key(expr_span(raw_args[j])) == rk { found = j }
      }
      if found >= 0 {
        break
      }
      j = j + 1
    }
    order.push(found)
    i = i + 1
  }
  tc.call_arg_order.set(span_key(sp), order)
}

///|
/// `E_VERIFY_UNVERIFIED_CALLEE`: `#verify` code may only call `#verify` /
/// `#verify_opaque` functions and methods (plus extern "C" functions,
/// builtins, closures and trait-bound methods).
fn tc_check_verify_callee(tc : TypeChecker, env : Env, fd : FnDecl, target : String, sp : Span) -> Unit {
  if env.in_verify && !fd.is_verify && !fd.is_verify_opaque {
    tc_err(
      tc,
      sp,
      "E_VERIFY_UNVERIFIED_CALLEE",
      "`#verify` function `" + env.verify_fn_name + "` calls unverified function `" + target + "`",
      "`#verify` or `#verify_opaque` callee",
      target,
      "mark `" + target + "` with `#verify` (checked) or `#verify_opaque` (trusted boundary)",
    )
  }
}

///|
/// `E_VERIFY_UNVERIFIED_CALLEE` through a trait bound: `#verify` code that
/// instantiates `T : Trait` with a concrete type reaches every method of
/// that `impl`, so each one must be `#verify` / `#verify_opaque`.
fn tc_check_verify_impl(
  tc : TypeChecker,
  env : Env,
  ii : ImplInfo,
  trait_name : String,
  type_name : String,
  callee : String,
  sp : Span,
) -> Unit {
  let mut i = 0
  while i < ii.method_names.length() {
    match ii.methods.get(ii.method_names[i]) {
      Some(mi) =>
        if !mi.decl.is_verify && !mi.decl.is_verify_opaque {
          let target = trait_name + "::" + type_name + "::" + ii.method_names[i]
          tc_err(
            tc,
            sp,
            "E_VERIFY_UNVERIFIED_CALLEE",
            "`#verify` function `" + env.verify_fn_name + "` instantiates `" + callee + "` with `" + type_name + "`, whose trait method `" + target + "` is unverified",
            "`#verify` or `#verify_opaque` impl method",
            target,
            "mark `impl " + trait_name + " for " + type_name + "` with `#verify` (or the method with `#verify_opaque`)",
          )
        }
      None => ()
    }
    i = i + 1
  }
}

///|
fn tc_record_call(
  tc : TypeChecker,
  env : Env,
  sp : Span,
  target : String,
  tparams : Array[String],
  subst : Map[String, Ty],
) -> Unit {
  if !env.in_verify && !tc.record_analyze {
    return
  }
  tc.call_targets.set(span_key(sp), target)
  if env.in_verify && tparams.length() > 0 {
    let targs : Array[Ty] = []
    let mut i = 0
    while i < tparams.length() {
      match subst.get(tparams[i]) {
        Some(t) => targs.push(t)
        None => targs.push(TError)
      }
      i = i + 1
    }
    tc.call_type_args.set(span_key(sp), targs)
  }
}

///|
/// Codegen evaluates named arguments as written, which may be before the argument
/// that fixes a type parameter: record the instantiation for it.
fn tc_record_named_targs(
  tc : TypeChecker,
  fd : FnDecl,
  subst : Map[String, Ty],
  sp : Span,
) -> Unit {
  if fd.type_params.length() == 0 {
    return
  }
  let targs : Array[Ty] = []
  let mut i = 0
  while i < fd.type_params.length() {
    match subst.get(fd.type_params[i]) {
      Some(t) => targs.push(t)
      None => targs.push(TError)
    }
    i = i + 1
  }
  tc.let_infer.set(span_key(sp) + "#targs:" + fd.name, TTuple(targs))
}

///|
fn tc_qualify_local_name(tc : TypeChecker, name : String) -> String {
  if has_qual_sep(name) {
    name
  } else {
    tc.pkg_name + "::" + name
  }
}

///|
/// Parameters of the method `recv.m(...)` resolves to (inherent, trait impl,
/// or trait bound of a type parameter), receiver included.
fn method_params_for(tc : TypeChecker, env : Env, recv_ty : Ty, m : String) -> Option[Array[Param]] {
  match recv_ty {
    TStruct(sname, _) | TEnum(sname, _) => {
      match tc.methods.get(sname + "::" + m) {
        Some(mi) => return Some(mi.decl.params)
        None => ()
      }
      let qp = split_qual_name(sname)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.methods.get(qp.name + "::" + m) {
              Some(mi) => return Some(mi.decl.params)
              None => ()
            }
          None => ()
        }
      }
    }
    TParam(tp) =>
      match env.type_bounds.get(tp) {
        Some(trs) => {
          let mut bi = 0
          while bi < trs.length() {
            match lookup_trait(tc, trs[bi]) {
              Some(tinfo) => {
                let mut mi = 0
                while mi < tinfo.decl.methods.length() {
                  if tinfo.decl.methods[mi].name == m {
                    return Some(tinfo.decl.methods[mi].params)
                  }
                  mi = mi + 1
                }
              }
              None => ()
            }
            bi = bi + 1
          }
          return None
        }
        None => ()
      }
    _ => ()
  }
  match find_impl_method(tc, recv_ty, m) {
    Some(fi) => Some(fi.decl.params)
    None => None
  }
}

///|
/// The type of a fn or static method used as a value. A generic one is
/// instantiated from the expected `TFn` (`let f : (Array[Int]) -> Int =
/// first_of`, the argument of a higher-order call); the type params it does
/// not fix are left unresolved (never leaked as the callee's own `TParam`s).
/// The enclosing call re-instantiates it once its later arguments fixed more
/// (`tc_recheck_fn_value_args`).
fn tc_fn_value_ty(
  tc : TypeChecker,
  env : Env,
  fd : FnDecl,
  callee_name : String,
  ptys : Array[Ty],
  rty : Ty,
  expected : Option[Ty],
  sp : Span,
) -> Ty {
  if fd.type_params.length() == 0 {
    return TFn(ptys, rty)
  }
  // This occurrence resolved to the generic fn (not a local of that name):
  // only marked occurrences are refined once their call's types are final.
  tc.let_infer.set(span_key(sp) + "#fnref", TUnit)
  match expected {
    Some(TFn(eps, _)) =>
      if eps.length() == ptys.length() {
        let exp = match expected {
          Some(t) => t
          None => TError
        }
        tc_inst_fn_value(tc, env, fd, callee_name, ptys, rty, exp, sp, []).ty
      } else {
        TFn(ptys, rty)
      }
    _ => TFn(ptys, rty)
  }
}

///|
/// Instantiates a generic fn value against `exp` (a `TFn` of its arity).
/// Every type param it binds, apart from those in `already`, obeys the same
/// trait bounds and `==` rules as a direct call; the instance type is
/// recorded (`<span>#fnval`) for codegen.
fn tc_inst_fn_value(
  tc : TypeChecker,
  env : Env,
  fd : FnDecl,
  callee_name : String,
  ptys : Array[Ty],
  rty : Ty,
  exp : Ty,
  sp : Span,
  already : Array[String],
) -> TcFnValInst {
  let subst : Map[String, Ty] = Map([])
  match exp {
    TFn(eps, er) => {
      let mut i = 0
      while i < ptys.length() && i < eps.length() {
        unify_tparams(ptys[i], eps[i], subst)
        i = i + 1
      }
      unify_tparams(rty, er, subst)
    }
    _ => ()
  }
  let bound : Array[String] = []
  let fresh : Map[String, Ty] = Map([])
  let mut i = 0
  while i < fd.type_params.length() {
    let tp = fd.type_params[i]
    match subst.get(tp) {
      Some(t) =>
        if !ty_has_unresolved(t) {
          bound.push(tp)
          if !str_arr_contains(already, tp) {
            fresh.set(tp, t)
          }
        }
      None => ()
    }
    i = i + 1
  }
  tc_check_type_bounds(tc, env, fd, fresh, sp, has_qual_sep(callee_name))
  tc_push_eq_uses(tc, env, fd, callee_name, fresh, sp)
  let inst : Array[Ty] = []
  i = 0
  while i < ptys.length() {
    inst.push(subst_ty_mask_unbound(ptys[i], fd.type_params, subst))
    i = i + 1
  }
  let ty = TFn(inst, subst_ty_mask_unbound(rty, fd.type_params, subst))
  // A default argument is checked against the callee's own type params:
  // codegen instantiates it per call from the expected type instead.
  if !env.in_default_arg {
    tc.let_infer.set(span_key(sp) + "#fnval", ty)
  }
  TcFnValInst::{ ty: ty, bound: bound }
}

///|
/// The generic top-level fn or static method `e` names as a value, if any.
fn tc_generic_fn_ref(tc : TypeChecker, env : Env, e : Expr) -> Option[FnInfo] {
  let fi_opt : Option[FnInfo] = match e {
    EIdent(n, _) =>
      match env_lookup(env, n) {
        Some(_) => None
        None => tc.fns.get(n)
      }
    EPath(q, m, _) => {
      let local_mi = if tc_is_imported_pkg_alias(tc, q) { None } else { tc.methods.get(q + "::" + m) }
      match local_mi {
        Some(mi) => return if mi.decl.type_params.length() > 0 { Some(mi) } else { None }
        None => ()
      }
      match resolve_pkg_for_lookup(tc, q, true) {
        Some(ipkg) =>
          match ipkg.tc.fns.get(m) {
            Some(fi) => return if fi.decl.type_params.length() > 0 { Some(qualify_fn_info(ipkg, fi)) } else { None }
            None => ()
          }
        None => ()
      }
      let qp = split_qual_name(q)
      if qp.prefix.length() > 0 {
        match resolve_pkg_for_lookup(tc, qp.prefix, true) {
          Some(ipkg) =>
            match ipkg.tc.methods.get(qp.name + "::" + m) {
              Some(mi) => return if mi.decl.type_params.length() > 0 { Some(qualify_fn_info(ipkg, mi)) } else { None }
              None => ()
            }
          None => ()
        }
      }
      None
    }
    _ => None
  }
  match fi_opt {
    Some(fi) => if fi.decl.type_params.length() > 0 { Some(fi) } else { None }
    None => None
  }
}

///|
/// Whether a generic fn value occurs where the value of `e` comes from: `e`
/// itself, an element / field / payload / argument of it, or the value of a
/// block, `if` or `match` in it.
fn tc_expr_has_generic_fn_value(tc : TypeChecker, env : Env, e : Expr) -> Bool {
  match e {
    EIdent(_, _) | EPath(_, _, _) =>
      match tc_generic_fn_ref(tc, env, e) {
        Some(_) => true
        None => false
      }
    ECall(_, args, _) | EDotVariant(_, args, _) | ETuple(args, _) | EArrayLit(args, _) =>
      tc_exprs_have_generic_fn_value(tc, env, args)
    EMethodCall(recv, _, args, _) =>
      tc_expr_has_generic_fn_value(tc, env, recv) ||
      tc_exprs_have_generic_fn_value(tc, env, args)
    EStructLit(_, spread, fields, _) => {
      match spread {
        Some(b) => if tc_expr_has_generic_fn_value(tc, env, b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if tc_expr_has_generic_fn_value(tc, env, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => tc_stmts_tail_has_generic_fn_value(tc, env, stmts)
    EIf(_, then_stmts, else_opt, _) =>
      tc_stmts_tail_has_generic_fn_value(tc, env, then_stmts) ||
      (
        match else_opt {
          Some(el) => tc_expr_has_generic_fn_value(tc, env, el)
          None => false
        }
      )
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        if tc_expr_has_generic_fn_value(tc, env, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    ENamedArg(_, _, inner, _) => tc_expr_has_generic_fn_value(tc, env, inner)
    _ => false
  }
}

///|
fn tc_exprs_have_generic_fn_value(tc : TypeChecker, env : Env, es : Array[Expr]) -> Bool {
  let mut i = 0
  while i < es.length() {
    if tc_expr_has_generic_fn_value(tc, env, es[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn tc_stmts_tail_has_generic_fn_value(tc : TypeChecker, env : Env, stmts : Array[Stmt]) -> Bool {
  if stmts.length() == 0 {
    return false
  }
  match stmts[stmts.length() - 1] {
    SExpr(e, _) => tc_expr_has_generic_fn_value(tc, env, e)
    _ => false
  }
}

///|
fn tc_fnval_exp_key(exp : Option[Ty]) -> String {
  match exp {
    Some(t) => ty_to_string(t)
    None => ""
  }
}

///|
/// Arguments are checked in source order, so a generic fn value in an
/// argument may be instantiated before later arguments fixed the call's type
/// params (`consume(id, 1, true)`, `both((score, score), 3, 4L)`,
/// `run(keep(Holder::{ f: id }), 1, true)`). Once the call's substitution is
/// final, every such argument whose expected type grew is walked again
/// against it (`tc_refine_fn_values`): only its generic fn values are
/// re-instantiated, nothing else is re-checked, so moves, inference and
/// diagnostics keep source order.
fn tc_recheck_fn_value_args(
  tc : TypeChecker,
  env : Env,
  fd : FnDecl,
  param_tys : Array[Ty],
  offset : Int,
  args : Array[Expr],
  first_exp : Array[String],
  subst : Map[String, Ty],
  ctx : String,
  numbered : Bool,
) -> Unit {
  let mut i = 0
  while i < args.length() && i < first_exp.length() {
    let p_idx = i + offset
    if first_exp[i] != "" && p_idx < param_tys.length() {
      let exp = subst_ty_mask_unbound(param_tys[p_idx], fd.type_params, subst)
      if ty_to_string(exp) != first_exp[i] &&
        tc_expr_has_generic_fn_value(tc, env, args[i]) {
        let label = if numbered {
          "argument " + (i + 1).to_string() + " type mismatch " + ctx
        } else {
          "argument type mismatch " + ctx
        }
        tc_refine_fn_values(tc, env, args[i], exp, label)
      }
    }
    i = i + 1
  }
}

///|
/// Walks `e` (already checked) together with its now final expected type
/// `exp` down to the generic fn values its value comes from (tuple elements,
/// array elements, struct fields, `Some` / `Ok` / `Err` / enum payloads, the
/// arguments of generic calls relaying them, block / `if` / `match` values)
/// and re-instantiates each against its own part of `exp`: bounds and `==`
/// rules for the params it newly binds, a mismatch is `E_TYPE_MISMATCH`, and
/// the recorded instantiation (`<span>#fnval`) is updated for codegen.
fn tc_refine_fn_values(
  tc : TypeChecker,
  env : Env,
  e : Expr,
  exp : Ty,
  label : String,
) -> Unit {
  let fnref = match tc.let_infer.get(span_key(expr_span(e)) + "#fnref") {
    Some(_) => tc_generic_fn_ref(tc, env, e)
    None => None
  }
  match fnref {
    Some(fi) => {
      match exp {
        TFn(eps, _) =>
          if eps.length() == fi.param_tys.length() {
            let sp = expr_span(e)
            let fn_ty = TFn(fi.param_tys, fi.ret_ty)
            // Params the earlier instantiation already bound were checked;
            // a param `exp` leaves open keeps that earlier binding.
            let already : Array[String] = []
            let merged : Map[String, Ty] = Map([])
            unify_tparams(fn_ty, exp, merged)
            match tc.let_infer.get(span_key(sp) + "#fnval") {
              Some(prev) => {
                let ps : Map[String, Ty] = Map([])
                unify_tparams(fn_ty, prev, ps)
                let mut k = 0
                while k < fi.decl.type_params.length() {
                  let tp = fi.decl.type_params[k]
                  match ps.get(tp) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        already.push(tp)
                        let keep_prev = match merged.get(tp) {
                          Some(m) => ty_has_unresolved(m)
                          None => true
                        }
                        if keep_prev {
                          merged.set(tp, t)
                        }
                      }
                    None => ()
                  }
                  k = k + 1
                }
              }
              None => ()
            }
            let r = tc_inst_fn_value(
              tc,
              env,
              fi.decl,
              fi.decl.name,
              fi.param_tys,
              fi.ret_ty,
              subst_ty_mask_unbound(fn_ty, fi.decl.type_params, merged),
              sp,
              already,
            )
            if !ty_compat(exp, r.ty) {
              tc_err(
                tc,
                sp,
                "E_TYPE_MISMATCH",
                label,
                ty_to_string(exp),
                ty_to_string(r.ty),
                "pass a value of type `" + ty_to_string(exp) + "`",
              )
            }
          }
        _ => ()
      }
      return
    }
    None => ()
  }
  match e {
    ETuple(es, _) =>
      match exp {
        TTuple(ts) => {
          let mut i = 0
          while i < es.length() && i < ts.length() {
            tc_refine_fn_values(tc, env, es[i], ts[i], label)
            i = i + 1
          }
        }
        _ => ()
      }
    EArrayLit(es, _) =>
      match exp {
        TArray(et) | TFixedArray(et) | TImmArray(et) => {
          let mut i = 0
          while i < es.length() {
            tc_refine_fn_values(tc, env, es[i], et, label)
            i = i + 1
          }
        }
        _ => ()
      }
    EStructLit(_, spread, fields, _) =>
      match exp {
        TStruct(sn, targs) => {
          match spread {
            Some(b) => tc_refine_fn_values(tc, env, b, exp, label)
            None => ()
          }
          match tc_lookup_struct_info(tc, sn) {
            Some(si) => {
              let fs = make_subst(si.decl.type_params, targs)
              let mut i = 0
              while i < fields.length() {
                let mut fi = 0
                while fi < si.field_names.length() {
                  if si.field_names[fi] == fields[i].name {
                    tc_refine_fn_values(tc, env, fields[i].value, subst_ty(si.field_tys[fi], fs), label)
                    break
                  }
                  fi = fi + 1
                }
                i = i + 1
              }
            }
            None => ()
          }
        }
        _ => ()
      }
    EDotVariant(vname, args, _) => tc_refine_variant_args(tc, env, vname, args, exp, label)
    ECall(callee, args, call_sp) => {
      let cname = match callee {
        EIdent(n, _) => n
        EPath(_, m, _) => m
        _ => ""
      }
      match exp {
        TOption(inner) =>
          if cname == "Some" && args.length() == 1 {
            tc_refine_fn_values(tc, env, args[0], inner, label)
            return
          }
        TResult(ok, err) =>
          if args.length() == 1 {
            if cname == "Ok" {
              tc_refine_fn_values(tc, env, args[0], ok, label)
              return
            }
            if cname == "Err" {
              tc_refine_fn_values(tc, env, args[0], err, label)
              return
            }
          }
        TEnum(_, _) =>
          if tc_variant_field_tys(tc, cname, exp).length() > 0 {
            tc_refine_variant_args(tc, env, cname, args, exp, label)
            return
          }
        _ => ()
      }
      // A generic call relaying a value (`pass(id)`, `keep(Holder::{ f: id })`):
      // its result has type `exp`, which fixes more of its type params.
      match tc.let_infer.get(span_key(call_sp) + "#gcall") {
        Some(_) => {
          let callee_fi : Option[FnInfo] = match callee {
            EIdent(n, _) =>
              match env_lookup(env, n) {
                Some(_) => None
                None => tc.fns.get(n)
              }
            EPath(_, _, _) => tc_generic_fn_ref(tc, env, callee)
            _ => None
          }
          match callee_fi {
            Some(cf) => tc_refine_relay(tc, env, cf, 0, args, exp, call_sp, label)
            None => ()
          }
        }
        None => ()
      }
    }
    EMethodCall(_, mname, args, call_sp) =>
      match tc.let_infer.get(span_key(call_sp) + "#gmeth") {
        Some(TStruct(sname, _)) =>
          match tc.methods.get(sname + "::" + mname) {
            Some(mi) => tc_refine_relay(tc, env, mi, 1, args, exp, call_sp, label)
            None => ()
          }
        _ => ()
      }
    EBlock(stmts, _) => tc_refine_stmts_tail(tc, env, stmts, exp, label)
    EIf(_, then_stmts, else_opt, _) => {
      tc_refine_stmts_tail(tc, env, then_stmts, exp, label)
      match else_opt {
        Some(el) => tc_refine_fn_values(tc, env, el, exp, label)
        None => ()
      }
    }
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        tc_refine_fn_values(tc, env, arms[i].body, exp, label)
        i = i + 1
      }
    }
    ENamedArg(_, _, inner, _) => tc_refine_fn_values(tc, env, inner, exp, label)
    _ => ()
  }
}

///|
/// Refines the arguments of a generic call (`pass(id)`) or method call
/// (`b.pass(id)`, `offset = 1` for `self`) whose result is now known to have
/// type `exp`. Starts from the call's own instantiation (`<span>#gcall`), so
/// params its arguments already fixed are kept; the params `exp` newly fixes
/// obey the callee's bounds and `==` rules, and the record is updated.
fn tc_refine_relay(
  tc : TypeChecker,
  env : Env,
  cf : FnInfo,
  offset : Int,
  args : Array[Expr],
  exp : Ty,
  call_sp : Span,
  label : String,
) -> Unit {
  let tps = cf.decl.type_params
  if tps.length() == 0 {
    return
  }
  let key = span_key(call_sp) + "#gcall"
  let cs : Map[String, Ty] = Map([])
  match tc.let_infer.get(key) {
    Some(TTuple(targs)) => {
      let mut k = 0
      while k < tps.length() && k < targs.length() {
        if !ty_has_unresolved(targs[k]) {
          cs.set(tps[k], targs[k])
        }
        k = k + 1
      }
    }
    _ => ()
  }
  let had : Array[String] = []
  let mut k = 0
  while k < tps.length() {
    match cs.get(tps[k]) {
      Some(_) => had.push(tps[k])
      None => ()
    }
    k = k + 1
  }
  unify_tparams(cf.ret_ty, exp, cs)
  let fresh : Map[String, Ty] = Map([])
  let targs : Array[Ty] = []
  k = 0
  while k < tps.length() {
    match cs.get(tps[k]) {
      Some(t) =>
        if ty_has_unresolved(t) {
          targs.push(TError)
        } else {
          targs.push(t)
          if !str_arr_contains(had, tps[k]) {
            fresh.set(tps[k], t)
          }
        }
      None => targs.push(TError)
    }
    k = k + 1
  }
  tc_check_type_bounds(tc, env, cf.decl, fresh, call_sp, cf.is_imported)
  tc_push_eq_uses(tc, env, cf.decl, cf.decl.name, fresh, call_sp)
  tc.let_infer.set(key, TTuple(targs))
  // Bind arguments to parameters exactly like the call did (named, optional
  // `v=x` wrapped as `Some(x)`, positional skipping labelled params); no
  // diagnostics, defaults and missing slots are not refined.
  let res = resolve_call_args_impl(None, cf.decl.params, offset, args, cf.decl.name, call_sp)
  let mut i = 0
  while i < res.args.length() {
    let is_def = i < res.from_default.length() && res.from_default[i]
    let is_missing = i < res.missing.length() && res.missing[i]
    if !is_def && !is_missing && i + offset < cf.param_tys.length() {
      tc_refine_fn_values(
        tc,
        env,
        res.args[i],
        subst_ty_mask_unbound(cf.param_tys[i + offset], tps, cs),
        label,
      )
    }
    i = i + 1
  }
}

///|
fn tc_record_gcall(tc : TypeChecker, fd : FnDecl, subst : Map[String, Ty], sp : Span) -> Unit {
  if fd.type_params.length() == 0 {
    return
  }
  let targs : Array[Ty] = []
  let mut k = 0
  while k < fd.type_params.length() {
    match subst.get(fd.type_params[k]) {
      Some(t) => targs.push(if ty_has_unresolved(t) { TError } else { t })
      None => targs.push(TError)
    }
    k = k + 1
  }
  tc.let_infer.set(span_key(sp) + "#gcall", TTuple(targs))
}

///|
fn tc_refine_stmts_tail(
  tc : TypeChecker,
  env : Env,
  stmts : Array[Stmt],
  exp : Ty,
  label : String,
) -> Unit {
  if stmts.length() > 0 {
    match stmts[stmts.length() - 1] {
      SExpr(e, _) => tc_refine_fn_values(tc, env, e, exp, label)
      _ => ()
    }
  }
}

///|
/// Payload types of variant `vname` of the enum type `exp`.
fn tc_variant_field_tys(tc : TypeChecker, vname : String, exp : Ty) -> Array[Ty] {
  match exp {
    TEnum(en, targs) =>
      match tc_lookup_enum_info(tc, en) {
        Some(ei) => {
          let es = make_subst(ei.decl.type_params, targs)
          let mut vi = 0
          while vi < ei.variants.length() {
            if ei.variants[vi].name == vname {
              let out : Array[Ty] = []
              let mut k = 0
              while k < ei.variants[vi].field_tys.length() {
                out.push(subst_ty(ei.variants[vi].field_tys[k], es))
                k = k + 1
              }
              return out
            }
            vi = vi + 1
          }
          []
        }
        None => []
      }
    _ => []
  }
}

///|
fn tc_refine_variant_args(
  tc : TypeChecker,
  env : Env,
  vname : String,
  args : Array[Expr],
  exp : Ty,
  label : String,
) -> Unit {
  let ftys = tc_variant_field_tys(tc, vname, exp)
  let mut i = 0
  while i < args.length() && i < ftys.length() {
    tc_refine_fn_values(tc, env, args[i], ftys[i], label)
    i = i + 1
  }
}


///|
/// Records `fd`'s instantiation for `resolve_eq_uses`, which rejects
/// non-comparable types for type params its body compares with `==`.
fn tc_push_eq_uses(
  tc : TypeChecker,
  env : Env,
  fd : FnDecl,
  callee_name : String,
  subst : Map[String, Ty],
  sp : Span,
) -> Unit {
  if fd.type_params.length() > 0 {
    let subst_copy : Map[String, Ty] = Map([])
    let mut si = 0
    while si < fd.type_params.length() {
      let tp = fd.type_params[si]
      match subst.get(tp) {
        Some(concrete) => subst_copy.set(tp, concrete)
        None => ()
      }
      si = si + 1
    }
    tc.generic_call_sites.push(GenericCallSite::{
      caller_key: env.fn_key,
      callee_key: span_key(fd.span),
      callee_name: callee_name,
      subst: subst_copy,
      span: sp,
    })
  }
  let mut ti = 0
  while ti < fd.type_params.length() {
    let tp = fd.type_params[ti]
    match subst.get(tp) {
      Some(concrete) =>
        tc.eq_uses.push(EqUse::{
          callee_key: span_key(fd.span),
          callee_name: callee_name,
          tparam: tp,
          concrete: concrete,
          caller_key: env.fn_key,
          caller_is_verify: env.in_verify,
          callee_is_verify_opaque: fd.is_verify_opaque,
          span: sp,
        })
      None => ()
    }
    ti = ti + 1
  }
}

///|
/// A function with `mut` parameters takes in-out pointers: it cannot become a
/// first-class `(...) -> R` value.
fn tc_check_fn_value_no_mut(tc : TypeChecker, fd : FnDecl, name : String, sp : Span) -> Unit {
  if params_have_mut(fd.params) {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "function `" + name + "` has `mut` parameters and cannot be used as a value",
      "function without `mut` parameters",
      name,
      "call `" + name + "(...)` directly, or wrap it in a closure that calls it",
    )
  }
}

///|
fn find_impl_trait_name(tc : TypeChecker, recv_ty : Ty, method_name : String) -> String {
  let tname = ty_base_name(recv_ty)
  let mut i = 0
  while i < tc.impl_keys.length() {
    match tc.impls.get(tc.impl_keys[i]) {
      Some(ii) =>
        if ii.target_type == tname && ii.methods.contains(method_name) {
          return ii.trait_name
        }
      None => ()
    }
    i = i + 1
  }
  ""
}

///|
pub struct ResolvedCallArgs {
  args : Array[Expr]
  missing : Array[Bool]
  from_default : Array[Bool]
  raw_idx : Array[Int]
  opt_wrapped : Array[Bool]
}

///|
fn params_need_named_resolution(
  params : Array[Param],
  param_offset : Int,
  raw_args : Array[Expr],
) -> Bool {
  let mut i = 0
  while i < raw_args.length() {
    match raw_args[i] {
      ENamedArg(_, _, _, _) => return true
      _ => ()
    }
    i = i + 1
  }
  let mut pi = param_offset
  while pi < params.length() {
    let p = params[pi]
    if p.label_kind != 0 {
      return true
    }
    match p.default_expr {
      Some(_) => return true
      None => ()
    }
    pi = pi + 1
  }
  false
}

///|
fn resolve_call_args_impl(
  tc_opt : Option[TypeChecker],
  params : Array[Param],
  param_offset : Int,
  raw_args : Array[Expr],
  fn_name : String,
  sp : Span,
) -> ResolvedCallArgs {
  let n = if params.length() > param_offset {
    params.length() - param_offset
  } else {
    0
  }
  let slots : Array[Option[Expr]] = []
  let slot_raw_idx : Array[Int] = []
  let slot_opt_wrapped : Array[Bool] = []
  let pos_slots : Array[Int] = []
  let named_candidates : Array[String] = []
  let mut k = 0
  while k < n {
    slots.push(None)
    slot_raw_idx.push(-1)
    slot_opt_wrapped.push(false)
    let p = params[param_offset + k]
    if p.label_kind == 0 {
      pos_slots.push(k)
    }
    let has_def = match p.default_expr {
      Some(_) => true
      None => false
    }
    if p.label_kind != 0 || has_def {
      named_candidates.push(p.name)
    }
    k = k + 1
  }
  let mut pos_cursor = 0
  let mut ai = 0
  while ai < raw_args.length() {
    let arg = raw_args[ai]
    match arg {
      ENamedArg(label, opt_fwd, expr, asp) => {
        let mut found = -1
        let mut j = 0
        while j < n {
          let pj = params[param_offset + j]
          let pj_has_def = match pj.default_expr {
            Some(_) => true
            None => false
          }
          if pj.name == label && (pj.label_kind != 0 || pj_has_def) {
            found = j
            break
          }
          j = j + 1
        }
        if found < 0 {
          match tc_opt {
            Some(tc) => {
              let fix = match find_closest_name(label, named_candidates, 2) {
                Some(best) => "did you mean `" + best + "`?"
                None => "check parameter name in call to `" + fn_name + "`"
              }
              tc_err(
                tc,
                asp,
                "E_TYPE_MISMATCH",
                "unknown named argument `" + label + "` in call to `" + fn_name + "`",
                "valid named parameter",
                label,
                fix,
              )
            }
            None => ()
          }
        } else {
          match slots[found] {
            Some(_) =>
              match tc_opt {
                Some(tc) =>
                  tc_err(
                    tc,
                    asp,
                    "E_TYPE_MISMATCH",
                    "duplicate argument `" + label + "` in call to `" + fn_name + "`",
                    "single argument for `" + label + "`",
                    "duplicate `" + label + "`",
                    "remove the duplicate `" + label + "` argument",
                  )
                None => ()
              }
            None => {
              let pf = params[param_offset + found]
              if opt_fwd {
                if pf.label_kind != 2 {
                  match tc_opt {
                    Some(tc) =>
                      tc_err(
                        tc,
                        asp,
                        "E_TYPE_MISMATCH",
                        "`" + label + "?=` can only be used for optional `" + label + "?` parameters",
                        "optional parameter `" + label + "?`",
                        "non-optional parameter `" + label + "`",
                        "use `" + label + "=...` instead",
                      )
                    None => ()
                  }
                }
                slots[found] = Some(expr)
                slot_raw_idx[found] = ai
              } else if pf.label_kind == 2 {
                let syn_sp = Span::{ file: asp.file, line: 0, col: 0 }
                slots[found] = Some(ECall(EPath("Option", "Some", syn_sp), [expr], asp))
                slot_raw_idx[found] = ai
                slot_opt_wrapped[found] = true
              } else {
                slots[found] = Some(expr)
                slot_raw_idx[found] = ai
              }
            }
          }
        }
      }
      _ =>
        if pos_cursor < pos_slots.length() {
          let slot_idx = pos_slots[pos_cursor]
          pos_cursor = pos_cursor + 1
          match slots[slot_idx] {
            Some(_) =>
              match tc_opt {
                Some(tc) =>
                  tc_err(
                    tc,
                    expr_span(arg),
                    "E_TYPE_MISMATCH",
                    "duplicate argument `" +
                    params[param_offset + slot_idx].name +
                    "` in call to `" +
                    fn_name +
                    "`",
                    "single argument",
                    "duplicate argument",
                    "pass this argument once",
                  )
                None => ()
              }
            None => {
              slots[slot_idx] = Some(arg)
              slot_raw_idx[slot_idx] = ai
            }
          }
        } else {
          match tc_opt {
            Some(tc) =>
              tc_err(
                tc,
                expr_span(arg),
                "E_TYPE_MISMATCH",
                "too many positional arguments in call to `" + fn_name + "`",
                pos_slots.length().to_string() + " positional arg(s)",
                "extra positional arg",
                "pass labeled parameters by name (`name=value`) or remove extra argument",
              )
            None => ()
          }
        }
    }
    ai = ai + 1
  }
  let out : Array[Expr] = []
  let missing : Array[Bool] = []
  let from_default : Array[Bool] = []
  let raw_idx : Array[Int] = []
  let opt_wrapped : Array[Bool] = []
  k = 0
  while k < n {
    match slots[k] {
      Some(e) => {
        out.push(e)
        missing.push(false)
        from_default.push(false)
        raw_idx.push(slot_raw_idx[k])
        opt_wrapped.push(slot_opt_wrapped[k])
      }
      None => {
        let pk = params[param_offset + k]
        match pk.default_expr {
          Some(def) => {
            out.push(def)
            missing.push(false)
            from_default.push(true)
            raw_idx.push(-1)
            opt_wrapped.push(false)
          }
          None =>
            if pk.label_kind == 2 {
              out.push(EPath("Option", "None", Span::{ file: sp.file, line: 0, col: 0 }))
              missing.push(false)
              from_default.push(false)
              raw_idx.push(-1)
              opt_wrapped.push(false)
            } else {
              match tc_opt {
                Some(tc) => {
                  let hint = if pk.label_kind == 1 {
                    "pass `" + pk.name + "=...`"
                  } else {
                    "provide required argument `" + pk.name + "`"
                  }
                  tc_err(
                    tc,
                    sp,
                    "E_TYPE_MISMATCH",
                    "missing required argument `" + pk.name + "` in call to `" + fn_name + "`",
                    "argument `" + pk.name + "`",
                    "missing",
                    hint,
                  )
                }
                None => ()
              }
              out.push(EUnit(sp))
              missing.push(true)
              from_default.push(false)
              raw_idx.push(-1)
              opt_wrapped.push(false)
            }
        }
      }
    }
    k = k + 1
  }
  ResolvedCallArgs::{
    args: out,
    missing: missing,
    from_default: from_default,
    raw_idx: raw_idx,
    opt_wrapped: opt_wrapped,
  }
}

///|
pub fn resolve_call_args_qbe_full(
  params : Array[Param],
  param_offset : Int,
  raw_args : Array[Expr],
  sp : Span,
) -> ResolvedCallArgs {
  if !params_need_named_resolution(params, param_offset, raw_args) {
    let missing : Array[Bool] = []
    let from_default : Array[Bool] = []
    let raw_idx : Array[Int] = []
    let opt_wrapped : Array[Bool] = []
    let mut k = 0
    while k < raw_args.length() {
      missing.push(false)
      from_default.push(false)
      raw_idx.push(k)
      opt_wrapped.push(false)
      k = k + 1
    }
    return ResolvedCallArgs::{
      args: raw_args,
      missing: missing,
      from_default: from_default,
      raw_idx: raw_idx,
      opt_wrapped: opt_wrapped,
    }
  }
  resolve_call_args_impl(None, params, param_offset, raw_args, "", sp)
}

///|
pub fn resolve_call_args_qbe(
  params : Array[Param],
  param_offset : Int,
  raw_args : Array[Expr],
  sp : Span,
) -> Array[Expr] {
  if !params_need_named_resolution(params, param_offset, raw_args) {
    return raw_args
  }
  resolve_call_args_impl(None, params, param_offset, raw_args, "", sp).args
}

///|
fn make_default_arg_env(
  tc : TypeChecker,
  env : Env,
  decl : FnDecl,
  param_tys : Array[Ty],
  subst : Map[String, Ty],
  up_to : Int,
  extra_type_params : Array[String],
  is_imported : Bool,
) -> Env {
  let params = decl.params
  let def_scope : Map[String, VarBinding] = Map([])
  let mut j = 0
  while j < up_to && j < params.length() && j < param_tys.length() {
    let pj = params[j]
    let pty = param_tys[j]
    def_scope.set(
      pj.name,
      VarBinding::{
        name: pj.name,
        ty: pty,
        is_mut: pj.is_mut,
        decl_span: span_new("", 0, 0),
        decl_line: pj.span.line,
        ty_span: span_new("", 0, 0),
        ty_end_col: 0,
        init_span: span_new("", 0, 0),
        init_end_col: 0,
      },
    )
    j = j + 1
  }
  let merged_tparams : Array[String] = []
  let mut ti = 0
  while ti < env.type_params.length() {
    merged_tparams.push(env.type_params[ti])
    ti = ti + 1
  }
  ti = 0
  while ti < extra_type_params.length() {
    if !str_arr_contains(merged_tparams, extra_type_params[ti]) {
      merged_tparams.push(extra_type_params[ti])
    }
    ti = ti + 1
  }
  ti = 0
  while ti < decl.type_params.length() {
    if !str_arr_contains(merged_tparams, decl.type_params[ti]) {
      merged_tparams.push(decl.type_params[ti])
    }
    ti = ti + 1
  }
  let merged_bounds : Map[String, Array[String]] = env.type_bounds.copy()
  let mut bi = 0
  while bi < decl.type_bounds.length() {
    let tb = decl.type_bounds[bi]
    let ctrs : Array[String] = []
    let mut ci = 0
    while ci < tb.traits.length() {
      let raw_tr = tb.traits[ci]
      let tr_n = if starts_with_str(raw_tr, "@canon:") || !is_imported {
        canon_trait_name(tc, raw_tr)
      } else {
        raw_tr
      }
      ctrs.push(tr_n)
      ci = ci + 1
    }
    merged_bounds.set(tb.param, ctrs)
    bi = bi + 1
  }
  Env::{
    scopes: [def_scope],
    moved: Map([]),
    has_world: env.has_world,
    ret_ty: env.ret_ty,
    type_params: merged_tparams,
    type_bounds: merged_bounds,
    fn_key: env.fn_key,
    fn_lparen_span: env.fn_lparen_span,
    fn_has_params: env.fn_has_params,
    closure_scope_floor: 0,
    in_loop_depth: 0,
    inferred_ret: None,
    in_default_arg: true,
    in_default_expr: true,
    in_no_io: env.in_no_io,
    no_io_fn_name: env.no_io_fn_name,
    in_verify: env.in_verify,
    verify_fn_name: env.verify_fn_name,
    mut_params: Map([]),
    moved_shadow_stack: [Map([])],
  }
}

///|
fn param_is_into_at(params : Array[Param], idx : Int) -> Bool {
  idx >= 0 && idx < params.length() && params[idx].is_into
}

///|
fn ty_contains_world_rec(tc : TypeChecker, t : Ty, visited : Array[String]) -> Bool {
  match t {
    TWorld => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      ty_contains_world_rec(tc, e, visited)
    TResult(a, b) | TMap(a, b) =>
      ty_contains_world_rec(tc, a, visited) || ty_contains_world_rec(tc, b, visited)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if ty_contains_world_rec(tc, es[i], visited) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        if ty_contains_world_rec(tc, ps[i], visited) {
          return true
        }
        i = i + 1
      }
      ty_contains_world_rec(tc, r, visited)
    }
    TStruct(sname, sargs) => {
      let mut i = 0
      while i < sargs.length() {
        if ty_contains_world_rec(tc, sargs[i], visited) {
          return true
        }
        i = i + 1
      }
      if str_arr_contains(visited, sname) {
        return false
      }
      visited.push(sname)
      match tc_lookup_struct_info(tc, sname) {
        Some(si) => {
          let mut fi = 0
          while fi < si.field_tys.length() {
            if ty_contains_world_rec(tc, si.field_tys[fi], visited) {
              return true
            }
            fi = fi + 1
          }
          false
        }
        None => false
      }
    }
    TEnum(ename, eargs) => {
      let mut i = 0
      while i < eargs.length() {
        if ty_contains_world_rec(tc, eargs[i], visited) {
          return true
        }
        i = i + 1
      }
      if str_arr_contains(visited, ename) {
        return false
      }
      visited.push(ename)
      match tc.enums.get(ename) {
        Some(ei) => {
          let mut vi = 0
          while vi < ei.variants.length() {
            let v = ei.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if ty_contains_world_rec(tc, v.field_tys[fi], visited) {
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          false
        }
        None => false
      }
    }
    _ => false
  }
}

///|
fn validate_into_fn_decl(tc : TypeChecker, fd : FnDecl, finfo : FnInfo) -> Unit {
  if !fd.is_into {
    return
  }
  let full_name = if fd.receiver_type != "" {
    fd.receiver_type + "::" + fd.name
  } else {
    fd.name
  }
  if fd.receiver_type == "" {
    tc_err(
      tc,
      fd.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` must be an associated function on the target type (`Target::from_...`) or a method on the source type (`Src::to_...`)",
      "associated function `Target::fn` or method `Src::method`",
      "free function `" + full_name + "`",
      "define `" + full_name + "` as `Target::" + fd.name + "` or `Src::" + fd.name + "`",
    )
    return
  }
  if !tc.structs.contains(fd.receiver_type) && !tc.enums.contains(fd.receiver_type) {
    tc_err(
      tc,
      fd.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` must be defined on a struct or enum declared in the same package",
      "local struct or enum receiver type",
      fd.receiver_type,
      "define `#into` converters in the defining package of the target or source type",
    )
    return
  }
  if fd.params.length() != 1 {
    tc_err(
      tc,
      fd.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` must take exactly 1 parameter, found " + fd.params.length().to_string(),
      "1 parameter",
      fd.params.length().to_string() + " parameters",
      "a `#into` converter takes exactly one source value (or `self`)",
    )
    return
  }
  let p0 = fd.params[0]
  if p0.is_mut {
    tc_err(
      tc,
      p0.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` cannot have a `mut` parameter",
      "immutable parameter",
      "`mut " + p0.name + "`",
      "remove `mut` from `" + p0.name + "`",
    )
    return
  }
  let has_def = match p0.default_expr {
    Some(_) => true
    None => false
  }
  if p0.is_into || p0.label_kind != 0 || has_def {
    tc_err(
      tc,
      p0.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` parameter must be a plain positional parameter",
      "plain positional parameter",
      p0.name,
      "remove `into` / `~` / `?` / default value from `" + p0.name + "`",
    )
    return
  }
  if finfo.param_tys.length() > 0 && ty_contains_world_rec(tc, finfo.param_tys[0], []) {
    tc_err(
      tc,
      p0.span,
      "E_INVALID_INTO",
      "`#into` converter `" + full_name + "` cannot depend on `World` (converters must be pure value conversions)",
      "pure value parameter without `World`",
      ty_to_string(finfo.param_tys[0]),
      "remove `World` from `#into` converter `" + full_name + "`",
    )
    return
  }
  if p0.name == "self" {
    if finfo.param_tys.length() > 0 {
      match finfo.param_tys[0] {
        TError => ()
        _ =>
          if ty_base_name(finfo.param_tys[0]) != fd.receiver_type {
            tc_err(
              tc,
              p0.span,
              "E_INVALID_INTO",
              "`#into` method `" + full_name + "` `self` parameter must have type `" + fd.receiver_type + "`",
              fd.receiver_type,
              ty_to_string(finfo.param_tys[0]),
              "change `self` type to `" + fd.receiver_type + "`",
            )
          }
      }
    }
  } else {
    match finfo.ret_ty {
      TError => ()
      _ =>
        if ty_base_name(finfo.ret_ty) != fd.receiver_type {
          tc_err(
            tc,
            fd.span,
            "E_INVALID_INTO",
            "`#into` static function `" + full_name + "` must return `" + fd.receiver_type + "`",
            fd.receiver_type,
            ty_to_string(finfo.ret_ty),
            "return `" + fd.receiver_type + "` from `" + full_name + "` or declare it as a `self` method on the source type",
          )
        }
    }
  }
}

///|
fn into_check_type_bounds(
  tc : TypeChecker,
  env : Env,
  bounds : Array[TypeBound],
  subst : Map[String, Ty],
  is_imported : Bool,
) -> Bool {
  let mut bi = 0
  while bi < bounds.length() {
    let tb = bounds[bi]
    match subst.get(tb.param) {
      Some(concrete_ty) =>
        match concrete_ty {
          TError | TNever => ()
          TParam(other_tp) => {
            let mut ti = 0
            while ti < tb.traits.length() {
              let raw_tr = tb.traits[ti]
              let req_tr = if raw_tr == "@builtin:Eq" {
                "@builtin:Eq"
              } else if starts_with_str(raw_tr, "@canon:") || !is_imported {
                canon_trait_name(tc, raw_tr)
              } else {
                raw_tr
              }
              let has_bound = match env.type_bounds.get(other_tp) {
                Some(btrs) => str_arr_contains(btrs, req_tr)
                None => false
              }
              if !has_bound {
                return false
              }
              ti = ti + 1
            }
          }
          _ => {
            let tname = ty_base_name(concrete_ty)
            let mut ti = 0
            while ti < tb.traits.length() {
              let raw_tr = tb.traits[ti]
              let req_tr = if raw_tr == "@builtin:Eq" {
                "@builtin:Eq"
              } else if starts_with_str(raw_tr, "@canon:") || !is_imported {
                canon_trait_name(tc, raw_tr)
              } else {
                raw_tr
              }
              if req_tr == "@builtin:Eq" {
                if !eq_comparable(tc, concrete_ty) {
                  return false
                }
                let eq_tps : Array[String] = []
                collect_eq_tparams_in_ty(tc, concrete_ty, eq_tps, Map([]))
                let mut eti = 0
                while eti < eq_tps.length() {
                  let etp = eq_tps[eti]
                  let has_b = match env.type_bounds.get(etp) {
                    Some(btrs) => str_arr_contains(btrs, "@builtin:Eq")
                    None => false
                  }
                  if !has_b {
                    return false
                  }
                  eti = eti + 1
                }
                let eq_tr_obs : Array[TraitObligation] = []
                collect_eq_trait_obligations_rec(tc, concrete_ty, eq_tr_obs, Map([]))
                let mut tri = 0
                while tri < eq_tr_obs.length() {
                  let ob = eq_tr_obs[tri]
                  let ok_tr = match ob.target_ty {
                    TParam(etp) =>
                      match env.type_bounds.get(etp) {
                        Some(btrs) => str_arr_contains(btrs, ob.trait_name)
                        None => false
                      }
                    TError | TNever => true
                    _ => tc.impls.contains(ob.trait_name + "::" + ty_base_name(ob.target_ty))
                  }
                  if !ok_tr {
                    return false
                  }
                  tri = tri + 1
                }
              } else if !tc.impls.contains(req_tr + "::" + tname) {
                return false
              }
              ti = ti + 1
            }
          }
        }
      None => return false
    }
    bi = bi + 1
  }
  true
}

///|
/// When passing an unannotated closure (e.g. JSX `prop=>{ ... }`) to an `into`
/// parameter of type `target_ty`, check if `target_ty` has a unique static `#into`
/// converter taking a `TFn` of `arity` params; if so, return that expected `TFn`
/// so `.Variant` / literal inference works inside the closure body.
fn into_expected_fn_ty(tc : TypeChecker, target_ty : Ty, arity : Int) -> Option[Ty] {
  let target_base = match target_ty {
    TStruct(name, _) | TEnum(name, _) => name
    _ => return None
  }
  let is_xpkg = has_qual_sep(target_base)
  let pfx = target_base + "::"
  let mut found : Option[Ty] = None
  let mut count = 0
  let mut i = 0
  while i < tc.method_names.length() {
    let mk = tc.method_names[i]
    if starts_with_str(mk, pfx) {
      let mname = slice_str(mk, pfx.length(), mk.length())
      if !has_qual_sep(mname) {
        match tc.methods.get(mk) {
          Some(fi) =>
            if fi.decl.is_into &&
              (!is_xpkg || fi.decl.is_pub) &&
              fi.decl.params.length() == 1 &&
              fi.decl.params[0].name != "self" &&
              !fi.decl.params[0].is_mut &&
              fi.param_tys.length() == 1 {
              match fi.param_tys[0] {
                TFn(fptys, _) =>
                  if fptys.length() == arity {
                    let subst : Map[String, Ty] = Map([])
                    unify_tparams(fi.ret_ty, target_ty, subst)
                    if ty_compat(target_ty, subst_ty(fi.ret_ty, subst)) {
                      let cand_fn_ty = subst_ty_mask_unbound(
                        fi.param_tys[0],
                        fi.decl.type_params,
                        subst,
                      )
                      found = Some(cand_fn_ty)
                      count = count + 1
                    }
                  }
                _ => ()
              }
            }
          None => ()
        }
      }
    }
    i = i + 1
  }
  if count == 1 { found } else { None }
}

///|
struct IntoCandidate {
  conv : IntoConv
  display_name : String
  finfo : Option[FnInfo]
}

///|
struct IntoResolveResult {
  conv : Option[IntoConv]
  errored : Bool
  available_hint : String
}

///|
fn resolve_into_conversion(
  tc : TypeChecker,
  env : Env,
  src_ty : Ty,
  target_ty : Ty,
  sp : Span,
) -> IntoResolveResult {
  let tier1 : Array[IntoCandidate] = []
  let tier2 : Array[IntoCandidate] = []
  let seen : Map[String, Bool] = Map([])
  let avail_names : Array[String] = []

  // Scope 1: Target type's defining package (`Target::*` static `#into` fns)
  match target_ty {
    TStruct(target_base, _) | TEnum(target_base, _) => {
      let is_xpkg = has_qual_sep(target_base)
      let pfx = target_base + "::"
      let mut i = 0
      while i < tc.method_names.length() {
        let mk = tc.method_names[i]
        if starts_with_str(mk, pfx) {
          let mname = slice_str(mk, pfx.length(), mk.length())
          if !has_qual_sep(mname) {
            match tc.methods.get(mk) {
              Some(fi) =>
                if fi.decl.is_into &&
                  (!is_xpkg || fi.decl.is_pub) &&
                  fi.decl.params.length() == 1 &&
                  fi.decl.params[0].name != "self" &&
                  !fi.decl.params[0].is_mut &&
                  fi.param_tys.length() == 1 {
                  if avail_names.length() < 4 {
                    avail_names.push(mk)
                  }
                  let subst : Map[String, Ty] = Map([])
                  unify_tparams(fi.ret_ty, target_ty, subst)
                  unify_tparams(fi.param_tys[0], src_ty, subst)
                  let mut all_bound = true
                  let mut tpi = 0
                  while tpi < fi.decl.type_params.length() {
                    if !subst.contains(fi.decl.type_params[tpi]) {
                      all_bound = false
                      break
                    }
                    tpi = tpi + 1
                  }
                  if all_bound &&
                    ty_compat(target_ty, subst_ty(fi.ret_ty, subst)) &&
                    ty_compat(subst_ty(fi.param_tys[0], subst), src_ty) &&
                    into_check_type_bounds(tc, env, fi.decl.type_bounds, subst, fi.is_imported) {
                    if !seen.contains(mk) {
                      seen.set(mk, true)
                      let is_bare_tparam = match fi.param_tys[0] {
                        TParam(_) => true
                        _ => false
                      }
                      let cand = IntoCandidate::{
                        conv: IntoConv::{
                          kind: 1,
                          qual: target_base,
                          name: mname,
                          target_ty: target_ty,
                        },
                        display_name: mk,
                        finfo: Some(fi),
                      }
                      if is_bare_tparam {
                        tier2.push(cand)
                      } else {
                        tier1.push(cand)
                      }
                    }
                  }
                }
              None => ()
            }
          }
        }
        i = i + 1
      }
    }
    _ => ()
  }

  // Scope 2: Source type's defining package (`Src::*` instance `#into` methods)
  match src_ty {
    TStruct(src_base, _) | TEnum(src_base, _) => {
      let is_xpkg = has_qual_sep(src_base)
      let pfx = src_base + "::"
      let mut i = 0
      while i < tc.method_names.length() {
        let mk = tc.method_names[i]
        if starts_with_str(mk, pfx) {
          let mname = slice_str(mk, pfx.length(), mk.length())
          if !has_qual_sep(mname) {
            match tc.methods.get(mk) {
              Some(fi) =>
                if fi.decl.is_into &&
                  (!is_xpkg || fi.decl.is_pub) &&
                  fi.decl.params.length() == 1 &&
                  fi.decl.params[0].name == "self" &&
                  !fi.decl.params[0].is_mut &&
                  fi.param_tys.length() == 1 {
                  let subst : Map[String, Ty] = Map([])
                  unify_tparams(fi.param_tys[0], src_ty, subst)
                  unify_tparams(fi.ret_ty, target_ty, subst)
                  let mut all_bound = true
                  let mut tpi = 0
                  while tpi < fi.decl.type_params.length() {
                    if !subst.contains(fi.decl.type_params[tpi]) {
                      all_bound = false
                      break
                    }
                    tpi = tpi + 1
                  }
                  if all_bound &&
                    ty_compat(subst_ty(fi.param_tys[0], subst), src_ty) &&
                    ty_compat(target_ty, subst_ty(fi.ret_ty, subst)) &&
                    into_check_type_bounds(tc, env, fi.decl.type_bounds, subst, fi.is_imported) {
                    if !seen.contains(mk) {
                      seen.set(mk, true)
                      tier1.push(IntoCandidate::{
                        conv: IntoConv::{
                          kind: 2,
                          qual: "",
                          name: mname,
                          target_ty: target_ty,
                        },
                        display_name: mk,
                        finfo: Some(fi),
                      })
                    }
                  }
                }
              None => ()
            }
          }
        }
        i = i + 1
      }
    }
    _ => ()
  }

  // Scope 3: Builtin zero-overhead table (`String -> StrView`, `Bytes -> BytesView`)
  match src_ty {
    TString =>
      match target_ty {
        TStrView =>
          tier1.push(IntoCandidate::{
            conv: IntoConv::{
              kind: 0,
              qual: "",
              name: "as_view",
              target_ty: TStrView,
            },
            display_name: "String::as_view",
            finfo: None,
          })
        _ => ()
      }
    TBytes =>
      match target_ty {
        TBytesView =>
          tier1.push(IntoCandidate::{
            conv: IntoConv::{
              kind: 0,
              qual: "",
              name: "as_view",
              target_ty: TBytesView,
            },
            display_name: "Bytes::as_view",
            finfo: None,
          })
        _ => ()
      }
    _ => ()
  }

  // Two-tier deterministic selection
  let chosen_tier = if tier1.length() > 0 { tier1 } else { tier2 }
  if chosen_tier.length() == 1 {
    let c = chosen_tier[0]
    match c.finfo {
      Some(fi) => tc_check_verify_callee(tc, env, fi.decl, c.display_name, sp)
      None => ()
    }
    return IntoResolveResult::{ conv: Some(c.conv), errored: false, available_hint: "" }
  }
  if chosen_tier.length() >= 2 {
    let sb = StringBuilder()
    let mut ci = 0
    while ci < chosen_tier.length() {
      if ci > 0 {
        sb.write_string(", ")
      }
      sb.write_string("`")
      sb.write_string(chosen_tier[ci].display_name)
      sb.write_string("`")
      ci = ci + 1
    }
    let cands_str = sb.to_string()
    tc_err(
      tc,
      sp,
      "E_AMBIGUOUS_INTO",
      "ambiguous `#into` conversion from `" +
      ty_to_string(src_ty) +
      "` to `" +
      ty_to_string(target_ty) +
      "`: conflicting candidates " +
      cands_str,
      "single `#into` converter",
      cands_str,
      "call one of " + cands_str + " explicitly",
    )
    return IntoResolveResult::{ conv: None, errored: true, available_hint: "" }
  }
  let hint = if avail_names.length() > 0 {
    let sb = StringBuilder()
    sb.write_string("; available `#into` converters: ")
    let mut ai = 0
    while ai < avail_names.length() {
      if ai > 0 {
        sb.write_string(", ")
      }
      sb.write_string("`")
      sb.write_string(avail_names[ai])
      sb.write_string("`")
      ai = ai + 1
    }
    sb.to_string()
  } else {
    ""
  }
  IntoResolveResult::{ conv: None, errored: false, available_hint: hint }
}

///|
fn into_adjust_arg_expected(
  tc : TypeChecker,
  arg : Expr,
  exp_p : Option[Ty],
  is_into : Bool,
) -> Option[Ty] {
  if !is_into {
    return exp_p
  }
  match arg {
    EClosure(cparams, TyMissing(_), _, _) =>
      match exp_p {
        Some(TFn(_, _)) => exp_p
        Some(target_ty) =>
          match into_expected_fn_ty(tc, target_ty, cparams.length()) {
            Some(ft) => Some(ft)
            None => exp_p
          }
        None => None
      }
    _ => exp_p
  }
}

///|
fn tc_check_type_bounds(
  tc : TypeChecker,
  env : Env,
  decl : FnDecl,
  subst : Map[String, Ty],
  sp : Span,
  is_imported : Bool,
) -> Unit {
  let mut bi = 0
  while bi < decl.type_bounds.length() {
    let tb = decl.type_bounds[bi]
    match subst.get(tb.param) {
      Some(concrete_ty) =>
        match concrete_ty {
          TError | TNever => ()
          TParam(other_tp) => {
            let mut ti = 0
            while ti < tb.traits.length() {
              let raw_tr = tb.traits[ti]
              let req_tr = if raw_tr == "@builtin:Eq" {
                "@builtin:Eq"
              } else if starts_with_str(raw_tr, "@canon:") || !is_imported {
                canon_trait_name(tc, raw_tr)
              } else {
                raw_tr
              }
              let disp_tr = display_trait_name(req_tr)
              let has_bound = match env.type_bounds.get(other_tp) {
                Some(btrs) => str_arr_contains(btrs, req_tr)
                None => false
              }
              if !has_bound {
                tc_err(
                  tc,
                  sp,
                  "E_TRAIT_NOT_IMPLEMENTED",
                  "type parameter `" +
                  other_tp +
                  "` does not satisfy trait bound `" +
                  disp_tr +
                  "` required by `" +
                  decl.name +
                  "`",
                  other_tp + " : " + disp_tr,
                  other_tp,
                  "add `: " + disp_tr + "` bound to type parameter `" + other_tp + "`",
                )
              }
              ti = ti + 1
            }
          }
          _ => {
            let tname = ty_base_name(concrete_ty)
            let mut ti = 0
            while ti < tb.traits.length() {
              let raw_tr = tb.traits[ti]
              let req_tr = if raw_tr == "@builtin:Eq" {
                "@builtin:Eq"
              } else if starts_with_str(raw_tr, "@canon:") || !is_imported {
                canon_trait_name(tc, raw_tr)
              } else {
                raw_tr
              }
              let disp_tr = display_trait_name(req_tr)
              if req_tr == "@builtin:Eq" {
                let eq_tps : Array[String] = []
                collect_eq_tparams_in_ty(tc, concrete_ty, eq_tps, Map([]))
                let mut eti = 0
                while eti < eq_tps.length() {
                  if str_arr_contains(env.type_params, eq_tps[eti]) {
                    let _ = eq_tparams_add(tc, env.fn_key, eq_tps[eti])
                  }
                  eti = eti + 1
                }
                let _ = record_eq_trait_obligations(tc, env.fn_key, concrete_ty)
                if !eq_comparable(tc, concrete_ty) {
                  tc_err(
                    tc,
                    sp,
                    "E_TRAIT_NOT_IMPLEMENTED",
                    "type `" +
                    ty_to_string(concrete_ty) +
                    "` does not satisfy built-in `Eq` bound required by `" +
                    decl.name +
                    "`",
                    "Eq-comparable type",
                    ty_to_string(concrete_ty),
                    "add `#derive(Eq)` to `" + ty_to_string(concrete_ty) + "` or use a value-comparable type",
                  )
                } else if env.in_verify && !decl.is_verify_opaque && v_has_custom_eq_in(tc, concrete_ty, []) {
                  tc_err(
                    tc,
                    sp,
                    "E_VERIFY_UNSUPPORTED",
                    "type `" +
                    ty_to_string(concrete_ty) +
                    "` uses custom `impl Eq`, which is not supported for `Eq` bound on `" +
                    decl.name +
                    "` in `#verify`",
                    "structural `#derive(Eq)` or primitive type",
                    ty_to_string(concrete_ty),
                    "move custom `impl Eq` comparisons into a `#verify_opaque` helper",
                  )
                }
              } else {
                let impl_key = req_tr + "::" + tname
                if !tc.impls.contains(impl_key) {
                  tc_err(
                    tc,
                    sp,
                    "E_TRAIT_NOT_IMPLEMENTED",
                    "type `" +
                    ty_to_string(concrete_ty) +
                    "` does not implement trait `" +
                    disp_tr +
                    "` required by `" +
                    decl.name +
                    "`",
                    "impl " + disp_tr + " for " + ty_to_string(concrete_ty),
                    ty_to_string(concrete_ty),
                    "add `impl " + disp_tr + " for " + ty_to_string(concrete_ty) + " { ... }`",
                  )
                  add_missing_impl_edit(tc, req_tr, concrete_ty)
                } else if env.in_verify {
                  match tc.impls.get(impl_key) {
                    Some(ii) => tc_check_verify_impl(tc, env, ii, req_tr, tname, decl.name, sp)
                    None => ()
                  }
                }
              }
              ti = ti + 1
            }
          }
        }
      None => ()
    }
    bi = bi + 1
  }
}

///|
fn expr_is_unannotated_closure(e : Expr) -> Bool {
  match e {
    EClosure(params, _, _, _) => {
      let mut i = 0
      while i < params.length() {
        match params[i].ty {
          TyMissing(_) => return true
          _ => ()
        }
        i = i + 1
      }
      false
    }
    ENamedArg(_, _, inner, _) => expr_is_unannotated_closure(inner)
    _ => false
  }
}

///|
fn expr_is_unannotated_closure_arg(e : Expr, is_opt_wrap : Bool) -> Bool {
  if is_opt_wrap {
    match e {
      ECall(_, some_args, _) =>
        if some_args.length() == 1 {
          return expr_is_unannotated_closure(some_args[0])
        }
      _ => ()
    }
  }
  expr_is_unannotated_closure(e)
}

///|
fn ty_has_tparam(t : Ty) -> Bool {
  match t {
    TParam(_) => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      ty_has_tparam(e)
    TResult(o, e) | TMap(o, e) => ty_has_tparam(o) || ty_has_tparam(e)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if ty_has_tparam(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        if ty_has_tparam(ps[i]) {
          return true
        }
        i = i + 1
      }
      ty_has_tparam(r)
    }
    _ => false
  }
}

///|
///|
fn collect_unbound_tparams_in_ty(
  t : Ty,
  type_params : Array[String],
  subst : Map[String, Ty],
  out : Array[String],
) -> Unit {
  match t {
    TParam(tp) =>
      if str_arr_contains(type_params, tp) && !str_arr_contains(out, tp) {
        let is_unbound = match subst.get(tp) {
          Some(st) => ty_has_unresolved(st)
          None => true
        }
        if is_unbound {
          out.push(tp)
        }
      }
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      collect_unbound_tparams_in_ty(e, type_params, subst, out)
    TResult(o, e) | TMap(o, e) => {
      collect_unbound_tparams_in_ty(o, type_params, subst, out)
      collect_unbound_tparams_in_ty(e, type_params, subst, out)
    }
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        collect_unbound_tparams_in_ty(args[i], type_params, subst, out)
        i = i + 1
      }
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        collect_unbound_tparams_in_ty(ps[i], type_params, subst, out)
        i = i + 1
      }
      collect_unbound_tparams_in_ty(r, type_params, subst, out)
    }
    _ => ()
  }
}

///|
fn collect_unbound_fn_param_tparams(
  raw_param_ty : Ty,
  is_opt_wrap : Bool,
  type_params : Array[String],
  subst : Map[String, Ty],
) -> Array[String] {
  let out : Array[String] = []
  let fn_ty = if is_opt_wrap {
    match raw_param_ty {
      TOption(inner) => inner
      _ => raw_param_ty
    }
  } else {
    raw_param_ty
  }
  match fn_ty {
    TFn(ps, _) => {
      let mut i = 0
      while i < ps.length() {
        collect_unbound_tparams_in_ty(ps[i], type_params, subst, out)
        i = i + 1
      }
    }
    _ => ()
  }
  out
}

///|
fn any_tparam_now_concrete(tps : Array[String], subst : Map[String, Ty]) -> Bool {
  let mut i = 0
  while i < tps.length() {
    match subst.get(tps[i]) {
      Some(t) =>
        if !ty_has_unresolved(t) {
          return true
        }
      None => ()
    }
    i = i + 1
  }
  false
}

///|
fn moved_clone(m : Map[String, Span]) -> Map[String, Span] {
  let out : Map[String, Span] = Map([])
  let ks = m.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match m.get(k) {
      Some(sp) => out.set(k, sp)
      None => ()
    }
    i = i + 1
  }
  out
}

///|
fn moved_set_from(dst : Map[String, Span], src : Map[String, Span]) -> Unit {
  let dks = dst.keys()
  let mut i = 0
  while i < dks.length() {
    dst.remove(dks[i])
    i = i + 1
  }
  let sks = src.keys()
  i = 0
  while i < sks.length() {
    let k = sks[i]
    match src.get(k) {
      Some(sp) => dst.set(k, sp)
      None => ()
    }
    i = i + 1
  }
}

///|
fn recheck_pat_bindings(p : Pattern, out : Array[String]) -> Unit {
  match p {
    PIdent(n, _) =>
      if n != "_" && !str_arr_contains(out, n) {
        out.push(n)
      }
    PVariant(_, _, subs, _, _) | PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        recheck_pat_bindings(subs[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn recheck_cond_is_bindings(e : Expr, out : Array[String]) -> Unit {
  match e {
    EIs(_, p, _) => recheck_pat_bindings(p, out)
    EBinary(op, l, r, _) =>
      if op == "&&" {
        recheck_cond_is_bindings(l, out)
        recheck_cond_is_bindings(r, out)
      }
    _ => ()
  }
}

///|
fn moved_union_maps(a : Map[String, Span], b : Map[String, Span]) -> Map[String, Span] {
  let out = moved_clone(a)
  let bks = b.keys()
  let mut i = 0
  while i < bks.length() {
    let k = bks[i]
    if !out.contains(k) {
      match b.get(k) {
        Some(sp) => out.set(k, sp)
        None => ()
      }
    }
    i = i + 1
  }
  out
}

///|
fn tc_define_move_bindings(env : Env, names : Array[String]) -> Unit {
  let mut i = 0
  while i < names.length() {
    if names[i] != "_" {
      env_define_line(env, names[i], TError, false, 0)
    }
    i = i + 1
  }
}

///|
struct MoveState {
  env : Env
  mut diverged : Bool
  loop_cont_moved : Array[Map[String, Span]]
  loop_had_cont : Array[Bool]
  loop_break_moved : Array[Map[String, Span]]
  loop_had_break : Array[Bool]
  loop_scope_depth : Array[Int]
  closure_moved_stack : Array[Map[String, Span]]
  closure_scope_depth : Array[Int]
  reported_spans : Map[String, Bool]
}

///|
fn move_state_new() -> MoveState {
  MoveState::{
    env: env_new(TUnit, []),
    diverged: false,
    loop_cont_moved: [],
    loop_had_cont: [],
    loop_break_moved: [],
    loop_had_break: [],
    loop_scope_depth: [],
    closure_moved_stack: [],
    closure_scope_depth: [],
    reported_spans: Map([]),
  }
}

///|
fn env_binding_depth(env : Env, name : String) -> Int {
  let mut i = env.scopes.length() - 1
  while i >= 0 {
    if env.scopes[i].contains(name) {
      return i
    }
    i = i - 1
  }
  -1
}

///|
/// Non-mutating snapshot of `env.moved` as if popping lexical scopes from the
/// top down to `target_len` (inclusive), removing inner definitions and
/// restoring shadowed outer moved bindings.
fn moved_snapshot_to_depth(env : Env, target_len : Int) -> Map[String, Span] {
  let out = moved_clone(env.moved)
  let mut idx = env.scopes.length() - 1
  while idx >= target_len && idx >= 0 {
    let sc = env.scopes[idx]
    let ks = sc.keys()
    let mut i = 0
    while i < ks.length() {
      out.remove(ks[i])
      i = i + 1
    }
    if idx < env.moved_shadow_stack.length() {
      let sh = env.moved_shadow_stack[idx]
      let sks = sh.keys()
      i = 0
      while i < sks.length() {
        let k = sks[i]
        match sh.get(k) {
          Some(sp) => out.set(k, sp)
          None => ()
        }
        i = i + 1
      }
    }
    idx = idx - 1
  }
  out
}

///|
fn moved_outer_snapshot(env : Env) -> Map[String, Span] {
  moved_snapshot_to_depth(env, env.scopes.length() - 1)
}

///|
fn moved_has_new_key(before : Map[String, Span], after : Map[String, Span]) -> Bool {
  let aks = after.keys()
  let mut i = 0
  while i < aks.length() {
    if !before.contains(aks[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn ms_pat_is_irrefutable(p : Pattern) -> Bool {
  match p {
    PWild(_) | PIdent(_, _) => true
    PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if !ms_pat_is_irrefutable(subs[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///|
fn ms_err_moved(
  tc : TypeChecker,
  ms : MoveState,
  sp : Span,
  name : String,
  msg : String,
  hint : String,
) -> Unit {
  let key = span_key(sp)
  if ms.reported_spans.contains(key) {
    return
  }
  ms.reported_spans.set(key, true)
  tc_err(
    tc,
    sp,
    "E_USE_AFTER_MOVE",
    msg,
    "live binding",
    "moved variable `" + name + "`",
    hint,
  )
}

///|
fn ms_push_loop(ms : MoveState) -> Int {
  ms.loop_cont_moved.push(Map([]))
  ms.loop_had_cont.push(false)
  ms.loop_break_moved.push(Map([]))
  ms.loop_had_break.push(false)
  ms.loop_scope_depth.push(ms.env.scopes.length())
  ms.loop_cont_moved.length() - 1
}

///|
fn ms_pop_loop(ms : MoveState) -> Unit {
  let _ = ms.loop_cont_moved.pop()
  let _ = ms.loop_had_cont.pop()
  let _ = ms.loop_break_moved.pop()
  let _ = ms.loop_had_break.pop()
  let _ = ms.loop_scope_depth.pop()
}

///|
fn ms_record_false(
  false_out : Map[String, Span],
  false_live : Array[Bool],
  snap : Map[String, Span],
) -> Unit {
  if !false_live[0] {
    moved_set_from(false_out, snap)
    false_live[0] = true
  } else {
    moved_set_from(false_out, moved_union_maps(false_out, snap))
  }
}

///|
/// Evaluates a condition in the caller's already-pushed success scope so
/// `is`-pattern bindings and moves across `&&` persist into the success branch
/// while `false_out` accumulates every reachable short-circuit/failure outer moved state
/// unwound to `false_depth`.
fn tc_check_moves_in_cond(
  tc : TypeChecker,
  ms : MoveState,
  cond : Expr,
  false_depth : Int,
  false_out : Map[String, Span],
  false_live : Array[Bool],
) -> Unit {
  match cond {
    EBinary(op, l, r, _) =>
      if op == "&&" {
        tc_check_moves_in_cond(tc, ms, l, false_depth, false_out, false_live)
        if !ms.diverged {
          tc_check_moves_in_cond(tc, ms, r, false_depth, false_out, false_live)
        }
      } else if op == "||" {
        let l_depth = ms.env.scopes.length()
        let l_false : Map[String, Span] = Map([])
        let l_fl : Array[Bool] = [false]
        env_push(ms.env)
        tc_check_moves_in_cond(tc, ms, l, l_depth, l_false, l_fl)
        let l_true_div = ms.diverged
        env_pop(ms.env)
        let l_true = moved_clone(ms.env.moved)
        let mut r_true_div = true
        let mut r_true : Map[String, Span] = Map([])
        if l_fl[0] {
          moved_set_from(ms.env.moved, l_false)
          ms.diverged = false
          env_push(ms.env)
          tc_check_moves_in_cond(tc, ms, r, false_depth, false_out, false_live)
          r_true_div = ms.diverged
          env_pop(ms.env)
          r_true = moved_clone(ms.env.moved)
        }
        if l_true_div && r_true_div {
          ms.diverged = true
        } else if l_true_div {
          moved_set_from(ms.env.moved, r_true)
          ms.diverged = false
        } else if r_true_div {
          moved_set_from(ms.env.moved, l_true)
          ms.diverged = false
        } else {
          moved_set_from(ms.env.moved, moved_union_maps(l_true, r_true))
          ms.diverged = false
        }
      } else {
        tc_check_moves_in_expr(tc, ms, cond)
        if !ms.diverged {
          ms_record_false(false_out, false_live, moved_snapshot_to_depth(ms.env, false_depth))
        }
      }
    EUnary(uop, inner, _) =>
      if uop == "!" {
        let cur_depth = ms.env.scopes.length()
        let sub_false : Map[String, Span] = Map([])
        let sub_fl : Array[Bool] = [false]
        env_push(ms.env)
        tc_check_moves_in_cond(tc, ms, inner, cur_depth, sub_false, sub_fl)
        let sub_true_div = ms.diverged
        env_pop(ms.env)
        if !sub_true_div {
          ms_record_false(false_out, false_live, moved_snapshot_to_depth(ms.env, false_depth))
        }
        if sub_fl[0] {
          moved_set_from(ms.env.moved, sub_false)
          ms.diverged = false
        } else {
          ms.diverged = true
        }
      } else {
        tc_check_moves_in_expr(tc, ms, cond)
        if !ms.diverged {
          ms_record_false(false_out, false_live, moved_snapshot_to_depth(ms.env, false_depth))
        }
      }
    EIs(scrut, pat, _) => {
      tc_check_moves_in_expr(tc, ms, scrut)
      if !ms.diverged {
        ms_record_false(false_out, false_live, moved_snapshot_to_depth(ms.env, false_depth))
      }
      let pbs : Array[String] = []
      recheck_pat_bindings(pat, pbs)
      tc_define_move_bindings(ms.env, pbs)
    }
    _ => {
      tc_check_moves_in_expr(tc, ms, cond)
      if !ms.diverged {
        ms_record_false(false_out, false_live, moved_snapshot_to_depth(ms.env, false_depth))
      }
    }
  }
}

///|
/// Single unified post-typecheck source-order move checker for every function,
/// method, extern body, constant, and test body in the compiler.
fn tc_check_moves_in_stmts(
  tc : TypeChecker,
  ms : MoveState,
  stmts : Array[Stmt],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    if ms.diverged {
      break
    }
    match stmts[i] {
      SLet(name, is_mut, _, init, _) => {
        tc_check_moves_in_expr(tc, ms, init)
        if name != "_" {
          env_define_line(ms.env, name, TError, is_mut, 0)
        }
      }
      SLetTuple(names, _, init, _) => {
        tc_check_moves_in_expr(tc, ms, init)
        tc_define_move_bindings(ms.env, names)
      }
      SAssign(lhs, rhs, _) =>
        match lhs {
          EIdent(x, _) => {
            tc_check_moves_in_expr(tc, ms, rhs)
            if !ms.diverged {
              match env_lookup(ms.env, x) {
                Some(_) => ms.env.moved.remove(x)
                None => env_define_line(ms.env, x, TError, true, 0)
              }
            }
          }
          EIndex(arr, idx, _) => {
            tc_check_moves_in_expr(tc, ms, arr)
            if !ms.diverged {
              tc_check_moves_in_expr(tc, ms, idx)
            }
            if !ms.diverged {
              tc_check_moves_in_expr(tc, ms, rhs)
            }
          }
          EField(obj, _, _) => {
            tc_check_moves_in_expr(tc, ms, obj)
            if !ms.diverged {
              tc_check_moves_in_expr(tc, ms, rhs)
            }
          }
          _ => {
            tc_check_moves_in_expr(tc, ms, lhs)
            if !ms.diverged {
              tc_check_moves_in_expr(tc, ms, rhs)
            }
          }
        }
      SCompoundAssign(_, lhs, rhs, _) => {
        tc_check_moves_in_expr(tc, ms, lhs)
        if !ms.diverged {
          tc_check_moves_in_expr(tc, ms, rhs)
        }
      }
      SGuard(cond, els, _) => {
        let cond_bs : Array[String] = []
        recheck_cond_is_bindings(cond, cond_bs)
        let outer_depth = ms.env.scopes.length()
        let false_m : Map[String, Span] = Map([])
        let false_live : Array[Bool] = [false]
        env_push(ms.env)
        tc_check_moves_in_cond(tc, ms, cond, outer_depth, false_m, false_live)
        let cond_div = ms.diverged
        let moved_in_cond : Map[String, Span] = Map([])
        let mut bi = 0
        while bi < cond_bs.length() {
          let bn = cond_bs[bi]
          match ms.env.moved.get(bn) {
            Some(sp) => moved_in_cond.set(bn, sp)
            None => ()
          }
          bi = bi + 1
        }
        env_pop(ms.env)
        let after_true = moved_clone(ms.env.moved)
        if false_live[0] {
          moved_set_from(ms.env.moved, false_m)
          ms.diverged = false
          env_push(ms.env)
          tc_check_moves_in_stmts(tc, ms, els)
          env_pop(ms.env)
        }
        moved_set_from(ms.env.moved, after_true)
        ms.diverged = cond_div
        tc_define_move_bindings(ms.env, cond_bs)
        let mks = moved_in_cond.keys()
        let mut mi = 0
        while mi < mks.length() {
          let k = mks[mi]
          match moved_in_cond.get(k) {
            Some(sp) => ms.env.moved.set(k, sp)
            None => ()
          }
          mi = mi + 1
        }
      }
      SWhile(cond, body, _) => {
        let is_inf_true = match cond {
          EBool(true, _) => true
          _ => false
        }
        let lidx = ms_push_loop(ms)
        let m_entry = moved_clone(ms.env.moved)
        let outer_depth = ms.env.scopes.length()
        let false0 : Map[String, Span] = Map([])
        let false0_live : Array[Bool] = [false]
        env_push(ms.env)
        tc_check_moves_in_cond(tc, ms, cond, outer_depth, false0, false0_live)
        if !ms.diverged {
          tc_check_moves_in_stmts(tc, ms, body)
        }
        let end0_div = ms.diverged
        env_pop(ms.env)
        let end0_m = moved_clone(ms.env.moved)
        let had_cont0 = ms.loop_had_cont[lidx]
        let has_back0 = !end0_div || had_cont0
        let mut back0 : Map[String, Span] = Map([])
        if !end0_div {
          back0 = end0_m
        }
        if had_cont0 {
          back0 = if !end0_div {
            moved_union_maps(back0, ms.loop_cont_moved[lidx])
          } else {
            moved_clone(ms.loop_cont_moved[lidx])
          }
        }
        let mut post_live = !is_inf_true && false0_live[0]
        let mut post : Map[String, Span] = if post_live { false0 } else { Map([]) }
        if has_back0 && moved_has_new_key(m_entry, back0) {
          ms.loop_cont_moved[lidx] = Map([])
          ms.loop_had_cont[lidx] = false
          moved_set_from(ms.env.moved, moved_union_maps(m_entry, back0))
          ms.diverged = false
          let false1 : Map[String, Span] = Map([])
          let false1_live : Array[Bool] = [false]
          env_push(ms.env)
          tc_check_moves_in_cond(tc, ms, cond, outer_depth, false1, false1_live)
          if !ms.diverged {
            tc_check_moves_in_stmts(tc, ms, body)
          }
          env_pop(ms.env)
          if !is_inf_true && false1_live[0] {
            if post_live {
              post = moved_union_maps(post, false1)
            } else {
              post = false1
              post_live = true
            }
          }
        }
        if ms.loop_had_break[lidx] {
          if post_live {
            post = moved_union_maps(post, ms.loop_break_moved[lidx])
          } else {
            post = ms.loop_break_moved[lidx]
            post_live = true
          }
        }
        ms_pop_loop(ms)
        if post_live {
          moved_set_from(ms.env.moved, post)
          ms.diverged = false
        } else {
          ms.diverged = true
        }
      }
      SFor(init, cond, step, body, _) => {
        let is_inf_true = match cond {
          EBool(true, _) => true
          _ => false
        }
        env_push(ms.env)
        tc_check_moves_in_stmts(tc, ms, [init])
        if !ms.diverged {
          let lidx = ms_push_loop(ms)
          let m_entry = moved_clone(ms.env.moved)
          let outer_depth = ms.env.scopes.length()
          let false0 : Map[String, Span] = Map([])
          let false0_live : Array[Bool] = [false]
          env_push(ms.env)
          tc_check_moves_in_cond(tc, ms, cond, outer_depth, false0, false0_live)
          if !ms.diverged {
            tc_check_moves_in_stmts(tc, ms, body)
          }
          let body_div0 = ms.diverged
          env_pop(ms.env)
          let had_cont0 = ms.loop_had_cont[lidx]
          let mut has_back0 = false
          let mut back0 : Map[String, Span] = Map([])
          if !body_div0 || had_cont0 {
            let step_in = if !body_div0 && had_cont0 {
              moved_union_maps(ms.env.moved, ms.loop_cont_moved[lidx])
            } else if !body_div0 {
              moved_clone(ms.env.moved)
            } else {
              moved_clone(ms.loop_cont_moved[lidx])
            }
            moved_set_from(ms.env.moved, step_in)
            ms.diverged = false
            tc_check_moves_in_stmts(tc, ms, [step])
            if !ms.diverged {
              has_back0 = true
              back0 = moved_clone(ms.env.moved)
            }
          }
          let mut post_live = !is_inf_true && false0_live[0]
          let mut post : Map[String, Span] = if post_live { false0 } else { Map([]) }
          if has_back0 && moved_has_new_key(m_entry, back0) {
            ms.loop_cont_moved[lidx] = Map([])
            ms.loop_had_cont[lidx] = false
            moved_set_from(ms.env.moved, moved_union_maps(m_entry, back0))
            ms.diverged = false
            let false1 : Map[String, Span] = Map([])
            let false1_live : Array[Bool] = [false]
            env_push(ms.env)
            tc_check_moves_in_cond(tc, ms, cond, outer_depth, false1, false1_live)
            if !ms.diverged {
              tc_check_moves_in_stmts(tc, ms, body)
            }
            let body_div1 = ms.diverged
            env_pop(ms.env)
            let had_cont1 = ms.loop_had_cont[lidx]
            if !body_div1 || had_cont1 {
              let step_in1 = if !body_div1 && had_cont1 {
                moved_union_maps(ms.env.moved, ms.loop_cont_moved[lidx])
              } else if !body_div1 {
                moved_clone(ms.env.moved)
              } else {
                moved_clone(ms.loop_cont_moved[lidx])
              }
              moved_set_from(ms.env.moved, step_in1)
              ms.diverged = false
              tc_check_moves_in_stmts(tc, ms, [step])
            }
            if !is_inf_true && false1_live[0] {
              if post_live {
                post = moved_union_maps(post, false1)
              } else {
                post = false1
                post_live = true
              }
            }
          }
          if ms.loop_had_break[lidx] {
            if post_live {
              post = moved_union_maps(post, ms.loop_break_moved[lidx])
            } else {
              post = ms.loop_break_moved[lidx]
              post_live = true
            }
          }
          ms_pop_loop(ms)
          if post_live {
            moved_set_from(ms.env.moved, post)
            ms.diverged = false
          } else {
            ms.diverged = true
          }
        }
        env_pop(ms.env)
      }
      SForRange(v, lo, hi, _, body, _) => {
        tc_check_moves_in_expr(tc, ms, lo)
        if !ms.diverged {
          tc_check_moves_in_expr(tc, ms, hi)
        }
        if !ms.diverged {
          let lidx = ms_push_loop(ms)
          let m_entry = moved_clone(ms.env.moved)
          env_push(ms.env)
          if v != "_" {
            env_define_line(ms.env, v, TError, false, 0)
          }
          tc_check_moves_in_stmts(tc, ms, body)
          let end0_div = ms.diverged
          env_pop(ms.env)
          let end0_m = moved_clone(ms.env.moved)
          let had_cont0 = ms.loop_had_cont[lidx]
          let has_back0 = !end0_div || had_cont0
          let mut back0 : Map[String, Span] = Map([])
          if !end0_div {
            back0 = end0_m
          }
          if had_cont0 {
            back0 = if !end0_div {
              moved_union_maps(back0, ms.loop_cont_moved[lidx])
            } else {
              moved_clone(ms.loop_cont_moved[lidx])
            }
          }
          let mut post = m_entry
          if has_back0 {
            post = moved_union_maps(post, back0)
          }
          if has_back0 && moved_has_new_key(m_entry, back0) {
            ms.loop_cont_moved[lidx] = Map([])
            ms.loop_had_cont[lidx] = false
            moved_set_from(ms.env.moved, moved_union_maps(m_entry, back0))
            ms.diverged = false
            env_push(ms.env)
            if v != "_" {
              env_define_line(ms.env, v, TError, false, 0)
            }
            tc_check_moves_in_stmts(tc, ms, body)
            let end1_div = ms.diverged
            env_pop(ms.env)
            if !end1_div {
              post = moved_union_maps(post, ms.env.moved)
            }
            if ms.loop_had_cont[lidx] {
              post = moved_union_maps(post, ms.loop_cont_moved[lidx])
            }
          }
          if ms.loop_had_break[lidx] {
            post = moved_union_maps(post, ms.loop_break_moved[lidx])
          }
          ms_pop_loop(ms)
          moved_set_from(ms.env.moved, post)
          ms.diverged = false
        }
      }
      SForIn(v1, v2, iter, body, _) => {
        tc_check_moves_in_expr(tc, ms, iter)
        if !ms.diverged {
          let lidx = ms_push_loop(ms)
          let m_entry = moved_clone(ms.env.moved)
          env_push(ms.env)
          if v1 != "_" {
            env_define_line(ms.env, v1, TError, false, 0)
          }
          if v2.length() > 0 && v2 != "_" {
            env_define_line(ms.env, v2, TError, false, 0)
          }
          tc_check_moves_in_stmts(tc, ms, body)
          let end0_div = ms.diverged
          env_pop(ms.env)
          let end0_m = moved_clone(ms.env.moved)
          let had_cont0 = ms.loop_had_cont[lidx]
          let has_back0 = !end0_div || had_cont0
          let mut back0 : Map[String, Span] = Map([])
          if !end0_div {
            back0 = end0_m
          }
          if had_cont0 {
            back0 = if !end0_div {
              moved_union_maps(back0, ms.loop_cont_moved[lidx])
            } else {
              moved_clone(ms.loop_cont_moved[lidx])
            }
          }
          let mut post = m_entry
          if has_back0 {
            post = moved_union_maps(post, back0)
          }
          if has_back0 && moved_has_new_key(m_entry, back0) {
            ms.loop_cont_moved[lidx] = Map([])
            ms.loop_had_cont[lidx] = false
            moved_set_from(ms.env.moved, moved_union_maps(m_entry, back0))
            ms.diverged = false
            env_push(ms.env)
            if v1 != "_" {
              env_define_line(ms.env, v1, TError, false, 0)
            }
            if v2.length() > 0 && v2 != "_" {
              env_define_line(ms.env, v2, TError, false, 0)
            }
            tc_check_moves_in_stmts(tc, ms, body)
            let end1_div = ms.diverged
            env_pop(ms.env)
            if !end1_div {
              post = moved_union_maps(post, ms.env.moved)
            }
            if ms.loop_had_cont[lidx] {
              post = moved_union_maps(post, ms.loop_cont_moved[lidx])
            }
          }
          if ms.loop_had_break[lidx] {
            post = moved_union_maps(post, ms.loop_break_moved[lidx])
          }
          ms_pop_loop(ms)
          moved_set_from(ms.env.moved, post)
          ms.diverged = false
        }
      }
      SReturn(opt_e, _) => {
        match opt_e {
          Some(e) => tc_check_moves_in_expr(tc, ms, e)
          None => ()
        }
        ms.diverged = true
      }
      SBreak(_) => {
        if ms.loop_break_moved.length() > 0 {
          let idx = ms.loop_break_moved.length() - 1
          let snap = moved_snapshot_to_depth(ms.env, ms.loop_scope_depth[idx])
          if ms.loop_had_break[idx] {
            ms.loop_break_moved[idx] = moved_union_maps(ms.loop_break_moved[idx], snap)
          } else {
            ms.loop_break_moved[idx] = snap
            ms.loop_had_break[idx] = true
          }
        }
        ms.diverged = true
      }
      SContinue(_) => {
        if ms.loop_cont_moved.length() > 0 {
          let idx = ms.loop_cont_moved.length() - 1
          let snap = moved_snapshot_to_depth(ms.env, ms.loop_scope_depth[idx])
          if ms.loop_had_cont[idx] {
            ms.loop_cont_moved[idx] = moved_union_maps(ms.loop_cont_moved[idx], snap)
          } else {
            ms.loop_cont_moved[idx] = snap
            ms.loop_had_cont[idx] = true
          }
        }
        ms.diverged = true
      }
      SDebugAssert(cond, msg, _) => {
        let pre_da = moved_clone(ms.env.moved)
        tc_check_moves_in_expr(tc, ms, cond)
        if !ms.diverged {
          tc_check_moves_in_expr(tc, ms, msg)
        }
        if ms.diverged {
          moved_set_from(ms.env.moved, pre_da)
        } else {
          moved_set_from(ms.env.moved, moved_union_maps(pre_da, ms.env.moved))
        }
        ms.diverged = false
      }
      SExpr(e, _) => tc_check_moves_in_expr(tc, ms, e)
    }
    i = i + 1
  }
}

///|
fn tc_check_moves_in_expr(
  tc : TypeChecker,
  ms : MoveState,
  e : Expr,
) -> Unit {
  if ms.diverged {
    return
  }
  match e {
    EIdent(x, isp) =>
      if ms.env.moved.contains(x) {
        ms_err_moved(
          tc,
          ms,
          isp,
          x,
          "use of moved value `" + x + "`",
          "do not use `" + x + "` after `move`, or pass a separate value",
        )
      }
    EMove(inner, _) =>
      match inner {
        EIdent(x, isp) =>
          if ms.env.moved.contains(x) {
            ms_err_moved(
              tc,
              ms,
              isp,
              x,
              "value `" + x + "` was already moved",
              "move `" + x + "` at most once",
            )
          } else {
            match env_lookup(ms.env, x) {
              Some(_) => {
                ms.env.moved.set(x, isp)
                let bdepth = env_binding_depth(ms.env, x)
                if bdepth >= 0 {
                  let mut ci = 0
                  while ci < ms.closure_moved_stack.length() {
                    if bdepth < ms.closure_scope_depth[ci] {
                      ms.closure_moved_stack[ci].set(x, isp)
                    }
                    ci = ci + 1
                  }
                }
              }
              None => ()
            }
          }
        _ => tc_check_moves_in_expr(tc, ms, inner)
      }
    ENamedArg(_, _, inner, _) | EMutArg(inner, _) | EUnary(_, inner, _) | EField(inner, _, _) | EAs(inner, _, _) | ETry(inner, _) =>
      tc_check_moves_in_expr(tc, ms, inner)
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        let outer_depth = ms.env.scopes.length()
        let false_m : Map[String, Span] = Map([])
        let false_live : Array[Bool] = [false]
        env_push(ms.env)
        tc_check_moves_in_cond(tc, ms, e, outer_depth, false_m, false_live)
        let d_true = ms.diverged
        env_pop(ms.env)
        if d_true && !false_live[0] {
          ms.diverged = true
        } else if d_true {
          moved_set_from(ms.env.moved, false_m)
          ms.diverged = false
        } else if !false_live[0] {
          ms.diverged = false
        } else {
          moved_set_from(ms.env.moved, moved_union_maps(ms.env.moved, false_m))
          ms.diverged = false
        }
      } else {
        tc_check_moves_in_expr(tc, ms, l)
        if !ms.diverged {
          tc_check_moves_in_expr(tc, ms, r)
        }
      }
    ECall(callee, args, csp) => {
      let skip_callee = match callee {
        EIdent(_, _) =>
          tc.resolved_method_calls.contains("call_nonlocal:" + span_key(csp)) ||
          tc.resolved_method_calls.contains("call_pkg:" + span_key(csp))
        _ => false
      }
      if !skip_callee {
        tc_check_moves_in_expr(tc, ms, callee)
      }
      let mut i = 0
      while i < args.length() && !ms.diverged {
        tc_check_moves_in_expr(tc, ms, args[i])
        i = i + 1
      }
      if tc.never_calls.contains(span_key(csp)) {
        ms.diverged = true
      }
    }
    EMethodCall(recv, _, args, msp) => {
      tc_check_moves_in_expr(tc, ms, recv)
      let mut i = 0
      while i < args.length() && !ms.diverged {
        tc_check_moves_in_expr(tc, ms, args[i])
        i = i + 1
      }
      if tc.never_calls.contains(span_key(msp)) {
        ms.diverged = true
      }
    }
    EIndex(arr, idx, _) => {
      tc_check_moves_in_expr(tc, ms, arr)
      if !ms.diverged {
        tc_check_moves_in_expr(tc, ms, idx)
      }
    }
    EArrayLit(es, _) | ETuple(es, _) | EDotVariant(_, es, _) | EInterp(es, _) => {
      let mut i = 0
      while i < es.length() && !ms.diverged {
        tc_check_moves_in_expr(tc, ms, es[i])
        i = i + 1
      }
    }
    EStructLit(_, spread, fields, _) => {
      match spread {
        Some(se) => tc_check_moves_in_expr(tc, ms, se)
        None => ()
      }
      let mut i = 0
      while i < fields.length() && !ms.diverged {
        tc_check_moves_in_expr(tc, ms, fields[i].value)
        i = i + 1
      }
    }
    EBlock(ss, _) => {
      env_push(ms.env)
      tc_check_moves_in_stmts(tc, ms, ss)
      env_pop(ms.env)
    }
    EIf(cond, then_ss, else_opt, _) => {
      let outer_depth = ms.env.scopes.length()
      let false_m : Map[String, Span] = Map([])
      let false_live : Array[Bool] = [false]
      env_push(ms.env)
      tc_check_moves_in_cond(tc, ms, cond, outer_depth, false_m, false_live)
      if !ms.diverged {
        tc_check_moves_in_stmts(tc, ms, then_ss)
      }
      let d_then = ms.diverged
      env_pop(ms.env)
      let m_then = moved_clone(ms.env.moved)
      let mut d_else = true
      let mut m_else : Map[String, Span] = Map([])
      if false_live[0] {
        moved_set_from(ms.env.moved, false_m)
        ms.diverged = false
        match else_opt {
          Some(ee) => tc_check_moves_in_expr(tc, ms, ee)
          None => ()
        }
        d_else = ms.diverged
        m_else = moved_clone(ms.env.moved)
      }
      if d_then && d_else {
        ms.diverged = true
      } else if d_then {
        moved_set_from(ms.env.moved, m_else)
        ms.diverged = false
      } else if d_else {
        moved_set_from(ms.env.moved, m_then)
        ms.diverged = false
      } else {
        moved_set_from(ms.env.moved, moved_union_maps(m_then, m_else))
        ms.diverged = false
      }
    }
    EMatch(scrut, arms, _) => {
      tc_check_moves_in_expr(tc, ms, scrut)
      if !ms.diverged && arms.length() > 0 {
        let mut entry = moved_clone(ms.env.moved)
        let mut entry_live = true
        let mut any_arm_live = false
        let mut merged : Map[String, Span] = Map([])
        let mut ai = 0
        while ai < arms.length() {
          let arm = arms[ai]
          if !entry_live {
            ai = ai + 1
            continue
          }
          moved_set_from(ms.env.moved, entry)
          ms.diverged = false
          let match_outer_depth = ms.env.scopes.length()
          env_push(ms.env)
          let pbs : Array[String] = []
          recheck_pat_bindings(arm.pat, pbs)
          tc_define_move_bindings(ms.env, pbs)
          let irref = ms_pat_is_irrefutable(arm.pat)
          match arm.guard_expr {
            Some(ge) => {
              let g_false : Map[String, Span] = Map([])
              let g_false_live : Array[Bool] = [false]
              tc_check_moves_in_cond(tc, ms, ge, match_outer_depth, g_false, g_false_live)
              if irref {
                if g_false_live[0] {
                  entry = g_false
                } else {
                  entry_live = false
                }
              } else if g_false_live[0] {
                entry = moved_union_maps(entry, g_false)
              }
            }
            None =>
              if irref {
                entry_live = false
              }
          }
          if !ms.diverged {
            tc_check_moves_in_expr(tc, ms, arm.body)
          }
          let arm_div = ms.diverged
          env_pop(ms.env)
          if !arm_div {
            if !any_arm_live {
              merged = moved_clone(ms.env.moved)
              any_arm_live = true
            } else {
              merged = moved_union_maps(merged, ms.env.moved)
            }
          }
          ai = ai + 1
        }
        if any_arm_live {
          moved_set_from(ms.env.moved, merged)
          ms.diverged = false
        } else {
          ms.diverged = true
        }
      }
    }
    EIs(scrut, _, _) => tc_check_moves_in_expr(tc, ms, scrut)
    EClosure(params, _, body, _) => {
      let pre_cl_moved = moved_clone(ms.env.moved)
      let saved_div = ms.diverged
      ms.diverged = false
      ms.closure_moved_stack.push(Map([]))
      ms.closure_scope_depth.push(ms.env.scopes.length())
      env_push(ms.env)
      let mut pi = 0
      while pi < params.length() {
        if params[pi].name != "_" {
          env_define_line(ms.env, params[pi].name, TError, params[pi].is_mut, 0)
        }
        pi = pi + 1
      }
      tc_check_moves_in_stmts(tc, ms, body)
      env_pop(ms.env)
      let cl_moves = match ms.closure_moved_stack.pop() {
        Some(m) => m
        None => Map([])
      }
      let _ = ms.closure_scope_depth.pop()
      ms.diverged = saved_div
      moved_set_from(
        ms.env.moved,
        moved_union_maps(pre_cl_moved, moved_union_maps(ms.env.moved, cl_moves)),
      )
    }
    EScope(w, f, _) | ESpawn(w, f, _) => {
      tc_check_moves_in_expr(tc, ms, w)
      if !ms.diverged {
        tc_check_moves_in_expr(tc, ms, f)
      }
    }
    _ => ()
  }
}

///|
fn tc_check_moves_fn_decl(
  tc : TypeChecker,
  params : Array[Param],
  body : Array[Stmt],
) -> Unit {
  let ms = move_state_new()
  let mut pi = 0
  while pi < params.length() {
    match params[pi].default_expr {
      Some(def) => {
        let saved = moved_clone(ms.env.moved)
        let saved_div = ms.diverged
        ms.diverged = false
        env_push(ms.env)
        tc_check_moves_in_expr(tc, ms, def)
        env_pop(ms.env)
        moved_set_from(ms.env.moved, saved)
        ms.diverged = saved_div
      }
      None => ()
    }
    if params[pi].name != "_" {
      env_define_line(ms.env, params[pi].name, TError, params[pi].is_mut, params[pi].span.line)
    }
    pi = pi + 1
  }
  tc_check_moves_in_stmts(tc, ms, body)
}

///|
fn check_fn_call(
  tc : TypeChecker,
  env : Env,
  finfo : FnInfo,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
  target : String,
) -> Ty {
  let subst : Map[String, Ty] = Map([])
  match expected {
    Some(exp_ty) => unify_tparams(finfo.ret_ty, exp_ty, subst)
    None => ()
  }
  let use_named = params_need_named_resolution(finfo.decl.params, 0, args)
  let mut resolved_args = args
  let mut missing_flags : Array[Bool] = []
  let mut default_flags : Array[Bool] = []
  let mut raw_indices : Array[Int] = []
  let mut opt_wrapped_flags : Array[Bool] = []
  if use_named {
    let res = resolve_call_args_impl(
      Some(tc),
      finfo.decl.params,
      0,
      args,
      finfo.decl.name,
      sp,
    )
    resolved_args = res.args
    missing_flags = res.missing
    default_flags = res.from_default
    raw_indices = res.raw_idx
    opt_wrapped_flags = res.opt_wrapped
  } else if args.length() != finfo.param_tys.length() {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "function `" +
      finfo.decl.name +
      "` expects " +
      finfo.param_tys.length().to_string() +
      " argument(s), found " +
      args.length().to_string(),
      finfo.param_tys.length().to_string() + " args",
      args.length().to_string() + " args",
      "pass " + finfo.param_tys.length().to_string() + " argument(s)",
    )
    add_arity_edit(tc, sp, args, finfo.param_tys)
  }
  let fnval_exp : Array[String] = []
  let mut fi_init = 0
  while fi_init < resolved_args.length() {
    fnval_exp.push("")
    fi_init = fi_init + 1
  }
  let defer_flags : Array[Bool] = []
  let mut has_deferred = false
  let mut di_init = 0
  while di_init < resolved_args.length() {
    let is_miss = di_init < missing_flags.length() && missing_flags[di_init]
    let is_def = di_init < default_flags.length() && default_flags[di_init]
    let is_opt_wrap = use_named && di_init < opt_wrapped_flags.length() && opt_wrapped_flags[di_init]
    let p_has_tp = di_init < finfo.param_tys.length() &&
      ty_has_tparam(subst_ty(finfo.param_tys[di_init], subst))
    let dcl = !is_miss &&
      !is_def &&
      p_has_tp &&
      expr_is_unannotated_closure_arg(resolved_args[di_init], is_opt_wrap)
    defer_flags.push(dcl)
    if dcl {
      has_deferred = true
    }
    di_init = di_init + 1
  }
  // O(N) source-order traversal: explicit args (`raw_i = 0, 1, ...`), then defaults (`raw_i < 0`).
  let check_order : Array[Int] = []
  if !use_named {
    let mut si = 0
    while si < resolved_args.length() {
      if !(si < missing_flags.length() && missing_flags[si]) {
        check_order.push(si)
      }
      si = si + 1
    }
  } else {
    let raw_to_slot : Array[Int] = []
    let mut rinit = 0
    while rinit < args.length() {
      raw_to_slot.push(-1)
      rinit = rinit + 1
    }
    let def_slots : Array[Int] = []
    let mut si = 0
    while si < resolved_args.length() {
      if !(si < missing_flags.length() && missing_flags[si]) {
        let ridx = if si < raw_indices.length() { raw_indices[si] } else { -1 }
        if ridx >= 0 && ridx < raw_to_slot.length() && raw_to_slot[ridx] < 0 {
          raw_to_slot[ridx] = si
        } else {
          def_slots.push(si)
        }
      }
      si = si + 1
    }
    let mut rk = 0
    while rk < raw_to_slot.length() {
      if raw_to_slot[rk] >= 0 {
        check_order.push(raw_to_slot[rk])
      }
      rk = rk + 1
    }
    let mut dsi = 0
    while dsi < def_slots.length() {
      check_order.push(def_slots[dsi])
      dsi = dsi + 1
    }
  }
  let mut pass = 0
  while pass < 2 {
    if pass == 1 && !has_deferred {
      break
    }
    let mut ci = 0
    while ci < check_order.length() {
      let i = check_order[ci]
      let is_def = i < default_flags.length() && default_flags[i]
      let defer_cl = defer_flags[i]
      if (pass == 0 && defer_cl) || (pass == 1 && !defer_cl) {
        ci = ci + 1
        continue
      }
      let p_is_into = !is_def && param_is_into_at(finfo.decl.params, i)
    let raw_i = if use_named {
      if i < raw_indices.length() { raw_indices[i] } else { -1 }
    } else {
      i
    }
    let is_opt_wrap = use_named && i < opt_wrapped_flags.length() && opt_wrapped_flags[i]
    let exp_p : Option[Ty] = if i < finfo.param_tys.length() {
      Some(subst_ty_mask_unbound(finfo.param_tys[i], finfo.decl.type_params, subst))
    } else {
      None
    }
    let arg_env = if is_def {
      make_default_arg_env(tc, env, finfo.decl, finfo.param_tys, subst, i, [], finfo.is_imported)
    } else {
      env
    }
    let mut handled_opt_into = false
    if p_is_into && is_opt_wrap && raw_i >= 0 {
      match resolved_args[i] {
        ECall(_, some_args, _) =>
          if some_args.length() == 1 {
            match exp_p {
              Some(TOption(inner_target)) => {
                handled_opt_into = true
                let inner_arg = some_args[0]
                let inner_exp = into_adjust_arg_expected(tc, inner_arg, Some(inner_target), true)
                let inner_aty = check_expr(tc, arg_env, inner_arg, inner_exp)
                if !ty_compat(inner_target, inner_aty) {
                  let ir = resolve_into_conversion(tc, arg_env, inner_aty, inner_target, expr_span(inner_arg))
                  match ir.conv {
                    Some(conv) =>
                      tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
                    None =>
                      if !ir.errored {
                        tc_err(
                          tc,
                          expr_span(inner_arg),
                          "E_TYPE_MISMATCH",
                          "argument " + (i + 1).to_string() + " type mismatch in call to `" + finfo.decl.name + "`",
                          ty_to_string(inner_target),
                          ty_to_string(inner_aty),
                          "pass a value of type `" + ty_to_string(inner_target) + "`" + ir.available_hint,
                        )
                      }
                  }
                }
                if i < finfo.param_tys.length() {
                  unify_tparams(finfo.param_tys[i], TOption(inner_target), subst)
                }
              }
              _ => ()
            }
          }
        _ => ()
      }
    }
    if !handled_opt_into {
      let unbound_param_tps : Array[String] = if pass == 1 &&
        defer_cl &&
        !is_def &&
        i < finfo.param_tys.length() {
        collect_unbound_fn_param_tparams(
          finfo.param_tys[i],
          is_opt_wrap,
          finfo.decl.type_params,
          subst,
        )
      } else {
        []
      }
      let diag_mark = tc.diagnostics.length()
      let eq_uses_mark = tc.eq_uses.length()
      let op_key_mark = tc.op_keys.length()
      let op_cur_len = if env.fn_key != "" {
        match tc.op_tparams.get(env.fn_key) {
          Some(a) => a.length()
          None => 0
        }
      } else {
        0
      }
      let arg_exp = if is_def && i < finfo.param_tys.length() {
        Some(finfo.param_tys[i])
      } else {
        into_adjust_arg_expected(tc, resolved_args[i], exp_p, p_is_into)
      }
      let saved_tc_def = tc.in_default_arg_expansion
      let saved_tc_imp_def = tc.in_imported_default_arg
      if is_def {
        tc.in_default_arg_expansion = true
        if finfo.is_imported {
          tc.in_imported_default_arg = true
        }
      }
      let mut aty = check_call_arg(
        tc,
        arg_env,
        param_at(finfo.decl.params, i),
        resolved_args[i],
        arg_exp,
        finfo.decl.name,
      )
      tc.in_default_arg_expansion = saved_tc_def
      tc.in_imported_default_arg = saved_tc_imp_def
      if !is_def {
        fnval_exp[i] = tc_fnval_exp_key(arg_exp)
      }
      if i < finfo.param_tys.length() {
        let mut eff_aty = if is_def { subst_ty(aty, subst) } else { aty }
        let pre_pty = subst_ty(finfo.param_tys[i], subst)
        let mut into_errored = false
        let mut into_hint = ""
        if p_is_into && raw_i >= 0 && !ty_compat(pre_pty, aty) && !ty_has_unresolved(pre_pty) {
          let ir = resolve_into_conversion(tc, env, aty, pre_pty, expr_span(resolved_args[i]))
          match ir.conv {
            Some(conv) => {
              tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
              eff_aty = pre_pty
            }
            None => {
              into_errored = ir.errored
              into_hint = ir.available_hint
            }
          }
        }
        unify_tparams(finfo.param_tys[i], eff_aty, subst)
        if unbound_param_tps.length() > 0 && any_tparam_now_concrete(unbound_param_tps, subst) {
          while tc.diagnostics.length() > diag_mark {
            let _ = tc.diagnostics.pop()
          }
          while tc.eq_uses.length() > eq_uses_mark {
            let _ = tc.eq_uses.pop()
          }
          if env.fn_key != "" {
            match tc.op_tparams.get(env.fn_key) {
              Some(a) => {
                while a.length() > op_cur_len {
                  let _ = a.pop()
                }
                if op_cur_len == 0 {
                  tc.op_tparams.remove(env.fn_key)
                }
              }
              None => ()
            }
          }
          while tc.op_keys.length() > op_key_mark {
            let _ = tc.op_keys.pop()
          }
          let exp_p2 : Option[Ty] = Some(
            subst_ty_mask_unbound(finfo.param_tys[i], finfo.decl.type_params, subst),
          )
          let arg_exp2 = into_adjust_arg_expected(tc, resolved_args[i], exp_p2, p_is_into)
          aty = check_call_arg(
            tc,
            arg_env,
            param_at(finfo.decl.params, i),
            resolved_args[i],
            arg_exp2,
            finfo.decl.name,
          )
          fnval_exp[i] = tc_fnval_exp_key(arg_exp2)
          eff_aty = aty
          into_errored = false
          into_hint = ""
          let pre_pty2 = subst_ty(finfo.param_tys[i], subst)
          if p_is_into && raw_i >= 0 && !ty_compat(pre_pty2, aty) && !ty_has_unresolved(pre_pty2) {
            let ir = resolve_into_conversion(tc, env, aty, pre_pty2, expr_span(resolved_args[i]))
            match ir.conv {
              Some(conv) => {
                tc.call_into_convs.set(span_key(sp) + "#" + raw_i.to_string(), conv)
                eff_aty = pre_pty2
              }
              None => {
                into_errored = ir.errored
                into_hint = ir.available_hint
              }
            }
          }
          unify_tparams(finfo.param_tys[i], eff_aty, subst)
        }
        let pty = subst_ty(finfo.param_tys[i], subst)
        if !into_errored &&
          (!ty_compat(pty, eff_aty) ||
          (param_is_mut_at(finfo.decl.params, i) && !ty_compat(eff_aty, pty))) {
          tc_err(
            tc,
            expr_span(resolved_args[i]),
            "E_TYPE_MISMATCH",
            "argument " + (i + 1).to_string() + " type mismatch in call to `" + finfo.decl.name + "`",
            ty_to_string(pty),
            ty_to_string(eff_aty),
            "pass a value of type `" + ty_to_string(pty) + "`" + into_hint,
          )
        }
      }
    }
    ci = ci + 1
  }
  pass = pass + 1
  }
  tc_recheck_fn_value_args(
    tc,
    env,
    finfo.decl,
    finfo.param_tys,
    0,
    resolved_args,
    fnval_exp,
    subst,
    "in call to `" + finfo.decl.name + "`",
    true,
  )
  // Validate trait bounds on generic type parameters
  tc_check_type_bounds(tc, env, finfo.decl, subst, sp, finfo.is_imported)
  if params_have_mut(finfo.decl.params) {
    let muts : Array[Bool] = []
    let mut mi = 0
    while mi < resolved_args.length() {
      muts.push(param_is_mut_at(finfo.decl.params, mi))
      mi = mi + 1
    }
    check_mut_call_aliasing(tc, resolved_args, muts, finfo.decl.name)
  }
  tc_check_verify_callee(tc, env, finfo.decl, target, sp)
  tc_record_call(tc, env, sp, target, finfo.decl.type_params, subst)
  tc_record_arg_order(tc, env, sp, args, resolved_args)
  if use_named {
    tc_record_named_targs(tc, finfo.decl, subst, sp)
  }
  // Record instantiations; `resolve_eq_uses` rejects non-comparable ones once
  // every generic body (and its `==` uses) has been checked.
  tc_push_eq_uses(tc, env, finfo.decl, finfo.decl.name, subst, sp)
  // A generic call that may relay fn values (`tc_refine_relay`), with the
  // instantiation its arguments fixed.
  tc_record_gcall(tc, finfo.decl, subst, sp)
  if fn_statically_diverges(finfo) {
    tc.never_calls.set(span_key(sp), true)
  }
  // A type param no argument fixed is unresolved, never the callee's own
  // `TParam` leaking into the caller (`pass(second)` before `T` is known).
  subst_ty_mask_unbound(finfo.ret_ty, finfo.decl.type_params, subst)
}

///|
/// `arr.swap(i : Int, j : Int) -> Unit` on `Array[T]` / `FixedArray[T]`.
fn check_swap_args(tc : TypeChecker, env : Env, args : Array[Expr], sp : Span) -> Unit {
  if args.length() != 2 {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "`swap` expects 2 arguments (i : Int, j : Int), found " + args.length().to_string(),
      "2 args",
      args.length().to_string() + " args",
      "call `.swap(i, j)`",
    )
  }
  let mut i = 0
  while i < args.length() {
    let aty = check_expr(tc, env, args[i], Some(TInt))
    if !ty_compat(TInt, aty) {
      tc_err(
        tc,
        expr_span(args[i]),
        "E_TYPE_MISMATCH",
        "`swap` index must be `Int`",
        "Int",
        ty_to_string(aty),
        "pass `Int` indices",
      )
    }
    i = i + 1
  }
}

///|
fn check_no_args(
  tc : TypeChecker,
  env : Env,
  method_name : String,
  args : Array[Expr],
  sp : Span,
) -> Unit {
  if args.length() != 0 {
    let mut i = 0
    while i < args.length() {
      let _ = check_expr(tc, env, args[i], None)
      i = i + 1
    }
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "`" + method_name + "` takes no arguments, found " + args.length().to_string(),
      "0 args",
      args.length().to_string() + " args",
      "call `." + method_name + "()`",
    )
  }
}

///|
fn check_unwrap_or_arg(
  tc : TypeChecker,
  env : Env,
  inner : Ty,
  args : Array[Expr],
  sp : Span,
) -> Unit {
  if args.length() != 1 {
    tc_err(
      tc,
      sp,
      "E_TYPE_MISMATCH",
      "`unwrap_or` expects 1 argument (the default), found " + args.length().to_string(),
      "1 arg",
      args.length().to_string() + " args",
      "call `.unwrap_or(<default : " + ty_to_string(inner) + ">)`",
    )
  }
  let mut i = 0
  while i < args.length() {
    let aty = check_expr(tc, env, args[i], Some(inner))
    if i == 0 && !ty_compat(inner, aty) {
      tc_err(
        tc,
        expr_span(args[i]),
        "E_TYPE_MISMATCH",
        "`unwrap_or` default type mismatch",
        ty_to_string(inner),
        ty_to_string(aty),
        "pass a default of type `" + ty_to_string(inner) + "`",
      )
    }
    i = i + 1
  }
}

///|
fn check_int_bitop_method(
  tc : TypeChecker,
  env : Env,
  recv_ty : Ty,
  method_name : String,
  args : Array[Expr],
  sp : Span,
) -> Option[Ty] {
  if method_name == "rotate_left" || method_name == "rotate_right" {
    if args.length() != 1 {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "method `" +
        method_name +
        "` expects 1 argument(s), found " +
        args.length().to_string(),
        "1 args",
        args.length().to_string() + " args",
        "pass 1 `Int` shift count argument",
      )
    } else {
      let aty = check_expr(tc, env, args[0], Some(TInt))
      match aty {
        TInt | TError => ()
        _ =>
          tc_err(
            tc,
            expr_span(args[0]),
            "E_TYPE_MISMATCH",
            "`" + method_name + "` count must be `Int`, got `" + ty_to_string(aty) + "`",
            "Int",
            ty_to_string(aty),
            "pass an `Int` shift count",
          )
      }
    }
    return Some(recv_ty)
  }
  if method_name == "lnot" {
    if args.length() != 0 {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "method `lnot` expects 0 argument(s), found " + args.length().to_string(),
        "0 args",
        args.length().to_string() + " args",
        "remove extra arguments",
      )
    }
    return Some(recv_ty)
  }
  if method_name == "leading_zeros" ||
    method_name == "trailing_zeros" ||
    method_name == "count_ones" {
    if args.length() != 0 {
      tc_err(
        tc,
        sp,
        "E_TYPE_MISMATCH",
        "method `" +
        method_name +
        "` expects 0 argument(s), found " +
        args.length().to_string(),
        "0 args",
        args.length().to_string() + " args",
        "remove extra arguments",
      )
    }
    return Some(TInt)
  }
  None
}

///|
fn check_method_call(
  tc : TypeChecker,
  env : Env,
  recv_ty : Ty,
  method_name : String,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> Ty {
  // Builtin methods on standard types
  match recv_ty {
    TError => {
      let mut i = 0
      while i < args.length() {
        let _ = check_expr(tc, env, args[i], None)
        i = i + 1
      }
      return TError
    }
    TInt => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_uint" || method_name == "reinterpret_as_uint" {
        return TUInt
      }
      if method_name == "to_double" {
        return TDouble
      }
      if method_name == "to_float" {
        return TFloat
      }
      if method_name == "abs" {
        return TInt
      }
      if method_name == "unsafe_to_char" {
        return TChar
      }
      if method_name == "to_byte" {
        return TByte
      }
      if method_name == "to_int8" {
        return TInt8
      }
      match check_int_bitop_method(tc, env, TInt, method_name, args, sp) {
        Some(rt) => return rt
        None => ()
      }
    }
    TInt64 => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_uint64" || method_name == "reinterpret_as_uint64" {
        return TUInt64
      }
      if method_name == "to_double" {
        return TDouble
      }
      if method_name == "abs" {
        return TInt64
      }
      if method_name == "to_int8" {
        return TInt8
      }
      match check_int_bitop_method(tc, env, TInt64, method_name, args, sp) {
        Some(rt) => return rt
        None => ()
      }
    }
    TUInt => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int" || method_name == "reinterpret_as_int" {
        return TInt
      }
      if method_name == "to_uint" {
        return TUInt
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_uint64" {
        return TUInt64
      }
      if method_name == "to_double" {
        return TDouble
      }
      if method_name == "to_float" || method_name == "reinterpret_as_float" {
        return TFloat
      }
      if method_name == "to_int8" {
        return TInt8
      }
      match check_int_bitop_method(tc, env, TUInt, method_name, args, sp) {
        Some(rt) => return rt
        None => ()
      }
    }
    TUInt64 => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_uint" {
        return TUInt
      }
      if method_name == "to_int64" || method_name == "reinterpret_as_int64" {
        return TInt64
      }
      if method_name == "to_uint64" {
        return TUInt64
      }
      if method_name == "to_double" || method_name == "reinterpret_as_double" {
        return TDouble
      }
      if method_name == "to_int8" {
        return TInt8
      }
      match check_int_bitop_method(tc, env, TUInt64, method_name, args, sp) {
        Some(rt) => return rt
        None => ()
      }
    }
    TDouble => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_float" {
        return TFloat
      }
      if method_name == "to_int8" {
        return TInt8
      }
      if method_name == "to_bits" || method_name == "reinterpret_as_int64" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Double::" + method_name + "` expects 0 arguments",
            "0 arguments",
            args.length().to_string() + " arguments",
            "call `." + method_name + "()` with no arguments",
          )
        }
        return TInt64
      }
      if method_name == "reinterpret_as_uint64" {
        return TUInt64
      }
      if method_name == "is_nan" || method_name == "is_inf" || method_name == "is_finite" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Double::" + method_name + "` expects 0 arguments",
            "0 arguments",
            args.length().to_string() + " arguments",
            "call `." + method_name + "()` with no arguments",
          )
        }
        return TBool
      }
      if method_name == "compare" {
        if args.length() != 1 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Double::compare` expects 1 argument",
            "1 argument",
            args.length().to_string() + " arguments",
            "pass 1 `Double` argument",
          )
        } else {
          let aty = check_expr(tc, env, args[0], Some(TDouble))
          if !ty_compat(TDouble, aty) {
            tc_err(
              tc,
              expr_span(args[0]),
              "E_TYPE_MISMATCH",
              "`Double::compare` expects `Double`",
              "Double",
              ty_to_string(aty),
              "pass a `Double` value",
            )
          }
        }
        return TInt
      }
      if method_name == "abs" ||
        method_name == "floor" ||
        method_name == "ceil" ||
        method_name == "round" ||
        method_name == "trunc" ||
        method_name == "sqrt" ||
        method_name == "cbrt" ||
        method_name == "exp" ||
        method_name == "ln" ||
        method_name == "sin" ||
        method_name == "cos" ||
        method_name == "tan" ||
        method_name == "asin" ||
        method_name == "acos" ||
        method_name == "atan" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Double::" + method_name + "` expects 0 arguments",
            "0 arguments",
            args.length().to_string() + " arguments",
            "call `." + method_name + "()` with no arguments",
          )
          let mut ai = 0
          while ai < args.length() {
            let _ = check_expr(tc, env, args[ai], None)
            ai = ai + 1
          }
        }
        return TDouble
      }
      if method_name == "pow" || method_name == "atan2" {
        if args.length() != 1 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Double::" + method_name + "` expects 1 argument",
            "1 argument",
            args.length().to_string() + " arguments",
            "pass 1 `Double` argument",
          )
        } else {
          let aty = check_expr(tc, env, args[0], Some(TDouble))
          if !ty_compat(TDouble, aty) {
            tc_err(
              tc,
              expr_span(args[0]),
              "E_TYPE_MISMATCH",
              "`Double::" + method_name + "` expects `Double`",
              "Double",
              ty_to_string(aty),
              "pass a `Double` value",
            )
          }
        }
        return TDouble
      }
    }
    TFloat => {
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_double" {
        return TDouble
      }
      if method_name == "to_int" ||
        method_name == "to_bits" ||
        method_name == "reinterpret_as_int" {
        return TInt
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_int8" {
        return TInt8
      }
      if method_name == "reinterpret_as_uint" {
        return TUInt
      }
      if method_name == "is_nan" || method_name == "is_inf" || method_name == "is_finite" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Float::" + method_name + "` expects 0 arguments",
            "0 arguments",
            args.length().to_string() + " arguments",
            "call `." + method_name + "()` with no arguments",
          )
        }
        return TBool
      }
      if method_name == "abs" ||
        method_name == "floor" ||
        method_name == "ceil" ||
        method_name == "round" ||
        method_name == "trunc" ||
        method_name == "sqrt" ||
        method_name == "cbrt" ||
        method_name == "exp" ||
        method_name == "ln" ||
        method_name == "sin" ||
        method_name == "cos" ||
        method_name == "tan" ||
        method_name == "asin" ||
        method_name == "acos" ||
        method_name == "atan" {
        if args.length() != 0 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Float::" + method_name + "` expects 0 arguments",
            "0 arguments",
            args.length().to_string() + " arguments",
            "call `." + method_name + "()` with no arguments",
          )
          let mut ai = 0
          while ai < args.length() {
            let _ = check_expr(tc, env, args[ai], None)
            ai = ai + 1
          }
        }
        return TFloat
      }
      if method_name == "pow" || method_name == "atan2" {
        if args.length() != 1 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Float::" + method_name + "` expects 1 argument",
            "1 argument",
            args.length().to_string() + " arguments",
            "pass 1 `Float` argument",
          )
        } else {
          let aty = check_expr(tc, env, args[0], Some(TFloat))
          if !ty_compat(TFloat, aty) {
            tc_err(
              tc,
              expr_span(args[0]),
              "E_TYPE_MISMATCH",
              "`Float::" + method_name + "` expects `Float`",
              "Float",
              ty_to_string(aty),
              "pass a `Float` value",
            )
          }
        }
        return TFloat
      }
    }
    TBool =>
      if method_name == "to_string" {
        return TString
      }
    TChar => {
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_string" {
        return TString
      }
    }
    TByte => {
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_int8" {
        return TInt8
      }
    }
    TInt8 => {
      if method_name == "to_int" {
        return TInt
      }
      if method_name == "to_int64" {
        return TInt64
      }
      if method_name == "to_uint" {
        return TUInt
      }
      if method_name == "to_uint64" {
        return TUInt64
      }
      if method_name == "to_byte" {
        return TByte
      }
      if method_name == "to_float" {
        return TFloat
      }
      if method_name == "to_double" {
        return TDouble
      }
      if method_name == "to_string" {
        return TString
      }
      if method_name == "to_int8" || method_name == "abs" {
        return TInt8
      }
      if method_name == "min" || method_name == "max" {
        if args.length() != 1 {
          tc_err(
            tc,
            sp,
            "E_ARITY_MISMATCH",
            "`Int8::" + method_name + "` expects 1 argument",
            "1 argument",
            args.length().to_string() + " arguments",
            "pass 1 `Int8` argument",
          )
        } else {
          let aty = check_expr(tc, env, args[0], Some(TInt8))
          if !ty_compat(TInt8, aty) {
            tc_err(
              tc,
              expr_span(args[0]),
              "E_TYPE_MISMATCH",
              "`Int8::" + method_name + "` expects `Int8`",
              "Int8",
              ty_to_string(aty),
              "pass an `Int8` value",
            )
