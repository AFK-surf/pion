///|
/// 1-based byte column of the first `needle` on 1-based line `line_no` of
/// `src`, or -1. Columns are UTF-8 byte columns (`SPEC.md` diagnostics), so
/// this is the reference the lexer must agree with.
fn lct_col_of(src : String, line_no : Int, needle : String) -> Int {
  let mut line = 1
  let mut i = 0
  let mut line_start = 0
  while i < src.length() && line < line_no {
    if str_code_at(src, i) == 10 {
      line = line + 1
      line_start = i + 1
    }
    i = i + 1
  }
  if line != line_no {
    return -1
  }
  let n = needle.length()
  let mut p = line_start
  while p + n <= src.length() && str_code_at(src, p) != 10 {
    let mut j = 0
    while j < n && str_code_at(src, p + j) == str_code_at(needle, j) {
      j = j + 1
    }
    if j == n {
      return p - line_start + 1
    }
    p = p + 1
  }
  -1
}

///|
/// The first token whose raw text is `raw` at or after token index `from`.
fn lct_tok(lr : LexResult, raw : String, from : Int) -> Int {
  let mut i = from
  while i < lr.tokens.length() {
    if lr.tokens[i].raw == raw {
      return i
    }
    i = i + 1
  }
  -1
}

///|
/// Asserts the token `raw` (searched from the token after `after`) sits at
/// `line` and at the byte column of `raw` on that line of `src`.
fn lct_expect_tok(
  src : String,
  lr : LexResult,
  after : String,
  raw : String,
  line : Int,
  want_col : Int,
) -> Unit {
  let a = lct_tok(lr, after, 0)
  assert_true(a >= 0, "token " + after + " present")
  let t = lct_tok(lr, raw, a + 1)
  assert_true(t >= 0, "token " + raw + " present after " + after)
  let sp = lr.tokens[t].span
  assert_true(
    sp.line == line,
    raw + " on line " + line.to_string() + ", got " + sp.line.to_string(),
  )
  assert_true(
    sp.col == want_col,
    raw + " at byte col " + want_col.to_string() + ", got " + sp.col.to_string(),
  )
}

///|
fn lct_find_diag(diags : Array[Diagnostic], code : String) -> Int {
  let mut i = 0
  while i < diags.length() {
    if diags[i].code == code {
      return i
    }
    i = i + 1
  }
  -1
}

///|
test "lexer col: CJK string advances col by UTF-8 bytes" {
  // `"中文中文"` is 12 bytes: `let` after it starts at byte col 25, not 17.
  let src = "let s = \"中文中文\"; let y : Int = true\n"
  let lr = lex("t.pion", src)
  assert_true(lr.diagnostics.length() == 0, "clean lex")
  lct_expect_tok(src, lr, ";", "let", 1, 25)
  lct_expect_tok(src, lr, ";", "y", 1, 29)
  lct_expect_tok(src, lr, ";", "true", 1, 39)
  let eof = lr.tokens[lr.tokens.length() - 1]
  assert_eq(eof.span.line, 2)
  assert_eq(eof.span.col, 1)
}

///|
test "lexer col: char, byte and interpolated literals with multi-byte scalars" {
  let src =
  "let c = '中'; let a = 1\n" +
  "let b = b'é😀'; let d = 2\n" +
  "let t = \"中\\{x}中😀\"; let y : Int = true\n"
  let lr = lex("t.pion", src)
  lct_expect_tok(src, lr, ";", "a", 1, 20)
  lct_expect_tok(src, lr, "d", "=", 2, 26)
  // Interpolation tail `}中😀"` resumes after `\{x`: both segments count bytes.
  let semi3 = {
    let mut k = 0
    let mut seen = 0
    let mut at = -1
    while k < lr.tokens.length() {
      if lr.tokens[k].raw == ";" {
        seen = seen + 1
        if seen == 3 {
          at = k
        }
      }
      k = k + 1
    }
    at
  }
  assert_true(semi3 >= 0, "third `;`")
  assert_eq(lr.tokens[semi3].span.line, 3)
  assert_eq(lr.tokens[semi3].span.col, lct_col_of(src, 3, ";"))
  assert_eq(lr.tokens[semi3 + 1].raw, "let")
  assert_eq(lr.tokens[semi3 + 1].span.col, 27)
  assert_eq(lr.tokens[semi3 + 2].raw, "y")
  assert_eq(lr.tokens[semi3 + 2].span.col, 31)
  assert_eq(lr.tokens[semi3 + 6].raw, "true")
  assert_eq(lr.tokens[semi3 + 6].span.col, 41)
}

///|
test "lexer col: type error after a CJK string reports the byte column" {
  // `let y` is reported at its `let`: byte col 27 (the scalar count gave 19).
  let src =
  "pub fn main() -> Int {\n" +
  "  let s = \"中文中文\"; let y : Int = true\n" +
  "  s.length() + y\n" +
  "}\n"
  let (ok, json, diags) = check_one(src)
  assert_true(!ok, "expected E_TYPE_MISMATCH: " + json)
  let di = lct_find_diag(diags, "E_TYPE_MISMATCH")
  assert_true(di >= 0, "E_TYPE_MISMATCH present: " + json)
  assert_true(
    diags[di].line == 2 &&
    diags[di].col == lct_col_of(src, 2, "let y") &&
    diags[di].col == 27,
    "E_TYPE_MISMATCH at `let y` 2:27 (19 before the fix): " + json,
  )
}

///|
test "lexer col: backslash before a physical LF ends the literal and keeps lines" {
  let cases = [
    "let s = \"abc\\\nlet y : Int = true\n", "let s = 'a\\\nlet y : Int = true\n",
    "let s = b'a\\\nlet y : Int = true\n", "let s = \"中\\{x}中\\\nlet y : Int = true\n",
  ]
  let mut i = 0
  while i < cases.length() {
    let src = cases[i]
    let lr = lex("t.pion", src)
    assert_true(
      lr.diagnostics.length() == 1,
      "case " + i.to_string() + ": one unterminated-literal diagnostic",
    )
    assert_true(
      lr.diagnostics[0].message.contains("unterminated"),
      "case " + i.to_string() + ": " + lr.diagnostics[0].message,
    )
    assert_eq(lr.diagnostics[0].line, 1)
    // The next line lexes normally from col 1.
    let mut k = 0
    let mut found = false
    while k < lr.tokens.length() {
      let t = lr.tokens[k]
      if t.raw == "y" {
        found = true
        assert_eq(t.span.line, 2)
        assert_eq(t.span.col, 5)
        assert_eq(lr.tokens[k - 1].raw, "let")
        assert_eq(lr.tokens[k - 1].span.col, 1)
        assert_true(lr.tokens[k - 1].newline_before, "let starts a line")
        assert_eq(lr.tokens[k + 4].raw, "true")
        assert_eq(lr.tokens[k + 4].span.line, 2)
        assert_eq(lr.tokens[k + 4].span.col, 15)
      }
      k = k + 1
    }
    assert_true(found, "case " + i.to_string() + ": `y` token after the LF")
    let eof = lr.tokens[lr.tokens.length() - 1]
    assert_eq(eof.span.line, 3)
    assert_eq(eof.span.col, 1)
    i = i + 1
  }
  // `\` as the very last byte still terminates the scan.
  let lr2 = lex("t.pion", "let s = \"a\\")
  assert_eq(lr2.diagnostics.length(), 1)
}

///|
test "lexer col: escape at end of line keeps later line numbers exact" {
  let src =
  "pub fn main() -> Int {\n" +
  "  let s = \"abc\\\n" +
  "  let y : Int = true\n" +
  "  0\n" +
  "}\n"
  let (ok, json, diags) = check_one(src)
  assert_true(!ok, json)
  let di = lct_find_diag(diags, "E_PARSE")
  assert_true(di >= 0, json)
  assert_eq(diags[di].line, 2)
  assert_eq(diags[di].col, 11)
  let mut i = 0
  while i < diags.length() {
    assert_true(diags[i].line <= 5, "diagnostic line within file: " + json)
    i = i + 1
  }
}

///|
test "lexer col: --fix edit after a CJK string lands on the target byte" {
  let src =
  "pub fn main() -> Int {\n" +
  "  let s = \"中文\"; let total = 0\n" +
  "  total = 1\n" +
  "  total + s.length()\n" +
  "}\n"
  expect_edit_fixes(src, "E_TYPE_MISMATCH", "  let s = \"中文\"; let mut total = 0\n")
  let (_, _, diags) = check_one(src)
  let edits = all_edits(diags)
  assert_eq(edits.length(), 1)
  assert_eq(edits[0].line, 2)
  assert_eq(edits[0].col, lct_col_of(src, 2, "total"))
  assert_eq(edits[0].col, 25)
}

///|
test "lexer col: --fix edit after an interpolated CJK string lands on the target byte" {
  let src =
  "pub fn main() -> Int {\n" +
  "  let s = \"中\"\n" +
  "  let u = \"中\\{s}文😀\"; let total = 0\n" +
  "  total = 1\n" +
  "  total + u.length()\n" +
  "}\n"
  expect_edit_fixes(
    src, "E_TYPE_MISMATCH", "  let u = \"中\\{s}文😀\"; let mut total = 0\n",
  )
  let (_, _, diags) = check_one(src)
  let edits = all_edits(diags)
  assert_eq(edits.length(), 1)
  assert_eq(edits[0].line, 3)
  assert_eq(edits[0].col, lct_col_of(src, 3, "total"))
  assert_eq(edits[0].col, 33)
}

///|
test "lexer col: backslash before a multi-byte scalar keeps the scalar whole" {
  let src =
  "let s = \"\\中x\"; let a = 1\n" +
  "let c = '\\中'; let b = b'\\é'; let d = 2\n" +
  "let t = \"a\\{x}\\😀\"; let e = 3\n"
  let lr = lex("t.pion", src)
  assert_true(lr.diagnostics.length() == 0, "clean lex")
  let mut strs = 0
  let mut k = 0
  while k < lr.tokens.length() {
    match lr.tokens[k].kind {
      StringLit(s) => {
        strs = strs + 1
        assert_true(s == "中x", "`\\中x` decodes to `中x`, got `" + s + "`")
      }
      CharLit(s) => assert_true(s == "\\中", "char keeps `\\中`, got `" + s + "`")
      ByteLit(s) => assert_true(s == "\\é", "byte keeps `\\é`, got `" + s + "`")
      InterpEnd(s) => assert_true(s == "😀", "interp tail decodes to `😀`, got `" + s + "`")
      _ => ()
    }
    k = k + 1
  }
  assert_eq(strs, 1)
  // `"\中x"` is 7 bytes (cols 9..15): `;` at 16, `a` at 22.
  lct_expect_tok(src, lr, "\"\\中x\"", "a", 1, 22)
  // `'\中'` cols 9..14, `b'\é'` cols 25..30: `d` at 37.
  lct_expect_tok(src, lr, "b'\\é'", "d", 2, 37)
  // `}\😀"` resumes at col 14 and spans 7 bytes: `e` at 27.
  lct_expect_tok(src, lr, "x", "e", 3, 27)
}

///|
test "lexer col: unterminated interpolation tail does not swallow the next `}`" {
  let src =
  "pub fn main() -> Int {\n" +
  "  let x = 1\n" +
  "  let s = \"a\\{x}b\\\n" +
  "  0\n" +
  "}\n"
  let lr = lex("t.pion", src)
  assert_eq(lr.diagnostics.length(), 1)
  assert_eq(lr.diagnostics[0].line, 3)
  let mut lbraces = 0
  let mut rbraces = 0
  let mut last_rbrace = -1
  let mut k = 0
  while k < lr.tokens.length() {
    match lr.tokens[k].kind {
      LBrace => {
        lbraces = lbraces + 1
      }
      RBrace => {
        rbraces = rbraces + 1
        last_rbrace = k
      }
      InterpMid(_) => assert_true(false, "no InterpMid after an unterminated tail")
      InterpEnd(_) => assert_true(false, "no InterpEnd after an unterminated tail")
      _ => ()
    }
    k = k + 1
  }
  assert_eq(lbraces, 1)
  assert_eq(rbraces, 1)
  assert_eq(lr.tokens[last_rbrace].span.line, 5)
  assert_eq(lr.tokens[last_rbrace].span.col, 1)
  assert_true(lr.tokens[last_rbrace].newline_before, "`}` starts line 5")
  assert_eq(lr.tokens[last_rbrace - 1].raw, "0")
  assert_eq(lr.tokens[last_rbrace - 1].span.line, 4)
  assert_eq(lr.tokens[last_rbrace - 1].span.col, 3)
}

///|
test "lexer col: backslash before a multi-byte scalar evaluates to that scalar" {
  // The literal contents the lexer hands on (`\` kept) decode to the scalar.
  assert_eq(qbe_parse_char_lit("\\中"), 20013)
  assert_eq(qbe_parse_char_lit("\\é"), 233)
  assert_eq(qbe_parse_char_lit("\\😀"), 0x1F600)
  assert_eq(qbe_parse_char_lit("\\q"), 113)
  // And compiled literals carry the same value at run time.
  assert_eq('\中'.to_int(), 20013)
  assert_eq(b'\é'.to_int(), 233)
}
