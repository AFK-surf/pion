///| Soundness and precision regression tests for `#verify` (`verify.pion`).

///|
fn vt_json(src : String) -> String {
  let cr = check_source_files("vt", ["vt.pion"], [src])
  check_result_to_json(cr.diagnostics)
}

///|
fn vt_count(haystack : String, needle : String) -> Int {
  let mut c = 0
  let mut i = 0
  let nlen = needle.length()
  while i + nlen <= haystack.length() {
    if slice_str(haystack, i, i + nlen) == needle {
      c = c + 1
      i = i + nlen
    } else {
      i = i + 1
    }
  }
  c
}

///|
fn vt_assert_code(j : String, code : String, min_count : Int, label : String) -> Unit {
  debug_assert(vt_count(j, "E_TYPE_MISMATCH") == 0, label + " unexpected E_TYPE_MISMATCH: " + j)
  debug_assert(vt_count(j, code) >= min_count, label + " expected " + code + ": " + j)
}

///|
test "verify: shallow-copy / aliasing builtins require Copy element/value types" {
  let bad_arr_make =
    #|#verify
    #|fn f() -> Int {
    #|  let a : Array[Array[Int]] = Array::make(2, [1])
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_arr_make), "E_VERIFY_UNSUPPORTED", 1, "Array::make(Unique)")

  let bad_fix_make =
    #|#verify
    #|fn f() -> Int {
    #|  let a : FixedArray[Array[Int]] = FixedArray::make(2, [1])
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_fix_make), "E_VERIFY_UNSUPPORTED", 1, "FixedArray::make(Unique)")

  let bad_fix_fill =
    #|#verify
    #|fn f() -> Int {
    #|  let a : FixedArray[Array[Int]] = FixedArray::from_array([[1], [2]])
    #|  a.fill([3])
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_fix_fill), "E_VERIFY_UNSUPPORTED", 1, "FixedArray::fill(Unique)")

  let bad_fix_blit =
    #|#verify
    #|fn f(src : FixedArray[Array[Int]]) -> Int {
    #|  let dst : FixedArray[Array[Int]] = FixedArray::from_array([[0]])
    #|  src.blit_to(dst, len=1)
    #|  dst[0].push(5)
    #|  dst.length()
    #|}
  vt_assert_code(vt_json(bad_fix_blit), "E_VERIFY_UNSUPPORTED", 1, "FixedArray::blit_to(Unique)")

  let bad_arr_copy =
    #|#verify
    #|fn f(a : Array[Array[Int]]) -> Int {
    #|  let b = a.copy()
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_arr_copy), "E_VERIFY_UNSUPPORTED", 1, "Array::copy(Unique)")

  let bad_fix_copy =
    #|#verify
    #|fn f(a : FixedArray[Array[Int]]) -> Int {
    #|  let b = a.copy()
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_fix_copy), "E_VERIFY_UNSUPPORTED", 1, "FixedArray::copy(Unique)")

  let bad_map_copy =
    #|#verify
    #|fn f(m : Map[String, Array[Int]]) -> Int {
    #|  let m2 = m.copy()
    #|  m2.length()
    #|}
  vt_assert_code(vt_json(bad_map_copy), "E_VERIFY_UNSUPPORTED", 1, "Map::copy(Unique)")

  let bad_map_get =
    #|#verify
    #|fn f(m : Map[String, Array[Int]]) -> Int {
    #|  match m.get("a") {
    #|    Some(a) => a.length()
    #|    None => 0
    #|  }
    #|}
  vt_assert_code(vt_json(bad_map_get), "E_VERIFY_UNSUPPORTED", 1, "Map::get(Unique)")

  // Copy element/value types remain accepted.
  let ok =
    #|#verify
    #|fn g(m : Map[String, Int]) -> Int {
    #|  let a = Array::make(3, 1)
    #|  let b = a.copy()
    #|  let f = FixedArray::make(2, 7)
    #|  f.fill(9)
    #|  let f2 = f.copy()
    #|  let f3 = FixedArray::make(2, 0)
    #|  f.blit_to(f3, len=2)
    #|  let m2 = m.copy()
    #|  let v = match m2.get("k") { Some(x) => x; None => 0 }
    #|  b.length() + f2.length() + f3.length() + v
    #|}
  let jok = vt_json(ok)
  debug_assert(jok == "{\"ok\":true,\"diagnostics\":[]}", "Copy builtins ok: " + jok)

  // Read-only Bytes parameter must reject copy_from_string and blit_to destination mutation.
  let bad_bytes_cstr =
    #|#verify
    #|fn f(b : Bytes, s : String) -> Unit {
    #|  b.copy_from_string(0, s, 0, 1)
    #|}
  vt_assert_code(vt_json(bad_bytes_cstr), "E_VERIFY_BORROW_ESCAPE", 1, "Bytes::copy_from_string(borrowed)")

  let bad_bytes_blit =
    #|#verify
    #|fn f(src : Bytes, dst : Bytes) -> Unit {
    #|  src.blit_to(dst, 0, 0, 1)
    #|}
  vt_assert_code(vt_json(bad_bytes_blit), "E_VERIFY_BORROW_ESCAPE", 1, "Bytes::blit_to(borrowed dst)")

  let bad_view_blit =
    #|#verify
    #|fn f(src : Bytes, dst : Bytes) -> Unit {
    #|  let v = src.as_view()
    #|  v.blit_to(dst, 0, 0, 1)
    #|}
  vt_assert_code(vt_json(bad_view_blit), "E_VERIFY_BORROW_ESCAPE", 1, "BytesView::blit_to(borrowed dst)")
}

///|
test "verify: loop continue / break / C-for step / 0-iter / implicit var" {
  // Move before continue -> next iteration reads moved binding.
  let bad_cont =
    #|#verify
    #|fn f() -> Int {
    #|  let mut a = [1, 2]
    #|  let mut b = [3]
    #|  for i in 0..3 {
    #|    if i == 1 {
    #|      b = a
    #|      continue
    #|    }
    #|    a.push(i)
    #|  }
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_cont), "E_VERIFY_MOVE", 1, "move before continue")

  // C-for: continue jumps to step expression, which reads moved `x`.
  let bad_cfor_step =
    #|#verify
    #|fn p1(c : Bool) -> Int {
    #|  let mut x : Array[Int] = [1]
    #|  let mut sink : Array[Int] = []
    #|  let mut n = 0
    #|  for i = 0; i < 3; i = i + x.length() {
    #|    x = [2]
    #|    if c {
    #|      sink = x
    #|      continue
    #|    }
    #|    n = n + 1
    #|  }
    #|  n + sink.length()
    #|}
  vt_assert_code(vt_json(bad_cfor_step), "E_VERIFY_MOVE", 1, "C-for continue -> step")

  // Move before break -> post-loop reads moved binding.
  let bad_break =
    #|#verify
    #|fn g() -> Int {
    #|  let a = [1, 2]
    #|  let mut b = [3]
    #|  for i in 0..3 {
    #|    if i == 1 {
    #|      b = a
    #|      break
    #|    }
    #|  }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_break), "E_VERIFY_MOVE", 1, "move before break")

  // Nested loop break propagates to outer loop.
  let bad_nested_break =
    #|#verify
    #|fn p8(c : Bool) -> Int {
    #|  let mut x : Array[Int] = [1]
    #|  let mut sink : Array[Int] = []
    #|  for i in 0..3 {
    #|    for j in 0..3 {
    #|      if c {
    #|        sink = x
    #|        break
    #|      }
    #|    }
    #|    x.push(i)
    #|  }
    #|  sink.length()
    #|}
  vt_assert_code(vt_json(bad_nested_break), "E_VERIFY_MOVE", 1, "nested break")

  // Zero-iteration loop cannot revive a binding moved before the loop.
  let bad_zero_iter =
    #|#verify
    #|fn z(n : Int) -> Int {
    #|  let mut a = [1]
    #|  let b = a
    #|  for i in 0..n {
    #|    a = [2]
    #|  }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_zero_iter), "E_VERIFY_MOVE", 1, "zero-iter loop")

  // Implicit C-for loop variable gets a binding ID and catches double-move.
  let bad_cfor_implicit =
    #|#verify
    #|fn imp(k : Bool) -> Int {
    #|  let mut s = 0
    #|  for a = [1]; k; a = [2] {
    #|    let x = a
    #|    let y = a
    #|    s = x.length() + y.length()
    #|  }
    #|  s
    #|}
  vt_assert_code(vt_json(bad_cfor_implicit), "E_VERIFY_MOVE", 1, "implicit C-for var")

  // Positive: revive before continue in while loop.
  let ok_while =
    #|#verify
    #|fn p7(c : Bool) -> Int {
    #|  let mut x : Array[Int] = [1]
    #|  let mut sink : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 3 {
    #|    i = i + 1
    #|    if c {
    #|      sink = x
    #|      x = [3]
    #|      continue
    #|    }
    #|    x.push(1)
    #|  }
    #|  x.length() + sink.length()
    #|}
  let j_ok1 = vt_json(ok_while)
  debug_assert(j_ok1 == "{\"ok\":true,\"diagnostics\":[]}", "while revive before continue ok: " + j_ok1)

  // Positive: unconditional return in loop does not poison next iteration or post-loop.
  let ok_uncond_ret =
    #|#verify
    #|fn h(n : Int) -> Array[Int] {
    #|  let a = [1, 2]
    #|  for i in 0..n {
    #|    return a
    #|  }
    #|  a
    #|}
  let j_ok2 = vt_json(ok_uncond_ret)
  debug_assert(j_ok2 == "{\"ok\":true,\"diagnostics\":[]}", "unconditional return in loop ok: " + j_ok2)

  // Positive: unconditional break in loop does not run pass 1.
  let ok_uncond_break =
    #|#verify
    #|fn hb(n : Int) -> Int {
    #|  let a = [1, 2]
    #|  for i in 0..n {
    #|    let b = a
    #|    let _ = b.length()
    #|    break
    #|  }
    #|  0
    #|}
  let j_ok3 = vt_json(ok_uncond_break)
  debug_assert(j_ok3 == "{\"ok\":true,\"diagnostics\":[]}", "unconditional break in loop ok: " + j_ok3)
}

///|
test "verify: short-circuit && / || and match guard fallthrough dataflow" {
  let bad_and =
    #|#verify
    #|fn f(c : Bool) -> Int {
    #|  let mut a = [1]
    #|  let b = a
    #|  let _ = c && { a = [2]; true }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_and), "E_VERIFY_MOVE", 1, "short-circuit &&")

  let bad_or =
    #|#verify
    #|fn f(c : Bool) -> Int {
    #|  let mut a = [1]
    #|  let b = a
    #|  let _ = c || { a = [2]; false }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_or), "E_VERIFY_MOVE", 1, "short-circuit ||")

  let bad_guard =
    #|#verify
    #|fn f(c : Bool) -> Int {
    #|  let a = [1]
    #|  let mut b = [2]
    #|  match c {
    #|    true if { b = a; false } => 0
    #|    _ => a.length() + b.length()
    #|  }
    #|}
  vt_assert_code(vt_json(bad_guard), "E_VERIFY_MOVE", 1, "match guard fallthrough")
}

///|
test "verify: compound escape, non-place scrutinee/writes, unwrap_or, shadow pin" {
  let bad_if_scrut =
    #|#verify
    #|fn p2(p : Option[Array[Int]], q : Option[Array[Int]], c : Bool) -> Int {
    #|  match (if c { p } else { q }) {
    #|    Some(a) => {
    #|      a.push(9)
    #|      a.length()
    #|    }
    #|    None => 0
    #|  }
    #|}
  vt_assert_code(vt_json(bad_if_scrut), "E_VERIFY_BORROW_ESCAPE", 1, "match if-scrutinee")

  let bad_is_scrut =
    #|#verify
    #|fn p2b(p : Option[Array[Int]], q : Option[Array[Int]], c : Bool) -> Int {
    #|  if (if c { p } else { q }) is Some(a) {
    #|    a.push(9)
    #|    return a.length()
    #|  }
    #|  0
    #|}
  vt_assert_code(vt_json(bad_is_scrut), "E_VERIFY_BORROW_ESCAPE", 1, "if-is non-place scrutinee")

  let bad_compound_idx =
    #|#verify
    #|fn f(a : Array[Array[Int]], c : Bool) -> Array[Int] {
    #|  (if c { a } else { a })[0]
    #|}
  vt_assert_code(vt_json(bad_compound_idx), "E_VERIFY_BORROW_ESCAPE", 1, "compound EIndex escape")

  let bad_unwrap_borrow =
    #|#verify
    #|fn p3(o : Option[Array[Int]]) -> Int {
    #|  let a = o.unwrap_or([])
    #|  a.push(2)
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_unwrap_borrow), "E_VERIFY_BORROW_ESCAPE", 1, "unwrap_or borrow escape")

  let bad_unwrap_move =
    #|#verify
    #|fn p3m() -> Int {
    #|  let o : Option[Array[Int]] = Some([1])
    #|  let a = o.unwrap_or([])
    #|  let _ = o.is_some()
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_unwrap_move), "E_VERIFY_MOVE", 1, "unwrap_or move")

  let bad_block_shadow =
    #|#verify
    #|fn p5(p : Option[Array[Int]]) -> Int {
    #|  let mut a : Array[Int] = []
    #|  let _ = {
    #|    guard p is Some(a) else {
    #|      return 0
    #|    }
    #|    a
    #|  }.push(7)
    #|  a.length()
    #|}
  vt_assert_code(vt_json(bad_block_shadow), "E_VERIFY_BORROW_ESCAPE", 1, "block shadow push")

  let bad_temp_push =
    #|#verify
    #|fn mk() -> Array[Int] {
    #|  [1]
    #|}
    #|#verify
    #|fn p6(arr : Array[Int]) -> Int {
    #|  mk().push(1)
    #|  arr.copy().push(2)
    #|  arr.length()
    #|}
  vt_assert_code(vt_json(bad_temp_push), "E_VERIFY_BORROW_ESCAPE", 2, "non-place temp push")

  let bad_block_idx =
    #|#verify
    #|fn f(a : Array[Int]) -> Unit {
    #|  ({ a })[0] = 99
    #|}
  vt_assert_code(vt_json(bad_block_idx), "E_VERIFY_BORROW_ESCAPE", 1, "({ a })[0] = 99")

  // Positive: pattern binding shadowing scrutinee does not self-pin (read-only view).
  let ok_shadow_pin =
    #|#verify
    #|fn f(mut a : Option[Array[Int]]) -> Int {
    #|  let mut n = 0
    #|  if a is Some(a) {
    #|    n = n + a.length()
    #|  }
    #|  match a {
    #|    Some(a) => n + a.length()
    #|    None => n
    #|  }
    #|}
  let j_sp = vt_json(ok_shadow_pin)
  debug_assert(j_sp == "{\"ok\":true,\"diagnostics\":[]}", "pattern shadow pin ok: " + j_sp)

  // Negative: pattern binding projected from `mut` param is read-only (cannot mutate).
  let bad_mut_pat_write =
    #|#verify
    #|fn g(mut a : Option[Array[Int]]) -> Unit {
    #|  if a is Some(x) {
    #|    x.push(2)
    #|  }
    #|}
  vt_assert_code(vt_json(bad_mut_pat_write), "E_VERIFY_BORROW_ESCAPE", 1, "mut param pattern view write")

  // Positive: inner shadowing move does not poison outer binding.
  let ok_shadow =
    #|#verify
    #|fn shadow_ok() -> Int {
    #|  let a = [1]
    #|  {
    #|    let a = [2]
    #|    let b = a
    #|    let _ = b.length()
    #|  }
    #|  a.length()
    #|}
  let j_sh = vt_json(ok_shadow)
  debug_assert(j_sh == "{\"ok\":true,\"diagnostics\":[]}", "shadowing move ok: " + j_sh)
}

///|
test "verify: loop condition moves, non-place for-in, && true/false split, unreachable continue" {
  // Opus q1: while condition moves x, body revives, loop exits on false -> x is moved.
  let bad_q1 =
    #|#verify
    #|fn q1(c : Bool) -> Int {
    #|  let mut x : Option[Array[Int]] = None
    #|  while (if c { x } else { None }) is Some(a) {
    #|    x = Some(a)
    #|  }
    #|  match x {
    #|    Some(b) => b.length()
    #|    None => 0
    #|  }
    #|}
  vt_assert_code(vt_json(bad_q1), "E_VERIFY_MOVE", 1, "q1 while cond revive")

  // Opus q2: while condition moves x, body unconditionally returns -> false exit still moved x.
  let bad_q2 =
    #|#verify
    #|fn q2(c : Bool) -> Int {
    #|  let mut x : Option[Array[Int]] = None
    #|  while (if c { x } else { None }) is Some(a) {
    #|    return a.length()
    #|  }
    #|  match x {
    #|    Some(b) => b.length()
    #|    None => 0
    #|  }
    #|}
  vt_assert_code(vt_json(bad_q2), "E_VERIFY_MOVE", 1, "q2 while cond return")

  // C-for condition moves a -> false exit still moved a.
  let bad_q3 =
    #|#verify
    #|fn q3() -> Int {
    #|  let mut a = [1]
    #|  let mut b = [0]
    #|  for i = 0; { b = a; false }; i = i + 1 {
    #|    a = [2]
    #|  }
    #|  a.push(3)
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_q3), "E_VERIFY_MOVE", 1, "q3 cfor cond")

  // Astra #1: while { b = a; false } { a = [2] }; a.push(3)
  let bad_while_block_cond =
    #|#verify
    #|fn wbc() -> Int {
    #|  let mut a = [1]
    #|  let mut b = [0]
    #|  while { b = a; false } {
    #|    a = [2]
    #|  }
    #|  a.push(3)
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_while_block_cond), "E_VERIFY_MOVE", 1, "while block cond move")

  // Astra #2: non-place for-in consumes iter_e so aliasing writes are caught.
  let bad_forin_nonplace =
    #|#verify
    #|fn fin(c : Bool) -> Int {
    #|  let a = [1, 2]
    #|  let mut sum = 0
    #|  for x in (if c { a } else { [0, 0] }) {
    #|    a[1] = 7
    #|    sum = sum + x
    #|  }
    #|  sum
    #|}
  vt_assert_code(vt_json(bad_forin_nonplace), "E_VERIFY_MOVE", 1, "non-place for-in")

  // Positive: Opus q4 valid loop + && true-branch revive + unreachable continue after return.
  let ok_q4 =
    #|#verify
    #|fn q4(c : Bool) -> Int {
    #|  let mut x : Array[Int] = [1]
    #|  let mut n = 0
    #|  for i = 0; i < 3; i = i + x.length() {
    #|    if c {
    #|      n = n + 1
    #|      continue
    #|    }
    #|    x.push(i)
    #|  }
    #|  while true {
    #|    if n > 2 {
    #|      break
    #|    }
    #|    n = n + 1
    #|  }
    #|  x.length() + n
    #|}
    #|#verify
    #|fn and_true_revive(c : Bool) -> Int {
    #|  let mut a = [1]
    #|  let b = a
    #|  if c && { a = [2]; true } {
    #|    return a.length() + b.length()
    #|  }
    #|  b.length()
    #|}
    #|#verify
    #|fn dead_cont(n : Int) -> Array[Int] {
    #|  let a = [1]
    #|  for i in 0..n {
    #|    return a
    #|    continue
    #|  }
    #|  a
    #|}
  let jq4 = vt_json(ok_q4)
  debug_assert(jq4 == "{\"ok\":true,\"diagnostics\":[]}", "q4 + && true-revive + dead continue ok: " + jq4)
}

///|
test "verify: is pattern scope isolation (standalone EIs, guard else, C-for cond) and while cond revive" {
  // Standalone `let _ = o is Some(a)` must not leak `a` into outer scope.
  let bad_standalone_is =
    #|#verify
    #|fn f(o : Option[Array[Int]]) -> Int {
    #|  let a = [1]
    #|  let b = a
    #|  let _ = o is Some(a)
    #|  a.push(2)
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_standalone_is), "E_VERIFY_MOVE", 1, "standalone EIs no leak")

  // `guard o is Some(a) else { ... }`: else branch must not see `Some(a)`.
  let bad_guard_else =
    #|#verify
    #|fn f(o : Option[Array[Int]]) -> Int {
    #|  let a = [1]
    #|  let b = a
    #|  guard o is Some(a) else {
    #|    a.push(2)
    #|    return b.length()
    #|  }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_guard_else), "E_VERIFY_MOVE", 1, "guard else no leak")

  // C-style `for` condition `is` must not leak `a` into loop body OR `&&` RHS.
  let bad_cfor_is =
    #|#verify
    #|fn f(o : Option[Array[Int]]) -> Int {
    #|  let a = [1]
    #|  let b = a
    #|  for i = 0; o is Some(a) && i < 1; i = i + 1 {
    #|    a.push(2)
    #|  }
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_cfor_is), "E_VERIFY_MOVE", 1, "C-for cond is no leak to body")

  let bad_cfor_is_rhs =
    #|#verify
    #|fn f(o : Option[Array[Int]]) -> Int {
    #|  let a = [1]
    #|  let b = a
    #|  for i = 0; o is Some(a) && { a.push(2); false }; i = i + 1 {
    #|    ()
    #|  }
    #|  b.length()
    #|}
  vt_assert_code(vt_json(bad_cfor_is_rhs), "E_VERIFY_MOVE", 1, "C-for cond is no leak to && RHS")

  // Delayed 2-iteration move in while body still caught on post-loop use.
  let bad_delayed_while =
    #|#verify
    #|fn f(c : Bool) -> Int {
    #|  let a = [1]
    #|  let mut b = [0]
    #|  let mut k = false
    #|  while c {
    #|    if k {
    #|      b = a
    #|    } else {
    #|      k = true
    #|    }
    #|  }
    #|  a.length() + b.length()
    #|}
  vt_assert_code(vt_json(bad_delayed_while), "E_VERIFY_MOVE", 1, "delayed while move")

  // Positive: guard fallthrough, `if o is Some(a) && a > 0`, and while condition revives `a`.
  let ok_guard_and_cond_revive =
    #|#verify
    #|fn g_ok(o : Option[Array[Int]]) -> Int {
    #|  let a = [1]
    #|  let b = a
    #|  guard o is Some(a) else {
    #|    return b.length()
    #|  }
    #|  a.length() + b.length()
    #|}
    #|#verify
    #|fn if_is_and_ok(o : Option[Int]) -> Int {
    #|  if o is Some(a) && a > 0 {
    #|    return a
    #|  }
    #|  0
    #|}
    #|#verify
    #|fn while_cond_revive() -> Int {
    #|  let mut a = [1]
    #|  let b = a
    #|  while { a = [2]; false } {
    #|    break
    #|  }
    #|  a.length() + b.length()
    #|}
    #|#verify
    #|fn while_cond_revive_each_iter() -> Int {
    #|  let mut a = [1]
    #|  let mut b = [0]
    #|  let mut i = 0
    #|  while { a = [2]; i < 1 } {
    #|    b = a
    #|    i = i + 1
    #|  }
    #|  a.length() + b.length()
    #|}
  let j_ok = vt_json(ok_guard_and_cond_revive)
  debug_assert(j_ok == "{\"ok\":true,\"diagnostics\":[]}", "guard + if is && + while cond revive ok: " + j_ok)
}

///|
test "verify: unreachable loop headers and steps after a diverging init or `while true`" {
  // The init of the inner `for` always leaves the outer loop: its condition,
  // which reads the moved `x`, is unreachable.
  let ok_init =
    #|#verify
    #|fn f() -> Int {
    #|  let mut x = [1, 2]
    #|  let mut n = 0
    #|  while n < 3 {
    #|    let y = x
    #|    for i = { break; 0 }; i < x.length(); i = i + 1 {
    #|      n = n + i
    #|    }
    #|    x = y
    #|    n = n + 1
    #|  }
    #|  n
    #|}
  let j_init = vt_json(ok_init)
  debug_assert(vt_count(j_init, "\"code\"") == 0, "diverging for init: " + j_init)
  // A range bound or an iterable that leaves makes the loop unreachable as
  // well (each from a reachable entry of its own): moves inside it do not
  // reach the `continue` back edge or the code after the outer loop.
  let ok_bound =
    #|#verify
    #|fn g() -> Int {
    #|  let mut x = [1, 2]
    #|  let mut n = 0
    #|  while n < 3 {
    #|    let y = x
    #|    for i in { break; 0 }..x.length() {
    #|      n = n + i
    #|    }
    #|    x = y
    #|  }
    #|  n
    #|}
  let j_bound = vt_json(ok_bound)
  debug_assert(vt_count(j_bound, "\"code\"") == 0, "diverging range bound: " + j_bound)
  let ok_iter =
    #|#verify
    #|fn g2() -> Int {
    #|  let mut x = [1, 2]
    #|  let mut n = 0
    #|  while n < 3 {
    #|    n = n + 1
    #|    for v in { continue; [n] } {
    #|      let z = x
    #|      n = n + z.length() + v
    #|    }
    #|    n = n + x.length()
    #|  }
    #|  n + x.length()
    #|}
  let j_iter = vt_json(ok_iter)
  debug_assert(vt_count(j_iter, "\"code\"") == 0, "diverging iterable: " + j_iter)
  // Unreachable loop parts still get the static `#verify` subset checks.
  let bad_unreach_body =
    #|#verify
    #|pub fn u1(n : Int) -> Int {
    #|  while n > 0 {
    #|    for i = { break; 0 }; i < n; i = i + 1 {
    #|      let same = physical_equal(i, n)
    #|    }
    #|  }
    #|  n
    #|}
  let j_ub = vt_json(bad_unreach_body)
  debug_assert(vt_count(j_ub, "E_VERIFY_UNSUPPORTED") >= 1, "unreachable loop body still checked: " + j_ub)
  debug_assert(vt_count(j_ub, "E_VERIFY_MOVE") == 0, "unreachable loop body: no move report: " + j_ub)
  let bad_unreach_step =
    #|#verify
    #|pub fn u2(n : Int) -> Int {
    #|  let mut a = [1]
    #|  for i = 0; i < n; i = i + (if physical_equal(i, n) { a.length() } else { 2 }) {
    #|    let b = a
    #|    return i + b.length()
    #|  }
    #|  n
    #|}
  let j_us = vt_json(bad_unreach_step)
  debug_assert(vt_count(j_us, "E_VERIFY_UNSUPPORTED") >= 1, "unreachable step still checked: " + j_us)
  debug_assert(vt_count(j_us, "E_VERIFY_MOVE") == 0, "unreachable step: no move report: " + j_us)
  // The right operand of `&&` after a left operand that leaves is
  // unreachable too, in value and condition position.
  let bad_unreach_and =
    #|#verify
    #|pub fn u3(n : Int) -> Int {
    #|  while n > 0 {
    #|    for i = { break; 0 }; i < n; i = i + 1 {
    #|      let same = true && physical_equal(i, n)
    #|    }
    #|  }
    #|  n
    #|}
  let j_ua = vt_json(bad_unreach_and)
  debug_assert(vt_count(j_ua, "E_VERIFY_UNSUPPORTED") >= 1, "unreachable && value still checked: " + j_ua)
  debug_assert(vt_count(j_ua, "E_VERIFY_MOVE") == 0, "unreachable && value: no move report: " + j_ua)
  let bad_unreach_and_cond =
    #|#verify
    #|pub fn u4(n : Int) -> Int {
    #|  while n > 0 {
    #|    for i = { break; 0 }; i < n; i = i + 1 {
    #|      if true && physical_equal(i, n) {
    #|        return n
    #|      }
    #|    }
    #|  }
    #|  n
    #|}
  let j_uc = vt_json(bad_unreach_and_cond)
  debug_assert(vt_count(j_uc, "E_VERIFY_UNSUPPORTED") >= 1, "unreachable && condition still checked: " + j_uc)
  debug_assert(vt_count(j_uc, "E_VERIFY_MOVE") == 0, "unreachable && condition: no move report: " + j_uc)
  // `while true { return ... }` does not fall through: the step reading the
  // moved `x` and the next iteration are unreachable.
  let ok_while_true =
    #|#verify
    #|fn h(b : Array[Int]) -> Int {
    #|  let mut x = [1]
    #|  for i = 0; i < 3; i = i + x.length() {
    #|    let z = x
    #|    while true {
    #|      return z.length() + b.length()
    #|    }
    #|  }
    #|  0
    #|}
  let j_wt = vt_json(ok_while_true)
  debug_assert(vt_count(j_wt, "\"code\"") == 0, "while true without exit: " + j_wt)
  // Control: a `while` that can fall through still reaches the step.
  let bad_while =
    #|#verify
    #|fn k(b : Array[Int], c : Bool) -> Int {
    #|  let mut x = [1]
    #|  for i = 0; i < 3; i = i + x.length() {
    #|    let z = x
    #|    while c {
    #|      return z.length() + b.length()
    #|    }
    #|  }
    #|  0
    #|}
  vt_assert_code(vt_json(bad_while), "E_VERIFY_MOVE", 1, "fall-through while reaches the step")
  // Control: `while true` with a reachable `break` falls through too.
  let bad_break =
    #|#verify
    #|fn m(b : Array[Int], c : Bool) -> Int {
    #|  let mut x = [1]
    #|  for i = 0; i < 3; i = i + x.length() {
    #|    let z = x
    #|    while true {
    #|      if c { break }
    #|      return z.length() + b.length()
    #|    }
    #|  }
    #|  0
    #|}
  vt_assert_code(vt_json(bad_break), "E_VERIFY_MOVE", 1, "while true with break reaches the step")
}

///|
test "verify: C-style for init shadows outer loop index and non-Copy array cleanly" {
  let ok_nested =
    #|#verify
    #|fn nested_and_shadow(n : Int) -> Int {
    #|  let mut sum = 0
    #|  for i = 0; i < n; i = i + 1 {
    #|    for i = 0; i < 2; i = i + 1 {
    #|      sum = sum + i
    #|    }
    #|    sum = sum + i
    #|  }
    #|  let a = [10, 20]
    #|  for a = [1]; a.length() < 3; a.push(2) {
    #|    sum = sum + a.length()
    #|  }
    #|  sum + a.length() + a[0]
    #|}
  let j_ok = vt_json(ok_nested)
  debug_assert(vt_count(j_ok, "\"code\"") == 0, "nested for init shadow should verify cleanly: " + j_ok)

  // Moving the shadowed inner `a` must not invalidate the outer `a`.
  let ok_inner_move =
    #|#verify
    #|fn consume(xs : Array[Int]) -> Int {
    #|  xs.length()
    #|}
    #|#verify
    #|fn shadow_move() -> Int {
    #|  let a = [10, 20]
    #|  let mut acc = 0
    #|  for a = [1]; acc < 1; acc = acc + 1 {
    #|    acc = acc + consume(a)
    #|    break
    #|  }
    #|  acc + a.length()
    #|}
  let j_mv = vt_json(ok_inner_move)
  debug_assert(vt_count(j_mv, "\"code\"") == 0, "inner shadowed move should not invalidate outer a: " + j_mv)
}
