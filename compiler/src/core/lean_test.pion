///| Unit tests of the Pion-LLBC builder and the Lean 4 emitter (`llbc.pion`,
///| `lean.pion`): extraction of checked sources, asserting on the generated
///| `Types.lean` / `Funs.lean` / `FunsExternal_Template.lean` text. The Lean
///| side (`lake build`, proofs, `#eval`) is `scripts/test-lean.sh`.

///|
fn lt_check(pkg : String, src : String, imported : Array[ImportedPkg]) -> CheckedPackage {
  let cr = check_source_files_with_imports(pkg, [pkg + ".pion"], [src], imported, imported.length() > 0)
  debug_assert(cr.diagnostics.length() == 0, "lean_test source must check: " + check_result_to_json(cr.diagnostics))
  cr
}

///|
/// Extracts one package; returns its files (path -> content).
fn lt_extract(src : String) -> Map[String, String] {
  let cr = lt_check("lt", src, [])
  let diags : Array[Diagnostic] = []
  let outs = lean_extract([llbc_input_new("lt", cr.pkg, cr.tc, true)], diags)
  debug_assert(diags.length() == 0, "extraction diagnostics: " + check_result_to_json(diags))
  lt_files(outs)
}

///|
fn lt_files(outs : Array[LeanPkgOut]) -> Map[String, String] {
  let m : Map[String, String] = Map([])
  let mut i = 0
  while i < outs.length() {
    let mut j = 0
    while j < outs[i].files.length() {
      m.set(outs[i].files[j].path, outs[i].files[j].content)
      j = j + 1
    }
    i = i + 1
  }
  m
}

///|
fn lt_get(m : Map[String, String], path : String) -> String {
  match m.get(path) {
    Some(s) => s
    None => {
      abort("missing generated file " + path)
      ""
    }
  }
}

///|
fn lt_has(text : String, needle : String) -> Unit {
  match t_str_find(text, needle) {
    Some(_) => ()
    None => abort("expected `" + needle + "` in generated Lean:\n" + text)
  }
}

///|
fn lt_lacks(text : String, needle : String) -> Unit {
  match t_str_find(text, needle) {
    Some(_) => abort("unexpected `" + needle + "` in generated Lean:\n" + text)
    None => ()
  }
}

///|
test "lean: pure function, header, scalar types and checked arithmetic" {
  let src =
    #|#verify
    #|pub fn f(a : Int, b : Int64, c : UInt, d : Byte, e : Bool) -> Int {
    #|  let x = a * 2 + 1
    #|  let y = x / a
    #|  y % 3 - (x << 2) + (-x)
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "-- THIS FILE WAS AUTOMATICALLY GENERATED BY pionc extract-lean")
  lt_has(funs, "import Lt.Types")
  lt_has(funs, "import Lt.FunsExternal")
  lt_has(funs, "open Aeneas Aeneas.Std Result ControlFlow Error Pion")
  lt_has(funs, "namespace lt")
  lt_has(funs, "def f (a : Std.I32) (b : Std.I64) (c : Std.U32) (d : Std.U8) (e : Bool) :")
  lt_has(funs, "Result Std.I32 := do")
  lt_has(funs, "let x := (Pion.I32.add (Pion.I32.mul a 2#i32) 1#i32)")
  lt_has(funs, "let y ← Pion.I32.div x a")
  // Left-to-right ANF: `y % 3` before `x << 2`.
  lt_has(funs, "← Pion.I32.rem y 3#i32")
  lt_has(funs, "← Pion.I32.shl x 2#i32")
  lt_has(funs, "(Pion.I32.neg x)")
  // No external declarations: an empty but valid FunsExternal module.
  let ext = lt_get(fs, "Lt/FunsExternal.lean")
  lt_has(ext, "namespace lt")
  lt_lacks(ext, "\naxiom ")
}

///|
test "lean: scalar / struct / array mut parameters and same-root fields" {
  let src =
    #|pub struct S {
    #|  mut x : Int
    #|  mut y : Int
    #|  mut a : Array[Int]
    #|}
    #|#verify
    #|pub fn swap(mut a : Int, mut b : Int) -> Unit {
    #|  let t = a
    #|  a = b
    #|  b = t
    #|}
    #|#verify
    #|pub fn bump(mut s : S, v : Int) -> Int {
    #|  swap(mut s.x, mut s.y)
    #|  s.a.push(v)
    #|  s.a[0] = s.a[0] + v
    #|  s.x
    #|}
    #|#verify
    #|pub fn ends(mut a : Array[Int]) -> Unit {
    #|  a.swap(0, a.length() - 1)
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "def swap (a : Std.I32) (b : Std.I32) :")
  lt_has(funs, "Result (Std.I32 × Std.I32) := do")
  lt_has(funs, "ok (a1, b1)")
  // Single `mut` + value: `R × S`; the two fields of the same root are
  // written back one after the other.
  lt_has(funs, "Result (Std.I32 × S) := do")
  lt_has(funs, "← swap s.x s.y")
  lt_has(funs, "{ s with x := ")
  lt_has(funs, "{ s1 with y := ")
  lt_has(funs, "(Pion.Array.push s2.a v)")
  lt_has(funs, "← Pion.Array.set ")
  lt_has(funs, "Result (Pion.Array Std.I32) := do")
  lt_has(funs, "← Pion.Array.swap a 0#i32")
  let types = lt_get(fs, "Lt/Types.lean")
  lt_has(types, "structure S where")
  lt_has(types, "  a : (Pion.Array Std.I32)")
}

///|
test "lean: while / for-range (..= without overflow) / for-in loops" {
  let src =
    #|#verify
    #|pub fn tri(n : Int) -> Int {
    #|  let mut s = 0
    #|  for i in 0..=n {
    #|    s = s + i
    #|  }
    #|  let mut k = 0
    #|  while k < 3 {
    #|    k = k + 1
    #|  }
    #|  s + k
    #|}
    #|#verify
    #|pub fn sum(xs : Array[Int]) -> Int {
    #|  let mut t = 0
    #|  for i, x in xs {
    #|    t = t + x * i
    #|  }
    #|  for j in 0..<2 {
    #|    t = t + j
    #|  }
    #|  t
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "def tri_loop0.body")
  lt_has(funs, "Result (ControlFlow (Bool × Std.I32 × Std.I32) (Bool × Std.I32 × Std.I32)) := do")
  lt_has(funs, "let __done := (decide (i > __t))")
  lt_has(funs, "loop (fun (__done, s, i) => _root_.lt.tri_loop0.body __t __done s i) (__done, s, i)")
  lt_has(funs, "def tri_loop1.body")
  lt_has(funs, "ok (cont ")
  lt_has(funs, "ok (done ")
  lt_has(funs, "← Pion.Array.length xs")
  lt_has(funs, "← Pion.Array.get xs __i")
  lt_has(funs, "def sum_loop1.body")
}

///|
test "lean: break / continue / early return (nested) and branch joins" {
  let src =
    #|#verify
    #|pub fn find(xs : Array[Int], v : Int, mut hits : Int) -> Int {
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    let mut j = 0
    #|    while j < 2 {
    #|      if xs[i] == v {
    #|        hits = hits + 1
    #|        return i
    #|      }
    #|      j = j + 1
    #|    }
    #|    if xs[i] < 0 {
    #|      break
    #|    }
    #|    i = i + 1
    #|    if i > 100 {
    #|      continue
    #|    }
    #|  }
    #|  let mut r = -1
    #|  if v > 0 {
    #|    r = 1
    #|  } else {
    #|    r = 2
    #|  }
    #|  r = r * 2
    #|  r
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  // The inner loop may return: `Sum R σ`; `return` packs the `mut` parameter.
  lt_has(funs, "(Sum (Std.I32 × Std.I32) ")
  lt_has(funs, "ok (done (.inl (i, hits1)))")
  lt_has(funs, "| .inl __r => ok (done (.inl __r))")
  lt_has(funs, "| .inl __r => ok __r")
  // A branch updating an outer variable without exits: tuple join.
  lt_has(funs, "let r1 ← do")
  lt_has(funs, "(Pion.I32.mul r1 2#i32)")
}

///|
test "lean: guard / ? / literal patterns / guards / is-chains" {
  let src =
    #|#verify
    #|pub fn checked(a : Int, b : Int) -> Result[Int, String] {
    #|  guard b != 0 else {
    #|    return Err("zero")
    #|  }
    #|  Ok(a / b)
    #|}
    #|#verify
    #|pub fn two(a : Int, b : Int) -> Result[Int, String] {
    #|  let x = checked(a, b)?
    #|  Ok(x + 1)
    #|}
    #|#verify
    #|pub fn first(o : Option[Int]) -> Option[Int] {
    #|  let v = o?
    #|  Some(v)
    #|}
    #|#verify
    #|pub fn cls(n : Int, o : Option[Int]) -> Int {
    #|  if o is Some(v) && v > n {
    #|    return v
    #|  }
    #|  guard o is Some(w) else {
    #|    return 0
    #|  }
    #|  match n {
    #|    0 => w
    #|    k if k < 0 => -k
    #|    _ => 7
    #|  }
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "if b = 0#i32 then")
  lt_has(funs, "ok (Pion.Res.Err \"zero\" : (Pion.Res Std.I32 String))")
  lt_has(funs, "| .Err ")
  lt_has(funs, "(Pion.Res.Err ")
  lt_has(funs, "| .none =>")
  lt_has(funs, "ok (none : (Option Std.I32))")
  lt_has(funs, "| .some v =>")
  lt_has(funs, "if v > n then")
  lt_has(funs, "| .some w =>")
  lt_has(funs, "if __t")
  lt_has(funs, "(Pion.I32.neg k)")
}

///|
test "lean: generics, trait dictionaries, generic ==, derive(Eq)" {
  let src =
    #|pub trait Shape {
    #|  area(self : Self) -> Int
    #|  grow(mut self : Self, d : Int) -> Unit
    #|}
    #|pub struct Sq {
    #|  mut s : Int
    #|}
    #|#derive(Eq)
    #|pub enum C {
    #|  R
    #|  G
    #|}
    #|#verify
    #|impl Shape for Sq {
    #|  fn area(self : Sq) -> Int {
    #|    self.s * self.s
    #|  }
    #|  fn grow(mut self : Sq, d : Int) -> Unit {
    #|    self.s = self.s + d
    #|  }
    #|}
    #|#verify
    #|pub fn twice[T : Shape](mut x : T) -> Int {
    #|  x.grow(1)
    #|  x.grow(1)
    #|  x.area()
    #|}
    #|#verify
    #|pub fn use_sq(mut q : Sq) -> Int {
    #|  twice(mut q)
    #|}
    #|#verify
    #|pub fn cnt[T](xs : Array[T], v : T) -> Int {
    #|  let mut c = 0
    #|  for x in xs {
    #|    if x == v {
    #|      c = c + 1
    #|    }
    #|  }
    #|  c
    #|}
    #|#verify
    #|pub fn reds(cs : Array[C]) -> Int {
    #|  cnt(cs, R)
    #|}
  let fs = lt_extract(src)
  let types = lt_get(fs, "Lt/Types.lean")
  lt_has(types, "structure Shape (Self : Type _) where")
  lt_has(types, "  area : Self → Result Std.I32")
  lt_has(types, "  grow : Self → Std.I32 → Result Self")
  lt_has(types, "inductive C where")
  lt_has(types, "deriving BEq")
  lt_has(types, "instance : Pion.Eq C := { toBEq := inferInstance }")
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "def twice {T : Type _} (inst_T_Shape : Shape T) (x : T) :")
  lt_has(funs, "Result (Std.I32 × T) := do")
  lt_has(funs, "← inst_T_Shape.grow x 1#i32")
  lt_has(funs, "def Sq.Insts.Shape.area (self : Sq) :")
  lt_has(funs, "def Sq.Insts.Shape : Shape Sq := { area := Sq.Insts.Shape.area, grow := Sq.Insts.Shape.grow }")
  lt_has(funs, "← twice (T := Sq) Sq.Insts.Shape q")
  lt_has(funs, "def cnt {T : Type _} [Pion.Eq T] (xs : (Pion.Array T)) (v : T) :")
  lt_has(funs, "if (x == v) then")
  lt_has(funs, "← cnt (T := C) cs C.R")
}

///|
test "lean: recursive / mutually recursive types (SCC) and functions" {
  let src =
    #|pub enum E {
    #|  Lit(Int)
    #|  Add(E, E)
    #|}
    #|pub enum T {
    #|  Leaf
    #|  Node(F)
    #|}
    #|pub struct F {
    #|  ts : Array[T]
    #|  n : Int
    #|}
    #|pub struct Plain {
    #|  e : E
    #|}
    #|#verify
    #|pub fn ev(e : E) -> Int {
    #|  match e {
    #|    Lit(v) => v
    #|    Add(a, b) => ev(a) + ev(b)
    #|  }
    #|}
    #|#verify
    #|pub fn ping(n : Int) -> Int {
    #|  if n <= 0 { 0 } else { pong(n - 1) }
    #|}
    #|#verify
    #|pub fn pong(n : Int) -> Int {
    #|  if n <= 0 { 1 } else { ping(n - 1) }
    #|}
    #|#verify
    #|pub fn fsize(f : F, p : Plain) -> Int {
    #|  f.n + ev(p.e)
    #|}
  let fs = lt_extract(src)
  let types = lt_get(fs, "Lt/Types.lean")
  lt_has(types, "inductive E where")
  lt_has(types, "  | Add (a0 : E) (a1 : E)")
  lt_has(types, "mutual\n")
  lt_has(types, "inductive F where\n  | mk (ts : (Pion.Array T)) (n : Std.I32)")
  lt_has(types, "inductive T where")
  lt_has(types, "def F.n : F → Std.I32")
  lt_has(types, "def F.set_ts (s : F) (v : (Pion.Array T)) : F :=")
  lt_has(types, "structure Plain where")
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "def ev (e : E) :")
  lt_has(funs, "partial_fixpoint")
  lt_has(funs, "mutual\n\n")
  lt_has(funs, "def ping (n : Std.I32) :")
  lt_has(funs, "def pong (n : Std.I32) :")
  lt_has(funs, "(Pion.I32.add f.n ")
}

///|
test "lean: #verify_opaque / extern \"C\" callees become axioms" {
  let src =
    #|extern "C" fn c_hash(x : Int) -> Int
    #|#verify_opaque
    #|pub fn trusted(s : String, mut n : Int) -> Bool {
    #|  n = n + s.length()
    #|  true
    #|}
    #|#verify
    #|pub fn g(s : String) -> Int {
    #|  let mut n = c_hash(1)
    #|  let ok = trusted(s, mut n)
    #|  if ok { n } else { 0 }
    #|}
  let fs = lt_extract(src)
  let tmpl = lt_get(fs, "Lt/FunsExternal_Template.lean")
  lt_has(tmpl, "axiom trusted (s : String) (n : Std.I32) :\n    Result (Bool × Std.I32)")
  lt_has(tmpl, "axiom c_hash (x : Std.I32) :\n    Result Std.I32")
  let ext = lt_get(fs, "Lt/FunsExternal.lean")
  lt_has(ext, "axiom trusted")
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "let n ← c_hash 1#i32")
  lt_has(funs, "let (ok_, n1) ← trusted s n")
  lt_has(funs, "ok (if ok_ then n1 else 0#i32)")
}

///|
test "lean: Lean keywords and reserved names are escaped" {
  let src =
    #|pub struct Error {
    #|  mut fun : Int
    #|}
    #|#verify
    #|pub fn ok(end : Int, at : Int) -> Int {
    #|  let then = end + at
    #|  then
    #|}
    #|#verify
    #|pub fn loop(mut r : Error) -> Unit {
    #|  r.fun = ok(1, 2)
    #|}
  let fs = lt_extract(src)
  let types = lt_get(fs, "Lt/Types.lean")
  lt_has(types, "structure Error_ where")
  lt_has(types, "  «fun» : Std.I32")
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "def ok_ («end» : Std.I32) («at» : Std.I32) :")
  lt_has(funs, "let «then» := (Pion.I32.add «end» «at»)")
  lt_has(funs, "def loop_ (r : Error_) :")
  lt_has(funs, "{ r with «fun» := ")
}

///|
test "lean: cross-package extraction imports upstream modules" {
  let lib_src =
    #|pub struct Acc {
    #|  mut total : Int
    #|}
    #|#verify
    #|pub fn add(mut a : Acc, d : Int) -> Unit {
    #|  a.total = a.total + d
    #|}
  let lib_cr = lt_check("mylib", lib_src, [])
  let app_src =
    #|import "mylib" as m
    #|#verify
    #|pub fn run(mut a : m::Acc) -> Int {
    #|  m::add(mut a, 3)
    #|  a.total
    #|}
  let app_cr = lt_check("app", app_src, [imported_pkg_new("mylib", lib_cr.tc)])
  let diags : Array[Diagnostic] = []
  let outs = lean_extract(
    [llbc_input_new("mylib", lib_cr.pkg, lib_cr.tc, false), llbc_input_new("app", app_cr.pkg, app_cr.tc, true)],
    diags,
  )
  debug_assert(diags.length() == 0, check_result_to_json(diags))
  let fs = lt_files(outs)
  let lib_types = lt_get(fs, "Mylib/Types.lean")
  lt_has(lib_types, "namespace mylib")
  lt_has(lib_types, "structure Acc where")
  let lib_funs = lt_get(fs, "Mylib/Funs.lean")
  lt_has(lib_funs, "def add (a : Acc) (d : Std.I32) :")
  let app_funs = lt_get(fs, "App/Funs.lean")
  lt_has(app_funs, "import Mylib.Funs")
  lt_has(app_funs, "def run (a : mylib.Acc) :")
  lt_has(app_funs, "let a1 ← mylib.add a 3#i32")
  let app_types = lt_get(fs, "App/Types.lean")
  lt_has(app_types, "namespace app")
  let json = lean_extract_json("out", outs)
  lt_has(json, "{\"ok\":true,\"out\":\"out\",\"packages\":[")
  lt_has(json, "\"name\":\"app\",\"lean_mod\":\"App\"")
}

///|
test "lean: unsupported constructs are reported, not emitted" {
  let src =
    #|#verify
    #|pub fn f(x : Int) -> Int {
    #|  let g = fn(y : Int) -> Int { y + x }
    #|  g(1)
    #|}
  let cr = lt_check("lt", src, [])
  let diags : Array[Diagnostic] = []
  let _ = lean_extract([llbc_input_new("lt", cr.pkg, cr.tc, true)], diags)
  debug_assert(diags.length() > 0, "closure must be rejected")
  debug_assert(diags[0].code == "E_EXTRACT_UNSUPPORTED", "code: " + diags[0].code)
}

///|
test "lean: StringBuilder, Map and Double bit-pattern extraction" {
  let src =
    #|#verify
    #|pub fn build_str(s : String) -> String {
    #|  let mut sb = StringBuilder()
    #|  sb.write_string(s)
    #|  sb.write_byte(b'!')
    #|  sb.write_substring(s, 0, 2)
    #|  let _n = sb.length()
    #|  sb.to_string()
    #|}
    #|#verify
    #|pub fn use_map() -> Int {
    #|  let mut m : Map[String, Int] = Map::new()
    #|  m.set("k", 7)
    #|  let has = m.contains("k")
    #|  let v = match m.get("k") { Some(x) => x; None => 0 }
    #|  m.remove("k")
    #|  let n = m.length()
    #|  m.clear()
    #|  if has { v + n } else { 0 }
    #|}
    #|#verify
    #|pub fn dbl_bits(b : Int64) -> UInt64 {
    #|  let d = Double::from_bits(b)
    #|  let b2 = d.to_bits()
    #|  let u = d.reinterpret_as_uint64()
    #|  let d2 = u.reinterpret_as_double()
    #|  if b2 == b { d2.reinterpret_as_uint64() } else { 0UL }
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "(Pion.StringBuilder.new : Pion.StringBuilder)")
  lt_has(funs, "(Pion.StringBuilder.write_string ")
  lt_has(funs, "(Pion.StringBuilder.write_byte ")
  lt_has(funs, "(Pion.StringBuilder.write_substring ")
  lt_has(funs, "Pion.StringBuilder.length ")
  lt_has(funs, "(Pion.StringBuilder.to_string ")
  lt_has(funs, "(Pion.Map.new : (Pion.Map String Std.I32))")
  lt_has(funs, "(Pion.Map.set ")
  lt_has(funs, "(Pion.Map.contains ")
  lt_has(funs, "(Pion.Map.get ")
  lt_has(funs, "(Pion.Map.remove ")
  lt_has(funs, "Pion.Map.length ")
  lt_has(funs, "(Pion.Map.clear ")
  lt_has(funs, "(Pion.Double.from_bits b)")
  lt_has(funs, "(Pion.Double.to_bits d)")
  lt_has(funs, "(Pion.U64.reinterpret_as_double u)")
  lt_has(funs, "(Pion.Double.reinterpret_as_uint64 d2)")
}

///|
test "lean: ImmArray extraction" {
  let src =
    #|#verify
    #|pub fn imm_ops(xs : ImmArray[Int]) -> Int {
    #|  let empty : ImmArray[Int] = ImmArray::new()
    #|  let lit : ImmArray[Int] = [1, 2, 3]
    #|  let mk = ImmArray::make(2, 7)
    #|  let arr : Array[Int] = [4, 5]
    #|  let from_a = ImmArray::from_array(arr)
    #|  let back = from_a.to_array()
    #|  let back_imm = back.to_imm()
    #|  let cp = lit.copy()
    #|  let same = lit == cp
    #|  let mut s = 0
    #|  for v in mk {
    #|    s = s + v
    #|  }
    #|  if same && empty.is_empty() && back_imm.length() == 2 { s + xs[0] } else { 0 }
    #|}
  let fs = lt_extract(src)
  let funs = lt_get(fs, "Lt/Funs.lean")
  lt_has(funs, "(Pion.ImmArray Std.I32)")
  lt_has(funs, "(Pion.ImmArray.new : (Pion.ImmArray Std.I32))")
  lt_has(funs, "(Pion.ImmArray.ofList [1#i32, 2#i32, 3#i32] : (Pion.ImmArray Std.I32))")
  lt_has(funs, "(Pion.ImmArray.make ")
  lt_has(funs, "(Pion.ImmArray.from_array ")
  lt_has(funs, "(Pion.ImmArray.to_array ")
  lt_has(funs, "(Pion.ImmArray.copy ")
  lt_has(funs, "(Pion.ImmArray.is_empty ")
  lt_has(funs, "Pion.ImmArray.length ")
  lt_has(funs, "Pion.ImmArray.get ")
}

///|
test "lean: payload-less enum with custom impl Eq omits default BEq" {
  let src =
    #|pub enum PlainTag { A; B }
    #|pub enum CustomTag { X; Y }
    #|impl Eq for CustomTag {
    #|  fn equal(a : CustomTag, b : CustomTag) -> Bool { true }
    #|}
    #|#verify
    #|pub fn tag_code(p : PlainTag, c : CustomTag) -> Int {
    #|  let _ = p == PlainTag::A
    #|  match c {
    #|    X => 1
    #|    Y => 2
    #|  }
    #|}
  let fs = lt_extract(src)
  let types = lt_get(fs, "Lt/Types.lean")
  lt_has(types, "inductive PlainTag where")
  lt_has(types, "inductive CustomTag where")
  lt_has(types, "instance : Pion.Eq PlainTag")
  debug_assert(!types.contains("instance : Pion.Eq CustomTag"), "CustomTag must not emit default Pion.Eq:\n" + types)
}
