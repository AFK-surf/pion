///|
fn fmt_assert_eq(actual : String, expected : String, msg : String) -> Unit {
  if actual != expected {
    abort(
      "FMT ASSERTION FAILED (" +
      msg +
      "):\n--- expected ---\n" +
      expected +
      "--- actual ---\n" +
      actual +
      "--- end ---",
    )
  }
}

///|
test "fmt: basic 2-space indentation, blank lines, trailing whitespace, EOF newline" {
  let src =
    "\n\n  pub fn add(a : Int,   b : Int) -> Int {   \r\n" +
    "\t\tlet   sum = a + b   \r\n" +
    "\n\n\n" +
    "      if sum > 0 {\n" +
    "          return sum\n" +
    "      } else {\n" +
    "          return 0\n" +
    "      }\n" +
    "  }  \n\n\n"
  let expected =
    "pub fn add(a : Int, b : Int) -> Int {\n" +
    "  let sum = a + b\n" +
    "\n" +
    "  if sum > 0 {\n" +
    "    return sum\n" +
    "  } else {\n" +
    "    return 0\n" +
    "  }\n" +
    "}\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "first pass")
  let out2 = format_source(out1)
  fmt_assert_eq(out2, out1, "idempotent second pass")
}

///|
test "fmt: preserves comments, strings, char/byte literals with braces" {
  let src =
    "///| doc comment with   extra   spaces and {\n" +
    "pub fn demo() -> String {\n" +
    "    // inline comment with } and (\n" +
    "    let s = \"{   not   a   block   } // not a comment\"\n" +
    "    let c = '{'\n" +
    "    let b = b'}'\n" +
    "    let esc = \"quote \\\" { \\\" end\"\n" +
    "    s // trailing   comment   preserved\n" +
    "}\n"
  let expected =
    "///| doc comment with   extra   spaces and {\n" +
    "pub fn demo() -> String {\n" +
    "  // inline comment with } and (\n" +
    "  let s = \"{   not   a   block   } // not a comment\"\n" +
    "  let c = '{'\n" +
    "  let b = b'}'\n" +
    "  let esc = \"quote \\\" { \\\" end\"\n" +
    "  s // trailing   comment   preserved\n" +
    "}\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "comment and literal preservation")
  fmt_assert_eq(format_source(out1), out1, "idempotent")
}

///|
test "fmt: scope/spawn nested closure alignment and multiline calls" {
  let src =
    "pub fn main(world : World) -> Int {\n" +
    "scope(world, fn(s : Scope) -> Unit {\n" +
    "spawn(s, fn() -> Unit {\n" +
    "io_println(\n" +
    "world,\n" +
    "\"hi\",\n" +
    ")\n" +
    "})\n" +
    "})\n" +
    "0\n" +
    "}\n"
  let expected =
    "pub fn main(world : World) -> Int {\n" +
    "  scope(world, fn(s : Scope) -> Unit {\n" +
    "    spawn(s, fn() -> Unit {\n" +
    "      io_println(\n" +
    "        world,\n" +
    "        \"hi\",\n" +
    "      )\n" +
    "    })\n" +
    "  })\n" +
    "  0\n" +
    "}\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "scope/spawn alignment")
  fmt_assert_eq(format_source(out1), out1, "idempotent")
}

///|
test "fmt: empty and whitespace-only input" {
  fmt_assert_eq(format_source(""), "", "empty string")
  fmt_assert_eq(format_source("   \n\t\n  "), "", "whitespace only")
}

///|
test "fmt: check result JSON format" {
  fmt_assert_eq(
    fmt_check_result_to_json([]),
    "{\"ok\":true,\"unformatted\":[]}",
    "empty unformatted list",
  )
  fmt_assert_eq(
    fmt_check_result_to_json(["a.pion", "dir/b.pion"]),
    "{\"ok\":false,\"unformatted\":[\"a.pion\",\"dir/b.pion\"]}",
    "two unformatted files",
  )
}

///|
test "fmt: extern C variadic declaration round-trip is idempotent" {
  let src =
    "  extern  \"C\"  fn  sq3_config_i(op : Int,   ...,   v : Int)  ->  Int  =  \"sqlite3_config\"  \n" +
    "extern \"C\" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = \"snprintf\"\n"
  let expected =
    "extern \"C\" fn sq3_config_i(op : Int, ..., v : Int) -> Int = \"sqlite3_config\"\n" +
    "extern \"C\" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = \"snprintf\"\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "extern C varargs format")
  fmt_assert_eq(format_source(out1), out1, "extern C varargs idempotent")
}

///|
test "fmt: Pion-JSX nested tags, fragments, multiline attrs, and binary < preservation" {
  let src =
    "pub fn ui(root : View, presets : Array[Int], n : Int) -> Unit {\n" +
    "if 0 < n && n < 10 {\n" +
    "for i in 0..<n {\n" +
    "let _ = i\n" +
    "}\n" +
    "}\n" +
    "<Box\n" +
    "in={root}\n" +
    "along={.Between}\n" +
    "align={.Middle}\n" +
    ">\n" +
    "<>\n" +
    "<Text label=\"hi\" />\n" +
    "<Row><Dot /></Row>\n" +
    "</>\n" +
    "for p in presets {\n" +
    "<lg::Chip\n" +
    "label=\"\\{p}\"\n" +
    "selected=>{p == 800}\n" +
    "on_press=>{\n" +
    "set_dpi(p)\n" +
    "}\n" +
    "/>\n" +
    "}\n" +
    "</Box>\n" +
    "}\n"
  let expected =
    "pub fn ui(root : View, presets : Array[Int], n : Int) -> Unit {\n" +
    "  if 0 < n && n < 10 {\n" +
    "    for i in 0..<n {\n" +
    "      let _ = i\n" +
    "    }\n" +
    "  }\n" +
    "  <Box\n" +
    "    in={root}\n" +
    "    along={.Between}\n" +
    "    align={.Middle}\n" +
    "  >\n" +
    "    <>\n" +
    "      <Text label=\"hi\" />\n" +
    "      <Row><Dot /></Row>\n" +
    "    </>\n" +
    "    for p in presets {\n" +
    "      <lg::Chip\n" +
    "        label=\"\\{p}\"\n" +
    "        selected=>{p == 800}\n" +
    "        on_press=>{\n" +
    "          set_dpi(p)\n" +
    "        }\n" +
    "      />\n" +
    "    }\n" +
    "  </Box>\n" +
    "}\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "JSX formatting")
  fmt_assert_eq(format_source(out1), out1, "JSX formatting idempotent")

  let nested_attr_jsx =
    "pub fn list_ui(root : View, xs : Array[Int]) -> Unit {\n" +
    "<Box in={root}>\n" +
    "<For\n" +
    "items={xs}\n" +
    "render={fn(item_v, v) {\n" +
    "<lg::Chip\n" +
    "in={item_v}\n" +
    "label=\"\\{v}\"\n" +
    "/>\n" +
    "}}\n" +
    "/>\n" +
    "</Box>\n" +
    "}\n"
  let nested_expected =
    "pub fn list_ui(root : View, xs : Array[Int]) -> Unit {\n" +
    "  <Box in={root}>\n" +
    "    <For\n" +
    "      items={xs}\n" +
    "      render={fn(item_v, v) {\n" +
    "        <lg::Chip\n" +
    "          in={item_v}\n" +
    "          label=\"\\{v}\"\n" +
    "        />\n" +
    "      }}\n" +
    "    />\n" +
    "  </Box>\n" +
    "}\n"
  let n1 = format_source(nested_attr_jsx)
  fmt_assert_eq(n1, nested_expected, "nested JSX inside attr closure")
  fmt_assert_eq(format_source(n1), n1, "nested JSX inside attr closure idempotent")
}

///|
test "fmt: #into attribute and into parameters are formatted idempotently" {
  let src =
    "#into\n" +
    "pub fn Live::of_value[T](v : T) -> Live[T] {\n" +
    "Live::Is(v)\n" +
    "}\n\n" +
    "#[into]\n" +
    "pub fn IoErr::to_app(self : IoErr) -> AppErr {\n" +
    "AppErr::Io(self)\n" +
    "}\n\n" +
    "pub fn Text(into text~ : Live[String] = .Is(\"\"), into bg? : Live[Int64]) -> Unit {\n" +
    "let _ = text\n" +
    "let _ = bg\n" +
    "}\n"
  let expected =
    "#into\n" +
    "pub fn Live::of_value[T](v : T) -> Live[T] {\n" +
    "  Live::Is(v)\n" +
    "}\n\n" +
    "#[into]\n" +
    "pub fn IoErr::to_app(self : IoErr) -> AppErr {\n" +
    "  AppErr::Io(self)\n" +
    "}\n\n" +
    "pub fn Text(into text~ : Live[String] = .Is(\"\"), into bg? : Live[Int64]) -> Unit {\n" +
    "  let _ = text\n" +
    "  let _ = bg\n" +
    "}\n"
  let out1 = format_source(src)
  fmt_assert_eq(out1, expected, "#into and into param formatting")
  fmt_assert_eq(format_source(out1), out1, "#into and into param formatting idempotent")
}
