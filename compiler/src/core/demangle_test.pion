///| Unit tests for `demangle.pion` covering all QBE & Wasm symbol forms,
///  6 synthetic classes, runtime categories, and compile-time sidecar override.

///|
test "demangle: user functions, packages, methods, impls, and monomorphization" {
  let d1 = demangle_symbol("pion_fn_parse_json")
  assert_eq(d1.pretty, "parse_json")
  assert_eq(d1.category, "user")
  assert_eq(d1.kind, "fn")

  // Mach-O leading underscore + package prefix
  let d2 = demangle_symbol("_pion_pkg_core_fn_lex")
  assert_eq(d2.pretty, "core::lex")
  assert_eq(d2.pkg, "core")
  assert_eq(d2.category, "user")

  // Length-encoded package name `pkg_0L<len>_<enc>_` (e.g. "my-pkg" -> "my_dpkg" len 7)
  let d3 = demangle_symbol("pion_pkg_0L7_my_dpkg_fn_run")
  assert_eq(d3.pretty, "my-pkg::run")
  assert_eq(d3.pkg, "my-pkg")

  // Method `pion_m_<recv>__<method>` and `0P` encoded pair
  let d4 = demangle_symbol("pion_m_Parser__next_tok")
  assert_eq(d4.pretty, "Parser::next_tok")
  assert_eq(d4.kind, "method")

  let d5 = demangle_symbol("pion_pkg_json_m_0P8_My_uNode_N3_get")
  assert_eq(d5.pretty, "json::My_Node::get")
  assert_eq(d5.pkg, "json")

  // Monomorphized function
  let d6 = demangle_symbol("pion_fn_sort__mono_Array_Int")
  assert_eq(d6.pretty, "sort[Array_Int]")
  assert_eq(d6.category, "user")

  // Impl plain form & encoded `impl_0_` with `_M<len>_<enc>`
  let d7 = demangle_symbol("pion_impl_Show_Point_to_string")
  assert_eq(d7.pretty, "Show for Point::to_string")
  assert_eq(d7.kind, "impl")

  let d8 = demangle_symbol("pion_impl_0_0P4_Show_N5_Point_M10_to_ustring")
  assert_eq(d8.pretty, "Show for Point::to_string")
  assert_eq(d8.kind, "impl")
}

///|
test "demangle: 6 synthetic classes, wasm prefixes/suffixes, and runtime categories" {
  // 1. drop
  let dd = demangle_symbol("pion_drop_struct_json__Node")
  assert_eq(dd.pretty, "drop(json::Node)")
  assert_eq(dd.category, "runtime_rc")
  assert_eq(dd.kind, "drop")
  assert_eq(demangle_drop_type_name("pion_drop_struct_json__Node"), "json::Node")
  assert_eq(demangle_drop_type_name("pion_drop_enum_0U_My_uErr"), "My_Err")

  // 2. freeze
  let df = demangle_symbol("pion_freeze_st_Node")
  assert_eq(df.pretty, "freeze(Node)")
  assert_eq(df.category, "runtime_rc")
  assert_eq(df.kind, "freeze")

  // 3. eq
  let de = demangle_symbol("pion_eq_st_Point")
  assert_eq(de.pretty, "eq(Point)")
  assert_eq(de.category, "user")
  assert_eq(de.kind, "eq")

  // 4. vtable
  let dv = demangle_symbol("pion_vtable_Show__Point")
  assert_eq(dv.pretty, "vtable(Show for Point)")
  assert_eq(dv.category, "user")
  assert_eq(dv.kind, "vtable")

  // 5. closure & 6. spawn
  let dc = demangle_symbol("p_app__pion_clo_4__u2_1")
  assert_eq(dc.pretty, "app::closure#4")
  assert_eq(dc.category, "user")
  assert_eq(dc.kind, "closure")

  let ds = demangle_symbol("pion_spawn_7")
  assert_eq(ds.pretty, "spawn#7")
  assert_eq(ds.category, "user")
  assert_eq(ds.kind, "spawn")

  // Cold-block outlining
  let dol = demangle_symbol("__pion_ol_12")
  assert_eq(dol.pretty, "<outlined#12>")
  assert_eq(dol.category, "user")

  // Runtime categories
  assert_eq(classify_symbol("pion_alloc_uninit"), "runtime_mem")
  assert_eq(classify_symbol("pion_slab_alloc"), "runtime_mem")
  assert_eq(classify_symbol("pion_med_cache_free"), "runtime_mem")
  assert_eq(classify_symbol("pion_rc_dec"), "runtime_rc")
  assert_eq(classify_symbol("pion_str_concat"), "runtime_std")
  assert_eq(classify_symbol("pion_arr_grow"), "runtime_std")
  assert_eq(classify_symbol("pion_map_set"), "runtime_std")
  assert_eq(classify_symbol("malloc"), "external")
  assert_eq(classify_symbol("[external]"), "external")
}

///|
test "demangle: sidecar override takes precedence over heuristic demangling" {
  let sc = prof_parse_sidecar_syms(
    "pion_clo_3\tapp::render::(closure@line:42)\tclosure\tapp\tsrc/render.pion\t42\n",
  )
  let d = demangle_symbol_with_sidecar("_pion_clo_3", sc)
  assert_eq(d.pretty, "app::render::(closure@line:42)")
  assert_eq(d.pkg, "app")
  assert_eq(d.file, "src/render.pion")
  assert_eq(d.line, 42)
  assert_eq(d.category, "user")

  // Fallback when not in sidecar
  let d2 = demangle_symbol_with_sidecar("pion_fn_other", sc)
  assert_eq(d2.pretty, "other")
  assert_eq(d2.file, "")
  assert_eq(d2.line, 0)
}
