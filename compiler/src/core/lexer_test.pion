///|
/// The keyword chain `keyword_or_ident` replaced, kept as the reference.
fn lext_ref_keyword(word : String) -> TokenKind {
  if word == "fn" {
    KwFn
  } else if word == "pub" {
    KwPub
  } else if word == "struct" {
    KwStruct
  } else if word == "enum" {
    KwEnum
  } else if word == "let" {
    KwLet
  } else if word == "mut" {
    KwMut
  } else if word == "if" {
    KwIf
  } else if word == "else" {
    KwElse
  } else if word == "match" {
    KwMatch
  } else if word == "guard" {
    KwGuard
  } else if word == "is" {
    KwIs
  } else if word == "while" {
    KwWhile
  } else if word == "for" {
    KwFor
  } else if word == "in" {
    KwIn
  } else if word == "break" {
    KwBreak
  } else if word == "continue" {
    KwContinue
  } else if word == "return" {
    KwReturn
  } else if word == "true" {
    BoolLit(true)
  } else if word == "false" {
    BoolLit(false)
  } else if word == "as" {
    KwAs
  } else if word == "val" {
    KwVal
  } else if word == "move" {
    KwMove
  } else if word == "scope" {
    KwScope
  } else if word == "spawn" {
    KwSpawn
  } else if word == "debug_assert" {
    KwDebugAssert
  } else if word == "type" {
    KwType
  } else if word == "import" {
    KwImport
  } else if word == "extern" {
    KwExtern
  } else if word == "trait" {
    KwTrait
  } else if word == "impl" {
    KwImpl
  } else {
    Ident(word)
  }
}

///|
fn lext_kind(k : TokenKind) -> String {
  match k {
    IntLit(s) => "int:" + s
    Int64Lit(s) => "int64:" + s
    UIntLit(s) => "uint:" + s
    UInt64Lit(s) => "uint64:" + s
    DoubleLit(s) => "double:" + s
    FloatLit(s) => "float:" + s
    StringLit(s) => "string:" + s
    BoolLit(b) => if b { "bool:true" } else { "bool:false" }
    Ident(s) => "ident:" + s
    KwFn => "kw:fn"
    KwPub => "kw:pub"
    KwStruct => "kw:struct"
    KwEnum => "kw:enum"
    KwLet => "kw:let"
    KwMut => "kw:mut"
    KwIf => "kw:if"
    KwElse => "kw:else"
    KwMatch => "kw:match"
    KwGuard => "kw:guard"
    KwIs => "kw:is"
    KwWhile => "kw:while"
    KwFor => "kw:for"
    KwIn => "kw:in"
    KwBreak => "kw:break"
    KwContinue => "kw:continue"
    KwReturn => "kw:return"
    KwAs => "kw:as"
    KwVal => "kw:val"
    KwMove => "kw:move"
    KwScope => "kw:scope"
    KwSpawn => "kw:spawn"
    KwDebugAssert => "kw:debug_assert"
    KwType => "kw:type"
    KwImport => "kw:import"
    KwExtern => "kw:extern"
    KwTrait => "kw:trait"
    KwImpl => "kw:impl"
    _ => "other"
  }
}

///|
fn lext_keywords() -> Array[String] {
  [
    "fn", "pub", "struct", "enum", "let", "mut", "if", "else", "match", "guard",
    "is", "while", "for", "in", "break", "continue", "return", "true", "false",
    "as", "val", "move", "scope", "spawn", "debug_assert", "type", "import",
    "extern", "trait", "impl",
  ]
}

///|
test "lexer: length-bucketed keyword table matches the reference chain" {
  let kws = lext_keywords()
  assert_eq(kws.length(), 30)
  let words : Array[String] = []
  let mut i = 0
  while i < kws.length() {
    let w = kws[i]
    let n = w.length()
    words.push(w)
    // Same length, one letter changed; one shorter; one longer; case changed.
    words.push(slice_str(w, 0, n - 1) + "q")
    words.push(slice_str(w, 0, n - 1))
    words.push(w + "_")
    words.push("_" + w)
    words.push(w + "1")
    words.push("X" + slice_str(w, 1, n))
    i = i + 1
  }
  words.push("a")
  words.push("_")
  words.push("ab")
  words.push("xyz")
  words.push("self")
  words.push("Self")
  words.push("loop")
  words.push("const")
  words.push("public")
  words.push("debug")
  words.push("assert")
  words.push("debug_assertion")
  let mut kw_hits = 0
  i = 0
  while i < words.length() {
    let w = words[i]
    let got = lext_kind(keyword_or_ident(w))
    let want = lext_kind(lext_ref_keyword(w))
    assert_true(got == want, "keyword_or_ident(" + w + "): " + got + " != " + want)
    if !(got == "ident:" + w) {
      kw_hits = kw_hits + 1
    }
    i = i + 1
  }
  // Only the 30 keywords themselves are not identifiers.
  assert_eq(kw_hits, 30)
  // Every keyword also comes out of the full lexer with its own raw text.
  let lr = lex("kw.pion", "fn pub struct enum let mut if else match guard is while for in break continue return true false as val move scope spawn debug_assert type import extern trait impl")
  assert_true(lr.diagnostics.length() == 0, "keyword source lexes cleanly")
  i = 0
  while i < kws.length() {
    assert_true(lr.tokens[i].raw == kws[i], "raw of keyword " + kws[i])
    assert_true(
      lext_kind(lr.tokens[i].kind) == lext_kind(lext_ref_keyword(kws[i])),
      "kind of keyword " + kws[i],
    )
    i = i + 1
  }
}

///|
test "lexer: identifier and number slices after multi-byte UTF-8 text" {
  let src =
    "// 中文注释：标识符切片 ✓ 😀\n" +
    "let s = \"汉字😀é\" // ünïcødé\n" +
    "let x_1 = 0xFF_aU + 0x1fUL + 0X7L + 12_345 + 7U + 9UL + 42L\n" +
    "/// 文档 ü\n" +
    "let 𝑑 = 1.5e-3 + 2.5f + 3e+2 + 6.25 + 1e5\n" +
    "fn matcher(é : Int) -> Bool { true } // 末尾\n"
  let lr = lex("utf8.pion", src)
  let got : Array[String] = []
  let mut i = 0
  while i < lr.tokens.length() {
    let t = lr.tokens[i]
    let k = lext_kind(t.kind)
    if k != "other" {
      got.push(k + "|" + t.raw)
    }
    i = i + 1
  }
  let want = [
    "kw:let|let", "ident:s|s", "string:汉字😀é|\"汉字😀é\"", "kw:let|let", "ident:x_1|x_1",
    "uint:0xFF_aU|0xFF_aU", "uint64:0x1fUL|0x1fUL", "int64:0X7L|0X7L", "int:12_345|12_345",
    "uint:7U|7U", "uint64:9UL|9UL", "int64:42L|42L", "kw:let|let", "double:1.5e-3|1.5e-3",
    "float:2.5f|2.5f", "double:3e+2|3e+2", "double:6.25|6.25", "double:1e5|1e5", "kw:fn|fn",
    "ident:matcher|matcher", "ident:Int|Int", "ident:Bool|Bool", "bool:true|true",
  ]
  let joined_got = got.join("\n")
  let joined_want = want.join("\n")
  assert_true(joined_got == joined_want, "tokens:\n" + joined_got)
  // The non-ASCII identifier characters stay diagnostics, not slices.
  assert_true(lr.diagnostics.length() > 0, "non-ASCII identifier characters are rejected")
  // Positions after multi-byte text still count lines and columns as before.
  let mut found = false
  i = 0
  while i < lr.tokens.length() {
    if lr.tokens[i].raw == "x_1" {
      assert_eq(lr.tokens[i].span.line, 3)
      assert_eq(lr.tokens[i].span.col, 5)
      found = true
    }
    i = i + 1
  }
  assert_true(found, "x_1 token present")
}

///|
test "lexer: @pkg.member habit diagnostic slices names after UTF-8 text" {
  let src = "// 包名诊断 ✓\nlet s = \"é\" + @dep.add_1(1, 2)\n"
  let lr = lex("pkg.pion", src)
  let mut hit = -1
  let mut i = 0
  while i < lr.diagnostics.length() {
    if lr.diagnostics[i].code == "E_HABIT_MOONBIT_PKG" {
      hit = i
    }
    i = i + 1
  }
  assert_true(hit >= 0, "E_HABIT_MOONBIT_PKG reported")
  let d = lr.diagnostics[hit]
  assert_true(str_contains(d.message, "`dep::add_1`"), d.message)
  assert_eq(d.edits.length(), 1)
  assert_true(d.edits[0].replacement == "dep::add_1", d.edits[0].replacement)
  assert_eq(d.edits[0].end_line, d.edits[0].line)
  assert_eq(d.edits[0].end_col - d.edits[0].col, 10)
  let names : Array[String] = []
  i = 0
  while i < lr.tokens.length() {
    match lr.tokens[i].kind {
      Ident(s) => names.push(s)
      _ => ()
    }
    i = i + 1
  }
  assert_true(names.join(",") == "s,dep,add_1", names.join(","))
}
