///| P17-B: git dependencies, pion.lock, workspace test report, `pionc init` templates

///|
fn mf_check(cond : Bool, msg : String) -> Unit {
  if !cond {
    abort("ASSERTION FAILED: " + msg)
  }
}

///|
fn mf_has(haystack : String, needle : String) -> Bool {
  let hlen = haystack.length()
  let nlen = needle.length()
  let mut i = 0
  while i + nlen <= hlen {
    let mut j = 0
    while j < nlen &&
      str_code_at(haystack, i + j) == str_code_at(needle, j) {
      j = j + 1
    }
    if j == nlen {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "p17b: pion.toml path and git dependencies" {
  let toml =
    "[package]\n" +
    "name = \"app\"\n" +
    "[dependencies]\n" +
    "local_dep = { path = \"./deps/local_dep\" }\n" +
    "legacy = \"../legacy\"\n" +
    "remote_lib = { git = \"https://github.com/org/repo.git\", tag = \"v0.1.0\" }\n" +
    "pinned = { git = \"file:///tmp/r.git\", rev = \"0123abc\", subdir = \"pkgs/sub\" }\n" +
    "tracking = { git = \"file:///tmp/r.git\", branch = \"main\" }\n" +
    "head = { git = \"file:///tmp/r.git\" }\n"
  match parse_pion_toml(toml) {
    Ok(m) => {
      mf_check(m.deps.length() == 6, "6 deps")
      let d0 = m.deps[0]
      mf_check(d0.path == "./deps/local_dep" && !manifest_dep_is_git(d0), "path dep")
      mf_check(m.deps[1].path == "../legacy" && m.deps[1].git == "", "bare string path dep")
      let d2 = m.deps[2]
      mf_check(manifest_dep_is_git(d2), "git dep")
      mf_check(d2.git == "https://github.com/org/repo.git" && d2.tag == "v0.1.0", "git url + tag")
      mf_check(d2.path == "" && d2.subdir == "", "git dep has no path/subdir")
      mf_check(manifest_dep_ref(d2) == "tag:v0.1.0", "tag ref")
      let d3 = m.deps[3]
      mf_check(d3.rev == "0123abc" && d3.subdir == "pkgs/sub", "rev + subdir")
      mf_check(manifest_dep_ref(d3) == "rev:0123abc", "rev ref")
      mf_check(manifest_dep_ref(m.deps[4]) == "branch:main", "branch ref")
      mf_check(manifest_dep_ref(m.deps[5]) == "HEAD", "default HEAD ref")
    }
    Err(e) => abort("parse_pion_toml failed: " + e)
  }
  let bad : Array[String] = [
    "x = { git = \"u\", path = \"p\" }", "x = { git = \"u\", tag = \"a\", rev = \"b\" }",
    "x = { path = \"p\", tag = \"a\" }", "x = { path = \"p\", subdir = \"s\" }", "x = { version = \"1\" }",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse_pion_toml("[package]\nname = \"a\"\n[dependencies]\n" + bad[i] + "\n") {
      Ok(_) => abort("expected an error for " + bad[i])
      Err(e) => mf_check(mf_has(e, "pion.toml line 4"), "error names the line: " + e)
    }
    i = i + 1
  }
}

///|
test "p17b: pion.lock format is deterministic and round-trips" {
  let a = lock_entry_new(
    "zeta", "file:///tmp/z.git", "tag:v1", "ffff000000000000000000000000000000000000",
    "",
  )
  let b = lock_entry_new(
    "alpha", "file:///tmp/mono.git", "rev:abc", "abc0000000000000000000000000000000000000",
    "pkgs/sub",
  )
  let t1 = format_pion_lock([a, b])
  let t2 = format_pion_lock([b, a])
  mf_check(t1 == t2, "order-independent output")
  mf_check(mf_has(t1, "[[package]]\nname = \"alpha\""), "alpha table")
  mf_check(mf_has(t1, "subdir = \"pkgs/sub\""), "subdir written")
  mf_check(mf_has(t1, "subdir = \"\""), "empty subdir written")
  mf_check(
    mf_has(t1, "rev = \"ffff000000000000000000000000000000000000\""),
    "rev written",
  )
  match parse_pion_lock(t1) {
    Ok(es) => {
      mf_check(es.length() == 2, "2 entries")
      mf_check(es[0].name == "alpha" && es[1].name == "zeta", "sorted by name")
      mf_check(es[0].git == "file:///tmp/mono.git" && es[0].subdir == "pkgs/sub", "alpha fields")
      mf_check(es[0].reference == "rev:abc", "alpha ref")
      mf_check(es[1].rev == "ffff000000000000000000000000000000000000", "zeta rev")
      mf_check(format_pion_lock(es) == t1, "format(parse(x)) == x")
    }
    Err(e) => abort("parse_pion_lock failed: " + e)
  }
  match parse_pion_lock("") {
    Ok(es) => mf_check(es.length() == 0, "empty lock")
    Err(e) => abort("empty lock failed: " + e)
  }
  match parse_pion_lock("version = 1\n[[package]]\nname = \"x\"\n") {
    Ok(_) => abort("entry without git/rev must fail")
    Err(e) => mf_check(mf_has(e, "needs `name`, `git` and `rev`"), "missing fields: " + e)
  }
  match parse_pion_lock("[package]\nname = \"x\"\n") {
    Ok(_) => abort("unknown table must fail")
    Err(e) => mf_check(mf_has(e, "unexpected table"), "unexpected table: " + e)
  }
}

///|
test "p17b: lock_find matches name, url, subdir and requested ref" {
  match parse_pion_toml(
    "[package]\nname = \"a\"\n[dependencies]\nlib = { git = \"file:///r.git\", tag = \"v1\", subdir = \"s\" }\n",
  ) {
    Ok(m) => {
      let dep = m.deps[0]
      let hit = lock_entry_new("lib", "file:///r.git", "tag:v1", "1111", "s")
      let other_tag = lock_entry_new("lib", "file:///r.git", "tag:v2", "2222", "s")
      let other_sub = lock_entry_new("lib", "file:///r.git", "tag:v1", "3333", "")
      match lock_find([other_tag, other_sub, hit], dep) {
        Some(e) => mf_check(e.rev == "1111", "matching entry")
        None => abort("lock_find missed the matching entry")
      }
      match lock_find([other_tag, other_sub], dep) {
        Some(_) => abort("stale lock entries must not match")
        None => ()
      }
      let acc : Array[LockEntry] = []
      mf_check(lock_add(acc, hit) is Ok(_), "first add")
      mf_check(lock_add(acc, hit) is Ok(_), "same pin again")
      mf_check(acc.length() == 1, "deduplicated")
      let conflict = lock_entry_new("lib", "file:///r.git", "tag:v1", "9999", "s")
      match lock_add(acc, conflict) {
        Ok(_) => abort("conflicting revs must fail")
        Err(e) => mf_check(mf_has(e, "required as both"), "conflict message: " + e)
      }
    }
    Err(e) => abort("parse_pion_toml failed: " + e)
  }
}

///|
test "p17b: merged workspace test report" {
  let ok_json = format_workspace_test_report_json(
    ["json", "app"],
    ["json", "app"],
    ["parse", "main"],
    [true, true],
    0,
  )
  mf_check(
    ok_json ==
    "{\"ok\":true,\"total\":2,\"passed\":2,\"failed\":0,\"deps_skipped\":0,\"packages\":[\"json\",\"app\"],\"tests\":[{\"pkg\":\"json\",\"name\":\"parse\",\"ok\":true},{\"pkg\":\"app\",\"name\":\"main\",\"ok\":true}]}",
    "ok report: " + ok_json,
  )
  let skipped_json = format_workspace_test_report_json(["app"], ["app"], ["main"], [true], 2)
  mf_check(mf_has(skipped_json, "\"deps_skipped\":2"), "deps_skipped report")
  let bad_json = format_workspace_test_report_json(["a"], ["a"], ["t"], [false], 0)
  mf_check(mf_has(bad_json, "{\"ok\":false,\"total\":1,\"passed\":0,\"failed\":1"), "failed report")
  let empty = format_workspace_test_report_json([], [], [], [], 0)
  mf_check(mf_has(empty, "\"ok\":true") && mf_has(empty, "\"failed\":0"), "empty report")
}

///|
test "p17b: pionc init templates are formatted and named from the directory" {
  mf_check(init_package_name("/tmp/demo_app") == "demo_app", "plain name")
  mf_check(init_package_name("/tmp/My-App/") == "my_app", "sanitized name")
  mf_check(init_package_name("2fast") == "pkg_2fast", "leading digit")
  mf_check(init_package_name("/") == "app", "fallback name")
  let toml = init_pion_toml("demo_app")
  match parse_pion_toml(toml) {
    Ok(m) => mf_check(m.name == "demo_app" && m.deps.length() == 0, "init manifest parses")
    Err(e) => abort("init manifest: " + e)
  }
  let main_src = init_main_source("demo_app")
  let test_src = init_test_source("demo_app")
  mf_check(format_source(main_src) == main_src, "main template is fmt-clean")
  mf_check(format_source(test_src) == test_src, "test template is fmt-clean")
  let cr = check_source_files_full(
    "demo_app",
    ["src/main.pion", "main_test.pion"],
    [main_src, test_src],
  )
  mf_check(cr.diagnostics.length() == 0, "init templates type-check")
}

///|
test "p17b: workspace query covers every package" {
  let json_pkg = parse_package(
    "json",
    ["std/json/src/json.pion"],
    ["pub fn parse(s : String) -> Int {\n  s.length()\n}\n"],
  )
  let app_pkg = parse_package(
    "app",
    ["src/main.pion"],
    ["fn run() -> Int {\n  json::parse(\"x\")\n}\n"],
  )
  match query_workspace_json("defs", [json_pkg, app_pkg]) {
    Ok(j) => {
      mf_check(mf_has(j, "{\"pkg\":\"json\",\"name\":\"parse\""), "json defs: " + j)
      mf_check(mf_has(j, "{\"pkg\":\"app\",\"name\":\"run\""), "app defs: " + j)
    }
    Err(e) => abort(e)
  }
  match query_workspace_json("callers", [json_pkg, app_pkg]) {
    Ok(j) =>
      mf_check(
        mf_has(j, "{\"pkg\":\"app\",\"fn\":\"run\",\"calls\":[\"json::parse\"]}"),
        "cross-package call: " + j,
      )
    Err(e) => abort(e)
  }
  match query_workspace_json("sig", [json_pkg, app_pkg]) {
    Ok(j) =>
      mf_check(
        mf_has(j, "{\"packages\":[{\"name\":\"json\",\"sig\":") &&
        mf_has(j, "{\"name\":\"app\",\"sig\":"),
        "sig: " + j,
      )
    Err(e) => abort(e)
  }
  mf_check(query_workspace_json("bogus", [json_pkg]) is Err(_), "unknown kind")
  // Single-package output stays unchanged (no pkg key on callers).
  mf_check(
    query_callers_json(app_pkg) ==
    "{\"callers\":[{\"fn\":\"run\",\"calls\":[\"json::parse\"]}]}",
    "single-package callers",
  )
}

///|
test "p20b: pion.toml [registry] url and registry/version dependency keys" {
  let toml =
    "[package]\nname = \"app\"\n\n[registry]\nurl = \"file:///srv/pion-index.git\"\n\n" +
    "[dependencies]\n" +
    "mylib = { git = \"file:///srv/mylib.git\", tag = \"v1\", version = \"1.0.0\", registry = \"file:///srv/pion-index.git\" }\n"
  match parse_pion_toml(toml) {
    Ok(m) => {
      mf_check(m.registry == "file:///srv/pion-index.git", "[registry] url")
      mf_check(m.deps.length() == 1, "one dep")
      let d = m.deps[0]
      mf_check(d.tag == "v1" && d.version == "1.0.0", "tag + version")
      mf_check(d.registry == "file:///srv/pion-index.git", "dep registry")
      mf_check(manifest_dep_ref(d) == "tag:v1", "registry dep ref is its tag")
    }
    Err(e) => abort("parse_pion_toml failed: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[dependencies]\nx = { path = \"../x\", registry = \"r\" }\n") {
    Ok(_) => abort("path dep with registry must be rejected")
    Err(e) => mf_check(mf_has(e, "require `git"), "registry needs git: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n") {
    Ok(m) => mf_check(m.registry == "", "no registry by default")
    Err(e) => abort(e)
  }
}

///|
test "p20b: registry index entry parsing" {
  let txt = "# mylib\nname = \"mylib\"\nversion = \"2.0.0\"\ngit = \"file:///srv/mylib.git\"\ntag = \"v2\"\nsubdir = \"pkg\"\n"
  match parse_registry_entry("mylib", txt) {
    Ok(e) => {
      mf_check(e.name == "mylib" && e.version == "2.0.0", "name + version")
      mf_check(e.git == "file:///srv/mylib.git" && e.tag == "v2", "git + tag")
      mf_check(e.subdir == "pkg" && e.rev == "" && e.branch == "", "subdir")
      let d = registry_entry_dep(e, "file:///srv/idx.git")
      mf_check(d.name == "mylib" && d.registry == "file:///srv/idx.git", "dep from entry")
      mf_check(manifest_dep_is_git(d) && d.path == "", "registry dep is a git dep")
      mf_check(
        format_dep_inline(d) ==
        "{ git = \"file:///srv/mylib.git\", tag = \"v2\", subdir = \"pkg\", version = \"2.0.0\", registry = \"file:///srv/idx.git\" }",
        "inline form: " + format_dep_inline(d),
      )
    }
    Err(e) => abort("parse_registry_entry failed: " + e)
  }
  mf_check(registry_index_path("mylib") == "index/mylib.toml", "index path")
  let bad : Array[String] = [
    "version = \"1\"\n", "git = \"u\"\ntag = \"a\"\nrev = \"b\"\n", "name = \"other\"\ngit = \"u\"\n",
    "git u\n",
  ]
  let mut i = 0
  while i < bad.length() {
    match parse_registry_entry("mylib", bad[i]) {
      Ok(_) => abort("bad registry entry accepted: " + bad[i])
      Err(e) => mf_check(mf_has(e, "index/mylib.toml"), "error names the entry: " + e)
    }
    i = i + 1
  }
  mf_check(manifest_valid_dep_name("my_lib-2"), "valid name")
  mf_check(!manifest_valid_dep_name("2lib"), "leading digit")
  mf_check(!manifest_valid_dep_name("a b"), "space")
  mf_check(!manifest_valid_dep_name(""), "empty")
}

///|
test "p20b: manifest_set_dependency appends, replaces in place and is idempotent" {
  let init = init_pion_toml("app")
  let d1 = manifest_dep_new("util", "../util", "", "", "", "", "")
  let t1 = manifest_set_dependency(init, d1)
  mf_check(t1 == init + "util = { path = \"../util\" }\n", "append to empty table: " + t1)
  mf_check(manifest_set_dependency(t1, d1) == t1, "idempotent")
  let d2 = manifest_dep_new("net", "", "file:///r.git", "v1", "", "", "")
  let t2 = manifest_set_dependency(t1, d2)
  mf_check(
    t2 == init + "util = { path = \"../util\" }\nnet = { git = \"file:///r.git\", tag = \"v1\" }\n",
    "second entry after the first: " + t2,
  )
  let d2b = manifest_dep_new("net", "", "file:///r.git", "v2", "", "", "")
  let t3 = manifest_set_dependency(t2, d2b)
  mf_check(
    t3 == init + "util = { path = \"../util\" }\nnet = { git = \"file:///r.git\", tag = \"v2\" }\n",
    "replace in place: " + t3,
  )
  match parse_pion_toml(t3) {
    Ok(m) => mf_check(m.deps.length() == 2 && m.deps[1].tag == "v2", "rewritten toml parses")
    Err(e) => abort(e)
  }
  // Other sections and comments are kept; the entry goes into [dependencies], not after [link].
  let mixed = "[package]\nname = \"a\" # app\n\n[dependencies]\nold = { path = \"../old\" } # keep\n\n[link]\nlibs = [\"z\"]\n"
  let t4 = manifest_set_dependency(mixed, d1)
  mf_check(
    t4 == "[package]\nname = \"a\" # app\n\n[dependencies]\nold = { path = \"../old\" } # keep\nutil = { path = \"../util\" }\n\n[link]\nlibs = [\"z\"]\n",
    "insert inside the table: " + t4,
  )
  // No [dependencies] table yet (and no trailing newline).
  let t5 = manifest_set_dependency("[package]\nname = \"a\"", d1)
  mf_check(
    t5 == "[package]\nname = \"a\"\n\n[dependencies]\nutil = { path = \"../util\" }\n",
    "create the table: " + t5,
  )
  let entries = [lock_entry_new("net", "file:///r.git", "tag:v2", "abc123", "")]
  mf_check(lock_rev_of(entries, "net") == "abc123", "lock_rev_of")
  mf_check(lock_rev_of(entries, "nope") == "", "lock_rev_of missing")
}

///|
test "p26a: pion.toml multiline arrays and [link] / [link.macos] / [link.linux]" {
  let toml =
    "[package]\nname = \"farview_shim\"\nversion = \"0.1.0\"\n\n" +
    "[link]\n" +
    "libs = [\n" +
    "  \"z\",\n" +
    "  # comment inside multiline array\n" +
    "  \"sqlite3\",\n" +
    "  \"z\",\n" +
    "]\n" +
    "search_paths = [\"./lib\", \"/opt/local/lib\", \"./lib\"]\n" +
    "rpaths = [\"@executable_path/../lib\", \"$ORIGIN/../lib\", \"./lib\"]\n" +
    "objects = [\"vendor/libcurl.a\", \"vendor/libcurl.a\"]\n" +
    "flags = [\"-Wl,-u\", \"_sym1\", \"-Wl,-u\", \"_sym2\"]\n" +
    "c_sources = [\n" +
    "  \"csrc/v8_shim.cc\",\n" +
    "  \"csrc/helper.c\",\n" +
    "  \"csrc/v8_shim.cc\",\n" +
    "]\n" +
    "cc_flags = [\"-O2\", \"-DFLAG=1\", \"-DFLAG=1\", \"-Iinclude\"]\n\n" +
    "[link.macos]\n" +
    "frameworks = [\n" +
    "  \"Cocoa\",\n" +
    "  \"Metal\",\n" +
    "  \"QuartzCore\",\n" +
    "  \"Cocoa\",\n" +
    "]\n" +
    "lib = \"c++\"\n\n" +
    "[link.linux]\n" +
    "libs = [\"freetype\", \"fontconfig\"]\n" +
    "flags = [\"-Wl,--as-needed\"]\n\n" +
    "[link.ios]\n" +
    "frameworks = [\"UIKit\", \"Metal\"]\n" +
    "c_sources = [\"csrc/ios_shim.m\"]\n\n" +
    "[link.android]\n" +
    "libs = [\"log\", \"android\"]\n" +
    "cc_flags = [\"-DANDROID_BUILD=1\"]\n\n" +
    "[link.windows]\n" +
    "libs = [\"ws2_32\", \"bcrypt\"]\n" +
    "cc_flags = [\"-DWIN32_LEAN_AND_MEAN\"]\n"
  match parse_pion_toml(toml) {
    Ok(m) => {
      mf_check(m.link_libs.length() == 2 && m.link_libs[0] == "z" && m.link_libs[1] == "sqlite3", "link_libs compat")
      let lc = m.link_common
      mf_check(lc.libs.length() == 2 && lc.libs[0] == "z" && lc.libs[1] == "sqlite3", "common libs dedup")
      mf_check(lc.search_paths.length() == 2 && lc.search_paths[0] == "./lib" && lc.search_paths[1] == "/opt/local/lib", "search_paths dedup")
      mf_check(lc.rpaths.length() == 3 && lc.rpaths[0] == "@executable_path/../lib" && lc.rpaths[1] == "$ORIGIN/../lib" && lc.rpaths[2] == "./lib", "rpaths")
      mf_check(lc.objects.length() == 1 && lc.objects[0] == "vendor/libcurl.a", "objects dedup")
      mf_check(lc.flags.length() == 4 && lc.flags[0] == "-Wl,-u" && lc.flags[2] == "-Wl,-u", "flags keep duplicates and order")
      mf_check(lc.c_sources.length() == 2 && lc.c_sources[0] == "csrc/v8_shim.cc" && lc.c_sources[1] == "csrc/helper.c", "c_sources dedup")
      mf_check(lc.cc_flags.length() == 4 && lc.cc_flags[1] == "-DFLAG=1" && lc.cc_flags[2] == "-DFLAG=1", "cc_flags keep duplicates and order")
      let lm = m.link_macos
      mf_check(lm.frameworks.length() == 3 && lm.frameworks[0] == "Cocoa" && lm.frameworks[1] == "Metal" && lm.frameworks[2] == "QuartzCore", "macos frameworks")
      mf_check(lm.libs.length() == 1 && lm.libs[0] == "c++", "macos lib")
      let ll = m.link_linux
      mf_check(ll.libs.length() == 2 && ll.libs[0] == "freetype" && ll.libs[1] == "fontconfig", "linux libs")
      mf_check(ll.flags.length() == 1 && ll.flags[0] == "-Wl,--as-needed", "linux flags")
      let li = m.link_ios
      mf_check(li.frameworks.length() == 2 && li.frameworks[0] == "UIKit" && li.frameworks[1] == "Metal", "ios frameworks")
      mf_check(li.c_sources.length() == 1 && li.c_sources[0] == "csrc/ios_shim.m", "ios c_sources")
      let la = m.link_android
      mf_check(la.libs.length() == 2 && la.libs[0] == "log" && la.libs[1] == "android", "android libs")
      mf_check(la.cc_flags.length() == 1 && la.cc_flags[0] == "-DANDROID_BUILD=1", "android cc_flags")
      let lw = m.link_windows
      mf_check(lw.libs.length() == 2 && lw.libs[0] == "ws2_32" && lw.libs[1] == "bcrypt", "windows libs")
      mf_check(lw.cc_flags.length() == 1 && lw.cc_flags[0] == "-DWIN32_LEAN_AND_MEAN", "windows cc_flags")
    }
    Err(e) => abort("parse_pion_toml failed: " + e)
  }
  // Unknown key in [link], [link.macos], [link.linux], [link.ios], [link.android], [link.windows] must fail cleanly with line number.
  match parse_pion_toml("[package]\nname = \"a\"\n[link]\nbogus = [\"x\"]\n") {
    Ok(_) => abort("unknown key in [link] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `bogus`"), "unknown [link] key: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.macos]\nfoo = \"bar\"\n") {
    Ok(_) => abort("unknown key in [link.macos] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `foo`"), "unknown [link.macos] key: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.linux]\nbar = [\"x\"]\n") {
    Ok(_) => abort("unknown key in [link.linux] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `bar`"), "unknown [link.linux] key: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.ios]\nbaz = [\"x\"]\n") {
    Ok(_) => abort("unknown key in [link.ios] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `baz`"), "unknown [link.ios] key: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.android]\nqux = [\"x\"]\n") {
    Ok(_) => abort("unknown key in [link.android] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `qux`"), "unknown [link.android] key: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.windows]\nquux = [\"x\"]\n") {
    Ok(_) => abort("unknown key in [link.windows] must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `quux`"), "unknown [link.windows] key: " + e)
  }
  // Unclosed multiline array must fail cleanly.
  match parse_pion_toml("[package]\nname = \"a\"\n[link]\nlibs = [\n  \"z\",\n") {
    Ok(_) => abort("unclosed array must fail")
    Err(e) => mf_check(mf_has(e, "pion.toml line 4") && mf_has(e, "unclosed array"), "unclosed array: " + e)
  }
}

///|
test "p30g: pionc init service and invar-app templates parse, format, and type-check cleanly" {
  // service template
  let svc_toml = init_service_pion_toml("demo_svc")
  match parse_pion_toml(svc_toml) {
    Ok(m) => mf_check(m.name == "demo_svc" && m.deps.length() == 0, "service manifest parses")
    Err(e) => abort("service manifest: " + e)
  }
  let svc_worker = init_service_worker_source("demo_svc")
  let svc_main = init_service_main_source("demo_svc")
  let svc_test = init_service_test_source("demo_svc")
  mf_check(format_source(svc_worker) == svc_worker, "service worker fmt-clean")
  mf_check(format_source(svc_main) == svc_main, "service main fmt-clean")
  mf_check(format_source(svc_test) == svc_test, "service test fmt-clean")
  let svc_cr = check_source_files_full(
    "demo_svc",
    ["src/worker.pion", "src/main.pion", "main_test.pion"],
    [svc_worker, svc_main, svc_test],
  )
  mf_check(
    svc_cr.diagnostics.length() == 0,
    "service template type-check: " + check_result_to_json(svc_cr.diagnostics),
  )

  // invar-app template
  let inv_toml = init_invar_pion_toml("demo_ui")
  match parse_pion_toml(inv_toml) {
    Ok(m) => mf_check(m.name == "demo_ui" && m.deps.length() == 0, "invar-app manifest parses")
    Err(e) => abort("invar-app manifest: " + e)
  }
  let inv_proto = init_invar_protocol_source("demo_ui")
  let inv_worker = init_invar_worker_source("demo_ui")
  let inv_view = init_invar_view_source("demo_ui")
  let inv_main = init_invar_main_source("demo_ui")
  let inv_test = init_invar_test_source("demo_ui")
  mf_check(mf_has(inv_view, "#render_thread"), "invar-app view uses #render_thread")
  mf_check(format_source(inv_proto) == inv_proto, "invar protocol fmt-clean")
  mf_check(format_source(inv_worker) == inv_worker, "invar worker fmt-clean")
  mf_check(format_source(inv_view) == inv_view, "invar view fmt-clean")
  mf_check(format_source(inv_main) == inv_main, "invar main fmt-clean")
  mf_check(format_source(inv_test) == inv_test, "invar test fmt-clean")
  let inv_cr = check_source_files_full(
    "demo_ui",
    ["src/protocol.pion", "src/worker.pion", "src/view.pion", "src/main.pion", "main_test.pion"],
    [inv_proto, inv_worker, inv_view, inv_main, inv_test],
  )
  mf_check(
    inv_cr.diagnostics.length() == 0,
    "invar-app template type-check: " + check_result_to_json(inv_cr.diagnostics),
  )
}

///|
test "p31b: [link.windows] rc_sources / rc_source parsing and unknown key rejection" {
  let toml =
    "[package]\nname = \"win_app\"\n\n" +
    "[link.windows]\n" +
    "rc_sources = [\n" +
    "  \"res/app.rc\",\n" +
    "  \"res/ver.rc\",\n" +
    "  \"res/app.rc\",\n" +
    "]\n" +
    "rc_source = \"res/icon.rc\"\n" +
    "libs = [\"user32\"]\n"
  match parse_pion_toml(toml) {
    Ok(m) => {
      let lw = m.link_windows
      mf_check(lw.rc_sources.length() == 3, "3 deduped rc_sources")
      mf_check(
        lw.rc_sources[0] == "res/app.rc" &&
        lw.rc_sources[1] == "res/ver.rc" &&
        lw.rc_sources[2] == "res/icon.rc",
        "rc_sources order + dedup + singular rc_source",
      )
      mf_check(lw.libs.length() == 1 && lw.libs[0] == "user32", "windows libs preserved")
    }
    Err(e) => abort("parse_pion_toml failed: " + e)
  }
  match parse_pion_toml("[package]\nname = \"a\"\n[link.windows]\nrc_files = [\"x.rc\"]\n") {
    Ok(_) => abort("unknown key rc_files in [link.windows] must fail")
    Err(e) =>
      mf_check(
        mf_has(e, "pion.toml line 4") && mf_has(e, "unknown key `rc_files`"),
        "unknown [link.windows] key: " + e,
      )
  }
}

///|
test "p31b: win_translate_msvc_flags and win_derive_cxx_from_cc" {
  let t1 = win_translate_msvc_flags(
    ["-mwindows", "-lm", "-lpthread", "-Wl,--stack,16777216", "-Wl,/DEBUG"],
    false,
  )
  mf_check(
    t1.length() == 6 &&
    t1[0] == "-Wl,/SUBSYSTEM:WINDOWS" &&
    t1[1] == "-Wl,/ENTRY:mainCRTStartup" &&
    t1[2] == "-Wl,/STACK:16777216" &&
    t1[3] == "-Wl,/DEBUG" &&
    t1[4] == "-fuse-ld=lld" &&
    t1[5] == "-lws2_32",
    "mwindows + stack + strip -lm/-lpthread + add lld + ws2_32",
  )

  // Default exe (no stack flag, no -fuse-ld=): adds -fuse-ld=lld, -lws2_32, -Wl,/STACK:16777216
  let t2 = win_translate_msvc_flags(["-mconsole"], false)
  mf_check(
    t2.length() == 4 &&
    t2[0] == "-Wl,/SUBSYSTEM:CONSOLE" &&
    t2[1] == "-fuse-ld=lld" &&
    t2[2] == "-lws2_32" &&
    t2[3] == "-Wl,/STACK:16777216",
    "mconsole + default lld + ws2_32 + default stack",
  )

  // Custom -fuse-ld= is not duplicated, and cdylib does not add /STACK
  let t3 = win_translate_msvc_flags(["-fuse-ld=lld-link", "-lm"], true)
  mf_check(
    t3.length() == 2 &&
    t3[0] == "-fuse-ld=lld-link" &&
    t3[1] == "-lws2_32",
    "cdylib preserves custom -fuse-ld= and omits /STACK",
  )

  // CC -> CXX derivation on Windows
  mf_check(win_derive_cxx_from_cc("clang") == "clang++", "bare clang")
  mf_check(win_derive_cxx_from_cc("clang.exe") == "clang++.exe", "bare clang.exe")
  mf_check(
    win_derive_cxx_from_cc("C:\\Program Files\\LLVM\\bin\\clang.exe") ==
    "C:\\Program Files\\LLVM\\bin\\clang++.exe",
    "windows backslash path",
  )
  mf_check(
    win_derive_cxx_from_cc("/c/LLVM/bin/clang.exe") == "/c/LLVM/bin/clang++.exe",
    "msys slash path",
  )
  mf_check(win_derive_cxx_from_cc("gcc.exe") == "", "non-clang gcc")
  mf_check(win_derive_cxx_from_cc("") == "", "empty CC")
}

///|
test "p32b: virtual and hybrid [workspace] with [workspace.dependencies]" {
  let virtual_toml =
    "[workspace]\n" +
    "members = [\n" +
    "  \"packages/*\",\n" +
    "  # comment in multiline members\n" +
    "  \"cmd/app\",\n" +
    "  \"packages/*\",\n" +
    "]\n\n" +
    "[workspace.dependencies]\n" +
    "ui = { path = \"packages/ui\" }\n" +
    "invar = { git = \"https://github.com/example/ui-kit.git\", rev = \"abc1234\", subdir = \"pkg/invar\" }\n" +
    "reglib = { git = \"file:///srv/reglib.git\", tag = \"v1.2.0\", version = \"1.2.0\", registry = \"file:///srv/idx.git\" }\n"
  match parse_pion_toml(virtual_toml) {
    Ok(m) => {
      mf_check(m.is_workspace, "virtual root sets is_workspace")
      mf_check(m.name == "", "virtual root has empty package name")
      mf_check(m.workspace_members.length() == 2, "2 deduped members")
      mf_check(
        m.workspace_members[0] == "packages/*" && m.workspace_members[1] == "cmd/app",
        "members order preserved",
      )
      mf_check(m.workspace_deps.length() == 3, "3 workspace deps")
      let d0 = m.workspace_deps[0]
      mf_check(d0.name == "ui" && d0.path == "packages/ui" && !d0.workspace, "ws path dep")
      let d1 = m.workspace_deps[1]
      mf_check(
        d1.name == "invar" &&
        d1.git == "https://github.com/example/ui-kit.git" &&
        d1.rev == "abc1234" &&
        d1.subdir == "pkg/invar" &&
        !d1.workspace,
        "ws git+rev+subdir dep",
      )
      let d2 = m.workspace_deps[2]
      mf_check(
        d2.name == "reglib" &&
        d2.tag == "v1.2.0" &&
        d2.version == "1.2.0" &&
        d2.registry == "file:///srv/idx.git" &&
        !d2.workspace,
        "ws registry dep",
      )
    }
    Err(e) => abort("virtual workspace parse failed: " + e)
  }

  // Hybrid root: both [package] and [workspace], plus singular `member` key.
  let hybrid_toml =
    "[package]\nname = \"root_app\"\nversion = \"0.2.0\"\n\n" +
    "[workspace]\nmember = \"crates/core\"\n\n" +
    "[dependencies]\ncore = { path = \"crates/core\" }\n"
  match parse_pion_toml(hybrid_toml) {
    Ok(m) => {
      mf_check(m.is_workspace, "hybrid root is_workspace")
      mf_check(m.name == "root_app" && m.version == "0.2.0", "hybrid root package info")
      mf_check(m.workspace_members.length() == 1 && m.workspace_members[0] == "crates/core", "singular member")
      mf_check(m.deps.length() == 1 && m.deps[0].name == "core", "hybrid root deps")
    }
    Err(e) => abort("hybrid workspace parse failed: " + e)
  }

  // Non-workspace manifest without [package] still fails.
  match parse_pion_toml("[dependencies]\na = { path = \"../a\" }\n") {
    Ok(_) => abort("non-workspace without [package] must fail")
    Err(e) => mf_check(mf_has(e, "missing `[package]`"), "missing package error: " + e)
  }
}

///|
test "p32b: workspace = true dependency parsing and validation errors" {
  let sub_toml =
    "[package]\nname = \"sub_app\"\n\n" +
    "[dependencies]\n" +
    "ui = { workspace = true }\n" +
    "local = { workspace = false, path = \"../local\" }\n"
  match parse_pion_toml(sub_toml) {
    Ok(m) => {
      mf_check(!m.is_workspace, "sub-package is not a workspace root")
      mf_check(m.deps.length() == 2, "2 deps")
      mf_check(
        m.deps[0].name == "ui" && m.deps[0].workspace && m.deps[0].path == "" && m.deps[0].git == "",
        "workspace = true dep",
      )
      mf_check(format_dep_inline(m.deps[0]) == "{ workspace = true }", "format workspace dep inline")
      mf_check(
        m.deps[1].name == "local" && !m.deps[1].workspace && m.deps[1].path == "../local",
        "workspace = false with path",
      )
    }
    Err(e) => abort("sub-package parse failed: " + e)
  }

  // Mixing workspace = true with path / git / registry must fail with line number.
  let bad_sub : Array[String] = [
    "ui = { workspace = true, path = \"../ui\" }",
    "ui = { workspace = true, git = \"https://example.com/ui.git\" }",
    "ui = { workspace = true, registry = \"file:///idx.git\" }",
    "ui = { workspace = \"yes\" }",
    "ui = { workspace = false }",
  ]
  let mut i = 0
  while i < bad_sub.length() {
    match parse_pion_toml("[package]\nname = \"s\"\n[dependencies]\n" + bad_sub[i] + "\n") {
      Ok(_) => abort("expected error for: " + bad_sub[i])
      Err(e) => mf_check(mf_has(e, "pion.toml line 4"), "error has line 4: " + e)
    }
    i = i + 1
  }

  // workspace = true inside [workspace.dependencies] must fail with line number.
  match parse_pion_toml("[workspace]\nmembers = [\"a\"]\n[workspace.dependencies]\nui = { workspace = true }\n") {
    Ok(_) => abort("workspace = true in [workspace.dependencies] must fail")
    Err(e) =>
      mf_check(
        mf_has(e, "pion.toml line 4") && mf_has(e, "[workspace.dependencies]"),
        "ws.deps workspace=true error: " + e,
      )
  }

  // Unknown key in [workspace] must fail with line number.
  match parse_pion_toml("[workspace]\nmembers = [\"a\"]\nresolver = \"2\"\n") {
    Ok(_) => abort("unknown key in [workspace] must fail")
    Err(e) =>
      mf_check(
        mf_has(e, "pion.toml line 3") && mf_has(e, "unknown key `resolver`"),
        "unknown [workspace] key: " + e,
      )
  }
}

///|
test "p32b: manifest_resolve_ws_dep and manifest_match_member_pattern" {
  let ws_toml =
    "[workspace]\nmembers = [\"packages/*\", \"cmd/*\"]\n" +
    "[workspace.dependencies]\n" +
    "ui = { path = \"packages/ui\" }\n" +
    "ext = { path = \"../shared/ext\" }\n" +
    "invar = { git = \"https://github.com/example/ui-kit.git\", rev = \"deadbeef\", subdir = \"crates/invar\", version = \"0.3.0\", registry = \"file:///idx.git\" }\n"
  let ws_mf = match parse_pion_toml(ws_toml) {
    Ok(m) => m
    Err(e) => abort("ws_toml failed: " + e)
  }
  let sub_mf = match parse_pion_toml(
    "[package]\nname = \"app\"\n[dependencies]\nui = { workspace = true }\next = { workspace = true }\ninvar = { workspace = true }\nplain = { path = \"../plain\" }\nmissing = { workspace = true }\n",
  ) {
    Ok(m) => m
    Err(e) => abort("sub_mf failed: " + e)
  }

  // Path dep resolved from absolute ws_root_dir -> canonical absolute path.
  match manifest_resolve_ws_dep(sub_mf.deps[0], "/repo/myws", "/repo/myws/cmd/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.name == "ui" && r.path == "/repo/myws/packages/ui" && !r.workspace && r.git == "",
        "abs ws path rewrite: " + r.path,
      )
    Err(e) => abort("resolve ui failed: " + e)
  }
  match manifest_resolve_ws_dep(sub_mf.deps[1], "/repo/myws", "/repo/myws/cmd/deep/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.name == "ext" && r.path == "/repo/shared/ext" && !r.workspace,
        "abs ws parent path rewrite: " + r.path,
      )
    Err(e) => abort("resolve ext failed: " + e)
  }

  // Path dep resolved from relative ws_root_dir -> rebased relative to pkg_dir.
  match manifest_resolve_ws_dep(sub_mf.deps[0], ".", "cmd/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.path == "../../packages/ui" && !r.workspace,
        "rel ws path rebase: " + r.path,
      )
    Err(e) => abort("resolve rel ui failed: " + e)
  }

  // Git + subdir + version + registry dep inheritance.
  match manifest_resolve_ws_dep(sub_mf.deps[2], "/repo/myws", "/repo/myws/cmd/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.name == "invar" &&
        !r.workspace &&
        r.path == "" &&
        r.git == "https://github.com/example/ui-kit.git" &&
        r.rev == "deadbeef" &&
        r.subdir == "crates/invar" &&
        r.version == "0.3.0" &&
        r.registry == "file:///idx.git",
        "git+subdir inheritance",
      )
    Err(e) => abort("resolve invar failed: " + e)
  }

  // Non-workspace dep passes through unchanged.
  match manifest_resolve_ws_dep(sub_mf.deps[3], "/repo/myws", "/repo/myws/cmd/app", ws_mf.workspace_deps) {
    Ok(r) => mf_check(r.name == "plain" && r.path == "../plain" && !r.workspace, "passthrough dep")
    Err(e) => abort("passthrough failed: " + e)
  }

  // Missing workspace dependency reports exact error message.
  match manifest_resolve_ws_dep(sub_mf.deps[4], "/repo/myws", "/repo/myws/cmd/app", ws_mf.workspace_deps) {
    Ok(_) => abort("missing workspace dep must fail")
    Err(e) =>
      mf_check(
        e == "dependency 'missing' marked workspace = true but not found in [workspace.dependencies]",
        "missing dep error: " + e,
      )
  }

  // manifest_match_member_pattern boundary checks.
  mf_check(manifest_match_member_pattern("cmd/mousedpi", "cmd/mousedpi"), "exact match")
  mf_check(!manifest_match_member_pattern("cmd/mousedpi", "cmd/other"), "exact mismatch")
  mf_check(manifest_match_member_pattern("packages/*", "packages/ui"), "single-seg glob match")
  mf_check(!manifest_match_member_pattern("packages/*", "packages/a/b"), "single-seg glob rejects nested")
  mf_check(!manifest_match_member_pattern("packages/*", "packages"), "single-seg glob rejects dir itself")
  mf_check(manifest_match_member_pattern("./packages/*/", "./packages/ui/"), "normalized ./ and trailing /")
  mf_check(manifest_match_member_pattern("*", "app"), "top-level wildcard")
  mf_check(!manifest_match_member_pattern("*", "a/b"), "top-level wildcard rejects nested")
  mf_check(manifest_match_member_pattern("packages/*/sub", "packages/foo/sub"), "middle wildcard")
  mf_check(!manifest_match_member_pattern("packages/*/sub", "packages/foo/bar/sub"), "middle wildcard rejects deep")
  mf_check(manifest_match_member_pattern("packages/ui-*", "packages/ui-core"), "prefix glob in segment")
  mf_check(!manifest_match_member_pattern("packages/ui-*", "packages/net-core"), "prefix glob mismatch")
  mf_check(!manifest_match_member_pattern("", "cmd/app"), "empty pattern")
  mf_check(!manifest_match_member_pattern("cmd/app", ""), "empty rel_path")
  mf_check(manifest_match_member_pattern(".", "."), "dot matches dot")
  mf_check(!manifest_match_member_pattern(".", "cmd"), "dot rejects non-dot")
}

///|
test "wave_j4b: package alias parsing, workspace inheritance, canon_id & lockfile compat" {
  let toml =
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n" +
    "[dependencies]\n" +
    "j1 = { package = \"json\", path = \"../vendor/json\" }\n" +
    "j2 = { package = \"json\", git = \"https://example.com/pkgs.git\", tag = \"v1\", subdir = \"packages/json\" }\n" +
    "ws_j = { package = \"json\", workspace = true }\n"
  match parse_pion_toml(toml) {
    Ok(m) => {
      mf_check(m.deps.length() == 3, "3 deps")
      mf_check(m.deps[0].name == "j1" && m.deps[0].package == "json" && manifest_dep_pkg_name(m.deps[0]) == "json", "path alias")
      mf_check(m.deps[1].name == "j2" && m.deps[1].package == "json" && m.deps[1].subdir == "packages/json", "git alias")
      mf_check(m.deps[2].name == "ws_j" && m.deps[2].package == "json" && m.deps[2].workspace, "ws alias")
      mf_check(
        format_dep_inline(m.deps[0]) == "{ package = \"json\", path = \"../vendor/json\" }",
        "format path alias: " + format_dep_inline(m.deps[0]),
      )
    }
    Err(e) => abort("parse alias toml failed: " + e)
  }

  // Workspace alias inheritance: both `[workspace.dependencies] ws_j = { package = "json", ... }`
  // and member `ws_j = { package = "json", workspace = true }` targeting `json` in workspace.
  let ws_toml =
    "[workspace]\nmembers = [\"app\"]\n\n" +
    "[workspace.dependencies]\n" +
    "json = { path = \"vendor/json\" }\n" +
    "aliased_ws = { package = \"json\", git = \"https://example.com/pkgs.git\", tag = \"v2\" }\n"
  let ws_mf = match parse_pion_toml(ws_toml) {
    Ok(m) => m
    Err(e) => abort("parse ws alias toml failed: " + e)
  }
  let m_dep1 = ManifestDep::{
    name: "ws_j",
    package: "json",
    path: "",
    git: "",
    tag: "",
    rev: "",
    branch: "",
    subdir: "",
    registry: "",
    version: "",
    workspace: true,
  }
  match manifest_resolve_ws_dep(m_dep1, "/ws", "/ws/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.name == "ws_j" && r.package == "json" && r.path == "/ws/vendor/json",
        "member alias -> ws dep",
      )
    Err(e) => abort("ws resolve m_dep1 failed: " + e)
  }
  let m_dep2 = ManifestDep::{
    name: "aliased_ws",
    package: "",
    path: "",
    git: "",
    tag: "",
    rev: "",
    branch: "",
    subdir: "",
    registry: "",
    version: "",
    workspace: true,
  }
  match manifest_resolve_ws_dep(m_dep2, "/ws", "/ws/app", ws_mf.workspace_deps) {
    Ok(r) =>
      mf_check(
        r.name == "aliased_ws" && r.package == "json" && r.tag == "v2",
        "inherit ws package alias",
      )
    Err(e) => abort("ws resolve m_dep2 failed: " + e)
  }

  // source_id & canon_id determinism (alias-free, host-path-free).
  let rev1 = "0123456789abcdef0123456789abcdef01234567"
  let rev2 = "fedcba9876543210fedcba9876543210fedcba98"
  let sg1 = pkg_source_id_git("https://example.com/r.git/", rev1, "./packages/json/", "json")
  let sg1b = pkg_source_id_git("https://example.com/r.git", rev1, "packages/json", "json")
  let sg2 = pkg_source_id_git("https://example.com/r.git", rev2, "packages/json", "json")
  mf_check(sg1 == sg1b, "normalized git source_id matches")
  mf_check(sg1 != sg2, "different revs get different source_ids")
  mf_check(pkg_canon_id("json", sg1, false) == pkg_canon_id("json", sg1b, false), "same git source -> same canon_id")
  mf_check(pkg_canon_id("json", sg1, false) != pkg_canon_id("json", sg2, false), "different git rev -> different canon_id")
  mf_check(pkg_canon_id("app", pkg_source_id_path(".", "app"), true) == "app", "root anchor keeps declared name")
  let rel_wt1 = pkg_rebase_rel_path("/tmp/wt1/proj", "/tmp/wt1/vendor/json")
  let rel_wt2 = pkg_rebase_rel_path("/tmp/wt2/proj", "/tmp/wt2/vendor/json")
  mf_check(rel_wt1 == "../vendor/json" && rel_wt1 == rel_wt2, "worktree-independent rel locator")

  // Legacy v1 pion.lock compatibility + multi-ref coexistence + ambiguity rejection.
  let v1_lock =
    "version = 1\n\n[[package]]\nname = \"json\"\ngit = \"file:///r.git\"\nref = \"tag:v1\"\nrev = \"" +
    rev1 +
    "\"\nsubdir = \"packages/json\"\n"
  let parsed = match parse_pion_lock(v1_lock) {
    Ok(es) => es
    Err(e) => abort("parse v1 lock failed: " + e)
  }
  let alias_dep = ManifestDep::{
    name: "my_json",
    package: "json",
    path: "",
    git: "file:///r.git",
    tag: "v1",
    rev: "",
    branch: "",
    subdir: "packages/json",
    registry: "",
    version: "",
    workspace: false,
  }
  match lock_find_checked(parsed, alias_dep) {
    Ok(Some(e)) => mf_check(e.rev == rev1, "legacy v1 lock matches aliased dep")
    _ => abort("expected legacy v1 lock hit")
  }
  // Ambiguous lock entries for same (pkg, git, subdir, ref) with different revs -> error.
  let ambig = [
    lock_entry_new("json", "file:///r.git", "tag:v1", rev1, "packages/json"),
    lock_entry_new_pkg("my_json", "json", "file:///r.git", "tag:v1", rev2, "packages/json"),
  ]
  match lock_find_checked(ambig, alias_dep) {
    Err(e) => mf_check(mf_has(e, "ambiguous"), "ambiguous lock error: " + e)
    Ok(_) => abort("ambiguous lock entries must fail")
  }
  // Distinct refs (tag:v1 and tag:v2) coexist cleanly in lock_add.
  let multi_entries : Array[LockEntry] = []
  match lock_add(multi_entries, lock_entry_new("json", "file:///r.git", "tag:v1", rev1, "")) {
    Ok(_) => ()
    Err(e) => abort(e)
  }
  match lock_add(multi_entries, lock_entry_new("json", "file:///r.git", "tag:v2", rev2, "")) {
    Ok(_) => mf_check(multi_entries.length() == 2, "distinct refs coexist")
    Err(e) => abort("distinct refs must coexist: " + e)
  }

  // Semantic lockfile equivalence (normalizes trailing slash & ./subdir/) and exact rev lookup.
  let legacy_norm = [
    lock_entry_new("json", "file:///r.git/", "tag:v1", rev1, "./packages/json/"),
    lock_entry_new("json", "file:///r.git", "tag:v2", rev2, "packages/json"),
  ]
  let canon_norm = [
    lock_entry_new("json", "file:///r.git", "tag:v1", rev1, "packages/json"),
    lock_entry_new("json", "file:///r.git", "tag:v2", rev2, "packages/json"),
  ]
  mf_check(lock_entries_equiv(legacy_norm, canon_norm), "normalized lock entries are semantically equivalent")
  mf_check(
    lock_rev_for_entry(legacy_norm, canon_norm[0]) == rev1 &&
    lock_rev_for_entry(legacy_norm, canon_norm[1]) == rev2,
    "exact rev lookup distinguishes refs of same package",
  )
  let diff_rev = [
    lock_entry_new("json", "file:///r.git", "tag:v1", rev2, "packages/json"),
    lock_entry_new("json", "file:///r.git", "tag:v2", rev2, "packages/json"),
  ]
  mf_check(!lock_entries_equiv(legacy_norm, diff_rev), "different rev breaks lock equivalence")

  // manifest_set_workspace_dependency updates [workspace.dependencies] in place preserving alias.
  let ws_reg_toml =
    "[workspace]\nmembers = [\"app\"]\n\n[workspace.dependencies]\nmy_reg = { package = \"json\", git = \"file:///r.git\", tag = \"v1\", version = \"0.1.0\", registry = \"file:///idx\" }\n"
  let ws_reg_v2 = ManifestDep::{
    name: "my_reg",
    package: "json",
    path: "",
    git: "file:///r.git",
    tag: "v2",
    rev: "",
    branch: "",
    subdir: "",
    registry: "file:///idx",
    version: "0.2.0",
    workspace: false,
  }
  let ws_reg_updated = manifest_set_workspace_dependency(ws_reg_toml, ws_reg_v2)
  mf_check(
    mf_has(ws_reg_updated, "[workspace.dependencies]") &&
    mf_has(ws_reg_updated, "my_reg = { package = \"json\", git = \"file:///r.git\", tag = \"v2\", version = \"0.2.0\", registry = \"file:///idx\" }"),
    "manifest_set_workspace_dependency preserves alias: " + ws_reg_updated,
  )
}
