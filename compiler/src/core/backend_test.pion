  assert_true(ssa.contains("ceqs "), ssa)
  assert_true(ssa.contains("=w udiv "), ssa)
  assert_true(ssa.contains("=w urem "), ssa)
  assert_true(ssa.contains("=w shr "), ssa)
  assert_true(ssa.contains("=l udiv "), ssa)
  assert_true(ssa.contains("=l urem "), ssa)
  assert_true(ssa.contains("=l shr "), ssa)
  assert_true(ssa.contains("cultw "), ssa)
  assert_true(ssa.contains("cultl "), ssa)
}

