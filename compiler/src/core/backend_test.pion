  assert_true(out_shl.contains("$pion_rc_dec"), out_shl)

  // 10. Cross-array mismatch `(arr1, idx2)` in chained bounds checks MUST NOT cancel.
  let ssa_cross_arr =
    #|export function l $f_cross_arr(l %arr1, l %arr2, w %i1, w %i2) {
    #|@start
    #|    call $pion_rc_inc(l %arr1)
    #|    call $pion_rc_inc(l %arr2)
    #|    %il1 =l extsw %i1
    #|    %len1 =l loadl %arr1
    #|    %oob1 =w cugel %il1, %len1
    #|    jnz %oob1, @oob1, @ok1
    #|@oob1
    #|    call $pion_panic_oob(l %il1, l %len1)
    #|    hlt
    #|@ok1
    #|    %il2 =l extsw %i2
    #|    %len2 =l loadl %arr2
    #|    %oob2 =w cugel %il2, %len2
    #|    jnz %oob2, @oob2, @ok2
    #|@oob2
    #|    call $pion_panic_oob(l %il2, l %len2)
    #|    hlt
    #|@ok2
    #|    %dp1_p =l add %arr1, 24
    #|    %dp1 =l loadl %dp1_p
    #|    %off2 =l shl %il2, 3
    #|    %ep_bad =l add %dp1, %off2
    #|    %el =l loadl %ep_bad
    #|    call $pion_rc_dec(l %arr2)
    #|    call $pion_rc_dec(l %arr1)
    #|    ret %el
    #|}
    #|
  let out_cross = cleanup_native_rc_ssa(ssa_cross_arr)
  assert_true(out_cross.contains("$pion_rc_inc"), out_cross)
  assert_true(out_cross.contains("$pion_rc_dec"), out_cross)

