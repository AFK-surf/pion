///| Unit tests for CAS SHA-256, LRU eviction, and QBE codegen determinism

///|
test "cas_sha256_nist_vectors" {
  assert_eq(
    cas_sha256_hex(""),
    "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  )
  assert_eq(
    cas_sha256_hex("abc"),
    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  )
}

///|
test "drv_batch_bounds_int64_and_largest_batch" {
  // 65535 * 65536 overflows Int (i32): the product is taken in Int64.
  assert_eq(drv_batch_start(65535, 65536, 65536), 65535)
  assert_eq(drv_batch_start(65536, 65536, 65536), 65536)
  assert_eq(drv_find_batch_for(65535, 65536, 65536), 65535)
  assert_eq(drv_batch_start(drv_find_batch_for(65535, 65536, 65536), 65536, 65536), 65535)
  // Uneven split: the last batch holds units 65535 and 65536.
  assert_eq(drv_batch_start(65535, 65537, 65536), 65535)
  assert_eq(drv_batch_start(65536, 65537, 65536), 65537)
  assert_eq(drv_find_batch_for(65536, 65537, 65536), 65535)
  assert_eq(drv_find_batch_for(65534, 65537, 65536), 65534)
  // Two units per batch.
  assert_eq(drv_batch_start(49999, 100000, 50000), 99998)
  assert_eq(drv_find_batch_for(99999, 100000, 50000), 49999)
  assert_eq(drv_find_batch_for(99998, 100000, 50000), 49999)
  assert_eq(drv_find_batch_for(99997, 100000, 50000), 49998)
  // 18 units over 8 workers: starts 0 2 4 6 9 11 13 15 (end 18).
  let starts = [0, 2, 4, 6, 9, 11, 13, 15, 18]
  let mut b = 0
  while b <= 8 {
    assert_eq(drv_batch_start(b, 18, 8), starts[b])
    b = b + 1
  }
  let mut u = 0
  while u < 18 {
    let k = drv_find_batch_for(u, 18, 8)
    assert_true(drv_batch_start(k, 18, 8) <= u && u < drv_batch_start(k + 1, 18, 8), "18 / 8 unit " + u.to_string())
    u = u + 1
  }
  assert_eq(drv_find_batch_for(0, 1, 1), 0)
  assert_eq(drv_find_batch_for(5, 6, 1), 0)
}

///|
test "cas_lru_eviction_to_80pct_watermark" {
  let idx_text = "k1\t400\t100\nk2\t400\t200\nk3\t300\t300\n"
  let entries = cas_parse_index(idx_text)
  assert_eq(entries.length(), 3)
  // Adding k4 (200 bytes) brings total to 1300 > 1000 -> evicts down to <= 800
  // k1 (400) evicted -> 900 > 800 -> k2 (400) evicted -> 500 <= 800
  let res = cas_touch_and_evict(entries, "k4", 200L, 400L, 1000L)
  assert_eq(res.evicted.length(), 2)
  assert_eq(res.evicted[0], "k1")
  assert_eq(res.evicted[1], "k2")
  assert_eq(res.kept.length(), 2)
}

///|
test "cas_linked_exe_name_windows_test_bin_key_matches_path" {
  assert_eq(cas_linked_exe_name(false, "/c/testbin/ab12"), "/c/testbin/ab12")
  assert_eq(cas_linked_exe_name(true, "/c/testbin/ab12"), "/c/testbin/ab12.exe")
  assert_eq(cas_linked_exe_name(true, "C:\\c.d\\ab12"), "C:\\c.d\\ab12.exe")
  assert_eq(cas_linked_exe_name(true, "out.d/app.bin"), "out.d/app.bin")
  assert_eq(cas_linked_exe_name(true, "app.exe"), "app.exe")
  // A Windows test binary's index key (`testbin:<key>`, evicted as
  // `<cache>/testbin/<key>`) names exactly the file the link produced.
  let bkey = "0f3a9c"
  let tb_dir = "C:/cache.d/testbin"
  assert_eq(
    tb_dir + "/" + cas_linked_exe_name(true, bkey),
    cas_linked_exe_name(true, tb_dir + "/" + bkey),
  )
}

///|
test "qbe_codegen_deterministic_and_release_strips_assert" {
  let src =
    #|pub fn main(world : World) -> Int {
    #|  debug_assert(true, "ok")
    #|  io_println(world, "hello")
    #|  0
    #|}
  let pkg = parse_package("test", ["main.pion"], [src])
  let dev1 = emit_qbe_package(pkg, false)
  let dev2 = emit_qbe_package(pkg, false)
  assert_eq(dev1.ssa, dev2.ssa)
  assert_eq(dev1.has_main, true)
  assert_eq(dev1.ssa.contains("pion_debug_assert"), true)
  let rel = emit_qbe_package(pkg, true)
  assert_eq(rel.ssa.contains("pion_debug_assert"), false)
}

///|
test "qbe_double_slot_and_cond_branch_fusion" {
  let src =
    #|pub fn loop_fp(n : Int) -> Double {
    #|  let mut s = 0.0
    #|  let mut i = 0
    #|  while i < n {
    #|    s = s + 1.5
    #|    if s > 10.0 {
    #|      break
    #|    }
    #|    i = i + 1
    #|  }
    #|  s
    #|}
  let pkg = parse_package("test", ["fp.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  // Double slot must initialize with stored (not storel 0) for QBE mem2reg
  assert_eq(res.ssa.contains("stored "), true)
  assert_eq(res.ssa.contains("d_0.0"), true)
  assert_eq(res.ssa.contains("storel "), false)
  // Compare+branch fusion: no extuw in loop_fp
  assert_eq(res.ssa.contains("extuw"), false)
}

///|
test "qbe_borrow_elision_tree_and_arr_elem_and_bce" {
  let src =
    #|pub enum Tree {
    #|  Leaf
    #|  Node(Tree, Tree)
    #|}
    #|pub fn check_tree(t : Tree) -> Int {
    #|  match t {
    #|    Leaf => 1
    #|    Node(l, r) => 1 + check_tree(l) + check_tree(r)
    #|  }
    #|}
    #|pub struct Body {
    #|  mut x : Double
    #|}
    #|pub fn step(bodies : Array[Body]) -> Unit {
    #|  let n = bodies.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    let b = bodies[i]
    #|    b.x = b.x + 1.0
    #|    i = i + 1
    #|  }
    #|}
  let pkg = parse_package("test", ["opt.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  // Zero RC inc anywhere; zero RC dec inside check_tree / step (drop_enum_Tree is emitted before fns)
  assert_eq(res.ssa.contains("pion_rc_inc"), false)
  let fn_part = match t_str_find(res.ssa, "$pion_fn_check_tree") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => res.ssa
  }
  assert_eq(fn_part.contains("pion_rc_dec"), false)
  // Conservative BCE removes pion_panic_oob inside `while i < n` where `n = bodies.length()`
  assert_eq(res.ssa.contains("pion_panic_oob"), false)
}

///|
test "qbe_pow2_signed_div_shift" {
  let src =
    #|pub fn half(x : Int) -> Int {
    #|  x / 2
    #|}
    #|pub fn quarter(x : Int) -> Int {
    #|  x / 4
    #|}
  let pkg = parse_package("test", ["div.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  assert_eq(res.ssa.contains("=w div "), false)
  assert_eq(res.ssa.contains("=w sar "), true)
}

///|
test "sig_file_stub_and_sigs_hash_parity" {
  let s1 =
    #|pub struct Pt { x : Int; mut y : Double }
    #|pub let SCALE : Int = 42
    #|pub fn add_pt(p : Pt, k : Int) -> Int { p.x + k }
  let s2 =
    #|pub fn main(world : World) -> Int {
    #|  let p = Pt::{ x: 1, y: 2.0 }
    #|  io_println(world, add_pt(p, SCALE).to_string())
    #|  0
    #|}
  let prep = match cli_prepare_qbe_units("demo", ["a.pion", "b.pion"], [s1, s2]) {
    Ok(p) => p
    Err(e) => abort(e)
  }
  let f0 = prep.pkg.files[0]
  let f1 = prep.pkg.files[1]
  let sig0 = emit_file_sig_entries(f0)
  let sig1 = emit_file_sig_entries(f1)
  let summary = summarize_file_sigs("demo", [sig0, sig1])
  assert_eq(summary.sigs_hash, prep.sigs_hash)
  assert_eq(summary.has_main, true)
  assert_eq(summary.const_units.length(), 1)
  assert_eq(summary.const_units[0], 0)
  let stub0 = emit_file_stub(f0)
  let spr = parse_source("a.pion", stub0)
  assert_eq(spr.diagnostics.length(), 0)
}

///|
test "qbe_map_try_get_match_fusion_and_alloc_uninit" {
  let src =
    #|pub enum Tree {
    #|  Leaf
    #|  Node(Tree, Tree)
    #|}
    #|pub fn make_node(l : Tree, r : Tree) -> Tree {
    #|  Node(l, r)
    #|}
    #|pub fn lookup_int(m : Map[String, Int], k : String) -> Int {
    #|  match m.get(k) {
    #|    Some(v) => v + 1
    #|    None => 0
    #|  }
    #|}
    #|pub fn lookup_rev(m : Map[String, Int], k : String) -> Int {
    #|  match m.get(k) {
    #|    None => -1
    #|    Some(v) => v
    #|  }
    #|}
  let pkg = parse_package("test", ["p3c.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  // Node(l, r) must use $pion_alloc_uninit (not $pion_alloc)
  assert_eq(res.ssa.contains("$pion_alloc_uninit("), true)
  assert_eq(res.ssa.contains("$pion_alloc("), false)
  // Fused match m.get(k) must emit $pion_map_try_get, never $pion_map_has, and zero Some allocation / RC in lookup_*
  assert_eq(res.ssa.contains("$pion_map_try_get("), true)
  assert_eq(res.ssa.contains("$pion_map_has("), false)
  let lookup_part = match t_str_find(res.ssa, "$pion_fn_lookup_int") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => res.ssa
  }
  assert_eq(lookup_part.contains("$pion_alloc"), false)
  assert_eq(lookup_part.contains("pion_rc_inc"), false)
  assert_eq(lookup_part.contains("pion_rc_dec"), false)
}

///|
test "qbe_p4b_int32_w_regs_and_double_mul2_add" {
  let src =
    #|pub fn sum_int(n : Int) -> Int {
    #|  let mut acc = 0
    #|  let mut i = 0
    #|  while i < n {
    #|    acc = acc + (i * 3 - 1)
    #|    i = i + 1
    #|  }
    #|  acc
    #|}
    #|pub fn double_two(x : Double, y : Double) -> Double {
    #|  2.0 * x + y * 2.0
    #|}
  let pkg = parse_package("test", ["p4b.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  // Native 32-bit w ABI & local slots, zero extsw in pure Int arithmetic/loops
  assert_eq(res.ssa.contains("function w $pion_fn_sum_int(w %p0)"), true)
  assert_eq(res.ssa.contains("alloc4 4"), true)
  assert_eq(res.ssa.contains("storew "), true)
  assert_eq(res.ssa.contains("=w loadsw "), true)
  assert_eq(res.ssa.contains("extsw"), false)
  // IEEE-754 exact `2.0 * x -> x + x` and `y * 2.0 -> y + y`
  let fn_dbl = match t_str_find(res.ssa, "$pion_fn_double_two") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => res.ssa
  }
  assert_eq(fn_dbl.contains("=d mul "), false)
  assert_eq(fn_dbl.contains("=d add "), true)
}

///|
test "qbe_p4b_loop_invariant_readonly_struct_field_hoist" {
  let src =
    #|pub struct Body {
    #|  mut x : Double
    #|  mut vx : Double
    #|  mass : Double
    #|}
    #|pub fn advance_like(bodies : Array[Body], dt : Double) -> Unit {
    #|  let n = bodies.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    let b = bodies[i]
    #|    let mut j = i + 1
    #|    while j < n {
    #|      let b2 = bodies[j]
    #|      let dx = b.x - b2.x
    #|      let d = math_sqrt(dx * dx)
    #|      let mag = dt / d
    #|      b.vx = b.vx - dx * b2.mass * mag
    #|      b2.vx = b2.vx + dx * b.mass * mag
    #|      j = j + 1
    #|    }
    #|    i = i + 1
    #|  }
    #|}
  let pkg = parse_package("test", ["hoist.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  // Locate the inner loop (@wh_pinit_...) and verify b.x / b.mass are hoisted before it,
  // and b.vx is scalar-promoted into a local slot with alias guard (@wh_pb_, @wh_pbail_, @wh_pwb_)
  let fn_adv = match t_str_find(res.ssa, "$pion_fn_advance_like") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => res.ssa
  }
  let outer_body = match t_str_find(fn_adv, "\n@wh_b_") {
    Some(idx) => t_str_from(fn_adv, idx + 7)
    None => ""
  }
  let inner_pinit = match t_str_find(outer_body, "\n@wh_pinit_") {
    Some(idx) => idx
    None => 0
  }
  assert_eq(inner_pinit > 0, true)
  let pre_inner = t_str_to(outer_body, inner_pinit)
  let inner_all = t_str_from(outer_body, inner_pinit)
  // Both b.x and b.mass must be hoisted into pre_inner (exactly 2 `=d loadd ` before inner @wh_pinit_)
  let mut pre_loads = 0
  let mut ppos = 0
  while ppos < pre_inner.length() {
    let tail = t_str_from(pre_inner, ppos)
    match t_str_find(tail, "=d loadd ") {
      Some(off) => {
        pre_loads = pre_loads + 1
        ppos = ppos + off + 9
      }
      None => break
    }
  }
  assert_eq(pre_loads, 2)
  assert_eq(inner_all.contains("@wh_pb_"), true)
  assert_eq(inner_all.contains("@wh_pbail_"), true)
  assert_eq(inner_all.contains("@wh_pwb_"), true)
  assert_eq(inner_all.contains("=w ceql "), true)
}

///|
test "qbe_p4d_array_int_loadl_and_block_immut_field_cse" {
  let src =
    #|pub struct Particle {
    #|  mut vx : Double
    #|  mut vy : Double
    #|  mut vz : Double
    #|  mass : Double
    #|}
    #|pub fn read_int_elem(arr : Array[Int], i : Int) -> Int {
    #|  arr[i]
    #|}
    #|pub fn triple_mass(a : Particle, b : Particle) -> Unit {
    #|  a.vx = b.mass
    #|  a.vy = b.mass
    #|  a.vz = b.mass
    #|}
  let pkg = parse_package("test", ["p4d.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_arr = match t_str_find(res.ssa, "$pion_fn_read_int_elem") {
    Some(idx) => {
      let rest = t_str_from(res.ssa, idx)
      match t_str_find(rest, "\n}\n") {
        Some(e) => t_str_to(rest, e)
        None => rest
      }
    }
    None => ""
  }
  // Compact 4-byte Array[Int] element load uses `=l shl ..., 2` + `=w loadsw` (never 8-byte `=l loadl`)
  let after_shl = match t_str_find(fn_arr, "=l shl ") {
    Some(idx) => t_str_from(fn_arr, idx)
    None => ""
  }
  assert_eq(after_shl.contains(", 2\n"), true)
  assert_eq(after_shl.contains("=w loadsw "), true)
  assert_eq(after_shl.contains("=l loadl "), false)
  // Immutable primitive struct field `b.mass` loaded once across 3 reads in same basic block
  let fn_mass = match t_str_find(res.ssa, "$pion_fn_triple_mass") {
    Some(idx) => {
      let rest = t_str_from(res.ssa, idx)
      match t_str_find(rest, "\n}\n") {
        Some(e) => t_str_to(rest, e)
        None => rest
      }
    }
    None => ""
  }
  let mut dloads = 0
  let mut pos = 0
  while pos < fn_mass.length() {
    let tail = t_str_from(fn_mass, pos)
    match t_str_find(tail, "=d loadd ") {
      Some(off) => {
        dloads = dloads + 1
        pos = pos + off + 9
      }
      None => break
    }
  }
  assert_eq(dloads, 1)
}

///|
test "qbe_p5b_guarded_bottom_tested_loop_rotation" {
  let src =
    #|pub fn count_even(n : Int) -> Int {
    #|  let mut i = 0
    #|  let mut s = 0
    #|  while i < n {
    #|    i = i + 1
    #|    if (i & 1) == 1 {
    #|      continue
    #|    }
    #|    s = s + i
    #|  }
    #|  s
    #|}
  let pkg = parse_package("test", ["rot.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_count_even") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  let b_pos = match t_str_find(fn_s, "\n@wh_b_") {
    Some(idx) => idx
    None => -1
  }
  let c_pos = match t_str_find(fn_s, "\n@wh_c_") {
    Some(idx) => idx
    None => -1
  }
  // Bottom-tested: @wh_b_ appears before @wh_c_
  assert_eq(b_pos > 0, true)
  assert_eq(c_pos > b_pos, true)
}

///|
test "qbe_p5b_preloop_bce_versioning_and_extsw_reuse" {
  let src =
    #|pub fn copy_rev_shift(
    #|  n : Int,
    #|  k : Int,
    #|  k2 : Int,
    #|  r : Int,
    #|  perm : Array[Int],
    #|  perm1 : Array[Int],
    #|) -> Unit {
    #|  let mut ci = 0
    #|  while ci < n {
    #|    perm[ci] = perm1[ci]
    #|    ci = ci + 1
    #|  }
    #|  let mut fi = 0
    #|  while fi < k2 {
    #|    let tmp = perm[fi]
    #|    perm[fi] = perm[k - fi]
    #|    perm[k - fi] = tmp
    #|    fi = fi + 1
    #|  }
    #|  let mut si = 0
    #|  while si < r {
    #|    perm1[si] = perm1[si + 1]
    #|    si = si + 1
    #|  }
    #|}
  let pkg = parse_package("test", ["bce_v.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_copy_rev_shift") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  // All 3 loops must be versioned with @wh_vchk_ / @wh_fast_ / @wh_slow_
  let mut fast_count = 0
  let mut pos = 0
  while pos < fn_s.length() {
    let tail = t_str_from(fn_s, pos)
    match t_str_find(tail, "\n@wh_fast_") {
      Some(f_off) => {
        let after_fast = t_str_from(tail, f_off + 1)
        let slow_off = match t_str_find(after_fast, "\n@wh_slow_") {
          Some(s_off) => s_off
          None => after_fast.length()
        }
        let fast_region = t_str_to(after_fast, slow_off)
        // Fast region must have zero pion_panic_oob
        assert_eq(fast_region.contains("pion_panic_oob"), false)
        // First loop (`perm[ci] = perm1[ci]`): compact 4-byte loadsw + storew, zero redundant value extsw
        if fast_count == 0 {
          assert_eq(fast_region.contains("=w loadsw "), true)
          assert_eq(fast_region.contains("storew "), true)
          // Only index ci needs 2 extsw (for perm1[ci] / perm[ci] index); value stays in w (0 value extsw)
          let mut ext_cnt = 0
          let mut ep = 0
          while ep < fast_region.length() {
            let et = t_str_from(fast_region, ep)
            match t_str_find(et, "=l extsw ") {
              Some(eo) => {
                ext_cnt = ext_cnt + 1
                ep = ep + eo + 9
              }
              None => break
            }
          }
          // 2 index extsw (ci for perm[ci], ci for perm1[ci]), 0 value extsw (would be 3 without Opt 5)
          assert_eq(ext_cnt, 2)
        }
        fast_count = fast_count + 1
        pos = pos + f_off + 10
      }
      None => break
    }
  }
  assert_eq(fast_count, 3)
  // Slow path still retains pion_panic_oob for safety
  assert_eq(fn_s.contains("pion_panic_oob"), true)
}

///|
test "qbe_p5b_loop_carried_square_reuse" {
  let src =
    #|pub fn mandel_iter(cr : Double, ci : Double) -> Bool {
    #|  let mut zr = 0.0
    #|  let mut zi = 0.0
    #|  let mut escaped = false
    #|  let mut iter = 0
    #|  while iter < 50 {
    #|    let tr = zr * zr - zi * zi + cr
    #|    let ti = 2.0 * zr * zi + ci
    #|    zr = tr
    #|    zi = ti
    #|    if zr * zr + zi * zi > 4.0 {
    #|      escaped = true
    #|      break
    #|    }
    #|    iter = iter + 1
    #|  }
    #|  escaped
    #|}
  let pkg = parse_package("test", ["sq.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_mandel_iter") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  assert_eq(fn_s.contains("@wh_sqi_"), true)
  let body_part = match t_str_find(fn_s, "\n@wh_b_") {
    Some(idx) => t_str_from(fn_s, idx)
    None => ""
  }
  let mut mul_cnt = 0
  let mut pos = 0
  while pos < body_part.length() {
    let tail = t_str_from(body_part, pos)
    match t_str_find(tail, "=d mul ") {
      Some(off) => {
        mul_cnt = mul_cnt + 1
        pos = pos + off + 7
      }
      None => break
    }
  }
  // Only 3 fmul inside loop body (ti = (zr+zr)*zi, new zr*zr, new zi*zi), down from 5
  assert_eq(mul_cnt, 3)
}

///|
test "qbe_p5b_alias_guarded_struct_promotion_and_bailout" {
  let src =
    #|pub struct Acc {
    #|  mut v : Double
    #|  w : Double
    #|}
    #|pub fn pair_update(arr : Array[Acc]) -> Double {
    #|  let n = arr.length()
    #|  let b = arr[0]
    #|  let mut j = 0
    #|  while j < n {
    #|    let b2 = arr[j]
    #|    b.v = b.v + b2.w
    #|    b2.v = b2.v + b.w
    #|    j = j + 1
    #|  }
    #|  b.v
    #|}
  let pkg = parse_package("test", ["alias_prom.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_pair_update") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  assert_eq(fn_s.contains("@wh_pinit_"), true)
  assert_eq(fn_s.contains("@wh_pb_"), true)
  assert_eq(fn_s.contains("=w ceql "), true)
  assert_eq(fn_s.contains("@wh_pbail_"), true)
  assert_eq(fn_s.contains("@wh_pslow_"), true)
  assert_eq(fn_s.contains("@wh_pwb_"), true)
}

///|
test "qbe_p5p_sq_reuse_dead_var_reorder" {
  let src =
    #|pub fn mandel_reorder(cr : Double, ci : Double) -> Bool {
    #|  let mut zr = 0.0
    #|  let mut zi = 0.0
    #|  let mut escaped = false
    #|  let mut iter = 0
    #|  while iter < 50 {
    #|    let tr = zr * zr - zi * zi + cr
    #|    let ti = 2.0 * zr * zi + ci
    #|    zr = tr
    #|    zi = ti
    #|    if zr * zr + zi * zi > 4.0 {
    #|      escaped = true
    #|      break
    #|    }
    #|    iter = iter + 1
    #|  }
    #|  escaped
    #|}
  let pkg = parse_package("test", ["sq_reorder.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_mandel_reorder") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  let body_part = match t_str_find(fn_s, "\n@wh_b_") {
    Some(idx) => t_str_from(fn_s, idx)
    None => ""
  }
  // `ti = 2.0 * zr * zi + ci` (`=d mul`) must be emitted before `tr = sq_zr - sq_zi + cr` (`=d sub`)
  let mul_idx = match t_str_find(body_part, "=d mul ") {
    Some(i) => i
    None => -1
  }
  let sub_idx = match t_str_find(body_part, "=d sub ") {
    Some(i) => i
    None => -1
  }
  assert_eq(mul_idx >= 0, true)
  assert_eq(sub_idx >= 0, true)
  assert_eq(mul_idx < sub_idx, true)
}

///|
test "qbe_p5p_even_int_div2_sar" {
  let src =
    #|pub fn eval_even(ij : Int) -> Int {
    #|  let a = (ij * (ij + 1)) / 2
    #|  let b = ((ij - 1) * ij) / 2
    #|  let c = (-2 * -1) / 2
    #|  let d = (-10 * -9) / 2
    #|  let e = (ij << 1) / 2
    #|  let f = (2 * ij + 4) / 2
    #|  a + b + c + d + e + f
    #|}
    #|pub fn eval_general(x : Int) -> Int {
    #|  x / 2
    #|}
  let pkg = parse_package("test", ["even_div2.pion"], [src])
  let res = emit_qbe_package(pkg, true)
  let even_start = match t_str_find(res.ssa, "$pion_fn_eval_even") {
    Some(idx) => idx
    None => 0
  }
  let gen_start = match t_str_find(res.ssa, "$pion_fn_eval_general") {
    Some(idx) => idx
    None => res.ssa.length()
  }
  let even_fn = t_str_slice(res.ssa, even_start, gen_start)
  let gen_fn = t_str_from(res.ssa, gen_start)
  // All 6 even divisions emit direct `=w sar ..., 1` with zero `=w shr ..., 31` sign fixup
  assert_eq(even_fn.contains("=w sar "), true)
  assert_eq(even_fn.contains("=w shr "), false)
  // General unknown-parity x / 2 retains `=w shr ..., 31` sign fixup
  assert_eq(gen_fn.contains("=w shr "), true)
  assert_eq(gen_fn.contains("=w sar "), true)
}

///|
test "qbe_p5p_local_immut_w_to_l_ext_prop" {
  let src =
    #|pub fn rev_swap(perm : Array[Int], k : Int) -> Unit {
    #|  let n = perm.length()
    #|  if k >= n {
    #|    return
    #|  }
    #|  let mut fi = 0
    #|  while fi < k {
    #|    let tmp = perm[fi]
    #|    perm[fi] = perm[k - fi]
    #|    perm[k - fi] = tmp
    #|    fi = fi + 1
    #|  }
    #|}
  // Keep exercising scalar index extension when the stores do more than swap.
  let scalar_src = src.replace("= tmp", "= tmp + 1")
  let pkg = parse_package("test", ["w2l_local.pion"], [scalar_src])
  let res = emit_qbe_package(pkg, true)
  let fn_s = match t_str_find(res.ssa, "$pion_fn_rev_swap") {
    Some(idx) => t_str_from(res.ssa, idx)
    None => ""
  }
  let fast_start = match t_str_find(fn_s, "\n@wh_fast_") {
    Some(idx) => idx
    None => 0
  }
  let after_fast = t_str_from(fn_s, fast_start + 1)
  let slow_off = match t_str_find(after_fast, "\n@wh_slow_") {
    Some(idx) => idx
    None => after_fast.length()
  }
  let fast_region = t_str_to(after_fast, slow_off)
  assert_eq(fast_region.contains("pion_panic_oob"), false)
  let mut ext_cnt = 0
  let mut ep = 0
  while ep < fast_region.length() {
    let et = t_str_from(fast_region, ep)
    match t_str_find(et, "=l extsw ") {
      Some(eo) => {
        ext_cnt = ext_cnt + 1
        ep = ep + eo + 9
      }
      None => break
    }
  }
  // Only 4 index extsw (perm[fi], perm[fi], perm[k-fi], perm[k-fi]); 0 value extsw for `tmp` or `perm[k-fi]`
  assert_eq(ext_cnt, 4)
  assert_eq(fast_region.contains("@exchange_"), false)

  let cr = check_source_files_full("test", ["exchange.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let arm = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "arm64_apple")
  assert_eq(arm.ssa.contains("@exchange_done_"), false)
  let exchange = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "amd64_sysv")
  assert_eq(exchange.ssa.contains(" =l phi @wh_fast_"), true)
  assert_eq(exchange.ssa.contains("@exchange_done_"), true)
  let loop_start = match t_str_find(exchange.ssa, "\n@exchange_") {
    Some(pos) => pos
    None => 0
  }
  let tail = t_str_from(exchange.ssa, loop_start + 1)
  let loop_end = match t_str_find(tail, "\n@exchange_done_") {
    Some(pos) => pos
    None => 0
  }
  let hot = t_str_to(tail, loop_end)
  assert_eq(hot.contains("=l extsw "), false)
  assert_eq(hot.contains("pion_panic_oob"), false)
  assert_eq(hot.contains("storew "), true)
  assert_eq(t_str_from(tail, loop_end).contains("pion_panic_oob"), true)
}

///|
fn t_guarded_exchange_ssa(src : String, release : Bool, target : String) -> String {
  let cr = check_source_files_full("test", ["exchange.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  emit_qbe_package_with_tc_target(cr.pkg, cr.tc, release, target).ssa
}

///|
test "qbe_amd64_guarded_exchange_scope" {
  let src =
    #|pub fn rev(perm : Array[Int], other : Array[Int], k : Int, st : Int) -> Int {
    #|  let n = perm.length()
    #|  if k >= n || k >= other.length() {
    #|    return 0
    #|  }
    #|  let mut fi = 0
    #|  while fi < k {
    #|    let tmp = perm[fi]
    #|    perm[fi] = perm[k - fi]
    #|    perm[k - fi] = tmp
    #|    fi = fi + 1
    #|  }
    #|  fi
    #|}
  let hit = t_guarded_exchange_ssa(src, true, "amd64_sysv")
  assert_eq(hit.contains("@exchange_done_"), true)
  // The exit writes the bound back to the induction slot before @wh_e.
  let done = match t_str_find(hit, "\n@exchange_done_") {
    Some(pos) => t_str_from(hit, pos + 1)
    None => ""
  }
  let done_end = match t_str_find(done, "\n@") {
    Some(pos) => pos
    None => done.length()
  }
  let done_blk = t_str_to(done, done_end)
  assert_eq(done_blk.contains("storew "), true)
  assert_eq(done_blk.contains("jmp @wh_e_"), true)
  // Other targets and debug builds keep the indexed loop.
  for target in ["arm64_apple", "arm64", "rv64", "amd64_win", "amd64_apple", ""] {
    assert_eq(t_guarded_exchange_ssa(src, true, target).contains("@exchange_"), false)
  }
  assert_eq(t_guarded_exchange_ssa(src, false, "amd64_sysv").contains("@exchange_"), false)
  // Shapes outside the recognised exchange keep the indexed loop.
  let variants = [
    // extra loop condition
    src.replace("while fi < k {", "while fi < k && fi < 100 {"),
    // constant step other than one
    src.replace("fi = fi + 1", "fi = fi + 2"),
    // variable step
    src.replace("fi = fi + 1", "fi = fi + st"),
    // the temporary shadows the axis
    src.replace("let tmp = perm[fi]", "let k = perm[fi]").replace("= tmp", "= k"),
    // the mirror element comes from a different array
    src.replace("perm[fi] = perm[k - fi]", "perm[fi] = other[k - fi]"),
    // the second store writes a different value
    src.replace("= tmp", "= tmp + 1"),
    // left and right stores in the other order
    src.replace("perm[fi] = perm[k - fi]\n    perm[k - fi] = tmp", "perm[k - fi] = tmp\n    perm[fi] = perm[k - fi]"),
  ]
  for v in variants {
    assert_not_eq(v, src)
    assert_eq(t_guarded_exchange_ssa(v, true, "amd64_sysv").contains("@exchange_"), false)
  }
}

///|
test "p6b_cas_compiler_fingerprint_invalidates_keys" {
  let fp1 = cas_compiler_fp(1000L, 2000L, "")
  let fp2 = cas_compiler_fp(1001L, 2000L, "")
  let fp3 = cas_compiler_fp(1000L, 2000L, "salt-a")
  assert_not_eq(fp1, fp2)
  assert_not_eq(fp1, fp3)
  let k1 = cas_compute_key("p", ["a.pion"], ["pub fn f() -> Int { 1 }"], [], "arm64_apple", false, fp1)
  let k2 = cas_compute_key("p", ["a.pion"], ["pub fn f() -> Int { 1 }"], [], "arm64_apple", false, fp2)
  assert_not_eq(k1, k2)
  let u1 = cas_compute_unit_key("p", 0, "a.pion", "h1", "s1", "arm64_apple", false, fp1)
  let u2 = cas_compute_unit_key("p", 0, "a.pion", "h1", "s1", "arm64_apple", false, fp3)
  assert_not_eq(u1, u2)
}

///|
test "p6b_multi_pkg_qbe_mangling_and_test_runner_emit" {
  let math_src =
    #|pub let BASE : Int = 10
    #|pub fn add(a : Int, b : Int) -> Int { a + b + BASE }
  let math_cr = check_source_files_with_imports("math", ["math.pion"], [math_src], [], true)
  assert_eq(math_cr.diagnostics.length(), 0)
  let math_qbe = emit_qbe_package_multi(math_cr.pkg, math_cr.tc, false, false, [])
  assert_eq(math_qbe.ssa.contains("export function w $pion_pkg_math_fn_add("), true)
  assert_eq(math_qbe.ssa.contains("export function $pion_pkg_math_init_consts()"), true)
  assert_eq(math_qbe.ssa.contains("export data $pion_pkg_math_const_BASE"), true)
  assert_eq(math_qbe.has_main, false)

  let app_src =
    #|import "math"
    #|pub fn main() -> Int { math::add(1, 2) }
    #|test "adds" { debug_assert(math::add(1, 2) == 13, "sum") }
  let imported = [imported_pkg_new("math", math_cr.tc)]
  let app_cr = check_source_files_with_imports("app", ["app.pion"], [app_src], imported, true)
  assert_eq(app_cr.diagnostics.length(), 0)
  let build_qbe = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, true, ["math"])
  assert_eq(build_qbe.ssa.contains("call $pion_pkg_math_init_consts()"), true)
  assert_eq(build_qbe.ssa.contains("call $pion_pkg_math_fn_add("), true)
  assert_eq(build_qbe.ssa.contains("pion_test_fn_0"), false)

  let test_qbe = emit_qbe_test_package(app_cr.pkg, app_cr.tc, ["math"])
  assert_eq(test_qbe.test_names.length(), 1)
  assert_eq(test_qbe.test_names[0], "adds")
  assert_eq(test_qbe.ssa.contains("function $pion_test_fn_0()"), true)
  assert_eq(test_qbe.ssa.contains("pion_debug_assert"), true)
  let rep = format_test_report_json(["a", "b"], [true, false])
  assert_eq(rep, "{\"ok\":false,\"passed\":1,\"failed\":1,\"tests\":[{\"name\":\"a\",\"ok\":true},{\"name\":\"b\",\"ok\":false}]}")
}

///|
test "p6c_stdlib_qbe_codegen_symbols" {
  let src =
    #|pub fn main(world : World) -> Int {
    #|  let s = "  a,b  ".trim()
    #|  let _b1 = s.starts_with("a")
    #|  let _b2 = s.ends_with("b")
    #|  let _b3 = s.contains(",")
    #|  let _i = s.index_of(",")
    #|  let _sp = s.split(",")
    #|  let r = s.replace(",", "-")
    #|  let bs = r.to_bytes()
    #|  let buf = Bytes::new(2)
    #|  buf[0] = b'x'
    #|  let _c = buf[0]
    #|  let _c2 = bs[0]
    #|  let _n = buf.length()
    #|  let j = buf.slice(0, 1).concat(bs)
    #|  let _t = j.to_string()
    #|  let _m = math_abs(-1.0) + math_floor(1.5) + math_ceil(1.2) + math_sin(0.0) + math_cos(0.0) + math_pow(2.0, 3.0)
    #|  let _w = fs_write_bytes(world, "/tmp/p6c", j)
    #|  let _rb = fs_read_bytes(world, "/tmp/p6c")
    #|  let _ap = fs_append(world, "/tmp/p6c", "!")
    #|  let _mt = fs_mtime_ms(world, "/tmp/p6c")
    #|  let _ec = proc_exec_capture(world, ["echo", "ok"])
    #|  0
    #|}
  let cr = check_source_files_with_imports("p6c_std", ["std.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  assert_eq(ssa.contains("call $pion_str_trim("), true)
  assert_eq(ssa.contains("call $pion_str_starts_with("), true)
  assert_eq(ssa.contains("call $pion_str_ends_with("), true)
  assert_eq(ssa.contains("call $pion_str_contains("), true)
  assert_eq(ssa.contains("call $pion_str_index_of("), true)
  assert_eq(ssa.contains("call $pion_str_split("), true)
  assert_eq(ssa.contains("call $pion_str_replace("), true)
  assert_eq(ssa.contains("call $pion_str_to_bytes("), true)
  assert_eq(ssa.contains("call $pion_bytes_new("), true)
  // Bytes set/get/length are inlined in QBE IR (storeb / loadub / @bytes_oob)
  assert_eq(ssa.contains("storeb "), true)
  assert_eq(ssa.contains("loadub "), true)
  assert_eq(ssa.contains("@bytes_oob"), true)
  assert_eq(ssa.contains("call $pion_bytes_slice("), true)
  assert_eq(ssa.contains("call $pion_bytes_concat("), true)
  assert_eq(ssa.contains("call $pion_bytes_to_str("), true)
  assert_eq(ssa.contains("call $pion_math_abs("), true)
  assert_eq(ssa.contains("call $pion_math_floor("), true)
  assert_eq(ssa.contains("call $pion_math_ceil("), true)
  assert_eq(ssa.contains("call $pion_math_sin("), true)
  assert_eq(ssa.contains("call $pion_math_cos("), true)
  assert_eq(ssa.contains("call $pion_math_pow("), true)
  assert_eq(ssa.contains("call $pion_world_fs_write_bytes("), true)
  assert_eq(ssa.contains("call $pion_world_fs_read_bytes("), true)
  assert_eq(ssa.contains("call $pion_world_fs_append("), true)
  assert_eq(ssa.contains("call $pion_world_fs_mtime_ms("), true)
  assert_eq(ssa.contains("call $pion_world_exec_capture("), true)
}

///|
test "p6c_perceus_lite_early_drop_before_subsequent_alloc" {
  let src =
    #|enum Tree {
    #|  Leaf
    #|  Node(Tree, Tree)
    #|}
    #|fn make_tree(d : Int) -> Tree {
    #|  if d <= 0 { Leaf } else { Node(make_tree(d - 1), make_tree(d - 1)) }
    #|}
    #|fn check_tree(t : Tree) -> Int {
    #|  match t {
    #|    Leaf => 1
    #|    Node(l, r) => 1 + check_tree(l) + check_tree(r)
    #|  }
    #|}
    #|pub fn run() -> Int {
    #|  let stretch = make_tree(4)
    #|  let c1 = check_tree(stretch)
    #|  let long_lived = make_tree(3)
    #|  let c2 = check_tree(long_lived)
    #|  c1 + c2
    #|}
  let cr = check_source_files_with_imports("p6c_ed", ["ed.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let fn_start = match t_str_find(ssa, "fn_run(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(fn_start >= 0, true)
  let fn_body = t_str_from(ssa, fn_start)
  // After first check_tree(stretch) and before second make_tree(3), stretch must be
  // early-dropped via pion_rc_dec + slot zeroing (`storel 0,`).
  let first_check = match t_str_find(fn_body, "fn_check_tree(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(first_check >= 0, true)
  let after_first_check = t_str_from(fn_body, first_check)
  let second_make = match t_str_find(after_first_check, "fn_make_tree(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(second_make >= 0, true)
  let between = t_str_to(after_first_check, second_make)
  assert_eq(between.contains("call $pion_rc_dec("), true)
  assert_eq(between.contains("storel 0, "), true)
}

///|
test "p7a_ergonomics_qbe_codegen_and_bce" {
  let src =
    "fn get_s(ok : Bool) -> Result[String, String] {\n" +
    "  if ok { Ok(\" hello \") } else { Err(\"bad\") }\n" +
    "}\n" +
    "fn try_res(ok : Bool) -> Result[Int, String] {\n" +
    "  let t = get_s(ok)?.trim()\n" +
    "  Ok(t.length())\n" +
    "}\n" +
    "fn try_opt(o : Option[Int]) -> Option[Int] {\n" +
    "  let v = o?\n" +
    "  Some(v * 2)\n" +
    "}\n" +
    "fn sum_arr(a : Array[Int]) -> Int {\n" +
    "  let mut acc = 0\n" +
    "  for x in a {\n" +
    "    acc = acc + x\n" +
    "  }\n" +
    "  acc\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let mut s = 0\n" +
    "  for i in 0..10 {\n" +
    "    if i == 2 { continue }\n" +
    "    s = s + i\n" +
    "  }\n" +
    "  let a : Array[Int] = [3, 1, 2]\n" +
    "  a.sort()\n" +
    "  a.reverse()\n" +
    "  let total = sum_arr(a)\n" +
    "  a.clear()\n" +
    "  let ws : Array[String] = [\"b\", \"a\"]\n" +
    "  ws.sort()\n" +
    "  let j = ws.join(\"-\")\n" +
    "  let d = 2.5\n" +
    "  let msg = \"j=\\{j}, t=\\{total}, d=\\{d}, ds=\\{d.to_string()}\"\n" +
    "  let m : Map[String, Int] = Map::new()\n" +
    "  m.set(\"x\", 1)\n" +
    "  let _h = m.contains(\"x\")\n" +
    "  let _ks = m.keys()\n" +
    "  m.remove(\"x\")\n" +
    "  let _r = try_res(true)\n" +
    "  let _o = try_opt(Some(3))\n" +
    "  s + msg.length()\n" +
    "}\n"
  let cr = check_source_files_with_imports("p7a_cg", ["cg.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  assert_eq(ssa.contains("@try_ok"), true)
  assert_eq(ssa.contains("@try_err"), true)
  assert_eq(ssa.contains("@try_some"), true)
  assert_eq(ssa.contains("@try_none"), true)
  assert_eq(ssa.contains("call $pion_double_to_str("), true)
  assert_eq(ssa.contains("call $pion_arr_sort_int("), true)
  assert_eq(ssa.contains("call $pion_arr_sort_str("), true)
  assert_eq(ssa.contains("call $pion_arr_reverse("), true)
  assert_eq(ssa.contains("call $pion_arr_clear("), true)
  assert_eq(ssa.contains("call $pion_arr_join("), true)
  assert_eq(ssa.contains("call $pion_map_has("), true)
  assert_eq(ssa.contains("call $pion_map_keys("), true)
  assert_eq(ssa.contains("call $pion_map_remove("), true)
  assert_eq(ssa.contains("@forr_s"), true)
  // Verify sum_arr (`for x in a` without continue) triggers BCE (zero pion_panic_oob in sum_arr)
  let sa_start = match t_str_find(ssa, "fn_sum_arr(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(sa_start >= 0, true)
  let sa_rest = t_str_from(ssa, sa_start)
  let sa_end = match t_str_find(sa_rest, "\n}\n") {
    Some(idx) => idx
    None => sa_rest.length()
  }
  let sa_body = t_str_to(sa_rest, sa_end)
  assert_eq(sa_body.contains("pion_panic_oob"), false)
}

///|
test "p8: tuple destructuring, match guards, and generic pair_swap codegen" {
  let src =
    "fn pair_swap[A, B](p : (A, B)) -> (B, A) {\n" +
    "  let (a, b) = p\n" +
    "  (b, a)\n" +
    "}\n" +
    "fn pick(opt : Option[String]) -> Int {\n" +
    "  match opt {\n" +
    "    Some(s) if s.length() > 3 => s.length()\n" +
    "    Some(s) => s.length() + 100\n" +
    "    None => 0\n" +
    "  }\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let (k, _, v) : (String, String, Int) = (\"alpha\", \"dropme\", 9)\n" +
    "  let sw = pair_swap((k, v))\n" +
    "  let first = sw.0\n" +
    "  let second = sw.1\n" +
    "  first + pick(Some(second))\n" +
    "}\n"
  let cr = check_source_files_with_imports("p8_cg", ["p8_cg.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  assert_eq(ssa.contains("@match_guard_ok"), true)
  assert_eq(ssa.contains("@match_guard_fail"), true)
  assert_eq(ssa.contains("call $pion_rc_inc("), true)
  assert_eq(ssa.contains("call $pion_rc_dec("), true)
}

///|
test "p10a: const folding, binary dispatch tree, immut field borrow, inline str/bytes/sb/arr, deep freeze" {
  let src =
    "let OP_0 : Int = 0\n" +
    "let OP_1 : Int = 1\n" +
    "let OP_2 : Int = 2\n" +
    "let OP_3 : Int = 3\n" +
    "let OP_4 : Int = 4\n" +
    "let OP_5 : Int = 5\n" +
    "let OP_NEG : Int = -1\n" +
    "pub val struct Msg {\n" +
    "  id : Int\n" +
    "  body : String\n" +
    "}\n" +
    "struct Lexer {\n" +
    "  src : String\n" +
    "  len : Int\n" +
    "  mut pos : Int\n" +
    "}\n" +
    "fn skip_ws(p : Lexer) -> Unit {\n" +
    "  while p.pos < p.len {\n" +
    "    let ch = p.src.code_unit_at(p.pos)\n" +
    "    if ch == 32 || ch == 10 {\n" +
    "      p.pos = p.pos + 1\n" +
    "    } else {\n" +
    "      break\n" +
    "    }\n" +
    "  }\n" +
    "}\n" +
    "fn dispatch_if(op : Int) -> Int {\n" +
    "  if op == OP_0 { 10 }\n" +
    "  else if op == OP_1 { 20 }\n" +
    "  else if op == OP_2 { 30 }\n" +
    "  else if op == OP_3 { 40 }\n" +
    "  else if op == OP_4 { 50 }\n" +
    "  else if op == OP_5 { 60 }\n" +
    "  else if op == OP_NEG { -1 }\n" +
    "  else { 0 }\n" +
    "}\n" +
    "fn dispatch_match(op : Int) -> Int {\n" +
    "  match op {\n" +
    "    0 => 10\n" +
    "    1 => 20\n" +
    "    2 => 30\n" +
    "    3 => 40\n" +
    "    4 => 50\n" +
    "    5 => 60\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n" +
    "fn fast_ops(b : Bytes, sb : StringBuilder, a : Array[Int]) -> Int {\n" +
    "  let mut i = 0\n" +
    "  while i < 1 {\n" +
    "    sb.write_char('A')\n" +
    "    a.push(42)\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  b[0] = b[0]\n" +
    "  b.length()\n" +
    "}\n" +
    "fn send_msg(ch : Channel[Msg], m : Msg) -> Bool {\n" +
    "  ch.send(m)\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let lx = Lexer::{ src: \"  hi\", len: 4, pos: 0 }\n" +
    "  skip_ws(lx)\n" +
    "  let ch : Channel[Msg] = Channel::new(4)\n" +
    "  let _ = send_msg(ch, Msg::{ id: 1, body: \"hello\" })\n" +
    "  let b = Bytes::new(4)\n" +
    "  let sb = StringBuilder::new()\n" +
    "  let a : Array[Int] = []\n" +
    "  dispatch_if(OP_3) + dispatch_match(2) + fast_ops(b, sb, a)\n" +
    "}\n"
  let cr = check_source_files_with_imports("p10a_cg", ["p10a.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // 1. skip_ws: no pion_str_byte_at, no pion_rc_inc/pion_rc_dec inside skip_ws
  let sw_start = match t_str_find(ssa, "fn_skip_ws(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(sw_start >= 0, true)
  let sw_rest = t_str_from(ssa, sw_start)
  let sw_end = match t_str_find(sw_rest, "\n}\n") {
    Some(idx) => idx
    None => sw_rest.length()
  }
  let sw_body = t_str_to(sw_rest, sw_end)
  assert_eq(sw_body.contains("pion_str_byte_at"), false)
  assert_eq(sw_body.contains("pion_rc_inc"), false)
  assert_eq(sw_body.contains("pion_rc_dec"), false)
  assert_eq(sw_body.contains("loadub"), true)
  // 2. dispatch_if: const folded (no loadsw $pion_const_) and native jtbl jump table
  let di_start = match t_str_find(ssa, "fn_dispatch_if(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(di_start >= 0, true)
  let di_rest = t_str_from(ssa, di_start)
  let di_end = match t_str_find(di_rest, "\n}\n") {
    Some(idx) => idx
    None => di_rest.length()
  }
  let di_body = t_str_to(di_rest, di_end)
  assert_eq(di_body.contains("$pion_const_"), false)
  assert_eq(di_body.contains("jtbl "), true)
  assert_eq(di_body.contains("@sw_arm"), true)
  // 3. dispatch_match: native jtbl jump table
  let dm_start = match t_str_find(ssa, "fn_dispatch_match(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(dm_start >= 0, true)
  let dm_rest = t_str_from(ssa, dm_start)
  let dm_end = match t_str_find(dm_rest, "\n}\n") {
    Some(idx) => idx
    None => dm_rest.length()
  }
  let dm_body = t_str_to(dm_rest, dm_end)
  assert_eq(dm_body.contains("jtbl "), true)
  assert_eq(dm_body.contains("@sw_arm"), true)
  // 4. fast_ops: inline bytes length/get/set, sb ASCII fast path, prim array push fast path
  let fo_start = match t_str_find(ssa, "fn_fast_ops(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(fo_start >= 0, true)
  let fo_rest = t_str_from(ssa, fo_start)
  let fo_end = match t_str_find(fo_rest, "\n}\n") {
    Some(idx) => idx
    None => fo_rest.length()
  }
  let fo_body = t_str_to(fo_rest, fo_end)
  assert_eq(fo_body.contains("pion_bytes_len"), false)
  assert_eq(fo_body.contains("pion_bytes_get"), false)
  assert_eq(fo_body.contains("pion_bytes_set"), false)
  assert_eq(fo_body.contains("@sb_fast"), true)
  assert_eq(fo_body.contains("@ap_fast"), true)
  // 5. deep freeze for Msg (nested String)
  assert_eq(ssa.contains("function $pion_freeze_st_Msg("), true)
  assert_eq(ssa.contains("call $pion_freeze_st_Msg("), true)
}

///|
test "p11b: perceus move, string bce, leaf-loop inline, array hoist budget" {
  let src =
    "struct Entry {\n" +
    "  mut k : String\n" +
    "  v : String\n" +
    "}\n" +
    "enum Val {\n" +
    "  VArr(Array[Entry])\n" +
    "}\n" +
    "struct Scan {\n" +
    "  src : String\n" +
    "  len : Int\n" +
    "  mut pos : Int\n" +
    "}\n" +
    "fn skip_sp(p : Scan) -> Unit {\n" +
    "  while p.pos < p.len {\n" +
    "    let c = p.src.code_unit_at(p.pos)\n" +
    "    if c == 32 || c == 9 {\n" +
    "      p.pos = p.pos + 1\n" +
    "    } else {\n" +
    "      break\n" +
    "    }\n" +
    "  }\n" +
    "}\n" +
    "fn build_obj(s : String) -> Val {\n" +
    "  let entries : Array[Entry] = []\n" +
    "  let mut i = 0\n" +
    "  while i < 1 {\n" +
    "    let k = s.slice(0, 1)\n" +
    "    let v = s.slice(1, 2)\n" +
    "    entries.push(Entry::{ k: k, v: v })\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  return VArr(entries)\n" +
    "}\n" +
    "fn scan_str(s : String) -> Int {\n" +
    "  let n = s.length()\n" +
    "  let mut i = 0\n" +
    "  while i < n && s.code_unit_at(i) != 10 {\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  i\n" +
    "}\n" +
    "fn scan_slice(s : String, start : Int, end : Int) -> Int {\n" +
    "  let mut p = start\n" +
    "  let mut acc = 0\n" +
    "  while p < end && s.code_unit_at(p) != 32 {\n" +
    "    acc = acc + s.code_unit_at(p)\n" +
    "    p = p + 1\n" +
    "  }\n" +
    "  acc\n" +
    "}\n" +
    "fn use_skip(p : Scan) -> Int {\n" +
    "  let mut k = 0\n" +
    "  while k < 1 {\n" +
    "    skip_sp(p)\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  p.pos\n" +
    "}\n" +
    "fn helper_call(x : Int) -> Int {\n" +
    "  let mut r = x\n" +
    "  let mut k = 0\n" +
    "  while k < 3 {\n" +
    "    r = r + k\n" +
    "    k = k + 1\n" +
    "  }\n" +
    "  let mut j = 0\n" +
    "  while j < 3 {\n" +
    "    r = r + j\n" +
    "    j = j + 1\n" +
    "  }\n" +
    "  r\n" +
    "}\n" +
    "fn budget_loop(a : Array[Int], b : Array[Int], c : Array[Int], d : Array[Int], e : Array[Int], n : Int) -> Int {\n" +
    "  let mut i = 0\n" +
    "  let mut s = 0\n" +
    "  while i < n {\n" +
    "    s = s + a[i] + a[i] + b[i] + b[i] + c[i] + c[i]\n" +
    "    if i == 0 {\n" +
    "      s = s + d[i] + e[i] + helper_call(i)\n" +
    "    }\n" +
    "    i = i + 1\n" +
    "  }\n" +
    "  s\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let _ = build_obj(\"ab\")\n" +
    "  let sc = Scan::{ src: \"  x\", len: 3, pos: 0 }\n" +
    "  let a = [1, 2]\n" +
    "  scan_str(\"abc\\n\") + scan_slice(\"abc \", 0, 4) + use_skip(sc) + budget_loop(a, a, a, a, a, 2)\n" +
    "}\n"
  let cr = check_source_files_with_imports("p11b_cg", ["p11b.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // 1. build_obj: owned push fast path + pion_arr_push_owned + zero rc_inc/rc_dec
  let bo_start = match t_str_find(ssa, "fn_build_obj(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(bo_start >= 0, true)
  let bo_rest = t_str_from(ssa, bo_start)
  let bo_end = match t_str_find(bo_rest, "\n}\n") {
    Some(idx) => idx
    None => bo_rest.length()
  }
  let bo_body = t_str_to(bo_rest, bo_end)
  assert_eq(bo_body.contains("@ap_fast"), true)
  assert_eq(bo_body.contains("pion_arr_push_owned"), true)
  assert_eq(bo_body.contains("pion_rc_inc"), false)
  assert_eq(bo_body.contains("pion_rc_dec"), false)
  // 2. scan_str: direct String BCE under `&&` -> zero pion_panic_oob
  let ss_start = match t_str_find(ssa, "fn_scan_str(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(ss_start >= 0, true)
  let ss_rest = t_str_from(ssa, ss_start)
  let ss_end = match t_str_find(ss_rest, "\n}\n") {
    Some(idx) => idx
    None => ss_rest.length()
  }
  let ss_body = t_str_to(ss_rest, ss_end)
  assert_eq(ss_body.contains("pion_panic_oob"), false)
  assert_eq(ss_body.contains("loadub"), true)
  // 3. scan_slice: BCE versioning for String under `&&` -> @wh_vchk + @wh_fast
  let sl_start = match t_str_find(ssa, "fn_scan_slice(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(sl_start >= 0, true)
  let sl_rest = t_str_from(ssa, sl_start)
  let sl_end = match t_str_find(sl_rest, "\n}\n") {
    Some(idx) => idx
    None => sl_rest.length()
  }
  let sl_body = t_str_to(sl_rest, sl_end)
  assert_eq(sl_body.contains("@wh_vchk"), true)
  assert_eq(sl_body.contains("@wh_fast"), true)
  // 4. use_skip: leaf-loop skip_sp inlined (no call $pion_fn_skip_sp)
  let us_start = match t_str_find(ssa, "fn_use_skip(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(us_start >= 0, true)
  let us_rest = t_str_from(ssa, us_start)
  let us_end = match t_str_find(us_rest, "\n}\n") {
    Some(idx) => idx
    None => us_rest.length()
  }
  let us_body = t_str_to(us_rest, us_end)
  assert_eq(us_body.contains("call $pion_fn_skip_sp"), false)
  assert_eq(us_body.contains("loadub"), true)
  // 5. budget_loop: emits cleanly with 5 arrays + call
  assert_eq(ssa.contains("fn_budget_loop("), true)
}

///|
test "p11c: native jtbl for dense int dispatch, sparse fallback, and dense TEnum match" {
  let src =
    "enum Expr {\n" +
    "  ENum(Int)\n" +
    "  EAdd(Int, Int)\n" +
    "  ESub(Int, Int)\n" +
    "  EMul(Int, Int)\n" +
    "  EDiv(Int, Int)\n" +
    "  ENeg(Int)\n" +
    "}\n" +
    "fn dense_int(x : Int) -> Int {\n" +
    "  match x {\n" +
    "    10 => 1\n" +
    "    11 => 2\n" +
    "    12 => 3\n" +
    "    14 => 5\n" +
    "    15 => 6\n" +
    "    16 => 7\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n" +
    "fn sparse_int(x : Int) -> Int {\n" +
    "  match x {\n" +
    "    1 => 1\n" +
    "    100 => 2\n" +
    "    1000 => 3\n" +
    "    10000 => 4\n" +
    "    100000 => 5\n" +
    "    1000000 => 6\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n" +
    "fn eval_enum(e : Expr) -> Int {\n" +
    "  match e {\n" +
    "    ENum(v) => v\n" +
    "    EAdd(a, b) => a + b\n" +
    "    ESub(a, b) => a - b\n" +
    "    EMul(a, b) => a * b\n" +
    "    EDiv(a, b) => a / b\n" +
    "    ENeg(v) => 0 - v\n" +
    "  }\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  dense_int(12) + sparse_int(100) + eval_enum(EAdd(3, 4))\n" +
    "}\n"
  let cr = check_source_files_with_imports("p11c_cg", ["p11c.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // 1. dense_int: shifted jtbl
  let di_start = match t_str_find(ssa, "fn_dense_int(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(di_start >= 0, true)
  let di_rest = t_str_from(ssa, di_start)
  let di_end = match t_str_find(di_rest, "\n}\n") {
    Some(idx) => idx
    None => di_rest.length()
  }
  let di_body = t_str_to(di_rest, di_end)
  assert_eq(di_body.contains("jtbl "), true)
  assert_eq(di_body.contains("=w sub "), true)
  // 2. sparse_int: falls back to balanced binary tree (no jtbl)
  let si_start = match t_str_find(ssa, "fn_sparse_int(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(si_start >= 0, true)
  let si_rest = t_str_from(ssa, si_start)
  let si_end = match t_str_find(si_rest, "\n}\n") {
    Some(idx) => idx
    None => si_rest.length()
  }
  let si_body = t_str_to(si_rest, si_end)
  assert_eq(si_body.contains("jtbl "), false)
  assert_eq(si_body.contains("csltw"), true)
  // 3. eval_enum: dense TEnum match emits jtbl
  let ee_start = match t_str_find(ssa, "fn_eval_enum(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(ee_start >= 0, true)
  let ee_rest = t_str_from(ssa, ee_start)
  let ee_end = match t_str_find(ee_rest, "\n}\n") {
    Some(idx) => idx
    None => ee_rest.length()
  }
  let ee_body = t_str_to(ee_rest, ee_end)
  assert_eq(ee_body.contains("jtbl "), true)
  assert_eq(ee_body.contains("@em_arm"), true)
}

///|
test "p11c: same-index overwrite OOB dedup and pure EIf rhs array borrow" {
  let src =
    "fn cmp_overwrite(st : Array[Int], sp : Int) -> Unit {\n" +
    "  st[sp - 1] = if st[sp - 1] < st[sp] { 1 } else { 0 }\n" +
    "}\n" +
    "fn add_overwrite(st : Array[Int], sp : Int) -> Unit {\n" +
    "  st[sp - 1] = st[sp - 1] + st[sp]\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let st = [3, 5]\n" +
    "  add_overwrite(st, 1)\n" +
    "  cmp_overwrite(st, 1)\n" +
    "  st[0]\n" +
    "}\n"
  let cr = check_source_files_with_imports("p11c_ow", ["p11c_ow.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // cmp_overwrite: zero rc_inc/rc_dec (pure EIf borrows st) and only 2 OOB checks (not 3)
  let co_start = match t_str_find(ssa, "fn_cmp_overwrite(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(co_start >= 0, true)
  let co_rest = t_str_from(ssa, co_start)
  let co_end = match t_str_find(co_rest, "\n}\n") {
    Some(idx) => idx
    None => co_rest.length()
  }
  let co_body = t_str_to(co_rest, co_end)
  assert_eq(co_body.contains("pion_rc_inc"), false)
  assert_eq(co_body.contains("pion_rc_dec"), false)
  // add_overwrite: only 2 OOB checks (st[sp-1] reused once, st[sp] checked once)
  let ao_start = match t_str_find(ssa, "fn_add_overwrite(") {
    Some(idx) => idx
    None => -1
  }
  assert_eq(ao_start >= 0, true)
  let ao_rest = t_str_from(ssa, ao_start)
  let ao_end = match t_str_find(ao_rest, "\n}\n") {
    Some(idx) => idx
    None => ao_rest.length()
  }
  let ao_body = t_str_to(ao_rest, ao_end)
  let mut oob_cnt = 0
  let mut pos = 0
  while pos < ao_body.length() {
    match t_str_find(t_str_from(ao_body, pos), "pion_panic_oob") {
      Some(off) => {
        oob_cnt = oob_cnt + 1
        pos = pos + off + 12
      }
      None => break
    }
  }
  assert_eq(oob_cnt, 2)
}

///|
test "p12a: extern C FFI and trait monomorphization QBE codegen" {
  let src =
    "extern \"C\" fn c_strlen(s : Ptr) -> Int64 = \"strlen\"\n" +
    "extern \"C\" fn c_free(p : Ptr) -> Unit = \"free\"\n" +
    "pub trait Show {\n" +
    "  show(self : Self) -> String\n" +
    "}\n" +
    "pub struct User {\n" +
    "  id : Int\n" +
    "  name : String\n" +
    "}\n" +
    "impl Show for Int {\n" +
    "  fn show(self : Int) -> String { self.to_string() }\n" +
    "}\n" +
    "impl Show for User {\n" +
    "  fn show(self : User) -> String { self.name }\n" +
    "}\n" +
    "fn format_pair[A : Show, B : Show](a : A, b : B) -> String {\n" +
    "  a.show() + \":\" + b.show()\n" +
    "}\n" +
    "pub fn main() -> Int {\n" +
    "  let u = User::{ id: 1, name: \"ada\" }\n" +
    "  let s = format_pair(42, u)\n" +
    "  let n = c_strlen(s.as_cstr())\n" +
    "  let p = ptr_null()\n" +
    "  if ptr_is_null(p) { c_free(p) }\n" +
    "  n.to_int()\n" +
    "}\n"
  let cr = check_source_files_full("p12a_cg", ["p12a_cg.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // Native C symbol call without $pion_fn_ prefix
  assert_eq(ssa.contains("call $strlen("), true)
  assert_eq(ssa.contains("call $free("), true)
  assert_eq(ssa.contains("$pion_fn_c_strlen"), false)
  // Static impl functions (zero vtable)
  assert_eq(ssa.contains("$pion_impl_Show_Int_show"), true)
  assert_eq(ssa.contains("$pion_impl_Show_User_show"), true)
  // Monomorphized generic function calling concrete $pion_impl_ directly
  assert_eq(ssa.contains("$pion_fn_format_pair__mono_Int_0L13_p12a_cg__User"), true)
  assert_eq(ssa.contains("call $pion_impl_Show_Int_show("), true)
  assert_eq(ssa.contains("call $pion_impl_Show_User_show("), true)
}

///|
test "p15: == on a payload-less enum compares variant tags, not pointers" {
  let src =
    #|enum Color {
    #|  Red
    #|  Green
    #|}
    #|pub fn same(a : Color, b : Color) -> Bool {
    #|  a == b
    #|}
  let res = emit_qbe_package(
    parse_package("test", ["enum_eq.pion"], [src]),
    true,
  )
  // The only loads in `same` are the tag words of its two operands.
  assert_true(res.ssa.contains("=l loadl %"), res.ssa)
  let src2 =
    #|enum Color {
    #|  Red
    #|  Green
    #|}
    #|pub fn is_red(a : Color) -> Int {
    #|  if a == Red { 1 } else { 0 }
    #|}
  let res2 = emit_qbe_package(
    parse_package("test", ["enum_eq2.pion"], [src2]),
    true,
  )
  assert_true(res2.ssa.contains("=l loadl %"), res2.ssa)
}

///|
test "p17a: generic == is monomorphized per instantiation (String bytes, enum tags)" {
  let src =
    #|enum Color {
    #|  Red
    #|  Green
    #|}
    #|fn same[T](a : T, b : T) -> Bool {
    #|  a == b
    #|}
    #|fn ident[T](a : T) -> T {
    #|  a
    #|}
    #|fn count_same[U](xs : Array[U], x : U) -> Int {
    #|  let mut n = 0
    #|  for y in xs {
    #|    if same(x, y) {
    #|      n = n + 1
    #|    }
    #|  }
    #|  n
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let x = "a" + "b"
    #|  let c = count_same([x], "ab")
    #|  let n = if same(x, "ab") && same(Red, Red) && same(3, 3) { c } else { 0 }
    #|  io_println(world, ident("k"))
    #|  n
    #|}
  let res = emit_qbe_package(
    parse_package("test", ["generic_eq.pion"], [src]),
    false,
  )
  let ssa = res.ssa
  assert_true(ssa.contains("same__mono_String"), ssa)
  assert_true(ssa.contains("same__mono_0L11_test__Color"), ssa)
  assert_true(ssa.contains("same__mono_Int"), ssa)
  // A generic forwarding its type param to a comparing generic is
  // monomorphized too, so the inner call compares concrete `String`s.
  assert_true(ssa.contains("count_same__mono_String"), ssa)
  // String instantiation compares bytes, never pointers.
  assert_true(ssa.contains("call $pion_str_eq("), ssa)
  // Generic fns without `==` keep the single erased body.
  assert_true(!ssa.contains("ident__mono"), ssa)
}

///|
test "p17a: String parse helpers, Option/Result helpers, expression debug_assert lower to QBE" {
  let src =
    #|pub fn main(world : World) -> Int {
    #|  let a = "42".to_int()
    #|  let b = "7".to_int64()
    #|  let c = "2.5".to_double()
    #|  match a {
    #|    Some(x) => debug_assert(x > 0, "pos")
    #|    None => ()
    #|  }
    #|  let r : Result[Int, String] = Ok(1)
    #|  if a.is_some() && b.is_some() && !c.is_none() && r.is_ok() && !r.is_err() {
    #|    io_println(world, "ok")
    #|  }
    #|  a.unwrap_or(0) + r.unwrap_or(0) + c.unwrap_or(0.0).to_int() + b.unwrap_or(0L).to_int()
    #|}
  let ssa = emit_qbe_package(parse_package("test", ["parse.pion"], [src]), false).ssa
  assert_true(ssa.contains("call $pion_str_to_int("), ssa)
  assert_true(ssa.contains("call $pion_str_to_double("), ssa)
  assert_true(ssa.contains("uwo_hit"), ssa)
  assert_true(ssa.contains("pion_debug_assert"), ssa)
}

///|
test "p17a: storing into a possibly-frozen container deep-freezes the element" {
  let src =
    #|pub val struct Msg {
    #|  id : Int
    #|  body : String
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let q : Mutex[Array[Msg]] = Mutex::new([])
    #|  let nums : Array[Int] = []
    #|  scope(world, fn(s : Scope) -> Unit {
    #|    spawn(s, fn() -> Unit {
    #|      let a = q.lock()
    #|      a.push(Msg::{ id: 1, body: "x" })
    #|      q.unlock()
    #|    })
    #|  })
    #|  nums.push(1)
    #|  0
    #|}
  let ssa = emit_qbe_package(parse_package("test", ["adopt.pion"], [src]), false).ssa
  assert_true(ssa.contains("adopt_fz"), ssa)
  assert_true(ssa.contains("$pion_rc_freeze"), ssa)
}

///|
test "p18: event-loop primitives lower to direct C calls with the World first" {
  let src =
    #|pub fn watch(world : World, pfd : Int, fd : Int) -> Bool {
    #|  poll_ctl(world, pfd, 1, fd, 1)
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let lfd = tcp_listen_reuse(world, "127.0.0.1", 0)
    #|  let pfd = poll_create(world)
    #|  if !tcp_set_nonblock(world, lfd, true) || !poll_ctl(world, pfd, 1, lfd, 3) {
    #|    return 1
    #|  }
    #|  let fds : Array[Int] = []
    #|  let evs : Array[Int] = []
    #|  let buf = StringBuilder()
    #|  let n = poll_wait(world, pfd, fds, evs, 256, 10)
    #|  let c = tcp_accept_nb(world, lfd)
    #|  let r = tcp_read_nb(world, c, buf, 16384)
    #|  let w = tcp_write_nb(world, c, buf.to_string(), r)
    #|  poll_close(world, pfd)
    #|  n + w
    #|}
  let cr = check_source_files_full("p18_cg", ["p18_cg.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  assert_true(ssa.contains("=w call $pion_tcp_listen_reuse(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_create(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_set_nonblock(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_ctl(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_wait(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_accept_nb(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_read_nb(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_write_nb(l "), ssa)
  assert_true(ssa.contains("call $pion_poll_close(l "), ssa)
  // A C `int32_t` Bool result is widened into Pion's 64-bit Bool slot before `ret`.
  let fn_at = p18_find_from(ssa, "$pion_fn_watch(", 0)
  assert_true(fn_at >= 0, ssa)
  let fn_end = p18_find_from(ssa, "\n}", fn_at)
  let call_at = p18_find_from(ssa, "=w call $pion_poll_ctl(", fn_at)
  let ext_at = p18_find_from(ssa, " =l extuw ", call_at)
  assert_true(call_at > fn_at && ext_at > call_at && ext_at < fn_end, ssa)
}

///|
test "p19b: 24B header, null-niche Option[Ref], Bool enum singleton, N-way concat, chained borrow, struct String BCE, sb.length" {
  let src =
    #|pub struct Pair {
    #|  key : String
    #|  value : String
    #|}
    #|pub enum Val {
    #|  VNull
    #|  VBool(Bool)
    #|  VStr(String)
    #|}
    #|pub struct Scanner {
    #|  src : String
    #|  len : Int
    #|  mut pos : Int
    #|}
    #|pub fn lookup(entries : Array[Pair], k : String) -> Option[String] {
    #|  let n = entries.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    if entries[i].key == k {
    #|      return Some(entries[i].value)
    #|    }
    #|    i = i + 1
    #|  }
    #|  None
    #|}
    #|pub fn nested_opt(flag : Int) -> Option[Option[String]] {
    #|  if flag == 0 {
    #|    None
    #|  } else if flag == 1 {
    #|    Some(None)
    #|  } else {
    #|    Some(Some("ok"))
    #|  }
    #|}
    #|pub fn scan_quote(p : Scanner) -> Int {
    #|  let mut i = p.pos
    #|  while i < p.len {
    #|    if p.src.code_unit_at(i) == 34 {
    #|      break
    #|    }
    #|    i = i + 1
    #|  }
    #|  i
    #|}
    #|pub fn build_alert(svc : String, lvl : String, msg : String) -> String {
    #|  "ALERT|" + svc + "|" + lvl + "|" + msg
    #|}
    #|pub fn mk_bools(b : Bool) -> Array[Val] {
    #|  let out : Array[Val] = []
    #|  out.push(VBool(true))
    #|  out.push(VBool(false))
    #|  out.push(VBool(b))
    #|  out
    #|}
    #|pub fn sb_len_and_closure() -> Int {
    #|  let sb = StringBuilder()
    #|  sb.write_string("abc")
    #|  let f = fn(x : Int) -> String {
    #|    if x > 0 {
    #|      return "yes"
    #|    }
    #|    "no"
    #|  }
    #|  sb.length() + f(1).length()
    #|}
  let cr = check_source_files_full("p19b_cg", ["p19b_cg.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // 24B header layout
  assert_true(ssa.contains("_hdr, 24"), ssa)
  assert_true(!ssa.contains("_hdr, 32"), ssa)
  // Null-niche Option[String] in lookup: no pion_alloc_uninit, returns 0 on None
  let lk_s = p18_find_from(ssa, "$pion_fn_lookup(", 0)
  let lk_e = p18_find_from(ssa, "\n}", lk_s)
  assert_true(lk_s >= 0 && lk_e > lk_s, ssa)
  let lk_alloc = p18_find_from(ssa, "$pion_alloc_uninit", lk_s)
  assert_true(lk_alloc < 0 || lk_alloc > lk_e, ssa)
  let lk_ret0 = p18_find_from(ssa, "ret 0", lk_s)
  assert_true(lk_ret0 > lk_s && lk_ret0 < lk_e, ssa)
  // Nested Option[Option[String]] uses boxed outer Option
  assert_true(ssa.contains("$pion_drop_opt_obj"), ssa)
  // Bool enum static immortal singletons
  assert_true(ssa.contains("_VBool_1_hdr"), ssa)
  assert_true(ssa.contains("_VBool_0_hdr"), ssa)
  // N-way string concat flattened to pion_str_concat_n
  assert_true(ssa.contains("$pion_str_concat_n("), ssa)
  // Struct String field BCE versioning in scan_quote
  let sq_s = p18_find_from(ssa, "$pion_fn_scan_quote(", 0)
  let sq_e = p18_find_from(ssa, "\n}", sq_s)
  let sq_fast = p18_find_from(ssa, "@wh_fast", sq_s)
  assert_true(sq_fast > sq_s && sq_fast < sq_e, ssa)
  // Local-only array push skips adopt_fz
  let mb_s = p18_find_from(ssa, "$pion_fn_mk_bools(", 0)
  let mb_e = p18_find_from(ssa, "\n}", mb_s)
  let mb_adopt = p18_find_from(ssa, "adopt_fz", mb_s)
  assert_true(mb_adopt < 0 || mb_adopt > mb_e, ssa)
}

///|
test "p19b: soundness fixes (arr_field UAF, loop unfrozen_local_arrs escape, leading None array lit, generic struct Option mono)" {
  let src =
    #|pub struct Pair {
    #|  key : String
    #|  value : String
    #|}
    #|pub struct OptBox[T] {
    #|  item : Option[T]
    #|}
    #|fn evil(k : String, a : Array[Pair]) -> Int {
    #|  let _ = a.pop()
    #|  k.length()
    #|}
    #|pub fn call_evil(a : Array[Pair]) -> Int {
    #|  evil(a[0].key, a)
    #|}
    #|pub fn obj_get_fast(entries : Array[Pair], k : String) -> Option[String] {
    #|  let n = entries.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    if entries[i].key == k {
    #|      return Some(entries[i].value)
    #|    }
    #|    i = i + 1
    #|  }
    #|  None
    #|}
    #|pub fn loop_escape_push() -> Int {
    #|  let a : Array[String] = []
    #|  let mut i = 0
    #|  while i < 2 {
    #|    a.push("x" + i.to_string())
    #|    if i == 0 {
    #|      let _ = Mutex::new(a)
    #|    }
    #|    i = i + 1
    #|  }
    #|  a.length()
    #|}
    #|pub fn leading_none_arr() -> Int {
    #|  let a = [None, Some("ok")]
    #|  match a[0] {
    #|    None => 1
    #|    Some(_) => 0
    #|  }
    #|}
    #|pub fn is_set[T](b : OptBox[T]) -> Bool {
    #|  match b.item {
    #|    Some(_) => true
    #|    None => false
    #|  }
    #|}
    #|pub fn test_box() -> Int {
    #|  let b1 : OptBox[String] = OptBox::{ item: None }
    #|  let b2 : OptBox[String] = OptBox::{ item: Some("hi") }
    #|  let c1 = if is_set(b1) { 10 } else { 1 }
    #|  let c2 = if is_set(b2) { 2 } else { 20 }
    #|  c1 + c2
    #|}
    #|pub enum Color {
    #|  Red
    #|  Green
    #|}
    #|pub fn eq_borrowed_obj(a : Color, b : Color) -> Bool {
    #|  let eq = a == b
    #|  eq
    #|}
  let cr = check_source_files_full("p19b_snd", ["p19b_snd.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // 1. call_evil must NOT borrow a[0].key (must rc_inc before calling evil)
  let ce_s = p18_find_from(ssa, "$pion_fn_call_evil(", 0)
  let ce_e = p18_find_from(ssa, "\n}", ce_s)
  let ce_rc = p18_find_from(ssa, "$pion_rc_inc", ce_s)
  assert_true(ce_s >= 0 && ce_rc > ce_s && ce_rc < ce_e, ssa)
  // 2. obj_get_fast comparison `entries[i].key == k` still borrows with zero RC before $pion_str_eq
  let og_s = p18_find_from(ssa, "$pion_fn_obj_get_fast(", 0)
  let og_eq = p18_find_from(ssa, "$pion_str_eq(", og_s)
  let og_rc_before_eq = p18_find_from(ssa, "$pion_rc_inc", og_s)
  assert_true(og_s >= 0 && og_eq > og_s, ssa)
  assert_true(og_rc_before_eq < 0 || og_rc_before_eq > og_eq, ssa)
  // 3. loop_escape_push MUST keep adopt_fz because Mutex(a) escapes a inside while
  let le_s = p18_find_from(ssa, "$pion_fn_loop_escape_push(", 0)
  let le_e = p18_find_from(ssa, "\n}", le_s)
  let le_adopt = p18_find_from(ssa, "adopt_fz", le_s)
  assert_true(le_s >= 0 && le_adopt > le_s && le_adopt < le_e, ssa)
  // 4. leading_none_arr must normalize element 0 via opt_zn to null niche 0
  let ln_s = p18_find_from(ssa, "$pion_fn_leading_none_arr(", 0)
  let ln_e = p18_find_from(ssa, "\n}", ln_s)
  let ln_zn = p18_find_from(ssa, "@opt_zn", ln_s)
  let ln_store0 = p18_find_from(ssa, "storel ", ln_zn)
  assert_true(ln_s >= 0 && ln_zn > ln_s && ln_store0 > ln_zn && ln_store0 < ln_e, ssa)
  // 5. is_set[T](b : OptBox[T]) must be monomorphized for String
  assert_true(ssa.contains("$pion_fn_is_set__mono_"), ssa)
  // 6. eq_borrowed_obj must NOT rc_dec borrowed operands in fallback ==
  let eq_s = p18_find_from(ssa, "$pion_fn_eq_borrowed_obj(", 0)
  let eq_e = p18_find_from(ssa, "\n}", eq_s)
  let eq_dec = p18_find_from(ssa, "$pion_rc_dec", eq_s)
  assert_true(eq_s >= 0 && (eq_dec < 0 || eq_dec > eq_e), ssa)
}

///|
/// Index of `needle` in `hay` at or after `from`, or -1.
fn p18_find_from(hay : String, needle : String, from : Int) -> Int {
  let n = needle.length()
  let mut i = if from < 0 { 0 } else { from }
  while i + n <= hay.length() {
    let mut j = 0
    while j < n && str_code_at(hay, i + j) == str_code_at(needle, j) {
      j = j + 1
    }
    if j == n {
      return i
    }
    i = i + 1
  }
  -1
}

///|
test "p20a: dyn Trait emits fat-pointer vtable, thunks, drop_dyn, and niche Option" {
  let src =
    #|pub trait Describe {
    #|  describe(self : Self) -> String
    #|  score(self : Self, bonus : Int) -> Int
    #|}
    #|pub struct Dog {
    #|  name : String
    #|}
    #|impl Describe for Dog {
    #|  fn describe(self : Dog) -> String {
    #|    "dog:" + self.name
    #|  }
    #|  fn score(self : Dog, bonus : Int) -> Int {
    #|    self.name.length() + bonus
    #|  }
    #|}
    #|impl Describe for Int {
    #|  fn describe(self : Int) -> String {
    #|    "int:" + self.to_string()
    #|  }
    #|  fn score(self : Int, bonus : Int) -> Int {
    #|    self + bonus
    #|  }
    #|}
    #|pub fn render(x : dyn Describe) -> String {
    #|  x.describe() + ":" + x.score(2).to_string()
    #|}
    #|pub fn main() -> Int {
    #|  let xs : Array[dyn Describe] = [Dog::{ name: "rex" }, 40]
    #|  let opt : Option[dyn Describe] = Some(Dog::{ name: "max" })
    #|  let _ = match opt {
    #|    Some(v) => render(v)
    #|    None => ""
    #|  }
    #|  render(xs[0]).length() + render(xs[1]).length()
    #|}
  let cr = check_source_files_full("p20a_dyn", ["p20a_dyn.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  assert_true(ssa.contains("function $pion_drop_dyn("), ssa)
  assert_true(ssa.contains("data $pion_vtable_Describe__Dog = align 8 { l 1,"), ssa)
  assert_true(ssa.contains("data $pion_vtable_Describe__Int = align 8 { l 0, l 0,"), ssa)
  assert_true(ssa.contains("$pion_dyn_wrap_Describe__Dog_M8_describe("), ssa)
  assert_true(ssa.contains("$pion_dyn_wrap_Describe__Int_M5_score("), ssa)
  // Niche Option[dyn Describe] must NOT box Option with $pion_drop_opt_obj
  assert_true(!ssa.contains("$pion_drop_opt_obj"), ssa)
}

///|
test "p24a_five_bug_fixes" {
  // Bug 1, 2, 3, 4 (local), 5 (test block return)
  let src =
    #|let CONST_ARR : Array[String] = ["a", "b"]
    #|fn inc(x : Int) -> Int {
    #|  x + 1
    #|}
    #|fn apply(f : (Int) -> Int, v : Int) -> Int {
    #|  f(v)
    #|}
    #|pub fn clone_arr[T](xs : Array[T]) -> Array[T] {
    #|  let out : Array[T] = []
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    out.push(xs[i])
    #|    i = i + 1
    #|  }
    #|  out
    #|}
    #|pub fn empty_branch(cond : Bool, k : Int) -> Int {
    #|  let xs = if cond { [] } else { ["a", "b"] }
    #|  xs.push("c")
    #|  let ys = match k {
    #|    0 => []
    #|    _ => ["x", "y"]
    #|  }
    #|  ys.push("z")
    #|  xs.length() + ys.length() + apply(inc, CONST_ARR.length())
    #|}
    #|test "early return in match" {
    #|  let res : Result[Int, String] = Err("boom")
    #|  let x = match res {
    #|    Ok(v) => v
    #|    Err(_) => {
    #|      return
    #|    }
    #|  }
    #|  debug_assert(x == 0, "unreachable")
    #|}
  let cr = check_source_files_full("p24a_cg", ["p24a_cg.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // Bug 1: init_consts immortalizes module-level heap constants
  assert_true(ssa.contains("call $pion_rc_immortalize("), ssa)
  // Bug 2: empty_branch emits pion_arr_new(l 0, w 1) for empty [] branch (never w 0)
  let eb_s = p18_find_from(ssa, "$pion_fn_empty_branch(", 0)
  let eb_e = p18_find_from(ssa, "\n}", eb_s)
  assert_true(eb_s >= 0 && eb_e > eb_s, ssa)
  let eb_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", eb_s)
  assert_true(eb_new0 < 0 || eb_new0 > eb_e, ssa)
  let eb_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", eb_s)
  assert_true(eb_new1 > eb_s && eb_new1 < eb_e, ssa)
  // Bug 3: generic clone_arr[T] passes runtime %tp_T flag (truncated to w) to pion_arr_new
  let ca_s = p18_find_from(ssa, "$pion_fn_clone_arr(", 0)
  let ca_e = p18_find_from(ssa, "\n}", ca_s)
  assert_true(ca_s >= 0 && ca_e > ca_s, ssa)
  let ca_tpw = p18_find_from(ssa, "=w copy %tp_T", ca_s)
  assert_true(ca_tpw > ca_s && ca_tpw < ca_e, ssa)
  // Bug 5: test runner emits bare `ret` (not `ret 0`) inside void $pion_test_fn_0
  let tssa = emit_qbe_test_package(cr.pkg, cr.tc, []).ssa
  let tf_s = p18_find_from(tssa, "function $pion_test_fn_0()", 0)
  let tf_e = p18_find_from(tssa, "\n}", tf_s)
  assert_true(tf_s >= 0 && tf_e > tf_s, tssa)
  let tf_ret0 = p18_find_from(tssa, "ret 0", tf_s)
  assert_true(tf_ret0 < 0 || tf_ret0 > tf_e, tssa)
}

///|
test "p24a_bug6_generic_drop_fn" {
  let src =
    #|pub struct Box[T] {
    #|  item : T
    #|}
    #|pub enum Wrap[T] {
    #|  WVal(T)
    #|  WEmpty
    #|}
    #|pub fn wrap_ok[T](v : T) -> Result[T, String] {
    #|  Ok(v)
    #|}
    #|pub fn wrap_err[E](e : E) -> Result[Int, E] {
    #|  Err(e)
    #|}
    #|pub fn wrap_some[T](v : T) -> Option[T] {
    #|  Some(v)
    #|}
    #|pub fn wrap_box[T](v : T) -> Box[T] {
    #|  Box::{ item: v }
    #|}
    #|pub fn wrap_enum[T](v : T) -> Wrap[T] {
    #|  WVal(v)
    #|}
    #|pub fn wrap_pair[T](v : T) -> (T, Int) {
    #|  (v, 1)
    #|}
  let cr = check_source_files_full("p24a_b6", ["p24a_b6.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // wrap_ok[T]: selects $pion_drop_res_ok dynamically on %tp_T
  let wok_s = p18_find_from(ssa, "$pion_fn_wrap_ok(", 0)
  let wok_e = p18_find_from(ssa, "\n}", wok_s)
  assert_true(wok_s >= 0 && wok_e > wok_s, ssa)
  let wok_jnz = p18_find_from(ssa, "cnel %tp_T, 0", wok_s)
  assert_true(wok_jnz > wok_s && wok_jnz < wok_e, ssa)
  let wok_dp = p18_find_from(ssa, "$pion_drop_res_ok", wok_s)
  assert_true(wok_dp > wok_s && wok_dp < wok_e, ssa)
  // wrap_err[E]: selects $pion_drop_res_err dynamically on %tp_E
  let werr_s = p18_find_from(ssa, "$pion_fn_wrap_err(", 0)
  let werr_e = p18_find_from(ssa, "\n}", werr_s)
  assert_true(werr_s >= 0 && werr_e > werr_s, ssa)
  let werr_dp = p18_find_from(ssa, "$pion_drop_res_err", werr_s)
  assert_true(werr_dp > werr_s && werr_dp < werr_e, ssa)
  // wrap_some[T]: selects $pion_drop_opt_obj dynamically on %tp_T
  let ws_s = p18_find_from(ssa, "$pion_fn_wrap_some(", 0)
  let ws_e = p18_find_from(ssa, "\n}", ws_s)
  assert_true(ws_s >= 0 && ws_e > ws_s, ssa)
  let ws_dp = p18_find_from(ssa, "$pion_drop_opt_obj", ws_s)
  assert_true(ws_dp > ws_s && ws_dp < ws_e, ssa)
  // wrap_box[T], wrap_enum[T], wrap_pair[T]: select slot drop dynamically on %tp_T
  let wb_s = p18_find_from(ssa, "$pion_fn_wrap_box(", 0)
  let wb_e = p18_find_from(ssa, "\n}", wb_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_1", wb_s) < wb_e, ssa)
  let we_s = p18_find_from(ssa, "$pion_fn_wrap_enum(", 0)
  let we_e = p18_find_from(ssa, "\n}", we_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_2", we_s) < we_e, ssa)
  let wp_s = p18_find_from(ssa, "$pion_fn_wrap_pair(", 0)
  let wp_e = p18_find_from(ssa, "\n}", wp_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_1", wp_s) < wp_e, ssa)
}

///|
test "p24a_probe_shadowing" {
  let src =
    #|pub enum MyVal {
    #|  MArr(Array[String])
    #|  MEmpty
    #|}
    #|pub fn shadow_match(x : MyVal) -> Int {
    #|  let out = match x {
    #|    MyVal::MArr(x) => x
    #|    _ => []
    #|  }
    #|  out.push("k")
    #|  let out2 = match x {
    #|    MyVal::MEmpty => []
    #|    MyVal::MArr(x) => x
    #|  }
    #|  out2.push("v")
    #|  out.length() + out2.length()
    #|}
    #|pub fn shadow_block(cond : Bool) -> Int {
    #|  let x = 123
    #|  let out = if cond {
    #|    []
    #|  } else {
    #|    let x : Array[String] = ["hi"]
    #|    x
    #|  }
    #|  out.push("there")
    #|  x + out.length()
    #|}
  let cr = check_source_files_full("p24a_sh", ["p24a_sh.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // shadow_match: both empty [] arms must emit pion_arr_new(l 0, w 1), never w 0
  let sm_s = p18_find_from(ssa, "$pion_fn_shadow_match(", 0)
  let sm_e = p18_find_from(ssa, "\n}", sm_s)
  assert_true(sm_s >= 0 && sm_e > sm_s, ssa)
  let sm_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", sm_s)
  assert_true(sm_new0 < 0 || sm_new0 > sm_e, ssa)
  let sm_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", sm_s)
  assert_true(sm_new1 > sm_s && sm_new1 < sm_e, ssa)
  // shadow_block: if cond { [] } else { let x : Array[String] = ["hi"]; x } emits w 1
  let sb_s = p18_find_from(ssa, "$pion_fn_shadow_block(", 0)
  let sb_e = p18_find_from(ssa, "\n}", sb_s)
  assert_true(sb_s >= 0 && sb_e > sb_s, ssa)
  let sb_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", sb_s)
  assert_true(sb_new0 < 0 || sb_new0 > sb_e, ssa)
  let sb_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", sb_s)
  assert_true(sb_new1 > sb_s && sb_new1 < sb_e, ssa)
}

///|
test "p25a_extern_c_varargs_qbe_ir" {
  let src =
    #|extern "C" fn sq3_config_i(op : Int, ..., v : Int) -> Int = "sqlite3_config"
    #|extern "C" fn c_snprintf_iid(buf : Ptr, cap : Int64, fmt : Ptr, ..., a : Int, b : Int, c : Double) -> Int = "snprintf"
    #|extern "C" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = "snprintf"
    #|pub fn test_va(buf : Ptr, fmt : Ptr) -> Int {
    #|  let r1 = sq3_config_i(9, 0)
    #|  let r2 = c_snprintf_iid(buf, 128L, fmt, 42, -7, 3.25)
    #|  let r3 = c_snprintf_0(buf, 128L, fmt)
    #|  r1 + r2 + r3
    #|}
  let cr = check_source_files_full("p25a_va_qbe", ["p25a_va_qbe.pion"], [
    src,
  ])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(p18_find_from(ssa, "call $sqlite3_config(w ", 0) >= 0, ssa)
  let sq_pos = p18_find_from(ssa, "call $sqlite3_config(", 0)
  let sq_end = p18_find_from(ssa, "\n", sq_pos)
  let va_sq = p18_find_from(ssa, ", ..., w ", sq_pos)
  assert_true(va_sq > sq_pos && va_sq < sq_end, ssa)

  let sn_pos = p18_find_from(ssa, "call $snprintf(l ", 0)
  let sn_end = p18_find_from(ssa, "\n", sn_pos)
  let va_sn = p18_find_from(ssa, ", ..., w ", sn_pos)
  let d_sn = p18_find_from(ssa, ", d ", va_sn)
  assert_true(va_sn > sn_pos && va_sn < sn_end && d_sn > va_sn && d_sn < sn_end, ssa)

  let sn0_pos = p18_find_from(ssa, "call $snprintf(l ", sn_end)
  let sn0_end = p18_find_from(ssa, "\n", sn0_pos)
  let va_sn0 = p18_find_from(ssa, ", ...)", sn0_pos)
  assert_true(va_sn0 > sn0_pos && va_sn0 < sn0_end, ssa)
}

///|
test "p26b_extern_c_body_c_fn_ptr_zero_copy_math_sb_qbe_ir" {
  let src =
    #|pub extern "C" fn cb_add(a : Int, b : Int) -> Int = "my_cb_add" {
    #|  a + b
    #|}
    #|extern "C" fn cb_void(p : Ptr, x : Int) -> Unit {
    #|  ptr_write_i32(p, 0L, x)
    #|}
    #|pub fn test_p26b(s : String, bs : Bytes, arr : Array[Double], p : Ptr) -> Double {
    #|  let _f1 = c_fn_ptr(cb_add)
    #|  let _f2 = c_fn_ptr(cb_void)
    #|  let _sp = str_data_ptr(s)
    #|  let _bp = bytes_data_ptr(bs)
    #|  let _ap = array_data_ptr(arr)
    #|  ptr_write_f64(p, 0L, 1.5)
    #|  ptr_write_f32(p, 8L, 2.25)
    #|  let v = ptr_read_f64(p, 0L) + ptr_read_f32(p, 8L)
    #|  let sb = StringBuilder()
    #|  sb.write_byte(b'A')
    #|  sb.write_bytes(bs)
    #|  v + math_tan(0.5) + math_asin(0.5) + math_acos(0.5) + math_atan(0.5) +
    #|    math_atan2(1.0, 2.0) + math_exp(1.0) + math_log(2.0) + math_round(1.6) + math_trunc(1.6)
    #|}
  let cr = check_source_files_full("p26b_qbe", ["p26b_qbe.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(ssa.contains("export function w $my_cb_add(w %p0, w %p1)"), ssa)
  assert_true(ssa.contains("export function $cb_void(l %p0, w %p1)"), ssa)
  assert_true(ssa.contains("=l copy $my_cb_add"), ssa)
  assert_true(ssa.contains("=l copy $cb_void"), ssa)
  assert_true(ssa.contains("=s loads "), ssa)
  assert_true(ssa.contains("=d exts "), ssa)
  assert_true(ssa.contains("=s truncd "), ssa)
  assert_true(ssa.contains("stores "), ssa)
  assert_true(ssa.contains("call $tan("), ssa)
  assert_true(ssa.contains("call $asin("), ssa)
  assert_true(ssa.contains("call $acos("), ssa)
  assert_true(ssa.contains("call $atan("), ssa)
  assert_true(ssa.contains("call $atan2("), ssa)
  assert_true(ssa.contains("call $exp("), ssa)
  assert_true(ssa.contains("call $log("), ssa)
  assert_true(ssa.contains("call $round("), ssa)
  assert_true(ssa.contains("call $trunc("), ssa)
  assert_true(ssa.contains("call $pion_strbuf_push_byte("), ssa)
}

///|
test "p26b_generic_method_option_mono_and_cross_pkg_export_internals" {
  let lib_src =
    #|let MASK : Int = 15
    #|fn hash_int(k : Int) -> Int {
    #|  (k * 31) & MASK
    #|}
    #|pub struct Wrap[V] {
    #|  mut inner : Option[V]
    #|}
    #|pub fn Wrap::new[V]() -> Wrap[V] {
    #|  Wrap::{ inner: None }
    #|}
    #|pub fn Wrap::set[V](self : Wrap[V], v : V) -> Unit {
    #|  let _h = hash_int(1)
    #|  self.inner = Some(v)
    #|}
    #|pub fn Wrap::get[V](self : Wrap[V]) -> Option[V] {
    #|  self.inner
    #|}
  let lib_cr = check_source_files_with_imports("wlib", ["wlib.pion"], [lib_src], [], true)
  assert_true(
    lib_cr.diagnostics.length() == 0,
    check_result_to_json(lib_cr.diagnostics),
  )
  // Upstream package with pub generic fn skips .pionstub and exports private helpers/consts
  assert_eq(emit_pion_stub(lib_cr.pkg), "")
  let lib_ssa = emit_qbe_package_multi(lib_cr.pkg, lib_cr.tc, false, false, []).ssa
  assert_true(lib_ssa.contains("export function w $pion_pkg_wlib_fn_hash_int("), lib_ssa)
  assert_true(lib_ssa.contains("export data $pion_pkg_wlib_const_MASK"), lib_ssa)

  let app_src =
    #|import "wlib"
    #|pub fn run_wrap() -> Int {
    #|  let ws : wlib::Wrap[String] = wlib::Wrap::new()
    #|  ws.set("hi")
    #|  let wi : wlib::Wrap[Int] = wlib::Wrap::new()
    #|  wi.set(42)
    #|  match (ws.get(), wi.get()) {
    #|    (Some(s), Some(n)) => s.length() + n
    #|    _ => 0
    #|  }
    #|}
  let imported = [imported_pkg_new("wlib", lib_cr.tc)]
  let app_cr = check_source_files_with_imports("app", ["main.pion"], [app_src], imported, true)
  assert_true(
    app_cr.diagnostics.length() == 0,
    check_result_to_json(app_cr.diagnostics),
  )
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, false, false, ["wlib"]).ssa
  assert_true(app_ssa.contains("__mono_String("), app_ssa)
  assert_true(app_ssa.contains("__mono_Int("), app_ssa)
}

///|
test "p27a_bug4_tuple_niche_and_numeric_qbe_ir" {
  let src =
    #|struct Node { id : Int }
    #|pub fn mk_none(n : Node) -> (Node, Option[Node]) {
    #|  (n, None)
    #|}
    #|pub fn num_ops(a : Int, b : Int64, d : Double) -> Double {
    #|  let x = a.to_double() + b.to_double()
    #|  let bits = d.to_bits()
    #|  let d2 = Double::from_bits(bits)
    #|  let _k = d2.to_int64() + a.abs().to_int64() + b.abs()
    #|  x + d2.sqrt() + d2.round() + d2.trunc()
    #|}
    #|pub fn map_clr(m : Map[String, Int]) -> Unit {
    #|  m.clear()
    #|}
  let cr = check_source_files_with_imports("p27a", ["main.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, []).ssa
  // Bug #4: `(n, None)` for `(Node, Option[Node])` must store null-niche 0, never $pion_none_hdr
  assert_true(!ssa.contains("$pion_none_hdr"), "expected null-niche 0 for (Node, Option[Node]), got $pion_none_hdr:\n" + ssa)
  // Zero-byte numeric IR instructions
  assert_true(ssa.contains("=d swtof "), ssa)
  assert_true(ssa.contains("=d sltof "), ssa)
  assert_true(ssa.contains("=l cast "), ssa)
  assert_true(ssa.contains("=d cast "), ssa)
  assert_true(ssa.contains("=l dtosi "), ssa)
  assert_true(ssa.contains("=d sqrt "), ssa)
  assert_true(ssa.contains("call $round("), ssa)
  assert_true(ssa.contains("call $trunc("), ssa)
  assert_true(ssa.contains("call $pion_map_clear("), ssa)
}

