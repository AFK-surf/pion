  let has_cgtd = p18_find_from(ssa, "cgtd ", clo)
  assert_true(has_cgtd > clo && has_cgtd < clo_end, ssa)
}

///|
test "p30c_bug16a_bug16b_qbe_mono_and_closure_infer" {
  let src =
    #|trait ViewEq {
    #|  fn veq(self : Self, other : Self) -> Bool
    #|}
    #|impl ViewEq for Bool {
    #|  fn veq(self : Bool, other : Bool) -> Bool {
    #|    self == other
    #|  }
    #|}
    #|enum HoldRead {
    #|  Stay
    #|  Go(Int)
    #|}
    #|impl ViewEq for HoldRead {
    #|  fn veq(self : HoldRead, other : HoldRead) -> Bool {
    #|    match self {
    #|      Stay =>
    #|        match other {
    #|          Stay => true
    #|          Go(_) => false
    #|        }
    #|      Go(a) =>
    #|        match other {
    #|          Stay => false
    #|          Go(b) => a == b
    #|        }
    #|    }
    #|  }
    #|}
    #|struct View {
    #|  flag : Bool
    #|}
    #|fn View::leaving(self : View) -> Bool {
    #|  self.flag
    #|}
    #|fn View::reacts[T : ViewEq](self : View, read : () -> T, f : (T) -> Unit) -> Unit {
    #|  let v = read()
    #|  if v.veq(v) {
    #|    f(v)
    #|  }
    #|}
    #|struct Sight[T] {
    #|  item : T
    #|}
    #|struct ListKeys[K] {
    #|  keys : Array[K]
    #|}
    #|fn Sight::keyed[K](self : Sight[Int], ids : ListKeys[K]) -> Sight[K] {
    #|  Sight::{ item: ids.keys[self.item] }
    #|}
    #|struct ListPlace[K] {
    #|  ids : ListKeys[K]
    #|}
    #|fn apply_sight[K](s : Sight[Int], f : (Sight[Int]) -> Sight[K]) -> Sight[K] {
    #|  f(s)
    #|}
    #|fn ListPlace::on_sight[K](self : ListPlace[K], s : Sight[Int]) -> Sight[K] {
    #|  let ids = self.ids
    #|  apply_sight(s, fn(cur) { cur.keyed(ids) })
    #|}
    #|struct HitBox {
    #|  mut v : Int
    #|}
    #|pub fn entry(v : View) -> String {
    #|  let hit = HitBox::{ v: 0 }
    #|  v.reacts(fn() { v.leaving() }, fn(leaving) {
    #|    if leaving {
    #|      hit.v += 1
    #|    }
    #|  })
    #|  v.reacts(fn() {
    #|    if v.leaving() {
    #|      return HoldRead::Stay
    #|    } else {
    #|      return HoldRead::Go(5)
    #|    }
    #|  }, fn(h) {
    #|    match h {
    #|      Stay => hit.v += 2
    #|      Go(n) => hit.v += n
    #|    }
    #|  })
    #|  let lp = ListPlace::{ ids: ListKeys::{ keys: ["zero", "one"] } }
    #|  let out = lp.on_sight(Sight::{ item: 1 })
    #|  if hit.v > 0 { out.item } else { "none" }
    #|}
  let cr = check_source_files_full("p30c_be", ["p30c_be.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(p18_find_from(ssa, "$pion_m_View__reacts__mono_Bool", 0) >= 0, ssa)
  assert_true(p18_find_from(ssa, "$pion_m_View__reacts__mono_HoldRead", 0) >= 0, ssa)
  assert_true(p18_find_from(ssa, "$pion_m_Sight__keyed", 0) >= 0, ssa)
}

///|
test "p30c_bug17_unannotated_none_binding_qbe_int_add" {
  let src =
    #|fn find_idx(xs : Array[Int], target : Int) -> Option[Int] {
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    if xs[i] == target {
    #|      return Some(i)
    #|    }
    #|    i += 1
    #|  }
    #|  None
    #|}
    #|fn take_opt_str(x : Option[String]) -> Int {
    #|  match x {
    #|    Some(s) => s.length()
    #|    None => 0
    #|  }
    #|}
    #|pub fn search_next(xs : Array[Int], target : Int) -> Int {
    #|  let mut before = None
    #|  let mut p = xs.length() - 1
    #|  while p >= 0 && before.is_none() {
    #|    before = find_idx(xs, target)
    #|    p = p - 1
    #|  }
    #|  let r = match before {
    #|    Some(i) => i + 1
    #|    None => 0
    #|  }
    #|  let s_none = None
    #|  r + take_opt_str(s_none)
    #|}
  let cr = check_source_files_full("p30c_b17", ["p30c_b17.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  let fn_s = p18_find_from(ssa, "$pion_fn_search_next(", 0)
  let fn_e = p18_find_from(ssa, "\n}", fn_s)
  assert_true(fn_s >= 0 && fn_e > fn_s, ssa)
  // `Some(i) => i + 1` must emit `=w add` (Int32), never `=l add` with `w`
  let has_w_add = p18_find_from(ssa, " =w add ", fn_s)
  assert_true(has_w_add > fn_s && has_w_add < fn_e, ssa)
}

///|
test "p30c_bug18_cross_pkg_option_mono_and_niche_none_struct_lit" {
  let lib_src =
    #|pub struct BoxState[T] {
    #|  pub mut value : Option[T]
    #|  pub getter : () -> T
    #|}
    #|pub struct Boxed[T] {
    #|  state : BoxState[T]
    #|}
    #|pub fn make_boxed[T](g : () -> T) -> Boxed[T] {
    #|  let st = BoxState::{ value: None, getter: g }
    #|  Boxed::{ state: st }
    #|}
    #|pub fn Boxed::get[T](self : Boxed[T]) -> T {
    #|  match self.state.value {
    #|    Some(v) => v
    #|    None => {
    #|      let f = self.state.getter
    #|      let v = f()
    #|      self.state.value = Some(v)
    #|      v
    #|    }
    #|  }
    #|}
    #|pub fn Boxed::untracked[T](self : Boxed[T]) -> T {
    #|  self.get()
    #|}
  let lib_cr = check_source_files_with_imports("siglib", ["siglib.pion"], [lib_src], [], true)
  assert_true(
    lib_cr.diagnostics.length() == 0,
    check_result_to_json(lib_cr.diagnostics),
  )

  let app_src =
    #|import "siglib"
    #|struct Payload {
    #|  id : Int
    #|  tag : String
    #|}
    #|pub fn run_boxed() -> Int {
    #|  let b = siglib::make_boxed(fn() { Payload::{ id: 42, tag: "ok" } })
    #|  let p1 = b.untracked()
    #|  let p2 = b.get()
    #|  p1.id + p2.id
    #|}
  let imported = [imported_pkg_new("siglib", lib_cr.tc)]
  let app_cr = check_source_files_with_imports("vapp", ["main.pion"], [app_src], imported, true)
  assert_true(
    app_cr.diagnostics.length() == 0,
    check_result_to_json(app_cr.diagnostics),
  )
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, false, false, ["siglib"]).ssa
  // Bug #18a: cross-pkg `Boxed::untracked` & `make_boxed` MUST both monomorphize for `Payload`
  assert_true(app_ssa.contains("Boxed__untracked__mono_Payload("), app_ssa)
  assert_true(app_ssa.contains("Boxed__get__mono_Payload("), app_ssa)
  assert_true(app_ssa.contains("make_boxed__mono_Payload("), app_ssa)
  // Bug #18b: `make_boxed__mono_Payload` must normalize untyped None for niche Option[Payload]
  let mk_s = p18_find_from(app_ssa, "function l $pion_pkg_siglib_fn_make_boxed__mono_Payload(", 0)
  let mk_e = p18_find_from(app_ssa, "\n}", mk_s)
  assert_true(mk_s >= 0 && mk_e > mk_s, app_ssa)
  let has_zn = p18_find_from(app_ssa, "@opt_zn_", mk_s)
  assert_true(has_zn > mk_s && has_zn < mk_e, app_ssa)
}

///|
test "p30d_inline_native_rc_ssa_phi_and_immortal" {
  let raw_ssa =
    #|data $pion_str_0_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l 2, b "hi", b 0 }
    #|
    #|export function l $demo(l %x, w %cond) {
    #|@start
    #|    %lit =l add $pion_str_0_hdr, 24
    #|    call $pion_rc_inc(l %lit)
    #|    call $pion_rc_dec(l %lit)
    #|    call $pion_rc_inc(l $str_static)
    #|    call $pion_rc_dec(l $str_static)
    #|    jnz %cond, @b1, @b10
    #|@b1
    #|    call $pion_rc_inc(l %x)
    #|    jmp @merge
    #|@b10
    #|    call $pion_rc_dec(l %x)
    #|    jmp @merge
    #|@merge
    #|    %res =l phi @b1 %x, @b10 %lit
    #|    ret %res
    #|}
  let out = inline_native_rc_ssa(raw_ssa)
  // Static immortal string literals must be completely eliminated (zero inc/dec)
  assert_eq(out.contains("call $pion_rc_inc(l %lit)"), false)
  assert_eq(out.contains("call $pion_rc_dec(l %lit)"), false)
  assert_eq(out.contains("call $pion_rc_inc(l $str_static)"), false)
  assert_eq(out.contains("call $pion_rc_dec(l $str_static)"), false)
  // Dynamic RC inc/dec must expand with pion_mt_flag + owner_tid + flags + local_rc + destroy_obj
  assert_true(out.contains("loaduw $pion_mt_flag"), out)
  assert_true(out.contains("sub %x, 24"), out)
  assert_true(out.contains("sub %x, 10"), out)
  assert_true(out.contains("sub %x, 20"), out)
  assert_true(out.contains("call $pion_destroy_obj(l %x)"), out)
  // Phi predecessor labels @b1 and @b10 must be remapped cleanly without prefix collision
  assert_true(out.contains("%res =l phi @_rci_end_0 %x, @_rcd_end_1 %lit"), out)
  // Branch targets to block entries @b1 and @b10 must stay unchanged
  assert_true(out.contains("jnz %cond, @b1, @b10"), out)
}

///|
test "p30e_cross_file_and_struct_method_inline" {
  let file_a =
    #|pub struct Rect {
    #|  pub x : Int
    #|  pub y : Int
    #|  pub w : Int
    #|  pub h : Int
    #|}
    #|pub fn Rect::right(self : Rect) -> Int {
    #|  self.x + self.w
    #|}
    #|pub fn Rect::area_from(w : Int, h : Int) -> Int {
    #|  w * h
    #|}
    #|pub fn helper_add(a : Int, b : Int) -> Int {
    #|  a + b * 2
    #|}
  let file_b =
    #|pub fn compute_rect(r : Rect) -> Int {
    #|  let rr = r.right()
    #|  let ar = Rect::area_from(r.w, r.h)
    #|  helper_add(rr, ar)
    #|}
  let cr = check_source_files_full("p30e_inl", ["a.pion", "b.pion"], [file_a, file_b])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let fn_s = p18_find_from(ssa, "$pion_fn_compute_rect(", 0)
  let fn_e = p18_find_from(ssa, "\n}", fn_s)
  assert_true(fn_s >= 0 && fn_e > fn_s, ssa)
  // Cross-file function, struct instance method, and static method must all be inlined (zero call)
  let has_call_right = p18_find_from(ssa, "call $pion_m_Rect__right", fn_s)
  assert_true(has_call_right < 0 || has_call_right > fn_e, ssa)
  let has_call_area = p18_find_from(ssa, "call $pion_m_Rect__area_from", fn_s)
  assert_true(has_call_area < 0 || has_call_area > fn_e, ssa)
  let has_call_helper = p18_find_from(ssa, "call $pion_fn_helper_add", fn_s)
  assert_true(has_call_helper < 0 || has_call_helper > fn_e, ssa)
}

///|
test "p30e_tuple_let_and_match_scalarization" {
  let src =
    #|pub enum Stage {
    #|  UniformColor
    #|  Store
    #|  Other
    #|}
    #|pub fn pair_sum(x : Int, y : Int) -> Int {
    #|  let (a, b) = (x + 1, y + 2)
    #|  let (c, d) = (b, a)
    #|  c * 10 + d
    #|}
    #|pub fn match_stages(s0 : Stage, s1 : Stage) -> Int {
    #|  match (s0, s1) {
    #|    (Stage::UniformColor, Stage::Store) => 1
    #|    (Stage::Store, Stage::UniformColor) => 2
    #|    _ => 0
    #|  }
    #|}
  let cr = check_source_files_full("p30e_tup", ["p30e_tup.pion"], [src])
