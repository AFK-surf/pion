    #|}
    #|
  let out_loadsw_bad = cleanup_native_rc_ssa(ssa_arr8_loadsw_bad)
  assert_true(out_loadsw_bad.contains("$pion_rc_inc"), out_loadsw_bad)
  assert_true(out_loadsw_bad.contains("$pion_rc_dec"), out_loadsw_bad)

  // 23. Labels containing `$` (`@side$a` vs `@side$b`) MUST stay distinct in `label_to_blk`
  //     so `@side$a` (normal return after rc_dec) is never conflated with `@side$b` (hlt).
  let ssa_dollar_lbls =
    #|export function w $f_dollar_lbls(l %arr, w %c) {
    #|@start
    #|    call $pion_rc_inc(l %arr)
    #|    jnz %c, @side$a, @ok
    #|@side$a
    #|    call $pion_rc_dec(l %arr)
    #|    ret 1
    #|@side$b
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %arr)
    #|    ret 0
    #|}
    #|
  let out_dollar = cleanup_native_rc_ssa(ssa_dollar_lbls)
  assert_true(out_dollar.contains("$pion_rc_inc"), out_dollar)
  assert_true(out_dollar.contains("$pion_rc_dec"), out_dollar)

  // 24. No-space `jmp@ok` from a non-adjacent block MUST be counted as a predecessor of `@ok`,
  //     preventing cross-block RC cancellation across `@arm0 -> @ok`.
  let ssa_nospace_jmp =
    #|export function w $f_nospace_jmp(l %arr, w %c, w %idx) {
    #|@start
    #|    jnz %c, @arm0, @other
    #|@other
    #|    jmp@ok
    #|@arm0
    #|    call $pion_rc_inc(l %arr)
    #|    %il =l extsw %idx
    #|    %len =l loadl %arr
    #|    %oob =w cugel %il, %len
    #|    jnz %oob, @arr_oob_w8_0, @ok
    #|@arr_oob_w8_0
    #|    call $pion_panic_oob(l %il, l %len)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %arr)
    #|    ret 0
    #|}
    #|
  let out_ns_jmp = cleanup_native_rc_ssa(ssa_nospace_jmp)
  assert_true(out_ns_jmp.contains("$pion_rc_inc"), out_ns_jmp)
  assert_true(out_ns_jmp.contains("$pion_rc_dec"), out_ns_jmp)

  // 25. Quoted function name containing parens `function l $"f()"(l %x) {` MUST still count
  //     parameter `%x` in `def_count`, so redefining `%x` as immortal later does NOT delete
  //     the earlier `$pion_rc_dec(l %x)` on the incoming parameter.
  let ssa_quoted_fn_hdr =
    #|export function l $"f()"(l %x) {
    #|@start
    #|    call $pion_rc_dec(l %x)
    #|    %x =l add $pion_str_0_hdr, 24
    #|    ret %x
    #|}
    #|
  let out_qhdr = cleanup_native_rc_ssa(ssa_quoted_fn_hdr)
  assert_true(out_qhdr.contains("call $pion_rc_dec(l %x)"), out_qhdr)

  // 26. Function closing brace with trailing comment `} # end f1` MUST close `f1` so
  //     immortal `%x` in `f1` never leaks into `f2`'s parameter `%x`.
  let ssa_close_comment =
    #|export function l $f1() {
    #|@start
    #|    %x =l add $pion_str_0_hdr, 24
    #|    call $pion_rc_inc(l %x)
    #|    ret %x
    #|} # end f1
    #|export function w $f2(l %x) {
    #|@start
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let out_cc = cleanup_native_rc_ssa(ssa_close_comment)
  let f2_part = j2_extract_fn(out_cc, "export function w $f2(")
  assert_true(f2_part.contains("call $pion_rc_dec(l %x)"), out_cc)

  // 27. `inline_native_rc_ssa` phi rewriting:
  //     (a) no-space `phi@left %x, @right %y` rewrites `@left` to expanded tail `@_rcd_end_0`;
  //     (b) `phi @left $"sym@left", @right %y` rewrites predecessor `@left` while keeping
  //         the quoted value `$"sym@left"` byte-for-byte intact.
  let ssa_phi_nospace =
    #|export function l $f_phi_ns(w %c, l %x, l %y) {
    #|@start
    #|    jnz %c, @left, @right
    #|@left
    #|    call $pion_rc_dec(l %x)
    #|    jmp @join
    #|@right
    #|    jmp @join
    #|@join
    #|    %v =l phi@left %x, @right %y
    #|    ret %v
    #|}
    #|
  let out_phi_ns = inline_native_rc_ssa(ssa_phi_nospace)
  assert_true(out_phi_ns.contains("phi@_rcd_end_0 %x, @right %y"), out_phi_ns)

  let ssa_phi_quoted =
    #|export function l $f_phi_q(w %c, l %x, l %y) {
    #|@start
    #|    jnz %c, @left, @right
    #|@left
    #|    call $pion_rc_dec(l %x)
    #|    jmp @join
    #|@right
    #|    jmp @join
    #|@join
    #|    %v =l phi @left $"sym@left", @right %y
    #|    ret %v
    #|}
    #|
  let out_phi_q = inline_native_rc_ssa(ssa_phi_quoted)
  assert_true(out_phi_q.contains("phi @_rcd_end_0 $\"sym@left\", @right %y"), out_phi_q)

  // 27c. Destination temp named `%phi` + negative int literal directly after `@left-1`.
  let ssa_phi_dest_neg =
    #|export function l $f_phi_dn(w %c, l %x, l %y) {
    #|@start
    #|    jnz %c, @left, @right
    #|@left
    #|    call $pion_rc_dec(l %x)
    #|    jmp @join
    #|@right
    #|    jmp @join
    #|@join
    #|    %phi =l phi @left %x, @right %y
    #|    %v =l phi @left-1, @right 0
    #|    %r =l add %phi, %v
    #|    ret %r
    #|}
    #|
  let out_phi_dn = inline_native_rc_ssa(ssa_phi_dest_neg)
  assert_true(out_phi_dn.contains("%phi =l phi @_rcd_end_0 %x, @right %y"), out_phi_dn)
  assert_true(out_phi_dn.contains("%v =l phi @_rcd_end_0-1, @right 0"), out_phi_dn)

  // 28. Multi-line quoted global symbol `$"..."` containing embedded RC call text (and a
  //     trailing backslash before `\n`, which in QBE parse.c escapes `\n` rather than the
  //     closing `"` on the next line) MUST pass the entire first function through verbatim,
  //     while the following function still optimizes.
  let ssa_multiline_quote =
    #|export function l $f_mlq(l %x) {
    #|@start
    #|    %s =l copy $"line1
    #|    call $pion_rc_inc(l %x)
    #|    call $pion_rc_dec(l %x)\
    #|"
    #|    ret %s
    #|}
    #|export function w $f_after_mlq(l %p0) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %len =l loadl %p0
    #|    %w =w copy %len
    #|    call $pion_rc_dec(l %p0)
    #|    ret %w
    #|}
    #|
  let out_mlq = cleanup_native_rc_ssa(ssa_multiline_quote)
  let mlq_marker = "export function w $f_after_mlq("
  let idx_in = ssa_multiline_quote.index_of(mlq_marker)
  let idx_out = out_mlq.index_of(mlq_marker)
  assert_true(idx_in > 0, ssa_multiline_quote)
  assert_true(idx_out > 0, out_mlq)
  assert_eq(slice_str(out_mlq, 0, idx_out), slice_str(ssa_multiline_quote, 0, idx_in))
  let f2_mlq = j2_extract_fn(out_mlq, mlq_marker)
  assert_true(f2_mlq.contains("%len =l loadl %p0"), f2_mlq)
  assert_true(f2_mlq.contains("ret %w"), f2_mlq)
  assert_true(!f2_mlq.contains("$pion_rc_inc"), f2_mlq)
  assert_true(!f2_mlq.contains("$pion_rc_dec"), f2_mlq)

  // 29. Same-line `} export function ... {` boundary MUST NOT merge `$f1` and `$f2`
  //     into a single analysis pass (so `$f1`'s immortal `%x` cannot elide `$f2`'s dec),
  //     while a subsequent cleanly delimited `$f3` still optimizes.
  let ssa_same_line_fn_boundary =
    #|export function w $f_sl1(l %p0) {
    #|@start
    #|    %x =l add $pion_str_0_hdr, 24
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|} export function w $f_sl2(l %x) {
    #|@start
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|export function w $f_sl3(l %p0) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %len =l loadl %p0
    #|    %w =w copy %len
    #|    call $pion_rc_dec(l %p0)
    #|    ret %w
    #|}
    #|
  let out_sl = cleanup_native_rc_ssa(ssa_same_line_fn_boundary)
  assert_true(out_sl.contains("} export function w $f_sl2(l %x) {\n@start\n    call $pion_rc_dec(l %x)\n    ret 0\n}\n"), out_sl)
  let f3_sl = j2_extract_fn(out_sl, "export function w $f_sl3(")
  assert_true(f3_sl.contains("%len =l loadl %p0"), f3_sl)
  assert_true(f3_sl.contains("ret %w"), f3_sl)
  assert_true(!f3_sl.contains("$pion_rc_inc"), f3_sl)
  assert_true(!f3_sl.contains("$pion_rc_dec"), f3_sl)
}

///|
test "k1b_selective_inline_rc_cfg_scc_called_in_loop" {
  // 1. Loop block expands while cold prologue & cold epilogue in the same function
  //    keep compact `call $pion_rc_*`, and mixed cold/hot + back-edge phi predecessors
  //    rewrite ONLY the split hot block labels.
  let ssa_loop_vs_cold =
    #|export function l $loop_mix(l %a, l %b, l %slot, w %n) {
    #|@entry
    #|    call $pion_rc_inc(l %a)
    #|    storel %a, %slot
    #|    call $pion_rc_inc(l %b)
    #|    storel %b, %slot
    #|    call $pion_rc_dec(l %b)
    #|    %has_work =w csgtw %n, 0
    #|    jnz %has_work, @loop_hdr, @exit
    #|@loop_hdr
    #|    %i =w phi @entry 0, @loop_body %i1
    #|    %cur =l phi @entry %a, @loop_body %next
    #|    %next =l copy %b
    #|    jmp @loop_body
    #|@loop_body
    #|    call $pion_rc_inc(l %cur)
    #|    storel %cur, %slot
    #|    call $pion_rc_dec(l %cur)
    #|    %i1 =w add %i, 1
    #|    %cont =w csltw %i1, %n
    #|    jnz %cont, @loop_hdr, @exit
    #|@exit
    #|    %res =l phi @entry %a, @loop_body %cur
    #|    call $pion_rc_dec(l %res)
    #|    storel %res, %slot
    #|    call $pion_rc_inc(l %res)
    #|    call $pion_rc_dec(l %a)
    #|    ret %res
    #|}
    #|
  let out_mix = inline_native_rc_ssa(ssa_loop_vs_cold)
  // Loop body RC ops (2 calls -> id 0 inc, id 1 dec) must expand:
  assert_true(out_mix.contains("@_rci_fast_0"), out_mix)
  assert_true(out_mix.contains("@_rcd_fast_1"), out_mix)
  assert_eq(out_mix.contains("@_rci_fast_2"), false)
  assert_eq(out_mix.contains("@_rcd_fast_2"), false)
  // Cold entry & cold exit must retain compact `call $pion_rc_*` (not expanded):
  assert_true(out_mix.contains("@entry\n    call $pion_rc_inc(l %a)\n"), out_mix)
  assert_true(out_mix.contains("    call $pion_rc_dec(l %res)\n    storel %res, %slot\n"), out_mix)
  // Mixed cold/hot phi predecessors: `@entry` MUST stay `@entry`, `@loop_body` MUST rewrite to `@_rcd_end_1`:
  assert_true(out_mix.contains("%i =w phi @entry 0, @_rcd_end_1 %i1"), out_mix)
  assert_true(out_mix.contains("%cur =l phi @entry %a, @_rcd_end_1 %next"), out_mix)
  assert_true(out_mix.contains("%res =l phi @entry %a, @_rcd_end_1 %cur"), out_mix)

  // 2. Large cold straight-line function (>10 RC calls, acyclic, not called in loop)
  //    MUST stay compact `call $pion_rc_*` (zero expansion).
  let cold_sb = StringBuilder()
  cold_sb.write_string("export function w $cold_ui_builder(l %x, l %slot) {\n@start\n")
  let mut ci = 0
  while ci < 12 {
    cold_sb.write_string("    call $pion_rc_inc(l %x)\n    storel %x, %slot\n    call $pion_rc_dec(l %x)\n")
    ci = ci + 1
  }
  cold_sb.write_string("    ret 0\n}\n")
  let out_cold = inline_native_rc_ssa(cold_sb.to_string())
  assert_eq(out_cold.contains("@_rci_fast_"), false)
  assert_eq(out_cold.contains("@_rcd_fast_"), false)
  assert_true(out_cold.contains("call $pion_rc_inc(l %x)"), out_cold)

  // 3. Comment & blank-line invariance: adding 60 comments + blank lines to a small
  //    acyclic function MUST NOT push `eff_insts` over the small-fn threshold (32).
  let small_plain =
    #|export function w $small_leaf(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let small_commented_sb = StringBuilder()
  small_commented_sb.write_string("export function w $small_leaf(l %x, l %slot) {\n@start\n")
  let mut k = 0
  while k < 60 {
    small_commented_sb.write_string("# comment line " + k.to_string() + "\n\n")
    k = k + 1
  }
  small_commented_sb.write_string("    call $pion_rc_inc(l %x) # inline comment\n")
  small_commented_sb.write_string("    storel %x, %slot\n")
  small_commented_sb.write_string("    call $pion_rc_dec(l %x) # inline comment\n")
  small_commented_sb.write_string("    ret 0\n}\n")
  let out_plain = inline_native_rc_ssa(small_plain)
  let out_commented = inline_native_rc_ssa(small_commented_sb.to_string())
  assert_true(out_plain.contains("@_rci_fast_0"), out_plain)
  assert_true(out_plain.contains("@_rcd_fast_1"), out_plain)
  assert_true(out_commented.contains("@_rci_fast_0"), out_commented)
  assert_true(out_commented.contains("@_rcd_fast_1"), out_commented)

  // 4. Irreducible multi-entry loop, self-loop, and `jtbl` cycle MUST all expand.
  let ssa_cycles =
    #|export function w $self_loop(l %x, l %slot, w %c) {
    #|@entry
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jmp @spin
    #|@spin
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    jnz %c, @spin, @done
    #|@done
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|export function w $irred_loop(l %x, l %slot, w %c) {
    #|@entry
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jnz %c, @left, @right
    #|@left
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jnz %c, @right, @done
    #|@right
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    jnz %c, @left, @done
    #|@done
    #|    ret 0
    #|}
    #|export function w $jtbl_loop(l %x, l %slot, w %idx) {
    #|@entry
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jmp @disp
    #|@disp
    #|    jtbl %idx, @done, @case0, @case1
    #|@case0
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jmp @disp
    #|@case1
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    jmp @disp
    #|@done
    #|    ret 0
    #|}
    #|
  let out_cycles = inline_native_rc_ssa(ssa_cycles)
  let fn_self = j2_extract_fn(out_cycles, "export function w $self_loop(")
  assert_true(fn_self.contains("@_rcd_fast_0"), fn_self)
  assert_eq(fn_self.contains("@_rci_fast_"), false)
  let fn_irred = j2_extract_fn(out_cycles, "export function w $irred_loop(")
  assert_true(fn_irred.contains("@_rci_fast_0"), fn_irred)
  assert_true(fn_irred.contains("@_rcd_fast_1"), fn_irred)
  assert_eq(fn_irred.contains("@_rci_fast_2"), false)
  let fn_jtbl = j2_extract_fn(out_cycles, "export function w $jtbl_loop(")
  assert_true(fn_jtbl.contains("@_rci_fast_0"), fn_jtbl)
  assert_true(fn_jtbl.contains("@_rcd_fast_1"), fn_jtbl)
  assert_eq(fn_jtbl.contains("@_rci_fast_2"), false)

  // 5. Intra-module `called_in_loop` propagation:
  //    - Pure-compute outer loop `$driver` calls `$mid_helper` (acyclic, >2 RC calls -> not small-fn),
  //      which calls `$leaf_helper` (acyclic, >2 RC calls -> 1st hop): BOTH must expand!
  //    - `$cold_sibling` (identical to `$mid_helper` but NOT called in loop) must stay compact!
  let ssa_cil =
    #|export function w $driver(l %x, l %slot, w %n) {
    #|@start
    #|    jmp @loop
    #|@loop
    #|    %i =w phi @start 0, @loop %i1
    #|    %r =w call $mid_helper(l %x, l %slot)
    #|    %i1 =w add %i, 1
    #|    %c =w csltw %i1, %n
    #|    jnz %c, @loop, @exit
    #|@exit
    #|    ret 0
    #|}
    #|export function w $mid_helper(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    %v =w call $leaf_helper(l %x, l %slot)
    #|    ret %v
    #|}
    #|export function w $leaf_helper(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|export function w $cold_sibling(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let out_cil = inline_native_rc_ssa(ssa_cil)
  let fn_mid = j2_extract_fn(out_cil, "export function w $mid_helper(")
  let fn_leaf = j2_extract_fn(out_cil, "export function w $leaf_helper(")
  let fn_sib = j2_extract_fn(out_cil, "export function w $cold_sibling(")
  assert_true(fn_mid.contains("@_rci_fast_0"), fn_mid)
  assert_true(fn_leaf.contains("@_rci_fast_0"), fn_leaf)
  assert_eq(fn_sib.contains("@_rci_fast_"), false)
  assert_true(fn_sib.contains("call $pion_rc_inc(l %x)"), fn_sib)

  // 6. Malformed / unresolvable CFG (duplicate label, unknown target) safely falls
  //    back to compact `call $pion_rc_*` (zero expansion, zero crash).
  let ssa_bad_cfg =
    #|export function w $dup_lbl(l %x, l %slot) {
    #|@dup
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|@dup
    #|    call $pion_rc_dec(l %x)
    #|    jmp @dup
    #|}
    #|export function w $unk_tgt(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jmp @does_not_exist
    #|}
    #|
  let out_bad = inline_native_rc_ssa(ssa_bad_cfg)
  assert_eq(out_bad.contains("@_rci_fast_"), false)
  assert_eq(out_bad.contains("@_rcd_fast_"), false)
  assert_true(out_bad.contains("call $pion_rc_inc(l %x)"), out_bad)
  assert_true(out_bad.contains("call $pion_rc_dec(l %x)"), out_bad)

  // 7. QBE global function names containing interior `$` (e.g. `$helper$tail` vs `$tail`):
  //    2 declaration orders x 2 call targets (4 sub-cases): ONLY the callee invoked inside
  //    the loop must expand; the other must stay compact `call $pion_rc_*`.
  let fn_helper_tail =
    #|export function w $helper$tail(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let fn_tail =
    #|export function w $tail(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let drv_call_ht =
    #|export function w $drv_ht(l %x, l %slot, w %n) {
    #|@start
    #|    jmp @loop
    #|@loop
    #|    %i =w phi @start 0, @loop %i1
    #|    %r =w call $helper$tail(l %x, l %slot)
    #|    %i1 =w add %i, 1
    #|    %c =w csltw %i1, %n
    #|    jnz %c, @loop, @exit
    #|@exit
    #|    ret 0
    #|}
    #|
  let drv_call_t =
    #|export function w $drv_t(l %x, l %slot, w %n) {
    #|@start
    #|    jmp @loop
    #|@loop
    #|    %i =w phi @start 0, @loop %i1
    #|    %r =w call $tail(l %x, l %slot)
    #|    %i1 =w add %i, 1
    #|    %c =w csltw %i1, %n
    #|    jnz %c, @loop, @exit
    #|@exit
    #|    ret 0
    #|}
    #|
  // Order A: $helper$tail then $tail
  let out_ht_a = inline_native_rc_ssa(drv_call_ht + fn_helper_tail + fn_tail)
  let a_ht = j2_extract_fn(out_ht_a, "export function w $helper$tail(")
  let a_t = j2_extract_fn(out_ht_a, "export function w $tail(")
  assert_true(a_ht.contains("@_rci_fast_0"), a_ht)
  assert_eq(a_t.contains("@_rci_fast_"), false)
  assert_true(a_t.contains("call $pion_rc_inc(l %x)"), a_t)

  let out_t_a = inline_native_rc_ssa(drv_call_t + fn_helper_tail + fn_tail)
  let a2_ht = j2_extract_fn(out_t_a, "export function w $helper$tail(")
  let a2_t = j2_extract_fn(out_t_a, "export function w $tail(")
  assert_eq(a2_ht.contains("@_rci_fast_"), false)
  assert_true(a2_ht.contains("call $pion_rc_inc(l %x)"), a2_ht)
  assert_true(a2_t.contains("@_rci_fast_0"), a2_t)

  // Order B: $tail then $helper$tail
  let out_ht_b = inline_native_rc_ssa(drv_call_ht + fn_tail + fn_helper_tail)
  let b_ht = j2_extract_fn(out_ht_b, "export function w $helper$tail(")
  let b_t = j2_extract_fn(out_ht_b, "export function w $tail(")
  assert_true(b_ht.contains("@_rci_fast_0"), b_ht)
  assert_eq(b_t.contains("@_rci_fast_"), false)
  assert_true(b_t.contains("call $pion_rc_inc(l %x)"), b_t)

  let out_t_b = inline_native_rc_ssa(drv_call_t + fn_tail + fn_helper_tail)
  let b2_ht = j2_extract_fn(out_t_b, "export function w $helper$tail(")
  let b2_t = j2_extract_fn(out_t_b, "export function w $tail(")
  assert_eq(b2_ht.contains("@_rci_fast_"), false)
  assert_true(b2_ht.contains("call $pion_rc_inc(l %x)"), b2_ht)
  assert_true(b2_t.contains("@_rci_fast_0"), b2_t)

  // 8. Unreachable dead self-loop after `ret 0` must NOT mark `$dead_loop_callee` hot.
  let ssa_dead_loop =
    #|export function w $has_dead_loop(l %x, l %slot) {
    #|@entry
    #|    ret 0
    #|@dead_spin
    #|    %r =w call $dead_loop_callee(l %x, l %slot)
    #|    jmp @dead_spin
    #|}
    #|export function w $dead_loop_callee(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let out_dead = inline_native_rc_ssa(ssa_dead_loop)
  let fn_dead_callee = j2_extract_fn(out_dead, "export function w $dead_loop_callee(")
  assert_eq(fn_dead_callee.contains("@_rci_fast_"), false)
  assert_true(fn_dead_callee.contains("call $pion_rc_inc(l %x)"), fn_dead_callee)
}

///|
test "wave_aa2_inline_rc_unreachable_giant_scc_cap_and_forward_dag" {
  // 1. AA2-1: Unreachable dead cycle containing RC calls MUST NOT expand.
  let ssa_unreach_rc =
    #|export function w $unreach_cycle_rc(l %x, l %slot, w %c) {
    #|@entry
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|@dead_hdr
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    jnz %c, @dead_body, @dead_hdr
    #|@dead_body
    #|    call $pion_rc_dec(l %x)
    #|    storel %x, %slot
    #|    jmp @dead_hdr
    #|}
    #|
  let out_unreach = inline_native_rc_ssa(ssa_unreach_rc)
  assert_eq(out_unreach.contains("@_rci_fast_"), false)
  assert_eq(out_unreach.contains("@_rcd_fast_"), false)
  assert_true(out_unreach.contains("@dead_hdr\n    call $pion_rc_inc(l %x)"), out_unreach)

  // 2. AA2-2a: Giant outer SCC (>24 blocks with internal branches) containing a
  //    compact inner natural loop: ONLY the inner loop expands; outer SCC stays compact.
  let giant_sb = StringBuilder()
  giant_sb.write_string("export function w $giant_outer_with_inner(l %x, l %y, l %slot, w %c) {\n")
  giant_sb.write_string("@entry\n    jmp @outer_hdr\n")
  giant_sb.write_string("@outer_hdr\n    call $pion_rc_inc(l %x)\n    storel %x, %slot\n    jnz %c, @arm0, @inner_hdr\n")
  let mut bi = 0
  while bi < 26 {
    giant_sb.write_string("@arm" + bi.to_string() + "\n")
    giant_sb.write_string("    call $pion_rc_dec(l %x)\n    storel %x, %slot\n")
    if bi + 1 < 26 {
      giant_sb.write_string("    jnz %c, @arm" + (bi + 1).to_string() + ", @outer_hdr\n")
    } else {
      giant_sb.write_string("    jnz %c, @outer_hdr, @done\n")
    }
    bi = bi + 1
  }
  giant_sb.write_string("@inner_hdr\n    call $pion_rc_inc(l %y)\n    storel %y, %slot\n    jnz %c, @inner_body, @outer_hdr\n")
  giant_sb.write_string("@inner_body\n    call $pion_rc_dec(l %y)\n    storel %y, %slot\n    jnz %c, @inner_hdr, @outer_hdr\n")
  giant_sb.write_string("@done\n    ret 0\n}\n")
  let out_giant = inline_native_rc_ssa(giant_sb.to_string())
  // Inner loop (%y) MUST expand (2 sites -> _rci_fast_0, _rcd_fast_1):
  assert_true(out_giant.contains("@_rci_fast_0"), out_giant)
  assert_true(out_giant.contains("@_rcd_fast_1"), out_giant)
  assert_eq(out_giant.contains("@_rci_fast_2"), false)
  assert_eq(out_giant.contains("@_rcd_fast_2"), false)
  // Outer giant-SCC blocks (%x) MUST remain compact calls:
  assert_true(out_giant.contains("@outer_hdr\n    call $pion_rc_inc(l %x)"), out_giant)
  assert_true(out_giant.contains("@arm0\n    call $pion_rc_dec(l %x)"), out_giant)

  // 3. AA2-2b: Large function (>128 eff_insts) with multiple compact loops exceeding
  //    the per-function cap (24) prioritizes smaller loops (rank 1) over larger loops
  //    (rank 6), and truncates equal-rank sites in deterministic source order.
  let cap_sb = StringBuilder()
  cap_sb.write_string("export function w $many_inner_loops(l %x, l %y, l %slot, w %c) {\n@entry\n")
  // Pad in @entry BEFORE branching so @big_loop5's jnz is a true terminator.
  let mut pi = 0
  while pi < 70 {
    cap_sb.write_string("    %pad" + pi.to_string() + " =w add %c, 1\n")
    pi = pi + 1
  }
  cap_sb.write_string("    jnz %c, @big_loop0, @tight_spin\n")
  // 6-block loop with 30 RC sites on %x (rank = 6): first 22 expand, last 8 stay compact.
  let mut li = 0
  while li < 6 {
    cap_sb.write_string("@big_loop" + li.to_string() + "\n")
    let mut ri = 0
    while ri < 5 {
      cap_sb.write_string("    call $pion_rc_inc(l %x)\n    storel %x, %slot\n")
      ri = ri + 1
    }
    if li + 1 < 6 {
      cap_sb.write_string("    jmp @big_loop" + (li + 1).to_string() + "\n")
    } else {
      cap_sb.write_string("    jnz %c, @big_loop0, @tight_spin\n")
    }
    li = li + 1
  }
  // 1-block self-loop with 2 RC sites on %y (rank = 1, dec then inc -> ids 22 & 23):
  cap_sb.write_string("@tight_spin\n    call $pion_rc_dec(l %y)\n    storel %y, %slot\n    call $pion_rc_inc(l %y)\n    storel %y, %slot\n    jnz %c, @tight_spin, @done\n")
  cap_sb.write_string("@done\n    ret 0\n}\n")
  let out_cap = inline_native_rc_ssa(cap_sb.to_string())
  // Exact 24 expansions total: 0..21 (%x inc), 22 (%y dec), 23 (%y inc); zero id 24.
  assert_true(out_cap.contains("@_rci_fast_21"), out_cap)
  assert_true(out_cap.contains("@_rcd_fast_22"), out_cap)
  assert_true(out_cap.contains("@_rci_fast_23"), out_cap)
  assert_eq(out_cap.contains("@_rci_fast_24"), false)
  assert_eq(out_cap.contains("@_rcd_fast_24"), false)
  // Both %y sites in @tight_spin (rank 1) MUST expand:
  assert_eq(out_cap.contains("call $pion_rc_inc(l %y)\n    storel"), false)
  assert_eq(out_cap.contains("call $pion_rc_dec(l %y)\n    storel"), false)
  // Source-order truncation on equal-rank %x sites: @big_loop0 expands, @big_loop5 stays compact:
  let bl0_pos = p18_find_from(out_cap, "@big_loop0\n", 0)
  let bl1_pos = p18_find_from(out_cap, "@big_loop1\n", bl0_pos)
  let bl5_pos = p18_find_from(out_cap, "@big_loop5\n", 0)
  let ts_pos = p18_find_from(out_cap, "@tight_spin\n", bl5_pos)
  assert_true(bl0_pos >= 0 && bl1_pos > bl0_pos && bl5_pos > bl1_pos && ts_pos > bl5_pos, out_cap)
  let bl0_slice = slice_str(out_cap, bl0_pos, bl1_pos)
  let bl5_slice = slice_str(out_cap, bl5_pos, ts_pos)
  assert_true(bl0_slice.contains("@_rci_fast_0"), bl0_slice)
  assert_eq(bl0_slice.contains("call $pion_rc_inc(l %x)\n    storel"), false)
  assert_eq(bl5_slice.contains("@_rci_fast_"), false)
  assert_true(bl5_slice.contains("call $pion_rc_inc(l %x)\n    storel"), bl5_slice)

  // 4. AA2-2c: Mixed SCC per-block uncapped isolation:
  //    A 25-block linear cycle (branch_blks <= 1, 0 RC sites) in the SAME function
  //    must NOT exempt a separate 6-block 30-RC-site loop from the 24-site cap.
  let mix_sb = StringBuilder()
  mix_sb.write_string("export function w $mixed_linear_and_hot_scc(l %x, l %slot, w %c) {\n@entry\n")
  let mut mp = 0
  while mp < 70 {
    mix_sb.write_string("    %mp" + mp.to_string() + " =w add %c, 1\n")
    mp = mp + 1
  }
  mix_sb.write_string("    jmp @lin0\n")
  let mut mi = 0
  while mi < 25 {
    mix_sb.write_string("@lin" + mi.to_string() + "\n    %lv" + mi.to_string() + " =w add %c, 1\n")
    mi = mi + 1
  }
  mix_sb.write_string("    jnz %c, @lin0, @hot0\n")
  let mut hi = 0
  while hi < 6 {
    mix_sb.write_string("@hot" + hi.to_string() + "\n")
    let mut hr = 0
    while hr < 5 {
      mix_sb.write_string("    call $pion_rc_inc(l %x)\n    storel %x, %slot\n")
      hr = hr + 1
    }
    if hi + 1 < 6 {
      mix_sb.write_string("    jmp @hot" + (hi + 1).to_string() + "\n")
    } else {
      mix_sb.write_string("    jnz %c, @hot0, @done\n")
    }
    hi = hi + 1
  }
  mix_sb.write_string("@done\n    ret 0\n}\n")
  let out_mix_scc = inline_native_rc_ssa(mix_sb.to_string())
  assert_true(out_mix_scc.contains("@_rci_fast_23"), out_mix_scc)
  assert_eq(out_mix_scc.contains("@_rci_fast_24"), false)
  let hot5_pos = p18_find_from(out_mix_scc, "@hot5\n", 0)
  let hot_done_pos = p18_find_from(out_mix_scc, "@done\n", hot5_pos)
  assert_true(hot5_pos >= 0 && hot_done_pos > hot5_pos, out_mix_scc)
  let hot5_slice = slice_str(out_mix_scc, hot5_pos, hot_done_pos)
  assert_eq(hot5_slice.contains("@_rci_fast_"), false)
  assert_true(hot5_slice.contains("call $pion_rc_inc(l %x)\n    storel"), hot5_slice)

  // 5. AA2-2d: Oversized self-loop (>64 eff_insts) inside a branched giant SCC
  //    must NOT bypass compact filtering; a compact self-loop (<=64 eff_insts)
  //    in the same giant SCC MUST still expand.
  let self_giant_sb = StringBuilder()
  self_giant_sb.write_string("export function w $giant_scc_self_loops(l %x, l %y, l %slot, w %c) {\n@entry\n    jmp @outer_hdr\n")
  self_giant_sb.write_string("@outer_hdr\n    jnz %c, @arm0, @huge_self\n")
  let mut sbi = 0
  while sbi < 25 {
    self_giant_sb.write_string("@arm" + sbi.to_string() + "\n    %av" + sbi.to_string() + " =w add %c, 1\n")
    if sbi + 1 < 25 {
      self_giant_sb.write_string("    jnz %c, @arm" + (sbi + 1).to_string() + ", @outer_hdr\n")
    } else {
      self_giant_sb.write_string("    jnz %c, @tiny_self, @done\n")
    }
    sbi = sbi + 1
  }
  // Oversized self-loop (>64 eff_insts): must NOT expand
  self_giant_sb.write_string("@huge_self\n")
  let mut hsi = 0
  while hsi < 66 {
    self_giant_sb.write_string("    %hs" + hsi.to_string() + " =w add %c, 1\n")
    hsi = hsi + 1
  }
  self_giant_sb.write_string("    call $pion_rc_inc(l %x)\n    storel %x, %slot\n    jnz %c, @huge_self, @outer_hdr\n")
  // Compact self-loop (<=64 eff_insts): MUST expand
  self_giant_sb.write_string("@tiny_self\n    call $pion_rc_inc(l %y)\n    storel %y, %slot\n    jnz %c, @tiny_self, @outer_hdr\n")
  self_giant_sb.write_string("@done\n    ret 0\n}\n")
  let out_sg = inline_native_rc_ssa(self_giant_sb.to_string())
  assert_true(out_sg.contains("@_rci_fast_0"), out_sg)
  assert_eq(out_sg.contains("@_rci_fast_1"), false)
  assert_true(out_sg.contains("call $pion_rc_inc(l %x)\n    storel"), out_sg)
  assert_eq(out_sg.contains("call $pion_rc_inc(l %y)\n    storel"), false)

  // 6. AA2-3: Strictly-forward diamond DAG skips Tarjan cleanly (no expansion when
  //    large & cold, still propagates 1-hop callees when called from a loop).
  let ssa_dag =
    #|export function w $dag_driver(l %x, l %slot, w %n) {
    #|@start
    #|    jmp @loop
    #|@loop
    #|    %r =w call $dag_mid(l %x, l %slot, w %n)
    #|    jnz %n, @loop, @exit
    #|@exit
    #|    ret %r
    #|}
    #|export function w $dag_mid(l %x, l %slot, w %c) {
    #|@entry
    #|    jnz %c, @left, @right
    #|@left
    #|    %a =w call $dag_leaf(l %x, l %slot)
    #|    jmp @merge
    #|@right
    #|    %b =w copy 0
    #|    jmp @merge
    #|@merge
    #|    %res =w phi @left %a, @right %b
    #|    ret %res
    #|}
    #|export function w $dag_leaf(l %x, l %slot) {
    #|@start
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_inc(l %x)
    #|    storel %x, %slot
    #|    call $pion_rc_dec(l %x)
    #|    ret 0
    #|}
    #|
  let out_dag = inline_native_rc_ssa(ssa_dag)
  let fn_dag_leaf = j2_extract_fn(out_dag, "export function w $dag_leaf(")
  assert_true(fn_dag_leaf.contains("@_rci_fast_0"), fn_dag_leaf)
}

///|
test "j3: unique eq helper encoding avoids Box[Int] vs Box_i collision" {
  let src =
    #|#derive(Eq)
    #|struct Box[T] { a : T }
    #|#derive(Eq)
    #|struct Box_i { a : Int, b : Int }
    #|pub fn check_both() -> Bool {
    #|  let x1 : ImmArray[Box[Int]] = [Box::{ a: 1 }]
    #|  let x2 : ImmArray[Box[Int]] = [Box::{ a: 1 }]
    #|  let y1 : ImmArray[Box_i] = [Box_i::{ a: 1, b: 2 }]
    #|  let y2 : ImmArray[Box_i] = [Box_i::{ a: 1, b: 3 }]
    #|  (x1 == x2) && (y1 != y2)
    #|}
  let cr = check_source_files_full("j3_eq_uniq", ["main.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(ssa.contains("function w $pion_eq_iarr_st_0N3_Box_A1_i("), ssa)
  assert_true(ssa.contains("function w $pion_eq_iarr_st_0N6_Box_ui_A0("), ssa)
}

///|
test "j3 r6: prefix-free 2-arg mono & Result/Map mangling avoids split ambiguity" {
  let src =
    #|struct A { x : Int }
    #|struct B_p__C { x : Int, y : Int }
    #|struct A_p__B { x : Int, y : Int, z : Int }
    #|struct C { x : Int }
    #|fn id[T](v : T) -> T { v }
    #|fn pair_sum[X, Y](x : X, y : Y) -> Int {
    #|  let _ = x
    #|  let _ = y
    #|  1
    #|}
    #|pub fn check_all() -> Int {
    #|  let a = A::{ x: 1 }
    #|  let bc = B_p__C::{ x: 2, y: 3 }
    #|  let ab = A_p__B::{ x: 4, y: 5, z: 6 }
    #|  let c = C::{ x: 7 }
    #|  let r1 : Result[A, B_p__C] = Ok(a)
    #|  let r2 : Result[A_p__B, C] = Err(c)
    #|  let _ = id(r1)
    #|  let _ = id(r2)
    #|  pair_sum(a, bc) + pair_sum(ab, c)
    #|}
  let cr = check_source_files_with_imports("p", ["main.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, []).ssa
  assert_true(ssa.contains("pair_sum__mono_0L4_p__A_0L9_p__B_p__C("), ssa)
  assert_true(ssa.contains("pair_sum__mono_0L9_p__A_p__B_0L4_p__C("), ssa)
  assert_true(ssa.contains("id__mono_Result_0L4_p__A_0L9_p__B_p__C("), ssa)
  assert_true(ssa.contains("id__mono_Result_0L9_p__A_p__B_0L4_p__C("), ssa)
}

///|
enum SsaSlimK2 {
  G(Int)
  A
  B
  C
}

///|
fn ssa_slim_match_k2(k : SsaSlimK2) -> Int {
  match k {
    G(_) | A | B => 7
    C => 9
  }
}

///|
fn ssa_slim_bool_complex(a : Bool, b : Bool, c : Bool, d : Bool) -> Bool {
  a && (if b { c } else { d })
}

///|
fn ssa_slim_and_ret(a : Bool) -> Int {
  let _ = a && { return 1 }
  2
}

///|
fn ssa_slim_or_ret(a : Bool) -> Int {
  let _ = a || { return 1 }
  2
}

///|
fn ssa_slim_nested_bound_cf(n : Int, do_break : Bool) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < n {
    let held = i.to_string()
    let skip = i % 2 == 0
    i = i + 1
    // A range bound of a nested loop runs in the outer loop body (a `while`
    // condition may not hold `break` / `continue`).
    for _k in 0..<(if skip { if do_break { break } else { continue } } else { held.length() }) {
      break
    }
    acc = acc + held.length()
  }
  acc
}

///|
test "ssa_slim: match or-arm sharing, loop-gated fast paths, immortal RC skip, and bool phi" {
  let src =
    #|enum K { A, B, C, D, E, F, G(Int), H }
    #|enum K2 { G(Int), A, B, C }
    #|pub fn or_jtbl(k : K, s : String) -> Bool {
    #|  match k {
    #|    A | B | C | D | E | F => s == "foo" || s == "bar"
    #|    G(_) => false
    #|    H => true
    #|  }
    #|}
    #|pub fn or_jtbl_payload_first(k : K2) -> Int {
    #|  match k {
    #|    G(_) | A | B => 7
    #|    C => 9
    #|  }
    #|}
    #|pub fn or_linear(x : Int) -> Int {
    #|  match x {
    #|    1 | 2 | 3 => 10
    #|    _ => 20
    #|  }
    #|}
    #|pub fn cold_ops(xs : Array[Int], s : String) -> Bool {
    #|  xs.push(1)
    #|  s == "abc"
    #|}
    #|pub fn hot_ops(xs : Array[Int], s : String, n : Int) -> Int {
    #|  let mut i = 0
    #|  let mut acc = 0
    #|  while i < n && s == "abc" {
    #|    xs.push(i)
    #|    acc = acc + 1
    #|    i = i + 1
    #|  }
    #|  acc
    #|}
    #|pub fn immortal_rc() -> String {
    #|  let a = "hello"
    #|  let b = a
    #|  b
    #|}
    #|pub fn bool_phi(a : Bool, b : Bool, c : Bool) -> Bool {
    #|  (a && b) || c
    #|}
    #|pub fn bool_phi_complex(a : Bool, b : Bool, c : Bool, d : Bool) -> Bool {
    #|  a && (if b { c } else { d })
    #|}
    #|pub fn bool_phi_ret(a : Bool) -> Int {
    #|  let _ = a && { return 1 }
    #|  2
    #|}
    #|pub fn bool_phi_or_ret(a : Bool) -> Int {
    #|  let _ = a || { return 1 }
    #|  2
    #|}
    #|pub fn nested_bound_cont(n : Int) -> Int {
    #|  let mut i = 0
    #|  let mut acc = 0
    #|  while i < n {
    #|    let held = i.to_string()
    #|    let skip = i % 2 == 0
    #|    i = i + 1
    #|    for _k in 0..<(if skip { continue } else { held.length() }) {
    #|      break
    #|    }
    #|    acc = acc + held.length()
    #|  }
    #|  acc
    #|}
  let cr = check_source_files_full("ssa_slim", ["main.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa

  // 1. jtbl or-arm sharing: 6 variants A..F share ONE @em_arm_ body -> at most 3 @em_arm_ labels total
  let js = p18_find_from(ssa, "$pion_fn_or_jtbl(", 0)
  let je = p18_find_from(ssa, "\n}", js)
  assert_true(js >= 0 && je > js, ssa)
  let mut em_cnt = 0
  let mut p = js
  while true {
    let hit = p18_find_from(ssa, "\n@em_arm_", p)
    if hit < 0 || hit >= je {
      break
    }
    em_cnt = em_cnt + 1
    p = hit + 9
  }
  assert_eq(em_cnt, 3)

  // 1b. jtbl payload-first shared arm `G(_) | A | B => 7`: zero payload `add ..., 8` / load in @em_arm_
  let ps = p18_find_from(ssa, "$pion_fn_or_jtbl_payload_first(", 0)
  let pe = p18_find_from(ssa, "\n}", ps)
  assert_true(ps >= 0 && pe > ps, ssa)
  let pf_arm = p18_find_from(ssa, "\n@em_arm_", ps)
  let pf_end = p18_find_from(ssa, "\n@match_end_", pf_arm)
  assert_true(pf_arm > ps && pf_end > pf_arm && pf_end < pe, ssa)
  let pf_add8 = p18_find_from(ssa, ", 8\n", pf_arm)
  assert_true(pf_add8 < 0 || pf_add8 > pf_end, ssa)
  let pf_load = p18_find_from(ssa, "load", pf_arm)
  assert_true(pf_load < 0 || pf_load > pf_end, ssa)

  // 2. linear or-arm sharing: @match_arm_ emitted once for 1 | 2 | 3
  let ls = p18_find_from(ssa, "$pion_fn_or_linear(", 0)
  let le = p18_find_from(ssa, "\n}", ls)
  assert_true(ls >= 0 && le > ls, ssa)
  let larm = p18_find_from(ssa, "@match_arm_", ls)
  assert_true(larm > ls && larm < le, ssa)

  // 3. cold vs hot loop gating (including short-str == in while condition)
  let cs = p18_find_from(ssa, "$pion_fn_cold_ops(", 0)
  let ce = p18_find_from(ssa, "\n}", cs)
  assert_true(cs >= 0 && ce > cs, ssa)
  let c_ap = p18_find_from(ssa, "@ap_fast_", cs)
  let c_seq = p18_find_from(ssa, "@seq_l_", cs)
  assert_true(c_ap < 0 || c_ap > ce, ssa)
  assert_true(c_seq < 0 || c_seq > ce, ssa)
  let hs = p18_find_from(ssa, "$pion_fn_hot_ops(", 0)
  let he = p18_find_from(ssa, "\n}", hs)
  assert_true(hs >= 0 && he > hs, ssa)
  let h_ap = p18_find_from(ssa, "@ap_fast_", hs)
  let h_seq = p18_find_from(ssa, "@seq_l_", hs)
  assert_true(h_ap > hs && h_ap < he, ssa)
  assert_true(h_seq > hs && h_seq < he, ssa)

  // 4. immortal string skips rc_inc/rc_dec
  let is0 = p18_find_from(ssa, "$pion_fn_immortal_rc(", 0)
  let ie0 = p18_find_from(ssa, "\n}", is0)
  assert_true(is0 >= 0 && ie0 > is0, ssa)
  let i_inc = p18_find_from(ssa, "$pion_rc_inc", is0)
  let i_dec = p18_find_from(ssa, "$pion_rc_dec", is0)
  assert_true(i_inc < 0 || i_inc > ie0, ssa)
  assert_true(i_dec < 0 || i_dec > ie0, ssa)

  // 5. bool && / || uses phi (including complex branching RHS & diverging return RHS)
  let bs = p18_find_from(ssa, "$pion_fn_bool_phi(", 0)
  let be = p18_find_from(ssa, "\n}", bs)
  assert_true(bs >= 0 && be > bs, ssa)
  let b_phi = p18_find_from(ssa, " =l phi ", bs)
  assert_true(b_phi > bs && b_phi < be, ssa)
  let bcs = p18_find_from(ssa, "$pion_fn_bool_phi_complex(", 0)
  let bce = p18_find_from(ssa, "\n}", bcs)
  assert_true(bcs >= 0 && bce > bcs, ssa)
  let bc_phi = p18_find_from(ssa, " =l phi ", bcs)
  assert_true(bc_phi > bcs && bc_phi < bce, ssa)

  // 5b. `continue` from a nested loop's range bound must still release the outer loop's owned `held` local
  let iw_s = p18_find_from(ssa, "$pion_fn_nested_bound_cont(", 0)
  let iw_e = p18_find_from(ssa, "\n}", iw_s)
  assert_true(iw_s >= 0 && iw_e > iw_s, ssa)
  // Expect at least 2 `$pion_rc_dec` calls in the function: one on the range-bound `continue` edge
  // releasing outer `held`, and one at normal end of the outer loop body.
  let iw_dec1 = p18_find_from(ssa, "$pion_rc_dec(", iw_s)
  let iw_dec2 = p18_find_from(ssa, "$pion_rc_dec(", iw_dec1 + 1)
  assert_true(iw_dec1 > iw_s && iw_dec2 > iw_dec1 && iw_dec2 < iw_e, ssa)

  // 6. Runtime verification of payload-first shared jtbl arm, complex bool phi & nested range-bound cf
  assert_eq(ssa_slim_match_k2(SsaSlimK2::G(42)), 7)
  assert_eq(ssa_slim_match_k2(SsaSlimK2::A), 7)
  assert_eq(ssa_slim_match_k2(SsaSlimK2::B), 7)
  assert_eq(ssa_slim_match_k2(SsaSlimK2::C), 9)
  assert_eq(ssa_slim_bool_complex(false, true, true, true), false)
  assert_eq(ssa_slim_bool_complex(true, true, true, false), true)
  assert_eq(ssa_slim_bool_complex(true, true, false, true), false)
  assert_eq(ssa_slim_bool_complex(true, false, true, false), false)
  assert_eq(ssa_slim_bool_complex(true, false, false, true), true)
  assert_eq(ssa_slim_and_ret(true), 1)
  assert_eq(ssa_slim_and_ret(false), 2)
  assert_eq(ssa_slim_or_ret(true), 2)
  assert_eq(ssa_slim_or_ret(false), 1)
  assert_eq(ssa_slim_nested_bound_cf(6, false), 3)
  assert_eq(ssa_slim_nested_bound_cf(6, true), 0)
}

///|
test "wave_l0: QBE lowering for nested tuple patterns, Array truncate/is_empty, Double methods/hash, Int lnot" {
  let src =
    #|pub fn f_pat(o : Option[(Int, String)]) -> Int {
    #|  let a = match o {
    #|    Some((1, s)) => s.length()
    #|    Some((k, s)) => k + s.length()
    #|    None => 0
    #|  }
    #|  let b = if let Some((x, _)) = o { x } else { -1 }
    #|  a + b
    #|}
    #|pub fn f_arr(xs : Array[String], n : Int) -> Bool {
    #|  xs.truncate(n)
    #|  xs.is_empty()
    #|}
    #|pub fn f_dbl(a : Double, b : Double) -> Int {
    #|  let n = if a.is_nan() { 1 } else { 0 }
    #|  let c = a.compare(b)
    #|  let bits = a.reinterpret_as_int64()
    #|  let m : Map[Double, Int] = Map([])
    #|  m.set(-0.0, 42)
    #|  n + c + bits.to_int() + m.get(0.0).unwrap_or(0)
    #|}
    #|pub fn f_lnot(a : Int, b : Int64, c : UInt, d : UInt64) -> Int64 {
    #|  a.lnot().to_int64() + b.lnot() + c.lnot().to_int64() + d.lnot().to_int64()
    #|}
  let cr = check_source_files_full("wave_l0_be", ["main.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(ssa.contains("call $pion_arr_truncate("), ssa)
  assert_true(ssa.contains("cned "), ssa)
  assert_true(ssa.contains("cltd "), ssa)
  assert_true(ssa.contains("cgtd "), ssa)
  assert_true(ssa.contains("xor "), ssa)
  assert_true(ssa.contains("-9223372036854775808"), ssa)
  assert_true(ssa.contains("ceqd "), ssa)

  // Wave L0 R4 (Astra #1): generic trait dispatch `x.to_int()` in `match xs[0]` guard must NOT
  // borrow `xs[0]` even when T is instantiated as `Byte`, whereas concrete `Byte.to_int()` may borrow.
  let guard_src =
    #|let G_XS : Array[String] = ["alpha_heap_string_1234567890", "beta"]
    #|trait BadToInt {
    #|  fn to_int(self : Self) -> Int
    #|}
    #|impl BadToInt for Byte {
    #|  fn to_int(self : Byte) -> Int {
    #|    G_XS.truncate(0)
    #|    self.to_int()
    #|  }
    #|}
    #|pub fn f_gen[T : BadToInt](x : T, xs : Array[String]) -> Int {
    #|  match xs[0] {
    #|    s if x.to_int() >= 0 => s.length()
    #|    _ => -1
    #|  }
    #|}
    #|pub fn f_concrete(x : Byte, xs : Array[String]) -> Int {
    #|  match xs[0] {
    #|    s if x.to_int() >= 0 => s.length()
    #|    _ => -1
    #|  }
    #|}
    #|pub fn run_guard_check() -> Int {
    #|  let a = f_concrete((1).to_byte(), G_XS)
    #|  let b = f_gen((1).to_byte(), G_XS)
    #|  a + b
    #|}
  let cr2 = check_source_files_full("wave_l0_guard", ["main.pion"], [guard_src])
  assert_true(cr2.diagnostics.length() == 0, check_result_to_json(cr2.diagnostics))
  let ssa2 = emit_qbe_package_with_tc(cr2.pkg, cr2.tc, false).ssa
  let gen_s = p18_find_from(ssa2, "function w $pion_fn_f_gen__mono_Byte(", 0)
  assert_true(gen_s >= 0, ssa2)
  let gen_e = p18_find_from(ssa2, "\n}\n", gen_s)
  assert_true(gen_e > gen_s, ssa2)
  // Generic trait guard must retain scrutinee xs[0] AND binding s -> >= 2 rc_inc calls.
  let gen_inc1 = p18_find_from(ssa2, "call $pion_rc_inc(", gen_s)
  let gen_inc2 = p18_find_from(ssa2, "call $pion_rc_inc(", gen_inc1 + 1)
  assert_true(gen_inc1 > gen_s && gen_inc2 > gen_inc1 && gen_inc2 < gen_e, "generic trait guard must retain xs[0]: " + ssa2)
  let con_s = p18_find_from(ssa2, "function w $pion_fn_f_concrete(", 0)
  assert_true(con_s >= 0, ssa2)
  let con_e = p18_find_from(ssa2, "\n}\n", con_s)
  assert_true(con_e > con_s, ssa2)
  // Concrete Byte.to_int guard borrows scrutinee xs[0] -> exactly 1 rc_inc (for binding s), no second rc_inc.
  let con_inc1 = p18_find_from(ssa2, "call $pion_rc_inc(", con_s)
  let con_inc2 = if con_inc1 >= 0 && con_inc1 < con_e { p18_find_from(ssa2, "call $pion_rc_inc(", con_inc1 + 1) } else { -1 }
  assert_true(
    con_inc1 > con_s && con_inc1 < con_e && (con_inc2 < 0 || con_inc2 > con_e),
    "concrete Byte.to_int guard must have exactly 1 rc_inc (for binding s, not scrutinee): " + ssa2,
  )
}

///|
test "qbe_block_needs_data_ptr_scan_rows" {
  let sp = span_new("t.pion", 1, 1)
  let unit = SExpr(EUnit(sp), sp)
  let bind = SLet("a", false, TyMissing(sp), EInt("1", sp), sp)
  let tup = SLetTuple(["a", "b"], TyMissing(sp), EInt("1", sp), sp)
  let guard_stmt = SGuard(EBool(true, sp), [], sp)
  assert_eq(qbe_block_needs_data_ptr_scan([]), false)
  assert_eq(qbe_block_needs_data_ptr_scan([unit, unit]), false)
  assert_eq(qbe_block_needs_data_ptr_scan([bind]), false)
  assert_eq(qbe_block_needs_data_ptr_scan([unit, tup]), false)
  assert_eq(qbe_block_needs_data_ptr_scan([bind, unit]), true)
  assert_eq(qbe_block_needs_data_ptr_scan([unit, tup, unit]), true)
  assert_eq(qbe_block_needs_data_ptr_scan([bind, bind]), true)
  assert_eq(qbe_block_needs_data_ptr_scan([guard_stmt]), true)
  assert_eq(qbe_block_needs_data_ptr_scan([unit, guard_stmt]), true)
}

///|
test "j1.1: strict w-class jnz/jtbl invariant across generic %tp_*, TBool, Int64 and wasm" {
  let src =
    #|pub fn wrap_id[T](x : T) -> T { x }
    #|pub fn test_64(v : Int64) -> Int {
    #|  let nz = v != 0L
    #|  let low = v.to_int() != 0
    #|  if nz && !low { 2 } else if nz || low { 1 } else { 0 }
    #|}
    #|pub fn test_jtbl(k : Int) -> Int {
    #|  match k {
    #|    0 => 10
    #|    1 => 20
    #|    2 => 30
    #|    3 => 40
    #|    4 => 50
    #|    5 => 60
    #|    _ => -1
    #|  }
    #|}
    #|pub fn main() -> Int {
    #|  let s = wrap_id("hi")
    #|  let b = true
    #|  let _ = b.to_string() + "\{b}"
    #|  test_64(0L) + test_64(1L) + test_64(1L << 32) + test_jtbl(-1) + test_jtbl(0) + test_jtbl(6) + s.length()
    #|}
  let cr = check_source_files_full("j11_strict", ["j11.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // Scan EVERY function in emitted SSA: no `jnz` or `jtbl` may branch on an `l` temp/param!
  let lines = ssa.split("\n")
  let mut l_tmps : Map[String, Bool] = Map([])
  let mut fn_hdr = ""
  let mut i = 0
  while i < lines.length() {
    let ln = lines[i]
    if ln.starts_with("function ") || ln.starts_with("export function ") {
      fn_hdr = ln
      l_tmps = Map([])
      let mut p = p18_find_from(ln, "l %", 0)
      while p >= 0 {
        l_tmps.set(p84_tmp_at(ln, p + 2), true)
        p = p18_find_from(ln, "l %", p + 3)
      }
    } else if ln.starts_with("    %") && ln.contains(" =l ") {
      l_tmps.set(p84_tmp_at(ln, 4), true)
    } else if ln.starts_with("    jnz %") {
      let arg = p84_tmp_at(ln, 8)
      assert_true(!l_tmps.contains(arg), "non-w jnz in " + fn_hdr + " :: " + ln)
    } else if ln.starts_with("    jtbl %") {
      let arg = p84_tmp_at(ln, 9)
      assert_true(!l_tmps.contains(arg), "non-w jtbl in " + fn_hdr + " :: " + ln)
    }
    i = i + 1
  }
  // Wasm32 strict-jnz entry guard accepts the emitted SSA
  let wasm_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, false, "wasm32").ssa
  let wasm_bytes = emit_wasm_from_ssa(wasm_ssa)
  assert_true(wasm_bytes.length() > 8, "wasm bytes generated")
}

///|
test "j1.4: deep 2500-term left/right/short-circuit chains compile on Native and Wasm32" {
  // Left-chained `+`, right-nested `1 + (1 + ...)`, and short-circuit `||`
  let sb_left = StringBuilder()
  sb_left.write_string("pub fn main() -> Int {\n  let x = 1")
  let mut i = 0
  while i < 2500 {
    sb_left.write_string(" + 1")
    i = i + 1
  }
  sb_left.write_string("\n  x\n}\n")
  let cr_l = check_source_files_full("j14_l", ["l.pion"], [sb_left.to_string()])
  assert_true(cr_l.diagnostics.length() == 0, check_result_to_json(cr_l.diagnostics))
  let w_l = emit_wasm_from_ssa(emit_qbe_package_with_tc_target(cr_l.pkg, cr_l.tc, false, "wasm32").ssa)
  assert_true(w_l.length() > 8, "left wasm ok")

  let sb_right = StringBuilder()
  sb_right.write_string("pub fn main() -> Int {\n  let x = ")
  i = 0
  while i < 2500 {
    sb_right.write_string("1 + (")
    i = i + 1
  }
  sb_right.write_string("1")
  i = 0
  while i < 2500 {
    sb_right.write_string(")")
    i = i + 1
  }
  sb_right.write_string("\n  x\n}\n")
  let cr_r = check_source_files_full("j14_r", ["r.pion"], [sb_right.to_string()])
  assert_true(cr_r.diagnostics.length() == 0, check_result_to_json(cr_r.diagnostics))
  let w_r = emit_wasm_from_ssa(emit_qbe_package_with_tc_target(cr_r.pkg, cr_r.tc, false, "wasm32").ssa)
  assert_true(w_r.length() > 8, "right wasm ok")

  // Deep right-nested `2.0 * (2.0 * (...))` must stay iterative (no recursion in 2.0*x shortcut)
  let sb_mul2 = StringBuilder()
  sb_mul2.write_string("pub fn main() -> Double {\n  let x = ")
  i = 0
  while i < 2000 {
    sb_mul2.write_string("2.0 * (")
    i = i + 1
  }
  sb_mul2.write_string("1.0")
  i = 0
  while i < 2000 {
    sb_mul2.write_string(")")
    i = i + 1
  }
  sb_mul2.write_string("\n  x\n}\n")
  let cr_m2 = check_source_files_full("j14_m2", ["m2.pion"], [sb_mul2.to_string()])
  assert_true(cr_m2.diagnostics.length() == 0, check_result_to_json(cr_m2.diagnostics))
  let w_m2 = emit_wasm_from_ssa(emit_qbe_package_with_tc_target(cr_m2.pkg, cr_m2.tc, false, "wasm32").ssa)
  assert_true(w_m2.length() > 8, "mul2 right-chain wasm ok")
}

///|
test "j1.5: per-unit init_all calls per-const init functions in topological order" {
  let u0 =
    #|let A : Int = get_b() + 1
    #|let C : Int = 10
    #|pub fn main() -> Int { A }
  let u1 =
    #|let B : Int = C + 5
    #|fn get_b() -> Int { B }
  let prep = match cli_prepare_qbe_units("j15u", ["u0.pion", "u1.pion"], [u0, u1]) {
    Ok(p) => p
    Err(e) => {
      assert_true(false, e)
      return
    }
  }
  let ssa0 = emit_qbe_unit(prep, 0, false)
  let ssa1 = emit_qbe_unit(prep, 1, false)
  assert_true(ssa0.contains("export function $pion_init_const_A()"), ssa0)
  assert_true(ssa0.contains("export function $pion_init_const_C()"), ssa0)
  assert_true(ssa1.contains("export function $pion_init_const_B()"), ssa1)
  let pos_c = p18_find_from(ssa0, "call $pion_init_const_C()", 0)
  let pos_b = p18_find_from(ssa0, "call $pion_init_const_B()", 0)
  let pos_a = p18_find_from(ssa0, "call $pion_init_const_A()", 0)
  assert_true(pos_c > 0 && pos_b > pos_c && pos_a > pos_b, ssa0)
}

///|
test "j1.r3: wasm_check_strict_jnz rejects undefined and l-class for jnz & jtbl, accepts w-class" {
  // 1. jnz: undefined %u (reject), l-class %x (reject), w-class %c (accept)
  let jnz_undef = "export function w $f() {\n@start\n    jnz %u, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let jnz_l = "export function w $f(l %x) {\n@start\n    jnz %x, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let jnz_w = "export function w $f(w %c) {\n@start\n    jnz %c, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let r_ju = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jnz_undef], fn(_s) { () }).funcs)
  match r_ju {
    Err(m) => assert_true(m.contains("is undefined"), m)
    Ok(_) => assert_true(false, "jnz %u must be rejected")
  }
  let r_jl = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jnz_l], fn(_s) { () }).funcs)
  match r_jl {
    Err(m) => assert_true(m.contains("has non-w class"), m)
    Ok(_) => assert_true(false, "jnz l %x must be rejected")
  }
  let r_jw = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jnz_w], fn(_s) { () }).funcs)
  match r_jw {
    Ok(_) => ()
    Err(m) => assert_true(false, "jnz w %c must be accepted: " + m)
  }

  // 2. jtbl: undefined %u (reject), l-class %x (reject), w-class %c (accept)
  let jtbl_undef = "export function w $f() {\n@start\n    jtbl %u, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let jtbl_l = "export function w $f(l %x) {\n@start\n    jtbl %x, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let jtbl_w = "export function w $f(w %c) {\n@start\n    jtbl %c, @a, @b\n@a\n    ret 1\n@b\n    ret 0\n}\n"
  let r_tu = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jtbl_undef], fn(_s) { () }).funcs)
  match r_tu {
    Err(m) => assert_true(m.contains("is undefined"), m)
    Ok(_) => assert_true(false, "jtbl %u must be rejected")
  }
  let r_tl = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jtbl_l], fn(_s) { () }).funcs)
  match r_tl {
    Err(m) => assert_true(m.contains("has non-w class"), m)
    Ok(_) => assert_true(false, "jtbl l %x must be rejected")
  }
  let r_tw = wasm_check_strict_jnz(wasm_parse_ssa_live_units([jtbl_w], fn(_s) { () }).funcs)
  match r_tw {
    Ok(_) => ()
    Err(m) => assert_true(false, "jtbl w %c must be accepted: " + m)
  }
}

///|
test "j1.r3: deep 2500-term && with is-bindings, 2.0*x add strength reduction & xpkg mono_pkg guard" {
  // 1. 2500-term `&&` condition with `is` bindings compiles on Native & Wasm32
  let sb_and = StringBuilder()
  sb_and.write_string("pub fn check_deep(x : Option[Int]) -> Int {\n  if x is Some(v0)")
  let mut i = 1
  while i < 2500 {
    sb_and.write_string(" && (v0 >= 0)")
    i = i + 1
  }
  sb_and.write_string(" {\n    v0\n  } else {\n    0\n  }\n}\n")
  let cr_and = check_source_files_full("deep_and_is", ["deep_and_is.pion"], [sb_and.to_string()])
  assert_true(cr_and.diagnostics.length() == 0, check_result_to_json(cr_and.diagnostics))
  let w_and = emit_wasm_from_ssa(emit_qbe_package_with_tc_target(cr_and.pkg, cr_and.tc, false, "wasm32").ssa)
  assert_true(w_and.length() > 8, "deep && with is-binding wasm ok")

  // 2. Right-nested `2.0 * (2.0 * (2.0 * x))` uses `=d add` (no `=d mul`)
  let m2_src = "pub fn oct(x : Double) -> Double { 2.0 * (2.0 * (2.0 * x)) }\n"
  let cr_m2 = check_source_files_full("m2_add", ["m2_add.pion"], [m2_src])
  assert_true(cr_m2.diagnostics.length() == 0, check_result_to_json(cr_m2.diagnostics))
  let ssa_m2 = emit_qbe_package_with_tc(cr_m2.pkg, cr_m2.tc, false).ssa
  assert_true(ssa_m2.contains(" =d add "), ssa_m2)
  assert_eq(ssa_m2.contains(" =d mul "), false)

  // 3. Cross-package monomorphized generic must NOT call importer's top-level closure const of same name
  let lib_src =
    #|pub trait Tag {
    #|  tag(self : Self) -> Int
    #|}
    #|pub fn helper(n : Int) -> Int {
    #|  let mut acc = 7
    #|  let mut k = 0
    #|  while k < n {
    #|    acc = acc + k
    #|    k = k + 1
    #|  }
    #|  acc
    #|}
    #|pub fn run_gen[T : Tag](x : T) -> Int { helper(x.tag()) }
  let lib_cr = check_source_files_with_imports("mlib", ["mlib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let app_src =
    #|import "mlib"
    #|struct Item { v : Int }
    #|impl mlib::Tag for Item {
    #|  fn tag(self : Item) -> Int { self.v }
    #|}
    #|let helper : (Int) -> Int = fn(n : Int) -> Int { n + 99 }
    #|pub fn main() -> Int { mlib::run_gen(Item::{ v: 3 }) + helper(1) }
  let app_cr = check_source_files_with_imports(
    "mapp", ["mapp.pion"], [app_src], [imported_pkg_new("mlib", lib_cr.tc)], true,
  )
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, false, false, ["mlib"]).ssa
  let mono_s = p18_find_from(app_ssa, "function w $pion_pkg_mlib_fn_run_gen__mono_", 0)
  let mono_e = p18_find_from(app_ssa, "\n}", mono_s)
  assert_true(mono_s >= 0 && mono_e > mono_s, app_ssa)
  let mono_fn = slice_str(app_ssa, mono_s, mono_e)
  assert_true(mono_fn.contains("$pion_pkg_mlib_fn_helper"), mono_fn)
  assert_eq(mono_fn.contains("const_helper"), false)

  // 4. Swapped fixture: library defines top-level closure const `helper`,
  //    app defines normal `fn helper`; monomorphized generic MUST load `$pion_pkg_clib_const_helper`
  //    (and emit_pion_stub disables stubbing for pub generic fn so driver always loads from source).
  let clib_src =
    #|pub trait Tag2 {
    #|  tag2(self : Self) -> Int
    #|}
    #|let helper : (Int) -> Int = fn(n : Int) -> Int { n + 20 }
    #|pub fn run_gen2[T : Tag2](x : T) -> Int { helper(x.tag2()) }
  let clib_cr = check_source_files_with_imports("clib", ["clib.pion"], [clib_src], [], true)
  assert_true(clib_cr.diagnostics.length() == 0, check_result_to_json(clib_cr.diagnostics))
  assert_eq(emit_pion_stub(clib_cr.pkg), "")
  let capp_src =
    #|import "clib"
    #|struct Item2 { v : Int }
    #|impl clib::Tag2 for Item2 {
    #|  fn tag2(self : Item2) -> Int { self.v }
    #|}
    #|fn helper(n : Int) -> Int { n + 100 }
    #|pub fn main() -> Int { clib::run_gen2(Item2::{ v: 5 }) + helper(1) }
  let capp_cold = check_source_files_with_imports(
    "capp", ["capp.pion"], [capp_src], [imported_pkg_new("clib", clib_cr.tc)], true,
  )
  assert_true(capp_cold.diagnostics.length() == 0, check_result_to_json(capp_cold.diagnostics))
  let capp_ssa_cold = emit_qbe_package_multi(capp_cold.pkg, capp_cold.tc, false, false, ["clib"]).ssa
  let cm_s = p18_find_from(capp_ssa_cold, "function w $pion_pkg_clib_fn_run_gen2__mono_", 0)
  let cm_e = p18_find_from(capp_ssa_cold, "\n}", cm_s)
  assert_true(cm_s >= 0 && cm_e > cm_s, capp_ssa_cold)
  let cm_fn = slice_str(capp_ssa_cold, cm_s, cm_e)
  assert_true(cm_fn.contains("$pion_pkg_clib_const_helper"), cm_fn)
  assert_eq(cm_fn.contains("$pion_pkg_capp_fn_helper"), false)
}

///|
test "wave_l1a: A1 constant pattern QBE no-jtbl & A2 unified EIs SSA" {
  let src =
    #|enum Mode { A; B; C; D }
    #|let DEF : Mode = Mode::A
    #|let TAG : Int = 7
    #|struct G { set : Bool, name : String }
    #|pub fn m_enum(m : Mode) -> Int {
    #|  match m {
    #|    DEF => 10
    #|    Mode::A => 1
    #|    Mode::B => 2
    #|    Mode::C => 3
    #|    Mode::D => 4
    #|  }
    #|}
    #|pub fn m_int(x : Int) -> Int {
    #|  match x {
    #|    TAG => 1
    #|    2 => 2
    #|    _ => 0
    #|  }
    #|}
    #|pub fn neg_is(g : Option[G]) -> Int {
    #|  if !(g is Some(g) && g.set) {
    #|    match g { Some(v) => v.name.length(); None => 0 }
    #|  } else {
    #|    42
    #|  }
    #|}
  let cr = check_source_files_full("l1a_be", ["main.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  let fn_enum = j2_extract_fn(ssa, "function w $pion_fn_m_enum(")
  assert_true(fn_enum.length() > 0, "missing m_enum in SSA")
  assert_true(!fn_enum.contains("jtbl "), "constant pattern enum match must not emit jtbl: " + fn_enum)
  assert_true(fn_enum.contains("const_DEF"), "m_enum must load const_DEF: " + fn_enum)
  let fn_neg = j2_extract_fn(ssa, "function w $pion_fn_neg_is(")
  assert_true(fn_neg.contains("and_is_t"), "neg_is must emit local && cleanup label: " + fn_neg)

  // QBE f_guards stack alignment regression: `dmath::ln` (`(f1 * 2.0 - 1.0)`), `2.0 * x - 1.0`, and nested `&&`/`||`
  let ln_src =
    #|let SQRT2 : Double = 1.4142135623730951
    #|let LN2_HI : Double = 6.93147180369123816490e-01
    #|let LN2_LO : Double = 1.90821492927058770002e-10
    #|fn frexp(x : Double) -> (Double, Int) { let _ = x; (0.6425, 3) }
    #|pub fn ln(x : Double) -> Double {
    #|  let l1 = 6.666666666666735130e-01
    #|  if x < 0.0 {
    #|  }
    #|  let (f1, ki) = frexp(x)
    #|  let (f, k) = if f1 < SQRT2 / 2.0 {
    #|    (f1 * 2.0 - 1.0, (ki - 1).to_double())
    #|  } else {
    #|    (f1 - 1.0, ki.to_double())
    #|  }
    #|  let s = f / (2.0 + f)
    #|  let hfsq = 0.5 * f * f
    #|  let r = l1 * s * s
    #|  k * LN2_HI - (hfsq - (s * (hfsq + r) + k * LN2_LO) - f)
    #|}
    #|pub fn nested_chain(a : Bool, b : Bool, c : Bool, d : Bool, x : Double) -> Double {
    #|  let ok = (a && b) == (c || d)
    #|  if ok { (2.0 * x - 1.0) + (x * 2.0 - 1.0) } else { 0.0 }
    #|}
  let ln_cr = check_source_files_full("l1a_fguards", ["main.pion"], [ln_src])
  assert_true(ln_cr.diagnostics.length() == 0, check_result_to_json(ln_cr.diagnostics))
  let ln_ssa = emit_qbe_package_with_tc(ln_cr.pkg, ln_cr.tc, false).ssa
  assert_true(ln_ssa.contains("function d $pion_fn_ln("), "missing ln in SSA")
  assert_true(ln_ssa.contains("function d $pion_fn_nested_chain("), "missing nested_chain in SSA")
}

///|
test "wave_l1b: NaN-containing struct/Option eq helper disables pointer-identity shortcut" {
  let src =
    #|#derive(Eq)
    #|struct BoxD { v : Double }
    #|#derive(Eq)
    #|struct BoxI { v : Int }
    #|pub fn main() -> Int {
    #|  let bd = BoxD::{ v: 0.0 / 0.0 }
    #|  let bi = BoxI::{ v: 1 }
    #|  if bd == bd && bi == bi { 1 } else { 0 }
    #|}
  let cr = check_source_files_full("t_nan_eq", ["t.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, true, []).ssa
  let bd_s = p18_find_from(ssa, "function w $pion_eq_st_BoxD(", 0)
  let bd_e = p18_find_from(ssa, "\n}", bd_s)
  assert_true(bd_s >= 0 && bd_e > bd_s, ssa)
  let bd_fn = slice_str(ssa, bd_s, bd_e)
  assert_eq(bd_fn.contains("%same =w ceql %a, %b"), false)
  let bi_s = p18_find_from(ssa, "function w $pion_eq_st_BoxI(", 0)
  let bi_e = p18_find_from(ssa, "\n}", bi_s)
  assert_true(bi_s >= 0 && bi_e > bi_s, ssa)
  let bi_fn = slice_str(ssa, bi_s, bi_e)
  assert_true(bi_fn.contains("%same =w ceql %a, %b"), bi_fn)
}

///|
test "generic arithmetic monomorphization emits typed Double and String ops" {
  let src =
    #|fn neg[T](x : T) -> T { -x }
    #|fn add[T](a : T, b : T) -> T { a + b }
    #|fn sub[T](a : T, b : T) -> T { a - b }
    #|fn mul[T](a : T, b : T) -> T { a * b }
    #|fn dv[T](a : T, b : T) -> T { a / b }
    #|fn neg_all[T](xs : Array[T]) -> Array[T] {
    #|  let out : Array[T] = []
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    out.push(neg(xs[i]))
    #|    i = i + 1
    #|  }
    #|  out
    #|}
    #|pub fn main() -> Int {
    #|  let a = neg(2.5)
    #|  let b = sub(0.0, 2.5)
    #|  let c = add(1.5, 2.0)
    #|  let d = mul(1.5, 2.0)
    #|  let e = dv(1.5, 2.0)
    #|  let s = add("a", "b")
    #|  let ys = neg_all([2.5])
    #|  if a == -2.5 && b == -2.5 && c == 3.5 && d == 3.0 && e == 0.75 && s == "ab" && ys[0] == -2.5 {
    #|    0
    #|  } else {
    #|    1
    #|  }
    #|}
  let cr = check_source_files_full("t_gen_arith", ["t.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, true, []).ssa
  let neg_s = p18_find_from(ssa, "function d $pion_fn_neg__mono_Double(", 0)
  let neg_e = p18_find_from(ssa, "\n}", neg_s)
  assert_true(neg_s >= 0 && neg_e > neg_s, "missing neg__mono_Double:\n" + ssa)
  let neg_fn = slice_str(ssa, neg_s, neg_e)
  assert_true(neg_fn.contains("=d neg "), "neg__mono_Double must use =d neg:\n" + neg_fn)
  let add_d_s = p18_find_from(ssa, "function d $pion_fn_add__mono_Double(", 0)
  let add_d_e = p18_find_from(ssa, "\n}", add_d_s)
  assert_true(add_d_s >= 0 && add_d_e > add_d_s, "missing add__mono_Double")
  assert_true(slice_str(ssa, add_d_s, add_d_e).contains("=d add "), "add__mono_Double must use =d add")
  let add_s_s = p18_find_from(ssa, "function l $pion_fn_add__mono_String(", 0)
  let add_s_e = p18_find_from(ssa, "\n}", add_s_s)
  assert_true(add_s_s >= 0 && add_s_e > add_s_s, "missing add__mono_String")
  assert_true(slice_str(ssa, add_s_s, add_s_e).contains("$pion_str_concat"), "add__mono_String must call pion_str_concat")
  let sub_s = p18_find_from(ssa, "function d $pion_fn_sub__mono_Double(", 0)
  let sub_e = p18_find_from(ssa, "\n}", sub_s)
  assert_true(sub_s >= 0 && sub_e > sub_s && slice_str(ssa, sub_s, sub_e).contains("=d sub "), "sub__mono_Double must use =d sub")
  let mul_s = p18_find_from(ssa, "function d $pion_fn_mul__mono_Double(", 0)
  let mul_e = p18_find_from(ssa, "\n}", mul_s)
  assert_true(mul_s >= 0 && mul_e > mul_s && slice_str(ssa, mul_s, mul_e).contains("=d mul "), "mul__mono_Double must use =d mul")
  let dv_s = p18_find_from(ssa, "function d $pion_fn_dv__mono_Double(", 0)
  let dv_e = p18_find_from(ssa, "\n}", dv_s)
  assert_true(dv_s >= 0 && dv_e > dv_s && slice_str(ssa, dv_s, dv_e).contains("=d div "), "dv__mono_Double must use =d div")
  assert_true(ssa.contains("function l $pion_fn_neg_all__mono_Double("), "neg_all must monomorphize for Double")
}

///|
fn has_counted_37_guard(ssa : String) -> Bool {
  let lines = ssa.split("\n")
  let mut i = 0
  while i < lines.length() {
    if lines[i].contains(" =w cugel ") && lines[i].contains(", 37") { return true }
    i = i + 1
  }
  false
}

///|
test "counted fill length is local and requires stable size" {
  let src =
    #|fn local_copy(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 37 { a.push(7); i = i + 1 }
    #|  a[k] = a[0]
    #|  a[k]
    #|}
    #|pub fn main(w : World) -> Int { local_copy(0) }
  let ssa = emit_qbe_package(parse_package("test", ["main.pion"], [src]), true).ssa
  assert_true(has_counted_37_guard(ssa), ssa)
  let alias =
    #|fn local_copy(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 37 { a.push(7); i = i + 1 }
    #|  let b = a
    #|  b.push(19)
    #|  a[k]
    #|}
    #|pub fn main(w : World) -> Int { local_copy(37) }
  let generic = emit_qbe_package(parse_package("test", ["main.pion"], [alias]), true).ssa
  assert_true(!has_counted_37_guard(generic), generic)
}

///|
/// Body of `function ... $pion_fn_<name>(` up to its closing `}` line.
fn counted_fn_body(ssa : String, name : String) -> String {
  let lines = ssa.split("\n")
  let head = "$pion_fn_" + name + "("
  let out = StringBuilder::new()
  let mut inside = false
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    if !inside && l.starts_with("function ") && l.contains(head) { inside = true }
    if inside {
      out.write_string(l)
      out.write_string("\n")
      if l == "}" { return out.to_string() }
    }
    i = i + 1
  }
  out.to_string()
}

///|
/// Bounds checks in `name` whose length operand is exactly the immediate `n`.
fn counted_guard_count(ssa : String, name : String, n : String) -> Int {
  let lines = counted_fn_body(ssa, name).split("\n")
  let tail = ", " + n
  let mut c = 0
  let mut i = 0
  while i < lines.length() {
    let l = lines[i]
    if l.contains(" =w cugel ") && l.ends_with(tail) { c = c + 1 }
    i = i + 1
  }
  c
}

///|
fn counted_emit(src : String) -> String {
  emit_qbe_package(parse_package("test", ["main.pion"], [src]), true).ssa
}

///|
test "counted fill: several fresh arrays filled by one loop all get the immediate" {
  let src =
    #|fn read(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let b : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 37 { a.push(7); b.push(9); i = i + 1 }
    #|  b[k] = a[k]
    #|  a[k] + b[k]
    #|}
    #|pub fn main(w : World) -> Int { read(3) }
  let ssa = counted_emit(src)
  let body = counted_fn_body(ssa, "read")
  // Every bounds check in `read` (both arrays, read and write) uses 37.
  let n37 = counted_guard_count(ssa, "read", "37")
  assert_true(n37 >= 2 && n37 == body.split(" =w cugel ").length() - 1, body)
}

///|
test "counted fill: limit 0 gives the immediate 0" {
  let src =
    #|fn read(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 0 { a.push(7); i = i + 1 }
    #|  a[k]
    #|}
    #|pub fn main(w : World) -> Int { read(0) }
  let ssa = counted_emit(src)
  assert_true(counted_guard_count(ssa, "read", "0") == 1, counted_fn_body(ssa, "read"))
}

///|
test "counted fill: a shadowing inner binding does not inherit the immediate" {
  let src =
    #|fn read(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 37 { a.push(7); i = i + 1 }
    #|  let s = a[k]
    #|  let t = {
    #|    let a = [1, 2]
    #|    a[k]
    #|  }
    #|  s + t
    #|}
    #|pub fn main(w : World) -> Int { read(1) }
  let ssa = counted_emit(src)
  let body = counted_fn_body(ssa, "read")
  assert_true(counted_guard_count(ssa, "read", "37") == 1, body)
  assert_true(counted_guard_count(ssa, "read", "2") == 0, body)
}

///|
test "counted fill: escaping or resizing uses keep the header length" {
  let pre =
    #|fn grow(mut xs : Array[Int]) -> Unit { xs.push(1) }
    #|fn size(xs : Array[Int]) -> Int { xs.length() }
    #|fn read(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 37 { a.push(7); i = i + 1 }
  let post =
    #|  a[k]
    #|}
    #|pub fn main(w : World) -> Int { read(3) }
  let cases = [
    "  let f = fn() -> Unit { a.push(19) }\n  f()\n",
    "  let _ = a.pop()\n",
    "  a.push(19)\n",
    "  let b = a\n  b.push(19)\n",
    "  let n = size(a)\n  if n > 99 { return n }\n",
  ]
  // The unchanged prefix and suffix alone do get the immediate.
  let plain = counted_emit(pre + "\n" + post)
  assert_true(counted_guard_count(plain, "read", "37") == 1, counted_fn_body(plain, "read"))
  let mut c = 0
  while c < cases.length() {
    let ssa = counted_emit(pre + "\n" + cases[c] + post)
    let body = counted_fn_body(ssa, "read")
    assert_true(body.contains(" =w cugel "), cases[c] + body)
    assert_true(counted_guard_count(ssa, "read", "37") == 0, cases[c] + body)
    c = c + 1
  }
  // A `mut` argument needs a `let mut` array, which the fill matcher rejects.
  let mut_src = pre.replace("let a : Array[Int] = []", "let mut a : Array[Int] = []") +
    "\n  grow(mut a)\n" + post
  assert_true(mut_src.contains("let mut a : Array[Int] = []"), mut_src)
  let mut_ssa = counted_emit(mut_src)
  let mut_body = counted_fn_body(mut_ssa, "read")
  assert_true(mut_body.contains(" =w cugel "), mut_body)
  assert_true(counted_guard_count(mut_ssa, "read", "37") == 0, mut_body)
}

///|
test "counted fill: a loop body that shadows the array keeps its own header" {
  // The outer `a` (immediate 3) is read before the inner `let a = [10, 20]`;
  // the loop must not hoist the outer header for the whole body, or the inner
  // `a[j]` / `a.length()` would use the outer length.
  let src =
    #|fn read(k : Int) -> Int {
    #|  let a : Array[Int] = []
    #|  let mut i = 0
    #|  while i < 3 { a.push(7); i = i + 1 }
    #|  let mut s = 0
    #|  let mut j = 0
    #|  while j < k {
    #|    s = s + a[k]
    #|    let a = [10, 20]
    #|    s = s + a[j] * 100 + a.length()
    #|    j = j + 1
    #|  }
    #|  s
    #|}
    #|pub fn main(w : World) -> Int { read(2) }
  let ssa = counted_emit(src)
  let body = counted_fn_body(ssa, "read")
  assert_true(counted_guard_count(ssa, "read", "3") == 1, body)
  let lines = body.split("\n")
  let mut dynamic = 0
  let mut li = 0
  while li < lines.length() {
    let l = lines[li]
    if l.contains(" =w cugel ") && l.contains(", %") { dynamic = dynamic + 1 }
    li = li + 1
  }
  assert_true(dynamic >= 1, body)
}

///|
fn t_w1_ssa(src : String, release : Bool, target : String) -> String {
  let cr = check_source_files_full("w1", ["w1.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  emit_qbe_package_with_tc_target(cr.pkg, cr.tc, release, target).ssa
}

///|
fn t_w1_fn(ssa : String, name : String) -> String {
  let s = p18_find_from(ssa, " $pion_fn_" + name + "(", 0)
  assert_true(s >= 0, "missing function " + name + ":\n" + ssa)
  let e = p18_find_from(ssa, "\n}", s)
  assert_true(e > s, "unterminated function " + name)
  slice_str(ssa, s, e)
}

///|
test "qbe_w1_string_spans_scalar_map_entry_and_string_send" {
  let src =
    #|fn bump(m : Map[String, Int], k : String) -> Int {
    #|  m.remove(k)
    #|  1
    #|}
    #|pub fn cat(s : String, a : Int, b : Int) -> String {
    #|  s.slice(a, b) + "-" + s.slice(b, s.length())
    #|}
    #|pub fn alias(s : String) -> String {
    #|  let x = s.slice(0, 1)
    #|  let y = s.slice(1, 2)
    #|  let r = x + ":" + y
    #|  r
    #|}
    #|pub fn plain(a : String, b : String) -> String {
    #|  a + "-" + b
    #|}
    #|pub fn sbw(s : String, a : Int, b : Int) -> String {
    #|  let sb = StringBuilder()
    #|  sb.write_string(s.slice(a, b))
    #|  sb.to_string()
    #|}
    #|pub fn count(m : Map[String, Int], k : String) -> Unit {
    #|  match m.get(k) {
    #|    Some(v) => m.set(k, v + 1)
    #|    None => m.set(k, 1)
    #|  }
    #|}
    #|pub fn count64(m : Map[String, Int64], s : String) -> Unit {
    #|  let k = s.slice(1, 3)
    #|  match m.get(k) {
    #|    Some(v) => m.set(k, v * 2L)
    #|    None => m.set(k, 7L)
    #|  }
    #|}
    #|pub fn has(m : Map[String, Int], k : String, d : Int) -> Unit {
    #|  if m.contains(k) { m.set(k, d) } else { m.set(k, d + 1) }
    #|}
    #|pub fn effect(m : Map[String, Int], k : String) -> Unit {
    #|  match m.get(k) {
    #|    Some(v) => m.set(k, v + bump(m, k))
    #|    None => m.set(k, 1)
    #|  }
    #|}
    #|pub fn effect_if(m : Map[String, Int], k : String) -> Unit {
    #|  if m.contains(k) { m.set(k, bump(m, k)) } else { m.set(k, 2) }
    #|}
    #|pub fn guarded(m : Map[String, Int], k : String) -> Unit {
    #|  match m.get(k) {
    #|    Some(v) if v > 3 => m.set(k, v + 1)
    #|    _ => m.set(k, 1)
    #|  }
    #|}
    #|pub fn other_key(m : Map[String, Int], k : String, j : String) -> Unit {
    #|  match m.get(k) {
    #|    Some(v) => m.set(j, v + 1)
    #|    None => m.set(k, 1)
    #|  }
    #|}
    #|pub fn push(ch : Channel[String], s : String) -> Bool {
    #|  ch.send(s)
    #|}
    #|pub fn main() -> Int {
    #|  0
    #|}
  for release in [false, true] {
    let ssa = t_w1_ssa(src, release, "amd64_sysv")
    // Slices inside a `+` chain and immutable slice aliases feeding the next
    // concatenation become validated spans plus one exact-size copy.
    for name in ["cat", "alias"] {
      let f = t_w1_fn(ssa, name)
      assert_true(f.contains("call $pion_str_slice_data("), name + ":\n" + f)
      assert_true(f.contains("call $pion_str_concat_spans(l 3,"), name + ":\n" + f)
      assert_true(!f.contains("call $pion_str_slice("), name + ":\n" + f)
    }
    assert_true(!t_w1_fn(ssa, "plain").contains("$pion_str_concat_spans"), "plain concat keeps its lowering")
    let sbw = t_w1_fn(ssa, "sbw")
    // Bounds are validated at the slice site, then the builder appends the
    // validated range of the receiver (no intermediate String).
    let sd = t_w1_pos(sbw, "call $pion_str_slice_data(")
    assert_true(sd >= 0 && t_w1_pos(sbw, "call $pion_strbuf_push_slice(") > sd, sbw)
    assert_true(!sbw.contains("call $pion_str_slice("), sbw)
    // Scalar map read-modify-write: one probe; a hit stores into the slot,
    // only a miss inserts through pion_map_set.
    for name in ["count", "count64", "has"] {
      let f = t_w1_fn(ssa, name)
      let probe = t_w1_pos(f, "call $pion_map_scalar_entry(")
      assert_true(probe >= 0, name + ":\n" + f)
      assert_true(t_w1_pos(f, "call $pion_map_set(") > probe, name + ":\n" + f)
      assert_true(!f.contains("call $pion_map_try_get("), name + ":\n" + f)
    }
    // A sliced key is probed as a span (no whole key) and materialized only on
    // the miss path, after the probe.
    let c64 = t_w1_fn(ssa, "count64")
    assert_true(!c64.contains("call $pion_str_slice("), c64)
    assert_true(c64.contains(", l 0)"), c64)
    assert_true(t_w1_pos(c64, "call $pion_str_from_cstr(") > t_w1_pos(c64, "call $pion_map_scalar_entry("), c64)
    // Calls, guards and mismatched keys fall back to ordinary lookups.
    for name in ["effect", "effect_if", "guarded", "other_key"] {
      let f = t_w1_fn(ssa, name)
      assert_true(!f.contains("$pion_map_scalar_entry"), name + ":\n" + f)
      assert_true(f.contains("call $pion_map_set("), name + ":\n" + f)
    }
    // Native Channel[String].send relies on pion_chan_send's publication freeze.
    let push = t_w1_fn(ssa, "push")
    assert_true(push.contains("call $pion_chan_send("), push)
    assert_true(!push.contains("$pion_rc_freeze"), push)
  }
  // Wasm32 keeps the ordinary lowering, including the String deep freeze.
  let wasm = t_w1_ssa(src, false, "wasm32")
  assert_true(!wasm.contains("$pion_str_concat_spans"), "wasm32 must not use spans")
  assert_true(!wasm.contains("$pion_str_slice_data"), "wasm32 must not use slice spans")
  assert_true(!wasm.contains("$pion_map_scalar_entry"), "wasm32 must not use scalar entries")
  let wpush = t_w1_fn(wasm, "push")
  assert_true(wpush.contains("call $pion_rc_freeze("), wpush)
  assert_true(wpush.contains("$pion_chan_send("), wpush)
}

///|
fn t_w1_pos(s : String, needle : String) -> Int {
  p18_find_from(s, needle, 0)
}

///|
test "qbe_w1_nested_concat_order_last_use_and_alias_scan" {
  let src =
    #|fn mark(n : Int) -> String {
    #|  if n > 1000 { return mark(n - 1) }
    #|  "!"
    #|}
    #|fn sink(s : String) -> Int {
    #|  if s.length() > 1000 { return sink(s.slice(1, s.length())) }
    #|  s.length()
    #|}
    #|pub fn early(a : String, x : String, y : String) -> String {
    #|  a.slice(0, 1) + ((x + y) + mark(1))
    #|}
    #|pub fn deep(a : String, x : String, y : String) -> String {
    #|  a.slice(0, 1) + (((x + y) + mark(1)) + mark(2))
    #|}
    #|pub fn quiet(a : String, x : String, y : String) -> String {
    #|  a.slice(0, 1) + (x + (y + "!"))
    #|}
    #|pub fn group(a : String, x : String, y : String, done : Bool) -> String {
    #|  (a + (x + y)) + (if done { return "early" } else { "!" })
    #|}
    #|pub fn sgroup(a : String, x : String, y : String, done : Bool) -> String {
    #|  (a.slice(0, 1) + (x + y)) + (if done { return "early" } else { "!" })
    #|}
    #|pub fn bgroup(a : String, x : String, y : String, done : Bool) -> String {
    #|  let s = a.slice(0, 1)
    #|  let r = (s + (x + y)) + (if done { return "early" } else { "!" })
    #|  r
    #|}
    #|pub fn bearly(a : String, x : String, y : String) -> String {
    #|  let s = a.slice(0, 1)
    #|  let r = s + ((x + y) + mark(1))
    #|  r
    #|}
    #|pub fn tail(arg : String) -> Int {
    #|  let source = "x" + arg
    #|  let a = source.slice(0, 1)
    #|  let r = a + "!"
    #|  let n = sink(r)
    #|  n + sink("tail")
    #|}
    #|pub fn main() -> Int {
    #|  0
    #|}
  for release in [false, true] {
    let ssa = t_w1_ssa(src, release, "amd64_sysv")
    // A nested `+` followed by a call keeps its own concatenation (and its
    // length check) before the call.
    for name in ["early", "deep", "bearly"] {
      let f = t_w1_fn(ssa, name)
      let c = t_w1_pos(f, "call $pion_str_concat(")
      let m = t_w1_pos(f, "call $pion_fn_mark(")
      assert_true(c >= 0 && m > c, name + ":\n" + f)
      assert_true(f.contains("call $pion_str_concat_spans("), name + ":\n" + f)
      assert_true(!f.contains("$pion_str_concat_n("), name + ":\n" + f)
    }
    // Chains without slices keep the ordinary full flattening: one
    // pion_str_concat_n after the early-return branch, no pion_str_concat(x, y).
    let gr = t_w1_fn(ssa, "group")
    let cn = t_w1_pos(gr, "call $pion_str_concat_n(l 4,")
    assert_true(cn >= 0 && t_w1_pos(gr, "jnz ") >= 0 && t_w1_pos(gr, "jnz ") < cn, gr)
    assert_true(!gr.contains("call $pion_str_concat("), gr)
    assert_true(!gr.contains("$pion_str_concat_spans"), gr)
    // A slice chain uses exactly the ordinary grouping: a full flattening when
    // the left operand is a `+` (all operands, then one length check, after the
    // early-return branch), else [lhs, rhs] with a nested rhs concatenated first.
    for name in ["sgroup", "bgroup"] {
      let f = t_w1_fn(ssa, name)
      let sp = t_w1_pos(f, "call $pion_str_concat_spans(l 4,")
      assert_true(sp >= 0 && t_w1_pos(f, "jnz ") >= 0 && t_w1_pos(f, "jnz ") < sp, name + ":\n" + f)
      assert_true(!f.contains("call $pion_str_concat("), name + ":\n" + f)
    }
    let q = t_w1_fn(ssa, "quiet")
    let qc = t_w1_pos(q, "call $pion_str_concat(")
    assert_true(qc >= 0 && t_w1_pos(q, "call $pion_str_concat_spans(l 2,") > qc, q)
    // Fused alias runs keep last-use release: `source` after the span copy and
    // before sink(r), `r` between the two sink calls.
    let t = t_w1_fn(ssa, "tail")
    let spans = t_w1_pos(t, "call $pion_str_concat_spans(")
    let s1 = t_w1_pos(t, "call $pion_fn_sink(")
    let s2 = p18_find_from(t, "call $pion_fn_sink(", s1 + 1)
    assert_true(spans >= 0 && s1 > spans && s2 > s1, t)
    assert_true(slice_str(t, spans, s1).contains("call $pion_rc_dec("), t)
    assert_true(slice_str(t, s1, s2).contains("call $pion_rc_dec("), t)
  }
  // A long run of slice lets without a concatenation target compiles once per
  // statement (linear scan) and still emits ordinary slices.
  let sb = StringBuilder()
  sb.write_string("pub fn f(s : String) -> Int {\n")
  let mut i = 0
  while i < 40 {
    sb.write_string("  let p" + i.to_string() + " = s.slice(0, 1)\n")
    i = i + 1
  }
  sb.write_string("  let r = p38 + p39\n  r.length() + s.length()\n}\npub fn main() -> Int {\n  0\n}\n")
  let long = t_w1_fn(t_w1_ssa(sb.to_string(), false, "amd64_sysv"), "f")
  // p38, p39 fuse into the concatenation; the earlier 38 slices allocate.
  assert_true(long.contains("call $pion_str_concat_spans(l 2,"), long)
  let mut count = 0
  let mut at = p18_find_from(long, "call $pion_str_slice(", 0)
  while at >= 0 {
    count = count + 1
    at = p18_find_from(long, "call $pion_str_slice(", at + 1)
  }
  assert_eq(count, 38)
}

///|
test "x1 immediate primitive pair uses private slots, escaping pair keeps its box" {
  let src =
    #|pub fn mix(a : Int, b : Int) -> (Int, Int) {
    #|  let x = a ^ b
    #|  (a + x, b - x)
    #|}
    #|pub fn project(a : Int, b : Int) -> Int {
    #|  let (x, y) = mix(a, b)
    #|  x + y
    #|}
  let cr = check_source_files_full("x1", ["a.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let project = j2_extract_fn(ssa, "function w $pion_fn_project(")
  let mix = j2_extract_fn(ssa, "function l $pion_fn_mix(")
  assert_true(project.length() > 0 && mix.length() > 0, ssa)
  assert_true(project.index_of("call $pion_alloc") < 0, project)
  assert_true(project.index_of("call $pion_fn_mix(") < 0, project)
  assert_true(mix.index_of("call $pion_alloc") >= 0, mix)
}

///|
test "x1 scalar result keeps the callee lexical scope" {
  let helper =
    #|let bias : Int = 7
    #|
    #|pub fn get_value(x : Int) -> Result[Int, Int] {
    #|  if x < 0 { return Err(bias) }
    #|  let a = x + 1
    #|  let b = a + 2
    #|  let c = b + 3
    #|  let d = c + 4
    #|  Ok(d + bias)
    #|}
  let caller =
    #|fn through(x : Int, bias : Int) -> Result[Int, Int] {
    #|  let v = get_value(x)?
    #|  Ok(v + bias)
    #|}
  let cr = check_source_files_full("x1", ["a.pion", "b.pion"], [helper, caller])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let body = j2_extract_fn(ssa, "function l $pion_fn_through(")
  assert_true(body.index_of("call $pion_fn_get_value(") < 0, body)
  assert_true(body.index_of("storel 7, ") >= 0, body)
}

///|
test "x1 fixed table length follows its slot through shadowing" {
  let src =
    #|let fixed_words : FixedArray[Int] = [3, 5, 7, 11]
    #|fn word_sum(n : Int) -> Int {
    #|  let xs = fixed_words
    #|  let mut i = 0
    #|  let mut total = 0
    #|  while i < n {
    #|    total = total + xs[i]
    #|    i = i + 1
    #|  }
    #|  total
    #|}
    #|fn shadow_sum(fixed_words : FixedArray[Int]) -> Int {
    #|  let xs = fixed_words
    #|  let mut i = 0
    #|  let mut total = 0
    #|  while i < xs.length() {
    #|    total = total + xs[i]
    #|    i = i + 1
    #|  }
    #|  total
    #|}
  let cr = check_source_files_full("x1", ["table.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  assert_true(counted_guard_count(ssa, "word_sum", "4") > 0, ssa)
  assert_true(counted_guard_count(ssa, "shadow_sum", "4") == 0, ssa)
}

///|
test "x1 plain inlined call keeps the callee lexical scope" {
  let src =
    #|let bias : Int = 7
    #|fn add_bias(x : Int) -> Int {
    #|  x + bias
    #|}
    #|fn caller(x : Int, bias : Int) -> Int {
    #|  let bias2 = bias * 1000
    #|  add_bias(x) + bias2
    #|}
  let cr = check_source_files_full("x1", ["a.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  for release in [false, true] {
    let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, release).ssa
    let body = j2_extract_fn(ssa, "function w $pion_fn_caller(")
    assert_true(body.length() > 0, ssa)
    assert_true(body.index_of("call $pion_fn_add_bias(") < 0, body)
    assert_true(body.index_of(", 7\n") >= 0, body)
  }
}

///|
test "x1 destructured inline body keeps last-use early drops" {
  let src =
    #|fn pair(x : Int) -> (Int, Int) {
    #|  let a = x.to_string()
    #|  let n = a.length()
    #|  let b = (x + 1).to_string()
    #|  (n, b.length())
    #|}
    #|pub fn consumer(x : Int) -> Int {
    #|  let (a, b) = pair(x)
    #|  a + b
    #|}
  let cr = check_source_files_full("x1", ["a.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let body = j2_extract_fn(ssa, "function w $pion_fn_consumer(")
  assert_true(body.length() > 0, ssa)
  assert_true(body.index_of("call $pion_alloc") < 0, body)
  assert_true(body.index_of("call $pion_fn_pair(") < 0, body)
  let first = body.index_of("call $pion_int_to_str(")
  assert_true(first >= 0, body)
  let rest = body.slice(first + 1, body.length())
  let second_rel = rest.index_of("call $pion_int_to_str(")
  assert_true(second_rel >= 0, body)
  let second = first + 1 + second_rel
  let drop = body.index_of("call $pion_rc_dec(")
  assert_true(drop > first && drop < second, body)
}

///|
test "StringBuilder LICM hoists array headers safely and blocks aliasing/custom types" {
  let src =
    #|fn revcomp_like(seq : Array[Int], comp : Array[Byte]) -> String {
    #|  let sb = StringBuilder::new()
    #|  let mut i = seq.length() - 1
    #|  while i >= 0 {
    #|    let b = seq[i]
    #|    sb.write_byte(comp[b])
    #|    i = i - 1
    #|  }
    #|  sb.to_string()
    #|}
    #|fn neg_arg_side_effect(arr : Array[Int]) -> String {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    sb.write_byte({ arr.push(99); b'a' })
    #|    i = i + 1
    #|  }
    #|  sb.write_string(sum.to_string())
    #|  sb.to_string()
    #|}
    #|struct MyBuf {
    #|  arr : Array[Int]
    #|}
    #|fn MyBuf::write_byte(self : MyBuf, b : Byte) -> Unit {
    #|  self.arr.push(b.to_int())
    #|}
    #|fn neg_custom_write_byte(arr : Array[Int]) -> Int {
    #|  let mb = MyBuf::{ arr: arr }
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    mb.write_byte(b'x')
    #|    i = i + 1
    #|  }
    #|  sum
    #|}
    #|fn neg_shadowed_sb_in_loop(arr : Array[Int]) -> Int {
    #|  let sb = StringBuilder::new()
    #|  let mb = MyBuf::{ arr: arr }
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    let sb = mb
    #|    sum = sum + arr[i]
    #|    sb.write_byte(b'!')
    #|    i = i + 1
    #|  }
    #|  let _ = sb.length()
    #|  sum
    #|}
    #|fn neg_local_closure_panic(arr : Array[Int], panic : () -> Byte) -> String {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    sb.write_byte(panic())
    #|    i = i + 1
    #|  }
    #|  sb.write_string(sum.to_string())
    #|  sb.to_string()
    #|}
    #|fn neg_and_rhs_is_shadow_sb(arr : Array[Int], opt : Option[MyBuf]) -> Int {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    if opt is Some(sb) && { sb.write_byte(b'!'); true } {
    #|      sum = sum + 1
    #|    }
    #|    i = i + 1
    #|  }
    #|  let _ = sb.length()
    #|  sum
    #|}
    #|fn neg_match_guard_is_shadow_sb(arr : Array[Int], opt : Option[MyBuf]) -> Int {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    match i {
    #|      _ if opt is Some(sb) => sb.write_byte(b'!')
    #|      _ => ()
    #|    }
    #|    i = i + 1
    #|  }
    #|  let _ = sb.length()
    #|  sum
    #|}
    #|fn MyBuf::length(self : MyBuf) -> Int {
    #|  self.arr.push(33)
    #|  33
    #|}
    #|fn neg_match_guard_shadow_str_len(arr : Array[Int], opt : Option[MyBuf], x : String) -> String {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    sb.write_byte(match i {
    #|      _ if opt is Some(x) => x.length().to_byte()
    #|      _ => b'?'
    #|    })
    #|    i = i + 1
    #|  }
    #|  sb.write_string((sum + x.length()).to_string())
    #|  sb.to_string()
    #|}
    #|fn neg_shadow_unfrozen_scratch(arr : Array[Int], alias : Array[Int]) -> Int {
    #|  let sb = StringBuilder::new()
    #|  let scratch : Array[Int] = [0]
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    let scratch = alias
    #|    scratch.push(33)
    #|    sb.write_byte(b'!')
    #|    i = i + 1
    #|  }
    #|  let _ = sb.length()
    #|  sum + scratch.length()
    #|}
    #|fn test_write_bytes_fastpath(bs : Bytes) -> String {
    #|  let sb = StringBuilder::with_capacity(64)
    #|  sb.write_bytes(bs)
    #|  sb.to_string()
    #|}
    #|pub fn main() -> Int { 0 }
  let cr = check_source_files_full("t_sb_licm_wbs", ["t.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, true, []).ssa
  // Positive: revcomp_like hoists both `seq` and `comp` headers before the loop
  let rc_s = p18_find_from(ssa, "function l $pion_fn_revcomp_like(", 0)
  let rc_e = p18_find_from(ssa, "\n}", rc_s)
  assert_true(rc_s >= 0 && rc_e > rc_s, "missing revcomp_like:\n" + ssa)
  let rc_fn = slice_str(ssa, rc_s, rc_e)
  let rc_wb = p18_find_from(rc_fn, "@wh_b_", 0)
  let rc_wc = p18_find_from(rc_fn, "@wh_c_", 0)
  let rc_loop = if rc_wb > 0 && (rc_wc < 0 || rc_wb < rc_wc) { rc_wb } else { rc_wc }
  assert_true(rc_loop > 0, rc_fn)
  let rc_pre = slice_str(rc_fn, 0, rc_loop)
  let rc_in = slice_str(rc_fn, rc_loop, rc_fn.length())
  // Preheader loads both array data pointers (+24)
  let pre_add24_1 = p18_find_from(rc_pre, ", 24\n", 0)
  let pre_add24_2 = p18_find_from(rc_pre, ", 24\n", pre_add24_1 + 5)
  assert_true(pre_add24_1 >= 0 && pre_add24_2 > pre_add24_1, "expected 2 hoisted array data ptrs in preheader:\n" + rc_pre)
  // Inside loop body, neither array header (+24) is reloaded
  assert_eq(rc_in.contains(", 24\n"), false)
  // Negative 1: argument side effect prevents hoisting `arr`
  let n1_s = p18_find_from(ssa, "function l $pion_fn_neg_arg_side_effect(", 0)
  let n1_e = p18_find_from(ssa, "\n}", n1_s)
  assert_true(n1_s >= 0 && n1_e > n1_s, "missing neg_arg_side_effect")
  let n1_fn = slice_str(ssa, n1_s, n1_e)
  let n1_wb = p18_find_from(n1_fn, "@wh_b_", 0)
  let n1_wc = p18_find_from(n1_fn, "@wh_c_", 0)
  let n1_loop = if n1_wb > 0 && (n1_wc < 0 || n1_wb < n1_wc) { n1_wb } else { n1_wc }
  assert_true(n1_loop > 0, n1_fn)
  let n1_pre = slice_str(n1_fn, 0, n1_loop)
  assert_eq(n1_pre.contains(", 24\n"), false)
  // Negative 2: custom MyBuf::write_byte prevents hoisting `arr`
  let n2_s = p18_find_from(ssa, "function w $pion_fn_neg_custom_write_byte(", 0)
  let n2_e = p18_find_from(ssa, "\n}", n2_s)
  assert_true(n2_s >= 0 && n2_e > n2_s, "missing neg_custom_write_byte")
  let n2_fn = slice_str(ssa, n2_s, n2_e)
  let n2_wb = p18_find_from(n2_fn, "@wh_b_", 0)
  let n2_wc = p18_find_from(n2_fn, "@wh_c_", 0)
  let n2_loop = if n2_wb > 0 && (n2_wc < 0 || n2_wb < n2_wc) { n2_wb } else { n2_wc }
  assert_true(n2_loop > 0, n2_fn)
  let n2_pre = slice_str(n2_fn, 0, n2_loop)
  assert_eq(n2_pre.contains(", 24\n"), false)
  // Negative 3: inner `let sb = mb` shadowing outer StringBuilder prevents hoisting `arr`
  let n3_s = p18_find_from(ssa, "function w $pion_fn_neg_shadowed_sb_in_loop(", 0)
  let n3_e = p18_find_from(ssa, "\n}", n3_s)
  assert_true(n3_s >= 0 && n3_e > n3_s, "missing neg_shadowed_sb_in_loop")
  let n3_fn = slice_str(ssa, n3_s, n3_e)
  let n3_wb = p18_find_from(n3_fn, "@wh_b_", 0)
  let n3_wc = p18_find_from(n3_fn, "@wh_c_", 0)
  let n3_loop = if n3_wb > 0 && (n3_wc < 0 || n3_wb < n3_wc) { n3_wb } else { n3_wc }
  assert_true(n3_loop > 0, n3_fn)
  let n3_pre = slice_str(n3_fn, 0, n3_loop)
  assert_eq(n3_pre.contains(", 24\n"), false)
  // Negative 4: local closure named `panic` inside sb.write_byte(panic()) prevents hoisting `arr`
  let n4_s = p18_find_from(ssa, "function l $pion_fn_neg_local_closure_panic(", 0)
  let n4_e = p18_find_from(ssa, "\n}", n4_s)
  assert_true(n4_s >= 0 && n4_e > n4_s, "missing neg_local_closure_panic")
  let n4_fn = slice_str(ssa, n4_s, n4_e)
  let n4_wb = p18_find_from(n4_fn, "@wh_b_", 0)
  let n4_wc = p18_find_from(n4_fn, "@wh_c_", 0)
  let n4_loop = if n4_wb > 0 && (n4_wc < 0 || n4_wb < n4_wc) { n4_wb } else { n4_wc }
  assert_true(n4_loop > 0, n4_fn)
  let n4_pre = slice_str(n4_fn, 0, n4_loop)
  assert_eq(n4_pre.contains(", 24\n"), false)
  // Negative 5: `opt is Some(sb) && { sb.write_byte(...); true }` shadows outer StringBuilder
  let n5_s = p18_find_from(ssa, "function w $pion_fn_neg_and_rhs_is_shadow_sb(", 0)
  let n5_e = p18_find_from(ssa, "\n}", n5_s)
  assert_true(n5_s >= 0 && n5_e > n5_s, "missing neg_and_rhs_is_shadow_sb")
  let n5_fn = slice_str(ssa, n5_s, n5_e)
  let n5_wb = p18_find_from(n5_fn, "@wh_b_", 0)
  let n5_wc = p18_find_from(n5_fn, "@wh_c_", 0)
  let n5_loop = if n5_wb > 0 && (n5_wc < 0 || n5_wb < n5_wc) { n5_wb } else { n5_wc }
  assert_true(n5_loop > 0, n5_fn)
  let n5_pre = slice_str(n5_fn, 0, n5_loop)
  assert_eq(n5_pre.contains(", 24\n"), false)
  // Negative 6: `match i { _ if opt is Some(sb) => sb.write_byte(...) }` shadows outer StringBuilder
  let n6_s = p18_find_from(ssa, "function w $pion_fn_neg_match_guard_is_shadow_sb(", 0)
  let n6_e = p18_find_from(ssa, "\n}", n6_s)
  assert_true(n6_s >= 0 && n6_e > n6_s, "missing neg_match_guard_is_shadow_sb")
  let n6_fn = slice_str(ssa, n6_s, n6_e)
  let n6_wb = p18_find_from(n6_fn, "@wh_b_", 0)
  let n6_wc = p18_find_from(n6_fn, "@wh_c_", 0)
  let n6_loop = if n6_wb > 0 && (n6_wc < 0 || n6_wb < n6_wc) { n6_wb } else { n6_wc }
  assert_true(n6_loop > 0, n6_fn)
  let n6_pre = slice_str(n6_fn, 0, n6_loop)
  assert_eq(n6_pre.contains(", 24\n"), false)
  // Negative 7: package-level `fn panic(a : Array[Int]) -> Byte` shadowing builtin `panic`
  let pkg_panic_src =
    #|fn panic(a : Array[Int]) -> Byte {
    #|  a.push(25)
    #|  b'p'
    #|}
    #|fn neg_pkg_fn_panic(arr : Array[Int], alias : Array[Int]) -> String {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    sb.write_byte(panic(alias))
    #|    i = i + 1
    #|  }
    #|  sb.write_string(sum.to_string())
    #|  sb.to_string()
    #|}
    #|pub fn main() -> Int { 0 }
  let cr_pp = check_source_files_full("t_sb_licm_pkg_panic", ["t.pion"], [pkg_panic_src])
  assert_true(cr_pp.diagnostics.length() == 0, check_result_to_json(cr_pp.diagnostics))
  let ssa_pp = emit_qbe_package_multi(cr_pp.pkg, cr_pp.tc, false, true, []).ssa
  let n7_s = p18_find_from(ssa_pp, "function l $pion_fn_neg_pkg_fn_panic(", 0)
  let n7_e = p18_find_from(ssa_pp, "\n}", n7_s)
  assert_true(n7_s >= 0 && n7_e > n7_s, "missing neg_pkg_fn_panic")
  let n7_fn = slice_str(ssa_pp, n7_s, n7_e)
  let n7_wb = p18_find_from(n7_fn, "@wh_b_", 0)
  let n7_wc = p18_find_from(n7_fn, "@wh_c_", 0)
  let n7_loop = if n7_wb > 0 && (n7_wc < 0 || n7_wb < n7_wc) { n7_wb } else { n7_wc }
  assert_true(n7_loop > 0, n7_fn)
  let n7_pre = slice_str(n7_fn, 0, n7_loop)
  assert_eq(n7_pre.contains(", 24\n"), false)
  // Negative 8: match guard `opt is Some(x)` shadowing outer `x : String` inside `sb.write_byte(match ...)`
  let n8_s = p18_find_from(ssa, "function l $pion_fn_neg_match_guard_shadow_str_len(", 0)
  let n8_e = p18_find_from(ssa, "\n}", n8_s)
  assert_true(n8_s >= 0 && n8_e > n8_s, "missing neg_match_guard_shadow_str_len")
  let n8_fn = slice_str(ssa, n8_s, n8_e)
  let n8_wb = p18_find_from(n8_fn, "@wh_b_", 0)
  let n8_wc = p18_find_from(n8_fn, "@wh_c_", 0)
  let n8_loop = if n8_wb > 0 && (n8_wc < 0 || n8_wb < n8_wc) { n8_wb } else { n8_wc }
  assert_true(n8_loop > 0, n8_fn)
  let n8_pre = slice_str(n8_fn, 0, n8_loop)
  assert_true(!n8_pre.contains(", 24\n"), "n8 must not hoist arr:\n" + n8_fn)
  // Negative 9: inner `let scratch = alias` shadowing outer unfrozen local array `scratch`
  // (`scratch = [0]` itself writes element 0 via `+ 24` before the loop, so verify `arr` reloads `+ 24` inside the loop)
  let n9_s = p18_find_from(ssa, "function w $pion_fn_neg_shadow_unfrozen_scratch(", 0)
  let n9_e = p18_find_from(ssa, "\n}", n9_s)
  assert_true(n9_s >= 0 && n9_e > n9_s, "missing neg_shadow_unfrozen_scratch")
  let n9_fn = slice_str(ssa, n9_s, n9_e)
  let n9_wb = p18_find_from(n9_fn, "@wh_b_", 0)
  let n9_wc = p18_find_from(n9_fn, "@wh_c_", 0)
  let n9_loop = if n9_wb > 0 && (n9_wc < 0 || n9_wb < n9_wc) { n9_wb } else { n9_wc }
  assert_true(n9_loop > 0, n9_fn)
  let n9_in = slice_str(n9_fn, n9_loop, n9_fn.length())
  assert_true(n9_in.contains(", 24\n"), "n9 must reload arr inside loop:\n" + n9_fn)
  // Negative 10: cross-package monomorphization where app defines `enum E { Hit(Int) }`
  // and dep defines `struct E` + `fn E::Hit(a : Array[Int]) -> Byte`
  let dep_epath_src =
    #|pub struct E {
    #|  v : Int
    #|}
    #|pub fn E::Hit(a : Array[Int]) -> Byte {
    #|  a.push(33)
    #|  b'!'
    #|}
    #|pub fn[T] run_dep_epath(arr : Array[Int], alias : Array[Int], _tag : T) -> Int {
    #|  let sb = StringBuilder::new()
    #|  let mut i = 0
    #|  let mut sum = 0
    #|  while i < 8 {
    #|    sum = sum + arr[i]
    #|    sb.write_byte(E::Hit(alias))
    #|    i = i + 1
    #|  }
    #|  let _ = sb.length()
    #|  sum
    #|}
  let dep_cr = check_source_files_with_imports("dep_epath", ["dep.pion"], [dep_epath_src], [], true)
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))
  let app_epath_src =
    #|import "dep_epath"
    #|enum E {
    #|  Hit(Int)
    #|}
    #|pub fn main() -> Int {
    #|  let a : Array[Int] = [5, 6, 7, 8]
    #|  let _e = E::Hit(1)
    #|  dep_epath::run_dep_epath(a, a, 0)
    #|}
  let app_cr = check_source_files_with_imports(
    "app_epath",
    ["app.pion"],
    [app_epath_src],
    [imported_pkg_new("dep_epath", dep_cr.tc)],
    true,
  )
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let ssa_xpkg = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, true, ["dep_epath"]).ssa
  let n10_s = p18_find_from(ssa_xpkg, "run_dep_epath", 0)
  assert_true(n10_s >= 0, "missing mono run_dep_epath in ssa")
  let n10_fn_s = p18_find_from(ssa_xpkg, "function w $", 0)
  let mut mono_body = ""
  let xfuncs = ssa_xpkg.split("function ")
  let mut xfi = 0
  while xfi < xfuncs.length() {
    if xfuncs[xfi].contains("run_dep_epath") && xfuncs[xfi].contains("@wh_") {
      mono_body = xfuncs[xfi]
      break
    }
    xfi = xfi + 1
  }
  assert_true(mono_body != "" && n10_fn_s >= 0, "missing mono run_dep_epath body:\n" + ssa_xpkg)
  let n10_wb = p18_find_from(mono_body, "@wh_b_", 0)
  let n10_wc = p18_find_from(mono_body, "@wh_c_", 0)
  let n10_loop = if n10_wb > 0 && (n10_wc < 0 || n10_wb < n10_wc) { n10_wb } else { n10_wc }
  assert_true(n10_loop > 0, mono_body)
  let n10_pre = slice_str(mono_body, 0, n10_loop)
  assert_true(!n10_pre.contains(", 24\n"), "n10 must not hoist arr:\n" + mono_body)
  // write_bytes fast path emitted in SSA
  let wb_s = p18_find_from(ssa, "function l $pion_fn_test_write_bytes_fastpath(", 0)
  let wb_e = p18_find_from(ssa, "\n}", wb_s)
  assert_true(wb_s >= 0 && wb_e > wb_s, "missing test_write_bytes_fastpath")
  let wb_fn = slice_str(ssa, wb_s, wb_e)
  assert_true(wb_fn.contains("@sb_wbs_fast_"), wb_fn)
  assert_true(wb_fn.contains("@sb_wbs_slow_"), wb_fn)
  assert_true(wb_fn.contains("@sb_wbs_fdone_"), wb_fn)
}

///|
test "p1_null_niche_enum_tree_layout_and_option_boxing" {
  let src =
    #|pub enum Tree {
    #|  Leaf
    #|  Node(Tree, Tree)
    #|}
    #|pub fn mk_leaf() -> Tree {
    #|  Leaf
    #|}
    #|pub fn mk_node(l : Tree, r : Tree) -> Tree {
    #|  Node(l, r)
    #|}
    #|pub fn sum_tree(t : Tree) -> Int {
    #|  match t {
    #|    Leaf => 1
    #|    Node(l, r) => 1 + sum_tree(l) + sum_tree(r)
    #|  }
    #|}
    #|pub fn wrap_tree(t : Tree) -> Option[Tree] {
    #|  Some(t)
    #|}
  let cr = check_source_files_full("p1", ["tree.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // Leaf is encoded as 0 (no static $pion_enum_u_ global).
  assert_true(!ssa.contains("$pion_enum_u_"), ssa)
  let mk_leaf_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_leaf(")
  assert_true(mk_leaf_fn.contains("=l copy 0"), mk_leaf_fn)
  // Node allocates 16-byte payload (2 * 8B, no 8B tag word; 24B header + 16B = 40B slab).
  let mk_node_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_node(")
  assert_true(
    mk_node_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_slots_3)"),
    mk_node_fn,
  )
  // Fields at offset 0 (direct store/load on ptr) and offset 8 (add ptr, 8); no offset 16.
  assert_true(mk_node_fn.contains(", 8\n"), mk_node_fn)
  assert_true(!mk_node_fn.contains(", 16\n"), mk_node_fn)
  // Tree's payload drops through the canonical slot helper for slots {0, 1}:
  // no tag branch, loads offset 0 then offset 8; no per-type drop remains.
  assert_true(!ssa.contains("$pion_drop_enum_"), ssa)
  let drop_fn = j2_extract_fn(ssa, "function $pion_drop_slots_3(")
  assert_true(!drop_fn.contains("ceql"), drop_fn)
  assert_true(drop_fn.contains("%a0 =l add %p, 0\n    %v0 =l loadl %a0\n"), drop_fn)
  assert_true(drop_fn.contains("%a1 =l add %p, 8\n    %v1 =l loadl %a1\n"), drop_fn)
  assert_true(!drop_fn.contains("%p, 16"), drop_fn)
  // Option[Tree] must be boxed with $pion_drop_opt_obj so Some(Leaf) != None.
  let wrap_fn = j2_extract_fn(ssa, "function l $pion_fn_wrap_tree(")
  assert_true(
    wrap_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_opt_obj)"),
    wrap_fn,
  )
}

///|
test "p1_null_niche_enum_generic_erased_and_pionsig_roundtrip" {
  let lib_src =
    #|pub enum MyList[T] {
    #|  Nil
    #|  Cons(T, MyList[T])
    #|}
    #|pub fn list_cons[T](x : T, xs : MyList[T]) -> MyList[T] {
    #|  Cons(x, xs)
    #|}
    #|pub fn list_len[T](xs : MyList[T]) -> Int {
    #|  match xs {
    #|    Nil => 0
    #|    Cons(_, tail) => 1 + list_len(tail)
    #|  }
    #|}
  let app_src =
    #|import "lib"
    #|pub fn use_lists() -> Int {
    #|  let a : lib::MyList[Int] = lib::list_cons(1, lib::MyList::Nil)
    #|  let b : lib::MyList[String] = lib::list_cons("hi", lib::MyList::Nil)
    #|  lib::list_len(a) + lib::list_len(b)
    #|}
  // Verify .pionsig preserves the 2-variant niche declaration deterministically.
  let lib_pkg = parse_package("lib", ["lib.pion"], [lib_src])
  let lib_sig = emit_file_sig_entries(lib_pkg.files[0])
  assert_true(lib_sig.contains("enum MyList[T] { Nil; Cons(T, MyList[T]) }"), lib_sig)
  // Verify erased generic and monomorphized instantiations both emit tagless 16B payload & null Nil.
  let lib_cr = check_source_files_full("lib", ["lib.pion"], [lib_src])
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let lib_ssa = emit_qbe_package_with_tc(lib_cr.pkg, lib_cr.tc, true).ssa
  let erased_cons = j2_extract_fn(lib_ssa, "function l $pion_fn_list_cons(")
  assert_true(erased_cons.contains("call $pion_alloc_uninit(w 16, w 5,"), erased_cons)
  assert_true(!erased_cons.contains(", 16\n"), erased_cons)
  let erased_len = j2_extract_fn(lib_ssa, "function w $pion_fn_list_len(")
  assert_true(erased_len.contains("ceql ") && erased_len.contains(", 0\n"), erased_len)
  // Cross-package generic check + emit (generic packages import from source tc; also verify .pionstub on non-generic niche enum)
  let imp_list = [ImportedPkg::{ name: "lib", tc: lib_cr.tc }]
  let app_cr = check_source_files_with_imports("app", ["app.pion"], [app_src], imp_list, true)
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, false, ["lib"]).ssa
  assert_true(!app_ssa.contains("$pion_enum_u_"), app_ssa)
  assert_true(app_ssa.contains("call $pion_alloc_uninit(w 16, w 5,"), app_ssa)
  // Non-generic niche enum .pionstub round-trip
  let ng_src =
    #|pub enum BoxedTree {
    #|  Leaf
    #|  Node(BoxedTree, BoxedTree)
    #|}
    #|pub fn mk_leaf() -> BoxedTree {
    #|  Leaf
    #|}
  let ng_cr = check_source_files_full("nglib", ["nglib.pion"], [ng_src])
  assert_true(ng_cr.diagnostics.length() == 0, check_result_to_json(ng_cr.diagnostics))
  let ng_stub = emit_pion_stub(ng_cr.pkg)
  assert_true(ng_stub.contains("pub enum BoxedTree"), ng_stub)
  let ng_stub_cr = check_source_files_with_imports("nglib", ["nglib.pionstub"], [ng_stub], [], true)
  assert_true(ng_stub_cr.diagnostics.length() == 0, check_result_to_json(ng_stub_cr.diagnostics))
  let ng_app_src =
    #|import "nglib"
    #|pub fn build_it() -> nglib::BoxedTree {
    #|  nglib::BoxedTree::Node(nglib::BoxedTree::Leaf, nglib::mk_leaf())
    #|}
  let ng_app_cr = check_source_files_with_imports(
    "ngapp",
    ["ngapp.pion"],
    [ng_app_src],
    [ImportedPkg::{ name: "nglib", tc: ng_stub_cr.tc }],
    true,
  )
  assert_true(ng_app_cr.diagnostics.length() == 0, check_result_to_json(ng_app_cr.diagnostics))
  let ng_app_ssa = emit_qbe_package_multi(ng_app_cr.pkg, ng_app_cr.tc, true, false, ["nglib"]).ssa
  assert_true(!ng_app_ssa.contains("$pion_enum_u_"), ng_app_ssa)
  // The importing unit drops the stub's niche enum through its own local
  // slot helper: it references no symbol of `nglib`'s drop functions.
  assert_true(
    ng_app_ssa.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_slots_3)"),
    ng_app_ssa,
  )
  assert_true(ng_app_ssa.contains("function $pion_drop_slots_3("), ng_app_ssa)
  assert_true(!ng_app_ssa.contains("export function $pion_drop_slots_"), ng_app_ssa)
  assert_true(!ng_app_ssa.contains("$pion_drop_enum_"), ng_app_ssa)
}

///|
test "p1_null_niche_enum_pod_scalarized_opt_res" {
  let src =
    #|pub enum PodNiche {
    #|  Empty
    #|  Val(Int)
    #|}
    #|fn produce_pod_res(k : Int) -> Result[PodNiche, Int] {
    #|  if k < 0 {
    #|    Err(k)
    #|  } else if k == 0 {
    #|    Ok(Empty)
    #|  } else {
    #|    Ok(Val(k))
    #|  }
    #|}
    #|pub fn direct_match(k : Int) -> Int {
    #|  match produce_pod_res(k) {
    #|    Ok(x) =>
    #|      match x {
    #|        Empty => 10
    #|        Val(v) => v
    #|      }
    #|    Err(e) => e
    #|  }
    #|}
    #|pub fn tail_fwd(k : Int) -> Result[Int, Int] {
    #|  match produce_pod_res(k) {
    #|    Ok(x) =>
    #|      match x {
    #|        Empty => Ok(100)
    #|        Val(v) => Ok(v)
    #|      }
    #|    Err(e) => Err(e)
    #|  }
    #|}
  let cr = check_source_files_full("p1pod", ["pod.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // Both direct scalarized match and nested tail scalarized match must read the
  // runtime niche pointer from `val_slot - 32` via `qbe_pod_buf_val` (`=l sub %, 32`
  // followed by `=l loadl `), never storing the raw non-null stack buffer address.
  let dm_fn = j2_extract_fn(ssa, "function w $pion_fn_direct_match(")
  assert_true(
    dm_fn.contains("=l sub %") && dm_fn.contains(", 32\n") && dm_fn.contains("=l loadl %"),
    dm_fn,
  )
  let tf_fn = j2_extract_fn(ssa, "function l $pion_fn_tail_fwd(")
  assert_true(
    tf_fn.contains("=l sub %") && tf_fn.contains(", 32\n") && tf_fn.contains("=l loadl %"),
    tf_fn,
  )
}

///|
test "p1_null_niche_enum_pod_ctor_alias_shadow_and_wasm_multipkg_p47a" {
  // 1. Multi-package POD stack-SROA constructor disambiguation:
  // `import "maker" as E; let x : model::E = E::Val(7)` must call `maker::Val`,
  // NOT misidentify `E::Val(7)` as `model::E::Val(7)` and write 7 into a stack buffer!
  let model_src =
    #|pub enum E {
    #|  Empty
    #|  Val(Int)
    #|}
  let maker_src =
    #|import "model"
    #|pub fn Val(n : Int) -> model::E {
    #|  let _ = n
    #|  model::E::Empty
    #|}
  let app_src =
    #|import "model"
    #|import "maker" as E
    #|pub fn via_alias() -> Int {
    #|  let x : model::E = E::Val(7)
    #|  match x {
    #|    model::E::Empty => 1
    #|    model::E::Val(v) => v
    #|  }
    #|}
    #|pub fn via_real() -> Int {
    #|  let x : model::E = model::E::Val(7)
    #|  match x {
    #|    model::E::Empty => 1
    #|    model::E::Val(v) => v
    #|  }
    #|}
  let model_cr = check_source_files_full("model", ["model.pion"], [model_src])
  assert_true(model_cr.diagnostics.length() == 0, check_result_to_json(model_cr.diagnostics))
  let maker_cr = check_source_files_with_imports(
    "maker",
    ["maker.pion"],
    [maker_src],
    [ImportedPkg::{ name: "model", tc: model_cr.tc }],
    true,
  )
  assert_true(maker_cr.diagnostics.length() == 0, check_result_to_json(maker_cr.diagnostics))
  let app_cr = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [app_src],
    [
      ImportedPkg::{ name: "model", tc: model_cr.tc },
      ImportedPkg::{ name: "maker", tc: maker_cr.tc },
    ],
    true,
  )
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, false, ["model", "maker"]).ssa
  let alias_fn = j2_extract_fn(app_ssa, "function w $pion_pkg_app_fn_via_alias(")
  assert_true(
    alias_fn.contains("call $pion_pkg_maker_fn_Val("),
    "expected via_alias to call $pion_pkg_maker_fn_Val, got:\n" + alias_fn,
  )
  let real_fn = j2_extract_fn(app_ssa, "function w $pion_pkg_app_fn_via_real(")
  assert_true(
    real_fn.length() > 0 && !real_fn.contains("call $pion_pkg_maker_fn_Val("),
    "expected via_real not to call $pion_pkg_maker_fn_Val, got:\n" + real_fn,
  )

  // 1b. Lowercase zero-field variant named `panic`: `let x : E = panic()` must call
  // `$pion_panic` (never misidentified as 0-arg variant ctor), while `E::panic` constructs 0.
  let panic_src =
    #|pub enum PE {
    #|  panic
    #|  Val(Int)
    #|}
    #|pub fn via_builtin_panic() -> Int {
    #|  let x : PE = panic()
    #|  match x {
    #|    PE::panic => 1
    #|    PE::Val(n) => n
    #|  }
    #|}
    #|pub fn via_ctor_panic() -> PE {
    #|  let x : PE = PE::panic
    #|  x
    #|}
  let p_cr = check_source_files_full("p1panic", ["p.pion"], [panic_src])
  assert_true(p_cr.diagnostics.length() == 0, check_result_to_json(p_cr.diagnostics))
  let p_ssa = emit_qbe_package_with_tc(p_cr.pkg, p_cr.tc, true).ssa
  let p_builtin_fn = j2_extract_fn(p_ssa, "function w $pion_fn_via_builtin_panic(")
  assert_true(
    p_builtin_fn.contains("call $pion_panic(") && !p_builtin_fn.contains("storeh 5,"),
    "expected panic() to emit call $pion_panic without POD stack ctor, got:\n" + p_builtin_fn,
  )
  let p_ctor_fn = j2_extract_fn(p_ssa, "function l $pion_fn_via_ctor_panic(")
  assert_true(
    p_ctor_fn.length() > 0 && !p_ctor_fn.contains("call $pion_panic("),
    "expected PE::panic not to emit call $pion_panic, got:\n" + p_ctor_fn,
  )

  // 2. Multi-package Wasm32 P47-A with package name containing `__pion_drop_`
  // (`p_a__pion_drop_helpers__deadbeef__` via `wasm_namespace_local_ssa`):
  // `wasm_namespace_local_ssa` preserves the `pion_drop_enum_` category prefix so
  // `Tree` folds to mask 0x80000003 while tagged 3-variant `Tri` stays unfolded.
  let raw_dep_both =
    #|function $pion_drop_enum_Tree(l %p) {
    #|@start
    #|  %v0 =l loadl %p
    #|  %nz0 =w cnel %v0, 0
    #|  jnz %nz0, @d0, @s0
    #|@d0
    #|  call $pion_rc_dec(l %v0)
    #|@s0
    #|  %p1 =l add %p, 8
    #|  %v1 =l loadl %p1
    #|  %nz1 =w cnel %v1, 0
    #|  jnz %nz1, @d1, @s1
    #|@d1
    #|  call $pion_rc_dec(l %v1)
    #|@s1
    #|  ret
    #|}
    #|function $pion_drop_enum_Tri(l %p) {
    #|@start
    #|  %tag =l loadl %p
    #|  %is1 =w ceql %tag, 1
    #|  jnz %is1, @t1, @end
    #|@t1
    #|  %p1 =l add %p, 8
    #|  %v1 =l loadl %p1
    #|  call $pion_rc_dec(l %v1)
    #|@end
    #|  ret
    #|}
    #|export function w $main() {
    #|@start
    #|  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)
    #|  %b =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tri)
    #|  call $pion_rc_dec(l %a)
    #|  call $pion_rc_dec(l %b)
    #|  ret 0
    #|}
  let wasm_ssa = wasm_namespace_local_ssa(raw_dep_both, "p_a__pion_drop_helpers__deadbeef__")
  assert_true(
    wasm_ssa.contains("function $pion_drop_enum_p_a__pion_drop_helpers__deadbeef__Tree("),
    "expected category prefix preserved:\n" + wasm_ssa,
  )
  let wbytes = emit_wasm_from_ssa(wasm_ssa)
  // Minimal Wasm section walker: locate Import (2), Export (7), Element (9), and Code (10)
  // so we inspect ONLY `$main`'s exact body (`main_func_idx - num_func_imports`),
  // never matching internal runtime helpers like `pion_drop_s2`.
  let mut pos = 8
  let mut num_func_imports = 0
  let mut main_func_idx = -1
  let mut main_start = 0
  let mut main_end = 0
  let mut code_fn_count = 0
  let mut elem_sec_len = 0
  while pos < wbytes.length() {
    let sec_id = wbytes[pos].to_int()
    pos = pos + 1
    let mut sec_len = 0
    let mut sh = 0
    while true {
      let b = wbytes[pos].to_int()
      pos = pos + 1
      sec_len = sec_len | ((b & 0x7F) << sh)
      if (b & 0x80) == 0 {
        break
      }
      sh = sh + 7
    }
    let sec_end = pos + sec_len
    if sec_id == 2 {
      let mut ip = pos
      let mut nimp = 0
      let mut shi = 0
      while true {
        let b = wbytes[ip].to_int()
        ip = ip + 1
        nimp = nimp | ((b & 0x7F) << shi)
        if (b & 0x80) == 0 {
          break
        }
        shi = shi + 7
      }
      let mut ii = 0
      while ii < nimp {
        // skip mod name + field name
        let mut s_step = 0
        while s_step < 2 {
          let mut sl = 0
          let mut shs = 0
          while true {
            let b = wbytes[ip].to_int()
            ip = ip + 1
            sl = sl | ((b & 0x7F) << shs)
            if (b & 0x80) == 0 {
              break
            }
            shs = shs + 7
          }
          ip = ip + sl
          s_step = s_step + 1
        }
        let kind = wbytes[ip].to_int()
        ip = ip + 1
        if kind == 0 {
          num_func_imports = num_func_imports + 1
          while (wbytes[ip].to_int() & 0x80) != 0 {
            ip = ip + 1
          }
          ip = ip + 1
        } else {
          break
        }
        ii = ii + 1
      }
    } else if sec_id == 7 {
      let mut ep = pos
      let mut nexp = 0
      let mut she = 0
      while true {
        let b = wbytes[ep].to_int()
        ep = ep + 1
        nexp = nexp | ((b & 0x7F) << she)
        if (b & 0x80) == 0 {
          break
        }
        she = she + 7
      }
      let mut ei = 0
      while ei < nexp {
        let mut nl = 0
        let mut shn = 0
        while true {
          let b = wbytes[ep].to_int()
          ep = ep + 1
          nl = nl | ((b & 0x7F) << shn)
          if (b & 0x80) == 0 {
            break
          }
          shn = shn + 7
        }
        let is_main = nl == 4 &&
          wbytes[ep] == b'm' &&
          wbytes[ep + 1] == b'a' &&
          wbytes[ep + 2] == b'i' &&
          wbytes[ep + 3] == b'n'
        ep = ep + nl
        let ekind = wbytes[ep].to_int()
        ep = ep + 1
        let mut eidx = 0
        let mut shx = 0
        while true {
          let b = wbytes[ep].to_int()
          ep = ep + 1
          eidx = eidx | ((b & 0x7F) << shx)
          if (b & 0x80) == 0 {
            break
          }
          shx = shx + 7
        }
        if is_main && ekind == 0 {
          main_func_idx = eidx
        }
        ei = ei + 1
      }
    } else if sec_id == 9 {
      elem_sec_len = sec_len
    } else if sec_id == 10 {
      let mut cp = pos
      let mut nfn = 0
      let mut sh2 = 0
      while true {
        let b = wbytes[cp].to_int()
        cp = cp + 1
        nfn = nfn | ((b & 0x7F) << sh2)
        if (b & 0x80) == 0 {
          break
        }
        sh2 = sh2 + 7
      }
      code_fn_count = nfn
      let target_fi = main_func_idx - num_func_imports
      let mut fi = 0
      while fi < nfn {
        let mut blen = 0
        let mut sh3 = 0
        while true {
          let b = wbytes[cp].to_int()
          cp = cp + 1
          blen = blen | ((b & 0x7F) << sh3)
          if (b & 0x80) == 0 {
            break
          }
          sh3 = sh3 + 7
        }
        if fi == target_fi {
          main_start = cp
          main_end = cp + blen
        }
        cp = cp + blen
        fi = fi + 1
      }
    }
    pos = sec_end
  }
  assert_true(main_end > main_start, "expected to locate exported $main body in Wasm Code section")
  // Inside `$main`'s body ALONE, `i64.const 0x80000003` (`42 83 80 80 80 08`) must appear
  // for `$p_dep__a1b2c3d4__pion_drop_enum_Tree`!
  let mut found_mask_in_main = false
  let mut wi = main_start
  while wi + 5 < main_end {
    if wbytes[wi] == b'\x42' &&
      wbytes[wi + 1] == b'\x83' &&
      wbytes[wi + 2] == b'\x80' &&
      wbytes[wi + 3] == b'\x80' &&
      wbytes[wi + 4] == b'\x80' &&
      wbytes[wi + 5] == b'\x08' {
      found_mask_in_main = true
      break
    }
    wi = wi + 1
  }
  assert_true(
    found_mask_in_main,
    "expected $main body to pass P47-A mask 0x80000003 for $p_dep__a1b2c3d4__pion_drop_enum_Tree",
  )
  // Verify Tree-only module has 1 fewer function body (Tree folded, Tri unfolded) and empty Element section
  let raw_dep_tree_only =
    #|function $pion_drop_enum_Tree(l %p) {
    #|@start
    #|  %v0 =l loadl %p
    #|  %nz0 =w cnel %v0, 0
    #|  jnz %nz0, @d0, @s0
    #|@d0
    #|  call $pion_rc_dec(l %v0)
    #|@s0
    #|  %p1 =l add %p, 8
    #|  %v1 =l loadl %p1
    #|  %nz1 =w cnel %v1, 0
    #|  jnz %nz1, @d1, @s1
    #|@d1
    #|  call $pion_rc_dec(l %v1)
    #|@s1
    #|  ret
    #|}
    #|export function w $main() {
    #|@start
    #|  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)
    #|  call $pion_rc_dec(l %a)
    #|  ret 0
    #|}
  let wasm_ssa_tree_only = wasm_namespace_local_ssa(raw_dep_tree_only, "p_a__pion_drop_helpers__deadbeef__")
  let wbytes_tree_only = emit_wasm_from_ssa(wasm_ssa_tree_only)
  let mut pos2 = 8
  let mut code_fn_count2 = 0
  let mut elem_sec_len2 = 0
  while pos2 < wbytes_tree_only.length() {
    let sec_id = wbytes_tree_only[pos2].to_int()
    pos2 = pos2 + 1
    let mut sec_len = 0
    let mut sh = 0
    while true {
      let b = wbytes_tree_only[pos2].to_int()
      pos2 = pos2 + 1
      sec_len = sec_len | ((b & 0x7F) << sh)
      if (b & 0x80) == 0 {
        break
      }
      sh = sh + 7
    }
    if sec_id == 9 {
      elem_sec_len2 = sec_len
    } else if sec_id == 10 {
      let mut cp = pos2
      let mut nfn = 0
      let mut sh2 = 0
      while true {
        let b = wbytes_tree_only[cp].to_int()
        cp = cp + 1
        nfn = nfn | ((b & 0x7F) << sh2)
        if (b & 0x80) == 0 {
          break
        }
        sh2 = sh2 + 7
      }
      code_fn_count2 = nfn
    }
    pos2 = pos2 + sec_len
  }
  assert_true(
    code_fn_count == code_fn_count2 + 1,
    "expected Tri to add exactly 1 unfolded Wasm function while Tree is folded",
  )
  assert_true(
    elem_sec_len > 0 && elem_sec_len2 == 0,
    "expected Tri to populate Element table while Tree-only has zero Element entries",
  )

  // 3. Exported functions whose names start with `pion_drop_enum_` or contain `__pion_drop_enum_`
  // must NEVER be folded or removed by P47-A:
  // (a) `p_api__v1__pion_drop_enum_notify` alongside `$main` must stay in Section 7 (Export).
  // (b) `pion_drop_enum_keep` in a library module (no `$main`, so `has_explicit_roots == false`
  //     and `wasm_is_export_root` keeps it) must stay in Section 7 (Export), guarded by `!df.exported`.
  let exp_ssa_1 =
    #|export function $p_api__v1__pion_drop_enum_notify(l %p) {
    #|@start
    #|  %v =l loadl %p
    #|  call $pion_rc_dec(l %v)
    #|  ret
    #|}
    #|export function w $main() {
    #|@start
    #|  ret 0
    #|}
  let exp_ssa_2 =
    #|export function $pion_drop_enum_keep(l %p) {
    #|@start
    #|  %v =l loadl %p
    #|  call $pion_rc_dec(l %v)
    #|  ret
    #|}
  let exp_wasm_1 = emit_wasm_from_ssa(exp_ssa_1)
  let exp_wasm_2 = emit_wasm_from_ssa(exp_ssa_2)
  let mut saw_exp_notify = false
  let mut saw_exp_keep = false
  let exp_bins : Array[Bytes] = [exp_wasm_1, exp_wasm_2]
  let mut bi = 0
  while bi < exp_bins.length() {
    let eb = exp_bins[bi]
    let mut epos = 8
    while epos < eb.length() {
      let sid = eb[epos].to_int()
      epos = epos + 1
      let mut slen = 0
      let mut sh = 0
      while true {
        let b = eb[epos].to_int()
        epos = epos + 1
        slen = slen | ((b & 0x7F) << sh)
        if (b & 0x80) == 0 {
          break
        }
        sh = sh + 7
      }
      let send = epos + slen
      if sid == 7 {
        let mut ep = epos
        let mut nexp = 0
        let mut she = 0
        while true {
          let b = eb[ep].to_int()
          ep = ep + 1
          nexp = nexp | ((b & 0x7F) << she)
          if (b & 0x80) == 0 {
            break
          }
          she = she + 7
        }
        let mut ei = 0
        while ei < nexp {
          let mut nl = 0
          let mut shn = 0
          while true {
            let b = eb[ep].to_int()
            ep = ep + 1
            nl = nl | ((b & 0x7F) << shn)
            if (b & 0x80) == 0 {
              break
            }
            shn = shn + 7
          }
          let nsb = StringBuilder()
          let mut ni = 0
          while ni < nl {
            nsb.write_char(eb[ep + ni].to_int() as Char)
            ni = ni + 1
          }
          let ename = nsb.to_string()
          ep = ep + nl
          let ekind = eb[ep].to_int()
          ep = ep + 1
          while (eb[ep].to_int() & 0x80) != 0 {
            ep = ep + 1
          }
          ep = ep + 1
          if ekind == 0 {
            if ename == "p_api__v1__pion_drop_enum_notify" {
              saw_exp_notify = true
            } else if ename == "pion_drop_enum_keep" {
              saw_exp_keep = true
            }
          }
          ei = ei + 1
        }
      }
      epos = send
    }
    bi = bi + 1
  }
  assert_true(
    saw_exp_notify && saw_exp_keep,
    "expected both exported drop-shaped functions to remain in Wasm Export section",
  )

  // 4. Zero-collision guarantee: same-unit (both declaration orders) AND cross-unit
  // ([dep, app] and [app, dep]) when an exported C symbol collides with a namespaced
  // local destructor `$pion_drop_enum_p_app__Tree` / `$pion_drop_enum_p_dep__Tree`.
  let local_tree_drop =
    #|function $pion_drop_enum_Tree(l %p) {
    #|@start
    #|  %v0 =l loadl %p
    #|  %nz0 =w cnel %v0, 0
    #|  jnz %nz0, @d0, @s0
    #|@d0
    #|  call $pion_rc_dec(l %v0)
    #|@s0
    #|  %p1 =l add %p, 8
    #|  %v1 =l loadl %p1
    #|  %nz1 =w cnel %v1, 0
    #|  jnz %nz1, @d1, @s1
    #|@d1
    #|  call $pion_rc_dec(l %v1)
    #|@s1
    #|  ret
    #|}
  let colliding_export =
    #|export function w $pion_drop_enum_p_app__Tree() {
    #|@start
    #|  ret 7
    #|}
  let main_alloc_and_call =
    #|export function w $main() {
    #|@start
    #|  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)
    #|  call $pion_rc_dec(l %a)
    #|  %r =w call $pion_drop_enum_p_app__Tree()
    #|  ret %r
    #|}
  // Order A: export before local; Order B: local before export
  let su_a = wasm_namespace_local_ssa(
    colliding_export + "\n" + local_tree_drop + "\n" + main_alloc_and_call,
    "p_app__",
  )
  let su_b = wasm_namespace_local_ssa(
    local_tree_drop + "\n" + colliding_export + "\n" + main_alloc_and_call,
    "p_app__",
  )
  assert_true(
    su_a.contains("function $pion_drop_enum_p_app__Tree_d1(") &&
    su_a.contains("export function w $pion_drop_enum_p_app__Tree("),
    "expected same-unit Order A disambiguation:\n" + su_a,
  )
  assert_true(
    su_b.contains("function $pion_drop_enum_p_app__Tree_d1(") &&
    su_b.contains("export function w $pion_drop_enum_p_app__Tree("),
    "expected same-unit Order B disambiguation:\n" + su_b,
  )
  // Cross-unit Order C ([dep, app]) & Order D ([app, dep])
  let dep_u = wasm_namespace_local_ssa(
    local_tree_drop + "\n" +
    "export function l $dep_mk() {\n@start\n  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)\n  ret %a\n}\n",
    "p_dep__",
  )
  let app_u =
    #|export function w $pion_drop_enum_p_dep__Tree() {
    #|@start
    #|  ret 7
    #|}
    #|export function w $main() {
    #|@start
    #|  %a =l call $dep_mk()
    #|  call $pion_rc_dec(l %a)
    #|  %r =w call $pion_drop_enum_p_dep__Tree()
    #|  ret %r
    #|}
  let cu_c = emit_wasm_from_ssa_units_opts([dep_u, app_u], false, fn(_) { () })
  let cu_d = emit_wasm_from_ssa_units_opts([app_u, dep_u], false, fn(_) { () })
  // R7 external-reference / host-import zero-collision cases:
  // (4) Same-unit host import: local Tree drop + bodiless call l $pion_drop_enum_p_app__Tree()
  let su_host = wasm_namespace_local_ssa(
    local_tree_drop + "\n" +
    "export function l $main() {\n@start\n  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)\n  call $pion_rc_dec(l %a)\n  %r =l call $pion_drop_enum_p_app__Tree()\n  ret %r\n}\n",
    "p_app__",
  )
  assert_true(
    su_host.contains("function $pion_drop_enum_p_app__Tree_d1(") &&
    su_host.contains("call $pion_drop_enum_p_app__Tree()"),
    "expected same-unit host-import disambiguation:\n" + su_host,
  )
  // (5, 6) Cross-unit: call in dep + export in app, both [dep, app] and [app, dep]
  let dep_call_u = wasm_namespace_local_ssa(
    local_tree_drop + "\n" +
    "export function l $dep_mk() {\n@start\n  %a =l call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Tree)\n  call $pion_rc_dec(l %a)\n  %r =l call $pion_drop_enum_p_dep__Tree()\n  ret %r\n}\n",
    "p_dep__",
  )
  assert_true(
    dep_call_u.contains("function $pion_drop_enum_p_dep__Tree_d1(") &&
    dep_call_u.contains("call $pion_drop_enum_p_dep__Tree()"),
    "expected dep external-call disambiguation:\n" + dep_call_u,
  )
  let app_exp_u =
    #|export function l $pion_drop_enum_p_dep__Tree() {
    #|@start
    #|  ret 7
    #|}
    #|export function l $main() {
    #|@start
    #|  %r =l call $dep_mk()
    #|  ret %r
    #|}
  let cu_e = emit_wasm_from_ssa_units_opts([dep_call_u, app_exp_u], false, fn(_) { () })
  let cu_f = emit_wasm_from_ssa_units_opts([app_exp_u, dep_call_u], false, fn(_) { () })
  // (7, 8) Cross-unit host import: dep has only local Tree drop, app calls bodiless host import
  let app_host_u =
    #|export function l $main() {
    #|@start
    #|  %a =l call $dep_mk()
    #|  call $pion_rc_dec(l %a)
    #|  %r =l call $pion_drop_enum_p_dep__Tree()
    #|  ret %r
    #|}
  let cu_g = emit_wasm_from_ssa_units_opts([dep_u, app_host_u], false, fn(_) { () })
  let cu_h = emit_wasm_from_ssa_units_opts([app_host_u, dep_u], false, fn(_) { () })
  let col_bins : Array[Bytes] = [
    emit_wasm_from_ssa(su_a),
    emit_wasm_from_ssa(su_b),
    cu_c,
    cu_d,
    emit_wasm_from_ssa(su_host),
    cu_e,
    cu_f,
    cu_g,
    cu_h,
  ]
  let col_user_fns : Array[Int] = [2, 2, 3, 3, 1, 3, 3, 2, 2]
  let col_req_imp : Array[String] = [
    "",
    "",
    "",
    "",
    "pion_drop_enum_p_app__Tree",
    "",
    "",
    "pion_drop_enum_p_dep__Tree",
    "pion_drop_enum_p_dep__Tree",
  ]
  let mut cbi = 0
  while cbi < col_bins.length() {
    let cb = col_bins[cbi]
    let req_imp = col_req_imp[cbi]
    let mut cpos = 8
    let mut c_nimp = 0
    let mut c_saw_req_imp = req_imp == ""
    let mut c_main_fidx = -1
    let mut c_elem_len = 0
    let mut c_found_mask = false
    while cpos < cb.length() {
      let sid = cb[cpos].to_int()
      cpos = cpos + 1
      let mut slen = 0
      let mut sh = 0
      while true {
        let b = cb[cpos].to_int()
        cpos = cpos + 1
        slen = slen | ((b & 0x7F) << sh)
        if (b & 0x80) == 0 {
          break
        }
        sh = sh + 7
      }
      let send = cpos + slen
      if sid == 2 {
        let mut ip = cpos
        let mut nimp = 0
        let mut shi = 0
        while true {
          let b = cb[ip].to_int()
          ip = ip + 1
          nimp = nimp | ((b & 0x7F) << shi)
          if (b & 0x80) == 0 {
            break
          }
          shi = shi + 7
        }
        let mut ii = 0
        while ii < nimp {
          let mut ml = 0
          let mut shm = 0
          while true {
            let b = cb[ip].to_int()
            ip = ip + 1
            ml = ml | ((b & 0x7F) << shm)
            if (b & 0x80) == 0 {
              break
            }
            shm = shm + 7
          }
          ip = ip + ml
          let mut fl = 0
          let mut shf = 0
          while true {
            let b = cb[ip].to_int()
            ip = ip + 1
            fl = fl | ((b & 0x7F) << shf)
            if (b & 0x80) == 0 {
              break
            }
            shf = shf + 7
          }
          let fname_start = ip
          ip = ip + fl
          let kind = cb[ip].to_int()
          ip = ip + 1
          if kind == 0 {
            c_nimp = c_nimp + 1
            if req_imp != "" && fl == req_imp.length() {
              let mut eq_imp = true
              let mut ci = 0
              while ci < fl {
                if cb[fname_start + ci].to_int() != str_code_at(req_imp, ci) {
                  eq_imp = false
                  break
                }
                ci = ci + 1
              }
              if eq_imp {
                c_saw_req_imp = true
              }
            }
            while (cb[ip].to_int() & 0x80) != 0 {
              ip = ip + 1
            }
            ip = ip + 1
          } else {
            break
          }
          ii = ii + 1
        }
      } else if sid == 7 {
        let mut ep = cpos
        let mut nexp = 0
        let mut she = 0
        while true {
          let b = cb[ep].to_int()
          ep = ep + 1
          nexp = nexp | ((b & 0x7F) << she)
          if (b & 0x80) == 0 {
            break
          }
          she = she + 7
        }
        let mut ei = 0
        while ei < nexp {
          let mut nl = 0
          let mut shn = 0
          while true {
            let b = cb[ep].to_int()
            ep = ep + 1
            nl = nl | ((b & 0x7F) << shn)
            if (b & 0x80) == 0 {
              break
            }
            shn = shn + 7
          }
          let is_m = nl == 4 &&
            cb[ep] == b'm' &&
            cb[ep + 1] == b'a' &&
            cb[ep + 2] == b'i' &&
            cb[ep + 3] == b'n'
          ep = ep + nl
          let ekind = cb[ep].to_int()
          ep = ep + 1
          let mut eidx = 0
          let mut shx = 0
          while true {
            let b = cb[ep].to_int()
            ep = ep + 1
            eidx = eidx | ((b & 0x7F) << shx)
            if (b & 0x80) == 0 {
              break
            }
            shx = shx + 7
          }
          if is_m && ekind == 0 {
            c_main_fidx = eidx
          }
          ei = ei + 1
        }
      } else if sid == 9 {
        c_elem_len = slen
      } else if sid == 10 {
        let mut cp = cpos
        let mut nfn = 0
        let mut sh2 = 0
        while true {
          let b = cb[cp].to_int()
          cp = cp + 1
          nfn = nfn | ((b & 0x7F) << sh2)
          if (b & 0x80) == 0 {
            break
          }
          sh2 = sh2 + 7
        }
        let c_user_fns = col_user_fns[cbi]
        assert_true(
          c_main_fidx >= c_nimp && c_main_fidx - c_nimp < c_user_fns,
          "expected main within user function range in collision case " + cbi.to_string(),
        )
        let mut fi = 0
        while fi < nfn {
          let mut blen = 0
          let mut sh3 = 0
          while true {
            let b = cb[cp].to_int()
            cp = cp + 1
            blen = blen | ((b & 0x7F) << sh3)
            if (b & 0x80) == 0 {
              break
            }
            sh3 = sh3 + 7
          }
          if fi < c_user_fns {
            let mut wi2 = cp
            while wi2 + 5 < cp + blen {
              if cb[wi2] == b'\x42' &&
                cb[wi2 + 1] == b'\x83' &&
                cb[wi2 + 2] == b'\x80' &&
                cb[wi2 + 3] == b'\x80' &&
                cb[wi2 + 4] == b'\x80' &&
                cb[wi2 + 5] == b'\x08' {
                c_found_mask = true
                break
              }
              wi2 = wi2 + 1
            }
          }
          cp = cp + blen
          fi = fi + 1
        }
      }
      cpos = send
    }
    assert_true(
      c_found_mask && c_elem_len == 0 && c_saw_req_imp,
      "expected local Tree drop folded to 0x80000003, empty Element section, and preserved host import in collision case " +
      cbi.to_string(),
    )
    cbi = cbi + 1
  }
}

///|
test "r232: untyped tuple array literal passed to a generic Array[(K, V)] parameter monomorphizes the callee" {
  let src =
    #|struct Box[K, V] {
    #|  keys : Array[K]
    #|  vals : Array[V]
    #|}
    #|fn mk[K, V](ps : Array[(K, V)]) -> Box[K, V] {
    #|  let keys : Array[K] = []
    #|  let vals : Array[V] = []
    #|  for p in ps {
    #|    keys.push(p.0)
    #|    vals.push(p.1)
    #|  }
    #|  Box::{ keys, vals }
    #|}
    #|fn Box::from_array[K, V](ps : Array[(K, V)]) -> Box[K, V] {
    #|  mk(ps)
    #|}
    #|fn same_name[K](x : K) -> Int {
    #|  let b = mk([(x, 10)])
    #|  b.keys.length()
    #|}
    #|pub fn main() -> Int {
    #|  let b = mk([(1, 10), (2, 20), (1, 30)])
    #|  let h = Box::from_array([(1, "a"), (2, "b")])
    #|  let mut s = 0
    #|  for i, k in b.keys {
    #|    s = s + k * 100 + b.vals[i]
    #|  }
    #|  s + h.keys.length() + same_name("k")
    #|}
  let cr = check_source_files_full("t_r232", ["t.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, true, []).ssa
  assert_true(ssa.contains("function l $pion_fn_mk__mono_Int_Int("), "mk must monomorphize for (Int, Int):\n" + ssa)
  assert_true(ssa.contains("function l $pion_fn_mk__mono_Int_String("), "assoc fn must monomorphize mk for (Int, String)")
  // `same_name` stays erased: its own `K` binds the callee's `K` as-is and
  // never shows up as a monomorphization argument.
  assert_true(!ssa.contains("__mono_K"), "caller `K` must not leak into a callee instantiation")
}

///|
fn modp2_tick_i8(c : Array[Int]) -> Int8 {
  c[0] = c[0] + 1
  (c[0] * 37 - 100).to_int8()
}

///|
fn modp2_tick_byte(c : Array[Int]) -> Byte {
  c[0] = c[0] + 1
  (c[0] * 37).to_byte()
}

///|
test "mod_pow2_eq_zero: operand evaluated once, exact on Byte / Int8" {
  // The operand has a side effect: each test must call it exactly once, in
  // `if` conditions and in value contexts.
  let c : Array[Int] = [0]
  let mut hits = 0
  if modp2_tick_i8(c) % 2 == 0 { hits = hits + 1 }
  if b'\x00' != modp2_tick_byte(c) % b'\x04' { hits = hits + 10 }
  let v = modp2_tick_i8(c) % 64 == 0
  if v { hits = hits + 100 }
  assert_eq(c[0], 3)
  // -63 odd; 74 % 4 = 2; 11 % 64 = 11
  assert_eq(hits, 10)
  // Every 8-bit value against the Int remainder of the same value.
  let mut x = 0
  while x < 256 {
    let b = x.to_byte()
    let s = (x - 128).to_int8()
    let si = x - 128
    assert_true((b % b'\x02' == b'\x00') == (x % 2 == 0), "byte mod2")
    assert_true((b % b'\x10' != b'\x00') == (x % 16 != 0), "byte mod16")
    assert_true((b % b'\x80' == b'\x00') == (x % 128 == 0), "byte mod128")
    assert_true((s % 2 == 0) == (si % 2 == 0), "int8 mod2")
    assert_true((s % 8 != 0) == (si % 8 != 0), "int8 mod8")
    assert_true((s % 64 == 0) == (si % 64 == 0), "int8 mod64")
    x = x + 1
  }
}

///|
test "p130 static byte data quotes plain runs and keeps every other byte numeric" {
  let sb = StringBuilder()
  qbe_emit_bytes_data(sb, [65, 66, 0, 255, 92, 34, 36, 32, 49, 10, 67, 43, 47, 61])
  assert_eq(sb.to_string(), "b \"AB\", b 0, b 255, b 92, b 34, b 36, b \" 1\", b 10, b \"C+/=\", b 0")
  let single = StringBuilder()
  qbe_emit_bytes_data(single, [97])
  assert_eq(single.to_string(), "b 97, b 0")
  // Quote, backslash and `$` split a run; multibyte UTF-8 stays numeric.
  let split = StringBuilder()
  qbe_emit_bytes_data(split, str_to_utf8_ints("ab\"cd\\ef$gh\u{e9}ij"))
  assert_eq(
    split.to_string(),
    "b \"ab\", b 34, b \"cd\", b 92, b \"ef\", b 36, b \"gh\", b 195, b 169, b \"ij\", b 0",
  )
  let empty = StringBuilder()
  qbe_emit_bytes_data(empty, [])
  assert_eq(empty.to_string(), "b 0")
}

///|
fn p130_int_literals(n : Int, suffix : String) -> String {
  let values = StringBuilder()
  let mut i = 0
  while i < n {
    values.write_string(i.to_string())
    values.write_string(suffix)
    values.write_string(", ")
    i = i + 1
  }
  values.to_string()
}

///|
fn p130_ssa(src : String) -> String {
  let cr = check_source_files_with_imports("words", ["words.pion"], [src], [], true)
  assert_eq(cr.diagnostics.length(), 0)
  emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
}

///|
test "p130 large Int literal arrays copy a private word table, other arrays keep stores" {
  let lits = p130_int_literals(1021, "")
  let tys = ["Array[Int]", "FixedArray[Int]", "ImmArray[Int]"]
  for ty in tys {
    let ssa = p130_ssa(
      "pub fn make(x : Int) -> " + ty + " { let a : " + ty + " = [" + lits +
      "-2147483648, 2147483647, -0x1F]; a }",
    )
    assert_true(ssa.contains(" =l call $pion_arr_copy(l $pion_pkg_words_i32_literal_0)"), ssa)
    assert_true(ssa.contains("w 1020, w -2147483648, w 2147483647, w -31 }"), ssa)
    assert_true(ssa.contains("data $pion_pkg_words_i32_literal_0 = align 8 { l 1024, l 1024, w 0, w 4, l $pion_pkg_words_i32_literal_0_words }"), ssa)
  }
  // Table names skip every name a user `extern "C"` export already links under.
  let taken = p130_ssa(
    "pub extern \"C\" fn answer() -> Int = \"pion_pkg_words_i32_literal_0\" { 17 }\n" +
    "pub extern \"C\" fn answer2() -> Int = \"pion_pkg_words_i32_literal_1_words\" { 18 }\n" +
    "pub fn make(x : Int) -> Array[Int] { let a : Array[Int] = [" + lits + "1, 2, 3]; a }\n" +
    "pub fn make2(x : Int) -> Array[Int] { let a : Array[Int] = [" + lits + "4, 5, 6]; a }",
  )
  assert_true(taken.contains("call $pion_arr_copy(l $pion_pkg_words_i32_literal_2)"), taken)
  assert_true(taken.contains("call $pion_arr_copy(l $pion_pkg_words_i32_literal_3)"), taken)
  assert_true(!taken.contains("data $pion_pkg_words_i32_literal_0"), taken)
  assert_true(!taken.contains("data $pion_pkg_words_i32_literal_1"), taken)
  // ... and the `--entry-symbol` entry point.
  for sym in ["pion_pkg_words_i32_literal_0", "pion_pkg_words_i32_literal_0_words"] {
    let cr = check_source_files_with_imports(
      "words",
      ["words.pion"],
      [
        "pub fn make(x : Int) -> Array[Int] { let a : Array[Int] = [" + lits + "1, 2, 3]; a }\n" +
        "pub fn main(world : World) -> Int { make(1).length() }",
      ],
      [],
      true,
    )
    assert_eq(cr.diagnostics.length(), 0)
    let ssa = emit_qbe_package_multi_entry(cr.pkg, cr.tc, true, true, [], false, sym, false).ssa
    assert_true(ssa.contains("export function w $" + sym + "("), ssa)
    assert_true(ssa.contains("call $pion_arr_copy(l $pion_pkg_words_i32_literal_1)"), ssa)
    assert_true(!ssa.contains("data $pion_pkg_words_i32_literal_0"), ssa)
    // A non-entry package (or `--no-main`) exports no entry point: its
    // tables, and so its cached object, do not depend on the entry symbol.
    let dep = emit_qbe_package_multi_entry(cr.pkg, cr.tc, true, false, [], false, sym, false).ssa
    assert_true(dep.contains("call $pion_arr_copy(l $pion_pkg_words_i32_literal_0)"), dep)
    let lib = emit_qbe_package_multi_entry(cr.pkg, cr.tc, true, true, [], false, sym, true).ssa
    assert_true(lib.contains("call $pion_arr_copy(l $pion_pkg_words_i32_literal_0)"), lib)
  }
  // 1,023 elements, a dynamic element and a non-Int element type keep stores.
  let fallbacks = [
    "pub fn make(x : Int) -> Array[Int] { let a : Array[Int] = [" + lits + "1, 2]; a }",
    "pub fn make(x : Int) -> Array[Int] { let a : Array[Int] = [" + lits + "1, 2, x]; a }",
    "pub fn make(x : Int) -> Array[Int64] { let a : Array[Int64] = [" + p130_int_literals(1024, "L") + "]; a }",
  ]
  for src in fallbacks {
    let ssa = p130_ssa(src)
    assert_true(!ssa.contains("i32_literal_"), ssa)
    assert_true(!ssa.contains("$pion_arr_copy"), ssa)
  }
}

///|
fn p130_rows_body(rows : String) -> String {
  let src =
    #|struct Pair {
    #|  left : String
    #|  right : String
    #|}
    #|fn rows(s : String) -> Array[Pair] {
  let ssa = emit_qbe_package(parse_package("test", ["rows.pion"], [src + "\n  [" + rows + "]\n}\n"]), false).ssa
  let start = p18_find_from(ssa, "function l $pion_fn_rows(", 0)
  let stop = p18_find_from(ssa, "\n}", start)
  assert_true(start >= 0 && stop > start, "expected rows function")
  slice_str(ssa, start, stop)
}

///|
test "p130 flat string records are stored directly, other records keep row boxes" {
  let direct = p130_rows_body(
    "Pair::{ left: \"one\", right: \"two\" }, Pair::{ left: \"two\", right: \"one\" }, Pair::{ left: \"one\", right: \"one\" }",
  )
  assert_true(direct.contains("call $pion_arr_new(l 3, "), direct)
  assert_true(!direct.contains("call $pion_alloc_uninit("), direct)
  let fallbacks = [
    "Pair::{ left: s, right: \"two\" }, Pair::{ left: \"two\", right: \"one\" }",
    "Pair::{ right: \"one\", left: \"two\" }, Pair::{ left: \"two\", right: \"one\" }",
    "Pair::{ left: \"one\", right: \"two\" }",
  ]
  for rows in fallbacks {
    let f = p130_rows_body(rows)
    assert_true(f.contains("call $pion_alloc_uninit("), f)
  }
}

///|
fn p130_spans(bytes : Array[Int]) -> String {
  let sb = StringBuilder()
  for s in wasm_data_spans(bytes) {
    sb.write_string(s.start.to_string() + ".." + s.stop.to_string() + " ")
  }
  sb.to_string()
}

///|
fn p130_bytes(parts : Array[(Int, Int)]) -> Array[Int] {
  let out : Array[Int] = []
  for p in parts {
    let (v, n) = p
    let mut i = 0
    while i < n {
      out.push(v)
      i = i + 1
    }
  }
  out
}

///|
test "p130 wasm data spans skip edge and long interior zero runs" {
  assert_eq(p130_spans([]), "")
  assert_eq(p130_spans(p130_bytes([(0, 40)])), "")
  assert_eq(p130_spans(p130_bytes([(0, 3), (5, 2)])), "3..5 ")
  assert_eq(p130_spans(p130_bytes([(1, 2), (0, 3)])), "0..2 ")
  assert_eq(p130_spans(p130_bytes([(1, 1), (0, 15), (2, 1)])), "0..17 ")
  assert_eq(p130_spans(p130_bytes([(0, 1), (1, 1), (0, 16), (2, 1), (0, 2)])), "1..2 18..19 ")
  let one = wasm_data_spans(p130_bytes([(0, 2), (7, 3)]))
  let header : Array[Int] = [0x00, 0x41]
  wasm_push_s32(header, WASM_DATA_BASE + 2)
  header.push(0x0B)
  header.push(3)
  assert_eq(one.length(), 1)
  assert_eq(one[0].header, header)
  // 5,000 one-byte runs: 4,095 spans, then one dense tail span.
  let parts : Array[(Int, Int)] = []
  let mut k = 0
  while k < 5000 {
    parts.push((1, 1))
    parts.push((0, 16))
    k = k + 1
  }
  let many = wasm_data_spans(p130_bytes(parts))
  assert_eq(many.length(), 4096)
  assert_eq(many[4094].start, 4094 * 17)
  assert_eq(many[4094].stop, 4094 * 17 + 1)
  assert_eq(many[4095].start, 4095 * 17)
  assert_eq(many[4095].stop, 5000 * 17)
  // A leading zero takes none of the 4,095 scan spans: a leading zero, 4,095
  // cut blocks and a final byte give exactly 4,096 spans.
  let edge_parts : Array[(Int, Int)] = [(0, 1)]
  let mut e = 0
  while e < 4095 {
    edge_parts.push((1, 1))
    edge_parts.push((0, 16))
    e = e + 1
  }
  edge_parts.push((1, 1))
  let edge = wasm_data_spans(p130_bytes(edge_parts))
  assert_eq(edge.length(), 4096)
  assert_eq(edge[0].start, 1)
  assert_eq(edge[0].stop, 2)
  assert_eq(edge[4094].start, 1 + 4094 * 17)
  assert_eq(edge[4095].start, 1 + 4095 * 17)
  assert_eq(edge[4095].stop, 2 + 4095 * 17)
}

///|
test "p133 for-range body shadowing loop var separates step scope" {
  let shadowed_src =
    #|pub fn f(n : Int) -> Int {
    #|  let mut sum = 0
    #|  for i in 0..<n {
    #|    let i = i
    #|    sum = sum + i
    #|  }
    #|  sum
    #|}
  let pkg = parse_package("test", ["shadow.pion"], [shadowed_src])
  let res = emit_qbe_package(pkg, false)
  assert_true(res.ssa.contains("@forr_s"), res.ssa)
  let plain_src =
    #|pub fn g(n : Int) -> Int {
    #|  let mut sum = 0
    #|  for i in 0..<n {
    #|    sum = sum + i
    #|  }
    #|  sum
    #|}
  let pkg2 = parse_package("test", ["plain.pion"], [plain_src])
  let res2 = emit_qbe_package(pkg2, false)
  assert_true(!res2.ssa.contains("@forr_s"), res2.ssa)
}

///|
test "p134_generic_eq_arith_diamond_cycle_linear_scan" {
  // 12-layer all-false diamond into a self-loop: 26 nodes, 49 edges.
  // Must return false for both eq and arith AND scan each decl's AST at most once (<= 26).
  let sb = StringBuilder()
  sb.write_string("pub fn sink[T](x : T, n : Int) -> T {\n  if false { sink(x, n) } else { x }\n}\n")
  sb.write_string("pub fn a12[T](x : T, n : Int) -> T {\n  if false { sink(x, n) } else { sink(x, n) }\n}\n")
  sb.write_string("pub fn b12[T](x : T, n : Int) -> T {\n  if false { sink(x, n) } else { sink(x, n) }\n}\n")
  let mut layer = 11
  while layer >= 1 {
    let cur = layer.to_string()
    let nxt = (layer + 1).to_string()
    sb.write_string("pub fn a" + cur + "[T](x : T, n : Int) -> T {\n  if false { a" + nxt + "(x, n) } else { b" + nxt + "(x, n) }\n}\n")
    sb.write_string("pub fn b" + cur + "[T](x : T, n : Int) -> T {\n  if false { a" + nxt + "(x, n) } else { b" + nxt + "(x, n) }\n}\n")
    layer = layer - 1
  }
  sb.write_string("pub fn top[T](x : T, n : Int) -> T {\n  if false { a1(x, n) } else { b1(x, n) }\n}\n")
  let cr = check_source_files_full("test", ["diamond.pion"], [sb.to_string()])
  assert_eq(cr.diagnostics.length(), 0)
  let g = qbe_new(cr.tc, false, false)
  match cr.tc.fns.get("top") {
    Some(top_fi) => {
      assert_eq(qbe_fn_body_has_eq(g, top_fi, ""), false)
      assert_eq(qbe_fn_body_has_arith(g, top_fi, ""), false)
      assert_true(
        g.generic_scan_count <= 26 && g.generic_scan_count == 26,
        "expected exactly 26 single-pass AST scans, got " + g.generic_scan_count.to_string(),
      )
    }
    None => assert_true(false, "missing top fn")
  }
}

///|
test "p134_generic_eq_arith_cycle_with_true_order_independent" {
  let fwd_src =
    #|pub fn c0[T](x : T, y : T) -> Bool {
    #|  if false { c1(x, y) } else { false }
    #|}
    #|pub fn c1[T](x : T, y : T) -> Bool {
    #|  if false { c2(x, y) } else { false }
    #|}
    #|pub fn c2[T](x : T, y : T) -> Bool {
    #|  if false { c0(x, y) } else { x == y }
    #|}
  let rev_src =
    #|pub fn c2[T](x : T, y : T) -> Bool {
    #|  if false { c0(x, y) } else { x == y }
    #|}
    #|pub fn c1[T](x : T, y : T) -> Bool {
    #|  if false { c2(x, y) } else { false }
    #|}
    #|pub fn c0[T](x : T, y : T) -> Bool {
    #|  if false { c1(x, y) } else { false }
    #|}
  let srcs = [fwd_src, rev_src]
  let mut pi = 0
  while pi < srcs.length() {
    let cr = check_source_files_full("test", ["cyc.pion"], [srcs[pi]])
    assert_eq(cr.diagnostics.length(), 0)
    let g = qbe_new(cr.tc, false, false)
    match cr.tc.fns.get("c0") {
      Some(fi0) => assert_eq(qbe_fn_body_has_eq(g, fi0, ""), true)
      None => assert_true(false, "missing c0")
    }
    match cr.tc.fns.get("c1") {
      Some(fi1) => assert_eq(qbe_fn_body_has_eq(g, fi1, ""), true)
      None => assert_true(false, "missing c1")
    }
    match cr.tc.fns.get("c2") {
      Some(fi2) => assert_eq(qbe_fn_body_has_eq(g, fi2, ""), true)
      None => assert_true(false, "missing c2")
    }
    assert_eq(g.generic_scan_count, 3)
    pi = pi + 1
  }
}

///|
test "p134_generic_struct_lit_spread_eq_and_arith" {
  let src =
    #|pub struct S {
    #|  pub a : Int
    #|  pub b : Int
    #|}
    #|pub fn spread_eq[T](x : T, y : T, base : S) -> S {
    #|  S::{ ..(if x == y { base } else { base }), a: 1 }
    #|}
    #|pub fn spread_arith[T](x : T, y : T, base : S) -> S {
    #|  S::{ ..({ let _ = x + y; base }), a: 2 }
    #|}
  let cr = check_source_files_full("test", ["spread.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let g = qbe_new(cr.tc, false, false)
  match cr.tc.fns.get("spread_eq") {
    Some(fi) => {
      assert_eq(qbe_fn_body_has_eq(g, fi, ""), true)
      assert_eq(qbe_fn_body_has_arith(g, fi, ""), false)
    }
    None => assert_true(false, "missing spread_eq")
  }
  match cr.tc.fns.get("spread_arith") {
    Some(fi) => {
      assert_eq(qbe_fn_body_has_eq(g, fi, ""), false)
      assert_eq(qbe_fn_body_has_arith(g, fi, ""), true)
    }
    None => assert_true(false, "missing spread_arith")
  }
}

///|
test "p134_generic_xpkg_method_eq_propagation" {
  let dep_src =
    #|fn inner_eq[T](a : T, b : T) -> Bool {
    #|  a == b
    #|}
    #|pub struct Box {
    #|  pub id : Int
    #|}
    #|pub fn Box::helper[T](self : Box, a : T, b : T) -> Bool {
    #|  let _ = self.id
    #|  inner_eq(a, b)
    #|}
  let dep_cr = check_source_files_with_imports("dep", ["dep.pion"], [dep_src], [], true)
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))
  let app_src =
    #|import "dep"
    #|pub fn check_box[T](b : dep::Box, a : T, c : T) -> Bool {
    #|  b.helper(a, c)
    #|}
  let imported = [imported_pkg_new("dep", dep_cr.tc)]
  let app_cr = check_source_files_with_imports("app", ["app.pion"], [app_src], imported, true)
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let g = qbe_new(app_cr.tc, false, false)
  match app_cr.tc.fns.get("check_box") {
    Some(fi) => assert_eq(qbe_fn_body_has_eq(g, fi, ""), true)
    None => assert_true(false, "missing check_box")
  }
}

///|
test "p134_generic_xpkg_method_arith_phys_and_alias_static_propagation" {
  // Arith and physical_equal are NOT copied into eq_tparams, so these tests
  // directly verify cross-package (callee_pkg, callee_tc) switching for both
  // instance methods and aliased static generic methods (`m::Box::...`).
  let dep_src =
    #|fn inner_arith[T](a : T, b : T) -> T {
    #|  a + b
    #|}
    #|fn inner_phys[T](a : T, b : T) -> Bool {
    #|  physical_equal(a, b)
    #|}
    #|pub struct Box {
    #|  pub id : Int
    #|}
    #|pub fn Box::helper_arith[T](self : Box, a : T, b : T) -> T {
    #|  let _ = self.id
    #|  inner_arith(a, b)
    #|}
    #|pub fn Box::helper_phys[T](self : Box, a : T, b : T) -> Bool {
    #|  let _ = self.id
    #|  inner_phys(a, b)
    #|}
    #|pub fn Box::check_static_arith[T](a : T, b : T) -> T {
    #|  inner_arith(a, b)
    #|}
    #|pub fn Box::check_static_phys[T](a : T, b : T) -> Bool {
    #|  inner_phys(a, b)
    #|}
  let dep_cr = check_source_files_with_imports("dep", ["dep.pion"], [dep_src], [], true)
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))
  let app_src =
    #|import "dep" as m
    #|pub fn f_arith[T](b : m::Box, x : T, y : T) -> T {
    #|  b.helper_arith(x, y)
    #|}
    #|pub fn f_phys[T](b : m::Box, x : T, y : T) -> Bool {
    #|  b.helper_phys(x, y)
    #|}
    #|pub fn f_stat_arith[T](x : T, y : T) -> T {
    #|  m::Box::check_static_arith(x, y)
    #|}
    #|pub fn f_stat_phys[T](x : T, y : T) -> Bool {
    #|  m::Box::check_static_phys(x, y)
    #|}
  let imported = [imported_pkg_new("dep", dep_cr.tc)]
  let app_cr = check_source_files_with_imports("app", ["app.pion"], [app_src], imported, true)
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let g = qbe_new(app_cr.tc, false, false)
  match app_cr.tc.fns.get("f_arith") {
    Some(fi) => assert_eq(qbe_fn_body_has_arith(g, fi, ""), true)
    None => assert_true(false, "missing f_arith")
  }
  match app_cr.tc.fns.get("f_phys") {
    Some(fi) => assert_eq(qbe_fn_body_has_eq(g, fi, ""), true)
    None => assert_true(false, "missing f_phys")
  }
  match app_cr.tc.fns.get("f_stat_arith") {
    Some(fi) => assert_eq(qbe_fn_body_has_arith(g, fi, ""), true)
    None => assert_true(false, "missing f_stat_arith")
  }
  match app_cr.tc.fns.get("f_stat_phys") {
    Some(fi) => assert_eq(qbe_fn_body_has_eq(g, fi, ""), true)
    None => assert_true(false, "missing f_stat_phys")
  }
}

///|
test "p134_generic_xpkg_canonical_method_key_not_hijacked_by_alias" {
  let real_src =
    #|pub struct Box {
    #|  pub id : Int
    #|}
    #|pub fn Box::calc[T](self : Box, a : T, b : T) -> T {
    #|  let _ = self.id
    #|  a + b
    #|}
  let decoy_src =
    #|pub struct Box {
    #|  pub id : Int
    #|}
    #|pub fn Box::calc[T](self : Box, a : T, _b : T) -> T {
    #|  let _ = self.id
    #|  a
    #|}
  let real_cr = check_source_files_with_imports("real", ["real.pion"], [real_src], [], true)
  assert_true(real_cr.diagnostics.length() == 0, check_result_to_json(real_cr.diagnostics))
  let decoy_cr = check_source_files_with_imports("decoy", ["decoy.pion"], [decoy_src], [], true)
  assert_true(decoy_cr.diagnostics.length() == 0, check_result_to_json(decoy_cr.diagnostics))
  let imported = [
    imported_pkg_new("real", real_cr.tc),
    imported_pkg_new("decoy", decoy_cr.tc),
  ]
  let cases = [
    "import \"real\" as r\nimport \"decoy\" as spare\npub fn wrap[T](b : r::Box, a : T, c : T) -> T {\n  b.calc(a, c)\n}\n",
    "import \"real\" as r\nimport \"decoy\" as real\npub fn wrap[T](b : r::Box, a : T, c : T) -> T {\n  b.calc(a, c)\n}\n",
  ]
  let mut ci = 0
  while ci < cases.length() {
    let app_cr = check_source_files_with_imports("app", ["app.pion"], [cases[ci]], imported, true)
    assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
    let g = qbe_new(app_cr.tc, false, false)
    match app_cr.tc.fns.get("wrap") {
      Some(fi) =>
        assert_true(
          qbe_fn_body_has_arith(g, fi, ""),
          "case #" + ci.to_string() + " must resolve canonical real::Box::calc, not alias decoy",
        )
      None => assert_true(false, "missing wrap")
    }
    ci = ci + 1
  }
}

///|
test "p134_norm_mono_pkg_and_same_ssa_native_wasm" {
  let src =
    #|pub struct Pair[T] {
    #|  pub a : T
    #|  pub b : T
    #|}
    #|impl[T : Eq] Eq for Pair[T] {
    #|  fn equal(self : Pair[T], other : Pair[T]) -> Bool {
    #|    self.a == other.a && self.b == other.b
    #|  }
    #|}
    #|pub fn check_pair(x : Pair[Int], y : Pair[Int]) -> Bool {
    #|  x == y
    #|}
  let cr = check_source_files_full("myroot", ["pair.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let g = qbe_new(cr.tc, false, false)
  assert_eq(qbe_norm_mono_pkg(g, ""), "")
  assert_eq(qbe_norm_mono_pkg(g, "myroot"), "")
  assert_eq(qbe_norm_mono_pkg(g, "dep_other"), "dep_other")
  let nat_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, false, "amd64_sysv")
  let wasm_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, false, "wasm32")
  assert_eq(nat_ssa.ssa, wasm_ssa.ssa)
  // When frontend already reported errors, qbe_fail_unresolved recovers with TError (no ICE).
  let bad_cr = check_source_files_full("myroot", ["bad.pion"], ["pub fn f() -> Int { missing_fn() }\n"])
  assert_true(bad_cr.diagnostics.length() > 0, "expected frontend diag")
  let bad_g = qbe_new(bad_cr.tc, false, false)
  let rec = qbe_fail_unresolved(bad_g, "unqualified_call", "", "missing_fn", span_empty())
  assert_eq(rec.reg, "0")
}

///|
fn aa3_src() -> String {
  let src =
    #|pub struct Pair {
    #|  a : String
    #|  b : String
    #|}
    #|pub struct Mixed {
    #|  n : Int
    #|  s : String
    #|  k : Int
    #|  t : Array[Int]
    #|}
    #|pub struct Flat {
    #|  x : Int
    #|  y : Double
    #|}
    #|pub enum Tree {
    #|  Leaf
    #|  Node(Tree, Tree)
    #|}
    #|pub enum NOpt {
    #|  NNone
    #|  NSome(Int, String)
    #|}
    #|pub enum Shape {
    #|  Circle(Int)
    #|  Rect(Int, Int)
    #|  Empty
    #|}
    #|pub enum Msg {
    #|  Ping(Int)
    #|  Text(String)
    #|  Quit
    #|}
    #|pub fn mk_pair(a : String, b : String) -> Pair {
    #|  Pair::{ a: a, b: b }
    #|}
    #|pub fn mk_mixed(s : String, t : Array[Int]) -> Mixed {
    #|  Mixed::{ n: 1, s: s, k: 2, t: t }
    #|}
    #|pub fn mk_flat(x : Int) -> Flat {
    #|  Flat::{ x: x, y: 1.5 }
    #|}
    #|pub fn mk_node(l : Tree, r : Tree) -> Tree {
    #|  Node(l, r)
    #|}
    #|pub fn mk_nsome(n : Int, s : String) -> NOpt {
    #|  NSome(n, s)
    #|}
    #|pub fn mk_rect(w : Int, h : Int) -> Shape {
    #|  Rect(w, h)
    #|}
    #|pub fn mk_text(s : String) -> Msg {
    #|  Text(s)
    #|}
    #|pub fn mk_ping(n : Int) -> Msg {
    #|  Ping(n)
    #|}
  src
}

///|
test "aa3_canonical_slot_drops_and_zero_rc_tagged_enums" {
  let cr = check_source_files_full("aa3", ["aa3.pion"], [aa3_src()])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // No per-type struct drop and no tagless niche-enum drop survive.
  assert_true(!ssa.contains("$pion_drop_struct_"), ssa)
  assert_true(!ssa.contains("$pion_drop_enum_Tree"), ssa)
  assert_true(!ssa.contains("$pion_drop_enum_NOpt"), ssa)
  // Pair (struct, slots {0, 1}) and Tree's Node payload (niche, slots {0, 1})
  // share one canonical helper body.
  assert_eq(p58_count_substr(ssa, "function $pion_drop_slots_3("), 1)
  let pair_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_pair(")
  assert_true(pair_fn.contains("call $pion_alloc_uninit(w 16, w 4, l $pion_drop_slots_3)"), pair_fn)
  let node_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_node(")
  assert_true(node_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_slots_3)"), node_fn)
  let d3 = j2_extract_fn(ssa, "function $pion_drop_slots_3(")
  assert_true(
    d3.contains(
      "%a0 =l add %p, 0\n    %v0 =l loadl %a0\n    %vnz0 =w cnel %v0, 0\n    jnz %vnz0, @d0, @n0\n@d0\n    call $pion_rc_dec(l %v0)\n@n0\n    %a1 =l add %p, 8\n    %v1 =l loadl %a1\n    %vnz1 =w cnel %v1, 0\n    jnz %vnz1, @d1, @n1\n@d1\n    call $pion_rc_dec(l %v1)\n@n1\n    ret",
    ),
    d3,
  )
  // Mixed: RC slots {1, 3} only (mask 0b1010), at byte offsets 8 and 24.
  let mixed_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_mixed(")
  assert_true(mixed_fn.contains("call $pion_alloc_uninit(w 32, w 4, l $pion_drop_slots_10)"), mixed_fn)
  let d10 = j2_extract_fn(ssa, "function $pion_drop_slots_10(")
  assert_true(d10.contains("%a1 =l add %p, 8\n    %v1 =l loadl %a1\n"), d10)
  assert_true(d10.contains("%a3 =l add %p, 24\n    %v3 =l loadl %a3\n"), d10)
  assert_true(!d10.contains("%p, 0\n") && !d10.contains("%p, 16\n"), d10)
  assert_eq(p58_count_substr(d10, "call $pion_rc_dec("), 2)
  // NOpt: niche payload NSome(Int, String) has its RC slot at 1 (payload_offset 0).
  let nsome_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_nsome(")
  assert_true(nsome_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_slots_2)"), nsome_fn)
  let d2 = j2_extract_fn(ssa, "function $pion_drop_slots_2(")
  assert_true(d2.contains("%a1 =l add %p, 8\n    %v1 =l loadl %a1\n"), d2)
  assert_eq(p58_count_substr(d2, "call $pion_rc_dec("), 1)
  // RC-free struct and tagged enum: null drop function, no drop body emitted.
  let flat_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_flat(")
  assert_true(flat_fn.contains("call $pion_alloc_uninit(w 16, w 4, l 0)"), flat_fn)
  let rect_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_rect(")
  assert_true(rect_fn.contains("call $pion_alloc_uninit(w 24, w 5, l 0)"), rect_fn)
  assert_true(!ssa.contains("$pion_drop_enum_Shape"), ssa)
  // Msg has one RC variant (Text): keeps its tag-dispatching per-type drop,
  // used by every variant's allocation, including the RC-free Ping.
  let text_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_text(")
  assert_true(text_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Msg)"), text_fn)
  let ping_fn = j2_extract_fn(ssa, "function l $pion_fn_mk_ping(")
  assert_true(ping_fn.contains("call $pion_alloc_uninit(w 16, w 5, l $pion_drop_enum_Msg)"), ping_fn)
  assert_eq(p58_count_substr(ssa, "function $pion_drop_enum_Msg("), 1)
  let dmsg = j2_extract_fn(ssa, "function $pion_drop_enum_Msg(")
  assert_true(dmsg.contains("%tag =l loadl %p\n    %c1 =w ceql %tag, 1\n"), dmsg)
  assert_true(dmsg.contains("%a1_0 =l add %p, 8\n"), dmsg)
  assert_true(!dmsg.contains("%c0 ") && !dmsg.contains("%c2 "), dmsg)
}

///|
test "aa3_unit_mode_canonical_drops_stay_file_local" {
  let u0 =
    #|pub struct Pair {
    #|  a : String
    #|  b : String
    #|}
    #|pub enum Shape {
    #|  Circle(Int)
    #|  Rect(Int, Int)
    #|  Empty
    #|}
    #|pub enum Msg {
    #|  Ping(Int)
    #|  Text(String)
    #|  Quit
    #|}
    #|pub fn mk_pair0(a : String) -> Pair {
    #|  Pair::{ a: a, b: a }
    #|}
  let u1 =
    #|pub fn mk_pair1(a : String, b : String) -> Pair {
    #|  Pair::{ a: a, b: b }
    #|}
    #|pub fn mk_rect1(w : Int) -> Shape {
    #|  Rect(w, w)
    #|}
    #|pub fn mk_text1(s : String) -> Msg {
    #|  Text(s)
    #|}
  let prep = match cli_prepare_qbe_units("aa3u", ["u0.pion", "u1.pion"], [u0, u1]) {
    Ok(p) => p
    Err(e) => {
      assert_true(false, e)
      return
    }
  }
  let ssa0 = emit_qbe_unit(prep, 0, true)
  let ssa1 = emit_qbe_unit(prep, 1, true)
  // Each unit defines its own non-exported slot helper; none exports one.
  assert_true(ssa0.contains("\nfunction $pion_drop_slots_3("), ssa0)
  assert_true(ssa1.contains("\nfunction $pion_drop_slots_3("), ssa1)
  assert_true(!ssa0.contains("export function $pion_drop_slots_"), ssa0)
  assert_true(!ssa1.contains("export function $pion_drop_slots_"), ssa1)
  assert_true(!ssa0.contains("$pion_drop_struct_") && !ssa1.contains("$pion_drop_struct_"), ssa1)
  assert_true(ssa1.contains("(w 16, w 4, l $pion_drop_slots_3)"), ssa1)
  // RC-free tagged enum: null drop in the consumer, no export in the producer.
  assert_true(ssa1.contains("(w 24, w 5, l 0)"), ssa1)
  assert_true(!ssa0.contains("$pion_drop_enum_Shape") && !ssa1.contains("$pion_drop_enum_Shape"), ssa0)
  // Tagged enum with an RC variant: exported once by its defining unit and
  // referenced (not redefined) by the sibling unit.
  assert_true(ssa0.contains("export function $pion_drop_enum_Msg("), ssa0)
  assert_true(ssa1.contains("(w 16, w 5, l $pion_drop_enum_Msg)"), ssa1)
  assert_true(!ssa1.contains("function $pion_drop_enum_Msg("), ssa1)
}

///|
struct Aa3Pair {
  a : String
  b : String
}

///|
enum Aa3Tree {
  Aa3Leaf
  Aa3Node(Aa3Tree, Aa3Tree)
}

///|
enum Aa3Shape {
  Aa3Circle(Int)
  Aa3Rect(Int, Int)
  Aa3Empty
}

///|
enum Aa3Msg {
  Aa3Ping(Int)
  Aa3Text(String)
  Aa3Quit
}

///|
fn aa3_mk_tree(d : Int) -> Aa3Tree {
  if d == 0 {
    Aa3Leaf
  } else {
    Aa3Node(aa3_mk_tree(d - 1), aa3_mk_tree(d - 1))
  }
}

///|
fn aa3_count(t : Aa3Tree) -> Int {
  match t {
    Aa3Leaf => 1
    Aa3Node(l, r) => aa3_count(l) + aa3_count(r)
  }
}

///|
fn aa3_area(s : Aa3Shape) -> Int {
  match s {
    Aa3Circle(r) => 3 * r * r
    Aa3Rect(w, h) => w * h
    Aa3Empty => 0
  }
}

///|
fn aa3_msg_len(m : Aa3Msg) -> Int {
  match m {
    Aa3Ping(n) => n
    Aa3Text(s) => s.length()
    Aa3Quit => -1
  }
}

///|
test "aa3_runtime_canonical_drops_release_children" {
  // Shared subtrees (two slots pointing at one object) and a deep chain are
  // released through the canonical slot helper without double free or leak
  // of a live alias.
  let shared = aa3_mk_tree(3)
  let mut i = 0
  let mut total = 0
  while i < 200 {
    let both = Aa3Node(shared, shared)
    total = total + aa3_count(both)
    let p = Aa3Pair::{ a: "x" + i.to_string(), b: "y" }
    let p2 = Aa3Pair::{ a: p.a, b: p.a }
    total = total + p2.a.length() + p2.b.length() - p.b.length()
    i = i + 1
  }
  assert_eq(aa3_count(shared), 8)
  let mut chain = Aa3Leaf
  let mut k = 0
  while k < 1000 {
    chain = Aa3Node(chain, Aa3Leaf)
    k = k + 1
  }
  assert_eq(aa3_count(chain), 1001)
  let shapes : Array[Aa3Shape] = []
  let msgs : Array[Aa3Msg] = []
  let mut j = 0
  while j < 100 {
    shapes.push(Aa3Rect(j, 2))
    shapes.push(Aa3Circle(j))
    msgs.push(Aa3Text("m" + j.to_string()))
    msgs.push(Aa3Ping(j))
    j = j + 1
  }
  let mut area = 0
  let mut si = 0
  while si < shapes.length() {
    area = area + aa3_area(shapes[si])
    si = si + 1
  }
  let mut ml = 0
  let mut mi = 0
  while mi < msgs.length() {
    ml = ml + aa3_msg_len(msgs[mi])
    mi = mi + 1
  }
  assert_eq(total, 200 * 16 + 2 * (10 * 2 + 90 * 3 + 100 * 4) - 200)
  assert_eq(area, 2 * 4950 + 3 * 328350)
  assert_eq(ml, 10 * 2 + 90 * 3 + 4950)
  assert_eq(aa3_area(Aa3Empty) + aa3_msg_len(Aa3Quit), -1)
}

///|
test "aa3_slot_drop_symbol_namespaces_stay_short" {
  let cr = check_source_files_full("aa3k", ["k.pion"], ["pub fn f() -> Int { 1 }\n"])
  let g = qbe_new(cr.tc, false, false)
  // max_slot <= 30: decimal mask (Wasm32 P47-A parses it).
  assert_eq(qbe_register_slot_drop(g, [30, 0]), "$pion_drop_slots_1073741825")
  // 31 <= max_slot <= 127: zero-padded 16-bit hex chunks, high chunk first.
  assert_eq(qbe_register_slot_drop(g, [31]), "$pion_drop_slots_x_80000000")
  let s127 = qbe_register_slot_drop(g, [127, 0])
  assert_eq(s127, "$pion_drop_slots_x_80000000000000000000000000000001")
  // max_slot > 127: table index, independent of the slot values.
  let w0 = qbe_register_slot_drop(g, [4016])
  assert_eq(w0, "$pion_drop_slots_w_3")
  assert_eq(qbe_register_slot_drop(g, [128]), "$pion_drop_slots_w_4")
  let w_big = qbe_register_slot_drop(g, [0, 4016, 100000])
  assert_eq(w_big, "$pion_drop_slots_w_5")
  assert_true(w_big.length() < 30, w_big)
  // Re-registering any order / duplicates of a known set returns its symbol.
  assert_eq(qbe_register_slot_drop(g, [4016, 4016]), w0)
  assert_eq(qbe_register_slot_drop(g, [0, 30, 30]), "$pion_drop_slots_1073741825")
  assert_eq(qbe_register_slot_drop(g, [0, 127]), s127)
  assert_eq(g.slot_drop_keys.length(), 6)
  // The emitted bodies keep the exact slot offsets.
  let out = StringBuilder()
  qbe_emit_helper_drops(g, out)
  let ssa = out.to_string()
  let wide = j2_extract_fn(ssa, "function $pion_drop_slots_w_5(")
  assert_true(
    wide.contains("%a0 =l add %p, 0\n") &&
      wide.contains("%a4016 =l add %p, 32128\n") &&
      wide.contains("%a100000 =l add %p, 800000\n"),
    wide,
  )
  assert_eq(p58_count_substr(wide, "call $pion_rc_dec("), 3)
  assert_eq(p58_count_substr(ssa, "function $pion_drop_slots_"), 6)
}

///|
test "aa3_shadowed_none_keeps_drop_fn" {
  let src =
    #|pub struct Holder {
    #|  value : String
    #|}
    #|pub struct OHolder {
    #|  value : Option[String]
    #|}
    #|pub fn keep(None : String) -> Holder {
    #|  Holder::{ value: None }
    #|}
    #|pub fn keep_opt(None : Option[String]) -> OHolder {
    #|  OHolder::{ value: None }
    #|}
    #|pub fn real_none() -> OHolder {
    #|  OHolder::{ value: None }
    #|}
    #|pub fn real_none_path() -> OHolder {
    #|  OHolder::{ value: Option::None }
    #|}
  let cr = check_source_files_full("aa3n", ["n.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let keep = j2_extract_fn(ssa, "function l $pion_fn_keep(")
  assert_true(keep.contains("call $pion_alloc_uninit(w 8, w 4, l $pion_drop_slots_1)"), keep)
  let keep_opt = j2_extract_fn(ssa, "function l $pion_fn_keep_opt(")
  assert_true(keep_opt.contains("call $pion_alloc_uninit(w 8, w 4, l $pion_drop_slots_1)"), keep_opt)
  let real = j2_extract_fn(ssa, "function l $pion_fn_real_none(")
  assert_true(real.contains("call $pion_alloc_uninit(w 8, w 4, l 0)"), real)
  let real_p = j2_extract_fn(ssa, "function l $pion_fn_real_none_path(")
  assert_true(real_p.contains("call $pion_alloc_uninit(w 8, w 4, l 0)"), real_p)
}

///|
test "aa3_unit_into_dyn_field_keeps_drop_fn" {
  // `()` stored into a `dyn Mark` field is boxed (`$pion_drop_dyn`), so the
  // holder is not a static-null literal and must drop that box.
  let src =
    #|pub trait Mark {
    #|  mark(self : Self) -> Int
    #|}
    #|impl Mark for Unit {
    #|  fn mark(self : Unit) -> Int { 7 }
    #|}
    #|pub struct DynHolder {
    #|  value : dyn Mark
    #|}
    #|pub fn mk_dyn_unit() -> DynHolder {
    #|  DynHolder::{ value: () }
    #|}
  let cr = check_source_files_full("aa3u", ["u.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let f = j2_extract_fn(ssa, "function l $pion_fn_mk_dyn_unit(")
  assert_true(f.contains("call $pion_alloc_uninit(w 16, w 4, l $pion_drop_dyn)"), f)
  assert_true(f.contains("call $pion_alloc_uninit(w 8, w 4, l $pion_drop_slots_1)"), f)
  assert_true(!f.contains("(w 8, w 4, l 0)"), f)
}

///|
fn test_aa1_read_uleb(bin : Bytes, pos : Int) -> (Int, Int) {
  let mut acc = 0
  let mut shift = 0
  let mut i = pos
  while i < bin.length() {
    let b = bin[i].to_int()
    i = i + 1
    acc = acc | ((b & 0x7F) << shift)
    if (b & 0x80) == 0 {
      return (acc, i)
    }
    shift = shift + 7
  }
  (acc, i)
}

///|
fn test_aa1_extract_code_bodies(bin : Bytes) -> Array[Array[Int]] {
  let bodies : Array[Array[Int]] = []
  let mut pos = 8
  while pos < bin.length() {
    let sec_id = bin[pos].to_int()
    pos = pos + 1
    let (sec_len, sec_start) = test_aa1_read_uleb(bin, pos)
    let sec_end = sec_start + sec_len
    if sec_id == 10 {
      let (nfuncs, fpos0) = test_aa1_read_uleb(bin, sec_start)
      let mut fpos = fpos0
      let mut fi = 0
      while fi < nfuncs && fpos < sec_end {
        let (blen, bstart) = test_aa1_read_uleb(bin, fpos)
        let body : Array[Int] = []
        let mut bi = 0
        while bi < blen && bstart + bi < sec_end {
          body.push(bin[bstart + bi].to_int())
          bi = bi + 1
        }
        bodies.push(body)
        fpos = bstart + blen
        fi = fi + 1
      }
      return bodies
    }
    pos = sec_end
  }
  bodies
}

///|
fn test_aa1_bytes_contains(hay : Array[Int], needle : Array[Int]) -> Bool {
  if needle.length() == 0 {
    return true
  }
  if needle.length() > hay.length() {
    return false
  }
  let mut i = 0
  while i <= hay.length() - needle.length() {
    let mut ok = true
    let mut j = 0
    while j < needle.length() {
      if hay[i + j] != needle[j] {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn test_aa1_extract_import_names(bin : Bytes) -> Array[String] {
  let names : Array[String] = []
  let mut pos = 8
  while pos < bin.length() {
    let sec_id = bin[pos].to_int()
    pos = pos + 1
    let (sec_len, sec_start) = test_aa1_read_uleb(bin, pos)
    let sec_end = sec_start + sec_len
    if sec_id == 2 {
      let (nimp, ipos0) = test_aa1_read_uleb(bin, sec_start)
      let mut ipos = ipos0
      let mut ii = 0
      while ii < nimp && ipos < sec_end {
        let (mlen, mstart) = test_aa1_read_uleb(bin, ipos)
        let fpos = mstart + mlen
        let (flen, fstart) = test_aa1_read_uleb(bin, fpos)
        let sb = StringBuilder::new()
        let mut fi = 0
        while fi < flen && fstart + fi < sec_end {
          sb.write_char(bin[fstart + fi].to_int().unsafe_to_char())
          fi = fi + 1
        }
        names.push(sb.to_string())
        let kpos = fstart + flen
        let kind = bin[kpos].to_int()
        let dpos = kpos + 1
        if kind == 0 {
          let (_, nxt) = test_aa1_read_uleb(bin, dpos)
          ipos = nxt
        } else if kind == 1 {
          let flags = bin[dpos + 1].to_int()
          let (_, n1) = test_aa1_read_uleb(bin, dpos + 2)
          if (flags & 1) != 0 {
            let (_, n2) = test_aa1_read_uleb(bin, n1)
            ipos = n2
          } else {
            ipos = n1
          }
        } else if kind == 2 {
          let flags = bin[dpos].to_int()
          let (_, n1) = test_aa1_read_uleb(bin, dpos + 1)
          if (flags & 1) != 0 {
            let (_, n2) = test_aa1_read_uleb(bin, n1)
            ipos = n2
          } else {
            ipos = n1
          }
        } else {
          ipos = dpos + 2
        }
        ii = ii + 1
      }
      return names
    }
    pos = sec_end
  }
  names
}

///|
fn test_aa1_read_uleb_arr(arr : Array[Int], pos : Int) -> (Int, Int) {
  let mut acc = 0
  let mut shift = 0
  let mut i = pos
  while i < arr.length() {
    let b = arr[i]
    i = i + 1
    acc = acc | ((b & 0x7F) << shift)
    if (b & 0x80) == 0 {
      return (acc, i)
    }
    shift = shift + 7
  }
  (acc, i)
}

///|
fn test_aa1_body_local_summary(body : Array[Int]) -> (Int, Int) {
  let (ndecls, pos0) = test_aa1_read_uleb_arr(body, 0)
  let mut pos = pos0
  let mut total_locals = 0
  let mut di = 0
  while di < ndecls && pos < body.length() {
    let (cnt, next_pos) = test_aa1_read_uleb_arr(body, pos)
    total_locals = total_locals + cnt
    pos = next_pos + 1 // skip valtype byte
    di = di + 1
  }
  (total_locals, pos)
}

///|
fn test_aa1_has_tee_then_get_same_local(body : Array[Int]) -> Bool {
  let (_, code_start) = test_aa1_body_local_summary(body)
  let mut i = code_start
  while i + 1 < body.length() {
    if body[i] == 0x22 && body[i + 1] < 128 {
      let lidx = body[i + 1]
      let mut j = i + 2
      while j + 1 < body.length() {
        if body[j] == 0x20 && body[j + 1] == lidx {
          return true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  false
}

///|
fn test_aa1_max_1byte_nonparam_local_get_count(body : Array[Int], n_params : Int) -> Int {
  let (_, code_start) = test_aa1_body_local_summary(body)
  let counts : Array[Int] = []
  let mut ci = 0
  while ci < 128 {
    counts.push(0)
    ci = ci + 1
  }
  let mut i = code_start
  while i + 1 < body.length() {
    if body[i] == 0x20 && body[i + 1] >= n_params && body[i + 1] < 128 {
      let idx = body[i + 1]
      counts[idx] = counts[idx] + 1
    }
    i = i + 1
  }
  let mut best = 0
  ci = n_params
  while ci < 128 {
    if counts[ci] > best {
      best = counts[ci]
    }
    ci = ci + 1
  }
  best
}

///|
test "wave_aa1_wasm_opt_unit_checks" {
  // 0. Review-fix 1: 64-bit phi_edge_key must not wrap when pred_idx * nb >= 2^32
  assert_true(
    wasm_phi_edge_key(0, 7, 131072) != wasm_phi_edge_key(32768, 7, 131072),
    "64-bit phi edge key must not wrap at 2^32",
  )
  assert_eq(wasm_phi_edge_key(32768, 7, 131072), 32768L * 131072L + 7L)

  // 1. AA1-S1: fast path zero-copy when no collisions, exact fallback rename on collision,
  //    and single-unit (nu == 1) local+export collision disambiguation
  let u1 = "function w $helper_a(w %x) {\n@start\n  ret %x\n}\nexport function w $main() {\n@start\n  %r =w call $helper_a(w 42)\n  ret %r\n}\n"
  let u2 = "function w $helper_b(w %x) {\n@start\n  ret %x\n}\nexport function w $other() {\n@start\n  %r =w call $helper_b(w 7)\n  ret %r\n}\n"
  let fast_res = wasm_disambiguate_unit_locals([u1, u2])
  assert_eq(fast_res.length(), 2)
  assert_eq(fast_res[0], u1)
  assert_eq(fast_res[1], u2)
  // Cross-unit host import collision: u_host references $helper_a without defining it
  let u_host = "export function w $use_host() {\n@start\n  %r =w call $helper_a(w 1)\n  ret %r\n}\n"
  let col_res1 = wasm_disambiguate_unit_locals([u1, u_host])
  assert_true(col_res1[0].contains("function w $helper_a__u0_1("), "expected exact rename helper_a__u0_1 def")
  assert_true(col_res1[0].contains("call $helper_a__u0_1("), "expected exact rename helper_a__u0_1 call")
  assert_eq(col_res1[1], u_host)
  let col_res2 = wasm_disambiguate_unit_locals([u_host, u1])
  assert_eq(col_res2[0], u_host)
  assert_true(col_res2[1].contains("function w $helper_a__u1_1("), "expected exact rename helper_a__u1_1 def")
  assert_true(col_res2[1].contains("call $helper_a__u1_1("), "expected exact rename helper_a__u1_1 call")
  // Single-unit (nu == 1) local + export collision triggers exact fallback rename
  let u_single_col = "export data $dup = { w 1 }\nfunction w $dup(w %x) {\n@start\n  ret %x\n}\n"
  let single_res = wasm_disambiguate_unit_locals([u_single_col])
  assert_eq(single_res.length(), 1)
  assert_true(
    single_res[0].contains("export data $dup__u0_1 = { w 1 }"),
    "single-unit fallback must match full disambiguation rename for data $dup",
  )
  assert_true(
    single_res[0].contains("function w $dup__u0_1(w %x)"),
    "single-unit fallback must match full disambiguation rename for function $dup",
  )

  // 1b. Outlined helper must not hijack an external host import named $__pion_ol_1
  let ssa_ol_host =
    #|function l $__pion_ol_0(l %a) {
    #|@start
    #|  ret %a
    #|}
    #|export function l $use_ol_host(l %n) {
    #|@start
    #|  %po =l alloc8 8
    #|  %pi =l alloc8 8
    #|  %pacc =l alloc8 8
    #|  storel 0, %po
    #|  storel 0, %pacc
    #|  %h0 =l call $__pion_ol_1(l %n)
    #|  storel %h0, %pacc
    #|  jmp @outer_hdr
    #|@outer_hdr
    #|  %ov =l loadl %po
    #|  %oc =w csltl %ov, %n
    #|  jnz %oc, @outer_body, @done
    #|@outer_body
    #|  storel 0, %pi
    #|  jmp @inner_hdr
    #|@inner_hdr
    #|  %iv =l loadl %pi
    #|  %ic =w csltl %iv, %n
    #|  jnz %ic, @inner_body, @outer_latch
    #|@inner_body
    #|  %a0 =l loadl %pacc
    #|  %a1 =l add %a0, %iv
    #|  storel %a1, %pacc
    #|  %in =l add %iv, 1
    #|  storel %in, %pi
    #|  jmp @inner_hdr
    #|@outer_latch
    #|  %on =l add %ov, 1
    #|  storel %on, %po
    #|  jmp @outer_hdr
    #|@done
    #|  %res =l loadl %pacc
    #|  ret %res
    #|}
  let ol_funcs = wasm_outline_nested_loops_cached(wasm_parse_ssa(ssa_ol_host).funcs, Map([]))
  let mut saw_ol_2 = false
  let mut saw_ol_1_def = false
  let mut ofi = 0
  while ofi < ol_funcs.length() {
    if ol_funcs[ofi].name == "__pion_ol_2" { saw_ol_2 = true }
    if ol_funcs[ofi].name == "__pion_ol_1" { saw_ol_1_def = true }
    ofi = ofi + 1
  }
  assert_true(saw_ol_2, "expected outlined helper to skip __pion_ol_0 and host import __pion_ol_1")
  assert_true(!saw_ol_1_def, "outlined helper must not define __pion_ol_1")
  let bin_ol_host = emit_wasm_from_ssa(ssa_ol_host)
  let ol_imports = test_aa1_extract_import_names(bin_ol_host)
  let mut has_ol_1_import = false
  let mut imi = 0
  while imi < ol_imports.length() {
    if ol_imports[imi] == "__pion_ol_1" { has_ol_1_import = true }
    imi = imi + 1
  }
  assert_true(has_ol_1_import, "$__pion_ol_1 must remain a Wasm host import after outlining")

  // 2. AA1-S2: slot_drop_mask rejects duplicate or out-of-order slot drops, accepts strictly increasing
  let ssa_dup_drop =
    #|function $pion_drop_struct_dup(l %p) {
    #|@start
    #|  %v0 =l loadl %p
    #|  call $pion_rc_dec(l %v0)
    #|  %v1 =l loadl %p
    #|  call $pion_rc_dec(l %v1)
    #|  ret
    #|}
  let p_dup = wasm_parse_ssa(ssa_dup_drop)
  assert_eq(wasm_try_extract_slot_drop_mask(p_dup.funcs[0]), 0L)
  let ssa_rev_drop =
    #|function $pion_drop_struct_rev(l %p) {
    #|@start
    #|  %a1 =l add %p, 8
    #|  %v1 =l loadl %a1
    #|  call $pion_rc_dec(l %v1)
    #|  %v0 =l loadl %p
    #|  call $pion_rc_dec(l %v0)
    #|  ret
    #|}
  let p_rev = wasm_parse_ssa(ssa_rev_drop)
  assert_eq(wasm_try_extract_slot_drop_mask(p_rev.funcs[0]), 0L)
  let ssa_ok_drop =
    #|function $pion_drop_struct_ok(l %p) {
    #|@start
    #|  %v0 =l loadl %p
    #|  call $pion_rc_dec(l %v0)
    #|  %a1 =l add %p, 8
    #|  %v1 =l loadl %a1
    #|  call $pion_rc_dec(l %v1)
    #|  ret
    #|}
  let p_ok = wasm_parse_ssa(ssa_ok_drop)
  assert_eq(wasm_try_extract_slot_drop_mask(p_ok.funcs[0]), 2147483648L | 3L)

  // 3. AA1-S2: fine-grained stage labels
  let stages : Array[String] = []
  let _ = emit_wasm_from_ssa_units_traced([u1], fn(lbl) { stages.push(lbl) })
  let mut saw_dis = false
  let mut saw_ol = false
  let mut saw_sm = false
  let mut saw_cf = false
  let mut saw_bi = false
  let mut si = 0
  while si < stages.length() {
    let st = stages[si]
    if st.starts_with("disambiguate") { saw_dis = true }
    if st.starts_with("wasm_outline") { saw_ol = true }
    if st.starts_with("wasm_slot_masks") { saw_sm = true }
    if st.starts_with("wasm_compile_func") { saw_cf = true }
    if st.starts_with("wasm_builtins") { saw_bi = true }
    si = si + 1
  }
  assert_true(saw_dis && saw_ol && saw_sm && saw_cf && saw_bi, "missing fine-grained wasm stage labels")

  // 4. AA1-Z2: byte-level Code-section assertions
  let bin_neg1 = emit_wasm_from_ssa("export function l $ext_neg1() {\n@start\n  %a =l extuw -1\n  ret %a\n}\n")
  let bodies_neg1 = test_aa1_extract_code_bodies(bin_neg1)
  assert_true(bodies_neg1.length() >= 1, "expected code body for ext_neg1")
  assert_true(
    test_aa1_bytes_contains(bodies_neg1[0], [0x41, 0x7F, 0xAD]),
    "extuw -1 must retain i32.const -1; i64.extend_i32_u",
  )

  let bin_ext42 = emit_wasm_from_ssa("export function l $ext_42() {\n@start\n  %a =l extsw 42\n  ret %a\n}\n")
  let bodies_ext42 = test_aa1_extract_code_bodies(bin_ext42)
  assert_true(bodies_ext42.length() >= 1, "expected code body for ext_42")
  assert_true(
    test_aa1_bytes_contains(bodies_ext42[0], [0x42, 0x2A]),
    "extsw 42 must fold to i64.const 42",
  )
  assert_true(
    !test_aa1_bytes_contains(bodies_ext42[0], [0xAC]),
    "extsw 42 must not emit i64.extend_i32_s",
  )

  let bin_eqz = emit_wasm_from_ssa("export function w $cmp_zero(l %x) {\n@start\n  %c =w ceql %x, 0\n  ret %c\n}\n")
  let bodies_eqz = test_aa1_extract_code_bodies(bin_eqz)
  assert_true(bodies_eqz.length() >= 1, "expected code body for cmp_zero")
  assert_true(
    test_aa1_bytes_contains(bodies_eqz[0], [0x20, 0x00, 0x50]),
    "ceql %x, 0 must emit local.get 0; i64.eqz ([0x20, 0x00, 0x50])",
  )
  assert_true(
    !test_aa1_bytes_contains(bodies_eqz[0], [0x42, 0x00, 0x51]),
    "ceql %x, 0 must not emit i64.const 0; i64.eq",
  )

  let ssa_tee =
    #|export function l $tee_promoted(l %x) {
    #|@start
    #|  %p =l alloc8 8
    #|  storel %x, %p
    #|  %v1 =l loadl %p
    #|  %v2 =l loadl %p
    #|  %s =l add %v1, %v2
    #|  ret %s
    #|}
  let bin_tee = emit_wasm_from_ssa(ssa_tee)
  let bodies_tee = test_aa1_extract_code_bodies(bin_tee)
  assert_true(bodies_tee.length() >= 1, "expected code body for tee_promoted")
  assert_true(
    test_aa1_has_tee_then_get_same_local(bodies_tee[0]),
    "promoted alloc store+load+load must emit local.tee L; local.get L preserving write",
  )

  // 5. AA1-Z1 + Z3: finite terminating irreducible CFG (br_table) with forwarded exprs & colored temps
  let ssa_z1_z3 =
    #|export function l $irred_fin(w %sel, l %n, l %a) {
    #|@start
    #|  %t1 =l add %a, 1
    #|  %t2 =l mul %t1, 3
    #|  jnz %sel, @l1, @l2
    #|@l1
    #|  %c1 =l phi @start %n, @l2_body %n2
    #|  %acc1 =l phi @start %t2, @l2_body %y1
    #|  %done1 =w cslel %c1, 0
    #|  jnz %done1, @done, @l1_body
    #|@l1_body
    #|  %x1 =l add %acc1, 10
    #|  %x2 =l xor %x1, 5
    #|  %n1 =l sub %c1, 1
    #|  jmp @l2
    #|@l2
    #|  %c2 =l phi @start %n, @l1_body %n1
    #|  %acc2 =l phi @start %t2, @l1_body %x2
    #|  %done2 =w cslel %c2, 0
    #|  jnz %done2, @done, @l2_body
    #|@l2_body
    #|  %y1 =l add %acc2, 20
    #|  %n2 =l sub %c2, 1
    #|  jmp @l1
    #|@done
    #|  %res =l phi @l1 %acc1, @l2 %acc2
    #|  ret %res
    #|}
  let bin_z1_z3 = emit_wasm_from_ssa(ssa_z1_z3)
  let bodies_z1_z3 = test_aa1_extract_code_bodies(bin_z1_z3)
  assert_true(bodies_z1_z3.length() >= 1, "valid wasm binary for finite irreducible Z1+Z3")

  // 6. AA1-Z3: >128 truly live materialized locals + hot local reordered into 1-byte LEB (< 128)
  let sb_big = StringBuilder::new()
  sb_big.write_string("export function l $many_locals(l %x) {\n@start\n")
  let mut li = 0
  while li < 135 {
    sb_big.write_string("  %v")
    sb_big.write_string(li.to_string())
    sb_big.write_string(" =l add %x, ")
    sb_big.write_string((li + 1).to_string())
    sb_big.write_string("\n")
    li = li + 1
  }
  // Define %hot AFTER all 135 live %v0..%v134 locals so source-order allocation places it at
  // index 136 (>= 128, 2-byte LEB128); only frequency reordering moves it below 128.
  sb_big.write_string("  %hot =l add %x, 7\n")
  sb_big.write_string("  %a0 =l add %v0, %hot\n")
  li = 1
  while li < 135 {
    sb_big.write_string("  %t")
    sb_big.write_string(li.to_string())
    sb_big.write_string(" =l add %a")
    sb_big.write_string((li - 1).to_string())
    sb_big.write_string(", %v")
    sb_big.write_string(li.to_string())
    sb_big.write_string("\n  %a")
    sb_big.write_string(li.to_string())
    sb_big.write_string(" =l add %t")
    sb_big.write_string(li.to_string())
    sb_big.write_string(", %hot\n")
    li = li + 1
  }
  // Second pass over %v0..%v134 forces all 135 %v_i to have use_count == 2 and remain
  // simultaneously live across the whole function (neither Z1-forwarded nor interval-colored).
  sb_big.write_string("  %b0 =l add %a134, %v0\n")
  li = 1
  while li < 135 {
    sb_big.write_string("  %b")
    sb_big.write_string(li.to_string())
    sb_big.write_string(" =l add %b")
    sb_big.write_string((li - 1).to_string())
    sb_big.write_string(", %v")
    sb_big.write_string(li.to_string())
    sb_big.write_string("\n")
    li = li + 1
  }
  sb_big.write_string("  ret %b134\n}\n")
  let bin_big = emit_wasm_from_ssa(sb_big.to_string())
  let bodies_big = test_aa1_extract_code_bodies(bin_big)
  assert_true(bodies_big.length() >= 1, "valid wasm binary for >128-local reorder")
  let (big_total_locals, _) = test_aa1_body_local_summary(bodies_big[0])
  assert_true(
    big_total_locals > 128,
    "many_locals must actually declare >128 locals (got " + big_total_locals.to_string() + ")",
  )
  let hot_1b_gets = test_aa1_max_1byte_nonparam_local_get_count(bodies_big[0], 1)
  assert_true(
    hot_1b_gets >= 135,
    "hot local must be reordered into 1-byte LEB slot < 128 (max 1-byte local.get count=" + hot_1b_gets.to_string() + ")",
  )
}

///|
/// Pre-index reference: per-call linear scan over one type checker's methods and
/// impls (what `qbe_any_method_has_ret_default` did before `qbe_ret_default_methods`).
fn rdm_ref_tc_has(tc : TypeChecker, mname : String) -> Bool {
  let mut i = 0
  while i < tc.method_names.length() {
    let mk = tc.method_names[i]
    if qbe_method_key_matches(mk, mname) {
      match tc.methods.get(mk) {
        Some(mi) => if qbe_params_have_ret_default(mi.decl.params) { return true }
        None => ()
      }
    }
    i = i + 1
  }
  i = 0
  while i < tc.impl_keys.length() {
    match tc.impls.get(tc.impl_keys[i]) {
      Some(ii) =>
        match ii.methods.get(mname) {
          Some(mi) => if qbe_params_have_ret_default(mi.decl.params) { return true }
          None => ()
        }
      None => ()
    }
    i = i + 1
  }
  false
}

///|
fn rdm_ref_any(g : QbeGen, mname : String) -> Bool {
  if rdm_ref_tc_has(g.tc, mname) {
    return true
  }
  let mut pi = 0
  while pi < g.tc.all_imported_pkg_names.length() {
    match g.tc.all_imported_pkgs.get(g.tc.all_imported_pkg_names[pi]) {
      Some(ipkg) => if rdm_ref_tc_has(ipkg.tc, mname) { return true }
      None => ()
    }
    pi = pi + 1
  }
  false
}

///|
fn rdm_add_probes(tc : TypeChecker, out : Array[String]) -> Unit {
  let mut i = 0
  while i < tc.method_names.length() {
    let mk = tc.method_names[i]
    out.push(mk)
    let mut p = 0
    while p <= mk.length() {
      out.push(slice_str(mk, p, mk.length()))
      p = p + 1
    }
    i = i + 1
  }
  i = 0
  while i < tc.impl_keys.length() {
    match tc.impls.get(tc.impl_keys[i]) {
      Some(ii) => {
        let ks = ii.methods.keys()
        let mut j = 0
        while j < ks.length() {
          out.push(ks[j])
          out.push("::" + ks[j])
          j = j + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
}

///|
fn rdm_call_args(tc : TypeChecker, fname : String) -> Array[Array[Expr]] {
  let out : Array[Array[Expr]] = []
  match tc.fns.get(fname) {
    Some(fi) => {
      let mut i = 0
      while i < fi.decl.body.length() {
        match fi.decl.body[i] {
          SLet(_, _, _, ECall(_, args, _), _) => out.push(args)
          _ => ()
        }
        i = i + 1
      }
    }
    None => ()
  }
  out
}

///|
test "rdm: indexed qbe_any_method_has_ret_default and guard shortcuts match the per-call scan" {
  let dep_cr = check_source_files_with_imports(
    "dep",
    ["dep.pion"],
    [
      "pub struct D { pub v : Int }\n" +
      "pub fn D::early(self : D, go : Bool, y~ : Int = if go { dep_calc() } else { 2 }) -> Int { self.v + y }\n" +
      "pub fn D::plain(self : D, y~ : Int = 3) -> Int { self.v + y }\n" +
      "pub fn dep_calc() -> Int { 5 }\n" +
      "pub trait Tr {\n  fn tm(self : Self) -> Int\n  fn tq(self : Self) -> Int\n}\n" +
      "impl Tr for D {\n  fn tm(self : D) -> Int { self.v }\n  fn tq(self : D) -> Int { self.v + 1 }\n}\n",
    ],
    [],
    true,
  )
  assert_true(dep_cr.diagnostics.length() == 0, check_result_to_json(dep_cr.diagnostics))
  let dep = imported_pkg_new("dep", dep_cr.tc)
  let src = "import \"dep\"\n" +
    "struct L { v : Int }\n" +
    "fn helper() -> Int { 4 }\n" +
    "fn L::lret(self : L, y~ : Int = helper()) -> Int { self.v + y }\n" +
    "fn L::lplain(self : L) -> Int { self.v }\n" +
    "fn L::lnone(self : L, y~ : Int = 9) -> Int { self.v + y }\n" +
    "trait Ar {\n  fn am(self : Self, k : Int) -> Int\n}\n" +
    "impl Ar for L {\n  fn am(self : L, k : Int) -> Int { self.v + k }\n}\n" +
    "fn sink(a : Int, b : Int, c : Int, d : Int) -> Int { a + b + c + d }\n" +
    "fn probe(o : dep::D, l : L, r : Result[Int, String]) -> Result[Int, String] {\n" +
    "  let a = sink(l.lplain(), o.plain(), 1 + 2, l.lnone())\n" +
    "  let b = sink(l.lplain(), o.early(true), 3, 4)\n" +
    "  let c = sink(r?, 1, 2, l.lplain())\n" +
    "  let d = sink(1, 2, 3, l.lret())\n" +
    "  let e = sink(l.lret(), 2, 3, 4)\n" +
    "  let f = sink(1, l.am(2), 3, o.tm())\n" +
    "  Ok(a + b + c + d + e + f)\n" +
    "}\n"
  let cr = check_source_files_with_imports("app", ["app.pion"], [src], [dep], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let g = qbe_new_for_target_name(cr.tc, false, false, false, "")
  let probes : Array[String] = ["", "::", "early", "plain", "lret", "lplain", "lnone", "tm", "tq", "am", "nope", "D::early", "L::lret"]
  rdm_add_probes(cr.tc, probes)
  rdm_add_probes(dep_cr.tc, probes)
  let mut n_true = 0
  let mut i = 0
  while i < probes.length() {
    let want = rdm_ref_any(g, probes[i])
    assert_eq(qbe_any_method_has_ret_default(g, probes[i]), want)
    if want {
      n_true = n_true + 1
    }
    i = i + 1
  }
  // Defaults that call (same package and cross package) are both seen.
  assert_true(qbe_any_method_has_ret_default(g, "lret"), "lret")
  assert_true(qbe_any_method_has_ret_default(g, "early"), "early")
  assert_true(!qbe_any_method_has_ret_default(g, "plain"), "plain")
  assert_true(!qbe_any_method_has_ret_default(g, "lnone"), "lnone")
  assert_true(!qbe_any_method_has_ret_default(g, "tm"), "tm")
  assert_true(n_true > 0, "n_true")

  let calls = rdm_call_args(cr.tc, "probe")
  assert_eq(calls.length(), 6)
  let want_exit = [false, true, true, true, true, false]
  let mut ci = 0
  while ci < calls.length() {
    let args = calls[ci]
    assert_eq(qbe_guards_any_exit(g, args), want_exit[ci])
    let gs = qbe_arg_guards_in_order(g, args)
    assert_eq(qbe_guards_exit_before_all(g, gs, args), qbe_guards_any_exit(g, args))
    let orders : Array[Array[Int]] = [[0, 1, 2, 3], [3, 2, 1, 0], [1, 3, 0, 2], [0, 0, 1, 2], [0, 1, 2]]
    let mut oi = 0
    while oi < orders.length() {
      let ord = orders[oi]
      let ogs = if ord.length() == args.length() { qbe_arg_guards(g, args, ord) } else { gs }
      assert_eq(qbe_guards_exit_before_order(g, ogs, args, ord), qbe_guards_any_exit(g, args))
      oi = oi + 1
    }
    ci = ci + 1
  }
}

///|
fn wave2_prd_extract_block(fn_ssa : String, start_lbl : String, end_lbl : String) -> String {
  let lines = fn_ssa.split("\n")
  let sb = StringBuilder::new()
  let mut inside = false
  let mut i = 0
  while i < lines.length() {
    let ln = lines[i]
    if ln.starts_with(start_lbl) {
      inside = true
    } else if inside && ln.starts_with(end_lbl) {
      break
    }
    if inside {
      sb.write_string(ln)
      sb.write_string("\n")
    }
    i = i + 1
  }
  sb.to_string()
}

///|
test "wave2_prd_bce_multistep_affine_lut_and_tobyte_storeb" {
  let src =
    #|pub fn rgba_step4(src : Bytes, dst : Bytes, n : Int) -> Unit {
    #|  let mut i = 0
    #|  while i + 3 < n {
    #|    dst[i] = (src[i].to_int() + 1).to_byte()
    #|    dst[i + 1] = ((src[i + 1].to_int() * 3) & 255).to_byte()
    #|    dst[i + 2] = (src[i + 2].to_int() ^ 0x55).to_byte()
    #|    dst[i + 3] = src[i + 3]
    #|    i = i + 4
    #|  }
    #|}
    #|
    #|pub fn rgb_step3_le(src : FixedArray[Byte], dst : FixedArray[Byte], n : Int) -> Unit {
    #|  let mut i = 0
    #|  while i <= n - 3 {
    #|    dst[i] = src[i]
    #|    dst[i + 1] = src[i + 1]
    #|    dst[i + 2] = (src[i + 2].to_int() + 7).to_byte()
    #|    i = i + 3
    #|  }
    #|}
    #|
    #|pub fn step8_hoisted_len(src : Bytes, dst : Bytes) -> Unit {
    #|  let mut i = 0
    #|  while i + 7 < src.length() {
    #|    dst[i] = src[i]
    #|    dst[i + 7] = src[i + 7]
    #|    i = i + 8
    #|  }
    #|}
    #|
    #|pub fn hex_shift_affine(src : Bytes, out : Bytes, hex : Bytes, n : Int) -> Unit {
    #|  if hex.length() < 16 { return }
    #|  let mut i = 0
    #|  while i < n {
    #|    let b = src[i].to_int()
    #|    out[i << 1] = hex[b >> 4]
    #|    out[(i << 1) + 1] = hex[b & 15]
    #|    i = i + 1
    #|  }
    #|}
    #|
    #|pub fn rgb_mul_affine(src : FixedArray[Byte], out : FixedArray[Byte], lut : FixedArray[Byte], n : Int) -> Unit {
    #|  if lut.length() < 256 { return }
    #|  let mut i = 0
    #|  while i < n {
    #|    out[i * 3] = lut[src[i * 3].to_int()]
    #|    out[i * 3 + 1] = lut[src[i * 3 + 1].to_int()]
    #|    out[i * 3 + 2] = lut[src[i * 3 + 2].to_int()]
    #|    i = i + 1
    #|  }
    #|}
    #|
    #|pub fn lut_if_else_branch(lut : FixedArray[Int], x : Int, b : Byte) -> Int {
    #|  if lut.length() < 256 {
    #|    0
    #|  } else {
    #|    lut[x & 63] + lut[(x >> 4) & 15] + lut[b.to_int()] + lut[b.to_int() >> 4]
    #|  }
    #|}
    #|
    #|pub fn lut_pos_branch(lut : Array[Int], x : Int) -> Int {
    #|  if lut.length() >= 256 {
    #|    lut[x & 255]
    #|  } else {
    #|    0
    #|  }
    #|}
    #|
    #|pub fn tobyte_storeb_arr(out : Array[Byte], x : Int) -> Unit {
    #|  if out.length() < 4 { return }
    #|  out[0] = (x + 1).to_byte()
    #|  out[1] = ((x * 5 + 2) & 255).to_byte()
    #|}
    #|
    #|pub fn neg_lut_after_pop(lut : Array[Int], x : Int) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  let _ = lut.pop()
    #|  lut[x & 255]
    #|}
    #|
    #|pub fn neg_lut_after_rebind(lut0 : FixedArray[Int], small : FixedArray[Int], x : Int) -> Int {
    #|  let mut lut = lut0
    #|  if lut.length() < 256 { return 0 }
    #|  lut = small
    #|  lut[x & 255]
    #|}
    #|
    #|pub fn neg_lut_mask_oob(lut : FixedArray[Int], x : Int) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  lut[x & 256]
    #|}
    #|
    #|pub fn neg_signed_shr_unbounded(lut : FixedArray[Int], x : Int) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  lut[x >> 4]
    #|}
  let cr = check_source_files_with_imports("w2prd", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut fn_rgba = ""
  let mut fn_rgb3 = ""
  let mut fn_step8 = ""
  let mut fn_hex = ""
  let mut fn_mul = ""
  let mut fn_ifelse = ""
  let mut fn_pos = ""
  let mut fn_tobyte = ""
  let mut fn_neg_pop = ""
  let mut fn_neg_rebind = ""
  let mut fn_neg_mask = ""
  let mut fn_neg_shr = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("_fn_rgba_step4(") {
      fn_rgba = f
    } else if f.contains("_fn_rgb_step3_le(") {
      fn_rgb3 = f
    } else if f.contains("_fn_step8_hoisted_len(") {
      fn_step8 = f
    } else if f.contains("_fn_hex_shift_affine(") {
      fn_hex = f
    } else if f.contains("_fn_rgb_mul_affine(") {
      fn_mul = f
    } else if f.contains("_fn_lut_if_else_branch(") {
      fn_ifelse = f
    } else if f.contains("_fn_lut_pos_branch(") {
      fn_pos = f
    } else if f.contains("_fn_tobyte_storeb_arr(") {
      fn_tobyte = f
    } else if f.contains("_fn_neg_lut_after_pop(") {
      fn_neg_pop = f
    } else if f.contains("_fn_neg_lut_after_rebind(") {
      fn_neg_rebind = f
    } else if f.contains("_fn_neg_lut_mask_oob(") {
      fn_neg_mask = f
    } else if f.contains("_fn_neg_signed_shr_unbounded(") {
      fn_neg_shr = f
    }
    fi = fi + 1
  }
  // 1. Multi-step loops: fast loop has 0 OOB panics, slow loop preserves OOB panic; 0 `and ..., 255`
  assert_true(fn_rgba.contains("@wh_fast"), fn_rgba)
  let rgba_fast = wave2_prd_extract_block(fn_rgba, "@wh_fast", "@wh_slow")
  assert_true(!rgba_fast.contains("$pion_panic_oob"), rgba_fast)
  assert_true(!rgba_fast.contains(", 255"), rgba_fast)
  assert_true(fn_rgba.contains("@wh_slow"), fn_rgba)
  let rgba_slow = wave2_prd_extract_block(fn_rgba, "@wh_slow", "@wh_e")
  assert_true(rgba_slow.contains("$pion_panic_oob"), rgba_slow)

  assert_true(fn_rgb3.contains("@wh_fast"), fn_rgb3)
  let rgb3_fast = wave2_prd_extract_block(fn_rgb3, "@wh_fast", "@wh_slow")
  assert_true(!rgb3_fast.contains("$pion_panic_oob"), rgb3_fast)
  assert_true(!rgb3_fast.contains(", 255"), rgb3_fast)

  assert_true(fn_step8.contains("@wh_fast"), fn_step8)
  let step8_fast = wave2_prd_extract_block(fn_step8, "@wh_fast", "@wh_slow")
  assert_true(!step8_fast.contains("$pion_panic_oob"), step8_fast)

  // 2. Derived shift / mul affine indices + LUT guards: fast loop has 0 OOB panics, pre-loop has overflow check
  assert_true(fn_hex.contains("@wh_fast"), fn_hex)
  let hex_fast = wave2_prd_extract_block(fn_hex, "@wh_fast", "@wh_slow")
  assert_true(!hex_fast.contains("$pion_panic_oob"), hex_fast)
  assert_true(fn_hex.contains("2147483647"), fn_hex)

  assert_true(fn_mul.contains("@wh_fast"), fn_mul)
  let mul_fast = wave2_prd_extract_block(fn_mul, "@wh_fast", "@wh_slow")
  assert_true(!mul_fast.contains("$pion_panic_oob"), mul_fast)
  assert_true(fn_mul.contains("2147483647"), fn_mul)

  // 3. Parameter LUT length guards (if/else + positive branch): 0 OOB panics
  assert_true(fn_ifelse != "" && !fn_ifelse.contains("$pion_panic_oob"), fn_ifelse)
  assert_true(fn_pos != "" && !fn_pos.contains("$pion_panic_oob"), fn_pos)

  // 4. `.to_byte()` into `storeb` on Array[Byte]: 0 `and ..., 255`, 0 OOB panics, direct `storeb`
  assert_true(fn_tobyte != "" && !fn_tobyte.contains(", 255"), fn_tobyte)
  assert_true(!fn_tobyte.contains("=l and "), fn_tobyte)
  assert_true(!fn_tobyte.contains("$pion_panic_oob"), fn_tobyte)
  assert_true(fn_tobyte.contains("storeb "), fn_tobyte)

  // 5. Negative tests: shrink / rebind / OOB mask / unbounded signed shift MUST keep OOB panic
  assert_true(fn_neg_pop.contains("$pion_panic_oob"), fn_neg_pop)
  assert_true(fn_neg_rebind.contains("$pion_panic_oob"), fn_neg_rebind)
  assert_true(fn_neg_mask.contains("$pion_panic_oob"), fn_neg_mask)
  assert_true(fn_neg_shr.contains("$pion_panic_oob"), fn_neg_shr)
}

///|
test "wave2_prd_adversarial_p0_soundness" {
  let src =
    #|pub fn oob_if_leak(flag : Bool, lut : FixedArray[Int], x : Int) -> Int {
    #|  if flag {
    #|    if lut.length() < 256 { return 0 }
    #|  }
    #|  lut[x & 255]
    #|}
    #|
    #|pub fn oob_match_leak(tag : Int, lut : FixedArray[Int], x : Int) -> Int {
    #|  match tag {
    #|    0 => { if lut.length() < 256 { return 0 }; 1 }
    #|    _ => 2
    #|  }
    #|  lut[x & 255]
    #|}
    #|
    #|pub fn oob_loop_backedge(lut : Array[Int], x : Int) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  let mut s = 0
    #|  let mut i = 0
    #|  while i < 2 {
    #|    s = s + lut[x & 255]
    #|    lut.clear()
    #|    i = i + 1
    #|  }
    #|  s
    #|}
    #|
    #|pub fn oob_stale_restore(lut : Array[Int], x : Int) -> Int {
    #|  if lut.length() < 256 {
    #|    return 0
    #|  } else {
    #|    lut.clear()
    #|    if lut.length() < 1 { return 0 }
    #|  }
    #|  lut[x & 255]
    #|}
    #|
    #|pub fn fa_rebind_write(lut0 : FixedArray[Int], small : FixedArray[Int], x : Int) -> Unit {
    #|  let mut lut = lut0
    #|  if lut.length() < 256 {
    #|    return
    #|  } else {
    #|    lut = small
    #|    if lut.length() < 1 { return }
    #|  }
    #|  lut[x & 255] = 12345
    #|}
    #|
    #|pub fn oob_while_rebind_iv_win(arr : FixedArray[Int]) -> Int {
    #|  let mut s = 0
    #|  let mut i = 0
    #|  while i <= arr.length() - 4 {
    #|    if true {
    #|      let i = -1
    #|      s = s + arr[i]
    #|    }
    #|    i = i + 4
    #|  }
    #|  s
    #|}
    #|
    #|pub fn oob_while_rebind_iv_lt(arr : FixedArray[Int]) -> Int {
    #|  let mut s = 0
    #|  let mut i = 0
    #|  while i < arr.length() {
    #|    if true {
    #|      let i = -1
    #|      s = s + arr[i]
    #|    }
    #|    i = i + 1
    #|  }
    #|  s
    #|}
    #|
    #|pub fn oob_int8_add_wrap(lut : FixedArray[Int], x : Int8) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  let idx = ((x & (100).to_int8()) + (x & (100).to_int8())).to_int()
    #|  lut[idx]
    #|}
    #|
    #|pub fn oob_int8_mask_sign(lut : FixedArray[Int], x : Int8) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  let idx = (x & (-128).to_int8()).to_int()
    #|  lut[idx]
    #|}
    #|
    #|fn clear_and_false(a : Array[Int]) -> Bool {
    #|  a.clear()
    #|  false
    #|}
    #|
    #|pub fn oob_match_guard_mutate(tag : Int, lut : Array[Int], x : Int) -> Int {
    #|  if lut.length() < 256 { return 0 }
    #|  match tag {
    #|    0 if clear_and_false(lut) => 1
    #|    _ => lut[x & 255]
    #|  }
    #|}
    #|
    #|pub fn oob_match_shadow_arm1(tag : Int, lut : FixedArray[Int], big : FixedArray[Int], x : Int) -> Int {
    #|  let _ = match tag {
    #|    0 => {
    #|      if lut.length() < 256 { return 0 }
    #|      1
    #|    }
    #|    _ => {
    #|      let lut = big
    #|      if lut.length() < 256 { return 0 }
    #|      2
    #|    }
    #|  }
    #|  lut[x & 255]
    #|}
  let cr = check_source_files_with_imports("w2prd_p0", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let names = [
    "_fn_oob_if_leak(",
    "_fn_oob_match_leak(",
    "_fn_oob_loop_backedge(",
    "_fn_oob_stale_restore(",
    "_fn_fa_rebind_write(",
    "_fn_oob_while_rebind_iv_win(",
    "_fn_oob_while_rebind_iv_lt(",
    "_fn_oob_int8_add_wrap(",
    "_fn_oob_int8_mask_sign(",
    "_fn_oob_match_guard_mutate(",
    "_fn_oob_match_shadow_arm1(",
  ]
  let mut ni = 0
  while ni < names.length() {
    let target = names[ni]
    let mut found = ""
    let mut fi = 0
    while fi < funcs.length() {
      if funcs[fi].contains(target) {
        found = funcs[fi]
        break
      }
      fi = fi + 1
    }
    assert_true(found != "", "missing function " + target)
    assert_true(found.contains("$pion_panic_oob"), "MUST keep OOB panic in " + target + ":\n" + found)
    ni = ni + 1
  }
}

///|
test "wave2_pr_e_wasm_size_opts_unit_checks" {
  // 1. Constant `cast` of float/double literals folds into const_copies (zero 0xBC/0xBD reinterpret opcodes)
  let ssa_cast =
    #|export function l $cast_f64_zero() {
    #|@start
    #|  %a =l cast d_0.0
    #|  %b =l cast d_1.5
    #|  %c =l add %a, %b
    #|  ret %c
    #|}
    #|export function w $cast_f32_lit() {
    #|@start
    #|  %a =w cast s_2.5
    #|  ret %a
    #|}
  let parsed_cast = wasm_parse_ssa(ssa_cast)
  let wasm_cast = emit_wasm_from_ssa(ssa_cast)
  assert_true(wasm_cast.length() > 16, "valid wasm binary emitted")
  // Verify cast_f64_zero and cast_f32_lit bodies have zero 0xBC/0xBD reinterpret opcodes and no trailing 0x0F before 0x0B
  let ctx_cast = WasmModCtx::{
    sigs: [],
    sig_map: Map([]),
    import_names: [],
    import_sigs: [],
    import_ret_tys: [],
    import_map: Map([]),
    internal_map: Map([]),
    internal_ret_tys: Map([]),
    data_addrs: Map([]),
    fn_table_idx: Map([]),
    fn_table_list: [],
    slot_drop_masks: Map([]),
  }
  let body_f64 = wasm_compile_func(ctx_cast, parsed_cast.funcs[0], None)
  let body_f32 = wasm_compile_func(ctx_cast, parsed_cast.funcs[1], None)
  let mut i = 0
  while i < body_f64.length() {
    assert_true(body_f64[i] != 0xBD && body_f64[i] != 0x44, "cast d_0.0/d_1.5 must fold without f64.const or i64.reinterpret_f64")
    i = i + 1
  }
  assert_true(body_f64[body_f64.length() - 1] == 0x0B, "ends with 0x0B")
  assert_true(body_f64[body_f64.length() - 2] != 0x0F, "trailing return elided before end")
  i = 0
  while i < body_f32.length() {
    assert_true(body_f32[i] != 0xBC && body_f32[i] != 0x43, "cast s_2.5 must fold without f32.const or i32.reinterpret_f32")
    i = i + 1
  }
  assert_true(body_f32[body_f32.length() - 2] != 0x0F, "trailing return elided in f32 cast fn")

  // 2. Structured CFG omits redundant `block` wrappers for fallthrough-only blocks
  let ssa_fall =
    #|export function w $linear_blocks(w %x) {
    #|@b0
    #|  %a =w add %x, 1
    #|  jmp @b1
    #|@b1
    #|  %b =w add %a, 2
    #|  jmp @b2
    #|@b2
    #|  %c =w add %b, 3
    #|  ret %c
    #|}
  let parsed_fall = wasm_parse_ssa(ssa_fall)
  let body_fall = wasm_compile_func(ctx_cast, parsed_fall.funcs[0], None)
  let mut block_ops = 0
  i = 0
  while i < body_fall.length() {
    if body_fall[i] == 0x02 && i + 1 < body_fall.length() && body_fall[i + 1] == 0x40 {
      block_ops = block_ops + 1
    }
    i = i + 1
  }
  assert_eq(block_ops, 0)

  // 3. Single-block local coloring reuses local slots across non-overlapping temporaries
  let ssa_sb =
    #|export function l $single_blk_reuse(l %x) {
    #|@start
    #|  %a =l add %x, 1
    #|  %b =l mul %a, %a
    #|  %c =l add %b, 2
    #|  %d =l mul %c, %c
    #|  %e =l add %d, 3
    #|  %f =l mul %e, %e
    #|  %g =l add %f, 4
    #|  %h =l mul %g, %g
    #|  ret %h
    #|}
  let parsed_sb = wasm_parse_ssa(ssa_sb)
  let body_sb = wasm_compile_func(ctx_cast, parsed_sb.funcs[0], None)
  // First byte is local decl group count; second byte (if group count == 1) is local count <= 2
  assert_true(body_sb[0] <= 1, "single-block coloring keeps local decl groups compact")
  if body_sb[0] == 1 {
    assert_true(body_sb[1] <= 2, "non-overlapping single-block temps reuse <= 2 local slots")
  }

  // 4. Multi-round wasm_dedup_module converges across >2 call-chain levels
  let ssa_dedup =
    #|function w $leaf_a(w %x) {
    #|@start
    #|  %r =w add %x, 7
    #|  ret %r
    #|}
    #|function w $leaf_b(w %x) {
    #|@start
    #|  %r =w add %x, 7
    #|  ret %r
    #|}
    #|function w $mid_a(w %x) {
    #|@start
    #|  %r =w call $leaf_a(w %x)
    #|  ret %r
    #|}
    #|function w $mid_b(w %x) {
    #|@start
    #|  %r =w call $leaf_b(w %x)
    #|  ret %r
    #|}
    #|function w $top_a(w %x) {
    #|@start
    #|  %r =w call $mid_a(w %x)
    #|  ret %r
    #|}
    #|function w $top_b(w %x) {
    #|@start
    #|  %r =w call $mid_b(w %x)
    #|  ret %r
    #|}
    #|export function w $main() {
    #|@start
    #|  %a =w call $top_a(w 1)
    #|  %b =w call $top_b(w 2)
    #|  %c =w add %a, %b
    #|  ret %c
    #|}
  let deduped = wasm_dedup_module(wasm_parse_ssa(ssa_dedup))
  // leaf_a/b -> 1, mid_a/b -> 1, top_a/b -> 1, plus main = 4 functions total
  assert_eq(deduped.funcs.length(), 4)
}
