///|
/// True when some QBE function in `ssa` reads `%tp_<tn>` without receiving it
/// as a parameter or defining it (closure env load).
fn p27c1b_has_undefined_tp(ssa : String, tn : String) -> Bool {
  let use_pat = "%tp_" + tn
  let mut s = p18_find_from(ssa, "function ", 0)
  while s >= 0 {
    let nx = p18_find_from(ssa, "function ", s + 9)
    let e = if nx < 0 { ssa.length() } else { nx }
    let u = p18_find_from(ssa, use_pat, s)
    if u >= 0 && u < e {
      // Parameters only count in the signature (before the body's `{`),
      // not as call arguments `call $f(l %t1, l %tp_T)`.
      let h = p18_find_from(ssa, "{", s)
      let d1 = p18_find_from(ssa, "(l " + use_pat, s)
      let d2 = p18_find_from(ssa, ", l " + use_pat, s)
      let d3 = p18_find_from(ssa, use_pat + " =l loadl", s)
      let defined = (d1 >= 0 && d1 < h) ||
        (d2 >= 0 && d2 < h) ||
        (d3 >= 0 && d3 < e)
      if !defined {
        return true
      }
    }
    s = nx
  }
  false
}

///|
test "p27c1b_mono_closure_struct_lit_no_undefined_tp" {
  let src =
    #|struct Boxed[T] {
    #|  mut val_opt : Option[T]
    #|  getter : (Option[T]) -> T
    #|}
    #|fn step[T](b : Boxed[T]) -> Bool {
    #|  b.val_opt = Some((b.getter)(b.val_opt))
    #|  true
    #|}
    #|fn make_updater[T](getter : (Option[T]) -> T) -> () -> Bool {
    #|  let st = Boxed::{ val_opt: None, getter }
    #|  fn() -> Bool {
    #|    step(st)
    #|  }
    #|}
    #|fn main(w : World) -> Unit {
    #|  let f = make_updater(fn(_p : Option[Bool]) -> Bool { true })
    #|  let g = make_updater(fn(_p : Option[String]) -> String { "s" })
    #|  if f() && g() {
    #|    io_println(w, "ok")
    #|  }
    #|}
  let cr = check_source_files_with_imports("p27c1b", ["main.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, []).ssa
  assert_true(ssa.contains("make_updater__mono"), ssa)
  assert_true(!p27c1b_has_undefined_tp(ssa, "T"), "undefined %tp_T in mono fn:\n" + ssa)
}

///|
test "p27c2_float_uint_fixedarray_qbe" {
  let src =
    #|#derive(Eq)
    #|struct Vec2f {
    #|  x : Float
    #|  y : Float
    #|}
    #|fn float_ops(a : Float, b : Float) -> Bool {
    #|  let c : Float = (a + b) * (a - b) / 2.0
    #|  let d : Float = -c
    #|  d < a && d <= b && a == b
    #|}
    #|fn uint_ops(a : UInt, b : UInt, x : UInt64, y : UInt64) -> Bool {
    #|  let q = a / b
    #|  let r = a % b
    #|  let s = a >> 1
    #|  let q64 = x / y
    #|  let r64 = x % y
    #|  let s64 = x >> 1
    #|  q < r && s > 0U && q64 < r64 && s64 > 0UL
    #|}
    #|fn eq_vec(a : Vec2f, b : Vec2f) -> Bool {
    #|  a == b
    #|}
  let cr = check_source_files_with_imports("p27c2", ["main.pion"], [src], [], false)
