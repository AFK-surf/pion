enum P63dExtErr {
  InvalidExtType(Int)
  InvalidExtType64(Int64)
}

test "p63d_negative_int_pattern_match" {
  // 1. Direct literal parser checks (dec, hex, INT64_MIN)
  assert_eq(qbe_parse_int64_lit("-129"), -129L)
  assert_eq(qbe_parse_int64_lit("-0x81"), -129L)
  assert_eq(qbe_parse_int64_lit("-0X81L"), -129L)
  assert_eq(qbe_parse_int64_lit("129"), 129L)
  assert_eq(qbe_parse_int64_lit("-9223372036854775808L"), -9223372036854775807L - 1L)

  // 2. Runtime top-level & nested negative int / int64 pattern match
  let x = -129
  let hit_top = match x {
    -129 => 1
    129 => 2
    _ => 0
  }
  assert_eq(hit_top, 1)
  let hit_hex = match x {
    -0x81 => 10
    0x81 => 20
    _ => 0
  }
  assert_eq(hit_hex, 10)
  let r1 : Result[Int, P63dExtErr] = Err(P63dExtErr::InvalidExtType(-129))
  let hit_nested = match r1 {
    Err(P63dExtErr::InvalidExtType(-129)) => 3
    Err(P63dExtErr::InvalidExtType(129)) => 4
    _ => 0
  }
  assert_eq(hit_nested, 3)
  let r2 : Result[Int, P63dExtErr] = Err(P63dExtErr::InvalidExtType64(-129L))
  let hit_nested64 = match r2 {
    Err(P63dExtErr::InvalidExtType64(-129)) => 5
    Err(P63dExtErr::InvalidExtType64(129)) => 6
    _ => 0
  }
  assert_eq(hit_nested64, 5)

  // 3. SSA verification: negative pattern compiles to comparison against -129 (never +129)
  let src =
    #|pub enum ExtErr {
    #|  InvalidExtType(Int)
    #|  InvalidExtType64(Int64)
    #|}
    #|
    #|pub fn match_top_neg(x : Int) -> Int {
    #|  match x {
    #|    -129 => 1
    #|    -0x82 => 2
    #|    _ => 0
    #|  }
    #|}
    #|
    #|pub fn match_nested_neg(r : Result[Int, ExtErr]) -> Int {
    #|  match r {
    #|    Err(ExtErr::InvalidExtType(-129)) => 1
    #|    Err(ExtErr::InvalidExtType64(-129)) => 2
    #|    _ => 0
    #|  }
    #|}
  let cr = check_source_files_with_imports("p63d_negpat", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut top_ssa = ""
  let mut nest_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_pkg_0L12_p63d_unegpat_fn_match_top_neg(") {
      top_ssa = funcs[fi]
    } else if funcs[fi].contains("$pion_pkg_0L12_p63d_unegpat_fn_match_nested_neg(") {
      nest_ssa = funcs[fi]
    }
    fi = fi + 1
  }
  assert_true(
    top_ssa != "" &&
    top_ssa.contains(", -129") &&
    top_ssa.contains(", -130") &&
    !top_ssa.contains(", 129"),
    top_ssa,
  )
  assert_true(
    nest_ssa != "" &&
    nest_ssa.contains(", -129") &&
    !nest_ssa.contains(", 129"),
    nest_ssa,
  )
}

///|
test "p66b_small_const_len_arr_bce" {
  let src =
    #|let top_n : Int = 10
    #|
    #|pub fn ok_small_bce() -> Int {
    #|  let a = Array::make(10, 0)
    #|  let b = [1, 2, 3]
    #|  let c = Array::make(top_n, 7)
    #|  a[0] = 11
    #|  a[9] = 22
    #|  a[0] + a[9] + b[2] + c[0]
    #|}
    #|
    #|pub fn oob_small_a() -> Int {
    #|  let a = Array::make(10, 0)
    #|  a[10]
    #|}
    #|
    #|pub fn oob_small_b() -> Int {
    #|  let b = [1, 2, 3]
    #|  b[3]
    #|}
    #|
    #|pub fn oob_after_clear() -> Int {
    #|  let a = Array::make(10, 0)
    #|  a.clear()
    #|  a[0]
    #|}
    #|
    #|pub fn oob_after_pop() -> Int {
    #|  let a = Array::make(10, 0)
    #|  let _ = a.pop()
    #|  a[0]
    #|}
    #|
    #|pub fn fannkuch_style_zero_idx() -> Int {
    #|  let perm = Array::make(10, 0)
    #|  let perm1 = Array::make(10, 0)
    #|  perm1[0] = 3
    #|  let mut sum = 0
    #|  let mut k = 0
    #|  while k < 5 {
    #|    perm[0] = perm1[0]
    #|    sum = sum + perm[0] + perm1[0]
    #|    k = k + 1
    #|  }
    #|  sum
    #|}
  let cr = check_source_files_with_imports("p66b_bce", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut ok_ssa = ""
  let mut oob_a_ssa = ""
  let mut oob_b_ssa = ""
  let mut oob_clr_ssa = ""
  let mut oob_pop_ssa = ""
  let mut fk_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_0L9_p66b_ubce_fn_ok_small_bce(") {
      ok_ssa = f
    } else if f.contains("$pion_pkg_0L9_p66b_ubce_fn_oob_small_a(") {
      oob_a_ssa = f
    } else if f.contains("$pion_pkg_0L9_p66b_ubce_fn_oob_small_b(") {
      oob_b_ssa = f
    } else if f.contains("$pion_pkg_0L9_p66b_ubce_fn_oob_after_clear(") {
      oob_clr_ssa = f
    } else if f.contains("$pion_pkg_0L9_p66b_ubce_fn_oob_after_pop(") {
      oob_pop_ssa = f
    } else if f.contains("$pion_pkg_0L9_p66b_ubce_fn_fannkuch_style_zero_idx(") {
      fk_ssa = f
    }
    fi = fi + 1
  }
  assert_true(ok_ssa != "" && !ok_ssa.contains("pion_panic_oob"), ok_ssa)
  assert_true(fk_ssa != "" && !fk_ssa.contains("pion_panic_oob"), fk_ssa)
  assert_true(oob_a_ssa != "" && oob_a_ssa.contains("pion_panic_oob"), oob_a_ssa)
  assert_true(oob_b_ssa != "" && oob_b_ssa.contains("pion_panic_oob"), oob_b_ssa)
  assert_true(oob_clr_ssa != "" && oob_clr_ssa.contains("pion_panic_oob"), oob_clr_ssa)
  assert_true(oob_pop_ssa != "" && oob_pop_ssa.contains("pion_panic_oob"), oob_pop_ssa)
}

///|
test "p67a_xpkg_time_w5_all_five_methods_inlined_zero_alloc" {
  let lib_src =
    #|let i64_max : Int64 = 9223372036854775807L
    #|let i64_min : Int64 = -9223372036854775807L - 1L
    #|let ts_min_secs : Int64 = -377705116800L
    #|let ts_max_secs : Int64 = 253402300799L
    #|let nanos_per_sec : Int = 1000000000
    #|let nanos_per_sec_i64 : Int64 = 1000000000L
    #|
    #|fn checked_add_i64(a : Int64, b : Int64) -> Option[Int64] {
    #|  if b > 0L && a > i64_max - b {
    #|    None
    #|  } else if b < 0L && a < i64_min - b {
    #|    None
    #|  } else {
    #|    Some(a + b)
    #|  }
    #|}
    #|
    #|fn checked_mul_i64(a : Int64, b : Int64) -> Option[Int64] {
    #|  if a == 0L || b == 0L {
    #|    return Some(0L)
    #|  }
    #|  if (a == -1L && b == i64_min) || (b == -1L && a == i64_min) {
    #|    return None
    #|  }
    #|  let r = a * b
    #|  if r / a != b {
    #|    None
    #|  } else {
    #|    Some(r)
    #|  }
    #|}
    #|
    #|pub enum TimeError {
    #|  Overflow
    #|  DivByZero
    #|}
    #|
    #|pub struct SignedDuration {
    #|  secs : Int64
    #|  nanos : Int
    #|}
    #|
    #|pub struct Timestamp {
    #|  secs : Int64
    #|  nanos : Int
    #|}
    #|
    #|pub fn SignedDuration::new(secs : Int64, nanos : Int) -> Result[SignedDuration, TimeError] {
    #|  let mut s = secs
    #|  let mut n = nanos
    #|  if n >= nanos_per_sec {
    #|    match checked_add_i64(s, 1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n - nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  } else if n <= -nanos_per_sec {
    #|    match checked_add_i64(s, -1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n + nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  }
    #|  if s > 0L && n < 0 {
    #|    s = s - 1L
    #|    n = n + nanos_per_sec
    #|  } else if s < 0L && n > 0 {
    #|    s = s + 1L
    #|    n = n - nanos_per_sec
    #|  }
    #|  Ok(SignedDuration::{ secs: s, nanos: n })
    #|}
    #|
    #|pub fn SignedDuration::checked_add(
    #|  self : SignedDuration,
    #|  other : SignedDuration,
    #|) -> Result[SignedDuration, TimeError] {
    #|  let sum_s = match checked_add_i64(self.secs, other.secs) {
    #|    Some(v) => v
    #|    None => return Err(TimeError::Overflow)
    #|  }
    #|  let mut s = sum_s
    #|  let mut n = self.nanos + other.nanos
    #|  if n >= nanos_per_sec {
    #|    match checked_add_i64(s, 1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n - nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  } else if n <= -nanos_per_sec {
    #|    match checked_add_i64(s, -1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n + nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  }
    #|  if s > 0L && n < 0 {
    #|    s = s - 1L
    #|    n = n + nanos_per_sec
    #|  } else if s < 0L && n > 0 {
    #|    s = s + 1L
    #|    n = n - nanos_per_sec
    #|  }
    #|  Ok(SignedDuration::{ secs: s, nanos: n })
    #|}
    #|
    #|pub fn SignedDuration::checked_mul(
    #|  self : SignedDuration,
    #|  k : Int64,
    #|) -> Result[SignedDuration, TimeError] {
    #|  let s0 = match checked_mul_i64(self.secs, k) {
    #|    Some(v) => v
    #|    None => return Err(TimeError::Overflow)
    #|  }
    #|  let n64 = match checked_mul_i64(self.nanos.to_int64(), k) {
    #|    Some(v) => v
    #|    None => return Err(TimeError::Overflow)
    #|  }
    #|  let extra_s = n64 / nanos_per_sec_i64
    #|  let rem_n = (n64 % nanos_per_sec_i64).to_int()
    #|  match checked_add_i64(s0, extra_s) {
    #|    Some(s) => SignedDuration::new(s, rem_n)
    #|    None => Err(TimeError::Overflow)
    #|  }
    #|}
    #|
    #|pub fn SignedDuration::checked_div(
    #|  self : SignedDuration,
    #|  d : Int64,
    #|) -> Result[SignedDuration, TimeError] {
    #|  if d == 0L {
    #|    return Err(TimeError::DivByZero)
    #|  }
    #|  if d == -1L && self.secs == i64_min {
    #|    let mut step = 0
    #|    let mut acc = 0L
    #|    while step < 3 {
    #|      acc = acc + 1L
    #|      step = step + 1
    #|    }
    #|    if acc > 0L {
    #|      return Err(TimeError::Overflow)
    #|    }
    #|  }
    #|  let qs = self.secs / d
    #|  let rs = self.secs % d
    #|  let total_n = rs * nanos_per_sec_i64 + self.nanos.to_int64()
    #|  let qn = (total_n / d).to_int()
    #|  Ok(SignedDuration::{ secs: qs, nanos: qn })
    #|}
    #|
    #|pub fn Timestamp::checked_add(
    #|  self : Timestamp,
    #|  dur : SignedDuration,
    #|) -> Result[Timestamp, TimeError] {
    #|  let s0 = match checked_add_i64(self.secs, dur.secs) {
    #|    Some(v) => v
    #|    None => return Err(TimeError::Overflow)
    #|  }
    #|  let mut s = s0
    #|  let mut n = self.nanos + dur.nanos
    #|  if n >= nanos_per_sec {
    #|    match checked_add_i64(s, 1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n - nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  } else if n < 0 {
    #|    match checked_add_i64(s, -1L) {
    #|      Some(v) => {
    #|        s = v
    #|        n = n + nanos_per_sec
    #|      }
    #|      None => return Err(TimeError::Overflow)
    #|    }
    #|  }
    #|  if s < ts_min_secs || s > ts_max_secs {
    #|    return Err(TimeError::Overflow)
    #|  }
    #|  Ok(Timestamp::{ secs: s, nanos: n })
    #|}
    #|
    #|pub fn SignedDuration::zero() -> SignedDuration {
    #|  SignedDuration::{ secs: 0L, nanos: 0 }
    #|}
    #|
    #|pub fn Timestamp::since(self : Timestamp, earlier : Timestamp) -> SignedDuration {
    #|  let ds = self.secs - earlier.secs
    #|  let dn = self.nanos - earlier.nanos
    #|  match SignedDuration::new(ds, dn) {
    #|    Ok(d) => d
    #|    Err(_) => SignedDuration::zero()
    #|  }
    #|}
  let app_src =
    #|import "t5lib" as t5lib
    #|
    #|pub fn run_w5(n : Int) -> Int64 {
    #|  let t0 = t5lib::Timestamp::{ secs: 1700000000L, nanos: 250000000 }
    #|  let t1 = t5lib::Timestamp::{ secs: 1699999000L, nanos: 750000000 }
    #|  let d0 = t5lib::SignedDuration::{ secs: 12L, nanos: 600000000 }
    #|  let d1 = t5lib::SignedDuration::{ secs: 3L, nanos: 500000000 }
    #|  let mut acc = 0L
    #|  let mut i = 0
    #|  while i < n {
    #|    let r1 = match t0.checked_add(d0) {
    #|      Ok(ts) => ts.secs + ts.nanos.to_int64()
    #|      Err(_) => -1L
    #|    }
    #|    let r2 = match d0.checked_add(d1) {
    #|      Ok(d) => d.secs + d.nanos.to_int64()
    #|      Err(_) => -1L
    #|    }
    #|    let r3 = match d0.checked_mul(3L) {
    #|      Ok(d) => d.secs + d.nanos.to_int64()
    #|      Err(_) => -1L
    #|    }
    #|    let r4 = match d0.checked_div(2L) {
    #|      Ok(d) => d.secs + d.nanos.to_int64()
    #|      Err(_) => -1L
    #|    }
    #|    let ds = t0.since(t1)
    #|    acc = acc + r1 + r2 + r3 + r4 + ds.secs + ds.nanos.to_int64()
    #|    i = i + 1
    #|  }
    #|  acc
    #|}
  let lcr = check_source_files_with_imports("t5lib", ["t5lib.pion"], [lib_src], [], true)
  assert_true(lcr.diagnostics.length() == 0, check_result_to_json(lcr.diagnostics))
  let stub = emit_pion_stub(lcr.pkg)
  assert_true(!stub.contains("{ panic() }"), stub)
  assert_true(stub.contains("while (step < 3)"), stub)
  let lstub_cr = check_source_files_with_imports("t5lib", ["t5lib.pionstub"], [stub], [], true)
  assert_true(lstub_cr.diagnostics.length() == 0, check_result_to_json(lstub_cr.diagnostics))
  let imp_list = [ImportedPkg::{ name: "t5lib", tc: lstub_cr.tc }]
  let acr = check_source_files_with_imports("t5app", ["t5app.pion"], [app_src], imp_list, true)
  assert_true(acr.diagnostics.length() == 0, check_result_to_json(acr.diagnostics))
  let mut t_idx = 0
  while t_idx < 2 {
    let is_wasm = t_idx == 1
    let ssa = emit_qbe_package_multi(acr.pkg, acr.tc, true, is_wasm, ["t5lib"]).ssa
    let funcs = ssa.split("function ")
    let mut w5_ssa = ""
    let mut fi = 0
    while fi < funcs.length() {
      if funcs[fi].contains("$pion_pkg_t5app_fn_run_w5(") {
        w5_ssa = funcs[fi]
      }
      fi = fi + 1
    }
    assert_true(
      w5_ssa != "" &&
      w5_ssa.contains("\n@wh_b_") &&
      w5_ssa.contains("\n@wh_e_") &&
      !w5_ssa.contains("call $pion_pkg_t5lib_"),
      w5_ssa,
    )
    let w5_loop_parts = w5_ssa.split("\n@wh_b_")
    let w5_after_head = w5_ssa.slice(w5_loop_parts[0].length(), w5_ssa.length())
    assert_true(
      w5_after_head.contains("\n@spod_mok_") &&
      w5_after_head.contains("\n@spod_merr_") &&
      w5_after_head.contains("\n@spod_mend_"),
      w5_after_head,
    )
    let w5_before_merr = w5_after_head.split("\n@spod_merr_")[0]
    let w5_after_mend = w5_after_head.split("\n@spod_mend_")[1]
    assert_true(
      !w5_before_merr.contains("pion_alloc_uninit") &&
      !w5_after_mend.contains("pion_alloc_uninit"),
      w5_after_head,
    )
    t_idx = t_idx + 1
  }
}

test "p69b_sieve_swar_u4_dec_bce_and_sb_wide_store" {
  // 1. SSA assertions for all 4 P69-B optimizations (Native + Wasm32)
  let src =
    #|pub fn count_flags(flags : Array[Bool], n : Int) -> Int {
    #|  let mut count = 0
    #|  let mut k = 0
    #|  while k < n {
    #|    if flags[k] {
    #|      count = count + 1
    #|    }
    #|    k = k + 1
    #|  }
    #|  count
    #|}
    #|
    #|pub fn mark_stride(flags : Array[Bool], start : Int, step : Int, n : Int) -> Unit {
    #|  let mut j = start
    #|  while j < n {
    #|    flags[j] = false
    #|    j = j + step
    #|  }
    #|}
    #|
    #|pub fn dec_fill(count : Array[Int], r0 : Int) -> Int {
    #|  let mut r = r0
    #|  while r != 1 {
    #|    count[r - 1] = r
    #|    r = r - 1
    #|  }
    #|  r
    #|}
    #|
    #|pub fn build_lits() -> String {
    #|  let sb = StringBuilder()
    #|  let mut i = 0
    #|  while i < 1 {
    #|    sb.write_string("ab")
    #|    sb.write_string("cde")
    #|    sb.write_string("fghi")
    #|    sb.write_string("jklmn")
    #|    sb.write_string("{\"id\":")
    #|    sb.write_string("0123456")
    #|    sb.write_string("789abcde")
    #|    sb.write_string(",\"active\":true,")
    #|    i = i + 1
    #|  }
    #|  sb.to_string()
    #|}
  let cr = check_source_files_with_imports("p69b", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut cnt_ssa = ""
  let mut mrk_ssa = ""
  let mut dec_ssa = ""
  let mut sb_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_p69b_fn_count_flags(") {
      cnt_ssa = f
    } else if f.contains("$pion_pkg_p69b_fn_mark_stride(") {
      mrk_ssa = f
    } else if f.contains("$pion_pkg_p69b_fn_dec_fill(") {
      dec_ssa = f
    } else if f.contains("$pion_pkg_p69b_fn_build_lits(") {
      sb_ssa = f
    }
    fi = fi + 1
  }
  // Opt 1: SWAR bool counting uses 0x0101010101010101L and >> 56
  assert_true(
    cnt_ssa != "" &&
    cnt_ssa.contains("72340172838076673") &&
    cnt_ssa.contains("shr ") &&
    cnt_ssa.contains(", 56"),
    cnt_ssa,
  )
  // Opt 2: var-step 4x unroll uses pointer-based @wh_u4p / @wh_u4 with no extsw inside @wh_u4
  assert_true(mrk_ssa != "" && mrk_ssa.contains("\n@wh_u4p_") && mrk_ssa.contains("\n@wh_u4_"), mrk_ssa)
  let u4_body = mrk_ssa.split("\n@wh_u4_")[1].split("\n@wh_u4t_")[0]
  assert_true(
    !u4_body.contains("extsw") && u4_body.split("storeb ").length() >= 5,
    u4_body,
  )
  // Opt 3: decrementing loop fast path has zero pion_panic_oob
  assert_true(dec_ssa != "" && dec_ssa.contains("\n@wh_fast_") && dec_ssa.contains("\n@wh_slow_"), dec_ssa)
  let dec_fast = dec_ssa.split("\n@wh_fast_")[1].split("\n@wh_slow_")[0]
  assert_true(!dec_fast.contains("pion_panic_oob"), dec_fast)
  // Opt 4: wide little-endian storew/storel emitted for ASCII literals
  assert_true(
    sb_ssa != "" && sb_ssa.contains("storew ") && sb_ssa.contains("storel "),
    sb_ssa,
  )

  // 2. Runtime edge-case assertions (SWAR lengths 0,1,7,8,9,15,16,17,100; var-step; dec_fill; wide StringBuilder)
  let lens = [0, 1, 7, 8, 9, 15, 16, 17, 100]
  let mut li = 0
  while li < lens.length() {
    let n = lens[li]
    let flags = Array::make(n, true)
    let mut k = 0
    while k < n {
      if k % 3 == 0 {
        flags[k] = false
      }
      k = k + 1
    }
    let mut cnt = 0
    let mut j = 0
    while j < n {
      if flags[j] {
        cnt = cnt + 1
      }
      j = j + 1
    }
    let want = n - (if n == 0 { 0 } else { (n - 1) / 3 + 1 })
    assert_eq(cnt, want)
    li = li + 1
  }

  // Var-step marking with different strides & remainders
  let f2 = Array::make(31, true)
  let mut j2 = 4
  let step2 = 3
  while j2 < 31 {
    f2[j2] = false
    j2 = j2 + step2
  }
  let mut c2 = 0
  let mut k2 = 0
  while k2 < 31 {
    if f2[k2] {
      c2 = c2 + 1
    }
    k2 = k2 + 1
  }
  // Marked: 4,7,10,13,16,19,22,25,28 -> 9 falses, 22 trues
  assert_eq(c2, 22)

  // Decrementing loop fill + zero-iteration guard (r == 1)
  let cnt_arr = Array::make(6, 0)
  let mut r = 6
  while r != 1 {
    cnt_arr[r - 1] = r
    r = r - 1
  }
  assert_eq(r, 1)
  assert_eq(cnt_arr[0], 0)
  assert_eq(cnt_arr[1], 2)
  assert_eq(cnt_arr[5], 6)
  // r == 1 enters 0 iterations
  while r != 1 {
    cnt_arr[r - 1] = 99
    r = r - 1
  }
  assert_eq(cnt_arr[1], 2)

  // Wide StringBuilder literal writes across lengths 2..16 (exact bytes & NUL termination)
  let sb = StringBuilder()
  sb.write_string("ab")
  sb.write_string("cde")
  sb.write_string("fghi")
  sb.write_string("jklmn")
  sb.write_string("{\"id\":")
  sb.write_string("0123456")
  sb.write_string("789abcde")
  sb.write_string(",\"active\":true,")
  assert_eq(sb.to_string(), "abcdefghijklmn{\"id\":0123456789abcde,\"active\":true,")
}

///|
enum P70JVal {
  P70JNull
  P70JStr(String)
  P70JArr(Array[P70JVal])
  P70JObj(Array[P70JField])
}

///|
struct P70JField {
  key : String
  value : P70JVal
}

///|
fn p70_make_enum(flag : Bool) -> P70JVal {
  let sb = StringBuilder()
  sb.write_string("hello")
  if flag {
    sb.write_string("_world")
  }
  P70JStr(sb.to_string())
}

///|
test "p70a_match_borrowed_payload_and_index_scrut" {
  // 1. SSA assertions: decode_records-style nested match on arr[i] + payload bindings + owned scrut
  let src =
    #|enum JVal {
    #|  JNull
    #|  JStr(String)
    #|  JArr(Array[JVal])
    #|  JObj(Array[JField])
    #|}
    #|
    #|struct JField {
    #|  key : String
    #|  value : JVal
    #|}
    #|
    #|fn make_wrap(flag : Bool) -> JVal {
    #|  let sb = StringBuilder()
    #|  sb.write_string("abc")
    #|  if flag {
    #|    sb.write_string("def")
    #|  }
    #|  JStr(sb.to_string())
    #|}
    #|
    #|pub fn decode_like(items : Array[JVal]) -> Int {
    #|  let mut total = 0
    #|  let mut i = 0
    #|  while i < items.length() {
    #|    match items[i] {
    #|      JObj(fields) => {
    #|        let mut name = ""
    #|        let tags : Array[String] = []
    #|        let mut fi = 0
    #|        while fi < fields.length() {
    #|          let f = fields[fi]
    #|          match f.value {
    #|            JStr(v) => name = v
    #|            JArr(ts) => {
    #|              let mut ti = 0
    #|              while ti < ts.length() {
    #|                match ts[ti] {
    #|                  JStr(s) => tags.push(s)
    #|                  _ => ()
    #|                }
    #|                ti = ti + 1
    #|              }
    #|            }
    #|            _ => ()
    #|          }
    #|          fi = fi + 1
    #|        }
    #|        total = total + name.length() + tags.length()
    #|      }
    #|      _ => ()
    #|    }
    #|    i = i + 1
    #|  }
    #|  total
    #|}
    #|
    #|pub fn owned_scrut_len(flag : Bool) -> Int {
    #|  match make_wrap(flag) {
    #|    JStr(a) => a.length()
    #|    _ => 0
    #|  }
    #|}
    #|
    #|pub fn alias_clear_guard(arr : Array[JVal]) -> Int {
    #|  let b = arr
    #|  match arr[0] {
    #|    JStr(s) => {
    #|      b.clear()
    #|      s.length()
    #|    }
    #|    _ => 0
    #|  }
    #|}
    #|
    #|pub fn alias_idx_assign_guard(arr : Array[JVal]) -> Int {
    #|  let b = arr
    #|  match arr[0] {
    #|    JStr(s) => {
    #|      b[0] = JNull
    #|      s.length()
    #|    }
    #|    _ => 0
    #|  }
    #|}
    #|
    #|pub fn map_clear_borrowed_arr_guard(m : Map[String, JVal]) -> Int {
    #|  match m.get("k") {
    #|    Some(JArr(ts)) =>
    #|      match ts[0] {
    #|        JStr(s) => {
    #|          m.clear()
    #|          s.length()
    #|        }
    #|        _ => 0
    #|      }
    #|    _ => 0
    #|  }
    #|}
  let cr = check_source_files_with_imports("p70a", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut dec_ssa = ""
  let mut own_ssa = ""
  let mut clr_ssa = ""
  let mut asg_ssa = ""
  let mut map_clr_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_p70a_fn_decode_like(") {
      dec_ssa = f
    } else if f.contains("$pion_pkg_p70a_fn_owned_scrut_len(") {
      own_ssa = f
    } else if f.contains("$pion_pkg_p70a_fn_alias_clear_guard(") {
      clr_ssa = f
    } else if f.contains("$pion_pkg_p70a_fn_alias_idx_assign_guard(") {
      asg_ssa = f
    } else if f.contains("$pion_pkg_p70a_fn_map_clear_borrowed_arr_guard(") {
      map_clr_ssa = f
    }
    fi = fi + 1
  }
  // decode_like: only rc_inc for `name = v` and `tags.push(s)` (+ initial "" / tags);
  // zero rc_inc for match items[i], JObj(fields), JArr(ts), match ts[ti], JStr(s), JStr(v) binding.
  let dec_incs = dec_ssa.split("call $pion_rc_inc(").length() - 1
  assert_true(dec_ssa != "" && dec_incs <= 2, "dec_incs=" + dec_incs.to_string() + "\n" + dec_ssa)
  // owned_scrut_len: `a` is borrowed from __match_scrut -> 0 rc_inc in owned_scrut_len
  let own_incs = own_ssa.split("call $pion_rc_inc(").length() - 1
  assert_true(own_ssa != "" && own_incs == 0, "own_incs=" + own_incs.to_string() + "\n" + own_ssa)
  // Negative alias guards: arr[0] / ts[0] MUST NOT be borrowed when alias or outer Map mutates
  let clr_incs = clr_ssa.split("call $pion_rc_inc(").length() - 1
  let asg_incs = asg_ssa.split("call $pion_rc_inc(").length() - 1
  let map_clr_incs = map_clr_ssa.split("call $pion_rc_inc(").length() - 1
  assert_true(clr_ssa != "" && clr_incs >= 2, "clr_incs=" + clr_incs.to_string() + "\n" + clr_ssa)
  assert_true(asg_ssa != "" && asg_incs >= 2, "asg_incs=" + asg_incs.to_string() + "\n" + asg_ssa)
  assert_true(
    map_clr_ssa != "" && map_clr_incs >= 1,
    "map_clr_incs=" + map_clr_incs.to_string() + "\n" + map_clr_ssa,
  )

  // 2. Runtime + ASan/LSan adversarial tests (zero UAF, zero leaks)
  let s_dyn = StringBuilder()
  s_dyn.write_string("alpha")
  let arr1 : Array[P70JVal] = [P70JStr(s_dyn.to_string())]
  let b1 = arr1
  let len1 = match arr1[0] {
    P70JStr(s) => {
      b1.clear()
      s.length()
    }
    _ => -1
  }
  assert_eq(len1, 5)
  assert_eq(arr1.length(), 0)

  let s_dyn2 = StringBuilder()
  s_dyn2.write_string("hello")
  let arr2 : Array[P70JVal] = [P70JStr(s_dyn2.to_string())]
  let b2 = arr2
  let len2 = match arr2[0] {
    P70JStr(s) => {
      b2[0] = P70JNull
      s.length()
    }
    _ => -1
  }
  assert_eq(len2, 5)

  // Adversarial Map::clear while matching borrowed array element ts[0] (0 UAF, 0 leak)
  let s_dyn3 = StringBuilder()
  s_dyn3.write_string("delta")
  let m3 : Map[String, P70JVal] = Map([])
  m3.set("k", P70JArr([P70JStr(s_dyn3.to_string())]))
  let len3 = match m3.get("k") {
    Some(P70JArr(ts)) =>
      match ts[0] {
        P70JStr(s) => {
          m3.clear()
          s.length()
        }
        _ => -1
      }
    _ => -1
  }
  assert_eq(len3, 5)
  assert_eq(m3.length(), 0)

  // Escaping binding from owned scrut must rc_inc properly (0 UAF, 0 leak)
  let escaped = match p70_make_enum(true) {
    P70JStr(v) => {
      let r = v
      r
    }
    _ => ""
  }
  assert_eq(escaped, "hello_world")

  // Borrowed binding from owned scrut (non-escaping)
  let non_esc_len = match p70_make_enum(false) {
    P70JStr(a) => a.length()
    _ => -1
  }
  assert_eq(non_esc_len, 5)

  // Nested decode_records-like execution with distinct-type array mutation
  let t1 = StringBuilder()
  t1.write_string("tag1")
  let t2 = StringBuilder()
  t2.write_string("tag2")
  let nm = StringBuilder()
  nm.write_string("alice")
  let items : Array[P70JVal] = [
    P70JObj([
      P70JField::{ key: "name", value: P70JStr(nm.to_string()) },
      P70JField::{ key: "tags", value: P70JArr([P70JStr(t1.to_string()), P70JStr(t2.to_string())]) },
    ]),
  ]
  let mut out_name = ""
  let out_tags : Array[String] = []
  let mut idx = 0
  while idx < items.length() {
    match items[idx] {
      P70JObj(fields) => {
        let mut fi2 = 0
        while fi2 < fields.length() {
          let f = fields[fi2]
          match f.value {
            P70JStr(v) => out_name = v
            P70JArr(ts) => {
              let mut ti = 0
              while ti < ts.length() {
                match ts[ti] {
                  P70JStr(s) => out_tags.push(s)
                  _ => ()
                }
                ti = ti + 1
              }
            }
            _ => ()
          }
          fi2 = fi2 + 1
        }
      }
      _ => ()
    }
    idx = idx + 1
  }
  assert_eq(out_name, "alice")
  assert_eq(out_tags.length(), 2)
  assert_eq(out_tags[0], "tag1")
  assert_eq(out_tags[1], "tag2")
}

///|
test "p71b_tuple_option_match_user_callee_panic_msg_and_log1p" {
  let src =
    #|pub fn sha256_hex(b : Bytes) -> String {
    #|  b.length().to_string()
    #|}
    #|pub fn open_unann(on : Option[(String, Int)]) -> String {
    #|  let (pin, ep, relays, ips) = match on {
    #|    None => (None, 0, ["r0"], ["ip0"])
    #|    Some((kind, e)) => if kind == "lan" {
    #|      (Some(kind), e, [], ["s"])
    #|    } else {
    #|      (Some(kind), e, [kind], [])
    #|    }
    #|  }
    #|  match pin {
    #|    None => "main:" + ep.to_string() + ":" + ips.length().to_string()
    #|    Some(p) => "pin:" + p + ":" + relays.length().to_string()
    #|  }
    #|}
    #|pub fn use_user_sha(b : Bytes) -> String {
    #|  sha256_hex(b)
    #|}
    #|pub fn use_log1p(x : Double) -> Double {
    #|  math_log1p(x)
    #|}
    #|pub fn fail_msg(s : String) -> Unit {
    #|  panic("reason:" + s)
    #|}
  let cr = check_source_files_full("p71b_be", ["p71b_be.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // 1. user sha256_hex calls (or inlines) user fn body ($pion_int_to_str), NOT $pion_sha256_hex
  let us = p18_find_from(ssa, "$pion_fn_use_user_sha(", 0)
  let ue = p18_find_from(ssa, "\n}", us)
  assert_true(us >= 0 && ue > us, ssa)
  let has_user_call = p18_find_from(ssa, "call $pion_fn_sha256_hex(", us)
  let has_inlined_body = p18_find_from(ssa, "call $pion_int_to_str(", us)
  assert_true((has_user_call > us && has_user_call < ue) || (has_inlined_body > us && has_inlined_body < ue), ssa)
  let has_builtin_call = p18_find_from(ssa, "call $pion_sha256_hex(", us)
  assert_true(has_builtin_call < 0 || has_builtin_call > ue, ssa)

  // 2. math_log1p calls $log1p
  let ls = p18_find_from(ssa, "$pion_fn_use_log1p(", 0)
  let le = p18_find_from(ssa, "\n}", ls)
  assert_true(ls >= 0 && le > ls, ssa)
  let has_log1p = p18_find_from(ssa, "call $log1p(", ls)
  assert_true(has_log1p > ls && has_log1p < le, ssa)

  // 3. panic(msg) passes dynamic string payload (+8) to $pion_panic
  let ps = p18_find_from(ssa, "$pion_fn_fail_msg(", 0)
  let pe = p18_find_from(ssa, "\n}", ps)
  assert_true(ps >= 0 && pe > ps, ssa)
  let has_add8 = p18_find_from(ssa, ", 8\n", ps)
  assert_true(has_add8 > ps && has_add8 < pe, ssa)
  let has_panic_call = p18_find_from(ssa, "call $pion_panic(l %", ps)
  assert_true(has_panic_call > ps && has_panic_call < pe, ssa)

  // 4. Runtime check of unannotated tuple-option match + math_log1p
  let on0 : Option[(String, Int)] = None
  let on1 : Option[(String, Int)] = Some(("lan", 7))
  let on2 : Option[(String, Int)] = Some(("relay1", 9))
  let (p0, e0, _, ips0) = match on0 {
    None => (None, 0, ["r0"], ["ip0"])
    Some((k, e)) => if k == "lan" { (Some(k), e, [], ["s"]) } else { (Some(k), e, [k], []) }
  }
  let (p1, e1, r1, _) = match on1 {
    None => (None, 0, ["r0"], ["ip0"])
    Some((k, e)) => if k == "lan" { (Some(k), e, [], ["s"]) } else { (Some(k), e, [k], []) }
  }
  let (p2, e2, r2, _) = match on2 {
    None => (None, 0, ["r0"], ["ip0"])
    Some((k, e)) => if k == "lan" { (Some(k), e, [], ["s"]) } else { (Some(k), e, [k], []) }
  }
  let s0 = match p0 {
    None => "N:" + e0.to_string() + ":" + ips0.length().to_string()
    Some(x) => "S:" + x
  }
  let s1 = match p1 {
    None => "N"
    Some(x) => "S:" + x + ":" + e1.to_string() + ":" + r1.length().to_string()
  }
  let s2 = match p2 {
    None => "N"
    Some(x) => "S:" + x + ":" + e2.to_string() + ":" + r2.length().to_string()
  }
  assert_eq(s0, "N:0:1")
  assert_eq(s1, "S:lan:7:0")
  assert_eq(s2, "S:relay1:9:1")
  let lv = math_log1p(0.0)
  assert_true(lv > -0.000001 && lv < 0.000001, "math_log1p(0.0)")
}

///|
enum P72Err {
  P72BadLen(Int)
  P72BadChar(String)
}

///|
fn P72Err::message(self : P72Err) -> String {
  match self {
    P72BadLen(n) => "len=" + n.to_string()
    P72BadChar(s) => "ch=" + s
  }
}

///|
struct P72SecretBox {
  tag : String
  priv mut count : Int
}

///|
fn P72SecretBox::new(tag : String) -> P72SecretBox {
  P72SecretBox::{ tag: tag, count: 10 }
}

///|
fn P72SecretBox::inc(self : P72SecretBox, d : Int) -> Int {
  self.count += d
  self.count
}

///|
test "p72b_enum_methods_and_priv_struct_runtime" {
  let e1 = P72Err::P72BadLen(42)
  let e2 = P72BadChar("!")
  assert_eq(e1.message(), "len=42")
  assert_eq(P72Err::message(e1), "len=42")
  assert_eq(e2.message(), "ch=!")
  assert_eq(P72Err::message(e2), "ch=!")
  let b = P72SecretBox::new("k")
  assert_eq(b.tag, "k")
  assert_eq(b.inc(5), 15)
}

///|
test "p75a_compact_i8_f32_ssa" {
  let src =
    #|pub fn dot_i8(a : Array[Int8], b : Array[Int8]) -> Int {
    #|  let mut sum = 0
    #|  let mut i = 0
    #|  let n = a.length()
    #|  while i < n {
    #|    sum += a[i].to_int() * b[i].to_int()
    #|    i += 1
    #|  }
    #|  sum
    #|}
    #|pub fn f32_saxpy(n : Int, alpha : Float32) -> Float {
    #|  let xs : Array[Float32] = Array::make(n, 1.5f)
    #|  let ys : FixedArray[Float] = FixedArray::make(n, 0.0f)
    #|  let mut i = 0
    #|  while i < n {
    #|    ys[i] = ys[i] + alpha * xs[i]
    #|    i += 1
    #|  }
    #|  ys[0]
    #|}
    #|pub fn read_hdr(bs : Bytes) -> Float {
    #|  let s : Int8 = bs.read_i8(0)
    #|  bs.read_f32_le(1) + s.to_float()
    #|}
  let cr = check_source_files_full("p75a_be", ["p75a_be.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa

  // 1. Array[Int8] hot loop uses loadsb (no loadub)
  let s1 = p18_find_from(ssa, "$pion_fn_dot_i8(", 0)
  let e1 = p18_find_from(ssa, "\n}", s1)
  assert_true(s1 >= 0 && e1 > s1, ssa)
  let lsb = p18_find_from(ssa, "loadsb ", s1)
  assert_true(lsb > s1 && lsb < e1, "expected loadsb in dot_i8: " + ssa)
  let lub = p18_find_from(ssa, "loadub ", s1)
  assert_true(lub < 0 || lub > e1, "unexpected loadub in dot_i8: " + ssa)

  // 2. Array[Float]/FixedArray[Float] uses elem_flags=4, shl 2, loads/stores (no shl 3)
  let s2 = p18_find_from(ssa, "$pion_fn_f32_saxpy(", 0)
  let e2 = p18_find_from(ssa, "\n}", s2)
  assert_true(s2 >= 0 && e2 > s2, ssa)
  let nw4 = p18_find_from(ssa, ", w 4)", s2)
  assert_true(nw4 > s2 && nw4 < e2, "expected elem_flags=4 in f32_saxpy: " + ssa)
  let sh2 = p18_find_from(ssa, "shl ", s2)
  assert_true(sh2 > s2 && sh2 < e2, "expected shl in f32_saxpy")
  let mut pos = s2
  while pos >= 0 && pos < e2 {
    let sh = p18_find_from(ssa, "=l shl ", pos)
    if sh < 0 || sh >= e2 {
      break
    }
    let nl = p18_find_from(ssa, "\n", sh)
    let sh3 = p18_find_from(ssa, ", 3\n", sh)
    assert_true(sh3 < 0 || sh3 > nl, "unexpected shl 3 in f32_saxpy: " + ssa)
    pos = nl + 1
  }
  let lds = p18_find_from(ssa, "=s loads ", s2)
  assert_true(lds > s2 && lds < e2, "expected =s loads in f32_saxpy")
  let sts = p18_find_from(ssa, "stores ", s2)
  assert_true(sts > s2 && sts < e2, "expected stores in f32_saxpy")

  // 3. Bytes::read_i8 (loadsb) & Bytes::read_f32_le (loads)
  let s3 = p18_find_from(ssa, "$pion_fn_read_hdr(", 0)
  let e3 = p18_find_from(ssa, "\n}", s3)
  assert_true(s3 >= 0 && e3 > s3, ssa)
  let b_lsb = p18_find_from(ssa, "loadsb ", s3)
  assert_true(b_lsb > s3 && b_lsb < e3, "expected loadsb in read_hdr")
  let b_lds = p18_find_from(ssa, "=s loads ", s3)
  assert_true(b_lds > s3 && b_lds < e3, "expected =s loads in read_hdr")
}

///|
test "wave2f_bytes_be_and_blit_ssa" {
  let src =
    #|pub fn read_be_hdr(b : Bytes) -> Int64 {
    #|  let v = b.view(2, 24)
    #|  let u16 = b.read_u16_be(0)
    #|  let u32 = v.read_u32_be(0)
    #|  let f32 = v.read_f32_be(4)
    #|  let i64 = b.read_i64_be(8)
    #|  let f64 = v.read_f64_be(8)
    #|  i64 + u16.to_int64() + u32.to_int64() + f32.to_int().to_int64() + f64.to_int().to_int64()
    #|}
    #|pub fn do_blit(src : Bytes, dst : Bytes, s : String) -> Unit {
    #|  let v = src.view(1, 5)
    #|  src.blit_to(dst, 0, 0, 4)
    #|  v.blit_to(dst, 0, 4, 4)
    #|  dst.copy_from_string(0, s, 0, 2)
    #|}
  let cr = check_source_files_full("wave2f_be", ["wave2f_be.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let s1 = p18_find_from(ssa, "$pion_fn_read_be_hdr(", 0)
  let e1 = p18_find_from(ssa, "\n}", s1)
  assert_true(s1 >= 0 && e1 > s1, ssa)
  assert_true(p18_find_from(ssa, "loaduh ", s1) > s1 && p18_find_from(ssa, "loaduh ", s1) < e1, "expected loaduh for read_u16_be")
  assert_true(p18_find_from(ssa, "=s cast ", s1) > s1 && p18_find_from(ssa, "=s cast ", s1) < e1, "expected =s cast for read_f32_be")
  assert_true(p18_find_from(ssa, "=d cast ", s1) > s1 && p18_find_from(ssa, "=d cast ", s1) < e1, "expected =d cast for read_f64_be")
  let s2 = p18_find_from(ssa, "$pion_fn_do_blit(", 0)
  let e2 = p18_find_from(ssa, "\n}", s2)
  assert_true(s2 >= 0 && e2 > s2, ssa)
  assert_true(p18_find_from(ssa, "call $pion_bytes_blit(", s2) > s2 && p18_find_from(ssa, "call $pion_bytes_blit(", s2) < e2, "expected call $pion_bytes_blit")
}

///|
struct P74Buf {
  arr : Array[Double]
  mut n : Int
}

///|
fn p74_grow_slot(b : P74Buf) -> Int {
  let pos = b.n * 60
  while b.arr.length() < pos + 60 {
    b.arr.push(0.0)
  }
  pos
}

///|
fn p74_copy_into(dst : P74Buf, count : Int) -> Unit {
  let d = dst.arr
  let mut k = 0
  while k < count {
    let w = p74_grow_slot(dst)
    d[w] = (k + 1).to_double()
    d[w + 59] = (k * 3 + 7).to_double()
    dst.n = dst.n + 1
    k = k + 1
  }
}

///|
test "p74c_licm_alias_soundness_ssa_and_runtime" {
  // 1. Runtime check of the exact whiteboard Buf/grow_slot aliased-array growth repro
  let buf = P74Buf::{ arr: [], n: 0 }
  p74_copy_into(buf, 80)
  assert_eq(buf.n, 80)
  assert_eq(buf.arr.length(), 4800)
  assert_true(buf.arr[0] == 1.0 && buf.arr[59] == 7.0, "slot 0")
  assert_true(buf.arr[79 * 60] == 80.0 && buf.arr[79 * 60 + 59] == 244.0, "slot 79")

  // 2. SSA check: aliased array in loop with cross-function call MUST reload len/dp inside loop
  // (NOT hoisted before loop), while no-call loop and non-escaping local array still hoist.
  let src =
    #|struct Buf {
    #|  arr : Array[Double]
    #|  mut n : Int
    #|}
    #|
    #|pub fn grow_slot(b : Buf) -> Int {
    #|  let pos = b.n * 60
    #|  while b.arr.length() < pos + 60 {
    #|    b.arr.push(0.0)
    #|  }
    #|  pos
    #|}
    #|
    #|pub fn aliased_call_loop(dst : Buf, count : Int) -> Unit {
    #|  let d = dst.arr
    #|  let mut k = 0
    #|  while k < count {
    #|    let w = grow_slot(dst)
    #|    d[w] = 1.0
    #|    dst.n = dst.n + 1
    #|    k = k + 1
    #|  }
    #|}
    #|
    #|pub fn nocall_loop_sum(xs : Array[Int]) -> Int {
    #|  let mut acc = 0
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    acc = acc + xs[i]
    #|    i = i + 1
    #|  }
    #|  acc
    #|}
  let cr = check_source_files_with_imports("p74c", ["p74c.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut alias_ssa = ""
  let mut nocall_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_p74c_fn_aliased_call_loop(") {
      alias_ssa = f
    } else if f.contains("$pion_pkg_p74c_fn_nocall_loop_sum(") {
      nocall_ssa = f
    }
    fi = fi + 1
  }
  assert_true(alias_ssa != "", "aliased_call_loop SSA found")
  assert_true(nocall_ssa != "", "nocall_loop_sum SSA found")
  // In aliased_call_loop, the loop body (after `\n@wh_b_`) MUST reload data_ptr (`+ 24`)
  // instead of hoisting it before the loop.
  let alias_parts = alias_ssa.split("\n@wh_b_")
  assert_true(alias_parts.length() >= 2, alias_ssa)
  assert_true(alias_parts[1].contains(", 24"), alias_ssa)
  // In nocall_loop_sum, data_ptr (`+ 24`) IS hoisted before `\n@wh_b_` (not reloaded in body).
  let nocall_parts = nocall_ssa.split("\n@wh_b_")
  assert_true(nocall_parts.length() >= 2, nocall_ssa)
  assert_true(nocall_parts[0].contains(", 24"), nocall_ssa)
  assert_true(!nocall_parts[1].contains(", 24"), nocall_ssa)
}

///|
test "p74d_float_to_int_sat_targets" {
  let src =
    #|pub fn d_to_i64(x : Double) -> Int64 {
    #|  x.to_int64()
    #|}
  let cr = check_source_files_full("p74d", ["p74d.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )

  // 1. arm64_apple: single `=l dtosi`, zero saturation guard branches.
  let arm_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "arm64_apple").ssa
  assert_true(arm_ssa.contains("=l dtosi "), arm_ssa)
  assert_true(!arm_ssa.contains("@ftoi_"), arm_ssa)

  // 2. amd64_sysv: emits inline NaN/range saturation guard + `=l dtosi`.
  let x64_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "amd64_sysv").ssa
  assert_true(x64_ssa.contains("=l dtosi "), x64_ssa)
  assert_true(x64_ssa.contains("@ftoi_nan_"), x64_ssa)
  assert_true(x64_ssa.contains("@ftoi_lo_"), x64_ssa)
  assert_true(x64_ssa.contains("@ftoi_hi_"), x64_ssa)

  // 3. wasm32: single `dtosi` lowered to `0xFC 0x06` (i64.trunc_sat_f64_s), no branches.
  let wasm_ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "wasm32").ssa
  assert_true(wasm_ssa.contains("=l dtosi "), wasm_ssa)
  assert_true(!wasm_ssa.contains("@ftoi_"), wasm_ssa)
  let wasm = emit_wasm_from_ssa(wasm_ssa)
  let mut found_trunc_sat_f64_s = false
  let mut wi = 0
  while wi + 1 < wasm.length() {
    if wasm[wi] == b'\xfc' && wasm[wi + 1] == b'\x06' {
      found_trunc_sat_f64_s = true
      break
    }
    wi = wi + 1
  }
  assert_true(found_trunc_sat_f64_s, "expected 0xFC 0x06 (i64.trunc_sat_f64_s) in wasm32 bytecode")
}

///|
test "p74f_stub_body_disables_pod_borrow" {
  let src =
    #|pub struct Limits {
    #|  max_string_len : Int
    #|  max_packet_len : Int
    #|  max_list_items : Int
    #|}
    #|pub fn stub_from_payload(lim : Limits) -> Int {
    #|  panic()
    #|}
    #|pub fn call_stub() -> Int {
    #|  let lim = Limits::{ max_string_len: 1024, max_packet_len: 65536, max_list_items: 1024 }
    #|  stub_from_payload(lim)
    #|}
  let cr = check_source_files_full("p74f", ["p74f.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("export function ")
  let mut call_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_fn_call_stub(") {
      call_ssa = funcs[fi]
      break
    }
    fi = fi + 1
  }
  assert_true(call_ssa != "", ssa)
  // `lim` passed to a `.pionstub` `{ panic() }` placeholder MUST be heap-allocated
  // via `$pion_alloc_uninit(w 24, ...)` (never stack-allocated `alloc8 24` or `alloc8 48`).
  assert_true(call_ssa.contains("call $pion_alloc_uninit(w 24,"), call_ssa)
  assert_true(!call_ssa.contains("alloc8 24"), call_ssa)
  assert_true(!call_ssa.contains("alloc8 48"), call_ssa)
}

///|
test "p96_pod_stack_immortal_header_ssa" {
  let src =
    #|pub struct Cfg {
    #|  pub a : Int
    #|  pub b : UInt64
    #|  pub c : Bool
    #|}
    #|struct Budget {
    #|  mut total : UInt64
    #|}
    #|fn Budget::consume(self : Budget, n : Int, cfg : Cfg) -> Result[Unit, Int] {
    #|  let next = self.total + n.to_int64().to_uint64()
    #|  if next > cfg.b { return Err(1) }
    #|  self.total = next
    #|  Ok(())
    #|}
    #|pub fn leaf(data : Bytes, b : Budget, cfg : Cfg) -> Result[Bytes, Int] {
    #|  let mut x = data
    #|  if x.length() > 1000000 { return Err(2) }
    #|  match b.consume(x.length(), cfg) {
    #|    Err(e) => return Err(e)
    #|    Ok(_) => ()
    #|  }
    #|  Ok(x)
    #|}
    #|pub fn mid(data : Bytes, cfg : Cfg, b : Budget) -> Result[Bytes, Int] {
    #|  let mut i = 0
    #|  while i < 1 {
    #|    i += 1
    #|    let r = match leaf(data, Budget::{ total: 0UL }, cfg) {
    #|      Ok(v) => v
    #|      Err(e) => return Err(e)
    #|    }
    #|    match b.consume(r.length(), cfg) {
    #|      Err(e) => return Err(e)
    #|      Ok(_) => ()
    #|    }
    #|  }
    #|  Ok(data)
    #|}
    #|pub fn outer(data : Bytes) -> Int {
    #|  let dec_cfg = Cfg::{ a: 4, b: 4294967296UL, c: false }
    #|  match mid(data, dec_cfg, Budget::{ total: 0UL }) {
    #|    Ok(v) => v.length()
    #|    Err(e) => e
    #|  }
    #|}
    #|pub fn view_leaf(s : StrView, n : Int) -> Int {
    #|  s.length() + n
    #|}
    #|pub fn view_outer(s : String) -> Int {
    #|  let v = s.as_view()
    #|  view_leaf(v, s.length())
    #|}
  let cr = check_source_files_full("p96", ["p96.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("export function ")
  let mut outer_ssa = ""
  let mut view_outer_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_fn_outer(") {
      outer_ssa = funcs[fi]
    }
    if funcs[fi].contains("$pion_fn_view_outer(") {
      view_outer_ssa = funcs[fi]
    }
    fi = fi + 1
  }
  assert_true(outer_ssa != "", ssa)
  assert_true(view_outer_ssa != "", ssa)
  // Both stack-promoted POD struct (24B) and stack-promoted StrView (24B) MUST allocate
  // 24 + 24 = 48 bytes and initialize the 24B immortal PionHeader (type_tag=4, flags=11).
  assert_true(outer_ssa.contains("alloc8 48"), outer_ssa)
  assert_true(outer_ssa.contains("storeh 4, "), outer_ssa)
  assert_true(outer_ssa.contains("storeh 11, "), outer_ssa)
  assert_true(!outer_ssa.contains("alloc8 24"), outer_ssa)
  assert_true(view_outer_ssa.contains("alloc8 48"), view_outer_ssa)
  assert_true(view_outer_ssa.contains("storeh 4, "), view_outer_ssa)
  assert_true(view_outer_ssa.contains("storeh 11, "), view_outer_ssa)
  assert_true(!view_outer_ssa.contains("alloc8 24"), view_outer_ssa)
}

///|
test "p96_pod_stack_escape_soundness_ssa" {
  let src =
    #|pub struct One { pub n : Int }
    #|pub struct Two { pub a : Int; pub b : Int }
    #|fn save(p : Two) -> Int { p.a + p.b }
    #|pub fn push_one(xs : Array[One], i : Int) -> Unit {
    #|  let p = One::{ n: i }
    #|  xs.push(p)
    #|}
    #|pub fn assign_one(xs : Array[One], i : Int) -> Unit {
    #|  let p = One::{ n: i }
    #|  xs[0] = p
    #|}
    #|pub fn push_two(xs : Array[Two], i : Int) -> Unit {
    #|  let p = Two::{ a: i, b: i + 1 }
    #|  xs.push(p)
    #|}
    #|pub fn shadow_save(holder : Array[Two], i : Int) -> Unit {
    #|  let p = Two::{ a: i, b: i + 10 }
    #|  let save = fn(x : Two) -> Unit { holder.push(x) }
    #|  save(p)
    #|}
    #|pub fn shadow_save_is(opt : Option[(Two) -> Unit], i : Int) -> Unit {
    #|  let p = Two::{ a: i, b: i + 20 }
    #|  if opt is Some(save) {
    #|    save(p)
    #|  }
    #|}
  let cr = check_source_files_full("p96_esc", ["p96_esc.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("export function ")
  let mut push_one_ssa = ""
  let mut assign_one_ssa = ""
  let mut push_two_ssa = ""
  let mut shadow_save_ssa = ""
  let mut shadow_save_is_ssa = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_fn_push_one(") {
      push_one_ssa = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_assign_one(") {
      assign_one_ssa = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_push_two(") {
      push_two_ssa = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_shadow_save(") {
      shadow_save_ssa = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_shadow_save_is(") {
      shadow_save_is_ssa = funcs[fi]
    }
    fi = fi + 1
  }
  assert_true(push_one_ssa != "" && assign_one_ssa != "" && push_two_ssa != "", ssa)
  assert_true(shadow_save_ssa != "" && shadow_save_is_ssa != "", ssa)
  // 1-field POD struct is pointer-stored in Array[One] -> MUST heap-allocate (8B), never stack-promote (32B).
  assert_true(push_one_ssa.contains("call $pion_alloc_uninit(w 8,"), push_one_ssa)
  assert_true(!push_one_ssa.contains("alloc8 32"), push_one_ssa)
  assert_true(assign_one_ssa.contains("call $pion_alloc_uninit(w 8,"), assign_one_ssa)
  assert_true(!assign_one_ssa.contains("alloc8 32"), assign_one_ssa)
  // 2-field flat-POD struct IS stored inline in Array[Two] -> stays stack-promoted with 24B immortal header (40B).
  assert_true(push_two_ssa.contains("alloc8 40"), push_two_ssa)
  assert_true(push_two_ssa.contains("storeh 11, "), push_two_ssa)
  assert_true(!push_two_ssa.contains("call $pion_alloc_uninit(w 16,"), push_two_ssa)
  // Subsequent local `save` (let / is-pattern) shadowing top-level `fn save` -> MUST heap-allocate (16B).
  assert_true(shadow_save_ssa.contains("call $pion_alloc_uninit(w 16,"), shadow_save_ssa)
  assert_true(!shadow_save_ssa.contains("alloc8 40"), shadow_save_ssa)
  assert_true(shadow_save_is_ssa.contains("call $pion_alloc_uninit(w 16,"), shadow_save_is_ssa)
  assert_true(!shadow_save_is_ssa.contains("alloc8 40"), shadow_save_is_ssa)
}

///|
test "p75c_float_local_slot_stores" {
  let src =
    #|pub fn f32_acc(n : Int) -> Float {
    #|  let mut acc : Float = 0.0f
    #|  let mut i = 0
    #|  while i < n {
    #|    acc = acc + 1.0f
    #|    i += 1
    #|  }
    #|  acc
    #|}
  let cr = check_source_files_full("p75c", ["p75c.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, true, "amd64_sysv").ssa
  let parts = ssa.split("\n@wh_b_")
  assert_true(parts.length() >= 2, ssa)
  let loop_body = parts[1]
  assert_true(loop_body.contains("stores "), loop_body)
  assert_true(loop_body.contains("=s loads "), loop_body)
  assert_true(!loop_body.contains("=w cast "), loop_body)
  assert_true(!loop_body.contains("storel "), loop_body)
}

///|
test "p82d: #verify folds safe const shift and div checks while keeping unsafe/dynamic checks" {
  let src =
    #|#verify
    #|pub fn ct_eq_nibble(a : Int, b : Int) -> Int64 {
    #|  (((a ^ b) - 1) >> 31).to_int64() & 1L
    #|}
    #|#verify
    #|pub fn sh64(x : Int64) -> Int64 {
    #|  (x << 63L) >> 0L
    #|}
    #|#verify
    #|pub fn div_const(x : Int, y : Int64) -> Int64 {
    #|  (x / 2 + x % -3).to_int64() + y / 7L
    #|}
    #|#verify
    #|pub fn bad_sh(x : Int, n : Int) -> Int {
    #|  (x >> n) + (x >> 32)
    #|}
    #|#verify
    #|pub fn bad_div(x : Int, d : Int) -> Int {
    #|  (x / d) + (x / 0) + (x / -1)
    #|}
  let cr = check_source_files_full("p82d", ["p82d.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("export function ")
  let mut s_ct = ""
  let mut s_sh64 = ""
  let mut s_divc = ""
  let mut s_bad_sh = ""
  let mut s_bad_div = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_fn_ct_eq_nibble(") {
      s_ct = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_sh64(") {
      s_sh64 = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_div_const(") {
      s_divc = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_bad_sh(") {
      s_bad_sh = funcs[fi]
    } else if funcs[fi].contains("$pion_fn_bad_div(") {
      s_bad_div = funcs[fi]
    }
    fi = fi + 1
  }
  assert_true(s_ct != "", ssa)
  assert_true(s_sh64 != "", ssa)
  assert_true(s_divc != "", ssa)
  assert_true(s_bad_sh != "", ssa)
  assert_true(s_bad_div != "", ssa)
  // Safe compile-time constant shift/div/mod checks are folded away
  assert_true(!s_ct.contains("vsh_bad"), s_ct)
  assert_true(!s_ct.contains("vdiv_zero"), s_ct)
  assert_true(!s_ct.contains("vdiv_ovf"), s_ct)
  assert_true(!s_sh64.contains("vsh_bad"), s_sh64)
  assert_true(!s_divc.contains("vdiv_zero"), s_divc)
  assert_true(!s_divc.contains("vdiv_ovf"), s_divc)
  // Unsafe / dynamic shift/div checks are preserved
  assert_true(s_bad_sh.contains("vsh_bad"), s_bad_sh)
  assert_true(s_bad_div.contains("vdiv_zero"), s_bad_div)
  assert_true(s_bad_div.contains("vdiv_ovf"), s_bad_div)
}

