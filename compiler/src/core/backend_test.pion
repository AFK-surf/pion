  let m_alloc = p18_find_from(ssa, "pion_alloc_uninit", m_s)
  assert_true(m_alloc < 0 || m_alloc > m_e, ssa)
}

///|
test "p30e_loop_borrowed_arr_elem_rc_elision" {
  let src =
    #|pub struct Item {
    #|  pub tag : String
    #|  pub score : Int
    #|}
    #|pub fn count_matching(xs : Array[Item], target : String) -> Int {
    #|  let mut acc = 0
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    let elem = xs[i]
    #|    let t = elem.tag
    #|    if t == target {
    #|      acc = acc + elem.score
    #|    }
    #|    i = i + 1
    #|  }
    #|  acc
    #|}
  let cr = check_source_files_full("p30e_borrow", ["p30e_borrow.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let fn_s = p18_find_from(ssa, "$pion_fn_count_matching(", 0)
  let fn_e = p18_find_from(ssa, "\n}", fn_s)
  assert_true(fn_s >= 0 && fn_e > fn_s, ssa)
  // Both `let elem = xs[i]` and `let t = elem.tag` (used in `t == target`) must elide RC inc/dec
  let has_inc = p18_find_from(ssa, "call $pion_rc_inc", fn_s)
  assert_true(has_inc < 0 || has_inc > fn_e, ssa)
  let has_dec = p18_find_from(ssa, "call $pion_rc_dec", fn_s)
  assert_true(has_dec < 0 || has_dec > fn_e, ssa)
}

///|
test "p30e_float_double_mod_fmod" {
  let src =
    #|pub fn dmod(a : Double, b : Double) -> Double {
    #|  a % b
    #|}
    #|pub fn fmod_s(a : Float, b : Float) -> Float {
    #|  a % b
    #|}
  let cr = check_source_files_full("p30e_fmod", ["p30e_fmod.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let ds = p18_find_from(ssa, "$pion_fn_dmod(", 0)
  let de = p18_find_from(ssa, "\n}", ds)
  assert_true(ds >= 0 && de > ds, ssa)
  let d_fmod = p18_find_from(ssa, " =d call $fmod(", ds)
  assert_true(d_fmod > ds && d_fmod < de, ssa)

  let fs = p18_find_from(ssa, "$pion_fn_fmod_s(", 0)
  let fe = p18_find_from(ssa, "\n}", fs)
  assert_true(fs >= 0 && fe > fs, ssa)
  let f_exts = p18_find_from(ssa, " =d exts ", fs)
  let f_fmod = p18_find_from(ssa, " =d call $fmod(", fs)
  let f_trunc = p18_find_from(ssa, " =s truncd ", fs)
  assert_true(f_exts > fs && f_exts < fe, ssa)
  assert_true(f_fmod > fs && f_fmod < fe, ssa)
  assert_true(f_trunc > fs && f_trunc < fe, ssa)

  // Runtime execution verification (compiled by self-hosted pionc)
  let d1 = 7.5 % 2.0
  assert_true(d1 == 1.5, "7.5 % 2.0 == 1.5")
  let d2 = (-1.5) % 6.28
  assert_true(d2 < -1.4 && d2 > -1.6, "(-1.5) % 6.28 == -1.5")
  let f1 : Float = 7.5f % 2.0f
  assert_true(f1 == 1.5f, "7.5f % 2.0f == 1.5f")
}
