    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  let fns : Array[String] = ["$pion_fn_collect(", "$pion_fn_one(", "$pion_fn_by_ret("]
  let mut fi = 0
  while fi < fns.length() {
    let s = p18_find_from(ssa, fns[fi], 0)
    let e = p18_find_from(ssa, "\n}", s)
    assert_true(s >= 0 && e > s, ssa)
    // Object elements: the array must own (rc) them, never `w 0`.
    let new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", s)
    assert_true(new0 < 0 || new0 > e, ssa)
    let new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", s)
    assert_true(new1 > s && new1 < e, ssa)
    fi = fi + 1
  }
}

///|
test "p29c_wasm32_emit_binary_magic_and_sections" {
  let src =
    #|fn add_mul(a : Int, b : Int) -> Int {
    #|  a * b + 1
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let x = add_mul(6, 7)
    #|  io_println(world, x.to_string())
    #|  0
    #|}
  let cr = check_source_files_full("p29c_wasm", ["main.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  let wasm = emit_wasm_from_ssa(ssa)
  assert_true(wasm.length() > 64, "wasm binary too small")
  // Wasm binary magic: \0asm\x01\0\0\0
  assert_true(wasm[0] == b'\x00', "magic[0]")
  assert_true(wasm[1] == b'\x61', "magic[1]")
  assert_true(wasm[2] == b'\x73', "magic[2]")
  assert_true(wasm[3] == b'\x6d', "magic[3]")
  assert_true(wasm[4] == b'\x01', "version[0]")
  assert_true(wasm[5] == b'\x00', "version[1]")
  assert_true(wasm[6] == b'\x00', "version[2]")
  assert_true(wasm[7] == b'\x00', "version[3]")
  // Must contain Type section (1) immediately after 8-byte header
  assert_true(wasm[8] == b'\x01', "expected Type section id 1 at offset 8")
}

///|
test "p30a_array_contains_and_float_lit_ssa" {
  let src =
    #|pub fn has_str(a : Array[String], s : String) -> Bool {
    #|  a.contains(s)
    #|}
    #|pub fn has_fixed(a : FixedArray[Int], x : Int) -> Bool {
    #|  a.contains(x)
    #|}
    #|pub fn f32_ops(x : Float) -> Float {
    #|  let a : Float = 1.0
    #|  let b : Float = -2.5
    #|  a + b + 2.0 * x
    #|}
  let cr = check_source_files_full("p30a_be", ["p30a_be.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  let s1 = p18_find_from(ssa, "$pion_fn_has_str(", 0)
  let e1 = p18_find_from(ssa, "\n}", s1)
  assert_true(s1 >= 0 && e1 > s1, ssa)
  let eq_pos = p18_find_from(ssa, "call $pion_str_eq(", s1)
  assert_true(eq_pos > s1 && eq_pos < e1, ssa)

  let s2 = p18_find_from(ssa, "$pion_fn_has_fixed(", 0)
  let e2 = p18_find_from(ssa, "\n}", s2)
  assert_true(s2 >= 0 && e2 > s2, ssa)
  let ceq_pos = p18_find_from(ssa, "=w ceqw ", s2)
  assert_true(ceq_pos > s2 && ceq_pos < e2, ssa)

  let s3 = p18_find_from(ssa, "$pion_fn_f32_ops(", 0)
  let e3 = p18_find_from(ssa, "\n}", s3)
  assert_true(s3 >= 0 && e3 > s3, ssa)
  let s10 = p18_find_from(ssa, "=s copy s_1.0", s3)
  assert_true(s10 > s3 && s10 < e3, ssa)
  let bad_d = p18_find_from(ssa, "=d ", s3)
  assert_true(bad_d < 0 || bad_d > e3, ssa)
}

///|
test "p30a_bug14_large_closure_40_slots_drop" {
  let sb = StringBuilder()
  sb.write_string("fn run_fn(cb : () -> Int) -> Int {\n  cb()\n}\n")
  sb.write_string("pub fn big_clo(n : Int) -> Int {\n")
  let mut i = 1
  while i <= 40 {
    sb.write_string("  let s" + i.to_string() + " = \"v\" + n.to_string()\n")
    i = i + 1
  }
  sb.write_string("  run_fn(fn() -> Int {\n    let mut total = 0\n")
  i = 1
  while i <= 40 {
    sb.write_string("    total = total + s" + i.to_string() + ".length()\n")
    i = i + 1
  }
  sb.write_string("    total\n  })\n}\n")
  let cr = check_source_files_full("p30a_b14", ["p30a_b14.pion"], [sb.to_string()])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // Never emit a negative signed-32-bit slot drop mask symbol.
  assert_true(p18_find_from(ssa, "$pion_drop_slots_-", 0) < 0, ssa)
  // Must emit an unsigned hex-chunked slot drop function covering slot 40 (offset 320).
  let drop_pos = p18_find_from(ssa, "function $pion_drop_slots_x_", 0)
  assert_true(drop_pos >= 0, ssa)
  let drop_end = p18_find_from(ssa, "\n}", drop_pos)
  assert_true(drop_end > drop_pos, ssa)
  let off320 = p18_find_from(ssa, "add %p, 320", drop_pos)
  assert_true(off320 > drop_pos && off320 < drop_end, ssa)
}

///|
fn p30b_count_in_range(s : String, needle : String, start : Int, end_pos : Int) -> Int {
  let mut count = 0
  let mut pos = start
  while pos < end_pos {
    let found = p18_find_from(s, needle, pos)
    if found < 0 || found >= end_pos {
      break
    }
    count = count + 1
    pos = found + needle.length()
  }
  count
}

///|
test "p30b_borrow_rc_elision_and_adversarial" {
  let src =
    #|struct Attr {
    #|  prefix : String
    #|  name : String
    #|  value : String
    #|}
    #|struct Node {
    #|  attrs : Array[Attr]
    #|}
    #|struct BoxMut {
    #|  mut cur : Attr
    #|}
    #|pub fn find_attr(attrs : Array[Attr], target : String) -> Option[String] {
    #|  let mut i = 0
    #|  while i < attrs.length() {
    #|    let a = attrs[i]
    #|    if a.prefix == "" && a.name == target {
    #|      return Some(a.value)
    #|    }
    #|    i += 1
    #|  }
    #|  None
    #|}
    #|pub fn Node::attr(self : Node, target : String) -> Option[String] {
    #|  let mut i = 0
    #|  while i < self.attrs.length() {
    #|    let a = self.attrs[i]
    #|    if a.prefix == "" && a.name == target {
    #|      return Some(a.value)
    #|    }
    #|    i += 1
    #|  }
    #|  None
    #|}
    #|pub fn arr_clear_keeps_rc(arr : Array[Attr]) -> Int {
    #|  let a = arr[0]
    #|  arr.clear()
    #|  a.name.length()
    #|}
    #|pub fn field_mut_keeps_rc(b : BoxMut, other : Attr) -> Int {
    #|  let a = b.cur
    #|  b.cur = other
    #|  a.name.length()
    #|}
    #|struct Holder {
    #|  x : Int
    #|}
    #|fn Holder::clear_alias(arr : Array[Attr]) -> Unit {
    #|  arr.clear()
    #|}
    #|pub fn epath_alias_clear_keeps_rc(node : Node, alias : Array[Attr]) -> Int {
    #|  let a = node.attrs[0]
    #|  Holder::clear_alias(alias)
    #|  a.name.length()
    #|}
  let cr = check_source_files_full("p30b_be", ["p30b_be.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa

  // find_attr: 0 rc_dec, only 1 rc_inc (on hit return Some(a.value))
  let s1 = p18_find_from(ssa, "$pion_fn_find_attr(", 0)
  let e1 = p18_find_from(ssa, "\n}", s1)
  assert_true(s1 >= 0 && e1 > s1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_inc(", s1, e1) == 1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_dec(", s1, e1) == 0, ssa)

  // Node::attr (`let a = self.attrs[i]`): 0 rc_dec, only 1 rc_inc (on hit return)
  let s2 = p18_find_from(ssa, "$pion_m_Node__attr(", 0)
  let e2 = p18_find_from(ssa, "\n}", s2)
  assert_true(s2 >= 0 && e2 > s2, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_inc(", s2, e2) == 1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_dec(", s2, e2) == 0, ssa)

  // Adversarial: arr.clear() MUST retain rc_inc & rc_dec on `a`
  let s3 = p18_find_from(ssa, "$pion_fn_arr_clear_keeps_rc(", 0)
  let e3 = p18_find_from(ssa, "\n}", s3)
  assert_true(s3 >= 0 && e3 > s3, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_inc(", s3, e3) >= 1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_dec(", s3, e3) >= 1, ssa)

  // Adversarial: b.cur = other MUST retain rc_inc & rc_dec on `a`
  let s4 = p18_find_from(ssa, "$pion_fn_field_mut_keeps_rc(", 0)
  let e4 = p18_find_from(ssa, "\n}", s4)
  assert_true(s4 >= 0 && e4 > s4, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_inc(", s4, e4) >= 1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_dec(", s4, e4) >= 1, ssa)

  // Adversarial: EPath assoc fn call `Holder::clear_alias(alias)` MUST retain rc_inc & rc_dec on `a`
  let s5 = p18_find_from(ssa, "$pion_fn_epath_alias_clear_keeps_rc(", 0)
  let e5 = p18_find_from(ssa, "\n}", s5)
  assert_true(s5 >= 0 && e5 > s5, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_inc(", s5, e5) >= 1, ssa)
  assert_true(p30b_count_in_range(ssa, "call $pion_rc_dec(", s5, e5) >= 1, ssa)
}

///|
