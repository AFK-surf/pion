}

///|
test "p18: event-loop primitives lower to direct C calls with the World first" {
  let src =
    #|pub fn watch(world : World, pfd : Int, fd : Int) -> Bool {
    #|  poll_ctl(world, pfd, 1, fd, 1)
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let lfd = tcp_listen_reuse(world, "127.0.0.1", 0)
    #|  let pfd = poll_create(world)
    #|  if !tcp_set_nonblock(world, lfd, true) || !poll_ctl(world, pfd, 1, lfd, 3) {
    #|    return 1
    #|  }
    #|  let fds : Array[Int] = []
    #|  let evs : Array[Int] = []
    #|  let buf = StringBuilder()
    #|  let n = poll_wait(world, pfd, fds, evs, 256, 10)
    #|  let c = tcp_accept_nb(world, lfd)
    #|  let r = tcp_read_nb(world, c, buf, 16384)
    #|  let w = tcp_write_nb(world, c, buf.to_string(), r)
    #|  poll_close(world, pfd)
    #|  n + w
    #|}
  let cr = check_source_files_full("p18_cg", ["p18_cg.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  assert_true(ssa.contains("=w call $pion_tcp_listen_reuse(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_create(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_set_nonblock(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_ctl(l "), ssa)
  assert_true(ssa.contains("=w call $pion_poll_wait(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_accept_nb(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_read_nb(l "), ssa)
  assert_true(ssa.contains("=w call $pion_tcp_write_nb(l "), ssa)
  assert_true(ssa.contains("call $pion_poll_close(l "), ssa)
  // A C `int32_t` Bool result is widened into Pion's 64-bit Bool slot before `ret`.
  let fn_at = p18_find_from(ssa, "$pion_fn_watch(", 0)
  assert_true(fn_at >= 0, ssa)
  let fn_end = p18_find_from(ssa, "\n}", fn_at)
  let call_at = p18_find_from(ssa, "=w call $pion_poll_ctl(", fn_at)
  let ext_at = p18_find_from(ssa, " =l extuw ", call_at)
  assert_true(call_at > fn_at && ext_at > call_at && ext_at < fn_end, ssa)
}

///|
test "p19b: 24B header, null-niche Option[Ref], Bool enum singleton, N-way concat, chained borrow, struct String BCE, sb.length" {
  let src =
    #|pub struct Pair {
    #|  key : String
    #|  value : String
    #|}
    #|pub enum Val {
    #|  VNull
    #|  VBool(Bool)
    #|  VStr(String)
    #|}
    #|pub struct Scanner {
    #|  src : String
    #|  len : Int
    #|  mut pos : Int
    #|}
    #|pub fn lookup(entries : Array[Pair], k : String) -> Option[String] {
    #|  let n = entries.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    if entries[i].key == k {
    #|      return Some(entries[i].value)
    #|    }
    #|    i = i + 1
    #|  }
    #|  None
    #|}
    #|pub fn nested_opt(flag : Int) -> Option[Option[String]] {
    #|  if flag == 0 {
    #|    None
    #|  } else if flag == 1 {
    #|    Some(None)
    #|  } else {
    #|    Some(Some("ok"))
    #|  }
    #|}
    #|pub fn scan_quote(p : Scanner) -> Int {
    #|  let mut i = p.pos
    #|  while i < p.len {
    #|    if p.src.code_unit_at(i) == 34 {
    #|      break
    #|    }
    #|    i = i + 1
    #|  }
    #|  i
    #|}
    #|pub fn build_alert(svc : String, lvl : String, msg : String) -> String {
    #|  "ALERT|" + svc + "|" + lvl + "|" + msg
    #|}
    #|pub fn mk_bools(b : Bool) -> Array[Val] {
    #|  let out : Array[Val] = []
    #|  out.push(VBool(true))
    #|  out.push(VBool(false))
    #|  out.push(VBool(b))
    #|  out
    #|}
    #|pub fn sb_len_and_closure() -> Int {
    #|  let sb = StringBuilder()
    #|  sb.write_string("abc")
    #|  let f = fn(x : Int) -> String {
    #|    if x > 0 {
    #|      return "yes"
    #|    }
    #|    "no"
    #|  }
    #|  sb.length() + f(1).length()
    #|}
  let cr = check_source_files_full("p19b_cg", ["p19b_cg.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // 24B header layout
  assert_true(ssa.contains("_hdr, 24"), ssa)
  assert_true(!ssa.contains("_hdr, 32"), ssa)
  // Null-niche Option[String] in lookup: no pion_alloc_uninit, returns 0 on None
  let lk_s = p18_find_from(ssa, "$pion_fn_lookup(", 0)
  let lk_e = p18_find_from(ssa, "\n}", lk_s)
  assert_true(lk_s >= 0 && lk_e > lk_s, ssa)
  let lk_alloc = p18_find_from(ssa, "$pion_alloc_uninit", lk_s)
  assert_true(lk_alloc < 0 || lk_alloc > lk_e, ssa)
  let lk_ret0 = p18_find_from(ssa, "ret 0", lk_s)
  assert_true(lk_ret0 > lk_s && lk_ret0 < lk_e, ssa)
  // Nested Option[Option[String]] uses boxed outer Option
  assert_true(ssa.contains("$pion_drop_opt_obj"), ssa)
  // Bool enum static immortal singletons
  assert_true(ssa.contains("_VBool_1_hdr"), ssa)
  assert_true(ssa.contains("_VBool_0_hdr"), ssa)
  // N-way string concat flattened to pion_str_concat_n
  assert_true(ssa.contains("$pion_str_concat_n("), ssa)
  // Struct String field BCE versioning in scan_quote
  let sq_s = p18_find_from(ssa, "$pion_fn_scan_quote(", 0)
  let sq_e = p18_find_from(ssa, "\n}", sq_s)
  let sq_fast = p18_find_from(ssa, "@wh_fast", sq_s)
  assert_true(sq_fast > sq_s && sq_fast < sq_e, ssa)
  // Local-only array push skips adopt_fz
  let mb_s = p18_find_from(ssa, "$pion_fn_mk_bools(", 0)
  let mb_e = p18_find_from(ssa, "\n}", mb_s)
  let mb_adopt = p18_find_from(ssa, "adopt_fz", mb_s)
  assert_true(mb_adopt < 0 || mb_adopt > mb_e, ssa)
}

///|
test "p19b: soundness fixes (arr_field UAF, loop unfrozen_local_arrs escape, leading None array lit, generic struct Option mono)" {
  let src =
    #|pub struct Pair {
    #|  key : String
    #|  value : String
    #|}
    #|pub struct OptBox[T] {
    #|  item : Option[T]
    #|}
    #|fn evil(k : String, a : Array[Pair]) -> Int {
    #|  let _ = a.pop()
    #|  k.length()
    #|}
    #|pub fn call_evil(a : Array[Pair]) -> Int {
    #|  evil(a[0].key, a)
    #|}
    #|pub fn obj_get_fast(entries : Array[Pair], k : String) -> Option[String] {
    #|  let n = entries.length()
    #|  let mut i = 0
    #|  while i < n {
    #|    if entries[i].key == k {
    #|      return Some(entries[i].value)
    #|    }
    #|    i = i + 1
    #|  }
    #|  None
    #|}
    #|pub fn loop_escape_push() -> Int {
    #|  let a : Array[String] = []
    #|  let mut i = 0
    #|  while i < 2 {
    #|    a.push("x" + i.to_string())
    #|    if i == 0 {
    #|      let _ = Mutex::new(a)
    #|    }
    #|    i = i + 1
    #|  }
    #|  a.length()
    #|}
    #|pub fn leading_none_arr() -> Int {
    #|  let a = [None, Some("ok")]
    #|  match a[0] {
    #|    None => 1
    #|    Some(_) => 0
    #|  }
    #|}
    #|pub fn is_set[T](b : OptBox[T]) -> Bool {
    #|  match b.item {
    #|    Some(_) => true
    #|    None => false
    #|  }
    #|}
    #|pub fn test_box() -> Int {
    #|  let b1 : OptBox[String] = OptBox::{ item: None }
    #|  let b2 : OptBox[String] = OptBox::{ item: Some("hi") }
    #|  let c1 = if is_set(b1) { 10 } else { 1 }
    #|  let c2 = if is_set(b2) { 2 } else { 20 }
    #|  c1 + c2
    #|}
    #|pub enum Color {
    #|  Red
    #|  Green
    #|}
    #|pub fn eq_borrowed_obj(a : Color, b : Color) -> Bool {
    #|  let eq = a == b
    #|  eq
    #|}
  let cr = check_source_files_full("p19b_snd", ["p19b_snd.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // 1. call_evil must NOT borrow a[0].key (must rc_inc before calling evil)
  let ce_s = p18_find_from(ssa, "$pion_fn_call_evil(", 0)
  let ce_e = p18_find_from(ssa, "\n}", ce_s)
  let ce_rc = p18_find_from(ssa, "$pion_rc_inc", ce_s)
  assert_true(ce_s >= 0 && ce_rc > ce_s && ce_rc < ce_e, ssa)
  // 2. obj_get_fast comparison `entries[i].key == k` still borrows with zero RC before $pion_str_eq
  let og_s = p18_find_from(ssa, "$pion_fn_obj_get_fast(", 0)
  let og_eq = p18_find_from(ssa, "$pion_str_eq(", og_s)
  let og_rc_before_eq = p18_find_from(ssa, "$pion_rc_inc", og_s)
  assert_true(og_s >= 0 && og_eq > og_s, ssa)
  assert_true(og_rc_before_eq < 0 || og_rc_before_eq > og_eq, ssa)
  // 3. loop_escape_push MUST keep adopt_fz because Mutex(a) escapes a inside while
  let le_s = p18_find_from(ssa, "$pion_fn_loop_escape_push(", 0)
  let le_e = p18_find_from(ssa, "\n}", le_s)
  let le_adopt = p18_find_from(ssa, "adopt_fz", le_s)
  assert_true(le_s >= 0 && le_adopt > le_s && le_adopt < le_e, ssa)
  // 4. leading_none_arr must normalize element 0 via opt_zn to null niche 0
  let ln_s = p18_find_from(ssa, "$pion_fn_leading_none_arr(", 0)
  let ln_e = p18_find_from(ssa, "\n}", ln_s)
  let ln_zn = p18_find_from(ssa, "@opt_zn", ln_s)
  let ln_push0 = p18_find_from(ssa, "$pion_arr_push_owned(", ln_s)
  assert_true(ln_s >= 0 && ln_zn > ln_s && ln_zn < ln_push0 && ln_push0 < ln_e, ssa)
  // 5. is_set[T](b : OptBox[T]) must be monomorphized for String
  assert_true(ssa.contains("$pion_fn_is_set__mono_"), ssa)
  // 6. eq_borrowed_obj must NOT rc_dec borrowed operands in fallback ==
  let eq_s = p18_find_from(ssa, "$pion_fn_eq_borrowed_obj(", 0)
  let eq_e = p18_find_from(ssa, "\n}", eq_s)
  let eq_dec = p18_find_from(ssa, "$pion_rc_dec", eq_s)
  assert_true(eq_s >= 0 && (eq_dec < 0 || eq_dec > eq_e), ssa)
}

///|
/// Index of `needle` in `hay` at or after `from`, or -1.
fn p18_find_from(hay : String, needle : String, from : Int) -> Int {
  let n = needle.length()
  let mut i = if from < 0 { 0 } else { from }
  while i + n <= hay.length() {
    let mut j = 0
    while j < n && str_code_at(hay, i + j) == str_code_at(needle, j) {
      j = j + 1
    }
    if j == n {
      return i
    }
    i = i + 1
  }
  -1
}

///|
test "p20a: dyn Trait emits fat-pointer vtable, thunks, drop_dyn, and niche Option" {
  let src =
    #|pub trait Describe {
    #|  describe(self : Self) -> String
    #|  score(self : Self, bonus : Int) -> Int
    #|}
    #|pub struct Dog {
    #|  name : String
    #|}
    #|impl Describe for Dog {
    #|  fn describe(self : Dog) -> String {
    #|    "dog:" + self.name
    #|  }
    #|  fn score(self : Dog, bonus : Int) -> Int {
    #|    self.name.length() + bonus
    #|  }
    #|}
    #|impl Describe for Int {
    #|  fn describe(self : Int) -> String {
    #|    "int:" + self.to_string()
    #|  }
    #|  fn score(self : Int, bonus : Int) -> Int {
    #|    self + bonus
    #|  }
    #|}
    #|pub fn render(x : dyn Describe) -> String {
    #|  x.describe() + ":" + x.score(2).to_string()
    #|}
    #|pub fn main() -> Int {
    #|  let xs : Array[dyn Describe] = [Dog::{ name: "rex" }, 40]
    #|  let opt : Option[dyn Describe] = Some(Dog::{ name: "max" })
    #|  let _ = match opt {
    #|    Some(v) => render(v)
    #|    None => ""
    #|  }
    #|  render(xs[0]).length() + render(xs[1]).length()
    #|}
  let cr = check_source_files_full("p20a_dyn", ["p20a_dyn.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  assert_true(ssa.contains("function $pion_drop_dyn("), ssa)
  assert_true(ssa.contains("data $pion_vtable_Describe__Dog = align 8 { l 1,"), ssa)
  assert_true(ssa.contains("data $pion_vtable_Describe__Int = align 8 { l 0, l 0,"), ssa)
  assert_true(ssa.contains("$pion_dyn_wrap_Describe__Dog__describe("), ssa)
  assert_true(ssa.contains("$pion_dyn_wrap_Describe__Int__score("), ssa)
  // Niche Option[dyn Describe] must NOT box Option with $pion_drop_opt_obj
  assert_true(!ssa.contains("$pion_drop_opt_obj"), ssa)
}

///|
test "p24a_five_bug_fixes" {
  // Bug 1, 2, 3, 4 (local), 5 (test block return)
  let src =
    #|let CONST_ARR : Array[String] = ["a", "b"]
    #|fn inc(x : Int) -> Int {
    #|  x + 1
    #|}
    #|fn apply(f : (Int) -> Int, v : Int) -> Int {
    #|  f(v)
    #|}
    #|pub fn clone_arr[T](xs : Array[T]) -> Array[T] {
    #|  let out : Array[T] = []
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    out.push(xs[i])
    #|    i = i + 1
    #|  }
    #|  out
    #|}
    #|pub fn empty_branch(cond : Bool, k : Int) -> Int {
    #|  let xs = if cond { [] } else { ["a", "b"] }
    #|  xs.push("c")
    #|  let ys = match k {
    #|    0 => []
    #|    _ => ["x", "y"]
    #|  }
    #|  ys.push("z")
    #|  xs.length() + ys.length() + apply(inc, CONST_ARR.length())
    #|}
    #|test "early return in match" {
    #|  let res : Result[Int, String] = Err("boom")
    #|  let x = match res {
    #|    Ok(v) => v
    #|    Err(_) => {
    #|      return
    #|    }
    #|  }
    #|  debug_assert(x == 0, "unreachable")
    #|}
  let cr = check_source_files_full("p24a_cg", ["p24a_cg.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // Bug 1: init_consts immortalizes module-level heap constants
  assert_true(ssa.contains("call $pion_rc_immortalize("), ssa)
  // Bug 2: empty_branch emits pion_arr_new(l 0, w 1) for empty [] branch (never w 0)
  let eb_s = p18_find_from(ssa, "$pion_fn_empty_branch(", 0)
  let eb_e = p18_find_from(ssa, "\n}", eb_s)
  assert_true(eb_s >= 0 && eb_e > eb_s, ssa)
  let eb_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", eb_s)
  assert_true(eb_new0 < 0 || eb_new0 > eb_e, ssa)
  let eb_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", eb_s)
  assert_true(eb_new1 > eb_s && eb_new1 < eb_e, ssa)
  // Bug 3: generic clone_arr[T] passes runtime %tp_T flag (truncated to w) to pion_arr_new
  let ca_s = p18_find_from(ssa, "$pion_fn_clone_arr(", 0)
  let ca_e = p18_find_from(ssa, "\n}", ca_s)
  assert_true(ca_s >= 0 && ca_e > ca_s, ssa)
  let ca_tpw = p18_find_from(ssa, "=w copy %tp_T", ca_s)
  assert_true(ca_tpw > ca_s && ca_tpw < ca_e, ssa)
  // Bug 5: test runner emits bare `ret` (not `ret 0`) inside void $pion_test_fn_0
  let tssa = emit_qbe_test_package(cr.pkg, cr.tc, []).ssa
  let tf_s = p18_find_from(tssa, "function $pion_test_fn_0()", 0)
  let tf_e = p18_find_from(tssa, "\n}", tf_s)
  assert_true(tf_s >= 0 && tf_e > tf_s, tssa)
  let tf_ret0 = p18_find_from(tssa, "ret 0", tf_s)
  assert_true(tf_ret0 < 0 || tf_ret0 > tf_e, tssa)
}

///|
test "p24a_bug6_generic_drop_fn" {
  let src =
    #|pub struct Box[T] {
    #|  item : T
    #|}
    #|pub enum Wrap[T] {
    #|  WVal(T)
    #|  WEmpty
    #|}
    #|pub fn wrap_ok[T](v : T) -> Result[T, String] {
    #|  Ok(v)
    #|}
    #|pub fn wrap_err[E](e : E) -> Result[Int, E] {
    #|  Err(e)
    #|}
    #|pub fn wrap_some[T](v : T) -> Option[T] {
    #|  Some(v)
    #|}
    #|pub fn wrap_box[T](v : T) -> Box[T] {
    #|  Box::{ item: v }
    #|}
    #|pub fn wrap_enum[T](v : T) -> Wrap[T] {
    #|  WVal(v)
    #|}
    #|pub fn wrap_pair[T](v : T) -> (T, Int) {
    #|  (v, 1)
    #|}
  let cr = check_source_files_full("p24a_b6", ["p24a_b6.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // wrap_ok[T]: selects $pion_drop_res_ok dynamically on %tp_T
  let wok_s = p18_find_from(ssa, "$pion_fn_wrap_ok(", 0)
  let wok_e = p18_find_from(ssa, "\n}", wok_s)
  assert_true(wok_s >= 0 && wok_e > wok_s, ssa)
  let wok_jnz = p18_find_from(ssa, "jnz %tp_T,", wok_s)
  assert_true(wok_jnz > wok_s && wok_jnz < wok_e, ssa)
  let wok_dp = p18_find_from(ssa, "$pion_drop_res_ok", wok_s)
  assert_true(wok_dp > wok_s && wok_dp < wok_e, ssa)
  // wrap_err[E]: selects $pion_drop_res_err dynamically on %tp_E
  let werr_s = p18_find_from(ssa, "$pion_fn_wrap_err(", 0)
  let werr_e = p18_find_from(ssa, "\n}", werr_s)
  assert_true(werr_s >= 0 && werr_e > werr_s, ssa)
  let werr_dp = p18_find_from(ssa, "$pion_drop_res_err", werr_s)
  assert_true(werr_dp > werr_s && werr_dp < werr_e, ssa)
  // wrap_some[T]: selects $pion_drop_opt_obj dynamically on %tp_T
  let ws_s = p18_find_from(ssa, "$pion_fn_wrap_some(", 0)
  let ws_e = p18_find_from(ssa, "\n}", ws_s)
  assert_true(ws_s >= 0 && ws_e > ws_s, ssa)
  let ws_dp = p18_find_from(ssa, "$pion_drop_opt_obj", ws_s)
  assert_true(ws_dp > ws_s && ws_dp < ws_e, ssa)
  // wrap_box[T], wrap_enum[T], wrap_pair[T]: select slot drop dynamically on %tp_T
  let wb_s = p18_find_from(ssa, "$pion_fn_wrap_box(", 0)
  let wb_e = p18_find_from(ssa, "\n}", wb_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_1", wb_s) < wb_e, ssa)
  let we_s = p18_find_from(ssa, "$pion_fn_wrap_enum(", 0)
  let we_e = p18_find_from(ssa, "\n}", we_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_2", we_s) < we_e, ssa)
  let wp_s = p18_find_from(ssa, "$pion_fn_wrap_pair(", 0)
  let wp_e = p18_find_from(ssa, "\n}", wp_s)
  assert_true(p18_find_from(ssa, "$pion_drop_slots_1", wp_s) < wp_e, ssa)
}

///|
test "p24a_probe_shadowing" {
  let src =
    #|pub enum MyVal {
    #|  MArr(Array[String])
    #|  MEmpty
    #|}
    #|pub fn shadow_match(x : MyVal) -> Int {
    #|  let out = match x {
    #|    MyVal::MArr(x) => x
    #|    _ => []
    #|  }
    #|  out.push("k")
    #|  let out2 = match x {
    #|    MyVal::MEmpty => []
    #|    MyVal::MArr(x) => x
    #|  }
    #|  out2.push("v")
    #|  out.length() + out2.length()
    #|}
    #|pub fn shadow_block(cond : Bool) -> Int {
    #|  let x = 123
    #|  let out = if cond {
    #|    []
    #|  } else {
    #|    let x : Array[String] = ["hi"]
    #|    x
    #|  }
    #|  out.push("there")
    #|  x + out.length()
    #|}
  let cr = check_source_files_full("p24a_sh", ["p24a_sh.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  // shadow_match: both empty [] arms must emit pion_arr_new(l 0, w 1), never w 0
  let sm_s = p18_find_from(ssa, "$pion_fn_shadow_match(", 0)
  let sm_e = p18_find_from(ssa, "\n}", sm_s)
  assert_true(sm_s >= 0 && sm_e > sm_s, ssa)
  let sm_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", sm_s)
  assert_true(sm_new0 < 0 || sm_new0 > sm_e, ssa)
  let sm_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", sm_s)
  assert_true(sm_new1 > sm_s && sm_new1 < sm_e, ssa)
  // shadow_block: if cond { [] } else { let x : Array[String] = ["hi"]; x } emits w 1
  let sb_s = p18_find_from(ssa, "$pion_fn_shadow_block(", 0)
  let sb_e = p18_find_from(ssa, "\n}", sb_s)
  assert_true(sb_s >= 0 && sb_e > sb_s, ssa)
  let sb_new0 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 0)", sb_s)
  assert_true(sb_new0 < 0 || sb_new0 > sb_e, ssa)
  let sb_new1 = p18_find_from(ssa, "call $pion_arr_new(l 0, w 1)", sb_s)
  assert_true(sb_new1 > sb_s && sb_new1 < sb_e, ssa)
}

///|
test "p25a_extern_c_varargs_qbe_ir" {
  let src =
    #|extern "C" fn sq3_config_i(op : Int, ..., v : Int) -> Int = "sqlite3_config"
    #|extern "C" fn c_snprintf_iid(buf : Ptr, cap : Int64, fmt : Ptr, ..., a : Int, b : Int, c : Double) -> Int = "snprintf"
    #|extern "C" fn c_snprintf_0(buf : Ptr, cap : Int64, fmt : Ptr, ...) -> Int = "snprintf"
    #|pub fn test_va(buf : Ptr, fmt : Ptr) -> Int {
    #|  let r1 = sq3_config_i(9, 0)
    #|  let r2 = c_snprintf_iid(buf, 128L, fmt, 42, -7, 3.25)
    #|  let r3 = c_snprintf_0(buf, 128L, fmt)
    #|  r1 + r2 + r3
    #|}
  let cr = check_source_files_full("p25a_va_qbe", ["p25a_va_qbe.pion"], [
    src,
  ])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(p18_find_from(ssa, "call $sqlite3_config(w ", 0) >= 0, ssa)
  let sq_pos = p18_find_from(ssa, "call $sqlite3_config(", 0)
  let sq_end = p18_find_from(ssa, "\n", sq_pos)
  let va_sq = p18_find_from(ssa, ", ..., w ", sq_pos)
  assert_true(va_sq > sq_pos && va_sq < sq_end, ssa)

  let sn_pos = p18_find_from(ssa, "call $snprintf(l ", 0)
  let sn_end = p18_find_from(ssa, "\n", sn_pos)
  let va_sn = p18_find_from(ssa, ", ..., w ", sn_pos)
  let d_sn = p18_find_from(ssa, ", d ", va_sn)
  assert_true(va_sn > sn_pos && va_sn < sn_end && d_sn > va_sn && d_sn < sn_end, ssa)

  let sn0_pos = p18_find_from(ssa, "call $snprintf(l ", sn_end)
  let sn0_end = p18_find_from(ssa, "\n", sn0_pos)
  let va_sn0 = p18_find_from(ssa, ", ...)", sn0_pos)
  assert_true(va_sn0 > sn0_pos && va_sn0 < sn0_end, ssa)
}

///|
test "p26b_extern_c_body_c_fn_ptr_zero_copy_math_sb_qbe_ir" {
  let src =
    #|pub extern "C" fn cb_add(a : Int, b : Int) -> Int = "my_cb_add" {
    #|  a + b
    #|}
    #|extern "C" fn cb_void(p : Ptr, x : Int) -> Unit {
    #|  ptr_write_i32(p, 0L, x)
    #|}
    #|pub fn test_p26b(s : String, bs : Bytes, arr : Array[Double], p : Ptr) -> Double {
    #|  let _f1 = c_fn_ptr(cb_add)
    #|  let _f2 = c_fn_ptr(cb_void)
    #|  let _sp = str_data_ptr(s)
    #|  let _bp = bytes_data_ptr(bs)
    #|  let _ap = array_data_ptr(arr)
    #|  ptr_write_f64(p, 0L, 1.5)
    #|  ptr_write_f32(p, 8L, 2.25)
    #|  let v = ptr_read_f64(p, 0L) + ptr_read_f32(p, 8L)
    #|  let sb = StringBuilder()
    #|  sb.write_byte(b'A')
    #|  sb.write_bytes(bs)
    #|  v + math_tan(0.5) + math_asin(0.5) + math_acos(0.5) + math_atan(0.5) +
    #|    math_atan2(1.0, 2.0) + math_exp(1.0) + math_log(2.0) + math_round(1.6) + math_trunc(1.6)
    #|}
  let cr = check_source_files_full("p26b_qbe", ["p26b_qbe.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, false).ssa
  assert_true(ssa.contains("export function w $my_cb_add(w %p0, w %p1)"), ssa)
  assert_true(ssa.contains("export function $cb_void(l %p0, w %p1)"), ssa)
  assert_true(ssa.contains("=l copy $my_cb_add"), ssa)
  assert_true(ssa.contains("=l copy $cb_void"), ssa)
  assert_true(ssa.contains("=s loads "), ssa)
  assert_true(ssa.contains("=d exts "), ssa)
  assert_true(ssa.contains("=s truncd "), ssa)
  assert_true(ssa.contains("stores "), ssa)
  assert_true(ssa.contains("call $tan("), ssa)
  assert_true(ssa.contains("call $asin("), ssa)
  assert_true(ssa.contains("call $acos("), ssa)
  assert_true(ssa.contains("call $atan("), ssa)
  assert_true(ssa.contains("call $atan2("), ssa)
  assert_true(ssa.contains("call $exp("), ssa)
  assert_true(ssa.contains("call $log("), ssa)
  assert_true(ssa.contains("call $round("), ssa)
  assert_true(ssa.contains("call $trunc("), ssa)
  assert_true(ssa.contains("call $pion_strbuf_push_byte("), ssa)
}

///|
test "p26b_generic_method_option_mono_and_cross_pkg_export_internals" {
  let lib_src =
    #|let MASK : Int = 15
    #|fn hash_int(k : Int) -> Int {
    #|  (k * 31) & MASK
    #|}
    #|pub struct Wrap[V] {
    #|  mut inner : Option[V]
    #|}
    #|pub fn Wrap::new[V]() -> Wrap[V] {
    #|  Wrap::{ inner: None }
    #|}
    #|pub fn Wrap::set[V](self : Wrap[V], v : V) -> Unit {
    #|  let _h = hash_int(1)
    #|  self.inner = Some(v)
    #|}
    #|pub fn Wrap::get[V](self : Wrap[V]) -> Option[V] {
    #|  self.inner
    #|}
  let lib_cr = check_source_files_with_imports("wlib", ["wlib.pion"], [lib_src], [], true)
  assert_true(
    lib_cr.diagnostics.length() == 0,
    check_result_to_json(lib_cr.diagnostics),
  )
  // Upstream package with pub generic fn skips .pionstub and exports private helpers/consts
  assert_eq(emit_pion_stub(lib_cr.pkg), "")
  let lib_ssa = emit_qbe_package_multi(lib_cr.pkg, lib_cr.tc, false, false, []).ssa
  assert_true(lib_ssa.contains("export function w $pion_pkg_wlib_fn_hash_int("), lib_ssa)
  assert_true(lib_ssa.contains("export data $pion_pkg_wlib_const_MASK"), lib_ssa)

  let app_src =
    #|import "wlib"
    #|pub fn run_wrap() -> Int {
    #|  let ws : wlib::Wrap[String] = wlib::Wrap::new()
    #|  ws.set("hi")
    #|  let wi : wlib::Wrap[Int] = wlib::Wrap::new()
    #|  wi.set(42)
    #|  match (ws.get(), wi.get()) {
    #|    (Some(s), Some(n)) => s.length() + n
    #|    _ => 0
    #|  }
    #|}
  let imported = [imported_pkg_new("wlib", lib_cr.tc)]
  let app_cr = check_source_files_with_imports("app", ["main.pion"], [app_src], imported, true)
  assert_true(
    app_cr.diagnostics.length() == 0,
    check_result_to_json(app_cr.diagnostics),
  )
  let app_ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, false, false, ["wlib"]).ssa
  assert_true(app_ssa.contains("__mono_String("), app_ssa)
  assert_true(app_ssa.contains("__mono_Int("), app_ssa)
}

///|
test "p27a_bug4_tuple_niche_and_numeric_qbe_ir" {
  let src =
    #|struct Node { id : Int }
    #|pub fn mk_none(n : Node) -> (Node, Option[Node]) {
    #|  (n, None)
    #|}
    #|pub fn num_ops(a : Int, b : Int64, d : Double) -> Double {
    #|  let x = a.to_double() + b.to_double()
    #|  let bits = d.to_bits()
    #|  let d2 = Double::from_bits(bits)
    #|  let _k = d2.to_int64() + a.abs().to_int64() + b.abs()
    #|  x + d2.sqrt() + d2.round() + d2.trunc()
    #|}
    #|pub fn map_clr(m : Map[String, Int]) -> Unit {
    #|  m.clear()
    #|}
  let cr = check_source_files_with_imports("p27a", ["main.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, []).ssa
  // Bug #4: `(n, None)` for `(Node, Option[Node])` must store null-niche 0, never $pion_none_hdr
  assert_true(!ssa.contains("$pion_none_hdr"), "expected null-niche 0 for (Node, Option[Node]), got $pion_none_hdr:\n" + ssa)
  // Zero-byte numeric IR instructions
  assert_true(ssa.contains("=d swtof "), ssa)
  assert_true(ssa.contains("=d sltof "), ssa)
  assert_true(ssa.contains("=l cast "), ssa)
  assert_true(ssa.contains("=d cast "), ssa)
  assert_true(ssa.contains("=l dtosi "), ssa)
  assert_true(ssa.contains("=d sqrt "), ssa)
  assert_true(ssa.contains("call $round("), ssa)
  assert_true(ssa.contains("call $trunc("), ssa)
  assert_true(ssa.contains("call $pion_map_clear("), ssa)
}

