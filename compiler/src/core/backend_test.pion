///|
test "p82e_generic_wrapper_intmap_mono_vmap" {
  let src =
    #|pub struct IntMap[V] {
    #|  inner : Map[Int, V],
    #|}
    #|
    #|pub fn IntMap::new[V]() -> IntMap[V] {
    #|  IntMap::{ inner: Map::new() }
    #|}
    #|
    #|pub fn IntMap::set[V](self : IntMap[V], key : Int, value : V) -> Unit {
    #|  self.inner.set(key, value)
    #|}
    #|
    #|pub fn IntMap::clear[V](self : IntMap[V]) -> Unit {
    #|  self.inner.clear()
    #|}
    #|
    #|pub fn IntMap::keys[V](self : IntMap[V]) -> Array[Int] {
    #|  self.inner.keys()
    #|}
    #|
    #|pub fn get[V](m : IntMap[V], key : Int) -> Option[V] {
    #|  m.inner.get(key)
    #|}
    #|
    #|pub fn remove[V](m : IntMap[V], key : Int) -> Option[V] {
    #|  let prev = m.inner.get(key)
    #|  m.inner.remove(key)
    #|  prev
    #|}
    #|
    #|pub fn main() -> Int {
    #|  let mi : IntMap[Int] = IntMap::new()
    #|  mi.set(1, 42)
    #|  let _gi = get(mi, 1)
    #|  let _ri = remove(mi, 1)
    #|  let _ki = mi.keys()
    #|  mi.clear()
    #|
    #|  let ms : IntMap[String] = IntMap::new()
    #|  ms.set(2, "hi")
    #|  let _gs = get(ms, 2)
    #|  let _rs = remove(ms, 2)
    #|  let _ks = ms.keys()
    #|  ms.clear()
    #|
    #|  let mb : IntMap[Bool] = IntMap::new()
    #|  mb.set(3, true)
    #|  let _gb = get(mb, 3)
    #|  let _rb = remove(mb, 3)
    #|  let _kb = mb.keys()
    #|  mb.clear()
    #|  0
    #|}
  let cr = check_source_files_with_imports("p82e", ["p82e.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // Concrete monomorphized vmap symbols must be generated for all 3 value types
  assert_true(ssa.contains("$pion_vmap_new_pkg_p82e_vm_Int_Int"), ssa)
  assert_true(ssa.contains("$pion_vmap_set_pkg_p82e_vm_Int_Int"), ssa)
  assert_true(ssa.contains("$pion_vmap_drop_pkg_p82e_vm_Int_Int"), ssa)
  assert_true(ssa.contains("$pion_vmap_new_pkg_p82e_vm_Int_String"), ssa)
  assert_true(ssa.contains("$pion_vmap_set_pkg_p82e_vm_Int_String"), ssa)
  assert_true(ssa.contains("$pion_vmap_drop_pkg_p82e_vm_Int_String"), ssa)
  assert_true(ssa.contains("$pion_vmap_new_pkg_p82e_vm_Int_Bool"), ssa)
  assert_true(ssa.contains("$pion_vmap_set_pkg_p82e_vm_Int_Bool"), ssa)
  assert_true(ssa.contains("$pion_vmap_drop_pkg_p82e_vm_Int_Bool"), ssa)
  // Every call from main must target a concrete __mono_* specialization, never the erased wrapper
  let funcs = ssa.split("function ")
  let mut main_fn = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("$pion_pkg_p82e_fn_main(") {
      main_fn = funcs[fi]
    }
    if funcs[fi].contains("__mono_") {
      assert_true(!funcs[fi].contains("vm_Int_V"), funcs[fi])
    }
    fi = fi + 1
  }
  assert_true(main_fn != "", ssa)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__new__mono_Int("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__set__mono_Int("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__keys__mono_Int("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__clear__mono_Int("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__new__mono_String("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__set__mono_String("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__new__mono_Bool("), main_fn)
  assert_true(main_fn.contains("$pion_pkg_p82e_m_IntMap__set__mono_Bool("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_m_IntMap__new("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_m_IntMap__set("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_m_IntMap__keys("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_m_IntMap__clear("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_fn_get("), main_fn)
  assert_true(!main_fn.contains("$pion_pkg_p82e_fn_remove("), main_fn)
}

///|
test "p85_ror_bitops_ssa_and_idiom_audit" {
  let src =
    #|pub fn rot_u32_or(x : UInt) -> UInt { (x << 7) | (x >> 25) }
    #|pub fn rot_u32_xor(x : UInt) -> UInt { (x >> 13) ^ (x << 19) }
    #|pub fn rot_u32_add(x : UInt) -> UInt { (x << 5) + (x >> 27) }
    #|pub fn rot_u64_var(x : UInt64, k : Int) -> UInt64 { (x >> k) | (x << (64 - k)) }
    #|pub fn rot_methods_const(x : UInt, y : UInt64) -> UInt64 {
    #|  let a = x.rotate_right(0)
    #|  let b = a.rotate_right(32)
    #|  let c = b.rotate_right(1)
    #|  let d = c.rotate_right(31)
    #|  let e = d.rotate_right(40)
    #|  let f = e.rotate_right(-1)
    #|  let g = y.rotate_left(13)
    #|  g ^ f.to_uint64()
    #|}
    #|#verify
    #|pub fn rot_verify_no_idiom(x : UInt) -> UInt { (x << 7) | (x >> 25) }
    #|pub fn main() -> Int { 0 }
  let cr = check_source_files_with_imports("p85", ["p85.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut fn_or = ""
  let mut fn_xor = ""
  let mut fn_add = ""
  let mut fn_var = ""
  let mut fn_const = ""
  let mut fn_verify = ""
  let mut i = 0
  while i < funcs.length() {
    let f = funcs[i]
    if f.contains("$pion_pkg_p85_fn_rot_u32_or(") { fn_or = f }
    if f.contains("$pion_pkg_p85_fn_rot_u32_xor(") { fn_xor = f }
    if f.contains("$pion_pkg_p85_fn_rot_u32_add(") { fn_add = f }
    if f.contains("$pion_pkg_p85_fn_rot_u64_var(") { fn_var = f }
    if f.contains("$pion_pkg_p85_fn_rot_methods_const(") { fn_const = f }
    if f.contains("$pion_pkg_p85_fn_rot_verify_no_idiom(") { fn_verify = f }
    i = i + 1
  }
  // Idiom recognition: |, ^, + with constant complement -> single `=w ror`
  assert_true(fn_or.contains("=w ror ") && fn_or.contains(", 25"), fn_or)
  assert_true(!fn_or.contains("=w shl ") && !fn_or.contains("=w shr "), fn_or)
  assert_true(fn_xor.contains("=w ror ") && fn_xor.contains(", 13"), fn_xor)
  assert_true(fn_add.contains("=w ror ") && fn_add.contains(", 27"), fn_add)
  // Variable-count idiom on UInt64 -> single `=l ror`
  assert_true(fn_var.contains("=l ror "), fn_var)
  assert_true(!fn_var.contains("=l shl ") && !fn_var.contains("=l shr "), fn_var)
  // Constant folding boundary cases: k=0/32 folded to identity; k=1,31,40->8,-1->31; rotate_left(13) -> ror 51
  assert_true(fn_const.contains("=w ror ") && fn_const.contains(", 1"), fn_const)
  assert_true(fn_const.contains(", 31"), fn_const)
  assert_true(fn_const.contains(", 8"), fn_const)
  assert_true(fn_const.contains("=l ror ") && fn_const.contains(", 51"), fn_const)
  assert_true(!fn_const.contains(", 0\n") && !fn_const.contains(", 32\n") && !fn_const.contains(", 40\n") && !fn_const.contains(", -1\n"), fn_const)
  // #verify must NOT fold the rotate idiom into ror
  assert_true(!fn_verify.contains(" ror "), fn_verify)
}

///|
test "p85: pure-scalar small enum SROA in Result[Enum, String] + let r = call(); match r" {
  let src =
    #|pub enum DecodeStatus {
    #|  Incomplete
    #|  Complete(Bool, Int)
    #|}
    #|
    #|fn decode(tag : Int, ok : Bool, n : Int) -> Result[DecodeStatus, String] {
    #|  if tag < 0 {
    #|    return Err("bad_tag_" + tag.to_string())
    #|  }
    #|  if tag == 0 {
    #|    return Ok(DecodeStatus::Incomplete)
    #|  }
    #|  Ok(DecodeStatus::Complete(ok, n))
    #|}
    #|
    #|pub fn hot_nested_match(tag : Int, ok : Bool, n : Int) -> Int {
    #|  match decode(tag, ok, n) {
    #|    Ok(DecodeStatus::Complete(flag, k)) => if flag { k + 1 } else { k }
    #|    Ok(DecodeStatus::Incomplete) => -1
    #|    Err(_) => -2
    #|  }
    #|}
    #|
    #|pub fn hot_two_step_match(tag : Int, ok : Bool, n : Int) -> Int {
    #|  match decode(tag, ok, n) {
    #|    Ok(st) =>
    #|      match st {
    #|        DecodeStatus::Complete(flag, k) => if flag { k + 10 } else { k }
    #|        DecodeStatus::Incomplete => -1
    #|      }
    #|    Err(_) => -2
    #|  }
    #|}
    #|
    #|pub fn hot_try_let_match(tag : Int, ok : Bool, n : Int) -> Result[Int, String] {
    #|  let st = decode(tag, ok, n)?
    #|  match st {
    #|    DecodeStatus::Complete(flag, k) => Ok(if flag { k + 2 } else { k })
    #|    DecodeStatus::Incomplete => Ok(0)
    #|  }
    #|}
    #|
    #|pub fn hot_let_r_match(tag : Int, ok : Bool, n : Int) -> Int {
    #|  let r = decode(tag, ok, n)
    #|  match r {
    #|    Ok(DecodeStatus::Complete(flag, k)) => if flag { k + 3 } else { k }
    #|    Ok(DecodeStatus::Incomplete) => -1
    #|    Err(_) => -2
    #|  }
    #|}
    #|
    #|pub fn escape_return_enum(tag : Int, ok : Bool, n : Int) -> Result[DecodeStatus, String] {
    #|  let st = decode(tag, ok, n)?
    #|  Ok(st)
    #|}
    #|
    #|pub fn escape_array_enum(tag : Int, ok : Bool, n : Int) -> Int {
    #|  let arr : Array[DecodeStatus] = []
    #|  match decode(tag, ok, n) {
    #|    Ok(st) => {
    #|      arr.push(st)
    #|      arr.length()
    #|    }
    #|    Err(_) => 0
    #|  }
    #|}
  let cr = check_source_files_with_imports("p85", ["p85.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut fn_nested = ""
  let mut fn_two = ""
  let mut fn_try = ""
  let mut fn_let_r = ""
  let mut fn_esc_arr = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_p85_fn_hot_nested_match(") {
      fn_nested = f
    } else if f.contains("$pion_pkg_p85_fn_hot_two_step_match(") {
      fn_two = f
    } else if f.contains("$pion_pkg_p85_fn_hot_try_let_match(") {
      fn_try = f
    } else if f.contains("$pion_pkg_p85_fn_hot_let_r_match(") {
      fn_let_r = f
    } else if f.contains("$pion_pkg_p85_fn_escape_array_enum(") {
      fn_esc_arr = f
    }
    fi = fi + 1
  }
  assert_true(fn_nested != "", ssa)
  assert_true(fn_two != "", ssa)
  assert_true(fn_try != "", ssa)
  assert_true(fn_let_r != "", ssa)
  assert_true(fn_esc_arr != "", ssa)
  // Zero heap allocation (no $pion_alloc_uninit) in all 3 non-Result-returning hot paths!
  assert_true(!fn_nested.contains("$pion_alloc_uninit"), fn_nested)
  assert_true(!fn_two.contains("$pion_alloc_uninit"), fn_two)
  assert_true(!fn_let_r.contains("$pion_alloc_uninit"), fn_let_r)
  // `hot_try_let_match` returns `Result[Int, String]` itself, so it allocates only for its own return Result (16B),
  // NOT for `DecodeStatus` (24B / $pion_drop_enum_) — verify immortal stack enum header (`storeh 5,` / `storeh 11,`) is emitted!
  assert_true(fn_nested.contains("storeh 5,"), fn_nested)
  assert_true(fn_nested.contains("storeh 11,"), fn_nested)
  assert_true(fn_try.contains("storeh 5,"), fn_try)
  assert_true(fn_try.contains("storeh 11,"), fn_try)
  assert_true(!fn_try.contains("$pion_drop_enum_"), fn_try)
  assert_true(!fn_try.contains("(w 24, w 5,"), fn_try)
  // Escape case must NOT use immortal stack enum header — must fall back to heap allocation safely!
  assert_true(!fn_esc_arr.contains("storeh 11,"), fn_esc_arr)
}

///|
test "p85 (G3-B R2): let+match return respects closure ABI & TCO, EIf is-binding in enum SROA" {
  let src =
    #|pub enum SmallE {
    #|  Empty
    #|  Val(Int)
    #|}
    #|fn step(n : Int) -> Option[Int] {
    #|  if n > 0 { Some(n - 1) } else { None }
    #|}
    #|pub fn tco_countdown(n : Int, acc : Int) -> Int {
    #|  let r = step(n)
    #|  return match r {
    #|    Some(m) => tco_countdown(m, acc + 1)
    #|    None => acc
    #|  }
    #|}
    #|fn mk_opt_enum(opt : Option[Int]) -> Result[SmallE, String] {
    #|  let n = 91
    #|  Ok(if opt is Some(n) { SmallE::Val(n) } else { SmallE::Empty })
    #|}
    #|pub fn test_is_bind_sroa(opt : Option[Int]) -> Int {
    #|  match mk_opt_enum(opt) {
    #|    Ok(SmallE::Val(v)) => v
    #|    Ok(SmallE::Empty) => -1
    #|    Err(_) => -2
    #|  }
    #|}
    #|pub fn test_closure_ret_abi(x : Int) -> Double {
    #|  let f : (Int) -> Double = fn(k : Int) -> Double {
    #|    let r = step(k)
    #|    return match r {
    #|      Some(_) => 1.5
    #|      None => 2.5
    #|    }
    #|  }
    #|  let g : (Int) -> Unit = fn(k : Int) -> Unit {
    #|    let r = step(k)
    #|    return match r {
    #|      Some(_) => ()
    #|      None => ()
    #|    }
    #|  }
    #|  g(x)
    #|  f(x)
    #|}
    #|pub fn regression_shadow_ctor(flag : Bool) -> Int {
    #|  let e : SmallE = if flag {
    #|    let Empty = SmallE::Val(7)
    #|    Empty
    #|  } else {
    #|    SmallE::Empty
    #|  }
    #|  match e {
    #|    SmallE::Val(v) => v
    #|    SmallE::Empty => -1
    #|  }
    #|}
    #|
  let cr = check_source_files_with_imports("p85", ["p85.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut fn_tco = ""
  let mut fn_is = ""
  let mut fn_sh = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_pkg_p85_fn_tco_countdown(") {
      fn_tco = f
    } else if f.contains("$pion_pkg_p85_fn_test_is_bind_sroa(") {
      fn_is = f
    } else if f.contains("$pion_pkg_p85_fn_regression_shadow_ctor(") {
      fn_sh = f
    }
    fi = fi + 1
  }
  assert_true(fn_tco != "", ssa)
  assert_true(fn_is != "", ssa)
  assert_true(fn_sh != "", ssa)
  // TCO must NOT be bypassed by let+match return fusion: no self-call inside tco_countdown!
  assert_true(!fn_tco.contains("call $pion_pkg_p85_fn_tco_countdown("), fn_tco)
  // EIf with `is` binding still gets POD enum stack SROA with immortal header!
  assert_true(fn_is.contains("storeh 11,"), fn_is)
  // Shadowing unit variant name `let Empty = SmallE::Val(7); Empty` must emit variant-guarded copy (ceql + @cpe_hit_) rather than silent no-op!
  assert_true(fn_sh.contains("=w ceql "), fn_sh)
  assert_true(fn_sh.contains("@cpe_hit_"), fn_sh)
}

///|
test "p85 (G3-A + G4): fresh writable Bytes elides bytes_ro/bytes_oob and sound unsigned BCE" {
  let src =
    #|pub fn fresh_bytes_write() -> Bytes {
    #|  let out = Bytes::new(2)
    #|  out[0] = (1).to_byte()
    #|  out[1] = (0).to_byte()
    #|  out
    #|}
    #|pub fn param_bytes_write(b : Bytes) -> Unit {
    #|  b[0] = (1).to_byte()
    #|}
    #|fn bump_byte(mut x : Byte) -> Unit {
    #|  x = (x.to_int() + 1).to_byte()
    #|}
    #|pub fn param_bytes_mut_wb(b : Bytes) -> Unit {
    #|  let mut b2 = b
    #|  bump_byte(mut b2[0])
    #|}
    #|pub fn bce_positive(x : Int, u : UInt) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  let k = x & 15
    #|  lut[x & 63] + lut[(u >> 24U).to_int()] + lut[(u % 16U).to_int()] + lut[k]
    #|}
    #|pub fn bce_neg_signed_shr(si : Int) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  lut[si >> 24]
    #|}
    #|pub fn bce_neg_signed_mod(si : Int) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  lut[si % 16]
    #|}
    #|pub fn bce_neg_hi_bit_to_int(u : UInt) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  lut[(u & 0x80000000U).to_int()]
    #|}
    #|pub fn bce_neg_shr32(u : UInt) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  lut[(u >> 32U).to_int()]
    #|}
    #|pub fn bce_neg_char(c : Char) -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(256, 7)
    #|  lut[c.to_int()]
    #|}
    #|pub fn bce_neg_eq_len() -> Int {
    #|  let lut : FixedArray[Int] = FixedArray::make(64, 7)
    #|  lut[64]
    #|}
    #|fn shrink_arr(a : Array[Int]) -> Int {
    #|  let _ = a.pop()
    #|  63
    #|}
    #|pub fn bce_neg_alias_shrink() -> Int {
    #|  let arr : Array[Int] = Array::make(64, 1)
    #|  arr[shrink_arr(arr) & 63]
    #|}
  let cr = check_source_files_full("p85", ["p85.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("export function ")
  let mut f_fresh = ""
  let mut f_param_w = ""
  let mut f_param_cw = ""
  let mut f_pos = ""
  let mut f_sshr = ""
  let mut f_smod = ""
  let mut f_hibit = ""
  let mut f_shr32 = ""
  let mut f_char = ""
  let mut f_eqlen = ""
  let mut f_alias = ""
  let mut fi = 0
  while fi < funcs.length() {
    let s = funcs[fi]
    if s.contains("$pion_fn_fresh_bytes_write(") {
      f_fresh = s
    } else if s.contains("$pion_fn_param_bytes_write(") {
      f_param_w = s
    } else if s.contains("$pion_fn_param_bytes_mut_wb(") {
      f_param_cw = s
    } else if s.contains("$pion_fn_bce_positive(") {
      f_pos = s
    } else if s.contains("$pion_fn_bce_neg_signed_shr(") {
      f_sshr = s
    } else if s.contains("$pion_fn_bce_neg_signed_mod(") {
      f_smod = s
    } else if s.contains("$pion_fn_bce_neg_hi_bit_to_int(") {
      f_hibit = s
    } else if s.contains("$pion_fn_bce_neg_shr32(") {
      f_shr32 = s
    } else if s.contains("$pion_fn_bce_neg_char(") {
      f_char = s
    } else if s.contains("$pion_fn_bce_neg_eq_len(") {
      f_eqlen = s
    } else if s.contains("$pion_fn_bce_neg_alias_shrink(") {
      f_alias = s
    }
    fi = fi + 1
  }
  // Positive checks: 0 OOB / 0 RO / 0 panic
  assert_true(f_fresh != "", ssa)
  assert_true(!f_fresh.contains("bytes_oob"), f_fresh)
  assert_true(!f_fresh.contains("bytes_ro"), f_fresh)
  assert_true(!f_fresh.contains("pion_panic"), f_fresh)
  assert_true(f_pos != "", ssa)
  assert_true(!f_pos.contains("arr_oob"), f_pos)
  // Negative checks: MUST retain bytes_ro / arr_oob
  assert_true(f_param_w.contains("bytes_ro"), f_param_w)
  assert_true(f_param_cw.contains("bytes_ro"), f_param_cw)
  assert_true(f_sshr.contains("arr_oob"), f_sshr)
  assert_true(f_smod.contains("arr_oob"), f_smod)
  assert_true(f_hibit.contains("arr_oob"), f_hibit)
  assert_true(f_shr32.contains("arr_oob"), f_shr32)
  assert_true(f_char.contains("arr_oob"), f_char)
  assert_true(f_eqlen.contains("arr_oob"), f_eqlen)
  assert_true(f_alias.contains("arr_oob"), f_alias)
}

///|
test "p85: compact 4-byte Array/FixedArray of Int, UInt, Char SSA audit" {
  let src =
    #|fn sum_i32(a : Array[Int]) -> Int {
    #|  let mut acc = 0
    #|  let mut i = 0
    #|  while i < a.length() {
    #|    a[i] = a[i] + 1
    #|    acc += a[i]
    #|    i += 1
    #|  }
    #|  acc
    #|}
    #|
    #|fn sum_u32(a : FixedArray[UInt]) -> UInt {
    #|  let mut acc = 0U
    #|  let mut i = 0
    #|  while i < a.length() {
    #|    a[i] = a[i] + 1U
    #|    acc = acc + a[i]
    #|    i += 1
    #|  }
    #|  acc
    #|}
    #|
    #|fn sum_char(a : Array[Char]) -> Int {
    #|  let mut acc = 0
    #|  let mut i = 0
    #|  while i < a.length() {
    #|    a[i] = 'Z'
    #|    acc += a[i].to_int()
    #|    i += 1
    #|  }
    #|  acc
    #|}
    #|
    #|pub fn main() -> Int {
    #|  let ai : Array[Int] = [-1, 0, 42]
    #|  let au : FixedArray[UInt] = FixedArray::make(4, 1U)
    #|  let ac : Array[Char] = ['a', 'b']
    #|  sum_i32(ai) + sum_u32(au).to_int() + sum_char(ac)
    #|}
  let cr = check_source_files_with_imports("p85_4b", ["p85.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut f_i32 = ""
  let mut f_u32 = ""
  let mut f_chr = ""
  let mut f_main = ""
  let mut fi = 0
  while fi < funcs.length() {
    if funcs[fi].contains("w $pion_pkg_0L7_p85_u4b_fn_sum_i32(") {
      f_i32 = funcs[fi]
    } else if funcs[fi].contains("w $pion_pkg_0L7_p85_u4b_fn_sum_u32(") {
      f_u32 = funcs[fi]
    } else if funcs[fi].contains("w $pion_pkg_0L7_p85_u4b_fn_sum_char(") {
      f_chr = funcs[fi]
    } else if funcs[fi].contains("w $pion_pkg_0L7_p85_u4b_fn_main(") {
      f_main = funcs[fi]
    }
    fi = fi + 1
  }
  assert_true(f_i32 != "" && f_u32 != "" && f_chr != "" && f_main != "", ssa)
  // elem_flags = 4 on allocation
  assert_true(f_main.contains(", w 4)"), f_main)
  // sum_i32: shl 2, loadsw, storew; no shl 3, no stores
  assert_true(f_i32.contains(", 2\n") && f_i32.contains("shl "), f_i32)
  assert_true(f_i32.contains("loadsw "), f_i32)
  assert_true(f_i32.contains("storew "), f_i32)
  assert_true(!f_i32.contains(", 3\n"), f_i32)
  assert_true(!f_i32.contains("stores "), f_i32)
  // sum_u32: shl 2, loaduw, storew; no shl 3, no stores
  assert_true(f_u32.contains(", 2\n") && f_u32.contains("shl "), f_u32)
  assert_true(f_u32.contains("loaduw "), f_u32)
  assert_true(f_u32.contains("storew "), f_u32)
  assert_true(!f_u32.contains(", 3\n"), f_u32)
  assert_true(!f_u32.contains("stores "), f_u32)
  // sum_char: shl 2, loaduw, storew; no shl 3, no stores
  assert_true(f_chr.contains(", 2\n") && f_chr.contains("shl "), f_chr)
  assert_true(f_chr.contains("loaduw "), f_chr)
  assert_true(f_chr.contains("storew "), f_chr)
  assert_true(!f_chr.contains(", 3\n"), f_chr)
  assert_true(!f_chr.contains("stores "), f_chr)
}

///|
test "p85_r3a_xpkg_const_bce_and_selective_mono" {
  // 1. Cross-package constant `K=1` in lib vs `K=8` in caller must NOT leak K=8 into lib conditional BCE
  let lib_src =
    #|let K : Int = 1
    #|pub fn read_if_k[T](a : FixedArray[T], x : Int, fallback : T) -> T {
    #|  if a.length() >= K {
    #|    a[x & 7]
    #|  } else {
    #|    fallback
    #|  }
    #|}
    #|pub fn make_and_sum[T](x : T) -> Int {
    #|  let arr : Array[T] = [x, x]
    #|  let _ = arr[0]
    #|  arr.length()
    #|}
  let lib_cr = check_source_files_with_imports("r3lib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let imp = [ImportedPkg::{ name: "r3lib", tc: lib_cr.tc }]
  let app_src =
    #|import "r3lib"
    #|let K : Int = 8
    #|pub fn id_scalar[T](x : T) -> T { x }
    #|pub fn relay_arr[T](x : T) -> Int { r3lib::make_and_sum(x) }
    #|pub fn main() -> Int {
    #|  let a : FixedArray[Int] = FixedArray::make(2, 1)
    #|  let r1 = r3lib::read_if_k(a, K, 0)
    #|  let r2 = id_scalar(42)
    #|  let r3 = relay_arr(7)
    #|  r1 + r2 + r3
    #|}
  let app_cr = check_source_files_with_imports("r3app", ["main.pion"], [app_src], imp, true)
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut f_read_k = ""
  let mut f_relay_mono = ""
  let mut f_lib_mono = ""
  let mut has_id_mono = false
  let mut i = 0
  while i < funcs.length() {
    let f = funcs[i]
    if f.contains("$pion_pkg_r3lib_fn_read_if_k__mono_Int(") { f_read_k = f }
    if f.contains("$pion_pkg_r3app_fn_id_scalar__mono_Int(") { has_id_mono = true }
    if f.contains("$pion_pkg_r3app_fn_relay_arr__mono_Int(") { f_relay_mono = f }
    if f.contains("$pion_pkg_r3lib_fn_make_and_sum__mono_Int(") { f_lib_mono = f }
    i = i + 1
  }
  assert_true(f_read_k != "", ssa)
  // Conditional BCE in r3lib::read_if_k must NOT use caller's K=8; bounds check panic must remain!
  assert_true(f_read_k.contains("pion_panic_oob"), f_read_k)
  // Pure scalar generic `id_scalar[T]` with `Int` must share polymorphic impl (no __mono_Int bloat)
  assert_true(!has_id_mono, ssa)
  // Cross-package array-using relay `relay_arr[T]` with `Int` MUST get 4B compact specialization
  assert_true(f_relay_mono != "", ssa)
  assert_true(f_lib_mono != "", ssa)
  assert_true(f_lib_mono.contains(", 2\n") && f_lib_mono.contains("loadsw "), f_lib_mono)
}

///|
test "p85_r4_no_tc_shift_xpkg_const_and_scalar_method_mono" {
  // 1. R4 P1-3 + R5 P1-3: emit_qbe_package(pkg, true) WITHOUT TypeChecker must still emit signed `=w div ` (not udiv)
  let sh_src =
    #|pub fn f(x : UInt, n : Int) -> UInt { x << (1 + (1 / n)) }
    #|pub fn f_byte(x : Byte) -> Byte { x << (256 / 128) }
    #|pub fn main() -> Int { 0 }
  let sh_cr = check_source_files_with_imports("r4sh", ["main.pion"], [sh_src], [], true)
  assert_true(sh_cr.diagnostics.length() == 0, check_result_to_json(sh_cr.diagnostics))
  let ssa_notc = emit_qbe_package(sh_cr.pkg, true).ssa
  let ssa_tc = emit_qbe_package_with_tc(sh_cr.pkg, sh_cr.tc, true).ssa
  let mut fn_notc = ""
  let mut fn_tc = ""
  let mut fb_notc = ""
  let mut fb_tc = ""
  let fs1 = ssa_notc.split("function ")
  let mut i = 0
  while i < fs1.length() {
    if fs1[i].contains("_fn_f(") { fn_notc = fs1[i] }
    if fs1[i].contains("_fn_f_byte(") { fb_notc = fs1[i] }
    i = i + 1
  }
  let fs2 = ssa_tc.split("function ")
  i = 0
  while i < fs2.length() {
    if fs2[i].contains("_fn_f(") { fn_tc = fs2[i] }
    if fs2[i].contains("_fn_f_byte(") { fb_tc = fs2[i] }
    i = i + 1
  }
  assert_true(fn_notc != "" && fn_tc != "" && fb_notc != "" && fb_tc != "", ssa_notc)
  assert_true(fn_notc.contains("=w div ") && !fn_notc.contains("udiv"), fn_notc)
  assert_true(fn_tc.contains("=w div ") && !fn_tc.contains("udiv"), fn_tc)
  assert_true((fb_notc.contains("=w div 256, 128") || fb_notc.contains("=w sar 256, 7")) && !fb_notc.contains("udiv"), fb_notc)
  assert_true((fb_tc.contains("=w div 256, 128") || fb_tc.contains("=w sar 256, 7")) && !fb_tc.contains("udiv"), fb_tc)

  // 2. R4 P1-4 + P2-2: cross-pkg K=1 vs K=8 switch/loop versioning & keep[T] scalar method no mono bloat
  let lib_src =
    #|let K : Int = 1
    #|pub fn sw6[T](a : FixedArray[T], idx : Int) -> Int {
    #|  let _ = a[0]
    #|  if idx == K { 101 }
    #|  else if idx == 2 { 102 }
    #|  else if idx == 3 { 103 }
    #|  else if idx == 4 { 104 }
    #|  else if idx == 5 { 105 }
    #|  else if idx == 6 { 106 }
    #|  else { 0 }
    #|}
    #|pub fn loop_k[T](a : FixedArray[T]) -> Int {
    #|  let mut s = 0
    #|  let mut j = 0
    #|  while j < K {
    #|    let _ = a[j]
    #|    s = s + 1
    #|    j = j + 1
    #|  }
    #|  s
    #|}
  let lib_cr = check_source_files_with_imports("r4lib", ["lib.pion"], [lib_src], [], true)
  assert_true(lib_cr.diagnostics.length() == 0, check_result_to_json(lib_cr.diagnostics))
  let imp = [ImportedPkg::{ name: "r4lib", tc: lib_cr.tc }]
  let app_src =
    #|import "r4lib"
    #|let K : Int = 8
    #|pub fn keep[T](x : T, n : Int) -> T {
    #|  let _ = n.count_ones()
    #|  x
    #|}
    #|pub fn keep_ch[T](x : T, n : Int) -> T {
    #|  let _ = n.unsafe_to_char()
    #|  x
    #|}
    #|pub fn main() -> Int {
    #|  let a : FixedArray[Int] = FixedArray::make(1, 9)
    #|  r4lib::sw6(a, 1) + r4lib::loop_k(a) + keep(42, K) + keep_ch(42, K)
    #|}
  let app_cr = check_source_files_with_imports("r4app", ["main.pion"], [app_src], imp, true)
  assert_true(app_cr.diagnostics.length() == 0, check_result_to_json(app_cr.diagnostics))
  let ssa = emit_qbe_package_multi(app_cr.pkg, app_cr.tc, true, false, []).ssa
  let funcs = ssa.split("function ")
  let mut f_sw6 = ""
  let mut f_loop_k = ""
  let mut has_keep_mono = false
  let mut has_keep_ch_mono = false
  i = 0
  while i < funcs.length() {
    let f = funcs[i]
    if f.contains("$pion_pkg_r4lib_fn_sw6__mono_Int(") { f_sw6 = f }
    if f.contains("$pion_pkg_r4lib_fn_loop_k__mono_Int(") { f_loop_k = f }
    if f.contains("$pion_pkg_r4app_fn_keep__mono_Int(") { has_keep_mono = true }
    if f.contains("$pion_pkg_r4app_fn_keep_ch__mono_Int(") { has_keep_ch_mono = true }
    i = i + 1
  }
  assert_true(f_sw6 != "" && f_loop_k != "", ssa)
  // sw6 must NOT fold caller's K=8 into a switch jump table
  assert_true(!f_sw6.contains("sw_tbl"), f_sw6)
  // loop_k must NOT version with caller's K=8
  assert_true(!f_loop_k.contains(", 8\n"), f_loop_k)
  // keep[T](x, n) & keep_ch[T](x, n) calling builtin scalar methods on n must NOT monomorphize
  assert_true(!has_keep_mono, ssa)
  assert_true(!has_keep_ch_mono, ssa)
}

///|
test "qbe native caller inline budget caps huge function and isolates nested closure" {
  let sb = StringBuilder()
  sb.write_string("fn tiny_getter(x : Int) -> Int { x + 7 }\n")
  sb.write_string("fn leaf_helper(x : Int) -> Int {\n")
  sb.write_string("  let a = x * 3 + 7\n")
  sb.write_string("  if a > 100 { a - 17 } else { a + 19 }\n")
  sb.write_string("}\n")
  sb.write_string("fn opt_helper(x : Int) -> Option[Int] {\n")
  sb.write_string("  let a = x + 3\n")
  sb.write_string("  let b = a * 5\n")
  sb.write_string("  if b > 0 { Some(b + 1) } else { None }\n")
  sb.write_string("}\n")
  sb.write_string("fn hof_apply(x : Int, f : (Int) -> Int) -> Int {\n")
  sb.write_string("  let a = f(x)\n")
  sb.write_string("  let b = f(a + 1)\n")
  sb.write_string("  let c = f(b + 2)\n")
  sb.write_string("  a + b + c\n")
  sb.write_string("}\n")
  sb.write_string("pub fn big_dispatch(k : Int) -> Int {\n")
  sb.write_string("  let mut acc = 0\n")
  let mut i = 0
  while i < 80 {
    sb.write_string("  if k == " + i.to_string() + " {\n")
    sb.write_string("    acc = acc + leaf_helper(k + " + i.to_string() + ")\n")
    sb.write_string("    acc = acc + opt_helper(k + " + i.to_string() + ").unwrap_or(0)\n")
    sb.write_string("    acc = acc + hof_apply(k + " + i.to_string() + ", fn(v : Int) -> Int { let t = v * 2 + 1; t ^ (v + 3) })\n")
    sb.write_string("    acc = acc + tiny_getter(k + " + i.to_string() + ")\n")
    sb.write_string("  }\n")
    i = i + 1
  }
  sb.write_string("  acc + tiny_getter(k)\n")
  sb.write_string("}\n")
  sb.write_string("fn mid_after_clo(x : Int) -> Int {\n")
  sb.write_string("  let a = x * 5 + 3\n")
  sb.write_string("  if a > 50 { a - 9 } else { a + 11 }\n")
  sb.write_string("}\n")
  sb.write_string("pub fn outer_with_big_closure(k : Int) -> Int {\n")
  sb.write_string("  let f = fn(n : Int) -> Int {\n")
  sb.write_string("    let mut s = n\n")
  let mut j = 0
  while j < 60 {
    sb.write_string("    s = s + leaf_helper(n + " + j.to_string() + ")\n")
    j = j + 1
  }
  sb.write_string("    s\n")
  sb.write_string("  }\n")
  sb.write_string("  f(k) + mid_after_clo(k)\n")
  sb.write_string("}\n")
  let src = sb.to_string()
  let cr = check_source_files_full("h1budget", ["main.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("function ")
  let mut f_big = ""
  let mut f_outer = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_fn_big_dispatch(") { f_big = f }
    if f.contains("$pion_fn_outer_with_big_closure(") { f_outer = f }
    fi = fi + 1
  }
  assert_true(f_big != "" && f_outer != "", ssa)
  // Once big_dispatch exceeds the native caller inline budget (480 non-loop),
  // medium callees (5 <= callee_cost <= 18) and multi-call HOFs fall back to
  // calls after initial inlines exhaust the budget, while tiny getters (<= 4)
  // stay inlined throughout the function.
  assert_true(f_big.contains("call $pion_fn_leaf_helper("), f_big)
  assert_true(f_big.contains(" 100\n"), f_big)
  assert_true(f_big.contains("call $pion_fn_opt_helper("), f_big)
  assert_true(f_big.contains("call $pion_fn_hof_apply("), f_big)
  assert_true(!f_big.contains("call $pion_fn_tiny_getter("), f_big)
  // Nested closure's budget usage must NOT pollute outer_with_big_closure:
  // mid_after_clo (cost 17, > 4 and <= 18) must still be inlined in outer_with_big_closure.
  assert_true(!f_outer.contains("call $pion_fn_mid_after_clo("), f_outer)
}

///|
test "p88_borrow_moveout_ssa" {
  let src =
    #|struct Leaf {
    #|  mut items : Array[Int]
    #|  mut tag : String
    #|  score : Int
    #|}
    #|struct Mid {
    #|  mut leaf : Leaf
    #|}
    #|struct Top {
    #|  mut mid : Mid
    #|  mut children : Array[Int]
    #|}
    #|pub fn mut_field_len(parent : Top) -> Int {
    #|  parent.children.length()
    #|}
    #|pub fn chain_field_len(t : Top) -> Int {
    #|  t.mid.leaf.items.length()
    #|}
    #|pub fn arr_elem_field_len(arr : Array[Leaf], i : Int) -> Int {
    #|  arr[i].items.length()
    #|}
    #|pub fn chain_read_scalar(t : Top) -> Int {
    #|  t.mid.leaf.score
    #|}
    #|pub fn chain_read_heap(t : Top) -> String {
    #|  t.mid.leaf.tag
    #|}
    #|pub fn mut_arr_idx_pure(parent : Top, i : Int) -> Int {
    #|  parent.children[i]
    #|}
    #|fn mutate_and_index(parent : Top) -> Int {
    #|  parent.children = [99, 100]
    #|  0
    #|}
    #|pub fn mut_arr_idx_call_neg(parent : Top) -> Int {
    #|  parent.children[mutate_and_index(parent)]
    #|}
    #|pub fn block_tail_mut_moveout(n : Int) -> Array[Int] {
    #|  let mut out : Array[Int] = []
    #|  out.push(n)
    #|  out
    #|}
    #|pub fn outer_mut_branch_neg(c : Bool) -> Int {
    #|  let mut x : Array[Int] = [1, 2]
    #|  let y : Array[Int] = [3, 4]
    #|  let picked = if c { x } else { y }
    #|  picked.length() + x.length()
    #|}
    #|fn inline_early_ret(cond : Bool, n : Int) -> Array[Int] {
    #|  let mut a : Array[Int] = []
    #|  a.push(n)
    #|  if cond {
    #|    return a
    #|  }
    #|  let mut b : Array[Int] = []
    #|  b.push(n + 1)
    #|  b
    #|}
    #|pub fn call_inline_early_ret(cond : Bool, n : Int) -> Int {
    #|  let r = inline_early_ret(cond, n)
    #|  r.length()
    #|}
    #|struct Mutator {
    #|  target : Top
    #|}
    #|fn Mutator::length(self : Mutator) -> Int {
    #|  self.target.children = [77, 88]
    #|  0
    #|}
    #|pub fn mut_arr_idx_shadow_match_neg(parent : Top, opt : Option[Mutator]) -> Int {
    #|  let x : String = "outer_str"
    #|  let _ = x.length()
    #|  parent.children[match opt { Some(x) => x.length(); None => 0 }]
    #|}
    #|pub fn mut_arr_idx_shadow_is_neg(parent : Top, opt : Option[Mutator]) -> Int {
    #|  let x : String = "outer_str"
    #|  let _ = x.length()
    #|  parent.children[if opt is Some(x) { x.length() } else { 0 }]
    #|}
    #|pub fn mut_arr_idx_shadow_block_neg(parent : Top, m : Mutator) -> Int {
    #|  let x : String = "outer_str"
    #|  let _ = x.length()
    #|  parent.children[{ let x = m; x.length() }]
    #|}
    #|pub fn mut_arr_idx_shadow_is_and_neg(parent : Top, opt : Option[Mutator]) -> Int {
    #|  let x : String = "outer_str"
    #|  let _ = x.length()
    #|  parent.children[if opt is Some(x) && x.length() > 0 { 1 } else { 0 }]
    #|}
    #|pub fn drop_owner(box : Array[String], depth : Int) -> Int {
    #|  if depth > 0 {
    #|    return drop_owner(box, depth - 1)
    #|  }
    #|  box[0].length()
    #|}
    #|fn pinned_view_inline(cond : Bool, prefix : String) -> Int {
    #|  let mut s = prefix + "_payload_123456"
    #|  let v = s.view(0, 6)
    #|  if cond {
    #|    return drop_owner([s], 0) + v.code_unit_at(0)
    #|  }
    #|  v.length()
    #|}
    #|pub fn call_pinned_view_inline(cond : Bool, prefix : String) -> Int {
    #|  let mut res = 0
    #|  let mut i = 0
    #|  while i < 1 {
    #|    res = pinned_view_inline(cond, prefix)
    #|    i = i + 1
    #|  }
    #|  res
    #|}
    #|pub fn pinned_view_non_inline(cond : Bool, prefix : String, depth : Int) -> Int {
    #|  if depth > 0 {
    #|    return pinned_view_non_inline(cond, prefix, depth - 1)
    #|  }
    #|  let mut s = prefix + "_payload_123456"
    #|  let v = s.view(0, 6)
    #|  if cond {
    #|    return drop_owner([s], 0) + v.code_unit_at(0)
    #|  }
    #|  v.length()
    #|}
    #|fn make_vmap(seed : Int) -> Map[(Int, Int), Array[Int]] {
    #|  let m : Map[(Int, Int), Array[Int]] = Map([])
    #|  m.set((1, 2), [seed, seed + 1])
    #|  m
    #|}
    #|pub fn vmap_owned_unwrap_or(seed : Int, hit : Bool) -> Array[Int] {
    #|  let m = make_vmap(seed)
    #|  let k = if hit { (1, 2) } else { (9, 9) }
    #|  (move m).get(k).unwrap_or([70, 80])
    #|}
    #|pub fn main() -> Int { 0 }
  let cr = check_source_files_with_imports("p88ssa", ["main.pion"], [src], [], true)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  let funcs = ssa.split("function ")
  let mut f_mut_len = ""
  let mut f_chain_len = ""
  let mut f_arr_len = ""
  let mut f_chain_scalar = ""
  let mut f_chain_heap = ""
  let mut f_mut_idx = ""
  let mut f_mut_idx_neg = ""
  let mut f_block_move = ""
  let mut f_outer_neg = ""
  let mut f_inline_caller = ""
  let mut f_shadow_match = ""
  let mut f_shadow_is = ""
  let mut f_shadow_block = ""
  let mut f_shadow_is_and = ""
  let mut f_call_pinned_inline = ""
  let mut f_pinned_non_inline = ""
  let mut f_vmap_owned = ""
  let mut i = 0
  while i < funcs.length() {
    let f = funcs[i]
    if f.contains("_fn_mut_field_len(") { f_mut_len = f }
    if f.contains("_fn_chain_field_len(") { f_chain_len = f }
    if f.contains("_fn_arr_elem_field_len(") { f_arr_len = f }
    if f.contains("_fn_chain_read_scalar(") { f_chain_scalar = f }
    if f.contains("_fn_chain_read_heap(") { f_chain_heap = f }
    if f.contains("_fn_mut_arr_idx_pure(") { f_mut_idx = f }
    if f.contains("_fn_mut_arr_idx_call_neg(") { f_mut_idx_neg = f }
    if f.contains("_fn_block_tail_mut_moveout(") { f_block_move = f }
    if f.contains("_fn_outer_mut_branch_neg(") { f_outer_neg = f }
    if f.contains("_fn_call_inline_early_ret(") { f_inline_caller = f }
    if f.contains("_fn_mut_arr_idx_shadow_match_neg(") { f_shadow_match = f }
    if f.contains("_fn_mut_arr_idx_shadow_is_neg(") { f_shadow_is = f }
    if f.contains("_fn_mut_arr_idx_shadow_block_neg(") { f_shadow_block = f }
    if f.contains("_fn_mut_arr_idx_shadow_is_and_neg(") { f_shadow_is_and = f }
    if f.contains("_fn_call_pinned_view_inline(") { f_call_pinned_inline = f }
    if f.contains("_fn_pinned_view_non_inline(") { f_pinned_non_inline = f }
    if f.contains("_fn_vmap_owned_unwrap_or(") { f_vmap_owned = f }
    i = i + 1
  }
  assert_true(
    f_mut_len != "" &&
      f_chain_len != "" &&
      f_arr_len != "" &&
      f_chain_scalar != "" &&
      f_chain_heap != "" &&
      f_mut_idx != "" &&
      f_mut_idx_neg != "" &&
      f_block_move != "" &&
      f_outer_neg != "" &&
      f_inline_caller != "" &&
      f_shadow_match != "" &&
      f_shadow_is != "" &&
      f_shadow_block != "" &&
      f_shadow_is_and != "" &&
      f_call_pinned_inline != "" &&
      f_pinned_non_inline != "" &&
      f_vmap_owned != "",
    ssa,
  )
  // 1) mut field .length(): zero RC
  assert_true(!f_mut_len.contains("pion_rc_inc") && !f_mut_len.contains("pion_rc_dec"), f_mut_len)
  // 2) chained .length(), arr[i].field.length(), chained EField scalar/heap: zero intermediate RC
  assert_true(!f_chain_len.contains("pion_rc_inc") && !f_chain_len.contains("pion_rc_dec"), f_chain_len)
  assert_true(!f_arr_len.contains("pion_rc_inc") && !f_arr_len.contains("pion_rc_dec"), f_arr_len)
  assert_true(!f_chain_scalar.contains("pion_rc_inc") && !f_chain_scalar.contains("pion_rc_dec"), f_chain_scalar)
  assert_true(f_chain_heap.contains("pion_rc_inc") && !f_chain_heap.contains("pion_rc_dec"), f_chain_heap)
  // 3) mut field [idx] pure: zero RC; call/shadow negatives: must retain RC (not borrowed)
  assert_true(!f_mut_idx.contains("pion_rc_inc") && !f_mut_idx.contains("pion_rc_dec"), f_mut_idx)
  assert_true(f_mut_idx_neg.contains("pion_rc_inc") && f_mut_idx_neg.contains("pion_rc_dec"), f_mut_idx_neg)
  assert_true(f_shadow_match.contains("pion_rc_inc") && f_shadow_match.contains("pion_rc_dec"), f_shadow_match)
  assert_true(f_shadow_is.contains("pion_rc_inc") && f_shadow_is.contains("pion_rc_dec"), f_shadow_is)
  assert_true(f_shadow_block.contains("pion_rc_inc") && f_shadow_block.contains("pion_rc_dec"), f_shadow_block)
  assert_true(f_shadow_is_and.contains("pion_rc_inc") && f_shadow_is_and.contains("pion_rc_dec"), f_shadow_is_and)
  // 4) block-tail mut local move-out: zero rc_inc/rc_dec; outer mut in if branch: must keep rc_inc
  assert_true(!f_block_move.contains("pion_rc_inc") && !f_block_move.contains("pion_rc_dec"), f_block_move)
  assert_true(f_outer_neg.contains("pion_rc_inc"), f_outer_neg)
  // 5) inlined early return of mut local: must actually inline AND have zero rc_inc inside caller
  assert_true(
    !f_inline_caller.contains("call $pion_fn_inline_early_ret") &&
      !f_inline_caller.contains("pion_rc_inc"),
    f_inline_caller,
  )
  // 6) pinned stack view across inlined & non-inlined SReturn:
  //    must actually inline pinned_view_inline, and MUST retain pion_rc_inc on `s` before drop_owner(s)
  assert_true(
    !f_call_pinned_inline.contains("call $pion_fn_pinned_view_inline") &&
      f_call_pinned_inline.contains("pion_rc_inc"),
    f_call_pinned_inline,
  )
  assert_true(f_pinned_non_inline.contains("pion_rc_inc"), f_pinned_non_inline)
  // 7) composite-key vmap owned `(move m).get(k).unwrap_or(...)` must hit try_get fast path
  //    AND retain hit value (pion_rc_inc) BEFORE dropping owned map (pion_rc_dec)
  let try_pos = f_vmap_owned.index_of("call $pion_vmap_try_get_")
  assert_true(try_pos >= 0, f_vmap_owned)
  let after_try = f_vmap_owned.slice(try_pos, f_vmap_owned.length())
  let inc_pos = after_try.index_of("call $pion_rc_inc")
  let dec_pos = after_try.index_of("call $pion_rc_dec")
  assert_true(inc_pos >= 0 && dec_pos >= 0 && inc_pos < dec_pos, after_try)
}

///|
test "p87_unit_mode_pkg_once_init_ssa" {
  let src_a =
    #|extern "C" fn host_eval_x() -> Int
    #|pub let X : Int = host_eval_x()
  let src_b =
    #|pub let Y : Int = X + 100
    #|pub extern "C" fn ping() -> Int { 7 }
    #|pub extern "C" fn get_y() -> Int { Y }
  let prep = match cli_prepare_qbe_units("p87_reent", ["a.pion", "b.pion"], [src_a, src_b]) {
    Ok(p) => p
    Err(e) => {
      assert_true(false, e)
      return ()
    }
  }
  let ssa_a = emit_qbe_unit_entry_target(prep, 0, true, "amd64_sysv", "main", true)
  let ssa_b = emit_qbe_unit_entry_target(prep, 1, true, "amd64_sysv", "main", true)
  // Unit 0 defines the single package-level once wrapper & guard calling per-const inits in topological order
  assert_true(
    ssa_a.contains("data $pion_unit_init_all_p87_reent_guard = align 4 { z 4 }") &&
      ssa_a.contains("export function $pion_unit_init_all_p87_reent()") &&
      ssa_a.contains("call $pion_init_const_X()") &&
      ssa_a.contains("call $pion_init_const_Y()"),
    ssa_a,
  )
  // Unit 1 must NOT redefine wrapper/guard, and its exports must call the single wrapper
  assert_true(
    !ssa_b.contains("data $pion_unit_init_all_p87_reent_guard") &&
      !ssa_b.contains("export function $pion_unit_init_all_p87_reent()") &&
      !ssa_b.contains("call $pion_init_const_X()") &&
      ssa_b.contains("call $pion_unit_init_all_p87_reent()"),
    ssa_b,
  )
}

///|
test "p89_unit_enum_unboxed_ssa" {
  let src =
    #|enum Color {
    #|  Red
    #|  Green
    #|  Blue
    #|}
    #|
    #|enum Day {
    #|  Mon
    #|  Tue
    #|  Wed
    #|  Thu
    #|  Fri
    #|  Sat
    #|  Sun
    #|}
    #|
    #|struct Holder {
    #|  c : Color
    #|  oc : Option[Color]
    #|  n : Int
    #|}
    #|
    #|struct GKey[T] {
    #|  a : T
    #|  b : Int
    #|}
    #|
    #|enum Wrap {
    #|  One(Color)
    #|  Opt(Option[Color])
    #|}
    #|
    #|let DEF_COLOR : Color = Color::Green
    #|
    #|pub fn mk_red() -> Color {
    #|  Color::Red
    #|}
    #|
    #|pub fn match_color(c : Color) -> Int {
    #|  match c {
    #|    Color::Red => 10
    #|    Color::Green => 20
    #|    Color::Blue => 30
    #|  }
    #|}
    #|
    #|pub fn match_day_jtbl(d : Day) -> Int {
    #|  match d {
    #|    Day::Mon => 1
    #|    Day::Tue => 2
    #|    Day::Wed => 3
    #|    Day::Thu => 4
    #|    Day::Fri => 5
    #|    Day::Sat => 6
    #|    Day::Sun => 7
    #|  }
    #|}
    #|
    #|pub fn opt_unit_niche(flag : Bool) -> Option[Color] {
    #|  if flag { Some(Color::Blue) } else { None }
    #|}
    #|
    #|pub fn opt_unit_use(o : Option[Color]) -> Int {
    #|  let c = o.unwrap_or(DEF_COLOR)
    #|  if c == Color::Blue { 1 } else { 0 }
    #|}
    #|
    #|pub fn mk_holder(c : Color, oc : Option[Color]) -> Holder {
    #|  Holder::{ c: c, oc: oc, n: 7 }
    #|}
    #|
    #|pub fn mk_flat_holders() -> Array[Holder] {
    #|  let a : Array[Holder] = Array::with_capacity(2)
    #|  a.push(Holder::{ c: Color::Red, oc: None, n: 1 })
    #|  a.push(Holder::{ c: Color::Blue, oc: Some(Color::Green), n: 2 })
    #|  a
    #|}
    #|
    #|pub fn mk_arr_color() -> Array[Color] {
    #|  [Color::Red, Color::Green, Color::Blue]
    #|}
    #|
    #|pub fn mk_arr_opt_color() -> Array[Option[Color]] {
    #|  [None, Some(Color::Red), Some(Color::Blue)]
    #|}
    #|
    #|pub fn use_map_color() -> Int {
    #|  let m : Map[Color, Int] = Map::new()
    #|  m.set(Color::Red, 11)
    #|  m.set(Color::Blue, 22)
    #|  m.get(Color::Blue).unwrap_or(0)
    #|}
    #|
    #|pub fn use_two_gkey_vmaps() -> Int {
    #|  let m1 : Map[GKey[Int], String] = Map::new()
    #|  m1.set(GKey::{ a: 7, b: 1 }, "int")
    #|  let m2 : Map[GKey[Color], String] = Map::new()
    #|  m2.set(GKey::{ a: Color::Blue, b: 2 }, "color")
    #|  m1.get(GKey::{ a: 7, b: 1 }).unwrap_or("").length() +
    #|    m2.get(GKey::{ a: Color::Blue, b: 2 }).unwrap_or("").length()
    #|}
    #|
    #|pub fn mk_wrap(c : Color) -> Wrap {
    #|  Wrap::One(c)
    #|}
  let cr = check_source_files_with_imports("p89_unit_enum", ["p89_unit_enum.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, true, false, []).ssa
  // Zero static $pion_enum_Color_*_hdr or $pion_enum_Day_*_hdr or $pion_drop_enum_Color
  assert_true(!ssa.contains("$pion_enum_u_Color_"), ssa)
  assert_true(!ssa.contains("$pion_enum_u_Day_"), ssa)
  assert_true(!ssa.contains("$pion_drop_enum_Color"), ssa)
  assert_true(!ssa.contains("$pion_drop_enum_Day"), ssa)
  assert_true(!ssa.contains("$pion_drop_struct_Holder"), ssa)
  let funcs = ssa.split("function ")
  let mut f_mk_red = ""
  let mut f_match_color = ""
  let mut f_match_day = ""
  let mut f_opt_niche = ""
  let mut f_opt_use = ""
  let mut f_mk_holder = ""
  let mut f_mk_flat = ""
  let mut f_mk_arr = ""
  let mut f_mk_arr_opt = ""
  let mut f_map_color = ""
  let mut f_two_vmaps = ""
  let mut f_init_body = ""
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.contains("$pion_fn_mk_red(") {
      f_mk_red = f
    } else if f.contains("$pion_fn_match_color(") {
      f_match_color = f
    } else if f.contains("$pion_fn_match_day_jtbl(") {
      f_match_day = f
    } else if f.contains("$pion_fn_opt_unit_niche(") {
      f_opt_niche = f
    } else if f.contains("$pion_fn_opt_unit_use(") {
      f_opt_use = f
    } else if f.contains("$pion_fn_mk_holder(") {
      f_mk_holder = f
    } else if f.contains("$pion_fn_mk_flat_holders(") {
      f_mk_flat = f
    } else if f.contains("$pion_fn_mk_arr_color(") {
      f_mk_arr = f
    } else if f.contains("$pion_fn_mk_arr_opt_color(") {
      f_mk_arr_opt = f
    } else if f.contains("$pion_fn_use_map_color(") {
      f_map_color = f
    } else if f.contains("$pion_fn_use_two_gkey_vmaps(") {
      f_two_vmaps = f
    } else if f.contains("$pion_init_consts__body(") {
      f_init_body = f
    }
    fi = fi + 1
  }
  assert_true(f_mk_red != "" && f_mk_red.contains("copy 1") && !f_mk_red.contains("pion_alloc") && !f_mk_red.contains("pion_rc_"), f_mk_red)
  assert_true(f_match_color != "" && !f_match_color.contains("pion_rc_") && !f_match_color.contains("pion_alloc"), f_match_color)
  assert_true(f_match_day != "" && f_match_day.contains("jtbl ") && !f_match_day.contains("pion_rc_"), f_match_day)
  assert_true(f_opt_niche != "" && !f_opt_niche.contains("pion_alloc") && !f_opt_niche.contains("pion_rc_") && !f_opt_niche.contains("$pion_none_hdr"), f_opt_niche)
  assert_true(f_opt_use != "" && !f_opt_use.contains("pion_alloc") && !f_opt_use.contains("pion_rc_"), f_opt_use)
  // Holder has only non-obj fields (Color, Option[Color], Int) -> drop_fn == 0, zero rc
  assert_true(f_mk_holder != "" && f_mk_holder.contains(", w 4, l 0)") && !f_mk_holder.contains("pion_rc_"), f_mk_holder)
  // Array[Holder] stays flat inline (stride = 24, RC mask = 0 -> flags = 24), zero per-element heap alloc
  assert_true(
    f_mk_flat != "" &&
      f_mk_flat.contains("call $pion_arr_new(") &&
      f_mk_flat.contains(", w 24)") &&
      f_mk_flat.contains("$pion_arr_push_flat_grow") &&
      !f_mk_flat.contains("$pion_alloc"),
    f_mk_flat,
  )
  // Array[Color] & Array[Option[Color]]: elem_is_obj == 0, zero rc
  assert_true(f_mk_arr != "" && f_mk_arr.contains("call $pion_arr_new(l 3, w 0)") && !f_mk_arr.contains("pion_rc_"), f_mk_arr)
  assert_true(f_mk_arr_opt != "" && f_mk_arr_opt.contains("call $pion_arr_new(l 3, w 0)") && !f_mk_arr_opt.contains("pion_rc_"), f_mk_arr_opt)
  // Map[Color, Int] uses vmap with zero key RC
  assert_true(f_map_color != "" && f_map_color.contains("$pion_vmap_new_"), f_map_color)
  // Map[GKey[Int], String] vs Map[GKey[Color], String] must generate distinct vmap symbols
  assert_true(
    f_two_vmaps != "" &&
      f_two_vmaps.contains("_ZAInt_ZE") &&
      f_two_vmaps.contains("Color_ZE"),
    f_two_vmaps,
  )
  // Actual top-level init body ($pion_init_consts__body): no $pion_rc_immortalize, no $pion_enum_*_hdr
  assert_true(
    f_init_body != "" &&
      !f_init_body.contains("pion_rc_immortalize") &&
      !f_init_body.contains("$pion_enum_"),
    f_init_body,
  )
}

///|
test "p89_mangle_injective_no_collision" {
  let src =
    #|#derive(Eq)
    #|struct Box[T] {
    #|  v : T
    #|}
    #|
    #|#derive(Eq)
    #|enum Box_ZAInt_ZE {
    #|  A
    #|  B
    #|}
    #|
    #|#derive(Eq)
    #|enum Box__ta_Int__te {
    #|  X
    #|  Y
    #|}
    #|
    #|enum A {
    #|  A1
    #|  A2
    #|}
    #|
    #|enum A__Int {
    #|  B1
    #|  B2
    #|}
    #|
    #|fn same[T](a : T, b : T) -> Bool {
    #|  a == b
    #|}
    #|
    #|pub fn check_all() -> Int {
    #|  let mut acc = 0
    #|  if same(Box::{ v: 1 }, Box::{ v: 1 }) {
    #|    acc = acc + 1
    #|  }
    #|  if same(Box_ZAInt_ZE::A, Box_ZAInt_ZE::A) {
    #|    acc = acc + 2
    #|  }
    #|  if same(Box__ta_Int__te::X, Box__ta_Int__te::X) {
    #|    acc = acc + 4
    #|  }
    #|  let m3 : Map[(A, Int, Int), Int] = Map::new()
    #|  m3.set((A::A1, 1, 2), 10)
    #|  let m2 : Map[(A__Int, Int), Int] = Map::new()
    #|  m2.set((A__Int::B1, 2), 20)
    #|  acc + m3.get((A::A1, 1, 2)).unwrap_or(0) + m2.get((A__Int::B1, 2)).unwrap_or(0)
    #|}
  let cr = check_source_files_with_imports("mng", ["mng.pion"], [src], [], false)
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = emit_qbe_package_multi(cr.pkg, cr.tc, false, false, []).ssa
  assert_true(ssa.contains("function l $pion_fn_same__mono_0L8_mng__Box_ZAInt_ZE("), ssa)
  assert_true(ssa.contains("function l $pion_fn_same__mono_0L17_mng__Box_ZAInt_ZE("), ssa)
  assert_true(ssa.contains("function l $pion_fn_same__mono_0L20_mng__Box__ta_Int__te("), ssa)
  assert_true(ssa.contains("$pion_vmap_new_vm__ZT0L6_mng__A_ZSInt_ZSInt_ZE_Int("), ssa)
  assert_true(ssa.contains("$pion_vmap_set_vm__ZT0L6_mng__A_ZSInt_ZSInt_ZE_Int("), ssa)
  assert_true(ssa.contains("$pion_vmap_get_vm__ZT0L6_mng__A_ZSInt_ZSInt_ZE_Int("), ssa)
  assert_true(ssa.contains("$pion_vmap_new_vm__ZT0L11_mng__A__Int_ZSInt_ZE_Int("), ssa)
  assert_true(ssa.contains("$pion_vmap_set_vm__ZT0L11_mng__A__Int_ZSInt_ZE_Int("), ssa)
  assert_true(ssa.contains("$pion_vmap_get_vm__ZT0L11_mng__A__Int_ZSInt_ZE_Int("), ssa)
}

///|
/// Temp name at `ln[start..]` (a `%`, then up to the first `,`, `)`, space or end).
fn p84_tmp_at(ln : String, start : Int) -> String {
  let mut e = start + 1
  while e < ln.length() {
    let c = str_code_at(ln, e)
    if c == 44 || c == 41 || c == 32 {
      break
    }
    e = e + 1
  }
  ln.slice(start, e)
}

///|
/// QBE `jnz` tests only the low 32 bits of its operand (`cbz wN` / `testl`). Returns the first
/// `jnz` that branches directly on a 64-bit `l` temp or param inside a runtime helper
/// (`$pion_vmap_*`, `$pion_freeze_*`, `$pion_drop_*`), or that guards a `memchr` hit or an
/// `Array::pop` length; `""` when every such branch goes through a `w` value first.
fn p84_first_l_jnz(ssa : String) -> String {
  let lines = ssa.split("\n")
  let mut l_tmps : Map[String, Bool] = Map([])
  let mut helper = false
  let mut fn_hdr = ""
  let mut i = 0
  while i < lines.length() {
    let ln = lines[i]
    if ln.contains("function ") && ln.ends_with("{") {
      l_tmps = Map([])
      fn_hdr = ln
      helper = ln.contains("$pion_vmap_") ||
        ln.contains("$pion_freeze_") ||
        ln.contains("$pion_drop_")
      let mut p = p18_find_from(ln, "l %", 0)
      while p >= 0 {
        l_tmps.set(p84_tmp_at(ln, p + 2), true)
        p = p18_find_from(ln, "l %", p + 3)
      }
    } else {
      let tln = ln.trim()
      if tln.starts_with("%") && tln.contains(" =l ") {
        l_tmps.set(p84_tmp_at(tln, 0), true)
      } else if tln.starts_with("jnz %") {
        let guarded = helper || tln.contains("@svmc_hit") || tln.contains("@pop_some")
        if guarded && l_tmps.contains(p84_tmp_at(tln, 4)) {
          return fn_hdr + " :: " + ln
        }
      }
    }
    i = i + 1
  }
  ""
}

///|
test "p84_qbe_jnz_never_branches_on_64bit_l_values" {
  // Apple malloc hands out 4 GiB-aligned blocks (0x600000000000): a raw `jnz %ptr`
  // reads the low 32 bits as 0 and takes the null path (e.g. vmap grow skipped its rehash).
  let src =
    #|pub trait Describe {
    #|  describe(self : Self) -> String
    #|}
    #|pub struct Dog {
    #|  name : String
    #|}
    #|impl Describe for Dog {
    #|  fn describe(self : Dog) -> String {
    #|    "dog:" + self.name
    #|  }
    #|}
    #|pub struct Node {
    #|  label : String
    #|  next : Option[Node]
    #|}
    #|pub val struct Msg {
    #|  id : Int
    #|  body : String
    #|  note : String
    #|}
    #|pub fn render(x : dyn Describe) -> String {
    #|  x.describe()
    #|}
    #|pub fn main(world : World) -> Int {
    #|  let m : Map[Int, Int] = Map::with_capacity(4)
    #|  let mut i = 0
    #|  while i < 100 {
    #|    m.set(i, i * 2)
    #|    i += 1
    #|  }
    #|  m.remove(3)
    #|  let ks = m.keys()
    #|  let m2 = m.copy()
    #|  let hit = m.contains(5) && m.get(7).unwrap_or(0) == 14
    #|  m.clear()
    #|  let s = "hello,world"
    #|  let v = s.view(0, 11)
    #|  let comma = v.index_of_byte((44).to_byte())
    #|  let xs : Array[Int] = [1, 2, 3]
    #|  let last = match xs.pop() {
    #|    Some(x) => x
    #|    None => 0
    #|  }
    #|  let d : dyn Describe = Dog::{ name: "rex" }
    #|  let n = Node::{ label: "a", next: Some(Node::{ label: "b", next: None }) }
    #|  let q : Mutex[Array[Msg]] = Mutex::new([])
    #|  scope(world, fn(sc : Scope) -> Unit {
    #|    spawn(sc, fn() -> Unit {
    #|      let a = q.lock()
    #|      a.push(Msg::{ id: 1, body: "x", note: "n" })
    #|      q.unlock()
    #|    })
    #|  })
    #|  let _ = n.label
    #|  render(d).length() + ks.length() + m2.length() + comma + last + if hit { 1 } else { 0 }
    #|}
  let cr = check_source_files_full("p84_jnz64", ["p84_jnz64.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa
  // Every helper family the scan covers is really emitted.
  let wanted = [
    "$pion_vmap_get_or_", "$pion_vmap_drop_", "$pion_vmap_grow_", "$pion_vmap_set_",
    "$pion_vmap_try_get_", "$pion_vmap_get_", "$pion_vmap_has_", "$pion_vmap_remove_",
    "$pion_vmap_clear_", "$pion_vmap_copy_", "$pion_vmap_keys_", "$pion_freeze_st_",
    "$pion_freeze_arr_", "$pion_drop_slots_", "$pion_drop_dyn(",
  ]
  // Non-generic structs drop through the shared slot helper family above.
  assert_true(!ssa.contains("$pion_drop_struct_"), ssa)
  let mut wi = 0
  while wi < wanted.length() {
    assert_true(ssa.contains("function " + wanted[wi]) ||
        ssa.contains("function l " + wanted[wi]) ||
        ssa.contains("function w " + wanted[wi]), wanted[wi])
    wi = wi + 1
  }
  assert_true(ssa.contains("$memchr("), ssa)
  assert_true(ssa.contains("@pop_some"), ssa)
  assert_true(ssa.contains("%obuf_nz =w cnel %obuf, 0\n    jnz %obuf_nz, @rehash, @done"), ssa)
  assert_true(ssa.contains("%obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done"), ssa)
  assert_true(ssa.contains("%is_obj_nz =w cnel %is_obj, 0\n    jnz %is_obj_nz, @dec, @done"), ssa)
  let bad = p84_first_l_jnz(ssa)
  assert_true(bad == "", bad)
  // The scanner itself flags the pre-fix shape.
  let old_shape = "function $pion_vmap_grow_x(l %m, l %ncap) {\n@start\n    %obuf =l loadl %m\n    jnz %obuf, @rehash, @done\n@rehash\n@done\n    ret\n}\n"
  assert_true(p84_first_l_jnz(old_shape) != "", old_shape)
  let old_pop = "function l $pion_fn_f(l %a) {\n@start\n    %t1 =l loadl %a\n    jnz %t1, @pop_some_1, @pop_none_2\n"
  assert_true(p84_first_l_jnz(old_pop) != "", old_pop)
}

///|
test "i3: qbe_sanitize_source_path normalizes Windows slashes, dotdot & bare files" {
  let cr = check_source_files_full("pkg_a", ["src/lib.pion"], ["pub fn f() -> Int { 1 }\n"])
  cr.tc.pkg_root = "C:\\Users\\alice\\ws\\..\\proj\\pkg_a\\"
  let g_pkg = qbe_new_for_target_name(cr.tc, false, false, false, "")
  assert_eq(
    qbe_sanitize_source_path(g_pkg, "C:\\Users\\alice\\proj\\pkg_a\\src\\sub\\..\\lib.pion"),
    "pkg_a/src/lib.pion",
  )
  assert_eq(
    qbe_sanitize_source_path(g_pkg, "/tmp/a/b/../c/src/foo.pion"),
    "pkg_a/src/foo.pion",
  )

  let bare_cr = check_source_files_full("main", ["main.pion"], ["pub fn main() -> Int { 0 }\n"])
  let g_bare = qbe_new_for_target_name(bare_cr.tc, false, false, false, "")
  assert_eq(
    qbe_sanitize_source_path(g_bare, "/tmp/src/private-build/main.pion"),
    "main.pion",
  )
  assert_eq(
    qbe_sanitize_source_path(g_bare, "C:\\src\\secret\\sub\\..\\main.pion"),
    "main.pion",
  )
  assert_eq(
    qbe_sanitize_source_path(g_bare, "./a/b/../c/main.pion"),
    "main.pion",
  )

  let rel_cr = check_source_files_full("pkg_r", ["pkg_r/src/lib.pion"], ["pub fn f() -> Int { 1 }\n"])
  rel_cr.tc.pkg_root = "/work/ws/pkg_r"
  rel_cr.tc.pkg_cwd = "/work/ws"
  let g_rel = qbe_new_for_target_name(rel_cr.tc, false, false, false, "")
  assert_eq(
    qbe_sanitize_source_path(g_rel, "./pkg_r/src/lib.pion"),
    "pkg_r/src/lib.pion",
  )
}

///|
/// Wasm32 nested-loop outlining (`wasm_outline_nested_loops`) live-out regression: a promoted
/// slot read+written only inside an outlined depth-2 loop (`pos`, declared before the outer
/// `while`) must be written back to the caller's slot, otherwise each outer iteration re-enters
/// the outlined loop with a stale value. Inner counters re-stored on every entry (`i = 0`) stay
/// out of the live-out set, and > 8 live-outs back off from outlining entirely.
fn p95_ol_writebacks(funcs : Array[WasmFunc], fn_suffix : String) -> (Int, Int) {
  let mut n_calls = 0
  let mut n_wb = 0
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.name.ends_with(fn_suffix) {
      let mut bi = 0
      while bi < f.blocks.length() {
        let insts = f.blocks[bi].insts
        let mut after_call = false
        let mut ii = 0
        while ii < insts.length() {
          let inst = insts[ii]
          if inst.op == "call" && inst.args.length() > 0 && inst.args[0].starts_with("$__pion_ol_") {
            n_calls = n_calls + 1
            after_call = true
          } else if after_call &&
            (inst.op == "storel" || inst.op == "storew" || inst.op == "stores" || inst.op == "stored") &&
            inst.args.length() >= 2 &&
            (inst.args[0].starts_with("%__ol_res_") || inst.args[0].starts_with("%__ol_cr_")) {
            n_wb = n_wb + 1
          }
          ii = ii + 1
        }
        bi = bi + 1
      }
    }
    fi = fi + 1
  }
  (n_calls, n_wb)
}

///|
test "p95_wasm_outline_nested_loop_inner_rw_slot_liveout" {
  let src =
    #|fn probe_if(xs : Array[Int]) -> Int {
    #|  let n = xs.length()
    #|  let mut pos = 0
    #|  let mut acc = 0
    #|  let mut o = 0
    #|  while o < n {
    #|    let p = xs[o]
    #|    if p > 0 {
    #|      let mut i = 0
    #|      while i < p {
    #|        pos = (pos * 31 + i + 7) % 1000003
    #|        acc = (acc * 3 + pos) % 1000000007
    #|        i = i + 1
    #|      }
    #|    }
    #|    o = o + 1
    #|  }
    #|  acc
    #|}
    #|
    #|fn probe_wide(xs : Array[Int]) -> Int {
    #|  let n = xs.length()
    #|  let mut a0 = 1
    #|  let mut a1 = 2
    #|  let mut a2 = 3
    #|  let mut a3 = 4
    #|  let mut a4 = 5
    #|  let mut a5 = 6
    #|  let mut a6 = 7
    #|  let mut a7 = 8
    #|  let mut a8 = 9
    #|  let mut acc = 0
    #|  let mut o = 0
    #|  while o < n {
    #|    let p = xs[o]
    #|    if p > 0 {
    #|      let mut i = 0
    #|      while i < p {
    #|        a0 = (a0 * 3 + i) % 10007
    #|        a1 = (a1 * 5 + a0) % 10009
    #|        a2 = (a2 * 7 + a1) % 10037
    #|        a3 = (a3 * 11 + a2) % 10039
    #|        a4 = (a4 * 13 + a3) % 10061
    #|        a5 = (a5 * 17 + a4) % 10067
    #|        a6 = (a6 * 19 + a5) % 10069
    #|        a7 = (a7 * 23 + a6) % 10079
    #|        a8 = (a8 * 29 + a7) % 10091
    #|        acc = (acc * 3 + a8) % 1000000007
    #|        i = i + 1
    #|      }
    #|    }
    #|    o = o + 1
    #|  }
    #|  acc
    #|}
    #|
    #|pub fn main() -> Int {
    #|  let xs = [3, 0, 5, 2]
    #|  probe_if(xs) + probe_wide(xs)
    #|}
  let cr = check_source_files_full("p95", ["p95.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let mut ri = 0
  while ri < 2 {
    let ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, ri == 1, "wasm32").ssa
    let funcs = wasm_outline_nested_loops(wasm_dedup_module(wasm_parse_ssa(ssa)).funcs)
    // probe_if: the inner `while` is outlined and writes back `pos`, `acc` and `i` (the rotated
    // loop's guard block reloads `i`, so it is an outside read); pre-fix `pos` was dropped (2).
    let (if_calls, if_wb) = p95_ol_writebacks(funcs, "fn_probe_if")
    assert_true(if_calls == 1 && if_wb == 3, "release=" + (ri == 1).to_string() + " probe_if calls=" + if_calls.to_string() + " writebacks=" + if_wb.to_string())
    // probe_wide: 10 inner read+write slots (a0..a8, acc) > 8 live-outs => not outlined.
    let (wide_calls, _) = p95_ol_writebacks(funcs, "fn_probe_wide")
    assert_true(wide_calls == 0, "release=" + (ri == 1).to_string() + " probe_wide calls=" + wide_calls.to_string())
    ri = ri + 1
  }
}


///|
test "p95_wasm_ol_slot_killed_on_entry" {
  let src =
    #|fn probe_if(xs : Array[Int]) -> Int {
    #|  let n = xs.length()
    #|  let mut pos = 0
    #|  let mut acc = 0
    #|  let mut o = 0
    #|  while o < n {
    #|    let p = xs[o]
    #|    if p > 0 {
    #|      let mut i = 0
    #|      while i < p {
    #|        pos = (pos * 31 + i + 7) % 1000003
    #|        acc = (acc * 3 + pos) % 1000000007
    #|        i = i + 1
    #|      }
    #|    }
    #|    o = o + 1
    #|  }
    #|  acc
    #|}
    #|
    #|pub fn main() -> Int {
    #|  probe_if([3, 0, 5, 2])
    #|}
  let cr = check_source_files_full("p95k", ["p95k.pion"], [src])
  assert_true(
    cr.diagnostics.length() == 0,
    check_result_to_json(cr.diagnostics),
  )
  let ssa = emit_qbe_package_with_tc_target(cr.pkg, cr.tc, false, "wasm32").ssa
  let funcs = wasm_dedup_module(wasm_parse_ssa(ssa)).funcs
  let mut checked = 0
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    if f.name.ends_with("fn_probe_if") {
      let block_idx : Map[String, Int] = Map([])
      let mut bi = 0
      while bi < f.blocks.length() {
        block_idx.set(f.blocks[bi].label, bi)
        bi = bi + 1
      }
      let le = wasm_analyze_structured_cfg(f, block_idx)
      // Inner loop header: the second loop header in block order (the first is the outer `while`).
      let mut outer = -1
      let mut hdr = -1
      bi = 0
      while bi < f.blocks.length() {
        if le[bi] >= 0 {
          if outer < 0 { outer = bi } else if hdr < 0 { hdr = bi }
        }
        bi = bi + 1
      }
      assert_true(outer >= 0 && hdr > outer && le[hdr] <= le[outer], "outer=" + outer.to_string() + " hdr=" + hdr.to_string())
      // The guard block entering the inner loop stores `i = 0`; the loop body's other slot
      // stores (`pos`, `acc`) are never re-stored on entry.
      let pre = f.blocks[hdr - 1].insts
      let mut i_slot = ""
      let mut ii = 0
      while ii < pre.length() {
        if pre[ii].op == "storew" || pre[ii].op == "storel" {
          i_slot = pre[ii].args[1]
        }
        ii = ii + 1
      }
      assert_true(i_slot.length() > 0, "no store in guard block")
      assert_true(wasm_ol_slot_killed_on_entry(f, le, hdr, le[hdr], i_slot), "i slot " + i_slot)
      let body = f.blocks[hdr].insts
      ii = 0
      while ii < body.length() {
        if (body[ii].op == "storew" || body[ii].op == "storel") && body[ii].args[1] != i_slot {
          assert_true(!wasm_ol_slot_killed_on_entry(f, le, hdr, le[hdr], body[ii].args[1]), "slot " + body[ii].args[1])
          checked = checked + 1
        }
        ii = ii + 1
      }
    }
    fi = fi + 1
  }
  assert_true(checked == 2, "checked=" + checked.to_string())
}

///|
fn j2_extract_fn(ssa : String, hdr : String) -> String {
  let i = ssa.index_of(hdr)
  if i < 0 {
    return ""
  }
  let tail = slice_str(ssa, i, ssa.length())
  let e = tail.index_of("\n}")
  if e < 0 {
    tail
  } else {
    slice_str(tail, 0, e)
  }
}

///|
test "j2: layer1 borrowed immutable field chain let positive & negative SSA" {
  let src =
    #|struct Leaf { name : String, tag : String }
    #|struct Mid { leaf : Leaf }
    #|struct MidMut { mut leaf : Leaf }
    #|struct Top { mid : Mid, mid_mut : MidMut }
    #|
    #|fn use_s(s : String) -> Int { s.length() }
    #|
    #|pub fn pos_deep_chain(t : Top) -> Int {
    #|  let m = t.mid
    #|  let l = m.leaf
    #|  let a = l.name
    #|  let b = t.mid.leaf.tag
    #|  a.length() + b.length()
    #|}
    #|
    #|pub fn neg_mut_field(t : Top) -> Int {
    #|  let a = t.mid_mut.leaf.name
    #|  use_s(a)
    #|}
    #|
    #|pub fn neg_mut_root(t1 : Top, t2 : Top) -> Int {
    #|  let mut r = t1
    #|  let a = r.mid.leaf.name
    #|  r = t2
    #|  use_s(a)
    #|}
    #|
    #|fn swap_top(mut r : Top, other : Top) -> Int {
    #|  r = other
    #|  1
    #|}
    #|
    #|pub fn neg_mut_arg(t1 : Top, t2 : Top) -> Int {
    #|  let mut r = t1
    #|  let a = r.mid.leaf.name
    #|  let _ = swap_top(mut r, t2)
    #|  use_s(a)
    #|}
    #|
    #|pub fn pos_escape_return(t : Top) -> String {
    #|  let a = t.mid.leaf.name
    #|  return a
    #|}
  let cr = check_source_files_full("j2_l1", ["j2_l1.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = cleanup_native_rc_ssa(emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa)
  // pos_deep_chain must have zero RC ops.
  let pos_end = j2_extract_fn(ssa, "export function w $pion_fn_pos_deep_chain(")
  assert_true(pos_end.length() > 0, "pos_deep_chain not found")
  assert_true(!pos_end.contains("$pion_rc_inc"), "pos_deep_chain should have 0 rc_inc:\n" + pos_end)
  assert_true(!pos_end.contains("$pion_rc_dec"), "pos_deep_chain should have 0 rc_dec:\n" + pos_end)
  // neg_mut_field must retain (mut field in chain).
  let neg_mf_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_mut_field(")
  assert_true(neg_mf_end.contains("$pion_rc_inc"), "neg_mut_field must retain:\n" + neg_mf_end)
  // neg_mut_root must retain (mutable root local).
  let neg_mr_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_mut_root(")
  assert_true(neg_mr_end.contains("$pion_rc_inc"), "neg_mut_root must retain:\n" + neg_mr_end)
  // neg_mut_arg must retain (EMutArg mutates root).
  let neg_ma_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_mut_arg(")
  assert_true(neg_ma_end.contains("$pion_rc_inc"), "neg_mut_arg must retain:\n" + neg_ma_end)
  // pos_escape_return must retain on return escape.
  let esc_end = j2_extract_fn(ssa, "export function l $pion_fn_pos_escape_return(")
  assert_true(esc_end.contains("$pion_rc_inc"), "pos_escape_return must retain on return:\n" + esc_end)
}

///|
test "j2: layer2 multi-level field chain args positive & call-window mutation negative SSA" {
  let src =
    #|struct Leaf { name : String, tag : String }
    #|struct Mid { leaf : Leaf }
    #|struct Top { mid : Mid }
    #|
    #|fn take_two(a : String, b : String) -> Int {
    #|  a.length() + b.length()
    #|}
    #|
    #|fn take_with_int(a : String, x : Int) -> Int {
    #|  a.length() + x
    #|}
    #|
    #|fn swap_top(mut r : Top, other : Top) -> Int {
    #|  r = other
    #|  1
    #|}
    #|
    #|pub fn pos_args(t : Top) -> Int {
    #|  take_two(t.mid.leaf.name, t.mid.leaf.tag)
    #|}
    #|
    #|pub fn neg_arg_assign(t1 : Top, t2 : Top) -> Int {
    #|  let mut r = t1
    #|  take_with_int(r.mid.leaf.name, { r = t2; 1 })
    #|}
    #|
    #|fn Top::replace_self(mut self : Top, other : Top) -> Int {
    #|  self = other
    #|  1
    #|}
    #|
    #|pub fn neg_arg_mut(t1 : Top, t2 : Top) -> Int {
    #|  let mut r = t1
    #|  take_with_int(r.mid.leaf.name, swap_top(mut r, t2))
    #|}
    #|
    #|pub fn neg_arg_mut_self(t1 : Top, t2 : Top) -> Int {
    #|  let mut r3 = t1
    #|  take_with_int(r3.mid.leaf.name, r3.replace_self(t2))
    #|}
    #|
    #|pub fn neg_arg_if_mut_self(c : Bool, t1 : Top, t2 : Top) -> Int {
    #|  let mut r4 = t1
    #|  take_with_int(r4.mid.leaf.name, if c { r4.replace_self(t2) } else { 0 })
    #|}
    #|
    #|pub fn neg_arg_after_closure(t1 : Top, t2 : Top) -> Int {
    #|  let mut r = t1
    #|  let fns : Array[() -> Int] = [fn() -> Int { 7 }]
    #|  let _ = fns[0]()
    #|  take_with_int(r.mid.leaf.name, { r = t2; 1 })
    #|}
  let cr = check_source_files_full("j2_l2", ["j2_l2.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, check_result_to_json(cr.diagnostics))
  let ssa = cleanup_native_rc_ssa(emit_qbe_package_with_tc(cr.pkg, cr.tc, true).ssa)
  let pos_end = j2_extract_fn(ssa, "export function w $pion_fn_pos_args(")
  assert_true(!pos_end.contains("$pion_rc_inc"), "pos_args should have 0 rc_inc:\n" + pos_end)
  assert_true(!pos_end.contains("$pion_rc_dec"), "pos_args should have 0 rc_dec:\n" + pos_end)
  let neg1_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_arg_assign(")
  assert_true(neg1_end.contains("$pion_rc_inc"), "neg_arg_assign must retain arg0:\n" + neg1_end)
  let neg2_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_arg_mut(")
  assert_true(neg2_end.contains("$pion_rc_inc"), "neg_arg_mut must retain arg0:\n" + neg2_end)
  let neg3_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_arg_mut_self(")
  assert_true(neg3_end.contains("$pion_rc_inc"), "neg_arg_mut_self must retain arg0:\n" + neg3_end)
  let neg4_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_arg_if_mut_self(")
  assert_true(neg4_end.contains("$pion_rc_inc"), "neg_arg_if_mut_self must retain arg0:\n" + neg4_end)
  let neg5_end = j2_extract_fn(ssa, "export function w $pion_fn_neg_arg_after_closure(")
  assert_true(neg5_end.contains("$pion_rc_inc"), "neg_arg_after_closure must retain arg0:\n" + neg5_end)
}

///|
test "j2: layer3 inline_rc safe load whitelist & CFG trap-branch penetration" {
  // 1. Safe payload/length load on rc_inc'd object cancels.
  let ssa_safe_load =
    #|export function w $f_safe(l %p0) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %len =l loadl %p0
    #|    %w =w copy %len
    #|    call $pion_rc_dec(l %p0)
    #|    ret %w
    #|}
    #|
  let out_safe = cleanup_native_rc_ssa(ssa_safe_load)
  assert_true(!out_safe.contains("$pion_rc_inc"), out_safe)
  assert_true(!out_safe.contains("$pion_rc_dec"), out_safe)

  // 2. Global load ($pion_mt_flag) must NOT cancel.
  let ssa_glob =
    #|export function w $f_glob(l %p0) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %mt =w loaduw $pion_mt_flag
    #|    call $pion_rc_dec(l %p0)
    #|    ret %mt
    #|}
    #|
  let out_glob = cleanup_native_rc_ssa(ssa_glob)
  assert_true(out_glob.contains("$pion_rc_inc"), out_glob)
  assert_true(out_glob.contains("$pion_rc_dec"), out_glob)

  // 3. Negative RC header offset load (sub %p0, 20) must NOT cancel.
  let ssa_neg =
    #|export function w $f_neg(l %p0) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %la =l sub %p0, 20
    #|    %rc =w loaduw %la
    #|    call $pion_rc_dec(l %p0)
    #|    ret %rc
    #|}
    #|
  let out_neg = cleanup_native_rc_ssa(ssa_neg)
  assert_true(out_neg.contains("$pion_rc_inc"), out_neg)
  assert_true(out_neg.contains("$pion_rc_dec"), out_neg)

  // 4. Unknown raw TPtr parameter load must NOT cancel.
  let ssa_raw =
    #|export function w $f_raw(l %p0, l %p_raw) {
    #|@start
    #|    call $pion_rc_inc(l %p0)
    #|    %v =w loaduw %p_raw
    #|    call $pion_rc_dec(l %p0)
    #|    ret %v
    #|}
    #|
  let out_raw = cleanup_native_rc_ssa(ssa_raw)
  assert_true(out_raw.contains("$pion_rc_inc"), out_raw)
  assert_true(out_raw.contains("$pion_rc_dec"), out_raw)

  // 5. Single-predecessor forward trap-branch (Array 8B bounds check) penetration cancels.
  let ssa_trap =
    #|export function l $f_trap(l %arr, w %idx) {
    #|@start
    #|    call $pion_rc_inc(l %arr)
    #|    %il =l extsw %idx
    #|    %len =l loadl %arr
    #|    %oob =w cugel %il, %len
    #|    jnz %oob, @arr_oob_w8_0, @arr_ok0
    #|@arr_oob_w8_0
    #|    call $pion_panic_oob(l %il, l %len)
    #|    hlt
    #|@arr_ok0
    #|    %dp_p =l add %arr, 24
    #|    %dp =l loadl %dp_p
    #|    %off =l shl %il, 3
    #|    %ep =l add %dp, %off
    #|    %el =l loadl %ep
    #|    call $pion_rc_dec(l %arr)
    #|    ret %el
    #|}
    #|
  let out_trap = cleanup_native_rc_ssa(ssa_trap)
  assert_true(!out_trap.contains("$pion_rc_inc"), out_trap)
  assert_true(!out_trap.contains("$pion_rc_dec"), out_trap)

  // 5b. PionBytes bounds check (+16, stride 1, loadub) cancels.
  let ssa_bytes_trap =
    #|export function w $f_bytes_trap(l %bs, w %idx) {
    #|@start
    #|    call $pion_rc_inc(l %bs)
    #|    %il =l extsw %idx
    #|    %len =l loadl %bs
    #|    %oob =w cugel %il, %len
    #|    jnz %oob, @bytes_oob0, @bytes_ok0
    #|@bytes_oob0
    #|    call $pion_panic_oob(l %il, l %len)
    #|    hlt
    #|@bytes_ok0
    #|    %dp_p =l add %bs, 16
    #|    %dp =l loadl %dp_p
    #|    %ep =l add %dp, %il
    #|    %bv =w loadub %ep
    #|    call $pion_rc_dec(l %bs)
    #|    ret %bv
    #|}
    #|
  let out_bytes_trap = cleanup_native_rc_ssa(ssa_bytes_trap)
  assert_true(!out_bytes_trap.contains("$pion_rc_inc"), out_bytes_trap)
  assert_true(!out_bytes_trap.contains("$pion_rc_dec"), out_bytes_trap)

  // 6. Multi-predecessor @ok (pred_count == 2) must NOT penetrate.
  let ssa_mpred =
    #|export function w $f_mpred(l %arr, w %c, w %idx) {
    #|@start
    #|    jnz %c, @chk, @ok
    #|@chk
    #|    call $pion_rc_inc(l %arr)
    #|    %il =l extsw %idx
    #|    %len =l loadl %arr
    #|    %oob =w cugel %il, %len
    #|    jnz %oob, @oob, @ok
    #|@oob
    #|    call $pion_panic_oob(l %il, l %len)
    #|    hlt
    #|@ok
    #|    call $pion_rc_dec(l %arr)
    #|    ret 0
    #|}
    #|
  let out_mpred = cleanup_native_rc_ssa(ssa_mpred)
  assert_true(out_mpred.contains("$pion_rc_inc"), out_mpred)
  assert_true(out_mpred.contains("$pion_rc_dec"), out_mpred)

  // 7. Non-trap side branch (does not end with hlt) must NOT penetrate.
  let ssa_nontrap =
    #|export function w $f_nontrap(l %arr, w %c) {
    #|@start
    #|    call $pion_rc_inc(l %arr)
    #|    jnz %c, @other, @ok
    #|@other
    #|    ret 1
    #|@ok
    #|    call $pion_rc_dec(l %arr)
    #|    ret 0
    #|}
    #|
  let out_nontrap = cleanup_native_rc_ssa(ssa_nontrap)
  assert_true(out_nontrap.contains("$pion_rc_inc"), out_nontrap)
  assert_true(out_nontrap.contains("$pion_rc_dec"), out_nontrap)

  // 8. Unchecked `extsw` negative offset + struct offset-8 raw TPtr load MUST NOT cancel.
  let ssa_unchecked_tptr =
    #|export function w $f_tptr_off8(l %s, w %neg_i) {
    #|@start
    #|    call $pion_rc_inc(l %s)
    #|    %fp =l add %s, 8
    #|    %raw_ptr =l loadl %fp
    #|    %off =l extsw %neg_i
    #|    %ea =l add %raw_ptr, %off
    #|    %v =w loaduw %ea
    #|    call $pion_rc_dec(l %s)
    #|    ret %v
    #|}
    #|
  let out_tptr = cleanup_native_rc_ssa(ssa_unchecked_tptr)
  assert_true(out_tptr.contains("$pion_rc_inc"), out_tptr)
  assert_true(out_tptr.contains("$pion_rc_dec"), out_tptr)

  // 9. Unchecked `shl` on `extsw` without a dominating `cugel` bounds check MUST NOT cancel.
  let ssa_unchecked_shl =
    #|export function l $f_unchecked_shl(l %arr, w %neg_i) {
    #|@start
    #|    call $pion_rc_inc(l %arr)
    #|    %il =l extsw %neg_i
