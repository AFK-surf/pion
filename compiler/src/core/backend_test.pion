test "p30b_bug15_unannotated_closure_param_infer" {
  let src =
    #|struct Item {
    #|  id : Int
    #|  t : Double
    #|}
    #|fn my_any[T](xs : Array[T], pred : (T) -> Bool) -> Bool {
    #|  let mut i = 0
    #|  while i < xs.length() {
    #|    if pred(xs[i]) {
    #|      return true
    #|    }
    #|    i += 1
    #|  }
    #|  false
    #|}
    #|pub fn check_items(xs : Array[Item], cap_int : Int, cap_double : Double) -> Bool {
    #|  my_any(xs, fn(e) { e.id == cap_int && e.t > cap_double })
    #|}
  let cr = check_source_files_full("p30b_b15", ["p30b_b15.pion"], [src])
