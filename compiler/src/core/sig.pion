///|
pub struct SigEntry {
  kind : String
  name : String
  signature : String
}

///|
pub struct PackageSig {
  pkg : String
  entries : Array[SigEntry]
}

///|
fn format_type_params(tparams : Array[String]) -> String {
  if tparams.length() == 0 {
    return ""
  }
  let sb = StringBuilder()
  sb.write_string("[")
  let mut i = 0
  while i < tparams.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(tparams[i])
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
pub fn format_struct_sig(sd : StructDecl) -> String {
  let sb = StringBuilder()
  if sd.derive_eq {
    sb.write_string("#derive(Eq) ")
  }
  if sd.is_val {
    sb.write_string("val ")
  }
  sb.write_string("struct ")
  sb.write_string(sd.name)
  sb.write_string(format_type_params(sd.type_params))
  sb.write_string(" { ")
  let mut i = 0
  while i < sd.fields.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    let f = sd.fields[i]
    if f.is_priv {
      sb.write_string("priv ")
    }
    if f.is_mut {
      sb.write_string("mut ")
    }
    sb.write_string(f.name)
    sb.write_string(": ")
    sb.write_string(type_expr_to_string(f.ty))
    i = i + 1
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
pub fn format_enum_sig(ed : EnumDecl) -> String {
  let sb = StringBuilder()
  if ed.derive_eq {
    sb.write_string("#derive(Eq) ")
  }
  sb.write_string("enum ")
  sb.write_string(ed.name)
  sb.write_string(format_type_params(ed.type_params))
  sb.write_string(" { ")
  let mut i = 0
  while i < ed.variants.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    let v = ed.variants[i]
    sb.write_string(v.name)
    if v.fields.length() > 0 {
      sb.write_string("(")
      let mut j = 0
      while j < v.fields.length() {
        if j > 0 {
          sb.write_string(", ")
        }
        sb.write_string(type_expr_to_string(v.fields[j]))
        j = j + 1
      }
      sb.write_string(")")
    }
    i = i + 1
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
fn format_type_params_with_bounds(
  tparams : Array[String],
  bounds : Array[TypeBound],
) -> String {
  if tparams.length() == 0 {
    return ""
  }
  let sb = StringBuilder()
  sb.write_string("[")
  let mut i = 0
  while i < tparams.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    let tp = tparams[i]
    sb.write_string(tp)
    let mut bi = 0
    while bi < bounds.length() {
      if bounds[bi].param == tp && bounds[bi].traits.length() > 0 {
        sb.write_string(" : ")
        let mut ti = 0
        while ti < bounds[bi].traits.length() {
          if ti > 0 {
            sb.write_string(" + ")
          }
          sb.write_string(bounds[bi].traits[ti])
          ti = ti + 1
        }
        break
      }
      bi = bi + 1
    }
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
fn format_simple_default_expr(e : Expr) -> Option[String] {
  match e {
    EInt(s, _) => Some(s)
    EInt64(s, _) => Some(s + "L")
    EUInt(s, _) => Some(s)
    EUInt64(s, _) => Some(s)
    EDouble(s, _) => Some(s)
    EFloat(s, _) => Some(s)
    EBool(b, _) => Some(if b { "true" } else { "false" })
    EByte(s, _) => Some("b'" + s + "'")
    EChar(s, _) => Some("'" + s + "'")
    EString(s, _) => Some(json_quote(s))
    EIdent(name, _) => if name == "None" { Some("None") } else { None }
    EUnit(_) => Some("()")
    EUnary(op, inner, _) =>
      if op == "-" || op == "!" {
        match format_simple_default_expr(inner) {
          Some(s) => Some(op + s)
          None => None
        }
      } else {
        None
      }
    EArrayLit(elems, _) => if elems.length() == 0 { Some("[]") } else { None }
    _ => None
  }
}

///|
fn write_param_sig(sb : StringBuilder, param : Param, spaced_colon : Bool) -> Unit {
  write_param_sig_ex(sb, param, spaced_colon, false)
}

///|
fn write_param_sig_ex(
  sb : StringBuilder,
  param : Param,
  spaced_colon : Bool,
  emit_stub_default : Bool,
) -> Unit {
  if param.is_into {
    sb.write_string("into ")
  }
  if param.is_mut {
    sb.write_string("mut ")
  }
  sb.write_string(param.name)
  if param.label_kind == 1 {
    sb.write_string("~")
  } else if param.label_kind == 2 {
    sb.write_string("?")
  }
  let skip_ty = emit_stub_default &&
    match param.ty {
      TyMissing(_) => true
      _ => false
    }
  if !skip_ty {
    if spaced_colon {
      sb.write_string(" : ")
    } else {
      sb.write_string(": ")
    }
    sb.write_string(type_expr_to_string(param.ty))
  }
  match param.default_expr {
    Some(def) => {
      sb.write_string(" = ")
      if emit_stub_default {
        stub_write_expr(sb, def)
      } else {
        match format_simple_default_expr(def) {
          Some(s) => sb.write_string(s)
          None => sb.write_string("<expr>")
        }
      }
    }
    None => ()
  }
}

///|
/// `#verify ` / `#verify_opaque ` prefix of a signature line (empty otherwise,
/// keeping pre-`#verify` `.pionsig` bytes unchanged).
pub fn verify_attr_prefix(fd : FnDecl) -> String {
  if fd.is_verify_opaque {
    "#verify_opaque "
  } else if fd.is_verify {
    "#verify "
  } else {
    ""
  }
}

///|
pub fn fn_attr_prefix(fd : FnDecl) -> String {
  let vp = verify_attr_prefix(fd)
  if fd.is_into {
    "#into " + vp
  } else {
    vp
  }
}

///|
pub fn format_fn_sig(fd : FnDecl) -> String {
  let sb = StringBuilder()
  sb.write_string(fn_attr_prefix(fd))
  sb.write_string("fn ")
  if fd.receiver_type != "" {
    sb.write_string(fd.receiver_type)
    sb.write_string("::")
  }
  sb.write_string(fd.name)
  sb.write_string(format_type_params_with_bounds(fd.type_params, fd.type_bounds))
  sb.write_string("(")
  let mut i = 0
  while i < fd.params.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    write_param_sig(sb, fd.params[i], false)
    i = i + 1
  }
  sb.write_string(") -> ")
  sb.write_string(type_expr_to_string(fd.ret_ty))
  sb.to_string()
}

///|
pub fn format_extern_fn_sig(ed : ExternFnDecl) -> String {
  let sb = StringBuilder()
  sb.write_string("extern \"")
  sb.write_string(ed.abi)
  sb.write_string("\" fn ")
  sb.write_string(ed.name)
  sb.write_string("(")
  let mut i = 0
  while i < ed.params.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    if ed.vararg_from >= 0 && i == ed.vararg_from {
      sb.write_string("..., ")
    }
    let param = ed.params[i]
    sb.write_string(param.name)
    sb.write_string(": ")
    sb.write_string(type_expr_to_string(param.ty))
    i = i + 1
  }
  if ed.vararg_from >= 0 && ed.vararg_from == ed.params.length() {
    if ed.params.length() > 0 {
      sb.write_string(", ")
    }
    sb.write_string("...")
  }
  sb.write_string(") -> ")
  sb.write_string(type_expr_to_string(ed.ret_ty))
  if ed.c_symbol != ed.name {
    sb.write_string(" = ")
    sb.write_string(json_quote(ed.c_symbol))
  }
  if ed.has_body {
    sb.write_string(" { ... }")
  }
  sb.to_string()
}

///|
pub fn format_trait_sig(td : TraitDecl) -> String {
  let sb = StringBuilder()
  sb.write_string("trait ")
  sb.write_string(td.name)
  sb.write_string(" { ")
  let mut i = 0
  while i < td.methods.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    let m = td.methods[i]
    sb.write_string(m.name)
    sb.write_string("(")
    let mut j = 0
    while j < m.params.length() {
      if j > 0 {
        sb.write_string(", ")
      }
      if m.params[j].is_mut {
        sb.write_string("mut ")
      }
      sb.write_string(m.params[j].name)
      sb.write_string(": ")
      sb.write_string(type_expr_to_string(m.params[j].ty))
      j = j + 1
    }
    sb.write_string(") -> ")
    sb.write_string(type_expr_to_string(m.ret_ty))
    i = i + 1
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
pub fn format_impl_sig(id : ImplDecl) -> String {
  let sb = StringBuilder()
  sb.write_string("impl")
  sb.write_string(format_type_params_with_bounds(id.type_params, id.type_bounds))
  sb.write_string(" ")
  sb.write_string(id.trait_name)
  sb.write_string(" for ")
  sb.write_string(id.target_type)
  if id.target_type_args.length() > 0 {
    sb.write_string("[")
    let mut ai = 0
    while ai < id.target_type_args.length() {
      if ai > 0 {
        sb.write_string(", ")
      }
      sb.write_string(type_expr_to_string(id.target_type_args[ai]))
      ai = ai + 1
    }
    sb.write_string("]")
  }
  sb.write_string(" { ")
  let mut i = 0
  while i < id.methods.length() {
    if i > 0 {
      sb.write_string("; ")
    }
    sb.write_string(format_fn_sig(id.methods[i]))
    i = i + 1
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
pub fn format_const_sig(cd : ConstDecl) -> String {
  "const " + cd.name + ": " + type_expr_to_string(cd.ty)
}

///|
fn sig_kind_rank(kind : String) -> Int {
  if kind == "struct" {
    0
  } else if kind == "enum" {
    1
  } else if kind == "trait" {
    2
  } else if kind == "impl" {
    3
  } else if kind == "const" {
    4
  } else if kind == "extern_fn" {
    5
  } else {
    6
  }
}

///|
fn sig_entry_lt(a : SigEntry, b : SigEntry) -> Bool {
  let ra = sig_kind_rank(a.kind)
  let rb = sig_kind_rank(b.kind)
  if ra != rb {
    ra < rb
  } else {
    a.name < b.name
  }
}

///|
fn sig_sort_range(entries : Array[SigEntry], left : Array[SigEntry], lo : Int, hi : Int) -> Unit {
  if hi - lo < 2 { return }
  let mid = lo + (hi - lo) / 2
  sig_sort_range(entries, left, lo, mid)
  sig_sort_range(entries, left, mid, hi)
  if !sig_entry_lt(entries[mid], entries[mid - 1]) { return }
  let mut i = 0
  while i < mid - lo {
    left[i] = entries[lo + i]
    i = i + 1
  }
  i = 0
  let mut j = mid
  let mut out = lo
  // While there is a buffered left entry, out < j, so the right suffix is intact.
  while i < mid - lo {
    if j < hi && sig_entry_lt(entries[j], left[i]) {
      entries[out] = entries[j]
      j = j + 1
    } else {
      entries[out] = left[i]
      i = i + 1
    }
    out = out + 1
  }
}

///|
fn sort_sig_entries(entries : Array[SigEntry]) -> Unit {
  let n = entries.length()
  if n < 2 { return }
  let left = Array::make(n - n / 2, entries[0])
  sig_sort_range(entries, left, 0, n)
}

///|
pub fn extract_package_sig(pkg : Package) -> PackageSig {
  let entries : Array[SigEntry] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          if sd.is_pub {
            entries.push(SigEntry::{
              kind: "struct",
              name: sd.name,
              signature: format_struct_sig(sd),
            })
          }
        DEnum(ed) =>
          if ed.is_pub {
            entries.push(SigEntry::{
              kind: "enum",
              name: ed.name,
              signature: format_enum_sig(ed),
            })
          }
        DFn(fd) =>
          if fd.is_pub {
            let full_name = if fd.receiver_type != "" {
              fd.receiver_type + "::" + fd.name
            } else {
              fd.name
            }
            entries.push(SigEntry::{
              kind: "fn",
              name: full_name,
              signature: format_fn_sig(fd),
            })
          }
        DExternFn(ed) =>
          if ed.is_pub || ed.has_body {
            entries.push(SigEntry::{
              kind: "extern_fn",
              name: ed.name,
              signature: format_extern_fn_sig(ed),
            })
          }
        DTrait(td) =>
          if td.is_pub {
            entries.push(SigEntry::{
              kind: "trait",
              name: td.name,
              signature: format_trait_sig(td),
            })
          }
        DImpl(id) =>
          entries.push(SigEntry::{
            kind: "impl",
            name: id.trait_name + "::" + id.target_type,
            signature: format_impl_sig(id),
          })
        DConst(cd) =>
          if cd.is_pub {
            entries.push(SigEntry::{
              kind: "const",
              name: cd.name,
              signature: format_const_sig(cd),
            })
          }
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  sort_sig_entries(entries)
  PackageSig::{ pkg: pkg.name, entries: entries }
}

///|
pub fn serialize_pionsig(sig : PackageSig) -> String {
  let sb = StringBuilder()
  sb.write_string("pionsig v1\n")
  sb.write_string("pkg ")
  sb.write_string(sig.pkg)
  sb.write_string("\n")
  let mut i = 0
  while i < sig.entries.length() {
    sb.write_string(sig.entries[i].signature)
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///|
pub fn emit_pionsig(pkg : Package) -> String {
  serialize_pionsig(extract_package_sig(pkg))
}

///|
/// Extract all declarations (pub and package-private signatures, no function bodies)
/// for sound unit-level incremental CAS invalidation across files in a package.
pub fn emit_all_sigs(pkg : Package) -> String {
  let entries : Array[SigEntry] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          entries.push(SigEntry::{
            kind: "struct",
            name: sd.name,
            signature: format_struct_sig(sd),
          })
        DEnum(ed) =>
          entries.push(SigEntry::{
            kind: "enum",
            name: ed.name,
            signature: format_enum_sig(ed),
          })
        DFn(fd) => {
          let full_name = if fd.receiver_type != "" {
            fd.receiver_type + "::" + fd.name
          } else {
            fd.name
          }
          entries.push(SigEntry::{
            kind: "fn",
            name: full_name,
            signature: format_fn_sig(fd),
          })
        }
        DExternFn(ed) =>
          entries.push(SigEntry::{
            kind: "extern_fn",
            name: ed.name,
            signature: format_extern_fn_sig(ed),
          })
        DTrait(td) =>
          entries.push(SigEntry::{
            kind: "trait",
            name: td.name,
            signature: format_trait_sig(td),
          })
        DImpl(id) =>
          entries.push(SigEntry::{
            kind: "impl",
            name: id.trait_name + "::" + id.target_type,
            signature: format_impl_sig(id),
          })
        DConst(cd) =>
          entries.push(SigEntry::{
            kind: "const",
            name: cd.name,
            signature: format_const_sig(cd),
          })
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  sort_sig_entries(entries)
  serialize_pionsig(PackageSig::{ pkg: pkg.name, entries: entries })
}

///|
fn sig_sort_strs(arr : Array[String]) -> Unit {
  let mut i = 1
  while i < arr.length() {
    let key = arr[i]
    let mut j = i - 1
    while j >= 0 && arr[j] > key {
      arr[j + 1] = arr[j]
      j = j - 1
    }
    arr[j + 1] = key
    i = i + 1
  }
}

///|
fn sig_bound_push(bound : Map[String, Int], name : String) -> Unit {
  if name.length() == 0 || name == "_" {
    return
  }
  let cur = match bound.get(name) {
    Some(n) => n
    None => 0
  }
  bound.set(name, cur + 1)
}

///|
fn sig_bound_pop(bound : Map[String, Int], name : String) -> Unit {
  if name.length() == 0 || name == "_" {
    return
  }
  match bound.get(name) {
    Some(n) =>
      if n > 1 {
        bound.set(name, n - 1)
      } else {
        bound.set(name, 0)
      }
    None => ()
  }
}

///|
fn sig_is_bound(bound : Map[String, Int], name : String) -> Bool {
  match bound.get(name) {
    Some(n) => n > 0
    None => false
  }
}

///|
fn sig_collect_pat_binds(pat : Pattern, out : Array[String]) -> Unit {
  match pat {
    PIdent(name, _) =>
      if name != "_" {
        out.push(name)
      }
    PVariant(_, _, sub, _, _) | PTuple(sub, _) => {
      let mut i = 0
      while i < sub.length() {
        sig_collect_pat_binds(sub[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn sig_collect_pat_const_deps(
  pat : Pattern,
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  match pat {
    PTuple(sub, _) => {
      let mut i = 0
      while i < sub.length() {
        sig_collect_pat_const_deps(sub[i], idents, ident_list, calls, call_list, ctx)
        i = i + 1
      }
    }
    PVariant(pat_enum, vname, sub, explicit_ctor, sp) =>
      if sub.length() > 0 {
        let mut i = 0
        while i < sub.length() {
          sig_collect_pat_const_deps(sub[i], idents, ident_list, calls, call_list, ctx)
          i = i + 1
        }
      } else if !explicit_ctor {
        if ctx.has_tc {
          match ctx.resolved_methods.get("pat_const:" + span_key(sp)) {
            Some(ckey) =>
              if !has_qual_sep(ckey) && !idents.contains(ckey) {
                idents.set(ckey, true)
                ident_list.push(ckey)
              }
            None => ()
          }
        } else if pat_enum == "" {
          let desc = "pat?:" + vname + "@0"
          if !calls.contains(desc) {
            calls.set(desc, true)
            call_list.push(desc)
          }
        }
      }
    _ => ()
  }
}

///|
struct SigLocalCallable {
  depth : Int
  targets : Array[String]
  mut exact : Bool
  slot_key : String
  cslots : Array[String]
  mut cslot_unknown : Bool
  param_srcs : Array[String]
  payload_evals : Array[SigLocalLetEval]
  field_targets : Map[String, Array[String]]
  field_param_srcs : Map[String, Array[String]]
  mut fields_exact : Bool
}

///|
struct SigCbState {
  cb_key : String
  cpnames : Array[String]
  idents : Map[String, Bool]
  ident_list : Array[String]
  calls : Map[String, Bool]
  call_list : Array[String]
  direct_callp : Map[Int, Bool]
  fwd_callp : Map[String, Bool]
  fwd_callp_list : Array[String]
  mut_param_writes : Map[Int, Array[String]]
  mut_param_fwds : Array[String]
  cb_mut_writes : Map[String, Array[String]]
  cb_mut_fwds : Array[String]
  cb_param_calls : Array[String]
  cb_param_fwds : Array[String]
  mut fdep_idx : Int
  mut fcallp_idx : Int
  mut fret_idx : Int
}

///|
struct SigDepCtx {
  resolved_methods : Map[String, String]
  has_tc : Bool
  extra_fdeps : Array[String]
  mut cb_counter : Int
  cb_prefix : String
  root_cb_prefix : String
  cur_fn_key : String
  mut cond_depth : Int
  param_idx : Map[String, Int]
  param_depth : Map[String, Int]
  mut param_callable : Map[Int, Bool]
  direct_callp : Map[Int, Bool]
  fwd_callp : Map[String, Bool]
  fwd_callp_list : Array[String]
  local_callables : Map[String, Array[SigLocalCallable]]
  mut_slot_targets : Map[String, Array[String]]
  mut_slot_exact : Map[String, Bool]
  mut_slot_order : Array[String]
  mut_slot_param_srcs : Map[String, Array[String]]
  cslot_targets : Map[String, Array[String]]
  cslot_fields : Map[String, Map[String, Array[String]]]
  cslot_ref_keys : Map[String, Array[String]]
  cslot_dirty : Map[String, Bool]
  cslot_order : Array[String]
  cslot_by_site : Map[String, String]
  mut_slot_by_site : Map[String, String]
  cb_by_site : Map[String, String]
  cb_states : Map[String, SigCbState]
  cb_order : Array[String]
  mut_param_writes : Map[Int, Array[String]]
  mut_param_fwds : Array[String]
  cb_mut_writes : Map[String, Array[String]]
  cb_mut_fwds : Array[String]
  cb_param_calls : Array[String]
  cb_param_fwds : Array[String]
  escaped_cbs : Array[String]
  slot_mut_links : Array[String]
  slot_mut_links_seen : Map[String, Bool]
  cslot_hub_lens : Array[Int]
  cslot_hub_seen : Map[Int, Bool]
  cslot_dirty_prefix_max : Array[Int]
  field_writes : Map[String, Array[String]]
  field_write_order : Array[String]
  field_puts : Map[String, Array[String]]
  field_put_order : Array[String]
  field_write_params : Array[String]
  field_put_params : Array[String]
  ret_targets : Array[String]
  ret_seen : Map[String, Bool]
  mut isolated_struct_locals : Map[String, Bool]
}

///|
fn sig_dep_ctx_new(
  resolved_methods : Map[String, String],
  has_tc : Bool,
  cb_prefix : String,
  cur_fn_key : String,
  param_idx : Map[String, Int],
) -> SigDepCtx {
  SigDepCtx::{
    resolved_methods: resolved_methods,
    has_tc: has_tc,
    extra_fdeps: [],
    cb_counter: 0,
    cb_prefix: cb_prefix,
    root_cb_prefix: cb_prefix,
    cur_fn_key: cur_fn_key,
    cond_depth: 0,
    param_idx: param_idx,
    param_depth: Map([]),
    param_callable: Map([]),
    direct_callp: Map([]),
    fwd_callp: Map([]),
    fwd_callp_list: [],
    local_callables: Map([]),
    mut_slot_targets: Map([]),
    mut_slot_exact: Map([]),
    mut_slot_order: [],
    mut_slot_param_srcs: Map([]),
    cslot_targets: Map([]),
    cslot_fields: Map([]),
    cslot_ref_keys: Map([]),
    cslot_dirty: Map([]),
    cslot_order: [],
    cslot_by_site: Map([]),
    mut_slot_by_site: Map([]),
    cb_by_site: Map([]),
    cb_states: Map([]),
    cb_order: [],
    mut_param_writes: Map([]),
    mut_param_fwds: [],
    cb_mut_writes: Map([]),
    cb_mut_fwds: [],
    cb_param_calls: [],
    cb_param_fwds: [],
    escaped_cbs: [],
    slot_mut_links: [],
    slot_mut_links_seen: Map([]),
    cslot_hub_lens: [],
    cslot_hub_seen: Map([]),
    cslot_dirty_prefix_max: [0],
    field_writes: Map([]),
    field_write_order: [],
    field_puts: Map([]),
    field_put_order: [],
    field_write_params: [],
    field_put_params: [],
    ret_targets: [],
    ret_seen: Map([]),
    isolated_struct_locals: Map([]),
  }
}

///|
fn sig_dep_ctx_child_for_cb(
  parent : SigDepCtx,
  st : SigCbState,
  param_idx : Map[String, Int],
  param_depth : Map[String, Int],
) -> SigDepCtx {
  SigDepCtx::{
    resolved_methods: parent.resolved_methods,
    has_tc: parent.has_tc,
    extra_fdeps: parent.extra_fdeps,
    cb_counter: 0,
    cb_prefix: st.cb_key + "_",
    root_cb_prefix: parent.root_cb_prefix,
    cur_fn_key: st.cb_key,
    cond_depth: 0,
    param_idx: param_idx,
    param_depth: param_depth,
    param_callable: Map([]),
    direct_callp: st.direct_callp,
    fwd_callp: st.fwd_callp,
    fwd_callp_list: st.fwd_callp_list,
    local_callables: Map([]),
    mut_slot_targets: parent.mut_slot_targets,
    mut_slot_exact: parent.mut_slot_exact,
    mut_slot_order: parent.mut_slot_order,
    mut_slot_param_srcs: parent.mut_slot_param_srcs,
    cslot_targets: parent.cslot_targets,
    cslot_fields: parent.cslot_fields,
    cslot_ref_keys: parent.cslot_ref_keys,
    cslot_dirty: parent.cslot_dirty,
    cslot_order: parent.cslot_order,
    cslot_by_site: parent.cslot_by_site,
    mut_slot_by_site: parent.mut_slot_by_site,
    cb_by_site: parent.cb_by_site,
    cb_states: parent.cb_states,
    cb_order: parent.cb_order,
    mut_param_writes: st.mut_param_writes,
    mut_param_fwds: st.mut_param_fwds,
    cb_mut_writes: st.cb_mut_writes,
    cb_mut_fwds: st.cb_mut_fwds,
    cb_param_calls: st.cb_param_calls,
    cb_param_fwds: st.cb_param_fwds,
    escaped_cbs: [],
    slot_mut_links: parent.slot_mut_links,
    slot_mut_links_seen: parent.slot_mut_links_seen,
    cslot_hub_lens: parent.cslot_hub_lens,
    cslot_hub_seen: parent.cslot_hub_seen,
    cslot_dirty_prefix_max: parent.cslot_dirty_prefix_max,
    field_writes: parent.field_writes,
    field_write_order: parent.field_write_order,
    field_puts: parent.field_puts,
    field_put_order: parent.field_put_order,
    field_write_params: parent.field_write_params,
    field_put_params: parent.field_put_params,
    ret_targets: [],
    ret_seen: Map([]),
    isolated_struct_locals: Map([]),
  }
}

///|
fn sig_bound_depth(bound : Map[String, Int], name : String) -> Int {
  match bound.get(name) {
    Some(n) => n
    None => 0
  }
}

///|
fn sig_local_callable_set_entry(
  bound : Map[String, Int],
  ctx : SigDepCtx,
  name : String,
  entry : SigLocalCallable,
) -> Unit {
  let d = sig_bound_depth(bound, name)
  if d <= 0 {
    return
  }
  match ctx.local_callables.get(name) {
    Some(stack) =>
      if stack.length() > 0 && stack[stack.length() - 1].depth == d {
        stack[stack.length() - 1] = entry
      } else {
        stack.push(entry)
      }
    None => ctx.local_callables.set(name, [entry])
  }
}

///|
fn sig_local_callable_get_entry(
  bound : Map[String, Int],
  ctx : SigDepCtx,
  name : String,
) -> Option[SigLocalCallable] {
  let d = sig_bound_depth(bound, name)
  if d <= 0 {
    return None
  }
  match ctx.local_callables.get(name) {
    Some(stack) =>
      if stack.length() > 0 && stack[stack.length() - 1].depth == d {
        Some(stack[stack.length() - 1])
      } else {
        None
      }
    None => None
  }
}

///|
fn sig_union_str_array(cur : Array[String], extra : Array[String]) -> Unit {
  let mut ei = 0
  while ei < extra.length() {
    let t = extra[ei]
    let mut exists = false
    let mut ci = 0
    while ci < cur.length() {
      if cur[ci] == t {
        exists = true
        break
      }
      ci = ci + 1
    }
    if !exists {
      cur.push(t)
    }
    ei = ei + 1
  }
}

///|
fn sig_mut_place_root(e : Expr) -> String {
  let mut cur = e
  while true {
    match cur {
      EIdent(name, _) => return name
      EField(base, _, _)
      | EIndex(base, _, _)
      | EMutArg(base, _)
      | EMove(base, _)
      | ENamedArg(_, _, base, _) => cur = base
      _ => return ""
    }
  }
  ""
}

///|
fn sig_cslot_is_dirty(ctx : SigDepCtx, ck : String) -> Bool {
  match ctx.cslot_dirty.get(ck) {
    Some(true) => true
    _ => false
  }
}

///|
fn sig_cslot_new(ctx : SigDepCtx) -> String {
  let ck = "$cslot_" + ctx.cb_prefix + ctx.cb_counter.to_string()
  ctx.cb_counter = ctx.cb_counter + 1
  ctx.cslot_targets.set(ck, [])
  ctx.cslot_fields.set(ck, Map([]))
  ctx.cslot_ref_keys.set(ck, [])
  ctx.cslot_dirty.set(ck, false)
  ctx.cslot_order.push(ck)
  ck
}

///|
fn sig_cslot_for_site(ctx : SigDepCtx, site_key : String) -> String {
  match ctx.cslot_by_site.get(site_key) {
    Some(ck) => ck
    None => {
      let ck = sig_cslot_new(ctx)
      ctx.cslot_by_site.set(site_key, ck)
      ck
    }
  }
}

///|
fn sig_add_slot_mut_link(ctx : SigDepCtx, link : String) -> Unit {
  if !ctx.slot_mut_links_seen.contains(link) {
    ctx.slot_mut_links_seen.set(link, true)
    ctx.slot_mut_links.push(link)
  }
}

///|
fn sig_mark_all_cslots_dirty(ctx : SigDepCtx) -> Unit {
  let n = ctx.cslot_order.length()
  if n > ctx.cslot_dirty_prefix_max[0] {
    ctx.cslot_dirty_prefix_max[0] = n
  }
}

///|
fn sig_cslot_hub_key(ctx : SigDepCtx, n : Int) -> String {
  "$cslot_hub_" + ctx.root_cb_prefix + n.to_string()
}

///|
fn sig_ensure_cslot_hub(ctx : SigDepCtx) -> String {
  let n = ctx.cslot_order.length()
  if n == 0 {
    return ""
  }
  if !ctx.cslot_hub_seen.contains(n) {
    ctx.cslot_hub_seen.set(n, true)
    ctx.cslot_hub_lens.push(n)
  }
  sig_cslot_hub_key(ctx, n)
}

///|
fn sig_link_all_cslots_mut(
  ctx : SigDepCtx,
  target : String,
  slot_key : String,
  dirty_all : Bool,
) -> Unit {
  if dirty_all {
    sig_mark_all_cslots_dirty(ctx)
  }
  let hkey = sig_ensure_cslot_hub(ctx)
  if hkey != "" {
    sig_add_slot_mut_link(ctx, hkey + "|" + target + "|" + slot_key)
  }
}

///|
fn sig_cslot_hub_add_targets(ctx : SigDepCtx, ts : Array[String]) -> Unit {
  if ts.length() == 0 {
    return
  }
  let hkey = sig_ensure_cslot_hub(ctx)
  if hkey != "" {
    sig_cslot_add_targets(ctx, hkey, ts)
  }
}

///|
fn sig_sort_ints(arr : Array[Int]) -> Unit {
  let mut i = 1
  while i < arr.length() {
    let v = arr[i]
    let mut j = i
    while j > 0 && arr[j - 1] > v {
      arr[j] = arr[j - 1]
      j = j - 1
    }
    arr[j] = v
    i = i + 1
  }
}

///|
fn sig_cslot_add_targets(ctx : SigDepCtx, ck : String, ts : Array[String]) -> Unit {
  if ts.length() == 0 {
    return
  }
  match ctx.cslot_targets.get(ck) {
    Some(cur) => sig_union_str_array(cur, ts)
    None => {
      let arr : Array[String] = []
      sig_union_str_array(arr, ts)
      ctx.cslot_targets.set(ck, arr)
    }
  }
}

///|
fn sig_cslot_add_field(ctx : SigDepCtx, ck : String, fkey : String, ts : Array[String]) -> Unit {
  if ts.length() == 0 {
    return
  }
  match ctx.cslot_fields.get(ck) {
    Some(fm) => sig_field_add_targets(fm, fkey, ts)
    None => {
      let fm : Map[String, Array[String]] = Map([])
      sig_field_add_targets(fm, fkey, ts)
      ctx.cslot_fields.set(ck, fm)
    }
  }
}

///|
fn sig_cslot_record_ref(ctx : SigDepCtx, ck : String, fkey : String) -> Unit {
  match ctx.cslot_ref_keys.get(ck) {
    Some(cur) => sig_union_str_array(cur, [fkey])
    None => ctx.cslot_ref_keys.set(ck, [fkey])
  }
}

///|
fn sig_mark_mut_place_dirty(e : Expr, bound : Map[String, Int], ctx : SigDepCtx) -> Unit {
  let rname = sig_mut_place_root(e)
  if rname != "" && sig_is_bound(bound, rname) {
    match sig_local_callable_get_entry(bound, ctx, rname) {
      Some(entry) => {
        if entry.slot_key != "" {
          ctx.mut_slot_exact.set(entry.slot_key, false)
        }
        let mut ci = 0
        while ci < entry.cslots.length() {
          ctx.cslot_dirty.set(entry.cslots[ci], true)
          ci = ci + 1
        }
        entry.exact = false
      }
      None => ()
    }
  }
}

///|
fn sig_mark_container_alias_dirty(e : Expr, bound : Map[String, Int], ctx : SigDepCtx) -> Unit {
  let inner = match e {
    ENamedArg(_, _, x, _) | EMutArg(x, _) | EMove(x, _) => x
    x => x
  }
  match inner {
    EIdent(cname, _) =>
      if sig_is_bound(bound, cname) {
        match sig_local_callable_get_entry(bound, ctx, cname) {
          Some(entry) => {
            let mut ci = 0
            while ci < entry.cslots.length() {
              ctx.cslot_dirty.set(entry.cslots[ci], true)
              ci = ci + 1
            }
          }
          None => ()
        }
      }
    _ => ()
  }
}

///|
fn sig_field_add_targets(
  fields : Map[String, Array[String]],
  fkey : String,
  ts : Array[String],
) -> Unit {
  if ts.length() == 0 {
    return
  }
  match fields.get(fkey) {
    Some(cur) => sig_union_str_array(cur, ts)
    None => {
      let arr : Array[String] = []
      sig_union_str_array(arr, ts)
      fields.set(fkey, arr)
    }
  }
}

///|
fn sig_entry_all_param_srcs(entry : SigLocalCallable, ctx : SigDepCtx) -> Array[String] {
  let out : Array[String] = []
  sig_union_str_array(out, entry.param_srcs)
  if entry.slot_key != "" {
    match ctx.mut_slot_param_srcs.get(entry.slot_key) {
      Some(sp) => sig_union_str_array(out, sp)
      None => ()
    }
  }
  out
}

///|
fn sig_clone_psrc_env(env : Map[String, Array[String]]) -> Map[String, Array[String]] {
  let out : Map[String, Array[String]] = Map([])
  let ks = env.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match env.get(k) {
      Some(vs) => {
        let copy : Array[String] = []
        sig_union_str_array(copy, vs)
        out.set(k, copy)
      }
      None => ()
    }
    i = i + 1
  }
  out
}

///|
fn sig_collect_tuple_elem_param_srcs_env(
  e : Expr,
  idx : Int,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  env : Map[String, Array[String]],
  out : Array[String],
) -> Unit {
  match e {
    EMove(x, _) | EAs(x, _, _) | ETry(x, _) =>
      sig_collect_tuple_elem_param_srcs_env(x, idx, bound, ctx, env, out)
    ETuple(elems, _) =>
      if idx >= 0 && idx < elems.length() {
        sig_collect_expr_param_srcs_env(elems[idx], bound, ctx, env, out)
      }
    EBlock(stmts, _) => {
      let benv = sig_clone_psrc_env(env)
      let mut i = 0
      while i < stmts.length() {
        let is_last = i + 1 == stmts.length()
        match stmts[i] {
          SLet(lname, _, _, init_e, _) => {
            let ps : Array[String] = []
            sig_collect_expr_param_srcs_env(init_e, bound, ctx, benv, ps)
            benv.set(lname, ps)
          }
          SLetTuple(names, _, init_e, _) => {
            let ps_all : Array[Array[String]] = []
            let mut ni = 0
            while ni < names.length() {
              let ps : Array[String] = []
              sig_collect_tuple_elem_param_srcs_env(init_e, ni, bound, ctx, benv, ps)
              ps_all.push(ps)
              ni = ni + 1
            }
            ni = 0
            while ni < names.length() {
              benv.set(names[ni], ps_all[ni])
              ni = ni + 1
            }
          }
          SAssign(EIdent(lname, _), rhs_e, _) => {
            let ps : Array[String] = []
            sig_collect_expr_param_srcs_env(rhs_e, bound, ctx, benv, ps)
            match benv.get(lname) {
              Some(cur) => sig_union_str_array(cur, ps)
              None => ()
            }
          }
          SExpr(e2, _) =>
            if is_last {
              sig_collect_tuple_elem_param_srcs_env(e2, idx, bound, ctx, benv, out)
            }
          _ => ()
        }
        i = i + 1
      }
    }
    EIf(_, tb, eb, _) => {
      sig_collect_tuple_elem_param_srcs_env(EBlock(tb, expr_span(e)), idx, bound, ctx, env, out)
      match eb {
        Some(ee) =>
          sig_collect_tuple_elem_param_srcs_env(ee, idx, bound, ctx, sig_clone_psrc_env(env), out)
        None => ()
      }
    }
    EMatch(_, arms, _) => {
      let mut ai = 0
      while ai < arms.length() {
        let arm_env = sig_clone_psrc_env(env)
        let pbinds : Array[String] = []
        sig_collect_pat_binds(arms[ai].pat, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          arm_env.set(pbinds[bi], [])
          bi = bi + 1
        }
        sig_collect_tuple_elem_param_srcs_env(arms[ai].body, idx, bound, ctx, arm_env, out)
        ai = ai + 1
      }
    }
    _ => sig_collect_expr_param_srcs_env(e, bound, ctx, env, out)
  }
}

///|
fn sig_collect_stmts_param_srcs_env(
  stmts : Array[Stmt],
  bound : Map[String, Int],
  ctx : SigDepCtx,
  env : Map[String, Array[String]],
  out : Array[String],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    let is_last = i + 1 == stmts.length()
    match stmts[i] {
      SLet(lname, _, _, init_e, _) => {
        let ps : Array[String] = []
        sig_collect_expr_param_srcs_env(init_e, bound, ctx, env, ps)
        env.set(lname, ps)
      }
      SLetTuple(names, _, init_e, _) => {
        let ps_all : Array[Array[String]] = []
        let mut ni = 0
        while ni < names.length() {
          let ps : Array[String] = []
          sig_collect_tuple_elem_param_srcs_env(init_e, ni, bound, ctx, env, ps)
          ps_all.push(ps)
          ni = ni + 1
        }
        ni = 0
        while ni < names.length() {
          env.set(names[ni], ps_all[ni])
          ni = ni + 1
        }
      }
      SAssign(EIdent(lname, _), rhs_e, _) => {
        let ps : Array[String] = []
        sig_collect_expr_param_srcs_env(rhs_e, bound, ctx, env, ps)
        match env.get(lname) {
          Some(cur) => sig_union_str_array(cur, ps)
          None => ()
        }
      }
      SExpr(e2, _) =>
        if is_last {
          sig_collect_expr_param_srcs_env(e2, bound, ctx, env, out)
        }
      _ => ()
    }
    i = i + 1
  }
}

///|
fn sig_collect_expr_param_srcs_env(
  e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  env : Map[String, Array[String]],
  out : Array[String],
) -> Unit {
  match e {
    EIdent(src_name, _) =>
      match env.get(src_name) {
        Some(ps) => sig_union_str_array(out, ps)
        None => {
          let spidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, src_name)
          if spidx >= 0 {
            sig_union_str_array(out, [ctx.cur_fn_key + "|" + spidx.to_string()])
          } else if sig_is_bound(bound, src_name) {
            match sig_local_callable_get_entry(bound, ctx, src_name) {
              Some(se) => sig_union_str_array(out, sig_entry_all_param_srcs(se, ctx))
              None => ()
            }
          }
        }
      }
    EMove(x, _) | EAs(x, _, _) | ETry(x, _) | EMutArg(x, _) | ENamedArg(_, _, x, _) =>
      sig_collect_expr_param_srcs_env(x, bound, ctx, env, out)
    EIf(_, tb, eb, _) => {
      sig_collect_stmts_param_srcs_env(tb, bound, ctx, sig_clone_psrc_env(env), out)
      match eb {
        Some(ee) =>
          sig_collect_expr_param_srcs_env(ee, bound, ctx, sig_clone_psrc_env(env), out)
        None => ()
      }
    }
    EMatch(_, arms, _) => {
      let mut ai = 0
      while ai < arms.length() {
        let arm_env = sig_clone_psrc_env(env)
        let pbinds : Array[String] = []
        sig_collect_pat_binds(arms[ai].pat, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          arm_env.set(pbinds[bi], [])
          bi = bi + 1
        }
        sig_collect_expr_param_srcs_env(arms[ai].body, bound, ctx, arm_env, out)
        ai = ai + 1
      }
    }
    EBlock(stmts, _) =>
      sig_collect_stmts_param_srcs_env(stmts, bound, ctx, sig_clone_psrc_env(env), out)
    EIndex(base, _, _) | EField(base, _, _) =>
      sig_collect_expr_param_srcs_env(base, bound, ctx, env, out)
    _ => ()
  }
}

///|
fn sig_collect_expr_param_srcs(
  e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out : Array[String],
) -> Unit {
  sig_collect_expr_param_srcs_env(e, bound, ctx, Map([]), out)
}

///|
fn sig_is_pure_bound_ident(e : Expr, bound : Map[String, Int], ctx : SigDepCtx) -> Bool {
  let inner = match e {
    EMove(x, _) => x
    x => x
  }
  match inner {
    EIdent(name, _) =>
      sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, name) >= 0 ||
      sig_is_bound(bound, name)
    _ => false
  }
}

///|
fn sig_record_param_src_write(ctx : SigDepCtx, psrc : String, rt : Array[String]) -> Unit {
  if rt.length() == 0 {
    return
  }
  let sep = sig_find_char(psrc, 124, 0)
  if sep <= 0 || sep + 1 >= psrc.length() {
    return
  }
  let owner = slice_str(psrc, 0, sep)
  let pidx = sig_parse_nonneg_int(slice_str(psrc, sep + 1, psrc.length()))
  if owner == ctx.cur_fn_key {
    sig_record_param_mut_write(ctx, pidx, rt)
  } else {
    match ctx.cb_mut_writes.get(psrc) {
      Some(cur) => sig_union_str_array(cur, rt)
      None => {
        let arr : Array[String] = []
        sig_union_str_array(arr, rt)
        ctx.cb_mut_writes.set(psrc, arr)
      }
    }
  }
}

///|
fn sig_record_param_srcs_write(ctx : SigDepCtx, psrcs : Array[String], rt : Array[String]) -> Unit {
  let mut i = 0
  while i < psrcs.length() {
    sig_record_param_src_write(ctx, psrcs[i], rt)
    i = i + 1
  }
}

///|
fn sig_record_param_src_fwd(
  ctx : SigDepCtx,
  psrc : String,
  target : String,
  slot_key : String,
) -> Unit {
  let sep = sig_find_char(psrc, 124, 0)
  if sep <= 0 || sep + 1 >= psrc.length() {
    return
  }
  let owner = slice_str(psrc, 0, sep)
  let pidx_s = slice_str(psrc, sep + 1, psrc.length())
  if owner == ctx.cur_fn_key {
    sig_union_str_array(ctx.mut_param_fwds, [pidx_s + "|" + target + "|" + slot_key])
  } else {
    sig_union_str_array(ctx.cb_mut_fwds, [psrc + "|" + target + "|" + slot_key])
  }
}

///|
fn sig_record_param_srcs_fwd(
  ctx : SigDepCtx,
  psrcs : Array[String],
  target : String,
  slot_key : String,
) -> Unit {
  let mut i = 0
  while i < psrcs.length() {
    sig_record_param_src_fwd(ctx, psrcs[i], target, slot_key)
    i = i + 1
  }
}

///|
fn sig_mark_param_srcs_direct_call(psrcs : Array[String], ctx : SigDepCtx) -> Unit {
  let mut i = 0
  while i < psrcs.length() {
    let psrc = psrcs[i]
    let sep = sig_find_char(psrc, 124, 0)
    if sep > 0 && sep + 1 < psrc.length() {
      let owner = slice_str(psrc, 0, sep)
      if owner == ctx.cur_fn_key {
        let pidx = sig_parse_nonneg_int(slice_str(psrc, sep + 1, psrc.length()))
        ctx.direct_callp.set(pidx, true)
      } else {
        sig_union_str_array(ctx.cb_param_calls, [psrc])
      }
    }
    i = i + 1
  }
}

///|
fn sig_is_ctor_call(
  callee : Expr,
  sp : Span,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Bool {
  if ctx.has_tc {
    return ctx.resolved_methods.contains("ctor:" + span_key(sp))
  }
  match callee {
    EIdent(cname, _) =>
      !sig_is_bound(bound, cname) && (cname == "Some" || cname == "Ok" || cname == "Err")
    EPath(qual, mem, _) =>
      (qual == "Option" && mem == "Some") ||
      (qual == "Result" && (mem == "Ok" || mem == "Err"))
    _ => false
  }
}

///|
fn sig_is_fresh_container_ctor(callee : Expr, bound : Map[String, Int]) -> Bool {
  match callee {
    EIdent(cname, _) => !sig_is_bound(bound, cname) && cname == "Map"
    EPath(qual, mem, _) =>
      (qual == "Array" && (mem == "new" || mem == "with_capacity" || mem == "make")) ||
      (qual == "FixedArray" && mem == "make") ||
      (qual == "Map" && (mem == "new" || mem == "with_capacity")) ||
      (qual == "Bytes" && mem == "new")
    _ => false
  }
}

///|
struct SigLocalLetEval {
  targets : Array[String]
  exact : Bool
  cslots : Array[String]
  cslot_unknown : Bool
  param_srcs : Array[String]
  site_key : String
  payload_evals : Array[SigLocalLetEval]
  field_targets : Map[String, Array[String]]
  field_param_srcs : Map[String, Array[String]]
  fields_exact : Bool
}

///|
fn sig_eval_local_let_rhs(
  init_e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> SigLocalLetEval {
  let lt : Array[String] = []
  let lseen : Map[String, Bool] = Map([])
  let lfwd : Array[Int] = []
  let cslots : Array[String] = []
  let mut cslot_unknown = false
  let param_srcs : Array[String] = []
  let payload_evals : Array[SigLocalLetEval] = []
  let field_targets : Map[String, Array[String]] = Map([])
  let field_param_srcs : Map[String, Array[String]] = Map([])
  let mut fields_exact = false
  let unwrapped = match init_e {
    EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
    x => x
  }
  let is_exact = match unwrapped {
    EArrayLit(xs, sp) => {
      let ck = sig_cslot_for_site(ctx, "lit:" + span_key(sp))
      cslots.push(ck)
      let mut xi = 0
      while xi < xs.length() {
        let elt : Array[String] = []
        let eseen : Map[String, Bool] = Map([])
        let efwd : Array[Int] = []
        let _ = sig_extract_callable_targets(xs[xi], bound, ctx, elt, eseen, efwd)
        sig_cslot_add_targets(ctx, ck, elt)
        sig_cslot_add_field(ctx, ck, xi.to_string(), elt)
        xi = xi + 1
      }
      lt.push(ck)
      false
    }
    ETuple(xs, sp) => {
      let ck = sig_cslot_for_site(ctx, "lit:" + span_key(sp))
      cslots.push(ck)
      let mut xi = 0
      while xi < xs.length() {
        let xev = sig_eval_local_let_rhs(xs[xi], bound, ctx)
        payload_evals.push(xev)
        let elt : Array[String] = []
        sig_union_str_array(elt, xev.targets)
        sig_union_str_array(elt, xev.cslots)
        sig_cslot_add_targets(ctx, ck, elt)
        sig_cslot_add_field(ctx, ck, xi.to_string(), elt)
        xi = xi + 1
      }
      lt.push(ck)
      false
    }
    EStructLit(_, spread_opt, sfields, sp) => {
      let ck = sig_cslot_for_site(ctx, "lit:" + span_key(sp))
      cslots.push(ck)
      let mut si = 0
      while si < sfields.length() {
        let fp : Array[String] = []
        sig_collect_expr_param_srcs(sfields[si].value, bound, ctx, fp)
        sig_union_str_array(param_srcs, fp)
        let ft : Array[String] = []
        let fseen : Map[String, Bool] = Map([])
        let ffwd : Array[Int] = []
        let f_exact = sig_extract_callable_targets(sfields[si].value, bound, ctx, ft, fseen, ffwd)
        sig_cslot_add_targets(ctx, ck, ft)
        sig_cslot_add_field(ctx, ck, "." + sfields[si].name, ft)
        if f_exact && (ft.length() > 0 || fp.length() > 0) {
          field_targets.set(sfields[si].name, ft)
          field_param_srcs.set(sfields[si].name, fp)
        }
        si = si + 1
      }
      match spread_opt {
        Some(se) => {
          ctx.cslot_dirty.set(ck, true)
          sig_collect_expr_param_srcs(se, bound, ctx, param_srcs)
          let st : Array[String] = []
          let sseen : Map[String, Bool] = Map([])
          let sfwd : Array[Int] = []
          let _ = sig_extract_callable_targets(se, bound, ctx, st, sseen, sfwd)
          sig_cslot_add_targets(ctx, ck, st)
        }
        None => {
          fields_exact = true
        }
      }
      lt.push(ck)
      false
    }
    EIdent(src_name, _) => {
      sig_collect_expr_param_srcs(unwrapped, bound, ctx, param_srcs)
      if sig_is_bound(bound, src_name) {
        match sig_local_callable_get_entry(bound, ctx, src_name) {
          Some(se) => {
            sig_union_str_array(cslots, se.cslots)
            cslot_unknown = se.cslot_unknown
            if se.slot_key == "" {
              let mut pi = 0
              while pi < se.payload_evals.length() {
                payload_evals.push(se.payload_evals[pi])
                pi = pi + 1
              }
              if se.fields_exact {
                fields_exact = true
                let fks = se.field_targets.keys()
                let mut fki = 0
                while fki < fks.length() {
                  let fk = fks[fki]
                  match se.field_targets.get(fk) {
                    Some(vs) => {
                      let cp : Array[String] = []
                      sig_union_str_array(cp, vs)
                      field_targets.set(fk, cp)
                    }
                    None => ()
                  }
                  fki = fki + 1
                }
                let pks = se.field_param_srcs.keys()
                let mut pki = 0
                while pki < pks.length() {
                  let pk = pks[pki]
                  match se.field_param_srcs.get(pk) {
                    Some(vs) => {
                      let cp : Array[String] = []
                      sig_union_str_array(cp, vs)
                      field_param_srcs.set(pk, cp)
                    }
                    None => ()
                  }
                  pki = pki + 1
                }
              }
            }
          }
          None => ()
        }
      }
      sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
    }
    EDotVariant(_, cargs, _) => {
      let mut ai = 0
      while ai < cargs.length() {
        let aev = sig_eval_local_let_rhs(cargs[ai], bound, ctx)
        payload_evals.push(aev)
        sig_union_str_array(lt, aev.targets)
        sig_union_str_array(cslots, aev.cslots)
        if aev.cslot_unknown {
          cslot_unknown = true
        }
        sig_union_str_array(param_srcs, aev.param_srcs)
        ai = ai + 1
      }
      false
    }
    ECall(callee, cargs, sp) =>
      if sig_is_ctor_call(callee, sp, bound, ctx) {
        let mut ai = 0
        while ai < cargs.length() {
          let aev = sig_eval_local_let_rhs(cargs[ai], bound, ctx)
          payload_evals.push(aev)
          sig_union_str_array(lt, aev.targets)
          sig_union_str_array(cslots, aev.cslots)
          if aev.cslot_unknown {
            cslot_unknown = true
          }
          sig_union_str_array(param_srcs, aev.param_srcs)
          ai = ai + 1
        }
        false
      } else if sig_is_fresh_container_ctor(callee, bound) {
        let ck = sig_cslot_for_site(ctx, "ctor:" + span_key(sp))
        cslots.push(ck)
        match callee {
          EPath(qual, mem, _) =>
            if (qual == "Array" || qual == "FixedArray") && mem == "make" {
              ctx.cslot_dirty.set(ck, true)
            }
          _ => ()
        }
        let mut ai = 0
        while ai < cargs.length() {
          sig_collect_expr_param_srcs(cargs[ai], bound, ctx, param_srcs)
          let at : Array[String] = []
          let aseen : Map[String, Bool] = Map([])
          let afwd : Array[Int] = []
          let _ = sig_extract_callable_targets(cargs[ai], bound, ctx, at, aseen, afwd)
          sig_cslot_add_targets(ctx, ck, at)
          ai = ai + 1
        }
        lt.push(ck)
        false
      } else {
        sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
        let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
        if !ex {
          cslot_unknown = true
        }
        ex
      }
    EBlock(stmts, _) =>
      if stmts.length() == 1 {
        match stmts[0] {
          SExpr(te, _) => return sig_eval_local_let_rhs(te, bound, ctx)
          _ => {
            sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
            let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
            if !ex {
              cslot_unknown = true
            }
            ex
          }
        }
      } else {
        sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
        let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
        if !ex {
          cslot_unknown = true
        }
        ex
      }
    EIf(cond, tb, Some(ee), _) =>
      if tb.length() == 1 {
        match tb[0] {
          SExpr(te, _) => {
            let pbinds : Array[String] = []
            sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
            ctx.cond_depth = ctx.cond_depth + 1
            let ev_then = sig_eval_local_let_rhs(te, bound, ctx)
            ctx.cond_depth = ctx.cond_depth - 1
            let mut bi = 0
            while bi < pbinds.length() {
              sig_bound_pop(bound, pbinds[bi])
              sig_local_callable_prune(bound, ctx, pbinds[bi])
              bi = bi + 1
            }
            ctx.cond_depth = ctx.cond_depth + 1
            let ev_else = sig_eval_local_let_rhs(ee, bound, ctx)
            ctx.cond_depth = ctx.cond_depth - 1
            return sig_merge_local_let_eval(ev_then, ev_else)
          }
          _ => {
            sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
            let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
            if !ex {
              cslot_unknown = true
            }
            ex
          }
        }
      } else {
        sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
        let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
        if !ex {
          cslot_unknown = true
        }
        ex
      }
    EMatch(scrut, arms, _) =>
      if arms.length() > 0 {
        let scrut_eval = sig_eval_local_let_rhs(scrut, bound, ctx)
        let mut has_any = false
        let mut acc = sig_empty_local_let_eval()
        ctx.cond_depth = ctx.cond_depth + 1
        let mut ai = 0
        while ai < arms.length() {
          let pbinds : Array[String] = []
          sig_bind_pat_from_expr(arms[ai].pat, scrut, scrut_eval, bound, ctx, pbinds)
          let ev_arm = sig_eval_local_let_rhs(arms[ai].body, bound, ctx)
          let mut bi = 0
          while bi < pbinds.length() {
            sig_bound_pop(bound, pbinds[bi])
            sig_local_callable_prune(bound, ctx, pbinds[bi])
            bi = bi + 1
          }
          acc = if has_any { sig_merge_local_let_eval(acc, ev_arm) } else { ev_arm }
          has_any = true
          ai = ai + 1
        }
        ctx.cond_depth = ctx.cond_depth - 1
        return acc
      } else {
        sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
        let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
        if !ex {
          cslot_unknown = true
        }
        ex
      }
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EUnit(_)
    | EBinary(_, _, _, _)
    | EUnary(_, _, _)
    | EIs(_, _, _)
    | EInterp(_, _) => false
    _ => {
      sig_collect_expr_param_srcs(init_e, bound, ctx, param_srcs)
      let ex = sig_extract_callable_targets(init_e, bound, ctx, lt, lseen, lfwd)
      if !ex {
        cslot_unknown = true
      }
      ex
    }
  }
  SigLocalLetEval::{
    targets: lt,
    exact: is_exact,
    cslots: cslots,
    cslot_unknown: cslot_unknown,
    param_srcs: param_srcs,
    site_key: span_key(expr_span(init_e)),
    payload_evals: payload_evals,
    field_targets: field_targets,
    field_param_srcs: field_param_srcs,
    fields_exact: fields_exact,
  }
}

///|
fn sig_commit_local_let(
  name : String,
  is_mut : Bool,
  ev : SigLocalLetEval,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  sig_bound_push(bound, name)
  let d = sig_bound_depth(bound, name)
  if is_mut {
    let msite = if ev.site_key != "" {
      "mslot:" + name + ":" + ev.site_key
    } else {
      ""
    }
    let slot_key = if msite != "" {
      match ctx.mut_slot_by_site.get(msite) {
        Some(existing) => {
          match ctx.mut_slot_targets.get(existing) {
            Some(cur) => sig_union_str_array(cur, ev.targets)
            None => ctx.mut_slot_targets.set(existing, ev.targets)
          }
          let prev_ex = match ctx.mut_slot_exact.get(existing) {
            Some(b) => b
            None => false
          }
          ctx.mut_slot_exact.set(existing, prev_ex && ev.exact)
          if ev.param_srcs.length() > 0 {
            match ctx.mut_slot_param_srcs.get(existing) {
              Some(cur) => sig_union_str_array(cur, ev.param_srcs)
              None => {
                let sp : Array[String] = []
                sig_union_str_array(sp, ev.param_srcs)
                ctx.mut_slot_param_srcs.set(existing, sp)
              }
            }
          }
          existing
        }
        None => {
          let sk = "$slot_" + ctx.cb_prefix + ctx.cb_counter.to_string()
          ctx.cb_counter = ctx.cb_counter + 1
          ctx.mut_slot_by_site.set(msite, sk)
          ctx.mut_slot_targets.set(sk, ev.targets)
          ctx.mut_slot_exact.set(sk, ev.exact)
          ctx.mut_slot_order.push(sk)
          if ev.param_srcs.length() > 0 {
            let sp : Array[String] = []
            sig_union_str_array(sp, ev.param_srcs)
            ctx.mut_slot_param_srcs.set(sk, sp)
          }
          sk
        }
      }
    } else {
      let sk = "$slot_" + ctx.cb_prefix + ctx.cb_counter.to_string()
      ctx.cb_counter = ctx.cb_counter + 1
      ctx.mut_slot_targets.set(sk, ev.targets)
      ctx.mut_slot_exact.set(sk, ev.exact)
      ctx.mut_slot_order.push(sk)
      if ev.param_srcs.length() > 0 {
        let sp : Array[String] = []
        sig_union_str_array(sp, ev.param_srcs)
        ctx.mut_slot_param_srcs.set(sk, sp)
      }
      sk
    }
    sig_local_callable_set_entry(
      bound,
      ctx,
      name,
      SigLocalCallable::{
        depth: d,
        targets: [slot_key],
        exact: false,
        slot_key: slot_key,
        cslots: ev.cslots,
        cslot_unknown: ev.cslot_unknown,
        param_srcs: ev.param_srcs,
        payload_evals: [],
        field_targets: Map([]),
        field_param_srcs: Map([]),
        fields_exact: false,
      },
    )
  } else if ev.targets.length() > 0 ||
    ev.cslots.length() > 0 ||
    ev.cslot_unknown ||
    ev.param_srcs.length() > 0 ||
    ev.payload_evals.length() > 0 ||
    ev.fields_exact {
    sig_local_callable_set_entry(
      bound,
      ctx,
      name,
      SigLocalCallable::{
        depth: d,
        targets: ev.targets,
        exact: ev.exact,
        slot_key: "",
        cslots: ev.cslots,
        cslot_unknown: ev.cslot_unknown,
        param_srcs: ev.param_srcs,
        payload_evals: ev.payload_evals,
        field_targets: ev.field_targets,
        field_param_srcs: ev.field_param_srcs,
        fields_exact: ev.fields_exact,
      },
    )
  }
}

///|
fn sig_bind_local_let(
  name : String,
  is_mut : Bool,
  init_e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  let ev = sig_eval_local_let_rhs(init_e, bound, ctx)
  sig_commit_local_let(name, is_mut, ev, bound, ctx)
}

///|
fn sig_record_param_mut_write(ctx : SigDepCtx, pidx : Int, rt : Array[String]) -> Unit {
  if pidx < 0 || rt.length() == 0 {
    return
  }
  match ctx.mut_param_writes.get(pidx) {
    Some(cur) => sig_union_str_array(cur, rt)
    None => {
      let arr : Array[String] = []
      sig_union_str_array(arr, rt)
      ctx.mut_param_writes.set(pidx, arr)
    }
  }
}

///|
fn sig_assign_local(
  name : String,
  rhs : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, name)
  if pidx >= 0 {
    let rt : Array[String] = []
    let rseen : Map[String, Bool] = Map([])
    let rfwd : Array[Int] = []
    let _ = sig_extract_callable_targets(rhs, bound, ctx, rt, rseen, rfwd)
    sig_record_param_mut_write(ctx, pidx, rt)
    return
  }
  if !sig_is_bound(bound, name) {
    return
  }
  let lt : Array[String] = []
  let lseen : Map[String, Bool] = Map([])
  let lfwd : Array[Int] = []
  let rhs_exact = sig_extract_callable_targets(rhs, bound, ctx, lt, lseen, lfwd)
  let rhs_psrcs : Array[String] = []
  sig_collect_expr_param_srcs(rhs, bound, ctx, rhs_psrcs)
  match sig_local_callable_get_entry(bound, ctx, name) {
    Some(entry) => {
      let mut dci = 0
      while dci < entry.cslots.length() {
        ctx.cslot_dirty.set(entry.cslots[dci], true)
        dci = dci + 1
      }
      if rhs_psrcs.length() > 0 {
        sig_union_str_array(entry.param_srcs, rhs_psrcs)
      }
      if entry.slot_key != "" {
        let unwrapped = match rhs {
          EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
          x => x
        }
        let rhs_cslots : Array[String] = []
        let mut rhs_cslot_unknown = false
        match unwrapped {
          EArrayLit(xs, sp) | ETuple(xs, sp) => {
            let new_cslot = sig_cslot_for_site(ctx, "asgn:" + span_key(sp))
            let mut xi = 0
            while xi < xs.length() {
              let elt : Array[String] = []
              let eseen : Map[String, Bool] = Map([])
              let efwd : Array[Int] = []
              let _ = sig_extract_callable_targets(xs[xi], bound, ctx, elt, eseen, efwd)
              sig_cslot_add_targets(ctx, new_cslot, elt)
              sig_cslot_add_field(ctx, new_cslot, xi.to_string(), elt)
              xi = xi + 1
            }
            rhs_cslots.push(new_cslot)
            sig_union_str_array(lt, [new_cslot])
          }
          EStructLit(_, spread_opt, sfields, sp) => {
            let new_cslot = sig_cslot_for_site(ctx, "asgn:" + span_key(sp))
            let mut si = 0
            while si < sfields.length() {
              let ft : Array[String] = []
              let fseen : Map[String, Bool] = Map([])
              let ffwd : Array[Int] = []
              let _ = sig_extract_callable_targets(sfields[si].value, bound, ctx, ft, fseen, ffwd)
              sig_cslot_add_targets(ctx, new_cslot, ft)
              sig_cslot_add_field(ctx, new_cslot, "." + sfields[si].name, ft)
              si = si + 1
            }
            match spread_opt {
              Some(se) => {
                ctx.cslot_dirty.set(new_cslot, true)
                let st : Array[String] = []
                let sseen : Map[String, Bool] = Map([])
                let sfwd : Array[Int] = []
                let _ = sig_extract_callable_targets(se, bound, ctx, st, sseen, sfwd)
                sig_cslot_add_targets(ctx, new_cslot, st)
              }
              None => ()
            }
            rhs_cslots.push(new_cslot)
            sig_union_str_array(lt, [new_cslot])
          }
          EIdent(src_name, _) =>
            if sig_is_bound(bound, src_name) {
              match sig_local_callable_get_entry(bound, ctx, src_name) {
                Some(se) => {
                  sig_union_str_array(rhs_cslots, se.cslots)
                  sig_union_str_array(lt, se.cslots)
                  rhs_cslot_unknown = se.cslot_unknown || se.cslots.length() == 0
                }
                None => rhs_cslot_unknown = true
              }
            } else {
              rhs_cslot_unknown = true
            }
          _ => rhs_cslot_unknown = true
        }
        if ctx.cond_depth == 0 {
          while entry.cslots.length() > 0 {
            let _ = entry.cslots.pop()
          }
          sig_union_str_array(entry.cslots, rhs_cslots)
          entry.cslot_unknown = rhs_cslot_unknown
        } else {
          sig_union_str_array(entry.cslots, rhs_cslots)
          entry.cslot_unknown = entry.cslot_unknown || rhs_cslot_unknown
        }
        if rhs_psrcs.length() > 0 {
          match ctx.mut_slot_param_srcs.get(entry.slot_key) {
            Some(cur) => sig_union_str_array(cur, rhs_psrcs)
            None => {
              let sp : Array[String] = []
              sig_union_str_array(sp, rhs_psrcs)
              ctx.mut_slot_param_srcs.set(entry.slot_key, sp)
            }
          }
        }
        match ctx.mut_slot_targets.get(entry.slot_key) {
          Some(cur) => sig_union_str_array(cur, lt)
          None => ctx.mut_slot_targets.set(entry.slot_key, lt)
        }
        let prev_ex = match ctx.mut_slot_exact.get(entry.slot_key) {
          Some(b) => b
          None => false
        }
        ctx.mut_slot_exact.set(entry.slot_key, prev_ex && rhs_exact)
      } else {
        sig_union_str_array(entry.targets, lt)
        entry.exact = entry.exact && rhs_exact
      }
    }
    None => ()
  }
}

///|
fn sig_assign_container_elem(
  lhs : Expr,
  rhs : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  let rname = sig_mut_place_root(lhs)
  if rname == "" {
    return
  }
  let rt : Array[String] = []
  let rseen : Map[String, Bool] = Map([])
  let rfwd : Array[Int] = []
  let _ = sig_extract_callable_targets(rhs, bound, ctx, rt, rseen, rfwd)
  let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, rname)
  if pidx >= 0 {
    sig_record_param_mut_write(ctx, pidx, rt)
    return
  }
  if !sig_is_bound(bound, rname) {
    return
  }
  let entry = match sig_local_callable_get_entry(bound, ctx, rname) {
    Some(e) => e
    None => {
      let ck = sig_cslot_for_site(ctx, "elem:" + span_key(expr_span(lhs)))
      let ne = SigLocalCallable::{
        depth: sig_bound_depth(bound, rname),
        targets: [ck],
        exact: false,
        slot_key: "",
        cslots: [ck],
        cslot_unknown: false,
        param_srcs: [],
        payload_evals: [],
        field_targets: Map([]),
        field_param_srcs: Map([]),
        fields_exact: false,
      }
      sig_local_callable_set_entry(bound, ctx, rname, ne)
      ne
    }
  }
  entry.fields_exact = false
  let psrcs = sig_entry_all_param_srcs(entry, ctx)
  if psrcs.length() > 0 {
    sig_record_param_srcs_write(ctx, psrcs, rt)
  }
  if entry.slot_key != "" {
    match ctx.mut_slot_targets.get(entry.slot_key) {
      Some(cur) => sig_union_str_array(cur, rt)
      None => ctx.mut_slot_targets.set(entry.slot_key, rt)
    }
    ctx.mut_slot_exact.set(entry.slot_key, false)
  }
  if entry.cslots.length() == 0 {
    let ck = sig_cslot_for_site(ctx, "elem:" + span_key(expr_span(lhs)))
    entry.cslots.push(ck)
    sig_union_str_array(entry.targets, [ck])
    if entry.slot_key != "" {
      match ctx.mut_slot_targets.get(entry.slot_key) {
        Some(cur) => sig_union_str_array(cur, [ck])
        None => ctx.mut_slot_targets.set(entry.slot_key, [ck])
      }
      ctx.mut_slot_exact.set(entry.slot_key, false)
    }
  }
  let mut ci = 0
  while ci < entry.cslots.length() {
    let ck = entry.cslots[ci]
    sig_cslot_add_targets(ctx, ck, rt)
    match lhs {
      EIndex(EIdent(_, _), EInt(ks, _), _) =>
        if sig_is_digits(ks) {
          let k = sig_parse_nonneg_int(ks)
          sig_cslot_add_field(ctx, ck, k.to_string(), rt)
        } else {
          ctx.cslot_dirty.set(ck, true)
        }
      EField(EIdent(_, _), fname, _) => {
        let fkey = if sig_is_digits(fname) { fname } else { "." + fname }
        sig_cslot_add_field(ctx, ck, fkey, rt)
      }
      _ => ctx.cslot_dirty.set(ck, true)
    }
    ci = ci + 1
  }
  if entry.cslot_unknown {
    sig_mark_all_cslots_dirty(ctx)
    sig_cslot_hub_add_targets(ctx, rt)
  }
}

///|
fn sig_emit_mut_slot_fdeps(sb : StringBuilder, ctx : SigDepCtx) -> Unit {
  let mut si = 0
  while si < ctx.mut_slot_order.length() {
    let slot_key = ctx.mut_slot_order[si]
    let tlist = match ctx.mut_slot_targets.get(slot_key) {
      Some(a) => a
      None => []
    }
    let scalls : Array[String] = []
    let mut ti = 0
    while ti < tlist.length() {
      scalls.push(tlist[ti] + "@0")
      ti = ti + 1
    }
    sb.write_string(sig_format_dep_line("#fdep ", slot_key, [], scalls))
    let is_ex = match ctx.mut_slot_exact.get(slot_key) {
      Some(b) => b
      None => false
    }
    if is_ex && tlist.length() > 0 {
      let s_sb = StringBuilder()
      s_sb.write_string("#fslot ")
      s_sb.write_string(slot_key)
      s_sb.write_string("|")
      ti = 0
      while ti < tlist.length() {
        if ti > 0 {
          s_sb.write_string(",")
        }
        s_sb.write_string(tlist[ti])
        ti = ti + 1
      }
      s_sb.write_string("\n")
      sb.write_string(s_sb.to_string())
    }
    si = si + 1
  }
  let hub_lens : Array[Int] = []
  let mut hli = 0
  while hli < ctx.cslot_hub_lens.length() {
    hub_lens.push(ctx.cslot_hub_lens[hli])
    hli = hli + 1
  }
  sig_sort_ints(hub_lens)
  let mut hi = 0
  let mut ci = 0
  while ci < ctx.cslot_order.length() {
    let ck = ctx.cslot_order[ci]
    while hi < hub_lens.length() && hub_lens[hi] <= ci {
      hi = hi + 1
    }
    let tlist = match ctx.cslot_targets.get(ck) {
      Some(a) => a
      None => []
    }
    let scalls : Array[String] = []
    let mut ti = 0
    while ti < tlist.length() {
      scalls.push(tlist[ti] + "@0")
      ti = ti + 1
    }
    if hi < hub_lens.length() {
      scalls.push(sig_cslot_hub_key(ctx, hub_lens[hi]) + "@0")
    }
    sb.write_string(sig_format_dep_line("#fdep ", ck, [], scalls))
    let dirty = ci < ctx.cslot_dirty_prefix_max[0] || sig_cslot_is_dirty(ctx, ck)
    let all_fkeys : Array[String] = []
    match ctx.cslot_fields.get(ck) {
      Some(fm) => sig_union_str_array(all_fkeys, fm.keys())
      None => ()
    }
    match ctx.cslot_ref_keys.get(ck) {
      Some(rks) => sig_union_str_array(all_fkeys, rks)
      None => ()
    }
    sig_sort_strs(all_fkeys)
    let mut fi = 0
    while fi < all_fkeys.length() {
      let fk = all_fkeys[fi]
      let fcalls : Array[String] = []
      if dirty {
        fcalls.push(ck + "@0")
      } else {
        match ctx.cslot_fields.get(ck) {
          Some(fm) =>
            match fm.get(fk) {
              Some(ft) => {
                let mut fti = 0
                while fti < ft.length() {
                  fcalls.push(ft[fti] + "@0")
                  fti = fti + 1
                }
              }
              None => ()
            }
          None => ()
        }
      }
      sb.write_string(sig_format_dep_line("#fdep ", ck + "$f" + fk, [], fcalls))
      fi = fi + 1
    }
    ci = ci + 1
  }
  let mut hr = 0
  while hr < hub_lens.length() {
    let hkey = sig_cslot_hub_key(ctx, hub_lens[hr])
    let hcalls : Array[String] = []
    match ctx.cslot_targets.get(hkey) {
      Some(ht) => {
        let mut hti = 0
        while hti < ht.length() {
          hcalls.push(ht[hti] + "@0")
          hti = hti + 1
        }
      }
      None => ()
    }
    if hr + 1 < hub_lens.length() {
      hcalls.push(sig_cslot_hub_key(ctx, hub_lens[hr + 1]) + "@0")
    }
    sb.write_string(sig_format_dep_line("#fdep ", hkey, [], hcalls))
    hr = hr + 1
  }
  let mut li = 0
  while li < ctx.slot_mut_links.length() {
    sb.write_string("#fmutlink ")
    sb.write_string(ctx.slot_mut_links[li])
    sb.write_string("\n")
    li = li + 1
  }
}

///|
fn sig_record_field_write(
  ctx : SigDepCtx,
  tf_key : String,
  targets : Array[String],
) -> Unit {
  if targets.length() == 0 {
    return
  }
  let k = ctx.cur_fn_key + "|" + tf_key
  match ctx.field_writes.get(k) {
    Some(cur) => sig_union_str_array(cur, targets)
    None => {
      let arr : Array[String] = []
      sig_union_str_array(arr, targets)
      ctx.field_writes.set(k, arr)
      ctx.field_write_order.push(k)
    }
  }
}

///|
fn sig_record_field_put(
  ctx : SigDepCtx,
  tf_key : String,
  targets : Array[String],
) -> Unit {
  if targets.length() == 0 {
    return
  }
  let k = ctx.cur_fn_key + "|" + tf_key
  match ctx.field_puts.get(k) {
    Some(cur) => sig_union_str_array(cur, targets)
    None => {
      let arr : Array[String] = []
      sig_union_str_array(arr, targets)
      ctx.field_puts.set(k, arr)
      ctx.field_put_order.push(k)
    }
  }
}

///|
fn sig_emit_field_summaries(sb : StringBuilder, ctx : SigDepCtx) -> Unit {
  let mut i = 0
  while i < ctx.field_write_order.length() {
    let fname = ctx.field_write_order[i]
    match ctx.field_writes.get(fname) {
      Some(ts) =>
        if ts.length() > 0 {
          sb.write_string("#fieldw ")
          sb.write_string(fname)
          sb.write_string("|")
          let mut j = 0
          while j < ts.length() {
            if j > 0 {
              sb.write_string(",")
            }
            sb.write_string(ts[j])
            j = j + 1
          }
          sb.write_string("\n")
        }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < ctx.field_put_order.length() {
    let fname = ctx.field_put_order[i]
    match ctx.field_puts.get(fname) {
      Some(ts) =>
        if ts.length() > 0 {
          sb.write_string("#fieldp ")
          sb.write_string(fname)
          sb.write_string("|")
          let mut j = 0
          while j < ts.length() {
            if j > 0 {
              sb.write_string(",")
            }
            sb.write_string(ts[j])
            j = j + 1
          }
          sb.write_string("\n")
        }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < ctx.field_write_params.length() {
    sb.write_string("#fieldwp ")
    sb.write_string(ctx.field_write_params[i])
    sb.write_string("\n")
    i = i + 1
  }
  i = 0
  while i < ctx.field_put_params.length() {
    sb.write_string("#fieldpp ")
    sb.write_string(ctx.field_put_params[i])
    sb.write_string("\n")
    i = i + 1
  }
}

///|
fn sig_collect_ret_expr_targets(
  e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let rfwd : Array[Int] = []
  let _ = sig_extract_callable_targets(e, bound, ctx, out, seen, rfwd)
}

///|
fn sig_scan_isolated_workstack(
  root_stmts : Array[Stmt],
  candidates : Map[String, Bool],
  resolved_methods : Map[String, String],
) -> Unit {
  let e_stack : Array[Expr] = []
  let e_clo : Array[Bool] = []
  let s_stack : Array[Stmt] = []
  let s_clo : Array[Bool] = []
  let s_nested : Array[Bool] = []
  let mut ri = root_stmts.length() - 1
  while ri >= 0 {
    s_stack.push(root_stmts[ri])
    s_clo.push(false)
    s_nested.push(false)
    ri = ri - 1
  }
  while e_stack.length() > 0 || s_stack.length() > 0 {
    if e_stack.length() > 0 {
      let e = e_stack[e_stack.length() - 1]
      let in_closure = e_clo[e_clo.length() - 1]
      let _ = e_stack.pop()
      let _ = e_clo.pop()
      match e {
        EIdent(v, _) =>
          if candidates.contains(v) {
            candidates.set(v, false)
          }
        EField(base, _, _) =>
          match base {
            EIdent(_, _) =>
              if in_closure {
                e_stack.push(base)
                e_clo.push(in_closure)
              }
            _ => {
              e_stack.push(base)
              e_clo.push(in_closure)
            }
          }
        EMethodCall(recv, _, args, sp) => {
          let allow_recv = if !in_closure {
            match recv {
              EIdent(_, _) =>
                match resolved_methods.get(span_key(sp)) {
                  Some(rk) => starts_with_str(rk, "@field::")
                  None => false
                }
              _ => false
            }
          } else {
            false
          }
          if !allow_recv {
            e_stack.push(recv)
            e_clo.push(in_closure)
          }
          let mut i = args.length() - 1
          while i >= 0 {
            e_stack.push(args[i])
            e_clo.push(in_closure)
            i = i - 1
          }
        }
        ECall(callee, args, _) => {
          e_stack.push(callee)
          e_clo.push(in_closure)
          let mut i = args.length() - 1
          while i >= 0 {
            e_stack.push(args[i])
            e_clo.push(in_closure)
            i = i - 1
          }
        }
        EUnary(_, x, _)
        | EMove(x, _)
        | EAs(x, _, _)
        | ETry(x, _)
        | EMutArg(x, _)
        | ENamedArg(_, _, x, _) => {
          e_stack.push(x)
          e_clo.push(in_closure)
        }
        EBinary(_, a, b, _) | EIndex(a, b, _) => {
          e_stack.push(b)
          e_clo.push(in_closure)
          e_stack.push(a)
          e_clo.push(in_closure)
        }
        EIs(x, pat, _) => {
          let pbinds : Array[String] = []
          sig_collect_pat_binds(pat, pbinds)
          let mut bi = 0
          while bi < pbinds.length() {
            if candidates.contains(pbinds[bi]) {
              candidates.set(pbinds[bi], false)
            }
            bi = bi + 1
          }
          e_stack.push(x)
          e_clo.push(in_closure)
        }
        EArrayLit(xs, _) | ETuple(xs, _) | EInterp(xs, _) | EDotVariant(_, xs, _) => {
          let mut i = xs.length() - 1
          while i >= 0 {
            e_stack.push(xs[i])
            e_clo.push(in_closure)
            i = i - 1
          }
        }
        EStructLit(_, spread_opt, fields, _) => {
          let mut i = fields.length() - 1
          while i >= 0 {
            e_stack.push(fields[i].value)
            e_clo.push(in_closure)
            i = i - 1
          }
          match spread_opt {
            Some(se) => {
              e_stack.push(se)
              e_clo.push(in_closure)
            }
            None => ()
          }
        }
        EBlock(stmts, _) => {
          let mut i = stmts.length() - 1
          while i >= 0 {
            s_stack.push(stmts[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
        }
        EIf(cond, tb, eb, _) => {
          match eb {
            Some(ee) => {
              e_stack.push(ee)
              e_clo.push(in_closure)
            }
            None => ()
          }
          let mut i = tb.length() - 1
          while i >= 0 {
            s_stack.push(tb[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          e_stack.push(cond)
          e_clo.push(in_closure)
        }
        EMatch(scrut, arms, _) => {
          let mut i = arms.length() - 1
          while i >= 0 {
            let pbinds : Array[String] = []
            sig_collect_pat_binds(arms[i].pat, pbinds)
            let mut bi = 0
            while bi < pbinds.length() {
              if candidates.contains(pbinds[bi]) {
                candidates.set(pbinds[bi], false)
              }
              bi = bi + 1
            }
            e_stack.push(arms[i].body)
            e_clo.push(in_closure)
            match arms[i].guard_expr {
              Some(ge) => {
                e_stack.push(ge)
                e_clo.push(in_closure)
              }
              None => ()
            }
            i = i - 1
          }
          e_stack.push(scrut)
          e_clo.push(in_closure)
        }
        EClosure(_, _, cbody, _) => {
          let mut i = cbody.length() - 1
          while i >= 0 {
            s_stack.push(cbody[i])
            s_clo.push(true)
            s_nested.push(true)
            i = i - 1
          }
        }
        EScope(_, sbody, _) | ESpawn(_, sbody, _) => {
          e_stack.push(sbody)
          e_clo.push(true)
        }
        _ => ()
      }
    } else {
      let st = s_stack[s_stack.length() - 1]
      let in_closure = s_clo[s_clo.length() - 1]
      let nested = s_nested[s_nested.length() - 1]
      let _ = s_stack.pop()
      let _ = s_clo.pop()
      let _ = s_nested.pop()
      match st {
        SLet(name, _, _, rhs, _) => {
          e_stack.push(rhs)
          e_clo.push(in_closure)
          if nested && candidates.contains(name) {
            candidates.set(name, false)
          }
        }
        SLetTuple(names, _, rhs, _) => {
          e_stack.push(rhs)
          e_clo.push(in_closure)
          let mut ni = 0
          while ni < names.length() {
            if candidates.contains(names[ni]) {
              candidates.set(names[ni], false)
            }
            ni = ni + 1
          }
        }
        SAssign(lhs, rhs, _) => {
          e_stack.push(rhs)
          e_clo.push(in_closure)
          let allow_lhs = if !in_closure {
            match lhs {
              EField(EIdent(_, _), _, _) => true
              _ => false
            }
          } else {
            false
          }
          if !allow_lhs {
            e_stack.push(lhs)
            e_clo.push(in_closure)
          }
        }
        SCompoundAssign(_, lhs, rhs, _) => {
          e_stack.push(rhs)
          e_clo.push(in_closure)
          e_stack.push(lhs)
          e_clo.push(in_closure)
        }
        SGuard(cond, eb, _) => {
          let mut i = eb.length() - 1
          while i >= 0 {
            s_stack.push(eb[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          e_stack.push(cond)
          e_clo.push(in_closure)
        }
        SWhile(cond, body, _) => {
          let mut i = body.length() - 1
          while i >= 0 {
            s_stack.push(body[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          e_stack.push(cond)
          e_clo.push(in_closure)
        }
        SFor(init_s, cond_e, step_s, body, _) => {
          let mut i = body.length() - 1
          while i >= 0 {
            s_stack.push(body[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          s_stack.push(step_s)
          s_clo.push(in_closure)
          s_nested.push(true)
          e_stack.push(cond_e)
          e_clo.push(in_closure)
          s_stack.push(init_s)
          s_clo.push(in_closure)
          s_nested.push(true)
        }
        SForRange(vname, s_e, e_e, _, body, _) => {
          if candidates.contains(vname) {
            candidates.set(vname, false)
          }
          let mut i = body.length() - 1
          while i >= 0 {
            s_stack.push(body[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          e_stack.push(e_e)
          e_clo.push(in_closure)
          e_stack.push(s_e)
          e_clo.push(in_closure)
        }
        SForIn(iname, vname, iter, body, _) => {
          if candidates.contains(iname) {
            candidates.set(iname, false)
          }
          if candidates.contains(vname) {
            candidates.set(vname, false)
          }
          let mut i = body.length() - 1
          while i >= 0 {
            s_stack.push(body[i])
            s_clo.push(in_closure)
            s_nested.push(true)
            i = i - 1
          }
          e_stack.push(iter)
          e_clo.push(in_closure)
        }
        SReturn(Some(re), _) => {
          e_stack.push(re)
          e_clo.push(in_closure)
        }
        SDebugAssert(c, m, _) => {
          e_stack.push(m)
          e_clo.push(in_closure)
          e_stack.push(c)
          e_clo.push(in_closure)
        }
        SExpr(e, _) => {
          e_stack.push(e)
          e_clo.push(in_closure)
        }
        _ => ()
      }
    }
  }
}

///|
fn sig_collect_isolated_struct_locals(
  stmts : Array[Stmt],
  param_idx : Map[String, Int],
  resolved_methods : Map[String, String],
) -> Map[String, Bool] {
  let candidates : Map[String, Bool] = Map([])
  let seen_decl : Map[String, Bool] = Map([])
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, _, _, rhs, _) => {
        if seen_decl.contains(name) || param_idx.contains(name) {
          candidates.set(name, false)
        } else {
          seen_decl.set(name, true)
          let unwrapped = match rhs {
            EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
            x => x
          }
          match unwrapped {
            EStructLit(_, None, _, _) => candidates.set(name, true)
            _ => ()
          }
        }
      }
      SLetTuple(names, _, _, _) => {
        let mut ni = 0
        while ni < names.length() {
          candidates.set(names[ni], false)
          ni = ni + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  let ks = candidates.keys()
  if ks.length() == 0 {
    return Map([])
  }
  sig_scan_isolated_workstack(stmts, candidates, resolved_methods)
  let out : Map[String, Bool] = Map([])
  let mut ki = 0
  while ki < ks.length() {
    match candidates.get(ks[ki]) {
      Some(true) => out.set(ks[ki], true)
      _ => ()
    }
    ki = ki + 1
  }
  out
}

///|
fn sig_local_callable_prune(
  bound : Map[String, Int],
  ctx : SigDepCtx,
  name : String,
) -> Unit {
  let d = sig_bound_depth(bound, name)
  match ctx.local_callables.get(name) {
    Some(stack) => {
      while stack.length() > 0 && stack[stack.length() - 1].depth > d {
        let _ = stack.pop()
      }
    }
    None => ()
  }
}

///|
fn sig_unshadowed_param_idx(
  bound : Map[String, Int],
  param_idx : Map[String, Int],
  param_depth : Map[String, Int],
  name : String,
) -> Int {
  match param_idx.get(name) {
    Some(pi) => {
      let want = match param_depth.get(name) {
        Some(d) => d
        None => 1
      }
      match bound.get(name) {
        Some(cur) => if cur == want { pi } else { -1 }
        None => -1
      }
    }
    None => -1
  }
}

///|
fn sig_clone_bound(bound : Map[String, Int]) -> Map[String, Int] {
  let out : Map[String, Int] = Map([])
  let ks = bound.keys()
  let mut i = 0
  while i < ks.length() {
    let k = ks[i]
    match bound.get(k) {
      Some(n) => if n > 0 { out.set(k, n) }
      None => ()
    }
    i = i + 1
  }
  out
}

///|
fn sig_is_forwarded_param_arg(
  arg : Expr,
  bound : Map[String, Int],
  param_idx : Map[String, Int],
  param_depth : Map[String, Int],
) -> Bool {
  let mut inner = arg
  let mut more = true
  while more {
    more = false
    match inner {
      ENamedArg(_, _, e, _) | EMutArg(e, _) | EMove(e, _) => {
        inner = e
        more = true
      }
      _ => ()
    }
  }
  match inner {
    EIdent(aname, _) => sig_unshadowed_param_idx(bound, param_idx, param_depth, aname) >= 0
    _ => false
  }
}

///|
fn sig_scan_param_escape_expr(
  e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  if ctx.param_idx.length() == 0 && ctx.local_callables.length() == 0 {
    return
  }
  let w_kind : Array[Int] = [0]
  let w_expr : Array[Expr] = [e]
  let w_binds : Array[Array[String]] = [[]]
  while w_kind.length() > 0 {
    let kind = match w_kind.pop() {
      Some(k) => k
      None => break
    }
    let cur = match w_expr.pop() {
      Some(x) => x
      None => break
    }
    let binds = match w_binds.pop() {
      Some(b) => b
      None => []
    }
    if kind == 1 {
      sig_bind_cond_pat_from_expr(cur, bound, ctx, binds)
      continue
    }
    if kind == 2 {
      let mut bi = 0
      while bi < binds.length() {
        sig_bound_pop(bound, binds[bi])
        sig_local_callable_prune(bound, ctx, binds[bi])
        bi = bi + 1
      }
      continue
    }
    if kind == 3 {
      ctx.cond_depth = ctx.cond_depth + 1
      continue
    }
    if kind == 4 {
      ctx.cond_depth = ctx.cond_depth - 1
      continue
    }
    match cur {
      EIdent(name, _) => {
        let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, name)
        if pidx >= 0 {
          ctx.direct_callp.set(pidx, true)
        } else if sig_is_bound(bound, name) {
          match sig_local_callable_get_entry(bound, ctx, name) {
            Some(entry) => {
              let psrcs = sig_entry_all_param_srcs(entry, ctx)
              if psrcs.length() > 0 {
                sig_mark_param_srcs_direct_call(psrcs, ctx)
              }
              let cb_ts : Array[String] = []
              sig_collect_entry_cb_targets(entry, ctx, cb_ts)
              if cb_ts.length() > 0 {
                sig_union_str_array(ctx.escaped_cbs, cb_ts)
              }
            }
            None => ()
          }
        }
      }
      EBinary(op, l, r, _) =>
        if op == "&&" {
          let pbinds : Array[String] = []
          sig_collect_cond_pat_binds(l, pbinds)
          w_kind.push(4)
          w_expr.push(cur)
          w_binds.push([])
          if pbinds.length() > 0 {
            let live_binds : Array[String] = []
            w_kind.push(2)
            w_expr.push(cur)
            w_binds.push(live_binds)
            w_kind.push(0)
            w_expr.push(r)
            w_binds.push([])
            w_kind.push(1)
            w_expr.push(l)
            w_binds.push(live_binds)
            w_kind.push(3)
            w_expr.push(cur)
            w_binds.push([])
            w_kind.push(0)
            w_expr.push(l)
            w_binds.push([])
          } else {
            w_kind.push(0)
            w_expr.push(r)
            w_binds.push([])
            w_kind.push(3)
            w_expr.push(cur)
            w_binds.push([])
            w_kind.push(0)
            w_expr.push(l)
            w_binds.push([])
          }
        } else if op == "||" {
          w_kind.push(4)
          w_expr.push(cur)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(r)
          w_binds.push([])
          w_kind.push(3)
          w_expr.push(cur)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(l)
          w_binds.push([])
        } else {
          w_kind.push(0)
          w_expr.push(r)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(l)
          w_binds.push([])
        }
      EMutArg(inner, _) => {
        sig_mark_mut_place_dirty(inner, bound, ctx)
        w_kind.push(0)
        w_expr.push(inner)
        w_binds.push([])
      }
      EUnary(_, inner, _)
      | EField(inner, _, _)
      | EMove(inner, _)
      | EAs(inner, _, _)
      | ETry(inner, _)
      | ENamedArg(_, _, inner, _)
      | EIs(inner, _, _) => {
        w_kind.push(0)
        w_expr.push(inner)
        w_binds.push([])
      }
      EIndex(a, b, _) | EScope(a, b, _) | ESpawn(a, b, _) => {
        w_kind.push(0)
        w_expr.push(b)
        w_binds.push([])
        w_kind.push(0)
        w_expr.push(a)
        w_binds.push([])
      }
      EArrayLit(xs, _) | ETuple(xs, _) | EInterp(xs, _) | EDotVariant(_, xs, _) => {
        let mut i = xs.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(xs[i])
          w_binds.push([])
          i = i - 1
        }
      }
      EStructLit(_, spread_opt, fields, _) => {
        let mut i = fields.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(fields[i].value)
          w_binds.push([])
          i = i - 1
        }
        match spread_opt {
          Some(se) => {
            w_kind.push(0)
            w_expr.push(se)
            w_binds.push([])
          }
          None => ()
        }
      }
      ECall(callee, args, _) => {
        let mut i = args.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(args[i])
          w_binds.push([])
          i = i - 1
        }
        w_kind.push(0)
        w_expr.push(callee)
        w_binds.push([])
      }
      EMethodCall(recv, _, args, _) => {
        let mut i = args.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(args[i])
          w_binds.push([])
          i = i - 1
        }
        w_kind.push(0)
        w_expr.push(recv)
        w_binds.push([])
      }
      EBlock(stmts, _) => sig_scan_param_escape_stmts(stmts, bound, ctx)
      EIf(cond, then_stmts, else_opt, _) => {
        sig_scan_param_escape_expr(cond, bound, ctx)
        let pbinds : Array[String] = []
        sig_collect_cond_pat_binds(cond, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_push(bound, pbinds[bi])
          bi = bi + 1
        }
        sig_scan_param_escape_stmts(then_stmts, bound, ctx)
        bi = 0
        while bi < pbinds.length() {
          sig_bound_pop(bound, pbinds[bi])
          bi = bi + 1
        }
        match else_opt {
          Some(ee) => sig_scan_param_escape_expr(ee, bound, ctx)
          None => ()
        }
      }
      EMatch(scrut, arms, _) => {
        sig_scan_param_escape_expr(scrut, bound, ctx)
        let mut ai = 0
        while ai < arms.length() {
          let pbinds : Array[String] = []
          sig_collect_pat_binds(arms[ai].pat, pbinds)
          let mut bi = 0
          while bi < pbinds.length() {
            sig_bound_push(bound, pbinds[bi])
            bi = bi + 1
          }
          match arms[ai].guard_expr {
            Some(ge) => sig_scan_param_escape_expr(ge, bound, ctx)
            None => ()
          }
          sig_scan_param_escape_expr(arms[ai].body, bound, ctx)
          bi = 0
          while bi < pbinds.length() {
            sig_bound_pop(bound, pbinds[bi])
            bi = bi + 1
          }
          ai = ai + 1
        }
      }
      EClosure(cparams, _, cbody, _) => {
        let mut cpi = 0
        while cpi < cparams.length() {
          sig_bound_push(bound, cparams[cpi].name)
          cpi = cpi + 1
        }
        sig_scan_param_escape_stmts(cbody, bound, ctx)
        cpi = 0
        while cpi < cparams.length() {
          sig_bound_pop(bound, cparams[cpi].name)
          cpi = cpi + 1
        }
      }
      _ => ()
    }
  }
}

///|
fn sig_scan_param_escape_stmts(
  stmts : Array[Stmt],
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  if ctx.param_idx.length() == 0 {
    return
  }
  let local_binds : Array[String] = []
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, _, _, init_e, _) => {
        sig_scan_param_escape_expr(init_e, bound, ctx)
        sig_bound_push(bound, name)
        local_binds.push(name)
      }
      SLetTuple(names, _, init_e, _) => {
        sig_scan_param_escape_expr(init_e, bound, ctx)
        let mut ni = 0
        while ni < names.length() {
          sig_bound_push(bound, names[ni])
          local_binds.push(names[ni])
          ni = ni + 1
        }
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        sig_scan_param_escape_expr(lhs, bound, ctx)
        sig_scan_param_escape_expr(rhs, bound, ctx)
      }
      SGuard(cond, eb, _) => {
        sig_scan_param_escape_stmts(eb, bound, ctx)
        sig_scan_param_escape_expr(cond, bound, ctx)
        let pbinds : Array[String] = []
        sig_collect_cond_pat_binds(cond, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_push(bound, pbinds[bi])
          local_binds.push(pbinds[bi])
          bi = bi + 1
        }
      }
      SWhile(cond, body, _) => {
        sig_scan_param_escape_expr(cond, bound, ctx)
        let pbinds : Array[String] = []
        sig_collect_cond_pat_binds(cond, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_push(bound, pbinds[bi])
          bi = bi + 1
        }
        sig_scan_param_escape_stmts(body, bound, ctx)
        bi = 0
        while bi < pbinds.length() {
          sig_bound_pop(bound, pbinds[bi])
          bi = bi + 1
        }
      }
      SFor(init_s, cond, step_s, body, _) => {
        let for_stmts : Array[Stmt] = [init_s, SExpr(cond, expr_span(cond)), step_s]
        let mut bi = 0
        while bi < body.length() {
          for_stmts.push(body[bi])
          bi = bi + 1
        }
        sig_scan_param_escape_stmts(for_stmts, bound, ctx)
      }
      SForRange(vname, s_e, e_e, _, body, _) => {
        sig_scan_param_escape_expr(s_e, bound, ctx)
        sig_scan_param_escape_expr(e_e, bound, ctx)
        sig_bound_push(bound, vname)
        sig_scan_param_escape_stmts(body, bound, ctx)
        sig_bound_pop(bound, vname)
      }
      SForIn(iname, vname, iter_e, body, _) => {
        sig_scan_param_escape_expr(iter_e, bound, ctx)
        sig_bound_push(bound, iname)
        sig_bound_push(bound, vname)
        sig_scan_param_escape_stmts(body, bound, ctx)
        sig_bound_pop(bound, vname)
        sig_bound_pop(bound, iname)
      }
      SReturn(opt, _) =>
        match opt {
          Some(re) => sig_scan_param_escape_expr(re, bound, ctx)
          None => ()
        }
      SDebugAssert(cond, msg, _) => {
        sig_scan_param_escape_expr(cond, bound, ctx)
        sig_scan_param_escape_expr(msg, bound, ctx)
      }
      SExpr(e, _) => sig_scan_param_escape_expr(e, bound, ctx)
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  let mut li = 0
  while li < local_binds.length() {
    sig_bound_pop(bound, local_binds[li])
    li = li + 1
  }
}

///|
fn sig_materialize_closure(
  csite : String,
  cparams : Array[Param],
  cbody : Array[Stmt],
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> String {
  let st = match ctx.cb_by_site.get(csite) {
    Some(existing_key) =>
      match ctx.cb_states.get(existing_key) {
        Some(existing_st) => existing_st
        None => {
          let cpnames : Array[String] = []
          let mut cpi0 = 0
          while cpi0 < cparams.length() {
            cpnames.push(cparams[cpi0].name)
            cpi0 = cpi0 + 1
          }
          let fresh = SigCbState::{
            cb_key: existing_key,
            cpnames: cpnames,
            idents: Map([]),
            ident_list: [],
            calls: Map([]),
            call_list: [],
            direct_callp: Map([]),
            fwd_callp: Map([]),
            fwd_callp_list: [],
            mut_param_writes: Map([]),
            mut_param_fwds: [],
            cb_mut_writes: Map([]),
            cb_mut_fwds: [],
            cb_param_calls: [],
            cb_param_fwds: [],
            fdep_idx: -1,
            fcallp_idx: -1,
            fret_idx: -1,
          }
          ctx.cb_states.set(existing_key, fresh)
          ctx.cb_order.push(existing_key)
          fresh
        }
      }
    None => {
      let cb_key = "$cb_" + ctx.cb_prefix + ctx.cb_counter.to_string()
      ctx.cb_counter = ctx.cb_counter + 1
      let cpnames : Array[String] = []
      let mut cpi0 = 0
      while cpi0 < cparams.length() {
        cpnames.push(cparams[cpi0].name)
        cpi0 = cpi0 + 1
      }
      let fresh = SigCbState::{
        cb_key: cb_key,
        cpnames: cpnames,
        idents: Map([]),
        ident_list: [],
        calls: Map([]),
        call_list: [],
        direct_callp: Map([]),
        fwd_callp: Map([]),
        fwd_callp_list: [],
        mut_param_writes: Map([]),
        mut_param_fwds: [],
        cb_mut_writes: Map([]),
        cb_mut_fwds: [],
        cb_param_calls: [],
        cb_param_fwds: [],
        fdep_idx: -1,
        fcallp_idx: -1,
        fret_idx: -1,
      }
      ctx.cb_by_site.set(csite, cb_key)
      ctx.cb_states.set(cb_key, fresh)
      ctx.cb_order.push(cb_key)
      fresh
    }
  }
  let cbound = sig_clone_bound(bound)
  let cparam_idx : Map[String, Int] = Map([])
  let cparam_depth : Map[String, Int] = Map([])
  let sub_ctx = sig_dep_ctx_child_for_cb(ctx, st, cparam_idx, cparam_depth)
  // Inherit active unshadowed outer function parameters (tagged with outer cur_fn_key)
  let pkeys = ctx.param_idx.keys()
  let mut pki = 0
  while pki < pkeys.length() {
    let pk = pkeys[pki]
    let pidx = sig_unshadowed_param_idx(cbound, ctx.param_idx, ctx.param_depth, pk)
    if pidx >= 0 {
      let d = sig_bound_depth(cbound, pk)
      sub_ctx.local_callables.set(
        pk,
        [
          SigLocalCallable::{
            depth: d,
            targets: [],
            exact: false,
            slot_key: "",
            cslots: [],
            cslot_unknown: false,
            param_srcs: [ctx.cur_fn_key + "|" + pidx.to_string()],
            payload_evals: [],
            field_targets: Map([]),
            field_param_srcs: Map([]),
            fields_exact: false,
          },
        ],
      )
    }
    pki = pki + 1
  }
  // Inherit active unshadowed local_callables from outer lexical scope (including shared mut slots & param_srcs)
  let lkeys = ctx.local_callables.keys()
  let mut lki = 0
  while lki < lkeys.length() {
    let k = lkeys[lki]
    let d = sig_bound_depth(cbound, k)
    if d > 0 {
      match ctx.local_callables.get(k) {
        Some(stack) =>
          if stack.length() > 0 && stack[stack.length() - 1].depth == d {
            let src_e = stack[stack.length() - 1]
            let dst_t : Array[String] = []
            let mut ti = 0
            while ti < src_e.targets.length() {
              dst_t.push(src_e.targets[ti])
              ti = ti + 1
            }
            let dst_cslots : Array[String] = []
            sig_union_str_array(dst_cslots, src_e.cslots)
            let dst_psrcs = sig_entry_all_param_srcs(src_e, ctx)
            sub_ctx.local_callables.set(
              k,
              [
                SigLocalCallable::{
                  depth: d,
                  targets: dst_t,
                  exact: src_e.exact,
                  slot_key: src_e.slot_key,
                  cslots: dst_cslots,
                  cslot_unknown: src_e.cslot_unknown,
                  param_srcs: dst_psrcs,
                  payload_evals: src_e.payload_evals,
                  field_targets: src_e.field_targets,
                  field_param_srcs: src_e.field_param_srcs,
                  fields_exact: src_e.fields_exact,
                },
              ],
            )
          }
        None => ()
      }
    }
    lki = lki + 1
  }
  let mut cpi = 0
  while cpi < cparams.length() {
    let pname = cparams[cpi].name
    sig_bound_push(cbound, pname)
    cparam_idx.set(pname, cpi)
    cparam_depth.set(pname, sig_bound_depth(cbound, pname))
    sig_record_param_callable(sub_ctx.param_callable, cpi, cparams[cpi], [])
    cpi = cpi + 1
  }
  sub_ctx.isolated_struct_locals = sig_collect_isolated_struct_locals(
    cbody,
    cparam_idx,
    ctx.resolved_methods,
  )
  sig_collect_stmts_deps_impl(
    cbody,
    cbound,
    st.idents,
    st.ident_list,
    st.calls,
    st.call_list,
    sub_ctx,
    true,
  )
  let fdep_line = sig_format_dep_line("#fdep ", st.cb_key, st.ident_list, st.call_list)
  let cp_sb = StringBuilder()
  sig_emit_fcallp_line(cp_sb, st.cb_key, st.cpnames, sub_ctx)
  let fcallp_line = cp_sb.to_string()
  if st.fdep_idx < 0 {
    st.fdep_idx = ctx.extra_fdeps.length()
    ctx.extra_fdeps.push(fdep_line)
    st.fcallp_idx = ctx.extra_fdeps.length()
    ctx.extra_fdeps.push(fcallp_line)
  } else {
    ctx.extra_fdeps[st.fdep_idx] = fdep_line
    ctx.extra_fdeps[st.fcallp_idx] = fcallp_line
  }
  if sub_ctx.ret_targets.length() > 0 {
    let r_sb = StringBuilder()
    r_sb.write_string("#fret ")
    r_sb.write_string(st.cb_key)
    r_sb.write_string("|")
    let mut rti = 0
    while rti < sub_ctx.ret_targets.length() {
      if rti > 0 {
        r_sb.write_string(",")
      }
      r_sb.write_string(sub_ctx.ret_targets[rti])
      rti = rti + 1
    }
    r_sb.write_string("\n")
    let fret_line = r_sb.to_string()
    if st.fret_idx < 0 {
      st.fret_idx = ctx.extra_fdeps.length()
      ctx.extra_fdeps.push(fret_line)
    } else {
      ctx.extra_fdeps[st.fret_idx] = fret_line
    }
  }
  st.cb_key
}

///|
fn sig_add_unique_str(out : Array[String], seen : Map[String, Bool], v : String) -> Unit {
  if !seen.contains(v) {
    seen.set(v, true)
    out.push(v)
  }
}

///|
fn sig_add_unique_int(out : Array[Int], v : Int) -> Unit {
  let mut i = 0
  while i < out.length() {
    if out[i] == v {
      return
    }
    i = i + 1
  }
  out.push(v)
}

///|
fn sig_extract_callable_targets(
  e : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out : Array[String],
  seen : Map[String, Bool],
  fwd_params : Array[Int],
) -> Bool {
  match e {
    EMutArg(inner, _) => {
      sig_mark_mut_place_dirty(inner, bound, ctx)
      sig_extract_callable_targets(inner, bound, ctx, out, seen, fwd_params)
    }
    ENamedArg(_, _, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ETry(inner, _) =>
      sig_extract_callable_targets(inner, bound, ctx, out, seen, fwd_params)
    EIdent(name, _) => {
      let p_from = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, name)
      if p_from >= 0 {
        sig_add_unique_int(fwd_params, p_from)
        false
      } else if sig_is_bound(bound, name) {
        match sig_local_callable_get_entry(bound, ctx, name) {
          Some(entry) => {
            let psrcs = sig_entry_all_param_srcs(entry, ctx)
            let mut pi = 0
            while pi < psrcs.length() {
              let psrc = psrcs[pi]
              let sep = sig_find_char(psrc, 124, 0)
              if sep > 0 && sep + 1 < psrc.length() && slice_str(psrc, 0, sep) == ctx.cur_fn_key {
                sig_add_unique_int(
                  fwd_params,
                  sig_parse_nonneg_int(slice_str(psrc, sep + 1, psrc.length())),
                )
              }
              pi = pi + 1
            }
            let mut i = 0
            while i < entry.targets.length() {
              sig_add_unique_str(out, seen, entry.targets[i])
              i = i + 1
            }
            entry.exact || entry.slot_key != ""
          }
          None => false
        }
      } else {
        sig_add_unique_str(out, seen, name)
        true
      }
    }
    EPath(q, m, _) => {
      sig_add_unique_str(out, seen, q + "::" + m)
      true
    }
    EClosure(cparams, _, cbody, sp) => {
      let csite = ctx.cb_prefix + "cb:" + span_key(sp)
      let cb_key = sig_materialize_closure(csite, cparams, cbody, bound, ctx)
      sig_add_unique_str(out, seen, cb_key)
      true
    }
    EBlock(stmts, _) => {
      let local_binds : Array[String] = []
      let mut tail_exact = false
      let mut i = 0
      while i < stmts.length() {
        let is_last = i + 1 == stmts.length()
        match stmts[i] {
          SLet(name, is_mut, _, init_e, _) => {
            sig_bind_local_let(name, is_mut, init_e, bound, ctx)
            local_binds.push(name)
          }
          SLetTuple(names, _, init_e, _) => {
            let rhs_ev = sig_eval_local_let_rhs(init_e, bound, ctx)
            let mut ni = 0
            while ni < names.length() {
              if names[ni] != "_" {
                let ev_k = if ni < rhs_ev.payload_evals.length() {
                  rhs_ev.payload_evals[ni]
                } else {
                  sig_unpack_fallback_eval(rhs_ev)
                }
                sig_commit_local_let(names[ni], false, ev_k, bound, ctx)
                local_binds.push(names[ni])
              }
              ni = ni + 1
            }
          }
          SAssign(lhs, rhs, _) =>
            match lhs {
              EIdent(name, _) => sig_assign_local(name, rhs, bound, ctx)
              EIndex(_, _, _) | EField(_, _, _) =>
                sig_assign_container_elem(lhs, rhs, bound, ctx)
              _ => ()
            }
          SGuard(cond, _, _) => {
            let pbinds : Array[String] = []
            sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
            let mut bi = 0
            while bi < pbinds.length() {
              local_binds.push(pbinds[bi])
              bi = bi + 1
            }
          }
          SExpr(tail_e, _) =>
            if is_last {
              tail_exact = sig_extract_callable_targets(tail_e, bound, ctx, out, seen, fwd_params)
            }
          _ => ()
        }
        i = i + 1
      }
      let mut li = 0
      while li < local_binds.length() {
        sig_bound_pop(bound, local_binds[li])
        sig_local_callable_prune(bound, ctx, local_binds[li])
        li = li + 1
      }
      tail_exact
    }
    EIf(cond, then_stmts, else_opt, sp) => {
      let pbinds : Array[String] = []
      sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
      ctx.cond_depth = ctx.cond_depth + 1
      let then_ex = sig_extract_callable_targets(
        EBlock(then_stmts, sp),
        bound,
        ctx,
        out,
        seen,
        fwd_params,
      )
      ctx.cond_depth = ctx.cond_depth - 1
      let mut bi = 0
      while bi < pbinds.length() {
        sig_bound_pop(bound, pbinds[bi])
        sig_local_callable_prune(bound, ctx, pbinds[bi])
        bi = bi + 1
      }
      let else_ex = match else_opt {
        Some(ee) => {
          ctx.cond_depth = ctx.cond_depth + 1
          let ex = sig_extract_callable_targets(ee, bound, ctx, out, seen, fwd_params)
          ctx.cond_depth = ctx.cond_depth - 1
          ex
        }
        None => false
      }
      then_ex && else_ex
    }
    EMatch(scrut, arms, _) => {
      let scrut_eval = sig_eval_local_let_rhs(scrut, bound, ctx)
      let mut all_ex = arms.length() > 0
      ctx.cond_depth = ctx.cond_depth + 1
      let mut ai = 0
      while ai < arms.length() {
        let pbinds : Array[String] = []
        sig_bind_pat_from_expr(arms[ai].pat, scrut, scrut_eval, bound, ctx, pbinds)
        let arm_ex = sig_extract_callable_targets(arms[ai].body, bound, ctx, out, seen, fwd_params)
        if !arm_ex {
          all_ex = false
        }
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_pop(bound, pbinds[bi])
          sig_local_callable_prune(bound, ctx, pbinds[bi])
          bi = bi + 1
        }
        ai = ai + 1
      }
      ctx.cond_depth = ctx.cond_depth - 1
      all_ex
    }
    EArrayLit(xs, _) | ETuple(xs, _) => {
      let mut i = 0
      while i < xs.length() {
        let _ = sig_extract_callable_targets(xs[i], bound, ctx, out, seen, fwd_params)
        i = i + 1
      }
      false
    }
    EDotVariant(_, cargs, _) => {
      let mut i = 0
      while i < cargs.length() {
        let _ = sig_extract_callable_targets(cargs[i], bound, ctx, out, seen, fwd_params)
        i = i + 1
      }
      false
    }
    ECall(callee, cargs, sp) => {
      if sig_is_ctor_call(callee, sp, bound, ctx) ||
        sig_is_fresh_container_ctor(callee, bound) {
        let mut i = 0
        while i < cargs.length() {
          let _ = sig_extract_callable_targets(cargs[i], bound, ctx, out, seen, fwd_params)
          i = i + 1
        }
      } else {
        match callee {
          EIdent(cname, _) => {
            let mut add_pkg_ret = false
            let mut stop_after_pkg = false
            if ctx.has_tc {
              if ctx.resolved_methods.contains("call_pkg:" + span_key(sp)) {
                add_pkg_ret = true
                stop_after_pkg = true
              } else if ctx.resolved_methods.contains("call_nonlocal:" + span_key(sp)) {
                return false
              }
            } else {
              let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, cname)
              if pidx >= 0 {
                match ctx.param_callable.get(pidx) {
                  Some(false) => {
                    add_pkg_ret = true
                    stop_after_pkg = true
                  }
                  None => add_pkg_ret = true
                  Some(true) => ()
                }
              } else if sig_is_bound(bound, cname) {
                match sig_local_callable_get_entry(bound, ctx, cname) {
                  Some(entry) => {
                    let psrcs = sig_entry_all_param_srcs(entry, ctx)
                    if !(entry.exact && sig_targets_all_closures(entry.targets)) {
                      add_pkg_ret = true
                      if entry.targets.length() == 0 && psrcs.length() == 0 {
                        stop_after_pkg = true
                      }
                    }
                  }
                  None => {
                    add_pkg_ret = true
                    stop_after_pkg = true
                  }
                }
              }
            }
            if add_pkg_ret {
              sig_add_unique_str(out, seen, "$ret:" + cname)
              if stop_after_pkg {
                return false
              }
            }
          }
          _ => ()
        }
        let ct : Array[String] = []
        let cseen : Map[String, Bool] = Map([])
        let cfwd : Array[Int] = []
        let _ = sig_extract_callable_targets(callee, bound, ctx, ct, cseen, cfwd)
        let mut ci = 0
        while ci < ct.length() {
          sig_add_unique_str(out, seen, "$ret:" + ct[ci])
          ci = ci + 1
        }
        let mut fi = 0
        while fi < cfwd.length() {
          sig_add_unique_str(out, seen, "$retp:" + ctx.cur_fn_key + "~" + cfwd[fi].to_string())
          fi = fi + 1
        }
        let cps : Array[String] = []
        sig_collect_expr_param_srcs(callee, bound, ctx, cps)
        let mut pi = 0
        while pi < cps.length() {
          let ps = cps[pi]
          let sep = sig_find_char(ps, 124, 0)
          if sep > 0 && sep + 1 < ps.length() {
            let rk = slice_str(ps, 0, sep) + "~" + slice_str(ps, sep + 1, ps.length())
            sig_add_unique_str(out, seen, "$retp:" + rk)
          }
          pi = pi + 1
        }
      }
      false
    }
    EIndex(base, idx, _) => {
      match base {
        EArrayLit(xs, _) =>
          match idx {
            EInt(ks, _) =>
              if sig_is_digits(ks) {
                let k = sig_parse_nonneg_int(ks)
                if k < xs.length() {
                  let _ = sig_extract_callable_targets(xs[k], bound, ctx, out, seen, fwd_params)
                  return false
                }
              }
            _ => ()
          }
        EIdent(cname, _) =>
          if sig_is_bound(bound, cname) {
            match sig_local_callable_get_entry(bound, ctx, cname) {
              Some(entry) =>
                if entry.slot_key != "" {
                  sig_add_unique_str(out, seen, entry.slot_key)
                  let psrcs = sig_entry_all_param_srcs(entry, ctx)
                  let mut pi = 0
                  while pi < psrcs.length() {
                    let psrc = psrcs[pi]
                    let sep = sig_find_char(psrc, 124, 0)
                    if sep > 0 && sep + 1 < psrc.length() &&
                      slice_str(psrc, 0, sep) == ctx.cur_fn_key {
                      fwd_params.push(sig_parse_nonneg_int(slice_str(psrc, sep + 1, psrc.length())))
                    }
                    pi = pi + 1
                  }
                  return false
                } else if !entry.cslot_unknown && entry.cslots.length() > 0 {
                  let mut ci = 0
                  while ci < entry.cslots.length() {
                    let ck = entry.cslots[ci]
                    let mut emitted_proj = false
                    match idx {
                      EInt(ks, _) =>
                        if sig_is_digits(ks) && !sig_cslot_is_dirty(ctx, ck) {
                          let fk = sig_parse_nonneg_int(ks).to_string()
                          sig_cslot_record_ref(ctx, ck, fk)
                          sig_add_unique_str(out, seen, ck + "$f" + fk)
                          emitted_proj = true
                        }
                      _ => ()
                    }
                    if !emitted_proj {
                      sig_add_unique_str(out, seen, ck)
                    }
                    ci = ci + 1
                  }
                  let psrcs = sig_entry_all_param_srcs(entry, ctx)
                  let mut pi = 0
                  while pi < psrcs.length() {
                    let psrc = psrcs[pi]
                    let sep = sig_find_char(psrc, 124, 0)
                    if sep > 0 && sep + 1 < psrc.length() &&
                      slice_str(psrc, 0, sep) == ctx.cur_fn_key {
                      fwd_params.push(sig_parse_nonneg_int(slice_str(psrc, sep + 1, psrc.length())))
                    }
                    pi = pi + 1
                  }
                  return false
                }
              None => ()
            }
          }
        _ => ()
      }
      let _ = sig_extract_callable_targets(base, bound, ctx, out, seen, fwd_params)
      false
    }
    EField(base, fname, _) => {
      match base {
        ETuple(xs, _) =>
          if sig_is_digits(fname) {
            let k = sig_parse_nonneg_int(fname)
            if k >= 0 && k < xs.length() {
              let _ = sig_extract_callable_targets(xs[k], bound, ctx, out, seen, fwd_params)
              return false
            }
          }
        EStructLit(_, None, sfields, _) => {
          let mut si = 0
          while si < sfields.length() {
            if sfields[si].name == fname {
              let _ = sig_extract_callable_targets(
                sfields[si].value,
                bound,
                ctx,
                out,
                seen,
                fwd_params,
              )
              return false
            }
            si = si + 1
          }
        }
        EIdent(cname, _) =>
          if sig_is_bound(bound, cname) {
            match sig_local_callable_get_entry(bound, ctx, cname) {
              Some(entry) =>
                if entry.slot_key != "" {
                  sig_add_unique_str(out, seen, entry.slot_key)
                  return false
                } else if !entry.cslot_unknown && entry.cslots.length() > 0 {
                  let fk = if sig_is_digits(fname) { fname } else { "." + fname }
                  let mut ci = 0
                  while ci < entry.cslots.length() {
                    let ck = entry.cslots[ci]
                    if !sig_cslot_is_dirty(ctx, ck) {
                      sig_cslot_record_ref(ctx, ck, fk)
                      sig_add_unique_str(out, seen, ck + "$f" + fk)
                    } else {
                      sig_add_unique_str(out, seen, ck)
                    }
                    ci = ci + 1
                  }
                  return false
                }
              None => ()
            }
          }
        _ => ()
      }
      let _ = sig_extract_callable_targets(base, bound, ctx, out, seen, fwd_params)
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        let _ = sig_extract_callable_targets(fields[i].value, bound, ctx, out, seen, fwd_params)
        i = i + 1
      }
      match spread_opt {
        Some(se) => {
          let _ = sig_extract_callable_targets(se, bound, ctx, out, seen, fwd_params)
        }
        None => ()
      }
      false
    }
    _ => false
  }
}

///|
fn sig_format_call_desc(
  target : String,
  args : Array[Expr],
  pos_base : Int,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> String {
  let mut pos_count = pos_base
  let named : Array[String] = []
  let cb_bindings : Array[String] = []
  let pending_fwd_pidx : Array[Int] = []
  let pending_fwd_slot : Array[String] = []
  let mut i = 0
  while i < args.length() {
    let mut slot_key = ""
    let mut is_mut_arg = false
    let inner = match args[i] {
      ENamedArg(aname, _, e, _) => {
        named.push(aname)
        slot_key = aname
        match e {
          EMutArg(me, _) => {
            is_mut_arg = true
            me
          }
          _ => e
        }
      }
      EMutArg(e, _) => {
        is_mut_arg = true
        slot_key = pos_count.to_string()
        pos_count = pos_count + 1
        e
      }
      e => {
        slot_key = pos_count.to_string()
        pos_count = pos_count + 1
        e
      }
    }
    if is_mut_arg {
      sig_mark_mut_place_dirty(inner, bound, ctx)
    }
    if target != "?" {
      match inner {
        EIdent(aname, _) => {
          let my_pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, aname)
          if my_pidx >= 0 {
            sig_union_str_array(
              ctx.mut_param_fwds,
              [my_pidx.to_string() + "|" + target + "|" + slot_key],
            )
          } else if sig_is_bound(bound, aname) {
            match sig_local_callable_get_entry(bound, ctx, aname) {
              Some(entry) => {
                let psrcs = sig_entry_all_param_srcs(entry, ctx)
                if psrcs.length() > 0 {
                  sig_record_param_srcs_fwd(ctx, psrcs, target, slot_key)
                  let mut pi2 = 0
                  while pi2 < psrcs.length() {
                    let psrc = psrcs[pi2]
                    let sep = sig_find_char(psrc, 124, 0)
                    if sep > 0 && slice_str(psrc, 0, sep) != ctx.cur_fn_key {
                      sig_union_str_array(
                        ctx.cb_param_fwds,
                        [psrc + "|" + target + "|" + slot_key],
                      )
                    }
                    pi2 = pi2 + 1
                  }
                }
                if is_mut_arg && entry.slot_key != "" {
                  sig_add_slot_mut_link(ctx, entry.slot_key + "|" + target + "|" + slot_key)
                }
                let mut ci2 = 0
                while ci2 < entry.cslots.length() {
                  sig_add_slot_mut_link(ctx, entry.cslots[ci2] + "|" + target + "|" + slot_key)
                  ci2 = ci2 + 1
                }
                if entry.cslot_unknown {
                  sig_link_all_cslots_mut(ctx, target, slot_key, false)
                }
              }
              None => ()
            }
          }
        }
        _ => {
          let rname = sig_mut_place_root(inner)
          if rname != "" {
            let r_pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, rname)
            if r_pidx >= 0 {
              sig_union_str_array(
                ctx.mut_param_fwds,
                [r_pidx.to_string() + "|" + target + "|" + slot_key],
              )
            } else if sig_is_bound(bound, rname) {
              match sig_local_callable_get_entry(bound, ctx, rname) {
                Some(entry) => {
                  let psrcs = sig_entry_all_param_srcs(entry, ctx)
                  if psrcs.length() > 0 {
                    sig_record_param_srcs_fwd(ctx, psrcs, target, slot_key)
                  }
                  if is_mut_arg && entry.slot_key != "" {
                    sig_add_slot_mut_link(ctx, entry.slot_key + "|" + target + "|" + slot_key)
                  }
                  let mut ci2 = 0
                  while ci2 < entry.cslots.length() {
                    sig_add_slot_mut_link(ctx, entry.cslots[ci2] + "|" + target + "|" + slot_key)
                    ci2 = ci2 + 1
                  }
                  if entry.cslot_unknown {
                    sig_link_all_cslots_mut(ctx, target, slot_key, false)
                  }
                }
                None => ()
              }
            }
          } else {
            let aev = sig_eval_local_let_rhs(inner, bound, ctx)
            if aev.param_srcs.length() > 0 {
              sig_record_param_srcs_fwd(ctx, aev.param_srcs, target, slot_key)
            }
            let mut ci2 = 0
            while ci2 < aev.cslots.length() {
              ctx.cslot_dirty.set(aev.cslots[ci2], true)
              sig_add_slot_mut_link(ctx, aev.cslots[ci2] + "|" + target + "|" + slot_key)
              ci2 = ci2 + 1
            }
            if aev.cslot_unknown {
              sig_link_all_cslots_mut(ctx, target, slot_key, true)
            }
          }
        }
      }
    }
    let ctargets : Array[String] = []
    let cseen : Map[String, Bool] = Map([])
    let cfwd : Array[Int] = []
    let _ = sig_extract_callable_targets(inner, bound, ctx, ctargets, cseen, cfwd)
    let mut fi = 0
    while fi < cfwd.length() {
      pending_fwd_pidx.push(cfwd[fi])
      pending_fwd_slot.push(slot_key)
      fi = fi + 1
    }
    let mut ti = 0
    while ti < ctargets.length() {
      cb_bindings.push(slot_key + "=" + ctargets[ti])
      ti = ti + 1
    }
    i = i + 1
  }
  sig_sort_strs(named)
  sig_sort_strs(cb_bindings)
  let tail_sb = StringBuilder()
  tail_sb.write_string("@")
  tail_sb.write_string(pos_count.to_string())
  i = 0
  while i < named.length() {
    tail_sb.write_string(";")
    tail_sb.write_string(named[i])
    i = i + 1
  }
  let call_tail = tail_sb.to_string()
  i = 0
  while i < pending_fwd_pidx.length() {
    let fk = pending_fwd_pidx[i].to_string() + ">" + target + ">" + pending_fwd_slot[i] + call_tail
    if !ctx.fwd_callp.contains(fk) {
      ctx.fwd_callp.set(fk, true)
      ctx.fwd_callp_list.push(fk)
    }
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string(target)
  sb.write_string(call_tail)
  i = 0
  while i < cb_bindings.length() {
    sb.write_string("?")
    sb.write_string(cb_bindings[i])
    i = i + 1
  }
  sb.to_string()
}

///|
fn sig_collect_entry_cb_targets(
  entry : SigLocalCallable,
  ctx : SigDepCtx,
  out : Array[String],
) -> Unit {
  let seen : Map[String, Bool] = Map([])
  let work : Array[String] = []
  let mut i = 0
  while i < entry.targets.length() {
    work.push(entry.targets[i])
    i = i + 1
  }
  if entry.slot_key != "" {
    work.push(entry.slot_key)
  }
  while work.length() > 0 {
    match work.pop() {
      Some(t) =>
        if !seen.contains(t) {
          seen.set(t, true)
          if starts_with_str(t, "$cb_") {
            sig_union_str_array(out, [t])
          } else if starts_with_str(t, "$slot_") {
            match ctx.mut_slot_targets.get(t) {
              Some(st) => {
                let mut si = 0
                while si < st.length() {
                  work.push(st[si])
                  si = si + 1
                }
              }
              None => ()
            }
          }
        }
      None => break
    }
  }
}

///|
fn sig_entry_is_pure_cb_local(entry : SigLocalCallable, ctx : SigDepCtx) -> Bool {
  if entry.cslots.length() > 0 || entry.cslot_unknown {
    return false
  }
  let seen : Map[String, Bool] = Map([])
  let work : Array[String] = []
  let mut i = 0
  while i < entry.targets.length() {
    work.push(entry.targets[i])
    i = i + 1
  }
  if entry.slot_key != "" {
    work.push(entry.slot_key)
  }
  let mut found_cb = false
  while work.length() > 0 {
    match work.pop() {
      Some(t) =>
        if !seen.contains(t) {
          seen.set(t, true)
          if starts_with_str(t, "$cb_") {
            found_cb = true
          } else if starts_with_str(t, "$slot_") {
            match ctx.mut_slot_targets.get(t) {
              Some(st) => {
                if st.length() == 0 {
                  return false
                }
                let mut si = 0
                while si < st.length() {
                  work.push(st[si])
                  si = si + 1
                }
              }
              None => return false
            }
          } else {
            return false
          }
        }
      None => break
    }
  }
  found_cb
}

///|
fn sig_is_forwarded_param_or_alias_arg(
  arg : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Bool {
  if sig_is_forwarded_param_arg(arg, bound, ctx.param_idx, ctx.param_depth) {
    return true
  }
  let mut inner = arg
  let mut more = true
  while more {
    more = false
    match inner {
      ENamedArg(_, _, x, _) | EMutArg(x, _) | EMove(x, _) => {
        inner = x
        more = true
      }
      _ => ()
    }
  }
  match inner {
    EClosure(_, _, _, _) => true
    EIdent(name, _) =>
      if sig_is_bound(bound, name) {
        match sig_local_callable_get_entry(bound, ctx, name) {
          Some(entry) => {
            let psrcs = sig_entry_all_param_srcs(entry, ctx)
            psrcs.length() > 0 || sig_entry_is_pure_cb_local(entry, ctx)
          }
          None => false
        }
      } else {
        false
      }
    _ => false
  }
}

///|
fn sig_collect_expr_deps(
  e : Expr,
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  // Iterative worklist for deep EBinary chains (including left-to-right `&&` `is` bindings);
  // skips bare EClosure bodies (creation != execution; callback closures are tracked at call sites).
  // kind: 0 = visit expr, 1 = push binds, 2 = pop binds
  let w_kind : Array[Int] = [0]
  let w_expr : Array[Expr] = [e]
  let w_binds : Array[Array[String]] = [[]]
  while w_kind.length() > 0 {
    let kind = match w_kind.pop() {
      Some(k) => k
      None => break
    }
    let cur = match w_expr.pop() {
      Some(x) => x
      None => break
    }
    let binds = match w_binds.pop() {
      Some(b) => b
      None => []
    }
    if kind == 1 {
      sig_bind_cond_pat_from_expr(cur, bound, ctx, binds)
      continue
    }
    if kind == 2 {
      let mut bi = 0
      while bi < binds.length() {
        sig_bound_pop(bound, binds[bi])
        sig_local_callable_prune(bound, ctx, binds[bi])
        bi = bi + 1
      }
      continue
    }
    if kind == 3 {
      ctx.cond_depth = ctx.cond_depth + 1
      continue
    }
    if kind == 4 {
      ctx.cond_depth = ctx.cond_depth - 1
      continue
    }
    match cur {
      EIdent(name, _) => {
        let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, name)
        if pidx >= 0 {
          ctx.direct_callp.set(pidx, true)
        } else if sig_is_bound(bound, name) {
          match sig_local_callable_get_entry(bound, ctx, name) {
            Some(entry) => {
              let psrcs = sig_entry_all_param_srcs(entry, ctx)
              if psrcs.length() > 0 {
                sig_mark_param_srcs_direct_call(psrcs, ctx)
              }
              let cb_ts : Array[String] = []
              sig_collect_entry_cb_targets(entry, ctx, cb_ts)
              let mut cbi = 0
              while cbi < cb_ts.length() {
                let desc = cb_ts[cbi] + "@0"
                if !calls.contains(desc) {
                  calls.set(desc, true)
                  call_list.push(desc)
                }
                cbi = cbi + 1
              }
            }
            None => ()
          }
        } else if !idents.contains(name) {
          idents.set(name, true)
          ident_list.push(name)
        }
      }
      EBinary(op, l, r, _) =>
        if op == "&&" {
          let pbinds : Array[String] = []
          sig_collect_cond_pat_binds(l, pbinds)
          w_kind.push(4)
          w_expr.push(cur)
          w_binds.push([])
          if pbinds.length() > 0 {
            let live_binds : Array[String] = []
            w_kind.push(2)
            w_expr.push(cur)
            w_binds.push(live_binds)
            w_kind.push(0)
            w_expr.push(r)
            w_binds.push([])
            w_kind.push(1)
            w_expr.push(l)
            w_binds.push(live_binds)
            w_kind.push(3)
            w_expr.push(cur)
            w_binds.push([])
            w_kind.push(0)
            w_expr.push(l)
            w_binds.push([])
          } else {
            w_kind.push(0)
            w_expr.push(r)
            w_binds.push([])
            w_kind.push(3)
            w_expr.push(cur)
            w_binds.push([])
            w_kind.push(0)
            w_expr.push(l)
            w_binds.push([])
          }
        } else if op == "||" {
          w_kind.push(4)
          w_expr.push(cur)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(r)
          w_binds.push([])
          w_kind.push(3)
          w_expr.push(cur)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(l)
          w_binds.push([])
        } else {
          w_kind.push(0)
          w_expr.push(r)
          w_binds.push([])
          w_kind.push(0)
          w_expr.push(l)
          w_binds.push([])
        }
      EMutArg(inner, _) => {
        sig_mark_mut_place_dirty(inner, bound, ctx)
        w_kind.push(0)
        w_expr.push(inner)
        w_binds.push([])
      }
      EUnary(_, inner, _)
      | EField(inner, _, _)
      | EMove(inner, _)
      | EAs(inner, _, _)
      | ETry(inner, _)
      | ENamedArg(_, _, inner, _) => {
        w_kind.push(0)
        w_expr.push(inner)
        w_binds.push([])
      }
      EIs(inner, pat, _) => {
        sig_collect_pat_const_deps(pat, idents, ident_list, calls, call_list, ctx)
        w_kind.push(0)
        w_expr.push(inner)
        w_binds.push([])
      }
      EIndex(a, b, _) | EScope(a, b, _) | ESpawn(a, b, _) => {
        w_kind.push(0)
        w_expr.push(b)
        w_binds.push([])
        w_kind.push(0)
        w_expr.push(a)
        w_binds.push([])
      }
      EArrayLit(xs, _) | ETuple(xs, _) | EInterp(xs, _) | EDotVariant(_, xs, _) => {
        let mut i = xs.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(xs[i])
          w_binds.push([])
          i = i - 1
        }
      }
      EStructLit(sname, spread_opt, fields, sp) => {
        let st_name = match ctx.resolved_methods.get("st:" + span_key(sp)) {
          Some(rn) => rn
          None => sname
        }
        let mut fi = 0
        while fi < fields.length() {
          let tf_key = st_name + "." + fields[fi].name
          let ft : Array[String] = []
          let fseen : Map[String, Bool] = Map([])
          let ffwd : Array[Int] = []
          let _ = sig_extract_callable_targets(fields[fi].value, bound, ctx, ft, fseen, ffwd)
          sig_record_field_put(ctx, tf_key, ft)
          let mut pfi = 0
          while pfi < ffwd.length() {
            sig_union_str_array(
              ctx.field_put_params,
              [ctx.cur_fn_key + "|" + ffwd[pfi].to_string() + "|" + tf_key],
            )
            pfi = pfi + 1
          }
          let fps : Array[String] = []
          sig_collect_expr_param_srcs(fields[fi].value, bound, ctx, fps)
          let mut psi = 0
          while psi < fps.length() {
            sig_union_str_array(ctx.field_put_params, [fps[psi] + "|" + tf_key])
            psi = psi + 1
          }
          fi = fi + 1
        }
        let mut i = fields.length() - 1
        while i >= 0 {
          w_kind.push(0)
          w_expr.push(fields[i].value)
          w_binds.push([])
          i = i - 1
        }
        match spread_opt {
          Some(se) => {
            w_kind.push(0)
            w_expr.push(se)
            w_binds.push([])
          }
          None => ()
        }
      }
      ECall(callee, args, sp) => {
        if sig_is_ctor_call(callee, sp, bound, ctx) {
          if !ctx.has_tc {
            match callee {
              EIdent(cname, _) =>
                if !sig_is_bound(bound, cname) {
                  let ctag = "ctor?:" + cname
                  if !calls.contains(ctag) {
                    calls.set(ctag, true)
                    call_list.push(ctag)
                  }
                }
              _ => ()
            }
          }
          let mut i = args.length() - 1
          while i >= 0 {
            w_kind.push(0)
            w_expr.push(args[i])
            w_binds.push([])
            i = i - 1
          }
        } else {
        if !ctx.has_tc {
          match callee {
            EIdent(cname, _) =>
              if !sig_is_bound(bound, cname) {
                let ctag = "ctor?:" + cname
                if !calls.contains(ctag) {
                  calls.set(ctag, true)
                  call_list.push(ctag)
                }
              }
            EPath(qual, mem, _) => {
              let ctag = "ctor?:" + qual + "::" + mem
              if !calls.contains(ctag) {
                calls.set(ctag, true)
                call_list.push(ctag)
              }
            }
            _ => ()
          }
        }
        let mut has_known_target = false
        match callee {
          EIdent(cname, _) => {
            let tc_pkg_call = ctx.has_tc &&
              ctx.resolved_methods.contains("call_pkg:" + span_key(sp))
            let tc_nonlocal_builtin = ctx.has_tc &&
              !tc_pkg_call &&
              ctx.resolved_methods.contains("call_nonlocal:" + span_key(sp))
            let pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, cname)
            if tc_pkg_call {
              has_known_target = true
              let desc = sig_format_call_desc(cname, args, 0, bound, ctx)
              if !calls.contains(desc) {
                calls.set(desc, true)
                call_list.push(desc)
              }
              if !idents.contains(cname) {
                idents.set(cname, true)
                ident_list.push(cname)
              }
            } else if tc_nonlocal_builtin {
              // Typechecker resolved this bare call to a builtin (e.g. `ignore`, `math_sqrt`),
              // not the shadowed local/param; arguments are still traversed below.
              has_known_target = true
            } else if pidx >= 0 {
              match ctx.param_callable.get(pidx) {
                Some(true) => ctx.direct_callp.set(pidx, true)
                Some(false) => {
                  has_known_target = true
                  let desc = sig_format_call_desc(cname, args, 0, bound, ctx)
                  if !calls.contains(desc) {
                    calls.set(desc, true)
                    call_list.push(desc)
                  }
                  if !idents.contains(cname) {
                    idents.set(cname, true)
                    ident_list.push(cname)
                  }
                }
                None => {
                  ctx.direct_callp.set(pidx, true)
                  if !ctx.has_tc {
                    let desc = sig_format_call_desc(cname, args, 0, bound, ctx)
                    if !calls.contains(desc) {
                      calls.set(desc, true)
                      call_list.push(desc)
                    }
                    if !idents.contains(cname) {
                      idents.set(cname, true)
                      ident_list.push(cname)
                    }
                    let qtag = "call?:" + cname
                    if !calls.contains(qtag) {
                      calls.set(qtag, true)
                      call_list.push(qtag)
                    }
                  }
                }
              }
            } else if !sig_is_bound(bound, cname) {
              has_known_target = true
              let desc = sig_format_call_desc(cname, args, 0, bound, ctx)
              if !calls.contains(desc) {
                calls.set(desc, true)
                call_list.push(desc)
              }
              if !idents.contains(cname) {
                idents.set(cname, true)
                ident_list.push(cname)
              }
            } else {
              let mut add_pkg_fallback = false
              match sig_local_callable_get_entry(bound, ctx, cname) {
                Some(entry) => {
                  let psrcs = sig_entry_all_param_srcs(entry, ctx)
                  if psrcs.length() > 0 {
                    sig_mark_param_srcs_direct_call(psrcs, ctx)
                  }
                  if entry.targets.length() > 0 {
                    if entry.exact || entry.slot_key != "" {
                      has_known_target = true
                    }
                    let mut lti = 0
                    while lti < entry.targets.length() {
                      let desc = sig_format_call_desc(entry.targets[lti], args, 0, bound, ctx)
                      if !calls.contains(desc) {
                        calls.set(desc, true)
                        call_list.push(desc)
                      }
                      lti = lti + 1
                    }
                  }
                  if !ctx.has_tc &&
                    !(entry.exact && sig_targets_all_closures(entry.targets)) {
                    add_pkg_fallback = true
                  }
                }
                None =>
                  if !ctx.has_tc {
                    add_pkg_fallback = true
                  }
              }
              if add_pkg_fallback {
                let desc = sig_format_call_desc(cname, args, 0, bound, ctx)
                if !calls.contains(desc) {
                  calls.set(desc, true)
                  call_list.push(desc)
                }
                if !idents.contains(cname) {
                  idents.set(cname, true)
                  ident_list.push(cname)
                }
                let qtag = "call?:" + cname
                if !calls.contains(qtag) {
                  calls.set(qtag, true)
                  call_list.push(qtag)
                }
              }
            }
          }
          EPath(qual, mem, _) => {
            has_known_target = true
            let desc = sig_format_call_desc(qual + "::" + mem, args, 0, bound, ctx)
            if !calls.contains(desc) {
              calls.set(desc, true)
              call_list.push(desc)
            }
          }
          _ => {
            let ctargets : Array[String] = []
            let cseen : Map[String, Bool] = Map([])
            let cfwd : Array[Int] = []
            let callee_exact = sig_extract_callable_targets(
              callee,
              bound,
              ctx,
              ctargets,
              cseen,
              cfwd,
            )
            let mut fi = 0
            while fi < cfwd.length() {
              ctx.direct_callp.set(cfwd[fi], true)
              fi = fi + 1
            }
            match callee {
              EIndex(EIdent(cname, _), _, _) =>
                if sig_is_bound(bound, cname) {
                  match sig_local_callable_get_entry(bound, ctx, cname) {
                    Some(entry) =>
                      sig_mark_param_srcs_direct_call(sig_entry_all_param_srcs(entry, ctx), ctx)
                    None => ()
                  }
                }
              _ => ()
            }
            if ctargets.length() > 0 && callee_exact {
              has_known_target = true
            }
            let mut cti = 0
            while cti < ctargets.length() {
              let desc = sig_format_call_desc(ctargets[cti], args, 0, bound, ctx)
              if !calls.contains(desc) {
                calls.set(desc, true)
                call_list.push(desc)
              }
              cti = cti + 1
            }
            w_kind.push(0)
            w_expr.push(callee)
            w_binds.push([])
          }
        }
        if !has_known_target && args.length() > 0 {
          let desc = sig_format_call_desc("?", args, 0, bound, ctx)
          if !calls.contains(desc) {
            calls.set(desc, true)
            call_list.push(desc)
          }
        }
        let mut i = args.length() - 1
        while i >= 0 {
          sig_mark_container_alias_dirty(args[i], bound, ctx)
          if !has_known_target ||
            !sig_is_forwarded_param_or_alias_arg(args[i], bound, ctx) {
            w_kind.push(0)
            w_expr.push(args[i])
            w_binds.push([])
          }
          i = i - 1
        }
        }
      }
      EMethodCall(recv, mname, args, sp) => {
        let mut is_field_call = false
        let mut field_tf_key = mname
        let target = match ctx.resolved_methods.get(span_key(sp)) {
          Some(rk) =>
            if starts_with_str(rk, "@field::") {
              is_field_call = true
              let rest = slice_str(rk, 8, rk.length())
              let suf = "::" + mname
              if rest.length() > suf.length() &&
                slice_str(rest, rest.length() - suf.length(), rest.length()) == suf {
                let sname = slice_str(rest, 0, rest.length() - suf.length())
                field_tf_key = sname + "." + mname
              } else {
                field_tf_key = rest
              }
              "?"
            } else {
              rk
            }
          None => "." + mname
        }
        let is_builtin_ro = is_field_call || ((mname == "length" || mname == "is_empty" || mname == "get" || mname == "contains") &&
          match ctx.resolved_methods.get(span_key(sp)) {
            None => false
            Some(rk) => starts_with_str(rk, "__builtin__::")
          })
        let recv_root = sig_mut_place_root(recv)
        if recv_root != "" {
          let recv_pidx = sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, recv_root)
          if recv_pidx >= 0 {
            sig_union_str_array(
              ctx.mut_param_fwds,
              [recv_pidx.to_string() + "|" + target + "|0"],
            )
            if !is_builtin_ro {
              let mut ai = 0
              while ai < args.length() {
                let at : Array[String] = []
                let aseen : Map[String, Bool] = Map([])
                let afwd : Array[Int] = []
                let _ = sig_extract_callable_targets(args[ai], bound, ctx, at, aseen, afwd)
                sig_record_param_mut_write(ctx, recv_pidx, at)
                ai = ai + 1
              }
            }
          } else if sig_is_bound(bound, recv_root) {
            if !is_builtin_ro {
              let entry_opt = match sig_local_callable_get_entry(bound, ctx, recv_root) {
                Some(e) =>
                  if e.cslots.length() > 0 || e.cslot_unknown {
                    Some(e)
                  } else if mname == "push" || mname == "set" || mname == "insert" {
                    let ck = sig_cslot_for_site(ctx, "mcall:" + span_key(sp))
                    e.cslots.push(ck)
                    sig_union_str_array(e.targets, [ck])
                    if e.slot_key != "" {
                      match ctx.mut_slot_targets.get(e.slot_key) {
                        Some(cur) => sig_union_str_array(cur, [ck])
                        None => ctx.mut_slot_targets.set(e.slot_key, [ck])
                      }
                      ctx.mut_slot_exact.set(e.slot_key, false)
                    }
                    Some(e)
                  } else {
                    None
                  }
                None =>
                  if mname == "push" || mname == "set" || mname == "insert" {
                    let ck = sig_cslot_for_site(ctx, "mcall:" + span_key(sp))
                    let ne = SigLocalCallable::{
                      depth: sig_bound_depth(bound, recv_root),
                      targets: [ck],
                      exact: false,
                      slot_key: "",
                      cslots: [ck],
                      cslot_unknown: false,
                      param_srcs: [],
                      payload_evals: [],
                      field_targets: Map([]),
                      field_param_srcs: Map([]),
                      fields_exact: false,
                    }
                    sig_local_callable_set_entry(bound, ctx, recv_root, ne)
                    Some(ne)
                  } else {
                    None
                  }
              }
              match entry_opt {
                Some(entry) => {
                  let mut ci2 = 0
                  while ci2 < entry.cslots.length() {
                    ctx.cslot_dirty.set(entry.cslots[ci2], true)
                    ci2 = ci2 + 1
                  }
                  if entry.cslot_unknown {
                    sig_mark_all_cslots_dirty(ctx)
                  }
                  let mut ai = 0
                  while ai < args.length() {
                    let at : Array[String] = []
                    let aseen : Map[String, Bool] = Map([])
                    let afwd : Array[Int] = []
                    let _ = sig_extract_callable_targets(args[ai], bound, ctx, at, aseen, afwd)
                    ci2 = 0
                    while ci2 < entry.cslots.length() {
                      sig_cslot_add_targets(ctx, entry.cslots[ci2], at)
                      ci2 = ci2 + 1
                    }
                    if entry.cslot_unknown {
                      sig_cslot_hub_add_targets(ctx, at)
                    }
                    if entry.slot_key != "" {
                      match ctx.mut_slot_targets.get(entry.slot_key) {
                        Some(cur) => sig_union_str_array(cur, at)
                        None => ctx.mut_slot_targets.set(entry.slot_key, at)
                      }
                      ctx.mut_slot_exact.set(entry.slot_key, false)
                    }
                    ai = ai + 1
                  }
                }
                None => ()
              }
            }
            match sig_local_callable_get_entry(bound, ctx, recv_root) {
              Some(entry) => {
                let psrcs = sig_entry_all_param_srcs(entry, ctx)
                if psrcs.length() > 0 {
                  sig_record_param_srcs_fwd(ctx, psrcs, target, "0")
                  if !is_builtin_ro {
                    let mut ai = 0
                    while ai < args.length() {
                      let at : Array[String] = []
                      let aseen : Map[String, Bool] = Map([])
                      let afwd : Array[Int] = []
                      let _ = sig_extract_callable_targets(args[ai], bound, ctx, at, aseen, afwd)
                      sig_record_param_srcs_write(ctx, psrcs, at)
                      ai = ai + 1
                    }
                  }
                }
                if entry.slot_key != "" {
                  sig_add_slot_mut_link(ctx, entry.slot_key + "|" + target + "|0")
                }
                let mut ci2 = 0
                while ci2 < entry.cslots.length() {
                  sig_add_slot_mut_link(ctx, entry.cslots[ci2] + "|" + target + "|0")
                  ci2 = ci2 + 1
                }
              }
              None => ()
            }
          }
        }
        let mut exact_field_hit = false
        if is_field_call {
          let unwrapped_recv = match recv {
            EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
            x => x
          }
          match unwrapped_recv {
            EStructLit(_, None, sfields, _) => {
              let mut si = 0
              while si < sfields.length() {
                if sfields[si].name == mname {
                  let ft : Array[String] = []
                  let fseen : Map[String, Bool] = Map([])
                  let ffwd : Array[Int] = []
                  let f_exact = sig_extract_callable_targets(sfields[si].value, bound, ctx, ft, fseen, ffwd)
                  let fp : Array[String] = []
                  sig_collect_expr_param_srcs(sfields[si].value, bound, ctx, fp)
                  if f_exact && (ft.length() > 0 || ffwd.length() > 0 || fp.length() > 0) {
                    exact_field_hit = true
                    let mut ffi = 0
                    while ffi < ffwd.length() {
                      ctx.direct_callp.set(ffwd[ffi], true)
                      ffi = ffi + 1
                    }
                    sig_mark_param_srcs_direct_call(fp, ctx)
                    let mut fti = 0
                    while fti < ft.length() {
                      let fdesc = sig_format_call_desc(ft[fti], args, 0, bound, ctx)
                      if !calls.contains(fdesc) {
                        calls.set(fdesc, true)
                        call_list.push(fdesc)
                      }
                      fti = fti + 1
                    }
                  }
                }
                si = si + 1
              }
            }
            EIdent(rname, _) =>
              if sig_is_bound(bound, rname) {
                match sig_local_callable_get_entry(bound, ctx, rname) {
                  Some(entry) =>
                    if entry.fields_exact &&
                      (entry.field_targets.contains(mname) || entry.field_param_srcs.contains(mname)) {
                      exact_field_hit = true
                      match entry.field_targets.get(mname) {
                        Some(ft) => {
                          let mut fti = 0
                          while fti < ft.length() {
                            let fdesc = sig_format_call_desc(ft[fti], args, 0, bound, ctx)
                            if !calls.contains(fdesc) {
                              calls.set(fdesc, true)
                              call_list.push(fdesc)
                            }
                            fti = fti + 1
                          }
                        }
                        None => ()
                      }
                      match entry.field_param_srcs.get(mname) {
                        Some(fp) => sig_mark_param_srcs_direct_call(fp, ctx)
                        None => ()
                      }
                    }
                  None => ()
                }
              } else if sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, rname) < 0 {
                exact_field_hit = true
                let cf_desc = sig_format_call_desc(
                  "cf?:" + rname + "." + mname + "#" + field_tf_key,
                  args,
                  0,
                  bound,
                  ctx,
                )
                if !calls.contains(cf_desc) {
                  calls.set(cf_desc, true)
                  call_list.push(cf_desc)
                }
              }
            _ => ()
          }
          if exact_field_hit {
            let fw_desc = sig_format_call_desc("fw:" + field_tf_key, args, 0, bound, ctx)
            if !calls.contains(fw_desc) {
              calls.set(fw_desc, true)
              call_list.push(fw_desc)
            }
          } else {
            let fp_desc = sig_format_call_desc("fp:" + field_tf_key, args, 0, bound, ctx)
            if !calls.contains(fp_desc) {
              calls.set(fp_desc, true)
              call_list.push(fp_desc)
            }
            let rtargets : Array[String] = []
            let rseen : Map[String, Bool] = Map([])
            let rfwd : Array[Int] = []
            let _ = sig_extract_callable_targets(recv, bound, ctx, rtargets, rseen, rfwd)
            let mut rfi = 0
            while rfi < rfwd.length() {
              ctx.direct_callp.set(rfwd[rfi], true)
              rfi = rfi + 1
            }
            let mut rti = 0
            while rti < rtargets.length() {
              let rdesc = sig_format_call_desc(rtargets[rti], args, 0, bound, ctx)
              if !calls.contains(rdesc) {
                calls.set(rdesc, true)
                call_list.push(rdesc)
              }
              rti = rti + 1
            }
            match recv {
              EIdent(rname, _) =>
                if sig_is_bound(bound, rname) {
                  match sig_local_callable_get_entry(bound, ctx, rname) {
                    Some(entry) =>
                      sig_mark_param_srcs_direct_call(sig_entry_all_param_srcs(entry, ctx), ctx)
                    None => ()
                  }
                }
              _ => ()
            }
          }
        }
        if !exact_field_hit {
          let desc = sig_format_call_desc(target, args, 1, bound, ctx)
          if !calls.contains(desc) {
            calls.set(desc, true)
            call_list.push(desc)
          }
        }
        if !ctx.has_tc {
          let mut emit_mth_ambig = mname == "push" || mname == "set" || mname == "insert"
          if !emit_mth_ambig {
            let rtargets : Array[String] = []
            let rseen : Map[String, Bool] = Map([])
            let rfwd : Array[Int] = []
            let _ = sig_extract_callable_targets(recv, bound, ctx, rtargets, rseen, rfwd)
            if rtargets.length() > 0 || rfwd.length() > 0 {
              emit_mth_ambig = true
            }
          }
          if emit_mth_ambig {
            let mtag = "mth?:" + mname
            if !calls.contains(mtag) {
              calls.set(mtag, true)
              call_list.push(mtag)
            }
          }
        }
        let mut i = args.length() - 1
        while i >= 0 {
          if !sig_is_forwarded_param_or_alias_arg(args[i], bound, ctx) {
            w_kind.push(0)
            w_expr.push(args[i])
            w_binds.push([])
          }
          i = i - 1
        }
        w_kind.push(0)
        w_expr.push(recv)
        w_binds.push([])
      }
      EBlock(stmts, _) =>
        sig_collect_stmts_deps(stmts, bound, idents, ident_list, calls, call_list, ctx)
      EIf(cond, then_stmts, else_opt, _) => {
        sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
        let pbinds : Array[String] = []
        sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
        ctx.cond_depth = ctx.cond_depth + 1
        sig_collect_stmts_deps(then_stmts, bound, idents, ident_list, calls, call_list, ctx)
        ctx.cond_depth = ctx.cond_depth - 1
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_pop(bound, pbinds[bi])
          sig_local_callable_prune(bound, ctx, pbinds[bi])
          bi = bi + 1
        }
        match else_opt {
          Some(ee) => {
            ctx.cond_depth = ctx.cond_depth + 1
            sig_collect_expr_deps(ee, bound, idents, ident_list, calls, call_list, ctx)
            ctx.cond_depth = ctx.cond_depth - 1
          }
          None => ()
        }
      }
      EMatch(scrut, arms, _) => {
        sig_collect_expr_deps(scrut, bound, idents, ident_list, calls, call_list, ctx)
        let scrut_eval = sig_eval_local_let_rhs(scrut, bound, ctx)
        let mut ai = 0
        while ai < arms.length() {
          sig_collect_pat_const_deps(arms[ai].pat, idents, ident_list, calls, call_list, ctx)
          let pbinds : Array[String] = []
          sig_bind_pat_from_expr(arms[ai].pat, scrut, scrut_eval, bound, ctx, pbinds)
          ctx.cond_depth = ctx.cond_depth + 1
          match arms[ai].guard_expr {
            Some(ge) => {
              sig_collect_expr_deps(ge, bound, idents, ident_list, calls, call_list, ctx)
              sig_bind_cond_pat_from_expr(ge, bound, ctx, pbinds)
            }
            None => ()
          }
          sig_collect_expr_deps(arms[ai].body, bound, idents, ident_list, calls, call_list, ctx)
          ctx.cond_depth = ctx.cond_depth - 1
          let mut bi = 0
          while bi < pbinds.length() {
            sig_bound_pop(bound, pbinds[bi])
            sig_local_callable_prune(bound, ctx, pbinds[bi])
            bi = bi + 1
          }
          ai = ai + 1
        }
      }
      // Closure creation does not execute its body during constant initialization,
      // but capturing an unshadowed outer function parameter or alias conservatively marks it escaped.
      EClosure(cparams, _, cbody, _) =>
        if ctx.param_idx.length() > 0 || ctx.local_callables.length() > 0 {
          let cbound = sig_clone_bound(bound)
          let mut cpi = 0
          while cpi < cparams.length() {
            sig_bound_push(cbound, cparams[cpi].name)
            cpi = cpi + 1
          }
          sig_scan_param_escape_stmts(cbody, cbound, ctx)
          let mut eci = 0
          while eci < ctx.escaped_cbs.length() {
            let desc = ctx.escaped_cbs[eci] + "@0"
            if !calls.contains(desc) {
              calls.set(desc, true)
              call_list.push(desc)
            }
            eci = eci + 1
          }
          while ctx.escaped_cbs.length() > 0 {
            let _ = ctx.escaped_cbs.pop()
          }
        }
      _ => ()
    }
  }
}

///|
fn sig_collect_cond_pat_binds(e : Expr, out : Array[String]) -> Unit {
  let work : Array[Expr] = [e]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EIs(_, pat, _) => sig_collect_pat_binds(pat, out)
          EBinary("&&", l, r, _) => {
            work.push(r)
            work.push(l)
          }
          _ => ()
        }
      None => break
    }
  }
}

///|
fn sig_collect_assign_lhs_deps(
  lhs : Expr,
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  match lhs {
    EIdent(name, _) =>
      if !sig_is_bound(bound, name) && !idents.contains(name) {
        idents.set(name, true)
        ident_list.push(name)
      }
    EField(base, _, _) =>
      sig_collect_assign_lhs_deps(base, bound, idents, ident_list, calls, call_list, ctx)
    EIndex(base, idx, _) => {
      sig_collect_assign_lhs_deps(base, bound, idents, ident_list, calls, call_list, ctx)
      sig_collect_expr_deps(idx, bound, idents, ident_list, calls, call_list, ctx)
    }
    _ => sig_collect_expr_deps(lhs, bound, idents, ident_list, calls, call_list, ctx)
  }
}

///|
fn sig_outer_cslots_fp(
  outer_keys : Array[String],
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Int {
  let mut fp = ctx.cslot_order.length() * 8 +
    ctx.cslot_dirty_prefix_max[0] * 3 +
    ctx.cslot_hub_lens.length() * 5 +
    ctx.slot_mut_links.length() * 2
  let mut hi_fp = 0
  while hi_fp < ctx.cslot_hub_lens.length() {
    let hkey = sig_cslot_hub_key(ctx, ctx.cslot_hub_lens[hi_fp])
    match ctx.cslot_targets.get(hkey) {
      Some(ts) => fp = fp + ts.length() * 2
      None => ()
    }
    hi_fp = hi_fp + 1
  }
  let mut i = 0
  while i < outer_keys.length() {
    match sig_local_callable_get_entry(bound, ctx, outer_keys[i]) {
      Some(entry) => {
        fp = fp + entry.targets.length() * 2 + entry.param_srcs.length() * 2 + entry.cslots.length() * 4
        if entry.cslot_unknown {
          fp = fp + 1
        }
        if entry.slot_key != "" {
          match ctx.mut_slot_targets.get(entry.slot_key) {
            Some(ts) => fp = fp + ts.length() * 2
            None => ()
          }
          match ctx.mut_slot_param_srcs.get(entry.slot_key) {
            Some(ps) => fp = fp + ps.length() * 2
            None => ()
          }
        }
      }
      None => ()
    }
    i = i + 1
  }
  let mut ci = 0
  while ci < ctx.cslot_order.length() {
    let ck = ctx.cslot_order[ci]
    match ctx.cslot_targets.get(ck) {
      Some(ts) => fp = fp + ts.length() * 2
      None => ()
    }
    match ctx.cslot_ref_keys.get(ck) {
      Some(rs) => fp = fp + rs.length()
      None => ()
    }
    if sig_cslot_is_dirty(ctx, ck) {
      fp = fp + 1
    }
    ci = ci + 1
  }
  let mut cbi = 0
  while cbi < ctx.cb_order.length() {
    match ctx.cb_states.get(ctx.cb_order[cbi]) {
      Some(st) => {
        fp = fp +
          st.ident_list.length() * 2 +
          st.call_list.length() * 2 +
          st.direct_callp.length() +
          st.fwd_callp_list.length() +
          st.mut_param_fwds.length() +
          st.cb_mut_fwds.length() +
          st.cb_param_calls.length() +
          st.cb_param_fwds.length()
        let mpkeys = st.mut_param_writes.keys()
        let mut mpi = 0
        while mpi < mpkeys.length() {
          match st.mut_param_writes.get(mpkeys[mpi]) {
            Some(vs) => fp = fp + vs.length()
            None => ()
          }
          mpi = mpi + 1
        }
        let cmkeys = st.cb_mut_writes.keys()
        let mut cmi = 0
        while cmi < cmkeys.length() {
          match st.cb_mut_writes.get(cmkeys[cmi]) {
            Some(vs) => fp = fp + vs.length()
            None => ()
          }
          cmi = cmi + 1
        }
      }
      None => ()
    }
    cbi = cbi + 1
  }
  fp
}

///|
fn sig_fallback_dirty_outer_cslots(
  outer_keys : Array[String],
  bound : Map[String, Int],
  ctx : SigDepCtx,
) -> Unit {
  let all_mut_targets : Array[String] = []
  let all_mut_psrcs : Array[String] = []
  let mut i = 0
  while i < outer_keys.length() {
    match sig_local_callable_get_entry(bound, ctx, outer_keys[i]) {
      Some(entry) => {
        if entry.slot_key != "" {
          entry.cslot_unknown = true
          match ctx.mut_slot_targets.get(entry.slot_key) {
            Some(ts) => sig_union_str_array(all_mut_targets, ts)
            None => ()
          }
          match ctx.mut_slot_param_srcs.get(entry.slot_key) {
            Some(ps) => sig_union_str_array(all_mut_psrcs, ps)
            None => ()
          }
        }
        let mut ci = 0
        while ci < entry.cslots.length() {
          ctx.cslot_dirty.set(entry.cslots[ci], true)
          ci = ci + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
  let all_cslot_targets : Array[String] = []
  let all_cslot_refs : Array[String] = []
  sig_union_str_array(all_cslot_targets, all_mut_targets)
  let mut hi_fb = 0
  while hi_fb < ctx.cslot_hub_lens.length() {
    let hkey = sig_cslot_hub_key(ctx, ctx.cslot_hub_lens[hi_fb])
    match ctx.cslot_targets.get(hkey) {
      Some(ts) => sig_union_str_array(all_cslot_targets, ts)
      None => ()
    }
    hi_fb = hi_fb + 1
  }
  let mut ci2 = 0
  while ci2 < ctx.cslot_order.length() {
    let ck = ctx.cslot_order[ci2]
    match ctx.cslot_targets.get(ck) {
      Some(ts) => sig_union_str_array(all_cslot_targets, ts)
      None => ()
    }
    match ctx.cslot_ref_keys.get(ck) {
      Some(rs) => sig_union_str_array(all_cslot_refs, rs)
      None => ()
    }
    ci2 = ci2 + 1
  }
  ci2 = 0
  while ci2 < ctx.cslot_order.length() {
    let ck = ctx.cslot_order[ci2]
    ctx.cslot_dirty.set(ck, true)
    sig_cslot_add_targets(ctx, ck, all_cslot_targets)
    if all_cslot_refs.length() > 0 {
      match ctx.cslot_ref_keys.get(ck) {
        Some(cur) => sig_union_str_array(cur, all_cslot_refs)
        None => {
          let copy : Array[String] = []
          sig_union_str_array(copy, all_cslot_refs)
          ctx.cslot_ref_keys.set(ck, copy)
        }
      }
    }
    ci2 = ci2 + 1
  }
  i = 0
  while i < outer_keys.length() {
    match sig_local_callable_get_entry(bound, ctx, outer_keys[i]) {
      Some(entry) =>
        if entry.slot_key != "" {
          if all_mut_targets.length() > 0 {
            match ctx.mut_slot_targets.get(entry.slot_key) {
              Some(cur) => sig_union_str_array(cur, all_mut_targets)
              None => ctx.mut_slot_targets.set(entry.slot_key, all_mut_targets)
            }
            ctx.mut_slot_exact.set(entry.slot_key, false)
          }
          if all_mut_psrcs.length() > 0 {
            match ctx.mut_slot_param_srcs.get(entry.slot_key) {
              Some(cur) => sig_union_str_array(cur, all_mut_psrcs)
              None => ctx.mut_slot_param_srcs.set(entry.slot_key, all_mut_psrcs)
            }
            sig_union_str_array(entry.param_srcs, all_mut_psrcs)
          }
        }
      None => ()
    }
    i = i + 1
  }
}

///|
fn sig_empty_local_let_eval() -> SigLocalLetEval {
  SigLocalLetEval::{
    targets: [],
    exact: false,
    cslots: [],
    cslot_unknown: false,
    param_srcs: [],
    site_key: "",
    payload_evals: [],
    field_targets: Map([]),
    field_param_srcs: Map([]),
    fields_exact: false,
  }
}

///|
fn sig_unpack_fallback_eval(ev : SigLocalLetEval) -> SigLocalLetEval {
  let targets : Array[String] = []
  sig_union_str_array(targets, ev.targets)
  sig_union_str_array(targets, ev.cslots)
  SigLocalLetEval::{
    targets: targets,
    exact: false,
    cslots: [],
    cslot_unknown: true,
    param_srcs: ev.param_srcs,
    site_key: ev.site_key,
    payload_evals: [],
    field_targets: Map([]),
    field_param_srcs: Map([]),
    fields_exact: false,
  }
}

///|
fn sig_collect_pat_bindings(
  pat : Pattern,
  scrut : Expr,
  scrut_eval : SigLocalLetEval,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out_names : Array[String],
  out_evals : Array[SigLocalLetEval],
) -> Unit {
  let unwrapped = match scrut {
    EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
    x => x
  }
  let opaque_scrut = EUnit(expr_span(scrut))
  match pat {
    PIdent(name, _) =>
      if name != "_" {
        out_names.push(name)
        out_evals.push(scrut_eval)
      }
    PVariant(_, vname, subs, _, _) => {
      let mut matched_args : Option[Array[Expr]] = None
      match unwrapped {
        ECall(callee, cargs, sp) =>
          if sig_is_ctor_call(callee, sp, bound, ctx) {
            let cname = match callee {
              EIdent(n, _) => n
              EPath(_, n, _) => n
              _ => ""
            }
            if cname == vname {
              matched_args = Some(cargs)
            }
          }
        EDotVariant(cname, cargs, _) =>
          if cname == vname {
            matched_args = Some(cargs)
          }
        _ => ()
      }
      let mut i = 0
      while i < subs.length() {
        match matched_args {
          Some(cargs) =>
            if i < cargs.length() {
              let aev = sig_eval_local_let_rhs(cargs[i], bound, ctx)
              sig_collect_pat_bindings(subs[i], cargs[i], aev, bound, ctx, out_names, out_evals)
            } else {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                sig_unpack_fallback_eval(scrut_eval),
                bound,
                ctx,
                out_names,
                out_evals,
              )
            }
          None =>
            if i < scrut_eval.payload_evals.length() {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                scrut_eval.payload_evals[i],
                bound,
                ctx,
                out_names,
                out_evals,
              )
            } else {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                sig_unpack_fallback_eval(scrut_eval),
                bound,
                ctx,
                out_names,
                out_evals,
              )
            }
        }
        i = i + 1
      }
    }
    PTuple(subs, _) =>
      match unwrapped {
        ETuple(elems, _) =>
          if elems.length() == subs.length() {
            let mut i = 0
            while i < subs.length() {
              let eev = sig_eval_local_let_rhs(elems[i], bound, ctx)
              sig_collect_pat_bindings(subs[i], elems[i], eev, bound, ctx, out_names, out_evals)
              i = i + 1
            }
          } else {
            let mut i = 0
            while i < subs.length() {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                sig_unpack_fallback_eval(scrut_eval),
                bound,
                ctx,
                out_names,
                out_evals,
              )
              i = i + 1
            }
          }
        _ => {
          let mut i = 0
          while i < subs.length() {
            if i < scrut_eval.payload_evals.length() {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                scrut_eval.payload_evals[i],
                bound,
                ctx,
                out_names,
                out_evals,
              )
            } else {
              sig_collect_pat_bindings(
                subs[i],
                opaque_scrut,
                sig_unpack_fallback_eval(scrut_eval),
                bound,
                ctx,
                out_names,
                out_evals,
              )
            }
            i = i + 1
          }
        }
      }
    _ => ()
  }
}

///|
fn sig_bind_pat_from_expr(
  pat : Pattern,
  scrut : Expr,
  scrut_eval : SigLocalLetEval,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out_binds : Array[String],
) -> Unit {
  let names : Array[String] = []
  let evals : Array[SigLocalLetEval] = []
  sig_collect_pat_bindings(pat, scrut, scrut_eval, bound, ctx, names, evals)
  let mut i = 0
  while i < names.length() {
    sig_commit_local_let(names[i], false, evals[i], bound, ctx)
    out_binds.push(names[i])
    i = i + 1
  }
}

///|
fn sig_bind_cond_pat_from_expr(
  cond : Expr,
  bound : Map[String, Int],
  ctx : SigDepCtx,
  out_binds : Array[String],
) -> Unit {
  let work : Array[Expr] = [cond]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EIs(scrut, pat, _) => {
            let scrut_eval = sig_eval_local_let_rhs(scrut, bound, ctx)
            sig_bind_pat_from_expr(pat, scrut, scrut_eval, bound, ctx, out_binds)
          }
          EBinary("&&", l, r, _) => {
            work.push(r)
            work.push(l)
          }
          _ => ()
        }
      None => break
    }
  }
}

///|
fn sig_merge_local_let_eval(a : SigLocalLetEval, b : SigLocalLetEval) -> SigLocalLetEval {
  let targets : Array[String] = []
  sig_union_str_array(targets, a.targets)
  sig_union_str_array(targets, b.targets)
  let cslots : Array[String] = []
  sig_union_str_array(cslots, a.cslots)
  sig_union_str_array(cslots, b.cslots)
  let param_srcs : Array[String] = []
  sig_union_str_array(param_srcs, a.param_srcs)
  sig_union_str_array(param_srcs, b.param_srcs)
  let payload_evals : Array[SigLocalLetEval] = []
  if a.payload_evals.length() > 0 && a.payload_evals.length() == b.payload_evals.length() {
    let mut pi = 0
    while pi < a.payload_evals.length() {
      payload_evals.push(sig_merge_local_let_eval(a.payload_evals[pi], b.payload_evals[pi]))
      pi = pi + 1
    }
  }
  let field_targets : Map[String, Array[String]] = Map([])
  let field_param_srcs : Map[String, Array[String]] = Map([])
  let fields_exact = a.fields_exact && b.fields_exact
  if fields_exact {
    let aks = a.field_targets.keys()
    let mut ki = 0
    while ki < aks.length() {
      let fk = aks[ki]
      if b.field_targets.contains(fk) {
        let cp : Array[String] = []
        match a.field_targets.get(fk) {
          Some(vs) => sig_union_str_array(cp, vs)
          None => ()
        }
        match b.field_targets.get(fk) {
          Some(vs) => sig_union_str_array(cp, vs)
          None => ()
        }
        field_targets.set(fk, cp)
      }
      ki = ki + 1
    }
    let apks = a.field_param_srcs.keys()
    ki = 0
    while ki < apks.length() {
      let pk = apks[ki]
      if b.field_param_srcs.contains(pk) {
        let cp : Array[String] = []
        match a.field_param_srcs.get(pk) {
          Some(vs) => sig_union_str_array(cp, vs)
          None => ()
        }
        match b.field_param_srcs.get(pk) {
          Some(vs) => sig_union_str_array(cp, vs)
          None => ()
        }
        field_param_srcs.set(pk, cp)
      }
      ki = ki + 1
    }
  }
  SigLocalLetEval::{
    targets: targets,
    exact: a.exact && b.exact,
    cslots: cslots,
    cslot_unknown: a.cslot_unknown || b.cslot_unknown,
    param_srcs: param_srcs,
    site_key: a.site_key,
    payload_evals: payload_evals,
    field_targets: field_targets,
    field_param_srcs: field_param_srcs,
    fields_exact: fields_exact,
  }
}

///|
fn sig_collect_and_eval_tuple_rhs(
  init_e : Expr,
  arity : Int,
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Array[SigLocalLetEval] {
  let unwrapped = match init_e {
    EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
    x => x
  }
  match unwrapped {
    ETuple(elems, _) =>
      if elems.length() == arity {
        let evals : Array[SigLocalLetEval] = []
        let mut ni = 0
        while ni < elems.length() {
          let is_el_clo = match elems[ni] {
            EClosure(_, _, _, _) => true
            EMove(EClosure(_, _, _, _), _) => true
            _ => false
          }
          if !is_el_clo && !sig_is_pure_bound_ident(elems[ni], bound, ctx) {
            sig_collect_expr_deps(
              elems[ni],
              bound,
              idents,
              ident_list,
              calls,
              call_list,
              ctx,
            )
          }
          evals.push(sig_eval_local_let_rhs(elems[ni], bound, ctx))
          ni = ni + 1
        }
        evals
      } else {
        sig_collect_expr_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
        let evals : Array[SigLocalLetEval] = []
        let mut k = 0
        while k < arity {
          evals.push(sig_empty_local_let_eval())
          k = k + 1
        }
        evals
      }
    EBlock(stmts, _) => {
      let local_binds : Array[String] = []
      let mut res : Array[SigLocalLetEval] = []
      let mut k = 0
      while k < arity {
        res.push(sig_empty_local_let_eval())
        k = k + 1
      }
      let mut i = 0
      while i < stmts.length() {
        let is_last = i + 1 == stmts.length()
        match stmts[i] {
          SLet(lname, is_mut, _, ie, _) => {
            sig_collect_local_let_init_deps(ie, bound, idents, ident_list, calls, call_list, ctx)
            sig_bind_local_let(lname, is_mut, ie, bound, ctx)
            local_binds.push(lname)
          }
          SLetTuple(tnames, _, ie, _) => {
            let tevals = sig_collect_and_eval_tuple_rhs(
              ie,
              tnames.length(),
              bound,
              idents,
              ident_list,
              calls,
              call_list,
              ctx,
            )
            let mut ni = 0
            while ni < tnames.length() {
              sig_commit_local_let(tnames[ni], false, tevals[ni], bound, ctx)
              local_binds.push(tnames[ni])
              ni = ni + 1
            }
          }
          SGuard(cond, eb, _) => {
            ctx.cond_depth = ctx.cond_depth + 1
            sig_collect_stmts_deps(eb, bound, idents, ident_list, calls, call_list, ctx)
            ctx.cond_depth = ctx.cond_depth - 1
            sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
            let pbinds : Array[String] = []
            sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
            let mut bi = 0
            while bi < pbinds.length() {
              local_binds.push(pbinds[bi])
              bi = bi + 1
            }
          }
          SExpr(tail, _) =>
            if is_last {
              res = sig_collect_and_eval_tuple_rhs(
                tail,
                arity,
                bound,
                idents,
                ident_list,
                calls,
                call_list,
                ctx,
              )
            } else {
              sig_collect_expr_deps(tail, bound, idents, ident_list, calls, call_list, ctx)
            }
          other =>
            sig_collect_stmts_deps([other], bound, idents, ident_list, calls, call_list, ctx)
        }
        i = i + 1
      }
      let mut li = 0
      while li < local_binds.length() {
        sig_bound_pop(bound, local_binds[li])
        sig_local_callable_prune(bound, ctx, local_binds[li])
        li = li + 1
      }
      res
    }
    EIf(cond, tb, eb, sp) => {
      sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
      let pbinds : Array[String] = []
      sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
      ctx.cond_depth = ctx.cond_depth + 1
      let r_then = sig_collect_and_eval_tuple_rhs(
        EBlock(tb, sp),
        arity,
        bound,
        idents,
        ident_list,
        calls,
        call_list,
        ctx,
      )
      let mut bi = 0
      while bi < pbinds.length() {
        sig_bound_pop(bound, pbinds[bi])
        sig_local_callable_prune(bound, ctx, pbinds[bi])
        bi = bi + 1
      }
      let res = match eb {
        Some(ee) => {
          let r_else = sig_collect_and_eval_tuple_rhs(
            ee,
            arity,
            bound,
            idents,
            ident_list,
            calls,
            call_list,
            ctx,
          )
          let merged : Array[SigLocalLetEval] = []
          let mut k = 0
          while k < arity {
            merged.push(sig_merge_local_let_eval(r_then[k], r_else[k]))
            k = k + 1
          }
          merged
        }
        None => r_then
      }
      ctx.cond_depth = ctx.cond_depth - 1
      res
    }
    EMatch(scrut, arms, _) => {
      sig_collect_expr_deps(scrut, bound, idents, ident_list, calls, call_list, ctx)
      let scrut_eval = sig_eval_local_let_rhs(scrut, bound, ctx)
      let mut has_any = false
      let mut acc : Array[SigLocalLetEval] = []
      let mut k = 0
      while k < arity {
        acc.push(sig_empty_local_let_eval())
        k = k + 1
      }
      ctx.cond_depth = ctx.cond_depth + 1
      let mut ai = 0
      while ai < arms.length() {
        sig_collect_pat_const_deps(arms[ai].pat, idents, ident_list, calls, call_list, ctx)
        let pbinds : Array[String] = []
        sig_bind_pat_from_expr(arms[ai].pat, scrut, scrut_eval, bound, ctx, pbinds)
        match arms[ai].guard_expr {
          Some(ge) => {
            sig_collect_expr_deps(ge, bound, idents, ident_list, calls, call_list, ctx)
            sig_bind_cond_pat_from_expr(ge, bound, ctx, pbinds)
          }
          None => ()
        }
        let r_arm = sig_collect_and_eval_tuple_rhs(
          arms[ai].body,
          arity,
          bound,
          idents,
          ident_list,
          calls,
          call_list,
          ctx,
        )
        let mut bi = 0
        while bi < pbinds.length() {
          sig_bound_pop(bound, pbinds[bi])
          sig_local_callable_prune(bound, ctx, pbinds[bi])
          bi = bi + 1
        }
        if has_any {
          let merged : Array[SigLocalLetEval] = []
          let mut j = 0
          while j < arity {
            merged.push(sig_merge_local_let_eval(acc[j], r_arm[j]))
            j = j + 1
          }
          acc = merged
        } else {
          acc = r_arm
          has_any = true
        }
        ai = ai + 1
      }
      ctx.cond_depth = ctx.cond_depth - 1
      acc
    }
    _ => {
      sig_collect_expr_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
      let rhs_ev = sig_eval_local_let_rhs(init_e, bound, ctx)
      let evals : Array[SigLocalLetEval] = []
      let mut k = 0
      while k < arity {
        if k < rhs_ev.payload_evals.length() {
          evals.push(rhs_ev.payload_evals[k])
        } else {
          let fb = sig_unpack_fallback_eval(rhs_ev)
          let ps : Array[String] = []
          sig_union_str_array(ps, fb.param_srcs)
          sig_collect_tuple_elem_param_srcs_env(init_e, k, bound, ctx, Map([]), ps)
          evals.push(
            SigLocalLetEval::{
              targets: fb.targets,
              exact: false,
              cslots: [],
              cslot_unknown: true,
              param_srcs: ps,
              site_key: fb.site_key,
              payload_evals: [],
              field_targets: Map([]),
              field_param_srcs: Map([]),
              fields_exact: false,
            },
          )
        }
        k = k + 1
      }
      evals
    }
  }
}

///|
fn sig_collect_local_let_init_deps(
  init_e : Expr,
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  let mut cur = init_e
  let mut more = true
  while more {
    more = false
    match cur {
      EMove(x, _) | EAs(x, _, _) | ETry(x, _) => {
        cur = x
        more = true
      }
      _ => ()
    }
  }
  match cur {
    EClosure(_, _, _, _) => ()
    EDotVariant(_, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !sig_is_forwarded_param_or_alias_arg(args[i], bound, ctx) {
          sig_collect_local_let_init_deps(args[i], bound, idents, ident_list, calls, call_list, ctx)
        }
        i = i + 1
      }
    }
    ECall(callee, args, sp) =>
      if sig_is_ctor_call(callee, sp, bound, ctx) {
        if !ctx.has_tc {
          match callee {
            EIdent(cname, _) =>
              if !sig_is_bound(bound, cname) {
                let ctag = "ctor?:" + cname
                if !calls.contains(ctag) {
                  calls.set(ctag, true)
                  call_list.push(ctag)
                }
              }
            _ => ()
          }
        }
        let mut i = 0
        while i < args.length() {
          if !sig_is_forwarded_param_or_alias_arg(args[i], bound, ctx) {
            sig_collect_local_let_init_deps(args[i], bound, idents, ident_list, calls, call_list, ctx)
          }
          i = i + 1
        }
      } else {
        sig_collect_expr_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
      }
    _ =>
      if !sig_is_pure_bound_ident(init_e, bound, ctx) {
        sig_collect_expr_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
      }
  }
}

///|
fn sig_collect_stmts_deps(
  stmts : Array[Stmt],
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  sig_collect_stmts_deps_impl(stmts, bound, idents, ident_list, calls, call_list, ctx, false)
}

///|
fn sig_collect_stmts_deps_impl(
  stmts : Array[Stmt],
  bound : Map[String, Int],
  idents : Map[String, Bool],
  ident_list : Array[String],
  calls : Map[String, Bool],
  call_list : Array[String],
  ctx : SigDepCtx,
  collect_ret : Bool,
) -> Unit {
  let local_binds : Array[String] = []
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, is_mut, _, init_e, _) => {
        sig_collect_local_let_init_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
        sig_bind_local_let(name, is_mut, init_e, bound, ctx)
        local_binds.push(name)
      }
      SLetTuple(names, _, init_e, _) => {
        let evals = sig_collect_and_eval_tuple_rhs(
          init_e,
          names.length(),
          bound,
          idents,
          ident_list,
          calls,
          call_list,
          ctx,
        )
        let mut ni = 0
        while ni < names.length() {
          sig_commit_local_let(names[ni], false, evals[ni], bound, ctx)
          local_binds.push(names[ni])
          ni = ni + 1
        }
      }
      SAssign(lhs, rhs, _) => {
        sig_collect_assign_lhs_deps(lhs, bound, idents, ident_list, calls, call_list, ctx)
        let is_local_alias_assign = match lhs {
          EIdent(lname, _) =>
            sig_is_bound(bound, lname) &&
            sig_unshadowed_param_idx(bound, ctx.param_idx, ctx.param_depth, lname) < 0 &&
            sig_is_pure_bound_ident(rhs, bound, ctx)
          _ => false
        }
        if !is_local_alias_assign {
          sig_collect_expr_deps(rhs, bound, idents, ident_list, calls, call_list, ctx)
        }
        match lhs {
          EIdent(name, _) => sig_assign_local(name, rhs, bound, ctx)
          EIndex(_, _, _) =>
            sig_assign_container_elem(lhs, rhs, bound, ctx)
          EField(base, fname, lsp) => {
            sig_assign_container_elem(lhs, rhs, bound, ctx)
            let is_isolated_write = match base {
              EIdent(vname, _) => ctx.isolated_struct_locals.contains(vname)
              _ => false
            }
            if !is_isolated_write {
              let tf_key = match ctx.resolved_methods.get("fw:" + span_key(lsp)) {
                Some(sname) => sname + "." + fname
                None => fname
              }
              let wt : Array[String] = []
              let wseen : Map[String, Bool] = Map([])
              let wfwd : Array[Int] = []
              let _ = sig_extract_callable_targets(rhs, bound, ctx, wt, wseen, wfwd)
              sig_record_field_write(ctx, tf_key, wt)
              let mut wfi = 0
              while wfi < wfwd.length() {
                sig_union_str_array(
                  ctx.field_write_params,
                  [ctx.cur_fn_key + "|" + wfwd[wfi].to_string() + "|" + tf_key],
                )
                wfi = wfi + 1
              }
              let wps : Array[String] = []
              sig_collect_expr_param_srcs(rhs, bound, ctx, wps)
              let mut wpi = 0
              while wpi < wps.length() {
                sig_union_str_array(ctx.field_write_params, [wps[wpi] + "|" + tf_key])
                wpi = wpi + 1
              }
            }
          }
          _ => ()
        }
      }
      SCompoundAssign(_, lhs, rhs, _) => {
        sig_collect_expr_deps(lhs, bound, idents, ident_list, calls, call_list, ctx)
        sig_collect_expr_deps(rhs, bound, idents, ident_list, calls, call_list, ctx)
      }
      SGuard(cond, eb, _) => {
        ctx.cond_depth = ctx.cond_depth + 1
        sig_collect_stmts_deps(eb, bound, idents, ident_list, calls, call_list, ctx)
        ctx.cond_depth = ctx.cond_depth - 1
        sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
        let pbinds : Array[String] = []
        sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
        let mut bi = 0
        while bi < pbinds.length() {
          local_binds.push(pbinds[bi])
          bi = bi + 1
        }
      }
      SWhile(cond, body, _) => {
        sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
        let outer_keys = ctx.local_callables.keys()
        ctx.cond_depth = ctx.cond_depth + 1
        let mut iter = 0
        let mut fp_before = sig_outer_cslots_fp(outer_keys, bound, ctx)
        while iter < 64 {
          let pbinds : Array[String] = []
          sig_bind_cond_pat_from_expr(cond, bound, ctx, pbinds)
          sig_collect_stmts_deps(body, bound, idents, ident_list, calls, call_list, ctx)
          let mut bi = 0
          while bi < pbinds.length() {
            sig_bound_pop(bound, pbinds[bi])
            sig_local_callable_prune(bound, ctx, pbinds[bi])
            bi = bi + 1
          }
          sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
          let fp_after = sig_outer_cslots_fp(outer_keys, bound, ctx)
          if fp_after == fp_before {
            break
          }
          fp_before = fp_after
          iter = iter + 1
        }
        if iter == 64 {
          sig_fallback_dirty_outer_cslots(outer_keys, bound, ctx)
        }
        ctx.cond_depth = ctx.cond_depth - 1
      }
      SFor(init_s, cond, step_s, body, _) => {
        let init_binds : Array[String] = []
        match init_s {
          SLet(name, is_mut, _, init_e, _) => {
            let is_direct_closure = match init_e {
              EClosure(_, _, _, _) => true
              EMove(EClosure(_, _, _, _), _) => true
              _ => false
            }
            if !is_direct_closure && !sig_is_pure_bound_ident(init_e, bound, ctx) {
              sig_collect_expr_deps(init_e, bound, idents, ident_list, calls, call_list, ctx)
            }
            sig_bind_local_let(name, is_mut, init_e, bound, ctx)
            init_binds.push(name)
          }
          SLetTuple(tnames, _, init_e, _) => {
            let tevals = sig_collect_and_eval_tuple_rhs(
              init_e,
              tnames.length(),
              bound,
              idents,
              ident_list,
              calls,
              call_list,
              ctx,
            )
            let mut ni = 0
            while ni < tnames.length() {
              sig_commit_local_let(tnames[ni], false, tevals[ni], bound, ctx)
              init_binds.push(tnames[ni])
              ni = ni + 1
            }
          }
          _ => sig_collect_stmts_deps([init_s], bound, idents, ident_list, calls, call_list, ctx)
        }
        sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
        let outer_keys = ctx.local_callables.keys()
        let step_stmts : Array[Stmt] = [step_s]
        ctx.cond_depth = ctx.cond_depth + 1
        let mut iter = 0
        let mut fp_before = sig_outer_cslots_fp(outer_keys, bound, ctx)
        while iter < 64 {
          sig_collect_stmts_deps(body, bound, idents, ident_list, calls, call_list, ctx)
          sig_collect_stmts_deps(step_stmts, bound, idents, ident_list, calls, call_list, ctx)
          sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
          let fp_after = sig_outer_cslots_fp(outer_keys, bound, ctx)
          if fp_after == fp_before {
            break
          }
          fp_before = fp_after
          iter = iter + 1
        }
        if iter == 64 {
          sig_fallback_dirty_outer_cslots(outer_keys, bound, ctx)
        }
        ctx.cond_depth = ctx.cond_depth - 1
        let mut bi = 0
        while bi < init_binds.length() {
          sig_bound_pop(bound, init_binds[bi])
          sig_local_callable_prune(bound, ctx, init_binds[bi])
          bi = bi + 1
        }
      }
      SForRange(vname, s_e, e_e, _, body, _) => {
        sig_collect_expr_deps(s_e, bound, idents, ident_list, calls, call_list, ctx)
        sig_collect_expr_deps(e_e, bound, idents, ident_list, calls, call_list, ctx)
        let outer_keys = ctx.local_callables.keys()
        sig_bound_push(bound, vname)
        ctx.cond_depth = ctx.cond_depth + 1
        let mut iter = 0
        let mut fp_before = sig_outer_cslots_fp(outer_keys, bound, ctx)
        while iter < 64 {
          sig_collect_stmts_deps(body, bound, idents, ident_list, calls, call_list, ctx)
          let fp_after = sig_outer_cslots_fp(outer_keys, bound, ctx)
          if fp_after == fp_before {
            break
          }
          fp_before = fp_after
          iter = iter + 1
        }
        if iter == 64 {
          sig_fallback_dirty_outer_cslots(outer_keys, bound, ctx)
        }
        ctx.cond_depth = ctx.cond_depth - 1
        sig_bound_pop(bound, vname)
        sig_local_callable_prune(bound, ctx, vname)
      }
      SForIn(iname, vname, iter_e, body, _) => {
        sig_collect_expr_deps(iter_e, bound, idents, ident_list, calls, call_list, ctx)
        let outer_keys = ctx.local_callables.keys()
        sig_bound_push(bound, iname)
        sig_bound_push(bound, vname)
        ctx.cond_depth = ctx.cond_depth + 1
        let mut iter = 0
        let mut fp_before = sig_outer_cslots_fp(outer_keys, bound, ctx)
        while iter < 64 {
          sig_collect_stmts_deps(body, bound, idents, ident_list, calls, call_list, ctx)
          let fp_after = sig_outer_cslots_fp(outer_keys, bound, ctx)
          if fp_after == fp_before {
            break
          }
          fp_before = fp_after
          iter = iter + 1
        }
        if iter == 64 {
          sig_fallback_dirty_outer_cslots(outer_keys, bound, ctx)
        }
        ctx.cond_depth = ctx.cond_depth - 1
        sig_bound_pop(bound, vname)
        sig_local_callable_prune(bound, ctx, vname)
        sig_bound_pop(bound, iname)
        sig_local_callable_prune(bound, ctx, iname)
      }
      SReturn(opt, _) =>
        match opt {
          Some(re) => {
            sig_collect_expr_deps(re, bound, idents, ident_list, calls, call_list, ctx)
            sig_collect_ret_expr_targets(re, bound, ctx, ctx.ret_targets, ctx.ret_seen)
          }
          None => ()
        }
      SDebugAssert(cond, msg, _) => {
        sig_collect_expr_deps(cond, bound, idents, ident_list, calls, call_list, ctx)
        sig_collect_expr_deps(msg, bound, idents, ident_list, calls, call_list, ctx)
      }
      SExpr(e, _) =>
        sig_collect_expr_deps(e, bound, idents, ident_list, calls, call_list, ctx)
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  if collect_ret && stmts.length() > 0 {
    match stmts[stmts.length() - 1] {
      SExpr(te, _) => sig_collect_ret_expr_targets(te, bound, ctx, ctx.ret_targets, ctx.ret_seen)
      _ => ()
    }
  }
  let mut li = 0
  while li < local_binds.length() {
    sig_bound_pop(bound, local_binds[li])
    sig_local_callable_prune(bound, ctx, local_binds[li])
    li = li + 1
  }
}

///|
fn sig_format_dep_line(
  prefix : String,
  name : String,
  idents : Array[String],
  calls : Array[String],
) -> String {
  sig_sort_strs(idents)
  sig_sort_strs(calls)
  let sb = StringBuilder()
  sb.write_string(prefix)
  sb.write_string(name)
  sb.write_string("|")
  let mut i = 0
  while i < idents.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(idents[i])
    i = i + 1
  }
  sb.write_string("|")
  i = 0
  while i < calls.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(calls[i])
    i = i + 1
  }
  sb.write_string("\n")
  sb.to_string()
}

///|
fn sig_emit_fcallp_line(
  sb : StringBuilder,
  fn_key : String,
  pnames : Array[String],
  ctx : SigDepCtx,
) -> Unit {
  // Emit `#fcallp <fn_key>|<pnames_csv>|<direct_pidx_csv>|<fwd_csv>`
  let cp_sb = StringBuilder()
  cp_sb.write_string("#fcallp ")
  cp_sb.write_string(fn_key)
  cp_sb.write_string("|")
  let mut pi = 0
  while pi < pnames.length() {
    if pi > 0 {
      cp_sb.write_string(",")
    }
    cp_sb.write_string(pnames[pi])
    pi = pi + 1
  }
  cp_sb.write_string("|")
  let mut first_dc = true
  pi = 0
  while pi < pnames.length() {
    if ctx.direct_callp.contains(pi) {
      if !first_dc {
        cp_sb.write_string(",")
      }
      cp_sb.write_string(pi.to_string())
      first_dc = false
    }
    pi = pi + 1
  }
  cp_sb.write_string("|")
  sig_sort_strs(ctx.fwd_callp_list)
  let mut fi = 0
  while fi < ctx.fwd_callp_list.length() {
    if fi > 0 {
      cp_sb.write_string(",")
    }
    cp_sb.write_string(ctx.fwd_callp_list[fi])
    fi = fi + 1
  }
  cp_sb.write_string("\n")
  sb.write_string(cp_sb.to_string())
  // Emit `#fmutw <fn_key>|<pidx>|<t1>,<t2>,...` and `#fmutfwd <fn_key>|<pidx>|<callee>|<callee_slot>`
  pi = 0
  while pi < pnames.length() {
    match ctx.mut_param_writes.get(pi) {
      Some(wlist) =>
        if wlist.length() > 0 {
          sig_sort_strs(wlist)
          let w_sb = StringBuilder()
          w_sb.write_string("#fmutw ")
          w_sb.write_string(fn_key)
          w_sb.write_string("|")
          w_sb.write_string(pi.to_string())
          w_sb.write_string("|")
          let mut wi = 0
          while wi < wlist.length() {
            if wi > 0 {
              w_sb.write_string(",")
            }
            w_sb.write_string(wlist[wi])
            wi = wi + 1
          }
          w_sb.write_string("\n")
          sb.write_string(w_sb.to_string())
        }
      None => ()
    }
    pi = pi + 1
  }
  sig_sort_strs(ctx.mut_param_fwds)
  let mut mfi = 0
  while mfi < ctx.mut_param_fwds.length() {
    sb.write_string("#fmutfwd ")
    sb.write_string(fn_key)
    sb.write_string("|")
    sb.write_string(ctx.mut_param_fwds[mfi])
    sb.write_string("\n")
    mfi = mfi + 1
  }
  // Emit conditional closure outer-param writes `#fcbw` and forwards `#fcbfwd`
  let cb_wkeys = ctx.cb_mut_writes.keys()
  sig_sort_strs(cb_wkeys)
  let mut cwi = 0
  while cwi < cb_wkeys.length() {
    let psrc = cb_wkeys[cwi]
    match ctx.cb_mut_writes.get(psrc) {
      Some(wlist) =>
        if wlist.length() > 0 {
          sig_sort_strs(wlist)
          let w_sb = StringBuilder()
          w_sb.write_string("#fcbw ")
          w_sb.write_string(fn_key)
          w_sb.write_string("|")
          w_sb.write_string(psrc)
          w_sb.write_string("|")
          let mut wi = 0
          while wi < wlist.length() {
            if wi > 0 {
              w_sb.write_string(",")
            }
            w_sb.write_string(wlist[wi])
            wi = wi + 1
          }
          w_sb.write_string("\n")
          sb.write_string(w_sb.to_string())
        }
      None => ()
    }
    cwi = cwi + 1
  }
  sig_sort_strs(ctx.cb_mut_fwds)
  let mut cfi = 0
  while cfi < ctx.cb_mut_fwds.length() {
    sb.write_string("#fcbfwd ")
    sb.write_string(fn_key)
    sb.write_string("|")
    sb.write_string(ctx.cb_mut_fwds[cfi])
    sb.write_string("\n")
    cfi = cfi + 1
  }
  sig_sort_strs(ctx.cb_param_calls)
  let mut cpci = 0
  while cpci < ctx.cb_param_calls.length() {
    sb.write_string("#fcbcall ")
    sb.write_string(fn_key)
    sb.write_string("|")
    sb.write_string(ctx.cb_param_calls[cpci])
    sb.write_string("\n")
    cpci = cpci + 1
  }
  sig_sort_strs(ctx.cb_param_fwds)
  let mut cpfi = 0
  while cpfi < ctx.cb_param_fwds.length() {
    sb.write_string("#fcbcallfwd ")
    sb.write_string(fn_key)
    sb.write_string("|")
    sb.write_string(ctx.cb_param_fwds[cpfi])
    sb.write_string("\n")
    cpfi = cpfi + 1
  }
}

///|
fn sig_type_expr_is_callable(te : TypeExpr, _tparams : Array[String]) -> Bool {
  match te {
    TyFn(_, _, _) => true
    _ => false
  }
}

///|
fn sig_record_param_callable(
  m : Map[Int, Bool],
  pi : Int,
  param : Param,
  tparams : Array[String],
) -> Unit {
  if param.label_kind == 2 {
    m.set(pi, false)
  } else {
    match param.ty {
      TyMissing(_) => ()
      _ => m.set(pi, sig_type_expr_is_callable(param.ty, tparams))
    }
  }
}

///|
fn sig_targets_all_closures(targets : Array[String]) -> Bool {
  if targets.length() == 0 {
    return false
  }
  let mut i = 0
  while i < targets.length() {
    if !starts_with_str(targets[i], "$cb_") {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn sig_emit_fn_dep_line(
  sb : StringBuilder,
  fn_key : String,
  fd : FnDecl,
  resolved_methods : Map[String, String],
  has_tc : Bool,
) -> Unit {
  let bound : Map[String, Int] = Map([])
  let param_idx : Map[String, Int] = Map([])
  let param_callable : Map[Int, Bool] = Map([])
  let ctx = sig_dep_ctx_new(resolved_methods, has_tc, "fn_" + fn_key + "_", fn_key, param_idx)
  ctx.param_callable = param_callable
  let mut pi = 0
  while pi < fd.params.length() {
    match fd.params[pi].default_expr {
      Some(def_e) => {
        let d_idents : Map[String, Bool] = Map([])
        let d_ident_list : Array[String] = []
        let d_calls : Map[String, Bool] = Map([])
        let d_call_list : Array[String] = []
        let def_ctx = sig_dep_ctx_new(
          resolved_methods,
          has_tc,
          "fdef_" + fn_key + "_" + pi.to_string() + "_",
          "@fdef:" + fn_key + "~" + pi.to_string(),
          param_idx.copy(),
        )
        def_ctx.param_callable = param_callable.copy()
        let def_bound : Map[String, Int] = bound.copy()
        sig_collect_expr_deps(
          def_e,
          def_bound,
          d_idents,
          d_ident_list,
          d_calls,
          d_call_list,
          def_ctx,
        )
        let dt : Array[String] = []
        let dseen : Map[String, Bool] = Map([])
        let dfwd : Array[Int] = []
        let _ = sig_extract_callable_targets(def_e, def_bound, def_ctx, dt, dseen, dfwd)
        let mut dfwi = 0
        while dfwi < dfwd.length() {
          let ptok = "$p" + dfwd[dfwi].to_string()
          if !dseen.contains(ptok) {
            dseen.set(ptok, true)
            dt.push(ptok)
          }
          dfwi = dfwi + 1
        }
        let mut dei = 0
        while dei < def_ctx.extra_fdeps.length() {
          sb.write_string(def_ctx.extra_fdeps[dei])
          dei = dei + 1
        }
        sig_emit_mut_slot_fdeps(sb, def_ctx)
        sig_emit_field_summaries(sb, def_ctx)
        sb.write_string(
          sig_format_dep_line(
            "#fdef ",
            fn_key + "|" + pi.to_string() + "|" + fd.params[pi].name,
            d_ident_list,
            d_call_list,
          ),
        )
        if dt.length() > 0 {
          sb.write_string("#fdefcb " + fn_key + "|" + pi.to_string() + "|")
          let mut dti = 0
          while dti < dt.length() {
            if dti > 0 {
              sb.write_string(",")
            }
            sb.write_string(dt[dti])
            dti = dti + 1
          }
          sb.write_string("\n")
        }
        let dp_keys = def_ctx.direct_callp.keys()
        if dp_keys.length() > 0 {
          sb.write_string("#fdefpcall " + fn_key + "|" + pi.to_string() + "|")
          let mut dpi = 0
          while dpi < dp_keys.length() {
            if dpi > 0 {
              sb.write_string(",")
            }
            sb.write_string(dp_keys[dpi].to_string())
            dpi = dpi + 1
          }
          sb.write_string("\n")
        }
        if def_ctx.fwd_callp_list.length() > 0 {
          sb.write_string("#fdeffwd " + fn_key + "|" + pi.to_string() + "|")
          let mut dfi = 0
          while dfi < def_ctx.fwd_callp_list.length() {
            if dfi > 0 {
              sb.write_string(",")
            }
            sb.write_string(def_ctx.fwd_callp_list[dfi])
            dfi = dfi + 1
          }
          sb.write_string("\n")
        }
      }
      None => ()
    }
    sig_bound_push(bound, fd.params[pi].name)
    param_idx.set(fd.params[pi].name, pi)
    sig_record_param_callable(param_callable, pi, fd.params[pi], fd.type_params)
    pi = pi + 1
  }
  let idents : Map[String, Bool] = Map([])
  let ident_list : Array[String] = []
  let calls : Map[String, Bool] = Map([])
  let call_list : Array[String] = []
  ctx.isolated_struct_locals = sig_collect_isolated_struct_locals(
    fd.body,
    param_idx,
    resolved_methods,
  )
  sig_collect_stmts_deps_impl(fd.body, bound, idents, ident_list, calls, call_list, ctx, true)
  let mut ei = 0
  while ei < ctx.extra_fdeps.length() {
    sb.write_string(ctx.extra_fdeps[ei])
    ei = ei + 1
  }
  sig_emit_mut_slot_fdeps(sb, ctx)
  sig_emit_field_summaries(sb, ctx)
  if ctx.ret_targets.length() > 0 {
    sb.write_string("#fret " + fn_key + "|")
    let mut rti = 0
    while rti < ctx.ret_targets.length() {
      if rti > 0 {
        sb.write_string(",")
      }
      sb.write_string(ctx.ret_targets[rti])
      rti = rti + 1
    }
    sb.write_string("\n")
  }
  sb.write_string(sig_format_dep_line("#fdep ", fn_key, ident_list, call_list))
  let pnames : Array[String] = []
  pi = 0
  while pi < fd.params.length() {
    pnames.push(fd.params[pi].name)
    pi = pi + 1
  }
  sig_emit_fcallp_line(sb, fn_key, pnames, ctx)
}

///|
fn sig_emit_const_decl_entries(
  sb : StringBuilder,
  cd : ConstDecl,
  resolved_methods : Map[String, String],
  has_tc : Bool,
) -> Unit {
  sb.write_string(format_const_sig(cd))
  sb.write_string("\n")
  let bound : Map[String, Int] = Map([])
  let idents : Map[String, Bool] = Map([])
  let ident_list : Array[String] = []
  let calls : Map[String, Bool] = Map([])
  let call_list : Array[String] = []
  let cctx = sig_dep_ctx_new(resolved_methods, has_tc, "ci_" + cd.name + "_", "@ci:" + cd.name, Map([]))
  sig_collect_expr_deps(cd.value, bound, idents, ident_list, calls, call_list, cctx)
  let mut ei = 0
  while ei < cctx.extra_fdeps.length() {
    sb.write_string(cctx.extra_fdeps[ei])
    ei = ei + 1
  }
  sb.write_string(sig_format_dep_line("#cdep ", cd.name, ident_list, call_list))
  let mut const_rhs = cd.value
  let mut unwrap_more = true
  while unwrap_more {
    unwrap_more = false
    match const_rhs {
      EMove(x, _) | EAs(x, _, _) | ETry(x, _) => {
        const_rhs = x
        unwrap_more = true
      }
      EBlock(bstmts, _) =>
      if bstmts.length() == 1 {
        match bstmts[0] {
          SExpr(te, _) => {
            const_rhs = te
            unwrap_more = true
          }
          _ => ()
        }
      }
      _ => ()
    }
  }
  match const_rhs {
    EClosure(cparams, _, cbody, _) => {
      let cbound : Map[String, Int] = Map([])
      let cp_map : Map[String, Int] = Map([])
      let mut cpi = 0
      while cpi < cparams.length() {
        sig_bound_push(cbound, cparams[cpi].name)
        cp_map.set(cparams[cpi].name, cpi)
        cpi = cpi + 1
      }
      let c_idents : Map[String, Bool] = Map([])
      let c_ident_list : Array[String] = []
      let c_calls : Map[String, Bool] = Map([])
      let c_call_list : Array[String] = []
      let fctx = sig_dep_ctx_new(resolved_methods, has_tc, "cb_" + cd.name + "_", cd.name, cp_map)
      let mut cpi2 = 0
      while cpi2 < cparams.length() {
        sig_record_param_callable(fctx.param_callable, cpi2, cparams[cpi2], [])
        cpi2 = cpi2 + 1
      }
      fctx.isolated_struct_locals = sig_collect_isolated_struct_locals(
        cbody,
        cp_map,
        resolved_methods,
      )
      sig_collect_stmts_deps_impl(
        cbody,
        cbound,
        c_idents,
        c_ident_list,
        c_calls,
        c_call_list,
        fctx,
        true,
      )
      let mut fei = 0
      while fei < fctx.extra_fdeps.length() {
        sb.write_string(fctx.extra_fdeps[fei])
        fei = fei + 1
      }
      sig_emit_mut_slot_fdeps(sb, fctx)
      sig_emit_field_summaries(sb, fctx)
      if fctx.ret_targets.length() > 0 {
        sb.write_string("#fret " + cd.name + "|")
        let mut rti = 0
        while rti < fctx.ret_targets.length() {
          if rti > 0 {
            sb.write_string(",")
          }
          sb.write_string(fctx.ret_targets[rti])
          rti = rti + 1
        }
        sb.write_string("\n")
      }
      let cpnames : Array[String] = []
      cpi = 0
      while cpi < cparams.length() {
        cpnames.push(cparams[cpi].name)
        cpi = cpi + 1
      }
      sb.write_string(sig_format_dep_line("#fdep ", cd.name, c_ident_list, c_call_list))
      sig_emit_fcallp_line(sb, cd.name, cpnames, fctx)
    }
    EIdent(target, _) => {
      sb.write_string(sig_format_dep_line("#fdep ", cd.name, [], [target]))
      sb.write_string("#falias " + cd.name + "|" + target + "\n")
      sb.write_string("#cfalias " + cd.name + "|" + target + "\n")
    }
    EPath(qual, mem, _) => {
      sb.write_string(sig_format_dep_line("#fdep ", cd.name, [], [qual + "::" + mem]))
      sb.write_string("#falias " + cd.name + "|" + qual + "::" + mem + "\n")
    }
    EStructLit(sname, spread_opt, sfields, sp) => {
      let st_name = match resolved_methods.get("st:" + span_key(sp)) {
        Some(rn) => rn
        None => sname
      }
      let empty_bound : Map[String, Int] = Map([])
      let explicit_names : Array[String] = []
      let mut si = 0
      while si < sfields.length() {
        explicit_names.push(sfields[si].name)
        let ft : Array[String] = []
        let fseen : Map[String, Bool] = Map([])
        let ffwd : Array[Int] = []
        let f_exact = sig_extract_callable_targets(
          sfields[si].value,
          empty_bound,
          cctx,
          ft,
          fseen,
          ffwd,
        )
        sig_record_field_put(cctx, st_name + "." + sfields[si].name, ft)
        if !f_exact {
          sig_add_unique_str(ft, fseen, "?")
        }
        sb.write_string("#cfdef " + cd.name + "." + sfields[si].name + "|")
        let mut fti = 0
        while fti < ft.length() {
          if fti > 0 {
            sb.write_string(",")
          }
          sb.write_string(ft[fti])
          fti = fti + 1
        }
        sb.write_string("\n")
        si = si + 1
      }
      match spread_opt {
        Some(se) => {
          let se_u = match se {
            EMove(x, _) | EAs(x, _, _) | ETry(x, _) => x
            x => x
          }
          match se_u {
            EIdent(base_name, _) => {
              sb.write_string("#cfspread " + cd.name + "|" + base_name + "|")
              let mut xi = 0
              while xi < explicit_names.length() {
                if xi > 0 {
                  sb.write_string(",")
                }
                sb.write_string(explicit_names[xi])
                xi = xi + 1
              }
              sb.write_string("\n")
              sb.write_string("#cfdef " + cd.name + ".*|\n")
            }
            _ => sb.write_string("#cfdef " + cd.name + ".*|$fp\n")
          }
        }
        None => sb.write_string("#cfdef " + cd.name + ".*|\n")
      }
    }
    _ => {
      let empty_bound : Map[String, Int] = Map([])
      let ct : Array[String] = []
      let cseen : Map[String, Bool] = Map([])
      let cfwd : Array[Int] = []
      let _ = sig_extract_callable_targets(const_rhs, empty_bound, cctx, ct, cseen, cfwd)
      if ct.length() > 0 {
        sb.write_string(sig_format_dep_line("#fdep ", cd.name, [], ct))
        if ct.length() == 1 {
          sb.write_string("#falias " + cd.name + "|" + ct[0] + "\n")
        }
      }
    }
  }
  while ei < cctx.extra_fdeps.length() {
    sb.write_string(cctx.extra_fdeps[ei])
    ei = ei + 1
  }
  sig_emit_mut_slot_fdeps(sb, cctx)
  sig_emit_field_summaries(sb, cctx)
}

fn emit_file_sig_entries_impl(
  f : SourceFile,
  resolved_methods : Map[String, String],
  has_tc : Bool,
) -> String {
  let sb = StringBuilder()
  let mut di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DStruct(sd) => {
        sb.write_string(format_struct_sig(sd))
        sb.write_string("\n")
      }
      DEnum(ed) => {
        sb.write_string(format_enum_sig(ed))
        sb.write_string("\n")
      }
      DFn(fd) => {
        sb.write_string(format_fn_sig(fd))
        sb.write_string("\n")
        let fkey = if fd.receiver_type.length() > 0 {
          fd.receiver_type + "::" + fd.name
        } else {
          fd.name
        }
        sig_emit_fn_dep_line(sb, fkey, fd, resolved_methods, has_tc)
      }
      DExternFn(ed) => {
        sb.write_string(format_extern_fn_sig(ed))
        sb.write_string("\n")
      }
      DTrait(td) => {
        sb.write_string(format_trait_sig(td))
        sb.write_string("\n")
      }
      DImpl(id) => {
        sb.write_string(format_impl_sig(id))
        sb.write_string("\n")
        let mut mi = 0
        while mi < id.methods.length() {
          let md = id.methods[mi]
          sig_emit_fn_dep_line(sb, id.target_type + "::" + md.name, md, resolved_methods, has_tc)
          mi = mi + 1
        }
      }
      DConst(cd) => sig_emit_const_decl_entries(sb, cd, resolved_methods, has_tc)
      DTest(_) => ()
    }
    di = di + 1
  }
  sb.to_string()
}

///|
/// Emit canonical per-file declaration signatures (one per line, no header)
/// with optional type-resolved instance method call targets (`span_key -> "Type::method"`).
pub fn emit_file_sig_entries_resolved(
  f : SourceFile,
  resolved_methods : Map[String, String],
) -> String {
  emit_file_sig_entries_impl(f, resolved_methods, true)
}

///|
/// Emit canonical per-file declaration signatures (one per line, no header)
/// for incremental unit-level CAS hashing without re-parsing unchanged files.
pub fn emit_file_sig_entries(f : SourceFile) -> String {
  emit_file_sig_entries_impl(f, Map([]), false)
}

///|
pub fn xpkg_is_const_scalar_expr(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _) => true
    EUnary(op, inner, _) =>
      (op == "-" || op == "~" || op == "!") && xpkg_is_const_scalar_expr(inner)
    EBinary(op, l, r, _) =>
      (op == "+" || op == "-" || op == "*") &&
      xpkg_is_const_scalar_expr(l) &&
      xpkg_is_const_scalar_expr(r)
    _ => false
  }
}

///|
/// Public symbol summary for cross-package small-function inlining soundness.
/// Shared by `.pionstub` emission (`sig.pion`) and QBE cross-package inlining (`qbe.pion`).
pub struct XpkgPubSyms {
  pub_structs : Map[String, Bool]
  pub_enums : Map[String, Bool]
  pub_variants : Map[String, Bool]
  pub_qual_variants : Map[String, Bool]
  pub_fns : Map[String, Bool]
  pub_methods : Map[String, Bool]
  priv_methods : Map[String, Bool]
  scalar_consts : Map[String, Bool]
  pub_consts : Map[String, Bool]
  priv_nonscalar_consts : Map[String, Bool]
  inline_priv_fns : Map[String, Bool]
  has_pub_opt_res : Bool
}

///|
struct XpkgSymView {
  pkg_syms : Option[XpkgPubSyms]
  tc : Option[TypeChecker]
}

///|
pub fn xpkg_pub_syms_from_pkg(pkg : Package) -> XpkgPubSyms {
  let pub_structs : Map[String, Bool] = Map([])
  let pub_enums : Map[String, Bool] = Map([])
  let pub_variants : Map[String, Bool] = Map([])
  let pub_qual_variants : Map[String, Bool] = Map([])
  let pub_fns : Map[String, Bool] = Map([])
  let pub_methods : Map[String, Bool] = Map([])
  let priv_methods : Map[String, Bool] = Map([])
  let scalar_consts : Map[String, Bool] = Map([])
  let pub_consts : Map[String, Bool] = Map([])
  let priv_nonscalar_consts : Map[String, Bool] = Map([])
  let inline_priv_fns : Map[String, Bool] = Map([])
  let mut has_pub_opt_res = false
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          if sd.is_pub {
            pub_structs.set(sd.name, true)
          }
        DEnum(ed) =>
          if ed.is_pub {
            pub_enums.set(ed.name, true)
            let mut vi = 0
            while vi < ed.variants.length() {
              let vname = ed.variants[vi].name
              pub_variants.set(vname, true)
              pub_qual_variants.set(ed.name + "::" + vname, true)
              vi = vi + 1
            }
          }
        DFn(fd) => {
          if fd.is_pub && fd.type_params.length() == 0 {
            match fd.ret_ty {
              TyName("Option", _, _) | TyName("Result", _, _) =>
                has_pub_opt_res = true
              _ => ()
            }
          }
          if fd.receiver_type != "" {
            let mkey = fd.receiver_type + "::" + fd.name
            if fd.is_pub && fd.type_params.length() == 0 {
              pub_methods.set(mkey, true)
            } else {
              priv_methods.set(fd.name, true)
            }
          } else if fd.is_pub && fd.type_params.length() == 0 {
            pub_fns.set(fd.name, true)
          }
        }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            priv_methods.set(id.methods[mi].name, true)
            mi = mi + 1
          }
        }
        DConst(cd) =>
          if cd.is_pub {
            pub_consts.set(cd.name, true)
          } else if xpkg_is_const_scalar_expr(cd.value) {
            scalar_consts.set(cd.name, true)
          } else {
            priv_nonscalar_consts.set(cd.name, true)
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  let syms = XpkgPubSyms::{
    pub_structs: pub_structs,
    pub_enums: pub_enums,
    pub_variants: pub_variants,
    pub_qual_variants: pub_qual_variants,
    pub_fns: pub_fns,
    pub_methods: pub_methods,
    priv_methods: priv_methods,
    scalar_consts: scalar_consts,
    pub_consts: pub_consts,
    priv_nonscalar_consts: priv_nonscalar_consts,
    inline_priv_fns: inline_priv_fns,
    has_pub_opt_res: has_pub_opt_res,
  }
  let view = XpkgSymView::{ pkg_syms: Some(syms), tc: None }
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) =>
          if !fd.is_pub &&
            fd.receiver_type == "" &&
            xpkg_fn_is_inlinable_priv_leaf_view(view, fd) {
            syms.inline_priv_fns.set(fd.name, true)
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  syms
}

///|
fn xpkg_sym_is_pub_struct(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_structs.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.structs.get(name) {
            Some(si) => si.decl.is_pub
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_is_pub_fn(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_fns.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.fns.get(name) {
            Some(fi) => fi.decl.is_pub && fi.decl.type_params.length() == 0
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_is_pub_method(view : XpkgSymView, qual_method : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_methods.contains(qual_method)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.methods.get(qual_method) {
            Some(mi) => mi.decl.is_pub && mi.decl.type_params.length() == 0
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_is_pub_variant(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_variants.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.variant_to_enum.get(name) {
            Some(ename) =>
              match tc.enums.get(ename) {
                Some(ei) => ei.decl.is_pub
                None => false
              }
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_is_pub_qual_variant(view : XpkgSymView, q : String, m : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_qual_variants.contains(q + "::" + m)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.enums.get(q) {
            Some(ei) =>
              if ei.decl.is_pub {
                let mut vi = 0
                while vi < ei.decl.variants.length() {
                  if ei.decl.variants[vi].name == m {
                    return true
                  }
                  vi = vi + 1
                }
                false
              } else {
                false
              }
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_has_priv_method(view : XpkgSymView, mname : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.priv_methods.contains(mname)
    None =>
      match view.tc {
        Some(tc) => {
          let mut i = 0
          while i < tc.method_names.length() {
            match tc.methods.get(tc.method_names[i]) {
              Some(mi) =>
                if mi.decl.name == mname &&
                  (!mi.decl.is_pub || mi.decl.type_params.length() > 0) {
                  return true
                }
              None => ()
            }
            i = i + 1
          }
          let mut ii = 0
          while ii < tc.impl_keys.length() {
            match tc.impls.get(tc.impl_keys[ii]) {
              Some(imp) => {
                let mut mi = 0
                while mi < imp.decl.methods.length() {
                  if imp.decl.methods[mi].name == mname {
                    return true
                  }
                  mi = mi + 1
                }
              }
              None => ()
            }
            ii = ii + 1
          }
          false
        }
        None => true
      }
  }
}

///|
fn xpkg_ty_has_qual(t : TypeExpr) -> Bool {
  match t {
    TyName(name, args, _) => {
      if has_qual_sep(name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if xpkg_ty_has_qual(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      let mut i = 0
      while i < ps.length() {
        if xpkg_ty_has_qual(ps[i]) {
          return true
        }
        i = i + 1
      }
      xpkg_ty_has_qual(r)
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if xpkg_ty_has_qual(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyDynTrait(name, _) => has_qual_sep(name)
    TyMissing(_) => false
  }
}

///|
fn xpkg_is_builtin_fn(name : String) -> Bool {
  name == "Some" ||
  name == "Ok" ||
  name == "Err" ||
  name == "abs" ||
  name == "min" ||
  name == "max"
}

///|
fn xpkg_is_builtin_type_qual(q : String) -> Bool {
  q == "Option" ||
  q == "Result" ||
  q == "Array" ||
  q == "FixedArray" ||
  q == "ImmArray" ||
  q == "Bytes" ||
  q == "StringBuilder" ||
  q == "Map" ||
  q == "Int" ||
  q == "Int64" ||
  q == "Double" ||
  q == "Float" ||
  q == "Byte" ||
  q == "Char" ||
  q == "UInt" ||
  q == "UInt64" ||
  q == "String" ||
  q == "Bool"
}

///|
fn xpkg_locals_pop_to(locals : Array[String], n : Int) -> Unit {
  while locals.length() > n {
    let _ = locals.pop()
  }
}

///|
fn xpkg_sym_is_scalar_const(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.scalar_consts.contains(name)
    None =>
      match view.tc {
        Some(tc) => tc.scalar_const_exprs.contains(name)
        None => false
      }
  }
}

///|
fn xpkg_sym_is_pub_const(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.pub_consts.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.const_pub.get(name) {
            Some(true) => true
            _ => false
          }
        None => false
      }
  }
}

///|
fn xpkg_sym_is_priv_nonscalar_const(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.priv_nonscalar_consts.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          tc.consts.contains(name) &&
          !xpkg_sym_is_pub_const(view, name) &&
          !tc.scalar_const_exprs.contains(name)
        None => false
      }
  }
}

///|
fn xpkg_sym_is_inline_priv_fn(view : XpkgSymView, name : String) -> Bool {
  match view.pkg_syms {
    Some(s) => s.inline_priv_fns.contains(name)
    None =>
      match view.tc {
        Some(tc) =>
          match tc.fns.get(name) {
            Some(fi) => xpkg_fn_is_inlinable_priv_leaf_tc(tc, fi.decl)
            None => false
          }
        None => false
      }
  }
}

///|
fn xpkg_pat_link_safe(
  view : XpkgSymView,
  pat : Pattern,
  bound_out : Array[String],
) -> Bool {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => true
    PIdent(name, _) => {
      if name != "_" {
        bound_out.push(name)
      }
      true
    }
    PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if !xpkg_pat_link_safe(view, subs[i], bound_out) {
          return false
        }
        i = i + 1
      }
      true
    }
    PVariant(en, vn, subs, explicit_ctor, _) => {
      if en == "" &&
        !explicit_ctor &&
        subs.length() == 0 &&
        xpkg_sym_is_priv_nonscalar_const(view, vn) {
        return false
      }
      let en_ok = en == "Option" ||
        en == "Result" ||
        (en == "" &&
        (vn == "Some" ||
        vn == "None" ||
        vn == "Ok" ||
        vn == "Err" ||
        xpkg_sym_is_pub_variant(view, vn) ||
        (!explicit_ctor && subs.length() == 0 && (xpkg_sym_is_scalar_const(view, vn) || xpkg_sym_is_pub_const(view, vn))))) ||
        (en != "" && xpkg_sym_is_pub_qual_variant(view, en, vn))
      if !en_ok {
        return false
      }
      let mut i = 0
      while i < subs.length() {
        if !xpkg_pat_link_safe(view, subs[i], bound_out) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

///|
fn xpkg_expr_link_safe_ex(
  view : XpkgSymView,
  e : Expr,
  locals : Array[String],
  allow_priv_fns : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EUnit(_) => true
    EIdent(name, _) =>
      str_arr_contains(locals, name) ||
      name == "None" ||
      xpkg_sym_is_pub_variant(view, name) ||
      xpkg_sym_is_scalar_const(view, name)
    EPath(q, m, _) => xpkg_sym_is_pub_qual_variant(view, q, m)
    EUnary(_, inner, _) | ETry(inner, _) =>
      xpkg_expr_link_safe_ex(view, inner, locals, allow_priv_fns)
    EBinary(_, lhs, rhs, _) =>
      xpkg_expr_link_safe_ex(view, lhs, locals, allow_priv_fns) &&
      xpkg_expr_link_safe_ex(view, rhs, locals, allow_priv_fns)
    EAs(inner, ty, _) =>
      !xpkg_ty_has_qual(ty) &&
      xpkg_expr_link_safe_ex(view, inner, locals, allow_priv_fns)
    EField(obj, _, _) =>
      xpkg_expr_link_safe_ex(view, obj, locals, allow_priv_fns)
    EIndex(obj, idx, _) =>
      xpkg_expr_link_safe_ex(view, obj, locals, allow_priv_fns) &&
      xpkg_expr_link_safe_ex(view, idx, locals, allow_priv_fns)
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !xpkg_expr_link_safe_ex(view, elems[i], locals, allow_priv_fns) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(sname, spread_opt, fields, _) => {
      match spread_opt {
        Some(_) => return false
        None => ()
      }
      if has_qual_sep(sname) || !xpkg_sym_is_pub_struct(view, sname) {
        return false
      }
      let mut i = 0
      while i < fields.length() {
        if !xpkg_expr_link_safe_ex(view, fields[i].value, locals, allow_priv_fns) {
          return false
        }
        i = i + 1
      }
      true
    }
    ECall(callee, args, _) => {
      let callee_ok = match callee {
        EIdent(cn, _) =>
          xpkg_is_builtin_fn(cn) ||
          xpkg_sym_is_pub_fn(view, cn) ||
          xpkg_sym_is_pub_variant(view, cn) ||
          (allow_priv_fns && xpkg_sym_is_inline_priv_fn(view, cn))
        EPath(q, m, _) =>
          xpkg_is_builtin_type_qual(q) ||
          xpkg_sym_is_pub_method(view, q + "::" + m) ||
          xpkg_sym_is_pub_qual_variant(view, q, m)
        _ => false
      }
      if !callee_ok {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !xpkg_expr_link_safe_ex(view, args[i], locals, allow_priv_fns) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(recv, mname, args, _) => {
      if xpkg_sym_has_priv_method(view, mname) {
        return false
      }
      if !xpkg_expr_link_safe_ex(view, recv, locals, allow_priv_fns) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !xpkg_expr_link_safe_ex(view, args[i], locals, allow_priv_fns) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => {
      let saved = locals.length()
      let ok = xpkg_stmts_link_safe_ex(view, stmts, locals, allow_priv_fns)
      xpkg_locals_pop_to(locals, saved)
      ok
    }
    EIf(cond, then_stmts, else_opt, _) => {
      if !xpkg_expr_link_safe_ex(view, cond, locals, allow_priv_fns) {
        return false
      }
      let saved = locals.length()
      let then_ok = xpkg_stmts_link_safe_ex(view, then_stmts, locals, allow_priv_fns)
      xpkg_locals_pop_to(locals, saved)
      if !then_ok {
        return false
      }
      match else_opt {
        None => true
        Some(el) => xpkg_expr_link_safe_ex(view, el, locals, allow_priv_fns)
      }
    }
    EMatch(scrut, arms, _) => {
      if arms.length() > 6 ||
        !xpkg_expr_link_safe_ex(view, scrut, locals, allow_priv_fns) {
        return false
      }
      let mut ai = 0
      while ai < arms.length() {
        let arm = arms[ai]
        let saved = locals.length()
        let bound : Array[String] = []
        if !xpkg_pat_link_safe(view, arm.pat, bound) {
          return false
        }
        let mut bi = 0
        while bi < bound.length() {
          locals.push(bound[bi])
          bi = bi + 1
        }
        let guard_ok = match arm.guard_expr {
          None => true
          Some(ge) => xpkg_expr_link_safe_ex(view, ge, locals, allow_priv_fns)
        }
        let body_ok = guard_ok &&
          xpkg_expr_link_safe_ex(view, arm.body, locals, allow_priv_fns)
        xpkg_locals_pop_to(locals, saved)
        if !body_ok {
          return false
        }
        ai = ai + 1
      }
      true
    }
    ENamedArg(_, _, inner, _) =>
      xpkg_expr_link_safe_ex(view, inner, locals, allow_priv_fns)
    _ => false
  }
}

///|
fn xpkg_stmts_link_safe_ex(
  view : XpkgSymView,
  stmts : Array[Stmt],
  locals : Array[String],
  allow_priv_fns : Bool,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, _, ty, init, _) => {
        if xpkg_ty_has_qual(ty) ||
          !xpkg_expr_link_safe_ex(view, init, locals, allow_priv_fns) {
          return false
        }
        locals.push(name)
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if !xpkg_expr_link_safe_ex(view, lhs, locals, allow_priv_fns) ||
          !xpkg_expr_link_safe_ex(view, rhs, locals, allow_priv_fns) {
          return false
        }
      SExpr(e, _) =>
        if !xpkg_expr_link_safe_ex(view, e, locals, allow_priv_fns) {
          return false
        }
      SGuard(cond, body, _) => {
        if !xpkg_expr_link_safe_ex(view, cond, locals, allow_priv_fns) {
          return false
        }
        let saved = locals.length()
        let ok = xpkg_stmts_link_safe_ex(view, body, locals, allow_priv_fns)
        xpkg_locals_pop_to(locals, saved)
        if !ok {
          return false
        }
      }
      SReturn(opt, _) =>
        match opt {
          None => ()
          Some(e) =>
            if !xpkg_expr_link_safe_ex(view, e, locals, allow_priv_fns) {
              return false
            }
        }
      SWhile(wcond, wbody, _) =>
        if allow_priv_fns {
          if !xpkg_expr_link_safe_ex(view, wcond, locals, allow_priv_fns) {
            return false
          }
          let saved = locals.length()
          let ok = xpkg_stmts_link_safe_ex(view, wbody, locals, allow_priv_fns)
          xpkg_locals_pop_to(locals, saved)
          if !ok {
            return false
          }
        } else {
          return false
        }
      SBreak(_) | SContinue(_) =>
        if !allow_priv_fns {
          return false
        }
      _ => return false
    }
    i = i + 1
  }
  true
}

///|
fn xpkg_fn_is_inlinable_priv_leaf_view(view : XpkgSymView, fd : FnDecl) -> Bool {
  if fd.is_pub ||
    fd.receiver_type != "" ||
    fd.type_params.length() != 0 ||
    params_have_mut(fd.params) ||
    fd.body.length() == 0 {
    return false
  }
  let is_opt_res = match fd.ret_ty {
    TyName("Option", _, _) | TyName("Result", _, _) => true
    _ => false
  }
  let is_prim_scalar = match fd.ret_ty {
    TyName("Int", args, _)
    | TyName("Int64", args, _)
    | TyName("UInt", args, _)
    | TyName("UInt64", args, _)
    | TyName("Double", args, _)
    | TyName("Float", args, _)
    | TyName("Bool", args, _)
    | TyName("Byte", args, _) => args.length() == 0
    _ => false
  }
  if (!is_opt_res && !is_prim_scalar) || xpkg_ty_has_qual(fd.ret_ty) {
    return false
  }
  if !is_opt_res {
    match view.pkg_syms {
      Some(syms) =>
        if !syms.has_pub_opt_res {
          return false
        }
      None => ()
    }
  }
  let locals : Array[String] = []
  let mut pi = 0
  while pi < fd.params.length() {
    if xpkg_ty_has_qual(fd.params[pi].ty) {
      return false
    }
    locals.push(fd.params[pi].name)
    pi = pi + 1
  }
  let max_cost = if is_opt_res { 80 } else { 36 }
  let cost = qbe_stmts_inline_cost_in(fd.body, fd.name, false, 0)
  if cost < 0 || cost > max_cost {
    return false
  }
  xpkg_stmts_link_safe_ex(view, fd.body, locals, false)
}

///|
pub fn xpkg_fn_is_inlinable_priv_leaf(syms : XpkgPubSyms, fd : FnDecl) -> Bool {
  xpkg_fn_is_inlinable_priv_leaf_view(
    XpkgSymView::{ pkg_syms: Some(syms), tc: None },
    fd,
  )
}

///|
pub fn xpkg_fn_is_inlinable_priv_leaf_tc(tc : TypeChecker, fd : FnDecl) -> Bool {
  xpkg_fn_is_inlinable_priv_leaf_view(
    XpkgSymView::{ pkg_syms: None, tc: Some(tc) },
    fd,
  )
}

///|
fn xpkg_fn_is_inlinable_view(view : XpkgSymView, fd : FnDecl) -> Bool {
  if !fd.is_pub ||
    fd.type_params.length() != 0 ||
    params_have_mut(fd.params) ||
    fd.body.length() == 0 {
    return false
  }
  if xpkg_ty_has_qual(fd.ret_ty) {
    return false
  }
  let locals : Array[String] = []
  let mut pi = 0
  while pi < fd.params.length() {
    if xpkg_ty_has_qual(fd.params[pi].ty) {
      return false
    }
    locals.push(fd.params[pi].name)
    pi = pi + 1
  }
  let self_key = if fd.receiver_type != "" {
    fd.receiver_type + "::" + fd.name
  } else {
    fd.name
  }
  let is_opt_res = match fd.ret_ty {
    TyName("Option", _, _) | TyName("Result", _, _) => true
    _ => false
  }
  let is_pub_struct_ret = if !is_opt_res {
    match fd.ret_ty {
      TyName(rname, rargs, _) =>
        rargs.length() == 0 && xpkg_sym_is_pub_struct(view, rname)
      _ => false
    }
  } else {
    false
  }
  let allow_pod_struct = if is_pub_struct_ret {
    match view.pkg_syms {
      Some(syms) => syms.has_pub_opt_res
      None => true
    }
  } else {
    false
  }
  let max_cost = if is_opt_res {
    180
  } else if allow_pod_struct {
    40
  } else {
    22
  }
  let allow_loops = if is_opt_res { 1 } else { 0 }
  let cost = qbe_stmts_inline_cost_in(fd.body, self_key, false, allow_loops)
  if cost < 0 || cost > max_cost {
    return false
  }
  xpkg_stmts_link_safe_ex(view, fd.body, locals, is_opt_res)
}

///|
pub fn xpkg_fn_is_inlinable(syms : XpkgPubSyms, fd : FnDecl) -> Bool {
  xpkg_fn_is_inlinable_view(
    XpkgSymView::{ pkg_syms: Some(syms), tc: None },
    fd,
  )
}

///|
pub fn xpkg_fn_is_inlinable_tc(tc : TypeChecker, fd : FnDecl) -> Bool {
  xpkg_fn_is_inlinable_view(
    XpkgSymView::{ pkg_syms: None, tc: Some(tc) },
    fd,
  )
}

///|
/// Lexer preserves escape sequences verbatim inside `CharLit` / `ByteLit`
/// payloads (`'\n'` -> `"\\n"`, `b'\x1b'` -> `"\\x1b"`, `'\''` -> `"\\'"`),
/// so emit the payload verbatim without double-escaping.
fn stub_write_char_lit(sb : StringBuilder, prefix : String, s : String) -> Unit {
  sb.write_string(prefix)
  sb.write_string(s)
  sb.write_string("'")
}

///|
/// Escape a decoded string payload using Pion's own string escape syntax
/// (`\n`, `\r`, `\t`, `\\`, `\"`, `\0`, and `\u{XX}` for other control bytes),
/// avoiding JSON `\u00XX` escapes that Pion's lexer rejects.
fn stub_write_str_escaped(sb : StringBuilder, s : String) -> Unit {
  let mut i = 0
  while i < s.length() {
    let ch = str_code_at(s, i)
    if ch == 92 {
      sb.write_string("\\\\")
    } else if ch == 34 {
      sb.write_string("\\\"")
    } else if ch == 10 {
      sb.write_string("\\n")
    } else if ch == 13 {
      sb.write_string("\\r")
    } else if ch == 9 {
      sb.write_string("\\t")
    } else if ch == 0 {
      sb.write_string("\\0")
    } else if ch < 32 || ch == 127 {
      sb.write_string("\\u{")
      sb.write_char(hex_digit((ch >> 4) & 15))
      sb.write_char(hex_digit(ch & 15))
      sb.write_string("}")
    } else {
      sb.write_string(slice_str(s, i, i + 1))
    }
    i = i + 1
  }
}

///|
fn stub_write_str_lit(sb : StringBuilder, s : String) -> Unit {
  sb.write_string("\"")
  stub_write_str_escaped(sb, s)
  sb.write_string("\"")
}

///|
fn stub_write_pat(sb : StringBuilder, pat : Pattern) -> Unit {
  match pat {
    PWild(_) => sb.write_string("_")
    PIdent(name, _) => sb.write_string(name)
    PBool(b, _) => sb.write_string(if b { "true" } else { "false" })
    PInt(s, _) => sb.write_string(s)
    PString(s, _) => stub_write_str_lit(sb, s)
    PChar(s, _) => stub_write_char_lit(sb, "'", s)
    PTuple(subs, _) => {
      sb.write_string("(")
      let mut i = 0
      while i < subs.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        stub_write_pat(sb, subs[i])
        i = i + 1
      }
      sb.write_string(")")
    }
    PVariant(en, vn, subs, explicit_ctor, _) => {
      if en != "" {
        sb.write_string(en)
        sb.write_string("::")
      }
      sb.write_string(vn)
      if subs.length() > 0 {
        sb.write_string("(")
        let mut i = 0
        while i < subs.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          stub_write_pat(sb, subs[i])
          i = i + 1
        }
        sb.write_string(")")
      } else if explicit_ctor {
        sb.write_string("()")
      }
    }
  }
}

///|
fn stub_write_expr(sb : StringBuilder, e : Expr) -> Unit {
  match e {
    EInt(s, _) => sb.write_string(s)
    EInt64(s, _) => {
      sb.write_string(s)
      if !s.ends_with("L") {
        sb.write_string("L")
      }
    }
    EUInt(s, _) => {
      sb.write_string(s)
      if !s.ends_with("U") {
        sb.write_string("U")
      }
    }
    EUInt64(s, _) => {
      sb.write_string(s)
      if !s.ends_with("UL") {
        sb.write_string("UL")
      }
    }
    EDouble(s, _) => sb.write_string(s)
    EFloat(s, _) => {
      sb.write_string(s)
      if !s.ends_with("f") {
        sb.write_string("f")
      }
    }
    EBool(b, _) => sb.write_string(if b { "true" } else { "false" })
    EByte(s, _) => stub_write_char_lit(sb, "b'", s)
    EChar(s, _) => stub_write_char_lit(sb, "'", s)
    EString(s, _) => stub_write_str_lit(sb, s)
    EUnit(_) => sb.write_string("()")
    EIdent(name, _) => sb.write_string(name)
    EPath(q, m, _) => {
      sb.write_string(q)
      sb.write_string("::")
      sb.write_string(m)
    }
    EDotVariant(vname, args, _) => {
      sb.write_string(".")
      sb.write_string(vname)
      if args.length() > 0 {
        sb.write_string("(")
        let mut i = 0
        while i < args.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          stub_write_expr(sb, args[i])
          i = i + 1
        }
        sb.write_string(")")
      }
    }
    EUnary(op, inner, _) => {
      sb.write_string("(")
      sb.write_string(op)
      stub_write_expr(sb, inner)
      sb.write_string(")")
    }
    EBinary(op, lhs, rhs, _) => {
      sb.write_string("(")
      stub_write_expr(sb, lhs)
      sb.write_string(" ")
      sb.write_string(op)
      sb.write_string(" ")
      stub_write_expr(sb, rhs)
      sb.write_string(")")
    }
    EAs(inner, ty, _) => {
      sb.write_string("(")
      stub_write_expr(sb, inner)
      sb.write_string(" as ")
      sb.write_string(type_expr_to_string(ty))
      sb.write_string(")")
    }
    EField(obj, fld, _) => {
      stub_write_expr(sb, obj)
      sb.write_string(".")
      sb.write_string(fld)
    }
    EIndex(obj, idx, _) => {
      stub_write_expr(sb, obj)
      sb.write_string("[")
      stub_write_expr(sb, idx)
      sb.write_string("]")
    }
    EArrayLit(elems, _) => {
      sb.write_string("[")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        stub_write_expr(sb, elems[i])
        i = i + 1
      }
      sb.write_string("]")
    }
    ETuple(elems, _) => {
      sb.write_string("(")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        stub_write_expr(sb, elems[i])
        i = i + 1
      }
      sb.write_string(")")
    }
    EStructLit(sname, spread_opt, fields, _) => {
      sb.write_string(sname)
      sb.write_string("::{ ")
      let mut need_comma = false
      match spread_opt {
        Some(base) => {
          sb.write_string("..")
          stub_write_expr(sb, base)
          need_comma = true
        }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if need_comma {
          sb.write_string(", ")
        }
        need_comma = true
        sb.write_string(fields[i].name)
        sb.write_string(": ")
        stub_write_expr(sb, fields[i].value)
        i = i + 1
      }
      sb.write_string(" }")
    }
    ECall(callee, args, _) => {
      let need_paren = match callee {
        EIdent(_, _) | EPath(_, _, _) => false
        _ => true
      }
      if need_paren {
        sb.write_string("(")
        stub_write_expr(sb, callee)
        sb.write_string(")")
      } else {
        stub_write_expr(sb, callee)
      }
      sb.write_string("(")
      let mut i = 0
      while i < args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        stub_write_expr(sb, args[i])
        i = i + 1
      }
      sb.write_string(")")
    }
    EMethodCall(recv, mname, args, _) => {
      stub_write_expr(sb, recv)
      sb.write_string(".")
      sb.write_string(mname)
      sb.write_string("(")
      let mut i = 0
      while i < args.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        stub_write_expr(sb, args[i])
        i = i + 1
      }
      sb.write_string(")")
    }
    EBlock(stmts, _) => {
      sb.write_string("{\n")
      stub_write_stmts(sb, stmts)
      sb.write_string("}")
    }
    EIf(cond, then_stmts, else_opt, _) => {
      sb.write_string("if ")
      stub_write_expr(sb, cond)
      sb.write_string(" {\n")
      stub_write_stmts(sb, then_stmts)
      sb.write_string("}")
      match else_opt {
        None => ()
        Some(el) => {
          sb.write_string(" else ")
          stub_write_expr(sb, el)
        }
      }
    }
    ETry(inner, _) => {
      sb.write_string("(")
      stub_write_expr(sb, inner)
      sb.write_string(")?")
    }
    EMatch(scrut, arms, _) => {
      sb.write_string("match ")
      stub_write_expr(sb, scrut)
      sb.write_string(" {\n")
      let mut i = 0
      while i < arms.length() {
        let arm = arms[i]
        sb.write_string("  ")
        stub_write_pat(sb, arm.pat)
        match arm.guard_expr {
          Some(ge) => {
            sb.write_string(" if ")
            stub_write_expr(sb, ge)
          }
          None => ()
        }
        sb.write_string(" => ")
        stub_write_expr(sb, arm.body)
        sb.write_string("\n")
        i = i + 1
      }
      sb.write_string("}")
    }
    ENamedArg(name, is_opt, inner, _) => {
      sb.write_string(name)
      if is_opt {
        sb.write_string("?=")
      } else {
        sb.write_string("=")
      }
      stub_write_expr(sb, inner)
    }
    EMutArg(inner, _) => {
      sb.write_string("mut ")
      stub_write_expr(sb, inner)
    }
    EMove(inner, _) => {
      sb.write_string("move ")
      stub_write_expr(sb, inner)
    }
    EIs(inner, pat, _) => {
      sb.write_string("(")
      stub_write_expr(sb, inner)
      sb.write_string(" is ")
      stub_write_pat(sb, pat)
      sb.write_string(")")
    }
    EClosure(params, ret_ty, body, _) => {
      sb.write_string("fn(")
      let mut i = 0
      while i < params.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        if params[i].is_mut {
          sb.write_string("mut ")
        }
        sb.write_string(params[i].name)
        match params[i].ty {
          TyMissing(_) => ()
          _ => {
            sb.write_string(" : ")
            sb.write_string(type_expr_to_string(params[i].ty))
          }
        }
        i = i + 1
      }
      sb.write_string(")")
      match ret_ty {
        TyMissing(_) => ()
        _ => {
          sb.write_string(" -> ")
          sb.write_string(type_expr_to_string(ret_ty))
        }
      }
      sb.write_string(" {\n")
      stub_write_stmts(sb, body)
      sb.write_string("}")
    }
    EScope(world_e, body_e, _) => {
      sb.write_string("scope(")
      stub_write_expr(sb, world_e)
      sb.write_string(", ")
      stub_write_expr(sb, body_e)
      sb.write_string(")")
    }
    ESpawn(scope_e, body_e, _) => {
      sb.write_string("spawn(")
      stub_write_expr(sb, scope_e)
      sb.write_string(", ")
      stub_write_expr(sb, body_e)
      sb.write_string(")")
    }
    EInterp(parts, _) => {
      sb.write_string("\"")
      let mut i = 0
      while i < parts.length() {
        match parts[i] {
          EString(s, _) => stub_write_str_escaped(sb, s)
          other => {
            sb.write_string("\\{")
            stub_write_expr(sb, other)
            sb.write_string("}")
          }
        }
        i = i + 1
      }
      sb.write_string("\"")
    }
  }
}

///|
fn stub_write_stmt_inline(sb : StringBuilder, st : Stmt) -> Unit {
  match st {
    SLet(name, is_mut, ty, init, _) => {
      sb.write_string("let ")
      if is_mut {
        sb.write_string("mut ")
      }
      sb.write_string(name)
      match ty {
        TyMissing(_) => ()
        _ => {
          sb.write_string(" : ")
          sb.write_string(type_expr_to_string(ty))
        }
      }
      sb.write_string(" = ")
      stub_write_expr(sb, init)
    }
    SLetTuple(names, ty, init, _) => {
      sb.write_string("let (")
      let mut ni = 0
      while ni < names.length() {
        if ni > 0 {
          sb.write_string(", ")
        }
        sb.write_string(names[ni])
        ni = ni + 1
      }
      sb.write_string(")")
      match ty {
        TyMissing(_) => ()
        _ => {
          sb.write_string(" : ")
          sb.write_string(type_expr_to_string(ty))
        }
      }
      sb.write_string(" = ")
      stub_write_expr(sb, init)
    }
    SAssign(lhs, rhs, _) => {
      stub_write_expr(sb, lhs)
      sb.write_string(" = ")
      stub_write_expr(sb, rhs)
    }
    SCompoundAssign(op, lhs, rhs, _) => {
      stub_write_expr(sb, lhs)
      sb.write_string(" ")
      sb.write_string(op)
      sb.write_string("= ")
      stub_write_expr(sb, rhs)
    }
    SExpr(e, _) => stub_write_expr(sb, e)
    _ => sb.write_string("panic()")
  }
}

///|
fn stub_write_stmts(sb : StringBuilder, stmts : Array[Stmt]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    sb.write_string("  ")
    match stmts[i] {
      SLet(name, is_mut, ty, init, _) => {
        sb.write_string("let ")
        if is_mut {
          sb.write_string("mut ")
        }
        sb.write_string(name)
        match ty {
          TyMissing(_) => ()
          _ => {
            sb.write_string(" : ")
            sb.write_string(type_expr_to_string(ty))
          }
        }
        sb.write_string(" = ")
        stub_write_expr(sb, init)
      }
      SLetTuple(names, ty, init, _) => {
        sb.write_string("let (")
        let mut ni = 0
        while ni < names.length() {
          if ni > 0 {
            sb.write_string(", ")
          }
          sb.write_string(names[ni])
          ni = ni + 1
        }
        sb.write_string(")")
        match ty {
          TyMissing(_) => ()
          _ => {
            sb.write_string(" : ")
            sb.write_string(type_expr_to_string(ty))
          }
        }
        sb.write_string(" = ")
        stub_write_expr(sb, init)
      }
      SAssign(lhs, rhs, _) => {
        stub_write_expr(sb, lhs)
        sb.write_string(" = ")
        stub_write_expr(sb, rhs)
      }
      SCompoundAssign(op, lhs, rhs, _) => {
        stub_write_expr(sb, lhs)
        sb.write_string(" ")
        sb.write_string(op)
        sb.write_string("= ")
        stub_write_expr(sb, rhs)
      }
      SExpr(e, _) => stub_write_expr(sb, e)
      SGuard(cond, body, _) => {
        sb.write_string("guard ")
        stub_write_expr(sb, cond)
        sb.write_string(" else {\n")
        stub_write_stmts(sb, body)
        sb.write_string("  }")
      }
      SReturn(opt, _) =>
        match opt {
          None => sb.write_string("return")
          Some(e) => {
            sb.write_string("return ")
            stub_write_expr(sb, e)
          }
        }
      SWhile(wcond, wbody, _) => {
        sb.write_string("while ")
        stub_write_expr(sb, wcond)
        sb.write_string(" {\n")
        stub_write_stmts(sb, wbody)
        sb.write_string("  }")
      }
      SFor(init_st, cond_e, step_st, fbody, _) => {
        sb.write_string("for ")
        stub_write_stmt_inline(sb, init_st)
        sb.write_string("; ")
        stub_write_expr(sb, cond_e)
        sb.write_string("; ")
        stub_write_stmt_inline(sb, step_st)
        sb.write_string(" {\n")
        stub_write_stmts(sb, fbody)
        sb.write_string("  }")
      }
      SForRange(vname, start_e, end_e, inclusive, fbody, _) => {
        sb.write_string("for ")
        sb.write_string(vname)
        sb.write_string(" in ")
        stub_write_expr(sb, start_e)
        sb.write_string(if inclusive { "..=" } else { "..<" })
        stub_write_expr(sb, end_e)
        sb.write_string(" {\n")
        stub_write_stmts(sb, fbody)
        sb.write_string("  }")
      }
      SForIn(kname, vname, iter_e, fbody, _) => {
        sb.write_string("for ")
        if kname.length() > 0 && vname.length() > 0 {
          sb.write_string(kname)
          sb.write_string(", ")
          sb.write_string(vname)
        } else if vname.length() > 0 {
          sb.write_string(vname)
        } else {
          sb.write_string(kname)
        }
        sb.write_string(" in ")
        stub_write_expr(sb, iter_e)
        sb.write_string(" {\n")
        stub_write_stmts(sb, fbody)
        sb.write_string("  }")
      }
      SDebugAssert(cond_e, msg_e, _) => {
        sb.write_string("debug_assert(")
        stub_write_expr(sb, cond_e)
        sb.write_string(", ")
        stub_write_expr(sb, msg_e)
        sb.write_string(")")
      }
      SBreak(_) => sb.write_string("break")
      SContinue(_) => sb.write_string("continue")
    }
    sb.write_string("\n")
    i = i + 1
  }
}

///|
/// Collect identifiers/method names referenced inside `e` for private-helper
/// reachability from generic fns/impls and complex pub default args.
fn stub_collect_refs_expr(
  e : Expr,
  out_names : Array[String],
  out_methods : Array[String],
) -> Unit {
  match e {
    EIdent(name, _) => out_names.push(name)
    EPath(q, m, _) => {
      out_names.push(q + "::" + m)
      out_names.push(m)
    }
    EDotVariant(_, args, _) => stub_collect_refs_exprs(args, out_names, out_methods)
    EUnary(_, inner, _) | EMutArg(inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) =>
      stub_collect_refs_expr(inner, out_names, out_methods)
    EIs(inner, _, _) => stub_collect_refs_expr(inner, out_names, out_methods)
    EBinary(_, lhs, rhs, _) => {
      stub_collect_refs_expr(lhs, out_names, out_methods)
      stub_collect_refs_expr(rhs, out_names, out_methods)
    }
    ECall(callee, args, _) => {
      stub_collect_refs_expr(callee, out_names, out_methods)
      stub_collect_refs_exprs(args, out_names, out_methods)
    }
    EField(obj, _, _) => stub_collect_refs_expr(obj, out_names, out_methods)
    EMethodCall(recv, mname, args, _) => {
      out_methods.push(mname)
      stub_collect_refs_expr(recv, out_names, out_methods)
      stub_collect_refs_exprs(args, out_names, out_methods)
    }
    EIndex(obj, idx, _) => {
      stub_collect_refs_expr(obj, out_names, out_methods)
      stub_collect_refs_expr(idx, out_names, out_methods)
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) =>
      stub_collect_refs_exprs(elems, out_names, out_methods)
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => stub_collect_refs_expr(base, out_names, out_methods)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        stub_collect_refs_expr(fields[i].value, out_names, out_methods)
        i = i + 1
      }
    }
    EBlock(stmts, _) => stub_collect_refs_stmts(stmts, out_names, out_methods)
    EIf(cond, then_stmts, else_opt, _) => {
      stub_collect_refs_expr(cond, out_names, out_methods)
      stub_collect_refs_stmts(then_stmts, out_names, out_methods)
      match else_opt {
        Some(el) => stub_collect_refs_expr(el, out_names, out_methods)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      stub_collect_refs_expr(scrut, out_names, out_methods)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(g) => stub_collect_refs_expr(g, out_names, out_methods)
          None => ()
        }
        stub_collect_refs_expr(arms[i].body, out_names, out_methods)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) => stub_collect_refs_stmts(body, out_names, out_methods)
    EScope(a, b, _) | ESpawn(a, b, _) => {
      stub_collect_refs_expr(a, out_names, out_methods)
      stub_collect_refs_expr(b, out_names, out_methods)
    }
    ENamedArg(_, _, inner, _) => stub_collect_refs_expr(inner, out_names, out_methods)
    _ => ()
  }
}

///|
fn stub_collect_refs_exprs(
  es : Array[Expr],
  out_names : Array[String],
  out_methods : Array[String],
) -> Unit {
  let mut i = 0
  while i < es.length() {
    stub_collect_refs_expr(es[i], out_names, out_methods)
    i = i + 1
  }
}

///|
fn stub_collect_refs_stmts(
  stmts : Array[Stmt],
  out_names : Array[String],
  out_methods : Array[String],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        stub_collect_refs_expr(init, out_names, out_methods)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        stub_collect_refs_expr(lhs, out_names, out_methods)
        stub_collect_refs_expr(rhs, out_names, out_methods)
      }
      SGuard(cond, body, _) | SWhile(cond, body, _) => {
        stub_collect_refs_expr(cond, out_names, out_methods)
        stub_collect_refs_stmts(body, out_names, out_methods)
      }
      SFor(init_st, cond, step_st, body, _) => {
        stub_collect_refs_stmts([init_st], out_names, out_methods)
        stub_collect_refs_expr(cond, out_names, out_methods)
        stub_collect_refs_stmts([step_st], out_names, out_methods)
        stub_collect_refs_stmts(body, out_names, out_methods)
      }
      SForRange(_, s, e, _, body, _) => {
        stub_collect_refs_expr(s, out_names, out_methods)
        stub_collect_refs_expr(e, out_names, out_methods)
        stub_collect_refs_stmts(body, out_names, out_methods)
      }
      SForIn(_, _, it, body, _) => {
        stub_collect_refs_expr(it, out_names, out_methods)
        stub_collect_refs_stmts(body, out_names, out_methods)
      }
      SReturn(Some(e), _) | SExpr(e, _) => stub_collect_refs_expr(e, out_names, out_methods)
      SDebugAssert(c, m, _) => {
        stub_collect_refs_expr(c, out_names, out_methods)
        stub_collect_refs_expr(m, out_names, out_methods)
      }
      _ => ()
    }
    i = i + 1
  }
}

///|
fn stub_fn_key(fd : FnDecl) -> String {
  if fd.receiver_type != "" {
    fd.receiver_type + "::" + fd.name
  } else {
    fd.name
  }
}

///|
/// Compute the transitive closure of private functions and private constants
/// reachable from generic fn/impl bodies or pub default-arg expressions so
/// cross-package monomorphization/default expansion never calls a `{ panic() }`
/// private stub.
fn stub_collect_reachable_priv_deps(
  pkg : Package,
) -> (Map[String, Bool], Map[String, Bool]) {
  let priv_fns : Map[String, FnDecl] = Map([])
  let priv_methods_by_name : Map[String, Array[String]] = Map([])
  let priv_consts : Map[String, Expr] = Map([])
  let q_names : Array[String] = []
  let q_methods : Array[String] = []

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => {
          let fk = stub_fn_key(fd)
          if !fd.is_pub && fd.type_params.length() == 0 {
            priv_fns.set(fk, fd)
            if fd.receiver_type != "" {
              sig_demand_map_push_unique(priv_methods_by_name, fd.name, fk)
            }
          }
          if fd.type_params.length() > 0 {
            stub_collect_refs_stmts(fd.body, q_names, q_methods)
          }
          if fd.is_pub {
            let mut pi = 0
            while pi < fd.params.length() {
              match fd.params[pi].default_expr {
                Some(def) => stub_collect_refs_expr(def, q_names, q_methods)
                None => ()
              }
              pi = pi + 1
            }
          }
        }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            let m = id.methods[mi]
            if id.type_params.length() > 0 || m.type_params.length() > 0 {
              stub_collect_refs_stmts(m.body, q_names, q_methods)
            }
            mi = mi + 1
          }
        }
        DConst(cd) =>
          if !cd.is_pub {
            priv_consts.set(cd.name, cd.value)
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  let keep_fns : Map[String, Bool] = Map([])
  let keep_consts : Map[String, Bool] = Map([])
  let mut ni = 0
  let mut mi = 0
  while ni < q_names.length() || mi < q_methods.length() {
    while ni < q_names.length() {
      let nm = q_names[ni]
      ni = ni + 1
      if !keep_fns.contains(nm) {
        match priv_fns.get(nm) {
          Some(fd) => {
            keep_fns.set(nm, true)
            stub_collect_refs_stmts(fd.body, q_names, q_methods)
          }
          None => ()
        }
      }
      if !keep_consts.contains(nm) {
        match priv_consts.get(nm) {
          Some(val_e) => {
            keep_consts.set(nm, true)
            stub_collect_refs_expr(val_e, q_names, q_methods)
          }
          None => ()
        }
      }
    }
    while mi < q_methods.length() {
      let mn = q_methods[mi]
      mi = mi + 1
      match priv_methods_by_name.get(mn) {
        Some(fks) => {
          let mut ki = 0
          while ki < fks.length() {
            q_names.push(fks[ki])
            ki = ki + 1
          }
        }
        None => ()
      }
    }
  }
  (keep_fns, keep_consts)
}

///|
/// Emit a minimal parseable `.pion` stub containing only top-level declarations
/// (structs, enums, const types, and fn signatures with `{ panic() }` bodies).
pub fn emit_file_stub(f : SourceFile) -> String {
  emit_file_stub_with_syms(f, None, Map([]), Map([]))
}

///|
fn emit_file_stub_with_syms(
  f : SourceFile,
  xpkg_syms : Option[XpkgPubSyms],
  keep_priv_fns : Map[String, Bool],
  keep_priv_consts : Map[String, Bool],
) -> String {
  let sb = StringBuilder()
  let mut di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DStruct(sd) => {
        if sd.derive_eq {
          sb.write_string("#derive(Eq)\n")
        }
        if sd.is_pub {
          sb.write_string("pub ")
        }
        if sd.is_val {
          sb.write_string("val ")
        }
        sb.write_string("struct ")
        sb.write_string(sd.name)
        sb.write_string(format_type_params(sd.type_params))
        sb.write_string(" {\n")
        let mut i = 0
        while i < sd.fields.length() {
          let fld = sd.fields[i]
          sb.write_string("  ")
          if fld.is_priv {
            sb.write_string("priv ")
          }
          if fld.is_mut {
            sb.write_string("mut ")
          }
          sb.write_string(fld.name)
          sb.write_string(" : ")
          sb.write_string(type_expr_to_string(fld.ty))
          sb.write_string("\n")
          i = i + 1
        }
        sb.write_string("}\n")
      }
      DEnum(ed) => {
        if ed.derive_eq {
          sb.write_string("#derive(Eq)\n")
        }
        if ed.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("enum ")
        sb.write_string(ed.name)
        sb.write_string(format_type_params(ed.type_params))
        sb.write_string(" {\n")
        let mut i = 0
        while i < ed.variants.length() {
          let v = ed.variants[i]
          sb.write_string("  ")
          sb.write_string(v.name)
          if v.fields.length() > 0 {
            sb.write_string("(")
            let mut j = 0
            while j < v.fields.length() {
              if j > 0 {
                sb.write_string(", ")
              }
              sb.write_string(type_expr_to_string(v.fields[j]))
              j = j + 1
            }
            sb.write_string(")")
          }
          sb.write_string("\n")
          i = i + 1
        }
        sb.write_string("}\n")
      }
      DFn(fd) => {
        if fd.is_into {
          sb.write_string("#into\n")
        }
        if fd.is_verify_opaque {
          sb.write_string("#verify_opaque\n")
        } else if fd.is_verify {
          sb.write_string("#verify\n")
        }
        if fd.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("fn ")
        if fd.receiver_type != "" {
          sb.write_string(fd.receiver_type)
          sb.write_string("::")
        }
        sb.write_string(fd.name)
        sb.write_string(format_type_params_with_bounds(fd.type_params, fd.type_bounds))
        sb.write_string("(")
        let mut i = 0
        while i < fd.params.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          write_param_sig_ex(sb, fd.params[i], true, true)
          i = i + 1
        }
        sb.write_string(") -> ")
        sb.write_string(type_expr_to_string(fd.ret_ty))
        let emit_body = fd.type_params.length() > 0 ||
          keep_priv_fns.contains(stub_fn_key(fd)) ||
          match xpkg_syms {
            Some(syms) =>
              xpkg_fn_is_inlinable(syms, fd) ||
              xpkg_fn_is_inlinable_priv_leaf(syms, fd)
            None => false
          }
        if emit_body {
          sb.write_string(" {\n")
          stub_write_stmts(sb, fd.body)
          sb.write_string("}\n")
        } else {
          sb.write_string(" { panic() }\n")
        }
      }
      DExternFn(ed) => {
        if ed.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("extern \"")
        sb.write_string(ed.abi)
        sb.write_string("\" fn ")
        sb.write_string(ed.name)
        sb.write_string("(")
        let mut i = 0
        while i < ed.params.length() {
          if i > 0 {
            sb.write_string(", ")
          }
          if ed.vararg_from >= 0 && i == ed.vararg_from {
            sb.write_string("..., ")
          }
          let param = ed.params[i]
          sb.write_string(param.name)
          sb.write_string(" : ")
          sb.write_string(type_expr_to_string(param.ty))
          i = i + 1
        }
        if ed.vararg_from >= 0 && ed.vararg_from == ed.params.length() {
          if ed.params.length() > 0 {
            sb.write_string(", ")
          }
          sb.write_string("...")
        }
        sb.write_string(") -> ")
        sb.write_string(type_expr_to_string(ed.ret_ty))
        if ed.c_symbol != ed.name {
          sb.write_string(" = ")
          sb.write_string(json_quote(ed.c_symbol))
        }
        if ed.has_body {
          sb.write_string(" { panic() }\n")
        } else {
          sb.write_string("\n")
        }
      }
      DTrait(td) => {
        if td.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("trait ")
        sb.write_string(td.name)
        sb.write_string(" {\n")
        let mut i = 0
        while i < td.methods.length() {
          let m = td.methods[i]
          sb.write_string("  fn ")
          sb.write_string(m.name)
          sb.write_string("(")
          let mut j = 0
          while j < m.params.length() {
            if j > 0 {
              sb.write_string(", ")
            }
            write_param_sig_ex(sb, m.params[j], true, true)
            j = j + 1
          }
          sb.write_string(") -> ")
          sb.write_string(type_expr_to_string(m.ret_ty))
          sb.write_string("\n")
          i = i + 1
        }
        sb.write_string("}\n")
      }
      DImpl(id) => {
        if id.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("impl")
        sb.write_string(format_type_params_with_bounds(id.type_params, id.type_bounds))
        sb.write_string(" ")
        sb.write_string(id.trait_name)
        sb.write_string(" for ")
        sb.write_string(id.target_type)
        if id.target_type_args.length() > 0 {
          sb.write_string("[")
          let mut ai = 0
          while ai < id.target_type_args.length() {
            if ai > 0 {
              sb.write_string(", ")
            }
            sb.write_string(type_expr_to_string(id.target_type_args[ai]))
            ai = ai + 1
          }
          sb.write_string("]")
        }
        sb.write_string(" {\n")
        let mut i = 0
        while i < id.methods.length() {
          let m = id.methods[i]
          if m.is_verify_opaque {
            sb.write_string("  #verify_opaque\n")
          } else if m.is_verify {
            sb.write_string("  #verify\n")
          }
          sb.write_string("  fn ")
          sb.write_string(m.name)
          sb.write_string(format_type_params_with_bounds(m.type_params, m.type_bounds))
          sb.write_string("(")
          let mut j = 0
          while j < m.params.length() {
            if j > 0 {
              sb.write_string(", ")
            }
            write_param_sig_ex(sb, m.params[j], true, true)
            j = j + 1
          }
          sb.write_string(") -> ")
          sb.write_string(type_expr_to_string(m.ret_ty))
          if id.type_params.length() > 0 || m.type_params.length() > 0 {
            sb.write_string(" {\n")
            stub_write_stmts(sb, m.body)
            sb.write_string("  }\n")
          } else {
            sb.write_string(" { panic() }\n")
          }
          i = i + 1
        }
        sb.write_string("}\n")
      }
      DConst(cd) => {
        if cd.is_pub {
          sb.write_string("pub ")
        }
        sb.write_string("let ")
        sb.write_string(cd.name)
        sb.write_string(" : ")
        sb.write_string(type_expr_to_string(cd.ty))
        let emit_const_val = keep_priv_consts.contains(cd.name) ||
          match xpkg_syms {
            Some(_) => !cd.is_pub && xpkg_is_const_scalar_expr(cd.value)
            None => false
          }
        if emit_const_val {
          sb.write_string(" = ")
          stub_write_expr(sb, cd.value)
          sb.write_string("\n")
        } else {
          sb.write_string(" = panic()\n")
        }
      }
      DTest(_) => ()
    }
    di = di + 1
  }
  sb.to_string()
}

///|
pub fn pkg_has_pub_generic_fn(pkg : Package) -> Bool {
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) =>
          if fd.is_pub && fd.type_params.length() > 0 {
            return true
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  false
}

///|
/// Emit a minimal parseable `.pion` package stub preserving imports and all
/// top-level declaration signatures (with `{ panic() }` / `= panic()` bodies)
/// so downstream packages can typecheck against CAS-hit dependencies without
/// re-parsing or typechecking upstream function bodies.
fn params_have_complex_default(params : Array[Param]) -> Bool {
  let mut i = 0
  while i < params.length() {
    match params[i].default_expr {
      Some(def) =>
        match format_simple_default_expr(def) {
          Some(_) => ()
          None => return true
        }
      None => ()
    }
    i = i + 1
  }
  false
}

///|
fn pkg_has_complex_pub_default(pkg : Package) -> Bool {
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) =>
          if fd.is_pub && params_have_complex_default(fd.params) {
            return true
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  false
}

///|
pub fn pkg_has_generic_impl(pkg : Package) -> Bool {
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DImpl(id) =>
          if id.type_params.length() > 0 {
            return true
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  false
}

///|
fn pkg_non_generic_fn_count(pkg : Package) -> Int {
  let mut cnt = 0
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) =>
          if fd.type_params.length() == 0 {
            cnt = cnt + 1
          }
        DImpl(id) =>
          if id.type_params.length() == 0 {
            let mut mi = 0
            while mi < id.methods.length() {
              if id.methods[mi].type_params.length() == 0 {
                cnt = cnt + 1
              }
              mi = mi + 1
            }
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  cnt
}

///|
pub fn emit_pion_stub(pkg : Package) -> String {
  // Emit real bodies for generic fns / generic impls and real default-arg
  // expressions while folding non-generic bodies to `{ panic() }`. For tiny
  // generic-only packages (< 4 non-generic fns), stubbing saves nothing over
  // source loading, so keep returning "" (preserving empty-stub CAS behavior).
  if (pkg_has_pub_generic_fn(pkg) || pkg_has_generic_impl(pkg)) &&
  pkg_non_generic_fn_count(pkg) < 4 {
    return ""
  }
  let sb = StringBuilder()
  let seen_imports : Map[String, Bool] = Map([])
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut ii = 0
    while ii < f.imports.length() {
      let imp = f.imports[ii]
      let key = imp.path + "\n" + imp.alias_name
      if !seen_imports.contains(key) {
        seen_imports.set(key, true)
        sb.write_string("import ")
        sb.write_string(json_quote(imp.path))
        sb.write_string(" as ")
        sb.write_string(imp.alias_name)
        sb.write_string("\n")
      }
      ii = ii + 1
    }
    fi = fi + 1
  }
  let syms = xpkg_pub_syms_from_pkg(pkg)
  let (keep_priv_fns, keep_priv_consts) = stub_collect_reachable_priv_deps(pkg)
  fi = 0
  while fi < pkg.files.length() {
    sb.write_string(emit_file_stub_with_syms(pkg.files[fi], Some(syms), keep_priv_fns, keep_priv_consts))
    fi = fi + 1
  }
  let stub_txt = sb.to_string()
  if stub_txt.length() > 0 {
    let pr = parse_source(pkg.name + ".pionstub", stub_txt)
    if pr.diagnostics.length() > 0 {
      return ""
    }
  }
  stub_txt
}

///|
pub struct ConstInitPlan {
  order : Array[String]
  has_cycle : Bool
  cycle_path : Array[String]
  plan_hash : String
  has_ambiguous_method : Bool
}

///|
struct SigCallDesc {
  target : String
  has_at : Bool
  pos_count : Int
  named_args : Array[String]
  cb_slots : Array[String]
  cb_targets : Array[String]
}

///|
fn sig_is_digits(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let ch = str_code_at(s, i)
    if ch < 48 || ch > 57 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn sig_parse_nonneg_int(s : String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let ch = str_code_at(s, i)
    if ch >= 48 && ch <= 57 {
      v = v * 10 + (ch - 48)
    } else {
      break
    }
    i = i + 1
  }
  v
}

///|
fn sig_parse_call_desc(raw : String) -> SigCallDesc {
  let at_i = sig_find_char(raw, 64, 0)
  if at_i < 0 {
    return SigCallDesc::{
      target: raw,
      has_at: false,
      pos_count: -1,
      named_args: [],
      cb_slots: [],
      cb_targets: [],
    }
  }
  let target = slice_str(raw, 0, at_i)
  let q_i = sig_find_char(raw, 63, at_i + 1)
  let head_end = if q_i >= 0 { q_i } else { raw.length() }
  let rest = slice_str(raw, at_i + 1, head_end)
  let cb_slots : Array[String] = []
  let cb_targets : Array[String] = []
  if q_i >= 0 {
    let mut qs = q_i + 1
    let mut qi = qs
    while qi <= raw.length() {
      if qi == raw.length() || str_code_at(raw, qi) == 63 {
        if qi > qs {
          let part = slice_str(raw, qs, qi)
          let eq_i = sig_find_char(part, 61, 0)
          if eq_i > 0 && eq_i + 1 < part.length() {
            cb_slots.push(slice_str(part, 0, eq_i))
            cb_targets.push(slice_str(part, eq_i + 1, part.length()))
          }
        }
        qs = qi + 1
      }
      qi = qi + 1
    }
  }
  let semi = sig_find_char(rest, 59, 0)
  if semi < 0 {
    return SigCallDesc::{
      target: target,
      has_at: true,
      pos_count: sig_parse_nonneg_int(rest),
      named_args: [],
      cb_slots: cb_slots,
      cb_targets: cb_targets,
    }
  }
  let pos_count = sig_parse_nonneg_int(slice_str(rest, 0, semi))
  let named : Array[String] = []
  let mut start = semi + 1
  let mut i = start
  while i < rest.length() {
    if str_code_at(rest, i) == 59 {
      if i > start {
        named.push(slice_str(rest, start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < rest.length() {
    named.push(slice_str(rest, start, rest.length()))
  }
  SigCallDesc::{
    target: target,
    has_at: true,
    pos_count: pos_count,
    named_args: named,
    cb_slots: cb_slots,
    cb_targets: cb_targets,
  }
}

///|
fn sig_slot_to_pidx(pnames : Array[String], slot_key : String) -> Int {
  if sig_is_digits(slot_key) {
    return sig_parse_nonneg_int(slot_key)
  }
  let mut i = 0
  while i < pnames.length() {
    if pnames[i] == slot_key {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn sig_target_calls_slot(
  target : String,
  slot_key : String,
  fn_keys : Array[String],
  fn_key_idx : Map[String, Int],
  method_name_to_idxs : Map[String, Array[Int]],
  fn_pnames : Array[Array[String]],
  fn_called_params : Array[Map[Int, Bool]],
  fn_unknown_callp : Map[String, Bool],
) -> Bool {
  if slot_key == "@fdefcall" {
    return true
  }
  if target == "__builtin__::push" ||
    target == "__builtin__::set" ||
    target == "__builtin__::insert" ||
    target == "Array::make" ||
    target == "FixedArray::make" ||
    target == "Array::new" ||
    target == "Array::with_capacity" ||
    target == "Map::new" ||
    target == "Map::with_capacity" ||
    target == "Map" ||
    target == "Bytes::new" {
    return false
  }
  if starts_with_str(target, ".") {
    match method_name_to_idxs.get(target) {
      Some(tidxs) => {
        if tidxs.length() == 0 {
          return true
        }
        let mut ti = 0
        while ti < tidxs.length() {
          let tidx = tidxs[ti]
          match fn_unknown_callp.get(fn_keys[tidx]) {
            Some(true) => return true
            _ => ()
          }
          let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot_key)
          if pidx >= 0 && fn_called_params[tidx].contains(pidx) {
            return true
          }
          ti = ti + 1
        }
        false
      }
      None => true
    }
  } else {
    match fn_unknown_callp.get(target) {
      Some(true) => return true
      _ => ()
    }
    match fn_key_idx.get(target) {
      Some(tidx) => {
        let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot_key)
        pidx >= 0 && fn_called_params[tidx].contains(pidx)
      }
      None => !(starts_with_str(target, "fw:") || starts_with_str(target, "fp:"))
    }
  }
}

///|
fn sig_fdef_triggered(
  desc : SigCallDesc,
  param_idx : Int,
  param_name : String,
) -> Bool {
  if !desc.has_at {
    return false
  }
  if param_idx < desc.pos_count {
    return false
  }
  let mut i = 0
  while i < desc.named_args.length() {
    if desc.named_args[i] == param_name {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn sig_split_csv(s : String) -> Array[String] {
  let out : Array[String] = []
  if s.length() == 0 {
    return out
  }
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    if str_code_at(s, i) == 44 {
      if i > start {
        out.push(slice_str(s, start, i))
      }
      start = i + 1
    }
    i = i + 1
  }
  if start < s.length() {
    out.push(slice_str(s, start, s.length()))
  }
  out
}

///|
fn sig_find_char(s : String, ch : Int, from : Int) -> Int {
  let mut i = from
  while i < s.length() {
    if str_code_at(s, i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn sig_find_const_cycle_dfs(
  u : Int,
  deps : Array[Array[Int]],
  done : Array[Bool],
  color : Array[Int],
  stack : Array[Int],
  const_names : Array[String],
) -> Array[String] {
  color[u] = 1
  stack.push(u)
  let du = deps[u]
  let mut i = 0
  while i < du.length() {
    let v = du[i]
    if !done[v] {
      if color[v] == 1 {
        let cyc : Array[String] = []
        let mut si = 0
        while si < stack.length() && stack[si] != v {
          si = si + 1
        }
        while si < stack.length() {
          cyc.push(const_names[stack[si]])
          si = si + 1
        }
        cyc.push(const_names[v])
        return cyc
      } else if color[v] == 0 {
        let sub = sig_find_const_cycle_dfs(v, deps, done, color, stack, const_names)
        if sub.length() > 0 {
          return sub
        }
      }
    }
    i = i + 1
  }
  let _ = stack.pop()
  color[u] = 2
  []
}

///|
/// Package-level topological initialization planner for top-level `let` constants.
/// Shared by type checking (`E_CONST_CYCLE`), codegen (`init_all`), and incremental
/// per-unit CAS (`summarize_file_sigs`).
///|
fn sig_scan_ident_end(s : String, start : Int) -> Int {
  let mut i = start
  while i < s.length() {
    let ch = str_code_at(s, i)
    if (ch >= 65 && ch <= 90) ||
      (ch >= 97 && ch <= 122) ||
      (ch >= 48 && ch <= 57) ||
      ch == 95 {
      i = i + 1
    } else {
      break
    }
  }
  i
}

///|
fn sig_is_builtin_type_qual(qual : String) -> Bool {
  qual == "Array" ||
  qual == "FixedArray" ||
  qual == "ImmArray" ||
  qual == "Map" ||
  qual == "Bytes" ||
  qual == "StringBuilder" ||
  qual == "Double" ||
  qual == "Float" ||
  qual == "Float32" ||
  qual == "Int" ||
  qual == "Int64" ||
  qual == "UInt" ||
  qual == "UInt64" ||
  qual == "Option" ||
  qual == "Result" ||
  qual == "Mutex" ||
  qual == "Channel" ||
  qual == "AtomicInt" ||
  qual == "AtomicBool" ||
  qual == "String" ||
  qual == "StrView" ||
  qual == "BytesView" ||
  qual == "Char" ||
  qual == "Bool" ||
  qual == "Byte" ||
  qual == "Ptr" ||
  qual == "World"
}

///|
fn sig_ctor_query_is_ambig(
  cname : String,
  local_enums : Map[String, Bool],
  local_enum_variants : Map[String, Bool],
  local_enum_qual_variants : Map[String, Bool],
  local_non_enum_types : Map[String, Bool],
  extern_fns : Map[String, Bool],
  fn_key_idx : Map[String, Int],
  const_idx : Map[String, Int],
) -> Bool {
  let key = slice_str(cname, 6, cname.length())
  let sep = sig_find_char(key, 58, 0)
  if sep > 0 && sep + 2 < key.length() && str_code_at(key, sep + 1) == 58 {
    let qual = slice_str(key, 0, sep)
    if local_enums.contains(qual) {
      local_enum_qual_variants.contains(key) || !fn_key_idx.contains(key)
    } else if local_non_enum_types.contains(qual) || sig_is_builtin_type_qual(qual) {
      false
    } else {
      true
    }
  } else {
    if key == "Some" || key == "Ok" || key == "Err" {
      const_idx.contains(key) || fn_key_idx.contains(key) || extern_fns.contains(key)
    } else {
      local_enum_variants.contains(key) && !fn_key_idx.contains(key) && !extern_fns.contains(key)
    }
  }
}

///|
fn sig_add_ret_depth(
  m : Map[String, Array[Int]],
  any_ret : Map[String, Bool],
  key : String,
  d : Int,
  fn_unknown_callp : Map[String, Bool],
) -> Bool {
  if d <= 0 {
    return false
  }
  if d > 64 {
    let mut changed = false
    if !any_ret.contains(key) {
      any_ret.set(key, true)
      changed = true
    }
    let sep = sig_find_char(key, 124, 0)
    if sep > 0 {
      let fk = slice_str(key, 0, sep)
      let was = match fn_unknown_callp.get(fk) {
        Some(true) => true
        _ => false
      }
      if !was {
        fn_unknown_callp.set(fk, true)
        changed = true
      }
    }
    return changed
  }
  match m.get(key) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if arr[i] == d {
          return false
        }
        i = i + 1
      }
      arr.push(d)
      true
    }
    None => {
      m.set(key, [d])
      true
    }
  }
}

///|
fn sig_repeat_ret_prefix(d : Int, target : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < d {
    sb.write_string("$ret:")
    i = i + 1
  }
  sb.write_string(target)
  sb.to_string()
}

///|
fn sig_count_ret_prefix(s : String) -> Int {
  let mut d = 0
  let mut cur = s
  while starts_with_str(cur, "$ret:") {
    d = d + 1
    cur = slice_str(cur, 5, cur.length())
  }
  d
}

///|
fn sig_fwd_slot_only(slot_and_args : String) -> String {
  let at = sig_find_char(slot_and_args, 64, 0)
  if at >= 0 { slice_str(slot_and_args, 0, at) } else { slot_and_args }
}

///|
fn sig_fwd_edge_target_pidxs(
  tgt : String,
  slot_and_args : String,
  fn_key_idx : Map[String, Int],
  fn_pnames : Array[Array[String]],
  fdef_by_fn : Map[String, Array[Int]],
  fdef_by_method : Map[String, Array[Int]],
  fdef_fn : Array[String],
  fdef_param_idx : Array[Int],
  fdef_param_name : Array[String],
  fdef_cb_targets : Map[String, Array[String]],
  fdef_pcalls : Map[String, Array[Int]],
) -> Array[Int] {
  let out : Array[Int] = []
  match fn_key_idx.get(tgt) {
    Some(tidx) => {
      let at = sig_find_char(slot_and_args, 64, 0)
      let slot = sig_fwd_slot_only(slot_and_args)
      let p0 = sig_slot_to_pidx(fn_pnames[tidx], slot)
      if p0 >= 0 {
        out.push(p0)
      }
      if at >= 0 {
        let call_s = tgt + slice_str(slot_and_args, at, slot_and_args.length()) + "?" + slot + "=@probe#"
        let desc = sig_parse_call_desc(call_s)
        let eff_slots : Array[String] = []
        let eff_targets : Array[String] = []
        sig_collect_call_effective_cbs(
          desc,
          fdef_by_fn,
          fdef_by_method,
          fdef_fn,
          fdef_param_idx,
          fdef_param_name,
          fdef_cb_targets,
          fdef_pcalls,
          fn_key_idx,
          fn_pnames,
          eff_slots,
          eff_targets,
        )
        let mut i = 0
        while i < eff_slots.length() {
          if eff_targets[i] == "@probe#" {
            let pi = sig_slot_to_pidx(fn_pnames[tidx], eff_slots[i])
            if pi >= 0 {
              let mut dup = false
              let mut k = 0
              while k < out.length() {
                if out[k] == pi {
                  dup = true
                  break
                }
                k = k + 1
              }
              if !dup {
                out.push(pi)
              }
            }
          }
          i = i + 1
        }
      }
    }
    None => ()
  }
  out
}

///|
fn sig_fwd_edge_is_called(
  tgt : String,
  slot_and_args : String,
  fn_keys : Array[String],
  fn_key_idx : Map[String, Int],
  method_name_to_idxs : Map[String, Array[Int]],
  fn_pnames : Array[Array[String]],
  fn_called_params : Array[Map[Int, Bool]],
  fn_unknown_callp : Map[String, Bool],
  fdef_by_fn : Map[String, Array[Int]],
  fdef_by_method : Map[String, Array[Int]],
  fdef_fn : Array[String],
  fdef_param_idx : Array[Int],
  fdef_param_name : Array[String],
  fdef_cb_targets : Map[String, Array[String]],
  fdef_pcalls : Map[String, Array[Int]],
) -> Bool {
  let at = sig_find_char(slot_and_args, 64, 0)
  let slot = if at >= 0 { slice_str(slot_and_args, 0, at) } else { slot_and_args }
  if sig_target_calls_slot(
    tgt,
    slot,
    fn_keys,
    fn_key_idx,
    method_name_to_idxs,
    fn_pnames,
    fn_called_params,
    fn_unknown_callp,
  ) {
    return true
  }
  if at >= 0 {
    let call_s = tgt + slice_str(slot_and_args, at, slot_and_args.length()) + "?" + slot + "=@probe#"
    let desc = sig_parse_call_desc(call_s)
    let eff_slots : Array[String] = []
    let eff_targets : Array[String] = []
    sig_collect_call_effective_cbs(
      desc,
      fdef_by_fn,
      fdef_by_method,
      fdef_fn,
      fdef_param_idx,
      fdef_param_name,
      fdef_cb_targets,
      fdef_pcalls,
      fn_key_idx,
      fn_pnames,
      eff_slots,
      eff_targets,
    )
    let mut i = 0
    while i < eff_slots.length() {
      if eff_targets[i] == "@probe#" &&
        sig_target_calls_slot(
          tgt,
          eff_slots[i],
          fn_keys,
          fn_key_idx,
          method_name_to_idxs,
          fn_pnames,
          fn_called_params,
          fn_unknown_callp,
        ) {
        return true
      }
      i = i + 1
    }
  }
  false
}

///|
fn sig_slot_matches_pidx(
  fkey : String,
  slot_key : String,
  want_pidx : Int,
  fn_key_idx : Map[String, Int],
  fn_pnames : Array[Array[String]],
) -> Bool {
  if slot_key == want_pidx.to_string() {
    return true
  }
  match fn_key_idx.get(fkey) {
    Some(tidx) => sig_slot_to_pidx(fn_pnames[tidx], slot_key) == want_pidx
    None => false
  }
}

///|
fn sig_collect_call_effective_cbs(
  desc : SigCallDesc,
  fdef_by_fn : Map[String, Array[Int]],
  fdef_by_method : Map[String, Array[Int]],
  fdef_fn : Array[String],
  fdef_param_idx : Array[Int],
  fdef_param_name : Array[String],
  fdef_cb_targets : Map[String, Array[String]],
  fdef_pcalls : Map[String, Array[Int]],
  fn_key_idx : Map[String, Int],
  fn_pnames : Array[Array[String]],
  out_slots : Array[String],
  out_targets : Array[String],
) -> Unit {
  let mut i = 0
  while i < desc.cb_slots.length() {
    out_slots.push(desc.cb_slots[i])
    out_targets.push(desc.cb_targets[i])
    i = i + 1
  }
  let didxs_opt = if starts_with_str(desc.target, ".") {
    fdef_by_method.get(desc.target)
  } else {
    fdef_by_fn.get(desc.target)
  }
  match didxs_opt {
    Some(didxs) => {
      let mut di = 0
      while di < didxs.length() {
        let d_id = didxs[di]
        if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
          let p_s = fdef_param_idx[d_id].to_string()
          let dkey = fdef_fn[d_id] + "|" + p_s
          let snap_len = out_slots.length()
          match fdef_cb_targets.get(dkey) {
            Some(dts) => {
              let mut j = 0
              while j < dts.length() {
                let dt = dts[j]
                if starts_with_str(dt, "$p") {
                  let src_idx = sig_parse_nonneg_int(slice_str(dt, 2, dt.length()))
                  let mut k = 0
                  while k < snap_len {
                    if sig_slot_matches_pidx(fdef_fn[d_id], out_slots[k], src_idx, fn_key_idx, fn_pnames) {
                      out_slots.push(p_s)
                      out_targets.push(out_targets[k])
                    }
                    k = k + 1
                  }
                } else {
                  out_slots.push(p_s)
                  out_targets.push(dt)
                }
                j = j + 1
              }
            }
            None => ()
          }
          match fdef_pcalls.get(dkey) {
            Some(pcs) => {
              let mut j = 0
              while j < pcs.length() {
                let pc_idx = pcs[j]
                let mut k = 0
                while k < snap_len {
                  if sig_slot_matches_pidx(fdef_fn[d_id], out_slots[k], pc_idx, fn_key_idx, fn_pnames) {
                    out_slots.push("@fdefcall")
                    out_targets.push(out_targets[k])
                  }
                  k = k + 1
                }
                j = j + 1
              }
            }
            None => ()
          }
        }
        di = di + 1
      }
    }
    None => ()
  }
}

///|
fn sig_target_has_any_ret_depth(
  cname : String,
  slot : String,
  fn_keys : Array[String],
  fn_key_idx : Map[String, Int],
  method_name_to_idxs : Map[String, Array[Int]],
  fn_pnames : Array[Array[String]],
  fn_any_ret_depth : Map[String, Bool],
) -> Bool {
  if fn_any_ret_depth.length() == 0 {
    return false
  }
  if starts_with_str(cname, ".") {
    match method_name_to_idxs.get(cname) {
      Some(tidxs) => {
        let mut ti = 0
        while ti < tidxs.length() {
          let tidx = tidxs[ti]
          let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot)
          if pidx >= 0 && fn_any_ret_depth.contains(fn_keys[tidx] + "|" + pidx.to_string()) {
            return true
          }
          ti = ti + 1
        }
      }
      None => ()
    }
  } else {
    match fn_key_idx.get(cname) {
      Some(tidx) => {
        let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot)
        if pidx >= 0 && fn_any_ret_depth.contains(fn_keys[tidx] + "|" + pidx.to_string()) {
          return true
        }
      }
      None => ()
    }
  }
  false
}

///|
fn sig_collect_transitive_ret_targets(
  root : String,
  fn_key_idx : Map[String, Int],
  fn_calls : Array[Array[String]],
  fn_aliases : Map[String, String],
  out_idxs : Array[Int],
) -> Unit {
  if root == "" || root == "?" || root == "$fp" {
    return
  }
  let visited : Map[String, Bool] = Map([])
  let out_seen : Map[Int, Bool] = Map([])
  let stack : Array[String] = [root]
  visited.set(root, true)
  while stack.length() > 0 {
    let cur = stack[stack.length() - 1]
    let _ = stack.pop()
    match fn_key_idx.get(cur) {
      Some(idx) => {
        if !out_seen.contains(idx) {
          out_seen.set(idx, true)
          out_idxs.push(idx)
        }
        if starts_with_str(cur, "cf:") ||
          starts_with_str(cur, "cf?:") ||
          starts_with_str(cur, "fw:") ||
          starts_with_str(cur, "fp:") ||
          starts_with_str(cur, "$slot_") ||
          starts_with_str(cur, "$cslot_") ||
          starts_with_str(cur, "$ret:") {
          let cs = fn_calls[idx]
          let mut ci = 0
          while ci < cs.length() {
            let nxt = sig_parse_call_desc(cs[ci]).target
            if nxt != "" && nxt != "?" && nxt != "$fp" && !visited.contains(nxt) {
              visited.set(nxt, true)
              stack.push(nxt)
            }
            ci = ci + 1
          }
        }
      }
      None => ()
    }
    match fn_aliases.get(cur) {
      Some(at) =>
        if at != "" && at != "?" && at != "$fp" && !visited.contains(at) {
          visited.set(at, true)
          stack.push(at)
        }
      None => ()
    }
    match fn_key_idx.get("$ret:" + cur) {
      Some(ridx) => {
        if !out_seen.contains(ridx) {
          out_seen.set(ridx, true)
          out_idxs.push(ridx)
        }
        let rcs = fn_calls[ridx]
        let mut ri = 0
        while ri < rcs.length() {
          let nxt = sig_parse_call_desc(rcs[ri]).target
          if nxt != "" && nxt != "?" && nxt != "$fp" && !visited.contains(nxt) {
            visited.set(nxt, true)
            stack.push(nxt)
          }
          ri = ri + 1
        }
      }
      None => ()
    }
  }
}

///|
fn sig_lookup_call_ret_depths(
  cname : String,
  slot : String,
  fn_keys : Array[String],
  fn_key_idx : Map[String, Int],
  method_name_to_idxs : Map[String, Array[Int]],
  fn_pnames : Array[Array[String]],
  fn_called_ret_depths : Map[String, Array[Int]],
  out_depths : Array[Int],
) -> Unit {
  let seen : Map[Int, Bool] = Map([])
  if starts_with_str(cname, ".") {
    match method_name_to_idxs.get(cname) {
      Some(tidxs) => {
        let mut ti = 0
        while ti < tidxs.length() {
          let tidx = tidxs[ti]
          let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot)
          if pidx >= 0 {
            match fn_called_ret_depths.get(fn_keys[tidx] + "|" + pidx.to_string()) {
              Some(ds) => {
                let mut di = 0
                while di < ds.length() {
                  if !seen.contains(ds[di]) {
                    seen.set(ds[di], true)
                    out_depths.push(ds[di])
                  }
                  di = di + 1
                }
              }
              None => ()
            }
          }
          ti = ti + 1
        }
      }
      None => ()
    }
  } else {
    match fn_key_idx.get(cname) {
      Some(tidx) => {
        let pidx = sig_slot_to_pidx(fn_pnames[tidx], slot)
        if pidx >= 0 {
          match fn_called_ret_depths.get(cname + "|" + pidx.to_string()) {
            Some(ds) => {
              let mut di = 0
              while di < ds.length() {
                if !seen.contains(ds[di]) {
                  seen.set(ds[di], true)
                  out_depths.push(ds[di])
                }
                di = di + 1
              }
            }
            None => ()
          }
        }
      }
      None => ()
    }
  }
}

///|
pub fn compute_const_init_plan_from_sigs(file_sigs : Array[String]) -> ConstInitPlan {
  let local_enums : Map[String, Bool] = Map([])
  let local_enum_variants : Map[String, Bool] = Map([])
  let local_enum_qual_variants : Map[String, Bool] = Map([])
  let local_non_enum_types : Map[String, Bool] = Map([])
  let fn_field_names : Map[String, Bool] = Map([])
  let trait_method_names : Map[String, Bool] = Map([])
  let cf_alias_lhs : Array[String] = []
  let cf_alias_rhs : Array[String] = []
  let cf_spread_lhs : Array[String] = []
  let cf_spread_base : Array[String] = []
  let cf_spread_expl : Array[Array[String]] = []
  let fw_entry_fn : Array[String] = []
  let fw_entry_tf : Array[String] = []
  let fw_entry_targets : Array[Array[String]] = []
  let fp_entry_fn : Array[String] = []
  let fp_entry_tf : Array[String] = []
  let fp_entry_targets : Array[Array[String]] = []
  let all_tf_seen : Map[String, Bool] = Map([])
  let all_tf_keys : Array[String] = []
  let field_wp_fn : Array[String] = []
  let field_wp_pidx : Array[String] = []
  let field_wp_field : Array[String] = []
  let field_pp_fn : Array[String] = []
  let field_pp_pidx : Array[String] = []
  let field_pp_field : Array[String] = []
  let extern_fns : Map[String, Bool] = Map([])
  let const_names : Array[String] = []
  let const_idents : Array[Array[String]] = []
  let const_calls : Array[Array[String]] = []
  let const_idx : Map[String, Int] = Map([])
  let fn_keys : Array[String] = []
  let fn_idents : Array[Array[String]] = []
  let fn_calls : Array[Array[String]] = []
  let fn_pnames : Array[Array[String]] = []
  let fn_called_params : Array[Map[Int, Bool]] = []
  let fn_fwd_edges : Array[Array[String]] = []
  let fn_aliases : Map[String, String] = Map([])
  let fn_alias_keys : Array[String] = []
  let fn_slots : Map[String, Array[String]] = Map([])
  let fn_slot_keys : Array[String] = []
  let fn_unknown_callp : Map[String, Bool] = Map([])
  let fn_mut_writes : Map[String, Array[String]] = Map([])
  let mut_fwd_fn : Array[String] = []
  let mut_fwd_pidx : Array[Int] = []
  let mut_fwd_callee : Array[String] = []
  let mut_fwd_cslot : Array[String] = []
  let mut_link_slot : Array[String] = []
  let mut_link_callee : Array[String] = []
  let mut_link_cslot : Array[String] = []
  let cb_mw_cb : Array[String] = []
  let cb_mw_owner : Array[String] = []
  let cb_mw_pidx : Array[Int] = []
  let cb_mw_targets : Array[Array[String]] = []
  let cb_mf_cb : Array[String] = []
  let cb_mf_owner : Array[String] = []
  let cb_mf_pidx : Array[Int] = []
  let cb_mf_callee : Array[String] = []
  let cb_mf_cslot : Array[String] = []
  let cb_mf_active : Array[Bool] = []
  let cb_mc_cb : Array[String] = []
  let cb_mc_owner : Array[String] = []
  let cb_mc_pidx : Array[Int] = []
  let cb_pf_cb : Array[String] = []
  let cb_pf_owner : Array[String] = []
  let cb_pf_pidx : Array[Int] = []
  let cb_pf_callee : Array[String] = []
  let cb_pf_slot : Array[String] = []
  let fn_key_idx : Map[String, Int] = Map([])
  let method_name_to_idxs : Map[String, Array[Int]] = Map([])
  let fdef_fn : Array[String] = []
  let fdef_param_idx : Array[Int] = []
  let fdef_param_name : Array[String] = []
  let fdef_idents : Array[Array[String]] = []
  let fdef_calls : Array[Array[String]] = []
  let fdef_by_fn : Map[String, Array[Int]] = Map([])
  let fdef_by_method : Map[String, Array[Int]] = Map([])
  let fdef_id_by_key : Map[String, Int] = Map([])
  let fdef_cb_targets : Map[String, Array[String]] = Map([])
  let fdef_pcalls : Map[String, Array[Int]] = Map([])
  let fdef_fwds : Map[String, Array[String]] = Map([])
  let fdef_fwd_keys : Array[String] = []

  let mut fi = 0
  while fi < file_sigs.length() {
    let lines = split_lines(file_sigs[fi])
    let mut li = 0
    while li < lines.length() {
      let line = lines[li]
      if !starts_with_str(line, "#") || starts_with_str(line, "#derive(") {
        let mut s = line
        if starts_with_str(s, "#derive(Eq) ") {
          s = slice_str(s, 12, s.length())
        }
        if starts_with_str(s, "pub ") {
          s = slice_str(s, 4, s.length())
        }
        if starts_with_str(s, "val ") {
          s = slice_str(s, 4, s.length())
        }
        if starts_with_str(s, "enum ") {
          let eend = sig_scan_ident_end(s, 5)
          if eend > 5 {
            let ename = slice_str(s, 5, eend)
            local_enums.set(ename, true)
            let lb = sig_find_char(s, 123, eend)
            let rb = sig_find_char(s, 125, if lb >= 0 { lb + 1 } else { eend })
            if lb >= 0 && rb > lb {
              let mut pos = lb + 1
              while pos < rb {
                while pos < rb && (str_code_at(s, pos) == 32 || str_code_at(s, pos) == 59) {
                  pos = pos + 1
                }
                if pos >= rb {
                  break
                }
                let vend = sig_scan_ident_end(s, pos)
                if vend > pos {
                  let vname = slice_str(s, pos, vend)
                  local_enum_variants.set(vname, true)
                  local_enum_qual_variants.set(ename + "::" + vname, true)
                }
                let next_semi = sig_find_char(s, 59, pos)
                if next_semi < 0 || next_semi >= rb {
                  break
                }
                pos = next_semi + 1
              }
            }
          }
        } else if starts_with_str(s, "struct ") {
          let send = sig_scan_ident_end(s, 7)
          if send > 7 {
            local_non_enum_types.set(slice_str(s, 7, send), true)
          }
          let lb = sig_find_char(s, 123, send)
          let tparams : Map[String, Bool] = Map([])
          if lb > send {
            let lbr = sig_find_char(s, 91, send)
            let rbr = sig_find_char(s, 93, if lbr >= 0 { lbr + 1 } else { send })
            if lbr >= send && rbr > lbr && rbr < lb {
              let mut tp = lbr + 1
              while tp < rbr {
                let c = str_code_at(s, tp)
                if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
                  let te = sig_scan_ident_end(s, tp)
                  if te > tp {
                    tparams.set(slice_str(s, tp, te), true)
                    tp = te
                  } else {
                    tp = tp + 1
                  }
                } else {
                  tp = tp + 1
                }
              }
            }
          }
          let rb = sig_find_char(s, 125, if lb >= 0 { lb + 1 } else { send })
          if lb >= 0 && rb > lb {
            let mut pos = lb + 1
            while pos < rb {
              while pos < rb && (str_code_at(s, pos) == 32 || str_code_at(s, pos) == 59) {
                pos = pos + 1
              }
              if pos >= rb {
                break
              }
              let ns = sig_find_char(s, 59, pos)
              let seg_end = if ns < 0 || ns > rb { rb } else { ns }
              let mut fpos = pos
              if fpos + 5 <= seg_end && slice_str(s, fpos, fpos + 5) == "priv " {
                fpos = fpos + 5
              }
              if fpos + 4 <= seg_end && slice_str(s, fpos, fpos + 4) == "mut " {
                fpos = fpos + 4
              }
              let fend = sig_scan_ident_end(s, fpos)
              if fend > fpos {
                let mut scan = fend
                let mut has_fn_ty = false
                while scan < seg_end {
                  if scan + 1 < seg_end && str_code_at(s, scan) == 45 && str_code_at(s, scan + 1) == 62 {
                    has_fn_ty = true
                    break
                  }
                  let c = str_code_at(s, scan)
                  if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 {
                    let id_end = sig_scan_ident_end(s, scan)
                    if id_end > scan {
                      if tparams.contains(slice_str(s, scan, id_end)) {
                        has_fn_ty = true
                        break
                      }
                      scan = id_end
                    } else {
                      scan = scan + 1
                    }
                  } else {
                    scan = scan + 1
                  }
                }
                if has_fn_ty {
                  fn_field_names.set(slice_str(s, fpos, fend), true)
                }
              }
              if seg_end >= rb {
                break
              }
              pos = seg_end + 1
            }
          }
        } else if starts_with_str(s, "trait ") {
          let tend = sig_scan_ident_end(s, 6)
          if tend > 6 {
            local_non_enum_types.set(slice_str(s, 6, tend), true)
          }
          let lb = sig_find_char(s, 123, tend)
          let rb = sig_find_char(s, 125, if lb >= 0 { lb + 1 } else { tend })
          if lb >= 0 && rb > lb {
            let mut pos = lb + 1
            while pos < rb {
              while pos < rb && (str_code_at(s, pos) == 32 || str_code_at(s, pos) == 59) {
                pos = pos + 1
              }
              if pos >= rb {
                break
              }
              let mend = sig_scan_ident_end(s, pos)
              if mend > pos {
                trait_method_names.set(slice_str(s, pos, mend), true)
              }
              let next_semi = sig_find_char(s, 59, pos)
              if next_semi < 0 || next_semi >= rb {
                break
              }
              pos = next_semi + 1
            }
          }
        } else if starts_with_str(s, "extern ") {
          let fn_pos = sig_find_char(s, 102, 7)
          if fn_pos >= 7 &&
            fn_pos + 3 < s.length() &&
            slice_str(s, fn_pos, fn_pos + 3) == "fn " {
            let efend = sig_scan_ident_end(s, fn_pos + 3)
            if efend > fn_pos + 3 {
              extern_fns.set(slice_str(s, fn_pos + 3, efend), true)
            }
          }
        }
      }
      if starts_with_str(line, "#cdep ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let cname = slice_str(line, 6, p1)
            let id_s = slice_str(line, p1 + 1, p2)
            let ca_s = slice_str(line, p2 + 1, line.length())
            if !const_idx.contains(cname) {
              let idx = const_names.length()
              const_idx.set(cname, idx)
              const_names.push(cname)
              const_idents.push(sig_split_csv(id_s))
              const_calls.push(sig_split_csv(ca_s))
            }
          }
        }
      } else if starts_with_str(line, "#fdep ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let fkey = slice_str(line, 6, p1)
            let id_s = slice_str(line, p1 + 1, p2)
            let ca_s = slice_str(line, p2 + 1, line.length())
            let id_arr = sig_split_csv(id_s)
            let ca_arr = sig_split_csv(ca_s)
            match fn_key_idx.get(fkey) {
              Some(existing) => {
                let mut k = 0
                while k < id_arr.length() {
                  fn_idents[existing].push(id_arr[k])
                  k = k + 1
                }
                k = 0
                while k < ca_arr.length() {
                  fn_calls[existing].push(ca_arr[k])
                  k = k + 1
                }
              }
              None => {
                let idx = fn_keys.length()
                fn_key_idx.set(fkey, idx)
                fn_keys.push(fkey)
                fn_idents.push(id_arr)
                fn_calls.push(ca_arr)
                fn_pnames.push([])
                fn_called_params.push(Map([]))
                fn_fwd_edges.push([])
                if starts_with_str(fkey, "$slot_") || starts_with_str(fkey, "$cslot_") {
                  fn_unknown_callp.set(fkey, true)
                }
                // If `Type::method`, index under `.method` for instance method calls
                let sep = sig_find_char(fkey, 58, 0)
                if sep > 0 && sep + 2 < fkey.length() && str_code_at(fkey, sep + 1) == 58 {
                  let mk = "." + slice_str(fkey, sep + 2, fkey.length())
                  match method_name_to_idxs.get(mk) {
                    Some(arr) => arr.push(idx)
                    None => method_name_to_idxs.set(mk, [idx])
                  }
                }
              }
            }
          }
        }
      } else if starts_with_str(line, "#cfdef ") {
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 {
          let cf_name = slice_str(line, 7, p1)
          let ca_s = slice_str(line, p1 + 1, line.length())
          let ca_arr = sig_split_csv(ca_s)
          let fkey = "cf:" + cf_name
          let dot = sig_find_char(cf_name, 46, 0)
          if dot > 0 && dot + 1 < cf_name.length() {
            let fname = slice_str(cf_name, dot + 1, cf_name.length())
            if fname != "*" {
              fn_field_names.set(fname, true)
            }
          }
          match fn_key_idx.get(fkey) {
            Some(existing) => {
              let mut k = 0
              while k < ca_arr.length() {
                fn_calls[existing].push(ca_arr[k])
                k = k + 1
              }
            }
            None => {
              let idx = fn_keys.length()
              fn_key_idx.set(fkey, idx)
              fn_keys.push(fkey)
              fn_idents.push([])
              fn_calls.push(ca_arr)
              fn_pnames.push([])
              fn_called_params.push(Map([]))
              fn_fwd_edges.push([])
            }
          }
        }
      } else if starts_with_str(line, "#cfalias ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 && p1 + 1 < line.length() {
          cf_alias_lhs.push(slice_str(line, 9, p1))
          cf_alias_rhs.push(slice_str(line, p1 + 1, line.length()))
        }
      } else if starts_with_str(line, "#cfspread ") {
        let p1 = sig_find_char(line, 124, 10)
        if p1 > 10 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            cf_spread_lhs.push(slice_str(line, 10, p1))
            cf_spread_base.push(slice_str(line, p1 + 1, p2))
            cf_spread_expl.push(sig_split_csv(slice_str(line, p2 + 1, line.length())))
          }
        }
      } else if starts_with_str(line, "#fret ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let rkey = "$ret:" + slice_str(line, 6, p1)
          let rarr = sig_split_csv(slice_str(line, p1 + 1, line.length()))
          match fn_key_idx.get(rkey) {
            Some(existing) => sig_union_str_array(fn_calls[existing], rarr)
            None => {
              let idx = fn_keys.length()
              fn_key_idx.set(rkey, idx)
              fn_keys.push(rkey)
              fn_idents.push([])
              fn_calls.push(rarr)
              fn_pnames.push([])
              fn_called_params.push(Map([]))
              fn_fwd_edges.push([])
            }
          }
        }
      } else if starts_with_str(line, "#fieldw ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let wfn = slice_str(line, 8, p1)
            let tf_key = slice_str(line, p1 + 1, p2)
            let warr = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            if warr.length() > 0 {
              fw_entry_fn.push(wfn)
              fw_entry_tf.push(tf_key)
              fw_entry_targets.push(warr)
              if !all_tf_seen.contains(tf_key) {
                all_tf_seen.set(tf_key, true)
                all_tf_keys.push(tf_key)
              }
            }
          }
        }
      } else if starts_with_str(line, "#fieldp ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let wfn = slice_str(line, 8, p1)
            let tf_key = slice_str(line, p1 + 1, p2)
            let parr = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            if parr.length() > 0 {
              fp_entry_fn.push(wfn)
              fp_entry_tf.push(tf_key)
              fp_entry_targets.push(parr)
              if !all_tf_seen.contains(tf_key) {
                all_tf_seen.set(tf_key, true)
                all_tf_keys.push(tf_key)
              }
            }
          }
        }
      } else if starts_with_str(line, "#fieldwp ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 && p2 + 1 < line.length() {
            let tf_key = slice_str(line, p2 + 1, line.length())
            field_wp_fn.push(slice_str(line, 9, p1))
            field_wp_pidx.push(slice_str(line, p1 + 1, p2))
            field_wp_field.push(tf_key)
            if !all_tf_seen.contains(tf_key) {
              all_tf_seen.set(tf_key, true)
              all_tf_keys.push(tf_key)
            }
          }
        }
      } else if starts_with_str(line, "#fieldpp ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 && p2 + 1 < line.length() {
            let tf_key = slice_str(line, p2 + 1, line.length())
            field_pp_fn.push(slice_str(line, 9, p1))
            field_pp_pidx.push(slice_str(line, p1 + 1, p2))
            field_pp_field.push(tf_key)
            if !all_tf_seen.contains(tf_key) {
              all_tf_seen.set(tf_key, true)
              all_tf_keys.push(tf_key)
            }
          }
        }
      } else if starts_with_str(line, "#fcallp ") {
        // #fcallp <fn_key>|<pnames_csv>|<direct_pidx_csv>|<fwd_csv>
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 {
              let fkey = slice_str(line, 8, p1)
              let pn_arr = sig_split_csv(slice_str(line, p1 + 1, p2))
              let dc_arr = sig_split_csv(slice_str(line, p2 + 1, p3))
              let fw_arr = sig_split_csv(slice_str(line, p3 + 1, line.length()))
              let idx = match fn_key_idx.get(fkey) {
                Some(existing) => existing
                None => {
                  let nidx = fn_keys.length()
                  fn_key_idx.set(fkey, nidx)
                  fn_keys.push(fkey)
                  fn_idents.push([])
                  fn_calls.push([])
                  fn_pnames.push([])
                  fn_called_params.push(Map([]))
                  fn_fwd_edges.push([])
                  let sep = sig_find_char(fkey, 58, 0)
                  if sep > 0 && sep + 2 < fkey.length() && str_code_at(fkey, sep + 1) == 58 {
                    let mk = "." + slice_str(fkey, sep + 2, fkey.length())
                    match method_name_to_idxs.get(mk) {
                      Some(arr) => arr.push(nidx)
                      None => method_name_to_idxs.set(mk, [nidx])
                    }
                  }
                  nidx
                }
              }
              if fn_pnames[idx].length() == 0 && pn_arr.length() > 0 {
                let mut k = 0
                while k < pn_arr.length() {
                  fn_pnames[idx].push(pn_arr[k])
                  k = k + 1
                }
              }
              let mut k = 0
              while k < dc_arr.length() {
                if sig_is_digits(dc_arr[k]) {
                  fn_called_params[idx].set(sig_parse_nonneg_int(dc_arr[k]), true)
                }
                k = k + 1
              }
              k = 0
              while k < fw_arr.length() {
                fn_fwd_edges[idx].push(fw_arr[k])
                k = k + 1
              }
            }
          }
        }
      } else if starts_with_str(line, "#falias ") {
        // #falias <alias_key>|<target_key>
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 && p1 + 1 < line.length() {
          let akey = slice_str(line, 8, p1)
          let atgt = slice_str(line, p1 + 1, line.length())
          if !fn_aliases.contains(akey) {
            fn_alias_keys.push(akey)
          }
          fn_aliases.set(akey, atgt)
        }
      } else if starts_with_str(line, "#fslot ") {
        // #fslot <slot_key>|<t1>,<t2>,...
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 && p1 + 1 < line.length() {
          let skey = slice_str(line, 7, p1)
          let tlist = sig_split_csv(slice_str(line, p1 + 1, line.length()))
          if !fn_slots.contains(skey) {
            fn_slot_keys.push(skey)
          }
          fn_slots.set(skey, tlist)
        }
      } else if starts_with_str(line, "#fmutw ") {
        // #fmutw <fn_key>|<pidx>|<t1>,<t2>,...
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 && p2 + 1 < line.length() {
            let fkey = slice_str(line, 7, p1)
            let pidx_s = slice_str(line, p1 + 1, p2)
            let tlist = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            let mw_key = fkey + "|" + pidx_s
            match fn_mut_writes.get(mw_key) {
              Some(cur) => sig_union_str_array(cur, tlist)
              None => fn_mut_writes.set(mw_key, tlist)
            }
          }
        }
      } else if starts_with_str(line, "#fmutfwd ") {
        // #fmutfwd <fn_key>|<pidx>|<callee>|<callee_slot>
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 && p3 + 1 < line.length() {
              mut_fwd_fn.push(slice_str(line, 9, p1))
              mut_fwd_pidx.push(sig_parse_nonneg_int(slice_str(line, p1 + 1, p2)))
              mut_fwd_callee.push(slice_str(line, p2 + 1, p3))
              mut_fwd_cslot.push(slice_str(line, p3 + 1, line.length()))
            }
          }
        }
      } else if starts_with_str(line, "#fmutlink ") {
        // #fmutlink <slot_key>|<callee>|<callee_slot>
        let p1 = sig_find_char(line, 124, 10)
        if p1 > 10 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 && p2 + 1 < line.length() {
            mut_link_slot.push(slice_str(line, 10, p1))
            mut_link_callee.push(slice_str(line, p1 + 1, p2))
            mut_link_cslot.push(slice_str(line, p2 + 1, line.length()))
          }
        }
      } else if starts_with_str(line, "#fcbw ") {
        // #fcbw <cb_key>|<owner_fn_key>|<pidx>|<t1>,<t2>,...
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 && p3 + 1 < line.length() {
              cb_mw_cb.push(slice_str(line, 6, p1))
              cb_mw_owner.push(slice_str(line, p1 + 1, p2))
              cb_mw_pidx.push(sig_parse_nonneg_int(slice_str(line, p2 + 1, p3)))
              cb_mw_targets.push(sig_split_csv(slice_str(line, p3 + 1, line.length())))
            }
          }
        }
      } else if starts_with_str(line, "#fcbfwd ") {
        // #fcbfwd <cb_key>|<owner_fn_key>|<pidx>|<callee>|<callee_slot>
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 {
              let p4 = sig_find_char(line, 124, p3 + 1)
              if p4 > p3 + 1 && p4 + 1 < line.length() {
                cb_mf_cb.push(slice_str(line, 8, p1))
                cb_mf_owner.push(slice_str(line, p1 + 1, p2))
                cb_mf_pidx.push(sig_parse_nonneg_int(slice_str(line, p2 + 1, p3)))
                cb_mf_callee.push(slice_str(line, p3 + 1, p4))
                cb_mf_cslot.push(slice_str(line, p4 + 1, line.length()))
                cb_mf_active.push(false)
              }
            }
          }
        }
      } else if starts_with_str(line, "#fcbcall ") {
        // #fcbcall <cb_key>|<owner_fn_key>|<pidx>
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 && p2 + 1 < line.length() {
            cb_mc_cb.push(slice_str(line, 9, p1))
            cb_mc_owner.push(slice_str(line, p1 + 1, p2))
            cb_mc_pidx.push(sig_parse_nonneg_int(slice_str(line, p2 + 1, line.length())))
          }
        }
      } else if starts_with_str(line, "#fcbcallfwd ") {
        // #fcbcallfwd <cb_key>|<owner_fn_key>|<pidx>|<callee>|<slot_key>
        let p1 = sig_find_char(line, 124, 12)
        if p1 > 12 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 {
              let p4 = sig_find_char(line, 124, p3 + 1)
              if p4 > p3 + 1 && p4 + 1 < line.length() {
                cb_pf_cb.push(slice_str(line, 12, p1))
                cb_pf_owner.push(slice_str(line, p1 + 1, p2))
                cb_pf_pidx.push(sig_parse_nonneg_int(slice_str(line, p2 + 1, p3)))
                cb_pf_callee.push(slice_str(line, p3 + 1, p4))
                cb_pf_slot.push(slice_str(line, p4 + 1, line.length()))
              }
            }
          }
        }
      } else if starts_with_str(line, "#fdef ") {
        // #fdef <fn_key>|<param_idx>|<param_name>|<idents>|<calls>
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 {
              let p4 = sig_find_char(line, 124, p3 + 1)
              if p4 > p3 {
                let fkey = slice_str(line, 6, p1)
                let pidx = sig_parse_nonneg_int(slice_str(line, p1 + 1, p2))
                let pname = slice_str(line, p2 + 1, p3)
                let id_s = slice_str(line, p3 + 1, p4)
                let ca_s = slice_str(line, p4 + 1, line.length())
                let didx = fdef_param_idx.length()
                fdef_fn.push(fkey)
                fdef_param_idx.push(pidx)
                fdef_param_name.push(pname)
                fdef_idents.push(sig_split_csv(id_s))
                fdef_calls.push(sig_split_csv(ca_s))
                fdef_id_by_key.set(fkey + "~" + pidx.to_string(), didx)
                match fdef_by_fn.get(fkey) {
                  Some(arr) => arr.push(didx)
                  None => fdef_by_fn.set(fkey, [didx])
                }
                let sep = sig_find_char(fkey, 58, 0)
                if sep > 0 && sep + 2 < fkey.length() && str_code_at(fkey, sep + 1) == 58 {
                  let mk = "." + slice_str(fkey, sep + 2, fkey.length())
                  match fdef_by_method.get(mk) {
                    Some(arr) => arr.push(didx)
                    None => fdef_by_method.set(mk, [didx])
                  }
                }
              }
            }
          }
        }
      } else if starts_with_str(line, "#fdefcb ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let fkey = slice_str(line, 8, p1)
            let pidx_s = slice_str(line, p1 + 1, p2)
            let dt = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            if dt.length() > 0 {
              let k = fkey + "|" + pidx_s
              match fdef_cb_targets.get(k) {
                Some(cur) => sig_union_str_array(cur, dt)
                None => fdef_cb_targets.set(k, dt)
              }
            }
          }
        }
      } else if starts_with_str(line, "#fdefpcall ") {
        let p1 = sig_find_char(line, 124, 11)
        if p1 > 11 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let fkey = slice_str(line, 11, p1)
            let pidx_s = slice_str(line, p1 + 1, p2)
            let ps = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            if ps.length() > 0 {
              let k = fkey + "|" + pidx_s
              let arr = match fdef_pcalls.get(k) {
                Some(cur) => cur
                None => {
                  let fresh : Array[Int] = []
                  fdef_pcalls.set(k, fresh)
                  fresh
                }
              }
              let mut psi = 0
              while psi < ps.length() {
                let pv = sig_parse_nonneg_int(ps[psi])
                let mut found = false
                let mut ai = 0
                while ai < arr.length() {
                  if arr[ai] == pv {
                    found = true
                    break
                  }
                  ai = ai + 1
                }
                if !found {
                  arr.push(pv)
                }
                psi = psi + 1
              }
            }
          }
        }
      } else if starts_with_str(line, "#fdeffwd ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let fkey = slice_str(line, 9, p1)
            let pidx_s = slice_str(line, p1 + 1, p2)
            let es = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            if es.length() > 0 {
              let k = fkey + "|" + pidx_s
              match fdef_fwds.get(k) {
                Some(cur) => sig_union_str_array(cur, es)
                None => {
                  fdef_fwds.set(k, es)
                  fdef_fwd_keys.push(k)
                }
              }
            }
          }
        }
      }
      li = li + 1
    }
    fi = fi + 1
  }

  // Propagate `#cfalias C|other` and `#cfspread C|base|explicit` to a fixed point
  if cf_alias_lhs.length() > 0 || cf_spread_lhs.length() > 0 {
    let mut cf_changed = true
    while cf_changed {
      cf_changed = false
      let mut ai = 0
      while ai < cf_alias_lhs.length() {
        let lhs_c = cf_alias_lhs[ai]
        let rhs_prefix = "cf:" + cf_alias_rhs[ai] + "."
        let n_cur = fn_keys.length()
        let mut ki = 0
        while ki < n_cur {
          let rk = fn_keys[ki]
          if starts_with_str(rk, rhs_prefix) {
            let suffix = slice_str(rk, rhs_prefix.length(), rk.length())
            let lk = "cf:" + lhs_c + "." + suffix
            match fn_key_idx.get(lk) {
              Some(lidx) => {
                let mut has_rk = false
                let mut ci = 0
                while ci < fn_calls[lidx].length() {
                  if fn_calls[lidx][ci] == rk {
                    has_rk = true
                    break
                  }
                  ci = ci + 1
                }
                if !has_rk {
                  fn_calls[lidx].push(rk)
                  cf_changed = true
                }
              }
              None => {
                let idx = fn_keys.length()
                fn_key_idx.set(lk, idx)
                fn_keys.push(lk)
                fn_idents.push([])
                fn_calls.push([rk])
                fn_pnames.push([])
                fn_called_params.push(Map([]))
                fn_fwd_edges.push([])
                cf_changed = true
              }
            }
          }
          ki = ki + 1
        }
        ai = ai + 1
      }
      let mut spi = 0
      while spi < cf_spread_lhs.length() {
        let lhs_c = cf_spread_lhs[spi]
        let base_prefix = "cf:" + cf_spread_base[spi] + "."
        let expl = cf_spread_expl[spi]
        let n_cur = fn_keys.length()
        let mut ki = 0
        while ki < n_cur {
          let rk = fn_keys[ki]
          if starts_with_str(rk, base_prefix) {
            let suffix = slice_str(rk, base_prefix.length(), rk.length())
            let mut is_overridden = false
            let mut ei = 0
            while ei < expl.length() {
              if expl[ei] == suffix {
                is_overridden = true
                break
              }
              ei = ei + 1
            }
            if !is_overridden {
              let lk = "cf:" + lhs_c + "." + suffix
              match fn_key_idx.get(lk) {
                Some(lidx) => {
                  let mut has_rk = false
                  let mut ci = 0
                  while ci < fn_calls[lidx].length() {
                    if fn_calls[lidx][ci] == rk {
                      has_rk = true
                      break
                    }
                    ci = ci + 1
                  }
                  if !has_rk {
                    fn_calls[lidx].push(rk)
                    cf_changed = true
                  }
                }
                None => {
                  let idx = fn_keys.length()
                  fn_key_idx.set(lk, idx)
                  fn_keys.push(lk)
                  fn_idents.push([])
                  fn_calls.push([rk])
                  fn_pnames.push([])
                  fn_called_params.push(Map([]))
                  fn_fwd_edges.push([])
                  cf_changed = true
                }
              }
            }
          }
          ki = ki + 1
        }
        spi = spi + 1
      }
    }
  }

  // Propagate `#fieldwp` / `#fieldpp` across `fn_fwd_edges` (supporting named slots)
  // and from call sites into `field_writes_by_name` / `field_puts_by_name`
  if field_wp_fn.length() > 0 || field_pp_fn.length() > 0 {
    let field_wp_seen : Map[String, Bool] = Map([])
    let mut i0 = 0
    while i0 < field_wp_fn.length() {
      field_wp_seen.set(field_wp_fn[i0] + "|" + field_wp_pidx[i0] + "|" + field_wp_field[i0], true)
      i0 = i0 + 1
    }
    let field_pp_seen : Map[String, Bool] = Map([])
    i0 = 0
    while i0 < field_pp_fn.length() {
      field_pp_seen.set(field_pp_fn[i0] + "|" + field_pp_pidx[i0] + "|" + field_pp_field[i0], true)
      i0 = i0 + 1
    }
    let mut fp_fwd_changed = true
    while fp_fwd_changed {
      fp_fwd_changed = false
      let mut fi2 = 0
      while fi2 < fn_keys.length() {
        let outer_fn = fn_keys[fi2]
        let edges = fn_fwd_edges[fi2]
        let mut ei2 = 0
        while ei2 < edges.length() {
          let edge = edges[ei2]
          let g1 = sig_find_char(edge, 62, 0)
          if g1 > 0 {
            let g2 = sig_find_char(edge, 62, g1 + 1)
            if g2 > g1 + 1 && g2 + 1 < edge.length() {
              let my_pidx_s = slice_str(edge, 0, g1)
              let tgt = slice_str(edge, g1 + 1, g2)
              let slot = slice_str(edge, g2 + 1, edge.length())
              let tgt_pidxs = sig_fwd_edge_target_pidxs(
                tgt,
                slot,
                fn_key_idx,
                fn_pnames,
                fdef_by_fn,
                fdef_by_method,
                fdef_fn,
                fdef_param_idx,
                fdef_param_name,
                fdef_cb_targets,
                fdef_pcalls,
              )
              let mut tpi = 0
              while tpi < tgt_pidxs.length() {
                let tgt_pidx_s = tgt_pidxs[tpi].to_string()
                let mut wi = 0
                while wi < field_wp_fn.length() {
                  if field_wp_fn[wi] == tgt && field_wp_pidx[wi] == tgt_pidx_s {
                    let nk = outer_fn + "|" + my_pidx_s + "|" + field_wp_field[wi]
                    if !field_wp_seen.contains(nk) {
                      field_wp_seen.set(nk, true)
                      field_wp_fn.push(outer_fn)
                      field_wp_pidx.push(my_pidx_s)
                      field_wp_field.push(field_wp_field[wi])
                      fp_fwd_changed = true
                    }
                  }
                  wi = wi + 1
                }
                let mut pi2 = 0
                while pi2 < field_pp_fn.length() {
                  if field_pp_fn[pi2] == tgt && field_pp_pidx[pi2] == tgt_pidx_s {
                    let nk = outer_fn + "|" + my_pidx_s + "|" + field_pp_field[pi2]
                    if !field_pp_seen.contains(nk) {
                      field_pp_seen.set(nk, true)
                      field_pp_fn.push(outer_fn)
                      field_pp_pidx.push(my_pidx_s)
                      field_pp_field.push(field_pp_field[pi2])
                      fp_fwd_changed = true
                    }
                  }
                  pi2 = pi2 + 1
                }
                tpi = tpi + 1
              }
            }
          }
          ei2 = ei2 + 1
        }
        fi2 = fi2 + 1
      }
    }
  }

  // Scan call lists to discover referenced `fw:<tf>`, `fp:<tf>`, and `cf?:<C>.<m>#<tf>` keys,
  // pre-create empty `fw:<tf>` / `fp:<tf>` nodes (populated dynamically by reachability in `outer_mw_changed`),
  // and resolve `cf?:<C>.<m>#<tf>` nodes.
  let cfq_lists : Array[Array[String]] = []
  let mut qi = 0
  while qi < const_calls.length() {
    cfq_lists.push(const_calls[qi])
    qi = qi + 1
  }
  qi = 0
  while qi < fn_calls.length() {
    cfq_lists.push(fn_calls[qi])
    qi = qi + 1
  }
  qi = 0
  while qi < fdef_calls.length() {
    cfq_lists.push(fdef_calls[qi])
    qi = qi + 1
  }
  qi = 0
  while qi < cfq_lists.length() {
    let cs = cfq_lists[qi]
    let mut cj = 0
    while cj < cs.length() {
      let desc = sig_parse_call_desc(cs[cj])
      let qkey = desc.target
      if starts_with_str(qkey, "fw:") || starts_with_str(qkey, "fp:") {
        let tfk = slice_str(qkey, 3, qkey.length())
        if tfk.length() > 0 && !all_tf_seen.contains(tfk) {
          all_tf_seen.set(tfk, true)
          all_tf_keys.push(tfk)
        }
      } else if starts_with_str(qkey, "cf?:") && !fn_key_idx.contains(qkey) {
        let rest = slice_str(qkey, 4, qkey.length())
        let hash = sig_find_char(rest, 35, 0)
        let cm_part = if hash > 0 { slice_str(rest, 0, hash) } else { rest }
        let dot = sig_find_char(cm_part, 46, 0)
        if dot > 0 && dot + 1 < cm_part.length() {
          let cname = slice_str(cm_part, 0, dot)
          let fname = slice_str(cm_part, dot + 1, cm_part.length())
          let tfk = if hash > 0 && hash + 1 < rest.length() {
            slice_str(rest, hash + 1, rest.length())
          } else {
            fname
          }
          if !all_tf_seen.contains(tfk) {
            all_tf_seen.set(tfk, true)
            all_tf_keys.push(tfk)
          }
          let cf_key = "cf:" + cname + "." + fname
          let cf_star = "cf:" + cname + ".*"
          let qcalls : Array[String] = []
          if fn_key_idx.contains(cf_key) {
            qcalls.push(cf_key)
            match fn_key_idx.get(cf_star) {
              Some(sidx) => {
                let mut si = 0
                while si < fn_calls[sidx].length() {
                  if fn_calls[sidx][si] == "$fp" {
                    qcalls.push("fp:" + tfk)
                    qcalls.push("?")
                    break
                  }
                  si = si + 1
                }
              }
              None => ()
            }
          } else {
            qcalls.push("fp:" + tfk)
            qcalls.push("?")
          }
          let idx = fn_keys.length()
          fn_key_idx.set(qkey, idx)
          fn_keys.push(qkey)
          fn_idents.push([])
          fn_calls.push(qcalls)
          fn_pnames.push([])
          fn_called_params.push(Map([]))
          fn_fwd_edges.push([])
        }
      }
      cj = cj + 1
    }
    qi = qi + 1
  }

  // Pre-create empty `fw:<tf>` and `fp:<tf>` nodes (without `fn_unknown_callp` until populated)
  let mut tfi = 0
  while tfi < all_tf_keys.length() {
    let tfk = all_tf_keys[tfi]
    let fw_key = "fw:" + tfk
    if !fn_key_idx.contains(fw_key) {
      let idx = fn_keys.length()
      fn_key_idx.set(fw_key, idx)
      fn_keys.push(fw_key)
      fn_idents.push([])
      fn_calls.push([])
      fn_pnames.push([])
      fn_called_params.push(Map([]))
      fn_fwd_edges.push([])
    }
    let fp_key = "fp:" + tfk
    if !fn_key_idx.contains(fp_key) {
      let idx = fn_keys.length()
      fn_key_idx.set(fp_key, idx)
      fn_keys.push(fp_key)
      fn_idents.push([])
      fn_calls.push([])
      fn_pnames.push([])
      fn_called_params.push(Map([]))
      fn_fwd_edges.push([])
    }
    tfi = tfi + 1
  }

  // Discover all `$ret:*` and `$retp:*` keys from call lists and `#fieldw`/`#fieldp` entries
  // and pre-create empty nodes (without `fn_unknown_callp` until populated).
  // Context-sensitive `$retp:` depths are tracked per `(fn_key|pidx)` in `fn_called_ret_depths`
  // (mirroring `#fcallp`, never merging arguments across distinct callers).
  let fn_called_ret_depths : Map[String, Array[Int]] = Map([])
  let fn_any_ret_depth : Map[String, Bool] = Map([])
  let ret_scan_lists : Array[Array[String]] = []
  let mut rsi = 0
  while rsi < cfq_lists.length() {
    ret_scan_lists.push(cfq_lists[rsi])
    rsi = rsi + 1
  }
  rsi = 0
  while rsi < fw_entry_targets.length() {
    ret_scan_lists.push(fw_entry_targets[rsi])
    rsi = rsi + 1
  }
  rsi = 0
  while rsi < fp_entry_targets.length() {
    ret_scan_lists.push(fp_entry_targets[rsi])
    rsi = rsi + 1
  }
  rsi = 0
  while rsi < ret_scan_lists.length() {
    let cs = ret_scan_lists[rsi]
    let mut cj = 0
    while cj < cs.length() {
      let desc = sig_parse_call_desc(cs[cj])
      let cands : Array[String] = [desc.target]
      let mut bi = 0
      while bi < desc.cb_targets.length() {
        cands.push(desc.cb_targets[bi])
        bi = bi + 1
      }
      let mut ci2 = 0
      while ci2 < cands.length() {
        let rk = cands[ci2]
        if (starts_with_str(rk, "$ret:") || starts_with_str(rk, "$retp:")) &&
          !fn_key_idx.contains(rk) {
          let idx = fn_keys.length()
          fn_key_idx.set(rk, idx)
          fn_keys.push(rk)
          fn_idents.push([])
          fn_calls.push([])
          fn_pnames.push([])
          fn_called_params.push(Map([]))
          fn_fwd_edges.push([])
        }
        ci2 = ci2 + 1
      }
      cj = cj + 1
    }
    rsi = rsi + 1
  }

  // Register `cf:*`, `cf?:*`, and `$ret:*` nodes into `fn_slots` so `#fcallp` and `fn_unknown_callp`
  // propagate cleanly through `#cfdef`, `#cfalias`, `#cfspread`, and `#fret` chains.
  let mut cfi = 0
  while cfi < fn_keys.length() {
    let fkey = fn_keys[cfi]
    if starts_with_str(fkey, "cf:") ||
      starts_with_str(fkey, "cf?:") ||
      starts_with_str(fkey, "$ret:") {
      let ctargets = fn_calls[cfi]
      if ctargets.length() > 0 {
        fn_unknown_callp.set(fkey, true)
        if !fn_slots.contains(fkey) {
          fn_slot_keys.push(fkey)
          fn_slots.set(fkey, ctargets)
        }
      }
    }
    cfi = cfi + 1
  }

  let n_consts = const_names.length()
  if n_consts == 0 {
    return ConstInitPlan::{
      order: [],
      has_cycle: false,
      cycle_path: [],
      plan_hash: "",
      has_ambiguous_method: false,
    }
  }

  // Fixed-point propagation of reachable same-package top-level `let` reads across
  // functions and default-argument expressions.
  // Function self-recursion / mutual recursion converges without creating a constant cycle.
  let mut n_fns = fn_keys.length()
  let n_fdefs = fdef_param_idx.length()

  // Resolve `#falias <alias>|<target>` chains to local functions or mark unknown_callp
  let alias_src_idxs : Array[Int] = []
  let alias_dst_idxs : Array[Int] = []
  let mut ali = 0
  while ali < fn_alias_keys.length() {
    let akey = fn_alias_keys[ali]
    let visited : Map[String, Bool] = Map([])
    visited.set(akey, true)
    let mut cur = match fn_aliases.get(akey) {
      Some(t) => t
      None => ""
    }
    let mut cyc = false
    while cur != "" && fn_aliases.contains(cur) {
      if visited.contains(cur) {
        cyc = true
        break
      }
      visited.set(cur, true)
      cur = match fn_aliases.get(cur) {
        Some(t) => t
        None => ""
      }
    }
    if cyc || cur == "" {
      fn_unknown_callp.set(akey, true)
    } else {
      match fn_key_idx.get(cur) {
        Some(tidx) =>
          match fn_key_idx.get(akey) {
            Some(aidx) => {
              alias_src_idxs.push(aidx)
              alias_dst_idxs.push(tidx)
              if fn_pnames[aidx].length() == 0 && fn_pnames[tidx].length() > 0 {
                let mut pi = 0
                while pi < fn_pnames[tidx].length() {
                  fn_pnames[aidx].push(fn_pnames[tidx][pi])
                  pi = pi + 1
                }
              }
            }
            None => fn_unknown_callp.set(akey, true)
          }
        None => fn_unknown_callp.set(akey, true)
      }
    }
    ali = ali + 1
  }

  // Resolve exact `#fslot <slot_key>|<t1>,<t2>,...` to a fixed point (handles chained
  // `let mut f1 = ignore1; let mut f2 = f1`): clear `fn_unknown_callp` only when
  // every target in the slot is a known local function (not unknown_callp), and merge
  // their parameter names & called-param sets in the fixed-point loop.
  let slot_src_idxs : Array[Int] = []
  let slot_dst_idxs : Array[Int] = []
  let slot_resolved : Map[String, Bool] = Map([])
  let mut slot_resolved_changed = true
  while slot_resolved_changed {
    slot_resolved_changed = false
    let mut sli = 0
    while sli < fn_slot_keys.length() {
      let skey = fn_slot_keys[sli]
      if !slot_resolved.contains(skey) {
        let tlist = match fn_slots.get(skey) {
          Some(a) => a
          None => []
        }
        match fn_key_idx.get(skey) {
          Some(sidx) =>
            if tlist.length() > 0 {
              let mut all_known = true
              let resolved_ts : Array[Int] = []
              let mut ti = 0
              while ti < tlist.length() {
                let tk = tlist[ti]
                let is_unk = match fn_unknown_callp.get(tk) {
                  Some(true) => true
                  _ => false
                }
                if is_unk {
                  all_known = false
                  break
                }
                match fn_key_idx.get(tk) {
                  Some(tidx) => resolved_ts.push(tidx)
                  None => {
                    all_known = false
                    break
                  }
                }
                ti = ti + 1
              }
              if all_known {
                slot_resolved.set(skey, true)
                fn_unknown_callp.set(skey, false)
                slot_resolved_changed = true
                ti = 0
                while ti < resolved_ts.length() {
                  let tidx = resolved_ts[ti]
                  slot_src_idxs.push(sidx)
                  slot_dst_idxs.push(tidx)
                  if fn_pnames[sidx].length() == 0 && fn_pnames[tidx].length() > 0 {
                    let mut pi = 0
                    while pi < fn_pnames[tidx].length() {
                      fn_pnames[sidx].push(fn_pnames[tidx][pi])
                      pi = pi + 1
                    }
                  }
                  ti = ti + 1
                }
              }
            }
          None => ()
        }
      }
      sli = sli + 1
    }
  }

  // Fixed-point propagation of `#fcallp`: which parameters of each function are
  // actually invoked (directly, via `#falias` / `#fslot`, or forwarded to a callee's invoked parameter).
  let mut cp_changed = true
  while cp_changed {
    cp_changed = false
    let mut ai2 = 0
    while ai2 < alias_src_idxs.length() {
      let aidx = alias_src_idxs[ai2]
      let tidx = alias_dst_idxs[ai2]
      let tkeys = fn_called_params[tidx].keys()
      let mut ki = 0
      while ki < tkeys.length() {
        let p = tkeys[ki]
        if !fn_called_params[aidx].contains(p) {
          fn_called_params[aidx].set(p, true)
          cp_changed = true
        }
        ki = ki + 1
      }
      ai2 = ai2 + 1
    }
    let mut si2 = 0
    while si2 < slot_src_idxs.length() {
      let sidx = slot_src_idxs[si2]
      let tidx = slot_dst_idxs[si2]
      let tkeys = fn_called_params[tidx].keys()
      let mut ki = 0
      while ki < tkeys.length() {
        let p = tkeys[ki]
        if !fn_called_params[sidx].contains(p) {
          fn_called_params[sidx].set(p, true)
          cp_changed = true
        }
        ki = ki + 1
      }
      si2 = si2 + 1
    }
    let mut fi2 = 0
    while fi2 < n_fns {
      let edges = fn_fwd_edges[fi2]
      let mut ei = 0
      while ei < edges.length() {
        let edge = edges[ei]
        let g1 = sig_find_char(edge, 62, 0)
        if g1 > 0 {
          let g2 = sig_find_char(edge, 62, g1 + 1)
          if g2 > g1 + 1 && g2 + 1 < edge.length() {
            let my_pidx = sig_parse_nonneg_int(slice_str(edge, 0, g1))
            if !fn_called_params[fi2].contains(my_pidx) {
              let tgt = slice_str(edge, g1 + 1, g2)
              let slot = slice_str(edge, g2 + 1, edge.length())
              if sig_fwd_edge_is_called(
                tgt,
                slot,
                fn_keys,
                fn_key_idx,
                method_name_to_idxs,
                fn_pnames,
                fn_called_params,
                fn_unknown_callp,
                fdef_by_fn,
                fdef_by_method,
                fdef_fn,
                fdef_param_idx,
                fdef_param_name,
                fdef_cb_targets,
                fdef_pcalls,
              ) {
                fn_called_params[fi2].set(my_pidx, true)
                cp_changed = true
              }
            }
          }
        }
        ei = ei + 1
      }
      fi2 = fi2 + 1
    }
    let mut dfki = 0
    while dfki < fdef_fwd_keys.length() {
      let dkey = fdef_fwd_keys[dfki]
      match fdef_fwds.get(dkey) {
        Some(edges) => {
          let mut ei = 0
          while ei < edges.length() {
            let edge = edges[ei]
            let g1 = sig_find_char(edge, 62, 0)
            if g1 > 0 {
              let g2 = sig_find_char(edge, 62, g1 + 1)
              if g2 > g1 + 1 && g2 + 1 < edge.length() {
                let src_pidx = sig_parse_nonneg_int(slice_str(edge, 0, g1))
                let tgt = slice_str(edge, g1 + 1, g2)
                let slot = slice_str(edge, g2 + 1, edge.length())
                if sig_fwd_edge_is_called(
                  tgt,
                  slot,
                  fn_keys,
                  fn_key_idx,
                  method_name_to_idxs,
                  fn_pnames,
                  fn_called_params,
                  fn_unknown_callp,
                  fdef_by_fn,
                  fdef_by_method,
                  fdef_fn,
                  fdef_param_idx,
                  fdef_param_name,
                  fdef_cb_targets,
                  fdef_pcalls,
                ) {
                  let arr = match fdef_pcalls.get(dkey) {
                    Some(cur) => cur
                    None => {
                      let fresh : Array[Int] = []
                      fdef_pcalls.set(dkey, fresh)
                      fresh
                    }
                  }
                  let mut has_p = false
                  let mut ai = 0
                  while ai < arr.length() {
                    if arr[ai] == src_pidx {
                      has_p = true
                      break
                    }
                    ai = ai + 1
                  }
                  if !has_p {
                    arr.push(src_pidx)
                    cp_changed = true
                  }
                }
              }
            }
            ei = ei + 1
          }
        }
        None => ()
      }
      dfki = dfki + 1
    }
  }

  // Fixed-point propagation of `#fmutw` / `#fmutfwd` / conditional `#fcbw` / `#fcbfwd` and `#fmutlink` -> slot call edges
  let called_fn_idxs : Map[Int, Bool] = Map([])
  let mut rci = 0
  while rci < const_calls.length() {
    let cs = const_calls[rci]
    let mut cj = 0
    while cj < cs.length() {
      let desc = sig_parse_call_desc(cs[cj])
      let cname = desc.target
      if starts_with_str(cname, ".") {
        match method_name_to_idxs.get(cname) {
          Some(tidxs) => {
            let mut ti = 0
            while ti < tidxs.length() {
              called_fn_idxs.set(tidxs[ti], true)
              ti = ti + 1
            }
          }
          None => ()
        }
      } else {
        match fn_key_idx.get(cname) {
          Some(ti) => called_fn_idxs.set(ti, true)
          None => ()
        }
      }
      let eff_slots : Array[String] = []
      let eff_targets : Array[String] = []
      sig_collect_call_effective_cbs(
        desc,
        fdef_by_fn,
        fdef_by_method,
        fdef_fn,
        fdef_param_idx,
        fdef_param_name,
        fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
        eff_slots,
        eff_targets,
      )
      let mut cbi = 0
      while cbi < eff_slots.length() {
        let bslot = eff_slots[cbi]
        let btarget = eff_targets[cbi]
        if cname == "?" ||
          sig_target_calls_slot(
            cname,
            bslot,
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_called_params,
            fn_unknown_callp,
          ) {
          match fn_key_idx.get(btarget) {
            Some(bi) => called_fn_idxs.set(bi, true)
            None => ()
          }
        }
        cbi = cbi + 1
      }
      cj = cj + 1
    }
    rci = rci + 1
  }
  let active_fdef_idxs : Map[Int, Bool] = Map([])
  let seen_slot_calls : Map[String, Bool] = Map([])
  let mut max_ret_depth = 8
  let mut rdi0 = 0
  while rdi0 < fn_keys.length() {
    let rd = sig_count_ret_prefix(fn_keys[rdi0])
    if rd + 2 > max_ret_depth {
      max_ret_depth = rd + 2
    }
    rdi0 = rdi0 + 1
  }
  let mut outer_mw_changed = true
  while outer_mw_changed {
    outer_mw_changed = false
    let mut call_reach_changed = true
    while call_reach_changed {
      call_reach_changed = false
      let mut fni2 = 0
      while fni2 < n_fns {
        if called_fn_idxs.contains(fni2) {
          let cs = fn_calls[fni2]
          let mut cj = 0
          while cj < cs.length() {
            let desc = sig_parse_call_desc(cs[cj])
            let cname = desc.target
            if starts_with_str(cname, ".") {
              match method_name_to_idxs.get(cname) {
                Some(tidxs) => {
                  let mut ti = 0
                  while ti < tidxs.length() {
                    if !called_fn_idxs.contains(tidxs[ti]) {
                      called_fn_idxs.set(tidxs[ti], true)
                      call_reach_changed = true
                    }
                    ti = ti + 1
                  }
                }
                None => ()
              }
            } else {
              match fn_key_idx.get(cname) {
                Some(ti) =>
                  if !called_fn_idxs.contains(ti) {
                    called_fn_idxs.set(ti, true)
                    call_reach_changed = true
                  }
                None => ()
              }
            }
            let eff_slots : Array[String] = []
            let eff_targets : Array[String] = []
            sig_collect_call_effective_cbs(
              desc,
              fdef_by_fn,
              fdef_by_method,
              fdef_fn,
              fdef_param_idx,
              fdef_param_name,
              fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
              eff_slots,
              eff_targets,
            )
            let mut cbi = 0
            while cbi < eff_slots.length() {
              let bslot = eff_slots[cbi]
              let btarget = eff_targets[cbi]
              if cname == "?" ||
                sig_target_calls_slot(
                  cname,
                  bslot,
                  fn_keys,
                  fn_key_idx,
                  method_name_to_idxs,
                  fn_pnames,
                  fn_called_params,
                  fn_unknown_callp,
                ) {
                match fn_key_idx.get(btarget) {
                  Some(bi) =>
                    if !called_fn_idxs.contains(bi) {
                      called_fn_idxs.set(bi, true)
                      call_reach_changed = true
                    }
                  None => ()
                }
              }
              cbi = cbi + 1
            }
            cj = cj + 1
          }
        }
        fni2 = fni2 + 1
      }
    }
    // Activate default-argument expressions (`fdef_calls`) only when an active call site
    // actually omits the corresponding parameter (`sig_fdef_triggered`).
    let fdef_scan_lists : Array[Array[String]] = []
    let mut fsi = 0
    while fsi < const_calls.length() {
      fdef_scan_lists.push(const_calls[fsi])
      fsi = fsi + 1
    }
    fsi = 0
    while fsi < n_fns {
      if called_fn_idxs.contains(fsi) {
        fdef_scan_lists.push(fn_calls[fsi])
      }
      fsi = fsi + 1
    }
    fsi = 0
    while fsi < fdef_calls.length() {
      if active_fdef_idxs.contains(fsi) {
        fdef_scan_lists.push(fdef_calls[fsi])
      }
      fsi = fsi + 1
    }
    fsi = 0
    while fsi < fdef_scan_lists.length() {
      let cs = fdef_scan_lists[fsi]
      let mut cj = 0
      while cj < cs.length() {
        let desc = sig_parse_call_desc(cs[cj])
        let cname = desc.target
        let didxs_opt = if starts_with_str(cname, ".") {
          fdef_by_method.get(cname)
        } else {
          fdef_by_fn.get(cname)
        }
        match didxs_opt {
          Some(didxs) => {
            let mut dj = 0
            while dj < didxs.length() {
              let d_id = didxs[dj]
              if !active_fdef_idxs.contains(d_id) &&
                sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                active_fdef_idxs.set(d_id, true)
                outer_mw_changed = true
              }
              dj = dj + 1
            }
          }
          None => ()
        }
        cj = cj + 1
      }
      fsi = fsi + 1
    }
    // Re-scan all active `fdef_calls` to fixed point so late-discovered `#fcallp` / `$retp:` edges
    // inside default expressions also mark their targets reachable in `called_fn_idxs`.
    let mut ad_id = 0
    while ad_id < n_fdefs {
      if active_fdef_idxs.contains(ad_id) {
        let dcs = fdef_calls[ad_id]
        let mut dcj = 0
        while dcj < dcs.length() {
          let ddesc = sig_parse_call_desc(dcs[dcj])
          let dcname = ddesc.target
          if starts_with_str(dcname, ".") {
            match method_name_to_idxs.get(dcname) {
              Some(tidxs) => {
                let mut ti = 0
                while ti < tidxs.length() {
                  if !called_fn_idxs.contains(tidxs[ti]) {
                    called_fn_idxs.set(tidxs[ti], true)
                    outer_mw_changed = true
                  }
                  ti = ti + 1
                }
              }
              None => ()
            }
          } else {
            match fn_key_idx.get(dcname) {
              Some(ti) =>
                if !called_fn_idxs.contains(ti) {
                  called_fn_idxs.set(ti, true)
                  outer_mw_changed = true
                }
              None => ()
            }
          }
          let deff_slots : Array[String] = []
          let deff_targets : Array[String] = []
          sig_collect_call_effective_cbs(
            ddesc,
            fdef_by_fn,
            fdef_by_method,
            fdef_fn,
            fdef_param_idx,
            fdef_param_name,
            fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
            deff_slots,
            deff_targets,
          )
          let mut cbi = 0
          while cbi < deff_slots.length() {
            if dcname == "?" ||
              sig_target_calls_slot(
                dcname,
                deff_slots[cbi],
                fn_keys,
                fn_key_idx,
                method_name_to_idxs,
                fn_pnames,
                fn_called_params,
                fn_unknown_callp,
              ) {
              match fn_key_idx.get(deff_targets[cbi]) {
                Some(bi) =>
                  if !called_fn_idxs.contains(bi) {
                    called_fn_idxs.set(bi, true)
                    outer_mw_changed = true
                  }
                None => ()
              }
            }
            let ddepths : Array[Int] = []
            sig_lookup_call_ret_depths(
              dcname,
              deff_slots[cbi],
              fn_keys,
              fn_key_idx,
              method_name_to_idxs,
              fn_pnames,
              fn_called_ret_depths,
              ddepths,
            )
            let mut ddi = 0
            while ddi < ddepths.length() {
              let rt = sig_repeat_ret_prefix(ddepths[ddi], deff_targets[cbi])
              let ridx = match fn_key_idx.get(rt) {
                Some(idx) => idx
                None => {
                  let idx = fn_keys.length()
                  fn_key_idx.set(rt, idx)
                  fn_keys.push(rt)
                  fn_idents.push([])
                  fn_calls.push([])
                  fn_pnames.push([])
                  fn_called_params.push(Map([]))
                  fn_fwd_edges.push([])
                  n_fns = fn_keys.length()
                  outer_mw_changed = true
                  idx
                }
              }
              if !called_fn_idxs.contains(ridx) {
                called_fn_idxs.set(ridx, true)
                outer_mw_changed = true
              }
              ddi = ddi + 1
            }
            if sig_target_has_any_ret_depth(
              dcname,
              deff_slots[cbi],
              fn_keys,
              fn_key_idx,
              method_name_to_idxs,
              fn_pnames,
              fn_any_ret_depth,
            ) {
              let tr_idxs : Array[Int] = []
              sig_collect_transitive_ret_targets(
                deff_targets[cbi],
                fn_key_idx,
                fn_calls,
                fn_aliases,
                tr_idxs,
              )
              let mut tri = 0
              while tri < tr_idxs.length() {
                if !called_fn_idxs.contains(tr_idxs[tri]) {
                  called_fn_idxs.set(tr_idxs[tri], true)
                  outer_mw_changed = true
                }
                tri = tri + 1
              }
            }
            cbi = cbi + 1
          }
          dcj = dcj + 1
        }
      }
      ad_id = ad_id + 1
    }
    // Activate `#fieldw`, `#fieldp`, `#fieldwp`, `#fieldpp`, context-sensitive `$retp:`, and multi-level `$ret:`
    // only for writers/callers actually reachable during top-level constant initialization (`@ci:*`, active `@fdef:*`, or `called_fn_idxs`).
    let mut fwi2 = 0
    while fwi2 < fw_entry_fn.length() {
      let wfn = fw_entry_fn[fwi2]
      let active = if starts_with_str(wfn, "@ci:") {
        true
      } else if starts_with_str(wfn, "@fdef:") {
        match fdef_id_by_key.get(slice_str(wfn, 6, wfn.length())) {
          Some(d_id) => active_fdef_idxs.contains(d_id)
          None => false
        }
      } else {
        match fn_key_idx.get(wfn) {
          Some(wi) => called_fn_idxs.contains(wi)
          None => false
        }
      }
      if active {
        let tfk = fw_entry_tf[fwi2]
        match fn_key_idx.get("fw:" + tfk) {
          Some(fw_idx) => {
            let before = fn_calls[fw_idx].length()
            sig_union_str_array(fn_calls[fw_idx], fw_entry_targets[fwi2])
            if fn_calls[fw_idx].length() > before {
              fn_unknown_callp.set("fw:" + tfk, true)
              outer_mw_changed = true
            }
          }
          None => ()
        }
        match fn_key_idx.get("fp:" + tfk) {
          Some(fp_idx) => {
            let before = fn_calls[fp_idx].length()
            sig_union_str_array(fn_calls[fp_idx], fw_entry_targets[fwi2])
            if fn_calls[fp_idx].length() > before {
              fn_unknown_callp.set("fp:" + tfk, true)
              outer_mw_changed = true
            }
          }
          None => ()
        }
      }
      fwi2 = fwi2 + 1
    }
    let mut fpi2 = 0
    while fpi2 < fp_entry_fn.length() {
      let wfn = fp_entry_fn[fpi2]
      let active = if starts_with_str(wfn, "@ci:") {
        true
      } else if starts_with_str(wfn, "@fdef:") {
        match fdef_id_by_key.get(slice_str(wfn, 6, wfn.length())) {
          Some(d_id) => active_fdef_idxs.contains(d_id)
          None => false
        }
      } else {
        match fn_key_idx.get(wfn) {
          Some(wi) => called_fn_idxs.contains(wi)
          None => false
        }
      }
      if active {
        let tfk = fp_entry_tf[fpi2]
        match fn_key_idx.get("fp:" + tfk) {
          Some(fp_idx) => {
            let before = fn_calls[fp_idx].length()
            sig_union_str_array(fn_calls[fp_idx], fp_entry_targets[fpi2])
            if fn_calls[fp_idx].length() > before {
              fn_unknown_callp.set("fp:" + tfk, true)
              outer_mw_changed = true
            }
          }
          None => ()
        }
      }
      fpi2 = fpi2 + 1
    }
    // Discover context-sensitive `$retp:` return-call depths from reachable nodes
    // and propagate backwards along `fn_fwd_edges` (mirroring `#fcallp`).
    let mut rdi2 = 0
    while rdi2 < n_fns {
      if called_fn_idxs.contains(rdi2) {
        let cs = fn_calls[rdi2]
        let mut cj = 0
        while cj < cs.length() {
          let mut cur = sig_parse_call_desc(cs[cj]).target
          let mut depth = 0
          while starts_with_str(cur, "$ret:") {
            depth = depth + 1
            cur = slice_str(cur, 5, cur.length())
          }
          if starts_with_str(cur, "$retp:") {
            let rest = slice_str(cur, 6, cur.length())
            let mut tilde = -1
            let mut ti = rest.length() - 1
            while ti >= 0 {
              if str_code_at(rest, ti) == 126 {
                tilde = ti
                break
              }
              ti = ti - 1
            }
            if tilde > 0 && tilde + 1 < rest.length() {
              let k = slice_str(rest, 0, tilde) + "|" + slice_str(rest, tilde + 1, rest.length())
              if sig_add_ret_depth(fn_called_ret_depths, fn_any_ret_depth, k, depth + 1, fn_unknown_callp) {
                outer_mw_changed = true
              }
            }
          }
          cj = cj + 1
        }
      }
      rdi2 = rdi2 + 1
    }
    let mut rpf_changed = true
    while rpf_changed {
      rpf_changed = false
      let rd_keys = fn_called_ret_depths.keys()
      let ar_keys = fn_any_ret_depth.keys()
      let mut ai2 = 0
      while ai2 < alias_src_idxs.length() {
        let src_pref = fn_keys[alias_src_idxs[ai2]] + "|"
        let dst_pref = fn_keys[alias_dst_idxs[ai2]] + "|"
        let mut rki = 0
        while rki < rd_keys.length() {
          let rk = rd_keys[rki]
          if starts_with_str(rk, dst_pref) {
            let p_suf = slice_str(rk, dst_pref.length(), rk.length())
            match fn_called_ret_depths.get(rk) {
              Some(ds) => {
                let mut di = 0
                while di < ds.length() {
                  if sig_add_ret_depth(fn_called_ret_depths, fn_any_ret_depth, src_pref + p_suf, ds[di], fn_unknown_callp) {
                    rpf_changed = true
                    outer_mw_changed = true
                  }
                  di = di + 1
                }
              }
              None => ()
            }
          }
          rki = rki + 1
        }
        let mut aki = 0
        while aki < ar_keys.length() {
          let ak = ar_keys[aki]
          if starts_with_str(ak, dst_pref) {
            let nk = src_pref + slice_str(ak, dst_pref.length(), ak.length())
            if !fn_any_ret_depth.contains(nk) {
              fn_any_ret_depth.set(nk, true)
              rpf_changed = true
              outer_mw_changed = true
            }
          }
          aki = aki + 1
        }
        ai2 = ai2 + 1
      }
      let mut si2 = 0
      while si2 < slot_src_idxs.length() {
        let src_pref = fn_keys[slot_src_idxs[si2]] + "|"
        let dst_pref = fn_keys[slot_dst_idxs[si2]] + "|"
        let mut rki = 0
        while rki < rd_keys.length() {
          let rk = rd_keys[rki]
          if starts_with_str(rk, dst_pref) {
            let p_suf = slice_str(rk, dst_pref.length(), rk.length())
            match fn_called_ret_depths.get(rk) {
              Some(ds) => {
                let mut di = 0
                while di < ds.length() {
                  if sig_add_ret_depth(fn_called_ret_depths, fn_any_ret_depth, src_pref + p_suf, ds[di], fn_unknown_callp) {
                    rpf_changed = true
                    outer_mw_changed = true
                  }
                  di = di + 1
                }
              }
              None => ()
            }
          }
          rki = rki + 1
        }
        let mut aki = 0
        while aki < ar_keys.length() {
          let ak = ar_keys[aki]
          if starts_with_str(ak, dst_pref) {
            let nk = src_pref + slice_str(ak, dst_pref.length(), ak.length())
            if !fn_any_ret_depth.contains(nk) {
              fn_any_ret_depth.set(nk, true)
              rpf_changed = true
              outer_mw_changed = true
            }
          }
          aki = aki + 1
        }
        si2 = si2 + 1
      }
      let mut fi2 = 0
      while fi2 < n_fns {
        let outer_fn = fn_keys[fi2]
        let edges = fn_fwd_edges[fi2]
        let mut ei2 = 0
        while ei2 < edges.length() {
          let edge = edges[ei2]
          let g1 = sig_find_char(edge, 62, 0)
          if g1 > 0 {
            let g2 = sig_find_char(edge, 62, g1 + 1)
            if g2 > g1 + 1 && g2 + 1 < edge.length() {
              let my_pidx_s = slice_str(edge, 0, g1)
              let tgt = slice_str(edge, g1 + 1, g2)
              let slot = slice_str(edge, g2 + 1, edge.length())
              let tgt_pidxs = sig_fwd_edge_target_pidxs(
                tgt,
                slot,
                fn_key_idx,
                fn_pnames,
                fdef_by_fn,
                fdef_by_method,
                fdef_fn,
                fdef_param_idx,
                fdef_param_name,
                fdef_cb_targets,
                fdef_pcalls,
              )
              let mut tpi = 0
              while tpi < tgt_pidxs.length() {
                let tk = tgt + "|" + tgt_pidxs[tpi].to_string()
                match fn_called_ret_depths.get(tk) {
                  Some(ds) => {
                    let mut di = 0
                    while di < ds.length() {
                      if sig_add_ret_depth(fn_called_ret_depths, fn_any_ret_depth, outer_fn + "|" + my_pidx_s, ds[di], fn_unknown_callp) {
                        rpf_changed = true
                        outer_mw_changed = true
                      }
                      di = di + 1
                    }
                  }
                  None => ()
                }
                if fn_any_ret_depth.contains(tk) {
                  let nk = outer_fn + "|" + my_pidx_s
                  if !fn_any_ret_depth.contains(nk) {
                    fn_any_ret_depth.set(nk, true)
                    rpf_changed = true
                    outer_mw_changed = true
                  }
                }
                tpi = tpi + 1
              }
            }
          }
          ei2 = ei2 + 1
        }
        fi2 = fi2 + 1
      }
    }
    let act_lists : Array[Array[String]] = []
    let mut ai3 = 0
    while ai3 < const_calls.length() {
      act_lists.push(const_calls[ai3])
      ai3 = ai3 + 1
    }
    ai3 = 0
    while ai3 < fdef_calls.length() {
      if active_fdef_idxs.contains(ai3) {
        act_lists.push(fdef_calls[ai3])
      }
      ai3 = ai3 + 1
    }
    ai3 = 0
    while ai3 < n_fns {
      if called_fn_idxs.contains(ai3) {
        act_lists.push(fn_calls[ai3])
      }
      ai3 = ai3 + 1
    }
    let mut li3 = 0
    while li3 < act_lists.length() {
      let cs = act_lists[li3]
      let mut cj = 0
      while cj < cs.length() {
        let desc = sig_parse_call_desc(cs[cj])
        let eff_slots : Array[String] = []
        let eff_targets : Array[String] = []
        sig_collect_call_effective_cbs(
          desc,
          fdef_by_fn,
          fdef_by_method,
          fdef_fn,
          fdef_param_idx,
          fdef_param_name,
          fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
          eff_slots,
          eff_targets,
        )
        if eff_slots.length() > 0 {
          let tidx_opt = fn_key_idx.get(desc.target)
          let mut wi = 0
          while wi < field_wp_fn.length() {
            if desc.target == field_wp_fn[wi] {
              let mut bi = 0
              while bi < eff_slots.length() {
                let resolved_slot = match tidx_opt {
                  Some(tidx) => {
                    let rp = sig_slot_to_pidx(fn_pnames[tidx], eff_slots[bi])
                    if rp >= 0 { rp.to_string() } else { eff_slots[bi] }
                  }
                  None => eff_slots[bi]
                }
                if resolved_slot == field_wp_pidx[wi] {
                  let tfk = field_wp_field[wi]
                  let bt = eff_targets[bi]
                  match fn_key_idx.get("fw:" + tfk) {
                    Some(fw_idx) => {
                      let before = fn_calls[fw_idx].length()
                      sig_union_str_array(fn_calls[fw_idx], [bt])
                      if fn_calls[fw_idx].length() > before {
                        fn_unknown_callp.set("fw:" + tfk, true)
                        outer_mw_changed = true
                      }
                    }
                    None => ()
                  }
                  match fn_key_idx.get("fp:" + tfk) {
                    Some(fp_idx) => {
                      let before = fn_calls[fp_idx].length()
                      sig_union_str_array(fn_calls[fp_idx], [bt])
                      if fn_calls[fp_idx].length() > before {
                        fn_unknown_callp.set("fp:" + tfk, true)
                        outer_mw_changed = true
                      }
                    }
                    None => ()
                  }
                }
                bi = bi + 1
              }
            }
            wi = wi + 1
          }
          let mut pi3 = 0
          while pi3 < field_pp_fn.length() {
            if desc.target == field_pp_fn[pi3] {
              let mut bi = 0
              while bi < eff_slots.length() {
                let resolved_slot = match tidx_opt {
                  Some(tidx) => {
                    let rp = sig_slot_to_pidx(fn_pnames[tidx], eff_slots[bi])
                    if rp >= 0 { rp.to_string() } else { eff_slots[bi] }
                  }
                  None => eff_slots[bi]
                }
                if resolved_slot == field_pp_pidx[pi3] {
                  let tfk = field_pp_field[pi3]
                  let bt = eff_targets[bi]
                  match fn_key_idx.get("fp:" + tfk) {
                    Some(fp_idx) => {
                      let before = fn_calls[fp_idx].length()
                      sig_union_str_array(fn_calls[fp_idx], [bt])
                      if fn_calls[fp_idx].length() > before {
                        fn_unknown_callp.set("fp:" + tfk, true)
                        outer_mw_changed = true
                      }
                    }
                    None => ()
                  }
                }
                bi = bi + 1
              }
            }
            pi3 = pi3 + 1
          }
          // Context-sensitive instantiation: mark `$ret:...<arg>` reachable in `called_fn_idxs`
          // without merging across callers!
          let mut bi = 0
          while bi < eff_slots.length() {
            let depths : Array[Int] = []
            sig_lookup_call_ret_depths(
              desc.target,
              eff_slots[bi],
              fn_keys,
              fn_key_idx,
              method_name_to_idxs,
              fn_pnames,
              fn_called_ret_depths,
              depths,
            )
            let mut di = 0
            while di < depths.length() {
              let r_target = sig_repeat_ret_prefix(depths[di], eff_targets[bi])
              let ridx = match fn_key_idx.get(r_target) {
                Some(idx) => idx
                None => {
                  let idx = fn_keys.length()
                  fn_key_idx.set(r_target, idx)
                  fn_keys.push(r_target)
                  fn_idents.push([])
                  fn_calls.push([])
                  fn_pnames.push([])
                  fn_called_params.push(Map([]))
                  fn_fwd_edges.push([])
                  n_fns = fn_keys.length()
                  outer_mw_changed = true
                  idx
                }
              }
              if !called_fn_idxs.contains(ridx) {
                called_fn_idxs.set(ridx, true)
                outer_mw_changed = true
              }
              di = di + 1
            }
            if sig_target_has_any_ret_depth(
              desc.target,
              eff_slots[bi],
              fn_keys,
              fn_key_idx,
              method_name_to_idxs,
              fn_pnames,
              fn_any_ret_depth,
            ) {
              let tr_idxs : Array[Int] = []
              sig_collect_transitive_ret_targets(
                eff_targets[bi],
                fn_key_idx,
                fn_calls,
                fn_aliases,
                tr_idxs,
              )
              let mut tri = 0
              while tri < tr_idxs.length() {
                if !called_fn_idxs.contains(tr_idxs[tri]) {
                  called_fn_idxs.set(tr_idxs[tri], true)
                  outer_mw_changed = true
                }
                tri = tri + 1
              }
            }
            bi = bi + 1
          }
        }
        cj = cj + 1
      }
      li3 = li3 + 1
    }
    // Expand multi-level `$ret:<inner>` chains (e.g. `$ret:$ret:outer`, `$ret:$retp:...`, `$ret:cf:...`, `$ret:alias`)
    let mut rxi = 0
    while rxi < n_fns {
      let rk = fn_keys[rxi]
      if starts_with_str(rk, "$ret:") {
        let inner = slice_str(rk, 5, rk.length())
        match fn_aliases.get(inner) {
          Some(at) => {
            let nxt = if sig_count_ret_prefix(at) + 1 <= max_ret_depth {
              "$ret:" + at
            } else {
              at
            }
            if !fn_key_idx.contains(nxt) {
              let idx = fn_keys.length()
              fn_key_idx.set(nxt, idx)
              fn_keys.push(nxt)
              fn_idents.push([])
              fn_calls.push([])
              fn_pnames.push([])
              fn_called_params.push(Map([]))
              fn_fwd_edges.push([])
              n_fns = fn_keys.length()
            }
            let before = fn_calls[rxi].length()
            sig_union_str_array(fn_calls[rxi], [nxt])
            if fn_calls[rxi].length() > before {
              fn_unknown_callp.set(rk, true)
              outer_mw_changed = true
            }
          }
          None => ()
        }
        if starts_with_str(inner, "$ret:") ||
          starts_with_str(inner, "$retp:") ||
          starts_with_str(inner, "cf:") ||
          starts_with_str(inner, "cf?:") ||
          starts_with_str(inner, "fw:") ||
          starts_with_str(inner, "fp:") ||
          starts_with_str(inner, "$slot_") ||
          starts_with_str(inner, "$cslot_") {
          match fn_key_idx.get(inner) {
            Some(iidx) => {
              let icalls = fn_calls[iidx]
              let mut ici = 0
              while ici < icalls.length() {
                let tt = sig_parse_call_desc(icalls[ici]).target
                if tt != "" && tt != "?" && tt != "$fp" {
                  if sig_count_ret_prefix(tt) + 1 <= max_ret_depth {
                    let nxt = "$ret:" + tt
                    if !fn_key_idx.contains(nxt) {
                      let idx = fn_keys.length()
                      fn_key_idx.set(nxt, idx)
                      fn_keys.push(nxt)
                      fn_idents.push([])
                      fn_calls.push([])
                      fn_pnames.push([])
                      fn_called_params.push(Map([]))
                      fn_fwd_edges.push([])
                      n_fns = fn_keys.length()
                    }
                    let before = fn_calls[rxi].length()
                    sig_union_str_array(fn_calls[rxi], [nxt])
                    if fn_calls[rxi].length() > before {
                      fn_unknown_callp.set(rk, true)
                      outer_mw_changed = true
                    }
                  } else {
                    // Recursive `$ret:` cycle hit depth bound: fold soundly onto all
                    // transitive return targets of `tt` without growing `$ret:^N` keys.
                    let tr_idxs : Array[Int] = []
                    sig_collect_transitive_ret_targets(
                      tt,
                      fn_key_idx,
                      fn_calls,
                      fn_aliases,
                      tr_idxs,
                    )
                    let before = fn_calls[rxi].length()
                    sig_union_str_array(fn_calls[rxi], [tt])
                    let mut tri = 0
                    while tri < tr_idxs.length() {
                      sig_union_str_array(fn_calls[rxi], [fn_keys[tr_idxs[tri]]])
                      tri = tri + 1
                    }
                    if fn_calls[rxi].length() > before {
                      fn_unknown_callp.set(rk, true)
                      outer_mw_changed = true
                    }
                  }
                }
                ici = ici + 1
              }
            }
            None =>
              if starts_with_str(inner, "$ret:") {
                let idx = fn_keys.length()
                fn_key_idx.set(inner, idx)
                fn_keys.push(inner)
                fn_idents.push([])
                fn_calls.push([])
                fn_pnames.push([])
                fn_called_params.push(Map([]))
                fn_fwd_edges.push([])
                n_fns = fn_keys.length()
                outer_mw_changed = true
              }
          }
        }
      }
      rxi = rxi + 1
    }
    // Activate `#fcbw` and `#fcbfwd` only for closures actually called in the call graph
    let mut cwi2 = 0
    while cwi2 < cb_mw_cb.length() {
      match fn_key_idx.get(cb_mw_cb[cwi2]) {
        Some(cb_idx) =>
          if called_fn_idxs.contains(cb_idx) {
            let dst_key = cb_mw_owner[cwi2] + "|" + cb_mw_pidx[cwi2].to_string()
            let dst = match fn_mut_writes.get(dst_key) {
              Some(cur) => cur
              None => {
                let arr : Array[String] = []
                fn_mut_writes.set(dst_key, arr)
                arr
              }
            }
            let before = dst.length()
            sig_union_str_array(dst, cb_mw_targets[cwi2])
            if dst.length() > before {
              outer_mw_changed = true
            }
          }
        None => ()
      }
      cwi2 = cwi2 + 1
    }
    let mut cfi2 = 0
    while cfi2 < cb_mf_cb.length() {
      if !cb_mf_active[cfi2] {
        match fn_key_idx.get(cb_mf_cb[cfi2]) {
          Some(cb_idx) =>
            if called_fn_idxs.contains(cb_idx) {
              cb_mf_active[cfi2] = true
              mut_fwd_fn.push(cb_mf_owner[cfi2])
              mut_fwd_pidx.push(cb_mf_pidx[cfi2])
              mut_fwd_callee.push(cb_mf_callee[cfi2])
              mut_fwd_cslot.push(cb_mf_cslot[cfi2])
              outer_mw_changed = true
            }
          None => ()
        }
      }
      cfi2 = cfi2 + 1
    }
    // Activate `#fcbcall` only for closures actually called in the call graph, then re-propagate `#fcallp`
    let mut cb_callp_added = false
    let mut cmci = 0
    while cmci < cb_mc_cb.length() {
      match fn_key_idx.get(cb_mc_cb[cmci]) {
        Some(cb_idx) =>
          if called_fn_idxs.contains(cb_idx) {
            match fn_key_idx.get(cb_mc_owner[cmci]) {
              Some(owner_idx) => {
                let p = cb_mc_pidx[cmci]
                if !fn_called_params[owner_idx].contains(p) {
                  fn_called_params[owner_idx].set(p, true)
                  cb_callp_added = true
                  outer_mw_changed = true
                }
              }
              None => ()
            }
          }
        None => ()
      }
      cmci = cmci + 1
    }
    let mut cpfi2 = 0
    while cpfi2 < cb_pf_cb.length() {
      match fn_key_idx.get(cb_pf_cb[cpfi2]) {
        Some(cb_idx) =>
          if called_fn_idxs.contains(cb_idx) &&
            sig_target_calls_slot(
              cb_pf_callee[cpfi2],
              cb_pf_slot[cpfi2],
              fn_keys,
              fn_key_idx,
              method_name_to_idxs,
              fn_pnames,
              fn_called_params,
              fn_unknown_callp,
            ) {
            match fn_key_idx.get(cb_pf_owner[cpfi2]) {
              Some(owner_idx) => {
                let p = cb_pf_pidx[cpfi2]
                if !fn_called_params[owner_idx].contains(p) {
                  fn_called_params[owner_idx].set(p, true)
                  cb_callp_added = true
                  outer_mw_changed = true
                }
              }
              None => ()
            }
          }
        None => ()
      }
      cpfi2 = cpfi2 + 1
    }
    if cb_callp_added {
      let mut cp2_changed = true
      while cp2_changed {
        cp2_changed = false
        let mut ai2 = 0
        while ai2 < alias_src_idxs.length() {
          let aidx = alias_src_idxs[ai2]
          let tidx = alias_dst_idxs[ai2]
          let tkeys = fn_called_params[tidx].keys()
          let mut ki = 0
          while ki < tkeys.length() {
            let p = tkeys[ki]
            if !fn_called_params[aidx].contains(p) {
              fn_called_params[aidx].set(p, true)
              cp2_changed = true
            }
            ki = ki + 1
          }
          ai2 = ai2 + 1
        }
        let mut si2 = 0
        while si2 < slot_src_idxs.length() {
          let sidx = slot_src_idxs[si2]
          let tidx = slot_dst_idxs[si2]
          let tkeys = fn_called_params[tidx].keys()
          let mut ki = 0
          while ki < tkeys.length() {
            let p = tkeys[ki]
            if !fn_called_params[sidx].contains(p) {
              fn_called_params[sidx].set(p, true)
              cp2_changed = true
            }
            ki = ki + 1
          }
          si2 = si2 + 1
        }
        let mut fi2 = 0
        while fi2 < n_fns {
          let edges = fn_fwd_edges[fi2]
          let mut ei = 0
          while ei < edges.length() {
            let edge = edges[ei]
            let g1 = sig_find_char(edge, 62, 0)
            if g1 > 0 {
              let g2 = sig_find_char(edge, 62, g1 + 1)
              if g2 > g1 + 1 && g2 + 1 < edge.length() {
                let my_pidx = sig_parse_nonneg_int(slice_str(edge, 0, g1))
                if !fn_called_params[fi2].contains(my_pidx) {
                  let tgt = slice_str(edge, g1 + 1, g2)
                  let slot = slice_str(edge, g2 + 1, edge.length())
                  if sig_fwd_edge_is_called(
                    tgt,
                    slot,
                    fn_keys,
                    fn_key_idx,
                    method_name_to_idxs,
                    fn_pnames,
                    fn_called_params,
                    fn_unknown_callp,
                    fdef_by_fn,
                    fdef_by_method,
                    fdef_fn,
                    fdef_param_idx,
                    fdef_param_name,
                    fdef_cb_targets,
                    fdef_pcalls,
                  ) {
                    fn_called_params[fi2].set(my_pidx, true)
                    cp2_changed = true
                  }
                }
              }
            }
            ei = ei + 1
          }
          fi2 = fi2 + 1
        }
        let mut dfki2 = 0
        while dfki2 < fdef_fwd_keys.length() {
          let dkey = fdef_fwd_keys[dfki2]
          match fdef_fwds.get(dkey) {
            Some(edges) => {
              let mut ei = 0
              while ei < edges.length() {
                let edge = edges[ei]
                let g1 = sig_find_char(edge, 62, 0)
                if g1 > 0 {
                  let g2 = sig_find_char(edge, 62, g1 + 1)
                  if g2 > g1 + 1 && g2 + 1 < edge.length() {
                    let src_pidx = sig_parse_nonneg_int(slice_str(edge, 0, g1))
                    let tgt = slice_str(edge, g1 + 1, g2)
                    let slot = slice_str(edge, g2 + 1, edge.length())
                    if sig_fwd_edge_is_called(
                      tgt,
                      slot,
                      fn_keys,
                      fn_key_idx,
                      method_name_to_idxs,
                      fn_pnames,
                      fn_called_params,
                      fn_unknown_callp,
                      fdef_by_fn,
                      fdef_by_method,
                      fdef_fn,
                      fdef_param_idx,
                      fdef_param_name,
                      fdef_cb_targets,
                      fdef_pcalls,
                    ) {
                      let arr = match fdef_pcalls.get(dkey) {
                        Some(cur) => cur
                        None => {
                          let fresh : Array[Int] = []
                          fdef_pcalls.set(dkey, fresh)
                          fresh
                        }
                      }
                      let mut has_p = false
                      let mut ai = 0
                      while ai < arr.length() {
                        if arr[ai] == src_pidx {
                          has_p = true
                          break
                        }
                        ai = ai + 1
                      }
                      if !has_p {
                        arr.push(src_pidx)
                        cp2_changed = true
                      }
                    }
                  }
                }
                ei = ei + 1
              }
            }
            None => ()
          }
          dfki2 = dfki2 + 1
        }
      }
      let mut rci2 = 0
      while rci2 < const_calls.length() {
        let cs = const_calls[rci2]
        let mut cj = 0
        while cj < cs.length() {
          let desc = sig_parse_call_desc(cs[cj])
          let cname = desc.target
          let eff_slots : Array[String] = []
          let eff_targets : Array[String] = []
          sig_collect_call_effective_cbs(
            desc,
            fdef_by_fn,
            fdef_by_method,
            fdef_fn,
            fdef_param_idx,
            fdef_param_name,
            fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
            eff_slots,
            eff_targets,
          )
          let mut cbi = 0
          while cbi < eff_slots.length() {
            let bslot = eff_slots[cbi]
            let btarget = eff_targets[cbi]
            if cname == "?" ||
              sig_target_calls_slot(
                cname,
                bslot,
                fn_keys,
                fn_key_idx,
                method_name_to_idxs,
                fn_pnames,
                fn_called_params,
                fn_unknown_callp,
              ) {
              match fn_key_idx.get(btarget) {
                Some(bi) =>
                  if !called_fn_idxs.contains(bi) {
                    called_fn_idxs.set(bi, true)
                    outer_mw_changed = true
                  }
                None => ()
              }
            }
            cbi = cbi + 1
          }
          cj = cj + 1
        }
        rci2 = rci2 + 1
      }
    }
    let mut mw_changed = true
    while mw_changed {
      mw_changed = false
      let mut mfi = 0
      while mfi < mut_fwd_fn.length() {
        let fk = mut_fwd_fn[mfi]
        let dst_key = fk + "|" + mut_fwd_pidx[mfi].to_string()
        let callee = mut_fwd_callee[mfi]
        let cslot = mut_fwd_cslot[mfi]
        let tidxs : Array[Int] = if starts_with_str(callee, ".") {
          match method_name_to_idxs.get(callee) {
            Some(a) => a
            None => []
          }
        } else {
          match fn_key_idx.get(callee) {
            Some(ti) => [ti]
            None => []
          }
        }
        let mut ti = 0
        while ti < tidxs.length() {
          let tidx = tidxs[ti]
          let cpidx = sig_slot_to_pidx(fn_pnames[tidx], cslot)
          if cpidx >= 0 {
            let src_key = fn_keys[tidx] + "|" + cpidx.to_string()
            match fn_mut_writes.get(src_key) {
              Some(wt) => {
                let dst = match fn_mut_writes.get(dst_key) {
                  Some(cur) => cur
                  None => {
                    let arr : Array[String] = []
                    fn_mut_writes.set(dst_key, arr)
                    arr
                  }
                }
                let before = dst.length()
                sig_union_str_array(dst, wt)
                if dst.length() > before {
                  mw_changed = true
                  outer_mw_changed = true
                }
              }
              None => ()
            }
          }
          ti = ti + 1
        }
        mfi = mfi + 1
      }
    }
    let mut mli = 0
    while mli < mut_link_slot.length() {
      let skey = mut_link_slot[mli]
      let callee = mut_link_callee[mli]
      let cslot = mut_link_cslot[mli]
      match fn_key_idx.get(skey) {
        Some(sidx) => {
          let tidxs : Array[Int] = if starts_with_str(callee, ".") {
            match method_name_to_idxs.get(callee) {
              Some(a) => a
              None => []
            }
          } else {
            match fn_key_idx.get(callee) {
              Some(ti) => [ti]
              None => []
            }
          }
          let mut ti = 0
          while ti < tidxs.length() {
            let tidx = tidxs[ti]
            let cpidx = sig_slot_to_pidx(fn_pnames[tidx], cslot)
            if cpidx >= 0 {
              let src_key = fn_keys[tidx] + "|" + cpidx.to_string()
              match fn_mut_writes.get(src_key) {
                Some(wt) => {
                  let mut wi = 0
                  while wi < wt.length() {
                    let edge_k = sidx.to_string() + "|" + wt[wi]
                    if !seen_slot_calls.contains(edge_k) {
                      seen_slot_calls.set(edge_k, true)
                      fn_calls[sidx].push(wt[wi] + "@0")
                      outer_mw_changed = true
                    }
                    wi = wi + 1
                  }
                }
                None => ()
              }
            }
            ti = ti + 1
          }
        }
        None => ()
      }
      mli = mli + 1
    }
  }

  let fn_reach : Array[Array[Int]] = []
  let fn_reach_map : Array[Map[Int, Bool]] = []
  let fn_ambig : Array[Bool] = []
  let mut fni = 0
  while fni < n_fns {
    let rlist : Array[Int] = []
    let rmap : Map[Int, Bool] = Map([])
    let ids = fn_idents[fni]
    let mut j = 0
    while j < ids.length() {
      match const_idx.get(ids[j]) {
        Some(ci) =>
          if !rmap.contains(ci) {
            rmap.set(ci, true)
            rlist.push(ci)
          }
        None => ()
      }
      j = j + 1
    }
    fn_reach.push(rlist)
    fn_reach_map.push(rmap)
    fn_ambig.push(false)
    fni = fni + 1
  }

  let fdef_reach : Array[Array[Int]] = []
  let fdef_reach_map : Array[Map[Int, Bool]] = []
  let fdef_ambig : Array[Bool] = []
  let mut di_init = 0
  while di_init < n_fdefs {
    let rlist : Array[Int] = []
    let rmap : Map[Int, Bool] = Map([])
    let ids = fdef_idents[di_init]
    let mut j = 0
    while j < ids.length() {
      match const_idx.get(ids[j]) {
        Some(ci) =>
          if !rmap.contains(ci) {
            rmap.set(ci, true)
            rlist.push(ci)
          }
        None => ()
      }
      j = j + 1
    }
    fdef_reach.push(rlist)
    fdef_reach_map.push(rmap)
    fdef_ambig.push(false)
    di_init = di_init + 1
  }

  let mut changed = true
  while changed {
    changed = false
    fni = 0
    while fni < n_fns {
      let cs = fn_calls[fni]
      let rlist = fn_reach[fni]
      let rmap = fn_reach_map[fni]
      let mut ci = 0
      while ci < cs.length() {
        let desc = sig_parse_call_desc(cs[ci])
        let cname = desc.target
        if starts_with_str(cname, "ctor?:") {
          if sig_ctor_query_is_ambig(
              cname,
              local_enums,
              local_enum_variants,
              local_enum_qual_variants,
              local_non_enum_types,
              extern_fns,
              fn_key_idx,
              const_idx,
            ) &&
            !fn_ambig[fni] {
            fn_ambig[fni] = true
            changed = true
          }
        } else if starts_with_str(cname, "pat?:") {
          let pn = slice_str(cname, 5, cname.length())
          if const_idx.contains(pn) && !fn_ambig[fni] {
            fn_ambig[fni] = true
            changed = true
          }
        } else if starts_with_str(cname, "mth?:") {
          if !fn_ambig[fni] {
            fn_ambig[fni] = true
            changed = true
          }
        } else if starts_with_str(cname, "call?:") {
          if !fn_ambig[fni] {
            fn_ambig[fni] = true
            changed = true
          }
        } else if starts_with_str(cname, ".") {
          let mname_only = slice_str(cname, 1, cname.length())
          if (fn_field_names.contains(mname_only) || trait_method_names.contains(mname_only)) &&
            !fn_ambig[fni] {
            fn_ambig[fni] = true
            changed = true
          }
          match method_name_to_idxs.get(cname) {
            Some(tidxs) => {
              if tidxs.length() >= 2 && !fn_ambig[fni] {
                fn_ambig[fni] = true
                changed = true
              }
              let mut ti = 0
              while ti < tidxs.length() {
                if fn_ambig[tidxs[ti]] && !fn_ambig[fni] {
                  fn_ambig[fni] = true
                  changed = true
                }
                let target_r = fn_reach[tidxs[ti]]
                let mut ri = 0
                while ri < target_r.length() {
                  let k = target_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
                ti = ti + 1
              }
            }
            None => ()
          }
          match fdef_by_method.get(cname) {
            Some(didxs) => {
              let mut dj = 0
              while dj < didxs.length() {
                let d_id = didxs[dj]
                if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                  if fdef_ambig[d_id] && !fn_ambig[fni] {
                    fn_ambig[fni] = true
                    changed = true
                  }
                  let dr = fdef_reach[d_id]
                  let mut ri = 0
                  while ri < dr.length() {
                    let k = dr[ri]
                    if !rmap.contains(k) {
                      rmap.set(k, true)
                      rlist.push(k)
                      changed = true
                    }
                    ri = ri + 1
                  }
                }
                dj = dj + 1
              }
            }
            None => ()
          }
        } else {
          match fn_key_idx.get(cname) {
            Some(tidx) => {
              if fn_ambig[tidx] && !fn_ambig[fni] {
                fn_ambig[fni] = true
                changed = true
              }
              let target_r = fn_reach[tidx]
              let mut ri = 0
              while ri < target_r.length() {
                let k = target_r[ri]
                if !rmap.contains(k) {
                  rmap.set(k, true)
                  rlist.push(k)
                  changed = true
                }
                ri = ri + 1
              }
            }
            None => ()
          }
          match fdef_by_fn.get(cname) {
            Some(didxs) => {
              let mut dj = 0
              while dj < didxs.length() {
                let d_id = didxs[dj]
                if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                  if fdef_ambig[d_id] && !fn_ambig[fni] {
                    fn_ambig[fni] = true
                    changed = true
                  }
                  let dr = fdef_reach[d_id]
                  let mut ri = 0
                  while ri < dr.length() {
                    let k = dr[ri]
                    if !rmap.contains(k) {
                      rmap.set(k, true)
                      rlist.push(k)
                      changed = true
                    }
                    ri = ri + 1
                  }
                }
                dj = dj + 1
              }
            }
            None => ()
          }
        }
        // Pull callback-arg deps ONLY when callee actually invokes that parameter (`#fcallp`)
        // and context-sensitive `$retp:` return-call deps for this call site only.
        let eff_slots : Array[String] = []
        let eff_targets : Array[String] = []
        sig_collect_call_effective_cbs(
          desc,
          fdef_by_fn,
          fdef_by_method,
          fdef_fn,
          fdef_param_idx,
          fdef_param_name,
          fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
          eff_slots,
          eff_targets,
        )
        let mut cbi = 0
        while cbi < eff_slots.length() {
          if sig_target_calls_slot(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_called_params,
            fn_unknown_callp,
          ) {
            match fn_key_idx.get(eff_targets[cbi]) {
              Some(cb_tidx) => {
                if fn_ambig[cb_tidx] && !fn_ambig[fni] {
                  fn_ambig[fni] = true
                  changed = true
                }
                let cb_r = fn_reach[cb_tidx]
                let mut ri = 0
                while ri < cb_r.length() {
                  let k = cb_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
              }
              None => ()
            }
          }
          let rdepths : Array[Int] = []
          sig_lookup_call_ret_depths(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_called_ret_depths,
            rdepths,
          )
          let mut rdi3 = 0
          while rdi3 < rdepths.length() {
            let rt = sig_repeat_ret_prefix(rdepths[rdi3], eff_targets[cbi])
            match fn_key_idx.get(rt) {
              Some(cb_tidx) => {
                if fn_ambig[cb_tidx] && !fn_ambig[fni] {
                  fn_ambig[fni] = true
                  changed = true
                }
                let cb_r = fn_reach[cb_tidx]
                let mut ri = 0
                while ri < cb_r.length() {
                  let k = cb_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
              }
              None => ()
            }
            rdi3 = rdi3 + 1
          }
          if sig_target_has_any_ret_depth(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_any_ret_depth,
          ) {
            let tr_idxs : Array[Int] = []
            sig_collect_transitive_ret_targets(
              eff_targets[cbi],
              fn_key_idx,
              fn_calls,
              fn_aliases,
              tr_idxs,
            )
            let mut tri = 0
            while tri < tr_idxs.length() {
              let cb_tidx = tr_idxs[tri]
              if fn_ambig[cb_tidx] && !fn_ambig[fni] {
                fn_ambig[fni] = true
                changed = true
              }
              let cb_r = fn_reach[cb_tidx]
              let mut ri = 0
              while ri < cb_r.length() {
                let k = cb_r[ri]
                if !rmap.contains(k) {
                  rmap.set(k, true)
                  rlist.push(k)
                  changed = true
                }
                ri = ri + 1
              }
              tri = tri + 1
            }
          }
          cbi = cbi + 1
        }
        ci = ci + 1
      }
      fni = fni + 1
    }
    let mut dfi = 0
    while dfi < n_fdefs {
      let cs = fdef_calls[dfi]
      let rlist = fdef_reach[dfi]
      let rmap = fdef_reach_map[dfi]
      let mut ci = 0
      while ci < cs.length() {
        let desc = sig_parse_call_desc(cs[ci])
        let cname = desc.target
        if starts_with_str(cname, "ctor?:") {
          if sig_ctor_query_is_ambig(
              cname,
              local_enums,
              local_enum_variants,
              local_enum_qual_variants,
              local_non_enum_types,
              extern_fns,
              fn_key_idx,
              const_idx,
            ) &&
            !fdef_ambig[dfi] {
            fdef_ambig[dfi] = true
            changed = true
          }
        } else if starts_with_str(cname, "pat?:") {
          let pn = slice_str(cname, 5, cname.length())
          if const_idx.contains(pn) && !fdef_ambig[dfi] {
            fdef_ambig[dfi] = true
            changed = true
          }
        } else if starts_with_str(cname, "mth?:") {
          if !fdef_ambig[dfi] {
            fdef_ambig[dfi] = true
            changed = true
          }
        } else if starts_with_str(cname, "call?:") {
          if !fdef_ambig[dfi] {
            fdef_ambig[dfi] = true
            changed = true
          }
        } else if starts_with_str(cname, ".") {
          let mname_only = slice_str(cname, 1, cname.length())
          if (fn_field_names.contains(mname_only) || trait_method_names.contains(mname_only)) &&
            !fdef_ambig[dfi] {
            fdef_ambig[dfi] = true
            changed = true
          }
          match method_name_to_idxs.get(cname) {
            Some(tidxs) => {
              if tidxs.length() >= 2 && !fdef_ambig[dfi] {
                fdef_ambig[dfi] = true
                changed = true
              }
              let mut ti = 0
              while ti < tidxs.length() {
                if fn_ambig[tidxs[ti]] && !fdef_ambig[dfi] {
                  fdef_ambig[dfi] = true
                  changed = true
                }
                let target_r = fn_reach[tidxs[ti]]
                let mut ri = 0
                while ri < target_r.length() {
                  let k = target_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
                ti = ti + 1
              }
            }
            None => ()
          }
          match fdef_by_method.get(cname) {
            Some(didxs) => {
              let mut dj = 0
              while dj < didxs.length() {
                let d_id = didxs[dj]
                if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                  if fdef_ambig[d_id] && !fdef_ambig[dfi] {
                    fdef_ambig[dfi] = true
                    changed = true
                  }
                  let dr = fdef_reach[d_id]
                  let mut ri = 0
                  while ri < dr.length() {
                    let k = dr[ri]
                    if !rmap.contains(k) {
                      rmap.set(k, true)
                      rlist.push(k)
                      changed = true
                    }
                    ri = ri + 1
                  }
                }
                dj = dj + 1
              }
            }
            None => ()
          }
        } else {
          match fn_key_idx.get(cname) {
            Some(tidx) => {
              if fn_ambig[tidx] && !fdef_ambig[dfi] {
                fdef_ambig[dfi] = true
                changed = true
              }
              let target_r = fn_reach[tidx]
              let mut ri = 0
              while ri < target_r.length() {
                let k = target_r[ri]
                if !rmap.contains(k) {
                  rmap.set(k, true)
                  rlist.push(k)
                  changed = true
                }
                ri = ri + 1
              }
            }
            None => ()
          }
          match fdef_by_fn.get(cname) {
            Some(didxs) => {
              let mut dj = 0
              while dj < didxs.length() {
                let d_id = didxs[dj]
                if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                  if fdef_ambig[d_id] && !fdef_ambig[dfi] {
                    fdef_ambig[dfi] = true
                    changed = true
                  }
                  let dr = fdef_reach[d_id]
                  let mut ri = 0
                  while ri < dr.length() {
                    let k = dr[ri]
                    if !rmap.contains(k) {
                      rmap.set(k, true)
                      rlist.push(k)
                      changed = true
                    }
                    ri = ri + 1
                  }
                }
                dj = dj + 1
              }
            }
            None => ()
          }
        }
        let eff_slots : Array[String] = []
        let eff_targets : Array[String] = []
        sig_collect_call_effective_cbs(
          desc,
          fdef_by_fn,
          fdef_by_method,
          fdef_fn,
          fdef_param_idx,
          fdef_param_name,
          fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
          eff_slots,
          eff_targets,
        )
        let mut cbi = 0
        while cbi < eff_slots.length() {
          if sig_target_calls_slot(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_called_params,
            fn_unknown_callp,
          ) {
            match fn_key_idx.get(eff_targets[cbi]) {
              Some(cb_tidx) => {
                if fn_ambig[cb_tidx] && !fdef_ambig[dfi] {
                  fdef_ambig[dfi] = true
                  changed = true
                }
                let cb_r = fn_reach[cb_tidx]
                let mut ri = 0
                while ri < cb_r.length() {
                  let k = cb_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
              }
              None => ()
            }
          }
          let rdepths : Array[Int] = []
          sig_lookup_call_ret_depths(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_called_ret_depths,
            rdepths,
          )
          let mut rdi3 = 0
          while rdi3 < rdepths.length() {
            let rt = sig_repeat_ret_prefix(rdepths[rdi3], eff_targets[cbi])
            match fn_key_idx.get(rt) {
              Some(cb_tidx) => {
                if fn_ambig[cb_tidx] && !fdef_ambig[dfi] {
                  fdef_ambig[dfi] = true
                  changed = true
                }
                let cb_r = fn_reach[cb_tidx]
                let mut ri = 0
                while ri < cb_r.length() {
                  let k = cb_r[ri]
                  if !rmap.contains(k) {
                    rmap.set(k, true)
                    rlist.push(k)
                    changed = true
                  }
                  ri = ri + 1
                }
              }
              None => ()
            }
            rdi3 = rdi3 + 1
          }
          if sig_target_has_any_ret_depth(
            cname,
            eff_slots[cbi],
            fn_keys,
            fn_key_idx,
            method_name_to_idxs,
            fn_pnames,
            fn_any_ret_depth,
          ) {
            let tr_idxs : Array[Int] = []
            sig_collect_transitive_ret_targets(
              eff_targets[cbi],
              fn_key_idx,
              fn_calls,
              fn_aliases,
              tr_idxs,
            )
            let mut tri = 0
            while tri < tr_idxs.length() {
              let cb_tidx = tr_idxs[tri]
              if fn_ambig[cb_tidx] && !fdef_ambig[dfi] {
                fdef_ambig[dfi] = true
                changed = true
              }
              let cb_r = fn_reach[cb_tidx]
              let mut ri = 0
              while ri < cb_r.length() {
                let k = cb_r[ri]
                if !rmap.contains(k) {
                  rmap.set(k, true)
                  rlist.push(k)
                  changed = true
                }
                ri = ri + 1
              }
              tri = tri + 1
            }
          }
          cbi = cbi + 1
        }
        ci = ci + 1
      }
      dfi = dfi + 1
    }
  }

  // Build const -> const dependency graph (deps[i] = list of j that must run before i)
  let deps : Array[Array[Int]] = []
  let dependents : Array[Array[Int]] = []
  let in_deg : Array[Int] = []
  let done : Array[Bool] = []
  let mut has_ambiguous_method = false
  let mut i = 0
  while i < n_consts {
    deps.push([])
    dependents.push([])
    in_deg.push(0)
    done.push(false)
    i = i + 1
  }

  i = 0
  while i < n_consts {
    let seen : Map[Int, Bool] = Map([])
    let ids = const_idents[i]
    let mut j = 0
    while j < ids.length() {
      match const_idx.get(ids[j]) {
        Some(dep_idx) =>
          if !seen.contains(dep_idx) {
            seen.set(dep_idx, true)
            deps[i].push(dep_idx)
            dependents[dep_idx].push(i)
            in_deg[i] = in_deg[i] + 1
          }
        None => ()
      }
      j = j + 1
    }
    let cs = const_calls[i]
    j = 0
    while j < cs.length() {
      let desc = sig_parse_call_desc(cs[j])
      let cname = desc.target
      if starts_with_str(cname, "ctor?:") {
        if sig_ctor_query_is_ambig(
          cname,
          local_enums,
          local_enum_variants,
          local_enum_qual_variants,
          local_non_enum_types,
          extern_fns,
          fn_key_idx,
          const_idx,
        ) {
          has_ambiguous_method = true
        }
      } else if starts_with_str(cname, "pat?:") {
        let pn = slice_str(cname, 5, cname.length())
        if const_idx.contains(pn) {
          has_ambiguous_method = true
        }
      } else if starts_with_str(cname, "mth?:") {
        has_ambiguous_method = true
      } else if starts_with_str(cname, "call?:") {
        has_ambiguous_method = true
      } else if starts_with_str(cname, ".") {
        let mname_only = slice_str(cname, 1, cname.length())
        if fn_field_names.contains(mname_only) || trait_method_names.contains(mname_only) {
          has_ambiguous_method = true
        }
        match method_name_to_idxs.get(cname) {
          Some(tidxs) => {
            if tidxs.length() >= 2 {
              has_ambiguous_method = true
            }
            let mut ti = 0
            while ti < tidxs.length() {
              if fn_ambig[tidxs[ti]] {
                has_ambiguous_method = true
              }
              let target_r = fn_reach[tidxs[ti]]
              let mut ri = 0
              while ri < target_r.length() {
                let dep_idx = target_r[ri]
                if !seen.contains(dep_idx) {
                  seen.set(dep_idx, true)
                  deps[i].push(dep_idx)
                  dependents[dep_idx].push(i)
                  in_deg[i] = in_deg[i] + 1
                }
                ri = ri + 1
              }
              ti = ti + 1
            }
          }
          None => ()
        }
        match fdef_by_method.get(cname) {
          Some(didxs) => {
            let mut dj = 0
            while dj < didxs.length() {
              let d_id = didxs[dj]
              if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                if fdef_ambig[d_id] {
                  has_ambiguous_method = true
                }
                let dr = fdef_reach[d_id]
                let mut ri = 0
                while ri < dr.length() {
                  let dep_idx = dr[ri]
                  if !seen.contains(dep_idx) {
                    seen.set(dep_idx, true)
                    deps[i].push(dep_idx)
                    dependents[dep_idx].push(i)
                    in_deg[i] = in_deg[i] + 1
                  }
                  ri = ri + 1
                }
              }
              dj = dj + 1
            }
          }
          None => ()
        }
      } else {
        match fn_key_idx.get(cname) {
          Some(tidx) => {
            if fn_ambig[tidx] {
              has_ambiguous_method = true
            }
            let target_r = fn_reach[tidx]
            let mut ri = 0
            while ri < target_r.length() {
              let dep_idx = target_r[ri]
              if !seen.contains(dep_idx) {
                seen.set(dep_idx, true)
                deps[i].push(dep_idx)
                dependents[dep_idx].push(i)
                in_deg[i] = in_deg[i] + 1
              }
              ri = ri + 1
            }
          }
          None => ()
        }
        match fdef_by_fn.get(cname) {
          Some(didxs) => {
            let mut dj = 0
            while dj < didxs.length() {
              let d_id = didxs[dj]
              if sig_fdef_triggered(desc, fdef_param_idx[d_id], fdef_param_name[d_id]) {
                if fdef_ambig[d_id] {
                  has_ambiguous_method = true
                }
                let dr = fdef_reach[d_id]
                let mut ri = 0
                while ri < dr.length() {
                  let dep_idx = dr[ri]
                  if !seen.contains(dep_idx) {
                    seen.set(dep_idx, true)
                    deps[i].push(dep_idx)
                    dependents[dep_idx].push(i)
                    in_deg[i] = in_deg[i] + 1
                  }
                  ri = ri + 1
                }
              }
              dj = dj + 1
            }
          }
          None => ()
        }
      }
      let eff_slots : Array[String] = []
      let eff_targets : Array[String] = []
      sig_collect_call_effective_cbs(
        desc,
        fdef_by_fn,
        fdef_by_method,
        fdef_fn,
        fdef_param_idx,
        fdef_param_name,
        fdef_cb_targets,
        fdef_pcalls,
        fn_key_idx,
        fn_pnames,
        eff_slots,
        eff_targets,
      )
      let mut cbi = 0
      while cbi < eff_slots.length() {
        if sig_target_calls_slot(
          cname,
          eff_slots[cbi],
          fn_keys,
          fn_key_idx,
          method_name_to_idxs,
          fn_pnames,
          fn_called_params,
          fn_unknown_callp,
        ) {
          match fn_key_idx.get(eff_targets[cbi]) {
            Some(cb_tidx) => {
              if fn_ambig[cb_tidx] {
                has_ambiguous_method = true
              }
              let cb_r = fn_reach[cb_tidx]
              let mut ri = 0
              while ri < cb_r.length() {
                let dep_idx = cb_r[ri]
                if !seen.contains(dep_idx) {
                  seen.set(dep_idx, true)
                  deps[i].push(dep_idx)
                  dependents[dep_idx].push(i)
                  in_deg[i] = in_deg[i] + 1
                }
                ri = ri + 1
              }
            }
            None => ()
          }
        }
        let rdepths : Array[Int] = []
        sig_lookup_call_ret_depths(
          cname,
          eff_slots[cbi],
          fn_keys,
          fn_key_idx,
          method_name_to_idxs,
          fn_pnames,
          fn_called_ret_depths,
          rdepths,
        )
        let mut rdi3 = 0
        while rdi3 < rdepths.length() {
          let rt = sig_repeat_ret_prefix(rdepths[rdi3], eff_targets[cbi])
          match fn_key_idx.get(rt) {
            Some(cb_tidx) => {
              if fn_ambig[cb_tidx] {
                has_ambiguous_method = true
              }
              let cb_r = fn_reach[cb_tidx]
              let mut ri = 0
              while ri < cb_r.length() {
                let dep_idx = cb_r[ri]
                if !seen.contains(dep_idx) {
                  seen.set(dep_idx, true)
                  deps[i].push(dep_idx)
                  dependents[dep_idx].push(i)
                  in_deg[i] = in_deg[i] + 1
                }
                ri = ri + 1
              }
            }
            None => ()
          }
          rdi3 = rdi3 + 1
        }
        if sig_target_has_any_ret_depth(
          cname,
          eff_slots[cbi],
          fn_keys,
          fn_key_idx,
          method_name_to_idxs,
          fn_pnames,
          fn_any_ret_depth,
        ) {
          let tr_idxs : Array[Int] = []
          sig_collect_transitive_ret_targets(
            eff_targets[cbi],
            fn_key_idx,
            fn_calls,
            fn_aliases,
            tr_idxs,
          )
          let mut tri = 0
          while tri < tr_idxs.length() {
            let cb_tidx = tr_idxs[tri]
            if fn_ambig[cb_tidx] {
              has_ambiguous_method = true
            }
            let cb_r = fn_reach[cb_tidx]
            let mut ri = 0
            while ri < cb_r.length() {
              let dep_idx = cb_r[ri]
              if !seen.contains(dep_idx) {
                seen.set(dep_idx, true)
                deps[i].push(dep_idx)
                dependents[dep_idx].push(i)
                in_deg[i] = in_deg[i] + 1
              }
              ri = ri + 1
            }
            tri = tri + 1
          }
        }
        cbi = cbi + 1
      }
      j = j + 1
    }
    i = i + 1
  }

  // Stable Kahn's topological sort (tie-break by smallest source index: file order + decl order)
  let order : Array[String] = []
  while order.length() < n_consts {
    let mut pick = -1
    let mut k = 0
    while k < n_consts {
      if !done[k] && in_deg[k] == 0 {
        pick = k
        break
      }
      k = k + 1
    }
    if pick < 0 {
      break
    }
    done[pick] = true
    order.push(const_names[pick])
    let dep_of = dependents[pick]
    let mut di = 0
    while di < dep_of.length() {
      let nxt = dep_of[di]
      in_deg[nxt] = in_deg[nxt] - 1
      di = di + 1
    }
  }

  let mut has_cycle = false
  let mut cycle_path : Array[String] = []
  if order.length() < n_consts {
    has_cycle = true
    let color : Array[Int] = []
    let mut k = 0
    while k < n_consts {
      color.push(0)
      k = k + 1
    }
    k = 0
    while k < n_consts {
      if !done[k] && color[k] == 0 {
        let stk : Array[Int] = []
        let cyc = sig_find_const_cycle_dfs(k, deps, done, color, stk, const_names)
        if cyc.length() > 0 {
          cycle_path = cyc
          break
        }
      }
      k = k + 1
    }
    // Append remaining unscheduled nodes in source order as fallback
    k = 0
    while k < n_consts {
      if !done[k] {
        order.push(const_names[k])
      }
      k = k + 1
    }
  }

  // Deterministic hash of topological order + per-const dependency summary (for hot CAS invalidation)
  let ph = StringBuilder()
  let mut oi = 0
  while oi < order.length() {
    if oi > 0 {
      ph.write_string(",")
    }
    ph.write_string(order[oi])
    oi = oi + 1
  }
  ph.write_string(";")
  i = 0
  while i < n_consts {
    ph.write_string(const_names[i])
    ph.write_string("=")
    let dnames : Array[String] = []
    let mut j = 0
    while j < deps[i].length() {
      dnames.push(const_names[deps[i][j]])
      j = j + 1
    }
    sig_sort_strs(dnames)
    j = 0
    while j < dnames.length() {
      if j > 0 {
        ph.write_string(",")
      }
      ph.write_string(dnames[j])
      j = j + 1
    }
    ph.write_string(";")
    i = i + 1
  }
  ConstInitPlan::{
    order: order,
    has_cycle: has_cycle,
    cycle_path: cycle_path,
    plan_hash: cas_sha256_hex(ph.to_string()),
    has_ambiguous_method: has_ambiguous_method,
  }
}

///|
pub struct ConstInitDemandResult {
  plan : ConstInitPlan
  stage : Int
  scanned_fns : Int
  total_fns : Int
  fallback_reason : String
}

///|
let SIG_DEMAND_VERIFY : AtomicInt = AtomicInt::new(0)

///|
let SIG_DEMAND_FORCE_FULL : AtomicInt = AtomicInt::new(0)

///|
let SIG_DEMAND_TRACE : AtomicInt = AtomicInt::new(0)

///|
let SIG_DEMAND_TRACE_LOG : Mutex[Array[String]] = Mutex::new([])

///|
pub fn sig_set_verify_demand(enabled : Bool) -> Unit {
  SIG_DEMAND_VERIFY.store(if enabled { 1 } else { 0 })
}

///|
pub fn sig_set_force_full(enabled : Bool) -> Unit {
  SIG_DEMAND_FORCE_FULL.store(if enabled { 1 } else { 0 })
}

///|
pub fn sig_set_trace_demand(enabled : Bool) -> Unit {
  SIG_DEMAND_TRACE.store(if enabled { 1 } else { 0 })
}

///|
pub fn sig_take_demand_trace_lines() -> Array[String] {
  let out : Array[String] = []
  let log = SIG_DEMAND_TRACE_LOG.lock()
  let mut i = 0
  while i < log.length() {
    out.push(log[i])
    i = i + 1
  }
  let mut k = log.length()
  while k > 0 {
    let _ = log.pop()
    k = k - 1
  }
  SIG_DEMAND_TRACE_LOG.unlock()
  out
}

///|
fn sig_str_arrays_equal(a : Array[String], b : Array[String]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

///|
pub fn sig_const_init_plans_equal(a : ConstInitPlan, b : ConstInitPlan) -> Bool {
  sig_str_arrays_equal(a.order, b.order) &&
  a.has_cycle == b.has_cycle &&
  sig_str_arrays_equal(a.cycle_path, b.cycle_path) &&
  a.plan_hash == b.plan_hash &&
  a.has_ambiguous_method == b.has_ambiguous_method
}

///|
fn sig_const_init_plan_debug_str(p : ConstInitPlan) -> String {
  let sb = StringBuilder()
  sb.write_string("order=[")
  let mut i = 0
  while i < p.order.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(p.order[i])
    i = i + 1
  }
  sb.write_string("] cycle=")
  sb.write_string(p.has_cycle.to_string())
  sb.write_string(" path=[")
  i = 0
  while i < p.cycle_path.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(p.cycle_path[i])
    i = i + 1
  }
  sb.write_string("] hash=")
  sb.write_string(p.plan_hash)
  sb.write_string(" ambig=")
  sb.write_string(p.has_ambiguous_method.to_string())
  sb.to_string()
}

///|
pub fn compute_const_init_plan_from_pkg_tc_full(
  pkg : Package,
  tc : TypeChecker,
) -> ConstInitPlan {
  let file_sigs : Array[String] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    file_sigs.push(emit_file_sig_entries_resolved(pkg.files[fi], tc.resolved_method_calls))
    fi = fi + 1
  }
  compute_const_init_plan_from_sigs(file_sigs)
}

///|
struct SigDemandRetState {
  fret_targets : Map[String, Array[String]]
  falias_rhs : Map[String, String]
  fslot_targets : Map[String, Array[String]]
  rev_alias_slot : Map[String, Array[String]]
  rev_fwd : Map[String, Array[String]]
  ret_needed : Map[String, Bool]
  ret_trans : Map[String, Bool]
  retp_needed : Map[String, Bool]
  retp_trans : Map[String, Bool]
  call_cb_args : Map[String, Array[String]]
  fdef_cb_args : Map[String, Array[String]]
  all_falias_lhs : Map[String, Bool]
  pending_ret_keys : Array[String]
  pending_ret_trans : Array[Bool]
  pending_retp_keys : Array[String]
  pending_retp_trans : Array[Bool]
}

///|
fn sig_demand_ret_state_new() -> SigDemandRetState {
  SigDemandRetState::{
    fret_targets: Map([]),
    falias_rhs: Map([]),
    fslot_targets: Map([]),
    rev_alias_slot: Map([]),
    rev_fwd: Map([]),
    ret_needed: Map([]),
    ret_trans: Map([]),
    retp_needed: Map([]),
    retp_trans: Map([]),
    call_cb_args: Map([]),
    fdef_cb_args: Map([]),
    all_falias_lhs: Map([]),
    pending_ret_keys: [],
    pending_ret_trans: [],
    pending_retp_keys: [],
    pending_retp_trans: [],
  }
}

///|
fn sig_demand_push_ret(rs : SigDemandRetState, tok : String, is_trans : Bool) -> Unit {
  if tok.length() == 0 || tok == "?" || tok == "$fp" {
    return
  }
  let mut cur = tok
  let mut depth = 0
  while starts_with_str(cur, "$ret:") {
    depth = depth + 1
    cur = slice_str(cur, 5, cur.length())
  }
  let trans = is_trans || depth > 0
  if starts_with_str(cur, "$retp:") {
    let (fn_name, pidx_s) = sig_demand_split_retp(slice_str(cur, 6, cur.length()))
    if fn_name.length() > 0 && pidx_s.length() > 0 {
      rs.pending_retp_keys.push(fn_name + "|" + pidx_s)
      rs.pending_retp_trans.push(trans)
    }
  } else if cur.length() > 0 {
    rs.pending_ret_keys.push(cur)
    rs.pending_ret_trans.push(trans)
  }
}

///|
fn sig_demand_push_retp(rs : SigDemandRetState, key : String, is_trans : Bool) -> Unit {
  if key.length() == 0 {
    return
  }
  rs.pending_retp_keys.push(key)
  rs.pending_retp_trans.push(is_trans)
}

///|
fn sig_demand_enqueue_ret_tok_if_needed(rs : SigDemandRetState, raw_tok : String) -> Bool {
  if starts_with_str(raw_tok, "$ret:") {
    let inner = slice_str(raw_tok, 5, raw_tok.length())
    sig_demand_push_ret(rs, inner, false)
    return true
  }
  if starts_with_str(raw_tok, "$retp:") {
    let (fn_name, pidx_s) = sig_demand_split_retp(slice_str(raw_tok, 6, raw_tok.length()))
    if fn_name.length() > 0 && pidx_s.length() > 0 {
      sig_demand_push_retp(rs, fn_name + "|" + pidx_s, false)
    }
    return true
  }
  false
}

///|
fn sig_demand_fire_retp_for_cb(
  rs : SigDemandRetState,
  callee : String,
  slot_k : String,
  cbt : String,
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
) -> Unit {
  let candidates : Array[String] = []
  if starts_with_str(callee, ".") {
    match method_by_bare.get(callee) {
      Some(idxs) => {
        let mut i = 0
        while i < idxs.length() {
          candidates.push(fn_key_arr[idxs[i]])
          i = i + 1
        }
      }
      None => ()
    }
  } else {
    candidates.push(callee)
  }
  let mut ci = 0
  while ci < candidates.length() {
    let cname = candidates[ci]
    let pref = cname + "|"
    let rkeys = rs.retp_needed.keys()
    let mut ri = 0
    while ri < rkeys.length() {
      let rk = rkeys[ri]
      if starts_with_str(rk, pref) {
        let pidx_s = slice_str(rk, pref.length(), rk.length())
        if sig_demand_slot_matches_pidx(cname, pidx_s, slot_k, fn_by_key, fn_decl_arr) {
          sig_demand_push_ret(rs, cbt, rs.retp_trans.contains(rk))
        }
      }
      ri = ri + 1
    }
    ci = ci + 1
  }
}

///|
fn sig_demand_map_push_unique(m : Map[String, Array[String]], k : String, v : String) -> Unit {
  if k.length() == 0 || v.length() == 0 {
    return
  }
  match m.get(k) {
    Some(arr) => {
      let mut i = 0
      while i < arr.length() {
        if arr[i] == v {
          return
        }
        i = i + 1
      }
      arr.push(v)
    }
    None => m.set(k, [v])
  }
}

///|
fn sig_demand_split_retp(rest : String) -> (String, String) {
  let tilde = sig_demand_find_last_char(rest, 126)
  if tilde > 0 && tilde + 1 < rest.length() {
    (slice_str(rest, 0, tilde), slice_str(rest, tilde + 1, rest.length()))
  } else {
    ("", "")
  }
}

///|
fn sig_demand_bare_method_of(fn_key : String) -> String {
  let sep = sig_find_char(fn_key, 58, 0)
  if sep > 0 && sep + 2 < fn_key.length() && str_code_at(fn_key, sep + 1) == 58 {
    "." + slice_str(fn_key, sep + 2, fn_key.length())
  } else {
    ""
  }
}

///|
fn sig_demand_slot_matches_pidx(
  fn_key : String,
  pidx_s : String,
  slot_k : String,
  fn_by_key : Map[String, Array[Int]],
  fn_decl_arr : Array[FnDecl],
) -> Bool {
  if slot_k == pidx_s {
    return true
  }
  if sig_is_digits(slot_k) {
    return false
  }
  match fn_by_key.get(fn_key) {
    Some(idxs) => {
      let pidx = sig_parse_nonneg_int(pidx_s)
      let mut i = 0
      while i < idxs.length() {
        let fd = fn_decl_arr[idxs[i]]
        if pidx >= 0 && pidx < fd.params.length() && fd.params[pidx].name == slot_k {
          return true
        }
        i = i + 1
      }
      false
    }
    None => false
  }
}

///|
fn sig_demand_check_fallback_tok(tok : String) -> String {
  let mut cur = tok
  while starts_with_str(cur, "$ret:") {
    cur = slice_str(cur, 5, cur.length())
  }
  if starts_with_str(cur, "cf:") ||
  starts_with_str(cur, "cf?:") ||
  starts_with_str(cur, "fw:") ||
  starts_with_str(cur, "fp:") {
    return "field_call:" + tok
  }
  ""
}

///|
fn sig_demand_strip_prefixes(raw : String) -> String {
  let mut s = raw
  let mut changed = true
  while changed {
    changed = false
    if starts_with_str(s, "$ret:") {
      s = slice_str(s, 5, s.length())
      changed = true
    } else if starts_with_str(s, "$retp:") {
      s = slice_str(s, 6, s.length())
      changed = true
    } else if starts_with_str(s, "cf?:") {
      s = slice_str(s, 4, s.length())
      changed = true
    } else if starts_with_str(s, "cf:") {
      s = slice_str(s, 3, s.length())
      changed = true
    } else if starts_with_str(s, "fw:") {
      s = slice_str(s, 3, s.length())
      changed = true
    } else if starts_with_str(s, "fp:") {
      s = slice_str(s, 3, s.length())
      changed = true
    } else if starts_with_str(s, "ctor?:") {
      s = slice_str(s, 6, s.length())
      changed = true
    } else if starts_with_str(s, "call?:") {
      s = slice_str(s, 6, s.length())
      changed = true
    } else if starts_with_str(s, "@ci:") {
      s = slice_str(s, 4, s.length())
      changed = true
    } else if starts_with_str(s, "@fdef:") {
      let rest = slice_str(s, 6, s.length())
      let tilde = sig_find_char(rest, 126, 0)
      s = if tilde > 0 { slice_str(rest, 0, tilde) } else { rest }
      changed = true
    }
  }
  s
}

///|
fn sig_demand_const_aux_owner(line : String) -> String {
  if starts_with_str(line, "#fdep ") {
    let p1 = sig_find_char(line, 124, 6)
    if p1 > 6 {
      return slice_str(line, 6, p1)
    }
  } else if starts_with_str(line, "#falias ") {
    let p1 = sig_find_char(line, 124, 8)
    if p1 > 8 {
      return slice_str(line, 8, p1)
    }
  } else if starts_with_str(line, "#cfalias ") {
    let p1 = sig_find_char(line, 124, 9)
    if p1 > 9 {
      return slice_str(line, 9, p1)
    }
  } else if starts_with_str(line, "#cfdef ") {
    let p1 = sig_find_char(line, 124, 7)
    if p1 > 7 {
      let cf = slice_str(line, 7, p1)
      let dot = sig_find_char(cf, 46, 0)
      return if dot > 0 { slice_str(cf, 0, dot) } else { cf }
    }
  } else if starts_with_str(line, "#cfspread ") {
    let p1 = sig_find_char(line, 124, 10)
    if p1 > 10 {
      return slice_str(line, 10, p1)
    }
  } else if starts_with_str(line, "#fret ") {
    let p1 = sig_find_char(line, 124, 6)
    if p1 > 6 {
      return slice_str(line, 6, p1)
    }
  } else if starts_with_str(line, "#fcallp ") {
    let p1 = sig_find_char(line, 124, 8)
    if p1 > 8 {
      return slice_str(line, 8, p1)
    }
  } else if starts_with_str(line, "#fslot ") {
    let p1 = sig_find_char(line, 124, 7)
    if p1 > 7 {
      return slice_str(line, 7, p1)
    }
  } else if starts_with_str(line, "#fmutw ") {
    let p1 = sig_find_char(line, 124, 7)
    if p1 > 7 {
      return slice_str(line, 7, p1)
    }
  } else if starts_with_str(line, "#fmutfwd ") {
    let p1 = sig_find_char(line, 124, 9)
    if p1 > 9 {
      return slice_str(line, 9, p1)
    }
  } else if starts_with_str(line, "#fmutlink ") {
    let p1 = sig_find_char(line, 124, 10)
    if p1 > 10 {
      return slice_str(line, 10, p1)
    }
  } else if starts_with_str(line, "#fcbw ") {
    let p1 = sig_find_char(line, 124, 6)
    if p1 > 6 {
      return slice_str(line, 6, p1)
    }
  } else if starts_with_str(line, "#fcbfwd ") {
    let p1 = sig_find_char(line, 124, 8)
    if p1 > 8 {
      return slice_str(line, 8, p1)
    }
  } else if starts_with_str(line, "#fcbcall ") {
    let p1 = sig_find_char(line, 124, 9)
    if p1 > 9 {
      return slice_str(line, 9, p1)
    }
  } else if starts_with_str(line, "#fcbcallfwd ") {
    let p1 = sig_find_char(line, 124, 12)
    if p1 > 12 {
      return slice_str(line, 12, p1)
    }
  } else if starts_with_str(line, "#fieldw ") || starts_with_str(line, "#fieldp ") {
    let p1 = sig_find_char(line, 124, 8)
    if p1 > 8 {
      return slice_str(line, 8, p1)
    }
  } else if starts_with_str(line, "#fieldwp ") || starts_with_str(line, "#fieldpp ") {
    let p1 = sig_find_char(line, 124, 9)
    if p1 > 9 {
      return slice_str(line, 9, p1)
    }
  }
  ""
}

///|
fn sig_demand_find_last_char(s : String, ch : Int) -> Int {
  let mut i = s.length() - 1
  while i >= 0 {
    if str_code_at(s, i) == ch {
      return i
    }
    i = i - 1
  }
  -1
}

///|
/// Return `"<fn_key>|<pidx>"` if `line` belongs to a default-argument summary
/// (`#fdef`, `#fdefcb`, `#fdefpcall`, `#fdeffwd`) or any synthetic helper emitted
/// by `def_ctx` (`@fdef:<fn_key>~<pi>` / `fdef_<fn_key>_<pi>_*`, e.g. `$cb_fdef_`,
/// `$slot_fdef_`, `$cslot_fdef_`, `$cslot_hub_fdef_`) of `fn_key`, else `""`.
fn sig_demand_fdef_slot_of_line(line : String, fn_key : String) -> String {
  let off = if starts_with_str(line, "#fdef ") {
    6
  } else if starts_with_str(line, "#fdefcb ") {
    8
  } else if starts_with_str(line, "#fdefpcall ") {
    11
  } else if starts_with_str(line, "#fdeffwd ") {
    9
  } else {
    -1
  }
  if off > 0 {
    let p1 = sig_find_char(line, 124, off)
    if p1 > off && slice_str(line, off, p1) == fn_key {
      let p2 = sig_find_char(line, 124, p1 + 1)
      if p2 > p1 + 1 {
        let pidx_s = slice_str(line, p1 + 1, p2)
        if sig_is_digits(pidx_s) {
          return fn_key + "|" + pidx_s
        }
      }
    }
  }
  let owner = sig_demand_const_aux_owner(line)
  if owner.length() == 0 {
    return ""
  }
  let mut stripped = owner
  let mut peeling = true
  while peeling {
    if starts_with_str(stripped, "$cslot_hub_") {
      stripped = slice_str(stripped, 11, stripped.length())
    } else if starts_with_str(stripped, "$cslot_") {
      stripped = slice_str(stripped, 7, stripped.length())
    } else if starts_with_str(stripped, "$slot_") {
      stripped = slice_str(stripped, 6, stripped.length())
    } else if starts_with_str(stripped, "$cb_") {
      stripped = slice_str(stripped, 4, stripped.length())
    } else {
      peeling = false
    }
  }
  let at_prefix = "@fdef:" + fn_key + "~"
  if starts_with_str(stripped, at_prefix) {
    let pidx_s = slice_str(stripped, at_prefix.length(), stripped.length())
    if sig_is_digits(pidx_s) {
      return fn_key + "|" + pidx_s
    }
  }
  let fdef_tag = "fdef_" + fn_key + "_"
  if starts_with_str(stripped, fdef_tag) {
    let start = fdef_tag.length()
    if start < stripped.length() {
      let us = sig_find_char(stripped, 95, start)
      if us > start {
        let pidx_s = slice_str(stripped, start, us)
        if sig_is_digits(pidx_s) {
          return fn_key + "|" + pidx_s
        }
      }
    }
  }
  ""
}

///|
fn sig_demand_activate_fdef_slot(
  slot_key : String,
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  bfs_lines : Array[String],
) -> Unit {
  if fdef_active_slots.contains(slot_key) {
    return
  }
  fdef_active_slots.set(slot_key, true)
  match fdef_lines_by_slot.get(slot_key) {
    Some(lines) => {
      let mut i = 0
      while i < lines.length() {
        bfs_lines.push(lines[i])
        i = i + 1
      }
    }
    None => ()
  }
}

///|
fn sig_demand_mark_all_fdefs_active(
  fidx : Int,
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  bfs_lines : Array[String],
) -> Unit {
  let fkey = fn_key_arr[fidx]
  if fdef_all_active_fns.contains(fkey) {
    return
  }
  fdef_all_active_fns.set(fkey, true)
  let fd = fn_decl_arr[fidx]
  let mut pi = 0
  while pi < fd.params.length() {
    match fd.params[pi].default_expr {
      Some(_) =>
        sig_demand_activate_fdef_slot(
          fkey + "|" + pi.to_string(),
          fdef_active_slots,
          fdef_lines_by_slot,
          bfs_lines,
        )
      None => ()
    }
    pi = pi + 1
  }
}

///|
fn sig_demand_apply_call_desc_to_fdefs(
  fidx : Int,
  desc : SigCallDesc,
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  bfs_lines : Array[String],
) -> Unit {
  if !desc.has_at {
    sig_demand_mark_all_fdefs_active(
      fidx,
      fn_key_arr,
      fn_decl_arr,
      fdef_all_active_fns,
      fdef_active_slots,
      fdef_lines_by_slot,
      bfs_lines,
    )
    return
  }
  let fkey = fn_key_arr[fidx]
  if fdef_all_active_fns.contains(fkey) {
    return
  }
  let fd = fn_decl_arr[fidx]
  let mut pi = 0
  while pi < fd.params.length() {
    match fd.params[pi].default_expr {
      Some(_) =>
        if sig_fdef_triggered(desc, pi, fd.params[pi].name) {
          sig_demand_activate_fdef_slot(
            fkey + "|" + pi.to_string(),
            fdef_active_slots,
            fdef_lines_by_slot,
            bfs_lines,
          )
        }
      None => ()
    }
    pi = pi + 1
  }
}

///|
fn sig_demand_scan_fn_idx(
  fidx : Int,
  activate_all_fdefs : Bool,
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
  resolved_methods : Map[String, String],
  bfs_lines : Array[String],
  scanned_ref : Array[Int],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  fn_observed_calls : Map[String, Array[SigCallDesc]],
) -> Unit {
  let fkey = fn_key_arr[fidx]
  if !visited_fn[fidx] {
    visited_fn[fidx] = true
    let sb = StringBuilder()
    sig_emit_fn_dep_line(sb, fkey, fn_decl_arr[fidx], resolved_methods, true)
    let text = sb.to_string()
    fn_sig_cache[fidx] = text
    scanned_ref[0] = scanned_ref[0] + 1
    let ls = split_lines(text)
    let mut i = 0
    while i < ls.length() {
      let line = ls[i]
      if line.length() > 0 {
        let fslot = sig_demand_fdef_slot_of_line(line, fkey)
        if fslot.length() > 0 {
          match fdef_lines_by_slot.get(fslot) {
            Some(arr) => arr.push(line)
            None => fdef_lines_by_slot.set(fslot, [line])
          }
          if fdef_all_active_fns.contains(fkey) || fdef_active_slots.contains(fslot) {
            bfs_lines.push(line)
          }
        } else {
          bfs_lines.push(line)
        }
      }
      i = i + 1
    }
    match fn_observed_calls.get(fkey) {
      Some(descs) => {
        let mut di = 0
        while di < descs.length() {
          sig_demand_apply_call_desc_to_fdefs(
            fidx,
            descs[di],
            fn_key_arr,
            fn_decl_arr,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            bfs_lines,
          )
          di = di + 1
        }
      }
      None => ()
    }
  }
  if activate_all_fdefs {
    sig_demand_mark_all_fdefs_active(
      fidx,
      fn_key_arr,
      fn_decl_arr,
      fdef_all_active_fns,
      fdef_active_slots,
      fdef_lines_by_slot,
      bfs_lines,
    )
  }
}

///|
fn sig_demand_activate_key(
  key : String,
  allow_const_aux : Bool,
  activate_all_fdefs : Bool,
  const_aux_lines : Map[String, Array[String]],
  activated_const_aux : Map[String, Bool],
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
  resolved_methods : Map[String, String],
  bfs_lines : Array[String],
  scanned_ref : Array[Int],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  fn_observed_calls : Map[String, Array[SigCallDesc]],
) -> Unit {
  if key.length() == 0 {
    return
  }
  if allow_const_aux && !activated_const_aux.contains(key) {
    match const_aux_lines.get(key) {
      Some(aux) => {
        activated_const_aux.set(key, true)
        let mut ai = 0
        while ai < aux.length() {
          bfs_lines.push(aux[ai])
          ai = ai + 1
        }
      }
      None => ()
    }
  }
  if starts_with_str(key, ".") {
    match method_by_bare.get(key) {
      Some(idxs) => {
        let mut i = 0
        while i < idxs.length() {
          sig_demand_scan_fn_idx(
            idxs[i],
            activate_all_fdefs,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            resolved_methods,
            bfs_lines,
            scanned_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
          )
          i = i + 1
        }
      }
      None => ()
    }
    // Full planner indexes synthetic closure keys `$cb_fn_T::orig_k` under `.orig_k`
    // in `method_name_to_idxs` (via `::` split). When a bare method `.m` ends with
    // `_<digits>` (including nested `_<d1>_<d2>`), also scan any host method `T::<prefix>`
    // so its synthetic closure keys are exposed identically to the full planner.
    let mut cur_m = slice_str(key, 1, key.length())
    let mut strip_more = true
    while strip_more {
      strip_more = false
      let us = sig_demand_find_last_char(cur_m, 95)
      if us > 0 && us + 1 < cur_m.length() {
        let tail = slice_str(cur_m, us + 1, cur_m.length())
        if sig_is_digits(tail) {
          cur_m = slice_str(cur_m, 0, us)
          strip_more = true
          match method_by_bare.get("." + cur_m) {
            Some(pidxs) => {
              let mut pi = 0
              while pi < pidxs.length() {
                sig_demand_scan_fn_idx(
                  pidxs[pi],
                  true,
                  fn_key_arr,
                  fn_decl_arr,
                  visited_fn,
                  fn_sig_cache,
                  resolved_methods,
                  bfs_lines,
                  scanned_ref,
                  fdef_all_active_fns,
                  fdef_active_slots,
                  fdef_lines_by_slot,
                  fn_observed_calls,
                )
                pi = pi + 1
              }
            }
            None => ()
          }
        }
      }
    }
  } else {
    match fn_by_key.get(key) {
      Some(idxs) => {
        let mut i = 0
        while i < idxs.length() {
          sig_demand_scan_fn_idx(
            idxs[i],
            activate_all_fdefs,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            resolved_methods,
            bfs_lines,
            scanned_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
          )
          i = i + 1
        }
      }
      None => ()
    }
  }
}

///|
fn sig_demand_enqueue_tok(
  raw_tok : String,
  allow_const_aux : Bool,
  activate_all_fdefs : Bool,
  const_aux_lines : Map[String, Array[String]],
  activated_const_aux : Map[String, Bool],
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
  resolved_methods : Map[String, String],
  bfs_lines : Array[String],
  scanned_ref : Array[Int],
  fallback_ref : Array[String],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  fn_observed_calls : Map[String, Array[SigCallDesc]],
  ret_state : SigDemandRetState,
) -> Unit {
  if raw_tok.length() == 0 || fallback_ref[0].length() > 0 {
    return
  }
  let fb = sig_demand_check_fallback_tok(raw_tok)
  if fb.length() > 0 {
    fallback_ref[0] = fb
    return
  }
  let _ = sig_demand_enqueue_ret_tok_if_needed(ret_state, raw_tok)
  sig_demand_activate_key(
    raw_tok,
    allow_const_aux,
    activate_all_fdefs,
    const_aux_lines,
    activated_const_aux,
    fn_by_key,
    method_by_bare,
    fn_key_arr,
    fn_decl_arr,
    visited_fn,
    fn_sig_cache,
    resolved_methods,
    bfs_lines,
    scanned_ref,
    fdef_all_active_fns,
    fdef_active_slots,
    fdef_lines_by_slot,
    fn_observed_calls,
  )
  let stripped = sig_demand_strip_prefixes(raw_tok)
  if stripped != raw_tok {
    sig_demand_activate_key(
      stripped,
      allow_const_aux,
      activate_all_fdefs,
      const_aux_lines,
      activated_const_aux,
      fn_by_key,
      method_by_bare,
      fn_key_arr,
      fn_decl_arr,
      visited_fn,
      fn_sig_cache,
      resolved_methods,
      bfs_lines,
      scanned_ref,
      fdef_all_active_fns,
      fdef_active_slots,
      fdef_lines_by_slot,
      fn_observed_calls,
    )
  }
}

///|
fn sig_demand_enqueue_call_desc(
  raw_desc : String,
  const_aux_lines : Map[String, Array[String]],
  activated_const_aux : Map[String, Bool],
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
  resolved_methods : Map[String, String],
  bfs_lines : Array[String],
  scanned_ref : Array[Int],
  fallback_ref : Array[String],
  ret_cb_callees : Array[String],
  ret_cb_slots : Array[String],
  ret_cb_toks : Array[String],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  fn_observed_calls : Map[String, Array[SigCallDesc]],
  ret_state : SigDemandRetState,
) -> Unit {
  if raw_desc.length() == 0 || fallback_ref[0].length() > 0 {
    return
  }
  let desc = sig_parse_call_desc(raw_desc)
  // When `desc.has_at` is true, activate only the default-arg slots actually omitted
  // by this call site (rather than unconditionally activating every `#fdef*` of `desc.target`).
  sig_demand_enqueue_tok(
    desc.target,
    true,
    !desc.has_at,
    const_aux_lines,
    activated_const_aux,
    fn_by_key,
    method_by_bare,
    fn_key_arr,
    fn_decl_arr,
    visited_fn,
    fn_sig_cache,
    resolved_methods,
    bfs_lines,
    scanned_ref,
    fallback_ref,
    fdef_all_active_fns,
    fdef_active_slots,
    fdef_lines_by_slot,
    fn_observed_calls,
    ret_state,
  )
  if fallback_ref[0].length() == 0 && desc.has_at {
    let tgt_idxs_opt = if starts_with_str(desc.target, ".") {
      method_by_bare.get(desc.target)
    } else {
      fn_by_key.get(desc.target)
    }
    match tgt_idxs_opt {
      Some(tidxs) => {
        let mut ti = 0
        while ti < tidxs.length() {
          let fidx = tidxs[ti]
          let fkey = fn_key_arr[fidx]
          match fn_observed_calls.get(fkey) {
            Some(arr) => arr.push(desc)
            None => fn_observed_calls.set(fkey, [desc])
          }
          sig_demand_apply_call_desc_to_fdefs(
            fidx,
            desc,
            fn_key_arr,
            fn_decl_arr,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            bfs_lines,
          )
          ti = ti + 1
        }
      }
      None => ()
    }
  }
  let mut i = 0
  while i < desc.cb_targets.length() && fallback_ref[0].length() == 0 {
    let cbt = desc.cb_targets[i]
    let slot_k = if i < desc.cb_slots.length() { desc.cb_slots[i] } else { "" }
    if slot_k.length() > 0 && cbt.length() > 0 {
      sig_demand_map_push_unique(ret_state.call_cb_args, desc.target, slot_k + "|" + cbt)
      if ret_state.retp_needed.length() > 0 {
        sig_demand_fire_retp_for_cb(
          ret_state,
          desc.target,
          slot_k,
          cbt,
          fn_by_key,
          method_by_bare,
          fn_key_arr,
          fn_decl_arr,
        )
      }
    }
    if starts_with_str(cbt, "$ret:") || starts_with_str(cbt, "$retp:") {
      // Defer `$ret:`/`$retp:` callback arguments: only activate if `desc.target`
      // actually invokes or forwards this parameter slot (avoids scanning unneeded
      // return targets on plain value calls like `ref_new(mk_val())`).
      ret_cb_callees.push(desc.target)
      ret_cb_slots.push(slot_k)
      ret_cb_toks.push(cbt)
      let inner = sig_demand_strip_prefixes(cbt)
      if inner.length() > 0 {
        sig_demand_activate_key(
          inner,
          true,
          true,
          const_aux_lines,
          activated_const_aux,
          fn_by_key,
          method_by_bare,
          fn_key_arr,
          fn_decl_arr,
          visited_fn,
          fn_sig_cache,
          resolved_methods,
          bfs_lines,
          scanned_ref,
          fdef_all_active_fns,
          fdef_active_slots,
          fdef_lines_by_slot,
          fn_observed_calls,
        )
      }
    } else {
      sig_demand_enqueue_tok(
        cbt,
        true,
        true,
        const_aux_lines,
        activated_const_aux,
        fn_by_key,
        method_by_bare,
        fn_key_arr,
        fn_decl_arr,
        visited_fn,
        fn_sig_cache,
        resolved_methods,
        bfs_lines,
        scanned_ref,
        fallback_ref,
        fdef_all_active_fns,
        fdef_active_slots,
        fdef_lines_by_slot,
        fn_observed_calls,
        ret_state,
      )
    }
    i = i + 1
  }
}

///|
fn sig_demand_fn_has_fret(fn_sig_text : String) -> Bool {
  let lines = split_lines(fn_sig_text)
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    if starts_with_str(line, "#fret ") {
      let p1 = sig_find_char(line, 124, 6)
      if p1 > 6 && p1 + 1 < line.length() {
        return true
      }
    }
    li = li + 1
  }
  false
}

///|
fn sig_demand_ret_tok_is_empty_local(
  rtok : String,
  fn_by_key : Map[String, Array[Int]],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
) -> Bool {
  if !starts_with_str(rtok, "$ret:") {
    return false
  }
  let inner = slice_str(rtok, 5, rtok.length())
  if starts_with_str(inner, "$ret:") || starts_with_str(inner, "$retp:") {
    return false
  }
  match fn_by_key.get(inner) {
    Some(idxs) => {
      if idxs.length() == 0 {
        return false
      }
      let mut i = 0
      while i < idxs.length() {
        let fidx = idxs[i]
        if !visited_fn[fidx] || sig_demand_fn_has_fret(fn_sig_cache[fidx]) {
          return false
        }
        i = i + 1
      }
      true
    }
    None => false
  }
}

///|
fn sig_demand_fn_uses_slot(
  fn_sig_text : String,
  fn_key : String,
  slot_key : String,
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
) -> String {
  if slot_key == "@fdefcall" {
    return "fdefcall"
  }
  let all_fdef = fdef_all_active_fns.contains(fn_key)
  let lines = split_lines(fn_sig_text)
  let mut li = 0
  while li < lines.length() {
    let line = lines[li]
    if starts_with_str(line, "#fcallp ") {
      let p1 = sig_find_char(line, 124, 8)
      if p1 > 8 && slice_str(line, 8, p1) == fn_key {
        let p2 = sig_find_char(line, 124, p1 + 1)
        if p2 > p1 {
          let p3 = sig_find_char(line, 124, p2 + 1)
          if p3 > p2 {
            let pnames = sig_split_csv(slice_str(line, p1 + 1, p2))
            let pidx = sig_slot_to_pidx(pnames, slot_key)
            if pidx < 0 {
              return "bad_slot(" + slot_key + ")"
            }
            let pidx_s = pidx.to_string()
            let dc = sig_split_csv(slice_str(line, p2 + 1, p3))
            let mut di = 0
            while di < dc.length() {
              if dc[di] == pidx_s {
                return "dc(" + pidx_s + "," + line + ")"
              }
              di = di + 1
            }
            let fw = sig_split_csv(slice_str(line, p3 + 1, line.length()))
            let mut fi = 0
            while fi < fw.length() {
              let g1 = sig_find_char(fw[fi], 62, 0)
              if g1 > 0 && slice_str(fw[fi], 0, g1) == pidx_s {
                return "fw(" + fw[fi] + ")"
              }
              fi = fi + 1
            }
          }
        }
      }
    } else if starts_with_str(line, "#fdefpcall ") ||
    starts_with_str(line, "#fdeffwd ") ||
    starts_with_str(line, "#fcbcall ") ||
    starts_with_str(line, "#fcbcallfwd ") ||
    starts_with_str(line, "#fieldwp ") ||
    starts_with_str(line, "#fieldpp ") {
      let fslot = sig_demand_fdef_slot_of_line(line, fn_key)
      if fslot.length() == 0 || all_fdef || fdef_active_slots.contains(fslot) {
        return "aux(" + line + ")"
      }
    }
    li = li + 1
  }
  ""
}

///|
fn sig_demand_enqueue_fwd_edges(
  owner : String,
  edges_csv : String,
  const_aux_lines : Map[String, Array[String]],
  activated_const_aux : Map[String, Bool],
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  visited_fn : Array[Bool],
  fn_sig_cache : Array[String],
  resolved_methods : Map[String, String],
  bfs_lines : Array[String],
  scanned_ref : Array[Int],
  fallback_ref : Array[String],
  fdef_all_active_fns : Map[String, Bool],
  fdef_active_slots : Map[String, Bool],
  fdef_lines_by_slot : Map[String, Array[String]],
  fn_observed_calls : Map[String, Array[SigCallDesc]],
  ret_state : SigDemandRetState,
) -> Unit {
  let edges = sig_split_csv(edges_csv)
  let mut ei = 0
  while ei < edges.length() && fallback_ref[0].length() == 0 {
    let edge = edges[ei]
    let g1 = sig_find_char(edge, 62, 0)
    if g1 > 0 {
      let g2 = sig_find_char(edge, 62, g1 + 1)
      if g2 > g1 + 1 && g2 + 1 < edge.length() {
        let my_pidx_s = slice_str(edge, 0, g1)
        let tgt = slice_str(edge, g1 + 1, g2)
        let slot = slice_str(edge, g2 + 1, edge.length())
        if owner.length() > 0 && my_pidx_s.length() > 0 {
          let src_k = owner + "|" + my_pidx_s
          sig_demand_map_push_unique(ret_state.rev_fwd, tgt + "|" + slot, src_k)
          if starts_with_str(tgt, ".") {
            match method_by_bare.get(tgt) {
              Some(idxs) => {
                let mut mi = 0
                while mi < idxs.length() {
                  let tfk = fn_key_arr[idxs[mi]]
                  sig_demand_map_push_unique(ret_state.rev_fwd, tfk + "|" + slot, src_k)
                  let fd = fn_decl_arr[idxs[mi]]
                  let mut pi = 0
                  while pi < fd.params.length() {
                    if fd.params[pi].name == slot || pi.to_string() == slot {
                      let tk = tfk + "|" + pi.to_string()
                      sig_demand_map_push_unique(ret_state.rev_fwd, tk, src_k)
                      if ret_state.retp_needed.contains(tk) {
                        sig_demand_push_retp(ret_state, src_k, ret_state.retp_trans.contains(tk))
                      }
                    }
                    pi = pi + 1
                  }
                  mi = mi + 1
                }
              }
              None => ()
            }
          } else {
            let tk0 = tgt + "|" + slot
            if ret_state.retp_needed.contains(tk0) {
              sig_demand_push_retp(ret_state, src_k, ret_state.retp_trans.contains(tk0))
            }
            match fn_by_key.get(tgt) {
              Some(idxs) => {
                let mut fi2 = 0
                while fi2 < idxs.length() {
                  let fd = fn_decl_arr[idxs[fi2]]
                  let mut pi = 0
                  while pi < fd.params.length() {
                    if fd.params[pi].name == slot || pi.to_string() == slot {
                      let tk = tgt + "|" + pi.to_string()
                      sig_demand_map_push_unique(ret_state.rev_fwd, tk, src_k)
                      if ret_state.retp_needed.contains(tk) {
                        sig_demand_push_retp(ret_state, src_k, ret_state.retp_trans.contains(tk))
                      }
                    }
                    pi = pi + 1
                  }
                  fi2 = fi2 + 1
                }
              }
              None => ()
            }
          }
        }
        sig_demand_enqueue_tok(
          tgt,
          true,
          true,
          const_aux_lines,
          activated_const_aux,
          fn_by_key,
          method_by_bare,
          fn_key_arr,
          fn_decl_arr,
          visited_fn,
          fn_sig_cache,
          resolved_methods,
          bfs_lines,
          scanned_ref,
          fallback_ref,
          fdef_all_active_fns,
          fdef_active_slots,
          fdef_lines_by_slot,
          fn_observed_calls,
          ret_state,
        )
      }
    }
    ei = ei + 1
  }
}

///|
fn sig_demand_register_local_fn(
  fkey : String,
  fd : FnDecl,
  fn_key_arr : Array[String],
  fn_decl_arr : Array[FnDecl],
  fn_by_key : Map[String, Array[Int]],
  method_by_bare : Map[String, Array[Int]],
) -> Int {
  let idx = fn_key_arr.length()
  fn_key_arr.push(fkey)
  fn_decl_arr.push(fd)
  match fn_by_key.get(fkey) {
    Some(arr) => arr.push(idx)
    None => fn_by_key.set(fkey, [idx])
  }
  let sep = sig_find_char(fkey, 58, 0)
  if sep > 0 && sep + 2 < fkey.length() && str_code_at(fkey, sep + 1) == 58 {
    let mk = "." + slice_str(fkey, sep + 2, fkey.length())
    match method_by_bare.get(mk) {
      Some(arr) => arr.push(idx)
      None => method_by_bare.set(mk, [idx])
    }
  }
  idx
}

///|
pub fn compute_const_init_plan_from_pkg_tc_with_stats(
  pkg : Package,
  tc : TypeChecker,
) -> ConstInitDemandResult {
  let fn_key_arr : Array[String] = []
  let fn_decl_arr : Array[FnDecl] = []
  let fn_by_key : Map[String, Array[Int]] = Map([])
  let method_by_bare : Map[String, Array[Int]] = Map([])
  let decl_fn_idxs : Array[Array[Array[Int]]] = []
  let const_file_sigs : Array[String] = []
  let const_decl_texts : Array[Array[String]] = []
  let mut const_count = 0

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let f_const_sb = StringBuilder()
    let f_decl_fns : Array[Array[Int]] = []
    let f_const_texts : Array[String] = []
    let mut di = 0
    while di < f.decls.length() {
      let d_fns : Array[Int] = []
      let mut d_const_text = ""
      match f.decls[di] {
        DFn(fd) => {
          let fkey = if fd.receiver_type.length() > 0 {
            fd.receiver_type + "::" + fd.name
          } else {
            fd.name
          }
          d_fns.push(
            sig_demand_register_local_fn(
              fkey,
              fd,
              fn_key_arr,
              fn_decl_arr,
              fn_by_key,
              method_by_bare,
            ),
          )
        }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            let md = id.methods[mi]
            d_fns.push(
              sig_demand_register_local_fn(
                id.target_type + "::" + md.name,
                md,
                fn_key_arr,
                fn_decl_arr,
                fn_by_key,
                method_by_bare,
              ),
            )
            mi = mi + 1
          }
        }
        DConst(cd) => {
          const_count = const_count + 1
          let csb = StringBuilder()
          sig_emit_const_decl_entries(csb, cd, tc.resolved_method_calls, true)
          d_const_text = csb.to_string()
          f_const_sb.write_string(d_const_text)
        }
        _ => ()
      }
      f_decl_fns.push(d_fns)
      f_const_texts.push(d_const_text)
      di = di + 1
    }
    decl_fn_idxs.push(f_decl_fns)
    const_decl_texts.push(f_const_texts)
    const_file_sigs.push(f_const_sb.to_string())
    fi = fi + 1
  }

  let total_fns = fn_key_arr.length()
  if const_count == 0 {
    return ConstInitDemandResult::{
      plan: ConstInitPlan::{
        order: [],
        has_cycle: false,
        cycle_path: [],
        plan_hash: "",
        has_ambiguous_method: false,
      },
      stage: 0,
      scanned_fns: 0,
      total_fns: total_fns,
      fallback_reason: "",
    }
  }

  // Stage 1: zero-call fast path before scanning any DFn/DImpl body.
  match sig_const_rows_without_calls(const_file_sigs) {
    Some(rows) =>
    return ConstInitDemandResult::{
      plan: compute_const_init_plan_from_sigs(rows),
      stage: 1,
      scanned_fns: 0,
      total_fns: total_fns,
      fallback_reason: "",
    }
    None => ()
  }

  // Stage 2: demand-driven BFS seeded strictly from `#cdep` rows.
  let const_aux_lines : Map[String, Array[String]] = Map([])
  let activated_const_aux : Map[String, Bool] = Map([])
  let bfs_lines : Array[String] = []
  let fallback_ref : Array[String] = [""]
  fi = 0
  while fi < const_file_sigs.length() && fallback_ref[0].length() == 0 {
    let lines = split_lines(const_file_sigs[fi])
    let mut li = 0
    while li < lines.length() && fallback_ref[0].length() == 0 {
      let line = lines[li]
      if starts_with_str(line, "#cdep ") {
        bfs_lines.push(line)
      } else if starts_with_str(line, "#") && !starts_with_str(line, "#derive(") {
        let owner = sig_demand_const_aux_owner(line)
        if owner.length() > 0 {
          match const_aux_lines.get(owner) {
            Some(arr) => arr.push(line)
            None => const_aux_lines.set(owner, [line])
          }
        } else {
          fallback_ref[0] = "unknown_const_tag:" + line
        }
      }
      li = li + 1
    }
    fi = fi + 1
  }

  let visited_fn : Array[Bool] = []
  let fn_sig_cache : Array[String] = []
  let mut k0 = 0
  while k0 < total_fns {
    visited_fn.push(false)
    fn_sig_cache.push("")
    k0 = k0 + 1
  }
  let scanned_ref : Array[Int] = [0]
  let ret_cb_callees : Array[String] = []
  let ret_cb_slots : Array[String] = []
  let ret_cb_toks : Array[String] = []
  let ret_cb_activated : Array[Bool] = []
  let fdef_all_active_fns : Map[String, Bool] = Map([])
  let fdef_active_slots : Map[String, Bool] = Map([])
  let fdef_lines_by_slot : Map[String, Array[String]] = Map([])
  let fn_observed_calls : Map[String, Array[SigCallDesc]] = Map([])
  let ret_state = sig_demand_ret_state_new()

  let mut head = 0
  let mut outer_progress = true
  while outer_progress && fallback_ref[0].length() == 0 {
    outer_progress = false
    while (head < bfs_lines.length() ||
    ret_state.pending_ret_keys.length() > 0 ||
    ret_state.pending_retp_keys.length() > 0) &&
    fallback_ref[0].length() == 0 {
      if ret_state.pending_ret_keys.length() > 0 {
        let owner = ret_state.pending_ret_keys[ret_state.pending_ret_keys.length() - 1]
        let is_trans = ret_state.pending_ret_trans[ret_state.pending_ret_trans.length() - 1]
        let _ = ret_state.pending_ret_keys.pop()
        let _ = ret_state.pending_ret_trans.pop()
        let already = if is_trans {
          ret_state.ret_trans.contains(owner)
        } else {
          ret_state.ret_needed.contains(owner) || ret_state.ret_trans.contains(owner)
        }
        if !already {
          ret_state.ret_needed.set(owner, true)
          if is_trans {
            ret_state.ret_trans.set(owner, true)
          }
          sig_demand_enqueue_tok(
            owner,
            true,
            true,
            const_aux_lines,
            activated_const_aux,
            fn_by_key,
            method_by_bare,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            tc.resolved_method_calls,
            bfs_lines,
            scanned_ref,
            fallback_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
            ret_state,
          )
          match ret_state.fret_targets.get(owner) {
            Some(ts) => {
              let mut ti = 0
              while ti < ts.length() && fallback_ref[0].length() == 0 {
                sig_demand_enqueue_tok(
                  ts[ti],
                  true,
                  true,
                  const_aux_lines,
                  activated_const_aux,
                  fn_by_key,
                  method_by_bare,
                  fn_key_arr,
                  fn_decl_arr,
                  visited_fn,
                  fn_sig_cache,
                  tc.resolved_method_calls,
                  bfs_lines,
                  scanned_ref,
                  fallback_ref,
                  fdef_all_active_fns,
                  fdef_active_slots,
                  fdef_lines_by_slot,
                  fn_observed_calls,
                  ret_state,
                )
                if is_trans {
                  sig_demand_push_ret(ret_state, ts[ti], true)
                }
                ti = ti + 1
              }
            }
            None => ()
          }
          match ret_state.falias_rhs.get(owner) {
            Some(rhs) => sig_demand_push_ret(ret_state, rhs, is_trans)
            None => ()
          }
          match ret_state.fslot_targets.get(owner) {
            Some(sts) => {
              let mut si = 0
              while si < sts.length() {
                sig_demand_push_ret(ret_state, sts[si], is_trans)
                si = si + 1
              }
            }
            None => ()
          }
          if starts_with_str(owner, ".") {
            match method_by_bare.get(owner) {
              Some(idxs) => {
                let mut mi = 0
                while mi < idxs.length() {
                  sig_demand_push_ret(ret_state, fn_key_arr[idxs[mi]], is_trans)
                  mi = mi + 1
                }
              }
              None => ()
            }
          }
        }
        continue
      }
      if ret_state.pending_retp_keys.length() > 0 {
        let rpk = ret_state.pending_retp_keys[ret_state.pending_retp_keys.length() - 1]
        let is_trans = ret_state.pending_retp_trans[ret_state.pending_retp_trans.length() - 1]
        let _ = ret_state.pending_retp_keys.pop()
        let _ = ret_state.pending_retp_trans.pop()
        let already = if is_trans {
          ret_state.retp_trans.contains(rpk)
        } else {
          ret_state.retp_needed.contains(rpk) || ret_state.retp_trans.contains(rpk)
        }
        if !already {
          ret_state.retp_needed.set(rpk, true)
          if is_trans {
            ret_state.retp_trans.set(rpk, true)
          }
          let bar = sig_find_char(rpk, 124, 0)
          if bar > 0 && bar + 1 < rpk.length() {
            let fn_name = slice_str(rpk, 0, bar)
            let pidx_s = slice_str(rpk, bar + 1, rpk.length())
            sig_demand_enqueue_tok(
              fn_name,
              true,
              true,
              const_aux_lines,
              activated_const_aux,
              fn_by_key,
              method_by_bare,
              fn_key_arr,
              fn_decl_arr,
              visited_fn,
              fn_sig_cache,
              tc.resolved_method_calls,
              bfs_lines,
              scanned_ref,
              fallback_ref,
              fdef_all_active_fns,
              fdef_active_slots,
              fdef_lines_by_slot,
              fn_observed_calls,
              ret_state,
            )
            match ret_state.rev_alias_slot.get(fn_name) {
              Some(srcs) => {
                let mut si = 0
                while si < srcs.length() {
                  sig_demand_push_retp(ret_state, srcs[si] + "|" + pidx_s, is_trans)
                  si = si + 1
                }
              }
              None => ()
            }
            match ret_state.rev_fwd.get(rpk) {
              Some(outers) => {
                let mut oi = 0
                while oi < outers.length() {
                  sig_demand_push_retp(ret_state, outers[oi], is_trans)
                  oi = oi + 1
                }
              }
              None => ()
            }
            let bare_m = sig_demand_bare_method_of(fn_name)
            if bare_m.length() > 0 {
              match ret_state.rev_fwd.get(bare_m + "|" + pidx_s) {
                Some(outers) => {
                  let mut oi = 0
                  while oi < outers.length() {
                    sig_demand_push_retp(ret_state, outers[oi], is_trans)
                    oi = oi + 1
                  }
                }
                None => ()
              }
            }
            match ret_state.call_cb_args.get(fn_name) {
              Some(args) => {
                let mut ai = 0
                while ai < args.length() {
                  let item = args[ai]
                  let sp = sig_find_char(item, 124, 0)
                  if sp > 0 && sp + 1 < item.length() {
                    let sk = slice_str(item, 0, sp)
                    let cbt = slice_str(item, sp + 1, item.length())
                    if sig_demand_slot_matches_pidx(fn_name, pidx_s, sk, fn_by_key, fn_decl_arr) {
                      sig_demand_push_ret(ret_state, cbt, is_trans)
                    }
                  }
                  ai = ai + 1
                }
              }
              None => ()
            }
            if bare_m.length() > 0 {
              match ret_state.call_cb_args.get(bare_m) {
                Some(args) => {
                  let mut ai = 0
                  while ai < args.length() {
                    let item = args[ai]
                    let sp = sig_find_char(item, 124, 0)
                    if sp > 0 && sp + 1 < item.length() {
                      let sk = slice_str(item, 0, sp)
                      let cbt = slice_str(item, sp + 1, item.length())
                      if sig_demand_slot_matches_pidx(fn_name, pidx_s, sk, fn_by_key, fn_decl_arr) {
                        sig_demand_push_ret(ret_state, cbt, is_trans)
                      }
                    }
                    ai = ai + 1
                  }
                }
                None => ()
              }
            }
            match ret_state.fdef_cb_args.get(rpk) {
              Some(dargs) => {
                let mut di = 0
                while di < dargs.length() {
                  sig_demand_push_ret(ret_state, dargs[di], is_trans)
                  di = di + 1
                }
              }
              None => ()
            }
          }
        }
        continue
      }
      let line = bfs_lines[head]
      head = head + 1
      if !starts_with_str(line, "#") || starts_with_str(line, "#derive(") {
        continue
      }
      if starts_with_str(line, "#cdep ") || starts_with_str(line, "#fdep ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let id_arr = sig_split_csv(slice_str(line, p1 + 1, p2))
            let ca_arr = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            let mut ii = 0
            while ii < id_arr.length() && fallback_ref[0].length() == 0 {
              sig_demand_enqueue_tok(
                id_arr[ii],
                false,
                false,
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
              ii = ii + 1
            }
            let mut ci = 0
            while ci < ca_arr.length() && fallback_ref[0].length() == 0 {
              sig_demand_enqueue_call_desc(
                ca_arr[ci],
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                ret_cb_callees,
                ret_cb_slots,
                ret_cb_toks,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
              ci = ci + 1
            }
          }
        }
      } else if starts_with_str(line, "#fdef ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 {
              let p4 = sig_find_char(line, 124, p3 + 1)
              if p4 > p3 {
                let id_arr = sig_split_csv(slice_str(line, p3 + 1, p4))
                let ca_arr = sig_split_csv(slice_str(line, p4 + 1, line.length()))
                let mut ii = 0
                while ii < id_arr.length() && fallback_ref[0].length() == 0 {
                  sig_demand_enqueue_tok(
                    id_arr[ii],
                    false,
                    false,
                    const_aux_lines,
                    activated_const_aux,
                    fn_by_key,
                    method_by_bare,
                    fn_key_arr,
                    fn_decl_arr,
                    visited_fn,
                    fn_sig_cache,
                    tc.resolved_method_calls,
                    bfs_lines,
                    scanned_ref,
                    fallback_ref,
                    fdef_all_active_fns,
                    fdef_active_slots,
                    fdef_lines_by_slot,
                    fn_observed_calls,
                    ret_state,
                  )
                  ii = ii + 1
                }
                let mut ci = 0
                while ci < ca_arr.length() && fallback_ref[0].length() == 0 {
                  sig_demand_enqueue_call_desc(
                    ca_arr[ci],
                    const_aux_lines,
                    activated_const_aux,
                    fn_by_key,
                    method_by_bare,
                    fn_key_arr,
                    fn_decl_arr,
                    visited_fn,
                    fn_sig_cache,
                    tc.resolved_method_calls,
                    bfs_lines,
                    scanned_ref,
                    fallback_ref,
                    ret_cb_callees,
                    ret_cb_slots,
                    ret_cb_toks,
                    fdef_all_active_fns,
                    fdef_active_slots,
                    fdef_lines_by_slot,
                    fn_observed_calls,
                    ret_state,
                  )
                  ci = ci + 1
                }
              }
            }
          }
        }
      } else if starts_with_str(line, "#fdefcb ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let fdef_owner = slice_str(line, 8, p1)
            let fdef_pidx = slice_str(line, p1 + 1, p2)
            let fdef_k = fdef_owner + "|" + fdef_pidx
            let dt = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            let mut dti = 0
            while dti < dt.length() && fallback_ref[0].length() == 0 {
              if !starts_with_str(dt[dti], "$p") {
                sig_demand_map_push_unique(ret_state.fdef_cb_args, fdef_k, dt[dti])
                if ret_state.retp_needed.contains(fdef_k) {
                  sig_demand_push_ret(ret_state, dt[dti], ret_state.retp_trans.contains(fdef_k))
                }
                sig_demand_enqueue_tok(
                  dt[dti],
                  true,
                  true,
                  const_aux_lines,
                  activated_const_aux,
                  fn_by_key,
                  method_by_bare,
                  fn_key_arr,
                  fn_decl_arr,
                  visited_fn,
                  fn_sig_cache,
                  tc.resolved_method_calls,
                  bfs_lines,
                  scanned_ref,
                  fallback_ref,
                  fdef_all_active_fns,
                  fdef_active_slots,
                  fdef_lines_by_slot,
                  fn_observed_calls,
                  ret_state,
                )
              }
              dti = dti + 1
            }
          }
        }
      } else if starts_with_str(line, "#fdefpcall ") {
        ()
      } else if starts_with_str(line, "#fdeffwd ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            sig_demand_enqueue_fwd_edges(
              slice_str(line, 9, p1),
              slice_str(line, p2 + 1, line.length()),
              const_aux_lines,
              activated_const_aux,
              fn_by_key,
              method_by_bare,
              fn_key_arr,
              fn_decl_arr,
              visited_fn,
              fn_sig_cache,
              tc.resolved_method_calls,
              bfs_lines,
              scanned_ref,
              fallback_ref,
              fdef_all_active_fns,
              fdef_active_slots,
              fdef_lines_by_slot,
              fn_observed_calls,
              ret_state,
            )
          }
        }
      } else if starts_with_str(line, "#fcallp ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 {
              sig_demand_enqueue_fwd_edges(
                slice_str(line, 8, p1),
                slice_str(line, p3 + 1, line.length()),
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
            }
          }
        }
      } else if starts_with_str(line, "#falias ") {
        let p1 = sig_find_char(line, 124, 8)
        if p1 > 8 && p1 + 1 < line.length() {
          let lhs = slice_str(line, 8, p1)
          let rhs = slice_str(line, p1 + 1, line.length())
          ret_state.falias_rhs.set(lhs, rhs)
          ret_state.all_falias_lhs.set(lhs, true)
          sig_demand_map_push_unique(ret_state.rev_alias_slot, rhs, lhs)
          if ret_state.ret_trans.contains(lhs) {
            sig_demand_push_ret(ret_state, rhs, true)
          } else if ret_state.ret_needed.contains(lhs) {
            sig_demand_push_ret(ret_state, rhs, false)
          }
          if ret_state.retp_needed.length() > 0 {
            let pref = rhs + "|"
            let rkeys = ret_state.retp_needed.keys()
            let mut rki = 0
            while rki < rkeys.length() {
              let rk = rkeys[rki]
              if starts_with_str(rk, pref) {
                let suf = slice_str(rk, pref.length(), rk.length())
                sig_demand_push_retp(ret_state, lhs + "|" + suf, ret_state.retp_trans.contains(rk))
              }
              rki = rki + 1
            }
          }
          sig_demand_enqueue_tok(
            rhs,
            true,
            true,
            const_aux_lines,
            activated_const_aux,
            fn_by_key,
            method_by_bare,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            tc.resolved_method_calls,
            bfs_lines,
            scanned_ref,
            fallback_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
            ret_state,
          )
        }
      } else if starts_with_str(line, "#cfalias ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 && p1 + 1 < line.length() {
          sig_demand_enqueue_tok(
            slice_str(line, p1 + 1, line.length()),
            true,
            true,
            const_aux_lines,
            activated_const_aux,
            fn_by_key,
            method_by_bare,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            tc.resolved_method_calls,
            bfs_lines,
            scanned_ref,
            fallback_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
            ret_state,
          )
        }
      } else if starts_with_str(line, "#cfspread ") {
        let p1 = sig_find_char(line, 124, 10)
        if p1 > 10 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 {
            sig_demand_enqueue_tok(
              slice_str(line, p1 + 1, p2),
              true,
              true,
              const_aux_lines,
              activated_const_aux,
              fn_by_key,
              method_by_bare,
              fn_key_arr,
              fn_decl_arr,
              visited_fn,
              fn_sig_cache,
              tc.resolved_method_calls,
              bfs_lines,
              scanned_ref,
              fallback_ref,
              fdef_all_active_fns,
              fdef_active_slots,
              fdef_lines_by_slot,
              fn_observed_calls,
              ret_state,
            )
          }
        }
      } else if starts_with_str(line, "#cfdef ") {
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 {
          let ts = sig_split_csv(slice_str(line, p1 + 1, line.length()))
          let mut ti = 0
          while ti < ts.length() && fallback_ref[0].length() == 0 {
            if ts[ti] != "?" && ts[ti] != "$fp" {
              sig_demand_enqueue_tok(
                ts[ti],
                true,
                true,
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
            }
            ti = ti + 1
          }
        }
      } else if starts_with_str(line, "#fret ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 && p1 + 1 < line.length() {
          let owner = slice_str(line, 6, p1)
          let ts = sig_split_csv(slice_str(line, p1 + 1, line.length()))
          let is_trans = ret_state.ret_trans.contains(owner)
          let is_needed = is_trans || ret_state.ret_needed.contains(owner)
          let mut ti = 0
          while ti < ts.length() && fallback_ref[0].length() == 0 {
            sig_demand_map_push_unique(ret_state.fret_targets, owner, ts[ti])
            if is_needed {
              sig_demand_enqueue_tok(
                ts[ti],
                true,
                true,
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
              if is_trans {
                sig_demand_push_ret(ret_state, ts[ti], true)
              }
            }
            ti = ti + 1
          }
        }
      } else if starts_with_str(line, "#fslot ") {
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 && p1 + 1 < line.length() {
          let lhs = slice_str(line, 7, p1)
          let ts = sig_split_csv(slice_str(line, p1 + 1, line.length()))
          let is_trans = ret_state.ret_trans.contains(lhs)
          let is_needed = is_trans || ret_state.ret_needed.contains(lhs)
          let mut ti = 0
          while ti < ts.length() && fallback_ref[0].length() == 0 {
            let t = ts[ti]
            sig_demand_map_push_unique(ret_state.fslot_targets, lhs, t)
            sig_demand_map_push_unique(ret_state.rev_alias_slot, t, lhs)
            if is_needed {
              sig_demand_push_ret(ret_state, t, is_trans)
            }
            if ret_state.retp_needed.length() > 0 {
              let pref = t + "|"
              let rkeys = ret_state.retp_needed.keys()
              let mut rki = 0
              while rki < rkeys.length() {
                let rk = rkeys[rki]
                if starts_with_str(rk, pref) {
                  let suf = slice_str(rk, pref.length(), rk.length())
                  sig_demand_push_retp(ret_state, lhs + "|" + suf, ret_state.retp_trans.contains(rk))
                }
                rki = rki + 1
              }
            }
            sig_demand_enqueue_tok(
              t,
              true,
              true,
              const_aux_lines,
              activated_const_aux,
              fn_by_key,
              method_by_bare,
              fn_key_arr,
              fn_decl_arr,
              visited_fn,
              fn_sig_cache,
              tc.resolved_method_calls,
              bfs_lines,
              scanned_ref,
              fallback_ref,
              fdef_all_active_fns,
              fdef_active_slots,
              fdef_lines_by_slot,
              fn_observed_calls,
              ret_state,
            )
            ti = ti + 1
          }
        }
      } else if starts_with_str(line, "#fmutw ") {
        let p1 = sig_find_char(line, 124, 7)
        if p1 > 7 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 && p2 + 1 < line.length() {
            let ts = sig_split_csv(slice_str(line, p2 + 1, line.length()))
            let mut ti = 0
            while ti < ts.length() && fallback_ref[0].length() == 0 {
              sig_demand_enqueue_tok(
                ts[ti],
                true,
                true,
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
              ti = ti + 1
            }
          }
        }
      } else if starts_with_str(line, "#fmutfwd ") {
        let p1 = sig_find_char(line, 124, 9)
        if p1 > 9 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 {
              sig_demand_enqueue_tok(
                slice_str(line, p2 + 1, p3),
                true,
                true,
                const_aux_lines,
                activated_const_aux,
                fn_by_key,
                method_by_bare,
                fn_key_arr,
                fn_decl_arr,
                visited_fn,
                fn_sig_cache,
                tc.resolved_method_calls,
                bfs_lines,
                scanned_ref,
                fallback_ref,
                fdef_all_active_fns,
                fdef_active_slots,
                fdef_lines_by_slot,
                fn_observed_calls,
                ret_state,
              )
            }
          }
        }
      } else if starts_with_str(line, "#fmutlink ") {
        let p1 = sig_find_char(line, 124, 10)
        if p1 > 10 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            sig_demand_enqueue_tok(
              slice_str(line, p1 + 1, p2),
              true,
              true,
              const_aux_lines,
              activated_const_aux,
              fn_by_key,
              method_by_bare,
              fn_key_arr,
              fn_decl_arr,
              visited_fn,
              fn_sig_cache,
              tc.resolved_method_calls,
              bfs_lines,
              scanned_ref,
              fallback_ref,
              fdef_all_active_fns,
              fdef_active_slots,
              fdef_lines_by_slot,
              fn_observed_calls,
              ret_state,
            )
          }
        }
      } else if starts_with_str(line, "#fcbw ") {
        let p1 = sig_find_char(line, 124, 6)
        if p1 > 6 {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 && p3 + 1 < line.length() {
              let ts = sig_split_csv(slice_str(line, p3 + 1, line.length()))
              let mut ti = 0
              while ti < ts.length() && fallback_ref[0].length() == 0 {
                sig_demand_enqueue_tok(
                  ts[ti],
                  true,
                  true,
                  const_aux_lines,
                  activated_const_aux,
                  fn_by_key,
                  method_by_bare,
                  fn_key_arr,
                  fn_decl_arr,
                  visited_fn,
                  fn_sig_cache,
                  tc.resolved_method_calls,
                  bfs_lines,
                  scanned_ref,
                  fallback_ref,
                  fdef_all_active_fns,
                  fdef_active_slots,
                  fdef_lines_by_slot,
                  fn_observed_calls,
                  ret_state,
                )
                ti = ti + 1
              }
            }
          }
        }
      } else if starts_with_str(line, "#fcbfwd ") || starts_with_str(line, "#fcbcallfwd ") {
        let start_off = if starts_with_str(line, "#fcbfwd ") { 8 } else { 12 }
        let p1 = sig_find_char(line, 124, start_off)
        if p1 > start_off {
          let p2 = sig_find_char(line, 124, p1 + 1)
          if p2 > p1 + 1 {
            let p3 = sig_find_char(line, 124, p2 + 1)
            if p3 > p2 + 1 {
              let p4 = sig_find_char(line, 124, p3 + 1)
              if p4 > p3 + 1 {
                sig_demand_enqueue_tok(
                  slice_str(line, p3 + 1, p4),
                  true,
                  true,
                  const_aux_lines,
                  activated_const_aux,
                  fn_by_key,
                  method_by_bare,
                  fn_key_arr,
                  fn_decl_arr,
                  visited_fn,
                  fn_sig_cache,
                  tc.resolved_method_calls,
                  bfs_lines,
                  scanned_ref,
                  fallback_ref,
                  fdef_all_active_fns,
                  fdef_active_slots,
                  fdef_lines_by_slot,
                  fn_observed_calls,
                  ret_state,
                )
              }
            }
          }
        }
      } else if starts_with_str(line, "#fcbcall ") {
        ()
      } else if starts_with_str(line, "#fieldw ") || starts_with_str(line, "#fieldp ") {
        // Field writes/puts are only consumed when a reachable `fw:`/`fp:`/`cf?:` call exists,
        // which already triggers fail-closed fallback on the call site itself.
        ()
      } else if starts_with_str(line, "#fieldwp ") || starts_with_str(line, "#fieldpp ") {
        ()
      } else {
        fallback_ref[0] = "unknown_tag:" + line
      }
    }

    // Validate deferred `$ret:` / `$retp:` callback arguments against scanned callee `#fcallp`
    // and inner function `#fret` presence. When a callee actually uses the slot, activate `rtok`
    // demand-driven instead of falling back to Stage 3.
    if fallback_ref[0].length() == 0 && ret_cb_callees.length() > 0 {
      while ret_cb_activated.length() < ret_cb_callees.length() {
        ret_cb_activated.push(false)
      }
      let mut rci = 0
      while rci < ret_cb_callees.length() && fallback_ref[0].length() == 0 {
        if ret_cb_activated[rci] {
          rci = rci + 1
          continue
        }
        let callee = ret_cb_callees[rci]
        let slot_k = ret_cb_slots[rci]
        let rtok = ret_cb_toks[rci]
        if sig_demand_ret_tok_is_empty_local(rtok, fn_by_key, visited_fn, fn_sig_cache) {
          ret_cb_activated[rci] = true
          rci = rci + 1
          continue
        }
        if callee == "__builtin__::push" ||
        callee == "__builtin__::set" ||
        callee == "__builtin__::insert" ||
        callee == "Array::make" ||
        callee == "FixedArray::make" ||
        callee == "Array::new" ||
        callee == "Array::with_capacity" ||
        callee == "Map::new" ||
        callee == "Map::with_capacity" ||
        callee == "Map" ||
        callee == "Bytes::new" {
          ret_cb_activated[rci] = true
          rci = rci + 1
          continue
        }
        let mut need_activate = false
        if starts_with_str(callee, ".") {
          let mut cur_m = slice_str(callee, 1, callee.length())
          let mut strip_more = true
          while strip_more && !need_activate {
            strip_more = false
            let us = sig_demand_find_last_char(cur_m, 95)
            if us > 0 && us + 1 < cur_m.length() {
              let tail = slice_str(cur_m, us + 1, cur_m.length())
              if sig_is_digits(tail) {
                cur_m = slice_str(cur_m, 0, us)
                strip_more = true
                match method_by_bare.get("." + cur_m) {
                  Some(_) => need_activate = true
                  None => ()
                }
              }
            }
          }
          if !need_activate {
            match method_by_bare.get(callee) {
              Some(idxs) => {
                let mut mi = 0
                while mi < idxs.length() {
                  let why = sig_demand_fn_uses_slot(
                    fn_sig_cache[idxs[mi]],
                    fn_key_arr[idxs[mi]],
                    slot_k,
                    fdef_all_active_fns,
                    fdef_active_slots,
                  )
                  if why.length() > 0 {
                    need_activate = true
                    break
                  }
                  mi = mi + 1
                }
              }
              None => ()
            }
          }
        } else {
          match fn_by_key.get(callee) {
            Some(idxs) => {
              let mut fi2 = 0
              while fi2 < idxs.length() {
                let why = sig_demand_fn_uses_slot(
                  fn_sig_cache[idxs[fi2]],
                  fn_key_arr[idxs[fi2]],
                  slot_k,
                  fdef_all_active_fns,
                  fdef_active_slots,
                )
                if why.length() > 0 {
                  need_activate = true
                  break
                }
                fi2 = fi2 + 1
              }
            }
            None =>
              // Cross-package function (not in local `fn_by_key`, not a local synthetic
              // closure/slot or `#falias` LHS): the full planner has no `#fcallp`/`#fdef`
              // rows for external callees, so it cannot invoke or forward `slot_k`.
              if starts_with_str(callee, "$") ||
              starts_with_str(callee, "@") ||
              const_aux_lines.contains(callee) ||
              ret_state.all_falias_lhs.contains(callee) {
                need_activate = true
              }
          }
        }
        if need_activate {
          ret_cb_activated[rci] = true
          sig_demand_enqueue_tok(
            rtok,
            true,
            true,
            const_aux_lines,
            activated_const_aux,
            fn_by_key,
            method_by_bare,
            fn_key_arr,
            fn_decl_arr,
            visited_fn,
            fn_sig_cache,
            tc.resolved_method_calls,
            bfs_lines,
            scanned_ref,
            fallback_ref,
            fdef_all_active_fns,
            fdef_active_slots,
            fdef_lines_by_slot,
            fn_observed_calls,
            ret_state,
          )
          outer_progress = true
        }
        rci = rci + 1
      }
    }
  }

  // Replay headers, consts, and functions strictly in original (fi, di, mi) order.
  // On fail-closed fallback (`is_fallback`), reuse cached `const_decl_texts` and already-scanned
  // `fn_sig_cache` entries and emit only unvisited functions (at most 1 scan per function body).
  let is_fallback = fallback_ref[0].length() > 0
  let replay_file_sigs : Array[String] = []
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let sb = StringBuilder()
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          sb.write_string(format_struct_sig(sd))
          sb.write_string("\n")
        }
        DEnum(ed) => {
          sb.write_string(format_enum_sig(ed))
          sb.write_string("\n")
        }
        DFn(fd) => {
          let fidx = decl_fn_idxs[fi][di][0]
          if visited_fn[fidx] {
            sb.write_string(format_fn_sig(fd))
            sb.write_string("\n")
            sb.write_string(fn_sig_cache[fidx])
          } else if is_fallback {
            sb.write_string(format_fn_sig(fd))
            sb.write_string("\n")
            sig_emit_fn_dep_line(sb, fn_key_arr[fidx], fd, tc.resolved_method_calls, true)
          }
        }
        DExternFn(ed) => {
          sb.write_string(format_extern_fn_sig(ed))
          sb.write_string("\n")
        }
        DTrait(td) => {
          sb.write_string(format_trait_sig(td))
          sb.write_string("\n")
        }
        DImpl(id) => {
          sb.write_string(format_impl_sig(id))
          sb.write_string("\n")
          let m_idxs = decl_fn_idxs[fi][di]
          let mut mi = 0
          while mi < m_idxs.length() {
            let fidx = m_idxs[mi]
            if visited_fn[fidx] {
              sb.write_string(fn_sig_cache[fidx])
            } else if is_fallback {
              sig_emit_fn_dep_line(sb, fn_key_arr[fidx], fn_decl_arr[fidx], tc.resolved_method_calls, true)
            }
            mi = mi + 1
          }
        }
        DConst(_) => sb.write_string(const_decl_texts[fi][di])
        DTest(_) => ()
      }
      di = di + 1
    }
    replay_file_sigs.push(sb.to_string())
    fi = fi + 1
  }

  ConstInitDemandResult::{
    plan: compute_const_init_plan_from_sigs(replay_file_sigs),
    stage: if is_fallback { 3 } else { 2 },
    scanned_fns: if is_fallback { total_fns } else { scanned_ref[0] },
    total_fns: total_fns,
    fallback_reason: fallback_ref[0],
  }
}

///|
pub fn compute_const_init_plan_from_pkg_tc(
  pkg : Package,
  tc : TypeChecker,
) -> ConstInitPlan {
  if SIG_DEMAND_FORCE_FULL.load() != 0 {
    return compute_const_init_plan_from_pkg_tc_full(pkg, tc)
  }
  let res = compute_const_init_plan_from_pkg_tc_with_stats(pkg, tc)
  if SIG_DEMAND_TRACE.load() != 0 {
    let msg = "[sig-demand] pkg=" + pkg.name +
    " stage=" + res.stage.to_string() +
    " scanned=" + res.scanned_fns.to_string() + "/" + res.total_fns.to_string() +
    " fallback=" + res.fallback_reason
    let log = SIG_DEMAND_TRACE_LOG.lock()
    log.push(msg)
    SIG_DEMAND_TRACE_LOG.unlock()
  }
  if SIG_DEMAND_VERIFY.load() != 0 {
    let full = compute_const_init_plan_from_pkg_tc_full(pkg, tc)
    if !sig_const_init_plans_equal(res.plan, full) {
      panic(
        "PION_SIG_VERIFY_DEMAND mismatch in pkg `" + pkg.name + "`: demand=(" +
        sig_const_init_plan_debug_str(res.plan) + ") vs full=(" +
        sig_const_init_plan_debug_str(full) + ")",
      )
    }
  }
  res.plan
}

///|
/// Cold-path filter for `compute_const_init_plan_from_pkg_tc` (Opt-Track T,
/// `front_const_rows`; Lean: `QbeFrontendColdSpeedOpts.lean`). The resolved
/// per-file summaries are produced in memory, never read from the CAS. When
/// every `#cdep NAME|reads|calls` row has a non-empty name and an empty call
/// column, no call descriptor reaches the function / callback tables, so only
/// `#cdep` rows can add an edge or set `has_ambiguous_method`: return them in
/// their original order (the planner keeps the first record per name, across
/// files) and let the same planner do direct edges, cycles, tie breaking and
/// hashing. Any other row shape (a call, a missing separator, a byte outside
/// printable ASCII) returns `None` and the caller plans over every line.
fn sig_const_rows_without_calls(file_sigs : Array[String]) -> Option[Array[String]] {
  let constant_rows : Array[String] = []
  let mut fi = 0
  while fi < file_sigs.length() {
    let lines = split_lines(file_sigs[fi])
    let mut li = 0
    while li < lines.length() {
      let line = lines[li]
      if starts_with_str(line, "#cdep ") {
        let first = sig_find_char(line, 124, 6)
        if first <= 6 {
          return None
        }
        let second = sig_find_char(line, 124, first + 1)
        if second != line.length() - 1 {
          return None
        }
        let mut k = 6
        while k < line.length() {
          let ch = str_code_at(line, k)
          if ch < 32 || ch >= 127 {
            return None
          }
          k = k + 1
        }
        constant_rows.push(line)
      }
      li = li + 1
    }
    fi = fi + 1
  }
  Some(constant_rows)
}

///|
pub fn compute_const_init_plan_from_pkg(pkg : Package) -> ConstInitPlan {
  let file_sigs : Array[String] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    file_sigs.push(emit_file_sig_entries(pkg.files[fi]))
    fi = fi + 1
  }
  compute_const_init_plan_from_sigs(file_sigs)
}

///|
pub struct FileSigsSummary {
  sigs_hash : String
  const_units : Array[Int]
  const_init_order : Array[String]
  const_has_cycle : Bool
  const_has_ambiguous_method : Bool
  has_main : Bool
}

///|
/// Reconstruct the exact same `sigs_hash` and `const_units` as `cli_prepare_qbe_units`
/// from per-file signature texts (`emit_file_sig_entries`).
pub fn summarize_file_sigs(
  pkg_name : String,
  file_sigs : Array[String],
) -> FileSigsSummary {
  let entries : Array[SigEntry] = []
  let const_units : Array[Int] = []
  let mut has_main = false
  let mut fi = 0
  while fi < file_sigs.length() {
    let lines = split_lines(file_sigs[fi])
    let mut has_const = false
    let mut i = 0
    while i < lines.length() {
      let line = lines[i]
      if line.length() == 0 {
        i = i + 1
        continue
      }
      if starts_with_str(line, "val struct ") {
        entries.push(SigEntry::{
          kind: "struct",
          name: extract_sig_name(line, 11),
          signature: line,
        })
      } else if starts_with_str(line, "struct ") {
        entries.push(SigEntry::{
          kind: "struct",
          name: extract_sig_name(line, 7),
          signature: line,
        })
      } else if starts_with_str(line, "enum ") {
        entries.push(SigEntry::{
          kind: "enum",
          name: extract_sig_name(line, 5),
          signature: line,
        })
      } else if sig_fn_name_offset(line) >= 0 {
        let fname = extract_sig_name(line, sig_fn_name_offset(line))
        if fname == "main" {
          has_main = true
        }
        entries.push(SigEntry::{
          kind: "fn",
          name: fname,
          signature: line,
        })
      } else if starts_with_str(line, "const ") {
        has_const = true
        entries.push(SigEntry::{
          kind: "const",
          name: extract_sig_name(line, 6),
          signature: line,
        })
      } else if starts_with_str(line, "extern \"C\" fn ") {
        entries.push(SigEntry::{
          kind: "extern_fn",
          name: extract_sig_name(line, 14),
          signature: line,
        })
      } else if starts_with_str(line, "trait ") {
        entries.push(SigEntry::{
          kind: "trait",
          name: extract_sig_name(line, 6),
          signature: line,
        })
      } else if starts_with_str(line, "impl ") {
        entries.push(SigEntry::{
          kind: "impl",
          name: extract_sig_name(line, 5),
          signature: line,
        })
      }
      i = i + 1
    }
    if has_const {
      const_units.push(fi)
    }
    fi = fi + 1
  }
  sort_sig_entries(entries)
  let all_sigs = serialize_pionsig(PackageSig::{ pkg: pkg_name, entries: entries })
  let sig_sb = StringBuilder()
  sig_sb.write_string(all_sigs)
  sig_sb.write_string("const_units:")
  let mut ci = 0
  while ci < const_units.length() {
    if ci > 0 {
      sig_sb.write_string(",")
    }
    sig_sb.write_string(const_units[ci].to_string())
    ci = ci + 1
  }
  sig_sb.write_string("\n")
  let plan = compute_const_init_plan_from_sigs(file_sigs)
  if plan.order.length() > 0 || plan.has_cycle {
    sig_sb.write_string("const_init:")
    sig_sb.write_string(plan.plan_hash)
    sig_sb.write_string("\n")
  }
  FileSigsSummary::{
    sigs_hash: cas_sha256_hex(sig_sb.to_string()),
    const_units: const_units,
    const_init_order: plan.order,
    const_has_cycle: plan.has_cycle,
    const_has_ambiguous_method: plan.has_ambiguous_method,
    has_main: has_main,
  }
}

///|
fn split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let len = s.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if str_code_at(s, i) == 10 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < len {
    out.push(slice_str(s, start, len))
  }
  out
}

///|
fn starts_with_str(s : String, prefix : String) -> Bool {
  if prefix.length() > s.length() {
    return false
  }
  let mut i = 0
  while i < prefix.length() {
    if str_code_at(s, i) != str_code_at(prefix, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn extract_sig_name(line : String, start_idx : Int) -> String {
  let mut i = start_idx
  let len = line.length()
  while i < len {
    let ch = str_code_at(line, i)
    if ch == 32 || ch == 40 || ch == 91 || ch == 58 {
      if ch == 58 && i + 1 < len && str_code_at(line, i + 1) == 58 {
        i = i + 2
        continue
      }
      break
    }
    i = i + 1
  }
  slice_str(line, start_idx, i)
}

///|
fn sig_fn_name_offset(line : String) -> Int {
  let mut off = 0
  if starts_with_str(slice_str(line, off, line.length()), "#into ") {
    off = off + 6
  }
  let rest = slice_str(line, off, line.length())
  if starts_with_str(rest, "#verify_opaque ") {
    off = off + 15
  } else if starts_with_str(rest, "#verify ") {
    off = off + 8
  }
  if starts_with_str(slice_str(line, off, line.length()), "fn ") {
    off + 3
  } else {
    -1
  }
}

///|
pub fn parse_pionsig(text : String) -> Result[PackageSig, String] {
  let lines = split_lines(text)
  if lines.length() < 2 {
    return Err("pionsig too short: missing header")
  }
  if lines[0] != "pionsig v1" {
    return Err("unsupported pionsig header: " + lines[0])
  }
  if !starts_with_str(lines[1], "pkg ") {
    return Err("missing pkg line in pionsig")
  }
  let pkg_name = slice_str(lines[1], 4, lines[1].length())
  let entries : Array[SigEntry] = []
  let mut i = 2
  while i < lines.length() {
    let line = lines[i]
    if line.length() == 0 {
      i = i + 1
      continue
    }
    if starts_with_str(line, "val struct ") {
      entries.push(SigEntry::{
        kind: "struct",
        name: extract_sig_name(line, 11),
        signature: line,
      })
    } else if starts_with_str(line, "struct ") {
      entries.push(SigEntry::{
        kind: "struct",
        name: extract_sig_name(line, 7),
        signature: line,
      })
    } else if starts_with_str(line, "enum ") {
      entries.push(SigEntry::{
        kind: "enum",
        name: extract_sig_name(line, 5),
        signature: line,
      })
    } else if sig_fn_name_offset(line) >= 0 {
      entries.push(SigEntry::{
        kind: "fn",
        name: extract_sig_name(line, sig_fn_name_offset(line)),
        signature: line,
      })
    } else if starts_with_str(line, "const ") {
      entries.push(SigEntry::{
        kind: "const",
        name: extract_sig_name(line, 6),
        signature: line,
      })
    } else if starts_with_str(line, "extern \"C\" fn ") {
      entries.push(SigEntry::{
        kind: "extern_fn",
        name: extract_sig_name(line, 14),
        signature: line,
      })
    } else if starts_with_str(line, "trait ") {
      entries.push(SigEntry::{
        kind: "trait",
        name: extract_sig_name(line, 6),
        signature: line,
      })
    } else if starts_with_str(line, "impl ") {
      entries.push(SigEntry::{
        kind: "impl",
        name: extract_sig_name(line, 5),
        signature: line,
      })
    } else if starts_with_str(line, "impl[") {
      entries.push(SigEntry::{
        kind: "impl",
        name: extract_sig_name(line, 4),
        signature: line,
      })
    } else {
      return Err("unrecognized pionsig entry: " + line)
    }
    i = i + 1
  }
  Ok(PackageSig::{ pkg: pkg_name, entries: entries })
}

///|
pub fn sig_hash_hex(text : String) -> String {
  // Deterministic 64-bit FNV-1a hash formatted as 16 lowercase hex digits
  let mut h : Int64 = -3750763034362895579L
  let prime : Int64 = 1099511628211L
  let len = text.length()
  let mut i = 0
  while i < len {
    let ch = str_code_at(text, i).to_int64()
    h = (h ^ ch) * prime
    i = i + 1
  }
  let sb = StringBuilder()
  let mut shift = 60
  while shift >= 0 {
    let nibble = ((h >> shift) & 15L).to_int()
    sb.write_char(hex_digit(nibble))
    shift = shift - 4
  }
  sb.to_string()
}

///|
pub fn package_sig_to_json(sig : PackageSig) -> String {
  let raw = serialize_pionsig(sig)
  let hash = sig_hash_hex(raw)
  let sb = StringBuilder()
  sb.write_string("{\"pkg\":")
  sb.write_string(json_quote(sig.pkg))
  sb.write_string(",\"sig_hash\":")
  sb.write_string(json_quote(hash))
  sb.write_string(",\"pionsig\":")
  sb.write_string(json_quote(raw))
  sb.write_string(",\"exports\":[")
  let mut i = 0
  while i < sig.entries.length() {
    if i > 0 {
      sb.write_string(",")
    }
    let e = sig.entries[i]
    sb.write_string("{\"kind\":")
    sb.write_string(json_quote(e.kind))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(e.name))
    sb.write_string(",\"sig\":")
    sb.write_string(json_quote(e.signature))
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}
