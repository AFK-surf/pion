///|
/// The stable insertion sort `sort_sig_entries` replaced, kept as the reference.
fn sigt_ref_sort(entries : Array[SigEntry]) -> Unit {
  let n = entries.length()
  let mut i = 1
  while i < n {
    let key = entries[i]
    let mut j = i - 1
    while j >= 0 && sig_entry_lt(key, entries[j]) {
      entries[j + 1] = entries[j]
      j = j - 1
    }
    entries[j + 1] = key
    i = i + 1
  }
}

///|
fn sigt_copy(xs : Array[SigEntry]) -> Array[SigEntry] {
  let out : Array[SigEntry] = []
  let mut i = 0
  while i < xs.length() {
    out.push(xs[i])
    i = i + 1
  }
  out
}

///|
fn sigt_render(xs : Array[SigEntry]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < xs.length() {
    out.push(xs[i].kind + "|" + xs[i].name + "|" + xs[i].signature)
    i = i + 1
  }
  out
}

///|
fn sigt_join(xs : Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < xs.length() {
    out = out + xs[i] + "\n"
    i = i + 1
  }
  out
}

///|
/// Sorts a copy both ways and requires the same entry at every position.
fn sigt_check(xs : Array[SigEntry]) -> Array[String] {
  let got = sigt_copy(xs)
  let want = sigt_copy(xs)
  sort_sig_entries(got)
  sigt_ref_sort(want)
  let g = sigt_render(got)
  assert_eq(g.length(), want.length())
  assert_eq(sigt_join(g), sigt_join(sigt_render(want)))
  g
}

///|
fn sigt_e(kind : String, name : String, signature : String) -> SigEntry {
  SigEntry::{ kind: kind, name: name, signature: signature }
}

///|
test "sig: merge sort keeps tied entries in their original order" {
  let xs = [
    sigt_e("fn", "b", "1"),
    sigt_e("struct", "b", "2"),
    sigt_e("fn", "a", "3"),
    sigt_e("fn", "b", "4"),
    sigt_e("struct", "b", "5"),
    sigt_e("fn", "a", "6"),
    sigt_e("fn", "b", "7"),
  ]
  assert_eq(sigt_join(sigt_check(xs)), sigt_join([
    "struct|b|2", "struct|b|5", "fn|a|3", "fn|a|6", "fn|b|1", "fn|b|4", "fn|b|7",
  ]))
  // Unknown kinds share one rank: the name orders them, ties stay in place.
  let ys = [
    sigt_e("macro", "z", "1"),
    sigt_e("fn", "z", "2"),
    sigt_e("macro", "a", "3"),
    sigt_e("fn", "a", "4"),
  ]
  assert_eq(sigt_join(sigt_check(ys)), sigt_join(["macro|a|3", "fn|a|4", "macro|z|1", "fn|z|2"]))
}

///|
test "sig: merge sort on empty, single, sorted and reversed input" {
  let empty : Array[SigEntry] = []
  sort_sig_entries(empty)
  assert_eq(empty.length(), 0)
  let one = [sigt_e("const", "k", "x")]
  assert_eq(sigt_join(sigt_check(one)), "const|k|x\n")
  let kinds = ["struct", "enum", "trait", "impl", "const", "extern_fn", "fn"]
  let sorted : Array[SigEntry] = []
  let mut i = 0
  while i < kinds.length() {
    let mut j = 0
    while j < 5 {
      sorted.push(sigt_e(kinds[i], "n" + j.to_string(), i.to_string()))
      j = j + 1
    }
    i = i + 1
  }
  let s = sigt_check(sorted)
  assert_eq(sigt_join(s), sigt_join(sigt_render(sorted)))
  let reversed : Array[SigEntry] = []
  i = sorted.length() - 1
  while i >= 0 {
    reversed.push(sorted[i])
    i = i - 1
  }
  assert_eq(sigt_join(sigt_check(reversed)), sigt_join(s))
}

///|
test "sig: merge sort orders Unicode names like the reference" {
  let names = ["é", "e", "z", "中文", "汉字", "😀", "a😀", "aé", "", "Z", "_x", "x_"]
  let xs : Array[SigEntry] = []
  let mut i = 0
  while i < names.length() {
    xs.push(sigt_e("fn", names[i], "first"))
    xs.push(sigt_e("trait", names[names.length() - 1 - i], "t"))
    i = i + 1
  }
  i = 0
  while i < names.length() {
    xs.push(sigt_e("fn", names[i], "second"))
    i = i + 1
  }
  let got = sigt_check(xs)
  assert_eq(got.length(), xs.length())
  assert_eq(got[0], "trait||t")
}

///|
test "sig: merge sort matches the reference on every length up to 260" {
  let kinds = ["struct", "enum", "trait", "impl", "const", "extern_fn", "fn", "type"]
  let names = ["a", "b", "ab", "é", "中", "😀", "_", "B"]
  let mut seed = 1
  let mut n = 0
  while n <= 260 {
    let xs : Array[SigEntry] = []
    let mut i = 0
    while i < n {
      // Few distinct keys, so most lengths contain many ties.
      seed = (seed * 75 + 74) % 65537
      let k = seed % kinds.length()
      let m = seed / 8 % names.length()
      xs.push(sigt_e(kinds[k], names[m], i.to_string()))
      i = i + 1
    }
    let got = sigt_check(xs)
    assert_eq(got.length(), n)
    n = n + 1
  }
}

///|
test "sig: cslot prefix-chain hub avoids O(C*K) fmutlink blowup and preserves cycle precision" {
  let sb = StringBuilder()
  sb.write_string("fn opaque(x : Int) -> Int { x }\n")
  sb.write_string("fn sink(x : Int) -> Int { x }\n")
  sb.write_string("fn big_ui(n : Int) -> Int {\n")
  let mut i = 0
  while i < 120 {
    sb.write_string("  let a")
    sb.write_string(i.to_string())
    sb.write_string(" : Array[Int] = [")
    sb.write_string(i.to_string())
    sb.write_string("]\n")
    i = i + 1
  }
  let mut j = 0
  while j < 120 {
    sb.write_string("  let _ = sink(opaque(n + ")
    sb.write_string(j.to_string())
    sb.write_string("))\n")
    j = j + 1
  }
  sb.write_string("  a0.length()\n}\n")
  let sf = parse_source("big_ui.pion", sb.to_string()).file
  let sig_text = emit_file_sig_entries(sf)
  let lines = split_lines(sig_text)
  let mut fmutlink_cnt = 0
  let mut hub_cnt = 0
  let mut li = 0
  while li < lines.length() {
    if starts_with_str(lines[li], "#fmutlink ") {
      fmutlink_cnt = fmutlink_cnt + 1
    }
    if starts_with_str(lines[li], "#fdep $cslot_hub_") {
      hub_cnt = hub_cnt + 1
    }
    li = li + 1
  }
  // 120 cslots x 120 unknown-arg calls collapses to O(1) hub + O(1) deduped fmutlink (not 14,400).
  assert_true(hub_cnt >= 1 && hub_cnt <= 2, "expected 1 hub node, got " + hub_cnt.to_string())
  assert_true(fmutlink_cnt >= 1 && fmutlink_cnt <= 4, "expected O(1) fmutlink lines, got " + fmutlink_cnt.to_string())
  // Prefix semantics: an earlier unknown-cslot mutation must NOT taint a cslot created later,
  // while an unknown-cslot mutation after creation MUST still propagate the cycle.
  let src_cyc = "fn safe() -> Int { 1 }\nfn read_b() -> Int { B }\nfn inject(xs : Array[() -> Int]) -> Unit { xs[0] = read_b }\nfn mk_other() -> Array[() -> Int] { [safe] }\nfn trig() -> Int {\n  let a : Array[() -> Int] = [safe]\n  inject(mk_other())\n  a[0]()\n}\nlet A : Int = trig()\nlet B : Int = A\n"
  let sf_c = parse_source("cyc.pion", src_cyc).file
  let plan_c = compute_const_init_plan_from_sigs([emit_file_sig_entries(sf_c)])
  assert_true(plan_c.has_cycle, "prefix-chain hub must preserve E_CONST_CYCLE through unknown-cslot mutation")
  let src_ok = "fn safe() -> Int { 1 }\nfn read_b() -> Int { B }\nfn inject(xs : Array[() -> Int]) -> Unit { xs[0] = read_b }\nfn mk_other() -> Array[() -> Int] { [safe] }\nfn trig() -> Int {\n  let prev : Array[() -> Int] = [safe]\n  let _ = prev\n  inject(mk_other())\n  let later : Array[() -> Int] = [safe]\n  later[0]()\n}\nlet A : Int = trig()\nlet B : Int = A\n"
  let sf_ok = parse_source("ok.pion", src_ok).file
  let plan_ok = compute_const_init_plan_from_sigs([emit_file_sig_entries(sf_ok)])
  assert_true(!plan_ok.has_cycle, "prefix-chain hub must not taint cslots created after unknown-cslot call")
  // Cyclic `$ret:` self-reference (e.g. `fw:Node.cb -> $ret:fw:Node.cb`) must terminate without
  // unbounded `$ret:$ret:...` growth while preserving cycle soundness.
  let cyclic_ret_sig = "const A: Int\n#cdep A||trig@0\nfn trig() -> Int\n#fdep trig||$ret:fw:Node.cb@0\n#fret fw:Node.cb|$ret:fw:Node.cb,leaf\n#fdep fw:Node.cb||$ret:fw:Node.cb@0,leaf@0\nfn leaf() -> Int\n#fdep leaf|A|\n"
  let plan_ret = compute_const_init_plan_from_sigs([cyclic_ret_sig])
  assert_true(plan_ret.has_cycle, "cyclic $ret: fold must terminate and preserve E_CONST_CYCLE")
}

///|
fn sigt_assert_demand_parity(
  label : String,
  paths : Array[String],
  sources : Array[String],
  imported : Array[ImportedPkg],
) -> ConstInitDemandResult {
  let cr = check_source_files_with_imports(label, paths, sources, imported, false)
  let demand = compute_const_init_plan_from_pkg_tc_with_stats(cr.pkg, cr.tc)
  let full = compute_const_init_plan_from_pkg_tc_full(cr.pkg, cr.tc)
  assert_true(
    sig_const_init_plans_equal(demand.plan, full),
    label + ": demand plan mismatch vs full",
  )
  demand
}

///|
test "sig: demand BFS parity on cslot hub, competing cycles, ambiguity, multi-file, $ret:, default callbacks, xpkg & dead field writes" {
  // 1. Feed sig_test.pion:188-220 cases through the demand-driven pkg/tc entry.
  let sb = StringBuilder()
  sb.write_string("fn opaque(x : Int) -> Int { x }\n")
  sb.write_string("fn sink(x : Int) -> Int { x }\n")
  sb.write_string("fn big_ui(n : Int) -> Int {\n")
  let mut i = 0
  while i < 40 {
    sb.write_string("  let a" + i.to_string() + " : Array[Int] = [" + i.to_string() + "]\n")
    i = i + 1
  }
  sb.write_string("  let _ = sink(opaque(n))\n  a0.length()\n}\n")
  sb.write_string("let K : Int = 42\n")
  let r_big = sigt_assert_demand_parity("demand_big_ui", ["big_ui.pion"], [sb.to_string()], [])
  assert_true(r_big.stage == 1, "r_big.stage=" + r_big.stage.to_string())
  assert_true(r_big.scanned_fns == 0, "r_big.scanned=" + r_big.scanned_fns.to_string())

  let src_cyc = "fn safe() -> Int { 1 }\nfn read_b() -> Int { B }\nfn inject(xs : Array[() -> Int]) -> Unit { xs[0] = read_b }\nfn mk_other() -> Array[() -> Int] { [safe] }\nfn trig() -> Int {\n  let a : Array[() -> Int] = [safe]\n  inject(mk_other())\n  a[0]()\n}\nfn dead_noise() -> Int { 99 }\nlet A : Int = trig()\nlet B : Int = A\n"
  let r_cyc = sigt_assert_demand_parity("demand_cslot_cyc", ["cyc.pion"], [src_cyc], [])
  assert_true(r_cyc.plan.has_cycle, "cslot hub cycle must be preserved in demand mode")

  let src_ok = "fn safe() -> Int { 1 }\nfn read_b() -> Int { B }\nfn inject(xs : Array[() -> Int]) -> Unit { xs[0] = read_b }\nfn mk_other() -> Array[() -> Int] { [safe] }\nfn trig() -> Int {\n  let prev : Array[() -> Int] = [safe]\n  let _ = prev\n  inject(mk_other())\n  let later : Array[() -> Int] = [safe]\n  later[0]()\n}\nfn dead_noise() -> Int { 99 }\nlet A : Int = trig()\nlet B : Int = A\n"
  let r_ok = sigt_assert_demand_parity("demand_cslot_ok", ["ok.pion"], [src_ok], [])
  assert_true(!r_ok.plan.has_cycle, "cslot hub prefix non-cycle must be preserved in demand mode")

  // 2. Competing dual cycles: verify exact `cycle_path` & `order` replay parity.
  let dual_cyc =
  #|fn f_ab() -> Int { B }
  #|fn f_ba() -> Int { A }
  #|fn f_cd() -> Int { D }
  #|fn f_dc() -> Int { C }
  #|fn dead1() -> Int { 1 }
  #|let A : Int = f_ab()
  #|let B : Int = f_ba()
  #|let C : Int = f_cd()
  #|let D : Int = f_dc()
  let r_dual = sigt_assert_demand_parity("demand_dual_cyc", ["dual.pion"], [dual_cyc], [])
  assert_true(r_dual.plan.has_cycle, "dual cycle must detect cycle")
  assert_true(r_dual.stage == 2, "r_dual.stage=" + r_dual.stage.to_string() + " fb=" + r_dual.fallback_reason)
  assert_true(r_dual.scanned_fns < r_dual.total_fns, "dead1 must not be scanned")

  // 3. Same-name method ambiguity across types: verify `has_ambiguous_method` parity.
  let ambig_src =
  #|trait Getter { fn get(self) -> Int }
  #|struct S1 { v : Int }
  #|struct S2 { v : Int }
  #|impl Getter for S1 { fn get(self) -> Int { self.v + Y } }
  #|impl Getter for S2 { fn get(self) -> Int { self.v } }
  #|fn dead_m() -> Int { 0 }
  #|fn call_get[T: Getter](x : T) -> Int { x.get() }
  #|let X : Int = call_get(S1::{ v: 1 })
  #|let Y : Int = 2
  let r_amb = sigt_assert_demand_parity("demand_method_ambig", ["ambig.pion"], [ambig_src], [])
  assert_true(r_amb.stage == 2, "r_amb.stage=" + r_amb.stage.to_string() + " fb=" + r_amb.fallback_reason)
  assert_true(r_amb.scanned_fns < r_amb.total_fns, "dead_m must not be scanned")

  // 4. Multi-file source-order replay parity.
  let mf_a =
  #|fn dead_a() -> Int { 10 }
  #|fn helper_a() -> Int { helper_b() }
  #|let A : Int = helper_a()
  #|let C : Int = B + 1
  let mf_b =
  #|fn dead_b() -> Int { 20 }
  #|fn helper_b() -> Int { B }
  #|let B : Int = 7
  let r_mf = sigt_assert_demand_parity("demand_multifile", ["a.pion", "b.pion"], [mf_a, mf_b], [])
  assert_true(r_mf.stage == 2, "r_mf.stage=" + r_mf.stage.to_string() + " fb=" + r_mf.fallback_reason)
  assert_true(r_mf.scanned_fns == 2, "r_mf.scanned=" + r_mf.scanned_fns.to_string())
  assert_true(r_mf.total_fns == 4, "r_mf.total=" + r_mf.total_fns.to_string())

  // 5. Recursive `$ret:` return is handled directly in Stage 2 demand BFS and matches full plan.
  let ret_src =
  #|fn read_a() -> Int { A }
  #|fn make_cb() -> () -> Int { read_a }
  #|fn invoke() -> Int {
    #| let f = make_cb()
    #| f()
    #|}
  #|fn dead_ret() -> Int { 99 }
  #|let A : Int = invoke()
  let r_ret = sigt_assert_demand_parity("demand_ret_stage2", ["ret.pion"], [ret_src], [])
  assert_true(r_ret.plan.has_cycle, "$ret: cycle must be detected in Stage 2")
  assert_true(r_ret.stage == 2, "r_ret.stage=" + r_ret.stage.to_string() + " fb=" + r_ret.fallback_reason)
  assert_true(r_ret.scanned_fns < r_ret.total_fns, "dead_ret must not be scanned")

  // 6. Paired default-callback tests: omitted default callback `C` reading `A` (cycle)
  //    vs explicit safe callback argument (no cycle).
  let defcb_cyc =
  #|fn read_a() -> Int { A }
  #|let C : () -> Int = read_a
  #|fn safe() -> Int { 0 }
  #|fn run(f : () -> Int = C) -> Int { f() }
  #|fn dead_other() -> Int { 123 }
  #|let A : Int = run()
  let r_defcb_cyc = sigt_assert_demand_parity("demand_defcb_cyc", ["defcb_cyc.pion"], [defcb_cyc], [])
  assert_true(r_defcb_cyc.plan.has_cycle, "omitted default callback C reading A must detect cycle")
  assert_true(r_defcb_cyc.stage == 2, "r_defcb_cyc.stage=" + r_defcb_cyc.stage.to_string() + " fb=" + r_defcb_cyc.fallback_reason)
  assert_true(r_defcb_cyc.scanned_fns < r_defcb_cyc.total_fns, "dead_other must not be scanned")

  let defcb_ok =
  #|fn read_a() -> Int { A }
  #|let C : () -> Int = read_a
  #|fn safe() -> Int { 0 }
  #|fn run(f : () -> Int = C) -> Int { f() }
  #|fn dead_other() -> Int { 123 }
  #|let A : Int = run(safe)
  let r_defcb_ok = sigt_assert_demand_parity("demand_defcb_ok", ["defcb_ok.pion"], [defcb_ok], [])
  assert_true(!r_defcb_ok.plan.has_cycle, "explicit safe callback must not report cycle")
  assert_true(r_defcb_ok.stage == 2, "r_defcb_ok.stage=" + r_defcb_ok.stage.to_string() + " fb=" + r_defcb_ok.fallback_reason)
  assert_true(r_defcb_ok.scanned_fns < r_defcb_ok.total_fns, "dead_other must not be scanned")

  // 7. Cross-package call in const initializer (lg_pages `signals::signal(0)` pattern: 0 scanned, 0 fallback)
  //    AND cross-package callback passing local function (`wave_j1_soundness` pattern).
  let dep_src =
  #|pub fn make_sig(v : Int) -> Int { v }
  #|pub fn apply_cb(f : () -> Int) -> Int { f() }
  let dep_cr = check_source_files_with_imports("xdep", ["xdep.pion"], [dep_src], [], true)
  assert_true(dep_cr.diagnostics.length() == 0, "dep_cr diags=" + dep_cr.diagnostics.length().to_string())
  let imported = [imported_pkg_new("xdep", dep_cr.tc)]

  let xpkg_nocb =
  #|import "xdep"
  #|fn dead_ui_1() -> Int { 1 }
  #|fn dead_ui_2() -> Int { 2 }
  #|let S : Int = xdep::make_sig(0)
  let r_xnocb = sigt_assert_demand_parity("demand_xpkg_nocb", ["main.pion"], [xpkg_nocb], imported)
  assert_true(r_xnocb.stage == 2, "r_xnocb.stage=" + r_xnocb.stage.to_string() + " fb=" + r_xnocb.fallback_reason)
  assert_true(r_xnocb.scanned_fns == 0, "r_xnocb.scanned=" + r_xnocb.scanned_fns.to_string())
  assert_true(r_xnocb.fallback_reason == "", "r_xnocb.fb=" + r_xnocb.fallback_reason)

  let xpkg_cb =
  #|import "xdep"
  #|fn read_a() -> Int { A }
  #|fn dead_ui() -> Int { 1 }
  #|let A : Int = xdep::apply_cb(read_a)
  let r_xcb = sigt_assert_demand_parity("demand_xpkg_cb", ["main.pion"], [xpkg_cb], imported)
  assert_true(r_xcb.plan.has_cycle, "cross-package callback must detect cycle through local callback")
  assert_true(r_xcb.stage == 2, "r_xcb.stage=" + r_xcb.stage.to_string() + " fb=" + r_xcb.fallback_reason)
  assert_true(r_xcb.scanned_fns == 1, "r_xcb.scanned=" + r_xcb.scanned_fns.to_string())
  assert_true(r_xcb.total_fns == 2, "r_xcb.total=" + r_xcb.total_fns.to_string())

  // 8. Unreachable field write (frontend_test.pion:11203-11212) must remain acyclic.
  let dead_fw =
  #|struct Live { mut run : () -> Int }
  #|fn zero() -> Int { 0 }
  #|fn read_a() -> Int { A }
  #|fn unused(x : Live) -> Unit { x.run = read_a }
  #|let H : Live = Live::{ run: zero }
  #|let A : Int = H.run()
  let r_dfw = sigt_assert_demand_parity("demand_dead_fw", ["dfw.pion"], [dead_fw], [])
  assert_true(!r_dfw.plan.has_cycle, "unreachable field write must remain acyclic")
  assert_true(r_dfw.stage == 3, "r_dfw.stage=" + r_dfw.stage.to_string() + " fb=" + r_dfw.fallback_reason)

  // 9. Plain value call `box_val(mk_val())` must NOT false-fallback on `$ret:mk_val`,
  //    while `apply(mk_cb())` where `apply` invokes its callback MUST fallback and catch cycle.
  let val_nest =
  #|fn box_val(x : Int) -> Int { x + 1 }
  #|fn mk_val() -> Int { 41 }
  #|fn dead_u() -> Int { 0 }
  #|let V : Int = box_val(mk_val())
  let r_vn = sigt_assert_demand_parity("demand_val_nest", ["vn.pion"], [val_nest], [])
  assert_true(r_vn.stage == 2, "r_vn.stage=" + r_vn.stage.to_string() + " fb=" + r_vn.fallback_reason)
  assert_true(r_vn.scanned_fns == 2 && r_vn.total_fns == 3, "r_vn scanned=" + r_vn.scanned_fns.to_string())

  let cb_nest =
  #|fn apply(f : () -> Int) -> Int { f() }
  #|fn read_a() -> Int { A }
  #|fn mk_cb() -> () -> Int { read_a }
  #|fn dead_cb_nest() -> Int { 0 }
  #|let A : Int = apply(mk_cb())
  let r_cn = sigt_assert_demand_parity("demand_cb_nest", ["cn.pion"], [cb_nest], [])
  assert_true(r_cn.plan.has_cycle, "apply(mk_cb()) must detect cycle")
  assert_true(r_cn.stage == 2, "r_cn.stage=" + r_cn.stage.to_string() + " fb=" + r_cn.fallback_reason)
  assert_true(r_cn.scanned_fns < r_cn.total_fns, "dead_cb_nest must not be scanned")

  // 10. Astra P1: bare method `.pick_0` colliding with synthetic closure key `$cb_fn_S1::pick_0`
  //     (both resolved and empty `resolved_method_calls` variants).
  let method_collision =
  #|trait Getter { fn pick_0(self) -> Int }
  #|struct S1 { v : Int }
  #|impl Getter for S1 { fn pick_0(self) -> Int { self.v } }
  #|fn invoke(f : () -> Int) -> Int { f() }
  #|fn S1::pick(self : S1) -> Int { invoke(fn() { A }) }
  #|fn use_it[T: Getter](x : T) -> Int { x.pick_0() }
  #|let A : Int = use_it(S1::{ v: 1 })
  let r_mc = sigt_assert_demand_parity("demand_method_collision", ["mc.pion"], [method_collision], [])
  assert_true(r_mc.plan.has_cycle, "method_collision must match full planner E_CONST_CYCLE")
  let cr_mc_empty = check_source_files_with_imports("demand_mc_empty", ["mc.pion"], [method_collision], [], false)
  let empty_tc = check_source_files_with_imports("demand_mc_empty_tc", ["empty.pion"], [""], [], false).tc
  let d_mc_empty = compute_const_init_plan_from_pkg_tc_with_stats(cr_mc_empty.pkg, empty_tc)
  let f_mc_empty = compute_const_init_plan_from_pkg_tc_full(cr_mc_empty.pkg, empty_tc)
  assert_true(
    sig_const_init_plans_equal(d_mc_empty.plan, f_mc_empty),
    "method_collision empty resolved_method_calls must match 5-field full plan",
  )

  // 11. Astra P2: demand-driven default-arg activation — explicit `run(safe)` must NOT trigger
  //     unexecuted default callback `factory()` fallback; omitted `run()` and mixed calls MUST.
  let def_factory_explicit =
  #|fn read_a() -> Int { A }
  #|fn factory() -> () -> Int { read_a }
  #|fn safe() -> Int { 0 }
  #|fn run(f : () -> Int = factory()) -> Int { f() }
  #|fn dead_fn() -> Int { 7 }
  #|let A : Int = run(safe)
  let r_dfe = sigt_assert_demand_parity("demand_def_factory_explicit", ["dfe.pion"], [def_factory_explicit], [])
  assert_true(!r_dfe.plan.has_cycle, "explicit run(safe) must remain acyclic")
  assert_true(r_dfe.stage == 2, "explicit run(safe) must stay stage=2, got " + r_dfe.stage.to_string() + " fb=" + r_dfe.fallback_reason)
  assert_true(r_dfe.scanned_fns < r_dfe.total_fns, "factory/dead_fn must not be scanned when default arg is supplied")

  let def_factory_omitted =
  #|fn read_a() -> Int { A }
  #|fn factory() -> () -> Int { read_a }
  #|fn safe() -> Int { 0 }
  #|fn run(f : () -> Int = factory()) -> Int { f() }
  #|let A : Int = run()
  let r_dfo = sigt_assert_demand_parity("demand_def_factory_omitted", ["dfo.pion"], [def_factory_omitted], [])
  assert_true(r_dfo.plan.has_cycle, "omitted run() must activate default factory() and detect cycle")

  let def_factory_mixed =
  #|fn read_a() -> Int { A }
  #|fn factory() -> () -> Int { read_a }
  #|fn safe() -> Int { 0 }
  #|fn run(f : () -> Int = factory()) -> Int { f() }
  #|let Safe : Int = run(safe)
  #|let A : Int = run()
  let r_dfm = sigt_assert_demand_parity("demand_def_factory_mixed", ["dfm.pion"], [def_factory_mixed], [])
  assert_true(r_dfm.plan.has_cycle, "mixed explicit+omitted run() calls must detect cycle")

  // 12. `ignore(factory())` differential parity under consumption-site `#fret` policy.
  let ignore_factory =
  #|fn read_a() -> Int { A }
  #|fn factory() -> () -> Int { read_a }
  #|fn dead_ig() -> Int { 9 }
  #|let A : Int = { ignore(factory()); 1 }
  let r_ig = sigt_assert_demand_parity("demand_ignore_factory", ["ig.pion"], [ignore_factory], [])
  assert_true(!r_ig.plan.has_cycle, "ignore(factory()) must remain acyclic and match full planner")

  // 13. Astra R2 P1: deferred `ret_cb_callees` bare method `.pick_0` colliding with synthetic
  //     closure `$cb_fn_S::pick_0` (both cyclic and acyclic topological-order variants).
  let ret_cb_synth_cyc =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|trait Getter { fn pick_0(self, f : () -> Int) -> Int }
  #|struct S { v : Int }
  #|impl Getter for S { fn pick_0(self, f : () -> Int) -> Int { 5 } }
  #|fn holder(cb : (Int, () -> Int) -> Int) -> Int { 0 }
  #|fn S::pick(self : S) -> Int { holder(fn(x, f) { f() }) }
  #|fn use_it[T: Getter](xs : Array[T]) -> Int { for x in xs { return x.pick_0(factory()) }; 0 }
  #|let A : Int = use_it([S::{ v: 1 }])
  let r_rcsc = sigt_assert_demand_parity("demand_ret_cb_synth_cyc", ["rcsc.pion"], [ret_cb_synth_cyc], [])
  assert_true(r_rcsc.plan.has_cycle, "ret_cb_synth_cyc must match full planner cycle")
  assert_true(r_rcsc.stage == 2, "ret_cb_synth_cyc must stay stage=2, got stage=" + r_rcsc.stage.to_string())

  let ret_cb_synth_ord =
  #|fn leaf() -> Int { B }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|trait Getter { fn pick_0(self, f : () -> Int) -> Int }
  #|struct S { v : Int }
  #|impl Getter for S { fn pick_0(self, f : () -> Int) -> Int { 5 } }
  #|fn holder(cb : (Int, () -> Int) -> Int) -> Int { 0 }
  #|fn S::pick(self : S) -> Int { holder(fn(x, f) { f() }) }
  #|fn use_it[T: Getter](xs : Array[T]) -> Int { for x in xs { return x.pick_0(factory()) }; 0 }
  #|let A : Int = use_it([S::{ v: 1 }])
  #|let B : Int = 57
  let r_rcso = sigt_assert_demand_parity("demand_ret_cb_synth_ord", ["rcso.pion"], [ret_cb_synth_ord], [])
  assert_true(!r_rcso.plan.has_cycle, "ret_cb_synth_ord must remain acyclic")
  assert_true(r_rcso.stage == 2, "ret_cb_synth_ord must stay stage=2, got stage=" + r_rcso.stage.to_string())

  // 14. Astra R2 P2: default-arg embedded closure synthetic lines (`$cb_fdef_run_0_0`) must
  //     belong to slot `run|0` so explicit `run(safe)` stays stage=2 without fallback, while
  //     omitted `run()` activates slot `run|0` and detects the cycle.
  let def_closure_explicit =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn safe() -> Int { 7 }
  #|fn run(f : () -> Int = fn() { let g = factory(); g() }) -> Int { f() }
  #|let A : Int = run(safe)
  let r_dce = sigt_assert_demand_parity("demand_def_closure_explicit", ["dce.pion"], [def_closure_explicit], [])
  assert_true(!r_dce.plan.has_cycle, "explicit run(safe) with closure default must be acyclic")
  assert_true(r_dce.stage == 2, "explicit run(safe) with closure default must stay stage=2, got " + r_dce.stage.to_string() + " fb=" + r_dce.fallback_reason)
  assert_true(r_dce.scanned_fns < r_dce.total_fns, "factory/leaf must not be scanned when closure default is not triggered")

  let def_closure_omitted =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn safe() -> Int { 7 }
  #|fn run(f : () -> Int = fn() { let g = factory(); g() }) -> Int { f() }
  #|let A : Int = run()
  let r_dco = sigt_assert_demand_parity("demand_def_closure_omitted", ["dco.pion"], [def_closure_omitted], [])
  assert_true(r_dco.plan.has_cycle, "omitted run() with closure default must detect A -> A cycle")

  // 15. Astra R3 P2-1: nested synthetic prefixes (`$cb_$cb_fdef_run_0_0_0`, `$cslot_$cb_fdef_...`)
  //     must all be stripped in a loop and attributed to slot `run|0`.
  let def_nested_explicit =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn safe() -> Int { 7 }
  #|fn callit(f : () -> Int) -> Int { f() }
  #|fn run(f : () -> Int = fn() { callit(fn() { let g = factory(); g() }) }) -> Int { f() }
  #|let A : Int = run(safe)
  let r_dne = sigt_assert_demand_parity("demand_def_nested_explicit", ["dne.pion"], [def_nested_explicit], [])
  assert_true(!r_dne.plan.has_cycle, "explicit run(safe) with nested closure default must be acyclic")
  assert_true(r_dne.stage == 2, "explicit run(safe) with nested closure default must stay stage=2, got " + r_dne.stage.to_string() + " fb=" + r_dne.fallback_reason)
  assert_true(r_dne.scanned_fns < r_dne.total_fns, "nested closure default helpers must not scan factory/leaf when not triggered")

  let def_nested_omitted =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn safe() -> Int { 7 }
  #|fn callit(f : () -> Int) -> Int { f() }
  #|fn run(f : () -> Int = fn() { callit(fn() { let g = factory(); g() }) }) -> Int { f() }
  #|let A : Int = run()
  let r_dno = sigt_assert_demand_parity("demand_def_nested_omitted", ["dno.pion"], [def_nested_omitted], [])
  assert_true(r_dno.plan.has_cycle, "omitted run() with nested closure default must detect A -> A cycle")

  // 16. Astra R3 P2-2: `sig_demand_fn_uses_slot` must match only outer `fn_key`'s `#fcallp` and
  //     skip inactive default-arg helper lines so an unused default closure's param 0 is not
  //     mistaken for outer param 0.
  let ignore_pair_explicit =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn other(h : () -> Int) -> Int { 0 }
  #|fn ignore_pair(f : () -> Int, g : (() -> Int) -> Int = fn(h) { h() }) -> Int { 7 }
  #|let A : Int = ignore_pair(factory(), other)
  let r_ipe = sigt_assert_demand_parity("demand_ignore_pair_explicit", ["ipe.pion"], [ignore_pair_explicit], [])
  assert_true(!r_ipe.plan.has_cycle, "ignore_pair(factory(), other) must be acyclic")
  assert_true(r_ipe.stage == 2, "ignore_pair(factory(), other) must stay stage=2, got " + r_ipe.stage.to_string() + " fb=" + r_ipe.fallback_reason)
  assert_true(r_ipe.scanned_fns < r_ipe.total_fns, "ignore_pair(factory(), other) must not scan leaf/other")

  let use_pair_omitted =
  #|fn leaf() -> Int { A }
  #|let Lazy : () -> Int = fn() { leaf() }
  #|fn factory() -> () -> Int { Lazy }
  #|fn other(h : () -> Int) -> Int { 0 }
  #|fn use_pair(f : () -> Int, g : (() -> Int) -> Int = fn(h) { h() }) -> Int { g(f) }
  #|let A : Int = use_pair(factory())
  let r_upo = sigt_assert_demand_parity("demand_use_pair_omitted", ["upo.pion"], [use_pair_omitted], [])
  assert_true(r_upo.plan.has_cycle, "omitted use_pair(factory()) must activate default closure and detect A -> A cycle")

  // 17. Stage 2 `$ret:` multi-level chain (`$ret:$ret:`) cyclic & acyclic parity.
  let ret2_cyc =
  #|fn read_a() -> Int { A }
  #|fn mk1() -> () -> Int { read_a }
  #|fn mk2() -> () -> () -> Int { mk1 }
  #|fn run() -> Int { let f = mk2()(); f() }
  #|fn dead_ret2() -> Int { 11 }
  #|let A : Int = run()
  let r_r2c = sigt_assert_demand_parity("demand_ret2_cyc", ["r2c.pion"], [ret2_cyc], [])
  assert_true(r_r2c.plan.has_cycle, "multi-level $ret:$ret: must detect cycle")
  assert_true(r_r2c.stage == 2, "r_r2c.stage=" + r_r2c.stage.to_string() + " fb=" + r_r2c.fallback_reason)
  assert_true(r_r2c.scanned_fns < r_r2c.total_fns, "dead_ret2 must not be scanned")

  let ret2_ok =
  #|fn read_b() -> Int { B }
  #|fn mk1() -> () -> Int { read_b }
  #|fn mk2() -> () -> () -> Int { mk1 }
  #|fn run() -> Int { let f = mk2()(); f() }
  #|fn dead_ret2() -> Int { 11 }
  #|let A : Int = run()
  #|let B : Int = 7
  let r_r2o = sigt_assert_demand_parity("demand_ret2_ok", ["r2o.pion"], [ret2_ok], [])
  assert_true(!r_r2o.plan.has_cycle, "multi-level $ret:$ret: acyclic must order B before A")
  assert_true(r_r2o.stage == 2, "r_r2o.stage=" + r_r2o.stage.to_string() + " fb=" + r_r2o.fallback_reason)
  assert_true(r_r2o.scanned_fns < r_r2o.total_fns, "dead_ret2 must not be scanned")

  // 18. Stage 2 `$retp:` param-return call (direct & forwarded through `#fcallp`) cyclic & acyclic.
  let retp_cyc =
  #|fn read_a() -> Int { A }
  #|fn mk_bad() -> () -> Int { read_a }
  #|fn call_ret(factory : () -> () -> Int) -> Int { let g = factory(); g() }
  #|fn fwd_ret(factory : () -> () -> Int) -> Int { call_ret(factory) }
  #|fn dead_retp() -> Int { 22 }
  #|let A : Int = fwd_ret(mk_bad)
  let r_rpc = sigt_assert_demand_parity("demand_retp_cyc", ["rpc.pion"], [retp_cyc], [])
  assert_true(r_rpc.plan.has_cycle, "forwarded $retp: must detect cycle")
  assert_true(r_rpc.stage == 2, "r_rpc.stage=" + r_rpc.stage.to_string() + " fb=" + r_rpc.fallback_reason)
  assert_true(r_rpc.scanned_fns < r_rpc.total_fns, "dead_retp must not be scanned")

  let retp_ok =
  #|fn read_b() -> Int { B }
  #|fn mk_ok() -> () -> Int { read_b }
  #|fn call_ret(factory : () -> () -> Int) -> Int { let g = factory(); g() }
  #|fn fwd_ret(factory : () -> () -> Int) -> Int { call_ret(factory) }
  #|fn dead_retp() -> Int { 22 }
  #|let A : Int = fwd_ret(mk_ok)
  #|let B : Int = 9
  let r_rpo = sigt_assert_demand_parity("demand_retp_ok", ["rpo.pion"], [retp_ok], [])
  assert_true(!r_rpo.plan.has_cycle, "forwarded $retp: acyclic must order B before A")
  assert_true(r_rpo.stage == 2, "r_rpo.stage=" + r_rpo.stage.to_string() + " fb=" + r_rpo.fallback_reason)
  assert_true(r_rpo.scanned_fns < r_rpo.total_fns, "dead_retp must not be scanned")

  // 19. Stage 2 cross-package `ret_cb_xpkg` (e.g. `xdep::make_sig(mk_val())`): stays stage=2, 0 fallback.
  let xpkg_ret_cb =
  #|import "xdep"
  #|fn mk_val() -> Int { B }
  #|fn dead_xpkg_1() -> Int { 1 }
  #|fn dead_xpkg_2() -> Int { 2 }
  #|let A : Int = xdep::make_sig(mk_val())
  #|let B : Int = 42
  let r_xrc = sigt_assert_demand_parity("demand_xpkg_ret_cb", ["xrc.pion"], [xpkg_ret_cb], imported)
  assert_true(!r_xrc.plan.has_cycle, "xpkg ret_cb must be acyclic")
  assert_true(r_xrc.stage == 2, "r_xrc.stage=" + r_xrc.stage.to_string() + " fb=" + r_xrc.fallback_reason)
  assert_true(r_xrc.scanned_fns == 1 && r_xrc.total_fns == 3, "r_xrc scanned=" + r_xrc.scanned_fns.to_string())
}

///|
fn sigt_expr_eq(a : Expr, b : Expr) -> Bool {
  match (a, b) {
    (EInt(x, _), EInt(y, _)) => x == y
    (EInt64(x, _), EInt64(y, _)) => x == y
    (EUInt(x, _), EUInt(y, _)) => x == y
    (EUInt64(x, _), EUInt64(y, _)) => x == y
    (EDouble(x, _), EDouble(y, _)) => x == y
    (EFloat(x, _), EFloat(y, _)) => x == y
    (EBool(x, _), EBool(y, _)) => x == y
    (EByte(x, _), EByte(y, _)) => x == y
    (EChar(x, _), EChar(y, _)) => x == y
    (EString(x, _), EString(y, _)) => x == y
    (EIdent(x, _), EIdent(y, _)) => x == y
    (EPath(q1, m1, _), EPath(q2, m2, _)) => q1 == q2 && m1 == m2
    (EDotVariant(v1, a1, _), EDotVariant(v2, a2, _)) => v1 == v2 && sigt_exprs_eq(a1, a2)
    (EUnary(o1, e1, _), EUnary(o2, e2, _)) => o1 == o2 && sigt_expr_eq(e1, e2)
    (EBinary(o1, l1, r1, _), EBinary(o2, l2, r2, _)) => o1 == o2 && sigt_expr_eq(l1, l2) && sigt_expr_eq(r1, r2)
    (ECall(c1, a1, _), ECall(c2, a2, _)) => sigt_expr_eq(c1, c2) && sigt_exprs_eq(a1, a2)
    (EField(o1, f1, _), EField(o2, f2, _)) => f1 == f2 && sigt_expr_eq(o1, o2)
    (EMethodCall(r1, m1, a1, _), EMethodCall(r2, m2, a2, _)) => m1 == m2 && sigt_expr_eq(r1, r2) && sigt_exprs_eq(a1, a2)
    (EIndex(o1, i1, _), EIndex(o2, i2, _)) => sigt_expr_eq(o1, o2) && sigt_expr_eq(i1, i2)
    (EArrayLit(a1, _), EArrayLit(a2, _)) => sigt_exprs_eq(a1, a2)
    (ETuple(a1, _), ETuple(a2, _)) => sigt_exprs_eq(a1, a2)
    (EStructLit(n1, sp1, fs1, _), EStructLit(n2, sp2, fs2, _)) => {
      let sp_ok = match (sp1, sp2) {
        (None, None) => true
        (Some(x), Some(y)) => sigt_expr_eq(x, y)
        _ => false
      }
      if n1 != n2 || !sp_ok || fs1.length() != fs2.length() {
        false
      } else {
        let mut i = 0
        while i < fs1.length() {
          if fs1[i].name != fs2[i].name || !sigt_expr_eq(fs1[i].value, fs2[i].value) {
            return false
          }
          i = i + 1
        }
        true
      }
    }
    (EBlock(s1, _), EBlock(s2, _)) => sigt_stmts_eq(s1, s2)
    (EIf(c1, t1, e1, _), EIf(c2, t2, e2, _)) => {
      let e_ok = match (e1, e2) {
        (None, None) => true
        (Some(x), Some(y)) => sigt_expr_eq(x, y)
        _ => false
      }
      sigt_expr_eq(c1, c2) && sigt_stmts_eq(t1, t2) && e_ok
    }
    (EIs(e1, _, _), EIs(e2, _, _)) => sigt_expr_eq(e1, e2)
    (EClosure(p1, _, b1, _), EClosure(p2, _, b2, _)) => p1.length() == p2.length() && sigt_stmts_eq(b1, b2)
    (EInterp(p1, _), EInterp(p2, _)) => sigt_exprs_eq(p1, p2)
    (ENamedArg(n1, o1, e1, _), ENamedArg(n2, o2, e2, _)) => n1 == n2 && o1 == o2 && sigt_expr_eq(e1, e2)
    (EMutArg(e1, _), EMutArg(e2, _)) => sigt_expr_eq(e1, e2)
    (EMove(e1, _), EMove(e2, _)) => sigt_expr_eq(e1, e2)
    (EAs(e1, _, _), EAs(e2, _, _)) => sigt_expr_eq(e1, e2)
    (ETry(e1, _), ETry(e2, _)) => sigt_expr_eq(e1, e2)
    (EUnit(_), EUnit(_)) => true
    _ => false
  }
}

///|
fn sigt_exprs_eq(a : Array[Expr], b : Array[Expr]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !sigt_expr_eq(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn sigt_stmt_eq(a : Stmt, b : Stmt) -> Bool {
  match (a, b) {
    (SLet(n1, m1, _, e1, _), SLet(n2, m2, _, e2, _)) => n1 == n2 && m1 == m2 && sigt_expr_eq(e1, e2)
    (SLetTuple(ns1, _, e1, _), SLetTuple(ns2, _, e2, _)) => {
      if ns1.length() != ns2.length() {
        return false
      }
      let mut i = 0
      while i < ns1.length() {
        if ns1[i] != ns2[i] {
          return false
        }
        i = i + 1
      }
      sigt_expr_eq(e1, e2)
    }
    (SAssign(l1, r1, _), SAssign(l2, r2, _)) => sigt_expr_eq(l1, l2) && sigt_expr_eq(r1, r2)
    (SCompoundAssign(o1, l1, r1, _), SCompoundAssign(o2, l2, r2, _)) => o1 == o2 && sigt_expr_eq(l1, l2) && sigt_expr_eq(r1, r2)
    (SGuard(c1, b1, _), SGuard(c2, b2, _)) => sigt_expr_eq(c1, c2) && sigt_stmts_eq(b1, b2)
    (SWhile(c1, b1, _), SWhile(c2, b2, _)) => sigt_expr_eq(c1, c2) && sigt_stmts_eq(b1, b2)
    (SFor(i1, c1, s1, b1, _), SFor(i2, c2, s2, b2, _)) => sigt_stmt_eq(i1, i2) && sigt_expr_eq(c1, c2) && sigt_stmt_eq(s1, s2) && sigt_stmts_eq(b1, b2)
    (SForRange(v1, s1, e1, inc1, b1, _), SForRange(v2, s2, e2, inc2, b2, _)) => v1 == v2 && inc1 == inc2 && sigt_expr_eq(s1, s2) && sigt_expr_eq(e1, e2) && sigt_stmts_eq(b1, b2)
    (SForIn(k1, v1, it1, b1, _), SForIn(k2, v2, it2, b2, _)) => k1 == k2 && v1 == v2 && sigt_expr_eq(it1, it2) && sigt_stmts_eq(b1, b2)
    (SReturn(o1, _), SReturn(o2, _)) =>
      match (o1, o2) {
        (None, None) => true
        (Some(x), Some(y)) => sigt_expr_eq(x, y)
        _ => false
      }
    (SBreak(_), SBreak(_)) => true
    (SContinue(_), SContinue(_)) => true
    (SDebugAssert(c1, m1, _), SDebugAssert(c2, m2, _)) => sigt_expr_eq(c1, c2) && sigt_expr_eq(m1, m2)
    (SExpr(e1, _), SExpr(e2, _)) => sigt_expr_eq(e1, e2)
    _ => false
  }
}

///|
fn sigt_stmts_eq(a : Array[Stmt], b : Array[Stmt]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if !sigt_stmt_eq(a[i], b[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
test "sig: emit_pion_stub AST round-trip fidelity (escapes, ECall(EField), SForIn, SLetTuple, DImpl generic method, spread, closure, EIs)" {
  let src =
  #|pub struct Holder {
  #|  f : (Int) -> Int
  #|  v : Int
  #|}
  #|pub fn Holder::f(self : Holder, x : Int) -> Int { x + 1000 }
  #|pub fn pad1() -> Int { 1 }
  #|pub fn pad2() -> Int { 2 }
  #|pub fn pad3() -> Int { 3 }
  #|pub fn pad4() -> Int { 4 }
  #|pub fn call_field[T](h : Holder, t : T, x : Int) -> Int {
  #|  let _ = t
  #|  (h.f)(x)
  #|}
  #|pub fn escapes[T](t : T, def_s~ : String = "\x1b[0m\0\n\t\"\\中文😀") -> (Char, Byte, Char, Char, Char, String) {
  #|  let _ = t
  #|  let c1 = '\n'
  #|  let b1 = b'\x1b'
  #|  let c2 = '\''
  #|  let c3 = '\\'
  #|  let c4 = '\u{1f600}'
  #|  let s1 = "\x1b[0m\0中文😀\{def_s}"
  #|  (c1, b1, c2, c3, c4, s1)
  #|}
  #|pub fn loops[T](xs : Array[Int], t : T) -> Int {
  #|  let _ = t
  #|  let mut sum = 0
  #|  for x in xs {
  #|    sum += x
  #|  }
  #|  for i, x in xs {
  #|    sum += i + x
  #|  }
  #|  for let (a, b) = (0, 1); a < 2; sum += b {
  #|    break
  #|  }
  #|  let h2 = Holder::{ ..Holder::{ f: fn(z : Int) -> Int { z + 1 }, v: 0 }, v: 7 }
  #|  if Some(1) is Some(_) {
  #|    sum += h2.v
  #|  }
  #|  sum
  #|}
  #|pub trait Boxed {
  #|  fn tag(self) -> Int
  #|}
  #|pub struct Box1 { x : Int }
  #|impl Boxed for Box1 {
  #|  fn tag(self) -> Int { self.x }
  #|  fn wrap[T](self, y : T) -> (Int, T) { (self.x, y) }
  #|}
  let pr0 = parse_source("rt.pion", src)
  assert_true(pr0.diagnostics.length() == 0, "pr0 diags=" + pr0.diagnostics.length().to_string())
  let pkg = Package::{ name: "rt_pkg", files: [pr0.file] }
  let stub = emit_pion_stub(pkg)
  if stub.length() == 0 {
    let raw_stub = emit_file_stub(pr0.file)
    let dbg_pr = parse_source("dbg.pionstub", raw_stub)
    let msg = if dbg_pr.diagnostics.length() > 0 {
      dbg_pr.diagnostics[0].message + " at line " + dbg_pr.diagnostics[0].line.to_string()
    } else {
      "empty_no_diag"
    }
    assert_true(false, "emit_pion_stub returned empty: " + msg + "\n---STUB---\n" + raw_stub)
  }
  let pr1 = parse_source("rt_pkg.pionstub", stub)
  assert_true(pr1.diagnostics.length() == 0, "stub parse diags=" + pr1.diagnostics.length().to_string())

  // Compare AST of every generic fn body and generic impl method body strictly against original AST.
  let orig_fns : Map[String, FnDecl] = Map([])
  let mut di = 0
  while di < pr0.file.decls.length() {
    match pr0.file.decls[di] {
      DFn(fd) => if fd.type_params.length() > 0 { orig_fns.set(fd.name, fd) }
      DImpl(id) => {
        let mut mi = 0
        while mi < id.methods.length() {
          if id.methods[mi].type_params.length() > 0 {
            orig_fns.set("impl::" + id.methods[mi].name, id.methods[mi])
          }
          mi = mi + 1
        }
      }
      _ => ()
    }
    di = di + 1
  }
  let mut matched = 0
  di = 0
  while di < pr1.file.decls.length() {
    match pr1.file.decls[di] {
      DFn(fd) =>
        match orig_fns.get(fd.name) {
          Some(ofd) => {
            assert_true(sigt_stmts_eq(ofd.body, fd.body), "AST mismatch in generic fn " + fd.name)
            matched = matched + 1
          }
          None => ()
        }
      DImpl(id) => {
        let mut mi = 0
        while mi < id.methods.length() {
          let m = id.methods[mi]
          match orig_fns.get("impl::" + m.name) {
            Some(om) => {
              assert_true(om.type_params.length() == m.type_params.length(), "type_params mismatch in impl method " + m.name)
              assert_true(sigt_stmts_eq(om.body, m.body), "AST mismatch in generic impl method " + m.name)
              matched = matched + 1
            }
            None => ()
          }
          mi = mi + 1
        }
      }
      _ => ()
    }
    di = di + 1
  }
  assert_true(matched == 4, "expected 4 round-tripped generic bodies, got " + matched.to_string())
}
