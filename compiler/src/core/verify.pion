///| `#verify` static rules (SPEC §3.4), run after a `#verify` function body
///| type-checks, over its AST and the checker's `expr_tys` side table:
///|   - `E_VERIFY_UNSUPPORTED`     forbidden types (World, Ptr, Map, Double, dyn, ...)
///|   - `E_VERIFY_MOVE`            use of a moved `Unique` binding
///|   - `E_VERIFY_BORROW_ESCAPE`   a read-only `Unique` parameter written or escaping
///|   - `E_VERIFY_MUT_ESCAPE`      a `mut` parameter escaping
///|   - `E_VERIFY_CLOSURE_CAPTURE` a closure capturing `let mut` / `Unique` / `mut` bindings
///| (`E_VERIFY_ALIASING` and `E_VERIFY_UNVERIFIED_CALLEE` are checked at call
///| sites by the type checker.)

///|
/// Binding kinds of the `#verify` move/borrow analysis.
let vk_local : Int = 0

///|
let vk_mut_param : Int = 1

///|
/// A read-only view of a `Unique` value (non-`mut` parameter, or a pattern /
/// loop binding projected out of one): may be read, never written or moved.
let vk_borrowed : Int = 2

///|
/// A plain (`Copy`-typed) parameter.
let vk_plain : Int = 3

///|
/// A `Unique` binding projected out of a `mut` parameter.
let vk_mut_view : Int = 4

///|
struct VBind {
  id : Int
  ty : Ty
  kind : Int
  is_mut : Bool
}

///|
fn v_int_arr_contains(arr : Array[Int], v : Int) -> Bool {
  let mut i = 0
  while i < arr.length() {
    if arr[i] == v {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Set of moved binding IDs (insertion-ordered, so copies and unions are
/// deterministic).
struct VMoved {
  ids : Array[Int]
}

///|
fn vm_new() -> VMoved {
  VMoved::{ ids: [] }
}

///|
fn vm_contains(m : VMoved, id : Int) -> Bool {
  v_int_arr_contains(m.ids, id)
}

///|
fn vm_add(m : VMoved, id : Int) -> Unit {
  if !v_int_arr_contains(m.ids, id) {
    m.ids.push(id)
  }
}

///|
fn vm_remove(m : VMoved, id : Int) -> Unit {
  let keep : Array[Int] = []
  let mut i = 0
  while i < m.ids.length() {
    if m.ids[i] != id {
      keep.push(m.ids[i])
    }
    i = i + 1
  }
  m.ids.clear()
  i = 0
  while i < keep.length() {
    m.ids.push(keep[i])
    i = i + 1
  }
}

///|
struct VCtx {
  tc : TypeChecker
  fn_name : String
  fn_key : String
  scopes : Array[Map[String, VBind]]
  mut next_bind_id : Int
  mut moved : VMoved
  mut diverged : Bool
  loop_cont_moved : Array[VMoved]
  loop_had_cont : Array[Bool]
  loop_break_moved : Array[VMoved]
  loop_exit_moved : Array[VMoved]
  reported : Map[String, Bool]
  forbidden_seen : Map[String, Bool]
  /// Binding IDs of roots of live borrowed views (`for x in r`, a pattern
  /// binding a `Unique` part of `r`): `r` cannot be written, rebound, passed
  /// `mut` or moved while the view is alive (stack, nested scopes push / pop).
  pinned : Array[Int]
}

///|
fn v_err(
  ctx : VCtx,
  sp : Span,
  code : String,
  msg : String,
  expected : String,
  found : String,
  fixit : String,
) -> Unit {
  let k = code + "@" + span_key(sp)
  if ctx.reported.contains(k) {
    return
  }
  ctx.reported.set(k, true)
  tc_err(ctx.tc, sp, code, msg, expected, found, fixit)
}

///|
fn v_lookup_struct(tc : TypeChecker, name : String) -> Option[StructInfo] {
  match tc.structs.get(name) {
    Some(si) => Some(si)
    None => {
      let qp = split_qual_name(name)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.structs.get(qp.name) {
              Some(si) => Some(qbe_free_qualify_struct(qp.prefix, si))
              None => None
            }
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
fn qbe_free_qualify_struct(pkg : String, si : StructInfo) -> StructInfo {
  let ftys : Array[Ty] = []
  let mut i = 0
  while i < si.field_tys.length() {
    ftys.push(qualify_imported_ty(pkg, si.field_tys[i]))
    i = i + 1
  }
  StructInfo::{
    decl: si.decl,
    field_names: si.field_names,
    field_muts: si.field_muts,
    field_privs: si.field_privs,
    field_tys: ftys,
  }
}

///|
fn v_lookup_enum(tc : TypeChecker, name : String) -> Option[EnumInfo] {
  match tc.enums.get(name) {
    Some(ei) => Some(ei)
    None => {
      let qp = split_qual_name(name)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.enums.get(qp.name) {
              Some(ei) => {
                let vs : Array[VariantInfo] = []
                let mut i = 0
                while i < ei.variants.length() {
                  let ftys : Array[Ty] = []
                  let mut j = 0
                  while j < ei.variants[i].field_tys.length() {
                    ftys.push(qualify_imported_ty(qp.prefix, ei.variants[i].field_tys[j]))
                    j = j + 1
                  }
                  vs.push(VariantInfo::{ name: ei.variants[i].name, field_tys: ftys })
                  i = i + 1
                }
                Some(EnumInfo::{ decl: ei.decl, variants: vs })
              }
              None => None
            }
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
/// Name of the forbidden component of `t` inside `#verify` code, or "".
fn v_forbidden_in(tc : TypeChecker, fn_key : String, t : Ty, visiting : Array[String]) -> String {
  if visiting.length() > 32 {
    return ty_to_string(t)
  }
  match t {
    TWorld | TPtr | TScope | TAtomicInt | TFloat =>
      ty_to_string(t)
    TChannel(_) => "Channel"
    TMutex(_) => "Mutex"
    TDynTrait(n) => "dyn " + n
    TArray(e) | TFixedArray(e) | TOption(e) => v_forbidden_in(tc, fn_key, e, visiting)
    TImmArray(e) => {
      let f = v_forbidden_in(tc, fn_key, e, visiting)
      if f != "" {
        f
      } else if v_unique_in(tc, e, visiting) {
        "ImmArray[" + ty_to_string(e) + "]"
      } else {
        ""
      }
    }
    TResult(a, b) => {
      let fa = v_forbidden_in(tc, fn_key, a, visiting)
      if fa != "" {
        fa
      } else {
        v_forbidden_in(tc, fn_key, b, visiting)
      }
    }
    TMap(k, v) => {
      if v_has_float_in(tc, k, []) {
        return "Map[" + ty_to_string(k) + ", " + ty_to_string(v) + "] (float key)"
      }
      if fn_key != "" {
        let tps : Array[String] = []
        collect_eq_tparams_in_ty(tc, k, tps, Map([]))
        if tps.length() > 0 {
          verify_eq_tparams_add_all(tc, fn_key, tps)
        }
      }
      let fk = v_forbidden_in(tc, fn_key, k, visiting)
      if fk != "" {
        fk
      } else {
        v_forbidden_in(tc, fn_key, v, visiting)
      }
    }
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        let f = v_forbidden_in(tc, fn_key, es[i], visiting)
        if f != "" {
          return f
        }
        i = i + 1
      }
      ""
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        let f = v_forbidden_in(tc, fn_key, ps[i], visiting)
        if f != "" {
          return f
        }
        i = i + 1
      }
      v_forbidden_in(tc, fn_key, r, visiting)
    }
    TStruct(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return ""
      }
      visiting.push(key)
      let mut res = ""
      match v_lookup_struct(tc, name) {
        Some(si) => {
          let subst = make_subst(si.decl.type_params, args)
          let mut i = 0
          while i < si.field_tys.length() {
            let f = v_forbidden_in(tc, fn_key, subst_ty(si.field_tys[i], subst), visiting)
            if f != "" {
              res = f
              break
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    TEnum(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return ""
      }
      visiting.push(key)
      let mut res = ""
      match v_lookup_enum(tc, name) {
        Some(ei) => {
          let subst = make_subst(ei.decl.type_params, args)
          let mut i = 0
          while i < ei.variants.length() && res == "" {
            let v = ei.variants[i]
            let mut j = 0
            while j < v.field_tys.length() {
              let f = v_forbidden_in(tc, fn_key, subst_ty(v.field_tys[j], subst), visiting)
              if f != "" {
                res = f
                break
              }
              j = j + 1
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    _ => ""
  }
}

///|
pub fn v_has_custom_eq_in(tc : TypeChecker, t : Ty, visiting : Array[String]) -> Bool {
  if visiting.length() > 32 {
    return false
  }
  match t {
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) =>
      v_has_custom_eq_in(tc, e, visiting)
    TResult(a, b) =>
      v_has_custom_eq_in(tc, a, visiting) || v_has_custom_eq_in(tc, b, visiting)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if v_has_custom_eq_in(tc, es[i], visiting) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(name, args) => {
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(_) => return true
        None => ()
      }
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_struct(tc, name) {
        Some(si) => {
          let subst = make_subst(si.decl.type_params, args)
          let mut i = 0
          while i < si.field_tys.length() {
            if v_has_custom_eq_in(tc, subst_ty(si.field_tys[i], subst), visiting) {
              res = true
              break
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    TEnum(name, args) => {
      match tc_lookup_builtin_eq_impl(tc, name) {
        Some(_) => return true
        None => ()
      }
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_enum(tc, name) {
        Some(ei) => {
          let subst = make_subst(ei.decl.type_params, args)
          let mut i = 0
          while i < ei.variants.length() && !res {
            let v = ei.variants[i]
            let mut j = 0
            while j < v.field_tys.length() {
              if v_has_custom_eq_in(tc, subst_ty(v.field_tys[j], subst), visiting) {
                res = true
                break
              }
              j = j + 1
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    _ => false
  }
}

///|
fn v_unique_in(tc : TypeChecker, t : Ty, visiting : Array[String]) -> Bool {
  if visiting.length() > 32 {
    return true
  }
  match t {
    TArray(_) | TFixedArray(_) | TBytes | TBytesView | TStringBuilder | TMap(_, _) => true
    // Generic parameters may be instantiated with `Unique` types.
    TParam(_) => true
    TOption(e) => v_unique_in(tc, e, visiting)
    TResult(a, b) => v_unique_in(tc, a, visiting) || v_unique_in(tc, b, visiting)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if v_unique_in(tc, es[i], visiting) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_struct(tc, name) {
        Some(si) => {
          let subst = make_subst(si.decl.type_params, args)
          let mut i = 0
          while i < si.field_tys.length() {
            if si.field_muts[i] || v_unique_in(tc, subst_ty(si.field_tys[i], subst), visiting) {
              res = true
              break
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    TEnum(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_enum(tc, name) {
        Some(ei) => {
          let subst = make_subst(ei.decl.type_params, args)
          let mut i = 0
          while i < ei.variants.length() && !res {
            let v = ei.variants[i]
            let mut j = 0
            while j < v.field_tys.length() {
              if v_unique_in(tc, subst_ty(v.field_tys[j], subst), visiting) {
                res = true
                break
              }
              j = j + 1
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    _ => false
  }
}

///|
/// `#verify` type classes: `Forbidden` (rejected with `E_VERIFY_UNSUPPORTED`).
pub fn is_verify_forbidden_ty(tc : TypeChecker, t : Ty) -> Bool {
  v_forbidden_in(tc, "", t, []) != ""
}

///|
/// `#verify` type classes: `Unique` (moved on assignment / storage / return,
/// borrowed read-only when passed to a non-`mut` parameter).
pub fn is_verify_unique_ty(tc : TypeChecker, t : Ty) -> Bool {
  !is_verify_forbidden_ty(tc, t) && v_unique_in(tc, t, [])
}

///|
/// `#verify` type classes: `Copy` (value semantics, freely duplicated).
pub fn is_verify_copy_ty(tc : TypeChecker, t : Ty) -> Bool {
  !is_verify_forbidden_ty(tc, t) && !v_unique_in(tc, t, [])
}

///|
pub fn v_has_float_in(tc : TypeChecker, t : Ty, visiting : Array[String]) -> Bool {
  if visiting.length() > 32 {
    return true
  }
  match t {
    TDouble | TFloat => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) =>
      v_has_float_in(tc, e, visiting)
    TResult(a, b) | TMap(a, b) =>
      v_has_float_in(tc, a, visiting) || v_has_float_in(tc, b, visiting)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if v_has_float_in(tc, es[i], visiting) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_struct(tc, name) {
        Some(si) => {
          let subst = make_subst(si.decl.type_params, args)
          let mut i = 0
          while i < si.field_tys.length() {
            if v_has_float_in(tc, subst_ty(si.field_tys[i], subst), visiting) {
              res = true
              break
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    TEnum(name, args) => {
      let key = ty_to_string(t)
      if str_arr_contains(visiting, key) {
        return false
      }
      visiting.push(key)
      let mut res = false
      match v_lookup_enum(tc, name) {
        Some(ei) => {
          let subst = make_subst(ei.decl.type_params, args)
          let mut i = 0
          while i < ei.variants.length() && !res {
            let v = ei.variants[i]
            let mut j = 0
            while j < v.field_tys.length() {
              if v_has_float_in(tc, subst_ty(v.field_tys[j], subst), visiting) {
                res = true
                break
              }
              j = j + 1
            }
            i = i + 1
          }
        }
        None => ()
      }
      let _ = visiting.pop()
      res
    }
    _ => false
  }
}

///|
fn v_is_unique(ctx : VCtx, t : Ty) -> Bool {
  v_unique_in(ctx.tc, t, [])
}

///|
fn v_check_forbidden(ctx : VCtx, t : Ty, sp : Span) -> Unit {
  let f = v_forbidden_in(ctx.tc, ctx.fn_key, t, [])
  if f != "" && !ctx.forbidden_seen.contains(f) {
    ctx.forbidden_seen.set(f, true)
    v_err(
      ctx,
      sp,
      "E_VERIFY_UNSUPPORTED",
      "type `" + f + "` is not supported in `#verify` function `" + ctx.fn_name + "`",
      "Int / Int64 / UInt / UInt64 / Bool / Byte / Char / Unit / String, structs, enums, Array, FixedArray, ImmArray, Bytes",
      f,
      "move this code into a `#verify_opaque` helper, or use a supported type",
    )
  }
}

///|
fn v_expr_ty(ctx : VCtx, e : Expr) -> Ty {
  match ctx.tc.expr_tys.get(span_key(expr_span(e))) {
    Some(t) => t
    None => TError
  }
}

///|
fn v_push(ctx : VCtx) -> Unit {
  ctx.scopes.push(Map([]))
}

///|
fn v_pop(ctx : VCtx) -> Unit {
  if ctx.scopes.length() > 1 {
    let _ = ctx.scopes.pop()
  }
}

///|
fn v_define(ctx : VCtx, name : String, ty : Ty, kind : Int, is_mut : Bool) -> Unit {
  let id = ctx.next_bind_id
  ctx.next_bind_id = id + 1
  ctx.scopes[ctx.scopes.length() - 1].set(name, VBind::{
    id: id,
    ty: ty,
    kind: kind,
    is_mut: is_mut,
  })
}

///|
fn v_lookup(ctx : VCtx, name : String) -> Option[VBind] {
  let mut i = ctx.scopes.length() - 1
  while i >= 0 {
    match ctx.scopes[i].get(name) {
      Some(b) => return Some(b)
      None => ()
    }
    i = i - 1
  }
  None
}

///|
fn v_copy_moved(m : VMoved) -> VMoved {
  let out = vm_new()
  let mut i = 0
  while i < m.ids.length() {
    out.ids.push(m.ids[i])
    i = i + 1
  }
  out
}

///|
fn v_union_into(dst : VMoved, src : VMoved) -> Unit {
  let mut i = 0
  while i < src.ids.length() {
    vm_add(dst, src.ids[i])
    i = i + 1
  }
}

///|
fn v_place_root(e : Expr) -> String {
  match e {
    EIdent(n, _) => n
    EField(o, _, _) => v_place_root(o)
    EIndex(o, _, _) => v_place_root(o)
    EMutArg(inner, _) => v_place_root(inner)
    ENamedArg(_, _, inner, _) => v_place_root(inner)
    EMove(inner, _) => v_place_root(inner)
    _ => ""
  }
}

///|
/// A `Unique` value flows into a new owner (binding, field, element, return).
fn v_consume(ctx : VCtx, e : Expr) -> Unit {
  let root = v_place_root(e)
  if root == "" {
    return
  }
  let ty = v_expr_ty(ctx, e)
  if !v_is_unique(ctx, ty) {
    return
  }
  match v_lookup(ctx, root) {
    None => ()
    Some(b) => {
      let sp = expr_span(e)
      if b.kind == vk_borrowed {
        v_err(
          ctx,
          sp,
          "E_VERIFY_BORROW_ESCAPE",
          "read-only `Unique` value `" + root + "` cannot escape (stored, returned, or bound by `let`) in `#verify` function `" + ctx.fn_name + "`",
          "read / pass on read-only",
          "escape of `" + root + "`",
          "use `" + root + ".copy()` to take an owned copy, or declare the parameter `mut`",
        )
      } else if b.kind == vk_mut_param || b.kind == vk_mut_view {
        v_err(
          ctx,
          sp,
          "E_VERIFY_MUT_ESCAPE",
          "`mut` parameter `" + root + "` cannot escape (stored, returned, or bound by `let`) in `#verify` function `" + ctx.fn_name + "`",
          "in-place use of the `mut` parameter",
          "escape of `" + root + "`",
          "use `" + root + ".copy()` to take an owned copy",
        )
      } else if b.kind == vk_local {
        v_pin_check(ctx, b.id, root, sp, "move")
        vm_add(ctx.moved, b.id)
      }
    }
  }
}

///|
fn v_unpin_to(ctx : VCtx, n : Int) -> Unit {
  while ctx.pinned.length() > n {
    let _ = ctx.pinned.pop()
  }
}

///|
/// `E_VERIFY_ALIASING`: `root` is pinned by a live `for` iteration or
/// pattern-binding view and must not be modified, rebound or moved.
fn v_pin_check(ctx : VCtx, id : Int, root : String, sp : Span, what : String) -> Unit {
  if id >= 0 && v_int_arr_contains(ctx.pinned, id) {
    v_err(
      ctx,
      sp,
      "E_VERIFY_ALIASING",
      "cannot " + what + " `" + root + "` while a borrowed view of it (`for` iteration or pattern binding) is alive in `#verify` function `" + ctx.fn_name + "`",
      "no modification of `" + root + "` during the view",
      what + " `" + root + "`",
      "iterate / match over `" + root + ".copy()`, or move the modification after the loop / match",
    )
  }
}

///|
fn v_check_write(ctx : VCtx, lhs : Expr) -> Unit {
  let root = v_place_root(lhs)
  if root == "" {
    v_err(
      ctx,
      expr_span(lhs),
      "E_VERIFY_BORROW_ESCAPE",
      "cannot write through non-place expression in `#verify` function `" + ctx.fn_name + "`",
      "owned local or `mut` parameter place",
      "non-place expression",
      "bind the value to a `let mut` local before mutating it",
    )
    return
  }
  match v_lookup(ctx, root) {
    Some(b) => {
      v_pin_check(ctx, b.id, root, expr_span(lhs), "modify")
      if b.kind == vk_borrowed {
        v_err(
          ctx,
          expr_span(lhs),
          "E_VERIFY_BORROW_ESCAPE",
          "cannot write through read-only `Unique` value `" + root + "` in `#verify` function `" + ctx.fn_name + "`",
          "`mut` parameter or owned local",
          "write to read-only `" + root + "`",
          "declare the parameter `mut " + root + " : ...` and pass `mut` at call sites",
        )
      }
    }
    None =>
      v_err(
        ctx,
        expr_span(lhs),
        "E_VERIFY_BORROW_ESCAPE",
        "cannot write through non-place expression in `#verify` function `" + ctx.fn_name + "`",
        "owned local or `mut` parameter place",
        "non-place expression",
        "bind the value to a `let mut` local before mutating it",
      )
  }
}

///|
fn v_is_mutating_builtin(m : String) -> Bool {
  m == "push" ||
  m == "pop" ||
  m == "set" ||
  m == "swap" ||
  m == "clear" ||
  m == "truncate" ||
  m == "reset" ||
  m == "reverse" ||
  m == "sort" ||
  m == "fill" ||
  m == "remove" ||
  m == "insert" ||
  m == "truncate" ||
  m == "write_byte" ||
  m == "write_string" ||
  m == "write_substring" ||
  m == "write_char" ||
  m == "write_int" ||
  m == "write_bytes"
}

///|
fn v_is_storing_builtin(m : String) -> Bool {
  m == "push" || m == "set" || m == "fill" || m == "insert" || m == "unwrap_or"
}

///|
fn v_is_builtin_call(ctx : VCtx, sp : Span) -> Bool {
  match ctx.tc.call_targets.get(span_key(sp)) {
    Some(t) => t.length() >= 9 && slice_str(t, 0, 9) == "builtin::"
    None => true
  }
}

///|
/// Binding kind of a pattern / loop variable projected out of `scrut`.
/// Every place scrutinee (including `mut` parameters) projects read-only
/// views (`vk_borrowed`, SPEC §3.4), since pattern bindings cannot write back
/// into the enclosing container/enum.
fn v_projected_kind(ctx : VCtx, scrut : Expr) -> Int {
  let root = v_place_root(scrut)
  if root == "" {
    return vk_local
  }
  match v_lookup(ctx, root) {
    Some(_) => vk_borrowed
    None => vk_local
  }
}

///|
/// Binds a pattern's variables; true when one of them is `Unique`.
fn v_bind_pattern(ctx : VCtx, pat : Pattern, kind : Int) -> Bool {
  match pat {
    PIdent(name, sp) => {
      let ty = match ctx.tc.expr_tys.get(span_key(sp)) {
        Some(t) => t
        None => TError
      }
      v_check_forbidden(ctx, ty, sp)
      let uniq = v_is_unique(ctx, ty)
      let k = if uniq { kind } else { vk_local }
      v_define(ctx, name, ty, k, false)
      uniq
    }
    PVariant(_, _, pats, _, _) | PTuple(pats, _) => {
      let mut any = false
      let mut i = 0
      while i < pats.length() {
        if v_bind_pattern(ctx, pats[i], kind) {
          any = true
        }
        i = i + 1
      }
      any
    }
    _ => false
  }
}

///|
/// Scrutinee of a `match` / `is`: a non-place `Unique` expression is consumed
/// (owned by the pattern bindings, rejecting borrowed escapes); a place is
/// viewed read-only and its outer binding ID is returned before pattern
/// bindings can shadow its name.
fn v_scrutinee(ctx : VCtx, scrut : Expr) -> (Int, Int) {
  let root = v_place_root(scrut)
  if root == "" {
    v_expr(ctx, scrut, v_is_unique(ctx, v_expr_ty(ctx, scrut)))
    (vk_local, -1)
  } else {
    v_expr(ctx, scrut, false)
    let k = v_projected_kind(ctx, scrut)
    let id = match v_lookup(ctx, root) {
      Some(b) => b.id
      None => -1
    }
    (k, id)
  }
}

///|
fn v_closure(ctx : VCtx, params : Array[Param], body : Array[Stmt], sp : Span) -> Unit {
  let locals : Map[String, Bool] = Map([])
  let mut i = 0
  while i < params.length() {
    locals.set(params[i].name, true)
    i = i + 1
  }
  let caps : Array[CaptureInfo] = []
  collect_stmts_captures(body, locals, caps)
  let seen : Map[String, Bool] = Map([])
  i = 0
  while i < caps.length() {
    let cn = caps[i].name
    if !seen.contains(cn) {
      seen.set(cn, true)
      match v_lookup(ctx, cn) {
        Some(b) =>
          if b.is_mut || b.kind == vk_mut_param || v_is_unique(ctx, b.ty) {
            v_err(
              ctx,
              caps[i].span,
              "E_VERIFY_CLOSURE_CAPTURE",
              "closure in `#verify` function `" + ctx.fn_name + "` captures `" + cn + "`" +
              (if b.is_mut { " (a mutable binding)" } else { " (a `Unique` value)" }),
              "immutable `Copy` capture",
              cn,
              "pass `" + cn + "` to the closure as a parameter, or capture an immutable `Copy` value",
            )
          }
        None => ()
      }
    }
    i = i + 1
  }
  let ptys : Array[Ty] = match ctx.tc.closure_infer.get(span_key(sp)) {
    Some(TFn(ps, _)) => ps
    _ => []
  }
  let saved_moved = v_copy_moved(ctx.moved)
  let saved_div = ctx.diverged
  v_push(ctx)
  i = 0
  while i < params.length() {
    let pt = if i < ptys.length() { ptys[i] } else { TError }
    v_check_forbidden(ctx, pt, params[i].span)
    let k = if v_is_unique(ctx, pt) { vk_borrowed } else { vk_plain }
    v_define(ctx, params[i].name, pt, k, false)
    i = i + 1
  }
  v_stmts(ctx, body, true)
  v_pop(ctx)
  ctx.moved = saved_moved
  ctx.diverged = saved_div
}

///|
fn v_args(ctx : VCtx, args : Array[Expr], consume : Bool) -> Unit {
  let mut i = 0
  while i < args.length() {
    let a = match args[i] {
      ENamedArg(_, _, inner, _) => inner
      other => other
    }
    match a {
      EMutArg(inner, _) => {
        let r = v_place_root(inner)
        match v_lookup(ctx, r) {
          Some(b) => v_pin_check(ctx, b.id, r, expr_span(inner), "pass as `mut`")
          None => ()
        }
        v_expr(ctx, inner, false)
      }
      _ => v_expr(ctx, a, consume)
    }
    i = i + 1
  }
}

///|
fn v_expr(ctx : VCtx, e : Expr, consume : Bool) -> Unit {
  match ctx.tc.expr_tys.get(span_key(expr_span(e))) {
    Some(t) => v_check_forbidden(ctx, t, expr_span(e))
    None => ()
  }
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EFloat(_, _) => ()
    EDouble(_, sp) =>
      v_err(
        ctx,
        sp,
        "E_VERIFY_UNSUPPORTED",
        "`Double` literal is not supported in `#verify` function `" + ctx.fn_name + "`",
        "bit-pattern primitive (`Double::from_bits` / `reinterpret_as_double`)",
        "Double literal",
        "construct `Double` from its IEEE-754 bit pattern with `Double::from_bits(...)`",
      )
    EBool(_, _) | EByte(_, _) | EChar(_, _) | EString(_, _) | EUnit(_) | EPath(_, _, _) => ()
    EIdent(n, sp) => {
      match v_lookup(ctx, n) {
        Some(b) =>
          if vm_contains(ctx.moved, b.id) {
            v_err(
              ctx,
              sp,
              "E_VERIFY_MOVE",
              "use of moved `Unique` value `" + n + "` in `#verify` function `" + ctx.fn_name + "`",
              "live binding",
              "moved `" + n + "`",
              "use `" + n + ".copy()` where it was moved, or reassign `" + n + "` before this use",
            )
          }
        None => ()
      }
      if consume {
        v_consume(ctx, e)
      }
    }
    EField(obj, _, _) => {
      let obj_consume = consume && v_is_unique(ctx, v_expr_ty(ctx, e)) && v_place_root(e) == ""
      v_expr(ctx, obj, obj_consume)
      if consume && !obj_consume {
        v_consume(ctx, e)
      }
    }
    EIndex(obj, idx, _) => {
      let obj_consume = consume && v_is_unique(ctx, v_expr_ty(ctx, e)) && v_place_root(e) == ""
      v_expr(ctx, obj, obj_consume)
      v_expr(ctx, idx, false)
      if consume && !obj_consume {
        v_consume(ctx, e)
      }
    }
    EMutArg(inner, _) => {
      let r = v_place_root(inner)
      match v_lookup(ctx, r) {
        Some(b) => v_pin_check(ctx, b.id, r, expr_span(inner), "pass as `mut`")
        None => ()
      }
      v_expr(ctx, inner, false)
    }
    ENamedArg(_, _, inner, _) => v_expr(ctx, inner, consume)
    EMove(inner, _) => v_expr(ctx, inner, true)
    EDotVariant(_, args, _) => v_args(ctx, args, true)
    EUnary(op, inner, sp) => {
      v_expr(ctx, inner, false)
      match v_expr_ty(ctx, inner) {
        TDouble =>
          v_err(
            ctx,
            sp,
            "E_VERIFY_UNSUPPORTED",
            "operator `" + op + "` on `Double` is not supported in `#verify` function `" + ctx.fn_name + "`",
            "bit-pattern primitive (`Double::from_bits`, `.to_bits()`, `.reinterpret_as_uint64()`)",
            "Double " + op,
            "operate on `d.to_bits()` / `d.reinterpret_as_uint64()`, or move floating-point arithmetic into a `#verify_opaque` helper",
          )
        _ => ()
      }
    }
    EBinary(op, l, r, sp) => {
      if op == "&&" {
        let pin_base = ctx.pinned.length()
        v_push(ctx)
        let (mf_l, df_l) = v_cond(ctx, l, true)
        if !ctx.diverged {
          let _ = v_cond(ctx, r, true)
          if !df_l {
            v_union_into(ctx.moved, mf_l)
          }
          ctx.diverged = ctx.diverged && df_l
        } else {
          ctx.moved = mf_l
          ctx.diverged = df_l
        }
        v_pop(ctx)
        v_unpin_to(ctx, pin_base)
      } else if op == "||" {
        v_expr(ctx, l, false)
        let m_before = v_copy_moved(ctx.moved)
        let d_before = ctx.diverged
        v_expr(ctx, r, false)
        v_union_into(ctx.moved, m_before)
        ctx.diverged = d_before
      } else {
        v_expr(ctx, l, false)
        v_expr(ctx, r, false)
      }
      let lt = v_expr_ty(ctx, l)
      let rt = v_expr_ty(ctx, r)
      let is_dbl = match (lt, rt) {
        (TDouble, _) | (_, TDouble) => true
        _ =>
          (op == "==" || op == "!=") &&
          (v_has_float_in(ctx.tc, lt, []) || v_has_float_in(ctx.tc, rt, []))
      }
      if is_dbl {
        v_err(
          ctx,
          sp,
          "E_VERIFY_UNSUPPORTED",
          "operator `" + op + "` on `Double` is not supported in `#verify` function `" + ctx.fn_name + "`",
          "bit-pattern primitive (`Double::from_bits`, `.to_bits()`, `.reinterpret_as_uint64()`)",
          "Double " + op,
          "operate on `d.to_bits()` / `d.reinterpret_as_uint64()`, or move floating-point arithmetic into a `#verify_opaque` helper",
        )
      }
      if (op == "==" || op == "!=") &&
        (v_has_custom_eq_in(ctx.tc, lt, []) || v_has_custom_eq_in(ctx.tc, rt, [])) {
        v_err(
          ctx,
          sp,
          "E_VERIFY_UNSUPPORTED",
          "operator `" + op + "` on custom `impl Eq` type is not supported in `#verify` function `" + ctx.fn_name + "`",
          "structural `#derive(Eq)` or primitive equality",
          ty_to_string(lt) + " " + op + " " + ty_to_string(rt),
          "use `#derive(Eq)` or move custom `impl Eq` comparisons into a `#verify_opaque` helper",
        )
      }
    }
    ECall(callee, args, sp) => {
      match callee {
        EIdent(_, _) | EPath(_, _, _) => v_expr(ctx, callee, false)
        _ => v_expr(ctx, callee, false)
      }
      let builtin = v_is_builtin_call(ctx, sp)
      if builtin {
        match callee {
          EIdent(cname, _) =>
            if cname == "physical_equal" {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "`physical_equal` is not supported in `#verify` function `" + ctx.fn_name + "`",
                "value equality (`==`) or `#verify_opaque` helper",
                "physical_equal",
                "use value equality `==`, or move pointer-identity checks into a `#verify_opaque` helper",
              )
            }
          EPath(q, m, _) =>
            if (q == "Array" || q == "FixedArray") && m == "make" {
              match v_expr_ty(ctx, e) {
                TArray(el) | TFixedArray(el) =>
                  if v_is_unique(ctx, el) {
                    v_err(
                      ctx,
                      sp,
                      "E_VERIFY_UNSUPPORTED",
                      "`" + q + "::make` requires a `Copy` element type in `#verify` function `" + ctx.fn_name + "` (got `Unique` type `" + ty_to_string(el) + "`)",
                      "`Copy` element type",
                      ty_to_string(el),
                      "build the array in a loop pushing fresh values, or use a `Copy` element type",
                    )
                  }
                _ => ()
              }
            }
          _ => ()
        }
      }
      // Builtins and variant constructors store their arguments; user
      // functions borrow non-`mut` arguments.
      v_args(ctx, args, builtin)
    }
    EMethodCall(obj, m, args, sp) => {
      let builtin = v_is_builtin_call(ctx, sp)
      let obj_ty = v_expr_ty(ctx, obj)
      let consume_obj = builtin && m == "unwrap_or" && match obj_ty {
        TOption(el) | TResult(el, _) => v_is_unique(ctx, el)
        _ => false
      }
      v_expr(ctx, obj, consume_obj)
      if builtin {
        match obj_ty {
          TDouble =>
            if m != "to_bits" &&
              m != "reinterpret_as_uint64" &&
              m != "reinterpret_as_int64" &&
              m != "is_nan" &&
              m != "is_inf" &&
              m != "is_finite" &&
              m != "compare" {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `Double::" + m + "` is not supported in `#verify` function `" + ctx.fn_name + "`",
                "`to_bits`, `reinterpret_as_int64`, `reinterpret_as_uint64`, `is_nan`, `is_inf`, `is_finite`, or `compare`",
                "Double::" + m,
                "use `to_bits()` / `reinterpret_as_int64()` / `reinterpret_as_uint64()` / `is_nan()` / `is_inf()` / `is_finite()` / `compare()`, or move floating-point operations into a `#verify_opaque` helper",
              )
            }
          TInt | TInt64 | TUInt | TUInt64 | TByte | TInt8 =>
            if m == "to_double" {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `" + ty_to_string(obj_ty) + "::to_double` is not supported in `#verify` function `" + ctx.fn_name + "`",
                "`reinterpret_as_double` or `Double::from_bits`",
                "to_double",
                "use `reinterpret_as_double()` / `Double::from_bits()`, or move floating-point conversions into a `#verify_opaque` helper",
              )
            }
          TArray(el) => {
            if m == "copy" && v_is_unique(ctx, el) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `copy` on `" + ty_to_string(obj_ty) + "` requires a `Copy` element type in `#verify` function `" + ctx.fn_name + "` (got `Unique` type `" + ty_to_string(el) + "`)",
                "`Copy` element type",
                ty_to_string(el),
                "move the array directly, or clone each element in a loop",
              )
            }
            if m == "contains" && v_has_float_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses floating-point equality, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "non-float element type",
                ty_to_string(el),
                "compare bit patterns (`to_bits()`) or move floating-point equality into a `#verify_opaque` helper",
              )
            }
            if m == "contains" && v_has_custom_eq_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses custom `impl Eq`, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "structural `#derive(Eq)` or primitive element type",
                ty_to_string(el),
                "move custom `impl Eq` comparisons into a `#verify_opaque` helper",
              )
            }
          }
          TFixedArray(el) => {
            if (m == "copy" || m == "fill" || m == "blit_to") && v_is_unique(ctx, el) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `" + m + "` on `" + ty_to_string(obj_ty) + "` requires a `Copy` element type in `#verify` function `" + ctx.fn_name + "` (got `Unique` type `" + ty_to_string(el) + "`)",
                "`Copy` element type",
                ty_to_string(el),
                if m == "copy" {
                  "move the array directly, or clone each element in a loop"
                } else if m == "fill" {
                  "assign fresh elements in a loop instead of `.fill()`"
                } else {
                  "copy elements in a loop instead of `.blit_to()`"
                },
              )
            }
            if m == "contains" && v_has_float_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses floating-point equality, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "non-float element type",
                ty_to_string(el),
                "compare bit patterns (`to_bits()`) or move floating-point equality into a `#verify_opaque` helper",
              )
            }
            if m == "contains" && v_has_custom_eq_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses custom `impl Eq`, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "structural `#derive(Eq)` or primitive element type",
                ty_to_string(el),
                "move custom `impl Eq` comparisons into a `#verify_opaque` helper",
              )
            }
          }
          TImmArray(el) => {
            if m == "contains" && v_has_float_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses floating-point equality, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "non-float element type",
                ty_to_string(el),
                "compare bit patterns (`to_bits()`) or move floating-point equality into a `#verify_opaque` helper",
              )
            }
            if m == "contains" && v_has_custom_eq_in(ctx.tc, el, []) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `contains` on `" + ty_to_string(obj_ty) + "` uses custom `impl Eq`, which is not supported in `#verify` function `" + ctx.fn_name + "`",
                "structural `#derive(Eq)` or primitive element type",
                ty_to_string(el),
                "move custom `impl Eq` comparisons into a `#verify_opaque` helper",
              )
            }
          }
          TMap(k, v) => {
            if m == "copy" && (v_is_unique(ctx, k) || v_is_unique(ctx, v)) {
              let bad_ty = if v_is_unique(ctx, v) { v } else { k }
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `copy` on `" + ty_to_string(obj_ty) + "` requires `Copy` key and value types in `#verify` function `" + ctx.fn_name + "` (got `Unique` type `" + ty_to_string(bad_ty) + "`)",
                "`Copy` key and value types",
                ty_to_string(bad_ty),
                "move the map directly, or store `Copy` values",
              )
            }
            if m == "get" && v_is_unique(ctx, v) {
              v_err(
                ctx,
                sp,
                "E_VERIFY_UNSUPPORTED",
                "method `get` on `" + ty_to_string(obj_ty) + "` requires a `Copy` value type in `#verify` function `" + ctx.fn_name + "` (got `Unique` type `" + ty_to_string(v) + "`)",
                "`Copy` value type",
                ty_to_string(v),
                "store `Copy` values in `Map` inside `#verify` code",
              )
            }
          }
          _ => ()
        }
      }
      if builtin && v_is_mutating_builtin(m) {
        v_check_write(ctx, obj)
      }
      if builtin && m == "blit_to" && args.length() > 0 {
        v_check_write(ctx, args[0])
      }
      if ctx.tc.mut_recv_calls.contains(span_key(sp)) {
        v_check_write(ctx, obj)
      }
      v_args(ctx, args, builtin && v_is_storing_builtin(m))
    }
    EArrayLit(elems, _) => v_args(ctx, elems, true)
    ETuple(elems, _) => v_args(ctx, elems, true)
    EStructLit(_, spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        v_expr(ctx, fields[i].value, true)
        i = i + 1
      }
      match spread {
        Some(base) => v_expr(ctx, base, true)
        None => ()
      }
    }
    EBlock(stmts, _) => {
      v_push(ctx)
      v_stmts(ctx, stmts, consume)
      v_pop(ctx)
    }
    EIf(cond, then_stmts, else_opt, _) => {
      let pin_base = ctx.pinned.length()
      v_push(ctx)
      let (m_false, d_false) = v_cond(ctx, cond, true)
      v_stmts(ctx, then_stmts, consume)
      v_pop(ctx)
      v_unpin_to(ctx, pin_base)
      let m1 = ctx.moved
      let d1 = ctx.diverged
      ctx.moved = m_false
      ctx.diverged = d_false
      match else_opt {
        Some(el) => v_expr(ctx, el, consume)
        None => ()
      }
      let d2 = ctx.diverged
      if d1 && !d2 {
        ()
      } else if d2 && !d1 {
        ctx.moved = m1
      } else {
        v_union_into(ctx.moved, m1)
      }
      ctx.diverged = d1 && d2
    }
    EIs(scrut, pat, _) => {
      let (k, scrut_id) = v_scrutinee(ctx, scrut)
      let pin_base = ctx.pinned.length()
      v_push(ctx)
      let bu = v_bind_pattern(ctx, pat, k)
      if bu && scrut_id >= 0 {
        ctx.pinned.push(scrut_id)
      }
      v_pop(ctx)
      v_unpin_to(ctx, pin_base)
    }
    EMatch(scrut, arms, _) => {
      let (k, scrut_id) = v_scrutinee(ctx, scrut)
      let m_fall = v_copy_moved(ctx.moved)
      let d0 = ctx.diverged
      let merged = vm_new()
      let mut all_div = arms.length() > 0
      let mut i = 0
      while i < arms.length() {
        ctx.moved = v_copy_moved(m_fall)
        ctx.diverged = d0
        v_push(ctx)
        let pin_base = ctx.pinned.length()
        let bu = v_bind_pattern(ctx, arms[i].pat, k)
        if bu && scrut_id >= 0 {
          ctx.pinned.push(scrut_id)
        }
        match arms[i].guard_expr {
          Some(g) => {
            let (mg_false, dg_false) = v_cond(ctx, g, true)
            // A false guard falls through to later arms with its moves intact.
            if !dg_false {
              v_union_into(m_fall, mg_false)
            }
          }
          None => ()
        }
        v_expr(ctx, arms[i].body, consume)
        v_unpin_to(ctx, pin_base)
        v_pop(ctx)
        if !ctx.diverged {
          all_div = false
          v_union_into(merged, ctx.moved)
        }
        i = i + 1
      }
      if all_div {
        ctx.moved = m_fall
      } else {
        ctx.moved = merged
      }
      ctx.diverged = d0 || all_div
    }
    EClosure(params, _, body, sp) => v_closure(ctx, params, body, sp)
    EScope(a, b, _) | ESpawn(a, b, _) => {
      v_expr(ctx, a, false)
      v_expr(ctx, b, false)
    }
    EAs(inner, _, _) => v_expr(ctx, inner, consume)
    ETry(inner, _) => v_expr(ctx, inner, consume)
    EInterp(parts, _) => v_args(ctx, parts, false)
  }
}

///|
/// Condition of `if` / `while` / `guard` / C-style `for`: `is` patterns bind
/// into the current scope (the branch scope pushed by the caller).
/// Leaves `ctx.moved`/`ctx.diverged` at the true-branch state (all `&&`
/// operands ran) and returns `(m_false, d_false)` for the false branch.
fn v_cond(ctx : VCtx, cond : Expr, bind_is : Bool) -> (VMoved, Bool) {
  match cond {
    EBinary("&&", l, r, _) => {
      let (mf_l, df_l) = v_cond(ctx, l, bind_is)
      if ctx.diverged {
        return (mf_l, df_l)
      }
      let (mf_r, df_r) = v_cond(ctx, r, bind_is)
      let mf = if !df_l && !df_r {
        v_union_into(mf_l, mf_r)
        mf_l
      } else if df_l {
        mf_r
      } else {
        mf_l
      }
      (mf, df_l && df_r)
    }
    EIs(scrut, pat, _) if bind_is => {
      let (k, scrut_id) = v_scrutinee(ctx, scrut)
      let bu = v_bind_pattern(ctx, pat, k)
      if bu && scrut_id >= 0 {
        ctx.pinned.push(scrut_id)
      }
      (v_copy_moved(ctx.moved), ctx.diverged)
    }
    _ => {
      v_expr(ctx, cond, false)
      (v_copy_moved(ctx.moved), ctx.diverged)
    }
  }
}

///|
fn v_loop_body(ctx : VCtx, has_cond : Bool, run : (Int) -> Unit) -> Unit {
  let d0 = ctx.diverged
  let m_entry = v_copy_moved(ctx.moved)
  ctx.loop_cont_moved.push(vm_new())
  ctx.loop_had_cont.push(false)
  ctx.loop_break_moved.push(vm_new())
  ctx.loop_exit_moved.push(vm_new())
  let idx = ctx.loop_cont_moved.length() - 1
  // Pass 0: first iteration from `m_entry`.
  run(0)
  let end0_div = ctx.diverged
  let had_cont0 = ctx.loop_had_cont[idx]
  if !end0_div || had_cont0 {
    let back0 = if !end0_div && had_cont0 {
      let u = v_copy_moved(ctx.moved)
      v_union_into(u, ctx.loop_cont_moved[idx])
      u
    } else if !end0_div {
      v_copy_moved(ctx.moved)
    } else {
      v_copy_moved(ctx.loop_cont_moved[idx])
    }
    // Pass 1: next iteration with entry + reachable back-edge moves.
    ctx.loop_cont_moved[idx] = vm_new()
    ctx.loop_had_cont[idx] = false
    ctx.moved = v_copy_moved(m_entry)
    v_union_into(ctx.moved, back0)
    ctx.diverged = d0
    run(1)
    let end1_div = ctx.diverged
    let had_cont1 = ctx.loop_had_cont[idx]
    if has_cond {
      // Condition-tested loop (`while` / C-style `for`): every non-`break` exit
      // evaluates `cond` to false. Run a final condition-only pass (`pass == 2`)
      // on any reachable Pass-1 back-edge so delayed moves are captured in
      // `loop_exit_moved` without falsely unioning pre-condition body moves.
      if !end1_div || had_cont1 {
        let back1 = if !end1_div && had_cont1 {
          let u = v_copy_moved(ctx.moved)
          v_union_into(u, ctx.loop_cont_moved[idx])
          u
        } else if !end1_div {
          v_copy_moved(ctx.moved)
        } else {
          v_copy_moved(ctx.loop_cont_moved[idx])
        }
        ctx.moved = v_copy_moved(m_entry)
        v_union_into(ctx.moved, back0)
        v_union_into(ctx.moved, back1)
        ctx.diverged = d0
        run(2)
      }
      let post = v_copy_moved(ctx.loop_exit_moved[idx])
      v_union_into(post, ctx.loop_break_moved[idx])
      ctx.moved = post
    } else {
      let post = v_copy_moved(m_entry)
      v_union_into(post, ctx.loop_exit_moved[idx])
      v_union_into(post, back0)
      if !end1_div {
        v_union_into(post, ctx.moved)
      }
      if had_cont1 {
        v_union_into(post, ctx.loop_cont_moved[idx])
      }
      v_union_into(post, ctx.loop_break_moved[idx])
      ctx.moved = post
    }
  } else {
    // Unconditional return/break without `continue`: Pass 1 is unreachable.
    let post = if has_cond {
      v_copy_moved(ctx.loop_exit_moved[idx])
    } else {
      let p = v_copy_moved(m_entry)
      v_union_into(p, ctx.loop_exit_moved[idx])
      p
    }
    v_union_into(post, ctx.loop_break_moved[idx])
    ctx.moved = post
  }
  let _ = ctx.loop_cont_moved.pop()
  let _ = ctx.loop_had_cont.pop()
  let _ = ctx.loop_break_moved.pop()
  let _ = ctx.loop_exit_moved.pop()
  ctx.diverged = d0
}

///|
fn v_stmts(ctx : VCtx, stmts : Array[Stmt], consume_tail : Bool) -> Unit {
  // Views opened by `guard ... is` / bare `is` live to the end of the block.
  let pin_base = ctx.pinned.length()
  let mut i = 0
  while i < stmts.length() {
    let is_tail = i == stmts.length() - 1
    v_stmt(ctx, stmts[i], consume_tail && is_tail)
    i = i + 1
  }
  v_unpin_to(ctx, pin_base)
}

///|
fn v_stmt(ctx : VCtx, st : Stmt, consume : Bool) -> Unit {
  match st {
    SLet(name, is_mut, _, init, _) => {
      v_expr(ctx, init, true)
      v_define(ctx, name, v_expr_ty(ctx, init), vk_local, is_mut)
    }
    SLetTuple(names, _, init, _) => {
      v_expr(ctx, init, true)
      let ety = v_expr_ty(ctx, init)
      let mut i = 0
      while i < names.length() {
        let t = match ety {
          TTuple(es) => if i < es.length() { es[i] } else { TError }
          _ => TError
        }
        if names[i] != "_" {
          v_define(ctx, names[i], t, vk_local, false)
        }
        i = i + 1
      }
    }
    SAssign(lhs, rhs, _) => {
      v_expr(ctx, rhs, true)
      match lhs {
        EIdent(n, nsp) =>
          match v_lookup(ctx, n) {
            Some(b) => {
              v_pin_check(ctx, b.id, n, nsp, "rebind")
              vm_remove(ctx.moved, b.id)
            }
            None => v_define(ctx, n, v_expr_ty(ctx, rhs), vk_local, true)
          }
        EField(o, _, _) => {
          v_expr(ctx, o, false)
          v_check_write(ctx, lhs)
        }
        EIndex(o, idx, _) => {
          v_expr(ctx, o, false)
          v_expr(ctx, idx, false)
          v_check_write(ctx, lhs)
        }
        _ => {
          v_expr(ctx, lhs, false)
          v_check_write(ctx, lhs)
        }
      }
    }
    SCompoundAssign(_, lhs, rhs, _) => {
      v_expr(ctx, rhs, false)
      v_expr(ctx, lhs, false)
      v_check_write(ctx, lhs)
    }
    SGuard(cond, else_body, _) => {
      let pin_base = ctx.pinned.length()
      v_push(ctx)
      let (m_false, d_false) = v_cond(ctx, cond, true)
      let m_true = v_copy_moved(ctx.moved)
      let d_true = ctx.diverged
      // Pop guard bindings & pins while checking `else_body` so the false
      // branch sees only the outer scope (matching `types.pion:5992`).
      let guard_scope = match ctx.scopes.pop() {
        Some(sc) => sc
        None => Map([])
      }
      let guard_pins : Array[Int] = []
      while ctx.pinned.length() > pin_base {
        match ctx.pinned.pop() {
          Some(pid) => guard_pins.push(pid)
          None => ()
        }
      }
      ctx.moved = m_false
      ctx.diverged = d_false
      v_push(ctx)
      v_stmts(ctx, else_body, false)
      v_pop(ctx)
      // Restore guard bindings & pins into the enclosing block for the
      // fallthrough (true) path.
      let gkeys = guard_scope.keys()
      let dst = ctx.scopes[ctx.scopes.length() - 1]
      let mut gi = 0
      while gi < gkeys.length() {
        let gk = gkeys[gi]
        match guard_scope.get(gk) {
          Some(gv) => dst.set(gk, gv)
          None => ()
        }
        gi = gi + 1
      }
      let mut pi = guard_pins.length() - 1
      while pi >= 0 {
        ctx.pinned.push(guard_pins[pi])
        pi = pi - 1
      }
      ctx.moved = m_true
      ctx.diverged = d_true
    }
    SWhile(cond, body, _) =>
      v_loop_body(ctx, true, fn(pass : Int) -> Unit {
        let pin_base = ctx.pinned.length()
        v_push(ctx)
        let (m_false, d_false) = v_cond(ctx, cond, true)
        let top = ctx.loop_exit_moved.length() - 1
        if !d_false {
          v_union_into(ctx.loop_exit_moved[top], m_false)
        }
        if pass < 2 {
          v_stmts(ctx, body, false)
        }
        v_pop(ctx)
        v_unpin_to(ctx, pin_base)
      })
    SFor(init_s, cond, step_s, body, _) => {
      v_push(ctx)
      v_stmt(ctx, init_s, false)
      v_loop_body(ctx, true, fn(pass : Int) -> Unit {
        let pin_base = ctx.pinned.length()
        v_push(ctx)
        let (m_false, d_false) = v_cond(ctx, cond, false)
        v_pop(ctx)
        v_unpin_to(ctx, pin_base)
        let top = ctx.loop_exit_moved.length() - 1
        if !d_false {
          v_union_into(ctx.loop_exit_moved[top], m_false)
        }
        if pass < 2 {
          v_push(ctx)
          v_stmts(ctx, body, false)
          v_pop(ctx)
          let had_cont = ctx.loop_had_cont[top]
          if !ctx.diverged || had_cont {
            let pre_step = if !ctx.diverged && had_cont {
              let u = v_copy_moved(ctx.moved)
              v_union_into(u, ctx.loop_cont_moved[top])
              u
            } else if had_cont {
              v_copy_moved(ctx.loop_cont_moved[top])
            } else {
              ctx.moved
            }
            ctx.moved = pre_step
            ctx.loop_cont_moved[top] = vm_new()
            ctx.loop_had_cont[top] = false
            ctx.diverged = false
            v_stmt(ctx, step_s, false)
          }
        }
      })
      v_pop(ctx)
    }
    SForRange(vname, start_e, end_e, _, body, _) => {
      v_expr(ctx, start_e, false)
      v_expr(ctx, end_e, false)
      v_loop_body(ctx, false, fn(_pass : Int) -> Unit {
        v_push(ctx)
        v_define(ctx, vname, TInt, vk_local, false)
        v_stmts(ctx, body, false)
        v_pop(ctx)
      })
    }
    SForIn(idx_name, vname, iter_e, body, _) => {
      let iter_root = v_place_root(iter_e)
      if iter_root == "" {
        v_expr(ctx, iter_e, v_is_unique(ctx, v_expr_ty(ctx, iter_e)))
      } else {
        v_expr(ctx, iter_e, false)
      }
      let elem = match v_expr_ty(ctx, iter_e) {
        TArray(el) | TFixedArray(el) | TImmArray(el) => el
        _ => TError
      }
      let iter_id = if iter_root != "" {
        match v_lookup(ctx, iter_root) {
          Some(b) => b.id
          None => -1
        }
      } else {
        -1
      }
      v_loop_body(ctx, false, fn(_pass : Int) -> Unit {
        let pin_base = ctx.pinned.length()
        if iter_id >= 0 {
          ctx.pinned.push(iter_id)
        }
        v_push(ctx)
        if idx_name != "" {
          v_define(ctx, idx_name, TInt, vk_local, false)
        }
        let k = if v_is_unique(ctx, elem) { vk_borrowed } else { vk_local }
        v_define(ctx, vname, elem, k, false)
        v_stmts(ctx, body, false)
        v_pop(ctx)
        v_unpin_to(ctx, pin_base)
      })
    }
    SReturn(opt, _) => {
      match opt {
        Some(e) => v_expr(ctx, e, true)
        None => ()
      }
      ctx.diverged = true
    }
    SBreak(_) => {
      if !ctx.diverged && ctx.loop_break_moved.length() > 0 {
        v_union_into(ctx.loop_break_moved[ctx.loop_break_moved.length() - 1], ctx.moved)
      }
      ctx.diverged = true
    }
    SContinue(_) => {
      if !ctx.diverged && ctx.loop_cont_moved.length() > 0 {
        let top = ctx.loop_cont_moved.length() - 1
        v_union_into(ctx.loop_cont_moved[top], ctx.moved)
        ctx.loop_had_cont[top] = true
      }
      ctx.diverged = true
    }
    SDebugAssert(c, m, _) => {
      v_expr(ctx, c, false)
      v_expr(ctx, m, false)
    }
    SExpr(e, _) => v_expr(ctx, e, consume)
  }
}

///|
/// Entry point: run the `#verify` rules over one checked function body.
pub fn verify_check_fn(
  tc : TypeChecker,
  fd : FnDecl,
  finfo : FnInfo,
  fn_name : String,
  fn_key : String,
) -> Unit {
  let ctx = VCtx::{
    tc: tc,
    fn_name: fn_name,
    fn_key: fn_key,
    scopes: [Map([])],
    next_bind_id: 0,
    moved: vm_new(),
    diverged: false,
    loop_cont_moved: [],
    loop_had_cont: [],
    loop_break_moved: [],
    loop_exit_moved: [],
    reported: Map([]),
    forbidden_seen: Map([]),
    pinned: [],
  }
  let mut i = 0
  while i < fd.params.length() && i < finfo.param_tys.length() {
    let pt = finfo.param_tys[i]
    v_check_forbidden(ctx, pt, fd.params[i].span)
    let kind = if fd.params[i].is_mut {
      vk_mut_param
    } else if v_is_unique(ctx, pt) {
      vk_borrowed
    } else {
      vk_plain
    }
    v_define(ctx, fd.params[i].name, pt, kind, fd.params[i].is_mut)
    i = i + 1
  }
  v_check_forbidden(ctx, finfo.ret_ty, fd.span)
  let consume_tail = match finfo.ret_ty {
    TUnit => false
    _ => true
  }
  v_stmts(ctx, fd.body, consume_tail)
}
