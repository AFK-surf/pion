          let vka = qbe_emit_vmap_key_args(g, args[0], kty, args_pure)
          let va = qbe_emit_arg_maybe_borrow_ext(
            g,
            args[1],
            Some(vty),
            args_pure,
            args_pure && qbe_loop_has_no_calls_expr(g, args[1]),
          )
          let vv = va.qv
          let vc = qbe_coerce_val(g, vv, vty)
