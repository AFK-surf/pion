        qbe_emit(g, fcmp + " =w csltl " + fi + ", " + blen)
        qbe_emit_term(g, "jnz " + fcmp + ", " + l_fbody + ", " + l_fdone)
        qbe_emit_lbl(g, l_fbody)
        let fsp = qbe_tmp(g)
        let fbw = qbe_tmp(g)
