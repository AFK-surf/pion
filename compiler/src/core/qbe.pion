          qbe_emit_term(g, "jnz " + has_pos + ", " + l_do + ", " + l_end)
          qbe_emit_lbl(g, l_do)
          let vw = qbe_tmp(g)
          qbe_emit(g, vw + " =w copy " + vl)
          qbe_emit(g, "call $memset(l " + dp + ", w " + vw + ", l " + alen + ")")
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
