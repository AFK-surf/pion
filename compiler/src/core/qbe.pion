///|
fn qval(reg : String, ty : Ty) -> QbeVal {
  QbeVal::{ reg: reg, ty: ty }
}

///|
/// Normalize a package name for `g.mono_pkg`: both `""` and the current root
/// package's own `g.tc.pkg_name` normalize to `""` (root package).
fn qbe_norm_mono_pkg(g : QbeGen, pkg : String) -> String {
  if pkg == "" || (g.tc.pkg_name != "" && pkg == g.tc.pkg_name) {
    ""
  } else {
    pkg
  }
}

///|
fn qbe_tc_has_errors(tc : TypeChecker) -> Bool {
  let mut i = 0
  while i < tc.diagnostics.length() {
    if !starts_with_str(tc.diagnostics[i].code, "W_") {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Fail-closed helper for real emission endpoints that cannot resolve a binding.
/// Preserves error recovery when the frontend already reported errors; panics
/// with an ICE when type-checking succeeded (zero frontend errors).
fn qbe_fail_unresolved(
  g : QbeGen,
  kind : String,
  qual : String,
  mem : String,
  sp : Span,
) -> QbeVal {
  if qbe_tc_has_errors(g.tc) {
    return qval("0", TError)
  }
  let cur_pkg = if g.mono_pkg != "" { g.mono_pkg } else { g.tc.pkg_name }
  panic(
    "ICE: unresolved " +
    kind +
    " qual=" +
    qual +
    " mem=" +
    mem +
    " decl_pkg=" +
    g.mono_pkg +
    " cur_pkg=" +
    cur_pkg +
    " at " +
    span_key(sp),
  )
}

///|
fn qbe_enum_info_is_unit_only(einfo : EnumInfo) -> Bool {
  if einfo.decl.type_params.length() != 0 || einfo.decl.variants.length() == 0 {
    return false
  }
  let mut vi = 0
  while vi < einfo.decl.variants.length() {
    if einfo.decl.variants[vi].fields.length() > 0 {
      return false
    }
    vi = vi + 1
  }
  true
}

///|
fn qbe_is_unboxed_unit_enum(g : QbeGen, raw_ty : Ty) -> Bool {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TEnum(ename, eargs) =>
      if eargs.length() != 0 {
        false
      } else {
        match qbe_lookup_enum_info(g, ename) {
          Some(einfo) => qbe_enum_info_is_unit_only(einfo)
          None => false
        }
      }
    _ => false
  }
}

///|
fn qbe_is_niche_enum_decl(einfo : EnumInfo) -> Bool {
  if einfo.decl.variants.length() != 2 {
    return false
  }
  let n0 = einfo.decl.variants[0].fields.length()
  let n1 = einfo.decl.variants[1].fields.length()
  (n0 == 0 && n1 > 0) || (n1 == 0 && n0 > 0)
}

///|
fn qbe_enum_layout_for_info(einfo : EnumInfo) -> QbeEnumLayout {
  if qbe_enum_info_is_unit_only(einfo) {
    return QbeEnumLayout::{
      is_unit_only: true,
      is_niche: false,
      null_tag: -1,
      payload_tag: -1,
      payload_offset: 0,
      payload_slot_base: 0,
      total_size: 0,
    }
  }
  if qbe_is_niche_enum_decl(einfo) {
    let null_tag = if einfo.decl.variants[0].fields.length() == 0 { 0 } else { 1 }
    let payload_tag = 1 - null_tag
    let nfields = einfo.decl.variants[payload_tag].fields.length()
    return QbeEnumLayout::{
      is_unit_only: false,
      is_niche: true,
      null_tag: null_tag,
      payload_tag: payload_tag,
      payload_offset: 0,
      payload_slot_base: 0,
      total_size: nfields * 8,
    }
  }
  let mut max_fields = 0
  let mut vi = 0
  while vi < einfo.decl.variants.length() {
    let nf = einfo.decl.variants[vi].fields.length()
    if nf > max_fields {
      max_fields = nf
    }
    vi = vi + 1
  }
  QbeEnumLayout::{
    is_unit_only: false,
    is_niche: false,
    null_tag: -1,
    payload_tag: -1,
    payload_offset: 8,
    payload_slot_base: 1,
    total_size: (1 + max_fields) * 8,
  }
}

///|
fn qbe_enum_layout(g : QbeGen, raw_ty : Ty) -> QbeEnumLayout {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TEnum(ename, _) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => qbe_enum_layout_for_info(einfo)
        None =>
          QbeEnumLayout::{
            is_unit_only: false,
            is_niche: false,
            null_tag: -1,
            payload_tag: -1,
            payload_offset: 8,
            payload_slot_base: 1,
            total_size: 8,
          }
      }
    _ =>
      QbeEnumLayout::{
        is_unit_only: false,
        is_niche: false,
        null_tag: -1,
        payload_tag: -1,
        payload_offset: 8,
        payload_slot_base: 1,
        total_size: 8,
      }
  }
}

///|
fn qbe_is_niche_enum(g : QbeGen, raw_ty : Ty) -> Bool {
  qbe_enum_layout(g, raw_ty).is_niche
}

///|
fn qbe_is_hashable_scalar_ty(g : QbeGen, raw_ty : Ty) -> Bool {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  is_hashable_scalar_ty(ty) || qbe_is_unboxed_unit_enum(g, ty)
}

///|
fn qbe_is_obj_ty(g : QbeGen, raw_t : Ty) -> Bool {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TUnit | TPtr | TNever | TError =>
      false
    TParam(_) => false
    TEnum(_, _) => !qbe_is_unboxed_unit_enum(g, t)
    TOption(inner) => !qbe_is_unboxed_unit_enum(g, inner)
    _ => true
  }
}

///|
/// Heap-reference inner types that are guaranteed non-null pointers, so
/// `Option[T]` uses null-niche representation (`None = 0`, `Some(p) = p`) with
/// zero heap boxing. Excludes `TOption`, `TResult`, primitives, `TPtr`, `TUnit`,
/// `TParam`, closures, and null-niche `TEnum` (whose unit variant is itself `0`).
fn qbe_is_niche_opt_inner(g : QbeGen, raw_t : Ty) -> Bool {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TString
    | TArray(_)
    | TFixedArray(_)
    | TImmArray(_)
    | TMap(_, _)
    | TStruct(_, _)
    | TBytes
    | TStrView
    | TBytesView
    | TStringBuilder
    | TChannel(_)
    | TMutex(_)
    | TAtomicInt
    | TTuple(_)
    | TDynTrait(_) => true
    TEnum(_, _) => !qbe_is_niche_enum(g, t)
    _ => false
  }
}

///|
fn qbe_is_double_ty(t : Ty) -> Bool {
  match t {
    TDouble => true
    _ => false
  }
}

///|
fn qbe_is_float_ty(t : Ty) -> Bool {
  match t {
    TFloat => true
    _ => false
  }
}

///|
fn qbe_is_int32_ty(t : Ty) -> Bool {
  match t {
    TInt => true
    _ => false
  }
}

///|
fn qbe_is_uint32_ty(t : Ty) -> Bool {
  match t {
    TUInt => true
    _ => false
  }
}

///|
fn qbe_is_prim_array_elem(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TPtr => true
    _ => false
  }
}

///|
fn qbe_is_u8_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TBool | TByte | TInt8 => true
    _ => false
  }
}

///|
fn qbe_is_i8_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TInt8 => true
    _ => false
  }
}

///|
fn qbe_is_f32_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TFloat => true
    _ => false
  }
}

///|
fn qbe_is_i32_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TInt => true
    _ => false
  }
}

///|
fn qbe_is_u32_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TUInt | TChar => true
    _ => false
  }
}

///|
fn qbe_is_4b_int_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TInt | TUInt | TChar => true
    _ => false
  }
}

///|
fn qbe_is_4b_array_elem(g : QbeGen, raw_t : Ty) -> Bool {
  match subst_ty(raw_t, g.cur_type_subst) {
    TFloat | TInt | TUInt | TChar => true
    _ => false
  }
}

///|
/// Return the QBE bounds-check trap label prefix encoding the proven element
/// byte width for `Array`/`FixedArray` (`arr_oob_w1`/`arr_oob_w4`/`arr_oob_w8`),
/// preserving the `arr_oob` substring for existing SSA audits, or bare `arr_oob`
/// for flat POD / generic / unknown element widths.
fn qbe_arr_oob_lbl_prefix(g : QbeGen, elem : Ty) -> String {
  if qbe_flat_pod_stride(g, elem) > 0 {
    return "arr_oob"
  }
  match subst_ty(elem, g.cur_type_subst) {
    TParam(_) => "arr_oob"
    _ =>
      if qbe_is_u8_array_elem(g, elem) {
        "arr_oob_w1"
      } else if qbe_is_4b_array_elem(g, elem) {
        "arr_oob_w4"
      } else {
        "arr_oob_w8"
      }
  }
}

///|
fn qbe_extsb_l(g : QbeGen, reg_l : String) -> String {
  let w = qbe_tmp(g)
  let r = qbe_tmp(g)
  qbe_emit(g, w + " =w copy " + reg_l)
  qbe_emit(g, r + " =l extsb " + w)
  r
}

///|
fn qbe_extub_l(g : QbeGen, reg_l : String) -> String {
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l and " + reg_l + ", 255")
  r
}

///|
fn qbe_arr_new_flags_w(g : QbeGen, raw_t : Ty) -> String {
  if qbe_is_u8_array_elem(g, raw_t) {
    "2"
  } else if qbe_is_4b_array_elem(g, raw_t) {
    "4"
  } else {
    let fl = qbe_flat_struct_flags(g, raw_t)
    if fl > 0 {
      fl.to_string()
    } else {
      qbe_is_obj_flag_w(g, raw_t)
    }
  }
}

///|
fn qbe_emit_arr_ep(g : QbeGen, dp : String, idx_l : String, is_u8 : Bool) -> String {
  let ep = qbe_tmp(g)
  if is_u8 {
    qbe_emit(g, ep + " =l add " + dp + ", " + idx_l)
  } else {
    let off = qbe_tmp(g)
    qbe_emit(g, off + " =l shl " + idx_l + ", 3")
    qbe_emit(g, ep + " =l add " + dp + ", " + off)
  }
  ep
}

///|
fn qbe_emit_arr_ep_ty(g : QbeGen, dp : String, idx_l : String, elem : Ty) -> String {
  let ep = qbe_tmp(g)
  if qbe_is_u8_array_elem(g, elem) {
    qbe_emit(g, ep + " =l add " + dp + ", " + idx_l)
  } else if qbe_is_4b_array_elem(g, elem) {
    let off = qbe_tmp(g)
    qbe_emit(g, off + " =l shl " + idx_l + ", 2")
    qbe_emit(g, ep + " =l add " + dp + ", " + off)
  } else {
    let off = qbe_tmp(g)
    qbe_emit(g, off + " =l shl " + idx_l + ", 3")
    qbe_emit(g, ep + " =l add " + dp + ", " + off)
  }
  ep
}

///|
fn qbe_load_arr_u8(g : QbeGen, ep : String) -> String {
  let bw = qbe_tmp(g)
  let bl = qbe_tmp(g)
  qbe_emit(g, bw + " =w loadub " + ep)
  qbe_emit(g, bl + " =l extuw " + bw)
  bl
}

///|
fn qbe_load_arr_1b(g : QbeGen, ep : String, elem : Ty) -> String {
  if qbe_is_i8_array_elem(g, elem) {
    let bw = qbe_tmp(g)
    let bl = qbe_tmp(g)
    qbe_emit(g, bw + " =w loadsb " + ep)
    qbe_emit(g, bl + " =l extsw " + bw)
    bl
  } else {
    qbe_load_arr_u8(g, ep)
  }
}

///|
fn qbe_load_arr_f32_l(g : QbeGen, ep : String) -> String {
  let fw = qbe_tmp(g)
  let fl = qbe_tmp(g)
  qbe_emit(g, fw + " =w loaduw " + ep)
  qbe_emit(g, fl + " =l extuw " + fw)
  fl
}

///|
fn qbe_load_arr_f32_s(g : QbeGen, ep : String) -> String {
  let fv = qbe_tmp(g)
  qbe_emit(g, fv + " =s loads " + ep)
  fv
}

///|
fn qbe_store_arr_u8(g : QbeGen, val_reg : String, ep : String) -> Unit {
  let vw = qbe_tmp(g)
  qbe_emit(g, vw + " =w copy " + val_reg)
  qbe_emit(g, "storeb " + vw + ", " + ep)
}

///|
fn qbe_store_arr_f32_l(g : QbeGen, val_l : String, ep : String) -> Unit {
  let vw = qbe_tmp(g)
  qbe_emit(g, vw + " =w copy " + val_l)
  qbe_emit(g, "storew " + vw + ", " + ep)
}

///|
fn qbe_store_arr_f32_s(g : QbeGen, val_s : String, ep : String) -> Unit {
  qbe_emit(g, "stores " + val_s + ", " + ep)
}

///|
fn qbe_load_arr_4b_l(g : QbeGen, ep : String, elem : Ty) -> String {
  if qbe_is_i32_array_elem(g, elem) {
    let iw = qbe_tmp(g)
    let il = qbe_tmp(g)
    qbe_emit(g, iw + " =w loadsw " + ep)
    qbe_emit(g, il + " =l extsw " + iw)
    il
  } else {
    qbe_load_arr_f32_l(g, ep)
  }
}

///|
fn qbe_store_arr_4b_l(g : QbeGen, val_l : String, ep : String) -> Unit {
  qbe_store_arr_f32_l(g, val_l, ep)
}

///|
fn qbe_load_arr_elem(g : QbeGen, ep : String, elem : Ty) -> String {
  if qbe_is_u8_array_elem(g, elem) {
    qbe_load_arr_1b(g, ep, elem)
  } else if qbe_is_f32_array_elem(g, elem) {
    qbe_load_arr_f32_s(g, ep)
  } else if qbe_is_i32_array_elem(g, elem) {
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w loadsw " + ep)
    rw
  } else if qbe_is_u32_array_elem(g, elem) {
    let st = subst_ty(elem, g.cur_type_subst)
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w loaduw " + ep)
    match st {
      TChar => {
        let rl = qbe_tmp(g)
        qbe_emit(g, rl + " =l extuw " + rw)
        rl
      }
      _ => rw
    }
  } else {
    qbe_load_heap_slot(g, ep, elem)
  }
}

///|
fn qbe_store_arr_elem(g : QbeGen, val_reg : String, ep : String, elem : Ty) -> Unit {
  if qbe_is_u8_array_elem(g, elem) {
    qbe_store_arr_u8(g, val_reg, ep)
  } else if qbe_is_f32_array_elem(g, elem) {
    qbe_store_arr_f32_s(g, val_reg, ep)
  } else if qbe_is_4b_int_array_elem(g, elem) {
    let st = subst_ty(elem, g.cur_type_subst)
    match st {
      TChar =>
        if qbe_is_temp_reg(val_reg) {
          let vw = qbe_tmp(g)
          qbe_emit(g, vw + " =w copy " + val_reg)
          qbe_emit(g, "storew " + vw + ", " + ep)
        } else {
          qbe_emit(g, "storew " + val_reg + ", " + ep)
        }
      _ => qbe_emit(g, "storew " + val_reg + ", " + ep)
    }
  } else {
    qbe_store_heap_slot(g, val_reg, ep, elem)
  }
}

///|
fn qbe_c_abi_ty(t : Ty) -> String {
  match t {
    TDouble => "d"
    TFloat => "s"
    TInt | TUInt | TBool | TByte | TInt8 | TChar => "w"
    _ => "l"
  }
}

///|
fn qbe_mangle_escape(s : String) -> String {
  let clean = qbe_mangle_qual_sym(s)
  "0L" + clean.length().to_string() + "_" + clean
}

///|
fn qbe_mangle_ty(t : Ty) -> String {
  match t {
    TInt => "Int"
    TInt64 => "Int64"
    TUInt => "UInt"
    TUInt64 => "UInt64"
    TDouble => "Double"
    TFloat => "Float"
    TBool => "Bool"
    TByte => "Byte"
    TInt8 => "Int8"
    TChar => "Char"
    TString => "String"
    TUnit => "Unit"
    TPtr => "Ptr"
    TArray(e) => "Array_" + qbe_mangle_ty(e)
    TFixedArray(e) => "FixedArray_" + qbe_mangle_ty(e)
    TImmArray(e) => "ImmArray_" + qbe_mangle_ty(e)
    TOption(e) => "Option_" + qbe_mangle_ty(e)
    TResult(ok, err) => "Result_" + qbe_mangle_ty(ok) + "_" + qbe_mangle_ty(err)
    TMap(k, v) => "Map_" + qbe_mangle_ty(k) + "_" + qbe_mangle_ty(v)
    TStruct(n, args) =>
      if args.length() == 0 {
        qbe_mangle_escape(n)
      } else {
        let sb = StringBuilder()
        sb.write_string(qbe_mangle_escape(n))
        sb.write_string("_ZA")
        let mut i = 0
        while i < args.length() {
          if i > 0 {
            sb.write_string("_ZS")
          }
          sb.write_string(qbe_mangle_ty(args[i]))
          i = i + 1
        }
        sb.write_string("_ZE")
        sb.to_string()
      }
    TEnum(n, args) =>
      if args.length() == 0 {
        qbe_mangle_escape(n)
      } else {
        let sb = StringBuilder()
        sb.write_string(qbe_mangle_escape(n))
        sb.write_string("_ZA")
        let mut i = 0
        while i < args.length() {
          if i > 0 {
            sb.write_string("_ZS")
          }
          sb.write_string(qbe_mangle_ty(args[i]))
          i = i + 1
        }
        sb.write_string("_ZE")
        sb.to_string()
      }
    TDynTrait(n) => "dyn_" + qbe_mangle_escape(n)
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("_ZT")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string("_ZS")
        }
        sb.write_string(qbe_mangle_ty(elems[i]))
        i = i + 1
      }
      sb.write_string("_ZE")
      sb.to_string()
    }
    TFn(params, ret) => {
      let sb = StringBuilder()
      sb.write_string("_ZF")
      let mut i = 0
      while i < params.length() {
        if i > 0 {
          sb.write_string("_ZS")
        }
        sb.write_string(qbe_mangle_ty(params[i]))
        i = i + 1
      }
      sb.write_string("_ZR")
      sb.write_string(qbe_mangle_ty(ret))
      sb.write_string("_ZE")
      sb.to_string()
    }
    _ => qbe_mangle_escape(ty_to_string(t))
  }
}

///|
fn qbe_mono_fn_sym(
  base_sym : String,
  tparams : Array[String],
  subst : Map[String, Ty],
) -> String {
  let sb = StringBuilder()
  sb.write_string(base_sym)
  sb.write_string("__mono")
  let mut i = 0
  while i < tparams.length() {
    sb.write_string("_")
    let t = match subst.get(tparams[i]) {
      Some(ty) => ty
      None => TError
    }
    sb.write_string(qbe_mangle_ty(t))
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_ident_is_alnum(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_strip_impl_pkg(impl_pkg : String, name : String) -> String {
  if impl_pkg.length() > 0 {
    let qp = split_qual_name(name)
    if qp.prefix == impl_pkg {
      return qp.name
    }
  }
  name
}

///|
fn qbe_impl_method_sym(
  g : QbeGen,
  impl_pkg : String,
  trait_name : String,
  target_type : String,
  method_name : String,
) -> String {
  let prefix = if g.tc.multi_pkg {
    qbe_pkg_prefix_for(impl_pkg, true)
  } else {
    ""
  }
  // Strip only `impl_pkg::` so local definitions and importers agree, while preserving
  // foreign package qualifiers (e.g. `left::A` vs `right::A` implemented in `app`).
  let tr = qbe_strip_impl_pkg(impl_pkg, canon_trait_name(g.tc, trait_name))
  let ty = qbe_strip_impl_pkg(impl_pkg, target_type)
  if tr == "@builtin:Eq" {
    return "$pion_" + prefix + "builtin_eq_" + qbe_mangle_qual_sym(ty)
  }
  if qbe_ident_is_alnum(tr) &&
    str_code_at(tr, 0) != 48 &&
    qbe_ident_is_alnum(ty) &&
    qbe_ident_is_plain_us(method_name) {
    "$pion_" + prefix + "impl_" + tr + "_" + ty + "_" + method_name
  } else {
    "$pion_" +
    prefix +
    "impl_0_" +
    qbe_mangle_pair(tr, ty) +
    qbe_mangle_member_suffix(method_name)
  }
}

///|
fn qbe_last_qual_seg(s : String) -> String {
  let mut rest = s
  let mut qp = split_qual_name(rest)
  while qp.prefix.length() > 0 {
    rest = qp.name
    qp = split_qual_name(rest)
  }
  rest
}

///|
fn qbe_local_unqual_target(g : QbeGen, name : String) -> String {
  let qp = split_qual_name(name)
  if qp.prefix != "" && g.tc.pkg_name != "" && qp.prefix == g.tc.pkg_name {
    qp.name
  } else {
    name
  }
}

///|
fn qbe_find_impl_method(
  g : QbeGen,
  recv_ty : Ty,
  method_name : String,
  expected_trait : Option[String],
) -> Option[QbeImplMethodMatch] {
  let tname = qbe_local_unqual_target(g, ty_base_name(recv_ty))
  let mut i = 0
  while i < g.tc.impl_keys.length() {
    let k = g.tc.impl_keys[i]
    match g.tc.impls.get(k) {
      Some(ii) => {
        let trait_ok = match expected_trait {
          Some(et) => canon_trait_name(g.tc, ii.trait_name) == et
          None => ii.trait_name != "@builtin:Eq"
        }
        if ii.target_type == tname && trait_ok {
          match ii.methods.get(method_name) {
            Some(fi) =>
              return Some(QbeImplMethodMatch::{
                sym: qbe_impl_method_sym(
                  g,
                  ii.pkg_name,
                  ii.trait_name,
                  ii.target_type,
                  method_name,
                ),
                finfo: fi,
                pkg_name: ii.pkg_name,
              })
            None => ()
          }
        }
      }
      None => ()
    }
    i = i + 1
  }
  None
}

///|
fn qbe_lookup_builtin_eq_impl(g : QbeGen, raw_ty : Ty) -> Option[ImplInfo] {
  let rty = subst_ty(raw_ty, g.cur_type_subst)
  let name = match rty {
    TStruct(n, _) | TEnum(n, _) => n
    _ => return None
  }
  match tc_lookup_builtin_eq_impl(g.tc, name) {
    Some(ii) => return Some(ii)
    None => ()
  }
  if g.mono_pkg != "" && !has_qual_sep(name) {
    match tc_lookup_builtin_eq_impl(g.tc, g.mono_pkg + "::" + name) {
      Some(ii) => return Some(ii)
      None => ()
    }
  }
  None
}

///|
fn qbe_resolve_type(g : QbeGen, te : TypeExpr) -> Ty {
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        qualify_imported_ty(
          ipkg.name,
          resolve_type_expr(ipkg.tc, te, g.cur_tparams),
        )
      None => resolve_type_expr(g.tc, te, g.cur_tparams)
    }
  } else {
    resolve_type_expr(g.tc, te, g.cur_tparams)
  }
  subst_ty(raw, g.lexical_type_subst)
}

///|
/// Type the checker inferred for an unannotated empty collection `let`
/// (`let out = []` + `out.push(..)`), mirroring `qbe_resolve_type`'s package
/// and type-parameter handling.
fn qbe_let_infer(g : QbeGen, sp : Span) -> Option[Ty] {
  let key = span_key(sp)
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.let_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.let_infer.get(key)
    }
  } else {
    g.tc.let_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.lexical_type_subst))
    None => None
  }
}

///|
/// Operand type hint for `==`/`!=` and `physical_equal` when the LHS is
/// under-specified (`None`, `[]`, `Ok(...)`, `(None, 1)`, etc.): prefers the
/// checker-recorded `#eq_op` type (supporting cross-package monomorphization
/// via `qbe_call_infer`) and falls back to `qbe_probe_expr_ty(g, rhs)`.
fn qbe_eq_op_hint(g : QbeGen, sp : Span, rhs : Expr) -> Option[Ty] {
  match qbe_call_infer(g, sp, "#eq_op") {
    Some(t0) => {
      let t = subst_ty(t0, g.cur_type_subst)
      if !ty_has_unresolved(t) && !qbe_ty_has_error(t) && !qbe_ty_has_param(t) {
        return Some(t)
      }
    }
    None => ()
  }
  qbe_probe_expr_ty(g, rhs)
}

///|
/// Type the checker recorded for the call at `sp` under `tag` (`#map`: type of a
/// `Map(...)` construction, `#targs:<fn>`: type arguments of a generic call with
/// named / default arguments).
fn qbe_call_infer(g : QbeGen, sp : Span, tag : String) -> Option[Ty] {
  let key = span_key(sp) + tag
  let raw = if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.let_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.let_infer.get(key)
    }
  } else {
    g.tc.let_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.lexical_type_subst))
    None => None
  }
}


///|
/// Type the checker inferred for the RHS shift count of `EBinary("<<" | ">>")`.
fn qbe_shift_rhs_infer(g : QbeGen, sp : Span) -> Option[Ty] {
  let key = span_key(sp)
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.shift_rhs_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.shift_rhs_infer.get(key)
    }
  } else {
    g.tc.shift_rhs_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.lexical_type_subst))
    None => None
  }
}


///|
/// Fallback shift-count type hint when `g.tc.shift_rhs_infer` has no entry
/// (e.g. `emit_qbe_package(pkg, true)` invoked without a populated TypeChecker).
fn qbe_shift_rhs_ty_hint(g : QbeGen, e : Expr) -> Option[Ty] {
  match e {
    EInt(_, _) => None
    EInt64(_, _) => Some(TInt64)
    EUInt(_, _) => Some(TUInt)
    EUInt64(_, _) => Some(TUInt64)
    EByte(_, _) => Some(TByte)
    EIdent(v, _) =>
      match qbe_lookup_local(g, v) {
        Some(loc) => Some(loc.ty)
        None =>
          if g.mono_pkg != "" {
            match g.tc.imported_pkgs.get(g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.consts.get(v) {
                  Some(t) => Some(subst_ty(qualify_imported_ty(ipkg.name, t), g.cur_type_subst))
                  None => None
                }
              None => g.tc.consts.get(v)
            }
          } else {
            g.tc.consts.get(v)
          }
      }
    EUnary(_, x, _) => qbe_shift_rhs_ty_hint(g, x)
    EAs(_, ty_e, _) => Some(qbe_resolve_type(g, ty_e))
    ECall(EIdent(fnm, _), _, _) =>
      match qbe_lookup_local(g, fnm) {
        Some(loc) =>
          match loc.ty {
            TFn(_, rty) => Some(subst_ty(rty, g.cur_type_subst))
            _ => None
          }
        None => {
          let cur_tc = if g.mono_pkg != "" {
            match g.tc.imported_pkgs.get(g.mono_pkg) {
              Some(ipkg) => ipkg.tc
              None => g.tc
            }
          } else {
            g.tc
          }
          match cur_tc.fns.get(fnm) {
            Some(fi) =>
              if fi.decl.type_params.length() == 0 {
                let rt = if g.mono_pkg != "" {
                  qualify_imported_ty(g.mono_pkg, fi.ret_ty)
                } else {
                  fi.ret_ty
                }
                Some(subst_ty(rt, g.cur_type_subst))
              } else {
                None
              }
            None => None
          }
        }
      }
    EBinary(bop, l, r, _) =>
      if bop == "<<" || bop == ">>" {
        qbe_shift_rhs_ty_hint(g, l)
      } else {
        match qbe_shift_rhs_ty_hint(g, l) {
          Some(t) => Some(t)
          None => qbe_shift_rhs_ty_hint(g, r)
        }
      }
    _ => None
  }
}

///|
/// Type the checker inferred for a closure expression (including unannotated
/// parameter and return types from expected `TFn(...)` context).
fn qbe_closure_infer(g : QbeGen, sp : Span) -> Option[Ty] {
  let key = span_key(sp)
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.closure_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.closure_infer.get(key)
    }
  } else {
    g.tc.closure_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.lexical_type_subst))
    None => None
  }
}


///|
fn qbe_abi_ty(t : Ty) -> String {
  if qbe_is_double_ty(t) {
    "d"
  } else if qbe_is_float_ty(t) {
    "s"
  } else if qbe_is_int32_ty(t) || qbe_is_uint32_ty(t) {
    "w"
  } else {
    "l"
  }
}

///|
fn qbe_zero_reg(t : Ty) -> String {
  if qbe_is_double_ty(t) {
    "d_0.0"
  } else if qbe_is_float_ty(t) {
    "s_0.0"
  } else {
    "0"
  }
}

///|
fn qbe_is_temp_reg(reg : String) -> Bool {
  reg.length() > 0 && str_code_at(reg, 0) == 37
}

///|
fn qbe_as_l(g : QbeGen, v : QbeVal) -> String {
  if qbe_is_double_ty(v.ty) {
    let dreg = if qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let dt = qbe_tmp(g)
      qbe_emit(g, dt + " =d copy " + v.reg)
      dt
    }
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =l cast " + dreg)
    t
  } else if qbe_is_float_ty(v.ty) {
    let freg = if qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let ft = qbe_tmp(g)
      qbe_emit(g, ft + " =s copy " + v.reg)
      ft
    }
    let w = qbe_tmp(g)
    let t = qbe_tmp(g)
    qbe_emit(g, w + " =w cast " + freg)
    qbe_emit(g, t + " =l extuw " + w)
    t
  } else if qbe_is_uint32_ty(v.ty) {
    if !qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l extuw " + v.reg)
      t
    }
  } else if qbe_is_int32_ty(v.ty) {
    if !qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      match g.w_to_l_ext.get(v.reg) {
        Some(rl) => rl
        None => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l extsw " + v.reg)
          g.w_to_l_ext.set(v.reg, t)
          t
        }
      }
    }
  } else {
    v.reg
  }
}

///|
fn qbe_from_l(g : QbeGen, reg_l : String, ty : Ty) -> String {
  if qbe_is_double_ty(ty) {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =d cast " + reg_l)
    t
  } else if qbe_is_float_ty(ty) {
    let w = qbe_tmp(g)
    let t = qbe_tmp(g)
    qbe_emit(g, w + " =w copy " + reg_l)
    qbe_emit(g, t + " =s cast " + w)
    t
  } else if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w copy " + reg_l)
    t
  } else {
    match ty {
      TInt8 => qbe_extsb_l(g, reg_l)
      TByte => qbe_extub_l(g, reg_l)
      _ => reg_l
    }
  }
}

///|
fn qbe_is_untyped_option(t : Ty) -> Bool {
  match t {
    TOption(TError) => true
    _ => false
  }
}

///|
fn qbe_ty_has_untyped_option(t : Ty) -> Bool {
  match t {
    TOption(TError) => true
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_untyped_option(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_ty_has_niche_option(g : QbeGen, t : Ty) -> Bool {
  match t {
    TOption(oin) => qbe_is_niche_opt_inner(g, oin)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_niche_option(g, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_normalize_untyped_none(g : QbeGen, reg : String) -> String {
  g.need_none_const = true
  let slot = qbe_alloc_slot(g)
  let np = qbe_tmp(g)
  let is_n = qbe_tmp(g)
  let l_zero = qbe_lbl(g, "opt_zn")
  let l_keep = qbe_lbl(g, "opt_kn")
  let l_end = qbe_lbl(g, "opt_en")
  qbe_emit(g, np + " =l add $pion_none_hdr, 24")
  qbe_emit(g, is_n + " =w ceql " + reg + ", " + np)
  qbe_emit_term(g, "jnz " + is_n + ", " + l_zero + ", " + l_keep)
  qbe_emit_lbl(g, l_zero)
  qbe_emit(g, "storel 0, " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_keep)
  qbe_emit(g, "storel " + reg + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_normalize_untyped_none_in_val(g : QbeGen, reg : String, ty : Ty) -> String {
  match ty {
    TOption(oin) =>
      if qbe_is_niche_opt_inner(g, oin) {
        qbe_normalize_untyped_none(g, reg)
      } else {
        reg
      }
    TTuple(elems) =>
      if !qbe_ty_has_niche_option(g, ty) {
        reg
      } else {
        let mut i = 0
        while i < elems.length() {
          if qbe_ty_has_niche_option(g, elems[i]) {
            let p = if i == 0 {
              reg
            } else {
              let tp = qbe_tmp(g)
              qbe_emit(g, tp + " =l add " + reg + ", " + (i * 8).to_string())
              tp
            }
            let cur = qbe_tmp(g)
            qbe_emit(g, cur + " =l loadl " + p)
            let norm = qbe_normalize_untyped_none_in_val(g, cur, elems[i])
            qbe_emit(g, "storel " + norm + ", " + p)
          }
          i = i + 1
        }
        reg
      }
    _ => reg
  }
}

///|
fn qbe_coerce_val(g : QbeGen, v : QbeVal, target_ty : Ty) -> String {
  if qbe_ty_has_untyped_option(v.ty) && qbe_ty_has_niche_option(g, target_ty) {
    return qbe_normalize_untyped_none_in_val(g, v.reg, target_ty)
  }
  let src_abi = qbe_abi_ty(v.ty)
  let dst_abi = qbe_abi_ty(target_ty)
  if src_abi == dst_abi {
    v.reg
  } else if src_abi == "d" && dst_abi == "l" {
    qbe_as_l(g, v)
  } else if src_abi == "l" && dst_abi == "d" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =d cast " + v.reg)
    t
  } else if src_abi == "s" && dst_abi == "l" {
    qbe_as_l(g, v)
  } else if src_abi == "l" && dst_abi == "s" {
    qbe_from_l(g, v.reg, TFloat)
  } else if src_abi == "s" && dst_abi == "w" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w cast " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "s" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =s cast " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "l" {
    let t = qbe_tmp(g)
    if qbe_is_uint32_ty(v.ty) {
      qbe_emit(g, t + " =l extuw " + v.reg)
    } else {
      qbe_emit(g, t + " =l extsw " + v.reg)
    }
    t
  } else if src_abi == "l" && dst_abi == "w" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w copy " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "d" {
    let lreg = qbe_tmp(g)
    let dreg = qbe_tmp(g)
    if qbe_is_uint32_ty(v.ty) {
      qbe_emit(g, lreg + " =l extuw " + v.reg)
    } else {
      qbe_emit(g, lreg + " =l extsw " + v.reg)
    }
    qbe_emit(g, dreg + " =d cast " + lreg)
    dreg
  } else if src_abi == "s" && dst_abi == "d" {
    let dreg = qbe_tmp(g)
    qbe_emit(g, dreg + " =d exts " + v.reg)
    dreg
  } else if src_abi == "d" && dst_abi == "s" {
    let freg = qbe_tmp(g)
    qbe_emit(g, freg + " =s truncd " + v.reg)
    freg
  } else {
    let lreg = qbe_tmp(g)
    let wreg = qbe_tmp(g)
    qbe_emit(g, lreg + " =l cast " + v.reg)
    qbe_emit(g, wreg + " =w copy " + lreg)
    wreg
  }
}

///|
fn qbe_store_local_slot(g : QbeGen, reg : String, slot : String, ty : Ty) -> Unit {
  if qbe_is_double_ty(ty) {
    qbe_emit(g, "stored " + reg + ", " + slot)
  } else if qbe_is_float_ty(ty) {
    qbe_emit(g, "stores " + reg + ", " + slot)
  } else if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    qbe_emit(g, "storew " + reg + ", " + slot)
  } else {
    qbe_emit(g, "storel " + reg + ", " + slot)
  }
}

///|
fn qbe_load_local_slot(g : QbeGen, slot : String, ty : Ty) -> String {
  let t = qbe_tmp(g)
  if qbe_is_double_ty(ty) {
    qbe_emit(g, t + " =d loadd " + slot)
  } else if qbe_is_float_ty(ty) {
    qbe_emit(g, t + " =s loads " + slot)
  } else if qbe_is_int32_ty(ty) {
    qbe_emit(g, t + " =w loadsw " + slot)
  } else if qbe_is_uint32_ty(ty) {
    qbe_emit(g, t + " =w loaduw " + slot)
  } else {
    qbe_emit(g, t + " =l loadl " + slot)
    if g.immortal_slots.contains(slot) {
      g.immortal_regs.set(t, true)
    }
  }
  t
}

///|
fn qbe_store_heap_slot(g : QbeGen, reg : String, slot : String, ty : Ty) -> Unit {
  if qbe_is_double_ty(ty) {
    qbe_emit(g, "stored " + reg + ", " + slot)
  } else if qbe_is_float_ty(ty) {
    let lreg = qbe_as_l(g, qval(reg, TFloat))
    qbe_emit(g, "storel " + lreg + ", " + slot)
  } else if qbe_is_uint32_ty(ty) {
    if !qbe_is_temp_reg(reg) {
      qbe_emit(g, "storel " + reg + ", " + slot)
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l extuw " + reg)
      qbe_emit(g, "storel " + t + ", " + slot)
    }
  } else if qbe_is_int32_ty(ty) {
    if !qbe_is_temp_reg(reg) {
      qbe_emit(g, "storel " + reg + ", " + slot)
    } else {
      let rl = match g.w_to_l_ext.get(reg) {
        Some(existing) => existing
        None => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l extsw " + reg)
          g.w_to_l_ext.set(reg, t)
          t
        }
      }
      qbe_emit(g, "storel " + rl + ", " + slot)
    }
  } else {
    qbe_emit(g, "storel " + reg + ", " + slot)
  }
}

///|
fn qbe_load_heap_slot(g : QbeGen, slot : String, ty : Ty) -> String {
  let t = qbe_tmp(g)
  if qbe_is_double_ty(ty) {
    qbe_emit(g, t + " =d loadd " + slot)
  } else if qbe_is_float_ty(ty) {
    qbe_emit(g, t + " =s loads " + slot)
  } else if qbe_is_int32_ty(ty) {
    qbe_emit(g, t + " =w loadsw " + slot)
  } else if qbe_is_uint32_ty(ty) {
    qbe_emit(g, t + " =w loaduw " + slot)
  } else {
    qbe_emit(g, t + " =l loadl " + slot)
  }
  t
}

///|
fn qbe_sanitize_sym(s : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57) ||
      c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_mangle_pkg_sym(pkg_name : String) -> String {
  let mut plain = !pkg_name.starts_with("0_")
  let mut i = 0
  while plain && i < pkg_name.length() {
    let c = str_code_at(pkg_name, i)
    if !((c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57) ||
      c == 95) {
      plain = false
    }
    i = i + 1
  }
  if plain {
    pkg_name
  } else {
    "0_" + qbe_mangle_ident_rev(pkg_name)
  }
}

///|
fn qbe_ident_is_plain_us(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if !((c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57) ||
      c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_ident_is_clean_seg(s : String) -> Bool {
  if !qbe_ident_is_plain_us(s) || str_code_at(s, 0) == 48 {
    return false
  }
  let mut i = 0
  while i + 1 < s.length() {
    if str_code_at(s, i) == 95 && str_code_at(s, i + 1) == 95 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_mangle_member_suffix(mem : String) -> String {
  let rev = qbe_mangle_ident_rev(mem)
  "_M" + rev.length().to_string() + "_" + rev
}

///|
fn qbe_mangle_pair(a : String, b : String) -> String {
  if qbe_ident_is_clean_seg(a) &&
    str_code_at(a, a.length() - 1) != 95 &&
    qbe_ident_is_plain_us(b) &&
    str_code_at(b, 0) != 95 {
    a + "__" + b
  } else {
    let ea = qbe_mangle_ident_rev(a)
    let eb = qbe_mangle_ident_rev(b)
    "0P" + ea.length().to_string() + "_" + ea + "_N" + eb.length().to_string() + "_" + eb
  }
}

///|
fn qbe_mangle_qual_sym(s : String) -> String {
  let qp = split_qual_name(s)
  if qp.prefix.length() > 0 {
    qbe_mangle_pair(qp.prefix, qp.name)
  } else if qbe_ident_is_clean_seg(s) {
    s
  } else {
    "0U_" + qbe_mangle_ident_rev(s)
  }
}

///|
fn qbe_pkg_prefix_for(pkg_name : String, multi_pkg : Bool) -> String {
  if !multi_pkg {
    ""
  } else if qbe_ident_is_alnum(pkg_name) && str_code_at(pkg_name, 0) != 48 {
    "pkg_" + pkg_name + "_"
  } else {
    let rev = qbe_mangle_ident_rev(pkg_name)
    "pkg_0L" + rev.length().to_string() + "_" + rev + "_"
  }
}

///|
fn qbe_local_fn_sym(g : QbeGen, name : String) -> String {
  "$pion_" + g.pkg_prefix + "fn_" + name
}

///|
fn qbe_local_method_sym(g : QbeGen, recv : String, name : String) -> String {
  "$pion_" + g.pkg_prefix + "m_" + qbe_mangle_pair(recv, name)
}

///|
fn qbe_local_const_sym(g : QbeGen, name : String) -> String {
  "$pion_" + g.pkg_prefix + "const_" + name
}

///|
fn qbe_ext_fn_sym(canon_pkg : String, name : String) -> String {
  "$pion_" + qbe_pkg_prefix_for(canon_pkg, true) + "fn_" + name
}

///|
fn qbe_ext_method_sym(
  canon_pkg : String,
  recv : String,
  name : String,
) -> String {
  "$pion_" + qbe_pkg_prefix_for(canon_pkg, true) + "m_" + qbe_mangle_pair(recv, name)
}

///|
fn qbe_ext_const_sym(canon_pkg : String, name : String) -> String {
  "$pion_" + qbe_pkg_prefix_for(canon_pkg, true) + "const_" + name
}

///|
fn qbe_method_call_sym(
  g : QbeGen,
  sname : String,
  method_name : String,
) -> String {
  let qp = split_qual_name(sname)
  let canon_pkg = qp.prefix
  let st_name = qp.name
  if canon_pkg.length() > 0 {
    qbe_ext_method_sym(canon_pkg, st_name, method_name)
  } else if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.methods.contains(sname + "::" + method_name) {
          qbe_ext_method_sym(ipkg.name, sname, method_name)
        } else {
          qbe_local_method_sym(g, sname, method_name)
        }
      None => qbe_local_method_sym(g, sname, method_name)
    }
  } else {
    qbe_local_method_sym(g, sname, method_name)
  }
}

///|
/// `==` on an enum (the checker only admits payload-less ones) compares the
/// variant tags: each package emits its own static constant per variant, so
/// pointer identity would differ across packages.
fn qbe_cmp_operand(g : QbeGen, reg : String, ty : Ty) -> String {
  match ty {
    TEnum(_, _) => {
      let layout = qbe_enum_layout(g, ty)
      if layout.is_unit_only {
        reg
      } else if layout.is_niche {
        let nz = qbe_tmp(g)
        let t = qbe_tmp(g)
        qbe_emit(g, nz + " =w cnel " + reg + ", 0")
        qbe_emit(g, t + " =l extuw " + nz)
        t
      } else {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l loadl " + reg)
        t
      }
    }
    TInt | TUInt => qbe_as_l(g, qval(reg, ty))
    _ => reg
  }
}

///|
fn qbe_register_enum_const(
  g : QbeGen,
  enum_name : String,
  vname : String,
  tag : Int,
) -> String {
  let sym = "$pion_enum_u_" +
    qbe_mangle_qual_sym(enum_name) +
    qbe_mangle_member_suffix(vname) +
    "_hdr"
  if !g.enum_const_seen.contains(sym) {
    g.enum_const_seen.set(sym, true)
    g.enum_consts.push(QbeEnumConst::{
      sym: sym,
      tag: tag,
      has_payload: false,
      payload_val: 0,
      omit_tag: false,
    })
  }
  sym
}

///|
fn qbe_register_enum_bool_const(
  g : QbeGen,
  enum_name : String,
  vname : String,
  tag : Int,
  bval : Int,
  omit_tag : Bool,
) -> String {
  let sym = "$pion_enum_b_" +
    qbe_mangle_qual_sym(enum_name) +
    qbe_mangle_member_suffix(vname) +
    "_" +
    bval.to_string() +
    "_hdr"
  if !g.enum_const_seen.contains(sym) {
    g.enum_const_seen.set(sym, true)
    g.enum_consts.push(QbeEnumConst::{
      sym: sym,
      tag: tag,
      has_payload: true,
      payload_val: bval,
      omit_tag: omit_tag,
    })
  }
  sym
}

///|
struct QbeGenericNode {
  key : String
  finfo : FnInfo
  pkg : String
}

///|
struct QbeGenericScanAcc {
  mut local_eq : Bool
  mut local_arith : Bool
  edges : Array[QbeGenericNode]
  edge_seen : Map[String, Bool]
}

///|
fn qbe_generic_tc_for_pkg(g : QbeGen, norm_pkg : String) -> TypeChecker {
  if norm_pkg == "" {
    g.tc
  } else {
    match lookup_imported_pkg_transitive(g.tc, norm_pkg) {
      Some(ipkg) => ipkg.tc
      None => g.tc
    }
  }
}

///|
fn qbe_generic_decl_key(g : QbeGen, finfo : FnInfo, decl_pkg : String) -> String {
  let npkg = qbe_norm_mono_pkg(g, decl_pkg)
  "decl:" + npkg + "::" + finfo.decl.receiver_type + "::" + finfo.decl.name + "@" + span_key(finfo.decl.span)
}

///|
fn qbe_fn_has_eq_tparams_in(cur_tc : TypeChecker, fi : FnInfo) -> Bool {
  if cur_tc.eq_tparams.contains(span_key(fi.decl.span)) {
    return true
  }
  let mut bi = 0
  while bi < fi.decl.type_bounds.length() {
    let tb = fi.decl.type_bounds[bi]
    let mut ti = 0
    while ti < tb.traits.length() {
      if tb.traits[ti] == "@builtin:Eq" || canon_trait_name(cur_tc, tb.traits[ti]) == "@builtin:Eq" {
        return true
      }
      ti = ti + 1
    }
    bi = bi + 1
  }
  false
}

///|
fn qbe_fn_has_eq_tparams(g : QbeGen, fi : FnInfo) -> Bool {
  qbe_fn_has_eq_tparams_in(g.tc, fi)
}

///|
fn qbe_generic_meth_candidates(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  mname : String,
) -> Array[String] {
  if !g.generic_meth_indexed_pkgs.contains(norm_pkg) {
    g.generic_meth_indexed_pkgs.set(norm_pkg, true)
    let mut i = 0
    while i < cur_tc.method_names.length() {
      let mk = cur_tc.method_names[i]
      match cur_tc.methods.get(mk) {
        Some(mi) =>
          if mi.decl.type_params.length() > 0 {
            let mut mname_only = mk
            while has_qual_sep(mname_only) {
              mname_only = split_qual_name(mname_only).name
            }
            let idx_key = norm_pkg + "\n" + mname_only
            match g.generic_meth_index.get(idx_key) {
              Some(arr) => arr.push(mk)
              None => g.generic_meth_index.set(idx_key, [mk])
            }
          }
        None => ()
      }
      i = i + 1
    }
  }
  match g.generic_meth_index.get(norm_pkg + "\n" + mname) {
    Some(arr) => arr
    None => []
  }
}

///|
fn qbe_generic_resolve_pkg_in_tc(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  qual : String,
) -> Option[ImportedPkg] {
  if starts_with_str(qual, "@canon:") {
    return lookup_imported_pkg_transitive(g.tc, slice_str(qual, 7, qual.length()))
  }
  if norm_pkg == "" {
    resolve_pkg_for_lookup(g.tc, qual, true)
  } else {
    match resolve_pkg_for_lookup(cur_tc, qual, true) {
      Some(sub) =>
        match lookup_imported_pkg_transitive(g.tc, sub.name) {
          Some(full) => Some(full)
          None => Some(sub)
        }
      None => None
    }
  }
}

///|
fn qbe_generic_has_user_callee_in(cur_tc : TypeChecker, name : String) -> Bool {
  match cur_tc.consts.get(name) {
    Some(TFn(_, _)) => return true
    _ => ()
  }
  cur_tc.fns.contains(name) || cur_tc.extern_fns.contains(name)
}

///|
fn qbe_generic_add_callee_candidate(
  g : QbeGen,
  callee_pkg : String,
  callee_tc : TypeChecker,
  callee_fi : FnInfo,
  acc : QbeGenericScanAcc,
) -> Unit {
  if callee_fi.decl.type_params.length() == 0 {
    return
  }
  if qbe_fn_has_eq_tparams_in(callee_tc, callee_fi) {
    acc.local_eq = true
  }
  if callee_fi.decl.type_bounds.length() == 0 {
    let npkg = qbe_norm_mono_pkg(g, callee_pkg)
    let ckey = qbe_generic_decl_key(g, callee_fi, npkg)
    if !acc.edge_seen.contains(ckey) {
      acc.edge_seen.set(ckey, true)
      acc.edges.push(QbeGenericNode::{ key: ckey, finfo: callee_fi, pkg: npkg })
    }
  }
}

///|
///|
fn qbe_generic_add_method_key(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  mk : String,
  is_canonical_key : Bool,
  acc : QbeGenericScanAcc,
) -> Bool {
  let qp1 = split_qual_name(mk)
  if qp1.prefix != "" && has_qual_sep(qp1.name) {
    let pkg_qual = qp1.prefix
    let sub_mk = qp1.name
    if is_canonical_key {
      if g.tc.pkg_name != "" && pkg_qual == g.tc.pkg_name {
        match g.tc.methods.get(sub_mk) {
          Some(mi) => {
            qbe_generic_add_callee_candidate(g, "", g.tc, mi, acc)
            return true
          }
          None => ()
        }
      }
      match lookup_imported_pkg_transitive(g.tc, pkg_qual) {
        Some(ipkg) => {
          let callee_pkg = qbe_norm_mono_pkg(g, ipkg.name)
          match ipkg.tc.methods.get(sub_mk) {
            Some(mi) => {
              qbe_generic_add_callee_candidate(g, callee_pkg, ipkg.tc, mi, acc)
              return true
            }
            None => ()
          }
          match cur_tc.methods.get(mk) {
            Some(mi) => {
              qbe_generic_add_callee_candidate(g, callee_pkg, ipkg.tc, mi, acc)
              return true
            }
            None => ()
          }
        }
        None => ()
      }
    } else {
      let ipkg_opt = match qbe_generic_resolve_pkg_in_tc(g, norm_pkg, cur_tc, pkg_qual) {
        Some(ip) => Some(ip)
        None => lookup_imported_pkg_transitive(g.tc, pkg_qual)
      }
      match ipkg_opt {
        Some(ipkg) => {
          let callee_pkg = qbe_norm_mono_pkg(g, ipkg.name)
          match ipkg.tc.methods.get(sub_mk) {
            Some(mi) => {
              qbe_generic_add_callee_candidate(g, callee_pkg, ipkg.tc, mi, acc)
              return true
            }
            None => ()
          }
          match cur_tc.methods.get(mk) {
            Some(mi) => {
              qbe_generic_add_callee_candidate(g, callee_pkg, ipkg.tc, mi, acc)
              return true
            }
            None => ()
          }
        }
        None => ()
      }
      if g.tc.pkg_name != "" && pkg_qual == g.tc.pkg_name {
        match g.tc.methods.get(sub_mk) {
          Some(mi) => {
            qbe_generic_add_callee_candidate(g, "", g.tc, mi, acc)
            return true
          }
          None => ()
        }
      }
    }
  }
  match cur_tc.methods.get(mk) {
    Some(mi) => {
      qbe_generic_add_callee_candidate(g, norm_pkg, cur_tc, mi, acc)
      true
    }
    None => false
  }
}

///|
fn qbe_scan_exprs_eq_arith(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  es : Array[Expr],
  acc : QbeGenericScanAcc,
) -> Unit {
  let mut i = 0
  while i < es.length() {
    qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, es[i], acc)
    i = i + 1
  }
}

///|
fn qbe_scan_expr_eq_arith(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  e : Expr,
  acc : QbeGenericScanAcc,
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(op, inner, _) => {
      if op == "-" {
        acc.local_arith = true
      }
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, inner, acc)
    }
    EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, inner, acc)
    EBinary(op, l, r, _) => {
      if op == "==" || op == "!=" {
        acc.local_eq = true
      } else if op == "+" ||
        op == "-" ||
        op == "*" ||
        op == "/" ||
        op == "%" ||
        op == "&" ||
        op == "|" ||
        op == "^" ||
        op == "<<" ||
        op == ">>" ||
        op == "<" ||
        op == "<=" ||
        op == ">" ||
        op == ">=" {
        acc.local_arith = true
      }
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, l, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, r, acc)
    }
    EField(o, _, _) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, o, acc)
    EIndex(o, i, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, o, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, i, acc)
    }
    ECall(callee, args, _) => {
      match callee {
        EIdent(cname, _) => {
          if cname == "physical_equal" && !qbe_generic_has_user_callee_in(cur_tc, "physical_equal") {
            acc.local_eq = true
          }
          match cur_tc.fns.get(cname) {
            Some(fi) => qbe_generic_add_callee_candidate(g, norm_pkg, cur_tc, fi, acc)
            None => ()
          }
        }
        EPath(qual, mem, _) => {
          let mut hit_fn = false
          match qbe_generic_resolve_pkg_in_tc(g, norm_pkg, cur_tc, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(fi) => {
                  hit_fn = true
                  qbe_generic_add_callee_candidate(
                    g,
                    qbe_norm_mono_pkg(g, ipkg.name),
                    ipkg.tc,
                    fi,
                    acc,
                  )
                }
                None => ()
              }
            None => ()
          }
          if !hit_fn {
            let _ = qbe_generic_add_method_key(g, norm_pkg, cur_tc, qual + "::" + mem, false, acc)
          }
        }
        _ => ()
      }
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, callee, acc)
      qbe_scan_exprs_eq_arith(g, norm_pkg, cur_tc, args, acc)
    }
    EMethodCall(obj, mname, args, sp) => {
      if mname == "contains" {
        acc.local_eq = true
      }
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, obj, acc)
      qbe_scan_exprs_eq_arith(g, norm_pkg, cur_tc, args, acc)
      let mut resolved = false
      match cur_tc.resolved_method_calls.get(span_key(sp)) {
        Some(mk) => resolved = qbe_generic_add_method_key(g, norm_pkg, cur_tc, mk, true, acc)
        None => ()
      }
      if !resolved {
        let cands = qbe_generic_meth_candidates(g, norm_pkg, cur_tc, mname)
        let mut ci = 0
        while ci < cands.length() {
          let _ = qbe_generic_add_method_key(g, norm_pkg, cur_tc, cands[ci], true, acc)
          ci = ci + 1
        }
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) =>
      qbe_scan_exprs_eq_arith(g, norm_pkg, cur_tc, elems, acc)
    EStructLit(_, spread, fields, _) => {
      match spread {
        Some(sp_e) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, sp_e, acc)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, fields[i].value, acc)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, stmts, acc)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, cond, acc)
      qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, then_stmts, acc)
      match else_opt {
        Some(el) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, el, acc)
        None => ()
      }
    }
    EIs(scrut, _, _) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, scrut, acc)
    EMatch(scrut, arms, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, scrut, acc)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, ge, acc)
          None => ()
        }
        qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, arms[i].body, acc)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) => qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, body, acc)
    EScope(a, b, _) | ESpawn(a, b, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, a, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, b, acc)
    }
  }
}

///|
fn qbe_scan_stmt_eq_arith(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  st : Stmt,
  acc : QbeGenericScanAcc,
) -> Unit {
  match st {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, init, acc)
    SAssign(l, r, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, l, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, r, acc)
    }
    SCompoundAssign(_, l, r, _) => {
      acc.local_arith = true
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, l, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, r, acc)
    }
    SWhile(c, body, _) | SGuard(c, body, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, c, acc)
      qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, body, acc)
    }
    SFor(init, c, step, body, _) => {
      qbe_scan_stmt_eq_arith(g, norm_pkg, cur_tc, init, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, c, acc)
      qbe_scan_stmt_eq_arith(g, norm_pkg, cur_tc, step, acc)
      qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, body, acc)
    }
    SForRange(_, a, b, _, body, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, a, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, b, acc)
      qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, body, acc)
    }
    SForIn(_, _, it, body, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, it, acc)
      qbe_scan_stmts_eq_arith(g, norm_pkg, cur_tc, body, acc)
    }
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, re, acc)
        None => ()
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, c, acc)
      qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, m, acc)
    }
    SExpr(e, _) => qbe_scan_expr_eq_arith(g, norm_pkg, cur_tc, e, acc)
  }
}

///|
fn qbe_scan_stmts_eq_arith(
  g : QbeGen,
  norm_pkg : String,
  cur_tc : TypeChecker,
  stmts : Array[Stmt],
  acc : QbeGenericScanAcc,
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_scan_stmt_eq_arith(g, norm_pkg, cur_tc, stmts[i], acc)
    i = i + 1
  }
}

///|
/// Single-scan O(V + E) reverse-edge BFS analysis of whether a generic
/// declaration (and any transitively called unbounded generic declarations)
/// uses `==`/`!=`/`.contains`/`physical_equal` or arithmetic/ordering ops.
/// Every canonical generic declaration's AST is scanned at most once.
fn qbe_ensure_generic_eq_arith(g : QbeGen, finfo : FnInfo, mpkg : String) -> String {
  let norm_pkg = qbe_norm_mono_pkg(g, mpkg)
  let root_key = qbe_generic_decl_key(g, finfo, norm_pkg)
  if g.generic_scan_done.contains(root_key) {
    return root_key
  }
  g.generic_scan_done.set(root_key, true)
  let discover : Array[QbeGenericNode] = [
    QbeGenericNode::{ key: root_key, finfo: finfo, pkg: norm_pkg },
  ]
  let eq_wl : Array[String] = []
  let arith_wl : Array[String] = []
  let mut di = 0
  while di < discover.length() {
    let node = discover[di]
    di = di + 1
    g.generic_scan_count = g.generic_scan_count + 1
    let cur_tc = qbe_generic_tc_for_pkg(g, node.pkg)
    let acc = QbeGenericScanAcc::{
      local_eq: qbe_fn_has_eq_tparams_in(cur_tc, node.finfo),
      local_arith: false,
      edges: [],
      edge_seen: Map([]),
    }
    qbe_scan_stmts_eq_arith(g, node.pkg, cur_tc, node.finfo.decl.body, acc)
    g.generic_has_eq.set(node.key, acc.local_eq)
    g.generic_has_arith.set(node.key, acc.local_arith)
    if acc.local_eq {
      eq_wl.push(node.key)
    }
    if acc.local_arith {
      arith_wl.push(node.key)
    }
    let mut ei = 0
    while ei < acc.edges.length() {
      let edge = acc.edges[ei]
      match g.generic_rev_edges.get(edge.key) {
        Some(callers) => callers.push(node.key)
        None => g.generic_rev_edges.set(edge.key, [node.key])
      }
      if g.generic_has_eq.get(edge.key) == Some(true) &&
        g.generic_has_eq.get(node.key) != Some(true) {
        g.generic_has_eq.set(node.key, true)
        eq_wl.push(node.key)
      }
      if g.generic_has_arith.get(edge.key) == Some(true) &&
        g.generic_has_arith.get(node.key) != Some(true) {
        g.generic_has_arith.set(node.key, true)
        arith_wl.push(node.key)
      }
      if !g.generic_scan_done.contains(edge.key) {
        g.generic_scan_done.set(edge.key, true)
        discover.push(edge)
      }
      ei = ei + 1
    }
  }
  let mut wi = 0
  while wi < eq_wl.length() {
    let v = eq_wl[wi]
    wi = wi + 1
    match g.generic_rev_edges.get(v) {
      Some(callers) => {
        let mut ci = 0
        while ci < callers.length() {
          let u = callers[ci]
          if g.generic_has_eq.get(u) != Some(true) {
            g.generic_has_eq.set(u, true)
            eq_wl.push(u)
          }
          ci = ci + 1
        }
      }
      None => ()
    }
  }
  wi = 0
  while wi < arith_wl.length() {
    let v = arith_wl[wi]
    wi = wi + 1
    match g.generic_rev_edges.get(v) {
      Some(callers) => {
        let mut ci = 0
        while ci < callers.length() {
          let u = callers[ci]
          if g.generic_has_arith.get(u) != Some(true) {
            g.generic_has_arith.set(u, true)
            arith_wl.push(u)
          }
          ci = ci + 1
        }
      }
      None => ()
    }
  }
  root_key
}

///|
fn qbe_fn_body_has_eq(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  let k = qbe_ensure_generic_eq_arith(g, finfo, mpkg)
  g.generic_has_eq.get(k) == Some(true)
}

///|
fn qbe_fn_body_has_arith(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  let k = qbe_ensure_generic_eq_arith(g, finfo, mpkg)
  g.generic_has_arith.get(k) == Some(true)
}

///|
fn qbe_lhs_needs_rhs_hint(lhs : Expr) -> Bool {
  match lhs {
    EIdent(n, _) => n == "None"
    EPath(q, m, _) => q == "Option" && m == "None"
    EArrayLit(elems, _) => {
      if elems.length() == 0 {
        return true
      }
      let mut i = 0
      while i < elems.length() {
        if qbe_lhs_needs_rhs_hint(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_lhs_needs_rhs_hint(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    ECall(EIdent(n, _), args, _) =>
      n == "Ok" ||
      n == "Err" ||
      (n == "Some" && args.length() == 1 && qbe_lhs_needs_rhs_hint(args[0]))
    ECall(EPath(q, m, _), args, _) =>
      (q == "Result" && (m == "Ok" || m == "Err")) ||
      (q == "Option" && m == "Some" && args.length() == 1 && qbe_lhs_needs_rhs_hint(args[0]))
    EStructLit(sname, spread, fields, _) => {
      if sname == "" {
        return true
      }
      match spread {
        Some(se) => if qbe_lhs_needs_rhs_hint(se) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_lhs_needs_rhs_hint(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) =>
      if stmts.length() > 0 {
        match stmts[stmts.length() - 1] {
          SExpr(e, _) => qbe_lhs_needs_rhs_hint(e)
          _ => false
        }
      } else {
        false
      }
    EIf(_, then_stmts, else_opt, _) => {
      let then_needs = if then_stmts.length() > 0 {
        match then_stmts[then_stmts.length() - 1] {
          SExpr(e, _) => qbe_lhs_needs_rhs_hint(e)
          _ => false
        }
      } else {
        false
      }
      if then_needs {
        return true
      }
      match else_opt {
        Some(ee) => qbe_lhs_needs_rhs_hint(ee)
        None => false
      }
    }
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        if qbe_lhs_needs_rhs_hint(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EDotVariant(_, _, _) => true
    _ => false
  }
}

///|
fn qbe_ty_has_error(t : Ty) -> Bool {
  match t {
    TError => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      qbe_ty_has_error(e)
    TResult(a, b) | TMap(a, b) => qbe_ty_has_error(a) || qbe_ty_has_error(b)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_error(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_qualify_struct_info(pkg_name : String, si : StructInfo) -> StructInfo {
  let ftys : Array[Ty] = []
  let mut i = 0
  while i < si.field_tys.length() {
    ftys.push(qualify_imported_ty(pkg_name, si.field_tys[i]))
    i = i + 1
  }
  StructInfo::{
    decl: si.decl,
    field_names: si.field_names,
    field_muts: si.field_muts,
    field_privs: si.field_privs,
    field_tys: ftys,
  }
}

///|
fn qbe_qualify_enum_info(pkg_name : String, ei : EnumInfo) -> EnumInfo {
  let vars : Array[VariantInfo] = []
  let mut vi = 0
  while vi < ei.variants.length() {
    let v = ei.variants[vi]
    let ftys : Array[Ty] = []
    let mut fi = 0
    while fi < v.field_tys.length() {
      ftys.push(qualify_imported_ty(pkg_name, v.field_tys[fi]))
      fi = fi + 1
    }
    vars.push(VariantInfo::{ name: v.name, field_tys: ftys })
    vi = vi + 1
  }
  EnumInfo::{ decl: ei.decl, variants: vars }
}

///|
fn qbe_qualify_nominal_name(g : QbeGen, name : String) -> String {
  let qp = split_qual_name(name)
  if qp.prefix == "" {
    let cur_pkg = if g.mono_pkg != "" { g.mono_pkg } else { g.tc.pkg_name }
    if cur_pkg != "" {
      cur_pkg + "::" + name
    } else {
      name
    }
  } else {
    if g.tc.pkg_name != "" && qp.prefix == g.tc.pkg_name {
      return name
    }
    match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
      Some(ipkg) => ipkg.name + "::" + qp.name
      None => name
    }
  }
}

///|
fn qbe_qualify_nominal_ty(g : QbeGen, raw_ty : Ty) -> Ty {
  let t = subst_ty(raw_ty, g.cur_type_subst)
  match t {
    TArray(e) => TArray(qbe_qualify_nominal_ty(g, e))
    TFixedArray(e) => TFixedArray(qbe_qualify_nominal_ty(g, e))
    TImmArray(e) => TImmArray(qbe_qualify_nominal_ty(g, e))
    TOption(e) => TOption(qbe_qualify_nominal_ty(g, e))
    TResult(ok, err) =>
      TResult(qbe_qualify_nominal_ty(g, ok), qbe_qualify_nominal_ty(g, err))
    TMap(k, v) =>
      TMap(qbe_qualify_nominal_ty(g, k), qbe_qualify_nominal_ty(g, v))
    TChannel(e) => TChannel(qbe_qualify_nominal_ty(g, e))
    TMutex(e) => TMutex(qbe_qualify_nominal_ty(g, e))
    TStruct(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(qbe_qualify_nominal_ty(g, args[i]))
        i = i + 1
      }
      TStruct(qbe_qualify_nominal_name(g, name), out)
    }
    TEnum(name, args) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < args.length() {
        out.push(qbe_qualify_nominal_ty(g, args[i]))
        i = i + 1
      }
      TEnum(qbe_qualify_nominal_name(g, name), out)
    }
    TDynTrait(name) => TDynTrait(qbe_qualify_nominal_name(g, name))
    TFn(params, ret) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < params.length() {
        out.push(qbe_qualify_nominal_ty(g, params[i]))
        i = i + 1
      }
      TFn(out, qbe_qualify_nominal_ty(g, ret))
    }
    TTuple(elems) => {
      let out : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        out.push(qbe_qualify_nominal_ty(g, elems[i]))
        i = i + 1
      }
      TTuple(out)
    }
    _ => t
  }
}

///|
/// Codegen-side type-parameter unification: identical to `unify_tparams` except
/// nominal `TStruct`/`TEnum` names are compared canonically (so a local
/// unqualified `Places` in `g.tc.fns`/`g.tc.methods` unifies with a qualified
/// `pkg::Places` coming from `qbe_qualify_nominal_ty` or `qbe_lookup_struct_info`).
fn qbe_unify_tparams(
  g : QbeGen,
  pattern : Ty,
  actual : Ty,
  subst : Map[String, Ty],
) -> Unit {
  match pattern {
    TParam(n) =>
      match actual {
        TError => ()
        _ =>
          match subst.get(n) {
            None => subst.set(n, actual)
            Some(TParam(_)) =>
              match actual {
                TParam(_) => ()
                _ => subst.set(n, actual)
              }
            Some(prev) =>
              if (ty_has_unresolved(prev) || qbe_ty_has_param(prev)) &&
                !ty_has_unresolved(actual) &&
                !qbe_ty_has_param(actual) {
                match actual {
                  TNever => ()
                  _ => subst.set(n, actual)
                }
              }
          }
      }
    TArray(pe) =>
      match actual {
        TArray(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TFixedArray(pe) =>
      match actual {
        TFixedArray(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TImmArray(pe) =>
      match actual {
        TImmArray(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TOption(pe) =>
      match actual {
        TOption(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TResult(po, pe) =>
      match actual {
        TResult(ao, ae) => {
          qbe_unify_tparams(g, po, ao, subst)
          qbe_unify_tparams(g, pe, ae, subst)
        }
        _ => ()
      }
    TMap(pk, pv) =>
      match actual {
        TMap(ak, av) => {
          qbe_unify_tparams(g, pk, ak, subst)
          qbe_unify_tparams(g, pv, av, subst)
        }
        _ => ()
      }
    TChannel(pe) =>
      match actual {
        TChannel(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TMutex(pe) =>
      match actual {
        TMutex(ae) => qbe_unify_tparams(g, pe, ae, subst)
        _ => ()
      }
    TStruct(pn, pargs) =>
      match actual {
        TStruct(an, aargs) =>
          if pn == an ||
            qbe_qualify_nominal_name(g, pn) == qbe_qualify_nominal_name(g, an) {
            let mut i = 0
            while i < pargs.length() && i < aargs.length() {
              qbe_unify_tparams(g, pargs[i], aargs[i], subst)
              i = i + 1
            }
          }
        _ => ()
      }
    TEnum(pn, pargs) =>
      match actual {
        TEnum(an, aargs) =>
          if pn == an ||
            qbe_qualify_nominal_name(g, pn) == qbe_qualify_nominal_name(g, an) {
            let mut i = 0
            while i < pargs.length() && i < aargs.length() {
              qbe_unify_tparams(g, pargs[i], aargs[i], subst)
              i = i + 1
            }
          }
        _ => ()
      }
    TFn(pp, pr) =>
      match actual {
        TFn(ap, ar) => {
          let mut i = 0
          while i < pp.length() && i < ap.length() {
            qbe_unify_tparams(g, pp[i], ap[i], subst)
            i = i + 1
          }
          qbe_unify_tparams(g, pr, ar, subst)
        }
        _ => ()
      }
    TTuple(pe) =>
      match actual {
        TTuple(ae) => {
          let mut i = 0
          while i < pe.length() && i < ae.length() {
            qbe_unify_tparams(g, pe[i], ae[i], subst)
            i = i + 1
          }
        }
        _ => ()
      }
    _ => ()
  }
}

///|
fn qbe_lookup_struct_info(g : QbeGen, name : String) -> Option[StructInfo] {
  let norm_name = if starts_with_str(name, "@canon:") {
    slice_str(name, 7, name.length())
  } else {
    name
  }
  let qp0 = split_qual_name(norm_name)
  if qp0.prefix != "" && g.tc.pkg_name != "" && qp0.prefix == g.tc.pkg_name {
    match g.tc.structs.get(qp0.name) {
      Some(si) => return Some(qbe_qualify_struct_info(g.tc.pkg_name, si))
      None => ()
    }
  }
  if g.mono_pkg != "" && !has_qual_sep(norm_name) {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.structs.get(norm_name) {
          Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
          None => ()
        }
      None => ()
    }
    match g.tc.structs.get(g.mono_pkg + "::" + norm_name) {
      Some(si) => return Some(si)
      None => ()
    }
  }
  match g.tc.structs.get(norm_name) {
    Some(si) => return Some(si)
    None => ()
  }
  let qp = qp0
  if qp.prefix != "" {
    match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.structs.get(qp.name) {
          Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match g.tc.imported_pkgs.get(g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.structs.get(qp.name) {
                Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_lookup_enum_info(g : QbeGen, name : String) -> Option[EnumInfo] {
  let qp0 = split_qual_name(name)
  if qp0.prefix != "" && g.tc.pkg_name != "" && qp0.prefix == g.tc.pkg_name {
    match g.tc.enums.get(qp0.name) {
      Some(ei) => return Some(qbe_qualify_enum_info(g.tc.pkg_name, ei))
      None => ()
    }
  }
  if g.mono_pkg != "" && !has_qual_sep(name) {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(name) {
          Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
          None => ()
        }
      None => ()
    }
    match g.tc.enums.get(g.mono_pkg + "::" + name) {
      Some(ei) => return Some(ei)
      None => ()
    }
  }
  match g.tc.enums.get(name) {
    Some(ei) => return Some(ei)
    None => ()
  }
  let qp = qp0
  if qp.prefix != "" {
    match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qp.name) {
          Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match g.tc.imported_pkgs.get(g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.enums.get(qp.name) {
                Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_qualify_fn_info_sig(pkg_name : String, fi : FnInfo) -> FnInfo {
  let ptys : Array[Ty] = []
  let mut i = 0
  while i < fi.param_tys.length() {
    ptys.push(qualify_imported_ty(pkg_name, fi.param_tys[i]))
    i = i + 1
  }
  FnInfo::{
    decl: fi.decl,
    param_tys: ptys,
    ret_ty: qualify_imported_ty(pkg_name, fi.ret_ty),
    is_imported: fi.is_imported,
  }
}

///|
fn qbe_lookup_method_info_with_pkg(
  g : QbeGen,
  sname : String,
  method_name : String,
) -> Option[(FnInfo, String)] {
  let qp0 = split_qual_name(sname)
  if qp0.prefix != "" && g.tc.pkg_name != "" && qp0.prefix == g.tc.pkg_name {
    match g.tc.methods.get(qp0.name + "::" + method_name) {
      Some(mi) => return Some((qbe_qualify_fn_info_sig(g.tc.pkg_name, mi), ""))
      None => ()
    }
  }
  let key = sname + "::" + method_name
  match g.tc.methods.get(key) {
    Some(mi) => return Some((mi, qbe_norm_mono_pkg(g, qp0.prefix)))
    None => ()
  }
  if g.mono_pkg != "" {
    let mp = qbe_norm_mono_pkg(g, g.mono_pkg)
    if mp != "" {
      match g.tc.methods.get(mp + "::" + key) {
        Some(mi) => return Some((mi, mp))
        None => ()
      }
      match lookup_imported_pkg_transitive(g.tc, mp) {
        Some(ipkg) =>
          match ipkg.tc.methods.get(key) {
            Some(mi) => return Some((qualify_fn_info(ipkg, mi), qbe_norm_mono_pkg(g, ipkg.name)))
            None => ()
          }
        None => ()
      }
    }
  }
  let qp = split_qual_name(sname)
  if qp.prefix != "" {
    let sub_key = qp.name + "::" + method_name
    match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.methods.get(sub_key) {
          Some(mi) => return Some((qualify_fn_info(ipkg, mi), qbe_norm_mono_pkg(g, ipkg.name)))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.methods.get(sub_key) {
                Some(mi) => return Some((qualify_fn_info(ipkg, mi), qbe_norm_mono_pkg(g, ipkg.name)))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_lookup_method_info(
  g : QbeGen,
  sname : String,
  method_name : String,
) -> Option[FnInfo] {
  match qbe_lookup_method_info_with_pkg(g, sname, method_name) {
    Some((mi, _)) => Some(mi)
    None => None
  }
}

///|
fn qbe_lookup_variant_enum(g : QbeGen, vname : String) -> Option[String] {
  if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.variant_to_enum.get(vname) {
          Some(en) => return Some(ipkg.name + "::" + en)
          None => ()
        }
      None => ()
    }
  }
  match g.tc.variant_to_enum.get(vname) {
    Some(en) => return Some(en)
    None => ()
  }
  None
}

///|
fn qbe_lookup_const_ty(g : QbeGen, name : String) -> Option[Ty] {
  if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.consts.get(name) {
          Some(cty) => return Some(qualify_imported_ty(ipkg.name, cty))
          None => ()
        }
      None => ()
    }
  }
  g.tc.consts.get(name)
}

///|
fn qbe_map_key_is_int(kty : Ty) -> Bool {
  match kty {
    TInt | TInt64 | TUInt | TUInt64 | TBool | TByte | TInt8 | TChar => true
    _ => false
  }
}

///|
pub struct QbeVMapLayout {
  kfields : Array[Ty]
  k_offs : Array[Int]
  v_off : Int
  slot_bytes : Int
}

///|
pub struct QbeVMapKeyArgs {
  regs : Array[String]
  abis : Array[String]
}

///|
fn qbe_vmap_key_fields(g : QbeGen, raw_kty : Ty) -> Array[Ty] {
  let kty = subst_ty(raw_kty, g.cur_type_subst)
  if qbe_is_hashable_scalar_ty(g, kty) {
    return [kty]
  }
  match kty {
    TTuple(elems) => {
      if elems.length() < 2 || elems.length() > 6 {
        return []
      }
      let mut i = 0
      while i < elems.length() {
        if !qbe_is_hashable_scalar_ty(g, elems[i]) {
          return []
        }
        i = i + 1
      }
      elems
    }
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(si) => {
          let n = si.field_tys.length()
          if n < 1 || n > 6 {
            return []
          }
          let subst = make_subst(si.decl.type_params, sargs)
          let out : Array[Ty] = []
          let mut i = 0
          while i < n {
            if si.field_muts[i] {
              return []
            }
            let fty = subst_ty(si.field_tys[i], subst)
            if !qbe_is_hashable_scalar_ty(g, fty) {
              return []
            }
            out.push(fty)
            i = i + 1
          }
          out
        }
        None => []
      }
    _ => []
  }
}

///|
fn qbe_is_vmap_key_ty(g : QbeGen, kty : Ty) -> Bool {
  qbe_vmap_key_fields(g, kty).length() > 0
}

///|
fn qbe_ty_has_vmap(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 4 {
    return false
  }
  match ty {
    TMap(k, v) =>
      qbe_is_vmap_key_ty(g, k) ||
      qbe_ty_has_vmap(g, v, depth + 1)
    TTuple(elems) => {
      if qbe_is_vmap_key_ty(g, ty) {
        return true
      }
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_vmap(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(_, args) => {
      if qbe_is_vmap_key_ty(g, ty) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_vmap(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TEnum(_, args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_vmap(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      qbe_ty_has_vmap(g, e, depth + 1)
    TResult(a, b) =>
      qbe_ty_has_vmap(g, a, depth + 1) || qbe_ty_has_vmap(g, b, depth + 1)
    _ => false
  }
}

///|
fn qbe_vmap_field_size(t : Ty) -> Int {
  match t {
    TBool | TByte | TInt8 => 1
    TInt | TUInt | TFloat | TChar => 4
    _ => 8
  }
}

///|
fn qbe_vmap_align_up(off : Int, align : Int) -> Int {
  if align <= 1 {
    off
  } else {
    ((off + align - 1) / align) * align
  }
}

///|
fn qbe_vmap_layout(kfields : Array[Ty], vty : Ty) -> QbeVMapLayout {
  let k_offs : Array[Int] = []
  let mut off = 0
  let mut max_align = 1
  let mut i = 0
  while i < kfields.length() {
    let sz = qbe_vmap_field_size(kfields[i])
    if sz > max_align {
      max_align = sz
    }
    off = qbe_vmap_align_up(off, sz)
    k_offs.push(off)
    off = off + sz
    i = i + 1
  }
  let vsz = qbe_vmap_field_size(vty)
  if vsz > max_align {
    max_align = vsz
  }
  off = qbe_vmap_align_up(off, vsz)
  let v_off = off
  off = off + vsz
  let slot_bytes = qbe_vmap_align_up(off, max_align)
  QbeVMapLayout::{ kfields, k_offs, v_off, slot_bytes }
}

///|
fn qbe_vmap_idx_mul(sb : StringBuilder, dst : String, idx : String, stride : Int) -> Unit {
  if stride == 1 {
    sb.write_string("    " + dst + " =l copy " + idx + "\n")
  } else if stride == 2 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 1\n")
  } else if stride == 4 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 2\n")
  } else if stride == 8 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 3\n")
  } else if stride == 16 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 4\n")
  } else if stride == 32 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 5\n")
  } else if stride == 64 {
    sb.write_string("    " + dst + " =l shl " + idx + ", 6\n")
  } else {
    sb.write_string("    " + dst + " =l mul " + idx + ", " + stride.to_string() + "\n")
  }
}

///|
fn qbe_vmap_emit_zext32_to_l(
  sb : StringBuilder,
  dst : String,
  reg : String,
  fty : Ty,
) -> Unit {
  match fty {
    TInt | TUInt => sb.write_string("    " + dst + " =l extuw " + reg + "\n")
    TBool | TByte | TInt8 =>
      sb.write_string("    " + dst + " =l and " + reg + ", 255\n")
    _ => sb.write_string("    " + dst + " =l and " + reg + ", 4294967295\n")
  }
}

///|
fn qbe_vmap_emit_hash(
  sb : StringBuilder,
  kfields : Array[Ty],
  fregs : Array[String],
  pfx : String,
) -> Unit {
  let hlast = if kfields.length() == 2 &&
    qbe_vmap_field_size(kfields[0]) <= 4 &&
    qbe_vmap_field_size(kfields[1]) <= 4 &&
    !qbe_is_float_ty(kfields[0]) &&
    !qbe_is_float_ty(kfields[1]) {
    // P81 (P76-C): Pack two <=32-bit fields into one 64-bit word and hash once.
    qbe_vmap_emit_zext32_to_l(sb, "%hpk0_" + pfx, fregs[0], kfields[0])
    qbe_vmap_emit_zext32_to_l(sb, "%hpk1_" + pfx, fregs[1], kfields[1])
    sb.write_string("    %hpk1s_" + pfx + " =l shl %hpk1_" + pfx + ", 32\n")
    sb.write_string("    %hpk_" + pfx + " =l or %hpk0_" + pfx + ", %hpk1s_" + pfx + "\n")
    sb.write_string("    %hx_" + pfx + "_0 =l xor 5871781006564002453, %hpk_" + pfx + "\n")
    sb.write_string("    %h_" + pfx + "_1 =l mul %hx_" + pfx + "_0, -7046029254386353131\n")
    "%h_" + pfx + "_1"
  } else {
    sb.write_string("    %h_" + pfx + "_0 =l copy 5871781006564002453\n")
    let mut i = 0
    while i < kfields.length() {
      let prev = "%h_" + pfx + "_" + i.to_string()
      let next = "%h_" + pfx + "_" + (i + 1).to_string()
      let fl = match kfields[i] {
        TInt => {
          let t = "%hf_" + pfx + "_" + i.to_string()
          sb.write_string("    " + t + " =l extsw " + fregs[i] + "\n")
          t
        }
        TUInt => {
          let t = "%hf_" + pfx + "_" + i.to_string()
          sb.write_string("    " + t + " =l extuw " + fregs[i] + "\n")
          t
        }
        TDouble => {
          // Normalize -0.0 (0x8000000000000000) to +0.0 (0) so -0.0 and +0.0 hash identically.
          let suf = pfx + "_" + i.to_string()
          let tb = "%hfb_" + suf
          let tz = "%hfz_" + suf
          let tzl = "%hfzl_" + suf
          let tm = "%hfm_" + suf
          let t = "%hf_" + suf
          sb.write_string("    " + tb + " =l cast " + fregs[i] + "\n")
          sb.write_string("    " + tz + " =w cnel " + tb + ", -9223372036854775808\n")
          sb.write_string("    " + tzl + " =l extuw " + tz + "\n")
          sb.write_string("    " + tm + " =l sub 0, " + tzl + "\n")
          sb.write_string("    " + t + " =l and " + tb + ", " + tm + "\n")
          t
        }
        TFloat => {
          // Normalize -0.0f (0x80000000) to +0.0f (0) so -0.0f and +0.0f hash identically.
          let suf = pfx + "_" + i.to_string()
          let tb = "%hfb_" + suf
          let tz = "%hfz_" + suf
          let tm = "%hfm_" + suf
          let tn = "%hfn_" + suf
          let t = "%hf_" + suf
          sb.write_string("    " + tb + " =w cast " + fregs[i] + "\n")
          sb.write_string("    " + tz + " =w cnew " + tb + ", -2147483648\n")
          sb.write_string("    " + tm + " =w sub 0, " + tz + "\n")
          sb.write_string("    " + tn + " =w and " + tb + ", " + tm + "\n")
          sb.write_string("    " + t + " =l extuw " + tn + "\n")
          t
        }
        _ => fregs[i]
      }
      let hx = "%hx_" + pfx + "_" + i.to_string()
      sb.write_string("    " + hx + " =l xor " + prev + ", " + fl + "\n")
      sb.write_string("    " + next + " =l mul " + hx + ", -7046029254386353131\n")
      i = i + 1
    }
    "%h_" + pfx + "_" + kfields.length().to_string()
  }
  sb.write_string("    %hs1_" + pfx + " =l shr " + hlast + ", 30\n")
  sb.write_string("    %hm1_" + pfx + " =l xor " + hlast + ", %hs1_" + pfx + "\n")
  sb.write_string("    %hm2_" + pfx + " =l mul %hm1_" + pfx + ", -4658895280553007687\n")
  sb.write_string("    %hs2_" + pfx + " =l shr %hm2_" + pfx + ", 27\n")
  sb.write_string("    %hfin_" + pfx + " =l xor %hm2_" + pfx + ", %hs2_" + pfx + "\n")
  sb.write_string("    %ht1_" + pfx + " =l shr %hfin_" + pfx + ", 57\n")
  sb.write_string("    %ht2_" + pfx + " =w copy %ht1_" + pfx + "\n")
  sb.write_string("    %tag_" + pfx + " =w or %ht2_" + pfx + ", 128\n")
}

///|
fn qbe_vmap_emit_load_field(
  sb : StringBuilder,
  dst : String,
  ptr : String,
  fty : Ty,
  pfx : String,
) -> Unit {
  match fty {
    TInt => sb.write_string("    " + dst + " =w loadsw " + ptr + "\n")
    TUInt => sb.write_string("    " + dst + " =w loaduw " + ptr + "\n")
    TFloat => sb.write_string("    " + dst + " =s loads " + ptr + "\n")
    TDouble => sb.write_string("    " + dst + " =d loadd " + ptr + "\n")
    TChar => {
      sb.write_string("    %lw_" + pfx + " =w loaduw " + ptr + "\n")
      sb.write_string("    " + dst + " =l extuw %lw_" + pfx + "\n")
    }
    TBool | TByte => {
      sb.write_string("    %lw_" + pfx + " =w loadub " + ptr + "\n")
      sb.write_string("    " + dst + " =l extuw %lw_" + pfx + "\n")
    }
    TInt8 => {
      sb.write_string("    %lw_" + pfx + " =w loadsb " + ptr + "\n")
      sb.write_string("    " + dst + " =l extsw %lw_" + pfx + "\n")
    }
    _ => sb.write_string("    " + dst + " =l loadl " + ptr + "\n")
  }
}

///|
fn qbe_vmap_emit_store_field(
  sb : StringBuilder,
  vreg : String,
  ptr : String,
  fty : Ty,
  pfx : String,
) -> Unit {
  match fty {
    TInt | TUInt => sb.write_string("    storew " + vreg + ", " + ptr + "\n")
    TFloat => sb.write_string("    stores " + vreg + ", " + ptr + "\n")
    TDouble => sb.write_string("    stored " + vreg + ", " + ptr + "\n")
    TChar => {
      sb.write_string("    %sw_" + pfx + " =w copy " + vreg + "\n")
      sb.write_string("    storew %sw_" + pfx + ", " + ptr + "\n")
    }
    TBool | TByte | TInt8 => {
      sb.write_string("    %sw_" + pfx + " =w copy " + vreg + "\n")
      sb.write_string("    storeb %sw_" + pfx + ", " + ptr + "\n")
    }
    _ => sb.write_string("    storel " + vreg + ", " + ptr + "\n")
  }
}

///|
fn qbe_vmap_emit_val_to_l(
  sb : StringBuilder,
  dst : String,
  vreg : String,
  vty : Ty,
  pfx : String,
) -> Unit {
  match vty {
    TInt => sb.write_string("    " + dst + " =l extsw " + vreg + "\n")
    TUInt => sb.write_string("    " + dst + " =l extuw " + vreg + "\n")
    TFloat => {
      sb.write_string("    %fw_" + pfx + " =w cast " + vreg + "\n")
      sb.write_string("    " + dst + " =l extuw %fw_" + pfx + "\n")
    }
    TDouble => sb.write_string("    " + dst + " =l cast " + vreg + "\n")
    _ => sb.write_string("    " + dst + " =l copy " + vreg + "\n")
  }
}

///|
fn qbe_vmap_emit_key_cmp(
  sb : StringBuilder,
  lay : QbeVMapLayout,
  slot_ptr : String,
  fregs : Array[String],
  lbl_hit : String,
  lbl_miss : String,
  pfx : String,
) -> Unit {
  let n = lay.kfields.length()
  if n == 2 &&
    lay.k_offs[0] == 0 &&
    lay.k_offs[1] == 4 &&
    qbe_vmap_field_size(lay.kfields[0]) == 4 &&
    qbe_vmap_field_size(lay.kfields[1]) == 4 &&
    !qbe_is_float_ty(lay.kfields[0]) &&
    !qbe_is_float_ty(lay.kfields[1]) {
    // P81 (P76-C): Single 64-bit little-endian key compare for 2x4B keys.
    qbe_vmap_emit_zext32_to_l(sb, "%kpk0_" + pfx, fregs[0], lay.kfields[0])
    qbe_vmap_emit_zext32_to_l(sb, "%kpk1_" + pfx, fregs[1], lay.kfields[1])
    sb.write_string("    %kpk1s_" + pfx + " =l shl %kpk1_" + pfx + ", 32\n")
    sb.write_string("    %kpk_" + pfx + " =l or %kpk0_" + pfx + ", %kpk1s_" + pfx + "\n")
    sb.write_string("    %sk_" + pfx + " =l loadl " + slot_ptr + "\n")
    sb.write_string("    %keq_" + pfx + " =w ceql %kpk_" + pfx + ", %sk_" + pfx + "\n")
    sb.write_string("    jnz %keq_" + pfx + ", " + lbl_hit + ", " + lbl_miss + "\n")
    return
  }
  let mut i = 0
  while i < n {
    let fp = if lay.k_offs[i] == 0 {
      slot_ptr
    } else {
      let t = "%kp_" + pfx + "_" + i.to_string()
      sb.write_string("    " + t + " =l add " + slot_ptr + ", " + lay.k_offs[i].to_string() + "\n")
      t
    }
    let sf = "%kf_" + pfx + "_" + i.to_string()
    qbe_vmap_emit_load_field(sb, sf, fp, lay.kfields[i], pfx + "_" + i.to_string())
    let eq = "%keq_" + pfx + "_" + i.to_string()
    match lay.kfields[i] {
      TInt | TUInt => sb.write_string("    " + eq + " =w ceqw " + fregs[i] + ", " + sf + "\n")
      TFloat => sb.write_string("    " + eq + " =w ceqs " + fregs[i] + ", " + sf + "\n")
      TDouble => sb.write_string("    " + eq + " =w ceqd " + fregs[i] + ", " + sf + "\n")
      _ => sb.write_string("    " + eq + " =w ceql " + fregs[i] + ", " + sf + "\n")
    }
    let next_lbl = if i + 1 == n {
      lbl_hit
    } else {
      "@cmp_" + pfx + "_" + (i + 1).to_string()
    }
    sb.write_string("    jnz " + eq + ", " + next_lbl + ", " + lbl_miss + "\n")
    if i + 1 < n {
      sb.write_string(next_lbl + "\n")
    }
    i = i + 1
  }
}

///|
/// P81 (P76-C): Lazily emit register-returning `$pion_vmap_get_or_<m>` for scalar-value vmaps.
fn qbe_ensure_vmap_get_or_fn(g : QbeGen, kty : Ty, vty : Ty) -> String {
  let m = qbe_ensure_vmap_fns(g, kty, vty)
  if g.vmap_get_or_seen.contains(m) {
    return m
  }
  g.vmap_get_or_seen.set(m, true)
  let kfields = qbe_vmap_key_fields(g, kty)
  let lay = qbe_vmap_layout(kfields, vty)
  let n = kfields.length()
  let kregs : Array[String] = []
  let mut ki = 0
  while ki < n {
    kregs.push("%k" + ki.to_string())
    ki = ki + 1
  }
  let ksig = qbe_vmap_param_sig(kfields)
  let vabi = qbe_abi_ty(vty)
  let sb = StringBuilder()
  sb.write_string("function " + vabi + " $pion_vmap_get_or_" + m + "(l %m" + ksig + ", " + vabi + " %def) {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @miss\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "go")
  sb.write_string("    %idx_sl =l alloc8 8\n    %i0 =l and %hfin_go, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @miss\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_go\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "go")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n")
  sb.write_string("    %vp =l add %sp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%vv", "%vp", vty, "gov")
  sb.write_string("    ret %vv\n@miss\n    ret %def\n}\n\n")
  g.extra_fns.push(sb.to_string())
  m
}

///|
fn qbe_vmap_sym_base(g : QbeGen, kty : Ty, vty : Ty) -> String {
  let qk = qbe_qualify_nominal_ty(g, kty)
  let qv = qbe_qualify_nominal_ty(g, vty)
  g.pkg_prefix + "vm_" + qbe_mangle_ty(qk) + "_" + qbe_mangle_ty(qv)
}

///|
fn qbe_vmap_param_sig(kfields : Array[Ty]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < kfields.length() {
    sb.write_string(", ")
    sb.write_string(qbe_abi_ty(kfields[i]))
    sb.write_string(" %k")
    sb.write_string(i.to_string())
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_ensure_vmap_fns(g : QbeGen, kty : Ty, vty : Ty) -> String {
  let m = qbe_vmap_sym_base(g, kty, vty)
  if g.vmap_seen.contains(m) {
    return m
  }
  g.vmap_seen.set(m, true)
  let kfields = qbe_vmap_key_fields(g, kty)
  let lay = qbe_vmap_layout(kfields, vty)
  let n = kfields.length()
  let kregs : Array[String] = []
  let mut ki = 0
  while ki < n {
    kregs.push("%k" + ki.to_string())
    ki = ki + 1
  }
  let ksig = qbe_vmap_param_sig(kfields)
  let vabi = qbe_abi_ty(vty)
  let v_is_obj = qbe_is_obj_ty(g, vty)
  let per_slot = 1 + lay.slot_bytes
  let msg_id = qbe_intern_cstring(g, "key not found in Map")
  let file_id = qbe_intern_cstring(g, "<vmap>")
  let sb = StringBuilder()

  // 1. drop
  sb.write_string("function $pion_vmap_drop_" + m + "(l %m) {\n@start\n")
  sb.write_string("    %bp =l add %m, 16\n    %buf =l loadl %bp\n    %buf_nz =w cnel %buf, 0\n    jnz %buf_nz, @has_buf, @done\n@has_buf\n")
  if v_is_obj {
    sb.write_string("    %cp =l add %m, 8\n    %cap =l loadl %cp\n    %slots =l add %buf, %cap\n    %i_sl =l alloc8 8\n    storel 0, %i_sl\n    jmp @loop\n@loop\n")
    sb.write_string("    %i =l loadl %i_sl\n    %lt =w csltl %i, %cap\n    jnz %lt, @step, @free_buf\n@step\n")
    sb.write_string("    %ctp =l add %buf, %i\n    %ct =w loadub %ctp\n    jnz %ct, @decv, @next\n@decv\n")
    qbe_vmap_idx_mul(sb, "%soff", "%i", lay.slot_bytes)
    sb.write_string("    %sp =l add %slots, %soff\n    %vp =l add %sp, " + lay.v_off.to_string() + "\n    %vv =l loadl %vp\n    call $pion_rc_dec(l %vv)\n@next\n")
    sb.write_string("    %ni =l add %i, 1\n    storel %ni, %i_sl\n    jmp @loop\n@free_buf\n")
  }
  sb.write_string("    call $pion_ptr_free(l %buf)\n@done\n    ret\n}\n\n")

  // 2. new(init_cap)
  sb.write_string("function l $pion_vmap_new_" + m + "(l %init_cap) {\n@start\n")
  sb.write_string("    %m =l call $pion_alloc_uninit(w 24, w 4, l $pion_vmap_drop_" + m + ")\n")
  sb.write_string("    storel 0, %m\n    %p8 =l add %m, 8\n    storel 0, %p8\n    %p16 =l add %m, 16\n    storel 0, %p16\n")
  sb.write_string("    %pos =w csgtl %init_cap, 0\n    jnz %pos, @prealloc, @done\n@prealloc\n")
  sb.write_string("    %t4 =l shl %init_cap, 2\n    %t3 =l div %t4, 3\n    %need =l add %t3, 1\n    %c_sl =l alloc8 8\n    storel 16, %c_sl\n    jmp @cloop\n@cloop\n")
  sb.write_string("    %c =l loadl %c_sl\n    %clt =w csltl %c, %need\n    jnz %clt, @cdbl, @calloc\n@cdbl\n")
  sb.write_string("    %c2 =l shl %c, 1\n    storel %c2, %c_sl\n    jmp @cloop\n@calloc\n")
  sb.write_string("    %tot =l mul %c, " + per_slot.to_string() + "\n    %buf =l call $pion_ptr_alloc(l %tot)\n")
  sb.write_string("    storel %c, %p8\n    storel %buf, %p16\n@done\n    ret %m\n}\n\n")

  // 3. grow(m, new_cap)
  sb.write_string("function $pion_vmap_grow_" + m + "(l %m, l %ncap) {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %ocap =l loadl %p8\n    %p16 =l add %m, 16\n    %obuf =l loadl %p16\n")
  sb.write_string("    %tot =l mul %ncap, " + per_slot.to_string() + "\n    %nbuf =l call $pion_ptr_alloc(l %tot)\n")
  sb.write_string("    storel %ncap, %p8\n    storel %nbuf, %p16\n    %obuf_nz =w cnel %obuf, 0\n    jnz %obuf_nz, @rehash, @done\n@rehash\n")
  sb.write_string("    %oslots =l add %obuf, %ocap\n    %nslots =l add %nbuf, %ncap\n    %nmask =l sub %ncap, 1\n")
  sb.write_string("    %i_sl =l alloc8 8\n    %d_sl =l alloc8 8\n    storel 0, %i_sl\n    jmp @loop\n@loop\n")
  sb.write_string("    %i =l loadl %i_sl\n    %lt =w csltl %i, %ocap\n    jnz %lt, @step, @free_old\n@step\n")
  sb.write_string("    %ocp =l add %obuf, %i\n    %oc =w loadub %ocp\n    jnz %oc, @move, @next\n@move\n")
  qbe_vmap_idx_mul(sb, "%osoff", "%i", lay.slot_bytes)
  sb.write_string("    %osp =l add %oslots, %osoff\n")
  let g_fregs : Array[String] = []
  ki = 0
  while ki < n {
    let fp = if lay.k_offs[ki] == 0 {
      "%osp"
    } else {
      let t = "%okp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %osp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    let fr = "%okf_" + ki.to_string()
    qbe_vmap_emit_load_field(sb, fr, fp, kfields[ki], "gr_" + ki.to_string())
    g_fregs.push(fr)
    ki = ki + 1
  }
  sb.write_string("    %ovp =l add %osp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%ov", "%ovp", vty, "gr_v")
  qbe_vmap_emit_hash(sb, kfields, g_fregs, "gr")
  sb.write_string("    %d0 =l and %hfin_gr, %nmask\n    storel %d0, %d_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %d =l loadl %d_sl\n    %ncp =l add %nbuf, %d\n    %nc =w loadub %ncp\n    jnz %nc, @pnext, @put\n@pnext\n")
  sb.write_string("    %d1 =l add %d, 1\n    %d2 =l and %d1, %nmask\n    storel %d2, %d_sl\n    jmp @probe\n@put\n")
  sb.write_string("    storeb %oc, %ncp\n")
  qbe_vmap_idx_mul(sb, "%nsoff", "%d", lay.slot_bytes)
  sb.write_string("    %nsp =l add %nslots, %nsoff\n")
  ki = 0
  while ki < n {
    let fp = if lay.k_offs[ki] == 0 {
      "%nsp"
    } else {
      let t = "%nkp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %nsp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    qbe_vmap_emit_store_field(sb, g_fregs[ki], fp, kfields[ki], "gw_" + ki.to_string())
    ki = ki + 1
  }
  sb.write_string("    %nvp =l add %nsp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_store_field(sb, "%ov", "%nvp", vty, "gw_v")
  sb.write_string("@next\n    %ni =l add %i, 1\n    storel %ni, %i_sl\n    jmp @loop\n@free_old\n    call $pion_ptr_free(l %obuf)\n@done\n    ret\n}\n\n")

  // 4. set(m, k0.., val)
  sb.write_string("function $pion_vmap_set_" + m + "(l %m" + ksig + ", " + vabi + " %val) {\n@start\n")
  sb.write_string("    %len =l loadl %m\n    %p8 =l add %m, 8\n    %cap0 =l loadl %p8\n    %cap0_nz =w cnel %cap0, 0\n    jnz %cap0_nz, @chk_load, @grow_init\n@grow_init\n")
  sb.write_string("    call $pion_vmap_grow_" + m + "(l %m, l 16)\n    jmp @ready\n@chk_load\n")
  sb.write_string("    %lp1 =l add %len, 1\n    %lhs =l shl %lp1, 2\n    %rhs =l mul %cap0, 3\n    %needg =w csgtl %lhs, %rhs\n    %eqg =w ceql %lhs, %rhs\n    %dog =w or %needg, %eqg\n    jnz %dog, @grow_dbl, @ready\n@grow_dbl\n")
  sb.write_string("    %ncap =l shl %cap0, 1\n    call $pion_vmap_grow_" + m + "(l %m, l %ncap)\n@ready\n")
  sb.write_string("    %cap =l loadl %p8\n    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "set")
  sb.write_string("    %idx_sl =l alloc8 8\n    %i0 =l and %hfin_set, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @ins\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_set\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "set")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n")
  sb.write_string("    %hvp =l add %sp, " + lay.v_off.to_string() + "\n")
  if v_is_obj {
    sb.write_string("    call $pion_rc_inc(l %val)\n    %oldv =l loadl %hvp\n    storel %val, %hvp\n    call $pion_rc_dec(l %oldv)\n")
  } else {
    qbe_vmap_emit_store_field(sb, "%val", "%hvp", vty, "shv")
  }
  sb.write_string("    ret\n@ins\n    storeb %tag_set, %cp\n")
  qbe_vmap_idx_mul(sb, "%isoff", "%idx", lay.slot_bytes)
  sb.write_string("    %isp =l add %slots, %isoff\n")
  ki = 0
  while ki < n {
    let fp = if lay.k_offs[ki] == 0 {
      "%isp"
    } else {
      let t = "%ikp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %isp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    qbe_vmap_emit_store_field(sb, kregs[ki], fp, kfields[ki], "si_" + ki.to_string())
    ki = ki + 1
  }
  sb.write_string("    %ivp =l add %isp, " + lay.v_off.to_string() + "\n")
  if v_is_obj {
    sb.write_string("    call $pion_rc_inc(l %val)\n")
  }
  qbe_vmap_emit_store_field(sb, "%val", "%ivp", vty, "siv")
  sb.write_string("    %nlen =l add %len, 1\n    storel %nlen, %m\n    ret\n}\n\n")

  // 5. try_get(m, k0.., out_slot) -> w (stores 64-bit l repr into out_slot)
  sb.write_string("function w $pion_vmap_try_get_" + m + "(l %m" + ksig + ", l %out_slot) {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @miss\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "tg")
  sb.write_string("    %idx_sl =l alloc8 8\n    %i0 =l and %hfin_tg, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @miss\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_tg\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "tg")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n")
  sb.write_string("    %vp =l add %sp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%vv", "%vp", vty, "tgv")
  qbe_vmap_emit_val_to_l(sb, "%vl", "%vv", vty, "tgvl")
  sb.write_string("    storel %vl, %out_slot\n    ret 1\n@miss\n    ret 0\n}\n\n")

  // 6. get(m, k0..) -> vabi
  sb.write_string("function " + vabi + " $pion_vmap_get_" + m + "(l %m" + ksig + ") {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @miss\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "gt")
  sb.write_string("    %idx_sl =l alloc8 8\n    %i0 =l and %hfin_gt, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @miss\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_gt\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "gt")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n")
  sb.write_string("    %vp =l add %sp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%vv", "%vp", vty, "gtv")
  sb.write_string("    ret %vv\n@miss\n    call $pion_panic(l $pion_cstr_" + msg_id.to_string() + ", l $pion_cstr_" + file_id.to_string() + ", w 0)\n    hlt\n}\n\n")

  // 7. has(m, k0..) -> w
  sb.write_string("function w $pion_vmap_has_" + m + "(l %m" + ksig + ") {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @miss\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "hs")
  sb.write_string("    %idx_sl =l alloc8 8\n    %i0 =l and %hfin_hs, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @miss\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_hs\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "hs")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n    ret 1\n@miss\n    ret 0\n}\n\n")

  // 8. remove(m, k0..) with backward-shift deletion
  sb.write_string("function $pion_vmap_remove_" + m + "(l %m" + ksig + ") {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @done\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n    %mask =l sub %cap, 1\n")
  qbe_vmap_emit_hash(sb, kfields, kregs, "rm")
  sb.write_string("    %idx_sl =l alloc8 8\n    %hole_sl =l alloc8 8\n    %cur_sl =l alloc8 8\n")
  sb.write_string("    %i0 =l and %hfin_rm, %mask\n    storel %i0, %idx_sl\n    jmp @probe\n@probe\n")
  sb.write_string("    %idx =l loadl %idx_sl\n    %cp =l add %buf, %idx\n    %c =w loadub %cp\n    jnz %c, @chk, @done\n@chk\n")
  sb.write_string("    %teq =w ceqw %c, %tag_rm\n    jnz %teq, @cmp, @next\n@cmp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%idx", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n")
  qbe_vmap_emit_key_cmp(sb, lay, "%sp", kregs, "@hit", "@next", "rm")
  sb.write_string("@next\n    %n1 =l add %idx, 1\n    %n2 =l and %n1, %mask\n    storel %n2, %idx_sl\n    jmp @probe\n@hit\n")
  sb.write_string("    storeb 0, %cp\n")
  if v_is_obj {
    sb.write_string("    %rvp =l add %sp, " + lay.v_off.to_string() + "\n    %rv =l loadl %rvp\n    call $pion_rc_dec(l %rv)\n")
  }
  sb.write_string("    %olen =l loadl %m\n    %nlen =l sub %olen, 1\n    storel %nlen, %m\n")
  sb.write_string("    storel %idx, %hole_sl\n    %c0a =l add %idx, 1\n    %c0 =l and %c0a, %mask\n    storel %c0, %cur_sl\n    jmp @shift\n@shift\n")
  sb.write_string("    %cur =l loadl %cur_sl\n    %ccp =l add %buf, %cur\n    %cc =w loadub %ccp\n    jnz %cc, @s_chk, @done\n@s_chk\n")
  qbe_vmap_idx_mul(sb, "%csoff", "%cur", lay.slot_bytes)
  sb.write_string("    %csp =l add %slots, %csoff\n")
  let rm_fregs : Array[String] = []
  ki = 0
  while ki < n {
    let fp = if lay.k_offs[ki] == 0 {
      "%csp"
    } else {
      let t = "%rkp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %csp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    let fr = "%rkf_" + ki.to_string()
    qbe_vmap_emit_load_field(sb, fr, fp, kfields[ki], "rmr_" + ki.to_string())
    rm_fregs.push(fr)
    ki = ki + 1
  }
  qbe_vmap_emit_hash(sb, kfields, rm_fregs, "rms")
  sb.write_string("    %nat =l and %hfin_rms, %mask\n    %hole =l loadl %hole_sl\n")
  sb.write_string("    %dh0 =l sub %hole, %nat\n    %dh =l and %dh0, %mask\n")
  sb.write_string("    %dc0 =l sub %cur, %nat\n    %dc =l and %dc0, %mask\n")
  sb.write_string("    %domv =w cultl %dh, %dc\n    jnz %domv, @s_mv, @s_adv\n@s_mv\n")
  sb.write_string("    %hcp =l add %buf, %hole\n    storeb %cc, %hcp\n    storeb 0, %ccp\n")
  qbe_vmap_idx_mul(sb, "%hsoff", "%hole", lay.slot_bytes)
  sb.write_string("    %hsp =l add %slots, %hsoff\n")
  ki = 0
  while ki < n {
    let fp = if lay.k_offs[ki] == 0 {
      "%hsp"
    } else {
      let t = "%hkp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %hsp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    qbe_vmap_emit_store_field(sb, rm_fregs[ki], fp, kfields[ki], "rmw_" + ki.to_string())
    ki = ki + 1
  }
  sb.write_string("    %cvp =l add %csp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%cv", "%cvp", vty, "rmv_r")
  sb.write_string("    %hvp =l add %hsp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_store_field(sb, "%cv", "%hvp", vty, "rmv_w")
  sb.write_string("    storel %cur, %hole_sl\n@s_adv\n")
  sb.write_string("    %c1 =l add %cur, 1\n    %c2 =l and %c1, %mask\n    storel %c2, %cur_sl\n    jmp @shift\n@done\n    ret\n}\n\n")

  // 9. clear(m)
  sb.write_string("function $pion_vmap_clear_" + m + "(l %m) {\n@start\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @done\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %buf_nz =w cnel %buf, 0\n    jnz %buf_nz, @has_buf, @done\n@has_buf\n")
  sb.write_string("    %i_sl =l alloc8 8\n")
  if v_is_obj {
    sb.write_string("    %slots =l add %buf, %cap\n    storel 0, %i_sl\n    jmp @dloop\n@dloop\n")
    sb.write_string("    %di =l loadl %i_sl\n    %dlt =w csltl %di, %cap\n    jnz %dlt, @dstep, @zstart\n@dstep\n")
    sb.write_string("    %dcp =l add %buf, %di\n    %dc =w loadub %dcp\n    jnz %dc, @decv, @dnext\n@decv\n")
    qbe_vmap_idx_mul(sb, "%dsoff", "%di", lay.slot_bytes)
    sb.write_string("    %dsp =l add %slots, %dsoff\n    %dvp =l add %dsp, " + lay.v_off.to_string() + "\n    %dv =l loadl %dvp\n    call $pion_rc_dec(l %dv)\n@dnext\n")
    sb.write_string("    %dni =l add %di, 1\n    storel %dni, %i_sl\n    jmp @dloop\n@zstart\n")
  }
  sb.write_string("    storel 0, %i_sl\n    jmp @zloop\n@zloop\n")
  sb.write_string("    %zi =l loadl %i_sl\n    %zlt =w csltl %zi, %cap\n    jnz %zlt, @zstep, @zdone\n@zstep\n")
  sb.write_string("    %zp =l add %buf, %zi\n    storel 0, %zp\n    %zni =l add %zi, 8\n    storel %zni, %i_sl\n    jmp @zloop\n@zdone\n    storel 0, %m\n@done\n    ret\n}\n\n")

  // 10. copy(m) -> l
  sb.write_string("function l $pion_vmap_copy_" + m + "(l %m) {\n@start\n")
  sb.write_string("    %nm =l call $pion_vmap_new_" + m + "(l 0)\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %cap_nz =w cnel %cap, 0\n    jnz %cap_nz, @has_cap, @done\n@has_cap\n")
  sb.write_string("    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %buf_nz =w cnel %buf, 0\n    jnz %buf_nz, @has_buf, @done\n@has_buf\n")
  sb.write_string("    %tot =l mul %cap, " + per_slot.to_string() + "\n    %nbuf =l call $pion_ptr_alloc(l %tot)\n")
  sb.write_string("    %len =l loadl %m\n    storel %len, %nm\n    %np8 =l add %nm, 8\n    storel %cap, %np8\n    %np16 =l add %nm, 16\n    storel %nbuf, %np16\n")
  sb.write_string("    %oslots =l add %buf, %cap\n    %nslots =l add %nbuf, %cap\n    %i_sl =l alloc8 8\n    storel 0, %i_sl\n    jmp @loop\n@loop\n")
  sb.write_string("    %i =l loadl %i_sl\n    %lt =w csltl %i, %cap\n    jnz %lt, @step, @done\n@step\n")
  sb.write_string("    %ocp =l add %buf, %i\n    %oc =w loadub %ocp\n    jnz %oc, @cp_slot, @next\n@cp_slot\n")
  sb.write_string("    %ncp =l add %nbuf, %i\n    storeb %oc, %ncp\n")
  qbe_vmap_idx_mul(sb, "%soff", "%i", lay.slot_bytes)
  sb.write_string("    %osp =l add %oslots, %soff\n    %nsp =l add %nslots, %soff\n")
  ki = 0
  while ki < n {
    let ofp = if lay.k_offs[ki] == 0 {
      "%osp"
    } else {
      let t = "%cokp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %osp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    let nfp = if lay.k_offs[ki] == 0 {
      "%nsp"
    } else {
      let t = "%cnkp_" + ki.to_string()
      sb.write_string("    " + t + " =l add %nsp, " + lay.k_offs[ki].to_string() + "\n")
      t
    }
    let fr = "%ckf_" + ki.to_string()
    qbe_vmap_emit_load_field(sb, fr, ofp, kfields[ki], "cpr_" + ki.to_string())
    qbe_vmap_emit_store_field(sb, fr, nfp, kfields[ki], "cpw_" + ki.to_string())
    ki = ki + 1
  }
  sb.write_string("    %ovp =l add %osp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_load_field(sb, "%cv", "%ovp", vty, "cpvr")
  if v_is_obj {
    sb.write_string("    call $pion_rc_inc(l %cv)\n")
  }
  sb.write_string("    %nvp =l add %nsp, " + lay.v_off.to_string() + "\n")
  qbe_vmap_emit_store_field(sb, "%cv", "%nvp", vty, "cpvw")
  sb.write_string("@next\n    %ni =l add %i, 1\n    storel %ni, %i_sl\n    jmp @loop\n@done\n    ret %nm\n}\n\n")

  // 11. keys(m) -> l (Array[K])
  let arr_flags = qbe_arr_new_flags_w(g, kty)
  let flat_stride = qbe_flat_pod_stride(g, kty)
  sb.write_string("function l $pion_vmap_keys_" + m + "(l %m) {\n@start\n")
  sb.write_string("    %len =l loadl %m\n    %arr =l call $pion_arr_new(l %len, w " + arr_flags + ")\n")
  sb.write_string("    %len_nz =w cnel %len, 0\n    jnz %len_nz, @has_len, @done\n@has_len\n")
  sb.write_string("    %p8 =l add %m, 8\n    %cap =l loadl %p8\n    %p16 =l add %m, 16\n    %buf =l loadl %p16\n    %slots =l add %buf, %cap\n")
  sb.write_string("    %adp_p =l add %arr, 24\n    %adp =l loadl %adp_p\n")
  sb.write_string("    %i_sl =l alloc8 8\n    %o_sl =l alloc8 8\n    storel 0, %i_sl\n    storel 0, %o_sl\n    jmp @loop\n@loop\n")
  sb.write_string("    %i =l loadl %i_sl\n    %lt =w csltl %i, %cap\n    jnz %lt, @step, @fin\n@step\n")
  sb.write_string("    %cp =l add %buf, %i\n    %c =w loadub %cp\n    jnz %c, @emit_k, @next\n@emit_k\n")
  qbe_vmap_idx_mul(sb, "%soff", "%i", lay.slot_bytes)
  sb.write_string("    %sp =l add %slots, %soff\n    %oi =l loadl %o_sl\n")
  if qbe_is_hashable_scalar_ty(g, kty) {
    match kty {
      TBool | TByte | TInt8 => {
        sb.write_string("    %kb =w loadub %sp\n")
        sb.write_string("    %aep =l add %adp, %oi\n")
        sb.write_string("    storeb %kb, %aep\n")
      }
      TInt | TUInt | TChar | TFloat => {
        sb.write_string("    %kw =w loaduw %sp\n")
        sb.write_string("    %eoff =l shl %oi, 2\n")
        sb.write_string("    %aep =l add %adp, %eoff\n")
        sb.write_string("    storew %kw, %aep\n")
      }
      _ => {
        qbe_vmap_emit_load_field(sb, "%ksf_0", "%sp", kty, "ksr_0")
        qbe_vmap_emit_val_to_l(sb, "%ksfl_0", "%ksf_0", kty, "ksl_0")
        sb.write_string("    %eoff =l shl %oi, 3\n    %aep =l add %adp, %eoff\n    storel %ksfl_0, %aep\n")
      }
    }
  } else {
    if flat_stride > 0 {
      qbe_vmap_idx_mul(sb, "%eoff", "%oi", flat_stride)
      sb.write_string("    %dst =l add %adp, %eoff\n")
    } else {
      let kbytes = n * 8
      sb.write_string("    %dst =l call $pion_alloc_uninit(w " + kbytes.to_string() + ", w 4, l 0)\n")
      sb.write_string("    %eoff =l shl %oi, 3\n    %aep =l add %adp, %eoff\n    storel %dst, %aep\n")
    }
    ki = 0
    while ki < n {
      let sfp = if lay.k_offs[ki] == 0 {
        "%sp"
      } else {
        let t = "%ksfp_" + ki.to_string()
        sb.write_string("    " + t + " =l add %sp, " + lay.k_offs[ki].to_string() + "\n")
        t
      }
      let fr = "%ksf_" + ki.to_string()
      qbe_vmap_emit_load_field(sb, fr, sfp, kfields[ki], "ksr_" + ki.to_string())
      let fl = "%ksfl_" + ki.to_string()
      qbe_vmap_emit_val_to_l(sb, fl, fr, kfields[ki], "ksl_" + ki.to_string())
      let dfp = if ki == 0 {
        "%dst"
      } else {
        let t = "%kdfp_" + ki.to_string()
        sb.write_string("    " + t + " =l add %dst, " + (ki * 8).to_string() + "\n")
        t
      }
      sb.write_string("    storel " + fl + ", " + dfp + "\n")
      ki = ki + 1
    }
  }
  sb.write_string("    %noi =l add %oi, 1\n    storel %noi, %o_sl\n@next\n    %ni =l add %i, 1\n    storel %ni, %i_sl\n    jmp @loop\n@fin\n")
  sb.write_string("    %flen =l loadl %o_sl\n    storel %flen, %arr\n@done\n    ret %arr\n}\n\n")

  g.extra_fns.push(sb.to_string())
  m
}

///|
fn qbe_emit_vmap_key_args(
  g : QbeGen,
  key_expr : Expr,
  kty : Ty,
  args_pure : Bool,
) -> QbeVMapKeyArgs {
  let kfields = qbe_vmap_key_fields(g, kty)
  let n = kfields.length()
  let regs : Array[String] = []
  let abis : Array[String] = []
  if qbe_is_hashable_scalar_ty(g, kty) {
    let kv = qbe_emit_expr(g, key_expr, Some(kty))
    let cv = qbe_coerce_val(g, kv, kty)
    regs.push(cv)
    abis.push(qbe_abi_ty(kty))
    return QbeVMapKeyArgs::{ regs, abis }
  }
  // Zero-alloc destructuring for tuple literals `(a, b, c)` and struct literals `Tri::{ ... }`
  match kty {
    TTuple(_) =>
      match key_expr {
        ETuple(elems, _) =>
          if elems.length() == n {
            let mut i = 0
            while i < n {
              let ev = qbe_emit_expr(g, elems[i], Some(kfields[i]))
              let cv = qbe_coerce_val(g, ev, kfields[i])
              regs.push(cv)
              abis.push(qbe_abi_ty(kfields[i]))
              i = i + 1
            }
            return QbeVMapKeyArgs::{ regs, abis }
          }
        _ => ()
      }
    TStruct(sname, _) =>
      match key_expr {
        EStructLit(_, None, lit_fields, _) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(si) =>
              if si.field_names.length() == n {
                let slot_regs : Array[String] = []
                let mut si_i = 0
                while si_i < n {
                  slot_regs.push("")
                  si_i = si_i + 1
                }
                let mut fi = 0
                while fi < lit_fields.length() {
                  let lf = lit_fields[fi]
                  let mut pos = -1
                  let mut j = 0
                  while j < n {
                    if si.field_names[j] == lf.name {
                      pos = j
                    }
                    j = j + 1
                  }
                  if pos >= 0 {
                    let ev = qbe_emit_expr(g, lf.value, Some(kfields[pos]))
                    slot_regs[pos] = qbe_coerce_val(g, ev, kfields[pos])
                  }
                  fi = fi + 1
                }
                let mut all_ok = true
                let mut j = 0
                while j < n {
                  if slot_regs[j] == "" {
                    all_ok = false
                  }
                  j = j + 1
                }
                if all_ok {
                  let mut k = 0
                  while k < n {
                    regs.push(slot_regs[k])
                    abis.push(qbe_abi_ty(kfields[k]))
                    k = k + 1
                  }
                  return QbeVMapKeyArgs::{ regs, abis }
                }
              }
            None => ()
          }
        _ => ()
      }
    _ => ()
  }
  // Fallback: evaluate key expression (borrowing if pure) and load fields from heap object
  let ka = qbe_emit_arg_maybe_borrow_ext(
    g,
    key_expr,
    Some(kty),
    args_pure,
    args_pure && qbe_loop_has_no_calls_expr(g, key_expr),
  )
  let kv = ka.qv
  let mut i = 0
  while i < n {
    let fp = if i == 0 {
      kv.reg
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + kv.reg + ", " + (i * 8).to_string())
      t
    }
    let rl = qbe_tmp(g)
    qbe_emit(g, rl + " =l loadl " + fp)
    let fv = qbe_from_l(g, rl, kfields[i])
    regs.push(fv)
    abis.push(qbe_abi_ty(kfields[i]))
    i = i + 1
  }
  if !ka.borrowed {
    qbe_rc_dec(g, kv.reg, kv.ty)
  }
  QbeVMapKeyArgs::{ regs, abis }
}

///|
fn qbe_vmap_key_call_args(ka : QbeVMapKeyArgs) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < ka.regs.length() {
    sb.write_string(", ")
    sb.write_string(ka.abis[i])
    sb.write_string(" ")
    sb.write_string(ka.regs[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// Generic fns are monomorphized when bounded, or when their body uses
/// `==` / `!=` and every type argument is concrete: the erased body would
/// compare `T` values by pointer, while `String` must compare bytes and
/// payload-less enums their tags.
fn qbe_ty_has_option(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 4 {
    return false
  }
  match ty {
    TOption(_) => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TChannel(e) | TMutex(e) => qbe_ty_has_option(g, e, depth + 1)
    TResult(a, b) | TMap(a, b) =>
      qbe_ty_has_option(g, a, depth + 1) || qbe_ty_has_option(g, b, depth + 1)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_option(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_option(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_option(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      let mut i = 0
      while i < sargs.length() {
        if qbe_ty_has_option(g, sargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if sargs.length() > 0 {
        match qbe_lookup_struct_info(g, sname) {
          Some(sinfo) => {
            let qp = split_qual_name(sname)
            let saved_pkg = g.mono_pkg
            if qp.prefix != "" {
              g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
            }
            let mut fi = 0
            while fi < sinfo.field_tys.length() {
              if qbe_ty_has_option(g, sinfo.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            g.mono_pkg = saved_pkg
          }
          None => ()
        }
      }
      false
    }
    TEnum(ename, eargs) => {
      let mut i = 0
      while i < eargs.length() {
        if qbe_ty_has_option(g, eargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if eargs.length() > 0 {
        match qbe_lookup_enum_info(g, ename) {
          Some(einfo) => {
            let qp = split_qual_name(ename)
            let saved_pkg = g.mono_pkg
            if qp.prefix != "" {
              g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
            }
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                if qbe_ty_has_option(g, v.field_tys[fi], depth + 1) {
                  g.mono_pkg = saved_pkg
                  return true
                }
                fi = fi + 1
              }
              vi = vi + 1
            }
            g.mono_pkg = saved_pkg
          }
          None => ()
        }
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_type_expr_has_option(g : QbeGen, te : TypeExpr, depth : Int) -> Bool {
  if depth > 4 {
    return false
  }
  match te {
    TyName(name, args, _) => {
      if name == "Option" {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_type_expr_has_option(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if args.length() > 0 {
        match qbe_lookup_struct_info(g, name) {
          Some(sinfo) => {
            let mut fi = 0
            while fi < sinfo.field_tys.length() {
              if qbe_ty_has_option(g, sinfo.field_tys[fi], depth + 1) {
                return true
              }
              fi = fi + 1
            }
          }
          None => ()
        }
        match qbe_lookup_enum_info(g, name) {
          Some(einfo) => {
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                if qbe_ty_has_option(g, v.field_tys[fi], depth + 1) {
                  return true
                }
                fi = fi + 1
              }
              vi = vi + 1
            }
          }
          None => ()
        }
      }
      false
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_type_expr_has_option(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      if qbe_type_expr_has_option(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_option(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_pat_has_option(pat : Pattern) -> Bool {
  match pat {
    PVariant(_, vname, subs, _, _) => {
      if vname == "Some" || vname == "None" {
        return true
      }
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_has_option(subs[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_has_option(subs[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_expr_has_option(g : QbeGen, depth : Int, e : Expr) -> Bool {
  if depth > 16 {
    return false
  }
  match e {
    EIdent(name, _) => name == "None"
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | ETry(inner, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_option(g, depth + 1, inner)
    EAs(inner, ty, _) =>
      qbe_type_expr_has_option(g, ty, 0) ||
      qbe_expr_has_option(g, depth + 1, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_option(g, depth + 1, l) ||
      qbe_expr_has_option(g, depth + 1, r)
    ECall(callee, args, _) => {
      match callee {
        EIdent(cname, _) => {
          if cname == "Some" {
            return true
          }
          if depth <= 12 {
            let cf_opt : Option[FnInfo] = if g.mono_pkg != "" {
              match g.tc.imported_pkgs.get(g.mono_pkg) {
                Some(ipkg) => ipkg.tc.fns.get(cname)
                None => g.tc.fns.get(cname)
              }
            } else {
              g.tc.fns.get(cname)
            }
            match cf_opt {
              Some(cf) =>
                if cf.decl.type_params.length() > 0 &&
                  qbe_fn_uses_option_depth(g, cf, g.mono_pkg, depth + 4) {
                  return true
                }
              None => ()
            }
          }
        }
        EPath(qual, mem, _) =>
          if depth <= 12 {
            let mut cf_opt : Option[FnInfo] = None
            let mut cf_pkg = g.mono_pkg
            let mkey = qual + "::" + mem
            if g.mono_pkg != "" {
              match g.tc.imported_pkgs.get(g.mono_pkg) {
                Some(mpkg_info) =>
                  match mpkg_info.tc.methods.get(mkey) {
                    Some(mi) => cf_opt = Some(mi)
                    None =>
                      match resolve_alias_pkg(mpkg_info.tc, qual) {
                        Some(ipkg) =>
                          match ipkg.tc.fns.get(mem) {
                            Some(fi) => {
                              cf_opt = Some(fi)
                              cf_pkg = ipkg.name
                            }
                            None => ()
                          }
                        None => ()
                      }
                  }
                None => ()
              }
            } else {
              match g.tc.methods.get(mkey) {
                Some(mi) => cf_opt = Some(mi)
                None =>
                  match qbe_resolve_pkg_in_scope(g, qual) {
                    Some(ipkg) =>
                      match ipkg.tc.fns.get(mem) {
                        Some(fi) => {
                          cf_opt = Some(fi)
                          cf_pkg = ipkg.name
                        }
                        None => ()
                      }
                    None => ()
                  }
              }
            }
            match cf_opt {
              Some(cf) =>
                if cf.decl.type_params.length() > 0 &&
                  qbe_fn_uses_option_depth(g, cf, cf_pkg, depth + 4) {
                  return true
                }
              None => ()
            }
          }
        _ => ()
      }
      if qbe_expr_has_option(g, depth + 1, callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_option(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_option(g, depth + 1, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_option(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_option(g, depth + 1, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_option(g, depth + 1, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_option(g, depth + 1, stmts)
    EIf(cond, then_s, else_opt, _) => {
      if qbe_expr_has_option(g, depth + 1, cond) ||
        qbe_stmts_have_option(g, depth + 1, then_s) {
        return true
      }
      match else_opt {
        Some(ee) => qbe_expr_has_option(g, depth + 1, ee)
        None => false
      }
    }
    EIs(scrut, pat, _) => qbe_expr_has_option(g, depth + 1, scrut) || qbe_pat_has_option(pat)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_option(g, depth + 1, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        if qbe_pat_has_option(arms[i].pat) {
          return true
        }
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_option(g, depth + 1, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_option(g, depth + 1, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(ps, rty, body, _) => {
      if qbe_type_expr_has_option(g, rty, 0) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_option(g, ps[i].ty, 0) {
          return true
        }
        i = i + 1
      }
      qbe_stmts_have_option(g, depth + 1, body)
    }
  }
}

///|
fn qbe_stmt_has_option(g : QbeGen, depth : Int, st : Stmt) -> Bool {
  if depth > 16 {
    return false
  }
  match st {
    SLet(_, _, ty, init, _) | SLetTuple(_, ty, init, _) =>
      qbe_type_expr_has_option(g, ty, 0) ||
      qbe_expr_has_option(g, depth + 1, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
      qbe_expr_has_option(g, depth + 1, l) ||
      qbe_expr_has_option(g, depth + 1, r)
    SWhile(c, body, _) | SGuard(c, body, _) =>
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_option(g, depth + 1, init) ||
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_stmt_has_option(g, depth + 1, step) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_option(g, depth + 1, a) ||
      qbe_expr_has_option(g, depth + 1, b) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SForIn(_, _, it, body, _) =>
      qbe_expr_has_option(g, depth + 1, it) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_option(g, depth + 1, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_expr_has_option(g, depth + 1, m)
    SExpr(e, _) => qbe_expr_has_option(g, depth + 1, e)
  }
}

///|
fn qbe_stmts_have_option(g : QbeGen, depth : Int, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_option(g, depth, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_fn_uses_option_depth(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  depth : Int,
) -> Bool {
  if depth > 16 {
    return false
  }
  let fd = finfo.decl
  let saved_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, mpkg)
  if qbe_ty_has_option(g, finfo.ret_ty, 0) ||
    qbe_type_expr_has_option(g, fd.ret_ty, 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  let mut i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_option(g, finfo.param_tys[i], 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  i = 0
  while i < fd.params.length() {
    if qbe_type_expr_has_option(g, fd.params[i].ty, 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  let body_has = qbe_stmts_have_option(g, depth, fd.body)
  g.mono_pkg = saved_pkg
  body_has
}

///|
fn qbe_fn_uses_option(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  qbe_fn_uses_option_depth(g, finfo, mpkg, 0)
}

///|
fn qbe_ty_needs_deep_freeze(g : QbeGen, raw_ty : Ty, depth : Int) -> Bool {
  if depth > 12 {
    return false
  }
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TDynTrait(_) => true
    TOption(inner) =>
      if qbe_is_niche_opt_inner(g, inner) {
        qbe_ty_needs_deep_freeze(g, inner, depth + 1)
      } else {
        qbe_is_obj_ty(g, inner)
      }
    TResult(ok_ty, err_ty) => qbe_is_obj_ty(g, ok_ty) || qbe_is_obj_ty(g, err_ty)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_is_obj_ty(g, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            let fty = subst_ty(sinfo.field_tys[fi], subst)
            if qbe_is_obj_ty(g, fty) {
              return true
            }
            fi = fi + 1
          }
          false
        }
        None => false
      }
    TEnum(ename, eargs) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              let fty = subst_ty(v.field_tys[fi], subst)
              if qbe_is_obj_ty(g, fty) {
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          false
        }
        None => false
      }
    TArray(elem) | TFixedArray(elem) | TImmArray(elem) => qbe_is_obj_ty(g, elem)
    TMap(_, vty) => qbe_is_obj_ty(g, vty)
    _ => false
  }
}

///|
fn qbe_ty_has_sync_or_container(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 12 {
    return false
  }
  match ty {
    TMutex(_) | TChannel(_) | TArray(_) | TFixedArray(_) | TImmArray(_) | TMap(_, _) => true
    TOption(e) => qbe_ty_has_sync_or_container(g, e, depth + 1)
    TResult(a, b) =>
      qbe_ty_has_sync_or_container(g, a, depth + 1) ||
      qbe_ty_has_sync_or_container(g, b, depth + 1)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_sync_or_container(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_sync_or_container(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_sync_or_container(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      let mut i = 0
      while i < sargs.length() {
        if qbe_ty_has_sync_or_container(g, sargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let qp = split_qual_name(sname)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_sync_or_container(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TEnum(ename, eargs) => {
      let mut i = 0
      while i < eargs.length() {
        if qbe_ty_has_sync_or_container(g, eargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let qp = split_qual_name(ename)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_sync_or_container(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_type_expr_has_sync_or_container(
  g : QbeGen,
  te : TypeExpr,
  depth : Int,
) -> Bool {
  if depth > 12 {
    return false
  }
  match te {
    TyName(name, args, _) => {
      if name == "Mutex" ||
        name == "Channel" ||
        name == "Array" ||
        name == "FixedArray" ||
        name == "ImmArray" ||
        name == "Map" {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_type_expr_has_sync_or_container(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, name) {
        Some(sinfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_sync_or_container(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      match qbe_lookup_enum_info(g, name) {
        Some(einfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_sync_or_container(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_type_expr_has_sync_or_container(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      if qbe_type_expr_has_sync_or_container(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_sync_or_container(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_expr_has_sync_or_container(g : QbeGen, depth : Int, e : Expr) -> Bool {
  if depth > 16 {
    return false
  }
  match e {
    EScope(_, _, _) | ESpawn(_, _, _) => true
    EPath(qual, _, _) => qual == "Mutex" || qual == "Channel"
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EUnit(_) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | ETry(inner, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, inner)
    EAs(inner, ty, _) =>
      qbe_type_expr_has_sync_or_container(g, ty, 0) ||
      qbe_expr_has_sync_or_container(g, depth + 1, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, l) ||
      qbe_expr_has_sync_or_container(g, depth + 1, r)
    ECall(callee, args, _) => {
      if qbe_expr_has_sync_or_container(g, depth + 1, callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_sync_or_container(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if mname == "push" ||
        mname == "set" ||
        mname == "send" ||
        mname == "with_lock" {
        return true
      }
      if qbe_expr_has_sync_or_container(g, depth + 1, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_sync_or_container(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_sync_or_container(g, depth + 1, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if qbe_expr_has_sync_or_container(g, depth + 1, b) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_sync_or_container(g, depth + 1, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_sync_or_container(g, depth + 1, stmts)
    EIf(cond, then_s, else_opt, _) => {
      if qbe_expr_has_sync_or_container(g, depth + 1, cond) ||
        qbe_stmts_have_sync_or_container(g, depth + 1, then_s) {
        return true
      }
      match else_opt {
        Some(ee) => qbe_expr_has_sync_or_container(g, depth + 1, ee)
        None => false
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_sync_or_container(g, depth + 1, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_sync_or_container(g, depth + 1, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_sync_or_container(g, depth + 1, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_sync_or_container(g, depth + 1, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(ps, rty, body, _) => {
      if qbe_type_expr_has_sync_or_container(g, rty, 0) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_sync_or_container(g, ps[i].ty, 0) {
          return true
        }
        i = i + 1
      }
      qbe_stmts_have_sync_or_container(g, depth + 1, body)
    }
  }
}

///|
fn qbe_stmt_has_sync_or_container(g : QbeGen, depth : Int, st : Stmt) -> Bool {
  if depth > 16 {
    return false
  }
  match st {
    SLet(_, _, ty, init, _) | SLetTuple(_, ty, init, _) =>
      qbe_type_expr_has_sync_or_container(g, ty, 0) ||
      qbe_expr_has_sync_or_container(g, depth + 1, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, l) ||
      qbe_expr_has_sync_or_container(g, depth + 1, r)
    SWhile(c, body, _) | SGuard(c, body, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, c) ||
      qbe_stmts_have_sync_or_container(g, depth + 1, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_sync_or_container(g, depth + 1, init) ||
      qbe_expr_has_sync_or_container(g, depth + 1, c) ||
      qbe_stmt_has_sync_or_container(g, depth + 1, step) ||
      qbe_stmts_have_sync_or_container(g, depth + 1, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, a) ||
      qbe_expr_has_sync_or_container(g, depth + 1, b) ||
      qbe_stmts_have_sync_or_container(g, depth + 1, body)
    SForIn(_, _, it, body, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, it) ||
      qbe_stmts_have_sync_or_container(g, depth + 1, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_sync_or_container(g, depth + 1, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_sync_or_container(g, depth + 1, c) ||
      qbe_expr_has_sync_or_container(g, depth + 1, m)
    SExpr(e, _) => qbe_expr_has_sync_or_container(g, depth + 1, e)
  }
}

///|
fn qbe_stmts_have_sync_or_container(
  g : QbeGen,
  depth : Int,
  stmts : Array[Stmt],
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_sync_or_container(g, depth, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_fn_uses_sync_or_container(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
) -> Bool {
  let fd = finfo.decl
  let saved_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, mpkg)
  if qbe_ty_has_sync_or_container(g, finfo.ret_ty, 0) ||
    qbe_type_expr_has_sync_or_container(g, fd.ret_ty, 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  let mut i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_sync_or_container(g, finfo.param_tys[i], 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  i = 0
  while i < fd.params.length() {
    if qbe_type_expr_has_sync_or_container(g, fd.params[i].ty, 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  let body_has = qbe_stmts_have_sync_or_container(g, 0, fd.body)
  g.mono_pkg = saved_pkg
  body_has
}

///|
fn qbe_ty_has_map(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 12 {
    return false
  }
  match ty {
    TMap(_, _) => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      qbe_ty_has_map(g, e, depth + 1)
    TResult(a, b) =>
      qbe_ty_has_map(g, a, depth + 1) || qbe_ty_has_map(g, b, depth + 1)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_map(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_map(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_map(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      let mut i = 0
      while i < sargs.length() {
        if qbe_ty_has_map(g, sargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let qp = split_qual_name(sname)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_map(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TEnum(ename, eargs) => {
      let mut i = 0
      while i < eargs.length() {
        if qbe_ty_has_map(g, eargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let qp = split_qual_name(ename)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_map(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_type_expr_has_map(g : QbeGen, te : TypeExpr, depth : Int) -> Bool {
  if depth > 12 {
    return false
  }
  match te {
    TyName(name, args, _) => {
      if name == "Map" {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_type_expr_has_map(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, name) {
        Some(sinfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_map(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      match qbe_lookup_enum_info(g, name) {
        Some(einfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_map(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_type_expr_has_map(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      if qbe_type_expr_has_map(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_map(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_expr_has_map(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  e : Expr,
) -> Bool {
  if depth > 16 || call_depth > 6 {
    return true
  }
  match e {
    EPath(qual, _, _) => qual == "Map"
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EUnit(_) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | ETry(inner, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) => qbe_expr_has_map(g, depth + 1, call_depth, visited, inner)
    EAs(inner, ty, _) =>
      qbe_type_expr_has_map(g, ty, 0) || qbe_expr_has_map(g, depth + 1, call_depth, visited, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, l) ||
      qbe_expr_has_map(g, depth + 1, call_depth, visited, r)
    ECall(callee, args, _) => {
      match callee {
        EIdent(cname, _) => {
          if cname == "Map" {
            return true
          }
          let cf_opt : Option[FnInfo] = if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) => ipkg.tc.fns.get(cname)
              None => g.tc.fns.get(cname)
            }
          } else {
            g.tc.fns.get(cname)
          }
          match cf_opt {
            Some(cf) =>
              if cf.decl.type_params.length() > 0 &&
                qbe_fn_uses_map_inner(g, cf, g.mono_pkg, call_depth + 1, visited) {
                return true
              }
            None => ()
          }
        }
        EPath(qual, mem, _) => {
          if qual == "Map" {
            return true
          }
          let mut cf_opt : Option[FnInfo] = None
          let mut cf_pkg = g.mono_pkg
          let mkey = qual + "::" + mem
          if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(mpkg_info) =>
                match mpkg_info.tc.methods.get(mkey) {
                  Some(mi) => cf_opt = Some(mi)
                  None =>
                    match resolve_alias_pkg(mpkg_info.tc, qual) {
                      Some(ipkg) =>
                        match ipkg.tc.fns.get(mem) {
                          Some(fi) => {
                            cf_opt = Some(fi)
                            cf_pkg = ipkg.name
                          }
                          None => ()
                        }
                      None => ()
                    }
                }
              None => ()
            }
          } else {
            match g.tc.methods.get(mkey) {
              Some(mi) => cf_opt = Some(mi)
              None =>
                match resolve_alias_pkg(g.tc, qual) {
                  Some(ipkg) =>
                    match ipkg.tc.fns.get(mem) {
                      Some(fi) => {
                        cf_opt = Some(fi)
                        cf_pkg = ipkg.name
                      }
                      None => ()
                    }
                  None => ()
                }
            }
          }
          match cf_opt {
            Some(cf) =>
              if cf.decl.type_params.length() > 0 &&
                qbe_fn_uses_map_inner(g, cf, cf_pkg, call_depth + 1, visited) {
                return true
              }
            None => ()
          }
        }
        _ => ()
      }
      if qbe_expr_has_map(g, depth + 1, call_depth, visited, callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_map(g, depth + 1, call_depth, visited, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if qbe_expr_has_map(g, depth + 1, call_depth, visited, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_map(g, depth + 1, call_depth, visited, args[i]) {
          return true
        }
        i = i + 1
      }
      match qbe_probe_expr_ty(g, obj) {
        Some(TStruct(sname, _)) | Some(TEnum(sname, _)) =>
          match qbe_lookup_method_info(g, sname, mname) {
            Some(mi) => {
              let qp = split_qual_name(sname)
              let mpkg = if qp.prefix != "" { qp.prefix } else { g.mono_pkg }
              if mi.decl.type_params.length() > 0 &&
                qbe_fn_uses_map_inner(g, mi, mpkg, call_depth + 1, visited) {
                return true
              }
            }
            None => ()
          }
        _ => ()
      }
      false
    }
    EArrayLit(elems, _)
    | ETuple(elems, _)
    | EInterp(elems, _)
    | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_map(g, depth + 1, call_depth, visited, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if qbe_expr_has_map(g, depth + 1, call_depth, visited, b) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_map(g, depth + 1, call_depth, visited, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_map(g, depth + 1, call_depth, visited, stmts)
    EIf(cond, then_s, else_opt, _) => {
      if qbe_expr_has_map(g, depth + 1, call_depth, visited, cond) ||
        qbe_stmts_have_map(g, depth + 1, call_depth, visited, then_s) {
        return true
      }
      match else_opt {
        Some(ee) => qbe_expr_has_map(g, depth + 1, call_depth, visited, ee)
        None => false
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_map(g, depth + 1, call_depth, visited, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_map(g, depth + 1, call_depth, visited, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_map(g, depth + 1, call_depth, visited, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_map(g, depth + 1, call_depth, visited, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(ps, rty, body, _) => {
      if qbe_type_expr_has_map(g, rty, 0) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_map(g, ps[i].ty, 0) {
          return true
        }
        i = i + 1
      }
      qbe_stmts_have_map(g, depth + 1, call_depth, visited, body)
    }
  }
}

///|
fn qbe_stmt_has_map(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  st : Stmt,
) -> Bool {
  if depth > 16 || call_depth > 6 {
    return true
  }
  match st {
    SLet(_, _, ty, init, _) | SLetTuple(_, ty, init, _) =>
      qbe_type_expr_has_map(g, ty, 0) || qbe_expr_has_map(g, depth + 1, call_depth, visited, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, l) ||
      qbe_expr_has_map(g, depth + 1, call_depth, visited, r)
    SWhile(c, body, _) | SGuard(c, body, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, c) ||
      qbe_stmts_have_map(g, depth + 1, call_depth, visited, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_map(g, depth + 1, call_depth, visited, init) ||
      qbe_expr_has_map(g, depth + 1, call_depth, visited, c) ||
      qbe_stmt_has_map(g, depth + 1, call_depth, visited, step) ||
      qbe_stmts_have_map(g, depth + 1, call_depth, visited, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, a) ||
      qbe_expr_has_map(g, depth + 1, call_depth, visited, b) ||
      qbe_stmts_have_map(g, depth + 1, call_depth, visited, body)
    SForIn(_, _, it, body, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, it) ||
      qbe_stmts_have_map(g, depth + 1, call_depth, visited, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_map(g, depth + 1, call_depth, visited, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_map(g, depth + 1, call_depth, visited, c) ||
      qbe_expr_has_map(g, depth + 1, call_depth, visited, m)
    SExpr(e, _) => qbe_expr_has_map(g, depth + 1, call_depth, visited, e)
  }
}

///|
fn qbe_stmts_have_map(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  stmts : Array[Stmt],
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_map(g, depth, call_depth, visited, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_fn_uses_map_inner(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  call_depth : Int,
  visited : Map[String, Bool],
) -> Bool {
  if call_depth > 6 {
    return true
  }
  let fd = finfo.decl
  let vkey = mpkg + "::" + fd.receiver_type + "::" + fd.name
  if visited.contains(vkey) {
    return false
  }
  visited.set(vkey, true)
  let saved_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, mpkg)
  if qbe_ty_has_map(g, finfo.ret_ty, 0) ||
    qbe_type_expr_has_map(g, fd.ret_ty, 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  let mut i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_map(g, finfo.param_tys[i], 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  i = 0
  while i < fd.params.length() {
    if qbe_type_expr_has_map(g, fd.params[i].ty, 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  let body_has = qbe_stmts_have_map(g, 0, call_depth, visited, fd.body)
  g.mono_pkg = saved_pkg
  body_has
}

///|
fn qbe_fn_uses_map(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  let visited : Map[String, Bool] = Map([])
  qbe_fn_uses_map_inner(g, finfo, mpkg, 0, visited)
}

///|
fn qbe_ty_has_array(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 8 {
    return true
  }
  match ty {
    TArray(_) | TFixedArray(_) | TImmArray(_) => true
    TOption(inner) | TChannel(inner) | TMutex(inner) =>
      qbe_ty_has_array(g, inner, depth + 1)
    TResult(ok_t, err_t) =>
      qbe_ty_has_array(g, ok_t, depth + 1) ||
      qbe_ty_has_array(g, err_t, depth + 1)
    TMap(k, v) =>
      qbe_ty_has_array(g, k, depth + 1) || qbe_ty_has_array(g, v, depth + 1)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_array(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_array(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_array(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(name, targs) => {
      let mut i = 0
      while i < targs.length() {
        if qbe_ty_has_array(g, targs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, name) {
        Some(sinfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_array(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TEnum(name, targs) => {
      let mut i = 0
      while i < targs.length() {
        if qbe_ty_has_array(g, targs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_enum_info(g, name) {
        Some(einfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_array(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_type_expr_has_array(g : QbeGen, te : TypeExpr, depth : Int) -> Bool {
  if depth > 8 {
    return true
  }
  match te {
    TyName(name, targs, _) => {
      if name == "Array" || name == "FixedArray" || name == "ImmArray" {
        return true
      }
      let mut i = 0
      while i < targs.length() {
        if qbe_type_expr_has_array(g, targs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, name) {
        Some(sinfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_array(g, sinfo.field_tys[fi], depth + 1) {
              g.mono_pkg = saved_pkg
              return true
            }
            fi = fi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      match qbe_lookup_enum_info(g, name) {
        Some(einfo) => {
          let qp = split_qual_name(name)
          let saved_pkg = g.mono_pkg
          if qp.prefix != "" {
            g.mono_pkg = qbe_norm_mono_pkg(g, qp.prefix)
          }
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_array(g, v.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          g.mono_pkg = saved_pkg
        }
        None => ()
      }
      false
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_type_expr_has_array(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      if qbe_type_expr_has_array(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_array(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_is_prim_scalar_ty(ty : Ty) -> Bool {
  match ty {
    TInt | TUInt | TInt64 | TUInt64 | TByte | TInt8 | TChar | TBool | TFloat | TDouble =>
      true
    _ => false
  }
}

///|
fn qbe_is_builtin_scalar_method_for(ty : Ty, mname : String) -> Bool {
  match ty {
    TInt =>
      mname == "to_string" ||
      mname == "to_int64" ||
      mname == "to_int" ||
      mname == "to_uint" ||
      mname == "reinterpret_as_uint" ||
      mname == "to_double" ||
      mname == "to_float" ||
      mname == "abs" ||
      mname == "unsafe_to_char" ||
      mname == "to_byte" ||
      mname == "to_int8" ||
      mname == "count_ones" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "rotate_left" ||
      mname == "rotate_right" ||
      mname == "lnot"
    TInt64 =>
      mname == "to_string" ||
      mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_uint64" ||
      mname == "reinterpret_as_uint64" ||
      mname == "to_double" ||
      mname == "abs" ||
      mname == "to_int8" ||
      mname == "count_ones" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "rotate_left" ||
      mname == "rotate_right" ||
      mname == "lnot"
    TUInt =>
      mname == "to_string" ||
      mname == "to_int" ||
      mname == "reinterpret_as_int" ||
      mname == "to_uint" ||
      mname == "to_int64" ||
      mname == "to_uint64" ||
      mname == "to_double" ||
      mname == "to_float" ||
      mname == "reinterpret_as_float" ||
      mname == "to_int8" ||
      mname == "count_ones" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "rotate_left" ||
      mname == "rotate_right" ||
      mname == "lnot"
    TUInt64 =>
      mname == "to_string" ||
      mname == "to_int" ||
      mname == "to_uint" ||
      mname == "to_int64" ||
      mname == "reinterpret_as_int64" ||
      mname == "to_uint64" ||
      mname == "to_double" ||
      mname == "reinterpret_as_double" ||
      mname == "to_int8" ||
      mname == "count_ones" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "rotate_left" ||
      mname == "rotate_right" ||
      mname == "lnot"
    TDouble =>
      mname == "to_string" ||
      mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_float" ||
      mname == "to_int8" ||
      mname == "to_bits" ||
      mname == "reinterpret_as_int64" ||
      mname == "reinterpret_as_uint64" ||
      mname == "is_nan" ||
      mname == "is_inf" ||
      mname == "is_finite" ||
      mname == "compare" ||
      mname == "sqrt" ||
      mname == "cbrt" ||
      mname == "abs" ||
      mname == "floor" ||
      mname == "ceil" ||
      mname == "round" ||
      mname == "trunc" ||
      mname == "pow" ||
      mname == "exp" ||
      mname == "ln" ||
      mname == "sin" ||
      mname == "cos" ||
      mname == "tan" ||
      mname == "atan2" ||
      mname == "asin" ||
      mname == "acos" ||
      mname == "atan"
    TFloat =>
      mname == "to_string" ||
      mname == "to_double" ||
      mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_int8" ||
      mname == "to_bits" ||
      mname == "reinterpret_as_int" ||
      mname == "reinterpret_as_uint" ||
      mname == "is_nan" ||
      mname == "is_inf" ||
      mname == "is_finite" ||
      mname == "abs" ||
      mname == "sqrt" ||
      mname == "cbrt" ||
      mname == "floor" ||
      mname == "ceil" ||
      mname == "round" ||
      mname == "trunc" ||
      mname == "pow" ||
      mname == "exp" ||
      mname == "ln" ||
      mname == "sin" ||
      mname == "cos" ||
      mname == "tan" ||
      mname == "atan2" ||
      mname == "asin" ||
      mname == "acos" ||
      mname == "atan"
    TBool => mname == "to_string"
    TChar => mname == "to_int" || mname == "to_string"
    TByte => mname == "to_int" || mname == "to_int8"
    TInt8 =>
      mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_uint" ||
      mname == "to_uint64" ||
      mname == "to_byte" ||
      mname == "to_float" ||
      mname == "to_double" ||
      mname == "to_string" ||
      mname == "to_int8" ||
      mname == "abs" ||
      mname == "min" ||
      mname == "max" ||
      mname == "clamp"
    _ => false
  }
}

///|
fn qbe_stmts_rebind_name(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(n, _, _, init, _) =>
        if n == name || qbe_expr_rebinds_ident(init, name) {
          return true
        }
      SLetTuple(ns, _, init, _) => {
        let mut ni = 0
        while ni < ns.length() {
          if ns[ni] == name {
            return true
          }
          ni = ni + 1
        }
        if qbe_expr_rebinds_ident(init, name) {
          return true
        }
      }
      SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
        if qbe_expr_rebinds_ident(l, name) || qbe_expr_rebinds_ident(r, name) {
          return true
        }
      SWhile(c, body, _) | SGuard(c, body, _) =>
        if qbe_expr_rebinds_ident(c, name) || qbe_stmts_rebind_name(body, name) {
          return true
        }
      SFor(init, c, step, body, _) =>
        if qbe_stmts_rebind_name([init], name) ||
          qbe_expr_rebinds_ident(c, name) ||
          qbe_stmts_rebind_name([step], name) ||
          qbe_stmts_rebind_name(body, name) {
          return true
        }
      SForRange(v, a, b, _, body, _) =>
        if v == name ||
          qbe_expr_rebinds_ident(a, name) ||
          qbe_expr_rebinds_ident(b, name) ||
          qbe_stmts_rebind_name(body, name) {
          return true
        }
      SForIn(v1, v2, it, body, _) =>
        if v1 == name ||
          v2 == name ||
          qbe_expr_rebinds_ident(it, name) ||
          qbe_stmts_rebind_name(body, name) {
          return true
        }
      SReturn(ro, _) =>
        match ro {
          Some(re) => if qbe_expr_rebinds_ident(re, name) { return true }
          None => ()
        }
      SDebugAssert(c, m, _) =>
        if qbe_expr_rebinds_ident(c, name) || qbe_expr_rebinds_ident(m, name) {
          return true
        }
      SExpr(e, _) => if qbe_expr_rebinds_ident(e, name) { return true }
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_has_array_layout(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  scalar_params : Map[String, Ty],
  e : Expr,
) -> Bool {
  if depth > 16 {
    return true
  }
  match e {
    EArrayLit(_, _) | EIndex(_, _, _) => true
    EPath(qual, _, _) => qual == "Array" || qual == "FixedArray" || qual == "ImmArray"
    EMethodCall(recv, mname, args, _) => {
      let recv_scalar_ty : Option[Ty] = match recv {
        EInt(_, _) => Some(TInt)
        EInt64(_, _) => Some(TInt64)
        EUInt(_, _) => Some(TUInt)
        EUInt64(_, _) => Some(TUInt64)
        EDouble(_, _) => Some(TDouble)
        EFloat(_, _) => Some(TFloat)
        EBool(_, _) => Some(TBool)
        EByte(_, _) => Some(TByte)
        EChar(_, _) => Some(TChar)
        EIdent(vn, _) => scalar_params.get(vn)
        _ => None
      }
      let is_builtin_scalar = match recv_scalar_ty {
        Some(rty) => qbe_is_builtin_scalar_method_for(rty, mname)
        None => false
      }
      if is_builtin_scalar {
        if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, recv) {
          return true
        }
        let mut i = 0
        while i < args.length() {
          if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, args[i]) {
            return true
          }
          i = i + 1
        }
        false
      } else {
        true
      }
    }
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EUnit(_) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | ETry(inner, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, inner)
    EAs(inner, ty, _) =>
      qbe_type_expr_has_array(g, ty, 0) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, inner)
    EBinary(_, l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, l) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, r)
    ECall(callee, args, _) => {
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, args[i]) {
          return true
        }
        i = i + 1
      }
      match callee {
        EIdent(fnm, _) => {
          let cur_tc = if g.mono_pkg != "" {
            match g.tc.imported_pkgs.get(g.mono_pkg) {
              Some(ipkg) => ipkg.tc
              None => g.tc
            }
          } else {
            g.tc
          }
          match cur_tc.fns.get(fnm) {
            Some(cfi) =>
              if cfi.decl.type_params.length() > 0 {
                qbe_fn_uses_array_layout_inner(g, cfi, g.mono_pkg, call_depth + 1, visited)
              } else {
                false
              }
            None =>
              // Unresolved callee (e.g. closure parameter or builtin): conservative.
              fnm != "Some" && fnm != "Ok" && fnm != "Err" && fnm != "panic"
          }
        }
        EPath(qual, fnm, _) => {
          if qual == "Array" || qual == "FixedArray" || qual == "ImmArray" {
            return true
          }
          if qual == "Option" || qual == "Result" {
            return false
          }
          let cur_tc = if g.mono_pkg != "" {
            match g.tc.imported_pkgs.get(g.mono_pkg) {
              Some(ipkg) => ipkg.tc
              None => g.tc
            }
          } else {
            g.tc
          }
          let real_pkg = match cur_tc.import_aliases.get(qual) {
            Some(pn) => pn
            None => qual
          }
          let target_pkg_opt = match cur_tc.imported_pkgs.get(real_pkg) {
            Some(ip) => Some(ip)
            None => g.tc.all_imported_pkgs.get(real_pkg)
          }
          match target_pkg_opt {
            Some(ipkg) =>
              match ipkg.tc.fns.get(fnm) {
                Some(cfi) =>
                  if cfi.decl.type_params.length() > 0 {
                    qbe_fn_uses_array_layout_inner(g, cfi, ipkg.name, call_depth + 1, visited)
                  } else {
                    false
                  }
                None => true
              }
            None => true
          }
        }
        _ => true
      }
    }
    ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, b) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) =>
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, stmts)
    EIf(cond, then_s, else_opt, _) => {
      if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, cond) ||
        qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, then_s) {
        return true
      }
      match else_opt {
        Some(ee) => qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, ee)
        None => false
      }
    }
    EIs(scrut, _, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(ps, rty, body, _) => {
      if qbe_type_expr_has_array(g, rty, 0) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_array(g, ps[i].ty, 0) {
          return true
        }
        i = i + 1
      }
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, Map([]), body)
    }
  }
}

///|
fn qbe_stmt_has_array_layout(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  scalar_params : Map[String, Ty],
  st : Stmt,
) -> Bool {
  if depth > 16 {
    return true
  }
  match st {
    SLet(_, _, ty, init, _) | SLetTuple(_, ty, init, _) =>
      qbe_type_expr_has_array(g, ty, 0) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, l) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, r)
    SWhile(c, body, _) | SGuard(c, body, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, c) ||
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, init) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, c) ||
      qbe_stmt_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, step) ||
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, a) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, b) ||
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, body)
    SForIn(_, _, it, body, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, it) ||
      qbe_stmts_have_array_layout(g, depth + 1, call_depth, visited, scalar_params, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, c) ||
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, m)
    SExpr(e, _) =>
      qbe_expr_has_array_layout(g, depth + 1, call_depth, visited, scalar_params, e)
  }
}

///|
fn qbe_stmts_have_array_layout(
  g : QbeGen,
  depth : Int,
  call_depth : Int,
  visited : Map[String, Bool],
  scalar_params : Map[String, Ty],
  stmts : Array[Stmt],
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_array_layout(g, depth, call_depth, visited, scalar_params, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_fn_uses_array_layout_inner(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  call_depth : Int,
  visited : Map[String, Bool],
) -> Bool {
  if call_depth > 6 {
    return true
  }
  let fd = finfo.decl
  let vkey = mpkg + "::" + fd.name
  if visited.contains(vkey) {
    return false
  }
  visited.set(vkey, true)
  let saved_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, mpkg)
  if qbe_ty_has_array(g, finfo.ret_ty, 0) ||
    qbe_type_expr_has_array(g, fd.ret_ty, 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  let scalar_params : Map[String, Ty] = Map([])
  let mut i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_array(g, finfo.param_tys[i], 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    if i < fd.params.length() &&
      qbe_is_prim_scalar_ty(finfo.param_tys[i]) &&
      !qbe_stmts_rebind_name(fd.body, fd.params[i].name) {
      scalar_params.set(fd.params[i].name, finfo.param_tys[i])
    }
    i = i + 1
  }
  i = 0
  while i < fd.params.length() {
    if qbe_type_expr_has_array(g, fd.params[i].ty, 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  let body_has = qbe_stmts_have_array_layout(g, 0, call_depth, visited, scalar_params, fd.body)
  g.mono_pkg = saved_pkg
  body_has
}

///|
fn qbe_fn_uses_array_layout(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  let visited : Map[String, Bool] = Map([])
  qbe_fn_uses_array_layout_inner(g, finfo, mpkg, 0, visited)
}

///|
fn qbe_ty_has_flat_struct(g : QbeGen, raw_ty : Ty, depth : Int) -> Bool {
  if depth > 6 {
    return true
  }
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  if qbe_flat_pod_stride(g, ty) > 0 {
    return true
  }
  match ty {
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      qbe_ty_has_flat_struct(g, e, depth + 1)
    TResult(a, b) | TMap(a, b) =>
      qbe_ty_has_flat_struct(g, a, depth + 1) || qbe_ty_has_flat_struct(g, b, depth + 1)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if qbe_ty_has_flat_struct(g, es[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_flat_struct(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      qbe_ty_has_flat_struct(g, r, depth + 1)
    }
    TStruct(sname, args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_flat_struct(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let fsubst = make_subst(sinfo.decl.type_params, args)
          i = 0
          while i < sinfo.field_tys.length() {
            if qbe_ty_has_flat_struct(g, subst_ty(sinfo.field_tys[i], fsubst), depth + 1) {
              return true
            }
            i = i + 1
          }
          false
        }
        None => false
      }
    }
    TEnum(_, args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_flat_struct(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_fn_has_op_tparams(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  let fk = span_key(finfo.decl.span)
  match g.tc.op_tparams.get(fk) {
    Some(tps) => if tps.length() > 0 { return true }
    None => ()
  }
  if mpkg != "" {
    match g.tc.all_imported_pkgs.get(mpkg) {
      Some(ipkg) =>
        match ipkg.tc.op_tparams.get(fk) {
          Some(tps) => if tps.length() > 0 { return true }
          None => ()
        }
      None => ()
    }
  }
  false
}

///|
fn qbe_call_needs_mono(
  g : QbeGen,
  finfo : FnInfo,
  subst : Map[String, Ty],
  mpkg : String,
) -> Bool {
  let fd = finfo.decl
  if fd.type_bounds.length() > 0 {
    return true
  }
  if fd.type_params.length() == 0 {
    return false
  }
  let mut i = 0
  while i < fd.type_params.length() {
    match subst.get(fd.type_params[i]) {
      Some(t) =>
        if qbe_ty_has_param(t) {
          return false
        }
      None => return false
    }
    i = i + 1
  }
  if qbe_fn_body_has_eq(g, finfo, mpkg) ||
    qbe_fn_has_op_tparams(g, finfo, mpkg) ||
    qbe_fn_body_has_arith(g, finfo, mpkg) ||
    qbe_fn_uses_option(g, finfo, mpkg) ||
    qbe_fn_uses_map(g, finfo, mpkg) {
    return true
  }
  let saved_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, mpkg)
  if qbe_ty_has_flat_struct(g, subst_ty(finfo.ret_ty, subst), 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_flat_struct(g, subst_ty(finfo.param_tys[i], subst), 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  g.mono_pkg = saved_pkg
  let mut has_deep = false
  let mut has_4b_int = false
  i = 0
  while i < fd.type_params.length() {
    match subst.get(fd.type_params[i]) {
      Some(t) => {
        if qbe_is_u8_array_elem(g, t) ||
          (qbe_is_4b_array_elem(g, t) && !qbe_is_4b_int_array_elem(g, t)) ||
          qbe_ty_has_flat_struct(g, t, 0) ||
          qbe_ty_has_vmap(g, t, 0) {
          return true
        }
        if qbe_is_4b_int_array_elem(g, t) {
          has_4b_int = true
        }
        if qbe_ty_needs_deep_freeze(g, t, 0) {
          has_deep = true
        }
      }
      None => ()
    }
    i = i + 1
  }
  if has_4b_int && qbe_fn_uses_array_layout(g, finfo, mpkg) {
    return true
  }
  has_deep && qbe_fn_uses_sync_or_container(g, finfo, mpkg)
}

///|
/// Expected type for an argument of a call to `finfo`. For an unbounded generic
/// that compares its type params or uses `Option[T]` (monomorphized per call),
/// a parameter type still naming an unbound type param is no hint: the argument
/// infers its own concrete type (`count_same(["a"], "a")` binds `U = String`).
fn qbe_generic_arg_expect(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  pty : Ty,
  arg : Expr,
) -> Option[Ty] {
  let fd = finfo.decl
  if fd.type_params.length() == 0 ||
    fd.type_bounds.length() > 0 ||
    !qbe_ty_has_param(pty) {
    return Some(pty)
  }
  let self_inferring = match arg {
    EArrayLit(elems, _) => elems.length() > 0
    EIdent(n, _) => n != "None"
    EUnit(_) => false
    _ => true
  }
  if self_inferring &&
    (
      qbe_fn_body_has_eq(g, finfo, mpkg) ||
      qbe_fn_has_op_tparams(g, finfo, mpkg) ||
      qbe_fn_body_has_arith(g, finfo, mpkg) ||
      qbe_fn_uses_option(g, finfo, mpkg) ||
      qbe_fn_uses_map(g, finfo, mpkg)
    ) {
    None
  } else {
    Some(pty)
  }
}

///|
fn qbe_ty_has_param(t : Ty) -> Bool {
  match t {
    TParam(_) | TError => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) => qbe_ty_has_param(e)
    TResult(a, b) | TMap(a, b) => qbe_ty_has_param(a) || qbe_ty_has_param(b)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_param(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_param(r) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_param(ps[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
/// Root local of a `mut <place>` argument (`x`, `x.f.g`, `a[i]` → `x` / `a`),
/// or "" when the expression is not a place.
fn qbe_mut_place_root(e : Expr) -> String {
  match e {
    EIdent(n, _) => n
    EField(o, _, _) => qbe_mut_place_root(o)
    EIndex(o, _, _) => qbe_mut_place_root(o)
    _ => ""
  }
}

///|
/// Every field name written through a `mut <place>` argument path.
fn qbe_mut_place_fields(e : Expr, out : Map[String, Bool]) -> Unit {
  match e {
    EField(o, f, _) => {
      out.set(f, true)
      qbe_mut_place_fields(o, out)
    }
    EIndex(o, _, _) => qbe_mut_place_fields(o, out)
    _ => ()
  }
}

///|
fn qbe_expr_has_assign(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EMutArg(_, _) | EMove(_, _) => true
    EUnary(_, inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_assign(inner)
    EBinary(_, l, r, _) => {
      let work : Array[Expr] = [r, l]
      while work.length() > 0 {
        match work.pop() {
          Some(cur) =>
            match cur {
              EBinary(_, cl, cr, _) => {
                work.push(cr)
                work.push(cl)
              }
              _ =>
                if qbe_expr_has_assign(cur) {
                  return true
                }
            }
          None => break
        }
      }
      false
    }
    EField(o, _, _) => qbe_expr_has_assign(o)
    EIndex(o, i, _) => qbe_expr_has_assign(o) || qbe_expr_has_assign(i)
    ECall(callee, args, _) => {
      if qbe_expr_has_assign(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_assign(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_assign(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_assign(b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_assign(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_assign(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_assign(cond) || qbe_stmts_have_assign(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_assign(el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_assign(scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_assign(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_assign(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_assign(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      true
  }
}

///|
fn qbe_stmts_have_assign(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SExpr(e, _) =>
        if qbe_expr_has_assign(e) {
          return true
        }
      _ => return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_pure_idx_key(e : Expr) -> String {
  match e {
    EIdent(v, _) => "v:" + v
    EBinary(op, EIdent(v, _), EInt(raw, _), _) =>
      if op == "+" || op == "-" {
        op + ":" + v + ":" + qbe_parse_int64_lit(raw).to_string()
      } else {
        ""
      }
    EBinary(op, EIdent(v1, _), EIdent(v2, _), _) =>
      if op == "+" || op == "-" {
        op + ":" + v1 + ":v:" + v2
      } else {
        ""
      }
    _ => ""
  }
}

///|
fn qbe_expr_has_same_index(e : Expr, arr : String, key : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_same_index(inner, arr, key)
    EBinary(_, l, r, _) =>
      qbe_expr_has_same_index(l, arr, key) || qbe_expr_has_same_index(r, arr, key)
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) =>
          if aname == arr && qbe_pure_idx_key(idx) == key {
            return true
          }
        _ => ()
      }
      qbe_expr_has_same_index(obj, arr, key) || qbe_expr_has_same_index(idx, arr, key)
    }
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_same_index(cond, arr, key) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        match then_stmts[i] {
          SExpr(se, _) =>
            if qbe_expr_has_same_index(se, arr, key) {
              return true
            }
          _ => ()
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_same_index(el, arr, key)
      }
    }
    EBlock(stmts, _) => {
      let mut i = 0
      while i < stmts.length() {
        match stmts[i] {
          SExpr(se, _) =>
            if qbe_expr_has_same_index(se, arr, key) {
              return true
            }
          _ => ()
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_args_have_assign(args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    if qbe_expr_has_assign(args[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Stronger call-window mutation check: catches everything `qbe_expr_has_assign`
/// catches plus any `EMethodCall` whose receiver root is a mutable local, `mut`
/// parameter, or boxed cell (protecting against `mut self` methods even when not
/// pre-lowered to `EMutArg`).
fn qbe_expr_may_mutate_locals(g : QbeGen, e : Expr) -> Bool {
  if qbe_expr_has_assign(e) {
    return true
  }
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EMutArg(_, _) | EMove(_, _) => true
    EUnary(_, inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) | EField(inner, _, _) =>
      qbe_expr_may_mutate_locals(g, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_may_mutate_locals(g, l) || qbe_expr_may_mutate_locals(g, r)
    ECall(callee, args, _) =>
      qbe_expr_may_mutate_locals(g, callee) || qbe_args_may_mutate_locals(g, args)
    EMethodCall(obj, _, args, _) => {
      let rname = qbe_mut_place_root(obj)
      if rname != "" {
        match qbe_lookup_local(g, rname) {
          Some(rloc) =>
            if rloc.is_cell || rloc.ref_slot != "" || g.mut_local_slots.contains(rloc.slot) {
              return true
            }
          None => ()
        }
      }
      qbe_expr_may_mutate_locals(g, obj) || qbe_args_may_mutate_locals(g, args)
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) =>
      qbe_args_may_mutate_locals(g, elems)
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_may_mutate_locals(g, b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_may_mutate_locals(g, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EIf(cond, then_stmts, else_opt, _) =>
      if qbe_expr_may_mutate_locals(g, cond) ||
        qbe_stmts_may_mutate_locals(g, then_stmts) {
        true
      } else {
        match else_opt {
          Some(el) => qbe_expr_may_mutate_locals(g, el)
          None => false
        }
      }
    EIs(scrut, _, _) => qbe_expr_may_mutate_locals(g, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_may_mutate_locals(g, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_may_mutate_locals(g, ge) { return true }
          None => ()
        }
        if qbe_expr_may_mutate_locals(g, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(_, _) | EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) => true
  }
}

///|
fn qbe_stmts_may_mutate_locals(g : QbeGen, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SExpr(e, _) =>
        if qbe_expr_may_mutate_locals(g, e) {
          return true
        }
      _ => return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_args_may_mutate_locals(g : QbeGen, args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    if qbe_expr_may_mutate_locals(g, args[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
///|
fn qbe_try_emit_borrowed_arr_elem(
  g : QbeGen,
  aname : String,
  idx_expr : Expr,
) -> Option[QbeVal] {
  if qbe_expr_has_assign(idx_expr) ||
    qbe_expr_assigns_ident(idx_expr, aname) ||
    !qbe_loop_has_no_calls_expr(g, idx_expr) {
    return None
  }
  match qbe_lookup_local(g, aname) {
    Some(aloc) =>
      if aloc.is_cell {
        None
      } else {
      match aloc.ty {
        TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
          let arr_p = if g.hoisted_arr_len.contains(aname) &&
            g.hoisted_arr_dp.contains(aname) {
            "0"
          } else {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l loadl " + aloc.slot)
            r
          }
          let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
          let il = qbe_as_l(g, iv)
          if !qbe_bce_expr_is_safe(g, aname, idx_expr) {
            let alen = match g.hoisted_arr_len.get(aname) {
              Some(hlen) => hlen
              None => {
                let t = qbe_tmp(g)
                qbe_emit(g, t + " =l loadl " + arr_p)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, qbe_arr_oob_lbl_prefix(g, elem))
            let l_ok = qbe_lbl(g, "arr_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let dp = match g.hoisted_arr_dp.get(aname) {
            Some(hdp) => hdp
            None => {
              let dp_p = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + arr_p + ", 24")
              qbe_emit(g, t + " =l loadl " + dp_p)
              t
            }
          }
          let flat_stride = qbe_flat_pod_stride(g, elem)
          if flat_stride > 0 {
            let ep = qbe_emit_arr_elem_addr(g, dp, il, flat_stride)
            Some(qval(ep, elem))
          } else {
            let ep = qbe_emit_arr_ep_ty(g, dp, il, elem)
            let ev = qbe_load_arr_elem(g, ep, elem)
            Some(qval(ev, elem))
          }
        }
        _ => None
      }
      }
    None => None
  }
}

///|
fn qbe_can_borrow_place(g : QbeGen, e : Expr) -> Option[Ty] {
  match e {
    EIdent(lname, _) =>
      match qbe_lookup_local(g, lname) {
        Some(loc) =>
          if !loc.is_cell {
            let lty = subst_ty(loc.ty, g.cur_type_subst)
            match lty {
              TStruct(_, _) | TTuple(_) => Some(lty)
              _ => None
            }
          } else {
            None
          }
        None => None
      }
    EIndex(EIdent(aname, _), idx_expr, _) => {
      if qbe_expr_has_assign(idx_expr) ||
        qbe_expr_assigns_ident(idx_expr, aname) ||
        !qbe_loop_has_no_calls_expr(g, idx_expr) {
        return None
      }
      match qbe_lookup_local(g, aname) {
        Some(aloc) =>
          if !aloc.is_cell {
            match subst_ty(aloc.ty, g.cur_type_subst) {
              TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                let ety = subst_ty(elem, g.cur_type_subst)
                match ety {
                  TStruct(_, _) | TTuple(_) => Some(ety)
                  _ => None
                }
              }
              _ => None
            }
          } else {
            None
          }
        None => None
      }
    }
    EField(inner, fname, _) => {
      match inner {
        EIdent(lname, _) =>
          if g.promoted_fields.contains(lname + "." + fname) {
            return None
          }
        _ => ()
      }
      match qbe_can_borrow_place(g, inner) {
        Some(TTuple(elems)) => {
          let idx = parse_tuple_index(fname)
          if idx >= 0 && idx < elems.length() {
            let fty = subst_ty(elems[idx], g.cur_type_subst)
            match fty {
              TStruct(_, _) | TTuple(_) => Some(fty)
              _ => None
            }
          } else {
            None
          }
        }
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut fi = 0
              while fi < sinfo.field_names.length() {
                if sinfo.field_names[fi] == fname {
                  let fty = subst_ty(
                    subst_ty(sinfo.field_tys[fi], subst),
                    g.cur_type_subst,
                  )
                  return match fty {
                    TStruct(_, _) | TTuple(_) => Some(fty)
                    _ => None
                  }
                }
                fi = fi + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    }
    _ => None
  }
}

///|
fn qbe_try_emit_borrowed_place(g : QbeGen, e : Expr) -> Option[QbeVal] {
  match qbe_can_borrow_place(g, e) {
    None => return None
    Some(_) => ()
  }
  match e {
    EIdent(lname, _) =>
      match qbe_lookup_local(g, lname) {
        Some(loc) => {
          let lty = subst_ty(loc.ty, g.cur_type_subst)
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =l loadl " + loc.slot)
          Some(qval(r, lty))
        }
        None => None
      }
    EIndex(EIdent(aname, _), idx_expr, _) =>
      match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
        Some(ev) => {
          let ety = subst_ty(ev.ty, g.cur_type_subst)
          Some(qval(ev.reg, ety))
        }
        None => None
      }
    EField(inner, fname, _) =>
      match qbe_try_emit_borrowed_place(g, inner) {
        Some(iv) =>
          match iv.ty {
            TTuple(elems) => {
              let idx = parse_tuple_index(fname)
              if idx >= 0 && idx < elems.length() {
                let fty = subst_ty(elems[idx], g.cur_type_subst)
                let p = qbe_tmp(g)
                qbe_emit(g, p + " =l add " + iv.reg + ", " + (idx * 8).to_string())
                let r = qbe_load_heap_slot(g, p, fty)
                Some(qval(r, fty))
              } else {
                None
              }
            }
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(
                        subst_ty(sinfo.field_tys[fi], subst),
                        g.cur_type_subst,
                      )
                      let p = qbe_tmp(g)
                      qbe_emit(g, p + " =l add " + iv.reg + ", " + (fi * 8).to_string())
                      let r = qbe_load_heap_slot(g, p, fty)
                      return Some(qval(r, fty))
                    }
                    fi = fi + 1
                  }
                  None
                }
                None => None
              }
            _ => None
          }
        None => None
      }
    _ => None
  }
}

///|
fn qbe_extract_field_chain(e : Expr, out_fields : Array[String]) -> String {
  match e {
    EIdent(name, _) => name
    EField(inner, fname, _) => {
      let root = qbe_extract_field_chain(inner, out_fields)
      if root == "" {
        ""
      } else {
        out_fields.push(fname)
        root
      }
    }
    _ => ""
  }
}

///|
/// Wave J2 Layer 2: borrow an arbitrary-depth immutable struct field chain
/// `root.f1.f2...` (depth >= 2; 1-level is handled by the existing fast path
/// with promoted/hoisted/block-cached field support). Every intermediate and
/// final field must be non-`mut`, no array indexing may appear on the path,
/// `root` must not be a boxed cell, and `root` must either be owned or chase
/// to a known non-array owner slot.
fn qbe_try_emit_borrowed_immut_field_chain(
  g : QbeGen,
  e : Expr,
) -> Option[QbeVal] {
  if (g.j2_disable_mask & 2) != 0 {
    return None
  }
  let fields : Array[String] = []
  let root_name = qbe_extract_field_chain(e, fields)
  if root_name == "" || fields.length() < 2 {
    return None
  }
  let loc = match qbe_lookup_local(g, root_name) {
    Some(l) => l
    None => return None
  }
  if loc.is_cell || loc.ref_slot != "" || g.mut_local_slots.contains(loc.slot) {
    return None
  }
  if !loc.owned {
    match g.borrow_owner_slot.get(loc.slot) {
      Some(os) =>
        if g.mut_local_slots.contains(os) {
          return None
        }
      None => return None
    }
  }
  let mut cur_ty = subst_ty(loc.ty, g.cur_type_subst)
  let offsets : Array[Int] = []
  let mut k = 0
  while k < fields.length() {
    let fname = fields[k]
    match cur_ty {
      TStruct(sname, sargs) =>
        match qbe_lookup_struct_info(g, sname) {
          Some(sinfo) => {
            let subst = make_subst(sinfo.decl.type_params, sargs)
            let mut fi = 0
            let mut found = false
            while fi < sinfo.field_names.length() {
              if sinfo.field_names[fi] == fname {
                if sinfo.field_muts[fi] {
                  return None
                }
                offsets.push(fi * 8)
                cur_ty = subst_ty(
                  subst_ty(sinfo.field_tys[fi], subst),
                  g.cur_type_subst,
                )
                found = true
                break
              }
              fi = fi + 1
            }
            if !found {
              return None
            }
          }
          None => return None
        }
      _ => return None
    }
    k = k + 1
  }
  match cur_ty {
    TParam(_) | TDynTrait(_) => return None
    _ => ()
  }
  let mut cur_reg = qbe_tmp(g)
  qbe_emit(g, cur_reg + " =l loadl " + loc.slot)
  let mut oi = 0
  while oi < offsets.length() {
    let fp = qbe_tmp(g)
    qbe_emit(g, fp + " =l add " + cur_reg + ", " + offsets[oi].to_string())
    if oi + 1 < offsets.length() {
      let nxt = qbe_tmp(g)
      qbe_emit(g, nxt + " =l loadl " + fp)
      cur_reg = nxt
    } else {
      cur_reg = qbe_load_heap_slot(g, fp, cur_ty)
    }
    oi = oi + 1
  }
  Some(qval(cur_reg, cur_ty))
}

///|
fn qbe_emit_arg_maybe_borrow_ext(
  g : QbeGen,
  arg : Expr,
  expected : Option[Ty],
  can_borrow : Bool,
  can_borrow_arr_field : Bool,
) -> QbeArgVal {
  let expect_dyn = match expected {
    Some(TDynTrait(_)) => true
    _ => false
  }
  if can_borrow {
    match arg {
      EString(s, _) =>
        if !expect_dyn {
          return QbeArgVal::{ qv: qval(qbe_emit_string_lit(g, s), TString), borrowed: true }
        }
      EIdent(lname, _) =>
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            if !loc.is_cell {
              let loc_ok = if !expect_dyn {
                true
              } else {
                match loc.ty {
                  TDynTrait(_) => true
                  _ => false
                }
              }
              if loc_ok {
                g.unfrozen_local_arrs.remove(lname)
                qbe_invalidate_known_min_len_if_dyn(g, lname)
                let t = qbe_load_local_slot(g, loc.slot, loc.ty)
                return QbeArgVal::{ qv: qval(t, loc.ty), borrowed: true }
              }
            }
          None => ()
        }
      EField(EIdent(lname, _), fname, _) =>
        if !expect_dyn {
        let pkey = lname + "." + fname
        match g.promoted_fields.get(pkey) {
          Some(pslot) =>
            match g.promoted_field_tys.get(pkey) {
              Some(pty) => {
                let pv = qbe_load_local_slot(g, pslot, pty)
                return QbeArgVal::{ qv: qval(pv, pty), borrowed: true }
              }
              None => ()
            }
          None => ()
        }
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            if !loc.is_cell {
            match loc.ty {
              TStruct(sname, sargs) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let subst = make_subst(sinfo.decl.type_params, sargs)
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname {
                        if !sinfo.field_muts[fi] || can_borrow_arr_field {
                          if !sinfo.field_muts[fi] {
                            let fkey = lname + "." + fname
                            match g.hoisted_fields.get(fkey) {
                              Some(hv) =>
                                return QbeArgVal::{ qv: hv, borrowed: true }
                              None => ()
                            }
                            match g.block_immut_fields.get(fkey) {
                              Some(bv) =>
                                return QbeArgVal::{ qv: bv, borrowed: true }
                              None => ()
                            }
                          }
                          let fty = subst_ty(sinfo.field_tys[fi], subst)
                          let obj_p = qbe_tmp(g)
                          let fp = qbe_tmp(g)
                          qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                          qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                          let fv = qbe_load_heap_slot(g, fp, fty)
                          return QbeArgVal::{ qv: qval(fv, fty), borrowed: true }
                        }
                        break
                      }
                      fi = fi + 1
                    }
                  }
                  None => ()
                }
              _ => ()
            }
            }
          None => ()
        }
        }
      EIndex(EIdent(aname, _), idx_expr, _) =>
        if can_borrow_arr_field && !expect_dyn {
          match qbe_lookup_local(g, aname) {
            Some(aloc) =>
              if !aloc.is_cell {
              match aloc.ty {
                TArray(elem) | TFixedArray(elem) | TImmArray(elem) =>
                  if qbe_is_obj_ty(g, elem) && qbe_flat_pod_stride(g, elem) == 0 {
                    match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                      Some(ev) => return QbeArgVal::{ qv: ev, borrowed: true }
                      None => ()
                    }
                  }
                _ => ()
              }
              }
            None => ()
          }
        }
      EField(EIndex(EIdent(aname, _), idx_expr, _), fname, _) =>
        if can_borrow_arr_field && !expect_dyn {
          match qbe_lookup_local(g, aname) {
            Some(aloc) =>
              if !aloc.is_cell {
              match aloc.ty {
                TArray(TStruct(sname, sargs)) | TFixedArray(TStruct(sname, sargs)) | TImmArray(TStruct(sname, sargs)) =>
                  match qbe_lookup_struct_info(g, sname) {
                    Some(sinfo) => {
                      let subst = make_subst(sinfo.decl.type_params, sargs)
                      let mut fi = 0
                      while fi < sinfo.field_names.length() {
                        if sinfo.field_names[fi] == fname {
                          match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                            Some(ev) => {
                              let fty = subst_ty(sinfo.field_tys[fi], subst)
                              let fp = qbe_tmp(g)
                              qbe_emit(g, fp + " =l add " + ev.reg + ", " + (fi * 8).to_string())
                              let fv = qbe_load_heap_slot(g, fp, fty)
                              return QbeArgVal::{ qv: qval(fv, fty), borrowed: true }
                            }
                            None => ()
                          }
                          break
                        }
                        fi = fi + 1
                      }
                    }
                    None => ()
                  }
                _ => ()
              }
              }
            None => ()
          }
        }
      EField(EField(_, _, _), _, _) =>
        if !expect_dyn {
          match qbe_try_emit_borrowed_immut_field_chain(g, arg) {
            Some(fv) => return QbeArgVal::{ qv: fv, borrowed: true }
            None => ()
          }
        }
      _ => ()
    }
  }
  QbeArgVal::{ qv: qbe_emit_expr(g, arg, expected), borrowed: false }
}

///|
fn qbe_emit_arg_maybe_borrow(
  g : QbeGen,
  arg : Expr,
  expected : Option[Ty],
  can_borrow : Bool,
) -> QbeArgVal {
  qbe_emit_arg_maybe_borrow_ext(g, arg, expected, can_borrow, false)
}

///|
fn qbe_pat_binds_name(pat : Pattern, name : String) -> Bool {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => false
    PIdent(n, _) => n == name
    PTuple(subs, _) | PVariant(_, _, subs, _, _) => {
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_binds_name(subs[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_expr_assigns_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) == name || qbe_expr_assigns_ident(inner, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_assigns_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_assigns_ident(l, name) || qbe_expr_assigns_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_assigns_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_assigns_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_assigns_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_assigns_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_assigns_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_assigns_ident(b, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_assigns_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_assigns_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_assigns_ident(cond, name) || qbe_stmts_assigns_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_assigns_ident(el, name)
      }
    }
    EIs(scrut, _, _) => qbe_expr_assigns_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_assigns_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_assigns_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_assigns_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_assigns_ident(body, name)
  }
}

///|
fn qbe_stmt_assigns_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_assigns_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_assigns_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EIdent(n, _) =>
          if n == name {
            return true
          }
        _ => ()
      }
      qbe_expr_assigns_ident(lhs, name) || qbe_expr_assigns_ident(rhs, name)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_assigns_ident(cond, name) || qbe_stmts_assigns_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_assigns_ident(init_s, name) ||
      qbe_expr_assigns_ident(cond, name) ||
      qbe_stmt_assigns_ident(step_s, name) ||
      qbe_stmts_assigns_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_assigns_ident(start_e, name) ||
      qbe_expr_assigns_ident(end_e, name) ||
      qbe_stmts_assigns_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_assigns_ident(iter_e, name) ||
      qbe_stmts_assigns_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_assigns_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_assigns_ident(c, name) || qbe_expr_assigns_ident(m, name)
    SExpr(e, _) => qbe_expr_assigns_ident(e, name)
  }
}

///|
fn qbe_stmts_assigns_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_assigns_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_mentions_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EIdent(n, _) => n == name
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_mentions_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_mentions_ident(l, name) || qbe_expr_mentions_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_mentions_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_mentions_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_mentions_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_mentions_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_mentions_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_mentions_ident(b, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_mentions_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_mentions_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_mentions_ident(cond, name) || qbe_stmts_mentions_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_mentions_ident(el, name)
      }
    }
    EIs(scrut, _, _) => qbe_expr_mentions_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_mentions_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_mentions_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_mentions_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_mentions_ident(body, name)
  }
}

///|
fn qbe_stmt_mentions_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_mentions_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_mentions_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_mentions_ident(lhs, name) || qbe_expr_mentions_ident(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_mentions_ident(cond, name) || qbe_stmts_mentions_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_mentions_ident(init_s, name) ||
      qbe_expr_mentions_ident(cond, name) ||
      qbe_stmt_mentions_ident(step_s, name) ||
      qbe_stmts_mentions_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_mentions_ident(start_e, name) ||
      qbe_expr_mentions_ident(end_e, name) ||
      qbe_stmts_mentions_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_mentions_ident(iter_e, name) ||
      qbe_stmts_mentions_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_mentions_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_mentions_ident(c, name) || qbe_expr_mentions_ident(m, name)
    SExpr(e, _) => qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_stmts_mentions_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_mentions_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_is_data_ptr_builtin(name : String) -> Bool {
  name == "str_data_ptr" ||
  name == "bytes_data_ptr" ||
  name == "array_data_ptr" ||
  name == "fixed_array_data_ptr"
}

///|
fn qbe_data_ptr_root_ident(e : Expr) -> String {
  match e {
    EIdent(n, _) => n
    EField(base, _, _) => qbe_data_ptr_root_ident(base)
    _ => ""
  }
}

///|
fn qbe_expr_is_binds_name(e : Expr, name : String) -> Bool {
  let work : Array[Expr] = [e]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EIs(_, pat, _) =>
            if qbe_pat_binds_name(pat, name) {
              return true
            }
          EBinary(op, l, r, _) =>
            if op == "&&" {
              work.push(r)
              work.push(l)
            }
          _ => ()
        }
      None => break
    }
  }
  false
}

///|
/// Shadowing-aware static prescan: returns true if `e` (at any nesting depth)
/// contains `*_data_ptr(<root>)` referring to the outer binding `name`
/// (without being shadowed by an inner binding of the same name).
fn qbe_expr_takes_data_ptr(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_takes_data_ptr(inner, name)
    EBinary(op, l, r, _) =>
      if op == "&&" {
        qbe_expr_takes_data_ptr(l, name) ||
        (!qbe_expr_is_binds_name(l, name) && qbe_expr_takes_data_ptr(r, name))
      } else {
        qbe_expr_takes_data_ptr(l, name) || qbe_expr_takes_data_ptr(r, name)
      }
    EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_takes_data_ptr(l, name) || qbe_expr_takes_data_ptr(r, name)
    ECall(callee, args, _) => {
      match callee {
        EIdent(fname, _) =>
          if qbe_is_data_ptr_builtin(fname) && args.length() >= 1 {
            if qbe_data_ptr_root_ident(args[0]) == name {
              return true
            }
          }
        _ => ()
      }
      if qbe_expr_takes_data_ptr(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_takes_data_ptr(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_takes_data_ptr(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_takes_data_ptr(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_takes_data_ptr(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_takes_data_ptr(b, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_takes_data_ptr(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_tail_takes_data_ptr(stmts, 0, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_takes_data_ptr(cond, name) {
        return true
      }
      if !qbe_expr_is_binds_name(cond, name) &&
        qbe_stmts_tail_takes_data_ptr(then_stmts, 0, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_takes_data_ptr(el, name)
      }
    }
    EMatch(scrut, arms, _) => {
      if qbe_expr_takes_data_ptr(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if qbe_expr_takes_data_ptr(ge, name) {
                return true
              }
            None => ()
          }
          if qbe_expr_takes_data_ptr(arms[i].body, name) {
            return true
          }
        }
        i = i + 1
      }
      false
    }
    EClosure(params, _, body, _) => {
      let mut pi = 0
      while pi < params.length() {
        if params[pi].name == name {
          return false
        }
        pi = pi + 1
      }
      qbe_stmts_tail_takes_data_ptr(body, 0, name)
    }
  }
}

///|
fn qbe_stmt_takes_data_ptr(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_takes_data_ptr(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_takes_data_ptr(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_takes_data_ptr(lhs, name) || qbe_expr_takes_data_ptr(rhs, name)
    SGuard(cond, body, _) =>
      qbe_expr_takes_data_ptr(cond, name) ||
      qbe_stmts_tail_takes_data_ptr(body, 0, name)
    SWhile(cond, body, _) =>
      qbe_expr_takes_data_ptr(cond, name) ||
      (!qbe_expr_is_binds_name(cond, name) &&
        qbe_stmts_tail_takes_data_ptr(body, 0, name))
    SFor(init_s, cond, step_s, body, _) => {
      if qbe_stmt_takes_data_ptr(init_s, name) {
        return true
      }
      let shadowed = match init_s {
        SLet(n2, _, _, _, _) => n2 == name
        SLetTuple(ns2, _, _, _) => str_arr_contains(ns2, name)
        _ => false
      }
      if shadowed {
        return false
      }
      qbe_expr_takes_data_ptr(cond, name) ||
      qbe_stmt_takes_data_ptr(step_s, name) ||
      qbe_stmts_tail_takes_data_ptr(body, 0, name)
    }
    SForRange(ivar, start_e, end_e, _, body, _) =>
      qbe_expr_takes_data_ptr(start_e, name) ||
      qbe_expr_takes_data_ptr(end_e, name) ||
      (ivar != name && qbe_stmts_tail_takes_data_ptr(body, 0, name))
    SForIn(iv, ev, iter_e, body, _) =>
      qbe_expr_takes_data_ptr(iter_e, name) ||
      (iv != name && ev != name && qbe_stmts_tail_takes_data_ptr(body, 0, name))
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_takes_data_ptr(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_takes_data_ptr(c, name) || qbe_expr_takes_data_ptr(m, name)
    SExpr(e, _) => qbe_expr_takes_data_ptr(e, name)
  }
}

///|
fn qbe_stmts_tail_takes_data_ptr(
  stmts : Array[Stmt],
  start_idx : Int,
  name : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    let s = stmts[i]
    if qbe_stmt_takes_data_ptr(s, name) {
      return true
    }
    match s {
      SLet(n2, _, _, _, _) => if n2 == name { return false }
      SLetTuple(ns2, _, _, _) => if str_arr_contains(ns2, name) { return false }
      SGuard(cond, _, _) => if qbe_expr_is_binds_name(cond, name) { return false }
      _ => ()
    }
    i = i + 1
  }
  false
}

///|
/// Fast O(N) block-level pre-check: returns true only if `e` contains any
/// `*_data_ptr(...)` call at any nesting depth. Lets `qbe_emit_stmts` skip
/// per-binding `qbe_stmts_tail_takes_data_ptr` scans in 99.9% of blocks.
fn qbe_expr_has_any_data_ptr(e : Expr) -> Bool {
  match e {
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_has_any_data_ptr(inner)
    EBinary(_, l, r, _)
    | EIndex(l, r, _)
    | EScope(l, r, _)
    | ESpawn(l, r, _) =>
      qbe_expr_has_any_data_ptr(l) || qbe_expr_has_any_data_ptr(r)
    ECall(callee, args, _) => {
      match callee {
        EIdent(fname, _) =>
          if qbe_is_data_ptr_builtin(fname) {
            return true
          }
        _ => ()
      }
      if qbe_expr_has_any_data_ptr(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_data_ptr(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_any_data_ptr(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_data_ptr(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_any_data_ptr(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_any_data_ptr(b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_any_data_ptr(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_any_data_ptr(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_any_data_ptr(cond) || qbe_stmts_has_any_data_ptr(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_any_data_ptr(el)
      }
    }
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_any_data_ptr(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_any_data_ptr(ge) { return true }
          None => ()
        }
        if qbe_expr_has_any_data_ptr(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_has_any_data_ptr(body)
    // Leaves. A new constructor with sub-expressions needs its own arm above.
    _ => false
  }
}

///|
fn qbe_stmt_has_any_data_ptr(s : Stmt) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_has_any_data_ptr(init)
    SLetTuple(_, _, init, _) => qbe_expr_has_any_data_ptr(init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_any_data_ptr(lhs) || qbe_expr_has_any_data_ptr(rhs)
    SGuard(cond, body, _) | SWhile(cond, body, _) =>
      qbe_expr_has_any_data_ptr(cond) || qbe_stmts_has_any_data_ptr(body)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_has_any_data_ptr(init_s) ||
      qbe_expr_has_any_data_ptr(cond) ||
      qbe_stmt_has_any_data_ptr(step_s) ||
      qbe_stmts_has_any_data_ptr(body)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_any_data_ptr(start_e) ||
      qbe_expr_has_any_data_ptr(end_e) ||
      qbe_stmts_has_any_data_ptr(body)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_any_data_ptr(iter_e) || qbe_stmts_has_any_data_ptr(body)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_any_data_ptr(e)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_any_data_ptr(c) || qbe_expr_has_any_data_ptr(m)
    SExpr(e, _) => qbe_expr_has_any_data_ptr(e)
  }
}

///|
fn qbe_stmts_has_any_data_ptr(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_any_data_ptr(stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_collect_pat_bindings(pat : Pattern, out : Array[String]) -> Unit {
  match pat {
    PIdent(name, _) => if name != "_" { out.push(name) }
    PTuple(subs, _) | PVariant(_, _, subs, _, _) => {
      let mut i = 0
      while i < subs.length() {
        qbe_collect_pat_bindings(subs[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_expr_is_bindings(e : Expr, out : Array[String]) -> Unit {
  match e {
    EIs(_, pat, _) => qbe_collect_pat_bindings(pat, out)
    EBinary(op, l, r, _) =>
      if op == "&&" {
        qbe_collect_expr_is_bindings(l, out)
        qbe_collect_expr_is_bindings(r, out)
      }
    _ => ()
  }
}

///|
fn qbe_pin_slot(g : QbeGen, slot : String, pinned_slot_list : Array[String]) -> Unit {
  let prev = match g.pinned_slots.get(slot) {
    Some(c) => c
    None => 0
  }
  g.pinned_slots.set(slot, prev + 1)
  pinned_slot_list.push(slot)
}

///|
fn qbe_pin_local_slot(
  g : QbeGen,
  name : String,
  pinned_slot_list : Array[String],
) -> Unit {
  match qbe_lookup_local(g, name) {
    Some(loc) => qbe_pin_slot(g, loc.slot, pinned_slot_list)
    None => ()
  }
}

///|
fn qbe_unpin_slot_list(g : QbeGen, pinned_slot_list : Array[String]) -> Unit {
  let mut pi = 0
  while pi < pinned_slot_list.length() {
    let pslot = pinned_slot_list[pi]
    match g.pinned_slots.get(pslot) {
      Some(c) =>
        if c <= 1 {
          g.pinned_slots.remove(pslot)
        } else {
          g.pinned_slots.set(pslot, c - 1)
        }
      None => ()
    }
    pi = pi + 1
  }
}

///|
fn qbe_cond_rhs_takes_data_ptr(cond : Expr, name : String) -> Bool {
  let terms : Array[Expr] = []
  let work : Array[Expr] = [cond]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EBinary("&&", l, r, _) => {
            work.push(r)
            work.push(l)
          }
          _ => terms.push(cur)
        }
      None => break
    }
  }
  let mut bound_seen = false
  let mut i = 0
  while i < terms.length() {
    if bound_seen && qbe_expr_takes_data_ptr(terms[i], name) {
      return true
    }
    if qbe_expr_is_binds_name(terms[i], name) {
      bound_seen = true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_pin_top_scope_for_cond_stmts(
  g : QbeGen,
  cond : Expr,
  stmts : Array[Stmt],
  pinned_slot_list : Array[String],
) -> Unit {
  if !qbe_expr_has_any_data_ptr(cond) && !qbe_stmts_has_any_data_ptr(stmts) {
    return
  }
  let top_sc = g.scopes[g.scopes.length() - 1]
  let mut li = 0
  while li < top_sc.locals.length() {
    let loc = top_sc.locals[li]
    if loc.owned &&
      (qbe_cond_rhs_takes_data_ptr(cond, loc.name) ||
        qbe_stmts_tail_takes_data_ptr(stmts, 0, loc.name)) {
      qbe_pin_slot(g, loc.slot, pinned_slot_list)
    }
    li = li + 1
  }
}

///|
fn qbe_pin_top_scope_for_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  pinned_slot_list : Array[String],
) -> Unit {
  if !qbe_stmts_has_any_data_ptr(stmts) {
    return
  }
  let top_sc = g.scopes[g.scopes.length() - 1]
  let mut li = 0
  while li < top_sc.locals.length() {
    let loc = top_sc.locals[li]
    if loc.owned && qbe_stmts_tail_takes_data_ptr(stmts, 0, loc.name) {
      qbe_pin_slot(g, loc.slot, pinned_slot_list)
    }
    li = li + 1
  }
}

///|
fn qbe_pin_top_scope_for_arm(
  g : QbeGen,
  guard_opt : Option[Expr],
  body : Expr,
  pinned_slot_list : Array[String],
) -> Unit {
  let has_dp = qbe_expr_has_any_data_ptr(body) ||
    match guard_opt {
      Some(ge) => qbe_expr_has_any_data_ptr(ge)
      None => false
    }
  if !has_dp {
    return
  }
  let top_sc = g.scopes[g.scopes.length() - 1]
  let mut li = 0
  while li < top_sc.locals.length() {
    let loc = top_sc.locals[li]
    if loc.owned {
      let takes = qbe_expr_takes_data_ptr(body, loc.name) ||
        match guard_opt {
          Some(ge) => qbe_expr_takes_data_ptr(ge, loc.name)
          None => false
        }
      if takes {
        qbe_pin_slot(g, loc.slot, pinned_slot_list)
      }
    }
    li = li + 1
  }
}

///|
/// Conservative static check: returns true only when `name` never escapes
/// (never returned, never reassigned, never stored in any container/struct/enum/tuple/closure)
/// and only appears in borrow-safe positions (direct call args, field/index receiver, match scrutinee).
fn qbe_ident_is_borrow_safe_expr(g : QbeGen, e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) != name && qbe_ident_is_borrow_safe_expr(g, inner, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_ident_is_borrow_safe_expr(g, inner, name)
    EBinary(op, l, r, _) =>
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let l_ok = match l {
          EIdent(n, _) => if n == name { !qbe_expr_has_assign(r) } else { true }
          _ => qbe_ident_is_borrow_safe_expr(g, l, name)
        }
        let r_ok = match r {
          EIdent(n, _) => if n == name { !qbe_expr_has_assign(l) } else { true }
          _ => qbe_ident_is_borrow_safe_expr(g, r, name)
        }
        l_ok && r_ok
      } else {
        qbe_ident_is_borrow_safe_expr(g, l, name) &&
        qbe_ident_is_borrow_safe_expr(g, r, name)
      }
    EField(obj, _, _) =>
      match obj {
        EIdent(n, _) =>
          if n == name {
            true
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    EIndex(obj, idx, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, idx, name) {
        return false
      }
      match obj {
        EIdent(n, _) =>
          if n == name {
            !qbe_expr_has_assign(idx)
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    }
    ECall(callee, args, _) => {
      let is_direct_borrow_callee = match callee {
        EIdent(fname, _) =>
          g.tc.fns.contains(fname) ||
          fname == "sha256_hex" ||
          is_world_builtin(fname)
        EPath(qual, mem, _) =>
          !is_caller_alias_redirected(g.tc, qual) && g.tc.methods.contains(qual + "::" + mem)
        _ => false
      }
      if is_direct_borrow_callee && !qbe_args_have_assign(args) {
        let mut i = 0
        while i < args.length() {
          match args[i] {
            EIdent(n, _) =>
              if n != name {
                ()
              }
            _ =>
              if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
                return false
              }
          }
          i = i + 1
        }
        true
      } else {
        if !qbe_ident_is_borrow_safe_expr(g, callee, name) {
          return false
        }
        let mut i = 0
        while i < args.length() {
          if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
            return false
          }
          i = i + 1
        }
        true
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if mname != "to_string" &&
        !qbe_expr_has_assign(obj) &&
        !qbe_args_have_assign(args) {
        let obj_ok = match obj {
          EIdent(n, _) => if n == name { true } else { true }
          _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
        }
        if !obj_ok {
          return false
        }
        let mut i = 0
        while i < args.length() {
          match args[i] {
            EIdent(n, _) => if n != name { () }
            _ =>
              if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
                return false
              }
          }
          i = i + 1
        }
        true
      } else {
        if !qbe_ident_is_borrow_safe_expr(g, obj, name) {
          return false
        }
        let mut i = 0
        while i < args.length() {
          if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
            return false
          }
          i = i + 1
        }
        true
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_borrow_safe_expr(g, elems[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_ident_is_borrow_safe_expr(g, b, name) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_borrow_safe_expr(g, fields[i].value, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_ident_is_borrow_safe_stmts(g, stmts, 0, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, cond, name) ||
        !qbe_ident_is_borrow_safe_stmts(g, then_stmts, 0, name) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_borrow_safe_expr(g, el, name)
      }
    }
    EIs(scrut, _, _) =>
      match scrut {
        EIdent(n, _) => if n == name { true } else { true }
        _ => qbe_ident_is_borrow_safe_expr(g, scrut, name)
      }
    EMatch(scrut, arms, _) => {
      let scrut_ok = match scrut {
        EIdent(n, _) =>
          if n == name {
            let mut ai = 0
            let mut ok = true
            while ai < arms.length() {
              match arms[ai].guard_expr {
                Some(ge) =>
                  if qbe_expr_assigns_ident(ge, name) {
                    ok = false
                    break
                  }
                None => ()
              }
              if qbe_expr_assigns_ident(arms[ai].body, name) {
                ok = false
                break
              }
              ai = ai + 1
            }
            ok
          } else {
            true
          }
        ETuple(elems, _) => {
          let mut all_tup_or_wild = elems.length() >= 1
          let mut ai = 0
          while ai < arms.length() && all_tup_or_wild {
            match arms[ai].pat {
              PWild(_) => ()
              PTuple(subs, _) =>
                if subs.length() != elems.length() {
                  all_tup_or_wild = false
                }
              _ => all_tup_or_wild = false
            }
            ai = ai + 1
          }
          if all_tup_or_wild {
            let mut reassigned = false
            ai = 0
            while ai < arms.length() {
              match arms[ai].guard_expr {
                Some(ge) =>
                  if qbe_expr_assigns_ident(ge, name) {
                    reassigned = true
                    break
                  }
                None => ()
              }
              if qbe_expr_assigns_ident(arms[ai].body, name) {
                reassigned = true
                break
              }
              ai = ai + 1
            }
            let mut ok = true
            let mut ei = 0
            while ei < elems.length() {
              match elems[ei] {
                EIdent(n, _) =>
                  if n == name && reassigned {
                    ok = false
                    break
                  }
                _ =>
                  if !qbe_ident_is_borrow_safe_expr(g, elems[ei], name) {
                    ok = false
                    break
                  }
              }
              ei = ei + 1
            }
            ok
          } else {
            qbe_ident_is_borrow_safe_expr(g, scrut, name)
          }
        }
        _ => qbe_ident_is_borrow_safe_expr(g, scrut, name)
      }
      if !scrut_ok {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_borrow_safe_expr(g, ge, name) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_borrow_safe_expr(g, arms[i].body, name) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) | EDotVariant(_, _, _) =>
      !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_borrow_safe_assign_lhs(
  g : QbeGen,
  lhs : Expr,
  rhs : Expr,
  name : String,
) -> Bool {
  match lhs {
    EIdent(n, _) => n != name
    EField(obj, _, _) =>
      match obj {
        EIdent(n, _) =>
          if n == name {
            !qbe_expr_has_assign(rhs)
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    EIndex(obj, idx, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, idx, name) {
        return false
      }
      match obj {
        EIdent(n, _) =>
          if n == name {
            !qbe_expr_has_assign(idx) && !qbe_expr_has_assign(rhs)
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    }
    _ => qbe_ident_is_borrow_safe_expr(g, lhs, name)
  }
}

///|
fn qbe_ident_is_borrow_safe_stmt(g : QbeGen, s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_ident_is_borrow_safe_expr(g, init, name)
    SLetTuple(_, _, init, _) => qbe_ident_is_borrow_safe_expr(g, init, name)
    SAssign(lhs, rhs, _) => {
      match lhs {
        EIdent(dst, _) =>
          match rhs {
            EIdent(src, _) =>
              if dst != name && src == name {
                return true
              }
            _ => ()
          }
        _ => ()
      }
      if !qbe_ident_is_borrow_safe_expr(g, rhs, name) {
        return false
      }
      qbe_ident_is_borrow_safe_assign_lhs(g, lhs, rhs, name)
    }
    SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, rhs, name) {
        return false
      }
      qbe_ident_is_borrow_safe_assign_lhs(g, lhs, rhs, name)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, cond, name) &&
      qbe_ident_is_borrow_safe_stmts(g, body, 0, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_borrow_safe_stmt(g, init_s, name) &&
      qbe_ident_is_borrow_safe_expr(g, cond, name) &&
      qbe_ident_is_borrow_safe_stmt(g, step_s, name) &&
      qbe_ident_is_borrow_safe_stmts(g, body, 0, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, start_e, name) &&
      qbe_ident_is_borrow_safe_expr(g, end_e, name) &&
      (vname == name || qbe_ident_is_borrow_safe_stmts(g, body, 0, name))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, iter_e, name) &&
      (vname == name || qbe_ident_is_borrow_safe_stmts(g, body, 0, name))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_ident_is_borrow_safe_expr(g, e, name)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_ident_is_borrow_safe_expr(g, c, name) &&
      qbe_ident_is_borrow_safe_expr(g, m, name)
    SExpr(e, _) => qbe_ident_is_borrow_safe_expr(g, e, name)
  }
}

///|
fn qbe_ident_is_borrow_safe_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  start_idx : Int,
  name : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_ident_is_borrow_safe_expr(g, init, name) {
          return false
        }
        if lname == name {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_ident_is_borrow_safe_expr(g, init, name) {
          return false
        }
        if str_arr_contains(lnames, name) {
          return true
        }
      }
      _ =>
        if !qbe_ident_is_borrow_safe_stmt(g, stmts[i], name) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
/// Check that local array `aname` is never mutated in container structure
/// (no reassignment, no `.push`/`.pop`, never passed to any function/closure;
/// if `allow_elem_assign` is false, also disallows `aname[...] = ...`).
///|
fn qbe_arr_escapes_in_expr(e : Expr, aname : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EIdent(n, _) => n == aname
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) == aname || qbe_arr_escapes_in_expr(inner, aname)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_arr_escapes_in_expr(inner, aname)
    EBinary(_, l, r, _) =>
      qbe_arr_escapes_in_expr(l, aname) || qbe_arr_escapes_in_expr(r, aname)
    EIndex(obj, idx, _) =>
      match obj {
        EIdent(n, _) =>
          if n == aname {
            qbe_expr_mentions_ident(idx, aname)
          } else {
            qbe_arr_escapes_in_expr(idx, aname)
          }
        _ => qbe_arr_escapes_in_expr(obj, aname) || qbe_arr_escapes_in_expr(idx, aname)
      }
    EMethodCall(obj, mname, args, _) =>
      match obj {
        EIdent(n, _) =>
          if n == aname {
            if mname == "push" || mname == "pop" || mname == "length" {
              let mut i = 0
              while i < args.length() {
                if qbe_expr_mentions_ident(args[i], aname) {
                  return true
                }
                i = i + 1
              }
              false
            } else {
              true
            }
          } else {
            let mut i = 0
            while i < args.length() {
              if qbe_arr_escapes_in_expr(args[i], aname) {
                return true
              }
              i = i + 1
            }
            false
          }
        _ => {
          if qbe_arr_escapes_in_expr(obj, aname) {
            return true
          }
          let mut i = 0
          while i < args.length() {
            if qbe_arr_escapes_in_expr(args[i], aname) {
              return true
            }
            i = i + 1
          }
          false
        }
      }
    ECall(callee, args, _) => {
      if qbe_arr_escapes_in_expr(callee, aname) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_arr_escapes_in_expr(args[i], aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_arr_escapes_in_expr(elems[i], aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_arr_escapes_in_expr(b, aname) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_arr_escapes_in_expr(fields[i].value, aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_arr_escapes_in_stmts(stmts, 0, aname)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_arr_escapes_in_expr(cond, aname) ||
        qbe_arr_escapes_in_stmts(then_stmts, 0, aname) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_arr_escapes_in_expr(el, aname)
      }
    }
    EIs(scrut, _, _) => qbe_arr_escapes_in_expr(scrut, aname)
    EMatch(scrut, arms, _) => {
      if qbe_arr_escapes_in_expr(scrut, aname) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, aname) {
          match arms[i].guard_expr {
            Some(ge) =>
              if qbe_arr_escapes_in_expr(ge, aname) {
                return true
              }
            None => ()
          }
          if qbe_arr_escapes_in_expr(arms[i].body, aname) {
            return true
          }
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      qbe_expr_mentions_ident(e, aname)
  }
}

///|
fn qbe_arr_escapes_in_stmt(s : Stmt, aname : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_arr_escapes_in_expr(init, aname)
    SLetTuple(_, _, init, _) => qbe_arr_escapes_in_expr(init, aname)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      match lhs {
        EIndex(EIdent(n, _), idx, _) =>
          if n == aname {
            qbe_expr_mentions_ident(idx, aname) || qbe_expr_mentions_ident(rhs, aname)
          } else {
            qbe_arr_escapes_in_expr(idx, aname) || qbe_arr_escapes_in_expr(rhs, aname)
          }
        _ => qbe_arr_escapes_in_expr(lhs, aname) || qbe_arr_escapes_in_expr(rhs, aname)
      }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_arr_escapes_in_expr(cond, aname) || qbe_arr_escapes_in_stmts(body, 0, aname)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_arr_escapes_in_stmt(init_s, aname) ||
      qbe_arr_escapes_in_expr(cond, aname) ||
      qbe_arr_escapes_in_stmt(step_s, aname) ||
      qbe_arr_escapes_in_stmts(body, 0, aname)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_arr_escapes_in_expr(start_e, aname) ||
      qbe_arr_escapes_in_expr(end_e, aname) ||
      (vname != aname && qbe_arr_escapes_in_stmts(body, 0, aname))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_arr_escapes_in_expr(iter_e, aname) ||
      (vname != aname && qbe_arr_escapes_in_stmts(body, 0, aname))
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_arr_escapes_in_expr(e, aname)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_arr_escapes_in_expr(c, aname) || qbe_arr_escapes_in_expr(m, aname)
    SExpr(e, _) => qbe_arr_escapes_in_expr(e, aname)
  }
}

///|
fn qbe_arr_escapes_in_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  aname : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if qbe_arr_escapes_in_expr(init, aname) {
          return true
        }
        if lname == aname {
          return false
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if qbe_arr_escapes_in_expr(init, aname) {
          return true
        }
        if str_arr_contains(lnames, aname) {
          return false
        }
      }
      _ =>
        if qbe_arr_escapes_in_stmt(stmts[i], aname) {
          return true
        }
    }
    i = i + 1
  }
  false
}

///|
fn qbe_invalidate_escaping_unfrozen_arrs(
  g : QbeGen,
  cond_opt : Option[Expr],
  step_opt : Option[Stmt],
  body : Array[Stmt],
) -> Unit {
  let mut si = 0
  while si < g.scopes.length() {
    let sc = g.scopes[si]
    let mut li = 0
    while li < sc.locals.length() {
      let aname = sc.locals[li].name
      if g.unfrozen_local_arrs.contains(aname) {
        let mut escapes = false
        match cond_opt {
          Some(c) =>
            if qbe_arr_escapes_in_expr(c, aname) {
              escapes = true
            }
          None => ()
        }
        if !escapes {
          match step_opt {
            Some(st) =>
              if qbe_arr_escapes_in_stmt(st, aname) {
                escapes = true
              }
            None => ()
          }
        }
        if !escapes && qbe_arr_escapes_in_stmts(body, 0, aname) {
          escapes = true
        }
        if escapes {
          g.unfrozen_local_arrs.remove(aname)
        }
      }
      if g.known_min_len_arrs.contains(aname) {
        match sc.locals[li].ty {
          TArray(_) => {
            let mut unstable = false
            match cond_opt {
              Some(c) =>
                if !qbe_arr_is_stable_expr(c, aname, true) {
                  unstable = true
                }
              None => ()
            }
            if !unstable {
              match step_opt {
                Some(st) =>
                  if !qbe_arr_is_stable_stmts([st], 0, aname, true) {
                    unstable = true
                  }
                None => ()
              }
            }
            if !unstable && !qbe_arr_is_stable_stmts(body, 0, aname, true) {
              unstable = true
            }
            if !unstable && !g.unfrozen_local_arrs.contains(aname) {
              let cond_no_calls = match cond_opt {
                Some(c) => qbe_loop_has_no_calls_expr(g, c)
                None => true
              }
              let step_no_calls = match step_opt {
                Some(st) => qbe_loop_has_no_calls_stmts(g, [st])
                None => true
              }
              if !cond_no_calls || !step_no_calls || !qbe_loop_has_no_calls_stmts(g, body) {
                unstable = true
              }
            }
            if unstable {
              g.known_min_len_arrs.remove(aname)
            }
          }
          _ => ()
        }
      }
      li = li + 1
    }
    si = si + 1
  }
}

///|
/// P74-C: Invalidate `known_min_len_arrs` for all potentially-aliased dynamic `TArray` locals
/// across any non-pure call/method (which may `.pop()`/`.clear()` via an alias).
fn qbe_invalidate_aliased_min_lens(g : QbeGen) -> Unit {
  if g.known_min_len_arrs.length() == 0 {
    return
  }
  let keys = g.known_min_len_arrs.keys()
  let mut i = 0
  while i < keys.length() {
    let k = keys[i]
    if !g.unfrozen_local_arrs.contains(k) {
      match qbe_lookup_local(g, k) {
        Some(loc) =>
          match loc.ty {
            TArray(_) => g.known_min_len_arrs.remove(k)
            _ => ()
          }
        None => g.known_min_len_arrs.remove(k)
      }
    }
    i = i + 1
  }
}

///|
/// P74-C: Conservative check whether statement `s` contains any array element assignment
/// (`SAssign(EIndex(...))` or `SCompoundAssign(_, EIndex(...))`), which could overwrite
/// an aliased array slot and `rc_dec` a borrowed element pointer.
fn qbe_expr_has_other_arr_elem_assign(e : Expr) -> Bool {
  match e {
    EBlock(bs, _) => qbe_stmts_has_other_arr_elem_assign(bs)
    EIf(c, ts, eo, _) => {
      if qbe_expr_has_other_arr_elem_assign(c) || qbe_stmts_has_other_arr_elem_assign(ts) {
        return true
      }
      match eo {
        Some(el) => qbe_expr_has_other_arr_elem_assign(el)
        None => false
      }
    }
    EMatch(s, arms, _) => {
      if qbe_expr_has_other_arr_elem_assign(s) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_other_arr_elem_assign(ge) { return true }
          None => ()
        }
        if qbe_expr_has_other_arr_elem_assign(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EField(inner, _, _)
    | EIs(inner, _, _)
    | ETry(inner, _) => qbe_expr_has_other_arr_elem_assign(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_other_arr_elem_assign(l) || qbe_expr_has_other_arr_elem_assign(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_other_arr_elem_assign(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_other_arr_elem_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_other_arr_elem_assign(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_other_arr_elem_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_other_arr_elem_assign(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_other_arr_elem_assign(b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_other_arr_elem_assign(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_stmt_has_other_arr_elem_assign(s : Stmt) -> Bool {
  match s {
    SAssign(EIndex(_, _, _), _, _) | SCompoundAssign(_, EIndex(_, _, _), _, _) => true
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) =>
      qbe_expr_has_other_arr_elem_assign(l) || qbe_expr_has_other_arr_elem_assign(r)
    SLet(_, _, _, ini, _) | SLetTuple(_, _, ini, _) | SExpr(ini, _) =>
      qbe_expr_has_other_arr_elem_assign(ini)
    SWhile(c, b, _) | SGuard(c, b, _) =>
      qbe_expr_has_other_arr_elem_assign(c) || qbe_stmts_has_other_arr_elem_assign(b)
    SFor(is_, c, ss, b, _) =>
      qbe_stmt_has_other_arr_elem_assign(is_) ||
      qbe_expr_has_other_arr_elem_assign(c) ||
      qbe_stmt_has_other_arr_elem_assign(ss) ||
      qbe_stmts_has_other_arr_elem_assign(b)
    SForRange(_, se, ee, _, b, _) =>
      qbe_expr_has_other_arr_elem_assign(se) ||
      qbe_expr_has_other_arr_elem_assign(ee) ||
      qbe_stmts_has_other_arr_elem_assign(b)
    SForIn(_, _, ie, b, _) =>
      qbe_expr_has_other_arr_elem_assign(ie) || qbe_stmts_has_other_arr_elem_assign(b)
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_expr_has_other_arr_elem_assign(e)
        None => false
      }
    SBreak(_) | SContinue(_) => false
  }
}

///|
fn qbe_stmts_has_other_arr_elem_assign(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_other_arr_elem_assign(stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// P74-F: Returns true when `stmts` is a `.pionstub` placeholder body (`{}` or `{ panic() }`
/// with 0 arguments). Callers must NEVER infer non-escape / pure-borrow / side-effect-free
/// properties from a stub placeholder because the real body lives in another package or unit.
fn qbe_fn_is_stub_body(stmts : Array[Stmt]) -> Bool {
  if stmts.length() == 0 {
    return true
  }
  if stmts.length() == 1 {
    match stmts[0] {
      SExpr(ECall(EIdent(fname, _), args, _), _) =>
        fname == "panic" && args.length() == 0
      _ => false
    }
  } else {
    false
  }
}

///|
/// P74-C: Returns true when `fname` is a static non-generic top-level function taking ONLY
/// immutable primitive scalar parameters (no refs/structs/arrays/World/Ptr/closures). Because
/// Pion has no mutable globals, such a call cannot reach or mutate any caller array.
fn qbe_callee_cannot_mutate_arrays(g : QbeGen, fname : String) -> Bool {
  match qbe_lookup_local(g, fname) {
    Some(_) => return false
    None => ()
  }
  if g.inline_closures.contains(fname) {
    return false
  }
  let finfo_opt : Option[FnInfo] = if g.mono_pkg == "" {
    if g.tc.extern_fns.contains(fname) {
      return false
    }
    g.tc.fns.get(fname)
  } else {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.extern_fns.contains(fname) {
          return false
        } else {
          match ipkg.tc.fns.get(fname) {
            Some(fi) => Some(qualify_fn_info(ipkg, fi))
            None => None
          }
        }
      None => None
    }
  }
  match finfo_opt {
    Some(finfo) => {
      if finfo.decl.type_params.length() != 0 || qbe_fn_is_stub_body(finfo.decl.body) {
        return false
      }
      let mut i = 0
      while i < finfo.param_tys.length() && i < finfo.decl.params.length() {
        if finfo.decl.params[i].is_mut {
          return false
        }
        match finfo.param_tys[i] {
          TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TChar => ()
          _ => return false
        }
        i = i + 1
      }
      true
    }
    None => false
  }
}

///|
fn qbe_path_is_enum_variant(g : QbeGen, qual : String, mem : String) -> Bool {
  let qp = split_qual_name(qual)
  if qp.prefix.length() > 0 {
    match qbe_resolve_pkg_in_scope(g, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qp.name) {
          Some(ei) => enum_info_has_variant(ei, mem) && !ipkg.tc.structs.contains(qp.name)
          None => false
        }
      None => false
    }
  } else if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qual) {
          Some(ei) => enum_info_has_variant(ei, mem) && !ipkg.tc.structs.contains(qual)
          None => false
        }
      None => false
    }
  } else {
    match g.tc.enums.get(qual) {
      Some(ei) => enum_info_has_variant(ei, mem) && !g.tc.structs.contains(qual)
      None => false
    }
  }
}

///|
fn qbe_method_preserves_arr_hdr(
  g : QbeGen,
  recv : Expr,
  mname : String,
  hints : QbeProbeHints,
) -> Bool {
  if mname != "write_byte" &&
    mname != "write_char" &&
    mname != "write_string" &&
    mname != "write_substring" &&
    mname != "write_bytes" {
    return false
  }
  match qbe_probe_expr_ty_with(g, recv, hints) {
    Some(raw_ty) =>
      match subst_ty(raw_ty, g.cur_type_subst) {
        TStringBuilder => true
        _ => false
      }
    None => false
  }
}

///|
/// P74-C: Like `qbe_loop_has_no_calls_stmt_with`, but also permits mutating methods
/// (`push`/`pop`/`clear`/`reserve`) on a provably-unaliased local array `tname != aname`
/// in `g.unfrozen_local_arrs`, and calls to static pure-scalar-param functions that cannot
/// reach or mutate any caller array.
fn qbe_no_aliasing_calls_expr(
  g : QbeGen,
  e : Expr,
  aname : String,
  hints : QbeProbeHints,
) -> Bool {
  if qbe_loop_has_no_calls_expr_with(g, e, hints) {
    return true
  }
  match e {
    ECall(EIdent(fname, _), args, call_sp) => {
      match qbe_hints_get(hints, fname) {
        Some(_) => return false
        None => ()
      }
      match qbe_lookup_local(g, fname) {
        Some(_) => return false
        None => ()
      }
      let is_pure_ctor = !qbe_has_user_callee_at(g, fname, call_sp) && (
        fname == "panic" ||
        fname == "Some" ||
        fname == "Ok" ||
        fname == "Err" ||
        (match qbe_lookup_variant_enum(g, fname) {
          Some(_) => true
          None => false
        }))
      if is_pure_ctor || qbe_callee_cannot_mutate_arrays(g, fname) {
        let mut i = 0
        while i < args.length() {
          if !qbe_no_aliasing_calls_expr(g, args[i], aname, hints) {
            return false
          }
          i = i + 1
        }
        true
      } else {
        false
      }
    }
    ECall(EPath(qual, mem, _), args, _) => {
      let is_pure_path = (qual == "Array" &&
          (mem == "with_capacity" || mem == "make" || mem == "new")) ||
        (qual == "FixedArray" && (mem == "make" || mem == "new")) ||
        (qual == "ImmArray" && (mem == "make" || mem == "new" || mem == "from_array")) ||
        (qual == "StringBuilder" && (mem == "new" || mem == "with_capacity")) ||
        (qual == "Map" && (mem == "new" || mem == "with_capacity")) ||
        qbe_path_is_enum_variant(g, qual, mem)
      if is_pure_path {
        let mut i = 0
        while i < args.length() {
          if !qbe_no_aliasing_calls_expr(g, args[i], aname, hints) {
            return false
          }
          i = i + 1
        }
        true
      } else {
        false
      }
    }
    EMethodCall(obj, mname, args, msp) => {
      if qbe_has_expected_trait(g, msp) {
        return false
      }
      if !qbe_no_aliasing_calls_expr(g, obj, aname, hints) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_no_aliasing_calls_expr(g, args[i], aname, hints) {
          return false
        }
        i = i + 1
      }
      match obj {
        EIdent(tname, _) =>
          if tname != aname &&
            g.unfrozen_local_arrs.contains(tname) &&
            (match qbe_hints_get(hints, tname) {
              Some(_) => false
              None => true
            }) &&
            (mname == "push" || mname == "pop" || mname == "clear" || mname == "truncate" || mname == "reserve") {
            return true
          }
        _ => ()
      }
      if qbe_method_preserves_arr_hdr(g, obj, mname, hints) {
        return true
      }
      if mname == "contains" && qbe_contains_may_call_custom(g, obj, hints) {
        return false
      }
      match qbe_probe_expr_ty_with(g, obj, hints) {
        Some(raw_ty) =>
          qbe_is_pure_builtin_method(
            subst_ty(raw_ty, g.cur_type_subst),
            mname,
            args.length(),
          )
        None => false
      }
    }
    EBlock(bs, _) => qbe_no_aliasing_calls_stmts(g, bs, aname, hints)
    EIf(c, ts, eo, _) => {
      if !qbe_no_aliasing_calls_expr(g, c, aname, hints) {
        return false
      }
      let cond_binds : Array[String] = []
      qbe_collect_cond_is_binds_arr(c, cond_binds)
      let then_hints = if cond_binds.length() > 0 {
        let h2 = qbe_hints_copy(hints)
        let mut bi = 0
        while bi < cond_binds.length() {
          qbe_hints_set(h2, cond_binds[bi], TError)
          bi = bi + 1
        }
        h2
      } else {
        hints
      }
      if !qbe_no_aliasing_calls_stmts(g, ts, aname, then_hints) {
        return false
      }
      match eo {
        Some(el) => qbe_no_aliasing_calls_expr(g, el, aname, hints)
        None => true
      }
    }
    EMatch(s, arms, _) => {
      if !qbe_no_aliasing_calls_expr(g, s, aname, hints) {
        return false
      }
      let scrut_ty_opt = qbe_probe_expr_ty_with(g, s, hints)
      let mut i = 0
      while i < arms.length() {
        let arm_binds : Array[String] = []
        qbe_collect_pat_binds_arr(arms[i].pat, arm_binds)
        let arm_hints = if arm_binds.length() > 0 {
          let h2 = qbe_hints_copy(hints)
          let mut bi = 0
          while bi < arm_binds.length() {
            qbe_hints_set(h2, arm_binds[bi], TError)
            bi = bi + 1
          }
          h2
        } else {
          hints
        }
        match (scrut_ty_opt, arms[i].pat) {
          (Some(raw_st), PVariant(_, vname, subs, _, _)) => {
            let st = subst_ty(raw_st, g.cur_type_subst)
            match st {
              TEnum(ename, eargs) =>
                match qbe_lookup_enum_info(g, ename) {
                  Some(einfo) => {
                    let esubst = make_subst(einfo.decl.type_params, eargs)
                    let mut vi = 0
                    while vi < einfo.variants.length() {
                      if einfo.variants[vi].name == vname {
                        let ptys = einfo.variants[vi].field_tys
                        let mut pi = 0
                        while pi < subs.length() && pi < ptys.length() {
                          match subs[pi] {
                            PIdent(pn, _) =>
                              if pn != "_" {
                                qbe_hints_set(arm_hints, pn, subst_ty(ptys[pi], esubst))
                              }
                            _ => ()
                          }
                          pi = pi + 1
                        }
                        break
                      }
                      vi = vi + 1
                    }
                  }
                  None => ()
                }
              _ => ()
            }
          }
          _ => ()
        }
        let body_hints = match arms[i].guard_expr {
          Some(ge) => {
            if !qbe_no_aliasing_calls_expr(g, ge, aname, arm_hints) {
              return false
            }
            let gbinds : Array[String] = []
            qbe_collect_cond_is_binds_arr(ge, gbinds)
            if gbinds.length() > 0 {
              let bh = qbe_hints_copy(arm_hints)
              let mut gbi = 0
              while gbi < gbinds.length() {
                qbe_hints_set(bh, gbinds[gbi], TError)
                gbi = gbi + 1
              }
              bh
            } else {
              arm_hints
            }
          }
          None => arm_hints
        }
        if !qbe_no_aliasing_calls_expr(g, arms[i].body, aname, body_hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EField(inner, _, _)
    | EIs(inner, _, _)
    | ETry(inner, _) => qbe_no_aliasing_calls_expr(g, inner, aname, hints)
    EBinary(op, l, r, _) => {
      if (op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, hints) {
        return false
      }
      if !qbe_no_aliasing_calls_expr(g, l, aname, hints) {
        return false
      }
      let rhs_hints = if op == "&&" {
        let binds : Array[String] = []
        qbe_collect_cond_is_binds_arr(l, binds)
        if binds.length() > 0 {
          let rh = qbe_hints_copy(hints)
          let mut bi = 0
          while bi < binds.length() {
            qbe_hints_set(rh, binds[bi], TError)
            bi = bi + 1
          }
          rh
        } else {
          hints
        }
      } else {
        hints
      }
      qbe_no_aliasing_calls_expr(g, r, aname, rhs_hints)
    }
    EIndex(l, r, _) =>
      qbe_no_aliasing_calls_expr(g, l, aname, hints) &&
      qbe_no_aliasing_calls_expr(g, r, aname, hints)
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_no_aliasing_calls_expr(g, elems[i], aname, hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_no_aliasing_calls_expr(g, b, aname, hints) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_no_aliasing_calls_expr(g, fields[i].value, aname, hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///|
fn qbe_no_aliasing_calls_stmt(
  g : QbeGen,
  s : Stmt,
  aname : String,
  hints : QbeProbeHints,
) -> Bool {
  if qbe_loop_has_no_calls_stmt_with(g, s, hints) {
    return true
  }
  match s {
    SLet(_, _, _, ini, _) | SLetTuple(_, _, ini, _) | SExpr(ini, _) =>
      qbe_no_aliasing_calls_expr(g, ini, aname, hints)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) =>
      qbe_no_aliasing_calls_expr(g, l, aname, hints) &&
      qbe_no_aliasing_calls_expr(g, r, aname, hints)
    SWhile(c, b, _) => {
      if !qbe_no_aliasing_calls_expr(g, c, aname, hints) {
        return false
      }
      let wbinds : Array[String] = []
      qbe_collect_cond_is_binds_arr(c, wbinds)
      let body_hints = if wbinds.length() > 0 {
        let h2 = qbe_hints_copy(hints)
        let mut bi = 0
        while bi < wbinds.length() {
          qbe_hints_set(h2, wbinds[bi], TError)
          bi = bi + 1
        }
        h2
      } else {
        hints
      }
      qbe_no_aliasing_calls_stmts(g, b, aname, body_hints)
    }
    SGuard(c, b, _) =>
      qbe_no_aliasing_calls_expr(g, c, aname, hints) &&
      qbe_no_aliasing_calls_stmts(g, b, aname, hints)
    SFor(is_, c, ss, b, _) => {
      if !qbe_no_aliasing_calls_stmt(g, is_, aname, hints) {
        return false
      }
      let for_hints = match is_ {
        SLet(vn, _, _, _, _) =>
          if vn != "" && vn != "_" {
            let h2 = qbe_hints_copy(hints)
            qbe_hints_set(h2, vn, TError)
            h2
          } else {
            hints
          }
        SLetTuple(vns, _, _, _) => {
          let h2 = qbe_hints_copy(hints)
          let mut bi = 0
          while bi < vns.length() {
            if vns[bi] != "" && vns[bi] != "_" {
              qbe_hints_set(h2, vns[bi], TError)
            }
            bi = bi + 1
          }
          h2
        }
        _ => hints
      }
      qbe_no_aliasing_calls_expr(g, c, aname, for_hints) &&
      qbe_no_aliasing_calls_stmt(g, ss, aname, for_hints) &&
      qbe_no_aliasing_calls_stmts(g, b, aname, for_hints)
    }
    SForRange(vname, se, ee, _, b, _) => {
      if !qbe_no_aliasing_calls_expr(g, se, aname, hints) ||
        !qbe_no_aliasing_calls_expr(g, ee, aname, hints) {
        return false
      }
      let bh = qbe_hints_copy(hints)
      if vname != "" && vname != "_" {
        qbe_hints_set(bh, vname, TInt)
      }
      qbe_no_aliasing_calls_stmts(g, b, aname, bh)
    }
    SForIn(idx_v, elem_v, ie, b, _) => {
      if !qbe_no_aliasing_calls_expr(g, ie, aname, hints) {
        return false
      }
      let bh = qbe_hints_copy(hints)
      if idx_v != "" && idx_v != "_" {
        qbe_hints_set(bh, idx_v, TInt)
      }
      if elem_v != "" && elem_v != "_" {
        qbe_hints_set(bh, elem_v, TError)
      }
      qbe_no_aliasing_calls_stmts(g, b, aname, bh)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_no_aliasing_calls_expr(g, e, aname, hints)
        None => true
      }
    SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_hints_advance_stmt(
  g : QbeGen,
  s : Stmt,
  local_hints : QbeProbeHints,
) -> Unit {
  match s {
    SLet(name, _, te, init, let_sp) =>
      if name != "_" {
        let mut bound_ty = TError
        match te {
          TyMissing(_) =>
            match qbe_let_infer(g, let_sp) {
              Some(t) => bound_ty = t
              None =>
                match qbe_probe_expr_ty_with(g, init, local_hints) {
                  Some(t) =>
                    if !ty_has_unresolved(t) {
                      bound_ty = t
                    }
                  None => ()
                }
            }
          _ => {
            let t = qbe_resolve_type(g, te)
            if !ty_has_unresolved(t) {
              bound_ty = t
            }
          }
        }
        qbe_hints_set(local_hints, name, bound_ty)
      }
    SLetTuple(names, te, init, _) => {
      let mut tup_elems : Array[Ty] = []
      match te {
        TyMissing(_) =>
          match qbe_probe_expr_ty_with(g, init, local_hints) {
            Some(TTuple(es)) => tup_elems = es
            _ => ()
          }
        _ =>
          match qbe_resolve_type(g, te) {
            TTuple(es) => tup_elems = es
            _ => ()
          }
      }
      let mut ni = 0
      while ni < names.length() {
        if names[ni] != "_" {
          let bt = if ni < tup_elems.length() && !ty_has_unresolved(tup_elems[ni]) {
            tup_elems[ni]
          } else {
            TError
          }
          qbe_hints_set(local_hints, names[ni], bt)
        }
        ni = ni + 1
      }
    }
    SGuard(cond, _, _) => {
      let gbinds : Array[String] = []
      qbe_collect_cond_is_binds_arr(cond, gbinds)
      let mut bi = 0
      while bi < gbinds.length() {
        qbe_hints_set(local_hints, gbinds[bi], TError)
        bi = bi + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_no_aliasing_calls_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  aname : String,
  hints : QbeProbeHints,
) -> Bool {
  let local_hints = qbe_hints_copy(hints)
  let mut i = 0
  while i < stmts.length() {
    if !qbe_no_aliasing_calls_stmt(g, stmts[i], aname, local_hints) {
      return false
    }
    qbe_hints_advance_stmt(g, stmts[i], local_hints)
    i = i + 1
  }
  true
}

///|
fn qbe_ty_is_concrete_for_alias(t : Ty) -> Bool {
  match t {
    TError | TParam(_) | TDynTrait(_) | TNever => false
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) | TChannel(e) | TMutex(e) =>
      qbe_ty_is_concrete_for_alias(e)
    TResult(a, b) | TMap(a, b) =>
      qbe_ty_is_concrete_for_alias(a) && qbe_ty_is_concrete_for_alias(b)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_ty_is_concrete_for_alias(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    TFn(ps, r) => {
      if !qbe_ty_is_concrete_for_alias(r) {
        return false
      }
      let mut i = 0
      while i < ps.length() {
        if !qbe_ty_is_concrete_for_alias(ps[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => true
  }
}

///|
fn qbe_tys_strictly_distinct(a : Ty, b : Ty) -> Bool {
  if !qbe_ty_is_concrete_for_alias(a) || !qbe_ty_is_concrete_for_alias(b) {
    return false
  }
  let sa = ty_to_string(a)
  let sb = ty_to_string(b)
  if sa == sb {
    return false
  }
  match a {
    TEnum(na, _) =>
      match b {
        TEnum(nb, _) =>
          if na == nb || na.ends_with("::" + nb) || nb.ends_with("::" + na) {
            return false
          }
        _ => ()
      }
    TStruct(na, _) =>
      match b {
        TStruct(nb, _) =>
          if na == nb || na.ends_with("::" + nb) || nb.ends_with("::" + na) {
            return false
          }
        _ => ()
      }
    _ => ()
  }
  true
}

///|
fn qbe_ty_safe_dst_for_borrowed_arr(g : QbeGen, t : Ty, elem_ty : Ty) -> Bool {
  if !qbe_ty_is_concrete_for_alias(t) {
    return false
  }
  if !qbe_is_obj_ty(g, t) {
    return true
  }
  match t {
    TString | TBytes | TStringBuilder => true
    TArray(e2) | TFixedArray(e2) | TImmArray(e2) => {
      let leaf_elem = match e2 {
        TString => true
        _ => qbe_ty_is_concrete_for_alias(e2) && !qbe_is_obj_ty(g, e2)
      }
      leaf_elem && qbe_tys_strictly_distinct(e2, elem_ty)
    }
    _ => false
  }
}

///|
fn qbe_match_arr_alias_safe_expr(
  g : QbeGen,
  e : Expr,
  elem_ty : Ty,
  hints : QbeProbeHints,
  arr_owned : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EIdent(_, _)
    | EUnit(_) => true
    EMutArg(_, _)
    | EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | ETry(_, _) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EIs(inner, _, _) =>
      qbe_match_arr_alias_safe_expr(g, inner, elem_ty, hints, arr_owned)
    EBinary(op, l, r, _) =>
      if (op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, hints) {
        false
      } else {
        qbe_match_arr_alias_safe_expr(g, l, elem_ty, hints, arr_owned) &&
        qbe_match_arr_alias_safe_expr(g, r, elem_ty, hints, arr_owned)
      }
    EIndex(obj, idx, _) =>
      qbe_match_arr_alias_safe_expr(g, obj, elem_ty, hints, arr_owned) &&
      qbe_match_arr_alias_safe_expr(g, idx, elem_ty, hints, arr_owned)
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_match_arr_alias_safe_expr(g, elems[i], elem_ty, hints, arr_owned) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if !qbe_match_arr_alias_safe_expr(g, b, elem_ty, hints, arr_owned) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_match_arr_alias_safe_expr(g, fields[i].value, elem_ty, hints, arr_owned) {
          return false
        }
        i = i + 1
      }
      true
    }
    ECall(callee, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_match_arr_alias_safe_expr(g, args[i], elem_ty, hints, arr_owned) {
          return false
        }
        i = i + 1
      }
      match callee {
        EIdent(fname, _) =>
          fname == "panic" ||
          fname == "Some" ||
          fname == "Ok" ||
          fname == "Err" ||
          fname == "StringBuilder" ||
          fname == "Map" ||
          g.tc.variant_to_enum.contains(fname) ||
          g.tc.structs.contains(fname)
        EPath(qual, mem, _) =>
          (qual == "Array" && (mem == "with_capacity" || mem == "make" || mem == "new")) ||
          (qual == "FixedArray" && (mem == "make" || mem == "new")) ||
        (qual == "ImmArray" && (mem == "make" || mem == "new" || mem == "from_array")) ||
          (qual == "StringBuilder" && (mem == "new" || mem == "with_capacity")) ||
          (qual == "Map" && (mem == "new" || mem == "with_capacity")) ||
          g.tc.enums.contains(qual)
        _ => false
      }
    }
    EMethodCall(obj, mname, args, sp) => {
      if qbe_has_expected_trait(g, sp) {
        return false
      }
      if !qbe_match_arr_alias_safe_expr(g, obj, elem_ty, hints, arr_owned) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_match_arr_alias_safe_expr(g, args[i], elem_ty, hints, arr_owned) {
          return false
        }
        i = i + 1
      }
      if mname == "contains" && qbe_contains_may_call_custom(g, obj, hints) {
        return false
      }
      match qbe_probe_expr_ty_with(g, obj, hints) {
        Some(TArray(e2)) | Some(TFixedArray(e2)) | Some(TImmArray(e2)) =>
          if mname == "length" || mname == "is_empty" || mname == "capacity" {
            true
          } else if mname == "push" ||
            mname == "pop" ||
            mname == "clear" ||
            mname == "reverse" ||
            mname == "sort" ||
            mname == "resize" ||
            mname == "set" ||
            mname == "insert" ||
            mname == "remove" ||
            mname == "truncate" ||
            mname == "swap" {
            qbe_tys_strictly_distinct(e2, elem_ty)
          } else {
            false
          }
        Some(TInt) =>
          (args.length() == 0 &&
          (mname == "to_int" ||
          mname == "to_int64" ||
          mname == "to_uint" ||
          mname == "reinterpret_as_uint" ||
          mname == "to_double" ||
          mname == "to_float" ||
          mname == "abs" ||
          mname == "unsafe_to_char" ||
          mname == "to_byte" ||
          mname == "to_int8" ||
          mname == "to_string" ||
          mname == "leading_zeros" ||
          mname == "trailing_zeros" ||
          mname == "count_ones" ||
          mname == "lnot")) ||
          (args.length() == 1 && (mname == "rotate_left" || mname == "rotate_right"))
        Some(TInt64) =>
          (args.length() == 0 &&
          (mname == "to_int" ||
          mname == "to_int64" ||
          mname == "to_uint64" ||
          mname == "reinterpret_as_uint64" ||
          mname == "to_double" ||
          mname == "abs" ||
          mname == "to_int8" ||
          mname == "to_string" ||
          mname == "leading_zeros" ||
          mname == "trailing_zeros" ||
          mname == "count_ones" ||
          mname == "lnot")) ||
          (args.length() == 1 && (mname == "rotate_left" || mname == "rotate_right"))
        Some(TUInt) =>
          (args.length() == 0 &&
          (mname == "to_int" ||
          mname == "reinterpret_as_int" ||
          mname == "to_uint" ||
          mname == "to_int64" ||
          mname == "to_uint64" ||
          mname == "to_double" ||
          mname == "to_float" ||
          mname == "reinterpret_as_float" ||
          mname == "to_int8" ||
          mname == "to_string" ||
          mname == "leading_zeros" ||
          mname == "trailing_zeros" ||
          mname == "count_ones" ||
          mname == "lnot")) ||
          (args.length() == 1 && (mname == "rotate_left" || mname == "rotate_right"))
        Some(TUInt64) =>
          (args.length() == 0 &&
          (mname == "to_int" ||
          mname == "to_uint" ||
          mname == "to_int64" ||
          mname == "reinterpret_as_int64" ||
          mname == "to_uint64" ||
          mname == "to_double" ||
          mname == "reinterpret_as_double" ||
          mname == "to_int8" ||
          mname == "to_string" ||
          mname == "leading_zeros" ||
          mname == "trailing_zeros" ||
          mname == "count_ones" ||
          mname == "lnot")) ||
          (args.length() == 1 && (mname == "rotate_left" || mname == "rotate_right"))
        Some(TDouble) =>
          (args.length() == 0 &&
          (mname == "to_int" ||
          mname == "to_int64" ||
          mname == "to_float" ||
          mname == "to_int8" ||
          mname == "to_bits" ||
          mname == "reinterpret_as_int64" ||
          mname == "reinterpret_as_uint64" ||
          mname == "is_nan" ||
          mname == "is_inf" ||
          mname == "is_finite" ||
          mname == "to_string" ||
          mname == "abs" ||
          mname == "floor" ||
          mname == "ceil" ||
          mname == "round" ||
          mname == "trunc" ||
          mname == "sqrt" ||
          mname == "cbrt" ||
          mname == "exp" ||
          mname == "ln" ||
          mname == "sin" ||
          mname == "cos" ||
          mname == "tan" ||
          mname == "asin" ||
          mname == "acos" ||
          mname == "atan")) ||
          (args.length() == 1 && (mname == "compare" || mname == "pow" || mname == "atan2"))
        Some(TFloat) =>
          (args.length() == 0 &&
          (mname == "to_double" ||
          mname == "to_int" ||
          mname == "to_int64" ||
          mname == "to_int8" ||
          mname == "to_bits" ||
          mname == "reinterpret_as_int" ||
          mname == "reinterpret_as_uint" ||
          mname == "is_nan" ||
          mname == "is_inf" ||
          mname == "is_finite" ||
          mname == "to_string" ||
          mname == "abs" ||
          mname == "floor" ||
          mname == "ceil" ||
          mname == "round" ||
          mname == "trunc" ||
          mname == "sqrt" ||
          mname == "cbrt" ||
          mname == "exp" ||
          mname == "ln" ||
          mname == "sin" ||
          mname == "cos" ||
          mname == "tan" ||
          mname == "asin" ||
          mname == "acos" ||
          mname == "atan")) ||
          (args.length() == 1 && (mname == "pow" || mname == "atan2"))
        Some(TByte) =>
          args.length() == 0 && (mname == "to_int" || mname == "to_int8")
        Some(TInt8) =>
          args.length() == 0 &&
          (mname == "to_int" ||
          mname == "to_int64" ||
          mname == "to_uint" ||
          mname == "to_uint64" ||
          mname == "to_byte" ||
          mname == "to_float" ||
          mname == "to_double" ||
          mname == "to_string")
        Some(TChar) => args.length() == 0 && (mname == "to_int" || mname == "to_string")
        Some(TBool) => args.length() == 0 && mname == "to_string"
        Some(TString) =>
          mname == "length" ||
          mname == "is_empty" ||
          mname == "byte_at" ||
          mname == "code_unit_at" ||
          mname == "slice" ||
          mname == "split" ||
          mname == "contains" ||
          mname == "starts_with" ||
          mname == "ends_with" ||
          mname == "trim" ||
          mname == "as_bytes" ||
          mname == "to_string"
        Some(TBytes) =>
          mname == "length" || mname == "is_empty" || mname == "to_string"
        Some(TStringBuilder) =>
          mname == "length" ||
          mname == "is_empty" ||
          mname == "write_string" ||
          mname == "write_char" ||
          mname == "write_byte" ||
          mname == "write_int" ||
          mname == "write_int64" ||
          mname == "to_string" ||
          mname == "clear"
        Some(TMap(_, _)) =>
          mname == "length" ||
          mname == "is_empty" ||
          mname == "get" ||
          mname == "try_get" ||
          mname == "contains"
        _ => false
      }
    }
    EBlock(stmts, _) =>
      qbe_match_arr_alias_safe_stmts(g, stmts, elem_ty, hints, arr_owned)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_match_arr_alias_safe_expr(g, cond, elem_ty, hints, arr_owned) ||
        !qbe_match_arr_alias_safe_stmts(g, then_stmts, elem_ty, hints, arr_owned) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_match_arr_alias_safe_expr(g, el, elem_ty, hints, arr_owned)
      }
    }
    EMatch(scrut, arms, _) => {
      if !qbe_match_arr_alias_safe_expr(g, scrut, elem_ty, hints, arr_owned) {
        return false
      }
      let scrut_ty_opt = qbe_probe_expr_ty_with(g, scrut, hints)
      let mut i = 0
      while i < arms.length() {
        let arm_hints = qbe_hints_copy(hints)
        qbe_bind_pat_probe_hints(g, arms[i].pat, scrut_ty_opt, arm_hints)
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_match_arr_alias_safe_expr(g, ge, elem_ty, arm_hints, arr_owned) {
              return false
            }
          None => ()
        }
        if !qbe_match_arr_alias_safe_expr(g, arms[i].body, elem_ty, arm_hints, arr_owned) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

///|
fn qbe_match_arr_alias_safe_stmt(
  g : QbeGen,
  s : Stmt,
  elem_ty : Ty,
  hints : QbeProbeHints,
  arr_owned : Bool,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_match_arr_alias_safe_expr(g, init, elem_ty, hints, arr_owned)
    SLetTuple(_, _, init, _) =>
      qbe_match_arr_alias_safe_expr(g, init, elem_ty, hints, arr_owned)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_match_arr_alias_safe_expr(g, rhs, elem_ty, hints, arr_owned) {
        return false
      }
      match lhs {
        EIdent(_, _) =>
          if arr_owned {
            true
          } else {
            match qbe_probe_expr_ty_with(g, lhs, hints) {
              Some(dty) => qbe_ty_safe_dst_for_borrowed_arr(g, dty, elem_ty)
              None => false
            }
          }
        EField(obj, _, _) =>
          if !arr_owned {
            false
          } else {
            qbe_match_arr_alias_safe_expr(g, obj, elem_ty, hints, arr_owned)
          }
        EIndex(obj, idx, _) => {
          if !qbe_match_arr_alias_safe_expr(g, obj, elem_ty, hints, arr_owned) ||
            !qbe_match_arr_alias_safe_expr(g, idx, elem_ty, hints, arr_owned) {
            return false
          }
          match qbe_probe_expr_ty_with(g, obj, hints) {
            Some(TArray(e2)) | Some(TFixedArray(e2)) | Some(TImmArray(e2)) =>
              qbe_tys_strictly_distinct(e2, elem_ty)
            Some(TBytes) => true
            _ => false
          }
        }
        _ => false
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_match_arr_alias_safe_expr(g, cond, elem_ty, hints, arr_owned) &&
      qbe_match_arr_alias_safe_stmts(g, body, elem_ty, hints, arr_owned)
    SFor(init_s, cond, step_s, body, _) => {
      let local_hints = qbe_hints_copy(hints)
      if !qbe_match_arr_alias_safe_stmt(g, init_s, elem_ty, local_hints, arr_owned) {
        return false
      }
      match init_s {
        SLet(lname, _, te, init, let_sp) =>
          if lname != "_" {
            let mut bound_ty = TError
            match te {
              TyMissing(_) =>
                match qbe_let_infer(g, let_sp) {
                  Some(t) => bound_ty = t
                  None =>
                    match qbe_probe_expr_ty_with(g, init, local_hints) {
                      Some(t) =>
                        if !ty_has_unresolved(t) {
                          bound_ty = t
                        }
                      None => ()
                    }
                }
              _ => {
                let t = qbe_resolve_type(g, te)
                if !ty_has_unresolved(t) {
                  bound_ty = t
                }
              }
            }
            qbe_hints_set(local_hints, lname, bound_ty)
          }
        _ => ()
      }
      qbe_match_arr_alias_safe_expr(g, cond, elem_ty, local_hints, arr_owned) &&
      qbe_match_arr_alias_safe_stmt(g, step_s, elem_ty, local_hints, arr_owned) &&
      qbe_match_arr_alias_safe_stmts(g, body, elem_ty, local_hints, arr_owned)
    }
    SForRange(vname, start_e, end_e, _, body, _) => {
      if !qbe_match_arr_alias_safe_expr(g, start_e, elem_ty, hints, arr_owned) ||
        !qbe_match_arr_alias_safe_expr(g, end_e, elem_ty, hints, arr_owned) {
        return false
      }
      let body_hints = qbe_hints_copy(hints)
      qbe_hints_set(body_hints, vname, TInt)
      qbe_match_arr_alias_safe_stmts(g, body, elem_ty, body_hints, arr_owned)
    }
    SForIn(_, vname, iter_e, body, _) => {
      if !qbe_match_arr_alias_safe_expr(g, iter_e, elem_ty, hints, arr_owned) {
        return false
      }
      let body_hints = qbe_hints_copy(hints)
      let elem_hint = match qbe_probe_expr_ty_with(g, iter_e, hints) {
        Some(TArray(e)) | Some(TFixedArray(e)) | Some(TImmArray(e)) => e
        _ => TError
      }
      qbe_hints_set(body_hints, vname, elem_hint)
      qbe_match_arr_alias_safe_stmts(g, body, elem_ty, body_hints, arr_owned)
    }
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_match_arr_alias_safe_expr(g, e, elem_ty, hints, arr_owned)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_match_arr_alias_safe_expr(g, c, elem_ty, hints, arr_owned) &&
      qbe_match_arr_alias_safe_expr(g, m, elem_ty, hints, arr_owned)
    SExpr(e, _) => qbe_match_arr_alias_safe_expr(g, e, elem_ty, hints, arr_owned)
  }
}

///|
fn qbe_match_arr_alias_safe_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  elem_ty : Ty,
  outer_hints : QbeProbeHints,
  arr_owned : Bool,
) -> Bool {
  let local_hints = qbe_hints_copy(outer_hints)
  let mut i = 0
  while i < stmts.length() {
    if !qbe_match_arr_alias_safe_stmt(g, stmts[i], elem_ty, local_hints, arr_owned) {
      return false
    }
    match stmts[i] {
      SLet(lname, _, te, init, let_sp) =>
        if lname != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, local_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => {
              let t = qbe_resolve_type(g, te)
              if !ty_has_unresolved(t) {
                bound_ty = t
              }
            }
          }
          qbe_hints_set(local_hints, lname, bound_ty)
        }
      SLetTuple(lnames, te, init, _) => {
        let mut tup_elems : Array[Ty] = []
        match te {
          TyMissing(_) =>
            match qbe_probe_expr_ty_with(g, init, local_hints) {
              Some(TTuple(es)) => tup_elems = es
              _ => ()
            }
          _ =>
            match qbe_resolve_type(g, te) {
              TTuple(es) => tup_elems = es
              _ => ()
            }
        }
        let mut ni = 0
        while ni < lnames.length() {
          if lnames[ni] != "_" {
            let bt = if ni < tup_elems.length() && !ty_has_unresolved(tup_elems[ni]) {
              tup_elems[ni]
            } else {
              TError
            }
            qbe_hints_set(local_hints, lnames[ni], bt)
          }
          ni = ni + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_arr_is_stable_expr(
  e : Expr,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != aname
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) != aname &&
      qbe_arr_is_stable_expr(inner, aname, allow_elem_assign)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_arr_is_stable_expr(inner, aname, allow_elem_assign)
    EBinary(_, l, r, _) =>
      qbe_arr_is_stable_expr(l, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(r, aname, allow_elem_assign)
    EIndex(obj, idx, _) => {
      if !qbe_arr_is_stable_expr(idx, aname, allow_elem_assign) {
        return false
      }
      match obj {
        EIdent(n, _) => if n == aname { true } else { true }
        _ => qbe_arr_is_stable_expr(obj, aname, allow_elem_assign)
      }
    }
    EMethodCall(obj, mname, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_arr_is_stable_expr(args[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      match obj {
        EIdent(n, _) =>
          if n == aname {
            mname == "length" && args.length() == 0
          } else {
            true
          }
        _ => qbe_arr_is_stable_expr(obj, aname, allow_elem_assign)
      }
    }
    ECall(callee, args, _) => {
      if !qbe_arr_is_stable_expr(callee, aname, allow_elem_assign) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_arr_is_stable_expr(args[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_arr_is_stable_expr(elems[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_arr_is_stable_expr(b, aname, allow_elem_assign) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_arr_is_stable_expr(fields[i].value, aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_arr_is_stable_stmts(stmts, 0, aname, allow_elem_assign)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) ||
        !qbe_arr_is_stable_stmts(then_stmts, 0, aname, allow_elem_assign) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_arr_is_stable_expr(el, aname, allow_elem_assign)
      }
    }
    EIs(scrut, _, _) => qbe_arr_is_stable_expr(scrut, aname, allow_elem_assign)
    EMatch(scrut, arms, _) => {
      if !qbe_arr_is_stable_expr(scrut, aname, allow_elem_assign) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, aname) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_arr_is_stable_expr(ge, aname, allow_elem_assign) {
                return false
              }
            None => ()
          }
          if !qbe_arr_is_stable_expr(arms[i].body, aname, allow_elem_assign) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      !qbe_expr_mentions_ident(e, aname)
  }
}

///|
fn qbe_arr_is_stable_stmt(
  s : Stmt,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_arr_is_stable_expr(init, aname, allow_elem_assign)
    SLetTuple(_, _, init, _) =>
      qbe_arr_is_stable_expr(init, aname, allow_elem_assign)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_arr_is_stable_expr(rhs, aname, allow_elem_assign) {
        return false
      }
      match lhs {
        EIdent(n, _) => n != aname
        EIndex(EIdent(n, _), idx, _) =>
          if n == aname {
            allow_elem_assign &&
            qbe_arr_is_stable_expr(idx, aname, allow_elem_assign)
          } else {
            qbe_arr_is_stable_expr(idx, aname, allow_elem_assign)
          }
        _ => qbe_arr_is_stable_expr(lhs, aname, allow_elem_assign)
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_arr_is_stable_stmt(init_s, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmt(step_s, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_arr_is_stable_expr(start_e, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(end_e, aname, allow_elem_assign) &&
      (vname == aname || qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_arr_is_stable_expr(iter_e, aname, allow_elem_assign) &&
      (vname == aname || qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_arr_is_stable_expr(e, aname, allow_elem_assign)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_arr_is_stable_expr(c, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(m, aname, allow_elem_assign)
    SExpr(e, _) => qbe_arr_is_stable_expr(e, aname, allow_elem_assign)
  }
}

///|
fn qbe_arr_is_stable_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_arr_is_stable_expr(init, aname, allow_elem_assign) {
          return false
        }
        if lname == aname {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_arr_is_stable_expr(init, aname, allow_elem_assign) {
          return false
        }
        if str_arr_contains(lnames, aname) {
          return true
        }
      }
      _ =>
        if !qbe_arr_is_stable_stmt(stmts[i], aname, allow_elem_assign) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
fn qbe_collect_indexed_arrs_expr(e : Expr, out : Array[String]) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_collect_indexed_arrs_expr(inner, out)
    EBinary(_, l, r, _) => {
      qbe_collect_indexed_arrs_expr(l, out)
      qbe_collect_indexed_arrs_expr(r, out)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) =>
          if !str_arr_contains(out, aname) {
            out.push(aname)
          }
        _ => qbe_collect_indexed_arrs_expr(obj, out)
      }
      qbe_collect_indexed_arrs_expr(idx, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_indexed_arrs_expr(callee, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_indexed_arrs_expr(args[i], out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_indexed_arrs_expr(obj, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_indexed_arrs_expr(args[i], out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_indexed_arrs_expr(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_indexed_arrs_expr(fields[i].value, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_indexed_arrs_stmts(stmts, out)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmts(then_stmts, out)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_indexed_arrs_expr(el, out)
      }
    }
    EIs(scrut, _, _) => qbe_collect_indexed_arrs_expr(scrut, out)
    EMatch(scrut, arms, _) => {
      qbe_collect_indexed_arrs_expr(scrut, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_indexed_arrs_expr(ge, out)
          None => ()
        }
        qbe_collect_indexed_arrs_expr(arms[i].body, out)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) => ()
  }
}

///|
fn qbe_collect_indexed_arrs_stmt(s : Stmt, out : Array[String]) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_indexed_arrs_expr(init, out)
    SLetTuple(_, _, init, _) => qbe_collect_indexed_arrs_expr(init, out)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_indexed_arrs_expr(lhs, out)
      qbe_collect_indexed_arrs_expr(rhs, out)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_indexed_arrs_stmt(init_s, out)
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmt(step_s, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_indexed_arrs_expr(start_e, out)
      qbe_collect_indexed_arrs_expr(end_e, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_indexed_arrs_expr(iter_e, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_indexed_arrs_expr(e, out)
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_indexed_arrs_expr(c, out)
      qbe_collect_indexed_arrs_expr(m, out)
    }
    SExpr(e, _) => qbe_collect_indexed_arrs_expr(e, out)
  }
}

///|
fn qbe_collect_indexed_arrs_stmts(stmts : Array[Stmt], out : Array[String]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_indexed_arrs_stmt(stmts[i], out)
    i = i + 1
  }
}

///|
fn qbe_inc_count_by(counts : Map[String, Int], name : String, weight : Int) -> Unit {
  match counts.get(name) {
    Some(c) => counts.set(name, c + weight)
    None => counts.set(name, weight)
  }
}

///|
fn qbe_collect_loop_idx_expr(
  e : Expr,
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_collect_loop_idx_expr(inner, arrs, counts, strs, weight)
    EBinary(_, l, r, _) => {
      qbe_collect_loop_idx_expr(l, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(r, arrs, counts, strs, weight)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) => {
          if !str_arr_contains(arrs, aname) {
            arrs.push(aname)
          }
          qbe_inc_count_by(counts, aname, weight)
        }
        _ => qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
      }
      qbe_collect_loop_idx_expr(idx, arrs, counts, strs, weight)
    }
    ECall(callee, args, _) => {
      qbe_collect_loop_idx_expr(callee, arrs, counts, strs, weight)
      let mut i = 0
      while i < args.length() {
        qbe_collect_loop_idx_expr(args[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if (mname == "code_unit_at" && args.length() == 1) ||
        (mname == "read_i8" && args.length() == 1) ||
        (mname == "read_f32_le" && args.length() == 1) ||
        (mname == "length" && args.length() == 0) ||
        (mname == "is_empty" && args.length() == 0) {
        match obj {
          EIdent(sname, _) =>
            if !str_arr_contains(strs, sname) {
              strs.push(sname)
            }
          _ => qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
        }
      } else {
        qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
      }
      let mut i = 0
      while i < args.length() {
        qbe_collect_loop_idx_expr(args[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_loop_idx_expr(elems[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_loop_idx_expr(fields[i].value, arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_loop_idx_stmts(stmts, arrs, counts, strs, weight)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(then_stmts, arrs, counts, strs, 1)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_loop_idx_expr(el, arrs, counts, strs, 1)
      }
    }
    EIs(scrut, _, _) => qbe_collect_loop_idx_expr(scrut, arrs, counts, strs, weight)
    EMatch(scrut, arms, _) => {
      qbe_collect_loop_idx_expr(scrut, arrs, counts, strs, weight)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_loop_idx_expr(ge, arrs, counts, strs, 1)
          None => ()
        }
        qbe_collect_loop_idx_expr(arms[i].body, arrs, counts, strs, 1)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) => ()
  }
}

///|
fn qbe_collect_loop_idx_stmt(
  s : Stmt,
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_loop_idx_expr(init, arrs, counts, strs, weight)
    SLetTuple(_, _, init, _) => qbe_collect_loop_idx_expr(init, arrs, counts, strs, weight)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_loop_idx_expr(lhs, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(rhs, arrs, counts, strs, weight)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_loop_idx_stmt(init_s, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmt(step_s, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_loop_idx_expr(start_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(end_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_loop_idx_expr(iter_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_loop_idx_expr(e, arrs, counts, strs, weight)
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_loop_idx_expr(c, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(m, arrs, counts, strs, weight)
    }
    SExpr(e, _) => qbe_collect_loop_idx_expr(e, arrs, counts, strs, weight)
  }
}

///|
fn qbe_collect_loop_idx_stmts(
  stmts : Array[Stmt],
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_loop_idx_stmt(stmts[i], arrs, counts, strs, weight)
    i = i + 1
  }
}

///|
fn qbe_expr_count_mentions(e : Expr, name : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 0
    EIdent(n, _) => if n == name { 1 } else { 0 }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_count_mentions(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_count_mentions(l, name) + qbe_expr_count_mentions(r, name)
    ECall(callee, args, _) => {
      let mut tot = qbe_expr_count_mentions(callee, name)
      let mut i = 0
      while i < args.length() {
        tot = tot + qbe_expr_count_mentions(args[i], name)
        i = i + 1
      }
      tot
    }
    EMethodCall(obj, _, args, _) => {
      let mut tot = qbe_expr_count_mentions(obj, name)
      let mut i = 0
      while i < args.length() {
        tot = tot + qbe_expr_count_mentions(args[i], name)
        i = i + 1
      }
      tot
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut tot = 0
      let mut i = 0
      while i < elems.length() {
        tot = tot + qbe_expr_count_mentions(elems[i], name)
        i = i + 1
      }
      tot
    }
    EStructLit(_, spread, fields, _) => {
      let mut tot = match spread {
        Some(se) => qbe_expr_count_mentions(se, name)
        None => 0
      }
      let mut i = 0
      while i < fields.length() {
        tot = tot + qbe_expr_count_mentions(fields[i].value, name)
        i = i + 1
      }
      tot
    }
    EBlock(_, _) | EIf(_, _, _, _) | EMatch(_, _, _) | EIs(_, _, _) | EClosure(_, _, _, _) => 2
  }
}

///|
fn qbe_expr_is_straight_line_movable(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_is_straight_line_movable(inner)
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        false
      } else {
        qbe_expr_is_straight_line_movable(l) && qbe_expr_is_straight_line_movable(r)
      }
    EIndex(l, r, _) =>
      qbe_expr_is_straight_line_movable(l) && qbe_expr_is_straight_line_movable(r)
    ECall(callee, args, _) => {
      if !qbe_expr_is_straight_line_movable(callee) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_straight_line_movable(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_expr_is_straight_line_movable(obj) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_straight_line_movable(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_expr_is_straight_line_movable(elems[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread, fields, _) => {
      match spread {
        Some(se) =>
          if !qbe_expr_is_straight_line_movable(se) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_expr_is_straight_line_movable(fields[i].value) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(_, _) | EIf(_, _, _, _) | EMatch(_, _, _) | EIs(_, _, _) | EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      false
  }
}

///|
fn qbe_is_double_two(e : Expr) -> Bool {
  match e {
    EDouble(raw, _) => raw == "2.0" || raw == "2." || raw == "2.00" || raw == "2.000"
    _ => false
  }
}

///|
fn qbe_is_pure_builtin_method(recv_ty : Ty, mname : String, nargs : Int) -> Bool {
  match recv_ty {
    TInt =>
      (nargs == 0 &&
      (mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_uint" ||
      mname == "reinterpret_as_uint" ||
      mname == "to_double" ||
      mname == "to_float" ||
      mname == "abs" ||
      mname == "unsafe_to_char" ||
      mname == "to_byte" ||
      mname == "to_int8" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "count_ones" ||
      mname == "lnot")) ||
      (nargs == 1 && (mname == "rotate_left" || mname == "rotate_right"))
    TInt64 =>
      (nargs == 0 &&
      (mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_uint64" ||
      mname == "reinterpret_as_uint64" ||
      mname == "to_double" ||
      mname == "abs" ||
      mname == "to_int8" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "count_ones" ||
      mname == "lnot")) ||
      (nargs == 1 && (mname == "rotate_left" || mname == "rotate_right"))
    TUInt =>
      (nargs == 0 &&
      (mname == "to_int" ||
      mname == "reinterpret_as_int" ||
      mname == "to_uint" ||
      mname == "to_int64" ||
      mname == "to_uint64" ||
      mname == "to_double" ||
      mname == "to_float" ||
      mname == "reinterpret_as_float" ||
      mname == "to_int8" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "count_ones" ||
      mname == "lnot")) ||
      (nargs == 1 && (mname == "rotate_left" || mname == "rotate_right"))
    TUInt64 =>
      (nargs == 0 &&
      (mname == "to_int" ||
      mname == "to_uint" ||
      mname == "to_int64" ||
      mname == "reinterpret_as_int64" ||
      mname == "to_uint64" ||
      mname == "to_double" ||
      mname == "reinterpret_as_double" ||
      mname == "to_int8" ||
      mname == "leading_zeros" ||
      mname == "trailing_zeros" ||
      mname == "count_ones" ||
      mname == "lnot")) ||
      (nargs == 1 && (mname == "rotate_left" || mname == "rotate_right"))
    TDouble =>
      (nargs == 0 &&
      (mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_float" ||
      mname == "to_int8" ||
      mname == "to_bits" ||
      mname == "reinterpret_as_int64" ||
      mname == "reinterpret_as_uint64" ||
      mname == "is_nan" ||
      mname == "is_inf" ||
      mname == "is_finite" ||
      mname == "abs" ||
      mname == "floor" ||
      mname == "ceil" ||
      mname == "round" ||
      mname == "trunc" ||
      mname == "sqrt" ||
      mname == "cbrt" ||
      mname == "exp" ||
      mname == "ln" ||
      mname == "sin" ||
      mname == "cos" ||
      mname == "tan" ||
      mname == "asin" ||
      mname == "acos" ||
      mname == "atan")) ||
      (nargs == 1 && (mname == "compare" || mname == "pow" || mname == "atan2"))
    TFloat =>
      (nargs == 0 &&
      (mname == "to_double" ||
      mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_int8" ||
      mname == "to_bits" ||
      mname == "reinterpret_as_int" ||
      mname == "reinterpret_as_uint" ||
      mname == "is_nan" ||
      mname == "is_inf" ||
      mname == "is_finite" ||
      mname == "abs" ||
      mname == "floor" ||
      mname == "ceil" ||
      mname == "round" ||
      mname == "trunc" ||
      mname == "sqrt" ||
      mname == "cbrt" ||
      mname == "exp" ||
      mname == "ln" ||
      mname == "sin" ||
      mname == "cos" ||
      mname == "tan" ||
      mname == "asin" ||
      mname == "acos" ||
      mname == "atan")) ||
      (nargs == 1 && (mname == "pow" || mname == "atan2"))
    TByte =>
      nargs == 0 && (mname == "to_int" || mname == "to_int8")
    TInt8 =>
      nargs == 0 &&
      (mname == "to_int" ||
      mname == "to_int64" ||
      mname == "to_uint" ||
      mname == "to_uint64" ||
      mname == "to_byte" ||
      mname == "to_float" ||
      mname == "to_double")
    TChar => nargs == 0 && mname == "to_int"
    TBool => false
    TString =>
      (mname == "length" && nargs == 0) ||
      (mname == "code_unit_at" && nargs == 1)
    TBytes =>
      (mname == "length" && nargs == 0) ||
      ((mname == "read_i8" || mname == "read_f32_le") && nargs == 1)
    TStrView =>
      ((mname == "length" || mname == "is_empty") && nargs == 0) ||
      ((mname == "code_unit_at" || mname == "index_of_byte") && nargs == 1)
    TBytesView =>
      ((mname == "length" || mname == "is_empty") && nargs == 0) ||
      ((mname == "read_i8" || mname == "read_f32_le") && nargs == 1)
    TArray(_) | TFixedArray(_) | TImmArray(_) | TMap(_, _) =>
      (mname == "length" || mname == "is_empty") && nargs == 0
    _ => false
  }
}

///|
/// Conservative check: returns true only when `e` contains no calls (except pure built-in
/// math/conversion/length calls on statically known built-in receiver types)
/// and no closures/scope/spawn, guaranteeing zero hidden aliasing writes.
fn qbe_loop_has_no_calls_expr(g : QbeGen, e : Expr) -> Bool {
  qbe_loop_has_no_calls_expr_with(g, e, qbe_hints_new())
}

///|
fn qbe_loop_has_no_calls_expr_with(
  g : QbeGen,
  e : Expr,
  hints : QbeProbeHints,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_loop_has_no_calls_expr_with(g, inner, hints)
    EBinary(op, l, r, _) => {
      let work : Array[Expr] = [EBinary(op, l, r, expr_span(l))]
      while work.length() > 0 {
        match work.pop() {
          Some(cur) =>
            match cur {
              EBinary(cop, cl, cr, _) =>
                if cop == "&&" {
                  let lbinds : Array[String] = []
                  qbe_collect_cond_is_binds_arr(cl, lbinds)
                  if lbinds.length() > 0 {
                    if !qbe_loop_has_no_calls_expr_with(g, cl, hints) {
                      return false
                    }
                    let r_hints = qbe_hints_copy(hints)
                    let mut bi = 0
                    while bi < lbinds.length() {
                      qbe_hints_set(r_hints, lbinds[bi], TError)
                      bi = bi + 1
                    }
                    if !qbe_loop_has_no_calls_expr_with(g, cr, r_hints) {
                      return false
                    }
                  } else {
                    work.push(cr)
                    work.push(cl)
                  }
                } else if (cop == "==" || cop == "!=") && qbe_eq_op_may_call_custom(g, cl, cr, hints) {
                  return false
                } else {
                  work.push(cr)
                  work.push(cl)
                }
              _ =>
                if !qbe_loop_has_no_calls_expr_with(g, cur, hints) {
                  return false
                }
            }
          None => break
        }
      }
      true
    }
    EIndex(l, r, _) =>
      qbe_loop_has_no_calls_expr_with(g, l, hints) &&
      qbe_loop_has_no_calls_expr_with(g, r, hints)
    ECall(callee, args, _) =>
      match callee {
        EIdent(fname, _) => {
          match qbe_hints_get(hints, fname) {
            Some(_) => return false
            None => ()
          }
          match qbe_lookup_local(g, fname) {
            Some(_) => return false
            None => ()
          }
          if !qbe_has_user_callee(g, fname) &&
            (fname == "math_sqrt" ||
            fname == "math_cbrt" ||
            fname == "math_abs" ||
            fname == "math_floor" ||
            fname == "math_ceil" ||
            fname == "math_sin" ||
            fname == "math_cos" ||
            fname == "math_pow" ||
            fname == "math_tan" ||
            fname == "math_asin" ||
            fname == "math_acos" ||
            fname == "math_atan" ||
            fname == "math_atan2" ||
            fname == "math_exp" ||
            fname == "math_log" ||
            fname == "math_log1p" ||
            fname == "math_round" ||
            fname == "math_trunc" ||
            fname == "c_fn_ptr" ||
            fname == "str_data_ptr" ||
            fname == "bytes_data_ptr" ||
            fname == "array_data_ptr" ||
            fname == "fixed_array_data_ptr" ||
            fname == "ptr_read_f64" ||
            fname == "ptr_read_f32") {
            let mut i = 0
            while i < args.length() {
              if !qbe_loop_has_no_calls_expr_with(g, args[i], hints) {
                return false
              }
              i = i + 1
            }
            true
          } else {
            false
          }
        }
        _ => false
      }
    EMethodCall(obj, mname, args, msp) => {
      if qbe_has_expected_trait(g, msp) {
        return false
      }
      if !qbe_loop_has_no_calls_expr_with(g, obj, hints) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_loop_has_no_calls_expr_with(g, args[i], hints) {
          return false
        }
        i = i + 1
      }
      if mname == "contains" && qbe_contains_may_call_custom(g, obj, hints) {
        return false
      }
      match qbe_probe_expr_ty_with(g, obj, hints) {
        Some(raw_ty) =>
          qbe_is_pure_builtin_method(
            subst_ty(raw_ty, g.cur_type_subst),
            mname,
            args.length(),
          )
        None => false
      }
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) | EDotVariant(_, _, _) =>
      false
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_loop_has_no_calls_expr_with(g, elems[i], hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_loop_has_no_calls_expr_with(g, b, hints) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_loop_has_no_calls_expr_with(g, fields[i].value, hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_loop_has_no_calls_stmts_with(g, stmts, hints)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_loop_has_no_calls_expr_with(g, cond, hints) {
        return false
      }
      let cond_binds : Array[String] = []
      qbe_collect_cond_is_binds_arr(cond, cond_binds)
      let then_hints = if cond_binds.length() > 0 {
        let h2 = qbe_hints_copy(hints)
        let mut bi = 0
        while bi < cond_binds.length() {
          qbe_hints_set(h2, cond_binds[bi], TError)
          bi = bi + 1
        }
        h2
      } else {
        hints
      }
      if !qbe_loop_has_no_calls_stmts_with(g, then_stmts, then_hints) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_loop_has_no_calls_expr_with(g, el, hints)
      }
    }
    EIs(scrut, _, _) => qbe_loop_has_no_calls_expr_with(g, scrut, hints)
    EMatch(scrut, arms, _) => {
      if !qbe_loop_has_no_calls_expr_with(g, scrut, hints) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        let arm_binds : Array[String] = []
        qbe_collect_pat_binds_arr(arms[i].pat, arm_binds)
        let arm_hints = if arm_binds.length() > 0 {
          let h2 = qbe_hints_copy(hints)
          let mut bi = 0
          while bi < arm_binds.length() {
            qbe_hints_set(h2, arm_binds[bi], TError)
            bi = bi + 1
          }
          h2
        } else {
          hints
        }
        let body_hints = match arms[i].guard_expr {
          Some(ge) => {
            if !qbe_loop_has_no_calls_expr_with(g, ge, arm_hints) {
              return false
            }
            let gbinds : Array[String] = []
            qbe_collect_cond_is_binds_arr(ge, gbinds)
            if gbinds.length() > 0 {
              let bh = qbe_hints_copy(arm_hints)
              let mut gbi = 0
              while gbi < gbinds.length() {
                qbe_hints_set(bh, gbinds[gbi], TError)
                gbi = gbi + 1
              }
              bh
            } else {
              arm_hints
            }
          }
          None => arm_hints
        }
        if !qbe_loop_has_no_calls_expr_with(g, arms[i].body, body_hints) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

///|
fn qbe_collect_pat_binds_arr(pat : Pattern, out : Array[String]) -> Unit {
  match pat {
    PIdent(name, _) =>
      if name != "" && name != "_" {
        out.push(name)
      }
    PVariant(_, _, sub, _, _) | PTuple(sub, _) => {
      let mut i = 0
      while i < sub.length() {
        qbe_collect_pat_binds_arr(sub[i], out)
        i = i + 1
      }
    }
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
  }
}

///|
fn qbe_collect_cond_is_binds_arr(e : Expr, out : Array[String]) -> Unit {
  match e {
    EIs(_, pat, _) => qbe_collect_pat_binds_arr(pat, out)
    EBinary("&&", l, r, _) => {
      qbe_collect_cond_is_binds_arr(l, out)
      qbe_collect_cond_is_binds_arr(r, out)
    }
    _ => ()
  }
}

///|
fn qbe_loop_has_no_calls_stmt_with(
  g : QbeGen,
  s : Stmt,
  hints : QbeProbeHints,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_loop_has_no_calls_expr_with(g, init, hints)
    SLetTuple(_, _, init, _) => qbe_loop_has_no_calls_expr_with(g, init, hints)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_loop_has_no_calls_expr_with(g, lhs, hints) &&
      qbe_loop_has_no_calls_expr_with(g, rhs, hints)
    SWhile(cond, body, _) => {
      if !qbe_loop_has_no_calls_expr_with(g, cond, hints) {
        return false
      }
      let wbinds : Array[String] = []
      qbe_collect_cond_is_binds_arr(cond, wbinds)
      let body_hints = if wbinds.length() > 0 {
        let h2 = qbe_hints_copy(hints)
        let mut bi = 0
        while bi < wbinds.length() {
          qbe_hints_set(h2, wbinds[bi], TError)
          bi = bi + 1
        }
        h2
      } else {
        hints
      }
      qbe_loop_has_no_calls_stmts_with(g, body, body_hints)
    }
    SGuard(cond, body, _) =>
      qbe_loop_has_no_calls_expr_with(g, cond, hints) &&
      qbe_loop_has_no_calls_stmts_with(g, body, hints)
    SFor(init_s, cond, step_s, body, _) => {
      if !qbe_loop_has_no_calls_stmt_with(g, init_s, hints) {
        return false
      }
      let for_hints = match init_s {
        SLet(vn, _, _, _, _) =>
          if vn != "" && vn != "_" {
            let h2 = qbe_hints_copy(hints)
            qbe_hints_set(h2, vn, TError)
            h2
          } else {
            hints
          }
        SLetTuple(vns, _, _, _) => {
          let h2 = qbe_hints_copy(hints)
          let mut bi = 0
          while bi < vns.length() {
            if vns[bi] != "" && vns[bi] != "_" {
              qbe_hints_set(h2, vns[bi], TError)
            }
            bi = bi + 1
          }
          h2
        }
        _ => hints
      }
      qbe_loop_has_no_calls_expr_with(g, cond, for_hints) &&
      qbe_loop_has_no_calls_stmt_with(g, step_s, for_hints) &&
      qbe_loop_has_no_calls_stmts_with(g, body, for_hints)
    }
    SForRange(vname, start_e, end_e, _, body, _) => {
      if !qbe_loop_has_no_calls_expr_with(g, start_e, hints) ||
        !qbe_loop_has_no_calls_expr_with(g, end_e, hints) {
        return false
      }
      let bh = qbe_hints_copy(hints)
      qbe_hints_set(bh, vname, TInt)
      qbe_loop_has_no_calls_stmts_with(g, body, bh)
    }
    SForIn(idx_v, elem_v, iter_e, body, _) => {
      if !qbe_loop_has_no_calls_expr_with(g, iter_e, hints) {
        return false
      }
      let bh = qbe_hints_copy(hints)
      if idx_v != "" && idx_v != "_" {
        qbe_hints_set(bh, idx_v, TInt)
      }
      if elem_v != "" && elem_v != "_" {
        qbe_hints_set(bh, elem_v, TError)
      }
      qbe_loop_has_no_calls_stmts_with(g, body, bh)
    }
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_loop_has_no_calls_expr_with(g, e, hints)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_loop_has_no_calls_expr_with(g, c, hints) &&
      qbe_loop_has_no_calls_expr_with(g, m, hints)
    SExpr(e, _) => qbe_loop_has_no_calls_expr_with(g, e, hints)
  }
}

///|
fn qbe_loop_has_no_calls_stmts(g : QbeGen, stmts : Array[Stmt]) -> Bool {
  qbe_loop_has_no_calls_stmts_with(g, stmts, qbe_hints_new())
}

///|
fn qbe_loop_has_no_calls_stmts_with(
  g : QbeGen,
  stmts : Array[Stmt],
  outer_hints : QbeProbeHints,
) -> Bool {
  let local_hints = qbe_hints_copy(outer_hints)
  let mut i = 0
  while i < stmts.length() {
    if !qbe_loop_has_no_calls_stmt_with(g, stmts[i], local_hints) {
      return false
    }
    match stmts[i] {
      SLet(name, _, te, init, let_sp) =>
        if name != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, local_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => {
              let t = qbe_resolve_type(g, te)
              if !ty_has_unresolved(t) {
                bound_ty = t
              }
            }
          }
          qbe_hints_set(local_hints, name, bound_ty)
        }
      SLetTuple(names, te, init, _) => {
        let mut tup_elems : Array[Ty] = []
        match te {
          TyMissing(_) =>
            match qbe_probe_expr_ty_with(g, init, local_hints) {
              Some(TTuple(es)) => tup_elems = es
              _ => ()
            }
          _ =>
            match qbe_resolve_type(g, te) {
              TTuple(es) => tup_elems = es
              _ => ()
            }
        }
        let mut ni = 0
        while ni < names.length() {
          if names[ni] != "_" {
            let bt = if ni < tup_elems.length() && !ty_has_unresolved(tup_elems[ni]) {
              tup_elems[ni]
            } else {
              TError
            }
            qbe_hints_set(local_hints, names[ni], bt)
          }
          ni = ni + 1
        }
      }
      SGuard(cond, _, _) => {
        let gbinds : Array[String] = []
        qbe_collect_cond_is_binds_arr(cond, gbinds)
        let mut bi = 0
        while bi < gbinds.length() {
          qbe_hints_set(local_hints, gbinds[bi], TError)
          bi = bi + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_collect_written_fields_expr(e : Expr, out : Map[String, Bool]) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EMutArg(inner, _) => {
      qbe_mut_place_fields(inner, out)
      qbe_collect_written_fields_expr(inner, out)
    }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_written_fields_expr(inner, out)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_written_fields_expr(l, out)
      qbe_collect_written_fields_expr(r, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_written_fields_expr(callee, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_written_fields_expr(args[i], out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_written_fields_expr(obj, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_written_fields_expr(args[i], out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_written_fields_expr(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_written_fields_expr(fields[i].value, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_written_fields_stmts(stmts, out)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmts(then_stmts, out)
      match else_opt {
        Some(el) => qbe_collect_written_fields_expr(el, out)
        None => ()
      }
    }
    EIs(scrut, _, _) => qbe_collect_written_fields_expr(scrut, out)
    EMatch(scrut, arms, _) => {
      qbe_collect_written_fields_expr(scrut, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_written_fields_expr(ge, out)
          None => ()
        }
        qbe_collect_written_fields_expr(arms[i].body, out)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) => qbe_collect_written_fields_stmts(body, out)
  }
}

///|
fn qbe_collect_written_fields_stmt(s : Stmt, out : Map[String, Bool]) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_written_fields_expr(init, out)
    SLetTuple(_, _, init, _) => qbe_collect_written_fields_expr(init, out)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EField(_, fname, _) => out.set(fname, true)
        _ => ()
      }
      qbe_collect_written_fields_expr(lhs, out)
      qbe_collect_written_fields_expr(rhs, out)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_written_fields_stmt(init_s, out)
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmt(step_s, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_written_fields_expr(start_e, out)
      qbe_collect_written_fields_expr(end_e, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_written_fields_expr(iter_e, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_collect_written_fields_expr(e, out)
        None => ()
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_written_fields_expr(c, out)
      qbe_collect_written_fields_expr(m, out)
    }
    SExpr(e, _) => qbe_collect_written_fields_expr(e, out)
  }
}

///|
fn qbe_collect_written_fields_stmts(stmts : Array[Stmt], out : Map[String, Bool]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_written_fields_stmt(stmts[i], out)
    i = i + 1
  }
}

///|
fn qbe_collect_read_fields_expr(
  e : Expr,
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EField(obj, fname, _) =>
      match obj {
        EIdent(vname, _) => {
          let key = vname + "." + fname
          if !seen.contains(key) {
            seen.set(key, true)
            out_vars.push(vname)
            out_fields.push(fname)
          }
        }
        _ => qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_collect_read_fields_expr(inner, out_vars, out_fields, seen)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_read_fields_expr(l, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(r, out_vars, out_fields, seen)
    }
    ECall(callee, args, _) => {
      qbe_collect_read_fields_expr(callee, out_vars, out_fields, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_read_fields_expr(args[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_read_fields_expr(args[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_read_fields_expr(elems[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_read_fields_expr(fields[i].value, out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EBlock(stmts, _) =>
      qbe_collect_read_fields_stmts(stmts, out_vars, out_fields, seen)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(then_stmts, out_vars, out_fields, seen)
      match else_opt {
        Some(el) => qbe_collect_read_fields_expr(el, out_vars, out_fields, seen)
        None => ()
      }
    }
    EIs(scrut, _, _) => qbe_collect_read_fields_expr(scrut, out_vars, out_fields, seen)
    EMatch(scrut, arms, _) => {
      qbe_collect_read_fields_expr(scrut, out_vars, out_fields, seen)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_read_fields_expr(ge, out_vars, out_fields, seen)
          None => ()
        }
        qbe_collect_read_fields_expr(arms[i].body, out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) =>
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
  }
}

///|
fn qbe_collect_read_fields_stmt(
  s : Stmt,
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_read_fields_expr(init, out_vars, out_fields, seen)
    SLetTuple(_, _, init, _) =>
      qbe_collect_read_fields_expr(init, out_vars, out_fields, seen)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EField(obj, _, _) =>
          qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
        _ => qbe_collect_read_fields_expr(lhs, out_vars, out_fields, seen)
      }
      qbe_collect_read_fields_expr(rhs, out_vars, out_fields, seen)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_read_fields_stmt(init_s, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmt(step_s, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_read_fields_expr(start_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(end_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_read_fields_expr(iter_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_collect_read_fields_expr(e, out_vars, out_fields, seen)
        None => ()
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_read_fields_expr(c, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(m, out_vars, out_fields, seen)
    }
    SExpr(e, _) => qbe_collect_read_fields_expr(e, out_vars, out_fields, seen)
  }
}

///|
fn qbe_collect_read_fields_stmts(
  stmts : Array[Stmt],
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_read_fields_stmt(stmts[i], out_vars, out_fields, seen)
    i = i + 1
  }
}

///|
fn qbe_expr_rebinds_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) == name || qbe_expr_rebinds_ident(inner, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_rebinds_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_rebinds_ident(l, name) || qbe_expr_rebinds_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_rebinds_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_rebinds_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_rebinds_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_rebinds_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_rebinds_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(sp_e) => if qbe_expr_rebinds_ident(sp_e, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_rebinds_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_rebinds_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_rebinds_ident(cond, name) || qbe_stmts_rebinds_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_rebinds_ident(el, name)
      }
    }
    EIs(scrut, pat, _) => qbe_expr_rebinds_ident(scrut, name) || qbe_pat_binds_name(pat, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_rebinds_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_rebinds_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_pat_binds_name(arms[i].pat, name) ||
          qbe_expr_rebinds_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_rebinds_ident(body, name)
  }
}

///|
fn qbe_stmt_rebinds_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(n, _, _, init, _) => n == name || qbe_expr_rebinds_ident(init, name)
    SLetTuple(ns, _, init, _) =>
      str_arr_contains(ns, name) || qbe_expr_rebinds_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_rebinds_ident(lhs, name) || qbe_expr_rebinds_ident(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_rebinds_ident(cond, name) || qbe_stmts_rebinds_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_rebinds_ident(init_s, name) ||
      qbe_expr_rebinds_ident(cond, name) ||
      qbe_stmt_rebinds_ident(step_s, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      vname == name ||
      qbe_expr_rebinds_ident(start_e, name) ||
      qbe_expr_rebinds_ident(end_e, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SForIn(_, vname, iter_e, body, _) =>
      vname == name ||
      qbe_expr_rebinds_ident(iter_e, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_rebinds_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_rebinds_ident(c, name) || qbe_expr_rebinds_ident(m, name)
    SExpr(e, _) => qbe_expr_rebinds_ident(e, name)
  }
}

///|
fn qbe_stmts_rebinds_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_rebinds_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_stmt_is_inc_by_one(s : Stmt, name : String) -> Bool {
  match s {
    SAssign(EIdent(lhs_n, _), EBinary("+", EIdent(rhs_n, _), EInt(raw, _), _), _) =>
      lhs_n == name && rhs_n == name && qbe_parse_int64_lit(raw) == 1L
    SCompoundAssign("+", EIdent(lhs_n, _), EInt(raw, _), _) =>
      lhs_n == name && qbe_parse_int64_lit(raw) == 1L
    _ => false
  }
}

///|
fn qbe_cond_node_count(e : Expr) -> Int {
  match e {
    EIdent(_, _)
    | EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EBool(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EByte(_, _)
    | EChar(_, _) => 1
    EField(EIdent(_, _), _, _) => 2
    EUnary(_, inner, _) => {
      let n = qbe_cond_node_count(inner)
      if n < 0 { -1 } else { n + 1 }
    }
    EBinary(_, lhs, rhs, _) => {
      let nl = qbe_cond_node_count(lhs)
      if nl < 0 {
        return -1
      }
      let nr = qbe_cond_node_count(rhs)
      if nr < 0 { -1 } else { nl + nr + 1 }
    }
    _ => -1
  }
}

///|
fn qbe_is_pure_small_cond(cond : Expr, max_nodes : Int) -> Bool {
  let n = qbe_cond_node_count(cond)
  n > 0 && n <= max_nodes
}

///|
fn qbe_expr_has_nested_loop(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_nested_loop(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_nested_loop(l) || qbe_expr_has_nested_loop(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_nested_loop(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_loop(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_nested_loop(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_loop(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_nested_loop(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_nested_loop(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_nested_loop(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_nested_loop(cond) || qbe_stmts_has_nested_loop(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_nested_loop(el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_nested_loop(scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_nested_loop(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_nested_loop(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_nested_loop(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_has_nested_loop(body)
  }
}

///|
fn qbe_stmt_has_nested_loop(s : Stmt) -> Bool {
  match s {
    SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) => true
    SGuard(cond, body, _) => qbe_expr_has_nested_loop(cond) || qbe_stmts_has_nested_loop(body)
    SLet(_, _, _, init, _) => qbe_expr_has_nested_loop(init)
    SLetTuple(_, _, init, _) => qbe_expr_has_nested_loop(init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_nested_loop(lhs) || qbe_expr_has_nested_loop(rhs)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_nested_loop(e)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_nested_loop(c) || qbe_expr_has_nested_loop(m)
    SExpr(e, _) => qbe_expr_has_nested_loop(e)
  }
}

///|
fn qbe_stmts_has_nested_loop(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_nested_loop(stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_has_cf(
  e : Expr,
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_cf(inner, check_break, check_cont, check_ret)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_cf(l, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(r, check_break, check_cont, check_ret)
    ECall(callee, args, _) => {
      if qbe_expr_has_cf(callee, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_cf(args[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_cf(obj, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_cf(args[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_cf(elems[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_cf(b, check_break, check_cont, check_ret) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_cf(fields[i].value, check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_cf(stmts, check_break, check_cont, check_ret)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
        qbe_stmts_has_cf(then_stmts, check_break, check_cont, check_ret) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_cf(el, check_break, check_cont, check_ret)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_cf(scrut, check_break, check_cont, check_ret)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_cf(scrut, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_cf(ge, check_break, check_cont, check_ret) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_cf(arms[i].body, check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    ETry(inner, _) =>
      check_ret || qbe_expr_has_cf(inner, check_break, check_cont, check_ret)
    EClosure(_, _, _, _) => false
  }
}

///|
fn qbe_stmt_has_cf(
  s : Stmt,
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  match s {
    SBreak(_) => check_break
    SContinue(_) => check_cont
    SReturn(opt, _) =>
      if check_ret {
        true
      } else {
        match opt {
          None => false
          Some(e) => qbe_expr_has_cf(e, check_break, check_cont, check_ret)
        }
      }
    SLet(_, _, _, init, _) =>
      qbe_expr_has_cf(init, check_break, check_cont, check_ret)
    SLetTuple(_, _, init, _) =>
      qbe_expr_has_cf(init, check_break, check_cont, check_ret)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_cf(lhs, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(rhs, check_break, check_cont, check_ret)
    SGuard(cond, body, _) =>
      qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, check_break, check_cont, check_ret)
    // `break` / `continue` of an enclosing loop cannot appear in a `while` /
    // C-style `for` condition or step (rejected by the type checker): only
    // `init` (and range bounds / iterables below) can hold them.
    SWhile(cond, body, _) =>
      qbe_expr_has_cf(cond, false, false, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_has_cf(init_s, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(cond, false, false, check_ret) ||
      qbe_stmt_has_cf(step_s, false, false, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_cf(start_e, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(end_e, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_cf(iter_e, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SDebugAssert(c, m, _) =>
      qbe_expr_has_cf(c, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(m, check_break, check_cont, check_ret)
    SExpr(e, _) => qbe_expr_has_cf(e, check_break, check_cont, check_ret)
  }
}

///|
fn qbe_stmts_has_cf(
  stmts : Array[Stmt],
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_cf(stmts[i], check_break, check_cont, check_ret) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_has_call_or_try(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_)
    | EClosure(_, _, _, _) => false
    ETry(_, _) | ECall(_, _, _) | EMethodCall(_, _, _, _) => true
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_has_call_or_try(inner)
    EBinary(_, l, r, _)
    | EIndex(l, r, _)
    | EScope(l, r, _)
    | ESpawn(l, r, _) =>
      qbe_expr_has_call_or_try(l) || qbe_expr_has_call_or_try(r)
    EArrayLit(elems, _)
    | ETuple(elems, _)
    | EInterp(elems, _)
    | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_call_or_try(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_call_or_try(b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_call_or_try(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_call_or_try(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_call_or_try(cond) || qbe_stmts_has_call_or_try(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_call_or_try(el)
      }
    }
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_call_or_try(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_call_or_try(ge) { return true }
          None => ()
        }
        if qbe_expr_has_call_or_try(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_stmt_has_call_or_try(s : Stmt) -> Bool {
  match s {
    SBreak(_) | SContinue(_) => false
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_call_or_try(e)
      }
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
      qbe_expr_has_call_or_try(init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) | SDebugAssert(lhs, rhs, _) =>
      qbe_expr_has_call_or_try(lhs) || qbe_expr_has_call_or_try(rhs)
    SGuard(cond, body, _) | SWhile(cond, body, _) =>
      qbe_expr_has_call_or_try(cond) || qbe_stmts_has_call_or_try(body)
    SFor(init, cond, step, body, _) =>
      qbe_stmt_has_call_or_try(init) ||
      qbe_expr_has_call_or_try(cond) ||
      qbe_stmt_has_call_or_try(step) ||
      qbe_stmts_has_call_or_try(body)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_call_or_try(start_e) ||
      qbe_expr_has_call_or_try(end_e) ||
      qbe_stmts_has_call_or_try(body)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_call_or_try(iter_e) || qbe_stmts_has_call_or_try(body)
  }
}

///|
fn qbe_stmts_has_call_or_try(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_call_or_try(stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_params_have_ret_default(params : Array[Param]) -> Bool {
  let mut i = 0
  while i < params.length() {
    match params[i].default_expr {
      Some(de) =>
        if qbe_expr_has_cf(de, false, false, true) || qbe_expr_has_call_or_try(de) {
          return true
        }
      None => ()
    }
    i = i + 1
  }
  false
}

///|
fn qbe_method_key_matches(mk : String, mname : String) -> Bool {
  if mk == mname {
    return true
  }
  let suffix = "::" + mname
  let mlen = mk.length()
  let slen = suffix.length()
  mlen >= slen && slice_str(mk, mlen - slen, mlen) == suffix
}

///|
/// Adds to `out` every method name `mname` whose lookup in `tc` finds params with a
/// `return`-capable default: for each such `method_names` key `mk`, `mk` itself and
/// every suffix after a `::` (exactly the `mname`s `qbe_method_key_matches(mk, _)`
/// accepts); for each such impl method, its name.
fn qbe_collect_ret_default_methods(tc : TypeChecker, out : Map[String, Bool]) -> Unit {
  let mut i = 0
  while i < tc.method_names.length() {
    let mk = tc.method_names[i]
    match tc.methods.get(mk) {
      Some(mi) =>
        if qbe_params_have_ret_default(mi.decl.params) {
          out.set(mk, true)
          let mlen = mk.length()
          let mut p = 0
          while p + 2 <= mlen {
            if slice_str(mk, p, p + 2) == "::" {
              out.set(slice_str(mk, p + 2, mlen), true)
            }
            p = p + 1
          }
        }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < tc.impl_keys.length() {
    match tc.impls.get(tc.impl_keys[i]) {
      Some(ii) => {
        let names = ii.methods.keys()
        let mut j = 0
        while j < names.length() {
          match ii.methods.get(names[j]) {
            Some(mi) =>
              if qbe_params_have_ret_default(mi.decl.params) {
                out.set(names[j], true)
              }
            None => ()
          }
          j = j + 1
        }
      }
      None => ()
    }
    i = i + 1
  }
}

///|
/// Built once per `QbeGen`: the type checkers are complete before codegen starts,
/// so the per-call scan over every package's methods and impls (hot on deeply
/// nested call trees through `qbe_arg_guards`) becomes one map lookup.
fn qbe_ret_default_methods(g : QbeGen) -> Map[String, Bool] {
  match g.ret_default_methods {
    Some(m) => return m
    None => ()
  }
  let m : Map[String, Bool] = Map([])
  qbe_collect_ret_default_methods(g.tc, m)
  let mut pi = 0
  while pi < g.tc.all_imported_pkg_names.length() {
    match g.tc.all_imported_pkgs.get(g.tc.all_imported_pkg_names[pi]) {
      Some(ipkg) => qbe_collect_ret_default_methods(ipkg.tc, m)
      None => ()
    }
    pi = pi + 1
  }
  g.ret_default_methods = Some(m)
  m
}

///|
fn qbe_any_method_has_ret_default(g : QbeGen, mname : String) -> Bool {
  qbe_ret_default_methods(g).contains(mname)
}

///|
fn qbe_expr_has_default_ret(g : QbeGen, e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_)
    | EClosure(_, _, _, _) => false
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_has_default_ret(g, inner)
    ETry(_, _) => true
    EBinary(_, l, r, _)
    | EIndex(l, r, _)
    | EScope(l, r, _)
    | ESpawn(l, r, _) =>
      qbe_expr_has_default_ret(g, l) || qbe_expr_has_default_ret(g, r)
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => {
          if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(mpkg) =>
                match mpkg.tc.fns.get(name) {
                  Some(fi) =>
                    if qbe_params_have_ret_default(fi.decl.params) {
                      return true
                    }
                  None => ()
                }
              None => ()
            }
          }
          match g.tc.fns.get(name) {
            Some(fi) =>
              if qbe_params_have_ret_default(fi.decl.params) {
                return true
              }
            None => ()
          }
        }
        EPath(qual, mem, _) => {
          match qbe_resolve_pkg_in_scope(g, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(fi) =>
                  if qbe_params_have_ret_default(fi.decl.params) {
                    return true
                  }
                None => ()
              }
            None => ()
          }
          if qbe_any_method_has_ret_default(g, mem) {
            return true
          }
        }
        _ => ()
      }
      if qbe_expr_has_default_ret(g, callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_default_ret(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if qbe_any_method_has_ret_default(g, mname) {
        return true
      }
      if qbe_expr_has_default_ret(g, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_default_ret(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _)
    | ETuple(elems, _)
    | EInterp(elems, _)
    | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_default_ret(g, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_default_ret(g, b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_default_ret(g, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_default_ret(g, stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_default_ret(g, cond) ||
        qbe_stmts_has_default_ret(g, then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_default_ret(g, el)
      }
    }
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_default_ret(g, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_default_ret(g, ge) { return true }
          None => ()
        }
        if qbe_expr_has_default_ret(g, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_stmt_has_default_ret(g : QbeGen, s : Stmt) -> Bool {
  match s {
    SBreak(_) | SContinue(_) => false
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_default_ret(g, e)
      }
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
      qbe_expr_has_default_ret(g, init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) | SDebugAssert(lhs, rhs, _) =>
      qbe_expr_has_default_ret(g, lhs) || qbe_expr_has_default_ret(g, rhs)
    SGuard(cond, body, _) | SWhile(cond, body, _) =>
      qbe_expr_has_default_ret(g, cond) || qbe_stmts_has_default_ret(g, body)
    SFor(init, cond, step, body, _) =>
      qbe_stmt_has_default_ret(g, init) ||
      qbe_expr_has_default_ret(g, cond) ||
      qbe_stmt_has_default_ret(g, step) ||
      qbe_stmts_has_default_ret(g, body)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_default_ret(g, start_e) ||
      qbe_expr_has_default_ret(g, end_e) ||
      qbe_stmts_has_default_ret(g, body)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_default_ret(g, iter_e) || qbe_stmts_has_default_ret(g, body)
  }
}

///|
fn qbe_stmts_has_default_ret(g : QbeGen, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_default_ret(g, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_invalidate_known_min_len_if_dyn(g : QbeGen, name : String) -> Unit {
  if !g.known_min_len_arrs.contains(name) {
    return
  }
  match qbe_lookup_local(g, name) {
    Some(loc) =>
      match loc.ty {
        TFixedArray(_) | TImmArray(_) | TString | TBytes => ()
        _ => g.known_min_len_arrs.remove(name)
      }
    None => g.known_min_len_arrs.remove(name)
  }
}

///|
fn qbe_eval_const_int_expr(g : QbeGen, e : Expr) -> Option[Int] {
  match e {
    EInt(raw, _) => Some(qbe_parse_int64_lit(raw).to_int())
    EIdent(name, _) =>
      if g.mono_pkg == "" {
        match qbe_lookup_local(g, name) {
          Some(_) => None
          None => g.const_int_vals.get(name)
        }
      } else {
        None
      }
    _ => None
  }
}

///|
fn qbe_is_builtin_len_call(
  g : QbeGen,
  recv : Expr,
  mname : String,
  margs : Array[Expr],
  sp : Span,
) -> Bool {
  if mname != "length" || margs.length() != 0 || qbe_has_expected_trait(g, sp) {
    return false
  }
  match qbe_probe_expr_ty(g, recv) {
    Some(TString)
    | Some(TArray(_))
    | Some(TFixedArray(_))
    | Some(TImmArray(_))
    | Some(TBytes)
    | Some(TStrView)
    | Some(TBytesView)
    | Some(TMap(_, _)) => true
    _ => false
  }
}

///|
fn qbe_expr_as_len_target(g : QbeGen, e : Expr) -> String {
  let cand = match e {
    EMethodCall(recv_e, mn, ma, msp) =>
      if qbe_is_builtin_len_call(g, recv_e, mn, ma, msp) {
        match recv_e {
          EIdent(an, _) => an
          _ => ""
        }
      } else {
        ""
      }
    EIdent(n_name, _) =>
      match g.len_aliases.get(n_name) {
        Some(an) => an
        None => ""
      }
    _ => ""
  }
  if cand == "" {
    return ""
  }
  match qbe_lookup_local(g, cand) {
    Some(loc) =>
      if !loc.is_cell {
        match loc.ty {
          TFixedArray(_) | TImmArray(_) | TArray(_) | TString | TBytes => cand
          _ => ""
        }
      } else {
        ""
      }
    None => ""
  }
}

///|
fn qbe_collect_pos_min_lens(
  g : QbeGen,
  cond : Expr,
  out_names : Array[String],
  out_mins : Array[Int],
) -> Unit {
  match cond {
    EBinary("&&", l, r, _) => {
      qbe_collect_pos_min_lens(g, l, out_names, out_mins)
      qbe_collect_pos_min_lens(g, r, out_names, out_mins)
    }
    EBinary(">=", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, lhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an)
              out_mins.push(k)
            }
          None => ()
        }
      }
    }
    EBinary("==", lhs, rhs, _) => {
      let an_l = qbe_expr_as_len_target(g, lhs)
      if an_l != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an_l)
              out_mins.push(k)
            }
          None => ()
        }
      } else {
        let an_r = qbe_expr_as_len_target(g, rhs)
        if an_r != "" {
          match qbe_eval_const_int_expr(g, lhs) {
            Some(k) =>
              if k >= 1 {
                out_names.push(an_r)
                out_mins.push(k)
              }
            None => ()
          }
        }
      }
    }
    EBinary(">", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, lhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 0 && k < 2147483647 {
              out_names.push(an)
              out_mins.push(k + 1)
            }
          None => ()
        }
      }
    }
    EBinary("<=", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, rhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, lhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an)
              out_mins.push(k)
            }
          None => ()
        }
      }
    }
    EBinary("<", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, rhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, lhs) {
          Some(k) =>
            if k >= 0 && k < 2147483647 {
              out_names.push(an)
              out_mins.push(k + 1)
            }
          None => ()
        }
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_neg_min_lens(
  g : QbeGen,
  cond : Expr,
  out_names : Array[String],
  out_mins : Array[Int],
) -> Unit {
  match cond {
    EBinary("||", l, r, _) => {
      qbe_collect_neg_min_lens(g, l, out_names, out_mins)
      qbe_collect_neg_min_lens(g, r, out_names, out_mins)
    }
    EBinary("<", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, lhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an)
              out_mins.push(k)
            }
          None => ()
        }
      }
    }
    EBinary("!=", lhs, rhs, _) => {
      let an_l = qbe_expr_as_len_target(g, lhs)
      if an_l != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an_l)
              out_mins.push(k)
            }
          None => ()
        }
      } else {
        let an_r = qbe_expr_as_len_target(g, rhs)
        if an_r != "" {
          match qbe_eval_const_int_expr(g, lhs) {
            Some(k) =>
              if k >= 1 {
                out_names.push(an_r)
                out_mins.push(k)
              }
            None => ()
          }
        }
      }
    }
    EBinary("<=", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, lhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, rhs) {
          Some(k) =>
            if k >= 0 && k < 2147483647 {
              out_names.push(an)
              out_mins.push(k + 1)
            }
          None => ()
        }
      }
    }
    EBinary(">", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, rhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, lhs) {
          Some(k) =>
            if k >= 1 {
              out_names.push(an)
              out_mins.push(k)
            }
          None => ()
        }
      }
    }
    EBinary(">=", lhs, rhs, _) => {
      let an = qbe_expr_as_len_target(g, rhs)
      if an != "" {
        match qbe_eval_const_int_expr(g, lhs) {
          Some(k) =>
            if k >= 0 && k < 2147483647 {
              out_names.push(an)
              out_mins.push(k + 1)
            }
          None => ()
        }
      }
    }
    _ => ()
  }
}

///|
fn qbe_cond_min_len_safe(g : QbeGen, cond : Expr, nm : String) -> Bool {
  if qbe_expr_assigns_ident(cond, nm) {
    return false
  }
  match qbe_lookup_local(g, nm) {
    Some(loc) =>
      match loc.ty {
        TArray(_) => qbe_arr_is_stable_expr(cond, nm, true)
        _ => true
      }
    None => false
  }
}

///|
fn qbe_apply_min_lens(
  g : QbeGen,
  cond : Expr,
  names : Array[String],
  mins : Array[Int],
) -> Unit {
  let mut i = 0
  while i < names.length() {
    let nm = names[i]
    if qbe_cond_min_len_safe(g, cond, nm) {
      let ml = mins[i]
      let cur = match g.known_min_len_arrs.get(nm) {
        Some(v) => v
        None => 0
      }
      if ml > cur {
        g.known_min_len_arrs.set(nm, ml)
      }
    }
    i = i + 1
  }
}

///|
fn qbe_stmt_const_inc_step(s : Stmt, name : String) -> Int {
  match s {
    SAssign(EIdent(lhs_n, _), EBinary("+", EIdent(rhs_n, _), EInt(raw, _), _), _) =>
      if lhs_n == name && rhs_n == name {
        let v = qbe_parse_int64_lit(raw)
        if v >= 1L && v <= 32L { v.to_int() } else { 0 }
      } else {
        0
      }
    SCompoundAssign("+", EIdent(lhs_n, _), EInt(raw, _), _) =>
      if lhs_n == name {
        let v = qbe_parse_int64_lit(raw)
        if v >= 1L && v <= 32L { v.to_int() } else { 0 }
      } else {
        0
      }
    _ => 0
  }
}

///|
/// Collect provably overflow-free `iv <= len(x) - K` (0 <= c < K) and
/// `iv < len(x) - K` (0 <= c <= K) window BCE keys for a `then` block.
fn qbe_collect_pos_window_bce(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
  out_keys : Array[String],
) -> Unit {
  match cond {
    EBinary("&&", l, r, _) => {
      qbe_collect_pos_window_bce(g, l, body, out_keys)
      qbe_collect_pos_window_bce(g, r, body, out_keys)
    }
    EBinary(op, EIdent(iv, _), EBinary("-", len_e, k_e, _), _) =>
      if op == "<=" || op == "<" {
        let mut iv_ok = false
        match qbe_lookup_local(g, iv) {
          Some(iloc) =>
            match iloc.ty {
              TInt =>
                match g.nonneg_vars.get(iv) {
                  Some(true) => iv_ok = true
                  _ => ()
                }
              _ => ()
            }
          None => ()
        }
        let arr = qbe_expr_as_len_target(g, len_e)
        let arr_stable = if arr == "" {
          false
        } else {
          match qbe_lookup_local(g, arr) {
            Some(aloc) =>
              match aloc.ty {
                TArray(_) =>
                  qbe_arr_is_stable_expr(cond, arr, true) &&
                  qbe_arr_is_stable_stmts(body, 0, arr, true)
                _ =>
                  !qbe_expr_assigns_ident(cond, arr) &&
                  !qbe_stmts_assigns_ident(body, arr) &&
                  !qbe_stmts_rebinds_ident(body, arr)
              }
            None => false
          }
        }
        if iv_ok &&
          arr_stable &&
          !qbe_expr_assigns_ident(cond, iv) &&
          !qbe_stmts_assigns_ident(body, iv) &&
          !qbe_stmts_rebinds_ident(body, iv) {
          match qbe_eval_const_int_expr(g, k_e) {
            Some(k) => {
              let max_excl = if op == "<=" { k } else { k + 1 }
              if max_excl >= 1 && max_excl <= 32 {
                out_keys.push(arr + ":iv:" + iv)
                let mut c = 0
                while c < max_excl {
                  out_keys.push(arr + ":iv+:" + iv + ":" + c.to_string())
                  c = c + 1
                }
              }
            }
            None => ()
          }
        }
      }
    _ => ()
  }
}

///|
fn qbe_const_nonneg_i64(g : QbeGen, e : Expr) -> Option[Int64] {
  match e {
    EInt(raw, _) => {
      let v = qbe_parse_int64_lit(raw)
      if v >= 0L && v <= 2147483647L {
        Some(v)
      } else {
        None
      }
    }
    EUInt(raw, _) => {
      let v = qbe_parse_int64_lit(raw)
      if v >= 0L && v <= 4294967295L {
        Some(v)
      } else {
        None
      }
    }
    EInt64(raw, _) => {
      let v = qbe_parse_int64_lit(raw)
      if v >= 0L {
        Some(v)
      } else {
        None
      }
    }
    EUInt64(raw, _) => {
      let v = qbe_parse_int64_lit(raw)
      if v >= 0L {
        Some(v)
      } else {
        None
      }
    }
    EIdent(cn, _) =>
      if g.mono_pkg == "" {
        match qbe_lookup_local(g, cn) {
          Some(_) => None
          None =>
            match g.const_int_vals.get(cn) {
              Some(cv) =>
                if cv >= 0 {
                  Some(cv.to_int64())
                } else {
                  None
                }
              None => None
            }
        }
      } else {
        None
      }
    _ => None
  }
}

///|
/// Soundly proves `0 <= final_val <= upper` for unsigned/non-negative index expressions (Wave G4).
fn qbe_expr_max_u_bound(g : QbeGen, e : Expr) -> Option[Int64] {
  match e {
    EByte(_, _) => Some(255L)
    EIdent(vname, _) => {
      match g.u8_range_vars.get(vname) {
        Some(u) => return Some(u)
        None => ()
      }
      match qbe_lookup_local(g, vname) {
        Some(vloc) =>
          match vloc.ty {
            TByte => Some(255L)
            _ => None
          }
        None => None
      }
    }
    EMethodCall(obj, mname, margs, _) =>
      if mname == "code_unit_at" && margs.length() == 1 {
        match qbe_peek_expr_ty(g, obj) {
          Some(TString) => Some(255L)
          _ => None
        }
      } else if mname == "to_int" && margs.length() == 0 {
        let direct_byte = match qbe_peek_expr_ty(g, obj) {
          Some(TByte) => true
          _ =>
            match obj {
              EIndex(inner, _, _) =>
                match qbe_peek_expr_ty(g, inner) {
                  Some(TBytes) => true
                  _ => false
                }
              _ => false
            }
        }
        if direct_byte {
          Some(255L)
        } else {
          // Only propagate `.to_int()` when the inner value is proven to fit in signed non-negative Int32.
          // Never grants bounds to `Char.to_int()` or `Int8.to_int()`.
          match qbe_expr_max_u_bound(g, obj) {
            Some(u) =>
              if u >= 0L && u <= 2147483647L {
                Some(u)
              } else {
                None
              }
            None => None
          }
        }
      } else {
        None
      }
    EIndex(obj, _, _) =>
      match qbe_peek_expr_ty(g, obj) {
        Some(TString) | Some(TBytes) => Some(255L)
        _ => None
      }
    EBinary("&", l, r, _) => {
      let lb = qbe_const_nonneg_i64(g, l)
      let rb = qbe_const_nonneg_i64(g, r)
      match lb {
        Some(lv) =>
          match rb {
            Some(rv) => Some(if lv < rv { lv } else { rv })
            None => Some(lv)
          }
        None => rb
      }
    }
    EBinary(">>", l, r, _) => {
      // Strictly unsigned logical right shift (`TUInt` or `TUInt64`) only; never signed `Int`/`Int64`.
      let width = match qbe_peek_expr_ty(g, l) {
        Some(TUInt) => 32
        Some(TUInt64) => 64
        _ => 0
      }
      if width == 0 {
        None
      } else {
        match qbe_const_nonneg_i64(g, r) {
          Some(k) => {
            let s = (k & (width - 1).to_int64()).to_int()
            let rem_bits = width - s
            if s > 0 && s < width && rem_bits <= 30 {
              Some((1L << rem_bits) - 1L)
            } else {
              None
            }
          }
          None => None
        }
      }
    }
    EBinary("%", l, r, _) => {
      // Strictly unsigned modulo (`TUInt` or `TUInt64`) only; never signed `%`.
      let is_unsigned = match qbe_peek_expr_ty(g, l) {
        Some(TUInt) | Some(TUInt64) => true
        _ => false
      }
      if !is_unsigned {
        None
      } else {
        match qbe_const_nonneg_i64(g, r) {
          Some(m) =>
            if m > 0L && (m - 1L) <= 2147483647L {
              Some(m - 1L)
            } else {
              None
            }
          None => None
        }
      }
    }
    _ => None
  }
}

///|
fn qbe_emit_bytes_writable_check(
  g : QbeGen,
  bytes_obj_reg : String,
  arr_local_name : String,
) -> Unit {
  if arr_local_name != "" && g.known_writable_bytes.contains(arr_local_name) {
    return
  }
  let obj_reg = if bytes_obj_reg != "0" {
    bytes_obj_reg
  } else if arr_local_name != "" {
    match qbe_lookup_local(g, arr_local_name) {
      Some(bloc) => {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l loadl " + bloc.slot)
        t
      }
      None => "0"
    }
  } else {
    "0"
  }
  if obj_reg != "0" {
    let cap_p = qbe_tmp(g)
    let cap_v = qbe_tmp(g)
    let is_ro = qbe_tmp(g)
    let l_ro = qbe_lbl(g, "bytes_ro")
    let l_rw = qbe_lbl(g, "bytes_rw")
    qbe_emit(g, cap_p + " =l add " + obj_reg + ", 8")
    qbe_emit(g, cap_v + " =l loadl " + cap_p)
    qbe_emit(g, is_ro + " =w csltl " + cap_v + ", 0")
    qbe_emit_term(g, "jnz " + is_ro + ", " + l_ro + ", " + l_rw)
    qbe_emit_lbl(g, l_ro)
    let ro_mid = qbe_intern_cstring(g, "cannot mutate read-only mmap Bytes")
    let ro_fid = qbe_intern_cstring(g, "bytes")
    qbe_emit(
      g,
      "call $pion_panic(l $pion_cstr_" +
      ro_mid.to_string() +
      ", l $pion_cstr_" +
      ro_fid.to_string() +
      ", w 0)",
    )
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_rw)
  }
}

///|
fn qbe_bce_expr_is_safe(g : QbeGen, arr : String, idx : Expr) -> Bool {
  let matched = match idx {
    EIdent(iname, _) =>
      g.bce_safe_indices.contains(iname + ":" + arr) ||
      g.bce_safe_exprs.contains(arr + ":iv:" + iname)
    EField(EIdent(vn, _), fnm, _) =>
      g.bce_safe_indices.contains(vn + "." + fnm + ":" + arr)
    EBinary("+", EIdent(iname, _), EInt(raw, _), _) => {
      let c = qbe_parse_int64_lit(raw)
      g.bce_safe_exprs.contains(arr + ":iv+:" + iname + ":" + c.to_string())
    }
    EBinary("+", EInt(raw, _), EIdent(iname, _), _) => {
      let c = qbe_parse_int64_lit(raw)
      g.bce_safe_exprs.contains(arr + ":iv+:" + iname + ":" + c.to_string())
    }
    EBinary("-", EIdent(iname, _), EInt(raw, _), _) => {
      let c = qbe_parse_int64_lit(raw)
      g.bce_safe_exprs.contains(arr + ":iv+:" + iname + ":" + (0L - c).to_string())
    }
    EBinary("-", EIdent(vname, _), EIdent(iname, _), _) =>
      g.bce_safe_exprs.contains(arr + ":v-iv:" + vname + ":" + iname)
    _ => false
  }
  if matched {
    return true
  }
  let min_len_opt = match g.known_min_len_arrs.get(arr) {
    Some(ml) => Some(ml)
    None =>
      match qbe_lookup_local(g, arr) {
        Some(_) => None
        None =>
          if g.mono_pkg == "" {
            g.global_min_len_arrs.get(arr)
          } else {
            None
          }
      }
  }
  match min_len_opt {
    Some(min_len) => {
      match qbe_expr_max_u_bound(g, idx) {
        Some(upper) =>
          if upper >= 0L && upper < min_len.to_int64() {
            return true
          }
        None => ()
      }
      match idx {
        EInt(raw, _) => {
          let k = qbe_parse_int64_lit(raw)
          k >= 0L && k < min_len.to_int64()
        }
        _ => false
      }
    }
    None => false
  }
}

///|
fn qbe_bce_try_add_guard(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  arr : String,
  idx : Expr,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  if (!g.hoisted_arr_len.contains(arr) &&
      !g.hoisted_str_len.contains(arr) &&
      !g.hoisted_bytes_len.contains(arr)) ||
    qbe_stmts_rebinds_ident(body, arr) {
    return
  }
  match idx {
    EIdent(iname, _) =>
      if iname == iv && !g.bce_safe_indices.contains(iv + ":" + arr) {
        let key = arr + ":iv:" + iv
        if !seen.contains(key) {
          seen.set(key, true)
          out.push(QbeBceGuard::{ arr: arr, kind: 0, offset: 0L, vname: "", key: key })
        }
      }
    EBinary("+", EIdent(iname, _), EInt(raw, _), _) =>
      if iname == iv {
        let c = qbe_parse_int64_lit(raw)
        if c > 0L && c <= 2147483647L {
          let key = arr + ":iv+:" + iv + ":" + c.to_string()
          if !seen.contains(key) {
            seen.set(key, true)
            out.push(QbeBceGuard::{ arr: arr, kind: 1, offset: c, vname: "", key: key })
          }
        }
      }
    EBinary("+", EInt(raw, _), EIdent(iname, _), _) =>
      if iname == iv {
        let c = qbe_parse_int64_lit(raw)
        if c > 0L && c <= 2147483647L {
          let key = arr + ":iv+:" + iv + ":" + c.to_string()
          if !seen.contains(key) {
            seen.set(key, true)
            out.push(QbeBceGuard::{ arr: arr, kind: 1, offset: c, vname: "", key: key })
          }
        }
      }
    EBinary("-", EIdent(vname, _), EIdent(iname, _), _) =>
      if iname == iv &&
        vname != iv &&
        !qbe_stmts_assigns_ident(body, vname) &&
        !qbe_stmts_rebinds_ident(body, vname) {
        match qbe_lookup_local(g, vname) {
          Some(vloc) =>
            if qbe_is_int32_ty(vloc.ty) {
              let key = arr + ":v-iv:" + vname + ":" + iv
              if !seen.contains(key) {
                seen.set(key, true)
                out.push(QbeBceGuard::{ arr: arr, kind: 2, offset: 0L, vname: vname, key: key })
              }
            }
          None => ()
        }
      }
    _ => ()
  }
}

///|
fn qbe_collect_bce_guards_expr(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  e : Expr,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, inner, out, seen)
    EBinary(_, l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, l, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, r, out, seen)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(arr, _) => qbe_bce_try_add_guard(g, body, iv, arr, idx, out, seen)
        EField(EIdent(vname, _), fname, _) =>
          qbe_bce_try_add_guard(g, body, iv, vname + "." + fname, idx, out, seen)
        _ => qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
      }
      qbe_collect_bce_guards_expr(g, body, iv, idx, out, seen)
    }
    ECall(callee, args, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, callee, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_bce_guards_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if mname == "code_unit_at" && args.length() == 1 {
        match obj {
          EIdent(sname, _) => qbe_bce_try_add_guard(g, body, iv, sname, args[0], out, seen)
          EField(EIdent(vname, _), fname, _) =>
            qbe_bce_try_add_guard(g, body, iv, vname + "." + fname, args[0], out, seen)
          _ => qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
        }
      } else {
        qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
      }
      let mut i = 0
      while i < args.length() {
        qbe_collect_bce_guards_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_bce_guards_expr(g, body, iv, elems[i], out, seen)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_bce_guards_expr(g, body, iv, fields[i].value, out, seen)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_bce_guards_stmts(g, body, iv, stmts, out, seen)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, cond, out, seen)
      qbe_collect_bce_guards_stmts(g, body, iv, then_stmts, out, seen)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_bce_guards_expr(g, body, iv, el, out, seen)
      }
    }
    EIs(scrut, _, _) => qbe_collect_bce_guards_expr(g, body, iv, scrut, out, seen)
    EMatch(scrut, arms, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, scrut, out, seen)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_bce_guards_expr(g, body, iv, ge, out, seen)
          None => ()
        }
        qbe_collect_bce_guards_expr(g, body, iv, arms[i].body, out, seen)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) => ()
  }
}

///|
fn qbe_collect_bce_guards_stmt(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  s : Stmt,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, init, out, seen)
    SLetTuple(_, _, init, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, init, out, seen)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, lhs, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, rhs, out, seen)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_bce_guards_expr(g, body, iv, e, out, seen)
      }
    SDebugAssert(c, m, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, c, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, m, out, seen)
    }
    SExpr(e, _) => qbe_collect_bce_guards_expr(g, body, iv, e, out, seen)
    SGuard(_, _, _) | SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SBreak(_) | SContinue(_) => ()
  }
}

///|
fn qbe_collect_bce_guards_stmts(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  stmts : Array[Stmt],
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_bce_guards_stmt(g, body, iv, stmts[i], out, seen)
    i = i + 1
  }
}

///|
fn qbe_expr_count_assigns_ident(e : Expr, name : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 0
    EMutArg(inner, _) =>
      (if qbe_mut_place_root(inner) == name { 1 } else { 0 }) +
      qbe_expr_count_assigns_ident(inner, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_count_assigns_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_count_assigns_ident(l, name) + qbe_expr_count_assigns_ident(r, name)
    ECall(callee, args, _) => {
      let mut n = qbe_expr_count_assigns_ident(callee, name)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_expr_count_assigns_ident(args[i], name)
        i = i + 1
      }
      n
    }
    EMethodCall(obj, _, args, _) => {
      let mut n = qbe_expr_count_assigns_ident(obj, name)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_expr_count_assigns_ident(args[i], name)
        i = i + 1
      }
      n
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut n = 0
      let mut i = 0
      while i < elems.length() {
        n = n + qbe_expr_count_assigns_ident(elems[i], name)
        i = i + 1
      }
      n
    }
    EStructLit(_, _spread, fields, _) => {
      let mut n = 0
      let mut i = 0
      while i < fields.length() {
        n = n + qbe_expr_count_assigns_ident(fields[i].value, name)
        i = i + 1
      }
      n
    }
    EBlock(stmts, _) => qbe_stmts_count_assigns_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      let mut n = qbe_expr_count_assigns_ident(cond, name) +
        qbe_stmts_count_assigns_ident(then_stmts, name)
      match else_opt {
        None => ()
        Some(el) => n = n + qbe_expr_count_assigns_ident(el, name)
      }
      n
    }
    EIs(scrut, _, _) => qbe_expr_count_assigns_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      let mut n = qbe_expr_count_assigns_ident(scrut, name)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => n = n + qbe_expr_count_assigns_ident(ge, name)
          None => ()
        }
        n = n + qbe_expr_count_assigns_ident(arms[i].body, name)
        i = i + 1
      }
      n
    }
    EClosure(_, _, body, _) => qbe_stmts_count_assigns_ident(body, name)
  }
}

///|
fn qbe_stmt_count_assigns_ident(s : Stmt, name : String) -> Int {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_count_assigns_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_count_assigns_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      let self_hit = match lhs {
        EIdent(n, _) => if n == name { 1 } else { 0 }
        _ => 0
      }
      self_hit +
      qbe_expr_count_assigns_ident(lhs, name) +
      qbe_expr_count_assigns_ident(rhs, name)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_count_assigns_ident(cond, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_count_assigns_ident(init_s, name) +
      qbe_expr_count_assigns_ident(cond, name) +
      qbe_stmt_count_assigns_ident(step_s, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_count_assigns_ident(start_e, name) +
      qbe_expr_count_assigns_ident(end_e, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_count_assigns_ident(iter_e, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => 0
        Some(e) => qbe_expr_count_assigns_ident(e, name)
      }
    SBreak(_) | SContinue(_) => 0
    SDebugAssert(c, m, _) =>
      qbe_expr_count_assigns_ident(c, name) +
      qbe_expr_count_assigns_ident(m, name)
    SExpr(e, _) => qbe_expr_count_assigns_ident(e, name)
  }
}

///|
fn qbe_stmts_count_assigns_ident(stmts : Array[Stmt], name : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < stmts.length() {
    n = n + qbe_stmt_count_assigns_ident(stmts[i], name)
    i = i + 1
  }
  n
}

///|
fn qbe_expr_has_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary("*", EIdent(a, _), EIdent(b, _), _) => a == name && b == name
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_sq(l, name) || qbe_expr_has_sq(r, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_has_sq(inner, name)
    EBlock(stmts, _) => {
      let mut i = 0
      while i < stmts.length() {
        if qbe_stmt_has_sq(stmts[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_sq(cond, name) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        if qbe_stmt_has_sq(then_stmts[i], name) {
          return true
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_sq(el, name)
      }
    }
    _ => false
  }
}

///|
fn qbe_stmt_has_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_has_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_has_sq(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_sq(lhs, name) || qbe_expr_has_sq(rhs, name)
    SExpr(e, _) => qbe_expr_has_sq(e, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_sq(e, name)
      }
    _ => false
  }
}

///|
fn qbe_expr_uncond_has_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary("*", EIdent(a, _), EIdent(b, _), _) => a == name && b == name
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        qbe_expr_uncond_has_sq(l, name)
      } else {
        qbe_expr_uncond_has_sq(l, name) || qbe_expr_uncond_has_sq(r, name)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_uncond_has_sq(inner, name)
    EIf(cond, _, _, _) => qbe_expr_uncond_has_sq(cond, name)
    _ => false
  }
}

///|
fn qbe_stmt_uncond_has_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_uncond_has_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_uncond_has_sq(init, name)
    SAssign(_, rhs, _) | SCompoundAssign(_, _, rhs, _) => qbe_expr_uncond_has_sq(rhs, name)
    SExpr(e, _) => qbe_expr_uncond_has_sq(e, name)
    _ => false
  }
}

///|
fn qbe_expr_has_branch_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        qbe_expr_has_branch_sq(l, name) || qbe_expr_has_sq(r, name)
      } else {
        qbe_expr_has_branch_sq(l, name) || qbe_expr_has_branch_sq(r, name)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_has_branch_sq(inner, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_branch_sq(cond, name) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        if qbe_stmt_has_sq(then_stmts[i], name) {
          return true
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_sq(el, name)
      }
    }
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_sq(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_sq(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_stmt_has_branch_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_has_branch_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_has_branch_sq(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_branch_sq(lhs, name) || qbe_expr_has_branch_sq(rhs, name)
    SExpr(e, _) => qbe_expr_has_branch_sq(e, name)
    _ => false
  }
}

///|
fn qbe_collect_field_access_expr(
  e : Expr,
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EField(obj, fname, _) =>
      match obj {
        EIdent(vname, _) => {
          read_vars.push(vname)
          read_fields.push(fname)
          if !seen_all.contains(vname) {
            seen_all.set(vname, true)
            all_vars.push(vname)
          }
          true
        }
        _ => false
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_collect_field_access_expr(inner, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_collect_field_access_expr(l, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) &&
      qbe_collect_field_access_expr(r, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    ECall(callee, args, _) => {
      if !qbe_collect_field_access_expr(callee, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_collect_field_access_expr(args[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_collect_field_access_expr(obj, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_collect_field_access_expr(args[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_collect_field_access_expr(elems[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if !qbe_collect_field_access_expr(fields[i].value, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) =>
      qbe_collect_field_access_stmts(stmts, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_collect_field_access_expr(cond, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) ||
        !qbe_collect_field_access_stmts(then_stmts, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      match else_opt {
        None => true
        Some(el) =>
          qbe_collect_field_access_expr(el, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
    }
    EIs(scrut, _, _) => qbe_collect_field_access_expr(scrut, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EMatch(scrut, arms, _) => {
      if !qbe_collect_field_access_expr(scrut, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_collect_field_access_expr(ge, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
              return false
            }
          None => ()
        }
        if !qbe_collect_field_access_expr(arms[i].body, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | ETry(_, _) | EInterp(_, _) | EDotVariant(_, _, _) => false
  }
}

///|
fn qbe_collect_field_access_stmt(
  s : Stmt,
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_field_access_expr(init, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SLetTuple(_, _, init, _) =>
      qbe_collect_field_access_expr(init, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SCompoundAssign(_, _, _, _) => false
    SAssign(lhs, rhs, _) => {
      let lhs_ok = match lhs {
        EField(EIdent(vname, _), fname, _) => {
          write_vars.push(vname)
          write_fields.push(fname)
          if !seen_all.contains(vname) {
            seen_all.set(vname, true)
            all_vars.push(vname)
          }
          true
        }
        EField(_, _, _) => false
        _ =>
          qbe_collect_field_access_expr(lhs, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
      lhs_ok &&
      qbe_collect_field_access_expr(rhs, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    }
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) =>
          qbe_collect_field_access_expr(e, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
    SDebugAssert(c, m, _) =>
      qbe_collect_field_access_expr(c, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) &&
      qbe_collect_field_access_expr(m, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SExpr(e, _) =>
      qbe_collect_field_access_expr(e, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SGuard(_, _, _) => false
    SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_collect_field_access_stmts(
  stmts : Array[Stmt],
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if !qbe_collect_field_access_stmt(stmts[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_invalidate_len_aliases_for(g : QbeGen, arr_name : String) -> Unit {
  let mut i = 0
  while i < g.len_alias_keys.length() {
    let k = g.len_alias_keys[i]
    match g.len_aliases.get(k) {
      Some(v) =>
        if v == arr_name {
          g.len_aliases.remove(k)
        }
      None => ()
    }
    i = i + 1
  }
}

///|
///|
fn qbe_expr_is_leaf_loop_pure(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_is_leaf_loop_pure(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_is_leaf_loop_pure(l) && qbe_expr_is_leaf_loop_pure(r)
    EMethodCall(obj, mname, args, _) => {
      let ok = (mname == "code_unit_at" && args.length() == 1) ||
        (mname == "length" && args.length() == 0) ||
        (mname == "to_int" && args.length() == 0) ||
        (mname == "to_int64" && args.length() == 0) ||
        (mname == "to_double" && args.length() == 0)
      if !ok || !qbe_expr_is_leaf_loop_pure(obj) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_leaf_loop_pure(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_stmts_is_leaf_loop_pure(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_expr_is_leaf_loop_pure(cond) || !qbe_stmts_is_leaf_loop_pure(then_stmts) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_expr_is_leaf_loop_pure(el)
      }
    }
    _ => false
  }
}

///|
fn qbe_stmts_is_leaf_loop_pure(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) =>
        if !qbe_expr_is_leaf_loop_pure(init) {
          return false
        }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if !qbe_expr_is_leaf_loop_pure(lhs) || !qbe_expr_is_leaf_loop_pure(rhs) {
          return false
        }
      SExpr(e, _) =>
        if !qbe_expr_is_leaf_loop_pure(e) {
          return false
        }
      SBreak(_) | SContinue(_) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_expr_inline_cost_in(e : Expr, self_name : String, in_loop : Bool) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 1
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) => {
      let c = qbe_expr_inline_cost_in(inner, self_name, in_loop)
      if c < 0 { -1 } else { c + 1 }
    }
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      let cl = qbe_expr_inline_cost_in(l, self_name, in_loop)
      if cl < 0 {
        return -1
      }
      let cr = qbe_expr_inline_cost_in(r, self_name, in_loop)
      if cr < 0 { -1 } else { cl + cr + 1 }
    }
    ECall(callee, args, _) => {
      if in_loop {
        return -1
      }
      match callee {
        EIdent(cname, _) =>
          if cname == self_name || cname == "panic" || cname == "abort" {
            return -1
          }
        EPath(qual, mem, _) =>
          if qual + "::" + mem == self_name {
            return -1
          }
        _ => ()
      }
      let mut tot = qbe_expr_inline_cost_in(callee, self_name, in_loop)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_expr_inline_cost_in(args[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EMethodCall(obj, mname, args, _) => {
      if has_qual_sep(self_name) && split_qual_name(self_name).name == mname {
        return -1
      }
      let mut tot = qbe_expr_inline_cost_in(obj, self_name, in_loop)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_expr_inline_cost_in(args[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      if in_loop {
        return -1
      }
      let mut tot = 2
      let mut i = 0
      while i < elems.length() {
        let ca = qbe_expr_inline_cost_in(elems[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(_) => return -1
        None => ()
      }
      if in_loop {
        return -1
      }
      let mut tot = 2
      let mut i = 0
      while i < fields.length() {
        let ca = qbe_expr_inline_cost_in(fields[i].value, self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EBlock(stmts, _) => qbe_stmts_inline_cost_in(stmts, self_name, in_loop, 0)
    EIf(cond, then_stmts, else_opt, _) => {
      let cc = qbe_expr_inline_cost_in(cond, self_name, in_loop)
      if cc < 0 {
        return -1
      }
      let ct = qbe_stmts_inline_cost_in(then_stmts, self_name, in_loop, 0)
      if ct < 0 {
        return -1
      }
      let ce = match else_opt {
        None => 0
        Some(el) => qbe_expr_inline_cost_in(el, self_name, in_loop)
      }
      if ce < 0 { -1 } else { cc + ct + ce + 2 }
    }
    ETry(inner, _) | EIs(inner, _, _) =>
      if !in_loop {
        let c = qbe_expr_inline_cost_in(inner, self_name, in_loop)
        if c < 0 { -1 } else { c + 2 }
      } else {
        -1
      }
    EMatch(scrut, arms, _) =>
      if !in_loop && arms.length() <= 6 {
        let cs = qbe_expr_inline_cost_in(scrut, self_name, in_loop)
        if cs < 0 {
          return -1
        }
        let mut tot = cs + 2
        let mut ai = 0
        while ai < arms.length() {
          match arms[ai].guard_expr {
            Some(ge) => {
              let cg = qbe_expr_inline_cost_in(ge, self_name, in_loop)
              if cg < 0 {
                return -1
              }
              tot = tot + cg
            }
            None => ()
          }
          let cb = qbe_expr_inline_cost_in(arms[ai].body, self_name, in_loop)
          if cb < 0 {
            return -1
          }
          tot = tot + cb + 1
          ai = ai + 1
        }
        tot
      } else {
        -1
      }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | EInterp(_, _) | EDotVariant(_, _, _) =>
      -1
  }
}

///|
fn qbe_expr_inline_cost_in_loops(
  e : Expr,
  self_name : String,
  in_loop : Bool,
  loops_left : Array[Int],
) -> Int {
  match e {
    EBlock(stmts, _) =>
      qbe_stmts_inline_cost_in_loops(stmts, self_name, in_loop, loops_left)
    EIf(cond, then_stmts, else_opt, _) => {
      let cc = qbe_expr_inline_cost_in(cond, self_name, in_loop)
      if cc < 0 {
        return -1
      }
      let ct = qbe_stmts_inline_cost_in_loops(
        then_stmts,
        self_name,
        in_loop,
        loops_left,
      )
      if ct < 0 {
        return -1
      }
      let ce = match else_opt {
        None => 0
        Some(el) =>
          qbe_expr_inline_cost_in_loops(el, self_name, in_loop, loops_left)
      }
      if ce < 0 { -1 } else { cc + ct + ce + 2 }
    }
    _ => qbe_expr_inline_cost_in(e, self_name, in_loop)
  }
}

///|
fn qbe_stmts_inline_cost_in_loops(
  stmts : Array[Stmt],
  self_name : String,
  in_loop : Bool,
  loops_left : Array[Int],
) -> Int {
  let mut tot = 0
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => {
        let c = qbe_expr_inline_cost_in_loops(init, self_name, in_loop, loops_left)
        if c < 0 {
          return -1
        }
        tot = tot + c + 1
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        let cl = qbe_expr_inline_cost_in(lhs, self_name, in_loop)
        if cl < 0 {
          return -1
        }
        let cr = qbe_expr_inline_cost_in(rhs, self_name, in_loop)
        if cr < 0 {
          return -1
        }
        tot = tot + cl + cr + 1
      }
      SExpr(e, _) => {
        let c = qbe_expr_inline_cost_in_loops(e, self_name, in_loop, loops_left)
        if c < 0 {
          return -1
        }
        tot = tot + c
      }
      SWhile(wcond, wbody, _) =>
        if !in_loop &&
          loops_left[0] > 0 &&
          !qbe_stmts_has_nested_loop(wbody) &&
          !qbe_stmts_has_cf(wbody, false, false, true) &&
          qbe_expr_is_leaf_loop_pure(wcond) &&
          qbe_stmts_is_leaf_loop_pure(wbody) {
          loops_left[0] = loops_left[0] - 1
          let cc = qbe_expr_inline_cost_in(wcond, self_name, true)
          if cc < 0 {
            return -1
          }
          let cb = qbe_stmts_inline_cost_in_loops(wbody, self_name, true, [0])
          if cb < 0 {
            return -1
          }
          tot = tot + cc + cb + 2
        } else {
          return -1
        }
      SBreak(_) | SContinue(_) =>
        if in_loop {
          tot = tot + 1
        } else {
          return -1
        }
      SReturn(opt, _) =>
        if !in_loop {
          match opt {
            None => tot = tot + 1
            Some(e) => {
              let c = qbe_expr_inline_cost_in(e, self_name, in_loop)
              if c < 0 {
                return -1
              }
              tot = tot + c + 1
            }
          }
        } else {
          return -1
        }
      SGuard(cond, body, _) =>
        if !in_loop {
          let cc = qbe_expr_inline_cost_in(cond, self_name, in_loop)
          if cc < 0 {
            return -1
          }
          let cb = qbe_stmts_inline_cost_in_loops(body, self_name, in_loop, [0])
          if cb < 0 {
            return -1
          }
          tot = tot + cc + cb + 2
        } else {
          return -1
        }
      SLetTuple(_, _, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SDebugAssert(_, _, _) =>
        return -1
    }
    if tot > 256 {
      return -1
    }
    i = i + 1
  }
  tot
}

///|
fn qbe_stmts_inline_cost_in(
  stmts : Array[Stmt],
  self_name : String,
  in_loop : Bool,
  allow_loops : Int,
) -> Int {
  qbe_stmts_inline_cost_in_loops(stmts, self_name, in_loop, [allow_loops])
}

///|
fn qbe_stmts_inline_cost(stmts : Array[Stmt], self_name : String) -> Int {
  qbe_stmts_inline_cost_in(stmts, self_name, false, 1)
}

///|
fn qbe_expr_loop_inline_cost(
  e : Expr,
  self_name : String,
  max_loop_depth : Int,
  max_cost : Int,
) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 1
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) => {
      let c = qbe_expr_loop_inline_cost(inner, self_name, max_loop_depth, max_cost)
      if c < 0 { -1 } else { c + 1 }
    }
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      let cl = qbe_expr_loop_inline_cost(l, self_name, max_loop_depth, max_cost)
      if cl < 0 {
        return -1
      }
      let cr = qbe_expr_loop_inline_cost(r, self_name, max_loop_depth, max_cost)
      if cr < 0 { -1 } else { cl + cr + 1 }
    }
    EMethodCall(obj, mname, args, _) => {
      if has_qual_sep(self_name) && split_qual_name(self_name).name == mname {
        return -1
      }
      if mname != "length" &&
        mname != "sqrt" &&
        mname != "abs" &&
        mname != "floor" &&
        mname != "ceil" &&
        mname != "trunc" &&
        mname != "to_int" &&
        mname != "to_int64" &&
        mname != "to_double" &&
        mname != "to_float" &&
        mname != "to_byte" &&
        mname != "code_unit_at" {
        return -1
      }
      let mut tot = qbe_expr_loop_inline_cost(obj, self_name, max_loop_depth, max_cost)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_expr_loop_inline_cost(args[i], self_name, max_loop_depth, max_cost)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EBlock(stmts, _) =>
      qbe_stmts_loop_inline_cost_in(stmts, self_name, 0, max_loop_depth, max_cost)
    EIf(cond, then_stmts, else_opt, _) => {
      let cc = qbe_expr_loop_inline_cost(cond, self_name, max_loop_depth, max_cost)
      if cc < 0 {
        return -1
      }
      let ct = qbe_stmts_loop_inline_cost_in(then_stmts, self_name, 0, max_loop_depth, max_cost)
      if ct < 0 {
        return -1
      }
      let ce = match else_opt {
        None => 0
        Some(el) => qbe_expr_loop_inline_cost(el, self_name, max_loop_depth, max_cost)
      }
      if ce < 0 { -1 } else { cc + ct + ce + 2 }
    }
    _ => -1
  }
}

///|
fn qbe_stmts_loop_inline_cost_in(
  stmts : Array[Stmt],
  self_name : String,
  loop_depth : Int,
  max_loop_depth : Int,
  max_cost : Int,
) -> Int {
  let mut tot = 0
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => {
        let c = qbe_expr_loop_inline_cost(init, self_name, max_loop_depth, max_cost)
        if c < 0 {
          return -1
        }
        tot = tot + c + 1
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        let cl = qbe_expr_loop_inline_cost(lhs, self_name, max_loop_depth, max_cost)
        if cl < 0 {
          return -1
        }
        let cr = qbe_expr_loop_inline_cost(rhs, self_name, max_loop_depth, max_cost)
        if cr < 0 {
          return -1
        }
        tot = tot + cl + cr + 1
      }
      SExpr(e, _) => {
        let c = qbe_expr_loop_inline_cost(e, self_name, max_loop_depth, max_cost)
        if c < 0 {
          return -1
        }
        tot = tot + c
      }
      SWhile(wcond, wbody, _) =>
        if loop_depth < max_loop_depth && !qbe_stmts_has_cf(wbody, false, false, true) {
          let cc = qbe_expr_loop_inline_cost(wcond, self_name, max_loop_depth, max_cost)
          if cc < 0 {
            return -1
          }
          let cb = qbe_stmts_loop_inline_cost_in(
            wbody,
            self_name,
            loop_depth + 1,
            max_loop_depth,
            max_cost,
          )
          if cb < 0 {
            return -1
          }
          tot = tot + cc + cb + 2
        } else {
          return -1
        }
      SBreak(_) | SContinue(_) =>
        if loop_depth > 0 {
          tot = tot + 1
        } else {
          return -1
        }
      _ => return -1
    }
    if tot > max_cost {
      return -1
    }
    i = i + 1
  }
  tot
}

///|
fn qbe_stmts_loop_inline_cost(
  stmts : Array[Stmt],
  self_name : String,
  max_loop_depth : Int,
  max_cost : Int,
) -> Int {
  qbe_stmts_loop_inline_cost_in(stmts, self_name, 0, max_loop_depth, max_cost)
}

///|
fn qbe_hof_param_is_call_only_expr(e : Expr, pname : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != pname
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_hof_param_is_call_only_expr(inner, pname)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_hof_param_is_call_only_expr(l, pname) &&
      qbe_hof_param_is_call_only_expr(r, pname)
    ECall(callee, args, _) => {
      let callee_ok = match callee {
        EIdent(cname, _) =>
          if cname == pname { true } else { qbe_hof_param_is_call_only_expr(callee, pname) }
        _ => qbe_hof_param_is_call_only_expr(callee, pname)
      }
      if !callee_ok {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_hof_param_is_call_only_expr(args[i], pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_hof_param_is_call_only_expr(obj, pname) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_hof_param_is_call_only_expr(args[i], pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_hof_param_is_call_only_expr(elems[i], pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(se) =>
          if !qbe_hof_param_is_call_only_expr(se, pname) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_hof_param_is_call_only_expr(fields[i].value, pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_hof_param_is_call_only_stmts(stmts, pname)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_hof_param_is_call_only_expr(cond, pname) ||
        !qbe_hof_param_is_call_only_stmts(then_stmts, pname) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_hof_param_is_call_only_expr(el, pname)
      }
    }
    EIs(scrut, _, _) => qbe_hof_param_is_call_only_expr(scrut, pname)
    EMatch(scrut, arms, _) => {
      if !qbe_hof_param_is_call_only_expr(scrut, pname) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_hof_param_is_call_only_expr(ge, pname) {
              return false
            }
          None => ()
        }
        if !qbe_hof_param_is_call_only_expr(arms[i].body, pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EInterp(parts, _) => {
      let mut i = 0
      while i < parts.length() {
        if !qbe_hof_param_is_call_only_expr(parts[i], pname) {
          return false
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, body, _) => qbe_hof_param_is_call_only_stmts(body, pname)
  }
}

///|
fn qbe_hof_param_is_call_only_stmts(stmts : Array[Stmt], pname : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    let ok = match stmts[i] {
      SLet(n, _, _, init, _) =>
        n != pname && qbe_hof_param_is_call_only_expr(init, pname)
      SLetTuple(_, _, init, _) => qbe_hof_param_is_call_only_expr(init, pname)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        qbe_hof_param_is_call_only_expr(lhs, pname) &&
        qbe_hof_param_is_call_only_expr(rhs, pname)
      SExpr(e, _) => qbe_hof_param_is_call_only_expr(e, pname)
      SWhile(c, b, _) | SGuard(c, b, _) =>
        qbe_hof_param_is_call_only_expr(c, pname) &&
        qbe_hof_param_is_call_only_stmts(b, pname)
      SFor(is_, c, ss, b, _) =>
        qbe_hof_param_is_call_only_stmts([is_], pname) &&
        qbe_hof_param_is_call_only_expr(c, pname) &&
        qbe_hof_param_is_call_only_stmts([ss], pname) &&
        qbe_hof_param_is_call_only_stmts(b, pname)
      SForRange(vn, s, e, _, b, _) =>
        vn != pname &&
        qbe_hof_param_is_call_only_expr(s, pname) &&
        qbe_hof_param_is_call_only_expr(e, pname) &&
        qbe_hof_param_is_call_only_stmts(b, pname)
      SForIn(inm, vn, it, b, _) =>
        inm != pname &&
        vn != pname &&
        qbe_hof_param_is_call_only_expr(it, pname) &&
        qbe_hof_param_is_call_only_stmts(b, pname)
      SReturn(opt, _) =>
        match opt {
          Some(e) => qbe_hof_param_is_call_only_expr(e, pname)
          None => true
        }
      SDebugAssert(c, m, _) =>
        qbe_hof_param_is_call_only_expr(c, pname) &&
        qbe_hof_param_is_call_only_expr(m, pname)
      SBreak(_) | SContinue(_) => true
    }
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_hof_count_param_calls_expr(e : Expr, pname : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EIdent(_, _)
    | EUnit(_) => 0
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) => qbe_hof_count_param_calls_expr(inner, pname)
    EBinary(_, l, r, _)
    | EIndex(l, r, _)
    | EScope(l, r, _)
    | ESpawn(l, r, _) =>
      qbe_hof_count_param_calls_expr(l, pname) +
      qbe_hof_count_param_calls_expr(r, pname)
    ECall(callee, args, _) => {
      let mut n = match callee {
        EIdent(cname, _) => if cname == pname { 1 } else { 0 }
        _ => qbe_hof_count_param_calls_expr(callee, pname)
      }
      let mut i = 0
      while i < args.length() {
        n = n + qbe_hof_count_param_calls_expr(args[i], pname)
        i = i + 1
      }
      n
    }
    EMethodCall(obj, _, args, _) => {
      let mut n = qbe_hof_count_param_calls_expr(obj, pname)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_hof_count_param_calls_expr(args[i], pname)
        i = i + 1
      }
      n
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EDotVariant(_, elems, _) => {
      let mut n = 0
      let mut i = 0
      while i < elems.length() {
        n = n + qbe_hof_count_param_calls_expr(elems[i], pname)
        i = i + 1
      }
      n
    }
    EStructLit(_, spread_opt, fields, _) => {
      let mut n = match spread_opt {
        Some(se) => qbe_hof_count_param_calls_expr(se, pname)
        None => 0
      }
      let mut i = 0
      while i < fields.length() {
        n = n + qbe_hof_count_param_calls_expr(fields[i].value, pname)
        i = i + 1
      }
      n
    }
    EBlock(stmts, _) => qbe_hof_count_param_calls_stmts(stmts, pname)
    EIf(cond, then_stmts, else_opt, _) => {
      let mut n = qbe_hof_count_param_calls_expr(cond, pname) +
        qbe_hof_count_param_calls_stmts(then_stmts, pname)
      match else_opt {
        Some(el) => n = n + qbe_hof_count_param_calls_expr(el, pname)
        None => ()
      }
      n
    }
    EIs(scrut, _, _) => qbe_hof_count_param_calls_expr(scrut, pname)
    EMatch(scrut, arms, _) => {
      let mut n = qbe_hof_count_param_calls_expr(scrut, pname)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => n = n + qbe_hof_count_param_calls_expr(ge, pname)
          None => ()
        }
        n = n + qbe_hof_count_param_calls_expr(arms[i].body, pname)
        i = i + 1
      }
      n
    }
    EInterp(parts, _) => {
      let mut n = 0
      let mut i = 0
      while i < parts.length() {
        n = n + qbe_hof_count_param_calls_expr(parts[i], pname)
        i = i + 1
      }
      n
    }
    EClosure(_, _, body, _) => qbe_hof_count_param_calls_stmts(body, pname)
  }
}

///|
fn qbe_hof_count_param_calls_stmts(stmts : Array[Stmt], pname : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < stmts.length() {
    let add = match stmts[i] {
      SLet(_, _, _, init, _) => qbe_hof_count_param_calls_expr(init, pname)
      SLetTuple(_, _, init, _) => qbe_hof_count_param_calls_expr(init, pname)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        qbe_hof_count_param_calls_expr(lhs, pname) +
        qbe_hof_count_param_calls_expr(rhs, pname)
      SExpr(e, _) => qbe_hof_count_param_calls_expr(e, pname)
      SWhile(c, b, _) | SGuard(c, b, _) =>
        qbe_hof_count_param_calls_expr(c, pname) +
        qbe_hof_count_param_calls_stmts(b, pname)
      SFor(is_, c, ss, b, _) =>
        qbe_hof_count_param_calls_stmts([is_], pname) +
        qbe_hof_count_param_calls_expr(c, pname) +
        qbe_hof_count_param_calls_stmts([ss], pname) +
        qbe_hof_count_param_calls_stmts(b, pname)
      SForRange(_, s, e, _, b, _) =>
        qbe_hof_count_param_calls_expr(s, pname) +
        qbe_hof_count_param_calls_expr(e, pname) +
        qbe_hof_count_param_calls_stmts(b, pname)
      SForIn(_, _, it, b, _) =>
        qbe_hof_count_param_calls_expr(it, pname) +
        qbe_hof_count_param_calls_stmts(b, pname)
      SReturn(opt, _) =>
        match opt {
          Some(e) => qbe_hof_count_param_calls_expr(e, pname)
          None => 0
        }
      SDebugAssert(c, m, _) =>
        qbe_hof_count_param_calls_expr(c, pname) +
        qbe_hof_count_param_calls_expr(m, pname)
      SBreak(_) | SContinue(_) => 0
    }
    n = n + add
    i = i + 1
  }
  n
}

///|
fn qbe_hof_expr_cost(e : Expr, self_name : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 1
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) => {
      let c = qbe_hof_expr_cost(inner, self_name)
      if c < 0 { -1 } else { c + 1 }
    }
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      let cl = qbe_hof_expr_cost(l, self_name)
      if cl < 0 {
        return -1
      }
      let cr = qbe_hof_expr_cost(r, self_name)
      if cr < 0 { -1 } else { cl + cr + 1 }
    }
    ECall(callee, args, _) => {
      match callee {
        EIdent(cname, _) =>
          if cname == self_name || cname == "panic" || cname == "abort" {
            return -1
          }
        EPath(qual, mem, _) =>
          if qual + "::" + mem == self_name {
            return -1
          }
        _ => ()
      }
      let mut tot = qbe_hof_expr_cost(callee, self_name)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_hof_expr_cost(args[i], self_name)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EMethodCall(obj, mname, args, _) => {
      if has_qual_sep(self_name) && split_qual_name(self_name).name == mname {
        return -1
      }
      let mut tot = qbe_hof_expr_cost(obj, self_name)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_hof_expr_cost(args[i], self_name)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EDotVariant(_, elems, _) => {
      let mut tot = 2
      let mut i = 0
      while i < elems.length() {
        let ca = qbe_hof_expr_cost(elems[i], self_name)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(_) => return -1
        None => ()
      }
      let mut tot = 2
      let mut i = 0
      while i < fields.length() {
        let ca = qbe_hof_expr_cost(fields[i].value, self_name)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EBlock(stmts, _) => qbe_hof_stmts_cost(stmts, self_name)
    EIf(cond, then_stmts, else_opt, _) => {
      let cc = qbe_hof_expr_cost(cond, self_name)
      if cc < 0 {
        return -1
      }
      let ct = qbe_hof_stmts_cost(then_stmts, self_name)
      if ct < 0 {
        return -1
      }
      let ce = match else_opt {
        None => 0
        Some(el) => qbe_hof_expr_cost(el, self_name)
      }
      if ce < 0 { -1 } else { cc + ct + ce + 2 }
    }
    EIs(scrut, _, _) => qbe_hof_expr_cost(scrut, self_name)
    EMatch(scrut, arms, _) => {
      let mut tot = qbe_hof_expr_cost(scrut, self_name)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => {
            let cg = qbe_hof_expr_cost(ge, self_name)
            if cg < 0 {
              return -1
            }
            tot = tot + cg
          }
          None => ()
        }
        let cb = qbe_hof_expr_cost(arms[i].body, self_name)
        if cb < 0 {
          return -1
        }
        tot = tot + cb + 1
        i = i + 1
      }
      tot + 2
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) =>
      -1
  }
}

///|
fn qbe_hof_stmts_cost(stmts : Array[Stmt], self_name : String) -> Int {
  let mut tot = 0
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => {
        let c = qbe_hof_expr_cost(init, self_name)
        if c < 0 {
          return -1
        }
        tot = tot + c + 1
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        let cl = qbe_hof_expr_cost(lhs, self_name)
        if cl < 0 {
          return -1
        }
        let cr = qbe_hof_expr_cost(rhs, self_name)
        if cr < 0 {
          return -1
        }
        tot = tot + cl + cr + 1
      }
      SExpr(e, _) => {
        let c = qbe_hof_expr_cost(e, self_name)
        if c < 0 {
          return -1
        }
        tot = tot + c
      }
      SWhile(wcond, wbody, _) => {
        let cc = qbe_hof_expr_cost(wcond, self_name)
        if cc < 0 {
          return -1
        }
        let cb = qbe_hof_stmts_cost(wbody, self_name)
        if cb < 0 {
          return -1
        }
        tot = tot + cc + cb + 2
      }
      SBreak(_) | SContinue(_) => tot = tot + 1
      SLetTuple(_, _, _, _) | SGuard(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SReturn(_, _) | SDebugAssert(_, _, _) =>
        return -1
    }
    if tot > 80 {
      return -1
    }
    i = i + 1
  }
  tot
}

///|
fn qbe_expr_has_nested_clo_or_conc(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EClosure(_, _, _, _) | EScope(_, _, _, ) | ESpawn(_, _, _) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_expr_has_nested_clo_or_conc(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_nested_clo_or_conc(l) || qbe_expr_has_nested_clo_or_conc(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_nested_clo_or_conc(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_clo_or_conc(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_nested_clo_or_conc(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_clo_or_conc(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_nested_clo_or_conc(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(se) =>
          if qbe_expr_has_nested_clo_or_conc(se) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_nested_clo_or_conc(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_nested_clo_or_conc(stmts)
    EIf(cond, then_stmts, else_opt, _) =>
      qbe_expr_has_nested_clo_or_conc(cond) ||
      qbe_stmts_has_nested_clo_or_conc(then_stmts) ||
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_nested_clo_or_conc(el)
      }
    EIs(scrut, _, _) => qbe_expr_has_nested_clo_or_conc(scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_nested_clo_or_conc(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_nested_clo_or_conc(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_nested_clo_or_conc(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EInterp(parts, _) => {
      let mut i = 0
      while i < parts.length() {
        if qbe_expr_has_nested_clo_or_conc(parts[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_stmts_has_nested_clo_or_conc(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    let hit = match stmts[i] {
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        qbe_expr_has_nested_clo_or_conc(init)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        qbe_expr_has_nested_clo_or_conc(lhs) || qbe_expr_has_nested_clo_or_conc(rhs)
      SExpr(e, _) => qbe_expr_has_nested_clo_or_conc(e)
      SWhile(c, b, _) | SGuard(c, b, _) =>
        qbe_expr_has_nested_clo_or_conc(c) || qbe_stmts_has_nested_clo_or_conc(b)
      SFor(is_, c, ss, b, _) =>
        qbe_stmts_has_nested_clo_or_conc([is_]) ||
        qbe_expr_has_nested_clo_or_conc(c) ||
        qbe_stmts_has_nested_clo_or_conc([ss]) ||
        qbe_stmts_has_nested_clo_or_conc(b)
      SForRange(_, s, e, _, b, _) =>
        qbe_expr_has_nested_clo_or_conc(s) ||
        qbe_expr_has_nested_clo_or_conc(e) ||
        qbe_stmts_has_nested_clo_or_conc(b)
      SForIn(_, _, it, b, _) =>
        qbe_expr_has_nested_clo_or_conc(it) || qbe_stmts_has_nested_clo_or_conc(b)
      SReturn(opt, _) =>
        match opt {
          Some(e) => qbe_expr_has_nested_clo_or_conc(e)
          None => false
        }
      SDebugAssert(c, m, _) =>
        qbe_expr_has_nested_clo_or_conc(c) || qbe_expr_has_nested_clo_or_conc(m)
      SBreak(_) | SContinue(_) => false
    }
    if hit {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_collect_pkg_inline_fns(
  g : QbeGen,
  pkg : Package,
  only_file_idx : Int,
) -> Unit {
  let m : Map[String, FnDecl] = Map([])
  let mc : Map[String, Int] = Map([])
  let mf : Map[String, Int] = Map([])
  let hm : Map[String, FnDecl] = Map([])
  let hmf : Map[String, Int] = Map([])
  let mut fi = if only_file_idx >= 0 { only_file_idx } else { 0 }
  let end_fi = if only_file_idx >= 0 {
    if only_file_idx < pkg.files.length() { only_file_idx + 1 } else { 0 }
  } else {
    pkg.files.length()
  }
  while fi < end_fi {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) =>
          if fd.type_params.length() == 0 &&
            (fd.receiver_type != "" || fd.name != "main") &&
            fd.body.length() >= 1 {
            let key = if fd.receiver_type != "" {
              fd.receiver_type + "::" + fd.name
            } else {
              fd.name
            }
            let mut collected = false
            if fd.body.length() <= 8 {
              let cost = qbe_stmts_inline_cost(fd.body, key)
              if cost >= 0 && cost <= 42 {
                m.set(key, fd)
                mc.set(key, cost)
                mf.set(key, fi)
                collected = true
              }
            }
            if !collected && !fd.is_pub && fd.body.length() <= 12 {
              let loop_max_depth = if g.target_wasm { 1 } else { 2 }
              let loop_max_cost = qbe_loop_inline_max_cost(g)
              let lcost = qbe_stmts_loop_inline_cost(
                fd.body,
                key,
                loop_max_depth,
                loop_max_cost,
              )
              if lcost >= 0 && lcost <= loop_max_cost {
                m.set(key, fd)
                mc.set(key, if lcost <= 42 { 43 } else { lcost })
                mf.set(key, fi)
              }
            }
            if fd.body.length() <= 16 {
              let mut has_fn_param = false
              let mut pi = 0
              while pi < fd.params.length() {
                match fd.params[pi].ty {
                  TyFn(_, _, _) => {
                    has_fn_param = true
                    break
                  }
                  _ => ()
                }
                pi = pi + 1
              }
              if has_fn_param {
                let hcost = qbe_hof_stmts_cost(fd.body, key)
                if hcost >= 0 && hcost <= 80 {
                  hm.set(key, fd)
                  hmf.set(key, fi)
                }
              }
            }
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  g.inline_fns = m
  g.inline_fn_costs = mc
  g.inline_fn_file = mf
  g.hof_inline_fns = hm
  g.hof_inline_fn_file = hmf
}

///|
fn qbe_try_inline_hof_call(
  g : QbeGen,
  key : String,
  finfo : FnInfo,
  norm_args : Array[Expr],
  order : Array[Int],
) -> Option[QbeVal] {
  if g.mono_pkg != "" ||
    g.inline_depth >= 2 ||
    finfo.decl.type_params.length() != 0 ||
    params_have_mut(finfo.decl.params) ||
    str_arr_contains(g.inline_stack, key) {
    return None
  }
  match g.hof_inline_fns.get(key) {
    None => None
    Some(hof_fd) => {
      if g.unit_mode {
        match g.hof_inline_fn_file.get(key) {
          Some(fidx) =>
            if g.cur_file_idx >= 0 && fidx != g.cur_file_idx {
              return None
            }
          None => ()
        }
      }
      if norm_args.length() != hof_fd.params.length() ||
        norm_args.length() != finfo.param_tys.length() {
        return None
      }
      let is_spec : Array[Bool] = []
      let spec_map : Map[String, QbeInlineClosure] = Map([])
      let mut spec_count = 0
      let mut i = 0
      while i < norm_args.length() {
        let mut did_spec = false
        match (norm_args[i], finfo.param_tys[i]) {
          (EClosure(cparams, _, cbody, _), TFn(fptys, frty)) => {
            let pname = hof_fd.params[i].name
            if cparams.length() == fptys.length() &&
              cbody.length() <= 16 &&
              qbe_hof_param_is_call_only_stmts(hof_fd.body, pname) &&
              !qbe_stmts_has_nested_clo_or_conc(cbody) {
              let clocals : Map[String, Bool] = Map([])
              let mut cpi = 0
              while cpi < cparams.length() {
                clocals.set(cparams[cpi].name, true)
                cpi = cpi + 1
              }
              let raw_caps : Array[CaptureInfo] = []
              collect_stmts_captures(cbody, clocals, raw_caps)
              let snap_caps : Array[QbeLocal] = []
              let seen_caps : Map[String, Bool] = Map([])
              let mut caps_ok = true
              let mut ci = 0
              while ci < raw_caps.length() {
                let cname = raw_caps[ci].name
                if !seen_caps.contains(cname) {
                  match qbe_lookup_local(g, cname) {
                    Some(loc) =>
                      if loc.is_cell || qbe_stmts_assigns_ident(cbody, cname) {
                        caps_ok = false
                        break
                      } else {
                        seen_caps.set(cname, true)
                        snap_caps.push(
                          QbeLocal::{
                            name: loc.name,
                            slot: loc.slot,
                            ty: loc.ty,
                            owned: false,
                            is_cell: false,
                            counted_len: "",
                            ref_slot: "",
                          },
                        )
                      }
                    None => ()
                  }
                }
                ci = ci + 1
              }
              if caps_ok {
                spec_map.set(
                  pname,
                  QbeInlineClosure::{
                    params: cparams,
                    param_tys: fptys,
                    ret_ty: frty,
                    body: cbody,
                    cap_locals: snap_caps,
                  },
                )
                did_spec = true
                spec_count = spec_count + 1
              }
            }
          }
          _ => ()
        }
        is_spec.push(did_spec)
        i = i + 1
      }
      if spec_count == 0 {
        return None
      }
      let hof_base = qbe_hof_stmts_cost(hof_fd.body, key)
      let mut hof_clo_cost = 0
      i = 0
      while i < norm_args.length() {
        if is_spec[i] {
          match norm_args[i] {
            EClosure(_, _, cbody, _) => {
              let raw_c = qbe_stmts_inline_cost_in(cbody, "", false, 0)
              if raw_c < 0 {
                return None
              }
              let clo_cost = if raw_c > 0 { raw_c } else { 1 }
              let raw_sites = qbe_hof_count_param_calls_stmts(
                hof_fd.body,
                hof_fd.params[i].name,
              )
              let call_sites = if raw_sites > 0 { raw_sites } else { 1 }
              hof_clo_cost = hof_clo_cost + clo_cost * call_sites
            }
            _ => ()
          }
        }
        i = i + 1
      }
      let hof_cost = (if hof_base > 0 { hof_base } else { 1 }) + hof_clo_cost
      if qbe_caller_over_inline_budget(g, hof_cost) ||
        qbe_stmts_has_default_ret(g, hof_fd.body) {
        return None
      }
      g.fn_inlined_cost = g.fn_inlined_cost + hof_cost
      // Evaluate non-specialized arguments in caller scope
      let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
      let arg_vals : Array[String] = []
      let arg_tys : Array[Ty] = []
      let arg_borrowed : Array[Bool] = []
      qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
      let guards = qbe_arg_guards(g, norm_args, order)
      let mut oi = 0
      while oi < order.length() {
        i = order[oi]
        if is_spec[i] {
          arg_vals[i] = "0"
          arg_tys[i] = finfo.param_tys[i]
          arg_borrowed[i] = true
        } else {
          match norm_args[i] {
            EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
            _ => ()
          }
          let aa = qbe_emit_arg_maybe_borrow(
            g,
            norm_args[i],
            Some(finfo.param_tys[i]),
            can_borrow,
          )
          arg_vals[i] = aa.qv.reg
          arg_tys[i] = aa.qv.ty
          arg_borrowed[i] = aa.borrowed
          qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(finfo.decl.params, i, norm_args[i]), guards.exits[oi])
        }
        oi = oi + 1
      }
      qbe_release_guards(g, guards)
      g.inline_depth = g.inline_depth + 1
      g.inline_stack.push(key)
      let inl_hlen = g.hoisted_arr_len
      let inl_hdp = g.hoisted_arr_dp
      let inl_hslen = g.hoisted_str_len
      let inl_hsdp = g.hoisted_str_dp
      let inl_hblen = g.hoisted_bytes_len
      let inl_hbdp = g.hoisted_bytes_dp
      let inl_hfields = g.hoisted_fields
      let inl_bfields = g.block_immut_fields
      let inl_lalias = g.len_aliases
      let inl_lkeys = g.len_alias_keys
      let inl_nonneg = g.nonneg_vars
      let inl_u8r = g.u8_range_vars
      let inl_kml = g.known_min_len_arrs
      let inl_kwb = g.known_writable_bytes
      let inl_bce = g.bce_safe_indices
      let inl_bce_exprs = g.bce_safe_exprs
      let inl_bce_push = g.bce_safe_push_arrs
      let inl_prom = g.promoted_fields
      let inl_prom_tys = g.promoted_field_tys
      let inl_pp_len = g.promoted_push_len
      let inl_pp_cap = g.promoted_push_cap
      let inl_pp_dp = g.promoted_push_dp
      let inl_w2l = g.w_to_l_ext
      let inl_lw2l = g.local_w_to_l_ext
      let inl_unfrozen = g.unfrozen_local_arrs
      let inl_mov = g.movable_locals
      let inl_moved = g.moved_slots
      let inl_clos = g.inline_closures
      let inl_rlbl = g.inline_ret_lbl
      let inl_rtag = g.inline_ret_tag_slot
      let inl_rerr = g.inline_ret_err_slot
      let inl_rpod = g.inline_ret_pod_buf
      let inl_rslot = g.inline_ret_slot
      let inl_rty = g.inline_ret_ty
      let inl_rdep = g.inline_ret_scope_depth
      let inl_tco_mode = g.tco_mode
      let inl_tco_fn = g.tco_fn_name
      let inl_tco_lbl = g.tco_loop_lbl
      g.tco_mode = 0
      g.tco_fn_name = ""
      g.tco_loop_lbl = ""
      g.hoisted_arr_len = Map([])
      g.hoisted_arr_dp = Map([])
      g.hoisted_str_len = Map([])
      g.hoisted_str_dp = Map([])
      g.hoisted_bytes_len = Map([])
      g.hoisted_bytes_dp = Map([])
      g.inline_closures = Map([])
      g.inline_ret_lbl = ""
      g.inline_ret_tag_slot = ""
      g.inline_ret_err_slot = ""
      g.inline_ret_pod_buf = false
      g.hoisted_fields = Map([])
      g.block_immut_fields = Map([])
      g.len_aliases = Map([])
      g.len_alias_keys = []
      g.nonneg_vars = Map([])
      g.u8_range_vars = Map([])
      g.known_min_len_arrs = Map([])
      g.known_writable_bytes = Map([])
      g.bce_safe_indices = Map([])
      g.bce_safe_exprs = Map([])
      g.bce_safe_push_arrs = Map([])
      g.promoted_fields = Map([])
      g.promoted_field_tys = Map([])
      g.promoted_push_len = Map([])
      g.promoted_push_cap = Map([])
      g.promoted_push_dp = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext = Map([])
      g.unfrozen_local_arrs = Map([])
      g.movable_locals = Map([])
      g.moved_slots = Map([])
      g.inline_closures = spec_map
      g.inline_ret_lbl = ""
      g.inline_ret_slot = ""
      g.inline_ret_ty = TUnit
      g.inline_ret_scope_depth = 0
      let hof_body = qbe_fn_body(g, hof_fd.body)
      let inl_saved_verify = g.in_verify
      g.in_verify = hof_fd.is_verify
      qbe_scope_push(g)
      let mut pi = 0
      while pi < hof_fd.params.length() {
        if !is_spec[pi] {
          let pty = finfo.param_tys[pi]
          let pname = hof_fd.params[pi].name
          let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
          let mut p_owned = !arg_borrowed[pi]
          if arg_borrowed[pi] && qbe_stmts_assigns_ident(hof_body, pname) {
            qbe_rc_inc(g, pv, pty)
            p_owned = true
          }
          let loc = qbe_define_local(g, pname, pty, p_owned)
          qbe_store_local_slot(g, pv, loc.slot, pty)
          if !p_owned {
            g.borrow_owner_slot.set(loc.slot, loc.slot)
            g.borrow_owner_name.set(loc.slot, pname)
          }
        }
        pi = pi + 1
      }
      let bres = qbe_emit_stmts(g, hof_body, Some(finfo.ret_ty))
      let out_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
      qbe_scope_pop(g)
      g.in_verify = inl_saved_verify
      g.hoisted_arr_len = inl_hlen
      g.hoisted_arr_dp = inl_hdp
      g.hoisted_str_len = inl_hslen
      g.hoisted_str_dp = inl_hsdp
      g.hoisted_bytes_len = inl_hblen
      g.hoisted_bytes_dp = inl_hbdp
      g.hoisted_fields = inl_hfields
      g.block_immut_fields = Map([])
      g.len_aliases = inl_lalias
      g.len_alias_keys = inl_lkeys
      g.nonneg_vars = inl_nonneg
      g.u8_range_vars = inl_u8r
      g.known_min_len_arrs = inl_kml
      g.known_writable_bytes = inl_kwb
      g.bce_safe_indices = inl_bce
      g.bce_safe_exprs = inl_bce_exprs
      g.bce_safe_push_arrs = inl_bce_push
      g.promoted_fields = inl_prom
      g.promoted_field_tys = inl_prom_tys
      g.promoted_push_len = inl_pp_len
      g.promoted_push_cap = inl_pp_cap
      g.promoted_push_dp = inl_pp_dp
      g.w_to_l_ext = inl_w2l
      g.local_w_to_l_ext = inl_lw2l
      g.unfrozen_local_arrs = inl_unfrozen
      g.movable_locals = inl_mov
      g.moved_slots = inl_moved
      g.inline_closures = inl_clos
      g.inline_ret_lbl = inl_rlbl
      g.inline_ret_tag_slot = inl_rtag
      g.inline_ret_err_slot = inl_rerr
      g.inline_ret_pod_buf = inl_rpod
      g.inline_ret_slot = inl_rslot
      g.inline_ret_ty = inl_rty
      g.inline_ret_scope_depth = inl_rdep
      g.tco_mode = inl_tco_mode
      g.tco_fn_name = inl_tco_fn
      g.tco_loop_lbl = inl_tco_lbl
      let _ = inl_bfields
      let _ = g.inline_stack.pop()
      g.inline_depth = g.inline_depth - 1
      Some(qval(out_reg, finfo.ret_ty))
    }
  }
}

///|
fn qbe_locals_contain_name(locals : Array[QbeLocal], name : String) -> Bool {
  let mut i = 0
  while i < locals.length() {
    if locals[i].name == name {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_emit_inline_closure_call(
  g : QbeGen,
  iclo : QbeInlineClosure,
  args : Array[Expr],
) -> QbeVal {
  let can_borrow = !qbe_args_may_mutate_locals(g, args)
  let body_no_calls = qbe_loop_has_no_calls_stmts(g, iclo.body)
  let guards = qbe_arg_guards_in_order(g, args)
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let arg_borrowed : Array[Bool] = []
  let mut i = 0
  while i < args.length() {
    let mut got_flat_borrow = false
    if can_borrow && body_no_calls && i < iclo.params.length() && i < iclo.param_tys.length() {
      let pty = iclo.param_tys[i]
      let pname = iclo.params[i].name
      if qbe_flat_pod_stride(g, pty) > 0 &&
        !qbe_stmts_assigns_ident(iclo.body, pname) &&
        qbe_ident_is_flat_field_only_stmts(iclo.body, 0, pname) {
        match args[i] {
          EIndex(EIdent(aname, _), idx_expr, _) =>
            if !qbe_locals_contain_name(iclo.cap_locals, aname) {
              match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                Some(ev) => {
                  arg_vals.push(ev.reg)
                  arg_tys.push(ev.ty)
                  arg_borrowed.push(true)
                  got_flat_borrow = true
                }
                None => ()
              }
            }
          _ => ()
        }
      }
    }
    if !got_flat_borrow {
      let ep : Option[Ty] = if i < iclo.param_tys.length() {
        Some(iclo.param_tys[i])
      } else {
        None
      }
      let aa = qbe_emit_arg_maybe_borrow(g, args[i], ep, can_borrow)
      arg_vals.push(aa.qv.reg)
      arg_tys.push(aa.qv.ty)
      arg_borrowed.push(aa.borrowed)
      qbe_guard_val(g, guards, aa, false, guards.exits[i])
    }
    i = i + 1
  }
  qbe_release_guards(g, guards)
  let saved_scopes = g.scopes
  let saved_breaks = g.loop_breaks
  let saved_conts = g.loop_conts
  let saved_depths = g.loop_depths
  let saved_hlen = g.hoisted_arr_len
  let saved_hdp = g.hoisted_arr_dp
  let saved_hslen = g.hoisted_str_len
  let saved_hsdp = g.hoisted_str_dp
  let saved_hblen = g.hoisted_bytes_len
  let saved_hbdp = g.hoisted_bytes_dp
  let saved_hfields = g.hoisted_fields
  let saved_bfields = g.block_immut_fields
  let saved_lalias = g.len_aliases
  let saved_lkeys = g.len_alias_keys
  let saved_nonneg = g.nonneg_vars
  let saved_u8r = g.u8_range_vars
  let saved_kml = g.known_min_len_arrs
  let saved_kwb = g.known_writable_bytes
  let saved_bce = g.bce_safe_indices
  let saved_bce_exprs = g.bce_safe_exprs
  let saved_bce_push = g.bce_safe_push_arrs
  let saved_prom = g.promoted_fields
  let saved_prom_tys = g.promoted_field_tys
  let saved_pp_len = g.promoted_push_len
  let saved_pp_cap = g.promoted_push_cap
  let saved_pp_dp = g.promoted_push_dp
  let saved_w2l = g.w_to_l_ext
  let saved_lw2l = g.local_w_to_l_ext
  let saved_unfrozen = g.unfrozen_local_arrs
  let saved_pinned_slots = g.pinned_slots
  let saved_borrow_owner_slot = g.borrow_owner_slot
  let saved_borrow_owner_name = g.borrow_owner_name
  let saved_mut_local_slots = g.mut_local_slots
  let saved_mov = g.movable_locals
  let saved_moved = g.moved_slots
  let saved_clos = g.inline_closures
  let saved_rlbl = g.inline_ret_lbl
  let saved_rtag = g.inline_ret_tag_slot
  let saved_rerr = g.inline_ret_err_slot
  let saved_rpod = g.inline_ret_pod_buf
  let saved_rslot = g.inline_ret_slot
  let saved_rty = g.inline_ret_ty
  let saved_rdep = g.inline_ret_scope_depth
  let saved_tco_mode = g.tco_mode
  let saved_tco_fn = g.tco_fn_name
  let saved_tco_lbl = g.tco_loop_lbl
  let saved_floor = g.lookup_scope_floor
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.lookup_scope_floor = 0

  g.scopes = [QbeScope::{ locals: iclo.cap_locals }]
  g.lookup_scope_floor = 0
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.inline_closures = Map([])

  qbe_scope_push(g)
  let iclo_has_dp = qbe_stmts_has_any_data_ptr(iclo.body)
  let mut pi = 0
  while pi < iclo.params.length() && pi < iclo.param_tys.length() {
    let pty = iclo.param_tys[pi]
    let pname = iclo.params[pi].name
    let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
    let mut p_owned = !arg_borrowed[pi]
    if arg_borrowed[pi] && qbe_stmts_assigns_ident(iclo.body, pname) {
      qbe_rc_inc(g, pv, pty)
      p_owned = true
    }
    let loc = qbe_define_local(g, pname, pty, p_owned)
    qbe_store_local_slot(g, pv, loc.slot, pty)
    if iclo_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(iclo.body, 0, pname) {
      let prev = match g.pinned_slots.get(loc.slot) {
        Some(c) => c
        None => 0
      }
      g.pinned_slots.set(loc.slot, prev + 1)
    }
    pi = pi + 1
  }

  let has_ret = qbe_stmts_has_cf(iclo.body, false, false, true) ||
    qbe_stmts_has_default_ret(g, iclo.body)
  let out_reg = if !has_ret {
    g.inline_ret_lbl = ""
    g.inline_ret_tag_slot = ""
    g.inline_ret_err_slot = ""
    g.inline_ret_pod_buf = false
    g.inline_ret_slot = ""
    g.inline_ret_ty = TUnit
    g.inline_ret_scope_depth = 0
    let bres = qbe_emit_stmts(g, iclo.body, Some(iclo.ret_ty))
    let r = qbe_coerce_val(g, bres, iclo.ret_ty)
    qbe_scope_pop(g)
    r
  } else {
    let ret_lbl = qbe_lbl(g, "iclo_ret")
    let ret_slot = qbe_alloc_slot_for(g, iclo.ret_ty)
    g.inline_ret_lbl = ret_lbl
    g.inline_ret_tag_slot = ""
    g.inline_ret_err_slot = ""
    g.inline_ret_pod_buf = false
    g.inline_ret_slot = ret_slot
    g.inline_ret_ty = iclo.ret_ty
    g.inline_ret_scope_depth = 1
    let bres = qbe_emit_stmts(g, iclo.body, Some(iclo.ret_ty))
    if !g.block_term {
      let r = qbe_coerce_val(g, bres, iclo.ret_ty)
      qbe_store_local_slot(g, r, ret_slot, iclo.ret_ty)
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + ret_lbl)
    } else {
      let _ = g.scopes.pop()
    }
    qbe_emit_lbl(g, ret_lbl)
    qbe_load_local_slot(g, ret_slot, iclo.ret_ty)
  }

  g.scopes = saved_scopes
  g.lookup_scope_floor = saved_floor
  g.loop_breaks = saved_breaks
  g.loop_conts = saved_conts
  g.loop_depths = saved_depths
  g.hoisted_arr_len = saved_hlen
  g.hoisted_arr_dp = saved_hdp
  g.hoisted_str_len = saved_hslen
  g.hoisted_str_dp = saved_hsdp
  g.hoisted_bytes_len = saved_hblen
  g.hoisted_bytes_dp = saved_hbdp
  g.hoisted_fields = saved_hfields
  g.block_immut_fields = Map([])
  g.len_aliases = saved_lalias
  g.len_alias_keys = saved_lkeys
  g.nonneg_vars = saved_nonneg
  g.u8_range_vars = saved_u8r
  g.known_min_len_arrs = saved_kml
  g.known_writable_bytes = saved_kwb
  g.bce_safe_indices = saved_bce
  g.bce_safe_exprs = saved_bce_exprs
  g.bce_safe_push_arrs = saved_bce_push
  g.promoted_fields = saved_prom
  g.promoted_field_tys = saved_prom_tys
  g.promoted_push_len = saved_pp_len
  g.promoted_push_cap = saved_pp_cap
  g.promoted_push_dp = saved_pp_dp
  g.w_to_l_ext = saved_w2l
  g.local_w_to_l_ext = saved_lw2l
  g.unfrozen_local_arrs = saved_unfrozen
  g.pinned_slots = saved_pinned_slots
  g.borrow_owner_slot = saved_borrow_owner_slot
  g.borrow_owner_name = saved_borrow_owner_name
  g.mut_local_slots = saved_mut_local_slots
  g.movable_locals = saved_mov
  g.moved_slots = saved_moved
  g.inline_closures = saved_clos
  g.inline_ret_lbl = saved_rlbl
  g.inline_ret_tag_slot = saved_rtag
  g.inline_ret_err_slot = saved_rerr
  g.inline_ret_pod_buf = saved_rpod
  g.inline_ret_slot = saved_rslot
  g.inline_ret_ty = saved_rty
  g.inline_ret_scope_depth = saved_rdep
  g.tco_mode = saved_tco_mode
  g.tco_fn_name = saved_tco_fn
  g.tco_loop_lbl = saved_tco_lbl
  let _ = saved_bfields
  qval(out_reg, iclo.ret_ty)
}

///|
/// Zero-allocation HOF fusion for `out.push(f(args...))` where `f` is an inline closure
/// whose sole statement is an `EStructLit(_, None, fields, _)` returning a flat POD struct.
fn qbe_emit_inline_closure_flat_struct_lit(
  g : QbeGen,
  iclo : QbeInlineClosure,
  args : Array[Expr],
  sinfo : StructInfo,
  raw_elem : Ty,
  fields : Array[FieldInit],
) -> Array[QbeVal] {
  let can_borrow = !qbe_args_may_mutate_locals(g, args)
  let body_no_calls = qbe_loop_has_no_calls_stmts(g, iclo.body)
  let guards = qbe_arg_guards_in_order(g, args)
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let arg_borrowed : Array[Bool] = []
  let mut i = 0
  while i < args.length() {
    let mut got_flat_borrow = false
    if can_borrow && body_no_calls && i < iclo.params.length() && i < iclo.param_tys.length() {
      let pty = iclo.param_tys[i]
      let pname = iclo.params[i].name
      if qbe_flat_pod_stride(g, pty) > 0 &&
        !qbe_stmts_assigns_ident(iclo.body, pname) &&
        qbe_ident_is_flat_field_only_stmts(iclo.body, 0, pname) {
        match args[i] {
          EIndex(EIdent(aname, _), idx_expr, _) =>
            if !qbe_locals_contain_name(iclo.cap_locals, aname) {
              match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                Some(ev) => {
                  arg_vals.push(ev.reg)
                  arg_tys.push(ev.ty)
                  arg_borrowed.push(true)
                  got_flat_borrow = true
                }
                None => ()
              }
            }
          _ => ()
        }
      }
    }
    if !got_flat_borrow {
      let ep : Option[Ty] = if i < iclo.param_tys.length() {
        Some(iclo.param_tys[i])
      } else {
        None
      }
      let aa = qbe_emit_arg_maybe_borrow(g, args[i], ep, can_borrow)
      arg_vals.push(aa.qv.reg)
      arg_tys.push(aa.qv.ty)
      arg_borrowed.push(aa.borrowed)
      qbe_guard_val(g, guards, aa, false, guards.exits[i])
    }
    i = i + 1
  }
  qbe_release_guards(g, guards)
  let saved_scopes = g.scopes
  let saved_breaks = g.loop_breaks
  let saved_conts = g.loop_conts
  let saved_depths = g.loop_depths
  let saved_hlen = g.hoisted_arr_len
  let saved_hdp = g.hoisted_arr_dp
  let saved_hslen = g.hoisted_str_len
  let saved_hsdp = g.hoisted_str_dp
  let saved_hblen = g.hoisted_bytes_len
  let saved_hbdp = g.hoisted_bytes_dp
  let saved_hfields = g.hoisted_fields
  let saved_bfields = g.block_immut_fields
  let saved_lalias = g.len_aliases
  let saved_lkeys = g.len_alias_keys
  let saved_nonneg = g.nonneg_vars
  let saved_u8r = g.u8_range_vars
  let saved_kml = g.known_min_len_arrs
  let saved_kwb = g.known_writable_bytes
  let saved_bce = g.bce_safe_indices
  let saved_bce_exprs = g.bce_safe_exprs
  let saved_bce_push = g.bce_safe_push_arrs
  let saved_prom = g.promoted_fields
  let saved_prom_tys = g.promoted_field_tys
  let saved_pp_len = g.promoted_push_len
  let saved_pp_cap = g.promoted_push_cap
  let saved_pp_dp = g.promoted_push_dp
  let saved_w2l = g.w_to_l_ext
  let saved_lw2l = g.local_w_to_l_ext
  let saved_unfrozen = g.unfrozen_local_arrs
  let saved_pinned_slots = g.pinned_slots
  let saved_borrow_owner_slot = g.borrow_owner_slot
  let saved_borrow_owner_name = g.borrow_owner_name
  let saved_mut_local_slots = g.mut_local_slots
  let saved_mov = g.movable_locals
  let saved_moved = g.moved_slots
  let saved_clos = g.inline_closures
  let saved_rlbl = g.inline_ret_lbl
  let saved_rtag = g.inline_ret_tag_slot
  let saved_rerr = g.inline_ret_err_slot
  let saved_rpod = g.inline_ret_pod_buf
  let saved_rslot = g.inline_ret_slot
  let saved_rty = g.inline_ret_ty
  let saved_rdep = g.inline_ret_scope_depth
  let saved_tco_mode = g.tco_mode
  let saved_tco_fn = g.tco_fn_name
  let saved_tco_lbl = g.tco_loop_lbl
  let saved_floor = g.lookup_scope_floor
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.lookup_scope_floor = 0

  g.scopes = [QbeScope::{ locals: iclo.cap_locals }]
  g.lookup_scope_floor = 0
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.inline_ret_slot = ""
  g.inline_ret_ty = TUnit
  g.inline_ret_scope_depth = 0
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])

  qbe_scope_push(g)
  let iclo_has_dp = qbe_stmts_has_any_data_ptr(iclo.body)
  let mut pi = 0
  while pi < iclo.params.length() && pi < iclo.param_tys.length() {
    let pty = iclo.param_tys[pi]
    let pname = iclo.params[pi].name
    let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
    let mut p_owned = !arg_borrowed[pi]
    if arg_borrowed[pi] && qbe_stmts_assigns_ident(iclo.body, pname) {
      qbe_rc_inc(g, pv, pty)
      p_owned = true
    }
    let loc = qbe_define_local(g, pname, pty, p_owned)
    qbe_store_local_slot(g, pv, loc.slot, pty)
    if iclo_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(iclo.body, 0, pname) {
      let prev = match g.pinned_slots.get(loc.slot) {
        Some(c) => c
        None => 0
      }
      g.pinned_slots.set(loc.slot, prev + 1)
    }
    pi = pi + 1
  }

  let slot_vals = qbe_emit_flat_eval_struct_lit(g, sinfo, raw_elem, fields)
  qbe_scope_pop(g)

  g.scopes = saved_scopes
  g.lookup_scope_floor = saved_floor
  g.loop_breaks = saved_breaks
  g.loop_conts = saved_conts
  g.loop_depths = saved_depths
  g.hoisted_arr_len = saved_hlen
  g.hoisted_arr_dp = saved_hdp
  g.hoisted_str_len = saved_hslen
  g.hoisted_str_dp = saved_hsdp
  g.hoisted_bytes_len = saved_hblen
  g.hoisted_bytes_dp = saved_hbdp
  g.hoisted_fields = saved_hfields
  g.block_immut_fields = Map([])
  g.len_aliases = saved_lalias
  g.len_alias_keys = saved_lkeys
  g.nonneg_vars = saved_nonneg
  g.u8_range_vars = saved_u8r
  g.known_min_len_arrs = saved_kml
  g.known_writable_bytes = saved_kwb
  g.bce_safe_indices = saved_bce
  g.bce_safe_exprs = saved_bce_exprs
  g.bce_safe_push_arrs = saved_bce_push
  g.promoted_fields = saved_prom
  g.promoted_field_tys = saved_prom_tys
  g.promoted_push_len = saved_pp_len
  g.promoted_push_cap = saved_pp_cap
  g.promoted_push_dp = saved_pp_dp
  g.w_to_l_ext = saved_w2l
  g.local_w_to_l_ext = saved_lw2l
  g.unfrozen_local_arrs = saved_unfrozen
  g.pinned_slots = saved_pinned_slots
  g.borrow_owner_slot = saved_borrow_owner_slot
  g.borrow_owner_name = saved_borrow_owner_name
  g.mut_local_slots = saved_mut_local_slots
  g.movable_locals = saved_mov
  g.moved_slots = saved_moved
  g.inline_closures = saved_clos
  g.inline_ret_lbl = saved_rlbl
  g.inline_ret_tag_slot = saved_rtag
  g.inline_ret_err_slot = saved_rerr
  g.inline_ret_pod_buf = saved_rpod
  g.inline_ret_slot = saved_rslot
  g.inline_ret_ty = saved_rty
  g.inline_ret_scope_depth = saved_rdep
  g.tco_mode = saved_tco_mode
  g.tco_fn_name = saved_tco_fn
  g.tco_loop_lbl = saved_tco_lbl
  let _ = saved_bfields
  slot_vals
}

///|
fn qbe_loop_inline_max_cost(g : QbeGen) -> Int {
  if g.target_wasm {
    96
  } else {
    220
  }
}

///|
fn qbe_inline_max_cost(
  g : QbeGen,
  same_file : Bool,
  is_pub : Bool,
  consumes_variant : Bool,
  unbox_destructure : Bool = false,
) -> Int {
  let use_legacy = (g.j2_disable_mask & 32) != 0
  let in_loop = g.loop_breaks.length() > 0
  if same_file && !is_pub && g.inline_depth == 0 && in_loop {
    return qbe_loop_inline_max_cost(g)
  }
  if use_legacy {
    if same_file || consumes_variant {
      42
    } else {
      22
    }
  } else if in_loop {
    if same_file || consumes_variant || unbox_destructure {
      42
    } else {
      22
    }
  } else if consumes_variant || unbox_destructure {
    42
  } else if same_file {
    18
  } else {
    10
  }
}

///|
fn qbe_caller_over_inline_budget(g : QbeGen, callee_cost : Int) -> Bool {
  let use_legacy = (g.j2_disable_mask & 32) != 0
  let in_loop = g.loop_breaks.length() > 0
  if use_legacy || in_loop {
    if callee_cost <= 12 {
      return false
    }
    if g.target_wasm {
      return g.fn_inlined_cost + callee_cost > 1600 ||
        g.fn_body.length() > 24576
    } else {
      let dt = g.next_tmp - g.fn_start_tmp
      let dl = g.next_lbl - g.fn_start_lbl
      return g.fn_inlined_cost + callee_cost > 1600 || dt > 3000 || dl > 500
    }
  }
  if callee_cost <= 4 {
    return false
  }
  if g.target_wasm {
    g.fn_inlined_cost + callee_cost > 480 || g.fn_body.length() > 16384
  } else {
    let dt = g.next_tmp - g.fn_start_tmp
    let dl = g.next_lbl - g.fn_start_lbl
    g.fn_inlined_cost + callee_cost > 480 || dt > 1500 || dl > 250
  }
}

///|
fn qbe_callee_inline_cost_for_budget(
  g : QbeGen,
  target_pkg : String,
  stack_key : String,
  inl_fd : FnDecl,
) -> Int {
  if target_pkg == "" {
    match g.inline_fn_costs.get(stack_key) {
      Some(c) => if c > 0 { c } else { 1 }
      None => 1
    }
  } else {
    let self_key = if inl_fd.receiver_type != "" {
      inl_fd.receiver_type + "::" + inl_fd.name
    } else {
      inl_fd.name
    }
    let is_opt_res = match inl_fd.ret_ty {
      TyName("Option", _, _) | TyName("Result", _, _) => true
      _ => false
    }
    let c = qbe_stmts_inline_cost_in(
      inl_fd.body,
      self_key,
      false,
      if is_opt_res { 1 } else { 0 },
    )
    if c > 0 { c } else { 1 }
  }
}

///|
fn qbe_has_simple_tuple_tail(body : Array[Stmt], ret_ty : Ty) -> Bool {
  match ret_ty {
    TTuple(fields) => {
      if fields.length() < 2 || fields.length() > 5 || body.length() == 0 { return false }
      let mut i = 0
      while i < fields.length() {
        if !qbe_is_prim_scalar_ty(fields[i]) { return false }
        i = i + 1
      }
      i = 0
      while i + 1 < body.length() {
        match body[i] {
          SLet(_, _, _, _, _) => ()
          _ => return false
        }
        i = i + 1
      }
      match body[i] {
        SExpr(ETuple(elems, _), _) => elems.length() == fields.length()
        _ => false
      }
    }
    _ => false
  }
}

///|
fn qbe_try_inline_fn_call(
  g : QbeGen,
  key : String,
  finfo : FnInfo,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
  destructure : Bool = false,
) -> Option[QbeVal] {
  if g.mono_pkg != "" ||
    g.inline_depth >= 2 ||
    finfo.decl.type_params.length() != 0 ||
    params_have_mut(finfo.decl.params) ||
    str_arr_contains(g.inline_stack, key) {
    return None
  }
  match g.inline_fns.get(key) {
    Some(inl_fd) => {
      let same_file = match g.inline_fn_file.get(key) {
        Some(fidx) => g.cur_file_idx < 0 || fidx == g.cur_file_idx
        None => true
      }
      let max_cost = qbe_inline_max_cost(
        g,
        same_file,
        inl_fd.is_pub,
        false,
        unbox_destructure=destructure,
      )
      let fn_cost = match g.inline_fn_costs.get(key) {
        Some(c) => c
        None => 0
      }
      if fn_cost > max_cost || qbe_caller_over_inline_budget(g, fn_cost) {
        return None
      }
      if arg_vals.length() == inl_fd.params.length() &&
        arg_vals.length() == finfo.param_tys.length() {
        g.fn_inlined_cost = g.fn_inlined_cost + (if fn_cost > 0 { fn_cost } else { 1 })
        g.inline_depth = g.inline_depth + 1
        g.inline_stack.push(key)
        let inl_hlen = g.hoisted_arr_len
        let inl_hdp = g.hoisted_arr_dp
        let inl_hslen = g.hoisted_str_len
        let inl_hsdp = g.hoisted_str_dp
        let inl_hblen = g.hoisted_bytes_len
        let inl_hbdp = g.hoisted_bytes_dp
        let inl_hfields = g.hoisted_fields
        let inl_bfields = g.block_immut_fields
        let inl_lalias = g.len_aliases
        let inl_lkeys = g.len_alias_keys
        let inl_nonneg = g.nonneg_vars
        let inl_u8r = g.u8_range_vars
        let inl_kml = g.known_min_len_arrs
        let inl_kwb = g.known_writable_bytes
        let inl_bce = g.bce_safe_indices
        let inl_bce_exprs = g.bce_safe_exprs
        let inl_bce_push = g.bce_safe_push_arrs
        let inl_prom = g.promoted_fields
        let inl_prom_tys = g.promoted_field_tys
        let inl_pp_len = g.promoted_push_len
        let inl_pp_cap = g.promoted_push_cap
        let inl_pp_dp = g.promoted_push_dp
        let inl_w2l = g.w_to_l_ext
        let inl_lw2l = g.local_w_to_l_ext
        let inl_unfrozen = g.unfrozen_local_arrs
        let inl_stk_views = g.stack_view_slots
  let inl_pinned_slots = g.pinned_slots
        let inl_mov = g.movable_locals
        let inl_moved = g.moved_slots
        let inl_clos = g.inline_closures
        let inl_rlbl = g.inline_ret_lbl
        let inl_rtag = g.inline_ret_tag_slot
        let inl_rerr = g.inline_ret_err_slot
        let inl_rpod = g.inline_ret_pod_buf
        let inl_rslot = g.inline_ret_slot
        let inl_rty = g.inline_ret_ty
        let inl_rdep = g.inline_ret_scope_depth
        let inl_tco_mode = g.tco_mode
        let inl_tco_fn = g.tco_fn_name
        let inl_tco_lbl = g.tco_loop_lbl
        g.tco_mode = 0
        g.tco_fn_name = ""
        g.tco_loop_lbl = ""
        g.hoisted_arr_len = Map([])
        g.hoisted_arr_dp = Map([])
        g.hoisted_str_len = Map([])
        g.hoisted_str_dp = Map([])
        g.hoisted_bytes_len = Map([])
        g.hoisted_bytes_dp = Map([])
        g.hoisted_fields = Map([])
        g.block_immut_fields = Map([])
        g.len_aliases = Map([])
        g.len_alias_keys = []
        g.nonneg_vars = Map([])
        g.u8_range_vars = Map([])
        g.known_min_len_arrs = Map([])
        g.known_writable_bytes = Map([])
        g.bce_safe_indices = Map([])
        g.bce_safe_exprs = Map([])
        g.bce_safe_push_arrs = Map([])
        g.promoted_fields = Map([])
        g.promoted_field_tys = Map([])
        g.promoted_push_len = Map([])
        g.promoted_push_cap = Map([])
        g.promoted_push_dp = Map([])
        g.w_to_l_ext = Map([])
        g.local_w_to_l_ext = Map([])
        g.unfrozen_local_arrs = Map([])
        g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
        g.movable_locals = Map([])
        g.moved_slots = Map([])
        g.inline_closures = Map([])
        g.inline_ret_lbl = ""
        g.inline_ret_tag_slot = ""
        g.inline_ret_err_slot = ""
        g.inline_ret_pod_buf = false
        g.inline_ret_slot = ""
        g.inline_ret_ty = TUnit
        g.inline_ret_scope_depth = 0
        let inl_body = qbe_fn_body(g, inl_fd.body)
        let inl_saved_verify = g.in_verify
        g.in_verify = inl_fd.is_verify
        let inl_scope_base = g.scopes.length()
        // The inlined body resolves names in the callee's lexical scope only:
        // caller locals must never capture a callee's reference to a global.
        let caller_floor = g.lookup_scope_floor
        g.lookup_scope_floor = inl_scope_base
        qbe_scope_push(g)
        let inl_has_dp = qbe_stmts_has_any_data_ptr(inl_body)
        let mut pi = 0
        while pi < inl_fd.params.length() {
          let pty = finfo.param_tys[pi]
          let pname = inl_fd.params[pi].name
          let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
          let mut p_owned = !arg_borrowed[pi]
          if arg_borrowed[pi] && qbe_stmts_assigns_ident(inl_body, pname) {
            qbe_rc_inc(g, pv, pty)
            p_owned = true
          }
          let loc = qbe_define_local(g, pname, pty, p_owned)
          qbe_store_local_slot(g, pv, loc.slot, pty)
          if !p_owned {
            g.borrow_owner_slot.set(loc.slot, loc.slot)
            g.borrow_owner_name.set(loc.slot, pname)
          }
          if inl_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(inl_body, 0, pname) {
            let prev = match g.pinned_slots.get(loc.slot) {
              Some(c) => c
              None => 0
            }
            g.pinned_slots.set(loc.slot, prev + 1)
          }
          pi = pi + 1
        }
        let has_ret = qbe_stmts_has_cf(inl_body, false, false, true) ||
          qbe_stmts_has_default_ret(g, inl_body)
        let out_reg = if !has_ret {
          let bres = qbe_emit_stmts(
            g,
            inl_body,
            Some(finfo.ret_ty),
            destructure && qbe_has_simple_tuple_tail(inl_body, finfo.ret_ty),
          )
          let r = qbe_coerce_val(g, bres, finfo.ret_ty)
          qbe_scope_pop(g)
          r
        } else {
          let ret_lbl = qbe_lbl(g, "inl_ret")
          let ret_slot = match finfo.ret_ty {
            TUnit => ""
            _ => qbe_alloc_slot_for(g, finfo.ret_ty)
          }
          g.inline_ret_lbl = ret_lbl
          g.inline_ret_tag_slot = ""
          g.inline_ret_err_slot = ""
          g.inline_ret_pod_buf = false
          g.inline_ret_slot = ret_slot
          g.inline_ret_ty = finfo.ret_ty
          g.inline_ret_scope_depth = inl_scope_base
          let bres = qbe_emit_stmts(g, inl_body, Some(finfo.ret_ty))
          if !g.block_term {
            let r = qbe_coerce_val(g, bres, finfo.ret_ty)
            if ret_slot != "" {
              qbe_store_local_slot(g, r, ret_slot, finfo.ret_ty)
            }
            qbe_scope_pop(g)
            qbe_emit_term(g, "jmp " + ret_lbl)
          } else {
            let _ = g.scopes.pop()
          }
          qbe_emit_lbl(g, ret_lbl)
          g.block_immut_fields = Map([])
          if ret_slot == "" {
            "0"
          } else {
            qbe_load_local_slot(g, ret_slot, finfo.ret_ty)
          }
        }
        g.lookup_scope_floor = caller_floor
        g.in_verify = inl_saved_verify
        g.hoisted_arr_len = inl_hlen
        g.hoisted_arr_dp = inl_hdp
        g.hoisted_str_len = inl_hslen
        g.hoisted_str_dp = inl_hsdp
        g.hoisted_bytes_len = inl_hblen
        g.hoisted_bytes_dp = inl_hbdp
        g.hoisted_fields = inl_hfields
        g.block_immut_fields = Map([])
        g.len_aliases = inl_lalias
        g.len_alias_keys = inl_lkeys
        g.nonneg_vars = inl_nonneg
        g.u8_range_vars = inl_u8r
        g.known_min_len_arrs = inl_kml
        g.known_writable_bytes = inl_kwb
        g.bce_safe_indices = inl_bce
        g.bce_safe_exprs = inl_bce_exprs
        g.bce_safe_push_arrs = inl_bce_push
        g.promoted_fields = inl_prom
        g.promoted_field_tys = inl_prom_tys
        g.promoted_push_len = inl_pp_len
        g.promoted_push_cap = inl_pp_cap
        g.promoted_push_dp = inl_pp_dp
        g.w_to_l_ext = inl_w2l
        g.local_w_to_l_ext = inl_lw2l
        g.unfrozen_local_arrs = inl_unfrozen
        g.stack_view_slots = inl_stk_views
  g.pinned_slots = inl_pinned_slots
        g.movable_locals = inl_mov
        g.moved_slots = inl_moved
        g.inline_closures = inl_clos
        g.inline_ret_lbl = inl_rlbl
        g.inline_ret_tag_slot = inl_rtag
        g.inline_ret_err_slot = inl_rerr
        g.inline_ret_pod_buf = inl_rpod
        g.inline_ret_slot = inl_rslot
        g.inline_ret_ty = inl_rty
        g.inline_ret_scope_depth = inl_rdep
        g.tco_mode = inl_tco_mode
        g.tco_fn_name = inl_tco_fn
        g.tco_loop_lbl = inl_tco_lbl
        let _ = inl_bfields
        let _ = g.inline_stack.pop()
        g.inline_depth = g.inline_depth - 1
        Some(qval(out_reg, finfo.ret_ty))
      } else {
        None
      }
    }
    None => None
  }
}

///|
/// Cross-package small `pub` function / method inlining.
/// Uses the same `xpkg_fn_is_inlinable_tc` predicate as `.pionstub` emission
/// and switches `g.mono_pkg` to `target_pkg` for the duration of the inlined body.
fn qbe_try_inline_xpkg_fn_call(
  g : QbeGen,
  target_pkg : String,
  key : String,
  finfo : FnInfo,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
) -> Option[QbeVal] {
  let stack_key = target_pkg + "::" + key
  if !g.release ||
    target_pkg == "" ||
    g.inline_depth >= 3 ||
    finfo.decl.type_params.length() != 0 ||
    params_have_mut(finfo.decl.params) ||
    str_arr_contains(g.inline_stack, stack_key) {
    return None
  }
  let ipkg = match g.tc.imported_pkgs.get(target_pkg) {
    Some(p) => p
    None => return None
  }
  let inl_fd = finfo.decl
  if arg_vals.length() != inl_fd.params.length() ||
    arg_vals.length() != finfo.param_tys.length() {
    return None
  }
  let can_inl = if inl_fd.is_pub {
    xpkg_fn_is_inlinable_tc(ipkg.tc, inl_fd)
  } else {
    g.mono_pkg == target_pkg &&
    xpkg_fn_is_inlinable_priv_leaf_tc(ipkg.tc, inl_fd)
  }
  if !can_inl {
    return None
  }
  let self_key = if inl_fd.receiver_type != "" {
    inl_fd.receiver_type + "::" + inl_fd.name
  } else {
    inl_fd.name
  }
  let is_opt_res = match inl_fd.ret_ty {
    TyName("Option", _, _) | TyName("Result", _, _) => true
    _ => false
  }
  let fn_cost = qbe_stmts_inline_cost_in(
    inl_fd.body,
    self_key,
    false,
    if is_opt_res { 1 } else { 0 },
  )
  let xpkg_max_cost = qbe_inline_max_cost(g, false, true, is_opt_res)
  if fn_cost < 0 ||
    ((g.j2_disable_mask & 32) == 0 &&
      g.loop_breaks.length() == 0 &&
      !is_opt_res &&
      fn_cost > xpkg_max_cost) ||
    qbe_caller_over_inline_budget(g, fn_cost) {
    return None
  }
  g.fn_inlined_cost = g.fn_inlined_cost + (if fn_cost > 0 { fn_cost } else { 1 })
  g.inline_depth = g.inline_depth + 1
  g.inline_stack.push(stack_key)
  let inl_saved_mono_pkg = g.mono_pkg
  let inl_saved_imp_def = g.tc.in_imported_default_arg
  let inl_saved_def_exp = g.tc.in_default_arg_expansion
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  g.tc.in_imported_default_arg = false
  g.tc.in_default_arg_expansion = false
  let inl_hlen = g.hoisted_arr_len
  let inl_hdp = g.hoisted_arr_dp
  let inl_hslen = g.hoisted_str_len
  let inl_hsdp = g.hoisted_str_dp
  let inl_hblen = g.hoisted_bytes_len
  let inl_hbdp = g.hoisted_bytes_dp
  let inl_hfields = g.hoisted_fields
  let inl_bfields = g.block_immut_fields
  let inl_lalias = g.len_aliases
  let inl_lkeys = g.len_alias_keys
  let inl_nonneg = g.nonneg_vars
  let inl_u8r = g.u8_range_vars
  let inl_kml = g.known_min_len_arrs
  let inl_kwb = g.known_writable_bytes
  let inl_bce = g.bce_safe_indices
  let inl_bce_exprs = g.bce_safe_exprs
  let inl_bce_push = g.bce_safe_push_arrs
  let inl_prom = g.promoted_fields
  let inl_prom_tys = g.promoted_field_tys
  let inl_pp_len = g.promoted_push_len
  let inl_pp_cap = g.promoted_push_cap
  let inl_pp_dp = g.promoted_push_dp
  let inl_w2l = g.w_to_l_ext
  let inl_lw2l = g.local_w_to_l_ext
  let inl_unfrozen = g.unfrozen_local_arrs
  let inl_stk_views = g.stack_view_slots
  let inl_pinned_slots = g.pinned_slots
  let inl_mov = g.movable_locals
  let inl_moved = g.moved_slots
  let inl_clos = g.inline_closures
  let inl_rlbl = g.inline_ret_lbl
  let inl_rtag = g.inline_ret_tag_slot
  let inl_rerr = g.inline_ret_err_slot
  let inl_rpod = g.inline_ret_pod_buf
  let inl_rslot = g.inline_ret_slot
  let inl_rty = g.inline_ret_ty
  let inl_rdep = g.inline_ret_scope_depth
  let inl_tco_mode = g.tco_mode
  let inl_tco_fn = g.tco_fn_name
  let inl_tco_lbl = g.tco_loop_lbl
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.inline_ret_slot = ""
  g.inline_ret_ty = TUnit
  g.inline_ret_scope_depth = 0
  let inl_body = qbe_fn_body(g, inl_fd.body)
  let inl_saved_verify = g.in_verify
  g.in_verify = inl_fd.is_verify
  let inl_scope_base = g.scopes.length()
  qbe_scope_push(g)
  let inl_has_dp = qbe_stmts_has_any_data_ptr(inl_body)
  let mut pi = 0
  while pi < inl_fd.params.length() {
    let pty = finfo.param_tys[pi]
    let pname = inl_fd.params[pi].name
    let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
    let mut p_owned = !arg_borrowed[pi]
    if arg_borrowed[pi] && qbe_stmts_assigns_ident(inl_body, pname) {
      qbe_rc_inc(g, pv, pty)
      p_owned = true
    }
    let loc = qbe_define_local(g, pname, pty, p_owned)
    qbe_store_local_slot(g, pv, loc.slot, pty)
    if !p_owned {
      g.borrow_owner_slot.set(loc.slot, loc.slot)
      g.borrow_owner_name.set(loc.slot, pname)
    }
    if inl_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(inl_body, 0, pname) {
      let prev = match g.pinned_slots.get(loc.slot) {
        Some(c) => c
        None => 0
      }
      g.pinned_slots.set(loc.slot, prev + 1)
    }
    pi = pi + 1
  }
  let has_ret = qbe_stmts_has_cf(inl_body, false, false, true) ||
    qbe_stmts_has_default_ret(g, inl_body)
  let out_reg = if !has_ret {
    let bres = qbe_emit_stmts(g, inl_body, Some(finfo.ret_ty))
    let r = qbe_coerce_val(g, bres, finfo.ret_ty)
    qbe_scope_pop(g)
    r
  } else {
    let ret_lbl = qbe_lbl(g, "inl_ret")
    let ret_slot = match finfo.ret_ty {
      TUnit => ""
      _ => qbe_alloc_slot_for(g, finfo.ret_ty)
    }
    g.inline_ret_lbl = ret_lbl
    g.inline_ret_tag_slot = ""
    g.inline_ret_err_slot = ""
    g.inline_ret_pod_buf = false
    g.inline_ret_slot = ret_slot
    g.inline_ret_ty = finfo.ret_ty
    g.inline_ret_scope_depth = inl_scope_base
    let bres = qbe_emit_stmts(g, inl_body, Some(finfo.ret_ty))
    if !g.block_term {
      let r = qbe_coerce_val(g, bres, finfo.ret_ty)
      if ret_slot != "" {
        qbe_store_local_slot(g, r, ret_slot, finfo.ret_ty)
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + ret_lbl)
    } else {
      let _ = g.scopes.pop()
    }
    qbe_emit_lbl(g, ret_lbl)
    g.block_immut_fields = Map([])
    if ret_slot == "" {
      "0"
    } else {
      qbe_load_local_slot(g, ret_slot, finfo.ret_ty)
    }
  }
  g.in_verify = inl_saved_verify
  g.hoisted_arr_len = inl_hlen
  g.hoisted_arr_dp = inl_hdp
  g.hoisted_str_len = inl_hslen
  g.hoisted_str_dp = inl_hsdp
  g.hoisted_bytes_len = inl_hblen
  g.hoisted_bytes_dp = inl_hbdp
  g.hoisted_fields = inl_hfields
  g.block_immut_fields = Map([])
  g.len_aliases = inl_lalias
  g.len_alias_keys = inl_lkeys
  g.nonneg_vars = inl_nonneg
  g.u8_range_vars = inl_u8r
  g.known_min_len_arrs = inl_kml
  g.known_writable_bytes = inl_kwb
  g.bce_safe_indices = inl_bce
  g.bce_safe_exprs = inl_bce_exprs
  g.bce_safe_push_arrs = inl_bce_push
  g.promoted_fields = inl_prom
  g.promoted_field_tys = inl_prom_tys
  g.promoted_push_len = inl_pp_len
  g.promoted_push_cap = inl_pp_cap
  g.promoted_push_dp = inl_pp_dp
  g.w_to_l_ext = inl_w2l
  g.local_w_to_l_ext = inl_lw2l
  g.unfrozen_local_arrs = inl_unfrozen
  g.stack_view_slots = inl_stk_views
  g.pinned_slots = inl_pinned_slots
  g.movable_locals = inl_mov
  g.moved_slots = inl_moved
  g.inline_closures = inl_clos
  g.inline_ret_lbl = inl_rlbl
  g.inline_ret_tag_slot = inl_rtag
  g.inline_ret_err_slot = inl_rerr
  g.inline_ret_pod_buf = inl_rpod
  g.inline_ret_slot = inl_rslot
  g.inline_ret_ty = inl_rty
  g.inline_ret_scope_depth = inl_rdep
  g.tco_mode = inl_tco_mode
  g.tco_fn_name = inl_tco_fn
  g.tco_loop_lbl = inl_tco_lbl
  g.mono_pkg = inl_saved_mono_pkg
  g.tc.in_imported_default_arg = inl_saved_imp_def
  g.tc.in_default_arg_expansion = inl_saved_def_exp
  let _ = inl_bfields
  let _ = g.inline_stack.pop()
  g.inline_depth = g.inline_depth - 1
  Some(qval(out_reg, finfo.ret_ty))
}

///|
/// P55-C: Check whether `raw_ty` is a pure scalar immutable POD struct (1..=6 fields,
/// all immutable primitive scalar fields, zero RC references).
fn qbe_pure_scalar_pod_struct_info(g : QbeGen, raw_ty : Ty) -> Option[StructInfo] {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let n = sinfo.field_names.length()
          if n < 1 || n > 6 {
            return None
          }
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut i = 0
          while i < n {
            if sinfo.field_muts[i] {
              return None
            }
            let fty = subst_ty(sinfo.field_tys[i], subst)
            if !qbe_is_prim_array_elem(fty) {
              return None
            }
            i = i + 1
          }
          Some(sinfo)
        }
        None => None
      }
    _ => None
  }
}

///|
fn qbe_emit_struct_lit_into_buf(
  g : QbeGen,
  sinfo : StructInfo,
  struct_ty : Ty,
  fields : Array[FieldInit],
  buf : String,
) -> Unit {
  let subst = match struct_ty {
    TStruct(_, sargs) => make_subst(sinfo.decl.type_params, sargs)
    _ => Map([])
  }
  let n = sinfo.field_names.length()
  let written : Array[Bool] = []
  let mut wi = 0
  while wi < n {
    written.push(false)
    wi = wi + 1
  }
  let mut fi = 0
  while fi < fields.length() {
    let fname = fields[fi].name
    let mut j = 0
    let mut found = -1
    while j < n {
      if sinfo.field_names[j] == fname {
        found = j
        break
      }
      j = j + 1
    }
    if found >= 0 {
      let fty = subst_ty(sinfo.field_tys[found], subst)
      let fv = qbe_emit_expr(g, fields[fi].value, Some(fty))
      if g.block_term {
        return
      }
      let fc = qbe_coerce_val(g, fv, fty)
      let addr = if found == 0 {
        buf
      } else {
        let a = qbe_tmp(g)
        qbe_emit(g, a + " =l add " + buf + ", " + (found * 8).to_string())
        a
      }
      qbe_store_heap_slot(g, fc, addr, fty)
      written[found] = true
    }
    fi = fi + 1
  }
  let mut j = 0
  while j < n {
    if !written[j] {
      let fty = subst_ty(sinfo.field_tys[j], subst)
      let addr = if j == 0 {
        buf
      } else {
        let a = qbe_tmp(g)
        qbe_emit(g, a + " =l add " + buf + ", " + (j * 8).to_string())
        a
      }
      qbe_store_heap_slot(g, qbe_zero_reg(fty), addr, fty)
    }
    j = j + 1
  }
}

///|
fn qbe_copy_pod_buf(
  g : QbeGen,
  sinfo : StructInfo,
  struct_ty : Ty,
  src : String,
  dst : String,
) -> Unit {
  let subst = match struct_ty {
    TStruct(_, sargs) => make_subst(sinfo.decl.type_params, sargs)
    _ => Map([])
  }
  let n = sinfo.field_names.length()
  let mut j = 0
  while j < n {
    let fty = subst_ty(sinfo.field_tys[j], subst)
    let saddr = if j == 0 {
      src
    } else {
      let a = qbe_tmp(g)
      qbe_emit(g, a + " =l add " + src + ", " + (j * 8).to_string())
      a
    }
    let daddr = if j == 0 {
      dst
    } else {
      let a = qbe_tmp(g)
      qbe_emit(g, a + " =l add " + dst + ", " + (j * 8).to_string())
      a
    }
    let fv = qbe_load_heap_slot(g, saddr, fty)
    qbe_store_heap_slot(g, fv, daddr, fty)
    j = j + 1
  }
}

///|
fn qbe_match_opt_res_pod_unwrap_shape(
  arms : Array[MatchArm],
) -> (Int, Int, Int, String) {
  if arms.length() != 2 {
    return (0, -1, -1, "")
  }
  match (arms[0].guard_expr, arms[1].guard_expr) {
    (None, None) => ()
    _ => return (0, -1, -1, "")
  }
  let mut want_kind = 0
  let mut ok_idx = -1
  let mut err_idx = -1
  let mut ok_bind = ""
  match (arms[0].pat, arms[1].pat) {
    (PVariant(eq0, "Ok", s0, _, _), PVariant(eq1, "Err", s1, _, _)) =>
      if (eq0 == "" || eq0 == "Result") &&
        (eq1 == "" || eq1 == "Result") &&
        s0.length() == 1 &&
        s1.length() == 1 {
        match (s0[0], s1[0]) {
          (PIdent(b, _), PWild(_)) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          _ => ()
        }
      }
    (PVariant(eq0, "Ok", s0, _, _), PWild(_)) =>
      if (eq0 == "" || eq0 == "Result") && s0.length() == 1 {
        match s0[0] {
          PIdent(b, _) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          _ => ()
        }
      }
    (PVariant(eq0, "Err", s0, _, _), PVariant(eq1, "Ok", s1, _, _)) =>
      if (eq0 == "" || eq0 == "Result") &&
        (eq1 == "" || eq1 == "Result") &&
        s0.length() == 1 &&
        s1.length() == 1 {
        match (s0[0], s1[0]) {
          (PWild(_), PIdent(b, _)) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
            ok_bind = b
          }
          _ => ()
        }
      }
    (PVariant(eq0, "Some", s0, _, _), PVariant(eq1, "None", s1, _, _)) =>
      if (eq0 == "" || eq0 == "Option") &&
        (eq1 == "" || eq1 == "Option") &&
        s0.length() == 1 &&
        s1.length() == 0 {
        match s0[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          _ => ()
        }
      }
    (PVariant(eq0, "Some", s0, _, _), PWild(_)) =>
      if (eq0 == "" || eq0 == "Option") && s0.length() == 1 {
        match s0[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          _ => ()
        }
      }
    (PVariant(eq0, "None", s0, _, _), PVariant(eq1, "Some", s1, _, _)) =>
      if (eq0 == "" || eq0 == "Option") &&
        (eq1 == "" || eq1 == "Option") &&
        s0.length() == 0 &&
        s1.length() == 1 {
        match s1[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 1
            err_idx = 0
            ok_bind = b
          }
          _ => ()
        }
      }
    _ => ()
  }
  if want_kind == 0 {
    return (0, -1, -1, "")
  }
  let ok_is_id = match arms[ok_idx].body {
    EIdent(bn, _) => bn == ok_bind
    _ => false
  }
  if !ok_is_id {
    return (0, -1, -1, "")
  }
  (want_kind, ok_idx, err_idx, ok_bind)
}

///|
fn qbe_expr_all_tails_are_pod_struct_lits(e : Expr) -> Bool {
  match e {
    EStructLit(_, None, _, _) => true
    EBlock(bs, _) => qbe_stmts_all_tails_are_pod_struct_lits(bs)
    EIf(_, then_s, Some(else_e), _) =>
      qbe_stmts_all_tails_are_pod_struct_lits(then_s) &&
      qbe_expr_all_tails_are_pod_struct_lits(else_e)
    EMatch(_, arms, _) => {
      let (wk, _, _, _) = qbe_match_opt_res_pod_unwrap_shape(arms)
      wk > 0
    }
    _ => false
  }
}

///|
fn qbe_stmts_all_tails_are_pod_struct_lits(stmts : Array[Stmt]) -> Bool {
  if stmts.length() == 0 {
    return false
  }
  if qbe_stmts_has_cf(stmts, false, false, true) {
    return false
  }
  match stmts[stmts.length() - 1] {
    SExpr(tail_e, _) => qbe_expr_all_tails_are_pod_struct_lits(tail_e)
    _ => false
  }
}

///|
fn qbe_expr_returns_are_pod_struct_lits(e : Expr) -> Bool {
  match e {
    ETry(_, _) => false
    EClosure(_, _, _, _) => true
    EBlock(bs, _) => qbe_stmts_returns_are_pod_struct_lits(bs)
    EIf(cond, then_s, else_opt, _) => {
      if !qbe_expr_returns_are_pod_struct_lits(cond) ||
        !qbe_stmts_returns_are_pod_struct_lits(then_s) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_expr_returns_are_pod_struct_lits(el)
      }
    }
    EMatch(s, arms, _) => {
      if !qbe_expr_returns_are_pod_struct_lits(s) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_expr_returns_are_pod_struct_lits(ge) {
              return false
            }
          None => ()
        }
        if !qbe_expr_returns_are_pod_struct_lits(arms[i].body) {
          return false
        }
        i = i + 1
      }
      true
    }
    EUnary(_, inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | EMove(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_returns_are_pod_struct_lits(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_returns_are_pod_struct_lits(l) &&
      qbe_expr_returns_are_pod_struct_lits(r)
    ECall(callee, args, _) => {
      if !qbe_expr_returns_are_pod_struct_lits(callee) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_returns_are_pod_struct_lits(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(recv, _, args, _) => {
      if !qbe_expr_returns_are_pod_struct_lits(recv) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_returns_are_pod_struct_lits(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_expr_returns_are_pod_struct_lits(elems[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(sp_e) =>
          if !qbe_expr_returns_are_pod_struct_lits(sp_e) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_expr_returns_are_pod_struct_lits(fields[i].value) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => true
  }
}

///|
fn qbe_stmts_returns_are_pod_struct_lits(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SReturn(None, _) => return false
      SReturn(Some(e), _) =>
        if !qbe_expr_returns_are_pod_struct_lits(e) ||
          !qbe_expr_all_tails_are_pod_struct_lits(e) {
          return false
        }
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
        if !qbe_expr_returns_are_pod_struct_lits(init) {
          return false
        }
      SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) =>
        if !qbe_expr_returns_are_pod_struct_lits(l) ||
          !qbe_expr_returns_are_pod_struct_lits(r) {
          return false
        }
      SGuard(c, b, _) | SWhile(c, b, _) =>
        if !qbe_expr_returns_are_pod_struct_lits(c) ||
          !qbe_stmts_returns_are_pod_struct_lits(b) {
          return false
        }
      SFor(init_s, cond, step_s, b, _) =>
        if !qbe_stmts_returns_are_pod_struct_lits([init_s]) ||
          !qbe_expr_returns_are_pod_struct_lits(cond) ||
          !qbe_stmts_returns_are_pod_struct_lits([step_s]) ||
          !qbe_stmts_returns_are_pod_struct_lits(b) {
          return false
        }
      SForRange(_, s, e, _, b, _) =>
        if !qbe_expr_returns_are_pod_struct_lits(s) ||
          !qbe_expr_returns_are_pod_struct_lits(e) ||
          !qbe_stmts_returns_are_pod_struct_lits(b) {
          return false
        }
      SForIn(_, _, iter, b, _) =>
        if !qbe_expr_returns_are_pod_struct_lits(iter) ||
          !qbe_stmts_returns_are_pod_struct_lits(b) {
          return false
        }
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_fn_body_all_returns_are_pod_struct_lits(stmts : Array[Stmt]) -> Bool {
  if stmts.length() == 0 {
    return false
  }
  if !qbe_stmts_returns_are_pod_struct_lits(stmts) {
    return false
  }
  match stmts[stmts.length() - 1] {
    SReturn(Some(_), _) => true
    SExpr(tail_e, _) => qbe_expr_all_tails_are_pod_struct_lits(tail_e)
    _ => false
  }
}

///|
fn qbe_emit_tail_pod_struct_into_buf(
  g : QbeGen,
  e : Expr,
  sinfo : StructInfo,
  struct_ty : Ty,
  buf : String,
) -> Unit {
  if g.block_term {
    return
  }
  match e {
    EBlock(bs, _) => {
      qbe_scope_push(g)
      qbe_emit_tail_pod_struct_stmts_into_buf(g, bs, sinfo, struct_ty, buf)
      qbe_scope_pop(g)
    }
    EIf(cond, then_s, Some(else_e), _) => {
      let l_then = qbe_lbl(g, "spod_then")
      let l_else = qbe_lbl(g, "spod_else")
      let l_end = qbe_lbl(g, "spod_end")
      if qbe_expr_has_is(cond) {
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_then, l_else, Some(then_s))
        qbe_emit_lbl(g, l_then)
      } else {
        qbe_emit_cond_branch(g, cond, l_then, l_else)
        qbe_emit_lbl(g, l_then)
        qbe_scope_push(g)
      }
      g.block_immut_fields = Map([])
      qbe_emit_tail_pod_struct_stmts_into_buf(g, then_s, sinfo, struct_ty, buf)
      qbe_scope_pop(g)
      let then_term = g.block_term
      if !then_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      qbe_emit_lbl(g, l_else)
      g.block_immut_fields = Map([])
      qbe_scope_push(g)
      qbe_emit_tail_pod_struct_into_buf(g, else_e, sinfo, struct_ty, buf)
      qbe_scope_pop(g)
      let else_term = g.block_term
      if !else_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      if then_term && else_term {
        g.block_term = true
      } else {
        qbe_emit_lbl(g, l_end)
        g.block_immut_fields = Map([])
      }
    }
    EStructLit(_, None, fields, _) =>
      qbe_emit_struct_lit_into_buf(g, sinfo, struct_ty, fields, buf)
    EMatch(scrut, arms, _) => {
      let (want_kind, _ok_idx, err_idx, _ok_bind) = qbe_match_opt_res_pod_unwrap_shape(
        arms,
      )
      if want_kind > 0 {
        match qbe_try_emit_opt_res_scalarized(g, scrut, want_kind, true) {
          Some(sc) => {
            if g.block_term {
              return
            }
            let tag_w = qbe_tmp(g)
            let l_ok = qbe_lbl(g, "spod_mok")
            let l_err = qbe_lbl(g, "spod_merr")
            let l_end = qbe_lbl(g, "spod_mend")
            qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
            qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
            qbe_emit_lbl(g, l_ok)
            g.block_immut_fields = Map([])
            if sc.val_is_pod_buf {
              qbe_copy_pod_buf(g, sinfo, struct_ty, sc.val_slot, buf)
            } else {
              let ptr = qbe_load_heap_slot(g, sc.val_slot, struct_ty)
              qbe_copy_pod_buf(g, sinfo, struct_ty, ptr, buf)
              qbe_rc_dec(g, ptr, struct_ty)
            }
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_err)
            g.block_immut_fields = Map([])
            match sc.ret_ty {
              TResult(_, err_ty) => {
                let ev = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                qbe_rc_dec(g, ev, err_ty)
              }
              _ => ()
            }
            qbe_scope_push(g)
            if qbe_expr_all_tails_are_pod_struct_lits(arms[err_idx].body) {
              qbe_emit_tail_pod_struct_into_buf(
                g,
                arms[err_idx].body,
                sinfo,
                struct_ty,
                buf,
              )
            } else {
              let ev = qbe_emit_expr(g, arms[err_idx].body, Some(struct_ty))
              if !g.block_term {
                let er = qbe_coerce_val(g, ev, struct_ty)
                qbe_copy_pod_buf(g, sinfo, struct_ty, er, buf)
                qbe_rc_dec(g, er, struct_ty)
              }
            }
            qbe_scope_pop(g)
            if !g.block_term {
              qbe_emit_term(g, "jmp " + l_end)
            }
            qbe_emit_lbl(g, l_end)
            g.block_immut_fields = Map([])
          }
          None => {
            let mv = qbe_emit_expr(g, e, Some(struct_ty))
            if !g.block_term {
              let mr = qbe_coerce_val(g, mv, struct_ty)
              qbe_copy_pod_buf(g, sinfo, struct_ty, mr, buf)
              qbe_rc_dec(g, mr, struct_ty)
            }
          }
        }
      }
    }
    _ => {
      let ev = qbe_emit_expr(g, e, Some(struct_ty))
      if !g.block_term {
        let er = qbe_coerce_val(g, ev, struct_ty)
        qbe_copy_pod_buf(g, sinfo, struct_ty, er, buf)
        qbe_rc_dec(g, er, struct_ty)
      }
    }
  }
}

///|
fn qbe_emit_tail_pod_struct_stmts_into_buf(
  g : QbeGen,
  stmts : Array[Stmt],
  sinfo : StructInfo,
  struct_ty : Ty,
  buf : String,
) -> Unit {
  let n = stmts.length()
  let mut i = 0
  while i < n - 1 {
    if g.block_term {
      return
    }
    if qbe_try_emit_stack_pod_let(g, stmts, i) {
      i = i + 1
      continue
    }
    let _ = qbe_emit_stmt(g, stmts[i], None, false)
    i = i + 1
  }
  if !g.block_term && n > 0 {
    match stmts[n - 1] {
      SExpr(tail_e, _) =>
        qbe_emit_tail_pod_struct_into_buf(g, tail_e, sinfo, struct_ty, buf)
      SReturn(_, _) => {
        let _ = qbe_emit_stmt(g, stmts[n - 1], None, true)
      }
      _ => ()
    }
  }
}

///|
fn qbe_inline_body_into_pod_buf(
  g : QbeGen,
  target_pkg : String,
  stack_key : String,
  inl_fd : FnDecl,
  finfo : FnInfo,
  sinfo : StructInfo,
  struct_ty : Ty,
  buf : String,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
) -> Unit {
  g.fn_inlined_cost = g.fn_inlined_cost +
    qbe_callee_inline_cost_for_budget(g, target_pkg, stack_key, inl_fd)
  g.inline_depth = g.inline_depth + 1
  g.inline_stack.push(stack_key)
  let inl_saved_mono_pkg = g.mono_pkg
  let inl_saved_imp_def = g.tc.in_imported_default_arg
  let inl_saved_def_exp = g.tc.in_default_arg_expansion
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  g.tc.in_imported_default_arg = false
  g.tc.in_default_arg_expansion = false
  let inl_hlen = g.hoisted_arr_len
  let inl_hdp = g.hoisted_arr_dp
  let inl_hslen = g.hoisted_str_len
  let inl_hsdp = g.hoisted_str_dp
  let inl_hblen = g.hoisted_bytes_len
  let inl_hbdp = g.hoisted_bytes_dp
  let inl_hfields = g.hoisted_fields
  let inl_bfields = g.block_immut_fields
  let inl_lalias = g.len_aliases
  let inl_lkeys = g.len_alias_keys
  let inl_nonneg = g.nonneg_vars
  let inl_u8r = g.u8_range_vars
  let inl_kml = g.known_min_len_arrs
  let inl_kwb = g.known_writable_bytes
  let inl_bce = g.bce_safe_indices
  let inl_bce_exprs = g.bce_safe_exprs
  let inl_bce_push = g.bce_safe_push_arrs
  let inl_prom = g.promoted_fields
  let inl_prom_tys = g.promoted_field_tys
  let inl_pp_len = g.promoted_push_len
  let inl_pp_cap = g.promoted_push_cap
  let inl_pp_dp = g.promoted_push_dp
  let inl_w2l = g.w_to_l_ext
  let inl_lw2l = g.local_w_to_l_ext
  let inl_unfrozen = g.unfrozen_local_arrs
  let inl_stk_views = g.stack_view_slots
  let inl_pinned_slots = g.pinned_slots
  let inl_mov = g.movable_locals
  let inl_moved = g.moved_slots
  let inl_clos = g.inline_closures
  let inl_rlbl = g.inline_ret_lbl
  let inl_rtag = g.inline_ret_tag_slot
  let inl_rerr = g.inline_ret_err_slot
  let inl_rpod = g.inline_ret_pod_buf
  let inl_rslot = g.inline_ret_slot
  let inl_rty = g.inline_ret_ty
  let inl_rdep = g.inline_ret_scope_depth
  let inl_tco_mode = g.tco_mode
  let inl_tco_fn = g.tco_fn_name
  let inl_tco_lbl = g.tco_loop_lbl
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.inline_ret_slot = ""
  g.inline_ret_ty = TUnit
  g.inline_ret_scope_depth = 0
  let inl_body = qbe_fn_body(g, inl_fd.body)
  let inl_saved_verify = g.in_verify
  g.in_verify = inl_fd.is_verify
  let inl_scope_base = g.scopes.length()
  qbe_scope_push(g)
  let inl_has_dp = qbe_stmts_has_any_data_ptr(inl_body)
  let mut pi = 0
  while pi < inl_fd.params.length() {
    let pty = finfo.param_tys[pi]
    let pname = inl_fd.params[pi].name
    let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
    let mut p_owned = !arg_borrowed[pi]
    if arg_borrowed[pi] && qbe_stmts_assigns_ident(inl_body, pname) {
      qbe_rc_inc(g, pv, pty)
      p_owned = true
    }
    let loc = qbe_define_local(g, pname, pty, p_owned)
    qbe_store_local_slot(g, pv, loc.slot, pty)
    if !p_owned {
      g.borrow_owner_slot.set(loc.slot, loc.slot)
      g.borrow_owner_name.set(loc.slot, pname)
    }
    if inl_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(inl_body, 0, pname) {
      let prev = match g.pinned_slots.get(loc.slot) {
        Some(c) => c
        None => 0
      }
      g.pinned_slots.set(loc.slot, prev + 1)
    }
    pi = pi + 1
  }
  let has_ret = qbe_stmts_has_cf(inl_body, false, false, true) ||
    qbe_stmts_has_default_ret(g, inl_body)
  if !has_ret {
    qbe_emit_tail_pod_struct_stmts_into_buf(g, inl_body, sinfo, struct_ty, buf)
    qbe_scope_pop(g)
  } else {
    let pod_ret = qbe_lbl(g, "spod_ret")
    g.inline_ret_lbl = pod_ret
    g.inline_ret_tag_slot = ""
    g.inline_ret_err_slot = ""
    g.inline_ret_pod_buf = true
    g.inline_ret_slot = buf
    g.inline_ret_ty = struct_ty
    g.inline_ret_scope_depth = inl_scope_base
    qbe_emit_tail_pod_struct_stmts_into_buf(g, inl_body, sinfo, struct_ty, buf)
    if !g.block_term {
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + pod_ret)
    } else {
      let _ = g.scopes.pop()
    }
    qbe_emit_lbl(g, pod_ret)
    g.block_immut_fields = Map([])
  }
  g.in_verify = inl_saved_verify
  g.hoisted_arr_len = inl_hlen
  g.hoisted_arr_dp = inl_hdp
  g.hoisted_str_len = inl_hslen
  g.hoisted_str_dp = inl_hsdp
  g.hoisted_bytes_len = inl_hblen
  g.hoisted_bytes_dp = inl_hbdp
  g.hoisted_fields = inl_hfields
  g.block_immut_fields = Map([])
  g.len_aliases = inl_lalias
  g.len_alias_keys = inl_lkeys
  g.nonneg_vars = inl_nonneg
  g.u8_range_vars = inl_u8r
  g.known_min_len_arrs = inl_kml
  g.known_writable_bytes = inl_kwb
  g.bce_safe_indices = inl_bce
  g.bce_safe_exprs = inl_bce_exprs
  g.bce_safe_push_arrs = inl_bce_push
  g.promoted_fields = inl_prom
  g.promoted_field_tys = inl_prom_tys
  g.promoted_push_len = inl_pp_len
  g.promoted_push_cap = inl_pp_cap
  g.promoted_push_dp = inl_pp_dp
  g.w_to_l_ext = inl_w2l
  g.local_w_to_l_ext = inl_lw2l
  g.unfrozen_local_arrs = inl_unfrozen
  g.stack_view_slots = inl_stk_views
  g.pinned_slots = inl_pinned_slots
  g.movable_locals = inl_mov
  g.moved_slots = inl_moved
  g.inline_closures = inl_clos
  g.inline_ret_lbl = inl_rlbl
  g.inline_ret_tag_slot = inl_rtag
  g.inline_ret_err_slot = inl_rerr
  g.inline_ret_pod_buf = inl_rpod
  g.inline_ret_slot = inl_rslot
  g.inline_ret_ty = inl_rty
  g.inline_ret_scope_depth = inl_rdep
  g.tco_mode = inl_tco_mode
  g.tco_fn_name = inl_tco_fn
  g.tco_loop_lbl = inl_tco_lbl
  g.mono_pkg = inl_saved_mono_pkg
  g.tc.in_imported_default_arg = inl_saved_imp_def
  g.tc.in_default_arg_expansion = inl_saved_def_exp
  let _ = inl_bfields
  let _ = g.inline_stack.pop()
  g.inline_depth = g.inline_depth - 1
}

///|
/// P51-C / P55-C: Zero-alloc scalarization of short-lived boxed `Option[T]` / `Result[T, E]`
/// produced directly inside `EMatch`, `ETry` (`?`), `EIs`, or `Option`/`Result` methods.
/// Convention for `tag_slot : w`: `1 = Some / Ok`, `0 = None / Err`.
/// When `val_is_pod_buf == false`, payload is stored in `val_slot` (8B stack slot) and `err_slot == val_slot`.
/// When `val_is_pod_buf == true`, `val_slot` is an `n*8`B stack buffer for the pure-scalar POD `Ok`/`Some`
/// struct, and `err_slot` is a separate 8B stack slot for `Err`.
struct QbeScalarOptRes {
  tag_slot : String
  val_slot : String
  err_slot : String
  val_is_pod_buf : Bool
  ret_ty : Ty
}

///|
fn qbe_ty_is_unresolved_scalar(t : Ty) -> Bool {
  match t {
    TParam(_) | TError | TNever => true
    _ => false
  }
}

///|
enum QbeOptResPodKind {
  PodStruct(StructInfo, Ty, Int)
  PodEnum(EnumInfo, Ty, Int)
}

///|
fn qbe_pure_scalar_pod_enum_info(g : QbeGen, raw_ty : Ty) -> Option[(EnumInfo, Int)] {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  let layout = qbe_enum_layout(g, ty)
  if layout.is_unit_only {
    return None
  }
  match ty {
    TEnum(ename, eargs) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          if einfo.variants.length() == 0 ||
            einfo.decl.type_params.length() != eargs.length() {
            return None
          }
          let mut ai = 0
          while ai < eargs.length() {
            if qbe_ty_is_unresolved_scalar(eargs[ai]) {
              return None
            }
            ai = ai + 1
          }
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut max_payload = 0
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            if v.field_tys.length() > 4 {
              return None
            }
            let mut fi = 0
            while fi < v.field_tys.length() {
              let fty = subst_ty(v.field_tys[fi], subst)
              if !qbe_is_prim_array_elem(fty) {
                return None
              }
              fi = fi + 1
            }
            if v.field_tys.length() > max_payload {
              max_payload = v.field_tys.length()
            }
            vi = vi + 1
          }
          Some((einfo, if layout.is_niche { max_payload } else { 1 + max_payload }))
        }
        None => None
      }
    _ => None
  }
}

///|
/// Allocates `24 + payload_bytes` on the function entry stack, writes a valid
/// immortal+frozen `PionHeader` (matching `runtime/pion_rt.h`: owner_tid=0,
/// local_rc=0, shared_rc=1, `type_tag`, flags=FROZEN|IMMORTAL|DEEP_FROZEN(11),
/// drop_fn=NULL), and returns the object body pointer (`raw + 24`).
/// Every stack-promoted Pion object (POD structs, POD enums, StrView/BytesView)
/// MUST carry this immortal header so that any conservative `pion_rc_inc` /
/// `pion_rc_dec` / `pion_rc_freeze` / inline-RC fast path emitted along a
/// borrowed call chain is a guaranteed read-only no-op and never underflows
/// or corrupts the caller's stack frame.
fn qbe_alloc_immortal_stack_buf(
  g : QbeGen,
  payload_bytes : Int,
  type_tag : Int,
) -> String {
  let raw = qbe_tmp(g)
  let total = 24 + payload_bytes
  g.fn_allocs.write_string("    " + raw + " =l alloc8 " + total.to_string() + "\n")
  g.fn_allocs.write_string("    storel 0, " + raw + "\n")
  let p8 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p8 + " =l add " + raw + ", 8\n")
  g.fn_allocs.write_string("    storew 1, " + p8 + "\n")
  let p12 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p12 + " =l add " + raw + ", 12\n")
  g.fn_allocs.write_string("    storeh " + type_tag.to_string() + ", " + p12 + "\n")
  let p14 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p14 + " =l add " + raw + ", 14\n")
  g.fn_allocs.write_string("    storeh 11, " + p14 + "\n")
  let p16 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p16 + " =l add " + raw + ", 16\n")
  g.fn_allocs.write_string("    storel 0, " + p16 + "\n")
  let body = qbe_tmp(g)
  g.fn_allocs.write_string("    " + body + " =l add " + raw + ", 24\n")
  body
}

///|
fn qbe_alloc_immortal_enum_stack_buf(g : QbeGen, payload_bytes : Int) -> String {
  // Reserve 8 bytes immediately before the 24-byte PionHeader (`body - 32`) so
  // null-niche POD enums can store their runtime pointer (`0` or `body`) alongside
  // the immortal stack buffer without altering `QbeScalarOptRes` or caller ABIs.
  let raw = qbe_tmp(g)
  let total = 32 + payload_bytes
  g.fn_allocs.write_string("    " + raw + " =l alloc8 " + total.to_string() + "\n")
  g.fn_allocs.write_string("    storel 0, " + raw + "\n")
  let h0 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + h0 + " =l add " + raw + ", 8\n")
  g.fn_allocs.write_string("    storel 0, " + h0 + "\n")
  let p8 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p8 + " =l add " + raw + ", 16\n")
  g.fn_allocs.write_string("    storew 1, " + p8 + "\n")
  let p12 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p12 + " =l add " + raw + ", 20\n")
  g.fn_allocs.write_string("    storeh 5, " + p12 + "\n")
  let p14 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p14 + " =l add " + raw + ", 22\n")
  g.fn_allocs.write_string("    storeh 11, " + p14 + "\n")
  let p16 = qbe_tmp(g)
  g.fn_allocs.write_string("    " + p16 + " =l add " + raw + ", 24\n")
  g.fn_allocs.write_string("    storel 0, " + p16 + "\n")
  let body = qbe_tmp(g)
  g.fn_allocs.write_string("    " + body + " =l add " + raw + ", 32\n")
  body
}

///|
fn qbe_pod_buf_val(g : QbeGen, val_slot : String, ty : Ty) -> String {
  if qbe_is_niche_enum(g, ty) {
    let pslot = qbe_tmp(g)
    let r = qbe_tmp(g)
    qbe_emit(g, pslot + " =l sub " + val_slot + ", 32")
    qbe_emit(g, r + " =l loadl " + pslot)
    r
  } else {
    val_slot
  }
}

///|
/// Safely copies a pure-scalar enum from an arbitrary runtime object `src_p`
/// into a stack buffer `dst_p` without reading past smaller variants' allocations.
fn qbe_emit_copy_pod_enum_slots(
  g : QbeGen,
  src_p : String,
  dst_p : String,
  einfo : EnumInfo,
) -> Unit {
  let layout = qbe_enum_layout_for_info(einfo)
  if layout.is_niche {
    let pslot = qbe_tmp(g)
    qbe_emit(g, pslot + " =l sub " + dst_p + ", 32")
    let nz = qbe_tmp(g)
    let l_pay = qbe_lbl(g, "cpe_hit")
    let l_null = qbe_lbl(g, "cpe_nnull")
    let l_done = qbe_lbl(g, "cpe_ndone")
    qbe_emit(g, nz + " =w cnel " + src_p + ", 0")
    qbe_emit_term(g, "jnz " + nz + ", " + l_pay + ", " + l_null)
    qbe_emit_lbl(g, l_null)
    qbe_emit(g, "storel 0, " + pslot)
    qbe_emit_term(g, "jmp " + l_done)
    qbe_emit_lbl(g, l_pay)
    let nf = einfo.variants[layout.payload_tag].field_tys.length()
    let mut fi = 0
    while fi < nf {
      let off = layout.payload_offset + fi * 8
      let sp_i = if off == 0 {
        src_p
      } else {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l add " + src_p + ", " + off.to_string())
        t
      }
      let dp_i = if off == 0 {
        dst_p
      } else {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l add " + dst_p + ", " + off.to_string())
        t
      }
      let fv = qbe_tmp(g)
      qbe_emit(g, fv + " =l loadl " + sp_i)
      qbe_emit(g, "storel " + fv + ", " + dp_i)
      fi = fi + 1
    }
    qbe_emit(g, "storel " + dst_p + ", " + pslot)
    qbe_emit_term(g, "jmp " + l_done)
    qbe_emit_lbl(g, l_done)
    g.block_immut_fields = Map([])
    return
  }
  let tag_l = qbe_tmp(g)
  qbe_emit(g, tag_l + " =l loadl " + src_p)
  qbe_emit(g, "storel " + tag_l + ", " + dst_p)
  let mut has_payload_variant = false
  let mut vi = 0
  while vi < einfo.variants.length() {
    if einfo.variants[vi].field_tys.length() > 0 {
      has_payload_variant = true
      break
    }
    vi = vi + 1
  }
  if !has_payload_variant {
    return
  }
  let l_done = qbe_lbl(g, "cpe_done")
  vi = 0
  while vi < einfo.variants.length() {
    let nf = einfo.variants[vi].field_tys.length()
    if nf > 0 {
      let l_hit = qbe_lbl(g, "cpe_hit")
      let l_next = qbe_lbl(g, "cpe_next")
      let cmp = qbe_tmp(g)
      qbe_emit(g, cmp + " =w ceql " + tag_l + ", " + vi.to_string())
      qbe_emit_term(g, "jnz " + cmp + ", " + l_hit + ", " + l_next)
      qbe_emit_lbl(g, l_hit)
      let mut fi = 0
      while fi < nf {
        let off = layout.payload_offset + fi * 8
        let sp_i = qbe_tmp(g)
        let dp_i = qbe_tmp(g)
        let fv = qbe_tmp(g)
        qbe_emit(g, sp_i + " =l add " + src_p + ", " + off.to_string())
        qbe_emit(g, dp_i + " =l add " + dst_p + ", " + off.to_string())
        qbe_emit(g, fv + " =l loadl " + sp_i)
        qbe_emit(g, "storel " + fv + ", " + dp_i)
        fi = fi + 1
      }
      qbe_emit_term(g, "jmp " + l_done)
      qbe_emit_lbl(g, l_next)
    }
    vi = vi + 1
  }
  qbe_emit_term(g, "jmp " + l_done)
  qbe_emit_lbl(g, l_done)
  g.block_immut_fields = Map([])
}

///|
fn qbe_resolve_pod_enum_ctor(
  g : QbeGen,
  e : Expr,
  einfo : EnumInfo,
  enum_ty : Ty,
) -> Option[(Int, Array[Expr], Array[Ty])] {
  let (enum_name, eargs) = match enum_ty {
    TEnum(en, ea) => (en, ea)
    _ => return None
  }
  let subst = make_subst(einfo.decl.type_params, eargs)
  let (cand_en, vname, args) : (String, String, Array[Expr]) = match e {
    EIdent(vn, _) => ("", vn, [])
    EPath(en, vn, _) => (en, vn, [])
    EDotVariant(vn, a, _) => ("", vn, a)
    ECall(EIdent(vn, _), a, _) => ("", vn, a)
    ECall(EPath(en, vn, _), a, _) => (en, vn, a)
    _ => return None
  }
  if cand_en != "" {
    let cqp = split_qual_name(cand_en)
    if cqp.prefix != "" {
      // 3-part path like `pkg::E::Val` or `alias::E::Val`: resolve `cqp.prefix` in scope
      // and verify canonical `ipkg.name + "::" + cqp.name == enum_name` (and not a struct).
      match qbe_resolve_pkg_in_scope(g, cqp.prefix) {
        Some(ipkg) => {
          if ipkg.tc.structs.contains(cqp.name) || !ipkg.tc.enums.contains(cqp.name) {
            return None
          }
          if ipkg.name + "::" + cqp.name != enum_name {
            return None
          }
        }
        None => return None
      }
    } else {
      // 2-part path like `E::Val`: reject if `cand_en` is an imported package or alias in scope
      // (e.g. `import "maker" as E; E::Val(7)` calls `maker::Val`, not `model::E::Val`).
      match qbe_resolve_pkg_in_scope(g, cand_en) {
        Some(_) => return None
        None => ()
      }
      if g.mono_pkg != "" {
        match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
          Some(mpkg) => {
            if mpkg.tc.structs.contains(cand_en) || !mpkg.tc.enums.contains(cand_en) {
              return None
            }
            if mpkg.name + "::" + cand_en != enum_name &&
              g.mono_pkg + "::" + cand_en != enum_name {
              return None
            }
          }
          None => return None
        }
      } else {
        if g.tc.structs.contains(cand_en) || !g.tc.enums.contains(cand_en) {
          return None
        }
        if cand_en != enum_name {
          return None
        }
      }
    }
  } else {
    match e {
      EIdent(vn, _) => {
        match qbe_lookup_local(g, vn) {
          Some(_) => return None
          None => ()
        }
        if qbe_has_user_callee(g, vn) {
          return None
        }
        if g.mono_pkg != "" {
          match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
            Some(mpkg) =>
              if mpkg.tc.consts.contains(vn) {
                return None
              }
            None => ()
          }
        } else if g.tc.consts.contains(vn) {
          return None
        }
      }
      ECall(EIdent(vn, _), _, sp) => {
        match qbe_lookup_local(g, vn) {
          Some(_) => return None
          None => ()
        }
        if qbe_has_user_callee(g, vn) {
          return None
        }
        let def_tc = if g.mono_pkg != "" {
          match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
            Some(mpkg) => mpkg.tc
            None => return None
          }
        } else {
          g.tc
        }
        if def_tc.consts.contains(vn) ||
          !def_tc.resolved_method_calls.contains("ctor:" + span_key(sp)) {
          return None
        }
      }
      _ => ()
    }
  }
  let mut vi = 0
  while vi < einfo.variants.length() {
    let v = einfo.variants[vi]
    if v.name == vname && v.field_tys.length() == args.length() {
      let ftys : Array[Ty] = []
      let mut fi = 0
      while fi < v.field_tys.length() {
        ftys.push(subst_ty(v.field_tys[fi], subst))
        fi = fi + 1
      }
      return Some((vi, args, ftys))
    }
    vi = vi + 1
  }
  None
}

///|
fn qbe_expr_all_tails_are_pod_enum_ctors(
  g : QbeGen,
  e : Expr,
  einfo : EnumInfo,
  enum_ty : Ty,
) -> Bool {
  match e {
    EBlock(bs, _) => {
      if bs.length() == 0 || qbe_stmts_has_cf(bs, false, false, true) {
        return false
      }
      match bs[bs.length() - 1] {
        SExpr(te, _) => qbe_expr_all_tails_are_pod_enum_ctors(g, te, einfo, enum_ty)
        _ => false
      }
    }
    EIf(_, then_s, Some(else_e), _) => {
      if then_s.length() == 0 || qbe_stmts_has_cf(then_s, false, false, true) {
        return false
      }
      let then_ok = match then_s[then_s.length() - 1] {
        SExpr(te, _) => qbe_expr_all_tails_are_pod_enum_ctors(g, te, einfo, enum_ty)
        _ => false
      }
      then_ok && qbe_expr_all_tails_are_pod_enum_ctors(g, else_e, einfo, enum_ty)
    }
    _ =>
      match qbe_resolve_pod_enum_ctor(g, e, einfo, enum_ty) {
        Some(_) => true
        None => false
      }
  }
}

///|
fn qbe_emit_tail_pod_enum_into_buf(
  g : QbeGen,
  e : Expr,
  einfo : EnumInfo,
  enum_ty : Ty,
  buf : String,
) -> Unit {
  if g.block_term {
    return
  }
  match e {
    EBlock(bs, _) => {
      qbe_scope_push(g)
      let n = bs.length()
      let mut i = 0
      while i < n - 1 {
        if g.block_term {
          break
        }
        let _ = qbe_emit_stmt(g, bs[i], None, false)
        i = i + 1
      }
      if !g.block_term && n > 0 {
        match bs[n - 1] {
          SExpr(te, _) => qbe_emit_tail_pod_enum_into_buf(g, te, einfo, enum_ty, buf)
          _ => ()
        }
      }
      qbe_scope_pop(g)
    }
    EIf(cond, then_s, Some(else_e), _) => {
      let l_then = qbe_lbl(g, "pe_then")
      let l_else = qbe_lbl(g, "pe_else")
      let l_end = qbe_lbl(g, "pe_end")
      if qbe_expr_has_is(cond) {
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_then, l_else, Some(then_s))
        qbe_emit_lbl(g, l_then)
      } else {
        qbe_emit_cond_branch(g, cond, l_then, l_else)
        qbe_emit_lbl(g, l_then)
        qbe_scope_push(g)
      }
      g.block_immut_fields = Map([])
      let tn = then_s.length()
      let mut ti = 0
      while ti < tn - 1 {
        if g.block_term {
          break
        }
        let _ = qbe_emit_stmt(g, then_s[ti], None, false)
        ti = ti + 1
      }
      if !g.block_term && tn > 0 {
        match then_s[tn - 1] {
          SExpr(te, _) => qbe_emit_tail_pod_enum_into_buf(g, te, einfo, enum_ty, buf)
          _ => ()
        }
      }
      qbe_scope_pop(g)
      let then_term = g.block_term
      if !then_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      qbe_emit_lbl(g, l_else)
      g.block_immut_fields = Map([])
      qbe_scope_push(g)
      qbe_emit_tail_pod_enum_into_buf(g, else_e, einfo, enum_ty, buf)
      qbe_scope_pop(g)
      let else_term = g.block_term
      if !else_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      if then_term && else_term {
        g.block_term = true
      } else {
        qbe_emit_lbl(g, l_end)
        g.block_immut_fields = Map([])
      }
    }
    _ =>
      match qbe_resolve_pod_enum_ctor(g, e, einfo, enum_ty) {
        Some((tag, args, ftys)) => {
          let arg_regs : Array[String] = []
          let mut fi = 0
          while fi < args.length() {
            let av = qbe_emit_expr(g, args[fi], Some(ftys[fi]))
            if g.block_term {
              return
            }
            arg_regs.push(qbe_coerce_val(g, av, ftys[fi]))
            fi = fi + 1
          }
          let layout = qbe_enum_layout_for_info(einfo)
          if layout.is_niche {
            let pslot = qbe_tmp(g)
            qbe_emit(g, pslot + " =l sub " + buf + ", 32")
            if tag == layout.null_tag {
              qbe_emit(g, "storel 0, " + pslot)
            } else {
              fi = 0
              while fi < arg_regs.length() {
                let off = layout.payload_offset + fi * 8
                let addr = if off == 0 {
                  buf
                } else {
                  let t = qbe_tmp(g)
                  qbe_emit(g, t + " =l add " + buf + ", " + off.to_string())
                  t
                }
                qbe_store_heap_slot(g, arg_regs[fi], addr, ftys[fi])
                fi = fi + 1
              }
              qbe_emit(g, "storel " + buf + ", " + pslot)
            }
          } else {
            qbe_emit(g, "storel " + tag.to_string() + ", " + buf)
            fi = 0
            while fi < arg_regs.length() {
              let off = layout.payload_offset + fi * 8
              let addr = qbe_tmp(g)
              qbe_emit(g, addr + " =l add " + buf + ", " + off.to_string())
              qbe_store_heap_slot(g, arg_regs[fi], addr, ftys[fi])
              fi = fi + 1
            }
          }
        }
        None => {
          let ev = qbe_emit_expr(g, e, Some(enum_ty))
          if g.block_term {
            return
          }
          qbe_emit_copy_pod_enum_slots(g, ev.reg, buf, einfo)
          qbe_rc_dec(g, ev.reg, enum_ty)
        }
      }
  }
}

///|
/// True iff `pat` destructures a pure-scalar enum without binding the enum pointer itself.
fn qbe_pat_is_safe_enum_destructure(pat : Pattern) -> Bool {
  match pat {
    PWild(_) => true
    PVariant(_, _, subs, _, _) => {
      let mut i = 0
      while i < subs.length() {
        match subs[i] {
          PWild(_) | PIdent(_, _) | PBool(_, _) | PInt(_, _) | PChar(_, _) => ()
          _ => return false
        }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

///|
/// Strict consumer check for stack-allocated pure-scalar enums:
/// returns true iff `name` is ONLY ever used as the scrutinee of `match name { ... }`
/// or `name is Pat` with safe scalar destructuring patterns (never returned, never
/// passed to any call/method, never stored in any container/struct, never captured).
fn qbe_ident_is_match_only_enum_expr(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | ETry(inner, _) => qbe_ident_is_match_only_enum_expr(inner, name)
    EMutArg(inner, _) =>
      if qbe_mut_place_root(inner) == name {
        false
      } else {
        qbe_ident_is_match_only_enum_expr(inner, name)
      }
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_ident_is_match_only_enum_expr(l, name) &&
      qbe_ident_is_match_only_enum_expr(r, name)
    ECall(callee, args, _) => {
      if !qbe_ident_is_match_only_enum_expr(callee, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_is_match_only_enum_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_ident_is_match_only_enum_expr(obj, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_is_match_only_enum_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_match_only_enum_expr(elems[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_ident_is_match_only_enum_expr(b, name) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_match_only_enum_expr(fields[i].value, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_ident_is_match_only_enum_stmts(stmts, 0, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_match_only_enum_expr(cond, name) ||
        !qbe_ident_is_match_only_enum_stmts(then_stmts, 0, name) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_match_only_enum_expr(el, name)
      }
    }
    EIs(scrut, pat, _) =>
      match scrut {
        EIdent(n, _) =>
          if n == name {
            qbe_pat_is_safe_enum_destructure(pat)
          } else {
            true
          }
        _ => qbe_ident_is_match_only_enum_expr(scrut, name)
      }
    EMatch(scrut, arms, _) => {
      let scrut_is_self = match scrut {
        EIdent(n, _) => n == name
        _ => false
      }
      if !scrut_is_self && !qbe_ident_is_match_only_enum_expr(scrut, name) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if scrut_is_self && !qbe_pat_is_safe_enum_destructure(arms[i].pat) {
          return false
        }
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_match_only_enum_expr(ge, name) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_match_only_enum_expr(arms[i].body, name) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | EInterp(_, _)
    | EDotVariant(_, _, _) => !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_match_only_enum_stmt(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_ident_is_match_only_enum_expr(init, name)
    SLetTuple(_, _, init, _) => qbe_ident_is_match_only_enum_expr(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_ident_is_match_only_enum_expr(lhs, name) &&
      qbe_ident_is_match_only_enum_expr(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_match_only_enum_expr(cond, name) &&
      qbe_ident_is_match_only_enum_stmts(body, 0, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_match_only_enum_stmt(init_s, name) &&
      qbe_ident_is_match_only_enum_expr(cond, name) &&
      qbe_ident_is_match_only_enum_stmt(step_s, name) &&
      qbe_ident_is_match_only_enum_stmts(body, 0, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_match_only_enum_expr(start_e, name) &&
      qbe_ident_is_match_only_enum_expr(end_e, name) &&
      (vname == name || qbe_ident_is_match_only_enum_stmts(body, 0, name))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_match_only_enum_expr(iter_e, name) &&
      (vname == name || qbe_ident_is_match_only_enum_stmts(body, 0, name))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_ident_is_match_only_enum_expr(e, name)
      }
    SExpr(e, _) => qbe_ident_is_match_only_enum_expr(e, name)
    SDebugAssert(cond, msg, _) =>
      qbe_ident_is_match_only_enum_expr(cond, name) &&
      qbe_ident_is_match_only_enum_expr(msg, name)
    SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_ident_is_match_only_enum_stmts(
  stmts : Array[Stmt],
  start : Int,
  name : String,
) -> Bool {
  let mut i = start
  while i < stmts.length() {
    if !qbe_ident_is_match_only_enum_stmt(stmts[i], name) {
      return false
    }
    match stmts[i] {
      SLet(bname, _, _, _, _) => if bname == name { return true }
      SLetTuple(bnames, _, _, _) => {
        let mut bi = 0
        while bi < bnames.length() {
          if bnames[bi] == name {
            return true
          }
          bi = bi + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_opt_res_pod_info(
  g : QbeGen,
  ret_ty : Ty,
  allow_pod_ok : Bool,
) -> Option[QbeOptResPodKind] {
  if !allow_pod_ok {
    return None
  }
  let ok_ty = match ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return None
  }
  let sub_ok = subst_ty(ok_ty, g.cur_type_subst)
  match qbe_pure_scalar_pod_struct_info(g, ok_ty) {
    Some(sinfo) => Some(PodStruct(sinfo, sub_ok, sinfo.field_names.length()))
    None =>
      match qbe_pure_scalar_pod_enum_info(g, ok_ty) {
        Some((einfo, nslots)) => Some(PodEnum(einfo, sub_ok, nslots))
        None => None
      }
  }
}

///|
fn qbe_ty_is_scalarizable_opt_res(
  g : QbeGen,
  raw_ty : Ty,
  want_kind : Int,
  allow_pod_ok : Bool,
) -> Option[Ty] {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TOption(inner) =>
      if (want_kind == 0 || want_kind == 1) &&
        !qbe_ty_is_unresolved_scalar(inner) {
        if !qbe_is_niche_opt_inner(g, inner) {
          Some(ty)
        } else if allow_pod_ok {
          match qbe_pure_scalar_pod_struct_info(g, inner) {
            Some(_) => Some(ty)
            None =>
              match qbe_pure_scalar_pod_enum_info(g, inner) {
                Some(_) => Some(ty)
                None => None
              }
          }
        } else {
          None
        }
      } else {
        None
      }
    TResult(ok_ty, err_ty) =>
      if (want_kind == 0 || want_kind == 2) &&
        !qbe_ty_is_unresolved_scalar(ok_ty) &&
        !qbe_ty_is_unresolved_scalar(err_ty) {
        Some(ty)
      } else {
        None
      }
    _ => None
  }
}

///|
fn qbe_fn_body_can_scalar_opt_res(
  g : QbeGen,
  target_pkg : String,
  stack_key : String,
  inl_body : Array[Stmt],
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  let saved_mono = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  g.inline_depth = g.inline_depth + 1
  g.inline_stack.push(stack_key)
  let ok = qbe_fn_body_all_returns_are_opt_res_ctors(
    g,
    inl_body,
    ret_ty,
    val_is_pod_buf,
  )
  let _ = g.inline_stack.pop()
  g.inline_depth = g.inline_depth - 1
  g.mono_pkg = saved_mono
  ok
}

///|
fn qbe_tail_call_can_scalar_opt_res(
  g : QbeGen,
  e : Expr,
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  if !g.release || g.inline_depth >= 3 {
    return false
  }
  let want_ret_str = ty_to_string(subst_ty(ret_ty, g.cur_type_subst))
  match e {
    ECall(EIdent(name, _), _, _) => {
      match qbe_lookup_local(g, name) {
        Some(_) => return false
        None => ()
      }
      let target_pkg = g.mono_pkg
      let finfo_opt : Option[FnInfo] = if target_pkg == "" {
        g.tc.fns.get(name)
      } else {
        match g.tc.imported_pkgs.get(target_pkg) {
          Some(ipkg) =>
            match ipkg.tc.fns.get(name) {
              Some(fi) => Some(qualify_fn_info(ipkg, fi))
              None => None
            }
          None => None
        }
      }
      match finfo_opt {
        Some(finfo) => {
          if ty_to_string(subst_ty(finfo.ret_ty, g.cur_type_subst)) != want_ret_str {
            return false
          }
          let inl_fd_opt = if target_pkg == "" {
            qbe_local_fn_can_scalar_inline(g, name, finfo)
          } else {
            qbe_xpkg_fn_can_scalar_inline(g, target_pkg, name, finfo)
          }
          match inl_fd_opt {
            Some(inl_fd) => {
              let stack_key = if target_pkg != "" {
                target_pkg + "::" + name
              } else {
                name
              }
              qbe_fn_body_can_scalar_opt_res(
                g,
                target_pkg,
                stack_key,
                qbe_fn_body(g, inl_fd.body),
                ret_ty,
                val_is_pod_buf,
              )
            }
            None => false
          }
        }
        None => false
      }
    }
    ECall(EPath(qual, mem, _), _, _) => {
      let mut target_finfo : Option[FnInfo] = None
      let mut target_pkg = ""
      let mut key = qual + "::" + mem
      if has_qual_sep(qual) {
        let qp = split_qual_name(qual)
        match qbe_resolve_pkg_in_scope(g, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.methods.get(qp.name + "::" + mem) {
              Some(mi) => {
                target_finfo = Some(qualify_fn_info(ipkg, mi))
                target_pkg = ipkg.name
                key = qp.name + "::" + mem
              }
              None => ()
            }
          None => ()
        }
      }
      match target_finfo {
        None =>
          match qbe_resolve_pkg_in_scope(g, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(fi) => {
                  target_finfo = Some(qualify_fn_info(ipkg, fi))
                  target_pkg = ipkg.name
                  key = mem
                }
                None => ()
              }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(qual + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_pkg = ipkg.name
                  }
                  None => ()
                }
              None => ()
            }
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          match qbe_lookup_method_info(g, qual, mem) {
            Some(minfo) => {
              target_finfo = Some(minfo)
              let qpm = split_qual_name(qual)
              if qpm.prefix != "" {
                target_pkg = qpm.prefix
              } else if g.mono_pkg != "" {
                target_pkg = g.mono_pkg
              }
            }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        Some(minfo) => {
          if ty_to_string(subst_ty(minfo.ret_ty, g.cur_type_subst)) != want_ret_str {
            return false
          }
          let inl_fd_opt = if target_pkg == "" &&
            g.mono_pkg == "" &&
            !has_qual_sep(qual) {
            qbe_local_fn_can_scalar_inline(g, key, minfo)
          } else if target_pkg != "" {
            qbe_xpkg_fn_can_scalar_inline(g, target_pkg, key, minfo)
          } else {
            None
          }
          match inl_fd_opt {
            Some(inl_fd) => {
              let stack_key = if target_pkg != "" {
                target_pkg + "::" + key
              } else {
                key
              }
              qbe_fn_body_can_scalar_opt_res(
                g,
                target_pkg,
                stack_key,
                qbe_fn_body(g, inl_fd.body),
                ret_ty,
                val_is_pod_buf,
              )
            }
            None => false
          }
        }
        None => false
      }
    }
    EMethodCall(recv, method_name, _, _) => {
      let sname_opt : Option[String] = match qbe_probe_expr_ty(g, recv) {
        Some(TStruct(sn, _)) => Some(sn)
        _ =>
          match recv {
            EIdent("self", _) =>
              match ret_ty {
                TOption(TStruct(sn, _)) | TResult(TStruct(sn, _), _) => Some(sn)
                _ => None
              }
            _ => None
          }
      }
      match sname_opt {
        Some(sname) =>
          match qbe_lookup_method_info(g, sname, method_name) {
            Some(minfo) => {
              if ty_to_string(subst_ty(minfo.ret_ty, g.cur_type_subst)) != want_ret_str {
                return false
              }
              let qp_m = split_qual_name(sname)
              let mpkg = if qp_m.prefix != "" { qp_m.prefix } else { g.mono_pkg }
              let key = sname + "::" + method_name
              let inl_fd_opt = if mpkg == "" && !has_qual_sep(sname) {
                qbe_local_fn_can_scalar_inline(g, key, minfo)
              } else if mpkg != "" {
                qbe_xpkg_fn_can_scalar_inline(g, mpkg, key, minfo)
              } else {
                None
              }
              match inl_fd_opt {
                Some(inl_fd) => {
                  let stack_key = if mpkg != "" { mpkg + "::" + key } else { key }
                  qbe_fn_body_can_scalar_opt_res(
                    g,
                    mpkg,
                    stack_key,
                    qbe_fn_body(g, inl_fd.body),
                    ret_ty,
                    val_is_pod_buf,
                  )
                }
                None => false
              }
            }
            None => false
          }
        None => false
      }
    }
    _ => false
  }
}

///|
fn qbe_expr_all_tails_are_opt_res_ctors(
  g : QbeGen,
  e : Expr,
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  match e {
    EBlock(bs, _) => qbe_stmts_all_tails_are_opt_res_ctors(g, bs, ret_ty, val_is_pod_buf)
    EIf(_, then_s, Some(else_e), _) =>
      qbe_stmts_all_tails_are_opt_res_ctors(g, then_s, ret_ty, val_is_pod_buf) &&
      qbe_expr_all_tails_are_opt_res_ctors(g, else_e, ret_ty, val_is_pod_buf)
    EMatch(_, arms, _) => {
      if arms.length() == 0 {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(_) => return false
          None => ()
        }
        if !qbe_expr_all_tails_are_opt_res_ctors(g, arms[i].body, ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ =>
      match ret_ty {
        TOption(_) =>
          match e {
            EIdent("None", _) | EPath("Option", "None", _) => true
            ECall(EIdent("Some", _), args, _) | ECall(EPath("Option", "Some", _), args, _) =>
              args.length() == 1
            _ => qbe_tail_call_can_scalar_opt_res(g, e, ret_ty, val_is_pod_buf)
          }
        TResult(_, _) =>
          match e {
            ECall(EIdent("Ok", _), args, _) | ECall(EPath("Result", "Ok", _), args, _) =>
              args.length() == 1
            ECall(EIdent("Err", _), args, _) | ECall(EPath("Result", "Err", _), args, _) =>
              args.length() == 1
            _ => qbe_tail_call_can_scalar_opt_res(g, e, ret_ty, val_is_pod_buf)
          }
        _ => false
      }
  }
}

///|
fn qbe_stmts_all_tails_are_opt_res_ctors(
  g : QbeGen,
  stmts : Array[Stmt],
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  if stmts.length() == 0 {
    return false
  }
  if qbe_stmts_has_cf(stmts, false, false, true) {
    return false
  }
  match stmts[stmts.length() - 1] {
    SExpr(tail_e, _) => qbe_expr_all_tails_are_opt_res_ctors(g, tail_e, ret_ty, val_is_pod_buf)
    _ => false
  }
}

///|
fn qbe_expr_returns_are_opt_res_ctors(
  g : QbeGen,
  e : Expr,
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  match e {
    ETry(inner, _) => qbe_expr_returns_are_opt_res_ctors(g, inner, ret_ty, val_is_pod_buf)
    EClosure(_, _, _, _) => true
    EBlock(bs, _) => qbe_stmts_returns_are_opt_res_ctors(g, bs, ret_ty, val_is_pod_buf)
    EIf(cond, then_s, else_opt, _) => {
      if !qbe_expr_returns_are_opt_res_ctors(g, cond, ret_ty, val_is_pod_buf) ||
        !qbe_stmts_returns_are_opt_res_ctors(g, then_s, ret_ty, val_is_pod_buf) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_expr_returns_are_opt_res_ctors(g, el, ret_ty, val_is_pod_buf)
      }
    }
    EMatch(s, arms, _) => {
      if !qbe_expr_returns_are_opt_res_ctors(g, s, ret_ty, val_is_pod_buf) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_expr_returns_are_opt_res_ctors(g, ge, ret_ty, val_is_pod_buf) {
              return false
            }
          None => ()
        }
        if !qbe_expr_returns_are_opt_res_ctors(g, arms[i].body, ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    EUnary(_, inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | EMove(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_returns_are_opt_res_ctors(g, inner, ret_ty, val_is_pod_buf)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_returns_are_opt_res_ctors(g, l, ret_ty, val_is_pod_buf) &&
      qbe_expr_returns_are_opt_res_ctors(g, r, ret_ty, val_is_pod_buf)
    ECall(callee, args, _) => {
      if !qbe_expr_returns_are_opt_res_ctors(g, callee, ret_ty, val_is_pod_buf) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_returns_are_opt_res_ctors(g, args[i], ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(recv, _, args, _) => {
      if !qbe_expr_returns_are_opt_res_ctors(g, recv, ret_ty, val_is_pod_buf) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_returns_are_opt_res_ctors(g, args[i], ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_expr_returns_are_opt_res_ctors(g, elems[i], ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(sp_e) =>
          if !qbe_expr_returns_are_opt_res_ctors(g, sp_e, ret_ty, val_is_pod_buf) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_expr_returns_are_opt_res_ctors(g, fields[i].value, ret_ty, val_is_pod_buf) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => true
  }
}

///|
fn qbe_stmts_returns_are_opt_res_ctors(
  g : QbeGen,
  stmts : Array[Stmt],
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SReturn(None, _) => return false
      SReturn(Some(e), _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, e, ret_ty, val_is_pod_buf) ||
          !qbe_expr_all_tails_are_opt_res_ctors(g, e, ret_ty, val_is_pod_buf) {
          return false
        }
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, init, ret_ty, val_is_pod_buf) {
          return false
        }
      SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, l, ret_ty, val_is_pod_buf) ||
          !qbe_expr_returns_are_opt_res_ctors(g, r, ret_ty, val_is_pod_buf) {
          return false
        }
      SGuard(c, b, _) | SWhile(c, b, _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, c, ret_ty, val_is_pod_buf) ||
          !qbe_stmts_returns_are_opt_res_ctors(g, b, ret_ty, val_is_pod_buf) {
          return false
        }
      SFor(init_s, cond, step_s, b, _) =>
        if !qbe_stmts_returns_are_opt_res_ctors(g, [init_s], ret_ty, val_is_pod_buf) ||
          !qbe_expr_returns_are_opt_res_ctors(g, cond, ret_ty, val_is_pod_buf) ||
          !qbe_stmts_returns_are_opt_res_ctors(g, [step_s], ret_ty, val_is_pod_buf) ||
          !qbe_stmts_returns_are_opt_res_ctors(g, b, ret_ty, val_is_pod_buf) {
          return false
        }
      SForRange(_, s, e, _, b, _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, s, ret_ty, val_is_pod_buf) ||
          !qbe_expr_returns_are_opt_res_ctors(g, e, ret_ty, val_is_pod_buf) ||
          !qbe_stmts_returns_are_opt_res_ctors(g, b, ret_ty, val_is_pod_buf) {
          return false
        }
      SForIn(_, _, iter, b, _) =>
        if !qbe_expr_returns_are_opt_res_ctors(g, iter, ret_ty, val_is_pod_buf) ||
          !qbe_stmts_returns_are_opt_res_ctors(g, b, ret_ty, val_is_pod_buf) {
          return false
        }
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  true
}

///|
/// Verify an inlined function/method body produces every exit (both early `return`
/// and final tail expression) via explicit `Some`/`None`/`Ok`/`Err` constructors.
fn qbe_fn_body_all_returns_are_opt_res_ctors(
  g : QbeGen,
  stmts : Array[Stmt],
  ret_ty : Ty,
  val_is_pod_buf : Bool,
) -> Bool {
  if stmts.length() == 0 {
    return false
  }
  if !qbe_stmts_returns_are_opt_res_ctors(g, stmts, ret_ty, val_is_pod_buf) {
    return false
  }
  match stmts[stmts.length() - 1] {
    SReturn(Some(_), _) => true
    SExpr(tail_e, _) => qbe_expr_all_tails_are_opt_res_ctors(g, tail_e, ret_ty, val_is_pod_buf)
    _ => false
  }
}

///|
fn qbe_match_2arm_opt_res(
  arms : Array[MatchArm],
) -> Option[(Int, Int, Int, String, String)] {
  if arms.length() != 2 {
    return None
  }
  match (arms[0].guard_expr, arms[1].guard_expr) {
    (None, None) => ()
    _ => return None
  }
  let mut want_kind = 0
  let mut ok_idx = -1
  let mut err_idx = -1
  let mut ok_bind = ""
  let mut err_bind = ""
  match (arms[0].pat, arms[1].pat) {
    (PVariant(_, "Some", s0, _, _), PVariant(_, "None", s1, _, _)) =>
      if s0.length() == 1 && s1.length() == 0 {
        match s0[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          PWild(_) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
          }
          _ => ()
        }
      }
    (PVariant(_, "Some", s0, _, _), PWild(_)) =>
      if s0.length() == 1 {
        match s0[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
            ok_bind = b
          }
          PWild(_) => {
            want_kind = 1
            ok_idx = 0
            err_idx = 1
          }
          _ => ()
        }
      }
    (PVariant(_, "None", s0, _, _), PVariant(_, "Some", s1, _, _)) =>
      if s0.length() == 0 && s1.length() == 1 {
        match s1[0] {
          PIdent(b, _) => {
            want_kind = 1
            ok_idx = 1
            err_idx = 0
            ok_bind = b
          }
          PWild(_) => {
            want_kind = 1
            ok_idx = 1
            err_idx = 0
          }
          _ => ()
        }
      }
    (PVariant(_, "None", s0, _, _), PWild(_)) =>
      if s0.length() == 0 {
        want_kind = 1
        ok_idx = 1
        err_idx = 0
      }
    (PVariant(_, "Ok", s0, _, _), PVariant(_, "Err", s1, _, _)) =>
      if s0.length() == 1 && s1.length() == 1 {
        match (s0[0], s1[0]) {
          (PIdent(ob, _), PIdent(eb, _)) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            ok_bind = ob
            err_bind = eb
          }
          (PIdent(ob, _), PWild(_)) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            ok_bind = ob
          }
          (PWild(_), PIdent(eb, _)) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            err_bind = eb
          }
          (PWild(_), PWild(_)) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
          }
          _ => ()
        }
      }
    (PVariant(_, "Err", s0, _, _), PVariant(_, "Ok", s1, _, _)) =>
      if s0.length() == 1 && s1.length() == 1 {
        match (s0[0], s1[0]) {
          (PIdent(eb, _), PIdent(ob, _)) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
            ok_bind = ob
            err_bind = eb
          }
          (PIdent(eb, _), PWild(_)) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
            err_bind = eb
          }
          (PWild(_), PIdent(ob, _)) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
            ok_bind = ob
          }
          (PWild(_), PWild(_)) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
          }
          _ => ()
        }
      }
    (PVariant(_, "Ok", s0, _, _), PWild(_)) =>
      if s0.length() == 1 {
        match s0[0] {
          PIdent(ob, _) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
            ok_bind = ob
          }
          PWild(_) => {
            want_kind = 2
            ok_idx = 0
            err_idx = 1
          }
          _ => ()
        }
      }
    (PVariant(_, "Err", s0, _, _), PWild(_)) =>
      if s0.length() == 1 {
        match s0[0] {
          PIdent(eb, _) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
            err_bind = eb
          }
          PWild(_) => {
            want_kind = 2
            ok_idx = 1
            err_idx = 0
          }
          _ => ()
        }
      }
    _ => ()
  }
  if want_kind == 0 {
    None
  } else {
    Some((want_kind, ok_idx, err_idx, ok_bind, err_bind))
  }
}

///|
fn qbe_emit_copy_pod_slots(
  g : QbeGen,
  src_p : String,
  dst_p : String,
  nfields : Int,
) -> Unit {
  let mut fi = 0
  while fi < nfields {
    let off = fi * 8
    let sp_i = if off == 0 {
      src_p
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + src_p + ", " + off.to_string())
      t
    }
    let dp_i = if off == 0 {
      dst_p
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + dst_p + ", " + off.to_string())
      t
    }
    let fv = qbe_tmp(g)
    qbe_emit(g, fv + " =l loadl " + sp_i)
    qbe_emit(g, "storel " + fv + ", " + dp_i)
    fi = fi + 1
  }
}

///|
fn qbe_emit_tail_opt_res_forward_call(
  g : QbeGen,
  e : Expr,
  ret_ty : Ty,
  want_kind : Int,
  tag_slot : String,
  val_slot : String,
  err_slot : String,
  val_is_pod_buf : Bool,
) -> Unit {
  match qbe_try_emit_opt_res_scalarized(g, e, want_kind, val_is_pod_buf) {
    Some(inner) => {
      if g.block_term {
        return
      }
      let tw = qbe_tmp(g)
      qbe_emit(g, tw + " =w loadw " + inner.tag_slot)
      qbe_emit(g, "storew " + tw + ", " + tag_slot)
      let l_ok = qbe_lbl(g, "scf_ok")
      let l_err = qbe_lbl(g, "scf_err")
      let l_end = qbe_lbl(g, "scf_end")
      qbe_emit_term(g, "jnz " + tw + ", " + l_ok + ", " + l_err)
      qbe_emit_lbl(g, l_ok)
      g.block_immut_fields = Map([])
      let ok_ty = match ret_ty {
        TOption(it) => it
        TResult(ot, _) => ot
        _ => TUnit
      }
      if val_is_pod_buf {
        match qbe_opt_res_pod_info(g, ret_ty, true) {
          Some(PodStruct(_, _, nslots)) =>
            if inner.val_is_pod_buf {
              qbe_emit_copy_pod_slots(g, inner.val_slot, val_slot, nslots)
            } else {
              let src_p = qbe_tmp(g)
              qbe_emit(g, src_p + " =l loadl " + inner.val_slot)
              qbe_emit_copy_pod_slots(g, src_p, val_slot, nslots)
              qbe_rc_dec(g, src_p, ok_ty)
            }
          Some(PodEnum(einfo, _, nslots)) =>
            if inner.val_is_pod_buf {
              if qbe_enum_layout_for_info(einfo).is_niche {
                let pslot = qbe_tmp(g)
                let src_p = qbe_tmp(g)
                qbe_emit(g, pslot + " =l sub " + inner.val_slot + ", 32")
                qbe_emit(g, src_p + " =l loadl " + pslot)
                qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
              } else {
                qbe_emit_copy_pod_slots(g, inner.val_slot, val_slot, nslots)
              }
            } else {
              let src_p = qbe_tmp(g)
              qbe_emit(g, src_p + " =l loadl " + inner.val_slot)
              qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
              qbe_rc_dec(g, src_p, ok_ty)
            }
          None => ()
        }
      } else {
        let v_ok = qbe_load_heap_slot(g, inner.val_slot, ok_ty)
        qbe_store_heap_slot(g, v_ok, val_slot, ok_ty)
      }
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_err)
      g.block_immut_fields = Map([])
      match ret_ty {
        TResult(_, err_ty) => {
          let v_err = qbe_load_heap_slot(g, inner.err_slot, err_ty)
          qbe_store_heap_slot(g, v_err, err_slot, err_ty)
        }
        _ => ()
      }
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      g.block_immut_fields = Map([])
    }
    None => {
      let rv = qbe_emit_expr(g, e, Some(ret_ty))
      if g.block_term {
        return
      }
      let rv_reg = qbe_coerce_val(g, rv, ret_ty)
      match ret_ty {
        TOption(raw_inner) => {
          let inner_ty = subst_ty(raw_inner, g.cur_type_subst)
          let l_ok = qbe_lbl(g, "scfb_ok")
          let l_end = qbe_lbl(g, "scfb_end")
          if qbe_is_niche_opt_inner(g, inner_ty) {
            let c_ok = qbe_tmp(g)
            qbe_emit(g, c_ok + " =w cnel " + rv_reg + ", 0")
            qbe_emit(g, "storew " + c_ok + ", " + tag_slot)
            qbe_emit_term(g, "jnz " + c_ok + ", " + l_ok + ", " + l_end)
            qbe_emit_lbl(g, l_ok)
            g.block_immut_fields = Map([])
            if val_is_pod_buf {
              match qbe_opt_res_pod_info(g, ret_ty, true) {
                Some(PodStruct(_, _, nslots)) => {
                  qbe_emit_copy_pod_slots(g, rv_reg, val_slot, nslots)
                  qbe_rc_dec(g, rv_reg, inner_ty)
                }
                Some(PodEnum(einfo, _, _)) => {
                  qbe_emit_copy_pod_enum_slots(g, rv_reg, val_slot, einfo)
                  qbe_rc_dec(g, rv_reg, inner_ty)
                }
                None => qbe_rc_dec(g, rv_reg, inner_ty)
              }
            } else {
              qbe_store_heap_slot(g, rv_reg, val_slot, inner_ty)
            }
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_end)
            g.block_immut_fields = Map([])
          } else {
            let tag_l = qbe_tmp(g)
            let c_ok = qbe_tmp(g)
            qbe_emit(g, tag_l + " =l loadl " + rv_reg)
            qbe_emit(g, c_ok + " =w cnel " + tag_l + ", 0")
            qbe_emit(g, "storew " + c_ok + ", " + tag_slot)
            qbe_emit_term(g, "jnz " + c_ok + ", " + l_ok + ", " + l_end)
            qbe_emit_lbl(g, l_ok)
            g.block_immut_fields = Map([])
            let vp = qbe_tmp(g)
            qbe_emit(g, vp + " =l add " + rv_reg + ", 8")
            if val_is_pod_buf {
              match qbe_opt_res_pod_info(g, ret_ty, true) {
                Some(PodStruct(_, _, nslots)) => {
                  let src_p = qbe_tmp(g)
                  qbe_emit(g, src_p + " =l loadl " + vp)
                  qbe_emit_copy_pod_slots(g, src_p, val_slot, nslots)
                }
                Some(PodEnum(einfo, _, _)) => {
                  let src_p = qbe_tmp(g)
                  qbe_emit(g, src_p + " =l loadl " + vp)
                  qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
                }
                None => ()
              }
            } else {
              let v_ok = qbe_load_heap_slot(g, vp, inner_ty)
              qbe_rc_inc(g, v_ok, inner_ty)
              qbe_store_heap_slot(g, v_ok, val_slot, inner_ty)
            }
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_end)
            g.block_immut_fields = Map([])
            qbe_rc_dec(g, rv_reg, ret_ty)
          }
        }
        TResult(raw_ok, raw_err) => {
          let ok_ty = subst_ty(raw_ok, g.cur_type_subst)
          let err_ty = subst_ty(raw_err, g.cur_type_subst)
          let tag_l = qbe_tmp(g)
          let c_ok = qbe_tmp(g)
          let l_ok = qbe_lbl(g, "scfb_ok")
          let l_err = qbe_lbl(g, "scfb_err")
          let l_end = qbe_lbl(g, "scfb_end")
          qbe_emit(g, tag_l + " =l loadl " + rv_reg)
          qbe_emit(g, c_ok + " =w ceql " + tag_l + ", 0")
          qbe_emit(g, "storew " + c_ok + ", " + tag_slot)
          qbe_emit_term(g, "jnz " + c_ok + ", " + l_ok + ", " + l_err)
          qbe_emit_lbl(g, l_ok)
          g.block_immut_fields = Map([])
          let vp = qbe_tmp(g)
          qbe_emit(g, vp + " =l add " + rv_reg + ", 8")
          if val_is_pod_buf {
            match qbe_opt_res_pod_info(g, ret_ty, true) {
              Some(PodStruct(_, _, nslots)) => {
                let src_p = qbe_tmp(g)
                qbe_emit(g, src_p + " =l loadl " + vp)
                qbe_emit_copy_pod_slots(g, src_p, val_slot, nslots)
              }
              Some(PodEnum(einfo, _, _)) => {
                let src_p = qbe_tmp(g)
                qbe_emit(g, src_p + " =l loadl " + vp)
                qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
              }
              None => ()
            }
          } else {
            let v_ok = qbe_load_heap_slot(g, vp, ok_ty)
            qbe_rc_inc(g, v_ok, ok_ty)
            qbe_store_heap_slot(g, v_ok, val_slot, ok_ty)
          }
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_err)
          g.block_immut_fields = Map([])
          let ep = qbe_tmp(g)
          qbe_emit(g, ep + " =l add " + rv_reg + ", 8")
          let v_err = qbe_load_heap_slot(g, ep, err_ty)
          qbe_rc_inc(g, v_err, err_ty)
          qbe_store_heap_slot(g, v_err, err_slot, err_ty)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
          g.block_immut_fields = Map([])
          qbe_rc_dec(g, rv_reg, ret_ty)
        }
        _ => ()
      }
    }
  }
}

///|
fn qbe_emit_tail_opt_res_expr_into_slots(
  g : QbeGen,
  e : Expr,
  ret_ty : Ty,
  tag_slot : String,
  val_slot : String,
  err_slot : String,
  val_is_pod_buf : Bool,
) -> Unit {
  if g.block_term {
    return
  }
  match e {
    EBlock(bs, _) => {
      qbe_scope_push(g)
      qbe_emit_tail_opt_res_stmts_into_slots(
        g,
        bs,
        ret_ty,
        tag_slot,
        val_slot,
        err_slot,
        val_is_pod_buf,
      )
      qbe_scope_pop(g)
    }
    EIf(cond, then_s, Some(else_e), _) => {
      let l_then = qbe_lbl(g, "sc_then")
      let l_else = qbe_lbl(g, "sc_else")
      let l_end = qbe_lbl(g, "sc_end")
      if qbe_expr_has_is(cond) {
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_then, l_else, Some(then_s))
        qbe_emit_lbl(g, l_then)
      } else {
        qbe_emit_cond_branch(g, cond, l_then, l_else)
        qbe_emit_lbl(g, l_then)
        qbe_scope_push(g)
      }
      g.block_immut_fields = Map([])
      qbe_emit_tail_opt_res_stmts_into_slots(
        g,
        then_s,
        ret_ty,
        tag_slot,
        val_slot,
        err_slot,
        val_is_pod_buf,
      )
      qbe_scope_pop(g)
      let then_term = g.block_term
      if !then_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      qbe_emit_lbl(g, l_else)
      g.block_immut_fields = Map([])
      qbe_scope_push(g)
      qbe_emit_tail_opt_res_expr_into_slots(
        g,
        else_e,
        ret_ty,
        tag_slot,
        val_slot,
        err_slot,
        val_is_pod_buf,
      )
      qbe_scope_pop(g)
      let else_term = g.block_term
      if !else_term {
        qbe_emit_term(g, "jmp " + l_end)
      }
      if then_term && else_term {
        g.block_term = true
      } else {
        qbe_emit_lbl(g, l_end)
        g.block_immut_fields = Map([])
      }
    }
    EMatch(scrut, arms, sp) => {
      match qbe_match_2arm_opt_res(arms) {
        Some((want_kind, ok_idx, err_idx, ok_bind, err_bind)) => {
          let allow_pod_ok = ok_bind == "" ||
            qbe_ident_is_flat_field_only_expr(arms[ok_idx].body, ok_bind) ||
            qbe_ident_is_match_only_enum_expr(arms[ok_idx].body, ok_bind)
          match qbe_try_emit_opt_res_scalarized(g, scrut, want_kind, allow_pod_ok) {
            Some(sc) => {
              if g.block_term {
                return
              }
              let ok_ty = match sc.ret_ty {
                TOption(inner) => inner
                TResult(ot, _) => ot
                _ => TUnit
              }
              let err_ty_opt : Option[Ty] = match sc.ret_ty {
                TResult(_, et) => Some(et)
                _ => None
              }
              let tag_w = qbe_tmp(g)
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              let l_ok = qbe_lbl(g, "scnm_ok")
              let l_err = qbe_lbl(g, "scnm_err")
              let l_end = qbe_lbl(g, "scnm_end")
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
              qbe_emit_lbl(g, l_ok)
              g.block_immut_fields = Map([])
              qbe_scope_push(g)
              if sc.val_is_pod_buf {
                if ok_bind != "" {
                  let vloc = qbe_define_local(g, ok_bind, ok_ty, false)
                  let pv = qbe_pod_buf_val(g, sc.val_slot, ok_ty)
                  qbe_emit(g, "storel " + pv + ", " + vloc.slot)
                }
              } else {
                let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
                if ok_bind != "" {
                  let vloc = qbe_define_local(g, ok_bind, ok_ty, true)
                  qbe_store_local_slot(g, v_ok, vloc.slot, ok_ty)
                } else {
                  qbe_rc_dec(g, v_ok, ok_ty)
                }
              }
              let ok_dp_pinned : Array[String] = []
              qbe_pin_top_scope_for_arm(g, None, arms[ok_idx].body, ok_dp_pinned)
              qbe_emit_tail_opt_res_expr_into_slots(
                g,
                arms[ok_idx].body,
                ret_ty,
                tag_slot,
                val_slot,
                err_slot,
                val_is_pod_buf,
              )
              qbe_unpin_slot_list(g, ok_dp_pinned)
              qbe_scope_pop(g)
              let ok_term = g.block_term
              if !ok_term {
                qbe_emit_term(g, "jmp " + l_end)
              }
              qbe_emit_lbl(g, l_err)
              g.block_immut_fields = Map([])
              qbe_scope_push(g)
              match err_ty_opt {
                Some(err_ty) => {
                  let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                  if err_bind != "" {
                    let eloc = qbe_define_local(g, err_bind, err_ty, true)
                    qbe_store_local_slot(g, v_err, eloc.slot, err_ty)
                  } else {
                    qbe_rc_dec(g, v_err, err_ty)
                  }
                }
                None => ()
              }
              let err_dp_pinned : Array[String] = []
              qbe_pin_top_scope_for_arm(g, None, arms[err_idx].body, err_dp_pinned)
              qbe_emit_tail_opt_res_expr_into_slots(
                g,
                arms[err_idx].body,
                ret_ty,
                tag_slot,
                val_slot,
                err_slot,
                val_is_pod_buf,
              )
              qbe_unpin_slot_list(g, err_dp_pinned)
              qbe_scope_pop(g)
              let err_term = g.block_term
              if !err_term {
                qbe_emit_term(g, "jmp " + l_end)
              }
              if ok_term && err_term {
                g.block_term = true
              } else {
                qbe_emit_lbl(g, l_end)
                g.block_immut_fields = Map([])
              }
              return
            }
            None => ()
          }
        }
        None => ()
      }
      qbe_scope_push(g)
      let sv = qbe_emit_expr(g, scrut, None)
      if g.block_term {
        let _ = g.scopes.pop()
        return
      }
      let scrut_loc = qbe_define_local(g, "__sc_match_scrut", sv.ty, true)
      qbe_store_local_slot(g, sv.reg, scrut_loc.slot, sv.ty)
      let l_end = qbe_lbl(g, "sc_mend")
      let mut all_term = true
      let mut i = 0
      while i < arms.length() {
        let arm = arms[i]
        let l_next = qbe_lbl(g, "sc_mnext")
        let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
        qbe_emit_pat_test(g, arm.pat, cur_sv, sv.ty, l_next)
        qbe_scope_push(g)
        let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
        qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, false, arm.body)
        let sc_arm_dp_pinned : Array[String] = []
        qbe_pin_top_scope_for_arm(g, None, arm.body, sc_arm_dp_pinned)
        qbe_emit_tail_opt_res_expr_into_slots(
          g,
          arm.body,
          ret_ty,
          tag_slot,
          val_slot,
          err_slot,
          val_is_pod_buf,
        )
        qbe_unpin_slot_list(g, sc_arm_dp_pinned)
        qbe_scope_pop(g)
        if !g.block_term {
          all_term = false
          qbe_emit_term(g, "jmp " + l_end)
        }
        qbe_emit_lbl(g, l_next)
        i = i + 1
      }
      let file_id = qbe_intern_source_path(g, sp.file)
      let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
      qbe_emit(
        g,
        "call $pion_panic(l $pion_cstr_" +
        msg_id.to_string() +
        ", l $pion_cstr_" +
        file_id.to_string() +
        ", w " +
        sp.line.to_string() +
        ")",
      )
      qbe_emit_term(g, "hlt")
      if all_term {
        let _ = g.scopes.pop()
        g.block_term = true
      } else {
        qbe_emit_lbl(g, l_end)
        g.block_immut_fields = Map([])
        qbe_scope_pop(g)
      }
    }
    _ =>
      match ret_ty {
        TOption(inner_ty) =>
          match e {
            EIdent("None", _) | EPath("Option", "None", _) =>
              qbe_emit(g, "storew 0, " + tag_slot)
            ECall(EIdent("Some", _), args, _) | ECall(EPath("Option", "Some", _), args, _) =>
              if val_is_pod_buf {
                match qbe_opt_res_pod_info(g, ret_ty, true) {
                  Some(PodStruct(sinfo, sub_ty, nslots)) => {
                    if qbe_expr_all_tails_are_pod_struct_lits(args[0]) {
                      qbe_emit_tail_pod_struct_into_buf(g, args[0], sinfo, sub_ty, val_slot)
                    } else {
                      let aa = qbe_emit_arg_maybe_borrow(
                        g,
                        args[0],
                        Some(inner_ty),
                        !qbe_expr_has_assign(args[0]),
                      )
                      if !g.block_term {
                        let src_p = qbe_as_l(g, aa.qv)
                        qbe_emit_copy_pod_slots(g, src_p, val_slot, nslots)
                        if !aa.borrowed {
                          qbe_rc_dec(g, aa.qv.reg, aa.qv.ty)
                        }
                      }
                    }
                    if !g.block_term {
                      qbe_emit(g, "storew 1, " + tag_slot)
                    }
                  }
                  Some(PodEnum(einfo, sub_ty, _)) => {
                    if qbe_expr_all_tails_are_pod_enum_ctors(g, args[0], einfo, sub_ty) {
                      qbe_emit_tail_pod_enum_into_buf(g, args[0], einfo, sub_ty, val_slot)
                    } else {
                      let aa = qbe_emit_arg_maybe_borrow(
                        g,
                        args[0],
                        Some(inner_ty),
                        !qbe_expr_has_assign(args[0]),
                      )
                      if !g.block_term {
                        let src_p = qbe_as_l(g, aa.qv)
                        qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
                        if !aa.borrowed {
                          qbe_rc_dec(g, aa.qv.reg, aa.qv.ty)
                        }
                      }
                    }
                    if !g.block_term {
                      qbe_emit(g, "storew 1, " + tag_slot)
                    }
                  }
                  None => ()
                }
              } else {
                let pv = qbe_emit_expr(g, args[0], Some(inner_ty))
                if !g.block_term {
                  let pc = qbe_coerce_val(g, pv, inner_ty)
                  qbe_store_heap_slot(g, pc, val_slot, inner_ty)
                  qbe_emit(g, "storew 1, " + tag_slot)
                }
              }
            _ =>
              qbe_emit_tail_opt_res_forward_call(
                g,
                e,
                ret_ty,
                1,
                tag_slot,
                val_slot,
                err_slot,
                val_is_pod_buf,
              )
          }
        TResult(ok_ty, err_ty) =>
          match e {
            ECall(EIdent("Ok", _), args, _) | ECall(EPath("Result", "Ok", _), args, _) =>
              if val_is_pod_buf {
                match qbe_opt_res_pod_info(g, ret_ty, true) {
                  Some(PodStruct(sinfo, sub_ty, nslots)) => {
                    if qbe_expr_all_tails_are_pod_struct_lits(args[0]) {
                      qbe_emit_tail_pod_struct_into_buf(g, args[0], sinfo, sub_ty, val_slot)
                    } else {
                      let aa = qbe_emit_arg_maybe_borrow(
                        g,
                        args[0],
                        Some(ok_ty),
                        !qbe_expr_has_assign(args[0]),
                      )
                      if !g.block_term {
                        let src_p = qbe_as_l(g, aa.qv)
                        qbe_emit_copy_pod_slots(g, src_p, val_slot, nslots)
                        if !aa.borrowed {
                          qbe_rc_dec(g, aa.qv.reg, aa.qv.ty)
                        }
                      }
                    }
                    if !g.block_term {
                      qbe_emit(g, "storew 1, " + tag_slot)
                    }
                  }
                  Some(PodEnum(einfo, sub_ty, _)) => {
                    if qbe_expr_all_tails_are_pod_enum_ctors(g, args[0], einfo, sub_ty) {
                      qbe_emit_tail_pod_enum_into_buf(g, args[0], einfo, sub_ty, val_slot)
                    } else {
                      let aa = qbe_emit_arg_maybe_borrow(
                        g,
                        args[0],
                        Some(ok_ty),
                        !qbe_expr_has_assign(args[0]),
                      )
                      if !g.block_term {
                        let src_p = qbe_as_l(g, aa.qv)
                        qbe_emit_copy_pod_enum_slots(g, src_p, val_slot, einfo)
                        if !aa.borrowed {
                          qbe_rc_dec(g, aa.qv.reg, aa.qv.ty)
                        }
                      }
                    }
                    if !g.block_term {
                      qbe_emit(g, "storew 1, " + tag_slot)
                    }
                  }
                  None => ()
                }
              } else {
                let pv = qbe_emit_expr(g, args[0], Some(ok_ty))
                if !g.block_term {
                  let pc = qbe_coerce_val(g, pv, ok_ty)
                  qbe_store_heap_slot(g, pc, val_slot, ok_ty)
                  qbe_emit(g, "storew 1, " + tag_slot)
                }
              }
            ECall(EIdent("Err", _), args, _) | ECall(EPath("Result", "Err", _), args, _) => {
              let pv = qbe_emit_expr(g, args[0], Some(err_ty))
              if !g.block_term {
                let pc = qbe_coerce_val(g, pv, err_ty)
                qbe_store_heap_slot(g, pc, err_slot, err_ty)
                qbe_emit(g, "storew 0, " + tag_slot)
              }
            }
            _ =>
              qbe_emit_tail_opt_res_forward_call(
                g,
                e,
                ret_ty,
                2,
                tag_slot,
                val_slot,
                err_slot,
                val_is_pod_buf,
              )
          }
        _ => ()
      }
  }
}

///|
fn qbe_emit_tail_opt_res_stmts_into_slots(
  g : QbeGen,
  stmts : Array[Stmt],
  ret_ty : Ty,
  tag_slot : String,
  val_slot : String,
  err_slot : String,
  val_is_pod_buf : Bool,
) -> Unit {
  let n = stmts.length()
  let mut i = 0
  while i < n - 1 {
    if g.block_term {
      return
    }
    if qbe_try_emit_stack_pod_let(g, stmts, i) {
      i = i + 1
      continue
    }
    let _ = qbe_emit_stmt(g, stmts[i], None, false)
    i = i + 1
  }
  if !g.block_term && n > 0 {
    match stmts[n - 1] {
      SExpr(tail_e, _) =>
        qbe_emit_tail_opt_res_expr_into_slots(
          g,
          tail_e,
          ret_ty,
          tag_slot,
          val_slot,
          err_slot,
          val_is_pod_buf,
        )
      SReturn(_, _) => {
        let _ = qbe_emit_stmt(g, stmts[n - 1], None, true)
      }
      _ => ()
    }
  }
}

///|
fn qbe_inline_body_into_opt_res_slots(
  g : QbeGen,
  target_pkg : String,
  stack_key : String,
  inl_fd : FnDecl,
  finfo : FnInfo,
  ret_ty : Ty,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
  val_is_pod_buf : Bool,
  val_is_pod_enum : Bool,
  pod_bytes : Int,
) -> QbeScalarOptRes {
  let tag_slot = qbe_alloc_slot4(g)
  let val_slot = if val_is_pod_buf {
    if val_is_pod_enum {
      qbe_alloc_immortal_enum_stack_buf(g, pod_bytes)
    } else {
      qbe_alloc_stack_buf(g, pod_bytes)
    }
  } else {
    qbe_alloc_slot(g)
  }
  let err_slot = if val_is_pod_buf {
    qbe_alloc_slot(g)
  } else {
    val_slot
  }
  g.fn_inlined_cost = g.fn_inlined_cost +
    qbe_callee_inline_cost_for_budget(g, target_pkg, stack_key, inl_fd)
  g.inline_depth = g.inline_depth + 1
  g.inline_stack.push(stack_key)
  let inl_saved_mono_pkg = g.mono_pkg
  let inl_saved_imp_def = g.tc.in_imported_default_arg
  let inl_saved_def_exp = g.tc.in_default_arg_expansion
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  g.tc.in_imported_default_arg = false
  g.tc.in_default_arg_expansion = false
  let inl_hlen = g.hoisted_arr_len
  let inl_hdp = g.hoisted_arr_dp
  let inl_hslen = g.hoisted_str_len
  let inl_hsdp = g.hoisted_str_dp
  let inl_hblen = g.hoisted_bytes_len
  let inl_hbdp = g.hoisted_bytes_dp
  let inl_hfields = g.hoisted_fields
  let inl_bfields = g.block_immut_fields
  let inl_lalias = g.len_aliases
  let inl_lkeys = g.len_alias_keys
  let inl_nonneg = g.nonneg_vars
  let inl_u8r = g.u8_range_vars
  let inl_kml = g.known_min_len_arrs
  let inl_kwb = g.known_writable_bytes
  let inl_bce = g.bce_safe_indices
  let inl_bce_exprs = g.bce_safe_exprs
  let inl_bce_push = g.bce_safe_push_arrs
  let inl_prom = g.promoted_fields
  let inl_prom_tys = g.promoted_field_tys
  let inl_pp_len = g.promoted_push_len
  let inl_pp_cap = g.promoted_push_cap
  let inl_pp_dp = g.promoted_push_dp
  let inl_w2l = g.w_to_l_ext
  let inl_lw2l = g.local_w_to_l_ext
  let inl_unfrozen = g.unfrozen_local_arrs
  let inl_stk_views = g.stack_view_slots
  let inl_pinned_slots = g.pinned_slots
  let inl_mov = g.movable_locals
  let inl_moved = g.moved_slots
  let inl_clos = g.inline_closures
  let inl_rlbl = g.inline_ret_lbl
  let inl_rtag = g.inline_ret_tag_slot
  let inl_rerr = g.inline_ret_err_slot
  let inl_rpod = g.inline_ret_pod_buf
  let inl_rslot = g.inline_ret_slot
  let inl_rty = g.inline_ret_ty
  let inl_rdep = g.inline_ret_scope_depth
  let inl_tco_mode = g.tco_mode
  let inl_tco_fn = g.tco_fn_name
  let inl_tco_lbl = g.tco_loop_lbl
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.stack_view_slots = Map([])
  g.pinned_slots = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.inline_ret_slot = ""
  g.inline_ret_ty = TUnit
  g.inline_ret_scope_depth = 0
  let inl_body = qbe_fn_body(g, inl_fd.body)
  let inl_saved_verify = g.in_verify
  g.in_verify = inl_fd.is_verify
  let inl_scope_base = g.scopes.length()
  let caller_lookup_floor = g.lookup_scope_floor
  g.lookup_scope_floor = inl_scope_base
  qbe_scope_push(g)
  let inl_has_dp = qbe_stmts_has_any_data_ptr(inl_body)
  let mut pi = 0
  while pi < inl_fd.params.length() {
    let pty = finfo.param_tys[pi]
    let pname = inl_fd.params[pi].name
    let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
    let mut p_owned = !arg_borrowed[pi]
    if arg_borrowed[pi] && qbe_stmts_assigns_ident(inl_body, pname) {
      qbe_rc_inc(g, pv, pty)
      p_owned = true
    }
    let loc = qbe_define_local(g, pname, pty, p_owned)
    qbe_store_local_slot(g, pv, loc.slot, pty)
    if !p_owned {
      g.borrow_owner_slot.set(loc.slot, loc.slot)
      g.borrow_owner_name.set(loc.slot, pname)
    }
    if inl_has_dp && p_owned && qbe_stmts_tail_takes_data_ptr(inl_body, 0, pname) {
      let prev = match g.pinned_slots.get(loc.slot) {
        Some(c) => c
        None => 0
      }
      g.pinned_slots.set(loc.slot, prev + 1)
    }
    pi = pi + 1
  }
  let has_ret = qbe_stmts_has_cf(inl_body, false, false, true) ||
    qbe_stmts_has_default_ret(g, inl_body)
  if !has_ret {
    qbe_emit_tail_opt_res_stmts_into_slots(
      g,
      inl_body,
      ret_ty,
      tag_slot,
      val_slot,
      err_slot,
      val_is_pod_buf,
    )
    qbe_scope_pop(g)
  } else {
    let sc_ret = qbe_lbl(g, "sc_ret")
    g.inline_ret_lbl = sc_ret
    g.inline_ret_tag_slot = tag_slot
    g.inline_ret_err_slot = err_slot
    g.inline_ret_pod_buf = val_is_pod_buf
    g.inline_ret_slot = val_slot
    g.inline_ret_ty = ret_ty
    g.inline_ret_scope_depth = inl_scope_base
    qbe_emit_tail_opt_res_stmts_into_slots(
      g,
      inl_body,
      ret_ty,
      tag_slot,
      val_slot,
      err_slot,
      val_is_pod_buf,
    )
    if !g.block_term {
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + sc_ret)
    } else {
      let _ = g.scopes.pop()
    }
    qbe_emit_lbl(g, sc_ret)
    g.block_immut_fields = Map([])
  }
  g.lookup_scope_floor = caller_lookup_floor
  g.in_verify = inl_saved_verify
  g.hoisted_arr_len = inl_hlen
  g.hoisted_arr_dp = inl_hdp
  g.hoisted_str_len = inl_hslen
  g.hoisted_str_dp = inl_hsdp
  g.hoisted_bytes_len = inl_hblen
  g.hoisted_bytes_dp = inl_hbdp
  g.hoisted_fields = inl_hfields
  g.block_immut_fields = Map([])
  g.len_aliases = inl_lalias
  g.len_alias_keys = inl_lkeys
  g.nonneg_vars = inl_nonneg
  g.u8_range_vars = inl_u8r
  g.known_min_len_arrs = inl_kml
  g.known_writable_bytes = inl_kwb
  g.bce_safe_indices = inl_bce
  g.bce_safe_exprs = inl_bce_exprs
  g.bce_safe_push_arrs = inl_bce_push
  g.promoted_fields = inl_prom
  g.promoted_field_tys = inl_prom_tys
  g.promoted_push_len = inl_pp_len
  g.promoted_push_cap = inl_pp_cap
  g.promoted_push_dp = inl_pp_dp
  g.w_to_l_ext = inl_w2l
  g.local_w_to_l_ext = inl_lw2l
  g.unfrozen_local_arrs = inl_unfrozen
  g.stack_view_slots = inl_stk_views
  g.pinned_slots = inl_pinned_slots
  g.movable_locals = inl_mov
  g.moved_slots = inl_moved
  g.inline_closures = inl_clos
  g.inline_ret_lbl = inl_rlbl
  g.inline_ret_tag_slot = inl_rtag
  g.inline_ret_err_slot = inl_rerr
  g.inline_ret_pod_buf = inl_rpod
  g.inline_ret_slot = inl_rslot
  g.inline_ret_ty = inl_rty
  g.inline_ret_scope_depth = inl_rdep
  g.tco_mode = inl_tco_mode
  g.tco_fn_name = inl_tco_fn
  g.tco_loop_lbl = inl_tco_lbl
  g.mono_pkg = inl_saved_mono_pkg
  g.tc.in_imported_default_arg = inl_saved_imp_def
  g.tc.in_default_arg_expansion = inl_saved_def_exp
  let _ = inl_bfields
  let _ = g.inline_stack.pop()
  g.inline_depth = g.inline_depth - 1
  QbeScalarOptRes::{
    tag_slot: tag_slot,
    val_slot: val_slot,
    err_slot: err_slot,
    val_is_pod_buf: val_is_pod_buf,
    ret_ty: ret_ty,
  }
}

///|
fn qbe_local_fn_can_scalar_inline(g : QbeGen, key : String, finfo : FnInfo) -> Option[FnDecl] {
  if !g.release ||
    g.mono_pkg != "" ||
    g.inline_depth >= 3 ||
    finfo.decl.type_params.length() != 0 ||
    params_have_mut(finfo.decl.params) ||
    str_arr_contains(g.inline_stack, key) {
    return None
  }
  match g.inline_fns.get(key) {
    Some(inl_fd) => {
      let same_file = match g.inline_fn_file.get(key) {
        Some(fidx) => g.cur_file_idx < 0 || fidx == g.cur_file_idx
        None => true
      }
      // Immediate destructuring also removes the result allocation and its release.
      let consumes_variant = match finfo.ret_ty {
        TOption(_) | TResult(_, _) => true
        _ => false
      }
      let max_cost = qbe_inline_max_cost(
        g,
        same_file,
        inl_fd.is_pub,
        consumes_variant,
      )
      let fn_cost = match g.inline_fn_costs.get(key) {
        Some(c) => c
        None => 0
      }
      if fn_cost <= max_cost && !qbe_caller_over_inline_budget(g, fn_cost) {
        Some(inl_fd)
      } else {
        None
      }
    }
    None => None
  }
}

///|
fn qbe_xpkg_fn_can_scalar_inline(
  g : QbeGen,
  target_pkg : String,
  key : String,
  finfo : FnInfo,
) -> Option[FnDecl] {
  let stack_key = target_pkg + "::" + key
  if !g.release ||
    target_pkg == "" ||
    g.inline_depth >= 3 ||
    finfo.decl.type_params.length() != 0 ||
    params_have_mut(finfo.decl.params) ||
    str_arr_contains(g.inline_stack, stack_key) {
    return None
  }
  match g.tc.imported_pkgs.get(target_pkg) {
    Some(ipkg) => {
      let can_inl = if finfo.decl.is_pub {
        xpkg_fn_is_inlinable_tc(ipkg.tc, finfo.decl)
      } else {
        g.mono_pkg == target_pkg &&
        xpkg_fn_is_inlinable_priv_leaf_tc(ipkg.tc, finfo.decl)
      }
      if can_inl {
        let self_key = if finfo.decl.receiver_type != "" {
          finfo.decl.receiver_type + "::" + finfo.decl.name
        } else {
          finfo.decl.name
        }
        let is_opt_res = match finfo.decl.ret_ty {
          TyName("Option", _, _) | TyName("Result", _, _) => true
          _ => false
        }
        let fn_cost = qbe_stmts_inline_cost_in(
          finfo.decl.body,
          self_key,
          false,
          if is_opt_res { 1 } else { 0 },
        )
        let xpkg_max_cost = qbe_inline_max_cost(g, false, true, is_opt_res)
        if fn_cost < 0 ||
          ((g.j2_disable_mask & 32) == 0 &&
            g.loop_breaks.length() == 0 &&
            !is_opt_res &&
            fn_cost > xpkg_max_cost) ||
          qbe_caller_over_inline_budget(g, fn_cost) {
          return None
        }
        Some(finfo.decl)
      } else {
        None
      }
    }
    None => None
  }
}

///|
/// Try to evaluate `expr` directly into `(tag_slot, val_slot, err_slot)` without heap allocation.
/// `want_kind`: 0 = Option or Result, 1 = Option only, 2 = Result only.
/// `allow_pod_ok`: when true, pure-scalar immutable POD `Ok`/`Some` payloads may be
/// scalarized into a stack buffer (`val_is_pod_buf = true`) with zero heap allocation.
fn qbe_try_emit_opt_res_scalarized(
  g : QbeGen,
  expr : Expr,
  want_kind : Int,
  allow_pod_ok : Bool,
) -> Option[QbeScalarOptRes] {
  match expr {
    EIf(_, _, Some(_), _) | EBlock(_, _) | EMatch(_, _, _) =>
      match qbe_probe_expr_ty(g, expr) {
        Some(raw_ty) =>
          match qbe_ty_is_scalarizable_opt_res(g, raw_ty, want_kind, allow_pod_ok) {
            Some(ret_ty) => {
              let mut val_is_pod_buf = false
              let mut val_is_pod_enum = false
              let mut pod_bytes = 0
              match qbe_opt_res_pod_info(g, ret_ty, allow_pod_ok) {
                Some(PodStruct(_, _, nslots)) =>
                  if qbe_expr_all_tails_are_opt_res_ctors(g, expr, ret_ty, true) {
                    val_is_pod_buf = true
                    pod_bytes = nslots * 8
                  }
                Some(PodEnum(_, _, nslots)) =>
                  if qbe_expr_all_tails_are_opt_res_ctors(g, expr, ret_ty, true) {
                    val_is_pod_buf = true
                    val_is_pod_enum = true
                    pod_bytes = nslots * 8
                  }
                None => ()
              }
              let can_non_pod = match ret_ty {
                TOption(inner) => !qbe_is_niche_opt_inner(g, inner)
                _ => true
              }
              if val_is_pod_buf ||
                (can_non_pod && qbe_expr_all_tails_are_opt_res_ctors(g, expr, ret_ty, false)) {
                let tag_slot = qbe_alloc_slot4(g)
                let val_slot = if val_is_pod_buf {
                  if val_is_pod_enum {
                    qbe_alloc_immortal_enum_stack_buf(g, pod_bytes)
                  } else {
                    qbe_alloc_stack_buf(g, pod_bytes)
                  }
                } else {
                  qbe_alloc_slot(g)
                }
                let err_slot = if val_is_pod_buf {
                  qbe_alloc_slot(g)
                } else {
                  val_slot
                }
                qbe_emit_tail_opt_res_expr_into_slots(
                  g,
                  expr,
                  ret_ty,
                  tag_slot,
                  val_slot,
                  err_slot,
                  val_is_pod_buf,
                )
                Some(QbeScalarOptRes::{
                  tag_slot: tag_slot,
                  val_slot: val_slot,
                  err_slot: err_slot,
                  val_is_pod_buf: val_is_pod_buf,
                  ret_ty: ret_ty,
                })
              } else {
                None
              }
            }
            None => None
          }
        None => None
      }
    ECall(EIdent(name, _), args, sp) => {
      match qbe_lookup_local(g, name) {
        Some(_) => return None
        None => ()
      }
      let target_pkg = g.mono_pkg
      let finfo_opt : Option[FnInfo] = if target_pkg == "" {
        g.tc.fns.get(name)
      } else {
        match g.tc.imported_pkgs.get(target_pkg) {
          Some(ipkg) =>
            match ipkg.tc.fns.get(name) {
              Some(fi) => Some(qualify_fn_info(ipkg, fi))
              None => None
            }
          None => None
        }
      }
      match finfo_opt {
        Some(finfo) =>
          match qbe_ty_is_scalarizable_opt_res(g, finfo.ret_ty, want_kind, allow_pod_ok) {
            Some(ret_ty) => {
              let inl_fd_opt : Option[FnDecl] = if target_pkg == "" {
                qbe_local_fn_can_scalar_inline(g, name, finfo)
              } else {
                qbe_xpkg_fn_can_scalar_inline(g, target_pkg, name, finfo)
              }
              match inl_fd_opt {
                Some(inl_fd) => {
                  let inl_body = qbe_fn_body(g, inl_fd.body)
                  let stack_key = if target_pkg != "" {
                    target_pkg + "::" + name
                  } else {
                    name
                  }
                  let mut val_is_pod_buf = false
                  let mut val_is_pod_enum = false
                  let mut pod_bytes = 0
                  match qbe_opt_res_pod_info(g, ret_ty, allow_pod_ok) {
                    Some(PodStruct(_, _, nslots)) =>
                      if qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, true) {
                        val_is_pod_buf = true
                        pod_bytes = nslots * 8
                      }
                    Some(PodEnum(_, _, nslots)) =>
                      if qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, true) {
                        val_is_pod_buf = true
                        val_is_pod_enum = true
                        pod_bytes = nslots * 8
                      }
                    None => ()
                  }
                  let can_non_pod = match ret_ty {
                    TOption(inner) => !qbe_is_niche_opt_inner(g, inner)
                    _ => true
                  }
                  if !val_is_pod_buf &&
                    (!can_non_pod || !qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, false)) {
                    return None
                  }
                  let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
                  if qbe_has_any_default(call_res.from_default) {
                    return None
                  }
                  let norm_args = call_res.args
                  if norm_args.length() != inl_fd.params.length() ||
                    norm_args.length() != finfo.param_tys.length() {
                    return None
                  }
                  let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
                  let arg_vals : Array[String] = []
                  let arg_tys : Array[Ty] = []
                  let arg_borrowed : Array[Bool] = []
                  let wbs : Array[QbeMutWb] = []
                  let order = qbe_call_eval_order(finfo.decl.params, 0, args, norm_args.length())
                  qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
                  let guards = qbe_arg_guards(g, norm_args, order)
                  let mut oi = 0
                  while oi < order.length() {
                    let i = order[oi]
                    match norm_args[i] {
                      EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                      _ => ()
                    }
                    let aa = qbe_emit_call_arg(
                      g,
                      finfo.decl.params,
                      i,
                      norm_args[i],
                      Some(finfo.param_tys[i]),
                      can_borrow,
                      wbs,
                      norm_args,
                    )
                    arg_vals[i] = aa.qv.reg
                    arg_tys[i] = aa.qv.ty
                    arg_borrowed[i] = aa.borrowed
                    qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(finfo.decl.params, i, norm_args[i]), guards.exits[oi])
                    oi = oi + 1
                  }
                  qbe_release_guards(g, guards)
                  let stack_key = if target_pkg != "" {
                    target_pkg + "::" + name
                  } else {
                    name
                  }
                  Some(
                    qbe_inline_body_into_opt_res_slots(
                      g,
                      target_pkg,
                      stack_key,
                      inl_fd,
                      finfo,
                      ret_ty,
                      arg_vals,
                      arg_tys,
                      arg_borrowed,
                      val_is_pod_buf,
                      val_is_pod_enum,
                      pod_bytes,
                    ),
                  )
                }
                None => None
              }
            }
            None => None
          }
        None => None
      }
    }
    ECall(EPath(qual, mem, _), args, sp) => {
      let mut target_finfo : Option[FnInfo] = None
      let mut target_pkg = ""
      let mut key = qual + "::" + mem
      if has_qual_sep(qual) {
        let qp = split_qual_name(qual)
        match qbe_resolve_pkg_in_scope(g, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.methods.get(qp.name + "::" + mem) {
              Some(mi) => {
                target_finfo = Some(qualify_fn_info(ipkg, mi))
                target_pkg = ipkg.name
                key = qp.name + "::" + mem
              }
              None => ()
            }
          None => ()
        }
      }
      match target_finfo {
        None =>
          match qbe_resolve_pkg_in_scope(g, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(fi) => {
                  target_finfo = Some(qualify_fn_info(ipkg, fi))
                  target_pkg = ipkg.name
                  key = mem
                }
                None => ()
              }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(qual + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_pkg = ipkg.name
                  }
                  None => ()
                }
              None => ()
            }
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          match qbe_lookup_method_info(g, qual, mem) {
            Some(minfo) => {
              target_finfo = Some(minfo)
              let qpm = split_qual_name(qual)
              if qpm.prefix != "" {
                target_pkg = qpm.prefix
              } else if g.mono_pkg != "" {
                target_pkg = g.mono_pkg
              }
            }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        Some(minfo) =>
          match qbe_ty_is_scalarizable_opt_res(g, minfo.ret_ty, want_kind, allow_pod_ok) {
            Some(ret_ty) => {
              let inl_fd_opt : Option[FnDecl] = if target_pkg == "" &&
                g.mono_pkg == "" &&
                !has_qual_sep(qual) {
                qbe_local_fn_can_scalar_inline(g, key, minfo)
              } else if target_pkg != "" {
                qbe_xpkg_fn_can_scalar_inline(g, target_pkg, key, minfo)
              } else {
                None
              }
              match inl_fd_opt {
                Some(inl_fd) => {
                  let inl_body = qbe_fn_body(g, inl_fd.body)
                  let stack_key = if target_pkg != "" {
                    target_pkg + "::" + key
                  } else {
                    key
                  }
                  let mut val_is_pod_buf = false
                  let mut val_is_pod_enum = false
                  let mut pod_bytes = 0
                  match qbe_opt_res_pod_info(g, ret_ty, allow_pod_ok) {
                    Some(PodStruct(_, _, nslots)) =>
                      if qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, true) {
                        val_is_pod_buf = true
                        pod_bytes = nslots * 8
                      }
                    Some(PodEnum(_, _, nslots)) =>
                      if qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, true) {
                        val_is_pod_buf = true
                        val_is_pod_enum = true
                        pod_bytes = nslots * 8
                      }
                    None => ()
                  }
                  let can_non_pod = match ret_ty {
                    TOption(inner) => !qbe_is_niche_opt_inner(g, inner)
                    _ => true
                  }
                  if !val_is_pod_buf &&
                    (!can_non_pod || !qbe_fn_body_can_scalar_opt_res(g, target_pkg, stack_key, inl_body, ret_ty, false)) {
                    return None
                  }
                  let call_res = resolve_call_args_qbe_full(minfo.decl.params, 0, args, sp)
                  if qbe_has_any_default(call_res.from_default) {
                    return None
                  }
                  let norm_args = call_res.args
                  if norm_args.length() != inl_fd.params.length() ||
                    norm_args.length() != minfo.param_tys.length() {
                    return None
                  }
                  let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
                  let arg_vals : Array[String] = []
                  let arg_tys : Array[Ty] = []
                  let arg_borrowed : Array[Bool] = []
                  let wbs : Array[QbeMutWb] = []
                  let order = qbe_call_eval_order(minfo.decl.params, 0, args, norm_args.length())
                  qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
                  let guards = qbe_arg_guards(g, norm_args, order)
                  let mut oi = 0
                  while oi < order.length() {
                    let i = order[oi]
                    match norm_args[i] {
                      EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                      _ => ()
                    }
                    let aa = qbe_emit_call_arg(
                      g,
                      minfo.decl.params,
                      i,
                      norm_args[i],
                      Some(minfo.param_tys[i]),
                      can_borrow,
                      wbs,
                      norm_args,
                    )
                    arg_vals[i] = aa.qv.reg
                    arg_tys[i] = aa.qv.ty
                    arg_borrowed[i] = aa.borrowed
                    qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i, norm_args[i]), guards.exits[oi])
                    oi = oi + 1
                  }
                  qbe_release_guards(g, guards)
                  let stack_key = if target_pkg != "" {
                    target_pkg + "::" + key
                  } else {
                    key
                  }
                  Some(
                    qbe_inline_body_into_opt_res_slots(
                      g,
                      target_pkg,
                      stack_key,
                      inl_fd,
                      minfo,
                      ret_ty,
                      arg_vals,
                      arg_tys,
                      arg_borrowed,
                      val_is_pod_buf,
                      val_is_pod_enum,
                      pod_bytes,
                    ),
                  )
                }
                None => None
              }
            }
            None => None
          }
        None => None
      }
    }
    EMethodCall(recv, method_name, args, sp) => {
      if qbe_has_expected_trait(g, sp) {
        return None
      }
      match qbe_probe_expr_ty(g, recv) {
        Some(TStruct(sname, _)) =>
          match qbe_lookup_method_info(g, sname, method_name) {
            Some(minfo) =>
              match qbe_ty_is_scalarizable_opt_res(g, minfo.ret_ty, want_kind, allow_pod_ok) {
                Some(ret_ty) => {
                  let qp_m = split_qual_name(sname)
                  let mpkg = if qp_m.prefix != "" { qp_m.prefix } else { g.mono_pkg }
                  let key = sname + "::" + method_name
                  let inl_fd_opt : Option[FnDecl] = if mpkg == "" && !has_qual_sep(sname) {
                    qbe_local_fn_can_scalar_inline(g, key, minfo)
                  } else if mpkg != "" {
                    qbe_xpkg_fn_can_scalar_inline(g, mpkg, key, minfo)
                  } else {
                    None
                  }
                  match inl_fd_opt {
                    Some(inl_fd) => {
                      let inl_body = qbe_fn_body(g, inl_fd.body)
                      let stack_key = if mpkg != "" { mpkg + "::" + key } else { key }
                      let mut val_is_pod_buf = false
                      let mut val_is_pod_enum = false
                      let mut pod_bytes = 0
                      match qbe_opt_res_pod_info(g, ret_ty, allow_pod_ok) {
                        Some(PodStruct(_, _, nslots)) =>
                          if qbe_fn_body_can_scalar_opt_res(g, mpkg, stack_key, inl_body, ret_ty, true) {
                            val_is_pod_buf = true
                            pod_bytes = nslots * 8
                          }
                        Some(PodEnum(_, _, nslots)) =>
                          if qbe_fn_body_can_scalar_opt_res(g, mpkg, stack_key, inl_body, ret_ty, true) {
                            val_is_pod_buf = true
                            val_is_pod_enum = true
                            pod_bytes = nslots * 8
                          }
                        None => ()
                      }
                      let can_non_pod = match ret_ty {
                        TOption(inner) => !qbe_is_niche_opt_inner(g, inner)
                        _ => true
                      }
                      if !val_is_pod_buf &&
                        (!can_non_pod || !qbe_fn_body_can_scalar_opt_res(g, mpkg, stack_key, inl_body, ret_ty, false)) {
                        return None
                      }
                      let call_res = resolve_call_args_qbe_full(minfo.decl.params, 1, args, sp)
                      if qbe_has_any_default(call_res.from_default) {
                        return None
                      }
                      let norm_args = call_res.args
                      if norm_args.length() + 1 != inl_fd.params.length() ||
                        norm_args.length() + 1 != minfo.param_tys.length() {
                        return None
                      }
                      let recv_pure = !qbe_expr_has_assign(recv) && !qbe_args_have_assign(norm_args)
                      let ra = qbe_emit_arg_maybe_borrow(g, recv, None, recv_pure)
                      let arg_vals : Array[String] = [ra.qv.reg]
                      let arg_tys : Array[Ty] = [ra.qv.ty]
                      let arg_borrowed : Array[Bool] = [ra.borrowed]
                      let wbs : Array[QbeMutWb] = []
                      let order = qbe_call_eval_order(minfo.decl.params, 1, args, norm_args.length())
                      qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length() + 1)
                      let guards = qbe_arg_guards(g, norm_args, order)
                      qbe_guard_val(g, guards, QbeArgVal::{ qv: qval(arg_vals[0], arg_tys[0]), borrowed: arg_borrowed[0] }, false, qbe_guards_exit_before_order(g, guards, norm_args, order))
                      let mut oi = 0
                      while oi < order.length() {
                        let i = order[oi]
                        let p_idx = i + 1
                        let aa = qbe_emit_call_arg(
                          g,
                          minfo.decl.params,
                          p_idx,
                          norm_args[i],
                          Some(minfo.param_tys[p_idx]),
                          recv_pure,
                          wbs,
                          norm_args,
                        )
                        arg_vals[i + 1] = aa.qv.reg
                        arg_tys[i + 1] = aa.qv.ty
                        arg_borrowed[i + 1] = aa.borrowed
                        qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i + 1, norm_args[i]), guards.exits[oi])
                        oi = oi + 1
                      }
                      qbe_release_guards(g, guards)
                      let stack_key = if mpkg != "" { mpkg + "::" + key } else { key }
                      Some(
                        qbe_inline_body_into_opt_res_slots(
                          g,
                          mpkg,
                          stack_key,
                          inl_fd,
                          minfo,
                          ret_ty,
                          arg_vals,
                          arg_tys,
                          arg_borrowed,
                          val_is_pod_buf,
                          val_is_pod_enum,
                          pod_bytes,
                        ),
                      )
                    }
                    None => None
                  }
                }
                None => None
              }
            None => None
          }
        _ => None
      }
    }
    _ => None
  }
}

///|
/// Multi-arm / nested-pattern scalarized `match` over a short-lived `Option[T]` / `Result[T, E]`,
/// e.g. `match decode(...) { Ok(DecodeStatus::Complete(ok, n)) => ..., Ok(DecodeStatus::Incomplete) => ..., Err(e) => ... }`.
fn qbe_try_emit_scalar_opt_res_nested_match(
  g : QbeGen,
  scrut : Expr,
  arms : Array[MatchArm],
  expected : Option[Ty],
) -> Option[QbeVal] {
  if arms.length() < 2 {
    return None
  }
  let mut want_kind = 0
  let ok_arm_idxs : Array[Int] = []
  let ok_subpats : Array[Pattern] = []
  let err_arm_idxs : Array[Int] = []
  let err_subpats : Array[Pattern] = []
  let mut allow_pod_ok = true
  let mut i = 0
  while i < arms.length() {
    let arm = arms[i]
    match arm.guard_expr {
      Some(_) => return None
      None => ()
    }
    match arm.pat {
      PVariant(eq, "Ok", subs, _, _) => {
        if (eq != "" && eq != "Result") || subs.length() != 1 || want_kind == 1 {
          return None
        }
        want_kind = 2
        let sp = subs[0]
        let ok_safe = match sp {
          PWild(_) => true
          PIdent(b, _) =>
            qbe_ident_is_flat_field_only_expr(arm.body, b) ||
            qbe_ident_is_match_only_enum_expr(arm.body, b)
          PVariant(_, _, _, _, _) => qbe_pat_is_safe_enum_destructure(sp)
          _ => false
        }
        if !ok_safe {
          allow_pod_ok = false
        }
        ok_arm_idxs.push(i)
        ok_subpats.push(sp)
      }
      PVariant(eq, "Err", subs, _, _) => {
        if (eq != "" && eq != "Result") || subs.length() != 1 || want_kind == 1 {
          return None
        }
        want_kind = 2
        err_arm_idxs.push(i)
        err_subpats.push(subs[0])
      }
      PVariant(eq, "Some", subs, _, _) => {
        if (eq != "" && eq != "Option") || subs.length() != 1 || want_kind == 2 {
          return None
        }
        want_kind = 1
        let sp = subs[0]
        let ok_safe = match sp {
          PWild(_) => true
          PIdent(b, _) =>
            qbe_ident_is_flat_field_only_expr(arm.body, b) ||
            qbe_ident_is_match_only_enum_expr(arm.body, b)
          PVariant(_, _, _, _, _) => qbe_pat_is_safe_enum_destructure(sp)
          _ => false
        }
        if !ok_safe {
          allow_pod_ok = false
        }
        ok_arm_idxs.push(i)
        ok_subpats.push(sp)
      }
      PVariant(eq, "None", subs, _, sp) => {
        if (eq != "" && eq != "Option") || subs.length() != 0 || want_kind == 2 {
          return None
        }
        want_kind = 1
        err_arm_idxs.push(i)
        err_subpats.push(PWild(sp))
      }
      PWild(sp) => {
        if i != arms.length() - 1 {
          return None
        }
        ok_arm_idxs.push(i)
        ok_subpats.push(PWild(sp))
        err_arm_idxs.push(i)
        err_subpats.push(PWild(sp))
      }
      _ => return None
    }
    i = i + 1
  }
  if want_kind == 0 || ok_arm_idxs.length() == 0 || err_arm_idxs.length() == 0 {
    return None
  }
  let sc = match qbe_try_emit_opt_res_scalarized(g, scrut, want_kind, allow_pod_ok) {
    Some(s) => s
    None => return None
  }
  if g.block_term {
    return Some(qval("0", TNever))
  }
  let ok_ty = match sc.ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return None
  }
  let err_ty_opt : Option[Ty] = match sc.ret_ty {
    TResult(_, et) => Some(et)
    _ => None
  }
  let tag_w = qbe_tmp(g)
  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
  let l_ok = qbe_lbl(g, "scmn_ok")
  let l_err = qbe_lbl(g, "scmn_err")
  let l_end = qbe_lbl(g, "scmn_end")
  qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
  let mut res_slot = ""
  let mut res_ty : Option[Ty] = qbe_probe_arms_ty(g, arms, Some(sc.ret_ty), expected)
  let mut saw_untyped_none = false
  let mut all_term = true
  // Ok / Some branch
  qbe_emit_lbl(g, l_ok)
  g.block_immut_fields = Map([])
  qbe_scope_push(g)
  let mut ok_loc_slot = ""
  if !sc.val_is_pod_buf {
    let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
    let ok_tmp_name = "$__scmn_ok_" + g.next_tmp.to_string()
    g.next_tmp = g.next_tmp + 1
    let oloc = qbe_define_local(g, ok_tmp_name, ok_ty, true)
    qbe_store_local_slot(g, v_ok, oloc.slot, ok_ty)
    ok_loc_slot = oloc.slot
  }
  let l_ok_done = qbe_lbl(g, "scmn_ok_done")
  let mut ok_all_term = true
  let mut oi = 0
  while oi < ok_arm_idxs.length() {
    let arm = arms[ok_arm_idxs[oi]]
    let subpat = ok_subpats[oi]
    let l_next = qbe_lbl(g, "scmn_onext")
    let cur_ok = if sc.val_is_pod_buf {
      qbe_pod_buf_val(g, sc.val_slot, ok_ty)
    } else {
      qbe_load_local_slot(g, ok_loc_slot, ok_ty)
    }
    qbe_emit_pat_test(g, subpat, cur_ok, ok_ty, l_next)
    qbe_scope_push(g)
    let bind_ok = if sc.val_is_pod_buf {
      qbe_pod_buf_val(g, sc.val_slot, ok_ty)
    } else {
      qbe_load_local_slot(g, ok_loc_slot, ok_ty)
    }
    if sc.val_is_pod_buf {
      match subpat {
        PIdent(b, _) => {
          let vloc = qbe_define_local(g, b, ok_ty, false)
          qbe_emit(g, "storel " + bind_ok + ", " + vloc.slot)
        }
        _ => qbe_emit_pat_bind(g, subpat, bind_ok, ok_ty, false, arm.body)
      }
    } else {
      qbe_emit_pat_bind(g, subpat, bind_ok, ok_ty, false, arm.body)
    }
    let ok_dp_pinned : Array[String] = []
    qbe_pin_top_scope_for_arm(g, None, arm.body, ok_dp_pinned)
    let sv = qbe_emit_expr(g, arm.body, res_ty)
    qbe_unpin_slot_list(g, ok_dp_pinned)
    match res_ty {
      None =>
        match sv.ty {
          TNever => ()
          _ => {
            if qbe_ty_has_untyped_option(sv.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(sv.ty)
          }
        }
      Some(rt) => {
        if qbe_ty_has_untyped_option(sv.ty) {
          saw_untyped_none = true
        }
        res_ty = Some(ty_prefer_concrete(rt, sv.ty))
      }
    }
    let arm_term = g.block_term
    if !arm_term {
      ok_all_term = false
      all_term = false
      let store_ty = match res_ty {
        Some(t) => t
        None => sv.ty
      }
      if res_slot == "" {
        res_slot = qbe_alloc_slot_for(g, store_ty)
      }
      qbe_store_local_slot(g, qbe_coerce_val(g, sv, store_ty), res_slot, store_ty)
    }
    qbe_scope_pop(g)
    if !arm_term {
      qbe_emit_term(g, "jmp " + l_ok_done)
    }
    qbe_emit_lbl(g, l_next)
    g.block_immut_fields = Map([])
    oi = oi + 1
  }
  let f_id = qbe_intern_source_path(g, arms[0].span.file)
  let m_id = qbe_intern_cstring(g, "non-exhaustive match")
  qbe_emit(
    g,
    "call $pion_panic(l $pion_cstr_" +
    m_id.to_string() +
    ", l $pion_cstr_" +
    f_id.to_string() +
    ", w " +
    arms[0].span.line.to_string() +
    ")",
  )
  qbe_emit_term(g, "hlt")
  if ok_all_term {
    let _ = g.scopes.pop()
  } else {
    qbe_emit_lbl(g, l_ok_done)
    g.block_immut_fields = Map([])
    qbe_scope_pop(g)
    qbe_emit_term(g, "jmp " + l_end)
  }
  // Err / None branch
  qbe_emit_lbl(g, l_err)
  g.block_immut_fields = Map([])
  qbe_scope_push(g)
  let mut err_loc_slot = ""
  match err_ty_opt {
    Some(err_ty) => {
      let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
      let err_tmp_name = "$__scmn_err_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let eloc = qbe_define_local(g, err_tmp_name, err_ty, true)
      qbe_store_local_slot(g, v_err, eloc.slot, err_ty)
      err_loc_slot = eloc.slot
    }
    None => ()
  }
  let l_err_done = qbe_lbl(g, "scmn_err_done")
  let mut err_all_term = true
  let mut ei = 0
  while ei < err_arm_idxs.length() {
    let arm = arms[err_arm_idxs[ei]]
    let subpat = err_subpats[ei]
    let l_next = qbe_lbl(g, "scmn_enext")
    match err_ty_opt {
      Some(err_ty) => {
        let cur_err = qbe_load_local_slot(g, err_loc_slot, err_ty)
        qbe_emit_pat_test(g, subpat, cur_err, err_ty, l_next)
      }
      None => ()
    }
    qbe_scope_push(g)
    match err_ty_opt {
      Some(err_ty) => {
        let bind_err = qbe_load_local_slot(g, err_loc_slot, err_ty)
        qbe_emit_pat_bind(g, subpat, bind_err, err_ty, false, arm.body)
      }
      None => ()
    }
    let err_dp_pinned : Array[String] = []
    qbe_pin_top_scope_for_arm(g, None, arm.body, err_dp_pinned)
    let nv = qbe_emit_expr(g, arm.body, res_ty)
    qbe_unpin_slot_list(g, err_dp_pinned)
    match res_ty {
      None =>
        match nv.ty {
          TNever => ()
          _ => {
            if qbe_ty_has_untyped_option(nv.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(nv.ty)
          }
        }
      Some(rt) => {
        if qbe_ty_has_untyped_option(nv.ty) {
          saw_untyped_none = true
        }
        res_ty = Some(ty_prefer_concrete(rt, nv.ty))
      }
    }
    let arm_term = g.block_term
    if !arm_term {
      err_all_term = false
      all_term = false
      let store_ty = match res_ty {
        Some(t) => t
        None => nv.ty
      }
      if res_slot == "" {
        res_slot = qbe_alloc_slot_for(g, store_ty)
      }
      qbe_store_local_slot(g, qbe_coerce_val(g, nv, store_ty), res_slot, store_ty)
    }
    qbe_scope_pop(g)
    if !arm_term {
      qbe_emit_term(g, "jmp " + l_err_done)
    }
    qbe_emit_lbl(g, l_next)
    g.block_immut_fields = Map([])
    ei = ei + 1
  }
  qbe_emit(
    g,
    "call $pion_panic(l $pion_cstr_" +
    m_id.to_string() +
    ", l $pion_cstr_" +
    f_id.to_string() +
    ", w " +
    arms[0].span.line.to_string() +
    ")",
  )
  qbe_emit_term(g, "hlt")
  if err_all_term {
    let _ = g.scopes.pop()
  } else {
    qbe_emit_lbl(g, l_err_done)
    g.block_immut_fields = Map([])
    qbe_scope_pop(g)
    qbe_emit_term(g, "jmp " + l_end)
  }
  if all_term {
    g.block_term = true
    return Some(qval("0", TNever))
  }
  qbe_emit_lbl(g, l_end)
  g.block_immut_fields = Map([])
  let final_ty = match res_ty {
    Some(t) => t
    None => TUnit
  }
  if res_slot == "" {
    Some(qval(qbe_zero_reg(final_ty), final_ty))
  } else {
    let mut r = qbe_load_local_slot(g, res_slot, final_ty)
    if saw_untyped_none {
      r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
    }
    Some(qval(r, final_ty))
  }
}

///|
/// Zero-alloc scalarized `match` over a short-lived boxed `Option[T]` / `Result[T, E]`.
fn qbe_try_emit_scalar_opt_res_match(
  g : QbeGen,
  scrut : Expr,
  arms : Array[MatchArm],
  expected : Option[Ty],
) -> Option[QbeVal] {
  let (want_kind, ok_idx, err_idx, ok_bind, err_bind) = match qbe_match_2arm_opt_res(arms) {
    Some(t) => t
    None => return qbe_try_emit_scalar_opt_res_nested_match(g, scrut, arms, expected)
  }
  let allow_pod_ok = ok_bind == "" ||
    qbe_ident_is_flat_field_only_expr(arms[ok_idx].body, ok_bind) ||
    qbe_ident_is_match_only_enum_expr(arms[ok_idx].body, ok_bind)
  let sc = match qbe_try_emit_opt_res_scalarized(g, scrut, want_kind, allow_pod_ok) {
    Some(s) => s
    None => return None
  }
  if g.block_term {
    return Some(qval("0", TNever))
  }
  let ok_ty = match sc.ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return None
  }
  let err_ty_opt : Option[Ty] = match sc.ret_ty {
    TResult(_, et) => Some(et)
    _ => None
  }
  let tag_w = qbe_tmp(g)
  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
  let l_ok = qbe_lbl(g, "scm_ok")
  let l_err = qbe_lbl(g, "scm_err")
  let l_end = qbe_lbl(g, "scm_end")
  qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
  let mut res_slot = ""
  let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
    g,
    arms,
    Some(sc.ret_ty),
    expected,
  )
  let mut saw_untyped_none = false
  qbe_emit_lbl(g, l_ok)
  g.block_immut_fields = Map([])
  qbe_scope_push(g)
  if sc.val_is_pod_buf {
    if ok_bind != "" {
      let vloc = qbe_define_local(g, ok_bind, ok_ty, false)
      let pv = qbe_pod_buf_val(g, sc.val_slot, ok_ty)
      qbe_emit(g, "storel " + pv + ", " + vloc.slot)
    }
  } else {
    let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
    if ok_bind != "" {
      let vloc = qbe_define_local(g, ok_bind, ok_ty, true)
      qbe_store_local_slot(g, v_ok, vloc.slot, ok_ty)
    } else {
      qbe_rc_dec(g, v_ok, ok_ty)
    }
  }
  let ok2_dp_pinned : Array[String] = []
  qbe_pin_top_scope_for_arm(g, None, arms[ok_idx].body, ok2_dp_pinned)
  let sv = qbe_emit_expr(g, arms[ok_idx].body, res_ty)
  qbe_unpin_slot_list(g, ok2_dp_pinned)
  match res_ty {
    None =>
      match sv.ty {
        TNever => ()
        _ => {
          if qbe_ty_has_untyped_option(sv.ty) {
            saw_untyped_none = true
          }
          res_ty = Some(sv.ty)
        }
      }
    Some(rt) => {
      if qbe_ty_has_untyped_option(sv.ty) {
        saw_untyped_none = true
      }
      res_ty = Some(ty_prefer_concrete(rt, sv.ty))
    }
  }
  let ok_term = g.block_term
  if !ok_term {
    let store_ty = match res_ty {
      Some(t) => t
      None => sv.ty
    }
    if res_slot == "" {
      res_slot = qbe_alloc_slot_for(g, store_ty)
    }
    qbe_store_local_slot(g, qbe_coerce_val(g, sv, store_ty), res_slot, store_ty)
  }
  qbe_scope_pop(g)
  if !ok_term {
    qbe_emit_term(g, "jmp " + l_end)
  }
  qbe_emit_lbl(g, l_err)
  g.block_immut_fields = Map([])
  qbe_scope_push(g)
  match err_ty_opt {
    Some(err_ty) => {
      let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
      if err_bind != "" {
        let eloc = qbe_define_local(g, err_bind, err_ty, true)
        qbe_store_local_slot(g, v_err, eloc.slot, err_ty)
      } else {
        qbe_rc_dec(g, v_err, err_ty)
      }
    }
    None => ()
  }
  let err2_dp_pinned : Array[String] = []
  qbe_pin_top_scope_for_arm(g, None, arms[err_idx].body, err2_dp_pinned)
  let nv = qbe_emit_expr(g, arms[err_idx].body, res_ty)
  qbe_unpin_slot_list(g, err2_dp_pinned)
  match res_ty {
    None =>
      match nv.ty {
        TNever => ()
        _ => {
          if qbe_ty_has_untyped_option(nv.ty) {
            saw_untyped_none = true
          }
          res_ty = Some(nv.ty)
        }
      }
    Some(rt) => {
      if qbe_ty_has_untyped_option(nv.ty) {
        saw_untyped_none = true
      }
      res_ty = Some(ty_prefer_concrete(rt, nv.ty))
    }
  }
  let err_term = g.block_term
  if !err_term {
    let store_ty = match res_ty {
      Some(t) => t
      None => nv.ty
    }
    if res_slot == "" {
      res_slot = qbe_alloc_slot_for(g, store_ty)
    }
    qbe_store_local_slot(g, qbe_coerce_val(g, nv, store_ty), res_slot, store_ty)
  }
  qbe_scope_pop(g)
  if !err_term {
    qbe_emit_term(g, "jmp " + l_end)
  }
  if ok_term && err_term {
    g.block_term = true
    return Some(qval("0", TNever))
  }
  qbe_emit_lbl(g, l_end)
  g.block_immut_fields = Map([])
  let final_ty = match res_ty {
    Some(t) => t
    None => TUnit
  }
  if res_slot == "" {
    Some(qval(qbe_zero_reg(final_ty), final_ty))
  } else {
    let mut r = qbe_load_local_slot(g, res_slot, final_ty)
    if saw_untyped_none {
      r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
    }
    Some(qval(r, final_ty))
  }
}

///|
/// P52-C: Zero-alloc scalarization for `Option` / `Result` methods:
/// `is_some`, `is_none`, `is_ok`, `is_err`, and `unwrap_or(dflt)`.
fn qbe_try_emit_scalar_opt_res_method(
  g : QbeGen,
  obj_expr : Expr,
  method_name : String,
  args : Array[Expr],
) -> Option[QbeVal] {
  let want_kind = if (method_name == "is_some" || method_name == "is_none") &&
    args.length() == 0 {
    1
  } else if (method_name == "is_ok" || method_name == "is_err") &&
    args.length() == 0 {
    2
  } else if method_name == "unwrap_or" && args.length() == 1 {
    0
  } else {
    return None
  }
  // P76: Zero-alloc scalarization for `vmap.get(k).unwrap_or(dflt) | is_some() | is_none()`.
  match obj_expr {
    EMethodCall(map_expr, gm, gargs, gsp) =>
      if gm == "get" && gargs.length() == 1 && !qbe_has_expected_trait(g, gsp) {
        match qbe_peek_expr_ty(g, map_expr) {
          Some(TMap(kty, vty)) =>
            if qbe_is_vmap_key_ty(g, kty) {
              let args_pure = !qbe_expr_has_assign(gargs[0]) &&
                (args.length() == 0 || !qbe_expr_has_assign(args[0]))
              let obj_av = qbe_emit_arg_maybe_borrow(g, map_expr, None, args_pure)
              let m = qbe_ensure_vmap_fns(g, kty, vty)
              let vka = qbe_emit_vmap_key_args(g, gargs[0], kty, args_pure)
              let kstr = qbe_vmap_key_call_args(vka)
              if method_name == "is_some" || method_name == "is_none" {
                let hw = qbe_tmp(g)
                qbe_emit(
                  g,
                  hw + " =w call $pion_vmap_has_" + m + "(l " + obj_av.qv.reg + kstr + ")",
                )
                if !obj_av.borrowed {
                  qbe_emit(g, "call $pion_rc_dec(l " + obj_av.qv.reg + ")")
                }
                let r = qbe_tmp(g)
                if method_name == "is_none" {
                  let nw = qbe_tmp(g)
                  qbe_emit(g, nw + " =w ceqw " + hw + ", 0")
                  qbe_emit(g, r + " =l extuw " + nw)
                } else {
                  qbe_emit(g, r + " =l extuw " + hw)
                }
                return Some(qval(r, TBool))
              }
              let def_is_pure = match args[0] {
                EInt(_, _)
                | EInt64(_, _)
                | EUInt(_, _)
                | EUInt64(_, _)
                | EDouble(_, _)
                | EFloat(_, _)
                | EBool(_, _)
                | EByte(_, _)
                | EChar(_, _)
                | EIdent(_, _) => true
                EUnary("-", inner, _) =>
                  match inner {
                    EInt(_, _) | EInt64(_, _) | EDouble(_, _) | EFloat(_, _) => true
                    _ => false
                  }
                _ => false
              }
              if !qbe_is_obj_ty(g, vty) && def_is_pure {
                let _ = qbe_ensure_vmap_get_or_fn(g, kty, vty)
                let dv = qbe_emit_expr(g, args[0], Some(vty))
                let dc = qbe_coerce_val(g, dv, vty)
                let vabi = qbe_abi_ty(vty)
                let res = qbe_tmp(g)
                qbe_emit(
                  g,
                  res +
                  " =" +
                  vabi +
                  " call $pion_vmap_get_or_" +
                  m +
                  "(l " +
                  obj_av.qv.reg +
                  kstr +
                  ", " +
                  vabi +
                  " " +
                  dc +
                  ")",
                )
                if !obj_av.borrowed {
                  qbe_emit(g, "call $pion_rc_dec(l " + obj_av.qv.reg + ")")
                }
                return Some(qval(res, vty))
              }
              let out_slot = qbe_alloc_slot(g)
              let hw = qbe_tmp(g)
              qbe_emit(
                g,
                hw + " =w call $pion_vmap_try_get_" + m + "(l " + obj_av.qv.reg + kstr + ", l " + out_slot + ")",
              )
              let mut hit_own_slot = ""
              if qbe_is_obj_ty(g, vty) {
                qbe_scope_push(g)
                let hit_tmp_name = "$__vmu_hit_own_" + g.next_tmp.to_string()
                g.next_tmp = g.next_tmp + 1
                let hit_loc = qbe_define_local(g, hit_tmp_name, vty, true)
                hit_own_slot = hit_loc.slot
                qbe_emit(g, "storel 0, " + hit_own_slot)
                let l_ret = qbe_lbl(g, "vmu_ret")
                let l_aret = qbe_lbl(g, "vmu_aret")
                qbe_emit_term(g, "jnz " + hw + ", " + l_ret + ", " + l_aret)
                qbe_emit_lbl(g, l_ret)
                let ret_l = qbe_tmp(g)
                qbe_emit(g, ret_l + " =l loadl " + out_slot)
                qbe_rc_inc(g, ret_l, vty)
                qbe_emit(g, "storel " + ret_l + ", " + hit_own_slot)
                qbe_emit_term(g, "jmp " + l_aret)
                qbe_emit_lbl(g, l_aret)
              }
              if !obj_av.borrowed {
                qbe_emit(g, "call $pion_rc_dec(l " + obj_av.qv.reg + ")")
              }
              let dv = qbe_emit_expr(g, args[0], Some(vty))
              if g.block_term {
                if hit_own_slot != "" {
                  qbe_scope_pop(g)
                }
                return Some(qval("0", TNever))
              }
              let dc = qbe_coerce_val(g, dv, vty)
              let res_slot = qbe_alloc_slot_for(g, vty)
              let l_hit = qbe_lbl(g, "vmu_hit")
              let l_def = qbe_lbl(g, "vmu_def")
              let l_end = qbe_lbl(g, "vmu_end")
              qbe_emit_term(g, "jnz " + hw + ", " + l_hit + ", " + l_def)
              qbe_emit_lbl(g, l_hit)
              let raw_l = qbe_tmp(g)
              if hit_own_slot != "" {
                qbe_emit(g, raw_l + " =l loadl " + hit_own_slot)
                qbe_emit(g, "storel 0, " + hit_own_slot)
              } else {
                qbe_emit(g, raw_l + " =l loadl " + out_slot)
              }
              let vv = qbe_from_l(g, raw_l, vty)
              qbe_store_local_slot(g, vv, res_slot, vty)
              qbe_rc_dec(g, dc, vty)
              qbe_emit_term(g, "jmp " + l_end)
              qbe_emit_lbl(g, l_def)
              qbe_store_local_slot(g, dc, res_slot, vty)
              qbe_emit_term(g, "jmp " + l_end)
              qbe_emit_lbl(g, l_end)
              if hit_own_slot != "" {
                g.zeroed_slots.set(hit_own_slot, true)
                qbe_scope_pop(g)
              }
              return Some(qval(qbe_load_local_slot(g, res_slot, vty), vty))
            }
          _ => ()
        }
      }
    _ => ()
  }
  let allow_pod_ok = method_name != "unwrap_or"
  let sc = match qbe_try_emit_opt_res_scalarized(g, obj_expr, want_kind, allow_pod_ok) {
    Some(s) => s
    None => return None
  }
  if g.block_term {
    return Some(qval("0", TNever))
  }
  let ok_ty = match sc.ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return None
  }
  let err_ty_opt : Option[Ty] = match sc.ret_ty {
    TResult(_, et) => Some(et)
    _ => None
  }
  if method_name == "unwrap_or" {
    let dv = qbe_emit_expr(g, args[0], Some(ok_ty))
    if g.block_term {
      return Some(qval("0", TNever))
    }
    let dc = qbe_coerce_val(g, dv, ok_ty)
    let tag_w = qbe_tmp(g)
    qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
    let res_slot = qbe_alloc_slot_for(g, ok_ty)
    let l_ok = qbe_lbl(g, "scu_ok")
    let l_def = qbe_lbl(g, "scu_def")
    let l_end = qbe_lbl(g, "scu_end")
    qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_def)
    qbe_emit_lbl(g, l_ok)
    let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
    qbe_store_local_slot(g, v_ok, res_slot, ok_ty)
    qbe_rc_dec(g, dc, ok_ty)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_def)
    match err_ty_opt {
      Some(err_ty) =>
        if qbe_is_obj_ty(g, err_ty) {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          qbe_rc_dec(g, v_err, err_ty)
        }
      None => ()
    }
    qbe_store_local_slot(g, dc, res_slot, ok_ty)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let r = qbe_load_local_slot(g, res_slot, ok_ty)
    return Some(qval(r, ok_ty))
  }
  // `is_some` / `is_none` / `is_ok` / `is_err`
  let want_true_on_ok = method_name == "is_some" || method_name == "is_ok"
  let ok_is_obj = !sc.val_is_pod_buf && qbe_is_obj_ty(g, ok_ty)
  let err_is_obj = match err_ty_opt {
    Some(et) => qbe_is_obj_ty(g, et)
    None => false
  }
  let tag_w = qbe_tmp(g)
  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
  if ok_is_obj || err_is_obj {
    let l_ok = qbe_lbl(g, "scis_ok")
    let l_err = qbe_lbl(g, "scis_err")
    let l_end = qbe_lbl(g, "scis_end")
    qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    if ok_is_obj {
      let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
      qbe_rc_dec(g, v_ok, ok_ty)
    }
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    match err_ty_opt {
      Some(err_ty) =>
        if err_is_obj {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          qbe_rc_dec(g, v_err, err_ty)
        }
      None => ()
    }
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
  }
  let res_l = qbe_tmp(g)
  if want_true_on_ok {
    qbe_emit(g, res_l + " =l extuw " + tag_w)
  } else {
    let inv = qbe_tmp(g)
    qbe_emit(g, inv + " =w ceqw " + tag_w + ", 0")
    qbe_emit(g, res_l + " =l extuw " + inv)
  }
  Some(qval(res_l, TBool))
}

///|
struct QbeScalarIsPat {
  want_kind : Int
  want_tag : Int
  bind_name : String
}

///|
fn qbe_parse_scalar_is_pat(pat : Pattern) -> Option[QbeScalarIsPat] {
  match pat {
    PVariant(_, "Some", sub, _, _) =>
      if sub.length() == 1 {
        match sub[0] {
          PIdent(b, _) =>
            Some(QbeScalarIsPat::{ want_kind: 1, want_tag: 1, bind_name: b })
          PWild(_) =>
            Some(QbeScalarIsPat::{ want_kind: 1, want_tag: 1, bind_name: "" })
          _ => None
        }
      } else {
        None
      }
    PVariant(_, "None", sub, _, _) =>
      if sub.length() == 0 {
        Some(QbeScalarIsPat::{ want_kind: 1, want_tag: 0, bind_name: "" })
      } else {
        None
      }
    PVariant(_, "Ok", sub, _, _) =>
      if sub.length() == 1 {
        match sub[0] {
          PIdent(b, _) =>
            Some(QbeScalarIsPat::{ want_kind: 2, want_tag: 1, bind_name: b })
          PWild(_) =>
            Some(QbeScalarIsPat::{ want_kind: 2, want_tag: 1, bind_name: "" })
          _ => None
        }
      } else {
        None
      }
    PVariant(_, "Err", sub, _, _) =>
      if sub.length() == 1 {
        match sub[0] {
          PIdent(b, _) =>
            Some(QbeScalarIsPat::{ want_kind: 2, want_tag: 0, bind_name: b })
          PWild(_) =>
            Some(QbeScalarIsPat::{ want_kind: 2, want_tag: 0, bind_name: "" })
          _ => None
        }
      } else {
        None
      }
    _ => None
  }
}

///|
fn qbe_try_emit_scalar_is_branch(
  g : QbeGen,
  scrut : Expr,
  pat : Pattern,
  l_true : String,
  l_false : String,
  pod_bind_ok : Bool,
) -> Bool {
  let sp = match qbe_parse_scalar_is_pat(pat) {
    Some(p) => p
    None => return false
  }
  let allow_pod_ok = sp.want_tag != 1 || sp.bind_name == "" || pod_bind_ok
  let sc = match qbe_try_emit_opt_res_scalarized(g, scrut, sp.want_kind, allow_pod_ok) {
    Some(s) => s
    None => return false
  }
  if g.block_term {
    return true
  }
  let ok_ty = match sc.ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return false
  }
  let err_ty_opt : Option[Ty] = match sc.ret_ty {
    TResult(_, et) => Some(et)
    _ => None
  }
  let ok_is_obj = !sc.val_is_pod_buf && qbe_is_obj_ty(g, ok_ty)
  let err_is_obj = match err_ty_opt {
    Some(et) => qbe_is_obj_ty(g, et)
    None => false
  }
  let tag_w = qbe_tmp(g)
  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
  let l_tag1 = qbe_lbl(g, "scib_t1")
  let l_tag0 = qbe_lbl(g, "scib_t0")
  qbe_emit_term(g, "jnz " + tag_w + ", " + l_tag1 + ", " + l_tag0)
  qbe_emit_lbl(g, l_tag1)
  if sp.want_tag == 1 {
    if sp.bind_name != "" {
      if sc.val_is_pod_buf {
        let loc = qbe_define_local(g, sp.bind_name, ok_ty, false)
        let pv = qbe_pod_buf_val(g, sc.val_slot, ok_ty)
        qbe_emit(g, "storel " + pv + ", " + loc.slot)
      } else {
        let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
        let loc = qbe_define_local(g, sp.bind_name, ok_ty, true)
        qbe_store_local_slot(g, v_ok, loc.slot, ok_ty)
      }
    } else if ok_is_obj {
      let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
      qbe_rc_dec(g, v_ok, ok_ty)
    }
    qbe_emit_term(g, "jmp " + l_true)
  } else {
    if ok_is_obj {
      let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
      qbe_rc_dec(g, v_ok, ok_ty)
    }
    qbe_emit_term(g, "jmp " + l_false)
  }
  qbe_emit_lbl(g, l_tag0)
  if sp.want_tag == 0 {
    match err_ty_opt {
      Some(err_ty) =>
        if sp.bind_name != "" {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          let loc = qbe_define_local(g, sp.bind_name, err_ty, true)
          qbe_store_local_slot(g, v_err, loc.slot, err_ty)
        } else if err_is_obj {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          qbe_rc_dec(g, v_err, err_ty)
        }
      None => ()
    }
    qbe_emit_term(g, "jmp " + l_true)
  } else {
    match err_ty_opt {
      Some(err_ty) =>
        if err_is_obj {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          qbe_rc_dec(g, v_err, err_ty)
        }
      None => ()
    }
    qbe_emit_term(g, "jmp " + l_false)
  }
  true
}

///|
fn qbe_try_emit_scalar_is_expr(
  g : QbeGen,
  scrut : Expr,
  pat : Pattern,
) -> Option[QbeVal] {
  let sp = match qbe_parse_scalar_is_pat(pat) {
    Some(p) => p
    None => return None
  }
  let sc = match qbe_try_emit_opt_res_scalarized(g, scrut, sp.want_kind, true) {
    Some(s) => s
    None => return None
  }
  if g.block_term {
    return Some(qval("0", TNever))
  }
  let ok_ty = match sc.ret_ty {
    TOption(inner) => inner
    TResult(ot, _) => ot
    _ => return None
  }
  let err_ty_opt : Option[Ty] = match sc.ret_ty {
    TResult(_, et) => Some(et)
    _ => None
  }
  let ok_is_obj = !sc.val_is_pod_buf && qbe_is_obj_ty(g, ok_ty)
  let err_is_obj = match err_ty_opt {
    Some(et) => qbe_is_obj_ty(g, et)
    None => false
  }
  let tag_w = qbe_tmp(g)
  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
  if ok_is_obj || err_is_obj {
    let l_ok = qbe_lbl(g, "scie_ok")
    let l_err = qbe_lbl(g, "scie_err")
    let l_end = qbe_lbl(g, "scie_end")
    qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    if ok_is_obj {
      let v_ok = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
      qbe_rc_dec(g, v_ok, ok_ty)
    }
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    match err_ty_opt {
      Some(err_ty) =>
        if err_is_obj {
          let v_err = qbe_load_heap_slot(g, sc.err_slot, err_ty)
          qbe_rc_dec(g, v_err, err_ty)
        }
      None => ()
    }
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
  }
  let res_l = qbe_tmp(g)
  if sp.want_tag == 1 {
    qbe_emit(g, res_l + " =l extuw " + tag_w)
  } else {
    let inv = qbe_tmp(g)
    qbe_emit(g, inv + " =w ceqw " + tag_w + ", 0")
    qbe_emit(g, res_l + " =l extuw " + inv)
  }
  Some(qval(res_l, TBool))
}

///|
/// P74-D: Returns true when the target backend natively implements IEEE-754
/// saturating float-to-int conversion (ARM64 `fcvtzs`/`fcvtzu`, Wasm32 `trunc_sat`).
fn qbe_target_has_hw_sat_ftoi(g : QbeGen) -> Bool {
  g.target_wasm ||
  g.target_name == "wasm32" ||
  g.target_name == "arm64_apple" ||
  g.target_name == "arm64" ||
  g.target_name == "ios_arm64" ||
  g.target_name == "ios_sim_arm64" ||
  g.target_name == "android_arm64"
}

///|
/// P74-D: Emit cross-platform IEEE-754 saturating float-to-int conversion.
/// On ARM64 and Wasm32 this is a single `dtosi`/`dtoui`/`stosi`/`stoui` instruction;
/// on x86_64 (and unspecified native targets) an inline NaN/range clamp precedes it.
///|
fn qbe_emit_validate_char_scalar(
  g : QbeGen,
  cp_l : String,
  extra_bad_w : String,
) -> String {
  let hi = qbe_tmp(g)
  let sh = qbe_tmp(g)
  let surr = qbe_tmp(g)
  let bad0 = qbe_tmp(g)
  qbe_emit(g, hi + " =w cugtl " + cp_l + ", 1114111")
  qbe_emit(g, sh + " =l shr " + cp_l + ", 11")
  qbe_emit(g, surr + " =w ceql " + sh + ", 27")
  qbe_emit(g, bad0 + " =w or " + hi + ", " + surr)
  let bad = if extra_bad_w != "" {
    let b = qbe_tmp(g)
    qbe_emit(g, b + " =w or " + bad0 + ", " + extra_bad_w)
    b
  } else {
    bad0
  }
  let lbl_bad = qbe_lbl(g, "char_bad")
  let lbl_ok = qbe_lbl(g, "char_ok")
  let lbl_done = qbe_lbl(g, "char_done")
  qbe_emit_term(g, "jnz " + bad + ", " + lbl_bad + ", " + lbl_ok)
  qbe_emit_lbl(g, lbl_ok)
  qbe_emit_term(g, "jmp " + lbl_done)
  qbe_emit_lbl(g, lbl_bad)
  qbe_emit_term(g, "jmp " + lbl_done)
  qbe_emit_lbl(g, lbl_done)
  let res = qbe_tmp(g)
  qbe_emit(g, res + " =l phi " + lbl_ok + " " + cp_l + ", " + lbl_bad + " 65533")
  res
}

fn qbe_emit_flt_to_int_sat(
  g : QbeGen,
  reg : String,
  from_f64 : Bool,
  to_i64 : Bool,
  is_unsigned : Bool,
) -> String {
  let dst_abi = if to_i64 { "l" } else { "w" }
  let op = if from_f64 {
    if is_unsigned { "dtoui" } else { "dtosi" }
  } else if is_unsigned {
    "stoui"
  } else {
    "stosi"
  }
  if qbe_target_has_hw_sat_ftoi(g) {
    let res = qbe_tmp(g)
    qbe_emit(g, res + " =" + dst_abi + " " + op + " " + reg)
    return res
  }
  let f_abi = if from_f64 { "d" } else { "s" }
  let b_abi = if from_f64 { "l" } else { "w" }
  let cgt = if from_f64 { "cgtd" } else { "cgts" }
  let cge = if from_f64 { "cged" } else { "cges" }
  let cle = if from_f64 { "cled" } else { "cles" }
  let ceq = if from_f64 { "ceqd" } else { "ceqs" }
  if is_unsigned {
    let zero_bits = qbe_tmp(g)
    let zero_flt = qbe_tmp(g)
    let is_pos = qbe_tmp(g)
    let l_pos = qbe_lbl(g, "ftoi_pos")
    let l_zero = qbe_lbl(g, "ftoi_zero")
    let l_hi = qbe_lbl(g, "ftoi_hi")
    let l_conv = qbe_lbl(g, "ftoi_conv")
    let l_end = qbe_lbl(g, "ftoi_end")
    qbe_emit(g, zero_bits + " =" + b_abi + " copy 0")
    qbe_emit(g, zero_flt + " =" + f_abi + " cast " + zero_bits)
    qbe_emit(g, is_pos + " =w " + cgt + " " + reg + ", " + zero_flt)
    qbe_emit(g, "jnz " + is_pos + ", " + l_pos + ", " + l_zero)
    qbe_emit_lbl(g, l_pos)
    let hi_bits_lit = if from_f64 {
      if to_i64 { "4895412794951729152" } else { "4751297606875873280" }
    } else if to_i64 {
      "1602224128"
    } else {
      "1333788672"
    }
    let hi_bits = qbe_tmp(g)
    let hi_flt = qbe_tmp(g)
    let is_hi = qbe_tmp(g)
    qbe_emit(g, hi_bits + " =" + b_abi + " copy " + hi_bits_lit)
    qbe_emit(g, hi_flt + " =" + f_abi + " cast " + hi_bits)
    qbe_emit(g, is_hi + " =w " + cge + " " + reg + ", " + hi_flt)
    qbe_emit(g, "jnz " + is_hi + ", " + l_hi + ", " + l_conv)
    qbe_emit_lbl(g, l_conv)
    let cv = qbe_tmp(g)
    qbe_emit(g, cv + " =" + dst_abi + " " + op + " " + reg)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_zero)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_hi)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let res = qbe_tmp(g)
    qbe_emit(
      g,
      res + " =" + dst_abi + " phi " + l_zero + " 0, " + l_hi + " -1, " + l_conv + " " + cv,
    )
    res
  } else {
    let is_ord = qbe_tmp(g)
    let l_ord = qbe_lbl(g, "ftoi_ord")
    let l_nan = qbe_lbl(g, "ftoi_nan")
    let l_chk_hi = qbe_lbl(g, "ftoi_hi_chk")
    let l_lo = qbe_lbl(g, "ftoi_lo")
    let l_hi = qbe_lbl(g, "ftoi_hi")
    let l_conv = qbe_lbl(g, "ftoi_conv")
    let l_end = qbe_lbl(g, "ftoi_end")
    qbe_emit(g, is_ord + " =w " + ceq + " " + reg + ", " + reg)
    qbe_emit(g, "jnz " + is_ord + ", " + l_ord + ", " + l_nan)
    qbe_emit_lbl(g, l_ord)
    let lo_bits_lit = if from_f64 {
      if to_i64 { "-4332462841530417152" } else { "-4476578029606273024" }
    } else if to_i64 {
      "-553648128"
    } else {
      "-822083584"
    }
    let lo_bits = qbe_tmp(g)
    let lo_flt = qbe_tmp(g)
    let is_lo = qbe_tmp(g)
    qbe_emit(g, lo_bits + " =" + b_abi + " copy " + lo_bits_lit)
    qbe_emit(g, lo_flt + " =" + f_abi + " cast " + lo_bits)
    qbe_emit(g, is_lo + " =w " + cle + " " + reg + ", " + lo_flt)
    qbe_emit(g, "jnz " + is_lo + ", " + l_lo + ", " + l_chk_hi)
    qbe_emit_lbl(g, l_chk_hi)
    let hi_bits_lit = if from_f64 {
      if to_i64 { "4890909195324358656" } else { "4746794007248502784" }
    } else if to_i64 {
      "1593835520"
    } else {
      "1325400064"
    }
    let hi_bits = qbe_tmp(g)
    let hi_flt = qbe_tmp(g)
    let is_hi = qbe_tmp(g)
    qbe_emit(g, hi_bits + " =" + b_abi + " copy " + hi_bits_lit)
    qbe_emit(g, hi_flt + " =" + f_abi + " cast " + hi_bits)
    qbe_emit(g, is_hi + " =w " + cge + " " + reg + ", " + hi_flt)
    qbe_emit(g, "jnz " + is_hi + ", " + l_hi + ", " + l_conv)
    qbe_emit_lbl(g, l_conv)
    let cv = qbe_tmp(g)
    qbe_emit(g, cv + " =" + dst_abi + " " + op + " " + reg)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_nan)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_lo)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_hi)
    qbe_emit(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let lo_int = if to_i64 { "-9223372036854775808" } else { "-2147483648" }
    let hi_int = if to_i64 { "9223372036854775807" } else { "2147483647" }
    let res = qbe_tmp(g)
    qbe_emit(
      g,
      res + " =" + dst_abi + " phi " + l_nan + " 0, " + l_lo + " " + lo_int + ", " + l_hi + " " + hi_int + ", " + l_conv + " " + cv,
    )
    res
  }
}

///|
fn qbe_new(tc : TypeChecker, release : Bool, unit_mode : Bool) -> QbeGen {
  qbe_new_for_target_name(tc, release, unit_mode, false, "")
}

///|
fn qbe_new_for_target(
  tc : TypeChecker,
  release : Bool,
  unit_mode : Bool,
  target_wasm : Bool,
) -> QbeGen {
  qbe_new_for_target_name(
    tc,
    release,
    unit_mode,
    target_wasm,
    if target_wasm { "wasm32" } else { "" },
  )
}

///|
fn qbe_new_for_target_name(
  tc : TypeChecker,
  release : Bool,
  unit_mode : Bool,
  target_wasm : Bool,
  target_name : String,
) -> QbeGen {
  QbeGen::{
    tc: tc,
    release: release,
    unit_mode: unit_mode,
    target_wasm: target_wasm,
    target_name: target_name,
    export_internals: false,
    pkg_prefix: qbe_pkg_prefix_for(tc.pkg_name, tc.multi_pkg),
    enum_order: [],
    const_order: [],
    const_int_vals: Map([]),
    const_i64_vals: Map([]),
    const_bool_vals: Map([]),
    global_min_len_arrs: Map([]),
    fixed_literal_lengths: Map([]),
    freeze_fn_seen: Map([]),
    vmap_seen: Map([]),
    vmap_get_or_seen: Map([]),
    eq_fn_seen: Map([]),
    strings: [],
    string_ids: Map([]),
    cstrings: [],
    cstring_ids: Map([]),
    enum_consts: [],
    enum_const_seen: Map([]),
    slot_drop_keys: [],
    slot_drop_specs: [],
    slot_drop_seen: Map([]),
    fn_wrappers: [],
    fn_wrapper_seen: Map([]),
    dyn_vtable_seen: Map([]),
    i32_literal_tables: [],
    i32_literal_next_id: 0,
    entry_symbol: "",
    extern_c_syms: None,
    ret_default_methods: None,
    dyn_vtables: [],
    extra_fns: [],
    mono_seen: Map([]),
    mono_queue: [],
    mono_emitted: 0,
    mono_pkg: "",
    generic_meth_indexed_pkgs: Map([]),
    generic_meth_index: Map([]),
    generic_scan_done: Map([]),
    generic_scan_count: 0,
    generic_has_eq: Map([]),
    generic_has_arith: Map([]),
    generic_rev_edges: Map([]),
    inline_fns: Map([]),
    inline_fn_costs: Map([]),
    inline_fn_file: Map([]),
    hof_inline_fns: Map([]),
    hof_inline_fn_file: Map([]),
    inline_closures: Map([]),
    inline_ret_lbl: "",
    inline_ret_tag_slot: "",
    inline_ret_err_slot: "",
    inline_ret_pod_buf: false,
    inline_ret_slot: "",
    inline_ret_ty: TUnit,
    inline_ret_scope_depth: 0,
    lookup_scope_floor: 0,
    tco_fn_name: "",
    tco_mode: 0,
    tco_loop_lbl: "",
    tco_acc_slot: "",
    tco_param_slots: [],
    tco_param_tys: [],
    tco_base_scope_depth: 0,
    tco_borrowed_roots: [],
    cur_file_idx: -1,
    inline_depth: 0,
    inline_stack: [],
    hoisted_arr_len: Map([]),
    hoisted_arr_dp: Map([]),
    hoisted_str_len: Map([]),
    hoisted_str_dp: Map([]),
    hoisted_bytes_len: Map([]),
    hoisted_bytes_dp: Map([]),
    hoisted_fields: Map([]),
    block_immut_fields: Map([]),
    len_aliases: Map([]),
    len_alias_keys: [],
    nonneg_vars: Map([]),
    u8_range_vars: Map([]),
    known_min_len_arrs: Map([]),
    known_writable_bytes: Map([]),
    bce_safe_indices: Map([]),
    bce_safe_exprs: Map([]),
    bce_safe_push_arrs: Map([]),
    movable_locals: Map([]),
    moved_slots: Map([]),
    zeroed_slots: Map([]),
    immortal_regs: Map([]),
    immortal_slots: Map([]),
    cur_lbl: "@start",
    sq_reuse_slot: Map([]),
    sq_reuse_state: Map([]),
    promoted_fields: Map([]),
    promoted_field_tys: Map([]),
    promoted_push_len: Map([]),
    promoted_push_cap: Map([]),
    promoted_push_dp: Map([]),
    w_to_l_ext: Map([]),
    local_w_to_l_ext: Map([]),
    unfrozen_local_arrs: Map([]),
    stack_view_slots: Map([]),
    pinned_slots: Map([]),
    borrow_owner_slot: Map([]),
    borrow_owner_name: Map([]),
    mut_local_slots: Map([]),
    j2_disable_mask: 0,
    pod_borrow_cache: Map([]),
    assign_idx_arr: "",
    assign_idx_key: "",
    assign_idx_ep: "",
    next_tmp: 0,
    next_lbl: 0,
    next_clo: 0,
    fn_start_tmp: 0,
    fn_start_lbl: 0,
    fn_inlined_cost: 0,
    fn_cleanup_enabled: false,
    fn_ret_slot: "",
    fn_ret_epi_lbl: "",
    fn_cleanup_pads: Map([]),
    fn_cleanup_nodes: [],
    fn_allocs: StringBuilder(),
    fn_body: StringBuilder(),
    scopes: [],
    loop_breaks: [],
    loop_conts: [],
    loop_depths: [],
    hot_loop_depth: 0,
    nested_add_part: false,
    cur_tparams: [],
    live_tparams: [],
    cur_type_subst: Map([]),
    lexical_type_subst: Map([]),
    cur_ret_ty: TUnit,
    cur_ret_abi_ty: TUnit,
    cur_fn_void: false,
    block_term: false,
    boxed_mut_vars: Map([]),
    need_none_const: false,
    need_drop_opt_obj: false,
    need_drop_res_ok: false,
    need_drop_res_err: false,
    need_drop_dyn: false,
    in_verify: false,
    verify_sp: span_new("", 0, 0),
    mut_wb_seq: 0,
  }
}

///|
fn qbe_tmp(g : QbeGen) -> String {
  let id = g.next_tmp
  g.next_tmp = id + 1
  "%t" + id.to_string()
}

///|
fn qbe_lbl(g : QbeGen, prefix : String) -> String {
  let id = g.next_lbl
  g.next_lbl = id + 1
  "@" + prefix + "_" + id.to_string()
}

///|
fn qbe_emit(g : QbeGen, line : String) -> Unit {
  if !g.block_term {
    g.fn_body.write_string(" ")
    g.fn_body.write_string(line)
    g.fn_body.write_string("\n")
  }
}

///|
fn qbe_emit_term(g : QbeGen, line : String) -> Unit {
  if !g.block_term {
    g.fn_body.write_string(" ")
    g.fn_body.write_string(line)
    g.fn_body.write_string("\n")
    g.block_term = true
  }
}

///|
fn qbe_emit_lbl(g : QbeGen, lbl : String) -> Unit {
  g.fn_body.write_string(lbl)
  g.fn_body.write_string("\n")
  g.cur_lbl = lbl
  g.block_term = false
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_alloc_slot(g : QbeGen) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string(" ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string(" =l alloc8 8\n storel 0, ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_alloc_slot_for(g : QbeGen, ty : Ty) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string(" ")
  g.fn_allocs.write_string(s)
  if qbe_is_double_ty(ty) {
    g.fn_allocs.write_string(" =l alloc8 8\n stored d_0.0, ")
  } else if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    g.fn_allocs.write_string(" =l alloc4 4\n storew 0, ")
  } else {
    g.fn_allocs.write_string(" =l alloc8 8\n storel 0, ")
  }
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_alloc_slot_for_uninit(g : QbeGen, ty : Ty) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string(" ")
  g.fn_allocs.write_string(s)
  if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    g.fn_allocs.write_string(" =l alloc4 4\n")
  } else {
    g.fn_allocs.write_string(" =l alloc8 8\n")
  }
  s
}

///|
fn qbe_alloc_slot4(g : QbeGen) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string(" ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string(" =l alloc4 4\n storew 0, ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_alloc_stack_buf(g : QbeGen, bytes : Int) -> String {
  qbe_alloc_immortal_stack_buf(g, bytes, 4)
}

///|
fn qbe_intern_string(g : QbeGen, s : String) -> Int {
  match g.string_ids.get(s) {
    Some(id) => id
    None => {
      let id = g.strings.length()
      g.strings.push(s)
      g.string_ids.set(s, id)
      id
    }
  }
}

///|
fn qbe_intern_cstring(g : QbeGen, s : String) -> Int {
  match g.cstring_ids.get(s) {
    Some(id) => id
    None => {
      let id = g.cstrings.length()
      g.cstrings.push(s)
      g.cstring_ids.set(s, id)
      id
    }
  }
}

///|
fn qbe_norm_path_components(s : String) -> String {
  let raw = StringBuilder()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 92 {
      raw.write_byte(b'/')
    } else {
      raw.write_byte(c.to_byte())
    }
    i = i + 1
  }
  let p = raw.to_string()
  let pn = p.length()
  let mut root = ""
  let mut start = 0
  if pn >= 3 && p.code_unit_at(1) == 58 && p.code_unit_at(2) == 47 {
    root = p.slice(0, 3)
    start = 3
  } else if pn >= 1 && p.code_unit_at(0) == 47 {
    root = "/"
    start = 1
  }
  let segs : Array[String] = []
  let mut pos = start
  while pos <= pn {
    let mut end = pos
    while end < pn && p.code_unit_at(end) != 47 {
      end = end + 1
    }
    let seg = p.slice(pos, end)
    if seg.length() == 0 || seg == "." {
      ()
    } else if seg == ".." {
      if segs.length() > 0 && segs[segs.length() - 1] != ".." {
        let _ = segs.pop()
      } else if root.length() == 0 {
        segs.push("..")
      }
    } else {
      segs.push(seg)
    }
    pos = end + 1
  }
  let out = StringBuilder()
  out.write_string(root)
  let mut k = 0
  while k < segs.length() {
    if k > 0 {
      out.write_byte(b'/')
    }
    out.write_string(segs[k])
    k = k + 1
  }
  out.to_string()
}

///|
fn qbe_find_last_substr(hay : String, needle : String) -> Int {
  let hn = hay.length()
  let nn = needle.length()
  if nn == 0 || nn > hn {
    return -1
  }
  let mut i = hn - nn
  while i >= 0 {
    let mut j = 0
    let mut ok = true
    while j < nn {
      if hay.code_unit_at(i + j) != needle.code_unit_at(j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i - 1
  }
  -1
}

///|
fn qbe_strip_canon_hash(pkg_name : String) -> String {
  let n = pkg_name.length()
  if n > 10 && pkg_name.code_unit_at(n - 10) == 95 && pkg_name.code_unit_at(n - 9) == 95 {
    let mut all_hex = true
    let mut i = n - 8
    while i < n {
      let c = pkg_name.code_unit_at(i)
      if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
        all_hex = false
        break
      }
      i = i + 1
    }
    if all_hex {
      return pkg_name.slice(0, n - 10)
    }
  }
  pkg_name
}

///|
fn qbe_sanitize_source_path(g : QbeGen, raw_path : String) -> String {
  let mut pkg_name = g.tc.pkg_name
  let mut pkg_root = g.tc.pkg_root
  let mut pkg_cwd = g.tc.pkg_cwd
  let mut is_pkg = g.tc.multi_pkg || pkg_root.length() > 0
  if g.mono_pkg.length() > 0 {
    match g.tc.all_imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) => {
        pkg_name = ipkg.name
        pkg_root = ipkg.tc.pkg_root
        pkg_cwd = ipkg.tc.pkg_cwd
        is_pkg = true
      }
      None =>
        match g.tc.imported_pkgs.get(g.mono_pkg) {
          Some(ipkg) => {
            pkg_name = ipkg.name
            pkg_root = ipkg.tc.pkg_root
            pkg_cwd = ipkg.tc.pkg_cwd
            is_pkg = true
          }
          None => ()
        }
    }
  }
  let display_pkg = qbe_strip_canon_hash(pkg_name)
  let mut p = qbe_norm_path_components(raw_path)
  let mut is_abs = (p.length() > 0 && p.code_unit_at(0) == 47) ||
    (p.length() >= 3 && p.code_unit_at(1) == 58 && p.code_unit_at(2) == 47)
  if pkg_root.length() > 0 && !is_abs && pkg_cwd.length() > 0 {
    p = qbe_norm_path_components(pkg_cwd + "/" + raw_path)
    is_abs = (p.length() > 0 && p.code_unit_at(0) == 47) ||
      (p.length() >= 3 && p.code_unit_at(1) == 58 && p.code_unit_at(2) == 47)
  }
  if pkg_root.length() > 0 {
    let mut root = qbe_norm_path_components(pkg_root)
    while root.length() > 1 && root.code_unit_at(root.length() - 1) == 47 {
      root = root.slice(0, root.length() - 1)
    }
    if p.length() > root.length() + 1 &&
      p.starts_with(root) &&
      p.code_unit_at(root.length()) == 47 {
      let rel = p.slice(root.length() + 1, p.length())
      if display_pkg.length() > 0 {
        return display_pkg + "/" + rel
      }
      return rel
    }
  }
  if !is_pkg {
    let last_sl = qbe_find_last_substr(p, "/")
    return if last_sl >= 0 { p.slice(last_sl + 1, p.length()) } else { p }
  }
  if is_abs {
    let src_idx = qbe_find_last_substr(p, "/src/")
    if src_idx >= 0 {
      let rel = p.slice(src_idx + 1, p.length())
      if pkg_name.length() > 0 {
        return pkg_name + "/" + rel
      }
      return rel
    }
    let tests_idx = qbe_find_last_substr(p, "/tests/")
    if tests_idx >= 0 {
      let rel = p.slice(tests_idx + 1, p.length())
      if pkg_name.length() > 0 {
        return pkg_name + "/" + rel
      }
      return rel
    }
    let last_sl = qbe_find_last_substr(p, "/")
    let base = if last_sl >= 0 { p.slice(last_sl + 1, p.length()) } else { p }
    if pkg_name.length() > 0 {
      return pkg_name + "/" + base
    }
    return base
  }
  let mut rel = p
  while rel.starts_with("../") {
    rel = rel.slice(3, rel.length())
  }
  if pkg_name.length() > 0 && !rel.starts_with(pkg_name + "/") {
    return pkg_name + "/" + rel
  }
  rel
}

///|
fn qbe_intern_source_path(g : QbeGen, raw_path : String) -> Int {
  qbe_intern_cstring(g, qbe_sanitize_source_path(g, raw_path))
}

///|
fn qbe_hex_digit_char(n : Int) -> Char {
  let d = n & 15
  if d < 10 {
    (48 + d).unsafe_to_char()
  } else {
    (97 + d - 10).unsafe_to_char()
  }
}

///|
fn qbe_sort_unique_slots(slots : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < slots.length() {
    let v = slots[i]
    if v >= 0 {
      let mut dup = false
      let mut j = 0
      while j < out.length() {
        if out[j] == v {
          dup = true
          break
        }
        j = j + 1
      }
      if !dup {
        out.push(v)
        let mut k = out.length() - 1
        while k > 0 && out[k - 1] > out[k] {
          let tmp = out[k - 1]
          out[k - 1] = out[k]
          out[k] = tmp
          k = k - 1
        }
      }
    }
    i = i + 1
  }
  out
}

///|
fn qbe_slots_canonical_key(sorted : Array[Int]) -> String {
  if sorted.length() == 0 {
    return ""
  }
  let max_slot = sorted[sorted.length() - 1]
  if max_slot < 31 {
    let mut mask = 0
    let mut i = 0
    while i < sorted.length() {
      mask = mask | (1 << sorted[i])
      i = i + 1
    }
    return mask.to_string()
  }
  let n_chunks = max_slot / 16 + 1
  let chunks : Array[Int] = []
  let mut ci = 0
  while ci < n_chunks {
    chunks.push(0)
    ci = ci + 1
  }
  let mut i = 0
  while i < sorted.length() {
    let s = sorted[i]
    let idx = s / 16
    let bit = s % 16
    chunks[idx] = chunks[idx] | (1 << bit)
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("x_")
  ci = n_chunks - 1
  while ci >= 0 {
    let v = chunks[ci]
    sb.write_char(qbe_hex_digit_char((v >> 12) & 15))
    sb.write_char(qbe_hex_digit_char((v >> 8) & 15))
    sb.write_char(qbe_hex_digit_char((v >> 4) & 15))
    sb.write_char(qbe_hex_digit_char(v & 15))
    ci = ci - 1
  }
  sb.to_string()
}

///|
fn qbe_merge_slot_lists(a : Array[Int], b : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < a.length() {
    out.push(a[i])
    i = i + 1
  }
  i = 0
  while i < b.length() {
    out.push(b[i])
    i = i + 1
  }
  out
}

///|
/// The emitted symbol suffix of a canonical slot set, in three disjoint
/// namespaces (`SPEC.md` §4.1.1): the decimal mask for `max_slot <= 30`
/// (Wasm32 P47-A parses it), `x_<hex>` for `31 <= max_slot <= 127` (at most
/// 34 characters), and `w_<idx>` for wider sets, where `idx` is the set's
/// position in this unit's helper table, so symbol length never grows with the
/// slot index (QBE's ELF / Mach-O writers cap symbol names at 1024 bytes).
fn qbe_slot_drop_suffix(sorted : Array[Int], key : String, idx : Int) -> String {
  if sorted[sorted.length() - 1] <= 127 {
    key
  } else {
    "w_" + idx.to_string()
  }
}

///|
fn qbe_register_slot_drop(g : QbeGen, slots : Array[Int]) -> String {
  let sorted = qbe_sort_unique_slots(slots)
  if sorted.length() == 0 {
    return "0"
  }
  let key = qbe_slots_canonical_key(sorted)
  match g.slot_drop_seen.get(key) {
    Some(suffix) => "$pion_drop_slots_" + suffix
    None => {
      let suffix = qbe_slot_drop_suffix(sorted, key, g.slot_drop_keys.length())
      g.slot_drop_seen.set(key, suffix)
      g.slot_drop_keys.push(suffix)
      g.slot_drop_specs.push(sorted)
      "$pion_drop_slots_" + suffix
    }
  }
}

///|
fn qbe_register_fn_wrapper(
  g : QbeGen,
  wrap_sym : String,
  target_sym : String,
  param_tys : Array[Ty],
  ret_ty : Ty,
  tp_flags : Array[String],
  is_extern_c : Bool,
) -> String {
  if !g.fn_wrapper_seen.contains(wrap_sym) {
    g.fn_wrapper_seen.set(wrap_sym, true)
    g.fn_wrappers.push(QbeFnWrapper::{
      wrap_sym: wrap_sym,
      target_sym: target_sym,
      param_tys: param_tys,
      ret_ty: ret_ty,
      tp_flags: tp_flags,
      is_extern_c: is_extern_c,
    })
  }
  wrap_sym
}

///|
fn qbe_emit_extern_fn_value(
  g : QbeGen,
  einfo : ExternFnInfo,
  wrap_kind : String,
  wrap_name : String,
) -> QbeVal {
  let wrap_sym = "$pion_" + g.pkg_prefix + "wrap_" + wrap_kind + "_" + wrap_name
  let wrap = qbe_register_fn_wrapper(
    g,
    wrap_sym,
    "$" + einfo.decl.c_symbol,
    einfo.param_tys,
    einfo.ret_ty,
    [],
    true,
  )
  qbe_alloc_fn_value(g, wrap, [], TFn(einfo.param_tys, einfo.ret_ty))
}

///|
/// A top-level function or static method used as a first-class value: a
/// closure whose code pointer is a `wrap_sym` thunk taking every argument as
/// `l`. A generic target is instantiated from the expected `TFn` (and the
/// enclosing `cur_type_subst`), exactly like a direct call: when that instance
/// needs monomorphization (flat struct arrays, `Option`, `==`, bounds, private
/// cross-package fns) the thunk calls the `__mono_*` symbol with its concrete
/// ABI; otherwise it calls the polymorphic symbol and passes its trailing
/// `%tp_*` object flags, capturing in the env those still live in the
/// enclosing generic.
fn qbe_emit_fn_value(
  g : QbeGen,
  finfo : FnInfo,
  base_sym : String,
  wrap_kind : String,
  wrap_name : String,
  decl_pkg : String,
  expected : Option[Ty],
  sp : Span,
) -> QbeVal {
  // Thunk symbols: `wrap_<kind>_<name>` for a plain target, `wrap_m_<kind>_..`
  // (+ the instance's `__mono_*` suffix) for a monomorphized one and
  // `wrap_tp<flags>_<kind>_..` for a polymorphic one: the three prefixes never
  // overlap, so no user fn name can make two thunks share a symbol.
  let wrap_pre = "$pion_" + g.pkg_prefix + "wrap_"
  let wrap_tail = wrap_kind + "_" + wrap_name
  let tps = finfo.decl.type_params
  let subst : Map[String, Ty] = Map([])
  if tps.length() > 0 {
    // The type checker's final instantiation (`<span>#fnval`, re-checked
    // once the enclosing call fixed every type param) wins over the
    // expected type, which a call may not know yet when it evaluates the
    // value (`use(second, identity(v=xs))`).
    let inst = match qbe_call_infer(g, sp, "#fnval") {
      Some(t) => if ty_has_unresolved(t) { expected } else { Some(t) }
      None => expected
    }
    match inst {
      Some(et) =>
        match subst_ty(et, g.cur_type_subst) {
          TFn(eps, er) => {
            let mut i = 0
            while i < finfo.param_tys.length() && i < eps.length() {
              qbe_unify_tparams(g, finfo.param_tys[i], eps[i], subst)
              i = i + 1
            }
            qbe_unify_tparams(g, finfo.ret_ty, er, subst)
          }
          _ => ()
        }
      None => ()
    }
  }
  let env_regs : Array[String] = []
  if qbe_call_needs_mono(g, finfo, subst, decl_pkg) ||
    (decl_pkg != "" && !finfo.decl.is_pub && tps.length() > 0) {
    let mono = qbe_request_mono(g, base_sym, finfo, subst, decl_pkg)
    let mptys : Array[Ty] = []
    let mut i = 0
    while i < finfo.param_tys.length() {
      mptys.push(subst_ty(finfo.param_tys[i], mono.subst))
      i = i + 1
    }
    let mret = subst_ty(finfo.ret_ty, mono.subst)
    let wrap = qbe_register_fn_wrapper(
      g,
      qbe_mono_fn_sym(wrap_pre + "m_" + wrap_tail, tps, mono.subst),
      mono.sym,
      mptys,
      mret,
      [],
      false,
    )
    return qbe_alloc_fn_value(g, wrap, env_regs, TFn(mptys, mret))
  }
  let flags : Array[String] = []
  let key = StringBuilder()
  key.write_string(wrap_pre)
  if tps.length() > 0 {
    key.write_string("tp")
  }
  let mut tpi = 0
  while tpi < tps.length() {
    let tp_ty = match subst.get(tps[tpi]) {
      Some(t) => t
      None => TError
    }
    let f = qbe_is_obj_flag(g, tp_ty)
    if f == "0" || f == "1" {
      flags.push(f)
      key.write_string(f)
    } else {
      flags.push("env")
      env_regs.push(f)
      key.write_string("e")
    }
    tpi = tpi + 1
  }
  if tps.length() > 0 {
    key.write_string("_")
  }
  key.write_string(wrap_tail)
  let wrap = qbe_register_fn_wrapper(
    g,
    key.to_string(),
    base_sym,
    finfo.param_tys,
    finfo.ret_ty,
    flags,
    false,
  )
  let vptys : Array[Ty] = []
  let mut i = 0
  while i < finfo.param_tys.length() {
    vptys.push(subst_ty(finfo.param_tys[i], subst))
    i = i + 1
  }
  qbe_alloc_fn_value(g, wrap, env_regs, TFn(vptys, subst_ty(finfo.ret_ty, subst)))
}

///|
/// Boxes `wrap` (plus the captured `%tp_*` flags in `env_regs`) as a closure.
fn qbe_alloc_fn_value(
  g : QbeGen,
  wrap : String,
  env_regs : Array[String],
  ty : Ty,
) -> QbeVal {
  let clo = qbe_tmp(g)
  qbe_emit(
    g,
    clo + " =l call $pion_alloc(w " + ((1 + env_regs.length()) * 8).to_string() + ", w 6, l 0)",
  )
  qbe_emit(g, "storel " + wrap + ", " + clo)
  let mut i = 0
  while i < env_regs.length() {
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add " + clo + ", " + ((i + 1) * 8).to_string())
    qbe_emit(g, "storel " + env_regs[i] + ", " + p)
    i = i + 1
  }
  qval(clo, ty)
}

///|
fn qbe_scope_push(g : QbeGen) -> Unit {
  g.scopes.push(QbeScope::{ locals: [] })
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_release_scope_locals(g : QbeGen, sc : QbeScope) -> Unit {
  let mut i = sc.locals.length() - 1
  while i >= 0 {
    let loc = sc.locals[i]
    if loc.ref_slot != "" {
      if !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
        qbe_writeback_ref_local(g, loc)
      }
    } else if loc.owned && !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
      if loc.is_cell {
        let v = qbe_tmp(g)
        qbe_emit(g, v + " =l loadl " + loc.slot)
        qbe_emit(g, "call $pion_rc_dec(l " + v + ")")
      } else {
        match loc.ty {
          TParam(_) => {
            let v = qbe_tmp(g)
            qbe_emit(g, v + " =l loadl " + loc.slot)
            qbe_rc_dec(g, v, loc.ty)
          }
          _ =>
            if qbe_is_obj_ty(g, loc.ty) {
              let v = qbe_tmp(g)
              qbe_emit(g, v + " =l loadl " + loc.slot)
              qbe_emit(g, "call $pion_rc_dec(l " + v + ")")
            }
        }
      }
    }
    i = i - 1
  }
}

///|
fn qbe_scope_pop(g : QbeGen) -> Unit {
  if g.scopes.length() > 0 {
    let sc = g.scopes[g.scopes.length() - 1]
    if !g.block_term {
      qbe_release_scope_locals(g, sc)
    }
    let mut zi = 0
    while zi < sc.locals.length() {
      g.zeroed_slots.remove(sc.locals[zi].slot)
      g.stack_view_slots.remove(sc.locals[zi].slot)
      g.borrow_owner_slot.remove(sc.locals[zi].slot)
      g.borrow_owner_name.remove(sc.locals[zi].slot)
      g.mut_local_slots.remove(sc.locals[zi].slot)
      qbe_clear_shadowed_local_meta(g, sc.locals[zi].name)
      zi = zi + 1
    }
    let _ = g.scopes.pop()
  }
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_release_scopes_down_to(g : QbeGen, target_depth : Int) -> Unit {
  let mut i = g.scopes.length() - 1
  while i >= target_depth {
    qbe_release_scope_locals(g, g.scopes[i])
    i = i - 1
  }
}

///|
fn qbe_scope_pop_meta_only(g : QbeGen) -> Unit {
  if g.scopes.length() > 0 {
    let sc = g.scopes[g.scopes.length() - 1]
    let mut zi = 0
    while zi < sc.locals.length() {
      g.zeroed_slots.remove(sc.locals[zi].slot)
      g.stack_view_slots.remove(sc.locals[zi].slot)
      g.borrow_owner_slot.remove(sc.locals[zi].slot)
      g.borrow_owner_name.remove(sc.locals[zi].slot)
      g.mut_local_slots.remove(sc.locals[zi].slot)
      qbe_clear_shadowed_local_meta(g, sc.locals[zi].name)
      zi = zi + 1
    }
    let _ = g.scopes.pop()
  }
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_fn_cleanup_begin(g : QbeGen, enabled : Bool) -> Unit {
  g.fn_cleanup_enabled = enabled && (g.j2_disable_mask & 16) == 0
  g.fn_ret_slot = ""
  g.fn_ret_epi_lbl = ""
  g.fn_cleanup_pads = Map([])
  g.fn_cleanup_nodes = []
}

///|
fn qbe_collect_shared_cleanup_steps(g : QbeGen) -> Option[Array[(String, Int)]] {
  let steps : Array[(String, Int)] = []
  let mut si = g.scopes.length() - 1
  while si >= 0 {
    let sc = g.scopes[si]
    let mut li = sc.locals.length() - 1
    while li >= 0 {
      let loc = sc.locals[li]
      if loc.ref_slot != "" {
        if !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
          return None
        }
      } else if loc.owned &&
        !g.zeroed_slots.contains(loc.slot) &&
        !g.moved_slots.contains(loc.slot) {
        if loc.is_cell {
          steps.push((loc.slot, 1))
        } else {
          match loc.ty {
            TParam(_) => return None
            _ =>
              if qbe_is_obj_ty(g, loc.ty) {
                steps.push((loc.slot, 0))
              }
          }
        }
      }
      li = li - 1
    }
    si = si - 1
  }
  if steps.length() < 2 {
    None
  } else {
    Some(steps)
  }
}

///|
fn qbe_try_emit_shared_cleanup_exit(g : QbeGen, ret_reg : String) -> Bool {
  if !g.fn_cleanup_enabled ||
    g.block_term ||
    g.inline_ret_lbl != "" ||
    g.tco_mode != 0 {
    return false
  }
  let steps = match qbe_collect_shared_cleanup_steps(g) {
    Some(s) => s
    None => return false
  }
  if g.fn_ret_epi_lbl == "" {
    g.fn_ret_epi_lbl = qbe_lbl(g, "ret_epi")
  }
  if !g.cur_fn_void {
    if g.fn_ret_slot == "" {
      let s = qbe_tmp(g)
      g.fn_allocs.write_string(" ")
      g.fn_allocs.write_string(s)
      g.fn_allocs.write_string(" =l alloc8 8\n")
      g.fn_ret_slot = s
    }
    let abi = qbe_abi_ty(g.cur_ret_abi_ty)
    qbe_emit(g, "store" + abi + " " + ret_reg + ", " + g.fn_ret_slot)
  }
  let mut next_lbl = g.fn_ret_epi_lbl
  let mut depth = 1
  let mut i = steps.length() - 1
  while i >= 0 {
    let (slot, kind) = steps[i]
    let sig = (if kind == 1 { "c:" } else { "o:" }) + slot + "->" + next_lbl
    match g.fn_cleanup_pads.get(sig) {
      Some(existing_lbl) => next_lbl = existing_lbl
      None => {
        let lbl = qbe_lbl(g, "cln")
        let ord = g.fn_cleanup_nodes.length()
        g.fn_cleanup_pads.set(sig, lbl)
        g.fn_cleanup_nodes.push(
          QbeCleanupNode::{
            lbl: lbl,
            depth: depth,
            slot: slot,
            next_lbl: next_lbl,
            order: ord,
          },
        )
        next_lbl = lbl
      }
    }
    depth = depth + 1
    i = i - 1
  }
  qbe_emit_term(g, "jmp " + next_lbl)
  true
}

///|
fn qbe_fn_cleanup_flush(g : QbeGen) -> Unit {
  if g.fn_ret_epi_lbl == "" && g.fn_cleanup_nodes.length() == 0 {
    return
  }
  if !g.block_term {
    qbe_emit_term(g, "hlt")
  }
  let nodes = g.fn_cleanup_nodes
  let n = nodes.length()
  let mut max_depth = 0
  let mut i = 0
  while i < n {
    if nodes[i].depth > max_depth {
      max_depth = nodes[i].depth
    }
    i = i + 1
  }
  let buckets : Array[Array[QbeCleanupNode]] = []
  let mut d = 0
  while d <= max_depth {
    buckets.push([])
    d = d + 1
  }
  i = 0
  while i < n {
    let node = nodes[i]
    buckets[node.depth].push(node)
    i = i + 1
  }
  d = max_depth
  while d >= 0 {
    let bucket = buckets[d]
    let mut bi = 0
    while bi < bucket.length() {
      let node = bucket[bi]
      qbe_emit_lbl(g, node.lbl)
      let v = qbe_tmp(g)
      qbe_emit(g, v + " =l loadl " + node.slot)
      qbe_emit(g, "call $pion_rc_dec(l " + v + ")")
      qbe_emit_term(g, "jmp " + node.next_lbl)
      bi = bi + 1
    }
    d = d - 1
  }
  if g.fn_ret_epi_lbl != "" {
    qbe_emit_lbl(g, g.fn_ret_epi_lbl)
    if g.cur_fn_void {
      qbe_emit_term(g, "ret")
    } else {
      let abi = qbe_abi_ty(g.cur_ret_abi_ty)
      let rv = qbe_tmp(g)
      qbe_emit(g, rv + " =" + abi + " load" + abi + " " + g.fn_ret_slot)
      qbe_emit_term(g, "ret " + rv)
    }
  }
  g.fn_ret_slot = ""
  g.fn_ret_epi_lbl = ""
  g.fn_cleanup_pads = Map([])
  g.fn_cleanup_nodes = []
}

///|
fn qbe_define_local_ex(
  g : QbeGen,
  name : String,
  ty : Ty,
  owned : Bool,
  is_mut : Bool,
) -> QbeLocal {
  qbe_clear_shadowed_local_meta(g, name)
  let need_zero = g.block_term ||
    (owned &&
      (qbe_is_obj_ty(g, ty) ||
        match subst_ty(ty, g.cur_type_subst) {
          TParam(_) => true
          _ => false
        }))
  let slot = if need_zero {
    qbe_alloc_slot_for(g, ty)
  } else {
    qbe_alloc_slot_for_uninit(g, ty)
  }
  let loc = QbeLocal::{
    name: name,
    slot: slot,
    ty: ty,
    owned: owned,
    is_cell: false,
    counted_len: "",
    ref_slot: "",
  }
  let top = g.scopes[g.scopes.length() - 1]
  top.locals.push(loc)
  if is_mut {
    g.mut_local_slots.set(slot, true)
  }
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext.remove(name)
  loc
}

///|
fn qbe_define_local(
  g : QbeGen,
  name : String,
  ty : Ty,
  owned : Bool,
) -> QbeLocal {
  qbe_define_local_ex(g, name, ty, owned, false)
}

///|
fn qbe_define_cell_local(
  g : QbeGen,
  name : String,
  ty : Ty,
  owned : Bool,
) -> QbeLocal {
  qbe_clear_shadowed_local_meta(g, name)
  let slot = qbe_alloc_slot(g)
  let loc = QbeLocal::{
    name: name,
    slot: slot,
    ty: ty,
    owned: owned,
    is_cell: true,
    counted_len: "",
    ref_slot: "",
  }
  let top = g.scopes[g.scopes.length() - 1]
  top.locals.push(loc)
  g.mut_local_slots.set(slot, true)
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext.remove(name)
  loc
}

///|
/// Writes a `mut` parameter's local back to the caller's in-out slot,
/// transferring the local's reference (the slot's previous value is released).
fn qbe_writeback_ref_local(g : QbeGen, loc : QbeLocal) -> Unit {
  let cur = qbe_load_local_slot(g, loc.slot, loc.ty)
  let needs_rc = match loc.ty {
    TParam(_) => true
    _ => qbe_is_obj_ty(g, loc.ty)
  }
  if needs_rc {
    let old = qbe_tmp(g)
    qbe_emit(g, old + " =l loadl " + loc.ref_slot)
    qbe_store_heap_slot(g, cur, loc.ref_slot, loc.ty)
    qbe_rc_dec(g, old, loc.ty)
  } else {
    qbe_store_heap_slot(g, cur, loc.ref_slot, loc.ty)
  }
}

///|
/// Binds a function's parameters to locals. A `mut` parameter arrives as
/// `l %pN`, a pointer to the caller's 64-bit value slot: its value is copied
/// into an ordinary owned local (retained) and written back on every exit.
fn qbe_define_fn_params(g : QbeGen, params : Array[Param], ptys : Array[Ty]) -> Unit {
  let mut pi = 0
  while pi < params.length() && pi < ptys.length() {
    let pty = ptys[pi]
    let preg = "%p" + pi.to_string()
    if params[pi].is_mut {
      let slot = qbe_alloc_slot_for(g, pty)
      let loc = QbeLocal::{
        name: params[pi].name,
        slot: slot,
        ty: pty,
        owned: true,
        is_cell: false,
        counted_len: "",
        ref_slot: preg,
      }
      let top = g.scopes[g.scopes.length() - 1]
      top.locals.push(loc)
      g.mut_local_slots.set(slot, true)
      g.block_immut_fields = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext.remove(params[pi].name)
      let v = qbe_load_heap_slot(g, preg, pty)
      qbe_rc_inc(g, v, pty)
      qbe_store_local_slot(g, v, slot, pty)
    } else {
      let loc = qbe_define_local(g, params[pi].name, pty, false)
      qbe_store_local_slot(g, preg, loc.slot, pty)
      g.borrow_owner_slot.set(loc.slot, loc.slot)
      g.borrow_owner_name.set(loc.slot, params[pi].name)
    }
    pi = pi + 1
  }
}

///|
fn qbe_param_abi(params : Array[Param], ptys : Array[Ty], pi : Int) -> String {
  if pi < params.length() && params[pi].is_mut {
    "l"
  } else if pi < ptys.length() {
    qbe_abi_ty(ptys[pi])
  } else {
    "l"
  }
}

///|
fn qbe_param_is_mut(params : Array[Param], i : Int) -> Bool {
  i >= 0 && i < params.length() && params[i].is_mut
}

///|
/// A hidden owned local holding `v` (its name cannot be written in source).
fn qbe_hold_local(g : QbeGen, prefix : String, v : QbeVal) -> QbeLocal {
  g.mut_wb_seq = g.mut_wb_seq + 1
  let loc = qbe_define_local(g, prefix + g.mut_wb_seq.to_string(), v.ty, true)
  qbe_store_local_slot(g, v.reg, loc.slot, v.ty)
  loc
}

///|
/// No argument evaluation can rebind a plain local of the caller.
fn qbe_mut_places_stable(g : QbeGen, args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    let e = match args[i] {
      EMutArg(inner, _) => inner
      x => x
    }
    if qbe_expr_may_mutate_locals(g, e) {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// A plain non-captured local that keeps its binding until the write-back.
fn qbe_is_stable_local(g : QbeGen, e : Expr, stable : Bool) -> Bool {
  match e {
    EInt(_, _) => true
    EIdent(n, _) =>
      if stable {
        match qbe_lookup_local(g, n) {
          Some(loc) => !loc.is_cell
          None => false
        }
      } else {
        false
      }
    _ => false
  }
}

///|
/// Evaluates the container and index of `a[i]`, or the object owning the field of
/// `o.f`, once, so the write-back targets the element or field that was read,
/// whatever later arguments or the callee do to what the place is spelled with. Only
/// a plain local that nothing can rebind meanwhile is left as it is.
fn qbe_snapshot_place(
  g : QbeGen,
  place : Expr,
  stable : Bool,
  holds : Array[QbeLocal],
) -> Expr {
  match place {
    EField(base, f, sp) =>
      if qbe_is_stable_local(g, base, stable) {
        place
      } else {
        let bv = qbe_emit_expr(g, base, None)
        let loc = qbe_hold_local(g, "@mut_obj_", bv)
        holds.push(loc)
        EField(EIdent(loc.name, sp), f, sp)
      }
    EIndex(base, idx, sp) => {
      let b = if qbe_is_stable_local(g, base, stable) {
        base
      } else {
        let bv = qbe_emit_expr(g, base, None)
        let loc = qbe_hold_local(g, "@mut_base_", bv)
        holds.push(loc)
        EIdent(loc.name, sp)
      }
      let i = if qbe_is_stable_local(g, idx, stable) {
        idx
      } else {
        let iv = qbe_emit_expr(g, idx, Some(TInt))
        let loc = qbe_hold_local(g, "@mut_idx_", iv)
        EIdent(loc.name, sp)
      }
      EIndex(b, i, sp)
    }
    _ => place
  }
}

///|
/// Caller side of a `mut <place>` argument: the place's current value moves
/// into a fresh 64-bit slot whose address is passed (`l`); after the call the
/// slot's (possibly replaced) value is assigned back to the place. `args` are all
/// written arguments of the call.
fn qbe_emit_mut_arg(
  g : QbeGen,
  place : Expr,
  exp : Option[Ty],
  wbs : Array[QbeMutWb],
  args : Array[Expr],
) -> QbeArgVal {
  let slot = qbe_alloc_slot(g)
  let saved_mov = g.movable_locals
  g.movable_locals = Map([])
  let holds : Array[QbeLocal] = []
  let snap = qbe_snapshot_place(g, place, qbe_mut_places_stable(g, args), holds)
  let v = qbe_emit_expr(g, snap, exp)
  g.movable_locals = saved_mov
  qbe_store_heap_slot(g, v.reg, slot, v.ty)
  wbs.push(QbeMutWb::{ place: snap, slot: slot, ty: v.ty, holds: holds })
  QbeArgVal::{ qv: qval(slot, v.ty), borrowed: true }
}

///|
/// Caller-side temporaries kept alive across later arguments that may leave the
/// call early (`return`, `break`, `continue`, `?`): each is registered as an owned
/// local of the current scope, so that exit path releases it.
struct QbeArgGuards {
  exits : Array[Bool]
  slots : Array[String]
  stores : Array[Bool]
}

///|
fn qbe_expr_may_early_exit(g : QbeGen, e : Expr) -> Bool {
  qbe_expr_has_cf(e, true, true, true) || qbe_expr_has_default_ret(g, e)
}

///|
/// `exits[k]`: some argument evaluated after position `k` may leave the call early.
fn qbe_arg_guards(g : QbeGen, args : Array[Expr], order : Array[Int]) -> QbeArgGuards {
  let exits : Array[Bool] = []
  while exits.length() < order.length() {
    exits.push(false)
  }
  let mut any = false
  let mut k = order.length() - 1
  while k >= 0 {
    exits[k] = any
    if !any {
      any = qbe_expr_may_early_exit(g, args[order[k]])
    }
    k = k - 1
  }
  QbeArgGuards::{ exits: exits, slots: [], stores: [] }
}

///|
fn qbe_arg_guards_in_order(g : QbeGen, args : Array[Expr]) -> QbeArgGuards {
  let order : Array[Int] = []
  while order.length() < args.length() {
    order.push(order.length())
  }
  qbe_arg_guards(g, args, order)
}

///|
/// Guards a value evaluated before every argument (receiver, callee closure).
fn qbe_guard_callee(
  g : QbeGen,
  gs : QbeArgGuards,
  args : Array[Expr],
  v : QbeVal,
  borrowed : Bool,
) -> Unit {
  qbe_guard_val(g, gs, QbeArgVal::{ qv: v, borrowed: borrowed }, false, qbe_guards_exit_before_all(g, gs, args))
}

///|
/// `qbe_guards_any_exit(g, args)` for guards `gs` built by `qbe_arg_guards_in_order`
/// over the same `args`: `gs.exits[0]` already covers `args[1..]`.
fn qbe_guards_exit_before_all(g : QbeGen, gs : QbeArgGuards, args : Array[Expr]) -> Bool {
  if args.length() == 0 || gs.exits.length() != args.length() {
    return qbe_guards_any_exit(g, args)
  }
  gs.exits[0] || qbe_expr_may_early_exit(g, args[0])
}

///|
/// `qbe_guards_any_exit(g, args)` for `gs = qbe_arg_guards(g, args, order)`: when
/// `order` is a permutation of `args`, `gs.exits[0]` already covers every slot but
/// `order[0]`.
fn qbe_guards_exit_before_order(
  g : QbeGen,
  gs : QbeArgGuards,
  args : Array[Expr],
  order : Array[Int],
) -> Bool {
  let n = args.length()
  if n == 0 || order.length() != n || gs.exits.length() != n {
    return qbe_guards_any_exit(g, args)
  }
  let seen : Array[Bool] = []
  while seen.length() < n {
    seen.push(false)
  }
  let mut i = 0
  while i < n {
    let k = order[i]
    if k < 0 || k >= n || seen[k] {
      return qbe_guards_any_exit(g, args)
    }
    seen[k] = true
    i = i + 1
  }
  gs.exits[0] || qbe_expr_may_early_exit(g, args[order[0]])
}

///|
/// The argument was passed as the address of a caller slot owning its value.
fn qbe_is_mut_slot_arg(params : Array[Param], pi : Int, arg : Expr) -> Bool {
  match arg {
    EMutArg(_, _) => qbe_param_is_mut(params, pi)
    _ => false
  }
}

///|
fn qbe_guards_any_exit(g : QbeGen, args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    if qbe_expr_may_early_exit(g, args[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_guard_val(g : QbeGen, gs : QbeArgGuards, aa : QbeArgVal, is_mut_slot : Bool, exits : Bool) -> Unit {
  if !exits || g.block_term {
    return
  }
  let needs_rc = match subst_ty(aa.qv.ty, g.cur_type_subst) {
    TParam(_) => true
    t => qbe_is_obj_ty(g, t)
  }
  if !needs_rc {
    return
  }
  if is_mut_slot {
    g.mut_wb_seq = g.mut_wb_seq + 1
    let top = g.scopes[g.scopes.length() - 1]
    top.locals.push(
      QbeLocal::{
        name: "@arg_" + g.mut_wb_seq.to_string(),
        slot: aa.qv.reg,
        ty: aa.qv.ty,
        owned: true,
        is_cell: false,
        counted_len: "",
        ref_slot: "",
      },
    )
    gs.slots.push(aa.qv.reg)
    gs.stores.push(false)
  } else if !aa.borrowed {
    let loc = qbe_hold_local(g, "@arg_", aa.qv)
    gs.slots.push(loc.slot)
    gs.stores.push(true)
  }
}

///|
/// All arguments are evaluated: the call takes over every guarded value.
fn qbe_release_guards(g : QbeGen, gs : QbeArgGuards) -> Unit {
  let mut i = 0
  while i < gs.slots.length() {
    if gs.stores[i] && !g.block_term {
      qbe_emit(g, "storel 0, " + gs.slots[i])
    }
    g.zeroed_slots.set(gs.slots[i], true)
    i = i + 1
  }
}

///|
/// Evaluation order of a call's normalized argument slots (`SPEC.md`: arguments
/// are evaluated left to right as written): written arguments in source order,
/// then omitted (default / optional) slots in parameter order.
fn qbe_call_eval_order(
  params : Array[Param],
  offset : Int,
  raw_args : Array[Expr],
  n : Int,
) -> Array[Int] {
  let order : Array[Int] = []
  let mut k = 0
  if !params_need_named_resolution(params, offset, raw_args) {
    while k < n {
      order.push(k)
      k = k + 1
    }
    return order
  }
  let raw_idx = resolve_call_args_impl(None, params, offset, raw_args, "", span_new("", 0, 0)).raw_idx
  let slot_of_raw : Array[Int] = []
  while slot_of_raw.length() < raw_args.length() {
    slot_of_raw.push(-1)
  }
  while k < n {
    if raw_idx[k] >= 0 {
      slot_of_raw[raw_idx[k]] = k
    }
    k = k + 1
  }
  let mut ri = 0
  while ri < slot_of_raw.length() {
    if slot_of_raw[ri] >= 0 {
      order.push(slot_of_raw[ri])
    }
    ri = ri + 1
  }
  k = 0
  while k < n {
    if raw_idx[k] < 0 {
      order.push(k)
    }
    k = k + 1
  }
  order
}

///|
/// Extends the parallel per-slot argument arrays with placeholders up to `n`.
fn qbe_fill_arg_slots(
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
  n : Int,
) -> Unit {
  while arg_vals.length() < n {
    arg_vals.push("0")
    arg_tys.push(TUnit)
    arg_borrowed.push(true)
  }
}

///|
/// Generic arguments are inferred in parameter order (as the checker does), so
/// a reordered call binds what is statically known before emitting any argument.
fn qbe_preunify_reordered_args(
  g : QbeGen,
  finfo : FnInfo,
  offset : Int,
  norm_args : Array[Expr],
  order : Array[Int],
  subst : Map[String, Ty],
  sp : Span,
) -> Unit {
  if finfo.decl.type_params.length() == 0 {
    return
  }
  let mut reordered = false
  let mut k = 0
  while k < order.length() {
    if order[k] != k {
      reordered = true
    }
    k = k + 1
  }
  if !reordered {
    return
  }
  match qbe_call_infer(g, sp, "#targs:" + finfo.decl.name) {
    Some(TTuple(targs)) =>
      if targs.length() == finfo.decl.type_params.length() {
        k = 0
        while k < targs.length() {
          if !ty_has_unresolved(targs[k]) {
            qbe_unify_tparams(g, TParam(finfo.decl.type_params[k]), targs[k], subst)
          }
          k = k + 1
        }
      }
    _ => ()
  }
  k = 0
  while k < norm_args.length() && k + offset < finfo.param_tys.length() {
    match qbe_probe_expr_ty(g, norm_args[k]) {
      Some(t) =>
        if !ty_has_unresolved(t) && !qbe_ty_has_param(t) {
          qbe_unify_tparams(g, finfo.param_tys[k + offset], t, subst)
        }
      None => ()
    }
    k = k + 1
  }
}

///|
fn qbe_map_ty_resolved(g : QbeGen, t : Ty) -> Bool {
  !ty_has_unresolved(t) &&
  match t {
    TMap(_, _) => true
    _ => false
  }
}

///|
/// Emits an empty map of the given type.
fn qbe_emit_map_new(g : QbeGen, kty : Ty, vty : Ty) -> QbeVal {
  let r = qbe_tmp(g)
  if qbe_is_vmap_key_ty(g, kty) {
    let m = qbe_ensure_vmap_fns(g, kty, vty)
    qbe_emit(g, r + " =l call $pion_vmap_new_" + m + "(l 0)")
  } else {
    let vo = qbe_is_obj_flag_w(g, vty)
    let new_fn = if qbe_map_key_is_int(kty) {
      "$pion_map_new_int"
    } else {
      "$pion_map_new"
    }
    qbe_emit(g, r + " =l call " + new_fn + "(w " + vo + ")")
  }
  qval(r, TMap(kty, vty))
}

///|
/// `Map([(k, v), ..])` / `Map(pairs)`: inserts every pair into a fresh map in
/// order (a later key replaces an earlier one), exactly as `m.set(k, v)` would.
/// The map lives in an owned hidden local meanwhile, so an early exit out of a
/// key or value (`return`, `?`) releases it. The map type is the checker's, then
/// the expected one, else that of the emitted pairs; an unknown key type would
/// select the wrong runtime map, so it is an internal error.
fn qbe_emit_map_init(g : QbeGen, expected : Option[Ty], arg : Expr, call_sp : Span) -> QbeVal {
  let sp = span_new("", 0, 0)
  let mut mty = TMap(TError, TError)
  match qbe_call_infer(g, call_sp, "#map") {
    Some(t) => if qbe_map_ty_resolved(g, t) { mty = t }
    None => ()
  }
  if !qbe_map_ty_resolved(g, mty) {
    match expected {
      Some(t) => if qbe_map_ty_resolved(g, t) { mty = t }
      None => ()
    }
  }
  let is_lit = match arg {
    EArrayLit(_, _) => qbe_map_ty_resolved(g, mty)
    _ => false
  }
  qbe_scope_push(g)
  let mut pairs : Option[QbeVal] = None
  if !is_lit {
    let want : Option[Ty] = match mty {
      TMap(k, v) => if qbe_map_ty_resolved(g, mty) { Some(TArray(TTuple([k, v]))) } else { None }
      _ => None
    }
    let av = qbe_emit_expr(g, arg, want)
    if g.block_term {
      qbe_scope_pop(g)
      return qval("0", mty)
    }
    pairs = Some(av)
    if !qbe_map_ty_resolved(g, mty) {
      match av.ty {
        TArray(TTuple(kv)) => if kv.length() == 2 { mty = TMap(kv[0], kv[1]) }
        _ => ()
      }
    }
  }
  let (kty, vty) = match mty {
    TMap(k, v) => (k, v)
    _ => (TError, TError)
  }
  if !qbe_map_ty_resolved(g, mty) {
    abort(
      "internal compiler error: unresolved `Map(...)` type `" +
      ty_to_string(mty) +
      "` at " +
      call_sp.file +
      ":" +
      call_sp.line.to_string() +
      ":" +
      call_sp.col.to_string(),
    )
  }
  g.mut_wb_seq = g.mut_wb_seq + 1
  let hname = "@map_init_" + g.mut_wb_seq.to_string()
  // Own the evaluated pairs before allocating anything else.
  let aname = hname + "_pairs"
  match pairs {
    Some(av) => {
      let aloc = qbe_define_local(g, aname, av.ty, true)
      qbe_store_local_slot(g, av.reg, aloc.slot, av.ty)
    }
    None => ()
  }
  let m = qbe_emit_map_new(g, kty, vty)
  let loc = qbe_define_local(g, hname, mty, true)
  qbe_store_local_slot(g, m.reg, loc.slot, mty)
  let hmap = EIdent(hname, sp)
  match arg {
    EArrayLit(elems, _) if is_lit => {
      let mut i = 0
      while i < elems.length() && !g.block_term {
        match elems[i] {
          ETuple(kv, _) =>
            if kv.length() == 2 {
              qbe_emit_map_init_kv(g, hmap, kv, kty, vty)
            }
          pair => qbe_emit_map_init_pair(g, hmap, pair, TTuple([kty, vty]))
        }
        i = i + 1
      }
    }
    _ => {
      let pname = hname + "_pair"
      let body = [
        SExpr(
          EMethodCall(
            hmap,
            "set",
            [EField(EIdent(pname, sp), "0", sp), EField(EIdent(pname, sp), "1", sp)],
            sp,
          ),
          sp,
        ),
      ]
      let _ = qbe_emit_stmt(g, SForIn("", pname, EIdent(aname, sp), body, sp), None, false)
    }
  }
  if g.block_term {
    qbe_scope_pop(g)
    return qval("0", mty)
  }
  // Hand the reference over: the hidden local must not release it.
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + loc.slot)
  qbe_emit(g, "storel 0, " + loc.slot)
  g.zeroed_slots.set(loc.slot, true)
  qbe_scope_pop(g)
  qval(r, mty)
}

///|
/// `hmap.set(k, v)` for one literal pair. Operands that may leave the expression
/// early are bound to owned hidden locals first, so nothing evaluated so far (nor
/// a retained receiver) leaks on that path.
fn qbe_emit_map_init_kv(g : QbeGen, hmap : Expr, kv : Array[Expr], kty : Ty, vty : Ty) -> Unit {
  let sp = span_new("", 0, 0)
  if !qbe_args_may_mutate_locals(g, kv) {
    let _ = qbe_emit_method_call(g, hmap, "set", kv, None, sp)
    return
  }
  qbe_scope_push(g)
  let names : Array[Expr] = []
  let mut i = 0
  while i < 2 && !g.block_term {
    let v = qbe_emit_expr(g, kv[i], Some(if i == 0 { kty } else { vty }))
    if !g.block_term {
      g.mut_wb_seq = g.mut_wb_seq + 1
      let name = "@map_kv_" + g.mut_wb_seq.to_string()
      let loc = qbe_define_local(g, name, v.ty, true)
      qbe_store_local_slot(g, v.reg, loc.slot, v.ty)
      names.push(EIdent(name, sp))
    }
    i = i + 1
  }
  if !g.block_term {
    let _ = qbe_emit_method_call(g, hmap, "set", names, None, sp)
  }
  qbe_scope_pop(g)
}

///|
fn qbe_emit_map_init_pair(g : QbeGen, hmap : Expr, pair : Expr, pair_ty : Ty) -> Unit {
  let sp = span_new("", 0, 0)
  let pv = qbe_emit_expr(g, pair, Some(pair_ty))
  if g.block_term {
    return
  }
  qbe_scope_push(g)
  g.mut_wb_seq = g.mut_wb_seq + 1
  let pname = "@map_pair_" + g.mut_wb_seq.to_string()
  let ploc = qbe_define_local(g, pname, pv.ty, true)
  qbe_store_local_slot(g, pv.reg, ploc.slot, pv.ty)
  let kv = [EField(EIdent(pname, sp), "0", sp), EField(EIdent(pname, sp), "1", sp)]
  let _ = qbe_emit_method_call(g, hmap, "set", kv, None, sp)
  qbe_scope_pop(g)
}

///|
fn qbe_emit_call_arg(
  g : QbeGen,
  params : Array[Param],
  pi : Int,
  arg : Expr,
  exp : Option[Ty],
  can_borrow : Bool,
  wbs : Array[QbeMutWb],
  args : Array[Expr],
) -> QbeArgVal {
  match arg {
    EMutArg(inner, _) =>
      if qbe_param_is_mut(params, pi) {
        qbe_emit_mut_arg(g, inner, exp, wbs, args)
      } else {
        qbe_emit_arg_maybe_borrow(g, inner, exp, can_borrow)
      }
    _ => qbe_emit_arg_maybe_borrow(g, arg, exp, can_borrow)
  }
}

///|
fn qbe_args_have_named(args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    match args[i] {
      ENamedArg(_, _, _, _) => return true
      _ => ()
    }
    i = i + 1
  }
  false
}

///|
fn qbe_has_any_default(flags : Array[Bool]) -> Bool {
  let mut i = 0
  while i < flags.length() {
    if flags[i] {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Evaluates a callee's default parameter expression in an isolated scope
/// containing only the callee's prior parameters (`0 .. p_idx - 1`), with
/// caller locals hidden and the callee's package and generic substitution active.
fn qbe_emit_default_call_arg(
  g : QbeGen,
  params : Array[Param],
  param_tys : Array[Ty],
  tparams : Array[String],
  p_idx : Int,
  def_expr : Expr,
  exp : Option[Ty],
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  subst : Map[String, Ty],
  target_pkg : String,
) -> QbeArgVal {
  let saved_floor = g.lookup_scope_floor
  let saved_mono_pkg = g.mono_pkg
  let saved_imp_def = g.tc.in_imported_default_arg
  let saved_def_exp = g.tc.in_default_arg_expansion
  let saved_tparams = g.cur_tparams
  let saved_subst = g.cur_type_subst
  let saved_lex_subst = g.lexical_type_subst
  let saved_inline_closures = g.inline_closures
  let saved_hoisted_arr_len = g.hoisted_arr_len
  let saved_hoisted_arr_dp = g.hoisted_arr_dp
  let saved_hoisted_str_len = g.hoisted_str_len
  let saved_hoisted_str_dp = g.hoisted_str_dp
  let saved_hoisted_bytes_len = g.hoisted_bytes_len
  let saved_hoisted_bytes_dp = g.hoisted_bytes_dp
  let saved_hoisted_fields = g.hoisted_fields
  let saved_block_immut = g.block_immut_fields
  let saved_promoted_fields = g.promoted_fields
  let saved_promoted_field_tys = g.promoted_field_tys
  let saved_promoted_push_len = g.promoted_push_len
  let saved_promoted_push_cap = g.promoted_push_cap
  let saved_promoted_push_dp = g.promoted_push_dp
  let saved_movable = g.movable_locals
  let saved_moved_slots = g.moved_slots
  let saved_unfrozen = g.unfrozen_local_arrs
  let saved_known_min = g.known_min_len_arrs
  let saved_known_writable = g.known_writable_bytes
  let saved_len_aliases = g.len_aliases
  let saved_len_alias_keys = g.len_alias_keys
  let saved_nonneg = g.nonneg_vars
  let saved_u8 = g.u8_range_vars
  let saved_bce_idx = g.bce_safe_indices
  let saved_bce_exprs = g.bce_safe_exprs
  let saved_bce_push = g.bce_safe_push_arrs
  g.lookup_scope_floor = g.scopes.length()
  qbe_scope_push(g)
  g.tc.in_default_arg_expansion = true
  let norm_target_pkg = qbe_norm_mono_pkg(g, target_pkg)
  g.mono_pkg = norm_target_pkg
  g.tc.in_imported_default_arg = norm_target_pkg != ""
  let def_lex_subst : Map[String, Ty] = Map([])
  let mut dti = 0
  while dti < tparams.length() {
    let tn = tparams[dti]
    match subst.get(tn) {
      Some(ty) => def_lex_subst.set(tn, subst_ty(ty, saved_subst))
      None => ()
    }
    dti = dti + 1
  }
  g.cur_tparams = tparams
  g.lexical_type_subst = def_lex_subst
  g.cur_type_subst = Map([])
  g.inline_closures = Map([])
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.unfrozen_local_arrs = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  let def_scope_idx = g.scopes.length() - 1
  let mut j = 0
  while j < p_idx && j < params.length() && j < arg_vals.length() {
    let pname = params[j].name
    let pty = if j < param_tys.length() {
      subst_ty(param_tys[j], def_lex_subst)
    } else {
      arg_tys[j]
    }
    if qbe_param_is_mut(params, j) {
      g.scopes[def_scope_idx].locals.push(
        QbeLocal::{
          name: pname,
          slot: arg_vals[j],
          ty: pty,
          owned: false,
          is_cell: false,
          counted_len: "",
          ref_slot: "",
        },
      )
    } else {
      let coerced = qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), pty)
      let loc = qbe_define_local(g, pname, pty, false)
      qbe_store_local_slot(g, coerced, loc.slot, pty)
    }
    j = j + 1
  }
  let v = qbe_emit_expr(g, def_expr, exp)
  qbe_scope_pop(g)
  g.lookup_scope_floor = saved_floor
  g.mono_pkg = saved_mono_pkg
  g.tc.in_imported_default_arg = saved_imp_def
  g.tc.in_default_arg_expansion = saved_def_exp
  g.cur_tparams = saved_tparams
  g.cur_type_subst = saved_subst
  g.lexical_type_subst = saved_lex_subst
  g.inline_closures = saved_inline_closures
  g.hoisted_arr_len = saved_hoisted_arr_len
  g.hoisted_arr_dp = saved_hoisted_arr_dp
  g.hoisted_str_len = saved_hoisted_str_len
  g.hoisted_str_dp = saved_hoisted_str_dp
  g.hoisted_bytes_len = saved_hoisted_bytes_len
  g.hoisted_bytes_dp = saved_hoisted_bytes_dp
  g.hoisted_fields = saved_hoisted_fields
  g.block_immut_fields = saved_block_immut
  g.promoted_fields = saved_promoted_fields
  g.promoted_field_tys = saved_promoted_field_tys
  g.promoted_push_len = saved_promoted_push_len
  g.promoted_push_cap = saved_promoted_push_cap
  g.promoted_push_dp = saved_promoted_push_dp
  g.movable_locals = saved_movable
  g.moved_slots = saved_moved_slots
  g.unfrozen_local_arrs = saved_unfrozen
  g.known_min_len_arrs = saved_known_min
  g.known_writable_bytes = saved_known_writable
  g.len_aliases = saved_len_aliases
  g.len_alias_keys = saved_len_alias_keys
  g.nonneg_vars = saved_nonneg
  g.u8_range_vars = saved_u8
  g.bce_safe_indices = saved_bce_idx
  g.bce_safe_exprs = saved_bce_exprs
  g.bce_safe_push_arrs = saved_bce_push
  QbeArgVal::{ qv: v, borrowed: false }
}

///|
fn qbe_emit_mut_writebacks(g : QbeGen, wbs : Array[QbeMutWb]) -> Unit {
  let mut i = 0
  while i < wbs.length() {
    let wb = wbs[i]
    let nv = qbe_load_heap_slot(g, wb.slot, wb.ty)
    g.mut_wb_seq = g.mut_wb_seq + 1
    let hname = "@mut_wb_" + g.mut_wb_seq.to_string()
    let loc = qbe_define_local(g, hname, wb.ty, true)
    qbe_store_local_slot(g, nv, loc.slot, wb.ty)
    let saved_mov = g.movable_locals
    let mm : Map[String, String] = Map([])
    mm.set(hname, loc.slot)
    g.movable_locals = mm
    let _ = qbe_emit_stmt(g, SAssign(wb.place, EIdent(hname, span_new("", 0, 0)), span_new("", 0, 0)), None, false)
    g.movable_locals = saved_mov
    if !qbe_is_early_drop_ty(g, wb.ty) {
      // Not moved by the read above (scalars, generic `T`): drop the hidden
      // local's reference now so loops never accumulate it.
      let needs_rc = match wb.ty {
        TParam(_) => true
        _ => qbe_is_obj_ty(g, wb.ty)
      }
      if needs_rc {
        let hv = qbe_tmp(g)
        qbe_emit(g, hv + " =l loadl " + loc.slot)
        qbe_rc_dec(g, hv, wb.ty)
        qbe_emit(g, "storel 0, " + loc.slot)
      }
      g.zeroed_slots.set(loc.slot, true)
    }
    let mut hi = 0
    while hi < wb.holds.length() {
      let h = wb.holds[hi]
      if qbe_is_obj_ty(g, h.ty) {
        let hv = qbe_tmp(g)
        qbe_emit(g, hv + " =l loadl " + h.slot)
        qbe_rc_dec(g, hv, h.ty)
        qbe_emit(g, "storel 0, " + h.slot)
      }
      g.zeroed_slots.set(h.slot, true)
      hi = hi + 1
    }
    i = i + 1
  }
  g.block_immut_fields = Map([])
}

///|
/// `mut_recv_calls` maps of this package and of every imported package
/// that has any (spans carry their file, so keys never collide).
fn qbe_mut_recv_keys(g : QbeGen) -> Array[Map[String, Bool]] {
  let out : Array[Map[String, Bool]] = []
  if g.tc.mut_recv_calls.length() > 0 {
    out.push(g.tc.mut_recv_calls)
  }
  let mut ii = 0
  while ii < g.tc.all_imported_pkg_names.length() {
    match g.tc.all_imported_pkgs.get(g.tc.all_imported_pkg_names[ii]) {
      Some(ip) => if ip.tc.mut_recv_calls.length() > 0 { out.push(ip.tc.mut_recv_calls) }
      None => ()
    }
    ii = ii + 1
  }
  out
}

///|
fn qbe_call_into_maps(g : QbeGen) -> Array[Map[String, IntoConv]] {
  let out : Array[Map[String, IntoConv]] = []
  if g.tc.call_into_convs.length() > 0 {
    out.push(g.tc.call_into_convs)
  }
  let mut ii = 0
  while ii < g.tc.all_imported_pkg_names.length() {
    match g.tc.all_imported_pkgs.get(g.tc.all_imported_pkg_names[ii]) {
      Some(ip) =>
        if ip.tc.call_into_convs.length() > 0 {
          out.push(ip.tc.call_into_convs)
        }
      None => ()
    }
    ii = ii + 1
  }
  out
}

///|
/// A function body with `mut self` receivers lowered to `EMutArg` and `into`
/// call-site conversions desugared to explicit calls (identity when neither is present).
fn qbe_fn_body(g : QbeGen, body : Array[Stmt]) -> Array[Stmt] {
  let keys = qbe_mut_recv_keys(g)
  let into_maps = qbe_call_into_maps(g)
  if keys.length() == 0 && into_maps.length() == 0 {
    body
  } else {
    rewrite_mut_recv_stmts_ex(body, keys, into_maps)
  }
}

///|
fn qbe_fn_expr(g : QbeGen, e : Expr) -> Expr {
  let keys = qbe_mut_recv_keys(g)
  let into_maps = qbe_call_into_maps(g)
  if keys.length() == 0 && into_maps.length() == 0 {
    e
  } else {
    rewrite_mut_recv_expr_ex(e, keys, into_maps)
  }
}

///|
/// P82-D: Evaluate a compile-time constant integer RHS (including unary `-lit`) for `#verify` check folding.
fn qbe_eval_verify_const_rhs(g : QbeGen, e : Expr) -> Option[Int64] {
  match e {
    EUnary("-", inner, _) =>
      match qbe_eval_const_i64_expr(g, inner) {
        Some(v) => if v > 0L { Some(0L - v) } else { None }
        None => None
      }
    _ => qbe_eval_const_i64_expr(g, e)
  }
}

///|
/// `#verify` runtime checks before `lhs op rhs` on integers: division by zero,
/// `MIN / -1` (signed), and shift amounts outside `[0, bits)`.
fn qbe_emit_verify_arith_check(
  g : QbeGen,
  op : String,
  lv : QbeVal,
  rv : QbeVal,
  rhs_const : Option[Int64],
  sp : Span,
) -> Unit {
  let ty = lv.ty
  let is_w = match ty {
    TInt | TUInt => true
    _ => false
  }
  let is_b = match ty {
    TByte | TInt8 => true
    _ => false
  }
  let is_int = match ty {
    TInt | TUInt | TInt64 | TUInt64 | TByte | TInt8 => true
    _ => false
  }
  if !is_int {
    return
  }
  let signed = match ty {
    TInt | TInt64 | TInt8 => true
    _ => false
  }
  if op == "<<" || op == ">>" {
    let limit = if is_b { 8L } else if is_w { 32L } else { 64L }
    match rhs_const {
      Some(sh) => if sh >= 0L && sh < limit { return }
      None => ()
    }
    // Compare at the width of the shift count: truncating a 64-bit count to
    // `w` would let `1L << (1L << 32)` through. Unsigned, so negatives fail too.
    let (rc, cmp) = match rv.ty {
      TInt64 | TUInt64 => (qbe_coerce_val(g, rv, rv.ty), "cugel")
      TUInt => (qbe_coerce_val(g, rv, TUInt), "cugew")
      _ => (qbe_coerce_val(g, rv, TInt), "cugew")
    }
    match qbe_try_parse_pos_i64_reg(rc) {
      Some(sh) => if sh >= 0L && sh < limit { return }
      None => ()
    }
    let file_id = qbe_intern_source_path(g, sp.file)
    let bits = if is_b { "8" } else if is_w { "32" } else { "64" }
    let bad = qbe_tmp(g)
    let l_bad = qbe_lbl(g, "vsh_bad")
    let l_ok = qbe_lbl(g, "vsh_ok")
    qbe_emit(g, bad + " =w " + cmp + " " + rc + ", " + bits)
    qbe_emit_term(g, "jnz " + bad + ", " + l_bad + ", " + l_ok)
    qbe_emit_lbl(g, l_bad)
    let msg_id = qbe_intern_cstring(g, "shift amount out of range")
    qbe_emit(
      g,
      "call $pion_panic(l $pion_cstr_" + msg_id.to_string() + ", l $pion_cstr_" + file_id.to_string() + ", w " + sp.line.to_string() + ")",
    )
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_ok)
    return
  }
  match rhs_const {
    Some(d) => {
      let pos_ok = if is_b {
        if signed { d > 0L && d < 128L } else { d > 0L && d < 256L }
      } else {
        d > 0L && (!is_w || d < 2147483648L)
      }
      let neg_ok = signed &&
        d <= -2L &&
        (if is_b { d >= -128L } else { !is_w || d >= -2147483648L })
      if pos_ok || neg_ok {
        return
      }
    }
    None => ()
  }
  let k = if is_w { "w" } else { "l" }
  let rr = qbe_coerce_val(g, rv, ty)
  match qbe_try_parse_pos_i64_reg(rr) {
    Some(d) => {
      let pos_ok = if is_b {
        if signed { d > 0L && d < 128L } else { d > 0L && d < 256L }
      } else {
        d > 0L && (!is_w || d < 2147483648L)
      }
      if pos_ok {
        return
      }
    }
    None =>
      if signed && starts_with_str(rr, "-") {
        match qbe_try_parse_pos_i64_reg(rr.slice(1, rr.length())) {
          Some(d) =>
            if d >= 2L && (if is_b { d <= 128L } else { !is_w || d <= 2147483648L }) {
              return
            }
          None => ()
        }
      }
  }
  let file_id = qbe_intern_source_path(g, sp.file)
  let lr = qbe_coerce_val(g, lv, ty)
  let z = qbe_tmp(g)
  let l_zero = qbe_lbl(g, "vdiv_zero")
  let l_nz = qbe_lbl(g, "vdiv_nz")
  qbe_emit(g, z + " =w ceq" + k + " " + rr + ", 0")
  qbe_emit_term(g, "jnz " + z + ", " + l_zero + ", " + l_nz)
  qbe_emit_lbl(g, l_zero)
  let zmsg = qbe_intern_cstring(g, "division by zero")
  qbe_emit(
    g,
    "call $pion_panic(l $pion_cstr_" + zmsg.to_string() + ", l $pion_cstr_" + file_id.to_string() + ", w " + sp.line.to_string() + ")",
  )
  qbe_emit_term(g, "hlt")
  qbe_emit_lbl(g, l_nz)
  if signed {
    let minv = if is_b { "-128" } else if is_w { "-2147483648" } else { "-9223372036854775808" }
    let a = qbe_tmp(g)
    let b = qbe_tmp(g)
    let c = qbe_tmp(g)
    let l_ovf = qbe_lbl(g, "vdiv_ovf")
    let l_ok = qbe_lbl(g, "vdiv_ok")
    qbe_emit(g, a + " =w ceq" + k + " " + lr + ", " + minv)
    qbe_emit(g, b + " =w ceq" + k + " " + rr + ", -1")
    qbe_emit(g, c + " =w and " + a + ", " + b)
    qbe_emit_term(g, "jnz " + c + ", " + l_ovf + ", " + l_ok)
    qbe_emit_lbl(g, l_ovf)
    let omsg = qbe_intern_cstring(g, "integer overflow in division")
    qbe_emit(
      g,
      "call $pion_panic(l $pion_cstr_" + omsg.to_string() + ", l $pion_cstr_" + file_id.to_string() + ", w " + sp.line.to_string() + ")",
    )
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_ok)
  }
}

///|
/// `arr.swap(i, j)` on `Array[T]` / `FixedArray[T]`: bounds-checked swap of
/// two 64-bit data slots (ownership of both elements stays in the array, so
/// no RC traffic).
fn qbe_emit_arr_swap(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  elem : Ty,
  args : Array[Expr],
) -> QbeVal {
  let iv = qbe_emit_expr(g, args[0], Some(TInt))
  let il = qbe_as_l(g, iv)
  let jv = qbe_emit_expr(g, args[1], Some(TInt))
  let jl = qbe_as_l(g, jv)
  let len = qbe_tmp(g)
  qbe_emit(g, len + " =l loadl " + obj_val)
  let idxs = [il, jl]
  let mut k = 0
  while k < 2 {
    let oob = qbe_tmp(g)
    let l_oob = qbe_lbl(g, "swp_oob")
    let l_ok = qbe_lbl(g, "swp_ok")
    qbe_emit(g, oob + " =w cugel " + idxs[k] + ", " + len)
    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
    qbe_emit_lbl(g, l_oob)
    qbe_emit(g, "call $pion_panic_oob(l " + idxs[k] + ", l " + len + ")")
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_ok)
    k = k + 1
  }
  let dpp = qbe_tmp(g)
  let dp = qbe_tmp(g)
  qbe_emit(g, dpp + " =l add " + obj_val + ", 24")
  qbe_emit(g, dp + " =l loadl " + dpp)
  if qbe_is_u8_array_elem(g, elem) {
    // Compact 1-byte Bool/Byte/Int8 layout: load both bytes before storing so
    // `i == j` is a no-op.
    let pi = qbe_emit_arr_ep(g, dp, il, true)
    let pj = qbe_emit_arr_ep(g, dp, jl, true)
    let a = qbe_load_arr_u8(g, pi)
    let b = qbe_load_arr_u8(g, pj)
    qbe_store_arr_u8(g, b, pi)
    qbe_store_arr_u8(g, a, pj)
  } else if qbe_is_4b_array_elem(g, elem) {
    let pi = qbe_emit_arr_ep_ty(g, dp, il, elem)
    let pj = qbe_emit_arr_ep_ty(g, dp, jl, elem)
    let a = qbe_tmp(g)
    let b = qbe_tmp(g)
    qbe_emit(g, a + " =w loaduw " + pi)
    qbe_emit(g, b + " =w loaduw " + pj)
    qbe_emit(g, "storew " + b + ", " + pi)
    qbe_emit(g, "storew " + a + ", " + pj)
  } else if qbe_flat_pod_stride(g, elem) > 0 {
    // Flat POD struct layout: swap every 8-byte field slot of the two
    // inline elements; each slot pair is loaded before either store.
    let flat_stride = qbe_flat_pod_stride(g, elem)
    let nfields = flat_stride / 8
    let pi = qbe_emit_arr_elem_addr(g, dp, il, flat_stride)
    let pj = qbe_emit_arr_elem_addr(g, dp, jl, flat_stride)
    let mut fi = 0
    while fi < nfields {
      let mut si = pi
      let mut sj = pj
      if fi > 0 {
        si = qbe_tmp(g)
        sj = qbe_tmp(g)
        qbe_emit(g, si + " =l add " + pi + ", " + (fi * 8).to_string())
        qbe_emit(g, sj + " =l add " + pj + ", " + (fi * 8).to_string())
      }
      let a = qbe_tmp(g)
      let b = qbe_tmp(g)
      qbe_emit(g, a + " =l loadl " + si)
      qbe_emit(g, b + " =l loadl " + sj)
      qbe_emit(g, "storel " + b + ", " + si)
      qbe_emit(g, "storel " + a + ", " + sj)
      fi = fi + 1
    }
  } else {
    let oi = qbe_tmp(g)
    let oj = qbe_tmp(g)
    let pi = qbe_tmp(g)
    let pj = qbe_tmp(g)
    let a = qbe_tmp(g)
    let b = qbe_tmp(g)
    qbe_emit(g, oi + " =l mul " + il + ", 8")
    qbe_emit(g, oj + " =l mul " + jl + ", 8")
    qbe_emit(g, pi + " =l add " + dp + ", " + oi)
    qbe_emit(g, pj + " =l add " + dp + ", " + oj)
    qbe_emit(g, a + " =l loadl " + pi)
    qbe_emit(g, b + " =l loadl " + pj)
    qbe_emit(g, "storel " + b + ", " + pi)
    qbe_emit(g, "storel " + a + ", " + pj)
  }
  if !obj_borrowed {
    qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
  }
  qval("0", TUnit)
}

///|
fn qbe_collect_mut_decls_stmts(stmts : Array[Stmt], muts : Map[String, Bool]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(name, is_mut, _, init, _) => {
        if is_mut && name != "_" {
          muts.set(name, true)
        }
        qbe_collect_mut_decls_expr(init, muts)
      }
      SLetTuple(_, _, init, _) => qbe_collect_mut_decls_expr(init, muts)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        qbe_collect_mut_decls_expr(lhs, muts)
        qbe_collect_mut_decls_expr(rhs, muts)
      }
      SGuard(cond, else_body, _) => {
        qbe_collect_mut_decls_expr(cond, muts)
        qbe_collect_mut_decls_stmts(else_body, muts)
      }
      SWhile(cond, body, _) => {
        qbe_collect_mut_decls_expr(cond, muts)
        qbe_collect_mut_decls_stmts(body, muts)
      }
      SFor(init_s, cond, step_s, body, _) => {
        qbe_collect_mut_decls_stmts([init_s], muts)
        qbe_collect_mut_decls_expr(cond, muts)
        qbe_collect_mut_decls_stmts([step_s], muts)
        qbe_collect_mut_decls_stmts(body, muts)
      }
      SForRange(_, s, e, _, body, _) => {
        qbe_collect_mut_decls_expr(s, muts)
        qbe_collect_mut_decls_expr(e, muts)
        qbe_collect_mut_decls_stmts(body, muts)
      }
      SForIn(_, _, iter_e, body, _) => {
        qbe_collect_mut_decls_expr(iter_e, muts)
        qbe_collect_mut_decls_stmts(body, muts)
      }
      SReturn(Some(e), _) | SExpr(e, _) => qbe_collect_mut_decls_expr(e, muts)
      SDebugAssert(c, m, _) => {
        qbe_collect_mut_decls_expr(c, muts)
        qbe_collect_mut_decls_expr(m, muts)
      }
      _ => ()
    }
    i = i + 1
  }
}

///|
fn qbe_collect_mut_decls_expr(e : Expr, muts : Map[String, Bool]) -> Unit {
  match e {
    EBlock(stmts, _) => qbe_collect_mut_decls_stmts(stmts, muts)
    EIf(c, then_s, else_opt, _) => {
      qbe_collect_mut_decls_expr(c, muts)
      qbe_collect_mut_decls_stmts(then_s, muts)
      match else_opt {
        Some(el) => qbe_collect_mut_decls_expr(el, muts)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      qbe_collect_mut_decls_expr(scrut, muts)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_mut_decls_expr(ge, muts)
          None => ()
        }
        qbe_collect_mut_decls_expr(arms[i].body, muts)
        i = i + 1
      }
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EField(inner, _, _)
    | EIs(inner, _, _)
    | EAs(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _) | EMutArg(inner, _) => qbe_collect_mut_decls_expr(inner, muts)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_mut_decls_expr(l, muts)
      qbe_collect_mut_decls_expr(r, muts)
    }
    ECall(callee, args, _) => {
      qbe_collect_mut_decls_expr(callee, muts)
      let mut i = 0
      while i < args.length() {
        qbe_collect_mut_decls_expr(args[i], muts)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_mut_decls_expr(obj, muts)
      let mut i = 0
      while i < args.length() {
        qbe_collect_mut_decls_expr(args[i], muts)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_mut_decls_expr(elems[i], muts)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => qbe_collect_mut_decls_expr(base, muts)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        qbe_collect_mut_decls_expr(fields[i].value, muts)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) => ()
    _ => ()
  }
}

///|
fn qbe_collect_closure_caps_stmts(
  stmts : Array[Stmt],
  muts : Map[String, Bool],
  out : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        qbe_collect_closure_caps_expr(init, muts, out)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        qbe_collect_closure_caps_expr(lhs, muts, out)
        qbe_collect_closure_caps_expr(rhs, muts, out)
      }
      SGuard(cond, else_body, _) => {
        qbe_collect_closure_caps_expr(cond, muts, out)
        qbe_collect_closure_caps_stmts(else_body, muts, out)
      }
      SWhile(cond, body, _) => {
        qbe_collect_closure_caps_expr(cond, muts, out)
        qbe_collect_closure_caps_stmts(body, muts, out)
      }
      SFor(init_s, cond, step_s, body, _) => {
        qbe_collect_closure_caps_stmts([init_s], muts, out)
        qbe_collect_closure_caps_expr(cond, muts, out)
        qbe_collect_closure_caps_stmts([step_s], muts, out)
        qbe_collect_closure_caps_stmts(body, muts, out)
      }
      SForRange(_, s, e, _, body, _) => {
        qbe_collect_closure_caps_expr(s, muts, out)
        qbe_collect_closure_caps_expr(e, muts, out)
        qbe_collect_closure_caps_stmts(body, muts, out)
      }
      SForIn(_, _, iter_e, body, _) => {
        qbe_collect_closure_caps_expr(iter_e, muts, out)
        qbe_collect_closure_caps_stmts(body, muts, out)
      }
      SReturn(Some(e), _) | SExpr(e, _) =>
        qbe_collect_closure_caps_expr(e, muts, out)
      SDebugAssert(c, m, _) => {
        qbe_collect_closure_caps_expr(c, muts, out)
        qbe_collect_closure_caps_expr(m, muts, out)
      }
      _ => ()
    }
    i = i + 1
  }
}

///|
fn qbe_collect_closure_caps_expr(
  e : Expr,
  muts : Map[String, Bool],
  out : Map[String, Bool],
) -> Unit {
  match e {
    EClosure(params, _, cbody, _) => {
      let plocals : Map[String, Bool] = Map([])
      let mut pi = 0
      while pi < params.length() {
        plocals.set(params[pi].name, true)
        pi = pi + 1
      }
      let caps : Array[CaptureInfo] = []
      collect_stmts_captures(cbody, plocals, caps)
      let mut ci = 0
      while ci < caps.length() {
        if muts.contains(caps[ci].name) {
          out.set(caps[ci].name, true)
        }
        ci = ci + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_closure_caps_stmts(stmts, muts, out)
    EIf(c, then_s, else_opt, _) => {
      qbe_collect_closure_caps_expr(c, muts, out)
      qbe_collect_closure_caps_stmts(then_s, muts, out)
      match else_opt {
        Some(el) => qbe_collect_closure_caps_expr(el, muts, out)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      qbe_collect_closure_caps_expr(scrut, muts, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_closure_caps_expr(ge, muts, out)
          None => ()
        }
        qbe_collect_closure_caps_expr(arms[i].body, muts, out)
        i = i + 1
      }
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EField(inner, _, _)
    | EIs(inner, _, _)
    | EAs(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _) | EMutArg(inner, _) => qbe_collect_closure_caps_expr(inner, muts, out)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_closure_caps_expr(l, muts, out)
      qbe_collect_closure_caps_expr(r, muts, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_closure_caps_expr(callee, muts, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_closure_caps_expr(args[i], muts, out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_closure_caps_expr(obj, muts, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_closure_caps_expr(args[i], muts, out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_closure_caps_expr(elems[i], muts, out)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => qbe_collect_closure_caps_expr(base, muts, out)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        qbe_collect_closure_caps_expr(fields[i].value, muts, out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_boxed_mut_vars(stmts : Array[Stmt]) -> Map[String, Bool] {
  let muts : Map[String, Bool] = Map([])
  qbe_collect_mut_decls_stmts(stmts, muts)
  let out : Map[String, Bool] = Map([])
  if muts.length() > 0 {
    qbe_collect_closure_caps_stmts(stmts, muts, out)
  }
  out
}

///|
/// Whether the bare identifier `name` resolves to `Option::None` here, i.e.
/// it is spelled `None` and no local, parameter, constant or function of that
/// name shadows it (the resolution order of `EIdent` in `qbe_emit_expr`).
fn qbe_ident_is_option_none(g : QbeGen, name : String) -> Bool {
  if name != "None" {
    return false
  }
  match qbe_lookup_local(g, name) {
    Some(_) => return false
    None => ()
  }
  if g.tc.consts.contains(name) || g.tc.fns.contains(name) {
    return false
  }
  if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.consts.contains(name) || ipkg.tc.fns.contains(name) {
          return false
        }
      None => ()
    }
  }
  true
}

///|
fn qbe_lookup_local(g : QbeGen, name : String) -> Option[QbeLocal] {
  let mut si = g.scopes.length() - 1
  while si >= g.lookup_scope_floor {
    let sc = g.scopes[si]
    let mut li = sc.locals.length() - 1
    while li >= 0 {
      if sc.locals[li].name == name {
        return Some(sc.locals[li])
      }
      li = li - 1
    }
    si = si - 1
  }
  None
}

///|
// Invariant: generic bodies and default_exprs are checked under unsubstituted
// `TParam`s before monomorphization, so a call-site span has identical
// local-vs-nonlocal resolution across all contexts.
fn qbe_call_is_nonlocal(g : QbeGen, sp : Span) -> Bool {
  if sp.line <= 0 {
    return false
  }
  let k = "call_nonlocal:" + span_key(sp)
  if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.resolved_method_calls.contains(k) {
          return true
        }
      None => ()
    }
  }
  g.tc.resolved_method_calls.contains(k)
}

///|
fn qbe_find_world_slot(g : QbeGen) -> Option[String] {
  let mut si = g.scopes.length() - 1
  while si >= 0 {
    let sc = g.scopes[si]
    let mut li = sc.locals.length() - 1
    while li >= 0 {
      match sc.locals[li].ty {
        TWorld => return Some(sc.locals[li].slot)
        _ => ()
      }
      li = li - 1
    }
    si = si - 1
  }
  None
}

///|
/// A type parameter whose runtime `%tp_<tn>` flag is defined in the current
/// QBE function (declared on a polymorphic fn or unpacked from a closure `%env`).
fn qbe_tp_live(g : QbeGen, tn : String) -> Bool {
  str_arr_contains(g.live_tparams, tn)
}

///|
fn qbe_is_obj_flag(g : QbeGen, raw_t : Ty) -> String {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        "%tp_" + tn
      } else {
        "0"
      }
    _ => if qbe_is_obj_ty(g, t) { "1" } else { "0" }
  }
}

///|
fn qbe_is_obj_flag_w(g : QbeGen, raw_t : Ty) -> String {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy %tp_" + tn)
        w
      } else {
        "0"
      }
    _ => if qbe_is_obj_ty(g, t) { "1" } else { "0" }
  }
}

///|
/// Returns Some(sinfo) when `raw_ty` (after substitution) is an immutable
/// 2..=6-field struct whose fields are primitive scalars or concrete RC objects
/// (excluding TDynTrait/TParam/TError), stored flat inline in arrays
/// (`elem_stride = N * 8` in {16, 24, 32, 40, 48}, `elem_is_obj = RC bitmask`).
fn qbe_flat_pod_struct_info(g : QbeGen, raw_ty : Ty) -> Option[StructInfo] {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let n = sinfo.field_names.length()
          if n < 2 || n > 6 {
            return None
          }
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut i = 0
          while i < n {
            if sinfo.field_muts[i] {
              return None
            }
            let fty = subst_ty(sinfo.field_tys[i], subst)
            let is_unit_enum_scalar = qbe_is_unboxed_unit_enum(g, fty) ||
              match fty {
                TOption(inner) => qbe_is_unboxed_unit_enum(g, inner)
                _ => false
              }
            if !qbe_is_prim_array_elem(fty) && !is_unit_enum_scalar {
              let ok_rc = match fty {
                TDynTrait(_) | TParam(_) | TError => false
                _ => qbe_is_obj_ty(g, fty)
              }
              if !ok_rc {
                return None
              }
            }
            i = i + 1
          }
          Some(sinfo)
        }
        None => None
      }
    _ => None
  }
}

///|
fn qbe_flat_struct_field_tys(
  g : QbeGen,
  sinfo : StructInfo,
  raw_ty : Ty,
) -> Array[Ty] {
  let sargs = match subst_ty(raw_ty, g.cur_type_subst) {
    TStruct(_, a) => a
    _ => []
  }
  let subst = make_subst(sinfo.decl.type_params, sargs)
  let out : Array[Ty] = []
  let mut i = 0
  while i < sinfo.field_tys.length() {
    out.push(subst_ty(sinfo.field_tys[i], subst))
    i = i + 1
  }
  out
}

///|
fn qbe_flat_struct_obj_mask(g : QbeGen, raw_ty : Ty) -> Int {
  match qbe_flat_pod_struct_info(g, raw_ty) {
    Some(sinfo) => {
      let ftys = qbe_flat_struct_field_tys(g, sinfo, raw_ty)
      let mut mask = 0
      let mut bit = 1
      let mut i = 0
      while i < ftys.length() {
        if qbe_is_obj_ty(g, ftys[i]) {
          mask = mask + bit
        }
        bit = bit * 2
        i = i + 1
      }
      mask
    }
    None => 0
  }
}

///|
fn qbe_flat_struct_flags(g : QbeGen, raw_ty : Ty) -> Int {
  match qbe_flat_pod_struct_info(g, raw_ty) {
    Some(sinfo) => {
      let stride = sinfo.field_names.length() * 8
      let mask = qbe_flat_struct_obj_mask(g, raw_ty)
      stride + mask * 256
    }
    None => 0
  }
}

///|
fn qbe_flat_pod_stride(g : QbeGen, raw_ty : Ty) -> Int {
  match qbe_flat_pod_struct_info(g, raw_ty) {
    Some(sinfo) => sinfo.field_names.length() * 8
    None => 0
  }
}

///|
fn qbe_emit_arr_elem_addr(
  g : QbeGen,
  dp : String,
  idx_l : String,
  stride : Int,
) -> String {
  let off = qbe_tmp(g)
  let ep = qbe_tmp(g)
  if stride == 16 {
    qbe_emit(g, off + " =l shl " + idx_l + ", 4")
  } else if stride == 32 {
    qbe_emit(g, off + " =l shl " + idx_l + ", 5")
  } else if stride == 24 || stride == 40 || stride == 48 {
    qbe_emit(g, off + " =l mul " + idx_l + ", " + stride.to_string())
  } else {
    qbe_emit(g, off + " =l shl " + idx_l + ", 3")
  }
  qbe_emit(g, ep + " =l add " + dp + ", " + off)
  ep
}

///|
fn qbe_emit_flat_copy_slots_rc(
  g : QbeGen,
  dst_ep : String,
  src_p : String,
  sinfo : StructInfo,
  raw_elem : Ty,
  inc_rc : Bool,
  dec_old : Bool,
  adopt_arr : String,
) -> Unit {
  let ftys = qbe_flat_struct_field_tys(g, sinfo, raw_elem)
  let nfields = ftys.length()
  let vals : Array[String] = []
  let mut fi = 0
  while fi < nfields {
    let sp = if fi == 0 {
      src_p
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + src_p + ", " + (fi * 8).to_string())
      t
    }
    let v = qbe_tmp(g)
    qbe_emit(g, v + " =l loadl " + sp)
    vals.push(v)
    fi = fi + 1
  }
  if inc_rc {
    fi = 0
    while fi < nfields {
      if qbe_is_obj_ty(g, ftys[fi]) {
        qbe_rc_inc(g, vals[fi], ftys[fi])
      }
      fi = fi + 1
    }
  }
  if adopt_arr != "" {
    fi = 0
    while fi < nfields {
      if qbe_is_obj_ty(g, ftys[fi]) {
        qbe_emit_adopt_if_frozen(g, adopt_arr, vals[fi], ftys[fi], !inc_rc)
      }
      fi = fi + 1
    }
  }
  let old_vals : Array[String] = []
  let old_tys : Array[Ty] = []
  if dec_old {
    fi = 0
    while fi < nfields {
      if qbe_is_obj_ty(g, ftys[fi]) {
        let dp_f = if fi == 0 {
          dst_ep
        } else {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l add " + dst_ep + ", " + (fi * 8).to_string())
          t
        }
        let ov = qbe_tmp(g)
        qbe_emit(g, ov + " =l loadl " + dp_f)
        old_vals.push(ov)
        old_tys.push(ftys[fi])
      }
      fi = fi + 1
    }
  }
  fi = 0
  while fi < nfields {
    let dp_f = if fi == 0 {
      dst_ep
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + dst_ep + ", " + (fi * 8).to_string())
      t
    }
    qbe_emit(g, "storel " + vals[fi] + ", " + dp_f)
    fi = fi + 1
  }
  if dec_old {
    let mut oi = 0
    while oi < old_vals.length() {
      qbe_rc_dec(g, old_vals[oi], old_tys[oi])
      oi = oi + 1
    }
  }
}

///|
fn qbe_emit_flat_adopt_vals(
  g : QbeGen,
  arr_reg : String,
  slot_vals : Array[QbeVal],
) -> Unit {
  if arr_reg == "" {
    return
  }
  let mut fi = 0
  while fi < slot_vals.length() {
    if qbe_is_obj_ty(g, slot_vals[fi].ty) {
      let vl = qbe_as_l(g, slot_vals[fi])
      qbe_emit_adopt_if_frozen(g, arr_reg, vl, slot_vals[fi].ty, false)
    }
    fi = fi + 1
  }
}

///|
fn qbe_emit_flat_store_vals_rc(
  g : QbeGen,
  dst_ep : String,
  slot_vals : Array[QbeVal],
  dec_old : Bool,
  adopt_arr : String,
) -> Unit {
  qbe_emit_flat_adopt_vals(g, adopt_arr, slot_vals)
  let old_vals : Array[String] = []
  let old_tys : Array[Ty] = []
  if dec_old {
    let mut fi = 0
    while fi < slot_vals.length() {
      if qbe_is_obj_ty(g, slot_vals[fi].ty) {
        let dp_f = if fi == 0 {
          dst_ep
        } else {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l add " + dst_ep + ", " + (fi * 8).to_string())
          t
        }
        let ov = qbe_tmp(g)
        qbe_emit(g, ov + " =l loadl " + dp_f)
        old_vals.push(ov)
        old_tys.push(slot_vals[fi].ty)
      }
      fi = fi + 1
    }
  }
  qbe_emit_flat_store_vals(g, dst_ep, slot_vals)
  if dec_old {
    let mut oi = 0
    while oi < old_vals.length() {
      qbe_rc_dec(g, old_vals[oi], old_tys[oi])
      oi = oi + 1
    }
  }
}

///|
fn qbe_emit_flat_materialize(
  g : QbeGen,
  ep : String,
  sinfo : StructInfo,
  raw_elem : Ty,
  inc_rc : Bool,
) -> String {
  let ftys = qbe_flat_struct_field_tys(g, sinfo, raw_elem)
  let nfields = ftys.length()
  let obj_slots : Array[Int] = []
  let mut fi = 0
  while fi < nfields {
    if qbe_is_obj_ty(g, ftys[fi]) {
      obj_slots.push(fi)
    }
    fi = fi + 1
  }
  let drop_sym = qbe_register_slot_drop(g, obj_slots)
  let box_p = qbe_tmp(g)
  qbe_emit(
    g,
    box_p + " =l call $pion_alloc_uninit(w " + (nfields * 8).to_string() + ", w 4, l " + drop_sym + ")",
  )
  qbe_emit_flat_copy_slots_rc(g, box_p, ep, sinfo, raw_elem, inc_rc, false, "")
  box_p
}

///|
fn qbe_emit_flat_eval_struct_lit(
  g : QbeGen,
  sinfo : StructInfo,
  raw_elem : Ty,
  fields : Array[FieldInit],
) -> Array[QbeVal] {
  let sargs = match subst_ty(raw_elem, g.cur_type_subst) {
    TStruct(_, a) => a
    _ => []
  }
  let subst = make_subst(sinfo.decl.type_params, sargs)
  let n_fields = sinfo.field_names.length()
  let slot_vals : Array[QbeVal] = []
  let mut init_i = 0
  while init_i < n_fields {
    let fty = subst_ty(sinfo.field_tys[init_i], subst)
    slot_vals.push(qval(qbe_zero_reg(fty), fty))
    init_i = init_i + 1
  }
  let field_exprs : Array[Expr] = []
  while field_exprs.length() < fields.length() {
    field_exprs.push(fields[field_exprs.length()].value)
  }
  let guards = qbe_arg_guards_in_order(g, field_exprs)
  let mut fi = 0
  while fi < fields.length() {
    let f = fields[fi]
    let mut j = 0
    while j < n_fields {
      if sinfo.field_names[j] == f.name {
        let fty = subst_ty(sinfo.field_tys[j], subst)
        let fv = qbe_emit_expr(g, f.value, Some(fty))
        let coerced = qbe_coerce_val(g, fv, fty)
        slot_vals[j] = qval(coerced, fty)
        qbe_guard_val(
          g,
          guards,
          QbeArgVal::{ qv: slot_vals[j], borrowed: false },
          false,
          guards.exits[fi],
        )
        break
      }
      j = j + 1
    }
    fi = fi + 1
  }
  qbe_release_guards(g, guards)
  slot_vals
}

///| Direct initialization is safe for complete, checked records made only of
/// immortal string literals. No computation or escape observes a row box.
fn qbe_flat_string_rows(g : QbeGen, elem_ty : Ty, elems : Array[Expr]) -> Option[StructInfo] {
  if elems.length() < 2 {
    return None
  }
  let si = match qbe_flat_pod_struct_info(g, elem_ty) {
    Some(si) => si
    None => return None
  }
  if si.decl.type_params.length() != 0 {
    return None
  }
  for ty in si.field_tys {
    match ty {
      TString => ()
      _ => return None
    }
  }
  for row in elems {
    match row {
      EStructLit(name, None, fields, _) => {
        if name != si.decl.name || fields.length() != si.field_names.length() {
          return None
        }
        let mut j = 0
        while j < fields.length() {
          if fields[j].name != si.field_names[j] {
            return None
          }
          match fields[j].value {
            EString(_, _) => ()
            _ => return None
          }
          j = j + 1
        }
      }
      _ => return None
    }
  }
  Some(si)
}

///|
fn qbe_emit_flat_store_vals(
  g : QbeGen,
  dst_ep : String,
  slot_vals : Array[QbeVal],
) -> Unit {
  let mut fi = 0
  while fi < slot_vals.length() {
    let fp = if fi == 0 {
      dst_ep
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + dst_ep + ", " + (fi * 8).to_string())
      t
    }
    qbe_store_heap_slot(g, slot_vals[fi].reg, fp, slot_vals[fi].ty)
    fi = fi + 1
  }
}

///|
/// Strict static check for borrowing a flat POD struct array element pointer (`dp + i * stride`):
/// returns true only when `name` appears SOLELY as the receiver of direct field reads `name.field`
/// (never passed to any call/method, never compared, never returned, never stored or captured).
fn qbe_ident_is_flat_field_only_expr(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EField(obj, _, _) =>
      match obj {
        EIdent(n, _) => if n == name { true } else { true }
        _ => qbe_ident_is_flat_field_only_expr(obj, name)
      }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _) => qbe_ident_is_flat_field_only_expr(inner, name)
    EMutArg(inner, _) =>
      if qbe_mut_place_root(inner) == name {
        false
      } else {
        qbe_ident_is_flat_field_only_expr(inner, name)
      }
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_ident_is_flat_field_only_expr(l, name) &&
      qbe_ident_is_flat_field_only_expr(r, name)
    ECall(callee, args, _) => {
      if !qbe_ident_is_flat_field_only_expr(callee, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_is_flat_field_only_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_ident_is_flat_field_only_expr(obj, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_is_flat_field_only_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_flat_field_only_expr(elems[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_ident_is_flat_field_only_expr(b, name) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_flat_field_only_expr(fields[i].value, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_ident_is_flat_field_only_stmts(stmts, 0, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_flat_field_only_expr(cond, name) ||
        !qbe_ident_is_flat_field_only_stmts(then_stmts, 0, name) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_flat_field_only_expr(el, name)
      }
    }
    EIs(scrut, _, _) => qbe_ident_is_flat_field_only_expr(scrut, name)
    EMatch(scrut, arms, _) => {
      if !qbe_ident_is_flat_field_only_expr(scrut, name) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_flat_field_only_expr(ge, name) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_flat_field_only_expr(arms[i].body, name) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    ETry(inner, _) => qbe_ident_is_flat_field_only_expr(inner, name)
    EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | EInterp(_, _)
    | EDotVariant(_, _, _) => !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_flat_field_only_stmt(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_ident_is_flat_field_only_expr(init, name)
    SLetTuple(_, _, init, _) => qbe_ident_is_flat_field_only_expr(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_ident_is_flat_field_only_expr(lhs, name) &&
      qbe_ident_is_flat_field_only_expr(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_flat_field_only_expr(cond, name) &&
      qbe_ident_is_flat_field_only_stmts(body, 0, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_flat_field_only_stmt(init_s, name) &&
      qbe_ident_is_flat_field_only_expr(cond, name) &&
      qbe_ident_is_flat_field_only_stmt(step_s, name) &&
      qbe_ident_is_flat_field_only_stmts(body, 0, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_flat_field_only_expr(start_e, name) &&
      qbe_ident_is_flat_field_only_expr(end_e, name) &&
      (vname == name || qbe_ident_is_flat_field_only_stmts(body, 0, name))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_flat_field_only_expr(iter_e, name) &&
      (vname == name || qbe_ident_is_flat_field_only_stmts(body, 0, name))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_ident_is_flat_field_only_expr(e, name)
      }
    SExpr(e, _) => qbe_ident_is_flat_field_only_expr(e, name)
    SDebugAssert(cond, msg, _) =>
      qbe_ident_is_flat_field_only_expr(cond, name) &&
      qbe_ident_is_flat_field_only_expr(msg, name)
    SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_ident_is_flat_field_only_stmts(
  stmts : Array[Stmt],
  start : Int,
  name : String,
) -> Bool {
  let mut i = start
  while i < stmts.length() {
    if !qbe_ident_is_flat_field_only_stmt(stmts[i], name) {
      return false
    }
    match stmts[i] {
      SLet(bname, _, _, _, _) => if bname == name { return true }
      SLetTuple(bnames, _, _, _) => {
        let mut bi = 0
        while bi < bnames.length() {
          if bnames[bi] == name {
            return true
          }
          bi = bi + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
/// P72-A: Check whether `raw_ty` is the exact same non-generic flat-POD struct as `sinfo`.
fn qbe_ty_matches_flat_pod_struct(
  g : QbeGen,
  raw_ty : Ty,
  sinfo : StructInfo,
) -> Bool {
  if sinfo.decl.type_params.length() != 0 {
    return false
  }
  match qbe_flat_pod_struct_info(g, raw_ty) {
    Some(si2) => si2.decl.name == sinfo.decl.name && si2.decl.type_params.length() == 0
    None => false
  }
}

///|
/// P72-A: Check whether `raw_ty` is the exact same non-generic pure-scalar POD struct as `pod_ty`.
fn qbe_ty_matches_pure_pod_struct(
  g : QbeGen,
  raw_ty : Ty,
  pod_ty : Ty,
) -> Bool {
  match (qbe_pure_scalar_pod_struct_info(g, pod_ty), qbe_pure_scalar_pod_struct_info(g, raw_ty)) {
    (Some(si1), Some(si2)) =>
      si1.decl.type_params.length() == 0 &&
      si2.decl.type_params.length() == 0 &&
      si1.decl.name == si2.decl.name
    _ => false
  }
}

///|
/// P96: True only when `raw_ty` is both a pure-scalar POD struct matching `pod_ty`
/// AND stored flat inline by value in `Array`/`FixedArray` (`2..=6` fields via
/// `qbe_flat_pod_struct_info`). Single-field structs are pointer-stored in arrays,
/// so stack-promoted pointers MUST NOT be pushed or index-assigned into them.
fn qbe_ty_matches_flat_pure_pod_struct(
  g : QbeGen,
  raw_ty : Ty,
  pod_ty : Ty,
) -> Bool {
  match qbe_flat_pod_struct_info(g, raw_ty) {
    Some(_) => qbe_ty_matches_pure_pod_struct(g, raw_ty, pod_ty)
    None => false
  }
}

///|
/// P72-A: Load all fields of a flat-POD struct from `src_p` (heap object, stack POD buffer,
/// or borrowed flat array element pointer — never touching `src_p - 24`) into typed `QbeVal`s,
/// optionally incrementing RC on any object-typed fields.
fn qbe_emit_flat_load_slots_rc(
  g : QbeGen,
  src_p : String,
  sinfo : StructInfo,
  raw_elem : Ty,
  inc_rc : Bool,
) -> Array[QbeVal] {
  let ftys = qbe_flat_struct_field_tys(g, sinfo, raw_elem)
  let nfields = ftys.length()
  let out : Array[QbeVal] = []
  let mut fi = 0
  while fi < nfields {
    let sp = if fi == 0 {
      src_p
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l add " + src_p + ", " + (fi * 8).to_string())
      t
    }
    let fv = qbe_load_heap_slot(g, sp, ftys[fi])
    out.push(qval(fv, ftys[fi]))
    fi = fi + 1
  }
  if inc_rc {
    fi = 0
    while fi < nfields {
      if qbe_is_obj_ty(g, ftys[fi]) {
        qbe_rc_inc(g, out[fi].reg, ftys[fi])
      }
      fi = fi + 1
    }
  }
  out
}

///|
/// P72-A/P96: Probe expression type, consulting `shadowed` (later local bindings in the same
/// block that may shadow an outer local/function) and `env` (callee parameter types) before `g.locals`.
fn qbe_probe_ty_with_env(
  g : QbeGen,
  e : Expr,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
) -> Option[Ty] {
  if env.length() == 0 && shadowed.length() == 0 {
    return qbe_probe_expr_ty(g, e)
  }
  match e {
    EIdent(n, _) =>
      if shadowed.contains(n) {
        None
      } else if env.length() > 0 {
        match env.get(n) {
          Some(t) => Some(t)
          None => None
        }
      } else {
        qbe_probe_expr_ty(g, e)
      }
    EIndex(base, _, _) =>
      match qbe_probe_ty_with_env(g, base, env, shadowed) {
        Some(TArray(elem)) | Some(TFixedArray(elem)) | Some(TImmArray(elem)) => Some(elem)
        _ => None
      }
    EField(base, fname, _) =>
      match qbe_probe_ty_with_env(g, base, env, shadowed) {
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut fi = 0
              while fi < sinfo.field_names.length() {
                if sinfo.field_names[fi] == fname {
                  return Some(subst_ty(sinfo.field_tys[fi], subst))
                }
                fi = fi + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    _ => None
  }
}

///|
/// P72-A: Conservative check whether a function body directly calls `fname` (excludes self-recursive / TCO functions).
fn qbe_expr_calls_ident(e : Expr, fname : String) -> Bool {
  match e {
    ECall(EIdent(n, _), args, _) => {
      if n == fname {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_calls_ident(args[i], fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    ECall(callee, args, _) => {
      if qbe_expr_calls_ident(callee, fname) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_calls_ident(args[i], fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if mname == fname || qbe_expr_calls_ident(obj, fname) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_calls_ident(args[i], fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EField(inner, _, _)
    | EIs(inner, _, _)
    | ETry(inner, _) => qbe_expr_calls_ident(inner, fname)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_calls_ident(l, fname) || qbe_expr_calls_ident(r, fname)
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_calls_ident(elems[i], fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_calls_ident(b, fname) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_calls_ident(fields[i].value, fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(bs, _) => qbe_stmts_calls_ident(bs, fname)
    EIf(c, ts, eo, _) => {
      if qbe_expr_calls_ident(c, fname) || qbe_stmts_calls_ident(ts, fname) {
        return true
      }
      match eo {
        Some(el) => qbe_expr_calls_ident(el, fname)
        None => false
      }
    }
    EMatch(s, arms, _) => {
      if qbe_expr_calls_ident(s, fname) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_calls_ident(ge, fname) { return true }
          None => ()
        }
        if qbe_expr_calls_ident(arms[i].body, fname) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_stmt_calls_ident(s : Stmt, fname : String) -> Bool {
  match s {
    SLet(_, _, _, ini, _) | SLetTuple(_, _, ini, _) | SExpr(ini, _) =>
      qbe_expr_calls_ident(ini, fname)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) =>
      qbe_expr_calls_ident(l, fname) || qbe_expr_calls_ident(r, fname)
    SWhile(c, b, _) | SGuard(c, b, _) =>
      qbe_expr_calls_ident(c, fname) || qbe_stmts_calls_ident(b, fname)
    SFor(is_, c, ss, b, _) =>
      qbe_stmt_calls_ident(is_, fname) ||
      qbe_expr_calls_ident(c, fname) ||
      qbe_stmt_calls_ident(ss, fname) ||
      qbe_stmts_calls_ident(b, fname)
    SForRange(_, se, ee, _, b, _) =>
      qbe_expr_calls_ident(se, fname) ||
      qbe_expr_calls_ident(ee, fname) ||
      qbe_stmts_calls_ident(b, fname)
    SForIn(_, _, ie, b, _) =>
      qbe_expr_calls_ident(ie, fname) || qbe_stmts_calls_ident(b, fname)
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_expr_calls_ident(e, fname)
        None => false
      }
    SBreak(_) | SContinue(_) => false
  }
}

///|
fn qbe_stmts_calls_ident(stmts : Array[Stmt], fname : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_calls_ident(stmts[i], fname) {
      return true
    }
    i = i + 1
  }
  false
}

fn qbe_collect_pat_bind_names(p : Pattern, out : Map[String, Bool]) -> Unit {
  match p {
    PIdent(n, _) => if n != "_" { out.set(n, true) }
    PTuple(ps, _) | PVariant(_, _, ps, _, _) => {
      let mut i = 0
      while i < ps.length() {
        qbe_collect_pat_bind_names(ps[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_local_bind_names_expr(e : Expr, out : Map[String, Bool]) -> Unit {
  match e {
    EBlock(bs, _) => qbe_collect_local_bind_names_stmts(bs, out)
    EIf(c, ts, eo, _) => {
      qbe_collect_local_bind_names_expr(c, out)
      qbe_collect_local_bind_names_stmts(ts, out)
      match eo {
        Some(el) => qbe_collect_local_bind_names_expr(el, out)
        None => ()
      }
    }
    EMatch(s, arms, _) => {
      qbe_collect_local_bind_names_expr(s, out)
      let mut i = 0
      while i < arms.length() {
        qbe_collect_pat_bind_names(arms[i].pat, out)
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_local_bind_names_expr(ge, out)
          None => ()
        }
        qbe_collect_local_bind_names_expr(arms[i].body, out)
        i = i + 1
      }
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EField(inner, _, _)
    | ETry(inner, _) => qbe_collect_local_bind_names_expr(inner, out)
    EIs(inner, pat, _) => {
      qbe_collect_local_bind_names_expr(inner, out)
      qbe_collect_pat_bind_names(pat, out)
    }
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      qbe_collect_local_bind_names_expr(l, out)
      qbe_collect_local_bind_names_expr(r, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_local_bind_names_expr(callee, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_local_bind_names_expr(args[i], out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_local_bind_names_expr(obj, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_local_bind_names_expr(args[i], out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_local_bind_names_expr(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => qbe_collect_local_bind_names_expr(b, out)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        qbe_collect_local_bind_names_expr(fields[i].value, out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_local_bind_names_stmt(s : Stmt, out : Map[String, Bool]) -> Unit {
  match s {
    SLet(n, _, _, ini, _) => {
      qbe_collect_local_bind_names_expr(ini, out)
      if n != "_" {
        out.set(n, true)
      }
    }
    SLetTuple(ns, _, ini, _) => {
      qbe_collect_local_bind_names_expr(ini, out)
      let mut i = 0
      while i < ns.length() {
        if ns[i] != "_" {
          out.set(ns[i], true)
        }
        i = i + 1
      }
    }
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) | SDebugAssert(l, r, _) => {
      qbe_collect_local_bind_names_expr(l, out)
      qbe_collect_local_bind_names_expr(r, out)
    }
    SWhile(c, b, _) | SGuard(c, b, _) => {
      qbe_collect_local_bind_names_expr(c, out)
      qbe_collect_local_bind_names_stmts(b, out)
    }
    SFor(is_, c, ss, b, _) => {
      qbe_collect_local_bind_names_stmt(is_, out)
      qbe_collect_local_bind_names_expr(c, out)
      qbe_collect_local_bind_names_stmt(ss, out)
      qbe_collect_local_bind_names_stmts(b, out)
    }
    SForRange(vn, se, ee, _, b, _) => {
      qbe_collect_local_bind_names_expr(se, out)
      qbe_collect_local_bind_names_expr(ee, out)
      if vn != "_" {
        out.set(vn, true)
      }
      qbe_collect_local_bind_names_stmts(b, out)
    }
    SForIn(_, vn, ie, b, _) => {
      qbe_collect_local_bind_names_expr(ie, out)
      if vn != "_" {
        out.set(vn, true)
      }
      qbe_collect_local_bind_names_stmts(b, out)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_collect_local_bind_names_expr(e, out)
        None => ()
      }
    SExpr(e, _) => qbe_collect_local_bind_names_expr(e, out)
    SBreak(_) | SContinue(_) => ()
  }
}

///|
fn qbe_collect_local_bind_names_stmts(stmts : Array[Stmt], out : Map[String, Bool]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_local_bind_names_stmt(stmts[i], out)
    i = i + 1
  }
}

///|
/// P96: Collect all local binding names introduced in `stmts[start ..]` before `stop_name`
/// is shadowed at the top level of `stmts`, so pre-scans for stack promotion never resolve
/// a call to a top-level function that is shadowed by a later local binding (e.g. `let save = fn(...)`).
fn qbe_collect_future_local_bind_names(
  stmts : Array[Stmt],
  start : Int,
  stop_name : String,
) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map([])
  let mut i = start
  while i < stmts.length() {
    let s = stmts[i]
    qbe_collect_local_bind_names_stmt(s, out)
    match s {
      SLet(bname, _, _, _, _) => if bname == stop_name { break }
      SLetTuple(bnames, _, _, _) => {
        let mut bi = 0
        let mut hit = false
        while bi < bnames.length() {
          if bnames[bi] == stop_name {
            hit = true
            break
          }
          bi = bi + 1
        }
        if hit {
          break
        }
      }
      _ => ()
    }
    i = i + 1
  }
  out
}

///|
/// P96: Canonical cache key for `pod_borrow_cache`, derived strictly from the resolved
/// target declaration's package, receiver type (distinguishing free functions from
/// `Type::method` across distinct types in the same package), member name, and param index.
fn qbe_borrow_cache_key(
  prefix : String,
  target_pkg : String,
  finfo : FnInfo,
  param_idx : Int,
) -> String {
  let decl_id = if finfo.decl.receiver_type != "" {
    "m:" + finfo.decl.receiver_type + "::" + finfo.decl.name
  } else {
    "fn:" + finfo.decl.name
  }
  prefix + "::" + target_pkg + "::" + decl_id + "#" + param_idx.to_string()
}

///|
/// P96: Resolve a package qualifier `qual` strictly in the CURRENT defining package context
/// (`g.tc` when `g.mono_pkg == ""`, or the defining package's own `cur_pkg.tc` when
/// `g.mono_pkg != ""`). Never consults the calling package's `import_aliases` while
/// recursively inspecting an imported function body; returns `None` if unavailable.
fn qbe_resolve_pkg_in_borrow_ctx(g : QbeGen, qual : String) -> Option[ImportedPkg] {
  if starts_with_str(qual, "@canon:") {
    return lookup_imported_pkg_transitive(g.tc, slice_str(qual, 7, qual.length()))
  }
  if g.mono_pkg == "" {
    resolve_pkg_for_lookup(g.tc, qual, true)
  } else {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(cur_pkg) =>
        match cur_pkg.tc.import_aliases.get(qual) {
          Some(canon) => lookup_imported_pkg_transitive(g.tc, canon)
          None =>
            match cur_pkg.tc.imported_pkgs.get(qual) {
              Some(p) => Some(p)
              None =>
                if qual == cur_pkg.name {
                  Some(cur_pkg)
                } else {
                  None
                }
            }
        }
      None => None
    }
  }
}

///|
/// P96: True when `EPath(qual, mem)` resolves to an enum variant constructor in the
/// CURRENT defining package context (`g.tc` when `g.mono_pkg == ""`, or `cur_pkg.tc`
/// when `g.mono_pkg != ""`). Matches `types.pion:11692-11724` and `qbe.pion:37755-37788`,
/// where enum variant constructors take precedence over same-name static methods (`E::Var`).
fn qbe_epath_is_variant_ctor_in_borrow_ctx(
  g : QbeGen,
  qual : String,
  mem : String,
) -> Bool {
  if qual == "Option" || qual == "Result" {
    return true
  }
  if has_qual_sep(qual) {
    let qp = split_qual_name(qual)
    match qbe_resolve_pkg_in_borrow_ctx(g, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qp.name) {
          Some(ei) => enum_info_has_variant(ei, mem)
          None => false
        }
      None => false
    }
  } else if g.mono_pkg == "" {
    match g.tc.enums.get(qual) {
      Some(ei) => enum_info_has_variant(ei, mem)
      None => false
    }
  } else {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(cur_pkg) =>
        match cur_pkg.tc.enums.get(qual) {
          Some(ei) => enum_info_has_variant(ei, mem)
          None => false
        }
      None => false
    }
  }
}

///|
/// P96: Resolve a method `sname::mname` strictly in the CURRENT defining package context
/// without falling back to the caller's `g.tc.import_aliases` or `g.tc.methods`.
/// Returns `Some((target_pkg, qualified_fn_info))` on exact resolution, else `None`.
fn qbe_lookup_method_in_borrow_ctx(
  g : QbeGen,
  sname : String,
  mname : String,
) -> Option[(String, FnInfo)] {
  if has_qual_sep(sname) {
    let qp = split_qual_name(sname)
    if g.mono_pkg == "" && g.tc.pkg_name != "" && qp.prefix == g.tc.pkg_name {
      match g.tc.methods.get(qp.name + "::" + mname) {
        Some(mi) => return Some(("", qbe_qualify_fn_info_sig(g.tc.pkg_name, mi)))
        None => ()
      }
    }
    match qbe_resolve_pkg_in_borrow_ctx(g, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.methods.get(qp.name + "::" + mname) {
          Some(mi) => return Some((ipkg.name, qualify_fn_info(ipkg, mi)))
          None => ()
        }
      None => ()
    }
    // Also accept an already canon-qualified type name from `qualify_fn_info` (never alias).
    if g.mono_pkg != "" {
      match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
        Some(cur_pkg) =>
          match cur_pkg.tc.all_imported_pkgs.get(qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.methods.get(qp.name + "::" + mname) {
                Some(mi) => return Some((ipkg.name, qualify_fn_info(ipkg, mi)))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
    None
  } else if g.mono_pkg == "" {
    match g.tc.methods.get(sname + "::" + mname) {
      Some(mi) => Some(("", mi))
      None => None
    }
  } else {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(cur_pkg) =>
        match cur_pkg.tc.methods.get(sname + "::" + mname) {
          Some(mi) => Some((cur_pkg.name, qualify_fn_info(cur_pkg, mi)))
          None => None
        }
      None => None
    }
  }
}

///|
/// P72-A: Pure static check whether parameter `param_idx` of `finfo` only borrows a pure-scalar
/// POD struct pointer without ever touching its RC header (`p - 24`) or letting it escape.
fn qbe_fn_param_is_pod_borrow(
  g : QbeGen,
  target_pkg : String,
  _fn_key : String,
  finfo : FnInfo,
  param_idx : Int,
  depth : Int,
) -> Bool {
  if depth > 2 {
    return false
  }
  let ckey = qbe_borrow_cache_key("pb", target_pkg, finfo, param_idx)
  match g.pod_borrow_cache.get(ckey) {
    Some(v) => return v
    None => ()
  }
  if qbe_fn_is_stub_body(finfo.decl.body) {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if finfo.decl.type_params.length() != 0 {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if param_idx < 0 ||
    param_idx >= finfo.decl.params.length() ||
    param_idx >= finfo.param_tys.length() {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if finfo.decl.params[param_idx].is_mut {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let saved_mono_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  let param_ty = finfo.param_tys[param_idx]
  let is_pod = match qbe_pure_scalar_pod_struct_info(g, param_ty) {
    Some(si) => si.decl.type_params.length() == 0
    None => false
  }
  if !is_pod {
    g.mono_pkg = saved_mono_pkg
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let param_name = finfo.decl.params[param_idx].name
  if param_name == "_" {
    g.mono_pkg = saved_mono_pkg
    g.pod_borrow_cache.set(ckey, true)
    return true
  }
  let body = qbe_fn_body(g, finfo.decl.body)
  // Conservatively exclude self-recursive / TCO functions.
  if qbe_stmts_calls_ident(body, finfo.decl.name) {
    g.mono_pkg = saved_mono_pkg
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let boxed = qbe_collect_boxed_mut_vars(body)
  if boxed.contains(param_name) {
    g.mono_pkg = saved_mono_pkg
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let penv : Map[String, Ty] = Map([])
  let mut pi = 0
  while pi < finfo.decl.params.length() && pi < finfo.param_tys.length() {
    penv.set(finfo.decl.params[pi].name, finfo.param_tys[pi])
    pi = pi + 1
  }
  // P72-A: Record all body-local bindings so a local `let f = ...` shadowing a top-level
  // function `f` is never misclassified as a static top-level call.
  let body_locals : Map[String, Bool] = Map([])
  qbe_collect_local_bind_names_stmts(body, body_locals)
  let bl_keys = body_locals.keys()
  let mut bi = 0
  while bi < bl_keys.length() {
    let bk = bl_keys[bi]
    if bk != param_name {
      penv.set(bk, TError)
    }
    bi = bi + 1
  }
  let ok = qbe_ident_is_flat_pod_consumer_stmts(
    g,
    body,
    0,
    param_name,
    param_ty,
    penv,
    body_locals,
    depth + 1,
  )
  g.mono_pkg = saved_mono_pkg
  if ok || depth == 0 {
    g.pod_borrow_cache.set(ckey, ok)
  }
  ok
}

///|
/// P72-A: Extended non-escaping consumer check for a pure-scalar POD local/param `name`:
/// allows field reads, flat-POD `arr.push(name)`, flat-POD `arr[i] = name`, and calls/methods
/// whose target parameter satisfies `qbe_fn_param_is_pod_borrow` (with `can_borrow = true`).
fn qbe_ident_is_flat_pod_consumer_expr(
  g : QbeGen,
  e : Expr,
  name : String,
  pod_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EField(obj, _, _) =>
      match obj {
        EIdent(n, _) => if n == name { true } else { true }
        _ => qbe_ident_is_flat_pod_consumer_expr(g, obj, name, pod_ty, env, shadowed, depth)
      }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, inner, name, pod_ty, env, shadowed, depth)
    EMutArg(inner, _) =>
      if qbe_mut_place_root(inner) == name {
        false
      } else {
        qbe_ident_is_flat_pod_consumer_expr(g, inner, name, pod_ty, env, shadowed, depth)
      }
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, l, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_expr(g, r, name, pod_ty, env, shadowed, depth)
    ECall(callee, args, sp) => {
      if !qbe_ident_is_flat_pod_consumer_expr(g, callee, name, pod_ty, env, shadowed, depth) {
        return false
      }
      let mut has_direct = false
      let mut i = 0
      while i < args.length() {
        match args[i] {
          EIdent(n, _) => if n == name { has_direct = true }
          ENamedArg(_, _, EIdent(n, _), _) => if n == name { has_direct = true }
          _ => ()
        }
        i = i + 1
      }
      if !has_direct {
        i = 0
        while i < args.length() {
          if !qbe_ident_is_flat_pod_consumer_expr(g, args[i], name, pod_ty, env, shadowed, depth) {
            return false
          }
          i = i + 1
        }
        return true
      }
      if qbe_args_have_assign(args) {
        return false
      }
      // Resolve static concrete non-generic function / associated method
      let mut target_finfo : Option[FnInfo] = None
      let mut target_pkg = ""
      let mut fn_key = ""
      match callee {
        EIdent(fname, _) => {
          if fname == "Some" || fname == "Ok" || fname == "Err" {
            return false
          }
          let is_local_var = shadowed.contains(fname) ||
            (if env.length() > 0 {
              env.contains(fname)
            } else {
              match qbe_lookup_local(g, fname) {
                Some(_) => true
                None => false
              }
            })
          if !is_local_var && !g.inline_closures.contains(fname) {
            target_pkg = g.mono_pkg
            fn_key = fname
            target_finfo = if target_pkg == "" {
              g.tc.fns.get(fname)
            } else {
              match lookup_imported_pkg_transitive(g.tc, target_pkg) {
                Some(ipkg) =>
                  match ipkg.tc.fns.get(fname) {
                    Some(fi) => Some(qualify_fn_info(ipkg, fi))
                    None => None
                  }
                None => None
              }
            }
          }
        }
        EPath(qual, mem, _) => {
          fn_key = qual + "::" + mem
          if qbe_epath_is_variant_ctor_in_borrow_ctx(g, qual, mem) {
            return false
          }
          if has_qual_sep(qual) {
            let qp = split_qual_name(qual)
            match qbe_resolve_pkg_in_scope(g, qp.prefix) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(qp.name + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_pkg = ipkg.name
                    fn_key = qp.name + "::" + mem
                  }
                  None => ()
                }
              None => ()
            }
          }
          match target_finfo {
            None =>
              match qbe_resolve_pkg_in_scope(g, qual) {
                Some(ipkg) =>
                  match ipkg.tc.fns.get(mem) {
                    Some(fi) => {
                      target_finfo = Some(qualify_fn_info(ipkg, fi))
                      target_pkg = ipkg.name
                      fn_key = mem
                    }
                    None => ()
                  }
                None => ()
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              match qbe_lookup_method_info(g, qual, mem) {
                Some(minfo) => {
                  target_finfo = Some(minfo)
                  let qpm = split_qual_name(qual)
                  if qpm.prefix != "" {
                    target_pkg = qpm.prefix
                  } else if g.mono_pkg != "" {
                    target_pkg = g.mono_pkg
                  }
                }
                None =>
                  match qbe_lookup_method_in_borrow_ctx(g, qual, mem) {
                    Some((mpkg, minfo)) => {
                      target_finfo = Some(minfo)
                      target_pkg = mpkg
                    }
                    None => ()
                  }
              }
            Some(_) => ()
          }
        }
        _ => ()
      }
      match target_finfo {
        Some(finfo) => {
          if finfo.decl.type_params.length() != 0 {
            return false
          }
          let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
          if qbe_has_any_default(call_res.from_default) {
            return false
          }
          let norm_args = call_res.args
          if norm_args.length() != finfo.param_tys.length() ||
            qbe_args_have_assign(norm_args) {
            return false
          }
          let mut ai = 0
          while ai < norm_args.length() {
            match norm_args[ai] {
              EIdent(n, _) =>
                if n == name {
                  if !qbe_fn_param_is_pod_borrow(g, target_pkg, fn_key, finfo, ai, depth) {
                    return false
                  }
                }
              _ =>
                if !qbe_ident_is_flat_pod_consumer_expr(g, norm_args[ai], name, pod_ty, env, shadowed, depth) {
                  return false
                }
            }
            ai = ai + 1
          }
          true
        }
        None => false
      }
    }
    EMethodCall(obj, mname, args, sp) => {
      // Special case 1: `arr.push(name)` where `arr` is flat-POD `TArray` of `pod_ty` (2..=6 fields)
      if mname == "push" && args.length() == 1 {
        match args[0] {
          EIdent(n, _) =>
            if n == name {
              if !qbe_ident_is_flat_pod_consumer_expr(g, obj, name, pod_ty, env, shadowed, depth) {
                return false
              }
              return match qbe_probe_ty_with_env(g, obj, env, shadowed) {
                Some(TArray(elem)) => qbe_ty_matches_flat_pure_pod_struct(g, elem, pod_ty)
                _ => false
              }
            }
          _ => ()
        }
      }
      let recv_is_name = match obj {
        EIdent(n, _) => n == name
        _ => false
      }
      let mut arg_has_direct = false
      let mut i = 0
      while i < args.length() {
        match args[i] {
          EIdent(n, _) => if n == name { arg_has_direct = true }
          ENamedArg(_, _, EIdent(n, _), _) => if n == name { arg_has_direct = true }
          _ => ()
        }
        i = i + 1
      }
      if !recv_is_name && !arg_has_direct {
        if !qbe_ident_is_flat_pod_consumer_expr(g, obj, name, pod_ty, env, shadowed, depth) {
          return false
        }
        i = 0
        while i < args.length() {
          if !qbe_ident_is_flat_pod_consumer_expr(g, args[i], name, pod_ty, env, shadowed, depth) {
            return false
          }
          i = i + 1
        }
        return true
      }
      // `to_string` forces `can_borrow_obj = false` in `qbe_emit_method_call`.
      if mname == "to_string" || qbe_expr_has_assign(obj) || qbe_args_have_assign(args) {
        return false
      }
      let recv_ty = match qbe_probe_ty_with_env(g, obj, env, shadowed) {
        Some(rt) => subst_ty(rt, g.cur_type_subst)
        None => return false
      }
      let sname = match recv_ty {
        TStruct(sn, sargs) =>
          if sargs.length() == 0 {
            sn
          } else {
            return false
          }
        _ => return false
      }
      match qbe_lookup_method_in_borrow_ctx(g, sname, mname) {
        Some((mpkg, minfo)) => {
          if minfo.decl.type_params.length() != 0 {
            return false
          }
          let call_res = resolve_call_args_qbe_full(minfo.decl.params, 1, args, sp)
          if qbe_has_any_default(call_res.from_default) {
            return false
          }
          let norm_args = call_res.args
          if norm_args.length() + 1 != minfo.param_tys.length() ||
            qbe_args_have_assign(norm_args) {
            return false
          }
          let mkey = sname + "::" + mname
          if recv_is_name {
            if !qbe_fn_param_is_pod_borrow(g, mpkg, mkey, minfo, 0, depth) {
              return false
            }
          } else if !qbe_ident_is_flat_pod_consumer_expr(g, obj, name, pod_ty, env, shadowed, depth) {
            return false
          }
          let mut ai = 0
          while ai < norm_args.length() {
            match norm_args[ai] {
              EIdent(n, _) =>
                if n == name {
                  if !qbe_fn_param_is_pod_borrow(g, mpkg, mkey, minfo, ai + 1, depth) {
                    return false
                  }
                }
              _ =>
                if !qbe_ident_is_flat_pod_consumer_expr(g, norm_args[ai], name, pod_ty, env, shadowed, depth) {
                  return false
                }
            }
            ai = ai + 1
          }
          true
        }
        None => false
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_flat_pod_consumer_expr(g, elems[i], name, pod_ty, env, shadowed, depth) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if !qbe_ident_is_flat_pod_consumer_expr(g, b, name, pod_ty, env, shadowed, depth) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_flat_pod_consumer_expr(g, fields[i].value, name, pod_ty, env, shadowed, depth) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) =>
      qbe_ident_is_flat_pod_consumer_stmts(g, stmts, 0, name, pod_ty, env, shadowed, depth)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_flat_pod_consumer_expr(g, cond, name, pod_ty, env, shadowed, depth) ||
        !qbe_ident_is_flat_pod_consumer_stmts(g, then_stmts, 0, name, pod_ty, env, shadowed, depth) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_flat_pod_consumer_expr(g, el, name, pod_ty, env, shadowed, depth)
      }
    }
    EIs(scrut, _, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, scrut, name, pod_ty, env, shadowed, depth)
    EMatch(scrut, arms, _) => {
      if !qbe_ident_is_flat_pod_consumer_expr(g, scrut, name, pod_ty, env, shadowed, depth) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_flat_pod_consumer_expr(g, ge, name, pod_ty, env, shadowed, depth) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_flat_pod_consumer_expr(g, arms[i].body, name, pod_ty, env, shadowed, depth) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    ETry(inner, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, inner, name, pod_ty, env, shadowed, depth)
    EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | EInterp(_, _)
    | EDotVariant(_, _, _) => !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_flat_pod_consumer_stmt(
  g : QbeGen,
  s : Stmt,
  name : String,
  pod_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, init, name, pod_ty, env, shadowed, depth)
    SLetTuple(_, _, init, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, init, name, pod_ty, env, shadowed, depth)
    SAssign(EIndex(arr_obj, idx_e, _), EIdent(n, _), _) =>
      if n == name {
        if !qbe_ident_is_flat_pod_consumer_expr(g, arr_obj, name, pod_ty, env, shadowed, depth) ||
          !qbe_ident_is_flat_pod_consumer_expr(g, idx_e, name, pod_ty, env, shadowed, depth) {
          return false
        }
        match qbe_probe_ty_with_env(g, arr_obj, env, shadowed) {
          Some(TArray(elem)) | Some(TFixedArray(elem)) =>
            qbe_ty_matches_flat_pure_pod_struct(g, elem, pod_ty)
          _ => false
        }
      } else {
        qbe_ident_is_flat_pod_consumer_expr(g, arr_obj, name, pod_ty, env, shadowed, depth) &&
        qbe_ident_is_flat_pod_consumer_expr(g, idx_e, name, pod_ty, env, shadowed, depth)
      }
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, lhs, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_expr(g, rhs, name, pod_ty, env, shadowed, depth)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, cond, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_stmts(g, body, 0, name, pod_ty, env, shadowed, depth)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_flat_pod_consumer_stmt(g, init_s, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_expr(g, cond, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_stmt(g, step_s, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_stmts(g, body, 0, name, pod_ty, env, shadowed, depth)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, start_e, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_expr(g, end_e, name, pod_ty, env, shadowed, depth) &&
      (vname == name ||
        qbe_ident_is_flat_pod_consumer_stmts(g, body, 0, name, pod_ty, env, shadowed, depth))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, iter_e, name, pod_ty, env, shadowed, depth) &&
      (vname == name ||
        qbe_ident_is_flat_pod_consumer_stmts(g, body, 0, name, pod_ty, env, shadowed, depth))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_ident_is_flat_pod_consumer_expr(g, e, name, pod_ty, env, shadowed, depth)
      }
    SExpr(e, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, e, name, pod_ty, env, shadowed, depth)
    SDebugAssert(cond, msg, _) =>
      qbe_ident_is_flat_pod_consumer_expr(g, cond, name, pod_ty, env, shadowed, depth) &&
      qbe_ident_is_flat_pod_consumer_expr(g, msg, name, pod_ty, env, shadowed, depth)
    SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_ident_is_flat_pod_consumer_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  start : Int,
  name : String,
  pod_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  let mut i = start
  while i < stmts.length() {
    if !qbe_ident_is_flat_pod_consumer_stmt(g, stmts[i], name, pod_ty, env, shadowed, depth) {
      return false
    }
    match stmts[i] {
      SLet(bname, _, _, _, _) => if bname == name { return true }
      SLetTuple(bnames, _, _, _) => {
        let mut bi = 0
        while bi < bnames.length() {
          if bnames[bi] == name {
            return true
          }
          bi = bi + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
/// P77-B: Pure static check whether parameter `param_idx` of `finfo` only borrows a `StrView`
/// or `BytesView` pointer without ever touching its RC header (`p - 24`) or letting it escape.
fn qbe_fn_param_is_view_borrow(
  g : QbeGen,
  target_pkg : String,
  _fn_key : String,
  finfo : FnInfo,
  param_idx : Int,
  depth : Int,
) -> Bool {
  if depth > 2 {
    return false
  }
  let ckey = qbe_borrow_cache_key("vb", target_pkg, finfo, param_idx)
  match g.pod_borrow_cache.get(ckey) {
    Some(v) => return v
    None => ()
  }
  if qbe_fn_is_stub_body(finfo.decl.body) {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if finfo.decl.type_params.length() != 0 {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if param_idx < 0 ||
    param_idx >= finfo.decl.params.length() ||
    param_idx >= finfo.param_tys.length() {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  if finfo.decl.params[param_idx].is_mut {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let param_ty = finfo.param_tys[param_idx]
  let is_view = match param_ty {
    TStrView | TBytesView => true
    _ => false
  }
  if !is_view {
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let param_name = finfo.decl.params[param_idx].name
  if param_name == "_" {
    g.pod_borrow_cache.set(ckey, true)
    return true
  }
  let saved_mono_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, target_pkg)
  let body = qbe_fn_body(g, finfo.decl.body)
  if qbe_stmts_calls_ident(body, finfo.decl.name) {
    g.mono_pkg = saved_mono_pkg
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let boxed = qbe_collect_boxed_mut_vars(body)
  if boxed.contains(param_name) {
    g.mono_pkg = saved_mono_pkg
    if depth == 0 {
      g.pod_borrow_cache.set(ckey, false)
    }
    return false
  }
  let penv : Map[String, Ty] = Map([])
  let mut pi = 0
  while pi < finfo.decl.params.length() && pi < finfo.param_tys.length() {
    penv.set(finfo.decl.params[pi].name, finfo.param_tys[pi])
    pi = pi + 1
  }
  let body_locals : Map[String, Bool] = Map([])
  qbe_collect_local_bind_names_stmts(body, body_locals)
  let bl_keys = body_locals.keys()
  let mut bi = 0
  while bi < bl_keys.length() {
    let bk = bl_keys[bi]
    if bk != param_name {
      penv.set(bk, TError)
    }
    bi = bi + 1
  }
  let ok = qbe_ident_is_view_consumer_stmts(
    g,
    body,
    0,
    param_name,
    param_ty,
    penv,
    body_locals,
    depth + 1,
  )
  g.mono_pkg = saved_mono_pkg
  if ok || depth == 0 {
    g.pod_borrow_cache.set(ckey, ok)
  }
  ok
}

///|
/// P77-B: Non-escaping consumer check for a stack-allocated `StrView`/`BytesView` local/param.
fn qbe_ident_is_view_consumer_expr(
  g : QbeGen,
  e : Expr,
  name : String,
  view_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EField(obj, _, _) =>
      qbe_ident_is_view_consumer_expr(g, obj, name, view_ty, env, shadowed, depth)
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ENamedArg(_, _, inner, _) =>
      qbe_ident_is_view_consumer_expr(g, inner, name, view_ty, env, shadowed, depth)
    EMutArg(inner, _) =>
      if qbe_mut_place_root(inner) == name {
        false
      } else {
        qbe_ident_is_view_consumer_expr(g, inner, name, view_ty, env, shadowed, depth)
      }
    EIndex(obj, idx, _) => {
      let obj_ok = match obj {
        EIdent(n, _) =>
          if n == name {
            !qbe_expr_has_assign(idx)
          } else {
            true
          }
        _ => qbe_ident_is_view_consumer_expr(g, obj, name, view_ty, env, shadowed, depth)
      }
      obj_ok && qbe_ident_is_view_consumer_expr(g, idx, name, view_ty, env, shadowed, depth)
    }
    EBinary(op, l, r, _) => {
      if (op == "==" || op == "!=") && !qbe_expr_has_assign(l) && !qbe_expr_has_assign(r) {
        let l_ok = match l {
          EIdent(n, _) => if n == name { true } else { true }
          _ => qbe_ident_is_view_consumer_expr(g, l, name, view_ty, env, shadowed, depth)
        }
        let r_ok = match r {
          EIdent(n, _) => if n == name { true } else { true }
          _ => qbe_ident_is_view_consumer_expr(g, r, name, view_ty, env, shadowed, depth)
        }
        return l_ok && r_ok
      }
      qbe_ident_is_view_consumer_expr(g, l, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_expr(g, r, name, view_ty, env, shadowed, depth)
    }
    ECall(callee, args, sp) => {
      if !qbe_ident_is_view_consumer_expr(g, callee, name, view_ty, env, shadowed, depth) {
        return false
      }
      let mut has_direct = false
      let mut i = 0
      while i < args.length() {
        match args[i] {
          EIdent(n, _) => if n == name { has_direct = true }
          ENamedArg(_, _, EIdent(n, _), _) => if n == name { has_direct = true }
          _ => ()
        }
        i = i + 1
      }
      if !has_direct {
        i = 0
        while i < args.length() {
          if !qbe_ident_is_view_consumer_expr(g, args[i], name, view_ty, env, shadowed, depth) {
            return false
          }
          i = i + 1
        }
        return true
      }
      if qbe_args_have_assign(args) {
        return false
      }
      let mut target_finfo : Option[FnInfo] = None
      let mut target_pkg = ""
      let mut fn_key = ""
      match callee {
        EIdent(fname, _) => {
          if fname == "Some" || fname == "Ok" || fname == "Err" {
            return false
          }
          let is_local_var = shadowed.contains(fname) ||
            (if env.length() > 0 {
              env.contains(fname)
            } else {
              match qbe_lookup_local(g, fname) {
                Some(_) => true
                None => false
              }
            })
          if !is_local_var && !g.inline_closures.contains(fname) {
            target_pkg = g.mono_pkg
            fn_key = fname
            target_finfo = if target_pkg == "" {
              g.tc.fns.get(fname)
            } else {
              match lookup_imported_pkg_transitive(g.tc, target_pkg) {
                Some(ipkg) =>
                  match ipkg.tc.fns.get(fname) {
                    Some(fi) => Some(qualify_fn_info(ipkg, fi))
                    None => None
                  }
                None => None
              }
            }
          }
        }
        EPath(qual, mem, _) => {
          fn_key = qual + "::" + mem
          if qbe_epath_is_variant_ctor_in_borrow_ctx(g, qual, mem) {
            return false
          }
          if has_qual_sep(qual) {
            let qp = split_qual_name(qual)
            match qbe_resolve_pkg_in_scope(g, qp.prefix) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(qp.name + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_pkg = ipkg.name
                    fn_key = qp.name + "::" + mem
                  }
                  None => ()
                }
              None => ()
            }
          }
          match target_finfo {
            None =>
              match qbe_resolve_pkg_in_scope(g, qual) {
                Some(ipkg) =>
                  match ipkg.tc.fns.get(mem) {
                    Some(fi) => {
                      target_finfo = Some(qualify_fn_info(ipkg, fi))
                      target_pkg = ipkg.name
                      fn_key = mem
                    }
                    None => ()
                  }
                None => ()
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              match qbe_lookup_method_info(g, qual, mem) {
                Some(minfo) => {
                  target_finfo = Some(minfo)
                  let qpm = split_qual_name(qual)
                  if qpm.prefix != "" {
                    target_pkg = qpm.prefix
                  } else if g.mono_pkg != "" {
                    target_pkg = g.mono_pkg
                  }
                }
                None =>
                  match qbe_lookup_method_in_borrow_ctx(g, qual, mem) {
                    Some((mpkg, minfo)) => {
                      target_finfo = Some(minfo)
                      target_pkg = mpkg
                    }
                    None => ()
                  }
              }
            Some(_) => ()
          }
        }
        _ => ()
      }
      match target_finfo {
        Some(finfo) => {
          if finfo.decl.type_params.length() != 0 {
            return false
          }
          let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
          if qbe_has_any_default(call_res.from_default) {
            return false
          }
          let norm_args = call_res.args
          if norm_args.length() != finfo.param_tys.length() ||
            qbe_args_have_assign(norm_args) {
            return false
          }
          let mut ai = 0
          while ai < norm_args.length() {
            match norm_args[ai] {
              EIdent(n, _) =>
                if n == name {
                  if !qbe_fn_param_is_view_borrow(g, target_pkg, fn_key, finfo, ai, depth) {
                    return false
                  }
                }
              _ =>
                if !qbe_ident_is_view_consumer_expr(g, norm_args[ai], name, view_ty, env, shadowed, depth) {
                  return false
                }
            }
            ai = ai + 1
          }
          true
        }
        None => false
      }
    }
    EMethodCall(obj, mname, args, sp) => {
      let recv_is_name = match obj {
        EIdent(n, _) => n == name
        _ => false
      }
      if recv_is_name {
        let ok_method = mname == "length" ||
          mname == "is_empty" ||
          mname == "code_unit_at" ||
          mname == "read_i8" ||
          mname == "read_f32_le" ||
          mname == "starts_with" ||
          mname == "ends_with" ||
          mname == "eq_str" ||
          mname == "index_of_byte" ||
          mname == "to_string" ||
          mname == "to_bytes" ||
          mname == "subview" ||
          mname == "trim"
        if !ok_method || qbe_args_have_assign(args) {
          return false
        }
        let mut i = 0
        while i < args.length() {
          if !qbe_ident_is_view_consumer_expr(g, args[i], name, view_ty, env, shadowed, depth) {
            return false
          }
          i = i + 1
        }
        return true
      }
      let mut arg_has_direct = false
      let mut i = 0
      while i < args.length() {
        match args[i] {
          EIdent(n, _) => if n == name { arg_has_direct = true }
          ENamedArg(_, _, EIdent(n, _), _) => if n == name { arg_has_direct = true }
          _ => ()
        }
        i = i + 1
      }
      if !arg_has_direct {
        if !qbe_ident_is_view_consumer_expr(g, obj, name, view_ty, env, shadowed, depth) {
          return false
        }
        i = 0
        while i < args.length() {
          if !qbe_ident_is_view_consumer_expr(g, args[i], name, view_ty, env, shadowed, depth) {
            return false
          }
          i = i + 1
        }
        return true
      }
      if mname == "to_string" || qbe_expr_has_assign(obj) || qbe_args_have_assign(args) {
        return false
      }
      let recv_ty = match qbe_probe_ty_with_env(g, obj, env, shadowed) {
        Some(rt) => subst_ty(rt, g.cur_type_subst)
        None => return false
      }
      let sname = match recv_ty {
        TStruct(sn, sargs) =>
          if sargs.length() == 0 {
            sn
          } else {
            return false
          }
        _ => return false
      }
      match qbe_lookup_method_in_borrow_ctx(g, sname, mname) {
        Some((mpkg, minfo)) => {
          if minfo.decl.type_params.length() != 0 {
            return false
          }
          let call_res = resolve_call_args_qbe_full(minfo.decl.params, 1, args, sp)
          if qbe_has_any_default(call_res.from_default) {
            return false
          }
          let norm_args = call_res.args
          if norm_args.length() + 1 != minfo.param_tys.length() ||
            qbe_args_have_assign(norm_args) {
            return false
          }
          if !qbe_ident_is_view_consumer_expr(g, obj, name, view_ty, env, shadowed, depth) {
            return false
          }
          let mkey = sname + "::" + mname
          let mut ai = 0
          while ai < norm_args.length() {
            match norm_args[ai] {
              EIdent(n, _) =>
                if n == name {
                  if !qbe_fn_param_is_view_borrow(g, mpkg, mkey, minfo, ai + 1, depth) {
                    return false
                  }
                }
              _ =>
                if !qbe_ident_is_view_consumer_expr(g, norm_args[ai], name, view_ty, env, shadowed, depth) {
                  return false
                }
            }
            ai = ai + 1
          }
          true
        }
        None => false
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_view_consumer_expr(g, elems[i], name, view_ty, env, shadowed, depth) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) =>
          if !qbe_ident_is_view_consumer_expr(g, b, name, view_ty, env, shadowed, depth) {
            return false
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_view_consumer_expr(g, fields[i].value, name, view_ty, env, shadowed, depth) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) =>
      qbe_ident_is_view_consumer_stmts(g, stmts, 0, name, view_ty, env, shadowed, depth)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_view_consumer_expr(g, cond, name, view_ty, env, shadowed, depth) ||
        !qbe_ident_is_view_consumer_stmts(g, then_stmts, 0, name, view_ty, env, shadowed, depth) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_view_consumer_expr(g, el, name, view_ty, env, shadowed, depth)
      }
    }
    EIs(scrut, _, _) =>
      qbe_ident_is_view_consumer_expr(g, scrut, name, view_ty, env, shadowed, depth)
    EMatch(scrut, arms, _) => {
      if !qbe_ident_is_view_consumer_expr(g, scrut, name, view_ty, env, shadowed, depth) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_view_consumer_expr(g, ge, name, view_ty, env, shadowed, depth) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_view_consumer_expr(g, arms[i].body, name, view_ty, env, shadowed, depth) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    ETry(inner, _) =>
      qbe_ident_is_view_consumer_expr(g, inner, name, view_ty, env, shadowed, depth)
    EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | EInterp(_, _)
    | EDotVariant(_, _, _) => !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_view_consumer_stmt(
  g : QbeGen,
  s : Stmt,
  name : String,
  view_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_ident_is_view_consumer_expr(g, init, name, view_ty, env, shadowed, depth)
    SLetTuple(_, _, init, _) =>
      qbe_ident_is_view_consumer_expr(g, init, name, view_ty, env, shadowed, depth)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_ident_is_view_consumer_expr(g, lhs, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_expr(g, rhs, name, view_ty, env, shadowed, depth)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_view_consumer_expr(g, cond, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_stmts(g, body, 0, name, view_ty, env, shadowed, depth)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_view_consumer_stmt(g, init_s, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_expr(g, cond, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_stmt(g, step_s, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_stmts(g, body, 0, name, view_ty, env, shadowed, depth)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_view_consumer_expr(g, start_e, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_expr(g, end_e, name, view_ty, env, shadowed, depth) &&
      (vname == name ||
        qbe_ident_is_view_consumer_stmts(g, body, 0, name, view_ty, env, shadowed, depth))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_view_consumer_expr(g, iter_e, name, view_ty, env, shadowed, depth) &&
      (vname == name ||
        qbe_ident_is_view_consumer_stmts(g, body, 0, name, view_ty, env, shadowed, depth))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => {
          if depth == 0 {
            match e {
              EIdent(n, _) => if n == name { return true }
              ECall(EIdent(cn, _), cargs, _) =>
                if (cn == "Some" || cn == "Ok") && cargs.length() == 1 {
                  match cargs[0] {
                    EIdent(n, _) => if n == name { return true }
                    _ => ()
                  }
                }
              EDotVariant(vn, vargs, _) =>
                if (vn == "Some" || vn == "Ok") && vargs.length() == 1 {
                  match vargs[0] {
                    EIdent(n, _) => if n == name { return true }
                    _ => ()
                  }
                }
              _ => ()
            }
          }
          qbe_ident_is_view_consumer_expr(g, e, name, view_ty, env, shadowed, depth)
        }
      }
    SExpr(e, _) =>
      qbe_ident_is_view_consumer_expr(g, e, name, view_ty, env, shadowed, depth)
    SDebugAssert(cond, msg, _) =>
      qbe_ident_is_view_consumer_expr(g, cond, name, view_ty, env, shadowed, depth) &&
      qbe_ident_is_view_consumer_expr(g, msg, name, view_ty, env, shadowed, depth)
    SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_ident_is_view_consumer_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  start : Int,
  name : String,
  view_ty : Ty,
  env : Map[String, Ty],
  shadowed : Map[String, Bool],
  depth : Int,
) -> Bool {
  let mut i = start
  while i < stmts.length() {
    if !qbe_ident_is_view_consumer_stmt(g, stmts[i], name, view_ty, env, shadowed, depth) {
      return false
    }
    match stmts[i] {
      SLet(bname, _, _, _, _) => if bname == name { return true }
      SLetTuple(bnames, _, _, _) => {
        let mut bi = 0
        while bi < bnames.length() {
          if bnames[bi] == name {
            return true
          }
          bi = bi + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_emit_jnz_l(
  g : QbeGen,
  lreg : String,
  l_true : String,
  l_false : String,
) -> Unit {
  if qbe_is_temp_reg(lreg) {
    let w = qbe_tmp(g)
    qbe_emit(g, w + " =w cnel " + lreg + ", 0")
    qbe_emit_term(g, "jnz " + w + ", " + l_true + ", " + l_false)
  } else {
    qbe_emit_term(g, "jnz " + lreg + ", " + l_true + ", " + l_false)
  }
}

///|
fn qbe_rc_inc(g : QbeGen, vreg : String, raw_ty : Ty) -> Unit {
  if vreg == "0" || g.immortal_regs.contains(vreg) {
    return
  }
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "rci_do")
        let l_sk = qbe_lbl(g, "rci_sk")
        qbe_emit_jnz_l(g, "%tp_" + tn, l_do, l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_inc(l " + vreg + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
      }
    _ =>
      if qbe_is_obj_ty(g, ty) {
        qbe_emit(g, "call $pion_rc_inc(l " + vreg + ")")
      }
  }
}

///|
fn qbe_rc_dec(g : QbeGen, vreg : String, raw_ty : Ty) -> Unit {
  if vreg == "0" || g.immortal_regs.contains(vreg) {
    return
  }
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "rcd_do")
        let l_sk = qbe_lbl(g, "rcd_sk")
        qbe_emit_jnz_l(g, "%tp_" + tn, l_do, l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_dec(l " + vreg + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
      }
    _ =>
      if qbe_is_obj_ty(g, ty) {
        qbe_emit(g, "call $pion_rc_dec(l " + vreg + ")")
      }
  }
}

///|
fn qbe_record_scalar_const(g : QbeGen, cd : ConstDecl, cty : Ty) -> Unit {
  match cty {
    TInt =>
      match cd.value {
        EInt(raw, _) =>
          g.const_int_vals.set(cd.name, qbe_parse_int64_lit(raw).to_int())
        EUnary("-", EInt(raw, _), _) =>
          g.const_int_vals.set(cd.name, 0 - qbe_parse_int64_lit(raw).to_int())
        _ => ()
      }
    TInt64 =>
      match cd.value {
        EInt64(raw, _) | EInt(raw, _) =>
          g.const_i64_vals.set(cd.name, qbe_parse_int64_lit(raw))
        EUnary("-", EInt64(raw, _), _) | EUnary("-", EInt(raw, _), _) =>
          g.const_i64_vals.set(cd.name, 0L - qbe_parse_int64_lit(raw))
        _ => ()
      }
    TBool =>
      match cd.value {
        EBool(b, _) => g.const_bool_vals.set(cd.name, b)
        _ => ()
      }
    TFixedArray(_) | TImmArray(_) =>
      match cd.value {
        EArrayLit(elems, _) =>
          if elems.length() >= 1 {
            g.global_min_len_arrs.set(cd.name, elems.length())
            g.fixed_literal_lengths.set(cd.name, elems.length())
          }
        ECall(EPath("FixedArray", "make", _), args, _)
        | ECall(EPath("ImmArray", "make", _), args, _) =>
          if args.length() == 2 {
            match qbe_eval_const_int_expr(g, args[0]) {
              Some(n) =>
                if n >= 1 {
                  g.global_min_len_arrs.set(cd.name, n)
                }
              None => ()
            }
          }
        _ => ()
      }
    _ => ()
  }
}

///|
fn qbe_try_const_int(g : QbeGen, e : Expr) -> Option[Int] {
  match e {
    EInt(raw, _) => Some(qbe_parse_int64_lit(raw).to_int())
    EUnary("-", EInt(raw, _), _) => Some(0 - qbe_parse_int64_lit(raw).to_int())
    EIdent(name, _) =>
      if g.mono_pkg == "" {
        match qbe_lookup_local(g, name) {
          Some(_) => None
          None => g.const_int_vals.get(name)
        }
      } else {
        None
      }
    _ => None
  }
}

///|
fn qbe_emit_str_code_unit_at(
  g : QbeGen,
  str_reg : String,
  idx_expr : Expr,
  str_local_name : String,
) -> String {
  let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
  let il = qbe_as_l(g, iv)
  let bce_safe = if str_local_name != "" {
    qbe_bce_expr_is_safe(g, str_local_name, idx_expr)
  } else {
    false
  }
  if !bce_safe {
    let slen = match g.hoisted_str_len.get(str_local_name) {
      Some(hl) => hl
      None => {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l loadl " + str_reg)
        t
      }
    }
    let oob = qbe_tmp(g)
    let l_oob = qbe_lbl(g, "str_oob")
    let l_ok = qbe_lbl(g, "str_ok")
    qbe_emit(g, oob + " =w cugel " + il + ", " + slen)
    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
    qbe_emit_lbl(g, l_oob)
    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + slen + ")")
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_ok)
  }
  let base = match g.hoisted_str_dp.get(str_local_name) {
    Some(hdp) => hdp
    None => {
      let b = qbe_tmp(g)
      qbe_emit(g, b + " =l add " + str_reg + ", 8")
      b
    }
  }
  let ep = qbe_tmp(g)
  let bw = qbe_tmp(g)
  qbe_emit(g, ep + " =l add " + base + ", " + il)
  qbe_emit(g, bw + " =w loadub " + ep)
  bw
}

///|
fn qbe_hex_nibble_lower(n : Int) -> Char {
  if n < 10 {
    (48 + n).unsafe_to_char()
  } else {
    (97 + (n - 10)).unsafe_to_char()
  }
}

///|
fn qbe_mangle_ident_rev(s : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
      sb.write_char(c.unsafe_to_char())
    } else if c == 95 {
      sb.write_string("_u")
    } else if c == 45 {
      sb.write_string("_d")
    } else {
      sb.write_string("_x")
      sb.write_char(qbe_hex_nibble_lower((c >> 4) & 15))
      sb.write_char(qbe_hex_nibble_lower(c & 15))
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_ident_is_plain_ascii(s : String) -> Bool {
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_freeze_ty_key_nom(prefix : String, name : String, args : Array[Ty]) -> String {
  let qp = split_qual_name(name)
  let sb = StringBuilder()
  sb.write_string(prefix)
  if qp.prefix.length() > 0 {
    let ep = qbe_mangle_ident_rev(qp.prefix)
    let eb = qbe_mangle_ident_rev(qp.name)
    sb.write_string("_0P")
    sb.write_string(ep.length().to_string())
    sb.write_string("_")
    sb.write_string(ep)
    sb.write_string("_N")
    sb.write_string(eb.length().to_string())
    sb.write_string("_")
    sb.write_string(eb)
  } else {
    let eb = qbe_mangle_ident_rev(qp.name)
    sb.write_string("_0N")
    sb.write_string(eb.length().to_string())
    sb.write_string("_")
    sb.write_string(eb)
  }
  sb.write_string("_A")
  sb.write_string(args.length().to_string())
  let mut i = 0
  while i < args.length() {
    sb.write_string("_")
    sb.write_string(qbe_freeze_ty_key_inner(args[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_freeze_ty_key_inner(ty : Ty) -> String {
  match ty {
    TInt => "i"
    TInt64 => "i64"
    TUInt => "u32"
    TUInt64 => "u64"
    TDouble => "d"
    TFloat => "f32"
    TBool => "b"
    TByte => "u8"
    TInt8 => "i8"
    TChar => "ch"
    TString => "str"
    TBytes => "bytes"
    TStrView => "strview"
    TBytesView => "bytesview"
    TStringBuilder => "sb"
    TPtr => "ptr"
    TUnit => "u"
    TStruct(sname, sargs) => qbe_freeze_ty_key_nom("st", sname, sargs)
    TEnum(ename, eargs) => qbe_freeze_ty_key_nom("en", ename, eargs)
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("tup_A")
      sb.write_string(elems.length().to_string())
      let mut i = 0
      while i < elems.length() {
        sb.write_string("_")
        sb.write_string(qbe_freeze_ty_key_inner(elems[i]))
        i = i + 1
      }
      sb.to_string()
    }
    TOption(inner) => "opt_" + qbe_freeze_ty_key_inner(inner)
    TResult(ok_ty, err_ty) =>
      "res_" + qbe_freeze_ty_key_inner(ok_ty) + "_" + qbe_freeze_ty_key_inner(err_ty)
    TArray(elem) => "arr_" + qbe_freeze_ty_key_inner(elem)
    TFixedArray(elem) => "farr_" + qbe_freeze_ty_key_inner(elem)
    TImmArray(elem) => "iarr_" + qbe_freeze_ty_key_inner(elem)
    TMap(kty, vty) =>
      "map_" + qbe_freeze_ty_key_inner(kty) + "_" + qbe_freeze_ty_key_inner(vty)
    _ => "obj"
  }
}

///|
fn qbe_freeze_ty_key(ty : Ty) -> String {
  match ty {
    TStruct(sname, sargs) if sargs.length() == 0 && !has_qual_sep(sname) && qbe_ident_is_plain_ascii(sname) =>
      "st_" + sname
    TEnum(ename, eargs) if eargs.length() == 0 && !has_qual_sep(ename) && qbe_ident_is_plain_ascii(ename) =>
      "en_" + ename
    _ => qbe_freeze_ty_key_inner(ty)
  }
}

///|
fn qbe_ensure_freeze_fn(g : QbeGen, ty : Ty) -> String {
  if !qbe_is_obj_ty(g, ty) {
    return ""
  }
  match ty {
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let obj_slots : Array[Int] = []
          let obj_tys : Array[Ty] = []
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            let fty = subst_ty(sinfo.field_tys[fi], subst)
            if qbe_is_obj_ty(g, fty) {
              obj_slots.push(fi)
              obj_tys.push(fty)
            }
            fi = fi + 1
          }
          if obj_slots.length() == 0 {
            return "$pion_rc_freeze"
          }
          let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
          if g.freeze_fn_seen.contains(fn_sym) {
            return fn_sym
          }
          g.freeze_fn_seen.set(fn_sym, true)
          let child_syms : Array[String] = []
          let mut ci = 0
          while ci < obj_tys.length() {
            child_syms.push(qbe_ensure_freeze_fn(g, obj_tys[ci]))
            ci = ci + 1
          }
          let sb = StringBuilder()
          sb.write_string("function ")
          sb.write_string(fn_sym)
          sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n")
          let mut j = 0
          while j < obj_slots.length() {
            let off = obj_slots[j] * 8
            sb.write_string("    %a")
            sb.write_string(j.to_string())
            sb.write_string(" =l add %obj, ")
            sb.write_string(off.to_string())
            sb.write_string("\n    %v")
            sb.write_string(j.to_string())
            sb.write_string(" =l loadl %a")
            sb.write_string(j.to_string())
            sb.write_string("\n    call ")
            sb.write_string(child_syms[j])
            sb.write_string("(l %v")
            sb.write_string(j.to_string())
            sb.write_string(")\n")
            j = j + 1
          }
          sb.write_string("@done\n    ret\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => "$pion_rc_freeze"
      }
    TTuple(elems) => {
      let obj_slots : Array[Int] = []
      let obj_tys : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        if qbe_is_obj_ty(g, elems[i]) {
          obj_slots.push(i)
          obj_tys.push(elems[i])
        }
        i = i + 1
      }
      if obj_slots.length() == 0 {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_syms : Array[String] = []
      let mut ci = 0
      while ci < obj_tys.length() {
        child_syms.push(qbe_ensure_freeze_fn(g, obj_tys[ci]))
        ci = ci + 1
      }
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n")
      let mut j = 0
      while j < obj_slots.length() {
        let off = obj_slots[j] * 8
        sb.write_string("    %a")
        sb.write_string(j.to_string())
        sb.write_string(" =l add %obj, ")
        sb.write_string(off.to_string())
        sb.write_string("\n    %v")
        sb.write_string(j.to_string())
        sb.write_string(" =l loadl %a")
        sb.write_string(j.to_string())
        sb.write_string("\n    call ")
        sb.write_string(child_syms[j])
        sb.write_string("(l %v")
        sb.write_string(j.to_string())
        sb.write_string(")\n")
        j = j + 1
      }
      sb.write_string("@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TOption(inner) => {
      if qbe_is_niche_opt_inner(g, inner) {
        return qbe_ensure_freeze_fn(g, inner)
      }
      if !qbe_is_obj_ty(g, inner) {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, inner)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n    %is1 =w ceql %tag, 1\n    jnz %is1, @some, @done\n@some\n    %a =l add %obj, 8\n    %v =l loadl %a\n    call ")
      sb.write_string(child_sym)
      sb.write_string("(l %v)\n@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TResult(ok_ty, err_ty) => {
      let ok_obj = qbe_is_obj_ty(g, ok_ty)
      let err_obj = qbe_is_obj_ty(g, err_ty)
      if !ok_obj && !err_obj {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let ok_sym = if ok_obj { qbe_ensure_freeze_fn(g, ok_ty) } else { "" }
      let err_sym = if err_obj { qbe_ensure_freeze_fn(g, err_ty) } else { "" }
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n    %is0 =w ceql %tag, 0\n    jnz %is0, @ok_b, @err_b\n@ok_b\n")
      if ok_obj {
        sb.write_string("    %ao =l add %obj, 8\n    %vo =l loadl %ao\n    call ")
        sb.write_string(ok_sym)
        sb.write_string("(l %vo)\n")
      }
      sb.write_string("    jmp @done\n@err_b\n")
      if err_obj {
        sb.write_string("    %ae =l add %obj, 8\n    %ve =l loadl %ae\n    call ")
        sb.write_string(err_sym)
        sb.write_string("(l %ve)\n")
      }
      sb.write_string("@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TEnum(ename, eargs) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let layout = qbe_enum_layout_for_info(einfo)
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut any_obj = false
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_is_obj_ty(g, subst_ty(v.field_tys[fi], subst)) {
                any_obj = true
                break
              }
              fi = fi + 1
            }
            if any_obj {
              break
            }
            vi = vi + 1
          }
          if !any_obj {
            return "$pion_rc_freeze"
          }
          let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
          if g.freeze_fn_seen.contains(fn_sym) {
            return fn_sym
          }
          g.freeze_fn_seen.set(fn_sym, true)
          let sb = StringBuilder()
          sb.write_string("function ")
          sb.write_string(fn_sym)
          if layout.is_niche {
            sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n")
            let pv = einfo.variants[layout.payload_tag]
            let mut fi = 0
            let mut j = 0
            while fi < pv.field_tys.length() {
              let fty = subst_ty(pv.field_tys[fi], subst)
              if qbe_is_obj_ty(g, fty) {
                let child_sym = qbe_ensure_freeze_fn(g, fty)
                let off = layout.payload_offset + fi * 8
                if off == 0 {
                  sb.write_string("    %v_")
                  sb.write_string(j.to_string())
                  sb.write_string(" =l loadl %obj\n")
                } else {
                  sb.write_string("    %a_")
                  sb.write_string(j.to_string())
                  sb.write_string(" =l add %obj, ")
                  sb.write_string(off.to_string())
                  sb.write_string("\n    %v_")
                  sb.write_string(j.to_string())
                  sb.write_string(" =l loadl %a_")
                  sb.write_string(j.to_string())
                  sb.write_string("\n")
                }
                sb.write_string("    call ")
                sb.write_string(child_sym)
                sb.write_string("(l %v_")
                sb.write_string(j.to_string())
                sb.write_string(")\n")
                j = j + 1
              }
              fi = fi + 1
            }
            sb.write_string("@done\n    ret\n}\n\n")
            g.extra_fns.push(sb.to_string())
            return fn_sym
          }
          sb.write_string("(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n")
          vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let obj_slots : Array[Int] = []
            let child_syms : Array[String] = []
            let mut fi = 0
            while fi < v.field_tys.length() {
              let fty = subst_ty(v.field_tys[fi], subst)
              if qbe_is_obj_ty(g, fty) {
                obj_slots.push(fi)
                child_syms.push(qbe_ensure_freeze_fn(g, fty))
              }
              fi = fi + 1
            }
            if obj_slots.length() > 0 {
              sb.write_string("    %c")
              sb.write_string(vi.to_string())
              sb.write_string(" =w ceql %tag, ")
              sb.write_string(vi.to_string())
              sb.write_string("\n    jnz %c")
              sb.write_string(vi.to_string())
              sb.write_string(", @v")
              sb.write_string(vi.to_string())
              sb.write_string(", @n")
              sb.write_string(vi.to_string())
              sb.write_string("\n@v")
              sb.write_string(vi.to_string())
              sb.write_string("\n")
              let mut j = 0
              while j < obj_slots.length() {
                let off = layout.payload_offset + obj_slots[j] * 8
                sb.write_string("    %a")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(" =l add %obj, ")
                sb.write_string(off.to_string())
                sb.write_string("\n    %v")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(" =l loadl %a")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string("\n    call ")
                sb.write_string(child_syms[j])
                sb.write_string("(l %v")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(")\n")
                j = j + 1
              }
              sb.write_string("    ret\n@n")
              sb.write_string(vi.to_string())
              sb.write_string("\n")
            }
            vi = vi + 1
          }
          sb.write_string("@done\n    ret\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => "$pion_rc_freeze"
      }
    TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
      if !qbe_is_obj_ty(g, elem) {
        return "$pion_rc_freeze"
      }
      match qbe_flat_pod_struct_info(g, elem) {
        Some(sinfo) => {
          let ftys = qbe_flat_struct_field_tys(g, sinfo, elem)
          let obj_fis : Array[Int] = []
          let mut fi = 0
          while fi < ftys.length() {
            if qbe_is_obj_ty(g, ftys[fi]) {
              obj_fis.push(fi)
            }
            fi = fi + 1
          }
          if obj_fis.length() == 0 {
            return "$pion_rc_freeze"
          }
          let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
          if g.freeze_fn_seen.contains(fn_sym) {
            return fn_sym
          }
          g.freeze_fn_seen.set(fn_sym, true)
          let child_syms : Array[String] = []
          let mut ci = 0
          while ci < obj_fis.length() {
            child_syms.push(qbe_ensure_freeze_fn(g, ftys[obj_fis[ci]]))
            ci = ci + 1
          }
          let stride = ftys.length() * 8
          let sb = StringBuilder()
          sb.write_string("function ")
          sb.write_string(fn_sym)
          sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %len =l loadl %obj\n    %dp_p =l add %obj, 24\n    %dp =l loadl %dp_p\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %len\n    jnz %c, @step, @done\n@step\n    %off =l mul %i, ")
          sb.write_string(stride.to_string())
          sb.write_string("\n    %ep =l add %dp, %off\n")
          ci = 0
          while ci < obj_fis.length() {
            let f_idx = obj_fis[ci]
            let f_off = f_idx * 8
            sb.write_string("    %fp_")
            sb.write_string(ci.to_string())
            sb.write_string(" =l add %ep, ")
            sb.write_string(f_off.to_string())
            sb.write_string("\n    %fv_")
            sb.write_string(ci.to_string())
            sb.write_string(" =l loadl %fp_")
            sb.write_string(ci.to_string())
            sb.write_string("\n    call ")
            sb.write_string(child_syms[ci])
            sb.write_string("(l %fv_")
            sb.write_string(ci.to_string())
            sb.write_string(")\n")
            ci = ci + 1
          }
          sb.write_string("    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
          g.extra_fns.push(sb.to_string())
          return fn_sym
        }
        None => ()
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, elem)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %len =l loadl %obj\n    %dp_p =l add %obj, 24\n    %dp =l loadl %dp_p\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %len\n    jnz %c, @step, @done\n@step\n    %off =l shl %i, 3\n    %ep =l add %dp, %off\n    %ev =l loadl %ep\n    call ")
      sb.write_string(child_sym)
      sb.write_string("(l %ev)\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TMap(kty, vty) => {
      if !qbe_is_obj_ty(g, vty) {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, vty)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      if qbe_is_vmap_key_ty(g, kty) {
        let lay = qbe_vmap_layout(qbe_vmap_key_fields(g, kty), vty)
        sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %cap_p =l add %obj, 8\n    %cap =l loadl %cap_p\n    %bp_p =l add %obj, 16\n    %buf =l loadl %bp_p\n    %buf_nz =w cnel %buf, 0\n    jnz %buf_nz, @has_buf, @done\n@has_buf\n    %slots =l add %buf, %cap\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %cap\n    jnz %c, @step, @done\n@step\n    %cp =l add %buf, %i\n    %st =w loadub %cp\n    jnz %st, @fval, @next\n@fval\n")
        qbe_vmap_idx_mul(sb, "%off", "%i", lay.slot_bytes)
        sb.write_string("    %sp =l add %slots, %off\n    %vp =l add %sp, ")
        sb.write_string(lay.v_off.to_string())
        sb.write_string("\n    %ev =l loadl %vp\n    call ")
        sb.write_string(child_sym)
        sb.write_string("(l %ev)\n@next\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
      } else {
        sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %cap_p =l add %obj, 8\n    %cap =l loadl %cap_p\n    %ep_p =l add %obj, 24\n    %ep =l loadl %ep_p\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %cap\n    jnz %c, @step, @done\n@step\n    %off =l shl %i, 5\n    %ent =l add %ep, %off\n    %st_p =l add %ent, 24\n    %st =w loadub %st_p\n    %occ =w ceqw %st, 1\n    jnz %occ, @fval, @next\n@fval\n    %vp =l add %ent, 16\n    %ev =l loadl %vp\n    call ")
        sb.write_string(child_sym)
        sb.write_string("(l %ev)\n@next\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
      }
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TStrView => {
      let fn_sym = "$pion_freeze_strview"
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      g.extra_fns.push(
        "function $pion_freeze_strview(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %o =l loadl %obj\n    %o_nz =w cnel %o, 0\n    jnz %o_nz, @fo, @done\n@fo\n    call $pion_rc_freeze(l %o)\n@done\n    ret\n}\n\n",
      )
      fn_sym
    }
    TDynTrait(_) => {
      let fn_sym = "$pion_freeze_dyn"
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      g.extra_fns.push(
        "function $pion_freeze_dyn(l %obj) {\n@start\n    %obj_nz =w cnel %obj, 0\n    jnz %obj_nz, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %vp =l add %obj, 8\n    %vt =l loadl %vp\n    %fa =l add %vt, 8\n    %fz =l loadl %fa\n    %fz_nz =w cnel %fz, 0\n    jnz %fz_nz, @call_fz, @done\n@call_fz\n    %data =l loadl %obj\n    call %fz(l %data)\n@done\n    ret\n}\n\n",
      )
      fn_sym
    }
    _ => "$pion_rc_freeze"
  }
}

///|
/// P77: Zero-copy StrView / BytesView helpers (pure QBE SSA, +0 B in libpionrt.a).
/// Layout (24 B payload, PION_TAG_STRUCT = 4):
///   +0:  owner : l (underlying PionString or PionBytes, RC-retained)
///   +8:  ptr   : l (direct byte pointer = owner_data + start, or 0 when len == 0)
///   +16: len   : l (byte length = end - start)
fn qbe_ensure_view_drop_fn(g : QbeGen) -> String {
  let fn_sym = "$pion_" + g.pkg_prefix + "view_drop"
  if g.eq_fn_seen.contains(fn_sym) {
    return fn_sym
  }
  g.eq_fn_seen.set(fn_sym, true)
  g.extra_fns.push(
    "function " +
    fn_sym +
    "(l %v) {\n@start\n    %o =l loadl %v\n    %o_nz =w cnel %o, 0\n    jnz %o_nz, @dec, @done\n@dec\n    call $pion_rc_dec(l %o)\n@done\n    ret\n}\n\n",
  )
  fn_sym
}

///|
fn qbe_ensure_view_eq_bytes_fn(g : QbeGen) -> String {
  let fn_sym = "$pion_" + g.pkg_prefix + "view_eq_bytes"
  if g.eq_fn_seen.contains(fn_sym) {
    return fn_sym
  }
  g.eq_fn_seen.set(fn_sym, true)
  if !g.target_wasm {
    g.extra_fns.push(
      "function w " +
      fn_sym +
      "(l %p1, l %p2, l %n) {\n@start\n    %is0 =w ceql %n, 0\n    jnz %is0, @ret1, @chk_same\n@chk_same\n    %same =w ceql %p1, %p2\n    jnz %same, @ret1, @do_cmp\n@do_cmp\n    %mc =w call $memcmp(l %p1, l %p2, l %n)\n    %eq =w ceqw %mc, 0\n    ret %eq\n@ret1\n    ret 1\n}\n\n",
    )
  } else {
    g.extra_fns.push(
      "function w " +
      fn_sym +
      "(l %p1, l %p2, l %n) {\n@start\n    %i_slot =l alloc8 8\n    %is0 =w ceql %n, 0\n    jnz %is0, @ret1, @chk_same\n@chk_same\n    %same =w ceql %p1, %p2\n    jnz %same, @ret1, @init\n@init\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %done =w cugel %i, %n\n    jnz %done, @ret1, @body\n@body\n    %a1 =l add %p1, %i\n    %a2 =l add %p2, %i\n    %b1 =w loadub %a1\n    %b2 =w loadub %a2\n    %eq =w ceqw %b1, %b2\n    jnz %eq, @next, @ret0\n@next\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@ret1\n    ret 1\n@ret0\n    ret 0\n}\n\n",
    )
  }
  fn_sym
}

///|
fn qbe_emit_view_stack_alloc(
  g : QbeGen,
  owner_reg : String,
  ptr_reg : String,
  len_reg : String,
) -> String {
  let v = qbe_alloc_stack_buf(g, 24)
  let p_off = qbe_tmp(g)
  let l_off = qbe_tmp(g)
  qbe_emit(g, "storel " + owner_reg + ", " + v)
  qbe_emit(g, p_off + " =l add " + v + ", 8")
  qbe_emit(g, "storel " + ptr_reg + ", " + p_off)
  qbe_emit(g, l_off + " =l add " + v + ", 16")
  qbe_emit(g, "storel " + len_reg + ", " + l_off)
  v
}

///|
fn qbe_emit_view_alloc(
  g : QbeGen,
  owner_reg : String,
  ptr_reg : String,
  len_reg : String,
) -> String {
  let drop_sym = qbe_ensure_view_drop_fn(g)
  let v = qbe_tmp(g)
  let p_off = qbe_tmp(g)
  let l_off = qbe_tmp(g)
  qbe_emit(g, v + " =l call $pion_alloc_uninit(w 24, w 4, l " + drop_sym + ")")
  qbe_emit(g, "call $pion_rc_inc(l " + owner_reg + ")")
  qbe_emit(g, "storel " + owner_reg + ", " + v)
  qbe_emit(g, p_off + " =l add " + v + ", 8")
  qbe_emit(g, "storel " + ptr_reg + ", " + p_off)
  qbe_emit(g, l_off + " =l add " + v + ", 16")
  qbe_emit(g, "storel " + len_reg + ", " + l_off)
  v
}

///|
/// P81 (P77-C): On-demand heap materialization of a stack-allocated StrView/BytesView
/// on a cold escaping return edge (`return v` / `return Some(v)` / `return Ok(v)`).
fn qbe_emit_view_materialize(g : QbeGen, stk_reg : String) -> String {
  let owner = qbe_tmp(g)
  let pp = qbe_tmp(g)
  let ptr = qbe_tmp(g)
  let lp = qbe_tmp(g)
  let len = qbe_tmp(g)
  qbe_emit(g, owner + " =l loadl " + stk_reg)
  qbe_emit(g, pp + " =l add " + stk_reg + ", 8")
  qbe_emit(g, ptr + " =l loadl " + pp)
  qbe_emit(g, lp + " =l add " + stk_reg + ", 16")
  qbe_emit(g, len + " =l loadl " + lp)
  qbe_emit_view_alloc(g, owner, ptr, len)
}

///|
fn qbe_emit_view_slice_parts(
  g : QbeGen,
  base_ptr : String,
  base_len : String,
  start_l : String,
  end_l : String,
) -> (String, String) {
  let l_oob = qbe_lbl(g, "view_oob")
  let l_chk2 = qbe_lbl(g, "view_chk2")
  let l_chk3 = qbe_lbl(g, "view_chk3")
  let l_ok = qbe_lbl(g, "view_ok")
  let l_empty = qbe_lbl(g, "view_empty")
  let l_nonempty = qbe_lbl(g, "view_ne")
  let l_done = qbe_lbl(g, "view_done")
  let bad1 = qbe_tmp(g)
  qbe_emit(g, bad1 + " =w csltl " + start_l + ", 0")
  qbe_emit_term(g, "jnz " + bad1 + ", " + l_oob + ", " + l_chk2)
  qbe_emit_lbl(g, l_chk2)
  let bad2 = qbe_tmp(g)
  qbe_emit(g, bad2 + " =w csltl " + end_l + ", " + start_l)
  qbe_emit_term(g, "jnz " + bad2 + ", " + l_oob + ", " + l_chk3)
  qbe_emit_lbl(g, l_chk3)
  let bad3 = qbe_tmp(g)
  qbe_emit(g, bad3 + " =w csgtl " + end_l + ", " + base_len)
  qbe_emit_term(g, "jnz " + bad3 + ", " + l_oob + ", " + l_ok)
  qbe_emit_lbl(g, l_oob)
  qbe_emit(g, "call $pion_panic_oob(l " + end_l + ", l " + base_len + ")")
  qbe_emit_term(g, "hlt")
  qbe_emit_lbl(g, l_ok)
  let new_len = qbe_tmp(g)
  let is_z = qbe_tmp(g)
  qbe_emit(g, new_len + " =l sub " + end_l + ", " + start_l)
  qbe_emit(g, is_z + " =w ceql " + new_len + ", 0")
  qbe_emit_term(g, "jnz " + is_z + ", " + l_empty + ", " + l_nonempty)
  qbe_emit_lbl(g, l_empty)
  qbe_emit_term(g, "jmp " + l_done)
  qbe_emit_lbl(g, l_nonempty)
  let ne_ptr = qbe_tmp(g)
  qbe_emit(g, ne_ptr + " =l add " + base_ptr + ", " + start_l)
  qbe_emit_term(g, "jmp " + l_done)
  qbe_emit_lbl(g, l_done)
  let final_ptr = qbe_tmp(g)
  qbe_emit(g, final_ptr + " =l phi " + l_empty + " 0, " + l_nonempty + " " + ne_ptr)
  (final_ptr, new_len)
}

///|
fn qbe_emit_view_slice(
  g : QbeGen,
  owner_reg : String,
  base_ptr : String,
  base_len : String,
  start_l : String,
  end_l : String,
) -> String {
  let (final_ptr, new_len) = qbe_emit_view_slice_parts(
    g,
    base_ptr,
    base_len,
    start_l,
    end_l,
  )
  qbe_emit_view_alloc(g, owner_reg, final_ptr, new_len)
}

///|
fn qbe_emit_view_trim_parts(
  g : QbeGen,
  bptr : String,
  blen : String,
) -> (String, String) {
  let lo_slot = qbe_alloc_slot(g)
  let hi_slot = qbe_alloc_slot(g)
  qbe_emit(g, "storel 0, " + lo_slot)
  qbe_emit(g, "storel " + blen + ", " + hi_slot)
  let l_l1 = qbe_lbl(g, "svtr_l1")
  let l_l1b = qbe_lbl(g, "svtr_l1b")
  let l_l1i = qbe_lbl(g, "svtr_l1i")
  let l_l2 = qbe_lbl(g, "svtr_l2")
  let l_l2b = qbe_lbl(g, "svtr_l2b")
  let l_l2d = qbe_lbl(g, "svtr_l2d")
  let l_done = qbe_lbl(g, "svtr_done")
  let l_em = qbe_lbl(g, "svtr_em")
  let l_ne = qbe_lbl(g, "svtr_ne")
  let l_fin = qbe_lbl(g, "svtr_fin")
  qbe_emit_term(g, "jmp " + l_l1)
  qbe_emit_lbl(g, l_l1)
  let lo1 = qbe_tmp(g)
  let hi1 = qbe_tmp(g)
  let c1 = qbe_tmp(g)
  qbe_emit(g, lo1 + " =l loadl " + lo_slot)
  qbe_emit(g, hi1 + " =l loadl " + hi_slot)
  qbe_emit(g, c1 + " =w csltl " + lo1 + ", " + hi1)
  qbe_emit_term(g, "jnz " + c1 + ", " + l_l1b + ", " + l_l2)
  qbe_emit_lbl(g, l_l1b)
  let p1 = qbe_tmp(g)
  let ch1 = qbe_tmp(g)
  let w1a = qbe_tmp(g)
  let w1b = qbe_tmp(g)
  let w1c = qbe_tmp(g)
  let w1d = qbe_tmp(g)
  let w1ab = qbe_tmp(g)
  let w1cd = qbe_tmp(g)
  let w1 = qbe_tmp(g)
  qbe_emit(g, p1 + " =l add " + bptr + ", " + lo1)
  qbe_emit(g, ch1 + " =w loadub " + p1)
  qbe_emit(g, w1a + " =w ceqw " + ch1 + ", 32")
  qbe_emit(g, w1b + " =w ceqw " + ch1 + ", 9")
  qbe_emit(g, w1c + " =w ceqw " + ch1 + ", 10")
  qbe_emit(g, w1d + " =w ceqw " + ch1 + ", 13")
  qbe_emit(g, w1ab + " =w or " + w1a + ", " + w1b)
  qbe_emit(g, w1cd + " =w or " + w1c + ", " + w1d)
  qbe_emit(g, w1 + " =w or " + w1ab + ", " + w1cd)
  qbe_emit_term(g, "jnz " + w1 + ", " + l_l1i + ", " + l_l2)
  qbe_emit_lbl(g, l_l1i)
  let nlo1 = qbe_tmp(g)
  qbe_emit(g, nlo1 + " =l add " + lo1 + ", 1")
  qbe_emit(g, "storel " + nlo1 + ", " + lo_slot)
  qbe_emit_term(g, "jmp " + l_l1)
  qbe_emit_lbl(g, l_l2)
  let lo2 = qbe_tmp(g)
  let hi2 = qbe_tmp(g)
  let c2 = qbe_tmp(g)
  qbe_emit(g, lo2 + " =l loadl " + lo_slot)
  qbe_emit(g, hi2 + " =l loadl " + hi_slot)
  qbe_emit(g, c2 + " =w csgtl " + hi2 + ", " + lo2)
  qbe_emit_term(g, "jnz " + c2 + ", " + l_l2b + ", " + l_done)
  qbe_emit_lbl(g, l_l2b)
  let hi_m1 = qbe_tmp(g)
  let p2 = qbe_tmp(g)
  let ch2 = qbe_tmp(g)
  let w2a = qbe_tmp(g)
  let w2b = qbe_tmp(g)
  let w2c = qbe_tmp(g)
  let w2d = qbe_tmp(g)
  let w2ab = qbe_tmp(g)
  let w2cd = qbe_tmp(g)
  let w2 = qbe_tmp(g)
  qbe_emit(g, hi_m1 + " =l sub " + hi2 + ", 1")
  qbe_emit(g, p2 + " =l add " + bptr + ", " + hi_m1)
  qbe_emit(g, ch2 + " =w loadub " + p2)
  qbe_emit(g, w2a + " =w ceqw " + ch2 + ", 32")
  qbe_emit(g, w2b + " =w ceqw " + ch2 + ", 9")
  qbe_emit(g, w2c + " =w ceqw " + ch2 + ", 10")
  qbe_emit(g, w2d + " =w ceqw " + ch2 + ", 13")
  qbe_emit(g, w2ab + " =w or " + w2a + ", " + w2b)
  qbe_emit(g, w2cd + " =w or " + w2c + ", " + w2d)
  qbe_emit(g, w2 + " =w or " + w2ab + ", " + w2cd)
  qbe_emit_term(g, "jnz " + w2 + ", " + l_l2d + ", " + l_done)
  qbe_emit_lbl(g, l_l2d)
  qbe_emit(g, "storel " + hi_m1 + ", " + hi_slot)
  qbe_emit_term(g, "jmp " + l_l2)
  qbe_emit_lbl(g, l_done)
  let flo = qbe_tmp(g)
  let fhi = qbe_tmp(g)
  let nlen = qbe_tmp(g)
  let isz = qbe_tmp(g)
  qbe_emit(g, flo + " =l loadl " + lo_slot)
  qbe_emit(g, fhi + " =l loadl " + hi_slot)
  qbe_emit(g, nlen + " =l sub " + fhi + ", " + flo)
  qbe_emit(g, isz + " =w ceql " + nlen + ", 0")
  qbe_emit_term(g, "jnz " + isz + ", " + l_em + ", " + l_ne)
  qbe_emit_lbl(g, l_em)
  qbe_emit_term(g, "jmp " + l_fin)
  qbe_emit_lbl(g, l_ne)
  let np = qbe_tmp(g)
  qbe_emit(g, np + " =l add " + bptr + ", " + flo)
  qbe_emit_term(g, "jmp " + l_fin)
  qbe_emit_lbl(g, l_fin)
  let fptr = qbe_tmp(g)
  qbe_emit(g, fptr + " =l phi " + l_em + " 0, " + l_ne + " " + np)
  (fptr, nlen)
}

///|
/// P77-B: Recognize a chain of zero-copy view derivations rooted at a local/param:
/// `s.as_view()`, `s.view(a, b)`, `v.subview(a, b)`, `v.trim()` (and chains thereof).
/// Returns `Some((root_ident, result_view_ty))` if eligible for stack view scalarization.
fn qbe_view_expr_root_info(g : QbeGen, e : Expr) -> Option[(String, Ty)] {
  if qbe_expr_has_assign(e) {
    return None
  }
  match e {
    EMethodCall(src, mname, args, msp) => {
      if qbe_has_expected_trait(g, msp) {
        return None
      }
      if (mname == "as_view" && args.length() == 0) ||
        (mname == "view" && args.length() == 2) {
        match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) =>
                if !rloc.is_cell && rloc.ref_slot == "" {
                  match rloc.ty {
                    TString => Some((root, TStrView))
                    TBytes => Some((root, TBytesView))
                    _ => None
                  }
                } else {
                  None
                }
              None => None
            }
          _ => None
        }
      } else if mname == "subview" && args.length() == 2 {
        match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) =>
                if !rloc.is_cell && rloc.ref_slot == "" {
                  match rloc.ty {
                    TStrView => Some((root, TStrView))
                    TBytesView => Some((root, TBytesView))
                    _ => None
                  }
                } else {
                  None
                }
              None => None
            }
          _ => qbe_view_expr_root_info(g, src)
        }
      } else if mname == "trim" && args.length() == 0 {
        match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) =>
                if !rloc.is_cell && rloc.ref_slot == "" {
                  match rloc.ty {
                    TStrView => Some((root, TStrView))
                    _ => None
                  }
                } else {
                  None
                }
              None => None
            }
          _ =>
            match qbe_view_expr_root_info(g, src) {
              Some((root, TStrView)) => Some((root, TStrView))
              _ => None
            }
        }
      } else {
        None
      }
    }
    _ => None
  }
}

///|
/// P77-B: Emit `(owner_reg, ptr_reg, len_reg)` for a recognized stack view expression
/// without any heap allocation or RC operations.
fn qbe_emit_stack_view_parts(g : QbeGen, e : Expr) -> (String, String, String) {
  match e {
    EMethodCall(src, mname, args, _) => {
      if mname == "as_view" {
        match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) => {
                let obj_val = qbe_tmp(g)
                qbe_emit(g, obj_val + " =l loadl " + rloc.slot)
                match rloc.ty {
                  TString => {
                    let blen = match g.hoisted_str_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + obj_val)
                        t
                      }
                    }
                    let bptr = match g.hoisted_str_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l add " + obj_val + ", 8")
                        t
                      }
                    }
                    return (obj_val, bptr, blen)
                  }
                  TBytes => {
                    let blen = match g.hoisted_bytes_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + obj_val)
                        t
                      }
                    }
                    let bptr = match g.hoisted_bytes_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let dp_p = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, dp_p + " =l add " + obj_val + ", 16")
                        qbe_emit(g, t + " =l loadl " + dp_p)
                        t
                      }
                    }
                    return (obj_val, bptr, blen)
                  }
                  _ => ()
                }
              }
              None => ()
            }
          _ => ()
        }
      } else if mname == "view" {
        match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) => {
                let a = qbe_emit_expr(g, args[0], Some(TInt))
                let b = qbe_emit_expr(g, args[1], Some(TInt))
                let al = qbe_as_l(g, a)
                let bl = qbe_as_l(g, b)
                let obj_val = qbe_tmp(g)
                qbe_emit(g, obj_val + " =l loadl " + rloc.slot)
                match rloc.ty {
                  TString => {
                    let blen = match g.hoisted_str_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + obj_val)
                        t
                      }
                    }
                    let bptr = match g.hoisted_str_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l add " + obj_val + ", 8")
                        t
                      }
                    }
                    let (fp, nl) = qbe_emit_view_slice_parts(g, bptr, blen, al, bl)
                    return (obj_val, fp, nl)
                  }
                  TBytes => {
                    let blen = match g.hoisted_bytes_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + obj_val)
                        t
                      }
                    }
                    let bptr = match g.hoisted_bytes_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let dp_p = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, dp_p + " =l add " + obj_val + ", 16")
                        qbe_emit(g, t + " =l loadl " + dp_p)
                        t
                      }
                    }
                    let (fp, nl) = qbe_emit_view_slice_parts(g, bptr, blen, al, bl)
                    return (obj_val, fp, nl)
                  }
                  _ => ()
                }
              }
              None => ()
            }
          _ => ()
        }
      } else if mname == "subview" {
        let (owner, bptr, blen) = match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) => {
                let obj_val = qbe_tmp(g)
                let ow = qbe_tmp(g)
                qbe_emit(g, obj_val + " =l loadl " + rloc.slot)
                qbe_emit(g, ow + " =l loadl " + obj_val)
                let bp = match rloc.ty {
                  TStrView =>
                    match g.hoisted_str_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let pp = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, pp + " =l add " + obj_val + ", 8")
                        qbe_emit(g, t + " =l loadl " + pp)
                        t
                      }
                    }
                  _ =>
                    match g.hoisted_bytes_dp.get(root) {
                      Some(hd) => hd
                      None => {
                        let pp = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, pp + " =l add " + obj_val + ", 8")
                        qbe_emit(g, t + " =l loadl " + pp)
                        t
                      }
                    }
                }
                let bl = match rloc.ty {
                  TStrView =>
                    match g.hoisted_str_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let lp = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, lp + " =l add " + obj_val + ", 16")
                        qbe_emit(g, t + " =l loadl " + lp)
                        t
                      }
                    }
                  _ =>
                    match g.hoisted_bytes_len.get(root) {
                      Some(hl) => hl
                      None => {
                        let lp = qbe_tmp(g)
                        let t = qbe_tmp(g)
                        qbe_emit(g, lp + " =l add " + obj_val + ", 16")
                        qbe_emit(g, t + " =l loadl " + lp)
                        t
                      }
                    }
                }
                (ow, bp, bl)
              }
              None => ("0", "0", "0")
            }
          _ => qbe_emit_stack_view_parts(g, src)
        }
        let a = qbe_emit_expr(g, args[0], Some(TInt))
        let b = qbe_emit_expr(g, args[1], Some(TInt))
        let al = qbe_as_l(g, a)
        let bl = qbe_as_l(g, b)
        let (fp, nl) = qbe_emit_view_slice_parts(g, bptr, blen, al, bl)
        return (owner, fp, nl)
      } else if mname == "trim" {
        let (owner, bptr, blen) = match src {
          EIdent(root, _) =>
            match qbe_lookup_local(g, root) {
              Some(rloc) => {
                let obj_val = qbe_tmp(g)
                let ow = qbe_tmp(g)
                qbe_emit(g, obj_val + " =l loadl " + rloc.slot)
                qbe_emit(g, ow + " =l loadl " + obj_val)
                let bp = match g.hoisted_str_dp.get(root) {
                  Some(hd) => hd
                  None => {
                    let pp = qbe_tmp(g)
                    let t = qbe_tmp(g)
                    qbe_emit(g, pp + " =l add " + obj_val + ", 8")
                    qbe_emit(g, t + " =l loadl " + pp)
                    t
                  }
                }
                let bl = match g.hoisted_str_len.get(root) {
                  Some(hl) => hl
                  None => {
                    let lp = qbe_tmp(g)
                    let t = qbe_tmp(g)
                    qbe_emit(g, lp + " =l add " + obj_val + ", 16")
                    qbe_emit(g, t + " =l loadl " + lp)
                    t
                  }
                }
                (ow, bp, bl)
              }
              None => ("0", "0", "0")
            }
          _ => qbe_emit_stack_view_parts(g, src)
        }
        let (fp, nl) = qbe_emit_view_trim_parts(g, bptr, blen)
        return (owner, fp, nl)
      }
    }
    _ => ()
  }
  ("0", "0", "0")
}

///|
fn qbe_emit_stack_view_expr(g : QbeGen, e : Expr) -> String {
  let (owner, ptr, len) = qbe_emit_stack_view_parts(g, e)
  qbe_emit_view_stack_alloc(g, owner, ptr, len)
}

///|
/// P77-B: Stack scalarization of non-escaping local `StrView`/`BytesView` bindings
/// (`let v = s.as_view() | s.view(a, b) | v0.subview(a, b) | v0.trim()`).
/// Returns the pinned root local name on success, or `""` to fall back to heap allocation.
fn qbe_try_emit_stack_view_let(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
) -> String {
  let (bname, is_mut, ty_expr, init) = match stmts[idx] {
    SLet(n, m, te, ini, _) => (n, m, te, ini)
    _ => return ""
  }
  if is_mut || bname == "_" || g.boxed_mut_vars.contains(bname) {
    return ""
  }
  let (root_name, view_ty) = match qbe_view_expr_root_info(g, init) {
    Some((rn, vt)) => (rn, vt)
    None => return ""
  }
  if bname == root_name {
    return ""
  }
  match ty_expr {
    TyMissing(_) => ()
    _ => {
      let ann = subst_ty(qbe_resolve_type(g, ty_expr), g.cur_type_subst)
      let ok_ann = match (ann, view_ty) {
        (TStrView, TStrView) => true
        (TBytesView, TBytesView) => true
        _ => false
      }
      if !ok_ann {
        return ""
      }
    }
  }
  let mut sj = idx + 1
  while sj < stmts.length() {
    if qbe_stmt_assigns_ident(stmts[sj], root_name) ||
      qbe_stmt_rebinds_ident(stmts[sj], root_name) {
      return ""
    }
    match stmts[sj] {
      SLet(rn, _, _, _, _) => if rn == bname { break }
      SLetTuple(rns, _, _, _) => {
        let mut rbi = 0
        let mut sh = false
        while rbi < rns.length() {
          if rns[rbi] == bname {
            sh = true
          }
          rbi = rbi + 1
        }
        if sh {
          break
        }
      }
      _ => ()
    }
    sj = sj + 1
  }
  let future_locals = qbe_collect_future_local_bind_names(stmts, idx + 1, bname)
  if !qbe_ident_is_view_consumer_stmts(g, stmts, idx + 1, bname, view_ty, Map([]), future_locals, 0) {
    return ""
  }
  let stk = qbe_emit_stack_view_expr(g, init)
  qbe_clear_shadowed_local_meta(g, bname)
  let loc = qbe_define_local(g, bname, view_ty, false)
  g.stack_view_slots.set(loc.slot, true)
  qbe_emit(g, "storel " + stk + ", " + loc.slot)
  root_name
}

///|
fn qbe_emit_strview_eq_raw(
  g : QbeGen,
  p1 : String,
  l1 : String,
  p2 : String,
  l2 : String,
) -> String {
  let eq_sym = qbe_ensure_view_eq_bytes_fn(g)
  let same_len = qbe_tmp(g)
  let l_cmp = qbe_lbl(g, "sveq_cmp")
  let l_ne = qbe_lbl(g, "sveq_ne")
  let l_end = qbe_lbl(g, "sveq_end")
  qbe_emit(g, same_len + " =w ceql " + l1 + ", " + l2)
  qbe_emit_term(g, "jnz " + same_len + ", " + l_cmp + ", " + l_ne)
  qbe_emit_lbl(g, l_cmp)
  let eq_w = qbe_tmp(g)
  qbe_emit(g, eq_w + " =w call " + eq_sym + "(l " + p1 + ", l " + p2 + ", l " + l1 + ")")
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_ne)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let res_w = qbe_tmp(g)
  qbe_emit(g, res_w + " =w phi " + l_cmp + " " + eq_w + ", " + l_ne + " 0")
  res_w
}

///|
fn qbe_ty_may_contain_float(g : QbeGen, ty : Ty, visited : Map[String, Bool]) -> Bool {
  let rty = subst_ty(ty, g.cur_type_subst)
  match rty {
    TDouble | TFloat | TParam(_) => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) =>
      qbe_ty_may_contain_float(g, e, visited)
    TResult(a, b) =>
      qbe_ty_may_contain_float(g, a, visited) || qbe_ty_may_contain_float(g, b, visited)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if qbe_ty_may_contain_float(g, es[i], visited) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      let key = ty_to_string(rty)
      if visited.contains(key) {
        return false
      }
      visited.set(key, true)
      match qbe_lookup_struct_info(g, sname) {
        None => true
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_may_contain_float(g, subst_ty(sinfo.field_tys[fi], subst), visited) {
              return true
            }
            fi = fi + 1
          }
          false
        }
      }
    }
    TEnum(ename, eargs) => {
      let key = ty_to_string(rty)
      if visited.contains(key) {
        return false
      }
      visited.set(key, true)
      match qbe_lookup_enum_info(g, ename) {
        None => true
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_may_contain_float(g, subst_ty(v.field_tys[fi], subst), visited) {
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          false
        }
      }
    }
    _ => false
  }
}

///|
fn qbe_ty_has_custom_eq(g : QbeGen, ty : Ty, visited : Map[String, Bool]) -> Bool {
  let rty = subst_ty(ty, g.cur_type_subst)
  match rty {
    TParam(_) => true
    TArray(e) | TFixedArray(e) | TImmArray(e) | TOption(e) =>
      qbe_ty_has_custom_eq(g, e, visited)
    TResult(a, b) =>
      qbe_ty_has_custom_eq(g, a, visited) || qbe_ty_has_custom_eq(g, b, visited)
    TTuple(es) => {
      let mut i = 0
      while i < es.length() {
        if qbe_ty_has_custom_eq(g, es[i], visited) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(_) => return true
        None => ()
      }
      let key = ty_to_string(rty)
      if visited.contains(key) {
        return false
      }
      visited.set(key, true)
      match qbe_lookup_struct_info(g, sname) {
        None => false
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_ty_has_custom_eq(g, subst_ty(sinfo.field_tys[fi], subst), visited) {
              return true
            }
            fi = fi + 1
          }
          false
        }
      }
    }
    TEnum(ename, eargs) => {
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(_) => return true
        None => ()
      }
      let key = ty_to_string(rty)
      if visited.contains(key) {
        return false
      }
      visited.set(key, true)
      match qbe_lookup_enum_info(g, ename) {
        None => false
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_ty_has_custom_eq(g, subst_ty(v.field_tys[fi], subst), visited) {
                return true
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          false
        }
      }
    }
    _ => false
  }
}

///|
fn qbe_eq_op_may_call_custom(
  g : QbeGen,
  l : Expr,
  r : Expr,
  hints : QbeProbeHints,
) -> Bool {
  let lt_opt = qbe_probe_expr_ty_with(g, l, hints)
  let rt_opt = qbe_probe_expr_ty_with(g, r, hints)
  let mut checked = false
  match lt_opt {
    Some(lt) =>
      if !qbe_ty_has_error(lt) {
        checked = true
        if qbe_ty_has_custom_eq(g, lt, Map([])) {
          return true
        }
      }
    None => ()
  }
  match rt_opt {
    Some(rt) =>
      if !qbe_ty_has_error(rt) {
        checked = true
        if qbe_ty_has_custom_eq(g, rt, Map([])) {
          return true
        }
      }
    None => ()
  }
  !checked
}

///|
fn qbe_contains_may_call_custom(
  g : QbeGen,
  obj : Expr,
  hints : QbeProbeHints,
) -> Bool {
  match qbe_probe_expr_ty_with(g, obj, hints) {
    Some(raw_ty) =>
      match subst_ty(raw_ty, g.cur_type_subst) {
        TArray(el) | TFixedArray(el) | TImmArray(el) =>
          qbe_ty_has_error(el) || qbe_ty_has_custom_eq(g, el, Map([]))
        TString | TStrView => false
        _ => true
      }
    None => true
  }
}

///|
fn qbe_ty_no_eq_ptr_shortcut(g : QbeGen, ty : Ty) -> Bool {
  qbe_ty_may_contain_float(g, ty, Map([])) || qbe_ty_has_custom_eq(g, ty, Map([]))
}

///|
fn qbe_type_needs_eq_fn(g : QbeGen, ty : Ty) -> Bool {
  let rty = subst_ty(ty, g.cur_type_subst)
  match rty {
    TImmArray(_) | TArray(_) | TFixedArray(_) | TOption(_) | TResult(_, _) | TTuple(_) => true
    TStruct(sname, _) =>
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(_) => true
        None =>
          match qbe_lookup_struct_info(g, sname) {
            Some(si) => si.decl.derive_eq
            None => false
          }
      }
    TEnum(ename, _) =>
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(_) => true
        None =>
          match qbe_lookup_enum_info(g, ename) {
            Some(ei) => {
              if !ei.decl.derive_eq {
                return false
              }
              let mut vi = 0
              while vi < ei.variants.length() {
                if ei.variants[vi].field_tys.length() > 0 {
                  return true
                }
                vi = vi + 1
              }
              false
            }
            None => false
          }
      }
    _ => false
  }
}

///|
fn qbe_emit_eq_field_cmp_ptrs(
  g : QbeGen,
  sb : StringBuilder,
  ptr_a : String,
  ptr_b : String,
  fty : Ty,
  off : Int,
  pfx : String,
  next_lbl : String,
) -> Unit {
  let rfty = subst_ty(fty, g.cur_type_subst)
  let ap = if off == 0 {
    ptr_a
  } else {
    let s = "%ap_" + pfx
    sb.write_string("    " + s + " =l add " + ptr_a + ", " + off.to_string() + "\n")
    s
  }
  let bp = if off == 0 {
    ptr_b
  } else {
    let s = "%bp_" + pfx
    sb.write_string("    " + s + " =l add " + ptr_b + ", " + off.to_string() + "\n")
    s
  }
  match rfty {
    TInt | TUInt => {
      sb.write_string("    %al_" + pfx + " =l loadl " + ap + "\n")
      sb.write_string("    %bl_" + pfx + " =l loadl " + bp + "\n")
      sb.write_string("    %aw_" + pfx + " =w copy %al_" + pfx + "\n")
      sb.write_string("    %bw_" + pfx + " =w copy %bl_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqw %aw_" + pfx + ", %bw_" + pfx + "\n")
    }
    TDouble => {
      sb.write_string("    %ad_" + pfx + " =d loadd " + ap + "\n")
      sb.write_string("    %bd_" + pfx + " =d loadd " + bp + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqd %ad_" + pfx + ", %bd_" + pfx + "\n")
    }
    TFloat => {
      sb.write_string("    %af_" + pfx + " =s loads " + ap + "\n")
      sb.write_string("    %bf_" + pfx + " =s loads " + bp + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqs %af_" + pfx + ", %bf_" + pfx + "\n")
    }
    TString => {
      sb.write_string("    %av_" + pfx + " =l loadl " + ap + "\n")
      sb.write_string("    %bv_" + pfx + " =l loadl " + bp + "\n")
      sb.write_string("    %ok_" + pfx + " =w call $pion_str_eq(l %av_" + pfx + ", l %bv_" + pfx + ")\n")
    }
    TStrView => {
      let eq_bytes_sym = qbe_ensure_view_eq_bytes_fn(g)
      sb.write_string("    %av_" + pfx + " =l loadl " + ap + "\n")
      sb.write_string("    %bv_" + pfx + " =l loadl " + bp + "\n")
      sb.write_string("    %l1p_" + pfx + " =l add %av_" + pfx + ", 16\n")
      sb.write_string("    %l1_" + pfx + " =l loadl %l1p_" + pfx + "\n")
      sb.write_string("    %l2p_" + pfx + " =l add %bv_" + pfx + ", 16\n")
      sb.write_string("    %l2_" + pfx + " =l loadl %l2p_" + pfx + "\n")
      sb.write_string("    %leq_" + pfx + " =w ceql %l1_" + pfx + ", %l2_" + pfx + "\n")
      sb.write_string("    jnz %leq_" + pfx + ", @svcmp_" + pfx + ", @ret_false\n")
      sb.write_string("@svcmp_" + pfx + "\n")
      sb.write_string("    %p1p_" + pfx + " =l add %av_" + pfx + ", 8\n")
      sb.write_string("    %p1_" + pfx + " =l loadl %p1p_" + pfx + "\n")
      sb.write_string("    %p2p_" + pfx + " =l add %bv_" + pfx + ", 8\n")
      sb.write_string("    %p2_" + pfx + " =l loadl %p2p_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w call " + eq_bytes_sym + "(l %p1_" + pfx + ", l %p2_" + pfx + ", l %l1_" + pfx + ")\n")
    }
    TUnit =>
      sb.write_string("    %ok_" + pfx + " =w copy 1\n")
    _ => {
      sb.write_string("    %av_" + pfx + " =l loadl " + ap + "\n")
      sb.write_string("    %bv_" + pfx + " =l loadl " + bp + "\n")
      if qbe_type_needs_eq_fn(g, rfty) {
        let child_sym = qbe_ensure_eq_fn(g, rfty)
        let pin_rc = qbe_is_obj_ty(g, rfty) && qbe_ty_has_custom_eq(g, rfty, Map([]))
        let is_niche_opt = match rfty {
          TOption(inner) => qbe_is_niche_opt_inner(g, inner) && !qbe_is_unboxed_unit_enum(g, inner)
          TEnum(_, _) => qbe_enum_layout(g, rfty).is_niche
          _ => false
        }
        if pin_rc {
          if is_niche_opt {
            sb.write_string("    %anz_" + pfx + " =w cnel %av_" + pfx + ", 0\n")
            sb.write_string("    jnz %anz_" + pfx + ", @inca_" + pfx + ", @incb_chk_" + pfx + "\n")
            sb.write_string("@inca_" + pfx + "\n    call $pion_rc_inc(l %av_" + pfx + ")\n")
            sb.write_string("@incb_chk_" + pfx + "\n    %bnz_" + pfx + " =w cnel %bv_" + pfx + ", 0\n")
            sb.write_string("    jnz %bnz_" + pfx + ", @incb_" + pfx + ", @docmp_" + pfx + "\n")
            sb.write_string("@incb_" + pfx + "\n    call $pion_rc_inc(l %bv_" + pfx + ")\n")
            sb.write_string("@docmp_" + pfx + "\n")
          } else {
            sb.write_string("    call $pion_rc_inc(l %av_" + pfx + ")\n")
            sb.write_string("    call $pion_rc_inc(l %bv_" + pfx + ")\n")
          }
        }
        sb.write_string("    %ok_" + pfx + " =w call " + child_sym + "(l %av_" + pfx + ", l %bv_" + pfx + ")\n")
        if pin_rc {
          if is_niche_opt {
            sb.write_string("    jnz %anz_" + pfx + ", @deca_" + pfx + ", @decb_chk_" + pfx + "\n")
            sb.write_string("@deca_" + pfx + "\n    call $pion_rc_dec(l %av_" + pfx + ")\n")
            sb.write_string("@decb_chk_" + pfx + "\n    jnz %bnz_" + pfx + ", @decb_" + pfx + ", @decdone_" + pfx + "\n")
            sb.write_string("@decb_" + pfx + "\n    call $pion_rc_dec(l %bv_" + pfx + ")\n")
            sb.write_string("@decdone_" + pfx + "\n")
          } else {
            sb.write_string("    call $pion_rc_dec(l %av_" + pfx + ")\n")
            sb.write_string("    call $pion_rc_dec(l %bv_" + pfx + ")\n")
          }
        }
      } else {
        match rfty {
          TEnum(_, _) => {
            let layout = qbe_enum_layout(g, rfty)
            if layout.is_unit_only {
              sb.write_string("    %ok_" + pfx + " =w ceql %av_" + pfx + ", %bv_" + pfx + "\n")
            } else if layout.is_niche {
              sb.write_string("    %an_" + pfx + " =w ceql %av_" + pfx + ", 0\n")
              sb.write_string("    %bn_" + pfx + " =w ceql %bv_" + pfx + ", 0\n")
              sb.write_string("    %ok_" + pfx + " =w ceqw %an_" + pfx + ", %bn_" + pfx + "\n")
            } else {
              sb.write_string("    %at_" + pfx + " =l loadl %av_" + pfx + "\n")
              sb.write_string("    %bt_" + pfx + " =l loadl %bv_" + pfx + "\n")
              sb.write_string("    %ok_" + pfx + " =w ceql %at_" + pfx + ", %bt_" + pfx + "\n")
            }
          }
          _ =>
            sb.write_string("    %ok_" + pfx + " =w ceql %av_" + pfx + ", %bv_" + pfx + "\n")
        }
      }
    }
  }
  sb.write_string("    jnz %ok_" + pfx + ", " + next_lbl + ", @ret_false\n")
}

///|
fn qbe_emit_eq_field_cmp(
  g : QbeGen,
  sb : StringBuilder,
  fty : Ty,
  off : Int,
  pfx : String,
  next_lbl : String,
) -> Unit {
  qbe_emit_eq_field_cmp_ptrs(g, sb, "%a", "%b", fty, off, pfx, next_lbl)
}

///|
fn qbe_emit_flat_box_into_sb(
  g : QbeGen,
  sb : StringBuilder,
  src_ep : String,
  ftys : Array[Ty],
  drop_sym : String,
  pfx : String,
) -> String {
  let nfields = ftys.length()
  let box_reg = "%box_" + pfx
  sb.write_string("    " + box_reg + " =l call $pion_alloc_uninit(w " + (nfields * 8).to_string() + ", w 4, l " + drop_sym + ")\n")
  let mut fi = 0
  while fi < nfields {
    let fis = fi.to_string()
    let sp = if fi == 0 {
      src_ep
    } else {
      let t = "%fsp_" + pfx + "_" + fis
      sb.write_string("    " + t + " =l add " + src_ep + ", " + (fi * 8).to_string() + "\n")
      t
    }
    let dp = if fi == 0 {
      box_reg
    } else {
      let t = "%fdp_" + pfx + "_" + fis
      sb.write_string("    " + t + " =l add " + box_reg + ", " + (fi * 8).to_string() + "\n")
      t
    }
    let v = "%fv_" + pfx + "_" + fis
    sb.write_string("    " + v + " =l loadl " + sp + "\n")
    if qbe_is_obj_ty(g, ftys[fi]) {
      let is_niche_opt = match ftys[fi] {
        TOption(inner) => qbe_is_niche_opt_inner(g, inner) && !qbe_is_unboxed_unit_enum(g, inner)
        TEnum(_, _) => qbe_enum_layout(g, ftys[fi]).is_niche
        _ => false
      }
      if is_niche_opt {
        sb.write_string("    %fnz_" + pfx + "_" + fis + " =w cnel " + v + ", 0\n")
        sb.write_string("    jnz %fnz_" + pfx + "_" + fis + ", @finc_" + pfx + "_" + fis + ", @fsto_" + pfx + "_" + fis + "\n")
        sb.write_string("@finc_" + pfx + "_" + fis + "\n    call $pion_rc_inc(l " + v + ")\n")
        sb.write_string("@fsto_" + pfx + "_" + fis + "\n")
      } else {
        sb.write_string("    call $pion_rc_inc(l " + v + ")\n")
      }
    }
    sb.write_string("    storel " + v + ", " + dp + "\n")
    fi = fi + 1
  }
  box_reg
}

///|
fn qbe_resolve_builtin_eq_target_sym(
  g : QbeGen,
  iinfo : ImplInfo,
  targs : Array[Ty],
) -> String {
  let base_sym = qbe_impl_method_sym(
    g,
    iinfo.pkg_name,
    iinfo.trait_name,
    iinfo.target_type,
    "equal",
  )
  if iinfo.decl.type_params.length() == 0 {
    return base_sym
  }
  match iinfo.methods.get("equal") {
    None => base_sym
    Some(equal_fi) => {
      let subst : Map[String, Ty] = Map([])
      let mut i = 0
      while i < iinfo.target_param_names.length() && i < targs.length() {
        subst.set(iinfo.target_param_names[i], targs[i])
        i = i + 1
      }
      let mono = qbe_request_mono(g, base_sym, equal_fi, subst, qbe_norm_mono_pkg(g, iinfo.pkg_name))
      mono.sym
    }
  }
}

///|
fn qbe_ensure_eq_fn(g : QbeGen, ty : Ty) -> String {
  let rty = subst_ty(ty, g.cur_type_subst)
  let fn_sym = "$pion_eq_" + qbe_freeze_ty_key(rty)
  if g.eq_fn_seen.contains(fn_sym) {
    return fn_sym
  }
  g.eq_fn_seen.set(fn_sym, true)
  match rty {
    TImmArray(elem_raw) | TArray(elem_raw) | TFixedArray(elem_raw) => {
      let elem = subst_ty(elem_raw, g.cur_type_subst)
      let has_custom = qbe_ty_has_custom_eq(g, elem, Map([]))
      let sb = StringBuilder()
      sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
      sb.write_string("    %i_slot =l alloc8 8\n")
      if !qbe_ty_no_eq_ptr_shortcut(g, elem) {
        sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_len\n@cmp_len\n")
      }
      sb.write_string("    %la =l loadl %a\n    %lb =l loadl %b\n")
      sb.write_string("    %leq =w ceql %la, %lb\n    jnz %leq, @chk_empty, @ret_false\n")
      sb.write_string("@chk_empty\n    %has =w csgtl %la, 0\n    jnz %has, @init_loop, @ret_true\n")
      sb.write_string("@init_loop\n")
      if !has_custom {
        sb.write_string("    %dpa_p =l add %a, 24\n    %dpa =l loadl %dpa_p\n")
        sb.write_string("    %dpb_p =l add %b, 24\n    %dpb =l loadl %dpb_p\n")
      }
      sb.write_string("    storel 0, %i_slot\n    jmp @loop\n")
      sb.write_string("@loop\n    %i =l loadl %i_slot\n")
      if has_custom {
        sb.write_string("    %cur_la =l loadl %a\n    %cur_lb =l loadl %b\n")
        sb.write_string("    %cur_leq =w ceql %cur_la, %cur_lb\n    jnz %cur_leq, @loop_cmp, @ret_false\n")
        sb.write_string("@loop_cmp\n    %c =w csltl %i, %cur_la\n    jnz %c, @step, @ret_true\n")
        sb.write_string("@step\n")
        sb.write_string("    %dpa_p =l add %a, 24\n    %dpa =l loadl %dpa_p\n")
        sb.write_string("    %dpb_p =l add %b, 24\n    %dpb =l loadl %dpb_p\n")
      } else {
        sb.write_string("    %c =w csltl %i, %la\n    jnz %c, @step, @ret_true\n")
        sb.write_string("@step\n")
      }
      if qbe_is_u8_array_elem(g, elem) {
        sb.write_string("    %ea =l add %dpa, %i\n    %eb =l add %dpb, %i\n")
        sb.write_string("    %av =w loadub %ea\n    %bv =w loadub %eb\n")
        sb.write_string("    %ok =w ceqw %av, %bv\n    jnz %ok, @next, @ret_false\n")
      } else if qbe_is_4b_array_elem(g, elem) {
        sb.write_string("    %off =l shl %i, 2\n    %ea =l add %dpa, %off\n    %eb =l add %dpb, %off\n")
        match elem {
          TFloat =>
            sb.write_string("    %av =s loads %ea\n    %bv =s loads %eb\n    %ok =w ceqs %av, %bv\n    jnz %ok, @next, @ret_false\n")
          _ =>
            sb.write_string("    %av =w loadw %ea\n    %bv =w loadw %eb\n    %ok =w ceqw %av, %bv\n    jnz %ok, @next, @ret_false\n")
        }
      } else {
        match qbe_flat_pod_struct_info(g, elem) {
          Some(sinfo) => {
            let ftys = qbe_flat_struct_field_tys(g, sinfo, elem)
            let stride = ftys.length() * 8
            sb.write_string("    %off =l mul %i, " + stride.to_string() + "\n")
            sb.write_string("    %ea =l add %dpa, %off\n    %eb =l add %dpb, %off\n")
            if qbe_ty_has_custom_eq(g, elem, Map([])) {
              let obj_slots : Array[Int] = []
              let mut osi = 0
              while osi < ftys.length() {
                if qbe_is_obj_ty(g, ftys[osi]) {
                  obj_slots.push(osi)
                }
                osi = osi + 1
              }
              let drop_sym = qbe_register_slot_drop(g, obj_slots)
              let ba = qbe_emit_flat_box_into_sb(g, sb, "%ea", ftys, drop_sym, "a")
              let bb = qbe_emit_flat_box_into_sb(g, sb, "%eb", ftys, drop_sym, "b")
              let child_sym = qbe_ensure_eq_fn(g, elem)
              sb.write_string("    %ok =w call " + child_sym + "(l " + ba + ", l " + bb + ")\n")
              sb.write_string("    call $pion_rc_dec(l " + ba + ")\n")
              sb.write_string("    call $pion_rc_dec(l " + bb + ")\n")
              sb.write_string("    jnz %ok, @next, @ret_false\n")
            } else if ftys.length() == 0 {
              sb.write_string("    jmp @next\n")
            } else {
              let mut fi = 0
              while fi < ftys.length() {
                if fi > 0 {
                  sb.write_string("@ef_" + fi.to_string() + "\n")
                }
                let next_f = if fi + 1 < ftys.length() {
                  "@ef_" + (fi + 1).to_string()
                } else {
                  "@next"
                }
                qbe_emit_eq_field_cmp_ptrs(g, sb, "%ea", "%eb", ftys[fi], fi * 8, "ef" + fi.to_string(), next_f)
                fi = fi + 1
              }
            }
          }
          None => {
            sb.write_string("    %off =l shl %i, 3\n    %ea =l add %dpa, %off\n    %eb =l add %dpb, %off\n")
            qbe_emit_eq_field_cmp_ptrs(g, sb, "%ea", "%eb", elem, 0, "el", "@next")
          }
        }
      }
      sb.write_string("@next\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n")
      sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TOption(inner_raw) => {
      let inner = subst_ty(inner_raw, g.cur_type_subst)
      let sb = StringBuilder()
      sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
      if qbe_is_niche_opt_inner(g, inner) {
        if qbe_is_unboxed_unit_enum(g, inner) {
          match qbe_lookup_builtin_eq_impl(g, inner) {
            Some(_) => {
              let child_sym = qbe_ensure_eq_fn(g, inner)
              sb.write_string("    %an =w ceql %a, 0\n    %bn =w ceql %b, 0\n")
              sb.write_string("    jnz %an, @a_null, @a_some\n")
              sb.write_string("@a_null\n    jnz %bn, @ret_true, @ret_false\n")
              sb.write_string("@a_some\n    jnz %bn, @ret_false, @both_some\n")
              sb.write_string("@both_some\n")
              sb.write_string("    %ok =w call " + child_sym + "(l %a, l %b)\n    ret %ok\n")
              sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
            }
            None =>
              sb.write_string("    %ok =w ceql %a, %b\n    ret %ok\n}\n\n")
          }
        } else {
          sb.write_string("    %an =w ceql %a, 0\n    %bn =w ceql %b, 0\n")
          sb.write_string("    jnz %an, @a_null, @a_some\n")
          sb.write_string("@a_null\n    jnz %bn, @ret_true, @ret_false\n")
          sb.write_string("@a_some\n    jnz %bn, @ret_false, @both_some\n")
          sb.write_string("@both_some\n")
          if !qbe_ty_no_eq_ptr_shortcut(g, inner) {
            sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_val\n@cmp_val\n")
          }
          match inner {
            TString =>
              sb.write_string("    %ok =w call $pion_str_eq(l %a, l %b)\n    ret %ok\n")
            TStrView => {
              let eq_bytes_sym = qbe_ensure_view_eq_bytes_fn(g)
              sb.write_string("    %l1p =l add %a, 16\n    %l1 =l loadl %l1p\n")
              sb.write_string("    %l2p =l add %b, 16\n    %l2 =l loadl %l2p\n")
              sb.write_string("    %leq =w ceql %l1, %l2\n    jnz %leq, @svcmp, @ret_false\n")
              sb.write_string("@svcmp\n")
              sb.write_string("    %p1p =l add %a, 8\n    %p1 =l loadl %p1p\n")
              sb.write_string("    %p2p =l add %b, 8\n    %p2 =l loadl %p2p\n")
              sb.write_string("    %ok =w call " + eq_bytes_sym + "(l %p1, l %p2, l %l1)\n    ret %ok\n")
            }
            _ =>
              if qbe_type_needs_eq_fn(g, inner) {
                let child_sym = qbe_ensure_eq_fn(g, inner)
                sb.write_string("    %ok =w call " + child_sym + "(l %a, l %b)\n    ret %ok\n")
              } else {
                match inner {
                  TEnum(_, _) => {
                    sb.write_string("    %ta =l loadl %a\n    %tb =l loadl %b\n")
                    sb.write_string("    %ok =w ceql %ta, %tb\n    ret %ok\n")
                  }
                  _ => sb.write_string("    %ok =w ceql %a, %b\n    ret %ok\n")
                }
              }
          }
          sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
        }
      } else {
        if !qbe_ty_no_eq_ptr_shortcut(g, inner) {
          sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_tag\n@cmp_tag\n")
        }
        sb.write_string("    %ta =l loadl %a\n    %tb =l loadl %b\n")
        sb.write_string("    %teq =w ceql %ta, %tb\n    jnz %teq, @chk_some, @ret_false\n")
        sb.write_string("@chk_some\n    %taw =w cnel %ta, 0\n    jnz %taw, @cmp_payload, @ret_true\n")
        sb.write_string("@cmp_payload\n")
        qbe_emit_eq_field_cmp(g, sb, inner, 8, "opt", "@ret_true")
        sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
      }
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TResult(ok_raw, err_raw) => {
      let ok_ty = subst_ty(ok_raw, g.cur_type_subst)
      let err_ty = subst_ty(err_raw, g.cur_type_subst)
      let sb = StringBuilder()
      sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
      if !qbe_ty_no_eq_ptr_shortcut(g, rty) {
        sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_tag\n@cmp_tag\n")
      }
      sb.write_string("    %ta =l loadl %a\n    %tb =l loadl %b\n")
      sb.write_string("    %teq =w ceql %ta, %tb\n    jnz %teq, @chk_tag, @ret_false\n")
      sb.write_string("@chk_tag\n    %taw =w cnel %ta, 0\n    jnz %taw, @cmp_err, @cmp_ok\n")
      sb.write_string("@cmp_ok\n")
      qbe_emit_eq_field_cmp(g, sb, ok_ty, 8, "rok", "@ret_true")
      sb.write_string("@cmp_err\n")
      qbe_emit_eq_field_cmp(g, sb, err_ty, 8, "rerr", "@ret_true")
      sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TTuple(elems_raw) => {
      let sb = StringBuilder()
      sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
      if !qbe_ty_no_eq_ptr_shortcut(g, rty) {
        sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @t_0\n")
      } else {
        sb.write_string("    jmp @t_0\n")
      }
      let mut ei = 0
      while ei < elems_raw.length() {
        let ety = subst_ty(elems_raw[ei], g.cur_type_subst)
        let next_lbl = if ei + 1 < elems_raw.length() {
          "@t_" + (ei + 1).to_string()
        } else {
          "@ret_true"
        }
        sb.write_string("@t_" + ei.to_string() + "\n")
        qbe_emit_eq_field_cmp(g, sb, ety, ei * 8, "t" + ei.to_string(), next_lbl)
        ei = ei + 1
      }
      if elems_raw.length() == 0 {
        sb.write_string("@t_0\n    jmp @ret_true\n")
      }
      sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TStruct(sname, sargs) =>
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(iinfo) => {
          let target_sym = qbe_resolve_builtin_eq_target_sym(g, iinfo, sargs)
          let sb = StringBuilder()
          sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
          sb.write_string("    %r =l call " + target_sym + "(l %a, l %b)\n")
          sb.write_string("    %w =w copy %r\n    ret %w\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let sb = StringBuilder()
              sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
              if !qbe_ty_no_eq_ptr_shortcut(g, rty) {
                sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @f_0\n")
              } else {
                sb.write_string("    jmp @f_0\n")
              }
              let mut fi = 0
              while fi < sinfo.field_tys.length() {
                let fty = subst_ty(sinfo.field_tys[fi], subst)
                let next_lbl = if fi + 1 < sinfo.field_tys.length() {
                  "@f_" + (fi + 1).to_string()
                } else {
                  "@ret_true"
                }
                sb.write_string("@f_" + fi.to_string() + "\n")
                qbe_emit_eq_field_cmp(g, sb, fty, fi * 8, "s" + fi.to_string(), next_lbl)
                fi = fi + 1
              }
              if sinfo.field_tys.length() == 0 {
                sb.write_string("@f_0\n    jmp @ret_true\n")
              }
              sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
              g.extra_fns.push(sb.to_string())
              fn_sym
            }
            None => fn_sym
          }
      }
    TEnum(ename, eargs) =>
      match qbe_lookup_builtin_eq_impl(g, rty) {
        Some(iinfo) => {
          let target_sym = qbe_resolve_builtin_eq_target_sym(g, iinfo, eargs)
          let sb = StringBuilder()
          sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
          sb.write_string("    %r =l call " + target_sym + "(l %a, l %b)\n")
          sb.write_string("    %w =w copy %r\n    ret %w\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let layout = qbe_enum_layout_for_info(einfo)
              let subst = make_subst(einfo.decl.type_params, eargs)
              let sb = StringBuilder()
              sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
              if layout.is_niche {
                sb.write_string("    %an =w ceql %a, 0\n    %bn =w ceql %b, 0\n")
                sb.write_string("    jnz %an, @a_null, @a_pay\n")
                sb.write_string("@a_null\n    jnz %bn, @ret_true, @ret_false\n")
                sb.write_string("@a_pay\n    jnz %bn, @ret_false, @both_pay\n")
                sb.write_string("@both_pay\n")
                if !qbe_ty_no_eq_ptr_shortcut(g, rty) {
                  sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @v_0\n")
                } else {
                  sb.write_string("    jmp @v_0\n")
                }
                let pv = einfo.variants[layout.payload_tag]
                let mut fi = 0
                while fi < pv.field_tys.length() {
                  let fty = subst_ty(pv.field_tys[fi], subst)
                  let next_f = if fi + 1 < pv.field_tys.length() {
                    "@v_" + (fi + 1).to_string()
                  } else {
                    "@ret_true"
                  }
                  sb.write_string("@v_" + fi.to_string() + "\n")
                  qbe_emit_eq_field_cmp(
                    g,
                    sb,
                    fty,
                    layout.payload_offset + fi * 8,
                    "nv" + fi.to_string(),
                    next_f,
                  )
                  fi = fi + 1
                }
                sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
                g.extra_fns.push(sb.to_string())
                return fn_sym
              }
              if !qbe_ty_no_eq_ptr_shortcut(g, rty) {
                sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_tag\n")
              } else {
                sb.write_string("    jmp @cmp_tag\n")
              }
              sb.write_string("@cmp_tag\n")
              sb.write_string("    %ta =l loadl %a\n    %tb =l loadl %b\n    %teq =w ceql %ta, %tb\n    jnz %teq, @vchk_0, @ret_false\n")
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                let next_v = if vi + 1 < einfo.variants.length() {
                  "@vchk_" + (vi + 1).to_string()
                } else {
                  "@ret_true"
                }
                sb.write_string("@vchk_" + vi.to_string() + "\n")
                if v.field_tys.length() == 0 {
                  sb.write_string("    jmp " + next_v + "\n")
                } else {
                  sb.write_string("    %isv_" + vi.to_string() + " =w ceql %ta, " + vi.to_string() + "\n")
                  sb.write_string("    jnz %isv_" + vi.to_string() + ", @v_" + vi.to_string() + "_0, " + next_v + "\n")
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    let fty = subst_ty(v.field_tys[fi], subst)
                    let next_f = if fi + 1 < v.field_tys.length() {
                      "@v_" + vi.to_string() + "_" + (fi + 1).to_string()
                    } else {
                      "@ret_true"
                    }
                    sb.write_string("@v_" + vi.to_string() + "_" + fi.to_string() + "\n")
                    qbe_emit_eq_field_cmp(
                      g,
                      sb,
                      fty,
                      layout.payload_offset + fi * 8,
                      "v" + vi.to_string() + "_" + fi.to_string(),
                      next_f,
                    )
                    fi = fi + 1
                  }
                }
                vi = vi + 1
              }
              if einfo.variants.length() == 0 {
                sb.write_string("@vchk_0\n    jmp @ret_true\n")
              }
              sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
              g.extra_fns.push(sb.to_string())
              fn_sym
            }
            None => fn_sym
          }
      }
    _ => fn_sym
  }
}

///|
fn qbe_ensure_dyn_vtable(
  g : QbeGen,
  trait_name : String,
  concrete_ty : Ty,
) -> String {
  let c_trait = qbe_local_unqual_target(
    g,
    resolve_canonical_trait_name(g.tc, trait_name),
  )
  let tname = qbe_local_unqual_target(g, ty_base_name(concrete_ty))
  let vt_sym = "$pion_vtable_" + qbe_mangle_pair(c_trait, tname)
  if g.dyn_vtable_seen.contains(vt_sym) {
    return vt_sym
  }
  g.dyn_vtable_seen.set(vt_sym, true)
  let is_obj_s = if qbe_is_obj_ty(g, concrete_ty) { "1" } else { "0" }
  let fz_sym = if qbe_is_obj_ty(g, concrete_ty) {
    let f = qbe_ensure_freeze_fn(g, concrete_ty)
    if f.length() > 0 { f } else { "0" }
  } else {
    "0"
  }
  let impl_key = c_trait + "::" + tname
  let vt_sb = StringBuilder()
  vt_sb.write_string("data ")
  vt_sb.write_string(vt_sym)
  vt_sb.write_string(" = align 8 { l ")
  vt_sb.write_string(is_obj_s)
  vt_sb.write_string(", l ")
  vt_sb.write_string(fz_sym)
  match lookup_trait_canonical(g.tc, c_trait) {
    Some(tinfo) =>
      match g.tc.impls.get(impl_key) {
        Some(iinfo) => {
          let mut mi = 0
          while mi < tinfo.methods.length() {
            let tm = tinfo.methods[mi]
            let wrap_sym = "$pion_dyn_wrap_" +
              qbe_mangle_pair(c_trait, tname) +
              qbe_mangle_member_suffix(tm.name)
            vt_sb.write_string(", l ")
            vt_sb.write_string(wrap_sym)
            let impl_sym = qbe_impl_method_sym(
              g,
              iinfo.pkg_name,
              iinfo.trait_name,
              iinfo.target_type,
              tm.name,
            )
            let ret_abi = qbe_abi_ty(tm.ret_ty)
            let wsb = StringBuilder()
            wsb.write_string("function ")
            wsb.write_string(ret_abi)
            wsb.write_string(" ")
            wsb.write_string(wrap_sym)
            wsb.write_string("(l %self_raw")
            let mut pi = 1
            while pi < tm.param_tys.length() {
              wsb.write_string(", ")
              wsb.write_string(qbe_abi_ty(tm.param_tys[pi]))
              wsb.write_string(" %a")
              wsb.write_string(pi.to_string())
              pi = pi + 1
            }
            wsb.write_string(") {\n@start\n")
            let self_arg = if qbe_is_int32_ty(concrete_ty) {
              wsb.write_string("    %self =w copy %self_raw\n")
              "w %self"
            } else if qbe_is_double_ty(concrete_ty) {
              wsb.write_string("    %self =d cast %self_raw\n")
              "d %self"
            } else {
              "l %self_raw"
            }
            wsb.write_string("    %r =")
            wsb.write_string(ret_abi)
            wsb.write_string(" call ")
            wsb.write_string(impl_sym)
            wsb.write_string("(")
            wsb.write_string(self_arg)
            pi = 1
            while pi < tm.param_tys.length() {
              wsb.write_string(", ")
              wsb.write_string(qbe_abi_ty(tm.param_tys[pi]))
              wsb.write_string(" %a")
              wsb.write_string(pi.to_string())
              pi = pi + 1
            }
            wsb.write_string(")\n    ret %r\n}\n\n")
            g.extra_fns.push(wsb.to_string())
            mi = mi + 1
          }
        }
        None => ()
      }
    None => ()
  }
  vt_sb.write_string(" }\n")
  g.dyn_vtables.push(vt_sb.to_string())
  vt_sym
}

///|
fn qbe_box_dyn(g : QbeGen, v : QbeVal, trait_name : String) -> QbeVal {
  let c_trait = qbe_local_unqual_target(
    g,
    resolve_canonical_trait_name(g.tc, trait_name),
  )
  let vt_sym = qbe_ensure_dyn_vtable(g, c_trait, v.ty)
  g.need_drop_dyn = true
  let data_l = qbe_as_l(g, v)
  let box_r = qbe_tmp(g)
  let vp = qbe_tmp(g)
  qbe_emit(g, box_r + " =l call $pion_alloc_uninit(w 16, w 4, l $pion_drop_dyn)")
  qbe_emit(g, "storel " + data_l + ", " + box_r)
  qbe_emit(g, vp + " =l add " + box_r + ", 8")
  qbe_emit(g, "storel " + vt_sym + ", " + vp)
  qval(box_r, TDynTrait(c_trait))
}

///|
/// Storing object `val_l` into container `container` (an `Array` / `Map`
/// shared through a `Mutex` is frozen, `owner_tid == 0`): deep-freeze the
/// value first so its RC (and that of everything it owns) stays atomic on
/// whichever thread later releases it. `deep_only` skips types the runtime's
/// own adopt-on-store already freezes completely.
fn qbe_emit_adopt_if_frozen(
  g : QbeGen,
  container : String,
  val_l : String,
  raw_elem : Ty,
  deep_only : Bool,
) -> Unit {
  let elem = subst_ty(raw_elem, g.cur_type_subst)
  if !qbe_is_obj_ty(g, elem) {
    return
  }
  let sym = qbe_ensure_freeze_fn(g, elem)
  if sym == "" || (deep_only && sym == "$pion_rc_freeze") {
    return
  }
  let hp = qbe_tmp(g)
  let tid = qbe_tmp(g)
  let fz = qbe_tmp(g)
  let l_fz = qbe_lbl(g, "adopt_fz")
  let l_go = qbe_lbl(g, "adopt_go")
  qbe_emit(g, hp + " =l sub " + container + ", 24")
  qbe_emit(g, tid + " =w loaduw " + hp)
  qbe_emit(g, fz + " =w ceqw " + tid + ", 0")
  qbe_emit_term(g, "jnz " + fz + ", " + l_fz + ", " + l_go)
  qbe_emit_lbl(g, l_fz)
  qbe_emit(g, "call " + sym + "(l " + val_l + ")")
  qbe_emit_term(g, "jmp " + l_go)
  qbe_emit_lbl(g, l_go)
}

///|
fn qbe_emit_deep_freeze(g : QbeGen, reg_l : String, raw_ty : Ty) -> Unit {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "frz_do")
        let l_sk = qbe_lbl(g, "frz_sk")
        qbe_emit_jnz_l(g, "%tp_" + tn, l_do, l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_freeze(l " + reg_l + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
        return
      }
    _ => ()
  }
  if !qbe_is_obj_ty(g, ty) {
    return
  }
  let sym = qbe_ensure_freeze_fn(g, ty)
  if sym != "" {
    qbe_emit(g, "call " + sym + "(l " + reg_l + ")")
  }
}

///|
fn qbe_match_eq_var_const(g : QbeGen, cond : Expr) -> Option[QbeEqVarConst] {
  match cond {
    EBinary("==", l, r, _) => {
      match l {
        EIdent(vname, _) =>
          match qbe_try_const_int(g, r) {
            Some(cv) =>
              match qbe_lookup_local(g, vname) {
                Some(loc) =>
                  if !loc.is_cell {
                    match loc.ty {
                      TInt => return Some(QbeEqVarConst::{ vname: vname, cval: cv })
                      _ => ()
                    }
                  }
                None => ()
              }
            None => ()
          }
        _ => ()
      }
      match r {
        EIdent(vname, _) =>
          match qbe_try_const_int(g, l) {
            Some(cv) =>
              match qbe_lookup_local(g, vname) {
                Some(loc) =>
                  if !loc.is_cell {
                    match loc.ty {
                      TInt => return Some(QbeEqVarConst::{ vname: vname, cval: cv })
                      _ => ()
                    }
                  }
                None => ()
              }
            None => ()
          }
        _ => ()
      }
      None
    }
    _ => None
  }
}

///|
fn qbe_sort_switch_arms(arms : Array[QbeSwitchArm]) -> Unit {
  let mut i = 1
  while i < arms.length() {
    let key = arms[i]
    let mut j = i - 1
    while j >= 0 && arms[j].cval > key.cval {
      arms[j + 1] = arms[j]
      j = j - 1
    }
    arms[j + 1] = key
    i = i + 1
  }
}

///|
fn qbe_try_collect_if_switch(
  g : QbeGen,
  cond : Expr,
  then_stmts : Array[Stmt],
  else_opt : Option[Expr],
) -> Option[QbeSwitchPlan] {
  let first = match qbe_match_eq_var_const(g, cond) {
    Some(f) => f
    None => return None
  }
  let vname = first.vname
  let arms : Array[QbeSwitchArm] = [
    QbeSwitchArm::{ cval: first.cval, stmts: then_stmts, expr_opt: None },
  ]
  let seen : Map[String, Bool] = Map([])
  seen.set(first.cval.to_string(), true)
  let mut cur_else = else_opt
  while true {
    match cur_else {
      Some(EIf(c2, t2, e2, _)) =>
        match qbe_match_eq_var_const(g, c2) {
          Some(pion) =>
            if pion.vname == vname && !seen.contains(pion.cval.to_string()) {
              seen.set(pion.cval.to_string(), true)
              arms.push(QbeSwitchArm::{ cval: pion.cval, stmts: t2, expr_opt: None })
              cur_else = e2
            } else {
              break
            }
          None => break
        }
      _ => break
    }
  }
  if arms.length() < 6 {
    return None
  }
  qbe_sort_switch_arms(arms)
  Some(QbeSwitchPlan::{ vname: vname, arms: arms, default_opt: cur_else })
}

///|
fn qbe_emit_dispatch_subtree(
  g : QbeGen,
  val_reg : String,
  arms : Array[QbeSwitchArm],
  arm_lbls : Array[String],
  lo : Int,
  hi : Int,
  default_lbl : String,
) -> Unit {
  if lo > hi {
    qbe_emit_term(g, "jmp " + default_lbl)
    return
  }
  if lo == hi {
    let cmp = qbe_tmp(g)
    qbe_emit(g, cmp + " =w ceqw " + val_reg + ", " + arms[lo].cval.to_string())
    qbe_emit_term(g, "jnz " + cmp + ", " + arm_lbls[lo] + ", " + default_lbl)
    return
  }
  let mid = lo + (hi - lo) / 2
  let pivot = arms[mid].cval.to_string()
  let eq_r = qbe_tmp(g)
  let l_neq = qbe_lbl(g, "sw_neq")
  qbe_emit(g, eq_r + " =w ceqw " + val_reg + ", " + pivot)
  qbe_emit_term(g, "jnz " + eq_r + ", " + arm_lbls[mid] + ", " + l_neq)
  qbe_emit_lbl(g, l_neq)
  if lo == mid {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, mid + 1, hi, default_lbl)
  } else if mid == hi {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, lo, mid - 1, default_lbl)
  } else {
    let lt_r = qbe_tmp(g)
    let l_left = qbe_lbl(g, "sw_lt")
    let l_right = qbe_lbl(g, "sw_gt")
    qbe_emit(g, lt_r + " =w csltw " + val_reg + ", " + pivot)
    qbe_emit_term(g, "jnz " + lt_r + ", " + l_left + ", " + l_right)
    qbe_emit_lbl(g, l_left)
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, lo, mid - 1, default_lbl)
    qbe_emit_lbl(g, l_right)
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, mid + 1, hi, default_lbl)
  }
}

///|
fn qbe_emit_int_dispatch(
  g : QbeGen,
  val_reg : String,
  arms : Array[QbeSwitchArm],
  default_expr_opt : Option[Expr],
  default_bind_name : String,
  is_match_no_default : Bool,
  sp : Span,
  expected : Option[Ty],
  is_void : Bool,
) -> QbeVal {
  let arm_lbls : Array[String] = []
  let mut i = 0
  while i < arms.length() {
    arm_lbls.push(qbe_lbl(g, "sw_arm"))
    i = i + 1
  }
  let l_def = qbe_lbl(g, "sw_def")
  let l_end = qbe_lbl(g, "sw_end")
  let min_v = arms[0].cval.to_int64()
  let max_v = arms[arms.length() - 1].cval.to_int64()
  let span = max_v - min_v + 1L
  if arms.length() >= 6 &&
    span >= 6L &&
    span <= 256L &&
    span <= (arms.length() * 2).to_int64() {
    let idx_w = if min_v == 0L {
      val_reg
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =w sub " + val_reg + ", " + arms[0].cval.to_string())
      t
    }
    let span_n = span.to_int()
    let tbl : Array[String] = []
    let mut k = 0
    while k < span_n {
      tbl.push(l_def)
      k = k + 1
    }
    k = 0
    while k < arms.length() {
      let slot_idx = (arms[k].cval.to_int64() - min_v).to_int()
      tbl[slot_idx] = arm_lbls[k]
      k = k + 1
    }
    let sb = StringBuilder()
    sb.write_string("jtbl ")
    sb.write_string(idx_w)
    sb.write_string(", ")
    sb.write_string(l_def)
    k = 0
    while k < span_n {
      sb.write_string(", ")
      sb.write_string(tbl[k])
      k = k + 1
    }
    qbe_emit_term(g, sb.to_string())
  } else {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, 0, arms.length() - 1, l_def)
  }

  let mut res_slot = ""
  let mut res_ty : Option[Ty] = if is_void {
    None
  } else {
    qbe_probe_switch_arms_ty(g, arms, default_expr_opt, default_bind_name, expected)
  }
  let mut saw_untyped_none = false
  let mut all_term = true

  i = 0
  while i < arms.length() {
    qbe_emit_lbl(g, arm_lbls[i])
    qbe_scope_push(g)
    let av = match arms[i].expr_opt {
      Some(e) => qbe_emit_expr(g, e, if is_void { None } else { res_ty })
      None => qbe_emit_stmts(g, arms[i].stmts, if is_void { None } else { res_ty })
    }
    if !g.block_term {
      all_term = false
      if is_void {
        qbe_rc_dec(g, av.reg, av.ty)
      } else {
        match res_ty {
          None =>
            match av.ty {
              TNever => ()
              _ => {
                if qbe_ty_has_untyped_option(av.ty) {
                  saw_untyped_none = true
                }
                res_ty = Some(av.ty)
              }
            }
          Some(rt) => {
            if qbe_ty_has_untyped_option(av.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(ty_prefer_concrete(rt, av.ty))
          }
        }
        let store_ty = match res_ty {
          Some(t) => t
          None => av.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, av, store_ty), res_slot, store_ty)
      }
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "jmp " + l_end)
    i = i + 1
  }

  qbe_emit_lbl(g, l_def)
  match default_expr_opt {
    Some(de) => {
      qbe_scope_push(g)
      if default_bind_name != "" {
        let bloc = qbe_define_local(g, default_bind_name, TInt, false)
        qbe_store_local_slot(g, val_reg, bloc.slot, TInt)
      }
      let dv = qbe_emit_expr(g, de, if is_void { None } else { res_ty })
      if !g.block_term {
        all_term = false
        if is_void {
          qbe_rc_dec(g, dv.reg, dv.ty)
        } else {
          match res_ty {
            None =>
              match dv.ty {
                TNever => ()
                _ => {
                  if qbe_ty_has_untyped_option(dv.ty) {
                    saw_untyped_none = true
                  }
                  res_ty = Some(dv.ty)
                }
              }
            Some(rt) => {
              if qbe_ty_has_untyped_option(dv.ty) {
                saw_untyped_none = true
              }
              res_ty = Some(ty_prefer_concrete(rt, dv.ty))
            }
          }
          let store_ty = match res_ty {
            Some(t) => t
            None => dv.ty
          }
          if res_slot == "" {
            res_slot = qbe_alloc_slot_for(g, store_ty)
          }
          qbe_store_local_slot(g, qbe_coerce_val(g, dv, store_ty), res_slot, store_ty)
        }
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
    }
    None =>
      if is_match_no_default {
        let file_id = qbe_intern_source_path(g, sp.file)
        let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
        qbe_emit(
          g,
          "call $pion_panic(l $pion_cstr_" +
          msg_id.to_string() +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_emit_term(g, "jmp " + l_end)
      } else {
        all_term = false
        qbe_emit_term(g, "jmp " + l_end)
      }
  }

  qbe_emit_lbl(g, l_end)
  if is_void {
    qval("0", TUnit)
  } else if all_term {
    qval("0", TNever)
  } else {
    let final_ty = match res_ty {
      Some(t) => t
      None => TUnit
    }
    if res_slot == "" {
      qval(qbe_zero_reg(final_ty), final_ty)
    } else {
      let mut r = qbe_load_local_slot(g, res_slot, final_ty)
      if saw_untyped_none {
        r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
      }
      qval(r, final_ty)
    }
  }
}

///|
fn qbe_parse_int64_lit(raw : String) -> Int64 {
  let mut len = raw.length()
  while len > 0 &&
    (str_code_at(raw, len - 1) == 76 || str_code_at(raw, len - 1) == 85) {
    len = len - 1
  }
  let mut start = 0
  let mut neg = false
  if len > 0 && str_code_at(raw, 0) == 45 {
    neg = true
    start = 1
  }
  let acc = if len - start >= 2 &&
    str_code_at(raw, start) == 48 &&
    (str_code_at(raw, start + 1) == 120 || str_code_at(raw, start + 1) == 88) {
    let mut a = 0L
    let mut i = start + 2
    while i < len {
      let c = str_code_at(raw, i)
      if c == 95 {
        i = i + 1
        continue
      }
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 65 && c <= 70 {
        c - 55
      } else if c >= 97 && c <= 102 {
        c - 87
      } else {
        0
      }
      a = (a << 4) | d.to_int64()
      i = i + 1
    }
    a
  } else {
    let mut a = 0L
    let mut i = start
    while i < len {
      let c = str_code_at(raw, i)
      if c >= 48 && c <= 57 {
        a = a * 10L + (c - 48).to_int64()
      }
      i = i + 1
    }
    a
  }
  if neg {
    0L - acc
  } else {
    acc
  }
}

///|
fn qbe_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    0
  }
}

///|
fn qbe_emit_arr_contains(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  raw_elem : Ty,
  arg : Expr,
  args_pure : Bool,
) -> QbeVal {
  let elem = subst_ty(raw_elem, g.cur_type_subst)
  let has_custom = qbe_ty_has_custom_eq(g, elem, Map([]))
  let va = qbe_emit_arg_maybe_borrow(g, arg, Some(elem), args_pure && !has_custom)
  let tv = va.qv
  let target_reg = qbe_coerce_val(g, tv, elem)
  let obj_pinned = has_custom && obj_borrowed
  if obj_pinned {
    qbe_rc_inc(g, obj_val, TArray(elem))
  }
  let alen_init = qbe_tmp(g)
  let dp_init = qbe_tmp(g)
  let idx_slot = qbe_alloc_slot(g)
  let res_slot = qbe_alloc_slot(g)
  let l_cond = qbe_lbl(g, "ac_cond")
  let l_body = qbe_lbl(g, "ac_body")
  let l_found = qbe_lbl(g, "ac_found")
  let l_next = qbe_lbl(g, "ac_next")
  let l_end = qbe_lbl(g, "ac_end")
  if !has_custom {
    let dp_p = qbe_tmp(g)
    qbe_emit(g, alen_init + " =l loadl " + obj_val)
    qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
    qbe_emit(g, dp_init + " =l loadl " + dp_p)
  }
  qbe_emit(g, "storel 0, " + idx_slot)
  qbe_emit(g, "storel 0, " + res_slot)
  qbe_emit_term(g, "jmp " + l_cond)
  qbe_emit_lbl(g, l_cond)
  let cur_i = qbe_tmp(g)
  let cmp_i = qbe_tmp(g)
  qbe_emit(g, cur_i + " =l loadl " + idx_slot)
  let alen = if has_custom {
    let a = qbe_tmp(g)
    qbe_emit(g, a + " =l loadl " + obj_val)
    a
  } else {
    alen_init
  }
  qbe_emit(g, cmp_i + " =w csltl " + cur_i + ", " + alen)
  qbe_emit_term(g, "jnz " + cmp_i + ", " + l_body + ", " + l_end)
  qbe_emit_lbl(g, l_body)
  let dp = if has_custom {
    let dp_p2 = qbe_tmp(g)
    let d2 = qbe_tmp(g)
    qbe_emit(g, dp_p2 + " =l add " + obj_val + ", 24")
    qbe_emit(g, d2 + " =l loadl " + dp_p2)
    d2
  } else {
    dp_init
  }
  let flat_stride = qbe_flat_pod_stride(g, elem)
  let mut ev_needs_dec = false
  let ev = if flat_stride > 0 {
    let ep = qbe_emit_arr_elem_addr(g, dp, cur_i, flat_stride)
    if has_custom {
      match qbe_flat_pod_struct_info(g, elem) {
        Some(sinfo) => {
          ev_needs_dec = true
          qbe_emit_flat_materialize(g, ep, sinfo, elem, true)
        }
        None => ep
      }
    } else {
      ep
    }
  } else {
    let ep = qbe_emit_arr_ep_ty(g, dp, cur_i, elem)
    let loaded = qbe_load_arr_elem(g, ep, elem)
    if has_custom && qbe_is_obj_ty(g, elem) {
      qbe_rc_inc(g, loaded, elem)
      ev_needs_dec = true
    }
    loaded
  }
  let eq_w = qbe_tmp(g)
  match elem {
    TString =>
      qbe_emit(g, eq_w + " =w call $pion_str_eq(l " + ev + ", l " + target_reg + ")")
    TInt | TUInt =>
      qbe_emit(g, eq_w + " =w ceqw " + ev + ", " + target_reg)
    TDouble =>
      qbe_emit(g, eq_w + " =w ceqd " + ev + ", " + target_reg)
    TFloat =>
      qbe_emit(g, eq_w + " =w ceqs " + ev + ", " + target_reg)
    _ =>
      if qbe_type_needs_eq_fn(g, elem) {
        let eq_sym = qbe_ensure_eq_fn(g, elem)
        qbe_emit(g, eq_w + " =w call " + eq_sym + "(l " + ev + ", l " + target_reg + ")")
      } else {
        let lc = qbe_cmp_operand(g, ev, elem)
        let rc = qbe_cmp_operand(g, target_reg, elem)
        qbe_emit(g, eq_w + " =w ceql " + lc + ", " + rc)
      }
  }
  if ev_needs_dec {
    qbe_rc_dec(g, ev, elem)
  }
  if has_custom {
    qbe_invalidate_aliased_min_lens(g)
  }
  qbe_emit_term(g, "jnz " + eq_w + ", " + l_found + ", " + l_next)
  qbe_emit_lbl(g, l_found)
  qbe_emit(g, "storel 1, " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_next)
  let next_i = qbe_tmp(g)
  qbe_emit(g, next_i + " =l add " + cur_i + ", 1")
  qbe_emit(g, "storel " + next_i + ", " + idx_slot)
  qbe_emit_term(g, "jmp " + l_cond)
  qbe_emit_lbl(g, l_end)
  if !va.borrowed {
    qbe_rc_dec(g, tv.reg, tv.ty)
  }
  if !obj_borrowed || obj_pinned {
    qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
  }
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + res_slot)
  qval(r, TBool)
}

///|
fn qbe_parse_char_lit(raw : String) -> Int {
  let len = raw.length()
  if len == 0 {
    return 0
  }
  let c0 = str_code_at(raw, 0)
  if c0 == 92 && len >= 2 {
    let c1 = str_code_at(raw, 1)
    if c1 == 110 {
      10
    } else if c1 == 114 {
      13
    } else if c1 == 116 {
      9
    } else if c1 == 92 {
      92
    } else if c1 == 39 {
      39
    } else if c1 == 34 {
      34
    } else if c1 == 48 {
      0
    } else if c1 == 120 && len >= 4 {
      let h1 = qbe_hex_val(str_code_at(raw, 2))
      let h2 = qbe_hex_val(str_code_at(raw, 3))
      (h1 << 4) | h2
    } else if c1 == 117 && len >= 5 && str_code_at(raw, 2) == 123 {
      let mut p = 3
      let mut cp = 0
      while p < len {
        let ch = str_code_at(raw, p)
        if ch == 125 {
          break
        }
        let hv = qbe_hex_val(ch)
        if hv >= 0 {
          cp = (cp << 4) | hv
        }
        p = p + 1
      }
      cp
    } else {
      str_scalar_at(raw, 1, host_str_is_utf8())
    }
  } else if c0 >= 0x80 {
    str_scalar_at(raw, 0, host_str_is_utf8())
  } else {
    c0
  }
}

///|
fn qbe_emit_none(g : QbeGen, raw_inner_ty : Ty) -> String {
  let inner_ty = subst_ty(raw_inner_ty, g.cur_type_subst)
  if qbe_is_niche_opt_inner(g, inner_ty) {
    return "0"
  }
  g.need_none_const = true
  let t = qbe_tmp(g)
  qbe_emit(g, t + " =l add $pion_none_hdr, 24")
  g.immortal_regs.set(t, true)
  t
}

///|
fn qbe_select_drop_by_tparam(
  g : QbeGen,
  tn : String,
  sym_when_obj : String,
) -> String {
  let slot = qbe_alloc_slot(g)
  let l_obj = qbe_lbl(g, "dp_obj")
  let l_prim = qbe_lbl(g, "dp_prim")
  let l_end = qbe_lbl(g, "dp_end")
  qbe_emit_jnz_l(g, "%tp_" + tn, l_obj, l_prim)
  qbe_emit_lbl(g, l_obj)
  qbe_emit(g, "storel " + sym_when_obj + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_prim)
  qbe_emit(g, "storel 0, " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_add_tp_drop_slot(
  tp_names : Array[String],
  tp_slots : Array[Array[Int]],
  tn : String,
  slot_idx : Int,
) -> Unit {
  let mut i = 0
  while i < tp_names.length() {
    if tp_names[i] == tn {
      tp_slots[i].push(slot_idx)
      return
    }
    i = i + 1
  }
  tp_names.push(tn)
  let arr : Array[Int] = []
  arr.push(slot_idx)
  tp_slots.push(arr)
}

///|
fn qbe_emit_dynamic_slot_drop(
  g : QbeGen,
  static_slots : Array[Int],
  tp_names : Array[String],
  tp_slots : Array[Array[Int]],
) -> String {
  if tp_names.length() == 0 {
    return qbe_register_slot_drop(g, static_slots)
  }
  if tp_names.length() == 1 {
    let s_obj = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, tp_slots[0]))
    let s_prim = qbe_register_slot_drop(g, static_slots)
    if s_obj == s_prim {
      return s_prim
    }
    let slot = qbe_alloc_slot(g)
    let l_obj = qbe_lbl(g, "sdp_obj")
    let l_prim = qbe_lbl(g, "sdp_prim")
    let l_end = qbe_lbl(g, "sdp_end")
    qbe_emit_jnz_l(g, "%tp_" + tp_names[0], l_obj, l_prim)
    qbe_emit_lbl(g, l_obj)
    qbe_emit(g, "storel " + s_obj + ", " + slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_prim)
    qbe_emit(g, "storel " + s_prim + ", " + slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =l loadl " + slot)
    return r
  }
  let m0 = tp_slots[0]
  let m1 = tp_slots[1]
  let s00 = qbe_register_slot_drop(g, static_slots)
  let s01 = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, m1))
  let s10 = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, m0))
  let s11 = qbe_register_slot_drop(
    g,
    qbe_merge_slot_lists(qbe_merge_slot_lists(static_slots, m0), m1),
  )
  let slot = qbe_alloc_slot(g)
  let l_1 = qbe_lbl(g, "sdp_1")
  let l_0 = qbe_lbl(g, "sdp_0")
  let l_11 = qbe_lbl(g, "sdp_11")
  let l_10 = qbe_lbl(g, "sdp_10")
  let l_01 = qbe_lbl(g, "sdp_01")
  let l_00 = qbe_lbl(g, "sdp_00")
  let l_end = qbe_lbl(g, "sdp_end2")
  qbe_emit_jnz_l(g, "%tp_" + tp_names[0], l_1, l_0)
  qbe_emit_lbl(g, l_1)
  qbe_emit_jnz_l(g, "%tp_" + tp_names[1], l_11, l_10)
  qbe_emit_lbl(g, l_11)
  qbe_emit(g, "storel " + s11 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_10)
  qbe_emit(g, "storel " + s10 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_0)
  qbe_emit_jnz_l(g, "%tp_" + tp_names[1], l_01, l_00)
  qbe_emit_lbl(g, l_01)
  qbe_emit(g, "storel " + s01 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_00)
  qbe_emit(g, "storel " + s00 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_emit_some(g : QbeGen, vreg : String, raw_inner_ty : Ty) -> String {
  let inner_ty = subst_ty(raw_inner_ty, g.cur_type_subst)
  if qbe_is_niche_opt_inner(g, inner_ty) {
    return vreg
  }
  let drop_sym = match inner_ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        g.need_drop_opt_obj = true
        qbe_select_drop_by_tparam(g, tn, "$pion_drop_opt_obj")
      } else {
        "0"
      }
    _ =>
      if qbe_is_obj_ty(g, inner_ty) {
        g.need_drop_opt_obj = true
        "$pion_drop_opt_obj"
      } else {
        "0"
      }
  }
  let obj = qbe_tmp(g)
  qbe_emit(g, obj + " =l call $pion_alloc_uninit(w 16, w 5, l " + drop_sym + ")")
  qbe_emit(g, "storel 1, " + obj)
  let p1 = qbe_tmp(g)
  qbe_emit(g, p1 + " =l add " + obj + ", 8")
  qbe_emit(g, "storel " + vreg + ", " + p1)
  obj
}

///|
fn qbe_emit_result(
  g : QbeGen,
  tag : Int,
  vreg : String,
  ok_ty : Ty,
  err_ty : Ty,
) -> String {
  let active_ty = subst_ty(if tag == 0 { ok_ty } else { err_ty }, g.cur_type_subst)
  let active_drop = if tag == 0 {
    "$pion_drop_res_ok"
  } else {
    "$pion_drop_res_err"
  }
  let drop_sym = match active_ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        if tag == 0 {
          g.need_drop_res_ok = true
        } else {
          g.need_drop_res_err = true
        }
        qbe_select_drop_by_tparam(g, tn, active_drop)
      } else {
        "0"
      }
    _ =>
      if qbe_is_obj_ty(g, active_ty) {
        if tag == 0 {
          g.need_drop_res_ok = true
        } else {
          g.need_drop_res_err = true
        }
        active_drop
      } else {
        "0"
      }
  }
  let obj = qbe_tmp(g)
  qbe_emit(g, obj + " =l call $pion_alloc_uninit(w 16, w 5, l " + drop_sym + ")")
  qbe_emit(g, "storel " + tag.to_string() + ", " + obj)
  let p1 = qbe_tmp(g)
  qbe_emit(g, p1 + " =l add " + obj + ", 8")
  qbe_emit(g, "storel " + vreg + ", " + p1)
  obj
}

///|
fn qbe_emit_string_lit(g : QbeGen, s : String) -> String {
  let id = qbe_intern_string(g, s)
  let t = qbe_tmp(g)
  qbe_emit(g, t + " =l add $pion_str_" + id.to_string() + "_hdr, 24")
  g.immortal_regs.set(t, true)
  t
}

///|
fn qbe_emit_closure_call(
  g : QbeGen,
  clo_val : String,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
) -> String {
  let l_args : Array[String] = []
  let mut k = 0
  while k < arg_vals.length() {
    l_args.push(qbe_as_l(g, qval(arg_vals[k], arg_tys[k])))
    k = k + 1
  }
  let fn_ptr = qbe_tmp(g)
  qbe_emit(g, fn_ptr + " =l loadl " + clo_val)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =l call ")
  sb.write_string(fn_ptr)
  sb.write_string("(l ")
  sb.write_string(clo_val)
  let mut i = 0
  while i < l_args.length() {
    sb.write_string(", l ")
    sb.write_string(l_args[i])
    i = i + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  let mut j = 0
  while j < arg_vals.length() {
    qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    j = j + 1
  }
  qbe_emit(g, "call $pion_rc_dec(l " + clo_val + ")")
  res
}

///|
fn qbe_emit_world_builtin(
  g : QbeGen,
  name : String,
  args : Array[Expr],
) -> QbeVal {
  let can_borrow = !qbe_args_may_mutate_locals(g, args)
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let arg_borrowed : Array[Bool] = []
  let mut i = 0
  while i < args.length() {
    let av = qbe_emit_arg_maybe_borrow(g, args[i], None, can_borrow)
    arg_vals.push(av.qv.reg)
    arg_tys.push(av.qv.ty)
    arg_borrowed.push(av.borrowed)
    i = i + 1
  }
  let mut has_w = false
  let mut w_val = "0"
  if arg_tys.length() > 0 {
    match arg_tys[0] {
      TWorld => {
        has_w = true
        w_val = arg_vals[0]
      }
      _ => ()
    }
  }
  if !has_w {
    match qbe_find_world_slot(g) {
      Some(ws) => {
        let wt = qbe_tmp(g)
        qbe_emit(g, wt + " =l loadl " + ws)
        w_val = wt
      }
      None => w_val = "0"
    }
  }
  let off = if has_w { 1 } else { 0 }
  let mut res = "0"
  let mut rty = TUnit
  if name == "io_print" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_print(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_println" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_println(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_eprintln" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_eprintln(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_read_line" {
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s + " =l call $pion_world_read_line(l " + w_val + ", l " + ok_slot + ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_some = qbe_lbl(g, "rl_some")
    let l_none = qbe_lbl(g, "rl_none")
    let l_end = qbe_lbl(g, "rl_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
    qbe_emit_lbl(g, l_some)
    let some_obj = qbe_emit_some(g, raw_s, TString)
    qbe_emit(g, "storel " + some_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_none)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let none_obj = qbe_emit_none(g, TString)
    qbe_emit(g, "storel " + none_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TOption(TString)
  } else if name == "fs_read" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_fs_read(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsr_ok")
    let l_err = qbe_lbl(g, "fsr_err")
    let l_end = qbe_lbl(g, "fsr_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let err_s = qbe_emit_string_lit(g, "fs_read failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "fs_write" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let c = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_write(l " + w_val + ", l " + p + ", l " + c + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsw_ok")
    let l_err = qbe_lbl(g, "fsw_err")
    let l_end = qbe_lbl(g, "fsw_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_write failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_read_bytes" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_b = qbe_tmp(g)
    qbe_emit(
      g,
      raw_b +
      " =l call $pion_world_fs_read_bytes(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsrb_ok")
    let l_err = qbe_lbl(g, "fsrb_err")
    let l_end = qbe_lbl(g, "fsrb_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_b, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_b + ")")
    let err_s = qbe_emit_string_lit(g, "fs_read_bytes failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  } else if name == "fs_write_bytes" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let b = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_write_bytes(l " + w_val + ", l " + p + ", l " + b + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fswb_ok")
    let l_err = qbe_lbl(g, "fswb_err")
    let l_end = qbe_lbl(g, "fswb_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_write_bytes failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_append" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let c = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_append(l " + w_val + ", l " + p + ", l " + c + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsap_ok")
    let l_err = qbe_lbl(g, "fsap_err")
    let l_end = qbe_lbl(g, "fsap_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_append failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_mtime_ms" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_mtime_ms(l " + w_val + ", l " + p + ")")
    rty = TInt64
  } else if name == "fs_exists" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_exists(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_is_dir" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_is_dir(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_mkdir_p" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_mkdir_p(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_remove" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_remove(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_rename" {
    let p1 = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let p2 = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw +
      " =w call $pion_world_fs_rename(l " +
      w_val +
      ", l " +
      p1 +
      ", l " +
      p2 +
      ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_size" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_size(l " + w_val + ", l " + p + ")")
    rty = TInt64
  } else if name == "fs_lstat" || name == "fs_readlink" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    let csym = if name == "fs_lstat" {
      "$pion_world_fs_lstat"
    } else {
      "$pion_world_fs_readlink"
    }
    qbe_emit(
      g,
      raw_s + " =l call " + csym + "(l " + w_val + ", l " + p + ", l " + ok_slot + ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsl_ok")
    let l_err = qbe_lbl(g, "fsl_err")
    let l_end = qbe_lbl(g, "fsl_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_obj = qbe_emit_result(g, 1, raw_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "fs_symlink" {
    let t = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let lp = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw + " =w call $pion_world_fs_symlink(l " + w_val + ", l " + t + ", l " + lp + ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_chmod" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let m_w = if arg_vals.length() > off + 1 {
      if qbe_abi_ty(arg_tys[off + 1]) == "w" {
        arg_vals[off + 1]
      } else {
        let tw = qbe_tmp(g)
        qbe_emit(g, tw + " =w copy " + arg_vals[off + 1])
        tw
      }
    } else {
      "0"
    }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw + " =w call $pion_world_fs_chmod(l " + w_val + ", l " + p + ", w " + m_w + ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_read_range_nofollow" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let off_l = if arg_vals.length() > off + 1 {
      qbe_as_l(g, qval(arg_vals[off + 1], arg_tys[off + 1]))
    } else {
      "0"
    }
    let len_l = if arg_vals.length() > off + 2 {
      qbe_as_l(g, qval(arg_vals[off + 2], arg_tys[off + 2]))
    } else {
      "0"
    }
    let exp_l = if arg_vals.length() > off + 3 {
      qbe_as_l(g, qval(arg_vals[off + 3], arg_tys[off + 3]))
    } else {
      "0"
    }
    let ok_slot = qbe_alloc_slot4(g)
    let raw = qbe_tmp(g)
    qbe_emit(
      g,
      raw +
      " =l call $pion_world_fs_read_range_nofollow(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      off_l +
      ", l " +
      len_l +
      ", l " +
      exp_l +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsrn_ok")
    let l_err = qbe_lbl(g, "fsrn_err")
    let l_end = qbe_lbl(g, "fsrn_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_obj = qbe_emit_result(g, 1, raw, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  } else if name == "fs_list_dir" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_list_dir(l " + w_val + ", l " + p + ")")
    rty = TArray(TString)
  } else if name == "args_get" || name == "world_args" {
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_args(l " + w_val + ")")
    rty = TArray(TString)
  } else if name == "world_argc" {
    let r64 = qbe_tmp(g)
    qbe_emit(g, r64 + " =l call $pion_world_argc(l " + w_val + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =w copy " + r64)
    rty = TInt
  } else if name == "world_argv" {
    let idx = if arg_vals.length() > off {
      qbe_as_l(g, qval(arg_vals[off], arg_tys[off]))
    } else {
      "0"
    }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_argv(l " + w_val + ", l " + idx + ")")
    rty = TString
  } else if name == "env_get" {
    let k = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_env_get(l " +
      w_val +
      ", l " +
      k +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_some = qbe_lbl(g, "env_some")
    let l_none = qbe_lbl(g, "env_none")
    let l_end = qbe_lbl(g, "env_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
    qbe_emit_lbl(g, l_some)
    let some_obj = qbe_emit_some(g, raw_s, TString)
    qbe_emit(g, "storel " + some_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_none)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let none_obj = qbe_emit_none(g, TString)
    qbe_emit(g, "storel " + none_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TOption(TString)
  } else if name == "clock_now_ms" {
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_clock_ms(l " + w_val + ")")
    rty = TInt64
  } else if name == "proc_exec" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =w call $pion_world_exec(l " + w_val + ", l " + arr + ")")
    rty = TInt
  } else if name == "proc_exec_capture" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rc_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_exec_capture(l " +
      w_val +
      ", l " +
      arr +
      ", l " +
      rc_slot +
      ")",
    )
    let rc_w = qbe_tmp(g)
    qbe_emit(g, rc_w + " =w loadw " + rc_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "pexc_ok")
    let l_err = qbe_lbl(g, "pexc_err")
    let l_end = qbe_lbl(g, "pexc_end")
    qbe_emit_term(g, "jnz " + rc_w + ", " + l_err + ", " + l_ok)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let rc_l = qbe_tmp(g)
    qbe_emit(g, rc_l + " =l extsw " + rc_w)
    let rc_str = qbe_tmp(g)
    qbe_emit(g, rc_str + " =l call $pion_int_to_str(l " + rc_l + ")")
    let pre_s = qbe_emit_string_lit(g, "exit ")
    let sep_s = qbe_emit_string_lit(g, ": ")
    let p1 = qbe_tmp(g)
    qbe_emit(g, p1 + " =l call $pion_str_concat(l " + pre_s + ", l " + rc_str + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + rc_str + ")")
    let p2 = qbe_tmp(g)
    qbe_emit(g, p2 + " =l call $pion_str_concat(l " + p1 + ", l " + sep_s + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + p1 + ")")
    let err_s = qbe_tmp(g)
    qbe_emit(g, err_s + " =l call $pion_str_concat(l " + p2 + ", l " + raw_s + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + p2 + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let err_obj = qbe_emit_result(g, 1, err_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "proc_exec_capture_bytes" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rc_slot = qbe_alloc_slot4(g)
    let raw_b = qbe_tmp(g)
    qbe_emit(
      g,
      raw_b +
      " =l call $pion_world_exec_capture_bytes(l " +
      w_val +
      ", l " +
      arr +
      ", l " +
      rc_slot +
      ")",
    )
    let rc_w = qbe_tmp(g)
    qbe_emit(g, rc_w + " =w loadw " + rc_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "pexb_ok")
    let l_err = qbe_lbl(g, "pexb_err")
    let l_end = qbe_lbl(g, "pexb_end")
    qbe_emit_term(g, "jnz " + rc_w + ", " + l_err + ", " + l_ok)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_b, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_b + ")")
    let rc_l = qbe_tmp(g)
    qbe_emit(g, rc_l + " =l extsw " + rc_w)
    let rc_str = qbe_tmp(g)
    qbe_emit(g, rc_str + " =l call $pion_int_to_str(l " + rc_l + ")")
    let pre_s = qbe_emit_string_lit(g, "exit ")
    let err_s = qbe_tmp(g)
    qbe_emit(g, err_s + " =l call $pion_str_concat(l " + pre_s + ", l " + rc_str + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + rc_str + ")")
    let err_obj = qbe_emit_result(g, 1, err_s, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  }
  let mut j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qval(res, rty)
}

///|
fn qbe_emit_variant_ctor(
  g : QbeGen,
  enum_name : String,
  vname : String,
  args : Array[Expr],
  expected : Option[Ty],
) -> QbeVal {
  if enum_name == "Option" || (enum_name == "" && (vname == "Some" || vname == "None")) {
    let exp_inner : Option[Ty] = match expected {
      Some(TOption(inner)) => Some(inner)
      _ => None
    }
    if vname == "None" {
      let inner_ty = match exp_inner {
        Some(t) => t
        None => TError
      }
      return qval(qbe_emit_none(g, inner_ty), TOption(inner_ty))
    }
    let av = if args.length() >= 1 {
      qbe_emit_expr(g, args[0], exp_inner)
    } else {
      qbe_fail_unresolved(g, "variant_ctor_arg", "Option", vname, span_empty())
    }
    return qval(qbe_emit_some(g, qbe_as_l(g, av), av.ty), TOption(av.ty))
  }
  if enum_name == "Result" || (enum_name == "" && (vname == "Ok" || vname == "Err")) {
    let mut exp_ok : Option[Ty] = None
    let mut exp_err : Option[Ty] = None
    match expected {
      Some(TResult(o, e)) => {
        exp_ok = Some(o)
        exp_err = Some(e)
      }
      _ => ()
    }
    if vname == "Ok" {
      let av = if args.length() >= 1 {
        qbe_emit_expr(g, args[0], exp_ok)
      } else {
        qbe_fail_unresolved(g, "variant_ctor_arg", "Result", "Ok", span_empty())
      }
      let ety = match exp_err {
        Some(e) => e
        None => TError
      }
      return qval(qbe_emit_result(g, 0, qbe_as_l(g, av), av.ty, ety), TResult(av.ty, ety))
    } else {
      let av = if args.length() >= 1 {
        qbe_emit_expr(g, args[0], exp_err)
      } else {
        qbe_fail_unresolved(g, "variant_ctor_arg", "Result", "Err", span_empty())
      }
      let oty = match exp_ok {
        Some(o) => o
        None => TError
      }
      return qval(qbe_emit_result(g, 1, qbe_as_l(g, av), oty, av.ty), TResult(oty, av.ty))
    }
  }
  let resolved_enum = if enum_name != "" {
    enum_name
  } else {
    match qbe_lookup_variant_enum(g, vname) {
      Some(en) => en
      None => ""
    }
  }
  match qbe_lookup_enum_info(g, resolved_enum) {
    None => qbe_fail_unresolved(g, "enum_variant_ctor", resolved_enum, vname, span_empty())
    Some(einfo) => {
      let subst : Map[String, Ty] = Map([])
      match expected {
        Some(TEnum(en, eargs)) =>
          if en == resolved_enum ||
            (g.mono_pkg != "" && g.mono_pkg + "::" + en == resolved_enum) ||
            (g.mono_pkg != "" && en == g.mono_pkg + "::" + resolved_enum) {
            let mut k = 0
            while k < einfo.decl.type_params.length() && k < eargs.length() {
              match eargs[k] {
                TError => ()
                _ => subst.set(einfo.decl.type_params[k], eargs[k])
              }
              k = k + 1
            }
          }
        _ => ()
      }
      let mut tag = 0
      let arg_vals : Array[String] = []
      let arg_tys : Array[Ty] = []
      let mut matched_field_tys : Array[Ty] = []
      let mut vi = 0
      while vi < einfo.variants.length() {
        let v = einfo.variants[vi]
        if v.name == vname {
          tag = vi
          matched_field_tys = v.field_tys
          let guards = qbe_arg_guards_in_order(g, args)
          let mut fi = 0
          while fi < args.length() {
            let exp_f : Option[Ty] = if fi < v.field_tys.length() {
              Some(subst_ty_mask_unbound(v.field_tys[fi], einfo.decl.type_params, subst))
            } else {
              None
            }
            let av = qbe_emit_expr(g, args[fi], exp_f)
            if fi < v.field_tys.length() {
              qbe_unify_tparams(g, v.field_tys[fi], av.ty, subst)
            }
            arg_vals.push(av.reg)
            arg_tys.push(av.ty)
            qbe_guard_val(g, guards, QbeArgVal::{ qv: av, borrowed: false }, false, guards.exits[fi])
            fi = fi + 1
          }
          qbe_release_guards(g, guards)
          break
        }
        vi = vi + 1
      }
      let layout = qbe_enum_layout_for_info(einfo)
      if arg_vals.length() == 0 {
        if layout.is_unit_only {
          let obj = qbe_tmp(g)
          qbe_emit(g, obj + " =l copy " + (tag + 1).to_string())
          return qval(obj, TEnum(resolved_enum, []))
        }
        if layout.is_niche {
          let obj = qbe_tmp(g)
          qbe_emit(g, obj + " =l copy 0")
          g.immortal_regs.set(obj, true)
          let targs : Array[Ty] = []
          let mut ti = 0
          while ti < einfo.decl.type_params.length() {
            match subst.get(einfo.decl.type_params[ti]) {
              Some(t) => targs.push(t)
              None => targs.push(TError)
            }
            ti = ti + 1
          }
          return qval(obj, TEnum(resolved_enum, targs))
        }
        let sym = qbe_register_enum_const(g, resolved_enum, vname, tag)
        let obj = qbe_tmp(g)
        qbe_emit(g, obj + " =l add " + sym + ", 24")
        g.immortal_regs.set(obj, true)
        let targs : Array[Ty] = []
        let mut ti = 0
        while ti < einfo.decl.type_params.length() {
          match subst.get(einfo.decl.type_params[ti]) {
            Some(t) => targs.push(t)
            None => targs.push(TError)
          }
          ti = ti + 1
        }
        return qval(obj, TEnum(resolved_enum, targs))
      }
      if arg_vals.length() == 1 && args.length() == 1 {
        match arg_tys[0] {
          TBool => {
            let targs : Array[Ty] = []
            let mut ti = 0
            while ti < einfo.decl.type_params.length() {
              match subst.get(einfo.decl.type_params[ti]) {
                Some(t) => targs.push(t)
                None => targs.push(TError)
              }
              ti = ti + 1
            }
            match args[0] {
              EBool(b, _) => {
                let sym = qbe_register_enum_bool_const(
                  g,
                  resolved_enum,
                  vname,
                  tag,
                  if b { 1 } else { 0 },
                  layout.is_niche,
                )
                let obj = qbe_tmp(g)
                qbe_emit(g, obj + " =l add " + sym + ", 24")
                g.immortal_regs.set(obj, true)
                return qval(obj, TEnum(resolved_enum, targs))
              }
              _ => {
                let sym_t = qbe_register_enum_bool_const(g, resolved_enum, vname, tag, 1, layout.is_niche)
                let sym_f = qbe_register_enum_bool_const(g, resolved_enum, vname, tag, 0, layout.is_niche)
                let res_slot = qbe_alloc_slot(g)
                let l_t = qbe_lbl(g, "eb_t")
                let l_f = qbe_lbl(g, "eb_f")
                let l_e = qbe_lbl(g, "eb_e")
                qbe_emit_jnz_l(g, arg_vals[0], l_t, l_f)
                qbe_emit_lbl(g, l_t)
                let ot = qbe_tmp(g)
                qbe_emit(g, ot + " =l add " + sym_t + ", 24")
                qbe_emit(g, "storel " + ot + ", " + res_slot)
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_f)
                let of = qbe_tmp(g)
                qbe_emit(g, of + " =l add " + sym_f + ", 24")
                qbe_emit(g, "storel " + of + ", " + res_slot)
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_e)
                let obj = qbe_tmp(g)
                qbe_emit(g, obj + " =l loadl " + res_slot)
                return qval(obj, TEnum(resolved_enum, targs))
              }
            }
          }
          _ => ()
        }
      }
      let payload_sz = layout.payload_offset + arg_vals.length() * 8
      let drop_sym = if einfo.decl.type_params.length() == 0 {
        if layout.is_niche {
          // A niche enum's payload object holds only the payload variant's
          // fields: drop it through the canonical slot helper.
          let pv = einfo.variants[layout.payload_tag]
          let obj_slots : Array[Int] = []
          let mut pfi = 0
          while pfi < pv.field_tys.length() {
            if qbe_is_obj_ty(g, pv.field_tys[pfi]) {
              obj_slots.push(layout.payload_offset / 8 + pfi)
            }
            pfi = pfi + 1
          }
          qbe_register_slot_drop(g, obj_slots)
        } else if qbe_tagged_enum_has_obj(g, einfo) {
          if has_qual_sep(resolved_enum) && !str_arr_contains(g.enum_order, resolved_enum) {
            g.enum_order.push(resolved_enum)
          }
          "$pion_drop_enum_" + qbe_mangle_qual_sym(resolved_enum)
        } else {
          // No variant carries an RC field: the drop would only read the tag.
          "0"
        }
      } else {
        let obj_slots : Array[Int] = []
        let tp_names : Array[String] = []
        let tp_slots : Array[Array[Int]] = []
        let mut fi = 0
        while fi < arg_tys.length() {
          if qbe_is_obj_ty(g, arg_tys[fi]) {
            obj_slots.push(layout.payload_slot_base + fi)
          } else {
            match arg_tys[fi] {
              TParam(tn) =>
                if qbe_tp_live(g, tn) {
                  qbe_add_tp_drop_slot(tp_names, tp_slots, tn, layout.payload_slot_base + fi)
                }
              _ => ()
            }
          }
          fi = fi + 1
        }
        qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
      }
      let obj = qbe_tmp(g)
      qbe_emit(
        g,
        obj +
        " =l call $pion_alloc_uninit(w " +
        payload_sz.to_string() +
        ", w 5, l " +
        drop_sym +
        ")",
      )
      if !layout.is_niche {
        qbe_emit(g, "storel " + tag.to_string() + ", " + obj)
      }
      let mut fi = 0
      while fi < arg_vals.length() {
        let off = layout.payload_offset + fi * 8
        let p = if off == 0 {
          obj
        } else {
          let pt = qbe_tmp(g)
          qbe_emit(g, pt + " =l add " + obj + ", " + off.to_string())
          pt
        }
        let store_ty = if fi < matched_field_tys.length() {
          let cty = subst_ty(
            subst_ty(matched_field_tys[fi], subst),
            g.cur_type_subst,
          )
          if ty_has_unresolved(cty) { arg_tys[fi] } else { cty }
        } else {
          arg_tys[fi]
        }
        let coerced = qbe_coerce_val(g, qval(arg_vals[fi], arg_tys[fi]), store_ty)
        qbe_store_heap_slot(g, coerced, p, store_ty)
        fi = fi + 1
      }
      let targs : Array[Ty] = []
      let mut ti = 0
      while ti < einfo.decl.type_params.length() {
        match subst.get(einfo.decl.type_params[ti]) {
          Some(t) => targs.push(t)
          None => targs.push(TError)
        }
        ti = ti + 1
      }
      qval(obj, TEnum(resolved_enum, targs))
    }
  }
}

///|
fn qbe_emit_closure_obj(
  g : QbeGen,
  params : Array[Param],
  ret_te : TypeExpr,
  body : Array[Stmt],
  is_spawn : Bool,
  expected : Option[Ty],
  sp : Span,
) -> QbeCloRes {
  let locals : Map[String, Bool] = Map([])
  let mut pi = 0
  while pi < params.length() {
    locals.set(params[pi].name, true)
    pi = pi + 1
  }
  let raw_caps : Array[CaptureInfo] = []
  collect_stmts_captures(body, locals, raw_caps)
  let cap_locals : Array[QbeLocal] = []
  let seen : Map[String, Bool] = Map([])
  let mut ci = 0
  while ci < raw_caps.length() {
    let cname = raw_caps[ci].name
    if !seen.contains(cname) {
      match qbe_lookup_local(g, cname) {
        Some(loc) => {
          seen.set(cname, true)
          g.unfrozen_local_arrs.remove(cname)
          cap_locals.push(loc)
        }
        None => ()
      }
    }
    ci = ci + 1
  }

  let clo_id = g.next_clo
  g.next_clo = clo_id + 1
  let fn_sym = if is_spawn {
    "$pion_spawn_" + clo_id.to_string()
  } else {
    "$pion_clo_" + clo_id.to_string()
  }

  let inf_ty = qbe_closure_infer(g, sp)
  let exp_ptys : Array[Ty] = match expected {
    Some(TFn(ep, _)) => ep
    _ => []
  }
  let inf_ptys : Array[Ty] = match inf_ty {
    Some(TFn(ip, _)) => ip
    _ => []
  }
  let ptys : Array[Ty] = []
  pi = 0
  while pi < params.length() {
    let pty = match params[pi].ty {
      TyMissing(_) => {
        let mut chosen = TError
        if pi < exp_ptys.length() && !qbe_ty_has_param(exp_ptys[pi]) {
          chosen = exp_ptys[pi]
        }
        match chosen {
          TError =>
            if pi < inf_ptys.length() {
              match inf_ptys[pi] {
                TError => ()
                t => chosen = t
              }
            }
          _ => ()
        }
        match chosen {
          TError =>
            if pi < exp_ptys.length() {
              chosen = exp_ptys[pi]
            }
          _ => ()
        }
        chosen
      }
      _ => qbe_resolve_type(g, params[pi].ty)
    }
    ptys.push(subst_ty(pty, g.cur_type_subst))
    pi = pi + 1
  }
  let raw_ret_ty = match ret_te {
    TyMissing(_) => {
      let mut chosen = TError
      match expected {
        Some(TFn(_, er)) =>
          if !qbe_ty_has_param(er) {
            chosen = er
          }
        _ => ()
      }
      match inf_ty {
        Some(TFn(_, ir)) =>
          match ir {
            TError => ()
            t => chosen = ty_prefer_concrete(chosen, t)
          }
        _ => ()
      }
      match chosen {
        TError =>
          match expected {
            Some(TFn(_, er)) =>
              match er {
                TError => TUnit
                t => t
              }
            _ => TUnit
          }
        t => t
      }
    }
    _ => qbe_resolve_type(g, ret_te)
  }
  let ret_ty = subst_ty(raw_ret_ty, g.cur_type_subst)

  let cap_tparams : Array[String] = []
  let mut tpi = 0
  while tpi < g.live_tparams.length() {
    cap_tparams.push(g.live_tparams[tpi])
    tpi = tpi + 1
  }

  let n_slots = 1 + cap_locals.length() + cap_tparams.length()
  let drop_slots : Array[Int] = []
  let mut has_tparam_cap = false
  let mut mi = 0
  while mi < cap_locals.length() {
    if cap_locals[mi].is_cell || qbe_is_obj_ty(g, cap_locals[mi].ty) {
      drop_slots.push(mi + 1)
    } else {
      match cap_locals[mi].ty {
        TParam(tn) =>
          if str_arr_contains(cap_tparams, tn) {
            has_tparam_cap = true
          }
        _ => ()
      }
    }
    mi = mi + 1
  }
  let drop_sym = if has_tparam_cap {
    let dsym = "$pion_drop_clo_" + clo_id.to_string()
    let dsb = StringBuilder()
    dsb.write_string("function " + dsym + "(l %p) {\n@start\n")
    let mut di = 0
    while di < cap_locals.length() {
      let cty = cap_locals[di].ty
      let off = (di + 1) * 8
      if cap_locals[di].is_cell || qbe_is_obj_ty(g, cty) {
        dsb.write_string("    %a" + di.to_string() + " =l add %p, " + off.to_string() + "\n")
        dsb.write_string("    %v" + di.to_string() + " =l loadl %a" + di.to_string() + "\n")
        dsb.write_string("    call $pion_rc_dec(l %v" + di.to_string() + ")\n")
      } else {
        match cty {
          TParam(tn) => {
            let mut found_ti = -1
            let mut tj = 0
            while tj < cap_tparams.length() {
              if cap_tparams[tj] == tn {
                found_ti = tj
                break
              }
              tj = tj + 1
            }
            if found_ti >= 0 {
              let tp_off = (1 + cap_locals.length() + found_ti) * 8
              dsb.write_string("    %tp_a" + di.to_string() + " =l add %p, " + tp_off.to_string() + "\n")
              dsb.write_string("    %tp_f" + di.to_string() + " =l loadl %tp_a" + di.to_string() + "\n")
              dsb.write_string("    %tp_fw" + di.to_string() + " =w cnel %tp_f" + di.to_string() + ", 0\n")
              dsb.write_string("    jnz %tp_fw" + di.to_string() + ", @do_" + di.to_string() + ", @sk_" + di.to_string() + "\n")
              dsb.write_string("@do_" + di.to_string() + "\n")
              dsb.write_string("    %a" + di.to_string() + " =l add %p, " + off.to_string() + "\n")
              dsb.write_string("    %v" + di.to_string() + " =l loadl %a" + di.to_string() + "\n")
              dsb.write_string("    call $pion_rc_dec(l %v" + di.to_string() + ")\n")
              dsb.write_string("    jmp @sk_" + di.to_string() + "\n")
              dsb.write_string("@sk_" + di.to_string() + "\n")
            }
          }
          _ => ()
        }
      }
      di = di + 1
    }
    dsb.write_string("    ret\n}\n\n")
    g.extra_fns.push(dsb.to_string())
    dsym
  } else {
    qbe_register_slot_drop(g, drop_slots)
  }
  let env_obj = qbe_tmp(g)
  qbe_emit(
    g,
    env_obj +
    " =l call $pion_alloc_uninit(w " +
    (n_slots * 8).to_string() +
    ", w 6, l " +
    drop_sym +
    ")",
  )
  qbe_emit(g, "storel " + fn_sym + ", " + env_obj)
  let mut ki = 0
  while ki < cap_locals.length() {
    let loc = cap_locals[ki]
    let v = if loc.is_cell {
      let cell_p = qbe_tmp(g)
      qbe_emit(g, cell_p + " =l loadl " + loc.slot)
      qbe_emit(g, "call $pion_rc_inc(l " + cell_p + ")")
      cell_p
    } else {
      let dv = qbe_load_local_slot(g, loc.slot, loc.ty)
      let lv = qbe_as_l(g, qval(dv, loc.ty))
      if is_spawn {
        qbe_emit_deep_freeze(g, lv, loc.ty)
      }
      qbe_rc_inc(g, lv, loc.ty)
      lv
    }
    let off = (ki + 1) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add " + env_obj + ", " + off.to_string())
    qbe_emit(g, "storel " + v + ", " + p)
    ki = ki + 1
  }
  tpi = 0
  while tpi < cap_tparams.length() {
    let off = (1 + cap_locals.length() + tpi) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add " + env_obj + ", " + off.to_string())
    qbe_emit(g, "storel %tp_" + cap_tparams[tpi] + ", " + p)
    tpi = tpi + 1
  }

  let saved_allocs = g.fn_allocs
  let saved_body = g.fn_body
  let saved_fn_start_tmp = g.fn_start_tmp
  let saved_fn_start_lbl = g.fn_start_lbl
  let saved_fn_inlined_cost = g.fn_inlined_cost
  let saved_fn_cleanup_enabled = g.fn_cleanup_enabled
  let saved_fn_ret_slot = g.fn_ret_slot
  let saved_fn_ret_epi_lbl = g.fn_ret_epi_lbl
  let saved_fn_cleanup_pads = g.fn_cleanup_pads
  let saved_fn_cleanup_nodes = g.fn_cleanup_nodes
  let clo_before_tmp = g.next_tmp
  let clo_before_lbl = g.next_lbl
  let saved_scopes = g.scopes
  let saved_breaks = g.loop_breaks
  let saved_conts = g.loop_conts
  let saved_depths = g.loop_depths
  let saved_hot_loop_depth = g.hot_loop_depth
  let saved_ret = g.cur_ret_ty
  let saved_ret_abi = g.cur_ret_abi_ty
  let saved_fn_void = g.cur_fn_void
  let saved_term = g.block_term
  let saved_hlen = g.hoisted_arr_len
  let saved_hdp = g.hoisted_arr_dp
  let saved_hslen = g.hoisted_str_len
  let saved_hsdp = g.hoisted_str_dp
  let saved_hblen = g.hoisted_bytes_len
  let saved_hbdp = g.hoisted_bytes_dp
  let saved_hfields = g.hoisted_fields
  let saved_bfields = g.block_immut_fields
  let saved_lalias = g.len_aliases
  let saved_lkeys = g.len_alias_keys
  let saved_nonneg = g.nonneg_vars
  let saved_u8r = g.u8_range_vars
  let saved_kml = g.known_min_len_arrs
  let saved_kwb = g.known_writable_bytes
  let saved_bce = g.bce_safe_indices
  let saved_bce_exprs = g.bce_safe_exprs
  let saved_bce_push = g.bce_safe_push_arrs
  let saved_movable = g.movable_locals
  let saved_moved = g.moved_slots
  let saved_zeroed = g.zeroed_slots
  let saved_immortal_regs = g.immortal_regs
  let saved_immortal_slots = g.immortal_slots
  let saved_cur_lbl = g.cur_lbl
  let saved_pinned_slots = g.pinned_slots
  let saved_borrow_owner_slot = g.borrow_owner_slot
  let saved_borrow_owner_name = g.borrow_owner_name
  let saved_mut_local_slots = g.mut_local_slots
  let saved_sq_slot = g.sq_reuse_slot
  let saved_sq_state = g.sq_reuse_state
  let saved_prom = g.promoted_fields
  let saved_prom_tys = g.promoted_field_tys
  let saved_pp_len = g.promoted_push_len
  let saved_pp_cap = g.promoted_push_cap
  let saved_pp_dp = g.promoted_push_dp
  let saved_w2l = g.w_to_l_ext
  let saved_local_w2l = g.local_w_to_l_ext
  let saved_unfrozen = g.unfrozen_local_arrs
  let saved_boxed_mut = g.boxed_mut_vars
  let saved_iclos = g.inline_closures
  let saved_irlbl = g.inline_ret_lbl
  let saved_irtag = g.inline_ret_tag_slot
  let saved_irerr = g.inline_ret_err_slot
  let saved_irpod = g.inline_ret_pod_buf
  let saved_irslot = g.inline_ret_slot
  let saved_irty = g.inline_ret_ty
  let saved_irdep = g.inline_ret_scope_depth
  let saved_tco_mode = g.tco_mode
  let saved_tco_fn = g.tco_fn_name
  let saved_tco_lbl = g.tco_loop_lbl
  let saved_floor = g.lookup_scope_floor
  g.tco_mode = 0
  g.tco_fn_name = ""
  g.tco_loop_lbl = ""
  g.lookup_scope_floor = 0

  g.fn_allocs = StringBuilder()
  g.fn_body = StringBuilder()
  g.fn_start_tmp = g.next_tmp
  g.fn_start_lbl = g.next_lbl
  g.fn_inlined_cost = 0
  qbe_fn_cleanup_begin(g, true)
  g.scopes = []
  g.lookup_scope_floor = 0
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.hot_loop_depth = 0
  g.cur_ret_ty = ret_ty
  g.cur_ret_abi_ty = TInt64
  g.cur_fn_void = is_spawn
  g.block_term = false
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.zeroed_slots = Map([])
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
  g.pinned_slots = Map([])
  g.borrow_owner_slot = Map([])
  g.borrow_owner_name = Map([])
  g.mut_local_slots = Map([])
  g.sq_reuse_slot = Map([])
  g.sq_reuse_state = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.inline_ret_slot = ""
  g.inline_ret_ty = TUnit
  g.inline_ret_scope_depth = 0

  qbe_scope_push(g)
  tpi = 0
  while tpi < cap_tparams.length() {
    let off = (1 + cap_locals.length() + tpi) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add %env, " + off.to_string())
    qbe_emit(g, "%tp_" + cap_tparams[tpi] + " =l loadl " + p)
    tpi = tpi + 1
  }
  ki = 0
  while ki < cap_locals.length() {
    let cap = cap_locals[ki]
    let off = (ki + 1) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add %env, " + off.to_string())
    if cap.is_cell {
      let loc = qbe_define_cell_local(g, cap.name, cap.ty, false)
      let cell_p = qbe_tmp(g)
      qbe_emit(g, cell_p + " =l loadl " + p)
      qbe_emit(g, "storel " + cell_p + ", " + loc.slot)
    } else {
      let loc = qbe_define_local(g, cap.name, cap.ty, false)
      let v = qbe_load_heap_slot(g, p, cap.ty)
      qbe_store_local_slot(g, v, loc.slot, cap.ty)
      g.borrow_owner_slot.set(loc.slot, loc.slot)
      g.borrow_owner_name.set(loc.slot, cap.name)
    }
    ki = ki + 1
  }
  pi = 0
  while pi < params.length() {
    let loc = qbe_define_local(g, params[pi].name, ptys[pi], false)
    let pv = qbe_from_l(g, "%p" + pi.to_string(), ptys[pi])
    qbe_store_local_slot(g, pv, loc.slot, ptys[pi])
    g.borrow_owner_slot.set(loc.slot, loc.slot)
    g.borrow_owner_name.set(loc.slot, params[pi].name)
    pi = pi + 1
  }

  let bres = qbe_emit_stmts(g, body, Some(ret_ty))
  let actual_ret = match ret_te {
    TyMissing(_) =>
      if g.block_term {
        ret_ty
      } else {
        match bres.ty {
          TNever | TError => ret_ty
          _ => ty_prefer_concrete(ret_ty, bres.ty)
        }
      }
    _ => ret_ty
  }
  if !g.block_term {
    if is_spawn {
      qbe_rc_dec(g, bres.reg, bres.ty)
      if g.fn_cleanup_pads.length() > 0 &&
        qbe_try_emit_shared_cleanup_exit(g, "") {
        qbe_scope_pop_meta_only(g)
      } else {
        qbe_scope_pop(g)
        qbe_emit_term(g, "ret")
      }
    } else {
      let ret_v = if qbe_ty_has_untyped_option(bres.ty) && qbe_ty_has_niche_option(g, actual_ret) {
        qval(qbe_normalize_untyped_none_in_val(g, bres.reg, actual_ret), actual_ret)
      } else {
        bres
      }
      let ret_l = qbe_as_l(g, ret_v)
      if g.fn_cleanup_pads.length() > 0 &&
        qbe_try_emit_shared_cleanup_exit(g, ret_l) {
        qbe_scope_pop_meta_only(g)
      } else {
        qbe_scope_pop(g)
        qbe_emit_term(g, "ret " + ret_l)
      }
    }
  } else {
    let _ = g.scopes.pop()
  }
  qbe_fn_cleanup_flush(g)

  let hdr = StringBuilder()
  if is_spawn {
    hdr.write_string("function ")
    hdr.write_string(fn_sym)
    hdr.write_string("(l %env) {\n@start\n")
  } else {
    hdr.write_string("function l ")
    hdr.write_string(fn_sym)
    hdr.write_string("(l %env")
    pi = 0
    while pi < params.length() {
      hdr.write_string(", l %p")
      hdr.write_string(pi.to_string())
      pi = pi + 1
    }
    hdr.write_string(") {\n@start\n")
  }
  hdr.write_string(g.fn_allocs.to_string())
  hdr.write_string(g.fn_body.to_string())
  hdr.write_string("}\n\n")
  g.extra_fns.push(hdr.to_string())

  g.fn_allocs = saved_allocs
  g.fn_body = saved_body
  g.fn_start_tmp = saved_fn_start_tmp + (g.next_tmp - clo_before_tmp)
  g.fn_start_lbl = saved_fn_start_lbl + (g.next_lbl - clo_before_lbl)
  g.fn_inlined_cost = saved_fn_inlined_cost
  g.fn_cleanup_enabled = saved_fn_cleanup_enabled
  g.fn_ret_slot = saved_fn_ret_slot
  g.fn_ret_epi_lbl = saved_fn_ret_epi_lbl
  g.fn_cleanup_pads = saved_fn_cleanup_pads
  g.fn_cleanup_nodes = saved_fn_cleanup_nodes
  g.scopes = saved_scopes
  g.lookup_scope_floor = saved_floor
  g.loop_breaks = saved_breaks
  g.loop_conts = saved_conts
  g.loop_depths = saved_depths
  g.hot_loop_depth = saved_hot_loop_depth
  g.cur_ret_ty = saved_ret
  g.cur_ret_abi_ty = saved_ret_abi
  g.cur_fn_void = saved_fn_void
  g.block_term = saved_term
  g.hoisted_arr_len = saved_hlen
  g.hoisted_arr_dp = saved_hdp
  g.hoisted_str_len = saved_hslen
  g.hoisted_str_dp = saved_hsdp
  g.hoisted_bytes_len = saved_hblen
  g.hoisted_bytes_dp = saved_hbdp
  g.hoisted_fields = saved_hfields
  g.block_immut_fields = saved_bfields
  g.len_aliases = saved_lalias
  g.len_alias_keys = saved_lkeys
  g.nonneg_vars = saved_nonneg
  g.u8_range_vars = saved_u8r
  g.known_min_len_arrs = saved_kml
  g.known_writable_bytes = saved_kwb
  g.bce_safe_indices = saved_bce
  g.bce_safe_exprs = saved_bce_exprs
  g.bce_safe_push_arrs = saved_bce_push
  g.movable_locals = saved_movable
  g.moved_slots = saved_moved
  g.zeroed_slots = saved_zeroed
  g.immortal_regs = saved_immortal_regs
  g.immortal_slots = saved_immortal_slots
  g.cur_lbl = saved_cur_lbl
  g.pinned_slots = saved_pinned_slots
  g.borrow_owner_slot = saved_borrow_owner_slot
  g.borrow_owner_name = saved_borrow_owner_name
  g.mut_local_slots = saved_mut_local_slots
  g.sq_reuse_slot = saved_sq_slot
  g.sq_reuse_state = saved_sq_state
  g.promoted_fields = saved_prom
  g.inline_closures = saved_iclos
  g.inline_ret_lbl = saved_irlbl
  g.inline_ret_tag_slot = saved_irtag
  g.inline_ret_err_slot = saved_irerr
  g.inline_ret_pod_buf = saved_irpod
  g.inline_ret_slot = saved_irslot
  g.inline_ret_ty = saved_irty
  g.inline_ret_scope_depth = saved_irdep
  g.tco_mode = saved_tco_mode
  g.tco_fn_name = saved_tco_fn
  g.tco_loop_lbl = saved_tco_lbl
  g.promoted_field_tys = saved_prom_tys
  g.promoted_push_len = saved_pp_len
  g.promoted_push_cap = saved_pp_cap
  g.promoted_push_dp = saved_pp_dp
  g.w_to_l_ext = saved_w2l
  g.local_w_to_l_ext = saved_local_w2l
  g.unfrozen_local_arrs = saved_unfrozen
  g.boxed_mut_vars = saved_boxed_mut

  QbeCloRes::{ env: env_obj, fn_sym: fn_sym, ty: TFn(ptys, actual_ret) }
}

///|
/// `opt.is_some()` / `res.is_ok()` and friends: compare the tag word (Option:
/// `Some` = 1; Result: `Ok` = 0) against zero.
fn qbe_emit_tag_test(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  obj_ty : Ty,
  cmp : String,
) -> QbeVal {
  let is_niche = match obj_ty {
    TOption(inner) => qbe_is_niche_opt_inner(g, inner)
    _ => false
  }
  let cw = qbe_tmp(g)
  let r = qbe_tmp(g)
  if is_niche {
    qbe_emit(g, cw + " =w " + cmp + " " + obj_val + ", 0")
  } else {
    let tag = qbe_tmp(g)
    qbe_emit(g, tag + " =l loadl " + obj_val)
    qbe_emit(g, cw + " =w " + cmp + " " + tag + ", 0")
  }
  qbe_emit(g, r + " =l extuw " + cw)
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, obj_ty)
  }
  qval(r, TBool)
}

///|
/// `opt.unwrap_or(d)` / `res.unwrap_or(d)`: the default is evaluated first
/// (owned); the payload is taken (+1) when the tag is `hit_tag`, otherwise the
/// default is moved into the result.
fn qbe_emit_unwrap_or(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  obj_ty : Ty,
  hit_tag : Int,
  inner : Ty,
  dflt : Expr,
) -> QbeVal {
  let dv = qbe_emit_expr(g, dflt, Some(inner))
  let dl = qbe_as_l(g, qval(qbe_coerce_val(g, dv, inner), inner))
  let res_slot = qbe_alloc_slot(g)
  let is_niche = match obj_ty {
    TOption(in_ty) => qbe_is_niche_opt_inner(g, in_ty)
    _ => false
  }
  if is_niche {
    let hit = qbe_tmp(g)
    let l_hit = qbe_lbl(g, "uwo_hit")
    let l_miss = qbe_lbl(g, "uwo_miss")
    let l_end = qbe_lbl(g, "uwo_end")
    qbe_emit(g, hit + " =w cnel " + obj_val + ", 0")
    qbe_emit_term(g, "jnz " + hit + ", " + l_hit + ", " + l_miss)
    qbe_emit_lbl(g, l_hit)
    qbe_emit(g, "storel " + obj_val + ", " + res_slot)
    if obj_borrowed {
      qbe_rc_inc(g, obj_val, inner)
    }
    qbe_rc_dec(g, dl, inner)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_miss)
    qbe_emit(g, "storel " + dl + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let rl = qbe_tmp(g)
    qbe_emit(g, rl + " =l loadl " + res_slot)
    return qval(qbe_from_l(g, rl, inner), inner)
  }
  let tag = qbe_tmp(g)
  let hit = qbe_tmp(g)
  let l_hit = qbe_lbl(g, "uwo_hit")
  let l_miss = qbe_lbl(g, "uwo_miss")
  let l_end = qbe_lbl(g, "uwo_end")
  qbe_emit(g, tag + " =l loadl " + obj_val)
  qbe_emit(g, hit + " =w ceql " + tag + ", " + hit_tag.to_string())
  qbe_emit_term(g, "jnz " + hit + ", " + l_hit + ", " + l_miss)
  qbe_emit_lbl(g, l_hit)
  let pp = qbe_tmp(g)
  let pv = qbe_tmp(g)
  qbe_emit(g, pp + " =l add " + obj_val + ", 8")
  qbe_emit(g, pv + " =l loadl " + pp)
  qbe_emit(g, "storel " + pv + ", " + res_slot)
  qbe_rc_inc(g, pv, inner)
  qbe_rc_dec(g, dl, inner)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_miss)
  qbe_emit(g, "storel " + dl + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, obj_ty)
  }
  let rl = qbe_tmp(g)
  qbe_emit(g, rl + " =l loadl " + res_slot)
  qval(qbe_from_l(g, rl, inner), inner)
}

///|
/// `s.to_int()` / `s.to_int64()` / `s.to_double()` -> `Option[...]`: `None`
/// for empty, malformed or out-of-range text (never panics).
fn qbe_emit_str_parse(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  method_name : String,
) -> QbeVal {
  let ok_slot = qbe_alloc_slot4(g)
  let okw = qbe_tmp(g)
  let payload = qbe_tmp(g)
  let inner = if method_name == "to_int" {
    TInt
  } else if method_name == "to_int64" {
    TInt64
  } else {
    TDouble
  }
  let mut ok_final = okw
  if method_name == "to_double" {
    let d = qbe_tmp(g)
    qbe_emit(g, d + " =d call $pion_str_to_double(l " + obj_val + ", l " + ok_slot + ")")
    qbe_emit(g, okw + " =w loadw " + ok_slot)
    qbe_emit(g, payload + " =l cast " + d)
  } else {
    let v = qbe_tmp(g)
    qbe_emit(g, v + " =l call $pion_str_to_int(l " + obj_val + ", l " + ok_slot + ")")
    qbe_emit(g, okw + " =w loadw " + ok_slot)
    if method_name == "to_int" {
      // `Int` is 32-bit: values that do not survive the round trip are `None`.
      let vw = qbe_tmp(g)
      let in_range = qbe_tmp(g)
      let both = qbe_tmp(g)
      qbe_emit(g, vw + " =w copy " + v)
      qbe_emit(g, payload + " =l extsw " + vw)
      qbe_emit(g, in_range + " =w ceql " + payload + ", " + v)
      qbe_emit(g, both + " =w and " + okw + ", " + in_range)
      ok_final = both
    } else {
      qbe_emit(g, payload + " =l copy " + v)
    }
  }
  if !obj_borrowed {
    qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
  }
  let res_slot = qbe_alloc_slot(g)
  let l_some = qbe_lbl(g, "sp_some")
  let l_none = qbe_lbl(g, "sp_none")
  let l_end = qbe_lbl(g, "sp_end")
  qbe_emit_term(g, "jnz " + ok_final + ", " + l_some + ", " + l_none)
  qbe_emit_lbl(g, l_some)
  let some_obj = qbe_emit_some(g, payload, inner)
  qbe_emit(g, "storel " + some_obj + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_none)
  let none_obj = qbe_emit_none(g, inner)
  qbe_emit(g, "storel " + none_obj + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + res_slot)
  qval(r, TOption(inner))
}

///|
fn qbe_lookup_expected_trait(g : QbeGen, sp : Span) -> Option[String] {
  let sk = span_key(sp)
  if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.resolved_trait_methods.get(sk) {
          Some(raw_tr) => {
            let qtr = if has_qual_sep(raw_tr) {
              raw_tr
            } else {
              ipkg.name + "::" + raw_tr
            }
            Some(canon_trait_name(g.tc, qtr))
          }
          None => None
        }
      None => None
    }
  } else {
    match g.tc.resolved_trait_methods.get(sk) {
      Some(tr) => Some(canon_trait_name(g.tc, tr))
      None => None
    }
  }
}

///|
fn qbe_has_expected_trait(g : QbeGen, sp : Span) -> Bool {
  match qbe_lookup_expected_trait(g, sp) {
    Some(_) => true
    None => false
  }
}

///|
fn qbe_emit_impl_method_call(
  g : QbeGen,
  obj_val : String,
  recv_ty : Ty,
  obj_borrowed : Bool,
  recv_wbs : Array[QbeMutWb],
  imatch : QbeImplMethodMatch,
  args : Array[Expr],
) -> QbeVal {
  let minfo = imatch.finfo
  let is_pos_call = !qbe_args_have_named(args) &&
    args.length() + 1 == minfo.decl.params.length()
  let mut norm_args = args
  let mut from_default : Array[Bool] = []
  let mut order : Array[Int] = []
  if is_pos_call {
    let mut k = 0
    while k < args.length() {
      from_default.push(false)
      order.push(k)
      k = k + 1
    }
  } else {
    let res = resolve_call_args_qbe_full(
      minfo.decl.params,
      1,
      args,
      span_new("", 0, 0),
    )
    norm_args = res.args
    from_default = res.from_default
    order = qbe_call_eval_order(minfo.decl.params, 1, args, norm_args.length())
  }
  let norm_pure = !qbe_args_may_mutate_locals(g, norm_args)
  let arg_vals : Array[String] = [obj_val]
  let arg_tys : Array[Ty] = [recv_ty]
  let arg_borrowed : Array[Bool] = [obj_borrowed]
  qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length() + 1)
  let guards = qbe_arg_guards(g, norm_args, order)
  qbe_guard_val(g, guards, QbeArgVal::{ qv: qval(arg_vals[0], arg_tys[0]), borrowed: arg_borrowed[0] }, recv_wbs.length() > 0, qbe_guards_exit_before_order(g, guards, norm_args, order))
  let empty_subst : Map[String, Ty] = Map([])
  let mut oi = 0
  while oi < order.length() {
    let i = order[oi]
    let p_idx = i + 1
    let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
      Some(minfo.param_tys[p_idx])
    } else {
      None
    }
    let aa = if i < from_default.length() && from_default[i] {
      qbe_emit_default_call_arg(
        g,
        minfo.decl.params,
        minfo.param_tys,
        minfo.decl.type_params,
        p_idx,
        norm_args[i],
        exp_p,
        arg_vals,
        arg_tys,
        empty_subst,
        qbe_norm_mono_pkg(g, imatch.pkg_name),
      )
    } else {
      qbe_emit_call_arg(
        g,
        minfo.decl.params,
        p_idx,
        norm_args[i],
        exp_p,
        norm_pure,
        recv_wbs,
        norm_args,
      )
    }
    arg_vals[i + 1] = aa.qv.reg
    arg_tys[i + 1] = aa.qv.ty
    arg_borrowed[i + 1] = aa.borrowed
    qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i + 1, norm_args[i]), guards.exits[oi])
    oi = oi + 1
  }
  qbe_release_guards(g, guards)
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let mut j = 0
  while j < arg_vals.length() {
    let decl_pty = if j < minfo.param_tys.length() {
      minfo.param_tys[j]
    } else {
      arg_tys[j]
    }
    if qbe_param_is_mut(minfo.decl.params, j) {
      call_args.push(arg_vals[j])
      call_abis.push("l")
    } else {
      call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
      call_abis.push(qbe_abi_ty(decl_pty))
    }
    j = j + 1
  }
  let ret_abi = qbe_abi_ty(minfo.ret_ty)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =")
  sb.write_string(ret_abi)
  sb.write_string(" call ")
  sb.write_string(imatch.sym)
  sb.write_string("(")
  j = 0
  while j < call_args.length() {
    if j > 0 {
      sb.write_string(", ")
    }
    sb.write_string(call_abis[j])
    sb.write_string(" ")
    sb.write_string(call_args[j])
    j = j + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qbe_emit_mut_writebacks(g, recv_wbs)
  qval(res, minfo.ret_ty)
}

///|
fn qbe_emit_method_call(
  g : QbeGen,
  obj_expr : Expr,
  method_name : String,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> QbeVal {
  let expected_trait = qbe_lookup_expected_trait(g, sp)
  let is_trait_bound_call = match expected_trait {
    Some(_) => true
    None => false
  }
  if !is_trait_bound_call {
  match qbe_try_emit_scalar_opt_res_method(g, obj_expr, method_name, args) {
    Some(qv) => return qv
    None => ()
  }
  // Fast zero-RC borrow path for `local.length()` and `local.immut_field.length()` on String / Array / Bytes
  if method_name == "length" && args.length() == 0 {
    match obj_expr {
      EIdent(lname, _) =>
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            if !loc.is_cell {
            match loc.ty {
              TString | TArray(_) | TBytes | TStringBuilder => {
                let r64 = match g.hoisted_arr_len.get(lname) {
                  Some(hlen) => hlen
                  None =>
                    match g.hoisted_str_len.get(lname) {
                      Some(hslen) => hslen
                      None =>
                        match g.hoisted_bytes_len.get(lname) {
                          Some(hblen) => hblen
                          None => {
                            let obj_p = qbe_tmp(g)
                            let t64 = qbe_tmp(g)
                            qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                            qbe_emit(g, t64 + " =l loadl " + obj_p)
                            t64
                          }
                        }
                    }
                }
                let rw = qbe_tmp(g)
                qbe_emit(g, rw + " =w copy " + r64)
                return qval(rw, TInt)
              }
              TStrView | TBytesView => {
                let r64 = match g.hoisted_str_len.get(lname) {
                  Some(hslen) => hslen
                  None =>
                    match g.hoisted_bytes_len.get(lname) {
                      Some(hblen) => hblen
                      None => {
                        let obj_p = qbe_tmp(g)
                        let lp = qbe_tmp(g)
                        let t64 = qbe_tmp(g)
                        qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                        qbe_emit(g, lp + " =l add " + obj_p + ", 16")
                        qbe_emit(g, t64 + " =l loadl " + lp)
                        t64
                      }
                    }
                }
                let rw = qbe_tmp(g)
                qbe_emit(g, rw + " =w copy " + r64)
                return qval(rw, TInt)
              }
              _ => ()
            }
            }
          None => ()
        }
      EField(EIdent(lname, _), fname, _) => {
        let fkey = lname + "." + fname
        if !g.promoted_fields.contains(fkey) {
          match qbe_lookup_local(g, lname) {
            Some(loc) =>
              if !loc.is_cell {
              match subst_ty(loc.ty, g.cur_type_subst) {
                TStruct(sname, sargs) =>
                  match qbe_lookup_struct_info(g, sname) {
                    Some(sinfo) => {
                      let subst = make_subst(sinfo.decl.type_params, sargs)
                      let mut fi = 0
                      while fi < sinfo.field_names.length() {
                        if sinfo.field_names[fi] == fname {
                          let is_mut = sinfo.field_muts[fi]
                          let fty = subst_ty(
                            subst_ty(sinfo.field_tys[fi], subst),
                            g.cur_type_subst,
                          )
                          match fty {
                            TString | TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes | TStringBuilder => {
                              let t64 = if is_mut {
                                let sp = qbe_tmp(g)
                                let fp = qbe_tmp(g)
                                let fv = qbe_tmp(g)
                                let r64 = qbe_tmp(g)
                                qbe_emit(g, sp + " =l loadl " + loc.slot)
                                qbe_emit(
                                  g,
                                  fp + " =l add " + sp + ", " + (fi * 8).to_string(),
                                )
                                qbe_emit(g, fv + " =l loadl " + fp)
                                qbe_emit(g, r64 + " =l loadl " + fv)
                                r64
                              } else {
                                match g.hoisted_arr_len.get(fkey) {
                                  Some(hlen) => hlen
                                  None =>
                                    match g.hoisted_str_len.get(fkey) {
                                      Some(hslen) => hslen
                                      None =>
                                        match g.hoisted_bytes_len.get(fkey) {
                                          Some(hblen) => hblen
                                          None => {
                                            let fld_p = match g.hoisted_fields.get(fkey) {
                                              Some(hv) => hv.reg
                                              None =>
                                                match g.block_immut_fields.get(fkey) {
                                                  Some(bv) => bv.reg
                                                  None => {
                                                    let sp = qbe_tmp(g)
                                                    let fp = qbe_tmp(g)
                                                    let fv = qbe_tmp(g)
                                                    qbe_emit(g, sp + " =l loadl " + loc.slot)
                                                    qbe_emit(
                                                      g,
                                                      fp + " =l add " + sp + ", " + (fi * 8).to_string(),
                                                    )
                                                    qbe_emit(g, fv + " =l loadl " + fp)
                                                    fv
                                                  }
                                                }
                                            }
                                            let r64 = qbe_tmp(g)
                                            qbe_emit(g, r64 + " =l loadl " + fld_p)
                                            r64
                                          }
                                        }
                                    }
                                }
                              }
                              let rw = qbe_tmp(g)
                              qbe_emit(g, rw + " =w copy " + t64)
                              return qval(rw, TInt)
                            }
                            TStrView | TBytesView => {
                              let t64 = if is_mut {
                                let sp = qbe_tmp(g)
                                let fp = qbe_tmp(g)
                                let fv = qbe_tmp(g)
                                let lp = qbe_tmp(g)
                                let r64 = qbe_tmp(g)
                                qbe_emit(g, sp + " =l loadl " + loc.slot)
                                qbe_emit(
                                  g,
                                  fp + " =l add " + sp + ", " + (fi * 8).to_string(),
                                )
                                qbe_emit(g, fv + " =l loadl " + fp)
                                qbe_emit(g, lp + " =l add " + fv + ", 16")
                                qbe_emit(g, r64 + " =l loadl " + lp)
                                r64
                              } else {
                                match g.hoisted_str_len.get(fkey) {
                                  Some(hslen) => hslen
                                  None =>
                                    match g.hoisted_bytes_len.get(fkey) {
                                      Some(hblen) => hblen
                                      None => {
                                        let fld_p = match g.hoisted_fields.get(fkey) {
                                          Some(hv) => hv.reg
                                          None =>
                                            match g.block_immut_fields.get(fkey) {
                                              Some(bv) => bv.reg
                                              None => {
                                                let sp = qbe_tmp(g)
                                                let fp = qbe_tmp(g)
                                                let fv = qbe_tmp(g)
                                                qbe_emit(g, sp + " =l loadl " + loc.slot)
                                                qbe_emit(
                                                  g,
                                                  fp + " =l add " + sp + ", " + (fi * 8).to_string(),
                                                )
                                                qbe_emit(g, fv + " =l loadl " + fp)
                                                fv
                                              }
                                            }
                                        }
                                        let lp = qbe_tmp(g)
                                        let r64 = qbe_tmp(g)
                                        qbe_emit(g, lp + " =l add " + fld_p + ", 16")
                                        qbe_emit(g, r64 + " =l loadl " + lp)
                                        r64
                                      }
                                    }
                                }
                              }
                              let rw = qbe_tmp(g)
                              qbe_emit(g, rw + " =w copy " + t64)
                              return qval(rw, TInt)
                            }
                            _ => ()
                          }
                          break
                        }
                        fi = fi + 1
                      }
                    }
                    None => ()
                  }
                TTuple(elems) => {
                  let idx = parse_tuple_index(fname)
                  if idx >= 0 && idx < elems.length() {
                    let fty = subst_ty(elems[idx], g.cur_type_subst)
                    match fty {
                      TString | TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes | TStringBuilder => {
                        let sp = qbe_tmp(g)
                        let fp = qbe_tmp(g)
                        let fv = qbe_tmp(g)
                        let r64 = qbe_tmp(g)
                        qbe_emit(g, sp + " =l loadl " + loc.slot)
                        qbe_emit(g, fp + " =l add " + sp + ", " + (idx * 8).to_string())
                        qbe_emit(g, fv + " =l loadl " + fp)
                        qbe_emit(g, r64 + " =l loadl " + fv)
                        let rw = qbe_tmp(g)
                        qbe_emit(g, rw + " =w copy " + r64)
                        return qval(rw, TInt)
                      }
                      TStrView | TBytesView => {
                        let sp = qbe_tmp(g)
                        let fp = qbe_tmp(g)
                        let fv = qbe_tmp(g)
                        let lp = qbe_tmp(g)
                        let r64 = qbe_tmp(g)
                        qbe_emit(g, sp + " =l loadl " + loc.slot)
                        qbe_emit(g, fp + " =l add " + sp + ", " + (idx * 8).to_string())
                        qbe_emit(g, fv + " =l loadl " + fp)
                        qbe_emit(g, lp + " =l add " + fv + ", 16")
                        qbe_emit(g, r64 + " =l loadl " + lp)
                        let rw = qbe_tmp(g)
                        qbe_emit(g, rw + " =w copy " + r64)
                        return qval(rw, TInt)
                      }
                      _ => ()
                    }
                  }
                }
                _ => ()
              }
              }
            None => ()
          }
        }
      }
      EField(base_expr, fname, _) =>
        match qbe_can_borrow_place(g, base_expr) {
          Some(base_ty) => {
            let mut field_off = -1
            let mut field_kind = 0 // 1: +0 len, 2: +16 view len
            match base_ty {
              TStruct(sname, sargs) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let subst = make_subst(sinfo.decl.type_params, sargs)
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname {
                        let fty = subst_ty(
                          subst_ty(sinfo.field_tys[fi], subst),
                          g.cur_type_subst,
                        )
                        match fty {
                          TString | TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes | TStringBuilder => {
                            field_off = fi * 8
                            field_kind = 1
                          }
                          TStrView | TBytesView => {
                            field_off = fi * 8
                            field_kind = 2
                          }
                          _ => ()
                        }
                        break
                      }
                      fi = fi + 1
                    }
                  }
                  None => ()
                }
              TTuple(elems) => {
                let idx = parse_tuple_index(fname)
                if idx >= 0 && idx < elems.length() {
                  let fty = subst_ty(elems[idx], g.cur_type_subst)
                  match fty {
                    TString | TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes | TStringBuilder => {
                      field_off = idx * 8
                      field_kind = 1
                    }
                    TStrView | TBytesView => {
                      field_off = idx * 8
                      field_kind = 2
                    }
                    _ => ()
                  }
                }
              }
              _ => ()
            }
            if field_kind > 0 {
              match qbe_try_emit_borrowed_place(g, base_expr) {
                Some(bv) => {
                  let fp = qbe_tmp(g)
                  let fv = qbe_tmp(g)
                  qbe_emit(g, fp + " =l add " + bv.reg + ", " + field_off.to_string())
                  qbe_emit(g, fv + " =l loadl " + fp)
                  let r64 = qbe_tmp(g)
                  if field_kind == 1 {
                    qbe_emit(g, r64 + " =l loadl " + fv)
                  } else {
                    let lp = qbe_tmp(g)
                    qbe_emit(g, lp + " =l add " + fv + ", 16")
                    qbe_emit(g, r64 + " =l loadl " + lp)
                  }
                  let rw = qbe_tmp(g)
                  qbe_emit(g, rw + " =w copy " + r64)
                  return qval(rw, TInt)
                }
                None => ()
              }
            }
          }
          None => ()
        }
      _ => ()
    }
  }
  // Invalidate length aliases if array is mutated via push/pop
  if method_name == "push" || method_name == "pop" {
    match obj_expr {
      EIdent(lname, _) => qbe_invalidate_len_aliases_for(g, lname)
      _ => ()
    }
  }
  if method_name == "to_string" && args.length() == 0 {
    match obj_expr {
      EMethodCall(b_expr, "slice", slice_args, slice_sp) => {
        let is_bytes_recv = match qbe_probe_expr_ty(g, b_expr) {
          Some(TBytes) => true
          _ => false
        }
        if slice_args.length() == 2 && is_bytes_recv && !qbe_has_expected_trait(g, slice_sp) {
          let b_av = qbe_emit_arg_maybe_borrow(
            g,
            b_expr,
            Some(TBytes),
            !qbe_args_have_assign(slice_args),
          )
          let b_ptr = b_av.qv.reg
          let a = qbe_emit_expr(g, slice_args[0], Some(TInt))
          let b = qbe_emit_expr(g, slice_args[1], Some(TInt))
          let al = qbe_as_l(g, a)
          let bl = qbe_as_l(g, b)
          let blen = qbe_tmp(g)
          qbe_emit(g, blen + " =l loadl " + b_ptr)

          // s1 = al < 0 ? 0 : al
          let c_s_neg = qbe_tmp(g)
          let l_s_neg_t = qbe_lbl(g, "bs2s_sn_t")
          let l_s_neg_f = qbe_lbl(g, "bs2s_sn_f")
          let l_s_neg_m = qbe_lbl(g, "bs2s_sn_m")
          qbe_emit(g, c_s_neg + " =w csltl " + al + ", 0")
          qbe_emit_term(g, "jnz " + c_s_neg + ", " + l_s_neg_t + ", " + l_s_neg_f)
          qbe_emit_lbl(g, l_s_neg_t)
          qbe_emit_term(g, "jmp " + l_s_neg_m)
          qbe_emit_lbl(g, l_s_neg_f)
          qbe_emit_term(g, "jmp " + l_s_neg_m)
          qbe_emit_lbl(g, l_s_neg_m)
          let s1 = qbe_tmp(g)
          qbe_emit(g, s1 + " =l phi " + l_s_neg_t + " 0, " + l_s_neg_f + " " + al)

          // s = s1 > blen ? blen : s1
          let c_s_hi = qbe_tmp(g)
          let l_s_hi_t = qbe_lbl(g, "bs2s_sh_t")
          let l_s_hi_f = qbe_lbl(g, "bs2s_sh_f")
          let l_s_hi_m = qbe_lbl(g, "bs2s_sh_m")
          qbe_emit(g, c_s_hi + " =w csgtl " + s1 + ", " + blen)
          qbe_emit_term(g, "jnz " + c_s_hi + ", " + l_s_hi_t + ", " + l_s_hi_f)
          qbe_emit_lbl(g, l_s_hi_t)
          qbe_emit_term(g, "jmp " + l_s_hi_m)
          qbe_emit_lbl(g, l_s_hi_f)
          qbe_emit_term(g, "jmp " + l_s_hi_m)
          qbe_emit_lbl(g, l_s_hi_m)
          let s = qbe_tmp(g)
          qbe_emit(g, s + " =l phi " + l_s_hi_t + " " + blen + ", " + l_s_hi_f + " " + s1)

          // e1 = bl < s ? s : bl
          let c_e_lo = qbe_tmp(g)
          let l_e_lo_t = qbe_lbl(g, "bs2s_el_t")
          let l_e_lo_f = qbe_lbl(g, "bs2s_el_f")
          let l_e_lo_m = qbe_lbl(g, "bs2s_el_m")
          qbe_emit(g, c_e_lo + " =w csltl " + bl + ", " + s)
          qbe_emit_term(g, "jnz " + c_e_lo + ", " + l_e_lo_t + ", " + l_e_lo_f)
          qbe_emit_lbl(g, l_e_lo_t)
          qbe_emit_term(g, "jmp " + l_e_lo_m)
          qbe_emit_lbl(g, l_e_lo_f)
          qbe_emit_term(g, "jmp " + l_e_lo_m)
          qbe_emit_lbl(g, l_e_lo_m)
          let e1 = qbe_tmp(g)
          qbe_emit(g, e1 + " =l phi " + l_e_lo_t + " " + s + ", " + l_e_lo_f + " " + bl)

          // e = e1 > blen ? blen : e1
          let c_e_hi = qbe_tmp(g)
          let l_e_hi_t = qbe_lbl(g, "bs2s_eh_t")
          let l_e_hi_f = qbe_lbl(g, "bs2s_eh_f")
          let l_e_hi_m = qbe_lbl(g, "bs2s_eh_m")
          qbe_emit(g, c_e_hi + " =w csgtl " + e1 + ", " + blen)
          qbe_emit_term(g, "jnz " + c_e_hi + ", " + l_e_hi_t + ", " + l_e_hi_f)
          qbe_emit_lbl(g, l_e_hi_t)
          qbe_emit_term(g, "jmp " + l_e_hi_m)
          qbe_emit_lbl(g, l_e_hi_f)
          qbe_emit_term(g, "jmp " + l_e_hi_m)
          qbe_emit_lbl(g, l_e_hi_m)
          let e = qbe_tmp(g)
          qbe_emit(g, e + " =l phi " + l_e_hi_t + " " + blen + ", " + l_e_hi_f + " " + e1)

          let n = qbe_tmp(g)
          let dp_p = qbe_tmp(g)
          let dp = qbe_tmp(g)
          let src_p = qbe_tmp(g)
          let r = qbe_tmp(g)
          qbe_emit(g, n + " =l sub " + e + ", " + s)
          qbe_emit(g, dp_p + " =l add " + b_ptr + ", 16")
          qbe_emit(g, dp + " =l loadl " + dp_p)
          qbe_emit(g, src_p + " =l add " + dp + ", " + s)
          qbe_emit(
            g,
            r + " =l call $pion_str_from_cstr(l " + src_p + ", l " + n + ")",
          )
          if !b_av.borrowed {
            qbe_emit(g, "call $pion_rc_dec(l " + b_ptr + ")")
          }
          return qval(r, TString)
        }
      }
      _ => ()
    }
  }
  }
  let args_pure = !qbe_args_may_mutate_locals(g, args)
  let is_view_to_string = if method_name == "to_string" {
    match qbe_probe_expr_ty(g, obj_expr) {
      Some(TStrView) | Some(TBytesView) => true
      _ => false
    }
  } else {
    false
  }
  let can_borrow_obj = args_pure && (method_name != "to_string" || is_view_to_string)
  let obj_local_name = if can_borrow_obj {
    match obj_expr {
      EIdent(lname, _) => lname
      EField(EIdent(vn, _), fnm, _) => vn + "." + fnm
      _ => ""
    }
  } else {
    ""
  }
  let preserve_unfrozen = if method_name == "push" ||
    method_name == "pop" ||
    method_name == "length" {
    match obj_expr {
      EIdent(lname, _) => g.unfrozen_local_arrs.contains(lname)
      _ => false
    }
  } else {
    false
  }
  let preserve_kml : Option[Int] = if method_name == "push" ||
    method_name == "length" ||
    method_name == "is_empty" ||
    method_name == "get" ||
    method_name == "capacity" {
    match obj_expr {
      EIdent(lname, _) => g.known_min_len_arrs.get(lname)
      _ => None
    }
  } else {
    None
  }
  let recv_wbs : Array[QbeMutWb] = []
  let obj_av = match obj_expr {
    EMutArg(inner, _) => qbe_emit_mut_arg(g, inner, None, recv_wbs, args)
    _ => qbe_emit_arg_maybe_borrow(g, obj_expr, None, can_borrow_obj)
  }
  if preserve_unfrozen && can_borrow_obj {
    match obj_expr {
      EIdent(lname, _) => g.unfrozen_local_arrs.set(lname, true)
      _ => ()
    }
  }
  match preserve_kml {
    Some(kml) =>
      if can_borrow_obj {
        match obj_expr {
          EIdent(lname, _) => g.known_min_len_arrs.set(lname, kml)
          _ => ()
        }
      }
    None => ()
  }
  let obj_val = obj_av.qv.reg
  let recv_ty = obj_av.qv.ty
  let obj_borrowed = obj_av.borrowed
  if is_trait_bound_call {
    match recv_ty {
      TDynTrait(_) => ()
      _ =>
        match qbe_find_impl_method(g, recv_ty, method_name, expected_trait) {
          Some(imatch) =>
            return qbe_emit_impl_method_call(
              g,
              obj_val,
              recv_ty,
              obj_borrowed,
              recv_wbs,
              imatch,
              args,
            )
          None => ()
        }
    }
  }
  let recv_exits = if !obj_borrowed && recv_wbs.length() == 0 && qbe_guards_any_exit(g, args) {
    let is_builtin_recv = match recv_ty {
      TStruct(_, _) | TEnum(_, _) | TDynTrait(_) => false
      _ =>
        match qbe_find_impl_method(g, recv_ty, method_name, expected_trait) {
          Some(_) => false
          None => true
        }
    }
    is_builtin_recv
  } else {
    false
  }
  let recv_guards = QbeArgGuards::{ exits: [recv_exits], slots: [], stores: [] }
  qbe_guard_val(g, recv_guards, obj_av, false, recv_exits)
  let mres = qbe_emit_method_call_dispatch(
    g,
    obj_expr,
    obj_val,
    recv_ty,
    obj_borrowed,
    recv_wbs,
    obj_local_name,
    method_name,
    args,
    args_pure,
    expected,
    expected_trait,
    sp,
  )
  qbe_release_guards(g, recv_guards)
  mres
}

///|
fn qbe_emit_method_call_dispatch(
  g : QbeGen,
  obj_expr : Expr,
  obj_val : String,
  recv_ty : Ty,
  obj_borrowed : Bool,
  recv_wbs : Array[QbeMutWb],
  obj_local_name : String,
  method_name : String,
  args : Array[Expr],
  args_pure : Bool,
  expected : Option[Ty],
  expected_trait : Option[String],
  sp : Span,
) -> QbeVal {
  match recv_ty {
    TInt => {
      if method_name == "to_string" {
        let v64 = qbe_as_l(g, qval(obj_val, TInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + v64 + ")")
        return qval(r, TString)
      }
      if method_name == "to_int64" {
        return qval(qbe_as_l(g, qval(obj_val, TInt)), TInt64)
      }
      if method_name == "to_int" {
        return qval(obj_val, TInt)
      }
      if method_name == "to_uint" || method_name == "reinterpret_as_uint" {
        return qval(obj_val, TUInt)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d swtof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s swtof " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "abs" {
        let m = qbe_tmp(g)
        let t = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, m + " =w sar " + obj_val + ", 31")
        qbe_emit(g, t + " =w xor " + obj_val + ", " + m)
        qbe_emit(g, r + " =w sub " + t + ", " + m)
        return qval(r, TInt)
      }
      if method_name == "unsafe_to_char" {
        return qval(qbe_as_l(g, qval(obj_val, TInt)), TChar)
      }
      if method_name == "to_byte" {
        let v64 = qbe_as_l(g, qval(obj_val, TInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l and " + v64 + ", 255")
        return qval(r, TByte)
      }
      if method_name == "to_int8" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l extsb " + obj_val)
        return qval(r, TInt8)
      }
      match qbe_emit_int_bitop(g, obj_val, TInt, method_name, args) {
        Some(v) => return v
        None => ()
      }
    }
    TInt64 => {
      if method_name == "to_string" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + obj_val + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_int64" {
        return qval(obj_val, TInt64)
      }
      if method_name == "to_uint64" || method_name == "reinterpret_as_uint64" {
        return qval(obj_val, TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d sltof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "abs" {
        let m = qbe_tmp(g)
        let t = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, m + " =l sar " + obj_val + ", 63")
        qbe_emit(g, t + " =l xor " + obj_val + ", " + m)
        qbe_emit(g, r + " =l sub " + t + ", " + m)
        return qval(r, TInt64)
      }
      if method_name == "to_int8" {
        return qval(qbe_extsb_l(g, obj_val), TInt8)
      }
      match qbe_emit_int_bitop(g, obj_val, TInt64, method_name, args) {
        Some(v) => return v
        None => ()
      }
    }
    TUInt => {
      if method_name == "to_string" {
        let v64 = qbe_as_l(g, qval(obj_val, TUInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + v64 + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" || method_name == "reinterpret_as_int" {
        return qval(obj_val, TInt)
      }
      if method_name == "to_uint" {
        return qval(obj_val, TUInt)
      }
      if method_name == "to_int64" {
        return qval(qbe_as_l(g, qval(obj_val, TUInt)), TInt64)
      }
      if method_name == "to_uint64" {
        return qval(qbe_as_l(g, qval(obj_val, TUInt)), TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d uwtof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s uwtof " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "reinterpret_as_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s cast " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "to_int8" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l extsb " + obj_val)
        return qval(r, TInt8)
      }
      match qbe_emit_int_bitop(g, obj_val, TUInt, method_name, args) {
        Some(v) => return v
        None => ()
      }
    }
    TUInt64 => {
      if method_name == "to_string" {
        let res_slot = qbe_alloc_slot(g)
        let is_big = qbe_tmp(g)
        let l_big = qbe_lbl(g, "u64s_big")
        let l_sm = qbe_lbl(g, "u64s_sm")
        let l_end = qbe_lbl(g, "u64s_end")
        qbe_emit(g, is_big + " =w csltl " + obj_val + ", 0")
        qbe_emit_term(g, "jnz " + is_big + ", " + l_big + ", " + l_sm)
        qbe_emit_lbl(g, l_sm)
        let s_sm = qbe_tmp(g)
        qbe_emit(g, s_sm + " =l call $pion_int_to_str(l " + obj_val + ")")
        qbe_emit(g, "storel " + s_sm + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_big)
        let qv = qbe_tmp(g)
        let rv = qbe_tmp(g)
        let sq = qbe_tmp(g)
        let sr = qbe_tmp(g)
        let sc = qbe_tmp(g)
        qbe_emit(g, qv + " =l udiv " + obj_val + ", 10")
        qbe_emit(g, rv + " =l urem " + obj_val + ", 10")
        qbe_emit(g, sq + " =l call $pion_int_to_str(l " + qv + ")")
        qbe_emit(g, sr + " =l call $pion_int_to_str(l " + rv + ")")
        qbe_emit(g, sc + " =l call $pion_str_concat(l " + sq + ", l " + sr + ")")
        qbe_emit(g, "call $pion_rc_dec(l " + sq + ")")
        qbe_emit(g, "call $pion_rc_dec(l " + sr + ")")
        qbe_emit(g, "storel " + sc + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        let out = qbe_tmp(g)
        qbe_emit(g, out + " =l loadl " + res_slot)
        return qval(out, TString)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_uint" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TUInt)
      }
      if method_name == "to_int64" || method_name == "reinterpret_as_int64" {
        return qval(obj_val, TInt64)
      }
      if method_name == "to_uint64" {
        return qval(obj_val, TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d ultof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "reinterpret_as_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d cast " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_int8" {
        return qval(qbe_extsb_l(g, obj_val), TInt8)
      }
      match qbe_emit_int_bitop(g, obj_val, TUInt64, method_name, args) {
        Some(v) => return v
        None => ()
      }
    }
    TDouble => {
      if method_name == "to_string" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_double_to_str(d " + obj_val + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" {
        let w = qbe_emit_flt_to_int_sat(g, obj_val, true, false, false)
        return qval(w, TInt)
      }
      if method_name == "to_int64" {
        let r = qbe_emit_flt_to_int_sat(g, obj_val, true, true, false)
        return qval(r, TInt64)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
