            } else if qbe_is_4b_array_elem(g, elem) {
              qbe_store_arr_4b_l(g, vl, ep)
            } else {
              qbe_emit(g, "storel " + vl + ", " + ep)
            }
            qbe_emit(g, nlen + " =l add " + alen + ", 1")
            if prom_len_slot2 != "" {
              qbe_emit(g, "storel " + nlen + ", " + prom_len_slot2)
            } else {
              qbe_emit(g, "storel " + nlen + ", " + obj_val)
            }
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_slow)
            if prom_len_slot2 != "" {
              qbe_emit(g, "storel " + alen + ", " + obj_val)
            }
            if is_owned_obj {
              qbe_emit(g, "call $pion_arr_push_owned(l " + obj_val + ", l " + vl + ")")
            } else {
              qbe_emit(g, "call $pion_arr_push(l " + obj_val + ", l " + vl + ")")
            }
            if prom_len_slot2 != "" {
              let cp_s = qbe_tmp(g)
              let ncap = qbe_tmp(g)
              let dpp_s = qbe_tmp(g)
              let ndp = qbe_tmp(g)
              let nlen_s = qbe_tmp(g)
              qbe_emit(g, cp_s + " =l add " + obj_val + ", 8")
              qbe_emit(g, ncap + " =l loadl " + cp_s)
              qbe_emit(g, "storel " + ncap + ", " + prom_cap_slot2)
              qbe_emit(g, dpp_s + " =l add " + obj_val + ", 24")
              qbe_emit(g, ndp + " =l loadl " + dpp_s)
              qbe_emit(g, "storel " + ndp + ", " + prom_dp_slot2)
              qbe_emit(g, nlen_s + " =l add " + alen + ", 1")
              qbe_emit(g, "storel " + nlen_s + ", " + prom_len_slot2)
