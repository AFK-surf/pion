          let l_loop = qbe_lbl(g, "faf_fl")
          let l_cond = qbe_lbl(g, "faf_fc")
          let l_body = qbe_lbl(g, "faf_fb")
          let l_end = qbe_lbl(g, "faf_fe")
          qbe_emit(g, vw + " =w copy " + vl)
          qbe_emit(g, is_zero + " =w ceqw " + vw + ", 0")
          qbe_emit_term(g, "jnz " + is_zero + ", " + l_zero + ", " + l_loop)
          qbe_emit_lbl(g, l_zero)
          let has_pos = qbe_tmp(g)
          let l_ms = qbe_lbl(g, "faf_fms")
          qbe_emit(g, has_pos + " =w csgtl " + alen + ", 0")
          qbe_emit_term(g, "jnz " + has_pos + ", " + l_ms + ", " + l_end)
          qbe_emit_lbl(g, l_ms)
