///|
/// A queued monomorphized instance: its symbol and qualified substitution.
pub struct QbeMonoTarget {
  sym : String
  subst : Map[String, Ty]
}

///|
pub struct QbeMonoReq {
  sym : String
  finfo : FnInfo
  subst : Map[String, Ty]
  /// Canonical package whose source declares the fn ("" = this package): its
  /// body's unqualified top-level names resolve in that package.
  pkg : String
}

///|
pub struct QbeImplMethodMatch {
  sym : String
  finfo : FnInfo
  pkg_name : String
}

///|
pub struct QbeFnWrapper {
  wrap_sym : String
  target_sym : String
  param_tys : Array[Ty]
  ret_ty : Ty
  /// Trailing `%tp_*` object flags of a polymorphic generic target, one per
  /// type param: `"0"` / `"1"`, or `"env"` for a flag loaded from the next
  /// closure env word (still live in the generic that took the value).
  tp_flags : Array[String]
  is_extern_c : Bool
}

///|
pub struct QbeInlineClosure {
  params : Array[Param]
  param_tys : Array[Ty]
  ret_ty : Ty
  body : Array[Stmt]
  cap_locals : Array[QbeLocal]
}

///|
pub struct QbeProbeHints {
  names : Array[String]
  tys : Array[Ty]
}

///|
struct QbeCleanupNode {
  lbl : String
  depth : Int
  slot : String
  next_lbl : String
  order : Int
}

