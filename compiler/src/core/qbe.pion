          let hw = qbe_tmp(g)
          let r = qbe_tmp(g)
          qbe_emit(
            g,
            hw + " =w call $pion_vmap_has_" + m + "(l " + obj_val + qbe_vmap_key_call_args(vka) + ")",
          )
          if !obj_borrowed {
            qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
          }
