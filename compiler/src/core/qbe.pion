        let vv = qbe_emit_expr(g, args[0], Some(TInt))
        let vl = qbe_as_l(g, vv)
        qbe_emit(g, "call $pion_atomic_store(l " + obj_val + ", l " + vl + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "fetch_add" {
        let dv = qbe_emit_expr(g, args[0], Some(TInt))
        let dl = qbe_as_l(g, dv)
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(
          g,
          r64 + " =l call $pion_atomic_fetch_add(l " + obj_val + ", l " + dl + ")",
        )
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
    }
    TStruct(sname, sargs) => {
      match qbe_lookup_method_info(g, sname, method_name) {
        Some(minfo) => {
          let norm_args = resolve_call_args_qbe(
            minfo.decl.params,
            1,
            args,
            span_new("", 0, 0),
          )
          let norm_pure = !qbe_args_have_assign(norm_args)
          let subst : Map[String, Ty] = Map([])
          if minfo.param_tys.length() > 0 {
            unify_tparams(minfo.param_tys[0], recv_ty, subst)
          }
          match expected {
            Some(et) => unify_tparams(minfo.ret_ty, et, subst)
            None => ()
          }
          let qp_m = split_qual_name(sname)
          let mpkg = if qp_m.prefix != "" { qp_m.prefix } else { g.mono_pkg }
          let arg_vals : Array[String] = [obj_val]
          let arg_tys : Array[Ty] = [recv_ty]
          let arg_borrowed : Array[Bool] = [obj_borrowed]
          let mut i = 0
          while i < norm_args.length() {
            let p_idx = i + 1
            let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
              qbe_generic_arg_expect(
                g,
                minfo,
                mpkg,
                subst_ty(minfo.param_tys[p_idx], subst),
                norm_args[i],
              )
            } else {
              None
            }
            let aa = qbe_emit_arg_maybe_borrow(g, norm_args[i], exp_p, norm_pure)
            let av = aa.qv
            if p_idx < minfo.param_tys.length() {
              unify_tparams(minfo.param_tys[p_idx], av.ty, subst)
            }
            arg_vals.push(av.reg)
            arg_tys.push(av.ty)
            arg_borrowed.push(aa.borrowed)
            i = i + 1
          }
          if qbe_call_needs_mono(g, minfo, subst, mpkg) {
            return qbe_emit_mono_call(
              g,
              qbe_method_call_sym(g, sname, method_name),
              minfo,
              subst,
              arg_vals,
              arg_tys,
              arg_borrowed,
              mpkg,
            )
          }
          let call_args : Array[String] = []
          let call_abis : Array[String] = []
          let mut j = 0
          while j < arg_vals.length() {
            let decl_pty = if j < minfo.param_tys.length() {
              minfo.param_tys[j]
            } else {
              arg_tys[j]
            }
            call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
            call_abis.push(qbe_abi_ty(decl_pty))
            j = j + 1
          }
          let ret_abi = qbe_abi_ty(minfo.ret_ty)
          let res = qbe_tmp(g)
          let sb = StringBuilder()
          sb.write_string(res)
          sb.write_string(" =")
          sb.write_string(ret_abi)
          sb.write_string(" call ")
          sb.write_string(qbe_method_call_sym(g, sname, method_name))
          sb.write_string("(")
          j = 0
          while j < call_args.length() {
            if j > 0 {
              sb.write_string(", ")
            }
            sb.write_string(call_abis[j])
            sb.write_string(" ")
            sb.write_string(call_args[j])
            j = j + 1
          }
          let mut tpi = 0
          while tpi < minfo.decl.type_params.length() {
            if call_args.length() > 0 || tpi > 0 {
              sb.write_string(", ")
            }
            let tp_ty = match subst.get(minfo.decl.type_params[tpi]) {
              Some(t) => t
              None => TError
            }
            sb.write_string("l ")
            sb.write_string(qbe_is_obj_flag(g, tp_ty))
            tpi = tpi + 1
          }
          sb.write_string(")")
          qbe_emit(g, sb.to_string())
          j = 0
          while j < arg_vals.length() {
            if !arg_borrowed[j] {
              qbe_rc_dec(g, arg_vals[j], arg_tys[j])
            }
            j = j + 1
          }
          let concrete_ret = subst_ty(minfo.ret_ty, subst)
          let final_res = qbe_coerce_val(g, qval(res, minfo.ret_ty), concrete_ret)
          return qval(final_res, concrete_ret)
        }
        None => ()
      }
    }
    TDynTrait(tname) =>
      match lookup_trait(g.tc, tname) {
        Some(tinfo) => {
          let mut mi = 0
          while mi < tinfo.methods.length() {
            let tm = tinfo.methods[mi]
            if tm.name == method_name {
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let mut i = 0
              while i < args.length() {
                let p_idx = i + 1
                let exp_p : Option[Ty] = if p_idx < tm.param_tys.length() {
                  Some(tm.param_tys[p_idx])
                } else {
                  None
                }
                let aa = qbe_emit_arg_maybe_borrow(g, args[i], exp_p, args_pure)
                arg_vals.push(aa.qv.reg)
                arg_tys.push(aa.qv.ty)
                arg_borrowed.push(aa.borrowed)
                i = i + 1
              }
              let data_r = qbe_tmp(g)
              let vp_r = qbe_tmp(g)
              let vt_r = qbe_tmp(g)
              let fpa_r = qbe_tmp(g)
              let fp_r = qbe_tmp(g)
              let slot_off = (2 + mi) * 8
              qbe_emit(g, data_r + " =l loadl " + obj_val)
              qbe_emit(g, vp_r + " =l add " + obj_val + ", 8")
              qbe_emit(g, vt_r + " =l loadl " + vp_r)
              qbe_emit(g, fpa_r + " =l add " + vt_r + ", " + slot_off.to_string())
              qbe_emit(g, fp_r + " =l loadl " + fpa_r)
              let ret_abi = qbe_abi_ty(tm.ret_ty)
              let res = qbe_tmp(g)
              let sb = StringBuilder()
              sb.write_string(res)
              sb.write_string(" =")
              sb.write_string(ret_abi)
              sb.write_string(" call ")
              sb.write_string(fp_r)
              sb.write_string("(l ")
              sb.write_string(data_r)
              let mut j = 0
              while j < arg_vals.length() {
                let p_idx = j + 1
                let decl_pty = if p_idx < tm.param_tys.length() {
                  tm.param_tys[p_idx]
                } else {
                  arg_tys[j]
                }
                let coerced = qbe_coerce_val(
                  g,
                  qval(arg_vals[j], arg_tys[j]),
                  decl_pty,
                )
                sb.write_string(", ")
                sb.write_string(qbe_abi_ty(decl_pty))
                sb.write_string(" ")
                sb.write_string(coerced)
                j = j + 1
              }
              sb.write_string(")")
              qbe_emit(g, sb.to_string())
              j = 0
              while j < arg_vals.length() {
                if !arg_borrowed[j] {
                  qbe_rc_dec(g, arg_vals[j], arg_tys[j])
                }
                j = j + 1
              }
              if !obj_borrowed {
                qbe_rc_dec(g, obj_val, recv_ty)
              }
              return qval(res, tm.ret_ty)
            }
            mi = mi + 1
          }
        }
        None => ()
      }
    _ => ()
  }
  match qbe_find_impl_method(g, recv_ty, method_name) {
    Some(imatch) => {
      let minfo = imatch.finfo
      let norm_args = resolve_call_args_qbe(
        minfo.decl.params,
        1,
        args,
        span_new("", 0, 0),
      )
      let norm_pure = !qbe_args_have_assign(norm_args)
      let arg_vals : Array[String] = [obj_val]
      let arg_tys : Array[Ty] = [recv_ty]
      let arg_borrowed : Array[Bool] = [obj_borrowed]
      let mut i = 0
      while i < norm_args.length() {
        let p_idx = i + 1
        let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
          Some(minfo.param_tys[p_idx])
        } else {
          None
        }
        let aa = qbe_emit_arg_maybe_borrow(g, norm_args[i], exp_p, norm_pure)
        arg_vals.push(aa.qv.reg)
        arg_tys.push(aa.qv.ty)
        arg_borrowed.push(aa.borrowed)
        i = i + 1
      }
      let call_args : Array[String] = []
      let call_abis : Array[String] = []
      let mut j = 0
      while j < arg_vals.length() {
        let decl_pty = if j < minfo.param_tys.length() {
          minfo.param_tys[j]
        } else {
          arg_tys[j]
        }
        call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
        call_abis.push(qbe_abi_ty(decl_pty))
        j = j + 1
      }
      let ret_abi = qbe_abi_ty(minfo.ret_ty)
      let res = qbe_tmp(g)
      let sb = StringBuilder()
      sb.write_string(res)
      sb.write_string(" =")
      sb.write_string(ret_abi)
      sb.write_string(" call ")
      sb.write_string(imatch.sym)
      sb.write_string("(")
      j = 0
      while j < call_args.length() {
        if j > 0 {
          sb.write_string(", ")
        }
        sb.write_string(call_abis[j])
        sb.write_string(" ")
        sb.write_string(call_args[j])
        j = j + 1
      }
      sb.write_string(")")
      qbe_emit(g, sb.to_string())
      j = 0
      while j < arg_vals.length() {
        if !arg_borrowed[j] {
          qbe_rc_dec(g, arg_vals[j], arg_tys[j])
        }
        j = j + 1
      }
      return qval(res, minfo.ret_ty)
    }
    None => ()
  }
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, recv_ty)
  }
  qval("0", TError)
}

///|
fn qbe_emit_pat_test(
  g : QbeGen,
  pat : Pattern,
  vreg : String,
  scrut_ty : Ty,
  fail_lbl : String,
) -> Unit {
  match pat {
    PWild(_) | PIdent(_, _) => ()
    PBool(b, _) => {
      let bv = if b { "1" } else { "0" }
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      qbe_emit(g, eq + " =w ceql " + vreg + ", " + bv)
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PInt(raw, _) => {
      let iv = qbe_parse_int64_lit(raw)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      if qbe_is_int32_ty(scrut_ty) || qbe_is_uint32_ty(scrut_ty) {
        let v32 = iv.to_int().to_int64().to_string()
        qbe_emit(g, eq + " =w ceqw " + vreg + ", " + v32)
      } else {
        qbe_emit(g, eq + " =w ceql " + vreg + ", " + iv.to_string())
      }
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PChar(raw, _) => {
      let cv = qbe_parse_char_lit(raw)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      qbe_emit(g, eq + " =w ceql " + vreg + ", " + cv.to_string())
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PString(s, _) => {
      let lit = qbe_emit_string_lit(g, s)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      qbe_emit(g, eq + " =w call $pion_str_eq(l " + vreg + ", l " + lit + ")")
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PTuple(subs, _) =>
      match scrut_ty {
        TTuple(elems) => {
          let mut i = 0
          while i < subs.length() && i < elems.length() {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + vreg + ", " + (i * 8).to_string())
            let fv = qbe_load_heap_slot(g, p, elems[i])
            qbe_emit_pat_test(g, subs[i], fv, elems[i], fail_lbl)
            i = i + 1
          }
        }
        _ => ()
      }
    PVariant(_, vname, subs, _) => {
      match scrut_ty {
        TOption(inner) =>
          if qbe_is_niche_opt_inner(inner) {
            let eq = qbe_tmp(g)
            let ok_lbl = qbe_lbl(g, "tag_ok")
            if vname == "None" {
              qbe_emit(g, eq + " =w ceql " + vreg + ", 0")
            } else {
              qbe_emit(g, eq + " =w cnel " + vreg + ", 0")
            }
            qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            qbe_emit_lbl(g, ok_lbl)
            if vname == "Some" && subs.length() >= 1 {
              qbe_emit_pat_test(g, subs[0], vreg, inner, fail_lbl)
            }
            return
          }
        _ => ()
      }
      let mut tag = 0
      let field_tys : Array[Ty] = []
      match scrut_ty {
        TOption(inner) =>
          if vname == "None" {
            tag = 0
          } else {
            tag = 1
            field_tys.push(inner)
          }
        TResult(ok, err) =>
          if vname == "Ok" {
            tag = 0
            field_tys.push(ok)
          } else {
            tag = 1
            field_tys.push(err)
          }
        TEnum(ename, eargs) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  tag = vi
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let actual_tag = qbe_tmp(g)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "tag_ok")
      qbe_emit(g, actual_tag + " =l loadl " + vreg)
      qbe_emit(g, eq + " =w ceql " + actual_tag + ", " + tag.to_string())
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
      let mut fi = 0
      while fi < subs.length() && fi < field_tys.length() {
        let p = qbe_tmp(g)
        qbe_emit(g, p + " =l add " + vreg + ", " + ((fi + 1) * 8).to_string())
        let fv = qbe_load_heap_slot(g, p, field_tys[fi])
        qbe_emit_pat_test(g, subs[fi], fv, field_tys[fi], fail_lbl)
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_emit_pat_bind(
  g : QbeGen,
  pat : Pattern,
  vreg : String,
  scrut_ty : Ty,
  allow_borrow : Bool,
  arm_body : Expr,
) -> Unit {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
    PIdent(name, _) => {
      let borrow_this = allow_borrow &&
        qbe_is_obj_ty(scrut_ty) &&
        qbe_ident_is_borrow_safe_expr(g, arm_body, name)
      if !borrow_this {
        qbe_rc_inc(g, vreg, scrut_ty)
      }
      let loc = qbe_define_local(g, name, scrut_ty, !borrow_this)
      qbe_store_local_slot(g, vreg, loc.slot, scrut_ty)
    }
    PTuple(subs, _) =>
      match scrut_ty {
        TTuple(elems) => {
          let mut i = 0
          while i < subs.length() && i < elems.length() {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + vreg + ", " + (i * 8).to_string())
            let fv = qbe_load_heap_slot(g, p, elems[i])
            qbe_emit_pat_bind(g, subs[i], fv, elems[i], allow_borrow, arm_body)
            i = i + 1
          }
        }
        _ => ()
      }
    PVariant(_, vname, subs, _) => {
      match scrut_ty {
        TOption(inner) =>
          if qbe_is_niche_opt_inner(inner) {
            if vname == "Some" && subs.length() >= 1 {
              qbe_emit_pat_bind(g, subs[0], vreg, inner, allow_borrow, arm_body)
            }
            return
          }
        _ => ()
      }
      let field_tys : Array[Ty] = []
      match scrut_ty {
        TOption(inner) =>
          if vname == "Some" {
            field_tys.push(inner)
          }
        TResult(ok, err) =>
          if vname == "Ok" {
            field_tys.push(ok)
          } else {
            field_tys.push(err)
          }
        TEnum(ename, eargs) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let mut fi = 0
      while fi < subs.length() && fi < field_tys.length() {
        let p = qbe_tmp(g)
        qbe_emit(g, p + " =l add " + vreg + ", " + ((fi + 1) * 8).to_string())
        let fv = qbe_load_heap_slot(g, p, field_tys[fi])
        qbe_emit_pat_bind(g, subs[fi], fv, field_tys[fi], allow_borrow, arm_body)
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_expr_has_is(e : Expr) -> Bool {
  match e {
    EIs(_, _, _) => true
    EBinary("&&", lhs, rhs, _) => qbe_expr_has_is(lhs) || qbe_expr_has_is(rhs)
    _ => false
  }
}

///|
fn qbe_release_scope_locals_from(g : QbeGen, start_idx : Int) -> Unit {
  if g.scopes.length() == 0 {
    return
  }
  let sc = g.scopes[g.scopes.length() - 1]
  let mut i = sc.locals.length() - 1
  while i >= start_idx {
    let loc = sc.locals[i]
    if loc.owned && !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
      match loc.ty {
        TParam(_) => {
          let v = qbe_tmp(g)
          qbe_emit(g, v + " =l loadl " + loc.slot)
          qbe_rc_dec(g, v, loc.ty)
        }
        _ =>
          if qbe_is_obj_ty(loc.ty) {
            let v = qbe_tmp(g)
            qbe_emit(g, v + " =l loadl " + loc.slot)
            qbe_rc_dec(g, v, loc.ty)
          }
      }
    }
    i = i - 1
  }
}

///|
fn qbe_emit_cond_branch_bind(
  g : QbeGen,
  cond : Expr,
  l_true : String,
  l_false : String,
) -> Unit {
  match cond {
    EIs(scrut, pat, sp) => {
      let sv = qbe_emit_expr(g, scrut, None)
      let l_pfail = qbe_lbl(g, "is_f")
      qbe_emit_pat_test(g, pat, sv.reg, sv.ty, l_pfail)
      qbe_emit_pat_bind(g, pat, sv.reg, sv.ty, false, EUnit(sp))
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_true)
      qbe_emit_lbl(g, l_pfail)
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_false)
    }
    EBinary("&&", lhs, rhs, _) => {
      let sc = g.scopes[g.scopes.length() - 1]
      let before_lhs = sc.locals.length()
      let l_rhs = qbe_lbl(g, "and_r")
      qbe_emit_cond_branch_bind(g, lhs, l_rhs, l_false)
      qbe_emit_lbl(g, l_rhs)
      let after_lhs = sc.locals.length()
      if after_lhs > before_lhs {
        let l_rhs_fail = qbe_lbl(g, "and_f")
        qbe_emit_cond_branch_bind(g, rhs, l_true, l_rhs_fail)
        qbe_emit_lbl(g, l_rhs_fail)
        qbe_release_scope_locals_from(g, before_lhs)
        qbe_emit_term(g, "jmp " + l_false)
      } else {
        qbe_emit_cond_branch_bind(g, rhs, l_true, l_false)
      }
    }
    _ => qbe_emit_cond_branch(g, cond, l_true, l_false)
  }
}

///|
/// Emit fused compare-and-branch (no `extuw` before `jnz`) so QBE arm64 `seljmp`
/// fuses `cmp/fcmp + b.cc` directly, and short-circuits `!`, `&&`, `||` with zero stack slots.
fn qbe_emit_cond_branch(
  g : QbeGen,
  cond : Expr,
  l_true : String,
  l_false : String,
) -> Unit {
  match cond {
    EUnary(op, inner, _) =>
      if op == "!" {
        qbe_emit_cond_branch(g, inner, l_false, l_true)
        return
      }
    EBinary(op, lhs, rhs, _) => {
      if op == "&&" {
        let l_rhs = qbe_lbl(g, "and_r")
        qbe_emit_cond_branch(g, lhs, l_rhs, l_false)
        qbe_emit_lbl(g, l_rhs)
        qbe_emit_cond_branch(g, rhs, l_true, l_false)
        return
      }
      if op == "||" {
        let l_rhs = qbe_lbl(g, "or_r")
        qbe_emit_cond_branch(g, lhs, l_true, l_rhs)
        qbe_emit_lbl(g, l_rhs)
        qbe_emit_cond_branch(g, rhs, l_true, l_false)
        return
      }
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let can_borrow = !qbe_expr_has_assign(lhs) && !qbe_expr_has_assign(rhs)
        let can_borrow_af = can_borrow &&
          qbe_loop_has_no_calls_expr(lhs) &&
          qbe_loop_has_no_calls_expr(rhs)
        let la = match lhs {
          EInt(raw, _) => {
            let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
            QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
          }
          _ => qbe_emit_arg_maybe_borrow_ext(g, lhs, None, can_borrow, can_borrow_af)
        }
        let lv = la.qv
        let ra = match lv.ty {
          TInt =>
            match rhs {
              EInt(raw, _) => {
                let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
                QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
              }
              _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), can_borrow, can_borrow_af)
            }
          _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), can_borrow, can_borrow_af)
        }
        let rv = ra.qv
        match lv.ty {
          TInt => {
            let lw = lv.reg
            let rw = qbe_coerce_val(g, rv, TInt)
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "csltw"
            } else if op == "<=" {
              "cslew"
            } else if op == ">" {
              "csgtw"
            } else {
              "csgew"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TUInt => {
            let lw = lv.reg
            let rw = qbe_coerce_val(g, rv, TUInt)
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "cultw"
            } else if op == "<=" {
              "culew"
            } else if op == ">" {
              "cugtw"
            } else {
              "cugew"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TUInt64 => {
            let ll = lv.reg
            let rl = qbe_coerce_val(g, rv, TUInt64)
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "cultl"
            } else if op == "<=" {
              "culel"
            } else if op == ">" {
              "cugtl"
            } else {
              "cugel"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ll + ", " + rl)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TDouble => {
            let ld = lv.reg
            let rd = qbe_coerce_val(g, rv, TDouble)
            let cop = if op == "==" {
              "ceqd"
            } else if op == "!=" {
              "cned"
            } else if op == "<" {
              "cltd"
            } else if op == "<=" {
              "cled"
            } else if op == ">" {
              "cgtd"
            } else {
              "cged"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ld + ", " + rd)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TFloat => {
            let lf = lv.reg
            let rf = qbe_coerce_val(g, rv, TFloat)
            let cop = if op == "==" {
              "ceqs"
            } else if op == "!=" {
              "cnes"
            } else if op == "<" {
              "clts"
            } else if op == "<=" {
              "cles"
            } else if op == ">" {
              "cgts"
            } else {
              "cges"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lf + ", " + rf)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TInt64 | TBool | TByte | TChar => {
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "csltl"
            } else if op == "<=" {
              "cslel"
            } else if op == ">" {
              "csgtl"
            } else {
              "csgel"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lv.reg + ", " + rv.reg)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TString => {
            if op == "==" || op == "!=" {
              let eq = qbe_tmp(g)
              qbe_emit(g, eq + " =w call $pion_str_eq(l " + lv.reg + ", l " + rv.reg + ")")
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              if op == "==" {
                qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
              } else {
                qbe_emit_term(g, "jnz " + eq + ", " + l_false + ", " + l_true)
              }
              return
            } else {
              let cmp = qbe_tmp(g)
              qbe_emit(g, cmp + " =w call $pion_str_cmp(l " + lv.reg + ", l " + rv.reg + ")")
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              let cop = if op == "<" {
                "csltw"
              } else if op == "<=" {
                "cslew"
              } else if op == ">" {
                "csgtw"
              } else {
                "csgew"
              }
              let cw = qbe_tmp(g)
              qbe_emit(g, cw + " =w " + cop + " " + cmp + ", 0")
              qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
              return
            }
          }
          _ => {
            if (op == "==" || op == "!=") && qbe_type_needs_eq_fn(g, lv.ty) {
              let eq_sym = qbe_ensure_eq_fn(g, lv.ty)
              let eq = qbe_tmp(g)
              qbe_emit(g, eq + " =w call " + eq_sym + "(l " + lv.reg + ", l " + rv.reg + ")")
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              if op == "==" {
                qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
              } else {
                qbe_emit_term(g, "jnz " + eq + ", " + l_false + ", " + l_true)
              }
              return
            }
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "csltl"
            } else if op == "<=" {
              "cslel"
            } else if op == ">" {
              "csgtl"
            } else {
              "csgel"
            }
            let cw = qbe_tmp(g)
            let lc = qbe_cmp_operand(g, lv.reg, lv.ty)
            let rc = qbe_cmp_operand(g, rv.reg, rv.ty)
            qbe_emit(g, cw + " =w " + cop + " " + lc + ", " + rc)
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
        }
      }
    }
    _ => ()
  }
  let cv = qbe_emit_expr(g, cond, Some(TBool))
  qbe_emit_term(g, "jnz " + cv.reg + ", " + l_true + ", " + l_false)
}

///|
fn qbe_peek_expr_ty(g : QbeGen, e : Expr) -> Option[Ty] {
  match e {
    EIdent(name, _) =>
      match qbe_lookup_local(g, name) {
        Some(loc) => Some(loc.ty)
        None => qbe_lookup_const_ty(g, name)
      }
    EField(base, fname, _) =>
      match qbe_peek_expr_ty(g, base) {
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == fname {
                  return Some(subst_ty(sinfo.field_tys[i], subst))
                }
                i = i + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    EMove(inner, _) => qbe_peek_expr_ty(g, inner)
    _ => None
  }
}

///|
fn qbe_hints_new() -> QbeProbeHints {
  QbeProbeHints::{ names: [], tys: [] }
}

///|
fn qbe_hints_copy(h : QbeProbeHints) -> QbeProbeHints {
  let names : Array[String] = []
  let tys : Array[Ty] = []
  let mut i = 0
  while i < h.names.length() {
    names.push(h.names[i])
    tys.push(h.tys[i])
    i = i + 1
  }
  QbeProbeHints::{ names: names, tys: tys }
}

///|
fn qbe_hints_set(h : QbeProbeHints, name : String, ty : Ty) -> Unit {
  if name == "" || name == "_" {
    return
  }
  h.names.push(name)
  h.tys.push(ty)
}

///|
fn qbe_hints_get(h : QbeProbeHints, name : String) -> Option[Ty] {
  let mut i = h.names.length() - 1
  while i >= 0 {
    if h.names[i] == name {
      return Some(h.tys[i])
    }
    i = i - 1
  }
  None
}

///|
fn qbe_bind_pat_probe_hints(
  g : QbeGen,
  pat : Pattern,
  scrut_ty_opt : Option[Ty],
  hints : QbeProbeHints,
) -> Unit {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
    PIdent(name, _) =>
      if name != "_" {
        match scrut_ty_opt {
          Some(t) =>
            if !ty_has_unresolved(t) {
              qbe_hints_set(hints, name, t)
            } else {
              qbe_hints_set(hints, name, TError)
            }
          None => qbe_hints_set(hints, name, TError)
        }
      }
    PTuple(subs, _) =>
      match scrut_ty_opt {
        Some(TTuple(elems)) => {
          let mut i = 0
          while i < subs.length() {
            let sub_ty : Option[Ty] = if i < elems.length() {
              Some(elems[i])
            } else {
              None
            }
            qbe_bind_pat_probe_hints(g, subs[i], sub_ty, hints)
            i = i + 1
          }
        }
        _ => {
          let mut i = 0
          while i < subs.length() {
            qbe_bind_pat_probe_hints(g, subs[i], None, hints)
            i = i + 1
          }
        }
      }
    PVariant(_, vname, subs, _) => {
      let field_tys : Array[Ty] = []
      match scrut_ty_opt {
        Some(TOption(inner)) =>
          if vname == "Some" {
            field_tys.push(inner)
          }
        Some(TResult(ok, err)) =>
          if vname == "Ok" {
            field_tys.push(ok)
          } else {
            field_tys.push(err)
          }
        Some(TEnum(ename, eargs)) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let mut fi = 0
      while fi < subs.length() {
        let sub_ty : Option[Ty] = if fi < field_tys.length() {
          Some(field_tys[fi])
        } else {
          None
        }
        qbe_bind_pat_probe_hints(g, subs[fi], sub_ty, hints)
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_probe_stmts_ty(g : QbeGen, stmts : Array[Stmt]) -> Option[Ty] {
  qbe_probe_stmts_ty_with(g, stmts, qbe_hints_new())
}

///|
fn qbe_probe_stmts_ty_with(
  g : QbeGen,
  stmts : Array[Stmt],
  outer_hints : QbeProbeHints,
) -> Option[Ty] {
  if stmts.length() == 0 {
    return None
  }
  let local_hints = qbe_hints_copy(outer_hints)
  let mut i = 0
  while i < stmts.length() - 1 {
    match stmts[i] {
      SLet(name, _, te, init, let_sp) =>
        if name != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, local_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => {
              let t = qbe_resolve_type(g, te)
              if !ty_has_unresolved(t) {
                bound_ty = t
              }
            }
          }
          qbe_hints_set(local_hints, name, bound_ty)
        }
      SLetTuple(names, te, init, _) => {
        let mut tup_elems : Array[Ty] = []
        match te {
          TyMissing(_) =>
            match qbe_probe_expr_ty_with(g, init, local_hints) {
              Some(TTuple(es)) => tup_elems = es
              _ => ()
            }
          _ =>
            match qbe_resolve_type(g, te) {
              TTuple(es) => tup_elems = es
              _ => ()
            }
        }
        let mut ni = 0
        while ni < names.length() {
          if names[ni] != "_" {
            let bt = if ni < tup_elems.length() && !ty_has_unresolved(tup_elems[ni]) {
              tup_elems[ni]
            } else {
              TError
            }
            qbe_hints_set(local_hints, names[ni], bt)
          }
          ni = ni + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  match stmts[stmts.length() - 1] {
    SExpr(e, _) => qbe_probe_expr_ty_with(g, e, local_hints)
    _ => None
  }
}

///|
fn qbe_probe_expr_ty(g : QbeGen, e : Expr) -> Option[Ty] {
  qbe_probe_expr_ty_with(g, e, qbe_hints_new())
}

///|
fn qbe_probe_expr_ty_with(
  g : QbeGen,
  e : Expr,
  hints : QbeProbeHints,
) -> Option[Ty] {
  match e {
    EInt(_, _) => Some(TInt)
    EInt64(_, _) => Some(TInt64)
    EUInt(_, _) => Some(TUInt)
    EUInt64(_, _) => Some(TUInt64)
    EDouble(_, _) => Some(TDouble)
    EFloat(_, _) => Some(TFloat)
    EBool(_, _) => Some(TBool)
    EByte(_, _) => Some(TByte)
    EChar(_, _) => Some(TChar)
    EString(_, _) | EInterp(_, _) => Some(TString)
    EUnit(_) => Some(TUnit)
    EIdent(name, _) =>
      match qbe_hints_get(hints, name) {
        Some(TError) => None
        Some(t) => Some(t)
        None =>
          match qbe_lookup_local(g, name) {
            Some(loc) => Some(loc.ty)
            None => qbe_lookup_const_ty(g, name)
          }
      }
    EPath(qual, mem, _) =>
      match resolve_alias_pkg(g.tc, qual) {
        Some(ipkg) =>
          match ipkg.tc.consts.get(mem) {
            Some(cty) => Some(qualify_imported_ty(ipkg.name, cty))
            None => None
          }
        None => None
      }
    EField(base, fname, _) =>
      match qbe_probe_expr_ty_with(g, base, hints) {
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == fname {
                  return Some(subst_ty(sinfo.field_tys[i], subst))
                }
                i = i + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    EArrayLit(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        match qbe_probe_expr_ty_with(g, elems[i], hints) {
          Some(et) =>
            if !ty_has_unresolved(et) {
              return Some(TArray(et))
            }
          None => ()
        }
        i = i + 1
      }
      None
    }
    ETuple(elems, _) => {
      let etys : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        match qbe_probe_expr_ty_with(g, elems[i], hints) {
          Some(et) => etys.push(et)
          None => return None
        }
        i = i + 1
      }
      Some(TTuple(etys))
    }
    EStructLit(sname, _, _, _) =>
      if sname != "" {
        match qbe_lookup_struct_info(g, sname) {
          Some(sinfo) =>
            if sinfo.decl.type_params.length() == 0 {
              Some(TStruct(sname, []))
            } else {
              None
            }
          None => None
        }
      } else {
        None
      }
    EBlock(stmts, _) => qbe_probe_stmts_ty_with(g, stmts, hints)
    EIf(_, then_stmts, Some(el), _) =>
      match qbe_probe_stmts_ty_with(g, then_stmts, hints) {
        Some(t) =>
          if !ty_has_unresolved(t) {
            Some(t)
          } else {
            qbe_probe_expr_ty_with(g, el, hints)
          }
        None => qbe_probe_expr_ty_with(g, el, hints)
      }
    EIs(_, _, _) => Some(TBool)
    EMatch(scrut, arms, _) => {
      let scrut_ty_opt = qbe_probe_expr_ty_with(g, scrut, hints)
      qbe_probe_arms_ty_with(g, arms, scrut_ty_opt, None, hints)
    }
    ECall(callee, args, _) =>
      match callee {
        EIdent(name, _) =>
          if name == "Some" && args.length() == 1 {
            match qbe_probe_expr_ty_with(g, args[0], hints) {
              Some(t) =>
                if !ty_has_unresolved(t) {
                  Some(TOption(t))
                } else {
                  None
                }
              None => None
            }
          } else if name == "StringBuilder" {
            Some(TStringBuilder)
          } else {
            match g.tc.fns.get(name) {
              Some(finfo) =>
                if finfo.decl.type_params.length() == 0 && !ty_has_unresolved(finfo.ret_ty) {
                  Some(finfo.ret_ty)
                } else {
                  None
                }
              None => None
            }
          }
        EPath(qual, mem, _) =>
          match resolve_alias_pkg(g.tc, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(finfo) =>
                  if finfo.decl.type_params.length() == 0 {
                    let rt = qualify_imported_ty(ipkg.name, finfo.ret_ty)
                    if !ty_has_unresolved(rt) {
                      Some(rt)
                    } else {
                      None
                    }
                  } else {
                    None
                  }
                None => None
              }
            None => None
          }
        _ => None
      }
    EMethodCall(recv, mname, _, _) =>
      match qbe_probe_expr_ty_with(g, recv, hints) {
        Some(TString) =>
          if mname == "split" {
            Some(TArray(TString))
          } else {
            None
          }
        Some(TArray(et)) =>
          if mname == "copy" && !ty_has_unresolved(et) {
            Some(TArray(et))
          } else {
            None
          }
        Some(TMap(k, v)) =>
          if mname == "copy" && !ty_has_unresolved(v) {
            Some(TMap(k, v))
          } else if mname == "keys" {
            Some(TArray(k))
          } else {
            None
          }
        Some(TStruct(sn, sargs)) =>
          if sargs.length() == 0 {
            match qbe_lookup_method_info(g, sn, mname) {
              Some(mi) =>
                if mi.decl.type_params.length() == 0 && !ty_has_unresolved(mi.ret_ty) {
                  Some(mi.ret_ty)
                } else {
                  None
                }
              None => None
            }
          } else {
            None
          }
        _ => None
      }
    EMove(inner, _) => qbe_probe_expr_ty_with(g, inner, hints)
    _ => None
  }
}

///|
fn qbe_probe_arms_ty(
  g : QbeGen,
  arms : Array[MatchArm],
  scrut_ty_opt : Option[Ty],
  expected : Option[Ty],
) -> Option[Ty] {
  qbe_probe_arms_ty_with(g, arms, scrut_ty_opt, expected, qbe_hints_new())
}

///|
fn qbe_probe_arms_ty_with(
  g : QbeGen,
  arms : Array[MatchArm],
  scrut_ty_opt : Option[Ty],
  expected : Option[Ty],
  outer_hints : QbeProbeHints,
) -> Option[Ty] {
  match expected {
    Some(et) =>
      if !ty_has_unresolved(et) {
        return expected
      }
    None => ()
  }
  let mut i = 0
  while i < arms.length() {
    let arm_hints = qbe_hints_copy(outer_hints)
    qbe_bind_pat_probe_hints(g, arms[i].pat, scrut_ty_opt, arm_hints)
    match qbe_probe_expr_ty_with(g, arms[i].body, arm_hints) {
      Some(t) =>
        if !ty_has_unresolved(t) {
          return Some(t)
        }
      None => ()
    }
    i = i + 1
  }
  expected
}

///|
fn qbe_probe_switch_arms_ty(
  g : QbeGen,
  arms : Array[QbeSwitchArm],
  default_expr_opt : Option[Expr],
  default_bind_name : String,
  expected : Option[Ty],
) -> Option[Ty] {
  match expected {
    Some(et) =>
      if !ty_has_unresolved(et) {
        return expected
      }
    None => ()
  }
  let base_hints = qbe_hints_new()
  let mut i = 0
  while i < arms.length() {
    let probed = match arms[i].expr_opt {
      Some(e) => qbe_probe_expr_ty_with(g, e, base_hints)
      None => qbe_probe_stmts_ty_with(g, arms[i].stmts, base_hints)
    }
    match probed {
      Some(t) =>
        if !ty_has_unresolved(t) {
          return Some(t)
        }
      None => ()
    }
    i = i + 1
  }
  match default_expr_opt {
    Some(de) => {
      let def_hints = qbe_hints_copy(base_hints)
      if default_bind_name != "" && default_bind_name != "_" {
        qbe_hints_set(def_hints, default_bind_name, TInt)
      }
      match qbe_probe_expr_ty_with(g, de, def_hints) {
        Some(t) =>
          if !ty_has_unresolved(t) {
            return Some(t)
          }
        None => ()
      }
    }
    None => ()
  }
  expected
}

///|
fn qbe_try_emit_map_get_match(
  g : QbeGen,
  scrut : Expr,
  arms : Array[MatchArm],
  expected : Option[Ty],
) -> Option[QbeVal] {
  match scrut {
    EMethodCall(map_expr, mname, margs, _) => {
      if mname != "get" || margs.length() != 1 || arms.length() != 2 {
        return None
      }
      match arms[0].guard_expr {
        Some(_) => return None
        None => ()
      }
      match arms[1].guard_expr {
        Some(_) => return None
        None => ()
      }
      let mut kty = TError
      let mut vty = TError
      match qbe_peek_expr_ty(g, map_expr) {
        Some(TMap(k, v)) => {
          kty = k
          vty = v
        }
        _ => return None
      }
      let mut matched = false
      let mut some_idx = 0
      let mut none_idx = 1
      let mut some_bind = ""
      match arms[0].pat {
        PVariant(q, vn, subs, _) =>
          if (q == "" || q == "Option") && vn == "Some" && subs.length() == 1 {
            let mut sub_ok = false
            match subs[0] {
              PIdent(vname, _) => {
                some_bind = vname
                sub_ok = true
              }
              PWild(_) => {
                some_bind = ""
                sub_ok = true
              }
              _ => ()
            }
            if sub_ok {
              match arms[1].pat {
                PVariant(q2, vn2, subs2, _) =>
                  if (q2 == "" || q2 == "Option") &&
                    vn2 == "None" &&
                    subs2.length() == 0 {
                    matched = true
                    some_idx = 0
                    none_idx = 1
                  }
                PWild(_) => {
                  matched = true
                  some_idx = 0
                  none_idx = 1
                }
                _ => ()
              }
            }
          } else if (q == "" || q == "Option") &&
            vn == "None" &&
            subs.length() == 0 {
            match arms[1].pat {
              PVariant(q2, vn2, subs2, _) =>
                if (q2 == "" || q2 == "Option") &&
                  vn2 == "Some" &&
                  subs2.length() == 1 {
                  match subs2[0] {
                    PIdent(vname, _) => {
                      some_bind = vname
                      matched = true
                      some_idx = 1
                      none_idx = 0
                    }
                    PWild(_) => {
                      some_bind = ""
                      matched = true
                      some_idx = 1
                      none_idx = 0
                    }
                    _ => ()
                  }
                }
              _ => ()
            }
          }
        _ => ()
      }
      if !matched {
        return None
      }
      qbe_scope_push(g)
      let key_expr = margs[0]
      let args_pure = !qbe_expr_has_assign(key_expr)
      let obj_av = qbe_emit_arg_maybe_borrow(g, map_expr, None, args_pure)
      let ka = qbe_emit_arg_maybe_borrow(g, key_expr, Some(kty), args_pure)
      let kl = qbe_as_l(g, ka.qv)
      let out_slot = qbe_alloc_slot(g)
      let hw = qbe_tmp(g)
      qbe_emit(
        g,
        hw +
        " =w call $pion_map_try_get(l " +
        obj_av.qv.reg +
        ", l " +
        kl +
        ", l " +
        out_slot +
        ")",
      )
      if !ka.borrowed {
        qbe_rc_dec(g, ka.qv.reg, ka.qv.ty)
      }
      if !obj_av.borrowed {
        let mloc = qbe_define_local(g, "__mget_map", obj_av.qv.ty, true)
        qbe_store_local_slot(g, obj_av.qv.reg, mloc.slot, obj_av.qv.ty)
      }
      let l_hit = qbe_lbl(g, "mget_some")
      let l_miss = qbe_lbl(g, "mget_none")
      let l_end = qbe_lbl(g, "mget_end")
      qbe_emit_term(g, "jnz " + hw + ", " + l_hit + ", " + l_miss)
      let mut res_slot = ""
      let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
        g,
        arms,
        Some(TOption(vty)),
        expected,
      )
      let mut saw_untyped_none = false
      qbe_emit_lbl(g, l_hit)
      qbe_scope_push(g)
      if some_bind != "" {
        let raw_l = qbe_tmp(g)
        qbe_emit(g, raw_l + " =l loadl " + out_slot)
        let v_val = qbe_from_l(g, raw_l, vty)
        qbe_rc_inc(g, v_val, vty)
        let vloc = qbe_define_local(g, some_bind, vty, true)
        qbe_store_local_slot(g, v_val, vloc.slot, vty)
      }
      let sv = qbe_emit_expr(g, arms[some_idx].body, res_ty)
      match res_ty {
        None =>
          match sv.ty {
            TNever => ()
            _ => {
              if qbe_is_untyped_option(sv.ty) {
                saw_untyped_none = true
              }
              res_ty = Some(sv.ty)
            }
          }
        Some(rt) => {
          if qbe_is_untyped_option(sv.ty) {
            saw_untyped_none = true
          }
          res_ty = Some(ty_prefer_concrete(rt, sv.ty))
        }
      }
      let some_term = g.block_term
      if !some_term {
        let store_ty = match res_ty {
          Some(t) => t
          None => sv.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, sv, store_ty), res_slot, store_ty)
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_miss)
      qbe_scope_push(g)
      let nv = qbe_emit_expr(g, arms[none_idx].body, res_ty)
      match res_ty {
        None =>
          match nv.ty {
            TNever => ()
            _ => {
              if qbe_is_untyped_option(nv.ty) {
                saw_untyped_none = true
              }
              res_ty = Some(nv.ty)
            }
          }
        Some(rt) =>
          if qbe_is_untyped_option(rt) && !qbe_is_untyped_option(nv.ty) {
            match nv.ty {
              TNever => ()
              _ => res_ty = Some(nv.ty)
            }
          } else if qbe_is_untyped_option(nv.ty) {
            saw_untyped_none = true
          }
      }
      let none_term = g.block_term
      if !none_term {
        let store_ty = match res_ty {
          Some(t) => t
          None => nv.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, nv, store_ty), res_slot, store_ty)
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      qbe_scope_pop(g)
      let final_ty = match res_ty {
        Some(t) => t
        None =>
          if some_term && none_term {
            TNever
          } else {
            TUnit
          }
      }
      if res_slot == "" {
        Some(qval(qbe_zero_reg(final_ty), final_ty))
      } else {
        let mut r = qbe_load_local_slot(g, res_slot, final_ty)
        if saw_untyped_none {
          match final_ty {
            TOption(oin) =>
              if qbe_is_niche_opt_inner(oin) {
                r = qbe_normalize_untyped_none(g, r)
              }
            _ => ()
          }
        }
        Some(qval(r, final_ty))
      }
    }
    _ => None
  }
}

///|
fn qbe_emit_extern_fn_call(
  g : QbeGen,
  einfo : ExternFnInfo,
  args : Array[Expr],
) -> QbeVal {
  let can_borrow = !qbe_args_have_assign(args)
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let owned_vals : Array[String] = []
  let owned_tys : Array[Ty] = []
  let mut i = 0
  while i < args.length() {
    let decl_pty = if i < einfo.param_tys.length() {
      einfo.param_tys[i]
    } else {
      TInt64
    }
    let aa = qbe_emit_arg_maybe_borrow(g, args[i], Some(decl_pty), can_borrow)
    let av = aa.qv
    if !aa.borrowed && qbe_is_obj_ty(av.ty) {
      owned_vals.push(av.reg)
      owned_tys.push(av.ty)
    }
    let cabi = qbe_c_abi_ty(decl_pty)
    let src_abi = qbe_abi_ty(av.ty)
    let carg = if src_abi == cabi {
      av.reg
    } else if cabi == "w" && src_abi == "l" {
      let w = qbe_tmp(g)
      qbe_emit(g, w + " =w copy " + av.reg)
      w
    } else if cabi == "l" && src_abi == "w" {
      let l = qbe_tmp(g)
      if qbe_is_uint32_ty(av.ty) {
        qbe_emit(g, l + " =l extuw " + av.reg)
      } else {
        qbe_emit(g, l + " =l extsw " + av.reg)
      }
      l
    } else {
      qbe_coerce_val(g, av, decl_pty)
    }
    call_args.push(carg)
    call_abis.push(cabi)
    i = i + 1
  }
  let sb = StringBuilder()
  let is_unit = match einfo.ret_ty {
    TUnit => true
    _ => false
  }
  let raw_res = if is_unit { "" } else { qbe_tmp(g) }
  if !is_unit {
    sb.write_string(raw_res)
    sb.write_string(" =")
    sb.write_string(qbe_c_abi_ty(einfo.ret_ty))
    sb.write_string(" ")
  }
  sb.write_string("call $")
  sb.write_string(einfo.decl.c_symbol)
  sb.write_string("(")
  i = 0
  while i < call_args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    if einfo.decl.vararg_from >= 0 && i == einfo.decl.vararg_from {
      sb.write_string("..., ")
    }
    sb.write_string(call_abis[i])
    sb.write_string(" ")
    sb.write_string(call_args[i])
    i = i + 1
  }
  if einfo.decl.vararg_from >= 0 && einfo.decl.vararg_from == call_args.length() {
    if call_args.length() > 0 {
      sb.write_string(", ")
    }
    sb.write_string("...")
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  let mut oi = 0
  while oi < owned_vals.length() {
    qbe_rc_dec(g, owned_vals[oi], owned_tys[oi])
    oi = oi + 1
  }
  if is_unit {
    return qval("0", TUnit)
  }
  match einfo.ret_ty {
    TBool => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + raw_res)
      qval(rl, TBool)
    }
    TByte => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extub " + raw_res)
      qval(rl, TByte)
    }
    TChar => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + raw_res)
      qval(rl, TChar)
    }
    _ => qval(raw_res, einfo.ret_ty)
  }
}

///|
fn qbe_emit_rt_prim_call(g : QbeGen, pr : RtPrim, args : Array[Expr]) -> QbeVal {
  let can_borrow = !qbe_args_have_assign(args)
  let off = if pr.world { 1 } else { 0 }
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let owned_vals : Array[String] = []
  let owned_tys : Array[Ty] = []
  let mut i = 0
  while i < args.length() {
    let pty = if i < off {
      TWorld
    } else if i - off < pr.param_tys.length() {
      pr.param_tys[i - off]
    } else {
      TInt64
    }
    let av = qbe_emit_arg_maybe_borrow(g, args[i], Some(pty), can_borrow)
    if !av.borrowed && qbe_is_obj_ty(av.qv.ty) {
      owned_vals.push(av.qv.reg)
      owned_tys.push(av.qv.ty)
    }
    let cabi = if (
      pr.c_sym == "pion_bytes_from_ptr" || pr.c_sym == "pion_bytes_copy_to_ptr"
    ) &&
      qbe_c_abi_ty(pty) == "w" {
      "l"
    } else {
      qbe_c_abi_ty(pty)
    }
    let src_abi = qbe_abi_ty(av.qv.ty)
    let carg = if src_abi == cabi {
      av.qv.reg
    } else if cabi == "w" && src_abi == "l" {
      let w = qbe_tmp(g)
      qbe_emit(g, w + " =w copy " + av.qv.reg)
      w
    } else if cabi == "l" && src_abi == "w" {
      let l = qbe_tmp(g)
      qbe_emit(g, l + " =l extsw " + av.qv.reg)
      l
    } else {
      qbe_coerce_val(g, av.qv, pty)
    }
    call_args.push(carg)
    call_abis.push(cabi)
    i = i + 1
  }
  let is_unit = match pr.ret_ty {
    TUnit => true
    _ => false
  }
  let sb = StringBuilder()
  let res = if is_unit { "" } else { qbe_tmp(g) }
  if !is_unit {
    sb.write_string(res)
    sb.write_string(" =")
    sb.write_string(qbe_c_abi_ty(pr.ret_ty))
    sb.write_string(" ")
  }
  sb.write_string("call $")
  sb.write_string(pr.c_sym)
  sb.write_string("(")
  i = 0
  while i < call_args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(call_abis[i])
    sb.write_string(" ")
    sb.write_string(call_args[i])
    i = i + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  i = 0
  while i < owned_vals.length() {
    qbe_rc_dec(g, owned_vals[i], owned_tys[i])
    i = i + 1
  }
  match pr.ret_ty {
    TUnit => qval("0", TUnit)
    // C returns `int32_t` 0/1; a Pion `Bool` lives in a 64-bit slot.
    TBool => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + res)
      qval(rl, TBool)
    }
    _ => qval(res, pr.ret_ty)
  }
}

///|
/// An import alias naming `g.mono_pkg` (registered under the canonical name
/// when the importer only knows it by another alias).
fn qbe_mono_pkg_alias(g : QbeGen) -> String {
  let canon = g.mono_pkg
  match g.tc.import_aliases.get(canon) {
    Some(_) => ()
    None => g.tc.import_aliases.set(canon, canon)
  }
  canon
}

///|
fn qbe_emit_mono_call(
  g : QbeGen,
  base_sym : String,
  finfo : FnInfo,
  subst : Map[String, Ty],
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
  decl_pkg : String,
) -> QbeVal {
  let mono_sym = qbe_mono_fn_sym(base_sym, finfo.decl.type_params, subst)
  if !g.mono_seen.contains(mono_sym) {
    g.mono_seen.set(mono_sym, true)
    g.mono_queue.push(QbeMonoReq::{
      sym: mono_sym,
      finfo: finfo,
      subst: subst,
      pkg: decl_pkg,
    })
  }
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let mut j = 0
  while j < arg_vals.length() {
    let decl_pty = if j < finfo.param_tys.length() {
      subst_ty(finfo.param_tys[j], subst)
    } else {
      arg_tys[j]
    }
    call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
    call_abis.push(qbe_abi_ty(decl_pty))
    j = j + 1
  }
  let concrete_ret = subst_ty(finfo.ret_ty, subst)
  let ret_abi = qbe_abi_ty(concrete_ret)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =")
  sb.write_string(ret_abi)
  sb.write_string(" call ")
  sb.write_string(mono_sym)
  sb.write_string("(")
  j = 0
  while j < call_args.length() {
    if j > 0 {
      sb.write_string(", ")
    }
    sb.write_string(call_abis[j])
    sb.write_string(" ")
    sb.write_string(call_args[j])
    j = j + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qval(res, concrete_ret)
}

///|
fn qbe_emit_expr(
  g : QbeGen,
  expr : Expr,
  expected : Option[Ty],
) -> QbeVal {
  let res = qbe_emit_expr_inner(g, expr, expected)
  match expected {
    Some(TDynTrait(tname)) =>
      match res.ty {
        TDynTrait(_) | TNever | TError => res
        _ => qbe_box_dyn(g, res, tname)
      }
    _ => res
  }
}

///|
fn qbe_emit_expr_inner(
  g : QbeGen,
  expr : Expr,
  expected : Option[Ty],
) -> QbeVal {
  match expr {
    EInt(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      match expected {
        Some(TUInt) => {
          let v32 = v64.to_int().to_int64()
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =w copy " + v32.to_string())
          qval(t, TUInt)
        }
        Some(TUInt64) => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l copy " + v64.to_string())
          qval(t, TUInt64)
        }
        _ => {
          let v32 = v64.to_int().to_int64()
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =w copy " + v32.to_string())
          qval(t, TInt)
        }
      }
    }
    EInt64(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v64.to_string())
      qval(t, TInt64)
    }
    EUInt(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let v32 = v64.to_int().to_int64()
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =w copy " + v32.to_string())
      qval(t, TUInt)
    }
    EUInt64(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v64.to_string())
      qval(t, TUInt64)
    }
    EDouble(raw, _) => {
      let sb = StringBuilder()
      let mut i = 0
      while i < raw.length() {
        let c = str_code_at(raw, i)
        if c != 95 {
          sb.write_char(c.unsafe_to_char())
        }
        i = i + 1
      }
      match expected {
        Some(TFloat) => {
          let f = qbe_tmp(g)
          qbe_emit(g, f + " =s copy s_" + sb.to_string())
          qval(f, TFloat)
        }
        _ => {
          let d = qbe_tmp(g)
          qbe_emit(g, d + " =d copy d_" + sb.to_string())
          qval(d, TDouble)
        }
      }
    }
    EFloat(raw, _) => {
      let sb = StringBuilder()
      let mut len = raw.length()
      if len > 0 && str_code_at(raw, len - 1) == 102 {
        len = len - 1
      }
      let mut i = 0
      while i < len {
        let c = str_code_at(raw, i)
        if c != 95 {
          sb.write_char(c.unsafe_to_char())
        }
        i = i + 1
      }
      let f = qbe_tmp(g)
      qbe_emit(g, f + " =s copy s_" + sb.to_string())
      qval(f, TFloat)
    }
    EBool(b, _) => {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + (if b { "1" } else { "0" }))
      qval(t, TBool)
    }
    EByte(raw, _) => {
      let v = qbe_parse_char_lit(raw) & 255
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v.to_string())
      qval(t, TByte)
    }
    EChar(raw, _) => {
      let v = qbe_parse_char_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v.to_string())
      qval(t, TChar)
    }
    EString(s, _) => qval(qbe_emit_string_lit(g, s), TString)
    EUnit(_) => qval("0", TUnit)
    ENamedArg(_, _, inner, _) => qbe_emit_expr(g, inner, expected)
    EIdent(name, _) => {
      match qbe_lookup_local(g, name) {
        Some(loc) => {
          let moved = if loc.owned && qbe_is_early_drop_ty(loc.ty) {
            match g.movable_locals.get(name) {
              Some(mslot) => mslot == loc.slot
              None => false
            }
          } else {
            false
          }
          let t = qbe_load_local_slot(g, loc.slot, loc.ty)
          g.unfrozen_local_arrs.remove(name)
          if moved {
            g.movable_locals.remove(name)
            g.moved_slots.set(loc.slot, true)
            qbe_emit(g, "storel 0, " + loc.slot)
            return qval(t, loc.ty)
          }
          if qbe_is_int32_ty(loc.ty) {
            match g.local_w_to_l_ext.get(name) {
              Some(rl) => g.w_to_l_ext.set(t, rl)
              None => ()
            }
          }
          qbe_rc_inc(g, t, loc.ty)
          return qval(t, loc.ty)
        }
        None => ()
      }
      if g.mono_pkg != "" {
        match g.tc.imported_pkgs.get(g.mono_pkg) {
          Some(ipkg) => {
            match ipkg.tc.consts.get(name) {
              Some(cty) => {
                let qcty = qualify_imported_ty(ipkg.name, cty)
                let t = qbe_load_heap_slot(g, qbe_ext_const_sym(ipkg.name, name), qcty)
                qbe_rc_inc(g, t, qcty)
                return qval(t, qcty)
              }
              None => ()
            }
            match ipkg.tc.fns.get(name) {
              Some(finfo) => {
                let qfi = qualify_fn_info(ipkg.name, finfo)
                let wrap_sym = "$pion_" +
                  g.pkg_prefix +
                  "wrap_ext_" +
                  qbe_sanitize_sym(ipkg.name + "__" + name)
                let target_sym = qbe_ext_fn_sym(ipkg.name, name)
                let wrap = qbe_register_fn_wrapper(
                  g,
                  wrap_sym,
                  target_sym,
                  qfi.param_tys,
                  qfi.ret_ty,
                )
                let clo = qbe_tmp(g)
                qbe_emit(g, clo + " =l call $pion_alloc(w 8, w 6, l 0)")
                qbe_emit(g, "storel " + wrap + ", " + clo)
                return qval(clo, TFn(qfi.param_tys, qfi.ret_ty))
              }
              None => ()
            }
            match ipkg.tc.variant_to_enum.get(name) {
              Some(en) =>
                return qbe_emit_variant_ctor(
                  g,
                  ipkg.name + "::" + en,
                  name,
                  [],
                  expected,
                )
              None => ()
            }
          }
          None => ()
        }
      }
      match g.tc.consts.get(name) {
        Some(cty) => {
          match cty {
            TInt =>
              match g.const_int_vals.get(name) {
                Some(v) => return qval(v.to_string(), TInt)
                None => ()
              }
            TInt64 =>
              match g.const_i64_vals.get(name) {
                Some(v) => return qval(v.to_string(), TInt64)
                None => ()
              }
            TBool =>
              match g.const_bool_vals.get(name) {
                Some(b) => return qval(if b { "1" } else { "0" }, TBool)
                None => ()
              }
            _ => ()
          }
          let t = qbe_load_heap_slot(g, qbe_local_const_sym(g, name), cty)
          qbe_rc_inc(g, t, cty)
          return qval(t, cty)
        }
        None => ()
      }
      match g.tc.fns.get(name) {
        Some(finfo) => {
          let wrap_sym = "$pion_" + g.pkg_prefix + "wrap_" + qbe_sanitize_sym(name)
          let target_sym = qbe_local_fn_sym(g, name)
          let wrap = qbe_register_fn_wrapper(
            g,
            wrap_sym,
            target_sym,
            finfo.param_tys,
            finfo.ret_ty,
          )
          let clo = qbe_tmp(g)
          qbe_emit(g, clo + " =l call $pion_alloc(w 8, w 6, l 0)")
          qbe_emit(g, "storel " + wrap + ", " + clo)
          return qval(clo, TFn(finfo.param_tys, finfo.ret_ty))
        }
        None => ()
      }
      if name == "None" {
        return qbe_emit_variant_ctor(g, "Option", "None", [], expected)
      }
      if g.tc.variant_to_enum.contains(name) {
        return qbe_emit_variant_ctor(g, "", name, [], expected)
      }
      qval("0", TError)
    }
    EPath(qual, mem, _) => {
      if qual == "Option" && mem == "None" {
        return qbe_emit_variant_ctor(g, "Option", "None", [], expected)
      }
      if g.tc.enums.contains(qual) {
        return qbe_emit_variant_ctor(g, qual, mem, [], expected)
      }
      let qp = split_qual_name(qual)
      let q_alias = qp.prefix
      let q_sub = qp.name
      if q_alias.length() > 0 {
        match resolve_alias_pkg(g.tc, q_alias) {
          Some(ipkg) =>
            if ipkg.tc.enums.contains(q_sub) {
              return qbe_emit_variant_ctor(
                g,
                ipkg.name + "::" + q_sub,
                mem,
                [],
                expected,
              )
            }
          None => ()
        }
      }
      match resolve_alias_pkg(g.tc, qual) {
        Some(ipkg) => {
          match ipkg.tc.consts.get(mem) {
            Some(cty) => {
              let qcty = qualify_imported_ty(ipkg.name, cty)
              let t = qbe_load_heap_slot(g, qbe_ext_const_sym(ipkg.name, mem), qcty)
              qbe_rc_inc(g, t, qcty)
              return qval(t, qcty)
            }
            None => ()
          }
          match ipkg.tc.fns.get(mem) {
            Some(finfo) => {
              let qfi = qualify_fn_info(ipkg.name, finfo)
              let wrap_sym = "$pion_" +
                g.pkg_prefix +
                "wrap_ext_" +
                qbe_sanitize_sym(ipkg.name + "__" + mem)
              let target_sym = qbe_ext_fn_sym(ipkg.name, mem)
              let wrap = qbe_register_fn_wrapper(
                g,
                wrap_sym,
                target_sym,
                qfi.param_tys,
                qfi.ret_ty,
              )
              let clo = qbe_tmp(g)
              qbe_emit(g, clo + " =l call $pion_alloc(w 8, w 6, l 0)")
              qbe_emit(g, "storel " + wrap + ", " + clo)
              return qval(clo, TFn(qfi.param_tys, qfi.ret_ty))
            }
            None => ()
          }
          match ipkg.tc.variant_to_enum.get(mem) {
            Some(en) =>
              return qbe_emit_variant_ctor(
                g,
                ipkg.name + "::" + en,
                mem,
                [],
                expected,
              )
            None => ()
          }
        }
        None => ()
      }
      qval("0", TError)
    }
    EMove(inner, _) => qbe_emit_expr(g, inner, expected)
    ETry(inner, _) => {
      let iv = qbe_emit_expr(g, inner, None)
      match iv.ty {
        TResult(ok_ty, _) => {
          let tag = qbe_tmp(g)
          let is_ok = qbe_tmp(g)
          let l_ok = qbe_lbl(g, "try_ok")
          let l_err = qbe_lbl(g, "try_err")
          qbe_emit(g, tag + " =l loadl " + iv.reg)
          qbe_emit(g, is_ok + " =w ceql " + tag + ", 0")
          qbe_emit_term(g, "jnz " + is_ok + ", " + l_ok + ", " + l_err)
          qbe_emit_lbl(g, l_err)
          qbe_release_scopes_down_to(g, 0)
          qbe_emit_term(g, "ret " + iv.reg)
          qbe_emit_lbl(g, l_ok)
          let p1 = qbe_tmp(g)
          qbe_emit(g, p1 + " =l add " + iv.reg + ", 8")
          let payload = qbe_load_heap_slot(g, p1, ok_ty)
          qbe_rc_inc(g, payload, ok_ty)
          qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
          qval(payload, ok_ty)
        }
        TOption(inner_ty) => {
          let ret_inner = match g.cur_ret_ty {
            TOption(ri) => ri
            _ => TError
          }
          if qbe_is_niche_opt_inner(inner_ty) {
            let is_some = qbe_tmp(g)
            let l_some = qbe_lbl(g, "try_some")
            let l_none = qbe_lbl(g, "try_none")
            qbe_emit(g, is_some + " =w cnel " + iv.reg + ", 0")
            qbe_emit_term(g, "jnz " + is_some + ", " + l_some + ", " + l_none)
            qbe_emit_lbl(g, l_none)
            qbe_release_scopes_down_to(g, 0)
            let none_obj = qbe_emit_none(g, ret_inner)
            qbe_emit_term(g, "ret " + none_obj)
            qbe_emit_lbl(g, l_some)
            qval(iv.reg, inner_ty)
          } else {
            let tag = qbe_tmp(g)
            let is_some = qbe_tmp(g)
            let l_some = qbe_lbl(g, "try_some")
            let l_none = qbe_lbl(g, "try_none")
            qbe_emit(g, tag + " =l loadl " + iv.reg)
            qbe_emit(g, is_some + " =w ceql " + tag + ", 1")
            qbe_emit_term(g, "jnz " + is_some + ", " + l_some + ", " + l_none)
            qbe_emit_lbl(g, l_none)
            qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
            qbe_release_scopes_down_to(g, 0)
            let none_obj = qbe_emit_none(g, ret_inner)
            qbe_emit_term(g, "ret " + none_obj)
            qbe_emit_lbl(g, l_some)
            let p1 = qbe_tmp(g)
            qbe_emit(g, p1 + " =l add " + iv.reg + ", 8")
            let payload = qbe_load_heap_slot(g, p1, inner_ty)
            qbe_rc_inc(g, payload, inner_ty)
            qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
            qval(payload, inner_ty)
          }
        }
        _ => iv
      }
    }
    EInterp(parts, _) => {
      if parts.length() == 0 {
        return qval(qbe_emit_string_lit(g, ""), TString)
      }
      let sb = qbe_tmp(g)
      qbe_emit(g, sb + " =l call $pion_strbuf_new(l 32)")
      let mut i = 0
      while i < parts.length() {
        let part = parts[i]
        match part {
          EString(s, _) => {
            let lit = qbe_emit_string_lit(g, s)
            qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + lit + ")")
          }
          _ => {
            let pv = qbe_emit_expr(g, part, None)
            match pv.ty {
              TString => {
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + pv.reg + ")")
                qbe_rc_dec(g, pv.reg, TString)
              }
              TInt => {
                let v64 = qbe_as_l(g, pv)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + v64 + ")")
              }
              TInt64 =>
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + pv.reg + ")")
              TUInt => {
                let v64 = qbe_as_l(g, pv)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + v64 + ")")
              }
              TUInt64 => {
                let is_big = qbe_tmp(g)
                let l_big = qbe_lbl(g, "iu64_big")
                let l_sm = qbe_lbl(g, "iu64_sm")
                let l_end = qbe_lbl(g, "iu64_end")
                qbe_emit(g, is_big + " =w csltl " + pv.reg + ", 0")
                qbe_emit_term(g, "jnz " + is_big + ", " + l_big + ", " + l_sm)
                qbe_emit_lbl(g, l_sm)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + pv.reg + ")")
                qbe_emit_term(g, "jmp " + l_end)
                qbe_emit_lbl(g, l_big)
                let qv = qbe_tmp(g)
                let rv = qbe_tmp(g)
                qbe_emit(g, qv + " =l udiv " + pv.reg + ", 10")
                qbe_emit(g, rv + " =l urem " + pv.reg + ", 10")
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + qv + ")")
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + rv + ")")
                qbe_emit_term(g, "jmp " + l_end)
                qbe_emit_lbl(g, l_end)
              }
              TDouble => {
                let ds = qbe_tmp(g)
                qbe_emit(g, ds + " =l call $pion_double_to_str(d " + pv.reg + ")")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + ds + ")")
                qbe_emit(g, "call $pion_rc_dec(l " + ds + ")")
              }
              TFloat => {
                let d = qbe_tmp(g)
                let ds = qbe_tmp(g)
                qbe_emit(g, d + " =d exts " + pv.reg)
                qbe_emit(g, ds + " =l call $pion_double_to_str(d " + d + ")")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + ds + ")")
                qbe_emit(g, "call $pion_rc_dec(l " + ds + ")")
              }
              TBool => {
                let l_t = qbe_lbl(g, "ib_t")
                let l_f = qbe_lbl(g, "ib_f")
                let l_e = qbe_lbl(g, "ib_e")
                qbe_emit_term(g, "jnz " + pv.reg + ", " + l_t + ", " + l_f)
                qbe_emit_lbl(g, l_t)
                let st = qbe_emit_string_lit(g, "true")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + st + ")")
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_f)
                let sf = qbe_emit_string_lit(g, "false")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + sf + ")")
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_e)
              }
              TChar => {
                let cw = qbe_tmp(g)
                qbe_emit(g, cw + " =w copy " + pv.reg)
                qbe_emit(g, "call $pion_strbuf_push_char(l " + sb + ", w " + cw + ")")
              }
              _ => ()
            }
          }
        }
        i = i + 1
      }
      let res = qbe_tmp(g)
      qbe_emit(g, res + " =l call $pion_strbuf_to_str(l " + sb + ")")
      qbe_emit(g, "call $pion_rc_dec(l " + sb + ")")
      qval(res, TString)
    }
    EAs(inner, target, _) => {
      let rty = qbe_resolve_type(g, target)
      match rty {
        TDynTrait(_) => return qbe_emit_expr(g, inner, Some(rty))
        _ => ()
      }
      let v = qbe_emit_expr(g, inner, None)
      match rty {
        TDouble =>
          match v.ty {
            TInt => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d swtof " + v.reg)
              qval(d, TDouble)
            }
            TUInt => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d uwtof " + v.reg)
              qval(d, TDouble)
            }
            TInt64 | TByte | TChar => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d sltof " + v.reg)
              qval(d, TDouble)
            }
            TUInt64 => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d ultof " + v.reg)
              qval(d, TDouble)
            }
            TFloat => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d exts " + v.reg)
              qval(d, TDouble)
            }
            TDouble => qval(v.reg, TDouble)
            _ => qval(qbe_from_l(g, v.reg, TDouble), TDouble)
          }
        TFloat =>
          match v.ty {
            TInt => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s swtof " + v.reg)
              qval(f, TFloat)
            }
            TUInt => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s uwtof " + v.reg)
              qval(f, TFloat)
            }
            TInt64 | TByte | TChar => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s sltof " + v.reg)
              qval(f, TFloat)
            }
            TUInt64 => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s ultof " + v.reg)
              qval(f, TFloat)
            }
            TDouble => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s truncd " + v.reg)
              qval(f, TFloat)
            }
            TFloat => qval(v.reg, TFloat)
            _ => qval(qbe_from_l(g, v.reg, TFloat), TFloat)
          }
        TInt =>
          match v.ty {
            TDouble => {
              let w = qbe_tmp(g)
              qbe_emit(g, w + " =w dtosi " + v.reg)
              qval(w, TInt)
            }
            TFloat => {
              let w = qbe_tmp(g)
              qbe_emit(g, w + " =w stosi " + v.reg)
              qval(w, TInt)
            }
            TInt | TUInt => qval(v.reg, TInt)
            _ => qval(qbe_coerce_val(g, v, TInt), TInt)
          }
        TUInt =>
          match v.ty {
            TDouble => {
              let w = qbe_tmp(g)
              qbe_emit(g, w + " =w dtoui " + v.reg)
              qval(w, TUInt)
            }
            TFloat => {
              let w = qbe_tmp(g)
              qbe_emit(g, w + " =w stoui " + v.reg)
              qval(w, TUInt)
            }
            TInt | TUInt => qval(v.reg, TUInt)
            _ => qval(qbe_coerce_val(g, v, TUInt), TUInt)
          }
        TInt64 =>
          match v.ty {
            TDouble => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l dtosi " + v.reg)
              qval(r, TInt64)
            }
            TFloat => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l stosi " + v.reg)
              qval(r, TInt64)
            }
            TInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsw " + v.reg)
              qval(r, TInt64)
            }
            TUInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + v.reg)
              qval(r, TInt64)
            }
            _ => qval(v.reg, TInt64)
          }
        TUInt64 =>
          match v.ty {
            TDouble => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l dtoui " + v.reg)
              qval(r, TUInt64)
            }
            TFloat => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l stoui " + v.reg)
              qval(r, TUInt64)
            }
            TInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsw " + v.reg)
              qval(r, TUInt64)
            }
            TUInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + v.reg)
              qval(r, TUInt64)
            }
            _ => qval(v.reg, TUInt64)
          }
        TByte =>
          match v.ty {
            TDouble => {
              let w = qbe_tmp(g)
              let u = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, w + " =w dtosi " + v.reg)
              qbe_emit(g, u + " =l extuw " + w)
              qbe_emit(g, r + " =l and " + u + ", 255")
              qval(r, TByte)
            }
            _ => {
              let vl = qbe_as_l(g, v)
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l and " + vl + ", 255")
              qval(r, TByte)
            }
          }
        _ => qval(qbe_coerce_val(g, v, rty), rty)
      }
    }
    EUnary(op, inner, _) => {
      let iv = qbe_emit_expr(g, inner, expected)
      if op == "!" {
        let w = qbe_tmp(g)
        let nw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + iv.reg)
        qbe_emit(g, nw + " =w ceqw " + w + ", 0")
        qbe_emit(g, r + " =l extuw " + nw)
        qval(r, TBool)
      } else {
        match iv.ty {
          TInt => {
            let nw = qbe_tmp(g)
            qbe_emit(g, nw + " =w neg " + iv.reg)
            qval(nw, TInt)
          }
          TUInt => {
            let nw = qbe_tmp(g)
            qbe_emit(g, nw + " =w neg " + iv.reg)
            qval(nw, TUInt)
          }
          TDouble => {
            let nd = qbe_tmp(g)
            qbe_emit(g, nd + " =d neg " + iv.reg)
            qval(nd, TDouble)
          }
          TFloat => {
            let nf = qbe_tmp(g)
            qbe_emit(g, nf + " =s neg " + iv.reg)
            qval(nf, TFloat)
          }
          _ => {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l neg " + iv.reg)
            qval(r, iv.ty)
          }
        }
      }
    }
    EBinary(op, lhs, rhs, _) => {
      if op == "&&" {
        let res_slot = qbe_alloc_slot(g)
        let lv = qbe_emit_expr(g, lhs, Some(TBool))
        let l_rhs = qbe_lbl(g, "and_rhs")
        let l_false = qbe_lbl(g, "and_f")
        let l_end = qbe_lbl(g, "and_e")
        qbe_emit_term(g, "jnz " + lv.reg + ", " + l_rhs + ", " + l_false)
        qbe_emit_lbl(g, l_rhs)
        let rv = qbe_emit_expr(g, rhs, Some(TBool))
        qbe_emit(g, "storel " + rv.reg + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_false)
        qbe_emit(g, "storel 0, " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TBool)
      }
      if op == "||" {
        let res_slot = qbe_alloc_slot(g)
        let lv = qbe_emit_expr(g, lhs, Some(TBool))
        let l_true = qbe_lbl(g, "or_t")
        let l_rhs = qbe_lbl(g, "or_rhs")
        let l_end = qbe_lbl(g, "or_e")
        qbe_emit_term(g, "jnz " + lv.reg + ", " + l_true + ", " + l_rhs)
        qbe_emit_lbl(g, l_true)
        qbe_emit(g, "storel 1, " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_rhs)
        let rv = qbe_emit_expr(g, rhs, Some(TBool))
        qbe_emit(g, "storel " + rv.reg + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TBool)
      }
      // Loop-carried square reuse (`v * v` for TDouble local)
      if op == "*" {
        match lhs {
          EIdent(v1, _) =>
            match rhs {
              EIdent(v2, _) =>
                if v1 == v2 {
                  match g.sq_reuse_state.get(v1) {
                    Some(st) =>
                      match g.sq_reuse_slot.get(v1) {
                        Some(sq_slot) =>
                          if st == 1 {
                            let d = qbe_tmp(g)
                            qbe_emit(g, d + " =d loadd " + sq_slot)
                            return qval(d, TDouble)
                          } else if st == 2 {
                            let lv = qbe_emit_expr(g, lhs, Some(TDouble))
                            let ld = qbe_coerce_val(g, lv, TDouble)
                            let nsq = qbe_tmp(g)
                            qbe_emit(g, nsq + " =d mul " + ld + ", " + ld)
                            qbe_emit(g, "stored " + nsq + ", " + sq_slot)
                            g.sq_reuse_state.set(v1, 1)
                            return qval(nsq, TDouble)
                          }
                        None => ()
                      }
                    None => ()
                  }
                }
              _ => ()
            }
          _ => ()
        }
      }
      // N-way chained `String + String + ...` flattening (>= 3 parts) -> single $pion_str_concat_n
      if op == "+" {
        let mut is_add_chain = false
        match lhs {
          EBinary("+", _, _, _) => is_add_chain = true
          _ => ()
        }
        if is_add_chain {
          let parts : Array[Expr] = []
          let stack : Array[Expr] = [rhs, lhs]
          while stack.length() > 0 {
            match stack.pop() {
              Some(cur) =>
                match cur {
                  EBinary("+", cl, cr, _) => {
                    stack.push(cr)
                    stack.push(cl)
                  }
                  _ => parts.push(cur)
                }
              None => break
            }
          }
          if parts.length() >= 3 {
            let mut is_str_chain = match expected {
              Some(TString) => true
              _ => false
            }
            if !is_str_chain {
              let mut pi = 0
              while pi < parts.length() {
                match parts[pi] {
                  EString(_, _) | EInterp(_, _) => {
                    is_str_chain = true
                    break
                  }
                  EIdent(pn, _) =>
                    match qbe_lookup_local(g, pn) {
                      Some(ploc) =>
                        match ploc.ty {
                          TString => {
                            is_str_chain = true
                            break
                          }
                          _ => ()
                        }
                      None => ()
                    }
                  EMethodCall(_, mn, _, _) =>
                    if mn == "to_string" || mn == "slice" || mn == "trim" || mn == "join" {
                      is_str_chain = true
                      break
                    }
                  _ => ()
                }
                pi = pi + 1
              }
            }
            if is_str_chain {
              let can_borrow = !qbe_args_have_assign(parts)
              let mut can_borrow_af = can_borrow
              if can_borrow_af {
                let mut ci = 0
                while ci < parts.length() {
                  if !qbe_loop_has_no_calls_expr(parts[ci]) {
                    can_borrow_af = false
                    break
                  }
                  ci = ci + 1
                }
              }
              let n_parts = parts.length()
              let arr_slot = qbe_tmp(g)
              g.fn_allocs.write_string("    ")
              g.fn_allocs.write_string(arr_slot)
              g.fn_allocs.write_string(" =l alloc8 ")
              g.fn_allocs.write_string((n_parts * 8).to_string())
              g.fn_allocs.write_string("\n")
              let part_regs : Array[String] = []
              let part_borrowed : Array[Bool] = []
              let mut pi = 0
              while pi < n_parts {
                let pa = qbe_emit_arg_maybe_borrow_ext(
                  g,
                  parts[pi],
                  Some(TString),
                  can_borrow,
                  can_borrow_af,
                )
                let sp = qbe_tmp(g)
                qbe_emit(g, sp + " =l add " + arr_slot + ", " + (pi * 8).to_string())
                qbe_emit(g, "storel " + pa.qv.reg + ", " + sp)
                part_regs.push(pa.qv.reg)
                part_borrowed.push(pa.borrowed)
                pi = pi + 1
              }
              let r = qbe_tmp(g)
              qbe_emit(
                g,
                r + " =l call $pion_str_concat_n(l " + n_parts.to_string() + ", l " + arr_slot + ")",
              )
              pi = 0
              while pi < n_parts {
                if !part_borrowed[pi] {
                  qbe_rc_dec(g, part_regs[pi], TString)
                }
                pi = pi + 1
              }
              return qval(r, TString)
            }
          }
        }
      }
      // IEEE-754 exact `2.0 * x -> x + x` strength reduction
      if op == "*" && qbe_is_double_two(lhs) {
        let rv = qbe_emit_expr(g, rhs, expected)
        match rv.ty {
          TFloat => {
            let af = qbe_tmp(g)
            qbe_emit(g, af + " =s add " + rv.reg + ", " + rv.reg)
            return qval(af, TFloat)
          }
          _ => {
            let rd = qbe_coerce_val(g, rv, TDouble)
            let ad = qbe_tmp(g)
            qbe_emit(g, ad + " =d add " + rd + ", " + rd)
            return qval(ad, TDouble)
          }
        }
      }
      let cmp_borrow = (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "+") &&
        !qbe_expr_has_assign(lhs) &&
        !qbe_expr_has_assign(rhs)
      let cmp_borrow_af = cmp_borrow &&
        qbe_loop_has_no_calls_expr(lhs) &&
        qbe_loop_has_no_calls_expr(rhs)
      let is_arith_or_bit = op != "==" &&
        op != "!=" &&
        op != "<" &&
        op != "<=" &&
        op != ">" &&
        op != ">="
      let lhs_exp : Option[Ty] = if is_arith_or_bit { expected } else { None }
      let la = match lhs {
        EInt(raw, _) =>
          match lhs_exp {
            Some(TUInt) => {
              let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
              QbeArgVal::{ qv: qval(v32, TUInt), borrowed: true }
            }
            Some(TUInt64) => {
              let v64 = qbe_parse_int64_lit(raw).to_string()
              QbeArgVal::{ qv: qval(v64, TUInt64), borrowed: true }
            }
            _ => {
              let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
              QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
            }
          }
        _ => qbe_emit_arg_maybe_borrow_ext(g, lhs, lhs_exp, cmp_borrow, cmp_borrow_af)
      }
      let lv = la.qv
      if op == "*" && qbe_is_double_ty(lv.ty) && qbe_is_double_two(rhs) {
        let ad = qbe_tmp(g)
        qbe_emit(g, ad + " =d add " + lv.reg + ", " + lv.reg)
        return qval(ad, TDouble)
      }
      let ra = match lv.ty {
        TInt =>
          match rhs {
            EInt(raw, _) => {
              let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
              QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
            }
            _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), cmp_borrow, cmp_borrow_af)
          }
        _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), cmp_borrow, cmp_borrow_af)
      }
      let rv = ra.qv
      match lv.ty {
        TString => {
          if op == "+" {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_str_concat(l " + lv.reg + ", l " + rv.reg + ")")
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            return qval(r, TString)
          }
          if op == "==" || op == "!=" {
            let eq = qbe_tmp(g)
            qbe_emit(g, eq + " =w call $pion_str_eq(l " + lv.reg + ", l " + rv.reg + ")")
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            if op == "==" {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + eq)
              return qval(r, TBool)
            } else {
              let ne = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
              qbe_emit(g, r + " =l extuw " + ne)
              return qval(r, TBool)
            }
          }
          let cmp = qbe_tmp(g)
          qbe_emit(g, cmp + " =w call $pion_str_cmp(l " + lv.reg + ", l " + rv.reg + ")")
          if !la.borrowed {
            qbe_rc_dec(g, lv.reg, lv.ty)
          }
          if !ra.borrowed {
            qbe_rc_dec(g, rv.reg, rv.ty)
          }
          let cop = if op == "<" {
            "csltw"
          } else if op == "<=" {
            "cslew"
          } else if op == ">" {
            "csgtw"
          } else {
            "csgew"
          }
          let cw = qbe_tmp(g)
          let r = qbe_tmp(g)
          qbe_emit(g, cw + " =w " + cop + " " + cmp + ", 0")
          qbe_emit(g, r + " =l extuw " + cw)
          qval(r, TBool)
        }
        TInt => {
          let lw = lv.reg
          let rw = qbe_coerce_val(g, rv, TInt)
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "csltw"
            } else if op == "<=" {
              "cslew"
            } else if op == ">" {
              "csgtw"
            } else {
              "csgew"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else {
            // Power-of-2 signed division shift optimization (truncating toward zero)
            if op == "/" {
              match rhs {
                EInt(raw, _) => {
                  let d = qbe_parse_int64_lit(raw)
                  if d >= 2L && d <= 1073741824L && (d & (d - 1L)) == 0L {
                    let mut k = 0
                    let mut p2 = 1L
                    while p2 < d {
                      p2 = p2 << 1
                      k = k + 1
                    }
                    let aw = qbe_tmp(g)
                    if k == 1 {
                      if qbe_expr_is_even_int(lhs) {
                        qbe_emit(g, aw + " =w sar " + lw + ", 1")
                      } else {
                        let s = qbe_tmp(g)
                        let a = qbe_tmp(g)
                        qbe_emit(g, s + " =w shr " + lw + ", 31")
                        qbe_emit(g, a + " =w add " + lw + ", " + s)
                        qbe_emit(g, aw + " =w sar " + a + ", 1")
                      }
                    } else {
                      let s = qbe_tmp(g)
                      let b = qbe_tmp(g)
                      let a = qbe_tmp(g)
                      let mask = (d - 1L).to_string()
                      qbe_emit(g, s + " =w sar " + lw + ", 31")
                      qbe_emit(g, b + " =w and " + s + ", " + mask)
                      qbe_emit(g, a + " =w add " + lw + ", " + b)
                      qbe_emit(g, aw + " =w sar " + a + ", " + k.to_string())
                    }
                    return qval(aw, TInt)
                  }
                }
                _ => ()
              }
            }
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else if op == "/" {
              "div"
            } else if op == "%" {
              "rem"
            } else if op == "&" {
              "and"
            } else if op == "|" {
              "or"
            } else if op == "^" {
              "xor"
            } else if op == "<<" {
              "shl"
            } else {
              "sar"
            }
            let aw = qbe_tmp(g)
            qbe_emit(g, aw + " =w " + aop + " " + lw + ", " + rw)
            qval(aw, TInt)
          }
        }
        TUInt => {
          let lw = lv.reg
          let rw = qbe_coerce_val(g, rv, TUInt)
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "cultw"
            } else if op == "<=" {
              "culew"
            } else if op == ">" {
              "cugtw"
            } else {
              "cugew"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else {
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else if op == "/" {
              "udiv"
            } else if op == "%" {
              "urem"
            } else if op == "&" {
              "and"
            } else if op == "|" {
              "or"
            } else if op == "^" {
              "xor"
            } else if op == "<<" {
              "shl"
            } else {
              "shr"
            }
            let aw = qbe_tmp(g)
            qbe_emit(g, aw + " =w " + aop + " " + lw + ", " + rw)
            qval(aw, TUInt)
          }
        }
        TUInt64 => {
          let ll = lv.reg
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let rl = qbe_coerce_val(g, rv, TUInt64)
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "cultl"
            } else if op == "<=" {
              "culel"
            } else if op == ">" {
              "cugtl"
            } else {
              "cugel"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ll + ", " + rl)
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else if op == "<<" || op == ">>" {
            let rw = qbe_coerce_val(g, rv, TInt)
            let aop = if op == "<<" { "shl" } else { "shr" }
            let al = qbe_tmp(g)
            qbe_emit(g, al + " =l " + aop + " " + ll + ", " + rw)
            qval(al, TUInt64)
          } else {
            let rl = qbe_coerce_val(g, rv, TUInt64)
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else if op == "/" {
              "udiv"
            } else if op == "%" {
              "urem"
            } else if op == "&" {
              "and"
            } else if op == "|" {
              "or"
            } else {
              "xor"
            }
            let al = qbe_tmp(g)
            qbe_emit(g, al + " =l " + aop + " " + ll + ", " + rl)
            qval(al, TUInt64)
          }
        }
        TDouble => {
          let ld = lv.reg
          let rd = qbe_coerce_val(g, rv, TDouble)
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let cop = if op == "==" {
              "ceqd"
            } else if op == "!=" {
              "cned"
            } else if op == "<" {
              "cltd"
            } else if op == "<=" {
              "cled"
            } else if op == ">" {
              "cgtd"
            } else {
              "cged"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ld + ", " + rd)
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else {
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else {
              "div"
            }
            let ad = qbe_tmp(g)
            qbe_emit(g, ad + " =d " + aop + " " + ld + ", " + rd)
            qval(ad, TDouble)
          }
        }
        TFloat => {
          let lf = lv.reg
          let rf = qbe_coerce_val(g, rv, TFloat)
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let cop = if op == "==" {
              "ceqs"
            } else if op == "!=" {
              "cnes"
            } else if op == "<" {
              "clts"
            } else if op == "<=" {
              "cles"
            } else if op == ">" {
              "cgts"
            } else {
              "cges"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lf + ", " + rf)
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else {
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else {
              "div"
            }
            let af = qbe_tmp(g)
            qbe_emit(g, af + " =s " + aop + " " + lf + ", " + rf)
            qval(af, TFloat)
          }
        }
        _ => {
          if (op == "==" || op == "!=") && qbe_type_needs_eq_fn(g, lv.ty) {
            let eq_sym = qbe_ensure_eq_fn(g, lv.ty)
            let eq = qbe_tmp(g)
            qbe_emit(g, eq + " =w call " + eq_sym + "(l " + lv.reg + ", l " + rv.reg + ")")
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            if op == "==" {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + eq)
              return qval(r, TBool)
            } else {
              let ne = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
              qbe_emit(g, r + " =l extuw " + ne)
              return qval(r, TBool)
            }
          }
          if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "csltl"
            } else if op == "<=" {
              "cslel"
            } else if op == ">" {
              "csgtl"
            } else {
              "csgel"
            }
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            let lc = qbe_cmp_operand(g, lv.reg, lv.ty)
            let rc = qbe_cmp_operand(g, rv.reg, rv.ty)
            qbe_emit(g, cw + " =w " + cop + " " + lc + ", " + rc)
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            qbe_emit(g, r + " =l extuw " + cw)
            qval(r, TBool)
          } else if op == "<<" || op == ">>" {
            let rw = qbe_coerce_val(g, rv, TInt)
            let r = qbe_tmp(g)
            let sop = if op == "<<" { "shl" } else { "sar" }
            qbe_emit(g, r + " =l " + sop + " " + lv.reg + ", " + rw)
            qval(r, lv.ty)
          } else {
            let aop = if op == "+" {
              "add"
            } else if op == "-" {
              "sub"
            } else if op == "*" {
              "mul"
            } else if op == "/" {
              "div"
            } else if op == "%" {
              "rem"
            } else if op == "&" {
              "and"
            } else if op == "|" {
              "or"
            } else {
              "xor"
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l " + aop + " " + lv.reg + ", " + rv.reg)
            qval(r, lv.ty)
          }
        }
      }
    }
    ECall(callee, args, sp) => {
      g.block_immut_fields = Map([])
      match callee {
        EIdent(name, _) => {
          if name == "StringBuilder" {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_strbuf_new(l 32)")
            return qval(r, TStringBuilder)
          }
          if name == "Map" {
            let mut kty = TString
            let mut vty = TError
            match expected {
              Some(TMap(k, v)) => {
                kty = k
                vty = v
              }
              _ => ()
            }
            let vo = qbe_is_obj_flag_w(g, vty)
            let new_fn = if qbe_map_key_is_int(kty) {
              "$pion_map_new_int"
            } else {
              "$pion_map_new"
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call " + new_fn + "(w " + vo + ")")
            return qval(r, TMap(kty, vty))
          }
          if name == "sha256_hex" {
            let can_b = !qbe_args_have_assign(args)
            let sa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let sv = sa.qv
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_sha256_hex(l " + sv.reg + ")")
            if !sa.borrowed {
              qbe_rc_dec(g, sv.reg, sv.ty)
            }
            return qval(r, TString)
          }
          match rt_prim_info(name) {
            Some(pr) => return qbe_emit_rt_prim_call(g, pr, args)
            None => ()
          }
          if name == "ptr_null" {
            return qval("0", TPtr)
          }
          if name == "ptr_is_null" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l ceql " + pv.reg + ", 0")
            return qval(r, TBool)
          }
          if name == "ptr_addr" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            return qval(pv.reg, TInt64)
          }
          if name == "c_fn_ptr" {
            let mut c_sym = ""
            if args.length() >= 1 {
              match args[0] {
                EIdent(tname, _) => {
                  if g.mono_pkg != "" {
                    match g.tc.imported_pkgs.get(g.mono_pkg) {
                      Some(ipkg) =>
                        match ipkg.tc.extern_fns.get(tname) {
                          Some(ei) => c_sym = ei.decl.c_symbol
                          None => ()
                        }
                      None => ()
                    }
                  }
                  if c_sym == "" {
                    match g.tc.extern_fns.get(tname) {
                      Some(ei) => c_sym = ei.decl.c_symbol
                      None => c_sym = tname
                    }
                  }
                }
                EPath(alias_name, mem, _) => {
                  match resolve_alias_pkg(g.tc, alias_name) {
                    Some(ipkg) =>
                      match ipkg.tc.extern_fns.get(mem) {
                        Some(ei) => c_sym = ei.decl.c_symbol
                        None => ()
                      }
                    None => ()
                  }
                  if c_sym == "" && g.mono_pkg != "" {
                    match g.tc.imported_pkgs.get(g.mono_pkg) {
                      Some(mpkg) =>
                        match resolve_alias_pkg(mpkg.tc, alias_name) {
                          Some(ipkg) =>
                            match ipkg.tc.extern_fns.get(mem) {
                              Some(ei) => c_sym = ei.decl.c_symbol
                              None => ()
                            }
                          None => ()
                        }
                      None => ()
                    }
                  }
                  if c_sym == "" {
                    c_sym = mem
                  }
                }
                _ => ()
              }
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l copy $" + c_sym)
            return qval(r, TPtr)
          }
          if name == "str_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let sa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let sv = sa.qv
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l add " + sv.reg + ", 8")
            if !sa.borrowed {
              qbe_rc_dec(g, sv.reg, sv.ty)
            }
            return qval(r, TPtr)
          }
          if name == "bytes_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let ba = qbe_emit_arg_maybe_borrow(g, args[0], Some(TBytes), can_b)
            let bv = ba.qv
            let p = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + bv.reg + ", 16")
            qbe_emit(g, r + " =l loadl " + p)
            if !ba.borrowed {
              qbe_rc_dec(g, bv.reg, bv.ty)
            }
            return qval(r, TPtr)
          }
          if name == "array_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let aa = qbe_emit_arg_maybe_borrow(g, args[0], None, can_b)
            let av = aa.qv
            let p = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + av.reg + ", 24")
            qbe_emit(g, r + " =l loadl " + p)
            if !aa.borrowed {
              qbe_rc_dec(g, av.reg, av.ty)
            }
            return qval(r, TPtr)
          }
          if name == "ptr_read_f64" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let addr = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, r + " =d loadd " + addr)
            return qval(r, TDouble)
          }
          if name == "ptr_write_f64" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let vv = qbe_emit_expr(g, args[2], Some(TDouble))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let vd = qbe_coerce_val(g, vv, TDouble)
            let addr = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, "stored " + vd + ", " + addr)
            return qval("0", TUnit)
          }
          if name == "ptr_read_f32" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let addr = qbe_tmp(g)
            let s = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, s + " =s loads " + addr)
            qbe_emit(g, r + " =d exts " + s)
            return qval(r, TDouble)
          }
          if name == "ptr_write_f32" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let vv = qbe_emit_expr(g, args[2], Some(TDouble))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let vd = qbe_coerce_val(g, vv, TDouble)
            let s = qbe_tmp(g)
            let addr = qbe_tmp(g)
            qbe_emit(g, s + " =s truncd " + vd)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, "stores " + s + ", " + addr)
            return qval("0", TUnit)
          }
          if name == "ignore" {
            if args.length() >= 1 {
              let v = qbe_emit_expr(g, args[0], None)
              qbe_rc_dec(g, v.reg, v.ty)
            }
            return qval("0", TUnit)
          }
          if name == "math_sqrt" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d sqrt " + xd)
            return qval(r, TDouble)
          }
          if name == "math_abs" ||
            name == "math_floor" ||
            name == "math_ceil" ||
            name == "math_sin" ||
            name == "math_cos" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $pion_" + name + "(d " + xd + ")")
            return qval(r, TDouble)
          }
          if name == "math_tan" ||
            name == "math_asin" ||
            name == "math_acos" ||
            name == "math_atan" ||
            name == "math_exp" ||
            name == "math_log" ||
            name == "math_round" ||
            name == "math_trunc" {
            let c_fn = if name == "math_tan" {
              "tan"
            } else if name == "math_asin" {
              "asin"
            } else if name == "math_acos" {
              "acos"
            } else if name == "math_atan" {
              "atan"
            } else if name == "math_exp" {
              "exp"
            } else if name == "math_log" {
              "log"
            } else if name == "math_round" {
              "round"
            } else {
              "trunc"
            }
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $" + c_fn + "(d " + xd + ")")
            return qval(r, TDouble)
          }
          if name == "math_pow" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let yv = qbe_emit_expr(g, args[1], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let yd = qbe_coerce_val(g, yv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $pion_math_pow(d " + xd + ", d " + yd + ")")
            return qval(r, TDouble)
          }
          if name == "math_atan2" {
            let yv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xv = qbe_emit_expr(g, args[1], Some(TDouble))
            let yd = qbe_coerce_val(g, yv, TDouble)
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $atan2(d " + yd + ", d " + xd + ")")
            return qval(r, TDouble)
          }
          if is_world_builtin(name) {
            return qbe_emit_world_builtin(g, name, args)
          }
          if name == "abort" || name == "panic" {
            let file_id = qbe_intern_cstring(g, sp.file)
            let msg_id = qbe_intern_cstring(g, "panic")
            qbe_emit(
              g,
              "call $pion_panic(l $pion_cstr_" +
              msg_id.to_string() +
              ", l $pion_cstr_" +
              file_id.to_string() +
              ", w " +
              sp.line.to_string() +
              ")",
            )
            return qval("0", TNever)
          }
          // Inside a fn monomorphized from an imported package's source, its own
          // unqualified top-level fns and enum variants mean `pkg::name`.
          if g.mono_pkg != "" {
            match qbe_lookup_local(g, name) {
              Some(_) => ()
              None =>
                match g.tc.imported_pkgs.get(g.mono_pkg) {
                  Some(ipkg) =>
                    if ipkg.tc.fns.contains(name) ||
                      ipkg.tc.extern_fns.contains(name) ||
                      ipkg.tc.variant_to_enum.contains(name) {
                      return qbe_emit_expr(
                        g,
                        ECall(EPath(qbe_mono_pkg_alias(g), name, sp), args, sp),
                        expected,
                      )
                    }
                  None => ()
                }
            }
          }
          if name == "Some" || name == "Ok" || name == "Err" || g.tc.variant_to_enum.contains(name) {
            return qbe_emit_variant_ctor(g, "", name, args, expected)
          }
          match g.tc.fns.get(name) {
            Some(finfo) => {
              let norm_args = resolve_call_args_qbe(finfo.decl.params, 0, args, sp)
              let subst : Map[String, Ty] = Map([])
              match expected {
                Some(et) => unify_tparams(finfo.ret_ty, et, subst)
                None => ()
              }
              let can_borrow = !qbe_args_have_assign(norm_args)
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let mut i = 0
              while i < norm_args.length() {
                match norm_args[i] {
                  EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                  _ => ()
                }
                let exp_p : Option[Ty] = if i < finfo.param_tys.length() {
                  qbe_generic_arg_expect(g, finfo, "", subst_ty(finfo.param_tys[i], subst), norm_args[i])
                } else {
                  None
                }
                let aa = qbe_emit_arg_maybe_borrow(g, norm_args[i], exp_p, can_borrow)
                let av = aa.qv
                if i < finfo.param_tys.length() {
                  unify_tparams(finfo.param_tys[i], av.ty, subst)
                }
                arg_vals.push(av.reg)
                arg_tys.push(av.ty)
                arg_borrowed.push(aa.borrowed)
                i = i + 1
              }
              if qbe_call_needs_mono(g, finfo, subst, "") {
                return qbe_emit_mono_call(
                  g,
                  qbe_local_fn_sym(g, name),
                  finfo,
                  subst,
                  arg_vals,
                  arg_tys,
                  arg_borrowed,
                  "",
                )
              }
              // Small-function / leaf-function single-pass inlining (same-file only)
              if g.inline_depth < 2 &&
                finfo.decl.type_params.length() == 0 &&
                !str_arr_contains(g.inline_stack, name) {
                match g.inline_fns.get(name) {
                  Some(inl_fd) =>
                    if arg_vals.length() == inl_fd.params.length() &&
                      arg_vals.length() == finfo.param_tys.length() {
                      g.inline_depth = g.inline_depth + 1
                      g.inline_stack.push(name)
                      let inl_hlen = g.hoisted_arr_len
                      let inl_hdp = g.hoisted_arr_dp
                      let inl_hslen = g.hoisted_str_len
                      let inl_hsdp = g.hoisted_str_dp
                      let inl_hfields = g.hoisted_fields
                      let inl_bfields = g.block_immut_fields
                      let inl_lalias = g.len_aliases
                      let inl_lkeys = g.len_alias_keys
                      let inl_nonneg = g.nonneg_vars
                      let inl_bce = g.bce_safe_indices
                      let inl_bce_exprs = g.bce_safe_exprs
                      let inl_prom = g.promoted_fields
                      let inl_prom_tys = g.promoted_field_tys
                      let inl_w2l = g.w_to_l_ext
                      let inl_lw2l = g.local_w_to_l_ext
                      let inl_unfrozen = g.unfrozen_local_arrs
                      let inl_mov = g.movable_locals
                      let inl_moved = g.moved_slots
                      g.hoisted_arr_len = Map([])
                      g.hoisted_arr_dp = Map([])
                      g.hoisted_str_len = Map([])
                      g.hoisted_str_dp = Map([])
                      g.hoisted_fields = Map([])
                      g.block_immut_fields = Map([])
                      g.len_aliases = Map([])
                      g.len_alias_keys = []
                      g.nonneg_vars = Map([])
                      g.bce_safe_indices = Map([])
                      g.bce_safe_exprs = Map([])
                      g.promoted_fields = Map([])
                      g.promoted_field_tys = Map([])
                      g.w_to_l_ext = Map([])
                      g.local_w_to_l_ext = Map([])
                      g.unfrozen_local_arrs = Map([])
                      g.movable_locals = Map([])
                      g.moved_slots = Map([])
                      qbe_scope_push(g)
                      let mut pi = 0
                      while pi < inl_fd.params.length() {
                        let pty = finfo.param_tys[pi]
                        let loc = qbe_define_local(
                          g,
                          inl_fd.params[pi].name,
                          pty,
                          !arg_borrowed[pi],
                        )
                        let pv = qbe_coerce_val(g, qval(arg_vals[pi], arg_tys[pi]), pty)
                        qbe_store_local_slot(g, pv, loc.slot, pty)
                        pi = pi + 1
                      }
                      let bres = qbe_emit_stmts(g, inl_fd.body, Some(finfo.ret_ty))
                      let out_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
                      qbe_scope_pop(g)
                      g.hoisted_arr_len = inl_hlen
                      g.hoisted_arr_dp = inl_hdp
                      g.hoisted_str_len = inl_hslen
                      g.hoisted_str_dp = inl_hsdp
                      g.hoisted_fields = inl_hfields
                      g.block_immut_fields = Map([])
                      g.len_aliases = inl_lalias
                      g.len_alias_keys = inl_lkeys
                      g.nonneg_vars = inl_nonneg
                      g.bce_safe_indices = inl_bce
                      g.bce_safe_exprs = inl_bce_exprs
                      g.promoted_fields = inl_prom
                      g.promoted_field_tys = inl_prom_tys
                      g.w_to_l_ext = inl_w2l
                      g.local_w_to_l_ext = inl_lw2l
                      g.unfrozen_local_arrs = inl_unfrozen
                      g.movable_locals = inl_mov
                      g.moved_slots = inl_moved
                      let _ = inl_bfields
                      let _ = g.inline_stack.pop()
                      g.inline_depth = g.inline_depth - 1
                      return qval(out_reg, finfo.ret_ty)
                    }
                  None => ()
                }
              }
              let call_args : Array[String] = []
              let call_abis : Array[String] = []
              let mut j = 0
              while j < arg_vals.length() {
                let decl_pty = if j < finfo.param_tys.length() {
                  finfo.param_tys[j]
                } else {
                  arg_tys[j]
                }
                call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
                call_abis.push(qbe_abi_ty(decl_pty))
                j = j + 1
              }
              let ret_abi = qbe_abi_ty(finfo.ret_ty)
              let res = qbe_tmp(g)
              let sb = StringBuilder()
              sb.write_string(res)
              sb.write_string(" =")
              sb.write_string(ret_abi)
              sb.write_string(" call ")
              sb.write_string(qbe_local_fn_sym(g, name))
              sb.write_string("(")
              j = 0
              while j < call_args.length() {
                if j > 0 {
                  sb.write_string(", ")
                }
                sb.write_string(call_abis[j])
                sb.write_string(" ")
                sb.write_string(call_args[j])
                j = j + 1
              }
              let mut tpi = 0
              while tpi < finfo.decl.type_params.length() {
                if call_args.length() > 0 || tpi > 0 {
                  sb.write_string(", ")
                }
                let tp_ty = match subst.get(finfo.decl.type_params[tpi]) {
                  Some(t) => t
                  None => TError
                }
                sb.write_string("l ")
                sb.write_string(qbe_is_obj_flag(g, tp_ty))
                tpi = tpi + 1
              }
              sb.write_string(")")
              qbe_emit(g, sb.to_string())
              g.block_immut_fields = Map([])
              j = 0
              while j < arg_vals.length() {
                if !arg_borrowed[j] {
                  qbe_rc_dec(g, arg_vals[j], arg_tys[j])
                }
                j = j + 1
              }
              let concrete_ret = subst_ty(finfo.ret_ty, subst)
              let final_res = qbe_coerce_val(g, qval(res, finfo.ret_ty), concrete_ret)
              return qval(final_res, concrete_ret)
            }
            None => ()
          }
          match g.tc.extern_fns.get(name) {
            Some(einfo) => return qbe_emit_extern_fn_call(g, einfo, args)
            None => ()
          }
          match qbe_lookup_local(g, name) {
            Some(loc) => {
              let clo_v = qbe_tmp(g)
              qbe_emit(g, clo_v + " =l loadl " + loc.slot)
              qbe_emit(g, "call $pion_rc_inc(l " + clo_v + ")")
              let mut ptys : Array[Ty] = []
              let mut rty = TError
              match loc.ty {
                TFn(ps, rt) => {
                  ptys = ps
                  rty = rt
                }
                _ => ()
              }
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let mut i = 0
              while i < args.length() {
                let ep : Option[Ty] = if i < ptys.length() {
                  Some(ptys[i])
                } else {
                  None
                }
                let av = qbe_emit_expr(g, args[i], ep)
                arg_vals.push(av.reg)
                arg_tys.push(av.ty)
                i = i + 1
              }
              let res = qbe_emit_closure_call(g, clo_v, arg_vals, arg_tys)
              return qval(qbe_from_l(g, res, rty), rty)
            }
            None => qval("0", TError)
          }
        }
        EPath(qual, mem, _) => {
          if qual == "Double" && mem == "from_bits" {
            let bv = qbe_emit_expr(g, args[0], Some(TInt64))
            let bl = qbe_coerce_val(g, bv, TInt64)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d cast " + bl)
            return qval(r, TDouble)
          }
          if qual == "Float" && mem == "from_double" {
            let dv = qbe_emit_expr(g, args[0], Some(TDouble))
            let dd = qbe_coerce_val(g, dv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s truncd " + dd)
            return qval(r, TFloat)
          }
          if qual == "Float" && mem == "from_int" {
            let iv = qbe_emit_expr(g, args[0], Some(TInt))
            let iw = qbe_coerce_val(g, iv, TInt)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s swtof " + iw)
            return qval(r, TFloat)
          }
          if qual == "Float" && mem == "from_bits" {
            let bv = qbe_emit_expr(g, args[0], Some(TInt))
            let bw = qbe_coerce_val(g, bv, TInt)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s cast " + bw)
            return qval(r, TFloat)
          }
          if qual == "StringBuilder" && mem == "new" {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_strbuf_new(l 32)")
            return qval(r, TStringBuilder)
          }
          if qual == "Bytes" && mem == "new" {
            let lv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let ll = qbe_as_l(g, lv)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_bytes_new(l " + ll + ")")
            return qval(r, TBytes)
          }
          if qual == "Map" && mem == "new" {
            let mut kty = TString
            let mut vty = TError
            match expected {
              Some(TMap(k, v)) => {
                kty = k
                vty = v
              }
              _ => ()
            }
            let vo = qbe_is_obj_flag_w(g, vty)
            let new_fn = if qbe_map_key_is_int(kty) {
              "$pion_map_new_int"
            } else {
              "$pion_map_new"
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call " + new_fn + "(w " + vo + ")")
            return qval(r, TMap(kty, vty))
          }
          if qual == "Array" && mem == "new" {
            let elem = match expected {
              Some(TArray(e)) => e
              _ => TError
            }
            let eo = qbe_is_obj_flag_w(g, elem)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_arr_new(l 0, w " + eo + ")")
            return qval(r, TArray(elem))
          }
          if (qual == "Array" || qual == "FixedArray") && mem == "make" {
            let is_fixed = qual == "FixedArray"
            let exp_elem : Option[Ty] = match expected {
              Some(TArray(e)) => Some(e)
              Some(TFixedArray(e)) => Some(e)
              _ => None
            }
            let len_v = qbe_emit_expr(g, args[0], Some(TInt))
            let len_l = qbe_as_l(g, len_v)
            let init_v = qbe_emit_expr(g, args[1], exp_elem)
            let elem = match exp_elem {
              Some(e) => e
              None => init_v.ty
            }
            let coerced = qbe_coerce_val(g, init_v, elem)
            let init_l = qbe_as_l(g, qval(coerced, elem))
            let eo = qbe_is_obj_flag_w(g, elem)
            let arr = qbe_tmp(g)
            qbe_emit(g, arr + " =l call $pion_arr_new(l " + len_l + ", w " + eo + ")")
            let idx_slot = qbe_alloc_slot(g)
            let l_cond = qbe_lbl(g, "amk_c")
            let l_body = qbe_lbl(g, "amk_b")
            let l_end = qbe_lbl(g, "amk_e")
            qbe_emit(g, "storel 0, " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_cond)
            let ci = qbe_tmp(g)
            let cc = qbe_tmp(g)
            qbe_emit(g, ci + " =l loadl " + idx_slot)
            qbe_emit(g, cc + " =w csltl " + ci + ", " + len_l)
            qbe_emit_term(g, "jnz " + cc + ", " + l_body + ", " + l_end)
            qbe_emit_lbl(g, l_body)
            qbe_emit(g, "call $pion_arr_push(l " + arr + ", l " + init_l + ")")
            let ni = qbe_tmp(g)
            qbe_emit(g, ni + " =l add " + ci + ", 1")
            qbe_emit(g, "storel " + ni + ", " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_end)
            qbe_rc_dec(g, init_v.reg, init_v.ty)
            return qval(arr, if is_fixed { TFixedArray(elem) } else { TArray(elem) })
          }
          if qual == "FixedArray" && mem == "makei" {
            let exp_elem : Option[Ty] = match expected {
              Some(TFixedArray(e)) => Some(e)
              _ => None
            }
            let len_v = qbe_emit_expr(g, args[0], Some(TInt))
            let len_l = qbe_as_l(g, len_v)
            let exp_fn : Option[Ty] = match exp_elem {
              Some(e) => Some(TFn([TInt], e))
              None => None
            }
            let fn_v = qbe_emit_expr(g, args[1], exp_fn)
            let elem = match exp_elem {
              Some(e) => e
              None =>
                match fn_v.ty {
                  TFn(_, rt) => rt
                  _ => TError
                }
            }
            let eo = qbe_is_obj_flag_w(g, elem)
            let arr = qbe_tmp(g)
            qbe_emit(g, arr + " =l call $pion_arr_new(l " + len_l + ", w " + eo + ")")
            let idx_slot = qbe_alloc_slot(g)
            let l_cond = qbe_lbl(g, "fmi_c")
            let l_body = qbe_lbl(g, "fmi_b")
            let l_end = qbe_lbl(g, "fmi_e")
            qbe_emit(g, "storel 0, " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_cond)
            let ci = qbe_tmp(g)
            let cc = qbe_tmp(g)
            qbe_emit(g, ci + " =l loadl " + idx_slot)
            qbe_emit(g, cc + " =w csltl " + ci + ", " + len_l)
            qbe_emit_term(g, "jnz " + cc + ", " + l_body + ", " + l_end)
            qbe_emit_lbl(g, l_body)
            let iw = qbe_tmp(g)
            qbe_emit(g, iw + " =w copy " + ci)
            qbe_emit(g, "call $pion_rc_inc(l " + fn_v.reg + ")")
            let res_l = qbe_emit_closure_call(g, fn_v.reg, [iw], [TInt])
            if qbe_is_obj_ty(elem) {
              qbe_emit(g, "call $pion_arr_push_owned(l " + arr + ", l " + res_l + ")")
            } else {
              qbe_emit(g, "call $pion_arr_push(l " + arr + ", l " + res_l + ")")
            }
            let ni = qbe_tmp(g)
            qbe_emit(g, ni + " =l add " + ci + ", 1")
            qbe_emit(g, "storel " + ni + ", " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_end)
            qbe_rc_dec(g, fn_v.reg, fn_v.ty)
            return qval(arr, TFixedArray(elem))
          }
          if qual == "FixedArray" && mem == "from_array" {
            let exp_arr : Option[Ty] = match expected {
              Some(TFixedArray(e)) => Some(TArray(e))
              _ => None
            }
            let av = qbe_emit_expr(g, args[0], exp_arr)
            let elem = match av.ty {
              TArray(e) => e
              _ =>
                match expected {
                  Some(TFixedArray(e)) => e
                  _ => TError
                }
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_arr_copy(l " + av.reg + ")")
            qbe_rc_dec(g, av.reg, av.ty)
            return qval(r, TFixedArray(elem))
          }
          if qual == "Channel" && mem == "new" {
            let elem = match expected {
              Some(TChannel(e)) => e
              _ => TError
            }
            let cap_v = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let cap_l = qbe_as_l(g, cap_v)
            let eo = qbe_is_obj_flag_w(g, elem)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_chan_new(l " + cap_l + ", w " + eo + ")")
            return qval(r, TChannel(elem))
          }
          if qual == "Mutex" && mem == "new" {
            let exp_inner : Option[Ty] = match expected {
              Some(TMutex(e)) => Some(e)
              _ => None
            }
            let iv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], exp_inner)
            } else {
              qval("0", TError)
            }
            let vo = qbe_is_obj_flag_w(g, iv.ty)
            let il = qbe_as_l(g, iv)
            qbe_emit_deep_freeze(g, il, iv.ty)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_mutex_new(l " + il + ", w " + vo + ")")
            qbe_rc_dec(g, iv.reg, iv.ty)
            return qval(r, TMutex(iv.ty))
          }
          if qual == "AtomicInt" && mem == "new" {
            let iv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let il = qbe_as_l(g, iv)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_atomic_new(l " + il + ")")
            return qval(r, TAtomicInt)
          }
          if qual == "Option" || qual == "Result" || g.tc.enums.contains(qual) {
            return qbe_emit_variant_ctor(g, qual, mem, args, expected)
          }
          let mut target_finfo : Option[FnInfo] = None
          let mut target_sym = ""
          let mut target_pkg = ""
          let qp = split_qual_name(qual)
          let q_alias = qp.prefix
          let q_sub = qp.name
          if q_alias.length() > 0 {
            match resolve_alias_pkg(g.tc, q_alias) {
              Some(ipkg) => {
                if ipkg.tc.enums.contains(q_sub) {
                  return qbe_emit_variant_ctor(
                    g,
                    ipkg.name + "::" + q_sub,
                    mem,
                    args,
                    expected,
                  )
                }
                match ipkg.tc.methods.get(q_sub + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg.name, mi))
                    target_sym = qbe_ext_method_sym(ipkg.name, q_sub, mem)
                    target_pkg = ipkg.name
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
          match target_finfo {
            None =>
              match resolve_alias_pkg(g.tc, qual) {
                Some(ipkg) => {
                  match ipkg.tc.fns.get(mem) {
                    Some(fi) => {
                      target_finfo = Some(qualify_fn_info(ipkg.name, fi))
                      target_sym = qbe_ext_fn_sym(ipkg.name, mem)
                      target_pkg = ipkg.name
                    }
                    None =>
                      match ipkg.tc.extern_fns.get(mem) {
                        Some(ei) => return qbe_emit_extern_fn_call(g, ei, args)
                        None => ()
                      }
                  }
                  match target_finfo {
                    None =>
                      match ipkg.tc.variant_to_enum.get(mem) {
                        Some(en) =>
                          return qbe_emit_variant_ctor(
                            g,
                            ipkg.name + "::" + en,
                            mem,
                            args,
                            expected,
                          )
                        None => ()
                      }
                    Some(_) => ()
                  }
                }
                None => ()
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              if g.mono_pkg != "" {
                match g.tc.imported_pkgs.get(g.mono_pkg) {
                  Some(ipkg) => {
                    if ipkg.tc.enums.contains(qual) {
                      return qbe_emit_variant_ctor(
                        g,
                        ipkg.name + "::" + qual,
                        mem,
                        args,
                        expected,
                      )
                    }
                    match ipkg.tc.methods.get(qual + "::" + mem) {
                      Some(mi) => {
                        target_finfo = Some(qualify_fn_info(ipkg.name, mi))
                        target_sym = qbe_ext_method_sym(ipkg.name, qual, mem)
                        target_pkg = ipkg.name
                      }
                      None => ()
                    }
                  }
                  None => ()
                }
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              match qbe_lookup_method_info(g, qual, mem) {
                Some(minfo) => {
                  target_finfo = Some(minfo)
                  target_sym = qbe_method_call_sym(g, qual, mem)
                  let qpm = split_qual_name(qual)
                  if qpm.prefix != "" {
                    target_pkg = qpm.prefix
                  } else if g.mono_pkg != "" {
                    target_pkg = g.mono_pkg
                  }
                }
                None => ()
              }
            Some(_) => ()
          }
          match target_finfo {
            Some(minfo) => {
              let norm_args = resolve_call_args_qbe(minfo.decl.params, 0, args, sp)
              let subst : Map[String, Ty] = Map([])
              match expected {
                Some(et) => unify_tparams(minfo.ret_ty, et, subst)
                None => ()
              }
              let can_borrow = !qbe_args_have_assign(norm_args)
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let mut i = 0
              while i < norm_args.length() {
                match norm_args[i] {
                  EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                  _ => ()
                }
                let exp_p : Option[Ty] = if i < minfo.param_tys.length() {
                  qbe_generic_arg_expect(g, minfo, target_pkg, subst_ty(minfo.param_tys[i], subst), norm_args[i])
                } else {
                  None
                }
                let aa = qbe_emit_arg_maybe_borrow(g, norm_args[i], exp_p, can_borrow)
                let av = aa.qv
                if i < minfo.param_tys.length() {
                  unify_tparams(minfo.param_tys[i], av.ty, subst)
                }
                arg_vals.push(av.reg)
                arg_tys.push(av.ty)
                arg_borrowed.push(aa.borrowed)
                i = i + 1
              }
              if qbe_call_needs_mono(g, minfo, subst, target_pkg) {
                return qbe_emit_mono_call(
                  g,
                  target_sym,
                  minfo,
                  subst,
                  arg_vals,
                  arg_tys,
                  arg_borrowed,
                  target_pkg,
                )
              }
              let call_args : Array[String] = []
              let call_abis : Array[String] = []
              let mut j = 0
              while j < arg_vals.length() {
                let decl_pty = if j < minfo.param_tys.length() {
                  minfo.param_tys[j]
                } else {
                  arg_tys[j]
                }
                call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
                call_abis.push(qbe_abi_ty(decl_pty))
                j = j + 1
              }
              let ret_abi = qbe_abi_ty(minfo.ret_ty)
              let res = qbe_tmp(g)
              let sb = StringBuilder()
              sb.write_string(res)
              sb.write_string(" =")
              sb.write_string(ret_abi)
              sb.write_string(" call ")
              sb.write_string(target_sym)
              sb.write_string("(")
              j = 0
              while j < call_args.length() {
                if j > 0 {
                  sb.write_string(", ")
                }
                sb.write_string(call_abis[j])
                sb.write_string(" ")
                sb.write_string(call_args[j])
                j = j + 1
              }
              let mut tpi = 0
              while tpi < minfo.decl.type_params.length() {
                if call_args.length() > 0 || tpi > 0 {
                  sb.write_string(", ")
                }
                let tp_ty = match subst.get(minfo.decl.type_params[tpi]) {
                  Some(t) => t
                  None => TError
                }
                sb.write_string("l ")
                sb.write_string(qbe_is_obj_flag(g, tp_ty))
                tpi = tpi + 1
              }
              sb.write_string(")")
              qbe_emit(g, sb.to_string())
              g.block_immut_fields = Map([])
              j = 0
              while j < arg_vals.length() {
                if !arg_borrowed[j] {
                  qbe_rc_dec(g, arg_vals[j], arg_tys[j])
                }
                j = j + 1
              }
              let concrete_ret = subst_ty(minfo.ret_ty, subst)
              let final_res = qbe_coerce_val(g, qval(res, minfo.ret_ty), concrete_ret)
              return qval(final_res, concrete_ret)
            }
            None => qval("0", TError)
          }
        }
        _ => {
          let cv = qbe_emit_expr(g, callee, None)
          let mut ptys : Array[Ty] = []
          let mut rty = TError
          match cv.ty {
            TFn(ps, rt) => {
              ptys = ps
              rty = rt
            }
            _ => ()
          }
          let arg_vals : Array[String] = []
          let arg_tys : Array[Ty] = []
          let mut i = 0
          while i < args.length() {
            let ep : Option[Ty] = if i < ptys.length() {
              Some(ptys[i])
            } else {
              None
            }
            let av = qbe_emit_expr(g, args[i], ep)
            arg_vals.push(av.reg)
            arg_tys.push(av.ty)
            i = i + 1
          }
          let res = qbe_emit_closure_call(g, cv.reg, arg_vals, arg_tys)
          g.block_immut_fields = Map([])
          qval(qbe_from_l(g, res, rty), rty)
        }
      }
    }
    EField(obj, field_name, _) => {
      let mut cache_key = ""
      match obj {
        EIdent(lname, _) => {
          cache_key = lname + "." + field_name
          match g.promoted_fields.get(cache_key) {
            Some(pslot) =>
              match g.promoted_field_tys.get(cache_key) {
                Some(pty) => {
                  let r = qbe_load_local_slot(g, pslot, pty)
                  return qval(r, pty)
                }
                None => ()
              }
            None => ()
          }
          match g.hoisted_fields.get(cache_key) {
            Some(hv) => {
              qbe_rc_inc(g, hv.reg, hv.ty)
              return hv
            }
            None => ()
          }
          match g.block_immut_fields.get(cache_key) {
            Some(bv) => return bv
            None => ()
          }
        }
        _ => ()
      }
      let mut borrowed = false
      let mut ov = qval("0", TError)
      match obj {
        EIdent(lname, _) =>
          match qbe_lookup_local(g, lname) {
            Some(loc) =>
              match loc.ty {
                TStruct(_, _) | TTuple(_) => {
                  let r = qbe_tmp(g)
                  qbe_emit(g, r + " =l loadl " + loc.slot)
                  ov = qval(r, loc.ty)
                  borrowed = true
                }
                _ => ()
              }
            None => ()
          }
        EIndex(EIdent(aname, _), idx_expr, _) =>
          match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
            Some(ev) =>
              match ev.ty {
                TStruct(_, _) | TTuple(_) => {
                  ov = ev
                  borrowed = true
                }
                _ => ()
              }
            None => ()
          }
        _ => ()
      }
      if !borrowed {
        ov = qbe_emit_expr(g, obj, None)
      }
      match ov.ty {
        TTuple(elems) => {
          let idx = parse_tuple_index(field_name)
          if idx >= 0 && idx < elems.length() {
            let fty = elems[idx]
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + ov.reg + ", " + (idx * 8).to_string())
            let r = qbe_load_heap_slot(g, p, fty)
            qbe_rc_inc(g, r, fty)
            if !borrowed {
              qbe_rc_dec(g, ov.reg, ov.ty)
            }
            qval(r, fty)
          } else {
            if !borrowed {
              qbe_rc_dec(g, ov.reg, ov.ty)
            }
            qval("0", TError)
          }
        }
        TStruct(sname, sargs) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == field_name {
                  let fty = subst_ty(sinfo.field_tys[i], subst)
                  let p = qbe_tmp(g)
                  qbe_emit(g, p + " =l add " + ov.reg + ", " + (i * 8).to_string())
                  let r = qbe_load_heap_slot(g, p, fty)
                  qbe_rc_inc(g, r, fty)
                  if !borrowed {
                    qbe_rc_dec(g, ov.reg, ov.ty)
                  }
                  let res_val = qval(r, fty)
                  if borrowed && cache_key != "" && !sinfo.field_muts[i] {
                    let is_prim = match fty {
                      TInt | TInt64 | TDouble | TBool | TByte | TChar => true
                      _ => false
                    }
                    if is_prim {
                      g.block_immut_fields.set(cache_key, res_val)
                    }
                  }
                  return res_val
                }
                i = i + 1
              }
              if !borrowed {
                qbe_rc_dec(g, ov.reg, ov.ty)
              }
              qval("0", TError)
            }
            None => {
              if !borrowed {
                qbe_rc_dec(g, ov.reg, ov.ty)
              }
              qval("0", TError)
            }
          }
        _ => {
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval("0", TError)
        }
      }
    }
    EMethodCall(obj, method_name, args, _) => {
      g.block_immut_fields = Map([])
      let r = qbe_emit_method_call(g, obj, method_name, args, expected)
      g.block_immut_fields = Map([])
      r
    }
    EIndex(obj, idx, _) => {
      // Reuse already bounds-checked element pointer when inside `arr[idx] = ... arr[idx] ...`
      if g.assign_idx_arr != "" {
        match obj {
          EIdent(lname, _) =>
            if lname == g.assign_idx_arr && qbe_pure_idx_key(idx) == g.assign_idx_key {
              match qbe_lookup_local(g, lname) {
                Some(loc) =>
                  match loc.ty {
                    TArray(elem) | TFixedArray(elem) => {
                      let r = if qbe_is_int32_ty(elem) {
                        let rl = qbe_tmp(g)
                        let rw = qbe_tmp(g)
                        qbe_emit(g, rl + " =l loadl " + g.assign_idx_ep)
                        qbe_emit(g, rw + " =w copy " + rl)
                        g.w_to_l_ext.set(rw, rl)
                        rw
                      } else {
                        qbe_load_heap_slot(g, g.assign_idx_ep, elem)
                      }
                      return qval(r, elem)
                    }
                    _ => ()
                  }
                None => ()
              }
            }
          _ => ()
        }
      }
      let mut borrowed = false
      let mut ov = qval("0", TError)
      let mut arr_local_name = ""
      if !qbe_expr_has_assign(idx) {
        match obj {
          EIdent(lname, _) =>
            match qbe_lookup_local(g, lname) {
              Some(loc) =>
                match loc.ty {
                  TArray(_) | TFixedArray(_) => {
                    arr_local_name = lname
                    borrowed = true
                    if g.hoisted_arr_len.contains(lname) &&
                      g.hoisted_arr_dp.contains(lname) {
                      ov = qval("0", loc.ty)
                    } else {
                      let r = qbe_tmp(g)
                      qbe_emit(g, r + " =l loadl " + loc.slot)
                      ov = qval(r, loc.ty)
                    }
                  }
                  TString | TBytes => {
                    arr_local_name = lname
                    borrowed = true
                    let r = qbe_tmp(g)
                    qbe_emit(g, r + " =l loadl " + loc.slot)
                    ov = qval(r, loc.ty)
                  }
                  _ => ()
                }
              None => ()
            }
          EIndex(EIdent(outer, _), idx1, _) =>
            if !qbe_expr_has_assign(idx1) &&
              qbe_loop_has_no_calls_expr(idx) &&
              !qbe_expr_assigns_ident(idx, outer) {
              match qbe_lookup_local(g, outer) {
                Some(oloc) =>
                  match oloc.ty {
                    TArray(TArray(inner_elem)) => {
                      let outer_p = if g.hoisted_arr_len.contains(outer) &&
                        g.hoisted_arr_dp.contains(outer) {
                        "0"
                      } else {
                        let r = qbe_tmp(g)
                        qbe_emit(g, r + " =l loadl " + oloc.slot)
                        r
                      }
                      let iv1 = qbe_emit_expr(g, idx1, Some(TInt))
                      let il1 = qbe_as_l(g, iv1)
                      if !qbe_bce_expr_is_safe(g, outer, idx1) {
                        let olen = match g.hoisted_arr_len.get(outer) {
                          Some(hlen) => hlen
                          None => {
                            let t = qbe_tmp(g)
                            qbe_emit(g, t + " =l loadl " + outer_p)
                            t
                          }
                        }
                        let oob1 = qbe_tmp(g)
                        let l_oob1 = qbe_lbl(g, "arr_oob")
                        let l_ok1 = qbe_lbl(g, "arr_ok")
                        qbe_emit(g, oob1 + " =w cugel " + il1 + ", " + olen)
                        qbe_emit_term(g, "jnz " + oob1 + ", " + l_oob1 + ", " + l_ok1)
                        qbe_emit_lbl(g, l_oob1)
                        qbe_emit(g, "call $pion_panic_oob(l " + il1 + ", l " + olen + ")")
                        qbe_emit_term(g, "hlt")
                        qbe_emit_lbl(g, l_ok1)
                      }
                      let odp = match g.hoisted_arr_dp.get(outer) {
                        Some(hdp) => hdp
                        None => {
                          let dp_p = qbe_tmp(g)
                          let t = qbe_tmp(g)
                          qbe_emit(g, dp_p + " =l add " + outer_p + ", 24")
                          qbe_emit(g, t + " =l loadl " + dp_p)
                          t
                        }
                      }
                      let off1 = qbe_tmp(g)
                      let ep1 = qbe_tmp(g)
                      let inner_p = qbe_tmp(g)
                      qbe_emit(g, off1 + " =l shl " + il1 + ", 3")
                      qbe_emit(g, ep1 + " =l add " + odp + ", " + off1)
                      qbe_emit(g, inner_p + " =l loadl " + ep1)
                      ov = qval(inner_p, TArray(inner_elem))
                      borrowed = true
                    }
                    _ => ()
                  }
                None => ()
              }
            }
          _ => ()
        }
      }
      if !borrowed {
        ov = qbe_emit_expr(g, obj, None)
      }
      match ov.ty {
        TArray(elem) | TFixedArray(elem) => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let bce_safe = if arr_local_name != "" {
            qbe_bce_expr_is_safe(g, arr_local_name, idx)
          } else {
            false
          }
          if !bce_safe {
            let alen = match g.hoisted_arr_len.get(arr_local_name) {
              Some(hlen) => hlen
              None => {
                let t = qbe_tmp(g)
                qbe_emit(g, t + " =l loadl " + ov.reg)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, "arr_oob")
            let l_ok = qbe_lbl(g, "arr_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let dp = match g.hoisted_arr_dp.get(arr_local_name) {
            Some(hdp) => hdp
            None => {
              let dp_p = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
              qbe_emit(g, t + " =l loadl " + dp_p)
              t
            }
          }
          let off = qbe_tmp(g)
          let ep = qbe_tmp(g)
          qbe_emit(g, off + " =l shl " + il + ", 3")
          qbe_emit(g, ep + " =l add " + dp + ", " + off)
          let r = if qbe_is_int32_ty(elem) {
            let rl = qbe_tmp(g)
            let rw = qbe_tmp(g)
            qbe_emit(g, rl + " =l loadl " + ep)
            qbe_emit(g, rw + " =w copy " + rl)
            g.w_to_l_ext.set(rw, rl)
            rw
          } else {
            qbe_load_heap_slot(g, ep, elem)
          }
          qbe_rc_inc(g, r, elem)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(r, elem)
        }
        TMap(kty, vty) => {
          let kv = qbe_emit_expr(g, idx, Some(kty))
          let kl = qbe_as_l(g, kv)
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =l call $pion_map_get(l " + ov.reg + ", l " + kl + ")")
          qbe_rc_inc(g, r, vty)
          qbe_rc_dec(g, kv.reg, kv.ty)
          qbe_rc_dec(g, ov.reg, ov.ty)
          qval(qbe_from_l(g, r, vty), vty)
        }
        TString => {
          let bw = qbe_emit_str_code_unit_at(g, ov.reg, idx, arr_local_name)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bw, TInt)
        }
        TBytes => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let blen = qbe_tmp(g)
          let oob = qbe_tmp(g)
          let l_oob = qbe_lbl(g, "bytes_oob")
          let l_ok = qbe_lbl(g, "bytes_ok")
          qbe_emit(g, blen + " =l loadl " + ov.reg)
          qbe_emit(g, oob + " =w cugel " + il + ", " + blen)
          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
          qbe_emit_lbl(g, l_oob)
          qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + blen + ")")
          qbe_emit_term(g, "hlt")
          qbe_emit_lbl(g, l_ok)
          let dp_p = qbe_tmp(g)
          let dp = qbe_tmp(g)
          let ep = qbe_tmp(g)
          let bw = qbe_tmp(g)
          let bl = qbe_tmp(g)
          qbe_emit(g, dp_p + " =l add " + ov.reg + ", 16")
          qbe_emit(g, dp + " =l loadl " + dp_p)
          qbe_emit(g, ep + " =l add " + dp + ", " + il)
          qbe_emit(g, bw + " =w loadub " + ep)
          qbe_emit(g, bl + " =l extuw " + bw)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bl, TByte)
        }
        _ => {
          let _ = qbe_emit_expr(g, idx, None)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval("0", TError)
        }
      }
    }
    EArrayLit(elems, _) => {
      let is_fixed = match expected {
        Some(TFixedArray(_)) => true
        _ => false
      }
      let exp_elem : Option[Ty] = match expected {
        Some(TArray(e)) | Some(TFixedArray(e)) =>
          match e {
            TError => None
            _ => Some(e)
          }
        _ => None
      }
      let elem_vals : Array[String] = []
      let elem_tys : Array[Ty] = []
      let mut elem_ty = match exp_elem {
        Some(e) => e
        None => TError
      }
      let mut i = 0
      while i < elems.length() {
        let exp_cur : Option[Ty] = if i == 0 {
          exp_elem
        } else if qbe_is_untyped_option(elem_ty) {
          None
        } else {
          Some(elem_ty)
        }
        let ev = qbe_emit_expr(g, elems[i], exp_cur)
        if i == 0 {
          match exp_elem {
            Some(ee) =>
              if ty_has_unresolved(ee) && !ty_has_unresolved(ev.ty) {
                elem_ty = ev.ty
              }
            None => elem_ty = ev.ty
          }
        } else if (qbe_is_untyped_option(elem_ty) && !qbe_is_untyped_option(ev.ty)) ||
          (ty_has_unresolved(elem_ty) && !ty_has_unresolved(ev.ty)) {
          elem_ty = ev.ty
        }
        elem_vals.push(ev.reg)
        elem_tys.push(ev.ty)
        i = i + 1
      }
      let eo = qbe_is_obj_flag_w(g, elem_ty)
      let arr = qbe_tmp(g)
      qbe_emit(
        g,
        arr + " =l call $pion_arr_new(l " + elems.length().to_string() + ", w " + eo + ")",
      )
      i = 0
      while i < elem_vals.length() {
        let coerced = qbe_coerce_val(g, qval(elem_vals[i], elem_tys[i]), elem_ty)
        let el = qbe_as_l(g, qval(coerced, elem_ty))
        if qbe_is_obj_ty(elem_ty) {
          qbe_emit(g, "call $pion_arr_push_owned(l " + arr + ", l " + el + ")")
        } else {
          qbe_emit(g, "call $pion_arr_push(l " + arr + ", l " + el + ")")
          qbe_rc_dec(g, elem_vals[i], elem_tys[i])
        }
        i = i + 1
      }
      qval(arr, if is_fixed { TFixedArray(elem_ty) } else { TArray(elem_ty) })
    }
    EStructLit(sname, spread_opt, fields, _) => {
      let base_qv_opt : Option[QbeVal] = match spread_opt {
        Some(base_e) => Some(qbe_emit_expr(g, base_e, expected))
        None => None
      }
      let mut resolved_name = if sname != "" {
        sname
      } else {
        match base_qv_opt {
          Some(bv) =>
            match bv.ty {
              TStruct(bn, _) => bn
              _ => ""
            }
          None =>
            match expected {
              Some(TStruct(en, _)) => en
              _ => ""
            }
        }
      }
      if resolved_name != "" && !g.tc.structs.contains(resolved_name) {
        if g.mono_pkg != "" {
          if g.tc.structs.contains(g.mono_pkg + "::" + resolved_name) {
            resolved_name = g.mono_pkg + "::" + resolved_name
          } else {
            match g.tc.imported_pkgs.get(g.mono_pkg) {
              Some(ipkg) =>
                if ipkg.tc.structs.contains(resolved_name) {
                  resolved_name = ipkg.name + "::" + resolved_name
                }
              None => ()
            }
          }
        }
      }
      if resolved_name != "" && !g.tc.structs.contains(resolved_name) {
        let qp = split_qual_name(resolved_name)
        let q_alias = qp.prefix
        let q_st = qp.name
        if q_alias.length() > 0 {
          match resolve_alias_pkg(g.tc, q_alias) {
            Some(ipkg) =>
              if ipkg.tc.structs.contains(q_st) {
                resolved_name = ipkg.name + "::" + q_st
              }
            None => ()
          }
        }
      }
      match qbe_lookup_struct_info(g, resolved_name) {
        None => qval("0", TError)
        Some(sinfo) => {
          let subst : Map[String, Ty] = Map([])
          match expected {
            Some(TStruct(en, eargs)) =>
              if en == resolved_name {
                let mut k = 0
                while k < sinfo.decl.type_params.length() && k < eargs.length() {
                  match eargs[k] {
                    TError => ()
                    _ => subst.set(sinfo.decl.type_params[k], eargs[k])
                  }
                  k = k + 1
                }
              }
            _ => ()
          }
          match base_qv_opt {
            Some(bv) =>
              match bv.ty {
                TStruct(bn, bargs) =>
                  if bn == resolved_name {
                    let mut k = 0
                    while k < sinfo.decl.type_params.length() && k < bargs.length() {
                      subst.set(sinfo.decl.type_params[k], bargs[k])
                      k = k + 1
                    }
                  }
                _ => ()
              }
            None => ()
          }
          let n_fields = sinfo.field_names.length()
          let slot_vals : Array[String] = []
          let slot_tys : Array[Ty] = []
          let overridden : Array[Bool] = []
          let mut init_i = 0
          while init_i < n_fields {
            slot_vals.push(qbe_zero_reg(sinfo.field_tys[init_i]))
            slot_tys.push(sinfo.field_tys[init_i])
            overridden.push(false)
            init_i = init_i + 1
          }
          let mut fi = 0
          while fi < fields.length() {
            let f = fields[fi]
            let mut j = 0
            while j < n_fields {
              if sinfo.field_names[j] == f.name {
                let exp_f = subst_ty_mask_unbound(
                  sinfo.field_tys[j],
                  sinfo.decl.type_params,
                  subst,
                )
                let fv = qbe_emit_expr(g, f.value, Some(exp_f))
                unify_tparams(sinfo.field_tys[j], fv.ty, subst)
                slot_vals[j] = fv.reg
                slot_tys[j] = fv.ty
                overridden[j] = true
                break
              }
              j = j + 1
            }
            fi = fi + 1
          }
          match base_qv_opt {
            Some(bv) => {
              let mut bi = 0
              while bi < n_fields {
                if !overridden[bi] {
                  let concrete_ty = subst_ty(sinfo.field_tys[bi], subst)
                  let bp = qbe_tmp(g)
                  qbe_emit(g, bp + " =l add " + bv.reg + ", " + (bi * 8).to_string())
                  let loaded = qbe_load_heap_slot(g, bp, concrete_ty)
                  qbe_rc_inc(g, loaded, concrete_ty)
                  slot_vals[bi] = loaded
                  slot_tys[bi] = concrete_ty
                }
                bi = bi + 1
              }
              qbe_rc_dec(g, bv.reg, bv.ty)
            }
            None => ()
          }
          let payload_sz = if n_fields == 0 { 8 } else { n_fields * 8 }
          let drop_sym = if sinfo.decl.type_params.length() == 0 {
            let mut has_obj = false
            let mut k = 0
            while k < n_fields {
              if qbe_is_obj_ty(sinfo.field_tys[k]) {
                has_obj = true
                break
              }
              k = k + 1
            }
            if has_obj {
              if has_qual_sep(resolved_name) && !str_arr_contains(g.struct_order, resolved_name) {
                g.struct_order.push(resolved_name)
              }
              "$pion_drop_struct_" + qbe_sanitize_sym(resolved_name)
            } else {
              "0"
            }
          } else {
            let obj_slots : Array[Int] = []
            let tp_names : Array[String] = []
            let tp_slots : Array[Array[Int]] = []
            let mut k = 0
            while k < n_fields {
              let concrete_ty = subst_ty(
                subst_ty(sinfo.field_tys[k], subst),
                g.cur_type_subst,
              )
              if qbe_is_obj_ty(concrete_ty) || qbe_is_obj_ty(slot_tys[k]) {
                obj_slots.push(k)
              } else {
                match concrete_ty {
                  TParam(tn) =>
                    if qbe_tp_live(g, tn) {
                      qbe_add_tp_drop_slot(tp_names, tp_slots, tn, k)
                    }
                  _ =>
                    match slot_tys[k] {
                      TParam(tn) =>
                        if qbe_tp_live(g, tn) {
                          qbe_add_tp_drop_slot(tp_names, tp_slots, tn, k)
                        }
                      _ => ()
                    }
                }
              }
              k = k + 1
            }
            qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
          }
          let obj = qbe_tmp(g)
          let alloc_fn = if n_fields > 0 { "$pion_alloc_uninit" } else { "$pion_alloc" }
          qbe_emit(
            g,
            obj +
            " =l call " +
            alloc_fn +
            "(w " +
            payload_sz.to_string() +
            ", w 4, l " +
            drop_sym +
            ")",
          )
          let mut k = 0
          while k < n_fields {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + obj + ", " + (k * 8).to_string())
            let concrete_ty = subst_ty(
              subst_ty(sinfo.field_tys[k], subst),
              g.cur_type_subst,
            )
            let store_ty = if ty_has_unresolved(concrete_ty) {
              slot_tys[k]
            } else {
              concrete_ty
            }
            let coerced = qbe_coerce_val(g, qval(slot_vals[k], slot_tys[k]), store_ty)
            qbe_store_heap_slot(g, coerced, p, store_ty)
            k = k + 1
          }
          let targs : Array[Ty] = []
          let mut ti = 0
          while ti < sinfo.decl.type_params.length() {
            match subst.get(sinfo.decl.type_params[ti]) {
              Some(t) => targs.push(t)
              None => targs.push(TError)
            }
            ti = ti + 1
          }
          qval(obj, TStruct(resolved_name, targs))
        }
      }
    }
    ETuple(elems, _) => {
      let exp_elems : Array[Ty] = match expected {
        Some(TTuple(etys)) => etys
        _ => []
      }
      let vals : Array[String] = []
      let tys : Array[Ty] = []
      let obj_slots : Array[Int] = []
      let tp_names : Array[String] = []
      let tp_slots : Array[Array[Int]] = []
      let mut i = 0
      while i < elems.length() {
        let elem_exp : Option[Ty] = if i < exp_elems.length() {
          Some(exp_elems[i])
        } else {
          None
        }
        let ev = qbe_emit_expr(g, elems[i], elem_exp)
        let slot_ty = if i < exp_elems.length() && !ty_has_unresolved(exp_elems[i]) {
          exp_elems[i]
        } else {
          ev.ty
        }
        let coerced = qbe_coerce_val(g, ev, slot_ty)
        vals.push(coerced)
        tys.push(slot_ty)
        if qbe_is_obj_ty(slot_ty) {
          obj_slots.push(i)
        } else {
          match slot_ty {
            TParam(tn) =>
              if qbe_tp_live(g, tn) {
                qbe_add_tp_drop_slot(tp_names, tp_slots, tn, i)
              }
            _ => ()
          }
        }
        i = i + 1
      }
      let sz = if elems.length() == 0 { 8 } else { elems.length() * 8 }
      let drop_sym = qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
      let obj = qbe_tmp(g)
      let alloc_fn = if elems.length() > 0 {
        "$pion_alloc_uninit"
      } else {
        "$pion_alloc"
      }
      qbe_emit(
        g,
        obj +
        " =l call " +
        alloc_fn +
        "(w " +
        sz.to_string() +
        ", w 4, l " +
        drop_sym +
        ")",
      )
      i = 0
      while i < vals.length() {
        let p = qbe_tmp(g)
        qbe_emit(g, p + " =l add " + obj + ", " + (i * 8).to_string())
        qbe_store_heap_slot(g, vals[i], p, tys[i])
        i = i + 1
      }
      qval(obj, TTuple(tys))
    }
    EBlock(stmts, _) => {
      qbe_scope_push(g)
      let r = qbe_emit_stmts(g, stmts, expected)
      qbe_scope_pop(g)
      r
    }
    EIf(cond, then_stmts, else_opt, sp) => {
      match qbe_try_collect_if_switch(g, cond, then_stmts, else_opt) {
        Some(plan) =>
          match qbe_lookup_local(g, plan.vname) {
            Some(vloc) => {
              let vreg = qbe_load_local_slot(g, vloc.slot, TInt)
              return qbe_emit_int_dispatch(
                g,
                vreg,
                plan.arms,
                plan.default_opt,
                "",
                false,
                sp,
                expected,
                false,
              )
            }
            None => ()
          }
        None => ()
      }
      let l_then = qbe_lbl(g, "if_t")
      let l_else = qbe_lbl(g, "if_f")
      let l_end = qbe_lbl(g, "if_e")
      let has_is = qbe_expr_has_is(cond)
      match else_opt {
        None => {
          if has_is {
            qbe_scope_push(g)
            qbe_emit_cond_branch_bind(g, cond, l_then, l_end)
            qbe_emit_lbl(g, l_then)
          } else {
            qbe_emit_cond_branch(g, cond, l_then, l_end)
            qbe_emit_lbl(g, l_then)
            qbe_scope_push(g)
          }
          let tv = qbe_emit_stmts(g, then_stmts, None)
          if !g.block_term {
            qbe_rc_dec(g, tv.reg, tv.ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
          qval("0", TUnit)
        }
        Some(el) => {
          let branch_exp : Option[Ty] = match expected {
            Some(et) =>
              if !ty_has_unresolved(et) {
                expected
              } else {
                match qbe_probe_stmts_ty(g, then_stmts) {
                  Some(pt) =>
                    if !ty_has_unresolved(pt) {
                      Some(pt)
                    } else {
                      match qbe_probe_expr_ty(g, el) {
                        Some(pe) =>
                          if !ty_has_unresolved(pe) {
                            Some(pe)
                          } else {
                            expected
                          }
                        None => expected
                      }
                    }
                  None =>
                    match qbe_probe_expr_ty(g, el) {
                      Some(pe) =>
                        if !ty_has_unresolved(pe) {
                          Some(pe)
                        } else {
                          expected
                        }
                      None => expected
                    }
                }
              }
            None =>
              match qbe_probe_stmts_ty(g, then_stmts) {
                Some(pt) =>
                  if !ty_has_unresolved(pt) {
                    Some(pt)
                  } else {
                    match qbe_probe_expr_ty(g, el) {
                      Some(pe) =>
                        if !ty_has_unresolved(pe) {
                          Some(pe)
                        } else {
                          None
                        }
                      None => None
                    }
                  }
                None =>
                  match qbe_probe_expr_ty(g, el) {
                    Some(pe) =>
                      if !ty_has_unresolved(pe) {
                        Some(pe)
                      } else {
                        None
                      }
                    None => None
                  }
              }
          }
          if has_is {
            qbe_scope_push(g)
            qbe_emit_cond_branch_bind(g, cond, l_then, l_else)
            qbe_emit_lbl(g, l_then)
          } else {
            qbe_emit_cond_branch(g, cond, l_then, l_else)
            qbe_emit_lbl(g, l_then)
            qbe_scope_push(g)
          }
          let tv = qbe_emit_stmts(g, then_stmts, branch_exp)
          let then_term = g.block_term
          let then_ty = match branch_exp {
            Some(et) => et
            None => tv.ty
          }
          let saw_untyped_none = !then_term && qbe_is_untyped_option(then_ty)
          let mut res_slot = ""
          if !then_term {
            res_slot = qbe_alloc_slot_for(g, then_ty)
            qbe_store_local_slot(g, qbe_coerce_val(g, tv, then_ty), res_slot, then_ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_else)
          qbe_scope_push(g)
          let else_exp : Option[Ty] = match branch_exp {
            Some(_) => branch_exp
            None =>
              if !then_term && !saw_untyped_none && !ty_has_unresolved(tv.ty) {
                match tv.ty {
                  TNever => None
                  _ => Some(tv.ty)
                }
              } else {
                None
              }
          }
          let ev = qbe_emit_expr(g, el, else_exp)
          let else_term = g.block_term
          let out_ty = match branch_exp {
            Some(et) => et
            None =>
              if then_term {
                ev.ty
              } else if else_term {
                tv.ty
              } else {
                ty_prefer_concrete(tv.ty, ev.ty)
              }
          }
          if !else_term {
            if res_slot == "" {
              res_slot = qbe_alloc_slot_for(g, out_ty)
            }
            qbe_store_local_slot(g, qbe_coerce_val(g, ev, out_ty), res_slot, out_ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
          if then_term && else_term {
            qval("0", TNever)
          } else {
            let mut r = qbe_load_local_slot(g, res_slot, out_ty)
            if saw_untyped_none {
              match out_ty {
                TOption(oin) =>
                  if qbe_is_niche_opt_inner(oin) {
                    r = qbe_normalize_untyped_none(g, r)
                  }
                _ => ()
              }
            }
            qval(r, out_ty)
          }
        }
      }
    }
    EIs(scrut, pat, _) => {
      let sv = qbe_emit_expr(g, scrut, None)
      let res_slot = qbe_alloc_slot(g)
      let l_fail = qbe_lbl(g, "isv_f")
      let l_end = qbe_lbl(g, "isv_e")
      qbe_emit_pat_test(g, pat, sv.reg, sv.ty, l_fail)
      qbe_emit(g, "storel 1, " + res_slot)
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_fail)
      qbe_emit(g, "storel 0, " + res_slot)
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =l loadl " + res_slot)
      qval(r, TBool)
    }
    EMatch(scrut, arms, sp) => {
      match qbe_try_emit_map_get_match(g, scrut, arms, expected) {
        Some(qv) => return qv
        None => ()
      }
      // Dense guardless Int match -> balanced binary dispatch tree
      if arms.length() >= 6 {
        let mut is_int_scrut = false
        let mut scrut_slot_opt : Option[String] = None
        match scrut {
          EIdent(xname, _) =>
            match qbe_lookup_local(g, xname) {
              Some(loc) =>
                match loc.ty {
                  TInt => {
                    is_int_scrut = true
                    scrut_slot_opt = Some(loc.slot)
                  }
                  _ => ()
                }
              None => ()
            }
          _ => ()
        }
        if is_int_scrut {
          let sw_arms : Array[QbeSwitchArm] = []
          let seen_vals : Map[String, Bool] = Map([])
          let mut def_expr : Option[Expr] = None
          let mut def_bind = ""
          let mut ok_dispatch = true
          let mut ai = 0
          while ai < arms.length() {
            let arm = arms[ai]
            match arm.guard_expr {
              Some(_) => {
                ok_dispatch = false
                break
              }
              None => ()
            }
            match arm.pat {
              PInt(raw, _) => {
                let cv = qbe_parse_int64_lit(raw).to_int()
                let ck = cv.to_string()
                if seen_vals.contains(ck) {
                  ok_dispatch = false
                  break
                }
                seen_vals.set(ck, true)
                sw_arms.push(
                  QbeSwitchArm::{ cval: cv, stmts: [], expr_opt: Some(arm.body) },
                )
              }
              PWild(_) =>
                if ai == arms.length() - 1 {
                  def_expr = Some(arm.body)
                } else {
                  ok_dispatch = false
                  break
                }
              PIdent(bname, _) =>
                if ai == arms.length() - 1 {
                  def_expr = Some(arm.body)
                  def_bind = bname
                } else {
                  ok_dispatch = false
                  break
                }
              _ => {
                ok_dispatch = false
                break
              }
            }
            ai = ai + 1
          }
          if ok_dispatch && sw_arms.length() >= 6 {
            match scrut_slot_opt {
              Some(sslot) => {
                qbe_sort_switch_arms(sw_arms)
                let vreg = qbe_load_local_slot(g, sslot, TInt)
                let is_no_def = match def_expr {
                  None => true
                  Some(_) => false
                }
                return qbe_emit_int_dispatch(
                  g,
                  vreg,
                  sw_arms,
                  def_expr,
                  def_bind,
                  is_no_def,
                  sp,
                  expected,
                  false,
                )
              }
              None => ()
            }
          }
        }
      }
      qbe_scope_push(g)
      let mut scrut_borrowed = false
      let mut sv = qval("0", TError)
      match scrut {
        EIdent(xname, _) =>
          match qbe_lookup_local(g, xname) {
            Some(loc) => {
              let mut reassigned = false
              let mut ai = 0
              while ai < arms.length() {
                match arms[ai].guard_expr {
                  Some(ge) =>
                    if qbe_expr_assigns_ident(ge, xname) {
                      reassigned = true
                      break
                    }
                  None => ()
                }
                if qbe_expr_assigns_ident(arms[ai].body, xname) {
                  reassigned = true
                  break
                }
                ai = ai + 1
              }
              if !reassigned {
                let r = qbe_load_local_slot(g, loc.slot, loc.ty)
                sv = qval(r, loc.ty)
                scrut_borrowed = true
              }
            }
            None => ()
          }
        _ => ()
      }
      if !scrut_borrowed {
        sv = qbe_emit_expr(g, scrut, None)
      }
      let scrut_loc = qbe_define_local(g, "__match_scrut", sv.ty, !scrut_borrowed)
      qbe_store_local_slot(g, sv.reg, scrut_loc.slot, sv.ty)
      // Dense guardless single-layer TEnum match -> native QBE jtbl jump table
      if arms.length() >= 6 {
        match sv.ty {
          TEnum(ename, _) =>
            match qbe_lookup_enum_info(g, ename) {
              Some(einfo) => {
                let var_tags : Array[Int] = []
                let var_arm_idxs : Array[Int] = []
                let seen_tags : Map[String, Bool] = Map([])
                let mut def_arm_idx = -1
                let mut min_tag = 2147483647
                let mut max_tag = -1
                let mut ok_enum_jtbl = true
                let mut ai = 0
                while ai < arms.length() {
                  let arm = arms[ai]
                  match arm.guard_expr {
                    Some(_) => {
                      ok_enum_jtbl = false
                      break
                    }
                    None => ()
                  }
                  match arm.pat {
                    PVariant(_, vname, subs, _) => {
                      let mut simple_subs = true
                      let mut si = 0
                      while si < subs.length() {
                        match subs[si] {
                          PWild(_) | PIdent(_, _) => ()
                          _ => {
                            simple_subs = false
                            break
                          }
                        }
                        si = si + 1
                      }
                      if !simple_subs {
                        ok_enum_jtbl = false
                        break
                      }
                      let mut found_tag = -1
                      let mut vi = 0
                      while vi < einfo.variants.length() {
                        if einfo.variants[vi].name == vname {
                          found_tag = vi
                          break
                        }
                        vi = vi + 1
                      }
                      if found_tag < 0 {
                        ok_enum_jtbl = false
                        break
                      }
                      let tk = found_tag.to_string()
                      if seen_tags.contains(tk) {
                        ok_enum_jtbl = false
                        break
                      }
                      seen_tags.set(tk, true)
                      var_tags.push(found_tag)
                      var_arm_idxs.push(ai)
                      if found_tag < min_tag {
                        min_tag = found_tag
                      }
                      if found_tag > max_tag {
                        max_tag = found_tag
                      }
                    }
                    PWild(_) | PIdent(_, _) =>
                      if ai == arms.length() - 1 {
                        def_arm_idx = ai
                      } else {
                        ok_enum_jtbl = false
                        break
                      }
                    _ => {
                      ok_enum_jtbl = false
                      break
                    }
                  }
                  ai = ai + 1
                }
                let span = max_tag - min_tag + 1
                if ok_enum_jtbl &&
                  var_tags.length() >= 6 &&
                  span >= 6 &&
                  span <= 256 &&
                  span <= var_tags.length() * 2 {
                  let arm_lbls : Array[String] = []
                  let mut k = 0
                  while k < var_tags.length() {
                    arm_lbls.push(qbe_lbl(g, "em_arm"))
                    k = k + 1
                  }
                  let l_def = qbe_lbl(g, "em_def")
                  let l_end = qbe_lbl(g, "match_end")
                  let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                  let tag_l = qbe_tmp(g)
                  let tag_w = qbe_tmp(g)
                  qbe_emit(g, tag_l + " =l loadl " + cur_sv)
                  qbe_emit(g, tag_w + " =w copy " + tag_l)
                  let idx_w = if min_tag == 0 {
                    tag_w
                  } else {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =w sub " + tag_w + ", " + min_tag.to_string())
                    t
                  }
                  let tbl : Array[String] = []
                  k = 0
                  while k < span {
                    tbl.push(l_def)
                    k = k + 1
                  }
                  k = 0
                  while k < var_tags.length() {
                    tbl[var_tags[k] - min_tag] = arm_lbls[k]
                    k = k + 1
                  }
                  let sb = StringBuilder()
                  sb.write_string("jtbl ")
                  sb.write_string(idx_w)
                  sb.write_string(", ")
                  sb.write_string(l_def)
                  k = 0
                  while k < span {
                    sb.write_string(", ")
                    sb.write_string(tbl[k])
                    k = k + 1
                  }
                  qbe_emit_term(g, sb.to_string())
                  let mut res_slot = ""
                  let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
                    g,
                    arms,
                    Some(sv.ty),
                    expected,
                  )
                  let mut saw_untyped_none = false
                  k = 0
                  while k < var_tags.length() {
                    let arm = arms[var_arm_idxs[k]]
                    qbe_emit_lbl(g, arm_lbls[k])
                    qbe_scope_push(g)
                    let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                    qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, scrut_borrowed, arm.body)
                    let bv = qbe_emit_expr(g, arm.body, res_ty)
                    match res_ty {
                      None =>
                        match bv.ty {
                          TNever => ()
                          _ => {
                            if qbe_is_untyped_option(bv.ty) {
                              saw_untyped_none = true
                            }
                            res_ty = Some(bv.ty)
                          }
                        }
                      Some(rt) => {
                        if qbe_is_untyped_option(bv.ty) {
                          saw_untyped_none = true
                        }
                        res_ty = Some(ty_prefer_concrete(rt, bv.ty))
                      }
                    }
                    if !g.block_term {
                      let store_ty = match res_ty {
                        Some(t) => t
                        None => bv.ty
                      }
                      if res_slot == "" {
                        res_slot = qbe_alloc_slot_for(g, store_ty)
                      }
                      qbe_store_local_slot(
                        g,
                        qbe_coerce_val(g, bv, store_ty),
                        res_slot,
                        store_ty,
                      )
                    }
                    qbe_scope_pop(g)
                    qbe_emit_term(g, "jmp " + l_end)
                    k = k + 1
                  }
                  qbe_emit_lbl(g, l_def)
                  if def_arm_idx >= 0 {
                    let arm = arms[def_arm_idx]
                    qbe_scope_push(g)
                    let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                    qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, scrut_borrowed, arm.body)
                    let bv = qbe_emit_expr(g, arm.body, res_ty)
                    match res_ty {
                      None =>
                        match bv.ty {
                          TNever => ()
                          _ => {
                            if qbe_is_untyped_option(bv.ty) {
                              saw_untyped_none = true
                            }
                            res_ty = Some(bv.ty)
                          }
                        }
                      Some(rt) =>
                        if qbe_is_untyped_option(rt) && !qbe_is_untyped_option(bv.ty) {
                          match bv.ty {
                            TNever => ()
                            _ => res_ty = Some(bv.ty)
                          }
                        } else if qbe_is_untyped_option(bv.ty) {
                          saw_untyped_none = true
                        }
                    }
                    if !g.block_term {
                      let store_ty = match res_ty {
                        Some(t) => t
                        None => bv.ty
                      }
                      if res_slot == "" {
                        res_slot = qbe_alloc_slot_for(g, store_ty)
                      }
                      qbe_store_local_slot(
                        g,
                        qbe_coerce_val(g, bv, store_ty),
                        res_slot,
                        store_ty,
                      )
                    }
                    qbe_scope_pop(g)
                    qbe_emit_term(g, "jmp " + l_end)
                  } else {
                    let file_id = qbe_intern_cstring(g, sp.file)
                    let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
                    qbe_emit(
                      g,
                      "call $pion_panic(l $pion_cstr_" +
                      msg_id.to_string() +
                      ", l $pion_cstr_" +
                      file_id.to_string() +
                      ", w " +
                      sp.line.to_string() +
                      ")",
                    )
                    qbe_emit_term(g, "jmp " + l_end)
                  }
                  qbe_emit_lbl(g, l_end)
                  qbe_scope_pop(g)
                  let final_ty = match res_ty {
                    Some(t) => t
                    None => TUnit
                  }
                  if res_slot == "" {
                    return qval(qbe_zero_reg(final_ty), final_ty)
                  } else {
                    let mut r = qbe_load_local_slot(g, res_slot, final_ty)
                    if saw_untyped_none {
                      match final_ty {
                        TOption(oin) =>
                          if qbe_is_niche_opt_inner(oin) {
                            r = qbe_normalize_untyped_none(g, r)
                          }
                        _ => ()
                      }
                    }
                    return qval(r, final_ty)
                  }
                }
              }
              None => ()
            }
          _ => ()
        }
      }
      let mut res_slot = ""
      let l_end = qbe_lbl(g, "match_end")
      let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
        g,
        arms,
        Some(sv.ty),
        expected,
      )
      let mut saw_untyped_none = false
      let mut i = 0
      while i < arms.length() {
        let arm = arms[i]
        let l_next = qbe_lbl(g, "match_next")
        let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
        qbe_emit_pat_test(g, arm.pat, cur_sv, sv.ty, l_next)
        qbe_scope_push(g)
        let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
        let arm_allow_borrow = match arm.guard_expr {
          Some(_) => false
          None => scrut_borrowed
        }
        qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, arm_allow_borrow, arm.body)
        match arm.guard_expr {
          Some(ge) => {
            let l_body = qbe_lbl(g, "match_guard_ok")
            let l_gfail = qbe_lbl(g, "match_guard_fail")
            qbe_emit_cond_branch(g, ge, l_body, l_gfail)
            qbe_emit_lbl(g, l_gfail)
            let cur_sc = g.scopes[g.scopes.length() - 1]
            qbe_release_scope_locals(g, cur_sc)
            qbe_emit_term(g, "jmp " + l_next)
            qbe_emit_lbl(g, l_body)
          }
          None => ()
        }
        let bv = qbe_emit_expr(g, arm.body, res_ty)
        match res_ty {
          None =>
            match bv.ty {
              TNever => ()
              _ => {
                if qbe_is_untyped_option(bv.ty) {
                  saw_untyped_none = true
                }
                res_ty = Some(bv.ty)
              }
            }
          Some(rt) => {
            if qbe_is_untyped_option(bv.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(ty_prefer_concrete(rt, bv.ty))
          }
        }
        if !g.block_term {
          let store_ty = match res_ty {
            Some(t) => t
            None => bv.ty
          }
          if res_slot == "" {
            res_slot = qbe_alloc_slot_for(g, store_ty)
          }
          qbe_store_local_slot(g, qbe_coerce_val(g, bv, store_ty), res_slot, store_ty)
        }
        qbe_scope_pop(g)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_next)
        i = i + 1
      }
      let file_id = qbe_intern_cstring(g, sp.file)
      let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
      qbe_emit(
        g,
        "call $pion_panic(l $pion_cstr_" +
        msg_id.to_string() +
        ", l $pion_cstr_" +
        file_id.to_string() +
        ", w " +
        sp.line.to_string() +
        ")",
      )
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      qbe_scope_pop(g)
      let final_ty = match res_ty {
        Some(t) => t
        None => TUnit
      }
      if res_slot == "" {
        qval(qbe_zero_reg(final_ty), final_ty)
      } else {
        let mut r = qbe_load_local_slot(g, res_slot, final_ty)
        if saw_untyped_none {
          match final_ty {
            TOption(oin) =>
              if qbe_is_niche_opt_inner(oin) {
                r = qbe_normalize_untyped_none(g, r)
              }
            _ => ()
          }
        }
        qval(r, final_ty)
      }
    }
    EClosure(params, ret_te, body, sp) => {
      let cres = qbe_emit_closure_obj(g, params, ret_te, body, false, expected, sp)
      qval(cres.env, cres.ty)
    }
    EScope(w_expr, f_expr, _) => {
      let wv = qbe_emit_expr(g, w_expr, Some(TWorld))
      qbe_rc_dec(g, wv.reg, wv.ty)
      let sc = qbe_tmp(g)
      qbe_emit(g, sc + " =l call $pion_scope_begin()")
      match f_expr {
        EClosure(params, _, body, _) => {
          qbe_scope_push(g)
          if params.length() >= 1 {
            let sloc = qbe_define_local(g, params[0].name, TScope, false)
            qbe_emit(g, "storel " + sc + ", " + sloc.slot)
          }
          let bv = qbe_emit_stmts(g, body, Some(TUnit))
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
        }
        _ => {
          let fv = qbe_emit_expr(g, f_expr, Some(TFn([TScope], TUnit)))
          qbe_emit(g, "call $pion_rc_inc(l " + sc + ")")
          let _ = qbe_emit_closure_call(g, fv.reg, [sc], [TScope])
        }
      }
      qbe_emit(g, "call $pion_scope_end(l " + sc + ")")
      qval("0", TUnit)
    }
    ESpawn(s_expr, f_expr, _) => {
      let sv = qbe_emit_expr(g, s_expr, Some(TScope))
      match f_expr {
        EClosure(params, ret_te, body, sp) => {
          let cres = qbe_emit_closure_obj(g, params, ret_te, body, true, Some(TFn([], TUnit)), sp)
          qbe_emit(
            g,
            "call $pion_scope_spawn(l " +
            sv.reg +
            ", l " +
            cres.fn_sym +
            ", l " +
            cres.env +
            ")",
          )
          qbe_emit(g, "call $pion_rc_dec(l " + cres.env + ")")
        }
        _ => {
          let fv = qbe_emit_expr(g, f_expr, Some(TFn([], TUnit)))
          let fn_ptr = qbe_tmp(g)
          qbe_emit(g, fn_ptr + " =l loadl " + fv.reg)
          qbe_emit(
            g,
            "call $pion_scope_spawn(l " + sv.reg + ", l " + fn_ptr + ", l " + fv.reg + ")",
          )
          qbe_emit(g, "call $pion_rc_dec(l " + fv.reg + ")")
        }
      }
      qbe_rc_dec(g, sv.reg, sv.ty)
      qval("0", TUnit)
    }
  }
}

///|
fn qbe_stmts_assigns_ident_from(
  stmts : Array[Stmt],
  start_idx : Int,
  name : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if qbe_expr_assigns_ident(init, name) {
          return true
        }
        if lname == name {
          return false
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if qbe_expr_assigns_ident(init, name) {
          return true
        }
        if str_arr_contains(lnames, name) {
          return false
        }
      }
      _ =>
        if qbe_stmt_assigns_ident(stmts[i], name) {
          return true
        }
    }
    i = i + 1
  }
  false
}

///|
fn qbe_is_pure_readonly_method(mname : String) -> Bool {
  mname == "length" ||
  mname == "is_empty" ||
  mname == "byte_at" ||
  mname == "starts_with" ||
  mname == "ends_with" ||
  mname == "contains" ||
  mname == "index_of" ||
  mname == "slice" ||
  mname == "trim" ||
  mname == "to_int" ||
  mname == "to_int64" ||
  mname == "to_double" ||
  mname == "to_string"
}

///|
/// Conservative check: returns true if `e` may invoke any mutating container method
/// or user function call (excluding enum/variant constructors and pure read-only methods).
fn qbe_expr_has_any_mut_call(g : QbeGen, e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_any_mut_call(g, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_any_mut_call(g, l) || qbe_expr_has_any_mut_call(g, r)
    ECall(callee, args, _) => {
      let is_pure_ctor = match callee {
        EIdent(cname, _) =>
          !g.tc.fns.contains(cname) &&
          (cname == "Some" || cname == "None" || cname == "Ok" || cname == "Err" || g.tc.variant_to_enum.contains(cname))
        EPath(prefix, item, _) =>
          match g.tc.enums.get(prefix) {
            Some(_) => true
            None =>
              match g.tc.imported_pkgs.get(prefix) {
                Some(ipkg) => !ipkg.tc.fns.contains(item) && ipkg.tc.variant_to_enum.contains(item)
                None => false
              }
          }
        _ => false
      }
      if !is_pure_ctor {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_mut_call(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if !qbe_is_pure_readonly_method(mname) {
        return true
      }
      if qbe_expr_has_any_mut_call(g, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_mut_call(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_any_mut_call(g, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_any_mut_call(g, b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_any_mut_call(g, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_any_mut_call(g, stmts, 0)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_any_mut_call(g, cond) || qbe_stmts_has_any_mut_call(g, then_stmts, 0) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_any_mut_call(g, el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_any_mut_call(g, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_any_mut_call(g, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_any_mut_call(g, ge) { return true }
          None => ()
        }
        if qbe_expr_has_any_mut_call(g, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) => true
  }
}

///|
fn qbe_stmt_has_any_mut_call(g : QbeGen, s : Stmt) -> Bool {
  match s {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
      qbe_expr_has_any_mut_call(g, init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_any_mut_call(g, lhs) || qbe_expr_has_any_mut_call(g, rhs)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_has_any_mut_call(g, cond) || qbe_stmts_has_any_mut_call(g, body, 0)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_has_any_mut_call(g, init_s) ||
      qbe_expr_has_any_mut_call(g, cond) ||
      qbe_stmt_has_any_mut_call(g, step_s) ||
      qbe_stmts_has_any_mut_call(g, body, 0)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_any_mut_call(g, start_e) ||
      qbe_expr_has_any_mut_call(g, end_e) ||
      qbe_stmts_has_any_mut_call(g, body, 0)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_any_mut_call(g, iter_e) || qbe_stmts_has_any_mut_call(g, body, 0)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_any_mut_call(g, e)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_any_mut_call(g, c) || qbe_expr_has_any_mut_call(g, m)
    SExpr(e, _) => qbe_expr_has_any_mut_call(g, e)
  }
}

///|
fn qbe_stmts_has_any_mut_call(g : QbeGen, stmts : Array[Stmt], start_idx : Int) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    if qbe_stmt_has_any_mut_call(g, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Conservative stability check for `base.fname` (struct field or array field).
fn qbe_field_base_is_stable_expr(
  e : Expr,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != base
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_field_base_is_stable_expr(inner, base, fname, allow_field_read)
    EBinary(_, l, r, _) =>
      qbe_field_base_is_stable_expr(l, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(r, base, fname, allow_field_read)
    EField(obj, f, _) =>
      match obj {
        EIdent(n, _) =>
          if n == base {
            f != fname || allow_field_read
          } else {
            true
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    EIndex(obj, idx, _) => {
      if !qbe_field_base_is_stable_expr(idx, base, fname, allow_field_read) {
        return false
      }
      match obj {
        EField(EIdent(n, _), f, _) =>
          if n == base && f == fname {
            true
          } else {
            qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    }
    EMethodCall(obj, mname, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_field_base_is_stable_expr(args[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      match obj {
        EField(EIdent(n, _), f, _) =>
          if n == base && f == fname {
            mname == "length" && args.length() == 0
          } else {
            qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    }
    ECall(callee, args, _) => {
      if !qbe_field_base_is_stable_expr(callee, base, fname, allow_field_read) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_field_base_is_stable_expr(args[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_field_base_is_stable_expr(elems[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_field_base_is_stable_expr(b, base, fname, allow_field_read) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_field_base_is_stable_expr(fields[i].value, base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_field_base_is_stable_stmts(stmts, 0, base, fname, allow_field_read)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) ||
        !qbe_field_base_is_stable_stmts(then_stmts, 0, base, fname, allow_field_read) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_field_base_is_stable_expr(el, base, fname, allow_field_read)
      }
    }
    EIs(scrut, _, _) => qbe_field_base_is_stable_expr(scrut, base, fname, allow_field_read)
    EMatch(scrut, arms, _) => {
      if !qbe_field_base_is_stable_expr(scrut, base, fname, allow_field_read) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, base) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_field_base_is_stable_expr(ge, base, fname, allow_field_read) {
                return false
              }
            None => ()
          }
          if !qbe_field_base_is_stable_expr(arms[i].body, base, fname, allow_field_read) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      !qbe_expr_mentions_ident(e, base)
  }
}

///|
fn qbe_field_base_is_stable_stmt(
  s : Stmt,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
      qbe_field_base_is_stable_expr(init, base, fname, allow_field_read)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_field_base_is_stable_expr(rhs, base, fname, allow_field_read) {
        return false
      }
      match lhs {
        EIdent(n, _) => n != base
        EField(EIdent(n, _), f, _) => !(n == base && f == fname)
        EIndex(EField(EIdent(n, _), f, _), _, _) => !(n == base && f == fname)
        _ => qbe_field_base_is_stable_expr(lhs, base, fname, allow_field_read)
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_field_base_is_stable_stmt(init_s, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmt(step_s, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_field_base_is_stable_expr(start_e, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(end_e, base, fname, allow_field_read) &&
      (vname == base || qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_field_base_is_stable_expr(iter_e, base, fname, allow_field_read) &&
      (vname == base || qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_field_base_is_stable_expr(e, base, fname, allow_field_read)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_field_base_is_stable_expr(c, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(m, base, fname, allow_field_read)
    SExpr(e, _) => qbe_field_base_is_stable_expr(e, base, fname, allow_field_read)
  }
}

///|
fn qbe_field_base_is_stable_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_field_base_is_stable_expr(init, base, fname, allow_field_read) {
          return false
        }
        if lname == base {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_field_base_is_stable_expr(init, base, fname, allow_field_read) {
          return false
        }
        if str_arr_contains(lnames, base) {
          return true
        }
      }
      _ =>
        if !qbe_field_base_is_stable_stmt(stmts[i], base, fname, allow_field_read) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
fn qbe_try_emit_borrowed_arr_elem_let(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
) -> Bool {
  match stmts[idx] {
    SLet(bname, is_mut, ty_expr, EIndex(EIdent(aname, _), idx_expr, _), _) => {
      if is_mut || bname == "_" || bname == aname || qbe_expr_has_assign(idx_expr) {
        return false
      }
      match qbe_lookup_local(g, aname) {
        Some(aloc) =>
          match aloc.ty {
            TArray(elem) | TFixedArray(elem) => {
              if !qbe_is_obj_ty(elem) {
                return false
              }
              if !qbe_arr_is_stable_stmts(stmts, idx + 1, aname, false) {
                return false
              }
              if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                return false
              }
              let final_ty = match ty_expr {
                TyMissing(_) => elem
                _ => qbe_resolve_type(g, ty_expr)
              }
              let arr_reg = if g.hoisted_arr_len.contains(aname) &&
                g.hoisted_arr_dp.contains(aname) {
                "0"
              } else {
                let r = qbe_tmp(g)
                qbe_emit(g, r + " =l loadl " + aloc.slot)
                r
              }
              let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
              let il = qbe_as_l(g, iv)
              let bce_safe = qbe_bce_expr_is_safe(g, aname, idx_expr)
              if !bce_safe {
                let alen = match g.hoisted_arr_len.get(aname) {
                  Some(hlen) => hlen
                  None => {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =l loadl " + arr_reg)
                    t
                  }
                }
                let oob = qbe_tmp(g)
                let l_oob = qbe_lbl(g, "arr_oob")
                let l_ok = qbe_lbl(g, "arr_ok")
                qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                qbe_emit_lbl(g, l_oob)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok)
              }
              let dp = match g.hoisted_arr_dp.get(aname) {
                Some(hdp) => hdp
                None => {
                  let dp_p = qbe_tmp(g)
                  let t = qbe_tmp(g)
                  qbe_emit(g, dp_p + " =l add " + arr_reg + ", 24")
                  qbe_emit(g, t + " =l loadl " + dp_p)
                  t
                }
              }
              let off = qbe_tmp(g)
              let ep = qbe_tmp(g)
              qbe_emit(g, off + " =l shl " + il + ", 3")
              qbe_emit(g, ep + " =l add " + dp + ", " + off)
              let r = qbe_load_heap_slot(g, ep, elem)
              let loc = qbe_define_local(g, bname, final_ty, false)
              qbe_store_local_slot(g, qbe_coerce_val(g, qval(r, elem), final_ty), loc.slot, final_ty)
              true
            }
            _ => false
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EIndex(EField(EIdent(base, _), fname, _), idx_expr, _), _) => {
      if is_mut || bname == "_" || bname == base || qbe_expr_has_assign(idx_expr) {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          match bloc.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      match fty {
                        TArray(elem) | TFixedArray(elem) => {
                          if !qbe_is_obj_ty(elem) {
                            return false
                          }
                          if !qbe_field_base_is_stable_stmts(stmts, idx + 1, base, fname, false) {
                            return false
                          }
                          if qbe_stmts_has_any_mut_call(g, stmts, idx + 1) {
                            return false
                          }
                          if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                            return false
                          }
                          let final_ty = match ty_expr {
                            TyMissing(_) => elem
                            _ => qbe_resolve_type(g, ty_expr)
                          }
                          let mut arr_reg = ""
                          if !sinfo.field_muts[fi] {
                            let fkey = base + "." + fname
                            match g.hoisted_fields.get(fkey) {
                              Some(hv) => arr_reg = hv.reg
                              None =>
                                match g.block_immut_fields.get(fkey) {
                                  Some(bv) => arr_reg = bv.reg
                                  None => ()
                                }
                            }
                          }
                          if arr_reg == "" {
                            let obj_p = qbe_tmp(g)
                            let fp = qbe_tmp(g)
                            let fv = qbe_tmp(g)
                            qbe_emit(g, obj_p + " =l loadl " + bloc.slot)
                            qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                            qbe_emit(g, fv + " =l loadl " + fp)
                            arr_reg = fv
                          }
                          let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
                          let il = qbe_as_l(g, iv)
                          let alen = qbe_tmp(g)
                          qbe_emit(g, alen + " =l loadl " + arr_reg)
                          let oob = qbe_tmp(g)
                          let l_oob = qbe_lbl(g, "arr_oob")
                          let l_ok = qbe_lbl(g, "arr_ok")
                          qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                          qbe_emit_lbl(g, l_oob)
                          qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                          qbe_emit_term(g, "hlt")
                          qbe_emit_lbl(g, l_ok)
                          let dp_p = qbe_tmp(g)
                          let dp = qbe_tmp(g)
                          qbe_emit(g, dp_p + " =l add " + arr_reg + ", 24")
                          qbe_emit(g, dp + " =l loadl " + dp_p)
                          let off = qbe_tmp(g)
                          let ep = qbe_tmp(g)
                          qbe_emit(g, off + " =l shl " + il + ", 3")
                          qbe_emit(g, ep + " =l add " + dp + ", " + off)
                          let r = qbe_load_heap_slot(g, ep, elem)
                          let loc = qbe_define_local(g, bname, final_ty, false)
                          qbe_store_local_slot(g, qbe_coerce_val(g, qval(r, elem), final_ty), loc.slot, final_ty)
                          return true
                        }
                        _ => return false
                      }
                    }
                    fi = fi + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EField(EIdent(base, _), fname, _), _) => {
      if is_mut || bname == "_" || bname == base {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          match bloc.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      if !qbe_is_obj_ty(fty) {
                        return false
                      }
                      let final_ty = match ty_expr {
                        TyMissing(_) => fty
                        _ => qbe_resolve_type(g, ty_expr)
                      }
                      match final_ty {
                        TDynTrait(_) => return false
                        _ => ()
                      }
                      if sinfo.field_muts[fi] {
                        if !qbe_field_base_is_stable_stmts(stmts, idx + 1, base, fname, true) ||
                          qbe_stmts_has_any_mut_call(g, stmts, idx + 1) {
                          return false
                        }
                      } else if qbe_stmts_assigns_ident_from(stmts, idx + 1, base) {
                        return false
                      }
                      if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                        return false
                      }
                      let mut fv = ""
                      if !sinfo.field_muts[fi] {
                        let fkey = base + "." + fname
                        match g.hoisted_fields.get(fkey) {
                          Some(hv) => fv = hv.reg
                          None =>
                            match g.block_immut_fields.get(fkey) {
                              Some(bv) => fv = bv.reg
                              None => ()
                            }
                        }
                      }
                      if fv == "" {
                        let obj_p = qbe_tmp(g)
                        let fp = qbe_tmp(g)
                        qbe_emit(g, obj_p + " =l loadl " + bloc.slot)
                        qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                        fv = qbe_load_heap_slot(g, fp, fty)
                      }
                      let loc = qbe_define_local(g, bname, final_ty, false)
                      qbe_store_local_slot(g, qbe_coerce_val(g, qval(fv, fty), final_ty), loc.slot, final_ty)
                      return true
                    }
                    fi = fi + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EField(EField(EIdent(base, _), f1, _), f2, _), _) => {
      if is_mut || bname == "_" || bname == base {
        return false
      }
      if qbe_stmts_assigns_ident_from(stmts, idx + 1, base) {
        return false
      }
      if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          match bloc.ty {
            TStruct(s1, a1) =>
              match qbe_lookup_struct_info(g, s1) {
                Some(si1) => {
                  let sub1 = make_subst(si1.decl.type_params, a1)
                  let mut fi1 = 0
                  while fi1 < si1.field_names.length() {
                    if si1.field_names[fi1] == f1 {
                      if si1.field_muts[fi1] {
                        return false
                      }
                      let t1 = subst_ty(si1.field_tys[fi1], sub1)
                      match t1 {
                        TStruct(s2, a2) =>
                          match qbe_lookup_struct_info(g, s2) {
                            Some(si2) => {
                              let sub2 = make_subst(si2.decl.type_params, a2)
                              let mut fi2 = 0
                              while fi2 < si2.field_names.length() {
                                if si2.field_names[fi2] == f2 {
                                  if si2.field_muts[fi2] {
                                    return false
                                  }
                                  let fty = subst_ty(si2.field_tys[fi2], sub2)
                                  if !qbe_is_obj_ty(fty) {
                                    return false
                                  }
                                  let final_ty = match ty_expr {
                                    TyMissing(_) => fty
                                    _ => qbe_resolve_type(g, ty_expr)
                                  }
                                  match final_ty {
                                    TDynTrait(_) => return false
                                    _ => ()
                                  }
                                  let p0 = qbe_tmp(g)
                                  let fp1 = qbe_tmp(g)
                                  let p1 = qbe_tmp(g)
                                  let fp2 = qbe_tmp(g)
                                  qbe_emit(g, p0 + " =l loadl " + bloc.slot)
                                  qbe_emit(g, fp1 + " =l add " + p0 + ", " + (fi1 * 8).to_string())
                                  qbe_emit(g, p1 + " =l loadl " + fp1)
                                  qbe_emit(g, fp2 + " =l add " + p1 + ", " + (fi2 * 8).to_string())
                                  let fv = qbe_load_heap_slot(g, fp2, fty)
                                  let loc = qbe_define_local(g, bname, final_ty, false)
                                  qbe_store_local_slot(g, qbe_coerce_val(g, qval(fv, fty), final_ty), loc.slot, final_ty)
                                  return true
                                }
                                fi2 = fi2 + 1
                              }
                              return false
                            }
                            None => return false
                          }
                        _ => return false
                      }
                    }
                    fi1 = fi1 + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
        None => false
      }
    }
    _ => false
  }
}

///|
fn qbe_try_emit_while_bce_versioned(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() == 0 || body.length() > 16 || qbe_stmts_has_nested_loop(body) {
    return false
  }
  let mut iv = ""
  let mut bound_is_lit = false
  let mut bound_lit = 0L
  let mut bound_name = ""
  let mut bound_hoisted_reg = ""
  let mut extra_cond : Option[Expr] = None
  let lt_cond = match cond {
    EBinary("&&", lhs, rhs, _) => {
      extra_cond = Some(rhs)
      lhs
    }
    _ => cond
  }
  match lt_cond {
    EBinary("<", EIdent(iv_n, _), bound_e, _) => {
      iv = iv_n
      match bound_e {
        EInt(raw, _) => {
          bound_is_lit = true
          bound_lit = qbe_parse_int64_lit(raw).to_int().to_int64()
        }
        EIdent(bn, _) => bound_name = bn
        EField(EIdent(bv, _), bf, _) =>
          match g.hoisted_fields.get(bv + "." + bf) {
            Some(hv) =>
              if qbe_is_int32_ty(hv.ty) {
                bound_hoisted_reg = hv.reg
              } else {
                return false
              }
            None => return false
          }
        _ => return false
      }
    }
    _ => return false
  }
  let iv_slot = match qbe_lookup_local(g, iv) {
    Some(iloc) =>
      if qbe_is_int32_ty(iloc.ty) {
        iloc.slot
      } else {
        return false
      }
    None => return false
  }
  if !qbe_stmt_is_inc_by_one(body[body.length() - 1], iv) {
    return false
  }
  let mut bi = 0
  while bi < body.length() - 1 {
    if qbe_stmt_assigns_ident(body[bi], iv) || qbe_stmt_rebinds_ident(body[bi], iv) {
      return false
    }
    bi = bi + 1
  }
  match extra_cond {
    Some(ec) =>
      if qbe_expr_assigns_ident(ec, iv) || qbe_expr_rebinds_ident(ec, iv) {
        return false
      }
    None => ()
  }
  let mut bound_slot = ""
  if !bound_is_lit && bound_hoisted_reg == "" {
    if bound_name == iv ||
      qbe_stmts_assigns_ident(body, bound_name) ||
      qbe_stmts_rebinds_ident(body, bound_name) {
      return false
    }
    match extra_cond {
      Some(ec) =>
        if qbe_expr_assigns_ident(ec, bound_name) || qbe_expr_rebinds_ident(ec, bound_name) {
          return false
        }
      None => ()
    }
    match qbe_lookup_local(g, bound_name) {
      Some(bloc) =>
        if qbe_is_int32_ty(bloc.ty) {
          bound_slot = bloc.slot
        } else {
          return false
        }
      None => return false
    }
  }
  let guards : Array[QbeBceGuard] = []
  let seen : Map[String, Bool] = Map([])
  match extra_cond {
    Some(ec) => qbe_collect_bce_guards_expr(g, body, iv, ec, guards, seen)
    None => ()
  }
  qbe_collect_bce_guards_stmts(g, body, iv, body, guards, seen)
  if guards.length() == 0 {
    return false
  }

  let l_vchk = qbe_lbl(g, "wh_vchk")
  let l_fentry = qbe_lbl(g, "wh_fe")
  let l_fast = qbe_lbl(g, "wh_fast")
  let l_fcond = qbe_lbl(g, "wh_fc")
  let l_sentry = qbe_lbl(g, "wh_se")
  let l_slow = qbe_lbl(g, "wh_slow")
  let l_scond = qbe_lbl(g, "wh_sc")
  let l_end = qbe_lbl(g, "wh_e")

  // Entry check: iv0 < bound (0 iterations -> skip directly to @wh_e)
  let iv0_w = qbe_tmp(g)
  qbe_emit(g, iv0_w + " =w loadsw " + iv_slot)
  let bnd_w = if bound_is_lit {
    bound_lit.to_string()
  } else if bound_hoisted_reg != "" {
    bound_hoisted_reg
  } else {
    let bw = qbe_tmp(g)
    qbe_emit(g, bw + " =w loadsw " + bound_slot)
    bw
  }
  let enter_ok = qbe_tmp(g)
  qbe_emit(g, enter_ok + " =w csltw " + iv0_w + ", " + bnd_w)
  qbe_emit_term(g, "jnz " + enter_ok + ", " + l_vchk + ", " + l_end)

  // Single-branch 64-bit pre-loop bounds guard
  qbe_emit_lbl(g, l_vchk)
  let iv0_l = qbe_tmp(g)
  qbe_emit(g, iv0_l + " =l extsw " + iv0_w)
  let bnd_l = if bound_is_lit {
    let bl = qbe_tmp(g)
    qbe_emit(g, bl + " =l copy " + bound_lit.to_string())
    bl
  } else {
    let bl = qbe_tmp(g)
    qbe_emit(g, bl + " =l extsw " + bnd_w)
    bl
  }
  let mut all_ok = qbe_tmp(g)
  qbe_emit(g, all_ok + " =w csgel " + iv0_l + ", 0")
  let mut gi = 0
  while gi < guards.length() {
    let gd = guards[gi]
    let alen = match g.hoisted_arr_len.get(gd.arr) {
      Some(hl) => hl
      None =>
        match g.hoisted_str_len.get(gd.arr) {
          Some(hsl) => hsl
          None => "0"
        }
    }
    if gd.kind == 0 {
      let c1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, c1 + " =w cslel " + bnd_l + ", " + alen)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + c1)
      all_ok = nxt
    } else if gd.kind == 1 {
      let bc = qbe_tmp(g)
      let c_ov = qbe_tmp(g)
      let c_len = qbe_tmp(g)
      let t1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, bc + " =l add " + bnd_l + ", " + gd.offset.to_string())
      qbe_emit(g, c_ov + " =w cslel " + bc + ", 2147483648")
      qbe_emit(g, c_len + " =w cslel " + bc + ", " + alen)
      qbe_emit(g, t1 + " =w and " + c_ov + ", " + c_len)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + t1)
      all_ok = nxt
    } else {
      let v_slot = match qbe_lookup_local(g, gd.vname) {
        Some(vloc) => vloc.slot
        None => ""
      }
      let vw = qbe_tmp(g)
      let vl = qbe_tmp(g)
      let vmb = qbe_tmp(g)
      let vmin = qbe_tmp(g)
      let vmax = qbe_tmp(g)
      let c_lo = qbe_tmp(g)
      let c_hi = qbe_tmp(g)
      let t1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, vw + " =w loadsw " + v_slot)
      qbe_emit(g, vl + " =l extsw " + vw)
      qbe_emit(g, vmb + " =l sub " + vl + ", " + bnd_l)
      qbe_emit(g, vmin + " =l add " + vmb + ", 1")
      qbe_emit(g, vmax + " =l sub " + vl + ", " + iv0_l)
      qbe_emit(g, c_lo + " =w csgel " + vmin + ", 0")
      qbe_emit(g, c_hi + " =w csltl " + vmax + ", " + alen)
      qbe_emit(g, t1 + " =w and " + c_lo + ", " + c_hi)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + t1)
      all_ok = nxt
    }
    gi = gi + 1
  }
  match extra_cond {
    Some(_) => qbe_emit_term(g, "jnz " + all_ok + ", " + l_fentry + ", " + l_sentry)
    None => qbe_emit_term(g, "jnz " + all_ok + ", " + l_fast + ", " + l_slow)
  }

  // Fast bottom-tested loop (zero OOB checks on versioned accesses)
  let added_keys : Array[String] = []
  gi = 0
  while gi < guards.length() {
    let k = guards[gi].key
    if !g.bce_safe_exprs.contains(k) {
      g.bce_safe_exprs.set(k, true)
      added_keys.push(k)
    }
    gi = gi + 1
  }
  match extra_cond {
    Some(ec) => {
      qbe_emit_lbl(g, l_fentry)
      qbe_emit_cond_branch(g, ec, l_fast, l_end)
    }
    None => ()
  }
  qbe_emit_lbl(g, l_fast)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_fcond)
  g.loop_depths.push(loop_depth)
  qbe_scope_push(g)
  let fbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, fbv.reg, fbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_fcond)
  qbe_emit_lbl(g, l_fcond)
  qbe_emit_cond_branch(g, cond, l_fast, l_end)

  // Clear fast-path BCE keys before emitting slow path
  let mut ki = 0
  while ki < added_keys.length() {
    g.bce_safe_exprs.remove(added_keys[ki])
    ki = ki + 1
  }

  // Slow bottom-tested loop (full OOB checks preserved)
  match extra_cond {
    Some(ec) => {
      qbe_emit_lbl(g, l_sentry)
      qbe_emit_cond_branch(g, ec, l_slow, l_end)
    }
    None => ()
  }
  qbe_emit_lbl(g, l_slow)
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_scond)
  g.loop_depths.push(loop_depth)
  qbe_scope_push(g)
  let sbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, sbv.reg, sbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_scond)
  qbe_emit_lbl(g, l_scond)
  qbe_emit_cond_branch(g, cond, l_slow, l_end)

  qbe_emit_lbl(g, l_end)
  true
}

///|
fn qbe_try_emit_while_field_promoted(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() == 0 ||
    !qbe_is_pure_small_cond(cond, 12) ||
    !qbe_loop_has_no_calls_expr(cond) ||
    !qbe_loop_has_no_calls_stmts(body) ||
    qbe_stmts_has_nested_loop(body) ||
    qbe_stmts_has_cf(body, true, true, true) {
    return false
  }
  let write_vars : Array[String] = []
  let write_fields : Array[String] = []
  let read_vars : Array[String] = []
  let read_fields : Array[String] = []
  let all_vars : Array[String] = []
  let seen_all : Map[String, Bool] = Map([])
  if !qbe_collect_field_access_stmts(
    body,
    write_vars,
    write_fields,
    read_vars,
    read_fields,
    all_vars,
    seen_all,
  ) {
    return false
  }
  if write_vars.length() == 0 {
    return false
  }
  // Find an outer struct variable `b` with at least one primitive field both read and written
  let mut b_name = ""
  let mut b_slot = ""
  let mut b_sname = ""
  let mut b_sargs : Array[Ty] = []
  let mut wi = 0
  while wi < write_vars.length() {
    let cand = write_vars[wi]
    if !qbe_expr_assigns_ident(cond, cand) &&
      !qbe_stmts_assigns_ident(body, cand) &&
      !qbe_expr_rebinds_ident(cond, cand) &&
      !qbe_stmts_rebinds_ident(body, cand) {
      match qbe_lookup_local(g, cand) {
        Some(loc) =>
          match loc.ty {
            TStruct(sn, sa) => {
              b_name = cand
              b_slot = loc.slot
              b_sname = sn
              b_sargs = sa
              break
            }
            _ => ()
          }
        None => ()
      }
    }
    wi = wi + 1
  }
  if b_name == "" {
    return false
  }
  // Check all other variables with field accesses in `body`: must be at most 1 (`b2`)
  let mut has_b2 = false
  let mut b2_name = ""
  let mut ai = 0
  while ai < all_vars.length() {
    let vn = all_vars[ai]
    if vn != b_name {
      if has_b2 {
        return false
      }
      has_b2 = true
      b2_name = vn
    }
    ai = ai + 1
  }
  let mut b2_idx = -1
  if has_b2 {
    if qbe_stmts_assigns_ident(body, b2_name) {
      return false
    }
    let mut b2_count = 0
    let mut si = 0
    while si < body.length() {
      match body[si] {
        SLet(ln, is_mut, _, init, _) =>
          if ln == b2_name {
            if is_mut || qbe_expr_has_assign(init) {
              return false
            }
            b2_idx = si
            b2_count = b2_count + 1
          }
        _ => ()
      }
      si = si + 1
    }
    if b2_count != 1 || b2_idx < 0 {
      return false
    }
    // Ensure body[0 .. b2_idx - 1] has only pure SLet with no assignments, and b2 is not rebound later
    si = 0
    while si < b2_idx {
      match body[si] {
        SLet(_, _, _, init, _) =>
          if qbe_expr_has_assign(init) {
            return false
          }
        _ => return false
      }
      si = si + 1
    }
    si = b2_idx + 1
    while si < body.length() {
      if qbe_stmt_rebinds_ident(body[si], b2_name) {
        return false
      }
      si = si + 1
    }
    // Also ensure body[0 .. b2_idx] does not read any field of `b_name`
    let pre_wvars : Array[String] = []
    let pre_wfields : Array[String] = []
    let pre_rvars : Array[String] = []
    let pre_rfields : Array[String] = []
    let pre_all : Array[String] = []
    let pre_seen : Map[String, Bool] = Map([])
    si = 0
    while si <= b2_idx {
      let _ = qbe_collect_field_access_stmt(
        body[si],
        pre_wvars,
        pre_wfields,
        pre_rvars,
        pre_rfields,
        pre_all,
        pre_seen,
      )
      si = si + 1
    }
    if pre_seen.contains(b_name) {
      return false
    }
  }
  // Collect promotable primitive fields of `b_name` (both read and written)
  let sinfo = match qbe_lookup_struct_info(g, b_sname) {
    Some(si) => si
    None => return false
  }
  let subst = make_subst(sinfo.decl.type_params, b_sargs)
  let prom_fields : Array[QbePromField] = []
  let prom_seen : Map[String, Bool] = Map([])
  wi = 0
  while wi < write_vars.length() {
    if write_vars[wi] == b_name {
      let fname = write_fields[wi]
      let pkey = b_name + "." + fname
      if !prom_seen.contains(fname) &&
        !g.promoted_fields.contains(pkey) &&
        !g.hoisted_fields.contains(pkey) {
        // Must also be read on `b_name`
        let mut is_read = false
        let mut ri = 0
        while ri < read_vars.length() {
          if read_vars[ri] == b_name && read_fields[ri] == fname {
            is_read = true
            break
          }
          ri = ri + 1
        }
        if is_read {
          let mut fi = 0
          while fi < sinfo.field_names.length() {
            if sinfo.field_names[fi] == fname {
              let fty = subst_ty(sinfo.field_tys[fi], subst)
              let is_prom_ty = match fty {
                TDouble | TInt | TInt64 => true
                _ => false
              }
              if is_prom_ty {
                prom_seen.set(fname, true)
                prom_fields.push(QbePromField::{
                  name: fname,
                  field_idx: fi,
                  ty: fty,
                })
              }
              break
            }
            fi = fi + 1
          }
        }
      }
    }
    wi = wi + 1
  }
  if prom_fields.length() == 0 {
    return false
  }

  let l_init = qbe_lbl(g, "wh_pinit")
  let l_fast = qbe_lbl(g, "wh_pb")
  let l_wb = qbe_lbl(g, "wh_pwb")
  let l_end = qbe_lbl(g, "wh_e")
  let l_cont = if has_b2 { qbe_lbl(g, "wh_pc") } else { "" }
  let l_bail = if has_b2 { qbe_lbl(g, "wh_pbail") } else { "" }
  let l_slow = if has_b2 { qbe_lbl(g, "wh_pslow") } else { "" }

  // Entry guard
  qbe_emit_cond_branch(g, cond, l_init, l_end)

  // Pre-loop promotion init: load b_ptr and initial field values into local slots
  qbe_emit_lbl(g, l_init)
  let b_ptr = qbe_tmp(g)
  qbe_emit(g, b_ptr + " =l loadl " + b_slot)
  let slots : Array[String] = []
  let mut pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let slot = qbe_alloc_slot_for(g, pf.ty)
    slots.push(slot)
    let fp = qbe_tmp(g)
    qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
    let fv = qbe_load_heap_slot(g, fp, pf.ty)
    qbe_store_local_slot(g, fv, slot, pf.ty)
    pi = pi + 1
  }
  qbe_emit_term(g, "jmp " + l_fast)

  // Activate promoted field mappings for the fast loop
  pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let pkey = b_name + "." + pf.name
    g.promoted_fields.set(pkey, slots[pi])
    g.promoted_field_tys.set(pkey, pf.ty)
    pi = pi + 1
  }

  // Fast bottom-tested loop
  qbe_emit_lbl(g, l_fast)
  qbe_scope_push(g)
  let bail_locals : Array[QbeLocal] = []
  if has_b2 {
    let mut si = 0
    while si <= b2_idx {
      if g.block_term {
        break
      }
      let is_last = si == body.length() - 1
      if !is_last && qbe_try_emit_borrowed_arr_elem_let(g, body, si) {
        si = si + 1
        continue
      }
      let sv = qbe_emit_stmt(g, body[si], None, is_last)
      if !g.block_term {
        qbe_rc_dec(g, sv.reg, sv.ty)
      }
      si = si + 1
    }
    // Snapshot scope locals bound in body[0 .. b2_idx] for alias bailout cleanup
    let cur_sc = g.scopes[g.scopes.length() - 1]
    let mut li = 0
    while li < cur_sc.locals.length() {
      bail_locals.push(cur_sc.locals[li])
      li = li + 1
    }
    let b2_slot = match qbe_lookup_local(g, b2_name) {
      Some(b2loc) => b2loc.slot
      None => ""
    }
    let b2_ptr = qbe_tmp(g)
    let is_alias = qbe_tmp(g)
    qbe_emit(g, b2_ptr + " =l loadl " + b2_slot)
    qbe_emit(g, is_alias + " =w ceql " + b_ptr + ", " + b2_ptr)
    qbe_emit_term(g, "jnz " + is_alias + ", " + l_bail + ", " + l_cont)
    qbe_emit_lbl(g, l_cont)
    si = b2_idx + 1
    while si < body.length() {
      if g.block_term {
        break
      }
      let is_last = si == body.length() - 1
      if !is_last && qbe_try_emit_borrowed_arr_elem_let(g, body, si) {
        si = si + 1
        continue
      }
      let sv = qbe_emit_stmt(g, body[si], None, is_last)
      if !g.block_term {
        qbe_rc_dec(g, sv.reg, sv.ty)
      }
      si = si + 1
    }
  } else {
    let bv = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, bv.reg, bv.ty)
    }
  }
  qbe_scope_pop(g)
  qbe_emit_cond_branch(g, cond, l_fast, l_wb)

  // Clear promoted field mappings
  pi = 0
  while pi < prom_fields.length() {
    let pkey = b_name + "." + prom_fields[pi].name
    g.promoted_fields.remove(pkey)
    g.promoted_field_tys.remove(pkey)
    pi = pi + 1
  }

  // Normal exit writeback
  qbe_emit_lbl(g, l_wb)
  pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let v = qbe_load_local_slot(g, slots[pi], pf.ty)
    let fp = qbe_tmp(g)
    qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
    qbe_store_heap_slot(g, v, fp, pf.ty)
    pi = pi + 1
  }
  qbe_emit_term(g, "jmp " + l_end)

  // Cold alias bailout + unpromoted slow loop
  if has_b2 {
    qbe_emit_lbl(g, l_bail)
    qbe_release_scope_locals(g, QbeScope::{ locals: bail_locals })
    pi = 0
    while pi < prom_fields.length() {
      let pf = prom_fields[pi]
      let v = qbe_load_local_slot(g, slots[pi], pf.ty)
      let fp = qbe_tmp(g)
      qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
      qbe_store_heap_slot(g, v, fp, pf.ty)
      pi = pi + 1
    }
    qbe_emit_term(g, "jmp " + l_slow)

    qbe_emit_lbl(g, l_slow)
    qbe_scope_push(g)
    let sbv = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, sbv.reg, sbv.ty)
    }
    qbe_scope_pop(g)
    qbe_emit_cond_branch(g, cond, l_slow, l_end)
  }

  qbe_emit_lbl(g, l_end)
  true
}

///|
fn qbe_is_ident_plus_minus_one(base : String, other : Expr) -> Bool {
  match other {
    EBinary("+", EIdent(x, _), EInt(raw, _), _) =>
      x == base && qbe_parse_int64_lit(raw) == 1L
    EBinary("+", EInt(raw, _), EIdent(x, _), _) =>
      x == base && qbe_parse_int64_lit(raw) == 1L
    EBinary("-", EIdent(x, _), EInt(raw, _), _) =>
      x == base && qbe_parse_int64_lit(raw) == 1L
    _ => false
  }
}

///|
fn qbe_are_consecutive_int_exprs(l : Expr, r : Expr) -> Bool {
  match l {
    EIdent(x, _) =>
      if qbe_is_ident_plus_minus_one(x, r) {
        return true
      }
    _ => ()
  }
  match r {
    EIdent(x, _) => qbe_is_ident_plus_minus_one(x, l)
    _ => false
  }
}

///|
fn qbe_expr_is_even_int(e : Expr) -> Bool {
  match e {
    EInt(raw, _) => (qbe_parse_int64_lit(raw) & 1L) == 0L
    EUnary("-", inner, _) | EMove(inner, _) => qbe_expr_is_even_int(inner)
    EBinary("*", l, r, _) =>
      qbe_expr_is_even_int(l) ||
      qbe_expr_is_even_int(r) ||
      qbe_are_consecutive_int_exprs(l, r)
    EBinary("<<", _, EInt(raw, _), _) => {
      let sh = qbe_parse_int64_lit(raw)
      sh >= 1L && sh <= 31L
    }
    EBinary("+", l, r, _) | EBinary("-", l, r, _) =>
      qbe_expr_is_even_int(l) && qbe_expr_is_even_int(r)
    _ => false
  }
}

///|
fn qbe_expr_is_pure_arith(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EIdent(_, _) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) =>
      qbe_expr_is_pure_arith(inner)
    EBinary(op, l, r, _) =>
      if op == "/" || op == "%" {
        false
      } else {
        qbe_expr_is_pure_arith(l) && qbe_expr_is_pure_arith(r)
      }
    _ => false
  }
}

///|
fn qbe_expr_bare_reads_ident(e : Expr, name : String) -> Bool {
  match e {
    EIdent(n, _) => n == name
    EBinary("*", EIdent(a, _), EIdent(b, _), _) =>
      if a == name && b == name {
        false
      } else {
        a == name || b == name
      }
    EBinary(_, l, r, _) =>
      qbe_expr_bare_reads_ident(l, name) || qbe_expr_bare_reads_ident(r, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) =>
      qbe_expr_bare_reads_ident(inner, name)
    _ => false
  }
}

///|
fn qbe_try_emit_while_sq_reuse(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() < 2 ||
    !qbe_loop_has_no_calls_expr(cond) ||
    !qbe_loop_has_no_calls_stmts(body) ||
    qbe_stmts_has_nested_loop(body) ||
    qbe_stmts_has_cf(body, false, true, false) {
    return false
  }
  let cands : Array[QbeSqCand] = []
  let seen : Map[String, Bool] = Map([])
  let mut si = 0
  while si < body.length() {
    match body[si] {
      SAssign(EIdent(vname, _), rhs, _) =>
        if !seen.contains(vname) &&
          !g.sq_reuse_slot.contains(vname) &&
          !qbe_expr_mentions_ident(cond, vname) &&
          !qbe_stmts_rebinds_ident(body, vname) &&
          !qbe_expr_assigns_ident(rhs, vname) &&
          qbe_stmts_count_assigns_ident(body, vname) == 1 {
          match qbe_lookup_local(g, vname) {
            Some(vloc) =>
              if qbe_is_double_ty(vloc.ty) {
                // Must have v * v in body[0 .. si - 1]
                let mut has_before = false
                let mut bi = 0
                while bi < si {
                  if qbe_stmt_has_sq(body[bi], vname) {
                    has_before = true
                    break
                  }
                  bi = bi + 1
                }
                if has_before {
                  // Must have an unconditionally-executed v * v in body[si + 1 .. len - 1]
                  // with no earlier branch-only v * v and no earlier break/return
                  let mut has_after = false
                  let mut ok_after = true
                  let mut ai = si + 1
                  while ai < body.length() {
                    if qbe_stmt_uncond_has_sq(body[ai], vname) {
                      has_after = true
                      break
                    }
                    if qbe_stmt_has_branch_sq(body[ai], vname) ||
                      qbe_stmt_has_cf(body[ai], true, true, true) {
                      ok_after = false
                      break
                    }
                    ai = ai + 1
                  }
                  if has_after && ok_after {
                    seen.set(vname, true)
                    cands.push(QbeSqCand::{
                      name: vname,
                      assign_idx: si,
                    })
                  }
                }
              }
            None => ()
          }
        }
      _ => ()
    }
    si = si + 1
  }
  if cands.length() == 0 {
    return false
  }

  let rotated = qbe_is_pure_small_cond(cond, 12)
  let l_init = qbe_lbl(g, "wh_sqi")
  let l_body = qbe_lbl(g, "wh_b")
  let l_cond = qbe_lbl(g, "wh_c")
  let l_end = qbe_lbl(g, "wh_e")

  if rotated {
    qbe_emit_cond_branch(g, cond, l_init, l_end)
    qbe_emit_lbl(g, l_init)
  }
  let mut ci = 0
  while ci < cands.length() {
    let cname = cands[ci].name
    let cslot = match qbe_lookup_local(g, cname) {
      Some(cloc) => cloc.slot
      None => ""
    }
    let sq_slot = qbe_alloc_slot_for(g, TDouble)
    let v0 = qbe_tmp(g)
    let sq0 = qbe_tmp(g)
    qbe_emit(g, v0 + " =d loadd " + cslot)
    qbe_emit(g, sq0 + " =d mul " + v0 + ", " + v0)
    qbe_emit(g, "stored " + sq0 + ", " + sq_slot)
    g.sq_reuse_slot.set(cname, sq_slot)
    g.sq_reuse_state.set(cname, 1)
    ci = ci + 1
  }

  if rotated {
    qbe_emit_term(g, "jmp " + l_body)
  } else {
    qbe_emit_term(g, "jmp " + l_cond)
    qbe_emit_lbl(g, l_cond)
    qbe_emit_cond_branch(g, cond, l_body, l_end)
  }

  // Reorder adjacent pure immutable `let` statements before the first candidate
  // assignment so statements that bare-read an old candidate variable run before
  // statements that only use its precomputed square, shortening live ranges.
  let eff_body : Array[Stmt] = []
  let mut bi = 0
  while bi < body.length() {
    eff_body.push(body[bi])
    bi = bi + 1
  }
  let mut min_assign = body.length()
  ci = 0
  while ci < cands.length() {
    if cands[ci].assign_idx < min_assign {
      min_assign = cands[ci].assign_idx
    }
    ci = ci + 1
  }
  let mut ri = 0
  while ri + 1 < min_assign {
    let mut do_swap = false
    match eff_body[ri] {
      SLet(n0, false, _, e0, _) =>
        match eff_body[ri + 1] {
          SLet(n1, false, _, e1, _) =>
            if n0 != n1 &&
              qbe_expr_is_pure_arith(e0) &&
              qbe_expr_is_pure_arith(e1) &&
              !qbe_expr_mentions_ident(e1, n0) &&
              !qbe_expr_mentions_ident(e0, n1) {
              let mut e0_bare = false
              let mut e1_bare = false
              let mut k = 0
              while k < cands.length() {
                let cn = cands[k].name
                if qbe_expr_bare_reads_ident(e0, cn) {
                  e0_bare = true
                }
                if qbe_expr_bare_reads_ident(e1, cn) {
                  e1_bare = true
                }
                k = k + 1
              }
              if !e0_bare && e1_bare {
                do_swap = true
              }
            }
          _ => ()
        }
      _ => ()
    }
    if do_swap {
      let tmp = eff_body[ri]
      eff_body[ri] = eff_body[ri + 1]
      eff_body[ri + 1] = tmp
      ri = ri + 2
    } else {
      ri = ri + 1
    }
  }

  qbe_emit_lbl(g, l_body)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_cond)
  g.loop_depths.push(loop_depth)
  qbe_scope_push(g)
  si = 0
  while si < eff_body.length() {
    if g.block_term {
      break
    }
    let is_last = si == eff_body.length() - 1
    if !is_last && qbe_try_emit_borrowed_arr_elem_let(g, eff_body, si) {
      si = si + 1
      continue
    }
    let sv = qbe_emit_stmt(g, eff_body[si], None, is_last)
    if !g.block_term {
      qbe_rc_dec(g, sv.reg, sv.ty)
    }
    // After emitting assign_idx for a candidate, switch it to SqUpdate (state 2)
    ci = 0
    while ci < cands.length() {
      if cands[ci].assign_idx == si {
        g.sq_reuse_state.set(cands[ci].name, 2)
      }
      ci = ci + 1
    }
    si = si + 1
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_cond)
  if rotated {
    qbe_emit_lbl(g, l_cond)
    qbe_emit_cond_branch(g, cond, l_body, l_end)
  }
  qbe_emit_lbl(g, l_end)

  ci = 0
  while ci < cands.length() {
    g.sq_reuse_slot.remove(cands[ci].name)
    g.sq_reuse_state.remove(cands[ci].name)
    ci = ci + 1
  }
  true
}

///|
fn qbe_is_early_drop_ty(t : Ty) -> Bool {
  match t {
    TWorld | TScope | TParam(_) => false
    _ => qbe_is_obj_ty(t)
  }
}

///|
fn qbe_emit_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  expected : Option[Ty],
) -> QbeVal {
  let n = stmts.length()
  if n == 0 {
    return qval("0", TUnit)
  }
  // Perceus-lite last-use early drop: for each top-level immutable `SLet` in this
  // straight-line statement block, compute its last syntactic mention index `last_use`.
  // When `last_use < n - 1` and the binding is an owned heap object not shadowed or
  // pinned by a borrowed array-element view, drop it immediately after `stmts[last_use]`
  // and zero its stack slot so scope-exit / early-return release is a 1-branch NULL no-op.
  let def_last_use : Array[Int] = []
  let def_names : Array[String] = []
  let mut di = 0
  while di < n {
    let mut lu = -1
    let mut dname = ""
    if di < n - 1 {
      match stmts[di] {
        SLet(name, is_mut, _, _, _) =>
          if !is_mut && name != "_" {
            let mut cur_lu = di
            let mut shadowed_use = false
            let mut j = di + 1
            while j < n {
              match stmts[j] {
                SLet(n2, _, _, init2, _) =>
                  if n2 == name {
                    if qbe_expr_mentions_ident(init2, name) {
                      shadowed_use = true
                    }
                    break
                  }
                SLetTuple(ns2, _, init2, _) =>
                  if str_arr_contains(ns2, name) {
                    if qbe_expr_mentions_ident(init2, name) {
                      shadowed_use = true
                    }
                    break
                  }
                _ => ()
              }
              if qbe_stmt_mentions_ident(stmts[j], name) {
                cur_lu = j
              }
              j = j + 1
            }
            if !shadowed_use && cur_lu <= n - 1 {
              if cur_lu < n - 1 {
                lu = cur_lu
                dname = name
              } else {
                match stmts[n - 1] {
                  SExpr(_, _) => {
                    lu = cur_lu
                    dname = name
                  }
                  _ => ()
                }
              }
            }
          }
        _ => ()
      }
    }
    def_last_use.push(lu)
    def_names.push(dname)
    di = di + 1
  }
  let ed_names : Array[String] = []
  let ed_slots : Array[String] = []
  let ed_last : Array[Int] = []
  let pinned : Map[String, Bool] = Map([])
  let mut i = 0
  let mut last = qval("0", TUnit)
  while i < n {
    if g.block_term {
      break
    }
    let is_last = i == n - 1
    if !is_last && qbe_try_emit_borrowed_arr_elem_let(g, stmts, i) {
      match stmts[i] {
        SLet(_, _, _, EIndex(EIdent(aname, _), _, _), _) =>
          pinned.set(aname, true)
        SLet(_, _, _, EIndex(EField(EIdent(bname, _), _, _), _, _), _) =>
          pinned.set(bname, true)
        SLet(_, _, _, EField(EIdent(bname, _), _, _), _) =>
          pinned.set(bname, true)
        SLet(_, _, _, EField(EField(EIdent(bname, _), _, _), _, _), _) =>
          pinned.set(bname, true)
        _ => ()
      }
      last = qval("0", TUnit)
    } else {
      let exp = if is_last { expected } else { None }
      let move_expr_opt : Option[Expr] = match stmts[i] {
        SExpr(me, _) =>
          if qbe_expr_is_straight_line_movable(me) { Some(me) } else { None }
        SLet(_, _, _, me, _) =>
          if qbe_expr_is_straight_line_movable(me) { Some(me) } else { None }
        _ => None
      }
      let old_mov = g.movable_locals
      let old_moved = g.moved_slots
      let mut did_mov_setup = false
      match move_expr_opt {
        Some(me) =>
          if ed_names.length() > 0 {
            let mov_map : Map[String, String] = Map([])
            let mut mk = 0
            while mk < ed_names.length() {
              if ed_last[mk] == i && !pinned.contains(ed_names[mk]) {
                if qbe_expr_count_mentions(me, ed_names[mk]) == 1 {
                  mov_map.set(ed_names[mk], ed_slots[mk])
                }
              }
              mk = mk + 1
            }
            if mov_map.length() > 0 {
              g.movable_locals = mov_map
              g.moved_slots = Map([])
              did_mov_setup = true
            }
          }
        None => ()
      }
      last = qbe_emit_stmt(g, stmts[i], exp, is_last)
      let cur_moved = g.moved_slots
      if did_mov_setup {
        g.movable_locals = old_mov
        g.moved_slots = old_moved
      }
      if def_last_use[i] >= 0 {
        let dname = def_names[i]
        match qbe_lookup_local(g, dname) {
          Some(loc) =>
            if loc.owned && qbe_is_early_drop_ty(loc.ty) {
              ed_names.push(dname)
              ed_slots.push(loc.slot)
              ed_last.push(def_last_use[i])
            }
          None => ()
        }
      }
      if !g.block_term && ed_names.length() > 0 {
        let mut k = ed_names.length() - 1
        let mut dropped_any = false
        while k >= 0 {
          if ed_last[k] == i && !pinned.contains(ed_names[k]) {
            if did_mov_setup && cur_moved.contains(ed_slots[k]) {
              g.zeroed_slots.set(ed_slots[k], true)
              dropped_any = true
            } else if i < n - 1 {
              let dead = qbe_tmp(g)
              qbe_emit(g, dead + " =l loadl " + ed_slots[k])
              qbe_emit(g, "call $pion_rc_dec(l " + dead + ")")
              qbe_emit(g, "storel 0, " + ed_slots[k])
              g.zeroed_slots.set(ed_slots[k], true)
              dropped_any = true
            }
          }
          k = k - 1
        }
        if dropped_any {
          g.block_immut_fields = Map([])
        }
      }
    }
    i = i + 1
  }
  last
}

///|
fn qbe_emit_compound_binop(
  g : QbeGen,
  op : String,
  old_reg : String,
  rv : QbeVal,
  ty : Ty,
) -> String {
  match ty {
    TString => {
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =l call $pion_str_concat(l " + old_reg + ", l " + rv.reg + ")")
      qbe_rc_dec(g, rv.reg, rv.ty)
      r
    }
    TDouble => {
      let rd = qbe_coerce_val(g, rv, TDouble)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else {
        "div"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =d " + qop + " " + old_reg + ", " + rd)
      r
    }
    TFloat => {
      let rf = qbe_coerce_val(g, rv, TFloat)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else {
        "div"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =s " + qop + " " + old_reg + ", " + rf)
      r
    }
    TUInt => {
      let rw = qbe_coerce_val(g, rv, TUInt)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else if op == "/" {
        "udiv"
      } else if op == "%" {
        "urem"
      } else if op == "&" {
        "and"
      } else if op == "|" {
        "or"
      } else if op == "^" {
        "xor"
      } else if op == "<<" {
        "shl"
      } else {
        "shr"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w " + qop + " " + old_reg + ", " + rw)
      r
    }
    TUInt64 => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "shr" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        r
      } else {
        let rl = qbe_coerce_val(g, rv, TUInt64)
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "udiv"
        } else if op == "%" {
          "urem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        r
      }
    }
    TInt64 => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "sar" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        r
      } else {
        let rl = qbe_coerce_val(g, rv, TInt64)
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "div"
        } else if op == "%" {
          "rem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        r
      }
    }
    _ => {
      let rw = qbe_coerce_val(g, rv, TInt)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else if op == "/" {
        "div"
      } else if op == "%" {
        "rem"
      } else if op == "&" {
        "and"
      } else if op == "|" {
        "or"
      } else if op == "^" {
        "xor"
      } else if op == "<<" {
        "shl"
      } else {
        "sar"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w " + qop + " " + old_reg + ", " + rw)
      r
    }
  }
}

///|
fn qbe_emit_stmt(
  g : QbeGen,
  stmt : Stmt,
  expected : Option[Ty],
  is_tail : Bool,
) -> QbeVal {
  match stmt {
    SLet(name, is_mut, ty_expr, init, let_sp) => {
      let ann_opt : Option[Ty] = match ty_expr {
        TyMissing(_) => qbe_let_infer(g, let_sp)
        _ => Some(qbe_resolve_type(g, ty_expr))
      }
      let iv = qbe_emit_expr(g, init, ann_opt)
      let final_ty = match ann_opt {
        Some(a) => a
        None => iv.ty
      }
      if name == "_" {
        qbe_rc_dec(g, iv.reg, final_ty)
      } else {
        let iv_ext : Option[String] = if !is_mut &&
          qbe_is_int32_ty(final_ty) &&
          qbe_is_int32_ty(iv.ty) {
          g.w_to_l_ext.get(iv.reg)
        } else {
          None
        }
        let loc = qbe_define_local(g, name, final_ty, true)
        qbe_store_local_slot(g, qbe_coerce_val(g, iv, final_ty), loc.slot, final_ty)
        match iv_ext {
          Some(rl) => g.local_w_to_l_ext.set(name, rl)
          None => ()
        }
        // Track immutable `let n = arr.length()` aliases for BCE
        g.len_aliases.remove(name)
        g.unfrozen_local_arrs.remove(name)
        match init {
          EArrayLit(_, _) =>
            match final_ty {
              TArray(_) => g.unfrozen_local_arrs.set(name, true)
              _ => ()
            }
          _ => ()
        }
        if !is_mut {
          match init {
            EMethodCall(EIdent(aname, _), mname, margs, _) =>
              if mname == "length" && margs.length() == 0 {
                match qbe_lookup_local(g, aname) {
                  Some(aloc) =>
                    match aloc.ty {
                      TArray(_) | TFixedArray(_) | TString => {
                        g.len_aliases.set(name, aname)
                        if !str_arr_contains(g.len_alias_keys, name) {
                          g.len_alias_keys.push(name)
                        }
                      }
                      _ => ()
                    }
                  None => ()
                }
              }
            _ => ()
          }
        }
        // Track provably non-negative `Int` locals for conservative BCE
        match final_ty {
          TInt => {
            let mut is_nonneg = false
            match init {
              EInt(raw, _) => {
                let v = qbe_parse_int64_lit(raw).to_int()
                if v >= 0 {
                  is_nonneg = true
                }
              }
              EIdent(base_v, _) =>
                match g.nonneg_vars.get(base_v) {
                  Some(true) => is_nonneg = true
                  _ => ()
                }
              EBinary("+", EIdent(base_v, _), EInt(raw, _), _) =>
                if qbe_parse_int64_lit(raw) == 1L {
                  match g.nonneg_vars.get(base_v) {
                    Some(true) => is_nonneg = true
                    _ => ()
                  }
                }
              _ => ()
            }
            if is_nonneg {
              g.nonneg_vars.set(name, true)
            } else {
              g.nonneg_vars.remove(name)
            }
          }
          _ => g.nonneg_vars.remove(name)
        }
      }
      qval("0", TUnit)
    }
    SLetTuple(names, ty_expr, init, _) => {
      let ann_opt : Option[Ty] = match ty_expr {
        TyMissing(_) => None
        _ => Some(qbe_resolve_type(g, ty_expr))
      }
      let iv = qbe_emit_expr(g, init, ann_opt)
      let tup_ty = match ann_opt {
        Some(a) => a
        None => iv.ty
      }
      match tup_ty {
        TTuple(elem_tys) => {
          let mut i = 0
          while i < names.length() && i < elem_tys.length() {
            let bname = names[i]
            if bname != "_" {
              let ety = elem_tys[i]
              let p = qbe_tmp(g)
              qbe_emit(g, p + " =l add " + iv.reg + ", " + (i * 8).to_string())
              let ev = qbe_load_heap_slot(g, p, ety)
              qbe_rc_inc(g, ev, ety)
              let loc = qbe_define_local(g, bname, ety, true)
              qbe_store_local_slot(g, ev, loc.slot, ety)
              g.len_aliases.remove(bname)
              g.nonneg_vars.remove(bname)
            }
            i = i + 1
          }
        }
        _ => ()
      }
      qbe_rc_dec(g, iv.reg, tup_ty)
      qval("0", TUnit)
    }
    SAssign(lhs, rhs, _) => {
      match lhs {
        EIdent(name, _) => {
          g.len_aliases.remove(name)
          qbe_invalidate_len_aliases_for(g, name)
          g.local_w_to_l_ext.remove(name)
          g.unfrozen_local_arrs.remove(name)
          match rhs {
            EInt(raw, _) =>
              if qbe_parse_int64_lit(raw).to_int() >= 0 {
                g.nonneg_vars.set(name, true)
              } else {
                g.nonneg_vars.remove(name)
              }
            EBinary("+", EIdent(rhs_n, _), EInt(raw, _), _) =>
              if rhs_n != name || qbe_parse_int64_lit(raw) != 1L {
                g.nonneg_vars.remove(name)
              }
            _ => g.nonneg_vars.remove(name)
          }
          match qbe_lookup_local(g, name) {
            Some(loc) => {
              let rv = qbe_emit_expr(g, rhs, Some(loc.ty))
              let rval_reg = qbe_coerce_val(g, rv, loc.ty)
              let need_dec = if loc.owned {
                match loc.ty {
                  TParam(_) => true
                  _ => qbe_is_obj_ty(loc.ty)
                }
              } else {
                false
              }
              if need_dec {
                let old = qbe_tmp(g)
                qbe_emit(g, old + " =l loadl " + loc.slot)
                qbe_store_local_slot(g, rval_reg, loc.slot, loc.ty)
                qbe_rc_dec(g, old, loc.ty)
              } else {
                qbe_store_local_slot(g, rval_reg, loc.slot, loc.ty)
              }
              g.block_immut_fields = Map([])
            }
            None => {
              let rv = qbe_emit_expr(g, rhs, None)
              let loc = qbe_define_local(g, name, rv.ty, true)
              qbe_store_local_slot(g, rv.reg, loc.slot, rv.ty)
              g.block_immut_fields = Map([])
            }
          }
        }
        EField(obj, fname, _) => {
          let mut prom_handled = false
          match obj {
            EIdent(lname, _) => {
              let pkey = lname + "." + fname
              match g.promoted_fields.get(pkey) {
                Some(pslot) =>
                  match g.promoted_field_tys.get(pkey) {
                    Some(pty) => {
                      let rv = qbe_emit_expr(g, rhs, Some(pty))
                      let rval_reg = qbe_coerce_val(g, rv, pty)
                      qbe_store_local_slot(g, rval_reg, pslot, pty)
                      g.block_immut_fields.remove(pkey)
                      prom_handled = true
                    }
                    None => ()
                  }
                None => ()
              }
            }
            _ => ()
          }
          if !prom_handled {
          let mut borrowed = false
          let mut ov = qval("0", TError)
          if !qbe_expr_has_assign(rhs) {
            match obj {
              EIdent(lname, _) =>
                match qbe_lookup_local(g, lname) {
                  Some(loc) =>
                    match loc.ty {
                      TStruct(_, _) => {
                        let r = qbe_tmp(g)
                        qbe_emit(g, r + " =l loadl " + loc.slot)
                        ov = qval(r, loc.ty)
                        borrowed = true
                      }
                      _ => ()
                    }
                  None => ()
                }
              _ => ()
            }
          }
          if !borrowed {
            ov = qbe_emit_expr(g, obj, None)
          }
          match ov.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut i = 0
                  while i < sinfo.field_names.length() {
                    if sinfo.field_names[i] == fname {
                      let fty = subst_ty(sinfo.field_tys[i], subst)
                      let rv = qbe_emit_expr(g, rhs, Some(fty))
                      let rval_reg = qbe_coerce_val(g, rv, fty)
                      let p = qbe_tmp(g)
                      qbe_emit(g, p + " =l add " + ov.reg + ", " + (i * 8).to_string())
                      let need_dec = match fty {
                        TParam(_) => true
                        _ => qbe_is_obj_ty(fty)
                      }
                      if need_dec {
                        let old = qbe_tmp(g)
                        qbe_emit(g, old + " =l loadl " + p)
                        qbe_store_heap_slot(g, rval_reg, p, fty)
                        qbe_rc_dec(g, old, fty)
                      } else {
                        qbe_store_heap_slot(g, rval_reg, p, fty)
                      }
                      break
                    }
                    i = i + 1
                  }
                }
                None => ()
              }
            _ => ()
          }
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          }
        }
        EIndex(obj, idx, _) => {
          let mut borrowed = false
          let mut ov = qval("0", TError)
          let mut arr_local_name = ""
          if !qbe_expr_has_assign(idx) && !qbe_expr_has_assign(rhs) {
            match obj {
              EIdent(lname, _) =>
                match qbe_lookup_local(g, lname) {
                  Some(loc) =>
                    match loc.ty {
                      TArray(elem) | TFixedArray(elem) => {
                        arr_local_name = lname
                        borrowed = true
                        if qbe_is_prim_array_elem(elem) &&
                          g.hoisted_arr_len.contains(lname) &&
                          g.hoisted_arr_dp.contains(lname) {
                          ov = qval("0", loc.ty)
                        } else {
                          let r = qbe_tmp(g)
                          qbe_emit(g, r + " =l loadl " + loc.slot)
                          ov = qval(r, loc.ty)
                        }
                      }
                      TBytes => {
                        arr_local_name = lname
                        borrowed = true
                        let r = qbe_tmp(g)
                        qbe_emit(g, r + " =l loadl " + loc.slot)
                        ov = qval(r, loc.ty)
                      }
                      _ => ()
                    }
                  None => ()
                }
              EIndex(EIdent(outer, _), idx1, _) =>
                if !qbe_expr_has_assign(idx1) &&
                  qbe_loop_has_no_calls_expr(idx) &&
                  qbe_loop_has_no_calls_expr(rhs) &&
                  !qbe_expr_assigns_ident(idx, outer) &&
                  !qbe_expr_assigns_ident(rhs, outer) {
                  match qbe_lookup_local(g, outer) {
                    Some(oloc) =>
                      match oloc.ty {
                        TArray(TArray(inner_elem)) => {
                          let outer_p = if g.hoisted_arr_len.contains(outer) &&
                            g.hoisted_arr_dp.contains(outer) {
                            "0"
                          } else {
                            let r = qbe_tmp(g)
                            qbe_emit(g, r + " =l loadl " + oloc.slot)
                            r
                          }
                          let iv1 = qbe_emit_expr(g, idx1, Some(TInt))
                          let il1 = qbe_as_l(g, iv1)
                          if !qbe_bce_expr_is_safe(g, outer, idx1) {
                            let olen = match g.hoisted_arr_len.get(outer) {
                              Some(hlen) => hlen
                              None => {
                                let t = qbe_tmp(g)
                                qbe_emit(g, t + " =l loadl " + outer_p)
                                t
                              }
                            }
                            let oob1 = qbe_tmp(g)
                            let l_oob1 = qbe_lbl(g, "arr_oob")
                            let l_ok1 = qbe_lbl(g, "arr_ok")
                            qbe_emit(g, oob1 + " =w cugel " + il1 + ", " + olen)
                            qbe_emit_term(g, "jnz " + oob1 + ", " + l_oob1 + ", " + l_ok1)
                            qbe_emit_lbl(g, l_oob1)
                            qbe_emit(g, "call $pion_panic_oob(l " + il1 + ", l " + olen + ")")
                            qbe_emit_term(g, "hlt")
                            qbe_emit_lbl(g, l_ok1)
                          }
                          let odp = match g.hoisted_arr_dp.get(outer) {
                            Some(hdp) => hdp
                            None => {
                              let dp_p = qbe_tmp(g)
                              let t = qbe_tmp(g)
                              qbe_emit(g, dp_p + " =l add " + outer_p + ", 24")
                              qbe_emit(g, t + " =l loadl " + dp_p)
                              t
                            }
                          }
                          let off1 = qbe_tmp(g)
                          let ep1 = qbe_tmp(g)
                          let inner_p = qbe_tmp(g)
                          qbe_emit(g, off1 + " =l shl " + il1 + ", 3")
                          qbe_emit(g, ep1 + " =l add " + odp + ", " + off1)
                          qbe_emit(g, inner_p + " =l loadl " + ep1)
                          ov = qval(inner_p, TArray(inner_elem))
                          borrowed = true
                        }
                        _ => ()
                      }
                    None => ()
                  }
                }
              _ => ()
            }
          }
          if !borrowed {
            ov = qbe_emit_expr(g, obj, None)
          }
          match ov.ty {
            TArray(elem) | TFixedArray(elem) => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              let il = qbe_as_l(g, iv)
              if qbe_is_prim_array_elem(elem) {
                let idx_key = if borrowed &&
                  arr_local_name != "" &&
                  qbe_loop_has_no_calls_expr(rhs) &&
                  !qbe_expr_assigns_ident(rhs, arr_local_name) {
                  qbe_pure_idx_key(idx)
                } else {
                  ""
                }
                let reuse_ep = idx_key != "" &&
                  qbe_expr_has_same_index(rhs, arr_local_name, idx_key)
                if reuse_ep {
                  let bce_safe = qbe_bce_expr_is_safe(g, arr_local_name, idx)
                  if !bce_safe {
                    let alen = match g.hoisted_arr_len.get(arr_local_name) {
                      Some(hlen) => hlen
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + ov.reg)
                        t
                      }
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let off = qbe_tmp(g)
                  let ep = qbe_tmp(g)
                  qbe_emit(g, off + " =l shl " + il + ", 3")
                  qbe_emit(g, ep + " =l add " + dp + ", " + off)
                  let prev_arr = g.assign_idx_arr
                  let prev_key = g.assign_idx_key
                  let prev_ep = g.assign_idx_ep
                  g.assign_idx_arr = arr_local_name
                  g.assign_idx_key = idx_key
                  g.assign_idx_ep = ep
                  let rv = qbe_emit_expr(g, rhs, Some(elem))
                  g.assign_idx_arr = prev_arr
                  g.assign_idx_key = prev_key
                  g.assign_idx_ep = prev_ep
                  qbe_store_heap_slot(g, qbe_coerce_val(g, rv, elem), ep, elem)
                } else {
                  let rv = qbe_emit_expr(g, rhs, Some(elem))
                  let rv_l_ext = if qbe_is_int32_ty(elem) && qbe_is_int32_ty(rv.ty) {
                    g.w_to_l_ext.get(rv.reg)
                  } else {
                    None
                  }
                  let bce_safe = if arr_local_name != "" {
                    qbe_bce_expr_is_safe(g, arr_local_name, idx)
                  } else {
                    false
                  }
                  if !bce_safe {
                    let alen = match g.hoisted_arr_len.get(arr_local_name) {
                      Some(hlen) => hlen
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + ov.reg)
                        t
                      }
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let off = qbe_tmp(g)
                  let ep = qbe_tmp(g)
                  qbe_emit(g, off + " =l shl " + il + ", 3")
                  qbe_emit(g, ep + " =l add " + dp + ", " + off)
                  match rv_l_ext {
                    Some(existing_l) => qbe_emit(g, "storel " + existing_l + ", " + ep)
                    None => qbe_store_heap_slot(g, qbe_coerce_val(g, rv, elem), ep, elem)
                  }
                }
              } else {
                let rv = qbe_emit_expr(g, rhs, Some(elem))
                let vl = qbe_as_l(g, rv)
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, elem, true)
                qbe_emit(
                  g,
                  "call $pion_arr_set(l " + ov.reg + ", l " + il + ", l " + vl + ")",
                )
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
            }
            TMap(kty, vty) => {
              let kv = qbe_emit_expr(g, idx, Some(kty))
              let kl = qbe_as_l(g, kv)
              let rv = qbe_emit_expr(g, rhs, Some(vty))
              let vl = qbe_as_l(g, rv)
              qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, true)
              qbe_emit(
                g,
                "call $pion_map_set(l " + ov.reg + ", l " + kl + ", l " + vl + ")",
              )
              qbe_rc_dec(g, kv.reg, kv.ty)
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            TBytes => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              let il = qbe_as_l(g, iv)
              let rv = qbe_emit_expr(g, rhs, Some(TByte))
              let blen = qbe_tmp(g)
              let oob = qbe_tmp(g)
              let l_oob = qbe_lbl(g, "bytes_oob")
              let l_ok = qbe_lbl(g, "bytes_ok")
              qbe_emit(g, blen + " =l loadl " + ov.reg)
              qbe_emit(g, oob + " =w cugel " + il + ", " + blen)
              qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
              qbe_emit_lbl(g, l_oob)
              qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + blen + ")")
              qbe_emit_term(g, "hlt")
              qbe_emit_lbl(g, l_ok)
              let dp_p = qbe_tmp(g)
              let dp = qbe_tmp(g)
              let ep = qbe_tmp(g)
              let vw = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + ov.reg + ", 16")
              qbe_emit(g, dp + " =l loadl " + dp_p)
              qbe_emit(g, ep + " =l add " + dp + ", " + il)
              qbe_emit(g, vw + " =w copy " + rv.reg)
              qbe_emit(g, "storeb " + vw + ", " + ep)
            }
            _ => ()
          }
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
        }
        _ => {
          let rv = qbe_emit_expr(g, rhs, None)
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
      }
      qval("0", TUnit)
    }
    SCompoundAssign(op, lhs, rhs, sp) => {
      match lhs {
        EIdent(_, _) =>
          return qbe_emit_stmt(
            g,
            SAssign(lhs, EBinary(op, lhs, rhs, sp), sp),
            None,
            false,
          )
        EField(obj, fname, _) => {
          let ov = qbe_emit_expr(g, obj, None)
          match ov.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      let fp = qbe_tmp(g)
                      qbe_emit(g, fp + " =l add " + ov.reg + ", " + (fi * 8).to_string())
                      let old_v = qbe_load_heap_slot(g, fp, fty)
                      let rv = qbe_emit_expr(g, rhs, Some(fty))
                      let new_v = qbe_emit_compound_binop(g, op, old_v, rv, fty)
                      if qbe_is_obj_ty(fty) {
                        qbe_emit_adopt_if_frozen(g, ov.reg, new_v, fty, true)
                        qbe_rc_dec(g, old_v, fty)
                      }
                      qbe_store_heap_slot(g, new_v, fp, fty)
                      break
                    }
                    fi = fi + 1
                  }
                }
                None => ()
              }
            _ => ()
          }
          qbe_rc_dec(g, ov.reg, ov.ty)
          qval("0", TUnit)
        }
        EIndex(obj, idx, _) => {
          let ov = qbe_emit_expr(g, obj, None)
          match ov.ty {
            TArray(elem) | TFixedArray(elem) => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              let il = qbe_as_l(g, iv)
              let alen = qbe_tmp(g)
              let oob = qbe_tmp(g)
              let l_oob = qbe_lbl(g, "arr_oob")
              let l_ok = qbe_lbl(g, "arr_ok")
              qbe_emit(g, alen + " =l loadl " + ov.reg)
              qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
              qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
              qbe_emit_lbl(g, l_oob)
              qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
              qbe_emit_term(g, "hlt")
              qbe_emit_lbl(g, l_ok)
              let dp_p = qbe_tmp(g)
              let dp = qbe_tmp(g)
              let off = qbe_tmp(g)
              let ep = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
              qbe_emit(g, dp + " =l loadl " + dp_p)
              qbe_emit(g, off + " =l shl " + il + ", 3")
              qbe_emit(g, ep + " =l add " + dp + ", " + off)
              let old_v = qbe_load_heap_slot(g, ep, elem)
              let rv = qbe_emit_expr(g, rhs, Some(elem))
              let new_v = qbe_emit_compound_binop(g, op, old_v, rv, elem)
              if qbe_is_prim_array_elem(elem) {
                qbe_store_heap_slot(g, new_v, ep, elem)
              } else {
                let vl = qbe_as_l(g, qval(new_v, elem))
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, elem, true)
                qbe_emit(
                  g,
                  "call $pion_arr_set(l " + ov.reg + ", l " + il + ", l " + vl + ")",
                )
                qbe_rc_dec(g, new_v, elem)
              }
            }
            TMap(kty, vty) => {
              let kv = qbe_emit_expr(g, idx, Some(kty))
              let kl = qbe_as_l(g, kv)
              let old_l = qbe_tmp(g)
              qbe_emit(
                g,
                old_l + " =l call $pion_map_get(l " + ov.reg + ", l " + kl + ")",
              )
              let old_v = match vty {
                TInt | TUInt => {
                  let w = qbe_tmp(g)
                  qbe_emit(g, w + " =w copy " + old_l)
                  w
                }
                TDouble => {
                  let d = qbe_tmp(g)
                  qbe_emit(g, d + " =d cast " + old_l)
                  d
                }
                TFloat => qbe_from_l(g, old_l, TFloat)
                _ => old_l
              }
              let rv = qbe_emit_expr(g, rhs, Some(vty))
              let new_v = qbe_emit_compound_binop(g, op, old_v, rv, vty)
              let vl = qbe_as_l(g, qval(new_v, vty))
              qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, true)
              qbe_emit(
                g,
                "call $pion_map_set(l " + ov.reg + ", l " + kl + ", l " + vl + ")",
              )
              qbe_rc_dec(g, kv.reg, kv.ty)
              if qbe_is_obj_ty(vty) {
                qbe_rc_dec(g, new_v, vty)
              }
            }
            _ => ()
          }
          qbe_rc_dec(g, ov.reg, ov.ty)
          qval("0", TUnit)
        }
        _ => {
          let rv = qbe_emit_expr(g, rhs, None)
          qbe_rc_dec(g, rv.reg, rv.ty)
          qval("0", TUnit)
        }
      }
    }
    SGuard(cond, else_body, sp) => {
      let cur_sc = g.scopes[g.scopes.length() - 1]
      let saved_len = cur_sc.locals.length()
      let l_ok = qbe_lbl(g, "grd_ok")
      let l_else = qbe_lbl(g, "grd_el")
      if qbe_expr_has_is(cond) {
        qbe_emit_cond_branch_bind(g, cond, l_ok, l_else)
      } else {
        qbe_emit_cond_branch(g, cond, l_ok, l_else)
      }
      // Detach newly bound guard locals while emitting `else` so `else` neither sees nor frees them
      let new_locals : Array[QbeLocal] = []
      while cur_sc.locals.length() > saved_len {
        match cur_sc.locals.pop() {
          Some(loc) => new_locals.push(loc)
          None => break
        }
      }
      qbe_emit_lbl(g, l_else)
      qbe_scope_push(g)
      let ev = qbe_emit_stmts(g, else_body, None)
      if !g.block_term {
        qbe_rc_dec(g, ev.reg, ev.ty)
      }
      qbe_scope_pop(g)
      if !g.block_term {
        let msg_id = qbe_intern_cstring(g, "guard else did not diverge")
        let file_id = qbe_intern_cstring(g, sp.file)
        qbe_emit(
          g,
          "call $pion_panic(l $pion_cstr_" +
          msg_id.to_string() +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_emit_term(g, "hlt")
      }
      qbe_emit_lbl(g, l_ok)
      // Restore newly bound guard locals in original order into enclosing scope
      let mut ni = new_locals.length() - 1
      while ni >= 0 {
        cur_sc.locals.push(new_locals[ni])
        ni = ni - 1
      }
      qval("0", TUnit)
    }
    SWhile(cond, body, _) => {
      if qbe_expr_has_is(cond) {
        qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), None, body)
        let l_cond = qbe_lbl(g, "wh_c")
        let l_body = qbe_lbl(g, "wh_b")
        let l_end = qbe_lbl(g, "wh_e")
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_cond)
        let loop_depth = g.scopes.length()
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_body, l_end)
        qbe_emit_lbl(g, l_body)
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_cond)
        g.loop_depths.push(loop_depth)
        let bv = qbe_emit_stmts(g, body, None)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_end)
        return qval("0", TUnit)
      }
      qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), None, body)
      let loop_no_calls = qbe_loop_has_no_calls_expr(cond) && qbe_loop_has_no_calls_stmts(body)
      // Loop-invariant Array header (len + data pointer) & String (len + data ptr) hoisting
      let cand_arrs : Array[String] = []
      let cand_counts : Map[String, Int] = Map([])
      let cand_strs : Array[String] = []
      qbe_collect_loop_idx_expr(cond, cand_arrs, cand_counts, cand_strs, 8)
      qbe_collect_loop_idx_stmts(body, cand_arrs, cand_counts, cand_strs, 8)
      let stable_arrs : Array[String] = []
      let mut ai = 0
      while ai < cand_arrs.length() {
        let aname = cand_arrs[ai]
        if !g.hoisted_arr_len.contains(aname) {
          match qbe_lookup_local(g, aname) {
            Some(aloc) =>
              match aloc.ty {
                TArray(_) =>
                  if qbe_arr_is_stable_expr(cond, aname, true) &&
                    qbe_arr_is_stable_stmts(body, 0, aname, true) {
                    stable_arrs.push(aname)
                  }
                _ => ()
              }
            None => ()
          }
        }
        ai = ai + 1
      }
      // Register pressure budget: in loops with calls, cap hoisted arrays to top 3 hottest
      if !loop_no_calls && stable_arrs.length() > 3 {
        let mut si = 1
        while si < stable_arrs.length() {
          let cur = stable_arrs[si]
          let cur_c = match cand_counts.get(cur) {
            Some(v) => v
            None => 0
          }
          let mut sj = si - 1
          while sj >= 0 {
            let prev = stable_arrs[sj]
            let prev_c = match cand_counts.get(prev) {
              Some(v) => v
              None => 0
            }
            if prev_c < cur_c {
              stable_arrs[sj + 1] = prev
              sj = sj - 1
            } else {
              break
            }
          }
          stable_arrs[sj + 1] = cur
          si = si + 1
        }
      }
      let arr_limit = if !loop_no_calls && stable_arrs.length() > 3 {
        3
      } else {
        stable_arrs.length()
      }
      let newly_hoisted : Array[String] = []
      ai = 0
      while ai < arr_limit {
        let aname = stable_arrs[ai]
        match qbe_lookup_local(g, aname) {
          Some(aloc) => {
            let ap = qbe_tmp(g)
            let alen = qbe_tmp(g)
            let dp_p = qbe_tmp(g)
            let adp = qbe_tmp(g)
            qbe_emit(g, ap + " =l loadl " + aloc.slot)
            qbe_emit(g, alen + " =l loadl " + ap)
            qbe_emit(g, dp_p + " =l add " + ap + ", 24")
            qbe_emit(g, adp + " =l loadl " + dp_p)
            g.hoisted_arr_len.set(aname, alen)
            g.hoisted_arr_dp.set(aname, adp)
            newly_hoisted.push(aname)
          }
          None => ()
        }
        ai = ai + 1
      }
      // Loop-invariant String (len + data pointer) hoisting
      let newly_hoisted_strs : Array[String] = []
      let mut sti = 0
      while sti < cand_strs.length() {
        let sname = cand_strs[sti]
        if !g.hoisted_str_len.contains(sname) {
          match qbe_lookup_local(g, sname) {
            Some(sloc) =>
              match sloc.ty {
                TString =>
                  if !qbe_expr_assigns_ident(cond, sname) &&
                    !qbe_stmts_assigns_ident(body, sname) &&
                    !qbe_expr_rebinds_ident(cond, sname) &&
                    !qbe_stmts_rebinds_ident(body, sname) {
                    let sp_reg = qbe_tmp(g)
                    let slen = qbe_tmp(g)
                    let sdp = qbe_tmp(g)
                    qbe_emit(g, sp_reg + " =l loadl " + sloc.slot)
                    qbe_emit(g, slen + " =l loadl " + sp_reg)
                    qbe_emit(g, sdp + " =l add " + sp_reg + ", 8")
                    g.hoisted_str_len.set(sname, slen)
                    g.hoisted_str_dp.set(sname, sdp)
                    newly_hoisted_strs.push(sname)
                  }
                _ => ()
              }
            None => ()
          }
        }
        sti = sti + 1
      }
      // Conservative provably-safe Bounds Check Elimination (BCE)
      let mut added_bce_key = ""
      let bce_cond_lhs = match cond {
        EBinary("&&", lhs, rhs, _) =>
          match lhs {
            EBinary("<", EIdent(iv0, _), _, _) =>
              if !qbe_expr_assigns_ident(rhs, iv0) { lhs } else { cond }
            _ => cond
          }
        _ => cond
      }
      match bce_cond_lhs {
        EBinary("<", EIdent(iv, _), bound, _) => {
          let mut iv_ok = false
          match qbe_lookup_local(g, iv) {
            Some(iloc) =>
              match iloc.ty {
                TInt =>
                  match g.nonneg_vars.get(iv) {
                    Some(true) => iv_ok = true
                    _ => ()
                  }
                _ => ()
              }
            None => ()
          }
          if iv_ok && body.length() >= 1 && qbe_stmt_is_inc_by_one(body[body.length() - 1], iv) {
            // Ensure `iv` is never assigned anywhere else in `body[0 .. len-2]`
            let mut other_write = false
            let mut bi = 0
            while bi < body.length() - 1 {
              if qbe_stmt_assigns_ident(body[bi], iv) {
                other_write = true
                break
              }
              bi = bi + 1
            }
            if !other_write {
              let bound_arr = match bound {
                EMethodCall(EIdent(an, _), mn, ma, _) =>
                  if mn == "length" && ma.length() == 0 {
                    an
                  } else {
                    ""
                  }
                EIdent(n_name, _) =>
                  if !qbe_stmts_assigns_ident(body, n_name) {
                    match g.len_aliases.get(n_name) {
                      Some(an) => an
                      None => ""
                    }
                  } else {
                    ""
                  }
                _ => ""
              }
              let bound_stable = if bound_arr == "" {
                false
              } else if g.hoisted_arr_len.contains(bound_arr) || g.hoisted_str_len.contains(bound_arr) {
                true
              } else {
                match qbe_lookup_local(g, bound_arr) {
                  Some(bloc) =>
                    match bloc.ty {
                      TString =>
                        !qbe_expr_assigns_ident(cond, bound_arr) &&
                        !qbe_stmts_assigns_ident(body, bound_arr) &&
                        !qbe_expr_rebinds_ident(cond, bound_arr) &&
                        !qbe_stmts_rebinds_ident(body, bound_arr)
                      _ =>
                        qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                        qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                    }
                  None => false
                }
              }
              if bound_stable {
                let bkey = iv + ":" + bound_arr
                if !g.bce_safe_indices.contains(bkey) {
                  g.bce_safe_indices.set(bkey, "1")
                  added_bce_key = bkey
                }
              }
            }
          }
        }
        _ => ()
      }
      // Loop-invariant struct field hoisting:
      // - Immutable struct fields (`!field_muts[fi]`) can ALWAYS be hoisted (including String/Bytes/Array)
      //   as long as the struct local itself is not reassigned or rebound in the loop, even if other
      //   mutable fields of the same struct are mutated or calls occur in the loop.
      // - Mutable primitive fields are hoisted only when the loop has no calls and the field is never written.
      let newly_hoisted_fields : Array[String] = []
      let written_fields : Map[String, Bool] = Map([])
      if loop_no_calls {
        qbe_collect_written_fields_expr(cond, written_fields)
        qbe_collect_written_fields_stmts(body, written_fields)
      }
      let read_vars : Array[String] = []
      let read_fnames : Array[String] = []
      let read_seen : Map[String, Bool] = Map([])
      qbe_collect_read_fields_expr(cond, read_vars, read_fnames, read_seen)
      qbe_collect_read_fields_stmts(body, read_vars, read_fnames, read_seen)
      let loaded_ptrs : Map[String, String] = Map([])
      let mut rfi = 0
      while rfi < read_vars.length() {
        let vname = read_vars[rfi]
        let fname = read_fnames[rfi]
        let fkey = vname + "." + fname
        if !g.hoisted_fields.contains(fkey) {
          match qbe_lookup_local(g, vname) {
            Some(loc) =>
              match loc.ty {
                TStruct(sname, sargs) =>
                  if !qbe_expr_assigns_ident(cond, vname) &&
                    !qbe_stmts_assigns_ident(body, vname) &&
                    !qbe_expr_rebinds_ident(cond, vname) &&
                    !qbe_stmts_rebinds_ident(body, vname) {
                    match qbe_lookup_struct_info(g, sname) {
                      Some(sinfo) => {
                        let subst = make_subst(sinfo.decl.type_params, sargs)
                        let mut fi = 0
                        while fi < sinfo.field_names.length() {
                          if sinfo.field_names[fi] == fname {
                            let fty = subst_ty(sinfo.field_tys[fi], subst)
                            let is_immut = !sinfo.field_muts[fi]
                            let is_prim = match fty {
                              TInt | TInt64 | TDouble | TBool | TByte | TChar => true
                              _ => false
                            }
                            let is_hoistable_immut = match fty {
                              TInt | TInt64 | TDouble | TBool | TByte | TChar | TString | TBytes | TArray(_) =>
                                true
                              _ => false
                            }
                            let can_hoist = if is_immut {
                              is_hoistable_immut
                            } else {
                              loop_no_calls && !written_fields.contains(fname) && is_prim
                            }
                            if can_hoist {
                              let ptr_reg = match loaded_ptrs.get(vname) {
                                Some(pr) => pr
                                None => {
                                  let pr = qbe_tmp(g)
                                  qbe_emit(g, pr + " =l loadl " + loc.slot)
                                  loaded_ptrs.set(vname, pr)
                                  pr
                                }
                              }
                              let fp = qbe_tmp(g)
                              qbe_emit(
                                g,
                                fp + " =l add " + ptr_reg + ", " + (fi * 8).to_string(),
                              )
                              let fv = qbe_load_heap_slot(g, fp, fty)
                              g.hoisted_fields.set(fkey, qval(fv, fty))
                              newly_hoisted_fields.push(fkey)
                              match fty {
                                TString =>
                                  if !g.hoisted_str_len.contains(fkey) {
                                    let slen = qbe_tmp(g)
                                    let sdp = qbe_tmp(g)
                                    qbe_emit(g, slen + " =l loadl " + fv)
                                    qbe_emit(g, sdp + " =l add " + fv + ", 8")
                                    g.hoisted_str_len.set(fkey, slen)
                                    g.hoisted_str_dp.set(fkey, sdp)
                                    newly_hoisted_strs.push(fkey)
                                  }
                                _ => ()
                              }
                            }
                            break
                          }
                          fi = fi + 1
                        }
                      }
                      None => ()
                    }
                  }
                _ => ()
              }
            None => ()
          }
        }
        rfi = rfi + 1
      }
      let mut emitted_loop = false
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_bce_versioned(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_field_promoted(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_sq_reuse(g, cond, body)
      }
      if !emitted_loop {
        if qbe_is_pure_small_cond(cond, 12) {
          let l_body = qbe_lbl(g, "wh_b")
          let l_cond = qbe_lbl(g, "wh_c")
          let l_end = qbe_lbl(g, "wh_e")
          qbe_emit_cond_branch(g, cond, l_body, l_end)
          qbe_emit_lbl(g, l_body)
          let loop_depth = g.scopes.length()
          g.loop_breaks.push(l_end)
          g.loop_conts.push(l_cond)
          g.loop_depths.push(loop_depth)
          qbe_scope_push(g)
          let bv = qbe_emit_stmts(g, body, None)
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
          let _ = g.loop_breaks.pop()
          let _ = g.loop_conts.pop()
          let _ = g.loop_depths.pop()
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_cond)
          qbe_emit_cond_branch(g, cond, l_body, l_end)
          qbe_emit_lbl(g, l_end)
        } else {
          let l_cond = qbe_lbl(g, "wh_c")
          let l_body = qbe_lbl(g, "wh_b")
          let l_end = qbe_lbl(g, "wh_e")
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_cond)
          qbe_emit_cond_branch(g, cond, l_body, l_end)
          qbe_emit_lbl(g, l_body)
          let loop_depth = g.scopes.length()
          g.loop_breaks.push(l_end)
          g.loop_conts.push(l_cond)
          g.loop_depths.push(loop_depth)
          qbe_scope_push(g)
          let bv = qbe_emit_stmts(g, body, None)
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
          let _ = g.loop_breaks.pop()
          let _ = g.loop_conts.pop()
          let _ = g.loop_depths.pop()
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_end)
        }
      }
      if added_bce_key != "" {
        g.bce_safe_indices.remove(added_bce_key)
      }
      let mut hi = 0
      while hi < newly_hoisted.length() {
        let aname = newly_hoisted[hi]
        g.hoisted_arr_len.remove(aname)
        g.hoisted_arr_dp.remove(aname)
        hi = hi + 1
      }
      let mut hsi = 0
      while hsi < newly_hoisted_strs.length() {
        let sname = newly_hoisted_strs[hsi]
        g.hoisted_str_len.remove(sname)
        g.hoisted_str_dp.remove(sname)
        hsi = hsi + 1
      }
      let mut hfi = 0
      while hfi < newly_hoisted_fields.length() {
        g.hoisted_fields.remove(newly_hoisted_fields[hfi])
        hfi = hfi + 1
      }
      qval("0", TUnit)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_scope_push(g)
      let _ = qbe_emit_stmt(g, init_s, None, false)
      qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), Some(step_s), body)
      let l_cond = qbe_lbl(g, "for_c")
      let l_body = qbe_lbl(g, "for_b")
      let l_step = qbe_lbl(g, "for_s")
      let l_end = qbe_lbl(g, "for_e")
      qbe_emit_term(g, "jmp " + l_cond)
      qbe_emit_lbl(g, l_cond)
      qbe_emit_cond_branch(g, cond, l_body, l_end)
      qbe_emit_lbl(g, l_body)
      let loop_depth = g.scopes.length()
      g.loop_breaks.push(l_end)
      g.loop_conts.push(l_step)
      g.loop_depths.push(loop_depth)
      qbe_scope_push(g)
      let bv = qbe_emit_stmts(g, body, None)
      if !g.block_term {
        qbe_rc_dec(g, bv.reg, bv.ty)
      }
      qbe_scope_pop(g)
      let _ = g.loop_breaks.pop()
      let _ = g.loop_conts.pop()
      let _ = g.loop_depths.pop()
      qbe_emit_term(g, "jmp " + l_step)
      qbe_emit_lbl(g, l_step)
      let _ = qbe_emit_stmt(g, step_s, None, false)
      qbe_emit_term(g, "jmp " + l_cond)
      qbe_emit_lbl(g, l_end)
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SForRange(var_name, start_e, end_e, inclusive, body, sp) => {
      qbe_scope_push(g)
      let sv = qbe_emit_expr(g, start_e, Some(TInt))
      let ev = qbe_emit_expr(g, end_e, Some(sv.ty))
      let idx_ty = sv.ty
      let end_name = "__pion_fe_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let end_loc = qbe_define_local(g, end_name, idx_ty, false)
      qbe_store_local_slot(g, ev.reg, end_loc.slot, idx_ty)
      let idx_name = if var_name == "_" {
        let nm = "__pion_fi_" + g.next_tmp.to_string()
        g.next_tmp = g.next_tmp + 1
        nm
      } else {
        var_name
      }
      let idx_loc = qbe_define_local(g, idx_name, idx_ty, false)
      qbe_store_local_slot(g, sv.reg, idx_loc.slot, idx_ty)
      match start_e {
        EInt(raw, _) =>
          if qbe_parse_int64_lit(raw) >= 0L {
            g.nonneg_vars.set(idx_name, true)
          }
        _ => ()
      }
      let one_expr = match idx_ty {
        TInt64 => EInt64("1L", sp)
        _ => EInt("1", sp)
      }
      let step_s = SAssign(
        EIdent(idx_name, sp),
        EBinary("+", EIdent(idx_name, sp), one_expr, sp),
        sp,
      )
      qbe_invalidate_escaping_unfrozen_arrs(g, None, None, body)
      if inclusive {
        let l_body = qbe_lbl(g, "fori_b")
        let l_step = qbe_lbl(g, "fori_s")
        let l_inc = qbe_lbl(g, "fori_i")
        let l_end = qbe_lbl(g, "fori_e")
        let init_cond = EBinary("<=", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        qbe_emit_cond_branch(g, init_cond, l_body, l_end)
        qbe_emit_lbl(g, l_body)
        let loop_depth = g.scopes.length()
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_step)
        g.loop_depths.push(loop_depth)
        qbe_scope_push(g)
        let bv = qbe_emit_stmts(g, body, None)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        qbe_emit_term(g, "jmp " + l_step)
        qbe_emit_lbl(g, l_step)
        let done_cond = EBinary("==", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        qbe_emit_cond_branch(g, done_cond, l_end, l_inc)
        qbe_emit_lbl(g, l_inc)
        let _ = qbe_emit_stmt(g, step_s, None, false)
        qbe_emit_term(g, "jmp " + l_body)
        qbe_emit_lbl(g, l_end)
      } else {
        let cond_e = EBinary("<", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        if qbe_stmts_has_cf(body, false, true, false) {
          let l_cond = qbe_lbl(g, "forr_c")
          let l_body = qbe_lbl(g, "forr_b")
          let l_step = qbe_lbl(g, "forr_s")
          let l_end = qbe_lbl(g, "forr_e")
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_cond)
          qbe_emit_cond_branch(g, cond_e, l_body, l_end)
          qbe_emit_lbl(g, l_body)
          let loop_depth = g.scopes.length()
          g.loop_breaks.push(l_end)
          g.loop_conts.push(l_step)
          g.loop_depths.push(loop_depth)
          qbe_scope_push(g)
          let bv = qbe_emit_stmts(g, body, None)
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
          let _ = g.loop_breaks.pop()
          let _ = g.loop_conts.pop()
          let _ = g.loop_depths.pop()
          qbe_emit_term(g, "jmp " + l_step)
          qbe_emit_lbl(g, l_step)
          let _ = qbe_emit_stmt(g, step_s, None, false)
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_end)
        } else {
          let wbody : Array[Stmt] = []
          let mut bi = 0
          while bi < body.length() {
            wbody.push(body[bi])
            bi = bi + 1
          }
          wbody.push(step_s)
          let _ = qbe_emit_stmt(g, SWhile(cond_e, wbody, sp), None, false)
        }
      }
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SForIn(user_idx_name, var_name, iter_e, body, sp) => {
      qbe_scope_push(g)
      let av = qbe_emit_expr(g, iter_e, None)
      qbe_invalidate_escaping_unfrozen_arrs(g, None, None, body)
      let arr_name = "__pion_fa_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let arr_loc = qbe_define_local(g, arr_name, av.ty, qbe_is_obj_ty(av.ty))
      qbe_store_local_slot(g, av.reg, arr_loc.slot, av.ty)
      let len_name = "__pion_fl_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let len_r64 = qbe_tmp(g)
      let len_rw = qbe_tmp(g)
      qbe_emit(g, len_r64 + " =l loadl " + av.reg)
      qbe_emit(g, len_rw + " =w copy " + len_r64)
      let len_loc = qbe_define_local(g, len_name, TInt, false)
      qbe_store_local_slot(g, len_rw, len_loc.slot, TInt)
      let idx_name = "__pion_fi_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let idx_loc = qbe_define_local(g, idx_name, TInt, false)
      qbe_store_local_slot(g, "0", idx_loc.slot, TInt)
      g.nonneg_vars.set(idx_name, true)
      g.len_aliases.set(len_name, arr_name)
      g.len_alias_keys.push(len_name)
      let cond_e = EBinary("<", EIdent(idx_name, sp), EIdent(len_name, sp), sp)
      let step_s = SAssign(
        EIdent(idx_name, sp),
        EBinary("+", EIdent(idx_name, sp), EInt("1", sp), sp),
        sp,
      )
      let elem_bind = SLet(
        var_name,
        false,
        TyMissing(sp),
        EIndex(EIdent(arr_name, sp), EIdent(idx_name, sp), sp),
        sp,
      )
      let has_user_idx = user_idx_name != "" && user_idx_name != "_"
      let idx_bind = SLet(
        user_idx_name,
        false,
        TyMissing(sp),
        EIdent(idx_name, sp),
        sp,
      )
      if qbe_stmts_has_cf(body, false, true, false) {
        let l_cond = qbe_lbl(g, "fori_c")
        let l_body = qbe_lbl(g, "fori_b")
        let l_step = qbe_lbl(g, "fori_s")
        let l_end = qbe_lbl(g, "fori_e")
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_cond)
        qbe_emit_cond_branch(g, cond_e, l_body, l_end)
        qbe_emit_lbl(g, l_body)
        let loop_depth = g.scopes.length()
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_step)
        g.loop_depths.push(loop_depth)
        qbe_scope_push(g)
        let fbody : Array[Stmt] = []
        if has_user_idx {
          fbody.push(idx_bind)
        }
        fbody.push(elem_bind)
        let mut bi = 0
        while bi < body.length() {
          fbody.push(body[bi])
          bi = bi + 1
        }
        let bv = qbe_emit_stmts(g, fbody, None)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        qbe_emit_term(g, "jmp " + l_step)
        qbe_emit_lbl(g, l_step)
        let _ = qbe_emit_stmt(g, step_s, None, false)
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_end)
      } else {
        let wbody : Array[Stmt] = []
        if has_user_idx {
          wbody.push(idx_bind)
        }
        wbody.push(elem_bind)
        let mut bi = 0
        while bi < body.length() {
          wbody.push(body[bi])
          bi = bi + 1
        }
        wbody.push(step_s)
        let _ = qbe_emit_stmt(g, SWhile(cond_e, wbody, sp), None, false)
      }
      g.len_aliases.remove(len_name)
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SReturn(opt, _) => {
      let target_abi_ty = g.cur_ret_abi_ty
      let old_mov = g.movable_locals
      let old_moved = g.moved_slots
      let mut did_ret_mov = false
      let rv = match opt {
        Some(e) => {
          if qbe_expr_is_straight_line_movable(e) {
            let mov_map : Map[String, String] = Map([])
            let seen_n : Map[String, Bool] = Map([])
            let mut si = g.scopes.length() - 1
            while si >= 0 {
              let sc = g.scopes[si]
              let mut li = sc.locals.length() - 1
              while li >= 0 {
                let loc = sc.locals[li]
                if !seen_n.contains(loc.name) {
                  seen_n.set(loc.name, true)
                  if loc.owned &&
                    qbe_is_early_drop_ty(loc.ty) &&
                    !g.zeroed_slots.contains(loc.slot) &&
                    qbe_expr_count_mentions(e, loc.name) == 1 {
                    mov_map.set(loc.name, loc.slot)
                  }
                }
                li = li - 1
              }
              si = si - 1
            }
            if mov_map.length() > 0 {
              g.movable_locals = mov_map
              g.moved_slots = Map([])
              did_ret_mov = true
            }
          }
          let ev = qbe_emit_expr(g, e, Some(g.cur_ret_ty))
          qbe_coerce_val(g, ev, target_abi_ty)
        }
        None => qbe_zero_reg(target_abi_ty)
      }
      qbe_release_scopes_down_to(g, 0)
      if did_ret_mov {
        g.movable_locals = old_mov
        g.moved_slots = old_moved
      }
      if g.cur_fn_void {
        qbe_emit_term(g, "ret")
      } else {
        qbe_emit_term(g, "ret " + rv)
      }
      qval("0", TNever)
    }
    SBreak(_) => {
      if g.loop_breaks.length() > 0 {
        let lbl = g.loop_breaks[g.loop_breaks.length() - 1]
        let depth = g.loop_depths[g.loop_depths.length() - 1]
        qbe_release_scopes_down_to(g, depth)
        qbe_emit_term(g, "jmp " + lbl)
      }
      qval("0", TNever)
    }
    SContinue(_) => {
      if g.loop_conts.length() > 0 {
        let lbl = g.loop_conts[g.loop_conts.length() - 1]
        let depth = g.loop_depths[g.loop_depths.length() - 1]
        qbe_release_scopes_down_to(g, depth)
        qbe_emit_term(g, "jmp " + lbl)
      }
      qval("0", TNever)
    }
    SDebugAssert(cond, msg, sp) => {
      if !g.release {
        let cv = qbe_emit_expr(g, cond, Some(TBool))
        let mv = qbe_emit_expr(g, msg, Some(TString))
        let cw = qbe_tmp(g)
        qbe_emit(g, cw + " =w copy " + cv.reg)
        let file_id = qbe_intern_cstring(g, sp.file)
        qbe_emit(
          g,
          "call $pion_debug_assert(w " +
          cw +
          ", l " +
          mv.reg +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_rc_dec(g, mv.reg, mv.ty)
      }
      qval("0", TUnit)
    }
    SExpr(e, _) => {
      if !is_tail {
        match e {
          EIf(cond, then_stmts, else_opt, sp) =>
            match qbe_try_collect_if_switch(g, cond, then_stmts, else_opt) {
              Some(plan) =>
                match qbe_lookup_local(g, plan.vname) {
                  Some(vloc) => {
                    let vreg = qbe_load_local_slot(g, vloc.slot, TInt)
                    return qbe_emit_int_dispatch(
                      g,
                      vreg,
                      plan.arms,
                      plan.default_opt,
                      "",
                      false,
                      sp,
                      None,
                      true,
                    )
                  }
                  None => ()
                }
              None => ()
            }
          _ => ()
        }
      }
      let v = qbe_emit_expr(g, e, if is_tail { expected } else { None })
      if !is_tail {
        qbe_rc_dec(g, v.reg, v.ty)
        qval("0", TUnit)
      } else {
        v
      }
    }
  }
}

///|
fn qbe_emit_bytes_data(sb : StringBuilder, s : String) -> Int {
  let bytes = str_to_utf8_ints(s)
  let mut i = 0
  while i < bytes.length() {
    sb.write_string("b ")
    sb.write_string(bytes[i].to_string())
    sb.write_string(", ")
    i = i + 1
  }
  sb.write_string("b 0")
  bytes.length()
}

///|
fn qbe_emit_fn_decl(g : QbeGen, fd : FnDecl) -> String {
  if fd.type_bounds.length() > 0 {
    return ""
  }
  let finfo_opt = if fd.receiver_type != "" {
    g.tc.methods.get(fd.receiver_type + "::" + fd.name)
  } else {
    g.tc.fns.get(fd.name)
  }
  match finfo_opt {
    None => ""
    Some(finfo) => {
      g.fn_allocs = StringBuilder()
      g.fn_body = StringBuilder()
      g.scopes = []
      g.loop_breaks = []
      g.loop_conts = []
      g.loop_depths = []
      g.cur_tparams = fd.type_params
      g.cur_type_subst = Map([])
      g.cur_ret_ty = finfo.ret_ty
      g.cur_ret_abi_ty = finfo.ret_ty
      g.cur_fn_void = false
      g.block_term = false
      g.hoisted_arr_len = Map([])
      g.hoisted_arr_dp = Map([])
      g.hoisted_str_len = Map([])
      g.hoisted_str_dp = Map([])
      g.hoisted_fields = Map([])
      g.block_immut_fields = Map([])
      g.len_aliases = Map([])
      g.len_alias_keys = []
      g.nonneg_vars = Map([])
      g.bce_safe_indices = Map([])
      g.bce_safe_exprs = Map([])
      g.movable_locals = Map([])
      g.moved_slots = Map([])
      g.zeroed_slots = Map([])
      g.sq_reuse_slot = Map([])
      g.sq_reuse_state = Map([])
      g.promoted_fields = Map([])
      g.promoted_field_tys = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext = Map([])
      g.unfrozen_local_arrs = Map([])

      qbe_scope_push(g)
      let mut pi = 0
      while pi < fd.params.length() && pi < finfo.param_tys.length() {
        let loc = qbe_define_local(g, fd.params[pi].name, finfo.param_tys[pi], false)
        qbe_store_local_slot(g, "%p" + pi.to_string(), loc.slot, finfo.param_tys[pi])
        pi = pi + 1
      }
      let bres = qbe_emit_stmts(g, fd.body, Some(finfo.ret_ty))
      if !g.block_term {
        let ret_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
        qbe_scope_pop(g)
        qbe_emit_term(g, "ret " + ret_reg)
      } else {
        let _ = g.scopes.pop()
      }

      let out = StringBuilder()
      let sym = if fd.receiver_type != "" {
        qbe_local_method_sym(g, fd.receiver_type, fd.name)
      } else {
        qbe_local_fn_sym(g, fd.name)
      }
      if fd.is_pub || g.unit_mode || g.export_internals {
        out.write_string("export ")
      }
      out.write_string("function ")
      out.write_string(qbe_abi_ty(finfo.ret_ty))
      out.write_string(" ")
      out.write_string(sym)
      out.write_string("(")
      pi = 0
      while pi < fd.params.length() {
        if pi > 0 {
          out.write_string(", ")
        }
        let p_abi = if pi < finfo.param_tys.length() {
          qbe_abi_ty(finfo.param_tys[pi])
        } else {
          "l"
        }
        out.write_string(p_abi)
        out.write_string(" %p")
        out.write_string(pi.to_string())
        pi = pi + 1
      }
      let mut tpi = 0
      while tpi < fd.type_params.length() {
        if fd.params.length() > 0 || tpi > 0 {
          out.write_string(", ")
        }
        out.write_string("l %tp_")
        out.write_string(fd.type_params[tpi])
        tpi = tpi + 1
      }
      out.write_string(") {\n@start\n")
      out.write_string(g.fn_allocs.to_string())
      out.write_string(g.fn_body.to_string())
      out.write_string("}\n\n")
      out.to_string()
    }
  }
}

///|
fn qbe_emit_extern_fn_decl(g : QbeGen, ed : ExternFnDecl) -> String {
  if !ed.has_body {
    return ""
  }
  match g.tc.extern_fns.get(ed.name) {
    None => ""
    Some(einfo) => {
      let is_unit = match einfo.ret_ty {
        TUnit => true
        _ => false
      }
      let c_ret_abi = qbe_c_abi_ty(einfo.ret_ty)
      let ret_abi_ty = if c_ret_abi == "w" {
        TInt
      } else {
        einfo.ret_ty
      }
      g.fn_allocs = StringBuilder()
      g.fn_body = StringBuilder()
      g.scopes = []
      g.loop_breaks = []
      g.loop_conts = []
      g.loop_depths = []
      g.cur_tparams = []
      g.cur_type_subst = Map([])
      g.cur_ret_ty = einfo.ret_ty
      g.cur_ret_abi_ty = ret_abi_ty
      g.cur_fn_void = is_unit
      g.block_term = false
      g.hoisted_arr_len = Map([])
      g.hoisted_arr_dp = Map([])
      g.hoisted_str_len = Map([])
      g.hoisted_str_dp = Map([])
      g.hoisted_fields = Map([])
      g.block_immut_fields = Map([])
      g.len_aliases = Map([])
      g.len_alias_keys = []
      g.nonneg_vars = Map([])
      g.bce_safe_indices = Map([])
      g.bce_safe_exprs = Map([])
      g.movable_locals = Map([])
      g.moved_slots = Map([])
      g.zeroed_slots = Map([])
      g.sq_reuse_slot = Map([])
      g.sq_reuse_state = Map([])
      g.promoted_fields = Map([])
      g.promoted_field_tys = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext = Map([])
      g.unfrozen_local_arrs = Map([])

      qbe_scope_push(g)
      let mut pi = 0
      while pi < ed.params.length() && pi < einfo.param_tys.length() {
        let pty = einfo.param_tys[pi]
        let loc = qbe_define_local(g, ed.params[pi].name, pty, false)
        let raw_p = "%p" + pi.to_string()
        let p_reg = match pty {
          TBool | TChar => {
            let ext = qbe_tmp(g)
            qbe_emit(g, ext + " =l extuw " + raw_p)
            ext
          }
          TByte => {
            let ext = qbe_tmp(g)
            qbe_emit(g, ext + " =l extub " + raw_p)
            ext
          }
          _ => raw_p
        }
        qbe_store_local_slot(g, p_reg, loc.slot, pty)
        pi = pi + 1
      }
      let bres = qbe_emit_stmts(g, ed.body, Some(einfo.ret_ty))
      if !g.block_term {
        if is_unit {
          qbe_rc_dec(g, bres.reg, bres.ty)
          qbe_scope_pop(g)
          qbe_emit_term(g, "ret")
        } else {
          let ret_reg = qbe_coerce_val(g, bres, ret_abi_ty)
          qbe_scope_pop(g)
          qbe_emit_term(g, "ret " + ret_reg)
        }
      } else {
        let _ = g.scopes.pop()
      }

      let out = StringBuilder()
      out.write_string("export function ")
      if !is_unit {
        out.write_string(c_ret_abi)
        out.write_string(" ")
      }
      out.write_string("$")
      out.write_string(ed.c_symbol)
      out.write_string("(")
      pi = 0
      while pi < ed.params.length() {
        if pi > 0 {
          out.write_string(", ")
        }
        let p_abi = if pi < einfo.param_tys.length() {
          qbe_c_abi_ty(einfo.param_tys[pi])
        } else {
          "l"
        }
        out.write_string(p_abi)
        out.write_string(" %p")
        out.write_string(pi.to_string())
        pi = pi + 1
      }
      out.write_string(") {\n@start\n")
      out.write_string(g.fn_allocs.to_string())
      out.write_string(g.fn_body.to_string())
      out.write_string("}\n\n")
      out.to_string()
    }
  }
}

///|
fn qbe_emit_impl_method(g : QbeGen, id : ImplDecl, md : FnDecl) -> String {
  let c_trait = canon_trait_name(g.tc, id.trait_name)
  let c_target = canon_target_type_name(g.tc, id.target_type)
  let impl_key = c_trait + "::" + c_target
  match g.tc.impls.get(impl_key) {
    None => ""
    Some(iinfo) =>
      match iinfo.methods.get(md.name) {
        None => ""
        Some(finfo) => {
          g.fn_allocs = StringBuilder()
          g.fn_body = StringBuilder()
          g.scopes = []
          g.loop_breaks = []
          g.loop_conts = []
          g.loop_depths = []
          g.cur_tparams = []
          g.cur_type_subst = Map([])
          g.cur_ret_ty = finfo.ret_ty
          g.cur_ret_abi_ty = finfo.ret_ty
          g.cur_fn_void = false
          g.block_term = false
          g.hoisted_arr_len = Map([])
          g.hoisted_arr_dp = Map([])
          g.hoisted_str_len = Map([])
          g.hoisted_str_dp = Map([])
          g.hoisted_fields = Map([])
          g.block_immut_fields = Map([])
          g.len_aliases = Map([])
          g.len_alias_keys = []
          g.nonneg_vars = Map([])
          g.bce_safe_indices = Map([])
          g.bce_safe_exprs = Map([])
          g.movable_locals = Map([])
          g.moved_slots = Map([])
          g.zeroed_slots = Map([])
          g.sq_reuse_slot = Map([])
          g.sq_reuse_state = Map([])
          g.promoted_fields = Map([])
          g.promoted_field_tys = Map([])
          g.w_to_l_ext = Map([])
          g.local_w_to_l_ext = Map([])
          g.unfrozen_local_arrs = Map([])

          qbe_scope_push(g)
          let mut pi = 0
          while pi < md.params.length() && pi < finfo.param_tys.length() {
            let loc = qbe_define_local(g, md.params[pi].name, finfo.param_tys[pi], false)
            qbe_store_local_slot(g, "%p" + pi.to_string(), loc.slot, finfo.param_tys[pi])
            pi = pi + 1
          }
          let bres = qbe_emit_stmts(g, md.body, Some(finfo.ret_ty))
          if !g.block_term {
            let ret_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
            qbe_scope_pop(g)
            qbe_emit_term(g, "ret " + ret_reg)
          } else {
            let _ = g.scopes.pop()
          }

          let out = StringBuilder()
          let sym = qbe_impl_method_sym(
            g,
            iinfo.pkg_name,
            iinfo.trait_name,
            iinfo.target_type,
            md.name,
          )
          if g.tc.multi_pkg || g.unit_mode {
            out.write_string("export ")
          }
          out.write_string("function ")
          out.write_string(qbe_abi_ty(finfo.ret_ty))
          out.write_string(" ")
          out.write_string(sym)
          out.write_string("(")
          pi = 0
          while pi < md.params.length() {
            if pi > 0 {
              out.write_string(", ")
            }
            let p_abi = if pi < finfo.param_tys.length() {
              qbe_abi_ty(finfo.param_tys[pi])
            } else {
              "l"
            }
            out.write_string(p_abi)
            out.write_string(" %p")
            out.write_string(pi.to_string())
            pi = pi + 1
          }
          out.write_string(") {\n@start\n")
          out.write_string(g.fn_allocs.to_string())
          out.write_string(g.fn_body.to_string())
          out.write_string("}\n\n")
          out.to_string()
        }
      }
  }
}

///|
fn qbe_emit_mono_fn(g : QbeGen, req : QbeMonoReq) -> String {
  let fd = req.finfo.decl
  let saved_mono_pkg = g.mono_pkg
  g.mono_pkg = req.pkg
  let concrete_ptys : Array[Ty] = []
  let mut pi = 0
  while pi < req.finfo.param_tys.length() {
    concrete_ptys.push(subst_ty(req.finfo.param_tys[pi], req.subst))
    pi = pi + 1
  }
  let concrete_ret = subst_ty(req.finfo.ret_ty, req.subst)

  g.fn_allocs = StringBuilder()
  g.fn_body = StringBuilder()
  g.scopes = []
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.cur_tparams = fd.type_params
  g.cur_type_subst = req.subst
  g.cur_ret_ty = concrete_ret
  g.cur_ret_abi_ty = concrete_ret
  g.cur_fn_void = false
  g.block_term = false
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.zeroed_slots = Map([])
  g.sq_reuse_slot = Map([])
  g.sq_reuse_state = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])

  qbe_scope_push(g)
  pi = 0
  while pi < fd.params.length() && pi < concrete_ptys.length() {
    let loc = qbe_define_local(g, fd.params[pi].name, concrete_ptys[pi], false)
    qbe_store_local_slot(g, "%p" + pi.to_string(), loc.slot, concrete_ptys[pi])
    pi = pi + 1
  }
  let bres = qbe_emit_stmts(g, fd.body, Some(concrete_ret))
  if !g.block_term {
    let ret_reg = qbe_coerce_val(g, bres, concrete_ret)
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret " + ret_reg)
  } else {
    let _ = g.scopes.pop()
  }
  g.cur_type_subst = Map([])
  g.cur_tparams = []
  g.mono_pkg = saved_mono_pkg

  let out = StringBuilder()
  out.write_string("function ")
  out.write_string(qbe_abi_ty(concrete_ret))
  out.write_string(" ")
  out.write_string(req.sym)
  out.write_string("(")
  pi = 0
  while pi < fd.params.length() {
    if pi > 0 {
      out.write_string(", ")
    }
    let p_abi = if pi < concrete_ptys.length() {
      qbe_abi_ty(concrete_ptys[pi])
    } else {
      "l"
    }
    out.write_string(p_abi)
    out.write_string(" %p")
    out.write_string(pi.to_string())
    pi = pi + 1
  }
  out.write_string(") {\n@start\n")
  out.write_string(g.fn_allocs.to_string())
  out.write_string(g.fn_body.to_string())
  out.write_string("}\n\n")
  out.to_string()
}

///|
fn qbe_drain_mono_queue(g : QbeGen, out : StringBuilder) -> Unit {
  while g.mono_emitted < g.mono_queue.length() {
    let req = g.mono_queue[g.mono_emitted]
    g.mono_emitted = g.mono_emitted + 1
    out.write_string(qbe_emit_mono_fn(g, req))
  }
}

///|
fn qbe_emit_struct_drops(g : QbeGen, out : StringBuilder) -> Unit {
  let mut i = 0
  while i < g.struct_order.length() {
    let sname = g.struct_order[i]
    match qbe_lookup_struct_info(g, sname) {
      Some(sinfo) =>
        if sinfo.decl.type_params.length() == 0 {
          let obj_slots : Array[Int] = []
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            if qbe_is_obj_ty(sinfo.field_tys[fi]) {
              obj_slots.push(fi)
            }
            fi = fi + 1
          }
          if obj_slots.length() > 0 {
            if g.unit_mode && !has_qual_sep(sname) {
              out.write_string("export ")
            }
            out.write_string("function $pion_drop_struct_")
            out.write_string(qbe_sanitize_sym(sname))
            out.write_string("(l %p) {\n@start\n")
            let mut j = 0
            while j < obj_slots.length() {
              let off = obj_slots[j] * 8
              out.write_string("    %a")
              out.write_string(j.to_string())
              out.write_string(" =l add %p, ")
              out.write_string(off.to_string())
              out.write_string("\n    %v")
              out.write_string(j.to_string())
              out.write_string(" =l loadl %a")
              out.write_string(j.to_string())
              out.write_string("\n    call $pion_rc_dec(l %v")
              out.write_string(j.to_string())
              out.write_string(")\n")
              j = j + 1
            }
            out.write_string("    ret\n}\n\n")
          }
        }
      None => ()
    }
    i = i + 1
  }
}

///|
fn qbe_emit_enum_drops(g : QbeGen, out : StringBuilder) -> Unit {
  let mut i = 0
  while i < g.enum_order.length() {
    let ename = g.enum_order[i]
    match qbe_lookup_enum_info(g, ename) {
      Some(einfo) =>
        if einfo.decl.type_params.length() == 0 {
          if g.unit_mode && !has_qual_sep(ename) {
            out.write_string("export ")
          }
          out.write_string("function $pion_drop_enum_")
          out.write_string(qbe_sanitize_sym(ename))
          out.write_string("(l %p) {\n@start\n")
          out.write_string("    %tag =l loadl %p\n")
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let obj_slots : Array[Int] = []
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_is_obj_ty(v.field_tys[fi]) {
                obj_slots.push(fi)
              }
              fi = fi + 1
            }
            if obj_slots.length() > 0 {
              out.write_string("    %c")
              out.write_string(vi.to_string())
              out.write_string(" =w ceql %tag, ")
              out.write_string(vi.to_string())
              out.write_string("\n    jnz %c")
              out.write_string(vi.to_string())
              out.write_string(", @v")
              out.write_string(vi.to_string())
              out.write_string(", @n")
              out.write_string(vi.to_string())
              out.write_string("\n@v")
              out.write_string(vi.to_string())
              out.write_string("\n")
              let mut j = 0
              while j < obj_slots.length() {
                let off = (obj_slots[j] + 1) * 8
                out.write_string("    %a")
                out.write_string(vi.to_string())
                out.write_string("_")
                out.write_string(j.to_string())
                out.write_string(" =l add %p, ")
                out.write_string(off.to_string())
                out.write_string("\n    %v")
                out.write_string(vi.to_string())
                out.write_string("_")
                out.write_string(j.to_string())
                out.write_string(" =l loadl %a")
                out.write_string(vi.to_string())
                out.write_string("_")
                out.write_string(j.to_string())
                out.write_string("\n    call $pion_rc_dec(l %v")
                out.write_string(vi.to_string())
                out.write_string("_")
                out.write_string(j.to_string())
                out.write_string(")\n")
                j = j + 1
              }
              out.write_string("    ret\n@n")
              out.write_string(vi.to_string())
              out.write_string("\n")
            }
            vi = vi + 1
          }
          out.write_string("    ret\n}\n\n")
        }
      None => ()
    }
    i = i + 1
  }
}

///|
fn qbe_emit_helper_drops(g : QbeGen, out : StringBuilder) -> Unit {
  if g.need_drop_opt_obj {
    out.write_string(
      "function $pion_drop_opt_obj(l %p) {\n@start\n    %tag =l loadl %p\n    %is1 =w ceql %tag, 1\n    jnz %is1, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_res_ok {
    out.write_string(
      "function $pion_drop_res_ok(l %p) {\n@start\n    %tag =l loadl %p\n    %is0 =w ceql %tag, 0\n    jnz %is0, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_res_err {
    out.write_string(
      "function $pion_drop_res_err(l %p) {\n@start\n    %tag =l loadl %p\n    %is1 =w ceql %tag, 1\n    jnz %is1, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_dyn {
    out.write_string(
      "function $pion_drop_dyn(l %p) {\n@start\n    %vp =l add %p, 8\n    %vt =l loadl %vp\n    %is_obj =l loadl %vt\n    jnz %is_obj, @dec, @done\n@dec\n    %data =l loadl %p\n    call $pion_rc_dec(l %data)\n@done\n    ret\n}\n\n",
    )
  }
  let mut dvi = 0
  while dvi < g.dyn_vtables.length() {
    out.write_string(g.dyn_vtables[dvi])
    dvi = dvi + 1
  }
  if g.dyn_vtables.length() > 0 {
    out.write_string("\n")
  }
  let mut i = 0
  while i < g.slot_drop_keys.length() {
    let key = g.slot_drop_keys[i]
    let slots = g.slot_drop_specs[i]
    out.write_string("function $pion_drop_slots_")
    out.write_string(key)
    out.write_string("(l %p) {\n@start\n")
    let mut si = 0
    while si < slots.length() {
      let slot_idx = slots[si]
      let off = slot_idx * 8
      out.write_string("    %a")
      out.write_string(slot_idx.to_string())
      out.write_string(" =l add %p, ")
      out.write_string(off.to_string())
      out.write_string("\n    %v")
      out.write_string(slot_idx.to_string())
      out.write_string(" =l loadl %a")
      out.write_string(slot_idx.to_string())
      out.write_string("\n    call $pion_rc_dec(l %v")
      out.write_string(slot_idx.to_string())
      out.write_string(")\n")
      si = si + 1
    }
    out.write_string("    ret\n}\n\n")
    i = i + 1
  }
}

///|
fn qbe_emit_fn_wrappers(g : QbeGen, out : StringBuilder) -> Unit {
  let mut i = 0
  while i < g.fn_wrappers.length() {
    let w = g.fn_wrappers[i]
    out.write_string("function l ")
    out.write_string(w.wrap_sym)
    out.write_string("(l %env")
    let mut pi = 0
    while pi < w.param_tys.length() {
      out.write_string(", l %p")
      out.write_string(pi.to_string())
      pi = pi + 1
    }
    out.write_string(") {\n@start\n")
    pi = 0
    while pi < w.param_tys.length() {
      if qbe_is_double_ty(w.param_tys[pi]) {
        out.write_string("    %dp")
        out.write_string(pi.to_string())
        out.write_string(" =d cast %p")
        out.write_string(pi.to_string())
        out.write_string("\n")
      } else if qbe_is_int32_ty(w.param_tys[pi]) {
        out.write_string("    %wp")
        out.write_string(pi.to_string())
        out.write_string(" =w copy %p")
        out.write_string(pi.to_string())
        out.write_string("\n")
      }
      pi = pi + 1
    }
    let ret_d = qbe_is_double_ty(w.ret_ty)
    let ret_w = qbe_is_int32_ty(w.ret_ty)
    if ret_d {
      out.write_string("    %rd =d call ")
    } else if ret_w {
      out.write_string("    %rw =w call ")
    } else {
      out.write_string("    %r =l call ")
    }
    out.write_string(w.target_sym)
    out.write_string("(")
    pi = 0
    while pi < w.param_tys.length() {
      if pi > 0 {
        out.write_string(", ")
      }
      if qbe_is_double_ty(w.param_tys[pi]) {
        out.write_string("d %dp")
      } else if qbe_is_int32_ty(w.param_tys[pi]) {
        out.write_string("w %wp")
      } else {
        out.write_string("l %p")
      }
      out.write_string(pi.to_string())
      pi = pi + 1
    }
    out.write_string(")\n")
    if ret_d {
      out.write_string("    %r =l cast %rd\n")
    } else if ret_w {
      out.write_string("    %r =l extsw %rw\n")
    }
    out.write_string("    ret %r\n}\n\n")
    i = i + 1
  }
}

///|
fn build_typechecker_for_codegen(pkg : Package) -> TypeChecker {
  let tc = TypeChecker::{
    pkg_name: pkg.name,
    multi_pkg: false,
    structs: Map([]),
    struct_names: [],
    enums: Map([]),
    enum_names: [],
    variant_to_enum: Map([]),
    fns: Map([]),
    extern_fns: Map([]),
    extern_fn_names: [],
    methods: Map([]),
    method_names: [],
    traits: Map([]),
    trait_names: [],
    impls: Map([]),
    impl_keys: [],
    consts: Map([]),
    const_pub: Map([]),
    import_aliases: Map([]),
    imported_pkgs: Map([]),
    diagnostics: [],
    eq_tparams: Map([]),
    eq_keys: [],
    eq_uses: [],
    edit_keys: Map([]),
    let_infer: Map([]),
    closure_infer: Map([]),
    infer_pending: Map([]),
    infer_hit: [],
  }
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: [],
              field_muts: [],
              field_tys: [],
            },
          )
        DEnum(ed) => {
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: [] })
          let mut vi = 0
          while vi < ed.variants.length() {
            tc.variant_to_enum.set(ed.variants[vi].name, ed.name)
            vi = vi + 1
          }
        }
        DTrait(td) => {
          if !tc.traits.contains(td.name) {
            tc.trait_names.push(td.name)
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: [] })
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          let fnames : Array[String] = []
          let fmuts : Array[Bool] = []
          let ftys : Array[Ty] = []
          let mut j = 0
          while j < sd.fields.length() {
            let fld = sd.fields[j]
            fnames.push(fld.name)
            fmuts.push(fld.is_mut)
            ftys.push(resolve_type_expr(tc, fld.ty, sd.type_params))
            j = j + 1
          }
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: fnames,
              field_muts: fmuts,
              field_tys: ftys,
            },
          )
        }
        DEnum(ed) => {
          let vinfos : Array[VariantInfo] = []
          let mut vi = 0
          while vi < ed.variants.length() {
            let v = ed.variants[vi]
            let vftys : Array[Ty] = []
            let mut j = 0
            while j < v.fields.length() {
              vftys.push(resolve_type_expr(tc, v.fields[j], ed.type_params))
              j = j + 1
            }
            vinfos.push(VariantInfo::{ name: v.name, field_tys: vftys })
            vi = vi + 1
          }
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: vinfos })
        }
        DFn(fd) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < fd.params.length() {
            ptys.push(resolve_type_expr(tc, fd.params[pi].ty, fd.type_params))
            pi = pi + 1
          }
          let rty = resolve_type_expr(tc, fd.ret_ty, fd.type_params)
          let finfo = FnInfo::{ decl: fd, param_tys: ptys, ret_ty: rty }
          if fd.receiver_type != "" {
            tc.methods.set(fd.receiver_type + "::" + fd.name, finfo)
          } else {
            tc.fns.set(fd.name, finfo)
          }
        }
        DExternFn(ed) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < ed.params.length() {
            ptys.push(resolve_type_expr(tc, ed.params[pi].ty, []))
            pi = pi + 1
          }
          let rty = resolve_type_expr(tc, ed.ret_ty, [])
          tc.extern_fns.set(
            ed.name,
            ExternFnInfo::{ decl: ed, param_tys: ptys, ret_ty: rty },
          )
        }
        DTrait(td) => {
          let tmethods : Array[TraitMethodInfo] = []
          let self_tp : Array[String] = ["Self"]
          let mut mi = 0
          while mi < td.methods.length() {
            let tm = td.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < tm.params.length() {
              ptys.push(resolve_type_expr(tc, tm.params[pi].ty, self_tp))
              pi = pi + 1
            }
            let rty = resolve_type_expr(tc, tm.ret_ty, self_tp)
            tmethods.push(TraitMethodInfo::{
              name: tm.name,
              param_tys: ptys,
              ret_ty: rty,
              span: tm.span,
            })
            mi = mi + 1
          }
          if !tc.traits.contains(td.name) {
            tc.trait_names.push(td.name)
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: tmethods })
        }
        DImpl(id) => {
          let target_ty = resolve_type_expr(
            tc,
            TyName(id.target_type, [], id.span),
            [],
          )
          let self_subst : Map[String, Ty] = Map([])
          self_subst.set("Self", target_ty)
          let self_tp : Array[String] = ["Self"]
          let impl_methods : Map[String, FnInfo] = Map([])
          let impl_mnames : Array[String] = []
          let mut mi = 0
          while mi < id.methods.length() {
            let md = id.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < md.params.length() {
              let raw_p = resolve_type_expr(tc, md.params[pi].ty, self_tp)
              ptys.push(subst_ty(raw_p, self_subst))
              pi = pi + 1
            }
            let raw_r = resolve_type_expr(tc, md.ret_ty, self_tp)
            let rty = subst_ty(raw_r, self_subst)
            impl_methods.set(
              md.name,
              FnInfo::{ decl: md, param_tys: ptys, ret_ty: rty },
            )
            impl_mnames.push(md.name)
            mi = mi + 1
          }
          let impl_key = id.trait_name + "::" + id.target_type
          if !tc.impls.contains(impl_key) {
            tc.impl_keys.push(impl_key)
          }
          tc.impls.set(
            impl_key,
            ImplInfo::{
              decl: id,
              pkg_name: pkg.name,
              trait_name: id.trait_name,
              target_type: id.target_type,
              methods: impl_methods,
              method_names: impl_mnames,
            },
          )
        }
        DConst(cd) => {
          let cty = resolve_type_expr(tc, cd.ty, [])
          tc.consts.set(cd.name, cty)
          tc.const_pub.set(cd.name, cd.is_pub)
        }
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  tc
}

///|
pub fn emit_qbe_package_multi(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
) -> QbeEmitResult {
  let g = qbe_new(tc, release, false)
  let export_internals = tc.multi_pkg && pkg_has_pub_generic_fn(pkg)
  g.export_internals = export_internals
  let const_decls : Array[ConstDecl] = []

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => g.struct_order.push(sd.name)
        DEnum(ed) => g.enum_order.push(ed.name)
        DConst(cd) => {
          g.const_order.push(cd.name)
          const_decls.push(cd)
          match tc.consts.get(cd.name) {
            Some(cty) => qbe_record_scalar_const(g, cd, cty)
            None => ()
          }
        }
        DFn(_) | DExternFn(_) | DTrait(_) | DImpl(_) | DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  let init_sym = "$pion_" + g.pkg_prefix + "init_consts"
  let mut init_consts_code = ""
  if const_decls.length() > 0 || tc.multi_pkg {
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.cur_tparams = []
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    qbe_scope_push(g)
    let mut ci = 0
    while ci < const_decls.length() {
      let cd = const_decls[ci]
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, cd.value, Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(
        g,
        cv_reg,
        qbe_local_const_sym(g, cd.name),
        cty,
      )
      ci = ci + 1
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret")
    let csb = StringBuilder()
    if tc.multi_pkg {
      csb.write_string("export ")
    }
    csb.write_string("function ")
    csb.write_string(init_sym)
    csb.write_string("() {\n@start\n")
    csb.write_string(g.fn_allocs.to_string())
    csb.write_string(g.fn_body.to_string())
    csb.write_string("}\n\n")
    init_consts_code = csb.to_string()
  }

  let fns_buf = StringBuilder()
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    g.inline_fns = qbe_collect_file_inline_fns(f)
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
        DExternFn(ed) =>
          if ed.has_body {
            fns_buf.write_string(qbe_emit_extern_fn_decl(g, ed))
          }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
            mi = mi + 1
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    out.write_string(ec.tag.to_string())
    if ec.has_payload {
      out.write_string(", l ")
      out.write_string(ec.payload_val.to_string())
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    let _ = qbe_emit_bytes_data(out, s)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    let _ = qbe_emit_bytes_data(out, g.cstrings[csi])
    out.write_string(" }\n")
    csi = csi + 1
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    let cname = g.const_order[kci]
    let is_pub_c = match tc.const_pub.get(cname) {
      Some(b) => b
      None => false
    }
    if tc.multi_pkg && (is_pub_c || export_internals) {
      out.write_string("export ")
    }
    out.write_string("data ")
    out.write_string(qbe_local_const_sym(g, cname))
    out.write_string(" = align 8 { l 0 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_struct_drops(g, out)
  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  out.write_string(fns_buf.to_string())

  let mut has_main = false
  if is_entry {
    match tc.fns.get("main") {
      Some(minfo) => {
        has_main = true
        out.write_string("export function w $main(w %argc, l %argv) {\n@start\n")
        out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
        let mut dpi = 0
        while dpi < dep_pkg_names.length() {
          out.write_string("    call $pion_pkg_")
          out.write_string(qbe_sanitize_sym(dep_pkg_names[dpi]))
          out.write_string("_init_consts()\n")
          dpi = dpi + 1
        }
        if const_decls.length() > 0 || tc.multi_pkg {
          out.write_string("    call ")
          out.write_string(init_sym)
          out.write_string("()\n")
        }
        let ret_abi = qbe_abi_ty(minfo.ret_ty)
        let main_fn_sym = qbe_local_fn_sym(g, "main")
        if minfo.param_tys.length() >= 1 {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call ")
          out.write_string(main_fn_sym)
          out.write_string("(l %w)\n")
        } else {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call ")
          out.write_string(main_fn_sym)
          out.write_string("()\n")
        }
        out.write_string("    call $pion_rc_dec(l %w)\n")
        match minfo.ret_ty {
          TInt => out.write_string("    ret %r\n")
          TInt64 => {
            out.write_string("    %rw =w copy %r\n")
            out.write_string("    ret %rw\n")
          }
          _ => out.write_string("    ret 0\n")
        }
        out.write_string("}\n")
      }
      None => ()
    }
  }

  QbeEmitResult::{ ssa: out.to_string(), has_main: has_main }
}

///|
pub fn emit_qbe_package_with_tc(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
) -> QbeEmitResult {
  emit_qbe_package_multi(pkg, tc, release, true, [])
}

///|
pub fn emit_qbe_package(pkg : Package, release : Bool) -> QbeEmitResult {
  let tc = build_typechecker_for_codegen(pkg)
  emit_qbe_package_with_tc(pkg, tc, release)
}

///|
pub struct PreparedPackage {
  pkg : Package
  tc : TypeChecker
  sig : String
  sigs_hash : String
  const_units : Array[Int]
  has_main : Bool
}

///|
pub fn cli_prepare_qbe_units(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[PreparedPackage, String] {
  let checked = check_source_files_full(pkg_name, paths, sources)
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let pkg = checked.pkg
  let tc = checked.tc
  let sig_text = emit_pionsig(pkg)
  let all_sigs = emit_all_sigs(pkg)
  let const_units : Array[Int] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut has_const = false
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DConst(_) => {
          has_const = true
          break
        }
        _ => ()
      }
      di = di + 1
    }
    if has_const {
      const_units.push(fi)
    }
    fi = fi + 1
  }
  let sig_sb = StringBuilder()
  sig_sb.write_string(all_sigs)
  sig_sb.write_string("const_units:")
  let mut ci = 0
  while ci < const_units.length() {
    if ci > 0 {
      sig_sb.write_string(",")
    }
    sig_sb.write_string(const_units[ci].to_string())
    ci = ci + 1
  }
  sig_sb.write_string("\n")
  let sigs_hash = cas_sha256_hex(sig_sb.to_string())
  let has_main = tc.fns.contains("main")
  Ok(PreparedPackage::{
    pkg: pkg,
    tc: tc,
    sig: sig_text,
    sigs_hash: sigs_hash,
    const_units: const_units,
    has_main: has_main,
  })
}

///|
/// Selective incremental preparation: `files` contains full ASTs for dirty units
/// and lightweight stub ASTs for cached units; type-checking Pass 3 runs only on
/// units where `check_file[i] == true`.
pub fn cli_prepare_qbe_units_selective(
  pkg_name : String,
  files : Array[SourceFile],
  check_file : Array[Bool],
  sigs_hash : String,
  const_units : Array[Int],
) -> Result[PreparedPackage, String] {
  let pkg = Package::{ name: pkg_name, files: files }
  let checked = check_package_selective(pkg, check_file)
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let tc = checked.tc
  let has_main = tc.fns.contains("main")
  Ok(PreparedPackage::{
    pkg: pkg,
    tc: tc,
    sig: "",
    sigs_hash: sigs_hash,
    const_units: const_units,
    has_main: has_main,
  })
}

///|
pub fn emit_qbe_unit(
  prep : PreparedPackage,
  unit_idx : Int,
  release : Bool,
) -> String {
  let tc = prep.tc
  let g = qbe_new(tc, release, true)
  let f = prep.pkg.files[unit_idx]
  let const_decls : Array[ConstDecl] = []
  let mut unit_has_main = false

  let mut cfi = 0
  while cfi < prep.pkg.files.length() {
    let cf = prep.pkg.files[cfi]
    let mut cdi = 0
    while cdi < cf.decls.length() {
      match cf.decls[cdi] {
        DConst(cd) =>
          match tc.consts.get(cd.name) {
            Some(cty) => qbe_record_scalar_const(g, cd, cty)
            None => ()
          }
        _ => ()
      }
      cdi = cdi + 1
    }
    cfi = cfi + 1
  }

  let mut di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DStruct(sd) => g.struct_order.push(sd.name)
      DEnum(ed) => g.enum_order.push(ed.name)
      DConst(cd) => {
        g.const_order.push(cd.name)
        const_decls.push(cd)
      }
      DFn(fd) =>
        if fd.receiver_type == "" && fd.name == "main" {
          unit_has_main = true
        }
      DExternFn(_) | DTrait(_) | DImpl(_) | DTest(_) => ()
    }
    di = di + 1
  }

  let mut init_consts_code = ""
  if const_decls.length() > 0 {
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.cur_tparams = []
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    qbe_scope_push(g)
    let mut ci = 0
    while ci < const_decls.length() {
      let cd = const_decls[ci]
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, cd.value, Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(g, cv_reg, "$pion_const_" + cd.name, cty)
      ci = ci + 1
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret")
    let csb = StringBuilder()
    csb.write_string("export function $pion_init_consts_")
    csb.write_string(unit_idx.to_string())
    csb.write_string("() {\n@start\n")
    csb.write_string(g.fn_allocs.to_string())
    csb.write_string(g.fn_body.to_string())
    csb.write_string("}\n\n")
    init_consts_code = csb.to_string()
  }

  g.inline_fns = qbe_collect_file_inline_fns(f)
  let fns_buf = StringBuilder()
  di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
      DExternFn(ed) =>
        if ed.has_body {
          fns_buf.write_string(qbe_emit_extern_fn_decl(g, ed))
        }
      DImpl(id) => {
        let mut mi = 0
        while mi < id.methods.length() {
          fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
          mi = mi + 1
        }
      }
      _ => ()
    }
    di = di + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE unit backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    out.write_string(ec.tag.to_string())
    if ec.has_payload {
      out.write_string(", l ")
      out.write_string(ec.payload_val.to_string())
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    let _ = qbe_emit_bytes_data(out, s)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    let _ = qbe_emit_bytes_data(out, g.cstrings[csi])
    out.write_string(" }\n")
    csi = csi + 1
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    out.write_string("export data $pion_const_")
    out.write_string(g.const_order[kci])
    out.write_string(" = align 8 { l 0 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_struct_drops(g, out)
  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  out.write_string(fns_buf.to_string())

  if unit_has_main {
    match tc.fns.get("main") {
      Some(minfo) => {
        out.write_string("export function w $main(w %argc, l %argv) {\n@start\n")
        out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
        let mut ci = 0
        while ci < prep.const_units.length() {
          out.write_string("    call $pion_init_consts_")
          out.write_string(prep.const_units[ci].to_string())
          out.write_string("()\n")
          ci = ci + 1
        }
        let ret_abi = qbe_abi_ty(minfo.ret_ty)
        if minfo.param_tys.length() >= 1 {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call $pion_fn_main(l %w)\n")
        } else {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call $pion_fn_main()\n")
        }
        out.write_string("    call $pion_rc_dec(l %w)\n")
        match minfo.ret_ty {
          TInt => out.write_string("    ret %r\n")
          TInt64 => {
            out.write_string("    %rw =w copy %r\n")
            out.write_string("    ret %rw\n")
          }
          _ => out.write_string("    ret 0\n")
        }
        out.write_string("}\n")
      }
      None => ()
    }
  }

  out.to_string()
}

///|
pub fn cli_compile_qbe(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  release : Bool,
) -> Result[CompileQbeOut, String] {
  let checked = check_source_files_full(pkg_name, paths, sources)
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let sig_text = emit_pionsig(checked.pkg)
  let res = emit_qbe_package_with_tc(checked.pkg, checked.tc, release)
  Ok(CompileQbeOut::{ sig: sig_text, ssa: res.ssa, has_main: res.has_main })
}

///|
pub struct QbeTestEmitResult {
  ssa : String
  test_names : Array[String]
}

///|
pub fn qbe_test_emit_empty() -> QbeTestEmitResult {
  QbeTestEmitResult::{ ssa: "", test_names: [] }
}

///|
pub fn emit_qbe_test_package(
  pkg : Package,
  tc : TypeChecker,
  dep_pkg_names : Array[String],
) -> QbeTestEmitResult {
  let g = qbe_new(tc, false, false)
  let const_decls : Array[ConstDecl] = []
  let test_decls : Array[TestDecl] = []
  let test_names : Array[String] = []

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => g.struct_order.push(sd.name)
        DEnum(ed) => g.enum_order.push(ed.name)
        DConst(cd) => {
          g.const_order.push(cd.name)
          const_decls.push(cd)
          match tc.consts.get(cd.name) {
            Some(cty) => qbe_record_scalar_const(g, cd, cty)
            None => ()
          }
        }
        DTest(td) => {
          test_decls.push(td)
          test_names.push(td.name)
        }
        DFn(_) | DExternFn(_) | DTrait(_) | DImpl(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  let init_sym = "$pion_" + g.pkg_prefix + "init_consts"
  let mut init_consts_code = ""
  if const_decls.length() > 0 || tc.multi_pkg {
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.cur_tparams = []
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    qbe_scope_push(g)
    let mut ci = 0
    while ci < const_decls.length() {
      let cd = const_decls[ci]
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, cd.value, Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(
        g,
        cv_reg,
        qbe_local_const_sym(g, cd.name),
        cty,
      )
      ci = ci + 1
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret")
    let csb = StringBuilder()
    csb.write_string("function ")
    csb.write_string(init_sym)
    csb.write_string("() {\n@start\n")
    csb.write_string(g.fn_allocs.to_string())
    csb.write_string(g.fn_body.to_string())
    csb.write_string("}\n\n")
    init_consts_code = csb.to_string()
  }

  let fns_buf = StringBuilder()
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    g.inline_fns = qbe_collect_file_inline_fns(f)
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
        DExternFn(ed) =>
          if ed.has_body {
            fns_buf.write_string(qbe_emit_extern_fn_decl(g, ed))
          }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
            mi = mi + 1
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let tests_buf = StringBuilder()
  let mut ti = 0
  while ti < test_decls.length() {
    let td = test_decls[ti]
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.cur_tparams = []
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    g.hoisted_arr_len = Map([])
    g.hoisted_arr_dp = Map([])
    g.hoisted_fields = Map([])
    g.block_immut_fields = Map([])
    g.len_aliases = Map([])
    g.len_alias_keys = []
    g.nonneg_vars = Map([])
    g.bce_safe_indices = Map([])
    g.bce_safe_exprs = Map([])
    g.sq_reuse_slot = Map([])
    g.sq_reuse_state = Map([])
    g.promoted_fields = Map([])
    g.promoted_field_tys = Map([])
    g.w_to_l_ext = Map([])
    g.local_w_to_l_ext = Map([])
    g.unfrozen_local_arrs = Map([])
    qbe_scope_push(g)
    let bres = qbe_emit_stmts(g, td.body, None)
    if !g.block_term {
      qbe_rc_dec(g, bres.reg, bres.ty)
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret")
    } else {
      let _ = g.scopes.pop()
    }
    tests_buf.write_string("function $pion_test_fn_")
    tests_buf.write_string(ti.to_string())
    tests_buf.write_string("() {\n@start\n")
    tests_buf.write_string(g.fn_allocs.to_string())
    tests_buf.write_string(g.fn_body.to_string())
    tests_buf.write_string("}\n\n")
    ti = ti + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE test runner backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    out.write_string(ec.tag.to_string())
    if ec.has_payload {
      out.write_string(", l ")
      out.write_string(ec.payload_val.to_string())
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    let _ = qbe_emit_bytes_data(out, s)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    let _ = qbe_emit_bytes_data(out, g.cstrings[csi])
    out.write_string(" }\n")
    csi = csi + 1
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    out.write_string("data ")
    out.write_string(qbe_local_const_sym(g, g.const_order[kci]))
    out.write_string(" = align 8 { l 0 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_struct_drops(g, out)
  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  out.write_string(fns_buf.to_string())
  out.write_string(tests_buf.to_string())

  out.write_string("export function w $main(w %argc, l %argv) {\n@start\n")
  out.write_string("    %ok_slot =l alloc4 4\n")
  out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
  let mut dpi = 0
  while dpi < dep_pkg_names.length() {
    out.write_string("    call $pion_pkg_")
    out.write_string(qbe_sanitize_sym(dep_pkg_names[dpi]))
    out.write_string("_init_consts()\n")
    dpi = dpi + 1
  }
  if const_decls.length() > 0 || tc.multi_pkg {
    out.write_string("    call ")
    out.write_string(init_sym)
    out.write_string("()\n")
  }
  if test_decls.length() > 0 {
    out.write_string("    %arg1 =l call $pion_world_argv(l %w, l 1)\n")
    out.write_string("    %idx =l call $pion_str_to_int(l %arg1, l %ok_slot)\n")
    out.write_string("    call $pion_rc_dec(l %arg1)\n")
    ti = 0
    while ti < test_decls.length() {
      let s_i = ti.to_string()
      out.write_string("    %c")
      out.write_string(s_i)
      out.write_string(" =w ceql %idx, ")
      out.write_string(s_i)
      out.write_string("\n    jnz %c")
      out.write_string(s_i)
      out.write_string(", @test_")
      out.write_string(s_i)
      out.write_string(", @next_")
      out.write_string(s_i)
      out.write_string("\n@test_")
      out.write_string(s_i)
      out.write_string("\n    call $pion_test_fn_")
      out.write_string(s_i)
      out.write_string("()\n    jmp @done\n@next_")
      out.write_string(s_i)
      out.write_string("\n")
      ti = ti + 1
    }
    out.write_string("@done\n")
  }
  out.write_string("    call $pion_rc_dec(l %w)\n")
  out.write_string("    ret 0\n}\n")

  QbeTestEmitResult::{ ssa: out.to_string(), test_names: test_names }
}

///|
pub fn format_test_report_json(
  names : Array[String],
  passed_flags : Array[Bool],
) -> String {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < names.length() && i < passed_flags.length() {
    if passed_flags[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if failed == 0 { "true" } else { "false" })
  sb.write_string(",\"passed\":")
  sb.write_string(passed.to_string())
  sb.write_string(",\"failed\":")
  sb.write_string(failed.to_string())
  sb.write_string(",\"tests\":[")
  i = 0
  while i < names.length() && i < passed_flags.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(names[i]))
    sb.write_string(",\"ok\":")
    sb.write_string(if passed_flags[i] { "true" } else { "false" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}
