///| Pure Pion ∩ MoonBit QBE IL native backend with Biased RC (Perceus-lite)

///|
pub struct QbeVal {
  reg : String
  ty : Ty
}

///|
pub struct QbeCloRes {
  env : String
  fn_sym : String
  ty : Ty
}

///|
pub struct QbeEmitResult {
  ssa : String
  has_main : Bool
}

///|
pub struct CompileQbeOut {
  sig : String
  ssa : String
  has_main : Bool
}

///|
pub struct QbeLocal {
  name : String
  slot : String
  ty : Ty
  owned : Bool
}

///|
pub struct QbeEnumConst {
  sym : String
  tag : Int
  has_payload : Bool
  payload_val : Int
}

///|
pub struct QbeScope {
  locals : Array[QbeLocal]
}

///|
///|
pub struct QbeArgVal {
  qv : QbeVal
  borrowed : Bool
}

///|
pub struct QbeBceGuard {
  arr : String
  kind : Int
  offset : Int64
  vname : String
  key : String
}

///|
pub struct QbeSqCand {
  name : String
  assign_idx : Int
}

///|
pub struct QbePromField {
  name : String
