}

///|
pub struct QbeEqVarConst {
  vname : String
  cval : Int
}

///|
pub struct QbeSwitchPlan {
  vname : String
  arms : Array[QbeSwitchArm]
  default_opt : Option[Expr]
}

///|
pub struct QbeMonoReq {
  sym : String
  finfo : FnInfo
  subst : Map[String, Ty]
  /// Canonical package whose source declares the fn ("" = this package): its
  /// body's unqualified top-level names resolve in that package.
  pkg : String
}

///|
pub struct QbeImplMethodMatch {
  sym : String
  finfo : FnInfo
}

///|
pub struct QbeFnWrapper {
  wrap_sym : String
  target_sym : String
  param_tys : Array[Ty]
  ret_ty : Ty
}

///|
pub struct QbeProbeHints {
  names : Array[String]
  tys : Array[Ty]
}

///|
pub struct QbeGen {
  tc : TypeChecker
  release : Bool
  unit_mode : Bool
  mut export_internals : Bool
  pkg_prefix : String
  struct_order : Array[String]
  enum_order : Array[String]
  const_order : Array[String]
  const_int_vals : Map[String, Int]
  const_i64_vals : Map[String, Int64]
  const_bool_vals : Map[String, Bool]
  freeze_fn_seen : Map[String, Bool]
  eq_fn_seen : Map[String, Bool]
  strings : Array[String]
  string_ids : Map[String, Int]
  cstrings : Array[String]
  cstring_ids : Map[String, Int]
  enum_consts : Array[QbeEnumConst]
  enum_const_seen : Map[String, Bool]
  slot_drop_keys : Array[String]
  slot_drop_specs : Array[Array[Int]]
  slot_drop_seen : Map[String, Bool]
  fn_wrappers : Array[QbeFnWrapper]
  fn_wrapper_seen : Map[String, Bool]
  dyn_vtable_seen : Map[String, Bool]
  dyn_vtables : Array[String]
  extra_fns : Array[String]
  mono_seen : Map[String, Bool]
  mono_queue : Array[QbeMonoReq]
  mut mono_emitted : Int
  mut mono_pkg : String
  mut inline_fns : Map[String, FnDecl]
  mut inline_depth : Int
  inline_stack : Array[String]
  mut hoisted_arr_len : Map[String, String]
  mut hoisted_arr_dp : Map[String, String]
  mut hoisted_str_len : Map[String, String]
  mut hoisted_str_dp : Map[String, String]
  mut hoisted_fields : Map[String, QbeVal]
  mut block_immut_fields : Map[String, QbeVal]
  mut len_aliases : Map[String, String]
  mut len_alias_keys : Array[String]
  mut nonneg_vars : Map[String, Bool]
  mut bce_safe_indices : Map[String, String]
  mut bce_safe_exprs : Map[String, Bool]
  mut movable_locals : Map[String, String]
  mut moved_slots : Map[String, Bool]
  mut zeroed_slots : Map[String, Bool]
  mut sq_reuse_slot : Map[String, String]
  mut sq_reuse_state : Map[String, Int]
  mut promoted_fields : Map[String, String]
  mut promoted_field_tys : Map[String, Ty]
  mut w_to_l_ext : Map[String, String]
  mut local_w_to_l_ext : Map[String, String]
  mut unfrozen_local_arrs : Map[String, Bool]
  mut assign_idx_arr : String
  mut assign_idx_key : String
  mut assign_idx_ep : String
  mut next_tmp : Int
  mut next_lbl : Int
  mut next_clo : Int
  mut fn_allocs : StringBuilder
  mut fn_body : StringBuilder
  mut scopes : Array[QbeScope]
  mut loop_breaks : Array[String]
  mut loop_conts : Array[String]
  mut loop_depths : Array[Int]
  mut cur_tparams : Array[String]
  mut cur_type_subst : Map[String, Ty]
  mut cur_ret_ty : Ty
  mut cur_ret_abi_ty : Ty
  mut cur_fn_void : Bool
  mut block_term : Bool
  mut need_none_const : Bool
  mut need_drop_opt_obj : Bool
  mut need_drop_res_ok : Bool
  mut need_drop_res_err : Bool
  mut need_drop_dyn : Bool
}

///|
fn qval(reg : String, ty : Ty) -> QbeVal {
  QbeVal::{ reg: reg, ty: ty }
}

///|
fn qbe_is_obj_ty(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TChar | TUnit | TPtr | TNever | TError =>
      false
    TParam(_) => false
    _ => true
  }
}

///|
/// Heap-reference inner types that are guaranteed non-null pointers, so
/// `Option[T]` uses null-niche representation (`None = 0`, `Some(p) = p`) with
/// zero heap boxing. Excludes `TOption`, `TResult`, primitives, `TPtr`, `TUnit`,
/// `TParam`, and closures.
fn qbe_is_niche_opt_inner(t : Ty) -> Bool {
  match t {
    TString
    | TArray(_)
    | TFixedArray(_)
    | TMap(_, _)
    | TStruct(_, _)
    | TEnum(_, _)
    | TBytes
    | TStringBuilder
    | TChannel(_)
    | TMutex(_)
    | TAtomicInt
    | TTuple(_)
    | TDynTrait(_) => true
    _ => false
  }
}

///|
fn qbe_is_double_ty(t : Ty) -> Bool {
  match t {
    TDouble => true
    _ => false
  }
}

///|
fn qbe_is_float_ty(t : Ty) -> Bool {
  match t {
    TFloat => true
    _ => false
  }
}

///|
fn qbe_is_int32_ty(t : Ty) -> Bool {
  match t {
    TInt => true
    _ => false
  }
}

///|
fn qbe_is_uint32_ty(t : Ty) -> Bool {
  match t {
    TUInt => true
    _ => false
  }
}

///|
fn qbe_is_prim_array_elem(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TChar | TPtr => true
    _ => false
  }
}

///|
fn qbe_c_abi_ty(t : Ty) -> String {
  match t {
    TDouble => "d"
    TFloat => "s"
    TInt | TUInt | TBool | TByte | TChar => "w"
    _ => "l"
  }
}

///|
fn qbe_mangle_ty(t : Ty) -> String {
  match t {
    TInt => "Int"
    TInt64 => "Int64"
    TUInt => "UInt"
    TUInt64 => "UInt64"
    TDouble => "Double"
    TFloat => "Float"
    TBool => "Bool"
    TByte => "Byte"
    TChar => "Char"
    TString => "String"
    TUnit => "Unit"
    TPtr => "Ptr"
    TArray(e) => "Array_" + qbe_mangle_ty(e)
    TFixedArray(e) => "FixedArray_" + qbe_mangle_ty(e)
    TOption(e) => "Option_" + qbe_mangle_ty(e)
    TResult(ok, err) => "Result_" + qbe_mangle_ty(ok) + "_" + qbe_mangle_ty(err)
    TMap(k, v) => "Map_" + qbe_mangle_ty(k) + "_" + qbe_mangle_ty(v)
    TStruct(n, _) => qbe_sanitize_sym(n)
    TEnum(n, _) => qbe_sanitize_sym(n)
    TDynTrait(n) => "dyn_" + qbe_sanitize_sym(n)
    _ => qbe_sanitize_sym(ty_to_string(t))
  }
}

///|
fn qbe_mono_fn_sym(
  base_sym : String,
  tparams : Array[String],
  subst : Map[String, Ty],
) -> String {
  let sb = StringBuilder()
  sb.write_string(base_sym)
  sb.write_string("__mono")
  let mut i = 0
  while i < tparams.length() {
    sb.write_string("_")
    let t = match subst.get(tparams[i]) {
      Some(ty) => ty
      None => TError
    }
    sb.write_string(qbe_mangle_ty(t))
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_impl_method_sym(
  g : QbeGen,
  impl_pkg : String,
  trait_name : String,
  target_type : String,
  method_name : String,
) -> String {
  let prefix = if g.tc.multi_pkg {
    qbe_pkg_prefix_for(impl_pkg, true)
  } else {
    ""
  }
  // Package-local (unqualified) names, so the defining package and every importer
  // (which sees `pkg::Trait` / `pkg::Type`) agree on the symbol.
  "$pion_" +
  prefix +
  "impl_" +
  qbe_sanitize_sym(qbe_last_qual_seg(trait_name)) +
  "_" +
  qbe_sanitize_sym(qbe_last_qual_seg(target_type)) +
  "_" +
  method_name
}

///|
fn qbe_last_qual_seg(s : String) -> String {
  let mut rest = s
  let mut qp = split_qual_name(rest)
  while qp.prefix.length() > 0 {
    rest = qp.name
    qp = split_qual_name(rest)
  }
  rest
}

///|
fn qbe_find_impl_method(
  g : QbeGen,
  recv_ty : Ty,
  method_name : String,
) -> Option[QbeImplMethodMatch] {
  let tname = ty_base_name(recv_ty)
  let mut i = 0
  while i < g.tc.impl_keys.length() {
    let k = g.tc.impl_keys[i]
    match g.tc.impls.get(k) {
      Some(ii) =>
        if ii.target_type == tname {
          match ii.methods.get(method_name) {
            Some(fi) =>
              return Some(QbeImplMethodMatch::{
                sym: qbe_impl_method_sym(
                  g,
                  ii.pkg_name,
                  ii.trait_name,
                  ii.target_type,
                  method_name,
                ),
                finfo: fi,
              })
            None => ()
          }
        }
      None => ()
    }
    i = i + 1
  }
  None
}

///|
fn qbe_resolve_type(g : QbeGen, te : TypeExpr) -> Ty {
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        qualify_imported_ty(
          ipkg.name,
          resolve_type_expr(ipkg.tc, te, g.cur_tparams),
        )
      None => resolve_type_expr(g.tc, te, g.cur_tparams)
    }
  } else {
    resolve_type_expr(g.tc, te, g.cur_tparams)
  }
  subst_ty(raw, g.cur_type_subst)
}

///|
/// Type the checker inferred for an unannotated empty collection `let`
/// (`let out = []` + `out.push(..)`), mirroring `qbe_resolve_type`'s package
/// and type-parameter handling.
fn qbe_let_infer(g : QbeGen, sp : Span) -> Option[Ty] {
  let key = span_key(sp)
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.let_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.let_infer.get(key)
    }
  } else {
    g.tc.let_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.cur_type_subst))
    None => None
  }
}

///|
/// Type the checker inferred for a closure expression (including unannotated
/// parameter and return types from expected `TFn(...)` context).
fn qbe_closure_infer(g : QbeGen, sp : Span) -> Option[Ty] {
  let key = span_key(sp)
  let raw = if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.closure_infer.get(key) {
          Some(t) => Some(qualify_imported_ty(ipkg.name, t))
          None => None
        }
      None => g.tc.closure_infer.get(key)
    }
  } else {
    g.tc.closure_infer.get(key)
  }
  match raw {
    Some(t) => Some(subst_ty(t, g.cur_type_subst))
    None => None
  }
}

///|
fn qbe_abi_ty(t : Ty) -> String {
  if qbe_is_double_ty(t) {
    "d"
  } else if qbe_is_float_ty(t) {
    "s"
  } else if qbe_is_int32_ty(t) || qbe_is_uint32_ty(t) {
    "w"
  } else {
    "l"
  }
}

///|
fn qbe_zero_reg(t : Ty) -> String {
  if qbe_is_double_ty(t) {
    "d_0.0"
  } else if qbe_is_float_ty(t) {
    "s_0.0"
  } else {
    "0"
  }
}

///|
fn qbe_is_temp_reg(reg : String) -> Bool {
  reg.length() > 0 && str_code_at(reg, 0) == 37
}

///|
fn qbe_as_l(g : QbeGen, v : QbeVal) -> String {
  if qbe_is_double_ty(v.ty) {
    let dreg = if qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let dt = qbe_tmp(g)
      qbe_emit(g, dt + " =d copy " + v.reg)
      dt
    }
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =l cast " + dreg)
    t
  } else if qbe_is_float_ty(v.ty) {
    let freg = if qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let ft = qbe_tmp(g)
      qbe_emit(g, ft + " =s copy " + v.reg)
      ft
    }
    let w = qbe_tmp(g)
    let t = qbe_tmp(g)
    qbe_emit(g, w + " =w cast " + freg)
    qbe_emit(g, t + " =l extuw " + w)
    t
  } else if qbe_is_uint32_ty(v.ty) {
    if !qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l extuw " + v.reg)
      t
    }
  } else if qbe_is_int32_ty(v.ty) {
    if !qbe_is_temp_reg(v.reg) {
      v.reg
    } else {
      match g.w_to_l_ext.get(v.reg) {
        Some(rl) => rl
        None => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l extsw " + v.reg)
          g.w_to_l_ext.set(v.reg, t)
          t
        }
      }
    }
  } else {
    v.reg
  }
}

///|
fn qbe_from_l(g : QbeGen, reg_l : String, ty : Ty) -> String {
  if qbe_is_double_ty(ty) {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =d cast " + reg_l)
    t
  } else if qbe_is_float_ty(ty) {
    let w = qbe_tmp(g)
    let t = qbe_tmp(g)
    qbe_emit(g, w + " =w copy " + reg_l)
    qbe_emit(g, t + " =s cast " + w)
    t
  } else if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w copy " + reg_l)
    t
  } else {
    reg_l
  }
}

///|
fn qbe_is_untyped_option(t : Ty) -> Bool {
  match t {
    TOption(TError) => true
    _ => false
  }
}

///|
fn qbe_normalize_untyped_none(g : QbeGen, reg : String) -> String {
  g.need_none_const = true
  let slot = qbe_alloc_slot(g)
  let np = qbe_tmp(g)
  let is_n = qbe_tmp(g)
  let l_zero = qbe_lbl(g, "opt_zn")
  let l_keep = qbe_lbl(g, "opt_kn")
  let l_end = qbe_lbl(g, "opt_en")
  qbe_emit(g, np + " =l add $pion_none_hdr, 24")
  qbe_emit(g, is_n + " =w ceql " + reg + ", " + np)
  qbe_emit_term(g, "jnz " + is_n + ", " + l_zero + ", " + l_keep)
  qbe_emit_lbl(g, l_zero)
  qbe_emit(g, "storel 0, " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_keep)
  qbe_emit(g, "storel " + reg + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_coerce_val(g : QbeGen, v : QbeVal, target_ty : Ty) -> String {
  match v.ty {
    TOption(TError) =>
      match target_ty {
        TOption(dst_in) =>
          if qbe_is_niche_opt_inner(dst_in) {
            return qbe_normalize_untyped_none(g, v.reg)
          }
        _ => ()
      }
    _ => ()
  }
  let src_abi = qbe_abi_ty(v.ty)
  let dst_abi = qbe_abi_ty(target_ty)
  if src_abi == dst_abi {
    v.reg
  } else if src_abi == "d" && dst_abi == "l" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =l cast " + v.reg)
    t
  } else if src_abi == "l" && dst_abi == "d" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =d cast " + v.reg)
    t
  } else if src_abi == "s" && dst_abi == "l" {
    qbe_as_l(g, v)
  } else if src_abi == "l" && dst_abi == "s" {
    qbe_from_l(g, v.reg, TFloat)
  } else if src_abi == "s" && dst_abi == "w" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w cast " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "s" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =s cast " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "l" {
    let t = qbe_tmp(g)
    if qbe_is_uint32_ty(v.ty) {
      qbe_emit(g, t + " =l extuw " + v.reg)
    } else {
      qbe_emit(g, t + " =l extsw " + v.reg)
    }
    t
  } else if src_abi == "l" && dst_abi == "w" {
    let t = qbe_tmp(g)
    qbe_emit(g, t + " =w copy " + v.reg)
    t
  } else if src_abi == "w" && dst_abi == "d" {
    let lreg = qbe_tmp(g)
    let dreg = qbe_tmp(g)
    if qbe_is_uint32_ty(v.ty) {
      qbe_emit(g, lreg + " =l extuw " + v.reg)
    } else {
      qbe_emit(g, lreg + " =l extsw " + v.reg)
    }
    qbe_emit(g, dreg + " =d cast " + lreg)
    dreg
  } else if src_abi == "s" && dst_abi == "d" {
    let dreg = qbe_tmp(g)
    qbe_emit(g, dreg + " =d exts " + v.reg)
    dreg
  } else if src_abi == "d" && dst_abi == "s" {
    let freg = qbe_tmp(g)
    qbe_emit(g, freg + " =s truncd " + v.reg)
    freg
  } else {
    let lreg = qbe_tmp(g)
    let wreg = qbe_tmp(g)
    qbe_emit(g, lreg + " =l cast " + v.reg)
    qbe_emit(g, wreg + " =w copy " + lreg)
    wreg
  }
}

///|
fn qbe_store_local_slot(g : QbeGen, reg : String, slot : String, ty : Ty) -> Unit {
  if qbe_is_double_ty(ty) {
    qbe_emit(g, "stored " + reg + ", " + slot)
  } else if qbe_is_float_ty(ty) {
    let lreg = qbe_as_l(g, qval(reg, TFloat))
    qbe_emit(g, "storel " + lreg + ", " + slot)
  } else if qbe_is_int32_ty(ty) || qbe_is_uint32_ty(ty) {
    qbe_emit(g, "storew " + reg + ", " + slot)
  } else {
    qbe_emit(g, "storel " + reg + ", " + slot)
  }
}

///|
fn qbe_load_local_slot(g : QbeGen, slot : String, ty : Ty) -> String {
  let t = qbe_tmp(g)
  if qbe_is_double_ty(ty) {
    qbe_emit(g, t + " =d loadd " + slot)
  } else if qbe_is_float_ty(ty) {
    qbe_emit(g, t + " =s loads " + slot)
  } else if qbe_is_int32_ty(ty) {
    qbe_emit(g, t + " =w loadsw " + slot)
  } else if qbe_is_uint32_ty(ty) {
    qbe_emit(g, t + " =w loaduw " + slot)
  } else {
    qbe_emit(g, t + " =l loadl " + slot)
  }
  t
}

///|
fn qbe_store_heap_slot(g : QbeGen, reg : String, slot : String, ty : Ty) -> Unit {
  if qbe_is_double_ty(ty) {
    qbe_emit(g, "stored " + reg + ", " + slot)
  } else if qbe_is_float_ty(ty) {
    let lreg = qbe_as_l(g, qval(reg, TFloat))
    qbe_emit(g, "storel " + lreg + ", " + slot)
  } else if qbe_is_uint32_ty(ty) {
    if !qbe_is_temp_reg(reg) {
      qbe_emit(g, "storel " + reg + ", " + slot)
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l extuw " + reg)
      qbe_emit(g, "storel " + t + ", " + slot)
    }
  } else if qbe_is_int32_ty(ty) {
    if !qbe_is_temp_reg(reg) {
      qbe_emit(g, "storel " + reg + ", " + slot)
    } else {
      let rl = match g.w_to_l_ext.get(reg) {
        Some(existing) => existing
        None => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l extsw " + reg)
          g.w_to_l_ext.set(reg, t)
          t
        }
      }
      qbe_emit(g, "storel " + rl + ", " + slot)
    }
  } else {
    qbe_emit(g, "storel " + reg + ", " + slot)
  }
}

///|
fn qbe_load_heap_slot(g : QbeGen, slot : String, ty : Ty) -> String {
  let t = qbe_tmp(g)
  if qbe_is_double_ty(ty) {
    qbe_emit(g, t + " =d loadd " + slot)
  } else if qbe_is_float_ty(ty) {
    qbe_emit(g, t + " =s loads " + slot)
  } else if qbe_is_int32_ty(ty) {
    qbe_emit(g, t + " =w loadsw " + slot)
  } else if qbe_is_uint32_ty(ty) {
    qbe_emit(g, t + " =w loaduw " + slot)
  } else {
    qbe_emit(g, t + " =l loadl " + slot)
  }
  t
}

///|
fn qbe_sanitize_sym(s : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57) ||
      c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  sb.to_string()
}

///|
fn qbe_pkg_prefix_for(pkg_name : String, multi_pkg : Bool) -> String {
  if multi_pkg {
    "pkg_" + qbe_sanitize_sym(pkg_name) + "_"
  } else {
    ""
  }
}

///|
fn qbe_local_fn_sym(g : QbeGen, name : String) -> String {
  "$pion_" + g.pkg_prefix + "fn_" + name
}

///|
fn qbe_local_method_sym(g : QbeGen, recv : String, name : String) -> String {
  "$pion_" + g.pkg_prefix + "m_" + recv + "__" + name
}

///|
fn qbe_local_const_sym(g : QbeGen, name : String) -> String {
  "$pion_" + g.pkg_prefix + "const_" + name
}

///|
fn qbe_ext_fn_sym(canon_pkg : String, name : String) -> String {
  "$pion_pkg_" + qbe_sanitize_sym(canon_pkg) + "_fn_" + name
}

///|
fn qbe_ext_method_sym(
  canon_pkg : String,
  recv : String,
  name : String,
) -> String {
  "$pion_pkg_" + qbe_sanitize_sym(canon_pkg) + "_m_" + recv + "__" + name
}

///|
fn qbe_ext_const_sym(canon_pkg : String, name : String) -> String {
  "$pion_pkg_" + qbe_sanitize_sym(canon_pkg) + "_const_" + name
}

///|
fn qbe_method_call_sym(
  g : QbeGen,
  sname : String,
  method_name : String,
) -> String {
  let qp = split_qual_name(sname)
  let canon_pkg = qp.prefix
  let st_name = qp.name
  if canon_pkg.length() > 0 {
    qbe_ext_method_sym(canon_pkg, st_name, method_name)
  } else if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.methods.contains(sname + "::" + method_name) {
          qbe_ext_method_sym(ipkg.name, sname, method_name)
        } else {
          qbe_local_method_sym(g, sname, method_name)
        }
      None => qbe_local_method_sym(g, sname, method_name)
    }
  } else {
    qbe_local_method_sym(g, sname, method_name)
  }
}

///|
/// `==` on an enum (the checker only admits payload-less ones) compares the
/// variant tags: each package emits its own static constant per variant, so
/// pointer identity would differ across packages.
fn qbe_cmp_operand(g : QbeGen, reg : String, ty : Ty) -> String {
  match ty {
    TEnum(_, _) => {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l loadl " + reg)
      t
    }
    _ => reg
  }
}

///|
fn qbe_register_enum_const(
  g : QbeGen,
  enum_name : String,
  vname : String,
  tag : Int,
) -> String {
  let sym = "$pion_enum_" + qbe_sanitize_sym(enum_name) + "__" + vname + "_hdr"
  if !g.enum_const_seen.contains(sym) {
    g.enum_const_seen.set(sym, true)
    g.enum_consts.push(QbeEnumConst::{
      sym: sym,
      tag: tag,
      has_payload: false,
      payload_val: 0,
    })
  }
  sym
}

///|
fn qbe_register_enum_bool_const(
  g : QbeGen,
  enum_name : String,
  vname : String,
  tag : Int,
  bval : Int,
) -> String {
  let sym = "$pion_enum_" +
    qbe_sanitize_sym(enum_name) +
    "__" +
    vname +
    "_" +
    bval.to_string() +
    "_hdr"
  if !g.enum_const_seen.contains(sym) {
    g.enum_const_seen.set(sym, true)
    g.enum_consts.push(QbeEnumConst::{
      sym: sym,
      tag: tag,
      has_payload: true,
      payload_val: bval,
    })
  }
  sym
}

///|
fn qbe_exprs_have_eq(g : QbeGen, d : Int, es : Array[Expr]) -> Bool {
  let mut i = 0
  while i < es.length() {
    if qbe_expr_has_eq(g, d, es[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Whether `e` contains a `==` / `!=` anywhere (closures included), or calls
/// a generic fn whose body does (up to 4 levels deep).
fn qbe_expr_has_eq(g : QbeGen, d : Int, e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_eq(g, d, inner)
    EBinary(op, l, r, _) =>
      op == "==" || op == "!=" || qbe_expr_has_eq(g, d, l) || qbe_expr_has_eq(g, d, r)
    EField(o, _, _) => qbe_expr_has_eq(g, d, o)
    EIndex(o, i, _) => qbe_expr_has_eq(g, d, o) || qbe_expr_has_eq(g, d, i)
    ECall(callee, args, _) =>
      qbe_expr_has_eq(g, d, callee) ||
      qbe_exprs_have_eq(g, d, args) ||
      qbe_callee_generic_has_eq(g, d, callee)
    EMethodCall(obj, mname, args, _) =>
      mname == "contains" || qbe_expr_has_eq(g, d, obj) || qbe_exprs_have_eq(g, d, args)
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) =>
      qbe_exprs_have_eq(g, d, elems)
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_eq(g, d, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_eq(g, d, stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_eq(g, d, cond) || qbe_stmts_have_eq(g, d, then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_eq(g, d, el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_eq(g, d, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_eq(g, d, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_eq(g, d, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_eq(g, d, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_have_eq(g, d, body)
    EScope(a, b, _) | ESpawn(a, b, _) => qbe_expr_has_eq(g, d, a) || qbe_expr_has_eq(g, d, b)
  }
}

///|
fn qbe_stmt_has_eq(g : QbeGen, d : Int, st : Stmt) -> Bool {
  match st {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) => qbe_expr_has_eq(g, d, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) => qbe_expr_has_eq(g, d, l) || qbe_expr_has_eq(g, d, r)
    SWhile(c, body, _) | SGuard(c, body, _) => qbe_expr_has_eq(g, d, c) || qbe_stmts_have_eq(g, d, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_eq(g, d, init) ||
      qbe_expr_has_eq(g, d, c) ||
      qbe_stmt_has_eq(g, d, step) ||
      qbe_stmts_have_eq(g, d, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_eq(g, d, a) || qbe_expr_has_eq(g, d, b) || qbe_stmts_have_eq(g, d, body)
    SForIn(_, _, it, body, _) => qbe_expr_has_eq(g, d, it) || qbe_stmts_have_eq(g, d, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_eq(g, d, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) => qbe_expr_has_eq(g, d, c) || qbe_expr_has_eq(g, d, m)
    SExpr(e, _) => qbe_expr_has_eq(g, d, e)
  }
}

///|
fn qbe_stmts_have_eq(g : QbeGen, d : Int, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_eq(g, d, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// A generic callee comparing its type params: a caller forwarding its own
/// type params must be monomorphized too, so the inner call sees concrete types.
fn qbe_callee_generic_has_eq(g : QbeGen, d : Int, callee : Expr) -> Bool {
  if d >= 4 {
    return false
  }
  let fo : Option[FnInfo] = match callee {
    EIdent(name, _) => g.tc.fns.get(name)
    EPath(qual, mem, _) =>
      match resolve_alias_pkg(g.tc, qual) {
        Some(ipkg) => ipkg.tc.fns.get(mem)
        None => None
      }
    _ => None
  }
  match fo {
    Some(fi) =>
      fi.decl.type_params.length() > 0 &&
      fi.decl.type_bounds.length() == 0 &&
      qbe_stmts_have_eq(g, d + 1, fi.decl.body)
    None => false
  }
}

///|
fn qbe_qualify_struct_info(pkg_name : String, si : StructInfo) -> StructInfo {
  let ftys : Array[Ty] = []
  let mut i = 0
  while i < si.field_tys.length() {
    ftys.push(qualify_imported_ty(pkg_name, si.field_tys[i]))
    i = i + 1
  }
  StructInfo::{
    decl: si.decl,
    field_names: si.field_names,
    field_muts: si.field_muts,
    field_tys: ftys,
  }
}

///|
fn qbe_qualify_enum_info(pkg_name : String, ei : EnumInfo) -> EnumInfo {
  let vars : Array[VariantInfo] = []
  let mut vi = 0
  while vi < ei.variants.length() {
    let v = ei.variants[vi]
    let ftys : Array[Ty] = []
    let mut fi = 0
    while fi < v.field_tys.length() {
      ftys.push(qualify_imported_ty(pkg_name, v.field_tys[fi]))
      fi = fi + 1
    }
    vars.push(VariantInfo::{ name: v.name, field_tys: ftys })
    vi = vi + 1
  }
  EnumInfo::{ decl: ei.decl, variants: vars }
}

///|
fn qbe_lookup_struct_info(g : QbeGen, name : String) -> Option[StructInfo] {
  match g.tc.structs.get(name) {
    Some(si) => return Some(si)
    None => ()
  }
  if g.mono_pkg != "" {
    match g.tc.structs.get(g.mono_pkg + "::" + name) {
      Some(si) => return Some(si)
      None => ()
    }
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.structs.get(name) {
          Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
          None => ()
        }
      None => ()
    }
  }
  let qp = split_qual_name(name)
  if qp.prefix != "" {
    match resolve_alias_pkg(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.structs.get(qp.name) {
          Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
          None => ()
        }
      None => ()
    }
    match g.tc.imported_pkgs.get(qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.structs.get(qp.name) {
          Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match g.tc.imported_pkgs.get(g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.structs.get(qp.name) {
                Some(si) => return Some(qbe_qualify_struct_info(ipkg.name, si))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_lookup_enum_info(g : QbeGen, name : String) -> Option[EnumInfo] {
  match g.tc.enums.get(name) {
    Some(ei) => return Some(ei)
    None => ()
  }
  if g.mono_pkg != "" {
    match g.tc.enums.get(g.mono_pkg + "::" + name) {
      Some(ei) => return Some(ei)
      None => ()
    }
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(name) {
          Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
          None => ()
        }
      None => ()
    }
  }
  let qp = split_qual_name(name)
  if qp.prefix != "" {
    match resolve_alias_pkg(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qp.name) {
          Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
          None => ()
        }
      None => ()
    }
    match g.tc.imported_pkgs.get(qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.enums.get(qp.name) {
          Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match g.tc.imported_pkgs.get(g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.enums.get(qp.name) {
                Some(ei) => return Some(qbe_qualify_enum_info(ipkg.name, ei))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_lookup_method_info(
  g : QbeGen,
  sname : String,
  method_name : String,
) -> Option[FnInfo] {
  let key = sname + "::" + method_name
  match g.tc.methods.get(key) {
    Some(mi) => return Some(mi)
    None => ()
  }
  if g.mono_pkg != "" {
    match g.tc.methods.get(g.mono_pkg + "::" + key) {
      Some(mi) => return Some(mi)
      None => ()
    }
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.methods.get(key) {
          Some(mi) => return Some(qualify_fn_info(ipkg.name, mi))
          None => ()
        }
      None => ()
    }
  }
  let qp = split_qual_name(sname)
  if qp.prefix != "" {
    let sub_key = qp.name + "::" + method_name
    match resolve_alias_pkg(g.tc, qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.methods.get(sub_key) {
          Some(mi) => return Some(qualify_fn_info(ipkg.name, mi))
          None => ()
        }
      None => ()
    }
    match g.tc.imported_pkgs.get(qp.prefix) {
      Some(ipkg) =>
        match ipkg.tc.methods.get(sub_key) {
          Some(mi) => return Some(qualify_fn_info(ipkg.name, mi))
          None => ()
        }
      None => ()
    }
    if g.mono_pkg != "" {
      match g.tc.imported_pkgs.get(g.mono_pkg) {
        Some(mpkg) =>
          match resolve_alias_pkg(mpkg.tc, qp.prefix) {
            Some(ipkg) =>
              match ipkg.tc.methods.get(sub_key) {
                Some(mi) => return Some(qualify_fn_info(ipkg.name, mi))
                None => ()
              }
            None => ()
          }
        None => ()
      }
    }
  }
  None
}

///|
fn qbe_lookup_variant_enum(g : QbeGen, vname : String) -> Option[String] {
  match g.tc.variant_to_enum.get(vname) {
    Some(en) => return Some(en)
    None => ()
  }
  if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.variant_to_enum.get(vname) {
          Some(en) => return Some(ipkg.name + "::" + en)
          None => ()
        }
      None => ()
    }
  }
  None
}

///|
fn qbe_lookup_const_ty(g : QbeGen, name : String) -> Option[Ty] {
  if g.mono_pkg != "" {
    match g.tc.imported_pkgs.get(g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.consts.get(name) {
          Some(cty) => return Some(qualify_imported_ty(ipkg.name, cty))
          None => ()
        }
      None => ()
    }
  }
  g.tc.consts.get(name)
}

///|
fn qbe_map_key_is_int(kty : Ty) -> Bool {
  match kty {
    TInt | TInt64 => true
    _ => false
  }
}

///|
/// Generic fns are monomorphized when bounded, or when their body uses
/// `==` / `!=` and every type argument is concrete: the erased body would
/// compare `T` values by pointer, while `String` must compare bytes and
/// payload-less enums their tags.
fn qbe_ty_has_option(g : QbeGen, ty : Ty, depth : Int) -> Bool {
  if depth > 4 {
    return false
  }
  match ty {
    TOption(_) => true
    TArray(e) | TFixedArray(e) | TChannel(e) | TMutex(e) => qbe_ty_has_option(g, e, depth + 1)
    TResult(a, b) | TMap(a, b) =>
      qbe_ty_has_option(g, a, depth + 1) || qbe_ty_has_option(g, b, depth + 1)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_ty_has_option(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_option(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_option(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) => {
      let mut i = 0
      while i < sargs.length() {
        if qbe_ty_has_option(g, sargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if sargs.length() > 0 {
        match qbe_lookup_struct_info(g, sname) {
          Some(sinfo) => {
            let qp = split_qual_name(sname)
            let saved_pkg = g.mono_pkg
            if qp.prefix != "" {
              g.mono_pkg = qp.prefix
            }
            let mut fi = 0
            while fi < sinfo.field_tys.length() {
              if qbe_ty_has_option(g, sinfo.field_tys[fi], depth + 1) {
                g.mono_pkg = saved_pkg
                return true
              }
              fi = fi + 1
            }
            g.mono_pkg = saved_pkg
          }
          None => ()
        }
      }
      false
    }
    TEnum(ename, eargs) => {
      let mut i = 0
      while i < eargs.length() {
        if qbe_ty_has_option(g, eargs[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if eargs.length() > 0 {
        match qbe_lookup_enum_info(g, ename) {
          Some(einfo) => {
            let qp = split_qual_name(ename)
            let saved_pkg = g.mono_pkg
            if qp.prefix != "" {
              g.mono_pkg = qp.prefix
            }
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                if qbe_ty_has_option(g, v.field_tys[fi], depth + 1) {
                  g.mono_pkg = saved_pkg
                  return true
                }
                fi = fi + 1
              }
              vi = vi + 1
            }
            g.mono_pkg = saved_pkg
          }
          None => ()
        }
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_type_expr_has_option(g : QbeGen, te : TypeExpr, depth : Int) -> Bool {
  if depth > 4 {
    return false
  }
  match te {
    TyName(name, args, _) => {
      if name == "Option" {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_type_expr_has_option(g, args[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      if args.length() > 0 {
        match qbe_lookup_struct_info(g, name) {
          Some(sinfo) => {
            let mut fi = 0
            while fi < sinfo.field_tys.length() {
              if qbe_ty_has_option(g, sinfo.field_tys[fi], depth + 1) {
                return true
              }
              fi = fi + 1
            }
          }
          None => ()
        }
        match qbe_lookup_enum_info(g, name) {
          Some(einfo) => {
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let mut fi = 0
              while fi < v.field_tys.length() {
                if qbe_ty_has_option(g, v.field_tys[fi], depth + 1) {
                  return true
                }
                fi = fi + 1
              }
              vi = vi + 1
            }
          }
          None => ()
        }
      }
      false
    }
    TyTuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_type_expr_has_option(g, elems[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    TyFn(ps, r, _) => {
      if qbe_type_expr_has_option(g, r, depth + 1) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_option(g, ps[i], depth + 1) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_pat_has_option(pat : Pattern) -> Bool {
  match pat {
    PVariant(_, vname, subs, _) => {
      if vname == "Some" || vname == "None" {
        return true
      }
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_has_option(subs[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_has_option(subs[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_expr_has_option(g : QbeGen, depth : Int, e : Expr) -> Bool {
  if depth > 16 {
    return false
  }
  match e {
    EIdent(name, _) => name == "None"
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | ETry(inner, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_option(g, depth + 1, inner)
    EAs(inner, ty, _) =>
      qbe_type_expr_has_option(g, ty, 0) ||
      qbe_expr_has_option(g, depth + 1, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_option(g, depth + 1, l) ||
      qbe_expr_has_option(g, depth + 1, r)
    ECall(callee, args, _) => {
      match callee {
        EIdent(cname, _) => {
          if cname == "Some" {
            return true
          }
          if depth <= 12 {
            let cf_opt : Option[FnInfo] = if g.mono_pkg != "" {
              match g.tc.imported_pkgs.get(g.mono_pkg) {
                Some(ipkg) => ipkg.tc.fns.get(cname)
                None => g.tc.fns.get(cname)
              }
            } else {
              g.tc.fns.get(cname)
            }
            match cf_opt {
              Some(cf) =>
                if cf.decl.type_params.length() > 0 &&
                  qbe_fn_uses_option_depth(g, cf, g.mono_pkg, depth + 4) {
                  return true
                }
              None => ()
            }
          }
        }
        EPath(qual, mem, _) =>
          if depth <= 12 {
            let mut cf_opt : Option[FnInfo] = None
            let mut cf_pkg = g.mono_pkg
            let mkey = qual + "::" + mem
            if g.mono_pkg != "" {
              match g.tc.imported_pkgs.get(g.mono_pkg) {
                Some(mpkg_info) =>
                  match mpkg_info.tc.methods.get(mkey) {
                    Some(mi) => cf_opt = Some(mi)
                    None =>
                      match resolve_alias_pkg(mpkg_info.tc, qual) {
                        Some(ipkg) =>
                          match ipkg.tc.fns.get(mem) {
                            Some(fi) => {
                              cf_opt = Some(fi)
                              cf_pkg = ipkg.name
                            }
                            None => ()
                          }
                        None => ()
                      }
                  }
                None => ()
              }
            } else {
              match g.tc.methods.get(mkey) {
                Some(mi) => cf_opt = Some(mi)
                None =>
                  match resolve_alias_pkg(g.tc, qual) {
                    Some(ipkg) =>
                      match ipkg.tc.fns.get(mem) {
                        Some(fi) => {
                          cf_opt = Some(fi)
                          cf_pkg = ipkg.name
                        }
                        None => ()
                      }
                    None => ()
                  }
              }
            }
            match cf_opt {
              Some(cf) =>
                if cf.decl.type_params.length() > 0 &&
                  qbe_fn_uses_option_depth(g, cf, cf_pkg, depth + 4) {
                  return true
                }
              None => ()
            }
          }
        _ => ()
      }
      if qbe_expr_has_option(g, depth + 1, callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_option(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_option(g, depth + 1, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_option(g, depth + 1, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_option(g, depth + 1, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_option(g, depth + 1, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_option(g, depth + 1, stmts)
    EIf(cond, then_s, else_opt, _) => {
      if qbe_expr_has_option(g, depth + 1, cond) ||
        qbe_stmts_have_option(g, depth + 1, then_s) {
        return true
      }
      match else_opt {
        Some(ee) => qbe_expr_has_option(g, depth + 1, ee)
        None => false
      }
    }
    EIs(scrut, pat, _) => qbe_expr_has_option(g, depth + 1, scrut) || qbe_pat_has_option(pat)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_option(g, depth + 1, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        if qbe_pat_has_option(arms[i].pat) {
          return true
        }
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_option(g, depth + 1, ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_option(g, depth + 1, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(ps, rty, body, _) => {
      if qbe_type_expr_has_option(g, rty, 0) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_type_expr_has_option(g, ps[i].ty, 0) {
          return true
        }
        i = i + 1
      }
      qbe_stmts_have_option(g, depth + 1, body)
    }
  }
}

///|
fn qbe_stmt_has_option(g : QbeGen, depth : Int, st : Stmt) -> Bool {
  if depth > 16 {
    return false
  }
  match st {
    SLet(_, _, ty, init, _) | SLetTuple(_, ty, init, _) =>
      qbe_type_expr_has_option(g, ty, 0) ||
      qbe_expr_has_option(g, depth + 1, init)
    SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
      qbe_expr_has_option(g, depth + 1, l) ||
      qbe_expr_has_option(g, depth + 1, r)
    SWhile(c, body, _) | SGuard(c, body, _) =>
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SFor(init, c, step, body, _) =>
      qbe_stmt_has_option(g, depth + 1, init) ||
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_stmt_has_option(g, depth + 1, step) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SForRange(_, a, b, _, body, _) =>
      qbe_expr_has_option(g, depth + 1, a) ||
      qbe_expr_has_option(g, depth + 1, b) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SForIn(_, _, it, body, _) =>
      qbe_expr_has_option(g, depth + 1, it) ||
      qbe_stmts_have_option(g, depth + 1, body)
    SReturn(ro, _) =>
      match ro {
        Some(re) => qbe_expr_has_option(g, depth + 1, re)
        None => false
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_option(g, depth + 1, c) ||
      qbe_expr_has_option(g, depth + 1, m)
    SExpr(e, _) => qbe_expr_has_option(g, depth + 1, e)
  }
}

///|
fn qbe_stmts_have_option(g : QbeGen, depth : Int, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_option(g, depth, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_fn_uses_option_depth(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  depth : Int,
) -> Bool {
  if depth > 16 {
    return false
  }
  let fd = finfo.decl
  let saved_pkg = g.mono_pkg
  if mpkg != "" {
    g.mono_pkg = mpkg
  }
  if qbe_ty_has_option(g, finfo.ret_ty, 0) ||
    qbe_type_expr_has_option(g, fd.ret_ty, 0) {
    g.mono_pkg = saved_pkg
    return true
  }
  let mut i = 0
  while i < finfo.param_tys.length() {
    if qbe_ty_has_option(g, finfo.param_tys[i], 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  i = 0
  while i < fd.params.length() {
    if qbe_type_expr_has_option(g, fd.params[i].ty, 0) {
      g.mono_pkg = saved_pkg
      return true
    }
    i = i + 1
  }
  let body_has = qbe_stmts_have_option(g, depth, fd.body)
  g.mono_pkg = saved_pkg
  body_has
}

///|
fn qbe_fn_uses_option(g : QbeGen, finfo : FnInfo, mpkg : String) -> Bool {
  qbe_fn_uses_option_depth(g, finfo, mpkg, 0)
}

///|
fn qbe_call_needs_mono(
  g : QbeGen,
  finfo : FnInfo,
  subst : Map[String, Ty],
  mpkg : String,
) -> Bool {
  let fd = finfo.decl
  if fd.type_bounds.length() > 0 {
    return true
  }
  if fd.type_params.length() == 0 {
    return false
  }
  let mut i = 0
  while i < fd.type_params.length() {
    match subst.get(fd.type_params[i]) {
      Some(t) =>
        if qbe_ty_has_param(t) {
          return false
        }
      None => return false
    }
    i = i + 1
  }
  qbe_stmts_have_eq(g, 0, fd.body) || qbe_fn_uses_option(g, finfo, mpkg)
}

///|
/// Expected type for an argument of a call to `finfo`. For an unbounded generic
/// that compares its type params or uses `Option[T]` (monomorphized per call),
/// a parameter type still naming an unbound type param is no hint: the argument
/// infers its own concrete type (`count_same(["a"], "a")` binds `U = String`).
fn qbe_generic_arg_expect(
  g : QbeGen,
  finfo : FnInfo,
  mpkg : String,
  pty : Ty,
  arg : Expr,
) -> Option[Ty] {
  let fd = finfo.decl
  if fd.type_params.length() == 0 ||
    fd.type_bounds.length() > 0 ||
    !qbe_ty_has_param(pty) {
    return Some(pty)
  }
  let self_inferring = match arg {
    EArrayLit(elems, _) => elems.length() > 0
    EIdent(n, _) => n != "None"
    EUnit(_) => false
    _ => true
  }
  if self_inferring && (qbe_stmts_have_eq(g, 0, fd.body) || qbe_fn_uses_option(g, finfo, mpkg)) {
    None
  } else {
    Some(pty)
  }
}

///|
fn qbe_ty_has_param(t : Ty) -> Bool {
  match t {
    TParam(_) | TError => true
    TArray(e) | TFixedArray(e) | TOption(e) | TChannel(e) | TMutex(e) => qbe_ty_has_param(e)
    TResult(a, b) | TMap(a, b) => qbe_ty_has_param(a) || qbe_ty_has_param(b)
    TStruct(_, args) | TEnum(_, args) | TTuple(args) => {
      let mut i = 0
      while i < args.length() {
        if qbe_ty_has_param(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    TFn(ps, r) => {
      if qbe_ty_has_param(r) {
        return true
      }
      let mut i = 0
      while i < ps.length() {
        if qbe_ty_has_param(ps[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_expr_has_assign(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_assign(inner)
    EBinary(_, l, r, _) => qbe_expr_has_assign(l) || qbe_expr_has_assign(r)
    EField(o, _, _) => qbe_expr_has_assign(o)
    EIndex(o, i, _) => qbe_expr_has_assign(o) || qbe_expr_has_assign(i)
    ECall(callee, args, _) => {
      if qbe_expr_has_assign(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_assign(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_assign(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_assign(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_assign(b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_assign(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_have_assign(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_assign(cond) || qbe_stmts_have_assign(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_assign(el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_assign(scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_assign(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_assign(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_assign(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      true
  }
}

///|
fn qbe_stmts_have_assign(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SExpr(e, _) =>
        if qbe_expr_has_assign(e) {
          return true
        }
      _ => return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_pure_idx_key(e : Expr) -> String {
  match e {
    EIdent(v, _) => "v:" + v
    EBinary(op, EIdent(v, _), EInt(raw, _), _) =>
      if op == "+" || op == "-" {
        op + ":" + v + ":" + qbe_parse_int64_lit(raw).to_string()
      } else {
        ""
      }
    EBinary(op, EIdent(v1, _), EIdent(v2, _), _) =>
      if op == "+" || op == "-" {
        op + ":" + v1 + ":v:" + v2
      } else {
        ""
      }
    _ => ""
  }
}

///|
fn qbe_expr_has_same_index(e : Expr, arr : String, key : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_same_index(inner, arr, key)
    EBinary(_, l, r, _) =>
      qbe_expr_has_same_index(l, arr, key) || qbe_expr_has_same_index(r, arr, key)
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) =>
          if aname == arr && qbe_pure_idx_key(idx) == key {
            return true
          }
        _ => ()
      }
      qbe_expr_has_same_index(obj, arr, key) || qbe_expr_has_same_index(idx, arr, key)
    }
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_same_index(cond, arr, key) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        match then_stmts[i] {
          SExpr(se, _) =>
            if qbe_expr_has_same_index(se, arr, key) {
              return true
            }
          _ => ()
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_same_index(el, arr, key)
      }
    }
    EBlock(stmts, _) => {
      let mut i = 0
      while i < stmts.length() {
        match stmts[i] {
          SExpr(se, _) =>
            if qbe_expr_has_same_index(se, arr, key) {
              return true
            }
          _ => ()
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_args_have_assign(args : Array[Expr]) -> Bool {
  let mut i = 0
  while i < args.length() {
    if qbe_expr_has_assign(args[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
///|
fn qbe_try_emit_borrowed_arr_elem(
  g : QbeGen,
  aname : String,
  idx_expr : Expr,
) -> Option[QbeVal] {
  if qbe_expr_has_assign(idx_expr) ||
    qbe_expr_assigns_ident(idx_expr, aname) ||
    !qbe_loop_has_no_calls_expr(idx_expr) {
    return None
  }
  match qbe_lookup_local(g, aname) {
    Some(aloc) =>
      match aloc.ty {
        TArray(elem) | TFixedArray(elem) => {
          let arr_p = if g.hoisted_arr_len.contains(aname) &&
            g.hoisted_arr_dp.contains(aname) {
            "0"
          } else {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l loadl " + aloc.slot)
            r
          }
          let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
          let il = qbe_as_l(g, iv)
          if !qbe_bce_expr_is_safe(g, aname, idx_expr) {
            let alen = match g.hoisted_arr_len.get(aname) {
              Some(hlen) => hlen
              None => {
                let t = qbe_tmp(g)
                qbe_emit(g, t + " =l loadl " + arr_p)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, "arr_oob")
            let l_ok = qbe_lbl(g, "arr_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let dp = match g.hoisted_arr_dp.get(aname) {
            Some(hdp) => hdp
            None => {
              let dp_p = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + arr_p + ", 24")
              qbe_emit(g, t + " =l loadl " + dp_p)
              t
            }
          }
          let off = qbe_tmp(g)
          let ep = qbe_tmp(g)
          qbe_emit(g, off + " =l shl " + il + ", 3")
          qbe_emit(g, ep + " =l add " + dp + ", " + off)
          let ev = qbe_load_heap_slot(g, ep, elem)
          Some(qval(ev, elem))
        }
        _ => None
      }
    None => None
  }
}

///|
fn qbe_emit_arg_maybe_borrow_ext(
  g : QbeGen,
  arg : Expr,
  expected : Option[Ty],
  can_borrow : Bool,
  can_borrow_arr_field : Bool,
) -> QbeArgVal {
  let expect_dyn = match expected {
    Some(TDynTrait(_)) => true
    _ => false
  }
  if can_borrow {
    match arg {
      EString(s, _) =>
        if !expect_dyn {
          return QbeArgVal::{ qv: qval(qbe_emit_string_lit(g, s), TString), borrowed: true }
        }
      EIdent(lname, _) =>
        match qbe_lookup_local(g, lname) {
          Some(loc) => {
            let loc_ok = if !expect_dyn {
              true
            } else {
              match loc.ty {
                TDynTrait(_) => true
                _ => false
              }
            }
            if loc_ok {
              g.unfrozen_local_arrs.remove(lname)
              let t = qbe_load_local_slot(g, loc.slot, loc.ty)
              return QbeArgVal::{ qv: qval(t, loc.ty), borrowed: true }
            }
          }
          None => ()
        }
      EField(EIdent(lname, _), fname, _) =>
        if !expect_dyn {
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            match loc.ty {
              TStruct(sname, sargs) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let subst = make_subst(sinfo.decl.type_params, sargs)
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname {
                        if !sinfo.field_muts[fi] || can_borrow_arr_field {
                          if !sinfo.field_muts[fi] {
                            let fkey = lname + "." + fname
                            match g.hoisted_fields.get(fkey) {
                              Some(hv) =>
                                return QbeArgVal::{ qv: hv, borrowed: true }
                              None => ()
                            }
                            match g.block_immut_fields.get(fkey) {
                              Some(bv) =>
                                return QbeArgVal::{ qv: bv, borrowed: true }
                              None => ()
                            }
                          }
                          let fty = subst_ty(sinfo.field_tys[fi], subst)
                          let obj_p = qbe_tmp(g)
                          let fp = qbe_tmp(g)
                          qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                          qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                          let fv = qbe_load_heap_slot(g, fp, fty)
                          return QbeArgVal::{ qv: qval(fv, fty), borrowed: true }
                        }
                        break
                      }
                      fi = fi + 1
                    }
                  }
                  None => ()
                }
              _ => ()
            }
          None => ()
        }
        }
      EIndex(EIdent(aname, _), idx_expr, _) =>
        if can_borrow_arr_field && !expect_dyn {
          match qbe_lookup_local(g, aname) {
            Some(aloc) =>
              match aloc.ty {
                TArray(elem) | TFixedArray(elem) =>
                  if qbe_is_obj_ty(elem) {
                    match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                      Some(ev) => return QbeArgVal::{ qv: ev, borrowed: true }
                      None => ()
                    }
                  }
                _ => ()
              }
            None => ()
          }
        }
      EField(EIndex(EIdent(aname, _), idx_expr, _), fname, _) =>
        if can_borrow_arr_field && !expect_dyn {
          match qbe_lookup_local(g, aname) {
            Some(aloc) =>
              match aloc.ty {
                TArray(TStruct(sname, sargs)) | TFixedArray(TStruct(sname, sargs)) =>
                  match qbe_lookup_struct_info(g, sname) {
                    Some(sinfo) => {
                      let subst = make_subst(sinfo.decl.type_params, sargs)
                      let mut fi = 0
                      while fi < sinfo.field_names.length() {
                        if sinfo.field_names[fi] == fname {
                          match qbe_try_emit_borrowed_arr_elem(g, aname, idx_expr) {
                            Some(ev) => {
                              let fty = subst_ty(sinfo.field_tys[fi], subst)
                              let fp = qbe_tmp(g)
                              qbe_emit(g, fp + " =l add " + ev.reg + ", " + (fi * 8).to_string())
                              let fv = qbe_load_heap_slot(g, fp, fty)
                              return QbeArgVal::{ qv: qval(fv, fty), borrowed: true }
                            }
                            None => ()
                          }
                          break
                        }
                        fi = fi + 1
                      }
                    }
                    None => ()
                  }
                _ => ()
              }
            None => ()
          }
        }
      _ => ()
    }
  }
  QbeArgVal::{ qv: qbe_emit_expr(g, arg, expected), borrowed: false }
}

///|
fn qbe_emit_arg_maybe_borrow(
  g : QbeGen,
  arg : Expr,
  expected : Option[Ty],
  can_borrow : Bool,
) -> QbeArgVal {
  qbe_emit_arg_maybe_borrow_ext(g, arg, expected, can_borrow, false)
}

///|
fn qbe_pat_binds_name(pat : Pattern, name : String) -> Bool {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => false
    PIdent(n, _) => n == name
    PTuple(subs, _) | PVariant(_, _, subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_binds_name(subs[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_expr_assigns_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_assigns_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_assigns_ident(l, name) || qbe_expr_assigns_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_assigns_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_assigns_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_assigns_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_assigns_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_assigns_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_assigns_ident(b, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_assigns_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_assigns_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_assigns_ident(cond, name) || qbe_stmts_assigns_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_assigns_ident(el, name)
      }
    }
    EIs(scrut, _, _) => qbe_expr_assigns_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_assigns_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_assigns_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_assigns_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_assigns_ident(body, name)
  }
}

///|
fn qbe_stmt_assigns_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_assigns_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_assigns_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EIdent(n, _) =>
          if n == name {
            return true
          }
        _ => ()
      }
      qbe_expr_assigns_ident(lhs, name) || qbe_expr_assigns_ident(rhs, name)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_assigns_ident(cond, name) || qbe_stmts_assigns_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_assigns_ident(init_s, name) ||
      qbe_expr_assigns_ident(cond, name) ||
      qbe_stmt_assigns_ident(step_s, name) ||
      qbe_stmts_assigns_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_assigns_ident(start_e, name) ||
      qbe_expr_assigns_ident(end_e, name) ||
      qbe_stmts_assigns_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_assigns_ident(iter_e, name) ||
      qbe_stmts_assigns_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_assigns_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_assigns_ident(c, name) || qbe_expr_assigns_ident(m, name)
    SExpr(e, _) => qbe_expr_assigns_ident(e, name)
  }
}

///|
fn qbe_stmts_assigns_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_assigns_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_mentions_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EIdent(n, _) => n == name
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_mentions_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_mentions_ident(l, name) || qbe_expr_mentions_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_mentions_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_mentions_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_mentions_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_mentions_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_mentions_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_mentions_ident(b, name) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_mentions_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_mentions_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_mentions_ident(cond, name) || qbe_stmts_mentions_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_mentions_ident(el, name)
      }
    }
    EIs(scrut, _, _) => qbe_expr_mentions_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_mentions_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_mentions_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_mentions_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_mentions_ident(body, name)
  }
}

///|
fn qbe_stmt_mentions_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_mentions_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_mentions_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_mentions_ident(lhs, name) || qbe_expr_mentions_ident(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_mentions_ident(cond, name) || qbe_stmts_mentions_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_mentions_ident(init_s, name) ||
      qbe_expr_mentions_ident(cond, name) ||
      qbe_stmt_mentions_ident(step_s, name) ||
      qbe_stmts_mentions_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_mentions_ident(start_e, name) ||
      qbe_expr_mentions_ident(end_e, name) ||
      qbe_stmts_mentions_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_mentions_ident(iter_e, name) ||
      qbe_stmts_mentions_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_mentions_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_mentions_ident(c, name) || qbe_expr_mentions_ident(m, name)
    SExpr(e, _) => qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_stmts_mentions_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_mentions_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Conservative static check: returns true only when `name` never escapes
/// (never returned, never reassigned, never stored in any container/struct/enum/tuple/closure)
/// and only appears in borrow-safe positions (direct call args, field/index receiver, match scrutinee).
fn qbe_ident_is_borrow_safe_expr(g : QbeGen, e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != name
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_ident_is_borrow_safe_expr(g, inner, name)
    EBinary(_, l, r, _) =>
      qbe_ident_is_borrow_safe_expr(g, l, name) &&
      qbe_ident_is_borrow_safe_expr(g, r, name)
    EField(obj, _, _) =>
      match obj {
        EIdent(n, _) =>
          if n == name {
            true
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    EIndex(obj, idx, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, idx, name) {
        return false
      }
      match obj {
        EIdent(n, _) =>
          if n == name {
            !qbe_expr_has_assign(idx)
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
      }
    }
    ECall(callee, args, _) => {
      let is_direct_borrow_callee = match callee {
        EIdent(fname, _) =>
          g.tc.fns.contains(fname) ||
          fname == "sha256_hex" ||
          is_world_builtin(fname)
        EPath(qual, mem, _) => g.tc.methods.contains(qual + "::" + mem)
        _ => false
      }
      if is_direct_borrow_callee && !qbe_args_have_assign(args) {
        let mut i = 0
        while i < args.length() {
          match args[i] {
            EIdent(n, _) =>
              if n != name {
                ()
              }
            _ =>
              if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
                return false
              }
          }
          i = i + 1
        }
        true
      } else {
        if !qbe_ident_is_borrow_safe_expr(g, callee, name) {
          return false
        }
        let mut i = 0
        while i < args.length() {
          if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
            return false
          }
          i = i + 1
        }
        true
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if mname != "to_string" &&
        !qbe_expr_has_assign(obj) &&
        !qbe_args_have_assign(args) {
        let obj_ok = match obj {
          EIdent(n, _) => if n == name { true } else { true }
          _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
        }
        if !obj_ok {
          return false
        }
        let mut i = 0
        while i < args.length() {
          match args[i] {
            EIdent(n, _) => if n != name { () }
            _ =>
              if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
                return false
              }
          }
          i = i + 1
        }
        true
      } else {
        if !qbe_ident_is_borrow_safe_expr(g, obj, name) {
          return false
        }
        let mut i = 0
        while i < args.length() {
          if !qbe_ident_is_borrow_safe_expr(g, args[i], name) {
            return false
          }
          i = i + 1
        }
        true
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_is_borrow_safe_expr(g, elems[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_ident_is_borrow_safe_expr(g, b, name) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_is_borrow_safe_expr(g, fields[i].value, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_ident_is_borrow_safe_stmts(g, stmts, 0, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, cond, name) ||
        !qbe_ident_is_borrow_safe_stmts(g, then_stmts, 0, name) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_ident_is_borrow_safe_expr(g, el, name)
      }
    }
    EIs(scrut, _, _) => qbe_ident_is_borrow_safe_expr(g, scrut, name)
    EMatch(scrut, arms, _) => {
      let scrut_ok = match scrut {
        EIdent(n, _) =>
          if n == name {
            let mut ai = 0
            let mut ok = true
            while ai < arms.length() {
              match arms[ai].guard_expr {
                Some(ge) =>
                  if qbe_expr_assigns_ident(ge, name) {
                    ok = false
                    break
                  }
                None => ()
              }
              if qbe_expr_assigns_ident(arms[ai].body, name) {
                ok = false
                break
              }
              ai = ai + 1
            }
            ok
          } else {
            true
          }
        _ => qbe_ident_is_borrow_safe_expr(g, scrut, name)
      }
      if !scrut_ok {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, name) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_ident_is_borrow_safe_expr(g, ge, name) {
                return false
              }
            None => ()
          }
          if !qbe_ident_is_borrow_safe_expr(g, arms[i].body, name) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) =>
      !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_is_borrow_safe_stmt(g : QbeGen, s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_ident_is_borrow_safe_expr(g, init, name)
    SLetTuple(_, _, init, _) => qbe_ident_is_borrow_safe_expr(g, init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_ident_is_borrow_safe_expr(g, rhs, name) {
        return false
      }
      match lhs {
        EIdent(n, _) => n != name
        EField(obj, _, _) =>
          match obj {
            EIdent(n, _) =>
              if n == name {
                !qbe_expr_has_assign(rhs)
              } else {
                true
              }
            _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
          }
        EIndex(obj, idx, _) => {
          if !qbe_ident_is_borrow_safe_expr(g, idx, name) {
            return false
          }
          match obj {
            EIdent(n, _) =>
              if n == name {
                !qbe_expr_has_assign(idx) && !qbe_expr_has_assign(rhs)
              } else {
                true
              }
            _ => qbe_ident_is_borrow_safe_expr(g, obj, name)
          }
        }
        _ => qbe_ident_is_borrow_safe_expr(g, lhs, name)
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, cond, name) &&
      qbe_ident_is_borrow_safe_stmts(g, body, 0, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_ident_is_borrow_safe_stmt(g, init_s, name) &&
      qbe_ident_is_borrow_safe_expr(g, cond, name) &&
      qbe_ident_is_borrow_safe_stmt(g, step_s, name) &&
      qbe_ident_is_borrow_safe_stmts(g, body, 0, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, start_e, name) &&
      qbe_ident_is_borrow_safe_expr(g, end_e, name) &&
      (vname == name || qbe_ident_is_borrow_safe_stmts(g, body, 0, name))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_ident_is_borrow_safe_expr(g, iter_e, name) &&
      (vname == name || qbe_ident_is_borrow_safe_stmts(g, body, 0, name))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_ident_is_borrow_safe_expr(g, e, name)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_ident_is_borrow_safe_expr(g, c, name) &&
      qbe_ident_is_borrow_safe_expr(g, m, name)
    SExpr(e, _) => qbe_ident_is_borrow_safe_expr(g, e, name)
  }
}

///|
fn qbe_ident_is_borrow_safe_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  start_idx : Int,
  name : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_ident_is_borrow_safe_expr(g, init, name) {
          return false
        }
        if lname == name {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_ident_is_borrow_safe_expr(g, init, name) {
          return false
        }
        if str_arr_contains(lnames, name) {
          return true
        }
      }
      _ =>
        if !qbe_ident_is_borrow_safe_stmt(g, stmts[i], name) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
/// Check that local array `aname` is never mutated in container structure
/// (no reassignment, no `.push`/`.pop`, never passed to any function/closure;
/// if `allow_elem_assign` is false, also disallows `aname[...] = ...`).
///|
fn qbe_arr_escapes_in_expr(e : Expr, aname : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EIdent(n, _) => n == aname
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_arr_escapes_in_expr(inner, aname)
    EBinary(_, l, r, _) =>
      qbe_arr_escapes_in_expr(l, aname) || qbe_arr_escapes_in_expr(r, aname)
    EIndex(obj, idx, _) =>
      match obj {
        EIdent(n, _) =>
          if n == aname {
            qbe_expr_mentions_ident(idx, aname)
          } else {
            qbe_arr_escapes_in_expr(idx, aname)
          }
        _ => qbe_arr_escapes_in_expr(obj, aname) || qbe_arr_escapes_in_expr(idx, aname)
      }
    EMethodCall(obj, mname, args, _) =>
      match obj {
        EIdent(n, _) =>
          if n == aname {
            if mname == "push" || mname == "pop" || mname == "length" {
              let mut i = 0
              while i < args.length() {
                if qbe_expr_mentions_ident(args[i], aname) {
                  return true
                }
                i = i + 1
              }
              false
            } else {
              true
            }
          } else {
            let mut i = 0
            while i < args.length() {
              if qbe_arr_escapes_in_expr(args[i], aname) {
                return true
              }
              i = i + 1
            }
            false
          }
        _ => {
          if qbe_arr_escapes_in_expr(obj, aname) {
            return true
          }
          let mut i = 0
          while i < args.length() {
            if qbe_arr_escapes_in_expr(args[i], aname) {
              return true
            }
            i = i + 1
          }
          false
        }
      }
    ECall(callee, args, _) => {
      if qbe_arr_escapes_in_expr(callee, aname) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_arr_escapes_in_expr(args[i], aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_arr_escapes_in_expr(elems[i], aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_arr_escapes_in_expr(b, aname) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_arr_escapes_in_expr(fields[i].value, aname) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_arr_escapes_in_stmts(stmts, 0, aname)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_arr_escapes_in_expr(cond, aname) ||
        qbe_arr_escapes_in_stmts(then_stmts, 0, aname) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_arr_escapes_in_expr(el, aname)
      }
    }
    EIs(scrut, _, _) => qbe_arr_escapes_in_expr(scrut, aname)
    EMatch(scrut, arms, _) => {
      if qbe_arr_escapes_in_expr(scrut, aname) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, aname) {
          match arms[i].guard_expr {
            Some(ge) =>
              if qbe_arr_escapes_in_expr(ge, aname) {
                return true
              }
            None => ()
          }
          if qbe_arr_escapes_in_expr(arms[i].body, aname) {
            return true
          }
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      qbe_expr_mentions_ident(e, aname)
  }
}

///|
fn qbe_arr_escapes_in_stmt(s : Stmt, aname : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_arr_escapes_in_expr(init, aname)
    SLetTuple(_, _, init, _) => qbe_arr_escapes_in_expr(init, aname)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      match lhs {
        EIndex(EIdent(n, _), idx, _) =>
          if n == aname {
            qbe_expr_mentions_ident(idx, aname) || qbe_expr_mentions_ident(rhs, aname)
          } else {
            qbe_arr_escapes_in_expr(idx, aname) || qbe_arr_escapes_in_expr(rhs, aname)
          }
        _ => qbe_arr_escapes_in_expr(lhs, aname) || qbe_arr_escapes_in_expr(rhs, aname)
      }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_arr_escapes_in_expr(cond, aname) || qbe_arr_escapes_in_stmts(body, 0, aname)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_arr_escapes_in_stmt(init_s, aname) ||
      qbe_arr_escapes_in_expr(cond, aname) ||
      qbe_arr_escapes_in_stmt(step_s, aname) ||
      qbe_arr_escapes_in_stmts(body, 0, aname)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_arr_escapes_in_expr(start_e, aname) ||
      qbe_arr_escapes_in_expr(end_e, aname) ||
      (vname != aname && qbe_arr_escapes_in_stmts(body, 0, aname))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_arr_escapes_in_expr(iter_e, aname) ||
      (vname != aname && qbe_arr_escapes_in_stmts(body, 0, aname))
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_arr_escapes_in_expr(e, aname)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_arr_escapes_in_expr(c, aname) || qbe_arr_escapes_in_expr(m, aname)
    SExpr(e, _) => qbe_arr_escapes_in_expr(e, aname)
  }
}

///|
fn qbe_arr_escapes_in_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  aname : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if qbe_arr_escapes_in_expr(init, aname) {
          return true
        }
        if lname == aname {
          return false
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if qbe_arr_escapes_in_expr(init, aname) {
          return true
        }
        if str_arr_contains(lnames, aname) {
          return false
        }
      }
      _ =>
        if qbe_arr_escapes_in_stmt(stmts[i], aname) {
          return true
        }
    }
    i = i + 1
  }
  false
}

///|
fn qbe_invalidate_escaping_unfrozen_arrs(
  g : QbeGen,
  cond_opt : Option[Expr],
  step_opt : Option[Stmt],
  body : Array[Stmt],
) -> Unit {
  let mut si = 0
  while si < g.scopes.length() {
    let sc = g.scopes[si]
    let mut li = 0
    while li < sc.locals.length() {
      let aname = sc.locals[li].name
      if g.unfrozen_local_arrs.contains(aname) {
        let mut escapes = false
        match cond_opt {
          Some(c) =>
            if qbe_arr_escapes_in_expr(c, aname) {
              escapes = true
            }
          None => ()
        }
        if !escapes {
          match step_opt {
            Some(st) =>
              if qbe_arr_escapes_in_stmt(st, aname) {
                escapes = true
              }
            None => ()
          }
        }
        if !escapes && qbe_arr_escapes_in_stmts(body, 0, aname) {
          escapes = true
        }
        if escapes {
          g.unfrozen_local_arrs.remove(aname)
        }
      }
      li = li + 1
    }
    si = si + 1
  }
}

///|
fn qbe_arr_is_stable_expr(
  e : Expr,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != aname
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_arr_is_stable_expr(inner, aname, allow_elem_assign)
    EBinary(_, l, r, _) =>
      qbe_arr_is_stable_expr(l, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(r, aname, allow_elem_assign)
    EIndex(obj, idx, _) => {
      if !qbe_arr_is_stable_expr(idx, aname, allow_elem_assign) {
        return false
      }
      match obj {
        EIdent(n, _) => if n == aname { true } else { true }
        _ => qbe_arr_is_stable_expr(obj, aname, allow_elem_assign)
      }
    }
    EMethodCall(obj, mname, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_arr_is_stable_expr(args[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      match obj {
        EIdent(n, _) =>
          if n == aname {
            mname == "length" && args.length() == 0
          } else {
            true
          }
        _ => qbe_arr_is_stable_expr(obj, aname, allow_elem_assign)
      }
    }
    ECall(callee, args, _) => {
      if !qbe_arr_is_stable_expr(callee, aname, allow_elem_assign) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_arr_is_stable_expr(args[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_arr_is_stable_expr(elems[i], aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_arr_is_stable_expr(b, aname, allow_elem_assign) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_arr_is_stable_expr(fields[i].value, aname, allow_elem_assign) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_arr_is_stable_stmts(stmts, 0, aname, allow_elem_assign)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) ||
        !qbe_arr_is_stable_stmts(then_stmts, 0, aname, allow_elem_assign) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_arr_is_stable_expr(el, aname, allow_elem_assign)
      }
    }
    EIs(scrut, _, _) => qbe_arr_is_stable_expr(scrut, aname, allow_elem_assign)
    EMatch(scrut, arms, _) => {
      if !qbe_arr_is_stable_expr(scrut, aname, allow_elem_assign) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, aname) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_arr_is_stable_expr(ge, aname, allow_elem_assign) {
                return false
              }
            None => ()
          }
          if !qbe_arr_is_stable_expr(arms[i].body, aname, allow_elem_assign) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      !qbe_expr_mentions_ident(e, aname)
  }
}

///|
fn qbe_arr_is_stable_stmt(
  s : Stmt,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_arr_is_stable_expr(init, aname, allow_elem_assign)
    SLetTuple(_, _, init, _) =>
      qbe_arr_is_stable_expr(init, aname, allow_elem_assign)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_arr_is_stable_expr(rhs, aname, allow_elem_assign) {
        return false
      }
      match lhs {
        EIdent(n, _) => n != aname
        EIndex(EIdent(n, _), idx, _) =>
          if n == aname {
            allow_elem_assign &&
            qbe_arr_is_stable_expr(idx, aname, allow_elem_assign)
          } else {
            qbe_arr_is_stable_expr(idx, aname, allow_elem_assign)
          }
        _ => qbe_arr_is_stable_expr(lhs, aname, allow_elem_assign)
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_arr_is_stable_stmt(init_s, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(cond, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmt(step_s, aname, allow_elem_assign) &&
      qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_arr_is_stable_expr(start_e, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(end_e, aname, allow_elem_assign) &&
      (vname == aname || qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_arr_is_stable_expr(iter_e, aname, allow_elem_assign) &&
      (vname == aname || qbe_arr_is_stable_stmts(body, 0, aname, allow_elem_assign))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_arr_is_stable_expr(e, aname, allow_elem_assign)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_arr_is_stable_expr(c, aname, allow_elem_assign) &&
      qbe_arr_is_stable_expr(m, aname, allow_elem_assign)
    SExpr(e, _) => qbe_arr_is_stable_expr(e, aname, allow_elem_assign)
  }
}

///|
fn qbe_arr_is_stable_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  aname : String,
  allow_elem_assign : Bool,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_arr_is_stable_expr(init, aname, allow_elem_assign) {
          return false
        }
        if lname == aname {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_arr_is_stable_expr(init, aname, allow_elem_assign) {
          return false
        }
        if str_arr_contains(lnames, aname) {
          return true
        }
      }
      _ =>
        if !qbe_arr_is_stable_stmt(stmts[i], aname, allow_elem_assign) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
fn qbe_collect_indexed_arrs_expr(e : Expr, out : Array[String]) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_indexed_arrs_expr(inner, out)
    EBinary(_, l, r, _) => {
      qbe_collect_indexed_arrs_expr(l, out)
      qbe_collect_indexed_arrs_expr(r, out)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) =>
          if !str_arr_contains(out, aname) {
            out.push(aname)
          }
        _ => qbe_collect_indexed_arrs_expr(obj, out)
      }
      qbe_collect_indexed_arrs_expr(idx, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_indexed_arrs_expr(callee, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_indexed_arrs_expr(args[i], out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_indexed_arrs_expr(obj, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_indexed_arrs_expr(args[i], out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_indexed_arrs_expr(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_indexed_arrs_expr(fields[i].value, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_indexed_arrs_stmts(stmts, out)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmts(then_stmts, out)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_indexed_arrs_expr(el, out)
      }
    }
    EIs(scrut, _, _) => qbe_collect_indexed_arrs_expr(scrut, out)
    EMatch(scrut, arms, _) => {
      qbe_collect_indexed_arrs_expr(scrut, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_indexed_arrs_expr(ge, out)
          None => ()
        }
        qbe_collect_indexed_arrs_expr(arms[i].body, out)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) => ()
  }
}

///|
fn qbe_collect_indexed_arrs_stmt(s : Stmt, out : Array[String]) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_indexed_arrs_expr(init, out)
    SLetTuple(_, _, init, _) => qbe_collect_indexed_arrs_expr(init, out)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_indexed_arrs_expr(lhs, out)
      qbe_collect_indexed_arrs_expr(rhs, out)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_indexed_arrs_stmt(init_s, out)
      qbe_collect_indexed_arrs_expr(cond, out)
      qbe_collect_indexed_arrs_stmt(step_s, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_indexed_arrs_expr(start_e, out)
      qbe_collect_indexed_arrs_expr(end_e, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_indexed_arrs_expr(iter_e, out)
      qbe_collect_indexed_arrs_stmts(body, out)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_indexed_arrs_expr(e, out)
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_indexed_arrs_expr(c, out)
      qbe_collect_indexed_arrs_expr(m, out)
    }
    SExpr(e, _) => qbe_collect_indexed_arrs_expr(e, out)
  }
}

///|
fn qbe_collect_indexed_arrs_stmts(stmts : Array[Stmt], out : Array[String]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_indexed_arrs_stmt(stmts[i], out)
    i = i + 1
  }
}

///|
fn qbe_inc_count_by(counts : Map[String, Int], name : String, weight : Int) -> Unit {
  match counts.get(name) {
    Some(c) => counts.set(name, c + weight)
    None => counts.set(name, weight)
  }
}

///|
fn qbe_collect_loop_idx_expr(
  e : Expr,
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_loop_idx_expr(inner, arrs, counts, strs, weight)
    EBinary(_, l, r, _) => {
      qbe_collect_loop_idx_expr(l, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(r, arrs, counts, strs, weight)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(aname, _) => {
          if !str_arr_contains(arrs, aname) {
            arrs.push(aname)
          }
          qbe_inc_count_by(counts, aname, weight)
        }
        _ => qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
      }
      qbe_collect_loop_idx_expr(idx, arrs, counts, strs, weight)
    }
    ECall(callee, args, _) => {
      qbe_collect_loop_idx_expr(callee, arrs, counts, strs, weight)
      let mut i = 0
      while i < args.length() {
        qbe_collect_loop_idx_expr(args[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if (mname == "code_unit_at" && args.length() == 1) || (mname == "length" && args.length() == 0) {
        match obj {
          EIdent(sname, _) =>
            if !str_arr_contains(strs, sname) {
              strs.push(sname)
            }
          _ => qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
        }
      } else {
        qbe_collect_loop_idx_expr(obj, arrs, counts, strs, weight)
      }
      let mut i = 0
      while i < args.length() {
        qbe_collect_loop_idx_expr(args[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_loop_idx_expr(elems[i], arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_loop_idx_expr(fields[i].value, arrs, counts, strs, weight)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_loop_idx_stmts(stmts, arrs, counts, strs, weight)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(then_stmts, arrs, counts, strs, 1)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_loop_idx_expr(el, arrs, counts, strs, 1)
      }
    }
    EIs(scrut, _, _) => qbe_collect_loop_idx_expr(scrut, arrs, counts, strs, weight)
    EMatch(scrut, arms, _) => {
      qbe_collect_loop_idx_expr(scrut, arrs, counts, strs, weight)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_loop_idx_expr(ge, arrs, counts, strs, 1)
          None => ()
        }
        qbe_collect_loop_idx_expr(arms[i].body, arrs, counts, strs, 1)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) => ()
  }
}

///|
fn qbe_collect_loop_idx_stmt(
  s : Stmt,
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_loop_idx_expr(init, arrs, counts, strs, weight)
    SLetTuple(_, _, init, _) => qbe_collect_loop_idx_expr(init, arrs, counts, strs, weight)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_loop_idx_expr(lhs, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(rhs, arrs, counts, strs, weight)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_loop_idx_stmt(init_s, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(cond, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmt(step_s, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_loop_idx_expr(start_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(end_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_loop_idx_expr(iter_e, arrs, counts, strs, weight)
      qbe_collect_loop_idx_stmts(body, arrs, counts, strs, weight)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_loop_idx_expr(e, arrs, counts, strs, weight)
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_loop_idx_expr(c, arrs, counts, strs, weight)
      qbe_collect_loop_idx_expr(m, arrs, counts, strs, weight)
    }
    SExpr(e, _) => qbe_collect_loop_idx_expr(e, arrs, counts, strs, weight)
  }
}

///|
fn qbe_collect_loop_idx_stmts(
  stmts : Array[Stmt],
  arrs : Array[String],
  counts : Map[String, Int],
  strs : Array[String],
  weight : Int,
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_loop_idx_stmt(stmts[i], arrs, counts, strs, weight)
    i = i + 1
  }
}

///|
fn qbe_expr_count_mentions(e : Expr, name : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 0
    EIdent(n, _) => if n == name { 1 } else { 0 }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_count_mentions(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_count_mentions(l, name) + qbe_expr_count_mentions(r, name)
    ECall(callee, args, _) => {
      let mut tot = qbe_expr_count_mentions(callee, name)
      let mut i = 0
      while i < args.length() {
        tot = tot + qbe_expr_count_mentions(args[i], name)
        i = i + 1
      }
      tot
    }
    EMethodCall(obj, _, args, _) => {
      let mut tot = qbe_expr_count_mentions(obj, name)
      let mut i = 0
      while i < args.length() {
        tot = tot + qbe_expr_count_mentions(args[i], name)
        i = i + 1
      }
      tot
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut tot = 0
      let mut i = 0
      while i < elems.length() {
        tot = tot + qbe_expr_count_mentions(elems[i], name)
        i = i + 1
      }
      tot
    }
    EStructLit(_, _spread, fields, _) => {
      let mut tot = 0
      let mut i = 0
      while i < fields.length() {
        tot = tot + qbe_expr_count_mentions(fields[i].value, name)
        i = i + 1
      }
      tot
    }
    EBlock(_, _) | EIf(_, _, _, _) | EMatch(_, _, _) | EIs(_, _, _) | EClosure(_, _, _, _) => 2
  }
}

///|
fn qbe_expr_is_straight_line_movable(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_is_straight_line_movable(inner)
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        false
      } else {
        qbe_expr_is_straight_line_movable(l) && qbe_expr_is_straight_line_movable(r)
      }
    EIndex(l, r, _) =>
      qbe_expr_is_straight_line_movable(l) && qbe_expr_is_straight_line_movable(r)
    ECall(callee, args, _) => {
      if !qbe_expr_is_straight_line_movable(callee) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_straight_line_movable(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_expr_is_straight_line_movable(obj) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_straight_line_movable(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_expr_is_straight_line_movable(elems[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if !qbe_expr_is_straight_line_movable(fields[i].value) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(_, _) | EIf(_, _, _, _) | EMatch(_, _, _) | EIs(_, _, _) | EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      false
  }
}

///|
fn qbe_is_double_two(e : Expr) -> Bool {
  match e {
    EDouble(raw, _) => raw == "2.0" || raw == "2." || raw == "2.00" || raw == "2.000"
    _ => false
  }
}

///|
/// Conservative check: returns true only when `e` contains no calls (except pure `math_sqrt`)
/// and no closures/scope/spawn, guaranteeing zero hidden aliasing writes.
fn qbe_loop_has_no_calls_expr(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_loop_has_no_calls_expr(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_loop_has_no_calls_expr(l) && qbe_loop_has_no_calls_expr(r)
    ECall(callee, args, _) =>
      match callee {
        EIdent(fname, _) =>
          if fname == "math_sqrt" ||
            fname == "math_abs" ||
            fname == "math_floor" ||
            fname == "math_ceil" ||
            fname == "math_sin" ||
            fname == "math_cos" ||
            fname == "math_pow" ||
            fname == "math_tan" ||
            fname == "math_asin" ||
            fname == "math_acos" ||
            fname == "math_atan" ||
            fname == "math_atan2" ||
            fname == "math_exp" ||
            fname == "math_log" ||
            fname == "math_round" ||
            fname == "math_trunc" ||
            fname == "c_fn_ptr" ||
            fname == "str_data_ptr" ||
            fname == "bytes_data_ptr" ||
            fname == "array_data_ptr" ||
            fname == "ptr_read_f64" ||
            fname == "ptr_read_f32" {
            let mut i = 0
            while i < args.length() {
              if !qbe_loop_has_no_calls_expr(args[i]) {
                return false
              }
              i = i + 1
            }
            true
          } else {
            false
          }
        _ => false
      }
    EMethodCall(_, _, _, _) | EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) =>
      false
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_loop_has_no_calls_expr(elems[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_loop_has_no_calls_expr(b) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_loop_has_no_calls_expr(fields[i].value) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_loop_has_no_calls_stmts(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_loop_has_no_calls_expr(cond) || !qbe_loop_has_no_calls_stmts(then_stmts) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_loop_has_no_calls_expr(el)
      }
    }
    EIs(scrut, _, _) => qbe_loop_has_no_calls_expr(scrut)
    EMatch(scrut, arms, _) => {
      if !qbe_loop_has_no_calls_expr(scrut) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_loop_has_no_calls_expr(ge) {
              return false
            }
          None => ()
        }
        if !qbe_loop_has_no_calls_expr(arms[i].body) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

///|
fn qbe_loop_has_no_calls_stmt(s : Stmt) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_loop_has_no_calls_expr(init)
    SLetTuple(_, _, init, _) => qbe_loop_has_no_calls_expr(init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_loop_has_no_calls_expr(lhs) && qbe_loop_has_no_calls_expr(rhs)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_loop_has_no_calls_expr(cond) && qbe_loop_has_no_calls_stmts(body)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_loop_has_no_calls_stmt(init_s) &&
      qbe_loop_has_no_calls_expr(cond) &&
      qbe_loop_has_no_calls_stmt(step_s) &&
      qbe_loop_has_no_calls_stmts(body)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_loop_has_no_calls_expr(start_e) &&
      qbe_loop_has_no_calls_expr(end_e) &&
      qbe_loop_has_no_calls_stmts(body)
    SForIn(_, _, iter_e, body, _) =>
      qbe_loop_has_no_calls_expr(iter_e) &&
      qbe_loop_has_no_calls_stmts(body)
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_loop_has_no_calls_expr(e)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_loop_has_no_calls_expr(c) && qbe_loop_has_no_calls_expr(m)
    SExpr(e, _) => qbe_loop_has_no_calls_expr(e)
  }
}

///|
fn qbe_loop_has_no_calls_stmts(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if !qbe_loop_has_no_calls_stmt(stmts[i]) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_collect_written_fields_expr(e : Expr, out : Map[String, Bool]) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_written_fields_expr(inner, out)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_written_fields_expr(l, out)
      qbe_collect_written_fields_expr(r, out)
    }
    ECall(callee, args, _) => {
      qbe_collect_written_fields_expr(callee, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_written_fields_expr(args[i], out)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_written_fields_expr(obj, out)
      let mut i = 0
      while i < args.length() {
        qbe_collect_written_fields_expr(args[i], out)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_written_fields_expr(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_written_fields_expr(fields[i].value, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_written_fields_stmts(stmts, out)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmts(then_stmts, out)
      match else_opt {
        Some(el) => qbe_collect_written_fields_expr(el, out)
        None => ()
      }
    }
    EIs(scrut, _, _) => qbe_collect_written_fields_expr(scrut, out)
    EMatch(scrut, arms, _) => {
      qbe_collect_written_fields_expr(scrut, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_written_fields_expr(ge, out)
          None => ()
        }
        qbe_collect_written_fields_expr(arms[i].body, out)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) => qbe_collect_written_fields_stmts(body, out)
  }
}

///|
fn qbe_collect_written_fields_stmt(s : Stmt, out : Map[String, Bool]) -> Unit {
  match s {
    SLet(_, _, _, init, _) => qbe_collect_written_fields_expr(init, out)
    SLetTuple(_, _, init, _) => qbe_collect_written_fields_expr(init, out)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EField(_, fname, _) => out.set(fname, true)
        _ => ()
      }
      qbe_collect_written_fields_expr(lhs, out)
      qbe_collect_written_fields_expr(rhs, out)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_written_fields_stmt(init_s, out)
      qbe_collect_written_fields_expr(cond, out)
      qbe_collect_written_fields_stmt(step_s, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_written_fields_expr(start_e, out)
      qbe_collect_written_fields_expr(end_e, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_written_fields_expr(iter_e, out)
      qbe_collect_written_fields_stmts(body, out)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_collect_written_fields_expr(e, out)
        None => ()
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_written_fields_expr(c, out)
      qbe_collect_written_fields_expr(m, out)
    }
    SExpr(e, _) => qbe_collect_written_fields_expr(e, out)
  }
}

///|
fn qbe_collect_written_fields_stmts(stmts : Array[Stmt], out : Map[String, Bool]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_written_fields_stmt(stmts[i], out)
    i = i + 1
  }
}

///|
fn qbe_collect_read_fields_expr(
  e : Expr,
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EField(obj, fname, _) =>
      match obj {
        EIdent(vname, _) => {
          let key = vname + "." + fname
          if !seen.contains(key) {
            seen.set(key, true)
            out_vars.push(vname)
            out_fields.push(fname)
          }
        }
        _ => qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_read_fields_expr(inner, out_vars, out_fields, seen)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_read_fields_expr(l, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(r, out_vars, out_fields, seen)
    }
    ECall(callee, args, _) => {
      qbe_collect_read_fields_expr(callee, out_vars, out_fields, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_read_fields_expr(args[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_read_fields_expr(args[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_read_fields_expr(elems[i], out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_read_fields_expr(fields[i].value, out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EBlock(stmts, _) =>
      qbe_collect_read_fields_stmts(stmts, out_vars, out_fields, seen)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(then_stmts, out_vars, out_fields, seen)
      match else_opt {
        Some(el) => qbe_collect_read_fields_expr(el, out_vars, out_fields, seen)
        None => ()
      }
    }
    EIs(scrut, _, _) => qbe_collect_read_fields_expr(scrut, out_vars, out_fields, seen)
    EMatch(scrut, arms, _) => {
      qbe_collect_read_fields_expr(scrut, out_vars, out_fields, seen)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_read_fields_expr(ge, out_vars, out_fields, seen)
          None => ()
        }
        qbe_collect_read_fields_expr(arms[i].body, out_vars, out_fields, seen)
        i = i + 1
      }
    }
    EClosure(_, _, body, _) =>
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
  }
}

///|
fn qbe_collect_read_fields_stmt(
  s : Stmt,
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_read_fields_expr(init, out_vars, out_fields, seen)
    SLetTuple(_, _, init, _) =>
      qbe_collect_read_fields_expr(init, out_vars, out_fields, seen)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      match lhs {
        EField(obj, _, _) =>
          qbe_collect_read_fields_expr(obj, out_vars, out_fields, seen)
        _ => qbe_collect_read_fields_expr(lhs, out_vars, out_fields, seen)
      }
      qbe_collect_read_fields_expr(rhs, out_vars, out_fields, seen)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) => {
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_collect_read_fields_stmt(init_s, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(cond, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmt(step_s, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SForRange(_, start_e, end_e, _, body, _) => {
      qbe_collect_read_fields_expr(start_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(end_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SForIn(_, _, iter_e, body, _) => {
      qbe_collect_read_fields_expr(iter_e, out_vars, out_fields, seen)
      qbe_collect_read_fields_stmts(body, out_vars, out_fields, seen)
    }
    SReturn(opt, _) =>
      match opt {
        Some(e) => qbe_collect_read_fields_expr(e, out_vars, out_fields, seen)
        None => ()
      }
    SBreak(_) | SContinue(_) => ()
    SDebugAssert(c, m, _) => {
      qbe_collect_read_fields_expr(c, out_vars, out_fields, seen)
      qbe_collect_read_fields_expr(m, out_vars, out_fields, seen)
    }
    SExpr(e, _) => qbe_collect_read_fields_expr(e, out_vars, out_fields, seen)
  }
}

///|
fn qbe_collect_read_fields_stmts(
  stmts : Array[Stmt],
  out_vars : Array[String],
  out_fields : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_read_fields_stmt(stmts[i], out_vars, out_fields, seen)
    i = i + 1
  }
}

///|
fn qbe_expr_rebinds_ident(e : Expr, name : String) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_rebinds_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_rebinds_ident(l, name) || qbe_expr_rebinds_ident(r, name)
    ECall(callee, args, _) => {
      if qbe_expr_rebinds_ident(callee, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_rebinds_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_rebinds_ident(obj, name) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_rebinds_ident(args[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_rebinds_ident(elems[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_rebinds_ident(fields[i].value, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_rebinds_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_rebinds_ident(cond, name) || qbe_stmts_rebinds_ident(then_stmts, name) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_rebinds_ident(el, name)
      }
    }
    EIs(scrut, pat, _) => qbe_expr_rebinds_ident(scrut, name) || qbe_pat_binds_name(pat, name)
    EMatch(scrut, arms, _) => {
      if qbe_expr_rebinds_ident(scrut, name) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_rebinds_ident(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_pat_binds_name(arms[i].pat, name) ||
          qbe_expr_rebinds_ident(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_rebinds_ident(body, name)
  }
}

///|
fn qbe_stmt_rebinds_ident(s : Stmt, name : String) -> Bool {
  match s {
    SLet(n, _, _, init, _) => n == name || qbe_expr_rebinds_ident(init, name)
    SLetTuple(ns, _, init, _) =>
      str_arr_contains(ns, name) || qbe_expr_rebinds_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_rebinds_ident(lhs, name) || qbe_expr_rebinds_ident(rhs, name)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_rebinds_ident(cond, name) || qbe_stmts_rebinds_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_rebinds_ident(init_s, name) ||
      qbe_expr_rebinds_ident(cond, name) ||
      qbe_stmt_rebinds_ident(step_s, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SForRange(vname, start_e, end_e, _, body, _) =>
      vname == name ||
      qbe_expr_rebinds_ident(start_e, name) ||
      qbe_expr_rebinds_ident(end_e, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SForIn(_, vname, iter_e, body, _) =>
      vname == name ||
      qbe_expr_rebinds_ident(iter_e, name) ||
      qbe_stmts_rebinds_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_rebinds_ident(e, name)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_rebinds_ident(c, name) || qbe_expr_rebinds_ident(m, name)
    SExpr(e, _) => qbe_expr_rebinds_ident(e, name)
  }
}

///|
fn qbe_stmts_rebinds_ident(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_rebinds_ident(stmts[i], name) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_stmt_is_inc_by_one(s : Stmt, name : String) -> Bool {
  match s {
    SAssign(EIdent(lhs_n, _), EBinary("+", EIdent(rhs_n, _), EInt(raw, _), _), _) =>
      lhs_n == name && rhs_n == name && qbe_parse_int64_lit(raw) == 1L
    SCompoundAssign("+", EIdent(lhs_n, _), EInt(raw, _), _) =>
      lhs_n == name && qbe_parse_int64_lit(raw) == 1L
    _ => false
  }
}

///|
fn qbe_cond_node_count(e : Expr) -> Int {
  match e {
    EIdent(_, _)
    | EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EBool(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EByte(_, _)
    | EChar(_, _) => 1
    EUnary(_, inner, _) => {
      let n = qbe_cond_node_count(inner)
      if n < 0 { -1 } else { n + 1 }
    }
    EBinary(_, lhs, rhs, _) => {
      let nl = qbe_cond_node_count(lhs)
      if nl < 0 {
        return -1
      }
      let nr = qbe_cond_node_count(rhs)
      if nr < 0 { -1 } else { nl + nr + 1 }
    }
    _ => -1
  }
}

///|
fn qbe_is_pure_small_cond(cond : Expr, max_nodes : Int) -> Bool {
  let n = qbe_cond_node_count(cond)
  n > 0 && n <= max_nodes
}

///|
fn qbe_expr_has_nested_loop(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_nested_loop(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_nested_loop(l) || qbe_expr_has_nested_loop(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_nested_loop(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_loop(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_nested_loop(obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_nested_loop(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_nested_loop(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_nested_loop(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_nested_loop(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_nested_loop(cond) || qbe_stmts_has_nested_loop(then_stmts) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_nested_loop(el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_nested_loop(scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_nested_loop(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_nested_loop(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_nested_loop(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, body, _) => qbe_stmts_has_nested_loop(body)
  }
}

///|
fn qbe_stmt_has_nested_loop(s : Stmt) -> Bool {
  match s {
    SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) => true
    SGuard(cond, body, _) => qbe_expr_has_nested_loop(cond) || qbe_stmts_has_nested_loop(body)
    SLet(_, _, _, init, _) => qbe_expr_has_nested_loop(init)
    SLetTuple(_, _, init, _) => qbe_expr_has_nested_loop(init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_nested_loop(lhs) || qbe_expr_has_nested_loop(rhs)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_nested_loop(e)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_nested_loop(c) || qbe_expr_has_nested_loop(m)
    SExpr(e, _) => qbe_expr_has_nested_loop(e)
  }
}

///|
fn qbe_stmts_has_nested_loop(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_nested_loop(stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_has_cf(
  e : Expr,
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_cf(inner, check_break, check_cont, check_ret)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_has_cf(l, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(r, check_break, check_cont, check_ret)
    ECall(callee, args, _) => {
      if qbe_expr_has_cf(callee, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_cf(args[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, _, args, _) => {
      if qbe_expr_has_cf(obj, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_cf(args[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_cf(elems[i], check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_cf(b, check_break, check_cont, check_ret) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_cf(fields[i].value, check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_cf(stmts, check_break, check_cont, check_ret)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
        qbe_stmts_has_cf(then_stmts, check_break, check_cont, check_ret) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_cf(el, check_break, check_cont, check_ret)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_cf(scrut, check_break, check_cont, check_ret)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_cf(scrut, check_break, check_cont, check_ret) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_cf(ge, check_break, check_cont, check_ret) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_cf(arms[i].body, check_break, check_cont, check_ret) {
          return true
        }
        i = i + 1
      }
      false
    }
    ETry(inner, _) =>
      check_ret || qbe_expr_has_cf(inner, check_break, check_cont, check_ret)
    EClosure(_, _, _, _) => false
  }
}

///|
fn qbe_stmt_has_cf(
  s : Stmt,
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  match s {
    SBreak(_) => check_break
    SContinue(_) => check_cont
    SReturn(opt, _) =>
      if check_ret {
        true
      } else {
        match opt {
          None => false
          Some(e) => qbe_expr_has_cf(e, check_break, check_cont, check_ret)
        }
      }
    SLet(_, _, _, init, _) =>
      qbe_expr_has_cf(init, check_break, check_cont, check_ret)
    SLetTuple(_, _, init, _) =>
      qbe_expr_has_cf(init, check_break, check_cont, check_ret)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_cf(lhs, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(rhs, check_break, check_cont, check_ret)
    SGuard(cond, body, _) =>
      qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, check_break, check_cont, check_ret)
    SWhile(cond, body, _) =>
      qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_has_cf(init_s, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(cond, check_break, check_cont, check_ret) ||
      qbe_stmt_has_cf(step_s, false, false, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_cf(start_e, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(end_e, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_cf(iter_e, check_break, check_cont, check_ret) ||
      qbe_stmts_has_cf(body, false, false, check_ret)
    SDebugAssert(c, m, _) =>
      qbe_expr_has_cf(c, check_break, check_cont, check_ret) ||
      qbe_expr_has_cf(m, check_break, check_cont, check_ret)
    SExpr(e, _) => qbe_expr_has_cf(e, check_break, check_cont, check_ret)
  }
}

///|
fn qbe_stmts_has_cf(
  stmts : Array[Stmt],
  check_break : Bool,
  check_cont : Bool,
  check_ret : Bool,
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if qbe_stmt_has_cf(stmts[i], check_break, check_cont, check_ret) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn qbe_bce_expr_is_safe(g : QbeGen, arr : String, idx : Expr) -> Bool {
  match idx {
    EIdent(iname, _) =>
      g.bce_safe_indices.contains(iname + ":" + arr) ||
      g.bce_safe_exprs.contains(arr + ":iv:" + iname)
    EBinary("+", EIdent(iname, _), EInt(raw, _), _) => {
      let c = qbe_parse_int64_lit(raw)
      g.bce_safe_exprs.contains(arr + ":iv+:" + iname + ":" + c.to_string())
    }
    EBinary("+", EInt(raw, _), EIdent(iname, _), _) => {
      let c = qbe_parse_int64_lit(raw)
      g.bce_safe_exprs.contains(arr + ":iv+:" + iname + ":" + c.to_string())
    }
    EBinary("-", EIdent(vname, _), EIdent(iname, _), _) =>
      g.bce_safe_exprs.contains(arr + ":v-iv:" + vname + ":" + iname)
    _ => false
  }
}

///|
fn qbe_bce_try_add_guard(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  arr : String,
  idx : Expr,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  if (!g.hoisted_arr_len.contains(arr) && !g.hoisted_str_len.contains(arr)) ||
    qbe_stmts_rebinds_ident(body, arr) {
    return
  }
  match idx {
    EIdent(iname, _) =>
      if iname == iv && !g.bce_safe_indices.contains(iv + ":" + arr) {
        let key = arr + ":iv:" + iv
        if !seen.contains(key) {
          seen.set(key, true)
          out.push(QbeBceGuard::{ arr: arr, kind: 0, offset: 0L, vname: "", key: key })
        }
      }
    EBinary("+", EIdent(iname, _), EInt(raw, _), _) =>
      if iname == iv {
        let c = qbe_parse_int64_lit(raw)
        if c > 0L && c <= 2147483647L {
          let key = arr + ":iv+:" + iv + ":" + c.to_string()
          if !seen.contains(key) {
            seen.set(key, true)
            out.push(QbeBceGuard::{ arr: arr, kind: 1, offset: c, vname: "", key: key })
          }
        }
      }
    EBinary("+", EInt(raw, _), EIdent(iname, _), _) =>
      if iname == iv {
        let c = qbe_parse_int64_lit(raw)
        if c > 0L && c <= 2147483647L {
          let key = arr + ":iv+:" + iv + ":" + c.to_string()
          if !seen.contains(key) {
            seen.set(key, true)
            out.push(QbeBceGuard::{ arr: arr, kind: 1, offset: c, vname: "", key: key })
          }
        }
      }
    EBinary("-", EIdent(vname, _), EIdent(iname, _), _) =>
      if iname == iv &&
        vname != iv &&
        !qbe_stmts_assigns_ident(body, vname) &&
        !qbe_stmts_rebinds_ident(body, vname) {
        match qbe_lookup_local(g, vname) {
          Some(vloc) =>
            if qbe_is_int32_ty(vloc.ty) {
              let key = arr + ":v-iv:" + vname + ":" + iv
              if !seen.contains(key) {
                seen.set(key, true)
                out.push(QbeBceGuard::{ arr: arr, kind: 2, offset: 0L, vname: vname, key: key })
              }
            }
          None => ()
        }
      }
    _ => ()
  }
}

///|
fn qbe_collect_bce_guards_expr(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  e : Expr,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, inner, out, seen)
    EBinary(_, l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, l, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, r, out, seen)
    }
    EIndex(obj, idx, _) => {
      match obj {
        EIdent(arr, _) => qbe_bce_try_add_guard(g, body, iv, arr, idx, out, seen)
        _ => qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
      }
      qbe_collect_bce_guards_expr(g, body, iv, idx, out, seen)
    }
    ECall(callee, args, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, callee, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_bce_guards_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, mname, args, _) => {
      if mname == "code_unit_at" && args.length() == 1 {
        match obj {
          EIdent(sname, _) => qbe_bce_try_add_guard(g, body, iv, sname, args[0], out, seen)
          EField(EIdent(vname, _), fname, _) =>
            qbe_bce_try_add_guard(g, body, iv, vname + "." + fname, args[0], out, seen)
          _ => qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
        }
      } else {
        qbe_collect_bce_guards_expr(g, body, iv, obj, out, seen)
      }
      let mut i = 0
      while i < args.length() {
        qbe_collect_bce_guards_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        qbe_collect_bce_guards_expr(g, body, iv, elems[i], out, seen)
        i = i + 1
      }
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        qbe_collect_bce_guards_expr(g, body, iv, fields[i].value, out, seen)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_bce_guards_stmts(g, body, iv, stmts, out, seen)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, cond, out, seen)
      qbe_collect_bce_guards_stmts(g, body, iv, then_stmts, out, seen)
      match else_opt {
        None => ()
        Some(el) => qbe_collect_bce_guards_expr(g, body, iv, el, out, seen)
      }
    }
    EIs(scrut, _, _) => qbe_collect_bce_guards_expr(g, body, iv, scrut, out, seen)
    EMatch(scrut, arms, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, scrut, out, seen)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => qbe_collect_bce_guards_expr(g, body, iv, ge, out, seen)
          None => ()
        }
        qbe_collect_bce_guards_expr(g, body, iv, arms[i].body, out, seen)
        i = i + 1
      }
    }
    EClosure(_, _, _, _) => ()
  }
}

///|
fn qbe_collect_bce_guards_stmt(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  s : Stmt,
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, init, out, seen)
    SLetTuple(_, _, init, _) =>
      qbe_collect_bce_guards_expr(g, body, iv, init, out, seen)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, lhs, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, rhs, out, seen)
    }
    SReturn(opt, _) =>
      match opt {
        None => ()
        Some(e) => qbe_collect_bce_guards_expr(g, body, iv, e, out, seen)
      }
    SDebugAssert(c, m, _) => {
      qbe_collect_bce_guards_expr(g, body, iv, c, out, seen)
      qbe_collect_bce_guards_expr(g, body, iv, m, out, seen)
    }
    SExpr(e, _) => qbe_collect_bce_guards_expr(g, body, iv, e, out, seen)
    SGuard(_, _, _) | SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SBreak(_) | SContinue(_) => ()
  }
}

///|
fn qbe_collect_bce_guards_stmts(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  stmts : Array[Stmt],
  out : Array[QbeBceGuard],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    qbe_collect_bce_guards_stmt(g, body, iv, stmts[i], out, seen)
    i = i + 1
  }
}

///|
fn qbe_expr_count_assigns_ident(e : Expr, name : String) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 0
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_count_assigns_ident(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_expr_count_assigns_ident(l, name) + qbe_expr_count_assigns_ident(r, name)
    ECall(callee, args, _) => {
      let mut n = qbe_expr_count_assigns_ident(callee, name)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_expr_count_assigns_ident(args[i], name)
        i = i + 1
      }
      n
    }
    EMethodCall(obj, _, args, _) => {
      let mut n = qbe_expr_count_assigns_ident(obj, name)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_expr_count_assigns_ident(args[i], name)
        i = i + 1
      }
      n
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) => {
      let mut n = 0
      let mut i = 0
      while i < elems.length() {
        n = n + qbe_expr_count_assigns_ident(elems[i], name)
        i = i + 1
      }
      n
    }
    EStructLit(_, _spread, fields, _) => {
      let mut n = 0
      let mut i = 0
      while i < fields.length() {
        n = n + qbe_expr_count_assigns_ident(fields[i].value, name)
        i = i + 1
      }
      n
    }
    EBlock(stmts, _) => qbe_stmts_count_assigns_ident(stmts, name)
    EIf(cond, then_stmts, else_opt, _) => {
      let mut n = qbe_expr_count_assigns_ident(cond, name) +
        qbe_stmts_count_assigns_ident(then_stmts, name)
      match else_opt {
        None => ()
        Some(el) => n = n + qbe_expr_count_assigns_ident(el, name)
      }
      n
    }
    EIs(scrut, _, _) => qbe_expr_count_assigns_ident(scrut, name)
    EMatch(scrut, arms, _) => {
      let mut n = qbe_expr_count_assigns_ident(scrut, name)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => n = n + qbe_expr_count_assigns_ident(ge, name)
          None => ()
        }
        n = n + qbe_expr_count_assigns_ident(arms[i].body, name)
        i = i + 1
      }
      n
    }
    EClosure(_, _, body, _) => qbe_stmts_count_assigns_ident(body, name)
  }
}

///|
fn qbe_stmt_count_assigns_ident(s : Stmt, name : String) -> Int {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_count_assigns_ident(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_count_assigns_ident(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      let self_hit = match lhs {
        EIdent(n, _) => if n == name { 1 } else { 0 }
        _ => 0
      }
      self_hit +
      qbe_expr_count_assigns_ident(lhs, name) +
      qbe_expr_count_assigns_ident(rhs, name)
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_count_assigns_ident(cond, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_count_assigns_ident(init_s, name) +
      qbe_expr_count_assigns_ident(cond, name) +
      qbe_stmt_count_assigns_ident(step_s, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_count_assigns_ident(start_e, name) +
      qbe_expr_count_assigns_ident(end_e, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_count_assigns_ident(iter_e, name) +
      qbe_stmts_count_assigns_ident(body, name)
    SReturn(opt, _) =>
      match opt {
        None => 0
        Some(e) => qbe_expr_count_assigns_ident(e, name)
      }
    SBreak(_) | SContinue(_) => 0
    SDebugAssert(c, m, _) =>
      qbe_expr_count_assigns_ident(c, name) +
      qbe_expr_count_assigns_ident(m, name)
    SExpr(e, _) => qbe_expr_count_assigns_ident(e, name)
  }
}

///|
fn qbe_stmts_count_assigns_ident(stmts : Array[Stmt], name : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < stmts.length() {
    n = n + qbe_stmt_count_assigns_ident(stmts[i], name)
    i = i + 1
  }
  n
}

///|
fn qbe_expr_has_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary("*", EIdent(a, _), EIdent(b, _), _) => a == name && b == name
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_sq(l, name) || qbe_expr_has_sq(r, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_has_sq(inner, name)
    EBlock(stmts, _) => {
      let mut i = 0
      while i < stmts.length() {
        if qbe_stmt_has_sq(stmts[i], name) {
          return true
        }
        i = i + 1
      }
      false
    }
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_sq(cond, name) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        if qbe_stmt_has_sq(then_stmts[i], name) {
          return true
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_sq(el, name)
      }
    }
    _ => false
  }
}

///|
fn qbe_stmt_has_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_has_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_has_sq(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_sq(lhs, name) || qbe_expr_has_sq(rhs, name)
    SExpr(e, _) => qbe_expr_has_sq(e, name)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_sq(e, name)
      }
    _ => false
  }
}

///|
fn qbe_expr_uncond_has_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary("*", EIdent(a, _), EIdent(b, _), _) => a == name && b == name
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        qbe_expr_uncond_has_sq(l, name)
      } else {
        qbe_expr_uncond_has_sq(l, name) || qbe_expr_uncond_has_sq(r, name)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_uncond_has_sq(inner, name)
    EIf(cond, _, _, _) => qbe_expr_uncond_has_sq(cond, name)
    _ => false
  }
}

///|
fn qbe_stmt_uncond_has_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_uncond_has_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_uncond_has_sq(init, name)
    SAssign(_, rhs, _) | SCompoundAssign(_, _, rhs, _) => qbe_expr_uncond_has_sq(rhs, name)
    SExpr(e, _) => qbe_expr_uncond_has_sq(e, name)
    _ => false
  }
}

///|
fn qbe_expr_has_branch_sq(e : Expr, name : String) -> Bool {
  match e {
    EBinary(op, l, r, _) =>
      if op == "&&" || op == "||" {
        qbe_expr_has_branch_sq(l, name) || qbe_expr_has_sq(r, name)
      } else {
        qbe_expr_has_branch_sq(l, name) || qbe_expr_has_branch_sq(r, name)
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) =>
      qbe_expr_has_branch_sq(inner, name)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_branch_sq(cond, name) {
        return true
      }
      let mut i = 0
      while i < then_stmts.length() {
        if qbe_stmt_has_sq(then_stmts[i], name) {
          return true
        }
        i = i + 1
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_sq(el, name)
      }
    }
    EMatch(_, arms, _) => {
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_sq(ge, name) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_sq(arms[i].body, name) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_stmt_has_branch_sq(s : Stmt, name : String) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_expr_has_branch_sq(init, name)
    SLetTuple(_, _, init, _) => qbe_expr_has_branch_sq(init, name)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_branch_sq(lhs, name) || qbe_expr_has_branch_sq(rhs, name)
    SExpr(e, _) => qbe_expr_has_branch_sq(e, name)
    _ => false
  }
}

///|
fn qbe_collect_field_access_expr(
  e : Expr,
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EField(obj, fname, _) =>
      match obj {
        EIdent(vname, _) => {
          read_vars.push(vname)
          read_fields.push(fname)
          if !seen_all.contains(vname) {
            seen_all.set(vname, true)
            all_vars.push(vname)
          }
          true
        }
        _ => false
      }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_collect_field_access_expr(inner, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EBinary(_, l, r, _) | EIndex(l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) =>
      qbe_collect_field_access_expr(l, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) &&
      qbe_collect_field_access_expr(r, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    ECall(callee, args, _) => {
      if !qbe_collect_field_access_expr(callee, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_collect_field_access_expr(args[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EMethodCall(obj, _, args, _) => {
      if !qbe_collect_field_access_expr(obj, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_collect_field_access_expr(args[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_collect_field_access_expr(elems[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, _spread, fields, _) => {
      let mut i = 0
      while i < fields.length() {
        if !qbe_collect_field_access_expr(fields[i].value, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) =>
      qbe_collect_field_access_stmts(stmts, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_collect_field_access_expr(cond, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) ||
        !qbe_collect_field_access_stmts(then_stmts, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      match else_opt {
        None => true
        Some(el) =>
          qbe_collect_field_access_expr(el, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
    }
    EIs(scrut, _, _) => qbe_collect_field_access_expr(scrut, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    EMatch(scrut, arms, _) => {
      if !qbe_collect_field_access_expr(scrut, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if !qbe_collect_field_access_expr(ge, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
              return false
            }
          None => ()
        }
        if !qbe_collect_field_access_expr(arms[i].body, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
          return false
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | ETry(_, _) | EInterp(_, _) => false
  }
}

///|
fn qbe_collect_field_access_stmt(
  s : Stmt,
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  match s {
    SLet(_, _, _, init, _) =>
      qbe_collect_field_access_expr(init, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SLetTuple(_, _, init, _) =>
      qbe_collect_field_access_expr(init, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SCompoundAssign(_, _, _, _) => false
    SAssign(lhs, rhs, _) => {
      let lhs_ok = match lhs {
        EField(EIdent(vname, _), fname, _) => {
          write_vars.push(vname)
          write_fields.push(fname)
          if !seen_all.contains(vname) {
            seen_all.set(vname, true)
            all_vars.push(vname)
          }
          true
        }
        EField(_, _, _) => false
        _ =>
          qbe_collect_field_access_expr(lhs, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
      lhs_ok &&
      qbe_collect_field_access_expr(rhs, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    }
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) =>
          qbe_collect_field_access_expr(e, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
      }
    SDebugAssert(c, m, _) =>
      qbe_collect_field_access_expr(c, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) &&
      qbe_collect_field_access_expr(m, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SExpr(e, _) =>
      qbe_collect_field_access_expr(e, write_vars, write_fields, read_vars, read_fields, all_vars, seen_all)
    SGuard(_, _, _) => false
    SWhile(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SBreak(_) | SContinue(_) => true
  }
}

///|
fn qbe_collect_field_access_stmts(
  stmts : Array[Stmt],
  write_vars : Array[String],
  write_fields : Array[String],
  read_vars : Array[String],
  read_fields : Array[String],
  all_vars : Array[String],
  seen_all : Map[String, Bool],
) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    if !qbe_collect_field_access_stmt(stmts[i], write_vars, write_fields, read_vars, read_fields, all_vars, seen_all) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_invalidate_len_aliases_for(g : QbeGen, arr_name : String) -> Unit {
  let mut i = 0
  while i < g.len_alias_keys.length() {
    let k = g.len_alias_keys[i]
    match g.len_aliases.get(k) {
      Some(v) =>
        if v == arr_name {
          g.len_aliases.remove(k)
        }
      None => ()
    }
    i = i + 1
  }
}

///|
///|
fn qbe_expr_is_leaf_loop_pure(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_is_leaf_loop_pure(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_is_leaf_loop_pure(l) && qbe_expr_is_leaf_loop_pure(r)
    EMethodCall(obj, mname, args, _) => {
      let ok = (mname == "code_unit_at" && args.length() == 1) ||
        (mname == "length" && args.length() == 0) ||
        (mname == "to_int" && args.length() == 0) ||
        (mname == "to_int64" && args.length() == 0) ||
        (mname == "to_double" && args.length() == 0)
      if !ok || !qbe_expr_is_leaf_loop_pure(obj) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_expr_is_leaf_loop_pure(args[i]) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_stmts_is_leaf_loop_pure(stmts)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_expr_is_leaf_loop_pure(cond) || !qbe_stmts_is_leaf_loop_pure(then_stmts) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_expr_is_leaf_loop_pure(el)
      }
    }
    _ => false
  }
}

///|
fn qbe_stmts_is_leaf_loop_pure(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) =>
        if !qbe_expr_is_leaf_loop_pure(init) {
          return false
        }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if !qbe_expr_is_leaf_loop_pure(lhs) || !qbe_expr_is_leaf_loop_pure(rhs) {
          return false
        }
      SExpr(e, _) =>
        if !qbe_expr_is_leaf_loop_pure(e) {
          return false
        }
      SBreak(_) | SContinue(_) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_expr_inline_cost_in(e : Expr, self_name : String, in_loop : Bool) -> Int {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => 1
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) => {
      let c = qbe_expr_inline_cost_in(inner, self_name, in_loop)
      if c < 0 { -1 } else { c + 1 }
    }
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      let cl = qbe_expr_inline_cost_in(l, self_name, in_loop)
      if cl < 0 {
        return -1
      }
      let cr = qbe_expr_inline_cost_in(r, self_name, in_loop)
      if cr < 0 { -1 } else { cl + cr + 1 }
    }
    ECall(callee, args, _) => {
      if in_loop {
        return -1
      }
      match callee {
        EIdent(cname, _) =>
          if cname == self_name {
            return -1
          }
        _ => ()
      }
      let mut tot = qbe_expr_inline_cost_in(callee, self_name, in_loop)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_expr_inline_cost_in(args[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EMethodCall(obj, _, args, _) => {
      let mut tot = qbe_expr_inline_cost_in(obj, self_name, in_loop)
      if tot < 0 {
        return -1
      }
      let mut i = 0
      while i < args.length() {
        let ca = qbe_expr_inline_cost_in(args[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot + 2
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      if in_loop {
        return -1
      }
      let mut tot = 2
      let mut i = 0
      while i < elems.length() {
        let ca = qbe_expr_inline_cost_in(elems[i], self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(_) => return -1
        None => ()
      }
      if in_loop {
        return -1
      }
      let mut tot = 2
      let mut i = 0
      while i < fields.length() {
        let ca = qbe_expr_inline_cost_in(fields[i].value, self_name, in_loop)
        if ca < 0 {
          return -1
        }
        tot = tot + ca
        i = i + 1
      }
      tot
    }
    EBlock(stmts, _) => qbe_stmts_inline_cost_in(stmts, self_name, in_loop, 0)
    EIf(cond, then_stmts, else_opt, _) => {
      let cc = qbe_expr_inline_cost_in(cond, self_name, in_loop)
      if cc < 0 {
        return -1
      }
      let ct = qbe_stmts_inline_cost_in(then_stmts, self_name, in_loop, 0)
      if ct < 0 {
        return -1
      }
      let ce = match else_opt {
        None => 0
        Some(el) => qbe_expr_inline_cost_in(el, self_name, in_loop)
      }
      if ce < 0 { -1 } else { cc + ct + ce + 2 }
    }
    EMatch(_, _, _) | EIs(_, _, _) | EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) | EInterp(_, _) =>
      -1
  }
}

///|
fn qbe_stmts_inline_cost_in(
  stmts : Array[Stmt],
  self_name : String,
  in_loop : Bool,
  allow_loops : Int,
) -> Int {
  let mut tot = 0
  let mut loops_left = allow_loops
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => {
        let c = qbe_expr_inline_cost_in(init, self_name, in_loop)
        if c < 0 {
          return -1
        }
        tot = tot + c + 1
      }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        let cl = qbe_expr_inline_cost_in(lhs, self_name, in_loop)
        if cl < 0 {
          return -1
        }
        let cr = qbe_expr_inline_cost_in(rhs, self_name, in_loop)
        if cr < 0 {
          return -1
        }
        tot = tot + cl + cr + 1
      }
      SExpr(e, _) => {
        let c = qbe_expr_inline_cost_in(e, self_name, in_loop)
        if c < 0 {
          return -1
        }
        tot = tot + c
      }
      SWhile(wcond, wbody, _) =>
        if !in_loop &&
          loops_left > 0 &&
          !qbe_stmts_has_nested_loop(wbody) &&
          !qbe_stmts_has_cf(wbody, false, false, true) &&
          qbe_expr_is_leaf_loop_pure(wcond) &&
          qbe_stmts_is_leaf_loop_pure(wbody) {
          loops_left = loops_left - 1
          let cc = qbe_expr_inline_cost_in(wcond, self_name, true)
          if cc < 0 {
            return -1
          }
          let cb = qbe_stmts_inline_cost_in(wbody, self_name, true, 0)
          if cb < 0 {
            return -1
          }
          tot = tot + cc + cb + 2
        } else {
          return -1
        }
      SBreak(_) | SContinue(_) =>
        if in_loop {
          tot = tot + 1
        } else {
          return -1
        }
      SLetTuple(_, _, _, _) | SGuard(_, _, _) | SFor(_, _, _, _, _) | SForRange(_, _, _, _, _, _) | SForIn(_, _, _, _, _) | SReturn(_, _) | SDebugAssert(_, _, _) =>
        return -1
    }
    if tot > 42 {
      return -1
    }
    i = i + 1
  }
  tot
}

///|
fn qbe_stmts_inline_cost(stmts : Array[Stmt], self_name : String) -> Int {
  qbe_stmts_inline_cost_in(stmts, self_name, false, 1)
}

///|
fn qbe_collect_file_inline_fns(f : SourceFile) -> Map[String, FnDecl] {
  let m : Map[String, FnDecl] = Map([])
  let mut di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DFn(fd) =>
        if fd.receiver_type == "" &&
          fd.type_params.length() == 0 &&
          fd.name != "main" &&
          fd.body.length() >= 1 &&
          fd.body.length() <= 8 {
          let cost = qbe_stmts_inline_cost(fd.body, fd.name)
          if cost >= 0 && cost <= 42 {
            m.set(fd.name, fd)
          }
        }
      _ => ()
    }
    di = di + 1
  }
  m
}

///|
fn qbe_new(tc : TypeChecker, release : Bool, unit_mode : Bool) -> QbeGen {
  QbeGen::{
    tc: tc,
    release: release,
    unit_mode: unit_mode,
    export_internals: false,
    pkg_prefix: qbe_pkg_prefix_for(tc.pkg_name, tc.multi_pkg),
    struct_order: [],
    enum_order: [],
    const_order: [],
    const_int_vals: Map([]),
    const_i64_vals: Map([]),
    const_bool_vals: Map([]),
    freeze_fn_seen: Map([]),
    eq_fn_seen: Map([]),
    strings: [],
    string_ids: Map([]),
    cstrings: [],
    cstring_ids: Map([]),
    enum_consts: [],
    enum_const_seen: Map([]),
    slot_drop_keys: [],
    slot_drop_specs: [],
    slot_drop_seen: Map([]),
    fn_wrappers: [],
    fn_wrapper_seen: Map([]),
    dyn_vtable_seen: Map([]),
    dyn_vtables: [],
    extra_fns: [],
    mono_seen: Map([]),
    mono_queue: [],
    mono_emitted: 0,
    mono_pkg: "",
    inline_fns: Map([]),
    inline_depth: 0,
    inline_stack: [],
    hoisted_arr_len: Map([]),
    hoisted_arr_dp: Map([]),
    hoisted_str_len: Map([]),
    hoisted_str_dp: Map([]),
    hoisted_fields: Map([]),
    block_immut_fields: Map([]),
    len_aliases: Map([]),
    len_alias_keys: [],
    nonneg_vars: Map([]),
    bce_safe_indices: Map([]),
    bce_safe_exprs: Map([]),
    movable_locals: Map([]),
    moved_slots: Map([]),
    zeroed_slots: Map([]),
    sq_reuse_slot: Map([]),
    sq_reuse_state: Map([]),
    promoted_fields: Map([]),
    promoted_field_tys: Map([]),
    w_to_l_ext: Map([]),
    local_w_to_l_ext: Map([]),
    unfrozen_local_arrs: Map([]),
    assign_idx_arr: "",
    assign_idx_key: "",
    assign_idx_ep: "",
    next_tmp: 0,
    next_lbl: 0,
    next_clo: 0,
    fn_allocs: StringBuilder(),
    fn_body: StringBuilder(),
    scopes: [],
    loop_breaks: [],
    loop_conts: [],
    loop_depths: [],
    cur_tparams: [],
    cur_type_subst: Map([]),
    cur_ret_ty: TUnit,
    cur_ret_abi_ty: TUnit,
    cur_fn_void: false,
    block_term: false,
    need_none_const: false,
    need_drop_opt_obj: false,
    need_drop_res_ok: false,
    need_drop_res_err: false,
    need_drop_dyn: false,
  }
}

///|
fn qbe_tmp(g : QbeGen) -> String {
  let id = g.next_tmp
  g.next_tmp = id + 1
  "%t" + id.to_string()
}

///|
fn qbe_lbl(g : QbeGen, prefix : String) -> String {
  let id = g.next_lbl
  g.next_lbl = id + 1
  "@" + prefix + "_" + id.to_string()
}

///|
fn qbe_emit(g : QbeGen, line : String) -> Unit {
  if !g.block_term {
    g.fn_body.write_string("    ")
    g.fn_body.write_string(line)
    g.fn_body.write_string("\n")
  }
}

///|
fn qbe_emit_term(g : QbeGen, line : String) -> Unit {
  if !g.block_term {
    g.fn_body.write_string("    ")
    g.fn_body.write_string(line)
    g.fn_body.write_string("\n")
    g.block_term = true
  }
}

///|
fn qbe_emit_lbl(g : QbeGen, lbl : String) -> Unit {
  g.fn_body.write_string(lbl)
  g.fn_body.write_string("\n")
  g.block_term = false
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_alloc_slot(g : QbeGen) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string("    ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string(" =l alloc8 8\n")
  g.fn_allocs.write_string("    storel 0, ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_alloc_slot_for(g : QbeGen, ty : Ty) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string("    ")
  g.fn_allocs.write_string(s)
  if qbe_is_double_ty(ty) {
    g.fn_allocs.write_string(" =l alloc8 8\n")
    g.fn_allocs.write_string("    stored d_0.0, ")
  } else if qbe_is_int32_ty(ty) {
    g.fn_allocs.write_string(" =l alloc4 4\n")
    g.fn_allocs.write_string("    storew 0, ")
  } else {
    g.fn_allocs.write_string(" =l alloc8 8\n")
    g.fn_allocs.write_string("    storel 0, ")
  }
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_alloc_slot4(g : QbeGen) -> String {
  let s = qbe_tmp(g)
  g.fn_allocs.write_string("    ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string(" =l alloc4 4\n")
  g.fn_allocs.write_string("    storew 0, ")
  g.fn_allocs.write_string(s)
  g.fn_allocs.write_string("\n")
  s
}

///|
fn qbe_intern_string(g : QbeGen, s : String) -> Int {
  match g.string_ids.get(s) {
    Some(id) => id
    None => {
      let id = g.strings.length()
      g.strings.push(s)
      g.string_ids.set(s, id)
      id
    }
  }
}

///|
fn qbe_intern_cstring(g : QbeGen, s : String) -> Int {
  match g.cstring_ids.get(s) {
    Some(id) => id
    None => {
      let id = g.cstrings.length()
      g.cstrings.push(s)
      g.cstring_ids.set(s, id)
      id
    }
  }
}

///|
fn qbe_hex_digit_char(n : Int) -> Char {
  let d = n & 15
  if d < 10 {
    (48 + d).unsafe_to_char()
  } else {
    (97 + d - 10).unsafe_to_char()
  }
}

///|
fn qbe_sort_unique_slots(slots : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < slots.length() {
    let v = slots[i]
    if v >= 0 {
      let mut dup = false
      let mut j = 0
      while j < out.length() {
        if out[j] == v {
          dup = true
          break
        }
        j = j + 1
      }
      if !dup {
        out.push(v)
        let mut k = out.length() - 1
        while k > 0 && out[k - 1] > out[k] {
          let tmp = out[k - 1]
          out[k - 1] = out[k]
          out[k] = tmp
          k = k - 1
        }
      }
    }
    i = i + 1
  }
  out
}

///|
fn qbe_slots_canonical_key(sorted : Array[Int]) -> String {
  if sorted.length() == 0 {
    return ""
  }
  let max_slot = sorted[sorted.length() - 1]
  if max_slot < 31 {
    let mut mask = 0
    let mut i = 0
    while i < sorted.length() {
      mask = mask | (1 << sorted[i])
      i = i + 1
    }
    return mask.to_string()
  }
  let n_chunks = max_slot / 16 + 1
  let chunks : Array[Int] = []
  let mut ci = 0
  while ci < n_chunks {
    chunks.push(0)
    ci = ci + 1
  }
  let mut i = 0
  while i < sorted.length() {
    let s = sorted[i]
    let idx = s / 16
    let bit = s % 16
    chunks[idx] = chunks[idx] | (1 << bit)
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("x_")
  ci = n_chunks - 1
  while ci >= 0 {
    let v = chunks[ci]
    sb.write_char(qbe_hex_digit_char((v >> 12) & 15))
    sb.write_char(qbe_hex_digit_char((v >> 8) & 15))
    sb.write_char(qbe_hex_digit_char((v >> 4) & 15))
    sb.write_char(qbe_hex_digit_char(v & 15))
    ci = ci - 1
  }
  sb.to_string()
}

///|
fn qbe_merge_slot_lists(a : Array[Int], b : Array[Int]) -> Array[Int] {
  let out : Array[Int] = []
  let mut i = 0
  while i < a.length() {
    out.push(a[i])
    i = i + 1
  }
  i = 0
  while i < b.length() {
    out.push(b[i])
    i = i + 1
  }
  out
}

///|
fn qbe_register_slot_drop(g : QbeGen, slots : Array[Int]) -> String {
  let sorted = qbe_sort_unique_slots(slots)
  if sorted.length() == 0 {
    return "0"
  }
  let key = qbe_slots_canonical_key(sorted)
  if !g.slot_drop_seen.contains(key) {
    g.slot_drop_seen.set(key, true)
    g.slot_drop_keys.push(key)
    g.slot_drop_specs.push(sorted)
  }
  "$pion_drop_slots_" + key
}

///|
fn qbe_register_fn_wrapper(
  g : QbeGen,
  wrap_sym : String,
  target_sym : String,
  param_tys : Array[Ty],
  ret_ty : Ty,
) -> String {
  if !g.fn_wrapper_seen.contains(wrap_sym) {
    g.fn_wrapper_seen.set(wrap_sym, true)
    g.fn_wrappers.push(QbeFnWrapper::{
      wrap_sym: wrap_sym,
      target_sym: target_sym,
      param_tys: param_tys,
      ret_ty: ret_ty,
    })
  }
  wrap_sym
}

///|
fn qbe_scope_push(g : QbeGen) -> Unit {
  g.scopes.push(QbeScope::{ locals: [] })
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_release_scope_locals(g : QbeGen, sc : QbeScope) -> Unit {
  let mut i = sc.locals.length() - 1
  while i >= 0 {
    let loc = sc.locals[i]
    if loc.owned && !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
      match loc.ty {
        TParam(_) => {
          let v = qbe_tmp(g)
          qbe_emit(g, v + " =l loadl " + loc.slot)
          qbe_rc_dec(g, v, loc.ty)
        }
        _ =>
          if qbe_is_obj_ty(loc.ty) {
            let v = qbe_tmp(g)
            qbe_emit(g, v + " =l loadl " + loc.slot)
            qbe_emit(g, "call $pion_rc_dec(l " + v + ")")
          }
      }
    }
    i = i - 1
  }
}

///|
fn qbe_scope_pop(g : QbeGen) -> Unit {
  if g.scopes.length() > 0 {
    let sc = g.scopes[g.scopes.length() - 1]
    if !g.block_term {
      qbe_release_scope_locals(g, sc)
    }
    let mut zi = 0
    while zi < sc.locals.length() {
      g.zeroed_slots.remove(sc.locals[zi].slot)
      g.unfrozen_local_arrs.remove(sc.locals[zi].name)
      zi = zi + 1
    }
    let _ = g.scopes.pop()
  }
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
}

///|
fn qbe_release_scopes_down_to(g : QbeGen, target_depth : Int) -> Unit {
  let mut i = g.scopes.length() - 1
  while i >= target_depth {
    qbe_release_scope_locals(g, g.scopes[i])
    i = i - 1
  }
}

///|
fn qbe_define_local(
  g : QbeGen,
  name : String,
  ty : Ty,
  owned : Bool,
) -> QbeLocal {
  let slot = qbe_alloc_slot_for(g, ty)
  let loc = QbeLocal::{ name: name, slot: slot, ty: ty, owned: owned }
  let top = g.scopes[g.scopes.length() - 1]
  top.locals.push(loc)
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext.remove(name)
  loc
}

///|
fn qbe_lookup_local(g : QbeGen, name : String) -> Option[QbeLocal] {
  let mut si = g.scopes.length() - 1
  while si >= 0 {
    let sc = g.scopes[si]
    let mut li = sc.locals.length() - 1
    while li >= 0 {
      if sc.locals[li].name == name {
        return Some(sc.locals[li])
      }
      li = li - 1
    }
    si = si - 1
  }
  None
}

///|
fn qbe_find_world_slot(g : QbeGen) -> Option[String] {
  let mut si = g.scopes.length() - 1
  while si >= 0 {
    let sc = g.scopes[si]
    let mut li = sc.locals.length() - 1
    while li >= 0 {
      match sc.locals[li].ty {
        TWorld => return Some(sc.locals[li].slot)
        _ => ()
      }
      li = li - 1
    }
    si = si - 1
  }
  None
}

///|
/// A type parameter whose runtime `%tp_<tn>` flag is in scope: declared on the
/// current function and not resolved by monomorphization.
fn qbe_tp_live(g : QbeGen, tn : String) -> Bool {
  str_arr_contains(g.cur_tparams, tn) && !g.cur_type_subst.contains(tn)
}

///|
fn qbe_is_obj_flag(g : QbeGen, raw_t : Ty) -> String {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        "%tp_" + tn
      } else {
        "0"
      }
    _ => if qbe_is_obj_ty(t) { "1" } else { "0" }
  }
}

///|
fn qbe_is_obj_flag_w(g : QbeGen, raw_t : Ty) -> String {
  let t = subst_ty(raw_t, g.cur_type_subst)
  match t {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy %tp_" + tn)
        w
      } else {
        "0"
      }
    _ => if qbe_is_obj_ty(t) { "1" } else { "0" }
  }
}

///|
fn qbe_rc_inc(g : QbeGen, vreg : String, raw_ty : Ty) -> Unit {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "rci_do")
        let l_sk = qbe_lbl(g, "rci_sk")
        qbe_emit_term(g, "jnz %tp_" + tn + ", " + l_do + ", " + l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_inc(l " + vreg + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
      }
    _ =>
      if qbe_is_obj_ty(ty) {
        qbe_emit(g, "call $pion_rc_inc(l " + vreg + ")")
      }
  }
}

///|
fn qbe_rc_dec(g : QbeGen, vreg : String, raw_ty : Ty) -> Unit {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "rcd_do")
        let l_sk = qbe_lbl(g, "rcd_sk")
        qbe_emit_term(g, "jnz %tp_" + tn + ", " + l_do + ", " + l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_dec(l " + vreg + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
      }
    _ =>
      if qbe_is_obj_ty(ty) {
        qbe_emit(g, "call $pion_rc_dec(l " + vreg + ")")
      }
  }
}

///|
fn qbe_record_scalar_const(g : QbeGen, cd : ConstDecl, cty : Ty) -> Unit {
  match cty {
    TInt =>
      match cd.value {
        EInt(raw, _) =>
          g.const_int_vals.set(cd.name, qbe_parse_int64_lit(raw).to_int())
        EUnary("-", EInt(raw, _), _) =>
          g.const_int_vals.set(cd.name, 0 - qbe_parse_int64_lit(raw).to_int())
        _ => ()
      }
    TInt64 =>
      match cd.value {
        EInt64(raw, _) | EInt(raw, _) =>
          g.const_i64_vals.set(cd.name, qbe_parse_int64_lit(raw))
        EUnary("-", EInt64(raw, _), _) | EUnary("-", EInt(raw, _), _) =>
          g.const_i64_vals.set(cd.name, 0L - qbe_parse_int64_lit(raw))
        _ => ()
      }
    TBool =>
      match cd.value {
        EBool(b, _) => g.const_bool_vals.set(cd.name, b)
        _ => ()
      }
    _ => ()
  }
}

///|
fn qbe_try_const_int(g : QbeGen, e : Expr) -> Option[Int] {
  match e {
    EInt(raw, _) => Some(qbe_parse_int64_lit(raw).to_int())
    EUnary("-", EInt(raw, _), _) => Some(0 - qbe_parse_int64_lit(raw).to_int())
    EIdent(name, _) =>
      match qbe_lookup_local(g, name) {
        Some(_) => None
        None => g.const_int_vals.get(name)
      }
    _ => None
  }
}

///|
fn qbe_emit_str_code_unit_at(
  g : QbeGen,
  str_reg : String,
  idx_expr : Expr,
  str_local_name : String,
) -> String {
  let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
  let il = qbe_as_l(g, iv)
  let bce_safe = if str_local_name != "" {
    qbe_bce_expr_is_safe(g, str_local_name, idx_expr)
  } else {
    false
  }
  if !bce_safe {
    let slen = match g.hoisted_str_len.get(str_local_name) {
      Some(hl) => hl
      None => {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l loadl " + str_reg)
        t
      }
    }
    let oob = qbe_tmp(g)
    let l_oob = qbe_lbl(g, "str_oob")
    let l_ok = qbe_lbl(g, "str_ok")
    qbe_emit(g, oob + " =w cugel " + il + ", " + slen)
    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
    qbe_emit_lbl(g, l_oob)
    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + slen + ")")
    qbe_emit_term(g, "hlt")
    qbe_emit_lbl(g, l_ok)
  }
  let base = match g.hoisted_str_dp.get(str_local_name) {
    Some(hdp) => hdp
    None => {
      let b = qbe_tmp(g)
      qbe_emit(g, b + " =l add " + str_reg + ", 8")
      b
    }
  }
  let ep = qbe_tmp(g)
  let bw = qbe_tmp(g)
  qbe_emit(g, ep + " =l add " + base + ", " + il)
  qbe_emit(g, bw + " =w loadub " + ep)
  bw
}

///|
fn qbe_freeze_ty_key(ty : Ty) -> String {
  match ty {
    TInt => "i"
    TInt64 => "i64"
    TUInt => "u32"
    TUInt64 => "u64"
    TDouble => "d"
    TFloat => "f32"
    TBool => "b"
    TByte => "u8"
    TChar => "ch"
    TString => "str"
    TBytes => "bytes"
    TStringBuilder => "sb"
    TUnit => "u"
    TStruct(sname, sargs) => {
      let sb = StringBuilder()
      sb.write_string("st_")
      sb.write_string(qbe_sanitize_sym(sname))
      let mut i = 0
      while i < sargs.length() {
        sb.write_string("_")
        sb.write_string(qbe_freeze_ty_key(sargs[i]))
        i = i + 1
      }
      sb.to_string()
    }
    TEnum(ename, eargs) => {
      let sb = StringBuilder()
      sb.write_string("en_")
      sb.write_string(qbe_sanitize_sym(ename))
      let mut i = 0
      while i < eargs.length() {
        sb.write_string("_")
        sb.write_string(qbe_freeze_ty_key(eargs[i]))
        i = i + 1
      }
      sb.to_string()
    }
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("tup")
      let mut i = 0
      while i < elems.length() {
        sb.write_string("_")
        sb.write_string(qbe_freeze_ty_key(elems[i]))
        i = i + 1
      }
      sb.to_string()
    }
    TOption(inner) => "opt_" + qbe_freeze_ty_key(inner)
    TResult(ok_ty, err_ty) =>
      "res_" + qbe_freeze_ty_key(ok_ty) + "_" + qbe_freeze_ty_key(err_ty)
    TArray(elem) => "arr_" + qbe_freeze_ty_key(elem)
    TFixedArray(elem) => "farr_" + qbe_freeze_ty_key(elem)
    TMap(kty, vty) =>
      "map_" + qbe_freeze_ty_key(kty) + "_" + qbe_freeze_ty_key(vty)
    _ => "obj"
  }
}

///|
fn qbe_ensure_freeze_fn(g : QbeGen, ty : Ty) -> String {
  if !qbe_is_obj_ty(ty) {
    return ""
  }
  match ty {
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let obj_slots : Array[Int] = []
          let obj_tys : Array[Ty] = []
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            let fty = subst_ty(sinfo.field_tys[fi], subst)
            if qbe_is_obj_ty(fty) {
              obj_slots.push(fi)
              obj_tys.push(fty)
            }
            fi = fi + 1
          }
          if obj_slots.length() == 0 {
            return "$pion_rc_freeze"
          }
          let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
          if g.freeze_fn_seen.contains(fn_sym) {
            return fn_sym
          }
          g.freeze_fn_seen.set(fn_sym, true)
          let child_syms : Array[String] = []
          let mut ci = 0
          while ci < obj_tys.length() {
            child_syms.push(qbe_ensure_freeze_fn(g, obj_tys[ci]))
            ci = ci + 1
          }
          let sb = StringBuilder()
          sb.write_string("function ")
          sb.write_string(fn_sym)
          sb.write_string("(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n")
          let mut j = 0
          while j < obj_slots.length() {
            let off = obj_slots[j] * 8
            sb.write_string("    %a")
            sb.write_string(j.to_string())
            sb.write_string(" =l add %obj, ")
            sb.write_string(off.to_string())
            sb.write_string("\n    %v")
            sb.write_string(j.to_string())
            sb.write_string(" =l loadl %a")
            sb.write_string(j.to_string())
            sb.write_string("\n    call ")
            sb.write_string(child_syms[j])
            sb.write_string("(l %v")
            sb.write_string(j.to_string())
            sb.write_string(")\n")
            j = j + 1
          }
          sb.write_string("@done\n    ret\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => "$pion_rc_freeze"
      }
    TTuple(elems) => {
      let obj_slots : Array[Int] = []
      let obj_tys : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        if qbe_is_obj_ty(elems[i]) {
          obj_slots.push(i)
          obj_tys.push(elems[i])
        }
        i = i + 1
      }
      if obj_slots.length() == 0 {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_syms : Array[String] = []
      let mut ci = 0
      while ci < obj_tys.length() {
        child_syms.push(qbe_ensure_freeze_fn(g, obj_tys[ci]))
        ci = ci + 1
      }
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n")
      let mut j = 0
      while j < obj_slots.length() {
        let off = obj_slots[j] * 8
        sb.write_string("    %a")
        sb.write_string(j.to_string())
        sb.write_string(" =l add %obj, ")
        sb.write_string(off.to_string())
        sb.write_string("\n    %v")
        sb.write_string(j.to_string())
        sb.write_string(" =l loadl %a")
        sb.write_string(j.to_string())
        sb.write_string("\n    call ")
        sb.write_string(child_syms[j])
        sb.write_string("(l %v")
        sb.write_string(j.to_string())
        sb.write_string(")\n")
        j = j + 1
      }
      sb.write_string("@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TOption(inner) => {
      if qbe_is_niche_opt_inner(inner) {
        return qbe_ensure_freeze_fn(g, inner)
      }
      if !qbe_is_obj_ty(inner) {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, inner)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n    %is1 =w ceql %tag, 1\n    jnz %is1, @some, @done\n@some\n    %a =l add %obj, 8\n    %v =l loadl %a\n    call ")
      sb.write_string(child_sym)
      sb.write_string("(l %v)\n@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TResult(ok_ty, err_ty) => {
      let ok_obj = qbe_is_obj_ty(ok_ty)
      let err_obj = qbe_is_obj_ty(err_ty)
      if !ok_obj && !err_obj {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let ok_sym = if ok_obj { qbe_ensure_freeze_fn(g, ok_ty) } else { "" }
      let err_sym = if err_obj { qbe_ensure_freeze_fn(g, err_ty) } else { "" }
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n    %is0 =w ceql %tag, 0\n    jnz %is0, @ok_b, @err_b\n@ok_b\n")
      if ok_obj {
        sb.write_string("    %ao =l add %obj, 8\n    %vo =l loadl %ao\n    call ")
        sb.write_string(ok_sym)
        sb.write_string("(l %vo)\n")
      }
      sb.write_string("    jmp @done\n@err_b\n")
      if err_obj {
        sb.write_string("    %ae =l add %obj, 8\n    %ve =l loadl %ae\n    call ")
        sb.write_string(err_sym)
        sb.write_string("(l %ve)\n")
      }
      sb.write_string("@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TEnum(ename, eargs) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut any_obj = false
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if qbe_is_obj_ty(subst_ty(v.field_tys[fi], subst)) {
                any_obj = true
                break
              }
              fi = fi + 1
            }
            if any_obj {
              break
            }
            vi = vi + 1
          }
          if !any_obj {
            return "$pion_rc_freeze"
          }
          let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
          if g.freeze_fn_seen.contains(fn_sym) {
            return fn_sym
          }
          g.freeze_fn_seen.set(fn_sym, true)
          let sb = StringBuilder()
          sb.write_string("function ")
          sb.write_string(fn_sym)
          sb.write_string("(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %tag =l loadl %obj\n")
          vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let obj_slots : Array[Int] = []
            let child_syms : Array[String] = []
            let mut fi = 0
            while fi < v.field_tys.length() {
              let fty = subst_ty(v.field_tys[fi], subst)
              if qbe_is_obj_ty(fty) {
                obj_slots.push(fi)
                child_syms.push(qbe_ensure_freeze_fn(g, fty))
              }
              fi = fi + 1
            }
            if obj_slots.length() > 0 {
              sb.write_string("    %c")
              sb.write_string(vi.to_string())
              sb.write_string(" =w ceql %tag, ")
              sb.write_string(vi.to_string())
              sb.write_string("\n    jnz %c")
              sb.write_string(vi.to_string())
              sb.write_string(", @v")
              sb.write_string(vi.to_string())
              sb.write_string(", @n")
              sb.write_string(vi.to_string())
              sb.write_string("\n@v")
              sb.write_string(vi.to_string())
              sb.write_string("\n")
              let mut j = 0
              while j < obj_slots.length() {
                let off = (obj_slots[j] + 1) * 8
                sb.write_string("    %a")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(" =l add %obj, ")
                sb.write_string(off.to_string())
                sb.write_string("\n    %v")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(" =l loadl %a")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string("\n    call ")
                sb.write_string(child_syms[j])
                sb.write_string("(l %v")
                sb.write_string(vi.to_string())
                sb.write_string("_")
                sb.write_string(j.to_string())
                sb.write_string(")\n")
                j = j + 1
              }
              sb.write_string("    ret\n@n")
              sb.write_string(vi.to_string())
              sb.write_string("\n")
            }
            vi = vi + 1
          }
          sb.write_string("@done\n    ret\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => "$pion_rc_freeze"
      }
    TArray(elem) | TFixedArray(elem) => {
      if !qbe_is_obj_ty(elem) {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, elem)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %len =l loadl %obj\n    %dp_p =l add %obj, 24\n    %dp =l loadl %dp_p\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %len\n    jnz %c, @step, @done\n@step\n    %off =l shl %i, 3\n    %ep =l add %dp, %off\n    %ev =l loadl %ep\n    call ")
      sb.write_string(child_sym)
      sb.write_string("(l %ev)\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TMap(_, vty) => {
      if !qbe_is_obj_ty(vty) {
        return "$pion_rc_freeze"
      }
      let fn_sym = "$pion_freeze_" + qbe_freeze_ty_key(ty)
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      let child_sym = qbe_ensure_freeze_fn(g, vty)
      let sb = StringBuilder()
      sb.write_string("function ")
      sb.write_string(fn_sym)
      sb.write_string("(l %obj) {\n@start\n    %i_slot =l alloc8 8\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %cap_p =l add %obj, 8\n    %cap =l loadl %cap_p\n    %ep_p =l add %obj, 24\n    %ep =l loadl %ep_p\n    storel 0, %i_slot\n    jmp @loop\n@loop\n    %i =l loadl %i_slot\n    %c =w csltl %i, %cap\n    jnz %c, @step, @done\n@step\n    %off =l shl %i, 5\n    %ent =l add %ep, %off\n    %st_p =l add %ent, 24\n    %st =w loadub %st_p\n    %occ =w ceqw %st, 1\n    jnz %occ, @fval, @next\n@fval\n    %vp =l add %ent, 16\n    %ev =l loadl %vp\n    call ")
      sb.write_string(child_sym)
      sb.write_string("(l %ev)\n@next\n    %ni =l add %i, 1\n    storel %ni, %i_slot\n    jmp @loop\n@done\n    ret\n}\n\n")
      g.extra_fns.push(sb.to_string())
      fn_sym
    }
    TDynTrait(_) => {
      let fn_sym = "$pion_freeze_dyn"
      if g.freeze_fn_seen.contains(fn_sym) {
        return fn_sym
      }
      g.freeze_fn_seen.set(fn_sym, true)
      g.extra_fns.push(
        "function $pion_freeze_dyn(l %obj) {\n@start\n    jnz %obj, @body, @done\n@body\n    %fp =l sub %obj, 10\n    %fl =w loaduh %fp\n    %df =w and %fl, 10\n    jnz %df, @done, @do_freeze\n@do_freeze\n    %nfl =w or %fl, 8\n    storeh %nfl, %fp\n    call $pion_rc_freeze(l %obj)\n    %vp =l add %obj, 8\n    %vt =l loadl %vp\n    %fa =l add %vt, 8\n    %fz =l loadl %fa\n    jnz %fz, @call_fz, @done\n@call_fz\n    %data =l loadl %obj\n    call %fz(l %data)\n@done\n    ret\n}\n\n",
      )
      fn_sym
    }
    _ => "$pion_rc_freeze"
  }
}

///|
fn qbe_type_needs_eq_fn(g : QbeGen, ty : Ty) -> Bool {
  match ty {
    TStruct(sname, _) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(si) => si.decl.derive_eq
        None => false
      }
    TEnum(ename, _) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(ei) => {
          if !ei.decl.derive_eq {
            return false
          }
          let mut vi = 0
          while vi < ei.variants.length() {
            if ei.variants[vi].field_tys.length() > 0 {
              return true
            }
            vi = vi + 1
          }
          false
        }
        None => false
      }
    _ => false
  }
}

///|
fn qbe_emit_eq_field_cmp(
  g : QbeGen,
  sb : StringBuilder,
  fty : Ty,
  off : Int,
  pfx : String,
  next_lbl : String,
) -> Unit {
  sb.write_string("    %ap_" + pfx + " =l add %a, " + off.to_string() + "\n")
  sb.write_string("    %bp_" + pfx + " =l add %b, " + off.to_string() + "\n")
  match fty {
    TInt | TUInt => {
      sb.write_string("    %al_" + pfx + " =l loadl %ap_" + pfx + "\n")
      sb.write_string("    %bl_" + pfx + " =l loadl %bp_" + pfx + "\n")
      sb.write_string("    %aw_" + pfx + " =w copy %al_" + pfx + "\n")
      sb.write_string("    %bw_" + pfx + " =w copy %bl_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqw %aw_" + pfx + ", %bw_" + pfx + "\n")
    }
    TDouble => {
      sb.write_string("    %ad_" + pfx + " =d loadd %ap_" + pfx + "\n")
      sb.write_string("    %bd_" + pfx + " =d loadd %bp_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqd %ad_" + pfx + ", %bd_" + pfx + "\n")
    }
    TFloat => {
      sb.write_string("    %af_" + pfx + " =s loads %ap_" + pfx + "\n")
      sb.write_string("    %bf_" + pfx + " =s loads %bp_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w ceqs %af_" + pfx + ", %bf_" + pfx + "\n")
    }
    TString => {
      sb.write_string("    %av_" + pfx + " =l loadl %ap_" + pfx + "\n")
      sb.write_string("    %bv_" + pfx + " =l loadl %bp_" + pfx + "\n")
      sb.write_string("    %ok_" + pfx + " =w call $pion_str_eq(l %av_" + pfx + ", l %bv_" + pfx + ")\n")
    }
    _ => {
      sb.write_string("    %av_" + pfx + " =l loadl %ap_" + pfx + "\n")
      sb.write_string("    %bv_" + pfx + " =l loadl %bp_" + pfx + "\n")
      if qbe_type_needs_eq_fn(g, fty) {
        let child_sym = qbe_ensure_eq_fn(g, fty)
        sb.write_string("    %ok_" + pfx + " =w call " + child_sym + "(l %av_" + pfx + ", l %bv_" + pfx + ")\n")
      } else {
        match fty {
          TEnum(_, _) => {
            sb.write_string("    %at_" + pfx + " =l loadl %av_" + pfx + "\n")
            sb.write_string("    %bt_" + pfx + " =l loadl %bv_" + pfx + "\n")
            sb.write_string("    %ok_" + pfx + " =w ceql %at_" + pfx + ", %bt_" + pfx + "\n")
          }
          _ =>
            sb.write_string("    %ok_" + pfx + " =w ceql %av_" + pfx + ", %bv_" + pfx + "\n")
        }
      }
    }
  }
  sb.write_string("    jnz %ok_" + pfx + ", " + next_lbl + ", @ret_false\n")
}

///|
fn qbe_ensure_eq_fn(g : QbeGen, ty : Ty) -> String {
  let fn_sym = "$pion_eq_" + qbe_freeze_ty_key(ty)
  if g.eq_fn_seen.contains(fn_sym) {
    return fn_sym
  }
  g.eq_fn_seen.set(fn_sym, true)
  match ty {
    TStruct(sname, sargs) =>
      match qbe_lookup_struct_info(g, sname) {
        Some(sinfo) => {
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let sb = StringBuilder()
          sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
          sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @f_0\n")
          let mut fi = 0
          while fi < sinfo.field_tys.length() {
            let fty = subst_ty(sinfo.field_tys[fi], subst)
            let next_lbl = if fi + 1 < sinfo.field_tys.length() {
              "@f_" + (fi + 1).to_string()
            } else {
              "@ret_true"
            }
            sb.write_string("@f_" + fi.to_string() + "\n")
            qbe_emit_eq_field_cmp(g, sb, fty, fi * 8, "s" + fi.to_string(), next_lbl)
            fi = fi + 1
          }
          if sinfo.field_tys.length() == 0 {
            sb.write_string("@f_0\n    jmp @ret_true\n")
          }
          sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => fn_sym
      }
    TEnum(ename, eargs) =>
      match qbe_lookup_enum_info(g, ename) {
        Some(einfo) => {
          let subst = make_subst(einfo.decl.type_params, eargs)
          let sb = StringBuilder()
          sb.write_string("function w " + fn_sym + "(l %a, l %b) {\n@start\n")
          sb.write_string("    %same =w ceql %a, %b\n    jnz %same, @ret_true, @cmp_tag\n@cmp_tag\n")
          sb.write_string("    %ta =l loadl %a\n    %tb =l loadl %b\n    %teq =w ceql %ta, %tb\n    jnz %teq, @vchk_0, @ret_false\n")
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let next_v = if vi + 1 < einfo.variants.length() {
              "@vchk_" + (vi + 1).to_string()
            } else {
              "@ret_true"
            }
            sb.write_string("@vchk_" + vi.to_string() + "\n")
            if v.field_tys.length() == 0 {
              sb.write_string("    jmp " + next_v + "\n")
            } else {
              sb.write_string("    %isv_" + vi.to_string() + " =w ceql %ta, " + vi.to_string() + "\n")
              sb.write_string("    jnz %isv_" + vi.to_string() + ", @v_" + vi.to_string() + "_0, " + next_v + "\n")
              let mut fi = 0
              while fi < v.field_tys.length() {
                let fty = subst_ty(v.field_tys[fi], subst)
                let next_f = if fi + 1 < v.field_tys.length() {
                  "@v_" + vi.to_string() + "_" + (fi + 1).to_string()
                } else {
                  "@ret_true"
                }
                sb.write_string("@v_" + vi.to_string() + "_" + fi.to_string() + "\n")
                qbe_emit_eq_field_cmp(
                  g,
                  sb,
                  fty,
                  (fi + 1) * 8,
                  "v" + vi.to_string() + "_" + fi.to_string(),
                  next_f,
                )
                fi = fi + 1
              }
            }
            vi = vi + 1
          }
          if einfo.variants.length() == 0 {
            sb.write_string("@vchk_0\n    jmp @ret_true\n")
          }
          sb.write_string("@ret_true\n    ret 1\n@ret_false\n    ret 0\n}\n\n")
          g.extra_fns.push(sb.to_string())
          fn_sym
        }
        None => fn_sym
      }
    _ => fn_sym
  }
}

///|
fn qbe_ensure_dyn_vtable(
  g : QbeGen,
  trait_name : String,
  concrete_ty : Ty,
) -> String {
  let c_trait = canon_trait_name(g.tc, trait_name)
  let tname = ty_base_name(concrete_ty)
  let vt_sym = "$pion_vtable_" +
    qbe_sanitize_sym(c_trait) +
    "__" +
    qbe_sanitize_sym(tname)
  if g.dyn_vtable_seen.contains(vt_sym) {
    return vt_sym
  }
  g.dyn_vtable_seen.set(vt_sym, true)
  let is_obj_s = if qbe_is_obj_ty(concrete_ty) { "1" } else { "0" }
  let fz_sym = if qbe_is_obj_ty(concrete_ty) {
    let f = qbe_ensure_freeze_fn(g, concrete_ty)
    if f.length() > 0 { f } else { "0" }
  } else {
    "0"
  }
  let impl_key = c_trait + "::" + tname
  let vt_sb = StringBuilder()
  vt_sb.write_string("data ")
  vt_sb.write_string(vt_sym)
  vt_sb.write_string(" = align 8 { l ")
  vt_sb.write_string(is_obj_s)
  vt_sb.write_string(", l ")
  vt_sb.write_string(fz_sym)
  match lookup_trait(g.tc, c_trait) {
    Some(tinfo) =>
      match g.tc.impls.get(impl_key) {
        Some(iinfo) => {
          let mut mi = 0
          while mi < tinfo.methods.length() {
            let tm = tinfo.methods[mi]
            let wrap_sym = "$pion_dyn_wrap_" +
              qbe_sanitize_sym(c_trait) +
              "__" +
              qbe_sanitize_sym(tname) +
              "__" +
              tm.name
            vt_sb.write_string(", l ")
            vt_sb.write_string(wrap_sym)
            let impl_sym = qbe_impl_method_sym(
              g,
              iinfo.pkg_name,
              iinfo.trait_name,
              iinfo.target_type,
              tm.name,
            )
            let ret_abi = qbe_abi_ty(tm.ret_ty)
            let wsb = StringBuilder()
            wsb.write_string("function ")
            wsb.write_string(ret_abi)
            wsb.write_string(" ")
            wsb.write_string(wrap_sym)
            wsb.write_string("(l %self_raw")
            let mut pi = 1
            while pi < tm.param_tys.length() {
              wsb.write_string(", ")
              wsb.write_string(qbe_abi_ty(tm.param_tys[pi]))
              wsb.write_string(" %a")
              wsb.write_string(pi.to_string())
              pi = pi + 1
            }
            wsb.write_string(") {\n@start\n")
            let self_arg = if qbe_is_int32_ty(concrete_ty) {
              wsb.write_string("    %self =w copy %self_raw\n")
              "w %self"
            } else if qbe_is_double_ty(concrete_ty) {
              wsb.write_string("    %self =d cast %self_raw\n")
              "d %self"
            } else {
              "l %self_raw"
            }
            wsb.write_string("    %r =")
            wsb.write_string(ret_abi)
            wsb.write_string(" call ")
            wsb.write_string(impl_sym)
            wsb.write_string("(")
            wsb.write_string(self_arg)
            pi = 1
            while pi < tm.param_tys.length() {
              wsb.write_string(", ")
              wsb.write_string(qbe_abi_ty(tm.param_tys[pi]))
              wsb.write_string(" %a")
              wsb.write_string(pi.to_string())
              pi = pi + 1
            }
            wsb.write_string(")\n    ret %r\n}\n\n")
            g.extra_fns.push(wsb.to_string())
            mi = mi + 1
          }
        }
        None => ()
      }
    None => ()
  }
  vt_sb.write_string(" }\n")
  g.dyn_vtables.push(vt_sb.to_string())
  vt_sym
}

///|
fn qbe_box_dyn(g : QbeGen, v : QbeVal, trait_name : String) -> QbeVal {
  let c_trait = canon_trait_name(g.tc, trait_name)
  let vt_sym = qbe_ensure_dyn_vtable(g, c_trait, v.ty)
  g.need_drop_dyn = true
  let data_l = qbe_as_l(g, v)
  let box_r = qbe_tmp(g)
  let vp = qbe_tmp(g)
  qbe_emit(g, box_r + " =l call $pion_alloc_uninit(w 16, w 4, l $pion_drop_dyn)")
  qbe_emit(g, "storel " + data_l + ", " + box_r)
  qbe_emit(g, vp + " =l add " + box_r + ", 8")
  qbe_emit(g, "storel " + vt_sym + ", " + vp)
  qval(box_r, TDynTrait(c_trait))
}

///|
/// Storing object `val_l` into container `container` (an `Array` / `Map`
/// shared through a `Mutex` is frozen, `owner_tid == 0`): deep-freeze the
/// value first so its RC (and that of everything it owns) stays atomic on
/// whichever thread later releases it. `deep_only` skips types the runtime's
/// own adopt-on-store already freezes completely.
fn qbe_emit_adopt_if_frozen(
  g : QbeGen,
  container : String,
  val_l : String,
  elem : Ty,
  deep_only : Bool,
) -> Unit {
  if !qbe_is_obj_ty(elem) {
    return
  }
  let sym = qbe_ensure_freeze_fn(g, elem)
  if sym == "" || (deep_only && sym == "$pion_rc_freeze") {
    return
  }
  let hp = qbe_tmp(g)
  let tid = qbe_tmp(g)
  let fz = qbe_tmp(g)
  let l_fz = qbe_lbl(g, "adopt_fz")
  let l_go = qbe_lbl(g, "adopt_go")
  qbe_emit(g, hp + " =l sub " + container + ", 24")
  qbe_emit(g, tid + " =w loaduw " + hp)
  qbe_emit(g, fz + " =w ceqw " + tid + ", 0")
  qbe_emit_term(g, "jnz " + fz + ", " + l_fz + ", " + l_go)
  qbe_emit_lbl(g, l_fz)
  qbe_emit(g, "call " + sym + "(l " + val_l + ")")
  qbe_emit_term(g, "jmp " + l_go)
  qbe_emit_lbl(g, l_go)
}

///|
fn qbe_emit_deep_freeze(g : QbeGen, reg_l : String, raw_ty : Ty) -> Unit {
  let ty = subst_ty(raw_ty, g.cur_type_subst)
  match ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        let l_do = qbe_lbl(g, "frz_do")
        let l_sk = qbe_lbl(g, "frz_sk")
        qbe_emit_term(g, "jnz %tp_" + tn + ", " + l_do + ", " + l_sk)
        qbe_emit_lbl(g, l_do)
        qbe_emit(g, "call $pion_rc_freeze(l " + reg_l + ")")
        qbe_emit_term(g, "jmp " + l_sk)
        qbe_emit_lbl(g, l_sk)
        return
      }
    _ => ()
  }
  if !qbe_is_obj_ty(ty) {
    return
  }
  let sym = qbe_ensure_freeze_fn(g, ty)
  if sym != "" {
    qbe_emit(g, "call " + sym + "(l " + reg_l + ")")
  }
}

///|
fn qbe_match_eq_var_const(g : QbeGen, cond : Expr) -> Option[QbeEqVarConst] {
  match cond {
    EBinary("==", l, r, _) => {
      match l {
        EIdent(vname, _) =>
          match qbe_try_const_int(g, r) {
            Some(cv) =>
              match qbe_lookup_local(g, vname) {
                Some(loc) =>
                  match loc.ty {
                    TInt => return Some(QbeEqVarConst::{ vname: vname, cval: cv })
                    _ => ()
                  }
                None => ()
              }
            None => ()
          }
        _ => ()
      }
      match r {
        EIdent(vname, _) =>
          match qbe_try_const_int(g, l) {
            Some(cv) =>
              match qbe_lookup_local(g, vname) {
                Some(loc) =>
                  match loc.ty {
                    TInt => return Some(QbeEqVarConst::{ vname: vname, cval: cv })
                    _ => ()
                  }
                None => ()
              }
            None => ()
          }
        _ => ()
      }
      None
    }
    _ => None
  }
}

///|
fn qbe_sort_switch_arms(arms : Array[QbeSwitchArm]) -> Unit {
  let mut i = 1
  while i < arms.length() {
    let key = arms[i]
    let mut j = i - 1
    while j >= 0 && arms[j].cval > key.cval {
      arms[j + 1] = arms[j]
      j = j - 1
    }
    arms[j + 1] = key
    i = i + 1
  }
}

///|
fn qbe_try_collect_if_switch(
  g : QbeGen,
  cond : Expr,
  then_stmts : Array[Stmt],
  else_opt : Option[Expr],
) -> Option[QbeSwitchPlan] {
  let first = match qbe_match_eq_var_const(g, cond) {
    Some(f) => f
    None => return None
  }
  let vname = first.vname
  let arms : Array[QbeSwitchArm] = [
    QbeSwitchArm::{ cval: first.cval, stmts: then_stmts, expr_opt: None },
  ]
  let seen : Map[String, Bool] = Map([])
  seen.set(first.cval.to_string(), true)
  let mut cur_else = else_opt
  while true {
    match cur_else {
      Some(EIf(c2, t2, e2, _)) =>
        match qbe_match_eq_var_const(g, c2) {
          Some(pion) =>
            if pion.vname == vname && !seen.contains(pion.cval.to_string()) {
              seen.set(pion.cval.to_string(), true)
              arms.push(QbeSwitchArm::{ cval: pion.cval, stmts: t2, expr_opt: None })
              cur_else = e2
            } else {
              break
            }
          None => break
        }
      _ => break
    }
  }
  if arms.length() < 6 {
    return None
  }
  qbe_sort_switch_arms(arms)
  Some(QbeSwitchPlan::{ vname: vname, arms: arms, default_opt: cur_else })
}

///|
fn qbe_emit_dispatch_subtree(
  g : QbeGen,
  val_reg : String,
  arms : Array[QbeSwitchArm],
  arm_lbls : Array[String],
  lo : Int,
  hi : Int,
  default_lbl : String,
) -> Unit {
  if lo > hi {
    qbe_emit_term(g, "jmp " + default_lbl)
    return
  }
  if lo == hi {
    let cmp = qbe_tmp(g)
    qbe_emit(g, cmp + " =w ceqw " + val_reg + ", " + arms[lo].cval.to_string())
    qbe_emit_term(g, "jnz " + cmp + ", " + arm_lbls[lo] + ", " + default_lbl)
    return
  }
  let mid = lo + (hi - lo) / 2
  let pivot = arms[mid].cval.to_string()
  let eq_r = qbe_tmp(g)
  let l_neq = qbe_lbl(g, "sw_neq")
  qbe_emit(g, eq_r + " =w ceqw " + val_reg + ", " + pivot)
  qbe_emit_term(g, "jnz " + eq_r + ", " + arm_lbls[mid] + ", " + l_neq)
  qbe_emit_lbl(g, l_neq)
  if lo == mid {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, mid + 1, hi, default_lbl)
  } else if mid == hi {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, lo, mid - 1, default_lbl)
  } else {
    let lt_r = qbe_tmp(g)
    let l_left = qbe_lbl(g, "sw_lt")
    let l_right = qbe_lbl(g, "sw_gt")
    qbe_emit(g, lt_r + " =w csltw " + val_reg + ", " + pivot)
    qbe_emit_term(g, "jnz " + lt_r + ", " + l_left + ", " + l_right)
    qbe_emit_lbl(g, l_left)
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, lo, mid - 1, default_lbl)
    qbe_emit_lbl(g, l_right)
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, mid + 1, hi, default_lbl)
  }
}

///|
fn qbe_emit_int_dispatch(
  g : QbeGen,
  val_reg : String,
  arms : Array[QbeSwitchArm],
  default_expr_opt : Option[Expr],
  default_bind_name : String,
  is_match_no_default : Bool,
  sp : Span,
  expected : Option[Ty],
  is_void : Bool,
) -> QbeVal {
  let arm_lbls : Array[String] = []
  let mut i = 0
  while i < arms.length() {
    arm_lbls.push(qbe_lbl(g, "sw_arm"))
    i = i + 1
  }
  let l_def = qbe_lbl(g, "sw_def")
  let l_end = qbe_lbl(g, "sw_end")
  let min_v = arms[0].cval.to_int64()
  let max_v = arms[arms.length() - 1].cval.to_int64()
  let span = max_v - min_v + 1L
  if arms.length() >= 6 &&
    span >= 6L &&
    span <= 256L &&
    span <= (arms.length() * 2).to_int64() {
    let idx_w = if min_v == 0L {
      val_reg
    } else {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =w sub " + val_reg + ", " + arms[0].cval.to_string())
      t
    }
    let span_n = span.to_int()
    let tbl : Array[String] = []
    let mut k = 0
    while k < span_n {
      tbl.push(l_def)
      k = k + 1
    }
    k = 0
    while k < arms.length() {
      let slot_idx = (arms[k].cval.to_int64() - min_v).to_int()
      tbl[slot_idx] = arm_lbls[k]
      k = k + 1
    }
    let sb = StringBuilder()
    sb.write_string("jtbl ")
    sb.write_string(idx_w)
    sb.write_string(", ")
    sb.write_string(l_def)
    k = 0
    while k < span_n {
      sb.write_string(", ")
      sb.write_string(tbl[k])
      k = k + 1
    }
    qbe_emit_term(g, sb.to_string())
  } else {
    qbe_emit_dispatch_subtree(g, val_reg, arms, arm_lbls, 0, arms.length() - 1, l_def)
  }

  let mut res_slot = ""
  let mut res_ty : Option[Ty] = if is_void {
    None
  } else {
    qbe_probe_switch_arms_ty(g, arms, default_expr_opt, default_bind_name, expected)
  }
  let mut saw_untyped_none = false
  let mut all_term = true

  i = 0
  while i < arms.length() {
    qbe_emit_lbl(g, arm_lbls[i])
    qbe_scope_push(g)
    let av = match arms[i].expr_opt {
      Some(e) => qbe_emit_expr(g, e, if is_void { None } else { res_ty })
      None => qbe_emit_stmts(g, arms[i].stmts, if is_void { None } else { res_ty })
    }
    if !g.block_term {
      all_term = false
      if is_void {
        qbe_rc_dec(g, av.reg, av.ty)
      } else {
        match res_ty {
          None =>
            match av.ty {
              TNever => ()
              _ => {
                if qbe_is_untyped_option(av.ty) {
                  saw_untyped_none = true
                }
                res_ty = Some(av.ty)
              }
            }
          Some(rt) => {
            if qbe_is_untyped_option(av.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(ty_prefer_concrete(rt, av.ty))
          }
        }
        let store_ty = match res_ty {
          Some(t) => t
          None => av.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, av, store_ty), res_slot, store_ty)
      }
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "jmp " + l_end)
    i = i + 1
  }

  qbe_emit_lbl(g, l_def)
  match default_expr_opt {
    Some(de) => {
      qbe_scope_push(g)
      if default_bind_name != "" {
        let bloc = qbe_define_local(g, default_bind_name, TInt, false)
        qbe_store_local_slot(g, val_reg, bloc.slot, TInt)
      }
      let dv = qbe_emit_expr(g, de, if is_void { None } else { res_ty })
      if !g.block_term {
        all_term = false
        if is_void {
          qbe_rc_dec(g, dv.reg, dv.ty)
        } else {
          match res_ty {
            None =>
              match dv.ty {
                TNever => ()
                _ => {
                  if qbe_is_untyped_option(dv.ty) {
                    saw_untyped_none = true
                  }
                  res_ty = Some(dv.ty)
                }
              }
            Some(rt) =>
              if qbe_is_untyped_option(rt) && !qbe_is_untyped_option(dv.ty) {
                match dv.ty {
                  TNever => ()
                  _ => res_ty = Some(dv.ty)
                }
              } else if qbe_is_untyped_option(dv.ty) {
                saw_untyped_none = true
              }
          }
          let store_ty = match res_ty {
            Some(t) => t
            None => dv.ty
          }
          if res_slot == "" {
            res_slot = qbe_alloc_slot_for(g, store_ty)
          }
          qbe_store_local_slot(g, qbe_coerce_val(g, dv, store_ty), res_slot, store_ty)
        }
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
    }
    None =>
      if is_match_no_default {
        let file_id = qbe_intern_cstring(g, sp.file)
        let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
        qbe_emit(
          g,
          "call $pion_panic(l $pion_cstr_" +
          msg_id.to_string() +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_emit_term(g, "jmp " + l_end)
      } else {
        all_term = false
        qbe_emit_term(g, "jmp " + l_end)
      }
  }

  qbe_emit_lbl(g, l_end)
  if is_void {
    qval("0", TUnit)
  } else if all_term {
    qval("0", TNever)
  } else {
    let final_ty = match res_ty {
      Some(t) => t
      None => TUnit
    }
    if res_slot == "" {
      qval(qbe_zero_reg(final_ty), final_ty)
    } else {
      let mut r = qbe_load_local_slot(g, res_slot, final_ty)
      if saw_untyped_none {
        match final_ty {
          TOption(oin) =>
            if qbe_is_niche_opt_inner(oin) {
              r = qbe_normalize_untyped_none(g, r)
            }
          _ => ()
        }
      }
      qval(r, final_ty)
    }
  }
}

///|
fn qbe_parse_int64_lit(raw : String) -> Int64 {
  let mut len = raw.length()
  while len > 0 &&
    (str_code_at(raw, len - 1) == 76 || str_code_at(raw, len - 1) == 85) {
    len = len - 1
  }
  if len >= 2 &&
    str_code_at(raw, 0) == 48 &&
    (str_code_at(raw, 1) == 120 || str_code_at(raw, 1) == 88) {
    let mut acc = 0L
    let mut i = 2
    while i < len {
      let c = str_code_at(raw, i)
      if c == 95 {
        i = i + 1
        continue
      }
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 65 && c <= 70 {
        c - 55
      } else if c >= 97 && c <= 102 {
        c - 87
      } else {
        0
      }
      acc = (acc << 4) | d.to_int64()
      i = i + 1
    }
    acc
  } else {
    let mut acc = 0L
    let mut i = 0
    while i < len {
      let c = str_code_at(raw, i)
      if c >= 48 && c <= 57 {
        acc = acc * 10L + (c - 48).to_int64()
      }
      i = i + 1
    }
    acc
  }
}

///|
fn qbe_hex_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    0
  }
}

///|
fn qbe_emit_arr_contains(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  raw_elem : Ty,
  arg : Expr,
  args_pure : Bool,
) -> QbeVal {
  let elem = subst_ty(raw_elem, g.cur_type_subst)
  let va = qbe_emit_arg_maybe_borrow(g, arg, Some(elem), args_pure)
  let tv = va.qv
  let target_reg = qbe_coerce_val(g, tv, elem)
  let alen = qbe_tmp(g)
  let dp_p = qbe_tmp(g)
  let dp = qbe_tmp(g)
  let idx_slot = qbe_alloc_slot(g)
  let res_slot = qbe_alloc_slot(g)
  let l_cond = qbe_lbl(g, "ac_cond")
  let l_body = qbe_lbl(g, "ac_body")
  let l_found = qbe_lbl(g, "ac_found")
  let l_next = qbe_lbl(g, "ac_next")
  let l_end = qbe_lbl(g, "ac_end")
  qbe_emit(g, alen + " =l loadl " + obj_val)
  qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
  qbe_emit(g, dp + " =l loadl " + dp_p)
  qbe_emit(g, "storel 0, " + idx_slot)
  qbe_emit(g, "storel 0, " + res_slot)
  qbe_emit_term(g, "jmp " + l_cond)
  qbe_emit_lbl(g, l_cond)
  let cur_i = qbe_tmp(g)
  let cmp_i = qbe_tmp(g)
  qbe_emit(g, cur_i + " =l loadl " + idx_slot)
  qbe_emit(g, cmp_i + " =w csltl " + cur_i + ", " + alen)
  qbe_emit_term(g, "jnz " + cmp_i + ", " + l_body + ", " + l_end)
  qbe_emit_lbl(g, l_body)
  let off = qbe_tmp(g)
  let ep = qbe_tmp(g)
  qbe_emit(g, off + " =l shl " + cur_i + ", 3")
  qbe_emit(g, ep + " =l add " + dp + ", " + off)
  let ev = qbe_load_heap_slot(g, ep, elem)
  let eq_w = qbe_tmp(g)
  match elem {
    TString =>
      qbe_emit(g, eq_w + " =w call $pion_str_eq(l " + ev + ", l " + target_reg + ")")
    TInt | TUInt =>
      qbe_emit(g, eq_w + " =w ceqw " + ev + ", " + target_reg)
    TDouble =>
      qbe_emit(g, eq_w + " =w ceqd " + ev + ", " + target_reg)
    TFloat =>
      qbe_emit(g, eq_w + " =w ceqs " + ev + ", " + target_reg)
    _ =>
      if qbe_type_needs_eq_fn(g, elem) {
        let eq_sym = qbe_ensure_eq_fn(g, elem)
        qbe_emit(g, eq_w + " =w call " + eq_sym + "(l " + ev + ", l " + target_reg + ")")
      } else {
        let lc = qbe_cmp_operand(g, ev, elem)
        let rc = qbe_cmp_operand(g, target_reg, elem)
        qbe_emit(g, eq_w + " =w ceql " + lc + ", " + rc)
      }
  }
  qbe_emit_term(g, "jnz " + eq_w + ", " + l_found + ", " + l_next)
  qbe_emit_lbl(g, l_found)
  qbe_emit(g, "storel 1, " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_next)
  let next_i = qbe_tmp(g)
  qbe_emit(g, next_i + " =l add " + cur_i + ", 1")
  qbe_emit(g, "storel " + next_i + ", " + idx_slot)
  qbe_emit_term(g, "jmp " + l_cond)
  qbe_emit_lbl(g, l_end)
  if !va.borrowed {
    qbe_rc_dec(g, tv.reg, tv.ty)
  }
  if !obj_borrowed {
    qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
  }
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + res_slot)
  qval(r, TBool)
}

///|
fn qbe_parse_char_lit(raw : String) -> Int {
  let len = raw.length()
  if len == 0 {
    return 0
  }
  let c0 = str_code_at(raw, 0)
  if c0 == 92 && len >= 2 {
    let c1 = str_code_at(raw, 1)
    if c1 == 110 {
      10
    } else if c1 == 114 {
      13
    } else if c1 == 116 {
      9
    } else if c1 == 92 {
      92
    } else if c1 == 39 {
      39
    } else if c1 == 34 {
      34
    } else if c1 == 48 {
      0
    } else if c1 == 120 && len >= 4 {
      let h1 = qbe_hex_val(str_code_at(raw, 2))
      let h2 = qbe_hex_val(str_code_at(raw, 3))
      (h1 << 4) | h2
    } else if c1 == 117 && len >= 5 && str_code_at(raw, 2) == 123 {
      let mut p = 3
      let mut cp = 0
      while p < len {
        let ch = str_code_at(raw, p)
        if ch == 125 {
          break
        }
        let hv = qbe_hex_val(ch)
        if hv >= 0 {
          cp = (cp << 4) | hv
        }
        p = p + 1
      }
      cp
    } else {
      c1
    }
  } else if c0 >= 0x80 {
    str_scalar_at(raw, 0, host_str_is_utf8())
  } else {
    c0
  }
}

///|
fn qbe_emit_none(g : QbeGen, raw_inner_ty : Ty) -> String {
  let inner_ty = subst_ty(raw_inner_ty, g.cur_type_subst)
  if qbe_is_niche_opt_inner(inner_ty) {
    return "0"
  }
  g.need_none_const = true
  let t = qbe_tmp(g)
  qbe_emit(g, t + " =l add $pion_none_hdr, 24")
  t
}

///|
fn qbe_select_drop_by_tparam(
  g : QbeGen,
  tn : String,
  sym_when_obj : String,
) -> String {
  let slot = qbe_alloc_slot(g)
  let l_obj = qbe_lbl(g, "dp_obj")
  let l_prim = qbe_lbl(g, "dp_prim")
  let l_end = qbe_lbl(g, "dp_end")
  qbe_emit_term(g, "jnz %tp_" + tn + ", " + l_obj + ", " + l_prim)
  qbe_emit_lbl(g, l_obj)
  qbe_emit(g, "storel " + sym_when_obj + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_prim)
  qbe_emit(g, "storel 0, " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_add_tp_drop_slot(
  tp_names : Array[String],
  tp_slots : Array[Array[Int]],
  tn : String,
  slot_idx : Int,
) -> Unit {
  let mut i = 0
  while i < tp_names.length() {
    if tp_names[i] == tn {
      tp_slots[i].push(slot_idx)
      return
    }
    i = i + 1
  }
  tp_names.push(tn)
  let arr : Array[Int] = []
  arr.push(slot_idx)
  tp_slots.push(arr)
}

///|
fn qbe_emit_dynamic_slot_drop(
  g : QbeGen,
  static_slots : Array[Int],
  tp_names : Array[String],
  tp_slots : Array[Array[Int]],
) -> String {
  if tp_names.length() == 0 {
    return qbe_register_slot_drop(g, static_slots)
  }
  if tp_names.length() == 1 {
    let s_obj = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, tp_slots[0]))
    let s_prim = qbe_register_slot_drop(g, static_slots)
    if s_obj == s_prim {
      return s_prim
    }
    let slot = qbe_alloc_slot(g)
    let l_obj = qbe_lbl(g, "sdp_obj")
    let l_prim = qbe_lbl(g, "sdp_prim")
    let l_end = qbe_lbl(g, "sdp_end")
    qbe_emit_term(g, "jnz %tp_" + tp_names[0] + ", " + l_obj + ", " + l_prim)
    qbe_emit_lbl(g, l_obj)
    qbe_emit(g, "storel " + s_obj + ", " + slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_prim)
    qbe_emit(g, "storel " + s_prim + ", " + slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =l loadl " + slot)
    return r
  }
  let m0 = tp_slots[0]
  let m1 = tp_slots[1]
  let s00 = qbe_register_slot_drop(g, static_slots)
  let s01 = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, m1))
  let s10 = qbe_register_slot_drop(g, qbe_merge_slot_lists(static_slots, m0))
  let s11 = qbe_register_slot_drop(
    g,
    qbe_merge_slot_lists(qbe_merge_slot_lists(static_slots, m0), m1),
  )
  let slot = qbe_alloc_slot(g)
  let l_1 = qbe_lbl(g, "sdp_1")
  let l_0 = qbe_lbl(g, "sdp_0")
  let l_11 = qbe_lbl(g, "sdp_11")
  let l_10 = qbe_lbl(g, "sdp_10")
  let l_01 = qbe_lbl(g, "sdp_01")
  let l_00 = qbe_lbl(g, "sdp_00")
  let l_end = qbe_lbl(g, "sdp_end2")
  qbe_emit_term(g, "jnz %tp_" + tp_names[0] + ", " + l_1 + ", " + l_0)
  qbe_emit_lbl(g, l_1)
  qbe_emit_term(g, "jnz %tp_" + tp_names[1] + ", " + l_11 + ", " + l_10)
  qbe_emit_lbl(g, l_11)
  qbe_emit(g, "storel " + s11 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_10)
  qbe_emit(g, "storel " + s10 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_0)
  qbe_emit_term(g, "jnz %tp_" + tp_names[1] + ", " + l_01 + ", " + l_00)
  qbe_emit_lbl(g, l_01)
  qbe_emit(g, "storel " + s01 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_00)
  qbe_emit(g, "storel " + s00 + ", " + slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + slot)
  r
}

///|
fn qbe_emit_some(g : QbeGen, vreg : String, raw_inner_ty : Ty) -> String {
  let inner_ty = subst_ty(raw_inner_ty, g.cur_type_subst)
  if qbe_is_niche_opt_inner(inner_ty) {
    return vreg
  }
  let drop_sym = match inner_ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        g.need_drop_opt_obj = true
        qbe_select_drop_by_tparam(g, tn, "$pion_drop_opt_obj")
      } else {
        "0"
      }
    _ =>
      if qbe_is_obj_ty(inner_ty) {
        g.need_drop_opt_obj = true
        "$pion_drop_opt_obj"
      } else {
        "0"
      }
  }
  let obj = qbe_tmp(g)
  qbe_emit(g, obj + " =l call $pion_alloc_uninit(w 16, w 5, l " + drop_sym + ")")
  qbe_emit(g, "storel 1, " + obj)
  let p1 = qbe_tmp(g)
  qbe_emit(g, p1 + " =l add " + obj + ", 8")
  qbe_emit(g, "storel " + vreg + ", " + p1)
  obj
}

///|
fn qbe_emit_result(
  g : QbeGen,
  tag : Int,
  vreg : String,
  ok_ty : Ty,
  err_ty : Ty,
) -> String {
  let active_ty = subst_ty(if tag == 0 { ok_ty } else { err_ty }, g.cur_type_subst)
  let active_drop = if tag == 0 {
    "$pion_drop_res_ok"
  } else {
    "$pion_drop_res_err"
  }
  let drop_sym = match active_ty {
    TParam(tn) =>
      if qbe_tp_live(g, tn) {
        if tag == 0 {
          g.need_drop_res_ok = true
        } else {
          g.need_drop_res_err = true
        }
        qbe_select_drop_by_tparam(g, tn, active_drop)
      } else {
        "0"
      }
    _ =>
      if qbe_is_obj_ty(active_ty) {
        if tag == 0 {
          g.need_drop_res_ok = true
        } else {
          g.need_drop_res_err = true
        }
        active_drop
      } else {
        "0"
      }
  }
  let obj = qbe_tmp(g)
  qbe_emit(g, obj + " =l call $pion_alloc_uninit(w 16, w 5, l " + drop_sym + ")")
  qbe_emit(g, "storel " + tag.to_string() + ", " + obj)
  let p1 = qbe_tmp(g)
  qbe_emit(g, p1 + " =l add " + obj + ", 8")
  qbe_emit(g, "storel " + vreg + ", " + p1)
  obj
}

///|
fn qbe_emit_string_lit(g : QbeGen, s : String) -> String {
  let id = qbe_intern_string(g, s)
  let t = qbe_tmp(g)
  qbe_emit(g, t + " =l add $pion_str_" + id.to_string() + "_hdr, 24")
  t
}

///|
fn qbe_emit_closure_call(
  g : QbeGen,
  clo_val : String,
  arg_vals : Array[String],
  arg_tys : Array[Ty],
) -> String {
  let l_args : Array[String] = []
  let mut k = 0
  while k < arg_vals.length() {
    l_args.push(qbe_as_l(g, qval(arg_vals[k], arg_tys[k])))
    k = k + 1
  }
  let fn_ptr = qbe_tmp(g)
  qbe_emit(g, fn_ptr + " =l loadl " + clo_val)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =l call ")
  sb.write_string(fn_ptr)
  sb.write_string("(l ")
  sb.write_string(clo_val)
  let mut i = 0
  while i < l_args.length() {
    sb.write_string(", l ")
    sb.write_string(l_args[i])
    i = i + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  let mut j = 0
  while j < arg_vals.length() {
    qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    j = j + 1
  }
  qbe_emit(g, "call $pion_rc_dec(l " + clo_val + ")")
  res
}

///|
fn qbe_emit_world_builtin(
  g : QbeGen,
  name : String,
  args : Array[Expr],
) -> QbeVal {
  let can_borrow = !qbe_args_have_assign(args)
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let arg_borrowed : Array[Bool] = []
  let mut i = 0
  while i < args.length() {
    let av = qbe_emit_arg_maybe_borrow(g, args[i], None, can_borrow)
    arg_vals.push(av.qv.reg)
    arg_tys.push(av.qv.ty)
    arg_borrowed.push(av.borrowed)
    i = i + 1
  }
  let mut has_w = false
  let mut w_val = "0"
  if arg_tys.length() > 0 {
    match arg_tys[0] {
      TWorld => {
        has_w = true
        w_val = arg_vals[0]
      }
      _ => ()
    }
  }
  if !has_w {
    match qbe_find_world_slot(g) {
      Some(ws) => {
        let wt = qbe_tmp(g)
        qbe_emit(g, wt + " =l loadl " + ws)
        w_val = wt
      }
      None => w_val = "0"
    }
  }
  let off = if has_w { 1 } else { 0 }
  let mut res = "0"
  let mut rty = TUnit
  if name == "io_print" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_print(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_println" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_println(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_eprintln" {
    let s = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    qbe_emit(g, "call $pion_world_eprintln(l " + w_val + ", l " + s + ")")
    rty = TUnit
  } else if name == "io_read_line" {
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s + " =l call $pion_world_read_line(l " + w_val + ", l " + ok_slot + ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_some = qbe_lbl(g, "rl_some")
    let l_none = qbe_lbl(g, "rl_none")
    let l_end = qbe_lbl(g, "rl_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
    qbe_emit_lbl(g, l_some)
    let some_obj = qbe_emit_some(g, raw_s, TString)
    qbe_emit(g, "storel " + some_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_none)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let none_obj = qbe_emit_none(g, TString)
    qbe_emit(g, "storel " + none_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TOption(TString)
  } else if name == "fs_read" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_fs_read(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsr_ok")
    let l_err = qbe_lbl(g, "fsr_err")
    let l_end = qbe_lbl(g, "fsr_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let err_s = qbe_emit_string_lit(g, "fs_read failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "fs_write" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let c = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_write(l " + w_val + ", l " + p + ", l " + c + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsw_ok")
    let l_err = qbe_lbl(g, "fsw_err")
    let l_end = qbe_lbl(g, "fsw_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_write failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_read_bytes" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_b = qbe_tmp(g)
    qbe_emit(
      g,
      raw_b +
      " =l call $pion_world_fs_read_bytes(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsrb_ok")
    let l_err = qbe_lbl(g, "fsrb_err")
    let l_end = qbe_lbl(g, "fsrb_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_b, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_b + ")")
    let err_s = qbe_emit_string_lit(g, "fs_read_bytes failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  } else if name == "fs_write_bytes" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let b = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_write_bytes(l " + w_val + ", l " + p + ", l " + b + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fswb_ok")
    let l_err = qbe_lbl(g, "fswb_err")
    let l_end = qbe_lbl(g, "fswb_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_write_bytes failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_append" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let c = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let ok_w = qbe_tmp(g)
    qbe_emit(
      g,
      ok_w + " =w call $pion_world_fs_append(l " + w_val + ", l " + p + ", l " + c + ")",
    )
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsap_ok")
    let l_err = qbe_lbl(g, "fsap_err")
    let l_end = qbe_lbl(g, "fsap_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_s = qbe_emit_string_lit(g, "fs_append failed")
    let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TUnit, TString)
  } else if name == "fs_mtime_ms" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_mtime_ms(l " + w_val + ", l " + p + ")")
    rty = TInt64
  } else if name == "fs_exists" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_exists(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_is_dir" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_is_dir(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_mkdir_p" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_mkdir_p(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_remove" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(g, rw + " =w call $pion_world_fs_remove(l " + w_val + ", l " + p + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_rename" {
    let p1 = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let p2 = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw +
      " =w call $pion_world_fs_rename(l " +
      w_val +
      ", l " +
      p1 +
      ", l " +
      p2 +
      ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_size" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_size(l " + w_val + ", l " + p + ")")
    rty = TInt64
  } else if name == "fs_lstat" || name == "fs_readlink" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    let csym = if name == "fs_lstat" {
      "$pion_world_fs_lstat"
    } else {
      "$pion_world_fs_readlink"
    }
    qbe_emit(
      g,
      raw_s + " =l call " + csym + "(l " + w_val + ", l " + p + ", l " + ok_slot + ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsl_ok")
    let l_err = qbe_lbl(g, "fsl_err")
    let l_end = qbe_lbl(g, "fsl_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_obj = qbe_emit_result(g, 1, raw_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "fs_symlink" {
    let t = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let lp = if arg_vals.length() > off + 1 { arg_vals[off + 1] } else { "0" }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw + " =w call $pion_world_fs_symlink(l " + w_val + ", l " + t + ", l " + lp + ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_chmod" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let m_w = if arg_vals.length() > off + 1 {
      if qbe_abi_ty(arg_tys[off + 1]) == "w" {
        arg_vals[off + 1]
      } else {
        let tw = qbe_tmp(g)
        qbe_emit(g, tw + " =w copy " + arg_vals[off + 1])
        tw
      }
    } else {
      "0"
    }
    let rw = qbe_tmp(g)
    qbe_emit(
      g,
      rw + " =w call $pion_world_fs_chmod(l " + w_val + ", l " + p + ", w " + m_w + ")",
    )
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l extuw " + rw)
    rty = TBool
  } else if name == "fs_read_range_nofollow" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let off_l = if arg_vals.length() > off + 1 {
      qbe_as_l(g, qval(arg_vals[off + 1], arg_tys[off + 1]))
    } else {
      "0"
    }
    let len_l = if arg_vals.length() > off + 2 {
      qbe_as_l(g, qval(arg_vals[off + 2], arg_tys[off + 2]))
    } else {
      "0"
    }
    let exp_l = if arg_vals.length() > off + 3 {
      qbe_as_l(g, qval(arg_vals[off + 3], arg_tys[off + 3]))
    } else {
      "0"
    }
    let ok_slot = qbe_alloc_slot4(g)
    let raw = qbe_tmp(g)
    qbe_emit(
      g,
      raw +
      " =l call $pion_world_fs_read_range_nofollow(l " +
      w_val +
      ", l " +
      p +
      ", l " +
      off_l +
      ", l " +
      len_l +
      ", l " +
      exp_l +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "fsrn_ok")
    let l_err = qbe_lbl(g, "fsrn_err")
    let l_end = qbe_lbl(g, "fsrn_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let err_obj = qbe_emit_result(g, 1, raw, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  } else if name == "fs_list_dir" {
    let p = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_fs_list_dir(l " + w_val + ", l " + p + ")")
    rty = TArray(TString)
  } else if name == "args_get" || name == "world_args" {
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_args(l " + w_val + ")")
    rty = TArray(TString)
  } else if name == "world_argc" {
    let r64 = qbe_tmp(g)
    qbe_emit(g, r64 + " =l call $pion_world_argc(l " + w_val + ")")
    res = qbe_tmp(g)
    qbe_emit(g, res + " =w copy " + r64)
    rty = TInt
  } else if name == "world_argv" {
    let idx = if arg_vals.length() > off {
      qbe_as_l(g, qval(arg_vals[off], arg_tys[off]))
    } else {
      "0"
    }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_argv(l " + w_val + ", l " + idx + ")")
    rty = TString
  } else if name == "env_get" {
    let k = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let ok_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_env_get(l " +
      w_val +
      ", l " +
      k +
      ", l " +
      ok_slot +
      ")",
    )
    let ok_w = qbe_tmp(g)
    qbe_emit(g, ok_w + " =w loadw " + ok_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_some = qbe_lbl(g, "env_some")
    let l_none = qbe_lbl(g, "env_none")
    let l_end = qbe_lbl(g, "env_end")
    qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
    qbe_emit_lbl(g, l_some)
    let some_obj = qbe_emit_some(g, raw_s, TString)
    qbe_emit(g, "storel " + some_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_none)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let none_obj = qbe_emit_none(g, TString)
    qbe_emit(g, "storel " + none_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TOption(TString)
  } else if name == "clock_now_ms" {
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l call $pion_world_clock_ms(l " + w_val + ")")
    rty = TInt64
  } else if name == "proc_exec" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    res = qbe_tmp(g)
    qbe_emit(g, res + " =w call $pion_world_exec(l " + w_val + ", l " + arr + ")")
    rty = TInt
  } else if name == "proc_exec_capture" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rc_slot = qbe_alloc_slot4(g)
    let raw_s = qbe_tmp(g)
    qbe_emit(
      g,
      raw_s +
      " =l call $pion_world_exec_capture(l " +
      w_val +
      ", l " +
      arr +
      ", l " +
      rc_slot +
      ")",
    )
    let rc_w = qbe_tmp(g)
    qbe_emit(g, rc_w + " =w loadw " + rc_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "pexc_ok")
    let l_err = qbe_lbl(g, "pexc_err")
    let l_end = qbe_lbl(g, "pexc_end")
    qbe_emit_term(g, "jnz " + rc_w + ", " + l_err + ", " + l_ok)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_s, TString, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    let rc_l = qbe_tmp(g)
    qbe_emit(g, rc_l + " =l extsw " + rc_w)
    let rc_str = qbe_tmp(g)
    qbe_emit(g, rc_str + " =l call $pion_int_to_str(l " + rc_l + ")")
    let pre_s = qbe_emit_string_lit(g, "exit ")
    let sep_s = qbe_emit_string_lit(g, ": ")
    let p1 = qbe_tmp(g)
    qbe_emit(g, p1 + " =l call $pion_str_concat(l " + pre_s + ", l " + rc_str + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + rc_str + ")")
    let p2 = qbe_tmp(g)
    qbe_emit(g, p2 + " =l call $pion_str_concat(l " + p1 + ", l " + sep_s + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + p1 + ")")
    let err_s = qbe_tmp(g)
    qbe_emit(g, err_s + " =l call $pion_str_concat(l " + p2 + ", l " + raw_s + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + p2 + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + raw_s + ")")
    let err_obj = qbe_emit_result(g, 1, err_s, TString, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TString, TString)
  } else if name == "proc_exec_capture_bytes" {
    let arr = if arg_vals.length() > off { arg_vals[off] } else { "0" }
    let rc_slot = qbe_alloc_slot4(g)
    let raw_b = qbe_tmp(g)
    qbe_emit(
      g,
      raw_b +
      " =l call $pion_world_exec_capture_bytes(l " +
      w_val +
      ", l " +
      arr +
      ", l " +
      rc_slot +
      ")",
    )
    let rc_w = qbe_tmp(g)
    qbe_emit(g, rc_w + " =w loadw " + rc_slot)
    let res_slot = qbe_alloc_slot(g)
    let l_ok = qbe_lbl(g, "pexb_ok")
    let l_err = qbe_lbl(g, "pexb_err")
    let l_end = qbe_lbl(g, "pexb_end")
    qbe_emit_term(g, "jnz " + rc_w + ", " + l_err + ", " + l_ok)
    qbe_emit_lbl(g, l_ok)
    let ok_obj = qbe_emit_result(g, 0, raw_b, TBytes, TString)
    qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_err)
    qbe_emit(g, "call $pion_rc_dec(l " + raw_b + ")")
    let rc_l = qbe_tmp(g)
    qbe_emit(g, rc_l + " =l extsw " + rc_w)
    let rc_str = qbe_tmp(g)
    qbe_emit(g, rc_str + " =l call $pion_int_to_str(l " + rc_l + ")")
    let pre_s = qbe_emit_string_lit(g, "exit ")
    let err_s = qbe_tmp(g)
    qbe_emit(g, err_s + " =l call $pion_str_concat(l " + pre_s + ", l " + rc_str + ")")
    qbe_emit(g, "call $pion_rc_dec(l " + rc_str + ")")
    let err_obj = qbe_emit_result(g, 1, err_s, TBytes, TString)
    qbe_emit(g, "storel " + err_obj + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    res = qbe_tmp(g)
    qbe_emit(g, res + " =l loadl " + res_slot)
    rty = TResult(TBytes, TString)
  }
  let mut j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qval(res, rty)
}

///|
fn qbe_emit_variant_ctor(
  g : QbeGen,
  enum_name : String,
  vname : String,
  args : Array[Expr],
  expected : Option[Ty],
) -> QbeVal {
  if enum_name == "Option" || (enum_name == "" && (vname == "Some" || vname == "None")) {
    let exp_inner : Option[Ty] = match expected {
      Some(TOption(inner)) => Some(inner)
      _ => None
    }
    if vname == "None" {
      let inner_ty = match exp_inner {
        Some(t) => t
        None => TError
      }
      return qval(qbe_emit_none(g, inner_ty), TOption(inner_ty))
    }
    let av = if args.length() >= 1 {
      qbe_emit_expr(g, args[0], exp_inner)
    } else {
      qval("0", TError)
    }
    return qval(qbe_emit_some(g, qbe_as_l(g, av), av.ty), TOption(av.ty))
  }
  if enum_name == "Result" || (enum_name == "" && (vname == "Ok" || vname == "Err")) {
    let mut exp_ok : Option[Ty] = None
    let mut exp_err : Option[Ty] = None
    match expected {
      Some(TResult(o, e)) => {
        exp_ok = Some(o)
        exp_err = Some(e)
      }
      _ => ()
    }
    if vname == "Ok" {
      let av = if args.length() >= 1 {
        qbe_emit_expr(g, args[0], exp_ok)
      } else {
        qval("0", TError)
      }
      let ety = match exp_err {
        Some(e) => e
        None => TError
      }
      return qval(qbe_emit_result(g, 0, qbe_as_l(g, av), av.ty, ety), TResult(av.ty, ety))
    } else {
      let av = if args.length() >= 1 {
        qbe_emit_expr(g, args[0], exp_err)
      } else {
        qval("0", TError)
      }
      let oty = match exp_ok {
        Some(o) => o
        None => TError
      }
      return qval(qbe_emit_result(g, 1, qbe_as_l(g, av), oty, av.ty), TResult(oty, av.ty))
    }
  }
  let resolved_enum = if enum_name != "" {
    enum_name
  } else {
    match qbe_lookup_variant_enum(g, vname) {
      Some(en) => en
      None => ""
    }
  }
  match qbe_lookup_enum_info(g, resolved_enum) {
    None => qval("0", TError)
    Some(einfo) => {
      let subst : Map[String, Ty] = Map([])
      match expected {
        Some(TEnum(en, eargs)) =>
          if en == resolved_enum ||
            (g.mono_pkg != "" && g.mono_pkg + "::" + en == resolved_enum) ||
            (g.mono_pkg != "" && en == g.mono_pkg + "::" + resolved_enum) {
            let mut k = 0
            while k < einfo.decl.type_params.length() && k < eargs.length() {
              match eargs[k] {
                TError => ()
                _ => subst.set(einfo.decl.type_params[k], eargs[k])
              }
              k = k + 1
            }
          }
        _ => ()
      }
      let mut tag = 0
      let arg_vals : Array[String] = []
      let arg_tys : Array[Ty] = []
      let mut matched_field_tys : Array[Ty] = []
      let mut vi = 0
      while vi < einfo.variants.length() {
        let v = einfo.variants[vi]
        if v.name == vname {
          tag = vi
          matched_field_tys = v.field_tys
          let mut fi = 0
          while fi < args.length() {
            let exp_f : Option[Ty] = if fi < v.field_tys.length() {
              Some(subst_ty_mask_unbound(v.field_tys[fi], einfo.decl.type_params, subst))
            } else {
              None
            }
            let av = qbe_emit_expr(g, args[fi], exp_f)
            if fi < v.field_tys.length() {
              unify_tparams(v.field_tys[fi], av.ty, subst)
            }
            arg_vals.push(av.reg)
            arg_tys.push(av.ty)
            fi = fi + 1
          }
          break
        }
        vi = vi + 1
      }
      if arg_vals.length() == 0 {
        let sym = qbe_register_enum_const(g, resolved_enum, vname, tag)
        let obj = qbe_tmp(g)
        qbe_emit(g, obj + " =l add " + sym + ", 24")
        let targs : Array[Ty] = []
        let mut ti = 0
        while ti < einfo.decl.type_params.length() {
          match subst.get(einfo.decl.type_params[ti]) {
            Some(t) => targs.push(t)
            None => targs.push(TError)
          }
          ti = ti + 1
        }
        return qval(obj, TEnum(resolved_enum, targs))
      }
      if arg_vals.length() == 1 && args.length() == 1 {
        match arg_tys[0] {
          TBool => {
            let targs : Array[Ty] = []
            let mut ti = 0
            while ti < einfo.decl.type_params.length() {
              match subst.get(einfo.decl.type_params[ti]) {
                Some(t) => targs.push(t)
                None => targs.push(TError)
              }
              ti = ti + 1
            }
            match args[0] {
              EBool(b, _) => {
                let sym = qbe_register_enum_bool_const(
                  g,
                  resolved_enum,
                  vname,
                  tag,
                  if b { 1 } else { 0 },
                )
                let obj = qbe_tmp(g)
                qbe_emit(g, obj + " =l add " + sym + ", 24")
                return qval(obj, TEnum(resolved_enum, targs))
              }
              _ => {
                let sym_t = qbe_register_enum_bool_const(g, resolved_enum, vname, tag, 1)
                let sym_f = qbe_register_enum_bool_const(g, resolved_enum, vname, tag, 0)
                let res_slot = qbe_alloc_slot(g)
                let l_t = qbe_lbl(g, "eb_t")
                let l_f = qbe_lbl(g, "eb_f")
                let l_e = qbe_lbl(g, "eb_e")
                qbe_emit_term(g, "jnz " + arg_vals[0] + ", " + l_t + ", " + l_f)
                qbe_emit_lbl(g, l_t)
                let ot = qbe_tmp(g)
                qbe_emit(g, ot + " =l add " + sym_t + ", 24")
                qbe_emit(g, "storel " + ot + ", " + res_slot)
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_f)
                let of = qbe_tmp(g)
                qbe_emit(g, of + " =l add " + sym_f + ", 24")
                qbe_emit(g, "storel " + of + ", " + res_slot)
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_e)
                let obj = qbe_tmp(g)
                qbe_emit(g, obj + " =l loadl " + res_slot)
                return qval(obj, TEnum(resolved_enum, targs))
              }
            }
          }
          _ => ()
        }
      }
      let payload_sz = (1 + arg_vals.length()) * 8
      let drop_sym = if einfo.decl.type_params.length() == 0 {
        if has_qual_sep(resolved_enum) && !str_arr_contains(g.enum_order, resolved_enum) {
          g.enum_order.push(resolved_enum)
        }
        "$pion_drop_enum_" + qbe_sanitize_sym(resolved_enum)
      } else {
        let obj_slots : Array[Int] = []
        let tp_names : Array[String] = []
        let tp_slots : Array[Array[Int]] = []
        let mut fi = 0
        while fi < arg_tys.length() {
          if qbe_is_obj_ty(arg_tys[fi]) {
            obj_slots.push(fi + 1)
          } else {
            match arg_tys[fi] {
              TParam(tn) =>
                if qbe_tp_live(g, tn) {
                  qbe_add_tp_drop_slot(tp_names, tp_slots, tn, fi + 1)
                }
              _ => ()
            }
          }
          fi = fi + 1
        }
        qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
      }
      let obj = qbe_tmp(g)
      qbe_emit(
        g,
        obj +
        " =l call $pion_alloc_uninit(w " +
        payload_sz.to_string() +
        ", w 5, l " +
        drop_sym +
        ")",
      )
      qbe_emit(g, "storel " + tag.to_string() + ", " + obj)
      let mut fi = 0
      while fi < arg_vals.length() {
        let off = (fi + 1) * 8
        let p = qbe_tmp(g)
        qbe_emit(g, p + " =l add " + obj + ", " + off.to_string())
        let store_ty = if fi < matched_field_tys.length() {
          let cty = subst_ty(
            subst_ty(matched_field_tys[fi], subst),
            g.cur_type_subst,
          )
          if ty_has_unresolved(cty) { arg_tys[fi] } else { cty }
        } else {
          arg_tys[fi]
        }
        let coerced = qbe_coerce_val(g, qval(arg_vals[fi], arg_tys[fi]), store_ty)
        qbe_store_heap_slot(g, coerced, p, store_ty)
        fi = fi + 1
      }
      let targs : Array[Ty] = []
      let mut ti = 0
      while ti < einfo.decl.type_params.length() {
        match subst.get(einfo.decl.type_params[ti]) {
          Some(t) => targs.push(t)
          None => targs.push(TError)
        }
        ti = ti + 1
      }
      qval(obj, TEnum(resolved_enum, targs))
    }
  }
}

///|
fn qbe_emit_closure_obj(
  g : QbeGen,
  params : Array[Param],
  ret_te : TypeExpr,
  body : Array[Stmt],
  is_spawn : Bool,
  expected : Option[Ty],
  sp : Span,
) -> QbeCloRes {
  let locals : Map[String, Bool] = Map([])
  let mut pi = 0
  while pi < params.length() {
    locals.set(params[pi].name, true)
    pi = pi + 1
  }
  let raw_caps : Array[CaptureInfo] = []
  collect_stmts_captures(body, locals, raw_caps)
  let cap_locals : Array[QbeLocal] = []
  let seen : Map[String, Bool] = Map([])
  let mut ci = 0
  while ci < raw_caps.length() {
    let cname = raw_caps[ci].name
    if !seen.contains(cname) {
      match qbe_lookup_local(g, cname) {
        Some(loc) => {
          seen.set(cname, true)
          g.unfrozen_local_arrs.remove(cname)
          cap_locals.push(loc)
        }
        None => ()
      }
    }
    ci = ci + 1
  }

  let clo_id = g.next_clo
  g.next_clo = clo_id + 1
  let fn_sym = if is_spawn {
    "$pion_spawn_" + clo_id.to_string()
  } else {
    "$pion_clo_" + clo_id.to_string()
  }

  let inf_ty = qbe_closure_infer(g, sp)
  let exp_ptys : Array[Ty] = match expected {
    Some(TFn(ep, _)) => ep
    _ => []
  }
  let inf_ptys : Array[Ty] = match inf_ty {
    Some(TFn(ip, _)) => ip
    _ => []
  }
  let ptys : Array[Ty] = []
  pi = 0
  while pi < params.length() {
    let pty = match params[pi].ty {
      TyMissing(_) => {
        let mut chosen = TError
        if pi < exp_ptys.length() && !qbe_ty_has_param(exp_ptys[pi]) {
          chosen = exp_ptys[pi]
        }
        match chosen {
          TError =>
            if pi < inf_ptys.length() {
              match inf_ptys[pi] {
                TError => ()
                t => chosen = t
              }
            }
          _ => ()
        }
        match chosen {
          TError =>
            if pi < exp_ptys.length() {
              chosen = exp_ptys[pi]
            }
          _ => ()
        }
        chosen
      }
      _ => qbe_resolve_type(g, params[pi].ty)
    }
    ptys.push(pty)
    pi = pi + 1
  }
  let ret_ty = match ret_te {
    TyMissing(_) => {
      let mut chosen = TError
      match expected {
        Some(TFn(_, er)) =>
          if !qbe_ty_has_param(er) {
            chosen = er
          }
        _ => ()
      }
      match chosen {
        TError =>
          match inf_ty {
            Some(TFn(_, ir)) =>
              match ir {
                TError => ()
                t => chosen = t
              }
            _ => ()
          }
        _ => ()
      }
      match chosen {
        TError =>
          match expected {
            Some(TFn(_, er)) =>
              match er {
                TError => TUnit
                t => t
              }
            _ => TUnit
          }
        t => t
      }
    }
    _ => qbe_resolve_type(g, ret_te)
  }

  let cap_tparams : Array[String] = []
  let mut tpi = 0
  while tpi < g.cur_tparams.length() {
    let tn = g.cur_tparams[tpi]
    if !g.cur_type_subst.contains(tn) {
      cap_tparams.push(tn)
    }
    tpi = tpi + 1
  }

  let n_slots = 1 + cap_locals.length() + cap_tparams.length()
  let drop_slots : Array[Int] = []
  let mut has_tparam_cap = false
  let mut mi = 0
  while mi < cap_locals.length() {
    if qbe_is_obj_ty(cap_locals[mi].ty) {
      drop_slots.push(mi + 1)
    } else {
      match cap_locals[mi].ty {
        TParam(tn) =>
          if str_arr_contains(cap_tparams, tn) {
            has_tparam_cap = true
          }
        _ => ()
      }
    }
    mi = mi + 1
  }
  let drop_sym = if has_tparam_cap {
    let dsym = "$pion_drop_clo_" + clo_id.to_string()
    let dsb = StringBuilder()
    dsb.write_string("function " + dsym + "(l %p) {\n@start\n")
    let mut di = 0
    while di < cap_locals.length() {
      let cty = cap_locals[di].ty
      let off = (di + 1) * 8
      if qbe_is_obj_ty(cty) {
        dsb.write_string("    %a" + di.to_string() + " =l add %p, " + off.to_string() + "\n")
        dsb.write_string("    %v" + di.to_string() + " =l loadl %a" + di.to_string() + "\n")
        dsb.write_string("    call $pion_rc_dec(l %v" + di.to_string() + ")\n")
      } else {
        match cty {
          TParam(tn) => {
            let mut found_ti = -1
            let mut tj = 0
            while tj < cap_tparams.length() {
              if cap_tparams[tj] == tn {
                found_ti = tj
                break
              }
              tj = tj + 1
            }
            if found_ti >= 0 {
              let tp_off = (1 + cap_locals.length() + found_ti) * 8
              dsb.write_string("    %tp_a" + di.to_string() + " =l add %p, " + tp_off.to_string() + "\n")
              dsb.write_string("    %tp_f" + di.to_string() + " =l loadl %tp_a" + di.to_string() + "\n")
              dsb.write_string("    jnz %tp_f" + di.to_string() + ", @do_" + di.to_string() + ", @sk_" + di.to_string() + "\n")
              dsb.write_string("@do_" + di.to_string() + "\n")
              dsb.write_string("    %a" + di.to_string() + " =l add %p, " + off.to_string() + "\n")
              dsb.write_string("    %v" + di.to_string() + " =l loadl %a" + di.to_string() + "\n")
              dsb.write_string("    call $pion_rc_dec(l %v" + di.to_string() + ")\n")
              dsb.write_string("    jmp @sk_" + di.to_string() + "\n")
              dsb.write_string("@sk_" + di.to_string() + "\n")
            }
          }
          _ => ()
        }
      }
      di = di + 1
    }
    dsb.write_string("    ret\n}\n\n")
    g.extra_fns.push(dsb.to_string())
    dsym
  } else {
    qbe_register_slot_drop(g, drop_slots)
  }
  let env_obj = qbe_tmp(g)
  qbe_emit(
    g,
    env_obj +
    " =l call $pion_alloc_uninit(w " +
    (n_slots * 8).to_string() +
    ", w 6, l " +
    drop_sym +
    ")",
  )
  qbe_emit(g, "storel " + fn_sym + ", " + env_obj)
  let mut ki = 0
  while ki < cap_locals.length() {
    let loc = cap_locals[ki]
    let dv = qbe_load_local_slot(g, loc.slot, loc.ty)
    let v = qbe_as_l(g, qval(dv, loc.ty))
    if is_spawn {
      qbe_emit_deep_freeze(g, v, loc.ty)
    }
    qbe_rc_inc(g, v, loc.ty)
    let off = (ki + 1) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add " + env_obj + ", " + off.to_string())
    qbe_emit(g, "storel " + v + ", " + p)
    ki = ki + 1
  }
  tpi = 0
  while tpi < cap_tparams.length() {
    let off = (1 + cap_locals.length() + tpi) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add " + env_obj + ", " + off.to_string())
    qbe_emit(g, "storel %tp_" + cap_tparams[tpi] + ", " + p)
    tpi = tpi + 1
  }

  let saved_allocs = g.fn_allocs
  let saved_body = g.fn_body
  let saved_scopes = g.scopes
  let saved_breaks = g.loop_breaks
  let saved_conts = g.loop_conts
  let saved_depths = g.loop_depths
  let saved_ret = g.cur_ret_ty
  let saved_ret_abi = g.cur_ret_abi_ty
  let saved_fn_void = g.cur_fn_void
  let saved_term = g.block_term
  let saved_hlen = g.hoisted_arr_len
  let saved_hdp = g.hoisted_arr_dp
  let saved_hslen = g.hoisted_str_len
  let saved_hsdp = g.hoisted_str_dp
  let saved_hfields = g.hoisted_fields
  let saved_bfields = g.block_immut_fields
  let saved_lalias = g.len_aliases
  let saved_lkeys = g.len_alias_keys
  let saved_nonneg = g.nonneg_vars
  let saved_bce = g.bce_safe_indices
  let saved_bce_exprs = g.bce_safe_exprs
  let saved_movable = g.movable_locals
  let saved_moved = g.moved_slots
  let saved_zeroed = g.zeroed_slots
  let saved_sq_slot = g.sq_reuse_slot
  let saved_sq_state = g.sq_reuse_state
  let saved_prom = g.promoted_fields
  let saved_prom_tys = g.promoted_field_tys
  let saved_w2l = g.w_to_l_ext
  let saved_local_w2l = g.local_w_to_l_ext
  let saved_unfrozen = g.unfrozen_local_arrs

  g.fn_allocs = StringBuilder()
  g.fn_body = StringBuilder()
  g.scopes = []
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.cur_ret_ty = ret_ty
  g.cur_ret_abi_ty = TInt64
  g.cur_fn_void = is_spawn
  g.block_term = false
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.zeroed_slots = Map([])
  g.sq_reuse_slot = Map([])
  g.sq_reuse_state = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])

  qbe_scope_push(g)
  tpi = 0
  while tpi < cap_tparams.length() {
    let off = (1 + cap_locals.length() + tpi) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add %env, " + off.to_string())
    qbe_emit(g, "%tp_" + cap_tparams[tpi] + " =l loadl " + p)
    tpi = tpi + 1
  }
  ki = 0
  while ki < cap_locals.length() {
    let cap = cap_locals[ki]
    let loc = qbe_define_local(g, cap.name, cap.ty, false)
    let off = (ki + 1) * 8
    let p = qbe_tmp(g)
    qbe_emit(g, p + " =l add %env, " + off.to_string())
    let v = qbe_load_heap_slot(g, p, cap.ty)
    qbe_store_local_slot(g, v, loc.slot, cap.ty)
    ki = ki + 1
  }
  pi = 0
  while pi < params.length() {
    let loc = qbe_define_local(g, params[pi].name, ptys[pi], false)
    let pv = qbe_from_l(g, "%p" + pi.to_string(), ptys[pi])
    qbe_store_local_slot(g, pv, loc.slot, ptys[pi])
    pi = pi + 1
  }

  let bres = qbe_emit_stmts(g, body, Some(ret_ty))
  let actual_ret = match ret_te {
    TyMissing(_) =>
      if g.block_term {
        ret_ty
      } else {
        match bres.ty {
          TNever | TError => ret_ty
          _ =>
            if ty_has_unresolved(bres.ty) && !ty_has_unresolved(ret_ty) {
              ret_ty
            } else {
              bres.ty
            }
        }
      }
    _ => ret_ty
  }
  if !g.block_term {
    if is_spawn {
      qbe_rc_dec(g, bres.reg, bres.ty)
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret")
    } else {
      let ret_l = qbe_as_l(g, bres)
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret " + ret_l)
    }
  } else {
    let _ = g.scopes.pop()
  }

  let hdr = StringBuilder()
  if is_spawn {
    hdr.write_string("function ")
    hdr.write_string(fn_sym)
    hdr.write_string("(l %env) {\n@start\n")
  } else {
    hdr.write_string("function l ")
    hdr.write_string(fn_sym)
    hdr.write_string("(l %env")
    pi = 0
    while pi < params.length() {
      hdr.write_string(", l %p")
      hdr.write_string(pi.to_string())
      pi = pi + 1
    }
    hdr.write_string(") {\n@start\n")
  }
  hdr.write_string(g.fn_allocs.to_string())
  hdr.write_string(g.fn_body.to_string())
  hdr.write_string("}\n\n")
  g.extra_fns.push(hdr.to_string())

  g.fn_allocs = saved_allocs
  g.fn_body = saved_body
  g.scopes = saved_scopes
  g.loop_breaks = saved_breaks
  g.loop_conts = saved_conts
  g.loop_depths = saved_depths
  g.cur_ret_ty = saved_ret
  g.cur_ret_abi_ty = saved_ret_abi
  g.cur_fn_void = saved_fn_void
  g.block_term = saved_term
  g.hoisted_arr_len = saved_hlen
  g.hoisted_arr_dp = saved_hdp
  g.hoisted_str_len = saved_hslen
  g.hoisted_str_dp = saved_hsdp
  g.hoisted_fields = saved_hfields
  g.block_immut_fields = saved_bfields
  g.len_aliases = saved_lalias
  g.len_alias_keys = saved_lkeys
  g.nonneg_vars = saved_nonneg
  g.bce_safe_indices = saved_bce
  g.bce_safe_exprs = saved_bce_exprs
  g.movable_locals = saved_movable
  g.moved_slots = saved_moved
  g.zeroed_slots = saved_zeroed
  g.sq_reuse_slot = saved_sq_slot
  g.sq_reuse_state = saved_sq_state
  g.promoted_fields = saved_prom
  g.promoted_field_tys = saved_prom_tys
  g.w_to_l_ext = saved_w2l
  g.local_w_to_l_ext = saved_local_w2l
  g.unfrozen_local_arrs = saved_unfrozen

  QbeCloRes::{ env: env_obj, fn_sym: fn_sym, ty: TFn(ptys, actual_ret) }
}

///|
/// `opt.is_some()` / `res.is_ok()` and friends: compare the tag word (Option:
/// `Some` = 1; Result: `Ok` = 0) against zero.
fn qbe_emit_tag_test(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  obj_ty : Ty,
  cmp : String,
) -> QbeVal {
  let is_niche = match obj_ty {
    TOption(inner) => qbe_is_niche_opt_inner(inner)
    _ => false
  }
  let cw = qbe_tmp(g)
  let r = qbe_tmp(g)
  if is_niche {
    qbe_emit(g, cw + " =w " + cmp + " " + obj_val + ", 0")
  } else {
    let tag = qbe_tmp(g)
    qbe_emit(g, tag + " =l loadl " + obj_val)
    qbe_emit(g, cw + " =w " + cmp + " " + tag + ", 0")
  }
  qbe_emit(g, r + " =l extuw " + cw)
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, obj_ty)
  }
  qval(r, TBool)
}

///|
/// `opt.unwrap_or(d)` / `res.unwrap_or(d)`: the default is evaluated first
/// (owned); the payload is taken (+1) when the tag is `hit_tag`, otherwise the
/// default is moved into the result.
fn qbe_emit_unwrap_or(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  obj_ty : Ty,
  hit_tag : Int,
  inner : Ty,
  dflt : Expr,
) -> QbeVal {
  let dv = qbe_emit_expr(g, dflt, Some(inner))
  let dl = qbe_as_l(g, qval(qbe_coerce_val(g, dv, inner), inner))
  let res_slot = qbe_alloc_slot(g)
  let is_niche = match obj_ty {
    TOption(in_ty) => qbe_is_niche_opt_inner(in_ty)
    _ => false
  }
  if is_niche {
    let hit = qbe_tmp(g)
    let l_hit = qbe_lbl(g, "uwo_hit")
    let l_miss = qbe_lbl(g, "uwo_miss")
    let l_end = qbe_lbl(g, "uwo_end")
    qbe_emit(g, hit + " =w cnel " + obj_val + ", 0")
    qbe_emit_term(g, "jnz " + hit + ", " + l_hit + ", " + l_miss)
    qbe_emit_lbl(g, l_hit)
    qbe_emit(g, "storel " + obj_val + ", " + res_slot)
    if obj_borrowed {
      qbe_rc_inc(g, obj_val, inner)
    }
    qbe_rc_dec(g, dl, inner)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_miss)
    qbe_emit(g, "storel " + dl + ", " + res_slot)
    qbe_emit_term(g, "jmp " + l_end)
    qbe_emit_lbl(g, l_end)
    let rl = qbe_tmp(g)
    qbe_emit(g, rl + " =l loadl " + res_slot)
    return qval(qbe_from_l(g, rl, inner), inner)
  }
  let tag = qbe_tmp(g)
  let hit = qbe_tmp(g)
  let l_hit = qbe_lbl(g, "uwo_hit")
  let l_miss = qbe_lbl(g, "uwo_miss")
  let l_end = qbe_lbl(g, "uwo_end")
  qbe_emit(g, tag + " =l loadl " + obj_val)
  qbe_emit(g, hit + " =w ceql " + tag + ", " + hit_tag.to_string())
  qbe_emit_term(g, "jnz " + hit + ", " + l_hit + ", " + l_miss)
  qbe_emit_lbl(g, l_hit)
  let pp = qbe_tmp(g)
  let pv = qbe_tmp(g)
  qbe_emit(g, pp + " =l add " + obj_val + ", 8")
  qbe_emit(g, pv + " =l loadl " + pp)
  qbe_emit(g, "storel " + pv + ", " + res_slot)
  qbe_rc_inc(g, pv, inner)
  qbe_rc_dec(g, dl, inner)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_miss)
  qbe_emit(g, "storel " + dl + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, obj_ty)
  }
  let rl = qbe_tmp(g)
  qbe_emit(g, rl + " =l loadl " + res_slot)
  qval(qbe_from_l(g, rl, inner), inner)
}

///|
/// `s.to_int()` / `s.to_int64()` / `s.to_double()` -> `Option[...]`: `None`
/// for empty, malformed or out-of-range text (never panics).
fn qbe_emit_str_parse(
  g : QbeGen,
  obj_val : String,
  obj_borrowed : Bool,
  method_name : String,
) -> QbeVal {
  let ok_slot = qbe_alloc_slot4(g)
  let okw = qbe_tmp(g)
  let payload = qbe_tmp(g)
  let inner = if method_name == "to_int" {
    TInt
  } else if method_name == "to_int64" {
    TInt64
  } else {
    TDouble
  }
  let mut ok_final = okw
  if method_name == "to_double" {
    let d = qbe_tmp(g)
    qbe_emit(g, d + " =d call $pion_str_to_double(l " + obj_val + ", l " + ok_slot + ")")
    qbe_emit(g, okw + " =w loadw " + ok_slot)
    qbe_emit(g, payload + " =l cast " + d)
  } else {
    let v = qbe_tmp(g)
    qbe_emit(g, v + " =l call $pion_str_to_int(l " + obj_val + ", l " + ok_slot + ")")
    qbe_emit(g, okw + " =w loadw " + ok_slot)
    if method_name == "to_int" {
      // `Int` is 32-bit: values that do not survive the round trip are `None`.
      let vw = qbe_tmp(g)
      let in_range = qbe_tmp(g)
      let both = qbe_tmp(g)
      qbe_emit(g, vw + " =w copy " + v)
      qbe_emit(g, payload + " =l extsw " + vw)
      qbe_emit(g, in_range + " =w ceql " + payload + ", " + v)
      qbe_emit(g, both + " =w and " + okw + ", " + in_range)
      ok_final = both
    } else {
      qbe_emit(g, payload + " =l copy " + v)
    }
  }
  if !obj_borrowed {
    qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
  }
  let res_slot = qbe_alloc_slot(g)
  let l_some = qbe_lbl(g, "sp_some")
  let l_none = qbe_lbl(g, "sp_none")
  let l_end = qbe_lbl(g, "sp_end")
  qbe_emit_term(g, "jnz " + ok_final + ", " + l_some + ", " + l_none)
  qbe_emit_lbl(g, l_some)
  let some_obj = qbe_emit_some(g, payload, inner)
  qbe_emit(g, "storel " + some_obj + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_none)
  let none_obj = qbe_emit_none(g, inner)
  qbe_emit(g, "storel " + none_obj + ", " + res_slot)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =l loadl " + res_slot)
  qval(r, TOption(inner))
}

///|
fn qbe_emit_method_call(
  g : QbeGen,
  obj_expr : Expr,
  method_name : String,
  args : Array[Expr],
  expected : Option[Ty],
) -> QbeVal {
  // Fast zero-RC borrow path for `local.length()` and `local.immut_field.length()` on String / Array / Bytes
  if method_name == "length" && args.length() == 0 {
    match obj_expr {
      EIdent(lname, _) =>
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            match loc.ty {
              TString | TArray(_) | TBytes | TStringBuilder => {
                let r64 = match g.hoisted_arr_len.get(lname) {
                  Some(hlen) => hlen
                  None =>
                    match g.hoisted_str_len.get(lname) {
                      Some(hslen) => hslen
                      None => {
                        let obj_p = qbe_tmp(g)
                        let t64 = qbe_tmp(g)
                        qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                        qbe_emit(g, t64 + " =l loadl " + obj_p)
                        t64
                      }
                    }
                }
                let rw = qbe_tmp(g)
                qbe_emit(g, rw + " =w copy " + r64)
                return qval(rw, TInt)
              }
              _ => ()
            }
          None => ()
        }
      EField(EIdent(lname, _), fname, _) =>
        match qbe_lookup_local(g, lname) {
          Some(loc) =>
            match loc.ty {
              TStruct(sname, sargs) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let subst = make_subst(sinfo.decl.type_params, sargs)
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname {
                        if !sinfo.field_muts[fi] {
                          let fty = subst_ty(sinfo.field_tys[fi], subst)
                          match fty {
                            TString | TArray(_) | TBytes | TStringBuilder => {
                              let fkey = lname + "." + fname
                              let fld_p = match g.hoisted_fields.get(fkey) {
                                Some(hv) => hv.reg
                                None =>
                                  match g.block_immut_fields.get(fkey) {
                                    Some(bv) => bv.reg
                                    None => {
                                      let sp = qbe_tmp(g)
                                      let fp = qbe_tmp(g)
                                      let fv = qbe_tmp(g)
                                      qbe_emit(g, sp + " =l loadl " + loc.slot)
                                      qbe_emit(
                                        g,
                                        fp + " =l add " + sp + ", " + (fi * 8).to_string(),
                                      )
                                      qbe_emit(g, fv + " =l loadl " + fp)
                                      fv
                                    }
                                  }
                              }
                              let t64 = qbe_tmp(g)
                              let rw = qbe_tmp(g)
                              qbe_emit(g, t64 + " =l loadl " + fld_p)
                              qbe_emit(g, rw + " =w copy " + t64)
                              return qval(rw, TInt)
                            }
                            _ => ()
                          }
                        }
                        break
                      }
                      fi = fi + 1
                    }
                  }
                  None => ()
                }
              _ => ()
            }
          None => ()
        }
      _ => ()
    }
  }
  // Invalidate length aliases if array is mutated via push/pop
  if method_name == "push" || method_name == "pop" {
    match obj_expr {
      EIdent(lname, _) => qbe_invalidate_len_aliases_for(g, lname)
      _ => ()
    }
  }
  let args_pure = !qbe_args_have_assign(args)
  let can_borrow_obj = args_pure && method_name != "to_string"
  let preserve_unfrozen = if method_name == "push" ||
    method_name == "pop" ||
    method_name == "length" {
    match obj_expr {
      EIdent(lname, _) => g.unfrozen_local_arrs.contains(lname)
      _ => false
    }
  } else {
    false
  }
  let obj_av = qbe_emit_arg_maybe_borrow(g, obj_expr, None, can_borrow_obj)
  if preserve_unfrozen && can_borrow_obj {
    match obj_expr {
      EIdent(lname, _) => g.unfrozen_local_arrs.set(lname, true)
      _ => ()
    }
  }
  let obj_val = obj_av.qv.reg
  let recv_ty = obj_av.qv.ty
  let obj_borrowed = obj_av.borrowed
  match recv_ty {
    TInt => {
      if method_name == "to_string" {
        let v64 = qbe_as_l(g, qval(obj_val, TInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + v64 + ")")
        return qval(r, TString)
      }
      if method_name == "to_int64" {
        return qval(qbe_as_l(g, qval(obj_val, TInt)), TInt64)
      }
      if method_name == "to_int" {
        return qval(obj_val, TInt)
      }
      if method_name == "to_uint" || method_name == "reinterpret_as_uint" {
        return qval(obj_val, TUInt)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d swtof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s swtof " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "abs" {
        let m = qbe_tmp(g)
        let t = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, m + " =w sar " + obj_val + ", 31")
        qbe_emit(g, t + " =w xor " + obj_val + ", " + m)
        qbe_emit(g, r + " =w sub " + t + ", " + m)
        return qval(r, TInt)
      }
      if method_name == "unsafe_to_char" {
        return qval(qbe_as_l(g, qval(obj_val, TInt)), TChar)
      }
      if method_name == "to_byte" {
        let v64 = qbe_as_l(g, qval(obj_val, TInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l and " + v64 + ", 255")
        return qval(r, TByte)
      }
    }
    TInt64 => {
      if method_name == "to_string" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + obj_val + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_int64" {
        return qval(obj_val, TInt64)
      }
      if method_name == "to_uint64" || method_name == "reinterpret_as_uint64" {
        return qval(obj_val, TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d sltof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "abs" {
        let m = qbe_tmp(g)
        let t = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, m + " =l sar " + obj_val + ", 63")
        qbe_emit(g, t + " =l xor " + obj_val + ", " + m)
        qbe_emit(g, r + " =l sub " + t + ", " + m)
        return qval(r, TInt64)
      }
    }
    TUInt => {
      if method_name == "to_string" {
        let v64 = qbe_as_l(g, qval(obj_val, TUInt))
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_int_to_str(l " + v64 + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" || method_name == "reinterpret_as_int" {
        return qval(obj_val, TInt)
      }
      if method_name == "to_uint" {
        return qval(obj_val, TUInt)
      }
      if method_name == "to_int64" {
        return qval(qbe_as_l(g, qval(obj_val, TUInt)), TInt64)
      }
      if method_name == "to_uint64" {
        return qval(qbe_as_l(g, qval(obj_val, TUInt)), TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d uwtof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s uwtof " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "reinterpret_as_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s cast " + obj_val)
        return qval(r, TFloat)
      }
    }
    TUInt64 => {
      if method_name == "to_string" {
        let res_slot = qbe_alloc_slot(g)
        let is_big = qbe_tmp(g)
        let l_big = qbe_lbl(g, "u64s_big")
        let l_sm = qbe_lbl(g, "u64s_sm")
        let l_end = qbe_lbl(g, "u64s_end")
        qbe_emit(g, is_big + " =w csltl " + obj_val + ", 0")
        qbe_emit_term(g, "jnz " + is_big + ", " + l_big + ", " + l_sm)
        qbe_emit_lbl(g, l_sm)
        let s_sm = qbe_tmp(g)
        qbe_emit(g, s_sm + " =l call $pion_int_to_str(l " + obj_val + ")")
        qbe_emit(g, "storel " + s_sm + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_big)
        let qv = qbe_tmp(g)
        let rv = qbe_tmp(g)
        let sq = qbe_tmp(g)
        let sr = qbe_tmp(g)
        let sc = qbe_tmp(g)
        qbe_emit(g, qv + " =l udiv " + obj_val + ", 10")
        qbe_emit(g, rv + " =l urem " + obj_val + ", 10")
        qbe_emit(g, sq + " =l call $pion_int_to_str(l " + qv + ")")
        qbe_emit(g, sr + " =l call $pion_int_to_str(l " + rv + ")")
        qbe_emit(g, sc + " =l call $pion_str_concat(l " + sq + ", l " + sr + ")")
        qbe_emit(g, "call $pion_rc_dec(l " + sq + ")")
        qbe_emit(g, "call $pion_rc_dec(l " + sr + ")")
        qbe_emit(g, "storel " + sc + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        let out = qbe_tmp(g)
        qbe_emit(g, out + " =l loadl " + res_slot)
        return qval(out, TString)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_uint" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TUInt)
      }
      if method_name == "to_int64" || method_name == "reinterpret_as_int64" {
        return qval(obj_val, TInt64)
      }
      if method_name == "to_uint64" {
        return qval(obj_val, TUInt64)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d ultof " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "reinterpret_as_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d cast " + obj_val)
        return qval(r, TDouble)
      }
    }
    TDouble => {
      if method_name == "to_string" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_double_to_str(d " + obj_val + ")")
        return qval(r, TString)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w dtosi " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_int64" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l dtosi " + obj_val)
        return qval(r, TInt64)
      }
      if method_name == "to_float" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =s truncd " + obj_val)
        return qval(r, TFloat)
      }
      if method_name == "to_bits" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l cast " + obj_val)
        return qval(r, TInt64)
      }
      if method_name == "reinterpret_as_uint64" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l cast " + obj_val)
        return qval(r, TUInt64)
      }
      if method_name == "sqrt" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d sqrt " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "abs" || method_name == "floor" || method_name == "ceil" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d call $pion_math_" + method_name + "(d " + obj_val + ")")
        return qval(r, TDouble)
      }
      if method_name == "round" || method_name == "trunc" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d call $" + method_name + "(d " + obj_val + ")")
        return qval(r, TDouble)
      }
    }
    TFloat => {
      if method_name == "to_string" {
        let d = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, d + " =d exts " + obj_val)
        qbe_emit(g, r + " =l call $pion_double_to_str(d " + d + ")")
        return qval(r, TString)
      }
      if method_name == "to_double" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =d exts " + obj_val)
        return qval(r, TDouble)
      }
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w stosi " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_int64" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l stosi " + obj_val)
        return qval(r, TInt64)
      }
      if method_name == "to_bits" || method_name == "reinterpret_as_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w cast " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "reinterpret_as_uint" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w cast " + obj_val)
        return qval(w, TUInt)
      }
      if method_name == "abs" {
        let w = qbe_tmp(g)
        let a = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, w + " =w cast " + obj_val)
        qbe_emit(g, a + " =w and " + w + ", 2147483647")
        qbe_emit(g, r + " =s cast " + a)
        return qval(r, TFloat)
      }
      if method_name == "sqrt" {
        let d = qbe_tmp(g)
        let ds = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, d + " =d exts " + obj_val)
        qbe_emit(g, ds + " =d sqrt " + d)
        qbe_emit(g, r + " =s truncd " + ds)
        return qval(r, TFloat)
      }
      if method_name == "floor" || method_name == "ceil" {
        let d = qbe_tmp(g)
        let df = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, d + " =d exts " + obj_val)
        qbe_emit(g, df + " =d call $pion_math_" + method_name + "(d " + d + ")")
        qbe_emit(g, r + " =s truncd " + df)
        return qval(r, TFloat)
      }
      if method_name == "round" || method_name == "trunc" {
        let d = qbe_tmp(g)
        let df = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, d + " =d exts " + obj_val)
        qbe_emit(g, df + " =d call $" + method_name + "(d " + d + ")")
        qbe_emit(g, r + " =s truncd " + df)
        return qval(r, TFloat)
      }
    }
    TBool =>
      if method_name == "to_string" {
        let res_slot = qbe_alloc_slot(g)
        let l_t = qbe_lbl(g, "bstr_t")
        let l_f = qbe_lbl(g, "bstr_f")
        let l_e = qbe_lbl(g, "bstr_e")
        qbe_emit_term(g, "jnz " + obj_val + ", " + l_t + ", " + l_f)
        qbe_emit_lbl(g, l_t)
        let st = qbe_emit_string_lit(g, "true")
        qbe_emit(g, "storel " + st + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_e)
        qbe_emit_lbl(g, l_f)
        let sf = qbe_emit_string_lit(g, "false")
        qbe_emit(g, "storel " + sf + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_e)
        qbe_emit_lbl(g, l_e)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TString)
      }
    TChar => {
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
      if method_name == "to_string" {
        let sb = qbe_tmp(g)
        let cw = qbe_tmp(g)
        let s = qbe_tmp(g)
        qbe_emit(g, sb + " =l call $pion_strbuf_new(l 4)")
        qbe_emit(g, cw + " =w copy " + obj_val)
        qbe_emit(g, "call $pion_strbuf_push_char(l " + sb + ", w " + cw + ")")
        qbe_emit(g, s + " =l call $pion_strbuf_to_str(l " + sb + ")")
        qbe_emit(g, "call $pion_rc_dec(l " + sb + ")")
        return qval(s, TString)
      }
    }
    TByte =>
      if method_name == "to_int" {
        let w = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + obj_val)
        return qval(w, TInt)
      }
    TOption(inner) => {
      if method_name == "is_some" || method_name == "is_none" {
        return qbe_emit_tag_test(
          g,
          obj_val,
          obj_borrowed,
          TOption(inner),
          if method_name == "is_some" { "cnel" } else { "ceql" },
        )
      }
      if method_name == "unwrap_or" {
        return qbe_emit_unwrap_or(g, obj_val, obj_borrowed, recv_ty, 1, inner, args[0])
      }
    }
    TResult(ok_ty, _) => {
      if method_name == "is_ok" || method_name == "is_err" {
        return qbe_emit_tag_test(
          g,
          obj_val,
          obj_borrowed,
          recv_ty,
          if method_name == "is_ok" { "ceql" } else { "cnel" },
        )
      }
      if method_name == "unwrap_or" {
        return qbe_emit_unwrap_or(g, obj_val, obj_borrowed, recv_ty, 0, ok_ty, args[0])
      }
    }
    TString => {
      if method_name == "to_int" ||
        method_name == "to_int64" ||
        method_name == "to_double" {
        return qbe_emit_str_parse(g, obj_val, obj_borrowed, method_name)
      }
      if method_name == "length" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l loadl " + obj_val)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
      if method_name == "to_string" {
        return qval(obj_val, TString)
      }
      if method_name == "code_unit_at" {
        let str_lname = match obj_expr {
          EIdent(n, _) => n
          EField(EIdent(vn, _), fnm, _) => vn + "." + fnm
          _ => ""
        }
        let bw = qbe_emit_str_code_unit_at(g, obj_val, args[0], str_lname)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(bw, TInt)
      }
      if method_name == "slice" {
        let a = qbe_emit_expr(g, args[0], Some(TInt))
        let b = qbe_emit_expr(g, args[1], Some(TInt))
        let al = qbe_as_l(g, a)
        let bl = qbe_as_l(g, b)
        let r = qbe_tmp(g)
        qbe_emit(
          g,
          r + " =l call $pion_str_slice(l " + obj_val + ", l " + al + ", l " + bl + ")",
        )
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TString)
      }
      if method_name == "starts_with" {
        let pa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), args_pure)
        let pv = pa.qv
        let rw = qbe_tmp(g)
        qbe_emit(g, rw + " =w call $pion_str_starts_with(l " + obj_val + ", l " + pv.reg + ")")
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l extuw " + rw)
        if !pa.borrowed {
          qbe_rc_dec(g, pv.reg, pv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TBool)
      }
      if method_name == "ends_with" {
        let pa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), args_pure)
        let pv = pa.qv
        let rw = qbe_tmp(g)
        qbe_emit(g, rw + " =w call $pion_str_ends_with(l " + obj_val + ", l " + pv.reg + ")")
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l extuw " + rw)
        if !pa.borrowed {
          qbe_rc_dec(g, pv.reg, pv.ty)
        }
