        let v_exits = qbe_expr_may_early_exit(g, args[1])
        let k_guards = QbeArgGuards::{ exits: [v_exits], slots: [], stores: [] }
        qbe_guard_val(g, k_guards, ka, false, v_exits)
        let va = qbe_emit_arg_maybe_borrow_ext(
          g,
          args[1],
          Some(vty),
          args_pure,
          args_pure && qbe_loop_has_no_calls_expr(g, args[1]),
        )
        qbe_release_guards(g, k_guards)
        if g.block_term {
