      if method_name == "contains" {
        let ka = qbe_emit_arg_maybe_borrow_ext(
          g,
          args[0],
          Some(kty),
          args_pure,
          args_pure && qbe_loop_has_no_calls_expr(g, args[0]),
        )
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        let hw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, hw + " =w call $pion_map_has(l " + obj_val + ", l " + kl + ")")
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, r + " =l extuw " + hw)
        return qval(r, TBool)
      }
      if method_name == "remove" {
        let ka = qbe_emit_arg_maybe_borrow_ext(
          g,
          args[0],
          Some(kty),
          args_pure,
          args_pure && qbe_loop_has_no_calls_expr(g, args[0]),
        )
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        qbe_emit(g, "call $pion_map_remove(l " + obj_val + ", l " + kl + ")")
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "get" {
        let ka = qbe_emit_arg_maybe_borrow_ext(
          g,
          args[0],
          Some(kty),
          args_pure,
          args_pure && qbe_loop_has_no_calls_expr(g, args[0]),
        )
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        let out_slot = qbe_alloc_slot(g)
        let hw = qbe_tmp(g)
        qbe_emit(
          g,
          hw +
          " =w call $pion_map_try_get(l " +
          obj_val +
          ", l " +
          kl +
          ", l " +
          out_slot +
          ")",
        )
        let res_slot = qbe_alloc_slot(g)
        let l_hit = qbe_lbl(g, "mget_hit")
        let l_miss = qbe_lbl(g, "mget_miss")
        let l_end = qbe_lbl(g, "mget_end")
        qbe_emit_term(g, "jnz " + hw + ", " + l_hit + ", " + l_miss)
        qbe_emit_lbl(g, l_hit)
        let mv = qbe_tmp(g)
        qbe_emit(g, mv + " =l loadl " + out_slot)
        qbe_rc_inc(g, mv, vty)
        let some_obj = qbe_emit_some(g, mv, vty)
        qbe_emit(g, "storel " + some_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_miss)
        let none_obj = qbe_emit_none(g, vty)
        qbe_emit(g, "storel " + none_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TOption(vty))
      }
      if method_name == "copy" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_map_copy(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TMap(kty, vty))
      }
      if method_name == "keys" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_map_keys(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TArray(kty))
      }
      if method_name == "clear" {
        qbe_emit(g, "call $pion_map_clear(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TChannel(elem) => {
      if method_name == "send" {
        let va = qbe_emit_arg_maybe_borrow(g, args[0], Some(elem), args_pure)
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        // Native Channel.send freezes every object before publication. Strings
        // have no reference fields requiring a generated deep traversal.
        match elem {
          TString => if g.target_wasm { qbe_emit_deep_freeze(g, vl, elem) }
          _ => qbe_emit_deep_freeze(g, vl, elem)
        }
        let rw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, rw + " =w call $pion_chan_send(l " + obj_val + ", l " + vl + ")")
        if !va.borrowed {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, r + " =l extuw " + rw)
        return qval(r, TBool)
      }
      if method_name == "recv" {
        let out_slot = qbe_alloc_slot(g)
        let ok_w = qbe_tmp(g)
        qbe_emit(
          g,
          ok_w + " =w call $pion_chan_recv(l " + obj_val + ", l " + out_slot + ")",
        )
        let res_slot = qbe_alloc_slot(g)
        let l_some = qbe_lbl(g, "crecv_some")
        let l_none = qbe_lbl(g, "crecv_none")
        let l_end = qbe_lbl(g, "crecv_end")
        qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
        qbe_emit_lbl(g, l_some)
        let rv = qbe_tmp(g)
        qbe_emit(g, rv + " =l loadl " + out_slot)
        let some_obj = qbe_emit_some(g, rv, elem)
        qbe_emit(g, "storel " + some_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_none)
        let none_obj = qbe_emit_none(g, elem)
        qbe_emit(g, "storel " + none_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TOption(elem))
      }
      if method_name == "close" {
        qbe_emit(g, "call $pion_chan_close(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TMutex(elem) => {
      if method_name == "lock" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_mutex_lock(l " + obj_val + ")")
        qbe_rc_inc(g, r, elem)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(qbe_from_l(g, r, elem), elem)
      }
      if method_name == "set" {
        let va = qbe_emit_arg_maybe_borrow(g, args[0], Some(elem), args_pure)
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        qbe_emit_deep_freeze(g, vl, elem)
        qbe_emit(g, "call $pion_mutex_set(l " + obj_val + ", l " + vl + ")")
        if !va.borrowed {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "unlock" {
        qbe_emit(g, "call $pion_mutex_unlock(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "with_lock" {
        let fv = qbe_emit_expr(g, args[0], Some(TFn([elem], TError)))
        let cur_v = qbe_tmp(g)
        qbe_emit(g, cur_v + " =l call $pion_mutex_lock(l " + obj_val + ")")
        qbe_rc_inc(g, cur_v, elem)
        let cur_typed = qbe_from_l(g, cur_v, elem)
        let r = qbe_emit_closure_call(g, fv.reg, [cur_typed], [elem])
        qbe_emit(g, "call $pion_mutex_unlock(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let rty = match fv.ty {
          TFn(_, rt) => rt
          _ =>
            match expected {
              Some(t) => t
              None => TUnit
            }
        }
        return qval(qbe_from_l(g, r, rty), rty)
      }
    }
    TAtomicInt => {
      if method_name == "load" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l call $pion_atomic_load(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
      if method_name == "store" {
        let vv = qbe_emit_expr(g, args[0], Some(TInt))
        let vl = qbe_as_l(g, vv)
        qbe_emit(g, "call $pion_atomic_store(l " + obj_val + ", l " + vl + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "fetch_add" {
        let dv = qbe_emit_expr(g, args[0], Some(TInt))
        let dl = qbe_as_l(g, dv)
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(
          g,
          r64 + " =l call $pion_atomic_fetch_add(l " + obj_val + ", l " + dl + ")",
        )
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
    }
    TStruct(sname, sargs) | TEnum(sname, sargs) => {
      match qbe_lookup_method_info_with_pkg(g, sname, method_name) {
        Some((minfo, mpkg)) => {
          let call_res = resolve_call_args_qbe_full(
            minfo.decl.params,
            1,
            args,
            span_new("", 0, 0),
          )
          let norm_args = call_res.args
          let from_default = call_res.from_default
          let norm_pure = !qbe_args_may_mutate_locals(g, norm_args)
          let subst : Map[String, Ty] = Map([])
          if minfo.param_tys.length() > 0 {
            qbe_unify_tparams(g, minfo.param_tys[0], recv_ty, subst)
          }
          match expected {
            Some(et) => qbe_unify_tparams(g, minfo.ret_ty, et, subst)
            None => ()
          }
          let arg_vals : Array[String] = [obj_val]
          let arg_tys : Array[Ty] = [recv_ty]
          let arg_borrowed : Array[Bool] = [obj_borrowed]
          let order = qbe_call_eval_order(minfo.decl.params, 1, args, norm_args.length())
          qbe_preunify_reordered_args(g, minfo, 1, norm_args, order, subst, sp)
          qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length() + 1)
          let guards = qbe_arg_guards(g, norm_args, order)
          qbe_guard_val(g, guards, QbeArgVal::{ qv: qval(arg_vals[0], arg_tys[0]), borrowed: arg_borrowed[0] }, recv_wbs.length() > 0, qbe_guards_exit_before_order(g, guards, norm_args, order))
          let mut oi = 0
          while oi < order.length() {
            let i = order[oi]
            let p_idx = i + 1
            let exp_p : Option[Ty] = if p_idx < minfo.param_tys.length() {
              qbe_generic_arg_expect(
                g,
                minfo,
                mpkg,
                subst_ty_mask_unbound(minfo.param_tys[p_idx], minfo.decl.type_params, subst),
                norm_args[i],
              )
            } else {
              None
            }
            let aa = if i < from_default.length() && from_default[i] {
              qbe_emit_default_call_arg(
                g,
                minfo.decl.params,
                minfo.param_tys,
                minfo.decl.type_params,
                p_idx,
                norm_args[i],
                exp_p,
                arg_vals,
                arg_tys,
                subst,
                mpkg,
              )
            } else {
              qbe_emit_call_arg(
                g,
                minfo.decl.params,
                p_idx,
                norm_args[i],
                exp_p,
                norm_pure,
                recv_wbs,
                norm_args,
              )
            }
            let av = aa.qv
            if p_idx < minfo.param_tys.length() {
              qbe_unify_tparams(g, minfo.param_tys[p_idx], av.ty, subst)
            }
            arg_vals[i + 1] = av.reg
            arg_tys[i + 1] = av.ty
            arg_borrowed[i + 1] = aa.borrowed
            qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i + 1, norm_args[i]), guards.exits[oi])
            oi = oi + 1
          }
          qbe_release_guards(g, guards)
          if qbe_call_needs_mono(g, minfo, subst, mpkg) {
            let mres = qbe_emit_mono_call(
              g,
              qbe_method_call_sym(g, sname, method_name),
              minfo,
              subst,
              arg_vals,
              arg_tys,
              arg_borrowed,
              mpkg,
            )
            qbe_emit_mut_writebacks(g, recv_wbs)
            return mres
          }
          if mpkg == "" && !has_qual_sep(sname) {
            match qbe_try_inline_fn_call(
              g,
              sname + "::" + method_name,
              minfo,
              arg_vals,
              arg_tys,
              arg_borrowed,
            ) {
              Some(qv) => return qv
              None => ()
            }
          } else if mpkg != "" && recv_wbs.length() == 0 {
            match qbe_try_inline_xpkg_fn_call(
              g,
              mpkg,
              sname + "::" + method_name,
              minfo,
              arg_vals,
              arg_tys,
              arg_borrowed,
            ) {
              Some(qv) => return qv
              None => ()
            }
          }
          let call_args : Array[String] = []
          let call_abis : Array[String] = []
          let mut j = 0
          while j < arg_vals.length() {
            let decl_pty = if j < minfo.param_tys.length() {
              minfo.param_tys[j]
            } else {
              arg_tys[j]
            }
            if qbe_param_is_mut(minfo.decl.params, j) {
              call_args.push(arg_vals[j])
              call_abis.push("l")
            } else {
              call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
              call_abis.push(qbe_abi_ty(decl_pty))
            }
            j = j + 1
          }
          let ret_abi = qbe_abi_ty(minfo.ret_ty)
          let res = qbe_tmp(g)
          let sb = StringBuilder()
          sb.write_string(res)
          sb.write_string(" =")
          sb.write_string(ret_abi)
          sb.write_string(" call ")
          sb.write_string(qbe_method_call_sym(g, sname, method_name))
          sb.write_string("(")
          j = 0
          while j < call_args.length() {
            if j > 0 {
              sb.write_string(", ")
            }
            sb.write_string(call_abis[j])
            sb.write_string(" ")
            sb.write_string(call_args[j])
            j = j + 1
          }
          let mut tpi = 0
          while tpi < minfo.decl.type_params.length() {
            if call_args.length() > 0 || tpi > 0 {
              sb.write_string(", ")
            }
            let tp_ty = match subst.get(minfo.decl.type_params[tpi]) {
              Some(t) => t
              None => TError
            }
            sb.write_string("l ")
            sb.write_string(qbe_is_obj_flag(g, tp_ty))
            tpi = tpi + 1
          }
          sb.write_string(")")
          qbe_emit(g, sb.to_string())
          j = 0
          while j < arg_vals.length() {
            if !arg_borrowed[j] {
              qbe_rc_dec(g, arg_vals[j], arg_tys[j])
            }
            j = j + 1
          }
          qbe_emit_mut_writebacks(g, recv_wbs)
          let concrete_ret = subst_ty(minfo.ret_ty, subst)
          let final_res = qbe_coerce_val(g, qval(res, minfo.ret_ty), concrete_ret)
          return qval(final_res, concrete_ret)
        }
        None =>
          // Fallback: callable function-typed struct field (`d.refresh()`, `d.set_dpi(v, lod)`)
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut fi = 0
              while fi < sinfo.field_names.length() {
                if sinfo.field_names[fi] == method_name {
                  let fty = subst_ty(sinfo.field_tys[fi], subst)
                  match fty {
                    TFn(ptys, rty) => {
                      let fp = qbe_tmp(g)
                      let clo_v = qbe_tmp(g)
                      qbe_emit(g, fp + " =l add " + obj_val + ", " + (fi * 8).to_string())
                      qbe_emit(g, clo_v + " =l loadl " + fp)
                      qbe_emit(g, "call $pion_rc_inc(l " + clo_v + ")")
                      if !obj_borrowed {
                        qbe_rc_dec(g, obj_val, recv_ty)
                      }
                      let guards = qbe_arg_guards_in_order(g, args)
                      qbe_guard_callee(g, guards, args, qval(clo_v, fty), false)
                      let arg_vals : Array[String] = []
                      let arg_tys : Array[Ty] = []
                      let mut ai = 0
                      while ai < args.length() {
                        let ep : Option[Ty] = if ai < ptys.length() {
                          Some(ptys[ai])
                        } else {
                          None
                        }
                        let av = qbe_emit_expr(g, args[ai], ep)
                        let cty = if ai < ptys.length() { ptys[ai] } else { av.ty }
                        let creg = qbe_coerce_val(g, av, cty)
                        arg_vals.push(creg)
                        arg_tys.push(cty)
                        qbe_guard_val(
                          g,
                          guards,
                          QbeArgVal::{ qv: qval(creg, cty), borrowed: false },
                          false,
                          guards.exits[ai],
                        )
                        ai = ai + 1
                      }
                      qbe_release_guards(g, guards)
                      let res_l = qbe_emit_closure_call(g, clo_v, arg_vals, arg_tys)
                      return qval(qbe_from_l(g, res_l, rty), rty)
                    }
                    _ => ()
                  }
                  break
                }
                fi = fi + 1
              }
            }
            None => ()
          }
      }
    }
    TDynTrait(tname) =>
      match lookup_trait_canonical(g.tc, tname) {
        Some(tinfo) => {
          let mut mi = 0
          while mi < tinfo.methods.length() {
            let tm = tinfo.methods[mi]
            if tm.name == method_name {
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let guards = qbe_arg_guards_in_order(g, args)
              qbe_guard_callee(g, guards, args, qval(obj_val, recv_ty), obj_borrowed)
              let mut i = 0
              while i < args.length() {
                let p_idx = i + 1
                let exp_p : Option[Ty] = if p_idx < tm.param_tys.length() {
                  Some(tm.param_tys[p_idx])
                } else {
                  None
                }
                let aa = qbe_emit_arg_maybe_borrow(g, args[i], exp_p, args_pure)
                arg_vals.push(aa.qv.reg)
                arg_tys.push(aa.qv.ty)
                arg_borrowed.push(aa.borrowed)
                qbe_guard_val(g, guards, aa, false, guards.exits[i])
                i = i + 1
              }
              qbe_release_guards(g, guards)
              let data_r = qbe_tmp(g)
              let vp_r = qbe_tmp(g)
              let vt_r = qbe_tmp(g)
              let fpa_r = qbe_tmp(g)
              let fp_r = qbe_tmp(g)
              let slot_off = (2 + mi) * 8
              qbe_emit(g, data_r + " =l loadl " + obj_val)
              qbe_emit(g, vp_r + " =l add " + obj_val + ", 8")
              qbe_emit(g, vt_r + " =l loadl " + vp_r)
              qbe_emit(g, fpa_r + " =l add " + vt_r + ", " + slot_off.to_string())
              qbe_emit(g, fp_r + " =l loadl " + fpa_r)
              let ret_abi = qbe_abi_ty(tm.ret_ty)
              let res = qbe_tmp(g)
              let sb = StringBuilder()
              sb.write_string(res)
              sb.write_string(" =")
              sb.write_string(ret_abi)
              sb.write_string(" call ")
              sb.write_string(fp_r)
              sb.write_string("(l ")
              sb.write_string(data_r)
              let mut j = 0
              while j < arg_vals.length() {
                let p_idx = j + 1
                let decl_pty = if p_idx < tm.param_tys.length() {
                  tm.param_tys[p_idx]
                } else {
                  arg_tys[j]
                }
                let coerced = qbe_coerce_val(
                  g,
                  qval(arg_vals[j], arg_tys[j]),
                  decl_pty,
                )
                sb.write_string(", ")
                sb.write_string(qbe_abi_ty(decl_pty))
                sb.write_string(" ")
                sb.write_string(coerced)
                j = j + 1
              }
              sb.write_string(")")
              qbe_emit(g, sb.to_string())
              j = 0
              while j < arg_vals.length() {
                if !arg_borrowed[j] {
                  qbe_rc_dec(g, arg_vals[j], arg_tys[j])
                }
                j = j + 1
              }
              if !obj_borrowed {
                qbe_rc_dec(g, obj_val, recv_ty)
              }
              return qval(res, tm.ret_ty)
            }
            mi = mi + 1
          }
        }
        None => ()
      }
    _ => ()
  }
  match qbe_find_impl_method(g, recv_ty, method_name, expected_trait) {
    Some(imatch) =>
      return qbe_emit_impl_method_call(
        g,
        obj_val,
        recv_ty,
        obj_borrowed,
        recv_wbs,
        imatch,
        args,
      )
    None => ()
  }
  if !obj_borrowed {
    qbe_rc_dec(g, obj_val, recv_ty)
  }
  match recv_ty {
    TError => qval("0", TError)
    _ => qbe_fail_unresolved(g, "method_call", ty_to_string(recv_ty), method_name, sp)
  }
}

///|
fn qbe_resolve_pat_const_sym(
  g : QbeGen,
  pat_enum : String,
  vname : String,
  subs : Array[Pattern],
  explicit_ctor : Bool,
  sp : Span,
  scrut_ty : Ty,
) -> Option[(String, Option[Expr], Ty)] {
  if explicit_ctor || subs.length() > 0 {
    return None
  }
  if starts_with_str(pat_enum, "@canon:") {
    let owner_pkg = slice_str(pat_enum, 7, pat_enum.length())
    if owner_pkg == g.tc.pkg_name {
      return match g.tc.consts.get(vname) {
        Some(cty) => Some((qbe_local_const_sym(g, vname), None, cty))
        None => None
      }
    }
    return match lookup_imported_pkg_transitive(g.tc, owner_pkg) {
      Some(ipkg) =>
        match ipkg.tc.consts.get(vname) {
          Some(cty) =>
            Some((
              qbe_ext_const_sym(ipkg.name, vname),
              ipkg.tc.scalar_const_exprs.get(vname),
              qualify_imported_ty(ipkg.name, cty),
            ))
          None => None
        }
      None => None
    }
  }
  let key = "pat_const:" + span_key(sp)
  if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) => {
        match ipkg.tc.resolved_method_calls.get(key) {
          Some(ckey) =>
            if has_qual_sep(ckey) {
              let qp = split_qual_name(ckey)
              if qp.prefix == g.tc.pkg_name {
                return match g.tc.consts.get(qp.name) {
                  Some(cty) => Some((qbe_local_const_sym(g, qp.name), None, cty))
                  None => None
                }
              }
              return match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
                Some(cpkg) =>
                  match cpkg.tc.consts.get(qp.name) {
                    Some(cty) =>
                      Some((
                        qbe_ext_const_sym(cpkg.name, qp.name),
                        cpkg.tc.scalar_const_exprs.get(qp.name),
                        qualify_imported_ty(cpkg.name, cty),
                      ))
                    None => None
                  }
                None => None
              }
            } else {
              return match ipkg.tc.consts.get(ckey) {
                Some(cty) =>
                  Some((
                    qbe_ext_const_sym(ipkg.name, ckey),
                    ipkg.tc.scalar_const_exprs.get(ckey),
                    qualify_imported_ty(ipkg.name, cty),
                  ))
                None => None
              }
            }
          None => ()
        }
        let is_enum_like = match subst_ty(scrut_ty, g.cur_type_subst) {
          TOption(_) | TResult(_, _) | TEnum(_, _) => true
          _ => false
        }
        if !is_enum_like {
          if pat_enum == "" {
            return match ipkg.tc.consts.get(vname) {
              Some(cty) =>
                Some((
                  qbe_ext_const_sym(ipkg.name, vname),
                  ipkg.tc.scalar_const_exprs.get(vname),
                  qualify_imported_ty(ipkg.name, cty),
                ))
              None => None
            }
          } else if !has_qual_sep(pat_enum) {
            return match resolve_pkg_for_lookup(ipkg.tc, pat_enum, false) {
              Some(cpkg) =>
                match cpkg.tc.consts.get(vname) {
                  Some(cty) =>
                    Some((
                      qbe_ext_const_sym(cpkg.name, vname),
                      cpkg.tc.scalar_const_exprs.get(vname),
                      qualify_imported_ty(cpkg.name, cty),
                    ))
                  None => None
                }
              None => None
            }
          }
        }
        return None
      }
      None => return None
    }
  }
  match g.tc.resolved_method_calls.get(key) {
    Some(ckey) =>
      if has_qual_sep(ckey) {
        let qp = split_qual_name(ckey)
        return match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
          Some(cpkg) =>
            match cpkg.tc.consts.get(qp.name) {
              Some(cty) =>
                Some((
                  qbe_ext_const_sym(cpkg.name, qp.name),
                  cpkg.tc.scalar_const_exprs.get(qp.name),
                  qualify_imported_ty(cpkg.name, cty),
                ))
              None => None
            }
          None => None
        }
      } else {
        return match g.tc.consts.get(ckey) {
          Some(cty) => Some((qbe_local_const_sym(g, ckey), None, cty))
          None => None
        }
      }
    None => ()
  }
  let is_enum_like = match subst_ty(scrut_ty, g.cur_type_subst) {
    TOption(_) | TResult(_, _) | TEnum(_, _) => true
    _ => false
  }
  if !is_enum_like {
    if pat_enum == "" {
      return match g.tc.consts.get(vname) {
        Some(cty) => Some((qbe_local_const_sym(g, vname), None, cty))
        None => None
      }
    } else if !has_qual_sep(pat_enum) {
      return match resolve_pkg_for_lookup(g.tc, pat_enum, false) {
        Some(cpkg) =>
          match cpkg.tc.consts.get(vname) {
            Some(cty) =>
              Some((
                qbe_ext_const_sym(cpkg.name, vname),
                cpkg.tc.scalar_const_exprs.get(vname),
                qualify_imported_ty(cpkg.name, cty),
              ))
            None => None
          }
        None => None
      }
    }
  }
  None
}

///|
fn qbe_emit_pat_test(
  g : QbeGen,
  pat : Pattern,
  vreg : String,
  scrut_ty : Ty,
  fail_lbl : String,
) -> Unit {
  match pat {
    PWild(_) | PIdent(_, _) => ()
    PBool(b, _) => {
      let bv = if b { "1" } else { "0" }
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      qbe_emit(g, eq + " =w ceql " + vreg + ", " + bv)
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PInt(raw, _) => {
      let iv = qbe_parse_int64_lit(raw)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      if qbe_is_int32_ty(scrut_ty) || qbe_is_uint32_ty(scrut_ty) {
        let v32 = iv.to_int().to_int64().to_string()
        qbe_emit(g, eq + " =w ceqw " + vreg + ", " + v32)
      } else {
        qbe_emit(g, eq + " =w ceql " + vreg + ", " + iv.to_string())
      }
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PChar(raw, _) => {
      let cv = qbe_parse_char_lit(raw)
      let eq = qbe_tmp(g)
      let ok_lbl = qbe_lbl(g, "pat_ok")
      qbe_emit(g, eq + " =w ceql " + vreg + ", " + cv.to_string())
      qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
      qbe_emit_lbl(g, ok_lbl)
    }
    PString(s, _) => {
      let short_opt = if g.hot_loop_depth > 0 {
        qbe_short_ascii_bytes(s)
      } else {
        None
      }
      match short_opt {
        Some(bytes) => {
          let ok_lbl = qbe_lbl(g, "pat_ok")
          qbe_emit_short_str_eq_branch(g, vreg, bytes, ok_lbl, fail_lbl)
          qbe_emit_lbl(g, ok_lbl)
        }
        None => {
          let lit = qbe_emit_string_lit(g, s)
          let eq = qbe_tmp(g)
          let ok_lbl = qbe_lbl(g, "pat_ok")
          qbe_emit(g, eq + " =w call $pion_str_eq(l " + vreg + ", l " + lit + ")")
          qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
          qbe_emit_lbl(g, ok_lbl)
        }
      }
    }
    PTuple(subs, _) =>
      match scrut_ty {
        TTuple(elems) => {
          let mut i = 0
          while i < subs.length() && i < elems.length() {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + vreg + ", " + (i * 8).to_string())
            let fv = qbe_load_heap_slot(g, p, elems[i])
            qbe_emit_pat_test(g, subs[i], fv, elems[i], fail_lbl)
            i = i + 1
          }
        }
        _ => ()
      }
    PVariant(pat_enum, vname, subs, explicit_ctor, sp) => {
      match qbe_resolve_pat_const_sym(g, pat_enum, vname, subs, explicit_ctor, sp, scrut_ty) {
        Some((csym, scalar_expr_opt, _)) => {
          let eff_ty = subst_ty(scrut_ty, g.cur_type_subst)
          let cval = match scalar_expr_opt {
            Some(ce) => qbe_coerce_val(g, qbe_emit_expr(g, ce, Some(eff_ty)), eff_ty)
            None => qbe_load_heap_slot(g, csym, eff_ty)
          }
          let ok_lbl = qbe_lbl(g, "pat_ok")
          match eff_ty {
            TString => {
              let eq = qbe_tmp(g)
              qbe_emit(g, eq + " =w call $pion_str_eq(l " + vreg + ", l " + cval + ")")
              qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            }
            TStrView => {
              let p1a = qbe_tmp(g)
              let p1 = qbe_tmp(g)
              let l1a = qbe_tmp(g)
              let l1 = qbe_tmp(g)
              let p2a = qbe_tmp(g)
              let p2 = qbe_tmp(g)
              let l2a = qbe_tmp(g)
              let l2 = qbe_tmp(g)
              qbe_emit(g, p1a + " =l add " + vreg + ", 8")
              qbe_emit(g, p1 + " =l loadl " + p1a)
              qbe_emit(g, l1a + " =l add " + vreg + ", 16")
              qbe_emit(g, l1 + " =l loadl " + l1a)
              qbe_emit(g, p2a + " =l add " + cval + ", 8")
              qbe_emit(g, p2 + " =l loadl " + p2a)
              qbe_emit(g, l2a + " =l add " + cval + ", 16")
              qbe_emit(g, l2 + " =l loadl " + l2a)
              let eq = qbe_emit_strview_eq_raw(g, p1, l1, p2, l2)
              qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            }
            TEnum(_, _) => {
              let eq = qbe_tmp(g)
              let layout = qbe_enum_layout(g, eff_ty)
              if layout.is_unit_only {
                qbe_emit(g, eq + " =w ceql " + vreg + ", " + cval)
              } else if layout.is_niche {
                let n1 = qbe_tmp(g)
                let n2 = qbe_tmp(g)
                qbe_emit(g, n1 + " =w ceql " + vreg + ", 0")
                qbe_emit(g, n2 + " =w ceql " + cval + ", 0")
                qbe_emit(g, eq + " =w ceqw " + n1 + ", " + n2)
              } else {
                let t1 = qbe_tmp(g)
                let t2 = qbe_tmp(g)
                qbe_emit(g, t1 + " =l loadl " + vreg)
                qbe_emit(g, t2 + " =l loadl " + cval)
                qbe_emit(g, eq + " =w ceql " + t1 + ", " + t2)
              }
              qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            }
            _ => {
              let eq = qbe_tmp(g)
              if qbe_is_int32_ty(eff_ty) || qbe_is_uint32_ty(eff_ty) {
                qbe_emit(g, eq + " =w ceqw " + vreg + ", " + cval)
              } else {
                qbe_emit(g, eq + " =w ceql " + vreg + ", " + cval)
              }
              qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            }
          }
          qbe_emit_lbl(g, ok_lbl)
          return
        }
        None => ()
      }
      match scrut_ty {
        TOption(inner) =>
          if qbe_is_niche_opt_inner(g, inner) {
            let eq = qbe_tmp(g)
            let ok_lbl = qbe_lbl(g, "tag_ok")
            if vname == "None" {
              qbe_emit(g, eq + " =w ceql " + vreg + ", 0")
            } else {
              qbe_emit(g, eq + " =w cnel " + vreg + ", 0")
            }
            qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
            qbe_emit_lbl(g, ok_lbl)
            if vname == "Some" && subs.length() >= 1 {
              qbe_emit_pat_test(g, subs[0], vreg, inner, fail_lbl)
            }
            return
          }
        _ => ()
      }
      let mut tag = 0
      let field_tys : Array[Ty] = []
      match scrut_ty {
        TOption(inner) =>
          if vname == "None" {
            tag = 0
          } else {
            tag = 1
            field_tys.push(inner)
          }
        TResult(ok, err) =>
          if vname == "Ok" {
            tag = 0
            field_tys.push(ok)
          } else {
            tag = 1
            field_tys.push(err)
          }
        TEnum(ename, eargs) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  tag = vi
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let layout = qbe_enum_layout(g, scrut_ty)
      if layout.is_unit_only {
        let eq = qbe_tmp(g)
        let ok_lbl = qbe_lbl(g, "tag_ok")
        qbe_emit(g, eq + " =w ceql " + vreg + ", " + (tag + 1).to_string())
        qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
        qbe_emit_lbl(g, ok_lbl)
        return
      }
      if layout.is_niche {
        let eq = qbe_tmp(g)
        let ok_lbl = qbe_lbl(g, "tag_ok")
        if tag == layout.null_tag {
          qbe_emit(g, eq + " =w ceql " + vreg + ", 0")
        } else {
          qbe_emit(g, eq + " =w cnel " + vreg + ", 0")
        }
        qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
        qbe_emit_lbl(g, ok_lbl)
      } else {
        let actual_tag = qbe_tmp(g)
        let eq = qbe_tmp(g)
        let ok_lbl = qbe_lbl(g, "tag_ok")
        qbe_emit(g, actual_tag + " =l loadl " + vreg)
        qbe_emit(g, eq + " =w ceql " + actual_tag + ", " + tag.to_string())
        qbe_emit_term(g, "jnz " + eq + ", " + ok_lbl + ", " + fail_lbl)
        qbe_emit_lbl(g, ok_lbl)
      }
      let mut fi = 0
      while fi < subs.length() && fi < field_tys.length() {
        let off = layout.payload_offset + fi * 8
        let p = if off == 0 {
          vreg
        } else {
          let pt = qbe_tmp(g)
          qbe_emit(g, pt + " =l add " + vreg + ", " + off.to_string())
          pt
        }
        let fv = qbe_load_heap_slot(g, p, field_tys[fi])
        qbe_emit_pat_test(g, subs[fi], fv, field_tys[fi], fail_lbl)
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_span_eq(a : Span, b : Span) -> Bool {
  a.line > 0 && a.line == b.line && a.col == b.col && a.file == b.file
}

///|
fn qbe_pat_has_binds(pat : Pattern) -> Bool {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => false
    PIdent(name, _) => name != "_"
    PVariant(_, _, subs, _, _) | PTuple(subs, _) => {
      let mut i = 0
      while i < subs.length() {
        if qbe_pat_has_binds(subs[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn qbe_arm_is_irrefutable(arm : MatchArm) -> Bool {
  match arm.guard_expr {
    Some(_) => return false
    None => ()
  }
  match arm.pat {
    PWild(_) | PIdent(_, _) => true
    _ => false
  }
}

///|
fn qbe_arm_can_share(a : MatchArm, b : MatchArm) -> Bool {
  if !qbe_span_eq(a.span, b.span) {
    return false
  }
  match a.guard_expr {
    Some(_) => return false
    None => ()
  }
  match b.guard_expr {
    Some(_) => return false
    None => ()
  }
  !qbe_pat_has_binds(a.pat) && !qbe_pat_has_binds(b.pat)
}

///|
fn qbe_emit_pat_bind(
  g : QbeGen,
  pat : Pattern,
  vreg : String,
  scrut_ty : Ty,
  allow_borrow : Bool,
  arm_body : Expr,
) -> Unit {
  if !qbe_pat_has_binds(pat) {
    return
  }
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
    PIdent(name, _) => {
      let borrow_this = allow_borrow &&
        qbe_is_obj_ty(g, scrut_ty) &&
        qbe_ident_is_borrow_safe_expr(g, arm_body, name)
      if !borrow_this {
        qbe_rc_inc(g, vreg, scrut_ty)
      }
      let loc = qbe_define_local(g, name, scrut_ty, !borrow_this)
      qbe_store_local_slot(g, vreg, loc.slot, scrut_ty)
    }
    PTuple(subs, _) =>
      match scrut_ty {
        TTuple(elems) => {
          let mut i = 0
          while i < subs.length() && i < elems.length() {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + vreg + ", " + (i * 8).to_string())
            let fv = qbe_load_heap_slot(g, p, elems[i])
            qbe_emit_pat_bind(g, subs[i], fv, elems[i], allow_borrow, arm_body)
            i = i + 1
          }
        }
        _ => ()
      }
    PVariant(_, vname, subs, _, _) => {
      match scrut_ty {
        TOption(inner) =>
          if qbe_is_niche_opt_inner(g, inner) {
            if vname == "Some" && subs.length() >= 1 {
              qbe_emit_pat_bind(g, subs[0], vreg, inner, allow_borrow, arm_body)
            }
            return
          }
        _ => ()
      }
      let field_tys : Array[Ty] = []
      match scrut_ty {
        TOption(inner) =>
          if vname == "Some" {
            field_tys.push(inner)
          }
        TResult(ok, err) =>
          if vname == "Ok" {
            field_tys.push(ok)
          } else {
            field_tys.push(err)
          }
        TEnum(ename, eargs) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let payload_offset = qbe_enum_layout(g, scrut_ty).payload_offset
      let mut fi = 0
      while fi < subs.length() && fi < field_tys.length() {
        if qbe_pat_has_binds(subs[fi]) {
          let off = payload_offset + fi * 8
          let p = if off == 0 {
            vreg
          } else {
            let pt = qbe_tmp(g)
            qbe_emit(g, pt + " =l add " + vreg + ", " + off.to_string())
            pt
          }
          let fv = qbe_load_heap_slot(g, p, field_tys[fi])
          qbe_emit_pat_bind(g, subs[fi], fv, field_tys[fi], allow_borrow, arm_body)
        }
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_expr_has_is(e : Expr) -> Bool {
  let work : Array[Expr] = [e]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EIs(_, _, _) => return true
          EBinary("&&", lhs, rhs, _) => {
            work.push(rhs)
            work.push(lhs)
          }
          _ => ()
        }
      None => break
    }
  }
  false
}

///|
fn qbe_release_scope_locals_range(
  g : QbeGen,
  start_idx : Int,
  end_idx : Int,
) -> Unit {
  if g.scopes.length() == 0 {
    return
  }
  let sc = g.scopes[g.scopes.length() - 1]
  let mut i = end_idx - 1
  if i >= sc.locals.length() {
    i = sc.locals.length() - 1
  }
  while i >= start_idx {
    let loc = sc.locals[i]
    if loc.ref_slot != "" {
      if !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
        qbe_writeback_ref_local(g, loc)
      }
    } else if loc.owned && !g.zeroed_slots.contains(loc.slot) && !g.moved_slots.contains(loc.slot) {
      match loc.ty {
        TParam(_) => {
          let v = qbe_tmp(g)
          qbe_emit(g, v + " =l loadl " + loc.slot)
          qbe_rc_dec(g, v, loc.ty)
        }
        _ =>
          if qbe_is_obj_ty(g, loc.ty) {
            let v = qbe_tmp(g)
            qbe_emit(g, v + " =l loadl " + loc.slot)
            qbe_rc_dec(g, v, loc.ty)
          }
      }
    }
    i = i - 1
  }
}

///|
fn qbe_release_scope_locals_from(g : QbeGen, start_idx : Int) -> Unit {
  if g.scopes.length() == 0 {
    return
  }
  let sc = g.scopes[g.scopes.length() - 1]
  qbe_release_scope_locals_range(g, start_idx, sc.locals.length())
}

///|
fn qbe_emit_cond_branch_bind(
  g : QbeGen,
  cond : Expr,
  l_true : String,
  l_false : String,
  then_stmts_opt : Option[Array[Stmt]],
) -> Unit {
  // Iteratively flatten `&&` trees left-to-right so arbitrarily deep `&&` chains
  // with `is` bindings never overflow the compiler's native stack.
  let terms : Array[Expr] = []
  let work : Array[Expr] = [cond]
  while work.length() > 0 {
    match work.pop() {
      Some(cur) =>
        match cur {
          EBinary("&&", lhs, rhs, _) => {
            work.push(rhs)
            work.push(lhs)
          }
          _ => terms.push(cur)
        }
      None => break
    }
  }
  let sc = g.scopes[g.scopes.length() - 1]
  let mut has_any_dp = false
  let mut dti = 0
  while dti < terms.length() {
    if qbe_expr_has_any_data_ptr(terms[dti]) {
      has_any_dp = true
      break
    }
    dti = dti + 1
  }
  let cl_lbl : Array[String] = []
  let cl_prev : Array[String] = []
  let cl_start : Array[Int] = []
  let cl_end : Array[Int] = []
  let cl_pinned : Array[Array[String]] = []
  let mut cur_fail = l_false
  let n_terms = terms.length()
  let mut ti = 0
  while ti < n_terms {
    let is_last = ti == n_terms - 1
    let next_true = if is_last { l_true } else { qbe_lbl(g, "and_r") }
    let term_then_opt = if is_last { then_stmts_opt } else { None }
    let before_term = sc.locals.length()
    match terms[ti] {
      EIs(scrut, pat, sp) => {
        let pod_bind_ok = match qbe_parse_scalar_is_pat(pat) {
          Some(sip) =>
            if sip.bind_name == "" {
              true
            } else {
              match term_then_opt {
                Some(ts) => qbe_ident_is_flat_field_only_stmts(ts, 0, sip.bind_name)
                None => false
              }
            }
          None => false
        }
        if !qbe_try_emit_scalar_is_branch(g, scrut, pat, next_true, cur_fail, pod_bind_ok) {
          let sv = qbe_emit_expr(g, scrut, None)
          let l_pfail = qbe_lbl(g, "is_f")
          qbe_emit_pat_test(g, pat, sv.reg, sv.ty, l_pfail)
          qbe_emit_pat_bind(g, pat, sv.reg, sv.ty, false, EUnit(sp))
          qbe_rc_dec(g, sv.reg, sv.ty)
          qbe_emit_term(g, "jmp " + next_true)
          qbe_emit_lbl(g, l_pfail)
          qbe_rc_dec(g, sv.reg, sv.ty)
          qbe_emit_term(g, "jmp " + cur_fail)
        }
      }
      leaf => qbe_emit_cond_branch(g, leaf, next_true, cur_fail)
    }
    if !is_last {
      qbe_emit_lbl(g, next_true)
      let after_term = sc.locals.length()
      if after_term > before_term {
        let seg_pinned : Array[String] = []
        if has_any_dp {
          let mut ai = before_term
          while ai < after_term {
            let aloc = sc.locals[ai]
            if aloc.owned {
              let mut need_pin = false
              let mut rj = ti + 1
              while rj < n_terms {
                if qbe_expr_takes_data_ptr(terms[rj], aloc.name) {
                  need_pin = true
                  break
                }
                rj = rj + 1
              }
              if need_pin {
                qbe_pin_slot(g, aloc.slot, seg_pinned)
              }
            }
            ai = ai + 1
          }
        }
        let l_seg_fail = qbe_lbl(g, "and_f")
        cl_lbl.push(l_seg_fail)
        cl_prev.push(cur_fail)
        cl_start.push(before_term)
        cl_end.push(after_term)
        cl_pinned.push(seg_pinned)
        cur_fail = l_seg_fail
      }
    }
    ti = ti + 1
  }
  let mut ci = cl_lbl.length() - 1
  while ci >= 0 {
    qbe_unpin_slot_list(g, cl_pinned[ci])
    qbe_emit_lbl(g, cl_lbl[ci])
    qbe_release_scope_locals_range(g, cl_start[ci], cl_end[ci])
    qbe_emit_term(g, "jmp " + cl_prev[ci])
    ci = ci - 1
  }
}

///|
fn qbe_short_ascii_bytes(s : String) -> Option[Array[Int]] {
  let n = s.length()
  if n < 0 || n > 8 {
    return None
  }
  let bytes : Array[Int] = []
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c < 0 || c >= 128 {
      return None
    }
    bytes.push(c)
    i = i + 1
  }
  Some(bytes)
}

///|
fn qbe_pack_le32_ascii(bytes : Array[Int], off : Int) -> Int64 {
  bytes[off].to_int64() +
  bytes[off + 1].to_int64() * 256L +
  bytes[off + 2].to_int64() * 65536L +
  bytes[off + 3].to_int64() * 16777216L
}

///|
fn qbe_emit_short_str_eq_branch(
  g : QbeGen,
  str_reg : String,
  bytes : Array[Int],
  l_true : String,
  l_false : String,
) -> Unit {
  let n = bytes.length()
  let l_len = qbe_lbl(g, "seq_l")
  let nz = qbe_tmp(g)
  qbe_emit(g, nz + " =w cnel " + str_reg + ", 0")
  qbe_emit_term(g, "jnz " + nz + ", " + l_len + ", " + l_false)
  qbe_emit_lbl(g, l_len)
  let len_r = qbe_tmp(g)
  let len_ok = qbe_tmp(g)
  qbe_emit(g, len_r + " =l loadl " + str_reg)
  qbe_emit(g, len_ok + " =w ceql " + len_r + ", " + n.to_string())
  if n == 0 {
    qbe_emit_term(g, "jnz " + len_ok + ", " + l_true + ", " + l_false)
    return
  }
  let l_data = qbe_lbl(g, "seq_d")
  qbe_emit_term(g, "jnz " + len_ok + ", " + l_data + ", " + l_false)
  qbe_emit_lbl(g, l_data)
  let dp = qbe_tmp(g)
  qbe_emit(g, dp + " =l add " + str_reg + ", 8")
  let eq = qbe_tmp(g)
  if n == 1 {
    let b0 = qbe_tmp(g)
    qbe_emit(g, b0 + " =w loadub " + dp)
    qbe_emit(g, eq + " =w ceqw " + b0 + ", " + bytes[0].to_string())
  } else if n == 2 {
    let w2 = qbe_tmp(g)
    let le16 = bytes[0] + bytes[1] * 256
    qbe_emit(g, w2 + " =w loaduh " + dp)
    qbe_emit(g, eq + " =w ceqw " + w2 + ", " + le16.to_string())
  } else if n == 3 {
    let w2 = qbe_tmp(g)
    let dp2 = qbe_tmp(g)
    let b2 = qbe_tmp(g)
    let x0 = qbe_tmp(g)
    let x1 = qbe_tmp(g)
    let o = qbe_tmp(g)
    let le16 = bytes[0] + bytes[1] * 256
    qbe_emit(g, w2 + " =w loaduh " + dp)
    qbe_emit(g, dp2 + " =l add " + dp + ", 2")
    qbe_emit(g, b2 + " =w loadub " + dp2)
    qbe_emit(g, x0 + " =w xor " + w2 + ", " + le16.to_string())
    qbe_emit(g, x1 + " =w xor " + b2 + ", " + bytes[2].to_string())
    qbe_emit(g, o + " =w or " + x0 + ", " + x1)
    qbe_emit(g, eq + " =w ceqw " + o + ", 0")
  } else if n == 4 {
    let w4 = qbe_tmp(g)
    let le32 = qbe_pack_le32_ascii(bytes, 0)
    qbe_emit(g, w4 + " =w loaduw " + dp)
    qbe_emit(g, eq + " =w ceqw " + w4 + ", " + le32.to_string())
  } else if n < 8 {
    let off = n - 4
    let w0 = qbe_tmp(g)
    let dp2 = qbe_tmp(g)
    let w1 = qbe_tmp(g)
    let x0 = qbe_tmp(g)
    let x1 = qbe_tmp(g)
    let o = qbe_tmp(g)
    let le32_lo = qbe_pack_le32_ascii(bytes, 0)
    let le32_hi = qbe_pack_le32_ascii(bytes, off)
    qbe_emit(g, w0 + " =w loaduw " + dp)
    qbe_emit(g, dp2 + " =l add " + dp + ", " + off.to_string())
    qbe_emit(g, w1 + " =w loaduw " + dp2)
    qbe_emit(g, x0 + " =w xor " + w0 + ", " + le32_lo.to_string())
    qbe_emit(g, x1 + " =w xor " + w1 + ", " + le32_hi.to_string())
    qbe_emit(g, o + " =w or " + x0 + ", " + x1)
    qbe_emit(g, eq + " =w ceqw " + o + ", 0")
  } else {
    let w8 = qbe_tmp(g)
    let lo = qbe_pack_le32_ascii(bytes, 0)
    let hi = qbe_pack_le32_ascii(bytes, 4)
    let le64 = lo + hi * 4294967296L
    qbe_emit(g, w8 + " =l loadl " + dp)
    qbe_emit(g, eq + " =w ceql " + w8 + ", " + le64.to_string())
  }
  qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
}

///|
fn qbe_emit_short_str_eq_val(
  g : QbeGen,
  str_reg : String,
  bytes : Array[Int],
) -> String {
  let l_t = qbe_lbl(g, "seq_t")
  let l_f = qbe_lbl(g, "seq_f")
  let l_end = qbe_lbl(g, "seq_e")
  qbe_emit_short_str_eq_branch(g, str_reg, bytes, l_t, l_f)
  qbe_emit_lbl(g, l_t)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_f)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
  let res = qbe_tmp(g)
  qbe_emit(g, res + " =w phi " + l_t + " 1, " + l_f + " 0")
  res
}

///|
/// Evaluate a constant integer expression to Int64 for strength reduction.
fn qbe_eval_const_i64_expr(g : QbeGen, e : Expr) -> Option[Int64] {
  match e {
    EInt(raw, _) => Some(qbe_parse_int64_lit(raw))
    EInt64(raw, _) => Some(qbe_parse_int64_lit(raw))
    EUInt(raw, _) => Some(qbe_parse_int64_lit(raw))
    EUInt64(raw, _) => Some(qbe_parse_int64_lit(raw))
    EIdent(name, _) =>
      if g.mono_pkg == "" {
        match qbe_lookup_local(g, name) {
          Some(_) => None
          None =>
            match g.const_int_vals.get(name) {
              Some(v) => Some(v.to_int64())
              None => None
            }
        }
      } else {
        None
      }
    _ => None
  }
}

///|
/// Parse a plain positive decimal immediate register string (e.g. "10") to Int64.
fn qbe_try_parse_pos_i64_reg(reg : String) -> Option[Int64] {
  let n = reg.length()
  if n == 0 || n > 18 {
    return None
  }
  let mut i = 0
  while i < n {
    let c = str_code_at(reg, i)
    if c < 48 || c > 57 {
      return None
    }
    i = i + 1
  }
  Some(qbe_parse_int64_lit(reg))
}

///|
fn qbe_is_zero_int_lit(g : QbeGen, e : Expr) -> Bool {
  match qbe_eval_const_i64_expr(g, e) {
    Some(v) => v == 0L
    None => false
  }
}

///|
fn qbe_pow2_log2_i64(d : Int64, max_k : Int) -> Option[Int] {
  if d < 2L || (d & (d - 1L)) != 0L {
    return None
  }
  let mut k = 0
  let mut v = d
  while v > 1L {
    v = v >> 1
    k = k + 1
  }
  if k <= max_k {
    Some(k)
  } else {
    None
  }
}

///|
fn qbe_expr_is_nonneg_int(g : QbeGen, e : Expr) -> Bool {
  match e {
    EIdent(name, _) => g.nonneg_vars.contains(name)
    EInt(raw, _) => {
      let v = qbe_parse_int64_lit(raw)
      v >= 0L && v <= 2147483647L
    }
    EBinary("&", l, r, _) => {
      let l_ok = match qbe_eval_const_i64_expr(g, l) {
        Some(v) => v >= 0L && v <= 2147483647L
        None => false
      }
      let r_ok = match qbe_eval_const_i64_expr(g, r) {
        Some(v) => v >= 0L && v <= 2147483647L
        None => false
      }
      l_ok || r_ok
    }
    EMethodCall(recv_e, mn, ma, msp) =>
      qbe_is_builtin_len_call(g, recv_e, mn, ma, msp)
    _ => false
  }
}

///|
/// Emit branchless SWAR population count (`count_ones`) for 32-bit (`w`) or
/// 64-bit (`l`) integer value `x_val`, returning a `w` (`Int`) temporary.
fn qbe_emit_swar_popcnt(g : QbeGen, x_val : String, is64 : Bool) -> String {
  if !is64 {
    let t1 = qbe_tmp(g)
    qbe_emit(g, t1 + " =w shr " + x_val + ", 1")
    let t2 = qbe_tmp(g)
    qbe_emit(g, t2 + " =w and " + t1 + ", 1431655765")
    let v1 = qbe_tmp(g)
    qbe_emit(g, v1 + " =w sub " + x_val + ", " + t2)
    let t3 = qbe_tmp(g)
    qbe_emit(g, t3 + " =w and " + v1 + ", 858993459")
    let t4 = qbe_tmp(g)
    qbe_emit(g, t4 + " =w shr " + v1 + ", 2")
    let t5 = qbe_tmp(g)
    qbe_emit(g, t5 + " =w and " + t4 + ", 858993459")
    let v2 = qbe_tmp(g)
    qbe_emit(g, v2 + " =w add " + t3 + ", " + t5)
    let t6 = qbe_tmp(g)
    qbe_emit(g, t6 + " =w shr " + v2 + ", 4")
    let t7 = qbe_tmp(g)
    qbe_emit(g, t7 + " =w add " + v2 + ", " + t6)
    let v3 = qbe_tmp(g)
    qbe_emit(g, v3 + " =w and " + t7 + ", 252645135")
    let t8 = qbe_tmp(g)
    qbe_emit(g, t8 + " =w mul " + v3 + ", 16843009")
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =w shr " + t8 + ", 24")
    return r
  }
  let t1 = qbe_tmp(g)
  qbe_emit(g, t1 + " =l shr " + x_val + ", 1")
  let t2 = qbe_tmp(g)
  qbe_emit(g, t2 + " =l and " + t1 + ", 6148914691236517205")
  let v1 = qbe_tmp(g)
  qbe_emit(g, v1 + " =l sub " + x_val + ", " + t2)
  let t3 = qbe_tmp(g)
  qbe_emit(g, t3 + " =l and " + v1 + ", 3689348814741910323")
  let t4 = qbe_tmp(g)
  qbe_emit(g, t4 + " =l shr " + v1 + ", 2")
  let t5 = qbe_tmp(g)
  qbe_emit(g, t5 + " =l and " + t4 + ", 3689348814741910323")
  let v2 = qbe_tmp(g)
  qbe_emit(g, v2 + " =l add " + t3 + ", " + t5)
  let t6 = qbe_tmp(g)
  qbe_emit(g, t6 + " =l shr " + v2 + ", 4")
  let t7 = qbe_tmp(g)
  qbe_emit(g, t7 + " =l add " + v2 + ", " + t6)
  let v3 = qbe_tmp(g)
  qbe_emit(g, v3 + " =l and " + t7 + ", 1085102592571150095")
  let t8 = qbe_tmp(g)
  qbe_emit(g, t8 + " =l mul " + v3 + ", 72340172838076673")
  let t9 = qbe_tmp(g)
  qbe_emit(g, t9 + " =l shr " + t8 + ", 56")
  let r = qbe_tmp(g)
  qbe_emit(g, r + " =w copy " + t9)
  r
}

///|
/// Lower primitive bitwise methods (`rotate_left`, `rotate_right`,
/// `leading_zeros`, `trailing_zeros`, `count_ones`) on `Int`/`UInt`/`Int64`/`UInt64`.
fn qbe_emit_int_bitop(
  g : QbeGen,
  recv_val : String,
  recv_ty : Ty,
  mname : String,
  args : Array[Expr],
) -> Option[QbeVal] {
  let is64 = match recv_ty {
    TInt64 | TUInt64 => true
    _ => false
  }
  let cls = if is64 { "l" } else { "w" }
  let bits = if is64 { 64 } else { 32 }
  let mask : Int64 = if is64 { 63L } else { 31L }
  if mname == "lnot" && args.length() == 0 {
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =" + cls + " xor " + recv_val + ", -1")
    return Some(qval(r, recv_ty))
  }
  if mname == "rotate_right" && args.length() == 1 {
    match qbe_eval_const_i64_expr(g, args[0]) {
      Some(k) => {
        let s = (k & mask).to_int()
        if s == 0 {
          return Some(qval(recv_val, recv_ty))
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =" + cls + " ror " + recv_val + ", " + s.to_string())
        return Some(qval(r, recv_ty))
      }
      None => {
        let nv = qbe_emit_expr(g, args[0], Some(TInt)).reg
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =" + cls + " ror " + recv_val + ", " + nv)
        return Some(qval(r, recv_ty))
      }
    }
  }
  if mname == "rotate_left" && args.length() == 1 {
    match qbe_eval_const_i64_expr(g, args[0]) {
      Some(k) => {
        let s = ((0L - k) & mask).to_int()
        if s == 0 {
          return Some(qval(recv_val, recv_ty))
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =" + cls + " ror " + recv_val + ", " + s.to_string())
        return Some(qval(r, recv_ty))
      }
      None => {
        let nv = qbe_emit_expr(g, args[0], Some(TInt)).reg
        let neg = qbe_tmp(g)
        qbe_emit(g, neg + " =w sub 0, " + nv)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =" + cls + " ror " + recv_val + ", " + neg)
        return Some(qval(r, recv_ty))
      }
    }
  }
  if mname == "count_ones" && args.length() == 0 {
    if g.target_wasm {
      if is64 {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l popcnt " + recv_val)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =w copy " + t)
        return Some(qval(r, TInt))
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w popcnt " + recv_val)
      return Some(qval(r, TInt))
    }
    return Some(qval(qbe_emit_swar_popcnt(g, recv_val, is64), TInt))
  }
  if mname == "trailing_zeros" && args.length() == 0 {
    if g.target_wasm {
      if is64 {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l ctz " + recv_val)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =w copy " + t)
        return Some(qval(r, TInt))
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w ctz " + recv_val)
      return Some(qval(r, TInt))
    }
    let neg = qbe_tmp(g)
    qbe_emit(g, neg + " =" + cls + " sub 0, " + recv_val)
    let lsb = qbe_tmp(g)
    qbe_emit(g, lsb + " =" + cls + " and " + recv_val + ", " + neg)
    let m = qbe_tmp(g)
    qbe_emit(g, m + " =" + cls + " sub " + lsb + ", 1")
    return Some(qval(qbe_emit_swar_popcnt(g, m, is64), TInt))
  }
  if mname == "leading_zeros" && args.length() == 0 {
    if g.target_wasm {
      if is64 {
        let t = qbe_tmp(g)
        qbe_emit(g, t + " =l clz " + recv_val)
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =w copy " + t)
        return Some(qval(r, TInt))
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w clz " + recv_val)
      return Some(qval(r, TInt))
    }
    let sh1 = qbe_tmp(g)
    qbe_emit(g, sh1 + " =" + cls + " shr " + recv_val + ", 1")
    let s1 = qbe_tmp(g)
    qbe_emit(g, s1 + " =" + cls + " or " + recv_val + ", " + sh1)
    let sh2 = qbe_tmp(g)
    qbe_emit(g, sh2 + " =" + cls + " shr " + s1 + ", 2")
    let s2 = qbe_tmp(g)
    qbe_emit(g, s2 + " =" + cls + " or " + s1 + ", " + sh2)
    let sh4 = qbe_tmp(g)
    qbe_emit(g, sh4 + " =" + cls + " shr " + s2 + ", 4")
    let s3 = qbe_tmp(g)
    qbe_emit(g, s3 + " =" + cls + " or " + s2 + ", " + sh4)
    let sh8 = qbe_tmp(g)
    qbe_emit(g, sh8 + " =" + cls + " shr " + s3 + ", 8")
    let s4 = qbe_tmp(g)
    qbe_emit(g, s4 + " =" + cls + " or " + s3 + ", " + sh8)
    let sh16 = qbe_tmp(g)
    qbe_emit(g, sh16 + " =" + cls + " shr " + s4 + ", 16")
    let s5 = qbe_tmp(g)
    qbe_emit(g, s5 + " =" + cls + " or " + s4 + ", " + sh16)
    let mut smeared = s5
    if is64 {
      let sh32 = qbe_tmp(g)
      qbe_emit(g, sh32 + " =l shr " + s5 + ", 32")
      let s6 = qbe_tmp(g)
      qbe_emit(g, s6 + " =l or " + s5 + ", " + sh32)
      smeared = s6
    }
    let p = qbe_emit_swar_popcnt(g, smeared, is64)
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =w sub " + bits.to_string() + ", " + p)
    return Some(qval(r, TInt))
  }
  None
}

///|
/// Recognize unsigned bit-rotation idioms `(x << k) op (x >> m)` and
/// `(x >> m) op (x << k)` on `UInt` / `UInt64` and lower to a single `ror`.
/// Skipped inside `#verify` functions.
fn qbe_try_emit_rotate_idiom(
  g : QbeGen,
  op : String,
  lhs : Expr,
  rhs : Expr,
) -> Option[QbeVal] {
  if g.in_verify {
    return None
  }
  if op != "|" && op != "^" && op != "+" {
    return None
  }
  let pair : Option[(Expr, Expr, Expr, Expr)] = match (lhs, rhs) {
    (EBinary("<<", x1, s1, _), EBinary(">>", x2, s2, _)) => Some((x1, s1, x2, s2))
    (EBinary(">>", x2, s2, _), EBinary("<<", x1, s1, _)) => Some((x1, s1, x2, s2))
    _ => None
  }
  match pair {
    None => None
    Some((x_shl, s_shl, x_shr, s_shr)) => {
      let same_x = match (x_shl, x_shr) {
        (EIdent(n1, _), EIdent(n2, _)) => n1 == n2
        _ => false
      }
      if !same_x {
        return None
      }
      let (cls, bits, res_ty) = match qbe_probe_expr_ty(g, x_shl) {
        Some(TUInt) => ("w", 32L, TUInt)
        Some(TUInt64) => ("l", 64L, TUInt64)
        _ => return None
      }
      // Case 1: constant shift counts 0 < k < W, 0 < m < W, k + m == W (|, ^, + all exact).
      match (qbe_eval_const_i64_expr(g, s_shl), qbe_eval_const_i64_expr(g, s_shr)) {
        (Some(k), Some(m)) => {
          if k > 0L && k < bits && m > 0L && m < bits && k + m == bits {
            let xv = qbe_emit_expr(g, x_shl, None).reg
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =" + cls + " ror " + xv + ", " + m.to_string())
            return Some(qval(r, res_ty))
          }
          return None
        }
        _ => ()
      }
      // Case 2: variable shift count with `|` only (exact at k == 0 too).
      if op != "|" {
        return None
      }
      // (x >> k) | (x << (W - k)) -> ror x, k
      match (s_shr, s_shl) {
        (EIdent(kn, _), EBinary("-", c_e, EIdent(kn2, _), _)) => {
          let c_ok = match qbe_eval_const_i64_expr(g, c_e) {
            Some(cv) => cv == bits
            None => false
          }
          if kn == kn2 && c_ok {
            match qbe_probe_expr_ty(g, s_shr) {
              Some(TInt) | Some(TUInt) => {
                let xv = qbe_emit_expr(g, x_shl, None).reg
                let kv = qbe_emit_expr(g, s_shr, None).reg
                let r = qbe_tmp(g)
                qbe_emit(g, r + " =" + cls + " ror " + xv + ", " + kv)
                return Some(qval(r, res_ty))
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
      // (x << k) | (x >> (W - k)) -> ror x, (0 - k)
      match (s_shl, s_shr) {
        (EIdent(kn, _), EBinary("-", c_e, EIdent(kn2, _), _)) => {
          let c_ok = match qbe_eval_const_i64_expr(g, c_e) {
            Some(cv) => cv == bits
            None => false
          }
          if kn == kn2 && c_ok {
            match qbe_probe_expr_ty(g, s_shl) {
              Some(TInt) | Some(TUInt) => {
                let xv = qbe_emit_expr(g, x_shl, None).reg
                let kv = qbe_emit_expr(g, s_shl, None).reg
                let neg = qbe_tmp(g)
                qbe_emit(g, neg + " =w sub 0, " + kv)
                let r = qbe_tmp(g)
                qbe_emit(g, r + " =" + cls + " ror " + xv + ", " + neg)
                return Some(qval(r, res_ty))
              }
              _ => ()
            }
          }
        }
        _ => ()
      }
      None
    }
  }
}

///|
/// Fold `(x % pow2) == 0` / `(x % pow2) != 0` (and symmetric `0 == (x % pow2)`)
/// into `(x & (pow2 - 1)) == 0` / `!= 0`, exact across the entire signed/unsigned
/// 8-bit, 32-bit and 64-bit domains (including INT32_MIN and INT64_MIN).
/// Returns `None` only before `x` is emitted: once it is, any other operand
/// type finishes the general `%` and comparison on that value, so the caller
/// never evaluates `x` twice.
fn qbe_try_emit_mod_pow2_eq_zero(
  g : QbeGen,
  op : String,
  lhs : Expr,
  rhs : Expr,
) -> Option[String] {
  if op != "==" && op != "!=" {
    return None
  }
  let mod_pair : Option[(Expr, Expr, Span, Expr, Expr)] = match lhs {
    EBinary("%", x_e, d_e, m_sp) =>
      if qbe_is_zero_int_lit(g, rhs) {
        Some((x_e, d_e, m_sp, lhs, rhs))
      } else {
        None
      }
    _ =>
      match rhs {
        EBinary("%", x_e, d_e, m_sp) =>
          if qbe_is_zero_int_lit(g, lhs) {
            Some((x_e, d_e, m_sp, rhs, lhs))
          } else {
            None
          }
        _ => None
      }
  }
  let (x_expr, d_expr, mod_sp, mod_expr, zero_expr) = match mod_pair {
    Some(p) => p
    None => return None
  }
  let d = match qbe_eval_const_i64_expr(g, d_expr) {
    Some(v) => v
    None => return None
  }
  if d < 2L || d > 4611686018427387904L || (d & (d - 1L)) != 0L {
    return None
  }
  // From here on `x_expr` has been emitted: never return `None` (the caller
  // would evaluate it, and its side effects, a second time).
  let xv = qbe_emit_expr(g, x_expr, None)
  if g.block_term {
    return Some("0")
  }
  let mask = (d - 1L).to_string()
  // Divisors the operand's width cannot represent (`>= 2^32` for 32-bit,
  // `>= 256` for 8-bit types) narrow to another value, possibly 0: they take
  // the general path, which narrows them exactly like a plain `%` (and keeps
  // its division-by-zero behaviour and `#verify` checks).
  match xv.ty {
    TInt | TUInt =>
      if d <= 1073741824L {
        let masked = qbe_tmp(g)
        qbe_emit(g, masked + " =w and " + xv.reg + ", " + mask)
        let cw = qbe_tmp(g)
        let cop = if op == "==" { "ceqw" } else { "cnew" }
        qbe_emit(g, cw + " =w " + cop + " " + masked + ", 0")
        Some(cw)
      } else if d <= 2147483648L {
        let rem = qbe_tmp(g)
        let rop = match xv.ty {
          TUInt => "urem"
          _ => "rem"
        }
        qbe_emit(g, rem + " =w " + rop + " " + xv.reg + ", " + d.to_string())
        let cw = qbe_tmp(g)
        let cop = if op == "==" { "ceqw" } else { "cnew" }
        qbe_emit(g, cw + " =w " + cop + " " + rem + ", 0")
        Some(cw)
      } else {
        Some(qbe_mod_pow2_eq_zero_general(g, op, xv, x_expr, d_expr, mod_sp, mod_expr, zero_expr))
      }
    TInt64 | TUInt64 => {
      let masked = qbe_tmp(g)
      qbe_emit(g, masked + " =l and " + xv.reg + ", " + mask)
      let cw = qbe_tmp(g)
      let cop = if op == "==" { "ceql" } else { "cnel" }
      qbe_emit(g, cw + " =w " + cop + " " + masked + ", 0")
      Some(cw)
    }
    TByte | TInt8 =>
      if d <= 128L {
        // `x % d == 0` iff the low `log2 d` bits are zero (also for negative
        // `Int8`); only the low 8 bits of the register are read.
        let masked = qbe_tmp(g)
        qbe_emit(g, masked + " =w and " + xv.reg + ", " + mask)
        let cw = qbe_tmp(g)
        let cop = if op == "==" { "ceqw" } else { "cnew" }
        qbe_emit(g, cw + " =w " + cop + " " + masked + ", 0")
        Some(cw)
      } else {
        Some(qbe_mod_pow2_eq_zero_general(g, op, xv, x_expr, d_expr, mod_sp, mod_expr, zero_expr))
      }
    _ => Some(qbe_mod_pow2_eq_zero_general(g, op, xv, x_expr, d_expr, mod_sp, mod_expr, zero_expr))
  }
}

///|
/// `x % d == 0` / `!= 0` through the general `%` and comparison on the
/// already emitted `xv` (`d` and `0` are constants, so emitting them has no
/// effect beyond their values). Returns a `w` register.
fn qbe_mod_pow2_eq_zero_general(
  g : QbeGen,
  op : String,
  xv : QbeVal,
  x_expr : Expr,
  d_expr : Expr,
  mod_sp : Span,
  mod_expr : Expr,
  zero_expr : Expr,
) -> String {
  let dv = qbe_emit_expr(g, d_expr, Some(xv.ty))
  let rem = qbe_emit_binary_combine(
    g,
    "%",
    x_expr,
    d_expr,
    mod_sp,
    QbeArgVal::{ qv: xv, borrowed: false },
    QbeArgVal::{ qv: dv, borrowed: true },
  )
  let zv = qbe_emit_expr(g, zero_expr, Some(xv.ty))
  let cv = qbe_emit_binary_combine(
    g,
    op,
    mod_expr,
    zero_expr,
    mod_sp,
    QbeArgVal::{ qv: rem, borrowed: false },
    QbeArgVal::{ qv: zv, borrowed: true },
  )
  if g.block_term {
    return "0"
  }
  let cw = qbe_tmp(g)
  qbe_emit(g, cw + " =w copy " + cv.reg)
  cw
}

///|
/// Strength-reduce signed 32-bit `/` and `%` by positive constant `2 <= d <= 2147483647`.
/// Uses shift/mask for powers of 2 and Hacker's Delight Ch. 10-4 64-bit magic multiply otherwise.
fn qbe_emit_i32_const_div_rem(
  g : QbeGen,
  op : String,
  lw : String,
  d : Int64,
  is_nonneg : Bool,
  is_even : Bool,
) -> Option[String] {
  if d < 2L || d > 2147483647L {
    return None
  }
  match qbe_pow2_log2_i64(d, 30) {
    Some(k) => {
      if op == "/" {
        if is_nonneg || (k == 1 && is_even) {
          let q = qbe_tmp(g)
          qbe_emit(g, q + " =w sar " + lw + ", " + k.to_string())
          return Some(q)
        }
        let bias = if k == 1 {
          let b = qbe_tmp(g)
          qbe_emit(g, b + " =w shr " + lw + ", 31")
          b
        } else {
          let s = qbe_tmp(g)
          qbe_emit(g, s + " =w sar " + lw + ", 31")
          let b = qbe_tmp(g)
          qbe_emit(g, b + " =w shr " + s + ", " + (32 - k).to_string())
          b
        }
        let adj = qbe_tmp(g)
        qbe_emit(g, adj + " =w add " + lw + ", " + bias)
        let q = qbe_tmp(g)
        qbe_emit(g, q + " =w sar " + adj + ", " + k.to_string())
        return Some(q)
      } else {
        if is_nonneg {
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =w and " + lw + ", " + (d - 1L).to_string())
          return Some(r)
        }
        let bias = if k == 1 {
          let b = qbe_tmp(g)
          qbe_emit(g, b + " =w shr " + lw + ", 31")
          b
        } else {
          let s = qbe_tmp(g)
          qbe_emit(g, s + " =w sar " + lw + ", 31")
          let b = qbe_tmp(g)
          qbe_emit(g, b + " =w shr " + s + ", " + (32 - k).to_string())
          b
        }
        let adj = qbe_tmp(g)
        qbe_emit(g, adj + " =w add " + lw + ", " + bias)
        let masked = qbe_tmp(g)
        qbe_emit(g, masked + " =w and " + adj + ", " + (0L - d).to_string())
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =w sub " + lw + ", " + masked)
        return Some(r)
      }
    }
    None => ()
  }
  // Non-power-of-2: Hacker's Delight Ch. 10-4 signed 32-bit via 64-bit multiply
  let nc = 2147483648L - (2147483648L % d) - 1L
  let mut p = 32
  let mut found_m = 0L
  while p <= 62 {
    let two_p = 1L << p
    let rem = two_p % d
    let delta = d - rem
    if two_p / delta > nc || (two_p / delta == nc && two_p % delta > 0L) {
      found_m = (two_p + delta) / d
      break
    }
    p = p + 1
  }
  if p > 62 || found_m <= 0L || found_m > 4294967295L {
    return None
  }
  let xl = qbe_tmp(g)
  qbe_emit(g, xl + " =l extsw " + lw)
  let prod = qbe_tmp(g)
  qbe_emit(g, prod + " =l mul " + xl + ", " + found_m.to_string())
  let ql = qbe_tmp(g)
  qbe_emit(g, ql + " =l sar " + prod + ", " + p.to_string())
  let qw0 = qbe_tmp(g)
  qbe_emit(g, qw0 + " =w copy " + ql)
  let q = if is_nonneg {
    qw0
  } else {
    let sign = qbe_tmp(g)
    qbe_emit(g, sign + " =w shr " + lw + ", 31")
    let q_adj = qbe_tmp(g)
    qbe_emit(g, q_adj + " =w add " + qw0 + ", " + sign)
    q_adj
  }
  if op == "/" {
    Some(q)
  } else {
    let qd = qbe_tmp(g)
    qbe_emit(g, qd + " =w mul " + q + ", " + d.to_string())
    let rem = qbe_tmp(g)
    qbe_emit(g, rem + " =w sub " + lw + ", " + qd)
    Some(rem)
  }
}

///|
fn qbe_emit_u32_const_div_rem(
  g : QbeGen,
  op : String,
  lw : String,
  d : Int64,
) -> Option[String] {
  match qbe_pow2_log2_i64(d, 30) {
    Some(k) => {
      let r = qbe_tmp(g)
      if op == "/" {
        qbe_emit(g, r + " =w shr " + lw + ", " + k.to_string())
      } else {
        qbe_emit(g, r + " =w and " + lw + ", " + (d - 1L).to_string())
      }
      Some(r)
    }
    None => None
  }
}

///|
fn qbe_emit_u64_const_div_rem(
  g : QbeGen,
  op : String,
  ll : String,
  d : Int64,
) -> Option[String] {
  match qbe_pow2_log2_i64(d, 62) {
    Some(k) => {
      let r = qbe_tmp(g)
      if op == "/" {
        qbe_emit(g, r + " =l shr " + ll + ", " + k.to_string())
      } else {
        qbe_emit(g, r + " =l and " + ll + ", " + (d - 1L).to_string())
      }
      Some(r)
    }
    None => None
  }
}

///|
fn qbe_emit_i64_const_div_rem(
  g : QbeGen,
  op : String,
  ll : String,
  d : Int64,
) -> Option[String] {
  match qbe_pow2_log2_i64(d, 62) {
    Some(k) => {
      let bias = if k == 1 {
        let b = qbe_tmp(g)
        qbe_emit(g, b + " =l shr " + ll + ", 63")
        b
      } else {
        let s = qbe_tmp(g)
        qbe_emit(g, s + " =l sar " + ll + ", 63")
        let b = qbe_tmp(g)
        qbe_emit(g, b + " =l shr " + s + ", " + (64 - k).to_string())
        b
      }
      let adj = qbe_tmp(g)
      qbe_emit(g, adj + " =l add " + ll + ", " + bias)
      if op == "/" {
        let q = qbe_tmp(g)
        qbe_emit(g, q + " =l sar " + adj + ", " + k.to_string())
        Some(q)
      } else {
        let masked = qbe_tmp(g)
        qbe_emit(g, masked + " =l and " + adj + ", " + (0L - d).to_string())
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l sub " + ll + ", " + masked)
        Some(r)
      }
    }
    None => None
  }
}

///|
/// Emit fused compare-and-branch (no `extuw` before `jnz`) so QBE arm64 `seljmp`
/// fuses `cmp/fcmp + b.cc` directly, and short-circuits `!`, `&&`, `||` with zero stack slots.
/// Iterative on `!`, `&&`, `||` so deep boolean chains never overflow the stack.
fn qbe_emit_cond_branch(
  g : QbeGen,
  init_cond : Expr,
  init_l_true : String,
  init_l_false : String,
) -> Unit {
  let w_expr : Array[Expr] = [init_cond]
  let w_t : Array[String] = [init_l_true]
  let w_f : Array[String] = [init_l_false]
  let w_lbl : Array[String] = [""]
  while w_expr.length() > 0 {
    let idx = w_expr.length() - 1
    let cond = w_expr[idx]
    let l_true = w_t[idx]
    let l_false = w_f[idx]
    let emit_lbl = w_lbl[idx]
    let _ = w_expr.pop()
    let _ = w_t.pop()
    let _ = w_f.pop()
    let _ = w_lbl.pop()
    if emit_lbl.length() > 0 {
      qbe_emit_lbl(g, emit_lbl)
    }
    let mut deferred = false
    match cond {
      EUnary(op, inner, _) =>
        if op == "!" {
          w_expr.push(inner)
          w_t.push(l_false)
          w_f.push(l_true)
          w_lbl.push("")
          deferred = true
        }
      EBinary(op, lhs, rhs, _) =>
        if op == "&&" {
          if qbe_expr_has_is(lhs) {
            qbe_scope_push(g)
            let sc = g.scopes[g.scopes.length() - 1]
            let start_idx = sc.locals.length()
            let l_cleanup_true = qbe_lbl(g, "and_is_t")
            qbe_emit_cond_branch_bind(g, cond, l_cleanup_true, l_false, None)
            let end_idx = sc.locals.length()
            qbe_emit_lbl(g, l_cleanup_true)
            qbe_release_scope_locals_range(g, start_idx, end_idx)
            let _ = g.scopes.pop()
            qbe_emit_term(g, "jmp " + l_true)
            deferred = true
          } else {
            let l_rhs = qbe_lbl(g, "and_r")
            w_expr.push(rhs)
            w_t.push(l_true)
            w_f.push(l_false)
            w_lbl.push(l_rhs)
            w_expr.push(lhs)
            w_t.push(l_rhs)
            w_f.push(l_false)
            w_lbl.push("")
            deferred = true
          }
        } else if op == "||" {
          let l_rhs = qbe_lbl(g, "or_r")
          w_expr.push(rhs)
          w_t.push(l_true)
          w_f.push(l_false)
          w_lbl.push(l_rhs)
          w_expr.push(lhs)
          w_t.push(l_true)
          w_f.push(l_rhs)
          w_lbl.push("")
          deferred = true
        }
      _ => ()
    }
    if deferred {
      continue
    }
    qbe_emit_cond_branch_leaf(g, cond, l_true, l_false)
  }
}

///|
fn qbe_emit_cond_branch_leaf(
  g : QbeGen,
  cond : Expr,
  l_true : String,
  l_false : String,
) -> Unit {
  match cond {
    EBinary(op, lhs, rhs, bin_sp) => {
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let no_custom_eq = (op != "==" && op != "!=") ||
          !qbe_eq_op_may_call_custom(g, lhs, rhs, qbe_hints_new())
        let can_borrow = no_custom_eq && !qbe_expr_has_assign(lhs) && !qbe_expr_has_assign(rhs)
        let can_borrow_af = can_borrow &&
          qbe_loop_has_no_calls_expr(g, lhs) &&
          qbe_loop_has_no_calls_expr(g, rhs)
        if op == "==" || op == "!=" {
          match qbe_try_emit_mod_pow2_eq_zero(g, op, lhs, rhs) {
            Some(cw) => {
              qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
              return
            }
            None => ()
          }
          let mut short_bytes : Option[Array[Int]] = None
          let mut other_expr : Option[Expr] = None
          if g.hot_loop_depth > 0 {
            match rhs {
              EString(lit, _) =>
                match qbe_short_ascii_bytes(lit) {
                  Some(bs) => {
                    short_bytes = Some(bs)
                    other_expr = Some(lhs)
                  }
                  None => ()
                }
              _ => ()
            }
            match short_bytes {
              None =>
                match lhs {
                  EString(lit, _) =>
                    match qbe_short_ascii_bytes(lit) {
                      Some(bs) => {
                        short_bytes = Some(bs)
                        other_expr = Some(rhs)
                      }
                      None => ()
                    }
                  _ => ()
                }
              Some(_) => ()
            }
          }
          match short_bytes {
            Some(bs) =>
              match other_expr {
                Some(oexpr) => {
                  let oa = qbe_emit_arg_maybe_borrow_ext(
                    g,
                    oexpr,
                    Some(TString),
                    can_borrow,
                    can_borrow_af,
                  )
                  let lt = if op == "==" { l_true } else { l_false }
                  let lf = if op == "==" { l_false } else { l_true }
                  if oa.borrowed {
                    qbe_emit_short_str_eq_branch(g, oa.qv.reg, bs, lt, lf)
                  } else {
                    let eq = qbe_emit_short_str_eq_val(g, oa.qv.reg, bs)
                    qbe_rc_dec(g, oa.qv.reg, oa.qv.ty)
                    qbe_emit_term(g, "jnz " + eq + ", " + lt + ", " + lf)
                  }
                  return
                }
                None => ()
              }
            None => ()
          }
        }
        let lhs_exp : Option[Ty] = if (op == "==" || op == "!=") && qbe_lhs_needs_rhs_hint(lhs) {
          qbe_eq_op_hint(g, bin_sp, rhs)
        } else {
          None
        }
        let la = match lhs {
          EInt(raw, _) => {
            let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
            QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
          }
          _ => qbe_emit_arg_maybe_borrow_ext(g, lhs, lhs_exp, can_borrow, can_borrow_af)
        }
        let lv = la.qv
        if g.block_term {
          return
        }
        // An owned left operand is held in a scope slot while a right operand
        // that may leave early (`return`, `break`, `continue`, `?`) runs, so
        // the exit path releases it (as in `qbe_emit_binary_chain`).
        let lhs_guards : Option[QbeArgGuards] = if !la.borrowed && qbe_expr_may_early_exit(g, rhs) {
          let gs = QbeArgGuards::{ exits: [], slots: [], stores: [] }
          qbe_guard_val(g, gs, la, false, true)
          Some(gs)
        } else {
          None
        }
        let ra = match lv.ty {
          TInt =>
            match rhs {
              EInt(raw, _) => {
                let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
                QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
              }
              _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), can_borrow, can_borrow_af)
            }
          _ => qbe_emit_arg_maybe_borrow_ext(g, rhs, Some(lv.ty), can_borrow, can_borrow_af)
        }
        match lhs_guards {
          Some(gs) => qbe_release_guards(g, gs)
          None => ()
        }
        if g.block_term {
          return
        }
        let rv = ra.qv
        match lv.ty {
          TInt => {
            let lw = lv.reg
            let rw = qbe_coerce_val(g, rv, TInt)
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "csltw"
            } else if op == "<=" {
              "cslew"
            } else if op == ">" {
              "csgtw"
            } else {
              "csgew"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TUInt => {
            let lw = lv.reg
            let rw = qbe_coerce_val(g, rv, TUInt)
            let cop = if op == "==" {
              "ceqw"
            } else if op == "!=" {
              "cnew"
            } else if op == "<" {
              "cultw"
            } else if op == "<=" {
              "culew"
            } else if op == ">" {
              "cugtw"
            } else {
              "cugew"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TUInt64 => {
            let ll = lv.reg
            let rl = qbe_coerce_val(g, rv, TUInt64)
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "cultl"
            } else if op == "<=" {
              "culel"
            } else if op == ">" {
              "cugtl"
            } else {
              "cugel"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ll + ", " + rl)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TDouble => {
            let ld = lv.reg
            let rd = qbe_coerce_val(g, rv, TDouble)
            let cop = if op == "==" {
              "ceqd"
            } else if op == "!=" {
              "cned"
            } else if op == "<" {
              "cltd"
            } else if op == "<=" {
              "cled"
            } else if op == ">" {
              "cgtd"
            } else {
              "cged"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + ld + ", " + rd)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TFloat => {
            let lf = lv.reg
            let rf = qbe_coerce_val(g, rv, TFloat)
            let cop = if op == "==" {
              "ceqs"
            } else if op == "!=" {
              "cnes"
            } else if op == "<" {
              "clts"
            } else if op == "<=" {
              "cles"
            } else if op == ">" {
              "cgts"
            } else {
              "cges"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lf + ", " + rf)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TInt64 | TBool | TByte | TInt8 | TChar => {
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "csltl"
            } else if op == "<=" {
              "cslel"
            } else if op == ">" {
              "csgtl"
            } else {
              "csgel"
            }
            let cw = qbe_tmp(g)
            qbe_emit(g, cw + " =w " + cop + " " + lv.reg + ", " + rv.reg)
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
          TStrView => {
            let p1a = qbe_tmp(g)
            let p1 = qbe_tmp(g)
            let l1a = qbe_tmp(g)
            let l1 = qbe_tmp(g)
            let p2a = qbe_tmp(g)
            let p2 = qbe_tmp(g)
            let l2a = qbe_tmp(g)
            let l2 = qbe_tmp(g)
            qbe_emit(g, p1a + " =l add " + lv.reg + ", 8")
            qbe_emit(g, p1 + " =l loadl " + p1a)
            qbe_emit(g, l1a + " =l add " + lv.reg + ", 16")
            qbe_emit(g, l1 + " =l loadl " + l1a)
            qbe_emit(g, p2a + " =l add " + rv.reg + ", 8")
            qbe_emit(g, p2 + " =l loadl " + p2a)
            qbe_emit(g, l2a + " =l add " + rv.reg + ", 16")
            qbe_emit(g, l2 + " =l loadl " + l2a)
            let eq = qbe_emit_strview_eq_raw(g, p1, l1, p2, l2)
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            if op == "==" {
              qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
            } else {
              qbe_emit_term(g, "jnz " + eq + ", " + l_false + ", " + l_true)
            }
            return
          }
          TString => {
            if op == "==" || op == "!=" {
              let eq = qbe_tmp(g)
              qbe_emit(g, eq + " =w call $pion_str_eq(l " + lv.reg + ", l " + rv.reg + ")")
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              if op == "==" {
                qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
              } else {
                qbe_emit_term(g, "jnz " + eq + ", " + l_false + ", " + l_true)
              }
              return
            } else {
              let cmp = qbe_tmp(g)
              qbe_emit(g, cmp + " =w call $pion_str_cmp(l " + lv.reg + ", l " + rv.reg + ")")
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              let cop = if op == "<" {
                "csltw"
              } else if op == "<=" {
                "cslew"
              } else if op == ">" {
                "csgtw"
              } else {
                "csgew"
              }
              let cw = qbe_tmp(g)
              qbe_emit(g, cw + " =w " + cop + " " + cmp + ", 0")
              qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
              return
            }
          }
          _ => {
            let cmp_ty = if qbe_ty_has_error(lv.ty) && !qbe_ty_has_error(rv.ty) {
              rv.ty
            } else {
              lv.ty
            }
            if (op == "==" || op == "!=") && qbe_type_needs_eq_fn(g, cmp_ty) {
              let eq_sym = qbe_ensure_eq_fn(g, cmp_ty)
              let eq = qbe_tmp(g)
              qbe_emit(g, eq + " =w call " + eq_sym + "(l " + lv.reg + ", l " + rv.reg + ")")
              if qbe_ty_has_custom_eq(g, cmp_ty, Map([])) {
                qbe_invalidate_aliased_min_lens(g)
              }
              if !la.borrowed {
                qbe_rc_dec(g, lv.reg, lv.ty)
              }
              if !ra.borrowed {
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              if op == "==" {
                qbe_emit_term(g, "jnz " + eq + ", " + l_true + ", " + l_false)
              } else {
                qbe_emit_term(g, "jnz " + eq + ", " + l_false + ", " + l_true)
              }
              return
            }
            let cop = if op == "==" {
              "ceql"
            } else if op == "!=" {
              "cnel"
            } else if op == "<" {
              "csltl"
            } else if op == "<=" {
              "cslel"
            } else if op == ">" {
              "csgtl"
            } else {
              "csgel"
            }
            let cw = qbe_tmp(g)
            let lc = qbe_cmp_operand(g, lv.reg, lv.ty)
            let rc = qbe_cmp_operand(g, rv.reg, rv.ty)
            qbe_emit(g, cw + " =w " + cop + " " + lc + ", " + rc)
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            qbe_emit_term(g, "jnz " + cw + ", " + l_true + ", " + l_false)
            return
          }
        }
      }
    }
    _ => ()
  }
  let cv = qbe_emit_expr(g, cond, Some(TBool))
  qbe_emit_jnz_l(g, cv.reg, l_true, l_false)
}

///|
fn qbe_peek_expr_ty(g : QbeGen, e : Expr) -> Option[Ty] {
  match e {
    EIdent(name, _) =>
      match qbe_lookup_local(g, name) {
        Some(loc) => Some(loc.ty)
        None => qbe_lookup_const_ty(g, name)
      }
    EField(base, fname, _) =>
      match qbe_peek_expr_ty(g, base) {
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == fname {
                  return Some(subst_ty(sinfo.field_tys[i], subst))
                }
                i = i + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    EMove(inner, _) => qbe_peek_expr_ty(g, inner)
    _ => None
  }
}

///|
fn qbe_hints_new() -> QbeProbeHints {
  QbeProbeHints::{ names: [], tys: [] }
}

///|
fn qbe_hints_copy(h : QbeProbeHints) -> QbeProbeHints {
  let names : Array[String] = []
  let tys : Array[Ty] = []
  let mut i = 0
  while i < h.names.length() {
    names.push(h.names[i])
    tys.push(h.tys[i])
    i = i + 1
  }
  QbeProbeHints::{ names: names, tys: tys }
}

///|
fn qbe_hints_set(h : QbeProbeHints, name : String, ty : Ty) -> Unit {
  if name == "" || name == "_" {
    return
  }
  h.names.push(name)
  h.tys.push(ty)
}

///|
fn qbe_hints_get(h : QbeProbeHints, name : String) -> Option[Ty] {
  let mut i = h.names.length() - 1
  while i >= 0 {
    if h.names[i] == name {
      return Some(h.tys[i])
    }
    i = i - 1
  }
  None
}

///|
fn qbe_bind_pat_probe_hints(
  g : QbeGen,
  pat : Pattern,
  scrut_ty_opt : Option[Ty],
  hints : QbeProbeHints,
) -> Unit {
  match pat {
    PWild(_) | PBool(_, _) | PInt(_, _) | PString(_, _) | PChar(_, _) => ()
    PIdent(name, _) =>
      if name != "_" {
        match scrut_ty_opt {
          Some(t) =>
            if !ty_has_unresolved(t) {
              qbe_hints_set(hints, name, t)
            } else {
              qbe_hints_set(hints, name, TError)
            }
          None => qbe_hints_set(hints, name, TError)
        }
      }
    PTuple(subs, _) =>
      match scrut_ty_opt {
        Some(TTuple(elems)) => {
          let mut i = 0
          while i < subs.length() {
            let sub_ty : Option[Ty] = if i < elems.length() {
              Some(elems[i])
            } else {
              None
            }
            qbe_bind_pat_probe_hints(g, subs[i], sub_ty, hints)
            i = i + 1
          }
        }
        _ => {
          let mut i = 0
          while i < subs.length() {
            qbe_bind_pat_probe_hints(g, subs[i], None, hints)
            i = i + 1
          }
        }
      }
    PVariant(_, vname, subs, _, _) => {
      let field_tys : Array[Ty] = []
      match scrut_ty_opt {
        Some(TOption(inner)) =>
          if vname == "Some" {
            field_tys.push(inner)
          }
        Some(TResult(ok, err)) =>
          if vname == "Ok" {
            field_tys.push(ok)
          } else {
            field_tys.push(err)
          }
        Some(TEnum(ename, eargs)) =>
          match qbe_lookup_enum_info(g, ename) {
            Some(einfo) => {
              let subst = make_subst(einfo.decl.type_params, eargs)
              let mut vi = 0
              while vi < einfo.variants.length() {
                let v = einfo.variants[vi]
                if v.name == vname {
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    field_tys.push(subst_ty(v.field_tys[fi], subst))
                    fi = fi + 1
                  }
                  break
                }
                vi = vi + 1
              }
            }
            None => ()
          }
        _ => ()
      }
      let mut fi = 0
      while fi < subs.length() {
        let sub_ty : Option[Ty] = if fi < field_tys.length() {
          Some(field_tys[fi])
        } else {
          None
        }
        qbe_bind_pat_probe_hints(g, subs[fi], sub_ty, hints)
        fi = fi + 1
      }
    }
  }
}

///|
fn qbe_probe_stmts_ty(g : QbeGen, stmts : Array[Stmt]) -> Option[Ty] {
  qbe_probe_stmts_ty_with(g, stmts, qbe_hints_new())
}

///|
fn qbe_probe_stmts_ty_with(
  g : QbeGen,
  stmts : Array[Stmt],
  outer_hints : QbeProbeHints,
) -> Option[Ty] {
  if stmts.length() == 0 {
    return None
  }
  let local_hints = qbe_hints_copy(outer_hints)
  let mut i = 0
  while i < stmts.length() - 1 {
    match stmts[i] {
      SLet(name, _, te, init, let_sp) =>
        if name != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, local_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => {
              let t = qbe_resolve_type(g, te)
              if !ty_has_unresolved(t) {
                bound_ty = t
              }
            }
          }
          qbe_hints_set(local_hints, name, bound_ty)
        }
      SLetTuple(names, te, init, _) => {
        let mut tup_elems : Array[Ty] = []
        match te {
          TyMissing(_) =>
            match qbe_probe_expr_ty_with(g, init, local_hints) {
              Some(TTuple(es)) => tup_elems = es
              _ => ()
            }
          _ =>
            match qbe_resolve_type(g, te) {
              TTuple(es) => tup_elems = es
              _ => ()
            }
        }
        let mut ni = 0
        while ni < names.length() {
          if names[ni] != "_" {
            let bt = if ni < tup_elems.length() && !ty_has_unresolved(tup_elems[ni]) {
              tup_elems[ni]
            } else {
              TError
            }
            qbe_hints_set(local_hints, names[ni], bt)
          }
          ni = ni + 1
        }
      }
      SGuard(cond, _, _) => qbe_probe_bind_cond_hints(g, cond, local_hints)
      _ => ()
    }
    i = i + 1
  }
  match stmts[stmts.length() - 1] {
    SExpr(e, _) => qbe_probe_expr_ty_with(g, e, local_hints)
    _ => None
  }
}

///|
/// Binds the names an `if` / `guard` condition's `is` patterns introduce
/// (through `&&` chains, left to right) into `hints`, typed from the probed
/// scrutinee like `match` arms. A name whose type is unknown is bound to
/// `TError`, so it still shadows an outer local of the same name instead of
/// leaking that local's type into the branch.
fn qbe_probe_bind_cond_hints(
  g : QbeGen,
  cond : Expr,
  hints : QbeProbeHints,
) -> Unit {
  match cond {
    EIs(scrut, pat, _) =>
      qbe_bind_pat_probe_hints(g, pat, qbe_probe_expr_ty_with(g, scrut, hints), hints)
    EBinary("&&", l, r, _) => {
      qbe_probe_bind_cond_hints(g, l, hints)
      qbe_probe_bind_cond_hints(g, r, hints)
    }
    _ => ()
  }
}

///|
/// Probed result type of a call to a top-level fn. A generic one is
/// instantiated from its positional arguments' probed types (`identity(xs)`
/// is `Array[Int]`); the probe only descends into the arguments, so it ends.
fn qbe_probe_call_ret_ty(
  g : QbeGen,
  finfo : FnInfo,
  args : Array[Expr],
  hints : QbeProbeHints,
) -> Option[Ty] {
  let mut rt = finfo.ret_ty
  if finfo.decl.type_params.length() > 0 && qbe_ty_has_param(finfo.ret_ty) {
    let psubst : Map[String, Ty] = Map([])
    let mut i = 0
    while i < args.length() && i < finfo.param_tys.length() {
      match args[i] {
        ENamedArg(_, _, _, _) => return None
        _ => ()
      }
      match qbe_probe_expr_ty_with(g, args[i], hints) {
        Some(t0) => {
          let t = subst_ty(t0, g.cur_type_subst)
          if !ty_has_unresolved(t) && !qbe_ty_has_param(t) {
            qbe_unify_tparams(g, finfo.param_tys[i], t, psubst)
          }
        }
        None => ()
      }
      i = i + 1
    }
    rt = subst_ty(finfo.ret_ty, psubst)
    if qbe_ty_has_param(rt) {
      return None
    }
  }
  if ty_has_unresolved(rt) {
    None
  } else {
    Some(rt)
  }
}

///|
fn qbe_has_user_callee(g : QbeGen, name : String) -> Bool {
  qbe_has_user_callee_at(g, name, Span::{ file: "", line: 0, col: 0 })
}

///|
fn qbe_has_user_callee_at(g : QbeGen, name : String, sp : Span) -> Bool {
  if !qbe_call_is_nonlocal(g, sp) {
    if g.inline_closures.contains(name) {
      return true
    }
    match qbe_lookup_local(g, name) {
      Some(loc) =>
        match loc.ty {
          TFn(_, _) => return true
          _ => ()
        }
      None => ()
    }
  }
  if g.mono_pkg == "" {
    match g.tc.consts.get(name) {
      Some(TFn(_, _)) => return true
      _ => ()
    }
  } else {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        match ipkg.tc.consts.get(name) {
          Some(TFn(_, _)) => return true
          _ => ()
        }
      None => ()
    }
  }
  if g.mono_pkg != "" {
    match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
      Some(ipkg) =>
        if ipkg.tc.fns.contains(name) || ipkg.tc.extern_fns.contains(name) {
          return true
        }
      None => ()
    }
    return false
  }
  g.tc.fns.contains(name) || g.tc.extern_fns.contains(name)
}

///|
fn qbe_emit_const_closure_call(
  g : QbeGen,
  const_sym : String,
  ptys : Array[Ty],
  rty : Ty,
  args : Array[Expr],
) -> QbeVal {
  let clo_ty = TFn(ptys, rty)
  let clo_v = qbe_load_heap_slot(g, const_sym, clo_ty)
  qbe_emit(g, "call $pion_rc_inc(l " + clo_v + ")")
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let guards = qbe_arg_guards_in_order(g, args)
  qbe_guard_callee(g, guards, args, qval(clo_v, clo_ty), false)
  let mut i = 0
  while i < args.length() {
    let ep : Option[Ty] = if i < ptys.length() {
      Some(ptys[i])
    } else {
      None
    }
    let av = qbe_emit_expr(g, args[i], ep)
    arg_vals.push(av.reg)
    arg_tys.push(av.ty)
    qbe_guard_val(
      g,
      guards,
      QbeArgVal::{ qv: av, borrowed: false },
      false,
      guards.exits[i],
    )
    i = i + 1
  }
  qbe_release_guards(g, guards)
  let res = qbe_emit_closure_call(g, clo_v, arg_vals, arg_tys)
  g.block_immut_fields = Map([])
  qval(qbe_from_l(g, res, rty), rty)
}

///|
fn qbe_probe_expr_ty(g : QbeGen, e : Expr) -> Option[Ty] {
  qbe_probe_expr_ty_with(g, e, qbe_hints_new())
}

///|
fn qbe_probe_expr_ty_with(
  g : QbeGen,
  e : Expr,
  hints : QbeProbeHints,
) -> Option[Ty] {
  match e {
    EInt(_, _) => Some(TInt)
    EInt64(_, _) => Some(TInt64)
    EUInt(_, _) => Some(TUInt)
    EUInt64(_, _) => Some(TUInt64)
    EDouble(_, _) => Some(TDouble)
    EFloat(_, _) => Some(TFloat)
    EBool(_, _) => Some(TBool)
    EByte(_, _) => Some(TByte)
    EChar(_, _) => Some(TChar)
    EString(_, _) | EInterp(_, _) => Some(TString)
    EUnit(_) => Some(TUnit)
    EIdent(name, _) =>
      match qbe_hints_get(hints, name) {
        Some(TError) => None
        Some(t) => Some(t)
        None =>
          match qbe_lookup_local(g, name) {
            Some(loc) => Some(loc.ty)
            None =>
              match qbe_lookup_const_ty(g, name) {
                Some(ct) => Some(ct)
                None => if name == "None" { Some(TOption(TError)) } else { None }
              }
          }
      }
    EPath(qual, mem, _) => {
      if g.mono_pkg != "" && !g.tc.in_imported_default_arg && !has_qual_sep(qual) {
        match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
          Some(ipkg) =>
            match ipkg.tc.enums.get(qual) {
              Some(ei) =>
                if ei.decl.type_params.length() == 0 && enum_info_has_variant(ei, mem) {
                  return Some(TEnum(ipkg.name + "::" + qual, []))
                }
              None => ()
            }
          None => ()
        }
      }
      if g.mono_pkg == "" && !g.tc.in_imported_default_arg && !tc_is_imported_pkg_alias(g.tc, qual) {
        match g.tc.enums.get(qual) {
          Some(ei) =>
            if ei.decl.type_params.length() == 0 && enum_info_has_variant(ei, mem) {
              return Some(TEnum(qual, []))
            }
          None => ()
        }
      }
      let qp = split_qual_name(qual)
      if qp.prefix.length() > 0 {
        match qbe_resolve_pkg_in_scope(g, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.enums.get(qp.name) {
              Some(ei) =>
                if ei.decl.type_params.length() == 0 && enum_info_has_variant(ei, mem) {
                  return Some(TEnum(ipkg.name + "::" + qp.name, []))
                }
              None => ()
            }
          None => ()
        }
      }
      match qbe_resolve_pkg_in_scope(g, qual) {
        Some(ipkg) => {
          match ipkg.tc.consts.get(mem) {
            Some(cty) => return Some(qualify_imported_ty(ipkg.name, cty))
            None => ()
          }
          match ipkg.tc.variant_to_enum.get(mem) {
            Some(en) =>
              match ipkg.tc.enums.get(en) {
                Some(ei) =>
                  if ei.decl.type_params.length() == 0 {
                    return Some(TEnum(ipkg.name + "::" + en, []))
                  }
                None => ()
              }
            None => ()
          }
          None
        }
        None => None
      }
    }
    EDotVariant(_, _, sp) =>
      match g.tc.dot_variant_resolve.get(span_key(sp)) {
        Some(ename) =>
          if ename == "Option" || ename == "Result" {
            None
          } else {
            match qbe_lookup_enum_info(g, ename) {
              Some(ei) =>
                if ei.decl.type_params.length() == 0 {
                  Some(TEnum(ename, []))
                } else {
                  None
                }
              None => None
            }
          }
        None => None
      }
    EField(base, fname, _) =>
      match qbe_probe_expr_ty_with(g, base, hints) {
        Some(TStruct(sname, sargs)) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == fname {
                  return Some(subst_ty(sinfo.field_tys[i], subst))
                }
                i = i + 1
              }
              None
            }
            None => None
          }
        _ => None
      }
    EArrayLit(elems, _) => {
      if elems.length() == 0 {
        return Some(TArray(TError))
      }
      let mut i = 0
      while i < elems.length() {
        match qbe_probe_expr_ty_with(g, elems[i], hints) {
          Some(et) =>
            if !ty_has_unresolved(et) {
              return Some(TArray(et))
            }
          None => ()
        }
        i = i + 1
      }
      Some(TArray(TError))
    }
    ETuple(elems, _) => {
      let etys : Array[Ty] = []
      let mut i = 0
      while i < elems.length() {
        match qbe_probe_expr_ty_with(g, elems[i], hints) {
          Some(et) => etys.push(et)
          None => etys.push(TError)
        }
        i = i + 1
      }
      Some(TTuple(etys))
    }
    EStructLit(sname, spread_opt, _, sp) => {
      let tc_st_opt : Option[String] = if g.mono_pkg == "" {
        g.tc.resolved_method_calls.get("st:" + span_key(sp))
      } else {
        match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
          Some(mipkg) =>
            match mipkg.tc.resolved_method_calls.get("st:" + span_key(sp)) {
              Some(rn) =>
                Some(if has_qual_sep(rn) { rn } else { g.mono_pkg + "::" + rn })
              None => None
            }
          None => None
        }
      }
      let resolved_name = match tc_st_opt {
        Some(rn) => rn
        None => qbe_resolve_struct_lit_name(g, sname, true)
      }
      if resolved_name != "" {
        match qbe_lookup_struct_info(g, resolved_name) {
          Some(sinfo) =>
            if sinfo.decl.type_params.length() == 0 {
              return Some(TStruct(resolved_name, []))
            }
          None => return None
        }
      }
      // `..base` has the type of the literal, type arguments included.
      match spread_opt {
        Some(base_e) =>
          match qbe_probe_expr_ty_with(g, base_e, hints) {
            Some(TStruct(bn, bargs)) => {
              let base_name = qbe_resolve_struct_lit_name(g, bn, false)
              let base_ty = TStruct(base_name, bargs)
              match qbe_lookup_struct_info(g, base_name) {
                Some(sinfo) =>
                  if (sname == "" || base_name == resolved_name) &&
                    bargs.length() == sinfo.decl.type_params.length() &&
                    !ty_has_unresolved(base_ty) {
                    Some(base_ty)
                  } else {
                    None
                  }
                None => None
              }
            }
            _ => None
          }
        None => None
      }
    }
    EBlock(stmts, _) => qbe_probe_stmts_ty_with(g, stmts, hints)
    EIf(cond, then_stmts, Some(el), _) => {
      let then_hints = qbe_hints_copy(hints)
      qbe_probe_bind_cond_hints(g, cond, then_hints)
      match qbe_probe_stmts_ty_with(g, then_stmts, then_hints) {
        Some(t) =>
          if !ty_has_unresolved(t) {
            Some(t)
          } else {
            match qbe_probe_expr_ty_with(g, el, hints) {
              Some(e2) => Some(ty_prefer_concrete(t, e2))
              None => Some(t)
            }
          }
        None => qbe_probe_expr_ty_with(g, el, hints)
      }
    }
    EIs(_, _, _) => Some(TBool)
    EMatch(scrut, arms, _) => {
      let scrut_ty_opt = qbe_probe_expr_ty_with(g, scrut, hints)
      qbe_probe_arms_ty_with(g, arms, scrut_ty_opt, None, hints)
    }
    ECall(callee, args, probe_sp) =>
      match callee {
        EIdent(name, _) =>
          if name == "Some" && args.length() == 1 {
            match qbe_probe_expr_ty_with(g, args[0], hints) {
              Some(t) =>
                if !ty_has_unresolved(t) {
                  Some(TOption(t))
                } else {
                  None
                }
              None => None
            }
          } else if name == "StringBuilder" {
            Some(TStringBuilder)
          } else if name == "Map" && args.length() == 1 {
            qbe_call_infer(g, probe_sp, "#map")
          } else {
            // A probe-scope binding (`is` / `match` / `let`) shadows outer
            // locals and fns of the same name, even when its type is unknown,
            // unless type-checking resolved this call site to a nonlocal target.
            let is_nonlocal_call = qbe_call_is_nonlocal(g, probe_sp)
            if !is_nonlocal_call {
              match qbe_hints_get(hints, name) {
                Some(TFn(_, rt)) =>
                  return if !ty_has_unresolved(rt) { Some(rt) } else { None }
                Some(_) => return None
                None => ()
              }
              match g.inline_closures.get(name) {
                Some(iclo) => return Some(iclo.ret_ty)
                None => ()
              }
              match qbe_lookup_local(g, name) {
                Some(loc) =>
                  match loc.ty {
                    TFn(_, rt) =>
                      if !ty_has_unresolved(rt) {
                        return Some(rt)
                      }
                    _ => ()
                  }
                None => ()
              }
            }
            if g.mono_pkg == "" {
              match g.tc.consts.get(name) {
                Some(TFn(_, rt)) =>
                  if !ty_has_unresolved(rt) {
                    return Some(rt)
                  }
                _ => ()
              }
              match g.tc.fns.get(name) {
                Some(finfo) => qbe_probe_call_ret_ty(g, finfo, args, hints)
                None => None
              }
            } else {
              match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
                Some(ipkg) => {
                  match ipkg.tc.consts.get(name) {
                    Some(TFn(_, rt)) => {
                      let qrt = qualify_imported_ty(g.mono_pkg, rt)
                      if !ty_has_unresolved(qrt) {
                        return Some(qrt)
                      }
                    }
                    _ => ()
                  }
                  match ipkg.tc.fns.get(name) {
                    Some(finfo) =>
                      qbe_probe_call_ret_ty(g, qualify_fn_info(ipkg, finfo), args, hints)
                    None => None
                  }
                }
                None => None
              }
            }
          }
        EPath(qual, mem, _) =>
          if qual == "StringBuilder" && (mem == "new" || mem == "with_capacity") {
            Some(TStringBuilder)
          } else {
          match qbe_resolve_pkg_in_scope(g, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(finfo) =>
                  qbe_probe_call_ret_ty(g, qualify_fn_info(ipkg, finfo), args, hints)
                None => None
              }
            None => None
          }
          }
        _ => None
      }
    EMethodCall(recv, mname, _, sp) => {
      match qbe_lookup_expected_trait(g, sp) {
        Some(tr) =>
          return match qbe_probe_expr_ty_with(g, recv, hints) {
            Some(recv_ty) =>
              match qbe_find_impl_method(g, recv_ty, mname, Some(tr)) {
                Some(imatch) => Some(imatch.finfo.ret_ty)
                None => None
              }
            None => None
          }
        None => ()
      }
      match qbe_probe_expr_ty_with(g, recv, hints) {
        Some(TString) =>
          if mname == "split" {
            Some(TArray(TString))
          } else if mname == "length" || mname == "code_unit_at" {
            Some(TInt)
          } else if mname == "trim" || mname == "slice" || mname == "to_string" {
            Some(TString)
          } else {
            None
          }
        Some(TArray(et)) =>
          if mname == "copy" && !ty_has_unresolved(et) {
            Some(TArray(et))
          } else if mname == "to_imm" && !ty_has_unresolved(et) {
            Some(TImmArray(et))
          } else if mname == "length" {
            Some(TInt)
          } else if mname == "is_empty" {
            Some(TBool)
          } else if mname == "join" {
            Some(TString)
          } else {
            None
          }
        Some(TFixedArray(_)) =>
          if mname == "length" {
            Some(TInt)
          } else {
            None
          }
        Some(TImmArray(et)) =>
          if mname == "copy" && !ty_has_unresolved(et) {
            Some(TImmArray(et))
          } else if mname == "to_array" && !ty_has_unresolved(et) {
            Some(TArray(et))
          } else if mname == "length" {
            Some(TInt)
          } else if mname == "is_empty" {
            Some(TBool)
          } else {
            None
          }
        Some(TBytes) =>
          if mname == "length" {
            Some(TInt)
          } else if mname == "read_i8" {
            Some(TInt8)
          } else if mname == "read_f32_le" {
            Some(TFloat)
          } else if mname == "to_string" {
            Some(TString)
          } else {
            None
          }
        Some(TStrView) | Some(TBytesView) =>
          if mname == "length" {
            Some(TInt)
          } else if mname == "to_string" {
            Some(TString)
          } else {
            None
          }
        Some(TStringBuilder) =>
          if mname == "to_string" {
            Some(TString)
          } else {
            None
          }
        Some(TMap(k, v)) =>
          if mname == "copy" && !ty_has_unresolved(v) {
            Some(TMap(k, v))
          } else if mname == "keys" {
            Some(TArray(k))
          } else if mname == "length" {
            Some(TInt)
          } else {
            None
          }
        Some(st) =>
          match st {
            TDouble | TFloat | TInt | TInt64 | TUInt | TUInt64 | TByte | TInt8 | TChar | TBool =>
              if mname == "to_string" {
                Some(TString)
              } else if mname == "to_int" ||
                mname == "reinterpret_as_int" ||
                mname == "leading_zeros" ||
                mname == "trailing_zeros" ||
                mname == "count_ones" ||
                mname == "compare" {
                Some(TInt)
              } else if mname == "is_nan" || mname == "is_inf" || mname == "is_finite" {
                Some(TBool)
              } else if mname == "to_int64" || mname == "reinterpret_as_int64" {
                Some(TInt64)
              } else if mname == "to_uint" || mname == "reinterpret_as_uint" {
                Some(TUInt)
              } else if mname == "to_uint64" || mname == "reinterpret_as_uint64" {
                Some(TUInt64)
              } else if mname == "to_double" || mname == "reinterpret_as_double" {
                Some(TDouble)
              } else if mname == "to_float" || mname == "reinterpret_as_float" {
                Some(TFloat)
              } else if mname == "to_byte" {
                Some(TByte)
              } else if mname == "to_int8" {
                Some(TInt8)
              } else if mname == "unsafe_to_char" {
                Some(TChar)
              } else if mname == "sqrt" ||
                mname == "cbrt" ||
                mname == "abs" ||
                mname == "floor" ||
                mname == "ceil" ||
                mname == "round" ||
                mname == "trunc" ||
                mname == "sin" ||
                mname == "cos" ||
                mname == "tan" ||
                mname == "asin" ||
                mname == "acos" ||
                mname == "atan" ||
                mname == "atan2" ||
                mname == "exp" ||
                mname == "ln" ||
                mname == "log" ||
                mname == "pow" ||
                mname == "min" ||
                mname == "max" ||
                mname == "clamp" ||
                mname == "rotate_left" ||
                mname == "rotate_right" ||
                mname == "lnot" {
                Some(st)
              } else {
                None
              }
            TStruct(sn, sargs) | TEnum(sn, sargs) =>
              if sargs.length() == 0 {
                match qbe_lookup_method_info(g, sn, mname) {
                  Some(mi) =>
                    if mi.decl.type_params.length() == 0 && !ty_has_unresolved(mi.ret_ty) {
                      Some(mi.ret_ty)
                    } else {
                      None
                    }
                  None => None
                }
              } else {
                None
              }
            _ => None
          }
        None => None
      }
    }
    EIndex(obj, _, _) =>
      match qbe_probe_expr_ty_with(g, obj, hints) {
        Some(TArray(et)) | Some(TFixedArray(et)) | Some(TImmArray(et)) =>
          if !ty_has_unresolved(et) { Some(et) } else { None }
        Some(TBytes) => Some(TByte)
        _ => None
      }
    EUnary(op, inner, _) =>
      if op == "!" {
        Some(TBool)
      } else {
        qbe_probe_expr_ty_with(g, inner, hints)
      }
    EBinary(op, lhs, rhs, _) =>
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||" {
        Some(TBool)
      } else if op == "<<" || op == ">>" {
        // A shift has the type of its left operand; the count's type says nothing.
        qbe_probe_expr_ty_with(g, lhs, hints)
      } else {
        match qbe_probe_expr_ty_with(g, lhs, hints) {
          Some(t) => Some(t)
          None => qbe_probe_expr_ty_with(g, rhs, hints)
        }
      }
    EMove(inner, _) => qbe_probe_expr_ty_with(g, inner, hints)
    EAs(_, ty_e, _) => Some(qbe_resolve_type(g, ty_e))
    ETry(inner, _) =>
      match qbe_probe_expr_ty_with(g, inner, hints) {
        Some(TOption(inner_ty)) => Some(inner_ty)
        Some(TResult(ok_ty, _)) => Some(ok_ty)
        _ => None
      }
    _ => None
  }
}

///|
fn qbe_probe_arms_ty(
  g : QbeGen,
  arms : Array[MatchArm],
  scrut_ty_opt : Option[Ty],
  expected : Option[Ty],
) -> Option[Ty] {
  qbe_probe_arms_ty_with(g, arms, scrut_ty_opt, expected, qbe_hints_new())
}

///|
fn qbe_probe_arms_ty_with(
  g : QbeGen,
  arms : Array[MatchArm],
  scrut_ty_opt : Option[Ty],
  expected : Option[Ty],
  outer_hints : QbeProbeHints,
) -> Option[Ty] {
  match expected {
    Some(et) =>
      if !ty_has_unresolved(et) {
        return expected
      }
    None => ()
  }
  let mut acc : Option[Ty] = expected
  let mut i = 0
  while i < arms.length() {
    let arm_hints = qbe_hints_copy(outer_hints)
    qbe_bind_pat_probe_hints(g, arms[i].pat, scrut_ty_opt, arm_hints)
    match qbe_probe_expr_ty_with(g, arms[i].body, arm_hints) {
      Some(t) => {
        let merged = match acc {
          Some(cur) => ty_prefer_concrete(cur, t)
          None => t
        }
        acc = Some(merged)
        if !ty_has_unresolved(merged) {
          return acc
        }
      }
      None => ()
    }
    i = i + 1
  }
  acc
}

///|
fn qbe_probe_switch_arms_ty(
  g : QbeGen,
  arms : Array[QbeSwitchArm],
  default_expr_opt : Option[Expr],
  default_bind_name : String,
  expected : Option[Ty],
) -> Option[Ty] {
  match expected {
    Some(et) =>
      if !ty_has_unresolved(et) {
        return expected
      }
    None => ()
  }
  let base_hints = qbe_hints_new()
  let mut acc : Option[Ty] = expected
  let mut i = 0
  while i < arms.length() {
    let probed = match arms[i].expr_opt {
      Some(e) => qbe_probe_expr_ty_with(g, e, base_hints)
      None => qbe_probe_stmts_ty_with(g, arms[i].stmts, base_hints)
    }
    match probed {
      Some(t) => {
        let merged = match acc {
          Some(cur) => ty_prefer_concrete(cur, t)
          None => t
        }
        acc = Some(merged)
        if !ty_has_unresolved(merged) {
          return acc
        }
      }
      None => ()
    }
    i = i + 1
  }
  match default_expr_opt {
    Some(de) => {
      let def_hints = qbe_hints_copy(base_hints)
      if default_bind_name != "" && default_bind_name != "_" {
        qbe_hints_set(def_hints, default_bind_name, TInt)
      }
      match qbe_probe_expr_ty_with(g, de, def_hints) {
        Some(t) => {
          let merged = match acc {
            Some(cur) => ty_prefer_concrete(cur, t)
            None => t
          }
          acc = Some(merged)
        }
        None => ()
      }
    }
    None => ()
  }
  acc
}

///| No call, index, conversion, panic or early return may intervene between
/// obtaining a slot and storing its new value. Extend this total fragment only
/// when effects and reallocation have been ruled out.
struct QbeScalarEntryPlan {
  map_expr : Expr
  key_name : String
  old_name : String
  value_ty : Ty
  on_hit : Expr
  on_miss : Expr
}

///|
fn qbe_total_entry_value(g : QbeGen, e : Expr, old : String) -> Bool {
  match e {
    EInt(_, _) | EInt64(_, _) => true
    EIdent(n, _) => n == old || match qbe_lookup_local(g, n) {
      Some(loc) => match loc.ty { TInt | TInt64 => true
        _ => false }
      None => false
    }
    EBinary(op, a, b, _) =>
      (op == "+" || op == "-" || op == "*" || op == "&" || op == "|" || op == "^") &&
        qbe_total_entry_value(g, a, old) && qbe_total_entry_value(g, b, old)
    _ => false
  }
}

///|
fn qbe_entry_plan(g : QbeGen, e : Expr, arms : Array[MatchArm]) -> Option[QbeScalarEntryPlan] {
  if g.target_wasm || arms.length() != 2 { return None }
  let (map_expr, map_name, key) = match e {
    EMethodCall(obj, "get", args, sp) => {
      if args.length() != 1 || qbe_has_expected_trait(g, sp) { return None }
      match (obj, args[0]) {
        (EIdent(m, _), EIdent(k, _)) => (obj, m, k)
        _ => return None
      }
    }
    _ => return None
  }
  let value_ty = match qbe_peek_expr_ty(g, map_expr) {
    Some(TMap(TString, TInt64)) => TInt64
    Some(TMap(TString, TInt)) => TInt
    _ => return None
  }
  let mut old = ""
  let mut hit : Option[Expr] = None
  let mut miss : Option[Expr] = None
  for arm in arms {
    match arm.guard_expr { Some(_) => return None
      None => () }
    let value = match arm.body {
      EMethodCall(EIdent(m, _), "set", args, sp) => {
        if m != map_name || args.length() != 2 || qbe_has_expected_trait(g, sp) { return None }
        match args[0] { EIdent(k, _) => if k != key { return None }
          _ => return None }
        args[1]
      }
      _ => return None
    }
    match arm.pat {
      PVariant(q, "Some", ps, _, _) => {
        if (q != "" && q != "Option") || ps.length() != 1 { return None }
        old = match ps[0] { PIdent(n, _) => n
          PWild(_) => ""
          _ => return None }
        if old == map_name || old == key || !qbe_total_entry_value(g, value, old) { return None }
        hit = Some(value)
      }
      PVariant(q, "None", ps, _, _) => {
        if (q != "" && q != "Option") || ps.length() != 0 || !qbe_total_entry_value(g, value, "") { return None }
        miss = Some(value)
      }
      _ => return None
    }
  }
  match (hit, miss) {
    (Some(h), Some(m)) => Some(QbeScalarEntryPlan::{
      map_expr: map_expr, key_name: key, old_name: old, value_ty: value_ty, on_hit: h, on_miss: m,
    })
    _ => None
  }
}

///| Both arms perform a scalar store. Normalize the presence test into the
/// same entry plan, with no binding for the old value.
fn qbe_contains_plan(g : QbeGen, cond : Expr, body : Array[Stmt], other : Option[Expr]) -> Option[QbeScalarEntryPlan] {
  match cond {
    EMethodCall(obj, "contains", args, sp) => {
      if body.length() != 1 || qbe_has_expected_trait(g, sp) { return None }
      let a = match body[0] { SExpr(e, _) => e
        _ => return None }
      let b = match other {
        Some(EBlock(ss, _)) => {
          if ss.length() != 1 { return None }
          match ss[0] { SExpr(e, _) => e
            _ => return None }
        }
        _ => return None
      }
      let yes = MatchArm::{pat: PVariant("Option", "Some", [PWild(sp)], false, sp), guard_expr: None, body: a, span: sp}
      let no = MatchArm::{pat: PVariant("Option", "None", [], false, sp), guard_expr: None, body: b, span: sp}
      qbe_entry_plan(g, EMethodCall(obj, "get", args, sp), [yes, no])
    }
    _ => None
  }
}

///|
fn qbe_emit_whole_entry(g : QbeGen, p : QbeScalarEntryPlan, key_expr : Expr) -> QbeVal {
  let key = qbe_emit_arg_maybe_borrow(g, key_expr, Some(TString), true)
  let _ = qbe_emit_entry_plan(g, p, "0", "0", key.qv.reg, false)
  if !key.borrowed { qbe_rc_dec(g, key.qv.reg, TString) }
  qval("0", TUnit)
}

///| One probe (`pion_map_scalar_entry`) returns the value slot of a present
/// key, which the hit value overwrites in place; a miss evaluates the value and
/// inserts through `pion_map_set`, materializing a span key only then. With
/// `keep`, returns an owned reference to the stored key (the resident key on a
/// hit, read from its `PionMapEntry`; the fresh key on a miss) for later
/// concatenations; identity-sensitive uses are excluded by the caller.
fn qbe_emit_entry_plan(
  g : QbeGen, plan : QbeScalarEntryPlan, data : String, len : String, whole : String, keep : Bool,
) -> String {
  let map = qbe_emit_arg_maybe_borrow(g, plan.map_expr, None, true)
  let result = if keep { qbe_alloc_slot(g) } else { "0" }
  let slot = qbe_tmp(g)
  qbe_emit(g, slot + " =l call $pion_map_scalar_entry(l " + map.qv.reg + ", l " + data +
    ", l " + len + ", l " + whole + ")")
  let hw = qbe_tmp(g)
  qbe_emit(g, hw + " =w cnel " + slot + ", 0")
  let hit = qbe_lbl(g, "entry_hit")
  let miss = qbe_lbl(g, "entry_miss")
  let done = qbe_lbl(g, "entry_done")
  qbe_emit_term(g, "jnz " + hw + ", " + hit + ", " + miss)
  qbe_emit_lbl(g, hit)
  qbe_scope_push(g)
  if plan.old_name != "" && plan.old_name != "_" {
    let raw = qbe_tmp(g)
    qbe_emit(g, raw + " =l loadl " + slot)
    let local = qbe_define_local(g, plan.old_name, plan.value_ty, false)
    qbe_store_local_slot(g, qbe_from_l(g, raw, plan.value_ty), local.slot, plan.value_ty)
  }
  let hv = qbe_emit_expr(g, plan.on_hit, Some(plan.value_ty))
  qbe_emit(g, "storel " + qbe_as_l(g, hv) + ", " + slot)
  qbe_scope_pop(g)
  if keep {
    // PionMapEntry { key, hash, val, .. }: the key sits 16 bytes before val.
    let kp = qbe_tmp(g)
    let k = qbe_tmp(g)
    qbe_emit(g, kp + " =l sub " + slot + ", 16")
    qbe_emit(g, k + " =l loadl " + kp)
    qbe_rc_inc(g, k, TString)
    qbe_emit(g, "storel " + k + ", " + result)
  }
  qbe_emit_term(g, "jmp " + done)
  qbe_emit_lbl(g, miss)
  let mv = qbe_emit_expr(g, plan.on_miss, Some(plan.value_ty))
  let mvl = qbe_as_l(g, mv)
  let key = if whole != "0" { whole } else {
    let k = qbe_tmp(g)
    qbe_emit(g, k + " =l call $pion_str_from_cstr(l " + data + ", l " + len + ")")
    k
  }
  qbe_emit(g, "call $pion_map_set(l " + map.qv.reg + ", l " + key + ", l " + mvl + ")")
  if keep {
    qbe_emit(g, "storel " + key + ", " + result)
  } else if whole == "0" {
    qbe_rc_dec(g, key, TString)
  }
  qbe_emit_term(g, "jmp " + done)
  qbe_emit_lbl(g, done)
  let retained = if keep {
    let k = qbe_tmp(g)
    qbe_emit(g, k + " =l loadl " + result)
    k
  } else { "0" }
  if !map.borrowed { qbe_rc_dec(g, map.qv.reg, map.qv.ty) }
  retained
}

///| Permit only whole leaves of a real string concatenation after the update.
/// Any closure capture, key identity test, raw pointer, alias, or passing the
/// key itself to another operation retains ordinary slice allocation.
fn qbe_key_value_use(e : Expr, name : String) -> Bool {
  if !qbe_expr_mentions_ident(e, name) { return true }
  match e {
    EBinary("+", l, r, _) => {
      for part in qbe_string_add_parts(l, r) {
        match part { EIdent(_, _) => ()
          _ => if qbe_expr_mentions_ident(part, name) { return false } }
      }
      true
    }
    EIf(cond, body, other, _) => {
      if qbe_expr_mentions_ident(cond, name) { return false }
      for st in body { if !qbe_key_value_stmt(st, name) { return false } }
      match other { Some(x) => qbe_key_value_use(x, name)
        None => true }
    }
    _ => false
  }
}

///|
fn qbe_key_value_stmt(st : Stmt, name : String) -> Bool {
  match st {
    SLet(_, _, _, e, _) | SExpr(e, _) => qbe_key_value_use(e, name)
    _ => !qbe_stmt_mentions_ident(st, name)
  }
}

///|
///| 0: not applied; 1: applied; 2: applied and defined the local `ss[i]` names.
fn qbe_try_slice_entry(g : QbeGen, ss : Array[Stmt], i : Int) -> Int {
  if g.target_wasm || i + 1 >= ss.length() { return 0 }
  let (name, slice) = match ss[i] {
    SLet(n, false, _, e, _) => (n, e)
    _ => return 0
  }
  if !qbe_is_str_slice(g, slice) { return 0 }
  let plan = match ss[i + 1] {
    SExpr(EMatch(e, arms, _), _) => match qbe_entry_plan(g, e, arms) {
      Some(p) => p
      None => return 0
    }
    SExpr(EIf(cond, body, other, _), _) => match qbe_contains_plan(g, cond, body, other) {
      Some(p) => p
      None => return 0
    }
    _ => return 0
  }
  if name != plan.key_name || qbe_expr_mentions_ident(plan.map_expr, name) ||
    qbe_expr_mentions_ident(plan.on_hit, name) || qbe_expr_mentions_ident(plan.on_miss, name) { return 0 }
  let mut keep = false
  let mut j = i + 2
  while j < ss.length() {
    if qbe_stmt_mentions_ident(ss[j], name) {
      if !qbe_key_value_stmt(ss[j], name) { return 0 }
      keep = true
    }
    j = j + 1
  }
  qbe_scope_push(g)
  let (p, n) = qbe_checked_str_span(g, slice, !qbe_expr_has_assign(slice))
  let key = if g.block_term { "0" } else { qbe_emit_entry_plan(g, plan, p, n, "0", keep) }
  qbe_scope_pop(g)
  if keep && !g.block_term {
    qbe_clear_shadowed_local_meta(g, name)
    let local = qbe_define_local(g, name, TString, true)
    qbe_store_local_slot(g, key, local.slot, TString)
    return 2
  }
  1
}

///|
fn qbe_try_emit_map_get_match(
  g : QbeGen,
  scrut : Expr,
  arms : Array[MatchArm],
  expected : Option[Ty],
) -> Option[QbeVal] {
  match scrut {
    EMethodCall(map_expr, mname, margs, msp) => {
      if mname != "get" || margs.length() != 1 || arms.length() != 2 || qbe_has_expected_trait(g, msp) {
        return None
      }
      match arms[0].guard_expr {
        Some(_) => return None
        None => ()
      }
      match arms[1].guard_expr {
        Some(_) => return None
        None => ()
      }
      let mut kty = TError
      let mut vty = TError
      match qbe_peek_expr_ty(g, map_expr) {
        Some(TMap(k, v)) => {
          kty = k
          vty = v
        }
        _ => return None
      }
      let mut matched = false
      let mut some_idx = 0
      let mut none_idx = 1
      let mut some_bind = ""
      match arms[0].pat {
        PVariant(q, vn, subs, _, _) =>
          if (q == "" || q == "Option") && vn == "Some" && subs.length() == 1 {
            let mut sub_ok = false
            match subs[0] {
              PIdent(vname, _) => {
                some_bind = vname
                sub_ok = true
              }
              PWild(_) => {
                some_bind = ""
                sub_ok = true
              }
              _ => ()
            }
            if sub_ok {
              match arms[1].pat {
                PVariant(q2, vn2, subs2, _, _) =>
                  if (q2 == "" || q2 == "Option") &&
                    vn2 == "None" &&
                    subs2.length() == 0 {
                    matched = true
                    some_idx = 0
                    none_idx = 1
                  }
                PWild(_) => {
                  matched = true
                  some_idx = 0
                  none_idx = 1
                }
                _ => ()
              }
            }
          } else if (q == "" || q == "Option") &&
            vn == "None" &&
            subs.length() == 0 {
            match arms[1].pat {
              PVariant(q2, vn2, subs2, _, _) =>
                if (q2 == "" || q2 == "Option") &&
                  vn2 == "Some" &&
                  subs2.length() == 1 {
                  match subs2[0] {
                    PIdent(vname, _) => {
                      some_bind = vname
                      matched = true
                      some_idx = 1
                      none_idx = 0
                    }
                    PWild(_) => {
                      some_bind = ""
                      matched = true
                      some_idx = 1
                      none_idx = 0
                    }
                    _ => ()
                  }
                }
              _ => ()
            }
          }
        _ => ()
      }
      if !matched {
        return None
      }
      match qbe_entry_plan(g, scrut, arms) {
        Some(plan) => return Some(qbe_emit_whole_entry(g, plan, margs[0]))
        None => ()
      }
      qbe_scope_push(g)
      let key_expr = margs[0]
      let args_pure = !qbe_expr_has_assign(key_expr)
      let obj_av = qbe_emit_arg_maybe_borrow(g, map_expr, None, args_pure)
      let out_slot = qbe_alloc_slot(g)
      let hw = qbe_tmp(g)
      if qbe_is_vmap_key_ty(g, kty) {
        let m = qbe_ensure_vmap_fns(g, kty, vty)
        let vka = qbe_emit_vmap_key_args(g, key_expr, kty, args_pure)
        qbe_emit(
          g,
          hw +
          " =w call $pion_vmap_try_get_" +
          m +
          "(l " +
          obj_av.qv.reg +
          qbe_vmap_key_call_args(vka) +
          ", l " +
          out_slot +
          ")",
        )
      } else {
        let ka = qbe_emit_arg_maybe_borrow_ext(
          g,
          key_expr,
          Some(kty),
          args_pure,
          args_pure && qbe_loop_has_no_calls_expr(g, key_expr),
        )
        let kl = qbe_as_l(g, ka.qv)
        qbe_emit(
          g,
          hw +
          " =w call $pion_map_try_get(l " +
          obj_av.qv.reg +
          ", l " +
          kl +
          ", l " +
          out_slot +
          ")",
        )
        if !ka.borrowed {
          qbe_rc_dec(g, ka.qv.reg, ka.qv.ty)
        }
      }
      if !obj_av.borrowed {
        let mloc = qbe_define_local(g, "__mget_map", obj_av.qv.ty, true)
        qbe_store_local_slot(g, obj_av.qv.reg, mloc.slot, obj_av.qv.ty)
      }
      let l_hit = qbe_lbl(g, "mget_some")
      let l_miss = qbe_lbl(g, "mget_none")
      let l_end = qbe_lbl(g, "mget_end")
      qbe_emit_term(g, "jnz " + hw + ", " + l_hit + ", " + l_miss)
      let mut res_slot = ""
      let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
        g,
        arms,
        Some(TOption(vty)),
        expected,
      )
      let mut saw_untyped_none = false
      qbe_emit_lbl(g, l_hit)
      qbe_scope_push(g)
      let mget_dp_pinned : Array[String] = []
      if some_bind != "" {
        let raw_l = qbe_tmp(g)
        qbe_emit(g, raw_l + " =l loadl " + out_slot)
        let v_val = qbe_from_l(g, raw_l, vty)
        qbe_rc_inc(g, v_val, vty)
        let vloc = qbe_define_local(g, some_bind, vty, true)
        qbe_store_local_slot(g, v_val, vloc.slot, vty)
        if qbe_expr_has_any_data_ptr(arms[some_idx].body) &&
          qbe_expr_takes_data_ptr(arms[some_idx].body, some_bind) {
          qbe_pin_slot(g, vloc.slot, mget_dp_pinned)
        }
      }
      let sv = qbe_emit_expr(g, arms[some_idx].body, res_ty)
      qbe_unpin_slot_list(g, mget_dp_pinned)
      match res_ty {
        None =>
          match sv.ty {
            TNever => ()
            _ => {
              if qbe_ty_has_untyped_option(sv.ty) {
                saw_untyped_none = true
              }
              res_ty = Some(sv.ty)
            }
          }
        Some(rt) => {
          if qbe_ty_has_untyped_option(sv.ty) {
            saw_untyped_none = true
          }
          res_ty = Some(ty_prefer_concrete(rt, sv.ty))
        }
      }
      let some_term = g.block_term
      if !some_term {
        let store_ty = match res_ty {
          Some(t) => t
          None => sv.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, sv, store_ty), res_slot, store_ty)
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_miss)
      qbe_scope_push(g)
      let nv = qbe_emit_expr(g, arms[none_idx].body, res_ty)
      match res_ty {
        None =>
          match nv.ty {
            TNever => ()
            _ => {
              if qbe_ty_has_untyped_option(nv.ty) {
                saw_untyped_none = true
              }
              res_ty = Some(nv.ty)
            }
          }
        Some(rt) => {
          if qbe_ty_has_untyped_option(nv.ty) {
            saw_untyped_none = true
          }
          res_ty = Some(ty_prefer_concrete(rt, nv.ty))
        }
      }
      let none_term = g.block_term
      if !none_term {
        let store_ty = match res_ty {
          Some(t) => t
          None => nv.ty
        }
        if res_slot == "" {
          res_slot = qbe_alloc_slot_for(g, store_ty)
        }
        qbe_store_local_slot(g, qbe_coerce_val(g, nv, store_ty), res_slot, store_ty)
      }
      qbe_scope_pop(g)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      qbe_scope_pop(g)
      let final_ty = match res_ty {
        Some(t) => t
        None =>
          if some_term && none_term {
            TNever
          } else {
            TUnit
          }
      }
      if res_slot == "" {
        Some(qval(qbe_zero_reg(final_ty), final_ty))
      } else {
        let mut r = qbe_load_local_slot(g, res_slot, final_ty)
        if saw_untyped_none {
          r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
        }
        Some(qval(r, final_ty))
      }
    }
    _ => None
  }
}

///|
fn qbe_emit_extern_fn_call(
  g : QbeGen,
  einfo : ExternFnInfo,
  args : Array[Expr],
) -> QbeVal {
  let can_borrow = !qbe_args_may_mutate_locals(g, args)
  let guards = qbe_arg_guards_in_order(g, args)
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let owned_vals : Array[String] = []
  let owned_tys : Array[Ty] = []
  let mut i = 0
  while i < args.length() {
    let decl_pty = if i < einfo.param_tys.length() {
      einfo.param_tys[i]
    } else {
      TInt64
    }
    let aa = qbe_emit_arg_maybe_borrow(g, args[i], Some(decl_pty), can_borrow)
    let av = aa.qv
    if !aa.borrowed && qbe_is_obj_ty(g, av.ty) {
      owned_vals.push(av.reg)
      owned_tys.push(av.ty)
    }
    let cabi = qbe_c_abi_ty(decl_pty)
    let src_abi = qbe_abi_ty(av.ty)
    let carg = if src_abi == cabi {
      av.reg
    } else if cabi == "w" && src_abi == "l" {
      let w = qbe_tmp(g)
      qbe_emit(g, w + " =w copy " + av.reg)
      w
    } else if cabi == "l" && src_abi == "w" {
      let l = qbe_tmp(g)
      if qbe_is_uint32_ty(av.ty) {
        qbe_emit(g, l + " =l extuw " + av.reg)
      } else {
        qbe_emit(g, l + " =l extsw " + av.reg)
      }
      l
    } else {
      qbe_coerce_val(g, av, decl_pty)
    }
    call_args.push(carg)
    call_abis.push(cabi)
    qbe_guard_val(g, guards, aa, false, guards.exits[i])
    i = i + 1
  }
  qbe_release_guards(g, guards)
  let sb = StringBuilder()
  let is_unit = match einfo.ret_ty {
    TUnit => true
    _ => false
  }
  let raw_res = if is_unit { "" } else { qbe_tmp(g) }
  if !is_unit {
    sb.write_string(raw_res)
    sb.write_string(" =")
    sb.write_string(qbe_c_abi_ty(einfo.ret_ty))
    sb.write_string(" ")
  }
  sb.write_string("call $")
  sb.write_string(einfo.decl.c_symbol)
  sb.write_string("(")
  i = 0
  while i < call_args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    if einfo.decl.vararg_from >= 0 && i == einfo.decl.vararg_from {
      sb.write_string("..., ")
    }
    sb.write_string(call_abis[i])
    sb.write_string(" ")
    sb.write_string(call_args[i])
    i = i + 1
  }
  if einfo.decl.vararg_from >= 0 && einfo.decl.vararg_from == call_args.length() {
    if call_args.length() > 0 {
      sb.write_string(", ")
    }
    sb.write_string("...")
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  let mut oi = 0
  while oi < owned_vals.length() {
    qbe_rc_dec(g, owned_vals[oi], owned_tys[oi])
    oi = oi + 1
  }
  if is_unit {
    return qval("0", TUnit)
  }
  match einfo.ret_ty {
    TBool => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + raw_res)
      qval(rl, TBool)
    }
    TByte => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extub " + raw_res)
      qval(rl, TByte)
    }
    TInt8 => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extsb " + raw_res)
      qval(rl, TInt8)
    }
    TChar => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + raw_res)
      qval(rl, TChar)
    }
    _ => qval(raw_res, einfo.ret_ty)
  }
}

///|
fn qbe_emit_rt_prim_call(g : QbeGen, pr : RtPrim, args : Array[Expr]) -> QbeVal {
  let can_borrow = !qbe_args_may_mutate_locals(g, args)
  let off = if pr.world { 1 } else { 0 }
  let guards = qbe_arg_guards_in_order(g, args)
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let owned_vals : Array[String] = []
  let owned_tys : Array[Ty] = []
  let mut i = 0
  while i < args.length() {
    let pty = if i < off {
      TWorld
    } else if i - off < pr.param_tys.length() {
      pr.param_tys[i - off]
    } else {
      TInt64
    }
    let av = qbe_emit_arg_maybe_borrow(g, args[i], Some(pty), can_borrow)
    if !av.borrowed && qbe_is_obj_ty(g, av.qv.ty) {
      owned_vals.push(av.qv.reg)
      owned_tys.push(av.qv.ty)
    }
    let cabi = if (
      pr.c_sym == "pion_bytes_from_ptr" || pr.c_sym == "pion_bytes_copy_to_ptr"
    ) &&
      qbe_c_abi_ty(pty) == "w" {
      "l"
    } else {
      qbe_c_abi_ty(pty)
    }
    let src_abi = qbe_abi_ty(av.qv.ty)
    let carg = if src_abi == cabi {
      av.qv.reg
    } else if cabi == "w" && src_abi == "l" {
      let w = qbe_tmp(g)
      qbe_emit(g, w + " =w copy " + av.qv.reg)
      w
    } else if cabi == "l" && src_abi == "w" {
      let l = qbe_tmp(g)
      qbe_emit(g, l + " =l extsw " + av.qv.reg)
      l
    } else {
      qbe_coerce_val(g, av.qv, pty)
    }
    call_args.push(carg)
    call_abis.push(cabi)
    qbe_guard_val(g, guards, av, false, guards.exits[i])
    i = i + 1
  }
  qbe_release_guards(g, guards)
  let mut target_sym = pr.c_sym
  let mut emit_args = call_args
  let mut emit_abis = call_abis
  let mut force_ret_abi = ""
  if pr.c_sym == "pion_simd_dot_i8" || pr.c_sym == "pion_simd_dot_i8_bytes" {
    let is_b = if pr.c_sym == "pion_simd_dot_i8_bytes" { "1" } else { "0" }
    target_sym = "pion_simd_i8_dot"
    emit_args = [call_args[0], is_b, call_args[1], call_args[2], call_args[3], call_args[4]]
    emit_abis = ["l", "w", "w", "l", "w", "w"]
  } else if pr.c_sym == "pion_simd_matvec_i8_f32" ||
    pr.c_sym == "pion_simd_matvec_i8_bytes_f32" {
    let is_b = if pr.c_sym == "pion_simd_matvec_i8_bytes_f32" { "1" } else { "0" }
    target_sym = "pion_simd_i8_mv"
    emit_args = [
      call_args[0], call_args[1], call_args[2], is_b, call_args[3],
      call_args[4], call_args[5], call_args[6], call_args[7],
      call_args[8], call_args[9], call_args[10],
    ]
    emit_abis = ["l", "w", "l", "w", "w", "l", "w", "l", "w", "s", "w", "w"]
  } else if pr.c_sym == "pion_simd_dot_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["0", call_args[0], call_args[1], call_args[2], call_args[3], "0", "0", "s_0.0", call_args[4]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_axpy_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["1", call_args[0], call_args[1], call_args[2], call_args[3], "0", "0", call_args[4], call_args[5]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_mul_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["2", call_args[0], call_args[1], call_args[2], call_args[3], call_args[4], call_args[5], "s_0.0", call_args[6]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_add_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["3", call_args[0], call_args[1], call_args[2], call_args[3], call_args[4], call_args[5], "s_0.0", call_args[6]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_scale_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["4", call_args[0], call_args[1], call_args[2], call_args[3], "0", "0", call_args[4], call_args[5]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_mul_dot_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["5", call_args[0], call_args[1], call_args[2], call_args[3], call_args[4], call_args[5], "s_0.0", call_args[6]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  } else if pr.c_sym == "pion_simd_axpy_dot_f32" {
    target_sym = "pion_simd_f32"
    force_ret_abi = "s"
    emit_args = ["6", call_args[0], call_args[1], call_args[2], call_args[3], call_args[5], call_args[6], call_args[4], call_args[7]]
    emit_abis = ["w", "l", "w", "l", "w", "l", "w", "s", "w"]
  }
  let is_unit = match pr.ret_ty {
    TUnit => true
    _ => false
  }
  let sb = StringBuilder()
  let emit_has_ret = !is_unit || force_ret_abi != ""
  let res = if emit_has_ret { qbe_tmp(g) } else { "" }
  if emit_has_ret {
    sb.write_string(res)
    sb.write_string(" =")
    sb.write_string(if force_ret_abi != "" { force_ret_abi } else { qbe_c_abi_ty(pr.ret_ty) })
    sb.write_string(" ")
  }
  sb.write_string("call $")
  sb.write_string(target_sym)
  sb.write_string("(")
  i = 0
  while i < emit_args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(emit_abis[i])
    sb.write_string(" ")
    sb.write_string(emit_args[i])
    i = i + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  i = 0
  while i < owned_vals.length() {
    qbe_rc_dec(g, owned_vals[i], owned_tys[i])
    i = i + 1
  }
  match pr.ret_ty {
    TUnit => qval("0", TUnit)
    // C returns `int32_t` 0/1; a Pion `Bool` lives in a 64-bit slot.
    TBool => {
      let rl = qbe_tmp(g)
      qbe_emit(g, rl + " =l extuw " + res)
      qval(rl, TBool)
    }
    _ => qval(res, pr.ret_ty)
  }
}

///|
/// Resolve a package qualifier (`qual`) in the current lexical scope:
/// 1) `@canon:<pkg>` -> direct transitive lookup
/// 2) `g.tc.in_imported_default_arg` -> transitive lookup
/// 3) `g.mono_pkg != ""` -> resolve strictly against `g.mono_pkg`'s import table
/// 4) otherwise -> `resolve_pkg_for_lookup(g.tc, qual, true)`
fn qbe_resolve_pkg_in_scope(g : QbeGen, qual : String) -> Option[ImportedPkg] {
  if starts_with_str(qual, "@canon:") {
    return lookup_imported_pkg_transitive(g.tc, slice_str(qual, 7, qual.length()))
  }
  let mp = qbe_norm_mono_pkg(g, g.mono_pkg)
  if mp != "" {
    match lookup_imported_pkg_transitive(g.tc, mp) {
      Some(mpkg) =>
        match resolve_pkg_for_lookup(mpkg.tc, qual, true) {
          Some(sub) =>
            return match lookup_imported_pkg_transitive(g.tc, sub.name) {
              Some(full) => Some(full)
              None => Some(sub)
            }
          None => ()
        }
      None => ()
    }
    if g.tc.in_imported_default_arg {
      return lookup_imported_pkg_transitive(g.tc, qual)
    }
    None
  } else {
    resolve_pkg_for_lookup(g.tc, qual, true)
  }
}

///|
/// Canonical `g.tc`-side name of unqualified struct `name` of the package being
/// monomorphized, or `name` itself when `g.mono_pkg` does not define it.
fn qbe_mono_pkg_struct_name(g : QbeGen, name : String) -> String {
  let mp = qbe_norm_mono_pkg(g, g.mono_pkg)
  if mp == "" {
    return name
  }
  if g.tc.structs.contains(mp + "::" + name) {
    return mp + "::" + name
  }
  match lookup_imported_pkg_transitive(g.tc, mp) {
    Some(ipkg) =>
      if ipkg.tc.structs.contains(name) {
        ipkg.name + "::" + name
      } else {
        name
      }
    None => name
  }
}

///|
/// Resolves the struct name of a struct literal to the name codegen uses for the
/// type: package aliases become canonical package ids and `@canon:` is stripped.
/// `explicit_name` tells a name written in the source (looked up in the package
/// being monomorphized first) from one inferred from a spread base or the expected
/// type. Emitting and probing a literal must agree on this name: method symbols
/// are derived from it.
fn qbe_resolve_struct_lit_name(
  g : QbeGen,
  sname : String,
  explicit_name : Bool,
) -> String {
  if starts_with_str(sname, "@canon:") {
    let raw = slice_str(sname, 7, sname.length())
    let qp = split_qual_name(raw)
    return if qp.prefix != "" &&
      qp.prefix == g.tc.pkg_name &&
      g.tc.structs.contains(qp.name) {
      qp.name
    } else {
      raw
    }
  }
  if sname == "" {
    return sname
  }
  if !has_qual_sep(sname) {
    return if g.mono_pkg != "" && (explicit_name || !g.tc.structs.contains(sname)) {
      qbe_mono_pkg_struct_name(g, sname)
    } else {
      sname
    }
  }
  // A source alias is scoped to the package that wrote it: a canonical id of the
  // same spelling in `g.tc` (a root-anchor package) must not shadow it. An inferred
  // name is already canonical.
  let qp = split_qual_name(sname)
  if !explicit_name {
    if g.tc.structs.contains(sname) {
      return sname
    }
    match lookup_imported_pkg_transitive(g.tc, qp.prefix) {
      Some(ipkg) =>
        if ipkg.tc.structs.contains(qp.name) {
          return sname
        }
      None => ()
    }
  }
  match qbe_resolve_pkg_in_scope(g, qp.prefix) {
    Some(ipkg) => ipkg.name + "::" + qp.name
    None => sname
  }
}

///|
fn qbe_emit_resolved_finfo_call(
  g : QbeGen,
  qual : String,
  mem : String,
  minfo : FnInfo,
  target_sym : String,
  raw_target_pkg : String,
  args : Array[Expr],
  expected : Option[Ty],
  sp : Span,
) -> QbeVal {
  let target_pkg = qbe_norm_mono_pkg(g, raw_target_pkg)
  let call_res = resolve_call_args_qbe_full(minfo.decl.params, 0, args, sp)
  let norm_args = call_res.args
  let from_default = call_res.from_default
  let order = qbe_call_eval_order(minfo.decl.params, 0, args, norm_args.length())
  let subst : Map[String, Ty] = Map([])
  match expected {
    Some(et) => qbe_unify_tparams(g, minfo.ret_ty, et, subst)
    None => ()
  }
  let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
  if target_pkg == "" &&
    g.mono_pkg == "" &&
    !has_qual_sep(qual) &&
    minfo.decl.type_params.length() == 0 &&
    !qbe_has_any_default(from_default) {
    match qbe_try_inline_hof_call(g, qual + "::" + mem, minfo, norm_args, order) {
      Some(qv) => return qv
      None => ()
    }
  }
  let arg_vals : Array[String] = []
  let arg_tys : Array[Ty] = []
  let arg_borrowed : Array[Bool] = []
  let wbs : Array[QbeMutWb] = []
  qbe_preunify_reordered_args(g, minfo, 0, norm_args, order, subst, sp)
  qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
  let guards = qbe_arg_guards(g, norm_args, order)
  let mut oi = 0
  while oi < order.length() {
    let i = order[oi]
    let is_def = i < from_default.length() && from_default[i]
    if !is_def {
      match norm_args[i] {
        EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
        _ => ()
      }
    }
    let exp_p : Option[Ty] = if i < minfo.param_tys.length() {
      qbe_generic_arg_expect(
        g,
        minfo,
        target_pkg,
        subst_ty_mask_unbound(minfo.param_tys[i], minfo.decl.type_params, subst),
        norm_args[i],
      )
    } else {
      None
    }
    let mut aa = QbeArgVal::{ qv: qval("0", TUnit), borrowed: false }
    let mut used_stack_view = false
    if is_def {
      aa = qbe_emit_default_call_arg(
        g,
        minfo.decl.params,
        minfo.param_tys,
        minfo.decl.type_params,
        i,
        norm_args[i],
        exp_p,
        arg_vals,
        arg_tys,
        subst,
        target_pkg,
      )
    } else {
      if can_borrow && minfo.decl.type_params.length() == 0 && !qbe_has_any_default(from_default) {
        match qbe_view_expr_root_info(g, norm_args[i]) {
          Some((_, vty)) => {
            let vkey = if minfo.decl.receiver_type != "" {
              minfo.decl.receiver_type + "::" + minfo.decl.name
            } else {
              minfo.decl.name
            }
            if qbe_fn_param_is_view_borrow(g, target_pkg, vkey, minfo, i, 0) {
              let stk = qbe_emit_stack_view_expr(g, norm_args[i])
              aa = QbeArgVal::{ qv: qval(stk, vty), borrowed: true }
              used_stack_view = true
            }
          }
          None => ()
        }
      }
      if !used_stack_view {
        aa = qbe_emit_call_arg(g, minfo.decl.params, i, norm_args[i], exp_p, can_borrow, wbs, norm_args)
      }
    }
    let av = aa.qv
    if i < minfo.param_tys.length() {
      qbe_unify_tparams(g, minfo.param_tys[i], av.ty, subst)
    }
    arg_vals[i] = av.reg
    arg_tys[i] = av.ty
    arg_borrowed[i] = aa.borrowed
    qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i, norm_args[i]), guards.exits[oi])
    oi = oi + 1
  }
  qbe_release_guards(g, guards)
  if qbe_call_needs_mono(g, minfo, subst, target_pkg) {
    let mres = qbe_emit_mono_call(
      g,
      target_sym,
      minfo,
      subst,
      arg_vals,
      arg_tys,
      arg_borrowed,
      target_pkg,
    )
    qbe_emit_mut_writebacks(g, wbs)
    return mres
  }
  if target_pkg == "" && g.mono_pkg == "" && !has_qual_sep(qual) {
    match qbe_try_inline_fn_call(
      g,
      qual + "::" + mem,
      minfo,
      arg_vals,
      arg_tys,
      arg_borrowed,
    ) {
      Some(qv) => return qv
      None => ()
    }
  } else if target_pkg != "" && wbs.length() == 0 {
    match qbe_try_inline_xpkg_fn_call(
      g,
      target_pkg,
      qual + "::" + mem,
      minfo,
      arg_vals,
      arg_tys,
      arg_borrowed,
    ) {
      Some(qv) => return qv
      None => ()
    }
  }
  if target_pkg != "" && !minfo.decl.is_pub {
    let mres = qbe_emit_mono_call(
      g,
      target_sym,
      minfo,
      subst,
      arg_vals,
      arg_tys,
      arg_borrowed,
      target_pkg,
    )
    qbe_emit_mut_writebacks(g, wbs)
    return mres
  }
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let mut j = 0
  while j < arg_vals.length() {
    let decl_pty = if j < minfo.param_tys.length() {
      minfo.param_tys[j]
    } else {
      arg_tys[j]
    }
    if qbe_param_is_mut(minfo.decl.params, j) {
      call_args.push(arg_vals[j])
      call_abis.push("l")
    } else {
      call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
      call_abis.push(qbe_abi_ty(decl_pty))
    }
    j = j + 1
  }
  let ret_abi = qbe_abi_ty(minfo.ret_ty)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =")
  sb.write_string(ret_abi)
  sb.write_string(" call ")
  sb.write_string(target_sym)
  sb.write_string("(")
  j = 0
  while j < call_args.length() {
    if j > 0 {
      sb.write_string(", ")
    }
    sb.write_string(call_abis[j])
    sb.write_string(" ")
    sb.write_string(call_args[j])
    j = j + 1
  }
  let mut tpi = 0
  while tpi < minfo.decl.type_params.length() {
    if call_args.length() > 0 || tpi > 0 {
      sb.write_string(", ")
    }
    let tp_ty = match subst.get(minfo.decl.type_params[tpi]) {
      Some(t) => t
      None => TError
    }
    sb.write_string("l ")
    sb.write_string(qbe_is_obj_flag(g, tp_ty))
    tpi = tpi + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qbe_emit_mut_writebacks(g, wbs)
  let concrete_ret = subst_ty(minfo.ret_ty, subst)
  let final_res = qbe_coerce_val(g, qval(res, minfo.ret_ty), concrete_ret)
  qval(final_res, concrete_ret)
}

///|
/// Queues (once) the instance of `base_sym` for `subst`, its nominal types
/// qualified, and returns its symbol with that qualified substitution.
fn qbe_request_mono(
  g : QbeGen,
  base_sym : String,
  finfo : FnInfo,
  subst : Map[String, Ty],
  decl_pkg : String,
) -> QbeMonoTarget {
  let qsubst : Map[String, Ty] = Map([])
  let mut tpi = 0
  while tpi < finfo.decl.type_params.length() {
    let tp = finfo.decl.type_params[tpi]
    match subst.get(tp) {
      Some(ty) => qsubst.set(tp, qbe_qualify_nominal_ty(g, ty))
      None => ()
    }
    tpi = tpi + 1
  }
  let norm_decl_pkg = qbe_norm_mono_pkg(g, decl_pkg)
  let mono_sym = qbe_mono_fn_sym(base_sym, finfo.decl.type_params, qsubst)
  if !g.mono_seen.contains(mono_sym) {
    g.mono_seen.set(mono_sym, true)
    g.mono_queue.push(QbeMonoReq::{
      sym: mono_sym,
      finfo: finfo,
      subst: qsubst,
      pkg: norm_decl_pkg,
    })
  }
  QbeMonoTarget::{ sym: mono_sym, subst: qsubst }
}

///|
fn qbe_emit_mono_call(
  g : QbeGen,
  base_sym : String,
  finfo : FnInfo,
  subst : Map[String, Ty],
  arg_vals : Array[String],
  arg_tys : Array[Ty],
  arg_borrowed : Array[Bool],
  decl_pkg : String,
) -> QbeVal {
  let mono = qbe_request_mono(g, base_sym, finfo, subst, decl_pkg)
  let mono_sym = mono.sym
  let qsubst = mono.subst
  let call_args : Array[String] = []
  let call_abis : Array[String] = []
  let mut j = 0
  while j < arg_vals.length() {
    let decl_pty = if j < finfo.param_tys.length() {
      subst_ty(finfo.param_tys[j], qsubst)
    } else {
      arg_tys[j]
    }
    if qbe_param_is_mut(finfo.decl.params, j) {
      call_args.push(arg_vals[j])
      call_abis.push("l")
    } else {
      call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
      call_abis.push(qbe_abi_ty(decl_pty))
    }
    j = j + 1
  }
  let concrete_ret = subst_ty(finfo.ret_ty, qsubst)
  let ret_abi = qbe_abi_ty(concrete_ret)
  let res = qbe_tmp(g)
  let sb = StringBuilder()
  sb.write_string(res)
  sb.write_string(" =")
  sb.write_string(ret_abi)
  sb.write_string(" call ")
  sb.write_string(mono_sym)
  sb.write_string("(")
  j = 0
  while j < call_args.length() {
    if j > 0 {
      sb.write_string(", ")
    }
    sb.write_string(call_abis[j])
    sb.write_string(" ")
    sb.write_string(call_args[j])
    j = j + 1
  }
  sb.write_string(")")
  qbe_emit(g, sb.to_string())
  g.block_immut_fields = Map([])
  j = 0
  while j < arg_vals.length() {
    if !arg_borrowed[j] {
      qbe_rc_dec(g, arg_vals[j], arg_tys[j])
    }
    j = j + 1
  }
  qval(res, concrete_ret)
}

///|
/// `qbe_probe_expr_ty` guessed `Int` / `Int64` but the receiver evaluated to
/// another type: bind the already evaluated value to a fresh hidden local of
/// its real type (owned, so an RC value is released with the scope) and run
/// the ordinary `.to_string()` lowering on it. The receiver is not evaluated
/// a second time.
fn qbe_concat_part_heap_to_string(g : QbeGen, iv : QbeVal, sp : Span) -> QbeArgVal {
  qbe_scope_push(g)
  let name = "$concat_recv" + qbe_tmp(g)
  let loc = qbe_define_local(g, name, iv.ty, true)
  qbe_store_local_slot(g, iv.reg, loc.slot, iv.ty)
  let r = qbe_emit_method_call(g, EIdent(name, sp), "to_string", [], Some(TString), sp)
  qbe_scope_pop(g)
  QbeArgVal::{ qv: r, borrowed: false }
}

///| Return definite built-in String receivers only. Chained slices and
/// fresh string literals have the same layout as a local String.
fn qbe_is_str_slice(g : QbeGen, e : Expr) -> Bool {
  match e {
    EMethodCall(obj, "slice", args, sp) =>
      args.length() == 2 && !qbe_has_expected_trait(g, sp) &&
        match obj {
          EString(_, _) | EInterp(_, _) => true
          ECall(EIdent(n, _), _, _) => {
            if g.mono_pkg != "" || g.tc.in_imported_default_arg || g.inline_closures.contains(n) { return false }
            match qbe_lookup_local(g, n) {
              Some(_) => false
              None => match g.tc.fns.get(n) {
                Some(f) => match f.ret_ty { TString => !g.tc.consts.contains(n)
                  _ => false }
                None => false
              }
            }
          }
          EMethodCall(_, "slice", _, _) => qbe_is_str_slice(g, obj)
          _ => match qbe_peek_expr_ty(g, obj) {
            Some(TString) => true
            _ => false
          }
        }
    _ => false
  }
}

///| The raw data pointer is valid until the owner is released. Register owned
/// expression temporaries in the caller's scope before evaluating the bounds.
fn qbe_checked_str_span(g : QbeGen, expr : Expr, borrow : Bool) -> (String, String) {
  let (_, lo, hi, ptr) = qbe_checked_str_bounds(g, expr, borrow)
  if g.block_term { return ("0", "0") }
  let len = qbe_tmp(g)
  qbe_emit(g, len + " =l sub " + hi + ", " + lo)
  (ptr, len)
}

///| Evaluate a slice's receiver and bounds in order and validate them at the
/// slice site; returns (owner, lo, hi, data pointer) registers.
fn qbe_checked_str_bounds(g : QbeGen, expr : Expr, borrow : Bool) -> (String, String, String, String) {
  match expr {
    EMethodCall(obj, _, args, _) => {
      let a = qbe_emit_arg_maybe_borrow(g, obj, Some(TString), borrow)
      if !a.borrowed && !g.block_term {
        let _ = qbe_hold_local(g, "@span_owner", a.qv)
      }
      if g.block_term { return ("0", "0", "0", "0") }
      let lo = qbe_as_l(g, qbe_emit_expr(g, args[0], Some(TInt)))
      if g.block_term { return ("0", "0", "0", "0") }
      let hi = qbe_as_l(g, qbe_emit_expr(g, args[1], Some(TInt)))
      if g.block_term { return ("0", "0", "0", "0") }
      let ptr = qbe_tmp(g)
      qbe_emit(g, ptr + " =l call $pion_str_slice_data(l " + a.qv.reg + ", l " + lo + ", l " + hi + ")")
      (a.qv.reg, lo, hi, ptr)
    }
    _ => ("0", "0", "0", "0")
  }
}

///| Operands of a string `+` in the same grouping as the ordinary lowering:
/// when `lhs` is itself a `+`, every leaf of the tree in evaluation order (the
/// `pion_str_concat_n` chain); otherwise just `[lhs, rhs]` (one
/// `pion_str_concat`, a nested `rhs` keeping its own concatenation). A span copy
/// over these parts evaluates the same operands in the same order and checks
/// the total length once at the end, exactly like the call it replaces.
fn qbe_string_add_parts(lhs : Expr, rhs : Expr) -> Array[Expr] {
  match lhs {
    EBinary("+", _, _, _) => ()
    _ => return [lhs, rhs]
  }
  let parts : Array[Expr] = []
  let stack : Array[Expr] = [rhs, lhs]
  while stack.length() > 0 {
    match stack.pop() {
      Some(EBinary("+", l, r, _)) => {
        stack.push(r)
        stack.push(l)
      }
      Some(part) => parts.push(part)
      None => break
    }
  }
  parts
}

///| Caller opened a scope for the source and part owners. parts are in Pion
/// argument evaluation order, even for a right-nested chain.
fn qbe_emit_span_concat(
  g : QbeGen, parts : Array[Expr], aliases : Map[String, (String, String)], borrow : Bool,
) -> QbeVal {
  let storage = qbe_tmp(g)
  g.fn_allocs.write_string("    " + storage + " =l alloc8 " + (parts.length() * 16).to_string() + "\n")
  let mut i = 0
  while i < parts.length() {
    let e = parts[i]
    let cached = match e {
      EIdent(n, _) => aliases.get(n)
      _ => None
    }
    let (ptr, len) = match cached {
      Some(pair) => pair
      None => if qbe_is_str_slice(g, e) {
        qbe_checked_str_span(g, e, borrow)
      } else {
        let a = qbe_concat_part(g, e, borrow, false, parts.length() <= 8)
        if g.block_term { return qval("0", TString) }
        if !a.borrowed { let _ = qbe_hold_local(g, "@span_part", a.qv) }
        let p = qbe_tmp(g)
        let n = qbe_tmp(g)
        if g.immortal_regs.contains(a.qv.reg) {
          qbe_emit(g, n + " =l loadl " + a.qv.reg)
        } else {
          qbe_emit(g, n + " =l call $pion_str_len(l " + a.qv.reg + ")")
        }
        qbe_emit(g, p + " =l add " + a.qv.reg + ", 8")
        (p, n)
      }
    }
    if g.block_term { return qval("0", TString) }
    let pslot = qbe_tmp(g)
    let nslot = qbe_tmp(g)
    qbe_emit(g, pslot + " =l add " + storage + ", " + (i * 16).to_string())
    qbe_emit(g, nslot + " =l add " + pslot + ", 8")
    qbe_emit(g, "storel " + ptr + ", " + pslot)
    qbe_emit(g, "storel " + len + ", " + nslot)
    i = i + 1
  }
  let res = qbe_tmp(g)
  qbe_emit(g, res + " =l call $pion_str_concat_spans(l " + parts.length().to_string() + ", l " + storage + ")")
  qval(res, TString)
}

///| Match a run of immutable slice definitions feeding the next concatenation.
/// No alias is published to the ordinary expression emitter. Check all uses
/// before emitting the first instruction, including uses inside later bounds.
/// Returns the number of fused statements; 0 when nothing was fused; -k when
/// the k slice lets from `start` are not followed by a concatenation let, so no
/// start among them can fuse either (keeps the scan linear in the block).
/// A run holds at most 16 aliases.
fn qbe_try_span_bindings(g : QbeGen, ss : Array[Stmt], start : Int) -> Int {
  if g.target_wasm { return 0 }
  let names : Array[String] = []
  let slices : Array[Expr] = []
  let mut i = start
  while i < ss.length() && names.length() < 16 {
    match ss[i] {
      SLet(n, false, _, e, _) => {
        if !qbe_is_str_slice(g, e) || n == "_" { break }
        for prev in names {
          if n == prev || qbe_expr_mentions_ident(e, prev) { return 0 }
        }
        names.push(n)
        slices.push(e)
      }
      _ => break
    }
    i = i + 1
  }
  if names.length() == 0 { return 0 }
  if i == ss.length() { return -names.length() }
  let (target, lhs, rhs) = match ss[i] {
    SLet(n, false, TyMissing(_), EBinary("+", l, r, _), _) => (n, l, r)
    _ => return -names.length()
  }
  let parts = qbe_string_add_parts(lhs, rhs)
  let borrow = !qbe_args_have_assign(parts) && !qbe_args_have_assign(slices)
  for n in names {
    let mut used = false
    for e in parts {
      match e {
        EIdent(id, _) => if id == n { used = true }
        _ => if qbe_expr_mentions_ident(e, n) { return 0 }
      }
    }
    if !used { return 0 }
    let mut j = i + 1
    while j < ss.length() {
      if qbe_stmt_mentions_ident(ss[j], n) { return 0 }
      j = j + 1
    }
  }
  qbe_scope_push(g)
  let aliases : Map[String, (String, String)] = Map([])
  let mut j = 0
  while j < names.length() && !g.block_term {
    aliases.set(names[j], qbe_checked_str_span(g, slices[j], borrow))
    j = j + 1
  }
  let result = if !g.block_term { qbe_emit_span_concat(g, parts, aliases, borrow) } else { qval("0", TString) }
  qbe_scope_pop(g)
  if !g.block_term {
    if target == "_" { qbe_rc_dec(g, result.reg, TString) } else {
      qbe_clear_shadowed_local_meta(g, target)
      let loc = qbe_define_local(g, target, TString, true)
      qbe_store_local_slot(g, result.reg, loc.slot, TString)
    }
  }
  i - start + 1
}

///|
/// One part of a flattened `pion_str_concat_n` chain. `pion_str_concat_n`
/// reads only `len` and the `len` payload bytes of each part, always returns a
/// fresh string and never touches the parts' reference counts. A built-in
/// `Int` / `Int64` `.to_string()` (no trait dispatch) is therefore formatted
/// by `pion_strbuf_push_int` into a pseudo `PionString` in its own
/// nonescaping caller stack slot (32 B: `len` + 24 payload bytes; the 24 B
/// `PionStrBuf` points at the payload with `cap = 24`) instead of a heap
/// temporary. A signed 64-bit decimal needs at most 20 bytes plus NUL, so the
/// buffer never grows (`tests/lean/proofs/QbeConcatScratch.lean`). The part
/// is reported as borrowed, so no `rc_dec` is ever emitted for the slot.
/// Each call site owns distinct slots, so parts of one chain never alias and
/// a loop re-formats into the same slots only after the previous concat
/// copied them. The receiver is evaluated exactly where the heap path would
/// evaluate it, which keeps left-to-right order and early exits unchanged.
fn qbe_concat_part(
  g : QbeGen,
  part : Expr,
  borrow : Bool,
  borrow_fields : Bool,
  use_scratch : Bool,
) -> QbeArgVal {
  if use_scratch {
    match part {
      EMethodCall(inner, "to_string", args, sp) =>
        if args.length() == 0 && !qbe_has_expected_trait(g, sp) {
          let is_int = match qbe_probe_expr_ty(g, inner) {
            Some(TInt) | Some(TInt64) => true
            _ => false
          }
          if is_int {
            g.block_immut_fields = Map([])
            let iv = qbe_emit_expr(g, inner, None)
            g.block_immut_fields = Map([])
            // Dispatch on the evaluated type, never on the probe alone.
            // `Int` is a `w` value: sign-extend (`extsw`) like the heap path.
            let value = match iv.ty {
              TInt => qbe_as_l(g, iv)
              TInt64 => iv.reg
              _ => return qbe_concat_part_heap_to_string(g, iv, sp)
            }
            let slot = qbe_tmp(g)
            let sb = qbe_tmp(g)
            let cap_p = qbe_tmp(g)
            let data_p = qbe_tmp(g)
            let bytes = qbe_tmp(g)
            let len = qbe_tmp(g)
            g.fn_allocs.write_string("    " + slot + " =l alloc8 32\n")
            g.fn_allocs.write_string("    " + sb + " =l alloc8 24\n")
            qbe_emit(g, cap_p + " =l add " + sb + ", 8")
            qbe_emit(g, data_p + " =l add " + sb + ", 16")
            qbe_emit(g, bytes + " =l add " + slot + ", 8")
            qbe_emit(g, "storel 0, " + sb)
            qbe_emit(g, "storel 24, " + cap_p)
            qbe_emit(g, "storel " + bytes + ", " + data_p)
            qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + value + ")")
            qbe_emit(g, len + " =l loadl " + sb)
            qbe_emit(g, "storel " + len + ", " + slot)
            return QbeArgVal::{ qv: qval(slot, TString), borrowed: true }
          }
        }
      _ => ()
    }
  }
  match part {
    EBinary("+", _, _, _) => {
      // A nested `+` operand keeps its ordinary (unflattened) concatenation.
      g.nested_add_part = true
      let v = qbe_emit_arg_maybe_borrow_ext(g, part, Some(TString), borrow, borrow_fields)
      g.nested_add_part = false
      return v
    }
    _ => ()
  }
  qbe_emit_arg_maybe_borrow_ext(g, part, Some(TString), borrow, borrow_fields)
}

///| Flatten a string `+` chain (left and right nesting) iteratively for
/// `qbe_bounded_format`. Stops early (false) at more than 8 parts or at a
/// part that is neither a literal nor a `.to_string()` call; string
/// concatenation is associative, so the flattened order is source order.
fn qbe_bounded_format_parts(lhs : Expr, rhs : Expr, parts : Array[Expr]) -> Bool {
  let stack : Array[Expr] = [rhs, lhs]
  while stack.length() > 0 {
    match stack.pop() {
      Some(cur) =>
        match cur {
          EBinary("+", l, r, _) => {
            if parts.length() + stack.length() + 2 > 8 {
              return false
            }
            stack.push(r)
            stack.push(l)
          }
          EString(_, _) | EMethodCall(_, "to_string", _, _) => {
            if parts.length() >= 8 {
              return false
            }
            parts.push(cur)
          }
          _ => return false
        }
      None => break
    }
  }
  true
}

///| Format a bounded chain directly into one buffer. Only literals and
/// reads of integer locals qualify, so evaluation cannot call back into
/// user code or observe the buffer before the final string is copied.
fn qbe_bounded_format(g : QbeGen, parts : Array[Expr]) -> Option[QbeVal] {
  if parts.length() > 8 { return None }
  let mut cap = 1
  let mut integers = 0
  for part in parts {
    match part {
      EString(s, _) =>
        match qbe_short_ascii_bytes(s) {
          Some(bytes) => cap = cap + bytes.length()
          None => return None
        }
      EMethodCall(EIdent(name, _), "to_string", args, sp) => {
        if args.length() != 0 || qbe_has_expected_trait(g, sp) { return None }
        match qbe_lookup_local(g, name) {
          Some(loc) =>
            match loc.ty {
              TInt | TInt64 => {
                integers = integers + 1
                cap = cap + 20
              }
              _ => return None
            }
          None => return None
        }
      }
      _ => return None
    }
  }
  if integers == 0 { return None }
  let sb = qbe_tmp(g)
  let data = qbe_tmp(g)
  let cp = qbe_tmp(g)
  let dp = qbe_tmp(g)
  g.fn_allocs.write_string("    " + sb + " =l alloc8 24\n")
  g.fn_allocs.write_string("    " + data + " =l alloc8 " + cap.to_string() + "\n")
  qbe_emit(g, cp + " =l add " + sb + ", 8")
  qbe_emit(g, dp + " =l add " + sb + ", 16")
  qbe_emit(g, "storel 0, " + sb)
  qbe_emit(g, "storel " + cap.to_string() + ", " + cp)
  qbe_emit(g, "storel " + data + ", " + dp)
  for part in parts {
    match part {
      EString(s, _) => {
        let len = qbe_tmp(g)
        let pos = qbe_tmp(g)
        qbe_emit(g, len + " =l loadl " + sb)
        qbe_emit(g, pos + " =l add " + data + ", " + len)
        let mut i = 0
        while i < s.length() {
          let addr = qbe_tmp(g)
          qbe_emit(g, addr + " =l add " + pos + ", " + i.to_string())
          qbe_emit(g, "storeb " + s.code_unit_at(i).to_string() + ", " + addr)
          i = i + 1
        }
        let next = qbe_tmp(g)
        qbe_emit(g, next + " =l add " + len + ", " + s.length().to_string())
        qbe_emit(g, "storel " + next + ", " + sb)
      }
      EMethodCall(inner, _, _, _) => {
        let iv = qbe_emit_expr(g, inner, None)
        let value = qbe_as_l(g, iv)
        qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + value + ")")
      }
      _ => ()
    }
  }
  let len = qbe_tmp(g)
  let result = qbe_tmp(g)
  qbe_emit(g, len + " =l loadl " + sb)
  qbe_emit(g, result + " =l call $pion_str_from_cstr(l " + data + ", l " + len + ")")
  Some(qval(result, TString))
}

///|
fn qbe_expr_is_borrowable_leaf(e : Expr) -> Bool {
  match e {
    EString(_, _) | EIdent(_, _) | EField(_, _, _) | EIndex(_, _, _) => true
    _ => false
  }
}

///|
fn qbe_emit_binary_leaf_arg(
  g : QbeGen,
  e : Expr,
  exp_opt : Option[Ty],
  cmp_borrow : Bool,
  cmp_borrow_af : Bool,
  is_lhs : Bool,
) -> QbeArgVal {
  if is_lhs {
    match e {
      EInt(raw, _) =>
        match exp_opt {
          Some(TUInt) => {
            let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
            return QbeArgVal::{ qv: qval(v32, TUInt), borrowed: true }
          }
          Some(TUInt64) => {
            let v64 = qbe_parse_int64_lit(raw).to_string()
            return QbeArgVal::{ qv: qval(v64, TUInt64), borrowed: true }
          }
          Some(TInt8) => {
            let v64 = qbe_parse_int64_lit(raw)
            let b = v64 & 255L
            let s8 = if b >= 128L { b - 256L } else { b }
            return QbeArgVal::{ qv: qval(s8.to_string(), TInt8), borrowed: true }
          }
          _ => {
            let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
            return QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
          }
        }
      _ => ()
    }
  } else {
    match exp_opt {
      Some(TInt) =>
        match e {
          EInt(raw, _) => {
            let v32 = qbe_parse_int64_lit(raw).to_int().to_int64().to_string()
            return QbeArgVal::{ qv: qval(v32, TInt), borrowed: true }
          }
          _ => ()
        }
      _ => ()
    }
  }
  qbe_emit_arg_maybe_borrow_ext(g, e, exp_opt, cmp_borrow, cmp_borrow_af)
}

///|
fn qbe_emit_binary_combine(
  g : QbeGen,
  op : String,
  lhs : Expr,
  rhs : Expr,
  bin_sp : Span,
  la : QbeArgVal,
  ra : QbeArgVal,
) -> QbeVal {
  let lv = la.qv
  let rv = ra.qv
  if g.in_verify && (op == "/" || op == "%" || op == "<<" || op == ">>") {
    qbe_emit_verify_arith_check(g, op, lv, rv, qbe_eval_verify_const_rhs(g, rhs), bin_sp)
  }
  match lv.ty {
    TStrView => {
      let p1a = qbe_tmp(g)
      let p1 = qbe_tmp(g)
      let l1a = qbe_tmp(g)
      let l1 = qbe_tmp(g)
      let p2a = qbe_tmp(g)
      let p2 = qbe_tmp(g)
      let l2a = qbe_tmp(g)
      let l2 = qbe_tmp(g)
      qbe_emit(g, p1a + " =l add " + lv.reg + ", 8")
      qbe_emit(g, p1 + " =l loadl " + p1a)
      qbe_emit(g, l1a + " =l add " + lv.reg + ", 16")
      qbe_emit(g, l1 + " =l loadl " + l1a)
      qbe_emit(g, p2a + " =l add " + rv.reg + ", 8")
      qbe_emit(g, p2 + " =l loadl " + p2a)
      qbe_emit(g, l2a + " =l add " + rv.reg + ", 16")
      qbe_emit(g, l2 + " =l loadl " + l2a)
      let eq = qbe_emit_strview_eq_raw(g, p1, l1, p2, l2)
      if !la.borrowed {
        qbe_rc_dec(g, lv.reg, lv.ty)
      }
      if !ra.borrowed {
        qbe_rc_dec(g, rv.reg, rv.ty)
      }
      if op == "==" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l extuw " + eq)
        return qval(r, TBool)
      } else {
        let ne = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
        qbe_emit(g, r + " =l extuw " + ne)
        return qval(r, TBool)
      }
    }
    TString => {
      if op == "+" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_str_concat(l " + lv.reg + ", l " + rv.reg + ")")
        if !la.borrowed {
          qbe_rc_dec(g, lv.reg, lv.ty)
        }
        if !ra.borrowed {
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
        return qval(r, TString)
      }
      if op == "==" || op == "!=" {
        let eq = qbe_tmp(g)
        qbe_emit(g, eq + " =w call $pion_str_eq(l " + lv.reg + ", l " + rv.reg + ")")
        if !la.borrowed {
          qbe_rc_dec(g, lv.reg, lv.ty)
        }
        if !ra.borrowed {
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
        if op == "==" {
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =l extuw " + eq)
          return qval(r, TBool)
        } else {
          let ne = qbe_tmp(g)
          let r = qbe_tmp(g)
          qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
          qbe_emit(g, r + " =l extuw " + ne)
          return qval(r, TBool)
        }
      }
      let cmp = qbe_tmp(g)
      qbe_emit(g, cmp + " =w call $pion_str_cmp(l " + lv.reg + ", l " + rv.reg + ")")
      if !la.borrowed {
        qbe_rc_dec(g, lv.reg, lv.ty)
      }
      if !ra.borrowed {
        qbe_rc_dec(g, rv.reg, rv.ty)
      }
      let cop = if op == "<" {
        "csltw"
      } else if op == "<=" {
        "cslew"
      } else if op == ">" {
        "csgtw"
      } else {
        "csgew"
      }
      let cw = qbe_tmp(g)
      let r = qbe_tmp(g)
      qbe_emit(g, cw + " =w " + cop + " " + cmp + ", 0")
      qbe_emit(g, r + " =l extuw " + cw)
      qval(r, TBool)
    }
    TInt => {
      let lw = lv.reg
      let rw = qbe_coerce_val(g, rv, TInt)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let cop = if op == "==" {
          "ceqw"
        } else if op == "!=" {
          "cnew"
        } else if op == "<" {
          "csltw"
        } else if op == "<=" {
          "cslew"
        } else if op == ">" {
          "csgtw"
        } else {
          "csgew"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else {
        if op == "/" || op == "%" {
          match qbe_eval_const_i64_expr(g, rhs) {
            Some(d) =>
              match qbe_emit_i32_const_div_rem(
                g,
                op,
                lw,
                d,
                qbe_expr_is_nonneg_int(g, lhs),
                qbe_expr_is_even_int(lhs),
              ) {
                Some(aw) => return qval(aw, TInt)
                None => ()
              }
            None => ()
          }
        }
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "div"
        } else if op == "%" {
          "rem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else if op == "^" {
          "xor"
        } else if op == "<<" {
          "shl"
        } else {
          "sar"
        }
        let aw = qbe_tmp(g)
        qbe_emit(g, aw + " =w " + aop + " " + lw + ", " + rw)
        qval(aw, TInt)
      }
    }
    TUInt => {
      let lw = lv.reg
      let rw = qbe_coerce_val(g, rv, TUInt)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let cop = if op == "==" {
          "ceqw"
        } else if op == "!=" {
          "cnew"
        } else if op == "<" {
          "cultw"
        } else if op == "<=" {
          "culew"
        } else if op == ">" {
          "cugtw"
        } else {
          "cugew"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, cw + " =w " + cop + " " + lw + ", " + rw)
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else {
        if op == "/" || op == "%" {
          match qbe_eval_const_i64_expr(g, rhs) {
            Some(d) =>
              match qbe_emit_u32_const_div_rem(g, op, lw, d) {
                Some(aw) => return qval(aw, TUInt)
                None => ()
              }
            None => ()
          }
        }
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "udiv"
        } else if op == "%" {
          "urem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else if op == "^" {
          "xor"
        } else if op == "<<" {
          "shl"
        } else {
          "shr"
        }
        let aw = qbe_tmp(g)
        qbe_emit(g, aw + " =w " + aop + " " + lw + ", " + rw)
        qval(aw, TUInt)
      }
    }
    TUInt64 => {
      let ll = lv.reg
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let rl = qbe_coerce_val(g, rv, TUInt64)
        let cop = if op == "==" {
          "ceql"
        } else if op == "!=" {
          "cnel"
        } else if op == "<" {
          "cultl"
        } else if op == "<=" {
          "culel"
        } else if op == ">" {
          "cugtl"
        } else {
          "cugel"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, cw + " =w " + cop + " " + ll + ", " + rl)
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let aop = if op == "<<" { "shl" } else { "shr" }
        let al = qbe_tmp(g)
        qbe_emit(g, al + " =l " + aop + " " + ll + ", " + rw)
        qval(al, TUInt64)
      } else {
        if op == "/" || op == "%" {
          match qbe_eval_const_i64_expr(g, rhs) {
            Some(d) =>
              match qbe_emit_u64_const_div_rem(g, op, ll, d) {
                Some(al) => return qval(al, TUInt64)
                None => ()
              }
            None => ()
          }
        }
        let rl = qbe_coerce_val(g, rv, TUInt64)
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "udiv"
        } else if op == "%" {
          "urem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let al = qbe_tmp(g)
        qbe_emit(g, al + " =l " + aop + " " + ll + ", " + rl)
        qval(al, TUInt64)
      }
    }
    TDouble => {
      let ld = lv.reg
      let rd = qbe_coerce_val(g, rv, TDouble)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let cop = if op == "==" {
          "ceqd"
        } else if op == "!=" {
          "cned"
        } else if op == "<" {
          "cltd"
        } else if op == "<=" {
          "cled"
        } else if op == ">" {
          "cgtd"
        } else {
          "cged"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, cw + " =w " + cop + " " + ld + ", " + rd)
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else if op == "%" {
        let ad = qbe_tmp(g)
        qbe_emit(g, ad + " =d call $fmod(d " + ld + ", d " + rd + ")")
        qval(ad, TDouble)
      } else {
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else {
          "div"
        }
        let ad = qbe_tmp(g)
        qbe_emit(g, ad + " =d " + aop + " " + ld + ", " + rd)
        qval(ad, TDouble)
      }
    }
    TFloat => {
      let lf = lv.reg
      let rf = qbe_coerce_val(g, rv, TFloat)
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let cop = if op == "==" {
          "ceqs"
        } else if op == "!=" {
          "cnes"
        } else if op == "<" {
          "clts"
        } else if op == "<=" {
          "cles"
        } else if op == ">" {
          "cgts"
        } else {
          "cges"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, cw + " =w " + cop + " " + lf + ", " + rf)
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else if op == "%" {
        let ld = qbe_tmp(g)
        let rd = qbe_tmp(g)
        let md = qbe_tmp(g)
        let af = qbe_tmp(g)
        qbe_emit(g, ld + " =d exts " + lf)
        qbe_emit(g, rd + " =d exts " + rf)
        qbe_emit(g, md + " =d call $fmod(d " + ld + ", d " + rd + ")")
        qbe_emit(g, af + " =s truncd " + md)
        qval(af, TFloat)
      } else {
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else {
          "div"
        }
        let af = qbe_tmp(g)
        qbe_emit(g, af + " =s " + aop + " " + lf + ", " + rf)
        qval(af, TFloat)
      }
    }
    _ => {
      let cmp_ty = if qbe_ty_has_error(lv.ty) && !qbe_ty_has_error(rv.ty) {
        rv.ty
      } else {
        lv.ty
      }
      if (op == "==" || op == "!=") && qbe_type_needs_eq_fn(g, cmp_ty) {
        let eq_sym = qbe_ensure_eq_fn(g, cmp_ty)
        let eq = qbe_tmp(g)
        qbe_emit(g, eq + " =w call " + eq_sym + "(l " + lv.reg + ", l " + rv.reg + ")")
        if qbe_ty_has_custom_eq(g, cmp_ty, Map([])) {
          qbe_invalidate_aliased_min_lens(g)
        }
        if !la.borrowed {
          qbe_rc_dec(g, lv.reg, lv.ty)
        }
        if !ra.borrowed {
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
        if op == "==" {
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =l extuw " + eq)
          return qval(r, TBool)
        } else {
          let ne = qbe_tmp(g)
          let r = qbe_tmp(g)
          qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
          qbe_emit(g, r + " =l extuw " + ne)
          return qval(r, TBool)
        }
      }
      if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" {
        let cop = if op == "==" {
          "ceql"
        } else if op == "!=" {
          "cnel"
        } else if op == "<" {
          "csltl"
        } else if op == "<=" {
          "cslel"
        } else if op == ">" {
          "csgtl"
        } else {
          "csgel"
        }
        let cw = qbe_tmp(g)
        let r = qbe_tmp(g)
        let lc = qbe_cmp_operand(g, lv.reg, lv.ty)
        let rc = qbe_cmp_operand(g, rv.reg, rv.ty)
        qbe_emit(g, cw + " =w " + cop + " " + lc + ", " + rc)
        if !la.borrowed {
          qbe_rc_dec(g, lv.reg, lv.ty)
        }
        if !ra.borrowed {
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
        qbe_emit(g, r + " =l extuw " + cw)
        qval(r, TBool)
      } else if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let r = qbe_tmp(g)
        let is_byte_ty = match lv.ty {
          TByte => true
          _ => false
        }
        let sop = if op == "<<" {
          "shl"
        } else if is_byte_ty {
          "shr"
        } else {
          "sar"
        }
        qbe_emit(g, r + " =l " + sop + " " + lv.reg + ", " + rw)
        match lv.ty {
          TInt8 => qval(qbe_extsb_l(g, r), TInt8)
          TByte => qval(qbe_extub_l(g, r), TByte)
          _ => qval(r, lv.ty)
        }
      } else {
        if op == "/" || op == "%" {
          match lv.ty {
            TInt64 =>
              match qbe_eval_const_i64_expr(g, rhs) {
                Some(d) =>
                  match qbe_emit_i64_const_div_rem(g, op, lv.reg, d) {
                    Some(al) => return qval(al, TInt64)
                    None => ()
                  }
                None => ()
              }
            _ => ()
          }
        }
        let is_byte_ty = match lv.ty {
          TByte => true
          _ => false
        }
        let aop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          if is_byte_ty { "udiv" } else { "div" }
        } else if op == "%" {
          if is_byte_ty { "urem" } else { "rem" }
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + aop + " " + lv.reg + ", " + rv.reg)
        match lv.ty {
          TInt8 => qval(qbe_extsb_l(g, r), TInt8)
          TByte => qval(qbe_extub_l(g, r), TByte)
          _ => qval(r, lv.ty)
        }
      }
    }
  }
}

///|
struct QbeBinaryFrame {
  mut state : Int
  op : String
  lhs : Expr
  rhs : Expr
  span : Span
  mut left : QbeArgVal
  borrow : Bool
  borrow_field : Bool
  mut short_label : String
  mut end_label : String
  mut guards : QbeArgGuards
}

///|
/// Iterative `EBinary` code generator using an explicit heap stack so 4,000+ deep
/// left-chained, right-nested, or mixed binary trees (including `&&`/`||` short-circuiting)
/// never overflow the stack in `qbe_emit_expr_inner` (58 KB frame), while preserving
/// exact left-to-right evaluation order, AST associativity (zero float reassociation),
/// and short-circuit semantics.
fn qbe_emit_binary_chain(
  g : QbeGen,
  root_op : String,
  root_lhs : Expr,
  root_rhs : Expr,
  root_sp : Span,
  root_expected : Option[Ty],
) -> QbeVal {
  // state: 0=bin waiting lhs, 1=bin waiting rhs, 2=&& waiting lhs, 3=&& waiting rhs,
  //        4=|| waiting lhs, 5=|| waiting rhs, 6=2.0*rhs waiting rhs
  let root_has_assign = qbe_expr_has_assign(root_lhs) || qbe_expr_has_assign(root_rhs)
  let no_flatten_root = g.nested_add_part
  g.nested_add_part = false
  let root_no_calls = !root_has_assign &&
    qbe_loop_has_no_calls_expr(g, root_lhs) &&
    qbe_loop_has_no_calls_expr(g, root_rhs)
  let frames : Array[QbeBinaryFrame] = []
  let empty_guards = QbeArgGuards::{ exits: [], slots: [], stores: [] }
  let mut cur : Expr = EBinary(root_op, root_lhs, root_rhs, root_sp)
  let mut cur_exp : Option[Ty] = root_expected
  let mut cur_cb = false
  let mut cur_cbaf = false
  let mut cur_is_lhs = true
  let mut has_val = false
  let mut cur_arg = QbeArgVal::{ qv: qval("0", TUnit), borrowed: false }
  let dummy_arg = QbeArgVal::{ qv: qval("0", TUnit), borrowed: false }
  while true {
    if !has_val {
      match cur {
        EBinary(op, lhs, rhs, bin_sp) => {
          if op == "|" || op == "^" || op == "+" {
            match qbe_try_emit_rotate_idiom(g, op, lhs, rhs) {
              Some(rv) => {
                cur_arg = QbeArgVal::{ qv: rv, borrowed: false }
                has_val = true
                continue
              }
              None => ()
            }
          }
          if op == "==" || op == "!=" {
            match qbe_try_emit_mod_pow2_eq_zero(g, op, lhs, rhs) {
              Some(cw) => {
                if g.block_term {
                  // The operand left the block: no register is defined here,
                  // so hand on a constant (like the other terminated paths).
                  cur_arg = QbeArgVal::{ qv: qval("0", TBool), borrowed: false }
                  has_val = true
                  continue
                }
                let r = qbe_tmp(g)
                qbe_emit(g, r + " =l extuw " + cw)
                cur_arg = QbeArgVal::{ qv: qval(r, TBool), borrowed: false }
                has_val = true
                continue
              }
              None => ()
            }
          }
          if op == "&&" {
            if qbe_expr_has_is(lhs) {
              let bslot = qbe_alloc_slot_for(g, TBool)
              let l_t = qbe_lbl(g, "and_is_vt")
              let l_f = qbe_lbl(g, "and_is_vf")
              let l_done = qbe_lbl(g, "and_is_vd")
              qbe_emit_cond_branch(g, cur, l_t, l_f)
              qbe_emit_lbl(g, l_t)
              qbe_emit(g, "storel 1, " + bslot)
              qbe_emit_term(g, "jmp " + l_done)
              qbe_emit_lbl(g, l_f)
              qbe_emit(g, "storel 0, " + bslot)
              qbe_emit_term(g, "jmp " + l_done)
              qbe_emit_lbl(g, l_done)
              let bv = qbe_tmp(g)
              qbe_emit(g, bv + " =l loadl " + bslot)
              cur_arg = QbeArgVal::{ qv: qval(bv, TBool), borrowed: false }
              has_val = true
              continue
            }
            frames.push(QbeBinaryFrame::{
              state: 2,
              op: op,
              lhs: lhs,
              rhs: rhs,
              span: bin_sp,
              left: dummy_arg,
              borrow: false,
              borrow_field: false,
              short_label: "",
              end_label: "",
              guards: empty_guards,
            })
            cur = lhs
            cur_exp = Some(TBool)
            cur_cb = false
            cur_cbaf = false
            cur_is_lhs = true
            continue
          }
          if op == "||" {
            frames.push(QbeBinaryFrame::{
              state: 4,
              op: op,
              lhs: lhs,
              rhs: rhs,
              span: bin_sp,
              left: dummy_arg,
              borrow: false,
              borrow_field: false,
              short_label: "",
              end_label: "",
              guards: empty_guards,
            })
            cur = lhs
            cur_exp = Some(TBool)
            cur_cb = false
            cur_cbaf = false
            cur_is_lhs = true
            continue
          }
          // Loop-carried square reuse (`v * v` for TDouble local)
          if op == "*" {
            let mut sq_done = false
            match lhs {
              EIdent(v1, _) =>
                match rhs {
                  EIdent(v2, _) =>
                    if v1 == v2 {
                      match g.sq_reuse_state.get(v1) {
                        Some(st) =>
                          match g.sq_reuse_slot.get(v1) {
                            Some(sq_slot) =>
                              if st == 1 {
                                let d = qbe_tmp(g)
                                qbe_emit(g, d + " =d loadd " + sq_slot)
                                cur_arg = QbeArgVal::{ qv: qval(d, TDouble), borrowed: false }
                                has_val = true
                                sq_done = true
                              } else if st == 2 {
                                let lv = qbe_emit_expr(g, lhs, Some(TDouble))
                                let ld = qbe_coerce_val(g, lv, TDouble)
                                let nsq = qbe_tmp(g)
                                qbe_emit(g, nsq + " =d mul " + ld + ", " + ld)
                                qbe_emit(g, "stored " + nsq + ", " + sq_slot)
                                g.sq_reuse_state.set(v1, 1)
                                cur_arg = QbeArgVal::{ qv: qval(nsq, TDouble), borrowed: false }
                                has_val = true
                                sq_done = true
                              }
                            None => ()
                          }
                        None => ()
                      }
                    }
                  _ => ()
                }
              _ => ()
            }
            if sq_done {
              continue
            }
          }
          // N-way chained `String + String + ...` flattening (>= 3 parts) -> single $pion_str_concat_n
          // Only scan at the outermost `+` (skip when parent is already `+`, eliminating O(N^2) scans on `Int` sums).
          if op == "+" &&
            ((frames.length() == 0 && !no_flatten_root) ||
            (frames.length() > 0 && frames[frames.length() - 1].op != "+")) {
            let mut is_add_chain = false
            match lhs {
              EBinary("+", _, _, _) => is_add_chain = true
              _ => ()
            }
            if g.hot_loop_depth > 0 && !g.target_wasm {
              let bf_parts : Array[Expr] = []
              if qbe_bounded_format_parts(lhs, rhs, bf_parts) {
                match qbe_bounded_format(g, bf_parts) {
                  Some(v) => {
                    cur_arg = QbeArgVal::{ qv: v, borrowed: false }
                    has_val = true
                    continue
                  }
                  None => ()
                }
              }
            }
            // A plain binary `slice + x` / `x + slice`: one span copy of [lhs, rhs]
            // in place of `pion_str_concat` (a nested `+` operand keeps its own).
            if !is_add_chain && !g.target_wasm && (qbe_is_str_slice(g, lhs) || qbe_is_str_slice(g, rhs)) {
              qbe_scope_push(g)
              let v = qbe_emit_span_concat(g, [lhs, rhs], Map([]), !root_has_assign)
              qbe_scope_pop(g)
              cur_arg = QbeArgVal::{ qv: v, borrowed: false }
              has_val = true
              continue
            }
            if is_add_chain {
              let parts = qbe_string_add_parts(lhs, rhs)
              if parts.length() >= 3 {
                let mut is_str_chain = match cur_exp {
                  Some(TString) => true
                  _ => false
                }
                if !is_str_chain {
                  let mut pi = 0
                  while pi < parts.length() {
                    match parts[pi] {
                      EString(_, _) | EInterp(_, _) => {
                        is_str_chain = true
                        break
                      }
                      EIdent(pn, _) =>
                        match qbe_lookup_local(g, pn) {
                          Some(ploc) =>
                            match ploc.ty {
                              TString => {
                                is_str_chain = true
                                break
                              }
                              _ => ()
                            }
                          None => ()
                        }
                      EMethodCall(_, _, _, _) =>
                        match qbe_probe_expr_ty(g, parts[pi]) {
                          Some(TString) => {
                            is_str_chain = true
                            break
                          }
                          _ => ()
                        }
                      _ => ()
                    }
                    pi = pi + 1
                  }
                }
                if is_str_chain {
                  // Same parts, same order: a span copy replaces pion_str_concat_n
                  // when a slice operand is present (its length check stays last).
                  if !g.target_wasm {
                    let mut use_spans = false
                    for part in parts {
                      if qbe_is_str_slice(g, part) {
                        use_spans = true
                        break
                      }
                    }
                    if use_spans {
                      qbe_scope_push(g)
                      let v = qbe_emit_span_concat(g, parts, Map([]), !root_has_assign)
                      qbe_scope_pop(g)
                      cur_arg = QbeArgVal::{ qv: v, borrowed: false }
                      has_val = true
                      continue
                    }
                  }
                  let can_borrow = !qbe_args_have_assign(parts)
                  let mut can_borrow_af = can_borrow
                  if can_borrow_af {
                    let mut ci = 0
                    while ci < parts.length() {
                      if !qbe_loop_has_no_calls_expr(g, parts[ci]) {
                        can_borrow_af = false
                        break
                      }
                      ci = ci + 1
                    }
                  }
                  let n_parts = parts.length()
                  let use_scratch = !g.target_wasm && n_parts <= 8
                  let arr_slot = qbe_tmp(g)
                  g.fn_allocs.write_string("    ")
                  g.fn_allocs.write_string(arr_slot)
                  g.fn_allocs.write_string(" =l alloc8 ")
                  g.fn_allocs.write_string((n_parts * 8).to_string())
                  g.fn_allocs.write_string("\n")
                  let part_regs : Array[String] = []
                  let part_borrowed : Array[Bool] = []
                  let guards = qbe_arg_guards_in_order(g, parts)
                  let mut pi = 0
                  while pi < n_parts {
                    let pa = qbe_concat_part(
                      g,
                      parts[pi],
                      can_borrow,
                      can_borrow_af,
                      use_scratch,
                    )
                    let sp = qbe_tmp(g)
                    qbe_emit(g, sp + " =l add " + arr_slot + ", " + (pi * 8).to_string())
                    qbe_emit(g, "storel " + pa.qv.reg + ", " + sp)
                    part_regs.push(pa.qv.reg)
                    part_borrowed.push(pa.borrowed)
                    qbe_guard_val(g, guards, pa, false, guards.exits[pi])
                    pi = pi + 1
                  }
                  qbe_release_guards(g, guards)
                  if g.block_term {
                    cur_arg = QbeArgVal::{ qv: qval("0", TString), borrowed: false }
                    has_val = true
                    continue
                  }
                  let r = qbe_tmp(g)
                  qbe_emit(
                    g,
                    r + " =l call $pion_str_concat_n(l " + n_parts.to_string() + ", l " + arr_slot + ")",
                  )
                  pi = 0
                  while pi < n_parts {
                    if !part_borrowed[pi] {
                      qbe_rc_dec(g, part_regs[pi], TString)
                    }
                    pi = pi + 1
                  }
                  cur_arg = QbeArgVal::{ qv: qval(r, TString), borrowed: false }
                  has_val = true
                  continue
                }
              }
            }
          }
          // IEEE-754 exact `2.0 * x -> x + x` strength reduction (iterative via state=6, zero recursion).
          if op == "*" && qbe_is_double_two(lhs) {
            frames.push(QbeBinaryFrame::{
              state: 6,
              op: op,
              lhs: lhs,
              rhs: rhs,
              span: bin_sp,
              left: dummy_arg,
              borrow: false,
              borrow_field: false,
              short_label: "",
              end_label: "",
              guards: empty_guards,
            })
            cur = rhs
            cur_cb = false
            cur_cbaf = false
            cur_is_lhs = false
            continue
          }
          let no_custom_eq = (op != "==" && op != "!=") ||
            !qbe_eq_op_may_call_custom(g, lhs, rhs, qbe_hints_new())
          let may_borrow = no_custom_eq &&
            (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "+") &&
            (qbe_expr_is_borrowable_leaf(lhs) || qbe_expr_is_borrowable_leaf(rhs))
          let cmp_borrow = may_borrow && !root_has_assign
          let cmp_borrow_af = cmp_borrow && root_no_calls
          if g.hot_loop_depth > 0 && (op == "==" || op == "!=") {
            let mut short_bytes : Option[Array[Int]] = None
            let mut other_expr : Option[Expr] = None
            match rhs {
              EString(lit, _) =>
                match qbe_short_ascii_bytes(lit) {
                  Some(bs) => {
                    short_bytes = Some(bs)
                    other_expr = Some(lhs)
                  }
                  None => ()
                }
              _ => ()
            }
            match short_bytes {
              None =>
                match lhs {
                  EString(lit, _) =>
                    match qbe_short_ascii_bytes(lit) {
                      Some(bs) => {
                        short_bytes = Some(bs)
                        other_expr = Some(rhs)
                      }
                      None => ()
                    }
                  _ => ()
                }
              Some(_) => ()
            }
            let mut short_done = false
            match short_bytes {
              Some(bs) =>
                match other_expr {
                  Some(oexpr) => {
                    let oa = qbe_emit_arg_maybe_borrow_ext(
                      g,
                      oexpr,
                      Some(TString),
                      cmp_borrow,
                      cmp_borrow_af,
                    )
                    let eq = qbe_emit_short_str_eq_val(g, oa.qv.reg, bs)
                    if !oa.borrowed {
                      qbe_rc_dec(g, oa.qv.reg, oa.qv.ty)
                    }
                    let qv = if op == "==" {
                      let r = qbe_tmp(g)
                      qbe_emit(g, r + " =l extuw " + eq)
                      qval(r, TBool)
                    } else {
                      let ne = qbe_tmp(g)
                      let r = qbe_tmp(g)
                      qbe_emit(g, ne + " =w ceqw " + eq + ", 0")
                      qbe_emit(g, r + " =l extuw " + ne)
                      qval(r, TBool)
                    }
                    cur_arg = QbeArgVal::{ qv: qv, borrowed: false }
                    has_val = true
                    short_done = true
                  }
                  None => ()
                }
              None => ()
            }
            if short_done {
              continue
            }
          }
          let is_arith_or_bit = op != "==" &&
            op != "!=" &&
            op != "<" &&
            op != "<=" &&
            op != ">" &&
            op != ">="
          let lhs_exp : Option[Ty] = if is_arith_or_bit {
            cur_exp
          } else if (op == "==" || op == "!=") && qbe_lhs_needs_rhs_hint(lhs) {
            qbe_eq_op_hint(g, bin_sp, rhs)
          } else {
            None
          }
          frames.push(QbeBinaryFrame::{
            state: 0,
            op: op,
            lhs: lhs,
            rhs: rhs,
            span: bin_sp,
            left: dummy_arg,
            borrow: cmp_borrow,
            borrow_field: cmp_borrow_af,
            short_label: "",
            end_label: "",
            guards: empty_guards,
          })
          cur = lhs
          cur_exp = lhs_exp
          cur_cb = cmp_borrow
          cur_cbaf = cmp_borrow_af
          cur_is_lhs = true
          continue
        }
        _ => {
          cur_arg = qbe_emit_binary_leaf_arg(g, cur, cur_exp, cur_cb, cur_cbaf, cur_is_lhs)
          has_val = true
        }
      }
    }
    if frames.length() == 0 {
      return cur_arg.qv
    }
    let frame = frames[frames.length() - 1]
    let st = frame.state
    let op = frame.op
    let lhs = frame.lhs
    let rhs = frame.rhs
    let bin_sp = frame.span
    if st == 0 {
      let lv = cur_arg.qv
      if op == "*" && qbe_is_double_ty(lv.ty) && qbe_is_double_two(rhs) {
        let ad = qbe_tmp(g)
        qbe_emit(g, ad + " =d add " + lv.reg + ", " + lv.reg)
        let _ = frames.pop()
        cur_arg = QbeArgVal::{ qv: qval(ad, TDouble), borrowed: false }
        has_val = true
        continue
      }
      if !cur_arg.borrowed && !g.block_term && qbe_expr_may_early_exit(g, rhs) {
        let guards = QbeArgGuards::{ exits: [], slots: [], stores: [] }
        qbe_guard_val(g, guards, cur_arg, false, true)
        frame.guards = guards
      }
      frame.state = 1
      frame.left = cur_arg
      let rhs_exp_opt : Option[Ty] = if op == "<<" || op == ">>" {
        match qbe_shift_rhs_infer(g, bin_sp) {
          Some(st_ty) => Some(st_ty)
          None =>
            match lv.ty {
              TUInt | TUInt64 | TInt64 =>
                match qbe_shift_rhs_ty_hint(g, rhs) {
                  Some(ht) =>
                    match ht {
                      TInt | TUInt | TUInt64 | TInt64 => Some(ht)
                      _ => Some(lv.ty)
                    }
                  None => Some(lv.ty)
                }
              TByte =>
                match qbe_shift_rhs_ty_hint(g, rhs) {
                  Some(ht) =>
                    match ht {
                      TInt | TUInt | TUInt64 | TInt64 | TByte => Some(ht)
                      _ => Some(TInt)
                    }
                  None => Some(TInt)
                }
              _ => Some(lv.ty)
            }
        }
      } else {
        Some(lv.ty)
      }
      cur = rhs
      cur_exp = rhs_exp_opt
      cur_cb = frame.borrow
      cur_cbaf = frame.borrow_field
      cur_is_lhs = false
      has_val = false
    } else if st == 1 {
      let la = frame.left
      let ra = cur_arg
      let bin_guards = frame.guards
      let _ = frames.pop()
      qbe_release_guards(g, bin_guards)
      if g.block_term {
        cur_arg = QbeArgVal::{ qv: qval("0", TUnit), borrowed: false }
        has_val = true
        continue
      }
      let res = qbe_emit_binary_combine(g, op, lhs, rhs, bin_sp, la, ra)
      cur_arg = QbeArgVal::{ qv: res, borrowed: false }
      has_val = true
    } else if st == 2 {
      let lv = cur_arg.qv
      let l_rhs = qbe_lbl(g, "and_rhs")
      let l_false = qbe_lbl(g, "and_f")
      let l_end = qbe_lbl(g, "and_e")
      qbe_emit_jnz_l(g, lv.reg, l_rhs, l_false)
      qbe_emit_lbl(g, l_false)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_rhs)
      frame.state = 3
      frame.short_label = l_false
      frame.end_label = l_end
      cur = rhs
      cur_exp = Some(TBool)
      cur_cb = false
      cur_cbaf = false
      cur_is_lhs = false
      has_val = false
    } else if st == 3 {
      let rv = cur_arg.qv
      let l_false = frame.short_label
      let l_end = frame.end_label
      let _ = frames.pop()
      let rhs_term = g.block_term
      let rhs_lbl = g.cur_lbl
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      let r = qbe_tmp(g)
      if rhs_term {
        qbe_emit(g, r + " =l copy 0")
      } else {
        qbe_emit(g, r + " =l phi " + l_false + " 0, " + rhs_lbl + " " + rv.reg)
      }
      cur_arg = QbeArgVal::{ qv: qval(r, TBool), borrowed: false }
      has_val = true
    } else if st == 4 {
      let lv = cur_arg.qv
      let l_true = qbe_lbl(g, "or_t")
      let l_rhs = qbe_lbl(g, "or_rhs")
      let l_end = qbe_lbl(g, "or_e")
      qbe_emit_jnz_l(g, lv.reg, l_true, l_rhs)
      qbe_emit_lbl(g, l_true)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_rhs)
      frame.state = 5
      frame.short_label = l_true
      frame.end_label = l_end
      cur = rhs
      cur_exp = Some(TBool)
      cur_cb = false
      cur_cbaf = false
      cur_is_lhs = false
      has_val = false
    } else if st == 5 {
      let rv = cur_arg.qv
      let l_true = frame.short_label
      let l_end = frame.end_label
      let _ = frames.pop()
      let rhs_term = g.block_term
      let rhs_lbl = g.cur_lbl
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      let r = qbe_tmp(g)
      if rhs_term {
        qbe_emit(g, r + " =l copy 1")
      } else {
        qbe_emit(g, r + " =l phi " + l_true + " 1, " + rhs_lbl + " " + rv.reg)
      }
      cur_arg = QbeArgVal::{ qv: qval(r, TBool), borrowed: false }
      has_val = true
    } else {
      // st == 6: 2.0 * rhs -> rhs + rhs
      let rv = cur_arg.qv
      let _ = frames.pop()
      let qv = match rv.ty {
        TFloat => {
          let af = qbe_tmp(g)
          qbe_emit(g, af + " =s add " + rv.reg + ", " + rv.reg)
          qval(af, TFloat)
        }
        _ => {
          let rd = qbe_coerce_val(g, rv, TDouble)
          let ad = qbe_tmp(g)
          qbe_emit(g, ad + " =d add " + rd + ", " + rd)
          qval(ad, TDouble)
        }
      }
      cur_arg = QbeArgVal::{ qv: qv, borrowed: false }
      has_val = true
    }
  }
  cur_arg.qv
}

///|
/// Raw C symbols that user code links under (`extern "C"` declarations and
/// exports of this package and of every imported package, and the
/// `--entry-symbol` entry point). Generated private data must not take one of
/// these names.
fn qbe_extern_c_syms(g : QbeGen) -> Map[String, Bool] {
  match g.extern_c_syms {
    Some(m) => return m
    None => ()
  }
  let m : Map[String, Bool] = Map([])
  let tcs : Array[TypeChecker] = [g.tc]
  let pkgs = g.tc.all_imported_pkgs.keys()
  for k in pkgs {
    match g.tc.all_imported_pkgs.get(k) {
      Some(ip) => tcs.push(ip.tc)
      None => ()
    }
  }
  for tc in tcs {
    let names = tc.extern_fns.keys()
    for name in names {
      match tc.extern_fns.get(name) {
        Some(ei) => m.set(ei.decl.c_symbol, true)
        None => ()
      }
    }
    for csym in tc.exported_c_sym_names {
      m.set(csym, true)
    }
  }
  // `--entry-symbol` renames the exported entry point.
  if g.entry_symbol.length() > 0 {
    m.set(g.entry_symbol, true)
  }
  g.extern_c_syms = Some(m)
  m
}

///|
/// Next free `pion_<pkg>i32_literal_<N>` name (without `$`): neither it nor
/// its `_words` table may collide with a user C symbol.
fn qbe_i32_literal_sym(g : QbeGen) -> String {
  let taken = qbe_extern_c_syms(g)
  let prefix = "pion_" + g.pkg_prefix + "i32_literal_"
  let mut id = g.i32_literal_next_id
  while taken.contains(prefix + id.to_string()) || taken.contains(prefix + id.to_string() + "_words") {
    id = id + 1
  }
  g.i32_literal_next_id = id + 1
  prefix + id.to_string()
}

///|
// Materialize a fresh array via the runtime's existing stride-4 copy path.
// The unnamed backing storage and its descriptor are never exposed to user code.
fn qbe_i32_literal_table(g : QbeGen, elems : Array[Expr], ty : Ty) -> Option[QbeVal] {
  let words = StringBuilder()
  let mut i = 0
  while i < elems.length() {
    let word = match elems[i] {
      EInt(raw, _) => qbe_parse_int64_lit(raw).to_int()
      EUnary("-", EInt(raw, _), _) => (0L - qbe_parse_int64_lit(raw)).to_int()
      _ => return None
    }
    if i > 0 {
      words.write_string(", ")
    }
    words.write_string("w ")
    words.write_string(word.to_string())
    i = i + 1
  }
  let sym = "$" + qbe_i32_literal_sym(g)
  let n = elems.length().to_string()
  let data = StringBuilder()
  data.write_string("section \".rodata\" data " + sym + "_words = align 4 { ")
  data.write_string(words.to_string())
  data.write_string(" }\n")
  // Array ABI: length, capacity, ownership flag, element stride, data pointer.
  data.write_string("data " + sym + " = align 8 { l " + n + ", l " + n + ", w 0, w 4, l " + sym + "_words }\n")
  g.i32_literal_tables.push(data.to_string())
  let arr = qbe_tmp(g)
  qbe_emit(g, arr + " =l call $pion_arr_copy(l " + sym + ")")
  Some(qval(arr, ty))
}

///|
fn qbe_emit_expr(
  g : QbeGen,
  expr : Expr,
  expected : Option[Ty],
) -> QbeVal {
  qbe_emit_expr_mode(g, expr, expected, false)
}

///|
fn qbe_emit_expr_mode(
  g : QbeGen,
  expr : Expr,
  expected : Option[Ty],
  destructure : Bool,
) -> QbeVal {
  let res = qbe_emit_expr_inner(g, expr, expected, destructure)
  if g.known_min_len_arrs.length() > 0 {
    match expr {
      ECall(_, _, _) | EMethodCall(_, _, _, _) =>
        if !qbe_loop_has_no_calls_expr(g, expr) {
          qbe_invalidate_aliased_min_lens(g)
        }
      _ => ()
    }
  }
  match expected {
    Some(TDynTrait(tname)) =>
      match res.ty {
        TDynTrait(_) | TNever | TError => res
        _ => qbe_box_dyn(g, res, tname)
      }
    Some(TUnit) =>
      match res.ty {
        TUnit | TNever | TError => res
        _ => {
          if !g.block_term {
            qbe_rc_dec(g, res.reg, res.ty)
          }
          qval("0", TUnit)
        }
      }
    _ => res
  }
}

///|
fn qbe_emit_expr_inner(
  g : QbeGen,
  expr : Expr,
  expected : Option[Ty],
  destructure : Bool,
) -> QbeVal {
  match expr {
    EInt(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      match expected {
        Some(TUInt) => {
          let v32 = v64.to_int().to_int64()
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =w copy " + v32.to_string())
          qval(t, TUInt)
        }
        Some(TUInt64) => {
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l copy " + v64.to_string())
          qval(t, TUInt64)
        }
        Some(TInt8) => {
          let b = v64 & 255L
          let s8 = if b >= 128L { b - 256L } else { b }
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =l copy " + s8.to_string())
          qval(t, TInt8)
        }
        _ => {
          let v32 = v64.to_int().to_int64()
          let t = qbe_tmp(g)
          qbe_emit(g, t + " =w copy " + v32.to_string())
          qval(t, TInt)
        }
      }
    }
    EInt64(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v64.to_string())
      qval(t, TInt64)
    }
    EUInt(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let v32 = v64.to_int().to_int64()
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =w copy " + v32.to_string())
      qval(t, TUInt)
    }
    EUInt64(raw, _) => {
      let v64 = qbe_parse_int64_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v64.to_string())
      qval(t, TUInt64)
    }
    EDouble(raw, _) => {
      let sb = StringBuilder()
      let mut i = 0
      while i < raw.length() {
        let c = str_code_at(raw, i)
        if c != 95 {
          sb.write_char(c.unsafe_to_char())
        }
        i = i + 1
      }
      match expected {
        Some(TFloat) => {
          let f = qbe_tmp(g)
          qbe_emit(g, f + " =s copy s_" + sb.to_string())
          qval(f, TFloat)
        }
        _ => {
          let d = qbe_tmp(g)
          qbe_emit(g, d + " =d copy d_" + sb.to_string())
          qval(d, TDouble)
        }
      }
    }
    EFloat(raw, _) => {
      let sb = StringBuilder()
      let mut len = raw.length()
      if len > 0 && str_code_at(raw, len - 1) == 102 {
        len = len - 1
      }
      let mut i = 0
      while i < len {
        let c = str_code_at(raw, i)
        if c != 95 {
          sb.write_char(c.unsafe_to_char())
        }
        i = i + 1
      }
      let f = qbe_tmp(g)
      qbe_emit(g, f + " =s copy s_" + sb.to_string())
      qval(f, TFloat)
    }
    EBool(b, _) => {
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + (if b { "1" } else { "0" }))
      qval(t, TBool)
    }
    EByte(raw, _) => {
      let v = qbe_parse_char_lit(raw) & 255
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v.to_string())
      qval(t, TByte)
    }
    EChar(raw, _) => {
      let v = qbe_parse_char_lit(raw)
      let t = qbe_tmp(g)
      qbe_emit(g, t + " =l copy " + v.to_string())
      qval(t, TChar)
    }
    EString(s, _) => qval(qbe_emit_string_lit(g, s), TString)
    EUnit(_) => qval("0", TUnit)
    ENamedArg(_, _, inner, _) => qbe_emit_expr(g, inner, expected)
    EMutArg(inner, _) => qbe_emit_expr(g, inner, expected)
    EIdent(name, id_sp) => {
      match qbe_lookup_local(g, name) {
        Some(loc) => {
          if loc.is_cell {
            let cell_p = qbe_tmp(g)
            qbe_emit(g, cell_p + " =l loadl " + loc.slot)
            let t = qbe_load_heap_slot(g, cell_p, loc.ty)
            qbe_rc_inc(g, t, loc.ty)
            return qval(t, loc.ty)
          }
          if g.stack_view_slots.contains(loc.slot) {
            let stk = qbe_load_local_slot(g, loc.slot, loc.ty)
            let hv = qbe_emit_view_materialize(g, stk)
            return qval(hv, loc.ty)
          }
          let moved = if loc.owned && qbe_is_early_drop_ty(g, loc.ty) {
            match g.movable_locals.get(name) {
              Some(mslot) => mslot == loc.slot
              None => false
            }
          } else {
            false
          }
          let t = qbe_load_local_slot(g, loc.slot, loc.ty)
          g.unfrozen_local_arrs.remove(name)
          qbe_invalidate_known_min_len_if_dyn(g, name)
          if moved {
            g.movable_locals.remove(name)
            g.moved_slots.set(loc.slot, true)
            qbe_emit(g, "storel 0, " + loc.slot)
            return qval(t, loc.ty)
          }
          if qbe_is_int32_ty(loc.ty) {
            match g.local_w_to_l_ext.get(name) {
              Some(rl) => g.w_to_l_ext.set(t, rl)
              None => ()
            }
          }
          qbe_rc_inc(g, t, loc.ty)
          return qval(t, loc.ty)
        }
        None => ()
      }
      if g.mono_pkg != "" {
        match g.tc.imported_pkgs.get(g.mono_pkg) {
          Some(ipkg) => {
            match ipkg.tc.consts.get(name) {
              Some(cty) => {
                let qcty = qualify_imported_ty(ipkg.name, cty)
                match ipkg.tc.scalar_const_exprs.get(name) {
                  Some(ce) => return qbe_emit_expr(g, ce, Some(qcty))
                  None => ()
                }
                let t = qbe_load_heap_slot(g, qbe_ext_const_sym(ipkg.name, name), qcty)
                qbe_rc_inc(g, t, qcty)
                return qval(t, qcty)
              }
              None => ()
            }
            match ipkg.tc.fns.get(name) {
              Some(finfo) => {
                let qfi = qualify_fn_info(ipkg, finfo)
                return qbe_emit_fn_value(
                  g,
                  qfi,
                  qbe_ext_fn_sym(ipkg.name, name),
                  "ef",
                  qbe_mangle_qual_sym(ipkg.name + "::" + name),
                  ipkg.name,
                  expected,
                  id_sp,
                )
              }
              None => ()
            }
            match ipkg.tc.extern_fns.get(name) {
              Some(ei) => {
                let qei = qualify_extern_fn_info(ipkg, ei)
                return qbe_emit_extern_fn_value(
                  g,
                  qei,
                  "ex",
                  qbe_mangle_qual_sym(ipkg.name + "::" + name),
                )
              }
              None => ()
            }
            if name != "None" && name != "Some" && name != "Ok" && name != "Err" {
              match ipkg.tc.variant_to_enum.get(name) {
                Some(en) =>
                  return qbe_emit_variant_ctor(
                    g,
                    ipkg.name + "::" + en,
                    name,
                    [],
                    expected,
                  )
                None => ()
              }
            }
          }
          None => ()
        }
      }
      match g.tc.consts.get(name) {
        Some(cty) => {
          match cty {
            TInt =>
              match g.const_int_vals.get(name) {
                Some(v) => return qval(v.to_string(), TInt)
                None => ()
              }
            TInt64 =>
              match g.const_i64_vals.get(name) {
                Some(v) => return qval(v.to_string(), TInt64)
                None => ()
              }
            TBool =>
              match g.const_bool_vals.get(name) {
                Some(b) => return qval(if b { "1" } else { "0" }, TBool)
                None => ()
              }
            _ => ()
          }
          let t = qbe_load_heap_slot(g, qbe_local_const_sym(g, name), cty)
          qbe_rc_inc(g, t, cty)
          return qval(t, cty)
        }
        None => ()
      }
      match g.tc.fns.get(name) {
        Some(finfo) => {
          return qbe_emit_fn_value(
            g,
            finfo,
            qbe_local_fn_sym(g, name),
            "lf",
            qbe_mangle_pkg_sym(name),
            "",
            expected,
            id_sp,
          )
        }
        None => ()
      }
      match g.tc.extern_fns.get(name) {
        Some(einfo) => {
          return qbe_emit_extern_fn_value(
            g,
            einfo,
            "lx",
            qbe_mangle_pkg_sym(name),
          )
        }
        None => ()
      }
      if name == "None" {
        return qbe_emit_variant_ctor(g, "Option", "None", [], expected)
      }
      if g.tc.variant_to_enum.contains(name) {
        return qbe_emit_variant_ctor(g, "", name, [], expected)
      }
      qbe_fail_unresolved(g, "ident", "", name, id_sp)
    }
    EPath(qual, mem, id_sp) => {
      if qual == "Option" && mem == "None" {
        return qbe_emit_variant_ctor(g, "Option", "None", [], expected)
      }
      if g.mono_pkg != "" {
        match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
          Some(ipkg) => {
            if !has_qual_sep(qual) {
              match ipkg.tc.enums.get(qual) {
                Some(ei) =>
                  if enum_info_has_variant(ei, mem) {
                    return qbe_emit_variant_ctor(
                      g,
                      ipkg.name + "::" + qual,
                      mem,
                      [],
                      expected,
                    )
                  }
                None => ()
              }
            }
            let qp_m = split_qual_name(qual)
            if qp_m.prefix.length() > 0 {
              match resolve_pkg_for_lookup(ipkg.tc, qp_m.prefix, false) {
                Some(sub_pkg) => {
                  if sub_pkg.tc.enums.contains(qp_m.name) &&
                    tc_enum_has_variant(sub_pkg.tc, qp_m.name, mem) {
                    return qbe_emit_variant_ctor(
                      g,
                      sub_pkg.name + "::" + qp_m.name,
                      mem,
                      [],
                      expected,
                    )
                  }
                  match sub_pkg.tc.methods.get(qp_m.name + "::" + mem) {
                    Some(mi) => {
                      let qmi = qualify_fn_info(sub_pkg, mi)
                      return qbe_emit_fn_value(
                        g,
                        qmi,
                        qbe_ext_method_sym(sub_pkg.name, qp_m.name, mem),
                        "em",
                        qbe_mangle_qual_sym(sub_pkg.name + "::" + qp_m.name) + qbe_mangle_member_suffix(mem),
                        sub_pkg.name,
                        expected,
                        id_sp,
                      )
                    }
                    None => ()
                  }
                }
                None => ()
              }
            }
            match resolve_pkg_for_lookup(ipkg.tc, qual, false) {
              Some(sub_pkg) => {
                match sub_pkg.tc.consts.get(mem) {
                  Some(cty) => {
                    let qcty = qualify_imported_ty(sub_pkg.name, cty)
                    let t = qbe_load_heap_slot(g, qbe_ext_const_sym(sub_pkg.name, mem), qcty)
                    qbe_rc_inc(g, t, qcty)
                    return qval(t, qcty)
                  }
                  None => ()
                }
                match sub_pkg.tc.fns.get(mem) {
                  Some(finfo) => {
                    let qfi = qualify_fn_info(sub_pkg, finfo)
                    return qbe_emit_fn_value(
                      g,
                      qfi,
                      qbe_ext_fn_sym(sub_pkg.name, mem),
                      "ef",
                      qbe_mangle_qual_sym(sub_pkg.name + "::" + mem),
                      sub_pkg.name,
                      expected,
                      id_sp,
                    )
                  }
                  None => ()
                }
                match sub_pkg.tc.extern_fns.get(mem) {
                  Some(ei) => {
                    let qei = qualify_extern_fn_info(sub_pkg, ei)
                    return qbe_emit_extern_fn_value(
                      g,
                      qei,
                      "ex",
                      qbe_mangle_qual_sym(sub_pkg.name + "::" + mem),
                    )
                  }
                  None => ()
                }
                match sub_pkg.tc.variant_to_enum.get(mem) {
                  Some(en) =>
                    return qbe_emit_variant_ctor(
                      g,
                      sub_pkg.name + "::" + en,
                      mem,
                      [],
                      expected,
                    )
                  None => ()
                }
              }
              None => ()
            }
            if !has_qual_sep(qual) {
              match ipkg.tc.methods.get(qual + "::" + mem) {
                Some(mi) => {
                  let qmi = qualify_fn_info(ipkg, mi)
                  return qbe_emit_fn_value(
                    g,
                    qmi,
                    qbe_ext_method_sym(ipkg.name, qual, mem),
                    "em",
                    qbe_mangle_qual_sym(ipkg.name + "::" + qual) + qbe_mangle_member_suffix(mem),
                    ipkg.name,
                    expected,
                    id_sp,
                  )
                }
                None => ()
              }
            }
          }
          None => ()
        }
      }
      if g.mono_pkg == "" &&
        !g.tc.in_imported_default_arg &&
        !tc_is_imported_pkg_alias(g.tc, qual) &&
        g.tc.enums.contains(qual) &&
        tc_enum_has_variant(g.tc, qual, mem) {
        return qbe_emit_variant_ctor(g, qual, mem, [], expected)
      }
      let qp = split_qual_name(qual)
      let q_alias = qp.prefix
      let q_sub = qp.name
      if q_alias.length() > 0 {
        match qbe_resolve_pkg_in_scope(g, q_alias) {
          Some(ipkg) => {
            match ipkg.tc.enums.get(q_sub) {
              Some(ei) =>
                if enum_info_has_variant(ei, mem) {
                  return qbe_emit_variant_ctor(
                    g,
                    ipkg.name + "::" + q_sub,
                    mem,
                    [],
                    expected,
                  )
                }
              None => ()
            }
            match ipkg.tc.methods.get(q_sub + "::" + mem) {
              Some(mi) => {
                let qmi = qualify_fn_info(ipkg, mi)
                return qbe_emit_fn_value(
                  g,
                  qmi,
                  qbe_ext_method_sym(ipkg.name, q_sub, mem),
                  "em",
                  qbe_mangle_qual_sym(ipkg.name + "::" + q_sub) + qbe_mangle_member_suffix(mem),
                  ipkg.name,
                  expected,
                  id_sp,
                )
              }
              None => ()
            }
          }
          None => ()
        }
      }
      match qbe_resolve_pkg_in_scope(g, qual) {
        Some(ipkg) => {
          match ipkg.tc.consts.get(mem) {
            Some(cty) => {
              let qcty = qualify_imported_ty(ipkg.name, cty)
              let t = qbe_load_heap_slot(g, qbe_ext_const_sym(ipkg.name, mem), qcty)
              qbe_rc_inc(g, t, qcty)
              return qval(t, qcty)
            }
            None => ()
          }
          match ipkg.tc.fns.get(mem) {
            Some(finfo) => {
              let qfi = qualify_fn_info(ipkg, finfo)
              return qbe_emit_fn_value(
                g,
                qfi,
                qbe_ext_fn_sym(ipkg.name, mem),
                "ef",
                qbe_mangle_qual_sym(ipkg.name + "::" + mem),
                ipkg.name,
                expected,
                id_sp,
              )
            }
            None => ()
          }
          match ipkg.tc.extern_fns.get(mem) {
            Some(ei) => {
              let qei = qualify_extern_fn_info(ipkg, ei)
              return qbe_emit_extern_fn_value(
                g,
                qei,
                "ex",
                qbe_mangle_qual_sym(ipkg.name + "::" + mem),
              )
            }
            None => ()
          }
          match ipkg.tc.variant_to_enum.get(mem) {
            Some(en) =>
              return qbe_emit_variant_ctor(
                g,
                ipkg.name + "::" + en,
                mem,
                [],
                expected,
              )
            None => ()
          }
        }
        None => ()
      }
      if g.mono_pkg == "" && !g.tc.in_imported_default_arg && !tc_is_imported_pkg_alias(g.tc, qual) {
        match g.tc.methods.get(qual + "::" + mem) {
          Some(mi) => {
            return qbe_emit_fn_value(
              g,
              mi,
              qbe_method_call_sym(g, qual, mem),
              "lm",
              qbe_mangle_qual_sym(qual) + qbe_mangle_member_suffix(mem),
              "",
              expected,
              id_sp,
            )
          }
          None => ()
        }
      }
      qbe_fail_unresolved(g, "qualified_value", qual, mem, id_sp)
    }
    EDotVariant(vname, args, sp) => {
      let ename = match g.tc.dot_variant_resolve.get(span_key(sp)) {
        Some(en) => en
        None =>
          match expected {
            Some(TEnum(en, _)) => en
            Some(TOption(_)) => "Option"
            Some(TResult(_, _)) => "Result"
            _ => ""
          }
      }
      qbe_emit_variant_ctor(g, ename, vname, args, expected)
    }
    EMove(inner, _) => qbe_emit_expr(g, inner, expected)
    ETry(inner, try_sp) => {
      match qbe_try_emit_opt_res_scalarized(g, inner, 0, false) {
        Some(sc) => {
          if g.block_term {
            return qval("0", TNever)
          }
          match sc.ret_ty {
            TResult(ok_ty, err_ty) => {
              let tag_w = qbe_tmp(g)
              let l_ok = qbe_lbl(g, "try_ok")
              let l_err = qbe_lbl(g, "try_err")
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
              qbe_emit_lbl(g, l_err)
              let err_v = qbe_load_heap_slot(g, sc.err_slot, err_ty)
              qbe_emit_try_err_exit(g, err_v, err_ty, ok_ty, "", try_sp)
              qbe_emit_lbl(g, l_ok)
              let payload = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
              return qval(payload, ok_ty)
            }
            TOption(inner_ty) => {
              let tag_w = qbe_tmp(g)
              let l_some = qbe_lbl(g, "try_some")
              let l_none = qbe_lbl(g, "try_none")
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_some + ", " + l_none)
              qbe_emit_lbl(g, l_none)
              qbe_emit_try_none_exit(g)
              qbe_emit_lbl(g, l_some)
              let payload = qbe_load_heap_slot(g, sc.val_slot, inner_ty)
              return qval(payload, inner_ty)
            }
            _ => ()
          }
        }
        None => ()
      }
      let iv = qbe_emit_expr(g, inner, None)
      match iv.ty {
        TResult(ok_ty, err_ty) => {
          let tag = qbe_tmp(g)
          let is_ok = qbe_tmp(g)
          let l_ok = qbe_lbl(g, "try_ok")
          let l_err = qbe_lbl(g, "try_err")
          qbe_emit(g, tag + " =l loadl " + iv.reg)
          qbe_emit(g, is_ok + " =w ceql " + tag + ", 0")
          qbe_emit_term(g, "jnz " + is_ok + ", " + l_ok + ", " + l_err)
          qbe_emit_lbl(g, l_err)
          qbe_emit_try_err_exit(g, "", err_ty, ok_ty, iv.reg, try_sp)
          qbe_emit_lbl(g, l_ok)
          let p1 = qbe_tmp(g)
          qbe_emit(g, p1 + " =l add " + iv.reg + ", 8")
          let payload = qbe_load_heap_slot(g, p1, ok_ty)
          qbe_rc_inc(g, payload, ok_ty)
          qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
          qval(payload, ok_ty)
        }
        TOption(inner_ty) => {
          if qbe_is_niche_opt_inner(g, inner_ty) {
            let is_some = qbe_tmp(g)
            let l_some = qbe_lbl(g, "try_some")
            let l_none = qbe_lbl(g, "try_none")
            qbe_emit(g, is_some + " =w cnel " + iv.reg + ", 0")
            qbe_emit_term(g, "jnz " + is_some + ", " + l_some + ", " + l_none)
            qbe_emit_lbl(g, l_none)
            qbe_emit_try_none_exit(g)
            qbe_emit_lbl(g, l_some)
            qval(iv.reg, inner_ty)
          } else {
            let tag = qbe_tmp(g)
            let is_some = qbe_tmp(g)
            let l_some = qbe_lbl(g, "try_some")
            let l_none = qbe_lbl(g, "try_none")
            qbe_emit(g, tag + " =l loadl " + iv.reg)
            qbe_emit(g, is_some + " =w ceql " + tag + ", 1")
            qbe_emit_term(g, "jnz " + is_some + ", " + l_some + ", " + l_none)
            qbe_emit_lbl(g, l_none)
            qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
            qbe_emit_try_none_exit(g)
            qbe_emit_lbl(g, l_some)
            let p1 = qbe_tmp(g)
            qbe_emit(g, p1 + " =l add " + iv.reg + ", 8")
            let payload = qbe_load_heap_slot(g, p1, inner_ty)
            qbe_rc_inc(g, payload, inner_ty)
            qbe_emit(g, "call $pion_rc_dec(l " + iv.reg + ")")
            qval(payload, inner_ty)
          }
        }
        _ => iv
      }
    }
    EInterp(parts, _) => {
      if parts.length() == 0 {
        return qval(qbe_emit_string_lit(g, ""), TString)
      }
      let sb = qbe_tmp(g)
      qbe_emit(g, sb + " =l call $pion_strbuf_new(l 32)")
      let sb_exits = qbe_guards_any_exit(g, parts)
      let sb_guards = QbeArgGuards::{ exits: [sb_exits], slots: [], stores: [] }
      qbe_guard_val(g, sb_guards, QbeArgVal::{ qv: qval(sb, TStringBuilder), borrowed: false }, false, sb_exits)
      let mut i = 0
      while i < parts.length() {
        let part = parts[i]
        match part {
          EString(s, _) => {
            let lit = qbe_emit_string_lit(g, s)
            qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + lit + ")")
          }
          _ => {
            let pv = qbe_emit_expr(g, part, None)
            match pv.ty {
              TString => {
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + pv.reg + ")")
                qbe_rc_dec(g, pv.reg, TString)
              }
              TStrView => {
                let pp = qbe_tmp(g)
                let vp = qbe_tmp(g)
                let lp = qbe_tmp(g)
                let vl = qbe_tmp(g)
                let tmp_s = qbe_tmp(g)
                qbe_emit(g, pp + " =l add " + pv.reg + ", 8")
                qbe_emit(g, vp + " =l loadl " + pp)
                qbe_emit(g, lp + " =l add " + pv.reg + ", 16")
                qbe_emit(g, vl + " =l loadl " + lp)
                qbe_emit(g, tmp_s + " =l call $pion_str_from_cstr(l " + vp + ", l " + vl + ")")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + tmp_s + ")")
                qbe_rc_dec(g, tmp_s, TString)
                qbe_rc_dec(g, pv.reg, TStrView)
              }
              TInt => {
                let v64 = qbe_as_l(g, pv)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + v64 + ")")
              }
              TInt64 | TInt8 =>
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + pv.reg + ")")
              TUInt => {
                let v64 = qbe_as_l(g, pv)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + v64 + ")")
              }
              TUInt64 => {
                let is_big = qbe_tmp(g)
                let l_big = qbe_lbl(g, "iu64_big")
                let l_sm = qbe_lbl(g, "iu64_sm")
                let l_end = qbe_lbl(g, "iu64_end")
                qbe_emit(g, is_big + " =w csltl " + pv.reg + ", 0")
                qbe_emit_term(g, "jnz " + is_big + ", " + l_big + ", " + l_sm)
                qbe_emit_lbl(g, l_sm)
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + pv.reg + ")")
                qbe_emit_term(g, "jmp " + l_end)
                qbe_emit_lbl(g, l_big)
                let qv = qbe_tmp(g)
                let rv = qbe_tmp(g)
                qbe_emit(g, qv + " =l udiv " + pv.reg + ", 10")
                qbe_emit(g, rv + " =l urem " + pv.reg + ", 10")
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + qv + ")")
                qbe_emit(g, "call $pion_strbuf_push_int(l " + sb + ", l " + rv + ")")
                qbe_emit_term(g, "jmp " + l_end)
                qbe_emit_lbl(g, l_end)
              }
              TDouble => {
                let ds = qbe_tmp(g)
                qbe_emit(g, ds + " =l call $pion_double_to_str(d " + pv.reg + ")")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + ds + ")")
                qbe_emit(g, "call $pion_rc_dec(l " + ds + ")")
              }
              TFloat => {
                let d = qbe_tmp(g)
                let ds = qbe_tmp(g)
                qbe_emit(g, d + " =d exts " + pv.reg)
                qbe_emit(g, ds + " =l call $pion_double_to_str(d " + d + ")")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + ds + ")")
                qbe_emit(g, "call $pion_rc_dec(l " + ds + ")")
              }
              TBool => {
                let l_t = qbe_lbl(g, "ib_t")
                let l_f = qbe_lbl(g, "ib_f")
                let l_e = qbe_lbl(g, "ib_e")
                qbe_emit_jnz_l(g, pv.reg, l_t, l_f)
                qbe_emit_lbl(g, l_t)
                let st = qbe_emit_string_lit(g, "true")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + st + ")")
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_f)
                let sf = qbe_emit_string_lit(g, "false")
                qbe_emit(g, "call $pion_strbuf_push_str(l " + sb + ", l " + sf + ")")
                qbe_emit_term(g, "jmp " + l_e)
                qbe_emit_lbl(g, l_e)
              }
              TChar => {
                let cw = qbe_tmp(g)
                qbe_emit(g, cw + " =w copy " + pv.reg)
                qbe_emit(g, "call $pion_strbuf_push_char(l " + sb + ", w " + cw + ")")
              }
              _ => ()
            }
          }
        }
        i = i + 1
      }
      qbe_release_guards(g, sb_guards)
      if g.block_term {
        return qval("0", TString)
      }
      let res = qbe_tmp(g)
      qbe_emit(g, res + " =l call $pion_strbuf_to_str(l " + sb + ")")
      qbe_emit(g, "call $pion_rc_dec(l " + sb + ")")
      qval(res, TString)
    }
    EAs(inner, target, _) => {
      let rty = qbe_resolve_type(g, target)
      match rty {
        TDynTrait(_) => return qbe_emit_expr(g, inner, Some(rty))
        _ => ()
      }
      let v = qbe_emit_expr(g, inner, None)
      match rty {
        TDouble =>
          match v.ty {
            TInt => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d swtof " + v.reg)
              qval(d, TDouble)
            }
            TUInt => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d uwtof " + v.reg)
              qval(d, TDouble)
            }
            TInt64 | TByte | TInt8 | TChar | TBool => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d sltof " + v.reg)
              qval(d, TDouble)
            }
            TUInt64 => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d ultof " + v.reg)
              qval(d, TDouble)
            }
            TFloat => {
              let d = qbe_tmp(g)
              qbe_emit(g, d + " =d exts " + v.reg)
              qval(d, TDouble)
            }
            TDouble => qval(v.reg, TDouble)
            _ => qval(qbe_from_l(g, v.reg, TDouble), TDouble)
          }
        TFloat =>
          match v.ty {
            TInt => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s swtof " + v.reg)
              qval(f, TFloat)
            }
            TUInt => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s uwtof " + v.reg)
              qval(f, TFloat)
            }
            TInt64 | TByte | TInt8 | TChar | TBool => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s sltof " + v.reg)
              qval(f, TFloat)
            }
            TUInt64 => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s ultof " + v.reg)
              qval(f, TFloat)
            }
            TDouble => {
              let f = qbe_tmp(g)
              qbe_emit(g, f + " =s truncd " + v.reg)
              qval(f, TFloat)
            }
            TFloat => qval(v.reg, TFloat)
            _ => qval(qbe_from_l(g, v.reg, TFloat), TFloat)
          }
        TInt =>
          match v.ty {
            TDouble => qval(qbe_emit_flt_to_int_sat(g, v.reg, true, false, false), TInt)
            TFloat => qval(qbe_emit_flt_to_int_sat(g, v.reg, false, false, false), TInt)
            TInt | TUInt => qval(v.reg, TInt)
            _ => qval(qbe_coerce_val(g, v, TInt), TInt)
          }
        TUInt =>
          match v.ty {
            TDouble => qval(qbe_emit_flt_to_int_sat(g, v.reg, true, false, true), TUInt)
            TFloat => qval(qbe_emit_flt_to_int_sat(g, v.reg, false, false, true), TUInt)
            TInt | TUInt => qval(v.reg, TUInt)
            _ => qval(qbe_coerce_val(g, v, TUInt), TUInt)
          }
        TInt64 =>
          match v.ty {
            TDouble => qval(qbe_emit_flt_to_int_sat(g, v.reg, true, true, false), TInt64)
            TFloat => qval(qbe_emit_flt_to_int_sat(g, v.reg, false, true, false), TInt64)
            TInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsw " + v.reg)
              qval(r, TInt64)
            }
            TUInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + v.reg)
              qval(r, TInt64)
            }
            _ => qval(v.reg, TInt64)
          }
        TUInt64 =>
          match v.ty {
            TDouble => qval(qbe_emit_flt_to_int_sat(g, v.reg, true, true, true), TUInt64)
            TFloat => qval(qbe_emit_flt_to_int_sat(g, v.reg, false, true, true), TUInt64)
            TInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsw " + v.reg)
              qval(r, TUInt64)
            }
            TUInt => {
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extuw " + v.reg)
              qval(r, TUInt64)
            }
            _ => qval(v.reg, TUInt64)
          }
        TByte =>
          match v.ty {
            TDouble => {
              let w = qbe_emit_flt_to_int_sat(g, v.reg, true, false, false)
              let u = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, u + " =l extuw " + w)
              qbe_emit(g, r + " =l and " + u + ", 255")
              qval(r, TByte)
            }
            TFloat => {
              let w = qbe_emit_flt_to_int_sat(g, v.reg, false, false, false)
              let u = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, u + " =l extuw " + w)
              qbe_emit(g, r + " =l and " + u + ", 255")
              qval(r, TByte)
            }
            _ => {
              let vl = qbe_as_l(g, v)
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l and " + vl + ", 255")
              qval(r, TByte)
            }
          }
        TInt8 =>
          match v.ty {
            TDouble => {
              let w = qbe_emit_flt_to_int_sat(g, v.reg, true, false, false)
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsb " + w)
              qval(r, TInt8)
            }
            TFloat => {
              let w = qbe_emit_flt_to_int_sat(g, v.reg, false, false, false)
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l extsb " + w)
              qval(r, TInt8)
            }
            _ => {
              let vl = qbe_as_l(g, v)
              qval(qbe_extsb_l(g, vl), TInt8)
            }
          }
        TChar =>
          match v.ty {
            TChar | TBool | TByte => qval(v.reg, TChar)
            TInt => {
              let cp = qbe_tmp(g)
              qbe_emit(g, cp + " =l extsw " + v.reg)
              qval(qbe_emit_validate_char_scalar(g, cp, ""), TChar)
            }
            TUInt => {
              let cp = qbe_tmp(g)
              qbe_emit(g, cp + " =l extuw " + v.reg)
              qval(qbe_emit_validate_char_scalar(g, cp, ""), TChar)
            }
            TInt64 | TUInt64 | TInt8 =>
              qval(qbe_emit_validate_char_scalar(g, v.reg, ""), TChar)
            TDouble => {
              let sat = qbe_emit_flt_to_int_sat(g, v.reg, true, true, false)
              let ord = qbe_tmp(g)
              let is_nan = qbe_tmp(g)
              qbe_emit(g, ord + " =w ceqd " + v.reg + ", " + v.reg)
              qbe_emit(g, is_nan + " =w ceqw " + ord + ", 0")
              qval(qbe_emit_validate_char_scalar(g, sat, is_nan), TChar)
            }
            TFloat => {
              let sat = qbe_emit_flt_to_int_sat(g, v.reg, false, true, false)
              let ord = qbe_tmp(g)
              let is_nan = qbe_tmp(g)
              qbe_emit(g, ord + " =w ceqs " + v.reg + ", " + v.reg)
              qbe_emit(g, is_nan + " =w ceqw " + ord + ", 0")
              qval(qbe_emit_validate_char_scalar(g, sat, is_nan), TChar)
            }
            _ => qval(qbe_emit_validate_char_scalar(g, qbe_as_l(g, v), ""), TChar)
          }
        TBool =>
          match v.ty {
            TBool => qval(v.reg, TBool)
            TDouble => {
              let c = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, c + " =w cned " + v.reg + ", d_0.0")
              qbe_emit(g, r + " =l extuw " + c)
              qval(r, TBool)
            }
            TFloat => {
              let c = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, c + " =w cnes " + v.reg + ", s_0.0")
              qbe_emit(g, r + " =l extuw " + c)
              qval(r, TBool)
            }
            TInt | TUInt => {
              let c = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, c + " =w cnew " + v.reg + ", 0")
              qbe_emit(g, r + " =l extuw " + c)
              qval(r, TBool)
            }
            _ => {
              let c = qbe_tmp(g)
              let r = qbe_tmp(g)
              qbe_emit(g, c + " =w cnel " + v.reg + ", 0")
              qbe_emit(g, r + " =l extuw " + c)
              qval(r, TBool)
            }
          }
        _ => qval(qbe_coerce_val(g, v, rty), rty)
      }
    }
    EUnary(op, inner, _) => {
      let iv = qbe_emit_expr(g, inner, expected)
      if op == "!" {
        let w = qbe_tmp(g)
        let nw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, w + " =w copy " + iv.reg)
        qbe_emit(g, nw + " =w ceqw " + w + ", 0")
        qbe_emit(g, r + " =l extuw " + nw)
        qval(r, TBool)
      } else {
        match iv.ty {
          TInt => {
            let nw = qbe_tmp(g)
            qbe_emit(g, nw + " =w neg " + iv.reg)
            qval(nw, TInt)
          }
          TUInt => {
            let nw = qbe_tmp(g)
            qbe_emit(g, nw + " =w neg " + iv.reg)
            qval(nw, TUInt)
          }
          TDouble => {
            let nd = qbe_tmp(g)
            qbe_emit(g, nd + " =d neg " + iv.reg)
            qval(nd, TDouble)
          }
          TFloat => {
            let nf = qbe_tmp(g)
            qbe_emit(g, nf + " =s neg " + iv.reg)
            qval(nf, TFloat)
          }
          TInt8 => {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l neg " + iv.reg)
            qval(qbe_extsb_l(g, r), TInt8)
          }
          TByte => {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l neg " + iv.reg)
            qval(qbe_extub_l(g, r), TByte)
          }
          _ => {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l neg " + iv.reg)
            qval(r, iv.ty)
          }
        }
      }
    }
    EBinary(op, lhs, rhs, bin_sp) =>
      qbe_emit_binary_chain(g, op, lhs, rhs, bin_sp, expected)
    ECall(callee, args, sp) => {
      g.block_immut_fields = Map([])
      match callee {
        EIdent(name, _) => {
          if name == "StringBuilder" {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_strbuf_new(l 32)")
            return qval(r, TStringBuilder)
          }
          if name == "Map" {
            let has_init = args.length() == 1 &&
              (match args[0] {
                EArrayLit(elems, _) => elems.length() > 0
                _ => true
              })
            if has_init {
              return qbe_emit_map_init(g, expected, args[0], sp)
            }
            return match expected {
              Some(TMap(k, v)) => qbe_emit_map_new(g, k, v)
              _ => qbe_emit_map_new(g, TString, TError)
            }
          }
          if !qbe_has_user_callee_at(g, name, sp) {
          if name == "sha256_hex" {
            let can_b = !qbe_args_have_assign(args)
            let sa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let sv = sa.qv
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_sha256_hex(l " + sv.reg + ")")
            if !sa.borrowed {
              qbe_rc_dec(g, sv.reg, sv.ty)
            }
            return qval(r, TString)
          }
          if name == "fs_mmap_ro" {
            let can_b = !qbe_args_have_assign(args)
            let pa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let pv = pa.qv
            let ok_slot = qbe_alloc_slot4(g)
            let raw = qbe_tmp(g)
            qbe_emit(
              g,
              raw + " =l call $pion_fs_mmap_ro(l " + pv.reg + ", l " + ok_slot + ")",
            )
            if !pa.borrowed {
              qbe_rc_dec(g, pv.reg, pv.ty)
            }
            let ok_w = qbe_tmp(g)
            qbe_emit(g, ok_w + " =w loadw " + ok_slot)
            let res_slot = qbe_alloc_slot(g)
            let l_ok = qbe_lbl(g, "mmap_ok")
            let l_err = qbe_lbl(g, "mmap_err")
            let l_end = qbe_lbl(g, "mmap_end")
            qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
            qbe_emit_lbl(g, l_ok)
            let ok_obj = qbe_emit_result(g, 0, raw, TBytes, TString)
            qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_err)
            let err_obj = qbe_emit_result(g, 1, raw, TBytes, TString)
            qbe_emit(g, "storel " + err_obj + ", " + res_slot)
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_end)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l loadl " + res_slot)
            return qval(r, TResult(TBytes, TString))
          }
          if name == "fs_write_atomic_bytes" {
            let can_b = !qbe_args_have_assign(args)
            let pa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let da = qbe_emit_arg_maybe_borrow(g, args[1], Some(TBytes), can_b)
            let pv = pa.qv
            let dv = da.qv
            let ok_w = qbe_tmp(g)
            qbe_emit(
              g,
              ok_w + " =w call $pion_fs_write_atomic_bytes(l " + pv.reg + ", l " + dv.reg + ")",
            )
            if !da.borrowed {
              qbe_rc_dec(g, dv.reg, dv.ty)
            }
            if !pa.borrowed {
              qbe_rc_dec(g, pv.reg, pv.ty)
            }
            let res_slot = qbe_alloc_slot(g)
            let l_ok = qbe_lbl(g, "fwa_ok")
            let l_err = qbe_lbl(g, "fwa_err")
            let l_end = qbe_lbl(g, "fwa_end")
            qbe_emit_term(g, "jnz " + ok_w + ", " + l_ok + ", " + l_err)
            qbe_emit_lbl(g, l_ok)
            let ok_obj = qbe_emit_result(g, 0, "0", TUnit, TString)
            qbe_emit(g, "storel " + ok_obj + ", " + res_slot)
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_err)
            let err_s = qbe_emit_string_lit(g, "fs_write_atomic_bytes failed")
            let err_obj = qbe_emit_result(g, 1, err_s, TUnit, TString)
            qbe_emit(g, "storel " + err_obj + ", " + res_slot)
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_end)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l loadl " + res_slot)
            return qval(r, TResult(TUnit, TString))
          }
          match rt_prim_info(name) {
            Some(pr) => return qbe_emit_rt_prim_call(g, pr, args)
            None => ()
          }
          if name == "ptr_null" {
            return qval("0", TPtr)
          }
          if name == "ptr_is_null" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l ceql " + pv.reg + ", 0")
            return qval(r, TBool)
          }
          if name == "ptr_addr" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            return qval(pv.reg, TInt64)
          }
          if name == "c_fn_ptr" {
            let mut c_sym = ""
            if args.length() >= 1 {
              match args[0] {
                EIdent(tname, _) => {
                  if g.mono_pkg != "" {
                    match g.tc.imported_pkgs.get(g.mono_pkg) {
                      Some(ipkg) =>
                        match ipkg.tc.extern_fns.get(tname) {
                          Some(ei) => c_sym = ei.decl.c_symbol
                          None => ()
                        }
                      None => ()
                    }
                  }
                  if c_sym == "" {
                    match g.tc.extern_fns.get(tname) {
                      Some(ei) => c_sym = ei.decl.c_symbol
                      None => c_sym = tname
                    }
                  }
                }
                EPath(alias_name, mem, _) => {
                  match qbe_resolve_pkg_in_scope(g, alias_name) {
                    Some(ipkg) =>
                      match ipkg.tc.extern_fns.get(mem) {
                        Some(ei) => c_sym = ei.decl.c_symbol
                        None => ()
                      }
                    None => ()
                  }
                  if c_sym == "" && g.mono_pkg != "" {
                    match g.tc.imported_pkgs.get(g.mono_pkg) {
                      Some(mpkg) =>
                        match resolve_alias_pkg(mpkg.tc, alias_name) {
                          Some(ipkg) =>
                            match ipkg.tc.extern_fns.get(mem) {
                              Some(ei) => c_sym = ei.decl.c_symbol
                              None => ()
                            }
                          None => ()
                        }
                      None => ()
                    }
                  }
                  if c_sym == "" {
                    c_sym = mem
                  }
                }
                _ => ()
              }
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l copy $" + c_sym)
            return qval(r, TPtr)
          }
          if name == "str_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let sa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), can_b)
            let sv = sa.qv
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l add " + sv.reg + ", 8")
            if !sa.borrowed {
              qbe_rc_dec(g, sv.reg, sv.ty)
            }
            return qval(r, TPtr)
          }
          if name == "bytes_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let ba = qbe_emit_arg_maybe_borrow(g, args[0], Some(TBytes), can_b)
            let bv = ba.qv
            let p = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + bv.reg + ", 16")
            qbe_emit(g, r + " =l loadl " + p)
            if !ba.borrowed {
              qbe_rc_dec(g, bv.reg, bv.ty)
            }
            return qval(r, TPtr)
          }
          if name == "array_data_ptr" || name == "fixed_array_data_ptr" {
            let can_b = !qbe_args_have_assign(args)
            let aa = qbe_emit_arg_maybe_borrow(g, args[0], None, can_b)
            let av = aa.qv
            let p = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + av.reg + ", 24")
            qbe_emit(g, r + " =l loadl " + p)
            if !aa.borrowed {
              qbe_rc_dec(g, av.reg, av.ty)
            }
            return qval(r, TPtr)
          }
          if name == "ptr_read_f64" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let addr = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, r + " =d loadd " + addr)
            return qval(r, TDouble)
          }
          if name == "ptr_write_f64" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let vv = qbe_emit_expr(g, args[2], Some(TDouble))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let vd = qbe_coerce_val(g, vv, TDouble)
            let addr = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, "stored " + vd + ", " + addr)
            return qval("0", TUnit)
          }
          if name == "ptr_read_f32" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let addr = qbe_tmp(g)
            let s = qbe_tmp(g)
            let r = qbe_tmp(g)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, s + " =s loads " + addr)
            qbe_emit(g, r + " =d exts " + s)
            return qval(r, TDouble)
          }
          if name == "ptr_write_f32" {
            let pv = qbe_emit_expr(g, args[0], Some(TPtr))
            let ov = qbe_emit_expr(g, args[1], Some(TInt64))
            let vv = qbe_emit_expr(g, args[2], Some(TDouble))
            let ol = qbe_coerce_val(g, ov, TInt64)
            let vd = qbe_coerce_val(g, vv, TDouble)
            let s = qbe_tmp(g)
            let addr = qbe_tmp(g)
            qbe_emit(g, s + " =s truncd " + vd)
            qbe_emit(g, addr + " =l add " + pv.reg + ", " + ol)
            qbe_emit(g, "stores " + s + ", " + addr)
            return qval("0", TUnit)
          }
          if name == "ignore" {
            if args.length() >= 1 {
              let v = qbe_emit_expr(g, args[0], None)
              qbe_rc_dec(g, v.reg, v.ty)
            }
            return qval("0", TUnit)
          }
          if name == "physical_equal" && args.length() == 2 {
            let can_borrow = !qbe_args_may_mutate_locals(g, args)
            let guards = qbe_arg_guards_in_order(g, args)
            let lhs_exp : Option[Ty] = if qbe_lhs_needs_rhs_hint(args[0]) {
              qbe_eq_op_hint(g, sp, args[1])
            } else {
              None
            }
            let la = qbe_emit_arg_maybe_borrow(g, args[0], lhs_exp, can_borrow)
            qbe_guard_val(g, guards, la, false, guards.exits[0])
            let ra_exp : Option[Ty] = if qbe_ty_has_error(la.qv.ty) {
              None
            } else {
              match la.qv.ty {
                TNever => None
                _ => Some(la.qv.ty)
              }
            }
            let ra = qbe_emit_arg_maybe_borrow(g, args[1], ra_exp, can_borrow)
            qbe_guard_val(g, guards, ra, false, guards.exits[1])
            qbe_release_guards(g, guards)
            let lv = la.qv
            let rv = ra.qv
            let raw_ty = if qbe_ty_has_error(lv.ty) && !qbe_ty_has_error(rv.ty) {
              rv.ty
            } else {
              match lv.ty {
                TError | TNever => rv.ty
                _ => lv.ty
              }
            }
            let rty = subst_ty(raw_ty, g.cur_type_subst)
            match rty {
              TUnit => {
                if !la.borrowed {
                  qbe_rc_dec(g, lv.reg, lv.ty)
                }
                if !ra.borrowed {
                  qbe_rc_dec(g, rv.reg, rv.ty)
                }
                return qval("1", TBool)
              }
              _ => ()
            }
            let abi = qbe_abi_ty(rty)
            let cw = qbe_tmp(g)
            let r = qbe_tmp(g)
            if abi == "d" {
              let ld0 = qbe_coerce_val(g, lv, TDouble)
              let rd0 = qbe_coerce_val(g, rv, TDouble)
              let ld = if qbe_is_temp_reg(ld0) {
                ld0
              } else {
                let dt = qbe_tmp(g)
                qbe_emit(g, dt + " =d copy " + ld0)
                dt
              }
              let rd = if qbe_is_temp_reg(rd0) {
                rd0
              } else {
                let dt = qbe_tmp(g)
                qbe_emit(g, dt + " =d copy " + rd0)
                dt
              }
              let lb = qbe_tmp(g)
              let rb = qbe_tmp(g)
              qbe_emit(g, lb + " =l cast " + ld)
              qbe_emit(g, rb + " =l cast " + rd)
              qbe_emit(g, cw + " =w ceql " + lb + ", " + rb)
            } else if abi == "s" {
              let lf0 = qbe_coerce_val(g, lv, TFloat)
              let rf0 = qbe_coerce_val(g, rv, TFloat)
              let lf = if qbe_is_temp_reg(lf0) {
                lf0
              } else {
                let ft = qbe_tmp(g)
                qbe_emit(g, ft + " =s copy " + lf0)
                ft
              }
              let rf = if qbe_is_temp_reg(rf0) {
                rf0
              } else {
                let ft = qbe_tmp(g)
                qbe_emit(g, ft + " =s copy " + rf0)
                ft
              }
              let lb = qbe_tmp(g)
              let rb = qbe_tmp(g)
              qbe_emit(g, lb + " =w cast " + lf)
              qbe_emit(g, rb + " =w cast " + rf)
              qbe_emit(g, cw + " =w ceqw " + lb + ", " + rb)
            } else if abi == "w" {
              let lw = qbe_coerce_val(g, lv, rty)
              let rw = qbe_coerce_val(g, rv, rty)
              qbe_emit(g, cw + " =w ceqw " + lw + ", " + rw)
            } else {
              let ll = qbe_as_l(g, lv)
              let rl = qbe_as_l(g, rv)
              qbe_emit(g, cw + " =w ceql " + ll + ", " + rl)
            }
            if !la.borrowed {
              qbe_rc_dec(g, lv.reg, lv.ty)
            }
            if !ra.borrowed {
              qbe_rc_dec(g, rv.reg, rv.ty)
            }
            qbe_emit(g, r + " =l extuw " + cw)
            return qval(r, TBool)
          }
          if name == "math_sqrt" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d sqrt " + xd)
            return qval(r, TDouble)
          }
          if name == "math_abs" ||
            name == "math_floor" ||
            name == "math_ceil" ||
            name == "math_sin" ||
            name == "math_cos" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $pion_" + name + "(d " + xd + ")")
            return qval(r, TDouble)
          }
          if name == "math_cbrt" ||
            name == "math_tan" ||
            name == "math_asin" ||
            name == "math_acos" ||
            name == "math_atan" ||
            name == "math_exp" ||
            name == "math_log" ||
            name == "math_log1p" ||
            name == "math_round" ||
            name == "math_trunc" {
            let c_fn = if name == "math_cbrt" {
              "cbrt"
            } else if name == "math_tan" {
              "tan"
            } else if name == "math_asin" {
              "asin"
            } else if name == "math_acos" {
              "acos"
            } else if name == "math_atan" {
              "atan"
            } else if name == "math_exp" {
              "exp"
            } else if name == "math_log" {
              "log"
            } else if name == "math_log1p" {
              "log1p"
            } else if name == "math_round" {
              "round"
            } else {
              "trunc"
            }
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $" + c_fn + "(d " + xd + ")")
            return qval(r, TDouble)
          }
          if name == "math_pow" {
            let xv = qbe_emit_expr(g, args[0], Some(TDouble))
            let yv = qbe_emit_expr(g, args[1], Some(TDouble))
            let xd = qbe_coerce_val(g, xv, TDouble)
            let yd = qbe_coerce_val(g, yv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $pion_math_pow(d " + xd + ", d " + yd + ")")
            return qval(r, TDouble)
          }
          if name == "math_atan2" {
            let yv = qbe_emit_expr(g, args[0], Some(TDouble))
            let xv = qbe_emit_expr(g, args[1], Some(TDouble))
            let yd = qbe_coerce_val(g, yv, TDouble)
            let xd = qbe_coerce_val(g, xv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d call $atan2(d " + yd + ", d " + xd + ")")
            return qval(r, TDouble)
          }
          if is_world_builtin(name) {
            return qbe_emit_world_builtin(g, name, args)
          }
          if name == "abort" || name == "panic" {
            let file_id = qbe_intern_source_path(g, sp.file)
            let msg_arg = if args.length() >= 1 {
              let mv = qbe_emit_expr(g, args[0], Some(TString))
              match mv.ty {
                TString => {
                  let mp = qbe_tmp(g)
                  qbe_emit(g, mp + " =l add " + mv.reg + ", 8")
                  mp
                }
                _ => {
                  let msg_id = qbe_intern_cstring(g, "panic")
                  "$pion_cstr_" + msg_id.to_string()
                }
              }
            } else {
              let msg_id = qbe_intern_cstring(g, "panic")
              "$pion_cstr_" + msg_id.to_string()
            }
            qbe_emit(
              g,
              "call $pion_panic(l " +
              msg_arg +
              ", l $pion_cstr_" +
              file_id.to_string() +
              ", w " +
              sp.line.to_string() +
              ")",
            )
            return qval("0", TNever)
          }
          }
          let is_nonlocal_call = qbe_call_is_nonlocal(g, sp)
          if !is_nonlocal_call {
            match g.inline_closures.get(name) {
              Some(iclo) =>
                if args.length() == iclo.params.length() {
                  return qbe_emit_inline_closure_call(g, iclo, args)
                }
              None => ()
            }
            match qbe_lookup_local(g, name) {
              Some(loc) =>
                match loc.ty {
                  TFn(ptys, rty) => {
                    let clo_v = qbe_tmp(g)
                    if loc.is_cell {
                      let cell_p = qbe_tmp(g)
                      qbe_emit(g, cell_p + " =l loadl " + loc.slot)
                      qbe_emit(g, clo_v + " =l loadl " + cell_p)
                    } else {
                      qbe_emit(g, clo_v + " =l loadl " + loc.slot)
                    }
                    qbe_emit(g, "call $pion_rc_inc(l " + clo_v + ")")
                    let arg_vals : Array[String] = []
                    let arg_tys : Array[Ty] = []
                    let guards = qbe_arg_guards_in_order(g, args)
                    qbe_guard_callee(g, guards, args, qval(clo_v, loc.ty), false)
                    let mut i = 0
                    while i < args.length() {
                      let ep : Option[Ty] = if i < ptys.length() {
                        Some(ptys[i])
                      } else {
                        None
                      }
                      let av = qbe_emit_expr(g, args[i], ep)
                      arg_vals.push(av.reg)
                      arg_tys.push(av.ty)
                      qbe_guard_val(
                        g,
                        guards,
                        QbeArgVal::{ qv: av, borrowed: false },
                        false,
                        guards.exits[i],
                      )
                      i = i + 1
                    }
                    qbe_release_guards(g, guards)
                    let res = qbe_emit_closure_call(g, clo_v, arg_vals, arg_tys)
                    g.block_immut_fields = Map([])
                    return qval(qbe_from_l(g, res, rty), rty)
                  }
                  _ => ()
                }
              None => ()
            }
          }
          let const_clo_info : Option[(String, Array[Ty], Ty)] = if g.mono_pkg == "" {
            match g.tc.consts.get(name) {
              Some(TFn(ptys, rty)) => Some((qbe_local_const_sym(g, name), ptys, rty))
              _ => None
            }
          } else {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.consts.get(name) {
                  Some(TFn(raw_ptys, raw_rty)) => {
                    let q_ptys : Array[Ty] = []
                    let mut qpi = 0
                    while qpi < raw_ptys.length() {
                      q_ptys.push(qualify_imported_ty(g.mono_pkg, raw_ptys[qpi]))
                      qpi = qpi + 1
                    }
                    Some((
                      qbe_ext_const_sym(g.mono_pkg, name),
                      q_ptys,
                      qualify_imported_ty(g.mono_pkg, raw_rty),
                    ))
                  }
                  _ => None
                }
              None => None
            }
          }
          match const_clo_info {
            Some((const_sym, ptys, rty)) =>
              return qbe_emit_const_closure_call(g, const_sym, ptys, rty, args)
            None => ()
          }
          // Inside a fn monomorphized from an imported package's source, its own
          // unqualified top-level fns and enum variants mean `pkg::name`.
          if g.mono_pkg != "" {
            let skip_mono_pkg_lookup = if is_nonlocal_call {
              false
            } else {
              match qbe_lookup_local(g, name) {
                Some(_) => true
                None => false
              }
            }
            if !skip_mono_pkg_lookup {
              match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
                Some(ipkg) => {
                  match ipkg.tc.fns.get(name) {
                    Some(fi) =>
                      return qbe_emit_resolved_finfo_call(
                        g,
                        ipkg.name,
                        name,
                        qualify_fn_info(ipkg, fi),
                        qbe_ext_fn_sym(ipkg.name, name),
                        ipkg.name,
                        args,
                        expected,
                        sp,
                      )
                    None =>
                      match ipkg.tc.extern_fns.get(name) {
                        Some(ei) =>
                          return qbe_emit_extern_fn_call(
                            g,
                            qualify_extern_fn_info(ipkg, ei),
                            args,
                          )
                        None => ()
                      }
                  }
                  if name != "Some" &&
                    name != "None" &&
                    name != "Ok" &&
                    name != "Err" {
                    match ipkg.tc.variant_to_enum.get(name) {
                      Some(en) =>
                        return qbe_emit_variant_ctor(
                          g,
                          ipkg.name + "::" + en,
                          name,
                          args,
                          expected,
                        )
                      None => ()
                    }
                  }
                }
                None => ()
              }
            }
          }
          if name == "Some" ||
            name == "Ok" ||
            name == "Err" ||
            (g.tc.variant_to_enum.contains(name) && !g.tc.fns.contains(name) && !g.tc.extern_fns.contains(name)) {
            return qbe_emit_variant_ctor(g, "", name, args, expected)
          }
          match g.tc.fns.get(name) {
            Some(finfo) => {
              let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
              let norm_args = call_res.args
              let from_default = call_res.from_default
              let order = qbe_call_eval_order(finfo.decl.params, 0, args, norm_args.length())
              if finfo.decl.type_params.length() == 0 && !qbe_has_any_default(from_default) {
                match qbe_try_inline_hof_call(g, name, finfo, norm_args, order) {
                  Some(qv) => return qv
                  None => ()
                }
              }
              let subst : Map[String, Ty] = Map([])
              match expected {
                Some(et) => qbe_unify_tparams(g, finfo.ret_ty, et, subst)
                None => ()
              }
              let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let wbs : Array[QbeMutWb] = []
              qbe_preunify_reordered_args(g, finfo, 0, norm_args, order, subst, sp)
              qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
              let guards = qbe_arg_guards(g, norm_args, order)
              let mut oi = 0
              while oi < order.length() {
                let i = order[oi]
                let is_def = i < from_default.length() && from_default[i]
                if !is_def {
                  match norm_args[i] {
                    EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                    _ => ()
                  }
                }
                let exp_p : Option[Ty] = if i < finfo.param_tys.length() {
                  qbe_generic_arg_expect(
                    g,
                    finfo,
                    "",
                    subst_ty_mask_unbound(finfo.param_tys[i], finfo.decl.type_params, subst),
                    norm_args[i],
                  )
                } else {
                  None
                }
                let mut aa = QbeArgVal::{ qv: qval("0", TUnit), borrowed: false }
                let mut used_stack_view = false
                if is_def {
                  aa = qbe_emit_default_call_arg(
                    g,
                    finfo.decl.params,
                    finfo.param_tys,
                    finfo.decl.type_params,
                    i,
                    norm_args[i],
                    exp_p,
                    arg_vals,
                    arg_tys,
                    subst,
                    "",
                  )
                } else {
                  if can_borrow && finfo.decl.type_params.length() == 0 && !qbe_has_any_default(from_default) {
                    match qbe_view_expr_root_info(g, norm_args[i]) {
                      Some((_, vty)) =>
                        if qbe_fn_param_is_view_borrow(g, g.mono_pkg, name, finfo, i, 0) {
                          let stk = qbe_emit_stack_view_expr(g, norm_args[i])
                          aa = QbeArgVal::{ qv: qval(stk, vty), borrowed: true }
                          used_stack_view = true
                        }
                      None => ()
                    }
                  }
                  if !used_stack_view {
                    aa = qbe_emit_call_arg(g, finfo.decl.params, i, norm_args[i], exp_p, can_borrow, wbs, norm_args)
                  }
                }
                let av = aa.qv
                if i < finfo.param_tys.length() {
                  qbe_unify_tparams(g, finfo.param_tys[i], av.ty, subst)
                }
                arg_vals[i] = av.reg
                arg_tys[i] = av.ty
                arg_borrowed[i] = aa.borrowed
                qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(finfo.decl.params, i, norm_args[i]), guards.exits[oi])
                oi = oi + 1
              }
              qbe_release_guards(g, guards)
              if qbe_call_needs_mono(g, finfo, subst, "") {
                let mres = qbe_emit_mono_call(
                  g,
                  qbe_local_fn_sym(g, name),
                  finfo,
                  subst,
                  arg_vals,
                  arg_tys,
                  arg_borrowed,
                  "",
                )
                qbe_emit_mut_writebacks(g, wbs)
                return mres
              }
              // Small-function / leaf-function single-pass inlining (package-wide)
              match qbe_try_inline_fn_call(
                g,
                name,
                finfo,
                arg_vals,
                arg_tys,
                arg_borrowed,
                destructure,
              ) {
                Some(qv) => return qv
                None => ()
              }
              let call_args : Array[String] = []
              let call_abis : Array[String] = []
              let mut j = 0
              while j < arg_vals.length() {
                let decl_pty = if j < finfo.param_tys.length() {
                  finfo.param_tys[j]
                } else {
                  arg_tys[j]
                }
                if qbe_param_is_mut(finfo.decl.params, j) {
                  call_args.push(arg_vals[j])
                  call_abis.push("l")
                } else {
                  call_args.push(qbe_coerce_val(g, qval(arg_vals[j], arg_tys[j]), decl_pty))
                  call_abis.push(qbe_abi_ty(decl_pty))
                }
                j = j + 1
              }
              let ret_abi = qbe_abi_ty(finfo.ret_ty)
              let res = qbe_tmp(g)
              let sb = StringBuilder()
              sb.write_string(res)
              sb.write_string(" =")
              sb.write_string(ret_abi)
              sb.write_string(" call ")
              sb.write_string(qbe_local_fn_sym(g, name))
              sb.write_string("(")
              j = 0
              while j < call_args.length() {
                if j > 0 {
                  sb.write_string(", ")
                }
                sb.write_string(call_abis[j])
                sb.write_string(" ")
                sb.write_string(call_args[j])
                j = j + 1
              }
              let mut tpi = 0
              while tpi < finfo.decl.type_params.length() {
                if call_args.length() > 0 || tpi > 0 {
                  sb.write_string(", ")
                }
                let tp_ty = match subst.get(finfo.decl.type_params[tpi]) {
                  Some(t) => t
                  None => TError
                }
                sb.write_string("l ")
                sb.write_string(qbe_is_obj_flag(g, tp_ty))
                tpi = tpi + 1
              }
              sb.write_string(")")
              qbe_emit(g, sb.to_string())
              g.block_immut_fields = Map([])
              j = 0
              while j < arg_vals.length() {
                if !arg_borrowed[j] {
                  qbe_rc_dec(g, arg_vals[j], arg_tys[j])
                }
                j = j + 1
              }
              qbe_emit_mut_writebacks(g, wbs)
              let concrete_ret = subst_ty(finfo.ret_ty, subst)
              let final_res = qbe_coerce_val(g, qval(res, finfo.ret_ty), concrete_ret)
              return qval(final_res, concrete_ret)
            }
            None => ()
          }
          match g.tc.extern_fns.get(name) {
            Some(einfo) => return qbe_emit_extern_fn_call(g, einfo, args)
            None => ()
          }
          qbe_fail_unresolved(g, "unqualified_call", "", name, sp)
        }
        EPath(qual, mem, _) => {
          if qual == "Double" && mem == "from_bits" {
            let bv = qbe_emit_expr(g, args[0], Some(TInt64))
            let bl = qbe_coerce_val(g, bv, TInt64)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =d cast " + bl)
            return qval(r, TDouble)
          }
          if (qual == "Float" || qual == "Float32") && mem == "from_double" {
            let dv = qbe_emit_expr(g, args[0], Some(TDouble))
            let dd = qbe_coerce_val(g, dv, TDouble)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s truncd " + dd)
            return qval(r, TFloat)
          }
          if (qual == "Float" || qual == "Float32") && mem == "from_int" {
            let iv = qbe_emit_expr(g, args[0], Some(TInt))
            let iw = qbe_coerce_val(g, iv, TInt)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s swtof " + iw)
            return qval(r, TFloat)
          }
          if (qual == "Float" || qual == "Float32") && mem == "from_bits" {
            let bv = qbe_emit_expr(g, args[0], Some(TInt))
            let bw = qbe_coerce_val(g, bv, TInt)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =s cast " + bw)
            return qval(r, TFloat)
          }
          if qual == "StringBuilder" && mem == "new" {
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_strbuf_new(l 32)")
            return qval(r, TStringBuilder)
          }
          if qual == "StringBuilder" && mem == "with_capacity" {
            let cap_v = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("32", TInt)
            }
            let cap_l = qbe_as_l(g, cap_v)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_strbuf_new(l " + cap_l + ")")
            return qval(r, TStringBuilder)
          }
          if qual == "Bytes" && mem == "new" {
            let lv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let ll = qbe_as_l(g, lv)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_bytes_new(l " + ll + ")")
            return qval(r, TBytes)
          }
          if qual == "Map" && (mem == "new" || mem == "with_capacity") {
            let mut cap_l = "0"
            if mem == "with_capacity" && args.length() >= 1 {
              let cv = qbe_emit_expr(g, args[0], Some(TInt))
              cap_l = qbe_as_l(g, cv)
            }
            let mut kty = TString
            let mut vty = TError
            match expected {
              Some(TMap(k, v)) => {
                kty = k
                vty = v
              }
              _ => ()
            }
            if qbe_is_vmap_key_ty(g, kty) {
              let m = qbe_ensure_vmap_fns(g, kty, vty)
              let r = qbe_tmp(g)
              qbe_emit(g, r + " =l call $pion_vmap_new_" + m + "(l " + cap_l + ")")
              return qval(r, TMap(kty, vty))
            }
            let vo = qbe_is_obj_flag_w(g, vty)
            let new_fn = if qbe_map_key_is_int(kty) {
              "$pion_map_new_int"
            } else {
              "$pion_map_new"
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call " + new_fn + "(w " + vo + ")")
            return qval(r, TMap(kty, vty))
          }
          if (qual == "Array" || qual == "ImmArray") && mem == "new" {
            let is_imm = qual == "ImmArray"
            let elem = match expected {
              Some(TArray(e)) => e
              Some(TImmArray(e)) => e
              _ => TError
            }
            let eo = qbe_arr_new_flags_w(g, elem)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_arr_new(l 0, w " + eo + ")")
            return qval(r, if is_imm { TImmArray(elem) } else { TArray(elem) })
          }
          if qual == "Array" && mem == "with_capacity" {
            let elem = match expected {
              Some(TArray(e)) => e
              _ => TError
            }
            let cap_l = if args.length() >= 1 {
              let cv = qbe_emit_expr(g, args[0], Some(TInt))
              let cw = qbe_coerce_val(g, cv, TInt)
              let is_neg = qbe_tmp(g)
              let cap_slot = qbe_alloc_slot_for(g, TInt)
              let l_zero = qbe_lbl(g, "acap_z")
              let l_pos = qbe_lbl(g, "acap_p")
              let l_done = qbe_lbl(g, "acap_d")
              qbe_emit(g, is_neg + " =w csltw " + cw + ", 0")
              qbe_emit_term(g, "jnz " + is_neg + ", " + l_zero + ", " + l_pos)
              qbe_emit_lbl(g, l_zero)
              qbe_emit(g, "storew 0, " + cap_slot)
              qbe_emit_term(g, "jmp " + l_done)
              qbe_emit_lbl(g, l_pos)
              qbe_emit(g, "storew " + cw + ", " + cap_slot)
              qbe_emit_term(g, "jmp " + l_done)
              qbe_emit_lbl(g, l_done)
              let clamped_w = qbe_tmp(g)
              let clamped_l = qbe_tmp(g)
              qbe_emit(g, clamped_w + " =w loadsw " + cap_slot)
              qbe_emit(g, clamped_l + " =l extsw " + clamped_w)
              clamped_l
            } else {
              "0"
            }
            let eo = qbe_arr_new_flags_w(g, elem)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_arr_new(l " + cap_l + ", w " + eo + ")")
            return qval(r, TArray(elem))
          }
          if (qual == "Array" || qual == "FixedArray" || qual == "ImmArray") && mem == "make" {
            let is_fixed = qual == "FixedArray"
            let is_imm = qual == "ImmArray"
            let exp_elem : Option[Ty] = match expected {
              Some(TArray(e)) => Some(e)
              Some(TFixedArray(e)) => Some(e)
              Some(TImmArray(e)) => Some(e)
              _ => None
            }
            let len_v = qbe_emit_expr(g, args[0], Some(TInt))
            let len_l = qbe_as_l(g, len_v)
            let init_v = qbe_emit_expr(g, args[1], exp_elem)
            let elem = match exp_elem {
              Some(e) =>
                if (ty_has_unresolved(e) || qbe_ty_has_param(subst_ty(e, g.cur_type_subst))) &&
                  !ty_has_unresolved(init_v.ty) &&
                  !qbe_ty_has_param(subst_ty(init_v.ty, g.cur_type_subst)) {
                  init_v.ty
                } else {
                  e
                }
              None => init_v.ty
            }
            let coerced = qbe_coerce_val(g, init_v, elem)
            let init_l = qbe_as_l(g, qval(coerced, elem))
            let is_u8 = qbe_is_u8_array_elem(g, elem)
            let is_4b = qbe_is_4b_array_elem(g, elem)
            let flat_stride = qbe_flat_pod_stride(g, elem)
            let eo = qbe_arr_new_flags_w(g, elem)
            let arr = qbe_tmp(g)
            qbe_emit(g, arr + " =l call $pion_arr_new(l " + len_l + ", w " + eo + ")")
            let has_pos = qbe_tmp(g)
            let l_init = qbe_lbl(g, "amk_i")
            let l_end = qbe_lbl(g, "amk_e")
            qbe_emit(g, has_pos + " =w csgtl " + len_l + ", 0")
            qbe_emit_term(g, "jnz " + has_pos + ", " + l_init + ", " + l_end)
            qbe_emit_lbl(g, l_init)
            let dp_p = qbe_tmp(g)
            let dp = qbe_tmp(g)
            qbe_emit(g, dp_p + " =l add " + arr + ", 24")
            qbe_emit(g, dp + " =l loadl " + dp_p)
            if is_u8 {
              let init_w = qbe_tmp(g)
              qbe_emit(g, init_w + " =w copy " + init_l)
              qbe_emit(g, "call $memset(l " + dp + ", w " + init_w + ", l " + len_l + ")")
              qbe_emit(g, "storel " + len_l + ", " + arr)
              qbe_emit_term(g, "jmp " + l_end)
            } else if is_4b {
              let init_w = qbe_tmp(g)
              let is_z = qbe_tmp(g)
              let l_z = qbe_lbl(g, "amk_fz")
              let l_fl = qbe_lbl(g, "amk_fl")
              let l_fc = qbe_lbl(g, "amk_fc")
              let l_fb = qbe_lbl(g, "amk_fb")
              let l_fd = qbe_lbl(g, "amk_fd")
              qbe_emit(g, init_w + " =w copy " + init_l)
              qbe_emit(g, is_z + " =w ceqw " + init_w + ", 0")
              qbe_emit_term(g, "jnz " + is_z + ", " + l_z + ", " + l_fl)
              qbe_emit_lbl(g, l_z)
              let blen = qbe_tmp(g)
              qbe_emit(g, blen + " =l shl " + len_l + ", 2")
              qbe_emit(g, "call $memset(l " + dp + ", w 0, l " + blen + ")")
              qbe_emit(g, "storel " + len_l + ", " + arr)
              qbe_emit_term(g, "jmp " + l_end)
              qbe_emit_lbl(g, l_fl)
              let idx_slot = qbe_alloc_slot(g)
              qbe_emit(g, "storel 0, " + idx_slot)
              qbe_emit_term(g, "jmp " + l_fc)
              qbe_emit_lbl(g, l_fc)
              let ci = qbe_tmp(g)
              let cc = qbe_tmp(g)
              qbe_emit(g, ci + " =l loadl " + idx_slot)
              qbe_emit(g, cc + " =w csltl " + ci + ", " + len_l)
              qbe_emit_term(g, "jnz " + cc + ", " + l_fb + ", " + l_fd)
              qbe_emit_lbl(g, l_fb)
              let off = qbe_tmp(g)
              let ep = qbe_tmp(g)
              qbe_emit(g, off + " =l shl " + ci + ", 2")
              qbe_emit(g, ep + " =l add " + dp + ", " + off)
              qbe_emit(g, "storew " + init_w + ", " + ep)
              let ni = qbe_tmp(g)
              qbe_emit(g, ni + " =l add " + ci + ", 1")
              qbe_emit(g, "storel " + ni + ", " + idx_slot)
              qbe_emit_term(g, "jmp " + l_fc)
              qbe_emit_lbl(g, l_fd)
              qbe_emit(g, "storel " + len_l + ", " + arr)
              qbe_emit_term(g, "jmp " + l_end)
            } else {
              let l_cond = qbe_lbl(g, "amk_c")
              let l_body = qbe_lbl(g, "amk_b")
              let l_done = qbe_lbl(g, "amk_d")
              let idx_slot = qbe_alloc_slot(g)
              qbe_emit(g, "storel 0, " + idx_slot)
              qbe_emit_term(g, "jmp " + l_cond)
              qbe_emit_lbl(g, l_cond)
              let ci = qbe_tmp(g)
              let cc = qbe_tmp(g)
              qbe_emit(g, ci + " =l loadl " + idx_slot)
              qbe_emit(g, cc + " =w csltl " + ci + ", " + len_l)
              qbe_emit_term(g, "jnz " + cc + ", " + l_body + ", " + l_done)
              qbe_emit_lbl(g, l_body)
              match qbe_flat_pod_struct_info(g, elem) {
                Some(sinfo) => {
                  let ep = qbe_emit_arr_elem_addr(g, dp, ci, flat_stride)
                  qbe_emit_flat_copy_slots_rc(g, ep, init_l, sinfo, elem, true, false, "")
                }
                None => {
                  if !qbe_is_prim_array_elem(elem) {
                    qbe_rc_inc(g, init_l, elem)
                  }
                  let off = qbe_tmp(g)
                  let ep = qbe_tmp(g)
                  qbe_emit(g, off + " =l shl " + ci + ", 3")
                  qbe_emit(g, ep + " =l add " + dp + ", " + off)
                  qbe_emit(g, "storel " + init_l + ", " + ep)
                }
              }
              let ni = qbe_tmp(g)
              qbe_emit(g, ni + " =l add " + ci + ", 1")
              qbe_emit(g, "storel " + ni + ", " + idx_slot)
              qbe_emit_term(g, "jmp " + l_cond)
              qbe_emit_lbl(g, l_done)
              qbe_emit(g, "storel " + len_l + ", " + arr)
              qbe_emit_term(g, "jmp " + l_end)
            }
            qbe_emit_lbl(g, l_end)
            qbe_rc_dec(g, init_v.reg, init_v.ty)
            return qval(arr, if is_fixed { TFixedArray(elem) } else if is_imm { TImmArray(elem) } else { TArray(elem) })
          }
          if qual == "FixedArray" && mem == "makei" {
            let exp_elem : Option[Ty] = match expected {
              Some(TFixedArray(e)) => Some(e)
              _ => None
            }
            let len_v = qbe_emit_expr(g, args[0], Some(TInt))
            let len_l = qbe_as_l(g, len_v)
            let exp_fn : Option[Ty] = match exp_elem {
              Some(e) => Some(TFn([TInt], e))
              None => None
            }
            let fn_v = qbe_emit_expr(g, args[1], exp_fn)
            let elem = match exp_elem {
              Some(e) =>
                if ty_has_unresolved(e) || qbe_ty_has_param(subst_ty(e, g.cur_type_subst)) {
                  match fn_v.ty {
                    TFn(_, rt) =>
                      if !ty_has_unresolved(rt) && !qbe_ty_has_param(subst_ty(rt, g.cur_type_subst)) {
                        rt
                      } else {
                        e
                      }
                    _ => e
                  }
                } else {
                  e
                }
              None =>
                match fn_v.ty {
                  TFn(_, rt) => rt
                  _ => TError
                }
            }
            let is_u8 = qbe_is_u8_array_elem(g, elem)
            let flat_stride = qbe_flat_pod_stride(g, elem)
            let eo = qbe_arr_new_flags_w(g, elem)
            let arr = qbe_tmp(g)
            qbe_emit(g, arr + " =l call $pion_arr_new(l " + len_l + ", w " + eo + ")")
            let has_pos = qbe_tmp(g)
            let l_init = qbe_lbl(g, "fmi_i")
            let l_cond = qbe_lbl(g, "fmi_c")
            let l_body = qbe_lbl(g, "fmi_b")
            let l_end = qbe_lbl(g, "fmi_e")
            qbe_emit(g, has_pos + " =w csgtl " + len_l + ", 0")
            qbe_emit_term(g, "jnz " + has_pos + ", " + l_init + ", " + l_end)
            qbe_emit_lbl(g, l_init)
            let dp_p = qbe_tmp(g)
            let dp = qbe_tmp(g)
            qbe_emit(g, dp_p + " =l add " + arr + ", 24")
            qbe_emit(g, dp + " =l loadl " + dp_p)
            let idx_slot = qbe_alloc_slot(g)
            qbe_emit(g, "storel 0, " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_cond)
            let ci = qbe_tmp(g)
            let cc = qbe_tmp(g)
            qbe_emit(g, ci + " =l loadl " + idx_slot)
            qbe_emit(g, cc + " =w csltl " + ci + ", " + len_l)
            qbe_emit_term(g, "jnz " + cc + ", " + l_body + ", " + l_end)
            qbe_emit_lbl(g, l_body)
            let iw = qbe_tmp(g)
            qbe_emit(g, iw + " =w copy " + ci)
            qbe_emit(g, "call $pion_rc_inc(l " + fn_v.reg + ")")
            let res_l = qbe_emit_closure_call(g, fn_v.reg, [iw], [TInt])
            match qbe_flat_pod_struct_info(g, elem) {
              Some(sinfo) => {
                let ep = qbe_emit_arr_elem_addr(g, dp, ci, flat_stride)
                qbe_emit_flat_copy_slots_rc(g, ep, res_l, sinfo, elem, true, false, "")
                qbe_emit(g, "call $pion_rc_dec(l " + res_l + ")")
              }
              None => {
                let ep = qbe_emit_arr_ep_ty(g, dp, ci, elem)
                if is_u8 {
                  qbe_store_arr_u8(g, res_l, ep)
                } else if qbe_is_4b_array_elem(g, elem) {
                  qbe_store_arr_4b_l(g, res_l, ep)
                } else {
                  qbe_emit(g, "storel " + res_l + ", " + ep)
                }
              }
            }
            let ni = qbe_tmp(g)
            qbe_emit(g, ni + " =l add " + ci + ", 1")
            qbe_emit(g, "storel " + ni + ", " + arr)
            qbe_emit(g, "storel " + ni + ", " + idx_slot)
            qbe_emit_term(g, "jmp " + l_cond)
            qbe_emit_lbl(g, l_end)
            qbe_rc_dec(g, fn_v.reg, fn_v.ty)
            return qval(arr, TFixedArray(elem))
          }
          if (qual == "FixedArray" || qual == "ImmArray") && mem == "from_array" {
            let is_imm = qual == "ImmArray"
            let exp_arr : Option[Ty] = match expected {
              Some(TFixedArray(e)) | Some(TImmArray(e)) => Some(TArray(e))
              _ => None
            }
            let av = qbe_emit_expr(g, args[0], exp_arr)
            let elem = match av.ty {
              TArray(e) => e
              _ =>
                match expected {
                  Some(TFixedArray(e)) | Some(TImmArray(e)) => e
                  _ => TError
                }
            }
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_arr_copy(l " + av.reg + ")")
            qbe_rc_dec(g, av.reg, av.ty)
            return qval(r, if is_imm { TImmArray(elem) } else { TFixedArray(elem) })
          }
          if qual == "Channel" && mem == "new" {
            let elem = match expected {
              Some(TChannel(e)) => e
              _ => TError
            }
            let cap_v = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let cap_l = qbe_as_l(g, cap_v)
            let eo = qbe_is_obj_flag_w(g, elem)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_chan_new(l " + cap_l + ", w " + eo + ")")
            return qval(r, TChannel(elem))
          }
          if qual == "Mutex" && mem == "new" {
            let exp_inner : Option[Ty] = match expected {
              Some(TMutex(e)) => Some(e)
              _ => None
            }
            let iv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], exp_inner)
            } else {
              qbe_fail_unresolved(g, "mutex_new_arg", qual, mem, sp)
            }
            let vo = qbe_is_obj_flag_w(g, iv.ty)
            let il = qbe_as_l(g, iv)
            qbe_emit_deep_freeze(g, il, iv.ty)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_mutex_new(l " + il + ", w " + vo + ")")
            qbe_rc_dec(g, iv.reg, iv.ty)
            return qval(r, TMutex(iv.ty))
          }
          if qual == "AtomicInt" && mem == "new" {
            let iv = if args.length() >= 1 {
              qbe_emit_expr(g, args[0], Some(TInt))
            } else {
              qval("0", TInt)
            }
            let il = qbe_as_l(g, iv)
            let r = qbe_tmp(g)
            qbe_emit(g, r + " =l call $pion_atomic_new(l " + il + ")")
            return qval(r, TAtomicInt)
          }
          if qual == "Option" || qual == "Result" {
            return qbe_emit_variant_ctor(g, qual, mem, args, expected)
          }
          if g.mono_pkg != "" && !has_qual_sep(qual) {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.enums.get(qual) {
                  Some(ei) =>
                    if enum_info_has_variant(ei, mem) {
                      return qbe_emit_variant_ctor(
                        g,
                        ipkg.name + "::" + qual,
                        mem,
                        args,
                        expected,
                      )
                    }
                  None => ()
                }
              None => ()
            }
          }
          if g.mono_pkg == "" &&
            !g.tc.in_imported_default_arg &&
            !tc_is_imported_pkg_alias(g.tc, qual) {
            match g.tc.enums.get(qual) {
              Some(ei) =>
                if enum_info_has_variant(ei, mem) {
                  return qbe_emit_variant_ctor(g, qual, mem, args, expected)
                }
              None => ()
            }
          }
          let mut target_finfo : Option[FnInfo] = None
          let mut target_sym = ""
          let mut target_pkg = ""
          let qp = split_qual_name(qual)
          let q_alias = qp.prefix
          let q_sub = qp.name
          if q_alias.length() > 0 {
            match qbe_resolve_pkg_in_scope(g, q_alias) {
              Some(ipkg) => {
                match ipkg.tc.enums.get(q_sub) {
                  Some(ei) =>
                    if enum_info_has_variant(ei, mem) {
                      return qbe_emit_variant_ctor(
                        g,
                        ipkg.name + "::" + q_sub,
                        mem,
                        args,
                        expected,
                      )
                    }
                  None => ()
                }
                match ipkg.tc.methods.get(q_sub + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_sym = qbe_ext_method_sym(ipkg.name, q_sub, mem)
                    target_pkg = ipkg.name
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
          match target_finfo {
            None =>
              match qbe_resolve_pkg_in_scope(g, qual) {
                Some(ipkg) => {
                  match ipkg.tc.fns.get(mem) {
                    Some(fi) => {
                      target_finfo = Some(qualify_fn_info(ipkg, fi))
                      target_sym = qbe_ext_fn_sym(ipkg.name, mem)
                      target_pkg = ipkg.name
                    }
                    None =>
                      match ipkg.tc.extern_fns.get(mem) {
                        Some(ei) =>
                          return qbe_emit_extern_fn_call(
                            g,
                            qualify_extern_fn_info(ipkg, ei),
                            args,
                          )
                        None => ()
                      }
                  }
                  match target_finfo {
                    None => {
                      match ipkg.tc.consts.get(mem) {
                        Some(cty) =>
                          match qualify_imported_ty(ipkg.name, cty) {
                            TFn(ptys, rty) =>
                              return qbe_emit_const_closure_call(
                                g,
                                qbe_ext_const_sym(ipkg.name, mem),
                                ptys,
                                rty,
                                args,
                              )
                            _ => ()
                          }
                        None => ()
                      }
                      match ipkg.tc.variant_to_enum.get(mem) {
                        Some(en) =>
                          return qbe_emit_variant_ctor(
                            g,
                            ipkg.name + "::" + en,
                            mem,
                            args,
                            expected,
                          )
                        None => ()
                      }
                    }
                    Some(_) => ()
                  }
                }
                None => ()
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              if g.mono_pkg != "" {
                match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
                  Some(ipkg) => {
                    match ipkg.tc.enums.get(qual) {
                      Some(ei) =>
                        if enum_info_has_variant(ei, mem) {
                          return qbe_emit_variant_ctor(
                            g,
                            ipkg.name + "::" + qual,
                            mem,
                            args,
                            expected,
                          )
                        }
                      None => ()
                    }
                    match ipkg.tc.methods.get(qual + "::" + mem) {
                      Some(mi) => {
                        target_finfo = Some(qualify_fn_info(ipkg, mi))
                        target_sym = qbe_ext_method_sym(ipkg.name, qual, mem)
                        target_pkg = ipkg.name
                      }
                      None => ()
                    }
                  }
                  None => ()
                }
              }
            Some(_) => ()
          }
          match target_finfo {
            None =>
              if g.mono_pkg != "" || !tc_is_imported_pkg_alias(g.tc, qual) {
                match qbe_lookup_method_info_with_pkg(g, qual, mem) {
                  Some((minfo, mpkg)) => {
                    target_finfo = Some(minfo)
                    target_sym = qbe_method_call_sym(g, qual, mem)
                    target_pkg = mpkg
                  }
                  None => ()
                }
              }
            Some(_) => ()
          }
          match target_finfo {
            Some(minfo) =>
              return qbe_emit_resolved_finfo_call(
                g,
                qual,
                mem,
                minfo,
                target_sym,
                target_pkg,
                args,
                expected,
                sp,
              )
            None => qbe_fail_unresolved(g, "qualified_call", qual, mem, sp)
          }
        }
        _ => {
          let cv = qbe_emit_expr(g, callee, None)
          let mut ptys : Array[Ty] = []
          let mut rty = TError
          match cv.ty {
            TFn(ps, rt) => {
              ptys = ps
              rty = rt
            }
            _ => ()
          }
          let guards = qbe_arg_guards_in_order(g, args)
          qbe_guard_callee(g, guards, args, cv, false)
          let arg_vals : Array[String] = []
          let arg_tys : Array[Ty] = []
          let mut i = 0
          while i < args.length() {
            let ep : Option[Ty] = if i < ptys.length() {
              Some(ptys[i])
            } else {
              None
            }
            let av = qbe_emit_expr(g, args[i], ep)
            arg_vals.push(av.reg)
            arg_tys.push(av.ty)
            qbe_guard_val(g, guards, QbeArgVal::{ qv: av, borrowed: false }, false, guards.exits[i])
            i = i + 1
          }
          qbe_release_guards(g, guards)
          let res = qbe_emit_closure_call(g, cv.reg, arg_vals, arg_tys)
          g.block_immut_fields = Map([])
          qval(qbe_from_l(g, res, rty), rty)
        }
      }
    }
    EField(obj, field_name, fsp) => {
      let mut cache_key = ""
      match obj {
        EIdent(lname, _) => {
          cache_key = lname + "." + field_name
          match g.promoted_fields.get(cache_key) {
            Some(pslot) =>
              match g.promoted_field_tys.get(cache_key) {
                Some(pty) => {
                  let r = qbe_load_local_slot(g, pslot, pty)
                  return qval(r, pty)
                }
                None => ()
              }
            None => ()
          }
          match g.hoisted_fields.get(cache_key) {
            Some(hv) => {
              qbe_rc_inc(g, hv.reg, hv.ty)
              return hv
            }
            None => ()
          }
          match g.block_immut_fields.get(cache_key) {
            Some(bv) => return bv
            None => ()
          }
        }
        _ => ()
      }
      let mut borrowed = false
      let mut ov = qval("0", TError)
      match qbe_try_emit_borrowed_place(g, obj) {
        Some(bv) => {
          ov = bv
          borrowed = true
        }
        None => ()
      }
      if !borrowed {
        match obj {
          EIndex(container, idx, _) => {
            let mut projected = false
            ov = qbe_emit_index(g, container, idx, field_name, mut projected)
            if projected { return ov }
          }
          _ => ov = qbe_emit_expr(g, obj, None)
        }
      }
      match ov.ty {
        TTuple(elems) => {
          let idx = parse_tuple_index(field_name)
          if idx >= 0 && idx < elems.length() {
            let fty = elems[idx]
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + ov.reg + ", " + (idx * 8).to_string())
            let r = qbe_load_heap_slot(g, p, fty)
            qbe_rc_inc(g, r, fty)
            if !borrowed {
              qbe_rc_dec(g, ov.reg, ov.ty)
            }
            qval(r, fty)
          } else {
            if !borrowed {
              qbe_rc_dec(g, ov.reg, ov.ty)
            }
            qbe_fail_unresolved(g, "tuple_field", ty_to_string(ov.ty), field_name, fsp)
          }
        }
        TStruct(sname, sargs) =>
          match qbe_lookup_struct_info(g, sname) {
            Some(sinfo) => {
              let subst = make_subst(sinfo.decl.type_params, sargs)
              let mut i = 0
              while i < sinfo.field_names.length() {
                if sinfo.field_names[i] == field_name {
                  let fty = subst_ty(sinfo.field_tys[i], subst)
                  let p = qbe_tmp(g)
                  qbe_emit(g, p + " =l add " + ov.reg + ", " + (i * 8).to_string())
                  let r = qbe_load_heap_slot(g, p, fty)
                  qbe_rc_inc(g, r, fty)
                  if !borrowed {
                    qbe_rc_dec(g, ov.reg, ov.ty)
                  }
                  let res_val = qval(r, fty)
                  if borrowed && cache_key != "" && !sinfo.field_muts[i] {
                    let is_prim = match fty {
                      TInt | TInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar => true
                      _ => false
                    }
                    if is_prim {
                      g.block_immut_fields.set(cache_key, res_val)
                    }
                  }
                  return res_val
                }
                i = i + 1
              }
              if !borrowed {
                qbe_rc_dec(g, ov.reg, ov.ty)
              }
              qbe_fail_unresolved(g, "struct_field", sname, field_name, fsp)
            }
            None => {
              if !borrowed {
                qbe_rc_dec(g, ov.reg, ov.ty)
              }
              qbe_fail_unresolved(g, "struct_info", sname, field_name, fsp)
            }
          }
        TError => {
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval("0", TError)
        }
        _ => {
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qbe_fail_unresolved(g, "field_target", ty_to_string(ov.ty), field_name, fsp)
        }
      }
    }
    EMethodCall(obj, method_name, args, sp) => {
      g.block_immut_fields = Map([])
      let r = qbe_emit_method_call(g, obj, method_name, args, expected, sp)
      g.block_immut_fields = Map([])
      r
    }
    EIndex(obj, idx, _) => {
      let mut projected = false
      qbe_emit_index(g, obj, idx, "", mut projected)
    }
    EArrayLit(elems, _) => {
      if elems.length() >= 1024 {
        match expected {
          Some(t) =>
            match t {
              TArray(TInt) | TFixedArray(TInt) | TImmArray(TInt) =>
                match qbe_i32_literal_table(g, elems, t) {
                  Some(qv) => return qv
                  None => ()
                }
              _ => ()
            }
          None => ()
        }
      }
      let is_fixed = match expected {
        Some(TFixedArray(_)) => true
        _ => false
      }
      let is_imm = match expected {
        Some(TImmArray(_)) => true
        _ => false
      }
      let exp_elem : Option[Ty] = match expected {
        Some(TArray(e)) | Some(TFixedArray(e)) | Some(TImmArray(e)) =>
          match e {
            TError => None
            _ => Some(e)
          }
        _ => None
      }
      let elem_vals : Array[String] = []
      let elem_tys : Array[Ty] = []
      let mut elem_ty = match exp_elem {
        Some(e) => e
        None => TError
      }
      match qbe_flat_string_rows(g, elem_ty, elems) {
        Some(si) => {
          let arr = qbe_tmp(g)
          let n = elems.length().to_string()
          qbe_emit(g, arr + " =l call $pion_arr_new(l " + n + ", w " + qbe_arr_new_flags_w(g, elem_ty) + ")")
          let slot = qbe_tmp(g)
          let data = qbe_tmp(g)
          qbe_emit(g, slot + " =l add " + arr + ", 24")
          qbe_emit(g, data + " =l loadl " + slot)
          let mut row_index = 0
          for row in elems {
            match row {
              EStructLit(_, _, fields, _) => {
                let addr = if row_index == 0 {
                  data
                } else {
                  let row_addr = qbe_tmp(g)
                  qbe_emit(g, row_addr + " =l add " + data + ", " + (row_index * si.field_names.length() * 8).to_string())
                  row_addr
                }
                let vals = qbe_emit_flat_eval_struct_lit(g, si, elem_ty, fields)
                qbe_emit_flat_store_vals(g, addr, vals)
              }
              _ => ()
            }
            row_index = row_index + 1
          }
          qbe_emit(g, "storel " + n + ", " + arr)
          return qval(arr, if is_fixed { TFixedArray(elem_ty) } else if is_imm { TImmArray(elem_ty) } else { TArray(elem_ty) })
        }
        None => ()
      }
      let arr_guards = qbe_arg_guards_in_order(g, elems)
      let mut i = 0
      while i < elems.length() {
        let exp_cur : Option[Ty] = if i == 0 {
          exp_elem
        } else if qbe_is_untyped_option(elem_ty) {
          None
        } else {
          Some(elem_ty)
        }
        let ev = qbe_emit_expr(g, elems[i], exp_cur)
        if i == 0 {
          match exp_elem {
            Some(ee) =>
              if (ty_has_unresolved(ee) || qbe_ty_has_param(subst_ty(ee, g.cur_type_subst))) &&
                !ty_has_unresolved(ev.ty) &&
                !qbe_ty_has_param(subst_ty(ev.ty, g.cur_type_subst)) {
                elem_ty = ev.ty
              }
            None => elem_ty = ev.ty
          }
        } else if (qbe_is_untyped_option(elem_ty) && !qbe_is_untyped_option(ev.ty)) ||
          ((ty_has_unresolved(elem_ty) || qbe_ty_has_param(subst_ty(elem_ty, g.cur_type_subst))) &&
            !ty_has_unresolved(ev.ty) &&
            !qbe_ty_has_param(subst_ty(ev.ty, g.cur_type_subst))) {
          elem_ty = ev.ty
        }
        elem_vals.push(ev.reg)
        elem_tys.push(ev.ty)
        qbe_guard_val(g, arr_guards, QbeArgVal::{ qv: ev, borrowed: false }, false, arr_guards.exits[i])
        i = i + 1
      }
      qbe_release_guards(g, arr_guards)
      if g.block_term {
        return qval("0", TUnit)
      }
      let is_u8 = qbe_is_u8_array_elem(g, elem_ty)
      let is_4b = qbe_is_4b_array_elem(g, elem_ty)
      let flat_stride = qbe_flat_pod_stride(g, elem_ty)
      let eo = qbe_arr_new_flags_w(g, elem_ty)
      let arr = qbe_tmp(g)
      let n_elems = elem_vals.length()
      qbe_emit(
        g,
        arr + " =l call $pion_arr_new(l " + n_elems.to_string() + ", w " + eo + ")",
      )
      if n_elems > 0 {
        let dp_p = qbe_tmp(g)
        let dp = qbe_tmp(g)
        qbe_emit(g, dp_p + " =l add " + arr + ", 24")
        qbe_emit(g, dp + " =l loadl " + dp_p)
        match qbe_flat_pod_struct_info(g, elem_ty) {
          Some(sinfo) => {
            i = 0
            while i < n_elems {
              let ep = if i == 0 {
                dp
              } else {
                let p = qbe_tmp(g)
                qbe_emit(g, p + " =l add " + dp + ", " + (i * flat_stride).to_string())
                p
              }
              qbe_emit_flat_copy_slots_rc(g, ep, elem_vals[i], sinfo, elem_ty, true, false, "")
              qbe_rc_dec(g, elem_vals[i], elem_tys[i])
              i = i + 1
            }
          }
          None => {
            let elem_is_owned = match subst_ty(elem_ty, g.cur_type_subst) {
              TParam(_) => true
              t => qbe_is_obj_ty(g, t)
            }
            let elem_step = if is_u8 { 1 } else if is_4b { 4 } else { 8 }
            i = 0
            while i < n_elems {
              let coerced = qbe_coerce_val(g, qval(elem_vals[i], elem_tys[i]), elem_ty)
              let el = qbe_as_l(g, qval(coerced, elem_ty))
              let ep = if i == 0 {
                dp
              } else {
                let p = qbe_tmp(g)
                qbe_emit(g, p + " =l add " + dp + ", " + (i * elem_step).to_string())
                p
              }
              if is_u8 {
                qbe_store_arr_u8(g, el, ep)
              } else if is_4b {
                qbe_store_arr_4b_l(g, el, ep)
              } else {
                qbe_emit(g, "storel " + el + ", " + ep)
              }
              if !elem_is_owned {
                qbe_rc_dec(g, elem_vals[i], elem_tys[i])
              }
              i = i + 1
            }
          }
        }
        qbe_emit(g, "storel " + n_elems.to_string() + ", " + arr)
      }
      qval(arr, if is_fixed { TFixedArray(elem_ty) } else if is_imm { TImmArray(elem_ty) } else { TArray(elem_ty) })
    }
    EStructLit(sname, spread_opt, fields, lit_sp) => {
      let sp = lit_sp
      let base_qv_opt : Option[QbeVal] = match spread_opt {
        Some(base_e) => Some(qbe_emit_expr(g, base_e, expected))
        None => None
      }
      let tc_st_opt : Option[String] = if g.mono_pkg == "" {
        g.tc.resolved_method_calls.get("st:" + span_key(sp))
      } else {
        match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
          Some(mipkg) =>
            match mipkg.tc.resolved_method_calls.get("st:" + span_key(sp)) {
              Some(rn) =>
                Some(if has_qual_sep(rn) { rn } else { g.mono_pkg + "::" + rn })
              None => None
            }
          None => None
        }
      }
      let resolved_name = match tc_st_opt {
        Some(rn) => rn
        None => {
          let raw_name = if sname != "" {
            sname
          } else {
            match base_qv_opt {
              Some(bv) =>
                match bv.ty {
                  TStruct(bn, _) => bn
                  _ => ""
                }
              None =>
                match expected {
                  Some(TStruct(en, _)) => en
                  _ => ""
                }
            }
          }
          qbe_resolve_struct_lit_name(g, raw_name, sname != "")
        }
      }
      match qbe_lookup_struct_info(g, resolved_name) {
        // The type checker rejects every struct literal it cannot resolve, so reaching
        // this arm means codegen lost the struct context the checker had: stop with an
        // internal error instead of emitting a NULL struct pointer (runtime SIGSEGV).
        None =>
          abort(
            "internal compiler error: unresolved struct literal `" +
            (if sname == "" { "{ ... }" } else { sname + "::{ ... }" }) +
            "` at " +
            lit_sp.file +
            ":" +
            lit_sp.line.to_string() +
            ":" +
            lit_sp.col.to_string(),
          )
        Some(sinfo) => {
          let subst : Map[String, Ty] = Map([])
          match expected {
            Some(TStruct(en, eargs)) =>
              if en == resolved_name {
                let mut k = 0
                while k < sinfo.decl.type_params.length() && k < eargs.length() {
                  match eargs[k] {
                    TError => ()
                    _ => subst.set(sinfo.decl.type_params[k], eargs[k])
                  }
                  k = k + 1
                }
              }
            _ => ()
          }
          match base_qv_opt {
            Some(bv) =>
              match bv.ty {
                TStruct(bn, bargs) =>
                  if bn == resolved_name {
                    let mut k = 0
                    while k < sinfo.decl.type_params.length() && k < bargs.length() {
                      subst.set(sinfo.decl.type_params[k], bargs[k])
                      k = k + 1
                    }
                  }
                _ => ()
              }
            None => ()
          }
          let n_fields = sinfo.field_names.length()
          let slot_vals : Array[String] = []
          let slot_tys : Array[Ty] = []
          let overridden : Array[Bool] = []
          let mut init_i = 0
          while init_i < n_fields {
            slot_vals.push(qbe_zero_reg(sinfo.field_tys[init_i]))
            slot_tys.push(sinfo.field_tys[init_i])
            overridden.push(false)
            init_i = init_i + 1
          }
          let order : Array[Int] = []
          let field_exprs : Array[Expr] = []
          let mut fi = 0
          while fi < fields.length() {
            order.push(fi)
            field_exprs.push(fields[fi].value)
            fi = fi + 1
          }
          let guards = qbe_arg_guards(g, field_exprs, order)
          // `..base` fields are read before any override runs.
          match base_qv_opt {
            Some(bv) => {
              let exits = qbe_guards_exit_before_order(g, guards, field_exprs, order)
              let mut bi = 0
              while bi < n_fields {
                let mut is_over = false
                fi = 0
                while fi < fields.length() {
                  if fields[fi].name == sinfo.field_names[bi] {
                    is_over = true
                  }
                  fi = fi + 1
                }
                if !is_over {
                  let concrete_ty = subst_ty(sinfo.field_tys[bi], subst)
                  let bp = qbe_tmp(g)
                  qbe_emit(g, bp + " =l add " + bv.reg + ", " + (bi * 8).to_string())
                  let loaded = qbe_load_heap_slot(g, bp, concrete_ty)
                  qbe_rc_inc(g, loaded, concrete_ty)
                  slot_vals[bi] = loaded
                  slot_tys[bi] = concrete_ty
                  qbe_guard_val(g, guards, QbeArgVal::{ qv: qval(loaded, concrete_ty), borrowed: false }, false, exits)
                }
                bi = bi + 1
              }
              qbe_rc_dec(g, bv.reg, bv.ty)
            }
            None => ()
          }
          fi = 0
          while fi < fields.length() {
            let f = fields[fi]
            let mut j = 0
            while j < n_fields {
              if sinfo.field_names[j] == f.name {
                let exp_f = subst_ty_mask_unbound(
                  sinfo.field_tys[j],
                  sinfo.decl.type_params,
                  subst,
                )
                let fv = qbe_emit_expr(g, f.value, Some(exp_f))
                qbe_unify_tparams(g, sinfo.field_tys[j], fv.ty, subst)
                slot_vals[j] = fv.reg
                slot_tys[j] = fv.ty
                overridden[j] = true
                qbe_guard_val(g, guards, QbeArgVal::{ qv: fv, borrowed: false }, false, guards.exits[fi])
                break
              }
              j = j + 1
            }
            fi = fi + 1
          }
          qbe_release_guards(g, guards)
          let payload_sz = if n_fields == 0 { 8 } else { n_fields * 8 }
          let mut all_immut_struct = match spread_opt {
            None => true
            Some(_) => false
          }
          if all_immut_struct {
            let mut mk = 0
            while mk < n_fields {
              if sinfo.field_muts[mk] || !overridden[mk] {
                all_immut_struct = false
                break
              }
              mk = mk + 1
            }
          }
          let mut all_obj_fields_static_null = all_immut_struct
          if all_obj_fields_static_null {
            let mut fk = 0
            while fk < n_fields {
              let concrete_fk = subst_ty(
                subst_ty(sinfo.field_tys[fk], subst),
                g.cur_type_subst,
              )
              let needs_drop_fk = qbe_is_obj_ty(g, concrete_fk) ||
                qbe_is_obj_ty(g, slot_tys[fk]) ||
                match concrete_fk {
                  TParam(tn) => qbe_tp_live(g, tn)
                  _ =>
                    match slot_tys[fk] {
                      TParam(tn) => qbe_tp_live(g, tn)
                      _ => false
                    }
                }
              if needs_drop_fk {
                let mut is_null_lit = false
                let mut ffi = 0
                while ffi < fields.length() {
                  if fields[ffi].name == sinfo.field_names[fk] {
                    // Only `Option`'s own `None` is the static null pointer:
                    // a local / parameter / const / fn named `None` or another
                    // enum's `X::None` is a live value that needs its drop.
                    let is_opt_field = match concrete_fk {
                      TOption(_) => true
                      _ =>
                        match slot_tys[fk] {
                          TOption(_) => true
                          _ => false
                        }
                    }
                    is_null_lit = match fields[ffi].value {
                      EIdent(idn, _) => is_opt_field && qbe_ident_is_option_none(g, idn)
                      EPath(q, mem, _) => is_opt_field && q == "Option" && mem == "None"
                      // `()` into an RC field (e.g. `dyn Trait` with
                      // `impl Trait for Unit`) is boxed on the heap.
                      _ => false
                    }
                    break
                  }
                  ffi = ffi + 1
                }
                if !is_null_lit {
                  all_obj_fields_static_null = false
                  break
                }
              }
              fk = fk + 1
            }
          }
          let drop_sym = if all_obj_fields_static_null {
            "0"
          } else if sinfo.decl.type_params.length() == 0 {
            // Non-generic structs share the canonical per-unit
            // `$pion_drop_slots_<key>` helper keyed by their RC slot set
            // (`SPEC.md` §6 drop functions): structs with the same object
            // slots reuse one body, and no per-type export exists.
            let obj_slots : Array[Int] = []
            let mut k = 0
            while k < sinfo.field_tys.length() {
              if qbe_is_obj_ty(g, sinfo.field_tys[k]) {
                obj_slots.push(k)
              }
              k = k + 1
            }
            qbe_register_slot_drop(g, obj_slots)
          } else {
            let obj_slots : Array[Int] = []
            let tp_names : Array[String] = []
            let tp_slots : Array[Array[Int]] = []
            let mut k = 0
            while k < n_fields {
              let concrete_ty = subst_ty(
                subst_ty(sinfo.field_tys[k], subst),
                g.cur_type_subst,
              )
              if qbe_is_obj_ty(g, concrete_ty) || qbe_is_obj_ty(g, slot_tys[k]) {
                obj_slots.push(k)
              } else {
                match concrete_ty {
                  TParam(tn) =>
                    if qbe_tp_live(g, tn) {
                      qbe_add_tp_drop_slot(tp_names, tp_slots, tn, k)
                    }
                  _ =>
                    match slot_tys[k] {
                      TParam(tn) =>
                        if qbe_tp_live(g, tn) {
                          qbe_add_tp_drop_slot(tp_names, tp_slots, tn, k)
                        }
                      _ => ()
                    }
                }
              }
              k = k + 1
            }
            qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
          }
          let obj = qbe_tmp(g)
          let alloc_fn = if n_fields > 0 { "$pion_alloc_uninit" } else { "$pion_alloc" }
          qbe_emit(
            g,
            obj +
            " =l call " +
            alloc_fn +
            "(w " +
            payload_sz.to_string() +
            ", w 4, l " +
            drop_sym +
            ")",
          )
          let mut k = 0
          while k < n_fields {
            let p = qbe_tmp(g)
            qbe_emit(g, p + " =l add " + obj + ", " + (k * 8).to_string())
            let concrete_ty = subst_ty(
              subst_ty(sinfo.field_tys[k], subst),
              g.cur_type_subst,
            )
            let store_ty = if ty_has_unresolved(concrete_ty) {
              slot_tys[k]
            } else {
              concrete_ty
            }
            let coerced = qbe_coerce_val(g, qval(slot_vals[k], slot_tys[k]), store_ty)
            qbe_store_heap_slot(g, coerced, p, store_ty)
            k = k + 1
          }
          let targs : Array[Ty] = []
          let mut ti = 0
          while ti < sinfo.decl.type_params.length() {
            match subst.get(sinfo.decl.type_params[ti]) {
              Some(t) => targs.push(t)
              None => targs.push(TError)
            }
            ti = ti + 1
          }
          qval(obj, TStruct(resolved_name, targs))
        }
      }
    }
    ETuple(elems, _) => {
      let exp_elems : Array[Ty] = match expected {
        Some(TTuple(etys)) => etys
        _ => []
      }
      let vals : Array[String] = []
      let tys : Array[Ty] = []
      let obj_slots : Array[Int] = []
      let tp_names : Array[String] = []
      let tp_slots : Array[Array[Int]] = []
      let tup_guards = qbe_arg_guards_in_order(g, elems)
      let mut i = 0
      while i < elems.length() {
        let elem_exp : Option[Ty] = if i < exp_elems.length() {
          Some(exp_elems[i])
        } else {
          None
        }
        let ev = qbe_emit_expr(g, elems[i], elem_exp)
        // An expected slot that is unresolved or still names an unbound type
        // parameter (e.g. a generic callee's `K` leaking through an argument
        // expectation) must not override a concrete element type: doing so
        // makes `[(1, 10)]` an `Array[(K, V)]` and defeats monomorphization.
        let ev_concrete = !ty_has_unresolved(ev.ty) && !qbe_ty_has_param(ev.ty)
        let use_exp = i < exp_elems.length() &&
          !ty_has_unresolved(exp_elems[i]) &&
          !(ev_concrete && qbe_ty_has_param(subst_ty(exp_elems[i], g.cur_type_subst)))
        let slot_ty = if use_exp { exp_elems[i] } else { ev.ty }
        let coerced = qbe_coerce_val(g, ev, slot_ty)
        vals.push(coerced)
        tys.push(slot_ty)
        qbe_guard_val(g, tup_guards, QbeArgVal::{ qv: qval(coerced, slot_ty), borrowed: false }, false, tup_guards.exits[i])
        if qbe_is_obj_ty(g, slot_ty) {
          obj_slots.push(i)
        } else {
          match slot_ty {
            TParam(tn) =>
              if qbe_tp_live(g, tn) {
                qbe_add_tp_drop_slot(tp_names, tp_slots, tn, i)
              }
            _ => ()
          }
        }
        i = i + 1
      }
      qbe_release_guards(g, tup_guards)
      if g.block_term {
        return qval("0", TUnit)
      }
      let sz = if elems.length() == 0 { 8 } else { elems.length() * 8 }
      let drop_sym = qbe_emit_dynamic_slot_drop(g, obj_slots, tp_names, tp_slots)
      let obj = qbe_tmp(g)
      let alloc_fn = if elems.length() > 0 {
        "$pion_alloc_uninit"
      } else {
        "$pion_alloc"
      }
      if destructure && obj_slots.length() == 0 && tp_names.length() == 0 {
        // The only consumer loads scalar fields immediately. No header is observed.
        g.fn_allocs.write_string("    " + obj + " =l alloc8 " + sz.to_string() + "\n")
        g.immortal_regs.set(obj, true)
      } else {
        qbe_emit(
          g,
          obj +
          " =l call " +
          alloc_fn +
          "(w " +
          sz.to_string() +
          ", w 4, l " +
          drop_sym +
          ")",
        )
      }
      i = 0
      while i < vals.length() {
        let p = qbe_tmp(g)
        qbe_emit(g, p + " =l add " + obj + ", " + (i * 8).to_string())
        qbe_store_heap_slot(g, vals[i], p, tys[i])
        i = i + 1
      }
      qval(obj, TTuple(tys))
    }
    EBlock(stmts, _) => {
      qbe_scope_push(g)
      let r = qbe_emit_stmts(g, stmts, expected)
      qbe_scope_pop(g)
      r
    }
    EIf(cond, then_stmts, else_opt, sp) => {
      match qbe_contains_plan(g, cond, then_stmts, else_opt) {
        Some(p) => return qbe_emit_whole_entry(g, p, EIdent(p.key_name, sp))
        None => ()
      }
      match qbe_try_collect_if_switch(g, cond, then_stmts, else_opt) {
        Some(plan) =>
          match qbe_lookup_local(g, plan.vname) {
            Some(vloc) => {
              let vreg = qbe_load_local_slot(g, vloc.slot, TInt)
              return qbe_emit_int_dispatch(
                g,
                vreg,
                plan.arms,
                plan.default_opt,
                "",
                false,
                sp,
                expected,
                false,
              )
            }
            None => ()
          }
        None => ()
      }
      let l_then = qbe_lbl(g, "if_t")
      let l_else = qbe_lbl(g, "if_f")
      let l_end = qbe_lbl(g, "if_e")
      let has_is = qbe_expr_has_is(cond)
      match else_opt {
        None => {
          if has_is {
            qbe_scope_push(g)
            qbe_emit_cond_branch_bind(g, cond, l_then, l_end, Some(then_stmts))
            qbe_emit_lbl(g, l_then)
          } else {
            qbe_emit_cond_branch(g, cond, l_then, l_end)
            qbe_emit_lbl(g, l_then)
            qbe_scope_push(g)
          }
          let pos_names_raw : Array[String] = []
          let pos_mins_raw : Array[Int] = []
          qbe_collect_pos_min_lens(g, cond, pos_names_raw, pos_mins_raw)
          let is_bound : Map[String, Bool] = Map([])
          let mut has_is_bound = false
          if has_is {
            let top_sc = g.scopes[g.scopes.length() - 1]
            let mut lbi = 0
            while lbi < top_sc.locals.length() {
              is_bound.set(top_sc.locals[lbi].name, true)
              has_is_bound = true
              lbi = lbi + 1
            }
          }
          let pos_names : Array[String] = []
          let pos_mins : Array[Int] = []
          let mut rpi = 0
          while rpi < pos_names_raw.length() {
            if !is_bound.contains(pos_names_raw[rpi]) {
              pos_names.push(pos_names_raw[rpi])
              pos_mins.push(pos_mins_raw[rpi])
            }
            rpi = rpi + 1
          }
          let saved_pos_vals : Array[Option[Int]] = []
          let mut pni = 0
          while pni < pos_names.length() {
            saved_pos_vals.push(g.known_min_len_arrs.get(pos_names[pni]))
            pni = pni + 1
          }
          qbe_apply_min_lens(g, cond, pos_names, pos_mins)
          let win_keys : Array[String] = []
          if !has_is_bound {
            qbe_collect_pos_window_bce(g, cond, then_stmts, win_keys)
          }
          let added_win : Array[String] = []
          let mut wki = 0
          while wki < win_keys.length() {
            let wk = win_keys[wki]
            if !g.bce_safe_exprs.contains(wk) {
              g.bce_safe_exprs.set(wk, true)
              added_win.push(wk)
            }
            wki = wki + 1
          }
          let if_dp_pinned : Array[String] = []
          if has_is {
            qbe_pin_top_scope_for_cond_stmts(g, cond, then_stmts, if_dp_pinned)
          }
          let tv = qbe_emit_stmts(g, then_stmts, None)
          qbe_unpin_slot_list(g, if_dp_pinned)
          let then_term = g.block_term
          wki = 0
          while wki < added_win.length() {
            g.bce_safe_exprs.remove(added_win[wki])
            wki = wki + 1
          }
          pni = pos_names.length() - 1
          while pni >= 0 {
            let nm = pos_names[pni]
            if then_term || g.known_min_len_arrs.contains(nm) {
              match saved_pos_vals[pni] {
                Some(old_v) => g.known_min_len_arrs.set(nm, old_v)
                None => g.known_min_len_arrs.remove(nm)
              }
            }
            pni = pni - 1
          }
          if !then_term {
            qbe_rc_dec(g, tv.reg, tv.ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
          if then_term {
            let neg_names : Array[String] = []
            let neg_mins : Array[Int] = []
            qbe_collect_neg_min_lens(g, cond, neg_names, neg_mins)
            qbe_apply_min_lens(g, cond, neg_names, neg_mins)
          }
          qval("0", TUnit)
        }
        Some(el) => {
          let mut branch_exp : Option[Ty] = expected
          let need_probe = match branch_exp {
            Some(et) => ty_has_unresolved(et)
            None => true
          }
          if need_probe {
            let then_hints = qbe_hints_new()
            qbe_probe_bind_cond_hints(g, cond, then_hints)
            match qbe_probe_stmts_ty_with(g, then_stmts, then_hints) {
              Some(pt) =>
                branch_exp = match branch_exp {
                  Some(cur) => Some(ty_prefer_concrete(cur, pt))
                  None => Some(pt)
                }
              None => ()
            }
            let still_need = match branch_exp {
              Some(et) => ty_has_unresolved(et)
              None => true
            }
            if still_need {
              match qbe_probe_expr_ty(g, el) {
                Some(pe) =>
                  branch_exp = match branch_exp {
                    Some(cur) => Some(ty_prefer_concrete(cur, pe))
                    None => Some(pe)
                  }
                None => ()
              }
            }
          }
          if has_is {
            qbe_scope_push(g)
            qbe_emit_cond_branch_bind(g, cond, l_then, l_else, Some(then_stmts))
            qbe_emit_lbl(g, l_then)
          } else {
            qbe_emit_cond_branch(g, cond, l_then, l_else)
            qbe_emit_lbl(g, l_then)
            qbe_scope_push(g)
          }
          let pos_names_raw : Array[String] = []
          let pos_mins_raw : Array[Int] = []
          qbe_collect_pos_min_lens(g, cond, pos_names_raw, pos_mins_raw)
          let is_bound : Map[String, Bool] = Map([])
          let mut has_is_bound = false
          if has_is {
            let top_sc = g.scopes[g.scopes.length() - 1]
            let mut lbi = 0
            while lbi < top_sc.locals.length() {
              is_bound.set(top_sc.locals[lbi].name, true)
              has_is_bound = true
              lbi = lbi + 1
            }
          }
          let pos_names : Array[String] = []
          let pos_mins : Array[Int] = []
          let mut rpi = 0
          while rpi < pos_names_raw.length() {
            if !is_bound.contains(pos_names_raw[rpi]) {
              pos_names.push(pos_names_raw[rpi])
              pos_mins.push(pos_mins_raw[rpi])
            }
            rpi = rpi + 1
          }
          let saved_pos_vals : Array[Option[Int]] = []
          let mut pni = 0
          while pni < pos_names.length() {
            saved_pos_vals.push(g.known_min_len_arrs.get(pos_names[pni]))
            pni = pni + 1
          }
          qbe_apply_min_lens(g, cond, pos_names, pos_mins)
          let win_keys : Array[String] = []
          if !has_is_bound {
            qbe_collect_pos_window_bce(g, cond, then_stmts, win_keys)
          }
          let added_win : Array[String] = []
          let mut wki = 0
          while wki < win_keys.length() {
            let wk = win_keys[wki]
            if !g.bce_safe_exprs.contains(wk) {
              g.bce_safe_exprs.set(wk, true)
              added_win.push(wk)
            }
            wki = wki + 1
          }
          let if_dp_pinned : Array[String] = []
          if has_is {
            qbe_pin_top_scope_for_cond_stmts(g, cond, then_stmts, if_dp_pinned)
          }
          let tv = qbe_emit_stmts(g, then_stmts, branch_exp)
          qbe_unpin_slot_list(g, if_dp_pinned)
          let then_term = g.block_term
          wki = 0
          while wki < added_win.length() {
            g.bce_safe_exprs.remove(added_win[wki])
            wki = wki + 1
          }
          let then_dropped : Array[Bool] = []
          pni = 0
          while pni < pos_names.length() {
            then_dropped.push(!then_term && !g.known_min_len_arrs.contains(pos_names[pni]))
            pni = pni + 1
          }
          pni = pos_names.length() - 1
          while pni >= 0 {
            match saved_pos_vals[pni] {
              Some(old_v) => g.known_min_len_arrs.set(pos_names[pni], old_v)
              None => g.known_min_len_arrs.remove(pos_names[pni])
            }
            pni = pni - 1
          }
          let then_ty = match branch_exp {
            Some(et) => ty_prefer_concrete(et, tv.ty)
            None => tv.ty
          }
          let mut saw_untyped_none = !then_term && qbe_ty_has_untyped_option(then_ty)
          let mut res_slot = ""
          let then_is_unit = match then_ty {
            TUnit => true
            _ => false
          }
          if !then_term && !then_is_unit {
            res_slot = qbe_alloc_slot_for(g, then_ty)
            qbe_store_local_slot(g, qbe_coerce_val(g, tv, then_ty), res_slot, then_ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_else)
          qbe_scope_push(g)
          let else_exp : Option[Ty] = match branch_exp {
            Some(et) =>
              if !then_term {
                Some(ty_prefer_concrete(et, tv.ty))
              } else {
                branch_exp
              }
            None =>
              if !then_term && !saw_untyped_none && !ty_has_unresolved(tv.ty) {
                match tv.ty {
                  TNever => None
                  _ => Some(tv.ty)
                }
              } else {
                None
              }
          }
          let ev = qbe_emit_expr(g, el, else_exp)
          let else_term = g.block_term
          if !else_term && qbe_ty_has_untyped_option(ev.ty) {
            saw_untyped_none = true
          }
          let out_ty = if then_term {
            match branch_exp {
              Some(et) => ty_prefer_concrete(et, ev.ty)
              None => ev.ty
            }
          } else if else_term {
            match branch_exp {
              Some(et) => ty_prefer_concrete(et, tv.ty)
              None => tv.ty
            }
          } else {
            let merged = ty_prefer_concrete(tv.ty, ev.ty)
            match branch_exp {
              Some(et) => ty_prefer_concrete(et, merged)
              None => merged
            }
          }
          let out_is_unit = match out_ty {
            TUnit => true
            _ => false
          }
          if !else_term && !out_is_unit {
            if res_slot == "" {
              res_slot = qbe_alloc_slot_for(g, out_ty)
            }
            qbe_store_local_slot(g, qbe_coerce_val(g, ev, out_ty), res_slot, out_ty)
          }
          qbe_scope_pop(g)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
          pni = 0
          while pni < pos_names.length() {
            if then_dropped[pni] {
              g.known_min_len_arrs.remove(pos_names[pni])
            }
            pni = pni + 1
          }
          if then_term && else_term {
            qval("0", TNever)
          } else if res_slot == "" {
            qval(qbe_zero_reg(out_ty), out_ty)
          } else {
            let mut r = qbe_load_local_slot(g, res_slot, out_ty)
            if saw_untyped_none {
              r = qbe_normalize_untyped_none_in_val(g, r, out_ty)
            }
            qval(r, out_ty)
          }
        }
      }
    }
    EIs(scrut, pat, _) => {
      match qbe_try_emit_scalar_is_expr(g, scrut, pat) {
        Some(qv) => return qv
        None => ()
      }
      let sv = qbe_emit_expr(g, scrut, None)
      let res_slot = qbe_alloc_slot(g)
      let l_fail = qbe_lbl(g, "isv_f")
      let l_end = qbe_lbl(g, "isv_e")
      qbe_emit_pat_test(g, pat, sv.reg, sv.ty, l_fail)
      qbe_emit(g, "storel 1, " + res_slot)
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_fail)
      qbe_emit(g, "storel 0, " + res_slot)
      qbe_rc_dec(g, sv.reg, sv.ty)
      qbe_emit_term(g, "jmp " + l_end)
      qbe_emit_lbl(g, l_end)
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =l loadl " + res_slot)
      qval(r, TBool)
    }
    EMatch(scrut, arms, sp) => {
      match qbe_try_emit_map_get_match(g, scrut, arms, expected) {
        Some(qv) => return qv
        None => ()
      }
      match qbe_try_emit_scalar_opt_res_match(g, scrut, arms, expected) {
        Some(qv) => return qv
        None => ()
      }
      // Scalarized tuple-literal match: `match (e1, e2, ...) { (p1, p2, ...) => ..., _ => ... }`
      // Zero heap tuple allocation and zero tuple RC overhead.
      match scrut {
        ETuple(elems, _) => {
          let mut can_scalarize = elems.length() >= 1
          let mut ai = 0
          while ai < arms.length() && can_scalarize {
            match arms[ai].pat {
              PWild(_) => ()
              PTuple(subs, _) =>
                if subs.length() != elems.length() {
                  can_scalarize = false
                }
              _ => can_scalarize = false
            }
            ai = ai + 1
          }
          if can_scalarize {
            qbe_scope_push(g)
            let elem_slots : Array[String] = []
            let elem_tys : Array[Ty] = []
            let elem_borrowed : Array[Bool] = []
            let mut ei = 0
            while ei < elems.length() {
              let mut e_borrowed = false
              let mut ev = qval("0", TError)
              match elems[ei] {
                EIdent(xname, _) =>
                  match qbe_lookup_local(g, xname) {
                    Some(loc) =>
                      if !loc.is_cell {
                      let mut reassigned = false
                      let mut ej = ei + 1
                      while ej < elems.length() {
                        if qbe_expr_assigns_ident(elems[ej], xname) {
                          reassigned = true
                          break
                        }
                        ej = ej + 1
                      }
                      if !reassigned {
                        ai = 0
                        while ai < arms.length() {
                          match arms[ai].guard_expr {
                            Some(ge) =>
                              if qbe_expr_assigns_ident(ge, xname) {
                                reassigned = true
                                break
                              }
                            None => ()
                          }
                          if qbe_expr_assigns_ident(arms[ai].body, xname) {
                            reassigned = true
                            break
                          }
                          ai = ai + 1
                        }
                      }
                      if !reassigned {
                        let r = qbe_load_local_slot(g, loc.slot, loc.ty)
                        ev = qval(r, loc.ty)
                        e_borrowed = true
                      }
                    }
                    None => ()
                  }
                EField(EIdent(xname, _), fname, _) =>
                  match qbe_lookup_local(g, xname) {
                    Some(loc) =>
                      if !loc.is_cell && loc.ref_slot == "" {
                        match loc.ty {
                          TStruct(sname, sargs) =>
                            match qbe_lookup_struct_info(g, sname) {
                              Some(sinfo) => {
                                let mut fi = 0
                                let mut found_immut = -1
                                while fi < sinfo.field_names.length() {
                                  if sinfo.field_names[fi] == fname {
                                    if !sinfo.field_muts[fi] {
                                      found_immut = fi
                                    }
                                    break
                                  }
                                  fi = fi + 1
                                }
                                if found_immut >= 0 {
                                  let mut reassigned = false
                                  let mut ej = ei + 1
                                  while ej < elems.length() {
                                    if qbe_expr_assigns_ident(elems[ej], xname) {
                                      reassigned = true
                                      break
                                    }
                                    ej = ej + 1
                                  }
                                  if !reassigned {
                                    ai = 0
                                    while ai < arms.length() {
                                      match arms[ai].guard_expr {
                                        Some(ge) =>
                                          if qbe_expr_assigns_ident(ge, xname) {
                                            reassigned = true
                                            break
                                          }
                                        None => ()
                                      }
                                      if qbe_expr_assigns_ident(arms[ai].body, xname) {
                                        reassigned = true
                                        break
                                      }
                                      ai = ai + 1
                                    }
                                  }
                                  if !reassigned {
                                    let fkey = xname + "." + fname
                                    match g.hoisted_fields.get(fkey) {
                                      Some(hv) => {
                                        ev = hv
                                        e_borrowed = true
                                      }
                                      None =>
                                        match g.block_immut_fields.get(fkey) {
                                          Some(bv) => {
                                            ev = bv
                                            e_borrowed = true
                                          }
                                          None => {
                                            let subst = make_subst(
                                              sinfo.decl.type_params,
                                              sargs,
                                            )
                                            let fty = subst_ty(
                                              sinfo.field_tys[found_immut],
                                              subst,
                                            )
                                            let obj_p = qbe_tmp(g)
                                            let fp = qbe_tmp(g)
                                            qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                            qbe_emit(
                                              g,
                                              fp + " =l add " + obj_p + ", " + (found_immut * 8).to_string(),
                                            )
                                            let fv = qbe_load_heap_slot(g, fp, fty)
                                            ev = qval(fv, fty)
                                            e_borrowed = true
                                          }
                                        }
                                    }
                                  }
                                }
                              }
                              None => ()
                            }
                          _ => ()
                        }
                      }
                    None => ()
                  }
                _ => ()
              }
              if !e_borrowed {
                ev = qbe_emit_expr(g, elems[ei], None)
              }
              let eloc = qbe_define_local(
                g,
                "__match_tup_" + ei.to_string(),
                ev.ty,
                !e_borrowed,
              )
              qbe_store_local_slot(g, ev.reg, eloc.slot, ev.ty)
              elem_slots.push(eloc.slot)
              elem_tys.push(ev.ty)
              elem_borrowed.push(e_borrowed)
              ei = ei + 1
            }
            let tup_scrut_ty = TTuple(elem_tys)
            let mut res_slot = ""
            let l_end = qbe_lbl(g, "match_end")
            let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
              g,
              arms,
              Some(tup_scrut_ty),
              expected,
            )
            let mut saw_untyped_none = false
            let mut i = 0
            while i < arms.length() {
              let mut grp_end = i + 1
              while grp_end < arms.length() && qbe_arm_can_share(arms[i], arms[grp_end]) {
                grp_end = grp_end + 1
              }
              let arm = arms[i]
              let l_next = qbe_lbl(g, "match_next")
              if grp_end > i + 1 {
                let l_body = qbe_lbl(g, "match_arm")
                let mut gi = i
                while gi < grp_end {
                  let fail_lbl = if gi + 1 < grp_end {
                    qbe_lbl(g, "match_next")
                  } else {
                    l_next
                  }
                  match arms[gi].pat {
                    PTuple(subs, _) => {
                      let mut k = 0
                      while k < subs.length() && k < elem_tys.length() {
                        let cur_ek = qbe_load_local_slot(g, elem_slots[k], elem_tys[k])
                        qbe_emit_pat_test(g, subs[k], cur_ek, elem_tys[k], fail_lbl)
                        k = k + 1
                      }
                    }
                    _ => ()
                  }
                  qbe_emit_term(g, "jmp " + l_body)
                  if gi + 1 < grp_end {
                    qbe_emit_lbl(g, fail_lbl)
                  }
                  gi = gi + 1
                }
                qbe_emit_lbl(g, l_body)
              } else {
                match arm.pat {
                  PTuple(subs, _) => {
                    let mut k = 0
                    while k < subs.length() && k < elem_tys.length() {
                      let cur_ek = qbe_load_local_slot(g, elem_slots[k], elem_tys[k])
                      qbe_emit_pat_test(g, subs[k], cur_ek, elem_tys[k], l_next)
                      k = k + 1
                    }
                  }
                  _ => ()
                }
              }
              qbe_scope_push(g)
              let has_guard = match arm.guard_expr {
                Some(_) => true
                None => false
              }
              if grp_end == i + 1 {
                match arm.pat {
                  PTuple(subs, _) => {
                    let mut k = 0
                    while k < subs.length() && k < elem_tys.length() {
                      let bind_ek = qbe_load_local_slot(g, elem_slots[k], elem_tys[k])
                      let ek_borrow = !has_guard && elem_borrowed[k]
                      qbe_emit_pat_bind(g, subs[k], bind_ek, elem_tys[k], ek_borrow, arm.body)
                      k = k + 1
                    }
                  }
                  _ => ()
                }
              }
              let tarm_dp_pinned : Array[String] = []
              qbe_pin_top_scope_for_arm(g, arm.guard_expr, arm.body, tarm_dp_pinned)
              match arm.guard_expr {
                Some(ge) => {
                  let l_body = qbe_lbl(g, "match_guard_ok")
                  let l_gfail = qbe_lbl(g, "match_guard_fail")
                  let before_guard = g.scopes[g.scopes.length() - 1].locals.length()
                  if qbe_expr_has_is(ge) {
                    qbe_emit_cond_branch_bind(g, ge, l_body, l_gfail, None)
                  } else {
                    qbe_emit_cond_branch(g, ge, l_body, l_gfail)
                  }
                  qbe_emit_lbl(g, l_gfail)
                  qbe_release_scope_locals_range(g, 0, before_guard)
                  qbe_emit_term(g, "jmp " + l_next)
                  qbe_emit_lbl(g, l_body)
                }
                None => ()
              }
              let bv = qbe_emit_expr(g, arm.body, res_ty)
              qbe_unpin_slot_list(g, tarm_dp_pinned)
              match res_ty {
                None =>
                  match bv.ty {
                    TNever => ()
                    _ => {
                      if qbe_ty_has_untyped_option(bv.ty) {
                        saw_untyped_none = true
                      }
                      res_ty = Some(bv.ty)
                    }
                  }
                Some(rt) => {
                  if qbe_ty_has_untyped_option(bv.ty) {
                    saw_untyped_none = true
                  }
                  res_ty = Some(ty_prefer_concrete(rt, bv.ty))
                }
              }
              if !g.block_term {
                let store_ty = match res_ty {
                  Some(t) => t
                  None => bv.ty
                }
                match store_ty {
                  TUnit => ()
                  _ => {
                    if res_slot == "" {
                      res_slot = qbe_alloc_slot_for(g, store_ty)
                    }
                    qbe_store_local_slot(g, qbe_coerce_val(g, bv, store_ty), res_slot, store_ty)
                  }
                }
              }
              qbe_scope_pop(g)
              qbe_emit_term(g, "jmp " + l_end)
              qbe_emit_lbl(g, l_next)
              i = grp_end
            }
            let file_id = qbe_intern_source_path(g, sp.file)
            let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
            qbe_emit(
              g,
              "call $pion_panic(l $pion_cstr_" +
              msg_id.to_string() +
              ", l $pion_cstr_" +
              file_id.to_string() +
              ", w " +
              sp.line.to_string() +
              ")",
            )
            qbe_emit_term(g, "jmp " + l_end)
            qbe_emit_lbl(g, l_end)
            qbe_scope_pop(g)
            let final_ty = match res_ty {
              Some(t) => t
              None => TUnit
            }
            if res_slot == "" {
              return qval(qbe_zero_reg(final_ty), final_ty)
            } else {
              let mut r = qbe_load_local_slot(g, res_slot, final_ty)
              if saw_untyped_none {
                r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
              }
              return qval(r, final_ty)
            }
          }
        }
        _ => ()
      }
      // Dense guardless Int match -> balanced binary dispatch tree
      if arms.length() >= 6 {
        let mut is_int_scrut = false
        let mut scrut_slot_opt : Option[String] = None
        match scrut {
          EIdent(xname, _) =>
            match qbe_lookup_local(g, xname) {
              Some(loc) =>
                if !loc.is_cell {
                  match loc.ty {
                    TInt => {
                      is_int_scrut = true
                      scrut_slot_opt = Some(loc.slot)
                    }
                    _ => ()
                  }
                }
              None => ()
            }
          _ => ()
        }
        if is_int_scrut {
          let sw_arms : Array[QbeSwitchArm] = []
          let seen_vals : Map[String, Bool] = Map([])
          let mut def_expr : Option[Expr] = None
          let mut def_bind = ""
          let mut ok_dispatch = true
          let mut ai = 0
          while ai < arms.length() {
            let arm = arms[ai]
            match arm.guard_expr {
              Some(_) => {
                ok_dispatch = false
                break
              }
              None => ()
            }
            match arm.pat {
              PInt(raw, _) => {
                let cv = qbe_parse_int64_lit(raw).to_int()
                let ck = cv.to_string()
                if seen_vals.contains(ck) {
                  ok_dispatch = false
                  break
                }
                seen_vals.set(ck, true)
                sw_arms.push(
                  QbeSwitchArm::{ cval: cv, stmts: [], expr_opt: Some(arm.body) },
                )
              }
              PWild(_) =>
                if ai == arms.length() - 1 {
                  def_expr = Some(arm.body)
                } else {
                  ok_dispatch = false
                  break
                }
              PIdent(bname, _) =>
                if ai == arms.length() - 1 {
                  def_expr = Some(arm.body)
                  def_bind = bname
                } else {
                  ok_dispatch = false
                  break
                }
              _ => {
                ok_dispatch = false
                break
              }
            }
            ai = ai + 1
          }
          if ok_dispatch && sw_arms.length() >= 6 {
            match scrut_slot_opt {
              Some(sslot) => {
                qbe_sort_switch_arms(sw_arms)
                let vreg = qbe_load_local_slot(g, sslot, TInt)
                let is_no_def = match def_expr {
                  None => true
                  Some(_) => false
                }
                return qbe_emit_int_dispatch(
                  g,
                  vreg,
                  sw_arms,
                  def_expr,
                  def_bind,
                  is_no_def,
                  sp,
                  expected,
                  false,
                )
              }
              None => ()
            }
          }
        }
      }
      qbe_scope_push(g)
      let mut scrut_borrowed = false
      let mut sv = qval("0", TError)
      match scrut {
        EIdent(xname, _) =>
          match qbe_lookup_local(g, xname) {
            Some(loc) =>
              if !loc.is_cell {
              let mut reassigned = false
              let mut ai = 0
              while ai < arms.length() {
                match arms[ai].guard_expr {
                  Some(ge) =>
                    if qbe_expr_assigns_ident(ge, xname) {
                      reassigned = true
                      break
                    }
                  None => ()
                }
                if qbe_expr_assigns_ident(arms[ai].body, xname) {
                  reassigned = true
                  break
                }
                ai = ai + 1
              }
              if !reassigned {
                let r = qbe_load_local_slot(g, loc.slot, loc.ty)
                sv = qval(r, loc.ty)
                scrut_borrowed = true
              }
            }
            None => ()
          }
        EField(EIdent(xname, _), fname, _) =>
          match qbe_lookup_local(g, xname) {
            Some(loc) =>
              if !loc.is_cell && loc.ref_slot == "" {
                match loc.ty {
                  TStruct(sname, sargs) =>
                    match qbe_lookup_struct_info(g, sname) {
                      Some(sinfo) => {
                        let mut fi = 0
                        let mut found_immut = -1
                        while fi < sinfo.field_names.length() {
                          if sinfo.field_names[fi] == fname {
                            if !sinfo.field_muts[fi] {
                              found_immut = fi
                            }
                            break
                          }
                          fi = fi + 1
                        }
                        if found_immut >= 0 {
                          let mut reassigned = false
                          let mut ai = 0
                          while ai < arms.length() {
                            match arms[ai].guard_expr {
                              Some(ge) =>
                                if qbe_expr_assigns_ident(ge, xname) {
                                  reassigned = true
                                  break
                                }
                              None => ()
                            }
                            if qbe_expr_assigns_ident(arms[ai].body, xname) {
                              reassigned = true
                              break
                            }
                            ai = ai + 1
                          }
                          if !reassigned {
                            let fkey = xname + "." + fname
                            match g.hoisted_fields.get(fkey) {
                              Some(hv) => {
                                sv = hv
                                scrut_borrowed = true
                              }
                              None =>
                                match g.block_immut_fields.get(fkey) {
                                  Some(bv) => {
                                    sv = bv
                                    scrut_borrowed = true
                                  }
                                  None => {
                                    let subst = make_subst(
                                      sinfo.decl.type_params,
                                      sargs,
                                    )
                                    let fty = subst_ty(
                                      sinfo.field_tys[found_immut],
                                      subst,
                                    )
                                    let obj_p = qbe_tmp(g)
                                    let fp = qbe_tmp(g)
                                    qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                    qbe_emit(
                                      g,
                                      fp + " =l add " + obj_p + ", " + (found_immut * 8).to_string(),
                                    )
                                    let fv = qbe_load_heap_slot(g, fp, fty)
                                    sv = qval(fv, fty)
                                    scrut_borrowed = true
                                  }
                                }
                            }
                          }
                        }
                      }
                      None => ()
                    }
                  _ => ()
                }
              }
            None => ()
          }
        EIndex(EIdent(aname, _), idx_expr, _) =>
          if !qbe_expr_has_assign(idx_expr) {
            match qbe_lookup_local(g, aname) {
              Some(aloc) =>
                if !aloc.is_cell && aloc.ref_slot == "" {
                  match aloc.ty {
                    TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                      let is_dyn = match elem {
                        TDynTrait(_) => true
                        _ => false
                      }
                      if qbe_is_obj_ty(g, elem) &&
                        qbe_flat_pod_stride(g, elem) == 0 &&
                        !is_dyn &&
                        qbe_arr_is_stable_expr(idx_expr, aname, false) &&
                        qbe_match_arr_alias_safe_expr(
                          g,
                          idx_expr,
                          elem,
                          qbe_hints_new(),
                          aloc.owned,
                        ) {
                        let mut ok = true
                        let mut ai = 0
                        while ai < arms.length() {
                          match arms[ai].guard_expr {
                            Some(ge) =>
                              if !qbe_arr_is_stable_expr(ge, aname, false) {
                                ok = false
                                break
                              }
                            None => ()
                          }
                          if !qbe_arr_is_stable_expr(arms[ai].body, aname, false) {
                            ok = false
                            break
                          }
                          let arm_hints = qbe_hints_new()
                          qbe_bind_pat_probe_hints(g, arms[ai].pat, Some(elem), arm_hints)
                          match arms[ai].guard_expr {
                            Some(ge) =>
                              if !qbe_match_arr_alias_safe_expr(
                                g,
                                ge,
                                elem,
                                arm_hints,
                                aloc.owned,
                              ) {
                                ok = false
                                break
                              }
                            None => ()
                          }
                          if !qbe_match_arr_alias_safe_expr(
                            g,
                            arms[ai].body,
                            elem,
                            arm_hints,
                            aloc.owned,
                          ) {
                            ok = false
                            break
                          }
                          ai = ai + 1
                        }
                        if ok {
                          let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
                          let il = qbe_as_l(g, iv)
                          let arr_reg = if g.hoisted_arr_len.contains(aname) &&
                            g.hoisted_arr_dp.contains(aname) {
                            "0"
                          } else {
                            let r = qbe_tmp(g)
                            qbe_emit(g, r + " =l loadl " + aloc.slot)
                            r
                          }
                          let bce_safe = qbe_bce_expr_is_safe(g, aname, idx_expr)
                          if !bce_safe {
                            let alen = match g.hoisted_arr_len.get(aname) {
                              Some(hlen) => hlen
                              None => {
                                let t = qbe_tmp(g)
                                qbe_emit(g, t + " =l loadl " + arr_reg)
                                t
                              }
                            }
                            let oob = qbe_tmp(g)
                            let l_oob = qbe_lbl(g, "arr_oob")
                            let l_ok = qbe_lbl(g, "arr_ok")
                            qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                            qbe_emit_lbl(g, l_oob)
                            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                            qbe_emit_term(g, "hlt")
                            qbe_emit_lbl(g, l_ok)
                          }
                          let dp = match g.hoisted_arr_dp.get(aname) {
                            Some(hdp) => hdp
                            None => {
                              let dp_p = qbe_tmp(g)
                              let t = qbe_tmp(g)
                              qbe_emit(g, dp_p + " =l add " + arr_reg + ", 24")
                              qbe_emit(g, t + " =l loadl " + dp_p)
                              t
                            }
                          }
                          let off = qbe_tmp(g)
                          let ep = qbe_tmp(g)
                          qbe_emit(g, off + " =l shl " + il + ", 3")
                          qbe_emit(g, ep + " =l add " + dp + ", " + off)
                          let ev = qbe_load_heap_slot(g, ep, elem)
                          sv = qval(ev, elem)
                          scrut_borrowed = true
                        }
                      }
                    }
                    _ => ()
                  }
                }
              None => ()
            }
          }
        _ => ()
      }
      if !scrut_borrowed {
        sv = qbe_emit_expr(g, scrut, None)
      }
      let scrut_loc = qbe_define_local(g, "__match_scrut", sv.ty, !scrut_borrowed)
      qbe_store_local_slot(g, sv.reg, scrut_loc.slot, sv.ty)
      // Dense guardless single-layer TEnum match -> native QBE jtbl jump table
      if arms.length() >= 4 {
        match sv.ty {
          TEnum(ename, _) =>
            match qbe_lookup_enum_info(g, ename) {
              Some(einfo) => {
                let var_tags : Array[Int] = []
                let var_arm_idxs : Array[Int] = []
                let seen_tags : Map[String, Bool] = Map([])
                let mut def_arm_idx = -1
                let mut min_tag = 2147483647
                let mut max_tag = -1
                let mut ok_enum_jtbl = true
                let mut ai = 0
                while ai < arms.length() {
                  let arm = arms[ai]
                  match arm.guard_expr {
                    Some(_) => {
                      ok_enum_jtbl = false
                      break
                    }
                    None => ()
                  }
                  match arm.pat {
                    PVariant(pat_enum, vname, subs, explicit_ctor, psp) => {
                      match qbe_resolve_pat_const_sym(g, pat_enum, vname, subs, explicit_ctor, psp, sv.ty) {
                        Some(_) => {
                          ok_enum_jtbl = false
                          break
                        }
                        None => ()
                      }
                      let mut simple_subs = true
                      let mut si = 0
                      while si < subs.length() {
                        match subs[si] {
                          PWild(_) | PIdent(_, _) => ()
                          _ => {
                            simple_subs = false
                            break
                          }
                        }
                        si = si + 1
                      }
                      if !simple_subs {
                        ok_enum_jtbl = false
                        break
                      }
                      let mut found_tag = -1
                      let mut vi = 0
                      while vi < einfo.variants.length() {
                        if einfo.variants[vi].name == vname {
                          found_tag = vi
                          break
                        }
                        vi = vi + 1
                      }
                      if found_tag < 0 {
                        ok_enum_jtbl = false
                        break
                      }
                      let tk = found_tag.to_string()
                      if seen_tags.contains(tk) {
                        ok_enum_jtbl = false
                        break
                      }
                      seen_tags.set(tk, true)
                      var_tags.push(found_tag)
                      var_arm_idxs.push(ai)
                      if found_tag < min_tag {
                        min_tag = found_tag
                      }
                      if found_tag > max_tag {
                        max_tag = found_tag
                      }
                    }
                    PWild(_) | PIdent(_, _) =>
                      if ai == arms.length() - 1 {
                        def_arm_idx = ai
                      } else {
                        ok_enum_jtbl = false
                        break
                      }
                    _ => {
                      ok_enum_jtbl = false
                      break
                    }
                  }
                  ai = ai + 1
                }
                let span = max_tag - min_tag + 1
                if ok_enum_jtbl &&
                  var_tags.length() >= 4 &&
                  span >= 4 &&
                  span <= 256 &&
                  span <= var_tags.length() * 2 {
                  let arm_lbls : Array[String] = []
                  let arm_emit : Array[Bool] = []
                  let mut k = 0
                  while k < var_tags.length() {
                    if k > 0 &&
                      qbe_arm_can_share(
                        arms[var_arm_idxs[k - 1]],
                        arms[var_arm_idxs[k]],
                      ) {
                      arm_lbls.push(arm_lbls[k - 1])
                      arm_emit.push(false)
                    } else {
                      arm_lbls.push(qbe_lbl(g, "em_arm"))
                      arm_emit.push(true)
                    }
                    k = k + 1
                  }
                  let l_def = qbe_lbl(g, "em_def")
                  let l_end = qbe_lbl(g, "match_end")
                  let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                  let tag_l = qbe_tmp(g)
                  let tag_w = qbe_tmp(g)
                  if qbe_enum_layout(g, sv.ty).is_unit_only {
                    qbe_emit(g, tag_l + " =l sub " + cur_sv + ", 1")
                  } else {
                    qbe_emit(g, tag_l + " =l loadl " + cur_sv)
                  }
                  qbe_emit(g, tag_w + " =w copy " + tag_l)
                  let idx_w = if min_tag == 0 {
                    tag_w
                  } else {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =w sub " + tag_w + ", " + min_tag.to_string())
                    t
                  }
                  let tbl : Array[String] = []
                  k = 0
                  while k < span {
                    tbl.push(l_def)
                    k = k + 1
                  }
                  k = 0
                  while k < var_tags.length() {
                    tbl[var_tags[k] - min_tag] = arm_lbls[k]
                    k = k + 1
                  }
                  let sb = StringBuilder()
                  sb.write_string("jtbl ")
                  sb.write_string(idx_w)
                  sb.write_string(", ")
                  sb.write_string(l_def)
                  k = 0
                  while k < span {
                    sb.write_string(", ")
                    sb.write_string(tbl[k])
                    k = k + 1
                  }
                  qbe_emit_term(g, sb.to_string())
                  let mut res_slot = ""
                  let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
                    g,
                    arms,
                    Some(sv.ty),
                    expected,
                  )
                  let mut saw_untyped_none = false
                  k = 0
                  while k < var_tags.length() {
                    if !arm_emit[k] {
                      k = k + 1
                      continue
                    }
                    let arm = arms[var_arm_idxs[k]]
                    qbe_emit_lbl(g, arm_lbls[k])
                    qbe_scope_push(g)
                    if qbe_pat_has_binds(arm.pat) {
                      let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                      qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, true, arm.body)
                    }
                    let jtbl_dp_pinned : Array[String] = []
                    qbe_pin_top_scope_for_arm(g, None, arm.body, jtbl_dp_pinned)
                    let bv = qbe_emit_expr(g, arm.body, res_ty)
                    qbe_unpin_slot_list(g, jtbl_dp_pinned)
                    match res_ty {
                      None =>
                        match bv.ty {
                          TNever => ()
                          _ => {
                            if qbe_ty_has_untyped_option(bv.ty) {
                              saw_untyped_none = true
                            }
                            res_ty = Some(bv.ty)
                          }
                        }
                      Some(rt) => {
                        if qbe_ty_has_untyped_option(bv.ty) {
                          saw_untyped_none = true
                        }
                        res_ty = Some(ty_prefer_concrete(rt, bv.ty))
                      }
                    }
                    if !g.block_term {
                      let store_ty = match res_ty {
                        Some(t) => t
                        None => bv.ty
                      }
                      match store_ty {
                        TUnit => ()
                        _ => {
                          if res_slot == "" {
                            res_slot = qbe_alloc_slot_for(g, store_ty)
                          }
                          qbe_store_local_slot(
                            g,
                            qbe_coerce_val(g, bv, store_ty),
                            res_slot,
                            store_ty,
                          )
                        }
                      }
                    }
                    qbe_scope_pop(g)
                    qbe_emit_term(g, "jmp " + l_end)
                    k = k + 1
                  }
                  qbe_emit_lbl(g, l_def)
                  if def_arm_idx >= 0 {
                    let arm = arms[def_arm_idx]
                    qbe_scope_push(g)
                    if qbe_pat_has_binds(arm.pat) {
                      let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
                      qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, true, arm.body)
                    }
                    let jtbl_dp_pinned : Array[String] = []
                    qbe_pin_top_scope_for_arm(g, None, arm.body, jtbl_dp_pinned)
                    let bv = qbe_emit_expr(g, arm.body, res_ty)
                    qbe_unpin_slot_list(g, jtbl_dp_pinned)
                    match res_ty {
                      None =>
                        match bv.ty {
                          TNever => ()
                          _ => {
                            if qbe_ty_has_untyped_option(bv.ty) {
                              saw_untyped_none = true
                            }
                            res_ty = Some(bv.ty)
                          }
                        }
                      Some(rt) => {
                        if qbe_ty_has_untyped_option(bv.ty) {
                          saw_untyped_none = true
                        }
                        res_ty = Some(ty_prefer_concrete(rt, bv.ty))
                      }
                    }
                    if !g.block_term {
                      let store_ty = match res_ty {
                        Some(t) => t
                        None => bv.ty
                      }
                      match store_ty {
                        TUnit => ()
                        _ => {
                          if res_slot == "" {
                            res_slot = qbe_alloc_slot_for(g, store_ty)
                          }
                          qbe_store_local_slot(
                            g,
                            qbe_coerce_val(g, bv, store_ty),
                            res_slot,
                            store_ty,
                          )
                        }
                      }
                    }
                    qbe_scope_pop(g)
                    qbe_emit_term(g, "jmp " + l_end)
                  } else {
                    let file_id = qbe_intern_source_path(g, sp.file)
                    let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
                    qbe_emit(
                      g,
                      "call $pion_panic(l $pion_cstr_" +
                      msg_id.to_string() +
                      ", l $pion_cstr_" +
                      file_id.to_string() +
                      ", w " +
                      sp.line.to_string() +
                      ")",
                    )
                    qbe_emit_term(g, "jmp " + l_end)
                  }
                  qbe_emit_lbl(g, l_end)
                  qbe_scope_pop(g)
                  let final_ty = match res_ty {
                    Some(t) => t
                    None => TUnit
                  }
                  if res_slot == "" {
                    return qval(qbe_zero_reg(final_ty), final_ty)
                  } else {
                    let mut r = qbe_load_local_slot(g, res_slot, final_ty)
                    if saw_untyped_none {
                      r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
                    }
                    return qval(r, final_ty)
                  }
                }
              }
              None => ()
            }
          _ => ()
        }
      }
      let mut res_slot = ""
      let l_end = qbe_lbl(g, "match_end")
      let mut res_ty : Option[Ty] = qbe_probe_arms_ty(
        g,
        arms,
        Some(sv.ty),
        expected,
      )
      let mut saw_untyped_none = false
      let mut exhaustive = false
      let mut i = 0
      while i < arms.length() {
        let mut grp_end = i + 1
        while grp_end < arms.length() && qbe_arm_can_share(arms[i], arms[grp_end]) {
          grp_end = grp_end + 1
        }
        let arm = arms[i]
        let is_irref = grp_end == i + 1 && qbe_arm_is_irrefutable(arm)
        let l_next = if is_irref { "" } else { qbe_lbl(g, "match_next") }
        if grp_end > i + 1 {
          let l_body = qbe_lbl(g, "match_arm")
          let mut gi = i
          while gi < grp_end {
            let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
            if gi + 1 < grp_end {
              let l_try_next = qbe_lbl(g, "match_next")
              qbe_emit_pat_test(g, arms[gi].pat, cur_sv, sv.ty, l_try_next)
              qbe_emit_term(g, "jmp " + l_body)
              qbe_emit_lbl(g, l_try_next)
            } else {
              qbe_emit_pat_test(g, arms[gi].pat, cur_sv, sv.ty, l_next)
              qbe_emit_term(g, "jmp " + l_body)
            }
            gi = gi + 1
          }
          qbe_emit_lbl(g, l_body)
        } else if !is_irref {
          let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
          qbe_emit_pat_test(g, arm.pat, cur_sv, sv.ty, l_next)
        }
        qbe_scope_push(g)
        if grp_end == i + 1 && qbe_pat_has_binds(arm.pat) {
          let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
          let arm_allow_borrow = match arm.guard_expr {
            Some(_) => false
            None => true
          }
          qbe_emit_pat_bind(g, arm.pat, bind_sv, sv.ty, arm_allow_borrow, arm.body)
        }
        let arm_dp_pinned : Array[String] = []
        qbe_pin_top_scope_for_arm(g, arm.guard_expr, arm.body, arm_dp_pinned)
        match arm.guard_expr {
          Some(ge) => {
            let l_body = qbe_lbl(g, "match_guard_ok")
            let l_gfail = qbe_lbl(g, "match_guard_fail")
            let before_guard = g.scopes[g.scopes.length() - 1].locals.length()
            if qbe_expr_has_is(ge) {
              qbe_emit_cond_branch_bind(g, ge, l_body, l_gfail, None)
            } else {
              qbe_emit_cond_branch(g, ge, l_body, l_gfail)
            }
            qbe_emit_lbl(g, l_gfail)
            qbe_release_scope_locals_range(g, 0, before_guard)
            qbe_emit_term(g, "jmp " + l_next)
            qbe_emit_lbl(g, l_body)
          }
          None => ()
        }
        let bv = qbe_emit_expr(g, arm.body, res_ty)
        qbe_unpin_slot_list(g, arm_dp_pinned)
        match res_ty {
          None =>
            match bv.ty {
              TNever => ()
              _ => {
                if qbe_ty_has_untyped_option(bv.ty) {
                  saw_untyped_none = true
                }
                res_ty = Some(bv.ty)
              }
            }
          Some(rt) => {
            if qbe_ty_has_untyped_option(bv.ty) {
              saw_untyped_none = true
            }
            res_ty = Some(ty_prefer_concrete(rt, bv.ty))
          }
        }
        if !g.block_term {
          let store_ty = match res_ty {
            Some(t) => t
            None => bv.ty
          }
          match store_ty {
            TUnit => ()
            _ => {
              if res_slot == "" {
                res_slot = qbe_alloc_slot_for(g, store_ty)
              }
              qbe_store_local_slot(g, qbe_coerce_val(g, bv, store_ty), res_slot, store_ty)
            }
          }
        }
        qbe_scope_pop(g)
        qbe_emit_term(g, "jmp " + l_end)
        if is_irref {
          exhaustive = true
          break
        }
        qbe_emit_lbl(g, l_next)
        i = grp_end
      }
      if !exhaustive {
        let file_id = qbe_intern_source_path(g, sp.file)
        let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
        qbe_emit(
          g,
          "call $pion_panic(l $pion_cstr_" +
          msg_id.to_string() +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_emit_term(g, "jmp " + l_end)
      }
      qbe_emit_lbl(g, l_end)
      qbe_scope_pop(g)
      let final_ty = match res_ty {
        Some(t) => t
        None => TUnit
      }
      if res_slot == "" {
        qval(qbe_zero_reg(final_ty), final_ty)
      } else {
        let mut r = qbe_load_local_slot(g, res_slot, final_ty)
        if saw_untyped_none {
          r = qbe_normalize_untyped_none_in_val(g, r, final_ty)
        }
        qval(r, final_ty)
      }
    }
    EClosure(params, ret_te, body, sp) => {
      let cres = qbe_emit_closure_obj(g, params, ret_te, body, false, expected, sp)
      qval(cres.env, cres.ty)
    }
    EScope(w_expr, f_expr, _) => {
      let wv = qbe_emit_expr(g, w_expr, Some(TWorld))
      qbe_rc_dec(g, wv.reg, wv.ty)
      let sc = qbe_tmp(g)
      qbe_emit(g, sc + " =l call $pion_scope_begin()")
      match f_expr {
        EClosure(params, _, body, _) => {
          qbe_scope_push(g)
          if params.length() >= 1 {
            let sloc = qbe_define_local(g, params[0].name, TScope, false)
            qbe_emit(g, "storel " + sc + ", " + sloc.slot)
          }
          let bv = qbe_emit_stmts(g, body, Some(TUnit))
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
        }
        _ => {
          let fv = qbe_emit_expr(g, f_expr, Some(TFn([TScope], TUnit)))
          qbe_emit(g, "call $pion_rc_inc(l " + sc + ")")
          let _ = qbe_emit_closure_call(g, fv.reg, [sc], [TScope])
        }
      }
      qbe_emit(g, "call $pion_scope_end(l " + sc + ")")
      qval("0", TUnit)
    }
    ESpawn(s_expr, f_expr, _) => {
      let sv = qbe_emit_expr(g, s_expr, Some(TScope))
      match f_expr {
        EClosure(params, ret_te, body, sp) => {
          let cres = qbe_emit_closure_obj(g, params, ret_te, body, true, Some(TFn([], TUnit)), sp)
          qbe_emit(
            g,
            "call $pion_scope_spawn(l " +
            sv.reg +
            ", l " +
            cres.fn_sym +
            ", l " +
            cres.env +
            ")",
          )
          qbe_emit(g, "call $pion_rc_dec(l " + cres.env + ")")
        }
        _ => {
          let fv = qbe_emit_expr(g, f_expr, Some(TFn([], TUnit)))
          let fn_ptr = qbe_tmp(g)
          qbe_emit(g, fn_ptr + " =l loadl " + fv.reg)
          qbe_emit(
            g,
            "call $pion_scope_spawn(l " + sv.reg + ", l " + fn_ptr + ", l " + fv.reg + ")",
          )
          qbe_emit(g, "call $pion_rc_dec(l " + fv.reg + ")")
        }
      }
      qbe_rc_dec(g, sv.reg, sv.ty)
      qval("0", TUnit)
    }
  }
}

///|
fn qbe_stmts_assigns_ident_from(
  stmts : Array[Stmt],
  start_idx : Int,
  name : String,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if qbe_expr_assigns_ident(init, name) {
          return true
        }
        if lname == name {
          return false
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if qbe_expr_assigns_ident(init, name) {
          return true
        }
        if str_arr_contains(lnames, name) {
          return false
        }
      }
      _ =>
        if qbe_stmt_assigns_ident(stmts[i], name) {
          return true
        }
    }
    i = i + 1
  }
  false
}

///|
fn qbe_is_pure_readonly_method(mname : String) -> Bool {
  mname == "length" ||
  mname == "is_empty" ||
  mname == "byte_at" ||
  mname == "starts_with" ||
  mname == "ends_with" ||
  mname == "contains" ||
  mname == "index_of" ||
  mname == "slice" ||
  mname == "trim" ||
  mname == "to_int" ||
  mname == "to_int64" ||
  mname == "to_double" ||
  mname == "to_string"
}

///|
/// Conservative check: returns true if `e` may invoke any mutating container method
/// or user function call (excluding enum/variant constructors and pure read-only methods).
fn qbe_expr_has_any_mut_call(g : QbeGen, e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => false
    EMutArg(_, _) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_expr_has_any_mut_call(g, inner)
    EBinary(op, l, r, _) =>
      ((op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, qbe_hints_new())) ||
      qbe_expr_has_any_mut_call(g, l) ||
      qbe_expr_has_any_mut_call(g, r)
    EIndex(l, r, _) =>
      qbe_expr_has_any_mut_call(g, l) || qbe_expr_has_any_mut_call(g, r)
    ECall(callee, args, _) => {
      let is_pure_ctor = match callee {
        EIdent(cname, _) =>
          !g.tc.fns.contains(cname) &&
          !g.tc.extern_fns.contains(cname) &&
          (cname == "Some" || cname == "None" || cname == "Ok" || cname == "Err" || g.tc.variant_to_enum.contains(cname))
        EPath(prefix, item, _) =>
          match g.tc.enums.get(prefix) {
            Some(_) => true
            None =>
              match g.tc.imported_pkgs.get(prefix) {
                Some(ipkg) => !ipkg.tc.fns.contains(item) && ipkg.tc.variant_to_enum.contains(item)
                None => false
              }
          }
        _ => false
      }
      if !is_pure_ctor {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_mut_call(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(obj, mname, args, _) => {
      if !qbe_is_pure_readonly_method(mname) ||
        (mname == "contains" && qbe_contains_may_call_custom(g, obj, qbe_hints_new())) {
        return true
      }
      if qbe_expr_has_any_mut_call(g, obj) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_any_mut_call(g, args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_any_mut_call(g, elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if qbe_expr_has_any_mut_call(g, b) { return true }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_any_mut_call(g, fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_any_mut_call(g, stmts, 0)
    EIf(cond, then_stmts, else_opt, _) => {
      if qbe_expr_has_any_mut_call(g, cond) || qbe_stmts_has_any_mut_call(g, then_stmts, 0) {
        return true
      }
      match else_opt {
        None => false
        Some(el) => qbe_expr_has_any_mut_call(g, el)
      }
    }
    EIs(scrut, _, _) => qbe_expr_has_any_mut_call(g, scrut)
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_any_mut_call(g, scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if qbe_expr_has_any_mut_call(g, ge) { return true }
          None => ()
        }
        if qbe_expr_has_any_mut_call(g, arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) => true
  }
}

///|
fn qbe_stmt_has_any_mut_call(g : QbeGen, s : Stmt) -> Bool {
  match s {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
      qbe_expr_has_any_mut_call(g, init)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_expr_has_any_mut_call(g, lhs) || qbe_expr_has_any_mut_call(g, rhs)
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_expr_has_any_mut_call(g, cond) || qbe_stmts_has_any_mut_call(g, body, 0)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_stmt_has_any_mut_call(g, init_s) ||
      qbe_expr_has_any_mut_call(g, cond) ||
      qbe_stmt_has_any_mut_call(g, step_s) ||
      qbe_stmts_has_any_mut_call(g, body, 0)
    SForRange(_, start_e, end_e, _, body, _) =>
      qbe_expr_has_any_mut_call(g, start_e) ||
      qbe_expr_has_any_mut_call(g, end_e) ||
      qbe_stmts_has_any_mut_call(g, body, 0)
    SForIn(_, _, iter_e, body, _) =>
      qbe_expr_has_any_mut_call(g, iter_e) || qbe_stmts_has_any_mut_call(g, body, 0)
    SReturn(opt, _) =>
      match opt {
        None => false
        Some(e) => qbe_expr_has_any_mut_call(g, e)
      }
    SBreak(_) | SContinue(_) => false
    SDebugAssert(c, m, _) =>
      qbe_expr_has_any_mut_call(g, c) || qbe_expr_has_any_mut_call(g, m)
    SExpr(e, _) => qbe_expr_has_any_mut_call(g, e)
  }
}

///|
fn qbe_stmts_has_any_mut_call(g : QbeGen, stmts : Array[Stmt], start_idx : Int) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    if qbe_stmt_has_any_mut_call(g, stmts[i]) {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Conservative stability check for `base.fname` (struct field or array field).
fn qbe_field_base_is_stable_expr(
  e : Expr,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EIdent(n, _) => n != base
    EMutArg(inner, _) =>
      qbe_mut_place_root(inner) != base &&
      qbe_field_base_is_stable_expr(inner, base, fname, allow_field_read)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ENamedArg(_, _, inner, _) =>
      qbe_field_base_is_stable_expr(inner, base, fname, allow_field_read)
    EBinary(_, l, r, _) =>
      qbe_field_base_is_stable_expr(l, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(r, base, fname, allow_field_read)
    EField(obj, f, _) =>
      match obj {
        EIdent(n, _) =>
          if n == base {
            f != fname || allow_field_read
          } else {
            true
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    EIndex(obj, idx, _) => {
      if !qbe_field_base_is_stable_expr(idx, base, fname, allow_field_read) {
        return false
      }
      match obj {
        EField(EIdent(n, _), f, _) =>
          if n == base && f == fname {
            true
          } else {
            qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    }
    EMethodCall(obj, mname, args, _) => {
      let mut i = 0
      while i < args.length() {
        if !qbe_field_base_is_stable_expr(args[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      match obj {
        EField(EIdent(n, _), f, _) =>
          if n == base && f == fname {
            mname == "length" && args.length() == 0
          } else {
            qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
          }
        _ => qbe_field_base_is_stable_expr(obj, base, fname, allow_field_read)
      }
    }
    ECall(callee, args, _) => {
      if !qbe_field_base_is_stable_expr(callee, base, fname, allow_field_read) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_field_base_is_stable_expr(args[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) | EInterp(elems, _) | EDotVariant(_, elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_field_base_is_stable_expr(elems[i], base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_field_base_is_stable_expr(b, base, fname, allow_field_read) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_field_base_is_stable_expr(fields[i].value, base, fname, allow_field_read) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_field_base_is_stable_stmts(stmts, 0, base, fname, allow_field_read)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) ||
        !qbe_field_base_is_stable_stmts(then_stmts, 0, base, fname, allow_field_read) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_field_base_is_stable_expr(el, base, fname, allow_field_read)
      }
    }
    EIs(scrut, _, _) => qbe_field_base_is_stable_expr(scrut, base, fname, allow_field_read)
    EMatch(scrut, arms, _) => {
      if !qbe_field_base_is_stable_expr(scrut, base, fname, allow_field_read) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        if !qbe_pat_binds_name(arms[i].pat, base) {
          match arms[i].guard_expr {
            Some(ge) =>
              if !qbe_field_base_is_stable_expr(ge, base, fname, allow_field_read) {
                return false
              }
            None => ()
          }
          if !qbe_field_base_is_stable_expr(arms[i].body, base, fname, allow_field_read) {
            return false
          }
        }
        i = i + 1
      }
      true
    }
    EClosure(_, _, _, _) | EScope(_, _, _) | ESpawn(_, _, _) | ETry(_, _) =>
      !qbe_expr_mentions_ident(e, base)
  }
}

///|
fn qbe_field_base_is_stable_stmt(
  s : Stmt,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
      qbe_field_base_is_stable_expr(init, base, fname, allow_field_read)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
      if !qbe_field_base_is_stable_expr(rhs, base, fname, allow_field_read) {
        return false
      }
      match lhs {
        EIdent(n, _) => n != base
        EField(EIdent(n, _), f, _) => !(n == base && f == fname)
        EIndex(EField(EIdent(n, _), f, _), _, _) => !(n == base && f == fname)
        _ => qbe_field_base_is_stable_expr(lhs, base, fname, allow_field_read)
      }
    }
    SWhile(cond, body, _) | SGuard(cond, body, _) =>
      qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read)
    SFor(init_s, cond, step_s, body, _) =>
      qbe_field_base_is_stable_stmt(init_s, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(cond, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmt(step_s, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read)
    SForRange(vname, start_e, end_e, _, body, _) =>
      qbe_field_base_is_stable_expr(start_e, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(end_e, base, fname, allow_field_read) &&
      (vname == base || qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read))
    SForIn(_, vname, iter_e, body, _) =>
      qbe_field_base_is_stable_expr(iter_e, base, fname, allow_field_read) &&
      (vname == base || qbe_field_base_is_stable_stmts(body, 0, base, fname, allow_field_read))
    SReturn(opt, _) =>
      match opt {
        None => true
        Some(e) => qbe_field_base_is_stable_expr(e, base, fname, allow_field_read)
      }
    SBreak(_) | SContinue(_) => true
    SDebugAssert(c, m, _) =>
      qbe_field_base_is_stable_expr(c, base, fname, allow_field_read) &&
      qbe_field_base_is_stable_expr(m, base, fname, allow_field_read)
    SExpr(e, _) => qbe_field_base_is_stable_expr(e, base, fname, allow_field_read)
  }
}

///|
fn qbe_field_base_is_stable_stmts(
  stmts : Array[Stmt],
  start_idx : Int,
  base : String,
  fname : String,
  allow_field_read : Bool,
) -> Bool {
  let mut i = start_idx
  while i < stmts.length() {
    match stmts[i] {
      SLet(lname, _, _, init, _) => {
        if !qbe_field_base_is_stable_expr(init, base, fname, allow_field_read) {
          return false
        }
        if lname == base {
          return true
        }
      }
      SLetTuple(lnames, _, init, _) => {
        if !qbe_field_base_is_stable_expr(init, base, fname, allow_field_read) {
          return false
        }
        if str_arr_contains(lnames, base) {
          return true
        }
      }
      _ =>
        if !qbe_field_base_is_stable_stmt(stmts[i], base, fname, allow_field_read) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
fn qbe_lookup_try_into_conv(g : QbeGen, sp : Span) -> Option[IntoConv] {
  let k = span_key(sp)
  match g.tc.try_into_convs.get(k) {
    Some(c) => return Some(c)
    None => ()
  }
  let mut ii = 0
  while ii < g.tc.all_imported_pkg_names.length() {
    match g.tc.all_imported_pkgs.get(g.tc.all_imported_pkg_names[ii]) {
      Some(ip) =>
        match ip.tc.try_into_convs.get(k) {
          Some(c) => return Some(c)
          None => ()
        }
      None => ()
    }
    ii = ii + 1
  }
  None
}

///|
fn qbe_apply_into_conv(
  g : QbeGen,
  err_v : String,
  err_ty : Ty,
  conv : IntoConv,
  sp : Span,
) -> QbeVal {
  qbe_scope_push(g)
  let tmp_name = "__into_try_err_" + g.next_tmp.to_string()
  g.next_tmp = g.next_tmp + 1
  let loc = qbe_define_local(g, tmp_name, err_ty, true)
  qbe_store_local_slot(g, err_v, loc.slot, err_ty)
  let ident = EIdent(tmp_name, sp)
  let conv_expr = if conv.kind == 0 {
    EMethodCall(ident, conv.name, [], sp)
  } else if conv.kind == 1 {
    ECall(EPath(conv.qual, conv.name, sp), [ident], sp)
  } else {
    EMethodCall(ident, conv.name, [], sp)
  }
  let res = qbe_emit_expr(g, conv_expr, Some(conv.target_ty))
  qbe_scope_pop(g)
  res
}

///|
/// P55-C: Unified `ETry` (`?`) error-path exit for top-level functions, normal inlines,
/// and scalarized `Option`/`Result` inlines.
fn qbe_emit_try_err_exit(
  g : QbeGen,
  err_v_in : String,
  err_ty_in : Ty,
  ok_ty : Ty,
  from_boxed_reg_in : String,
  try_sp : Span,
) -> Unit {
  let mut err_v = err_v_in
  let mut err_ty = err_ty_in
  let mut from_boxed_reg = from_boxed_reg_in
  match qbe_lookup_try_into_conv(g, try_sp) {
    Some(conv) => {
      let raw_ev = if from_boxed_reg != "" {
        let p1 = qbe_tmp(g)
        qbe_emit(g, p1 + " =l add " + from_boxed_reg + ", 8")
        let v = qbe_load_heap_slot(g, p1, err_ty)
        qbe_rc_inc(g, v, err_ty)
        qbe_emit(g, "call $pion_rc_dec(l " + from_boxed_reg + ")")
        v
      } else {
        err_v
      }
      let cv = qbe_apply_into_conv(g, raw_ev, err_ty, conv, try_sp)
      err_v = cv.reg
      err_ty = conv.target_ty
      from_boxed_reg = ""
    }
    None => ()
  }
  if g.inline_ret_lbl != "" {
    if g.inline_ret_tag_slot != "" {
      let ret_err_ty = match g.inline_ret_ty {
        TResult(_, et) => et
        _ => err_ty
      }
      let ev = if from_boxed_reg != "" {
        let p1 = qbe_tmp(g)
        qbe_emit(g, p1 + " =l add " + from_boxed_reg + ", 8")
        let v = qbe_load_heap_slot(g, p1, err_ty)
        qbe_rc_inc(g, v, err_ty)
        qbe_emit(g, "call $pion_rc_dec(l " + from_boxed_reg + ")")
        v
      } else {
        err_v
      }
      let ec = qbe_coerce_val(g, qval(ev, err_ty), ret_err_ty)
      let err_dst = if g.inline_ret_pod_buf {
        g.inline_ret_err_slot
      } else {
        g.inline_ret_slot
      }
      qbe_store_heap_slot(g, ec, err_dst, ret_err_ty)
      qbe_emit(g, "storew 0, " + g.inline_ret_tag_slot)
      qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
      qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
      return
    }
    let (outer_ok, outer_err) = match g.inline_ret_ty {
      TResult(ok, et) => (ok, et)
      _ => (ok_ty, err_ty)
    }
    let err_obj = if from_boxed_reg != "" {
      from_boxed_reg
    } else {
      let err_l = qbe_as_l(g, qval(err_v, err_ty))
      qbe_emit_result(g, 1, err_l, outer_ok, outer_err)
    }
    if g.inline_ret_slot != "" {
      qbe_store_local_slot(g, err_obj, g.inline_ret_slot, g.inline_ret_ty)
    }
    qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
    qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
    return
  }
  if from_boxed_reg != "" &&
    qbe_try_emit_shared_cleanup_exit(g, from_boxed_reg) {
    return
  }
  qbe_release_scopes_down_to(g, 0)
  if from_boxed_reg != "" {
    qbe_emit_term(g, "ret " + from_boxed_reg)
  } else {
    let outer_ok = match g.cur_ret_ty {
      TResult(ok, _) => ok
      _ => ok_ty
    }
    let err_l = qbe_as_l(g, qval(err_v, err_ty))
    let err_obj = qbe_emit_result(g, 1, err_l, outer_ok, err_ty)
    qbe_emit_term(g, "ret " + err_obj)
  }
}

///|
fn qbe_emit_try_none_exit(g : QbeGen) -> Unit {
  if g.inline_ret_lbl != "" {
    if g.inline_ret_tag_slot != "" {
      qbe_emit(g, "storew 0, " + g.inline_ret_tag_slot)
      qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
      qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
      return
    }
    let ret_inner = match g.inline_ret_ty {
      TOption(ri) => ri
      _ => TError
    }
    let none_obj = qbe_emit_none(g, ret_inner)
    if g.inline_ret_slot != "" {
      qbe_store_local_slot(g, none_obj, g.inline_ret_slot, g.inline_ret_ty)
    }
    qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
    qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
    return
  }
  let ret_inner = match g.cur_ret_ty {
    TOption(ri) => ri
    _ => TError
  }
  let none_obj = qbe_emit_none(g, ret_inner)
  if qbe_try_emit_shared_cleanup_exit(g, none_obj) {
    return
  }
  qbe_release_scopes_down_to(g, 0)
  qbe_emit_term(g, "ret " + none_obj)
}

///|
fn qbe_clear_shadowed_local_meta(g : QbeGen, name : String) -> Unit {
  g.len_aliases.remove(name)
  qbe_invalidate_len_aliases_for(g, name)
  g.unfrozen_local_arrs.remove(name)
  g.nonneg_vars.remove(name)
  g.u8_range_vars.remove(name)
  g.known_min_len_arrs.remove(name)
  g.known_writable_bytes.remove(name)
}

///|
/// P55-C: Stack scalarization (SRA) of non-escaping local pure-scalar immutable POD structs:
/// - Case B1: direct `EStructLit` / `EIf` / `EBlock`
/// - Case B2: inlined function/method returning pure-scalar POD struct literals
/// - Case B3: `let ts = expr?` where `expr` scalarizes as `Option[PodStruct]`/`Result[PodStruct, Err]`
fn qbe_try_emit_stack_pod_let(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
) -> Bool {
  let (bname, is_mut, ty_expr, init) = match stmts[idx] {
    SLet(n, m, te, ini, _) => (n, m, te, ini)
    _ => return false
  }
  if is_mut || bname == "_" || g.boxed_mut_vars.contains(bname) {
    return false
  }
  let probed_ty : Option[Ty] = match ty_expr {
    TyMissing(_) => qbe_probe_expr_ty(g, init)
    _ => Some(qbe_resolve_type(g, ty_expr))
  }
  let final_ty = match probed_ty {
    Some(t) => subst_ty(t, g.cur_type_subst)
    None => return false
  }
  match final_ty {
    TDynTrait(_) => return false
    _ => ()
  }
  let sinfo = match qbe_pure_scalar_pod_struct_info(g, final_ty) {
    Some(si) => si
    None =>
      match qbe_pure_scalar_pod_enum_info(g, final_ty) {
        Some((einfo, nslots)) => {
          if !qbe_ident_is_match_only_enum_stmts(stmts, idx + 1, bname) {
            return false
          }
          let pod_bytes = nslots * 8
          // Case E1: `let st = expr?` (e.g. `let st = decode(...)?`)
          match init {
            ETry(inner, try_sp) =>
              match qbe_try_emit_opt_res_scalarized(g, inner, 0, true) {
                Some(sc) => {
                  if g.block_term {
                    return true
                  }
                  match sc.ret_ty {
                    TResult(ok_ty, err_ty) => {
                      let tag_w = qbe_tmp(g)
                      let l_ok = qbe_lbl(g, "try_ok")
                      let l_err = qbe_lbl(g, "try_err")
                      qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
                      qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
                      qbe_emit_lbl(g, l_err)
                      let err_v = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                      qbe_emit_try_err_exit(g, err_v, err_ty, ok_ty, "", try_sp)
                      qbe_emit_lbl(g, l_ok)
                      qbe_clear_shadowed_local_meta(g, bname)
                      if sc.val_is_pod_buf {
                        let loc = qbe_define_local(g, bname, final_ty, false)
                        let pv = qbe_pod_buf_val(g, sc.val_slot, final_ty)
                        qbe_emit(g, "storel " + pv + ", " + loc.slot)
                      } else {
                        let payload = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
                        let loc = qbe_define_local(g, bname, final_ty, true)
                        qbe_store_local_slot(
                          g,
                          qbe_coerce_val(g, qval(payload, ok_ty), final_ty),
                          loc.slot,
                          final_ty,
                        )
                      }
                      return true
                    }
                    TOption(inner_ty) => {
                      let tag_w = qbe_tmp(g)
                      let l_some = qbe_lbl(g, "try_some")
                      let l_none = qbe_lbl(g, "try_none")
                      qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
                      qbe_emit_term(g, "jnz " + tag_w + ", " + l_some + ", " + l_none)
                      qbe_emit_lbl(g, l_none)
                      qbe_emit_try_none_exit(g)
                      qbe_emit_lbl(g, l_some)
                      qbe_clear_shadowed_local_meta(g, bname)
                      if sc.val_is_pod_buf {
                        let loc = qbe_define_local(g, bname, final_ty, false)
                        let pv = qbe_pod_buf_val(g, sc.val_slot, final_ty)
                        qbe_emit(g, "storel " + pv + ", " + loc.slot)
                      } else {
                        let payload = qbe_load_heap_slot(g, sc.val_slot, inner_ty)
                        let loc = qbe_define_local(g, bname, final_ty, true)
                        qbe_store_local_slot(
                          g,
                          qbe_coerce_val(g, qval(payload, inner_ty), final_ty),
                          loc.slot,
                          final_ty,
                        )
                      }
                      return true
                    }
                    _ => ()
                  }
                }
                None => ()
              }
            _ => ()
          }
          // Case E2: direct pure-scalar enum ctor tails (`let st = if c { Complete(true, 2) } else { Incomplete }`)
          if qbe_expr_all_tails_are_pod_enum_ctors(g, init, einfo, final_ty) {
            let stk = qbe_alloc_immortal_enum_stack_buf(g, pod_bytes)
            qbe_emit_tail_pod_enum_into_buf(g, init, einfo, final_ty, stk)
            if !g.block_term {
              qbe_clear_shadowed_local_meta(g, bname)
              let loc = qbe_define_local(g, bname, final_ty, false)
              let pv = qbe_pod_buf_val(g, stk, final_ty)
              qbe_emit(g, "storel " + pv + ", " + loc.slot)
            }
            return true
          }
          return false
        }
        None => return false
      }
  }
  let future_locals = qbe_collect_future_local_bind_names(stmts, idx + 1, bname)
  if !qbe_ident_is_flat_pod_consumer_stmts(
    g,
    stmts,
    idx + 1,
    bname,
    final_ty,
    Map([]),
    future_locals,
    0,
  ) {
    return false
  }
  let pod_bytes = sinfo.field_names.length() * 8
  // Case B0 (P72-A): `let ed = arr[i]` / `let ed = expr[i]` for pure-scalar POD arrays ->
  // copy fields once into a stack POD buffer (immune to subsequent array push/reallocation).
  match init {
    EIndex(src_obj, src_idx, _) => {
      let mut src_can = false
      let mut src_borrowed = false
      let mut src_aname = ""
      let mut src_ov = qval("0", TUnit)
      match src_obj {
        EIdent(aname, _) =>
          if !qbe_expr_has_assign(src_idx) {
            match qbe_lookup_local(g, aname) {
              Some(sloc) =>
                if !sloc.is_cell {
                  match sloc.ty {
                    TArray(se) | TFixedArray(se) | TImmArray(se) =>
                      if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
                        src_can = true
                        src_borrowed = true
                        src_aname = aname
                        if g.hoisted_arr_len.contains(aname) &&
                          g.hoisted_arr_dp.contains(aname) {
                          src_ov = qval("0", sloc.ty)
                        } else {
                          let r = qbe_tmp(g)
                          qbe_emit(g, r + " =l loadl " + sloc.slot)
                          src_ov = qval(r, sloc.ty)
                        }
                      }
                    _ => ()
                  }
                }
              None => ()
            }
          }
        _ => ()
      }
      if !src_can {
        match qbe_probe_expr_ty(g, src_obj) {
          Some(TArray(se)) | Some(TFixedArray(se)) | Some(TImmArray(se)) =>
            if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
              src_can = true
              src_borrowed = false
              src_ov = qbe_emit_expr(g, src_obj, None)
            }
          _ => ()
        }
      }
      if src_can {
        let src_iv = qbe_emit_expr(g, src_idx, Some(TInt))
        let src_il = qbe_as_l(g, src_iv)
        let src_bce = if src_aname != "" {
          qbe_bce_expr_is_safe(g, src_aname, src_idx)
        } else {
          false
        }
        if !src_bce {
          let salen = match g.hoisted_arr_len.get(src_aname) {
            Some(hlen) => hlen
            None => {
              let t = qbe_tmp(g)
              qbe_emit(g, t + " =l loadl " + src_ov.reg)
              t
            }
          }
          let oob = qbe_tmp(g)
          let l_oob = qbe_lbl(g, "arr_oob")
          let l_ok = qbe_lbl(g, "arr_ok")
          qbe_emit(g, oob + " =w cugel " + src_il + ", " + salen)
          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
          qbe_emit_lbl(g, l_oob)
          qbe_emit(g, "call $pion_panic_oob(l " + src_il + ", l " + salen + ")")
          qbe_emit_term(g, "hlt")
          qbe_emit_lbl(g, l_ok)
        }
        let sdp = match g.hoisted_arr_dp.get(src_aname) {
          Some(hdp) => hdp
          None => {
            let dp_p = qbe_tmp(g)
            let t = qbe_tmp(g)
            qbe_emit(g, dp_p + " =l add " + src_ov.reg + ", 24")
            qbe_emit(g, t + " =l loadl " + dp_p)
            t
          }
        }
        let src_ep = qbe_emit_arr_elem_addr(g, sdp, src_il, pod_bytes)
        let stk = qbe_alloc_stack_buf(g, pod_bytes)
        qbe_copy_pod_buf(g, sinfo, final_ty, src_ep, stk)
        if !src_borrowed {
          qbe_rc_dec(g, src_ov.reg, src_ov.ty)
        }
        qbe_clear_shadowed_local_meta(g, bname)
        let loc = qbe_define_local(g, bname, final_ty, false)
        qbe_emit(g, "storel " + stk + ", " + loc.slot)
        return true
      }
    }
    _ => ()
  }
  // Case B4 (P72-A): `let x = match expr { Ok(v) => v; Err(_) => fallback_or_diverge }`
  // (reuses `sc.val_slot` directly with zero copy when `sc.val_is_pod_buf == true`).
  match init {
    EMatch(scrut, arms, _) =>
      match qbe_match_2arm_opt_res(arms) {
        Some((want_kind, ok_idx, err_idx, ok_bind, err_bind)) => {
          let ok_is_passthrough = ok_bind != "" &&
            match arms[ok_idx].body {
              EIdent(bn, _) => bn == ok_bind
              _ => false
            }
          if ok_is_passthrough {
            let err_body = arms[err_idx].body
            let err_is_lit = qbe_expr_all_tails_are_pod_struct_lits(err_body)
            let err_pod_local : Option[QbeLocal] = match err_body {
              EIdent(rn, _) =>
                if rn != err_bind {
                  match qbe_lookup_local(g, rn) {
                    Some(rloc) =>
                      if !rloc.is_cell && qbe_ty_matches_pure_pod_struct(g, rloc.ty, final_ty) {
                        Some(rloc)
                      } else {
                        None
                      }
                    None => None
                  }
                } else {
                  None
                }
              _ => None
            }
            let err_is_div = match qbe_probe_expr_ty(g, err_body) {
              Some(TNever) => true
              _ =>
                match err_body {
                  ECall(EIdent("panic", _), _, _) => true
                  EBlock(bs, _) =>
                    bs.length() > 0 &&
                    match bs[bs.length() - 1] {
                      SReturn(_, _) | SBreak(_) | SContinue(_) => true
                      SExpr(ECall(EIdent("panic", _), _, _), _) => true
                      _ => false
                    }
                  _ => false
                }
            }
            let err_has_local = match err_pod_local {
              Some(_) => true
              None => false
            }
            if err_is_lit || err_has_local || err_is_div {
              match qbe_try_emit_opt_res_scalarized(g, scrut, want_kind, true) {
                Some(sc) => {
                  if g.block_term {
                    return true
                  }
                  let out_buf = if sc.val_is_pod_buf {
                    sc.val_slot
                  } else {
                    qbe_alloc_stack_buf(g, pod_bytes)
                  }
                  let tag_w = qbe_tmp(g)
                  let l_ok = qbe_lbl(g, "spod_m4_ok")
                  let l_err = qbe_lbl(g, "spod_m4_err")
                  let l_end = qbe_lbl(g, "spod_m4_end")
                  qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
                  qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
                  qbe_emit_lbl(g, l_ok)
                  if !sc.val_is_pod_buf {
                    let hp = qbe_load_heap_slot(g, sc.val_slot, final_ty)
                    qbe_copy_pod_buf(g, sinfo, final_ty, hp, out_buf)
                    qbe_rc_dec(g, hp, final_ty)
                  }
                  qbe_emit_term(g, "jmp " + l_end)
                  qbe_emit_lbl(g, l_err)
                  g.block_immut_fields = Map([])
                  qbe_scope_push(g)
                  match sc.ret_ty {
                    TResult(_, err_ty) =>
                      if err_bind != "" && err_bind != "_" {
                        let ev = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                        let eloc = qbe_define_local(g, err_bind, err_ty, true)
                        qbe_store_local_slot(g, ev, eloc.slot, err_ty)
                      } else if qbe_is_obj_ty(g, err_ty) {
                        let ev = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                        qbe_rc_dec(g, ev, err_ty)
                      }
                    _ => ()
                  }
                  if err_is_lit {
                    qbe_emit_tail_pod_struct_into_buf(g, err_body, sinfo, final_ty, out_buf)
                  } else {
                    match err_pod_local {
                      Some(rloc) => {
                        let src_p = qbe_tmp(g)
                        qbe_emit(g, src_p + " =l loadl " + rloc.slot)
                        qbe_copy_pod_buf(g, sinfo, final_ty, src_p, out_buf)
                      }
                      None => {
                        let _ = qbe_emit_expr(g, err_body, Some(final_ty))
                      }
                    }
                  }
                  qbe_scope_pop(g)
                  if !g.block_term {
                    qbe_emit_term(g, "jmp " + l_end)
                  }
                  qbe_emit_lbl(g, l_end)
                  g.block_immut_fields = Map([])
                  qbe_clear_shadowed_local_meta(g, bname)
                  let loc = qbe_define_local(g, bname, final_ty, false)
                  qbe_emit(g, "storel " + out_buf + ", " + loc.slot)
                  return true
                }
                None => ()
              }
            }
          }
        }
        None => ()
      }
    EMethodCall(scrut, mname, margs, msp) =>
      if !qbe_has_expected_trait(g, msp) &&
        ((mname == "unwrap" && margs.length() == 0) ||
        (mname == "unwrap_or" && margs.length() == 1)) {
        let dflt_is_pure_lit = if mname == "unwrap" {
          false
        } else {
          let d = margs[0]
          qbe_expr_all_tails_are_pod_struct_lits(d) &&
          !qbe_expr_has_assign(d) &&
          qbe_loop_has_no_calls_expr(g, d)
        }
        let dflt_ok = if mname == "unwrap" {
          true
        } else {
          let d = margs[0]
          dflt_is_pure_lit ||
          match d {
            EIdent(rn, _) =>
              match qbe_lookup_local(g, rn) {
                Some(rloc) =>
                  !rloc.is_cell && qbe_ty_matches_pure_pod_struct(g, rloc.ty, final_ty)
                None => false
              }
            _ => false
          }
        }
        if dflt_ok {
          match qbe_try_emit_opt_res_scalarized(g, scrut, 0, true) {
            Some(sc) => {
              if g.block_term {
                return true
              }
              let out_buf = if sc.val_is_pod_buf {
                sc.val_slot
              } else {
                qbe_alloc_stack_buf(g, pod_bytes)
              }
              let tag_w = qbe_tmp(g)
              let l_ok = qbe_lbl(g, "spod_u5_ok")
              let l_err = qbe_lbl(g, "spod_u5_err")
              let l_end = qbe_lbl(g, "spod_u5_end")
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
              qbe_emit_lbl(g, l_ok)
              if !sc.val_is_pod_buf {
                let hp = qbe_load_heap_slot(g, sc.val_slot, final_ty)
                qbe_copy_pod_buf(g, sinfo, final_ty, hp, out_buf)
                qbe_rc_dec(g, hp, final_ty)
              }
              qbe_emit_term(g, "jmp " + l_end)
              qbe_emit_lbl(g, l_err)
              g.block_immut_fields = Map([])
              match sc.ret_ty {
                TResult(_, err_ty) =>
                  if qbe_is_obj_ty(g, err_ty) {
                    let ev = qbe_load_heap_slot(g, sc.err_slot, err_ty)
                    qbe_rc_dec(g, ev, err_ty)
                  }
                _ => ()
              }
              if mname == "unwrap" {
                let msg_id = qbe_intern_cstring(g, "unwrap called on None/Err")
                let file_id = qbe_intern_source_path(g, msp.file)
                qbe_emit(
                  g,
                  "call $pion_panic(l $pion_cstr_" +
                  msg_id.to_string() +
                  ", l $pion_cstr_" +
                  file_id.to_string() +
                  ", w " +
                  msp.line.to_string() +
                  ")",
                )
                qbe_emit_term(g, "hlt")
              } else {
                let d = margs[0]
                if dflt_is_pure_lit {
                  qbe_emit_tail_pod_struct_into_buf(g, d, sinfo, final_ty, out_buf)
                } else {
                  match d {
                    EIdent(rn, _) =>
                      match qbe_lookup_local(g, rn) {
                        Some(rloc) => {
                          let src_p = qbe_tmp(g)
                          qbe_emit(g, src_p + " =l loadl " + rloc.slot)
                          qbe_copy_pod_buf(g, sinfo, final_ty, src_p, out_buf)
                        }
                        None => ()
                      }
                    _ => ()
                  }
                }
                if !g.block_term {
                  qbe_emit_term(g, "jmp " + l_end)
                }
              }
              qbe_emit_lbl(g, l_end)
              g.block_immut_fields = Map([])
              qbe_clear_shadowed_local_meta(g, bname)
              let loc = qbe_define_local(g, bname, final_ty, false)
              qbe_emit(g, "storel " + out_buf + ", " + loc.slot)
              return true
            }
            None => ()
          }
        }
      }
    _ => ()
  }
  // Case B1: direct struct literal / if / block
  if qbe_expr_all_tails_are_pod_struct_lits(init) {
    let stk = qbe_alloc_stack_buf(g, pod_bytes)
    qbe_emit_tail_pod_struct_into_buf(g, init, sinfo, final_ty, stk)
    if !g.block_term {
      qbe_clear_shadowed_local_meta(g, bname)
      let loc = qbe_define_local(g, bname, final_ty, false)
      qbe_emit(g, "storel " + stk + ", " + loc.slot)
    }
    return true
  }
  // Case B3: `let ts = expr?`
  match init {
    ETry(inner, try_sp) =>
      match qbe_try_emit_opt_res_scalarized(g, inner, 0, true) {
        Some(sc) => {
          if g.block_term {
            return true
          }
          match sc.ret_ty {
            TResult(ok_ty, err_ty) => {
              let tag_w = qbe_tmp(g)
              let l_ok = qbe_lbl(g, "try_ok")
              let l_err = qbe_lbl(g, "try_err")
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_ok + ", " + l_err)
              qbe_emit_lbl(g, l_err)
              let err_v = qbe_load_heap_slot(g, sc.err_slot, err_ty)
              qbe_emit_try_err_exit(g, err_v, err_ty, ok_ty, "", try_sp)
              qbe_emit_lbl(g, l_ok)
              qbe_clear_shadowed_local_meta(g, bname)
              if sc.val_is_pod_buf {
                let loc = qbe_define_local(g, bname, final_ty, false)
                let pv = qbe_pod_buf_val(g, sc.val_slot, final_ty)
                qbe_emit(g, "storel " + pv + ", " + loc.slot)
              } else {
                let payload = qbe_load_heap_slot(g, sc.val_slot, ok_ty)
                let loc = qbe_define_local(g, bname, final_ty, true)
                qbe_store_local_slot(
                  g,
                  qbe_coerce_val(g, qval(payload, ok_ty), final_ty),
                  loc.slot,
                  final_ty,
                )
              }
              return true
            }
            TOption(inner_ty) => {
              let tag_w = qbe_tmp(g)
              let l_some = qbe_lbl(g, "try_some")
              let l_none = qbe_lbl(g, "try_none")
              qbe_emit(g, tag_w + " =w loadw " + sc.tag_slot)
              qbe_emit_term(g, "jnz " + tag_w + ", " + l_some + ", " + l_none)
              qbe_emit_lbl(g, l_none)
              qbe_emit_try_none_exit(g)
              qbe_emit_lbl(g, l_some)
              qbe_clear_shadowed_local_meta(g, bname)
              if sc.val_is_pod_buf {
                let loc = qbe_define_local(g, bname, final_ty, false)
                let pv = qbe_pod_buf_val(g, sc.val_slot, final_ty)
                qbe_emit(g, "storel " + pv + ", " + loc.slot)
              } else {
                let payload = qbe_load_heap_slot(g, sc.val_slot, inner_ty)
                let loc = qbe_define_local(g, bname, final_ty, true)
                qbe_store_local_slot(
                  g,
                  qbe_coerce_val(g, qval(payload, inner_ty), final_ty),
                  loc.slot,
                  final_ty,
                )
              }
              return true
            }
            _ => return false
          }
        }
        None => return false
      }
    _ => ()
  }
  // Case B2: inlined function/method returning pure-scalar POD struct literals
  match init {
    ECall(EIdent(name, _), args, sp) => {
      match qbe_lookup_local(g, name) {
        Some(_) => return false
        None => ()
      }
      let target_pkg = g.mono_pkg
      let finfo_opt : Option[FnInfo] = if target_pkg == "" {
        g.tc.fns.get(name)
      } else {
        match g.tc.imported_pkgs.get(target_pkg) {
          Some(ipkg) =>
            match ipkg.tc.fns.get(name) {
              Some(fi) => Some(qualify_fn_info(ipkg, fi))
              None => None
            }
          None => None
        }
      }
      match finfo_opt {
        Some(finfo) => {
          let inl_fd_opt : Option[FnDecl] = if target_pkg == "" {
            qbe_local_fn_can_scalar_inline(g, name, finfo)
          } else {
            qbe_xpkg_fn_can_scalar_inline(g, target_pkg, name, finfo)
          }
          match inl_fd_opt {
            Some(inl_fd) => {
              let inl_body = qbe_fn_body(g, inl_fd.body)
              if !qbe_fn_body_all_returns_are_pod_struct_lits(inl_body) {
                return false
              }
              let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
              if qbe_has_any_default(call_res.from_default) {
                return false
              }
              let norm_args = call_res.args
              if norm_args.length() != inl_fd.params.length() ||
                norm_args.length() != finfo.param_tys.length() {
                return false
              }
              let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let wbs : Array[QbeMutWb] = []
              let order = qbe_call_eval_order(finfo.decl.params, 0, args, norm_args.length())
              qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
              let guards = qbe_arg_guards(g, norm_args, order)
              let mut oi = 0
              while oi < order.length() {
                let i = order[oi]
                match norm_args[i] {
                  EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                  _ => ()
                }
                let aa = qbe_emit_call_arg(
                  g,
                  finfo.decl.params,
                  i,
                  norm_args[i],
                  Some(finfo.param_tys[i]),
                  can_borrow,
                  wbs,
                  norm_args,
                )
                arg_vals[i] = aa.qv.reg
                arg_tys[i] = aa.qv.ty
                arg_borrowed[i] = aa.borrowed
                qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(finfo.decl.params, i, norm_args[i]), guards.exits[oi])
                oi = oi + 1
              }
              qbe_release_guards(g, guards)
              let stack_key = if target_pkg != "" {
                target_pkg + "::" + name
              } else {
                name
              }
              let stk = qbe_alloc_stack_buf(g, pod_bytes)
              qbe_inline_body_into_pod_buf(
                g,
                target_pkg,
                stack_key,
                inl_fd,
                finfo,
                sinfo,
                final_ty,
                stk,
                arg_vals,
                arg_tys,
                arg_borrowed,
              )
              if !g.block_term {
                qbe_clear_shadowed_local_meta(g, bname)
                let loc = qbe_define_local(g, bname, final_ty, false)
                qbe_emit(g, "storel " + stk + ", " + loc.slot)
              }
              true
            }
            None => false
          }
        }
        None => false
      }
    }
    ECall(EPath(qual, mem, _), args, sp) => {
      let mut target_finfo : Option[FnInfo] = None
      let mut target_pkg = ""
      let mut key = qual + "::" + mem
      if has_qual_sep(qual) {
        let qp = split_qual_name(qual)
        match qbe_resolve_pkg_in_scope(g, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.methods.get(qp.name + "::" + mem) {
              Some(mi) => {
                target_finfo = Some(qualify_fn_info(ipkg, mi))
                target_pkg = ipkg.name
                key = qp.name + "::" + mem
              }
              None => ()
            }
          None => ()
        }
      }
      match target_finfo {
        None =>
          match qbe_resolve_pkg_in_scope(g, qual) {
            Some(ipkg) =>
              match ipkg.tc.fns.get(mem) {
                Some(fi) => {
                  target_finfo = Some(qualify_fn_info(ipkg, fi))
                  target_pkg = ipkg.name
                  key = mem
                }
                None => ()
              }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          if g.mono_pkg != "" {
            match lookup_imported_pkg_transitive(g.tc, g.mono_pkg) {
              Some(ipkg) =>
                match ipkg.tc.methods.get(qual + "::" + mem) {
                  Some(mi) => {
                    target_finfo = Some(qualify_fn_info(ipkg, mi))
                    target_pkg = ipkg.name
                  }
                  None => ()
                }
              None => ()
            }
          }
        Some(_) => ()
      }
      match target_finfo {
        None =>
          match qbe_lookup_method_info(g, qual, mem) {
            Some(minfo) => {
              target_finfo = Some(minfo)
              let qpm = split_qual_name(qual)
              if qpm.prefix != "" {
                target_pkg = qpm.prefix
              } else if g.mono_pkg != "" {
                target_pkg = g.mono_pkg
              }
            }
            None => ()
          }
        Some(_) => ()
      }
      match target_finfo {
        Some(minfo) => {
          let inl_fd_opt : Option[FnDecl] = if target_pkg == "" &&
            g.mono_pkg == "" &&
            !has_qual_sep(qual) {
            qbe_local_fn_can_scalar_inline(g, key, minfo)
          } else if target_pkg != "" {
            qbe_xpkg_fn_can_scalar_inline(g, target_pkg, key, minfo)
          } else {
            None
          }
          match inl_fd_opt {
            Some(inl_fd) => {
              let inl_body = qbe_fn_body(g, inl_fd.body)
              if !qbe_fn_body_all_returns_are_pod_struct_lits(inl_body) {
                return false
              }
              let call_res = resolve_call_args_qbe_full(minfo.decl.params, 0, args, sp)
              if qbe_has_any_default(call_res.from_default) {
                return false
              }
              let norm_args = call_res.args
              if norm_args.length() != inl_fd.params.length() ||
                norm_args.length() != minfo.param_tys.length() {
                return false
              }
              let can_borrow = !qbe_args_may_mutate_locals(g, norm_args)
              let arg_vals : Array[String] = []
              let arg_tys : Array[Ty] = []
              let arg_borrowed : Array[Bool] = []
              let wbs : Array[QbeMutWb] = []
              let order = qbe_call_eval_order(minfo.decl.params, 0, args, norm_args.length())
              qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length())
              let guards = qbe_arg_guards(g, norm_args, order)
              let mut oi = 0
              while oi < order.length() {
                let i = order[oi]
                match norm_args[i] {
                  EIdent(aname, _) => qbe_invalidate_len_aliases_for(g, aname)
                  _ => ()
                }
                let aa = qbe_emit_call_arg(
                  g,
                  minfo.decl.params,
                  i,
                  norm_args[i],
                  Some(minfo.param_tys[i]),
                  can_borrow,
                  wbs,
                  norm_args,
                )
                arg_vals[i] = aa.qv.reg
                arg_tys[i] = aa.qv.ty
                arg_borrowed[i] = aa.borrowed
                qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i, norm_args[i]), guards.exits[oi])
                oi = oi + 1
              }
              qbe_release_guards(g, guards)
              let stack_key = if target_pkg != "" {
                target_pkg + "::" + key
              } else {
                key
              }
              let stk = qbe_alloc_stack_buf(g, pod_bytes)
              qbe_inline_body_into_pod_buf(
                g,
                target_pkg,
                stack_key,
                inl_fd,
                minfo,
                sinfo,
                final_ty,
                stk,
                arg_vals,
                arg_tys,
                arg_borrowed,
              )
              if !g.block_term {
                qbe_clear_shadowed_local_meta(g, bname)
                let loc = qbe_define_local(g, bname, final_ty, false)
                qbe_emit(g, "storel " + stk + ", " + loc.slot)
              }
              true
            }
            None => false
          }
        }
        None => false
      }
    }
    EMethodCall(recv, method_name, args, sp) => {
      if qbe_has_expected_trait(g, sp) {
        return false
      }
      match qbe_probe_expr_ty(g, recv) {
        Some(TStruct(sname, _)) =>
          match qbe_lookup_method_info(g, sname, method_name) {
            Some(minfo) => {
              let qp_m = split_qual_name(sname)
              let mpkg = if qp_m.prefix != "" { qp_m.prefix } else { g.mono_pkg }
              let key = sname + "::" + method_name
              let inl_fd_opt : Option[FnDecl] = if mpkg == "" && !has_qual_sep(sname) {
                qbe_local_fn_can_scalar_inline(g, key, minfo)
              } else if mpkg != "" {
                qbe_xpkg_fn_can_scalar_inline(g, mpkg, key, minfo)
              } else {
                None
              }
              match inl_fd_opt {
                Some(inl_fd) => {
                  let inl_body = qbe_fn_body(g, inl_fd.body)
                  if !qbe_fn_body_all_returns_are_pod_struct_lits(inl_body) {
                    return false
                  }
                  let call_res = resolve_call_args_qbe_full(minfo.decl.params, 1, args, sp)
                  if qbe_has_any_default(call_res.from_default) {
                    return false
                  }
                  let norm_args = call_res.args
                  if norm_args.length() + 1 != inl_fd.params.length() ||
                    norm_args.length() + 1 != minfo.param_tys.length() {
                    return false
                  }
                  let recv_pure = !qbe_expr_has_assign(recv) && !qbe_args_have_assign(norm_args)
                  let ra = qbe_emit_arg_maybe_borrow(g, recv, None, recv_pure)
                  let arg_vals : Array[String] = [ra.qv.reg]
                  let arg_tys : Array[Ty] = [ra.qv.ty]
                  let arg_borrowed : Array[Bool] = [ra.borrowed]
                  let wbs : Array[QbeMutWb] = []
                  let order = qbe_call_eval_order(minfo.decl.params, 1, args, norm_args.length())
                  qbe_fill_arg_slots(arg_vals, arg_tys, arg_borrowed, norm_args.length() + 1)
                  let guards = qbe_arg_guards(g, norm_args, order)
                  qbe_guard_val(g, guards, QbeArgVal::{ qv: qval(arg_vals[0], arg_tys[0]), borrowed: arg_borrowed[0] }, false, qbe_guards_exit_before_order(g, guards, norm_args, order))
                  let mut oi = 0
                  while oi < order.length() {
                    let i = order[oi]
                    let p_idx = i + 1
                    let aa = qbe_emit_call_arg(
                      g,
                      minfo.decl.params,
                      p_idx,
                      norm_args[i],
                      Some(minfo.param_tys[p_idx]),
                      recv_pure,
                      wbs,
                      norm_args,
                    )
                    arg_vals[i + 1] = aa.qv.reg
                    arg_tys[i + 1] = aa.qv.ty
                    arg_borrowed[i + 1] = aa.borrowed
                    qbe_guard_val(g, guards, aa, qbe_is_mut_slot_arg(minfo.decl.params, i + 1, norm_args[i]), guards.exits[oi])
                    oi = oi + 1
                  }
                  qbe_release_guards(g, guards)
                  let stack_key = if mpkg != "" { mpkg + "::" + key } else { key }
                  let stk = qbe_alloc_stack_buf(g, pod_bytes)
                  qbe_inline_body_into_pod_buf(
                    g,
                    mpkg,
                    stack_key,
                    inl_fd,
                    minfo,
                    sinfo,
                    final_ty,
                    stk,
                    arg_vals,
                    arg_tys,
                    arg_borrowed,
                  )
                  if !g.block_term {
                    qbe_clear_shadowed_local_meta(g, bname)
                    let loc = qbe_define_local(g, bname, final_ty, false)
                    qbe_emit(g, "storel " + stk + ", " + loc.slot)
                  }
                  true
                }
                None => false
              }
            }
            None => false
          }
        _ => false
      }
    }
    _ => false
  }
}

///|
/// Wave J2 Layer 1: borrow an arbitrary-depth immutable struct field chain
/// `let x = root.f1.f2...` as `owned = false` when all soundness invariants hold:
/// - `x` is non-`mut`, non-`is_cell`, `x != "_"`, `x != root`;
/// - `root` is non-`is_cell`, non-`mut`, non-`ref_slot`, and chases to a known
///   non-array, non-`mut` owner slot (owned local or borrowed parameter);
/// - neither `root` nor its chased owner is reassigned or passed via `EMutArg`
///   / `mut self` in `stmts[idx + 1..]` (stopping on same-block shadowing);
/// - every field on the chain is non-`mut` on a concrete `TStruct`, and the
///   final type is an RC heap object (not `TParam`, `TDynTrait`, scalar, or
///   flat inline POD struct).
/// Returns the chased `owner_slot` (non-empty) on success so the caller pins it
/// in `g.pinned_slots`; returns `""` to conservatively fall back to owned.
fn qbe_try_emit_borrowed_field_let(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
) -> String {
  if (g.j2_disable_mask & 1) != 0 {
    return ""
  }
  match stmts[idx] {
    SLet(bname, is_mut, ty_expr, init, _) => {
      if is_mut || bname == "_" || g.boxed_mut_vars.contains(bname) {
        return ""
      }
      let fields : Array[String] = []
      let root_name = qbe_extract_field_chain(init, fields)
      if root_name == "" || fields.length() == 0 || bname == root_name {
        return ""
      }
      if fields.length() == 1 && g.promoted_fields.contains(root_name + "." + fields[0]) {
        return ""
      }
      let rloc = match qbe_lookup_local(g, root_name) {
        Some(l) => l
        None => return ""
      }
      if rloc.is_cell || rloc.ref_slot != "" || g.mut_local_slots.contains(rloc.slot) {
        return ""
      }
      let owner_slot = if rloc.owned {
        rloc.slot
      } else {
        match g.borrow_owner_slot.get(rloc.slot) {
          Some(os) => os
          None => return ""
        }
      }
      let owner_name = if rloc.owned {
        root_name
      } else {
        match g.borrow_owner_name.get(rloc.slot) {
          Some(on) => on
          None => return ""
        }
      }
      if g.mut_local_slots.contains(owner_slot) {
        return ""
      }
      if qbe_stmts_assigns_ident_from(stmts, idx + 1, root_name) {
        return ""
      }
      if owner_name != root_name && qbe_stmts_assigns_ident_from(stmts, idx + 1, owner_name) {
        return ""
      }
      let mut cur_ty = subst_ty(rloc.ty, g.cur_type_subst)
      let offsets : Array[Int] = []
      let mut k = 0
      while k < fields.length() {
        let fname = fields[k]
        match cur_ty {
          TStruct(sname, sargs) =>
            match qbe_lookup_struct_info(g, sname) {
              Some(sinfo) => {
                let subst = make_subst(sinfo.decl.type_params, sargs)
                let mut fi = 0
                let mut found = false
                while fi < sinfo.field_names.length() {
                  if sinfo.field_names[fi] == fname {
                    if sinfo.field_muts[fi] {
                      return ""
                    }
                    offsets.push(fi * 8)
                    cur_ty = subst_ty(
                      subst_ty(sinfo.field_tys[fi], subst),
                      g.cur_type_subst,
                    )
                    found = true
                    break
                  }
                  fi = fi + 1
                }
                if !found {
                  return ""
                }
              }
              None => return ""
            }
          _ => return ""
        }
        k = k + 1
      }
      match cur_ty {
        TParam(_) | TDynTrait(_) => return ""
        _ => ()
      }
      if !qbe_is_obj_ty(g, cur_ty) || qbe_flat_pod_stride(g, cur_ty) > 0 {
        return ""
      }
      let final_ty = match ty_expr {
        TyMissing(_) => cur_ty
        _ => subst_ty(qbe_resolve_type(g, ty_expr), g.cur_type_subst)
      }
      match final_ty {
        TParam(_) | TDynTrait(_) => return ""
        _ => ()
      }
      if !qbe_is_obj_ty(g, final_ty) || qbe_flat_pod_stride(g, final_ty) > 0 {
        return ""
      }
      let mut fv = ""
      if fields.length() == 1 {
        let fkey = root_name + "." + fields[0]
        match g.hoisted_fields.get(fkey) {
          Some(hv) => fv = hv.reg
          None =>
            match g.block_immut_fields.get(fkey) {
              Some(bv) => fv = bv.reg
              None => ()
            }
        }
      }
      if fv == "" {
        let mut cur_reg = qbe_tmp(g)
        qbe_emit(g, cur_reg + " =l loadl " + rloc.slot)
        let mut oi = 0
        while oi < offsets.length() {
          let fp = qbe_tmp(g)
          qbe_emit(g, fp + " =l add " + cur_reg + ", " + offsets[oi].to_string())
          if oi + 1 < offsets.length() {
            let nxt = qbe_tmp(g)
            qbe_emit(g, nxt + " =l loadl " + fp)
            cur_reg = nxt
          } else {
            cur_reg = qbe_load_heap_slot(g, fp, cur_ty)
          }
          oi = oi + 1
        }
        fv = cur_reg
      }
      let loc = qbe_define_local(g, bname, final_ty, false)
      qbe_store_local_slot(g, qbe_coerce_val(g, qval(fv, cur_ty), final_ty), loc.slot, final_ty)
      g.borrow_owner_slot.set(loc.slot, owner_slot)
      g.borrow_owner_name.set(loc.slot, owner_name)
      owner_slot
    }
    _ => ""
  }
}

///|
fn qbe_try_emit_borrowed_arr_elem_let(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
) -> Bool {
  match stmts[idx] {
    SLet(bname, is_mut, ty_expr, EIndex(EIdent(aname, _), idx_expr, _), _) => {
      if is_mut || bname == "_" || bname == aname || qbe_expr_has_assign(idx_expr) {
        return false
      }
      match qbe_lookup_local(g, aname) {
        Some(aloc) =>
          if aloc.is_cell {
            false
          } else {
          match aloc.ty {
            TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
              if !qbe_is_obj_ty(g, elem) {
                return false
              }
              let flat_stride = qbe_flat_pod_stride(g, elem)
              if !qbe_arr_is_stable_stmts(stmts, idx + 1, aname, false) {
                return false
              }
              if !g.unfrozen_local_arrs.contains(aname) {
                // P74-C: `aname` may be aliased; while `bname` is live (up to `last_use`),
                // reject any call (could realloc/shrink/overwrite via alias) or any other
                // array element assignment before `last_use` (could overwrite & rc_dec slot).
                let mut last_use = idx
                let mut uj = idx + 1
                while uj < stmts.length() {
                  if qbe_stmt_mentions_ident(stmts[uj], bname) {
                    last_use = uj
                  }
                  match stmts[uj] {
                    SLet(rn, _, _, _, _) => if rn == bname { break }
                    SLetTuple(rns, _, _, _) => {
                      let mut rbi = 0
                      let mut shadowed = false
                      while rbi < rns.length() {
                        if rns[rbi] == bname {
                          shadowed = true
                        }
                        rbi = rbi + 1
                      }
                      if shadowed {
                        break
                      }
                    }
                    _ => ()
                  }
                  uj = uj + 1
                }
                let cur_hints = QbeProbeHints::{ names: [bname], tys: [elem] }
                let mut cj = idx + 1
                while cj <= last_use {
                  if !qbe_no_aliasing_calls_stmt(g, stmts[cj], aname, cur_hints) {
                    return false
                  }
                  qbe_hints_advance_stmt(g, stmts[cj], cur_hints)
                  if cj < last_use {
                    if qbe_stmt_has_other_arr_elem_assign(stmts[cj]) {
                      return false
                    }
                  } else {
                    let last_assign_ok = match stmts[cj] {
                      SAssign(EIndex(arr_e, idx_e, _), rhs_e, _) =>
                        !qbe_expr_has_other_arr_elem_assign(arr_e) &&
                        !qbe_expr_has_other_arr_elem_assign(idx_e) &&
                        !qbe_expr_has_other_arr_elem_assign(rhs_e)
                      SCompoundAssign(_, EIndex(arr_e, idx_e, _), rhs_e, _) =>
                        !qbe_expr_has_other_arr_elem_assign(arr_e) &&
                        !qbe_expr_has_other_arr_elem_assign(idx_e) &&
                        !qbe_expr_has_other_arr_elem_assign(rhs_e)
                      _ => !qbe_stmt_has_other_arr_elem_assign(stmts[cj])
                    }
                    if !last_assign_ok {
                      return false
                    }
                  }
                  cj = cj + 1
                }
              }
              if flat_stride > 0 {
                if !qbe_ident_is_flat_field_only_stmts(stmts, idx + 1, bname) {
                  return false
                }
              } else if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                return false
              }
              let final_ty = match ty_expr {
                TyMissing(_) => elem
                _ => qbe_resolve_type(g, ty_expr)
              }
              match final_ty {
                TDynTrait(_) => return false
                _ => ()
              }
              let arr_reg = if g.hoisted_arr_len.contains(aname) &&
                g.hoisted_arr_dp.contains(aname) {
                "0"
              } else {
                let r = qbe_tmp(g)
                qbe_emit(g, r + " =l loadl " + aloc.slot)
                r
              }
              let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
              let il = qbe_as_l(g, iv)
              let bce_safe = qbe_bce_expr_is_safe(g, aname, idx_expr)
              if !bce_safe {
                let alen = match g.hoisted_arr_len.get(aname) {
                  Some(hlen) => hlen
                  None => {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =l loadl " + arr_reg)
                    t
                  }
                }
                let oob = qbe_tmp(g)
                let l_oob = qbe_lbl(g, qbe_arr_oob_lbl_prefix(g, elem))
                let l_ok = qbe_lbl(g, "arr_ok")
                qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                qbe_emit_lbl(g, l_oob)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok)
              }
              let dp = match g.hoisted_arr_dp.get(aname) {
                Some(hdp) => hdp
                None => {
                  let dp_p = qbe_tmp(g)
                  let t = qbe_tmp(g)
                  qbe_emit(g, dp_p + " =l add " + arr_reg + ", 24")
                  qbe_emit(g, t + " =l loadl " + dp_p)
                  t
                }
              }
              let r = if flat_stride > 0 {
                qbe_emit_arr_elem_addr(g, dp, il, flat_stride)
              } else {
                let off = qbe_tmp(g)
                let ep = qbe_tmp(g)
                qbe_emit(g, off + " =l shl " + il + ", 3")
                qbe_emit(g, ep + " =l add " + dp + ", " + off)
                qbe_load_heap_slot(g, ep, elem)
              }
              let loc = qbe_define_local(g, bname, final_ty, false)
              qbe_store_local_slot(g, qbe_coerce_val(g, qval(r, elem), final_ty), loc.slot, final_ty)
              true
            }
            _ => false
          }
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EIndex(EField(EIdent(base, _), fname, _), idx_expr, _), _) => {
      if is_mut || bname == "_" || bname == base || qbe_expr_has_assign(idx_expr) {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          if bloc.is_cell {
            return false
          } else {
          match bloc.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      match fty {
                        TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                          if !qbe_is_obj_ty(g, elem) {
                            return false
                          }
                          let flat_stride = qbe_flat_pod_stride(g, elem)
                          if !qbe_field_base_is_stable_stmts(stmts, idx + 1, base, fname, false) {
                            return false
                          }
                          if qbe_stmts_has_any_mut_call(g, stmts, idx + 1) {
                            return false
                          }
                          if flat_stride > 0 {
                            if !qbe_ident_is_flat_field_only_stmts(stmts, idx + 1, bname) {
                              return false
                            }
                          } else if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                            return false
                          }
                          let final_ty = match ty_expr {
                            TyMissing(_) => elem
                            _ => qbe_resolve_type(g, ty_expr)
                          }
                          match final_ty {
                            TDynTrait(_) => return false
                            _ => ()
                          }
                          let mut arr_reg = ""
                          if !sinfo.field_muts[fi] {
                            let fkey = base + "." + fname
                            match g.hoisted_fields.get(fkey) {
                              Some(hv) => arr_reg = hv.reg
                              None =>
                                match g.block_immut_fields.get(fkey) {
                                  Some(bv) => arr_reg = bv.reg
                                  None => ()
                                }
                            }
                          }
                          if arr_reg == "" {
                            let obj_p = qbe_tmp(g)
                            let fp = qbe_tmp(g)
                            let fv = qbe_tmp(g)
                            qbe_emit(g, obj_p + " =l loadl " + bloc.slot)
                            qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                            qbe_emit(g, fv + " =l loadl " + fp)
                            arr_reg = fv
                          }
                          let iv = qbe_emit_expr(g, idx_expr, Some(TInt))
                          let il = qbe_as_l(g, iv)
                          let alen = qbe_tmp(g)
                          qbe_emit(g, alen + " =l loadl " + arr_reg)
                          let oob = qbe_tmp(g)
                          let l_oob = qbe_lbl(g, qbe_arr_oob_lbl_prefix(g, elem))
                          let l_ok = qbe_lbl(g, "arr_ok")
                          qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                          qbe_emit_lbl(g, l_oob)
                          qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                          qbe_emit_term(g, "hlt")
                          qbe_emit_lbl(g, l_ok)
                          let dp_p = qbe_tmp(g)
                          let dp = qbe_tmp(g)
                          qbe_emit(g, dp_p + " =l add " + arr_reg + ", 24")
                          qbe_emit(g, dp + " =l loadl " + dp_p)
                          let r = if flat_stride > 0 {
                            qbe_emit_arr_elem_addr(g, dp, il, flat_stride)
                          } else {
                            let off = qbe_tmp(g)
                            let ep = qbe_tmp(g)
                            qbe_emit(g, off + " =l shl " + il + ", 3")
                            qbe_emit(g, ep + " =l add " + dp + ", " + off)
                            qbe_load_heap_slot(g, ep, elem)
                          }
                          let loc = qbe_define_local(g, bname, final_ty, false)
                          qbe_store_local_slot(g, qbe_coerce_val(g, qval(r, elem), final_ty), loc.slot, final_ty)
                          return true
                        }
                        _ => return false
                      }
                    }
                    fi = fi + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EField(EIdent(base, _), fname, _), _) => {
      if is_mut || bname == "_" || bname == base {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          if bloc.is_cell {
            false
          } else {
          match bloc.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      if !qbe_is_obj_ty(g, fty) {
                        return false
                      }
                      let final_ty = match ty_expr {
                        TyMissing(_) => fty
                        _ => qbe_resolve_type(g, ty_expr)
                      }
                      match final_ty {
                        TDynTrait(_) => return false
                        _ => ()
                      }
                      if sinfo.field_muts[fi] {
                        if !qbe_field_base_is_stable_stmts(stmts, idx + 1, base, fname, true) ||
                          qbe_stmts_has_any_mut_call(g, stmts, idx + 1) {
                          return false
                        }
                      } else {
                        if (g.j2_disable_mask & 1) == 0 &&
                          (bloc.ref_slot != "" || g.mut_local_slots.contains(bloc.slot)) {
                          return false
                        }
                        if qbe_stmts_assigns_ident_from(stmts, idx + 1, base) {
                          return false
                        }
                      }
                      if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
                        return false
                      }
                      let mut fv = ""
                      if !sinfo.field_muts[fi] {
                        let fkey = base + "." + fname
                        match g.hoisted_fields.get(fkey) {
                          Some(hv) => fv = hv.reg
                          None =>
                            match g.block_immut_fields.get(fkey) {
                              Some(bv) => fv = bv.reg
                              None => ()
                            }
                        }
                      }
                      if fv == "" {
                        let obj_p = qbe_tmp(g)
                        let fp = qbe_tmp(g)
                        qbe_emit(g, obj_p + " =l loadl " + bloc.slot)
                        qbe_emit(g, fp + " =l add " + obj_p + ", " + (fi * 8).to_string())
                        fv = qbe_load_heap_slot(g, fp, fty)
                      }
                      let loc = qbe_define_local(g, bname, final_ty, false)
                      qbe_store_local_slot(g, qbe_coerce_val(g, qval(fv, fty), final_ty), loc.slot, final_ty)
                      return true
                    }
                    fi = fi + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
          }
        None => false
      }
    }
    SLet(bname, is_mut, ty_expr, EField(EField(EIdent(base, _), f1, _), f2, _), _) => {
      if (g.j2_disable_mask & 1) == 0 {
        return false
      }
      if is_mut || bname == "_" || bname == base {
        return false
      }
      if qbe_stmts_assigns_ident_from(stmts, idx + 1, base) {
        return false
      }
      if !qbe_ident_is_borrow_safe_stmts(g, stmts, idx + 1, bname) {
        return false
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          if bloc.is_cell {
            return false
          } else {
            ()
          }
        None => ()
      }
      match qbe_lookup_local(g, base) {
        Some(bloc) =>
          match bloc.ty {
            TStruct(s1, a1) =>
              match qbe_lookup_struct_info(g, s1) {
                Some(si1) => {
                  let sub1 = make_subst(si1.decl.type_params, a1)
                  let mut fi1 = 0
                  while fi1 < si1.field_names.length() {
                    if si1.field_names[fi1] == f1 {
                      if si1.field_muts[fi1] {
                        return false
                      }
                      let t1 = subst_ty(si1.field_tys[fi1], sub1)
                      match t1 {
                        TStruct(s2, a2) =>
                          match qbe_lookup_struct_info(g, s2) {
                            Some(si2) => {
                              let sub2 = make_subst(si2.decl.type_params, a2)
                              let mut fi2 = 0
                              while fi2 < si2.field_names.length() {
                                if si2.field_names[fi2] == f2 {
                                  if si2.field_muts[fi2] {
                                    return false
                                  }
                                  let fty = subst_ty(si2.field_tys[fi2], sub2)
                                  if !qbe_is_obj_ty(g, fty) {
                                    return false
                                  }
                                  let final_ty = match ty_expr {
                                    TyMissing(_) => fty
                                    _ => qbe_resolve_type(g, ty_expr)
                                  }
                                  match final_ty {
                                    TDynTrait(_) => return false
                                    _ => ()
                                  }
                                  let p0 = qbe_tmp(g)
                                  let fp1 = qbe_tmp(g)
                                  let p1 = qbe_tmp(g)
                                  let fp2 = qbe_tmp(g)
                                  qbe_emit(g, p0 + " =l loadl " + bloc.slot)
                                  qbe_emit(g, fp1 + " =l add " + p0 + ", " + (fi1 * 8).to_string())
                                  qbe_emit(g, p1 + " =l loadl " + fp1)
                                  qbe_emit(g, fp2 + " =l add " + p1 + ", " + (fi2 * 8).to_string())
                                  let fv = qbe_load_heap_slot(g, fp2, fty)
                                  let loc = qbe_define_local(g, bname, final_ty, false)
                                  qbe_store_local_slot(g, qbe_coerce_val(g, qval(fv, fty), final_ty), loc.slot, final_ty)
                                  return true
                                }
                                fi2 = fi2 + 1
                              }
                              return false
                            }
                            None => return false
                          }
                        _ => return false
                      }
                    }
                    fi1 = fi1 + 1
                  }
                  false
                }
                None => false
              }
            _ => false
          }
        None => false
      }
    }
    _ => false
  }
}

///|
// Strength-reduce the two indices of an integer array exchange after both
// ranges have been checked. The slow loop retains its source evaluation order.
fn qbe_emit_guarded_exchange(
  g : QbeGen, body : Array[Stmt], iv : String, bound : String,
  iv_slot : String, start : String, limit : String, final_iv : String,
  guards : Array[QbeBceGuard], entry : String, exit_lbl : String,
) -> Bool {
  if !g.release || g.target_name != "amd64_sysv" || body.length() != 4 || bound == "" {
    return false
  }
  let (tmp, arr) = match body[0] {
    SLet(t, false, TyMissing(_), EIndex(EIdent(a, _), EIdent(i, _), _), _) =>
      if i == iv { (t, a) } else { return false }
    _ => return false
  }
  let axis = match body[1] {
    SAssign(EIndex(EIdent(a, _), EIdent(i, _), _),
      EIndex(EIdent(b, _), EBinary("-", EIdent(k, _), EIdent(j, _), _), _), _) =>
      if a == arr && b == arr && i == iv && j == iv { k } else { return false }
    _ => return false
  }
  match body[2] {
    SAssign(EIndex(EIdent(a, _), EBinary("-", EIdent(k, _), EIdent(i, _), _), _),
      EIdent(t, _), _) =>
      if a != arr || k != axis || i != iv || t != tmp { return false }
    _ => return false
  }
  if tmp == "_" || tmp == arr || tmp == axis || tmp == iv || tmp == bound ||
    axis == iv || g.boxed_mut_vars.contains(tmp) { return false }
  let axis_slot = match (qbe_lookup_local(g, arr), qbe_lookup_local(g, axis),
      qbe_lookup_local(g, iv), qbe_lookup_local(g, bound)) {
    (Some(a), Some(k), Some(i), Some(b)) => {
      if a.is_cell || k.is_cell || i.is_cell || b.is_cell ||
        a.ref_slot != "" || k.ref_slot != "" || i.ref_slot != "" || b.ref_slot != "" {
        return false
      }
      match (a.ty, k.ty, i.ty, b.ty) {
        (TArray(TInt), TInt, TInt, TInt) => k.slot
        _ => return false
      }
    }
    _ => return false
  }
  let dp = match g.hoisted_arr_dp.get(arr) {
    Some(reg) => reg
    None => return false
  }
  let mut left_safe = false
  let mut right_safe = false
  for gd in guards {
    if gd.arr == arr {
      if gd.kind == 0 { left_safe = true }
      if gd.kind == 2 && gd.vname == axis { right_safe = true }
    }
  }
  if !left_safe || !right_safe { return false }
  let kw = qbe_tmp(g)
  let kl = qbe_tmp(g)
  let reverse_start = qbe_tmp(g)
  qbe_emit(g, kw + " =w loadsw " + axis_slot)
  qbe_emit(g, kl + " =l extsw " + kw)
  qbe_emit(g, reverse_start + " =l sub " + kl + ", " + start)
  let first = qbe_emit_arr_ep_ty(g, dp, start, TInt)
  let last = qbe_emit_arr_ep_ty(g, dp, reverse_start, TInt)
  let stop = qbe_emit_arr_ep_ty(g, dp, limit, TInt)
  let loop_lbl = qbe_lbl(g, "exchange")
  let done_lbl = qbe_lbl(g, "exchange_done")
  let left = qbe_tmp(g)
  let right = qbe_tmp(g)
  let next_left = qbe_tmp(g)
  let next_right = qbe_tmp(g)
  qbe_emit_term(g, "jmp " + loop_lbl)
  qbe_emit_lbl(g, loop_lbl)
  qbe_emit(g, left + " =l phi " + entry + " " + first + ", " + loop_lbl + " " + next_left)
  qbe_emit(g, right + " =l phi " + entry + " " + last + ", " + loop_lbl + " " + next_right)
  let x = qbe_load_arr_elem(g, left, TInt)
  let y = qbe_load_arr_elem(g, right, TInt)
  qbe_store_arr_elem(g, y, left, TInt)
  qbe_store_arr_elem(g, x, right, TInt)
  qbe_emit(g, next_left + " =l add " + left + ", 4")
  qbe_emit(g, next_right + " =l sub " + right + ", 4")
  let more = qbe_tmp(g)
  qbe_emit(g, more + " =w cnel " + next_left + ", " + stop)
  qbe_emit_term(g, "jnz " + more + ", " + loop_lbl + ", " + done_lbl)
  qbe_emit_lbl(g, done_lbl)
  qbe_emit(g, "storew " + final_iv + ", " + iv_slot)
  qbe_emit_term(g, "jmp " + exit_lbl)
  true
}

///|
fn qbe_try_emit_while_bce_versioned(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() == 0 || body.length() > 16 || qbe_stmts_has_nested_loop(body) {
    return false
  }
  let mut iv = ""
  let mut bound_is_lit = false
  let mut bound_lit = 0L
  let mut bound_name = ""
  let mut bound_hoisted_reg = ""
  let mut extra_cond : Option[Expr] = None
  let lt_cond = match cond {
    EBinary("&&", lhs, rhs, _) => {
      extra_cond = Some(rhs)
      lhs
    }
    _ => cond
  }
  match lt_cond {
    EBinary("<", EIdent(iv_n, _), bound_e, _) => {
      iv = iv_n
      match bound_e {
        EInt(raw, _) => {
          bound_is_lit = true
          bound_lit = qbe_parse_int64_lit(raw).to_int().to_int64()
        }
        EIdent(bn, _) => bound_name = bn
        EField(EIdent(bv, _), bf, _) =>
          match g.hoisted_fields.get(bv + "." + bf) {
            Some(hv) =>
              if qbe_is_int32_ty(hv.ty) {
                bound_hoisted_reg = hv.reg
              } else {
                return false
              }
            None => return false
          }
        _ => return false
      }
    }
    _ => return false
  }
  let iv_slot = match qbe_lookup_local(g, iv) {
    Some(iloc) =>
      if !iloc.is_cell && qbe_is_int32_ty(iloc.ty) {
        iloc.slot
      } else {
        return false
      }
    None => return false
  }
  let mut step_name = ""
  let mut step_slot = ""
  let last_stmt = body[body.length() - 1]
  if !qbe_stmt_is_inc_by_one(last_stmt, iv) {
    step_name = match last_stmt {
      SAssign(EIdent(lhs_n, _), EBinary("+", EIdent(rhs_n, _), EIdent(sn, _), _), _) =>
        if lhs_n == iv && rhs_n == iv {
          sn
        } else if lhs_n == iv && sn == iv {
          rhs_n
        } else {
          ""
        }
      SCompoundAssign("+", EIdent(lhs_n, _), EIdent(sn, _), _) =>
        if lhs_n == iv { sn } else { "" }
      _ => ""
    }
    if step_name == "" ||
      step_name == iv ||
      qbe_stmts_assigns_ident(body, step_name) ||
      qbe_stmts_rebinds_ident(body, step_name) {
      return false
    }
    match extra_cond {
      Some(ec) =>
        if qbe_expr_assigns_ident(ec, step_name) || qbe_expr_rebinds_ident(ec, step_name) {
          return false
        }
      None => ()
    }
    match qbe_lookup_local(g, step_name) {
      Some(sloc) =>
        if !sloc.is_cell && qbe_is_int32_ty(sloc.ty) {
          step_slot = sloc.slot
        } else {
          return false
        }
      None => return false
    }
  }
  let mut bi = 0
  while bi < body.length() - 1 {
    if qbe_stmt_assigns_ident(body[bi], iv) || qbe_stmt_rebinds_ident(body[bi], iv) {
      return false
    }
    bi = bi + 1
  }
  match extra_cond {
    Some(ec) =>
      if qbe_expr_assigns_ident(ec, iv) || qbe_expr_rebinds_ident(ec, iv) {
        return false
      }
    None => ()
  }
  let mut bound_slot = ""
  if !bound_is_lit && bound_hoisted_reg == "" {
    if bound_name == iv ||
      qbe_stmts_assigns_ident(body, bound_name) ||
      qbe_stmts_rebinds_ident(body, bound_name) {
      return false
    }
    match extra_cond {
      Some(ec) =>
        if qbe_expr_assigns_ident(ec, bound_name) || qbe_expr_rebinds_ident(ec, bound_name) {
          return false
        }
      None => ()
    }
    match qbe_lookup_local(g, bound_name) {
      Some(bloc) =>
        if !bloc.is_cell && qbe_is_int32_ty(bloc.ty) {
          bound_slot = bloc.slot
        } else {
          return false
        }
      None =>
        if g.mono_pkg == "" {
          match g.const_int_vals.get(bound_name) {
            Some(cv) => {
              bound_is_lit = true
              bound_lit = cv.to_int64()
            }
            None => return false
          }
        } else {
          return false
        }
    }
  }
  let guards : Array[QbeBceGuard] = []
  let seen : Map[String, Bool] = Map([])
  match extra_cond {
    Some(ec) => qbe_collect_bce_guards_expr(g, body, iv, ec, guards, seen)
    None => ()
  }
  qbe_collect_bce_guards_stmts(g, body, iv, body, guards, seen)
  let push_guards : Array[String] = []
  if step_slot == "" && !qbe_stmts_has_cf(body, false, true, false) {
    match extra_cond {
      None => {
        let pcands : Array[String] = []
        let pseen : Map[String, Bool] = Map([])
        qbe_collect_push_arrs_stmts(body, pcands, pseen)
        let mut pi = 0
        while pi < pcands.length() {
          let aname = pcands[pi]
          if g.promoted_push_len.contains(aname) &&
            qbe_count_arr_push_stmts(body, aname) == 1 {
            push_guards.push(aname)
          }
          pi = pi + 1
        }
      }
      Some(_) => ()
    }
  }
  if guards.length() == 0 && push_guards.length() == 0 {
    return false
  }

  let l_vchk = qbe_lbl(g, "wh_vchk")
  let l_fentry = qbe_lbl(g, "wh_fe")
  let l_fast = qbe_lbl(g, "wh_fast")
  let l_fcond = qbe_lbl(g, "wh_fc")
  let l_sentry = qbe_lbl(g, "wh_se")
  let l_slow = qbe_lbl(g, "wh_slow")
  let l_scond = qbe_lbl(g, "wh_sc")
  let l_end = qbe_lbl(g, "wh_e")

  // Entry check: iv0 < bound (0 iterations -> skip directly to @wh_e)
  let iv0_w = qbe_tmp(g)
  qbe_emit(g, iv0_w + " =w loadsw " + iv_slot)
  let bnd_w = if bound_is_lit {
    bound_lit.to_string()
  } else if bound_hoisted_reg != "" {
    bound_hoisted_reg
  } else {
    let bw = qbe_tmp(g)
    qbe_emit(g, bw + " =w loadsw " + bound_slot)
    bw
  }
  let enter_ok = qbe_tmp(g)
  qbe_emit(g, enter_ok + " =w csltw " + iv0_w + ", " + bnd_w)
  qbe_emit_term(g, "jnz " + enter_ok + ", " + l_vchk + ", " + l_end)

  // Single-branch 64-bit pre-loop bounds guard
  qbe_emit_lbl(g, l_vchk)
  let iv0_l = qbe_tmp(g)
  qbe_emit(g, iv0_l + " =l extsw " + iv0_w)
  let bnd_l = if bound_is_lit {
    let bl = qbe_tmp(g)
    qbe_emit(g, bl + " =l copy " + bound_lit.to_string())
    bl
  } else {
    let bl = qbe_tmp(g)
    qbe_emit(g, bl + " =l extsw " + bnd_w)
    bl
  }
  let mut all_ok = qbe_tmp(g)
  qbe_emit(g, all_ok + " =w csgel " + iv0_l + ", 0")
  let mut step_l_reg = ""
  if step_slot != "" {
    let st_w = qbe_tmp(g)
    let st_l = qbe_tmp(g)
    let c_pos = qbe_tmp(g)
    let bnd_plus_st = qbe_tmp(g)
    let c_noov = qbe_tmp(g)
    let t_st = qbe_tmp(g)
    let nxt_st = qbe_tmp(g)
    qbe_emit(g, st_w + " =w loadsw " + step_slot)
    qbe_emit(g, st_l + " =l extsw " + st_w)
    step_l_reg = st_l
    qbe_emit(g, c_pos + " =w csgtl " + st_l + ", 0")
    qbe_emit(g, bnd_plus_st + " =l add " + bnd_l + ", " + st_l)
    qbe_emit(g, c_noov + " =w cslel " + bnd_plus_st + ", 2147483648")
    qbe_emit(g, t_st + " =w and " + c_pos + ", " + c_noov)
    qbe_emit(g, nxt_st + " =w and " + all_ok + ", " + t_st)
    all_ok = nxt_st
  }
  let mut gi = 0
  while gi < guards.length() {
    let gd = guards[gi]
    let alen = match g.hoisted_arr_len.get(gd.arr) {
      Some(hl) => hl
      None =>
        match g.hoisted_str_len.get(gd.arr) {
          Some(hsl) => hsl
          None =>
            match g.hoisted_bytes_len.get(gd.arr) {
              Some(hbl) => hbl
              None => "0"
            }
        }
    }
    if gd.kind == 0 {
      let c1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, c1 + " =w cslel " + bnd_l + ", " + alen)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + c1)
      all_ok = nxt
    } else if gd.kind == 1 {
      let bc = qbe_tmp(g)
      let c_ov = qbe_tmp(g)
      let c_len = qbe_tmp(g)
      let t1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, bc + " =l add " + bnd_l + ", " + gd.offset.to_string())
      qbe_emit(g, c_ov + " =w cslel " + bc + ", 2147483648")
      qbe_emit(g, c_len + " =w cslel " + bc + ", " + alen)
      qbe_emit(g, t1 + " =w and " + c_ov + ", " + c_len)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + t1)
      all_ok = nxt
    } else {
      let v_slot = match qbe_lookup_local(g, gd.vname) {
        Some(vloc) => vloc.slot
        None => ""
      }
      let vw = qbe_tmp(g)
      let vl = qbe_tmp(g)
      let vmb = qbe_tmp(g)
      let vmin = qbe_tmp(g)
      let vmax = qbe_tmp(g)
      let c_lo = qbe_tmp(g)
      let c_hi = qbe_tmp(g)
      let t1 = qbe_tmp(g)
      let nxt = qbe_tmp(g)
      qbe_emit(g, vw + " =w loadsw " + v_slot)
      qbe_emit(g, vl + " =l extsw " + vw)
      qbe_emit(g, vmb + " =l sub " + vl + ", " + bnd_l)
      qbe_emit(g, vmin + " =l add " + vmb + ", 1")
      qbe_emit(g, vmax + " =l sub " + vl + ", " + iv0_l)
      qbe_emit(g, c_lo + " =w csgel " + vmin + ", 0")
      qbe_emit(g, c_hi + " =w csltl " + vmax + ", " + alen)
      qbe_emit(g, t1 + " =w and " + c_lo + ", " + c_hi)
      qbe_emit(g, nxt + " =w and " + all_ok + ", " + t1)
      all_ok = nxt
    }
    gi = gi + 1
  }
  if push_guards.length() > 0 {
    let rem_l = qbe_tmp(g)
    qbe_emit(g, rem_l + " =l sub " + bnd_l + ", " + iv0_l)
    let mut pgi = 0
    while pgi < push_guards.length() {
      let aname = push_guards[pgi]
      let plen_slot = match g.promoted_push_len.get(aname) {
        Some(s) => s
        None => ""
      }
      let pcap_slot = match g.promoted_push_cap.get(aname) {
        Some(s) => s
        None => ""
      }
      if plen_slot != "" && pcap_slot != "" {
        let p_len = qbe_tmp(g)
        let p_cap = qbe_tmp(g)
        let avail = qbe_tmp(g)
        let c_cap = qbe_tmp(g)
        let nxt = qbe_tmp(g)
        qbe_emit(g, p_len + " =l loadl " + plen_slot)
        qbe_emit(g, p_cap + " =l loadl " + pcap_slot)
        qbe_emit(g, avail + " =l sub " + p_cap + ", " + p_len)
        qbe_emit(g, c_cap + " =w cslel " + rem_l + ", " + avail)
        qbe_emit(g, nxt + " =w and " + all_ok + ", " + c_cap)
        all_ok = nxt
      }
      pgi = pgi + 1
    }
  }
  // P69-B Opt 1: compact Array[Bool] 8-byte SWAR counting loop detection
  let mut swar_dp = ""
  let mut swar_cnt_slot = ""
  let mut swar_cnt_is_i64 = false
  if g.release &&
    step_slot == "" &&
    body.length() == 2 &&
    !qbe_stmts_has_cf(body, true, true, true) {
    match extra_cond {
      None =>
        match body[0] {
          SExpr(EIf(EIndex(EIdent(arr_n, _), EIdent(idx_n, _), _), then_s, else_opt, _), _) => {
            let no_else = match else_opt {
              None => true
              Some(EBlock(es, _)) => es.length() == 0
              Some(_) => false
            }
            if idx_n == iv && no_else && then_s.length() == 1 {
              let cnt_n = match then_s[0] {
                SAssign(EIdent(ln, _), EBinary("+", EIdent(rn, _), EInt(raw, _), _), _) =>
                  if ln == rn && qbe_parse_int64_lit(raw) == 1L { ln } else { "" }
                SAssign(EIdent(ln, _), EBinary("+", EIdent(rn, _), EInt64(raw, _), _), _) =>
                  if ln == rn && qbe_parse_int64_lit(raw) == 1L { ln } else { "" }
                SCompoundAssign("+", EIdent(ln, _), EInt(raw, _), _) =>
                  if qbe_parse_int64_lit(raw) == 1L { ln } else { "" }
                SCompoundAssign("+", EIdent(ln, _), EInt64(raw, _), _) =>
                  if qbe_parse_int64_lit(raw) == 1L { ln } else { "" }
                _ => ""
              }
              if cnt_n != "" && cnt_n != iv && cnt_n != arr_n && seen.contains(arr_n + ":iv:" + iv) {
                let is_bool_arr = match qbe_lookup_local(g, arr_n) {
                  Some(aloc) =>
                    match aloc.ty {
                      TArray(TBool) | TFixedArray(TBool) | TImmArray(TBool) => true
                      _ => false
                    }
                  None => false
                }
                if is_bool_arr {
                  match g.hoisted_arr_dp.get(arr_n) {
                    Some(hdp) =>
                      match qbe_lookup_local(g, cnt_n) {
                        Some(cloc) =>
                          if !cloc.is_cell {
                            if qbe_is_int32_ty(cloc.ty) {
                              swar_dp = hdp
                              swar_cnt_slot = cloc.slot
                              swar_cnt_is_i64 = false
                            } else {
                              match cloc.ty {
                                TInt64 => {
                                  swar_dp = hdp
                                  swar_cnt_slot = cloc.slot
                                  swar_cnt_is_i64 = true
                                }
                                _ => ()
                              }
                            }
                          }
                        None => ()
                      }
                    None => ()
                  }
                }
              }
            }
          }
          _ => ()
        }
      Some(_) => ()
    }
  }
  let do_swar = swar_dp != ""
  let do_unroll4 = if do_swar { false } else { qbe_can_unroll4_fast_while(g, body, step_slot, extra_cond) }
  let l_swar_chk = if do_swar { qbe_lbl(g, "wh_swc") } else { "" }
  let l_swar_pre = if do_swar { qbe_lbl(g, "wh_swp") } else { "" }
  let l_swar = if do_swar { qbe_lbl(g, "wh_sw") } else { "" }
  let l_swar_tail = if do_swar { qbe_lbl(g, "wh_swt") } else { "" }
  let l_u4_chk = if do_unroll4 { qbe_lbl(g, "wh_u4c") } else { "" }
  let l_u4 = if do_unroll4 { qbe_lbl(g, "wh_u4") } else { "" }
  let l_u4_tail = if do_unroll4 { qbe_lbl(g, "wh_u4t") } else { "" }
  match extra_cond {
    Some(_) => qbe_emit_term(g, "jnz " + all_ok + ", " + l_fentry + ", " + l_sentry)
    None =>
      if do_swar {
        qbe_emit_term(g, "jnz " + all_ok + ", " + l_swar_chk + ", " + l_slow)
      } else if do_unroll4 {
        qbe_emit_term(g, "jnz " + all_ok + ", " + l_u4_chk + ", " + l_slow)
      } else {
        qbe_emit_term(g, "jnz " + all_ok + ", " + l_fast + ", " + l_slow)
      }
  }

  // Fast bottom-tested loop (zero OOB checks on versioned accesses)
  let added_keys : Array[String] = []
  gi = 0
  while gi < guards.length() {
    let k = guards[gi].key
    if !g.bce_safe_exprs.contains(k) {
      g.bce_safe_exprs.set(k, true)
      added_keys.push(k)
    }
    gi = gi + 1
  }
  let added_push_arrs : Array[String] = []
  let mut pgi = 0
  while pgi < push_guards.length() {
    let aname = push_guards[pgi]
    if !g.bce_safe_push_arrs.contains(aname) {
      g.bce_safe_push_arrs.set(aname, true)
      added_push_arrs.push(aname)
    }
    pgi = pgi + 1
  }
  match extra_cond {
    Some(ec) => {
      qbe_emit_lbl(g, l_fentry)
      qbe_emit_cond_branch(g, ec, l_fast, l_end)
    }
    None => ()
  }
  if do_swar {
    qbe_emit_lbl(g, l_swar_chk)
    let sw_lim_l = qbe_tmp(g)
    let sw_ok = qbe_tmp(g)
    qbe_emit(g, sw_lim_l + " =l sub " + bnd_l + ", 7")
    qbe_emit(g, sw_ok + " =w csltl " + iv0_l + ", " + sw_lim_l)
    qbe_emit_term(g, "jnz " + sw_ok + ", " + l_swar_pre + ", " + l_fast)
    qbe_emit_lbl(g, l_swar_pre)
    let sw_p_slot = qbe_alloc_slot(g)
    let sw_c_slot = qbe_alloc_slot(g)
    let sw_p0 = qbe_tmp(g)
    let sw_plim = qbe_tmp(g)
    qbe_emit(g, sw_p0 + " =l add " + swar_dp + ", " + iv0_l)
    qbe_emit(g, sw_plim + " =l add " + swar_dp + ", " + sw_lim_l)
    qbe_emit(g, "storel " + sw_p0 + ", " + sw_p_slot)
    if swar_cnt_is_i64 {
      let c0_l = qbe_tmp(g)
      qbe_emit(g, c0_l + " =l loadl " + swar_cnt_slot)
      qbe_emit(g, "storel " + c0_l + ", " + sw_c_slot)
    } else {
      let c0_w = qbe_tmp(g)
      let c0_l = qbe_tmp(g)
      qbe_emit(g, c0_w + " =w loadsw " + swar_cnt_slot)
      qbe_emit(g, c0_l + " =l extsw " + c0_w)
      qbe_emit(g, "storel " + c0_l + ", " + sw_c_slot)
    }
    qbe_emit_term(g, "jmp " + l_swar)
    qbe_emit_lbl(g, l_swar)
    let sw_p = qbe_tmp(g)
    let sw_w = qbe_tmp(g)
    let sw_prod = qbe_tmp(g)
    let sw_c8 = qbe_tmp(g)
    let sw_ccur = qbe_tmp(g)
    let sw_cnxt = qbe_tmp(g)
    let sw_pnxt = qbe_tmp(g)
    let sw_more = qbe_tmp(g)
    qbe_emit(g, sw_p + " =l loadl " + sw_p_slot)
    qbe_emit(g, sw_w + " =l loadl " + sw_p)
    qbe_emit(g, sw_prod + " =l mul " + sw_w + ", 72340172838076673")
    qbe_emit(g, sw_c8 + " =l shr " + sw_prod + ", 56")
    qbe_emit(g, sw_ccur + " =l loadl " + sw_c_slot)
    qbe_emit(g, sw_cnxt + " =l add " + sw_ccur + ", " + sw_c8)
    qbe_emit(g, "storel " + sw_cnxt + ", " + sw_c_slot)
    qbe_emit(g, sw_pnxt + " =l add " + sw_p + ", 8")
    qbe_emit(g, "storel " + sw_pnxt + ", " + sw_p_slot)
    qbe_emit(g, sw_more + " =w cultl " + sw_pnxt + ", " + sw_plim)
    qbe_emit_term(g, "jnz " + sw_more + ", " + l_swar + ", " + l_swar_tail)
    qbe_emit_lbl(g, l_swar_tail)
    let sw_cfin = qbe_tmp(g)
    qbe_emit(g, sw_cfin + " =l loadl " + sw_c_slot)
    if swar_cnt_is_i64 {
      qbe_emit(g, "storel " + sw_cfin + ", " + swar_cnt_slot)
    } else {
      qbe_emit(g, "storew " + sw_cfin + ", " + swar_cnt_slot)
    }
    let sw_pfin = qbe_tmp(g)
    let sw_ivfin = qbe_tmp(g)
    qbe_emit(g, sw_pfin + " =l loadl " + sw_p_slot)
    qbe_emit(g, sw_ivfin + " =l sub " + sw_pfin + ", " + swar_dp)
    qbe_emit(g, "storew " + sw_ivfin + ", " + iv_slot)
    qbe_emit_cond_branch(g, cond, l_fast, l_end)
  }
  if do_unroll4 {
    // P69-B Opt 2: var-step 4x unroll with independent pointer stores (eliminates serial add chain + sxtw)
    let mut ptr_u4_dp = ""
    let mut ptr_u4_stride = 0
    let mut ptr_u4_elem : Ty = TUnit
    let mut ptr_u4_rhs : Option[Expr] = None
    if step_slot != "" && body.length() == 2 {
      match body[0] {
        SAssign(EIndex(EIdent(arr_n, _), EIdent(idx_n, _), _), rhs_e, _) =>
          if idx_n == iv && seen.contains(arr_n + ":iv:" + iv) {
            let rhs_inv = match rhs_e {
              EBool(_, _) | EInt(_, _) | EInt64(_, _) | EByte(_, _) | EDouble(_, _) => true
              EIdent(rn, _) =>
                if rn != iv && !qbe_stmts_assigns_ident(body, rn) && !qbe_stmts_rebinds_ident(body, rn) {
                  match qbe_lookup_local(g, rn) {
                    Some(rloc) => !rloc.is_cell && qbe_is_prim_array_elem(rloc.ty)
                    None => false
                  }
                } else {
                  false
                }
              _ => false
            }
            if rhs_inv {
              match qbe_lookup_local(g, arr_n) {
                Some(aloc) => {
                  let elem_opt : Option[Ty] = match aloc.ty {
                    TArray(e) => Some(e)
                    TFixedArray(e) => Some(e)
                    TImmArray(e) => Some(e)
                    _ => None
                  }
                  match elem_opt {
                    Some(e) => {
                      let st = if qbe_is_u8_array_elem(g, e) {
                        1
                      } else if qbe_is_4b_array_elem(g, e) {
                        4
                      } else {
                        match e {
                          TInt64 | TUInt64 | TDouble => 8
                          _ => 0
                        }
                      }
                      if st > 0 {
                        match g.hoisted_arr_dp.get(arr_n) {
                          Some(hdp) => {
                            ptr_u4_dp = hdp
                            ptr_u4_stride = st
                            ptr_u4_elem = e
                            ptr_u4_rhs = Some(rhs_e)
                          }
                          None => ()
                        }
                      }
                    }
                    None => ()
                  }
                }
                None => ()
              }
            }
          }
        _ => ()
      }
    }
    qbe_emit_lbl(g, l_u4_chk)
    let u4_lim_l = qbe_tmp(g)
    let u4_ok = qbe_tmp(g)
    if step_slot == "" {
      qbe_emit(g, u4_lim_l + " =l sub " + bnd_l + ", 3")
    } else {
      let st3_l = qbe_tmp(g)
      qbe_emit(g, st3_l + " =l mul " + step_l_reg + ", 3")
      qbe_emit(g, u4_lim_l + " =l sub " + bnd_l + ", " + st3_l)
    }
    qbe_emit(g, u4_ok + " =w csltl " + iv0_l + ", " + u4_lim_l)
    if ptr_u4_dp != "" {
      let l_u4_pre = qbe_lbl(g, "wh_u4p")
      qbe_emit_term(g, "jnz " + u4_ok + ", " + l_u4_pre + ", " + l_fast)
      qbe_emit_lbl(g, l_u4_pre)
      let rhs_val = match ptr_u4_rhs {
        Some(re) => qbe_emit_expr(g, re, Some(ptr_u4_elem))
        None => qval("0", ptr_u4_elem)
      }
      let coerced_rhs = qbe_coerce_val(g, rhs_val, ptr_u4_elem)
      let ptr_u4_is_dbl = match ptr_u4_elem {
        TDouble => true
        _ => false
      }
      let ptr_u4_is_f32 = qbe_is_f32_array_elem(g, ptr_u4_elem)
      let ptr_u4_is_char = match subst_ty(ptr_u4_elem, g.cur_type_subst) {
        TChar => true
        _ => false
      }
      let store_val = if ptr_u4_stride == 1 || ptr_u4_is_f32 || ptr_u4_is_dbl {
        coerced_rhs
      } else if ptr_u4_stride == 4 {
        if ptr_u4_is_char && qbe_is_temp_reg(coerced_rhs) {
          let cw = qbe_tmp(g)
          qbe_emit(g, cw + " =w copy " + coerced_rhs)
          cw
        } else {
          coerced_rhs
        }
      } else {
        qbe_as_l(g, qval(coerced_rhs, ptr_u4_elem))
      }
      let st1 = if ptr_u4_stride == 1 {
        step_l_reg
      } else if ptr_u4_stride == 4 {
        let s1 = qbe_tmp(g)
        qbe_emit(g, s1 + " =l shl " + step_l_reg + ", 2")
        s1
      } else {
        let s1 = qbe_tmp(g)
        qbe_emit(g, s1 + " =l shl " + step_l_reg + ", 3")
        s1
      }
      let st2 = qbe_tmp(g)
      let st3 = qbe_tmp(g)
      let st4 = qbe_tmp(g)
      qbe_emit(g, st2 + " =l add " + st1 + ", " + st1)
      qbe_emit(g, st3 + " =l add " + st2 + ", " + st1)
      qbe_emit(g, st4 + " =l add " + st2 + ", " + st2)
      let iv0_off = if ptr_u4_stride == 1 {
        iv0_l
      } else if ptr_u4_stride == 4 {
        let o0 = qbe_tmp(g)
        qbe_emit(g, o0 + " =l shl " + iv0_l + ", 2")
        o0
      } else {
        let o0 = qbe_tmp(g)
        qbe_emit(g, o0 + " =l shl " + iv0_l + ", 3")
        o0
      }
      let lim_off = if ptr_u4_stride == 1 {
        u4_lim_l
      } else if ptr_u4_stride == 4 {
        let ol = qbe_tmp(g)
        qbe_emit(g, ol + " =l shl " + u4_lim_l + ", 2")
        ol
      } else {
        let ol = qbe_tmp(g)
        qbe_emit(g, ol + " =l shl " + u4_lim_l + ", 3")
        ol
      }
      let p_slot = qbe_alloc_slot(g)
      let p0 = qbe_tmp(g)
      let p_lim = qbe_tmp(g)
      qbe_emit(g, p0 + " =l add " + ptr_u4_dp + ", " + iv0_off)
      qbe_emit(g, p_lim + " =l add " + ptr_u4_dp + ", " + lim_off)
      qbe_emit(g, "storel " + p0 + ", " + p_slot)
      qbe_emit_term(g, "jmp " + l_u4)
      qbe_emit_lbl(g, l_u4)
      let p_cur = qbe_tmp(g)
      let p1 = qbe_tmp(g)
      let p2 = qbe_tmp(g)
      let p3 = qbe_tmp(g)
      let p_nxt = qbe_tmp(g)
      let c_u4 = qbe_tmp(g)
      qbe_emit(g, p_cur + " =l loadl " + p_slot)
      qbe_emit(g, p1 + " =l add " + p_cur + ", " + st1)
      qbe_emit(g, p2 + " =l add " + p_cur + ", " + st2)
      qbe_emit(g, p3 + " =l add " + p_cur + ", " + st3)
      let sop = if ptr_u4_stride == 1 {
        "storeb "
      } else if ptr_u4_is_f32 {
        "stores "
      } else if ptr_u4_stride == 4 {
        "storew "
      } else if ptr_u4_is_dbl {
        "stored "
      } else {
        "storel "
      }
      qbe_emit(g, sop + store_val + ", " + p_cur)
      qbe_emit(g, sop + store_val + ", " + p1)
      qbe_emit(g, sop + store_val + ", " + p2)
      qbe_emit(g, sop + store_val + ", " + p3)
      qbe_emit(g, p_nxt + " =l add " + p_cur + ", " + st4)
      qbe_emit(g, "storel " + p_nxt + ", " + p_slot)
      qbe_emit(g, c_u4 + " =w cultl " + p_nxt + ", " + p_lim)
      qbe_emit_term(g, "jnz " + c_u4 + ", " + l_u4 + ", " + l_u4_tail)
      qbe_emit_lbl(g, l_u4_tail)
      let p_fin = qbe_tmp(g)
      let diff = qbe_tmp(g)
      qbe_emit(g, p_fin + " =l loadl " + p_slot)
      qbe_emit(g, diff + " =l sub " + p_fin + ", " + ptr_u4_dp)
      if ptr_u4_stride == 1 {
        qbe_emit(g, "storew " + diff + ", " + iv_slot)
      } else if ptr_u4_stride == 4 {
        let iv_fin = qbe_tmp(g)
        qbe_emit(g, iv_fin + " =l shr " + diff + ", 2")
        qbe_emit(g, "storew " + iv_fin + ", " + iv_slot)
      } else {
        let iv_fin = qbe_tmp(g)
        qbe_emit(g, iv_fin + " =l shr " + diff + ", 3")
        qbe_emit(g, "storew " + iv_fin + ", " + iv_slot)
      }
      qbe_emit_cond_branch(g, cond, l_fast, l_end)
    } else {
      qbe_emit_term(g, "jnz " + u4_ok + ", " + l_u4 + ", " + l_fast)
      qbe_emit_lbl(g, l_u4)
      let u4_loop_depth = g.scopes.length()
      g.loop_breaks.push(l_end)
      g.loop_conts.push(l_u4_tail)
      g.loop_depths.push(u4_loop_depth)
      g.hot_loop_depth = g.hot_loop_depth + 1
      let mut ui = 0
      while ui < 4 {
        g.block_immut_fields = Map([])
        qbe_scope_push(g)
        let ubv = qbe_emit_stmts(g, body, None)
        if !g.block_term {
          qbe_rc_dec(g, ubv.reg, ubv.ty)
        }
        qbe_scope_pop(g)
        ui = ui + 1
      }
      let _ = g.loop_breaks.pop()
      let _ = g.loop_conts.pop()
      let _ = g.loop_depths.pop()
      g.hot_loop_depth = g.hot_loop_depth - 1
      let iv_u4_w = qbe_tmp(g)
      let iv_u4_l = qbe_tmp(g)
      let c_u4 = qbe_tmp(g)
      qbe_emit(g, iv_u4_w + " =w loadsw " + iv_slot)
      qbe_emit(g, iv_u4_l + " =l extsw " + iv_u4_w)
      qbe_emit(g, c_u4 + " =w csltl " + iv_u4_l + ", " + u4_lim_l)
      qbe_emit_term(g, "jnz " + c_u4 + ", " + l_u4 + ", " + l_u4_tail)
      qbe_emit_lbl(g, l_u4_tail)
      qbe_emit_cond_branch(g, cond, l_fast, l_end)
    }
  }
  qbe_emit_lbl(g, l_fast)
  let loop_depth = g.scopes.length()
  let exchanged = !do_swar && !do_unroll4 && step_slot == "" && extra_cond is None &&
    qbe_emit_guarded_exchange(g, body, iv, bound_name, iv_slot, iv0_l, bnd_l, bnd_w,
      guards, l_fast, l_end)
  if !exchanged {
    g.loop_breaks.push(l_end)
    g.loop_conts.push(l_fcond)
    g.loop_depths.push(loop_depth)
    g.hot_loop_depth = g.hot_loop_depth + 1
    qbe_scope_push(g)
    let fbv = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, fbv.reg, fbv.ty)
    }
    qbe_scope_pop(g)
    let _ = g.loop_breaks.pop()
    let _ = g.loop_conts.pop()
    let _ = g.loop_depths.pop()
    qbe_emit_term(g, "jmp " + l_fcond)
    qbe_emit_lbl(g, l_fcond)
    qbe_emit_cond_branch(g, cond, l_fast, l_end)
    g.hot_loop_depth = g.hot_loop_depth - 1
  }

  // Clear fast-path BCE keys before emitting slow path
  let mut ki = 0
  while ki < added_keys.length() {
    g.bce_safe_exprs.remove(added_keys[ki])
    ki = ki + 1
  }
  let mut pki = 0
  while pki < added_push_arrs.length() {
    g.bce_safe_push_arrs.remove(added_push_arrs[pki])
    pki = pki + 1
  }

  // Slow bottom-tested loop (full OOB checks preserved)
  match extra_cond {
    Some(ec) => {
      qbe_emit_lbl(g, l_sentry)
      qbe_emit_cond_branch(g, ec, l_slow, l_end)
    }
    None => ()
  }
  qbe_emit_lbl(g, l_slow)
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_scond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let sbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, sbv.reg, sbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_scond)
  qbe_emit_lbl(g, l_scond)
  qbe_emit_cond_branch(g, cond, l_slow, l_end)
  g.hot_loop_depth = g.hot_loop_depth - 1

  qbe_emit_lbl(g, l_end)
  true
}
///|
fn qbe_bce_collect_dec_arrs_expr(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  e : Expr,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => ()
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ETry(inner, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) =>
      qbe_bce_collect_dec_arrs_expr(g, body, iv, inner, out, seen)
    EBinary(_, l, r, _) | EScope(l, r, _) | ESpawn(l, r, _) => {
      qbe_bce_collect_dec_arrs_expr(g, body, iv, l, out, seen)
      qbe_bce_collect_dec_arrs_expr(g, body, iv, r, out, seen)
    }
    EIndex(obj, idx, _) => {
      let arr_name = match obj {
        EIdent(an, _) => an
        EField(EIdent(vn, _), fnm, _) => vn + "." + fnm
        _ => ""
      }
      if arr_name != "" &&
        (g.hoisted_arr_len.contains(arr_name) ||
          g.hoisted_str_len.contains(arr_name) ||
          g.hoisted_bytes_len.contains(arr_name)) &&
        !qbe_stmts_rebinds_ident(body, arr_name) {
        match idx {
          EBinary("-", EIdent(iname, _), EInt(raw, _), _) =>
            if iname == iv && qbe_parse_int64_lit(raw) == 1L && !seen.contains(arr_name) {
              seen.set(arr_name, true)
              out.push(arr_name)
            }
          _ => ()
        }
      }
      qbe_bce_collect_dec_arrs_expr(g, body, iv, obj, out, seen)
      qbe_bce_collect_dec_arrs_expr(g, body, iv, idx, out, seen)
    }
    ECall(callee, args, _) => {
      qbe_bce_collect_dec_arrs_expr(g, body, iv, callee, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_bce_collect_dec_arrs_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_bce_collect_dec_arrs_expr(g, body, iv, obj, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_bce_collect_dec_arrs_expr(g, body, iv, args[i], out, seen)
        i = i + 1
      }
    }
    EIf(c, ts, eo, _) => {
      qbe_bce_collect_dec_arrs_expr(g, body, iv, c, out, seen)
      qbe_bce_collect_dec_arrs_stmts(g, body, iv, ts, out, seen)
      match eo {
        Some(ee) => qbe_bce_collect_dec_arrs_expr(g, body, iv, ee, out, seen)
        None => ()
      }
    }
    EBlock(ss, _) => qbe_bce_collect_dec_arrs_stmts(g, body, iv, ss, out, seen)
    _ => ()
  }
}

///|
fn qbe_bce_collect_dec_arrs_stmts(
  g : QbeGen,
  body : Array[Stmt],
  iv : String,
  stmts : Array[Stmt],
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => qbe_bce_collect_dec_arrs_expr(g, body, iv, init, out, seen)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        qbe_bce_collect_dec_arrs_expr(g, body, iv, lhs, out, seen)
        qbe_bce_collect_dec_arrs_expr(g, body, iv, rhs, out, seen)
      }
      SExpr(e, _) => qbe_bce_collect_dec_arrs_expr(g, body, iv, e, out, seen)
      _ => ()
    }
    i = i + 1
  }
}

///|
fn qbe_try_emit_while_dec_bce_versioned(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() == 0 ||
    body.length() > 16 ||
    qbe_stmts_has_nested_loop(body) ||
    qbe_stmts_has_cf(body, true, true, true) {
    return false
  }
  let mut iv = ""
  let mut stop_lit = 0L
  let mut matched_cond = false
  match cond {
    EBinary("!=", EIdent(iv_n, _), EInt(raw, _), _) => {
      let c = qbe_parse_int64_lit(raw).to_int().to_int64()
      if c >= 1L {
        iv = iv_n
        stop_lit = c
        matched_cond = true
      }
    }
    EBinary(">", EIdent(iv_n, _), EInt(raw, _), _) => {
      let c = qbe_parse_int64_lit(raw).to_int().to_int64()
      if c >= 0L {
        iv = iv_n
        stop_lit = c
        matched_cond = true
      }
    }
    _ => ()
  }
  if !matched_cond {
    return false
  }
  let iv_slot = match qbe_lookup_local(g, iv) {
    Some(iloc) =>
      if !iloc.is_cell && qbe_is_int32_ty(iloc.ty) {
        iloc.slot
      } else {
        return false
      }
    None => return false
  }
  if !qbe_stmt_is_dec_by_one(body[body.length() - 1], iv) {
    return false
  }
  let mut bi = 0
  while bi < body.length() - 1 {
    if qbe_stmt_assigns_ident(body[bi], iv) || qbe_stmt_rebinds_ident(body[bi], iv) {
      return false
    }
    bi = bi + 1
  }
  let arrs : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  qbe_bce_collect_dec_arrs_stmts(g, body, iv, body, arrs, seen)
  if arrs.length() == 0 {
    return false
  }

  let l_vchk = qbe_lbl(g, "wh_vchk")
  let l_fast = qbe_lbl(g, "wh_fast")
  let l_fcond = qbe_lbl(g, "wh_fc")
  let l_slow = qbe_lbl(g, "wh_slow")
  let l_scond = qbe_lbl(g, "wh_sc")
  let l_end = qbe_lbl(g, "wh_e")

  qbe_emit_cond_branch(g, cond, l_vchk, l_end)

  // Pre-loop guard: iv0 > stop_lit (ensures no underflow on !=) AND iv0 <= alen for every arr
  qbe_emit_lbl(g, l_vchk)
  let iv0_w = qbe_tmp(g)
  let iv0_l = qbe_tmp(g)
  let mut all_ok = qbe_tmp(g)
  qbe_emit(g, iv0_w + " =w loadsw " + iv_slot)
  qbe_emit(g, iv0_l + " =l extsw " + iv0_w)
  qbe_emit(g, all_ok + " =w csgtl " + iv0_l + ", " + stop_lit.to_string())
  let mut ai = 0
  while ai < arrs.length() {
    let aname = arrs[ai]
    let alen = match g.hoisted_arr_len.get(aname) {
      Some(hl) => hl
      None =>
        match g.hoisted_str_len.get(aname) {
          Some(hsl) => hsl
          None =>
            match g.hoisted_bytes_len.get(aname) {
              Some(hbl) => hbl
              None => "0"
            }
        }
    }
    let c_len = qbe_tmp(g)
    let nxt = qbe_tmp(g)
    qbe_emit(g, c_len + " =w cslel " + iv0_l + ", " + alen)
    qbe_emit(g, nxt + " =w and " + all_ok + ", " + c_len)
    all_ok = nxt
    ai = ai + 1
  }
  qbe_emit_term(g, "jnz " + all_ok + ", " + l_fast + ", " + l_slow)

  // Fast bottom-tested decrementing loop (zero OOB checks on arr[iv - 1])
  let added_keys : Array[String] = []
  ai = 0
  while ai < arrs.length() {
    let k = arrs[ai] + ":iv+:" + iv + ":-1"
    if !g.bce_safe_exprs.contains(k) {
      g.bce_safe_exprs.set(k, true)
      added_keys.push(k)
    }
    ai = ai + 1
  }
  qbe_emit_lbl(g, l_fast)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_fcond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let fbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, fbv.reg, fbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_fcond)
  qbe_emit_lbl(g, l_fcond)
  qbe_emit_cond_branch(g, cond, l_fast, l_end)
  g.hot_loop_depth = g.hot_loop_depth - 1

  let mut ki = 0
  while ki < added_keys.length() {
    g.bce_safe_exprs.remove(added_keys[ki])
    ki = ki + 1
  }

  // Slow fallback loop with full OOB checks
  qbe_emit_lbl(g, l_slow)
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_scond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let sbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, sbv.reg, sbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_scond)
  qbe_emit_lbl(g, l_scond)
  qbe_emit_cond_branch(g, cond, l_slow, l_end)
  g.hot_loop_depth = g.hot_loop_depth - 1

  qbe_emit_lbl(g, l_end)
  true
}


///|
fn qbe_emit_strbuf_push_byte_inline(
  g : QbeGen,
  sb : String,
  bw : String,
) -> Unit {
  if g.hot_loop_depth == 0 {
    qbe_emit(g, "call $pion_strbuf_push_byte(l " + sb + ", w " + bw + ")")
    return
  }
  let slen = qbe_tmp(g)
  let cap_p = qbe_tmp(g)
  let scap = qbe_tmp(g)
  let nlen = qbe_tmp(g)
  let ok = qbe_tmp(g)
  let l_fast = qbe_lbl(g, "sb_fast")
  let l_slow = qbe_lbl(g, "sb_slow")
  let l_end = qbe_lbl(g, "sb_end")
  qbe_emit(g, slen + " =l loadl " + sb)
  qbe_emit(g, cap_p + " =l add " + sb + ", 8")
  qbe_emit(g, scap + " =l loadl " + cap_p)
  qbe_emit(g, nlen + " =l add " + slen + ", 1")
  qbe_emit(g, ok + " =w csltl " + nlen + ", " + scap)
  qbe_emit_term(g, "jnz " + ok + ", " + l_fast + ", " + l_slow)
  qbe_emit_lbl(g, l_fast)
  let dp_p = qbe_tmp(g)
  let dp = qbe_tmp(g)
  let p0 = qbe_tmp(g)
  let p1 = qbe_tmp(g)
  qbe_emit(g, dp_p + " =l add " + sb + ", 16")
  qbe_emit(g, dp + " =l loadl " + dp_p)
  qbe_emit(g, p0 + " =l add " + dp + ", " + slen)
  qbe_emit(g, "storeb " + bw + ", " + p0)
  qbe_emit(g, p1 + " =l add " + dp + ", " + nlen)
  qbe_emit(g, "storeb 0, " + p1)
  qbe_emit(g, "storel " + nlen + ", " + sb)
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_slow)
  qbe_emit(g, "call $pion_strbuf_push_byte(l " + sb + ", w " + bw + ")")
  qbe_emit_term(g, "jmp " + l_end)
  qbe_emit_lbl(g, l_end)
}

///|
fn qbe_stmt_is_dec_by_one(s : Stmt, name : String) -> Bool {
  match s {
    SAssign(EIdent(lhs_n, _), EBinary("-", EIdent(rhs_n, _), EInt(raw, _), _), _) =>
      lhs_n == name && rhs_n == name && qbe_parse_int64_lit(raw) == 1L
    SCompoundAssign("-", EIdent(lhs_n, _), EInt(raw, _), _) =>
      lhs_n == name && qbe_parse_int64_lit(raw) == 1L
    _ => false
  }
}

///|
fn qbe_collect_two_ptr_arrs_expr(
  g : QbeGen,
  body : Array[Stmt],
  lo : String,
  hi : String,
  e : Expr,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  if out.length() >= 4 {
    return
  }
  match e {
    EIndex(arr_e, idx_e, _) => {
      match (arr_e, idx_e) {
        (EIdent(aname, _), EIdent(iname, _)) =>
          if (iname == lo || iname == hi) &&
            !seen.contains(aname) &&
            g.hoisted_arr_len.contains(aname) &&
            !qbe_stmts_rebinds_ident(body, aname) {
            seen.set(aname, true)
            out.push(aname)
          }
        _ => ()
      }
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, arr_e, out, seen)
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, idx_e, out, seen)
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) =>
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, inner, out, seen)
    EBinary(_, l, r, _) => {
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, l, out, seen)
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, r, out, seen)
    }
    ETuple(es, _) | EArrayLit(es, _) => {
      let mut i = 0
      while i < es.length() {
        qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, es[i], out, seen)
        i = i + 1
      }
    }
    EIf(c, tb, eb, _) => {
      qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, c, out, seen)
      qbe_collect_two_ptr_arrs_stmts(g, body, lo, hi, tb, out, seen)
      match eb {
        Some(es) => qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, es, out, seen)
        None => ()
      }
    }
    EBlock(ss, _) => qbe_collect_two_ptr_arrs_stmts(g, body, lo, hi, ss, out, seen)
    _ => ()
  }
}

///|
fn qbe_collect_two_ptr_arrs_stmts(
  g : QbeGen,
  body : Array[Stmt],
  lo : String,
  hi : String,
  stmts : Array[Stmt],
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() && out.length() < 4 {
    match stmts[i] {
      SLet(_, _, _, init, _) =>
        qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, init, out, seen)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, lhs, out, seen)
        qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, rhs, out, seen)
      }
      SExpr(e, _) => qbe_collect_two_ptr_arrs_expr(g, body, lo, hi, e, out, seen)
      _ => ()
    }
    i = i + 1
  }
}

///|
fn qbe_try_emit_while_two_ptr_bce(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() < 2 ||
    body.length() > 16 ||
    qbe_stmts_has_nested_loop(body) ||
    qbe_stmts_has_cf(body, true, true, true) ||
    !qbe_loop_has_no_calls_stmts(g, body) {
    return false
  }
  let (lo, hi) = match cond {
    EBinary("<", EIdent(lo_n, _), EIdent(hi_n, _), _) =>
      if lo_n != hi_n {
        (lo_n, hi_n)
      } else {
        return false
      }
    _ => return false
  }
  let lo_slot = match qbe_lookup_local(g, lo) {
    Some(loc) =>
      if !loc.is_cell && qbe_is_int32_ty(loc.ty) {
        loc.slot
      } else {
        return false
      }
    None => return false
  }
  let hi_slot = match qbe_lookup_local(g, hi) {
    Some(loc) =>
      if !loc.is_cell && qbe_is_int32_ty(loc.ty) {
        loc.slot
      } else {
        return false
      }
    None => return false
  }
  let n = body.length()
  let mut lo_inc_idx = -1
  let mut hi_dec_idx = -1
  let mut bi = 0
  while bi < n {
    let st = body[bi]
    if qbe_stmt_is_inc_by_one(st, lo) {
      if lo_inc_idx >= 0 {
        return false
      }
      lo_inc_idx = bi
    } else if qbe_stmt_assigns_ident(st, lo) || qbe_stmt_rebinds_ident(st, lo) {
      return false
    }
    if qbe_stmt_is_dec_by_one(st, hi) {
      if hi_dec_idx >= 0 {
        return false
      }
      hi_dec_idx = bi
    } else if qbe_stmt_assigns_ident(st, hi) || qbe_stmt_rebinds_ident(st, hi) {
      return false
    }
    bi = bi + 1
  }
  if lo_inc_idx < n - 2 || hi_dec_idx < n - 2 || lo_inc_idx == hi_dec_idx {
    return false
  }
  let cands : Array[String] = []
  let seen : Map[String, Bool] = Map([])
  qbe_collect_two_ptr_arrs_stmts(g, body, lo, hi, body, cands, seen)
  if cands.length() == 0 {
    return false
  }

  let l_vchk = qbe_lbl(g, "wh_bce_vchk")
  let l_fast = qbe_lbl(g, "wh_bce_fast")
  let l_fcond = qbe_lbl(g, "wh_bce_fc")
  let l_slow = qbe_lbl(g, "wh_bce_slow")
  let l_scond = qbe_lbl(g, "wh_bce_sc")
  let l_end = qbe_lbl(g, "wh_bce_e")

  // Entry check: lo0 < hi0
  let lo0_w = qbe_tmp(g)
  let hi0_w = qbe_tmp(g)
  let enter_ok = qbe_tmp(g)
  qbe_emit(g, lo0_w + " =w loadsw " + lo_slot)
  qbe_emit(g, hi0_w + " =w loadsw " + hi_slot)
  qbe_emit(g, enter_ok + " =w csltw " + lo0_w + ", " + hi0_w)
  qbe_emit_term(g, "jnz " + enter_ok + ", " + l_vchk + ", " + l_end)

  // Pre-loop guard: 0 <= lo0 < hi0 < arr.length() for every candidate array
  qbe_emit_lbl(g, l_vchk)
  let lo0_l = qbe_tmp(g)
  let hi0_l = qbe_tmp(g)
  qbe_emit(g, lo0_l + " =l extsw " + lo0_w)
  qbe_emit(g, hi0_l + " =l extsw " + hi0_w)
  let mut all_ok = qbe_tmp(g)
  qbe_emit(g, all_ok + " =w csgel " + lo0_l + ", 0")
  let mut ci = 0
  while ci < cands.length() {
    let aname = cands[ci]
    let alen = match g.hoisted_arr_len.get(aname) {
      Some(hl) => hl
      None => "0"
    }
    let c_hi = qbe_tmp(g)
    let nxt = qbe_tmp(g)
    qbe_emit(g, c_hi + " =w csltl " + hi0_l + ", " + alen)
    qbe_emit(g, nxt + " =w and " + all_ok + ", " + c_hi)
    all_ok = nxt
    ci = ci + 1
  }
  qbe_emit_term(g, "jnz " + all_ok + ", " + l_fast + ", " + l_slow)

  // Fast bottom-tested loop (zero OOB checks on arr[lo] and arr[hi])
  let added_keys : Array[String] = []
  ci = 0
  while ci < cands.length() {
    let aname = cands[ci]
    let klo = lo + ":" + aname
    if !g.bce_safe_indices.contains(klo) {
      g.bce_safe_indices.set(klo, "1")
      added_keys.push(klo)
    }
    let khi = hi + ":" + aname
    if !g.bce_safe_indices.contains(khi) {
      g.bce_safe_indices.set(khi, "1")
      added_keys.push(khi)
    }
    ci = ci + 1
  }
  qbe_emit_lbl(g, l_fast)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_fcond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let fbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, fbv.reg, fbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_fcond)
  qbe_emit_lbl(g, l_fcond)
  qbe_emit_cond_branch(g, cond, l_fast, l_end)
  g.hot_loop_depth = g.hot_loop_depth - 1

  // Restore bce_safe_indices before slow path
  let mut ki = 0
  while ki < added_keys.length() {
    g.bce_safe_indices.remove(added_keys[ki])
    ki = ki + 1
  }

  // Slow bottom-tested loop (full OOB checks preserved)
  qbe_emit_lbl(g, l_slow)
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_scond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let sbv = qbe_emit_stmts(g, body, None)
  if !g.block_term {
    qbe_rc_dec(g, sbv.reg, sbv.ty)
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_scond)
  qbe_emit_lbl(g, l_scond)
  qbe_emit_cond_branch(g, cond, l_slow, l_end)
  g.hot_loop_depth = g.hot_loop_depth - 1

  qbe_emit_lbl(g, l_end)
  true
}


///|
fn qbe_is_scalar_cmp_ty(ty : Ty) -> Bool {
  match ty {
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TByte
    | TInt8
    | TChar
    | TBool
    | TFloat
    | TDouble => true
    _ => false
  }
}

///|
fn qbe_is_pure_01_bool_expr(g : QbeGen, e : Expr) -> Bool {
  match e {
    EIdent(vname, _) =>
      match qbe_lookup_local(g, vname) {
        Some(loc) =>
          match subst_ty(loc.ty, g.cur_type_subst) {
            TBool => true
            _ => false
          }
        None => false
      }
    EIndex(EIdent(aname, _), idx_e, _) =>
      if !qbe_loop_has_no_calls_expr(g, idx_e) {
        false
      } else {
        match qbe_lookup_local(g, aname) {
          Some(aloc) =>
            match subst_ty(aloc.ty, g.cur_type_subst) {
              TArray(et) | TFixedArray(et) | TImmArray(et) =>
                match subst_ty(et, g.cur_type_subst) {
                  TBool => true
                  _ => false
                }
              _ => false
            }
          None => false
        }
      }
    EBinary(op, lhs, rhs, _) =>
      if (op == "==" ||
          op == "!=" ||
          op == "<" ||
          op == "<=" ||
          op == ">" ||
          op == ">=") &&
        qbe_loop_has_no_calls_expr(g, lhs) &&
        qbe_loop_has_no_calls_expr(g, rhs) {
        match (qbe_probe_expr_ty(g, lhs), qbe_probe_expr_ty(g, rhs)) {
          (Some(lt), Some(rt)) =>
            qbe_is_scalar_cmp_ty(subst_ty(lt, g.cur_type_subst)) &&
            qbe_is_scalar_cmp_ty(subst_ty(rt, g.cur_type_subst))
          _ => false
        }
      } else {
        false
      }
    _ => false
  }
}

///|
fn qbe_can_branchless_inc_if(
  g : QbeGen,
  cond : Expr,
  then_stmts : Array[Stmt],
) -> Bool {
  if then_stmts.length() != 1 {
    return false
  }
  let acc = match then_stmts[0] {
    SAssign(EIdent(a, _), EBinary("+", EIdent(a2, _), EInt(raw, _), _), _) =>
      if a == a2 && qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    SAssign(EIdent(a, _), EBinary("+", EInt(raw, _), EIdent(a2, _), _), _) =>
      if a == a2 && qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    SAssign(EIdent(a, _), EBinary("+", EIdent(a2, _), EInt64(raw, _), _), _) =>
      if a == a2 && qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    SAssign(EIdent(a, _), EBinary("+", EInt64(raw, _), EIdent(a2, _), _), _) =>
      if a == a2 && qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    SCompoundAssign("+", EIdent(a, _), EInt(raw, _), _) =>
      if qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    SCompoundAssign("+", EIdent(a, _), EInt64(raw, _), _) =>
      if qbe_parse_int64_lit(raw) == 1L {
        a
      } else {
        return false
      }
    _ => return false
  }
  if qbe_expr_assigns_ident(cond, acc) || qbe_expr_rebinds_ident(cond, acc) {
    return false
  }
  let ok_acc = match qbe_lookup_local(g, acc) {
    Some(loc) =>
      if !loc.is_cell {
        match subst_ty(loc.ty, g.cur_type_subst) {
          TInt | TInt64 => true
          _ => false
        }
      } else {
        false
      }
    None => false
  }
  ok_acc && qbe_is_pure_01_bool_expr(g, cond)
}

///|
fn qbe_try_emit_branchless_inc_if(
  g : QbeGen,
  cond : Expr,
  then_stmts : Array[Stmt],
) -> Bool {
  if !qbe_can_branchless_inc_if(g, cond, then_stmts) {
    return false
  }
  let acc = match then_stmts[0] {
    SAssign(EIdent(a, _), _, _) | SCompoundAssign("+", EIdent(a, _), _, _) => a
    _ => return false
  }
  let (acc_slot, acc_is_i64) = match qbe_lookup_local(g, acc) {
    Some(loc) =>
      match subst_ty(loc.ty, g.cur_type_subst) {
        TInt => (loc.slot, false)
        TInt64 => (loc.slot, true)
        _ => return false
      }
    None => return false
  }
  let cv = qbe_emit_expr(g, cond, Some(TBool))
  let cw = qbe_tmp(g)
  qbe_emit(g, cw + " =w copy " + cv.reg)
  if acc_is_i64 {
    let old_l = qbe_tmp(g)
    let ext_l = qbe_tmp(g)
    let nxt_l = qbe_tmp(g)
    qbe_emit(g, old_l + " =l loadl " + acc_slot)
    qbe_emit(g, ext_l + " =l extuw " + cw)
    qbe_emit(g, nxt_l + " =l add " + old_l + ", " + ext_l)
    qbe_emit(g, "storel " + nxt_l + ", " + acc_slot)
  } else {
    let old_w = qbe_tmp(g)
    let nxt_w = qbe_tmp(g)
    qbe_emit(g, old_w + " =w loadsw " + acc_slot)
    qbe_emit(g, nxt_w + " =w add " + old_w + ", " + cw)
    qbe_emit(g, "storew " + nxt_w + ", " + acc_slot)
  }
  true
}

///|
fn qbe_push_loop_safe_expr(
  g : QbeGen,
  e : Expr,
  hints : QbeProbeHints,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EIdent(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) => qbe_push_loop_safe_expr(g, inner, hints)
    EBinary(op, l, r, _) =>
      !((op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, hints)) &&
      qbe_push_loop_safe_expr(g, l, hints) &&
      qbe_push_loop_safe_expr(g, r, hints)
    EIndex(l, r, _) =>
      qbe_push_loop_safe_expr(g, l, hints) &&
      qbe_push_loop_safe_expr(g, r, hints)
    ECall(callee, args, _) =>
      match callee {
        EIdent(fname, _) => {
          let is_allowed = match g.inline_closures.get(fname) {
            Some(iclo) =>
              !qbe_stmts_has_nested_loop(iclo.body) &&
              !qbe_stmts_has_cf(iclo.body, false, false, true) &&
              qbe_push_loop_safe_stmts(g, iclo.body, qbe_hints_new())
            None =>
              !qbe_has_user_callee(g, fname) &&
              (fname == "math_sqrt" ||
              fname == "math_cbrt" ||
              fname == "math_abs" ||
              fname == "math_floor" ||
              fname == "math_ceil" ||
              fname == "math_sin" ||
              fname == "math_cos" ||
              fname == "math_pow" ||
              fname == "math_tan" ||
              fname == "math_asin" ||
              fname == "math_acos" ||
              fname == "math_atan" ||
              fname == "math_atan2" ||
              fname == "math_exp" ||
              fname == "math_log" ||
              fname == "math_log1p" ||
              fname == "math_round" ||
              fname == "math_trunc")
          }
          if !is_allowed {
            return false
          }
          let mut i = 0
          while i < args.length() {
            if !qbe_push_loop_safe_expr(g, args[i], hints) {
              return false
            }
            i = i + 1
          }
          true
        }
        _ => false
      }
    EMethodCall(obj, mname, args, msp) => {
      if qbe_has_expected_trait(g, msp) {
        return false
      }
      if !qbe_push_loop_safe_expr(g, obj, hints) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_push_loop_safe_expr(g, args[i], hints) {
          return false
        }
        i = i + 1
      }
      if mname == "push" && args.length() == 1 {
        match obj {
          EIdent(_, _) => return true
          _ => return false
        }
      }
      if mname == "contains" && qbe_contains_may_call_custom(g, obj, hints) {
        return false
      }
      match qbe_probe_expr_ty_with(g, obj, hints) {
        Some(raw_ty) =>
          qbe_is_pure_builtin_method(
            subst_ty(raw_ty, g.cur_type_subst),
            mname,
            args.length(),
          )
        None => false
      }
    }
    EClosure(_, _, _, _)
    | EScope(_, _, _)
    | ESpawn(_, _, _)
    | ETry(_, _)
    | EInterp(_, _)
    | EDotVariant(_, _, _) => false
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_push_loop_safe_expr(g, elems[i], hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_push_loop_safe_expr(g, b, hints) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_push_loop_safe_expr(g, fields[i].value, hints) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_push_loop_safe_stmts(g, stmts, hints)
    EIf(cond, then_stmts, else_opt, _) => {
      if !qbe_push_loop_safe_expr(g, cond, hints) ||
        !qbe_push_loop_safe_stmts(g, then_stmts, hints) {
        return false
      }
      match else_opt {
        None => true
        Some(el) => qbe_push_loop_safe_expr(g, el, hints)
      }
    }
    EIs(scrut, _, _) => qbe_push_loop_safe_expr(g, scrut, hints)
    EMatch(scrut, arms, _) => {
      if !qbe_push_loop_safe_expr(g, scrut, hints) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if !qbe_push_loop_safe_expr(g, ge, hints) { return false }
          None => ()
        }
        if !qbe_push_loop_safe_expr(g, arms[i].body, hints) {
          return false
        }
        i = i + 1
      }
      true
    }
  }
}

///|
fn qbe_push_loop_safe_stmt(
  g : QbeGen,
  s : Stmt,
  hints : QbeProbeHints,
) -> Bool {
  match s {
    SLet(_, _, _, init, _) => qbe_push_loop_safe_expr(g, init, hints)
    SLetTuple(_, _, init, _) => qbe_push_loop_safe_expr(g, init, hints)
    SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
      qbe_push_loop_safe_expr(g, lhs, hints) &&
      qbe_push_loop_safe_expr(g, rhs, hints)
    SBreak(_) | SContinue(_) => true
    SExpr(e, _) => qbe_push_loop_safe_expr(g, e, hints)
    SDebugAssert(c, m, _) =>
      qbe_push_loop_safe_expr(g, c, hints) &&
      qbe_push_loop_safe_expr(g, m, hints)
    _ => false
  }
}

///|
fn qbe_push_loop_safe_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  outer_hints : QbeProbeHints,
) -> Bool {
  let local_hints = qbe_hints_copy(outer_hints)
  let mut i = 0
  while i < stmts.length() {
    if !qbe_push_loop_safe_stmt(g, stmts[i], local_hints) {
      return false
    }
    match stmts[i] {
      SLet(name, _, te, init, let_sp) =>
        if name != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, local_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => bound_ty = qbe_resolve_type(g, te)
          }
          match bound_ty {
            TError => ()
            _ => qbe_hints_set(local_hints, name, bound_ty)
          }
        }
      _ => ()
    }
    i = i + 1
  }
  true
}

///|
fn qbe_collect_push_arrs_expr(
  e : Expr,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  if out.length() >= 2 {
    return
  }
  match e {
    EMethodCall(obj, mname, args, _) => {
      if mname == "push" && args.length() == 1 {
        match obj {
          EIdent(aname, _) =>
            if !seen.contains(aname) && out.length() < 2 {
              seen.set(aname, true)
              out.push(aname)
            }
          _ => ()
        }
      }
      qbe_collect_push_arrs_expr(obj, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_collect_push_arrs_expr(args[i], out, seen)
        i = i + 1
      }
    }
    EBlock(stmts, _) => qbe_collect_push_arrs_stmts(stmts, out, seen)
    EIf(c, t, el, _) => {
      qbe_collect_push_arrs_expr(c, out, seen)
      qbe_collect_push_arrs_stmts(t, out, seen)
      match el {
        Some(ee) => qbe_collect_push_arrs_expr(ee, out, seen)
        None => ()
      }
    }
    EMatch(s, arms, _) => {
      qbe_collect_push_arrs_expr(s, out, seen)
      let mut i = 0
      while i < arms.length() {
        qbe_collect_push_arrs_expr(arms[i].body, out, seen)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_collect_push_arrs_stmts(
  stmts : Array[Stmt],
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() && out.length() < 2 {
    match stmts[i] {
      SExpr(e, _) => qbe_collect_push_arrs_expr(e, out, seen)
      _ => ()
    }
    i = i + 1
  }
}

///|
fn qbe_count_arr_push_expr(e : Expr, aname : String) -> Int {
  match e {
    EMethodCall(obj, mname, args, _) => {
      let mut n = 0
      if mname == "push" {
        match obj {
          EIdent(nm, _) =>
            if nm == aname {
              n = 1
            }
          _ => ()
        }
      }
      n = n + qbe_count_arr_push_expr(obj, aname)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_count_arr_push_expr(args[i], aname)
        i = i + 1
      }
      n
    }
    ECall(callee, args, _) => {
      let mut n = qbe_count_arr_push_expr(callee, aname)
      let mut i = 0
      while i < args.length() {
        n = n + qbe_count_arr_push_expr(args[i], aname)
        i = i + 1
      }
      n
    }
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | ETry(inner, _)
    | EIs(inner, _, _) => qbe_count_arr_push_expr(inner, aname)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_count_arr_push_expr(l, aname) + qbe_count_arr_push_expr(r, aname)
    EArrayLit(es, _) | ETuple(es, _) => {
      let mut n = 0
      let mut i = 0
      while i < es.length() {
        n = n + qbe_count_arr_push_expr(es[i], aname)
        i = i + 1
      }
      n
    }
    EStructLit(_, spread_opt, fields, _) => {
      let mut n = match spread_opt {
        Some(sp) => qbe_count_arr_push_expr(sp, aname)
        None => 0
      }
      let mut i = 0
      while i < fields.length() {
        n = n + qbe_count_arr_push_expr(fields[i].value, aname)
        i = i + 1
      }
      n
    }
    EBlock(stmts, _) => qbe_count_arr_push_stmts(stmts, aname)
    EIf(c, t, el, _) => {
      let mut n = qbe_count_arr_push_expr(c, aname) + qbe_count_arr_push_stmts(t, aname)
      match el {
        Some(ee) => n = n + qbe_count_arr_push_expr(ee, aname)
        None => ()
      }
      n
    }
    EMatch(s, arms, _) => {
      let mut n = qbe_count_arr_push_expr(s, aname)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => n = n + qbe_count_arr_push_expr(ge, aname)
          None => ()
        }
        n = n + qbe_count_arr_push_expr(arms[i].body, aname)
        i = i + 1
      }
      n
    }
    EClosure(_, _, body, _) => qbe_count_arr_push_stmts(body, aname)
    EScope(_, body, _) | ESpawn(_, body, _) => qbe_count_arr_push_expr(body, aname)
    EInterp(parts, _) => {
      let mut n = 0
      let mut i = 0
      while i < parts.length() {
        n = n + qbe_count_arr_push_expr(parts[i], aname)
        i = i + 1
      }
      n
    }
    _ => 0
  }
}

///|
fn qbe_count_arr_push_stmts(stmts : Array[Stmt], aname : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => n = n + qbe_count_arr_push_expr(init, aname)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        n = n + qbe_count_arr_push_expr(lhs, aname) + qbe_count_arr_push_expr(rhs, aname)
      SExpr(e, _) => n = n + qbe_count_arr_push_expr(e, aname)
      SLetTuple(_, _, init, _) => n = n + qbe_count_arr_push_expr(init, aname)
      SWhile(c, b, _) | SGuard(c, b, _) =>
        n = n + qbe_count_arr_push_expr(c, aname) + qbe_count_arr_push_stmts(b, aname)
      SFor(init_s, c, step_s, b, _) =>
        n = n +
          qbe_count_arr_push_stmts([init_s], aname) +
          qbe_count_arr_push_expr(c, aname) +
          qbe_count_arr_push_stmts([step_s], aname) +
          qbe_count_arr_push_stmts(b, aname)
      SForRange(_, start_e, end_e, _, b, _) =>
        n = n +
          qbe_count_arr_push_expr(start_e, aname) +
          qbe_count_arr_push_expr(end_e, aname) +
          qbe_count_arr_push_stmts(b, aname)
      SForIn(_, _, it, b, _) =>
        n = n + qbe_count_arr_push_expr(it, aname) + qbe_count_arr_push_stmts(b, aname)
      SDebugAssert(c, msg, _) =>
        n = n + qbe_count_arr_push_expr(c, aname) + qbe_count_arr_push_expr(msg, aname)
      SReturn(ropt, _) =>
        match ropt {
          Some(re) => n = n + qbe_count_arr_push_expr(re, aname)
          None => ()
        }
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  n
}

///|
fn qbe_ident_only_push_recv_expr(e : Expr, name : String) -> Bool {
  match e {
    EIdent(n, _) => n != name
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EString(_, _)
    | EPath(_, _, _)
    | EUnit(_) => true
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_ident_only_push_recv_expr(inner, name)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_ident_only_push_recv_expr(l, name) &&
      qbe_ident_only_push_recv_expr(r, name)
    EMethodCall(obj, mname, args, _) => {
      if mname == "push" && args.length() == 1 {
        match obj {
          EIdent(n, _) =>
            if n == name {
              return !qbe_expr_mentions_ident(args[0], name)
            }
          _ => ()
        }
      }
      if !qbe_ident_only_push_recv_expr(obj, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_only_push_recv_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    ECall(callee, args, _) => {
      if !qbe_ident_only_push_recv_expr(callee, name) {
        return false
      }
      let mut i = 0
      while i < args.length() {
        if !qbe_ident_only_push_recv_expr(args[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ident_only_push_recv_expr(elems[i], name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(b) => if !qbe_ident_only_push_recv_expr(b, name) { return false }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if !qbe_ident_only_push_recv_expr(fields[i].value, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    EBlock(stmts, _) => qbe_ident_only_push_recv_stmts(stmts, name)
    EIf(c, t, el, _) => {
      if !qbe_ident_only_push_recv_expr(c, name) ||
        !qbe_ident_only_push_recv_stmts(t, name) {
        return false
      }
      match el {
        Some(ee) => qbe_ident_only_push_recv_expr(ee, name)
        None => true
      }
    }
    EMatch(s, arms, _) => {
      if !qbe_ident_only_push_recv_expr(s, name) {
        return false
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => if !qbe_ident_only_push_recv_expr(ge, name) { return false }
          None => ()
        }
        if !qbe_ident_only_push_recv_expr(arms[i].body, name) {
          return false
        }
        i = i + 1
      }
      true
    }
    _ => !qbe_expr_mentions_ident(e, name)
  }
}

///|
fn qbe_ident_only_push_recv_stmts(stmts : Array[Stmt], name : String) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SExpr(e, _) =>
        if !qbe_ident_only_push_recv_expr(e, name) {
          return false
        }
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        if !qbe_ident_only_push_recv_expr(init, name) {
          return false
        }
      SAssign(l, r, _) | SCompoundAssign(_, l, r, _) =>
        if !qbe_ident_only_push_recv_expr(l, name) ||
          !qbe_ident_only_push_recv_expr(r, name) {
          return false
        }
      SBreak(_) | SContinue(_) => ()
      _ =>
        if qbe_stmt_mentions_ident(stmts[i], name) {
          return false
        }
    }
    i = i + 1
  }
  true
}

///|
fn qbe_is_early_return_if(g : QbeGen, s : Stmt) -> Bool {
  match s {
    SExpr(EIf(icond, ithen, None, _), _) =>
      if ithen.length() > 0 &&
        qbe_loop_has_no_calls_expr(g, icond) &&
        !qbe_stmts_has_cf(ithen, true, true, false) {
        match ithen[ithen.length() - 1] {
          SReturn(_, _) => true
          _ => false
        }
      } else {
        false
      }
    _ => false
  }
}

///|
fn qbe_field_bce_collect_strs_expr(
  g : QbeGen,
  e : Expr,
  b_name : String,
  idx_f : String,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  match e {
    EMethodCall(EField(EIdent(bn, _), sf, _), mname, args, _) => {
      if bn == b_name && mname == "code_unit_at" && args.length() == 1 {
        match args[0] {
          EField(EIdent(bn2, _), idx2, _) =>
            if bn2 == b_name && idx2 == idx_f {
              let skey = b_name + "." + sf
              if g.hoisted_str_len.contains(skey) && !seen.contains(skey) {
                seen.set(skey, true)
                out.push(skey)
              }
            }
          _ => ()
        }
      }
      let mut i = 0
      while i < args.length() {
        qbe_field_bce_collect_strs_expr(g, args[i], b_name, idx_f, out, seen)
        i = i + 1
      }
    }
    EMethodCall(obj, _, args, _) => {
      qbe_field_bce_collect_strs_expr(g, obj, b_name, idx_f, out, seen)
      let mut i = 0
      while i < args.length() {
        qbe_field_bce_collect_strs_expr(g, args[i], b_name, idx_f, out, seen)
        i = i + 1
      }
    }
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | EField(inner, _, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      qbe_field_bce_collect_strs_expr(g, inner, b_name, idx_f, out, seen)
    EBinary(_, l, r, _) | EIndex(l, r, _) => {
      qbe_field_bce_collect_strs_expr(g, l, b_name, idx_f, out, seen)
      qbe_field_bce_collect_strs_expr(g, r, b_name, idx_f, out, seen)
    }
    EBlock(stmts, _) =>
      qbe_field_bce_collect_strs_stmts(g, stmts, b_name, idx_f, false, out, seen)
    EIf(cond, then_stmts, else_opt, _) => {
      qbe_field_bce_collect_strs_expr(g, cond, b_name, idx_f, out, seen)
      qbe_field_bce_collect_strs_stmts(g, then_stmts, b_name, idx_f, false, out, seen)
      match else_opt {
        Some(el) => qbe_field_bce_collect_strs_expr(g, el, b_name, idx_f, out, seen)
        None => ()
      }
    }
    _ => ()
  }
}

///|
fn qbe_field_bce_collect_strs_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  b_name : String,
  idx_f : String,
  skip_early_ret : Bool,
  out : Array[String],
  seen : Map[String, Bool],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    let st = stmts[i]
    if skip_early_ret && qbe_is_early_return_if(g, st) {
      match st {
        SExpr(EIf(icond, _, None, _), _) =>
          qbe_field_bce_collect_strs_expr(g, icond, b_name, idx_f, out, seen)
        _ => ()
      }
    } else {
      match st {
        SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
          qbe_field_bce_collect_strs_expr(g, init, b_name, idx_f, out, seen)
        SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
          qbe_field_bce_collect_strs_expr(g, lhs, b_name, idx_f, out, seen)
          qbe_field_bce_collect_strs_expr(g, rhs, b_name, idx_f, out, seen)
        }
        _ => ()
      }
    }
    i = i + 1
  }
}

///|
fn qbe_field_bce_body_safe_in(
  g : QbeGen,
  stmts : Array[Stmt],
  b_name : String,
  idx_f : String,
  skip_early_ret : Bool,
  modified_in : Int,
) -> Int {
  let mut m = modified_in
  let mut i = 0
  while i < stmts.length() {
    let st = stmts[i]
    if skip_early_ret && qbe_is_early_return_if(g, st) {
      match st {
        SExpr(EIf(icond, _, None, _), _) =>
          if qbe_expr_has_assign(icond) || (m == 1 && qbe_expr_mentions_ident(icond, b_name)) {
            return -1
          }
        _ => return -1
      }
      i = i + 1
      continue
    }
    match st {
      SAssign(EField(EIdent(v, _), f, _), rhs, _) =>
        if v == b_name && f == idx_f {
          if m == 1 {
            return -1
          }
          match rhs {
            EBinary("+", EField(EIdent(v2, _), f2, _), EInt(raw, _), _) =>
              if v2 == b_name && f2 == idx_f && qbe_parse_int64_lit(raw) == 1L {
                m = 1
              } else {
                return -1
              }
            _ => return -1
          }
        } else if qbe_expr_has_assign(rhs) || (m == 1 && qbe_expr_mentions_ident(rhs, b_name)) {
          return -1
        }
      SCompoundAssign(op, EField(EIdent(v, _), f, _), rhs, _) =>
        if v == b_name && f == idx_f {
          if m == 1 || op != "+" {
            return -1
          }
          match rhs {
            EInt(raw, _) =>
              if qbe_parse_int64_lit(raw) == 1L {
                m = 1
              } else {
                return -1
              }
            _ => return -1
          }
        } else if qbe_expr_has_assign(rhs) || (m == 1 && qbe_expr_mentions_ident(rhs, b_name)) {
          return -1
        }
      SExpr(EIf(icond, ithen, ielse_opt, _), _) => {
        if qbe_expr_has_assign(icond) || (m == 1 && qbe_expr_mentions_ident(icond, b_name)) {
          return -1
        }
        let mt = qbe_field_bce_body_safe_in(g, ithen, b_name, idx_f, false, m)
        if mt < 0 {
          return -1
        }
        let me = match ielse_opt {
          None => m
          Some(EBlock(es, _)) => qbe_field_bce_body_safe_in(g, es, b_name, idx_f, false, m)
          Some(el) => qbe_field_bce_body_safe_in(g, [SExpr(el, span_new("", 0, 0))], b_name, idx_f, false, m)
        }
        if me < 0 {
          return -1
        }
        if mt == 1 || me == 1 {
          m = 1
        }
      }
      SBreak(_) | SContinue(_) => ()
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) | SExpr(init, _) =>
        if qbe_expr_has_assign(init) || (m == 1 && qbe_expr_mentions_ident(init, b_name)) {
          return -1
        }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if qbe_expr_has_assign(lhs) ||
          qbe_expr_has_assign(rhs) ||
          (m == 1 && (qbe_expr_mentions_ident(lhs, b_name) || qbe_expr_mentions_ident(rhs, b_name))) {
          return -1
        }
      _ => return -1
    }
    i = i + 1
  }
  m
}

///|
fn qbe_emit_field_promoted_body(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
  b_name : String,
  b_ptr : String,
  prom_fields : Array[QbePromField],
  slots : Array[String],
  has_early_ret : Bool,
  l_loop : String,
  l_lcond : String,
  l_wb : String,
  fp_bce_keys : Array[String],
) -> Unit {
  let mut bki = 0
  while bki < fp_bce_keys.length() {
    g.bce_safe_indices.set(fp_bce_keys[bki], "1")
    bki = bki + 1
  }
  qbe_emit_lbl(g, l_loop)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_wb)
  g.loop_conts.push(l_lcond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  if !has_early_ret {
    let bv = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, bv.reg, bv.ty)
    }
  } else {
    let mut si = 0
    while si < body.length() {
      if g.block_term {
        break
      }
      let st = body[si]
      if qbe_is_early_return_if(g, st) {
        match st {
          SExpr(EIf(icond, ithen, None, _), _) => {
            let l_eret = qbe_lbl(g, "wh_peret")
            let l_enext = qbe_lbl(g, "wh_penext")
            qbe_emit_cond_branch(g, icond, l_eret, l_enext)
            qbe_emit_lbl(g, l_eret)
            bki = 0
            while bki < fp_bce_keys.length() {
              g.bce_safe_indices.remove(fp_bce_keys[bki])
              bki = bki + 1
            }
            let mut fi2 = 0
            while fi2 < prom_fields.length() {
              let pf = prom_fields[fi2]
              let v = qbe_load_local_slot(g, slots[fi2], pf.ty)
              let fp = qbe_tmp(g)
              qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
              qbe_store_heap_slot(g, v, fp, pf.ty)
              let pkey = b_name + "." + pf.name
              g.promoted_fields.remove(pkey)
              g.promoted_field_tys.remove(pkey)
              fi2 = fi2 + 1
            }
            qbe_scope_push(g)
            let _ = qbe_emit_stmts(g, ithen, None)
            qbe_scope_pop(g)
            fi2 = 0
            while fi2 < prom_fields.length() {
              let pf = prom_fields[fi2]
              let pkey = b_name + "." + pf.name
              g.promoted_fields.set(pkey, slots[fi2])
              g.promoted_field_tys.set(pkey, pf.ty)
              fi2 = fi2 + 1
            }
            bki = 0
            while bki < fp_bce_keys.length() {
              g.bce_safe_indices.set(fp_bce_keys[bki], "1")
              bki = bki + 1
            }
            qbe_emit_lbl(g, l_enext)
          }
          _ => ()
        }
      } else {
        let is_last = si == body.length() - 1
        let sv = qbe_emit_stmt(g, st, None, is_last)
        if !g.block_term {
          qbe_rc_dec(g, sv.reg, sv.ty)
        }
      }
      si = si + 1
    }
  }
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_lcond)
  qbe_emit_lbl(g, l_lcond)
  qbe_emit_cond_branch(g, cond, l_loop, l_wb)
  g.hot_loop_depth = g.hot_loop_depth - 1
  bki = 0
  while bki < fp_bce_keys.length() {
    g.bce_safe_indices.remove(fp_bce_keys[bki])
    bki = bki + 1
  }
}

///|
fn qbe_try_emit_while_field_promoted(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() == 0 ||
    !qbe_is_pure_small_cond(cond, 12) ||
    !qbe_loop_has_no_calls_expr(g, cond) ||
    qbe_stmts_has_nested_loop(body) {
    return false
  }
  let mut has_early_ret = false
  let body_hints = qbe_hints_new()
  let mut bci = 0
  while bci < body.length() {
    let st = body[bci]
    if qbe_is_early_return_if(g, st) {
      has_early_ret = true
    } else if !qbe_loop_has_no_calls_stmt_with(g, st, body_hints) ||
      qbe_stmt_has_cf(st, false, false, true) {
      return false
    }
    match st {
      SLet(name, _, te, init, let_sp) =>
        if name != "_" {
          let mut bound_ty = TError
          match te {
            TyMissing(_) =>
              match qbe_let_infer(g, let_sp) {
                Some(t) => bound_ty = t
                None =>
                  match qbe_probe_expr_ty_with(g, init, body_hints) {
                    Some(t) =>
                      if !ty_has_unresolved(t) {
                        bound_ty = t
                      }
                    None => ()
                  }
              }
            _ => bound_ty = qbe_resolve_type(g, te)
          }
          match bound_ty {
            TError => ()
            _ => qbe_hints_set(body_hints, name, bound_ty)
          }
        }
      _ => ()
    }
    bci = bci + 1
  }
  let write_vars : Array[String] = []
  let write_fields : Array[String] = []
  let read_vars : Array[String] = []
  let read_fields : Array[String] = []
  let all_vars : Array[String] = []
  let seen_all : Map[String, Bool] = Map([])
  if !qbe_collect_field_access_expr(
    cond,
    write_vars,
    write_fields,
    read_vars,
    read_fields,
    all_vars,
    seen_all,
  ) {
    return false
  }
  bci = 0
  while bci < body.length() {
    let st = body[bci]
    if has_early_ret && qbe_is_early_return_if(g, st) {
      match st {
        SExpr(EIf(icond, _, None, _), _) =>
          if !qbe_collect_field_access_expr(
            icond,
            write_vars,
            write_fields,
            read_vars,
            read_fields,
            all_vars,
            seen_all,
          ) {
            return false
          }
        _ => ()
      }
    } else if !qbe_collect_field_access_stmt(
      st,
      write_vars,
      write_fields,
      read_vars,
      read_fields,
      all_vars,
      seen_all,
    ) {
      return false
    }
    bci = bci + 1
  }
  if write_vars.length() == 0 {
    return false
  }
  // Find an outer struct variable `b` with at least one primitive field both read and written
  let mut b_name = ""
  let mut b_slot = ""
  let mut b_sname = ""
  let mut b_sargs : Array[Ty] = []
  let mut wi = 0
  while wi < write_vars.length() {
    let cand = write_vars[wi]
    if !qbe_expr_assigns_ident(cond, cand) &&
      !qbe_stmts_assigns_ident(body, cand) &&
      !qbe_expr_rebinds_ident(cond, cand) &&
      !qbe_stmts_rebinds_ident(body, cand) {
      match qbe_lookup_local(g, cand) {
        Some(loc) =>
          if !loc.is_cell {
          match loc.ty {
            TStruct(sn, sa) => {
              b_name = cand
              b_slot = loc.slot
              b_sname = sn
              b_sargs = sa
              break
            }
            _ => ()
          }
          }
        None => ()
      }
    }
    wi = wi + 1
  }
  if b_name == "" {
    return false
  }
  // Check all other variables with field accesses in `body`: must be at most 1 (`b2`)
  let mut has_b2 = false
  let mut b2_name = ""
  let mut ai = 0
  while ai < all_vars.length() {
    let vn = all_vars[ai]
    if vn != b_name {
      if has_b2 {
        return false
      }
      has_b2 = true
      b2_name = vn
    }
    ai = ai + 1
  }
  let mut b2_idx = -1
  if has_b2 {
    if has_early_ret {
      return false
    }
    if qbe_stmts_has_cf(body, true, true, false) {
      return false
    }
    if qbe_stmts_assigns_ident(body, b2_name) {
      return false
    }
    let mut b2_count = 0
    let mut si = 0
    while si < body.length() {
      match body[si] {
        SLet(ln, is_mut, _, init, _) =>
          if ln == b2_name {
            if is_mut || qbe_expr_has_assign(init) {
              return false
            }
            b2_idx = si
            b2_count = b2_count + 1
          }
        _ => ()
      }
      si = si + 1
    }
    if b2_count != 1 || b2_idx < 0 {
      return false
    }
    // Ensure body[0 .. b2_idx - 1] has only pure SLet with no assignments, and b2 is not rebound later
    si = 0
    while si < b2_idx {
      match body[si] {
        SLet(_, _, _, init, _) =>
          if qbe_expr_has_assign(init) {
            return false
          }
        _ => return false
      }
      si = si + 1
    }
    si = b2_idx + 1
    while si < body.length() {
      if qbe_stmt_rebinds_ident(body[si], b2_name) {
        return false
      }
      si = si + 1
    }
    // Also ensure body[0 .. b2_idx] does not read any field of `b_name`
    let pre_wvars : Array[String] = []
    let pre_wfields : Array[String] = []
    let pre_rvars : Array[String] = []
    let pre_rfields : Array[String] = []
    let pre_all : Array[String] = []
    let pre_seen : Map[String, Bool] = Map([])
    si = 0
    while si <= b2_idx {
      let _ = qbe_collect_field_access_stmt(
        body[si],
        pre_wvars,
        pre_wfields,
        pre_rvars,
        pre_rfields,
        pre_all,
        pre_seen,
      )
      si = si + 1
    }
    if pre_seen.contains(b_name) {
      return false
    }
  }
  // Collect promotable primitive fields of `b_name` (both read and written)
  let sinfo = match qbe_lookup_struct_info(g, b_sname) {
    Some(si) => si
    None => return false
  }
  let subst = make_subst(sinfo.decl.type_params, b_sargs)
  let prom_fields : Array[QbePromField] = []
  let prom_seen : Map[String, Bool] = Map([])
  wi = 0
  while wi < write_vars.length() {
    if write_vars[wi] == b_name {
      let fname = write_fields[wi]
      let pkey = b_name + "." + fname
      if !prom_seen.contains(fname) &&
        !g.promoted_fields.contains(pkey) &&
        !g.hoisted_fields.contains(pkey) {
        // Must also be read on `b_name`
        let mut is_read = false
        let mut ri = 0
        while ri < read_vars.length() {
          if read_vars[ri] == b_name && read_fields[ri] == fname {
            is_read = true
            break
          }
          ri = ri + 1
        }
        if is_read {
          let mut fi = 0
          while fi < sinfo.field_names.length() {
            if sinfo.field_names[fi] == fname {
              let fty = subst_ty(sinfo.field_tys[fi], subst)
              let is_prom_ty = match fty {
                TDouble | TFloat | TInt | TInt64 | TUInt | TUInt64 => true
                _ => false
              }
              if is_prom_ty {
                prom_seen.set(fname, true)
                prom_fields.push(QbePromField::{
                  name: fname,
                  field_idx: fi,
                  ty: fty,
                })
              }
              break
            }
            fi = fi + 1
          }
        }
      }
    }
    wi = wi + 1
  }
  if prom_fields.length() == 0 {
    return false
  }

  // Check if `!has_b2` loop qualifies for pre-loop string BCE versioning:
  // `while b.idx_f < bound` where `b.idx_f` is a promoted `Int` field that only
  // increments by +1 after any read, and `b.sf.code_unit_at(b.idx_f)` reads a hoisted string.
  let mut fp_bce_idx_pi = -1
  let mut fp_bce_idx_f = ""
  let mut fp_bce_bound_opt : Option[Expr] = None
  let fp_bce_str_keys : Array[String] = []
  let fp_bce_keys : Array[String] = []
  if !has_b2 {
    match cond {
      EBinary("<", EField(EIdent(cn, _), cf, _), bound_e, _) =>
        if cn == b_name {
          let mut pfi = 0
          while pfi < prom_fields.length() {
            if prom_fields[pfi].name == cf && qbe_is_int32_ty(prom_fields[pfi].ty) {
              fp_bce_idx_pi = pfi
              fp_bce_idx_f = cf
              break
            }
            pfi = pfi + 1
          }
          if fp_bce_idx_pi >= 0 {
            let bound_ok = match bound_e {
              EField(EIdent(bn2, _), lf, _) =>
                bn2 == b_name && g.hoisted_fields.contains(b_name + "." + lf)
              EInt(_, _) => true
              EIdent(ln, _) =>
                !qbe_stmts_assigns_ident(body, ln) &&
                !qbe_stmts_rebinds_ident(body, ln) &&
                match qbe_lookup_local(g, ln) {
                  Some(lloc) => !lloc.is_cell && qbe_is_int32_ty(lloc.ty)
                  None => false
                }
              _ => false
            }
            if bound_ok &&
              qbe_field_bce_body_safe_in(g, body, b_name, cf, has_early_ret, 0) >= 0 {
              let seen_s : Map[String, Bool] = Map([])
              qbe_field_bce_collect_strs_stmts(
                g,
                body,
                b_name,
                cf,
                has_early_ret,
                fp_bce_str_keys,
                seen_s,
              )
              if fp_bce_str_keys.length() > 0 {
                fp_bce_bound_opt = Some(bound_e)
                let mut ski = 0
                while ski < fp_bce_str_keys.length() {
                  let bkey = b_name + "." + cf + ":" + fp_bce_str_keys[ski]
                  if !g.bce_safe_indices.contains(bkey) {
                    fp_bce_keys.push(bkey)
                  }
                  ski = ski + 1
                }
              }
            }
          }
        }
      _ => ()
    }
  }
  let do_fp_bce = fp_bce_keys.length() > 0

  let l_init = qbe_lbl(g, "wh_pinit")
  let l_fast = qbe_lbl(g, "wh_pb")
  let l_fcond = if has_b2 { "" } else { qbe_lbl(g, "wh_pcond") }
  let l_pfb = if do_fp_bce { qbe_lbl(g, "wh_pfb") } else { "" }
  let l_pfcond = if do_fp_bce { qbe_lbl(g, "wh_pfcond") } else { "" }
  let l_wb = qbe_lbl(g, "wh_pwb")
  let l_end = qbe_lbl(g, "wh_e")
  let l_cont = if has_b2 { qbe_lbl(g, "wh_pc") } else { "" }
  let l_bail = if has_b2 { qbe_lbl(g, "wh_pbail") } else { "" }
  let l_slow = if has_b2 { qbe_lbl(g, "wh_pslow") } else { "" }

  // Entry guard
  qbe_emit_cond_branch(g, cond, l_init, l_end)

  // Pre-loop promotion init: load b_ptr and initial field values into local slots
  qbe_emit_lbl(g, l_init)
  let b_ptr = qbe_tmp(g)
  qbe_emit(g, b_ptr + " =l loadl " + b_slot)
  let slots : Array[String] = []
  let mut init_pos_reg = ""
  let mut pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let slot = qbe_alloc_slot_for(g, pf.ty)
    slots.push(slot)
    let fp = qbe_tmp(g)
    qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
    let fv = qbe_load_heap_slot(g, fp, pf.ty)
    qbe_store_local_slot(g, fv, slot, pf.ty)
    if pi == fp_bce_idx_pi {
      init_pos_reg = fv
    }
    pi = pi + 1
  }
  if do_fp_bce {
    match fp_bce_bound_opt {
      Some(be) => {
        let mut ok_reg = qbe_tmp(g)
        qbe_emit(g, ok_reg + " =w csgew " + init_pos_reg + ", 0")
        let bv = qbe_emit_expr(g, be, Some(TInt))
        let bl = qbe_as_l(g, bv)
        let mut ski = 0
        while ski < fp_bce_str_keys.length() {
          match g.hoisted_str_len.get(fp_bce_str_keys[ski]) {
            Some(slen) => {
              let chk = qbe_tmp(g)
              let nxt = qbe_tmp(g)
              qbe_emit(g, chk + " =w cslel " + bl + ", " + slen)
              qbe_emit(g, nxt + " =w and " + ok_reg + ", " + chk)
              ok_reg = nxt
            }
            None => ()
          }
          ski = ski + 1
        }
        qbe_emit_term(g, "jnz " + ok_reg + ", " + l_pfb + ", " + l_fast)
      }
      None => qbe_emit_term(g, "jmp " + l_fast)
    }
  } else {
    qbe_emit_term(g, "jmp " + l_fast)
  }

  // Activate promoted field mappings for the fast loop
  pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let pkey = b_name + "." + pf.name
    g.promoted_fields.set(pkey, slots[pi])
    g.promoted_field_tys.set(pkey, pf.ty)
    pi = pi + 1
  }

  // Fast bottom-tested loop
  let bail_locals : Array[QbeLocal] = []
  if has_b2 {
    qbe_emit_lbl(g, l_fast)
    g.hot_loop_depth = g.hot_loop_depth + 1
    qbe_scope_push(g)
    let loop_pinned_b2 : Array[String] = []
    let mut si = 0
    while si <= b2_idx {
      if g.block_term {
        break
      }
      let is_last = si == body.length() - 1
      if !is_last {
        let bf_os = qbe_try_emit_borrowed_field_let(g, body, si)
        if bf_os != "" {
          qbe_pin_slot(g, bf_os, loop_pinned_b2)
          si = si + 1
          continue
        }
        if qbe_try_emit_borrowed_arr_elem_let(g, body, si) ||
          qbe_try_emit_stack_pod_let(g, body, si) {
          si = si + 1
          continue
        }
      }
      let sv = qbe_emit_stmt(g, body[si], None, is_last)
      if !g.block_term {
        qbe_rc_dec(g, sv.reg, sv.ty)
      }
      si = si + 1
    }
    // Snapshot scope locals bound in body[0 .. b2_idx] for alias bailout cleanup
    let cur_sc = g.scopes[g.scopes.length() - 1]
    let mut li = 0
    while li < cur_sc.locals.length() {
      bail_locals.push(cur_sc.locals[li])
      li = li + 1
    }
    let b2_slot = match qbe_lookup_local(g, b2_name) {
      Some(b2loc) => b2loc.slot
      None => ""
    }
    let b2_ptr = qbe_tmp(g)
    let is_alias = qbe_tmp(g)
    qbe_emit(g, b2_ptr + " =l loadl " + b2_slot)
    qbe_emit(g, is_alias + " =w ceql " + b_ptr + ", " + b2_ptr)
    qbe_emit_term(g, "jnz " + is_alias + ", " + l_bail + ", " + l_cont)
    qbe_emit_lbl(g, l_cont)
    si = b2_idx + 1
    while si < body.length() {
      if g.block_term {
        break
      }
      let is_last = si == body.length() - 1
      if !is_last {
        let bf_os = qbe_try_emit_borrowed_field_let(g, body, si)
        if bf_os != "" {
          qbe_pin_slot(g, bf_os, loop_pinned_b2)
          si = si + 1
          continue
        }
        if qbe_try_emit_borrowed_arr_elem_let(g, body, si) ||
          qbe_try_emit_stack_pod_let(g, body, si) {
          si = si + 1
          continue
        }
      }
      let sv = qbe_emit_stmt(g, body[si], None, is_last)
      if !g.block_term {
        qbe_rc_dec(g, sv.reg, sv.ty)
      }
      si = si + 1
    }
    qbe_unpin_slot_list(g, loop_pinned_b2)
    qbe_scope_pop(g)
    qbe_emit_cond_branch(g, cond, l_fast, l_wb)
    g.hot_loop_depth = g.hot_loop_depth - 1
  } else {
    if do_fp_bce {
      qbe_emit_field_promoted_body(
        g,
        cond,
        body,
        b_name,
        b_ptr,
        prom_fields,
        slots,
        has_early_ret,
        l_pfb,
        l_pfcond,
        l_wb,
        fp_bce_keys,
      )
    }
    qbe_emit_field_promoted_body(
      g,
      cond,
      body,
      b_name,
      b_ptr,
      prom_fields,
      slots,
      has_early_ret,
      l_fast,
      l_fcond,
      l_wb,
      [],
    )
  }

  // Clear promoted field mappings
  pi = 0
  while pi < prom_fields.length() {
    let pkey = b_name + "." + prom_fields[pi].name
    g.promoted_fields.remove(pkey)
    g.promoted_field_tys.remove(pkey)
    pi = pi + 1
  }

  // Normal exit writeback
  qbe_emit_lbl(g, l_wb)
  pi = 0
  while pi < prom_fields.length() {
    let pf = prom_fields[pi]
    let v = qbe_load_local_slot(g, slots[pi], pf.ty)
    let fp = qbe_tmp(g)
    qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
    qbe_store_heap_slot(g, v, fp, pf.ty)
    pi = pi + 1
  }
  qbe_emit_term(g, "jmp " + l_end)

  // Cold alias bailout + unpromoted slow loop
  if has_b2 {
    qbe_emit_lbl(g, l_bail)
    qbe_release_scope_locals(g, QbeScope::{ locals: bail_locals })
    pi = 0
    while pi < prom_fields.length() {
      let pf = prom_fields[pi]
      let v = qbe_load_local_slot(g, slots[pi], pf.ty)
      let fp = qbe_tmp(g)
      qbe_emit(g, fp + " =l add " + b_ptr + ", " + (pf.field_idx * 8).to_string())
      qbe_store_heap_slot(g, v, fp, pf.ty)
      pi = pi + 1
    }
    qbe_emit_term(g, "jmp " + l_slow)

    qbe_emit_lbl(g, l_slow)
    g.hot_loop_depth = g.hot_loop_depth + 1
    qbe_scope_push(g)
    let sbv = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, sbv.reg, sbv.ty)
    }
    qbe_scope_pop(g)
    qbe_emit_cond_branch(g, cond, l_slow, l_end)
    g.hot_loop_depth = g.hot_loop_depth - 1
  }

  qbe_emit_lbl(g, l_end)
  true
}


///|
fn qbe_pure_int_expr_eq(a : Expr, b : Expr) -> Bool {
  match a {
    EMove(ia, _) => return qbe_pure_int_expr_eq(ia, b)
    _ => ()
  }
  match b {
    EMove(ib, _) => return qbe_pure_int_expr_eq(a, ib)
    _ => ()
  }
  match a {
    EInt(ra, _) =>
      match b {
        EInt(rb, _) => qbe_parse_int64_lit(ra) == qbe_parse_int64_lit(rb)
        _ => false
      }
    EIdent(na, _) =>
      match b {
        EIdent(nb, _) => na == nb
        _ => false
      }
    EUnary(oa, ia, _) =>
      match b {
        EUnary(ob, ib, _) => oa == ob && qbe_pure_int_expr_eq(ia, ib)
        _ => false
      }
    EBinary(oa, la, ra, _) =>
      match b {
        EBinary(ob, lb, rb, _) =>
          if oa != ob {
            false
          } else if qbe_pure_int_expr_eq(la, lb) && qbe_pure_int_expr_eq(ra, rb) {
            true
          } else if oa == "+" || oa == "*" || oa == "&" || oa == "|" || oa == "^" {
            qbe_pure_int_expr_eq(la, rb) && qbe_pure_int_expr_eq(ra, lb)
          } else {
            false
          }
        _ => false
      }
    EField(ba, fa, _) =>
      match b {
        EField(bb, fb, _) => fa == fb && qbe_pure_int_expr_eq(ba, bb)
        _ => false
      }
    _ => false
  }
}

///|
fn qbe_is_expr_plus_minus_one(base : Expr, other : Expr) -> Bool {
  match other {
    EMove(inner, _) => qbe_is_expr_plus_minus_one(base, inner)
    EBinary("+", x, EInt(raw, _), _) =>
      qbe_parse_int64_lit(raw) == 1L && qbe_pure_int_expr_eq(base, x)
    EBinary("+", EInt(raw, _), x, _) =>
      qbe_parse_int64_lit(raw) == 1L && qbe_pure_int_expr_eq(base, x)
    EBinary("-", x, EInt(raw, _), _) =>
      qbe_parse_int64_lit(raw) == 1L && qbe_pure_int_expr_eq(base, x)
    _ => false
  }
}

///|
fn qbe_are_consecutive_int_exprs(l : Expr, r : Expr) -> Bool {
  qbe_is_expr_plus_minus_one(l, r) || qbe_is_expr_plus_minus_one(r, l)
}

///|
fn qbe_expr_unroll4_safe(g : QbeGen, e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EIdent(_, _)
    | EUnit(_) => true
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _) => qbe_expr_unroll4_safe(g, inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_unroll4_safe(g, l) && qbe_expr_unroll4_safe(g, r)
    EMethodCall(recv, mname, args, msp) => {
      if qbe_has_expected_trait(g, msp) {
        return false
      }
      let ok_m = mname == "to_double" ||
        mname == "to_float" ||
        mname == "to_int" ||
        mname == "to_int64" ||
        mname == "to_uint" ||
        mname == "to_uint64" ||
        mname == "to_byte" ||
        mname == "sqrt" ||
        mname == "abs" ||
        mname == "floor" ||
        mname == "ceil" ||
        mname == "round" ||
        mname == "trunc" ||
        mname == "rotate_left" ||
        mname == "rotate_right" ||
        mname == "leading_zeros" ||
        mname == "trailing_zeros" ||
        mname == "count_ones" ||
        mname == "lnot" ||
        mname == "is_nan" ||
        mname == "is_inf" ||
        mname == "is_finite" ||
        mname == "compare" ||
        mname == "length"
      if !ok_m || !qbe_expr_unroll4_safe(g, recv) {
        return false
      }
      let mut ai = 0
      while ai < args.length() {
        if !qbe_expr_unroll4_safe(g, args[ai]) {
          return false
        }
        ai = ai + 1
      }
      true
    }
    ECall(callee, args, _) => {
      let mut ai = 0
      while ai < args.length() {
        if !qbe_expr_unroll4_safe(g, args[ai]) {
          return false
        }
        ai = ai + 1
      }
      match callee {
        EIdent(cname, _) =>
          match g.inline_fns.get(cname) {
            Some(fd) => {
              let mut pi = 0
              while pi < fd.params.length() {
                if fd.params[pi].is_mut {
                  return false
                }
                pi = pi + 1
              }
              if qbe_stmts_has_cf(fd.body, true, true, true) ||
                qbe_stmts_has_nested_loop(fd.body) {
                return false
              }
              let ic = qbe_stmts_inline_cost_in(fd.body, cname, false, 0)
              ic >= 0 && ic <= 20
            }
            None => false
          }
        _ => false
      }
    }
    _ => false
  }
}

///|
fn qbe_stmts_unroll4_safe(g : QbeGen, stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if !qbe_expr_unroll4_safe(g, lhs) || !qbe_expr_unroll4_safe(g, rhs) {
          return false
        }
      SExpr(e, _) =>
        match e {
          EIf(icond, ithen, None, _) =>
            if !(qbe_can_branchless_inc_if(g, icond, ithen) &&
              qbe_expr_unroll4_safe(g, icond)) {
              return false
            }
          _ =>
            if !qbe_expr_unroll4_safe(g, e) {
              return false
            }
        }
      SLet(_, _, _, init, _) => {
        if !qbe_expr_unroll4_safe(g, init) {
          return false
        }
        match qbe_probe_expr_ty(g, init) {
          Some(t) =>
            if !qbe_is_prim_array_elem(t) {
              return false
            }
          None => ()
        }
      }
      _ => return false
    }
    i = i + 1
  }
  true
}

///|
fn qbe_can_unroll4_fast_while(
  g : QbeGen,
  body : Array[Stmt],
  step_slot : String,
  extra_cond : Option[Expr],
) -> Bool {
  let _ = step_slot
  if !g.release {
    return false
  }
  match extra_cond {
    Some(_) => return false
    None => ()
  }
  if body.length() < 1 || body.length() > 6 {
    return false
  }
  if qbe_stmts_has_cf(body, true, true, true) || qbe_stmts_has_nested_loop(body) {
    return false
  }
  let cost = qbe_stmts_inline_cost_in(body, "", false, 0)
  if cost < 1 || cost > 24 {
    return false
  }
  qbe_stmts_unroll4_safe(g, body)
}

///|
fn qbe_expr_is_even_int(e : Expr) -> Bool {
  match e {
    EInt(raw, _) => (qbe_parse_int64_lit(raw) & 1L) == 0L
    EUnary("-", inner, _) | EMove(inner, _) => qbe_expr_is_even_int(inner)
    EBinary("*", l, r, _) =>
      qbe_expr_is_even_int(l) ||
      qbe_expr_is_even_int(r) ||
      qbe_are_consecutive_int_exprs(l, r)
    EBinary("<<", _, EInt(raw, _), _) => {
      let sh = qbe_parse_int64_lit(raw)
      sh >= 1L && sh <= 31L
    }
    EBinary("+", l, r, _) | EBinary("-", l, r, _) =>
      qbe_expr_is_even_int(l) && qbe_expr_is_even_int(r)
    _ => false
  }
}

///|
fn qbe_expr_is_pure_arith(e : Expr) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EDouble(_, _)
    | EFloat(_, _)
    | EBool(_, _)
    | EByte(_, _)
    | EChar(_, _)
    | EIdent(_, _) => true
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) =>
      qbe_expr_is_pure_arith(inner)
    EBinary(op, l, r, _) =>
      if op == "/" || op == "%" {
        false
      } else {
        qbe_expr_is_pure_arith(l) && qbe_expr_is_pure_arith(r)
      }
    _ => false
  }
}

///|
fn qbe_expr_bare_reads_ident(e : Expr, name : String) -> Bool {
  match e {
    EIdent(n, _) => n == name
    EBinary("*", EIdent(a, _), EIdent(b, _), _) =>
      if a == name && b == name {
        false
      } else {
        a == name || b == name
      }
    EBinary(_, l, r, _) =>
      qbe_expr_bare_reads_ident(l, name) || qbe_expr_bare_reads_ident(r, name)
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) =>
      qbe_expr_bare_reads_ident(inner, name)
    _ => false
  }
}

///|
fn qbe_try_emit_while_sq_reuse(
  g : QbeGen,
  cond : Expr,
  body : Array[Stmt],
) -> Bool {
  if body.length() < 2 ||
    !qbe_loop_has_no_calls_expr(g, cond) ||
    !qbe_loop_has_no_calls_stmts(g, body) ||
    qbe_stmts_has_nested_loop(body) ||
    qbe_stmts_has_cf(body, false, true, false) {
    return false
  }
  let cands : Array[QbeSqCand] = []
  let seen : Map[String, Bool] = Map([])
  let mut si = 0
  while si < body.length() {
    match body[si] {
      SAssign(EIdent(vname, _), rhs, _) =>
        if !seen.contains(vname) &&
          !g.sq_reuse_slot.contains(vname) &&
          !qbe_stmts_rebinds_ident(body, vname) &&
          !qbe_expr_assigns_ident(rhs, vname) &&
          qbe_stmts_count_assigns_ident(body, vname) == 1 {
          match qbe_lookup_local(g, vname) {
            Some(vloc) =>
              if !vloc.is_cell && qbe_is_double_ty(vloc.ty) {
                // Must have v * v in body[0 .. si - 1]
                let mut has_before = false
                let mut bi = 0
                while bi < si {
                  if qbe_stmt_has_sq(body[bi], vname) {
                    has_before = true
                    break
                  }
                  bi = bi + 1
                }
                if has_before {
                  if !qbe_expr_mentions_ident(cond, vname) {
                    // Must have an unconditionally-executed v * v in body[si + 1 .. len - 1]
                    // with no earlier branch-only v * v and no earlier break/return
                    let mut has_after = false
                    let mut ok_after = true
                    let mut ai = si + 1
                    while ai < body.length() {
                      if qbe_stmt_uncond_has_sq(body[ai], vname) {
                        has_after = true
                        break
                      }
                      if qbe_stmt_has_branch_sq(body[ai], vname) ||
                        qbe_stmt_has_cf(body[ai], true, true, true) {
                        ok_after = false
                        break
                      }
                      ai = ai + 1
                    }
                    if has_after && ok_after {
                      seen.set(vname, true)
                      cands.push(QbeSqCand::{
                        name: vname,
                        assign_idx: si,
                        recompute_at_assign: false,
                      })
                    }
                  } else if qbe_expr_has_sq(cond, vname) &&
                    !qbe_expr_assigns_ident(cond, vname) {
                    // Condition and body share `v * v`: recompute square right after assign
                    seen.set(vname, true)
                    cands.push(QbeSqCand::{
                      name: vname,
                      assign_idx: si,
                      recompute_at_assign: true,
                    })
                  }
                }
              }
            None => ()
          }
        }
      _ => ()
    }
    si = si + 1
  }
  if cands.length() == 0 {
    return false
  }

  let mut has_cond_cand = false
  let mut has_non_cond_cand = false
  let mut ci = 0
  while ci < cands.length() {
    if cands[ci].recompute_at_assign {
      has_cond_cand = true
    } else {
      has_non_cond_cand = true
    }
    ci = ci + 1
  }

  let rotated = qbe_is_pure_small_cond(cond, 16)
  let l_init = qbe_lbl(g, "wh_sqi")
  let l_body = qbe_lbl(g, "wh_b")
  let l_cond = qbe_lbl(g, "wh_c")
  let l_end = qbe_lbl(g, "wh_e")

  // Initialize condition-shared candidates before the entry condition check
  if has_cond_cand {
    ci = 0
    while ci < cands.length() {
      if cands[ci].recompute_at_assign {
        let cname = cands[ci].name
        let cslot = match qbe_lookup_local(g, cname) {
          Some(cloc) => cloc.slot
          None => ""
        }
        let sq_slot = qbe_alloc_slot_for(g, TDouble)
        let v0 = qbe_tmp(g)
        let sq0 = qbe_tmp(g)
        qbe_emit(g, v0 + " =d loadd " + cslot)
        qbe_emit(g, sq0 + " =d mul " + v0 + ", " + v0)
        qbe_emit(g, "stored " + sq0 + ", " + sq_slot)
        g.sq_reuse_slot.set(cname, sq_slot)
        g.sq_reuse_state.set(cname, 1)
      }
      ci = ci + 1
    }
  }

  if rotated {
    if has_non_cond_cand {
      qbe_emit_cond_branch(g, cond, l_init, l_end)
      qbe_emit_lbl(g, l_init)
    } else {
      qbe_emit_cond_branch(g, cond, l_body, l_end)
    }
  }
  if has_non_cond_cand {
    ci = 0
    while ci < cands.length() {
      if !cands[ci].recompute_at_assign {
        let cname = cands[ci].name
        let cslot = match qbe_lookup_local(g, cname) {
          Some(cloc) => cloc.slot
          None => ""
        }
        let sq_slot = qbe_alloc_slot_for(g, TDouble)
        let v0 = qbe_tmp(g)
        let sq0 = qbe_tmp(g)
        qbe_emit(g, v0 + " =d loadd " + cslot)
        qbe_emit(g, sq0 + " =d mul " + v0 + ", " + v0)
        qbe_emit(g, "stored " + sq0 + ", " + sq_slot)
        g.sq_reuse_slot.set(cname, sq_slot)
        g.sq_reuse_state.set(cname, 1)
      }
      ci = ci + 1
    }
  }

  if rotated {
    if has_non_cond_cand {
      qbe_emit_term(g, "jmp " + l_body)
    }
  } else {
    qbe_emit_term(g, "jmp " + l_cond)
    qbe_emit_lbl(g, l_cond)
    qbe_emit_cond_branch(g, cond, l_body, l_end)
  }

  // Reorder adjacent pure immutable `let` statements before the first candidate
  // assignment so statements that bare-read an old candidate variable run before
  // statements that only use its precomputed square, shortening live ranges.
  let eff_body : Array[Stmt] = []
  let mut bi = 0
  while bi < body.length() {
    eff_body.push(body[bi])
    bi = bi + 1
  }
  let mut min_assign = body.length()
  ci = 0
  while ci < cands.length() {
    if cands[ci].assign_idx < min_assign {
      min_assign = cands[ci].assign_idx
    }
    ci = ci + 1
  }
  let mut ri = 0
  while ri + 1 < min_assign {
    let mut do_swap = false
    match eff_body[ri] {
      SLet(n0, false, _, e0, _) =>
        match eff_body[ri + 1] {
          SLet(n1, false, _, e1, _) =>
            if n0 != n1 &&
              qbe_expr_is_pure_arith(e0) &&
              qbe_expr_is_pure_arith(e1) &&
              !qbe_expr_mentions_ident(e1, n0) &&
              !qbe_expr_mentions_ident(e0, n1) {
              let mut e0_bare = false
              let mut e1_bare = false
              let mut k = 0
              while k < cands.length() {
                let cn = cands[k].name
                if qbe_expr_bare_reads_ident(e0, cn) {
                  e0_bare = true
                }
                if qbe_expr_bare_reads_ident(e1, cn) {
                  e1_bare = true
                }
                k = k + 1
              }
              if !e0_bare && e1_bare {
                do_swap = true
              }
            }
          _ => ()
        }
      _ => ()
    }
    if do_swap {
      let tmp = eff_body[ri]
      eff_body[ri] = eff_body[ri + 1]
      eff_body[ri + 1] = tmp
      ri = ri + 2
    } else {
      ri = ri + 1
    }
  }

  qbe_emit_lbl(g, l_body)
  let loop_depth = g.scopes.length()
  g.loop_breaks.push(l_end)
  g.loop_conts.push(l_cond)
  g.loop_depths.push(loop_depth)
  g.hot_loop_depth = g.hot_loop_depth + 1
  qbe_scope_push(g)
  let loop_pinned_sq : Array[String] = []
  si = 0
  while si < eff_body.length() {
    if g.block_term {
      break
    }
    let is_last = si == eff_body.length() - 1
    if !is_last {
      let bf_os = qbe_try_emit_borrowed_field_let(g, eff_body, si)
      if bf_os != "" {
        qbe_pin_slot(g, bf_os, loop_pinned_sq)
        si = si + 1
        continue
      }
      if qbe_try_emit_borrowed_arr_elem_let(g, eff_body, si) ||
        qbe_try_emit_stack_pod_let(g, eff_body, si) {
        si = si + 1
        continue
      }
    }
    let sv = qbe_emit_stmt(g, eff_body[si], None, is_last)
    if !g.block_term {
      qbe_rc_dec(g, sv.reg, sv.ty)
    }
    // After emitting assign_idx for a candidate, either recompute square immediately
    // (for cond-shared candidates) or switch it to SqUpdate (state 2).
    if !g.block_term {
      ci = 0
      while ci < cands.length() {
        if cands[ci].assign_idx == si {
          if cands[ci].recompute_at_assign {
            let cname = cands[ci].name
            let cslot = match qbe_lookup_local(g, cname) {
              Some(cloc) => cloc.slot
              None => ""
            }
            match g.sq_reuse_slot.get(cname) {
              Some(sq_slot) => {
                let nv = qbe_tmp(g)
                let nsq = qbe_tmp(g)
                qbe_emit(g, nv + " =d loadd " + cslot)
                qbe_emit(g, nsq + " =d mul " + nv + ", " + nv)
                qbe_emit(g, "stored " + nsq + ", " + sq_slot)
                g.sq_reuse_state.set(cname, 1)
              }
              None => ()
            }
          } else {
            g.sq_reuse_state.set(cands[ci].name, 2)
          }
        }
        ci = ci + 1
      }
    }
    si = si + 1
  }
  qbe_unpin_slot_list(g, loop_pinned_sq)
  qbe_scope_pop(g)
  let _ = g.loop_breaks.pop()
  let _ = g.loop_conts.pop()
  let _ = g.loop_depths.pop()
  qbe_emit_term(g, "jmp " + l_cond)
  if rotated {
    qbe_emit_lbl(g, l_cond)
    qbe_emit_cond_branch(g, cond, l_body, l_end)
  }
  g.hot_loop_depth = g.hot_loop_depth - 1
  qbe_emit_lbl(g, l_end)

  ci = 0
  while ci < cands.length() {
    g.sq_reuse_slot.remove(cands[ci].name)
    g.sq_reuse_state.remove(cands[ci].name)
    ci = ci + 1
  }
  true
}

///|
fn qbe_is_early_drop_ty(g : QbeGen, t : Ty) -> Bool {
  match t {
    TWorld | TScope | TParam(_) => false
    _ => qbe_is_obj_ty(g, t)
  }
}

///|
/// Fuse adjacent single-use `let r = call(...); match r { ... }` into scalarized
/// `Option`/`Result` matching without boxing `r`, preserving evaluation order.
fn qbe_try_emit_let_match_opt_res(
  g : QbeGen,
  stmts : Array[Stmt],
  idx : Int,
  expected : Option[Ty],
) -> Option[QbeVal] {
  if !g.release || idx + 1 >= stmts.length() {
    return None
  }
  let (rname, is_mut, init) = match stmts[idx] {
    SLet(n, m, _, ini, _) => (n, m, ini)
    _ => return None
  }
  if is_mut || rname == "_" || g.boxed_mut_vars.contains(rname) {
    return None
  }
  // `rname` must not be referenced in any statement after `idx + 1`.
  let mut k = idx + 2
  while k < stmts.length() {
    match stmts[k] {
      SLet(n2, _, _, init2, _) => {
        if qbe_expr_mentions_ident(init2, rname) {
          return None
        }
        if n2 == rname {
          break
        }
      }
      SLetTuple(ns2, _, init2, _) => {
        if qbe_expr_mentions_ident(init2, rname) {
          return None
        }
        if str_arr_contains(ns2, rname) {
          break
        }
      }
      _ =>
        if qbe_stmt_mentions_ident(stmts[k], rname) {
          return None
        }
    }
    k = k + 1
  }
  let is_last_pair = idx + 1 == stmts.length() - 1
  let (kind, dst_name, dst_ty_opt, arms) : (Int, String, Option[Ty], Array[MatchArm]) = match stmts[idx + 1] {
    SExpr(EMatch(EIdent(mn, _), a, _), _) =>
      if mn == rname {
        (0, "", None, a)
      } else {
        return None
      }
    SLet(dn, dmut, dte, EMatch(EIdent(mn, _), a, _), _) =>
      if mn == rname && !dmut && !g.boxed_mut_vars.contains(dn) {
        let dty : Option[Ty] = match dte {
          TyMissing(_) => None
          _ => Some(qbe_resolve_type(g, dte))
        }
        (1, dn, dty, a)
      } else {
        return None
      }
    SReturn(Some(EMatch(EIdent(mn, _), a, _)), _) =>
      if mn == rname && g.inline_ret_lbl == "" && g.tco_mode == 0 {
        (2, "", Some(g.cur_ret_ty), a)
      } else {
        return None
      }
    _ => return None
  }
  // Ensure `rname` is not referenced inside any arm body or guard (unless shadowed).
  let mut ai = 0
  while ai < arms.length() {
    if !qbe_pat_binds_name(arms[ai].pat, rname) {
      match arms[ai].guard_expr {
        Some(ge) => if qbe_expr_mentions_ident(ge, rname) { return None }
        None => ()
      }
      if qbe_expr_mentions_ident(arms[ai].body, rname) {
        return None
      }
    }
    ai = ai + 1
  }
  let exp : Option[Ty] = if kind == 0 {
    if is_last_pair { expected } else { None }
  } else {
    dst_ty_opt
  }
  let mv = match qbe_try_emit_scalar_opt_res_match(g, init, arms, exp) {
    Some(v) => v
    None => return None
  }
  if g.block_term {
    return Some(qval("0", TNever))
  }
  if kind == 0 {
    if !is_last_pair {
      qbe_rc_dec(g, mv.reg, mv.ty)
      return Some(qval("0", TUnit))
    }
    Some(mv)
  } else if kind == 1 {
    let final_ty = match dst_ty_opt {
      Some(t) => subst_ty(t, g.cur_type_subst)
      None => mv.ty
    }
    let cv = qbe_coerce_val(g, mv, final_ty)
    if dst_name == "_" {
      qbe_rc_dec(g, cv, final_ty)
    } else {
      qbe_clear_shadowed_local_meta(g, dst_name)
      let loc = qbe_define_local(g, dst_name, final_ty, true)
      qbe_store_local_slot(g, cv, loc.slot, final_ty)
    }
    Some(qval("0", TUnit))
  } else {
    let cv = qbe_coerce_val(g, mv, g.cur_ret_abi_ty)
    if !qbe_try_emit_shared_cleanup_exit(g, cv) {
      qbe_release_scopes_down_to(g, 0)
      if g.cur_fn_void {
        qbe_emit_term(g, "ret")
      } else {
        qbe_emit_term(g, "ret " + cv)
      }
    }
    Some(qval("0", TNever))
  }
}

///|
///| Cached headers for two consecutive scalar reads at the same Int index.
pub struct QbeReadPair {
  a : QbeLocal
  b : QbeLocal
  index : QbeLocal
}

fn qbe_pair_container(t : Ty) -> Bool {
  match t {
    TArray(TInt) | TFixedArray(TInt) | TImmArray(TInt) | TStrView | TBytesView => true
    _ => false
  }
}

///| Prove header stability, not element stability. In-place indexed writes can
/// change elements, so the fast path still reads both payloads on every visit.
/// 'fresh' is lexical: each entry denotes an immutable binding initialized by
/// an array literal after both cached objects were already live.
fn qbe_pair_expr(g : QbeGen, e : Expr, p : QbeReadPair, h : QbeProbeHints, fresh : Array[String]) -> Bool {
  match e {
    EInt(_, _) | EInt64(_, _) | EBool(_, _) | EUnit(_) => true
    EIdent(n, _) => n != p.a.name && n != p.b.name &&
      (qbe_hints_get(h, n) is Some(_) || qbe_lookup_local(g, n) is Some(_) ||
        (g.mono_pkg == "" && g.const_int_vals.contains(n)))
    EUnary(_, v, _) | EField(v, _, _) => qbe_pair_expr(g, v, p, h, fresh)
    EBinary(op, l, r, _) =>
      op != "|>" &&
      !((op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, h)) &&
      qbe_pair_expr(g, l, p, h, fresh) &&
      qbe_pair_expr(g, r, p, h, fresh)
    EIndex(obj, ix, _) => {
      if !qbe_pair_expr(g, ix, p, h, fresh) { return false }
      match obj {
        EIdent(n, _) => if n == p.a.name || n == p.b.name { return true }
        _ => ()
      }
      match qbe_probe_expr_ty_with(g, obj, h) {
        Some(TArray(_)) | Some(TFixedArray(_)) | Some(TImmArray(_)) | Some(TStrView) | Some(TBytesView) =>
          qbe_pair_expr(g, obj, p, h, fresh)
        _ => false
      }
    }
    EMethodCall(EIdent(n, _), m, args, sp) => {
      if qbe_has_expected_trait(g, sp) { return false }
      let rt = qbe_probe_expr_ty_with(g, EIdent(n, sp), h)
      if m == "length" && args.length() == 0 {
        return match rt {
          Some(TArray(_)) | Some(TFixedArray(_)) | Some(TImmArray(_)) | Some(TStrView) | Some(TBytesView) => true
          _ => false
        }
      }
      // The pair accepts only Int arrays or byte views. A nested array's
      // outer header cannot be either input, even if its elements alias them.
      m == "push" && args.length() == 1 &&
        (str_arr_contains(fresh, n) || (match rt { Some(TArray(TArray(_))) => true
      _ => false })) &&
        qbe_pair_expr(g, args[0], p, h, fresh)
    }
    EBlock(ss, _) => qbe_pair_stmts(g, ss, p, h, fresh)
    EIf(c, ts, eo, _) => qbe_pair_expr(g, c, p, h, fresh) &&
      qbe_pair_stmts(g, ts, p, h, fresh) &&
      (match eo { Some(el) => qbe_pair_expr(g, el, p, h, fresh)
      None => true })
    EArrayLit(xs, _) => xs.length() == 0
    EStructLit(_, None, fs, _) => {
      let mut i = 0
      while i < fs.length() {
        if !qbe_pair_expr(g, fs[i].value, p, h, fresh) { return false }
        i = i + 1
      }
      true
    }
    _ => false
  }
}

fn qbe_pair_stmts(g : QbeGen, ss : Array[Stmt], p : QbeReadPair, outer : QbeProbeHints, inherited : Array[String]) -> Bool {
  let h = qbe_hints_copy(outer)
  let fresh = inherited.copy()
  let mut i = 0
  while i < ss.length() {
    match ss[i] {
      SLet(n, is_mut, te, v, sp) => {
        if n == p.a.name || n == p.b.name || str_arr_contains(fresh, n) ||
          !qbe_pair_expr(g, v, p, h, fresh) { return false }
        let t = match te {
          TyMissing(_) => match qbe_let_infer(g, sp) { Some(t) => t
      None => TError }
          _ => qbe_resolve_type(g, te)
        }
        qbe_hints_set(h, n, t)
        match (v, t) {
          (EArrayLit(_, _), TArray(_)) => if !is_mut && n != "_" { fresh.push(n) }
          _ => ()
        }
      }
      SWhile(c, b, _) => if !qbe_pair_expr(g, c, p, h, fresh) || !qbe_pair_stmts(g, b, p, h, fresh) { return false }
      SAssign(l, r, _) | SCompoundAssign(_, l, r, _) => {
        match l {
          EIdent(n, _) => if n == p.a.name || n == p.b.name || str_arr_contains(fresh, n) ||
            !(qbe_hints_get(h, n) is Some(_) || qbe_lookup_local(g, n) is Some(_)) { return false }
          EIndex(obj, _, _) => {
            match obj {
              EIdent(n, _) => if n == p.a.name || n == p.b.name { return false }
              _ => ()
            }
            if !qbe_pair_expr(g, l, p, h, fresh) { return false }
          }
          _ => return false
        }
        if !qbe_pair_expr(g, r, p, h, fresh) { return false }
      }
      SExpr(v, _) | SReturn(Some(v), _) => if !qbe_pair_expr(g, v, p, h, fresh) { return false }
      SReturn(None, _) | SBreak(_) | SContinue(_) => ()
      _ => return false
    }
    i = i + 1
  }
  true
}

fn qbe_read_pair(g : QbeGen, cond : Expr, body : Array[Stmt]) -> Option[QbeReadPair] {
  if g.target_wasm || body.length() < 3 || g.promoted_push_len.length() > 0 { return None }
  match (body[0], body[1]) {
    (SLet(x, false, TyMissing(_), EIndex(EIdent(a, _), EIdent(i, _), _), _),
     SLet(y, false, TyMissing(_), EIndex(EIdent(b, _), EIdent(j, _), _), _)) => {
      if g.boxed_mut_vars.contains(x) || g.boxed_mut_vars.contains(y) ||
        i != j || x == "_" || y == "_" || x == i || x == b || x == a || y == i || y == a || y == b || x == y { return None }
      match (qbe_lookup_local(g, a), qbe_lookup_local(g, b), qbe_lookup_local(g, i)) {
        (Some(aa), Some(bb), Some(ix)) => {
          if aa.is_cell || bb.is_cell || ix.is_cell || aa.ref_slot != "" || bb.ref_slot != "" ||
            !qbe_pair_container(aa.ty) || !qbe_pair_container(bb.ty) { return None }
          match ix.ty { TInt => ()
      _ => return None }
          let p = QbeReadPair::{ a: aa, b: bb, index: ix }
          let h = qbe_hints_new()
          if qbe_pair_expr(g, cond, p, h, []) && qbe_pair_stmts(g, body, p, h, []) { return Some(p) }
        }
        _ => ()
      }
    }
    _ => ()
  }
  None
}

pub struct QbePairHead {
  len : String
  data : String
}

fn qbe_pair_head(g : QbeGen, v : QbeLocal) -> QbePairHead {
  let obj = qbe_tmp(g)
  qbe_emit(g, obj + " =l loadl " + v.slot)
  let view = match v.ty { TStrView | TBytesView => true
      _ => false }
  let lp = if view {
    let r = qbe_tmp(g)
    qbe_emit(g, r + " =l add " + obj + ", 16")
    r
  } else { obj }
  let pp = qbe_tmp(g)
  let len = qbe_tmp(g)
  let data = qbe_tmp(g)
  qbe_emit(g, pp + " =l add " + obj + (if view { ", 8" } else { ", 24" }))
  qbe_emit(g, len + " =l loadl " + lp)
  qbe_emit(g, data + " =l loadl " + pp)
  QbePairHead::{ len: len, data: data }
}

fn qbe_pair_select(g : QbeGen, cmp : String, yes : String, no : String) -> String {
  let t = qbe_lbl(g, "pair_t")
  let f = qbe_lbl(g, "pair_f")
  let end = qbe_lbl(g, "pair_merge")
  qbe_emit_term(g, "jnz " + cmp + ", " + t + ", " + f)
  qbe_emit_lbl(g, t)
  qbe_emit_term(g, "jmp " + end)
  qbe_emit_lbl(g, f)
  qbe_emit_term(g, "jmp " + end)
  qbe_emit_lbl(g, end)
  let v = qbe_tmp(g)
  qbe_emit(g, v + " =l phi " + t + " " + yes + ", " + f + " " + no)
  v
}

fn qbe_pair_bind(g : QbeGen, s : Stmt, v : QbeLocal, dp : String, ix : String) -> Unit {
  match s {
    SLet(name, _, _, _, _) => {
      let loaded = match v.ty {
        TStrView | TBytesView => {
          let ep = qbe_tmp(g)
          let w = qbe_tmp(g)
          qbe_emit(g, ep + " =l add " + dp + ", " + ix)
          qbe_emit(g, w + " =w loadub " + ep)
          match v.ty { TBytesView => qval(qbe_as_l(g, qval(w, TInt)), TByte)
      _ => qval(w,TInt) }
        }
        _ => {
          let ep = qbe_emit_arr_ep_ty(g, dp, ix, TInt)
          qval(qbe_load_arr_elem(g, ep, TInt), TInt)
        }
      }
      let loc = qbe_define_local(g, name, loaded.ty, false)
      qbe_store_local_slot(g, loaded.reg, loc.slot, loaded.ty)
    }
    _ => ()
  }
}

///| Entered only after the original first condition succeeded. The cold
/// branch reports exactly the first failing length, including for negative i.
fn qbe_pair_body(g : QbeGen, p : QbeReadPair, body : Array[Stmt], loop_body : String) -> QbeVal {
  let a = qbe_pair_head(g, p.a)
  let b = if p.a.slot == p.b.slot { a } else { qbe_pair_head(g, p.b) }
  let limit = if p.a.slot == p.b.slot { a.len } else {
    let cmp = qbe_tmp(g)
    qbe_emit(g, cmp + " =w cultl " + a.len + ", " + b.len)
    qbe_pair_select(g, cmp, a.len, b.len)
  }
  qbe_emit_term(g, "jmp " + loop_body)
  qbe_emit_lbl(g, loop_body)
  let ix = qbe_as_l(g, qval(qbe_load_local_slot(g, p.index.slot, TInt), TInt))
  let oob = qbe_tmp(g)
  let fail = qbe_lbl(g, "pair_oob")
  let ok = qbe_lbl(g, "pair_ok")
  qbe_emit(g, oob + " =w cugel " + ix + ", " + limit)
  qbe_emit_term(g, "jnz " + oob + ", " + fail + ", " + ok)
  qbe_emit_lbl(g, fail)
  let bad = if p.a.slot == p.b.slot { a.len } else {
    let first = qbe_tmp(g)
    qbe_emit(g, first + " =w cugel " + ix + ", " + a.len)
    qbe_pair_select(g, first, a.len, b.len)
  }
  qbe_emit(g, "call $pion_panic_oob(l " + ix + ", l " + bad + ")")
  qbe_emit_term(g, "hlt")
  qbe_emit_lbl(g, ok)
  qbe_pair_bind(g, body[0], p.a, a.data, ix)
  qbe_pair_bind(g, body[1], p.b, b.data, ix)
  let tail : Array[Stmt] = []
  let mut j = 2
  while j < body.length() { tail.push(body[j])
      j = j + 1 }
  qbe_emit_stmts(g, tail, None)
}

///|
/// Recover the length established by a complete counted fill of fresh local
/// integer arrays. Keep the fact on the local binding so shadowing is harmless.
fn qbe_record_counted_fill(g : QbeGen, stmts : Array[Stmt], at : Int) -> Unit {
  if at < 2 || g.target_wasm { return }
  let (counter, limit, body) = match stmts[at] {
    SWhile(EBinary("<", EIdent(i, _), EInt(raw, _), _), body, _) =>
      (i, qbe_parse_int64_lit(raw), body)
    _ => return
  }
  let pushes = body.length() - 1
  if pushes < 1 || at < pushes + 1 || limit < 0L || limit > 2147483647L { return }
  match stmts[at - 1] {
    SLet(n, true, _, EInt("0", _), _) => if n != counter { return }
    _ => return
  }
  match qbe_lookup_local(g, counter) {
    Some(v) => match v.ty {
      TInt => if v.is_cell || v.ref_slot != "" { return }
      _ => return
    }
    None => return
  }
  match body[pushes] {
    SAssign(EIdent(n, _), EBinary("+", EIdent(m, _), EInt("1", _), _), _) =>
      if n != counter || m != counter { return }
    _ => return
  }
  let names : Array[String] = []
  let mut i = 0
  while i < pushes {
    match (stmts[at - pushes - 1 + i], body[i]) {
      (SLet(n, false, _, EArrayLit(xs, _), _),
       SExpr(EMethodCall(EIdent(a, _), "push", args, _), _)) => {
        if n != a || n == counter || xs.length() != 0 || args.length() != 1 ||
          str_arr_contains(names, n) { return }
        match args[0] { EInt(_, _) => ()
          _ => return }
        match qbe_lookup_local(g, n) {
          Some(v) => match v.ty {
            TArray(TInt) => if v.is_cell || v.ref_slot != "" { return }
            _ => return
          }
          None => return
        }
        names.push(n)
      }
      _ => return
    }
    i = i + 1
  }
  i = 0
  while i < pushes {
    let n = names[i]
    if qbe_arr_is_stable_stmts(stmts, at + 1, n, true) {
      match qbe_lookup_local(g, n) {
        Some(v) => v.counted_len = limit.to_string()
        None => ()
      }
    }
    i = i + 1
  }
}

///|
/// Length operand for a bounds check on local `name` (array object `obj`): the
/// exact local length recorded for a counted fill or a fixed literal, else a header load.
fn qbe_array_length_operand(g : QbeGen, name : String, obj : String) -> String {
  match qbe_lookup_local(g, name) {
    Some(v) => if v.counted_len != "" { return v.counted_len }
    None => ()
  }
  let len = qbe_tmp(g)
  qbe_emit(g, len + " =l loadl " + obj)
  len
}

///|
/// `qbe_emit_stmts` consults its block-level data-pointer predicate only for a
/// non-final binding or for a guard (a final guard's condition included); every
/// other block skips the scan.
fn qbe_block_needs_data_ptr_scan(stmts : Array[Stmt]) -> Bool {
  let n = stmts.length()
  let mut i = 0
  while i < n {
    match stmts[i] {
      SGuard(_, _, _) => return true
      SLet(_, _, _, _, _) | SLetTuple(_, _, _, _) => if i + 1 < n { return true }
      _ => ()
    }
    i = i + 1
  }
  false
}

///| Bookkeeping `qbe_emit_stmts` does after each statement, for a fused run
/// stmts[lo ..= hi] whose only defined local (if any) is that of stmts[def]:
/// pin it or register it for last-use release, then release every registered
/// local whose last use lies inside the run.
fn qbe_fused_stmts_done(
  g : QbeGen,
  n : Int,
  lo : Int,
  hi : Int,
  def : Int,
  def_names : Array[String],
  def_last_use : Array[Int],
  def_dp_pinned : Array[Bool],
  ed_names : Array[String],
  ed_slots : Array[String],
  ed_last : Array[Int],
  pinned : Map[String, Bool],
  pinned_slot_list : Array[String],
) -> Unit {
  if g.block_term { return }
  if def >= 0 {
    if def_dp_pinned[def] {
      qbe_pin_local_slot(g, def_names[def], pinned_slot_list)
    } else if def_last_use[def] >= 0 {
      match qbe_lookup_local(g, def_names[def]) {
        Some(loc) =>
          if loc.owned && !loc.is_cell && loc.ref_slot == "" && qbe_is_early_drop_ty(g, loc.ty) {
            ed_names.push(def_names[def])
            ed_slots.push(loc.slot)
            ed_last.push(def_last_use[def])
          }
        None => ()
      }
    }
  }
  if hi >= n - 1 { return }
  let mut dropped_any = false
  let mut k = ed_names.length() - 1
  while k >= 0 {
    if ed_last[k] >= lo && ed_last[k] <= hi &&
      !pinned.contains(ed_names[k]) &&
      !g.pinned_slots.contains(ed_slots[k]) {
      let dead = qbe_tmp(g)
      qbe_emit(g, dead + " =l loadl " + ed_slots[k])
      qbe_emit(g, "call $pion_rc_dec(l " + dead + ")")
      qbe_emit(g, "storel 0, " + ed_slots[k])
      g.zeroed_slots.set(ed_slots[k], true)
      dropped_any = true
    }
    k = k - 1
  }
  if dropped_any {
    g.block_immut_fields = Map([])
  }
}

///|
/// `destructure_tail`: the block is the body of an inlined callee whose tail
/// tuple is destructured immediately (`qbe_has_simple_tuple_tail`); the tail
/// expression is emitted in destructure mode (private stack buffer). Every
/// other statement, and the last-use early drops, are emitted as usual.
fn qbe_emit_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  expected : Option[Ty],
  destructure_tail : Bool = false,
) -> QbeVal {
  let n = stmts.length()
  if n == 0 {
    return qval("0", TUnit)
  }
  // Perceus-lite last-use early drop: for each top-level immutable `SLet` in this
  // straight-line statement block, compute its last syntactic mention index `last_use`.
  // When `last_use < n - 1` and the binding is an owned heap object not shadowed or
  // pinned by a borrowed array-element view, drop it immediately after `stmts[last_use]`
  // and zero its stack slot so scope-exit / early-return release is a 1-branch NULL no-op.
  let block_has_dp = qbe_block_needs_data_ptr_scan(stmts) && qbe_stmts_has_any_data_ptr(stmts)
  let def_last_use : Array[Int] = []
  let def_names : Array[String] = []
  let def_dp_pinned : Array[Bool] = []
  let mut di = 0
  while di < n {
    let mut lu = -1
    let mut dname = ""
    let mut dp_pin = false
    if di < n - 1 {
      match stmts[di] {
        SLet(name, is_mut, _, _, _) =>
          if name != "_" {
            if block_has_dp && qbe_stmts_tail_takes_data_ptr(stmts, di + 1, name) {
              dp_pin = true
              dname = name
            } else {
              let mut cur_lu = di
              let mut shadowed_use = false
              let mut j = di + 1
              while j < n {
                match stmts[j] {
                  SLet(n2, _, _, init2, _) =>
                    if n2 == name {
                      if qbe_expr_mentions_ident(init2, name) {
                        shadowed_use = true
                      }
                      break
                    }
                  SLetTuple(ns2, _, init2, _) =>
                    if str_arr_contains(ns2, name) {
                      if qbe_expr_mentions_ident(init2, name) {
                        shadowed_use = true
                      }
                      break
                    }
                  _ => ()
                }
                if qbe_stmt_mentions_ident(stmts[j], name) {
                  cur_lu = j
                }
                j = j + 1
              }
              if !shadowed_use && cur_lu <= n - 1 {
                if !is_mut && cur_lu < n - 1 {
                  lu = cur_lu
                  dname = name
                } else if cur_lu == n - 1 {
                  match stmts[n - 1] {
                    SExpr(_, _) => {
                      lu = cur_lu
                      dname = name
                    }
                    _ => ()
                  }
                }
              }
            }
          }
        SLetTuple(ns, _, _, _) =>
          if block_has_dp {
            let mut ti = 0
            while ti < ns.length() {
              let tn = ns[ti]
              if tn != "_" && qbe_stmts_tail_takes_data_ptr(stmts, di + 1, tn) {
                dp_pin = true
                break
              }
              ti = ti + 1
            }
          }
        _ => ()
      }
    }
    def_last_use.push(lu)
    def_names.push(dname)
    def_dp_pinned.push(dp_pin)
    di = di + 1
  }
  let ed_names : Array[String] = []
  let ed_slots : Array[String] = []
  let ed_last : Array[Int] = []
  let pinned : Map[String, Bool] = Map([])
  let pinned_slot_list : Array[String] = []
  let mut i = 0
  let mut last = qval("0", TUnit)
  // Statements before this index cannot start a fused slice-alias run.
  let mut span_skip_until = 0
  while i < n {
    if g.block_term {
      break
    }
    let entry = qbe_try_slice_entry(g, stmts, i)
    if entry > 0 {
      // stmts[i] (a slice let) and stmts[i + 1] (the map update) were fused.
      qbe_fused_stmts_done(
        g, n, i, i + 1, if entry == 2 { i } else { -1 }, def_names, def_last_use, def_dp_pinned,
        ed_names, ed_slots, ed_last, pinned, pinned_slot_list,
      )
      i = i + 2
      last = qval("0", TUnit)
      continue
    }
    let consumed = if i < span_skip_until { 0 } else { qbe_try_span_bindings(g, stmts, i) }
    if consumed < 0 {
      span_skip_until = i - consumed
    }
    if consumed > 0 {
      // Slice aliases stmts[i ..] and the concatenation let at end were fused;
      // only that let defines a local.
      let end = i + consumed - 1
      let def = match stmts[end] {
        SLet(name, _, _, _, _) => if name != "_" { end } else { -1 }
        _ => -1
      }
      qbe_fused_stmts_done(
        g, n, i, end, def, def_names, def_last_use, def_dp_pinned, ed_names, ed_slots, ed_last,
        pinned, pinned_slot_list,
      )
      i = i + consumed
      last = qval("0", TUnit)
      continue
    }
    let is_last = i == n - 1
    let bf_owner_slot = if !is_last {
      qbe_try_emit_borrowed_field_let(g, stmts, i)
    } else {
      ""
    }
    if bf_owner_slot != "" {
      qbe_pin_slot(g, bf_owner_slot, pinned_slot_list)
      last = qval("0", TUnit)
    } else if !is_last && qbe_try_emit_borrowed_arr_elem_let(g, stmts, i) {
      let pin_root = match stmts[i] {
        SLet(_, _, _, EIndex(EIdent(aname, _), _, _), _) => aname
        SLet(_, _, _, EIndex(EField(EIdent(bname, _), _, _), _, _), _) => bname
        SLet(_, _, _, EField(EIdent(bname, _), _, _), _) => bname
        SLet(_, _, _, EField(EField(EIdent(bname, _), _, _), _, _), _) => bname
        _ => ""
      }
      if pin_root != "" {
        pinned.set(pin_root, true)
        match qbe_lookup_local(g, pin_root) {
          Some(ploc) => {
            let prev = match g.pinned_slots.get(ploc.slot) {
              Some(c) => c
              None => 0
            }
            g.pinned_slots.set(ploc.slot, prev + 1)
            pinned_slot_list.push(ploc.slot)
          }
          None => ()
        }
      }
      last = qval("0", TUnit)
    } else if !is_last &&
      {
        match qbe_try_emit_let_match_opt_res(g, stmts, i, expected) {
          Some(mv) => {
            if block_has_dp {
              match stmts[i + 1] {
                SLet(dst_name, _, _, _, _) =>
                  if dst_name != "_" &&
                    qbe_stmts_tail_takes_data_ptr(stmts, i + 2, dst_name) {
                    qbe_pin_local_slot(g, dst_name, pinned_slot_list)
                  }
                _ => ()
              }
            }
            last = mv
            i = i + 2
            true
          }
          None => false
        }
      } {
      continue
    } else if !is_last && qbe_try_emit_stack_pod_let(g, stmts, i) {
      last = qval("0", TUnit)
    } else if !is_last &&
      {
        let vroot = qbe_try_emit_stack_view_let(g, stmts, i)
        if vroot != "" {
          pinned.set(vroot, true)
          match qbe_lookup_local(g, vroot) {
            Some(ploc) => {
              let prev = match g.pinned_slots.get(ploc.slot) {
                Some(c) => c
                None => 0
              }
              g.pinned_slots.set(ploc.slot, prev + 1)
              pinned_slot_list.push(ploc.slot)
            }
            None => ()
          }
          true
        } else {
          false
        }
      } {
      last = qval("0", TUnit)
    } else {
      let exp = if is_last { expected } else { None }
      let move_expr_opt : Option[Expr] = match stmts[i] {
        SExpr(me, _) =>
          if qbe_expr_is_straight_line_movable(me) { Some(me) } else { None }
        SLet(_, _, _, me, _) =>
          if qbe_expr_is_straight_line_movable(me) { Some(me) } else { None }
        _ => None
      }
      let old_mov = g.movable_locals
      let old_moved = g.moved_slots
      let mut did_mov_setup = false
      match move_expr_opt {
        Some(me) =>
          if ed_names.length() > 0 {
            let mov_map : Map[String, String] = Map([])
            let mut mk = 0
            while mk < ed_names.length() {
              if ed_last[mk] == i &&
                !pinned.contains(ed_names[mk]) &&
                !g.pinned_slots.contains(ed_slots[mk]) {
                if qbe_expr_count_mentions(me, ed_names[mk]) == 1 {
                  mov_map.set(ed_names[mk], ed_slots[mk])
                }
              }
              mk = mk + 1
            }
            if mov_map.length() > 0 {
              g.movable_locals = mov_map
              g.moved_slots = Map([])
              did_mov_setup = true
            }
          }
        None => ()
      }
      last = match stmts[i] {
        SExpr(tail, _) if is_last && destructure_tail =>
          qbe_emit_expr_mode(g, tail, exp, true)
        _ => qbe_emit_stmt(g, stmts[i], exp, is_last)
      }
      match stmts[i] { SWhile(_, _, _) => qbe_record_counted_fill(g, stmts, i)
        _ => () }
      let cur_moved = g.moved_slots
      if did_mov_setup {
        g.movable_locals = old_mov
        g.moved_slots = old_moved
      }
      if def_dp_pinned[i] {
        match stmts[i] {
          SLet(dname, _, _, _, _) =>
            qbe_pin_local_slot(g, dname, pinned_slot_list)
          SLetTuple(ns, _, _, _) => {
            let mut ti = 0
            while ti < ns.length() {
              let tn = ns[ti]
              if tn != "_" && qbe_stmts_tail_takes_data_ptr(stmts, i + 1, tn) {
                qbe_pin_local_slot(g, tn, pinned_slot_list)
              }
              ti = ti + 1
            }
          }
          _ => ()
        }
      } else if block_has_dp {
        match stmts[i] {
          SGuard(gcond, _, _) =>
            if qbe_expr_has_is(gcond) {
              let gnames : Array[String] = []
              qbe_collect_expr_is_bindings(gcond, gnames)
              let mut gi = 0
              while gi < gnames.length() {
                let bn = gnames[gi]
                if qbe_cond_rhs_takes_data_ptr(gcond, bn) ||
                  qbe_stmts_tail_takes_data_ptr(stmts, i + 1, bn) {
                  qbe_pin_local_slot(g, bn, pinned_slot_list)
                }
                gi = gi + 1
              }
            }
          _ => ()
        }
      }
      if def_last_use[i] >= 0 {
        let dname = def_names[i]
        match qbe_lookup_local(g, dname) {
          Some(loc) =>
            if loc.owned && !loc.is_cell && loc.ref_slot == "" && qbe_is_early_drop_ty(g, loc.ty) {
              ed_names.push(dname)
              ed_slots.push(loc.slot)
              ed_last.push(def_last_use[i])
            }
          None => ()
        }
      }
      if !g.block_term && ed_names.length() > 0 {
        let mut k = ed_names.length() - 1
        let mut dropped_any = false
        while k >= 0 {
          if ed_last[k] == i &&
            !pinned.contains(ed_names[k]) &&
            !g.pinned_slots.contains(ed_slots[k]) {
            if did_mov_setup && cur_moved.contains(ed_slots[k]) {
              g.zeroed_slots.set(ed_slots[k], true)
              dropped_any = true
            } else if i < n - 1 {
              let dead = qbe_tmp(g)
              qbe_emit(g, dead + " =l loadl " + ed_slots[k])
              qbe_emit(g, "call $pion_rc_dec(l " + dead + ")")
              qbe_emit(g, "storel 0, " + ed_slots[k])
              g.zeroed_slots.set(ed_slots[k], true)
              dropped_any = true
            }
          }
          k = k - 1
        }
        if dropped_any {
          g.block_immut_fields = Map([])
        }
      }
    }
    i = i + 1
  }
  qbe_unpin_slot_list(g, pinned_slot_list)
  last
}

///|
fn qbe_emit_compound_binop(
  g : QbeGen,
  op : String,
  old_reg : String,
  rv : QbeVal,
  ty : Ty,
) -> String {
  if g.in_verify && (op == "/" || op == "%" || op == "<<" || op == ">>") {
    qbe_emit_verify_arith_check(g, op, qval(old_reg, ty), rv, None, g.verify_sp)
  }
  match ty {
    TString => {
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =l call $pion_str_concat(l " + old_reg + ", l " + rv.reg + ")")
      qbe_rc_dec(g, rv.reg, rv.ty)
      r
    }
    TDouble => {
      let rd = qbe_coerce_val(g, rv, TDouble)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else {
        "div"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =d " + qop + " " + old_reg + ", " + rd)
      r
    }
    TFloat => {
      let rf = qbe_coerce_val(g, rv, TFloat)
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else {
        "div"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =s " + qop + " " + old_reg + ", " + rf)
      r
    }
    TUInt => {
      let rw = qbe_coerce_val(g, rv, TUInt)
      if op == "/" || op == "%" {
        match qbe_try_parse_pos_i64_reg(rw) {
          Some(d) =>
            match qbe_emit_u32_const_div_rem(g, op, old_reg, d) {
              Some(aw) => return aw
              None => ()
            }
          None => ()
        }
      }
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else if op == "/" {
        "udiv"
      } else if op == "%" {
        "urem"
      } else if op == "&" {
        "and"
      } else if op == "|" {
        "or"
      } else if op == "^" {
        "xor"
      } else if op == "<<" {
        "shl"
      } else {
        "shr"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w " + qop + " " + old_reg + ", " + rw)
      r
    }
    TUInt64 => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "shr" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        r
      } else {
        let rl = qbe_coerce_val(g, rv, TUInt64)
        if op == "/" || op == "%" {
          match qbe_try_parse_pos_i64_reg(rl) {
            Some(d) =>
              match qbe_emit_u64_const_div_rem(g, op, old_reg, d) {
                Some(al) => return al
                None => ()
              }
            None => ()
          }
        }
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "udiv"
        } else if op == "%" {
          "urem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        r
      }
    }
    TByte => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "shr" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        qbe_extub_l(g, r)
      } else {
        let rl = qbe_coerce_val(g, rv, TByte)
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "udiv"
        } else if op == "%" {
          "urem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        qbe_extub_l(g, r)
      }
    }
    TInt8 => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "sar" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        qbe_extsb_l(g, r)
      } else {
        let rl = qbe_coerce_val(g, rv, TInt8)
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "div"
        } else if op == "%" {
          "rem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        qbe_extsb_l(g, r)
      }
    }
    TInt64 => {
      if op == "<<" || op == ">>" {
        let rw = qbe_coerce_val(g, rv, TInt)
        let qop = if op == "<<" { "shl" } else { "sar" }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rw)
        r
      } else {
        let rl = qbe_coerce_val(g, rv, TInt64)
        if op == "/" || op == "%" {
          match qbe_try_parse_pos_i64_reg(rl) {
            Some(d) =>
              match qbe_emit_i64_const_div_rem(g, op, old_reg, d) {
                Some(al) => return al
                None => ()
              }
            None => ()
          }
        }
        let qop = if op == "+" {
          "add"
        } else if op == "-" {
          "sub"
        } else if op == "*" {
          "mul"
        } else if op == "/" {
          "div"
        } else if op == "%" {
          "rem"
        } else if op == "&" {
          "and"
        } else if op == "|" {
          "or"
        } else {
          "xor"
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l " + qop + " " + old_reg + ", " + rl)
        r
      }
    }
    _ => {
      let rw = qbe_coerce_val(g, rv, TInt)
      if op == "/" || op == "%" {
        match ty {
          TInt =>
            match qbe_try_parse_pos_i64_reg(rw) {
              Some(d) =>
                match qbe_emit_i32_const_div_rem(g, op, old_reg, d, false, false) {
                  Some(aw) => return aw
                  None => ()
                }
              None => ()
            }
          _ => ()
        }
      }
      let qop = if op == "+" {
        "add"
      } else if op == "-" {
        "sub"
      } else if op == "*" {
        "mul"
      } else if op == "/" {
        "div"
      } else if op == "%" {
        "rem"
      } else if op == "&" {
        "and"
      } else if op == "|" {
        "or"
      } else if op == "^" {
        "xor"
      } else if op == "<<" {
        "shl"
      } else {
        "sar"
      }
      let r = qbe_tmp(g)
      qbe_emit(g, r + " =w " + qop + " " + old_reg + ", " + rw)
      r
    }
  }
}

///|
///| Lower a counted byte search in an immutable string to bounded memchr.
/// Keep the scalar loop for invalid ranges: it can find a delimiter before
/// its first out-of-bounds read, or report the original index and length.
fn qbe_try_emit_byte_scan(g : QbeGen, cond : Expr, body : Array[Stmt]) -> Bool {
  if g.target_wasm || body.length() != 1 { return false }
  let (iv, bound, str, needle) = match cond {
    EBinary("&&", EBinary("<", EIdent(i, _), EIdent(n, _), _),
      EBinary("!=", EMethodCall(EIdent(s, _), "code_unit_at", args, sp), EInt(lit, _), _), _) => {
      if qbe_has_expected_trait(g, sp) || args.length() != 1 { return false }
      match args[0] { EIdent(j, _) => if i != j { return false }
         _ => return false }
      let byte = qbe_parse_int64_lit(lit)
      if byte < 0L || byte > 255L { return false }
      (i, n, s, byte)
    }
    _ => return false
  }
  match body[0] {
    SAssign(EIdent(i, _), EBinary("+", EIdent(j, _), EInt("1", _), _), _) =>
      if i != iv || j != iv { return false }
    _ => return false
  }
  match (qbe_lookup_local(g, iv), qbe_lookup_local(g, bound), qbe_lookup_local(g, str)) {
    (Some(idx), Some(last), Some(s)) => {
      if idx.is_cell || last.is_cell || s.is_cell || idx.slot == last.slot { return false }
      match (idx.ty, last.ty, s.ty) { (TInt, TInt, TString) => ()
         _ => return false }
      let first = qbe_load_local_slot(g, idx.slot, TInt)
      let stop = qbe_load_local_slot(g, last.slot, TInt)
      let active = qbe_tmp(g)
      let range = qbe_lbl(g, "scan_range")
      let slow = qbe_lbl(g, "scan_scalar")
      let step = qbe_lbl(g, "scan_step")
      let fast = qbe_lbl(g, "scan_fast")
      let hit = qbe_lbl(g, "scan_hit")
      let miss = qbe_lbl(g, "scan_miss")
      let done = qbe_lbl(g, "scan_end")
      qbe_emit(g, active + " =w csltw " + first + ", " + stop)
      qbe_emit_term(g, "jnz " + active + ", " + range + ", " + done)
      qbe_emit_lbl(g, range)
      let obj = qbe_load_local_slot(g, s.slot, TString)
      let len = qbe_tmp(g)
      let lo = qbe_as_l(g, qval(first, TInt))
      let hi = qbe_as_l(g, qval(stop, TInt))
      let nonneg = qbe_tmp(g)
      let fits = qbe_tmp(g)
      let valid = qbe_tmp(g)
      qbe_emit(g, len + " =l loadl " + obj)
      qbe_emit(g, nonneg + " =w csgew " + first + ", 0")
      qbe_emit(g, fits + " =w culel " + hi + ", " + len)
      qbe_emit(g, valid + " =w and " + nonneg + ", " + fits)
      qbe_emit_term(g, "jnz " + valid + ", " + fast + ", " + slow)
      qbe_emit_lbl(g, fast)
      let dp = qbe_tmp(g)
      let begin = qbe_tmp(g)
      let span = qbe_tmp(g)
      let found = qbe_tmp(g)
      let present = qbe_tmp(g)
      qbe_emit(g, dp + " =l add " + obj + ", 8")
      qbe_emit(g, begin + " =l add " + dp + ", " + lo)
      qbe_emit(g, span + " =l sub " + hi + ", " + lo)
      qbe_emit(g, found + " =l call $memchr(l " + begin + ", w " + needle.to_string() + ", l " + span + ")")
      qbe_emit(g, present + " =w cnel " + found + ", 0")
      qbe_emit_term(g, "jnz " + present + ", " + hit + ", " + miss)
      qbe_emit_lbl(g, hit)
      let index = qbe_tmp(g)
      qbe_emit(g, index + " =l sub " + found + ", " + dp)
      qbe_emit(g, "storew " + index + ", " + idx.slot)
      qbe_emit_term(g, "jmp " + done)
      qbe_emit_lbl(g, miss)
      qbe_emit(g, "storew " + stop + ", " + idx.slot)
      qbe_emit_term(g, "jmp " + done)
      qbe_emit_lbl(g, slow)
      qbe_emit_cond_branch(g, cond, step, done)
      qbe_emit_lbl(g, step)
      let _ = qbe_emit_stmt(g, body[0], None, false)
      qbe_emit_term(g, "jmp " + slow)
      qbe_emit_lbl(g, done)
      true
    }
    _ => false
  }
}

fn qbe_emit_stmt(
  g : QbeGen,
  stmt : Stmt,
  expected : Option[Ty],
  is_tail : Bool,
) -> QbeVal {
  match stmt {
    SLet(name, is_mut, ty_expr, init, let_sp) => {
      let ann_opt : Option[Ty] = match ty_expr {
        TyMissing(_) => qbe_let_infer(g, let_sp)
        _ => Some(qbe_resolve_type(g, ty_expr))
      }
      let iv = qbe_emit_expr(g, init, ann_opt)
      let final_ty = match ann_opt {
        Some(a) => a
        None => iv.ty
      }
      if name == "_" {
        qbe_rc_dec(g, iv.reg, final_ty)
      } else if is_mut && g.boxed_mut_vars.contains(name) {
        let drop_reg = match final_ty {
          TParam(tn) =>
            if qbe_tp_live(g, tn) {
              let obj_drop = qbe_register_slot_drop(g, [0])
              let df_slot = qbe_alloc_slot(g)
              let l_obj = qbe_lbl(g, "cell_df_o")
              let l_sc = qbe_lbl(g, "cell_df_s")
              let l_dn = qbe_lbl(g, "cell_df_d")
              qbe_emit_jnz_l(g, "%tp_" + tn, l_obj, l_sc)
              qbe_emit_lbl(g, l_obj)
              qbe_emit(g, "storel " + obj_drop + ", " + df_slot)
              qbe_emit_term(g, "jmp " + l_dn)
              qbe_emit_lbl(g, l_sc)
              qbe_emit(g, "storel 0, " + df_slot)
              qbe_emit_term(g, "jmp " + l_dn)
              qbe_emit_lbl(g, l_dn)
              let df = qbe_tmp(g)
              qbe_emit(g, df + " =l loadl " + df_slot)
              df
            } else {
              "0"
            }
          _ =>
            if qbe_is_obj_ty(g, final_ty) {
              qbe_register_slot_drop(g, [0])
            } else {
              "0"
            }
        }
        let cell_p = qbe_tmp(g)
        qbe_emit(g, cell_p + " =l call $pion_alloc_uninit(w 8, w 4, l " + drop_reg + ")")
        qbe_store_heap_slot(g, qbe_coerce_val(g, iv, final_ty), cell_p, final_ty)
        let loc = qbe_define_cell_local(g, name, final_ty, true)
        qbe_emit(g, "storel " + cell_p + ", " + loc.slot)
        g.len_aliases.remove(name)
        g.unfrozen_local_arrs.remove(name)
        g.nonneg_vars.remove(name)
        g.u8_range_vars.remove(name)
        g.known_min_len_arrs.remove(name)
        g.known_writable_bytes.remove(name)
      } else {
        let iv_ext : Option[String] = if !is_mut &&
          qbe_is_int32_ty(final_ty) &&
          qbe_is_int32_ty(iv.ty) {
          g.w_to_l_ext.get(iv.reg)
        } else {
          None
        }
        // Precompute metadata against the OLD scope BEFORE `qbe_define_local`
        // shadows any outer variable of the same name (e.g. `let src = src.slice(0, 1)`).
        let fixed_length = match init {
          EIdent(global_name, _) if !is_mut && g.mono_pkg == "" =>
            match g.fixed_literal_lengths.get(global_name) {
              Some(n) =>
                match qbe_lookup_local(g, global_name) {
                  None => n.to_string()
                  Some(_) => ""
                }
              None => ""
            }
          _ => ""
        }
        let mut pre_unfrozen_arr = false
        let mut pre_min_len = -1
        let mut pre_writable_bytes = false
        match init {
          EArrayLit(lit_elems, _) =>
            match final_ty {
              TArray(_) => {
                pre_unfrozen_arr = true
                if !is_mut && lit_elems.length() >= 1 {
                  pre_min_len = lit_elems.length()
                }
              }
              TFixedArray(_) | TImmArray(_) =>
                if !is_mut && lit_elems.length() >= 1 {
                  pre_min_len = lit_elems.length()
                }
              _ => ()
            }
          ECall(EPath(q, m, _), margs, _) => {
            if q == "Array" && (m == "new" || m == "with_capacity" || m == "make") {
              match final_ty {
                TArray(_) => pre_unfrozen_arr = true
                _ => ()
              }
            }
            if !is_mut && (q == "Array" || q == "FixedArray" || q == "ImmArray") && m == "make" && margs.length() == 2 {
              let is_arr_ty = match final_ty {
                TArray(_) | TFixedArray(_) | TImmArray(_) => true
                _ => false
              }
              if is_arr_ty {
                let c_len = match margs[0] {
                  EInt(raw, _) => qbe_parse_int64_lit(raw).to_int()
                  EIdent(cn, _) =>
                    if g.mono_pkg == "" {
                      match qbe_lookup_local(g, cn) {
                        Some(_) => -1
                        None =>
                          match g.const_int_vals.get(cn) {
                            Some(cv) => cv
                            None => -1
                          }
                      }
                    } else {
                      -1
                    }
                  _ => -1
                }
                if c_len >= 1 {
                  pre_min_len = c_len
                }
              }
            }
            if !is_mut && q == "Bytes" {
              match final_ty {
                TBytes =>
                  if m == "new" && margs.length() == 1 {
                    pre_writable_bytes = true
                    let c_len = match margs[0] {
                      EInt(raw, _) => qbe_parse_int64_lit(raw).to_int()
                      EIdent(cn, _) =>
                        if g.mono_pkg == "" {
                          match qbe_lookup_local(g, cn) {
                            Some(_) => -1
                            None =>
                              match g.const_int_vals.get(cn) {
                                Some(cv) => cv
                                None => -1
                              }
                          }
                        } else {
                          -1
                        }
                      _ => -1
                    }
                    if c_len >= 1 {
                      pre_min_len = c_len
                    }
                  } else if m == "from_ptr" && margs.length() == 2 {
                    pre_writable_bytes = true
                  }
                _ => ()
              }
            }
          }
          ECall(EIdent(fnm, _), margs, _) =>
            if !is_mut &&
              fnm == "bytes_from_ptr" &&
              margs.length() == 2 &&
              !qbe_has_user_callee(g, "bytes_from_ptr") {
              let shadowed = match qbe_lookup_local(g, "bytes_from_ptr") {
                Some(_) => true
                None => false
              }
              if !shadowed {
                match final_ty {
                  TBytes => pre_writable_bytes = true
                  _ => ()
                }
              }
            }
          EMethodCall(recv, m, margs, msp) =>
            if !is_mut && !qbe_has_expected_trait(g, msp) {
              match final_ty {
                TBytes =>
                  if m == "to_bytes" && margs.length() == 0 {
                    match qbe_peek_expr_ty(g, recv) {
                      Some(TString) => pre_writable_bytes = true
                      _ => ()
                    }
                  } else if (m == "slice" && margs.length() == 2) ||
                    (m == "concat" && margs.length() == 1) {
                    match qbe_peek_expr_ty(g, recv) {
                      Some(TBytes) => pre_writable_bytes = true
                      _ => ()
                    }
                  }
                _ => ()
              }
            }
          _ => ()
        }
        let pre_max_u_bound : Option[Int64] = if !is_mut {
          match qbe_expr_max_u_bound(g, init) {
            Some(u) => {
              let fits = match final_ty {
                TInt => u >= 0L && u <= 2147483647L
                TByte => u >= 0L && u <= 255L
                TUInt => u >= 0L && u <= 4294967295L
                TInt64 | TUInt64 => u >= 0L
                _ => false
              }
              if fits { Some(u) } else { None }
            }
            None => None
          }
        } else {
          None
        }
        let pre_len_alias : String = if !is_mut {
          match init {
            EMethodCall(recv_e, mname, margs, msp) =>
              if qbe_is_builtin_len_call(g, recv_e, mname, margs, msp) {
                match recv_e {
                  EIdent(aname, _) =>
                    if aname != name {
                      match qbe_lookup_local(g, aname) {
                        Some(aloc) =>
                          match aloc.ty {
                            TArray(_) | TFixedArray(_) | TImmArray(_) | TString | TBytes | TStrView | TBytesView => aname
                            _ => ""
                          }
                        None => ""
                      }
                    } else {
                      ""
                    }
                  _ => ""
                }
              } else {
                ""
              }
            _ => ""
          }
        } else {
          ""
        }
        let coerced_iv = qbe_coerce_val(g, iv, final_ty)
        let iv_immortal = !is_mut &&
          qbe_is_obj_ty(g, final_ty) &&
          (coerced_iv == "0" || g.immortal_regs.contains(coerced_iv))
        let loc = qbe_define_local_ex(g, name, final_ty, !iv_immortal, is_mut)
        if fixed_length != "" { loc.counted_len = fixed_length }
        qbe_store_local_slot(g, coerced_iv, loc.slot, final_ty)
        if iv_immortal {
          g.immortal_slots.set(loc.slot, true)
        }
        match iv_ext {
          Some(rl) => g.local_w_to_l_ext.set(name, rl)
          None => ()
        }
        // Clear any stale facts from an outer shadowed binding, then apply precomputed facts.
        g.len_aliases.remove(name)
        g.unfrozen_local_arrs.remove(name)
        g.u8_range_vars.remove(name)
        g.known_min_len_arrs.remove(name)
        g.known_writable_bytes.remove(name)
        if pre_unfrozen_arr {
          g.unfrozen_local_arrs.set(name, true)
        }
        if pre_min_len >= 1 {
          g.known_min_len_arrs.set(name, pre_min_len)
        }
        if pre_writable_bytes {
          g.known_writable_bytes.set(name, true)
        }
        match pre_max_u_bound {
          Some(u) => g.u8_range_vars.set(name, u)
          None => ()
        }
        if pre_len_alias != "" {
          g.len_aliases.set(name, pre_len_alias)
          if !str_arr_contains(g.len_alias_keys, name) {
            g.len_alias_keys.push(name)
          }
        }
        // Track provably non-negative `Int` locals for conservative BCE
        match final_ty {
          TInt => {
            let mut is_nonneg = false
            match init {
              EInt(raw, _) => {
                let v = qbe_parse_int64_lit(raw).to_int()
                if v >= 0 {
                  is_nonneg = true
                }
              }
              EIdent(base_v, _) =>
                match g.nonneg_vars.get(base_v) {
                  Some(true) => is_nonneg = true
                  _ => ()
                }
              EBinary("+", EIdent(base_v, _), EInt(raw, _), _) =>
                if qbe_parse_int64_lit(raw) == 1L {
                  match g.nonneg_vars.get(base_v) {
                    Some(true) => is_nonneg = true
                    _ => ()
                  }
                }
              _ => ()
            }
            if is_nonneg {
              g.nonneg_vars.set(name, true)
            } else {
              g.nonneg_vars.remove(name)
            }
          }
          _ => g.nonneg_vars.remove(name)
        }
      }
      qval("0", TUnit)
    }
    SLetTuple(names, ty_expr, init, _) => {
      let ann_opt : Option[Ty] = match ty_expr {
        TyMissing(_) => None
        _ => Some(qbe_resolve_type(g, ty_expr))
      }
      // Scalarized tuple-literal destructuring: `let (a, b) = (e1, e2)`
      // Evaluate all elements left-to-right first (preserves swap semantics), zero heap tuple alloc.
      match init {
        ETuple(elems, _) =>
          if elems.length() == names.length() {
            let ann_elem_tys : Array[Ty] = match ann_opt {
              Some(TTuple(ets)) => ets
              _ => []
            }
            let ev_regs : Array[String] = []
            let ev_tys : Array[Ty] = []
            let mut ei = 0
            while ei < elems.length() {
              let exp_e : Option[Ty] = if ei < ann_elem_tys.length() {
                Some(ann_elem_tys[ei])
              } else {
                None
              }
              let ev = qbe_emit_expr(g, elems[ei], exp_e)
              ev_regs.push(ev.reg)
              ev_tys.push(ev.ty)
              ei = ei + 1
            }
            let mut bi = 0
            while bi < names.length() {
              let bname = names[bi]
              let ety = if bi < ann_elem_tys.length() {
                ann_elem_tys[bi]
              } else {
                ev_tys[bi]
              }
              let coerced = qbe_coerce_val(g, qval(ev_regs[bi], ev_tys[bi]), ety)
              if bname == "_" {
                qbe_rc_dec(g, coerced, ety)
              } else {
                let loc = qbe_define_local(g, bname, ety, true)
                qbe_store_local_slot(g, coerced, loc.slot, ety)
                g.len_aliases.remove(bname)
                g.nonneg_vars.remove(bname)
              }
              bi = bi + 1
            }
            return qval("0", TUnit)
          }
        _ => ()
      }
      let iv = qbe_emit_expr_mode(g, init, ann_opt, g.release)
      let tup_ty = match ann_opt {
        Some(a) => a
        None => iv.ty
      }
      match tup_ty {
        TTuple(elem_tys) => {
          let mut i = 0
          while i < names.length() && i < elem_tys.length() {
            let bname = names[i]
            if bname != "_" {
              let ety = elem_tys[i]
              let p = qbe_tmp(g)
              qbe_emit(g, p + " =l add " + iv.reg + ", " + (i * 8).to_string())
              let ev = qbe_load_heap_slot(g, p, ety)
              qbe_rc_inc(g, ev, ety)
              let loc = qbe_define_local(g, bname, ety, true)
              qbe_store_local_slot(g, ev, loc.slot, ety)
              g.len_aliases.remove(bname)
              g.nonneg_vars.remove(bname)
            }
            i = i + 1
          }
        }
        _ => ()
      }
      qbe_rc_dec(g, iv.reg, tup_ty)
      qval("0", TUnit)
    }
    SAssign(lhs, rhs, _) => {
      match lhs {
        EIdent(name, _) => {
          g.len_aliases.remove(name)
          qbe_invalidate_len_aliases_for(g, name)
          g.local_w_to_l_ext.remove(name)
          g.unfrozen_local_arrs.remove(name)
          g.u8_range_vars.remove(name)
          g.known_min_len_arrs.remove(name)
          g.known_writable_bytes.remove(name)
          match rhs {
            EInt(raw, _) =>
              if qbe_parse_int64_lit(raw).to_int() >= 0 {
                g.nonneg_vars.set(name, true)
              } else {
                g.nonneg_vars.remove(name)
              }
            EBinary("+", EIdent(rhs_n, _), EInt(raw, _), _) =>
              if rhs_n != name || qbe_parse_int64_lit(raw) != 1L {
                g.nonneg_vars.remove(name)
              }
            _ => g.nonneg_vars.remove(name)
          }
          match qbe_lookup_local(g, name) {
            Some(loc) => {
              let rv = qbe_emit_expr(g, rhs, Some(loc.ty))
              let rval_reg = qbe_coerce_val(g, rv, loc.ty)
              if loc.is_cell {
                let cell_p = qbe_tmp(g)
                qbe_emit(g, cell_p + " =l loadl " + loc.slot)
                let need_cell_dec = match loc.ty {
                  TParam(_) => true
                  _ => qbe_is_obj_ty(g, loc.ty)
                }
                if need_cell_dec {
                  let old = qbe_tmp(g)
                  qbe_emit(g, old + " =l loadl " + cell_p)
                  qbe_store_heap_slot(g, rval_reg, cell_p, loc.ty)
                  qbe_rc_dec(g, old, loc.ty)
                } else {
                  qbe_store_heap_slot(g, rval_reg, cell_p, loc.ty)
                }
              } else {
                let need_dec = if loc.owned {
                  match loc.ty {
                    TParam(_) => true
                    _ => qbe_is_obj_ty(g, loc.ty)
                  }
                } else {
                  false
                }
                if need_dec {
                  let old = qbe_tmp(g)
                  qbe_emit(g, old + " =l loadl " + loc.slot)
                  qbe_store_local_slot(g, rval_reg, loc.slot, loc.ty)
                  qbe_rc_dec(g, old, loc.ty)
                } else {
                  qbe_store_local_slot(g, rval_reg, loc.slot, loc.ty)
                }
              }
              g.block_immut_fields = Map([])
            }
            None => {
              let rv = qbe_emit_expr(g, rhs, None)
              let loc = qbe_define_local(g, name, rv.ty, true)
              qbe_store_local_slot(g, rv.reg, loc.slot, rv.ty)
              g.block_immut_fields = Map([])
            }
          }
        }
        EField(obj, fname, _) => {
          let mut prom_handled = false
          match obj {
            EIdent(lname, _) => {
              let pkey = lname + "." + fname
              match g.promoted_fields.get(pkey) {
                Some(pslot) =>
                  match g.promoted_field_tys.get(pkey) {
                    Some(pty) => {
                      let rv = qbe_emit_expr(g, rhs, Some(pty))
                      let rval_reg = qbe_coerce_val(g, rv, pty)
                      qbe_store_local_slot(g, rval_reg, pslot, pty)
                      g.block_immut_fields.remove(pkey)
                      prom_handled = true
                    }
                    None => ()
                  }
                None => ()
              }
            }
            _ => ()
          }
          if !prom_handled {
          let mut borrowed = false
          let mut ov = qval("0", TError)
          if !qbe_expr_has_assign(rhs) {
            match obj {
              EIdent(lname, _) =>
                match qbe_lookup_local(g, lname) {
                  Some(loc) =>
                    if !loc.is_cell {
                    match loc.ty {
                      TStruct(_, _) => {
                        let r = qbe_tmp(g)
                        qbe_emit(g, r + " =l loadl " + loc.slot)
                        ov = qval(r, loc.ty)
                        borrowed = true
                      }
                      _ => ()
                    }
                    }
                  None => ()
                }
              _ => ()
            }
          }
          if !borrowed {
            ov = qbe_emit_expr(g, obj, None)
          }
          match ov.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut i = 0
                  while i < sinfo.field_names.length() {
                    if sinfo.field_names[i] == fname {
                      let fty = subst_ty(sinfo.field_tys[i], subst)
                      let rv = qbe_emit_expr(g, rhs, Some(fty))
                      let rval_reg = qbe_coerce_val(g, rv, fty)
                      let p = qbe_tmp(g)
                      qbe_emit(g, p + " =l add " + ov.reg + ", " + (i * 8).to_string())
                      let need_dec = match fty {
                        TParam(_) => true
                        _ => qbe_is_obj_ty(g, fty)
                      }
                      if need_dec {
                        let old = qbe_tmp(g)
                        qbe_emit(g, old + " =l loadl " + p)
                        qbe_store_heap_slot(g, rval_reg, p, fty)
                        qbe_rc_dec(g, old, fty)
                      } else {
                        qbe_store_heap_slot(g, rval_reg, p, fty)
                      }
                      break
                    }
                    i = i + 1
                  }
                }
                None => ()
              }
            _ => ()
          }
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          }
        }
        EIndex(obj, idx, _) => {
          let mut borrowed = false
          let mut ov = qval("0", TError)
          let mut arr_local_name = ""
          if !qbe_expr_has_assign(idx) && !qbe_expr_has_assign(rhs) {
            match obj {
              EIdent(lname, _) =>
                match qbe_lookup_local(g, lname) {
                  Some(loc) =>
                    if !loc.is_cell {
                    match loc.ty {
                      TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                        arr_local_name = lname
                        borrowed = true
                        if (qbe_is_prim_array_elem(elem) ||
                            (qbe_flat_pod_stride(g, elem) > 0 && qbe_flat_struct_obj_mask(g, elem) == 0)) &&
                          g.hoisted_arr_len.contains(lname) &&
                          g.hoisted_arr_dp.contains(lname) {
                          ov = qval("0", loc.ty)
                        } else {
                          let r = qbe_tmp(g)
                          qbe_emit(g, r + " =l loadl " + loc.slot)
                          ov = qval(r, loc.ty)
                        }
                      }
                      TBytes => {
                        arr_local_name = lname
                        borrowed = true
                        if g.hoisted_bytes_len.contains(lname) &&
                          g.hoisted_bytes_dp.contains(lname) {
                          ov = qval("0", loc.ty)
                        } else {
                          let r = qbe_tmp(g)
                          qbe_emit(g, r + " =l loadl " + loc.slot)
                          ov = qval(r, loc.ty)
                        }
                      }
                      _ => ()
                    }
                    }
                  None => ()
                }
              EField(EIdent(vname, _), fname, _) => {
                let fkey = vname + "." + fname
                match g.hoisted_fields.get(fkey) {
                  Some(hv) =>
                    match hv.ty {
                      TArray(elem) | TFixedArray(elem) | TImmArray(elem) =>
                        if (qbe_is_prim_array_elem(elem) ||
                            (qbe_flat_pod_stride(g, elem) > 0 && qbe_flat_struct_obj_mask(g, elem) == 0)) &&
                          g.hoisted_arr_len.contains(fkey) &&
                          g.hoisted_arr_dp.contains(fkey) {
                          arr_local_name = fkey
                          borrowed = true
                          ov = qval("0", hv.ty)
                        }
                      TBytes =>
                        if g.hoisted_bytes_len.contains(fkey) &&
                          g.hoisted_bytes_dp.contains(fkey) {
                          arr_local_name = fkey
                          borrowed = true
                          ov = qval("0", hv.ty)
                        }
                      _ => ()
                    }
                  None => ()
                }
                if !borrowed &&
                  !qbe_expr_assigns_ident(idx, vname) &&
                  !qbe_expr_assigns_ident(rhs, vname) {
                  match qbe_lookup_local(g, vname) {
                    Some(loc) =>
                      if !loc.is_cell && loc.ref_slot == "" {
                        match loc.ty {
                          TStruct(sname, sargs) =>
                            match qbe_lookup_struct_info(g, sname) {
                              Some(sinfo) => {
                                let mut fi = 0
                                while fi < sinfo.field_names.length() {
                                  if sinfo.field_names[fi] == fname {
                                    if !sinfo.field_muts[fi] {
                                      let subst = make_subst(
                                        sinfo.decl.type_params,
                                        sargs,
                                      )
                                      let fty = subst_ty(
                                        sinfo.field_tys[fi],
                                        subst,
                                      )
                                      let fty_ok = match fty {
                                        TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes => true
                                        _ => false
                                      }
                                      if fty_ok {
                                        match g.hoisted_fields.get(fkey) {
                                          Some(hv) => ov = hv
                                          None =>
                                            match g.block_immut_fields.get(fkey) {
                                              Some(bv) => ov = bv
                                              None => {
                                                let obj_p = qbe_tmp(g)
                                                let fp = qbe_tmp(g)
                                                let fv = qbe_tmp(g)
                                                qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                                qbe_emit(
                                                  g,
                                                  fp + " =l add " + obj_p + ", " + (fi * 8).to_string(),
                                                )
                                                qbe_emit(g, fv + " =l loadl " + fp)
                                                ov = qval(fv, fty)
                                              }
                                            }
                                        }
                                        borrowed = true
                                        match fty {
                                          TArray(_) | TFixedArray(_) | TImmArray(_) =>
                                            if g.hoisted_arr_len.contains(fkey) {
                                              arr_local_name = fkey
                                            }
                                          TBytes =>
                                            if g.hoisted_bytes_len.contains(fkey) {
                                              arr_local_name = fkey
                                            }
                                          _ => ()
                                        }
                                      }
                                    }
                                    break
                                  }
                                  fi = fi + 1
                                }
                              }
                              None => ()
                            }
                          _ => ()
                        }
                      }
                    None => ()
                  }
                }
              }
              EIndex(EIdent(outer, _), idx1, _) =>
                if !qbe_expr_has_assign(idx1) &&
                  qbe_loop_has_no_calls_expr(g, idx) &&
                  qbe_loop_has_no_calls_expr(g, rhs) &&
                  !qbe_expr_assigns_ident(idx, outer) &&
                  !qbe_expr_assigns_ident(rhs, outer) {
                  match qbe_lookup_local(g, outer) {
                    Some(oloc) =>
                      if !oloc.is_cell {
                      match oloc.ty {
                        TArray(TArray(inner_elem)) => {
                          let outer_p = if g.hoisted_arr_len.contains(outer) &&
                            g.hoisted_arr_dp.contains(outer) {
                            "0"
                          } else {
                            let r = qbe_tmp(g)
                            qbe_emit(g, r + " =l loadl " + oloc.slot)
                            r
                          }
                          let iv1 = qbe_emit_expr(g, idx1, Some(TInt))
                          let il1 = qbe_as_l(g, iv1)
                          if !qbe_bce_expr_is_safe(g, outer, idx1) {
                            let olen = match g.hoisted_arr_len.get(outer) {
                              Some(hlen) => hlen
                              None => {
                                let t = qbe_tmp(g)
                                qbe_emit(g, t + " =l loadl " + outer_p)
                                t
                              }
                            }
                            let oob1 = qbe_tmp(g)
                            let l_oob1 = qbe_lbl(g, "arr_oob")
                            let l_ok1 = qbe_lbl(g, "arr_ok")
                            qbe_emit(g, oob1 + " =w cugel " + il1 + ", " + olen)
                            qbe_emit_term(g, "jnz " + oob1 + ", " + l_oob1 + ", " + l_ok1)
                            qbe_emit_lbl(g, l_oob1)
                            qbe_emit(g, "call $pion_panic_oob(l " + il1 + ", l " + olen + ")")
                            qbe_emit_term(g, "hlt")
                            qbe_emit_lbl(g, l_ok1)
                          }
                          let odp = match g.hoisted_arr_dp.get(outer) {
                            Some(hdp) => hdp
                            None => {
                              let dp_p = qbe_tmp(g)
                              let t = qbe_tmp(g)
                              qbe_emit(g, dp_p + " =l add " + outer_p + ", 24")
                              qbe_emit(g, t + " =l loadl " + dp_p)
                              t
                            }
                          }
                          let off1 = qbe_tmp(g)
                          let ep1 = qbe_tmp(g)
                          let inner_p = qbe_tmp(g)
                          qbe_emit(g, off1 + " =l shl " + il1 + ", 3")
                          qbe_emit(g, ep1 + " =l add " + odp + ", " + off1)
                          qbe_emit(g, inner_p + " =l loadl " + ep1)
                          ov = qval(inner_p, TArray(inner_elem))
                          borrowed = true
                        }
                        _ => ()
                      }
                      }
                    None => ()
                  }
                }
              _ => ()
            }
          }
          if !borrowed {
            ov = qbe_emit_expr(g, obj, None)
          }
          match ov.ty {
            TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              let il = qbe_as_l(g, iv)
              match qbe_flat_pod_struct_info(g, elem) {
                Some(sinfo) => {
                  let nfields = sinfo.field_names.length()
                  let stride = nfields * 8
                  // P72-A 1a/1b: Zero-boxing direct slot copy for `arr[i] = src[j]` and `arr[i] = local_pod`
                  let mut flat_assign_done = false
                  match rhs {
                    EIndex(src_obj, src_idx, _) => {
                      let mut src_can = false
                      let mut src_borrowed = false
                      let mut src_aname = ""
                      let mut src_ov = qval("0", TUnit)
                      match src_obj {
                        EIdent(aname, _) =>
                          if !qbe_expr_has_assign(src_idx) {
                            match qbe_lookup_local(g, aname) {
                              Some(sloc) =>
                                if !sloc.is_cell {
                                  match sloc.ty {
                                    TArray(se) | TFixedArray(se) | TImmArray(se) =>
                                      if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
                                        src_can = true
                                        src_borrowed = true
                                        src_aname = aname
                                        if g.hoisted_arr_len.contains(aname) &&
                                          g.hoisted_arr_dp.contains(aname) {
                                          src_ov = qval("0", sloc.ty)
                                        } else {
                                          let r = qbe_tmp(g)
                                          qbe_emit(g, r + " =l loadl " + sloc.slot)
                                          src_ov = qval(r, sloc.ty)
                                        }
                                      }
                                    _ => ()
                                  }
                                }
                              None => ()
                            }
                          }
                        _ => ()
                      }
                      if !src_can {
                        match qbe_probe_expr_ty(g, src_obj) {
                          Some(TArray(se)) | Some(TFixedArray(se)) | Some(TImmArray(se)) =>
                            if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
                              src_can = true
                              src_borrowed = false
                              src_ov = qbe_emit_expr(g, src_obj, None)
                            }
                          _ => ()
                        }
                      }
                      if src_can {
                        let src_iv = qbe_emit_expr(g, src_idx, Some(TInt))
                        let src_il = qbe_as_l(g, src_iv)
                        let bce_safe = if arr_local_name != "" {
                          qbe_bce_expr_is_safe(g, arr_local_name, idx)
                        } else {
                          false
                        }
                        if !bce_safe {
                          let alen = match g.hoisted_arr_len.get(arr_local_name) {
                            Some(hlen) => hlen
                            None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                          }
                          let oob = qbe_tmp(g)
                          let l_oob = qbe_lbl(g, "arr_oob")
                          let l_ok = qbe_lbl(g, "arr_ok")
                          qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                          qbe_emit_lbl(g, l_oob)
                          qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                          qbe_emit_term(g, "hlt")
                          qbe_emit_lbl(g, l_ok)
                        }
                        let src_bce = if src_aname != "" {
                          qbe_bce_expr_is_safe(g, src_aname, src_idx)
                        } else {
                          false
                        }
                        if !src_bce {
                          let salen = match g.hoisted_arr_len.get(src_aname) {
                            Some(hlen) => hlen
                            None => {
                              let t = qbe_tmp(g)
                              qbe_emit(g, t + " =l loadl " + src_ov.reg)
                              t
                            }
                          }
                          let oob = qbe_tmp(g)
                          let l_oob = qbe_lbl(g, "arr_oob")
                          let l_ok = qbe_lbl(g, "arr_ok")
                          qbe_emit(g, oob + " =w cugel " + src_il + ", " + salen)
                          qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                          qbe_emit_lbl(g, l_oob)
                          qbe_emit(g, "call $pion_panic_oob(l " + src_il + ", l " + salen + ")")
                          qbe_emit_term(g, "hlt")
                          qbe_emit_lbl(g, l_ok)
                        }
                        let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                          Some(hdp) => hdp
                          None => {
                            let dp_p = qbe_tmp(g)
                            let t = qbe_tmp(g)
                            qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                            qbe_emit(g, t + " =l loadl " + dp_p)
                            t
                          }
                        }
                        let sdp = match g.hoisted_arr_dp.get(src_aname) {
                          Some(hdp) => hdp
                          None => {
                            let dp_p = qbe_tmp(g)
                            let t = qbe_tmp(g)
                            qbe_emit(g, dp_p + " =l add " + src_ov.reg + ", 24")
                            qbe_emit(g, t + " =l loadl " + dp_p)
                            t
                          }
                        }
                        let dst_ep = qbe_emit_arr_elem_addr(g, dp, il, stride)
                        let src_ep = qbe_emit_arr_elem_addr(g, sdp, src_il, stride)
                        let is_unfrozen_local = arr_local_name != "" &&
                          g.unfrozen_local_arrs.contains(arr_local_name)
                        let adopt_arr = if is_unfrozen_local || ov.reg == "0" { "" } else { ov.reg }
                        qbe_emit_flat_copy_slots_rc(g, dst_ep, src_ep, sinfo, elem, true, true, adopt_arr)
                        if !src_borrowed {
                          qbe_rc_dec(g, src_ov.reg, src_ov.ty)
                        }
                        flat_assign_done = true
                      }
                    }
                    EIdent(rname, _) =>
                      match qbe_lookup_local(g, rname) {
                        Some(rloc) =>
                          if !rloc.is_cell && qbe_ty_matches_flat_pod_struct(g, rloc.ty, sinfo) {
                            let bce_safe = if arr_local_name != "" {
                              qbe_bce_expr_is_safe(g, arr_local_name, idx)
                            } else {
                              false
                            }
                            if !bce_safe {
                              let alen = match g.hoisted_arr_len.get(arr_local_name) {
                                Some(hlen) => hlen
                                None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                              }
                              let oob = qbe_tmp(g)
                              let l_oob = qbe_lbl(g, "arr_oob")
                              let l_ok = qbe_lbl(g, "arr_ok")
                              qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                              qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                              qbe_emit_lbl(g, l_oob)
                              qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                              qbe_emit_term(g, "hlt")
                              qbe_emit_lbl(g, l_ok)
                            }
                            let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                              Some(hdp) => hdp
                              None => {
                                let dp_p = qbe_tmp(g)
                                let t = qbe_tmp(g)
                                qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                                qbe_emit(g, t + " =l loadl " + dp_p)
                                t
                              }
                            }
                            let dst_ep = qbe_emit_arr_elem_addr(g, dp, il, stride)
                            let src_p = qbe_tmp(g)
                            qbe_emit(g, src_p + " =l loadl " + rloc.slot)
                            let is_unfrozen_local = arr_local_name != "" &&
                              g.unfrozen_local_arrs.contains(arr_local_name)
                            let adopt_arr = if is_unfrozen_local || ov.reg == "0" { "" } else { ov.reg }
                            qbe_emit_flat_copy_slots_rc(g, dst_ep, src_p, sinfo, elem, true, true, adopt_arr)
                            flat_assign_done = true
                          }
                        None => ()
                      }
                    _ => ()
                  }
                  if !flat_assign_done {
                  let lit_vals_opt : Option[Array[QbeVal]] = match rhs {
                    EStructLit(_, None, fields, _) =>
                      Some(qbe_emit_flat_eval_struct_lit(g, sinfo, elem, fields))
                    _ => None
                  }
                  let rv_opt : Option[QbeVal] = match lit_vals_opt {
                    Some(_) => None
                    None => Some(qbe_emit_expr(g, rhs, Some(elem)))
                  }
                  let bce_safe = if arr_local_name != "" {
                    qbe_bce_expr_is_safe(g, arr_local_name, idx)
                  } else {
                    false
                  }
                  if !bce_safe {
                    let alen = match g.hoisted_arr_len.get(arr_local_name) {
                      Some(hlen) => hlen
                      None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let ep = qbe_emit_arr_elem_addr(g, dp, il, stride)
                  let is_unfrozen_local = arr_local_name != "" &&
                    g.unfrozen_local_arrs.contains(arr_local_name)
                  let adopt_arr = if is_unfrozen_local || ov.reg == "0" { "" } else { ov.reg }
                  match lit_vals_opt {
                    Some(slot_vals) =>
                      qbe_emit_flat_store_vals_rc(g, ep, slot_vals, true, adopt_arr)
                    None =>
                      match rv_opt {
                        Some(rv) => {
                          qbe_emit_flat_copy_slots_rc(g, ep, rv.reg, sinfo, elem, true, true, adopt_arr)
                          qbe_rc_dec(g, rv.reg, rv.ty)
                        }
                        None => ()
                      }
                  }
                  }
                }
                None =>
                  if qbe_is_prim_array_elem(elem) {
                let idx_key = if borrowed &&
                  arr_local_name != "" &&
                  qbe_loop_has_no_calls_expr(g, rhs) &&
                  !qbe_expr_assigns_ident(rhs, arr_local_name) {
                  qbe_pure_idx_key(idx)
                } else {
                  ""
                }
                let reuse_ep = idx_key != "" &&
                  qbe_expr_has_same_index(rhs, arr_local_name, idx_key)
                if reuse_ep {
                  let bce_safe = qbe_bce_expr_is_safe(g, arr_local_name, idx)
                  if !bce_safe {
                    let alen = match g.hoisted_arr_len.get(arr_local_name) {
                      Some(hlen) => hlen
                      None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let ep = qbe_emit_arr_ep_ty(g, dp, il, elem)
                  let prev_arr = g.assign_idx_arr
                  let prev_key = g.assign_idx_key
                  let prev_ep = g.assign_idx_ep
                  g.assign_idx_arr = arr_local_name
                  g.assign_idx_key = idx_key
                  g.assign_idx_ep = ep
                  let rv = qbe_emit_expr(g, rhs, Some(elem))
                  g.assign_idx_arr = prev_arr
                  g.assign_idx_key = prev_key
                  g.assign_idx_ep = prev_ep
                  qbe_store_arr_elem(g, qbe_coerce_val(g, rv, elem), ep, elem)
                } else {
                  let rv = qbe_emit_expr(g, rhs, Some(elem))
                  let bce_safe = if arr_local_name != "" {
                    qbe_bce_expr_is_safe(g, arr_local_name, idx)
                  } else {
                    false
                  }
                  if !bce_safe {
                    let alen = match g.hoisted_arr_len.get(arr_local_name) {
                      Some(hlen) => hlen
                      None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let ep = qbe_emit_arr_ep_ty(g, dp, il, elem)
                  qbe_store_arr_elem(g, qbe_coerce_val(g, rv, elem), ep, elem)
                }
              } else {
                let rv = qbe_emit_expr(g, rhs, Some(elem))
                let vl = qbe_as_l(g, rv)
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, elem, true)
                qbe_emit(
                  g,
                  "call $pion_arr_set(l " + ov.reg + ", l " + il + ", l " + vl + ")",
                )
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
              }
            }
            TMap(kty, vty) => {
              if qbe_is_vmap_key_ty(g, kty) {
                let m = qbe_ensure_vmap_fns(g, kty, vty)
                let vka = qbe_emit_vmap_key_args(g, idx, kty, !qbe_expr_has_assign(idx))
                let rv = qbe_emit_expr(g, rhs, Some(vty))
                let vc = qbe_coerce_val(g, rv, vty)
                let vl = qbe_as_l(g, qval(vc, vty))
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, false)
                qbe_emit(
                  g,
                  "call $pion_vmap_set_" +
                  m +
                  "(l " +
                  ov.reg +
                  qbe_vmap_key_call_args(vka) +
                  ", " +
                  qbe_abi_ty(vty) +
                  " " +
                  vc +
                  ")",
                )
                qbe_rc_dec(g, rv.reg, rv.ty)
              } else {
                let kv = qbe_emit_expr(g, idx, Some(kty))
                let kl = qbe_as_l(g, kv)
                let rv = qbe_emit_expr(g, rhs, Some(vty))
                let vl = qbe_as_l(g, rv)
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, true)
                qbe_emit(
                  g,
                  "call $pion_map_set(l " + ov.reg + ", l " + kl + ", l " + vl + ")",
                )
                qbe_rc_dec(g, kv.reg, kv.ty)
                qbe_rc_dec(g, rv.reg, rv.ty)
              }
            }
            TBytes => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              let il = qbe_as_l(g, iv)
              let rv = qbe_emit_expr(g, rhs, Some(TByte))
              let bce_safe = if arr_local_name != "" {
                qbe_bce_expr_is_safe(g, arr_local_name, idx)
              } else {
                false
              }
              if !bce_safe {
                let blen = match g.hoisted_bytes_len.get(arr_local_name) {
                  Some(hlen) => hlen
                  None => {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =l loadl " + ov.reg)
                    t
                  }
                }
                let oob = qbe_tmp(g)
                let l_oob = qbe_lbl(g, "bytes_oob")
                let l_ok = qbe_lbl(g, "bytes_ok")
                qbe_emit(g, oob + " =w cugel " + il + ", " + blen)
                qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                qbe_emit_lbl(g, l_oob)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + blen + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok)
              }
              qbe_emit_bytes_writable_check(g, ov.reg, arr_local_name)
              let dp = match g.hoisted_bytes_dp.get(arr_local_name) {
                Some(hdp) => hdp
                None => {
                  let dp_p = qbe_tmp(g)
                  let t = qbe_tmp(g)
                  qbe_emit(g, dp_p + " =l add " + ov.reg + ", 16")
                  qbe_emit(g, t + " =l loadl " + dp_p)
                  t
                }
              }
              let ep = qbe_tmp(g)
              let vw = qbe_tmp(g)
              qbe_emit(g, ep + " =l add " + dp + ", " + il)
              qbe_emit(g, vw + " =w copy " + rv.reg)
              qbe_emit(g, "storeb " + vw + ", " + ep)
            }
            _ => ()
          }
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
        }
        _ => {
          let rv = qbe_emit_expr(g, rhs, None)
          qbe_rc_dec(g, rv.reg, rv.ty)
        }
      }
      qval("0", TUnit)
    }
    SCompoundAssign(op, lhs, rhs, sp) => {
      g.verify_sp = sp
      match lhs {
        EIdent(_, _) =>
          return qbe_emit_stmt(
            g,
            SAssign(lhs, EBinary(op, lhs, rhs, sp), sp),
            None,
            false,
          )
        EField(obj, fname, _) => {
          let mut prom_handled = false
          match obj {
            EIdent(lname, _) => {
              let pkey = lname + "." + fname
              match g.promoted_fields.get(pkey) {
                Some(pslot) =>
                  match g.promoted_field_tys.get(pkey) {
                    Some(pty) => {
                      let old_v = qbe_load_local_slot(g, pslot, pty)
                      let rv = qbe_emit_expr(g, rhs, Some(pty))
                      let new_v = qbe_emit_compound_binop(g, op, old_v, rv, pty)
                      qbe_store_local_slot(g, new_v, pslot, pty)
                      g.block_immut_fields.remove(pkey)
                      prom_handled = true
                    }
                    None => ()
                  }
                None => ()
              }
            }
            _ => ()
          }
          if !prom_handled {
          let ov = qbe_emit_expr(g, obj, None)
          match ov.ty {
            TStruct(sname, sargs) =>
              match qbe_lookup_struct_info(g, sname) {
                Some(sinfo) => {
                  let subst = make_subst(sinfo.decl.type_params, sargs)
                  let mut fi = 0
                  while fi < sinfo.field_names.length() {
                    if sinfo.field_names[fi] == fname {
                      let fty = subst_ty(sinfo.field_tys[fi], subst)
                      let fp = qbe_tmp(g)
                      qbe_emit(g, fp + " =l add " + ov.reg + ", " + (fi * 8).to_string())
                      let old_v = qbe_load_heap_slot(g, fp, fty)
                      let rv = qbe_emit_expr(g, rhs, Some(fty))
                      let new_v = qbe_emit_compound_binop(g, op, old_v, rv, fty)
                      if qbe_is_obj_ty(g, fty) {
                        qbe_emit_adopt_if_frozen(g, ov.reg, new_v, fty, true)
                        qbe_rc_dec(g, old_v, fty)
                      }
                      qbe_store_heap_slot(g, new_v, fp, fty)
                      break
                    }
                    fi = fi + 1
                  }
                }
                None => ()
              }
            _ => ()
          }
          qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval("0", TUnit)
        }
        EIndex(obj, idx, _) => {
          let rhs_pure = qbe_expr_is_pure_no_trap(g, rhs, false)
          let mut borrowed = false
          let mut ov = qval("0", TError)
          let mut arr_local_name = ""
          if rhs_pure && !qbe_expr_has_assign(idx) && !qbe_expr_has_assign(rhs) {
            match obj {
              EIdent(lname, _) =>
                if !qbe_expr_assigns_ident(idx, lname) &&
                  !qbe_expr_assigns_ident(rhs, lname) {
                  match qbe_lookup_local(g, lname) {
                    Some(loc) =>
                      if !loc.is_cell {
                        match loc.ty {
                          TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                            arr_local_name = lname
                            borrowed = true
                            if qbe_is_prim_array_elem(elem) &&
                              g.hoisted_arr_len.contains(lname) &&
                              g.hoisted_arr_dp.contains(lname) {
                              ov = qval("0", loc.ty)
                            } else {
                              let r = qbe_tmp(g)
                              qbe_emit(g, r + " =l loadl " + loc.slot)
                              ov = qval(r, loc.ty)
                            }
                          }
                          TBytes => {
                            arr_local_name = lname
                            borrowed = true
                            if g.hoisted_bytes_len.contains(lname) &&
                              g.hoisted_bytes_dp.contains(lname) {
                              ov = qval("0", loc.ty)
                            } else {
                              let r = qbe_tmp(g)
                              qbe_emit(g, r + " =l loadl " + loc.slot)
                              ov = qval(r, loc.ty)
                            }
                          }
                          _ => ()
                        }
                      }
                    None => ()
                  }
                }
              EField(EIdent(vname, _), fname, _) =>
                if !qbe_expr_assigns_ident(idx, vname) &&
                  !qbe_expr_assigns_ident(rhs, vname) {
                  let fkey = vname + "." + fname
                  match qbe_lookup_local(g, vname) {
                    Some(loc) =>
                      if !loc.is_cell && loc.ref_slot == "" {
                        match loc.ty {
                          TStruct(sname, sargs) =>
                            match qbe_lookup_struct_info(g, sname) {
                              Some(sinfo) => {
                                let mut fi = 0
                                while fi < sinfo.field_names.length() {
                                  if sinfo.field_names[fi] == fname {
                                    if !sinfo.field_muts[fi] {
                                      let subst = make_subst(
                                        sinfo.decl.type_params,
                                        sargs,
                                      )
                                      let fty = subst_ty(
                                        sinfo.field_tys[fi],
                                        subst,
                                      )
                                      let fty_ok = match fty {
                                        TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes => true
                                        _ => false
                                      }
                                      if fty_ok {
                                        match g.hoisted_fields.get(fkey) {
                                          Some(hv) => ov = hv
                                          None =>
                                            match g.block_immut_fields.get(fkey) {
                                              Some(bv) => ov = bv
                                              None => {
                                                let obj_p = qbe_tmp(g)
                                                let fp = qbe_tmp(g)
                                                let fv = qbe_tmp(g)
                                                qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                                qbe_emit(
                                                  g,
                                                  fp + " =l add " + obj_p + ", " + (fi * 8).to_string(),
                                                )
                                                qbe_emit(g, fv + " =l loadl " + fp)
                                                ov = qval(fv, fty)
                                              }
                                            }
                                        }
                                        borrowed = true
                                        match fty {
                                          TArray(_) | TFixedArray(_) | TImmArray(_) =>
                                            if g.hoisted_arr_len.contains(fkey) {
                                              arr_local_name = fkey
                                            }
                                          TBytes =>
                                            if g.hoisted_bytes_len.contains(fkey) {
                                              arr_local_name = fkey
                                            }
                                          _ => ()
                                        }
                                      }
                                    }
                                    break
                                  }
                                  fi = fi + 1
                                }
                              }
                              None => ()
                            }
                          _ => ()
                        }
                      }
                    None => ()
                  }
                }
              _ => ()
            }
          }
          if !borrowed {
            ov = qbe_emit_expr(g, obj, None)
            if g.block_term {
              return qval("0", TNever)
            }
          }
          qbe_scope_push(g)
          if !borrowed && qbe_is_obj_ty(g, ov.ty) {
            let ov_nm = "$__ca_ov_" + g.next_tmp.to_string()
            g.next_tmp = g.next_tmp + 1
            let ov_loc = qbe_define_local(g, ov_nm, ov.ty, true)
            qbe_store_local_slot(g, ov.reg, ov_loc.slot, ov.ty)
          }
          match ov.ty {
            TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              if g.block_term {
                qbe_scope_pop(g)
                return qval("0", TNever)
              }
              let il = qbe_as_l(g, iv)
              let bce_safe = if arr_local_name != "" {
                qbe_bce_expr_is_safe(g, arr_local_name, idx)
              } else {
                false
              }
              if !bce_safe {
                let alen = match g.hoisted_arr_len.get(arr_local_name) {
                  Some(hlen) => hlen
                  None => qbe_array_length_operand(g, arr_local_name, ov.reg)
                }
                let oob = qbe_tmp(g)
                let l_oob = qbe_lbl(g, "arr_oob")
                let l_ok = qbe_lbl(g, "arr_ok")
                qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
                qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                qbe_emit_lbl(g, l_oob)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok)
              }
              let dp = match g.hoisted_arr_dp.get(arr_local_name) {
                Some(hdp) => hdp
                None => {
                  let dp_p = qbe_tmp(g)
                  let t = qbe_tmp(g)
                  qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
                  qbe_emit(g, t + " =l loadl " + dp_p)
                  t
                }
              }
              let ep = qbe_emit_arr_ep_ty(g, dp, il, elem)
              let old_v = qbe_load_arr_elem(g, ep, elem)
              let hold_old_obj = !rhs_pure && qbe_is_obj_ty(g, elem)
              if hold_old_obj {
                qbe_rc_inc(g, old_v, elem)
                let old_nm = "$__ca_old_" + g.next_tmp.to_string()
                g.next_tmp = g.next_tmp + 1
                let old_loc = qbe_define_local(g, old_nm, elem, true)
                qbe_store_local_slot(g, old_v, old_loc.slot, elem)
              }
              let rv = qbe_emit_expr(g, rhs, Some(elem))
              if g.block_term {
                qbe_scope_pop(g)
                return qval("0", TNever)
              }
              let new_v = qbe_emit_compound_binop(g, op, old_v, rv, elem)
              let is_dyn_arr = match ov.ty {
                TArray(_) => true
                _ => false
              }
              let store_ep = if is_dyn_arr && !rhs_pure {
                // Impure RHS may push/realloc (moving data ptr) or pop/clear (shrinking len).
                let alen2 = qbe_tmp(g)
                qbe_emit(g, alen2 + " =l loadl " + ov.reg)
                let oob2 = qbe_tmp(g)
                let l_oob2 = qbe_lbl(g, "arr_oob2")
                let l_ok2 = qbe_lbl(g, "arr_ok2")
                qbe_emit(g, oob2 + " =w cugel " + il + ", " + alen2)
                qbe_emit_term(g, "jnz " + oob2 + ", " + l_oob2 + ", " + l_ok2)
                qbe_emit_lbl(g, l_oob2)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen2 + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok2)
                let dp2_p = qbe_tmp(g)
                let dp2 = qbe_tmp(g)
                qbe_emit(g, dp2_p + " =l add " + ov.reg + ", 24")
                qbe_emit(g, dp2 + " =l loadl " + dp2_p)
                qbe_emit_arr_ep_ty(g, dp2, il, elem)
              } else {
                ep
              }
              if qbe_is_u8_array_elem(g, elem) ||
                qbe_is_4b_array_elem(g, elem) ||
                qbe_is_prim_array_elem(elem) {
                qbe_store_arr_elem(g, new_v, store_ep, elem)
              } else {
                let vl = qbe_as_l(g, qval(new_v, elem))
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, elem, true)
                qbe_emit(
                  g,
                  "call $pion_arr_set(l " + ov.reg + ", l " + il + ", l " + vl + ")",
                )
                qbe_rc_dec(g, new_v, elem)
              }
            }
            TBytes => {
              let iv = qbe_emit_expr(g, idx, Some(TInt))
              if g.block_term {
                qbe_scope_pop(g)
                return qval("0", TNever)
              }
              let il = qbe_as_l(g, iv)
              let bce_safe = if arr_local_name != "" {
                qbe_bce_expr_is_safe(g, arr_local_name, idx)
              } else {
                false
              }
              if !bce_safe {
                let blen = match g.hoisted_bytes_len.get(arr_local_name) {
                  Some(hlen) => hlen
                  None => {
                    let t = qbe_tmp(g)
                    qbe_emit(g, t + " =l loadl " + ov.reg)
                    t
                  }
                }
                let oob = qbe_tmp(g)
                let l_oob = qbe_lbl(g, "bytes_oob")
                let l_ok = qbe_lbl(g, "bytes_ok")
                qbe_emit(g, oob + " =w cugel " + il + ", " + blen)
                qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                qbe_emit_lbl(g, l_oob)
                qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + blen + ")")
                qbe_emit_term(g, "hlt")
                qbe_emit_lbl(g, l_ok)
              }
              qbe_emit_bytes_writable_check(g, ov.reg, arr_local_name)
              let dp = match g.hoisted_bytes_dp.get(arr_local_name) {
                Some(hdp) => hdp
                None => {
                  let dp_p = qbe_tmp(g)
                  let t = qbe_tmp(g)
                  qbe_emit(g, dp_p + " =l add " + ov.reg + ", 16")
                  qbe_emit(g, t + " =l loadl " + dp_p)
                  t
                }
              }
              let ep = qbe_tmp(g)
              let bw = qbe_tmp(g)
              let bl = qbe_tmp(g)
              qbe_emit(g, ep + " =l add " + dp + ", " + il)
              qbe_emit(g, bw + " =w loadub " + ep)
              qbe_emit(g, bl + " =l extuw " + bw)
              let rv = qbe_emit_expr(g, rhs, Some(TByte))
              if g.block_term {
                qbe_scope_pop(g)
                return qval("0", TNever)
              }
              let new_v = qbe_emit_compound_binop(g, op, bl, rv, TByte)
              let vw = qbe_tmp(g)
              qbe_emit(g, vw + " =w copy " + new_v)
              qbe_emit(g, "storeb " + vw + ", " + ep)
            }
            TMap(kty, vty) => {
              if qbe_is_vmap_key_ty(g, kty) {
                let m = qbe_ensure_vmap_fns(g, kty, vty)
                let vka = qbe_emit_vmap_key_args(g, idx, kty, !qbe_expr_has_assign(idx))
                if g.block_term {
                  qbe_scope_pop(g)
                  return qval("0", TNever)
                }
                let kstr = qbe_vmap_key_call_args(vka)
                let old_v = qbe_tmp(g)
                qbe_emit(
                  g,
                  old_v + " =" + qbe_abi_ty(vty) + " call $pion_vmap_get_" + m + "(l " + ov.reg + kstr + ")",
                )
                if !rhs_pure && qbe_is_obj_ty(g, vty) {
                  qbe_rc_inc(g, old_v, vty)
                  let old_nm = "$__ca_mv_" + g.next_tmp.to_string()
                  g.next_tmp = g.next_tmp + 1
                  let old_loc = qbe_define_local(g, old_nm, vty, true)
                  qbe_store_local_slot(g, old_v, old_loc.slot, vty)
                }
                let rv = qbe_emit_expr(g, rhs, Some(vty))
                if g.block_term {
                  qbe_scope_pop(g)
                  return qval("0", TNever)
                }
                let new_v = qbe_emit_compound_binop(g, op, old_v, rv, vty)
                let vc = qbe_coerce_val(g, qval(new_v, vty), vty)
                let vl = qbe_as_l(g, qval(vc, vty))
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, false)
                qbe_emit(
                  g,
                  "call $pion_vmap_set_" +
                  m +
                  "(l " +
                  ov.reg +
                  kstr +
                  ", " +
                  qbe_abi_ty(vty) +
                  " " +
                  vc +
                  ")",
                )
                if qbe_is_obj_ty(g, vty) {
                  qbe_rc_dec(g, new_v, vty)
                }
              } else {
                let kv = qbe_emit_expr(g, idx, Some(kty))
                if g.block_term {
                  qbe_scope_pop(g)
                  return qval("0", TNever)
                }
                if qbe_is_obj_ty(g, kv.ty) {
                  let kv_nm = "$__ca_kv_" + g.next_tmp.to_string()
                  g.next_tmp = g.next_tmp + 1
                  let kv_loc = qbe_define_local(g, kv_nm, kv.ty, true)
                  qbe_store_local_slot(g, kv.reg, kv_loc.slot, kv.ty)
                }
                let kl = qbe_as_l(g, kv)
                let old_l = qbe_tmp(g)
                qbe_emit(
                  g,
                  old_l + " =l call $pion_map_get(l " + ov.reg + ", l " + kl + ")",
                )
                let old_v = match vty {
                  TInt | TUInt => {
                    let w = qbe_tmp(g)
                    qbe_emit(g, w + " =w copy " + old_l)
                    w
                  }
                  TDouble => {
                    let d = qbe_tmp(g)
                    qbe_emit(g, d + " =d cast " + old_l)
                    d
                  }
                  TFloat => qbe_from_l(g, old_l, TFloat)
                  _ => old_l
                }
                if !rhs_pure && qbe_is_obj_ty(g, vty) {
                  qbe_rc_inc(g, old_v, vty)
                  let old_nm = "$__ca_mv_" + g.next_tmp.to_string()
                  g.next_tmp = g.next_tmp + 1
                  let old_loc = qbe_define_local(g, old_nm, vty, true)
                  qbe_store_local_slot(g, old_v, old_loc.slot, vty)
                }
                let rv = qbe_emit_expr(g, rhs, Some(vty))
                if g.block_term {
                  qbe_scope_pop(g)
                  return qval("0", TNever)
                }
                let new_v = qbe_emit_compound_binop(g, op, old_v, rv, vty)
                let vl = qbe_as_l(g, qval(new_v, vty))
                qbe_emit_adopt_if_frozen(g, ov.reg, vl, vty, true)
                qbe_emit(
                  g,
                  "call $pion_map_set(l " + ov.reg + ", l " + kl + ", l " + vl + ")",
                )
                if qbe_is_obj_ty(g, vty) {
                  qbe_rc_dec(g, new_v, vty)
                }
              }
            }
            _ => ()
          }
          qbe_scope_pop(g)
          qval("0", TUnit)
        }
        _ => {
          let rv = qbe_emit_expr(g, rhs, None)
          qbe_rc_dec(g, rv.reg, rv.ty)
          qval("0", TUnit)
        }
      }
    }
    SGuard(cond, else_body, sp) => {
      let cur_sc = g.scopes[g.scopes.length() - 1]
      let saved_len = cur_sc.locals.length()
      let l_ok = qbe_lbl(g, "grd_ok")
      let l_else = qbe_lbl(g, "grd_el")
      if qbe_expr_has_is(cond) {
        qbe_emit_cond_branch_bind(g, cond, l_ok, l_else, None)
      } else {
        qbe_emit_cond_branch(g, cond, l_ok, l_else)
      }
      // Detach newly bound guard locals while emitting `else` so `else` neither sees nor frees them
      let new_locals : Array[QbeLocal] = []
      while cur_sc.locals.length() > saved_len {
        match cur_sc.locals.pop() {
          Some(loc) => new_locals.push(loc)
          None => break
        }
      }
      qbe_emit_lbl(g, l_else)
      qbe_scope_push(g)
      let ev = qbe_emit_stmts(g, else_body, None)
      if !g.block_term {
        qbe_rc_dec(g, ev.reg, ev.ty)
      }
      qbe_scope_pop(g)
      if !g.block_term {
        let msg_id = qbe_intern_cstring(g, "guard else did not diverge")
        let file_id = qbe_intern_source_path(g, sp.file)
        qbe_emit(
          g,
          "call $pion_panic(l $pion_cstr_" +
          msg_id.to_string() +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_emit_term(g, "hlt")
      }
      qbe_emit_lbl(g, l_ok)
      // Restore newly bound guard locals in original order into enclosing scope
      let mut ni = new_locals.length() - 1
      while ni >= 0 {
        cur_sc.locals.push(new_locals[ni])
        ni = ni - 1
      }
      let grd_bound : Map[String, Bool] = Map([])
      let mut gbi = 0
      while gbi < new_locals.length() {
        grd_bound.set(new_locals[gbi].name, true)
        gbi = gbi + 1
      }
      let grd_names_raw : Array[String] = []
      let grd_mins_raw : Array[Int] = []
      qbe_collect_pos_min_lens(g, cond, grd_names_raw, grd_mins_raw)
      let grd_names : Array[String] = []
      let grd_mins : Array[Int] = []
      let mut gri = 0
      while gri < grd_names_raw.length() {
        if !grd_bound.contains(grd_names_raw[gri]) {
          grd_names.push(grd_names_raw[gri])
          grd_mins.push(grd_mins_raw[gri])
        }
        gri = gri + 1
      }
      qbe_apply_min_lens(g, cond, grd_names, grd_mins)
      qval("0", TUnit)
    }
    SWhile(cond, body, _) => {
      if qbe_expr_has_is(cond) {
        qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), None, body)
        let l_cond = qbe_lbl(g, "wh_c")
        let l_body = qbe_lbl(g, "wh_b")
        let l_end = qbe_lbl(g, "wh_e")
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_cond)
        let loop_depth = g.scopes.length()
        g.hot_loop_depth = g.hot_loop_depth + 1
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_body, l_end, None)
        qbe_emit_lbl(g, l_body)
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_cond)
        g.loop_depths.push(loop_depth)
        let wh_dp_pinned : Array[String] = []
        qbe_pin_top_scope_for_cond_stmts(g, cond, body, wh_dp_pinned)
        let bv = qbe_emit_stmts(g, body, None)
        qbe_unpin_slot_list(g, wh_dp_pinned)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        g.hot_loop_depth = g.hot_loop_depth - 1
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_end)
        return qval("0", TUnit)
      }
      qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), None, body)
      let loop_no_calls = qbe_loop_has_no_calls_expr(g, cond) &&
        qbe_loop_has_no_calls_stmts(g, body)
      // Loop-invariant Array header (len + data pointer) & String (len + data ptr) hoisting
      let cand_arrs : Array[String] = []
      let cand_counts : Map[String, Int] = Map([])
      let cand_strs : Array[String] = []
      qbe_collect_loop_idx_expr(cond, cand_arrs, cand_counts, cand_strs, 8)
      qbe_collect_loop_idx_stmts(body, cand_arrs, cand_counts, cand_strs, 8)
      let stable_arrs : Array[String] = []
      let newly_hoisted_bytes : Array[String] = []
      let newly_hoisted_strs : Array[String] = []
      let mut ai = 0
      while ai < cand_arrs.length() {
        let aname = cand_arrs[ai]
        match qbe_lookup_local(g, aname) {
          Some(aloc) =>
            if !aloc.is_cell {
            match aloc.ty {
              // A body that rebinds `aname` (`let a = ...` inside the loop)
              // must not see the outer header: the stability scans stop at
              // the shadowing `let`, but the hoisted len / data pointer are
              // looked up by name for the rest of the body.
              TFixedArray(_) | TImmArray(_) =>
                if !g.hoisted_arr_len.contains(aname) &&
                  !qbe_expr_rebinds_ident(cond, aname) &&
                  !qbe_stmts_rebinds_ident(body, aname) &&
                  qbe_arr_is_stable_expr(cond, aname, true) &&
                  qbe_arr_is_stable_stmts(body, 0, aname, true) {
                  stable_arrs.push(aname)
                }
              TArray(_) =>
                if !g.hoisted_arr_len.contains(aname) &&
                  !qbe_expr_rebinds_ident(cond, aname) &&
                  !qbe_stmts_rebinds_ident(body, aname) &&
                  (loop_no_calls ||
                    g.unfrozen_local_arrs.contains(aname) ||
                    (qbe_no_aliasing_calls_expr(g, cond, aname, qbe_hints_new()) &&
                      qbe_no_aliasing_calls_stmts(g, body, aname, qbe_hints_new()))) &&
                  qbe_arr_is_stable_expr(cond, aname, true) &&
                  qbe_arr_is_stable_stmts(body, 0, aname, true) {
                  stable_arrs.push(aname)
                }
              TBytes =>
                if !g.hoisted_bytes_len.contains(aname) &&
                  !qbe_expr_assigns_ident(cond, aname) &&
                  !qbe_stmts_assigns_ident(body, aname) &&
                  !qbe_expr_rebinds_ident(cond, aname) &&
                  !qbe_stmts_rebinds_ident(body, aname) {
                  let bp = qbe_tmp(g)
                  let blen = qbe_tmp(g)
                  let dp_p = qbe_tmp(g)
                  let bdp = qbe_tmp(g)
                  qbe_emit(g, bp + " =l loadl " + aloc.slot)
                  qbe_emit(g, blen + " =l loadl " + bp)
                  qbe_emit(g, dp_p + " =l add " + bp + ", 16")
                  qbe_emit(g, bdp + " =l loadl " + dp_p)
                  g.hoisted_bytes_len.set(aname, blen)
                  g.hoisted_bytes_dp.set(aname, bdp)
                  newly_hoisted_bytes.push(aname)
                }
              TStrView =>
                if !g.hoisted_str_len.contains(aname) &&
                  !qbe_expr_assigns_ident(cond, aname) &&
                  !qbe_stmts_assigns_ident(body, aname) &&
                  !qbe_expr_rebinds_ident(cond, aname) &&
                  !qbe_stmts_rebinds_ident(body, aname) {
                  let vp = qbe_tmp(g)
                  let pp = qbe_tmp(g)
                  let vdp = qbe_tmp(g)
                  let lp = qbe_tmp(g)
                  let vlen = qbe_tmp(g)
                  qbe_emit(g, vp + " =l loadl " + aloc.slot)
                  qbe_emit(g, pp + " =l add " + vp + ", 8")
                  qbe_emit(g, vdp + " =l loadl " + pp)
                  qbe_emit(g, lp + " =l add " + vp + ", 16")
                  qbe_emit(g, vlen + " =l loadl " + lp)
                  g.hoisted_str_len.set(aname, vlen)
                  g.hoisted_str_dp.set(aname, vdp)
                  newly_hoisted_strs.push(aname)
                }
              TBytesView =>
                if !g.hoisted_bytes_len.contains(aname) &&
                  !qbe_expr_assigns_ident(cond, aname) &&
                  !qbe_stmts_assigns_ident(body, aname) &&
                  !qbe_expr_rebinds_ident(cond, aname) &&
                  !qbe_stmts_rebinds_ident(body, aname) {
                  let vp = qbe_tmp(g)
                  let pp = qbe_tmp(g)
                  let vdp = qbe_tmp(g)
                  let lp = qbe_tmp(g)
                  let vlen = qbe_tmp(g)
                  qbe_emit(g, vp + " =l loadl " + aloc.slot)
                  qbe_emit(g, pp + " =l add " + vp + ", 8")
                  qbe_emit(g, vdp + " =l loadl " + pp)
                  qbe_emit(g, lp + " =l add " + vp + ", 16")
                  qbe_emit(g, vlen + " =l loadl " + lp)
                  g.hoisted_bytes_len.set(aname, vlen)
                  g.hoisted_bytes_dp.set(aname, vdp)
                  newly_hoisted_bytes.push(aname)
                }
              _ => ()
            }
            }
          None => ()
        }
        ai = ai + 1
      }
      // Register pressure budget: in loops with calls, cap hoisted arrays to top 3 hottest
      if !loop_no_calls && stable_arrs.length() > 3 {
        let mut si = 1
        while si < stable_arrs.length() {
          let cur = stable_arrs[si]
          let cur_c = match cand_counts.get(cur) {
            Some(v) => v
            None => 0
          }
          let mut sj = si - 1
          while sj >= 0 {
            let prev = stable_arrs[sj]
            let prev_c = match cand_counts.get(prev) {
              Some(v) => v
              None => 0
            }
            if prev_c < cur_c {
              stable_arrs[sj + 1] = prev
              sj = sj - 1
            } else {
              break
            }
          }
          stable_arrs[sj + 1] = cur
          si = si + 1
        }
      }
      let arr_limit = if !loop_no_calls && stable_arrs.length() > 3 {
        3
      } else {
        stable_arrs.length()
      }
      let newly_hoisted : Array[String] = []
      ai = 0
      while ai < arr_limit {
        let aname = stable_arrs[ai]
        match qbe_lookup_local(g, aname) {
          Some(aloc) => {
            let ap = qbe_tmp(g)
            let dp_p = qbe_tmp(g)
            let adp = qbe_tmp(g)
            qbe_emit(g, ap + " =l loadl " + aloc.slot)
            let alen = qbe_array_length_operand(g, aname, ap)
            qbe_emit(g, dp_p + " =l add " + ap + ", 24")
            qbe_emit(g, adp + " =l loadl " + dp_p)
            g.hoisted_arr_len.set(aname, alen)
            g.hoisted_arr_dp.set(aname, adp)
            newly_hoisted.push(aname)
          }
          None => ()
        }
        ai = ai + 1
      }
      // Loop-invariant String / StrView / BytesView (len + data pointer) hoisting
      let mut sti = 0
      while sti < cand_strs.length() {
        let sname = cand_strs[sti]
        match qbe_lookup_local(g, sname) {
          Some(sloc) =>
            if !sloc.is_cell {
            match sloc.ty {
              TString =>
                if !g.hoisted_str_len.contains(sname) &&
                  !qbe_expr_assigns_ident(cond, sname) &&
                  !qbe_stmts_assigns_ident(body, sname) &&
                  !qbe_expr_rebinds_ident(cond, sname) &&
                  !qbe_stmts_rebinds_ident(body, sname) {
                  let sp_reg = qbe_tmp(g)
                  let slen = qbe_tmp(g)
                  let sdp = qbe_tmp(g)
                  qbe_emit(g, sp_reg + " =l loadl " + sloc.slot)
                  qbe_emit(g, slen + " =l loadl " + sp_reg)
                  qbe_emit(g, sdp + " =l add " + sp_reg + ", 8")
                  g.hoisted_str_len.set(sname, slen)
                  g.hoisted_str_dp.set(sname, sdp)
                  newly_hoisted_strs.push(sname)
                }
              TStrView =>
                if !g.hoisted_str_len.contains(sname) &&
                  !qbe_expr_assigns_ident(cond, sname) &&
                  !qbe_stmts_assigns_ident(body, sname) &&
                  !qbe_expr_rebinds_ident(cond, sname) &&
                  !qbe_stmts_rebinds_ident(body, sname) {
                  let vp = qbe_tmp(g)
                  let pp = qbe_tmp(g)
                  let vdp = qbe_tmp(g)
                  let lp = qbe_tmp(g)
                  let vlen = qbe_tmp(g)
                  qbe_emit(g, vp + " =l loadl " + sloc.slot)
                  qbe_emit(g, pp + " =l add " + vp + ", 8")
                  qbe_emit(g, vdp + " =l loadl " + pp)
                  qbe_emit(g, lp + " =l add " + vp + ", 16")
                  qbe_emit(g, vlen + " =l loadl " + lp)
                  g.hoisted_str_len.set(sname, vlen)
                  g.hoisted_str_dp.set(sname, vdp)
                  newly_hoisted_strs.push(sname)
                }
              TBytesView =>
                if !g.hoisted_bytes_len.contains(sname) &&
                  !qbe_expr_assigns_ident(cond, sname) &&
                  !qbe_stmts_assigns_ident(body, sname) &&
                  !qbe_expr_rebinds_ident(cond, sname) &&
                  !qbe_stmts_rebinds_ident(body, sname) {
                  let vp = qbe_tmp(g)
                  let pp = qbe_tmp(g)
                  let vdp = qbe_tmp(g)
                  let lp = qbe_tmp(g)
                  let vlen = qbe_tmp(g)
                  qbe_emit(g, vp + " =l loadl " + sloc.slot)
                  qbe_emit(g, pp + " =l add " + vp + ", 8")
                  qbe_emit(g, vdp + " =l loadl " + pp)
                  qbe_emit(g, lp + " =l add " + vp + ", 16")
                  qbe_emit(g, vlen + " =l loadl " + lp)
                  g.hoisted_bytes_len.set(sname, vlen)
                  g.hoisted_bytes_dp.set(sname, vdp)
                  newly_hoisted_bytes.push(sname)
                }
              _ => ()
            }
            }
          None => ()
        }
        sti = sti + 1
      }
      // Loop-invariant struct field hoisting (runs before BCE so immutable Bytes/FixedArray/String
      // fields are registered in hoisted_*_len/dp and eligible for both direct and versioned BCE):
      // - Immutable struct fields (`!field_muts[fi]`) can ALWAYS be hoisted (including String/Bytes/Array)
      //   as long as the struct local itself is not reassigned or rebound in the loop, even if other
      //   mutable fields of the same struct are mutated or calls occur in the loop.
      // - Mutable primitive fields are hoisted only when the loop has no calls and the field is never written.
      let newly_hoisted_fields : Array[String] = []
      let written_fields : Map[String, Bool] = Map([])
      if loop_no_calls {
        qbe_collect_written_fields_expr(cond, written_fields)
        qbe_collect_written_fields_stmts(body, written_fields)
      }
      let read_vars : Array[String] = []
      let read_fnames : Array[String] = []
      let read_seen : Map[String, Bool] = Map([])
      qbe_collect_read_fields_expr(cond, read_vars, read_fnames, read_seen)
      qbe_collect_read_fields_stmts(body, read_vars, read_fnames, read_seen)
      let loaded_ptrs : Map[String, String] = Map([])
      let mut rfi = 0
      while rfi < read_vars.length() {
        let vname = read_vars[rfi]
        let fname = read_fnames[rfi]
        let fkey = vname + "." + fname
        if !g.hoisted_fields.contains(fkey) {
          match qbe_lookup_local(g, vname) {
            Some(loc) =>
              if !loc.is_cell {
              match loc.ty {
                TStruct(sname, sargs) =>
                  if !qbe_expr_assigns_ident(cond, vname) &&
                    !qbe_stmts_assigns_ident(body, vname) &&
                    !qbe_expr_rebinds_ident(cond, vname) &&
                    !qbe_stmts_rebinds_ident(body, vname) {
                    match qbe_lookup_struct_info(g, sname) {
                      Some(sinfo) => {
                        let subst = make_subst(sinfo.decl.type_params, sargs)
                        let mut fi = 0
                        while fi < sinfo.field_names.length() {
                          if sinfo.field_names[fi] == fname {
                            let fty = subst_ty(sinfo.field_tys[fi], subst)
                            let is_immut = !sinfo.field_muts[fi]
                            let is_prim = match fty {
                              TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar => true
                              _ => false
                            }
                            let is_hoistable_immut = match fty {
                              TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TBool | TByte | TInt8 | TChar | TString | TBytes | TStrView | TBytesView | TArray(_) | TFixedArray(_) | TImmArray(_) =>
                                true
                              _ => false
                            }
                            let can_hoist = if is_immut {
                              is_hoistable_immut
                            } else {
                              loop_no_calls && !written_fields.contains(fname) && is_prim
                            }
                            if can_hoist {
                              let ptr_reg = match loaded_ptrs.get(vname) {
                                Some(pr) => pr
                                None => {
                                  let pr = qbe_tmp(g)
                                  qbe_emit(g, pr + " =l loadl " + loc.slot)
                                  loaded_ptrs.set(vname, pr)
                                  pr
                                }
                              }
                              let fp = qbe_tmp(g)
                              qbe_emit(
                                g,
                                fp + " =l add " + ptr_reg + ", " + (fi * 8).to_string(),
                              )
                              let fv = qbe_load_heap_slot(g, fp, fty)
                              g.hoisted_fields.set(fkey, qval(fv, fty))
                              newly_hoisted_fields.push(fkey)
                              match fty {
                                TString =>
                                  if !g.hoisted_str_len.contains(fkey) {
                                    let slen = qbe_tmp(g)
                                    let sdp = qbe_tmp(g)
                                    qbe_emit(g, slen + " =l loadl " + fv)
                                    qbe_emit(g, sdp + " =l add " + fv + ", 8")
                                    g.hoisted_str_len.set(fkey, slen)
                                    g.hoisted_str_dp.set(fkey, sdp)
                                    newly_hoisted_strs.push(fkey)
                                  }
                                TStrView =>
                                  if !g.hoisted_str_len.contains(fkey) {
                                    let pp = qbe_tmp(g)
                                    let vdp = qbe_tmp(g)
                                    let lp = qbe_tmp(g)
                                    let vlen = qbe_tmp(g)
                                    qbe_emit(g, pp + " =l add " + fv + ", 8")
                                    qbe_emit(g, vdp + " =l loadl " + pp)
                                    qbe_emit(g, lp + " =l add " + fv + ", 16")
                                    qbe_emit(g, vlen + " =l loadl " + lp)
                                    g.hoisted_str_len.set(fkey, vlen)
                                    g.hoisted_str_dp.set(fkey, vdp)
                                    newly_hoisted_strs.push(fkey)
                                  }
                                TBytes =>
                                  if !g.hoisted_bytes_len.contains(fkey) {
                                    let blen = qbe_tmp(g)
                                    let dp_p = qbe_tmp(g)
                                    let bdp = qbe_tmp(g)
                                    qbe_emit(g, blen + " =l loadl " + fv)
                                    qbe_emit(g, dp_p + " =l add " + fv + ", 16")
                                    qbe_emit(g, bdp + " =l loadl " + dp_p)
                                    g.hoisted_bytes_len.set(fkey, blen)
                                    g.hoisted_bytes_dp.set(fkey, bdp)
                                    newly_hoisted_bytes.push(fkey)
                                  }
                                TBytesView =>
                                  if !g.hoisted_bytes_len.contains(fkey) {
                                    let pp = qbe_tmp(g)
                                    let vdp = qbe_tmp(g)
                                    let lp = qbe_tmp(g)
                                    let vlen = qbe_tmp(g)
                                    qbe_emit(g, pp + " =l add " + fv + ", 8")
                                    qbe_emit(g, vdp + " =l loadl " + pp)
                                    qbe_emit(g, lp + " =l add " + fv + ", 16")
                                    qbe_emit(g, vlen + " =l loadl " + lp)
                                    g.hoisted_bytes_len.set(fkey, vlen)
                                    g.hoisted_bytes_dp.set(fkey, vdp)
                                    newly_hoisted_bytes.push(fkey)
                                  }
                                TFixedArray(_) | TImmArray(_) =>
                                  if !g.hoisted_arr_len.contains(fkey) {
                                    let alen = qbe_tmp(g)
                                    let dp_p = qbe_tmp(g)
                                    let adp = qbe_tmp(g)
                                    qbe_emit(g, alen + " =l loadl " + fv)
                                    qbe_emit(g, dp_p + " =l add " + fv + ", 24")
                                    qbe_emit(g, adp + " =l loadl " + dp_p)
                                    g.hoisted_arr_len.set(fkey, alen)
                                    g.hoisted_arr_dp.set(fkey, adp)
                                    newly_hoisted.push(fkey)
                                  }
                                _ => ()
                              }
                            }
                            break
                          }
                          fi = fi + 1
                        }
                      }
                      None => ()
                    }
                  }
                _ => ()
              }
              }
            None => ()
          }
        }
        rfi = rfi + 1
      }
      // Conservative provably-safe Bounds Check Elimination (BCE)
      let mut added_bce_key = ""
      let added_win_bce_keys : Array[String] = []
      let bce_cond_lhs = match cond {
        EBinary("&&", lhs, rhs, _) =>
          match lhs {
            EBinary("<", EIdent(iv0, _), _, _) | EBinary("<=", EIdent(iv0, _), _, _) =>
              if !qbe_expr_assigns_ident(rhs, iv0) { lhs } else { cond }
            _ => cond
          }
        _ => cond
      }
      match bce_cond_lhs {
        EBinary("<", EIdent(iv, _), EBinary("-", len_e, k_e, _), _)
        | EBinary("<=", EIdent(iv, _), EBinary("-", len_e, k_e, _), _) => {
          let is_le = match bce_cond_lhs {
            EBinary("<=", _, _, _) => true
            _ => false
          }
          let mut iv_ok = false
          match qbe_lookup_local(g, iv) {
            Some(iloc) =>
              match iloc.ty {
                TInt =>
                  match g.nonneg_vars.get(iv) {
                    Some(true) => iv_ok = true
                    _ => ()
                  }
                _ => ()
              }
            None => ()
          }
          let k_opt = qbe_eval_const_int_expr(g, k_e)
          let step = if body.length() >= 1 {
            qbe_stmt_const_inc_step(body[body.length() - 1], iv)
          } else {
            0
          }
          match k_opt {
            Some(k) => {
              let max_excl = if is_le { k } else { k + 1 }
              // Overflow-free proof: `i <= len - k` with `step <= k` (or `i < len - k` with `step <= k + 1`)
              // guarantees `i + step <= INT32_MAX`, so `i` stays >= 0 and `i + c < len` for all `0 <= c < max_excl`.
              if iv_ok && max_excl >= 1 && max_excl <= 32 && step >= 1 && step <= max_excl {
                let mut other_write = false
                let mut bi = 0
                while bi < body.length() - 1 {
                  if qbe_stmt_assigns_ident(body[bi], iv) {
                    other_write = true
                    break
                  }
                  bi = bi + 1
                }
                if !other_write {
                  let bound_arr = match len_e {
                    EMethodCall(recv_e, mn, ma, msp) =>
                      if qbe_is_builtin_len_call(g, recv_e, mn, ma, msp) {
                        match recv_e {
                          EIdent(an, _) => an
                          EField(EIdent(vn, _), fnm, _) => vn + "." + fnm
                          _ => ""
                        }
                      } else {
                        ""
                      }
                    EIdent(n_name, _) =>
                      if !qbe_stmts_assigns_ident(body, n_name) {
                        match g.len_aliases.get(n_name) {
                          Some(an) => an
                          None => ""
                        }
                      } else {
                        ""
                      }
                    _ => ""
                  }
                  let bound_stable = if bound_arr == "" {
                    false
                  } else if g.hoisted_arr_len.contains(bound_arr) ||
                    g.hoisted_str_len.contains(bound_arr) ||
                    g.hoisted_bytes_len.contains(bound_arr) {
                    true
                  } else {
                    match qbe_lookup_local(g, bound_arr) {
                      Some(bloc) =>
                        match bloc.ty {
                          TString | TBytes | TStrView | TBytesView =>
                            !qbe_expr_assigns_ident(cond, bound_arr) &&
                            !qbe_stmts_assigns_ident(body, bound_arr) &&
                            !qbe_expr_rebinds_ident(cond, bound_arr) &&
                            !qbe_stmts_rebinds_ident(body, bound_arr)
                          TFixedArray(_) | TImmArray(_) =>
                            qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                            qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                          TArray(_) =>
                            (loop_no_calls ||
                              g.unfrozen_local_arrs.contains(bound_arr) ||
                              (qbe_no_aliasing_calls_expr(g, cond, bound_arr, qbe_hints_new()) &&
                                qbe_no_aliasing_calls_stmts(g, body, bound_arr, qbe_hints_new()))) &&
                            qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                            qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                          _ =>
                            qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                            qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                        }
                      None => false
                    }
                  }
                  if bound_stable {
                    let k0 = bound_arr + ":iv:" + iv
                    if !g.bce_safe_exprs.contains(k0) {
                      g.bce_safe_exprs.set(k0, true)
                      added_win_bce_keys.push(k0)
                    }
                    let mut c = 0
                    while c < max_excl {
                      let kc = bound_arr + ":iv+:" + iv + ":" + c.to_string()
                      if !g.bce_safe_exprs.contains(kc) {
                        g.bce_safe_exprs.set(kc, true)
                        added_win_bce_keys.push(kc)
                      }
                      c = c + 1
                    }
                  }
                }
              }
            }
            None => ()
          }
        }
        EBinary("<", EIdent(iv, _), bound, _) => {
          let mut iv_ok = false
          match qbe_lookup_local(g, iv) {
            Some(iloc) =>
              match iloc.ty {
                TInt =>
                  match g.nonneg_vars.get(iv) {
                    Some(true) => iv_ok = true
                    _ => ()
                  }
                _ => ()
              }
            None => ()
          }
          if iv_ok && body.length() >= 1 && qbe_stmt_is_inc_by_one(body[body.length() - 1], iv) {
            // Ensure `iv` is never assigned anywhere else in `body[0 .. len-2]`
            let mut other_write = false
            let mut bi = 0
            while bi < body.length() - 1 {
              if qbe_stmt_assigns_ident(body[bi], iv) {
                other_write = true
                break
              }
              bi = bi + 1
            }
            if !other_write {
              let bound_arr = match bound {
                EMethodCall(recv_e, mn, ma, msp) =>
                  if qbe_is_builtin_len_call(g, recv_e, mn, ma, msp) {
                    match recv_e {
                      EIdent(an, _) => an
                      EField(EIdent(vn, _), fnm, _) => vn + "." + fnm
                      _ => ""
                    }
                  } else {
                    ""
                  }
                EIdent(n_name, _) =>
                  if !qbe_stmts_assigns_ident(body, n_name) {
                    match g.len_aliases.get(n_name) {
                      Some(an) => an
                      None => ""
                    }
                  } else {
                    ""
                  }
                _ => ""
              }
              let bound_stable = if bound_arr == "" {
                false
              } else if g.hoisted_arr_len.contains(bound_arr) ||
                g.hoisted_str_len.contains(bound_arr) ||
                g.hoisted_bytes_len.contains(bound_arr) {
                true
              } else {
                match qbe_lookup_local(g, bound_arr) {
                  Some(bloc) =>
                    match bloc.ty {
                      TString | TBytes | TStrView | TBytesView =>
                        !qbe_expr_assigns_ident(cond, bound_arr) &&
                        !qbe_stmts_assigns_ident(body, bound_arr) &&
                        !qbe_expr_rebinds_ident(cond, bound_arr) &&
                        !qbe_stmts_rebinds_ident(body, bound_arr)
                      TFixedArray(_) | TImmArray(_) =>
                        qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                        qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                      TArray(_) =>
                        (loop_no_calls ||
                          g.unfrozen_local_arrs.contains(bound_arr) ||
                          (qbe_no_aliasing_calls_expr(g, cond, bound_arr, qbe_hints_new()) &&
                            qbe_no_aliasing_calls_stmts(g, body, bound_arr, qbe_hints_new()))) &&
                        qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                        qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                      _ =>
                        qbe_arr_is_stable_expr(cond, bound_arr, true) &&
                        qbe_arr_is_stable_stmts(body, 0, bound_arr, true)
                    }
                  None => false
                }
              }
              if bound_stable {
                let bkey = iv + ":" + bound_arr
                if !g.bce_safe_indices.contains(bkey) {
                  g.bce_safe_indices.set(bkey, "1")
                  added_bce_key = bkey
                }
              }
            }
          }
        }
        _ => ()
      }
      // Output-array push loop len/cap/dp register promotion (P42-B)
      let newly_prom_push_names : Array[String] = []
      let newly_prom_push_ptrs : Array[String] = []
      let newly_prom_push_lens : Array[String] = []
      if !qbe_stmts_has_nested_loop(body) &&
        !qbe_stmts_has_cf(body, false, false, true) &&
        qbe_push_loop_safe_expr(g, cond, qbe_hints_new()) &&
        qbe_push_loop_safe_stmts(g, body, qbe_hints_new()) {
        let push_cands : Array[String] = []
        let push_seen : Map[String, Bool] = Map([])
        qbe_collect_push_arrs_stmts(body, push_cands, push_seen)
        let mut pci = 0
        while pci < push_cands.length() {
          let aname = push_cands[pci]
          if !g.promoted_push_len.contains(aname) &&
            !g.hoisted_arr_len.contains(aname) &&
            g.unfrozen_local_arrs.contains(aname) &&
            !qbe_expr_mentions_ident(cond, aname) &&
            !qbe_stmts_assigns_ident(body, aname) &&
            !qbe_stmts_rebinds_ident(body, aname) &&
            qbe_ident_only_push_recv_stmts(body, aname) {
            match qbe_lookup_local(g, aname) {
              Some(aloc) =>
                if !aloc.is_cell {
                  match aloc.ty {
                    TArray(raw_elem) => {
                      let elem = subst_ty(raw_elem, g.cur_type_subst)
                      let ok_elem = qbe_is_prim_array_elem(elem) ||
                        (qbe_flat_pod_stride(g, elem) > 0 && qbe_flat_struct_obj_mask(g, elem) == 0)
                      if ok_elem {
                        let arr_p = qbe_tmp(g)
                        let l0 = qbe_tmp(g)
                        let cp = qbe_tmp(g)
                        let c0 = qbe_tmp(g)
                        let dpp = qbe_tmp(g)
                        let d0 = qbe_tmp(g)
                        let len_slot = qbe_alloc_slot(g)
                        let cap_slot = qbe_alloc_slot(g)
                        let dp_slot = qbe_alloc_slot(g)
                        qbe_emit(g, arr_p + " =l loadl " + aloc.slot)
                        qbe_emit(g, l0 + " =l loadl " + arr_p)
                        qbe_emit(g, cp + " =l add " + arr_p + ", 8")
                        qbe_emit(g, c0 + " =l loadl " + cp)
                        qbe_emit(g, dpp + " =l add " + arr_p + ", 24")
                        qbe_emit(g, d0 + " =l loadl " + dpp)
                        qbe_emit(g, "storel " + l0 + ", " + len_slot)
                        qbe_emit(g, "storel " + c0 + ", " + cap_slot)
                        qbe_emit(g, "storel " + d0 + ", " + dp_slot)
                        g.promoted_push_len.set(aname, len_slot)
                        g.promoted_push_cap.set(aname, cap_slot)
                        g.promoted_push_dp.set(aname, dp_slot)
                        newly_prom_push_names.push(aname)
                        newly_prom_push_ptrs.push(arr_p)
                        newly_prom_push_lens.push(len_slot)
                      }
                    }
                    _ => ()
                  }
                }
              None => ()
            }
          }
          pci = pci + 1
        }
      }
      // Keep existing BCE facts active in the scalar fallback.
      let mut emitted_loop = qbe_try_emit_byte_scan(g, cond, body)
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_bce_versioned(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_dec_bce_versioned(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_two_ptr_bce(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_field_promoted(g, cond, body)
      }
      if !emitted_loop {
        emitted_loop = qbe_try_emit_while_sq_reuse(g, cond, body)
      }
      if !emitted_loop {
        if qbe_is_pure_small_cond(cond, 16) {
          let l_body = qbe_lbl(g, "wh_b")
          let l_cond = qbe_lbl(g, "wh_c")
          let l_end = qbe_lbl(g, "wh_e")
          let pair = qbe_read_pair(g, cond, body)
          let entry = match pair { Some(_) => qbe_lbl(g, "pair_setup")
            None => l_body }
          qbe_emit_cond_branch(g, cond, entry, l_end)
          qbe_emit_lbl(g, entry)
          let loop_depth = g.scopes.length()
          g.loop_breaks.push(l_end)
          g.loop_conts.push(l_cond)
          g.loop_depths.push(loop_depth)
          g.hot_loop_depth = g.hot_loop_depth + 1
          qbe_scope_push(g)
          let bv = match pair {
            Some(p) => qbe_pair_body(g, p, body, l_body)
            None => qbe_emit_stmts(g, body, None)
