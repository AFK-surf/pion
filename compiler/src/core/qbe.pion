        } else {
          qbe_emit(g, "call $pion_arr_push(l " + obj_val + ", l " + vl + ")")
        }
        if !va.borrowed && !is_owned_obj {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "pop" {
        let n = qbe_tmp(g)
        qbe_emit(g, n + " =l loadl " + obj_val)
        let res_slot = qbe_alloc_slot(g)
        let l_some = qbe_lbl(g, "pop_some")
        let l_none = qbe_lbl(g, "pop_none")
        let l_end = qbe_lbl(g, "pop_end")
        let n_nz = qbe_tmp(g)
        qbe_emit(g, n_nz + " =w cnel " + n + ", 0")
        qbe_emit_term(g, "jnz " + n_nz + ", " + l_some + ", " + l_none)
        qbe_emit_lbl(g, l_some)
        let n1 = qbe_tmp(g)
        let dp_p = qbe_tmp(g)
        let dp = qbe_tmp(g)
        qbe_emit(g, n1 + " =l sub " + n + ", 1")
        qbe_emit(g, "storel " + n1 + ", " + obj_val)
        qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
        qbe_emit(g, dp + " =l loadl " + dp_p)
        let pv = match qbe_flat_pod_struct_info(g, elem) {
          Some(sinfo) => {
            let flat_stride = sinfo.field_names.length() * 8
            let ep = qbe_emit_arr_elem_addr(g, dp, n1, flat_stride)
            qbe_emit_flat_materialize(g, ep, sinfo, elem, false)
          }
          None => {
            let ep = qbe_emit_arr_ep_ty(g, dp, n1, elem)
            if qbe_is_u8_array_elem(g, elem) {
              qbe_load_arr_1b(g, ep, elem)
            } else if qbe_is_4b_array_elem(g, elem) {
              qbe_load_arr_4b_l(g, ep, elem)
            } else {
