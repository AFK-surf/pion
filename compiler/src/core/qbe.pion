///| Pure Pion ∩ MoonBit QBE IL native backend with Biased RC (Perceus-lite)

///|
pub struct QbeVal {
  reg : String
  ty : Ty
}

///|
pub struct QbeCloRes {
  env : String
  fn_sym : String
  ty : Ty
}

///|
pub struct QbeEmitResult {
  ssa : String
  has_main : Bool
}

///|
pub struct CompileQbeOut {
  sig : String
  ssa : String
  has_main : Bool
}

///|
pub struct QbeLocal {
  mut counted_len : String
  name : String
  slot : String
  ty : Ty
  owned : Bool
  is_cell : Bool
  /// `mut` parameter: the caller's 64-bit in-out slot pointer (`%pN`). The
  /// local is an ordinary owned copy; every scope release writes it back.
  ref_slot : String
}

///|
/// A `mut <place>` argument: written back from `slot` after the call.
pub struct QbeMutWb {
  place : Expr
  slot : String
  ty : Ty
  /// Owned hidden locals the snapshotted `place` refers to.
  holds : Array[QbeLocal]
}

///|
pub struct QbeEnumConst {
  sym : String
  tag : Int
  has_payload : Bool
  payload_val : Int
  omit_tag : Bool
}

///|
pub struct QbeEnumLayout {
  is_unit_only : Bool
  is_niche : Bool
  null_tag : Int
  payload_tag : Int
  payload_offset : Int
  payload_slot_base : Int
  total_size : Int
}

///|
pub struct QbeScope {
  locals : Array[QbeLocal]
}

///|
///|
pub struct QbeArgVal {
  qv : QbeVal
  borrowed : Bool
}

///|
