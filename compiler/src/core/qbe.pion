      if added_bce_key != "" {
        g.bce_safe_indices.remove(added_bce_key)
      }
      let mut wbi = 0
      while wbi < added_win_bce_keys.length() {
        g.bce_safe_exprs.remove(added_win_bce_keys[wbi])
        wbi = wbi + 1
      }
      let mut ppi = 0
      while ppi < newly_prom_push_names.length() {
        let aname = newly_prom_push_names[ppi]
        let arr_p = newly_prom_push_ptrs[ppi]
        let len_slot = newly_prom_push_lens[ppi]
        let flen = qbe_tmp(g)
        qbe_emit(g, flen + " =l loadl " + len_slot)
        qbe_emit(g, "storel " + flen + ", " + arr_p)
        g.promoted_push_len.remove(aname)
        g.promoted_push_cap.remove(aname)
        g.promoted_push_dp.remove(aname)
        ppi = ppi + 1
      }
      let mut hi = 0
      while hi < newly_hoisted.length() {
        let aname = newly_hoisted[hi]
        g.hoisted_arr_len.remove(aname)
        g.hoisted_arr_dp.remove(aname)
        hi = hi + 1
      }
      let mut hsi = 0
      while hsi < newly_hoisted_strs.length() {
        let sname = newly_hoisted_strs[hsi]
        g.hoisted_str_len.remove(sname)
        g.hoisted_str_dp.remove(sname)
        hsi = hsi + 1
      }
      let mut hbi = 0
      while hbi < newly_hoisted_bytes.length() {
        let bname = newly_hoisted_bytes[hbi]
        g.hoisted_bytes_len.remove(bname)
        g.hoisted_bytes_dp.remove(bname)
        hbi = hbi + 1
      }
      let mut hfi = 0
      while hfi < newly_hoisted_fields.length() {
        g.hoisted_fields.remove(newly_hoisted_fields[hfi])
        hfi = hfi + 1
      }
      qval("0", TUnit)
    }
    SFor(init_s, cond, step_s, body, _) => {
      qbe_scope_push(g)
      let _ = qbe_emit_stmt(g, init_s, None, false)
      let for_dp_pinned : Array[String] = []
      if qbe_expr_has_any_data_ptr(cond) ||
        qbe_stmt_has_any_data_ptr(step_s) ||
        qbe_stmts_has_any_data_ptr(body) {
        let for_sc = g.scopes[g.scopes.length() - 1]
        let mut fli = 0
        while fli < for_sc.locals.length() {
          let floc = for_sc.locals[fli]
          if floc.owned &&
            (qbe_expr_takes_data_ptr(cond, floc.name) ||
              qbe_stmt_takes_data_ptr(step_s, floc.name) ||
              qbe_stmts_tail_takes_data_ptr(body, 0, floc.name)) {
            qbe_pin_slot(g, floc.slot, for_dp_pinned)
          }
          fli = fli + 1
        }
      }
      qbe_invalidate_escaping_unfrozen_arrs(g, Some(cond), Some(step_s), body)
      let l_cond = qbe_lbl(g, "for_c")
      let l_body = qbe_lbl(g, "for_b")
      let l_step = qbe_lbl(g, "for_s")
      let l_end = qbe_lbl(g, "for_e")
      qbe_emit_term(g, "jmp " + l_cond)
      qbe_emit_lbl(g, l_cond)
      g.hot_loop_depth = g.hot_loop_depth + 1
      qbe_emit_cond_branch(g, cond, l_body, l_end)
      qbe_emit_lbl(g, l_body)
      let loop_depth = g.scopes.length()
      g.loop_breaks.push(l_end)
      g.loop_conts.push(l_step)
      g.loop_depths.push(loop_depth)
      qbe_scope_push(g)
      let bv = qbe_emit_stmts(g, body, None)
      if !g.block_term {
        qbe_rc_dec(g, bv.reg, bv.ty)
      }
      qbe_scope_pop(g)
      let _ = g.loop_breaks.pop()
      let _ = g.loop_conts.pop()
      let _ = g.loop_depths.pop()
      qbe_emit_term(g, "jmp " + l_step)
      qbe_emit_lbl(g, l_step)
      let _ = qbe_emit_stmt(g, step_s, None, false)
      g.hot_loop_depth = g.hot_loop_depth - 1
      qbe_emit_term(g, "jmp " + l_cond)
      qbe_emit_lbl(g, l_end)
      qbe_unpin_slot_list(g, for_dp_pinned)
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SForRange(var_name, start_e, end_e, inclusive, body, sp) => {
      qbe_scope_push(g)
      let sv = qbe_emit_expr(g, start_e, Some(TInt))
      let ev = qbe_emit_expr(g, end_e, Some(sv.ty))
      let idx_ty = sv.ty
      let end_name = "@pion_fe_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let end_loc = qbe_define_local(g, end_name, idx_ty, false)
      qbe_store_local_slot(g, ev.reg, end_loc.slot, idx_ty)
      let idx_name = if var_name == "_" {
        let nm = "@pion_fi_" + g.next_tmp.to_string()
        g.next_tmp = g.next_tmp + 1
        nm
      } else {
        var_name
      }
      let idx_loc = qbe_define_local(g, idx_name, idx_ty, false)
      qbe_store_local_slot(g, sv.reg, idx_loc.slot, idx_ty)
      match start_e {
        EInt(raw, _) =>
          if qbe_parse_int64_lit(raw) >= 0L {
            g.nonneg_vars.set(idx_name, true)
          }
        _ => ()
      }
      let one_expr = match idx_ty {
        TInt64 => EInt64("1L", sp)
        _ => EInt("1", sp)
      }
      let step_s = SAssign(
        EIdent(idx_name, sp),
        EBinary("+", EIdent(idx_name, sp), one_expr, sp),
        sp,
      )
      qbe_invalidate_escaping_unfrozen_arrs(g, None, None, body)
      if inclusive {
        let l_body = qbe_lbl(g, "fori_b")
        let l_step = qbe_lbl(g, "fori_s")
        let l_inc = qbe_lbl(g, "fori_i")
        let l_end = qbe_lbl(g, "fori_e")
        let init_cond = EBinary("<=", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        qbe_emit_cond_branch(g, init_cond, l_body, l_end)
        qbe_emit_lbl(g, l_body)
        let loop_depth = g.scopes.length()
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_step)
        g.loop_depths.push(loop_depth)
        g.hot_loop_depth = g.hot_loop_depth + 1
        qbe_scope_push(g)
        let bv = qbe_emit_stmts(g, body, None)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        qbe_emit_term(g, "jmp " + l_step)
        qbe_emit_lbl(g, l_step)
        let done_cond = EBinary("==", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        qbe_emit_cond_branch(g, done_cond, l_end, l_inc)
        qbe_emit_lbl(g, l_inc)
        let _ = qbe_emit_stmt(g, step_s, None, false)
        g.hot_loop_depth = g.hot_loop_depth - 1
        qbe_emit_term(g, "jmp " + l_body)
        qbe_emit_lbl(g, l_end)
      } else {
        let cond_e = EBinary("<", EIdent(idx_name, sp), EIdent(end_name, sp), sp)
        if qbe_stmts_has_cf(body, false, true, false) || qbe_stmts_rebind_name(body, idx_name) {
          let l_cond = qbe_lbl(g, "forr_c")
          let l_body = qbe_lbl(g, "forr_b")
          let l_step = qbe_lbl(g, "forr_s")
          let l_end = qbe_lbl(g, "forr_e")
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_cond)
          g.hot_loop_depth = g.hot_loop_depth + 1
          qbe_emit_cond_branch(g, cond_e, l_body, l_end)
          qbe_emit_lbl(g, l_body)
          let loop_depth = g.scopes.length()
          g.loop_breaks.push(l_end)
          g.loop_conts.push(l_step)
          g.loop_depths.push(loop_depth)
          qbe_scope_push(g)
          let bv = qbe_emit_stmts(g, body, None)
          if !g.block_term {
            qbe_rc_dec(g, bv.reg, bv.ty)
          }
          qbe_scope_pop(g)
          let _ = g.loop_breaks.pop()
          let _ = g.loop_conts.pop()
          let _ = g.loop_depths.pop()
          qbe_emit_term(g, "jmp " + l_step)
          qbe_emit_lbl(g, l_step)
          let _ = qbe_emit_stmt(g, step_s, None, false)
          g.hot_loop_depth = g.hot_loop_depth - 1
          qbe_emit_term(g, "jmp " + l_cond)
          qbe_emit_lbl(g, l_end)
        } else {
          let wbody : Array[Stmt] = []
          let mut bi = 0
          while bi < body.length() {
            wbody.push(body[bi])
            bi = bi + 1
          }
          wbody.push(step_s)
          let _ = qbe_emit_stmt(g, SWhile(cond_e, wbody, sp), None, false)
        }
      }
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SForIn(user_idx_name, var_name, iter_e, body, sp) => {
      qbe_scope_push(g)
      let av = qbe_emit_expr(g, iter_e, None)
      qbe_invalidate_escaping_unfrozen_arrs(g, None, None, body)
      let arr_name = "@pion_fa_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let arr_loc = qbe_define_local(g, arr_name, av.ty, qbe_is_obj_ty(g, av.ty))
      qbe_store_local_slot(g, av.reg, arr_loc.slot, av.ty)
      let len_name = "@pion_fl_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let len_r64 = qbe_tmp(g)
      let len_rw = qbe_tmp(g)
      qbe_emit(g, len_r64 + " =l loadl " + av.reg)
      qbe_emit(g, len_rw + " =w copy " + len_r64)
      let len_loc = qbe_define_local(g, len_name, TInt, false)
      qbe_store_local_slot(g, len_rw, len_loc.slot, TInt)
      let idx_name = "@pion_fi_" + g.next_tmp.to_string()
      g.next_tmp = g.next_tmp + 1
      let idx_loc = qbe_define_local(g, idx_name, TInt, false)
      qbe_store_local_slot(g, "0", idx_loc.slot, TInt)
      g.nonneg_vars.set(idx_name, true)
      g.len_aliases.set(len_name, arr_name)
      g.len_alias_keys.push(len_name)
      let cond_e = EBinary("<", EIdent(idx_name, sp), EIdent(len_name, sp), sp)
      let step_s = SAssign(
        EIdent(idx_name, sp),
        EBinary("+", EIdent(idx_name, sp), EInt("1", sp), sp),
        sp,
      )
      let elem_bind = SLet(
        var_name,
        false,
        TyMissing(sp),
        EIndex(EIdent(arr_name, sp), EIdent(idx_name, sp), sp),
        sp,
      )
      let has_user_idx = user_idx_name != "" && user_idx_name != "_"
      let idx_bind = SLet(
        user_idx_name,
        false,
        TyMissing(sp),
        EIdent(idx_name, sp),
        sp,
      )
      if qbe_stmts_has_cf(body, false, true, false) || var_name == "_" {
        let l_cond = qbe_lbl(g, "fori_c")
        let l_body = qbe_lbl(g, "fori_b")
        let l_step = qbe_lbl(g, "fori_s")
        let l_end = qbe_lbl(g, "fori_e")
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_cond)
        g.hot_loop_depth = g.hot_loop_depth + 1
        qbe_emit_cond_branch(g, cond_e, l_body, l_end)
        qbe_emit_lbl(g, l_body)
        let loop_depth = g.scopes.length()
        g.loop_breaks.push(l_end)
        g.loop_conts.push(l_step)
        g.loop_depths.push(loop_depth)
        qbe_scope_push(g)
        let fbody : Array[Stmt] = []
        if has_user_idx {
          fbody.push(idx_bind)
        }
        if var_name == "_" {
          let ev = qbe_emit_expr(
            g,
            EIndex(EIdent(arr_name, sp), EIdent(idx_name, sp), sp),
            None,
          )
          let eloc = qbe_define_local(g, "_", ev.ty, true)
          qbe_store_local_slot(g, ev.reg, eloc.slot, ev.ty)
        } else {
          fbody.push(elem_bind)
        }
        let mut bi = 0
        while bi < body.length() {
          fbody.push(body[bi])
          bi = bi + 1
        }
        let bv = qbe_emit_stmts(g, fbody, None)
        if !g.block_term {
          qbe_rc_dec(g, bv.reg, bv.ty)
        }
        qbe_scope_pop(g)
        let _ = g.loop_breaks.pop()
        let _ = g.loop_conts.pop()
        let _ = g.loop_depths.pop()
        qbe_emit_term(g, "jmp " + l_step)
        qbe_emit_lbl(g, l_step)
        let _ = qbe_emit_stmt(g, step_s, None, false)
        g.hot_loop_depth = g.hot_loop_depth - 1
        qbe_emit_term(g, "jmp " + l_cond)
        qbe_emit_lbl(g, l_end)
      } else {
        let wbody : Array[Stmt] = []
        if has_user_idx {
          wbody.push(idx_bind)
        }
        wbody.push(elem_bind)
        let mut bi = 0
        while bi < body.length() {
          wbody.push(body[bi])
          bi = bi + 1
        }
        wbody.push(step_s)
        let _ = qbe_emit_stmt(g, SWhile(cond_e, wbody, sp), None, false)
      }
      g.len_aliases.remove(len_name)
      qbe_scope_pop(g)
      qval("0", TUnit)
    }
    SReturn(opt, _) => {
      if g.inline_ret_lbl != "" {
        if g.inline_ret_tag_slot != "" {
          match opt {
            Some(e) =>
              qbe_emit_tail_opt_res_expr_into_slots(
                g,
                e,
                g.inline_ret_ty,
                g.inline_ret_tag_slot,
                g.inline_ret_slot,
                g.inline_ret_err_slot,
                g.inline_ret_pod_buf,
              )
            None => ()
          }
          if !g.block_term {
            qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
            qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
          }
          return qval("0", TNever)
        }
        if g.inline_ret_pod_buf {
          match opt {
            Some(e) =>
              match qbe_pure_scalar_pod_struct_info(g, g.inline_ret_ty) {
                Some(sinfo) =>
                  qbe_emit_tail_pod_struct_into_buf(
                    g,
                    e,
                    sinfo,
                    subst_ty(g.inline_ret_ty, g.cur_type_subst),
                    g.inline_ret_slot,
                  )
                None => ()
              }
            None => ()
          }
          if !g.block_term {
            qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
            qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
          }
          return qval("0", TNever)
        }
        let old_mov = g.movable_locals
        let old_moved = g.moved_slots
        let mut did_ret_mov = false
        let rv = match opt {
          Some(e) => {
            if qbe_expr_is_straight_line_movable(e) {
              let mov_map : Map[String, String] = Map([])
              let seen_n : Map[String, Bool] = Map([])
              let mut si = g.scopes.length() - 1
              while si >= g.inline_ret_scope_depth {
                let sc = g.scopes[si]
                let mut li = sc.locals.length() - 1
                while li >= 0 {
                  let loc = sc.locals[li]
                  if !seen_n.contains(loc.name) {
                    seen_n.set(loc.name, true)
                    if loc.owned &&
                      !loc.is_cell &&
                      loc.ref_slot == "" &&
                      qbe_is_early_drop_ty(g, loc.ty) &&
                      !g.zeroed_slots.contains(loc.slot) &&
                      !g.pinned_slots.contains(loc.slot) &&
                      qbe_expr_count_mentions(e, loc.name) == 1 {
                      mov_map.set(loc.name, loc.slot)
                    }
                  }
                  li = li - 1
                }
                si = si - 1
              }
              if mov_map.length() > 0 {
                g.movable_locals = mov_map
                g.moved_slots = Map([])
                did_ret_mov = true
              }
            }
            let ev = qbe_emit_expr(g, e, Some(g.inline_ret_ty))
            if g.block_term {
              if did_ret_mov {
                g.movable_locals = old_mov
                g.moved_slots = old_moved
              }
              return qval("0", TNever)
            }
            qbe_coerce_val(g, ev, g.inline_ret_ty)
          }
          None => qbe_zero_reg(g.inline_ret_ty)
        }
        if g.inline_ret_slot != "" {
          qbe_store_local_slot(g, rv, g.inline_ret_slot, g.inline_ret_ty)
        }
        qbe_release_scopes_down_to(g, g.inline_ret_scope_depth)
        if did_ret_mov {
          g.movable_locals = old_mov
          g.moved_slots = old_moved
        }
        qbe_emit_term(g, "jmp " + g.inline_ret_lbl)
        return qval("0", TNever)
      }
      if g.tco_mode > 0 {
        match opt {
          Some(re) => {
            qbe_emit_tco_return(g, re, Some(g.cur_ret_ty))
            return qval("0", TNever)
          }
          None => ()
        }
      }
      let target_abi_ty = g.cur_ret_abi_ty
      let old_mov = g.movable_locals
      let old_moved = g.moved_slots
      let mut did_ret_mov = false
      let rv = match opt {
        Some(e) => {
          if qbe_expr_is_straight_line_movable(e) {
            let mov_map : Map[String, String] = Map([])
            let seen_n : Map[String, Bool] = Map([])
            let mut si = g.scopes.length() - 1
            while si >= 0 {
              let sc = g.scopes[si]
              let mut li = sc.locals.length() - 1
              while li >= 0 {
                let loc = sc.locals[li]
                if !seen_n.contains(loc.name) {
                  seen_n.set(loc.name, true)
                  if loc.owned &&
                    !loc.is_cell &&
                    loc.ref_slot == "" &&
                    qbe_is_early_drop_ty(g, loc.ty) &&
                    !g.zeroed_slots.contains(loc.slot) &&
                    !g.pinned_slots.contains(loc.slot) &&
                    qbe_expr_count_mentions(e, loc.name) == 1 {
                    mov_map.set(loc.name, loc.slot)
                  }
                }
                li = li - 1
              }
              si = si - 1
            }
            if mov_map.length() > 0 {
              g.movable_locals = mov_map
              g.moved_slots = Map([])
              did_ret_mov = true
            }
          }
          let ev = qbe_emit_expr(g, e, Some(g.cur_ret_ty))
          let norm = qbe_coerce_val(g, ev, g.cur_ret_ty)
          if qbe_abi_ty(target_abi_ty) == qbe_abi_ty(g.cur_ret_ty) {
            norm
          } else if qbe_abi_ty(target_abi_ty) == "l" {
            qbe_as_l(g, qval(norm, g.cur_ret_ty))
          } else {
            qbe_coerce_val(g, qval(norm, g.cur_ret_ty), target_abi_ty)
          }
        }
        None => qbe_zero_reg(target_abi_ty)
      }
      if qbe_try_emit_shared_cleanup_exit(g, rv) {
        if did_ret_mov {
          g.movable_locals = old_mov
          g.moved_slots = old_moved
        }
      } else {
        qbe_release_scopes_down_to(g, 0)
        if did_ret_mov {
          g.movable_locals = old_mov
          g.moved_slots = old_moved
        }
        if g.cur_fn_void {
          qbe_emit_term(g, "ret")
        } else {
          qbe_emit_term(g, "ret " + rv)
        }
      }
      qval("0", TNever)
    }
    SBreak(_) => {
      if g.loop_breaks.length() > 0 {
        let lbl = g.loop_breaks[g.loop_breaks.length() - 1]
        let depth = g.loop_depths[g.loop_depths.length() - 1]
        qbe_release_scopes_down_to(g, depth)
        qbe_emit_term(g, "jmp " + lbl)
      }
      qval("0", TNever)
    }
    SContinue(_) => {
      if g.loop_conts.length() > 0 {
        let lbl = g.loop_conts[g.loop_conts.length() - 1]
        let depth = g.loop_depths[g.loop_depths.length() - 1]
        qbe_release_scopes_down_to(g, depth)
        qbe_emit_term(g, "jmp " + lbl)
      }
      qval("0", TNever)
    }
    SDebugAssert(cond, msg, sp) => {
      if !g.release {
        let cv = qbe_emit_expr(g, cond, Some(TBool))
        let mv = qbe_emit_expr(g, msg, Some(TString))
        let cw = qbe_tmp(g)
        qbe_emit(g, cw + " =w copy " + cv.reg)
        let file_id = qbe_intern_source_path(g, sp.file)
        qbe_emit(
          g,
          "call $pion_debug_assert(w " +
          cw +
          ", l " +
          mv.reg +
          ", l $pion_cstr_" +
          file_id.to_string() +
          ", w " +
          sp.line.to_string() +
          ")",
        )
        qbe_rc_dec(g, mv.reg, mv.ty)
      }
      qval("0", TUnit)
    }
    SExpr(e, _) => {
      match e {
        EIf(cond, then_stmts, None, _) =>
          if qbe_try_emit_branchless_inc_if(g, cond, then_stmts) {
            return qval("0", TUnit)
          }
        _ => ()
      }
      if !is_tail {
        match e {
          EIf(cond, then_stmts, else_opt, sp) =>
            match qbe_try_collect_if_switch(g, cond, then_stmts, else_opt) {
              Some(plan) =>
                match qbe_lookup_local(g, plan.vname) {
                  Some(vloc) => {
                    let vreg = qbe_load_local_slot(g, vloc.slot, TInt)
                    return qbe_emit_int_dispatch(
                      g,
                      vreg,
                      plan.arms,
                      plan.default_opt,
                      "",
                      false,
                      sp,
                      None,
                      true,
                    )
                  }
                  None => ()
                }
              None => ()
            }
          _ => ()
        }
      }
      let v = qbe_emit_expr(g, e, if is_tail { expected } else { None })
      if !is_tail {
        qbe_rc_dec(g, v.reg, v.ty)
        qval("0", TUnit)
      } else {
        v
      }
    }
  }
}

///|
// Keep symbols, escapes, delimiters and non-ASCII bytes in numeric form.
// This alphabet is literal in QBE, both direct object writers and Wasm.
fn qbe_plain_data_byte(c : Int) -> Bool {
  c == 32 || c == 43 || (c >= 45 && c <= 57) || c == 61 ||
  (c >= 65 && c <= 90) || c == 95 || (c >= 97 && c <= 122)
}

///|
fn qbe_emit_bytes_data(sb : StringBuilder, bytes : Array[Int]) -> Unit {
  let mut i = 0
  while i < bytes.length() {
    sb.write_string("b ")
    let c = bytes[i]
    if qbe_plain_data_byte(c) && i + 1 < bytes.length() && qbe_plain_data_byte(bytes[i + 1]) {
      sb.write_char('"')
      sb.write_char(c.unsafe_to_char())
      i = i + 1
      while i < bytes.length() && qbe_plain_data_byte(bytes[i]) {
        sb.write_char(bytes[i].unsafe_to_char())
        i = i + 1
      }
      sb.write_char('"')
    } else {
      sb.write_string(c.to_string())
      i = i + 1
    }
    sb.write_string(", ")
  }
  sb.write_string("b 0")
}

///|
fn qbe_reset_tco(g : QbeGen) -> Unit {
  g.tco_fn_name = ""
  g.tco_mode = 0
  g.tco_loop_lbl = ""
  g.tco_acc_slot = ""
  g.tco_param_slots = []
  g.tco_param_tys = []
  g.tco_base_scope_depth = 0
  g.tco_borrowed_roots = []
}

///|
fn qbe_tco_clear_caches(g : QbeGen) -> Unit {
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
}

///|
fn qbe_tco_clone_roots(roots : Array[String]) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < roots.length() {
    out.push(roots[i])
    i = i + 1
  }
  out
}

///|
fn qbe_tco_remove_root(roots : Array[String], name : String) -> Array[String] {
  let out : Array[String] = []
  let mut i = 0
  while i < roots.length() {
    if roots[i] != name {
      out.push(roots[i])
    }
    i = i + 1
  }
  out
}

///|
fn qbe_tco_collect_pat_names(pat : Pattern, out : Array[String]) -> Unit {
  match pat {
    PIdent(name, _) =>
      if name != "_" && !str_arr_contains(out, name) {
        out.push(name)
      }
    PTuple(subs, _) | PVariant(_, _, subs, _, _) => {
      let mut i = 0
      while i < subs.length() {
        qbe_tco_collect_pat_names(subs[i], out)
        i = i + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_tco_is_int_trma_ty(t : Ty) -> Bool {
  match t {
    TInt | TInt64 | TUInt | TUInt64 | TByte | TInt8 => true
    _ => false
  }
}

///|
fn qbe_tco_add_int(g : QbeGen, ty : Ty, a : String, b : String) -> String {
  let abi = qbe_abi_ty(ty)
  let sum = qbe_tmp(g)
  qbe_emit(g, sum + " =" + abi + " add " + a + ", " + b)
  match ty {
    TByte => {
      let masked = qbe_tmp(g)
      qbe_emit(g, masked + " =l and " + sum + ", 255")
      masked
    }
    TInt8 => qbe_extsb_l(g, sum)
    _ => sum
  }
}

///|
fn qbe_ty_has_no_mut_fields(
  g : QbeGen,
  ty : Ty,
  visited : Map[String, Bool],
) -> Bool {
  match ty {
    TInt
    | TInt64
    | TUInt
    | TUInt64
    | TDouble
    | TFloat
    | TBool
    | TByte
    | TInt8
    | TChar
    | TUnit
    | TPtr
    | TNever
    | TError
    | TString => true
    TOption(inner) => qbe_ty_has_no_mut_fields(g, inner, visited)
    TResult(ok, err) =>
      qbe_ty_has_no_mut_fields(g, ok, visited) &&
      qbe_ty_has_no_mut_fields(g, err, visited)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if !qbe_ty_has_no_mut_fields(g, elems[i], visited) {
          return false
        }
        i = i + 1
      }
      true
    }
    TStruct(sname, sargs) => {
      let key = "S:" + sname
      if visited.contains(key) {
        return true
      }
      match qbe_lookup_struct_info(g, sname) {
        None => false
        Some(sinfo) => {
          visited.set(key, true)
          let subst = make_subst(sinfo.decl.type_params, sargs)
          let mut fi = 0
          while fi < sinfo.field_muts.length() {
            if sinfo.field_muts[fi] {
              return false
            }
            if !qbe_ty_has_no_mut_fields(
              g,
              subst_ty(sinfo.field_tys[fi], subst),
              visited,
            ) {
              return false
            }
            fi = fi + 1
          }
          true
        }
      }
    }
    TEnum(ename, eargs) => {
      let key = "E:" + ename
      if visited.contains(key) {
        return true
      }
      match qbe_lookup_enum_info(g, ename) {
        None => false
        Some(einfo) => {
          visited.set(key, true)
          let subst = make_subst(einfo.decl.type_params, eargs)
          let mut vi = 0
          while vi < einfo.variants.length() {
            let v = einfo.variants[vi]
            let mut fi = 0
            while fi < v.field_tys.length() {
              if !qbe_ty_has_no_mut_fields(
                g,
                subst_ty(v.field_tys[fi], subst),
                visited,
              ) {
                return false
              }
              fi = fi + 1
            }
            vi = vi + 1
          }
          true
        }
      }
    }
    _ => false
  }
}

///|
fn qbe_expr_has_heap_write(e : Expr) -> Bool {
  match e {
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | ETry(inner, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _) => qbe_expr_has_heap_write(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_heap_write(l) || qbe_expr_has_heap_write(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_heap_write(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_heap_write(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(recv, _, args, _) => {
      if qbe_expr_has_heap_write(recv) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_heap_write(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_heap_write(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, base_opt, fields, _) => {
      match base_opt {
        Some(be) =>
          if qbe_expr_has_heap_write(be) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_heap_write(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_heap_write(stmts)
    EIf(cond, then_s, else_opt, _) =>
      qbe_expr_has_heap_write(cond) ||
      qbe_stmts_has_heap_write(then_s) ||
      match else_opt {
        Some(el) => qbe_expr_has_heap_write(el)
        None => false
      }
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_heap_write(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_heap_write(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_heap_write(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    EIs(inner, _, _) => qbe_expr_has_heap_write(inner)
    EClosure(_, _, body, _) => qbe_stmts_has_heap_write(body)
    EScope(w, f, _) => qbe_expr_has_heap_write(w) || qbe_expr_has_heap_write(f)
    ESpawn(w, f, _) => qbe_expr_has_heap_write(w) || qbe_expr_has_heap_write(f)
    _ => false
  }
}

///|
fn qbe_stmts_has_heap_write(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        if qbe_expr_has_heap_write(init) {
          return true
        }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        match lhs {
          EField(_, _, _) | EIndex(_, _, _) => return true
          _ => ()
        }
        if qbe_expr_has_heap_write(lhs) || qbe_expr_has_heap_write(rhs) {
          return true
        }
      }
      SExpr(e, _) =>
        if qbe_expr_has_heap_write(e) {
          return true
        }
      SReturn(Some(e), _) =>
        if qbe_expr_has_heap_write(e) {
          return true
        }
      SWhile(cond, body, _) | SGuard(cond, body, _) =>
        if qbe_expr_has_heap_write(cond) || qbe_stmts_has_heap_write(body) {
          return true
        }
      SFor(init_s, cond, step_s, body, _) => {
        if qbe_stmts_has_heap_write([init_s]) ||
          qbe_expr_has_heap_write(cond) ||
          qbe_stmts_has_heap_write([step_s]) ||
          qbe_stmts_has_heap_write(body) {
          return true
        }
      }
      SForRange(_, start_e, end_e, _, body, _) =>
        if qbe_expr_has_heap_write(start_e) ||
          qbe_expr_has_heap_write(end_e) ||
          qbe_stmts_has_heap_write(body) {
          return true
        }
      SForIn(_, _, it, body, _) =>
        if qbe_expr_has_heap_write(it) || qbe_stmts_has_heap_write(body) {
          return true
        }
      SDebugAssert(cond, msg, _) =>
        if qbe_expr_has_heap_write(cond) || qbe_expr_has_heap_write(msg) {
          return true
        }
      SReturn(None, _) | SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_has_trma_forbidden(e : Expr) -> Bool {
  match e {
    ETry(_, _) => true
    EUnary(_, inner, _)
    | EMove(inner, _)
    | EAs(inner, _, _)
    | EField(inner, _, _)
    | ENamedArg(_, _, inner, _)
    | EMutArg(inner, _)
    | EIs(inner, _, _) => qbe_expr_has_trma_forbidden(inner)
    EBinary(_, l, r, _) | EIndex(l, r, _) =>
      qbe_expr_has_trma_forbidden(l) || qbe_expr_has_trma_forbidden(r)
    ECall(callee, args, _) => {
      if qbe_expr_has_trma_forbidden(callee) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_trma_forbidden(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EMethodCall(recv, _, args, _) => {
      if qbe_expr_has_trma_forbidden(recv) {
        return true
      }
      let mut i = 0
      while i < args.length() {
        if qbe_expr_has_trma_forbidden(args[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        if qbe_expr_has_trma_forbidden(elems[i]) {
          return true
        }
        i = i + 1
      }
      false
    }
    EStructLit(_, base_opt, fields, _) => {
      match base_opt {
        Some(be) =>
          if qbe_expr_has_trma_forbidden(be) {
            return true
          }
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        if qbe_expr_has_trma_forbidden(fields[i].value) {
          return true
        }
        i = i + 1
      }
      false
    }
    EBlock(stmts, _) => qbe_stmts_has_trma_forbidden(stmts)
    EIf(cond, then_s, else_opt, _) =>
      qbe_expr_has_trma_forbidden(cond) ||
      qbe_stmts_has_trma_forbidden(then_s) ||
      match else_opt {
        Some(el) => qbe_expr_has_trma_forbidden(el)
        None => false
      }
    EMatch(scrut, arms, _) => {
      if qbe_expr_has_trma_forbidden(scrut) {
        return true
      }
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) =>
            if qbe_expr_has_trma_forbidden(ge) {
              return true
            }
          None => ()
        }
        if qbe_expr_has_trma_forbidden(arms[i].body) {
          return true
        }
        i = i + 1
      }
      false
    }
    _ => false
  }
}

///|
fn qbe_stmts_has_trma_forbidden(stmts : Array[Stmt]) -> Bool {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SGuard(_, _, _) | SReturn(None, _) => return true
      SLet(_, _, _, init, _) | SLetTuple(_, _, init, _) =>
        if qbe_expr_has_trma_forbidden(init) {
          return true
        }
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) =>
        if qbe_expr_has_trma_forbidden(lhs) || qbe_expr_has_trma_forbidden(rhs) {
          return true
        }
      SExpr(e, _) | SReturn(Some(e), _) =>
        if qbe_expr_has_trma_forbidden(e) {
          return true
        }
      SWhile(cond, body, _) =>
        if qbe_expr_has_trma_forbidden(cond) || qbe_stmts_has_trma_forbidden(body) {
          return true
        }
      SFor(init_s, cond, step_s, body, _) =>
        if qbe_stmts_has_trma_forbidden([init_s]) ||
          qbe_expr_has_trma_forbidden(cond) ||
          qbe_stmts_has_trma_forbidden([step_s]) ||
          qbe_stmts_has_trma_forbidden(body) {
          return true
        }
      SForRange(_, start_e, end_e, _, body, _) =>
        if qbe_expr_has_trma_forbidden(start_e) ||
          qbe_expr_has_trma_forbidden(end_e) ||
          qbe_stmts_has_trma_forbidden(body) {
          return true
        }
      SForIn(_, _, it, body, _) =>
        if qbe_expr_has_trma_forbidden(it) || qbe_stmts_has_trma_forbidden(body) {
          return true
        }
      SDebugAssert(cond, msg, _) =>
        if qbe_expr_has_trma_forbidden(cond) || qbe_expr_has_trma_forbidden(msg) {
          return true
        }
      SBreak(_) | SContinue(_) => ()
    }
    i = i + 1
  }
  false
}

///|
fn qbe_expr_is_pure_no_trap(
  g : QbeGen,
  e : Expr,
  check_scopes : Bool,
) -> Bool {
  match e {
    EInt(_, _)
    | EInt64(_, _)
    | EUInt(_, _)
    | EUInt64(_, _)
    | EByte(_, _)
    | EBool(_, _)
    | EChar(_, _) => true
    EIdent(name, _) =>
      if check_scopes {
        match qbe_lookup_local(g, name) {
          Some(_) => true
          None => false
        }
      } else {
        !g.tc.consts.contains(name)
      }
    EUnary(op, inner, _) =>
      (op == "-" || op == "~" || op == "!") &&
      qbe_expr_is_pure_no_trap(g, inner, check_scopes)
    EBinary(op, l, r, _) =>
      if (op == "==" || op == "!=") && qbe_eq_op_may_call_custom(g, l, r, qbe_hints_new()) {
        false
      } else {
        (op == "+" ||
        op == "-" ||
        op == "*" ||
        op == "&" ||
        op == "|" ||
        op == "^" ||
        op == "==" ||
        op == "!=" ||
        op == "<" ||
        op == "<=" ||
        op == ">" ||
        op == ">=") &&
        qbe_expr_is_pure_no_trap(g, l, check_scopes) &&
        qbe_expr_is_pure_no_trap(g, r, check_scopes)
      }
    EField(obj, _, _) | EAs(obj, _, _) =>
      qbe_expr_is_pure_no_trap(g, obj, check_scopes)
    EMethodCall(recv, mname, args, _) => {
      let is_conv = args.length() == 0 &&
        (mname == "to_int64" ||
        mname == "to_int" ||
        mname == "to_uint" ||
        mname == "to_uint64" ||
        mname == "to_byte")
      let is_bitop = (args.length() == 0 &&
        (mname == "leading_zeros" ||
        mname == "trailing_zeros" ||
        mname == "count_ones" ||
        mname == "lnot")) ||
        (args.length() == 1 &&
        (mname == "rotate_left" || mname == "rotate_right") &&
        qbe_expr_is_pure_no_trap(g, args[0], check_scopes))
      if is_conv {
        let is_prim_conv_recv = match qbe_probe_expr_ty(g, recv) {
          Some(rty) =>
            if mname == "to_int" {
              match rty {
                TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TChar | TByte | TInt8 => true
                _ => false
              }
            } else if mname == "to_int64" {
              match rty {
                TInt | TInt64 | TUInt | TUInt64 | TDouble | TFloat | TInt8 => true
                _ => false
              }
            } else if mname == "to_uint" {
              match rty {
                TInt | TUInt | TUInt64 | TInt8 => true
                _ => false
              }
            } else if mname == "to_uint64" {
              match rty {
                TInt64 | TUInt | TUInt64 | TInt8 => true
                _ => false
              }
            } else if mname == "to_byte" {
              match rty {
                TInt | TInt8 => true
                _ => false
              }
            } else {
              false
            }
          None => false
        }
        is_prim_conv_recv && qbe_expr_is_pure_no_trap(g, recv, check_scopes)
      } else if is_bitop {
        let is_int_recv = match qbe_probe_expr_ty(g, recv) {
          Some(TInt) | Some(TUInt) | Some(TInt64) | Some(TUInt64) => true
          _ => false
        }
        is_int_recv && qbe_expr_is_pure_no_trap(g, recv, check_scopes)
      } else {
        false
      }
    }
    _ => false
  }
}

///|
fn qbe_tco_expr_is_borrowed_subpath(
  e : Expr,
  borrowed_roots : Array[String],
) -> Bool {
  match e {
    EIdent(v, _) => str_arr_contains(borrowed_roots, v)
    EField(EIdent(v, _), _, _) => str_arr_contains(borrowed_roots, v)
    _ => false
  }
}

///|
fn qbe_tco_call_is_eligible(
  g : QbeGen,
  fd : FnDecl,
  finfo : FnInfo,
  e : Expr,
  borrowed_roots : Array[String],
) -> Bool {
  match e {
    ECall(EIdent(fname, _), args, sp) => {
      if fname != fd.name {
        return false
      }
      let call_res = resolve_call_args_qbe_full(fd.params, 0, args, sp)
      if qbe_has_any_default(call_res.from_default) {
        return false
      }
      let norm_args = call_res.args
      if norm_args.length() != fd.params.length() ||
        norm_args.length() != finfo.param_tys.length() {
        return false
      }
      let mut pi = 0
      while pi < norm_args.length() {
        match norm_args[pi] {
          EMutArg(_, _) => return false
          _ => ()
        }
        if qbe_is_obj_ty(g, finfo.param_tys[pi]) {
          if !qbe_tco_expr_is_borrowed_subpath(norm_args[pi], borrowed_roots) {
            return false
          }
        }
        pi = pi + 1
      }
      true
    }
    _ => false
  }
}

///|
fn qbe_tco_scan_tail_expr(
  g : QbeGen,
  fd : FnDecl,
  finfo : FnInfo,
  e : Expr,
  borrowed_roots : Array[String],
  counts : Array[Int],
) -> Unit {
  if qbe_tco_call_is_eligible(g, fd, finfo, e, borrowed_roots) {
    counts[0] = counts[0] + 1
    return
  }
  match e {
    EBinary("+", lhs, rhs, _) => {
      if qbe_tco_call_is_eligible(g, fd, finfo, rhs, borrowed_roots) {
        counts[1] = counts[1] + 1
      } else if qbe_tco_call_is_eligible(g, fd, finfo, lhs, borrowed_roots) &&
        qbe_expr_is_pure_no_trap(g, rhs, false) {
        counts[1] = counts[1] + 1
      }
    }
    EBlock(stmts, _) =>
      qbe_tco_scan_stmts(g, fd, finfo, stmts, true, borrowed_roots, counts)
    EIf(_, then_s, Some(else_e), _) => {
      qbe_tco_scan_stmts(g, fd, finfo, then_s, true, borrowed_roots, counts)
      qbe_tco_scan_tail_expr(g, fd, finfo, else_e, borrowed_roots, counts)
    }
    EMatch(scrut, arms, _) => {
      let scrut_ok = qbe_tco_expr_is_borrowed_subpath(scrut, borrowed_roots)
      let mut ai = 0
      while ai < arms.length() {
        let arm = arms[ai]
        let mut arm_roots = qbe_tco_clone_roots(borrowed_roots)
        let pat_names : Array[String] = []
        qbe_tco_collect_pat_names(arm.pat, pat_names)
        let mut pni = 0
        while pni < pat_names.length() {
          arm_roots = qbe_tco_remove_root(arm_roots, pat_names[pni])
          pni = pni + 1
        }
        let allow_arm_borrow = match arm.guard_expr {
          Some(_) => false
          None => scrut_ok
        }
        if allow_arm_borrow {
          pni = 0
          while pni < pat_names.length() {
            if !str_arr_contains(arm_roots, pat_names[pni]) {
              arm_roots.push(pat_names[pni])
            }
            pni = pni + 1
          }
        }
        qbe_tco_scan_tail_expr(g, fd, finfo, arm.body, arm_roots, counts)
        ai = ai + 1
      }
    }
    _ => ()
  }
}

///|
fn qbe_tco_scan_stmts(
  g : QbeGen,
  fd : FnDecl,
  finfo : FnInfo,
  stmts : Array[Stmt],
  is_tail : Bool,
  borrowed_roots : Array[String],
  counts : Array[Int],
) -> Unit {
  let mut cur_roots = qbe_tco_clone_roots(borrowed_roots)
  let n = stmts.length()
  let mut i = 0
  while i < n {
    let last = i == n - 1
    match stmts[i] {
      SLet(name, _, _, _, _) => {
        if name == fd.name {
          counts[2] = 1
        }
        cur_roots = qbe_tco_remove_root(cur_roots, name)
      }
      SLetTuple(names, _, _, _) => {
        let mut ni = 0
        while ni < names.length() {
          if names[ni] == fd.name {
            counts[2] = 1
          }
          cur_roots = qbe_tco_remove_root(cur_roots, names[ni])
          ni = ni + 1
        }
      }
      SReturn(Some(re), _) =>
        qbe_tco_scan_tail_expr(g, fd, finfo, re, cur_roots, counts)
      SExpr(e, _) =>
        if is_tail && last {
          qbe_tco_scan_tail_expr(g, fd, finfo, e, cur_roots, counts)
        } else {
          match e {
            EIf(_, then_s, else_opt, _) => {
              qbe_tco_scan_stmts(g, fd, finfo, then_s, false, cur_roots, counts)
              match else_opt {
                Some(EBlock(es, _)) =>
                  qbe_tco_scan_stmts(g, fd, finfo, es, false, cur_roots, counts)
                Some(el) =>
                  qbe_tco_scan_stmts(
                    g,
                    fd,
                    finfo,
                    [SExpr(el, span_new("", 0, 0))],
                    false,
                    cur_roots,
                    counts,
                  )
                None => ()
              }
            }
            EBlock(bs, _) =>
              qbe_tco_scan_stmts(g, fd, finfo, bs, false, cur_roots, counts)
            EMatch(_, arms, _) => {
              let mut ai = 0
              while ai < arms.length() {
                qbe_tco_scan_stmts(
                  g,
                  fd,
                  finfo,
                  [SExpr(arms[ai].body, span_new("", 0, 0))],
                  false,
                  cur_roots,
                  counts,
                )
                ai = ai + 1
              }
            }
            _ => ()
          }
        }
      SWhile(_, wbody, _) | SGuard(_, wbody, _) =>
        qbe_tco_scan_stmts(g, fd, finfo, wbody, false, cur_roots, counts)
      SForIn(idx_name, vname, _, wbody, _) => {
        if idx_name == fd.name || vname == fd.name {
          counts[2] = 1
        }
        let inner_roots = qbe_tco_remove_root(
          qbe_tco_remove_root(cur_roots, idx_name),
          vname,
        )
        qbe_tco_scan_stmts(g, fd, finfo, wbody, false, inner_roots, counts)
      }
      SForRange(vname, _, _, _, fbody, _) => {
        if vname == fd.name {
          counts[2] = 1
        }
        let inner_roots = qbe_tco_remove_root(cur_roots, vname)
        qbe_tco_scan_stmts(g, fd, finfo, fbody, false, inner_roots, counts)
      }
      SFor(init_s, _, _, fbody, _) => {
        let mut inner_roots = qbe_tco_clone_roots(cur_roots)
        match init_s {
          SLet(iname, _, _, _, _) => {
            if iname == fd.name {
              counts[2] = 1
            }
            inner_roots = qbe_tco_remove_root(inner_roots, iname)
          }
          SLetTuple(inames, _, _, _) => {
            let mut ni = 0
            while ni < inames.length() {
              if inames[ni] == fd.name {
                counts[2] = 1
              }
              inner_roots = qbe_tco_remove_root(inner_roots, inames[ni])
              ni = ni + 1
            }
          }
          SAssign(_, _, _)
          | SCompoundAssign(_, _, _, _)
          | SGuard(_, _, _)
          | SWhile(_, _, _)
          | SFor(_, _, _, _, _)
          | SForRange(_, _, _, _, _, _)
          | SForIn(_, _, _, _, _)
          | SReturn(_, _)
          | SBreak(_)
          | SContinue(_)
          | SDebugAssert(_, _, _)
          | SExpr(_, _) => ()
        }
        qbe_tco_scan_stmts(g, fd, finfo, fbody, false, inner_roots, counts)
      }
      // Non-tail positions: any `return` hidden in these expressions is still
      // re-checked at emit time by `qbe_tco_try_emit_self_jump` (local
      // shadowing + borrowed-slot loadability), so skipping them only loses
      // optimisation opportunities, never soundness.
      SAssign(_, _, _)
      | SCompoundAssign(_, _, _, _)
      | SDebugAssert(_, _, _)
      | SReturn(None, _)
      | SBreak(_)
      | SContinue(_) => ()
    }
    i = i + 1
  }
}

///|
fn qbe_tco_mode(
  g : QbeGen,
  fd : FnDecl,
  finfo : FnInfo,
  body : Array[Stmt],
) -> Int {
  if fd.type_params.length() > 0 ||
    fd.receiver_type != "" ||
    fd.is_verify ||
    fd.params.length() != finfo.param_tys.length() {
    return 0
  }
  let mut has_rc_param = false
  let init_roots : Array[String] = []
  let mut pi = 0
  while pi < fd.params.length() {
    let p = fd.params[pi]
    if p.is_mut || p.name == fd.name || g.boxed_mut_vars.contains(p.name) {
      return 0
    }
    let pty = finfo.param_tys[pi]
    if qbe_is_obj_ty(g, pty) {
      has_rc_param = true
      if !qbe_ty_has_no_mut_fields(g, pty, Map([])) {
        return 0
      }
      init_roots.push(p.name)
    }
    pi = pi + 1
  }
  if has_rc_param && qbe_stmts_has_heap_write(body) {
    return 0
  }
  let counts : Array[Int] = [0, 0, 0]
  qbe_tco_scan_stmts(g, fd, finfo, body, true, init_roots, counts)
  if counts[2] > 0 {
    return 0
  }
  if counts[1] > 0 &&
    qbe_tco_is_int_trma_ty(finfo.ret_ty) &&
    !qbe_stmts_has_trma_forbidden(body) {
    return 2
  }
  if counts[0] > 0 {
    return 1
  }
  0
}

///|
fn qbe_tco_can_load_borrowed_rc_arg(g : QbeGen, arg : Expr) -> Bool {
  match arg {
    EIdent(v, _) =>
      match qbe_lookup_local(g, v) {
        Some(loc) =>
          str_arr_contains(g.tco_borrowed_roots, loc.slot) &&
          !loc.owned &&
          !loc.is_cell &&
          loc.ref_slot == ""
        None => false
      }
    EField(EIdent(v, _), fname, _) =>
      match qbe_lookup_local(g, v) {
        Some(loc) =>
          if str_arr_contains(g.tco_borrowed_roots, loc.slot) &&
            !loc.owned &&
            !loc.is_cell &&
            loc.ref_slot == "" {
            match loc.ty {
              TStruct(sname, _) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname && !sinfo.field_muts[fi] {
                        return true
                      }
                      fi = fi + 1
                    }
                    false
                  }
                  None => false
                }
              _ => false
            }
          } else {
            false
          }
        None => false
      }
    _ => false
  }
}

///|
fn qbe_tco_load_borrowed_rc_arg(
  g : QbeGen,
  arg : Expr,
  expected_ty : Ty,
) -> Option[String] {
  match arg {
    EIdent(v, _) =>
      match qbe_lookup_local(g, v) {
        Some(loc) =>
          if str_arr_contains(g.tco_borrowed_roots, loc.slot) &&
            !loc.owned &&
            !loc.is_cell &&
            loc.ref_slot == "" {
            let r = qbe_load_local_slot(g, loc.slot, loc.ty)
            Some(qbe_coerce_val(g, qval(r, loc.ty), expected_ty))
          } else {
            None
          }
        None => None
      }
    EField(EIdent(v, _), fname, _) =>
      match qbe_lookup_local(g, v) {
        Some(loc) =>
          if str_arr_contains(g.tco_borrowed_roots, loc.slot) &&
            !loc.owned &&
            !loc.is_cell &&
            loc.ref_slot == "" {
            match loc.ty {
              TStruct(sname, sargs) =>
                match qbe_lookup_struct_info(g, sname) {
                  Some(sinfo) => {
                    let mut found = -1
                    let mut fi = 0
                    while fi < sinfo.field_names.length() {
                      if sinfo.field_names[fi] == fname && !sinfo.field_muts[fi] {
                        found = fi
                        break
                      }
                      fi = fi + 1
                    }
                    if found >= 0 {
                      let subst = make_subst(sinfo.decl.type_params, sargs)
                      let fty = subst_ty(sinfo.field_tys[found], subst)
                      let obj_p = qbe_tmp(g)
                      let fp = qbe_tmp(g)
                      qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                      qbe_emit(
                        g,
                        fp + " =l add " + obj_p + ", " + (found * 8).to_string(),
                      )
                      let fv = qbe_load_heap_slot(g, fp, fty)
                      Some(qbe_coerce_val(g, qval(fv, fty), expected_ty))
                    } else {
                      None
                    }
                  }
                  None => None
                }
              _ => None
            }
          } else {
            None
          }
        None => None
      }
    _ => None
  }
}

///|
fn qbe_tco_try_emit_self_jump(
  g : QbeGen,
  call_expr : Expr,
  left_delta : Option[Expr],
  right_delta : Option[Expr],
) -> Bool {
  match call_expr {
    ECall(EIdent(fname, _), args, sp) => {
      if fname != g.tco_fn_name {
        return false
      }
      match qbe_lookup_local(g, fname) {
        Some(_) => return false
        None => ()
      }
      let finfo = match g.tc.fns.get(fname) {
        Some(fi) => fi
        None => return false
      }
      let call_res = resolve_call_args_qbe_full(finfo.decl.params, 0, args, sp)
      if qbe_has_any_default(call_res.from_default) {
        return false
      }
      let norm_args = call_res.args
      if norm_args.length() != g.tco_param_slots.length() ||
        norm_args.length() != g.tco_param_tys.length() {
        return false
      }
      // Verify all RC args are loadable borrowed subpaths BEFORE emitting any code (including left_delta)
      let mut pi = 0
      while pi < norm_args.length() {
        if qbe_is_obj_ty(g, g.tco_param_tys[pi]) {
          if !qbe_tco_can_load_borrowed_rc_arg(g, norm_args[pi]) {
            return false
          }
        }
        pi = pi + 1
      }
      // Left-add TRMA: evaluate lhs FIRST, accumulate into tco_acc_slot
      match left_delta {
        Some(le) => {
          let lv = qbe_emit_expr(g, le, Some(g.cur_ret_ty))
          if g.block_term {
            return true
          }
          let lreg = qbe_coerce_val(g, lv, g.cur_ret_ty)
          let acc = qbe_load_local_slot(g, g.tco_acc_slot, g.cur_ret_ty)
          let nacc = qbe_tco_add_int(g, g.cur_ret_ty, acc, lreg)
          qbe_store_local_slot(g, nacc, g.tco_acc_slot, g.cur_ret_ty)
        }
        None => ()
      }
      // Evaluate ALL new parameter values before overwriting any param slot
      let order = qbe_call_eval_order(finfo.decl.params, 0, args, norm_args.length())
      let new_vals : Array[String] = []
      while new_vals.length() < norm_args.length() {
        new_vals.push("0")
      }
      let mut oi = 0
      while oi < order.length() {
        pi = order[oi]
        let pty = g.tco_param_tys[pi]
        if qbe_is_obj_ty(g, pty) {
          match qbe_tco_load_borrowed_rc_arg(g, norm_args[pi], pty) {
            Some(r) => new_vals[pi] = r
            None => return false
          }
        } else {
          let av = qbe_emit_expr(g, norm_args[pi], Some(pty))
          if g.block_term {
            return true
          }
          new_vals[pi] = qbe_coerce_val(g, av, pty)
        }
        oi = oi + 1
      }
      // Right-add TRMA (pure/no-trap rhs): evaluate rhs after args, before storing params
      match right_delta {
        Some(re) => {
          let rv = qbe_emit_expr(g, re, Some(g.cur_ret_ty))
          if g.block_term {
            return true
          }
          let rreg = qbe_coerce_val(g, rv, g.cur_ret_ty)
          let acc = qbe_load_local_slot(g, g.tco_acc_slot, g.cur_ret_ty)
          let nacc = qbe_tco_add_int(g, g.cur_ret_ty, acc, rreg)
          qbe_store_local_slot(g, nacc, g.tco_acc_slot, g.cur_ret_ty)
        }
        None => ()
      }
      // Store all new param values into param slots
      pi = 0
      while pi < new_vals.length() {
        qbe_store_local_slot(
          g,
          new_vals[pi],
          g.tco_param_slots[pi],
          g.tco_param_tys[pi],
        )
        pi = pi + 1
      }
      qbe_release_scopes_down_to(g, g.tco_base_scope_depth)
      qbe_tco_clear_caches(g)
      qbe_emit_term(g, "jmp " + g.tco_loop_lbl)
      true
    }
    _ => false
  }
}

///|
fn qbe_emit_tco_leaf_return(
  g : QbeGen,
  e : Expr,
  expected : Option[Ty],
) -> Unit {
  let ev = qbe_emit_expr(g, e, expected)
  if g.block_term {
    return
  }
  let val_reg = qbe_coerce_val(g, ev, g.cur_ret_abi_ty)
  let final_reg = if g.tco_mode == 2 {
    let acc = qbe_load_local_slot(g, g.tco_acc_slot, g.cur_ret_ty)
    qbe_tco_add_int(g, g.cur_ret_ty, acc, val_reg)
  } else {
    val_reg
  }
  qbe_release_scopes_down_to(g, 0)
  if g.cur_fn_void {
    qbe_emit_term(g, "ret")
  } else {
    qbe_emit_term(g, "ret " + final_reg)
  }
}

///|
fn qbe_emit_tco_return(
  g : QbeGen,
  e : Expr,
  expected : Option[Ty],
) -> Unit {
  if g.block_term {
    return
  }
  // Direct tail self-call (mode 1 or mode 2)
  if qbe_tco_try_emit_self_jump(g, e, None, None) {
    return
  }
  match e {
    EBinary("+", lhs, rhs, _) => {
      if g.tco_mode == 2 {
        if qbe_tco_try_emit_self_jump(g, rhs, Some(lhs), None) {
          return
        }
        if qbe_expr_is_pure_no_trap(g, rhs, true) &&
          qbe_tco_try_emit_self_jump(g, lhs, None, Some(rhs)) {
          return
        }
      }
      qbe_emit_tco_leaf_return(g, e, expected)
    }
    EBlock(stmts, _) => {
      qbe_scope_push(g)
      qbe_emit_tco_stmts(g, stmts, expected)
      let _ = g.scopes.pop()
    }
    EIf(cond, then_stmts, Some(else_e), _) => {
      let l_then = qbe_lbl(g, "tco_then")
      let l_else = qbe_lbl(g, "tco_else")
      let has_is = qbe_expr_has_is(cond)
      let saved_roots = g.tco_borrowed_roots
      if has_is {
        qbe_scope_push(g)
        qbe_emit_cond_branch_bind(g, cond, l_then, l_else, Some(then_stmts))
        qbe_emit_lbl(g, l_then)
        // Pattern vars from `is` may shadow borrowed roots; conservatively drop any shadowed names
        let cur_sc = g.scopes[g.scopes.length() - 1]
        let mut t_roots = qbe_tco_clone_roots(saved_roots)
        let mut li = 0
        while li < cur_sc.locals.length() {
          t_roots = qbe_tco_remove_root(t_roots, cur_sc.locals[li].name)
          li = li + 1
        }
        g.tco_borrowed_roots = t_roots
      } else {
        qbe_emit_cond_branch(g, cond, l_then, l_else)
        qbe_emit_lbl(g, l_then)
        qbe_scope_push(g)
      }
      qbe_emit_tco_stmts(g, then_stmts, expected)
      let _ = g.scopes.pop()
      g.tco_borrowed_roots = saved_roots
      qbe_emit_lbl(g, l_else)
      qbe_scope_push(g)
      qbe_emit_tco_return(g, else_e, expected)
      let _ = g.scopes.pop()
      g.tco_borrowed_roots = saved_roots
      g.block_term = true
    }
    EMatch(scrut, arms, sp) => {
      qbe_scope_push(g)
      let mut scrut_borrowed = false
      let mut scrut_tco_borrowed = false
      let mut sv = qval("0", TError)
      match scrut {
        EIdent(xname, _) =>
          match qbe_lookup_local(g, xname) {
            Some(loc) =>
              if !loc.is_cell {
                let mut reassigned = false
                let mut ai = 0
                while ai < arms.length() {
                  match arms[ai].guard_expr {
                    Some(ge) =>
                      if qbe_expr_assigns_ident(ge, xname) {
                        reassigned = true
                        break
                      }
                    None => ()
                  }
                  if qbe_expr_assigns_ident(arms[ai].body, xname) {
                    reassigned = true
                    break
                  }
                  ai = ai + 1
                }
                if !reassigned {
                  let r = qbe_load_local_slot(g, loc.slot, loc.ty)
                  sv = qval(r, loc.ty)
                  scrut_borrowed = true
                  scrut_tco_borrowed = str_arr_contains(
                    g.tco_borrowed_roots,
                    loc.slot,
                  ) &&
                    !loc.owned
                }
              }
            None => ()
          }
        EField(EIdent(xname, _), fname, _) =>
          match qbe_lookup_local(g, xname) {
            Some(loc) =>
              if !loc.is_cell && loc.ref_slot == "" {
                match loc.ty {
                  TStruct(sname, sargs) =>
                    match qbe_lookup_struct_info(g, sname) {
                      Some(sinfo) => {
                        let mut found_immut = -1
                        let mut fi = 0
                        while fi < sinfo.field_names.length() {
                          if sinfo.field_names[fi] == fname &&
                            !sinfo.field_muts[fi] {
                            found_immut = fi
                            break
                          }
                          fi = fi + 1
                        }
                        if found_immut >= 0 {
                          let mut reassigned = false
                          let mut ai = 0
                          while ai < arms.length() {
                            match arms[ai].guard_expr {
                              Some(ge) =>
                                if qbe_expr_assigns_ident(ge, xname) {
                                  reassigned = true
                                  break
                                }
                              None => ()
                            }
                            if qbe_expr_assigns_ident(arms[ai].body, xname) {
                              reassigned = true
                              break
                            }
                            ai = ai + 1
                          }
                          if !reassigned {
                            let subst = make_subst(
                              sinfo.decl.type_params,
                              sargs,
                            )
                            let fty = subst_ty(
                              sinfo.field_tys[found_immut],
                              subst,
                            )
                            let obj_p = qbe_tmp(g)
                            let fp = qbe_tmp(g)
                            qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                            qbe_emit(
                              g,
                              fp +
                              " =l add " +
                              obj_p +
                              ", " +
                              (found_immut * 8).to_string(),
                            )
                            let fv = qbe_load_heap_slot(g, fp, fty)
                            sv = qval(fv, fty)
                            scrut_borrowed = true
                            scrut_tco_borrowed = str_arr_contains(
                              g.tco_borrowed_roots,
                              loc.slot,
                            ) &&
                              !loc.owned
                          }
                        }
                      }
                      None => ()
                    }
                  _ => ()
                }
              }
            None => ()
          }
        _ => ()
      }
      if !scrut_borrowed {
        sv = qbe_emit_expr(g, scrut, None)
        if g.block_term {
          let _ = g.scopes.pop()
          return
        }
      }
      let scrut_loc = qbe_define_local(
        g,
        "__match_scrut",
        sv.ty,
        !scrut_borrowed,
      )
      qbe_store_local_slot(g, sv.reg, scrut_loc.slot, sv.ty)
      let saved_roots = g.tco_borrowed_roots
      let mut i = 0
      while i < arms.length() {
        let mut grp_end = i + 1
        while grp_end < arms.length() && qbe_arm_can_share(arms[i], arms[grp_end]) {
          grp_end = grp_end + 1
        }
        let arm = arms[i]
        let l_next = qbe_lbl(g, "tco_mnext")
        if grp_end > i + 1 {
          let l_body = qbe_lbl(g, "tco_marm")
          let mut gi = i
          while gi < grp_end {
            let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
            if gi + 1 < grp_end {
              let l_try_next = qbe_lbl(g, "tco_mnext")
              qbe_emit_pat_test(g, arms[gi].pat, cur_sv, sv.ty, l_try_next)
              qbe_emit_term(g, "jmp " + l_body)
              qbe_emit_lbl(g, l_try_next)
            } else {
              qbe_emit_pat_test(g, arms[gi].pat, cur_sv, sv.ty, l_next)
              qbe_emit_term(g, "jmp " + l_body)
            }
            gi = gi + 1
          }
          qbe_emit_lbl(g, l_body)
        } else {
          let cur_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
          qbe_emit_pat_test(g, arm.pat, cur_sv, sv.ty, l_next)
        }
        qbe_scope_push(g)
        let arm_allow_borrow = match arm.guard_expr {
          Some(_) => false
          None => scrut_borrowed
        }
        if grp_end == i + 1 && qbe_pat_has_binds(arm.pat) {
          let bind_sv = qbe_load_local_slot(g, scrut_loc.slot, sv.ty)
          qbe_emit_pat_bind(
            g,
            arm.pat,
            bind_sv,
            sv.ty,
            arm_allow_borrow,
            arm.body,
          )
        }
        match arm.guard_expr {
          Some(ge) => {
            let l_body = qbe_lbl(g, "tco_mgok")
            let l_gfail = qbe_lbl(g, "tco_mgfail")
            let before_guard = g.scopes[g.scopes.length() - 1].locals.length()
            if qbe_expr_has_is(ge) {
              qbe_emit_cond_branch_bind(g, ge, l_body, l_gfail, None)
            } else {
              qbe_emit_cond_branch(g, ge, l_body, l_gfail)
            }
            qbe_emit_lbl(g, l_gfail)
            qbe_release_scope_locals_range(g, 0, before_guard)
            qbe_emit_term(g, "jmp " + l_next)
            qbe_emit_lbl(g, l_body)
          }
          None => ()
        }
        let arm_roots = qbe_tco_clone_roots(saved_roots)
        if scrut_tco_borrowed && arm_allow_borrow {
          let pat_names : Array[String] = []
          qbe_tco_collect_pat_names(arm.pat, pat_names)
          let mut pni = 0
          while pni < pat_names.length() {
            match qbe_lookup_local(g, pat_names[pni]) {
              Some(ploc) =>
                if !ploc.owned && !str_arr_contains(arm_roots, ploc.slot) {
                  arm_roots.push(ploc.slot)
                }
              None => ()
            }
            pni = pni + 1
          }
        }
        g.tco_borrowed_roots = arm_roots
        qbe_emit_tco_return(g, arm.body, expected)
        let _ = g.scopes.pop()
        g.tco_borrowed_roots = saved_roots
        qbe_emit_lbl(g, l_next)
        i = grp_end
      }
      let file_id = qbe_intern_source_path(g, sp.file)
      let msg_id = qbe_intern_cstring(g, "non-exhaustive match")
      qbe_emit(
        g,
        "call $pion_panic(l $pion_cstr_" +
        msg_id.to_string() +
        ", l $pion_cstr_" +
        file_id.to_string() +
        ", w " +
        sp.line.to_string() +
        ")",
      )
      if g.cur_fn_void {
        qbe_emit_term(g, "ret")
      } else {
        qbe_emit_term(g, "ret " + qbe_zero_reg(g.cur_ret_abi_ty))
      }
      let _ = g.scopes.pop()
      g.block_term = true
    }
    _ => qbe_emit_tco_leaf_return(g, e, expected)
  }
}

///|
fn qbe_emit_tco_stmts(
  g : QbeGen,
  stmts : Array[Stmt],
  expected : Option[Ty],
) -> Unit {
  let saved_roots = g.tco_borrowed_roots
  let n = stmts.length()
  if n == 0 {
    if !g.block_term {
      qbe_emit_tco_leaf_return(g, EUnit(span_new("", 0, 0)), expected)
    }
    return
  }
  let mut i = 0
  while i < n - 1 {
    if g.block_term {
      g.tco_borrowed_roots = saved_roots
      return
    }
    let _ = qbe_emit_stmt(g, stmts[i], None, false)
    match stmts[i] {
      SLet(name, _, _, _, _) =>
        g.tco_borrowed_roots = qbe_tco_remove_root(g.tco_borrowed_roots, name)
      SLetTuple(names, _, _, _) => {
        let mut ni = 0
        while ni < names.length() {
          g.tco_borrowed_roots = qbe_tco_remove_root(
            g.tco_borrowed_roots,
            names[ni],
          )
          ni = ni + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  if !g.block_term {
    match stmts[n - 1] {
      SExpr(tail_e, _) => qbe_emit_tco_return(g, tail_e, expected)
      SReturn(_, _) => {
        let _ = qbe_emit_stmt(g, stmts[n - 1], expected, true)
      }
      _ => {
        let _ = qbe_emit_stmt(g, stmts[n - 1], None, false)
        if !g.block_term {
          qbe_emit_tco_leaf_return(g, EUnit(span_new("", 0, 0)), expected)
        }
      }
    }
  }
  g.tco_borrowed_roots = saved_roots
}

///|
fn qbe_emit_fn_decl(g : QbeGen, fd : FnDecl) -> String {
  if fd.type_bounds.length() > 0 {
    return ""
  }
  let finfo_opt = if fd.receiver_type != "" {
    g.tc.methods.get(fd.receiver_type + "::" + fd.name)
  } else {
    g.tc.fns.get(fd.name)
  }
  match finfo_opt {
    None => ""
    Some(finfo) => {
      g.fn_allocs = StringBuilder()
      g.fn_body = StringBuilder()
      g.fn_start_tmp = g.next_tmp
      g.fn_start_lbl = g.next_lbl
      g.fn_inlined_cost = 0
      qbe_fn_cleanup_begin(g, true)
      g.scopes = []
      g.loop_breaks = []
      g.loop_conts = []
      g.loop_depths = []
      g.hot_loop_depth = 0
      g.cur_tparams = fd.type_params
      g.live_tparams = fd.type_params
      g.cur_type_subst = Map([])
      g.lexical_type_subst = Map([])
      g.cur_ret_ty = finfo.ret_ty
      g.cur_ret_abi_ty = finfo.ret_ty
      g.cur_fn_void = false
      g.block_term = false
      g.hoisted_arr_len = Map([])
      g.hoisted_arr_dp = Map([])
      g.hoisted_str_len = Map([])
      g.hoisted_str_dp = Map([])
      g.hoisted_bytes_len = Map([])
      g.hoisted_bytes_dp = Map([])
      g.inline_closures = Map([])
      g.inline_ret_lbl = ""
      g.inline_ret_tag_slot = ""
      g.inline_ret_err_slot = ""
      g.inline_ret_pod_buf = false
      qbe_reset_tco(g)
      g.hoisted_fields = Map([])
      g.block_immut_fields = Map([])
      g.len_aliases = Map([])
      g.len_alias_keys = []
      g.nonneg_vars = Map([])
      g.u8_range_vars = Map([])
      g.known_min_len_arrs = Map([])
      g.known_writable_bytes = Map([])
      g.bce_safe_indices = Map([])
      g.bce_safe_exprs = Map([])
      g.bce_safe_push_arrs = Map([])
      g.movable_locals = Map([])
      g.moved_slots = Map([])
      g.zeroed_slots = Map([])
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
      g.pinned_slots = Map([])
      g.borrow_owner_slot = Map([])
      g.borrow_owner_name = Map([])
      g.mut_local_slots = Map([])
      g.sq_reuse_slot = Map([])
      g.sq_reuse_state = Map([])
      g.promoted_fields = Map([])
      g.promoted_field_tys = Map([])
      g.promoted_push_len = Map([])
      g.promoted_push_cap = Map([])
      g.promoted_push_dp = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext = Map([])
      g.unfrozen_local_arrs = Map([])
      let body = qbe_fn_body(g, fd.body)
      g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)
      g.in_verify = fd.is_verify

      qbe_scope_push(g)
      qbe_define_fn_params(g, fd.params, finfo.param_tys)
      let tco_m = qbe_tco_mode(g, fd, finfo, body)
      if tco_m > 0 && g.scopes[0].locals.length() == fd.params.length() {
        let p_slots : Array[String] = []
        let b_roots : Array[String] = []
        let mut tpi2 = 0
        while tpi2 < fd.params.length() {
          let pslot = g.scopes[0].locals[tpi2].slot
          p_slots.push(pslot)
          if qbe_is_obj_ty(g, finfo.param_tys[tpi2]) {
            b_roots.push(pslot)
          }
          tpi2 = tpi2 + 1
        }
        let tco_lbl = qbe_lbl(g, "tco_loop")
        g.tco_fn_name = fd.name
        g.tco_mode = tco_m
        g.tco_loop_lbl = tco_lbl
        g.tco_acc_slot = if tco_m == 2 {
          qbe_alloc_slot_for(g, finfo.ret_ty)
        } else {
          ""
        }
        g.tco_param_slots = p_slots
        g.tco_param_tys = finfo.param_tys
        g.tco_base_scope_depth = g.scopes.length()
        g.tco_borrowed_roots = b_roots
        qbe_tco_clear_caches(g)
        qbe_emit_term(g, "jmp " + tco_lbl)
        qbe_emit_lbl(g, tco_lbl)
        qbe_tco_clear_caches(g)
        qbe_scope_push(g)
        qbe_emit_tco_stmts(g, body, Some(finfo.ret_ty))
        if !g.block_term {
          qbe_emit_tco_leaf_return(
            g,
            EUnit(span_new("", 0, 0)),
            Some(finfo.ret_ty),
          )
        }
        let _ = g.scopes.pop()
        let _ = g.scopes.pop()
        qbe_reset_tco(g)
      } else {
        let bres = qbe_emit_stmts(g, body, Some(finfo.ret_ty))
        if !g.block_term {
          let ret_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
          if g.fn_cleanup_pads.length() > 0 &&
            qbe_try_emit_shared_cleanup_exit(g, ret_reg) {
            qbe_scope_pop_meta_only(g)
          } else {
            qbe_scope_pop(g)
            qbe_emit_term(g, "ret " + ret_reg)
          }
        } else {
          let _ = g.scopes.pop()
        }
      }
      qbe_fn_cleanup_flush(g)
      g.in_verify = false
      g.cur_tparams = []
      g.live_tparams = []

      let out = StringBuilder()
      let sym = if fd.receiver_type != "" {
        qbe_local_method_sym(g, fd.receiver_type, fd.name)
      } else {
        qbe_local_fn_sym(g, fd.name)
      }
      if fd.is_pub || g.unit_mode || g.export_internals {
        out.write_string("export ")
      }
      out.write_string("function ")
      out.write_string(qbe_abi_ty(finfo.ret_ty))
      out.write_string(" ")
      out.write_string(sym)
      out.write_string("(")
      let mut pi = 0
      while pi < fd.params.length() {
        if pi > 0 {
          out.write_string(", ")
        }
        let p_abi = qbe_param_abi(fd.params, finfo.param_tys, pi)
        out.write_string(p_abi)
        out.write_string(" %p")
        out.write_string(pi.to_string())
        pi = pi + 1
      }
      let mut tpi = 0
      while tpi < fd.type_params.length() {
        if fd.params.length() > 0 || tpi > 0 {
          out.write_string(", ")
        }
        out.write_string("l %tp_")
        out.write_string(fd.type_params[tpi])
        tpi = tpi + 1
      }
      out.write_string(") {\n@start\n")
      out.write_string(g.fn_allocs.to_string())
      out.write_string(g.fn_body.to_string())
      out.write_string("}\n\n")
      out.to_string()
    }
  }
}

///|
fn qbe_emit_extern_fn_decl(
  g : QbeGen,
  ed : ExternFnDecl,
  extern_init_sym : String,
  extern_init_guard_sym : String,
  extern_init_unit_syms : Array[String],
  extern_init_unit_guard : String,
) -> String {
  if !ed.has_body {
    return ""
  }
  match g.tc.extern_fns.get(ed.name) {
    None => ""
    Some(einfo) => {
      let is_unit = match einfo.ret_ty {
        TUnit => true
        _ => false
      }
      let c_ret_abi = qbe_c_abi_ty(einfo.ret_ty)
      let ret_abi_ty = if c_ret_abi == "w" {
        TInt
      } else {
        einfo.ret_ty
      }
      g.fn_allocs = StringBuilder()
      g.fn_body = StringBuilder()
      g.fn_start_tmp = g.next_tmp
      g.fn_start_lbl = g.next_lbl
      g.fn_inlined_cost = 0
      qbe_fn_cleanup_begin(g, true)
      g.scopes = []
      g.loop_breaks = []
      g.loop_conts = []
      g.loop_depths = []
      g.hot_loop_depth = 0
      g.cur_tparams = []
      g.live_tparams = []
      g.cur_type_subst = Map([])
      g.lexical_type_subst = Map([])
      g.cur_ret_ty = einfo.ret_ty
      g.cur_ret_abi_ty = ret_abi_ty
      g.cur_fn_void = is_unit
      g.block_term = false
      g.hoisted_arr_len = Map([])
      g.hoisted_arr_dp = Map([])
      g.hoisted_str_len = Map([])
      g.hoisted_str_dp = Map([])
      g.hoisted_bytes_len = Map([])
      g.hoisted_bytes_dp = Map([])
      g.inline_closures = Map([])
      g.inline_ret_lbl = ""
      g.inline_ret_tag_slot = ""
      g.inline_ret_err_slot = ""
      g.inline_ret_pod_buf = false
      qbe_reset_tco(g)
      g.hoisted_fields = Map([])
      g.block_immut_fields = Map([])
      g.len_aliases = Map([])
      g.len_alias_keys = []
      g.nonneg_vars = Map([])
      g.u8_range_vars = Map([])
      g.known_min_len_arrs = Map([])
      g.known_writable_bytes = Map([])
      g.bce_safe_indices = Map([])
      g.bce_safe_exprs = Map([])
      g.bce_safe_push_arrs = Map([])
      g.movable_locals = Map([])
      g.moved_slots = Map([])
      g.zeroed_slots = Map([])
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
      g.pinned_slots = Map([])
      g.borrow_owner_slot = Map([])
      g.borrow_owner_name = Map([])
      g.mut_local_slots = Map([])
      g.sq_reuse_slot = Map([])
      g.sq_reuse_state = Map([])
      g.promoted_fields = Map([])
      g.promoted_field_tys = Map([])
      g.promoted_push_len = Map([])
      g.promoted_push_cap = Map([])
      g.promoted_push_dp = Map([])
      g.w_to_l_ext = Map([])
      g.local_w_to_l_ext = Map([])
      g.unfrozen_local_arrs = Map([])
      let body = qbe_fn_body(g, ed.body)
      g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)

      qbe_scope_push(g)
      let mut pi = 0
      while pi < ed.params.length() && pi < einfo.param_tys.length() {
        let pty = einfo.param_tys[pi]
        let loc = qbe_define_local(g, ed.params[pi].name, pty, false)
        let raw_p = "%p" + pi.to_string()
        let p_reg = match pty {
          TBool | TChar => {
            let ext = qbe_tmp(g)
            qbe_emit(g, ext + " =l extuw " + raw_p)
            ext
          }
          TByte => {
            let ext = qbe_tmp(g)
            qbe_emit(g, ext + " =l extub " + raw_p)
            ext
          }
          TInt8 => {
            let ext = qbe_tmp(g)
            qbe_emit(g, ext + " =l extsb " + raw_p)
            ext
          }
          _ => raw_p
        }
        qbe_store_local_slot(g, p_reg, loc.slot, pty)
        pi = pi + 1
      }
      if extern_init_sym != "" && extern_init_guard_sym != "" {
        if !g.target_wasm {
          qbe_emit(g, "call " + extern_init_sym + "()")
        } else {
          let t_done = qbe_tmp(g)
          let l_do = qbe_lbl(g, "ex_init")
          let l_ok = qbe_lbl(g, "ex_ready")
          qbe_emit(g, t_done + " =w loaduw " + extern_init_guard_sym)
          qbe_emit_term(g, "jnz " + t_done + ", " + l_ok + ", " + l_do)
          qbe_emit_lbl(g, l_do)
          qbe_emit(g, "call " + extern_init_sym + "()")
          qbe_emit_term(g, "jmp " + l_ok)
          qbe_emit_lbl(g, l_ok)
        }
      } else if extern_init_unit_syms.length() > 0 {
        if !g.target_wasm {
          let mut ui = 0
          while ui < extern_init_unit_syms.length() {
            qbe_emit(g, "call " + extern_init_unit_syms[ui] + "()")
            ui = ui + 1
          }
        } else if extern_init_unit_guard != "" {
          let t_done = qbe_tmp(g)
          let l_do = qbe_lbl(g, "ex_uinit")
          let l_ok = qbe_lbl(g, "ex_uready")
          qbe_emit(g, t_done + " =w loaduw " + extern_init_unit_guard)
          qbe_emit_term(g, "jnz " + t_done + ", " + l_ok + ", " + l_do)
          qbe_emit_lbl(g, l_do)
          qbe_emit(g, "storew 1, " + extern_init_unit_guard)
          let mut ui = 0
          while ui < extern_init_unit_syms.length() {
            qbe_emit(g, "call " + extern_init_unit_syms[ui] + "()")
            ui = ui + 1
          }
          qbe_emit_term(g, "jmp " + l_ok)
          qbe_emit_lbl(g, l_ok)
        }
      }
      let bres = qbe_emit_stmts(g, body, Some(einfo.ret_ty))
      if !g.block_term {
        if is_unit {
          qbe_rc_dec(g, bres.reg, bres.ty)
          if g.fn_cleanup_pads.length() > 0 &&
            qbe_try_emit_shared_cleanup_exit(g, "") {
            qbe_scope_pop_meta_only(g)
          } else {
            qbe_scope_pop(g)
            qbe_emit_term(g, "ret")
          }
        } else {
          let ret_reg = qbe_coerce_val(g, bres, ret_abi_ty)
          if g.fn_cleanup_pads.length() > 0 &&
            qbe_try_emit_shared_cleanup_exit(g, ret_reg) {
            qbe_scope_pop_meta_only(g)
          } else {
            qbe_scope_pop(g)
            qbe_emit_term(g, "ret " + ret_reg)
          }
        }
      } else {
        let _ = g.scopes.pop()
      }
      qbe_fn_cleanup_flush(g)

      let out = StringBuilder()
      out.write_string("export function ")
      if !is_unit {
        out.write_string(c_ret_abi)
        out.write_string(" ")
      }
      out.write_string("$")
      out.write_string(ed.c_symbol)
      out.write_string("(")
      pi = 0
      while pi < ed.params.length() {
        if pi > 0 {
          out.write_string(", ")
        }
        let p_abi = if pi < einfo.param_tys.length() {
          qbe_c_abi_ty(einfo.param_tys[pi])
        } else {
          "l"
        }
        out.write_string(p_abi)
        out.write_string(" %p")
        out.write_string(pi.to_string())
        pi = pi + 1
      }
      out.write_string(") {\n@start\n")
      out.write_string(g.fn_allocs.to_string())
      out.write_string(g.fn_body.to_string())
      out.write_string("}\n\n")
      out.to_string()
    }
  }
}

///|
fn qbe_emit_impl_method(g : QbeGen, id : ImplDecl, md : FnDecl) -> String {
  if id.type_params.length() > 0 {
    return ""
  }
  let c_trait = canon_trait_name(g.tc, id.trait_name)
  let c_target = canon_target_type_name(g.tc, id.target_type)
  let impl_key = c_trait + "::" + c_target
  match g.tc.impls.get(impl_key) {
    None => ""
    Some(iinfo) =>
      match iinfo.methods.get(md.name) {
        None => ""
        Some(finfo) => {
          g.fn_allocs = StringBuilder()
          g.fn_body = StringBuilder()
          g.fn_start_tmp = g.next_tmp
          g.fn_start_lbl = g.next_lbl
          g.fn_inlined_cost = 0
          qbe_fn_cleanup_begin(g, true)
          g.scopes = []
          g.loop_breaks = []
          g.loop_conts = []
          g.loop_depths = []
          g.hot_loop_depth = 0
          g.cur_tparams = []
          g.live_tparams = []
          g.cur_type_subst = Map([])
          g.lexical_type_subst = Map([])
          g.cur_ret_ty = finfo.ret_ty
          g.cur_ret_abi_ty = finfo.ret_ty
          g.cur_fn_void = false
          g.block_term = false
          g.hoisted_arr_len = Map([])
          g.hoisted_arr_dp = Map([])
          g.hoisted_str_len = Map([])
          g.hoisted_str_dp = Map([])
          g.hoisted_bytes_len = Map([])
          g.hoisted_bytes_dp = Map([])
          g.inline_closures = Map([])
          g.inline_ret_lbl = ""
          g.inline_ret_tag_slot = ""
          g.inline_ret_err_slot = ""
          g.inline_ret_pod_buf = false
          qbe_reset_tco(g)
          g.hoisted_fields = Map([])
          g.block_immut_fields = Map([])
          g.len_aliases = Map([])
          g.len_alias_keys = []
          g.nonneg_vars = Map([])
          g.u8_range_vars = Map([])
          g.known_min_len_arrs = Map([])
          g.known_writable_bytes = Map([])
          g.bce_safe_indices = Map([])
          g.bce_safe_exprs = Map([])
          g.bce_safe_push_arrs = Map([])
          g.movable_locals = Map([])
          g.moved_slots = Map([])
          g.zeroed_slots = Map([])
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
          g.pinned_slots = Map([])
          g.borrow_owner_slot = Map([])
          g.borrow_owner_name = Map([])
          g.mut_local_slots = Map([])
          g.sq_reuse_slot = Map([])
          g.sq_reuse_state = Map([])
          g.promoted_fields = Map([])
          g.promoted_field_tys = Map([])
          g.promoted_push_len = Map([])
          g.promoted_push_cap = Map([])
          g.promoted_push_dp = Map([])
          g.w_to_l_ext = Map([])
          g.local_w_to_l_ext = Map([])
          g.unfrozen_local_arrs = Map([])
          let body = qbe_fn_body(g, md.body)
          g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)
          g.in_verify = md.is_verify

          qbe_scope_push(g)
          qbe_define_fn_params(g, md.params, finfo.param_tys)
          let bres = qbe_emit_stmts(g, body, Some(finfo.ret_ty))
          if !g.block_term {
            let ret_reg = qbe_coerce_val(g, bres, finfo.ret_ty)
            if g.fn_cleanup_pads.length() > 0 &&
              qbe_try_emit_shared_cleanup_exit(g, ret_reg) {
              qbe_scope_pop_meta_only(g)
            } else {
              qbe_scope_pop(g)
              qbe_emit_term(g, "ret " + ret_reg)
            }
          } else {
            let _ = g.scopes.pop()
          }
          qbe_fn_cleanup_flush(g)
          g.in_verify = false

          let out = StringBuilder()
          let sym = qbe_impl_method_sym(
            g,
            iinfo.pkg_name,
            iinfo.trait_name,
            iinfo.target_type,
            md.name,
          )
          if g.tc.multi_pkg || g.unit_mode {
            out.write_string("export ")
          }
          out.write_string("function ")
          out.write_string(qbe_abi_ty(finfo.ret_ty))
          out.write_string(" ")
          out.write_string(sym)
          out.write_string("(")
          let mut pi = 0
          while pi < md.params.length() {
            if pi > 0 {
              out.write_string(", ")
            }
            let p_abi = qbe_param_abi(md.params, finfo.param_tys, pi)
            out.write_string(p_abi)
            out.write_string(" %p")
            out.write_string(pi.to_string())
            pi = pi + 1
          }
          out.write_string(") {\n@start\n")
          out.write_string(g.fn_allocs.to_string())
          out.write_string(g.fn_body.to_string())
          out.write_string("}\n\n")
          out.to_string()
        }
      }
  }
}

///|
fn qbe_emit_mono_fn(g : QbeGen, req : QbeMonoReq) -> String {
  let fd = req.finfo.decl
  let saved_mono_pkg = g.mono_pkg
  g.mono_pkg = qbe_norm_mono_pkg(g, req.pkg)
  let concrete_ptys : Array[Ty] = []
  let mut pi = 0
  while pi < req.finfo.param_tys.length() {
    concrete_ptys.push(subst_ty(req.finfo.param_tys[pi], req.subst))
    pi = pi + 1
  }
  let concrete_ret = subst_ty(req.finfo.ret_ty, req.subst)

  g.fn_allocs = StringBuilder()
  g.fn_body = StringBuilder()
  g.fn_start_tmp = g.next_tmp
  g.fn_start_lbl = g.next_lbl
  g.fn_inlined_cost = 0
  qbe_fn_cleanup_begin(g, true)
  g.scopes = []
  g.lookup_scope_floor = 0
  g.loop_breaks = []
  g.loop_conts = []
  g.loop_depths = []
  g.hot_loop_depth = 0
  g.cur_tparams = fd.type_params
  g.live_tparams = []
  g.cur_type_subst = req.subst
  g.lexical_type_subst = req.subst
  g.cur_ret_ty = concrete_ret
  g.cur_ret_abi_ty = concrete_ret
  g.cur_fn_void = false
  g.block_term = false
  qbe_reset_tco(g)
  g.hoisted_arr_len = Map([])
  g.hoisted_arr_dp = Map([])
  g.hoisted_str_len = Map([])
  g.hoisted_str_dp = Map([])
  g.hoisted_bytes_len = Map([])
  g.hoisted_bytes_dp = Map([])
  g.inline_closures = Map([])
  g.inline_ret_lbl = ""
  g.inline_ret_tag_slot = ""
  g.inline_ret_err_slot = ""
  g.inline_ret_pod_buf = false
  g.hoisted_fields = Map([])
  g.block_immut_fields = Map([])
  g.len_aliases = Map([])
  g.len_alias_keys = []
  g.nonneg_vars = Map([])
  g.u8_range_vars = Map([])
  g.known_min_len_arrs = Map([])
  g.known_writable_bytes = Map([])
  g.bce_safe_indices = Map([])
  g.bce_safe_exprs = Map([])
  g.bce_safe_push_arrs = Map([])
  g.movable_locals = Map([])
  g.moved_slots = Map([])
  g.zeroed_slots = Map([])
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
  g.pinned_slots = Map([])
  g.borrow_owner_slot = Map([])
  g.borrow_owner_name = Map([])
  g.mut_local_slots = Map([])
  g.sq_reuse_slot = Map([])
  g.sq_reuse_state = Map([])
  g.promoted_fields = Map([])
  g.promoted_field_tys = Map([])
  g.promoted_push_len = Map([])
  g.promoted_push_cap = Map([])
  g.promoted_push_dp = Map([])
  g.w_to_l_ext = Map([])
  g.local_w_to_l_ext = Map([])
  g.unfrozen_local_arrs = Map([])
  let body = qbe_fn_body(g, fd.body)
  g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)
  g.in_verify = fd.is_verify

  qbe_scope_push(g)
  qbe_define_fn_params(g, fd.params, concrete_ptys)
  let bres = qbe_emit_stmts(g, body, Some(concrete_ret))
  if !g.block_term {
    let ret_reg = qbe_coerce_val(g, bres, concrete_ret)
    if g.fn_cleanup_pads.length() > 0 &&
      qbe_try_emit_shared_cleanup_exit(g, ret_reg) {
      qbe_scope_pop_meta_only(g)
    } else {
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret " + ret_reg)
    }
  } else {
    let _ = g.scopes.pop()
  }
  qbe_fn_cleanup_flush(g)
  g.in_verify = false
  g.cur_type_subst = Map([])
  g.lexical_type_subst = Map([])
  g.cur_tparams = []
  g.live_tparams = []
  g.mono_pkg = saved_mono_pkg

  let out = StringBuilder()
  out.write_string("function ")
  out.write_string(qbe_abi_ty(concrete_ret))
  out.write_string(" ")
  out.write_string(req.sym)
  out.write_string("(")
  pi = 0
  while pi < fd.params.length() {
    if pi > 0 {
      out.write_string(", ")
    }
    let p_abi = qbe_param_abi(fd.params, concrete_ptys, pi)
    out.write_string(p_abi)
    out.write_string(" %p")
    out.write_string(pi.to_string())
    pi = pi + 1
  }
  out.write_string(") {\n@start\n")
  out.write_string(g.fn_allocs.to_string())
  out.write_string(g.fn_body.to_string())
  out.write_string("}\n\n")
  out.to_string()
}

///|
fn qbe_drain_mono_queue(g : QbeGen, out : StringBuilder) -> Unit {
  while g.mono_emitted < g.mono_queue.length() {
    let req = g.mono_queue[g.mono_emitted]
    g.mono_emitted = g.mono_emitted + 1
    out.write_string(qbe_emit_mono_fn(g, req))
  }
}

///|
/// Whether any variant of a non-generic tagged enum has an RC object field.
fn qbe_tagged_enum_has_obj(g : QbeGen, einfo : EnumInfo) -> Bool {
  let mut vi = 0
  while vi < einfo.variants.length() {
    let v = einfo.variants[vi]
    let mut fi = 0
    while fi < v.field_tys.length() {
      if qbe_is_obj_ty(g, v.field_tys[fi]) {
        return true
      }
      fi = fi + 1
    }
    vi = vi + 1
  }
  false
}

///|
fn qbe_emit_enum_drops(g : QbeGen, out : StringBuilder) -> Unit {
  let mut i = 0
  while i < g.enum_order.length() {
    let ename = g.enum_order[i]
    match qbe_lookup_enum_info(g, ename) {
      Some(einfo) => {
        let layout = qbe_enum_layout_for_info(einfo)
        if einfo.decl.type_params.length() == 0 && !layout.is_unit_only {
          // Niche enums drop through `$pion_drop_slots_<key>` and tagged
          // enums without RC fields allocate with a null drop: only tagged
          // enums with at least one RC field keep a per-type drop.
          if !layout.is_niche && qbe_tagged_enum_has_obj(g, einfo) {
            if g.unit_mode && !has_qual_sep(ename) {
              out.write_string("export ")
            }
            out.write_string("function $pion_drop_enum_")
            out.write_string(qbe_mangle_qual_sym(ename))
            out.write_string("(l %p) {\n@start\n")
            out.write_string("    %tag =l loadl %p\n")
            let mut vi = 0
            while vi < einfo.variants.length() {
              let v = einfo.variants[vi]
              let obj_slots : Array[Int] = []
              let mut fi = 0
              while fi < v.field_tys.length() {
                if qbe_is_obj_ty(g, v.field_tys[fi]) {
                  obj_slots.push(fi)
                }
                fi = fi + 1
              }
              if obj_slots.length() > 0 {
                out.write_string("    %c")
                out.write_string(vi.to_string())
                out.write_string(" =w ceql %tag, ")
                out.write_string(vi.to_string())
                out.write_string("\n    jnz %c")
                out.write_string(vi.to_string())
                out.write_string(", @v")
                out.write_string(vi.to_string())
                out.write_string(", @n")
                out.write_string(vi.to_string())
                out.write_string("\n@v")
                out.write_string(vi.to_string())
                out.write_string("\n")
                let mut j = 0
                while j < obj_slots.length() {
                  let off = layout.payload_offset + obj_slots[j] * 8
                  out.write_string("    %a")
                  out.write_string(vi.to_string())
                  out.write_string("_")
                  out.write_string(j.to_string())
                  out.write_string(" =l add %p, ")
                  out.write_string(off.to_string())
                  out.write_string("\n    %v")
                  out.write_string(vi.to_string())
                  out.write_string("_")
                  out.write_string(j.to_string())
                  out.write_string(" =l loadl %a")
                  out.write_string(vi.to_string())
                  out.write_string("_")
                  out.write_string(j.to_string())
                  out.write_string("\n    call $pion_rc_dec(l %v")
                  out.write_string(vi.to_string())
                  out.write_string("_")
                  out.write_string(j.to_string())
                  out.write_string(")\n")
                  j = j + 1
                }
                out.write_string("    ret\n@n")
                out.write_string(vi.to_string())
                out.write_string("\n")
              }
              vi = vi + 1
            }
            out.write_string("    ret\n}\n\n")
          }
        }
      }
      None => ()
    }
    i = i + 1
  }
}

///|
fn qbe_emit_helper_drops(g : QbeGen, out : StringBuilder) -> Unit {
  if g.need_drop_opt_obj {
    out.write_string(
      "function $pion_drop_opt_obj(l %p) {\n@start\n    %tag =l loadl %p\n    %is1 =w ceql %tag, 1\n    jnz %is1, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_res_ok {
    out.write_string(
      "function $pion_drop_res_ok(l %p) {\n@start\n    %tag =l loadl %p\n    %is0 =w ceql %tag, 0\n    jnz %is0, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_res_err {
    out.write_string(
      "function $pion_drop_res_err(l %p) {\n@start\n    %tag =l loadl %p\n    %is1 =w ceql %tag, 1\n    jnz %is1, @dec, @done\n@dec\n    %a =l add %p, 8\n    %v =l loadl %a\n    call $pion_rc_dec(l %v)\n@done\n    ret\n}\n\n",
    )
  }
  if g.need_drop_dyn {
    out.write_string(
      "function $pion_drop_dyn(l %p) {\n@start\n    %vp =l add %p, 8\n    %vt =l loadl %vp\n    %is_obj =l loadl %vt\n    %is_obj_nz =w cnel %is_obj, 0\n    jnz %is_obj_nz, @dec, @done\n@dec\n    %data =l loadl %p\n    call $pion_rc_dec(l %data)\n@done\n    ret\n}\n\n",
    )
  }
  let mut ti = 0
  while ti < g.i32_literal_tables.length() {
    out.write_string(g.i32_literal_tables[ti])
    ti = ti + 1
  }
  let mut dvi = 0
  while dvi < g.dyn_vtables.length() {
    out.write_string(g.dyn_vtables[dvi])
    dvi = dvi + 1
  }
  if g.dyn_vtables.length() > 0 {
    out.write_string("\n")
  }
  let mut i = 0
  while i < g.slot_drop_keys.length() {
    let key = g.slot_drop_keys[i]
    let slots = g.slot_drop_specs[i]
    out.write_string("function $pion_drop_slots_")
    out.write_string(key)
    out.write_string("(l %p) {\n@start\n")
    let mut si = 0
    while si < slots.length() {
      let slot_idx = slots[si]
      let off = slot_idx * 8
      let ss = slot_idx.to_string()
      out.write_string("    %a")
      out.write_string(ss)
      out.write_string(" =l add %p, ")
      out.write_string(off.to_string())
      out.write_string("\n    %v")
      out.write_string(ss)
      out.write_string(" =l loadl %a")
      out.write_string(ss)
      out.write_string("\n    %vnz")
      out.write_string(ss)
      out.write_string(" =w cnel %v")
      out.write_string(ss)
      out.write_string(", 0\n    jnz %vnz")
      out.write_string(ss)
      out.write_string(", @d")
      out.write_string(ss)
      out.write_string(", @n")
      out.write_string(ss)
      out.write_string("\n@d")
      out.write_string(ss)
      out.write_string("\n    call $pion_rc_dec(l %v")
      out.write_string(ss)
      out.write_string(")\n@n")
      out.write_string(ss)
      out.write_string("\n")
      si = si + 1
    }
    out.write_string("    ret\n}\n\n")
    i = i + 1
  }
}

///|
fn qbe_emit_fn_wrappers(g : QbeGen, out : StringBuilder) -> Unit {
  // Closures pass and return every value as `l` (`qbe_as_l` / `qbe_from_l`):
  // each thunk converts to and from the target's own ABI (`qbe_abi_ty`).
  let mut i = 0
  while i < g.fn_wrappers.length() {
    let w = g.fn_wrappers[i]
    out.write_string("function l ")
    out.write_string(w.wrap_sym)
    out.write_string("(l %env")
    let mut pi = 0
    while pi < w.param_tys.length() {
      out.write_string(", l %p")
      out.write_string(pi.to_string())
      pi = pi + 1
    }
    out.write_string(") {\n@start\n")
    pi = 0
    while pi < w.param_tys.length() {
      let ps = pi.to_string()
      let pabi = if w.is_extern_c {
        qbe_c_abi_ty(w.param_tys[pi])
      } else {
        qbe_abi_ty(w.param_tys[pi])
      }
      match pabi {
        "d" => out.write_string("    %ap" + ps + " =d cast %p" + ps + "\n")
        "s" => {
          out.write_string("    %wp" + ps + " =w copy %p" + ps + "\n")
          out.write_string("    %ap" + ps + " =s cast %wp" + ps + "\n")
        }
        "w" => out.write_string("    %ap" + ps + " =w copy %p" + ps + "\n")
        _ => ()
      }
      pi = pi + 1
    }
    let mut fi = 0
    let mut env_i = 0
    while fi < w.tp_flags.length() {
      if w.tp_flags[fi] == "env" {
        env_i = env_i + 1
        let fs = fi.to_string()
        out.write_string("    %tfp" + fs + " =l add %env, " + (env_i * 8).to_string() + "\n")
        out.write_string("    %tf" + fs + " =l loadl %tfp" + fs + "\n")
      }
      fi = fi + 1
    }
    let is_unit_extern = w.is_extern_c && (match w.ret_ty {
      TUnit => true
      _ => false
    })
    let ret_abi = if w.is_extern_c {
      qbe_c_abi_ty(w.ret_ty)
    } else {
      qbe_abi_ty(w.ret_ty)
    }
    if is_unit_extern {
      out.write_string("    call ")
    } else if ret_abi == "l" {
      out.write_string("    %r =l call ")
    } else {
      out.write_string("    %rv =" + ret_abi + " call ")
    }
    out.write_string(w.target_sym)
    out.write_string("(")
    pi = 0
    while pi < w.param_tys.length() {
      if pi > 0 {
        out.write_string(", ")
      }
      let pabi = if w.is_extern_c {
        qbe_c_abi_ty(w.param_tys[pi])
      } else {
        qbe_abi_ty(w.param_tys[pi])
      }
      out.write_string(pabi)
      if pabi == "l" {
        out.write_string(" %p")
      } else {
        out.write_string(" %ap")
      }
      out.write_string(pi.to_string())
      pi = pi + 1
    }
    fi = 0
    while fi < w.tp_flags.length() {
      if pi + fi > 0 {
        out.write_string(", ")
      }
      out.write_string("l ")
      if w.tp_flags[fi] == "env" {
        out.write_string("%tf")
        out.write_string(fi.to_string())
      } else {
        out.write_string(w.tp_flags[fi])
      }
      fi = fi + 1
    }
    out.write_string(")\n")
    if is_unit_extern {
      out.write_string("    ret 0\n}\n\n")
      i = i + 1
      continue
    }
    match ret_abi {
      "d" => out.write_string("    %r =l cast %rv\n")
      "s" => {
        out.write_string("    %rw =w cast %rv\n")
        out.write_string("    %r =l extuw %rw\n")
      }
      "w" =>
        if w.is_extern_c {
          match w.ret_ty {
            TBool | TChar | TUInt => out.write_string("    %r =l extuw %rv\n")
            TByte => out.write_string("    %r =l extub %rv\n")
            TInt8 => out.write_string("    %r =l extsb %rv\n")
            _ => out.write_string("    %r =l extsw %rv\n")
          }
        } else if qbe_is_uint32_ty(w.ret_ty) {
          out.write_string("    %r =l extuw %rv\n")
        } else {
          out.write_string("    %r =l extsw %rv\n")
        }
      _ => ()
    }
    out.write_string("    ret %r\n}\n\n")
    i = i + 1
  }
}

///|
fn build_typechecker_for_codegen(pkg : Package) -> TypeChecker {
  let tc = TypeChecker::{
    pkg_name: pkg.name,
    pkg_root: "",
    pkg_cwd: "",
    multi_pkg: false,
    structs: Map([]),
    struct_names: [],
    enums: Map([]),
    enum_names: [],
    variant_to_enum: Map([]),
    fns: Map([]),
    extern_fns: Map([]),
    extern_fn_names: [],
    methods: Map([]),
    method_names: [],
    traits: Map([]),
    trait_names: [],
    impls: Map([]),
    impl_keys: [],
    consts: Map([]),
    const_pub: Map([]),
    scalar_const_exprs: Map([]),
    const_init_order: [],
    import_aliases: Map([]),
    file_import_aliases: Map([]),
    dep_map: Map([]),
    canon_display_keys: [],
    canon_display_vals: [],
    exported_c_syms: Map([]),
    exported_c_sym_names: [],
    imported_pkgs: Map([]),
    imported_pkg_names: [],
    all_imported_pkgs: Map([]),
    all_imported_pkg_names: [],
    diagnostics: [],
    eq_tparams: Map([]),
    eq_keys: [],
    verify_eq_tparams: Map([]),
    verify_eq_keys: [],
    op_tparams: Map([]),
    op_keys: [],
    map_key_obligations: Map([]),
    map_key_ob_keys: [],
    eq_trait_obligations: Map([]),
    eq_trait_ob_keys: [],
    generic_call_sites: [],
    cur_fn_key: "",
    in_pass3: false,
    expansive_ready: false,
    expansive_defs: Map([]),
    expansive_params: Map([]),
    eq_uses: [],
    resolved_trait_methods: Map([]),
    edit_keys: Map([]),
    let_infer: Map([]),
    shift_rhs_infer: Map([]),
    closure_infer: Map([]),
    dot_variant_resolve: Map([]),
    infer_pending: Map([]),
    infer_hit: [],
    expr_tys: Map([]),
    call_targets: Map([]),
    call_type_args: Map([]),
    call_arg_order: Map([]),
    mut_recv_calls: Map([]),
    record_analyze: false,
    analyze_closure_captures: Map([]),
    call_into_convs: Map([]),
    try_into_convs: Map([]),
    resolved_method_calls: Map([]),
    never_calls: Map([]),
    in_default_arg_expansion: false,
    in_imported_default_arg: false,
    priv_imported_types: Map([]),
    record_types: false,
    qt_filter_mode: 0,
    qt_filter_files: Map([]),
    qt_log_depth: 0,
    qt_write_log: [],
    qt_last_call_key: "",
    qt_last_call_cand: None,
    qt_pending_refs: Map([]),
    qt_last_expr_ty: Map([]),
    qt_expr_tys: Map([]),
    qt_call_infos: Map([]),
    qt_bindings: Map([]),
  }
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: [],
              field_muts: [],
              field_privs: [],
              field_tys: [],
            },
          )
        DEnum(ed) => {
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: [] })
          let mut vi = 0
          while vi < ed.variants.length() {
            tc.variant_to_enum.set(ed.variants[vi].name, ed.name)
            vi = vi + 1
          }
        }
        DTrait(td) => {
          if !tc.traits.contains(td.name) {
            tc.trait_names.push(td.name)
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: [] })
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => {
          let fnames : Array[String] = []
          let fmuts : Array[Bool] = []
          let fprivs : Array[Bool] = []
          let ftys : Array[Ty] = []
          let mut j = 0
          while j < sd.fields.length() {
            let fld = sd.fields[j]
            fnames.push(fld.name)
            fmuts.push(fld.is_mut)
            fprivs.push(fld.is_priv)
            ftys.push(resolve_type_expr(tc, fld.ty, sd.type_params))
            j = j + 1
          }
          tc.structs.set(
            sd.name,
            StructInfo::{
              decl: sd,
              field_names: fnames,
              field_muts: fmuts,
              field_privs: fprivs,
              field_tys: ftys,
            },
          )
        }
        DEnum(ed) => {
          let vinfos : Array[VariantInfo] = []
          let mut vi = 0
          while vi < ed.variants.length() {
            let v = ed.variants[vi]
            let vftys : Array[Ty] = []
            let mut j = 0
            while j < v.fields.length() {
              vftys.push(resolve_type_expr(tc, v.fields[j], ed.type_params))
              j = j + 1
            }
            vinfos.push(VariantInfo::{ name: v.name, field_tys: vftys })
            vi = vi + 1
          }
          tc.enums.set(ed.name, EnumInfo::{ decl: ed, variants: vinfos })
        }
        DFn(fd) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < fd.params.length() {
            ptys.push(resolve_type_expr(tc, fd.params[pi].ty, fd.type_params))
            pi = pi + 1
          }
          let rty = resolve_type_expr(tc, fd.ret_ty, fd.type_params)
          let finfo = FnInfo::{ decl: fd, param_tys: ptys, ret_ty: rty, is_imported: false }
          if fd.receiver_type != "" {
            tc.methods.set(fd.receiver_type + "::" + fd.name, finfo)
          } else {
            tc.fns.set(fd.name, finfo)
          }
        }
        DExternFn(ed) => {
          let ptys : Array[Ty] = []
          let mut pi = 0
          while pi < ed.params.length() {
            ptys.push(resolve_type_expr(tc, ed.params[pi].ty, []))
            pi = pi + 1
          }
          let rty = resolve_type_expr(tc, ed.ret_ty, [])
          tc.extern_fns.set(
            ed.name,
            ExternFnInfo::{ decl: ed, param_tys: ptys, ret_ty: rty },
          )
        }
        DTrait(td) => {
          let tmethods : Array[TraitMethodInfo] = []
          let self_tp : Array[String] = ["Self"]
          let mut mi = 0
          while mi < td.methods.length() {
            let tm = td.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < tm.params.length() {
              ptys.push(resolve_type_expr(tc, tm.params[pi].ty, self_tp))
              pi = pi + 1
            }
            let rty = resolve_type_expr(tc, tm.ret_ty, self_tp)
            tmethods.push(TraitMethodInfo::{
              name: tm.name,
              param_tys: ptys,
              ret_ty: rty,
              span: tm.span,
            })
            mi = mi + 1
          }
          if !tc.traits.contains(td.name) {
            tc.trait_names.push(td.name)
          }
          tc.traits.set(td.name, TraitInfo::{ decl: td, methods: tmethods })
        }
        DImpl(id) => {
          let target_ty = resolve_type_expr(
            tc,
            TyName(id.target_type, [], id.span),
            [],
          )
          let self_subst : Map[String, Ty] = Map([])
          self_subst.set("Self", target_ty)
          let self_tp : Array[String] = ["Self"]
          let impl_methods : Map[String, FnInfo] = Map([])
          let impl_mnames : Array[String] = []
          let mut mi = 0
          while mi < id.methods.length() {
            let md = id.methods[mi]
            let ptys : Array[Ty] = []
            let mut pi = 0
            while pi < md.params.length() {
              let raw_p = resolve_type_expr(tc, md.params[pi].ty, self_tp)
              ptys.push(subst_ty(raw_p, self_subst))
              pi = pi + 1
            }
            let raw_r = resolve_type_expr(tc, md.ret_ty, self_tp)
            let rty = subst_ty(raw_r, self_subst)
            impl_methods.set(
              md.name,
              FnInfo::{ decl: md, param_tys: ptys, ret_ty: rty, is_imported: false },
            )
            impl_mnames.push(md.name)
            mi = mi + 1
          }
          let impl_key = id.trait_name + "::" + id.target_type
          if !tc.impls.contains(impl_key) {
            tc.impl_keys.push(impl_key)
          }
          tc.impls.set(
            impl_key,
            ImplInfo::{
              decl: id,
              pkg_name: pkg.name,
              trait_name: id.trait_name,
              target_type: id.target_type,
              target_param_names: [],
              target_param_bounds: [],
              methods: impl_methods,
              method_names: impl_mnames,
            },
          )
        }
        DConst(cd) => {
          let cty = resolve_type_expr(tc, cd.ty, [])
          tc.consts.set(cd.name, cty)
          tc.const_pub.set(cd.name, cd.is_pub)
        }
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  tc
}

///|
pub fn emit_qbe_package_multi(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
) -> QbeEmitResult {
  emit_qbe_package_multi_for_target(pkg, tc, release, is_entry, dep_pkg_names, false)
}

///|
pub fn emit_qbe_package_multi_for_target(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
  target_wasm : Bool,
) -> QbeEmitResult {
  emit_qbe_package_multi_entry(
    pkg,
    tc,
    release,
    is_entry,
    dep_pkg_names,
    target_wasm,
    "main",
    false,
  )
}

///|
pub fn emit_qbe_package_multi_entry(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
  target_wasm : Bool,
  entry_symbol : String,
  no_main : Bool,
) -> QbeEmitResult {
  emit_qbe_package_multi_entry_target(
    pkg,
    tc,
    release,
    is_entry,
    dep_pkg_names,
    target_wasm,
    if target_wasm { "wasm32" } else { "" },
    entry_symbol,
    no_main,
  )
}

///|
pub fn emit_qbe_package_multi_entry_target(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
  target_wasm : Bool,
  target_name : String,
  entry_symbol : String,
  no_main : Bool,
) -> QbeEmitResult {
  emit_qbe_package_multi_entry_target_opts(
    pkg,
    tc,
    release,
    is_entry,
    dep_pkg_names,
    target_wasm,
    target_name,
    entry_symbol,
    no_main,
    0,
  )
}

///|
pub fn emit_qbe_package_multi_entry_target_opts(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  is_entry : Bool,
  dep_pkg_names : Array[String],
  target_wasm : Bool,
  target_name : String,
  entry_symbol : String,
  no_main : Bool,
  j2_disable_mask : Int,
) -> QbeEmitResult {
  let g = qbe_new_for_target_name(tc, release, false, target_wasm, target_name)
  // Only the entry package exports the entry point (and keys it in the CAS).
  if is_entry && !no_main {
    g.entry_symbol = entry_symbol
  }
  g.j2_disable_mask = j2_disable_mask
  let export_internals = tc.multi_pkg &&
    (pkg_has_pub_generic_fn(pkg) || pkg_has_generic_impl(pkg) || pkg_has_complex_pub_default(pkg))
  g.export_internals = export_internals
  let const_decls : Array[ConstDecl] = []

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(_) => ()
        DEnum(ed) => g.enum_order.push(ed.name)
        DConst(cd) => {
          g.const_order.push(cd.name)
          const_decls.push(cd)
          match tc.consts.get(cd.name) {
            Some(cty) => qbe_record_scalar_const(g, cd, cty)
            None => ()
          }
        }
        DFn(_) | DExternFn(_) | DTrait(_) | DImpl(_) | DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  let init_sym = "$pion_" + g.pkg_prefix + "init_consts"
  let init_guard_sym = "$pion_" + g.pkg_prefix + "consts_inited"
  let has_init = const_decls.length() > 0 || tc.multi_pkg
  let mut init_consts_code = ""
  if has_init {
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.fn_start_tmp = g.next_tmp
    g.fn_start_lbl = g.next_lbl
    g.fn_inlined_cost = 0
    qbe_fn_cleanup_begin(g, false)
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.hot_loop_depth = 0
    g.cur_tparams = []
    g.live_tparams = []
    g.cur_type_subst = Map([])
    g.lexical_type_subst = Map([])
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    g.immortal_regs = Map([])
    g.immortal_slots = Map([])
    g.cur_lbl = if g.target_wasm { "@_ic_run" } else { "@start" }
    qbe_scope_push(g)
    let mut dpi = 0
    while dpi < dep_pkg_names.length() {
      qbe_emit(
        g,
        "call $pion_" + qbe_pkg_prefix_for(dep_pkg_names[dpi], true) + "init_consts()",
      )
      dpi = dpi + 1
    }
    let ordered_consts = qbe_order_const_decls(const_decls, tc.const_init_order)
    let mut ci = 0
    while ci < ordered_consts.length() {
      let cd = ordered_consts[ci]
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, qbe_fn_expr(g, cd.value), Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(g, cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(
        g,
        cv_reg,
        qbe_local_const_sym(g, cd.name),
        cty,
      )
      ci = ci + 1
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret")
    let csb = StringBuilder()
    if !g.target_wasm {
      let body_sym = init_sym + "__body"
      csb.write_string("function ")
      csb.write_string(body_sym)
      csb.write_string("() {\n@start\n")
      csb.write_string(g.fn_allocs.to_string())
      csb.write_string(g.fn_body.to_string())
      csb.write_string("}\n\n")
      if tc.multi_pkg {
        csb.write_string("export ")
      }
      csb.write_string("function ")
      csb.write_string(init_sym)
      csb.write_string("() {\n@start\n    call $pion_once_call(l ")
      csb.write_string(init_guard_sym)
      csb.write_string(", l ")
      csb.write_string(body_sym)
      csb.write_string(")\n    ret\n}\n\n")
    } else {
      if tc.multi_pkg {
        csb.write_string("export ")
      }
      csb.write_string("function ")
      csb.write_string(init_sym)
      csb.write_string("() {\n@start\n")
      csb.write_string(g.fn_allocs.to_string())
      csb.write_string("    %_ic_done =w loaduw ")
      csb.write_string(init_guard_sym)
      csb.write_string("\n    jnz %_ic_done, @_ic_ret, @_ic_run\n@_ic_run\n    storew 1, ")
      csb.write_string(init_guard_sym)
      csb.write_string("\n")
      csb.write_string(g.fn_body.to_string())
      csb.write_string("@_ic_ret\n    ret\n}\n\n")
    }
    init_consts_code = csb.to_string()
  }

  let ext_init_sym = if has_init { init_sym } else { "" }
  let ext_guard_sym = if has_init { init_guard_sym } else { "" }
  let fns_buf = StringBuilder()
  qbe_collect_pkg_inline_fns(g, pkg, -1)
  fi = 0
  while fi < pkg.files.length() {
    g.cur_file_idx = fi
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
        DExternFn(ed) =>
          if ed.has_body {
            fns_buf.write_string(
              qbe_emit_extern_fn_decl(g, ed, ext_init_sym, ext_guard_sym, [], ""),
            )
          }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
            mi = mi + 1
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "section \".rodata\" data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("section \".rodata\" data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    if ec.omit_tag {
      out.write_string(ec.payload_val.to_string())
    } else {
      out.write_string(ec.tag.to_string())
      if ec.has_payload {
        out.write_string(", l ")
        out.write_string(ec.payload_val.to_string())
      }
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("section \".rodata\" data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    qbe_emit_bytes_data(out, bytes)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("section \".rodata\" data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    qbe_emit_bytes_data(out, str_to_utf8_ints(g.cstrings[csi]))
    out.write_string(" }\n")
    csi = csi + 1
  }

  if has_init {
    out.write_string("data ")
    out.write_string(init_guard_sym)
    out.write_string(" = align 4 { z 4 }\n")
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    let cname = g.const_order[kci]
    let is_pub_c = match tc.const_pub.get(cname) {
      Some(b) => b
      None => false
    }
    if tc.multi_pkg && (is_pub_c || export_internals) {
      out.write_string("export ")
    }
    out.write_string("data ")
    out.write_string(qbe_local_const_sym(g, cname))
    out.write_string(" = align 8 { z 8 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  out.write_string(fns_buf.to_string())

  let mut has_main = false
  if is_entry && !no_main {
    match tc.fns.get("main") {
      Some(minfo) => {
        has_main = true
        let main_export = if entry_symbol.length() > 0 { entry_symbol } else { "main" }
        out.write_string("export function w $")
        out.write_string(main_export)
        out.write_string("(w %argc, l %argv) {\n@start\n")
        out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
        let mut dpi = 0
        while dpi < dep_pkg_names.length() {
          out.write_string("    call $pion_")
          out.write_string(qbe_pkg_prefix_for(dep_pkg_names[dpi], true))
          out.write_string("init_consts()\n")
          dpi = dpi + 1
        }
        if const_decls.length() > 0 || tc.multi_pkg {
          out.write_string("    call ")
          out.write_string(init_sym)
          out.write_string("()\n")
        }
        let ret_abi = qbe_abi_ty(minfo.ret_ty)
        let main_fn_sym = qbe_local_fn_sym(g, "main")
        if minfo.param_tys.length() >= 1 {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call ")
          out.write_string(main_fn_sym)
          out.write_string("(l %w)\n")
        } else {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call ")
          out.write_string(main_fn_sym)
          out.write_string("()\n")
        }
        out.write_string("    call $pion_rc_dec(l %w)\n")
        match minfo.ret_ty {
          TInt => out.write_string("    ret %r\n")
          TInt64 => {
            out.write_string("    %rw =w copy %r\n")
            out.write_string("    ret %rw\n")
          }
          _ => out.write_string("    ret 0\n")
        }
        out.write_string("}\n")
      }
      None => ()
    }
  }

  QbeEmitResult::{ ssa: out.to_string(), has_main: has_main }
}

///|
fn qbe_order_const_decls(
  const_decls : Array[ConstDecl],
  order : Array[String],
) -> Array[ConstDecl] {
  if order.length() == 0 || const_decls.length() <= 1 {
    return const_decls
  }
  let by_name : Map[String, ConstDecl] = Map([])
  let mut i = 0
  while i < const_decls.length() {
    by_name.set(const_decls[i].name, const_decls[i])
    i = i + 1
  }
  let out : Array[ConstDecl] = []
  let emitted : Map[String, Bool] = Map([])
  i = 0
  while i < order.length() {
    let cname = order[i]
    match by_name.get(cname) {
      Some(cd) =>
        if !emitted.contains(cname) {
          emitted.set(cname, true)
          out.push(cd)
        }
      None => ()
    }
    i = i + 1
  }
  i = 0
  while i < const_decls.length() {
    let cd = const_decls[i]
    if !emitted.contains(cd.name) {
      emitted.set(cd.name, true)
      out.push(cd)
    }
    i = i + 1
  }
  out
}

///|
pub fn emit_qbe_package_with_tc(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
) -> QbeEmitResult {
  emit_qbe_package_multi(pkg, tc, release, true, [])
}

///|
pub fn emit_qbe_package_with_tc_target(
  pkg : Package,
  tc : TypeChecker,
  release : Bool,
  target_name : String,
) -> QbeEmitResult {
  emit_qbe_package_multi_entry_target(
    pkg,
    tc,
    release,
    true,
    [],
    target_name == "wasm32",
    target_name,
    "main",
    false,
  )
}

///|
pub fn emit_qbe_package(pkg : Package, release : Bool) -> QbeEmitResult {
  let tc = build_typechecker_for_codegen(pkg)
  emit_qbe_package_with_tc(pkg, tc, release)
}

///|
pub struct PreparedPackage {
  pkg : Package
  tc : TypeChecker
  sig : String
  sigs_hash : String
  const_units : Array[Int]
  const_init_order : Array[String]
  has_main : Bool
}

///|
pub fn cli_prepare_qbe_units(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[PreparedPackage, String] {
  let plans : Array[ConstInitPlan] = []
  let checked = check_source_files_with_imports_mapped_plan(
    pkg_name,
    paths,
    sources,
    [],
    [],
    [],
    false,
    false,
    Some(plans),
  )
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let pkg = checked.pkg
  let tc = checked.tc
  let sig_text = emit_pionsig(pkg)
  let all_sigs = emit_all_sigs(pkg)
  let const_units : Array[Int] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut has_const = false
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DConst(_) => {
          has_const = true
          break
        }
        _ => ()
      }
      di = di + 1
    }
    if has_const {
      const_units.push(fi)
    }
    fi = fi + 1
  }
  let sig_sb = StringBuilder()
  sig_sb.write_string(all_sigs)
  sig_sb.write_string("const_units:")
  let mut ci = 0
  while ci < const_units.length() {
    if ci > 0 {
      sig_sb.write_string(",")
    }
    sig_sb.write_string(const_units[ci].to_string())
    ci = ci + 1
  }
  sig_sb.write_string("\n")
  // Full package checking already computed this resolved plan (for E_CONST_CYCLE)
  // from the same `pkg`/`tc`; reuse it instead of re-emitting every file summary.
  let plan = if plans.length() > 0 {
    plans[0]
  } else {
    compute_const_init_plan_from_pkg_tc(pkg, tc)
  }
  if plan.order.length() > 0 || plan.has_cycle {
    sig_sb.write_string("const_init:")
    sig_sb.write_string(plan.plan_hash)
    sig_sb.write_string("\n")
  }
  let sigs_hash = cas_sha256_hex(sig_sb.to_string())
  let has_main = tc.fns.contains("main")
  Ok(PreparedPackage::{
    pkg: pkg,
    tc: tc,
    sig: sig_text,
    sigs_hash: sigs_hash,
    const_units: const_units,
    const_init_order: plan.order,
    has_main: has_main,
  })
}

///|
/// Selective incremental preparation: `files` contains full ASTs for dirty units
/// and lightweight stub ASTs for cached units; type-checking Pass 3 runs only on
/// units where `check_file[i] == true`.
pub fn cli_prepare_qbe_units_selective(
  pkg_name : String,
  files : Array[SourceFile],
  check_file : Array[Bool],
  sigs_hash : String,
  const_units : Array[Int],
  const_init_order : Array[String],
) -> Result[PreparedPackage, String] {
  let pkg = Package::{ name: pkg_name, files: files }
  let checked = check_package_selective(pkg, check_file)
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let tc = checked.tc
  let has_main = tc.fns.contains("main")
  Ok(PreparedPackage::{
    pkg: pkg,
    tc: tc,
    sig: "",
    sigs_hash: sigs_hash,
    const_units: const_units,
    const_init_order: const_init_order,
    has_main: has_main,
  })
}

///|
pub fn emit_qbe_unit(
  prep : PreparedPackage,
  unit_idx : Int,
  release : Bool,
) -> String {
  emit_qbe_unit_entry(prep, unit_idx, release, "main", false)
}

///|
pub fn emit_qbe_unit_entry(
  prep : PreparedPackage,
  unit_idx : Int,
  release : Bool,
  entry_symbol : String,
  no_main : Bool,
) -> String {
  emit_qbe_unit_entry_target(prep, unit_idx, release, "", entry_symbol, no_main)
}

///|
pub fn emit_qbe_unit_entry_target(
  prep : PreparedPackage,
  unit_idx : Int,
  release : Bool,
  target_name : String,
  entry_symbol : String,
  no_main : Bool,
) -> String {
  emit_qbe_unit_entry_target_opts(
    prep,
    unit_idx,
    release,
    target_name,
    entry_symbol,
    no_main,
    0,
  )
}

///|
pub fn emit_qbe_unit_entry_target_opts(
  prep : PreparedPackage,
  unit_idx : Int,
  release : Bool,
  target_name : String,
  entry_symbol : String,
  no_main : Bool,
  j2_disable_mask : Int,
) -> String {
  let tc = prep.tc
  let g = qbe_new_for_target_name(tc, release, true, target_name == "wasm32", target_name)
  g.j2_disable_mask = j2_disable_mask
  let f = prep.pkg.files[unit_idx]
  let const_decls : Array[ConstDecl] = []
  let mut unit_has_main = false
  let mut unit_has_extern_body = false

  let mut di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DStruct(_) => ()
      DEnum(ed) => g.enum_order.push(ed.name)
      DConst(cd) => {
        g.const_order.push(cd.name)
        const_decls.push(cd)
        match tc.consts.get(cd.name) {
          Some(cty) => qbe_record_scalar_const(g, cd, cty)
          None => ()
        }
      }
      DFn(fd) =>
        if fd.receiver_type == "" && fd.name == "main" {
          unit_has_main = true
        }
      DExternFn(ed) =>
        if ed.has_body {
          unit_has_extern_body = true
        }
      DTrait(_) | DImpl(_) | DTest(_) => ()
    }
    di = di + 1
  }
  // Only the unit defining `main` exports the entry point; set before any
  // function (and so any word table) is emitted.
  if unit_has_main && !no_main {
    g.entry_symbol = entry_symbol
  }

  let mut init_consts_code = ""
  if const_decls.length() > 0 {
    let csb = StringBuilder()
    let mut ci = 0
    while ci < const_decls.length() {
      let cd = const_decls[ci]
      g.fn_allocs = StringBuilder()
      g.fn_body = StringBuilder()
      g.fn_start_tmp = g.next_tmp
      g.fn_start_lbl = g.next_lbl
      g.fn_inlined_cost = 0
      qbe_fn_cleanup_begin(g, false)
      g.scopes = []
      g.loop_breaks = []
      g.loop_conts = []
      g.loop_depths = []
      g.hot_loop_depth = 0
      g.cur_tparams = []
      g.live_tparams = []
      g.cur_type_subst = Map([])
      g.lexical_type_subst = Map([])
      g.cur_ret_ty = TUnit
      g.cur_ret_abi_ty = TUnit
      g.cur_fn_void = true
      g.block_term = false
      g.immortal_regs = Map([])
      g.immortal_slots = Map([])
      g.cur_lbl = "@start"
      qbe_scope_push(g)
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, qbe_fn_expr(g, cd.value), Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(g, cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(g, cv_reg, "$pion_const_" + cd.name, cty)
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret")
      csb.write_string("export function $pion_init_const_")
      csb.write_string(cd.name)
      csb.write_string("() {\n@start\n")
      csb.write_string(g.fn_allocs.to_string())
      csb.write_string(g.fn_body.to_string())
      csb.write_string("}\n\n")
      ci = ci + 1
    }
    init_consts_code = csb.to_string()
  }

  let pkg_unit_init_all_sym = "$pion_unit_init_all_" + qbe_mangle_pkg_sym(prep.pkg.name)
  let pkg_unit_init_all_guard = pkg_unit_init_all_sym + "_guard"
  let pkg_unit_init_all_body = pkg_unit_init_all_sym + "__body"
  let emit_pkg_unit_init_all = prep.const_units.length() > 0 &&
    unit_idx == prep.const_units[0]

  let ext_unit_syms : Array[String] = []
  let need_ext_unit_guard = unit_has_extern_body && prep.const_units.length() > 0
  let ext_unit_guard_sym = if need_ext_unit_guard {
    ext_unit_syms.push(pkg_unit_init_all_sym)
    "$pion_unit_init_done_" + unit_idx.to_string()
  } else {
    ""
  }

  qbe_collect_pkg_inline_fns(g, prep.pkg, unit_idx)
  g.cur_file_idx = unit_idx
  let fns_buf = StringBuilder()
  di = 0
  while di < f.decls.length() {
    match f.decls[di] {
      DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
      DExternFn(ed) =>
        if ed.has_body {
          fns_buf.write_string(
            qbe_emit_extern_fn_decl(g, ed, "", "", ext_unit_syms, ext_unit_guard_sym),
          )
        }
      DImpl(id) => {
        let mut mi = 0
        while mi < id.methods.length() {
          fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
          mi = mi + 1
        }
      }
      _ => ()
    }
    di = di + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE unit backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "section \".rodata\" data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("section \".rodata\" data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    if ec.omit_tag {
      out.write_string(ec.payload_val.to_string())
    } else {
      out.write_string(ec.tag.to_string())
      if ec.has_payload {
        out.write_string(", l ")
        out.write_string(ec.payload_val.to_string())
      }
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("section \".rodata\" data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    qbe_emit_bytes_data(out, bytes)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("section \".rodata\" data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    qbe_emit_bytes_data(out, str_to_utf8_ints(g.cstrings[csi]))
    out.write_string(" }\n")
    csi = csi + 1
  }

  if emit_pkg_unit_init_all {
    out.write_string("data ")
    out.write_string(pkg_unit_init_all_guard)
    out.write_string(" = align 4 { z 4 }\n")
  }
  if need_ext_unit_guard && g.target_wasm {
    out.write_string("data ")
    out.write_string(ext_unit_guard_sym)
    out.write_string(" = align 4 { z 4 }\n")
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    out.write_string("export data $pion_const_")
    out.write_string(g.const_order[kci])
    out.write_string(" = align 8 { z 8 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  if emit_pkg_unit_init_all {
    if !g.target_wasm {
      out.write_string("function ")
      out.write_string(pkg_unit_init_all_body)
      out.write_string("() {\n@start\n")
      let mut ci = 0
      while ci < prep.const_init_order.length() {
        out.write_string("    call $pion_init_const_")
        out.write_string(prep.const_init_order[ci])
        out.write_string("()\n")
        ci = ci + 1
      }
      out.write_string("    ret\n}\n\nexport function ")
      out.write_string(pkg_unit_init_all_sym)
      out.write_string("() {\n@start\n    call $pion_once_call(l ")
      out.write_string(pkg_unit_init_all_guard)
      out.write_string(", l ")
      out.write_string(pkg_unit_init_all_body)
      out.write_string(")\n    ret\n}\n\n")
    } else {
      out.write_string("export function ")
      out.write_string(pkg_unit_init_all_sym)
      out.write_string("() {\n@start\n    %_ic_done =w loaduw ")
      out.write_string(pkg_unit_init_all_guard)
      out.write_string("\n    jnz %_ic_done, @_ic_ret, @_ic_run\n@_ic_run\n    storew 1, ")
      out.write_string(pkg_unit_init_all_guard)
      out.write_string("\n")
      let mut ci = 0
      while ci < prep.const_init_order.length() {
        out.write_string("    call $pion_init_const_")
        out.write_string(prep.const_init_order[ci])
        out.write_string("()\n")
        ci = ci + 1
      }
      out.write_string("@_ic_ret\n    ret\n}\n\n")
    }
  }
  out.write_string(fns_buf.to_string())

  if unit_has_main && !no_main {
    match tc.fns.get("main") {
      Some(minfo) => {
        let main_export = if entry_symbol.length() > 0 { entry_symbol } else { "main" }
        out.write_string("export function w $")
        out.write_string(main_export)
        out.write_string("(w %argc, l %argv) {\n@start\n")
        out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
        if prep.const_units.length() > 0 {
          out.write_string("    call ")
          out.write_string(pkg_unit_init_all_sym)
          out.write_string("()\n")
        }
        let ret_abi = qbe_abi_ty(minfo.ret_ty)
        if minfo.param_tys.length() >= 1 {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call $pion_fn_main(l %w)\n")
        } else {
          out.write_string("    %r =")
          out.write_string(ret_abi)
          out.write_string(" call $pion_fn_main()\n")
        }
        out.write_string("    call $pion_rc_dec(l %w)\n")
        match minfo.ret_ty {
          TInt => out.write_string("    ret %r\n")
          TInt64 => {
            out.write_string("    %rw =w copy %r\n")
            out.write_string("    ret %rw\n")
          }
          _ => out.write_string("    ret 0\n")
        }
        out.write_string("}\n")
      }
      None => ()
    }
  }

  out.to_string()
}

///|
pub fn cli_compile_qbe(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  release : Bool,
) -> Result[CompileQbeOut, String] {
  cli_compile_qbe_for_target(pkg_name, paths, sources, release, false)
}

///|
pub fn cli_compile_qbe_for_target(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  release : Bool,
  target_wasm : Bool,
) -> Result[CompileQbeOut, String] {
  cli_compile_qbe_entry(pkg_name, paths, sources, release, target_wasm, "main", false)
}

///|
pub fn cli_compile_qbe_entry(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  release : Bool,
  target_wasm : Bool,
  entry_symbol : String,
  no_main : Bool,
) -> Result[CompileQbeOut, String] {
  cli_compile_qbe_entry_opts(
    pkg_name,
    paths,
    sources,
    release,
    target_wasm,
    entry_symbol,
    no_main,
    0,
  )
}

///|
pub fn cli_compile_qbe_entry_opts(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
  release : Bool,
  target_wasm : Bool,
  entry_symbol : String,
  no_main : Bool,
  j2_disable_mask : Int,
  native_target~ : String = "",
) -> Result[CompileQbeOut, String] {
  let checked = check_source_files_full(pkg_name, paths, sources)
  if checked.diagnostics.length() > 0 {
    return Err(check_result_to_json(checked.diagnostics))
  }
  let sig_text = emit_pionsig(checked.pkg)
  let res = emit_qbe_package_multi_entry_target_opts(
    checked.pkg,
    checked.tc,
    release,
    true,
    [],
    target_wasm,
    native_target,
    entry_symbol,
    no_main,
    j2_disable_mask,
  )
  Ok(CompileQbeOut::{ sig: sig_text, ssa: res.ssa, has_main: res.has_main })
}

///|
pub struct QbeTestEmitResult {
  ssa : String
  test_names : Array[String]
}

///|
pub fn qbe_test_emit_empty() -> QbeTestEmitResult {
  QbeTestEmitResult::{ ssa: "", test_names: [] }
}

///|
pub fn emit_qbe_test_package(
  pkg : Package,
  tc : TypeChecker,
  dep_pkg_names : Array[String],
) -> QbeTestEmitResult {
  emit_qbe_test_package_target(pkg, tc, dep_pkg_names, "")
}

///|
pub fn emit_qbe_test_package_target(
  pkg : Package,
  tc : TypeChecker,
  dep_pkg_names : Array[String],
  target_name : String,
) -> QbeTestEmitResult {
  let g = qbe_new_for_target_name(tc, false, false, target_name == "wasm32", target_name)
  let const_decls : Array[ConstDecl] = []
  let test_decls : Array[TestDecl] = []
  let test_names : Array[String] = []

  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(_) => ()
        DEnum(ed) => g.enum_order.push(ed.name)
        DConst(cd) => {
          g.const_order.push(cd.name)
          const_decls.push(cd)
          match tc.consts.get(cd.name) {
            Some(cty) => qbe_record_scalar_const(g, cd, cty)
            None => ()
          }
        }
        DTest(td) => {
          test_decls.push(td)
          test_names.push(td.name)
        }
        DFn(_) | DExternFn(_) | DTrait(_) | DImpl(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }

  let init_sym = "$pion_" + g.pkg_prefix + "init_consts"
  let init_guard_sym = "$pion_" + g.pkg_prefix + "consts_inited"
  let has_init = const_decls.length() > 0 || tc.multi_pkg
  let mut init_consts_code = ""
  if has_init {
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.fn_start_tmp = g.next_tmp
    g.fn_start_lbl = g.next_lbl
    g.fn_inlined_cost = 0
    qbe_fn_cleanup_begin(g, false)
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.hot_loop_depth = 0
    g.cur_tparams = []
    g.live_tparams = []
    g.cur_type_subst = Map([])
    g.lexical_type_subst = Map([])
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    g.immortal_regs = Map([])
    g.immortal_slots = Map([])
    g.cur_lbl = if g.target_wasm { "@_ic_run" } else { "@start" }
    qbe_scope_push(g)
    let mut dpi = 0
    while dpi < dep_pkg_names.length() {
      qbe_emit(
        g,
        "call $pion_" + qbe_pkg_prefix_for(dep_pkg_names[dpi], true) + "init_consts()",
      )
      dpi = dpi + 1
    }
    let ordered_consts = qbe_order_const_decls(const_decls, tc.const_init_order)
    let mut ci = 0
    while ci < ordered_consts.length() {
      let cd = ordered_consts[ci]
      let cty = match tc.consts.get(cd.name) {
        Some(t) => t
        None => TError
      }
      let cv = qbe_emit_expr(g, qbe_fn_expr(g, cd.value), Some(cty))
      let cv_reg = qbe_coerce_val(g, cv, cty)
      if qbe_is_obj_ty(g, cty) {
        qbe_emit(g, "call $pion_rc_immortalize(l " + cv_reg + ")")
      }
      qbe_store_heap_slot(
        g,
        cv_reg,
        qbe_local_const_sym(g, cd.name),
        cty,
      )
      ci = ci + 1
    }
    qbe_scope_pop(g)
    qbe_emit_term(g, "ret")
    let csb = StringBuilder()
    if !g.target_wasm {
      let body_sym = init_sym + "__body"
      csb.write_string("function ")
      csb.write_string(body_sym)
      csb.write_string("() {\n@start\n")
      csb.write_string(g.fn_allocs.to_string())
      csb.write_string(g.fn_body.to_string())
      csb.write_string("}\n\nfunction ")
      csb.write_string(init_sym)
      csb.write_string("() {\n@start\n    call $pion_once_call(l ")
      csb.write_string(init_guard_sym)
      csb.write_string(", l ")
      csb.write_string(body_sym)
      csb.write_string(")\n    ret\n}\n\n")
    } else {
      csb.write_string("function ")
      csb.write_string(init_sym)
      csb.write_string("() {\n@start\n")
      csb.write_string(g.fn_allocs.to_string())
      csb.write_string("    %_ic_done =w loaduw ")
      csb.write_string(init_guard_sym)
      csb.write_string("\n    jnz %_ic_done, @_ic_ret, @_ic_run\n@_ic_run\n    storew 1, ")
      csb.write_string(init_guard_sym)
      csb.write_string("\n")
      csb.write_string(g.fn_body.to_string())
      csb.write_string("@_ic_ret\n    ret\n}\n\n")
    }
    init_consts_code = csb.to_string()
  }

  let ext_init_sym = if has_init { init_sym } else { "" }
  let ext_guard_sym = if has_init { init_guard_sym } else { "" }
  let fns_buf = StringBuilder()
  qbe_collect_pkg_inline_fns(g, pkg, -1)
  fi = 0
  while fi < pkg.files.length() {
    g.cur_file_idx = fi
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => fns_buf.write_string(qbe_emit_fn_decl(g, fd))
        DExternFn(ed) =>
          if ed.has_body {
            fns_buf.write_string(
              qbe_emit_extern_fn_decl(g, ed, ext_init_sym, ext_guard_sym, [], ""),
            )
          }
        DImpl(id) => {
          let mut mi = 0
          while mi < id.methods.length() {
            fns_buf.write_string(qbe_emit_impl_method(g, id, id.methods[mi]))
            mi = mi + 1
          }
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let tests_buf = StringBuilder()
  let mut ti = 0
  while ti < test_decls.length() {
    let td = test_decls[ti]
    g.fn_allocs = StringBuilder()
    g.fn_body = StringBuilder()
    g.fn_start_tmp = g.next_tmp
    g.fn_start_lbl = g.next_lbl
    g.fn_inlined_cost = 0
    qbe_fn_cleanup_begin(g, false)
    g.scopes = []
    g.loop_breaks = []
    g.loop_conts = []
    g.loop_depths = []
    g.hot_loop_depth = 0
    g.cur_tparams = []
    g.live_tparams = []
    g.cur_type_subst = Map([])
    g.lexical_type_subst = Map([])
    g.cur_ret_ty = TUnit
    g.cur_ret_abi_ty = TUnit
    g.cur_fn_void = true
    g.block_term = false
    g.immortal_regs = Map([])
    g.immortal_slots = Map([])
    g.cur_lbl = "@start"
    g.hoisted_arr_len = Map([])
    g.hoisted_arr_dp = Map([])
    g.hoisted_str_len = Map([])
    g.hoisted_str_dp = Map([])
    g.hoisted_bytes_len = Map([])
    g.hoisted_bytes_dp = Map([])
    g.inline_closures = Map([])
    g.inline_ret_lbl = ""
    g.inline_ret_tag_slot = ""
    g.inline_ret_err_slot = ""
    g.inline_ret_pod_buf = false
    qbe_reset_tco(g)
    g.hoisted_fields = Map([])
    g.block_immut_fields = Map([])
    g.len_aliases = Map([])
    g.len_alias_keys = []
    g.nonneg_vars = Map([])
    g.u8_range_vars = Map([])
    g.known_min_len_arrs = Map([])
    g.known_writable_bytes = Map([])
    g.bce_safe_indices = Map([])
    g.bce_safe_exprs = Map([])
    g.bce_safe_push_arrs = Map([])
    g.sq_reuse_slot = Map([])
    g.sq_reuse_state = Map([])
    g.promoted_fields = Map([])
    g.promoted_field_tys = Map([])
    g.promoted_push_len = Map([])
    g.promoted_push_cap = Map([])
    g.promoted_push_dp = Map([])
    g.w_to_l_ext = Map([])
    g.local_w_to_l_ext = Map([])
    g.unfrozen_local_arrs = Map([])
    let body = qbe_fn_body(g, td.body)
    g.boxed_mut_vars = qbe_collect_boxed_mut_vars(body)
    qbe_scope_push(g)
    let bres = qbe_emit_stmts(g, body, None)
    if !g.block_term {
      qbe_rc_dec(g, bres.reg, bres.ty)
      qbe_scope_pop(g)
      qbe_emit_term(g, "ret")
    } else {
      let _ = g.scopes.pop()
    }
    tests_buf.write_string("function $pion_test_fn_")
    tests_buf.write_string(ti.to_string())
    tests_buf.write_string("() {\n@start\n")
    tests_buf.write_string(g.fn_allocs.to_string())
    tests_buf.write_string(g.fn_body.to_string())
    tests_buf.write_string("}\n\n")
    ti = ti + 1
  }
  qbe_drain_mono_queue(g, fns_buf)

  let out = StringBuilder()
  out.write_string("# Generated by pionc QBE test runner backend (deterministic)\n\n")

  if g.need_none_const {
    out.write_string(
      "section \".rodata\" data $pion_none_hdr = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l 0 }\n",
    )
  }

  let mut eci = 0
  while eci < g.enum_consts.length() {
    let ec = g.enum_consts[eci]
    out.write_string("section \".rodata\" data ")
    out.write_string(ec.sym)
    out.write_string(" = align 8 { w 0, w 0, w 1, h 5, h 3, l 0, l ")
    if ec.omit_tag {
      out.write_string(ec.payload_val.to_string())
    } else {
      out.write_string(ec.tag.to_string())
      if ec.has_payload {
        out.write_string(", l ")
        out.write_string(ec.payload_val.to_string())
      }
    }
    out.write_string(" }\n")
    eci = eci + 1
  }

  let mut si = 0
  while si < g.strings.length() {
    let s = g.strings[si]
    let bytes = str_to_utf8_ints(s)
    out.write_string("section \".rodata\" data $pion_str_")
    out.write_string(si.to_string())
    out.write_string("_hdr = align 8 { w 0, w 0, w 1, h 1, h 3, l 0, l ")
    out.write_string(bytes.length().to_string())
    out.write_string(", ")
    qbe_emit_bytes_data(out, bytes)
    out.write_string(" }\n")
    si = si + 1
  }

  let mut csi = 0
  while csi < g.cstrings.length() {
    out.write_string("section \".rodata\" data $pion_cstr_")
    out.write_string(csi.to_string())
    out.write_string(" = { ")
    qbe_emit_bytes_data(out, str_to_utf8_ints(g.cstrings[csi]))
    out.write_string(" }\n")
    csi = csi + 1
  }

  if has_init {
    out.write_string("data ")
    out.write_string(init_guard_sym)
    out.write_string(" = align 4 { z 4 }\n")
  }

  let mut kci = 0
  while kci < g.const_order.length() {
    out.write_string("data ")
    out.write_string(qbe_local_const_sym(g, g.const_order[kci]))
    out.write_string(" = align 8 { z 8 }\n")
    kci = kci + 1
  }
  out.write_string("\n")

  qbe_emit_enum_drops(g, out)
  qbe_emit_helper_drops(g, out)
  qbe_emit_fn_wrappers(g, out)

  let mut ei = 0
  while ei < g.extra_fns.length() {
    out.write_string(g.extra_fns[ei])
    ei = ei + 1
  }

  out.write_string(init_consts_code)
  out.write_string(fns_buf.to_string())
  out.write_string(tests_buf.to_string())

  out.write_string("export function w $main(w %argc, l %argv) {\n@start\n")
  out.write_string("    %ok_slot =l alloc4 4\n")
  out.write_string("    %w =l call $pion_world_init(w %argc, l %argv)\n")
  let mut dpi = 0
  while dpi < dep_pkg_names.length() {
    out.write_string("    call $pion_")
    out.write_string(qbe_pkg_prefix_for(dep_pkg_names[dpi], true))
    out.write_string("init_consts()\n")
    dpi = dpi + 1
  }
  if const_decls.length() > 0 || tc.multi_pkg {
    out.write_string("    call ")
    out.write_string(init_sym)
    out.write_string("()\n")
  }
  if test_decls.length() > 0 {
    out.write_string("    %arg1 =l call $pion_world_argv(l %w, l 1)\n")
    out.write_string("    %idx =l call $pion_str_to_int(l %arg1, l %ok_slot)\n")
    out.write_string("    call $pion_rc_dec(l %arg1)\n")
    ti = 0
    while ti < test_decls.length() {
      let s_i = ti.to_string()
      out.write_string("    %c")
      out.write_string(s_i)
      out.write_string(" =w ceql %idx, ")
      out.write_string(s_i)
      out.write_string("\n    jnz %c")
      out.write_string(s_i)
      out.write_string(", @test_")
      out.write_string(s_i)
      out.write_string(", @next_")
      out.write_string(s_i)
      out.write_string("\n@test_")
      out.write_string(s_i)
      out.write_string("\n    call $pion_test_fn_")
      out.write_string(s_i)
      out.write_string("()\n    jmp @done\n@next_")
      out.write_string(s_i)
      out.write_string("\n")
      ti = ti + 1
    }
    out.write_string("@done\n")
  }
  out.write_string("    call $pion_rc_dec(l %w)\n")
  out.write_string("    ret 0\n}\n")

  QbeTestEmitResult::{ ssa: out.to_string(), test_names: test_names }
}

///|
pub fn format_test_report_json(
  names : Array[String],
  passed_flags : Array[Bool],
) -> String {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < names.length() && i < passed_flags.length() {
    if passed_flags[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if failed == 0 { "true" } else { "false" })
  sb.write_string(",\"passed\":")
  sb.write_string(passed.to_string())
  sb.write_string(",\"failed\":")
  sb.write_string(failed.to_string())
  sb.write_string(",\"tests\":[")
  i = 0
  while i < names.length() && i < passed_flags.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(names[i]))
    sb.write_string(",\"ok\":")
    sb.write_string(if passed_flags[i] { "true" } else { "false" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
fn qbe_emit_index(g : QbeGen, obj : Expr, idx : Expr, field : String, mut projected : Bool) -> QbeVal {
      // Reuse already bounds-checked element pointer when inside `arr[idx] = ... arr[idx] ...`
      if g.assign_idx_arr != "" {
        match obj {
          EIdent(lname, _) =>
            if lname == g.assign_idx_arr && qbe_pure_idx_key(idx) == g.assign_idx_key {
              match qbe_lookup_local(g, lname) {
                Some(loc) =>
                  match loc.ty {
                    TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
                      let r = qbe_load_arr_elem(g, g.assign_idx_ep, elem)
                      return qval(r, elem)
                    }
                    _ => ()
                  }
                None => ()
              }
            }
          _ => ()
        }
      }
      let mut borrowed = false
      let mut ov = qval("0", TError)
      let mut arr_local_name = ""
      if !qbe_expr_has_assign(idx) {
        match obj {
          EIdent(lname, _) =>
            match qbe_lookup_local(g, lname) {
              Some(loc) =>
                if !loc.is_cell {
                match loc.ty {
                  TArray(_) | TFixedArray(_) | TImmArray(_) => {
                    arr_local_name = lname
                    borrowed = true
                    if g.hoisted_arr_len.contains(lname) &&
                      g.hoisted_arr_dp.contains(lname) {
                      ov = qval("0", loc.ty)
                    } else {
                      let r = qbe_tmp(g)
                      qbe_emit(g, r + " =l loadl " + loc.slot)
                      ov = qval(r, loc.ty)
                    }
                  }
                  TString | TStrView => {
                    arr_local_name = lname
                    borrowed = true
                    if g.hoisted_str_len.contains(lname) &&
                      g.hoisted_str_dp.contains(lname) {
                      ov = qval("0", loc.ty)
                    } else {
                      let r = qbe_tmp(g)
                      qbe_emit(g, r + " =l loadl " + loc.slot)
                      ov = qval(r, loc.ty)
                    }
                  }
                  TBytes | TBytesView => {
                    arr_local_name = lname
                    borrowed = true
                    if g.hoisted_bytes_len.contains(lname) &&
                      g.hoisted_bytes_dp.contains(lname) {
                      ov = qval("0", loc.ty)
                    } else {
                      let r = qbe_tmp(g)
                      qbe_emit(g, r + " =l loadl " + loc.slot)
                      ov = qval(r, loc.ty)
                    }
                  }
                  _ => ()
                }
                }
              None =>
                if g.mono_pkg == "" && g.global_min_len_arrs.contains(lname) {
                  arr_local_name = lname
                }
            }
          EField(EIdent(vname, _), fname, _) => {
            let fkey = vname + "." + fname
            match g.hoisted_fields.get(fkey) {
              Some(hv) =>
                match hv.ty {
                  TArray(_) | TFixedArray(_) | TImmArray(_) =>
                    if g.hoisted_arr_len.contains(fkey) &&
                      g.hoisted_arr_dp.contains(fkey) {
                      arr_local_name = fkey
                      borrowed = true
                      ov = qval("0", hv.ty)
                    }
                  TBytes | TBytesView =>
                    if g.hoisted_bytes_len.contains(fkey) &&
                      g.hoisted_bytes_dp.contains(fkey) {
                      arr_local_name = fkey
                      borrowed = true
                      ov = qval("0", hv.ty)
                    }
                  TString | TStrView =>
                    if g.hoisted_str_len.contains(fkey) &&
                      g.hoisted_str_dp.contains(fkey) {
                      arr_local_name = fkey
                      borrowed = true
                      ov = qval("0", hv.ty)
                    }
                  _ => ()
                }
              None => ()
            }
            if !borrowed && !qbe_expr_assigns_ident(idx, vname) {
              match qbe_lookup_local(g, vname) {
                Some(loc) =>
                  if !loc.is_cell && loc.ref_slot == "" {
                    match subst_ty(loc.ty, g.cur_type_subst) {
                      TStruct(sname, sargs) =>
                        match qbe_lookup_struct_info(g, sname) {
                          Some(sinfo) => {
                            let mut fi = 0
                            while fi < sinfo.field_names.length() {
                              if sinfo.field_names[fi] == fname {
                                let is_mut = sinfo.field_muts[fi]
                                let can_borrow_fld = if !is_mut {
                                  true
                                } else {
                                  !g.promoted_fields.contains(fkey) &&
                                    !qbe_expr_has_assign(idx) &&
                                    qbe_loop_has_no_calls_expr(g, idx)
                                }
                                if can_borrow_fld {
                                  let subst = make_subst(
                                    sinfo.decl.type_params,
                                    sargs,
                                  )
                                  let fty = subst_ty(
                                    subst_ty(sinfo.field_tys[fi], subst),
                                    g.cur_type_subst,
                                  )
                                  let fty_ok = match fty {
                                    TArray(_) | TFixedArray(_) | TImmArray(_) | TBytes | TString | TStrView | TBytesView => true
                                    _ => false
                                  }
                                  if fty_ok {
                                    if is_mut {
                                      let obj_p = qbe_tmp(g)
                                      let fp = qbe_tmp(g)
                                      let fv = qbe_tmp(g)
                                      qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                      qbe_emit(
                                        g,
                                        fp + " =l add " + obj_p + ", " + (fi * 8).to_string(),
                                      )
                                      qbe_emit(g, fv + " =l loadl " + fp)
                                      ov = qval(fv, fty)
                                      borrowed = true
                                      arr_local_name = ""
                                    } else {
                                      match g.hoisted_fields.get(fkey) {
                                        Some(hv) => ov = hv
                                        None =>
                                          match g.block_immut_fields.get(fkey) {
                                            Some(bv) => ov = bv
                                            None => {
                                              let obj_p = qbe_tmp(g)
                                              let fp = qbe_tmp(g)
                                              let fv = qbe_tmp(g)
                                              qbe_emit(g, obj_p + " =l loadl " + loc.slot)
                                              qbe_emit(
                                                g,
                                                fp + " =l add " + obj_p + ", " + (fi * 8).to_string(),
                                              )
                                              qbe_emit(g, fv + " =l loadl " + fp)
                                              ov = qval(fv, fty)
                                            }
                                          }
                                      }
                                      borrowed = true
                                      match fty {
                                        TArray(_) | TFixedArray(_) | TImmArray(_) =>
                                          if g.hoisted_arr_len.contains(fkey) {
                                            arr_local_name = fkey
                                          }
                                        TBytes | TBytesView =>
                                          if g.hoisted_bytes_len.contains(fkey) {
                                            arr_local_name = fkey
                                          }
                                        TString | TStrView =>
                                          if g.hoisted_str_len.contains(fkey) {
                                            arr_local_name = fkey
                                          }
                                        _ => ()
                                      }
                                    }
                                  }
                                }
                                break
                              }
                              fi = fi + 1
                            }
                          }
                          None => ()
                        }
                      _ => ()
                    }
                  }
                None => ()
              }
            }
          }
          EIndex(EIdent(outer, _), idx1, _) =>
            if !qbe_expr_has_assign(idx1) &&
              qbe_loop_has_no_calls_expr(g, idx) &&
              !qbe_expr_assigns_ident(idx, outer) {
              match qbe_lookup_local(g, outer) {
                Some(oloc) =>
                  if !oloc.is_cell {
                  match oloc.ty {
                    TArray(TArray(inner_elem)) => {
                      let outer_p = if g.hoisted_arr_len.contains(outer) &&
                        g.hoisted_arr_dp.contains(outer) {
                        "0"
                      } else {
                        let r = qbe_tmp(g)
                        qbe_emit(g, r + " =l loadl " + oloc.slot)
                        r
                      }
                      let iv1 = qbe_emit_expr(g, idx1, Some(TInt))
                      let il1 = qbe_as_l(g, iv1)
                      if !qbe_bce_expr_is_safe(g, outer, idx1) {
                        let olen = match g.hoisted_arr_len.get(outer) {
                          Some(hlen) => hlen
                          None => {
                            let t = qbe_tmp(g)
                            qbe_emit(g, t + " =l loadl " + outer_p)
                            t
                          }
                        }
                        let oob1 = qbe_tmp(g)
                        let l_oob1 = qbe_lbl(g, "arr_oob")
                        let l_ok1 = qbe_lbl(g, "arr_ok")
                        qbe_emit(g, oob1 + " =w cugel " + il1 + ", " + olen)
                        qbe_emit_term(g, "jnz " + oob1 + ", " + l_oob1 + ", " + l_ok1)
                        qbe_emit_lbl(g, l_oob1)
                        qbe_emit(g, "call $pion_panic_oob(l " + il1 + ", l " + olen + ")")
                        qbe_emit_term(g, "hlt")
                        qbe_emit_lbl(g, l_ok1)
                      }
                      let odp = match g.hoisted_arr_dp.get(outer) {
                        Some(hdp) => hdp
                        None => {
                          let dp_p = qbe_tmp(g)
                          let t = qbe_tmp(g)
                          qbe_emit(g, dp_p + " =l add " + outer_p + ", 24")
                          qbe_emit(g, t + " =l loadl " + dp_p)
                          t
                        }
                      }
                      let off1 = qbe_tmp(g)
                      let ep1 = qbe_tmp(g)
                      let inner_p = qbe_tmp(g)
                      qbe_emit(g, off1 + " =l shl " + il1 + ", 3")
                      qbe_emit(g, ep1 + " =l add " + odp + ", " + off1)
                      qbe_emit(g, inner_p + " =l loadl " + ep1)
                      ov = qval(inner_p, TArray(inner_elem))
                      borrowed = true
                    }
                    _ => ()
                  }
                  }
                None => ()
              }
            }
          _ => ()
        }
      }
      if !borrowed {
        ov = qbe_emit_expr(g, obj, None)
      }
      let ov_exits = !borrowed && !g.block_term && qbe_expr_may_early_exit(g, idx)
      let ov_guards = QbeArgGuards::{ exits: [ov_exits], slots: [], stores: [] }
      qbe_guard_val(g, ov_guards, QbeArgVal::{ qv: ov, borrowed: borrowed }, false, ov_exits)
      let res = qbe_emit_index_on(g, ov, borrowed, arr_local_name, idx, field, mut projected)
      qbe_release_guards(g, ov_guards)
      res
}

///|
fn qbe_emit_index_on(
  g : QbeGen,
  ov : QbeVal,
  borrowed : Bool,
  arr_local_name : String,
  idx : Expr,
  field : String,
  mut projected : Bool,
) -> QbeVal {
      match ov.ty {
        TArray(elem) | TFixedArray(elem) | TImmArray(elem) => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let bce_safe = if arr_local_name != "" {
            qbe_bce_expr_is_safe(g, arr_local_name, idx)
          } else {
            false
          }
          if !bce_safe {
            let alen = match g.hoisted_arr_len.get(arr_local_name) {
              Some(hlen) => hlen
              None => qbe_array_length_operand(g, arr_local_name, ov.reg)
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, qbe_arr_oob_lbl_prefix(g, elem))
            let l_ok = qbe_lbl(g, "arr_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + alen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + alen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let dp = match g.hoisted_arr_dp.get(arr_local_name) {
            Some(hdp) => hdp
            None => {
              let dp_p = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + ov.reg + ", 24")
              qbe_emit(g, t + " =l loadl " + dp_p)
              t
            }
          }
          match qbe_flat_pod_struct_info(g, elem) {
            Some(sinfo) => {
              let flat_stride = sinfo.field_names.length() * 8
              let ep = qbe_emit_arr_elem_addr(g, dp, il, flat_stride)
              if field != "" {
                let mut i = 0
                while i < sinfo.field_names.length() {
                  if sinfo.field_names[i] == field {
                    let ty = qbe_flat_struct_field_tys(g, sinfo, elem)[i]
                    let addr = qbe_tmp(g)
                    qbe_emit(g, addr + " =l add " + ep + ", " + (i * 8).to_string())
                    let r = qbe_load_heap_slot(g, addr, ty)
                    qbe_rc_inc(g, r, ty)
                    if !borrowed { qbe_rc_dec(g, ov.reg, ov.ty) }
                    projected = true
                    return qval(r, ty)
                  }
                  i = i + 1
                }
              }
              let box_p = qbe_emit_flat_materialize(g, ep, sinfo, elem, true)
              if !borrowed {
                qbe_rc_dec(g, ov.reg, ov.ty)
              }
              return qval(box_p, elem)
            }
            None => ()
          }
          let ep = qbe_emit_arr_ep_ty(g, dp, il, elem)
          let r = qbe_load_arr_elem(g, ep, elem)
          qbe_rc_inc(g, r, elem)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(r, elem)
        }
        TMap(kty, vty) => {
          if qbe_is_vmap_key_ty(g, kty) {
            let m = qbe_ensure_vmap_fns(g, kty, vty)
            let vka = qbe_emit_vmap_key_args(g, idx, kty, !qbe_expr_has_assign(idx))
            let r = qbe_tmp(g)
            qbe_emit(
              g,
              r +
              " =" +
              qbe_abi_ty(vty) +
              " call $pion_vmap_get_" +
              m +
              "(l " +
              ov.reg +
              qbe_vmap_key_call_args(vka) +
              ")",
            )
            qbe_rc_inc(g, r, vty)
            if !borrowed {
              qbe_rc_dec(g, ov.reg, ov.ty)
            }
            return qval(r, vty)
          }
          let kv = qbe_emit_expr(g, idx, Some(kty))
          let kl = qbe_as_l(g, kv)
          let r = qbe_tmp(g)
          qbe_emit(g, r + " =l call $pion_map_get(l " + ov.reg + ", l " + kl + ")")
          qbe_rc_inc(g, r, vty)
          qbe_rc_dec(g, kv.reg, kv.ty)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(qbe_from_l(g, r, vty), vty)
        }
        TString => {
          let bw = qbe_emit_str_code_unit_at(g, ov.reg, idx, arr_local_name)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bw, TInt)
        }
        TStrView => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let bce_safe = if arr_local_name != "" {
            qbe_bce_expr_is_safe(g, arr_local_name, idx)
          } else {
            false
          }
          if !bce_safe {
            let vlen = match g.hoisted_str_len.get(arr_local_name) {
              Some(hl) => hl
              None => {
                let lp = qbe_tmp(g)
                let t = qbe_tmp(g)
                qbe_emit(g, lp + " =l add " + ov.reg + ", 16")
                qbe_emit(g, t + " =l loadl " + lp)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, "sv_oob")
            let l_ok = qbe_lbl(g, "sv_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + vlen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + vlen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let vp = match g.hoisted_str_dp.get(arr_local_name) {
            Some(hd) => hd
            None => {
              let pp = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, pp + " =l add " + ov.reg + ", 8")
              qbe_emit(g, t + " =l loadl " + pp)
              t
            }
          }
          let ep = qbe_tmp(g)
          let bw = qbe_tmp(g)
          qbe_emit(g, ep + " =l add " + vp + ", " + il)
          qbe_emit(g, bw + " =w loadub " + ep)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bw, TInt)
        }
        TBytesView => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let bce_safe = if arr_local_name != "" {
            qbe_bce_expr_is_safe(g, arr_local_name, idx)
          } else {
            false
          }
          if !bce_safe {
            let vlen = match g.hoisted_bytes_len.get(arr_local_name) {
              Some(hl) => hl
              None => {
                let lp = qbe_tmp(g)
                let t = qbe_tmp(g)
                qbe_emit(g, lp + " =l add " + ov.reg + ", 16")
                qbe_emit(g, t + " =l loadl " + lp)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, "bv_oob")
            let l_ok = qbe_lbl(g, "bv_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + vlen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + vlen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let vp = match g.hoisted_bytes_dp.get(arr_local_name) {
            Some(hd) => hd
            None => {
              let pp = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, pp + " =l add " + ov.reg + ", 8")
              qbe_emit(g, t + " =l loadl " + pp)
              t
            }
          }
          let ep = qbe_tmp(g)
          let bw = qbe_tmp(g)
          let bl = qbe_tmp(g)
          qbe_emit(g, ep + " =l add " + vp + ", " + il)
          qbe_emit(g, bw + " =w loadub " + ep)
          qbe_emit(g, bl + " =l extuw " + bw)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bl, TByte)
        }
        TBytes => {
          let iv = qbe_emit_expr(g, idx, Some(TInt))
          let il = qbe_as_l(g, iv)
          let bce_safe = if arr_local_name != "" {
            qbe_bce_expr_is_safe(g, arr_local_name, idx)
          } else {
            false
          }
          if !bce_safe {
            let blen = match g.hoisted_bytes_len.get(arr_local_name) {
              Some(hlen) => hlen
              None => {
                let t = qbe_tmp(g)
                qbe_emit(g, t + " =l loadl " + ov.reg)
                t
              }
            }
            let oob = qbe_tmp(g)
            let l_oob = qbe_lbl(g, "bytes_oob")
            let l_ok = qbe_lbl(g, "bytes_ok")
            qbe_emit(g, oob + " =w cugel " + il + ", " + blen)
            qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
            qbe_emit_lbl(g, l_oob)
            qbe_emit(g, "call $pion_panic_oob(l " + il + ", l " + blen + ")")
            qbe_emit_term(g, "hlt")
            qbe_emit_lbl(g, l_ok)
          }
          let dp = match g.hoisted_bytes_dp.get(arr_local_name) {
            Some(hdp) => hdp
            None => {
              let dp_p = qbe_tmp(g)
              let t = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + ov.reg + ", 16")
              qbe_emit(g, t + " =l loadl " + dp_p)
              t
            }
          }
          let ep = qbe_tmp(g)
          let bw = qbe_tmp(g)
          let bl = qbe_tmp(g)
          qbe_emit(g, ep + " =l add " + dp + ", " + il)
          qbe_emit(g, bw + " =w loadub " + ep)
          qbe_emit(g, bl + " =l extuw " + bw)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval(bl, TByte)
        }
        TError => {
          let _ = qbe_emit_expr(g, idx, None)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qval("0", TError)
        }
        _ => {
          let _ = qbe_emit_expr(g, idx, None)
          if !borrowed {
            qbe_rc_dec(g, ov.reg, ov.ty)
          }
          qbe_fail_unresolved(g, "index_target", ty_to_string(ov.ty), field, span_empty())
        }
      }
}
