        qbe_emit(g, rsoff + " =l shl " + rsi + ", 3")
        qbe_emit(g, rsp + " =l add " + sdp + ", " + rsoff)
        qbe_emit(g, rv + " =l loadl " + rsp)
        if is_prim {
          let rdoff = qbe_tmp(g)
          let rdp = qbe_tmp(g)
          qbe_emit(g, rdoff + " =l shl " + rdi + ", 3")
          qbe_emit(g, rdp + " =l add " + ddp + ", " + rdoff)
          qbe_emit(g, "storel " + rv + ", " + rdp)
        } else {
          qbe_emit_adopt_if_frozen(g, dst_v, rv, elem, true)
          qbe_emit(g, "call $pion_arr_set(l " + dst_v + ", l " + rdi + ", l " + rv + ")")
        }
        let rni = qbe_tmp(g)
        qbe_emit(g, rni + " =l sub " + ri + ", 1")
        qbe_emit(g, "storel " + rni + ", " + idx_slot)
        qbe_emit_term(g, "jmp " + l_rcond)
        qbe_emit_lbl(g, l_end)
        if !dst_a.borrowed {
          qbe_rc_dec(g, dst_v, dst_a.qv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TArray(elem) => {
      if method_name == "length" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l loadl " + obj_val)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
      if method_name == "push" {
        let arg_is_movable = match args[0] {
          EIdent(aname, _) => g.movable_locals.contains(aname)
          _ => false
        }
        let va = qbe_emit_arg_maybe_borrow(
          g,
          args[0],
          Some(elem),
          args_pure && !arg_is_movable,
        )
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        let is_prim = qbe_is_prim_array_elem(elem)
        let is_owned_obj = !is_prim && qbe_is_obj_ty(elem) && !va.borrowed
        let is_unfrozen_local = match obj_expr {
          EIdent(aname, _) => g.unfrozen_local_arrs.contains(aname)
          _ => false
        }
        // The inline fast path below bypasses the runtime's adopt-on-push.
        if !is_unfrozen_local {
          qbe_emit_adopt_if_frozen(g, obj_val, vl, elem, !is_owned_obj)
        }
        if is_prim || is_owned_obj {
          let alen = qbe_tmp(g)
          let cap_p = qbe_tmp(g)
          let acap = qbe_tmp(g)
          let has_cap = qbe_tmp(g)
          let l_fast = qbe_lbl(g, "ap_fast")
          let l_slow = qbe_lbl(g, "ap_slow")
          let l_end = qbe_lbl(g, "ap_end")
          qbe_emit(g, alen + " =l loadl " + obj_val)
          qbe_emit(g, cap_p + " =l add " + obj_val + ", 8")
          qbe_emit(g, acap + " =l loadl " + cap_p)
          qbe_emit(g, has_cap + " =w csltl " + alen + ", " + acap)
          qbe_emit_term(g, "jnz " + has_cap + ", " + l_fast + ", " + l_slow)
          qbe_emit_lbl(g, l_fast)
          let dp_p = qbe_tmp(g)
          let dp = qbe_tmp(g)
          let off = qbe_tmp(g)
          let ep = qbe_tmp(g)
          let nlen = qbe_tmp(g)
          qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
          qbe_emit(g, dp + " =l loadl " + dp_p)
          qbe_emit(g, off + " =l shl " + alen + ", 3")
          qbe_emit(g, ep + " =l add " + dp + ", " + off)
          qbe_emit(g, "storel " + vl + ", " + ep)
          qbe_emit(g, nlen + " =l add " + alen + ", 1")
          qbe_emit(g, "storel " + nlen + ", " + obj_val)
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_slow)
          if is_owned_obj {
            qbe_emit(g, "call $pion_arr_push_owned(l " + obj_val + ", l " + vl + ")")
          } else {
            qbe_emit(g, "call $pion_arr_push(l " + obj_val + ", l " + vl + ")")
          }
          qbe_emit_term(g, "jmp " + l_end)
          qbe_emit_lbl(g, l_end)
        } else {
          qbe_emit(g, "call $pion_arr_push(l " + obj_val + ", l " + vl + ")")
        }
        if !va.borrowed && !is_owned_obj {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "pop" {
        let n = qbe_tmp(g)
        qbe_emit(g, n + " =l loadl " + obj_val)
        let res_slot = qbe_alloc_slot(g)
        let l_some = qbe_lbl(g, "pop_some")
        let l_none = qbe_lbl(g, "pop_none")
        let l_end = qbe_lbl(g, "pop_end")
        qbe_emit_term(g, "jnz " + n + ", " + l_some + ", " + l_none)
        qbe_emit_lbl(g, l_some)
        let pv = qbe_tmp(g)
        qbe_emit(g, pv + " =l call $pion_arr_pop(l " + obj_val + ")")
        let some_obj = qbe_emit_some(g, pv, elem)
        qbe_emit(g, "storel " + some_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_none)
        let none_obj = qbe_emit_none(g, elem)
        qbe_emit(g, "storel " + none_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TOption(elem))
      }
      if method_name == "copy" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_arr_copy(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TArray(elem))
      }
      if method_name == "contains" {
        return qbe_emit_arr_contains(g, obj_val, obj_borrowed, elem, args[0], args_pure)
      }
      if method_name == "clear" {
        qbe_emit(g, "call $pion_arr_clear(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "reverse" {
        qbe_emit(g, "call $pion_arr_reverse(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "join" {
        let sa = qbe_emit_arg_maybe_borrow(g, args[0], Some(TString), args_pure)
        let sv = sa.qv
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_arr_join(l " + obj_val + ", l " + sv.reg + ")")
        if !sa.borrowed {
          qbe_rc_dec(g, sv.reg, sv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TString)
      }
      if method_name == "sort" {
        match elem {
          TString => qbe_emit(g, "call $pion_arr_sort_str(l " + obj_val + ")")
          _ => qbe_emit(g, "call $pion_arr_sort_int(l " + obj_val + ")")
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TMap(kty, vty) => {
      if method_name == "length" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l call $pion_map_len(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
      if method_name == "set" {
        let ka = qbe_emit_arg_maybe_borrow(g, args[0], Some(kty), args_pure)
        let va = qbe_emit_arg_maybe_borrow(g, args[1], Some(vty), args_pure)
        let kv = ka.qv
        let vv = va.qv
        let kl = qbe_as_l(g, kv)
        let vl = qbe_as_l(g, vv)
        qbe_emit_adopt_if_frozen(g, obj_val, vl, vty, true)
        qbe_emit(
          g,
          "call $pion_map_set(l " + obj_val + ", l " + kl + ", l " + vl + ")",
        )
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !va.borrowed {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "contains" {
        let ka = qbe_emit_arg_maybe_borrow(g, args[0], Some(kty), args_pure)
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        let hw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, hw + " =w call $pion_map_has(l " + obj_val + ", l " + kl + ")")
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, r + " =l extuw " + hw)
        return qval(r, TBool)
      }
      if method_name == "remove" {
        let ka = qbe_emit_arg_maybe_borrow(g, args[0], Some(kty), args_pure)
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        qbe_emit(g, "call $pion_map_remove(l " + obj_val + ", l " + kl + ")")
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "get" {
        let ka = qbe_emit_arg_maybe_borrow(g, args[0], Some(kty), args_pure)
        let kv = ka.qv
        let kl = qbe_as_l(g, kv)
        let out_slot = qbe_alloc_slot(g)
        let hw = qbe_tmp(g)
        qbe_emit(
          g,
          hw +
          " =w call $pion_map_try_get(l " +
          obj_val +
          ", l " +
          kl +
          ", l " +
          out_slot +
          ")",
        )
        let res_slot = qbe_alloc_slot(g)
        let l_hit = qbe_lbl(g, "mget_hit")
        let l_miss = qbe_lbl(g, "mget_miss")
        let l_end = qbe_lbl(g, "mget_end")
        qbe_emit_term(g, "jnz " + hw + ", " + l_hit + ", " + l_miss)
        qbe_emit_lbl(g, l_hit)
        let mv = qbe_tmp(g)
        qbe_emit(g, mv + " =l loadl " + out_slot)
        qbe_rc_inc(g, mv, vty)
        let some_obj = qbe_emit_some(g, mv, vty)
        qbe_emit(g, "storel " + some_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_miss)
        let none_obj = qbe_emit_none(g, vty)
        qbe_emit(g, "storel " + none_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        if !ka.borrowed {
          qbe_rc_dec(g, kv.reg, kv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TOption(vty))
      }
      if method_name == "copy" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_map_copy(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TMap(kty, vty))
      }
      if method_name == "keys" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_map_keys(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(r, TArray(kty))
      }
      if method_name == "clear" {
        qbe_emit(g, "call $pion_map_clear(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TChannel(elem) => {
      if method_name == "send" {
        let va = qbe_emit_arg_maybe_borrow(g, args[0], Some(elem), args_pure)
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        qbe_emit_deep_freeze(g, vl, elem)
        let rw = qbe_tmp(g)
        let r = qbe_tmp(g)
        qbe_emit(g, rw + " =w call $pion_chan_send(l " + obj_val + ", l " + vl + ")")
        if !va.borrowed {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, r + " =l extuw " + rw)
        return qval(r, TBool)
      }
      if method_name == "recv" {
        let out_slot = qbe_alloc_slot(g)
        let ok_w = qbe_tmp(g)
        qbe_emit(
          g,
          ok_w + " =w call $pion_chan_recv(l " + obj_val + ", l " + out_slot + ")",
        )
        let res_slot = qbe_alloc_slot(g)
        let l_some = qbe_lbl(g, "crecv_some")
        let l_none = qbe_lbl(g, "crecv_none")
        let l_end = qbe_lbl(g, "crecv_end")
        qbe_emit_term(g, "jnz " + ok_w + ", " + l_some + ", " + l_none)
        qbe_emit_lbl(g, l_some)
        let rv = qbe_tmp(g)
        qbe_emit(g, rv + " =l loadl " + out_slot)
        let some_obj = qbe_emit_some(g, rv, elem)
        qbe_emit(g, "storel " + some_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_none)
        let none_obj = qbe_emit_none(g, elem)
        qbe_emit(g, "storel " + none_obj + ", " + res_slot)
        qbe_emit_term(g, "jmp " + l_end)
        qbe_emit_lbl(g, l_end)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l loadl " + res_slot)
        return qval(r, TOption(elem))
      }
      if method_name == "close" {
        qbe_emit(g, "call $pion_chan_close(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TMutex(elem) => {
      if method_name == "lock" {
        let r = qbe_tmp(g)
        qbe_emit(g, r + " =l call $pion_mutex_lock(l " + obj_val + ")")
        qbe_rc_inc(g, r, elem)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval(qbe_from_l(g, r, elem), elem)
      }
      if method_name == "set" {
        let va = qbe_emit_arg_maybe_borrow(g, args[0], Some(elem), args_pure)
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        qbe_emit_deep_freeze(g, vl, elem)
        qbe_emit(g, "call $pion_mutex_set(l " + obj_val + ", l " + vl + ")")
        if !va.borrowed {
          qbe_rc_dec(g, vv.reg, vv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "unlock" {
        qbe_emit(g, "call $pion_mutex_unlock(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
      if method_name == "with_lock" {
        let fv = qbe_emit_expr(g, args[0], None)
        let cur_v = qbe_tmp(g)
        qbe_emit(g, cur_v + " =l call $pion_mutex_lock(l " + obj_val + ")")
        qbe_rc_inc(g, cur_v, elem)
        let cur_typed = qbe_from_l(g, cur_v, elem)
        let r = qbe_emit_closure_call(g, fv.reg, [cur_typed], [elem])
        qbe_emit(g, "call $pion_mutex_unlock(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        let rty = match fv.ty {
          TFn(_, rt) => rt
          _ =>
            match expected {
              Some(t) => t
              None => TUnit
            }
        }
        return qval(qbe_from_l(g, r, rty), rty)
      }
    }
    TAtomicInt => {
      if method_name == "load" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l call $pion_atomic_load(l " + obj_val + ")")
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
