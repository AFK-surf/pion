        }
        let dst_v = dst_a.qv.reg
        let len_l = match len_e {
          Some(le) => qbe_as_l(g, qbe_emit_expr(g, le, Some(TInt)))
          None => "0"
        }
        let soff_l = match soff_e {
          Some(se) => qbe_as_l(g, qbe_emit_expr(g, se, Some(TInt)))
          None => "0"
        }
        let doff_l = match doff_e {
          Some(de) => qbe_as_l(g, qbe_emit_expr(g, de, Some(TInt)))
          None => "0"
        }
        let is_u8 = qbe_is_u8_array_elem(g, elem)
        let is_4b = qbe_is_4b_array_elem(g, elem)
        let is_prim = qbe_is_prim_array_elem(elem)
        let flat_stride = qbe_flat_pod_stride(g, elem)
        let sdp_p = qbe_tmp(g)
        let sdp = qbe_tmp(g)
        let ddp_p = qbe_tmp(g)
        let ddp = qbe_tmp(g)
        let same_p = qbe_tmp(g)
        let gt_off = qbe_tmp(g)
        let rev_flag = qbe_tmp(g)
        let idx_slot = qbe_alloc_slot(g)
        let l_fwd = qbe_lbl(g, "blt_fwd")
        let l_fcond = qbe_lbl(g, "blt_fc")
        let l_fbody = qbe_lbl(g, "blt_fb")
        let l_rev = qbe_lbl(g, "blt_rev")
        let l_rcond = qbe_lbl(g, "blt_rc")
        let l_rbody = qbe_lbl(g, "blt_rb")
        let l_end = qbe_lbl(g, "blt_end")
        qbe_emit(g, sdp_p + " =l add " + obj_val + ", 24")
        qbe_emit(g, sdp + " =l loadl " + sdp_p)
        qbe_emit(g, ddp_p + " =l add " + dst_v + ", 24")
        qbe_emit(g, ddp + " =l loadl " + ddp_p)
        qbe_emit(g, same_p + " =w ceql " + obj_val + ", " + dst_v)
        qbe_emit(g, gt_off + " =w csgtl " + doff_l + ", " + soff_l)
        qbe_emit(g, rev_flag + " =w and " + same_p + ", " + gt_off)
        qbe_emit_term(g, "jnz " + rev_flag + ", " + l_rev + ", " + l_fwd)
        qbe_emit_lbl(g, l_fwd)
        qbe_emit(g, "storel 0, " + idx_slot)
        qbe_emit_term(g, "jmp " + l_fcond)
        qbe_emit_lbl(g, l_fcond)
        let fi = qbe_tmp(g)
        let fc = qbe_tmp(g)
        qbe_emit(g, fi + " =l loadl " + idx_slot)
        qbe_emit(g, fc + " =w csltl " + fi + ", " + len_l)
        qbe_emit_term(g, "jnz " + fc + ", " + l_fbody + ", " + l_end)
        qbe_emit_lbl(g, l_fbody)
        let fsi = qbe_tmp(g)
        let fdi = qbe_tmp(g)
        qbe_emit(g, fsi + " =l add " + soff_l + ", " + fi)
        qbe_emit(g, fdi + " =l add " + doff_l + ", " + fi)
        if is_u8 {
          let fsp = qbe_tmp(g)
          let fdp = qbe_tmp(g)
          let fb = qbe_tmp(g)
          qbe_emit(g, fsp + " =l add " + sdp + ", " + fsi)
          qbe_emit(g, fb + " =w loadub " + fsp)
          qbe_emit(g, fdp + " =l add " + ddp + ", " + fdi)
          qbe_emit(g, "storeb " + fb + ", " + fdp)
        } else if is_4b {
          let fsoff = qbe_tmp(g)
          let fsp = qbe_tmp(g)
          let fw = qbe_tmp(g)
          let fdoff = qbe_tmp(g)
          let fdp = qbe_tmp(g)
          qbe_emit(g, fsoff + " =l shl " + fsi + ", 2")
          qbe_emit(g, fsp + " =l add " + sdp + ", " + fsoff)
          qbe_emit(g, fw + " =w loaduw " + fsp)
          qbe_emit(g, fdoff + " =l shl " + fdi + ", 2")
          qbe_emit(g, fdp + " =l add " + ddp + ", " + fdoff)
          qbe_emit(g, "storew " + fw + ", " + fdp)
        } else if flat_stride > 0 {
          let fsp = qbe_emit_arr_elem_addr(g, sdp, fsi, flat_stride)
          let fdp = qbe_emit_arr_elem_addr(g, ddp, fdi, flat_stride)
          match qbe_flat_pod_struct_info(g, elem) {
            Some(sinfo) =>
              qbe_emit_flat_copy_slots_rc(g, fdp, fsp, sinfo, elem, true, true, dst_v)
            None => ()
          }
        } else {
          let fsoff = qbe_tmp(g)
          let fsp = qbe_tmp(g)
          let fv = qbe_tmp(g)
          qbe_emit(g, fsoff + " =l shl " + fsi + ", 3")
          qbe_emit(g, fsp + " =l add " + sdp + ", " + fsoff)
          qbe_emit(g, fv + " =l loadl " + fsp)
          if is_prim {
            let fdoff = qbe_tmp(g)
            let fdp = qbe_tmp(g)
            qbe_emit(g, fdoff + " =l shl " + fdi + ", 3")
            qbe_emit(g, fdp + " =l add " + ddp + ", " + fdoff)
            qbe_emit(g, "storel " + fv + ", " + fdp)
          } else {
            qbe_emit_adopt_if_frozen(g, dst_v, fv, elem, true)
            qbe_emit(g, "call $pion_arr_set(l " + dst_v + ", l " + fdi + ", l " + fv + ")")
          }
        }
        let fni = qbe_tmp(g)
        qbe_emit(g, fni + " =l add " + fi + ", 1")
        qbe_emit(g, "storel " + fni + ", " + idx_slot)
        qbe_emit_term(g, "jmp " + l_fcond)
        qbe_emit_lbl(g, l_rev)
        let rinit = qbe_tmp(g)
        qbe_emit(g, rinit + " =l sub " + len_l + ", 1")
        qbe_emit(g, "storel " + rinit + ", " + idx_slot)
        qbe_emit_term(g, "jmp " + l_rcond)
        qbe_emit_lbl(g, l_rcond)
        let ri = qbe_tmp(g)
        let rc = qbe_tmp(g)
        qbe_emit(g, ri + " =l loadl " + idx_slot)
        qbe_emit(g, rc + " =w csgel " + ri + ", 0")
        qbe_emit_term(g, "jnz " + rc + ", " + l_rbody + ", " + l_end)
        qbe_emit_lbl(g, l_rbody)
        let rsi = qbe_tmp(g)
        let rdi = qbe_tmp(g)
        qbe_emit(g, rsi + " =l add " + soff_l + ", " + ri)
        qbe_emit(g, rdi + " =l add " + doff_l + ", " + ri)
        if is_u8 {
          let rsp = qbe_tmp(g)
          let rdp = qbe_tmp(g)
          let rb = qbe_tmp(g)
          qbe_emit(g, rsp + " =l add " + sdp + ", " + rsi)
          qbe_emit(g, rb + " =w loadub " + rsp)
          qbe_emit(g, rdp + " =l add " + ddp + ", " + rdi)
          qbe_emit(g, "storeb " + rb + ", " + rdp)
        } else if is_4b {
          let rsoff = qbe_tmp(g)
          let rsp = qbe_tmp(g)
          let rw = qbe_tmp(g)
          let rdoff = qbe_tmp(g)
          let rdp = qbe_tmp(g)
          qbe_emit(g, rsoff + " =l shl " + rsi + ", 2")
          qbe_emit(g, rsp + " =l add " + sdp + ", " + rsoff)
          qbe_emit(g, rw + " =w loaduw " + rsp)
          qbe_emit(g, rdoff + " =l shl " + rdi + ", 2")
          qbe_emit(g, rdp + " =l add " + ddp + ", " + rdoff)
          qbe_emit(g, "storew " + rw + ", " + rdp)
        } else if flat_stride > 0 {
          let rsp = qbe_emit_arr_elem_addr(g, sdp, rsi, flat_stride)
          let rdp = qbe_emit_arr_elem_addr(g, ddp, rdi, flat_stride)
          match qbe_flat_pod_struct_info(g, elem) {
            Some(sinfo) =>
              qbe_emit_flat_copy_slots_rc(g, rdp, rsp, sinfo, elem, true, true, dst_v)
            None => ()
          }
        } else {
          let rsoff = qbe_tmp(g)
          let rsp = qbe_tmp(g)
          let rv = qbe_tmp(g)
          qbe_emit(g, rsoff + " =l shl " + rsi + ", 3")
          qbe_emit(g, rsp + " =l add " + sdp + ", " + rsoff)
          qbe_emit(g, rv + " =l loadl " + rsp)
          if is_prim {
            let rdoff = qbe_tmp(g)
            let rdp = qbe_tmp(g)
            qbe_emit(g, rdoff + " =l shl " + rdi + ", 3")
            qbe_emit(g, rdp + " =l add " + ddp + ", " + rdoff)
            qbe_emit(g, "storel " + rv + ", " + rdp)
          } else {
            qbe_emit_adopt_if_frozen(g, dst_v, rv, elem, true)
            qbe_emit(g, "call $pion_arr_set(l " + dst_v + ", l " + rdi + ", l " + rv + ")")
          }
        }
        let rni = qbe_tmp(g)
        qbe_emit(g, rni + " =l sub " + ri + ", 1")
        qbe_emit(g, "storel " + rni + ", " + idx_slot)
        qbe_emit_term(g, "jmp " + l_rcond)
        qbe_emit_lbl(g, l_end)
        if !dst_a.borrowed {
          qbe_rc_dec(g, dst_v, dst_a.qv.ty)
        }
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        return qval("0", TUnit)
      }
    }
    TArray(elem) => {
      if method_name == "length" {
        let r64 = qbe_tmp(g)
        let rw = qbe_tmp(g)
        qbe_emit(g, r64 + " =l loadl " + obj_val)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, rw + " =w copy " + r64)
        return qval(rw, TInt)
      }
      if method_name == "is_empty" {
        let r64 = qbe_tmp(g)
        let eq = qbe_tmp(g)
        let rl = qbe_tmp(g)
        qbe_emit(g, r64 + " =l loadl " + obj_val)
        if !obj_borrowed {
          qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
        }
        qbe_emit(g, eq + " =w ceql " + r64 + ", 0")
        qbe_emit(g, rl + " =l extuw " + eq)
        return qval(rl, TBool)
      }
      if method_name == "push" {
        match qbe_flat_pod_struct_info(g, elem) {
          Some(sinfo) => {
            let nfields = sinfo.field_names.length()
            let stride = nfields * 8
            let direct_slots_opt : Option[Array[QbeVal]] = match args[0] {
              EStructLit(_, None, fields, _) =>
                Some(qbe_emit_flat_eval_struct_lit(g, sinfo, elem, fields))
              EIdent(rname, _) =>
                match qbe_lookup_local(g, rname) {
                  Some(rloc) =>
                    if !rloc.is_cell && qbe_ty_matches_flat_pod_struct(g, rloc.ty, sinfo) {
                      let src_p = qbe_tmp(g)
                      qbe_emit(g, src_p + " =l loadl " + rloc.slot)
                      Some(qbe_emit_flat_load_slots_rc(g, src_p, sinfo, elem, true))
                    } else {
                      None
                    }
                  None => None
                }
              EIndex(src_obj, src_idx, _) => {
                let mut src_can = false
                let mut src_borrowed = false
                let mut src_aname = ""
                let mut src_ov = qval("0", TUnit)
                match src_obj {
                  EIdent(aname, _) =>
                    if !qbe_expr_has_assign(src_idx) {
                      match qbe_lookup_local(g, aname) {
                        Some(sloc) =>
                          if !sloc.is_cell {
                            match sloc.ty {
                              TArray(se) | TFixedArray(se) | TImmArray(se) =>
                                if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
                                  src_can = true
                                  src_borrowed = true
                                  src_aname = aname
                                  if g.hoisted_arr_len.contains(aname) &&
                                    g.hoisted_arr_dp.contains(aname) {
                                    src_ov = qval("0", sloc.ty)
                                  } else {
                                    let r = qbe_tmp(g)
                                    qbe_emit(g, r + " =l loadl " + sloc.slot)
                                    src_ov = qval(r, sloc.ty)
                                  }
                                }
                              _ => ()
                            }
                          }
                        None => ()
                      }
                    }
                  _ => ()
                }
                if !src_can {
                  match qbe_probe_expr_ty(g, src_obj) {
                    Some(TArray(se)) | Some(TFixedArray(se)) | Some(TImmArray(se)) =>
                      if qbe_ty_matches_flat_pod_struct(g, se, sinfo) {
                        src_can = true
                        src_borrowed = false
                        src_ov = qbe_emit_expr(g, src_obj, None)
                      }
                    _ => ()
                  }
                }
                if src_can {
                  let src_idx_exits = !src_borrowed && qbe_expr_may_early_exit(g, src_idx)
                  let src_guards = QbeArgGuards::{ exits: [src_idx_exits], slots: [], stores: [] }
                  qbe_guard_val(g, src_guards, QbeArgVal::{ qv: src_ov, borrowed: src_borrowed }, false, src_idx_exits)
                  let src_iv = qbe_emit_expr(g, src_idx, Some(TInt))
                  qbe_release_guards(g, src_guards)
                  if g.block_term {
                    return qval("0", TUnit)
                  }
                  let src_il = qbe_as_l(g, src_iv)
                  let src_bce = if src_aname != "" {
                    qbe_bce_expr_is_safe(g, src_aname, src_idx)
                  } else {
                    false
                  }
                  if !src_bce {
                    let salen = match g.hoisted_arr_len.get(src_aname) {
                      Some(hlen) => hlen
                      None => {
                        let t = qbe_tmp(g)
                        qbe_emit(g, t + " =l loadl " + src_ov.reg)
                        t
                      }
                    }
                    let oob = qbe_tmp(g)
                    let l_oob = qbe_lbl(g, "arr_oob")
                    let l_ok = qbe_lbl(g, "arr_ok")
                    qbe_emit(g, oob + " =w cugel " + src_il + ", " + salen)
                    qbe_emit_term(g, "jnz " + oob + ", " + l_oob + ", " + l_ok)
                    qbe_emit_lbl(g, l_oob)
                    qbe_emit(g, "call $pion_panic_oob(l " + src_il + ", l " + salen + ")")
                    qbe_emit_term(g, "hlt")
                    qbe_emit_lbl(g, l_ok)
                  }
                  let sdp = match g.hoisted_arr_dp.get(src_aname) {
                    Some(hdp) => hdp
                    None => {
                      let dp_p = qbe_tmp(g)
                      let t = qbe_tmp(g)
                      qbe_emit(g, dp_p + " =l add " + src_ov.reg + ", 24")
                      qbe_emit(g, t + " =l loadl " + dp_p)
                      t
                    }
                  }
                  let src_ep = qbe_emit_arr_elem_addr(g, sdp, src_il, stride)
                  let vals = qbe_emit_flat_load_slots_rc(g, src_ep, sinfo, elem, true)
                  if !src_borrowed {
                    qbe_rc_dec(g, src_ov.reg, src_ov.ty)
                  }
                  Some(vals)
                } else {
                  None
                }
              }
              ECall(EIdent(cname, _), cargs, _) =>
                match g.inline_closures.get(cname) {
                  Some(iclo) =>
                    if cargs.length() == iclo.params.length() &&
                      iclo.body.length() == 1 &&
                      !qbe_stmts_has_cf(iclo.body, false, false, true) {
                      match iclo.body[0] {
                        SExpr(EStructLit(_, None, fields, _), _) =>
                          Some(
                            qbe_emit_inline_closure_flat_struct_lit(
                              g,
                              iclo,
                              cargs,
                              sinfo,
                              elem,
                              fields,
                            ),
                          )
                        _ => None
                      }
                    } else {
                      None
                    }
                  None => None
                }
              _ => None
            }
            let push_aname = match obj_expr {
              EIdent(aname, _) => aname
              _ => ""
            }
            let is_unfrozen_local = push_aname != "" && g.unfrozen_local_arrs.contains(push_aname)
            let prom_len_slot = match g.promoted_push_len.get(push_aname) {
              Some(s) => s
              None => ""
            }
            let prom_cap_slot = match g.promoted_push_cap.get(push_aname) {
              Some(s) => s
              None => ""
            }
            let prom_dp_slot = match g.promoted_push_dp.get(push_aname) {
              Some(s) => s
              None => ""
            }
            let adopt_arr = if is_unfrozen_local { "" } else { obj_val }
            match direct_slots_opt {
              Some(slot_vals) => {
                qbe_emit_flat_adopt_vals(g, adopt_arr, slot_vals)
                if prom_len_slot != "" && g.bce_safe_push_arrs.contains(push_aname) {
                  let alen = qbe_tmp(g)
                  let dp = qbe_tmp(g)
                  let nlen = qbe_tmp(g)
                  qbe_emit(g, alen + " =l loadl " + prom_len_slot)
                  qbe_emit(g, dp + " =l loadl " + prom_dp_slot)
                  let ep = qbe_emit_arr_elem_addr(g, dp, alen, stride)
                  qbe_emit_flat_store_vals(g, ep, slot_vals)
                  qbe_emit(g, nlen + " =l add " + alen + ", 1")
                  qbe_emit(g, "storel " + nlen + ", " + prom_len_slot)
                } else {
                  let alen = qbe_tmp(g)
                  let acap = qbe_tmp(g)
                  let has_cap = qbe_tmp(g)
                  let l_fast = qbe_lbl(g, "afp_fast")
                  let l_slow = qbe_lbl(g, "afp_slow")
                  let l_end = qbe_lbl(g, "afp_end")
                  if prom_len_slot != "" {
                    qbe_emit(g, alen + " =l loadl " + prom_len_slot)
                    qbe_emit(g, acap + " =l loadl " + prom_cap_slot)
                  } else {
                    let cap_p = qbe_tmp(g)
                    qbe_emit(g, alen + " =l loadl " + obj_val)
                    qbe_emit(g, cap_p + " =l add " + obj_val + ", 8")
                    qbe_emit(g, acap + " =l loadl " + cap_p)
                  }
                  qbe_emit(g, has_cap + " =w csltl " + alen + ", " + acap)
                  qbe_emit_term(g, "jnz " + has_cap + ", " + l_fast + ", " + l_slow)
                  qbe_emit_lbl(g, l_fast)
                  let dp = qbe_tmp(g)
                  if prom_dp_slot != "" {
                    qbe_emit(g, dp + " =l loadl " + prom_dp_slot)
                  } else {
                    let dp_p = qbe_tmp(g)
                    qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
                    qbe_emit(g, dp + " =l loadl " + dp_p)
                  }
                  let ep = qbe_emit_arr_elem_addr(g, dp, alen, stride)
                  qbe_emit_flat_store_vals(g, ep, slot_vals)
                  let nlen = qbe_tmp(g)
                  qbe_emit(g, nlen + " =l add " + alen + ", 1")
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + nlen + ", " + prom_len_slot)
                  } else {
                    qbe_emit(g, "storel " + nlen + ", " + obj_val)
                  }
                  qbe_emit_term(g, "jmp " + l_end)
                  qbe_emit_lbl(g, l_slow)
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + alen + ", " + obj_val)
                  }
                  let ep_s = qbe_tmp(g)
                  qbe_emit(g, ep_s + " =l call $pion_arr_push_flat_grow(l " + obj_val + ")")
                  if prom_len_slot != "" {
                    let cp_s = qbe_tmp(g)
                    let ncap = qbe_tmp(g)
                    let dpp_s = qbe_tmp(g)
                    let ndp = qbe_tmp(g)
                    qbe_emit(g, cp_s + " =l add " + obj_val + ", 8")
                    qbe_emit(g, ncap + " =l loadl " + cp_s)
                    qbe_emit(g, "storel " + ncap + ", " + prom_cap_slot)
                    qbe_emit(g, dpp_s + " =l add " + obj_val + ", 24")
                    qbe_emit(g, ndp + " =l loadl " + dpp_s)
                    qbe_emit(g, "storel " + ndp + ", " + prom_dp_slot)
                  }
                  qbe_emit_flat_store_vals(g, ep_s, slot_vals)
                  let nlen_s = qbe_tmp(g)
                  qbe_emit(g, nlen_s + " =l add " + alen + ", 1")
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + nlen_s + ", " + prom_len_slot)
                  } else {
                    qbe_emit(g, "storel " + nlen_s + ", " + obj_val)
                  }
                  qbe_emit_term(g, "jmp " + l_end)
                  qbe_emit_lbl(g, l_end)
                }
                if !obj_borrowed {
                  qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
                }
                return qval("0", TUnit)
              }
              None => {
                let arg_is_movable = match args[0] {
                  EIdent(aname, _) => g.movable_locals.contains(aname)
                  _ => false
                }
                let va = qbe_emit_arg_maybe_borrow(
                  g,
                  args[0],
                  Some(elem),
                  args_pure && !arg_is_movable,
                )
                let vv = va.qv
                let vl = qbe_as_l(g, vv)
                if prom_len_slot != "" && g.bce_safe_push_arrs.contains(push_aname) {
                  let alen = qbe_tmp(g)
                  let dp = qbe_tmp(g)
                  let nlen = qbe_tmp(g)
                  qbe_emit(g, alen + " =l loadl " + prom_len_slot)
                  qbe_emit(g, dp + " =l loadl " + prom_dp_slot)
                  let ep = qbe_emit_arr_elem_addr(g, dp, alen, stride)
                  qbe_emit_flat_copy_slots_rc(g, ep, vl, sinfo, elem, true, false, adopt_arr)
                  qbe_emit(g, nlen + " =l add " + alen + ", 1")
                  qbe_emit(g, "storel " + nlen + ", " + prom_len_slot)
                } else {
                  let alen = qbe_tmp(g)
                  let acap = qbe_tmp(g)
                  let has_cap = qbe_tmp(g)
                  let l_fast = qbe_lbl(g, "afp_fast")
                  let l_slow = qbe_lbl(g, "afp_slow")
                  let l_end = qbe_lbl(g, "afp_end")
                  if prom_len_slot != "" {
                    qbe_emit(g, alen + " =l loadl " + prom_len_slot)
                    qbe_emit(g, acap + " =l loadl " + prom_cap_slot)
                  } else {
                    let cap_p = qbe_tmp(g)
                    qbe_emit(g, alen + " =l loadl " + obj_val)
                    qbe_emit(g, cap_p + " =l add " + obj_val + ", 8")
                    qbe_emit(g, acap + " =l loadl " + cap_p)
                  }
                  qbe_emit(g, has_cap + " =w csltl " + alen + ", " + acap)
                  qbe_emit_term(g, "jnz " + has_cap + ", " + l_fast + ", " + l_slow)
                  qbe_emit_lbl(g, l_fast)
                  let dp = qbe_tmp(g)
                  if prom_dp_slot != "" {
                    qbe_emit(g, dp + " =l loadl " + prom_dp_slot)
                  } else {
                    let dp_p = qbe_tmp(g)
                    qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
                    qbe_emit(g, dp + " =l loadl " + dp_p)
                  }
                  let ep = qbe_emit_arr_elem_addr(g, dp, alen, stride)
                  qbe_emit_flat_copy_slots_rc(g, ep, vl, sinfo, elem, true, false, adopt_arr)
                  let nlen = qbe_tmp(g)
                  qbe_emit(g, nlen + " =l add " + alen + ", 1")
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + nlen + ", " + prom_len_slot)
                  } else {
                    qbe_emit(g, "storel " + nlen + ", " + obj_val)
                  }
                  qbe_emit_term(g, "jmp " + l_end)
                  qbe_emit_lbl(g, l_slow)
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + alen + ", " + obj_val)
                  }
                  let ep_s = qbe_tmp(g)
                  qbe_emit(g, ep_s + " =l call $pion_arr_push_flat_grow(l " + obj_val + ")")
                  if prom_len_slot != "" {
                    let cp_s = qbe_tmp(g)
                    let ncap = qbe_tmp(g)
                    let dpp_s = qbe_tmp(g)
                    let ndp = qbe_tmp(g)
                    qbe_emit(g, cp_s + " =l add " + obj_val + ", 8")
                    qbe_emit(g, ncap + " =l loadl " + cp_s)
                    qbe_emit(g, "storel " + ncap + ", " + prom_cap_slot)
                    qbe_emit(g, dpp_s + " =l add " + obj_val + ", 24")
                    qbe_emit(g, ndp + " =l loadl " + dpp_s)
                    qbe_emit(g, "storel " + ndp + ", " + prom_dp_slot)
                  }
                  qbe_emit_flat_copy_slots_rc(g, ep_s, vl, sinfo, elem, true, false, adopt_arr)
                  let nlen_s = qbe_tmp(g)
                  qbe_emit(g, nlen_s + " =l add " + alen + ", 1")
                  if prom_len_slot != "" {
                    qbe_emit(g, "storel " + nlen_s + ", " + prom_len_slot)
                  } else {
                    qbe_emit(g, "storel " + nlen_s + ", " + obj_val)
                  }
                  qbe_emit_term(g, "jmp " + l_end)
                  qbe_emit_lbl(g, l_end)
                }
                if !va.borrowed {
                  qbe_rc_dec(g, vv.reg, vv.ty)
                }
                if !obj_borrowed {
                  qbe_emit(g, "call $pion_rc_dec(l " + obj_val + ")")
                }
                return qval("0", TUnit)
              }
            }
          }
          None => ()
        }
        let arg_is_movable = match args[0] {
          EIdent(aname, _) => g.movable_locals.contains(aname)
          _ => false
        }
        let va = qbe_emit_arg_maybe_borrow(
          g,
          args[0],
          Some(elem),
          args_pure && !arg_is_movable,
        )
        let vv = va.qv
        let vl = qbe_as_l(g, vv)
        let is_prim = qbe_is_prim_array_elem(elem)
        let is_owned_obj = !is_prim && qbe_is_obj_ty(g, elem) && !va.borrowed
        let push_aname2 = match obj_expr {
          EIdent(aname, _) => aname
          _ => ""
        }
        let is_unfrozen_local = push_aname2 != "" && g.unfrozen_local_arrs.contains(push_aname2)
        let prom_len_slot2 = if is_prim && push_aname2 != "" {
          match g.promoted_push_len.get(push_aname2) {
            Some(s) => s
            None => ""
          }
        } else {
          ""
        }
        let prom_cap_slot2 = if prom_len_slot2 != "" {
          match g.promoted_push_cap.get(push_aname2) {
            Some(s) => s
            None => ""
          }
        } else {
          ""
        }
        let prom_dp_slot2 = if prom_len_slot2 != "" {
          match g.promoted_push_dp.get(push_aname2) {
            Some(s) => s
            None => ""
          }
        } else {
          ""
        }
        // The inline fast path below bypasses the runtime's adopt-on-push;
        // cold calls still need deep freeze for nested heap types pushed into a frozen array.
        let in_loop_push = g.hot_loop_depth > 0
        if !is_unfrozen_local {
          qbe_emit_adopt_if_frozen(
            g,
            obj_val,
            vl,
            elem,
            !is_owned_obj || !in_loop_push,
          )
        }
        if (is_prim || is_owned_obj) && in_loop_push {
          if prom_len_slot2 != "" && g.bce_safe_push_arrs.contains(push_aname2) {
            let alen = qbe_tmp(g)
            let dp = qbe_tmp(g)
            let nlen = qbe_tmp(g)
            qbe_emit(g, alen + " =l loadl " + prom_len_slot2)
            qbe_emit(g, dp + " =l loadl " + prom_dp_slot2)
            let ep = qbe_emit_arr_ep_ty(g, dp, alen, elem)
            if qbe_is_u8_array_elem(g, elem) {
              qbe_store_arr_u8(g, vl, ep)
            } else if qbe_is_4b_array_elem(g, elem) {
              qbe_store_arr_4b_l(g, vl, ep)
            } else {
              qbe_emit(g, "storel " + vl + ", " + ep)
            }
            qbe_emit(g, nlen + " =l add " + alen + ", 1")
            qbe_emit(g, "storel " + nlen + ", " + prom_len_slot2)
          } else {
            let alen = qbe_tmp(g)
            let acap = qbe_tmp(g)
            let has_cap = qbe_tmp(g)
            let l_fast = qbe_lbl(g, "ap_fast")
            let l_slow = qbe_lbl(g, "ap_slow")
            let l_end = qbe_lbl(g, "ap_end")
            if prom_len_slot2 != "" {
              qbe_emit(g, alen + " =l loadl " + prom_len_slot2)
              qbe_emit(g, acap + " =l loadl " + prom_cap_slot2)
            } else {
              let cap_p = qbe_tmp(g)
              qbe_emit(g, alen + " =l loadl " + obj_val)
              qbe_emit(g, cap_p + " =l add " + obj_val + ", 8")
              qbe_emit(g, acap + " =l loadl " + cap_p)
            }
            qbe_emit(g, has_cap + " =w csltl " + alen + ", " + acap)
            qbe_emit_term(g, "jnz " + has_cap + ", " + l_fast + ", " + l_slow)
            qbe_emit_lbl(g, l_fast)
            let dp = qbe_tmp(g)
            let nlen = qbe_tmp(g)
            if prom_dp_slot2 != "" {
              qbe_emit(g, dp + " =l loadl " + prom_dp_slot2)
            } else {
              let dp_p = qbe_tmp(g)
              qbe_emit(g, dp_p + " =l add " + obj_val + ", 24")
              qbe_emit(g, dp + " =l loadl " + dp_p)
