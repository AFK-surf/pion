///| Unit tests for `bench`, `bench_loop`, `black_box[T]`, bench harness, and `syms_sidecar`

///|
fn bench_test_index_of(haystack : String, needle : String) -> Int {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 {
    return 0
  }
  if nlen > hlen {
    return -1
  }
  let mut i = 0
  while i <= hlen - nlen {
    let mut ok = true
    let mut j = 0
    while j < nlen {
      if str_code_at(haystack, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn bench_test_count(haystack : String, needle : String) -> Int {
  let hlen = haystack.length()
  let nlen = needle.length()
  if nlen == 0 || nlen > hlen {
    return 0
  }
  let mut count = 0
  let mut i = 0
  while i <= hlen - nlen {
    let mut ok = true
    let mut j = 0
    while j < nlen {
      if str_code_at(haystack, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      count = count + 1
      i = i + nlen
    } else {
      i = i + 1
    }
  }
  count
}

///|
test "bench: parse, format idempotence, and coexistence with fn bench" {
  let src =
  #|fn bench(n : Int) -> Int {
  #| let bench = n + 1
  #| let bench_loop = bench * 2
  #| bench_loop
  #|}
  #|
  #|bench "simple_add" {
  #| bench(10)
  #|}
  #|
  #|bench "fixture_loop" {
  #| let x = bench(5)
  #| bench_loop {
  #| x + 1
  #| }
  #| let _ = x
  #|}
  #|
  let (ok, json, _) = check_one(src)
  assert_true(ok, "bench + fn bench coexistence should type-check: " + json)
  let fmt1 = format_source(src)
  let fmt2 = format_source(fmt1)
  assert_true(fmt1 == fmt2, "format_source must be idempotent on bench/bench_loop")
  assert_true(str_contains(fmt1, "bench \"simple_add\" {"), "formatted keeps bench decl")
  assert_true(str_contains(fmt1, "bench_loop {"), "formatted keeps bench_loop stmt")
  let (ok2, json2, _) = check_one(fmt1)
  assert_true(ok2, "formatted bench source must still type-check: " + json2)
}

///|
test "bench: diagnostics for invalid bench_loop contexts, control flow, and #verify black_box" {
  // 1. bench_loop inside ordinary fn
  let (ok_fn, j_fn, _) = check_one("fn f() -> Unit {\n  bench_loop { 1 + 1 }\n}\n")
  assert_true(!ok_fn && str_contains(j_fn, "E_BENCH_LOOP_CONTEXT"), "fn bench_loop: " + j_fn)

  // 2. bench_loop inside test
  let (ok_tst, j_tst, _) = check_one("test \"t\" {\n  bench_loop { 1 + 1 }\n}\n")
  assert_true(!ok_tst && str_contains(j_tst, "E_BENCH_LOOP_CONTEXT"), "test bench_loop: " + j_tst)

  // 3. bench_loop inside closure or let-block initializer inside bench
  let (ok_clo, j_clo, _) = check_one(
    "bench \"b\" {\n  let f = fn() -> Unit { bench_loop { 1 } }\n  f()\n}\n",
  )
  assert_true(!ok_clo && str_contains(j_clo, "E_BENCH_LOOP_CONTEXT"), "closure bench_loop: " + j_clo)

  let (ok_letblk, j_letblk, _) = check_one(
    "bench \"b\" {\n  let x = { bench_loop { 1 } }\n  let _ = x\n}\n",
  )
  assert_true(!ok_letblk && str_contains(j_letblk, "E_BENCH_LOOP_CONTEXT"), "let block bench_loop: " + j_letblk)

  let (ok_letwild, j_letwild, _) = check_one(
    "bench \"b\" {\n  let _ = { bench_loop { 1 } }\n}\n",
  )
  assert_true(!ok_letwild && str_contains(j_letwild, "E_BENCH_LOOP_CONTEXT"), "let _ block bench_loop: " + j_letwild)

  // 4. bench_loop nested inside while inside bench
  let (ok_nest, j_nest, _) = check_one(
    "bench \"b\" {\n  let mut i = 0\n  while i < 1 {\n    bench_loop { i }\n    i = i + 1\n  }\n}\n",
  )
  assert_true(!ok_nest && str_contains(j_nest, "E_BENCH_LOOP_CONTEXT"), "nested bench_loop: " + j_nest)

  // 5. duplicate bench_loop in same bench
  let (ok_dup, j_dup, _) = check_one(
    "bench \"b\" {\n  bench_loop { 1 }\n  bench_loop { 2 }\n}\n",
  )
  assert_true(!ok_dup && str_contains(j_dup, "E_BENCH_LOOP_DUPLICATE"), "dup bench_loop: " + j_dup)

  // 6. break / continue / return directly inside bench_loop
  let (ok_brk, j_brk, _) = check_one("bench \"b\" {\n  bench_loop { break }\n}\n")
  assert_true(!ok_brk && str_contains(j_brk, "E_BENCH_LOOP_CONTROL_FLOW"), "break bench_loop: " + j_brk)

  let (ok_cnt, j_cnt, _) = check_one("bench \"b\" {\n  bench_loop { continue }\n}\n")
  assert_true(!ok_cnt && str_contains(j_cnt, "E_BENCH_LOOP_CONTROL_FLOW"), "continue bench_loop: " + j_cnt)

  let (ok_ret, j_ret, _) = check_one("bench \"b\" {\n  bench_loop { return }\n}\n")
  assert_true(!ok_ret && str_contains(j_ret, "E_BENCH_LOOP_CONTROL_FLOW"), "return bench_loop: " + j_ret)

  // 7. inner while break/continue and inner closure return inside bench_loop are allowed
  let (ok_inner, j_inner, _) = check_one(
    #|bench "b_inner" {
    #| bench_loop {
    #| let mut i = 0
    #| while i < 4 {
    #| i = i + 1
    #| if i == 2 { continue }
    #| if i == 3 { break }
    #| }
    #| let f = fn(x : Int) -> Int { return x + 1 }
    #| f(i)
    #| }
    #|}
    #|
  )
  assert_true(ok_inner, "inner loop break/continue and closure return should succeed: " + j_inner)

  // 8. #verify rejects black_box with E_VERIFY_UNSUPPORTED
  let (ok_ver, j_ver, _) = check_one("#verify\nfn f(x : Int) -> Int {\n  black_box(x)\n}\n")
  assert_true(!ok_ver && str_contains(j_ver, "E_VERIFY_UNSUPPORTED"), "#verify black_box: " + j_ver)

  // 9. black_box arity and named arg rejection
  let (ok_ar0, j_ar0, _) = check_one("fn f() -> Unit {\n  let _ = black_box()\n}\n")
  assert_true(!ok_ar0 && str_contains(j_ar0, "E_ARITY_MISMATCH"), "black_box 0 args: " + j_ar0)

  let (ok_nm, j_nm, _) = check_one("fn f(x : Int) -> Int {\n  black_box(x=x)\n}\n")
  assert_true(!ok_nm && str_contains(j_nm, "E_TYPE_MISMATCH"), "black_box named arg: " + j_nm)
}

///|
test "bench: zero-byte stripping in normal emit_qbe and emit_qbe_test_package" {
  let base_src =
  #|fn add(a : Int, b : Int) -> Int {
  #| a + b
  #|}
  #|
  #|test "unit_add" {
  #| if add(1, 2) != 3 {
  #| abort("bad")
  #| }
  #|}
  #|
  #|fn main() -> Unit {
  #| let _ = add(20, 22)
  #|}
  #|
  let with_bench_src =
  base_src +
  "\nbench \"bench_add\" {\n  let x = add(1, 2)\n  bench_loop {\n    add(x, 3)\n  }\n}\n"

  let cr_base = check_source_files_full("strip_pkg", ["main.pion"], [base_src])
  assert_true(cr_base.diagnostics.length() == 0, "base check ok: " + check_result_to_json(cr_base.diagnostics))
  let cr_with = check_source_files_full("strip_pkg", ["main.pion"], [with_bench_src])
  assert_true(cr_with.diagnostics.length() == 0, "with_bench check ok: " + check_result_to_json(cr_with.diagnostics))

  let rel_base = emit_qbe_package_with_tc(cr_base.pkg, cr_base.tc, true)
  let rel_with = emit_qbe_package_with_tc(cr_with.pkg, cr_with.tc, true)
  assert_true(rel_base.ssa == rel_with.ssa, "release emit_qbe must be byte-identical with bench blocks")

  let dev_base = emit_qbe_package_with_tc(cr_base.pkg, cr_base.tc, false)
  let dev_with = emit_qbe_package_with_tc(cr_with.pkg, cr_with.tc, false)
  assert_true(dev_base.ssa == dev_with.ssa, "dev emit_qbe must be byte-identical with bench blocks")

  let tst_base = emit_qbe_test_package(cr_base.pkg, cr_base.tc, [])
  let tst_with = emit_qbe_test_package(cr_with.pkg, cr_with.tc, [])
  assert_true(tst_base.ssa == tst_with.ssa, "emit_qbe_test_package must be byte-identical with bench blocks")
  assert_true(tst_base.test_names.length() == 1 && tst_with.test_names.length() == 1, "bench excluded from test_names")
}

///|
test "bench: black_box SSA register classes, RC zero-traffic, aggregates, Unit, and shadowing" {
  // 1. All 4 QBE register classes + String + val struct + Tuple + StrView
  let src_all =
  #|val struct Pair {
  #| a : Int
  #| b : Int
  #|}
  #|
  #|fn bb_int(x : Int) -> Int { black_box(x) }
  #|fn bb_i64(x : Int64) -> Int64 { black_box(x) }
  #|fn bb_f32(x : Float) -> Float { black_box(x) }
  #|fn bb_f64(x : Double) -> Double { black_box(x) }
  #|fn bb_str(s : String) -> String { black_box(s) }
  #|fn bb_val(p : Pair) -> Pair { black_box(p) }
  #|fn bb_tup(t : (Int, Int)) -> (Int, Int) { black_box(t) }
  #|fn bb_view(s : String) -> Int {
  #| let v = black_box(s.view(0, 1))
  #| v.length()
  #|}
  #|
  let cr = check_source_files_full("bb_pkg", ["bb.pion"], [src_all])
  assert_true(cr.diagnostics.length() == 0, "bb_pkg check: " + check_result_to_json(cr.diagnostics))
  let res = emit_qbe_package_with_tc(cr.pkg, cr.tc, true)
  let ssa = res.ssa
  assert_true(str_contains(ssa, "function w $__pion_bb_w(w %x)"), "emits local $__pion_bb_w")
  assert_true(str_contains(ssa, "function l $__pion_bb_l(l %x)"), "emits local $__pion_bb_l")
  assert_true(str_contains(ssa, "function s $__pion_bb_s(s %x)"), "emits local $__pion_bb_s")
  assert_true(str_contains(ssa, "function d $__pion_bb_d(d %x)"), "emits local $__pion_bb_d")
  assert_true(!str_contains(ssa, "export function w $__pion_bb_w"), "$__pion_bb_w must not be exported")
  assert_true(!str_contains(ssa, "export function l $__pion_bb_l"), "$__pion_bb_l must not be exported")
  assert_true(!str_contains(ssa, "export function s $__pion_bb_s"), "$__pion_bb_s must not be exported")
  assert_true(!str_contains(ssa, "export function d $__pion_bb_d"), "$__pion_bb_d must not be exported")
  assert_true(str_contains(ssa, "call $__pion_bb_w(w "), "Int calls $__pion_bb_w")
  assert_true(str_contains(ssa, "call $__pion_bb_l(l "), "Int64/String/agg calls $__pion_bb_l")
  assert_true(str_contains(ssa, "call $__pion_bb_s(s "), "Float calls $__pion_bb_s")
  assert_true(str_contains(ssa, "call $__pion_bb_d(d "), "Double calls $__pion_bb_d")

  // 2. RC managed object passthrough: 0 extra pion_rc_inc / pion_rc_dec
  let src_rc =
  #|fn mk(a : String, b : String) -> String {
  #| black_box(a + b)
  #|}
  #|
  let cr_rc = check_source_files_full("bb_rc", ["rc.pion"], [src_rc])
  assert_true(cr_rc.diagnostics.length() == 0, "bb_rc check ok")
  let ssa_rc = emit_qbe_package_with_tc(cr_rc.pkg, cr_rc.tc, true).ssa
  assert_true(str_contains(ssa_rc, "call $__pion_bb_l(l "), "String calls $__pion_bb_l")
  assert_true(!str_contains(ssa_rc, "call $pion_rc_inc("), "owned String passthrough has 0 rc_inc")
  assert_true(!str_contains(ssa_rc, "call $pion_rc_dec("), "owned String passthrough has 0 rc_dec")

  // 3. Unit evaluates side effect and emits NO $__pion_bb_*
  let src_unit =
  #|fn side() -> Unit { () }
  #|fn bb_unit() -> Unit { black_box(side()) }
  #|
  let cr_u = check_source_files_full("bb_unit", ["u.pion"], [src_unit])
  assert_true(cr_u.diagnostics.length() == 0, "bb_unit check ok")
  let ssa_u = emit_qbe_package_with_tc(cr_u.pkg, cr_u.tc, true).ssa
  assert_true(!str_contains(ssa_u, "$__pion_bb_"), "Unit black_box emits no $__pion_bb_*")

  // 4. User fn black_box shadows builtin
  let src_shadow =
  #|fn black_box(x : Int) -> Int { x + 7 }
  #|fn use_shadow(x : Int) -> Int { black_box(x) }
  #|
  let cr_sh = check_source_files_full("bb_sh", ["sh.pion"], [src_shadow])
  assert_true(cr_sh.diagnostics.length() == 0, "bb_sh check ok")
  let ssa_sh = emit_qbe_package_with_tc(cr_sh.pkg, cr_sh.tc, true).ssa
  assert_true(!str_contains(ssa_sh, "$__pion_bb_"), "user fn black_box shadows builtin")
}

///|
test "bench: emit_qbe_benches harness order, prof window, and syms_sidecar" {
  let src =
  #|struct Box {
  #| s : String
  #|}
  #|
  #|fn Box::len(self : Box) -> Int {
  #| self.s.length()
  #|}
  #|
  #|fn work(n : Int) -> Int {
  #| let f = fn(x : Int) -> Int { x + 1 }
  #| f(n)
  #|}
  #|
  #|bench "simple" {
  #| work(42)
  #|}
  #|
  #|bench "with_fixture" {
  #| let b = Box::{ s: "hello" }
  #| let mut acc = 0
  #| bench_loop {
  #| acc = acc + b.len()
  #| acc
  #| }
  #| let _ = acc
  #|}
  #|
  let cr = check_source_files_full("bpkg", ["bench_sample.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, "bpkg check: " + check_result_to_json(cr.diagnostics))

  // Clean mode (prof_enabled=false, emit_syms_sidecar=false)
  let clean = emit_qbe_benches(cr.pkg, cr.tc, [])
  assert_true(clean.bench_names.length() == 2, "2 benches emitted")
  assert_true(clean.bench_names[0] == "simple", "bench 0 name")
  assert_true(clean.bench_names[1] == "with_fixture", "bench 1 name")
  assert_true(clean.syms_sidecar == "", "syms_sidecar empty when disabled")
  assert_true(str_contains(clean.ssa, "function w $__pion_bench_run_0(l %iters, w %prof_win)"), "run_0 signature")
  assert_true(str_contains(clean.ssa, "function w $__pion_bench_run_1(l %iters, w %prof_win)"), "run_1 signature")
  assert_true(str_contains(clean.ssa, "call $pion_clock_monotonic_us()"), "monotonic clock call")
  assert_true(str_contains(clean.ssa, "storel "), "stores elapsed us")
  assert_true(str_contains(clean.ssa, "$__pion_bench_elapsed_us"), "elapsed_us global")
  assert_true(str_contains(clean.ssa, "call $__pion_bb_w(w "), "auto black_box on Int tail expr")
  assert_true(!str_contains(clean.ssa, "$pion_prof_resume"), "clean mode omits pion_prof_resume")
  assert_true(!str_contains(clean.ssa, "$pion_prof_pause"), "clean mode omits pion_prof_pause")

  // Profiled mode + syms_sidecar enabled
  let prof = emit_qbe_benches_target(cr.pkg, cr.tc, [], "", true, true, true)
  let p_ssa = prof.ssa
  let idx_r1 = bench_test_index_of(p_ssa, "function w $__pion_bench_run_1(l %iters, w %prof_win)")
  assert_true(idx_r1 >= 0, "found run_1 in prof ssa")
  let r1_tail = slice_str(p_ssa, idx_r1, p_ssa.length())
  let idx_t0 = bench_test_index_of(r1_tail, "call $pion_clock_monotonic_us()")
  let idx_res = bench_test_index_of(r1_tail, "call $pion_prof_resume()")
  let idx_bb = bench_test_index_of(r1_tail, "call $__pion_bb_w(")
  let idx_pau = bench_test_index_of(r1_tail, "call $pion_prof_pause()")
  assert_true(idx_t0 > 0 && idx_res > idx_t0 && idx_bb > idx_res && idx_pau > idx_bb, "timing/prof window order: t0 < resume < body(bb) < pause")
  assert_true(bench_test_count(r1_tail, "call $pion_clock_monotonic_us()") >= 2, "t0 and t1 both called")

  // syms_sidecar verification
  let syms = prof.syms_sidecar
  assert_true(str_contains(syms, "\twork\tfn\tbpkg\tbench_sample.pion\t"), "syms has fn work: " + syms)
  assert_true(str_contains(syms, "\tBox::len\tmethod\tbpkg\tbench_sample.pion\t"), "syms has method Box::len: " + syms)
  assert_true(str_contains(syms, "\tclosure\tbpkg\tbench_sample.pion\t"), "syms has closure: " + syms)
  assert_true(str_contains(syms, "\tdrop\tbpkg\t"), "syms has drop: " + syms)
  assert_true(str_contains(syms, "__pion_bench_run_0\tbench simple\tbench\tbpkg\tbench_sample.pion\t"), "syms has bench 0: " + syms)

  // Package syms_sidecar toggle check
  let pkg_off = emit_qbe_package_multi_entry_target_opts_syms(cr.pkg, cr.tc, true, true, [], false, "", "main", false, 0, false)
  let pkg_on = emit_qbe_package_multi_entry_target_opts_syms(cr.pkg, cr.tc, true, true, [], false, "", "main", false, 0, true)
  assert_true(pkg_off.syms_sidecar == "", "pkg syms_sidecar empty when disabled")
  assert_true(pkg_off.ssa == pkg_on.ssa, "enabling syms_sidecar does not change SSA")
  assert_true(str_contains(pkg_on.syms_sidecar, "\twork\tfn\tbpkg\tbench_sample.pion\t"), "pkg syms_sidecar has fn work")
}

///|
test "bench: multiple owned RC setup locals stay alive across bench_loop" {
  let src =
  #|fn pair_len(a : String, b : String) -> Int {
  #| a.length() + b.length()
  #|}
  #|
  #|bench "multi_rc_setup" {
  #| let n = 42
  #| let a = "hello_" + n.to_string()
  #| let b = "world_" + n.to_string()
  #| bench_loop {
  #| black_box(pair_len(a, b))
  #| }
  #|}
  #|
  let cr = check_source_files_full("bmulti", ["multi_rc.pion"], [src])
  assert_true(cr.diagnostics.length() == 0, "bmulti check: " + check_result_to_json(cr.diagnostics))
  let res = emit_qbe_benches(cr.pkg, cr.tc, [])
  let idx_fn = bench_test_index_of(res.ssa, "function w $__pion_bench_run_0(l %iters, w %prof_win)")
  assert_true(idx_fn >= 0, "found $__pion_bench_run_0")
  let fn_tail = slice_str(res.ssa, idx_fn, res.ssa.length())
  let idx_end = bench_test_index_of(fn_tail, "\n}\n")
  let fn_ssa = if idx_end > 0 { slice_str(fn_tail, 0, idx_end) } else { fn_tail }
  let idx_loop_hdr = bench_test_index_of(fn_ssa, "@bl_h")
  assert_true(idx_loop_hdr > 0, "found bench loop header @bl_h")
  let setup_ssa = slice_str(fn_ssa, 0, idx_loop_hdr)
  // Neither setup String `a` nor `b` may be early-dropped before `@bl_h`:
  // only temporary `n.to_string()` results are released during setup, whereas
  // an early drop of `a` would zero its local slot (`storel 0, %t...`) after storing it.
  // Specifically, there must be NO `pion_rc_dec` emitted after `a` is bound except for
  // the temporary `n.to_string()` in `b`'s initializer (2 `pion_rc_dec` total for 2 `to_string()`),
  // never 3 (which would mean `a` was prematurely early-dropped).
  let setup_decs = bench_test_count(setup_ssa, "call $pion_rc_dec(")
  assert_true(
    setup_decs <= 2,
    "setup must not early-drop owned RC local `a` before bench_loop (found " +
    setup_decs.to_string() +
    " rc_dec in setup):\n" +
    setup_ssa,
  )
}
