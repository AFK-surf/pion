///|
pub fn parse_package(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> Package {
  let files : Array[SourceFile] = []
  let mut i = 0
  while i < paths.length() && i < sources.length() {
    let pr = parse_source(paths[i], sources[i])
    files.push(pr.file)
    i = i + 1
  }
  Package::{ name: pkg_name, files: files }
}

///|
pub fn query_defs_json(pkg : Package) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"defs\":[")
  let _ = query_defs_write(pkg, sb, 0)
  sb.write_string("]}")
  sb.to_string()
}

///|
/// Writes `pkg`'s definition objects (comma-separated, after `count` earlier
/// items) and returns the new item count.
fn query_defs_write(pkg : Package, sb : StringBuilder, count0 : Int) -> Int {
  let mut count = count0
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      if count > 0 {
        sb.write_string(",")
      }
      count = count + 1
      match f.decls[di] {
        DStruct(sd) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(sd.name))
          sb.write_string(",\"kind\":\"struct\",\"pub\":")
          sb.write_string(if sd.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(sd.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(sd.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_struct_sig(sd)))
          sb.write_string("}")
        }
        DEnum(ed) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(ed.name))
          sb.write_string(",\"kind\":\"enum\",\"pub\":")
          sb.write_string(if ed.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(ed.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(ed.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_enum_sig(ed)))
          sb.write_string("}")
        }
        DFn(fd) => {
          let full_name = if fd.receiver_type != "" {
            fd.receiver_type + "::" + fd.name
          } else {
            fd.name
          }
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(full_name))
          sb.write_string(",\"kind\":\"fn\",\"pub\":")
          sb.write_string(if fd.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(fd.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(fd.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_fn_sig(fd)))
          sb.write_string("}")
        }
        DExternFn(ed) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(ed.name))
          sb.write_string(",\"kind\":\"extern_fn\",\"pub\":")
          sb.write_string(if ed.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(ed.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(ed.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_extern_fn_sig(ed)))
          sb.write_string("}")
        }
        DTrait(td) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(td.name))
          sb.write_string(",\"kind\":\"trait\",\"pub\":")
          sb.write_string(if td.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(td.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(td.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_trait_sig(td)))
          sb.write_string("}")
        }
        DImpl(id) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(id.trait_name + "::" + id.target_type))
          sb.write_string(",\"kind\":\"impl\",\"pub\":true,\"file\":")
          sb.write_string(json_quote(id.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(id.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_impl_sig(id)))
          sb.write_string("}")
        }
        DConst(cd) => {
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(cd.name))
          sb.write_string(",\"kind\":\"const\",\"pub\":")
          sb.write_string(if cd.is_pub { "true" } else { "false" })
          sb.write_string(",\"file\":")
          sb.write_string(json_quote(cd.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(cd.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(format_const_sig(cd)))
          sb.write_string("}")
        }
        DTest(td) => {
          let dk = if td.is_bench { "bench" } else { "test" }
          sb.write_string("{\"pkg\":")
          sb.write_string(json_quote(pkg.name))
          sb.write_string(",\"name\":")
          sb.write_string(json_quote(td.name))
          sb.write_string(",\"kind\":\"")
          sb.write_string(dk)
          sb.write_string("\",\"pub\":false,\"file\":")
          sb.write_string(json_quote(td.span.file))
          sb.write_string(",\"line\":")
          sb.write_string(td.span.line.to_string())
          sb.write_string(",\"sig\":")
          sb.write_string(json_quote(dk + " \"" + td.name + "\""))
          sb.write_string("}")
        }
      }
      di = di + 1
    }
    fi = fi + 1
  }
  count
}

///|
pub fn query_sig_json(pkg : Package) -> String {
  package_sig_to_json(extract_package_sig(pkg))
}

///|
fn push_unique(arr : Array[String], item : String) -> Unit {
  if !str_arr_contains(arr, item) {
    arr.push(item)
  }
}

///|
fn collect_stmt_calls(stmts : Array[Stmt], out : Array[String]) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) => collect_expr_calls(init, out)
      SLetTuple(_, _, init, _) => collect_expr_calls(init, out)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        collect_expr_calls(lhs, out)
        collect_expr_calls(rhs, out)
      }
      SGuard(cond, else_body, _) => {
        collect_expr_calls(cond, out)
        collect_stmt_calls(else_body, out)
      }
      SWhile(cond, body, _) => {
        collect_expr_calls(cond, out)
        collect_stmt_calls(body, out)
      }
      SBenchLoop(body, _) => collect_stmt_calls(body, out)
      SFor(init_s, cond, step_s, body, _) => {
        collect_stmt_calls([init_s], out)
        collect_expr_calls(cond, out)
        collect_stmt_calls([step_s], out)
        collect_stmt_calls(body, out)
      }
      SForRange(_, start_e, end_e, _, body, _) => {
        collect_expr_calls(start_e, out)
        collect_expr_calls(end_e, out)
        collect_stmt_calls(body, out)
      }
      SForIn(_, _, iter_e, body, _) => {
        collect_expr_calls(iter_e, out)
        collect_stmt_calls(body, out)
      }
      SReturn(opt, _) =>
        match opt {
          Some(e) => collect_expr_calls(e, out)
          None => ()
        }
      SBreak(_) | SContinue(_) => ()
      SDebugAssert(c, m, _) => {
        push_unique(out, "debug_assert")
        collect_expr_calls(c, out)
        collect_expr_calls(m, out)
      }
      SExpr(e, _) => collect_expr_calls(e, out)
    }
    i = i + 1
  }
}

///|
fn collect_expr_calls(e : Expr, out : Array[String]) -> Unit {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EDouble(_, _) | EFloat(_, _) | EBool(_, _) => ()
    EByte(_, _) | EChar(_, _) | EString(_, _) | EUnit(_) => ()
    EIdent(_, _) | EPath(_, _, _) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      collect_expr_calls(inner, out)
    EInterp(parts, _) | EDotVariant(_, parts, _) => {
      let mut i = 0
      while i < parts.length() {
        collect_expr_calls(parts[i], out)
        i = i + 1
      }
    }
    EBinary(_, l, r, _) => {
      collect_expr_calls(l, out)
      collect_expr_calls(r, out)
    }
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => push_unique(out, name)
        EPath(qual, mem, _) => push_unique(out, qual + "::" + mem)
        _ => collect_expr_calls(callee, out)
      }
      let mut i = 0
      while i < args.length() {
        collect_expr_calls(args[i], out)
        i = i + 1
      }
    }
    EField(obj, _, _) => collect_expr_calls(obj, out)
    EMethodCall(obj, method_name, args, _) => {
      push_unique(out, "." + method_name)
      collect_expr_calls(obj, out)
      let mut i = 0
      while i < args.length() {
        collect_expr_calls(args[i], out)
        i = i + 1
      }
    }
    EIndex(obj, idx, _) => {
      collect_expr_calls(obj, out)
      collect_expr_calls(idx, out)
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        collect_expr_calls(elems[i], out)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => collect_expr_calls(base, out)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        collect_expr_calls(fields[i].value, out)
        i = i + 1
      }
    }
    EBlock(stmts, _) => collect_stmt_calls(stmts, out)
    EIf(cond, then_s, else_opt, _) => {
      collect_expr_calls(cond, out)
      collect_stmt_calls(then_s, out)
      match else_opt {
        Some(el) => collect_expr_calls(el, out)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      collect_expr_calls(scrut, out)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => collect_expr_calls(ge, out)
          None => ()
        }
        collect_expr_calls(arms[i].body, out)
        i = i + 1
      }
    }
    EIs(scrut, _, _) => collect_expr_calls(scrut, out)
    EClosure(_, _, body, _) => collect_stmt_calls(body, out)
    EScope(w, f, _) => {
      push_unique(out, "scope")
      collect_expr_calls(w, out)
      collect_expr_calls(f, out)
    }
    ESpawn(s, f, _) => {
      push_unique(out, "spawn")
      collect_expr_calls(s, out)
      collect_expr_calls(f, out)
    }
  }
}

///|
pub fn query_callers_json(pkg : Package) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"callers\":[")
  let _ = query_callers_write(pkg, false, sb, 0)
  sb.write_string("]}")
  sb.to_string()
}

///|
/// Writes `pkg`'s caller objects (with a leading `"pkg"` key when `with_pkg`)
/// and returns the new item count.
fn query_callers_write(
  pkg : Package,
  with_pkg : Bool,
  sb : StringBuilder,
  count0 : Int,
) -> Int {
  let mut count = count0
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => {
          if count > 0 {
            sb.write_string(",")
          }
          count = count + 1
          let full_name = if fd.receiver_type != "" {
            fd.receiver_type + "::" + fd.name
          } else {
            fd.name
          }
          let calls : Array[String] = []
          collect_stmt_calls(fd.body, calls)
          if with_pkg {
            sb.write_string("{\"pkg\":")
            sb.write_string(json_quote(pkg.name))
            sb.write_string(",\"fn\":")
          } else {
            sb.write_string("{\"fn\":")
          }
          sb.write_string(json_quote(full_name))
          sb.write_string(",\"calls\":[")
          let mut ci = 0
          while ci < calls.length() {
            if ci > 0 {
              sb.write_string(",")
            }
            sb.write_string(json_quote(calls[ci]))
            ci = ci + 1
          }
          sb.write_string("]}")
        }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  count
}

///|
/// `pionc query defs|sig|callers` over every package of a workspace
/// (dependencies first): one `defs`/`callers` table whose items carry their
/// `pkg`, or one exported-signature table per package for `sig`.
pub fn query_workspace_json(
  kind : String,
  pkgs : Array[Package],
) -> Result[String, String] {
  let sb = StringBuilder()
  if kind == "defs" {
    sb.write_string("{\"defs\":[")
    let mut count = 0
    let mut i = 0
    while i < pkgs.length() {
      count = query_defs_write(pkgs[i], sb, count)
      i = i + 1
    }
    sb.write_string("]}")
  } else if kind == "callers" {
    sb.write_string("{\"callers\":[")
    let mut count = 0
    let mut i = 0
    while i < pkgs.length() {
      count = query_callers_write(pkgs[i], true, sb, count)
      i = i + 1
    }
    sb.write_string("]}")
  } else if kind == "sig" {
    sb.write_string("{\"packages\":[")
    let mut i = 0
    while i < pkgs.length() {
      if i > 0 {
        sb.write_string(",")
      }
      sb.write_string("{\"name\":")
      sb.write_string(json_quote(pkgs[i].name))
      sb.write_string(",\"sig\":")
      sb.write_string(query_sig_json(pkgs[i]))
      sb.write_string("}")
      i = i + 1
    }
    sb.write_string("]}")
  } else {
    return Err(
      "unknown workspace query kind `" + kind + "` (expected defs|sig|callers|deps)",
    )
  }
  Ok(sb.to_string())
}

///|
pub fn query_deps_json(pkg : Package) -> String {
  let sig_text = emit_pionsig(pkg)
  let hash = sig_hash_hex(sig_text)
  let deps : Array[String] = []
  let local_types : Map[String, Bool] = Map([])
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) => local_types.set(sd.name, true)
        DEnum(ed) => local_types.set(ed.name, true)
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  // Collect builtin/runtime capability dependencies used by this package
  fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DFn(fd) => {
          let calls : Array[String] = []
          collect_stmt_calls(fd.body, calls)
          let mut ci = 0
          while ci < calls.length() {
            let c = calls[ci]
            if c == "scope" || c == "spawn" || starts_with_str(c, "Channel::") || starts_with_str(c, "Mutex::") || starts_with_str(c, "AtomicInt::") {
              push_unique(deps, "pion/runtime/concurrency")
            } else if is_world_builtin(c) || is_world_rt_prim(c) {
              push_unique(deps, "pion/runtime/world")
            }
            ci = ci + 1
          }
        }
        DExternFn(ed) =>
          if ed.has_body {
            let calls : Array[String] = []
            collect_stmt_calls(ed.body, calls)
            let mut ci = 0
            while ci < calls.length() {
              let c = calls[ci]
              if c == "scope" || c == "spawn" || starts_with_str(c, "Channel::") || starts_with_str(c, "Mutex::") || starts_with_str(c, "AtomicInt::") {
                push_unique(deps, "pion/runtime/concurrency")
              } else if is_world_builtin(c) || is_world_rt_prim(c) {
                push_unique(deps, "pion/runtime/world")
              }
              ci = ci + 1
            }
          }
        _ => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"packages\":[{\"name\":")
  sb.write_string(json_quote(pkg.name))
  sb.write_string(",\"deps\":[")
  let mut i = 0
  while i < deps.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(deps[i]))
    i = i + 1
  }
  sb.write_string("],\"sig_hash\":")
  sb.write_string(json_quote(hash))
  sb.write_string("}]}")
  sb.to_string()
}

///|
pub fn cli_check_json(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> (Bool, String) {
  let cr = check_source_files(pkg_name, paths, sources)
  let ok = cr.diagnostics.length() == 0
  (ok, check_result_to_json(cr.diagnostics))
}

///|
pub fn cli_query_json(
  kind : String,
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> Result[String, String] {
  let pkg = parse_package(pkg_name, paths, sources)
  if kind == "defs" {
    Ok(query_defs_json(pkg))
  } else if kind == "sig" {
    Ok(query_sig_json(pkg))
  } else if kind == "callers" {
    Ok(query_callers_json(pkg))
  } else if kind == "deps" {
    Ok(query_deps_json(pkg))
  } else if kind == "analyze" {
    let cr = check_source_files_with_imports_ex(
      pkg_name,
      paths,
      sources,
      [],
      false,
      true,
    )
    Ok(query_analyze_packages_json([cr], cr.diagnostics))
  } else {
    Err("unknown query kind `" + kind + "` (expected defs|sig|callers|deps|analyze)")
  }
}

///|
pub fn cli_emit_sig(
  pkg_name : String,
  paths : Array[String],
  sources : Array[String],
) -> String {
  let pkg = parse_package(pkg_name, paths, sources)
  emit_pionsig(pkg)
}

///|
pub struct DocItem {
  kind : String
  name : String
  sig : String
  file : String
  line : Int
}

///|
/// Public API surface of a package: every `pub` struct/enum/trait/extern fn/fn/const
/// and every `impl`, in declaration order.
pub fn doc_package_items(pkg : Package) -> Array[DocItem] {
  let out : Array[DocItem] = []
  let mut fi = 0
  while fi < pkg.files.length() {
    let f = pkg.files[fi]
    let mut di = 0
    while di < f.decls.length() {
      match f.decls[di] {
        DStruct(sd) =>
          if sd.is_pub {
            out.push(DocItem::{
              kind: "struct",
              name: sd.name,
              sig: format_struct_sig(sd),
              file: sd.span.file,
              line: sd.span.line,
            })
          }
        DEnum(ed) =>
          if ed.is_pub {
            out.push(DocItem::{
              kind: "enum",
              name: ed.name,
              sig: format_enum_sig(ed),
              file: ed.span.file,
              line: ed.span.line,
            })
          }
        DTrait(td) =>
          if td.is_pub {
            out.push(DocItem::{
              kind: "trait",
              name: td.name,
              sig: format_trait_sig(td),
              file: td.span.file,
              line: td.span.line,
            })
          }
        DImpl(id) =>
          out.push(DocItem::{
            kind: "impl",
            name: id.trait_name + " for " + id.target_type,
            sig: format_impl_sig(id),
            file: id.span.file,
            line: id.span.line,
          })
        DExternFn(ed) =>
          if ed.is_pub {
            out.push(DocItem::{
              kind: "extern_fn",
              name: ed.name,
              sig: format_extern_fn_sig(ed),
              file: ed.span.file,
              line: ed.span.line,
            })
          }
        DFn(fd) =>
          if fd.is_pub {
            let full_name = if fd.receiver_type != "" {
              fd.receiver_type + "::" + fd.name
            } else {
              fd.name
            }
            out.push(DocItem::{
              kind: "fn",
              name: full_name,
              sig: format_fn_sig(fd),
              file: fd.span.file,
              line: fd.span.line,
            })
          }
        DConst(cd) =>
          if cd.is_pub {
            out.push(DocItem::{
              kind: "const",
              name: cd.name,
              sig: format_const_sig(cd),
              file: cd.span.file,
              line: cd.span.line,
            })
          }
        DTest(_) => ()
      }
      di = di + 1
    }
    fi = fi + 1
  }
  out
}

///|
/// `{"name":"pkg","items":[{"kind":..,"name":..,"sig":..,"file":..,"line":..}]}`
pub fn doc_package_json(pkg : Package) -> String {
  let items = doc_package_items(pkg)
  let sb = StringBuilder()
  sb.write_string("{\"name\":")
  sb.write_string(json_quote(pkg.name))
  sb.write_string(",\"items\":[")
  let mut i = 0
  while i < items.length() {
    let it = items[i]
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"kind\":")
    sb.write_string(json_quote(it.kind))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(it.name))
    sb.write_string(",\"sig\":")
    sb.write_string(json_quote(it.sig))
    sb.write_string(",\"file\":")
    sb.write_string(json_quote(it.file))
    sb.write_string(",\"line\":")
    sb.write_string(it.line.to_string())
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// One line per public item under a `package <name>` header.
pub fn doc_package_text(pkg : Package) -> String {
  let items = doc_package_items(pkg)
  let sb = StringBuilder()
  sb.write_string("package ")
  sb.write_string(pkg.name)
  sb.write_string("\n")
  let mut i = 0
  while i < items.length() {
    sb.write_string("  ")
    sb.write_string(items[i].sig)
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///|
/// Workspace summary: `{"packages":[<doc_package_json>...]}`.
pub fn doc_packages_json(pkgs : Array[Package]) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"packages\":[")
  let mut i = 0
  while i < pkgs.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(doc_package_json(pkgs[i]))
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
pub fn doc_packages_text(pkgs : Array[Package]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < pkgs.length() {
    sb.write_string(doc_package_text(pkgs[i]))
    i = i + 1
  }
  sb.to_string()
}

///|
/// Parse diagnostics of a package, empty when every file parsed cleanly.
pub fn parse_package_diagnostics(
  paths : Array[String],
  sources : Array[String],
) -> Array[Diagnostic] {
  let out : Array[Diagnostic] = []
  let mut i = 0
  while i < paths.length() && i < sources.length() {
    let pr = parse_source(paths[i], sources[i])
    let mut di = 0
    while di < pr.diagnostics.length() {
      out.push(pr.diagnostics[di])
      di = di + 1
    }
    i = i + 1
  }
  out
}

///|
struct AnalyzeCallSite {
  target : String
  line : Int
  col : Int
}

///|
struct AnalyzeClosureRec {
  pkg : String
  enclosing_fn : String
  file : String
  line : Int
  col : Int
  context_callee : String
  context_arg : String
  captures : Array[AnalyzeCapture]
  calls : Array[AnalyzeCallSite]
}

///|
fn analyze_format_named_ty(
  tc : TypeChecker,
  name : String,
  args : Array[Ty],
) -> String {
  let qname = tc_qualify_local_name(tc, name)
  if args.length() == 0 {
    return qname
  }
  let sb = StringBuilder()
  sb.write_string(qname)
  sb.write_string("[")
  let mut i = 0
  while i < args.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(analyze_ty_to_string(tc, args[i]))
    i = i + 1
  }
  sb.write_string("]")
  sb.to_string()
}

///|
fn analyze_ty_to_string(tc : TypeChecker, t : Ty) -> String {
  match t {
    TInt => "Int"
    TInt64 => "Int64"
    TUInt => "UInt"
    TUInt64 => "UInt64"
    TDouble => "Double"
    TFloat => "Float"
    TBool => "Bool"
    TByte => "Byte"
    TInt8 => "Int8"
    TChar => "Char"
    TString => "String"
    TUnit => "Unit"
    TPtr => "Ptr"
    TStringBuilder => "StringBuilder"
    TBytes => "Bytes"
    TStrView => "StrView"
    TBytesView => "BytesView"
    TWorld => "World"
    TScope => "Scope"
    TAtomicInt => "AtomicInt"
    TArray(e) => "Array[" + analyze_ty_to_string(tc, e) + "]"
    TFixedArray(e) => "FixedArray[" + analyze_ty_to_string(tc, e) + "]"
    TImmArray(e) => "ImmArray[" + analyze_ty_to_string(tc, e) + "]"
    TOption(e) => "Option[" + analyze_ty_to_string(tc, e) + "]"
    TResult(ok, err) =>
      "Result[" +
      analyze_ty_to_string(tc, ok) +
      ", " +
      analyze_ty_to_string(tc, err) +
      "]"
    TMap(k, v) =>
      "Map[" +
      analyze_ty_to_string(tc, k) +
      ", " +
      analyze_ty_to_string(tc, v) +
      "]"
    TChannel(e) => "Channel[" + analyze_ty_to_string(tc, e) + "]"
    TMutex(e) => "Mutex[" + analyze_ty_to_string(tc, e) + "]"
    TStruct(name, args) => analyze_format_named_ty(tc, name, args)
    TEnum(name, args) => analyze_format_named_ty(tc, name, args)
    TFn(params, ret) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < params.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_string(analyze_ty_to_string(tc, params[i]))
        i = i + 1
      }
      sb.write_string(") -> ")
      sb.write_string(analyze_ty_to_string(tc, ret))
      sb.to_string()
    }
    TTuple(elems) => {
      let sb = StringBuilder()
      sb.write_string("(")
      let mut i = 0
      while i < elems.length() {
        if i > 0 {
          sb.write_string(", ")
        }
        sb.write_string(analyze_ty_to_string(tc, elems[i]))
        i = i + 1
      }
      sb.write_string(")")
      sb.to_string()
    }
    TDynTrait(n) => "dyn " + tc_qualify_local_name(tc, n)
    TParam(n) => n
    TNever => "Never"
    TError => "<error>"
  }
}

///|
fn analyze_lookup_enum_info(tc : TypeChecker, ename : String) -> Option[EnumInfo] {
  match tc.enums.get(ename) {
    Some(ei) => Some(ei)
    None => {
      let qp = split_qual_name(ename)
      if qp.prefix.length() > 0 {
        match lookup_imported_pkg_transitive(tc, qp.prefix) {
          Some(ipkg) =>
            match ipkg.tc.enums.get(qp.name) {
              Some(ei) => {
                let qvs : Array[VariantInfo] = []
                let mut vi = 0
                while vi < ei.variants.length() {
                  let v = ei.variants[vi]
                  let qftys : Array[Ty] = []
                  let mut fi = 0
                  while fi < v.field_tys.length() {
                    qftys.push(qualify_imported_ty(ipkg.name, v.field_tys[fi]))
                    fi = fi + 1
                  }
                  qvs.push(VariantInfo::{ name: v.name, field_tys: qftys })
                  vi = vi + 1
                }
                Some(EnumInfo::{ decl: ei.decl, variants: qvs })
              }
              None => None
            }
          None => None
        }
      } else {
        None
      }
    }
  }
}

///|
fn analyze_struct_has_mut_fields(
  tc : TypeChecker,
  sname : String,
  sargs : Array[Ty],
  visited : Map[String, Bool],
) -> Bool {
  let key = "struct:" + tc_qualify_local_name(tc, sname)
  if visited.contains(key) {
    return false
  }
  visited.set(key, true)
  match tc_lookup_struct_info(tc, sname) {
    None => false
    Some(si) => {
      let subst = make_subst(si.decl.type_params, sargs)
      let mut i = 0
      while i < si.field_tys.length() {
        if i < si.field_muts.length() && si.field_muts[i] {
          return true
        }
        let fty = subst_ty(si.field_tys[i], subst)
        if analyze_ty_is_mutable(tc, fty, visited) {
          return true
        }
        i = i + 1
      }
      false
    }
  }
}

///|
fn analyze_enum_has_mut_fields(
  tc : TypeChecker,
  ename : String,
  eargs : Array[Ty],
  visited : Map[String, Bool],
) -> Bool {
  let key = "enum:" + tc_qualify_local_name(tc, ename)
  if visited.contains(key) {
    return false
  }
  visited.set(key, true)
  match analyze_lookup_enum_info(tc, ename) {
    None => false
    Some(ei) => {
      let subst = make_subst(ei.decl.type_params, eargs)
      let mut vi = 0
      while vi < ei.variants.length() {
        let v = ei.variants[vi]
        let mut fi = 0
        while fi < v.field_tys.length() {
          let fty = subst_ty(v.field_tys[fi], subst)
          if analyze_ty_is_mutable(tc, fty, visited) {
            return true
          }
          fi = fi + 1
        }
        vi = vi + 1
      }
      false
    }
  }
}

///|
fn analyze_ty_is_mutable(
  tc : TypeChecker,
  t : Ty,
  visited : Map[String, Bool],
) -> Bool {
  match t {
    TArray(_) | TFixedArray(_) | TMap(_, _) | TBytes | TStringBuilder => true
    TImmArray(inner) => analyze_ty_is_mutable(tc, inner, visited)
    TOption(inner) => analyze_ty_is_mutable(tc, inner, visited)
    TResult(ok, err) =>
      analyze_ty_is_mutable(tc, ok, visited) ||
      analyze_ty_is_mutable(tc, err, visited)
    TTuple(elems) => {
      let mut i = 0
      while i < elems.length() {
        if analyze_ty_is_mutable(tc, elems[i], visited) {
          return true
        }
        i = i + 1
      }
      false
    }
    TStruct(sname, sargs) =>
      analyze_struct_has_mut_fields(tc, sname, sargs, visited)
    TEnum(ename, eargs) =>
      analyze_enum_has_mut_fields(tc, ename, eargs, visited)
    _ => false
  }
}

///|
fn analyze_is_val_struct(tc : TypeChecker, t : Ty) -> Bool {
  match t {
    TStruct(sname, _) =>
      match tc_lookup_struct_info(tc, sname) {
        Some(si) => si.decl.is_val
        None => false
      }
    _ => false
  }
}

///|
fn analyze_ty_struct_has_mut_fields(tc : TypeChecker, t : Ty) -> Bool {
  match t {
    TStruct(sname, sargs) =>
      analyze_struct_has_mut_fields(tc, sname, sargs, Map([]))
    _ => false
  }
}

///|
fn analyze_emit_closure(
  tc : TypeChecker,
  enclosing_fn : String,
  cbody : Array[Stmt],
  csp : Span,
  context_callee : String,
  context_arg : String,
  closures : Array[AnalyzeClosureRec],
) -> Unit {
  let caps = match tc.analyze_closure_captures.get(span_key(csp)) {
    Some(cs) => cs
    None => []
  }
  let clo_calls : Array[AnalyzeCallSite] = []
  closures.push(AnalyzeClosureRec::{
    pkg: tc.pkg_name,
    enclosing_fn: enclosing_fn,
    file: csp.file,
    line: csp.line,
    col: csp.col,
    context_callee: context_callee,
    context_arg: context_arg,
    captures: caps,
    calls: clo_calls,
  })
  analyze_walk_stmts(tc, enclosing_fn, cbody, clo_calls, closures)
}

///|
fn analyze_walk_call_args(
  tc : TypeChecker,
  enclosing_fn : String,
  call_sp : Span,
  args : Array[Expr],
  callee_target : String,
  calls : Array[AnalyzeCallSite],
  closures : Array[AnalyzeClosureRec],
) -> Unit {
  let has_into = tc.call_into_convs.length() > 0
  let prefix = if has_into { span_key(call_sp) + "#" } else { "" }
  let mut i = 0
  while i < args.length() {
    let into_callee = if has_into {
      match tc.call_into_convs.get(prefix + i.to_string()) {
        Some(conv) =>
          if conv.kind == 1 {
            tc_qualify_local_name(tc, conv.qual) + "::" + conv.name
          } else {
            ""
          }
        None => ""
      }
    } else {
      ""
    }
    match args[i] {
      ENamedArg(label, _, inner, _) =>
        match inner {
          EClosure(_, _, cbody, csp) => {
            let eff_callee = if into_callee != "" { into_callee } else { callee_target }
            let eff_arg = if into_callee != "" { "0" } else { label }
            analyze_emit_closure(
              tc,
              enclosing_fn,
              cbody,
              csp,
              eff_callee,
              eff_arg,
              closures,
            )
          }
          _ => analyze_walk_expr(tc, enclosing_fn, inner, calls, closures)
        }
      EClosure(_, _, cbody, csp) => {
        let eff_callee = if into_callee != "" { into_callee } else { callee_target }
        let eff_arg = if into_callee != "" { "0" } else { i.to_string() }
        analyze_emit_closure(
          tc,
          enclosing_fn,
          cbody,
          csp,
          eff_callee,
          eff_arg,
          closures,
        )
      }
      _ => analyze_walk_expr(tc, enclosing_fn, args[i], calls, closures)
    }
    i = i + 1
  }
}

///|
fn analyze_walk_stmts(
  tc : TypeChecker,
  enclosing_fn : String,
  stmts : Array[Stmt],
  calls : Array[AnalyzeCallSite],
  closures : Array[AnalyzeClosureRec],
) -> Unit {
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      SLet(_, _, _, init, _) =>
        analyze_walk_expr(tc, enclosing_fn, init, calls, closures)
      SLetTuple(_, _, init, _) =>
        analyze_walk_expr(tc, enclosing_fn, init, calls, closures)
      SAssign(lhs, rhs, _) | SCompoundAssign(_, lhs, rhs, _) => {
        analyze_walk_expr(tc, enclosing_fn, lhs, calls, closures)
        analyze_walk_expr(tc, enclosing_fn, rhs, calls, closures)
      }
      SGuard(cond, else_body, _) => {
        analyze_walk_expr(tc, enclosing_fn, cond, calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, else_body, calls, closures)
      }
      SWhile(cond, body, _) => {
        analyze_walk_expr(tc, enclosing_fn, cond, calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, body, calls, closures)
      }
      SBenchLoop(body, _) => analyze_walk_stmts(tc, enclosing_fn, body, calls, closures)
      SFor(init_s, cond, step_s, body, _) => {
        analyze_walk_stmts(tc, enclosing_fn, [init_s], calls, closures)
        analyze_walk_expr(tc, enclosing_fn, cond, calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, [step_s], calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, body, calls, closures)
      }
      SForRange(_, start_e, end_e, _, body, _) => {
        analyze_walk_expr(tc, enclosing_fn, start_e, calls, closures)
        analyze_walk_expr(tc, enclosing_fn, end_e, calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, body, calls, closures)
      }
      SForIn(_, _, iter_e, body, _) => {
        analyze_walk_expr(tc, enclosing_fn, iter_e, calls, closures)
        analyze_walk_stmts(tc, enclosing_fn, body, calls, closures)
      }
      SReturn(opt, _) =>
        match opt {
          Some(e) => analyze_walk_expr(tc, enclosing_fn, e, calls, closures)
          None => ()
        }
      SBreak(_) | SContinue(_) => ()
      SDebugAssert(c, m, _) => {
        analyze_walk_expr(tc, enclosing_fn, c, calls, closures)
        analyze_walk_expr(tc, enclosing_fn, m, calls, closures)
      }
      SExpr(e, _) => analyze_walk_expr(tc, enclosing_fn, e, calls, closures)
    }
    i = i + 1
  }
}

///|
fn analyze_walk_expr(
  tc : TypeChecker,
  enclosing_fn : String,
  e : Expr,
  calls : Array[AnalyzeCallSite],
  closures : Array[AnalyzeClosureRec],
) -> Unit {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EDouble(_, _) | EFloat(_, _) | EBool(_, _) => ()
    EByte(_, _) | EChar(_, _) | EString(_, _) | EUnit(_) => ()
    EIdent(_, _) | EPath(_, _, _) => ()
    EUnary(_, inner, _) | EMove(inner, _) | EAs(inner, _, _) | ETry(inner, _) | ENamedArg(_, _, inner, _) | EMutArg(inner, _) =>
      analyze_walk_expr(tc, enclosing_fn, inner, calls, closures)
    EInterp(parts, _) => {
      let mut i = 0
      while i < parts.length() {
        analyze_walk_expr(tc, enclosing_fn, parts[i], calls, closures)
        i = i + 1
      }
    }
    EDotVariant(_, args, sp) => {
      let target = match tc.call_targets.get(span_key(sp)) {
        Some(t) => t
        None => ""
      }
      if target != "" && args.length() > 0 {
        calls.push(AnalyzeCallSite::{ target: target, line: sp.line, col: sp.col })
      }
      analyze_walk_call_args(tc, enclosing_fn, sp, args, target, calls, closures)
    }
    EBinary(_, l, r, _) => {
      analyze_walk_expr(tc, enclosing_fn, l, calls, closures)
      analyze_walk_expr(tc, enclosing_fn, r, calls, closures)
    }
    ECall(callee, args, sp) => {
      let target = match tc.call_targets.get(span_key(sp)) {
        Some(t) => t
        None => ""
      }
      match callee {
        EIdent(_, _) | EPath(_, _, _) => ()
        _ => analyze_walk_expr(tc, enclosing_fn, callee, calls, closures)
      }
      if target != "" {
        calls.push(AnalyzeCallSite::{ target: target, line: sp.line, col: sp.col })
      }
      analyze_walk_call_args(tc, enclosing_fn, sp, args, target, calls, closures)
    }
    EField(obj, _, _) =>
      analyze_walk_expr(tc, enclosing_fn, obj, calls, closures)
    EMethodCall(obj, _, args, sp) => {
      analyze_walk_expr(tc, enclosing_fn, obj, calls, closures)
      let target = match tc.call_targets.get(span_key(sp)) {
        Some(t) => t
        None => ""
      }
      if target != "" {
        calls.push(AnalyzeCallSite::{ target: target, line: sp.line, col: sp.col })
      }
      analyze_walk_call_args(tc, enclosing_fn, sp, args, target, calls, closures)
    }
    EIndex(obj, idx, _) => {
      analyze_walk_expr(tc, enclosing_fn, obj, calls, closures)
      analyze_walk_expr(tc, enclosing_fn, idx, calls, closures)
    }
    EArrayLit(elems, _) | ETuple(elems, _) => {
      let mut i = 0
      while i < elems.length() {
        analyze_walk_expr(tc, enclosing_fn, elems[i], calls, closures)
        i = i + 1
      }
    }
    EStructLit(_, spread_opt, fields, _) => {
      match spread_opt {
        Some(base) => analyze_walk_expr(tc, enclosing_fn, base, calls, closures)
        None => ()
      }
      let mut i = 0
      while i < fields.length() {
        analyze_walk_expr(tc, enclosing_fn, fields[i].value, calls, closures)
        i = i + 1
      }
    }
    EBlock(stmts, _) =>
      analyze_walk_stmts(tc, enclosing_fn, stmts, calls, closures)
    EIf(cond, then_s, else_opt, _) => {
      analyze_walk_expr(tc, enclosing_fn, cond, calls, closures)
      analyze_walk_stmts(tc, enclosing_fn, then_s, calls, closures)
      match else_opt {
        Some(el) => analyze_walk_expr(tc, enclosing_fn, el, calls, closures)
        None => ()
      }
    }
    EMatch(scrut, arms, _) => {
      analyze_walk_expr(tc, enclosing_fn, scrut, calls, closures)
      let mut i = 0
      while i < arms.length() {
        match arms[i].guard_expr {
          Some(ge) => analyze_walk_expr(tc, enclosing_fn, ge, calls, closures)
          None => ()
        }
        analyze_walk_expr(tc, enclosing_fn, arms[i].body, calls, closures)
        i = i + 1
      }
    }
    EIs(scrut, _, _) =>
      analyze_walk_expr(tc, enclosing_fn, scrut, calls, closures)
    EClosure(_, _, cbody, csp) =>
      analyze_emit_closure(tc, enclosing_fn, cbody, csp, "", "", closures)
    EScope(w, f, sp) => {
      calls.push(AnalyzeCallSite::{ target: "builtin::scope", line: sp.line, col: sp.col })
      analyze_walk_expr(tc, enclosing_fn, w, calls, closures)
      match f {
        EClosure(_, _, cbody, csp) =>
          analyze_emit_closure(tc, enclosing_fn, cbody, csp, "builtin::scope", "1", closures)
        _ => analyze_walk_expr(tc, enclosing_fn, f, calls, closures)
      }
    }
    ESpawn(s, f, sp) => {
      calls.push(AnalyzeCallSite::{ target: "builtin::spawn", line: sp.line, col: sp.col })
      analyze_walk_expr(tc, enclosing_fn, s, calls, closures)
      match f {
        EClosure(_, _, cbody, csp) =>
          analyze_emit_closure(tc, enclosing_fn, cbody, csp, "builtin::spawn", "1", closures)
        _ => analyze_walk_expr(tc, enclosing_fn, f, calls, closures)
      }
    }
  }
}

///|
fn analyze_write_calls_json(sb : StringBuilder, calls : Array[AnalyzeCallSite]) -> Unit {
  sb.write_string("[")
  let mut i = 0
  while i < calls.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"target\":")
    sb.write_string(json_quote(calls[i].target))
    sb.write_string(",\"line\":")
    sb.write_string(calls[i].line.to_string())
    sb.write_string(",\"col\":")
    sb.write_string(calls[i].col.to_string())
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]")
}

///|
pub fn query_analyze_packages_json(
  checked_pkgs : Array[CheckedPackage],
  diags : Array[Diagnostic],
) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if diags.length() == 0 { "true" } else { "false" })
  if diags.length() > 0 {
    sb.write_string(",\"diagnostics\":[")
    let mut di = 0
    while di < diags.length() {
      if di > 0 {
        sb.write_string(",")
      }
      sb.write_string(diagnostic_to_json(diags[di]))
      di = di + 1
    }
    sb.write_string("]")
  }
  // 1. types
  sb.write_string(",\"types\":[")
  let mut tcount = 0
  let mut pi = 0
  while pi < checked_pkgs.length() {
    let cp = checked_pkgs[pi]
    let pkg = cp.pkg
    let tc = cp.tc
    let mut fi = 0
    while fi < pkg.files.length() {
      let f = pkg.files[fi]
      let mut di = 0
      while di < f.decls.length() {
        match f.decls[di] {
          DStruct(sd) => {
            if tcount > 0 {
              sb.write_string(",")
            }
            tcount = tcount + 1
            let has_mut = analyze_struct_has_mut_fields(tc, sd.name, [], Map([]))
            sb.write_string("{\"pkg\":")
            sb.write_string(json_quote(pkg.name))
            sb.write_string(",\"name\":")
            sb.write_string(json_quote(sd.name))
            sb.write_string(",\"kind\":\"struct\",\"is_val\":")
            sb.write_string(if sd.is_val { "true" } else { "false" })
            sb.write_string(",\"has_mut_fields\":")
            sb.write_string(if has_mut { "true" } else { "false" })
            sb.write_string(",\"file\":")
            sb.write_string(json_quote(sd.span.file))
            sb.write_string(",\"line\":")
            sb.write_string(sd.span.line.to_string())
            sb.write_string("}")
          }
          DEnum(ed) => {
            if tcount > 0 {
              sb.write_string(",")
            }
            tcount = tcount + 1
            let has_mut = analyze_enum_has_mut_fields(tc, ed.name, [], Map([]))
            sb.write_string("{\"pkg\":")
            sb.write_string(json_quote(pkg.name))
            sb.write_string(",\"name\":")
            sb.write_string(json_quote(ed.name))
            sb.write_string(",\"kind\":\"enum\",\"is_val\":false,\"has_mut_fields\":")
            sb.write_string(if has_mut { "true" } else { "false" })
            sb.write_string(",\"file\":")
            sb.write_string(json_quote(ed.span.file))
            sb.write_string(",\"line\":")
            sb.write_string(ed.span.line.to_string())
            sb.write_string("}")
          }
          _ => ()
        }
        di = di + 1
      }
      fi = fi + 1
    }
    pi = pi + 1
  }
  sb.write_string("]")

  // 2. fns (and collect closures in deterministic order)
  let all_closures : Array[AnalyzeClosureRec] = []
  let closure_tcs : Array[TypeChecker] = []
  sb.write_string(",\"fns\":[")
  let mut fcount = 0
  pi = 0
  while pi < checked_pkgs.length() {
    let cp = checked_pkgs[pi]
    let pkg = cp.pkg
    let tc = cp.tc
    let mut fi = 0
    while fi < pkg.files.length() {
      let f = pkg.files[fi]
      let mut di = 0
      while di < f.decls.length() {
        let before_cl = all_closures.length()
        match f.decls[di] {
          DFn(fd) => {
            let short_name = if fd.receiver_type != "" {
              fd.receiver_type + "::" + fd.name
            } else {
              fd.name
            }
            let enc = pkg.name + "::" + short_name
            let calls : Array[AnalyzeCallSite] = []
            analyze_walk_stmts(tc, enc, fd.body, calls, all_closures)
            if fcount > 0 {
              sb.write_string(",")
            }
            fcount = fcount + 1
            sb.write_string("{\"pkg\":")
            sb.write_string(json_quote(pkg.name))
            sb.write_string(",\"name\":")
            sb.write_string(json_quote(short_name))
            sb.write_string(",\"file\":")
            sb.write_string(json_quote(fd.span.file))
            sb.write_string(",\"line\":")
            sb.write_string(fd.span.line.to_string())
            sb.write_string(",\"no_io\":")
            sb.write_string(if fd.no_io { "true" } else { "false" })
            sb.write_string(",\"calls\":")
            analyze_write_calls_json(sb, calls)
            sb.write_string("}")
          }
          DImpl(id) => {
            let mut mi = 0
            while mi < id.methods.length() {
              let md = id.methods[mi]
              let short_name = id.trait_name + "::" + id.target_type + "::" + md.name
              let enc = pkg.name + "::" + short_name
              let calls : Array[AnalyzeCallSite] = []
              analyze_walk_stmts(tc, enc, md.body, calls, all_closures)
              if fcount > 0 {
                sb.write_string(",")
              }
              fcount = fcount + 1
              sb.write_string("{\"pkg\":")
              sb.write_string(json_quote(pkg.name))
              sb.write_string(",\"name\":")
              sb.write_string(json_quote(short_name))
              sb.write_string(",\"file\":")
              sb.write_string(json_quote(md.span.file))
              sb.write_string(",\"line\":")
              sb.write_string(md.span.line.to_string())
              sb.write_string(",\"no_io\":")
              sb.write_string(if md.no_io { "true" } else { "false" })
              sb.write_string(",\"calls\":")
              analyze_write_calls_json(sb, calls)
              sb.write_string("}")
              mi = mi + 1
            }
          }
          DExternFn(ed) =>
            if ed.has_body {
              let enc = pkg.name + "::" + ed.name
              let calls : Array[AnalyzeCallSite] = []
              analyze_walk_stmts(tc, enc, ed.body, calls, all_closures)
              if fcount > 0 {
                sb.write_string(",")
              }
              fcount = fcount + 1
              sb.write_string("{\"pkg\":")
              sb.write_string(json_quote(pkg.name))
              sb.write_string(",\"name\":")
              sb.write_string(json_quote(ed.name))
              sb.write_string(",\"file\":")
              sb.write_string(json_quote(ed.span.file))
              sb.write_string(",\"line\":")
              sb.write_string(ed.span.line.to_string())
              sb.write_string(",\"no_io\":false,\"calls\":")
              analyze_write_calls_json(sb, calls)
              sb.write_string("}")
            }
          DConst(cd) => {
            let enc = pkg.name + "::" + cd.name
            let dummy : Array[AnalyzeCallSite] = []
            analyze_walk_expr(tc, enc, cd.value, dummy, all_closures)
          }
          DTest(td) => {
            let enc = pkg.name + "::test::" + td.name
            let dummy : Array[AnalyzeCallSite] = []
            analyze_walk_stmts(tc, enc, td.body, dummy, all_closures)
          }
          _ => ()
        }
        let mut ci = before_cl
        while ci < all_closures.length() {
          closure_tcs.push(tc)
          ci = ci + 1
        }
        di = di + 1
      }
      fi = fi + 1
    }
    pi = pi + 1
  }
  sb.write_string("]")

  // 3. closures
  sb.write_string(",\"closures\":[")
  let mut ci = 0
  while ci < all_closures.length() {
    if ci > 0 {
      sb.write_string(",")
    }
    let cl = all_closures[ci]
    let tc = closure_tcs[ci]
    sb.write_string("{\"pkg\":")
    sb.write_string(json_quote(cl.pkg))
    sb.write_string(",\"enclosing_fn\":")
    sb.write_string(json_quote(cl.enclosing_fn))
    sb.write_string(",\"file\":")
    sb.write_string(json_quote(cl.file))
    sb.write_string(",\"line\":")
    sb.write_string(cl.line.to_string())
    sb.write_string(",\"col\":")
    sb.write_string(cl.col.to_string())
    sb.write_string(",\"context_callee\":")
    sb.write_string(json_quote(cl.context_callee))
    sb.write_string(",\"context_arg\":")
    sb.write_string(json_quote(cl.context_arg))
    sb.write_string(",\"captures\":[")
    let mut k = 0
    while k < cl.captures.length() {
      if k > 0 {
        sb.write_string(",")
      }
      let cap = cl.captures[k]
      let is_val = analyze_is_val_struct(tc, cap.ty)
      let has_mut = analyze_ty_struct_has_mut_fields(tc, cap.ty)
      let is_mut_ty = analyze_ty_is_mutable(tc, cap.ty, Map([]))
      sb.write_string("{\"name\":")
      sb.write_string(json_quote(cap.name))
      sb.write_string(",\"is_mut\":")
      sb.write_string(if cap.is_mut { "true" } else { "false" })
      sb.write_string(",\"ty\":")
      sb.write_string(json_quote(analyze_ty_to_string(tc, cap.ty)))
      sb.write_string(",\"is_val_struct\":")
      sb.write_string(if is_val { "true" } else { "false" })
      sb.write_string(",\"has_mut_fields\":")
      sb.write_string(if has_mut { "true" } else { "false" })
      sb.write_string(",\"is_mutable_ty\":")
      sb.write_string(if is_mut_ty { "true" } else { "false" })
      sb.write_string(",\"decl_line\":")
      sb.write_string(cap.decl_line.to_string())
      sb.write_string("}")
      k = k + 1
    }
    sb.write_string("],\"calls\":")
    analyze_write_calls_json(sb, cl.calls)
    sb.write_string("}")
    ci = ci + 1
  }
  sb.write_string("]}")
  sb.to_string()
}
