///| Codegen-side lowering of `mut self` receivers: every `recv.m(...)` whose
///| method takes `mut self` (recorded by the checker in `mut_recv_calls`) is
///| rewritten to `EMethodCall(EMutArg(recv), m, ...)`, so the backend's
///| syntactic analyses (assignment / borrow / hoisting checks) see the receiver
///| as an in-out place exactly like an explicit `mut <place>` argument.

///|
fn mra_has(keys : Array[Map[String, Bool]], k : String) -> Bool {
  let mut i = 0
  while i < keys.length() {
    if keys[i].contains(k) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn mra_find_into(maps : Array[Map[String, IntoConv]], k : String) -> Option[IntoConv] {
  let mut i = 0
  while i < maps.length() {
    match maps[i].get(k) {
      Some(c) => return Some(c)
      None => ()
    }
    i = i + 1
  }
  None
}

///|
fn mra_wrap_into(e : Expr, conv : IntoConv) -> Expr {
  let sp = expr_span(e)
  if conv.kind == 0 {
    EMethodCall(e, conv.name, [], sp)
  } else if conv.kind == 1 {
    ECall(EPath(conv.qual, conv.name, sp), [e], sp)
  } else {
    EMethodCall(e, conv.name, [], sp)
  }
}

///|
fn mra_call_args(
  es : Array[Expr],
  call_sp : Span,
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Array[Expr] {
  let out : Array[Expr] = []
  let prefix = if into_maps.length() > 0 { span_key(call_sp) + "#" } else { "" }
  let mut i = 0
  while i < es.length() {
    let rewritten = mra_expr_ex(es[i], keys, into_maps)
    if into_maps.length() > 0 {
      match mra_find_into(into_maps, prefix + i.to_string()) {
        Some(conv) =>
          match rewritten {
            ENamedArg(label, opt_fwd, inner, asp) =>
              out.push(ENamedArg(label, opt_fwd, mra_wrap_into(inner, conv), asp))
            _ => out.push(mra_wrap_into(rewritten, conv))
          }
        None => out.push(rewritten)
      }
    } else {
      out.push(rewritten)
    }
    i = i + 1
  }
  out
}

///|
fn mra_expr_ex(
  e : Expr,
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Expr {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EDouble(_, _) | EFloat(_, _) => e
    EBool(_, _) | EByte(_, _) | EChar(_, _) | EString(_, _) | EIdent(_, _) | EPath(_, _, _) | EUnit(_) =>
      e
    EDotVariant(n, args, sp) => EDotVariant(n, mra_exprs_ex(args, keys, into_maps), sp)
    EUnary(op, inner, sp) => EUnary(op, mra_expr_ex(inner, keys, into_maps), sp)
    EBinary(op, l, r, sp) =>
      EBinary(op, mra_expr_ex(l, keys, into_maps), mra_expr_ex(r, keys, into_maps), sp)
    ECall(callee, args, sp) =>
      ECall(
        mra_expr_ex(callee, keys, into_maps),
        mra_call_args(args, sp, keys, into_maps),
        sp,
      )
    EField(o, f, sp) => EField(mra_expr_ex(o, keys, into_maps), f, sp)
    EMethodCall(o, m, args, sp) => {
      let o2 = mra_expr_ex(o, keys, into_maps)
      let recv = if mra_has(keys, span_key(sp)) {
        match o2 {
          EMutArg(_, _) => o2
          _ => EMutArg(o2, sp)
        }
      } else {
        o2
      }
      EMethodCall(recv, m, mra_call_args(args, sp, keys, into_maps), sp)
    }
    EIndex(o, i, sp) => EIndex(mra_expr_ex(o, keys, into_maps), mra_expr_ex(i, keys, into_maps), sp)
    EArrayLit(es, sp) => EArrayLit(mra_exprs_ex(es, keys, into_maps), sp)
    EStructLit(n, spread, fields, sp) => {
      let sp2 = match spread {
        Some(b) => Some(mra_expr_ex(b, keys, into_maps))
        None => None
      }
      let fs : Array[FieldInit] = []
      let mut i = 0
      while i < fields.length() {
        fs.push(FieldInit::{
          name: fields[i].name,
          value: mra_expr_ex(fields[i].value, keys, into_maps),
          span: fields[i].span,
        })
        i = i + 1
      }
      EStructLit(n, sp2, fs, sp)
    }
    ETuple(es, sp) => ETuple(mra_exprs_ex(es, keys, into_maps), sp)
    EBlock(stmts, sp) => EBlock(rewrite_mut_recv_stmts_ex(stmts, keys, into_maps), sp)
    EIf(c, th, el, sp) => {
      let el2 = match el {
        Some(x) => Some(mra_expr_ex(x, keys, into_maps))
        None => None
      }
      EIf(
        mra_expr_ex(c, keys, into_maps),
        rewrite_mut_recv_stmts_ex(th, keys, into_maps),
        el2,
        sp,
      )
    }
    EMatch(scrut, arms, sp) => {
      let arms2 : Array[MatchArm] = []
      let mut i = 0
      while i < arms.length() {
        let g2 = match arms[i].guard_expr {
          Some(x) => Some(mra_expr_ex(x, keys, into_maps))
          None => None
        }
        arms2.push(MatchArm::{
          pat: arms[i].pat,
          guard_expr: g2,
          body: mra_expr_ex(arms[i].body, keys, into_maps),
          span: arms[i].span,
        })
        i = i + 1
      }
      EMatch(mra_expr_ex(scrut, keys, into_maps), arms2, sp)
    }
    EIs(x, pat, sp) => EIs(mra_expr_ex(x, keys, into_maps), pat, sp)
    EClosure(ps, rt, body, sp) =>
      EClosure(ps, rt, rewrite_mut_recv_stmts_ex(body, keys, into_maps), sp)
    EScope(a, b, sp) =>
      EScope(mra_expr_ex(a, keys, into_maps), mra_expr_ex(b, keys, into_maps), sp)
    ESpawn(a, b, sp) =>
      ESpawn(mra_expr_ex(a, keys, into_maps), mra_expr_ex(b, keys, into_maps), sp)
    EMove(x, sp) => EMove(mra_expr_ex(x, keys, into_maps), sp)
    EAs(x, t, sp) => EAs(mra_expr_ex(x, keys, into_maps), t, sp)
    ETry(x, sp) => ETry(mra_expr_ex(x, keys, into_maps), sp)
    EInterp(parts, sp) => EInterp(mra_exprs_ex(parts, keys, into_maps), sp)
    ENamedArg(n, f, x, sp) => ENamedArg(n, f, mra_expr_ex(x, keys, into_maps), sp)
    EMutArg(x, sp) => EMutArg(mra_expr_ex(x, keys, into_maps), sp)
  }
}

///|
fn mra_exprs_ex(
  es : Array[Expr],
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Array[Expr] {
  let out : Array[Expr] = []
  let mut i = 0
  while i < es.length() {
    out.push(mra_expr_ex(es[i], keys, into_maps))
    i = i + 1
  }
  out
}

///|
fn mra_stmt_ex(
  s : Stmt,
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Stmt {
  match s {
    SLet(n, m, t, init, sp) => SLet(n, m, t, mra_expr_ex(init, keys, into_maps), sp)
    SLetTuple(ns, t, init, sp) => SLetTuple(ns, t, mra_expr_ex(init, keys, into_maps), sp)
    SAssign(l, r, sp) =>
      SAssign(mra_expr_ex(l, keys, into_maps), mra_expr_ex(r, keys, into_maps), sp)
    SCompoundAssign(op, l, r, sp) =>
      SCompoundAssign(op, mra_expr_ex(l, keys, into_maps), mra_expr_ex(r, keys, into_maps), sp)
    SGuard(c, body, sp) =>
      SGuard(mra_expr_ex(c, keys, into_maps), rewrite_mut_recv_stmts_ex(body, keys, into_maps), sp)
    SWhile(c, body, sp) =>
      SWhile(mra_expr_ex(c, keys, into_maps), rewrite_mut_recv_stmts_ex(body, keys, into_maps), sp)
    SFor(init_s, c, step_s, body, sp) =>
      SFor(
        mra_stmt_ex(init_s, keys, into_maps),
        mra_expr_ex(c, keys, into_maps),
        mra_stmt_ex(step_s, keys, into_maps),
        rewrite_mut_recv_stmts_ex(body, keys, into_maps),
        sp,
      )
    SForRange(v, a, b, incl, body, sp) =>
      SForRange(
        v,
        mra_expr_ex(a, keys, into_maps),
        mra_expr_ex(b, keys, into_maps),
        incl,
        rewrite_mut_recv_stmts_ex(body, keys, into_maps),
        sp,
      )
    SForIn(i, v, it, body, sp) =>
      SForIn(
        i,
        v,
        mra_expr_ex(it, keys, into_maps),
        rewrite_mut_recv_stmts_ex(body, keys, into_maps),
        sp,
      )
    SReturn(opt, sp) =>
      match opt {
        Some(x) => SReturn(Some(mra_expr_ex(x, keys, into_maps)), sp)
        None => s
      }
    SBreak(_) | SContinue(_) => s
    SDebugAssert(c, m, sp) =>
      SDebugAssert(mra_expr_ex(c, keys, into_maps), mra_expr_ex(m, keys, into_maps), sp)
    SExpr(x, sp) => SExpr(mra_expr_ex(x, keys, into_maps), sp)
  }
}

///|
pub fn rewrite_mut_recv_expr_ex(
  e : Expr,
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Expr {
  mra_expr_ex(e, keys, into_maps)
}

///|
pub fn rewrite_mut_recv_stmts_ex(
  stmts : Array[Stmt],
  keys : Array[Map[String, Bool]],
  into_maps : Array[Map[String, IntoConv]],
) -> Array[Stmt] {
  let out : Array[Stmt] = []
  let mut i = 0
  while i < stmts.length() {
    out.push(mra_stmt_ex(stmts[i], keys, into_maps))
    i = i + 1
  }
  out
}

///|
pub fn rewrite_mut_recv_stmts(stmts : Array[Stmt], keys : Array[Map[String, Bool]]) -> Array[Stmt] {
  rewrite_mut_recv_stmts_ex(stmts, keys, [])
}
