///| Codegen-side lowering of `mut self` receivers: every `recv.m(...)` whose
///| method takes `mut self` (recorded by the checker in `mut_recv_calls`) is
///| rewritten to `EMethodCall(EMutArg(recv), m, ...)`, so the backend's
///| syntactic analyses (assignment / borrow / hoisting checks) see the receiver
///| as an in-out place exactly like an explicit `mut <place>` argument.

///|
fn mra_has(keys : Array[Map[String, Bool]], k : String) -> Bool {
  let mut i = 0
  while i < keys.length() {
    if keys[i].contains(k) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn mra_expr(e : Expr, keys : Array[Map[String, Bool]]) -> Expr {
  match e {
    EInt(_, _) | EInt64(_, _) | EUInt(_, _) | EUInt64(_, _) | EDouble(_, _) | EFloat(_, _) => e
    EBool(_, _) | EByte(_, _) | EChar(_, _) | EString(_, _) | EIdent(_, _) | EPath(_, _, _) | EUnit(_) =>
      e
    EDotVariant(n, args, sp) => EDotVariant(n, mra_exprs(args, keys), sp)
    EUnary(op, inner, sp) => EUnary(op, mra_expr(inner, keys), sp)
    EBinary(op, l, r, sp) => EBinary(op, mra_expr(l, keys), mra_expr(r, keys), sp)
    ECall(callee, args, sp) => ECall(mra_expr(callee, keys), mra_exprs(args, keys), sp)
    EField(o, f, sp) => EField(mra_expr(o, keys), f, sp)
    EMethodCall(o, m, args, sp) => {
      let o2 = mra_expr(o, keys)
      let recv = if mra_has(keys, span_key(sp)) {
        match o2 {
          EMutArg(_, _) => o2
          _ => EMutArg(o2, sp)
        }
      } else {
        o2
      }
      EMethodCall(recv, m, mra_exprs(args, keys), sp)
    }
    EIndex(o, i, sp) => EIndex(mra_expr(o, keys), mra_expr(i, keys), sp)
    EArrayLit(es, sp) => EArrayLit(mra_exprs(es, keys), sp)
    EStructLit(n, spread, fields, sp) => {
      let sp2 = match spread {
        Some(b) => Some(mra_expr(b, keys))
        None => None
      }
      let fs : Array[FieldInit] = []
      let mut i = 0
      while i < fields.length() {
        fs.push(FieldInit::{
          name: fields[i].name,
          value: mra_expr(fields[i].value, keys),
          span: fields[i].span,
        })
        i = i + 1
      }
      EStructLit(n, sp2, fs, sp)
    }
    ETuple(es, sp) => ETuple(mra_exprs(es, keys), sp)
    EBlock(stmts, sp) => EBlock(rewrite_mut_recv_stmts(stmts, keys), sp)
    EIf(c, th, el, sp) => {
      let el2 = match el {
        Some(x) => Some(mra_expr(x, keys))
        None => None
      }
      EIf(mra_expr(c, keys), rewrite_mut_recv_stmts(th, keys), el2, sp)
    }
    EMatch(scrut, arms, sp) => {
      let arms2 : Array[MatchArm] = []
      let mut i = 0
      while i < arms.length() {
        let g2 = match arms[i].guard_expr {
          Some(x) => Some(mra_expr(x, keys))
          None => None
        }
        arms2.push(MatchArm::{
          pat: arms[i].pat,
          guard_expr: g2,
          body: mra_expr(arms[i].body, keys),
          span: arms[i].span,
        })
        i = i + 1
      }
      EMatch(mra_expr(scrut, keys), arms2, sp)
    }
    EIs(x, pat, sp) => EIs(mra_expr(x, keys), pat, sp)
    EClosure(ps, rt, body, sp) => EClosure(ps, rt, rewrite_mut_recv_stmts(body, keys), sp)
    EScope(a, b, sp) => EScope(mra_expr(a, keys), mra_expr(b, keys), sp)
    ESpawn(a, b, sp) => ESpawn(mra_expr(a, keys), mra_expr(b, keys), sp)
    EMove(x, sp) => EMove(mra_expr(x, keys), sp)
    EAs(x, t, sp) => EAs(mra_expr(x, keys), t, sp)
    ETry(x, sp) => ETry(mra_expr(x, keys), sp)
    EInterp(parts, sp) => EInterp(mra_exprs(parts, keys), sp)
    ENamedArg(n, f, x, sp) => ENamedArg(n, f, mra_expr(x, keys), sp)
    EMutArg(x, sp) => EMutArg(mra_expr(x, keys), sp)
  }
}

///|
fn mra_exprs(es : Array[Expr], keys : Array[Map[String, Bool]]) -> Array[Expr] {
  let out : Array[Expr] = []
  let mut i = 0
  while i < es.length() {
    out.push(mra_expr(es[i], keys))
    i = i + 1
  }
  out
}

///|
fn mra_stmt(s : Stmt, keys : Array[Map[String, Bool]]) -> Stmt {
  match s {
    SLet(n, m, t, init, sp) => SLet(n, m, t, mra_expr(init, keys), sp)
    SLetTuple(ns, t, init, sp) => SLetTuple(ns, t, mra_expr(init, keys), sp)
    SAssign(l, r, sp) => SAssign(mra_expr(l, keys), mra_expr(r, keys), sp)
    SCompoundAssign(op, l, r, sp) =>
      SCompoundAssign(op, mra_expr(l, keys), mra_expr(r, keys), sp)
    SGuard(c, body, sp) => SGuard(mra_expr(c, keys), rewrite_mut_recv_stmts(body, keys), sp)
    SWhile(c, body, sp) => SWhile(mra_expr(c, keys), rewrite_mut_recv_stmts(body, keys), sp)
    SFor(init_s, c, step_s, body, sp) =>
      SFor(
        mra_stmt(init_s, keys),
        mra_expr(c, keys),
        mra_stmt(step_s, keys),
        rewrite_mut_recv_stmts(body, keys),
        sp,
      )
    SForRange(v, a, b, incl, body, sp) =>
      SForRange(v, mra_expr(a, keys), mra_expr(b, keys), incl, rewrite_mut_recv_stmts(body, keys), sp)
    SForIn(i, v, it, body, sp) =>
      SForIn(i, v, mra_expr(it, keys), rewrite_mut_recv_stmts(body, keys), sp)
    SReturn(opt, sp) =>
      match opt {
        Some(x) => SReturn(Some(mra_expr(x, keys)), sp)
        None => s
      }
    SBreak(_) | SContinue(_) => s
    SDebugAssert(c, m, sp) => SDebugAssert(mra_expr(c, keys), mra_expr(m, keys), sp)
    SExpr(x, sp) => SExpr(mra_expr(x, keys), sp)
  }
}

///|
pub fn rewrite_mut_recv_stmts(stmts : Array[Stmt], keys : Array[Map[String, Bool]]) -> Array[Stmt] {
  let out : Array[Stmt] = []
  let mut i = 0
  while i < stmts.length() {
    out.push(mra_stmt(stmts[i], keys))
    i = i + 1
  }
  out
}
