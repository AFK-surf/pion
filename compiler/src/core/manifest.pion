///| Pure Pion ∩ MoonBit `pion.toml` manifest parser & package dependency graph

///|
/// A `[dependencies]` entry: either a local `path` dependency or a `git`
/// dependency pinned by at most one of `tag` / `rev` / `branch` (default: the
/// remote `HEAD`), optionally rooted at a monorepo `subdir`. A dependency
/// added from a git-index registry (`pionc add <name>`) also records that
/// `registry` and the index entry's `version`, so `pionc update` can re-read it.
pub struct ManifestDep {
  name : String
  path : String
  git : String
  tag : String
  rev : String
  branch : String
  subdir : String
  registry : String
  version : String
  workspace : Bool
}

///|
pub fn manifest_dep_new(
  name : String,
  path : String,
  git : String,
  tag : String,
  rev : String,
  branch : String,
  subdir : String,
) -> ManifestDep {
  ManifestDep::{
    name: name,
    path: path,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
    registry: "",
    version: "",
    workspace: false,
  }
}

///|
pub fn manifest_dep_is_git(dep : ManifestDep) -> Bool {
  dep.git.length() > 0
}

///|
/// The requested git reference of a dependency, as recorded in `pion.lock`:
/// `tag:<t>`, `rev:<sha>`, `branch:<b>` or `HEAD`.
pub fn manifest_dep_ref(dep : ManifestDep) -> String {
  if dep.tag.length() > 0 {
    "tag:" + dep.tag
  } else if dep.rev.length() > 0 {
    "rev:" + dep.rev
  } else if dep.branch.length() > 0 {
    "branch:" + dep.branch
  } else {
    "HEAD"
  }
}

///|
/// Native link & C/C++/ObjC stub compilation settings from `[link]`,
/// `[link.macos]`, `[link.linux]`, `[link.ios]`, `[link.android]`, `[link.windows]` or `[link.wasm]` in `pion.toml`.
pub struct LinkSpec {
  libs : Array[String]
  frameworks : Array[String]
  search_paths : Array[String]
  rpaths : Array[String]
  objects : Array[String]
  flags : Array[String]
  c_sources : Array[String]
  cc_flags : Array[String]
  rc_sources : Array[String]
}

///|
pub fn link_spec_empty() -> LinkSpec {
  LinkSpec::{
    libs: [],
    frameworks: [],
    search_paths: [],
    rpaths: [],
    objects: [],
    flags: [],
    c_sources: [],
    cc_flags: [],
    rc_sources: [],
  }
}

///|
pub struct PackageManifest {
  name : String
  version : String
  deps : Array[ManifestDep]
  link_libs : Array[String]
  link_common : LinkSpec
  link_macos : LinkSpec
  link_linux : LinkSpec
  link_ios : LinkSpec
  link_android : LinkSpec
  link_windows : LinkSpec
  link_wasm : LinkSpec
  registry : String
  is_workspace : Bool
  workspace_members : Array[String]
  workspace_deps : Array[ManifestDep]
  /// `[verify] enabled = true`: every fn / method / impl method of the
  /// package is `#verify` unless it is `#verify_opaque`.
  verify_enabled : Bool
}

///|
pub struct PkgNodeInput {
  name : String
  dir : String
  deps : Array[String]
  paths : Array[String]
  sources : Array[String]
  link_libs : Array[String]
  link_common : LinkSpec
  link_macos : LinkSpec
  link_linux : LinkSpec
  link_ios : LinkSpec
  link_android : LinkSpec
  link_windows : LinkSpec
  link_wasm : LinkSpec
  verify_enabled : Bool
}

///|
pub fn pkg_node_input_new(
  name : String,
  dir : String,
  deps : Array[String],
  paths : Array[String],
  sources : Array[String],
) -> PkgNodeInput {
  PkgNodeInput::{
    name: name,
    dir: dir,
    deps: deps,
    paths: paths,
    sources: sources,
    link_libs: [],
    link_common: link_spec_empty(),
    link_macos: link_spec_empty(),
    link_linux: link_spec_empty(),
    link_ios: link_spec_empty(),
    link_android: link_spec_empty(),
    link_windows: link_spec_empty(),
    link_wasm: link_spec_empty(),
    verify_enabled: false,
  }
}

///|
/// Lowers `[verify] enabled = true` onto a package's sources: each source gets
/// the file-level inner attribute `#![verify]` appended after its last line
/// (no line/column shift for diagnostics). Being part of the source text, the
/// flag is part of every source-content CAS key automatically.
pub fn manifest_apply_verify(sources : Array[String], enabled : Bool) -> Array[String] {
  if !enabled {
    return sources
  }
  let out : Array[String] = []
  let mut i = 0
  while i < sources.length() {
    out.push(sources[i] + "\n#![verify]\n")
    i = i + 1
  }
  out
}

///|
pub struct TopoSortResult {
  order : Array[Int]
  diagnostics : Array[Diagnostic]
}

///|
fn toml_trim(s : String) -> String {
  let len = s.length()
  let mut a = 0
  while a < len {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = len
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  slice_str(s, a, b)
}

///|
fn toml_strip_comment(line : String) -> String {
  let len = line.length()
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < len {
    let c = str_code_at(line, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return slice_str(line, 0, i)
    }
    i = i + 1
  }
  line
}

///|
fn toml_find_char(s : String, ch : Int, start : Int) -> Int {
  let len = s.length()
  let mut in_str = false
  let mut esc = false
  let mut i = start
  while i < len {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn toml_unquote(raw : String) -> Result[String, String] {
  let s = toml_trim(raw)
  let len = s.length()
  if len < 2 || str_code_at(s, 0) != 34 || str_code_at(s, len - 1) != 34 {
    return Err("expected quoted string, found `" + s + "`")
  }
  let sb = StringBuilder()
  let mut run = 1
  let mut i = 1
  while i < len - 1 {
    let c = str_code_at(s, i)
    if c == 92 && i + 1 < len - 1 {
      sb_write_range(sb, s, run, i)
      let nc = str_code_at(s, i + 1)
      if nc == 110 {
        sb.write_char('\n')
      } else if nc == 116 {
        sb.write_char('\t')
      } else if nc == 114 {
        sb.write_char('\r')
      } else if nc == 34 {
        sb.write_char('"')
      } else if nc == 92 {
        sb.write_char('\\')
      } else if nc < 0x80 {
        sb.write_char(nc.unsafe_to_char())
      } else {
        // `\<non-ASCII>`: drop the backslash, keep the whole character.
        i = i + 1
        run = i
        continue
      }
      i = i + 2
      run = i
    } else {
      // Unescaped text (UTF-8 included) is copied as a byte range.
      i = i + 1
    }
  }
  sb_write_range(sb, s, run, len - 1)
  Ok(sb.to_string())
}

///|
fn toml_parse_dep(
  name : String,
  rhs : String,
  allow_workspace : Bool,
) -> Result[ManifestDep, String] {
  let s = toml_trim(rhs)
  if s.length() >= 2 && str_code_at(s, 0) == 34 {
    match toml_unquote(s) {
      Ok(p) => return Ok(manifest_dep_new(name, p, "", "", "", "", ""))
      Err(e) => return Err(e)
    }
  }
  if s.length() < 2 ||
    str_code_at(s, 0) != 123 ||
    str_code_at(s, s.length() - 1) != 125 {
    return Err(
      "expected `{ path = \"...\" }` or `{ git = \"...\", tag = \"...\" }` in [dependencies], found `" +
      s +
      "`",
    )
  }
  let mut path = ""
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut registry = ""
  let mut version = ""
  let mut workspace = false
  let inner = toml_trim(slice_str(s, 1, s.length() - 1))
  let mut pos = 0
  let ilen = inner.length()
  while pos < ilen {
    let comma = toml_find_char(inner, 44, pos)
    let end_p = if comma < 0 { ilen } else { comma }
    let entry = toml_trim(slice_str(inner, pos, end_p))
    if entry.length() > 0 {
      let eq = toml_find_char(entry, 61, 0)
      if eq > 0 {
        let k = toml_trim(slice_str(entry, 0, eq))
        let v = toml_trim(slice_str(entry, eq + 1, entry.length()))
        if k == "workspace" {
          if v == "true" {
            workspace = true
          } else if v == "false" {
            workspace = false
          } else {
            return Err(
              "dependency `" +
              name +
              "` key `workspace`: expected `true` or `false`, found `" +
              v +
              "`",
            )
          }
        } else if k == "path" ||
          k == "git" ||
          k == "tag" ||
          k == "rev" ||
          k == "branch" ||
          k == "subdir" ||
          k == "registry" ||
          k == "version" {
          let uv = match toml_unquote(v) {
            Ok(x) => x
            Err(e) => return Err("dependency `" + name + "` key `" + k + "`: " + e)
          }
          if k == "path" {
            path = uv
          } else if k == "git" {
            git = uv
          } else if k == "tag" {
            tag = uv
          } else if k == "rev" {
            rev = uv
          } else if k == "branch" {
            branch = uv
          } else if k == "registry" {
            registry = uv
          } else if k == "version" {
            version = uv
          } else {
            subdir = uv
          }
        }
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  if workspace {
    if !allow_workspace {
      return Err(
        "dependency `" +
        name +
        "` cannot set `workspace = true` in [workspace.dependencies]",
      )
    }
    if path.length() > 0 ||
      git.length() > 0 ||
      tag.length() > 0 ||
      rev.length() > 0 ||
      branch.length() > 0 ||
      subdir.length() > 0 ||
      registry.length() > 0 ||
      version.length() > 0 {
      return Err(
        "dependency `" +
        name +
        "` cannot combine `workspace = true` with `path`/`git`/`registry`",
      )
    }
    return Ok(ManifestDep::{
      name: name,
      path: "",
      git: "",
      tag: "",
      rev: "",
      branch: "",
      subdir: "",
      registry: "",
      version: "",
      workspace: true,
    })
  }
  if git.length() > 0 {
    if path.length() > 0 {
      return Err("dependency `" + name + "` sets both `path` and `git`")
    }
    let mut nrefs = 0
    if tag.length() > 0 {
      nrefs = nrefs + 1
    }
    if rev.length() > 0 {
      nrefs = nrefs + 1
    }
    if branch.length() > 0 {
      nrefs = nrefs + 1
    }
    if nrefs > 1 {
      return Err(
        "dependency `" + name + "` sets more than one of `tag`, `rev`, `branch`",
      )
    }
  } else {
    if path.length() == 0 {
      return Err(
        "missing `path = \"...\"` or `git = \"...\"` in dependency table `" +
        s +
        "`",
      )
    }
    if tag.length() > 0 ||
      rev.length() > 0 ||
      branch.length() > 0 ||
      subdir.length() > 0 ||
      registry.length() > 0 {
      return Err(
        "dependency `" + name + "`: `tag`/`rev`/`branch`/`subdir`/`registry` require `git = \"...\"`",
      )
    }
  }
  Ok(ManifestDep::{
    name: name,
    path: path,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
    registry: registry,
    version: version,
    workspace: false,
  })
}

///|
/// Parses a TOML string array `["a", "b"]` (or a single quoted string).
fn toml_parse_str_array(rhs : String) -> Result[Array[String], String] {
  let s = toml_trim(rhs)
  let out : Array[String] = []
  if s.length() >= 2 && str_code_at(s, 0) == 34 {
    match toml_unquote(s) {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
    return Ok(out)
  }
  if s.length() < 2 ||
    str_code_at(s, 0) != 91 ||
    str_code_at(s, s.length() - 1) != 93 {
    return Err("expected `[\"...\", ...]`, found `" + s + "`")
  }
  let inner = slice_str(s, 1, s.length() - 1)
  let ilen = inner.length()
  let mut pos = 0
  while pos < ilen {
    let comma = toml_find_char(inner, 44, pos)
    let end_p = if comma < 0 { ilen } else { comma }
    let entry = toml_trim(slice_str(inner, pos, end_p))
    if entry.length() > 0 {
      match toml_unquote(entry) {
        Ok(v) => out.push(v)
        Err(e) => return Err(e)
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  Ok(out)
}

///|
/// Appends `lib` to `libs` unless already present (keeps first-seen order).
pub fn push_unique_lib(libs : Array[String], lib : String) -> Unit {
  if lib.length() == 0 {
    return
  }
  let mut i = 0
  while i < libs.length() {
    if libs[i] == lib {
      return
    }
    i = i + 1
  }
  libs.push(lib)
}

///|
fn push_nonempty_str(arr : Array[String], s : String) -> Unit {
  if s.length() > 0 {
    arr.push(s)
  }
}

///|
fn toml_apply_link_key(
  spec : LinkSpec,
  section : String,
  key : String,
  raw_val : String,
) -> Result[Unit, String] {
  let mut kind = 0
  if key == "libs" || key == "lib" {
    kind = 1
  } else if key == "frameworks" || key == "framework" {
    kind = 2
  } else if key == "search_paths" || key == "search_path" {
    kind = 3
  } else if key == "rpaths" || key == "rpath" {
    kind = 4
  } else if key == "objects" || key == "object" {
    kind = 5
  } else if key == "flags" {
    kind = 6
  } else if key == "c_sources" || key == "c_source" {
    kind = 7
  } else if key == "cc_flags" {
    kind = 8
  } else if key == "rc_sources" || key == "rc_source" {
    kind = 9
  } else {
    return Err("unknown key `" + key + "` in [" + section + "]")
  }
  let vs = match toml_parse_str_array(raw_val) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let mut vi = 0
  while vi < vs.length() {
    let v = vs[vi]
    if kind == 1 {
      push_unique_lib(spec.libs, v)
    } else if kind == 2 {
      push_unique_lib(spec.frameworks, v)
    } else if kind == 3 {
      push_unique_lib(spec.search_paths, v)
    } else if kind == 4 {
      push_unique_lib(spec.rpaths, v)
    } else if kind == 5 {
      push_unique_lib(spec.objects, v)
    } else if kind == 6 {
      push_nonempty_str(spec.flags, v)
    } else if kind == 7 {
      push_unique_lib(spec.c_sources, v)
    } else if kind == 8 {
      push_nonempty_str(spec.cc_flags, v)
    } else {
      push_unique_lib(spec.rc_sources, v)
    }
    vi = vi + 1
  }
  Ok(())
}

///|
fn mf_starts_with(s : String, pre : String) -> Bool {
  let sl = s.length()
  let pl = pre.length()
  if sl < pl {
    return false
  }
  let mut i = 0
  while i < pl {
    if str_code_at(s, i) != str_code_at(pre, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// Translates GCC/MinGW-style link flags into Clang Windows MSVC target flags,
/// ensuring `-fuse-ld=lld` (unless another `-fuse-ld=` is present), `-lws2_32`,
/// and (for executables) `-Wl,/STACK:16777216` without `-lm` or `-lpthread`.
pub fn win_translate_msvc_flags(
  flags : Array[String],
  is_cdylib : Bool,
) -> Array[String] {
  let out : Array[String] = []
  let mut has_fuse_ld = false
  let mut has_stack = false
  let mut i = 0
  while i < flags.length() {
    let fl = flags[i]
    if fl == "-mwindows" {
      out.push("-Wl,/SUBSYSTEM:WINDOWS")
      out.push("-Wl,/ENTRY:mainCRTStartup")
    } else if fl == "-mconsole" {
      out.push("-Wl,/SUBSYSTEM:CONSOLE")
    } else if fl.length() > 12 && mf_starts_with(fl, "-Wl,--stack,") {
      out.push("-Wl,/STACK:" + slice_str(fl, 12, fl.length()))
      has_stack = true
    } else if fl == "-lm" || fl == "-lpthread" {
      ()
    } else {
      if mf_starts_with(fl, "-fuse-ld=") {
        has_fuse_ld = true
      } else if mf_starts_with(fl, "-Wl,/STACK:") ||
        mf_starts_with(fl, "-Wl,/stack:") {
        has_stack = true
      }
      out.push(fl)
    }
    i = i + 1
  }
  if !has_fuse_ld {
    out.push("-fuse-ld=lld")
  }
  out.push("-lws2_32")
  if !is_cdylib && !has_stack {
    out.push("-Wl,/STACK:16777216")
  }
  out
}

///|
/// Derives a sibling `clang++` / `clang++.exe` driver path when `CC` points to
/// `clang` / `clang.exe` on Windows (returns `""` otherwise).
pub fn win_derive_cxx_from_cc(cc_bin : String) -> String {
  let n = cc_bin.length()
  if n == 0 {
    return ""
  }
  let mut sep = n - 1
  while sep >= 0 {
    let c = str_code_at(cc_bin, sep)
    if c == 47 || c == 92 {
      break
    }
    sep = sep - 1
  }
  let dir_prefix = if sep >= 0 { slice_str(cc_bin, 0, sep + 1) } else { "" }
  let base = slice_str(cc_bin, sep + 1, n)
  if base == "clang" {
    dir_prefix + "clang++"
  } else if base == "clang.exe" {
    dir_prefix + "clang++.exe"
  } else if base == "clang.EXE" {
    dir_prefix + "clang++.EXE"
  } else {
    ""
  }
}

///|
pub fn parse_pion_toml(text : String) -> Result[PackageManifest, String] {
  let lines = split_lines(text)
  let mut section = ""
  let mut pkg_name = ""
  let mut version = "0.1.0"
  let deps : Array[ManifestDep] = []
  let link_common = link_spec_empty()
  let link_macos = link_spec_empty()
  let link_linux = link_spec_empty()
  let link_ios = link_spec_empty()
  let link_android = link_spec_empty()
  let link_windows = link_spec_empty()
  let link_wasm = link_spec_empty()
  let mut registry = ""
  let mut verify_enabled = false
  let mut is_workspace = false
  let workspace_members : Array[String] = []
  let workspace_deps : Array[ManifestDep] = []
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() == 0 {
      i = i + 1
      continue
    }
    if str_code_at(clean, 0) == 91 &&
      str_code_at(clean, clean.length() - 1) == 93 {
      section = toml_trim(slice_str(clean, 1, clean.length() - 1))
      if section == "workspace" || section == "workspace.dependencies" {
        is_workspace = true
      }
      i = i + 1
      continue
    }
    let start_line = i + 1
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err(
        "pion.toml line " + start_line.to_string() + ": expected `key = value`",
      )
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let mut raw_val = toml_trim(slice_str(clean, eq + 1, clean.length()))
    if raw_val.length() > 0 &&
      str_code_at(raw_val, 0) == 91 &&
      toml_find_char(raw_val, 93, 0) < 0 {
      let sb = StringBuilder()
      sb.write_string(raw_val)
      let mut closed = false
      while i + 1 < lines.length() {
        i = i + 1
        let cont = toml_trim(toml_strip_comment(lines[i]))
        if cont.length() == 0 {
          continue
        }
        sb.write_char(' ')
        sb.write_string(cont)
        if toml_find_char(cont, 93, 0) >= 0 {
          closed = true
          break
        }
      }
      if !closed {
        return Err(
          "pion.toml line " + start_line.to_string() + ": unclosed array `[`",
        )
      }
      raw_val = sb.to_string()
    }
    if section == "package" {
      if key == "name" {
        match toml_unquote(raw_val) {
          Ok(v) => pkg_name = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      } else if key == "version" {
        match toml_unquote(raw_val) {
          Ok(v) => version = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      }
    } else if section == "dependencies" {
      match toml_parse_dep(key, raw_val, true) {
        Ok(d) => deps.push(d)
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "workspace" {
      if key == "members" || key == "member" {
        match toml_parse_str_array(raw_val) {
          Ok(vs) => {
            let mut vi = 0
            while vi < vs.length() {
              push_unique_lib(workspace_members, vs[vi])
              vi = vi + 1
            }
          }
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      } else {
        return Err(
          "pion.toml line " +
          start_line.to_string() +
          ": unknown key `" +
          key +
          "` in [workspace]",
        )
      }
    } else if section == "workspace.dependencies" {
      match toml_parse_dep(key, raw_val, false) {
        Ok(d) => workspace_deps.push(d)
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "registry" {
      if key == "url" {
        match toml_unquote(raw_val) {
          Ok(v) => registry = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      }
    } else if section == "verify" {
      if key == "enabled" {
        if raw_val == "true" {
          verify_enabled = true
        } else if raw_val == "false" {
          verify_enabled = false
        } else {
          return Err(
            "pion.toml line " +
            start_line.to_string() +
            ": `enabled` in [verify] must be `true` or `false`",
          )
        }
      } else {
        return Err(
          "pion.toml line " +
          start_line.to_string() +
          ": unknown key `" +
          key +
          "` in [verify]",
        )
      }
    } else if section == "link" {
      match toml_apply_link_key(link_common, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.macos" {
      match toml_apply_link_key(link_macos, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.linux" {
      match toml_apply_link_key(link_linux, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.ios" {
      match toml_apply_link_key(link_ios, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.android" {
      match toml_apply_link_key(link_android, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.windows" {
      match toml_apply_link_key(link_windows, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.wasm" {
      match toml_apply_link_key(link_wasm, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    }
    i = i + 1
  }
  if pkg_name.length() == 0 && !is_workspace {
    return Err("pion.toml: missing `[package]` `name = \"...\"`")
  }
  Ok(PackageManifest::{
    name: pkg_name,
    version: version,
    deps: deps,
    link_libs: link_common.libs,
    link_common: link_common,
    link_macos: link_macos,
    link_linux: link_linux,
    link_ios: link_ios,
    link_android: link_android,
    link_windows: link_windows,
    link_wasm: link_wasm,
    registry: registry,
    is_workspace: is_workspace,
    workspace_members: workspace_members,
    workspace_deps: workspace_deps,
    verify_enabled: verify_enabled,
  })
}

///|
fn topo_dfs(
  idx : Int,
  names : Array[String],
  deps : Array[Array[String]],
  name_to_idx : Map[String, Int],
  color : Array[Int],
  stack : Array[String],
  order : Array[Int],
  diags : Array[Diagnostic],
) -> Unit {
  color[idx] = 1
  stack.push(names[idx])
  let cur_deps = deps[idx]
  let mut i = 0
  while i < cur_deps.length() {
    let dep_name = cur_deps[i]
    match name_to_idx.get(dep_name) {
      None =>
        diags.push(
          diag_new(
            span_new(names[idx] + "/pion.toml", 1, 1),
            "E_UNKNOWN_PACKAGE",
            "unknown dependency package `" + dep_name + "` required by `" + names[idx] + "`",
            "defined package in [dependencies]",
            dep_name,
            "add `" + dep_name + " = { path = \"...\" }` to `pion.toml`",
          ),
        )
      Some(didx) =>
        if color[didx] == 1 {
          let sb = StringBuilder()
          let mut k = 0
          let mut started = false
          while k < stack.length() {
            if stack[k] == dep_name {
              started = true
            }
            if started {
              sb.write_string(stack[k])
              sb.write_string(" -> ")
            }
            k = k + 1
          }
          sb.write_string(dep_name)
          let cycle_str = sb.to_string()
          diags.push(
            diag_new(
              span_new(names[idx] + "/pion.toml", 1, 1),
              "E_IMPORT_CYCLE",
              "cyclic package dependency detected: " + cycle_str,
              "acyclic package dependency graph",
              cycle_str,
              "break the dependency cycle involving `" + dep_name + "`",
            ),
          )
        } else if color[didx] == 0 {
          topo_dfs(didx, names, deps, name_to_idx, color, stack, order, diags)
        }
    }
    i = i + 1
  }
  let _ = stack.pop()
  color[idx] = 2
  order.push(idx)
}

///|
pub fn topo_sort_packages(
  pkg_names : Array[String],
  pkg_deps : Array[Array[String]],
) -> TopoSortResult {
  let n = pkg_names.length()
  let name_to_idx : Map[String, Int] = Map([])
  let color : Array[Int] = []
  let diags : Array[Diagnostic] = []
  let mut i = 0
  while i < n {
    let pname = pkg_names[i]
    if name_to_idx.contains(pname) {
      diags.push(
        diag_new(
          span_new(pname + "/pion.toml", 1, 1),
          "E_DUPLICATE_PACKAGE",
          "duplicate package `" + pname + "` in workspace dependency graph",
          "unique package name per workspace",
          pname,
          "pin `" + pname + "` in pion.toml or [workspace.dependencies]",
        ),
      )
    } else {
      name_to_idx.set(pname, i)
    }
    color.push(0)
    i = i + 1
  }
  let order : Array[Int] = []
  let stack : Array[String] = []
  i = 0
  while i < n {
    if color[i] == 0 {
      topo_dfs(i, pkg_names, pkg_deps, name_to_idx, color, stack, order, diags)
    }
    i = i + 1
  }
  TopoSortResult::{ order: order, diagnostics: diags }
}

///|
pub fn query_workspace_deps_json(
  pkg_names : Array[String],
  pkg_deps : Array[Array[String]],
  sig_hashes : Array[String],
) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"packages\":[")
  let mut i = 0
  while i < pkg_names.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(pkg_names[i]))
    sb.write_string(",\"deps\":[")
    let ds = pkg_deps[i]
    let mut j = 0
    while j < ds.length() {
      if j > 0 {
        sb.write_string(",")
      }
      sb.write_string(json_quote(ds[j]))
      j = j + 1
    }
    sb.write_string("],\"sig_hash\":")
    let h = if i < sig_hashes.length() { sig_hashes[i] } else { "" }
    sb.write_string(json_quote(h))
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// One `[[package]]` entry of `pion.lock`: a git dependency pinned to a full
/// commit `rev`. `reference` is the requested ref (`manifest_dep_ref`), so a
/// lock entry is reused only while `pion.toml` still asks for the same thing.
pub struct LockEntry {
  name : String
  git : String
  reference : String
  rev : String
  subdir : String
}

///|
pub fn lock_entry_new(
  name : String,
  git : String,
  reference : String,
  rev : String,
  subdir : String,
) -> LockEntry {
  LockEntry::{
    name: name,
    git: git,
    reference: reference,
    rev: rev,
    subdir: subdir,
  }
}

///|
fn lock_entry_sort_key(e : LockEntry) -> String {
  e.name + "\n" + e.git + "\n" + e.subdir + "\n" + e.reference + "\n" + e.rev
}

///|
/// Plain code-unit lexicographic order (independent of the host `String` compare).
fn lock_str_less(a : String, b : String) -> Bool {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  let mut i = 0
  while i < n {
    let ca = str_code_at(a, i)
    let cb = str_code_at(b, i)
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  a.length() < b.length()
}

///|
/// Parses `pion.lock` (`[[package]]` tables of `name`/`git`/`ref`/`rev`/`subdir`).
pub fn parse_pion_lock(text : String) -> Result[Array[LockEntry], String] {
  let lines = split_lines(text)
  let out : Array[LockEntry] = []
  let mut in_pkg = false
  let mut name = ""
  let mut git = ""
  let mut reference = ""
  let mut rev = ""
  let mut subdir = ""
  let mut start_line = 0
  let mut i = 0
  while i <= lines.length() {
    let at_end = i == lines.length()
    let clean = if at_end { "" } else { toml_trim(toml_strip_comment(lines[i])) }
    let is_header = !at_end && clean == "[[package]]"
    if at_end || is_header {
      if in_pkg {
        if name.length() == 0 || git.length() == 0 || rev.length() == 0 {
          return Err(
            "pion.lock line " +
            start_line.to_string() +
            ": [[package]] needs `name`, `git` and `rev`",
          )
        }
        if !lock_is_hex_oid(rev) {
          return Err(
            "pion.lock line " +
            start_line.to_string() +
            ": `rev` must be a full lowercase hex commit id (40 or 64 digits)",
          )
        }
        out.push(lock_entry_new(name, git, reference, rev, subdir))
      }
      if is_header {
        in_pkg = true
        name = ""
        git = ""
        reference = ""
        rev = ""
        subdir = ""
        start_line = i + 1
      }
      i = i + 1
      continue
    }
    if clean.length() == 0 {
      i = i + 1
      continue
    }
    if str_code_at(clean, 0) == 91 {
      return Err(
        "pion.lock line " + (i + 1).to_string() + ": unexpected table `" + clean + "`",
      )
    }
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err("pion.lock line " + (i + 1).to_string() + ": expected `key = value`")
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let raw_val = toml_trim(slice_str(clean, eq + 1, clean.length()))
    if in_pkg {
      let v = match toml_unquote(raw_val) {
        Ok(x) => x
        Err(e) => return Err("pion.lock line " + (i + 1).to_string() + ": " + e)
      }
      if key == "name" {
        name = v
      } else if key == "git" {
        git = v
      } else if key == "ref" {
        reference = v
      } else if key == "rev" {
        rev = v
      } else if key == "subdir" {
        subdir = v
      }
    }
    i = i + 1
  }
  Ok(out)
}

///|
/// Deterministic `pion.lock` text: entries sorted by name/git/subdir, one
/// `[[package]]` table each, with every key always written.
pub fn format_pion_lock(entries : Array[LockEntry]) -> String {
  let sorted : Array[LockEntry] = []
  let mut i = 0
  while i < entries.length() {
    sorted.push(entries[i])
    i = i + 1
  }
  i = 1
  while i < sorted.length() {
    let cur = sorted[i]
    let ck = lock_entry_sort_key(cur)
    let mut j = i - 1
    while j >= 0 && lock_str_less(ck, lock_entry_sort_key(sorted[j])) {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = cur
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("# pion.lock: generated by pionc; do not edit by hand.\n")
  sb.write_string("version = 1\n")
  i = 0
  while i < sorted.length() {
    let e = sorted[i]
    sb.write_string("\n[[package]]\nname = ")
    sb.write_string(json_quote(e.name))
    sb.write_string("\ngit = ")
    sb.write_string(json_quote(e.git))
    sb.write_string("\nref = ")
    sb.write_string(json_quote(e.reference))
    sb.write_string("\nrev = ")
    sb.write_string(json_quote(e.rev))
    sb.write_string("\nsubdir = ")
    sb.write_string(json_quote(e.subdir))
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///|
/// The locked entry for `dep`, if `pion.lock` pins the same name, URL, subdir
/// and requested ref.
pub fn lock_find(entries : Array[LockEntry], dep : ManifestDep) -> Option[LockEntry] {
  let want_ref = manifest_dep_ref(dep)
  let mut i = 0
  while i < entries.length() {
    let e = entries[i]
    if e.name == dep.name &&
      e.git == dep.git &&
      e.subdir == dep.subdir &&
      e.reference == want_ref {
      return Some(e)
    }
    i = i + 1
  }
  None
}

///|
/// Adds `e` to `entries` (keyed by name/git/subdir). Fails when the same
/// dependency was already resolved to a different revision.
pub fn lock_add(entries : Array[LockEntry], e : LockEntry) -> Result[Unit, String] {
  let mut i = 0
  while i < entries.length() {
    let o = entries[i]
    if o.name == e.name && o.git == e.git && o.subdir == e.subdir {
      if o.rev != e.rev || o.reference != e.reference {
        return Err(
          "git dependency `" +
          e.name +
          "` is required as both " +
          o.reference +
          " (" +
          o.rev +
          ") and " +
          e.reference +
          " (" +
          e.rev +
          ")",
        )
      }
      return Ok(())
    }
    i = i + 1
  }
  entries.push(e)
  Ok(())
}

///|
/// Merged `pionc test --json` report over several packages. Keeps the
/// single-package keys (`ok`, `passed`, `failed`, `tests`) and adds `total`,
/// `packages` and a `pkg` on every test.
pub fn format_workspace_test_report_json(
  packages : Array[String],
  test_pkgs : Array[String],
  names : Array[String],
  passed_flags : Array[Bool],
) -> String {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < names.length() && i < passed_flags.length() {
    if passed_flags[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if failed == 0 { "true" } else { "false" })
  sb.write_string(",\"total\":")
  sb.write_string((passed + failed).to_string())
  sb.write_string(",\"passed\":")
  sb.write_string(passed.to_string())
  sb.write_string(",\"failed\":")
  sb.write_string(failed.to_string())
  sb.write_string(",\"packages\":[")
  i = 0
  while i < packages.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(packages[i]))
    i = i + 1
  }
  sb.write_string("],\"tests\":[")
  i = 0
  while i < names.length() && i < passed_flags.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"pkg\":")
    sb.write_string(json_quote(if i < test_pkgs.length() { test_pkgs[i] } else { "" }))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(names[i]))
    sb.write_string(",\"ok\":")
    sb.write_string(if passed_flags[i] { "true" } else { "false" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// Package name for `pionc init <dir>`: the last path component, lowercased,
/// with every character outside `[a-z0-9_]` turned into `_`.
pub fn init_package_name(dir : String) -> String {
  let mut end = dir.length()
  while end > 1 && str_code_at(dir, end - 1) == 47 {
    end = end - 1
  }
  let mut start = end - 1
  while start >= 0 && str_code_at(dir, start) != 47 {
    start = start - 1
  }
  let sb = StringBuilder()
  let mut i = start + 1
  while i < end {
    let c = str_code_at(dir, i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  let raw = sb.to_string()
  if raw.length() == 0 || raw == "_" || raw == "__" {
    "app"
  } else if str_code_at(raw, 0) >= 48 && str_code_at(raw, 0) <= 57 {
    "pkg_" + raw
  } else {
    raw
  }
}

///|
pub fn init_pion_toml(name : String) -> String {
  "[package]\nname = " +
  json_quote(name) +
  "\nversion = \"0.1.0\"\n\n[dependencies]\n"
}

///|
pub fn init_main_source(name : String) -> String {
  "///| " +
  name +
  ": generated by `pionc init`.\n\n" +
  "///|\npub fn greet(who : String) -> String {\n  \"Hello, \" + who + \"!\"\n}\n\n" +
  "///|\npub fn main(world : World) -> Int {\n  io_println(world, greet(" +
  json_quote(name) +
  "))\n  0\n}\n"
}

///|
pub fn init_test_source(name : String) -> String {
  "///| " +
  name +
  " tests.\n\n" +
  "///|\ntest \"greet\" {\n  debug_assert(greet(\"pion\") == \"Hello, pion!\", \"greet\")\n}\n"
}

///|
pub fn init_service_pion_toml(name : String) -> String {
  init_pion_toml(name)
}

///|
pub fn init_service_worker_source(name : String) -> String {
  "///| " +
  name +
  ": background worker consuming commands over a `Channel`.\n\n" +
  "///|\npub enum ServiceJob {\n  Compute(Int)\n  Stop\n}\n\n" +
  "///|\npub fn handle_job(input : Int) -> Int {\n  input * 2 + 1\n}\n\n" +
  "///|\npub fn run_worker(\n  world : World,\n  jobs : Channel[ServiceJob],\n  results : Channel[Int],\n) -> Unit {\n  let _ = world\n  while true {\n    match jobs.recv() {\n      Some(ServiceJob::Compute(n)) => {\n        let _ = results.send(handle_job(n))\n      }\n      Some(ServiceJob::Stop) => break\n      None => break\n    }\n  }\n  results.close()\n}\n"
}

///|
pub fn init_service_main_source(name : String) -> String {
  "///| " +
  name +
  ": service generated by `pionc init --template service`.\n\n" +
  "///|\npub fn main(world : World) -> Int {\n  let jobs : Channel[ServiceJob] = Channel::new(16)\n  let results : Channel[Int] = Channel::new(16)\n  scope(world, fn(s : Scope) -> Unit {\n    spawn(s, fn() -> Unit {\n      run_worker(world, jobs, results)\n    })\n    let _ = jobs.send(ServiceJob::Compute(10))\n    let _ = jobs.send(ServiceJob::Compute(20))\n    let _ = jobs.send(ServiceJob::Stop)\n    let mut total = 0\n    while true {\n      match results.recv() {\n        Some(v) => total = total + v\n        None => break\n      }\n    }\n    io_println(world, \"service \" + " +
  json_quote(name) +
  " + \" total=\" + total.to_string())\n  })\n  0\n}\n"
}

///|
pub fn init_service_test_source(name : String) -> String {
  "///| " +
  name +
  " service tests.\n\n" +
  "///|\ntest \"worker job handling\" {\n  let jobs : Channel[ServiceJob] = Channel::new(4)\n  let _ = jobs.send(ServiceJob::Compute(20))\n  let _ = jobs.send(ServiceJob::Stop)\n  match jobs.recv() {\n    Some(ServiceJob::Compute(n)) => debug_assert(handle_job(n) == 41, \"handle_job\")\n    _ => debug_assert(false, \"expected Compute\")\n  }\n  match jobs.recv() {\n    Some(ServiceJob::Stop) => ()\n    _ => debug_assert(false, \"expected Stop\")\n  }\n}\n"
}

///|
pub fn init_invar_pion_toml(name : String) -> String {
  "[package]\nname = " +
  json_quote(name) +
  "\nversion = \"0.1.0\"\n\n[dependencies]\n# Example git dependency from pion-packages:\n# json = { git = \"https://github.com/AFK-surf/pion-packages.git\", tag = \"json-v0.1.0\", subdir = \"packages/json\" }\n"
}

///|
pub fn init_invar_protocol_source(name : String) -> String {
  "///| " +
  name +
  ": Send-safe commands and events exchanged between render and worker threads.\n\n" +
  "///|\npub enum AppCmd {\n  Ping(Int)\n  Shutdown\n}\n\n" +
  "///|\npub enum AppEvent {\n  Pong(Int)\n}\n"
}

///|
pub fn init_invar_worker_source(name : String) -> String {
  "///| " +
  name +
  ": background worker thread owning `World` (all blocking IO and heavy compute live here).\n\n" +
  "///|\npub fn process_cmd(cmd : AppCmd) -> Option[AppEvent] {\n  match cmd {\n    AppCmd::Ping(n) => Some(AppEvent::Pong(n + 1))\n    AppCmd::Shutdown => None\n  }\n}\n\n" +
  "///|\npub fn run_worker(\n  world : World,\n  cmd_rx : Channel[AppCmd],\n  ev_tx : Channel[AppEvent],\n  wake : () -> Unit,\n) -> Unit {\n  let _ = world\n  while true {\n    match cmd_rx.recv() {\n      Some(cmd) => {\n        match process_cmd(cmd) {\n          Some(ev) => {\n            let _ = ev_tx.send(ev)\n            wake()\n          }\n          None => break\n        }\n      }\n      None => break\n    }\n  }\n  ev_tx.close()\n}\n"
}

///|
pub fn init_invar_view_source(name : String) -> String {
  "///| " +
  name +
  ": render-thread view state and event dispatch (zero World, zero blocking IO).\n\n" +
  "///|\npub struct ViewState {\n  mut last_pong : Int\n  mut events_seen : Int\n}\n\n" +
  "///|\n#render_thread\npub fn view_state_new() -> ViewState {\n  ViewState::{ last_pong: 0, events_seen: 0 }\n}\n\n" +
  "///|\n#render_thread\npub fn on_ping_click(cmd_tx : Channel[AppCmd], seq : Int) -> Bool {\n  // With Invar, call `worker.send(AppCmd::Ping(seq))` from button/input callbacks.\n  cmd_tx.send(AppCmd::Ping(seq))\n}\n\n" +
  "///|\n#render_thread\npub fn apply_event(state : ViewState, ev : AppEvent) -> Unit {\n  match ev {\n    AppEvent::Pong(n) => {\n      state.last_pong = n\n      state.events_seen = state.events_seen + 1\n    }\n  }\n}\n\n" +
  "///|\n#render_thread\npub fn drain_events(state : ViewState, ev_rx : Channel[AppEvent]) -> Int {\n  // With Invar, `worker.bind(fn(ev) { apply_event(state, ev) })` registers `ui::on_before_frame`\n  // to zero-latency batch-drain `Mutex[Array[AppEvent]]` on the render thread before each frame.\n  let mut count = 0\n  while true {\n    match ev_rx.recv() {\n      Some(ev) => {\n        apply_event(state, ev)\n        count = count + 1\n      }\n      None => break\n    }\n  }\n  count\n}\n"
}

///|
pub fn init_invar_main_source(name : String) -> String {
  "///| " +
  name +
  ": dual-thread Invar app skeleton generated by `pionc init --template invar-app`.\n\n" +
  "///|\npub fn main(world : World) -> Int {\n  let cmd_ch : Channel[AppCmd] = Channel::new(32)\n  let ev_ch : Channel[AppEvent] = Channel::new(32)\n  scope(world, fn(s : Scope) -> Unit {\n    // Background worker owns `world`.\n    // With Invar: `let (worker, ctx) = ui::Worker::pair()`, bind `worker.bind(...)`,\n    // run `ctx.run_loop(fn(cmd, emit) { ... })` inside `spawn` (emitting wakes via `ui::wake_now()`),\n    // and call `worker.send(cmd)` / `worker.close()` from the render thread.\n    // For wasm32 and deterministic `Tester` runs, use `ui::Worker::inline(...)`.\n    spawn(s, fn() -> Unit {\n      run_worker(world, cmd_ch, ev_ch, fn() -> Unit { () })\n    })\n    let state = view_state_new()\n    let _ = on_ping_click(cmd_ch, 41)\n    let _ = cmd_ch.send(AppCmd::Shutdown)\n    let n = drain_events(state, ev_ch)\n    io_println(\n      world,\n      " +
  json_quote(name + ": drained=") +
  " + n.to_string() + \" last_pong=\" + state.last_pong.to_string(),\n    )\n  })\n  0\n}\n"
}

///|
pub fn init_invar_test_source(name : String) -> String {
  "///| " +
  name +
  " render/worker protocol tests.\n\n" +
  "///|\ntest \"cmd -> worker -> event roundtrip\" {\n  let cmd_ch : Channel[AppCmd] = Channel::new(8)\n  let ev_ch : Channel[AppEvent] = Channel::new(8)\n  let state = view_state_new()\n  debug_assert(on_ping_click(cmd_ch, 41), \"send ping\")\n  let _ = cmd_ch.send(AppCmd::Shutdown)\n  while true {\n    match cmd_ch.recv() {\n      Some(cmd) => {\n        match process_cmd(cmd) {\n          Some(ev) => {\n            let _ = ev_ch.send(ev)\n          }\n          None => break\n        }\n      }\n      None => break\n    }\n  }\n  ev_ch.close()\n  let n = drain_events(state, ev_ch)\n  debug_assert(n == 1 && state.last_pong == 42 && state.events_seen == 1, \"pong 42\")\n}\n"
}

///|
/// A full git object id: 40 (SHA-1) or 64 (SHA-256) lowercase hex digits.
pub fn lock_is_hex_oid(s : String) -> Bool {
  if s.length() != 40 && s.length() != 64 {
    return false
  }
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if !((c >= 48 && c <= 57) || (c >= 97 && c <= 102)) {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// One `index/<name>.toml` entry of a git-index package registry: where the
/// package's source lives (`git` + at most one of `tag` / `rev` / `branch`,
/// optional monorepo `subdir`) and its published `version`.
pub struct RegistryEntry {
  name : String
  version : String
  git : String
  tag : String
  rev : String
  branch : String
  subdir : String
}

///|
/// Path of a package's entry inside a registry index repository.
pub fn registry_index_path(name : String) -> String {
  "index/" + name + ".toml"
}

///|
/// A dependency / registry package name usable as a bare `pion.toml` key:
/// `[A-Za-z_][A-Za-z0-9_-]*`.
pub fn manifest_valid_dep_name(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  let mut i = 0
  while i < name.length() {
    let c = str_code_at(name, i)
    let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    let digit = c >= 48 && c <= 57
    if i == 0 && !alpha {
      return false
    }
    if !alpha && !digit && c != 45 {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// Parses a registry index entry (`git = "..."`, `tag`/`rev`/`branch`,
/// `subdir`, `version`, optional `name` that must match).
pub fn parse_registry_entry(
  name : String,
  text : String,
) -> Result[RegistryEntry, String] {
  let lines = split_lines(text)
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut version = ""
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() == 0 || str_code_at(clean, 0) == 91 {
      i = i + 1
      continue
    }
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err(
        registry_index_path(name) +
        " line " +
        (i + 1).to_string() +
        ": expected `key = value`",
      )
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let v = match toml_unquote(slice_str(clean, eq + 1, clean.length())) {
      Ok(x) => x
      Err(e) =>
        return Err(
          registry_index_path(name) + " line " + (i + 1).to_string() + ": " + e,
        )
    }
    if key == "git" {
      git = v
    } else if key == "tag" {
      tag = v
    } else if key == "rev" {
      rev = v
    } else if key == "branch" {
      branch = v
    } else if key == "subdir" {
      subdir = v
    } else if key == "version" {
      version = v
    } else if key == "name" && v != name {
      return Err(
        registry_index_path(name) + ": entry is for package `" + v + "`",
      )
    }
    i = i + 1
  }
  if git.length() == 0 {
    return Err(registry_index_path(name) + ": missing `git = \"...\"`")
  }
  let mut nrefs = 0
  if tag.length() > 0 {
    nrefs = nrefs + 1
  }
  if rev.length() > 0 {
    nrefs = nrefs + 1
  }
  if branch.length() > 0 {
    nrefs = nrefs + 1
  }
  if nrefs > 1 {
    return Err(
      registry_index_path(name) + ": more than one of `tag`, `rev`, `branch`",
    )
  }
  Ok(RegistryEntry::{
    name: name,
    version: version,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
  })
}

///|
/// The `pion.toml` dependency for a registry entry, remembering `registry`.
pub fn registry_entry_dep(e : RegistryEntry, registry : String) -> ManifestDep {
  ManifestDep::{
    name: e.name,
    path: "",
    git: e.git,
    tag: e.tag,
    rev: e.rev,
    branch: e.branch,
    subdir: e.subdir,
    registry: registry,
    version: e.version,
    workspace: false,
  }
}

///|
/// Inline-table form of a dependency, with keys in a fixed order:
/// `{ workspace = true }`, `{ path = "..." }` or `{ git = "...", tag = "...",
/// subdir = "...", version = "...", registry = "..." }` (empty keys left out).
pub fn format_dep_inline(dep : ManifestDep) -> String {
  if dep.workspace {
    return "{ workspace = true }"
  }
  if dep.git.length() == 0 {
    return "{ path = " + json_quote(dep.path) + " }"
  }
  let sb = StringBuilder()
  sb.write_string("{ git = ")
  sb.write_string(json_quote(dep.git))
  if dep.tag.length() > 0 {
    sb.write_string(", tag = ")
    sb.write_string(json_quote(dep.tag))
  }
  if dep.rev.length() > 0 {
    sb.write_string(", rev = ")
    sb.write_string(json_quote(dep.rev))
  }
  if dep.branch.length() > 0 {
    sb.write_string(", branch = ")
    sb.write_string(json_quote(dep.branch))
  }
  if dep.subdir.length() > 0 {
    sb.write_string(", subdir = ")
    sb.write_string(json_quote(dep.subdir))
  }
  if dep.version.length() > 0 {
    sb.write_string(", version = ")
    sb.write_string(json_quote(dep.version))
  }
  if dep.registry.length() > 0 {
    sb.write_string(", registry = ")
    sb.write_string(json_quote(dep.registry))
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
/// Splits at every newline, keeping a trailing empty segment ("a\n" -> ["a", ""]).
fn toml_split_keep(text : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < text.length() {
    if str_code_at(text, i) == 10 {
      out.push(slice_str(text, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(text, start, text.length()))
  out
}

///|
/// Sets `dep` in the `[dependencies]` table of a `pion.toml` text: replaces
/// the line of an existing entry with the same name in place, else appends it
/// after the table's last entry (creating the table at the end when missing).
/// Every other line is kept byte for byte, and setting the same dependency
/// again returns the text unchanged.
pub fn manifest_set_dependency(text : String, dep : ManifestDep) -> String {
  let line = dep.name + " = " + format_dep_inline(dep)
  let lines = toml_split_keep(text)
  let mut section = ""
  let mut dep_header = -1
  let mut last_entry = -1
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() > 0 {
      if str_code_at(clean, 0) == 91 &&
        str_code_at(clean, clean.length() - 1) == 93 {
        section = toml_trim(slice_str(clean, 1, clean.length() - 1))
        if section == "dependencies" && dep_header < 0 {
          dep_header = i
        }
      } else if section == "dependencies" {
        let eq = toml_find_char(clean, 61, 0)
        if eq > 0 && toml_trim(slice_str(clean, 0, eq)) == dep.name {
          lines[i] = line
          return join_lines_nl(lines)
        }
        last_entry = i
      }
    }
    i = i + 1
  }
  if dep_header >= 0 {
    let at = if last_entry > dep_header { last_entry + 1 } else { dep_header + 1 }
    let out : Array[String] = []
    let mut j = 0
    while j < lines.length() {
      if j == at {
        out.push(line)
      }
      out.push(lines[j])
      j = j + 1
    }
    if at >= lines.length() {
      out.push(line)
    }
    return join_lines_nl(out)
  }
  let sb = StringBuilder()
  sb.write_string(text)
  if text.length() > 0 && str_code_at(text, text.length() - 1) != 10 {
    sb.write_string("\n")
  }
  if text.length() > 0 {
    sb.write_string("\n")
  }
  sb.write_string("[dependencies]\n")
  sb.write_string(line)
  sb.write_string("\n")
  sb.to_string()
}

///|
fn join_lines_nl(lines : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      sb.write_string("\n")
    }
    sb.write_string(lines[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// The locked commit of the git dependency `name` ("" when not locked).
pub fn lock_rev_of(entries : Array[LockEntry], name : String) -> String {
  let mut i = 0
  while i < entries.length() {
    if entries[i].name == name {
      return entries[i].rev
    }
    i = i + 1
  }
  ""
}

///|
fn mf_is_abs_path(p : String) -> Bool {
  let n = p.length()
  if n == 0 {
    return false
  }
  if str_code_at(p, 0) == 47 {
    return true
  }
  if n >= 3 {
    let c0 = str_code_at(p, 0)
    let is_drive = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
    let c2 = str_code_at(p, 2)
    if is_drive && str_code_at(p, 1) == 58 && (c2 == 47 || c2 == 92) {
      return true
    }
  }
  false
}

///|
fn mf_join_path(base : String, rel : String) -> String {
  if base.length() == 0 || base == "." {
    return rel
  }
  if rel.length() == 0 {
    return base
  }
  if str_code_at(base, base.length() - 1) == 47 {
    base + rel
  } else {
    base + "/" + rel
  }
}

///|
fn mf_normalize_path(path : String) -> String {
  let is_abs = path.length() > 0 && str_code_at(path, 0) == 47
  let parts : Array[String] = []
  let mut seg_start = 0
  let mut i = 0
  while i <= path.length() {
    let is_sep = i == path.length() || str_code_at(path, i) == 47
    if is_sep {
      // Segments are copied as whole byte ranges so UTF-8 names stay intact.
      let seg = slice_str(path, seg_start, i)
      seg_start = i + 1
      if seg.length() == 0 || seg == "." {
        ()
      } else if seg == ".." {
        if parts.length() > 0 && parts[parts.length() - 1] != ".." {
          let _ = parts.pop()
        } else if !is_abs {
          parts.push("..")
        }
      } else {
        parts.push(seg)
      }
    }
    i = i + 1
  }
  let out = StringBuilder()
  if is_abs {
    out.write_char('/')
  }
  let mut j = 0
  while j < parts.length() {
    if j > 0 {
      out.write_char('/')
    }
    out.write_string(parts[j])
    j = j + 1
  }
  let res = out.to_string()
  if res.length() == 0 {
    "."
  } else {
    res
  }
}

///|
fn mf_split_path_segs(norm : String) -> Array[String] {
  let segs : Array[String] = []
  let n = norm.length()
  let mut start = 0
  if n > 0 && str_code_at(norm, 0) == 47 {
    start = 1
  }
  let mut i = start
  while i <= n {
    if i == n || str_code_at(norm, i) == 47 {
      if i > start {
        let seg = slice_str(norm, start, i)
        if seg != "." {
          segs.push(seg)
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  segs
}

///|
fn mf_rebase_rel_path(from_dir : String, target : String) -> String {
  let f_segs = mf_split_path_segs(from_dir)
  let t_segs = mf_split_path_segs(target)
  let mut common = 0
  while common < f_segs.length() &&
    common < t_segs.length() &&
    f_segs[common] == t_segs[common] {
    common = common + 1
  }
  if common < f_segs.length() && f_segs[common] == ".." {
    return target
  }
  let out : Array[String] = []
  let mut i = common
  while i < f_segs.length() {
    out.push("..")
    i = i + 1
  }
  let mut j = common
  while j < t_segs.length() {
    out.push(t_segs[j])
    j = j + 1
  }
  if out.length() == 0 {
    return "."
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < out.length() {
    if k > 0 {
      sb.write_char('/')
    }
    sb.write_string(out[k])
    k = k + 1
  }
  sb.to_string()
}

///|
/// Resolves a `workspace = true` dependency against the workspace root's
/// `[workspace.dependencies]`. Non-workspace dependencies are returned unchanged.
/// Path dependencies are rewritten relative to `ws_root_dir` (canonical absolute
/// path when `ws_root_dir` is absolute, or rebased relative to `pkg_dir` when
/// both are relative) so sub-packages at any nesting depth locate the target.
pub fn manifest_resolve_ws_dep(
  dep : ManifestDep,
  ws_root_dir : String,
  pkg_dir : String,
  ws_deps : Array[ManifestDep],
) -> Result[ManifestDep, String] {
  if !dep.workspace {
    return Ok(dep)
  }
  let mut i = 0
  while i < ws_deps.length() {
    let wdep = ws_deps[i]
    if wdep.name == dep.name {
      if manifest_dep_is_git(wdep) {
        return Ok(ManifestDep::{
          name: dep.name,
          path: "",
          git: wdep.git,
          tag: wdep.tag,
          rev: wdep.rev,
          branch: wdep.branch,
          subdir: wdep.subdir,
          registry: wdep.registry,
          version: wdep.version,
          workspace: false,
        })
      }
      let resolved_path = if mf_is_abs_path(wdep.path) {
        mf_normalize_path(wdep.path)
      } else if mf_is_abs_path(ws_root_dir) {
        mf_normalize_path(mf_join_path(ws_root_dir, wdep.path))
      } else {
        let target = mf_normalize_path(mf_join_path(ws_root_dir, wdep.path))
        if pkg_dir.length() > 0 && !mf_is_abs_path(pkg_dir) {
          mf_rebase_rel_path(mf_normalize_path(pkg_dir), target)
        } else {
          target
        }
      }
      return Ok(ManifestDep::{
        name: dep.name,
        path: resolved_path,
        git: "",
        tag: "",
        rev: "",
        branch: "",
        subdir: "",
        registry: "",
        version: "",
        workspace: false,
      })
    }
    i = i + 1
  }
  Err(
    "dependency '" +
    dep.name +
    "' marked workspace = true but not found in [workspace.dependencies]",
  )
}

///|
fn mf_match_seg_glob(pat : String, text : String) -> Bool {
  let plen = pat.length()
  let tlen = text.length()
  let mut pi = 0
  let mut ti = 0
  let mut star_pi = -1
  let mut star_ti = -1
  while ti < tlen {
    if pi < plen && str_code_at(pat, pi) == 42 {
      star_pi = pi
      star_ti = ti
      pi = pi + 1
    } else if pi < plen && str_code_at(pat, pi) == str_code_at(text, ti) {
      pi = pi + 1
      ti = ti + 1
    } else if star_pi >= 0 {
      pi = star_pi + 1
      star_ti = star_ti + 1
      ti = star_ti
    } else {
      return false
    }
  }
  while pi < plen && str_code_at(pat, pi) == 42 {
    pi = pi + 1
  }
  pi == plen
}

///|
/// Matches a `[workspace] members` pattern against a workspace-relative package
/// path. Supports exact paths (`"cmd/mousedpi"`), single-segment wildcards
/// (`"packages/*"` matches `"packages/ui"` but not `"packages/a/b"`), and
/// normalized `./` or trailing `/` forms.
pub fn manifest_match_member_pattern(pattern : String, rel_path : String) -> Bool {
  if pattern.length() == 0 || rel_path.length() == 0 {
    return false
  }
  if mf_is_abs_path(pattern) != mf_is_abs_path(rel_path) {
    return false
  }
  let np = mf_normalize_path(pattern)
  let nr = mf_normalize_path(rel_path)
  if np == "." || nr == "." {
    return np == nr
  }
  let p_segs = mf_split_path_segs(np)
  let r_segs = mf_split_path_segs(nr)
  if p_segs.length() != r_segs.length() {
    return false
  }
  let mut i = 0
  while i < p_segs.length() {
    let ps = p_segs[i]
    let rs = r_segs[i]
    if ps == "*" {
      if rs.length() == 0 || rs == "." || rs == ".." {
        return false
      }
    } else if !mf_match_seg_glob(ps, rs) {
      return false
    }
    i = i + 1
  }
  true
}
