///| Pure Pion ∩ MoonBit `pion.toml` manifest parser & package dependency graph

///|
/// A `[dependencies]` entry: either a local `path` dependency or a `git`
/// dependency pinned by at most one of `tag` / `rev` / `branch` (default: the
/// remote `HEAD`), optionally rooted at a monorepo `subdir`. A dependency
/// added from a git-index registry (`pionc add <name>`) also records that
/// `registry` and the index entry's `version`, so `pionc update` can re-read it.
pub struct ManifestDep {
  name : String
  path : String
  git : String
  tag : String
  rev : String
  branch : String
  subdir : String
  registry : String
  version : String
}

///|
pub fn manifest_dep_new(
  name : String,
  path : String,
  git : String,
  tag : String,
  rev : String,
  branch : String,
  subdir : String,
) -> ManifestDep {
  ManifestDep::{
    name: name,
    path: path,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
    registry: "",
    version: "",
  }
}

///|
pub fn manifest_dep_is_git(dep : ManifestDep) -> Bool {
  dep.git.length() > 0
}

///|
/// The requested git reference of a dependency, as recorded in `pion.lock`:
/// `tag:<t>`, `rev:<sha>`, `branch:<b>` or `HEAD`.
pub fn manifest_dep_ref(dep : ManifestDep) -> String {
  if dep.tag.length() > 0 {
    "tag:" + dep.tag
  } else if dep.rev.length() > 0 {
    "rev:" + dep.rev
  } else if dep.branch.length() > 0 {
    "branch:" + dep.branch
  } else {
    "HEAD"
  }
}

///|
/// Native link & C/C++/ObjC stub compilation settings from `[link]`,
/// `[link.macos]`, `[link.linux]`, `[link.ios]` or `[link.android]` in `pion.toml`.
pub struct LinkSpec {
  libs : Array[String]
  frameworks : Array[String]
  search_paths : Array[String]
  rpaths : Array[String]
  objects : Array[String]
  flags : Array[String]
  c_sources : Array[String]
  cc_flags : Array[String]
}

///|
pub fn link_spec_empty() -> LinkSpec {
  LinkSpec::{
    libs: [],
    frameworks: [],
    search_paths: [],
    rpaths: [],
    objects: [],
    flags: [],
    c_sources: [],
    cc_flags: [],
  }
}

///|
pub struct PackageManifest {
  name : String
  version : String
  deps : Array[ManifestDep]
  link_libs : Array[String]
  link_common : LinkSpec
  link_macos : LinkSpec
  link_linux : LinkSpec
  link_ios : LinkSpec
  link_android : LinkSpec
  registry : String
}

///|
pub struct PkgNodeInput {
  name : String
  dir : String
  deps : Array[String]
  paths : Array[String]
  sources : Array[String]
  link_libs : Array[String]
  link_common : LinkSpec
  link_macos : LinkSpec
  link_linux : LinkSpec
  link_ios : LinkSpec
  link_android : LinkSpec
}

///|
pub fn pkg_node_input_new(
  name : String,
  dir : String,
  deps : Array[String],
  paths : Array[String],
  sources : Array[String],
) -> PkgNodeInput {
  PkgNodeInput::{
    name: name,
    dir: dir,
    deps: deps,
    paths: paths,
    sources: sources,
    link_libs: [],
    link_common: link_spec_empty(),
    link_macos: link_spec_empty(),
    link_linux: link_spec_empty(),
    link_ios: link_spec_empty(),
    link_android: link_spec_empty(),
  }
}

///|
pub struct TopoSortResult {
  order : Array[Int]
  diagnostics : Array[Diagnostic]
}

///|
fn toml_trim(s : String) -> String {
  let len = s.length()
  let mut a = 0
  while a < len {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = len
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  slice_str(s, a, b)
}

///|
fn toml_strip_comment(line : String) -> String {
  let len = line.length()
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < len {
    let c = str_code_at(line, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return slice_str(line, 0, i)
    }
    i = i + 1
  }
  line
}

///|
fn toml_find_char(s : String, ch : Int, start : Int) -> Int {
  let len = s.length()
  let mut in_str = false
  let mut esc = false
  let mut i = start
  while i < len {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn toml_unquote(raw : String) -> Result[String, String] {
  let s = toml_trim(raw)
  let len = s.length()
  if len < 2 || str_code_at(s, 0) != 34 || str_code_at(s, len - 1) != 34 {
    return Err("expected quoted string, found `" + s + "`")
  }
  let sb = StringBuilder()
  let mut i = 1
  while i < len - 1 {
    let c = str_code_at(s, i)
    if c == 92 && i + 1 < len - 1 {
      let nc = str_code_at(s, i + 1)
      if nc == 110 {
        sb.write_char('\n')
      } else if nc == 116 {
        sb.write_char('\t')
      } else if nc == 114 {
        sb.write_char('\r')
      } else if nc == 34 {
        sb.write_char('"')
      } else if nc == 92 {
        sb.write_char('\\')
      } else {
        sb.write_char(nc.unsafe_to_char())
      }
      i = i + 2
    } else {
      sb.write_char(c.unsafe_to_char())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///|
fn toml_parse_dep(name : String, rhs : String) -> Result[ManifestDep, String] {
  let s = toml_trim(rhs)
  if s.length() >= 2 && str_code_at(s, 0) == 34 {
    match toml_unquote(s) {
      Ok(p) => return Ok(manifest_dep_new(name, p, "", "", "", "", ""))
      Err(e) => return Err(e)
    }
  }
  if s.length() < 2 ||
    str_code_at(s, 0) != 123 ||
    str_code_at(s, s.length() - 1) != 125 {
    return Err(
      "expected `{ path = \"...\" }` or `{ git = \"...\", tag = \"...\" }` in [dependencies], found `" +
      s +
      "`",
    )
  }
  let mut path = ""
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut registry = ""
  let mut version = ""
  let inner = toml_trim(slice_str(s, 1, s.length() - 1))
  let mut pos = 0
  let ilen = inner.length()
  while pos < ilen {
    let comma = toml_find_char(inner, 44, pos)
    let end_p = if comma < 0 { ilen } else { comma }
    let entry = toml_trim(slice_str(inner, pos, end_p))
    if entry.length() > 0 {
      let eq = toml_find_char(entry, 61, 0)
      if eq > 0 {
        let k = toml_trim(slice_str(entry, 0, eq))
        let v = toml_trim(slice_str(entry, eq + 1, entry.length()))
        if k == "path" ||
          k == "git" ||
          k == "tag" ||
          k == "rev" ||
          k == "branch" ||
          k == "subdir" ||
          k == "registry" ||
          k == "version" {
          let uv = match toml_unquote(v) {
            Ok(x) => x
            Err(e) => return Err("dependency `" + name + "` key `" + k + "`: " + e)
          }
          if k == "path" {
            path = uv
          } else if k == "git" {
            git = uv
          } else if k == "tag" {
            tag = uv
          } else if k == "rev" {
            rev = uv
          } else if k == "branch" {
            branch = uv
          } else if k == "registry" {
            registry = uv
          } else if k == "version" {
            version = uv
          } else {
            subdir = uv
          }
        }
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  if git.length() > 0 {
    if path.length() > 0 {
      return Err("dependency `" + name + "` sets both `path` and `git`")
    }
    let mut nrefs = 0
    if tag.length() > 0 {
      nrefs = nrefs + 1
    }
    if rev.length() > 0 {
      nrefs = nrefs + 1
    }
    if branch.length() > 0 {
      nrefs = nrefs + 1
    }
    if nrefs > 1 {
      return Err(
        "dependency `" + name + "` sets more than one of `tag`, `rev`, `branch`",
      )
    }
  } else {
    if path.length() == 0 {
      return Err(
        "missing `path = \"...\"` or `git = \"...\"` in dependency table `" +
        s +
        "`",
      )
    }
    if tag.length() > 0 ||
      rev.length() > 0 ||
      branch.length() > 0 ||
      subdir.length() > 0 ||
      registry.length() > 0 {
      return Err(
        "dependency `" + name + "`: `tag`/`rev`/`branch`/`subdir`/`registry` require `git = \"...\"`",
      )
    }
  }
  Ok(ManifestDep::{
    name: name,
    path: path,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
    registry: registry,
    version: version,
  })
}

///|
/// Parses a TOML string array `["a", "b"]` (or a single quoted string).
fn toml_parse_str_array(rhs : String) -> Result[Array[String], String] {
  let s = toml_trim(rhs)
  let out : Array[String] = []
  if s.length() >= 2 && str_code_at(s, 0) == 34 {
    match toml_unquote(s) {
      Ok(v) => out.push(v)
      Err(e) => return Err(e)
    }
    return Ok(out)
  }
  if s.length() < 2 ||
    str_code_at(s, 0) != 91 ||
    str_code_at(s, s.length() - 1) != 93 {
    return Err("expected `[\"...\", ...]`, found `" + s + "`")
  }
  let inner = slice_str(s, 1, s.length() - 1)
  let ilen = inner.length()
  let mut pos = 0
  while pos < ilen {
    let comma = toml_find_char(inner, 44, pos)
    let end_p = if comma < 0 { ilen } else { comma }
    let entry = toml_trim(slice_str(inner, pos, end_p))
    if entry.length() > 0 {
      match toml_unquote(entry) {
        Ok(v) => out.push(v)
        Err(e) => return Err(e)
      }
    }
    if comma < 0 {
      break
    }
    pos = comma + 1
  }
  Ok(out)
}

///|
/// Appends `lib` to `libs` unless already present (keeps first-seen order).
pub fn push_unique_lib(libs : Array[String], lib : String) -> Unit {
  if lib.length() == 0 {
    return
  }
  let mut i = 0
  while i < libs.length() {
    if libs[i] == lib {
      return
    }
    i = i + 1
  }
  libs.push(lib)
}

///|
fn push_nonempty_str(arr : Array[String], s : String) -> Unit {
  if s.length() > 0 {
    arr.push(s)
  }
}

///|
fn toml_apply_link_key(
  spec : LinkSpec,
  section : String,
  key : String,
  raw_val : String,
) -> Result[Unit, String] {
  let mut kind = 0
  if key == "libs" || key == "lib" {
    kind = 1
  } else if key == "frameworks" || key == "framework" {
    kind = 2
  } else if key == "search_paths" || key == "search_path" {
    kind = 3
  } else if key == "rpaths" || key == "rpath" {
    kind = 4
  } else if key == "objects" || key == "object" {
    kind = 5
  } else if key == "flags" {
    kind = 6
  } else if key == "c_sources" || key == "c_source" {
    kind = 7
  } else if key == "cc_flags" {
    kind = 8
  } else {
    return Err("unknown key `" + key + "` in [" + section + "]")
  }
  let vs = match toml_parse_str_array(raw_val) {
    Ok(x) => x
    Err(e) => return Err(e)
  }
  let mut vi = 0
  while vi < vs.length() {
    let v = vs[vi]
    if kind == 1 {
      push_unique_lib(spec.libs, v)
    } else if kind == 2 {
      push_unique_lib(spec.frameworks, v)
    } else if kind == 3 {
      push_unique_lib(spec.search_paths, v)
    } else if kind == 4 {
      push_unique_lib(spec.rpaths, v)
    } else if kind == 5 {
      push_unique_lib(spec.objects, v)
    } else if kind == 6 {
      push_nonempty_str(spec.flags, v)
    } else if kind == 7 {
      push_unique_lib(spec.c_sources, v)
    } else {
      push_nonempty_str(spec.cc_flags, v)
    }
    vi = vi + 1
  }
  Ok(())
}

///|
pub fn parse_pion_toml(text : String) -> Result[PackageManifest, String] {
  let lines = split_lines(text)
  let mut section = ""
  let mut pkg_name = ""
  let mut version = "0.1.0"
  let deps : Array[ManifestDep] = []
  let link_common = link_spec_empty()
  let link_macos = link_spec_empty()
  let link_linux = link_spec_empty()
  let link_ios = link_spec_empty()
  let link_android = link_spec_empty()
  let mut registry = ""
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() == 0 {
      i = i + 1
      continue
    }
    if str_code_at(clean, 0) == 91 &&
      str_code_at(clean, clean.length() - 1) == 93 {
      section = toml_trim(slice_str(clean, 1, clean.length() - 1))
      i = i + 1
      continue
    }
    let start_line = i + 1
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err(
        "pion.toml line " + start_line.to_string() + ": expected `key = value`",
      )
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let mut raw_val = toml_trim(slice_str(clean, eq + 1, clean.length()))
    if raw_val.length() > 0 &&
      str_code_at(raw_val, 0) == 91 &&
      toml_find_char(raw_val, 93, 0) < 0 {
      let sb = StringBuilder()
      sb.write_string(raw_val)
      let mut closed = false
      while i + 1 < lines.length() {
        i = i + 1
        let cont = toml_trim(toml_strip_comment(lines[i]))
        if cont.length() == 0 {
          continue
        }
        sb.write_char(' ')
        sb.write_string(cont)
        if toml_find_char(cont, 93, 0) >= 0 {
          closed = true
          break
        }
      }
      if !closed {
        return Err(
          "pion.toml line " + start_line.to_string() + ": unclosed array `[`",
        )
      }
      raw_val = sb.to_string()
    }
    if section == "package" {
      if key == "name" {
        match toml_unquote(raw_val) {
          Ok(v) => pkg_name = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      } else if key == "version" {
        match toml_unquote(raw_val) {
          Ok(v) => version = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      }
    } else if section == "dependencies" {
      match toml_parse_dep(key, raw_val) {
        Ok(d) => deps.push(d)
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "registry" {
      if key == "url" {
        match toml_unquote(raw_val) {
          Ok(v) => registry = v
          Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
        }
      }
    } else if section == "link" {
      match toml_apply_link_key(link_common, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.macos" {
      match toml_apply_link_key(link_macos, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.linux" {
      match toml_apply_link_key(link_linux, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.ios" {
      match toml_apply_link_key(link_ios, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    } else if section == "link.android" {
      match toml_apply_link_key(link_android, section, key, raw_val) {
        Ok(_) => ()
        Err(e) => return Err("pion.toml line " + start_line.to_string() + ": " + e)
      }
    }
    i = i + 1
  }
  if pkg_name.length() == 0 {
    return Err("pion.toml: missing `[package]` `name = \"...\"`")
  }
  Ok(PackageManifest::{
    name: pkg_name,
    version: version,
    deps: deps,
    link_libs: link_common.libs,
    link_common: link_common,
    link_macos: link_macos,
    link_linux: link_linux,
    link_ios: link_ios,
    link_android: link_android,
    registry: registry,
  })
}

///|
fn topo_dfs(
  idx : Int,
  names : Array[String],
  deps : Array[Array[String]],
  name_to_idx : Map[String, Int],
  color : Array[Int],
  stack : Array[String],
  order : Array[Int],
  diags : Array[Diagnostic],
) -> Unit {
  color[idx] = 1
  stack.push(names[idx])
  let cur_deps = deps[idx]
  let mut i = 0
  while i < cur_deps.length() {
    let dep_name = cur_deps[i]
    match name_to_idx.get(dep_name) {
      None =>
        diags.push(
          diag_new(
            span_new(names[idx] + "/pion.toml", 1, 1),
            "E_UNKNOWN_PACKAGE",
            "unknown dependency package `" + dep_name + "` required by `" + names[idx] + "`",
            "defined package in [dependencies]",
            dep_name,
            "add `" + dep_name + " = { path = \"...\" }` to `pion.toml`",
          ),
        )
      Some(didx) =>
        if color[didx] == 1 {
          let sb = StringBuilder()
          let mut k = 0
          let mut started = false
          while k < stack.length() {
            if stack[k] == dep_name {
              started = true
            }
            if started {
              sb.write_string(stack[k])
              sb.write_string(" -> ")
            }
            k = k + 1
          }
          sb.write_string(dep_name)
          let cycle_str = sb.to_string()
          diags.push(
            diag_new(
              span_new(names[idx] + "/pion.toml", 1, 1),
              "E_IMPORT_CYCLE",
              "cyclic package dependency detected: " + cycle_str,
              "acyclic package dependency graph",
              cycle_str,
              "break the dependency cycle involving `" + dep_name + "`",
            ),
          )
        } else if color[didx] == 0 {
          topo_dfs(didx, names, deps, name_to_idx, color, stack, order, diags)
        }
    }
    i = i + 1
  }
  let _ = stack.pop()
  color[idx] = 2
  order.push(idx)
}

///|
pub fn topo_sort_packages(
  pkg_names : Array[String],
  pkg_deps : Array[Array[String]],
) -> TopoSortResult {
  let n = pkg_names.length()
  let name_to_idx : Map[String, Int] = Map([])
  let color : Array[Int] = []
  let mut i = 0
  while i < n {
    name_to_idx.set(pkg_names[i], i)
    color.push(0)
    i = i + 1
  }
  let order : Array[Int] = []
  let diags : Array[Diagnostic] = []
  let stack : Array[String] = []
  i = 0
  while i < n {
    if color[i] == 0 {
      topo_dfs(i, pkg_names, pkg_deps, name_to_idx, color, stack, order, diags)
    }
    i = i + 1
  }
  TopoSortResult::{ order: order, diagnostics: diags }
}

///|
pub fn query_workspace_deps_json(
  pkg_names : Array[String],
  pkg_deps : Array[Array[String]],
  sig_hashes : Array[String],
) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"packages\":[")
  let mut i = 0
  while i < pkg_names.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(pkg_names[i]))
    sb.write_string(",\"deps\":[")
    let ds = pkg_deps[i]
    let mut j = 0
    while j < ds.length() {
      if j > 0 {
        sb.write_string(",")
      }
      sb.write_string(json_quote(ds[j]))
      j = j + 1
    }
    sb.write_string("],\"sig_hash\":")
    let h = if i < sig_hashes.length() { sig_hashes[i] } else { "" }
    sb.write_string(json_quote(h))
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// One `[[package]]` entry of `pion.lock`: a git dependency pinned to a full
/// commit `rev`. `reference` is the requested ref (`manifest_dep_ref`), so a
/// lock entry is reused only while `pion.toml` still asks for the same thing.
pub struct LockEntry {
  name : String
  git : String
  reference : String
  rev : String
  subdir : String
}

///|
pub fn lock_entry_new(
  name : String,
  git : String,
  reference : String,
  rev : String,
  subdir : String,
) -> LockEntry {
  LockEntry::{
    name: name,
    git: git,
    reference: reference,
    rev: rev,
    subdir: subdir,
  }
}

///|
fn lock_entry_sort_key(e : LockEntry) -> String {
  e.name + "\n" + e.git + "\n" + e.subdir + "\n" + e.reference + "\n" + e.rev
}

///|
/// Plain code-unit lexicographic order (independent of the host `String` compare).
fn lock_str_less(a : String, b : String) -> Bool {
  let n = if a.length() < b.length() { a.length() } else { b.length() }
  let mut i = 0
  while i < n {
    let ca = str_code_at(a, i)
    let cb = str_code_at(b, i)
    if ca != cb {
      return ca < cb
    }
    i = i + 1
  }
  a.length() < b.length()
}

///|
/// Parses `pion.lock` (`[[package]]` tables of `name`/`git`/`ref`/`rev`/`subdir`).
pub fn parse_pion_lock(text : String) -> Result[Array[LockEntry], String] {
  let lines = split_lines(text)
  let out : Array[LockEntry] = []
  let mut in_pkg = false
  let mut name = ""
  let mut git = ""
  let mut reference = ""
  let mut rev = ""
  let mut subdir = ""
  let mut start_line = 0
  let mut i = 0
  while i <= lines.length() {
    let at_end = i == lines.length()
    let clean = if at_end { "" } else { toml_trim(toml_strip_comment(lines[i])) }
    let is_header = !at_end && clean == "[[package]]"
    if at_end || is_header {
      if in_pkg {
        if name.length() == 0 || git.length() == 0 || rev.length() == 0 {
          return Err(
            "pion.lock line " +
            start_line.to_string() +
            ": [[package]] needs `name`, `git` and `rev`",
          )
        }
        out.push(lock_entry_new(name, git, reference, rev, subdir))
      }
      if is_header {
        in_pkg = true
        name = ""
        git = ""
        reference = ""
        rev = ""
        subdir = ""
        start_line = i + 1
      }
      i = i + 1
      continue
    }
    if clean.length() == 0 {
      i = i + 1
      continue
    }
    if str_code_at(clean, 0) == 91 {
      return Err(
        "pion.lock line " + (i + 1).to_string() + ": unexpected table `" + clean + "`",
      )
    }
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err("pion.lock line " + (i + 1).to_string() + ": expected `key = value`")
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let raw_val = toml_trim(slice_str(clean, eq + 1, clean.length()))
    if in_pkg {
      let v = match toml_unquote(raw_val) {
        Ok(x) => x
        Err(e) => return Err("pion.lock line " + (i + 1).to_string() + ": " + e)
      }
      if key == "name" {
        name = v
      } else if key == "git" {
        git = v
      } else if key == "ref" {
        reference = v
      } else if key == "rev" {
        rev = v
      } else if key == "subdir" {
        subdir = v
      }
    }
    i = i + 1
  }
  Ok(out)
}

///|
/// Deterministic `pion.lock` text: entries sorted by name/git/subdir, one
/// `[[package]]` table each, with every key always written.
pub fn format_pion_lock(entries : Array[LockEntry]) -> String {
  let sorted : Array[LockEntry] = []
  let mut i = 0
  while i < entries.length() {
    sorted.push(entries[i])
    i = i + 1
  }
  i = 1
  while i < sorted.length() {
    let cur = sorted[i]
    let ck = lock_entry_sort_key(cur)
    let mut j = i - 1
    while j >= 0 && lock_str_less(ck, lock_entry_sort_key(sorted[j])) {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = cur
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("# pion.lock: generated by pionc; do not edit by hand.\n")
  sb.write_string("version = 1\n")
  i = 0
  while i < sorted.length() {
    let e = sorted[i]
    sb.write_string("\n[[package]]\nname = ")
    sb.write_string(json_quote(e.name))
    sb.write_string("\ngit = ")
    sb.write_string(json_quote(e.git))
    sb.write_string("\nref = ")
    sb.write_string(json_quote(e.reference))
    sb.write_string("\nrev = ")
    sb.write_string(json_quote(e.rev))
    sb.write_string("\nsubdir = ")
    sb.write_string(json_quote(e.subdir))
    sb.write_string("\n")
    i = i + 1
  }
  sb.to_string()
}

///|
/// The locked entry for `dep`, if `pion.lock` pins the same name, URL, subdir
/// and requested ref.
pub fn lock_find(entries : Array[LockEntry], dep : ManifestDep) -> Option[LockEntry] {
  let want_ref = manifest_dep_ref(dep)
  let mut i = 0
  while i < entries.length() {
    let e = entries[i]
    if e.name == dep.name &&
      e.git == dep.git &&
      e.subdir == dep.subdir &&
      e.reference == want_ref {
      return Some(e)
    }
    i = i + 1
  }
  None
}

///|
/// Adds `e` to `entries` (keyed by name/git/subdir). Fails when the same
/// dependency was already resolved to a different revision.
pub fn lock_add(entries : Array[LockEntry], e : LockEntry) -> Result[Unit, String] {
  let mut i = 0
  while i < entries.length() {
    let o = entries[i]
    if o.name == e.name && o.git == e.git && o.subdir == e.subdir {
      if o.rev != e.rev || o.reference != e.reference {
        return Err(
          "git dependency `" +
          e.name +
          "` is required as both " +
          o.reference +
          " (" +
          o.rev +
          ") and " +
          e.reference +
          " (" +
          e.rev +
          ")",
        )
      }
      return Ok(())
    }
    i = i + 1
  }
  entries.push(e)
  Ok(())
}

///|
/// Merged `pionc test --json` report over several packages. Keeps the
/// single-package keys (`ok`, `passed`, `failed`, `tests`) and adds `total`,
/// `packages` and a `pkg` on every test.
pub fn format_workspace_test_report_json(
  packages : Array[String],
  test_pkgs : Array[String],
  names : Array[String],
  passed_flags : Array[Bool],
) -> String {
  let mut passed = 0
  let mut failed = 0
  let mut i = 0
  while i < names.length() && i < passed_flags.length() {
    if passed_flags[i] {
      passed = passed + 1
    } else {
      failed = failed + 1
    }
    i = i + 1
  }
  let sb = StringBuilder()
  sb.write_string("{\"ok\":")
  sb.write_string(if failed == 0 { "true" } else { "false" })
  sb.write_string(",\"total\":")
  sb.write_string((passed + failed).to_string())
  sb.write_string(",\"passed\":")
  sb.write_string(passed.to_string())
  sb.write_string(",\"failed\":")
  sb.write_string(failed.to_string())
  sb.write_string(",\"packages\":[")
  i = 0
  while i < packages.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string(json_quote(packages[i]))
    i = i + 1
  }
  sb.write_string("],\"tests\":[")
  i = 0
  while i < names.length() && i < passed_flags.length() {
    if i > 0 {
      sb.write_string(",")
    }
    sb.write_string("{\"pkg\":")
    sb.write_string(json_quote(if i < test_pkgs.length() { test_pkgs[i] } else { "" }))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(names[i]))
    sb.write_string(",\"ok\":")
    sb.write_string(if passed_flags[i] { "true" } else { "false" })
    sb.write_string("}")
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// Package name for `pionc init <dir>`: the last path component, lowercased,
/// with every character outside `[a-z0-9_]` turned into `_`.
pub fn init_package_name(dir : String) -> String {
  let mut end = dir.length()
  while end > 1 && str_code_at(dir, end - 1) == 47 {
    end = end - 1
  }
  let mut start = end - 1
  while start >= 0 && str_code_at(dir, start) != 47 {
    start = start - 1
  }
  let sb = StringBuilder()
  let mut i = start + 1
  while i < end {
    let c = str_code_at(dir, i)
    if c >= 65 && c <= 90 {
      sb.write_char((c + 32).unsafe_to_char())
    } else if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      sb.write_char(c.unsafe_to_char())
    } else {
      sb.write_char('_')
    }
    i = i + 1
  }
  let raw = sb.to_string()
  if raw.length() == 0 || raw == "_" || raw == "__" {
    "app"
  } else if str_code_at(raw, 0) >= 48 && str_code_at(raw, 0) <= 57 {
    "pkg_" + raw
  } else {
    raw
  }
}

///|
pub fn init_pion_toml(name : String) -> String {
  "[package]\nname = " +
  json_quote(name) +
  "\nversion = \"0.1.0\"\n\n[dependencies]\n"
}

///|
pub fn init_main_source(name : String) -> String {
  "///| " +
  name +
  ": generated by `pionc init`.\n\n" +
  "///|\npub fn greet(who : String) -> String {\n  \"Hello, \" + who + \"!\"\n}\n\n" +
  "///|\npub fn main(world : World) -> Int {\n  io_println(world, greet(" +
  json_quote(name) +
  "))\n  0\n}\n"
}

///|
pub fn init_test_source(name : String) -> String {
  "///| " +
  name +
  " tests.\n\n" +
  "///|\ntest \"greet\" {\n  debug_assert(greet(\"pion\") == \"Hello, pion!\", \"greet\")\n}\n"
}

///|
/// One `index/<name>.toml` entry of a git-index package registry: where the
/// package's source lives (`git` + at most one of `tag` / `rev` / `branch`,
/// optional monorepo `subdir`) and its published `version`.
pub struct RegistryEntry {
  name : String
  version : String
  git : String
  tag : String
  rev : String
  branch : String
  subdir : String
}

///|
/// Path of a package's entry inside a registry index repository.
pub fn registry_index_path(name : String) -> String {
  "index/" + name + ".toml"
}

///|
/// A dependency / registry package name usable as a bare `pion.toml` key:
/// `[A-Za-z_][A-Za-z0-9_-]*`.
pub fn manifest_valid_dep_name(name : String) -> Bool {
  if name.length() == 0 {
    return false
  }
  let mut i = 0
  while i < name.length() {
    let c = str_code_at(name, i)
    let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    let digit = c >= 48 && c <= 57
    if i == 0 && !alpha {
      return false
    }
    if !alpha && !digit && c != 45 {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// Parses a registry index entry (`git = "..."`, `tag`/`rev`/`branch`,
/// `subdir`, `version`, optional `name` that must match).
pub fn parse_registry_entry(
  name : String,
  text : String,
) -> Result[RegistryEntry, String] {
  let lines = split_lines(text)
  let mut git = ""
  let mut tag = ""
  let mut rev = ""
  let mut branch = ""
  let mut subdir = ""
  let mut version = ""
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() == 0 || str_code_at(clean, 0) == 91 {
      i = i + 1
      continue
    }
    let eq = toml_find_char(clean, 61, 0)
    if eq <= 0 {
      return Err(
        registry_index_path(name) +
        " line " +
        (i + 1).to_string() +
        ": expected `key = value`",
      )
    }
    let key = toml_trim(slice_str(clean, 0, eq))
    let v = match toml_unquote(slice_str(clean, eq + 1, clean.length())) {
      Ok(x) => x
      Err(e) =>
        return Err(
          registry_index_path(name) + " line " + (i + 1).to_string() + ": " + e,
        )
    }
    if key == "git" {
      git = v
    } else if key == "tag" {
      tag = v
    } else if key == "rev" {
      rev = v
    } else if key == "branch" {
      branch = v
    } else if key == "subdir" {
      subdir = v
    } else if key == "version" {
      version = v
    } else if key == "name" && v != name {
      return Err(
        registry_index_path(name) + ": entry is for package `" + v + "`",
      )
    }
    i = i + 1
  }
  if git.length() == 0 {
    return Err(registry_index_path(name) + ": missing `git = \"...\"`")
  }
  let mut nrefs = 0
  if tag.length() > 0 {
    nrefs = nrefs + 1
  }
  if rev.length() > 0 {
    nrefs = nrefs + 1
  }
  if branch.length() > 0 {
    nrefs = nrefs + 1
  }
  if nrefs > 1 {
    return Err(
      registry_index_path(name) + ": more than one of `tag`, `rev`, `branch`",
    )
  }
  Ok(RegistryEntry::{
    name: name,
    version: version,
    git: git,
    tag: tag,
    rev: rev,
    branch: branch,
    subdir: subdir,
  })
}

///|
/// The `pion.toml` dependency for a registry entry, remembering `registry`.
pub fn registry_entry_dep(e : RegistryEntry, registry : String) -> ManifestDep {
  ManifestDep::{
    name: e.name,
    path: "",
    git: e.git,
    tag: e.tag,
    rev: e.rev,
    branch: e.branch,
    subdir: e.subdir,
    registry: registry,
    version: e.version,
  }
}

///|
/// Inline-table form of a dependency, with keys in a fixed order:
/// `{ path = "..." }` or `{ git = "...", tag = "...", subdir = "...",
/// version = "...", registry = "..." }` (empty keys left out).
pub fn format_dep_inline(dep : ManifestDep) -> String {
  if dep.git.length() == 0 {
    return "{ path = " + json_quote(dep.path) + " }"
  }
  let sb = StringBuilder()
  sb.write_string("{ git = ")
  sb.write_string(json_quote(dep.git))
  if dep.tag.length() > 0 {
    sb.write_string(", tag = ")
    sb.write_string(json_quote(dep.tag))
  }
  if dep.rev.length() > 0 {
    sb.write_string(", rev = ")
    sb.write_string(json_quote(dep.rev))
  }
  if dep.branch.length() > 0 {
    sb.write_string(", branch = ")
    sb.write_string(json_quote(dep.branch))
  }
  if dep.subdir.length() > 0 {
    sb.write_string(", subdir = ")
    sb.write_string(json_quote(dep.subdir))
  }
  if dep.version.length() > 0 {
    sb.write_string(", version = ")
    sb.write_string(json_quote(dep.version))
  }
  if dep.registry.length() > 0 {
    sb.write_string(", registry = ")
    sb.write_string(json_quote(dep.registry))
  }
  sb.write_string(" }")
  sb.to_string()
}

///|
/// Splits at every newline, keeping a trailing empty segment ("a\n" -> ["a", ""]).
fn toml_split_keep(text : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut i = 0
  while i < text.length() {
    if str_code_at(text, i) == 10 {
      out.push(slice_str(text, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(text, start, text.length()))
  out
}

///|
/// Sets `dep` in the `[dependencies]` table of a `pion.toml` text: replaces
/// the line of an existing entry with the same name in place, else appends it
/// after the table's last entry (creating the table at the end when missing).
/// Every other line is kept byte for byte, and setting the same dependency
/// again returns the text unchanged.
pub fn manifest_set_dependency(text : String, dep : ManifestDep) -> String {
  let line = dep.name + " = " + format_dep_inline(dep)
  let lines = toml_split_keep(text)
  let mut section = ""
  let mut dep_header = -1
  let mut last_entry = -1
  let mut i = 0
  while i < lines.length() {
    let clean = toml_trim(toml_strip_comment(lines[i]))
    if clean.length() > 0 {
      if str_code_at(clean, 0) == 91 &&
        str_code_at(clean, clean.length() - 1) == 93 {
        section = toml_trim(slice_str(clean, 1, clean.length() - 1))
        if section == "dependencies" && dep_header < 0 {
          dep_header = i
        }
      } else if section == "dependencies" {
        let eq = toml_find_char(clean, 61, 0)
        if eq > 0 && toml_trim(slice_str(clean, 0, eq)) == dep.name {
          lines[i] = line
          return join_lines_nl(lines)
        }
        last_entry = i
      }
    }
    i = i + 1
  }
  if dep_header >= 0 {
    let at = if last_entry > dep_header { last_entry + 1 } else { dep_header + 1 }
    let out : Array[String] = []
    let mut j = 0
    while j < lines.length() {
      if j == at {
        out.push(line)
      }
      out.push(lines[j])
      j = j + 1
    }
    if at >= lines.length() {
      out.push(line)
    }
    return join_lines_nl(out)
  }
  let sb = StringBuilder()
  sb.write_string(text)
  if text.length() > 0 && str_code_at(text, text.length() - 1) != 10 {
    sb.write_string("\n")
  }
  if text.length() > 0 {
    sb.write_string("\n")
  }
  sb.write_string("[dependencies]\n")
  sb.write_string(line)
  sb.write_string("\n")
  sb.to_string()
}

///|
fn join_lines_nl(lines : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    if i > 0 {
      sb.write_string("\n")
    }
    sb.write_string(lines[i])
    i = i + 1
  }
  sb.to_string()
}

///|
/// The locked commit of the git dependency `name` ("" when not locked).
pub fn lock_rev_of(entries : Array[LockEntry], name : String) -> String {
  let mut i = 0
  while i < entries.length() {
    if entries[i].name == name {
      return entries[i].rev
    }
    i = i + 1
  }
  ""
}
