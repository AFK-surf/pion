///|
extern "C" fn diag_c_fopen(path : Ptr, mode : Ptr) -> Ptr = "fopen"

///|
extern "C" fn diag_c_fseek(fp : Ptr, off : Int64, whence : Int) -> Int = "fseek"

///|
extern "C" fn diag_c_ftell(fp : Ptr) -> Int64 = "ftell"

///|
extern "C" fn diag_c_fread(buf : Ptr, sz : Int64, n : Int64, fp : Ptr) -> Int64 = "fread"

///|
extern "C" fn diag_c_fclose(fp : Ptr) -> Int = "fclose"

///|
extern "C" fn diag_c_calloc(n : Int64, sz : Int64) -> Ptr = "calloc"

///|
extern "C" fn diag_c_free(p : Ptr) -> Unit = "free"

///|
fn diag_doc_try_read(path : String) -> String {
  let fp = diag_c_fopen(path.as_cstr(), "rb".as_cstr())
  if fp == ptr_null() {
    return ""
  }
  let _ = diag_c_fseek(fp, 0L, 2)
  let sz = diag_c_ftell(fp)
  let _ = diag_c_fseek(fp, 0L, 0)
  if sz <= 0L {
    let _ = diag_c_fclose(fp)
    return ""
  }
  let buf = diag_c_calloc(sz + 1L, 1L)
  if buf == ptr_null() {
    let _ = diag_c_fclose(fp)
    return ""
  }
  let _ = diag_c_fread(buf, 1L, sz, fp)
  let _ = diag_c_fclose(fp)
  let out = cstr_to_str(buf)
  diag_c_free(buf)
  out
}

///|
fn diag_doc_read_file() -> String {
  let candidates = [
    "docs/diagnostics.md",
    "../docs/diagnostics.md",
    "../../docs/diagnostics.md",
    "../../../docs/diagnostics.md",
  ]
  let mut i = 0
  while i < candidates.length() {
    let text = diag_doc_try_read(candidates[i])
    if text.length() > 0 {
      return text
    }
    i = i + 1
  }
  abort("could not locate docs/diagnostics.md from current working directory")
  ""
}

///|
fn diag_doc_starts_with(s : String, prefix : String) -> Bool {
  if s.length() < prefix.length() {
    return false
  }
  let mut i = 0
  while i < prefix.length() {
    if str_code_at(s, i) != str_code_at(prefix, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn diag_doc_trim(s : String) -> String {
  let len = s.length()
  let mut a = 0
  while a < len {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = len
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  t_str_slice(s, a, b)
}

///|
fn diag_doc_split_lines(src : String) -> Array[String] {
  let out : Array[String] = []
  let len = src.length()
  let mut start = 0
  let mut i = 0
  while i < len {
    if str_code_at(src, i) == 10 {
      let end = if i > start && str_code_at(src, i - 1) == 13 { i - 1 } else { i }
      out.push(t_str_slice(src, start, end))
      start = i + 1
    }
    i = i + 1
  }
  if start <= len {
    let end = if len > start && str_code_at(src, len - 1) == 13 { len - 1 } else { len }
    out.push(t_str_slice(src, start, end))
  }
  out
}

///|
struct DiagDocSnippet {
  code : String
  kind : String // "before" | "after"
  src : String
  line : Int
}

///|
fn diag_doc_parse_snippets(md : String) -> Array[DiagDocSnippet] {
  let lines = diag_doc_split_lines(md)
  let out : Array[DiagDocSnippet] = []
  let mut cur_code = ""
  let mut in_fence = false
  let mut fence_kind = ""
  let mut fence_line = 0
  let mut buf = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    let raw_line = lines[i]
    let trimmed = diag_doc_trim(raw_line)
    if !in_fence {
      if diag_doc_starts_with(trimmed, "### ") {
        let heading = diag_doc_trim(t_str_from(trimmed, 4))
        if diag_doc_starts_with(heading, "E_") || diag_doc_starts_with(heading, "L_") {
          cur_code = heading
        } else {
          cur_code = ""
        }
      } else if cur_code != "" && trimmed == "```pion before" {
        in_fence = true
        fence_kind = "before"
        fence_line = i + 1
        buf = StringBuilder()
      } else if cur_code != "" && trimmed == "```pion after" {
        in_fence = true
        fence_kind = "after"
        fence_line = i + 1
        buf = StringBuilder()
      }
    } else if trimmed == "```" {
      out.push(DiagDocSnippet::{
        code: cur_code,
        kind: fence_kind,
        src: buf.to_string(),
        line: fence_line,
      })
      in_fence = false
      fence_kind = ""
    } else {
      buf.write_string(raw_line)
      buf.write_char('\n')
    }
    i = i + 1
  }
  out
}

///|
fn diag_doc_parse_int(s : String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < s.length() {
    let c = str_code_at(s, i)
    if c >= 48 && c <= 57 {
      n = n * 10 + (c - 48)
    }
    i = i + 1
  }
  n
}

///|
fn diag_doc_expand_directives(src : String) -> String {
  let lines = diag_doc_split_lines(src)
  let sb = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    let trimmed = diag_doc_trim(lines[i])
    if diag_doc_starts_with(trimmed, "// @pad_lines ") {
      let count = diag_doc_parse_int(diag_doc_trim(t_str_from(trimmed, 14)))
      let mut k = 0
      while k < count {
        sb.write_string("// pad\n")
        k = k + 1
      }
    } else {
      sb.write_string(lines[i])
      sb.write_char('\n')
    }
    i = i + 1
  }
  sb.to_string()
}

///|
struct DiagDocPkgFiles {
  paths : Array[String]
  sources : Array[String]
}

///|
fn diag_doc_split_files(pkg_name : String, src : String) -> DiagDocPkgFiles {
  let lines = diag_doc_split_lines(src)
  let paths : Array[String] = []
  let sources : Array[String] = []
  let mut cur_file = ""
  let mut cur_buf = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    let trimmed = diag_doc_trim(lines[i])
    if diag_doc_starts_with(trimmed, "// @file ") {
      if cur_file != "" {
        paths.push(cur_file)
        sources.push(diag_doc_expand_directives(cur_buf.to_string()))
      }
      cur_file = diag_doc_trim(t_str_from(trimmed, 9))
      cur_buf = StringBuilder()
    } else {
      cur_buf.write_string(lines[i])
      cur_buf.write_char('\n')
    }
    i = i + 1
  }
  if cur_file == "" {
    paths.push(pkg_name + ".pion")
    sources.push(diag_doc_expand_directives(src))
  } else {
    paths.push(cur_file)
    sources.push(diag_doc_expand_directives(cur_buf.to_string()))
  }
  DiagDocPkgFiles::{ paths: paths, sources: sources }
}

///|
/// Checks a snippet from `docs/diagnostics.md`. Supports multi-package snippets
/// delimited by `// @pkg <name>` lines, multi-file packages delimited by
/// `// @file <name>`, and `// @pad_lines <N>` expansion. For `L_*` codes, runs
/// `lint_source_files_with_imports` after type-checking.
fn diag_doc_check_snippet(code : String, src : String) -> Array[Diagnostic] {
  let is_lint = diag_doc_starts_with(code, "L_")
  let lines = diag_doc_split_lines(src)
  let pkg_names : Array[String] = []
  let pkg_srcs : Array[String] = []
  let mut cur_name = ""
  let mut cur_buf = StringBuilder()
  let mut i = 0
  while i < lines.length() {
    let trimmed = diag_doc_trim(lines[i])
    if diag_doc_starts_with(trimmed, "// @pkg ") {
      if cur_name != "" {
        pkg_names.push(cur_name)
        pkg_srcs.push(cur_buf.to_string())
      }
      cur_name = diag_doc_trim(t_str_from(trimmed, 8))
      cur_buf = StringBuilder()
    } else {
      cur_buf.write_string(lines[i])
      cur_buf.write_char('\n')
    }
    i = i + 1
  }
  if cur_name == "" {
    let pf = diag_doc_split_files("doc", src)
    if is_lint {
      return lint_source_files_with_imports("docpkg", pf.paths, pf.sources, [], false)
    }
    let cr = check_source_files("docpkg", pf.paths, pf.sources)
    return cr.diagnostics
  }
  pkg_names.push(cur_name)
  pkg_srcs.push(cur_buf.to_string())
  let imported : Array[ImportedPkg] = []
  let mut pi = 0
  while pi < pkg_names.length() - 1 {
    let pf = diag_doc_split_files(pkg_names[pi], pkg_srcs[pi])
    let dep_cr = check_source_files_with_imports(
      pkg_names[pi],
      pf.paths,
      pf.sources,
      imported,
      true,
    )
    if dep_cr.diagnostics.length() > 0 {
      return dep_cr.diagnostics
    }
    imported.push(imported_pkg_new(pkg_names[pi], dep_cr.tc))
    pi = pi + 1
  }
  let last = pkg_names.length() - 1
  let last_pf = diag_doc_split_files(pkg_names[last], pkg_srcs[last])
  if is_lint {
    return lint_source_files_with_imports(
      pkg_names[last],
      last_pf.paths,
      last_pf.sources,
      imported,
      true,
    )
  }
  let final_cr = check_source_files_with_imports(
    pkg_names[last],
    last_pf.paths,
    last_pf.sources,
    imported,
    true,
  )
  final_cr.diagnostics
}

///|
/// Verifies all snippets parsed from a diagnostics markdown document.
/// Returns "" on success, or a failure description on mismatch.
fn diag_doc_verify_markdown(md : String) -> String {
  let snippets = diag_doc_parse_snippets(md)
  if snippets.length() == 0 {
    return "no pion before/after snippets found"
  }
  let mut before_count = 0
  let mut after_count = 0
  let mut i = 0
  while i < snippets.length() {
    let sn = snippets[i]
    let diags = diag_doc_check_snippet(sn.code, sn.src)
    if sn.kind == "before" {
      before_count = before_count + 1
      let mut hit = false
      let mut j = 0
      while j < diags.length() {
        if diags[j].code == sn.code {
          hit = true
          break
        }
        j = j + 1
      }
      if !hit {
        return "FAIL docs/diagnostics.md:" +
          sn.line.to_string() +
          " (" +
          sn.code +
          " before): expected diagnostic `" +
          sn.code +
          "`, got " +
          check_result_to_json(diags)
      }
    } else {
      after_count = after_count + 1
      if diags.length() != 0 {
        return "FAIL docs/diagnostics.md:" +
          sn.line.to_string() +
          " (" +
          sn.code +
          " after): expected 0 diagnostics, got " +
          check_result_to_json(diags)
      }
    }
    i = i + 1
  }
  if before_count == 0 || after_count == 0 || before_count != after_count {
    return "mismatched before/after snippet counts: before=" +
      before_count.to_string() +
      " after=" +
      after_count.to_string()
  }
  ""
}

///|
test "docs/diagnostics.md: every before triggers its E_CODE and every after checks clean" {
  let md = diag_doc_read_file()
  let snippets = diag_doc_parse_snippets(md)
  // Expect at least 33 pairs (66 blocks): 18 core + 8 habit + 7 lint diagnostics.
  assert_true(
    snippets.length() >= 66,
    "expected at least 66 fenced snippets in docs/diagnostics.md, found " +
    snippets.length().to_string(),
  )
  let err = diag_doc_verify_markdown(md)
  assert_true(err == "", err)
}

///|
test "docs/diagnostics.md: negative gate catches wrong before and broken after" {
  let bad_before =
    "### E_TYPE_MISMATCH\n" +
    "```pion before\n" +
    "pub fn ok(x : Int) -> Int { x + 1 }\n" +
    "```\n" +
    "```pion after\n" +
    "pub fn ok(x : Int) -> Int { x + 1 }\n" +
    "```\n"
  let err1 = diag_doc_verify_markdown(bad_before)
  assert_true(
    str_contains(err1, "expected diagnostic `E_TYPE_MISMATCH`"),
    "negative gate must reject clean `before`: " + err1,
  )

  let bad_after =
    "### E_TYPE_MISMATCH\n" +
    "```pion before\n" +
    "pub fn bad(x : Int) -> String { x + 1 }\n" +
    "```\n" +
    "```pion after\n" +
    "pub fn bad(x : Int) -> String { x + 1 }\n" +
    "```\n"
  let err2 = diag_doc_verify_markdown(bad_after)
  assert_true(
    str_contains(err2, "expected 0 diagnostics"),
    "negative gate must reject broken `after`: " + err2,
  )
}

///|
test "p1: edits.applicability distinguishes machine vs maybe in JSON" {
  // Machine-applicable: immutable let -> let mut
  let (_, json_mut, diags_mut) = check_one(
    "pub fn f() -> Int {\n  let x = 1\n  x = 2\n  x\n}\n",
  )
  assert_true(diags_mut.length() == 1 && diags_mut[0].edits.length() == 1, json_mut)
  assert_eq(diags_mut[0].edits[0].applicability, "machine")
  assert_true(str_contains(json_mut, "\"applicability\":\"machine\""), json_mut)

  // Machine-applicable: E_UNHANDLED_RESULT -> let _ =
  let (_, json_res, diags_res) = check_one(
    "fn p() -> Result[Int, String] { Ok(1) }\npub fn f() -> Int {\n  p()\n  0\n}\n",
  )
  assert_true(diags_res.length() == 1 && diags_res[0].edits.length() == 1, json_res)
  assert_eq(diags_res[0].edits[0].applicability, "machine")

  // Maybe-applicable: E_NON_EXHAUSTIVE -> panic("unhandled ...")
  let (_, json_exh, diags_exh) = check_one(
    "enum E { A, B }\npub fn f(e : E) -> Int {\n  match e {\n    A => 1\n  }\n}\n",
  )
  assert_true(diags_exh.length() == 1 && diags_exh[0].edits.length() == 1, json_exh)
  assert_eq(diags_exh[0].edits[0].applicability, "maybe")
  assert_true(str_contains(json_exh, "\"applicability\":\"maybe\""), json_exh)

  // Maybe-applicable: E_CAPABILITY_MISSING -> world : World
  let (_, json_cap, diags_cap) = check_one(
    "pub fn f() -> Unit {\n  io_println(\"hi\")\n}\n",
  )
  assert_true(diags_cap.length() == 1 && diags_cap[0].edits.length() == 1, json_cap)
  assert_eq(diags_cap[0].edits[0].applicability, "maybe")

  // Maybe-applicable: E_NOT_SEND -> Mutex::new(...)
  let (_, json_send, diags_send) = check_one(
    "pub fn f(w : World) -> Unit {\n  let mut n = 0\n  scope(w, fn(s) {\n    spawn(s, fn() { let _ = n })\n  })\n}\n",
  )
  assert_true(diags_send.length() >= 1 && diags_send[0].edits.length() >= 1, json_send)
  assert_eq(diags_send[0].edits[0].applicability, "maybe")
}

///|
test "p1: cross-language habit diagnostics emit stable codes and machine edits" {
  // 1. E_HABIT_ANGLE_GENERICS (fn, struct, type args, nested)
  let angle_src =
    "struct Box<T> {\n  v : Option<T>\n}\npub fn id<T>(x : T) -> T {\n  x\n}\n"
  expect_edit_fixes(angle_src, "E_HABIT_ANGLE_GENERICS", "struct Box[T]")

  // 2. E_HABIT_RUST_REF (&mut x -> mut x)
  let ref_src =
    "fn inc(mut x : Int) -> Unit { x = x + 1 }\npub fn main() -> Int {\n  let mut n = 1\n  inc(&mut n)\n  n\n}\n"
  expect_edit_fixes(ref_src, "E_HABIT_RUST_REF", "inc(mut n)")

  // 3. E_HABIT_RUST_ATTR (unsupported #[inline])
  let (ok_attr, json_attr, diags_attr) = check_one(
    "#[inline]\npub fn f(x : Int) -> Int { x }\n",
  )
  assert_true(!ok_attr && diags_attr.length() == 1 && diags_attr[0].code == "E_HABIT_RUST_ATTR", json_attr)

  // 4. E_HABIT_JS_CONST (top-level and local)
  let const_src = "const K : Int = 5\npub fn main() -> Int {\n  const y = K + 1\n  y\n}\n"
  expect_edit_fixes(const_src, "E_HABIT_JS_CONST", "let K : Int = 5")

  // 5. E_HABIT_JS_FUNCTION (top-level and closure)
  let fn_src = "pub function add(a : Int, b : Int) -> Int {\n  let f = function(x : Int) { x + 1 }\n  f(a) + b\n}\n"
  expect_edit_fixes(fn_src, "E_HABIT_JS_FUNCTION", "pub fn add(a : Int, b : Int) -> Int")

  // 6. E_HABIT_STRICT_EQ (=== and !==)
  let eq_src = "pub fn eq(a : Int, b : Int) -> Bool {\n  a === b && a !== 0\n}\n"
  expect_edit_fixes(eq_src, "E_HABIT_STRICT_EQ", "a == b && a != 0")

  // 7. E_HABIT_ARROW_FN ((...) => { ... })
  let arrow_src = "pub fn main() -> Int {\n  let f = (x : Int) => { x + 1 }\n  f(41)\n}\n"
  expect_edit_fixes(arrow_src, "E_HABIT_ARROW_FN", "fn(x : Int)")

  // 8. E_HABIT_MOONBIT_PKG (@dep.add -> dep::add)
  let dep_cr = check_source_files_with_imports(
    "dep",
    ["dep.pion"],
    ["pub fn add(a : Int, b : Int) -> Int { a + b }\n"],
    [],
    true,
  )
  assert_true(dep_cr.diagnostics.length() == 0, "dep clean")
  let mbt_src = "import \"dep\"\npub fn main() -> Int { @dep.add(1, 2) }\n"
  let mbt_cr = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [mbt_src],
    [imported_pkg_new("dep", dep_cr.tc)],
    true,
  )
  assert_true(
    mbt_cr.diagnostics.length() == 1 &&
    mbt_cr.diagnostics[0].code == "E_HABIT_MOONBIT_PKG" &&
    mbt_cr.diagnostics[0].edits.length() == 1 &&
    mbt_cr.diagnostics[0].edits[0].applicability == "machine",
    check_result_to_json(mbt_cr.diagnostics),
  )
  let patched_mbt = apply_edits(mbt_src, "app.pion", all_edits(mbt_cr.diagnostics))
  assert_true(str_contains(patched_mbt, "dep::add(1, 2)"), patched_mbt)
  let mbt_cr2 = check_source_files_with_imports(
    "app",
    ["app.pion"],
    [patched_mbt],
    [imported_pkg_new("dep", dep_cr.tc)],
    true,
  )
  assert_true(mbt_cr2.diagnostics.length() == 0, check_result_to_json(mbt_cr2.diagnostics))
}

///|
test "p1: zero false positives on valid JSX, comparisons, bitwise &, match guards, and supported #[...]" {
  let src =
    "#[derive(Eq)]\n" +
    "struct Pt { x : Int, y : Int }\n" +
    "#[no_io]\n" +
    "pub fn pure_cmp(a : Int, b : Int, f : Double) -> Bool {\n" +
    "  let bits = a & b\n" +
    "  let c1 = a < b && b > 0\n" +
    "  let c2 = (f as Int) < b && f as Int < 10 && f as Int < a\n" +
    "  let m = match a {\n" +
    "    v if (v > 0) => v\n" +
    "    v if v < 0 => -v\n" +
    "    _ => 0\n" +
    "  }\n" +
    "  bits == 0 && c1 && c2 && m >= 0\n" +
    "}\n" +
    "#[verify]\n" +
    "pub fn ver(x : Int) -> Int { x + 1 }\n" +
    "fn Btn(on_click~ : () -> Unit) -> Int { 1 }\n" +
    "pub fn view() -> Int {\n" +
    "  <Btn on_click=>{ let _ = 1 } />\n" +
    "}\n"
  let (ok, json, _) = check_one(src)
  assert_true(ok, "valid Pion must have 0 diagnostics: " + json)
}
