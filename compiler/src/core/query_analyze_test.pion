///|
fn qa_has(haystack : String, needle : String) -> Bool {
  match t_str_find(haystack, needle) {
    Some(_) => true
    None => false
  }
}

///|
test "query analyze: let mut, mutable struct/Array/Map, val struct, scalar/String/StrView captures" {
  let src =
    #|val struct Point {
    #|  x : Int
    #|  y : Int
    #|}
    #|
    #|struct Counter {
    #|  mut value : Int
    #|}
    #|
    #|struct Wrapper {
    #|  items : Array[String]
    #|}
    #|
    #|#no_io
    #|fn demo(sv : StrView) -> Int {
    #|  let mut count = 1
    #|  let pt = Point::{ x: 2, y: 3 }
    #|  let ctr = Counter::{ value: 4 }
    #|  let wrap = Wrapper::{ items: ["a"] }
    #|  let arr : Array[Int] = [1, 2]
    #|  let mp : Map[String, Int] = Map([("k", 1)])
    #|  let label = "hi"
    #|  let f = fn() -> Int {
    #|    count = count + pt.x + ctr.value + wrap.items.length() + arr.length() + mp.length() + label.length() + sv.length()
    #|    count
    #|  }
    #|  f()
    #|}
  let cr = check_source_files_with_imports_ex(
    "app",
    ["src/main.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // types metadata
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Point\",\"kind\":\"struct\",\"is_val\":true,\"has_mut_fields\":false,\"file\":\"src/main.pion\",\"line\":1}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Counter\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true,\"file\":\"src/main.pion\",\"line\":6}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Wrapper\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true,\"file\":\"src/main.pion\",\"line\":10}",
    ),
    true,
  )
  // no_io fn
  assert_eq(qa_has(json, "\"name\":\"demo\",\"file\":\"src/main.pion\",\"line\":15,\"no_io\":true"), true)
  // 1. let mut local capture
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"count\",\"is_mut\":true,\"ty\":\"Int\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":16}",
    ),
    true,
  )
  // 2. val struct capture
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"pt\",\"is_mut\":false,\"ty\":\"app::Point\",\"is_val_struct\":true,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":17}",
    ),
    true,
  )
  // 3. immutable binding of mutable struct (mut field)
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"ctr\",\"is_mut\":false,\"ty\":\"app::Counter\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":18}",
    ),
    true,
  )
  // 4. immutable binding of struct containing Array
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"wrap\",\"is_mut\":false,\"ty\":\"app::Wrapper\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":19}",
    ),
    true,
  )
  // 5. immutable binding of Array and Map
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"arr\",\"is_mut\":false,\"ty\":\"Array[Int]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":true,\"decl_line\":20}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"mp\",\"is_mut\":false,\"ty\":\"Map[String, Int]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":true,\"decl_line\":21}",
    ),
    true,
  )
  // 6. String & StrView captures
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"label\",\"is_mut\":false,\"ty\":\"String\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":22}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"sv\",\"is_mut\":false,\"ty\":\"StrView\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":15}",
    ),
    true,
  )
}

///|
test "query analyze: recursive / self-referential struct terminates without cycle" {
  let src =
    #|struct Node {
    #|  value : Int
    #|  next : Option[Node]
    #|}
    #|
    #|struct MutNode {
    #|  next : Option[MutNode]
    #|  mut value : Int
    #|}
    #|
    #|struct A {
    #|  b : Option[B]
    #|}
    #|
    #|struct B {
    #|  a : Option[A]
    #|  buf : Array[Int]
    #|}
    #|
    #|fn use_nodes(n : Node, m : MutNode, a : A) -> Int {
    #|  let f = fn() -> Int {
    #|    n.value + m.value
    #|  }
    #|  let g = fn() -> Option[B] {
    #|    a.b
    #|  }
    #|  let _ = g()
    #|  f()
    #|}
  let cr = check_source_files_with_imports_ex(
    "rec",
    ["rec.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"Node\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":false"), true)
  assert_eq(qa_has(json, "\"name\":\"MutNode\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"A\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"B\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"n\",\"is_mut\":false,\"ty\":\"rec::Node\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false"), true)
  assert_eq(qa_has(json, "\"name\":\"m\",\"is_mut\":false,\"ty\":\"rec::MutNode\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"a\",\"is_mut\":false,\"ty\":\"rec::A\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true"), true)
}

///|
test "query analyze: cross-package canonical targets and nested closure call isolation" {
  let pkg_a_src =
    #|pub struct Signal {
    #|  mut v : Int
    #|}
    #|
    #|pub fn Signal::get(self : Signal) -> Int {
    #|  self.v
    #|}
    #|
    #|pub fn Signal::set(self : Signal, nv : Int) -> Unit {
    #|  self.v = nv
    #|}
    #|
    #|pub fn effect(f : () -> Unit) -> Unit {
    #|  f()
    #|}
  let pkg_b_src =
    #|import "pkg_a"
    #|
    #|pub fn run_all(sig : pkg_a::Signal) -> Unit {
    #|  sig.set(1)
    #|  pkg_a::effect(fn() -> Unit {
    #|    let _ = sig.get()
    #|    let inner = fn() -> Unit {
    #|      sig.set(2)
    #|    }
    #|    inner()
    #|  })
    #|}
  let cr_a = check_source_files_with_imports_ex(
    "pkg_a",
    ["pkg_a/src/lib.pion"],
    [pkg_a_src],
    [],
    true,
    true,
  )
  assert_eq(cr_a.diagnostics.length(), 0)
  let cr_b = check_source_files_with_imports_ex(
    "pkg_b",
    ["pkg_b/src/main.pion"],
    [pkg_b_src],
    [ImportedPkg::{ name: "pkg_a", tc: cr_a.tc }],
    true,
    true,
  )
  assert_eq(cr_b.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr_a, cr_b], [])
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Ordinary fn calls in pkg_b::run_all
  assert_eq(qa_has(json, "\"target\":\"pkg_a::Signal::set\""), true)
  assert_eq(qa_has(json, "\"target\":\"pkg_a::effect\""), true)
  // Outer closure has context_callee = pkg_a::effect, context_arg = "0"
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"pkg_b::run_all\",\"file\":\"pkg_b/src/main.pion\",\"line\":5,\"col\":17,\"context_callee\":\"pkg_a::effect\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // Capture type is canonical pkg_a::Signal with has_mut_fields=true
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"sig\",\"is_mut\":false,\"ty\":\"pkg_a::Signal\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":3}",
    ),
    true,
  )
  // Outer closure calls pkg_a::Signal::get and closure::inner, NOT pkg_a::Signal::set (which belongs to inner)
  assert_eq(
    qa_has(
      json,
      "\"calls\":[{\"target\":\"pkg_a::Signal::get\",\"line\":6,\"col\":16},{\"target\":\"closure::inner\",\"line\":10,\"col\":10}]",
    ),
    true,
  )
  // Inner closure calls pkg_a::Signal::set
  assert_eq(
    qa_has(
      json,
      "\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"sig\",\"is_mut\":false,\"ty\":\"pkg_a::Signal\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":3}],\"calls\":[{\"target\":\"pkg_a::Signal::set\",\"line\":8,\"col\":10}]",
    ),
    true,
  )
}

///|
test "query analyze: Pion-JSX reactive prop closure and variant constructor context" {
  let src =
    #|struct Status {
    #|  mut label : String
    #|}
    #|
    #|fn Status::get(self : Status) -> String {
    #|  self.label
    #|}
    #|
    #|enum Live {
    #|  By(() -> String)
    #|}
    #|
    #|fn Text(text_by~ : () -> String) -> Int {
    #|  text_by().length()
    #|}
    #|
    #|fn render(status : Status) -> Int {
    #|  let _live = Live::By(fn() -> String { status.get() })
    #|  <Text text_by=>{status.get()} />
    #|}
  let cr = check_source_files_with_imports_ex(
    "ui",
    ["src/view.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Variant constructor context
  assert_eq(
    qa_has(
      json,
      "\"context_callee\":\"ui::Live::By\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // JSX prop=>{...} closure context
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/view.pion\",\"line\":19,\"col\":9,\"context_callee\":\"ui::Text\",\"context_arg\":\"text_by\"",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"status\",\"is_mut\":false,\"ty\":\"ui::Status\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":17}",
    ),
    true,
  )
  assert_eq(qa_has(json, "\"target\":\"ui::Status::get\""), true)
}

///|
test "query analyze: diagnostics included with ok=false and partial results" {
  let src =
    #|struct S {
    #|  mut x : Int
    #|}
    #|
    #|fn bad() -> Int {
    #|  "not_an_int"
    #|}
  let cr = check_source_files_with_imports_ex(
    "errpkg",
    ["err.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_not_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":false"), true)
  assert_eq(qa_has(json, "\"diagnostics\":["), true)
  assert_eq(qa_has(json, "\"name\":\"S\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"bad\""), true)
}

///|
test "query analyze: #into closure exports converter callee and arg 0" {
  let src =
    #|struct Status {
    #|  mut text : String
    #|}
    #|
    #|fn Status::get(self : Status) -> String {
    #|  self.text
    #|}
    #|
    #|enum Live[T] {
    #|  Is(T)
    #|  Fn(() -> T)
    #|}
    #|
    #|#into
    #|fn Live::of_fn[T](f : () -> T) -> Live[T] {
    #|  Live::Fn(f)
    #|}
    #|
    #|fn Text(into text~ : Live[String], plain~ : () -> String) -> Int {
    #|  let _ = text
    #|  let _ = plain
    #|  0
    #|}
    #|
    #|fn take_pos(into v : Live[String]) -> Int {
    #|  let _ = v
    #|  0
    #|}
    #|
    #|fn render() -> Unit {
    #|  let s = Status::{ text: "ok" }
    #|  let _ = Text(text=fn() -> String { s.get() }, plain=fn() -> String { s.get() })
    #|  let _ = <Text text=>{s.get()} plain=>{s.get()} />
    #|  let _ = take_pos(fn() -> String { s.get() })
    #|}
  let cr = check_source_files_with_imports_ex(
    "ui",
    ["src/into_view.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Named #into call arg -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":32,\"col\":21,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // Non-#into named arg keeps original callee + label
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":32,\"col\":55,\"context_callee\":\"ui::Text\",\"context_arg\":\"plain\"",
    ),
    true,
  )
  // JSX prop=>{...} on #into param -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":33,\"col\":17,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // JSX prop=>{...} on non-#into param keeps original callee + label
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":33,\"col\":33,\"context_callee\":\"ui::Text\",\"context_arg\":\"plain\"",
    ),
    true,
  )
  // Positional #into call arg -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":34,\"col\":20,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
}

///|
test "query analyze: capture_uses methods, chained calls, field_gets, escapes, struct literals, and interp" {
  let src =
    #|struct Sig {
    #|  mut v : Bool
    #|}
    #|
    #|fn Sig::get(self : Sig) -> Bool {
    #|  self.v
    #|}
    #|
    #|fn Sig::set(self : Sig, nv : Bool) -> Unit {
    #|  self.v = nv
    #|}
    #|
    #|struct Indexed {
    #|  mut n : Int
    #|}
    #|
    #|fn Indexed::get(self : Indexed, idx : Int) -> Int {
    #|  self.n + idx
    #|}
    #|
    #|struct Drag {
    #|  lo : Int
    #|  host : Indexed
    #|}
    #|
    #|fn Drag::value(self : Drag) -> Int {
    #|  self.lo
    #|}
    #|
    #|fn Drag::progress(self : Drag) -> Int {
    #|  self.lo + 1
    #|}
    #|
    #|fn Drag::host_node(self : Drag) -> Int {
    #|  self.lo + 2
    #|}
    #|
    #|fn Drag::value_with(self : Drag, other : Drag) -> Int {
    #|  self.lo + other.lo
    #|}
    #|
    #|struct LayoutModel {
    #|  dragging_sig : Sig
    #|}
    #|
    #|struct Holder {
    #|  drag : Drag
    #|}
    #|
    #|struct SameField {
    #|  dd : Int
    #|}
    #|
    #|fn test_all(dd : Drag, lm : LayoutModel, tag : String) -> Unit {
    #|  // 1. Safe method calls only -> sorted deduplicated methods, escaped=false
    #|  let c1 = fn() -> Int {
    #|    dd.value() + dd.progress() + dd.value()
    #|  }
    #|  // 2. Chained method call -> methods:["value"], escaped=false
    #|  let c2 = fn() -> String {
    #|    dd.value().to_string()
    #|  }
    #|  // 3. Zero-arg signal field .get() -> field_gets:["dragging_sig"], escaped=false
    #|  let c3 = fn() -> Bool {
    #|    lm.dragging_sig.get()
    #|  }
    #|  // 4a. Non-zero-arg .get(0) -> escaped=true
    #|  let c4a = fn() -> Int {
    #|    dd.host.get(0)
    #|  }
    #|  // 4b. Field .set(...) -> escaped=true
    #|  let c4b = fn() -> Unit {
    #|    lm.dragging_sig.set(true)
    #|  }
    #|  // 4c. Direct field read -> escaped=true
    #|  let c4c = fn() -> Int {
    #|    dd.lo
    #|  }
    #|  // 5a. Struct literal field value escape -> escaped=true
    #|  let c5a = fn() -> Holder {
    #|    Holder::{ drag: dd }
    #|  }
    #|  // 5b. Struct literal same-named field label is not an escape -> escaped=false
    #|  let c5b = fn() -> Int {
    #|    let sf = SameField::{ dd: 1 }
    #|    sf.dd + dd.value()
    #|  }
    #|  // 6a. String interpolation method call -> methods:["host_node"], escaped=false
    #|  let c6a = fn() -> String {
    #|    "node=\{dd.host_node()}"
    #|  }
    #|  // 6b. String interpolation bare capture -> escaped=true
    #|  let c6b = fn() -> String {
    #|    "tag=\{tag}"
    #|  }
    #|  // 13. Passing self as method argument -> methods:["value_with"], escaped=true
    #|  let c13 = fn() -> Int {
    #|    dd.value_with(dd)
    #|  }
    #|  let _ = (c1(), c2(), c3(), c4a(), c4b(), c4c(), c5a(), c5b(), c6a(), c6b(), c13())
    #|}
  let cr = check_source_files_with_imports_ex(
    "cu",
    ["src/cu.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // 1. Safe methods sorted & deduplicated
  assert_eq(
    qa_has(
      json,
      "\"line\":56,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Drag::value\",\"line\":57,\"col\":7},{\"target\":\"cu::Drag::progress\",\"line\":57,\"col\":20},{\"target\":\"cu::Drag::value\",\"line\":57,\"col\":36}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"progress\",\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 2. Chained method call
  assert_eq(
    qa_has(
      json,
      "\"line\":60,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Drag::value\",\"line\":61,\"col\":7},{\"target\":\"builtin::Int::to_string\",\"line\":61,\"col\":15}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 3. Zero-arg signal field .get()
  assert_eq(
    qa_has(
      json,
      "\"line\":64,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"lm\",\"is_mut\":false,\"ty\":\"cu::LayoutModel\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Sig::get\",\"line\":65,\"col\":20}],\"capture_uses\":[{\"name\":\"lm\",\"methods\":[],\"field_gets\":[\"dragging_sig\"],\"escaped\":false}]",
    ),
    true,
  )
  // 4a. Non-zero-arg .get(0) -> escaped=true
  assert_eq(
    qa_has(
      json,
      "\"line\":68,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Indexed::get\",\"line\":69,\"col\":12}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 4b. Field .set(...) -> escaped=true
  assert_eq(
    qa_has(
      json,
      "\"line\":72,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"lm\",\"is_mut\":false,\"ty\":\"cu::LayoutModel\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Sig::set\",\"line\":73,\"col\":20}],\"capture_uses\":[{\"name\":\"lm\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 4c. Direct field read -> escaped=true
  assert_eq(
    qa_has(
      json,
      "\"line\":76,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 5a. Struct literal field value escape -> escaped=true
  assert_eq(
    qa_has(
      json,
      "\"line\":80,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 5b. Struct literal same-named field label is not an escape
  assert_eq(
    qa_has(
      json,
      "\"line\":84,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Drag::value\",\"line\":86,\"col\":15}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 6a. String interpolation method call
  assert_eq(
    qa_has(
      json,
      "\"line\":89,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Drag::host_node\",\"line\":90,\"col\":15}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"host_node\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 6b. String interpolation bare capture
  assert_eq(
    qa_has(
      json,
      "\"line\":93,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"tag\",\"is_mut\":false,\"ty\":\"String\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":54}],\"calls\":[],\"capture_uses\":[{\"name\":\"tag\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 13. Passing self as method argument
  assert_eq(
    qa_has(
      json,
      "\"line\":97,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"cu::Drag\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":54}],\"calls\":[{\"target\":\"cu::Drag::value_with\",\"line\":98,\"col\":7}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value_with\"],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
}

///|
test "query analyze: capture_uses lexical shadowing across let, match, if-is, guard-is, blocks, and nested closures" {
  let src =
    #|struct Drag {
    #|  lo : Int
    #|}
    #|
    #|fn Drag::value(self : Drag) -> Int {
    #|  self.lo
    #|}
    #|
    #|fn Drag::host_node(self : Drag) -> Int {
    #|  self.lo + 1
    #|}
    #|
    #|fn has_host(d : Drag) -> Int {
    #|  d.lo + 2
    #|}
    #|
    #|fn make_other() -> Drag {
    #|  Drag::{ lo: 99 }
    #|}
    #|
    #|fn test_shadow(dd : Drag, opt : Option[Drag]) -> Unit {
    #|  // 7a. Self-shadowing let init (single-line) -> RHS sees outer dd -> escaped=true
    #|  let c7a = fn() -> Int {
    #|    let dd = has_host(dd)
    #|    dd
    #|  }
    #|  // 7b. Self-shadowing let init (multi-line) -> RHS sees outer dd -> escaped=true
    #|  let c7b = fn() -> Int {
    #|    let dd =
    #|      has_host(dd)
    #|    dd
    #|  }
    #|  // 7c. Shadowing let hides subsequent method calls
    #|  let c7c = fn() -> Int {
    #|    let v = dd.value()
    #|    let dd = make_other()
    #|    v + dd.host_node()
    #|  }
    #|  // 8. Match arm pattern binding shadows outer dd
    #|  let c8 = fn() -> Int {
    #|    let v = dd.value()
    #|    let m = match opt {
    #|      Some(dd) => dd.host_node()
    #|      None => 0
    #|    }
    #|    v + m
    #|  }
    #|  // 9. if is-pattern shadows && RHS and then-branch, not else-branch
    #|  let c9 = fn() -> Int {
    #|    if opt is Some(dd) && dd.host_node() > 0 {
    #|      dd.host_node()
    #|    } else {
    #|      dd.value()
    #|    }
    #|  }
    #|  // 10. guard is-pattern does not shadow else-branch, shadows following statements
    #|  let c10 = fn() -> Int {
    #|    guard opt is Some(dd) else {
    #|      return dd.value()
    #|    }
    #|    dd.host_node()
    #|  }
    #|  // 11. Inner local & block-scoped shadow do not pollute outer dd
    #|  let c11 = fn() -> Int {
    #|    let other = make_other()
    #|    let a = other.host_node()
    #|    let b = {
    #|      let dd = make_other()
    #|      dd.host_node()
    #|    }
    #|    a + b + dd.value()
    #|  }
    #|  // 12a. Nested closure without shadow escapes outer dd
    #|  let c12a = fn() -> Int {
    #|    let inner = fn() -> Int {
    #|      has_host(dd)
    #|    }
    #|    inner()
    #|  }
    #|  // 12b. Nested closure with param shadow does not escape outer dd
    #|  let c12b = fn() -> Int {
    #|    let inner = fn(dd : Drag) -> Int {
    #|      has_host(dd)
    #|    }
    #|    let _ = inner(make_other())
    #|    dd.value()
    #|  }
    #|  let _ = (c7a(), c7b(), c7c(), c8(), c9(), c10(), c11(), c12a(), c12b())
    #|}
  let cr = check_source_files_with_imports_ex(
    "sh",
    ["src/sh.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // 7a. Single-line self-shadowing let
  assert_eq(
    qa_has(
      json,
      "\"line\":23,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::has_host\",\"line\":24,\"col\":22}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 7b. Multi-line self-shadowing let
  assert_eq(
    qa_has(
      json,
      "\"line\":28,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::has_host\",\"line\":30,\"col\":15}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 7c. Shadowing let hides subsequent method calls
  assert_eq(
    qa_has(
      json,
      "\"line\":34,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::Drag::value\",\"line\":35,\"col\":15},{\"target\":\"sh::make_other\",\"line\":36,\"col\":24},{\"target\":\"sh::Drag::host_node\",\"line\":37,\"col\":11}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 8. Match arm binding shadows outer dd
  assert_eq(
    qa_has(
      json,
      "\"line\":40,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21},{\"name\":\"opt\",\"is_mut\":false,\"ty\":\"Option[sh::Drag]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::Drag::value\",\"line\":41,\"col\":15},{\"target\":\"sh::Drag::host_node\",\"line\":43,\"col\":21}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false},{\"name\":\"opt\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 9. if is-pattern shadows && RHS and then-branch, not else-branch
  assert_eq(
    qa_has(
      json,
      "\"line\":49,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"opt\",\"is_mut\":false,\"ty\":\"Option[sh::Drag]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21},{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::Drag::host_node\",\"line\":50,\"col\":29},{\"target\":\"sh::Drag::host_node\",\"line\":51,\"col\":9},{\"target\":\"sh::Drag::value\",\"line\":53,\"col\":9}],\"capture_uses\":[{\"name\":\"opt\",\"methods\":[],\"field_gets\":[],\"escaped\":true},{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 10. guard is-pattern does not shadow else-branch, shadows following statements
  assert_eq(
    qa_has(
      json,
      "\"line\":57,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"opt\",\"is_mut\":false,\"ty\":\"Option[sh::Drag]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21},{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::Drag::value\",\"line\":59,\"col\":16},{\"target\":\"sh::Drag::host_node\",\"line\":61,\"col\":7}],\"capture_uses\":[{\"name\":\"opt\",\"methods\":[],\"field_gets\":[],\"escaped\":true},{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 11. Inner local & block-scoped shadow
  assert_eq(
    qa_has(
      json,
      "\"line\":64,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"sh::make_other\",\"line\":65,\"col\":27},{\"target\":\"sh::Drag::host_node\",\"line\":66,\"col\":18},{\"target\":\"sh::make_other\",\"line\":68,\"col\":26},{\"target\":\"sh::Drag::host_node\",\"line\":69,\"col\":9},{\"target\":\"sh::Drag::value\",\"line\":71,\"col\":15}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // 12a. Nested closure without shadow escapes outer dd
  assert_eq(
    qa_has(
      json,
      "\"line\":74,\"col\":14,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"closure::inner\",\"line\":78,\"col\":10}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // 12b. Nested closure with param shadow does not escape outer dd
  assert_eq(
    qa_has(
      json,
      "\"line\":81,\"col\":14,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"sh::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":21}],\"calls\":[{\"target\":\"closure::inner\",\"line\":85,\"col\":18},{\"target\":\"sh::make_other\",\"line\":85,\"col\":29},{\"target\":\"sh::Drag::value\",\"line\":86,\"col\":7}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
}

///|
test "query analyze: capture_uses nested closure isolation, C-style for scoping, multi-field sort, and callable fields" {
  let src =
    #|struct Sig {
    #|  mut v : Bool
    #|}
    #|
    #|fn Sig::get(self : Sig) -> Bool {
    #|  self.v
    #|}
    #|
    #|struct Drag {
    #|  lo : Int
    #|}
    #|
    #|fn Drag::value(self : Drag) -> Int {
    #|  self.lo
    #|}
    #|
    #|fn Drag::host_node(self : Drag) -> Int {
    #|  self.lo + 1
    #|}
    #|
    #|fn take(d : Drag) -> Int {
    #|  d.lo
    #|}
    #|
    #|struct LayoutModel {
    #|  dragging_sig : Sig
    #|  z_sig : Sig
    #|  a_sig : Sig
    #|}
    #|
    #|struct CallHolder {
    #|  cb : () -> Int
    #|}
    #|
    #|fn test_r2(dd : Drag, lm : LayoutModel, opt : Option[Drag], ch : CallHolder) -> Unit {
    #|  // R2-1a: Nested closure calling safe method -> outer escaped=true & methods=[], inner methods=["value"] & escaped=false
    #|  let n1 = fn() -> Int {
    #|    let inner = fn() -> Int {
    #|      dd.value()
    #|    }
    #|    inner()
    #|  }
    #|  // R2-1b: Nested closure calling signal field .get() -> outer escaped=true & field_gets=[], inner field_gets=["dragging_sig"] & escaped=false
    #|  let n2 = fn() -> Bool {
    #|    let inner = fn() -> Bool {
    #|      lm.dragging_sig.get()
    #|    }
    #|    inner()
    #|  }
    #|  // R2-2a: C-style for cond is-pattern does NOT shadow body -> dd escaped=true
    #|  let f1 = fn() -> Int {
    #|    for i = 0; opt is Some(dd); i = i + 1 {
    #|      return take(dd)
    #|    }
    #|    0
    #|  }
    #|  // R2-2b: C-style for step_s let binding shadows body -> dd methods=["value"], escaped=false
    #|  let f2 = fn() -> Int {
    #|    let v = dd.value()
    #|    for i = 0; i < 1; let dd = Drag::{ lo: 42 } {
    #|      return v + dd.host_node()
    #|    }
    #|    v
    #|  }
    #|  // R2-3a: Multiple field_gets deduplicated and sorted lexicographically
    #|  let m1 = fn() -> Bool {
    #|    lm.z_sig.get() && lm.a_sig.get() && lm.z_sig.get()
    #|  }
    #|  // R2-3b: Syntactic callable field cap.cb() recorded in methods, escaped=false
    #|  let cf1 = fn() -> Int {
    #|    ch.cb()
    #|  }
    #|  let _ = (n1(), n2(), f1(), f2(), m1(), cf1())
    #|}
  let cr = check_source_files_with_imports_ex(
    "r2",
    ["src/r2.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // R2-1a outer: dd escaped=true, methods=[]
  assert_eq(
    qa_has(
      json,
      "\"line\":37,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"r2::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35}],\"calls\":[{\"target\":\"closure::inner\",\"line\":41,\"col\":10}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // R2-1a inner: dd methods=["value"], escaped=false
  assert_eq(
    qa_has(
      json,
      "\"line\":38,\"col\":17,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"r2::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35}],\"calls\":[{\"target\":\"r2::Drag::value\",\"line\":39,\"col\":9}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // R2-1b outer: lm escaped=true, field_gets=[]
  assert_eq(
    qa_has(
      json,
      "\"line\":44,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"lm\",\"is_mut\":false,\"ty\":\"r2::LayoutModel\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":35}],\"calls\":[{\"target\":\"closure::inner\",\"line\":48,\"col\":10}],\"capture_uses\":[{\"name\":\"lm\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // R2-1b inner: lm field_gets=["dragging_sig"], escaped=false
  assert_eq(
    qa_has(
      json,
      "\"line\":45,\"col\":17,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"lm\",\"is_mut\":false,\"ty\":\"r2::LayoutModel\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":35}],\"calls\":[{\"target\":\"r2::Sig::get\",\"line\":46,\"col\":22}],\"capture_uses\":[{\"name\":\"lm\",\"methods\":[],\"field_gets\":[\"dragging_sig\"],\"escaped\":false}]",
    ),
    true,
  )
  // R2-2a: C-style for cond is-pattern does not shadow body -> dd escaped=true
  assert_eq(
    qa_has(
      json,
      "\"line\":51,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"opt\",\"is_mut\":false,\"ty\":\"Option[r2::Drag]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35},{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"r2::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35}],\"calls\":[{\"target\":\"r2::take\",\"line\":53,\"col\":18}],\"capture_uses\":[{\"name\":\"opt\",\"methods\":[],\"field_gets\":[],\"escaped\":true},{\"name\":\"dd\",\"methods\":[],\"field_gets\":[],\"escaped\":true}]",
    ),
    true,
  )
  // R2-2b: C-style for step_s let binding shadows body -> dd methods=["value"], escaped=false
  assert_eq(
    qa_has(
      json,
      "\"line\":58,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"dd\",\"is_mut\":false,\"ty\":\"r2::Drag\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35}],\"calls\":[{\"target\":\"r2::Drag::value\",\"line\":59,\"col\":15},{\"target\":\"r2::Drag::host_node\",\"line\":61,\"col\":20}],\"capture_uses\":[{\"name\":\"dd\",\"methods\":[\"value\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
  // R2-3a: Multiple field_gets deduplicated and sorted lexicographically
  assert_eq(
    qa_has(
      json,
      "\"line\":66,\"col\":12,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"lm\",\"is_mut\":false,\"ty\":\"r2::LayoutModel\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":35}],\"calls\":[{\"target\":\"r2::Sig::get\",\"line\":67,\"col\":13},{\"target\":\"r2::Sig::get\",\"line\":67,\"col\":31},{\"target\":\"r2::Sig::get\",\"line\":67,\"col\":49}],\"capture_uses\":[{\"name\":\"lm\",\"methods\":[],\"field_gets\":[\"a_sig\",\"z_sig\"],\"escaped\":false}]",
    ),
    true,
  )
  // R2-3b: Syntactic callable field ch.cb() -> methods=["cb"], escaped=false
  assert_eq(
    qa_has(
      json,
      "\"line\":70,\"col\":13,\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"ch\",\"is_mut\":false,\"ty\":\"r2::CallHolder\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":35}],\"calls\":[{\"target\":\"builtin::CallHolder::cb\",\"line\":71,\"col\":7}],\"capture_uses\":[{\"name\":\"ch\",\"methods\":[\"cb\"],\"field_gets\":[],\"escaped\":false}]",
    ),
    true,
  )
}
