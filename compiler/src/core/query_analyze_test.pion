///|
fn qa_has(haystack : String, needle : String) -> Bool {
  match t_str_find(haystack, needle) {
    Some(_) => true
    None => false
  }
}

///|
test "query analyze: let mut, mutable struct/Array/Map, val struct, scalar/String/StrView captures" {
  let src =
    #|val struct Point {
    #|  x : Int
    #|  y : Int
    #|}
    #|
    #|struct Counter {
    #|  mut value : Int
    #|}
    #|
    #|struct Wrapper {
    #|  items : Array[String]
    #|}
    #|
    #|#no_io
    #|fn demo(sv : StrView) -> Int {
    #|  let mut count = 1
    #|  let pt = Point::{ x: 2, y: 3 }
    #|  let ctr = Counter::{ value: 4 }
    #|  let wrap = Wrapper::{ items: ["a"] }
    #|  let arr : Array[Int] = [1, 2]
    #|  let mp : Map[String, Int] = Map([("k", 1)])
    #|  let label = "hi"
    #|  let f = fn() -> Int {
    #|    count = count + pt.x + ctr.value + wrap.items.length() + arr.length() + mp.length() + label.length() + sv.length()
    #|    count
    #|  }
    #|  f()
    #|}
  let cr = check_source_files_with_imports_ex(
    "app",
    ["src/main.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // types metadata
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Point\",\"kind\":\"struct\",\"is_val\":true,\"has_mut_fields\":false,\"file\":\"src/main.pion\",\"line\":1}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Counter\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true,\"file\":\"src/main.pion\",\"line\":6}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"pkg\":\"app\",\"name\":\"Wrapper\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true,\"file\":\"src/main.pion\",\"line\":10}",
    ),
    true,
  )
  // no_io fn
  assert_eq(qa_has(json, "\"name\":\"demo\",\"file\":\"src/main.pion\",\"line\":15,\"no_io\":true"), true)
  // 1. let mut local capture
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"count\",\"is_mut\":true,\"ty\":\"Int\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":16}",
    ),
    true,
  )
  // 2. val struct capture
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"pt\",\"is_mut\":false,\"ty\":\"app::Point\",\"is_val_struct\":true,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":17}",
    ),
    true,
  )
  // 3. immutable binding of mutable struct (mut field)
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"ctr\",\"is_mut\":false,\"ty\":\"app::Counter\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":18}",
    ),
    true,
  )
  // 4. immutable binding of struct containing Array
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"wrap\",\"is_mut\":false,\"ty\":\"app::Wrapper\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":19}",
    ),
    true,
  )
  // 5. immutable binding of Array and Map
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"arr\",\"is_mut\":false,\"ty\":\"Array[Int]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":true,\"decl_line\":20}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"mp\",\"is_mut\":false,\"ty\":\"Map[String, Int]\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":true,\"decl_line\":21}",
    ),
    true,
  )
  // 6. String & StrView captures
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"label\",\"is_mut\":false,\"ty\":\"String\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":22}",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"sv\",\"is_mut\":false,\"ty\":\"StrView\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false,\"decl_line\":15}",
    ),
    true,
  )
}

///|
test "query analyze: recursive / self-referential struct terminates without cycle" {
  let src =
    #|struct Node {
    #|  value : Int
    #|  next : Option[Node]
    #|}
    #|
    #|struct MutNode {
    #|  next : Option[MutNode]
    #|  mut value : Int
    #|}
    #|
    #|struct A {
    #|  b : Option[B]
    #|}
    #|
    #|struct B {
    #|  a : Option[A]
    #|  buf : Array[Int]
    #|}
    #|
    #|fn use_nodes(n : Node, m : MutNode, a : A) -> Int {
    #|  let f = fn() -> Int {
    #|    n.value + m.value
    #|  }
    #|  let g = fn() -> Option[B] {
    #|    a.b
    #|  }
    #|  let _ = g()
    #|  f()
    #|}
  let cr = check_source_files_with_imports_ex(
    "rec",
    ["rec.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"Node\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":false"), true)
  assert_eq(qa_has(json, "\"name\":\"MutNode\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"A\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"B\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"n\",\"is_mut\":false,\"ty\":\"rec::Node\",\"is_val_struct\":false,\"has_mut_fields\":false,\"is_mutable_ty\":false"), true)
  assert_eq(qa_has(json, "\"name\":\"m\",\"is_mut\":false,\"ty\":\"rec::MutNode\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"a\",\"is_mut\":false,\"ty\":\"rec::A\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true"), true)
}

///|
test "query analyze: cross-package canonical targets and nested closure call isolation" {
  let pkg_a_src =
    #|pub struct Signal {
    #|  mut v : Int
    #|}
    #|
    #|pub fn Signal::get(self : Signal) -> Int {
    #|  self.v
    #|}
    #|
    #|pub fn Signal::set(self : Signal, nv : Int) -> Unit {
    #|  self.v = nv
    #|}
    #|
    #|pub fn effect(f : () -> Unit) -> Unit {
    #|  f()
    #|}
  let pkg_b_src =
    #|import "pkg_a"
    #|
    #|pub fn run_all(sig : pkg_a::Signal) -> Unit {
    #|  sig.set(1)
    #|  pkg_a::effect(fn() -> Unit {
    #|    let _ = sig.get()
    #|    let inner = fn() -> Unit {
    #|      sig.set(2)
    #|    }
    #|    inner()
    #|  })
    #|}
  let cr_a = check_source_files_with_imports_ex(
    "pkg_a",
    ["pkg_a/src/lib.pion"],
    [pkg_a_src],
    [],
    true,
    true,
  )
  assert_eq(cr_a.diagnostics.length(), 0)
  let cr_b = check_source_files_with_imports_ex(
    "pkg_b",
    ["pkg_b/src/main.pion"],
    [pkg_b_src],
    [ImportedPkg::{ name: "pkg_a", tc: cr_a.tc }],
    true,
    true,
  )
  assert_eq(cr_b.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr_a, cr_b], [])
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Ordinary fn calls in pkg_b::run_all
  assert_eq(qa_has(json, "\"target\":\"pkg_a::Signal::set\""), true)
  assert_eq(qa_has(json, "\"target\":\"pkg_a::effect\""), true)
  // Outer closure has context_callee = pkg_a::effect, context_arg = "0"
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"pkg_b::run_all\",\"file\":\"pkg_b/src/main.pion\",\"line\":5,\"col\":17,\"context_callee\":\"pkg_a::effect\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // Capture type is canonical pkg_a::Signal with has_mut_fields=true
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"sig\",\"is_mut\":false,\"ty\":\"pkg_a::Signal\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":3}",
    ),
    true,
  )
  // Outer closure calls pkg_a::Signal::get and closure::inner, NOT pkg_a::Signal::set (which belongs to inner)
  assert_eq(
    qa_has(
      json,
      "\"calls\":[{\"target\":\"pkg_a::Signal::get\",\"line\":6,\"col\":16},{\"target\":\"closure::inner\",\"line\":10,\"col\":10}]",
    ),
    true,
  )
  // Inner closure calls pkg_a::Signal::set
  assert_eq(
    qa_has(
      json,
      "\"context_callee\":\"\",\"context_arg\":\"\",\"captures\":[{\"name\":\"sig\",\"is_mut\":false,\"ty\":\"pkg_a::Signal\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":3}],\"calls\":[{\"target\":\"pkg_a::Signal::set\",\"line\":8,\"col\":10}]",
    ),
    true,
  )
}

///|
test "query analyze: Pion-JSX reactive prop closure and variant constructor context" {
  let src =
    #|struct Status {
    #|  mut label : String
    #|}
    #|
    #|fn Status::get(self : Status) -> String {
    #|  self.label
    #|}
    #|
    #|enum Live {
    #|  By(() -> String)
    #|}
    #|
    #|fn Text(text_by~ : () -> String) -> Int {
    #|  text_by().length()
    #|}
    #|
    #|fn render(status : Status) -> Int {
    #|  let _live = Live::By(fn() -> String { status.get() })
    #|  <Text text_by=>{status.get()} />
    #|}
  let cr = check_source_files_with_imports_ex(
    "ui",
    ["src/view.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Variant constructor context
  assert_eq(
    qa_has(
      json,
      "\"context_callee\":\"ui::Live::By\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // JSX prop=>{...} closure context
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/view.pion\",\"line\":19,\"col\":9,\"context_callee\":\"ui::Text\",\"context_arg\":\"text_by\"",
    ),
    true,
  )
  assert_eq(
    qa_has(
      json,
      "{\"name\":\"status\",\"is_mut\":false,\"ty\":\"ui::Status\",\"is_val_struct\":false,\"has_mut_fields\":true,\"is_mutable_ty\":true,\"decl_line\":17}",
    ),
    true,
  )
  assert_eq(qa_has(json, "\"target\":\"ui::Status::get\""), true)
}

///|
test "query analyze: diagnostics included with ok=false and partial results" {
  let src =
    #|struct S {
    #|  mut x : Int
    #|}
    #|
    #|fn bad() -> Int {
    #|  "not_an_int"
    #|}
  let cr = check_source_files_with_imports_ex(
    "errpkg",
    ["err.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_not_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":false"), true)
  assert_eq(qa_has(json, "\"diagnostics\":["), true)
  assert_eq(qa_has(json, "\"name\":\"S\",\"kind\":\"struct\",\"is_val\":false,\"has_mut_fields\":true"), true)
  assert_eq(qa_has(json, "\"name\":\"bad\""), true)
}

///|
test "query analyze: #into closure exports converter callee and arg 0" {
  let src =
    #|struct Status {
    #|  mut text : String
    #|}
    #|
    #|fn Status::get(self : Status) -> String {
    #|  self.text
    #|}
    #|
    #|enum Live[T] {
    #|  Is(T)
    #|  Fn(() -> T)
    #|}
    #|
    #|#into
    #|fn Live::of_fn[T](f : () -> T) -> Live[T] {
    #|  Live::Fn(f)
    #|}
    #|
    #|fn Text(into text~ : Live[String], plain~ : () -> String) -> Int {
    #|  let _ = text
    #|  let _ = plain
    #|  0
    #|}
    #|
    #|fn take_pos(into v : Live[String]) -> Int {
    #|  let _ = v
    #|  0
    #|}
    #|
    #|fn render() -> Unit {
    #|  let s = Status::{ text: "ok" }
    #|  let _ = Text(text=fn() -> String { s.get() }, plain=fn() -> String { s.get() })
    #|  let _ = <Text text=>{s.get()} plain=>{s.get()} />
    #|  let _ = take_pos(fn() -> String { s.get() })
    #|}
  let cr = check_source_files_with_imports_ex(
    "ui",
    ["src/into_view.pion"],
    [src],
    [],
    false,
    true,
  )
  assert_eq(cr.diagnostics.length(), 0)
  let json = query_analyze_packages_json([cr], cr.diagnostics)
  assert_eq(qa_has(json, "\"ok\":true"), true)
  // Named #into call arg -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":32,\"col\":21,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // Non-#into named arg keeps original callee + label
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":32,\"col\":55,\"context_callee\":\"ui::Text\",\"context_arg\":\"plain\"",
    ),
    true,
  )
  // JSX prop=>{...} on #into param -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":33,\"col\":17,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
  // JSX prop=>{...} on non-#into param keeps original callee + label
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":33,\"col\":33,\"context_callee\":\"ui::Text\",\"context_arg\":\"plain\"",
    ),
    true,
  )
  // Positional #into call arg -> converter callee + arg 0
  assert_eq(
    qa_has(
      json,
      "\"enclosing_fn\":\"ui::render\",\"file\":\"src/into_view.pion\",\"line\":34,\"col\":20,\"context_callee\":\"ui::Live::of_fn\",\"context_arg\":\"0\"",
    ),
    true,
  )
}
