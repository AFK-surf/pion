  schema_version : Int
  target : String
  wall_ms : ProfMetricDelta
  peak_rss_kb : ProfMetricDelta
  managed_alloc_bytes : ProfMetricDelta
  managed_alloc_count : ProfMetricDelta
  managed_inuse_bytes : ProfMetricDelta
  backing_alloc_bytes : ProfMetricDelta
  peak_reserved_bytes : ProfMetricDelta
  rc_total : ProfMetricDelta
  improved : Array[ProfFuncDiff]
  regressed : Array[ProfFuncDiff]
  new_fns : Array[ProfFuncDiff]
  gone_fns : Array[ProfFuncDiff]
}

///|
pub fn prof_tag_name(tag_id : Int) -> String {
  if tag_id == 1 {
    "String"
  } else if tag_id == 2 {
    "Bytes"
  } else if tag_id == 3 {
    "Array"
  } else if tag_id == 4 {
    "Struct"
  } else if tag_id == 5 {
    "Enum"
  } else if tag_id == 6 {
    "Closure"
  } else if tag_id == 7 {
    "Map"
  } else if tag_id == 8 {
    "Channel"
  } else if tag_id == 9 {
    "Mutex"
  } else if tag_id == 10 {
    "Atomic"
  } else if tag_id == 11 {
    "StrBuf"
  } else if tag_id == 12 {
    "Scope"
  } else if tag_id == 13 {
    "World"
  } else {
    "Tag(" + tag_id.to_string() + ")"
  }
}

///|
fn prof_trim_ws(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = n
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  slice_str(s, a, b)
}

///|
fn prof_split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if str_code_at(s, i) == 10 {
      let mut end = i
      if end > start && str_code_at(s, end - 1) == 13 {
        end = end - 1
      }
      out.push(slice_str(s, start, end))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    let mut end = n
    if end > start && str_code_at(s, end - 1) == 13 {
      end = end - 1
    }
    out.push(slice_str(s, start, end))
  }
  out
}

///|
fn prof_split_char(s : String, sep_code : Int) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if str_code_at(s, i) == sep_code {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  out.push(slice_str(s, start, n))
  out
}

///|
fn prof_split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n && (str_code_at(s, i) == 32 || str_code_at(s, i) == 9) {
      i = i + 1
    }
    if i >= n {
      break
    }
    let start = i
    while i < n && str_code_at(s, i) != 32 && str_code_at(s, i) != 9 {
      i = i + 1
    }
    out.push(slice_str(s, start, i))
  }
  out
}

///|
fn prof_parse_i64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if str_code_at(s, 0) == 45 {
    neg = true
    i = 1
  } else if str_code_at(s, 0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut acc = 0L
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return None
    }
    acc = acc * 10L + (c - 48).to_int64()
    i = i + 1
  }
  if neg {
    Some(0L - acc)
  } else {
    Some(acc)
  }
}

///|
fn prof_parse_hex_i64(s : String) -> Option[Int64] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  if n >= 2 &&
  str_code_at(s, 0) == 48 &&
  (str_code_at(s, 1) == 120 || str_code_at(s, 1) == 88) {
    i = 2
  }
  if i >= n {
    return None
  }
  let mut acc = 0L
  while i < n {
    let d = dm_hex_val(str_code_at(s, i))
    if d < 0 {
      return None
    }
    acc = (acc << 4) | d.to_int64()
    i = i + 1
  }
  Some(acc)
}

///|
fn prof_parse_double(s : String) -> Option[Double] {
  let n = s.length()
  if n == 0 {
    return None
  }
  let mut i = 0
  let mut neg = false
  if str_code_at(s, 0) == 45 {
    neg = true
    i = 1
  } else if str_code_at(s, 0) == 43 {
    i = 1
  }
  if i >= n {
    return None
  }
  let mut int_part = 0.0
  let mut has_digit = false
  while i < n {
    let c = str_code_at(s, i)
    if c >= 48 && c <= 57 {
      int_part = int_part * 10.0 + (c - 48).to_double()
      has_digit = true
      i = i + 1
    } else {
      break
    }
  }
  let mut frac_part = 0.0
  let mut frac_scale = 0.1
  if i < n && str_code_at(s, i) == 46 {
    i = i + 1
    while i < n {
      let c = str_code_at(s, i)
      if c >= 48 && c <= 57 {
        frac_part = frac_part + (c - 48).to_double() * frac_scale
        frac_scale = frac_scale * 0.1
        has_digit = true
        i = i + 1
      } else {
        break
      }
    }
  }
  if !has_digit {
    return None
  }
  let mut v = int_part + frac_part
  if i < n && (str_code_at(s, i) == 101 || str_code_at(s, i) == 69) {
    i = i + 1
    let mut eneg = false
    if i < n && str_code_at(s, i) == 45 {
      eneg = true
      i = i + 1
    } else if i < n && str_code_at(s, i) == 43 {
      i = i + 1
    }
    let mut exp = 0
    let mut has_exp = false
    while i < n {
      let c = str_code_at(s, i)
      if c >= 48 && c <= 57 {
        exp = exp * 10 + (c - 48)
        has_exp = true
        i = i + 1
      } else {
        break
      }
    }
    if !has_exp {
      return None
    }
    let mut k = 0
    while k < exp && k < 308 {
      if eneg {
        v = v * 0.1
      } else {
        v = v * 10.0
      }
      k = k + 1
    }
  }
  if i != n {
    return None
  }
  if neg {
    Some(0.0 - v)
  } else {
    Some(v)
  }
}

///|
/// Pure-Pion sidecar symbol table parser (`raw_sym\tpretty\tkind\tpkg\tfile\tline\n`).
pub fn prof_parse_sidecar_syms(text : String) -> Map[String, ProfSidecarSym] {
  let out : Map[String, ProfSidecarSym] = Map([])
  let lines = prof_split_lines(text)
  let mut i = 0
  while i < lines.length() {
    let line = prof_trim_ws(lines[i])
    if line.length() == 0 || str_code_at(line, 0) == 35 {
      i = i + 1
      continue
    }
    let cols = prof_split_char(line, 9)
    if cols.length() >= 2 {
      let raw_sym = cols[0]
      let pretty = cols[1]
      let kind = if cols.length() >= 3 { cols[2] } else { "" }
      let pkg = if cols.length() >= 4 { cols[3] } else { "" }
      let file = if cols.length() >= 5 { cols[4] } else { "" }
      let line_no = if cols.length() >= 6 {
        match prof_parse_i64(cols[5]) {
          Some(v) => v.to_int()
          None => 0
        }
      } else {
        0
      }
      if raw_sym.length() > 0 {
        out.set(
          raw_sym,
          ProfSidecarSym::{ raw_sym: raw_sym, pretty: pretty, kind: kind, pkg: pkg, file: file, line: line_no },
        )
      }
    }
    i = i + 1
  }
  out
}

///|
/// Parses `PIONPROF 1` raw text format (RFC v2 §1.3D).
pub fn prof_parse_raw(raw : String) -> Result[ProfRaw, String] {
  let lines = prof_split_lines(raw)
  let mut seen_header = false
  let mut target = ""
  let mut modes = 0
  let mut build_modes = 0
  let mut cpu_stack_mode = "pc_only"
  let mut sample_rate = 1
  let mut hz = 997
  let mut retained = false
  let mut retained_truncated = false
  let mut wall_us = 0L
  let mut cpu_us = 0L
  let mut peak_rss_kb = 0L
  let mut dropped_cpu = 0L
  let mut dropped_alloc = 0L
  let mut dropped_rc = 0L
  let mut reserved_bytes = 0L
  let mut peak_reserved_bytes = 0L
  let mut backing_alloc_bytes = 0L
  let mut backing_alloc_count = 0L
  let mut backing_free_bytes = 0L
  let mut backing_inuse_bytes = 0L
  let mut anchor_addr = 0L
  let mut anchor_sym = ""
  let mut bin_path = ""
  let tags : Array[ProfTagRow] = []
  let types : Array[ProfTypeRow] = []
  let cpu_pcs : Array[ProfCpuPc] = []
  let stacks : Array[ProfStackRow] = []

  let mut li = 0
  while li < lines.length() {
    let line = prof_trim_ws(lines[li])
    li = li + 1
    if line.length() == 0 || str_code_at(line, 0) == 35 {
      continue
    }
    let toks = prof_split_ws(line)
    if toks.length() == 0 {
      continue
    }
    let head = toks[0]
    if !seen_header {
      if head != "PIONPROF" || toks.length() < 2 || toks[1] != "1" {
        return Err("invalid PIONPROF header (expected 'PIONPROF 1')")
      }
      seen_header = true
      continue
    }
    if head == "META" {
      let mut ti = 1
      while ti < toks.length() {
        let kv = toks[ti]
        let eq = dm_find_sub(kv, "=", 0)
        if eq > 0 {
          let k = slice_str(kv, 0, eq)
          let v = slice_str(kv, eq + 1, kv.length())
          if k == "target" {
            target = v
          } else if k == "modes" {
            match prof_parse_i64(v) { Some(x) => modes = x.to_int(); None => () }
          } else if k == "build_modes" {
            match prof_parse_i64(v) { Some(x) => build_modes = x.to_int(); None => () }
          } else if k == "cpu_stack_mode" {
            cpu_stack_mode = v
          } else if k == "sample_rate" {
            match prof_parse_i64(v) { Some(x) => sample_rate = x.to_int(); None => () }
          } else if k == "hz" {
            match prof_parse_i64(v) { Some(x) => hz = x.to_int(); None => () }
          } else if k == "retained" {
            retained = v == "1" || v == "true"
          } else if k == "retained_truncated" {
            retained_truncated = v == "1" || v == "true"
          } else if k == "wall_us" {
            match prof_parse_i64(v) { Some(x) => wall_us = x; None => () }
          } else if k == "cpu_us" {
            match prof_parse_i64(v) { Some(x) => cpu_us = x; None => () }
          } else if k == "peak_rss_kb" {
            match prof_parse_i64(v) { Some(x) => peak_rss_kb = x; None => () }
          } else if k == "dropped_cpu" {
            match prof_parse_i64(v) { Some(x) => dropped_cpu = x; None => () }
          } else if k == "dropped_alloc" {
            match prof_parse_i64(v) { Some(x) => dropped_alloc = x; None => () }
          } else if k == "dropped_rc" {
            match prof_parse_i64(v) { Some(x) => dropped_rc = x; None => () }
          } else if k == "reserved_bytes" {
            match prof_parse_i64(v) { Some(x) => reserved_bytes = x; None => () }
          } else if k == "peak_reserved_bytes" {
            match prof_parse_i64(v) { Some(x) => peak_reserved_bytes = x; None => () }
          } else if k == "backing_alloc_bytes" {
            match prof_parse_i64(v) { Some(x) => backing_alloc_bytes = x; None => () }
          } else if k == "backing_alloc_count" {
            match prof_parse_i64(v) { Some(x) => backing_alloc_count = x; None => () }
          } else if k == "backing_free_bytes" {
            match prof_parse_i64(v) { Some(x) => backing_free_bytes = x; None => () }
          } else if k == "backing_inuse_bytes" {
            match prof_parse_i64(v) { Some(x) => backing_inuse_bytes = x; None => () }
          }
        }
        ti = ti + 1
      }
    } else if head == "ANCHOR" {
      if toks.length() < 3 {
        return Err("malformed ANCHOR line")
      }
      match prof_parse_hex_i64(toks[1]) {
        Some(a) => anchor_addr = a
        None => return Err("invalid hex address in ANCHOR line")
      }
      anchor_sym = toks[2]
    } else if head == "BIN" {
      if line.length() > 4 {
        bin_path = prof_trim_ws(slice_str(line, 4, line.length()))
      }
    } else if head == "TAG" {
      if toks.length() < 14 {
        return Err("malformed TAG line (expected 13 fields)")
      }
      let tag_id = match prof_parse_i64(toks[1]) { Some(x) => x.to_int(); None => return Err("invalid tag_id") }
      let alloc_count = match prof_parse_i64(toks[2]) { Some(x) => x; None => return Err("invalid TAG alloc_count") }
      let alloc_bytes = match prof_parse_i64(toks[3]) { Some(x) => x; None => return Err("invalid TAG alloc_bytes") }
      let free_count = match prof_parse_i64(toks[4]) { Some(x) => x; None => return Err("invalid TAG free_count") }
      let free_bytes = match prof_parse_i64(toks[5]) { Some(x) => x; None => return Err("invalid TAG free_bytes") }
      let inuse_count = match prof_parse_i64(toks[6]) { Some(x) => x; None => return Err("invalid TAG inuse_count") }
      let inuse_bytes = match prof_parse_i64(toks[7]) { Some(x) => x; None => return Err("invalid TAG inuse_bytes") }
      let rc_inc = match prof_parse_i64(toks[8]) { Some(x) => x; None => return Err("invalid TAG rc_inc") }
      let rc_dec = match prof_parse_i64(toks[9]) { Some(x) => x; None => return Err("invalid TAG rc_dec") }
      let rc_atomic_inc = match prof_parse_i64(toks[10]) { Some(x) => x; None => return Err("invalid TAG rc_atomic_inc") }
      let rc_atomic_dec = match prof_parse_i64(toks[11]) { Some(x) => x; None => return Err("invalid TAG rc_atomic_dec") }
      let rc_destroy = match prof_parse_i64(toks[12]) { Some(x) => x; None => return Err("invalid TAG rc_destroy") }
      let rc_immortal = match prof_parse_i64(toks[13]) { Some(x) => x; None => return Err("invalid TAG rc_immortal") }
      tags.push(ProfTagRow::{
        tag_id: tag_id,
        tag_name: prof_tag_name(tag_id),
        alloc_count: alloc_count,
        alloc_bytes: alloc_bytes,
        free_count: free_count,
        free_bytes: free_bytes,
        inuse_count: inuse_count,
        inuse_bytes: inuse_bytes,
        rc_inc: rc_inc,
        rc_dec: rc_dec,
        rc_atomic_inc: rc_atomic_inc,
        rc_atomic_dec: rc_atomic_dec,
        rc_destroy: rc_destroy,
        rc_immortal: rc_immortal,
      })
    } else if head == "TYPE" {
      if toks.length() < 9 {
        return Err("malformed TYPE line (expected 8 fields)")
      }
      let tag_id = match prof_parse_i64(toks[1]) { Some(x) => x.to_int(); None => return Err("invalid TYPE tag_id") }
      let drop_tok = toks[2]
      let alloc_count = match prof_parse_i64(toks[3]) { Some(x) => x; None => return Err("invalid TYPE alloc_count") }
      let alloc_bytes = match prof_parse_i64(toks[4]) { Some(x) => x; None => return Err("invalid TYPE alloc_bytes") }
      let free_count = match prof_parse_i64(toks[5]) { Some(x) => x; None => return Err("invalid TYPE free_count") }
      let free_bytes = match prof_parse_i64(toks[6]) { Some(x) => x; None => return Err("invalid TYPE free_bytes") }
      let inuse_count = match prof_parse_i64(toks[7]) { Some(x) => x; None => return Err("invalid TYPE inuse_count") }
      let inuse_bytes = match prof_parse_i64(toks[8]) { Some(x) => x; None => return Err("invalid TYPE inuse_bytes") }
      types.push(ProfTypeRow::{
        tag_id: tag_id,
        tag_name: prof_tag_name(tag_id),
        drop_fn_raw: drop_tok,
        type_name: "",
        alloc_count: alloc_count,
        alloc_bytes: alloc_bytes,
        free_count: free_count,
        free_bytes: free_bytes,
        inuse_count: inuse_count,
        inuse_bytes: inuse_bytes,
      })
    } else if head == "CPU_PC" {
      if toks.length() < 3 {
        return Err("malformed CPU_PC line")
      }
      let cnt = match prof_parse_i64(toks[2]) { Some(x) => x; None => return Err("invalid CPU_PC count") }
      cpu_pcs.push(ProfCpuPc::{ pc_token: toks[1], count: cnt })
    } else if head == "STACK" {
      if toks.length() < 5 {
        return Err("malformed STACK line")
      }
      let kind = toks[1]
      let tag_id = match prof_parse_i64(toks[2]) { Some(x) => x.to_int(); None => return Err("invalid STACK tag_id") }
      let count = match prof_parse_i64(toks[3]) { Some(x) => x; None => return Err("invalid STACK count") }
      let bytes = match prof_parse_i64(toks[4]) { Some(x) => x; None => return Err("invalid STACK bytes") }
      let frames : Array[String] = []
      if toks.length() >= 6 && toks[5].length() > 0 && toks[5] != "-" {
        let parts = prof_split_char(toks[5], 44)
        let mut fi = 0
        while fi < parts.length() {
          if parts[fi].length() > 0 {
            frames.push(parts[fi])
          }
          fi = fi + 1
        }
      }
      stacks.push(ProfStackRow::{ kind: kind, tag_id: tag_id, count: count, bytes: bytes, frames: frames })
    }
  }
  if !seen_header {
    return Err("empty profile input (missing 'PIONPROF 1' header)")
  }
  Ok(ProfRaw::{
    version: 1,
    target: target,
    modes: modes,
    build_modes: build_modes,
    cpu_stack_mode: cpu_stack_mode,
    sample_rate: sample_rate,
    hz: hz,
    retained: retained,
    retained_truncated: retained_truncated,
    wall_us: wall_us,
    cpu_us: cpu_us,
    peak_rss_kb: peak_rss_kb,
    dropped_cpu: dropped_cpu,
    dropped_alloc: dropped_alloc,
    dropped_rc: dropped_rc,
    reserved_bytes: reserved_bytes,
    peak_reserved_bytes: peak_reserved_bytes,
    backing_alloc_bytes: backing_alloc_bytes,
    backing_alloc_count: backing_alloc_count,
    backing_free_bytes: backing_free_bytes,
    backing_inuse_bytes: backing_inuse_bytes,
    anchor_addr: anchor_addr,
    anchor_sym: anchor_sym,
    bin_path: bin_path,
    tags: tags,
    types: types,
    cpu_pcs: cpu_pcs,
    stacks: stacks,
  })
}

///| Minimal JSON parser helpers (reusing `cas_json_skip_ws` / `cas_json_parse_string` / `cas_json_skip_value`).
///|
fn prof_json_parse_string(txt : String, pos : Array[Int], n : Int) -> Option[String] {
  cas_json_skip_ws(txt, pos, n)
  cas_json_parse_string(txt, pos, n)
}

fn prof_json_parse_number_raw(txt : String, pos : Array[Int], n : Int) -> Option[String] {
  cas_json_skip_ws(txt, pos, n)
  let start = pos[0]
  let mut p = start
  if p < n && str_code_at(txt, p) == 45 {
    p = p + 1
  }
  if p >= n || !dm_is_digit(str_code_at(txt, p)) {
    return None
  }
  while p < n && dm_is_digit(str_code_at(txt, p)) {
    p = p + 1
  }
  if p < n && str_code_at(txt, p) == 46 {
    p = p + 1
    while p < n && dm_is_digit(str_code_at(txt, p)) {
      p = p + 1
    }
  }
  if p < n && (str_code_at(txt, p) == 101 || str_code_at(txt, p) == 69) {
    p = p + 1
    if p < n && (str_code_at(txt, p) == 43 || str_code_at(txt, p) == 45) {
      p = p + 1
    }
    while p < n && dm_is_digit(str_code_at(txt, p)) {
      p = p + 1
    }
  }
  pos[0] = p
  Some(slice_str(txt, start, p))
}

///|
fn prof_json_parse_i64(txt : String, pos : Array[Int], n : Int) -> Option[Int64] {
  match prof_json_parse_number_raw(txt, pos, n) {
    Some(s) => prof_parse_i64(s)
    None => None
  }
}

///|
fn prof_json_parse_double(txt : String, pos : Array[Int], n : Int) -> Option[Double] {
  match prof_json_parse_number_raw(txt, pos, n) {
    Some(s) => prof_parse_double(s)
    None => None
  }
}

///|
fn prof_json_parse_bool(txt : String, pos : Array[Int], n : Int) -> Option[Bool] {
  cas_json_skip_ws(txt, pos, n)
  let p = pos[0]
  if p + 4 <= n && slice_str(txt, p, p + 4) == "true" {
    pos[0] = p + 4
    Some(true)
  } else if p + 5 <= n && slice_str(txt, p, p + 5) == "false" {
    pos[0] = p + 5
    Some(false)
  } else {
    None
  }
}

///|
fn prof_json_parse_opt_double(txt : String, pos : Array[Int], n : Int) -> Option[Option[Double]] {
  cas_json_skip_ws(txt, pos, n)
  let p = pos[0]
  if p + 4 <= n && slice_str(txt, p, p + 4) == "null" {
    pos[0] = p + 4
    return Some(None)
  }
  match prof_json_parse_double(txt, pos, n) {
    Some(v) => Some(Some(v))
    None => None
  }
}

///|
fn prof_json_expect_char(txt : String, pos : Array[Int], n : Int, ch : Int) -> Bool {
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == ch {
    pos[0] = pos[0] + 1
    true
  } else {
    false
  }
}

///|
fn prof_json_parse_i64_array(txt : String, pos : Array[Int], n : Int) -> Option[Array[Int64]] {
  if !prof_json_expect_char(txt, pos, n, 91) {
    return None
  }
  let out : Array[Int64] = []
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 93 {
    pos[0] = pos[0] + 1
    return Some(out)
  }
  while true {
    match prof_json_parse_i64(txt, pos, n) {
      Some(v) => out.push(v)
      None => return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 93 {
      pos[0] = pos[0] + 1
      return Some(out)
    } else {
      return None
    }
  }
  None
}

///|
fn prof_map_v8_func_name(fn_name : String, wasm_names : Map[Int, String]) -> String {
  // Handle `wasm-function[N]` (exact or inside `wasm-function[N]`)
  let idx = dm_find_sub(fn_name, "wasm-function[", 0)
  if idx >= 0 {
    let num_start = idx + 14
    let (fn_idx, end_pos) = dm_parse_uint_at(fn_name, num_start)
    if end_pos > num_start && end_pos < fn_name.length() && str_code_at(fn_name, end_pos) == 93 {
      match wasm_names.get(fn_idx) {
        Some(mapped) => return mapped
        None => ()
      }
    }
  }
  if fn_name.length() == 0 {
    "(anonymous)"
  } else {
    fn_name
  }
}

///|
struct V8Node {
  id : Int
  fn_name : String
  hit_count : Int64
  children : Array[Int]
}

///|
fn prof_parse_v8_node(txt : String, pos : Array[Int], n : Int) -> Option[V8Node] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut id = -1
  let mut fn_name = ""
  let mut hit_count = 0L
  let mut children : Array[Int] = []
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(V8Node::{ id: id, fn_name: fn_name, hit_count: hit_count, children: children })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let key = match prof_json_parse_string(txt, pos, n) {
      Some(k) => k
      None => return None
    }
    if !prof_json_expect_char(txt, pos, n, 58) {
      return None
    }
    if key == "id" {
      match prof_json_parse_i64(txt, pos, n) {
        Some(v) => id = v.to_int()
        None => return None
      }
    } else if key == "hitCount" {
      match prof_json_parse_i64(txt, pos, n) {
        Some(v) => hit_count = v
        None => return None
      }
    } else if key == "children" {
      match prof_json_parse_i64_array(txt, pos, n) {
        Some(arr) => {
          let cs : Array[Int] = []
          let mut ci = 0
          while ci < arr.length() {
            cs.push(arr[ci].to_int())
            ci = ci + 1
          }
          children = cs
        }
        None => return None
      }
    } else if key == "callFrame" {
      if !prof_json_expect_char(txt, pos, n, 123) {
        return None
      }
      cas_json_skip_ws(txt, pos, n)
      if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(txt, pos, n)
          let cf_key = match prof_json_parse_string(txt, pos, n) {
            Some(k) => k
            None => return None
          }
          if !prof_json_expect_char(txt, pos, n, 58) {
            return None
          }
          if cf_key == "functionName" {
            match prof_json_parse_string(txt, pos, n) {
              Some(s) => fn_name = s
              None => return None
            }
          } else if !cas_json_skip_value(txt, pos, n, 0) {
            return None
          }
          cas_json_skip_ws(txt, pos, n)
          if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
            pos[0] = pos[0] + 1
          } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
            pos[0] = pos[0] + 1
            break
          } else {
            return None
          }
        }
      }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(V8Node::{ id: id, fn_name: fn_name, hit_count: hit_count, children: children })
}

///|
/// Parses a V8 `.cpuprofile` JSON produced by `node --cpu-prof`.
pub fn prof_parse_v8_cpuprofile(
  json : String,
  wasm_names : Map[Int, String],
) -> Result[ProfCpuData, String] {
  let n = json.length()
  let pos : Array[Int] = [0]
  if !prof_json_expect_char(json, pos, n, 123) {
    return Err("invalid V8 cpuprofile JSON: expected '{'")
  }
  let nodes : Array[V8Node] = []
  let mut samples : Array[Int64] = []
  let mut time_deltas : Array[Int64] = []
  cas_json_skip_ws(json, pos, n)
  if pos[0] < n && str_code_at(json, pos[0]) == 125 {
    return Ok(ProfCpuData::{
      total_samples: 0L,
      total_us: 0L,
      stack_mode: "full",
      funcs: [],
    })
  }
  while true {
    cas_json_skip_ws(json, pos, n)
    let key = match prof_json_parse_string(json, pos, n) {
      Some(k) => k
      None => return Err("invalid V8 cpuprofile JSON: expected key string")
    }
    if !prof_json_expect_char(json, pos, n, 58) {
      return Err("invalid V8 cpuprofile JSON: expected ':'")
    }
    if key == "nodes" {
      if !prof_json_expect_char(json, pos, n, 91) {
        return Err("invalid V8 cpuprofile JSON: expected '[' for nodes")
      }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_v8_node(json, pos, n) {
            Some(nd) => nodes.push(nd)
            None => return Err("invalid V8 cpuprofile JSON: malformed node")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 {
            pos[0] = pos[0] + 1
          } else if pos[0] < n && str_code_at(json, pos[0]) == 93 {
            pos[0] = pos[0] + 1
            break
          } else {
            return Err("invalid V8 cpuprofile JSON: expected ',' or ']' in nodes")
          }
        }
      }
    } else if key == "samples" {
      match prof_json_parse_i64_array(json, pos, n) {
        Some(arr) => samples = arr
        None => return Err("invalid V8 cpuprofile JSON: malformed samples")
      }
    } else if key == "timeDeltas" {
      match prof_json_parse_i64_array(json, pos, n) {
        Some(arr) => time_deltas = arr
        None => return Err("invalid V8 cpuprofile JSON: malformed timeDeltas")
      }
    } else if !cas_json_skip_value(json, pos, n, 0) {
      return Err("invalid V8 cpuprofile JSON: failed to skip field '" + key + "'")
    }
    cas_json_skip_ws(json, pos, n)
    if pos[0] < n && str_code_at(json, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(json, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return Err("invalid V8 cpuprofile JSON: expected ',' or '}'")
    }
  }

  let node_name : Map[Int, String] = Map([])
  let parent_of : Map[Int, Int] = Map([])
  let mut ni = 0
  while ni < nodes.length() {
    let nd = nodes[ni]
    node_name.set(nd.id, prof_map_v8_func_name(nd.fn_name, wasm_names))
    let mut ci = 0
    while ci < nd.children.length() {
      parent_of.set(nd.children[ci], nd.id)
      ci = ci + 1
    }
    ni = ni + 1
  }

  let self_s : Map[String, Int64] = Map([])
  let cum_s : Map[String, Int64] = Map([])
  let self_u : Map[String, Int64] = Map([])
  let cum_u : Map[String, Int64] = Map([])
  let sym_order : Array[String] = []
  let sym_seen : Map[String, Bool] = Map([])

  let mut total_samples = 0L
  let mut total_us = 0L
  let use_samples = samples.length() > 0

  if use_samples {
    let has_deltas = time_deltas.length() == samples.length()
    let mut si = 0
    while si < samples.length() {
      let nid = samples[si].to_int()
      let dt = if has_deltas && time_deltas[si] > 0L { time_deltas[si] } else { 1L }
      let leaf_name = match node_name.get(nid) { Some(nm) => nm; None => "(unknown)" }
      if leaf_name == "(idle)" || leaf_name == "(root)" {
        si = si + 1
        continue
      }
      total_samples = total_samples + 1L
      total_us = total_us + dt
      if !sym_seen.contains(leaf_name) {
        sym_seen.set(leaf_name, true)
        sym_order.push(leaf_name)
      }
      let prev_ss = match self_s.get(leaf_name) { Some(v) => v; None => 0L }
      self_s.set(leaf_name, prev_ss + 1L)
      let prev_su = match self_u.get(leaf_name) { Some(v) => v; None => 0L }
      self_u.set(leaf_name, prev_su + dt)

      // Walk ancestors for cumulative attribution (dedup recursive frames per sample)
      let visited : Map[String, Bool] = Map([])
      let mut cur = nid
      let mut depth = 0
      while depth < 128 {
        let nm = match node_name.get(cur) { Some(x) => x; None => "" }
        if nm.length() > 0 && nm != "(root)" && nm != "(idle)" && !visited.contains(nm) {
          visited.set(nm, true)
          if !sym_seen.contains(nm) {
            sym_seen.set(nm, true)
            sym_order.push(nm)
          }
          let prev_cs = match cum_s.get(nm) { Some(v) => v; None => 0L }
          cum_s.set(nm, prev_cs + 1L)
          let prev_cu = match cum_u.get(nm) { Some(v) => v; None => 0L }
          cum_u.set(nm, prev_cu + dt)
        }
        match parent_of.get(cur) {
          Some(p) =>
          if p == cur {
            break
          } else {
            cur = p
          }
          None => break
        }
        depth = depth + 1
      }
      si = si + 1
    }
  } else {
    ni = 0
    while ni < nodes.length() {
      let nd = nodes[ni]
      if nd.hit_count > 0L {
        let nm = match node_name.get(nd.id) { Some(x) => x; None => "(unknown)" }
        if nm != "(idle)" && nm != "(root)" {
          total_samples = total_samples + nd.hit_count
          total_us = total_us + nd.hit_count
          if !sym_seen.contains(nm) {
            sym_seen.set(nm, true)
            sym_order.push(nm)
          }
          let prev_ss = match self_s.get(nm) { Some(v) => v; None => 0L }
          self_s.set(nm, prev_ss + nd.hit_count)
          let prev_su = match self_u.get(nm) { Some(v) => v; None => 0L }
          self_u.set(nm, prev_su + nd.hit_count)
          let visited : Map[String, Bool] = Map([])
          let mut cur = nd.id
          let mut depth = 0
          while depth < 128 {
            let anm = match node_name.get(cur) { Some(x) => x; None => "" }
            if anm.length() > 0 && anm != "(root)" && anm != "(idle)" && !visited.contains(anm) {
              visited.set(anm, true)
              if !sym_seen.contains(anm) {
                sym_seen.set(anm, true)
                sym_order.push(anm)
              }
              let prev_cs = match cum_s.get(anm) { Some(v) => v; None => 0L }
              cum_s.set(anm, prev_cs + nd.hit_count)
              let prev_cu = match cum_u.get(anm) { Some(v) => v; None => 0L }
              cum_u.set(anm, prev_cu + nd.hit_count)
            }
            match parent_of.get(cur) {
              Some(p) =>
              if p == cur {
                break
              } else {
                cur = p
              }
              None => break
            }
            depth = depth + 1
          }
        }
      }
      ni = ni + 1
    }
  }

  let funcs : Array[ProfCpuFunc] = []
  let mut fi = 0
  while fi < sym_order.length() {
    let raw_sym = sym_order[fi]
    funcs.push(ProfCpuFunc::{
      raw_sym: raw_sym,
      self_samples: match self_s.get(raw_sym) { Some(v) => v; None => 0L },
      cum_samples: match cum_s.get(raw_sym) { Some(v) => v; None => 0L },
      self_us: match self_u.get(raw_sym) { Some(v) => v; None => 0L },
      cum_us: match cum_u.get(raw_sym) { Some(v) => v; None => 0L },
    })
    fi = fi + 1
  }
  Ok(ProfCpuData::{
    total_samples: total_samples,
    total_us: total_us,
    stack_mode: "full",
    funcs: funcs,
  })
}

///|
fn prof_resolve_frame_token(
  tok : String,
  st : Option[SymTab],
  has_slide : Bool,
  slide : Int64,
) -> String {
  if tok.starts_with("sym:") {
    return slice_str(tok, 4, tok.length())
  }
  if tok == "0" || tok == "0x0" || tok.length() == 0 {
    return ""
  }
  match prof_parse_hex_i64(tok) {
    Some(pc) =>
    if pc == 0L {
      ""
    } else {
      match st {
        Some(symtab) =>
        if has_slide {
          match symtab_resolve(symtab, pc, slide) {
            Some(m) => m.name
            None => "[external]"
          }
        } else {
          match symtab_resolve(symtab, pc, 0L) {
            Some(m) => m.name
            None => "[external]"
          }
        }
        None => tok
      }
    }
    None => tok
  }
}

///|
fn prof_is_container_grow_sym(raw : String) -> Bool {
  let norm = dm_strip_leading(raw)
  norm == "pion_arr_grow" ||
  norm == "pion_arr_push_flat_grow" ||
  norm == "pion_map_grow" ||
  norm == "pion_strbuf_grow" ||
  norm.starts_with("pion_arr_grow") ||
  norm.starts_with("pion_map_grow") ||
  norm.starts_with("pion_strbuf_grow")
}

///|
struct FuncAcc {
  raw_sym : String
  mut self_cpu_samples : Int64
  mut cum_cpu_samples : Int64
  mut has_cum_cpu : Bool
  mut self_alloc_bytes : Int64
  mut cum_alloc_bytes : Int64
  mut alloc_count : Int64
  mut inuse_bytes : Int64
  mut rc_ops : Int64
}

///|
fn prof_get_or_add_func(
  accs : Array[FuncAcc],
  idx_map : Map[String, Int],
  raw_sym : String,
) -> Int {
  let key = if raw_sym.length() == 0 { "[unknown]" } else { raw_sym }
  match idx_map.get(key) {
    Some(i) => i
    None => {
      let i = accs.length()
      idx_map.set(key, i)
      accs.push(FuncAcc::{
        raw_sym: key,
        self_cpu_samples: 0L,
        cum_cpu_samples: 0L,
        has_cum_cpu: false,
        self_alloc_bytes: 0L,
        cum_alloc_bytes: 0L,
        alloc_count: 0L,
        inuse_bytes: 0L,
        rc_ops: 0L,
      })
      i
    }
  }
}

///|
struct BackingSiteAcc {
  name : String
  file : String
  line : Int
  mut bytes : Int64
  mut count : Int64
}

///|
fn prof_backing_site_higher(a : ProfBackingSite, b : ProfBackingSite) -> Bool {
  if a.bytes != b.bytes {
    return a.bytes > b.bytes
  }
  if a.count != b.count {
    return a.count > b.count
  }
  if a.name != b.name {
    return a.name < b.name
  }
  if a.file != b.file {
    return a.file < b.file
  }
  a.line < b.line
}

///|
fn prof_sort_backing_sites(
  sites : Array[ProfBackingSite],
  limit : Int,
) -> Array[ProfBackingSite] {
  let n = sites.length()
  let out : Array[ProfBackingSite] = []
  let mut i = 0
  while i < n {
    out.push(sites[i])
    i = i + 1
  }
  i = 1
  while i < n {
    let cur = out[i]
    let mut j = i - 1
    while j >= 0 && prof_backing_site_higher(cur, out[j]) {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  if limit > 0 && limit < out.length() {
    let trimmed : Array[ProfBackingSite] = []
    let mut k = 0
    while k < limit {
      trimmed.push(out[k])
      k = k + 1
    }
    trimmed
  } else {
    out
  }
}

///|
fn prof_fmt_1dp(v : Double) -> String {
  let neg = v < 0.0
  let av = if neg { 0.0 - v } else { v }
  let scaled = (av * 10.0 + 0.5).to_int64()
  let whole = scaled / 10L
  let frac = scaled % 10L
  (if neg { "-" } else { "" }) + whole.to_string() + "." + frac.to_string()
}

///|
fn prof_fmt_kb(bytes : Int64) -> String {
  prof_fmt_1dp(bytes.to_double() / 1024.0)
}

///|
fn prof_format_site_loc(s : ProfBackingSite) -> String {
  if s.file.length() > 0 && s.line > 0 {
    s.file + ":" + s.line.to_string() + " " + s.name
  } else if s.file.length() > 0 {
    s.file + " " + s.name
  } else {
    s.name
  }
}

///|
fn prof_pct_i64(num : Int64, den : Int64) -> Double {
  if den <= 0L {
    0.0
  } else {
    (num.to_double() * 100.0) / den.to_double()
  }
}

///|
fn prof_func_key_val(f : ProfFuncEntry, sort_by : String) -> Double {
  if sort_by == "alloc_bytes" {
    f.self_alloc_bytes.to_double()
  } else if sort_by == "cum_alloc_bytes" {
    f.cum_alloc_bytes.to_double()
  } else if sort_by == "alloc_count" {
    f.alloc_count.to_double()
  } else if sort_by == "inuse_bytes" {
    f.inuse_bytes.to_double()
  } else if sort_by == "rc_ops" || sort_by == "rc" {
    f.rc_ops.to_double()
  } else if sort_by == "cum_cpu" || sort_by == "cum" {
    match f.cum_cpu_pct {
      Some(v) => v
      None => f.self_cpu_pct
    }
  } else {
    f.self_cpu_pct
  }
}

///|
fn prof_func_higher(a : ProfFuncEntry, b : ProfFuncEntry, sort_by : String) -> Bool {
  let ka = prof_func_key_val(a, sort_by)
  let kb = prof_func_key_val(b, sort_by)
  if ka != kb {
    return ka > kb
  }
  if a.self_alloc_bytes != b.self_alloc_bytes {
    return a.self_alloc_bytes > b.self_alloc_bytes
  }
  if a.rc_ops != b.rc_ops {
    return a.rc_ops > b.rc_ops
  }
  a.raw_sym < b.raw_sym
}

///|
fn prof_sort_funcs(funcs : Array[ProfFuncEntry], sort_by : String) -> Array[ProfFuncEntry] {
  let n = funcs.length()
  let out : Array[ProfFuncEntry] = []
  let mut i = 0
  while i < n {
    out.push(funcs[i])
    i = i + 1
  }
  // Simple insertion sort (function lists in profile reports are compact, deterministic)
  i = 1
  while i < n {
    let cur = out[i]
    let mut j = i - 1
    while j >= 0 && prof_func_higher(cur, out[j], sort_by) {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = cur
    i = i + 1
  }
  out
}

///|
/// Builds a unified `ProfReport` from raw profile data, optional native SymTab,
/// optional compile-time sidecar map, and optional V8 `.cpuprofile` data.
pub fn prof_build_report(
  raw : ProfRaw,
  st : Option[SymTab],
  sidecar : Map[String, ProfSidecarSym],
  v8_cpu : Option[ProfCpuData],
) -> ProfReport {
  let mut slide = 0L
  let mut has_slide = false
  match st {
    Some(symtab) =>
    if raw.anchor_sym.length() > 0 {
      match symtab_compute_slide(symtab, raw.anchor_sym, raw.anchor_addr) {
        Ok(sl) => {
          slide = sl
          has_slide = true
        }
        Err(_) => ()
      }
    }
    None => ()
  }

  // 1. Aggregate managed & RC domains from TAG rows
  let mut m_alloc_b = 0L
  let mut m_alloc_c = 0L
  let mut m_free_b = 0L
  let mut m_free_c = 0L
  let mut m_inuse_b = 0L
  let mut m_inuse_c = 0L
  let mut rc_inc = 0L
  let mut rc_dec = 0L
  let mut rc_ainc = 0L
  let mut rc_adec = 0L
  let mut rc_dest = 0L
  let mut rc_imm = 0L
  let mut str_alloc_b = 0L
  let mut str_alloc_c = 0L

  let mut ti = 0
  while ti < raw.tags.length() {
    let t = raw.tags[ti]
    m_alloc_b = m_alloc_b + t.alloc_bytes
    m_alloc_c = m_alloc_c + t.alloc_count
    m_free_b = m_free_b + t.free_bytes
    m_free_c = m_free_c + t.free_count
    m_inuse_b = m_inuse_b + t.inuse_bytes
    m_inuse_c = m_inuse_c + t.inuse_count
    rc_inc = rc_inc + t.rc_inc
    rc_dec = rc_dec + t.rc_dec
    rc_ainc = rc_ainc + t.rc_atomic_inc
    rc_adec = rc_adec + t.rc_atomic_dec
    rc_dest = rc_dest + t.rc_destroy
    rc_imm = rc_imm + t.rc_immortal
    if t.tag_id == 1 {
      str_alloc_b = str_alloc_b + t.alloc_bytes
      str_alloc_c = str_alloc_c + t.alloc_count
    }
    ti = ti + 1
  }

  let managed = ProfMemDomain::{
    alloc_bytes: m_alloc_b,
    alloc_count: m_alloc_c,
    free_bytes: m_free_b,
    free_count: m_free_c,
    inuse_bytes: m_inuse_b,
    inuse_count: m_inuse_c,
  }
  let backing = ProfBackingDomain::{
    alloc_bytes: raw.backing_alloc_bytes,
    alloc_count: raw.backing_alloc_count,
    free_bytes: raw.backing_free_bytes,
    inuse_bytes: raw.backing_inuse_bytes,
  }
  let allocator = ProfAllocatorDomain::{
    reserved_bytes: raw.reserved_bytes,
    peak_reserved_bytes: raw.peak_reserved_bytes,
  }
  let rc = ProfRcDomain::{
    inc: rc_inc,
    dec: rc_dec,
    atomic_inc: rc_ainc,
    atomic_dec: rc_adec,
    destroy: rc_dest,
    immortal: rc_imm,
  }

  // 2. Symbolize `by_type[]` by `(tag_id, drop_fn)`
  let by_type : Array[ProfTypeRow] = []
  let type_idx : Map[String, Int] = Map([])
  let mut tyi = 0
  while tyi < raw.types.length() {
    let tr = raw.types[tyi]
    let resolved_drop = prof_resolve_frame_token(tr.drop_fn_raw, st, has_slide, slide)
    let type_name = if resolved_drop.length() == 0 {
      if tr.tag_id == 4 || tr.tag_id == 5 {
        tr.tag_name + " (no-drop)"
      } else {
        tr.tag_name
      }
    } else {
      let drop_ty = demangle_drop_type_name(resolved_drop)
      if drop_ty.length() > 0 {
        tr.tag_name + " " + drop_ty
      } else {
        let dm = demangle_symbol_with_sidecar(resolved_drop, sidecar)
        tr.tag_name + " " + dm.pretty
      }
    }
    let key = tr.tag_id.to_string() + ":" + resolved_drop
    match type_idx.get(key) {
      Some(idx) => {
        let prev = by_type[idx]
        by_type[idx] = ProfTypeRow::{
          tag_id: prev.tag_id,
          tag_name: prev.tag_name,
          drop_fn_raw: prev.drop_fn_raw,
          type_name: prev.type_name,
          alloc_count: prev.alloc_count + tr.alloc_count,
          alloc_bytes: prev.alloc_bytes + tr.alloc_bytes,
          free_count: prev.free_count + tr.free_count,
          free_bytes: prev.free_bytes + tr.free_bytes,
          inuse_count: prev.inuse_count + tr.inuse_count,
          inuse_bytes: prev.inuse_bytes + tr.inuse_bytes,
        }
      }
      None => {
        type_idx.set(key, by_type.length())
        by_type.push(ProfTypeRow::{
          tag_id: tr.tag_id,
          tag_name: tr.tag_name,
          drop_fn_raw: resolved_drop,
          type_name,
          alloc_count: tr.alloc_count,
          alloc_bytes: tr.alloc_bytes,
          free_count: tr.free_count,
          free_bytes: tr.free_bytes,
          inuse_count: tr.inuse_count,
          inuse_bytes: tr.inuse_bytes,
        })
      }
    }
    tyi = tyi + 1
  }

  // 3. Aggregate per-function CPU, alloc: alloc, inuse: inuse, RC, and backing grow churn
  let accs : Array[FuncAcc] = []
  let idx_map : Map[String, Int] = Map([])
  let mut total_cpu_samples = 0L
  let mut cpu_stack_mode = raw.cpu_stack_mode

  match v8_cpu {
    Some(vc) => {
      cpu_stack_mode = vc.stack_mode
      total_cpu_samples = vc.total_samples
      let mut vi = 0
      while vi < vc.funcs.length() {
        let vf = vc.funcs[vi]
        let idx = prof_get_or_add_func(accs, idx_map, vf.raw_sym)
        accs[idx].self_cpu_samples = accs[idx].self_cpu_samples + vf.self_samples
        accs[idx].cum_cpu_samples = accs[idx].cum_cpu_samples + vf.cum_samples
        accs[idx].has_cum_cpu = true
        vi = vi + 1
      }
    }
    None => {
      let mut ci = 0
      while ci < raw.cpu_pcs.length() {
        let cp = raw.cpu_pcs[ci]
        let sym = prof_resolve_frame_token(cp.pc_token, st, has_slide, slide)
        let idx = prof_get_or_add_func(accs, idx_map, sym)
        accs[idx].self_cpu_samples = accs[idx].self_cpu_samples + cp.count
        total_cpu_samples = total_cpu_samples + cp.count
        ci = ci + 1
      }
    }
  }

  let mut container_grow_bytes = 0L
  let grow_sites : Array[BackingSiteAcc] = []
  let grow_site_idx : Map[String, Int] = Map([])
  let mut si = 0
  while si < raw.stacks.length() {
    let stk = raw.stacks[si]
    let resolved_frames : Array[String] = []
    let mut fi = 0
    while fi < stk.frames.length() {
      let sym = prof_resolve_frame_token(stk.frames[fi], st, has_slide, slide)
      if sym.length() > 0 {
        resolved_frames.push(sym)
      }
      fi = fi + 1
    }
    if stk.kind == "backing" {
      let mut is_grow = false
      fi = 0
      while fi < resolved_frames.length() {
        if prof_is_container_grow_sym(resolved_frames[fi]) {
          is_grow = true
          break
        }
        fi = fi + 1
      }
      if is_grow {
        container_grow_bytes = container_grow_bytes + stk.bytes
        let mut attr_sym = resolved_frames[0]
        fi = 0
        while fi < resolved_frames.length() {
          let cand = resolved_frames[fi]
          let cdm = demangle_symbol_with_sidecar(cand, sidecar)
          if cdm.category == "user" {
            attr_sym = cand
            break
          }
          fi = fi + 1
        }
        let adm = demangle_symbol_with_sidecar(attr_sym, sidecar)
        let site_key = adm.pretty + "|" + adm.file + "|" + adm.line.to_string()
        match grow_site_idx.get(site_key) {
          Some(gi) => {
            grow_sites[gi].bytes = grow_sites[gi].bytes + stk.bytes
            grow_sites[gi].count = grow_sites[gi].count + stk.count
          }
          None => {
            grow_site_idx.set(site_key, grow_sites.length())
            grow_sites.push(BackingSiteAcc::{
              name: adm.pretty,
              file: adm.file,
              line: adm.line,
              bytes: stk.bytes,
              count: stk.count,
            })
          }
        }
      }
    } else if resolved_frames.length() > 0 {
      // Attribute alloc/inuse/rc self-cost to the first user frame on the stack
      // (falling back to leaf frame 0 when no user frame is present) so
      // `top_functions` and `profile diff` pinpoint user callsites rather than
      // burying everything under `pion_alloc_uninit` / `pion_rc_inc`.
      let mut attr_sym = resolved_frames[0]
      fi = 0
      while fi < resolved_frames.length() {
        let cand = resolved_frames[fi]
        let cdm = demangle_symbol_with_sidecar(cand, sidecar)
        if cdm.category == "user" {
          attr_sym = cand
          break
        }
        fi = fi + 1
      }
      let attr_idx = prof_get_or_add_func(accs, idx_map, attr_sym)
      if stk.kind == "alloc" {
        accs[attr_idx].self_alloc_bytes = accs[attr_idx].self_alloc_bytes + stk.bytes
        accs[attr_idx].alloc_count = accs[attr_idx].alloc_count + stk.count
        let seen_f : Map[String, Bool] = Map([])
        fi = 0
        while fi < resolved_frames.length() {
          let fnm = resolved_frames[fi]
          if !seen_f.contains(fnm) {
            seen_f.set(fnm, true)
            let fidx = prof_get_or_add_func(accs, idx_map, fnm)
            accs[fidx].cum_alloc_bytes = accs[fidx].cum_alloc_bytes + stk.bytes
          }
          fi = fi + 1
        }
      } else if stk.kind == "inuse" {
        accs[attr_idx].inuse_bytes = accs[attr_idx].inuse_bytes + stk.bytes
      } else if stk.kind == "rc" {
        accs[attr_idx].rc_ops = accs[attr_idx].rc_ops + stk.count
      }
    }
    si = si + 1
  }

  let top_functions : Array[ProfFuncEntry] = []
  let mut runtime_mem_cpu_pct = 0.0
  let mut max_rc_ops = 0L
  let mut max_rc_name = ""
  let mut ai = 0
  while ai < accs.length() {
    let a = accs[ai]
    let dm = demangle_symbol_with_sidecar(a.raw_sym, sidecar)
    let self_pct = prof_pct_i64(a.self_cpu_samples, total_cpu_samples)
    let cum_pct : Option[Double] = if cpu_stack_mode == "full" && a.has_cum_cpu {
      Some(prof_pct_i64(a.cum_cpu_samples, total_cpu_samples))
    } else {
      None
    }
    if dm.category == "runtime_mem" {
      runtime_mem_cpu_pct = runtime_mem_cpu_pct + self_pct
    }
    if a.rc_ops > max_rc_ops {
      max_rc_ops = a.rc_ops
      max_rc_name = dm.pretty
    }
    top_functions.push(ProfFuncEntry::{
      raw_sym: a.raw_sym,
      name: dm.pretty,
      category: dm.category,
      pkg: dm.pkg,
      file: dm.file,
      line: dm.line,
      self_cpu_samples: a.self_cpu_samples,
      self_cpu_pct: self_pct,
      cum_cpu_pct: cum_pct,
      self_alloc_bytes: a.self_alloc_bytes,
      cum_alloc_bytes: a.cum_alloc_bytes,
      alloc_count: a.alloc_count,
      inuse_bytes: a.inuse_bytes,
      rc_ops: a.rc_ops,
    })
    ai = ai + 1
  }

  let sorted_fns = prof_sort_funcs(top_functions, "cpu")
  let raw_backing_sites : Array[ProfBackingSite] = []
  let mut bsi = 0
  while bsi < grow_sites.length() {
    let gs = grow_sites[bsi]
    raw_backing_sites.push(ProfBackingSite::{
      name: gs.name,
      file: gs.file,
      line: gs.line,
      bytes: gs.bytes,
      count: gs.count,
      share_pct: prof_pct_i64(gs.bytes, container_grow_bytes),
    })
    bsi = bsi + 1
  }
  let backing_top_sites = prof_sort_backing_sites(raw_backing_sites, 5)

  // 4. Generate threshold-gated `hints[]` (RFC v2 §1.6)
  let hints : Array[ProfHint] = []
  let cpu_enabled = (raw.modes & 1) != 0
  let alloc_enabled = (raw.modes & 2) != 0
  let cpu_low = cpu_enabled && total_cpu_samples < 100L
  let alloc_low = alloc_enabled && managed.alloc_count < 1000L

  if cpu_low {
    hints.push(ProfHint::{
      code: "H_LOW_SAMPLES",
      severity: "info",
      target: "cpu",
      message: "CPU sample count is below 100; causal CPU hints are suppressed to avoid noise",
      evidence: ProfHintEvidence::{
        metric: "cpu_samples",
        value: total_cpu_samples.to_double(),
        threshold: 100.0,
        samples: total_cpu_samples,
      },
      suggested_cmd: "pionc run --profile=cpu -- <args> (run a longer workload)",
    })
  }
  if alloc_low {
    hints.push(ProfHint::{
      code: "H_LOW_SAMPLES",
      severity: "info",
      target: "alloc",
      message: "Managed allocation count is below 1000; causal allocation hints are suppressed to avoid noise",
      evidence: ProfHintEvidence::{
        metric: "alloc_count",
        value: managed.alloc_count.to_double(),
        threshold: 1000.0,
        samples: managed.alloc_count,
      },
      suggested_cmd: "pionc run --profile=alloc -- <args> (increase workload iterations)",
    })
  }

  // H_HIGH_RUNTIME_MEM_CALLS
  if !cpu_low && total_cpu_samples >= 100L && runtime_mem_cpu_pct >= 20.0 {
    hints.push(ProfHint::{
      code: "H_HIGH_RUNTIME_MEM_CALLS",
      severity: "high",
      target: "runtime_mem",
      message: "Runtime memory allocator calls account for >= 20% of CPU samples (note: inline RC in release mode is attributed to user functions)",
      evidence: ProfHintEvidence::{
        metric: "runtime_mem_cpu_pct",
        value: runtime_mem_cpu_pct,
        threshold: 20.0,
        samples: total_cpu_samples,
      },
      suggested_cmd: "pionc profile summary --sort alloc_bytes <profile.json>",
    })
  }

  // H_STRING_ALLOC_STORM
  if !alloc_low && (managed.alloc_bytes >= 1048576L || managed.alloc_count >= 10000L) {
    let str_share = if managed.alloc_bytes > 0L {
      prof_pct_i64(str_alloc_b, managed.alloc_bytes)
    } else {
      prof_pct_i64(str_alloc_c, managed.alloc_count)
    }
    if str_share >= 45.0 {
      hints.push(ProfHint::{
        code: "H_STRING_ALLOC_STORM",
        severity: "high",
        target: "String",
        message: "String allocations dominate managed memory (>= 45%); consider StringBuilder or StrView slicing",
        evidence: ProfHintEvidence::{
          metric: "string_alloc_share_pct",
          value: str_share,
          threshold: 45.0,
          samples: str_alloc_c,
        },
        suggested_cmd: "pionc profile summary --sort alloc_bytes <profile.json>",
      })
    }
  }

  // H_CONTAINER_GROW_CHURN
  if container_grow_bytes >= 262144L && backing.alloc_bytes > 0L {
    let grow_share = prof_pct_i64(container_grow_bytes, backing.alloc_bytes)
    if grow_share >= 30.0 {
      let mut grow_msg = "Container growth (Array/Map/StrBuf) accounts for >= 30% of backing buffer allocations; pre-size or reuse buffers"
      if backing_top_sites.length() > 0 {
        let top_site = backing_top_sites[0]
        grow_msg = grow_msg +
        " (top site: " +
        prof_format_site_loc(top_site) +
        " — " +
        prof_fmt_kb(top_site.bytes) +
        " KB, " +
        prof_fmt_1dp(top_site.share_pct) +
        "%, " +
        top_site.count.to_string() +
        " calls)"
      }
      hints.push(ProfHint::{
        code: "H_CONTAINER_GROW_CHURN",
        severity: "high",
        target: "backing",
        message: grow_msg,
        evidence: ProfHintEvidence::{
          metric: "container_grow_backing_pct",
          value: grow_share,
          threshold: 30.0,
          samples: backing.alloc_count,
        },
        suggested_cmd: "pionc profile summary --sort alloc_bytes <profile.json>",
      })
    }
  }

  // H_HIGH_RC_TRAFFIC
  let rc_total = rc.inc + rc.dec + rc.atomic_inc + rc.atomic_dec + rc.destroy
  if rc_total >= 100000L && max_rc_ops > 0L {
    let top_rc_share = prof_pct_i64(max_rc_ops, rc_total)
    if top_rc_share >= 25.0 {
      hints.push(ProfHint::{
        code: "H_HIGH_RC_TRAFFIC",
        severity: "high",
        target: max_rc_name,
        message: "A single function accounts for >= 25% of total RC traffic (>= 100k ops); consider borrowing or value structs",
        evidence: ProfHintEvidence::{
          metric: "top_fn_rc_share_pct",
          value: top_rc_share,
          threshold: 25.0,
          samples: rc_total,
        },
        suggested_cmd: "pionc profile summary --sort rc_ops <profile.json>",
      })
    }
  }

  // H_HIGH_ALLOCATOR_OVERHEAD
  let total_inuse = managed.inuse_bytes + backing.inuse_bytes
  if allocator.peak_reserved_bytes >= 4194304L &&
  total_inuse > 0L &&
  allocator.peak_reserved_bytes >= 2L * total_inuse {
    let ratio = allocator.peak_reserved_bytes.to_double() / total_inuse.to_double()
    hints.push(ProfHint::{
      code: "H_HIGH_ALLOCATOR_OVERHEAD",
      severity: "high",
      target: "allocator",
      message: "Peak allocator reserved memory is >= 2x live in-use bytes (>= 4 MiB); indicates slab/arena fragmentation or transient spikes",
      evidence: ProfHintEvidence::{
        metric: "peak_reserved_to_inuse_ratio",
        value: ratio,
        threshold: 2.0,
        samples: managed.inuse_count,
      },
      suggested_cmd: "pionc run --profile=alloc --retained -- <args>",
    })
  }

  let rc_partial = (raw.modes & 4) != 0 && (raw.build_modes & 4) == 0
  let eff_interval_us = if raw.hz > 0 { 1000000L / raw.hz.to_int64() } else { 0L }

  ProfReport::{
    schema_version: 1,
    target: raw.target,
    modes: raw.modes,
    build_modes: raw.build_modes,
    cpu_stack_mode,
    rc_partial,
    sample_rate: raw.sample_rate,
    effective_cpu_interval_us: eff_interval_us,
    retained: raw.retained,
    retained_truncated: raw.retained_truncated,
    dropped_samples: ProfDropped::{
      cpu: raw.dropped_cpu,
      alloc: raw.dropped_alloc,
      rc: raw.dropped_rc,
    },
    wall_ms: raw.wall_us.to_double() / 1000.0,
    cpu_ms: raw.cpu_us.to_double() / 1000.0,
    peak_rss_kb: raw.peak_rss_kb,
    total_cpu_samples,
    managed,
    backing,
    allocator,
    rc,
    by_type_tag: raw.tags,
    by_type,
    top_functions: sorted_fns,
    backing_top_sites,
    hints,
  }
}

///|
fn prof_bool_json(b : Bool) -> String {
  if b { "true" } else { "false" }
}

///|
/// Serializes a `ProfReport` to RFC v2 §1.6 `schema_version: 1` JSON.
pub fn prof_report_to_json(rep : ProfReport, top_n : Int, sort_by : String) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"schema_version\":")
  sb.write_string(rep.schema_version.to_string())
  sb.write_string(",\"target\":")
  sb.write_string(json_quote(rep.target))
  sb.write_string(",\"modes\":")
  sb.write_string(rep.modes.to_string())
  sb.write_string(",\"build_modes\":")
  sb.write_string(rep.build_modes.to_string())
  sb.write_string(",\"cpu_stack_mode\":")
  sb.write_string(json_quote(rep.cpu_stack_mode))
  sb.write_string(",\"rc_partial\":")
  sb.write_string(prof_bool_json(rep.rc_partial))
  sb.write_string(",\"sample_rate\":")
  sb.write_string(rep.sample_rate.to_string())
  sb.write_string(",\"effective_cpu_interval_us\":")
  sb.write_string(rep.effective_cpu_interval_us.to_string())
  sb.write_string(",\"retained\":")
  sb.write_string(prof_bool_json(rep.retained))
  sb.write_string(",\"retained_truncated\":")
  sb.write_string(prof_bool_json(rep.retained_truncated))
  sb.write_string(",\"dropped_samples\":{\"cpu\":")
  sb.write_string(rep.dropped_samples.cpu.to_string())
  sb.write_string(",\"alloc\":")
  sb.write_string(rep.dropped_samples.alloc.to_string())
  sb.write_string(",\"rc\":")
  sb.write_string(rep.dropped_samples.rc.to_string())
  sb.write_string("},\"wall_ms\":")
  sb.write_string(rep.wall_ms.to_string())
  sb.write_string(",\"cpu_ms\":")
  sb.write_string(rep.cpu_ms.to_string())
  sb.write_string(",\"peak_rss_kb\":")
  sb.write_string(rep.peak_rss_kb.to_string())
  sb.write_string(",\"total_cpu_samples\":")
  sb.write_string(rep.total_cpu_samples.to_string())

  sb.write_string(",\"managed\":{\"alloc_bytes\":")
  sb.write_string(rep.managed.alloc_bytes.to_string())
  sb.write_string(",\"alloc_count\":")
  sb.write_string(rep.managed.alloc_count.to_string())
  sb.write_string(",\"free_bytes\":")
  sb.write_string(rep.managed.free_bytes.to_string())
  sb.write_string(",\"free_count\":")
  sb.write_string(rep.managed.free_count.to_string())
  sb.write_string(",\"inuse_bytes\":")
  sb.write_string(rep.managed.inuse_bytes.to_string())
  sb.write_string(",\"inuse_count\":")
  sb.write_string(rep.managed.inuse_count.to_string())

  sb.write_string("},\"backing\":{\"alloc_bytes\":")
  sb.write_string(rep.backing.alloc_bytes.to_string())
  sb.write_string(",\"alloc_count\":")
  sb.write_string(rep.backing.alloc_count.to_string())
  sb.write_string(",\"free_bytes\":")
  sb.write_string(rep.backing.free_bytes.to_string())
  sb.write_string(",\"inuse_bytes\":")
  sb.write_string(rep.backing.inuse_bytes.to_string())

  sb.write_string("},\"allocator\":{\"reserved_bytes\":")
  sb.write_string(rep.allocator.reserved_bytes.to_string())
  sb.write_string(",\"peak_reserved_bytes\":")
  sb.write_string(rep.allocator.peak_reserved_bytes.to_string())

  sb.write_string("},\"rc\":{\"inc\":")
  sb.write_string(rep.rc.inc.to_string())
  sb.write_string(",\"dec\":")
  sb.write_string(rep.rc.dec.to_string())
  sb.write_string(",\"atomic_inc\":")
  sb.write_string(rep.rc.atomic_inc.to_string())
  sb.write_string(",\"atomic_dec\":")
  sb.write_string(rep.rc.atomic_dec.to_string())
  sb.write_string(",\"destroy\":")
  sb.write_string(rep.rc.destroy.to_string())
  sb.write_string(",\"immortal\":")
  sb.write_string(rep.rc.immortal.to_string())

  sb.write_string("},\"by_type_tag\":[")
  let mut i = 0
  while i < rep.by_type_tag.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let t = rep.by_type_tag[i]
    sb.write_string("{\"tag_id\":")
    sb.write_string(t.tag_id.to_string())
    sb.write_string(",\"tag_name\":")
    sb.write_string(json_quote(t.tag_name))
    sb.write_string(",\"alloc_count\":")
    sb.write_string(t.alloc_count.to_string())
    sb.write_string(",\"alloc_bytes\":")
    sb.write_string(t.alloc_bytes.to_string())
    sb.write_string(",\"free_count\":")
    sb.write_string(t.free_count.to_string())
    sb.write_string(",\"free_bytes\":")
    sb.write_string(t.free_bytes.to_string())
    sb.write_string(",\"inuse_count\":")
    sb.write_string(t.inuse_count.to_string())
    sb.write_string(",\"inuse_bytes\":")
    sb.write_string(t.inuse_bytes.to_string())
    sb.write_string(",\"rc_inc\":")
    sb.write_string(t.rc_inc.to_string())
    sb.write_string(",\"rc_dec\":")
    sb.write_string(t.rc_dec.to_string())
    sb.write_string(",\"rc_atomic_inc\":")
    sb.write_string(t.rc_atomic_inc.to_string())
    sb.write_string(",\"rc_atomic_dec\":")
    sb.write_string(t.rc_atomic_dec.to_string())
    sb.write_string(",\"rc_destroy\":")
    sb.write_string(t.rc_destroy.to_string())
    sb.write_string(",\"rc_immortal\":")
    sb.write_string(t.rc_immortal.to_string())
    sb.write_char('}')
    i = i + 1
  }

  sb.write_string("],\"by_type\":[")
  i = 0
  while i < rep.by_type.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let t = rep.by_type[i]
    sb.write_string("{\"tag_id\":")
    sb.write_string(t.tag_id.to_string())
    sb.write_string(",\"tag_name\":")
    sb.write_string(json_quote(t.tag_name))
    sb.write_string(",\"drop_fn_raw\":")
    sb.write_string(json_quote(t.drop_fn_raw))
    sb.write_string(",\"type_name\":")
    sb.write_string(json_quote(t.type_name))
    sb.write_string(",\"alloc_count\":")
    sb.write_string(t.alloc_count.to_string())
    sb.write_string(",\"alloc_bytes\":")
    sb.write_string(t.alloc_bytes.to_string())
    sb.write_string(",\"free_count\":")
    sb.write_string(t.free_count.to_string())
    sb.write_string(",\"free_bytes\":")
    sb.write_string(t.free_bytes.to_string())
    sb.write_string(",\"inuse_count\":")
    sb.write_string(t.inuse_count.to_string())
    sb.write_string(",\"inuse_bytes\":")
    sb.write_string(t.inuse_bytes.to_string())
    sb.write_char('}')
    i = i + 1
  }

  let sorted = prof_sort_funcs(rep.top_functions, sort_by)
  let lim = if top_n > 0 && top_n < sorted.length() { top_n } else { sorted.length() }
  sb.write_string("],\"top_functions\":[")
  i = 0
  while i < lim {
    if i > 0 {
      sb.write_char(',')
    }
    let f = sorted[i]
    sb.write_string("{\"raw_sym\":")
    sb.write_string(json_quote(f.raw_sym))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(f.name))
    sb.write_string(",\"category\":")
    sb.write_string(json_quote(f.category))
    sb.write_string(",\"pkg\":")
    sb.write_string(json_quote(f.pkg))
    sb.write_string(",\"file\":")
    sb.write_string(json_quote(f.file))
    sb.write_string(",\"line\":")
    sb.write_string(f.line.to_string())
    sb.write_string(",\"self_cpu_samples\":")
    sb.write_string(f.self_cpu_samples.to_string())
    sb.write_string(",\"self_cpu_pct\":")
    sb.write_string(f.self_cpu_pct.to_string())
    sb.write_string(",\"cum_cpu_pct\":")
    match f.cum_cpu_pct {
      Some(v) => sb.write_string(v.to_string())
      None => sb.write_string("null")
    }
    sb.write_string(",\"self_alloc_bytes\":")
    sb.write_string(f.self_alloc_bytes.to_string())
    sb.write_string(",\"cum_alloc_bytes\":")
    sb.write_string(f.cum_alloc_bytes.to_string())
    sb.write_string(",\"alloc_count\":")
    sb.write_string(f.alloc_count.to_string())
    sb.write_string(",\"inuse_bytes\":")
    sb.write_string(f.inuse_bytes.to_string())
    sb.write_string(",\"rc_ops\":")
    sb.write_string(f.rc_ops.to_string())
    sb.write_char('}')
    i = i + 1
  }

  sb.write_string("],\"backing_top_sites\":[")
  i = 0
  while i < rep.backing_top_sites.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let s = rep.backing_top_sites[i]
    sb.write_string("{\"name\":")
    sb.write_string(json_quote(s.name))
    sb.write_string(",\"file\":")
    sb.write_string(json_quote(s.file))
    sb.write_string(",\"line\":")
    sb.write_string(s.line.to_string())
    sb.write_string(",\"bytes\":")
    sb.write_string(s.bytes.to_string())
    sb.write_string(",\"count\":")
    sb.write_string(s.count.to_string())
    sb.write_string(",\"share_pct\":")
    sb.write_string(s.share_pct.to_string())
    sb.write_char('}')
    i = i + 1
  }

  sb.write_string("],\"hints\":[")
  i = 0
  while i < rep.hints.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let h = rep.hints[i]
    sb.write_string("{\"code\":")
    sb.write_string(json_quote(h.code))
    sb.write_string(",\"severity\":")
    sb.write_string(json_quote(h.severity))
    sb.write_string(",\"target\":")
    sb.write_string(json_quote(h.target))
    sb.write_string(",\"message\":")
    sb.write_string(json_quote(h.message))
    sb.write_string(",\"evidence\":{\"metric\":")
    sb.write_string(json_quote(h.evidence.metric))
    sb.write_string(",\"value\":")
    sb.write_string(h.evidence.value.to_string())
    sb.write_string(",\"threshold\":")
    sb.write_string(h.evidence.threshold.to_string())
    sb.write_string(",\"samples\":")
    sb.write_string(h.evidence.samples.to_string())
    sb.write_string("},\"suggested_cmd\":")
    sb.write_string(json_quote(h.suggested_cmd))
    sb.write_char('}')
    i = i + 1
  }
  sb.write_string("]}")
  sb.to_string()
}

///|
/// Formats a `ProfReport` as human-readable text summary.
pub fn prof_report_to_text(rep : ProfReport, top_n : Int, sort_by : String) -> String {
  let sb = StringBuilder()
  sb.write_string("Profile Summary (target=")
  sb.write_string(rep.target)
  sb.write_string(", modes=")
  sb.write_string(rep.modes.to_string())
  sb.write_string(", cpu_stack_mode=")
  sb.write_string(rep.cpu_stack_mode)
  sb.write_string(")\n")
  sb.write_string("  wall_ms=")
  sb.write_string(rep.wall_ms.to_string())
  sb.write_string("  cpu_ms=")
  sb.write_string(rep.cpu_ms.to_string())
  sb.write_string("  peak_rss_kb=")
  sb.write_string(rep.peak_rss_kb.to_string())
  sb.write_string("  cpu_samples=")
  sb.write_string(rep.total_cpu_samples.to_string())
  sb.write_string("\n")
  sb.write_string("  managed: alloc=")
  sb.write_string(rep.managed.alloc_bytes.to_string())
  sb.write_string("B (")
  sb.write_string(rep.managed.alloc_count.to_string())
  sb.write_string(") free=")
  sb.write_string(rep.managed.free_bytes.to_string())
  sb.write_string("B inuse=")
  sb.write_string(rep.managed.inuse_bytes.to_string())
  sb.write_string("B\n")
  sb.write_string("  backing: alloc=")
  sb.write_string(rep.backing.alloc_bytes.to_string())
  sb.write_string("B inuse=")
  sb.write_string(rep.backing.inuse_bytes.to_string())
  sb.write_string("B  allocator: reserved=")
  sb.write_string(rep.allocator.reserved_bytes.to_string())
  sb.write_string("B peak=")
  sb.write_string(rep.allocator.peak_reserved_bytes.to_string())
  sb.write_string("B\n")
  sb.write_string("  rc: inc=")
  sb.write_string(rep.rc.inc.to_string())
  sb.write_string(" dec=")
  sb.write_string(rep.rc.dec.to_string())
  sb.write_string(" atomic_inc=")
  sb.write_string(rep.rc.atomic_inc.to_string())
  sb.write_string(" atomic_dec=")
  sb.write_string(rep.rc.atomic_dec.to_string())
  sb.write_string(" destroy=")
  sb.write_string(rep.rc.destroy.to_string())
  sb.write_string("\n")

  let sorted = prof_sort_funcs(rep.top_functions, sort_by)
  let lim = if top_n > 0 && top_n < sorted.length() { top_n } else { sorted.length() }
  if lim > 0 {
    sb.write_string("Top Functions (sort=")
    sb.write_string(sort_by)
    sb.write_string("):\n")
    let mut i = 0
    while i < lim {
      let f = sorted[i]
      sb.write_string("  ")
      sb.write_string(f.name)
      sb.write_string(" [")
      sb.write_string(f.category)
      sb.write_string("] self_cpu=")
      sb.write_string(f.self_cpu_pct.to_string())
      sb.write_string("% alloc=")
      sb.write_string(f.self_alloc_bytes.to_string())
      sb.write_string("B rc=")
      sb.write_string(f.rc_ops.to_string())
      sb.write_string("\n")
      i = i + 1
    }
  }
  if rep.backing_top_sites.length() > 0 {
    sb.write_string("Top Backing Grow Sites:\n")
    let mut i = 0
    while i < rep.backing_top_sites.length() {
      let s = rep.backing_top_sites[i]
      sb.write_string("  ")
      sb.write_string(prof_format_site_loc(s))
      sb.write_string(" — ")
      sb.write_string(prof_fmt_kb(s.bytes))
      sb.write_string(" KB (")
      sb.write_string(prof_fmt_1dp(s.share_pct))
      sb.write_string("%, ")
      sb.write_string(s.count.to_string())
      sb.write_string(" calls)\n")
      i = i + 1
    }
  }
  if rep.hints.length() > 0 {
    sb.write_string("Hints:\n")
    let mut i = 0
    while i < rep.hints.length() {
      let h = rep.hints[i]
      sb.write_string("  [")
      sb.write_string(h.severity)
      sb.write_string("] ")
      sb.write_string(h.code)
      sb.write_string(" (")
      sb.write_string(h.target)
      sb.write_string("): ")
      sb.write_string(h.message)
      sb.write_string("\n")
      i = i + 1
    }
  }
  sb.to_string()
}

///|
fn prof_parse_tag_row_json(txt : String, pos : Array[Int], n : Int) -> Option[ProfTagRow] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut tag_id = 0
  let mut tag_name = ""
  let mut alloc_count = 0L
  let mut alloc_bytes = 0L
  let mut free_count = 0L
  let mut free_bytes = 0L
  let mut inuse_count = 0L
  let mut inuse_bytes = 0L
  let mut rc_inc = 0L
  let mut rc_dec = 0L
  let mut rc_atomic_inc = 0L
  let mut rc_atomic_dec = 0L
  let mut rc_destroy = 0L
  let mut rc_immortal = 0L
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(ProfTagRow::{
      tag_id: tag_id, tag_name: tag_name, alloc_count: alloc_count, alloc_bytes: alloc_bytes, free_count: free_count, free_bytes: free_bytes,
      inuse_count: inuse_count, inuse_bytes: inuse_bytes, rc_inc: rc_inc, rc_dec: rc_dec, rc_atomic_inc: rc_atomic_inc, rc_atomic_dec: rc_atomic_dec,
      rc_destroy: rc_destroy, rc_immortal: rc_immortal,
    })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let k = match prof_json_parse_string(txt, pos, n) { Some(s) => s; None => return None }
    if !prof_json_expect_char(txt, pos, n, 58) { return None }
    if k == "tag_id" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => tag_id = v.to_int(); None => return None }
    } else if k == "tag_name" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => tag_name = v; None => return None }
    } else if k == "alloc_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => alloc_count = v; None => return None }
    } else if k == "alloc_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => alloc_bytes = v; None => return None }
    } else if k == "free_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => free_count = v; None => return None }
    } else if k == "free_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => free_bytes = v; None => return None }
    } else if k == "inuse_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => inuse_count = v; None => return None }
    } else if k == "inuse_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => inuse_bytes = v; None => return None }
    } else if k == "rc_inc" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_inc = v; None => return None }
    } else if k == "rc_dec" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_dec = v; None => return None }
    } else if k == "rc_atomic_inc" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_atomic_inc = v; None => return None }
    } else if k == "rc_atomic_dec" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_atomic_dec = v; None => return None }
    } else if k == "rc_destroy" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_destroy = v; None => return None }
    } else if k == "rc_immortal" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_immortal = v; None => return None }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(ProfTagRow::{
    tag_id: tag_id, tag_name: tag_name, alloc_count: alloc_count, alloc_bytes: alloc_bytes, free_count: free_count, free_bytes: free_bytes,
    inuse_count: inuse_count, inuse_bytes: inuse_bytes, rc_inc: rc_inc, rc_dec: rc_dec, rc_atomic_inc: rc_atomic_inc, rc_atomic_dec: rc_atomic_dec,
    rc_destroy: rc_destroy, rc_immortal: rc_immortal,
  })
}

///|
fn prof_parse_type_row_json(txt : String, pos : Array[Int], n : Int) -> Option[ProfTypeRow] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut tag_id = 0
  let mut tag_name = ""
  let mut drop_fn_raw = ""
  let mut type_name = ""
  let mut alloc_count = 0L
  let mut alloc_bytes = 0L
  let mut free_count = 0L
  let mut free_bytes = 0L
  let mut inuse_count = 0L
  let mut inuse_bytes = 0L
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(ProfTypeRow::{
      tag_id: tag_id, tag_name: tag_name, drop_fn_raw: drop_fn_raw, type_name: type_name, alloc_count: alloc_count, alloc_bytes: alloc_bytes,
      free_count: free_count, free_bytes: free_bytes, inuse_count: inuse_count, inuse_bytes: inuse_bytes,
    })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let k = match prof_json_parse_string(txt, pos, n) { Some(s) => s; None => return None }
    if !prof_json_expect_char(txt, pos, n, 58) { return None }
    if k == "tag_id" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => tag_id = v.to_int(); None => return None }
    } else if k == "tag_name" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => tag_name = v; None => return None }
    } else if k == "drop_fn_raw" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => drop_fn_raw = v; None => return None }
    } else if k == "type_name" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => type_name = v; None => return None }
    } else if k == "alloc_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => alloc_count = v; None => return None }
    } else if k == "alloc_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => alloc_bytes = v; None => return None }
    } else if k == "free_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => free_count = v; None => return None }
    } else if k == "free_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => free_bytes = v; None => return None }
    } else if k == "inuse_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => inuse_count = v; None => return None }
    } else if k == "inuse_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => inuse_bytes = v; None => return None }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(ProfTypeRow::{
    tag_id: tag_id, tag_name: tag_name, drop_fn_raw: drop_fn_raw, type_name: type_name, alloc_count: alloc_count, alloc_bytes: alloc_bytes,
    free_count: free_count, free_bytes: free_bytes, inuse_count: inuse_count, inuse_bytes: inuse_bytes,
  })
}

///|
fn prof_parse_func_json(txt : String, pos : Array[Int], n : Int) -> Option[ProfFuncEntry] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut raw_sym = ""
  let mut name = ""
  let mut category = ""
  let mut pkg = ""
  let mut file = ""
  let mut line = 0
  let mut self_cpu_samples = 0L
  let mut self_cpu_pct = 0.0
  let mut cum_cpu_pct : Option[Double] = None
  let mut self_alloc_bytes = 0L
  let mut cum_alloc_bytes = 0L
  let mut alloc_count = 0L
  let mut inuse_bytes = 0L
  let mut rc_ops = 0L
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(ProfFuncEntry::{
      raw_sym: raw_sym, name: name, category: category, pkg: pkg, file: file, line: line, self_cpu_samples: self_cpu_samples,
      self_cpu_pct: self_cpu_pct, cum_cpu_pct: cum_cpu_pct, self_alloc_bytes: self_alloc_bytes, cum_alloc_bytes: cum_alloc_bytes,
      alloc_count: alloc_count, inuse_bytes: inuse_bytes, rc_ops: rc_ops,
    })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let k = match prof_json_parse_string(txt, pos, n) { Some(s) => s; None => return None }
    if !prof_json_expect_char(txt, pos, n, 58) { return None }
    if k == "raw_sym" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => raw_sym = v; None => return None }
    } else if k == "name" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => name = v; None => return None }
    } else if k == "category" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => category = v; None => return None }
    } else if k == "pkg" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => pkg = v; None => return None }
    } else if k == "file" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => file = v; None => return None }
    } else if k == "line" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => line = v.to_int(); None => return None }
    } else if k == "self_cpu_samples" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => self_cpu_samples = v; None => return None }
    } else if k == "self_cpu_pct" {
      match prof_json_parse_double(txt, pos, n) { Some(v) => self_cpu_pct = v; None => return None }
    } else if k == "cum_cpu_pct" {
      match prof_json_parse_opt_double(txt, pos, n) { Some(v) => cum_cpu_pct = v; None => return None }
    } else if k == "self_alloc_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => self_alloc_bytes = v; None => return None }
    } else if k == "cum_alloc_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => cum_alloc_bytes = v; None => return None }
    } else if k == "alloc_count" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => alloc_count = v; None => return None }
    } else if k == "inuse_bytes" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => inuse_bytes = v; None => return None }
    } else if k == "rc_ops" {
      match prof_json_parse_i64(txt, pos, n) { Some(v) => rc_ops = v; None => return None }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(ProfFuncEntry::{
    raw_sym: raw_sym, name: name, category: category, pkg: pkg, file: file, line: line, self_cpu_samples: self_cpu_samples,
    self_cpu_pct: self_cpu_pct, cum_cpu_pct: cum_cpu_pct, self_alloc_bytes: self_alloc_bytes, cum_alloc_bytes: cum_alloc_bytes,
    alloc_count: alloc_count, inuse_bytes: inuse_bytes, rc_ops: rc_ops,
  })
}

///|
fn prof_parse_backing_site_json(
  txt : String,
  pos : Array[Int],
  n : Int,
) -> Option[ProfBackingSite] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut name = ""
  let mut file = ""
  let mut line = 0
  let mut bytes = 0L
  let mut count = 0L
  let mut share_pct = 0.0
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(ProfBackingSite::{
      name: name,
      file: file,
      line: line,
      bytes: bytes,
      count: count,
      share_pct: share_pct,
    })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let k = match prof_json_parse_string(txt, pos, n) {
      Some(s) => s
      None => return None
    }
    if !prof_json_expect_char(txt, pos, n, 58) {
      return None
    }
    if k == "name" {
      match prof_json_parse_string(txt, pos, n) {
        Some(v) => name = v
        None => return None
      }
    } else if k == "file" {
      match prof_json_parse_string(txt, pos, n) {
        Some(v) => file = v
        None => return None
      }
    } else if k == "line" {
      match prof_json_parse_i64(txt, pos, n) {
        Some(v) => line = v.to_int()
        None => return None
      }
    } else if k == "bytes" {
      match prof_json_parse_i64(txt, pos, n) {
        Some(v) => bytes = v
        None => return None
      }
    } else if k == "count" {
      match prof_json_parse_i64(txt, pos, n) {
        Some(v) => count = v
        None => return None
      }
    } else if k == "share_pct" {
      match prof_json_parse_double(txt, pos, n) {
        Some(v) => share_pct = v
        None => return None
      }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(ProfBackingSite::{
    name: name,
    file: file,
    line: line,
    bytes: bytes,
    count: count,
    share_pct: share_pct,
  })
}

///|
fn prof_parse_hint_json(txt : String, pos : Array[Int], n : Int) -> Option[ProfHint] {
  if !prof_json_expect_char(txt, pos, n, 123) {
    return None
  }
  let mut code = ""
  let mut severity = ""
  let mut target = ""
  let mut message = ""
  let mut metric = ""
  let mut value = 0.0
  let mut threshold = 0.0
  let mut samples = 0L
  let mut suggested_cmd = ""
  cas_json_skip_ws(txt, pos, n)
  if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
    pos[0] = pos[0] + 1
    return Some(ProfHint::{
      code: code, severity: severity, target: target, message: message,
      evidence: ProfHintEvidence::{ metric, value, threshold, samples },
      suggested_cmd: suggested_cmd,
    })
  }
  while true {
    cas_json_skip_ws(txt, pos, n)
    let k = match prof_json_parse_string(txt, pos, n) { Some(s) => s; None => return None }
    if !prof_json_expect_char(txt, pos, n, 58) { return None }
    if k == "code" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => code = v; None => return None }
    } else if k == "severity" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => severity = v; None => return None }
    } else if k == "target" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => target = v; None => return None }
    } else if k == "message" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => message = v; None => return None }
    } else if k == "suggested_cmd" {
      match prof_json_parse_string(txt, pos, n) { Some(v) => suggested_cmd = v; None => return None }
    } else if k == "evidence" {
      if !prof_json_expect_char(txt, pos, n, 123) { return None }
      cas_json_skip_ws(txt, pos, n)
      if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(txt, pos, n)
          let ek = match prof_json_parse_string(txt, pos, n) { Some(s) => s; None => return None }
          if !prof_json_expect_char(txt, pos, n, 58) { return None }
          if ek == "metric" {
            match prof_json_parse_string(txt, pos, n) { Some(v) => metric = v; None => return None }
          } else if ek == "value" {
            match prof_json_parse_double(txt, pos, n) { Some(v) => value = v; None => return None }
          } else if ek == "threshold" {
            match prof_json_parse_double(txt, pos, n) { Some(v) => threshold = v; None => return None }
          } else if ek == "samples" {
            match prof_json_parse_i64(txt, pos, n) { Some(v) => samples = v; None => return None }
          } else if !cas_json_skip_value(txt, pos, n, 0) {
            return None
          }
          cas_json_skip_ws(txt, pos, n)
          if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
            pos[0] = pos[0] + 1
          } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
            pos[0] = pos[0] + 1
            break
          } else {
            return None
          }
        }
      }
    } else if !cas_json_skip_value(txt, pos, n, 0) {
      return None
    }
    cas_json_skip_ws(txt, pos, n)
    if pos[0] < n && str_code_at(txt, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(txt, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return None
    }
  }
  Some(ProfHint::{
    code: code, severity: severity, target: target, message: message,
    evidence: ProfHintEvidence::{ metric, value, threshold, samples },
    suggested_cmd: suggested_cmd,
  })
}

///|
/// Parses a saved `schema_version: 1` profile report JSON back into `ProfReport`.
pub fn prof_parse_report_json(json : String) -> Result[ProfReport, String] {
  let n = json.length()
  let pos : Array[Int] = [0]
  if !prof_json_expect_char(json, pos, n, 123) {
    return Err("invalid profile report JSON: expected '{'")
  }
  let mut schema_version = 0
  let mut target = ""
  let mut modes = 0
  let mut build_modes = 0
  let mut cpu_stack_mode = "pc_only"
  let mut rc_partial = false
  let mut sample_rate = 1
  let mut effective_cpu_interval_us = 0L
  let mut retained = false
  let mut retained_truncated = false
  let mut drop_cpu = 0L
  let mut drop_alloc = 0L
  let mut drop_rc = 0L
  let mut wall_ms = 0.0
  let mut cpu_ms = 0.0
  let mut peak_rss_kb = 0L
  let mut total_cpu_samples = 0L
  let mut m_ab = 0L
  let mut m_ac = 0L
  let mut m_fb = 0L
  let mut m_fc = 0L
  let mut m_ib = 0L
  let mut m_ic = 0L
  let mut b_ab = 0L
  let mut b_ac = 0L
  let mut b_fb = 0L
  let mut b_ib = 0L
  let mut a_res = 0L
  let mut a_peak = 0L
  let mut rc_inc = 0L
  let mut rc_dec = 0L
  let mut rc_ainc = 0L
  let mut rc_adec = 0L
  let mut rc_dest = 0L
  let mut rc_imm = 0L
  let by_type_tag : Array[ProfTagRow] = []
  let by_type : Array[ProfTypeRow] = []
  let top_functions : Array[ProfFuncEntry] = []
  let backing_top_sites : Array[ProfBackingSite] = []
  let hints : Array[ProfHint] = []

  cas_json_skip_ws(json, pos, n)
  if pos[0] < n && str_code_at(json, pos[0]) == 125 {
    return Err("empty profile report JSON")
  }
  while true {
    cas_json_skip_ws(json, pos, n)
    let k = match prof_json_parse_string(json, pos, n) {
      Some(s) => s
      None => return Err("invalid profile report JSON: expected key")
    }
    if !prof_json_expect_char(json, pos, n, 58) {
      return Err("invalid profile report JSON: expected ':'")
    }
    if k == "schema_version" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => schema_version = v.to_int(); None => return Err("invalid schema_version") }
    } else if k == "target" {
      match prof_json_parse_string(json, pos, n) { Some(v) => target = v; None => return Err("invalid target") }
    } else if k == "modes" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => modes = v.to_int(); None => return Err("invalid modes") }
    } else if k == "build_modes" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => build_modes = v.to_int(); None => return Err("invalid build_modes") }
    } else if k == "cpu_stack_mode" {
      match prof_json_parse_string(json, pos, n) { Some(v) => cpu_stack_mode = v; None => return Err("invalid cpu_stack_mode") }
    } else if k == "rc_partial" {
      match prof_json_parse_bool(json, pos, n) { Some(v) => rc_partial = v; None => return Err("invalid rc_partial") }
    } else if k == "sample_rate" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => sample_rate = v.to_int(); None => return Err("invalid sample_rate") }
    } else if k == "effective_cpu_interval_us" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => effective_cpu_interval_us = v; None => return Err("invalid effective_cpu_interval_us") }
    } else if k == "retained" {
      match prof_json_parse_bool(json, pos, n) { Some(v) => retained = v; None => return Err("invalid retained") }
    } else if k == "retained_truncated" {
      match prof_json_parse_bool(json, pos, n) { Some(v) => retained_truncated = v; None => return Err("invalid retained_truncated") }
    } else if k == "wall_ms" {
      match prof_json_parse_double(json, pos, n) { Some(v) => wall_ms = v; None => return Err("invalid wall_ms") }
    } else if k == "cpu_ms" {
      match prof_json_parse_double(json, pos, n) { Some(v) => cpu_ms = v; None => return Err("invalid cpu_ms") }
    } else if k == "peak_rss_kb" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => peak_rss_kb = v; None => return Err("invalid peak_rss_kb") }
    } else if k == "total_cpu_samples" {
      match prof_json_parse_i64(json, pos, n) { Some(v) => total_cpu_samples = v; None => return Err("invalid total_cpu_samples") }
    } else if k == "dropped_samples" {
      if !prof_json_expect_char(json, pos, n, 123) { return Err("invalid dropped_samples") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(json, pos, n)
          let dk = match prof_json_parse_string(json, pos, n) { Some(s) => s; None => return Err("invalid dropped_samples key") }
          if !prof_json_expect_char(json, pos, n, 58) { return Err("invalid dropped_samples :") }
          let dv = match prof_json_parse_i64(json, pos, n) { Some(v) => v; None => return Err("invalid dropped_samples val") }
          if dk == "cpu" { drop_cpu = dv } else if dk == "alloc" { drop_alloc = dv } else if dk == "rc" { drop_rc = dv }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 125 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid dropped_samples end") }
        }
      }
    } else if k == "managed" {
      if !prof_json_expect_char(json, pos, n, 123) { return Err("invalid managed") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(json, pos, n)
          let mk = match prof_json_parse_string(json, pos, n) { Some(s) => s; None => return Err("invalid managed key") }
          if !prof_json_expect_char(json, pos, n, 58) { return Err("invalid managed :") }
          let mv = match prof_json_parse_i64(json, pos, n) { Some(v) => v; None => return Err("invalid managed val") }
          if mk == "alloc_bytes" { m_ab = mv }
          else if mk == "alloc_count" { m_ac = mv }
          else if mk == "free_bytes" { m_fb = mv }
          else if mk == "free_count" { m_fc = mv }
          else if mk == "inuse_bytes" { m_ib = mv }
          else if mk == "inuse_count" { m_ic = mv }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 125 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid managed end") }
        }
      }
    } else if k == "backing" {
      if !prof_json_expect_char(json, pos, n, 123) { return Err("invalid backing") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(json, pos, n)
          let bk = match prof_json_parse_string(json, pos, n) { Some(s) => s; None => return Err("invalid backing key") }
          if !prof_json_expect_char(json, pos, n, 58) { return Err("invalid backing :") }
          let bv = match prof_json_parse_i64(json, pos, n) { Some(v) => v; None => return Err("invalid backing val") }
          if bk == "alloc_bytes" { b_ab = bv }
          else if bk == "alloc_count" { b_ac = bv }
          else if bk == "free_bytes" { b_fb = bv }
          else if bk == "inuse_bytes" { b_ib = bv }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 125 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid backing end") }
        }
      }
    } else if k == "allocator" {
      if !prof_json_expect_char(json, pos, n, 123) { return Err("invalid allocator") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(json, pos, n)
          let ak = match prof_json_parse_string(json, pos, n) { Some(s) => s; None => return Err("invalid allocator key") }
          if !prof_json_expect_char(json, pos, n, 58) { return Err("invalid allocator :") }
          let av = match prof_json_parse_i64(json, pos, n) { Some(v) => v; None => return Err("invalid allocator val") }
          if ak == "reserved_bytes" { a_res = av }
          else if ak == "peak_reserved_bytes" { a_peak = av }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 125 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid allocator end") }
        }
      }
    } else if k == "rc" {
      if !prof_json_expect_char(json, pos, n, 123) { return Err("invalid rc") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 125 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          cas_json_skip_ws(json, pos, n)
          let rk = match prof_json_parse_string(json, pos, n) { Some(s) => s; None => return Err("invalid rc key") }
          if !prof_json_expect_char(json, pos, n, 58) { return Err("invalid rc :") }
          let rv = match prof_json_parse_i64(json, pos, n) { Some(v) => v; None => return Err("invalid rc val") }
          if rk == "inc" { rc_inc = rv }
          else if rk == "dec" { rc_dec = rv }
          else if rk == "atomic_inc" { rc_ainc = rv }
          else if rk == "atomic_dec" { rc_adec = rv }
          else if rk == "destroy" { rc_dest = rv }
          else if rk == "immortal" { rc_imm = rv }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 125 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid rc end") }
        }
      }
    } else if k == "by_type_tag" {
      if !prof_json_expect_char(json, pos, n, 91) { return Err("invalid by_type_tag") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_tag_row_json(json, pos, n) {
            Some(r) => by_type_tag.push(r)
            None => return Err("invalid by_type_tag entry")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 93 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid by_type_tag end") }
        }
      }
    } else if k == "by_type" {
      if !prof_json_expect_char(json, pos, n, 91) { return Err("invalid by_type") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_type_row_json(json, pos, n) {
            Some(r) => by_type.push(r)
            None => return Err("invalid by_type entry")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 93 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid by_type end") }
        }
      }
    } else if k == "top_functions" {
      if !prof_json_expect_char(json, pos, n, 91) { return Err("invalid top_functions") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_func_json(json, pos, n) {
            Some(r) => top_functions.push(r)
            None => return Err("invalid top_functions entry")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 93 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid top_functions end") }
        }
      }
    } else if k == "backing_top_sites" {
      if !prof_json_expect_char(json, pos, n, 91) { return Err("invalid backing_top_sites") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_backing_site_json(json, pos, n) {
            Some(r) => backing_top_sites.push(r)
            None => return Err("invalid backing_top_sites entry")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 93 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid backing_top_sites end") }
        }
      }
    } else if k == "hints" {
      if !prof_json_expect_char(json, pos, n, 91) { return Err("invalid hints") }
      cas_json_skip_ws(json, pos, n)
      if pos[0] < n && str_code_at(json, pos[0]) == 93 {
        pos[0] = pos[0] + 1
      } else {
        while true {
          match prof_parse_hint_json(json, pos, n) {
            Some(r) => hints.push(r)
            None => return Err("invalid hints entry")
          }
          cas_json_skip_ws(json, pos, n)
          if pos[0] < n && str_code_at(json, pos[0]) == 44 { pos[0] = pos[0] + 1 }
          else if pos[0] < n && str_code_at(json, pos[0]) == 93 { pos[0] = pos[0] + 1; break }
          else { return Err("invalid hints end") }
        }
      }
    } else if !cas_json_skip_value(json, pos, n, 0) {
      return Err("failed to skip unknown field: " + k)
    }
    cas_json_skip_ws(json, pos, n)
    if pos[0] < n && str_code_at(json, pos[0]) == 44 {
      pos[0] = pos[0] + 1
    } else if pos[0] < n && str_code_at(json, pos[0]) == 125 {
      pos[0] = pos[0] + 1
      break
    } else {
      return Err("invalid profile report JSON: expected ',' or '}'")
    }
  }
  if schema_version != 1 {
    return Err("unsupported profile report schema_version: " + schema_version.to_string())
  }
  Ok(ProfReport::{
    schema_version: schema_version,
    target: target,
    modes: modes,
    build_modes: build_modes,
    cpu_stack_mode: cpu_stack_mode,
    rc_partial: rc_partial,
    sample_rate: sample_rate,
    effective_cpu_interval_us: effective_cpu_interval_us,
    retained: retained,
    retained_truncated: retained_truncated,
    dropped_samples: ProfDropped::{ cpu: drop_cpu, alloc: drop_alloc, rc: drop_rc },
    wall_ms: wall_ms,
    cpu_ms: cpu_ms,
    peak_rss_kb: peak_rss_kb,
    total_cpu_samples: total_cpu_samples,
    managed: ProfMemDomain::{
      alloc_bytes: m_ab,
      alloc_count: m_ac,
      free_bytes: m_fb,
      free_count: m_fc,
      inuse_bytes: m_ib,
      inuse_count: m_ic,
    },
    backing: ProfBackingDomain::{
      alloc_bytes: b_ab,
      alloc_count: b_ac,
      free_bytes: b_fb,
      inuse_bytes: b_ib,
    },
    allocator: ProfAllocatorDomain::{
      reserved_bytes: a_res,
      peak_reserved_bytes: a_peak,
    },
    rc: ProfRcDomain::{
      inc: rc_inc,
      dec: rc_dec,
      atomic_inc: rc_ainc,
      atomic_dec: rc_adec,
      destroy: rc_dest,
      immortal: rc_imm,
    },
    by_type_tag: by_type_tag,
    by_type: by_type,
    top_functions: top_functions,
    backing_top_sites: backing_top_sites,
    hints: hints,
  })
}

///|
fn prof_make_delta(base : Double, patched : Double) -> ProfMetricDelta {
  let delta = patched - base
  let delta_pct = if base != 0.0 {
    (delta * 100.0) / base
  } else if patched != 0.0 {
    100.0
  } else {
    0.0
  }
  ProfMetricDelta::{ base, patched, delta, delta_pct }
}

///|
fn prof_abs_d(x : Double) -> Double {
  if x < 0.0 { 0.0 - x } else { x }
}

///|
fn prof_sort_diffs(arr : Array[ProfFuncDiff], top_n : Int) -> Array[ProfFuncDiff] {
  let n = arr.length()
  let out : Array[ProfFuncDiff] = []
  let mut i = 0
  while i < n {
    out.push(arr[i])
    i = i + 1
  }
  i = 1
  while i < n {
    let cur = out[i]
    let cur_mag = prof_abs_d(cur.delta_cpu_pct) + prof_abs_d(cur.delta_alloc_pct) * 0.01
    let mut j = i - 1
    while j >= 0 {
      let prev_mag = prof_abs_d(out[j].delta_cpu_pct) + prof_abs_d(out[j].delta_alloc_pct) * 0.01
      if cur_mag > prev_mag || (cur_mag == prev_mag && cur.raw_sym < out[j].raw_sym) {
        out[j + 1] = out[j]
        j = j - 1
      } else {
        break
      }
    }
    out[j + 1] = cur
    i = i + 1
  }
  if top_n > 0 && top_n < out.length() {
    let trimmed : Array[ProfFuncDiff] = []
    let mut k = 0
    while k < top_n {
      trimmed.push(out[k])
      k = k + 1
    }
    trimmed
  } else {
    out
  }
}

///|
/// Computes a structured diff between a baseline and patched `ProfReport`.
pub fn prof_diff_reports(
  base : ProfReport,
  patched : ProfReport,
  top_n : Int,
  min_delta_pct : Double,
) -> ProfDiff {
  let base_rc = base.rc.inc + base.rc.dec + base.rc.atomic_inc + base.rc.atomic_dec + base.rc.destroy
  let patched_rc = patched.rc.inc + patched.rc.dec + patched.rc.atomic_inc + patched.rc.atomic_dec + patched.rc.destroy

  let base_map : Map[String, ProfFuncEntry] = Map([])
  let mut i = 0
  while i < base.top_functions.length() {
    let f = base.top_functions[i]
    base_map.set(f.raw_sym, f)
    i = i + 1
  }
  let patched_map : Map[String, ProfFuncEntry] = Map([])
  i = 0
  while i < patched.top_functions.length() {
    let f = patched.top_functions[i]
    patched_map.set(f.raw_sym, f)
    i = i + 1
  }

  let improved : Array[ProfFuncDiff] = []
  let regressed : Array[ProfFuncDiff] = []
  let new_fns : Array[ProfFuncDiff] = []
  let gone_fns : Array[ProfFuncDiff] = []

  i = 0
  while i < patched.top_functions.length() {
    let pf = patched.top_functions[i]
    match base_map.get(pf.raw_sym) {
      Some(bf) => {
        let d_cpu = pf.self_cpu_pct - bf.self_cpu_pct
        let d_alloc = pf.self_alloc_bytes - bf.self_alloc_bytes
        let d_alloc_pct = if bf.self_alloc_bytes > 0L {
          (d_alloc.to_double() * 100.0) / bf.self_alloc_bytes.to_double()
        } else if pf.self_alloc_bytes > 0L {
          100.0
        } else {
          0.0
        }
        let d_rc = pf.rc_ops - bf.rc_ops
        let primary = if prof_abs_d(d_cpu) >= min_delta_pct {
          d_cpu
        } else if prof_abs_d(d_alloc_pct) >= min_delta_pct {
          d_alloc_pct
        } else {
          0.0
        }
        if primary >= min_delta_pct && primary > 0.0 {
          regressed.push(ProfFuncDiff::{
            raw_sym: pf.raw_sym,
            name: pf.name,
            category: pf.category,
            status: "regressed",
            base_self_cpu_pct: bf.self_cpu_pct,
            patched_self_cpu_pct: pf.self_cpu_pct,
            delta_cpu_pct: d_cpu,
            base_alloc_bytes: bf.self_alloc_bytes,
            patched_alloc_bytes: pf.self_alloc_bytes,
            delta_alloc_bytes: d_alloc,
            delta_alloc_pct: d_alloc_pct,
            base_rc_ops: bf.rc_ops,
            patched_rc_ops: pf.rc_ops,
            delta_rc_ops: d_rc,
          })
        } else if primary <= 0.0 - min_delta_pct && primary < 0.0 {
          improved.push(ProfFuncDiff::{
            raw_sym: pf.raw_sym,
            name: pf.name,
            category: pf.category,
            status: "improved",
            base_self_cpu_pct: bf.self_cpu_pct,
            patched_self_cpu_pct: pf.self_cpu_pct,
            delta_cpu_pct: d_cpu,
            base_alloc_bytes: bf.self_alloc_bytes,
            patched_alloc_bytes: pf.self_alloc_bytes,
            delta_alloc_bytes: d_alloc,
            delta_alloc_pct: d_alloc_pct,
            base_rc_ops: bf.rc_ops,
            patched_rc_ops: pf.rc_ops,
            delta_rc_ops: d_rc,
          })
        }
      }
      None =>
      new_fns.push(ProfFuncDiff::{
        raw_sym: pf.raw_sym,
        name: pf.name,
        category: pf.category,
        status: "new",
        base_self_cpu_pct: 0.0,
        patched_self_cpu_pct: pf.self_cpu_pct,
        delta_cpu_pct: pf.self_cpu_pct,
        base_alloc_bytes: 0L,
        patched_alloc_bytes: pf.self_alloc_bytes,
        delta_alloc_bytes: pf.self_alloc_bytes,
        delta_alloc_pct: if pf.self_alloc_bytes > 0L { 100.0 } else { 0.0 },
        base_rc_ops: 0L,
        patched_rc_ops: pf.rc_ops,
        delta_rc_ops: pf.rc_ops,
      })
    }
    i = i + 1
  }

  i = 0
  while i < base.top_functions.length() {
    let bf = base.top_functions[i]
    if !patched_map.contains(bf.raw_sym) {
      gone_fns.push(ProfFuncDiff::{
        raw_sym: bf.raw_sym,
        name: bf.name,
        category: bf.category,
        status: "gone",
        base_self_cpu_pct: bf.self_cpu_pct,
        patched_self_cpu_pct: 0.0,
        delta_cpu_pct: 0.0 - bf.self_cpu_pct,
        base_alloc_bytes: bf.self_alloc_bytes,
        patched_alloc_bytes: 0L,
        delta_alloc_bytes: 0L - bf.self_alloc_bytes,
        delta_alloc_pct: if bf.self_alloc_bytes > 0L { -100.0 } else { 0.0 },
        base_rc_ops: bf.rc_ops,
        patched_rc_ops: 0L,
        delta_rc_ops: 0L - bf.rc_ops,
      })
    }
    i = i + 1
  }

  ProfDiff::{
    schema_version: 1,
    target: patched.target,
    wall_ms: prof_make_delta(base.wall_ms, patched.wall_ms),
    peak_rss_kb: prof_make_delta(base.peak_rss_kb.to_double(), patched.peak_rss_kb.to_double()),
    managed_alloc_bytes: prof_make_delta(base.managed.alloc_bytes.to_double(), patched.managed.alloc_bytes.to_double()),
    managed_alloc_count: prof_make_delta(base.managed.alloc_count.to_double(), patched.managed.alloc_count.to_double()),
    managed_inuse_bytes: prof_make_delta(base.managed.inuse_bytes.to_double(), patched.managed.inuse_bytes.to_double()),
    backing_alloc_bytes: prof_make_delta(base.backing.alloc_bytes.to_double(), patched.backing.alloc_bytes.to_double()),
    peak_reserved_bytes: prof_make_delta(base.allocator.peak_reserved_bytes.to_double(), patched.allocator.peak_reserved_bytes.to_double()),
    rc_total: prof_make_delta(base_rc.to_double(), patched_rc.to_double()),
    improved: prof_sort_diffs(improved, top_n),
    regressed: prof_sort_diffs(regressed, top_n),
    new_fns: prof_sort_diffs(new_fns, top_n),
    gone_fns: prof_sort_diffs(gone_fns, top_n),
  }
}

///|
fn prof_write_metric_delta_json(sb : StringBuilder, m : ProfMetricDelta) -> Unit {
  sb.write_string("{\"base\":")
  sb.write_string(m.base.to_string())
  sb.write_string(",\"patched\":")
  sb.write_string(m.patched.to_string())
  sb.write_string(",\"delta\":")
  sb.write_string(m.delta.to_string())
  sb.write_string(",\"delta_pct\":")
  sb.write_string(m.delta_pct.to_string())
  sb.write_char('}')
}

///|
fn prof_write_func_diff_array_json(sb : StringBuilder, arr : Array[ProfFuncDiff]) -> Unit {
  sb.write_char('[')
  let mut i = 0
  while i < arr.length() {
    if i > 0 {
      sb.write_char(',')
    }
    let f = arr[i]
    sb.write_string("{\"raw_sym\":")
    sb.write_string(json_quote(f.raw_sym))
    sb.write_string(",\"name\":")
    sb.write_string(json_quote(f.name))
    sb.write_string(",\"category\":")
    sb.write_string(json_quote(f.category))
    sb.write_string(",\"status\":")
    sb.write_string(json_quote(f.status))
    sb.write_string(",\"base_self_cpu_pct\":")
    sb.write_string(f.base_self_cpu_pct.to_string())
    sb.write_string(",\"patched_self_cpu_pct\":")
    sb.write_string(f.patched_self_cpu_pct.to_string())
    sb.write_string(",\"delta_cpu_pct\":")
    sb.write_string(f.delta_cpu_pct.to_string())
    sb.write_string(",\"base_alloc_bytes\":")
    sb.write_string(f.base_alloc_bytes.to_string())
    sb.write_string(",\"patched_alloc_bytes\":")
    sb.write_string(f.patched_alloc_bytes.to_string())
    sb.write_string(",\"delta_alloc_bytes\":")
    sb.write_string(f.delta_alloc_bytes.to_string())
    sb.write_string(",\"delta_alloc_pct\":")
    sb.write_string(f.delta_alloc_pct.to_string())
    sb.write_string(",\"base_rc_ops\":")
    sb.write_string(f.base_rc_ops.to_string())
    sb.write_string(",\"patched_rc_ops\":")
    sb.write_string(f.patched_rc_ops.to_string())
    sb.write_string(",\"delta_rc_ops\":")
    sb.write_string(f.delta_rc_ops.to_string())
    sb.write_char('}')
    i = i + 1
  }
  sb.write_char(']')
}

///|
/// Serializes a `ProfDiff` to JSON.
pub fn prof_diff_to_json(d : ProfDiff) -> String {
  let sb = StringBuilder()
  sb.write_string("{\"schema_version\":")
  sb.write_string(d.schema_version.to_string())
  sb.write_string(",\"target\":")
  sb.write_string(json_quote(d.target))
  sb.write_string(",\"summary\":{\"wall_ms\":")
  prof_write_metric_delta_json(sb, d.wall_ms)
  sb.write_string(",\"peak_rss_kb\":")
  prof_write_metric_delta_json(sb, d.peak_rss_kb)
  sb.write_string(",\"managed_alloc_bytes\":")
  prof_write_metric_delta_json(sb, d.managed_alloc_bytes)
  sb.write_string(",\"managed_alloc_count\":")
  prof_write_metric_delta_json(sb, d.managed_alloc_count)
  sb.write_string(",\"managed_inuse_bytes\":")
  prof_write_metric_delta_json(sb, d.managed_inuse_bytes)
  sb.write_string(",\"backing_alloc_bytes\":")
  prof_write_metric_delta_json(sb, d.backing_alloc_bytes)
  sb.write_string(",\"peak_reserved_bytes\":")
  prof_write_metric_delta_json(sb, d.peak_reserved_bytes)
  sb.write_string(",\"rc_total\":")
  prof_write_metric_delta_json(sb, d.rc_total)
  sb.write_string("},\"improved\":")
  prof_write_func_diff_array_json(sb, d.improved)
  sb.write_string(",\"regressed\":")
  prof_write_func_diff_array_json(sb, d.regressed)
  sb.write_string(",\"new\":")
  prof_write_func_diff_array_json(sb, d.new_fns)
  sb.write_string(",\"gone\":")
  prof_write_func_diff_array_json(sb, d.gone_fns)
  sb.write_char('}')
  sb.to_string()
}

///|
/// Formats a `ProfDiff` as human-readable text.
pub fn prof_diff_to_text(d : ProfDiff) -> String {
  let sb = StringBuilder()
  sb.write_string("Profile Diff (target=")
  sb.write_string(d.target)
  sb.write_string(")\n")
  sb.write_string("  wall_ms: ")
  sb.write_string(d.wall_ms.base.to_string())
  sb.write_string(" -> ")
  sb.write_string(d.wall_ms.patched.to_string())
  sb.write_string(" (")
  sb.write_string(d.wall_ms.delta_pct.to_string())
  sb.write_string("%)\n")
  sb.write_string("  managed_alloc_bytes: ")
  sb.write_string(d.managed_alloc_bytes.base.to_string())
  sb.write_string(" -> ")
  sb.write_string(d.managed_alloc_bytes.patched.to_string())
  sb.write_string(" (")
  sb.write_string(d.managed_alloc_bytes.delta_pct.to_string())
  sb.write_string("%)\n")
  sb.write_string("  rc_total: ")
  sb.write_string(d.rc_total.base.to_string())
  sb.write_string(" -> ")
  sb.write_string(d.rc_total.patched.to_string())
  sb.write_string(" (")
  sb.write_string(d.rc_total.delta_pct.to_string())
  sb.write_string("%)\n")
  if d.improved.length() > 0 {
    sb.write_string("Improved:\n")
    let mut i = 0
    while i < d.improved.length() {
      let f = d.improved[i]
      sb.write_string("  - ")
      sb.write_string(f.name)
      sb.write_string(": cpu ")
      sb.write_string(f.delta_cpu_pct.to_string())
      sb.write_string("pp, alloc ")
      sb.write_string(f.delta_alloc_bytes.to_string())
      sb.write_string("B\n")
      i = i + 1
    }
  }
  if d.regressed.length() > 0 {
    sb.write_string("Regressed:\n")
    let mut i = 0
    while i < d.regressed.length() {
      let f = d.regressed[i]
      sb.write_string("  + ")
      sb.write_string(f.name)
      sb.write_string(": cpu +")
      sb.write_string(f.delta_cpu_pct.to_string())
      sb.write_string("pp, alloc ")
      sb.write_string(f.delta_alloc_bytes.to_string())
      sb.write_string("B\n")
      i = i + 1
    }
  }
  if d.new_fns.length() > 0 {
    sb.write_string("New:\n")
    let mut i = 0
    while i < d.new_fns.length() {
      sb.write_string("  * ")
      sb.write_string(d.new_fns[i].name)
      sb.write_string("\n")
      i = i + 1
    }
  }
  if d.gone_fns.length() > 0 {
    sb.write_string("Gone:\n")
    let mut i = 0
    while i < d.gone_fns.length() {
      sb.write_string("  ~ ")
      sb.write_string(d.gone_fns[i].name)
      sb.write_string("\n")
      i = i + 1
    }
  }
  sb.to_string()
}
