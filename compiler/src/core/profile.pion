///| Pure-Pion Profile Engine:
///  - `PIONPROF 1` raw text parser (shared by Native C & Wasm32 JS)
///  - V8 `.cpuprofile` JSON parser (Node `--cpu-prof` + `wasm-function[N]` mapping)
///  - Compile-time `syms` sidecar TSV parser
///  - Symbolization, aggregation, threshold-gated `hints[]` (RFC v2 §1.6)
///  - Unified `schema_version: 1` JSON serializer & round-trip parser
///  - `summary` text formatter & `diff` engine (improved/regressed/new/gone)

///|
pub struct ProfTagRow {
  tag_id : Int
  tag_name : String
  alloc_count : Int64
  alloc_bytes : Int64
  free_count : Int64
  free_bytes : Int64
  inuse_count : Int64
  inuse_bytes : Int64
  rc_inc : Int64
  rc_dec : Int64
  rc_atomic_inc : Int64
  rc_atomic_dec : Int64
  rc_destroy : Int64
  rc_immortal : Int64
}

///|
pub struct ProfTypeRow {
  tag_id : Int
  tag_name : String
  drop_fn_raw : String
  type_name : String
  alloc_count : Int64
  alloc_bytes : Int64
  free_count : Int64
  free_bytes : Int64
  inuse_count : Int64
  inuse_bytes : Int64
}

///|
pub struct ProfCpuPc {
  pc_token : String
  count : Int64
}

///|
pub struct ProfStackRow {
  kind : String
  tag_id : Int
  count : Int64
  bytes : Int64
  frames : Array[String]
}

///|
pub struct ProfRaw {
  version : Int
  target : String
  modes : Int
  build_modes : Int
  cpu_stack_mode : String
  sample_rate : Int
  hz : Int
  retained : Bool
  retained_truncated : Bool
  wall_us : Int64
  cpu_us : Int64
  peak_rss_kb : Int64
  dropped_cpu : Int64
  dropped_alloc : Int64
  dropped_rc : Int64
  reserved_bytes : Int64
  peak_reserved_bytes : Int64
  backing_alloc_bytes : Int64
  backing_alloc_count : Int64
  backing_free_bytes : Int64
  backing_inuse_bytes : Int64
  anchor_addr : Int64
  anchor_sym : String
  bin_path : String
  tags : Array[ProfTagRow]
  types : Array[ProfTypeRow]
  cpu_pcs : Array[ProfCpuPc]
  stacks : Array[ProfStackRow]
}

///|
pub struct ProfCpuFunc {
  raw_sym : String
  self_samples : Int64
  cum_samples : Int64
  self_us : Int64
  cum_us : Int64
}

///|
pub struct ProfCpuData {
  total_samples : Int64
  total_us : Int64
  stack_mode : String
  funcs : Array[ProfCpuFunc]
}

///|
pub struct ProfMemDomain {
  alloc_bytes : Int64
  alloc_count : Int64
  free_bytes : Int64
  free_count : Int64
  inuse_bytes : Int64
  inuse_count : Int64
}

///|
pub struct ProfBackingDomain {
  alloc_bytes : Int64
  alloc_count : Int64
  free_bytes : Int64
  inuse_bytes : Int64
}

///|
pub struct ProfAllocatorDomain {
  reserved_bytes : Int64
  peak_reserved_bytes : Int64
}

///|
pub struct ProfRcDomain {
  inc : Int64
  dec : Int64
  atomic_inc : Int64
  atomic_dec : Int64
  destroy : Int64
  immortal : Int64
}

///|
pub struct ProfDropped {
  cpu : Int64
  alloc : Int64
  rc : Int64
}

///|
