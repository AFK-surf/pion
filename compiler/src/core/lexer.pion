///|
pub enum TokenKind {
  IntLit(String)
  Int64Lit(String)
  UIntLit(String)
  UInt64Lit(String)
  DoubleLit(String)
  FloatLit(String)
  StringLit(String)
  InterpStart(String)
  InterpMid(String)
  InterpEnd(String)
  CharLit(String)
  ByteLit(String)
  BoolLit(Bool)
  Ident(String)
  KwFn
  KwPub
  KwStruct
  KwEnum
  KwLet
  KwMut
  KwIf
  KwElse
  KwMatch
  KwGuard
  KwIs
  KwWhile
  KwFor
  KwIn
  KwBreak
  KwContinue
  KwReturn
  KwAs
  KwVal
  KwMove
  KwScope
  KwSpawn
  KwDebugAssert
  KwType
  KwImport
  KwExtern
  KwTrait
  KwImpl
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Comma
  Semi
  Colon
  ColonColon
  Dot
  DotDot
  DotDotLt
  DotDotEq
  Ellipsis
  Question
  Tilde
  Hash
  Arrow
  FatArrow
  PipeGt
  Plus
  Minus
  Star
  Slash
  Percent
  PlusEq
  MinusEq
  StarEq
  SlashEq
  PercentEq
  AmpEq
  PipeEq
  CaretEq
  LtLtEq
  GtGtEq
  Eq
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  AmpAmp
  PipePipe
  Bang
  Amp
  Pipe
  Caret
  LtLt
  GtGt
  Eof
  Invalid(String)
}

///|
pub struct Token {
  kind : TokenKind
  span : Span
  raw : String
  newline_before : Bool
}

///|
pub struct LexResult {
  tokens : Array[Token]
  diagnostics : Array[Diagnostic]
}

///|
fn is_ident_start(ch : Int) -> Bool {
  (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
}

///|
fn is_ident_part(ch : Int) -> Bool {
  is_ident_start(ch) || (ch >= 48 && ch <= 57)
}

///|
fn is_digit(ch : Int) -> Bool {
  ch >= 48 && ch <= 57
}

///|
fn is_hex_digit(ch : Int) -> Bool {
  (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 70) || (ch >= 97 && ch <= 102)
}

///|
fn hex_digit_val(ch : Int) -> Int {
  if ch >= 48 && ch <= 57 {
    ch - 48
  } else if ch >= 65 && ch <= 70 {
    ch - 65 + 10
  } else if ch >= 97 && ch <= 102 {
    ch - 97 + 10
  } else {
    -1
  }
}

///|
struct UnicodeEscapeRes {
  ok : Bool
  cp : Int
  next_pos : Int
  err_msg : String
}

///|
fn parse_unicode_escape(
  source : String,
  len : Int,
  start_pos : Int,
) -> UnicodeEscapeRes {
  if start_pos + 2 >= len || str_code_at(source, start_pos + 2) != 123 {
    return UnicodeEscapeRes::{
      ok: false,
      cp: 0,
      next_pos: start_pos + 2,
      err_msg: "expected `{` after `\\u`",
    }
  }
  let mut p = start_pos + 3
  let mut cp = 0
  let mut digits = 0
  let mut overflow = false
  while p < len {
    let c = str_code_at(source, p)
    if c == 125 {
      if digits == 0 {
        return UnicodeEscapeRes::{
          ok: false,
          cp: 0,
          next_pos: p + 1,
          err_msg: "empty unicode escape `\\u{}`",
        }
      }
      if digits > 6 || overflow || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF) {
        return UnicodeEscapeRes::{
          ok: false,
          cp: 0,
          next_pos: p + 1,
          err_msg: "unicode escape out of valid scalar range (0x0..=0x10FFFF, excluding surrogates)",
        }
      }
      return UnicodeEscapeRes::{
        ok: true,
        cp: cp,
        next_pos: p + 1,
        err_msg: "",
      }
    }
    if c == 10 || c == 34 || c == 39 {
      return UnicodeEscapeRes::{
        ok: false,
        cp: 0,
        next_pos: p,
        err_msg: "unterminated `\\u{...}` unicode escape",
      }
    }
    let hv = hex_digit_val(c)
    if hv < 0 {
      return UnicodeEscapeRes::{
        ok: false,
        cp: 0,
        next_pos: p + 1,
        err_msg: "invalid hex digit in `\\u{...}` unicode escape",
      }
    }
    digits = digits + 1
    if digits <= 6 {
      cp = cp * 16 + hv
    } else {
      overflow = true
    }
    p = p + 1
  }
  UnicodeEscapeRes::{
    ok: false,
    cp: 0,
    next_pos: p,
    err_msg: "unterminated `\\u{...}` unicode escape",
  }
}

///|
fn keyword_or_ident(word : String) -> TokenKind {
  match word.length() {
    2 => {
      if word == "fn" { return KwFn }
      if word == "if" { return KwIf }
      if word == "is" { return KwIs }
      if word == "in" { return KwIn }
      if word == "as" { return KwAs }
    }
    3 => {
      if word == "pub" { return KwPub }
      if word == "let" { return KwLet }
      if word == "mut" { return KwMut }
      if word == "for" { return KwFor }
      if word == "val" { return KwVal }
    }
    4 => {
      if word == "enum" { return KwEnum }
      if word == "else" { return KwElse }
      if word == "true" { return BoolLit(true) }
      if word == "move" { return KwMove }
      if word == "type" { return KwType }
      if word == "impl" { return KwImpl }
    }
    5 => {
      if word == "match" { return KwMatch }
      if word == "guard" { return KwGuard }
      if word == "while" { return KwWhile }
      if word == "break" { return KwBreak }
      if word == "false" { return BoolLit(false) }
      if word == "scope" { return KwScope }
      if word == "spawn" { return KwSpawn }
      if word == "trait" { return KwTrait }
    }
    6 => {
      if word == "struct" { return KwStruct }
      if word == "return" { return KwReturn }
      if word == "import" { return KwImport }
      if word == "extern" { return KwExtern }
    }
    8 => {
      if word == "continue" { return KwContinue }
    }
    12 => {
      if word == "debug_assert" { return KwDebugAssert }
    }
    _ => ()
  }
  Ident(word)
}

///|
fn slice_str(s : String, start : Int, end_pos : Int) -> String {
  let sb = StringBuilder()
  sb_write_range(sb, s, start, end_pos)
  sb.to_string()
}

///|
pub fn lex(file : String, source : String) -> LexResult {
  let utf8 = host_str_is_utf8()
  let tokens : Array[Token] = []
  let diags : Array[Diagnostic] = []
  let len = source.length()
  let mut pos = 0
  let mut line = 1
  let mut col = 1
  let mut saw_newline = true
  let interp_depths : Array[Int] = []

  while pos < len {
    let ch = str_code_at(source, pos)

    // Whitespace
    if ch == 32 || ch == 9 || ch == 13 {
      pos = pos + 1
      col = col + 1
      continue
    }
    if ch == 10 {
      pos = pos + 1
      line = line + 1
      col = 1
      saw_newline = true
      continue
    }

    // Line comment (including ///|)
    if ch == 47 && pos + 1 < len && str_code_at(source, pos + 1) == 47 {
      pos = pos + 2
      col = col + 2
      while pos < len && str_code_at(source, pos) != 10 {
        pos = pos + 1
        col = col + 1
      }
      continue
    }

    let start_line = line
    let start_col = col
    let start_pos = pos
    let nl = saw_newline
    saw_newline = false

    // Multi-line raw string literal: #|...
    if ch == 35 && pos + 1 < len && str_code_at(source, pos + 1) == 124 {
      let sb = StringBuilder()
      let mut first_line = true
      while true {
        pos = pos + 2
        col = col + 2
        if !first_line {
          sb.write_char('\n')
        }
        first_line = false
        let line_start = pos
        while pos < len && str_code_at(source, pos) != 10 {
          pos = pos + 1
          col = col + 1
        }
        let line_end = if pos > line_start && str_code_at(source, pos - 1) == 13 {
          pos - 1
        } else {
          pos
        }
        sb_write_range(sb, source, line_start, line_end)
        if pos < len && str_code_at(source, pos) == 10 {
          let mut p = pos + 1
          let mut next_col = 1
          while p < len &&
            (str_code_at(source, p) == 32 || str_code_at(source, p) == 9) {
            p = p + 1
            next_col = next_col + 1
          }
          if p + 1 < len &&
            str_code_at(source, p) == 35 &&
            str_code_at(source, p + 1) == 124 {
            pos = p
            line = line + 1
            col = next_col
            continue
          }
        }
        break
      }
      let sp = span_new(file, start_line, start_col)
      let raw = slice_str(source, start_pos, pos)
      tokens.push(Token::{
        kind: StringLit(sb.to_string()),
        span: sp,
        raw: raw,
        newline_before: nl,
      })
      continue
    }

    // Byte literal: b'a', b'\n', b'\x00'
    if ch == 98 && pos + 1 < len && str_code_at(source, pos + 1) == 39 {
      pos = pos + 2
      col = col + 2
      let sb = StringBuilder()
      let mut closed = false
      while pos < len {
        let c = str_code_at(source, pos)
        if c == 10 {
          break
        }
        if c == 39 {
          pos = pos + 1
          col = col + 1
          closed = true
          break
        }
        if c == 92 && pos + 1 < len {
          let next_c = str_code_at(source, pos + 1)
          if next_c == 117 {
            let ures = parse_unicode_escape(source, len, pos)
            if ures.ok {
              let mut ui = pos
              while ui < ures.next_pos {
                sb.write_char(str_code_at(source, ui).unsafe_to_char())
                ui = ui + 1
              }
            } else {
              diags.push(
                diag_new(
                  span_new(file, line, col),
                  "E_PARSE",
                  ures.err_msg,
                  "valid unicode scalar escape `\\u{H...}`",
                  "\\u",
                  "write 1 to 6 hex digits inside `\\u{...}`, e.g. `\\u{0C}` or `\\u{4E2D}`",
                ),
              )
            }
            col = col + (ures.next_pos - pos)
            pos = ures.next_pos
          } else {
            sb.write_char(c.unsafe_to_char())
            sb.write_char(next_c.unsafe_to_char())
            pos = pos + 2
            col = col + 2
          }
        } else {
          let un = str_scalar_len(source, pos, utf8)
          sb.write_char(str_scalar_at(source, pos, utf8).unsafe_to_char())
          pos = pos + un
          col = col + 1
        }
      }
      let sp = span_new(file, start_line, start_col)
      let raw = slice_str(source, start_pos, pos)
      if closed {
        tokens.push(Token::{
          kind: ByteLit(sb.to_string()),
          span: sp,
          raw: raw,
          newline_before: nl,
        })
      } else {
        diags.push(
          diag_new(
            sp,
            "E_PARSE",
            "unterminated byte literal",
            "closing `'`",
            "end of line",
            "close the byte literal with `'`",
          ),
        )
      }
      continue
    }

    // Char literal: 'a', '\n'
    if ch == 39 {
      pos = pos + 1
      col = col + 1
      let sb = StringBuilder()
      let mut closed = false
      while pos < len {
        let c = str_code_at(source, pos)
        if c == 10 {
          break
        }
        if c == 39 {
          pos = pos + 1
          col = col + 1
          closed = true
          break
        }
        if c == 92 && pos + 1 < len {
          let next_c = str_code_at(source, pos + 1)
          if next_c == 117 {
            let ures = parse_unicode_escape(source, len, pos)
            if ures.ok {
              let mut ui = pos
              while ui < ures.next_pos {
                sb.write_char(str_code_at(source, ui).unsafe_to_char())
                ui = ui + 1
              }
            } else {
              diags.push(
                diag_new(
                  span_new(file, line, col),
                  "E_PARSE",
                  ures.err_msg,
                  "valid unicode scalar escape `\\u{H...}`",
                  "\\u",
                  "write 1 to 6 hex digits inside `\\u{...}`, e.g. `\\u{0C}` or `\\u{4E2D}`",
                ),
              )
            }
            col = col + (ures.next_pos - pos)
            pos = ures.next_pos
          } else {
            sb.write_char(c.unsafe_to_char())
            sb.write_char(next_c.unsafe_to_char())
            pos = pos + 2
            col = col + 2
          }
        } else {
          let un = str_scalar_len(source, pos, utf8)
          sb.write_char(str_scalar_at(source, pos, utf8).unsafe_to_char())
          pos = pos + un
          col = col + 1
        }
      }
      let sp = span_new(file, start_line, start_col)
      let raw = slice_str(source, start_pos, pos)
      if closed {
        tokens.push(Token::{
          kind: CharLit(sb.to_string()),
          span: sp,
          raw: raw,
          newline_before: nl,
        })
      } else {
        diags.push(
          diag_new(
            sp,
            "E_PARSE",
            "unterminated char literal",
            "closing `'`",
            "end of line",
            "close the char literal with `'`",
          ),
        )
      }
      continue
    }

    // String literal: "..." or interpolated "...\{expr}..."
    if ch == 34 {
      pos = pos + 1
      col = col + 1
      let sb = StringBuilder()
      let mut closed = false
      let mut hit_interp = false
      while pos < len {
        let c = str_code_at(source, pos)
        if c == 10 {
          break
        }
        if c == 34 {
          pos = pos + 1
          col = col + 1
          closed = true
          break
        }
        if c == 92 && pos + 1 < len {
          let next_c = str_code_at(source, pos + 1)
          if next_c == 123 {
            pos = pos + 2
            col = col + 2
            hit_interp = true
            break
          }
          if next_c == 110 {
            sb.write_char('\n')
            pos = pos + 2
            col = col + 2
          } else if next_c == 114 {
            sb.write_char('\r')
            pos = pos + 2
            col = col + 2
          } else if next_c == 116 {
            sb.write_char('\t')
            pos = pos + 2
            col = col + 2
          } else if next_c == 92 {
            sb.write_char('\\')
            pos = pos + 2
            col = col + 2
          } else if next_c == 34 {
            sb.write_char('"')
            pos = pos + 2
            col = col + 2
          } else if next_c == 48 {
            let nul = 0
            sb.write_char(nul.unsafe_to_char())
            pos = pos + 2
            col = col + 2
          } else if next_c == 120 {
            let hi = if pos + 2 < len {
              hex_digit_val(str_code_at(source, pos + 2))
            } else {
              -1
            }
            let lo = if pos + 3 < len {
              hex_digit_val(str_code_at(source, pos + 3))
            } else {
              -1
            }
            if hi >= 0 && lo >= 0 {
              let bv = hi * 16 + lo
              if bv < 0x80 {
                sb.write_char(bv.unsafe_to_char())
              } else {
                sb.write_char((0xE000 + bv).unsafe_to_char())
              }
              pos = pos + 4
              col = col + 4
            } else {
              diags.push(
                diag_new(
                  span_new(file, line, col),
                  "E_PARSE",
                  "invalid hex escape in string literal",
                  "two hex digits after `\\x`",
                  "\\x",
                  "write two hexadecimal digits after `\\x`, e.g. `\\x41`",
                ),
              )
              pos = pos + 2
              col = col + 2
            }
          } else if next_c == 117 {
            let ures = parse_unicode_escape(source, len, pos)
            if ures.ok {
              sb.write_char(ures.cp.unsafe_to_char())
            } else {
              diags.push(
                diag_new(
                  span_new(file, line, col),
                  "E_PARSE",
                  ures.err_msg,
                  "valid unicode scalar escape `\\u{H...}`",
                  "\\u",
                  "write 1 to 6 hex digits inside `\\u{...}`, e.g. `\\u{0C}` or `\\u{4E2D}`",
                ),
              )
            }
            col = col + (ures.next_pos - pos)
            pos = ures.next_pos
          } else {
            sb.write_char(next_c.unsafe_to_char())
            pos = pos + 2
            col = col + 2
          }
        } else {
          let un = str_scalar_len(source, pos, utf8)
          sb.write_char(str_scalar_at(source, pos, utf8).unsafe_to_char())
          pos = pos + un
          col = col + 1
        }
      }
      let sp = span_new(file, start_line, start_col)
      let raw = slice_str(source, start_pos, pos)
      if hit_interp {
        interp_depths.push(0)
        tokens.push(Token::{
          kind: InterpStart(sb.to_string()),
          span: sp,
          raw: raw,
          newline_before: nl,
        })
      } else if closed {
        tokens.push(Token::{
          kind: StringLit(sb.to_string()),
          span: sp,
          raw: raw,
          newline_before: nl,
        })
      } else {
        diags.push(
          diag_new(
            sp,
            "E_PARSE",
            "unterminated string literal",
            "closing `\"`",
            "end of line",
            "close the string literal with `\"`",
          ),
        )
      }
      continue
    }

    // Closing `}` of a string interpolation segment resumes scanning the string
    if ch == 125 && interp_depths.length() > 0 {
      let top_idx = interp_depths.length() - 1
      if interp_depths[top_idx] == 0 {
        pos = pos + 1
        col = col + 1
        let sb = StringBuilder()
        let mut closed = false
        let mut hit_interp = false
        while pos < len {
          let c = str_code_at(source, pos)
          if c == 10 {
            break
          }
          if c == 34 {
            pos = pos + 1
            col = col + 1
            closed = true
            break
          }
          if c == 92 && pos + 1 < len {
            let next_c = str_code_at(source, pos + 1)
            if next_c == 123 {
              pos = pos + 2
              col = col + 2
              hit_interp = true
              break
            }
            if next_c == 110 {
              sb.write_char('\n')
              pos = pos + 2
              col = col + 2
            } else if next_c == 114 {
              sb.write_char('\r')
              pos = pos + 2
              col = col + 2
            } else if next_c == 116 {
              sb.write_char('\t')
              pos = pos + 2
              col = col + 2
            } else if next_c == 92 {
              sb.write_char('\\')
              pos = pos + 2
              col = col + 2
            } else if next_c == 34 {
              sb.write_char('"')
              pos = pos + 2
              col = col + 2
            } else if next_c == 48 {
              let nul = 0
              sb.write_char(nul.unsafe_to_char())
              pos = pos + 2
              col = col + 2
            } else if next_c == 120 {
              let hi = if pos + 2 < len {
                hex_digit_val(str_code_at(source, pos + 2))
              } else {
                -1
              }
              let lo = if pos + 3 < len {
                hex_digit_val(str_code_at(source, pos + 3))
              } else {
                -1
              }
              if hi >= 0 && lo >= 0 {
                let bv = hi * 16 + lo
                if bv < 0x80 {
                  sb.write_char(bv.unsafe_to_char())
                } else {
                  sb.write_char((0xE000 + bv).unsafe_to_char())
                }
                pos = pos + 4
                col = col + 4
              } else {
                diags.push(
                  diag_new(
                    span_new(file, line, col),
                    "E_PARSE",
                    "invalid hex escape in string literal",
                    "two hex digits after `\\x`",
                    "\\x",
                    "write two hexadecimal digits after `\\x`, e.g. `\\x41`",
                  ),
                )
                pos = pos + 2
                col = col + 2
              }
            } else if next_c == 117 {
              let ures = parse_unicode_escape(source, len, pos)
              if ures.ok {
                sb.write_char(ures.cp.unsafe_to_char())
              } else {
                diags.push(
                  diag_new(
                    span_new(file, line, col),
                    "E_PARSE",
                    ures.err_msg,
                    "valid unicode scalar escape `\\u{H...}`",
                    "\\u",
                    "write 1 to 6 hex digits inside `\\u{...}`, e.g. `\\u{0C}` or `\\u{4E2D}`",
                  ),
                )
              }
              col = col + (ures.next_pos - pos)
              pos = ures.next_pos
            } else {
              sb.write_char(next_c.unsafe_to_char())
              pos = pos + 2
              col = col + 2
            }
          } else {
            let un = str_scalar_len(source, pos, utf8)
            sb.write_char(str_scalar_at(source, pos, utf8).unsafe_to_char())
            pos = pos + un
            col = col + 1
          }
        }
        let sp = span_new(file, start_line, start_col)
        let raw = slice_str(source, start_pos, pos)
        if hit_interp {
          tokens.push(Token::{
            kind: InterpMid(sb.to_string()),
            span: sp,
            raw: raw,
            newline_before: nl,
          })
        } else if closed {
          let _ = interp_depths.pop()
          tokens.push(Token::{
            kind: InterpEnd(sb.to_string()),
            span: sp,
            raw: raw,
            newline_before: nl,
          })
        } else {
          let _ = interp_depths.pop()
          diags.push(
            diag_new(
              sp,
              "E_PARSE",
              "unterminated interpolated string literal",
              "closing `\"`",
              "end of line",
              "close the string literal with `\"`",
            ),
          )
        }
        continue
      }
    }

    // Identifiers and keywords
    if is_ident_start(ch) {
      pos = pos + 1
      col = col + 1
      while pos < len && is_ident_part(str_code_at(source, pos)) {
        pos = pos + 1
        col = col + 1
      }
      let word = source.slice(start_pos, pos)
      let sp = span_new(file, start_line, start_col)
      tokens.push(Token::{
        kind: keyword_or_ident(word),
        span: sp,
        raw: word,
        newline_before: nl,
      })
      continue
    }

    // Numbers: decimal, hex 0x..., Int64 ...L, Double ... . ...
    if is_digit(ch) {
      if ch == 48 &&
        pos + 1 < len &&
        (str_code_at(source, pos + 1) == 120 || str_code_at(source, pos + 1) == 88) {
        pos = pos + 2
        col = col + 2
        while pos < len &&
          (is_hex_digit(str_code_at(source, pos)) || str_code_at(source, pos) == 95) {
          pos = pos + 1
          col = col + 1
        }
        let mut is_i64 = false
        let mut is_u32 = false
        let mut is_u64 = false
        if pos + 1 < len &&
          str_code_at(source, pos) == 85 &&
          str_code_at(source, pos + 1) == 76 {
          is_u64 = true
          pos = pos + 2
          col = col + 2
        } else if pos < len && str_code_at(source, pos) == 85 {
          is_u32 = true
          pos = pos + 1
          col = col + 1
        } else if pos < len && str_code_at(source, pos) == 76 {
          is_i64 = true
          pos = pos + 1
          col = col + 1
        }
        let raw = source.slice(start_pos, pos)
        let sp = span_new(file, start_line, start_col)
        let k = if is_u64 {
          UInt64Lit(raw)
        } else if is_u32 {
          UIntLit(raw)
        } else if is_i64 {
          Int64Lit(raw)
        } else {
          IntLit(raw)
        }
        tokens.push(Token::{ kind: k, span: sp, raw: raw, newline_before: nl })
        continue
      }
      pos = pos + 1
      col = col + 1
      while pos < len &&
        (is_digit(str_code_at(source, pos)) || str_code_at(source, pos) == 95) {
        pos = pos + 1
        col = col + 1
      }
      let mut is_double = false
      if pos + 1 < len &&
        str_code_at(source, pos) == 46 &&
        is_digit(str_code_at(source, pos + 1)) {
        is_double = true
        pos = pos + 1
        col = col + 1
        while pos < len &&
          (is_digit(str_code_at(source, pos)) || str_code_at(source, pos) == 95) {
          pos = pos + 1
          col = col + 1
        }
      }
      if pos < len &&
        (str_code_at(source, pos) == 101 || str_code_at(source, pos) == 69) {
        let mut ep = pos + 1
        if ep < len &&
          (str_code_at(source, ep) == 43 || str_code_at(source, ep) == 45) {
          ep = ep + 1
        }
        if ep < len && is_digit(str_code_at(source, ep)) {
          is_double = true
          col = col + (ep - pos)
          pos = ep
          while pos < len &&
            (is_digit(str_code_at(source, pos)) || str_code_at(source, pos) == 95) {
            pos = pos + 1
            col = col + 1
          }
        }
      }
      let mut is_float = false
      let mut is_i64 = false
      let mut is_u32 = false
      let mut is_u64 = false
      if is_double &&
        pos < len &&
        str_code_at(source, pos) == 102 &&
        (pos + 1 >= len || !is_ident_part(str_code_at(source, pos + 1))) {
        is_float = true
        pos = pos + 1
        col = col + 1
      } else if !is_double &&
        pos + 1 < len &&
        str_code_at(source, pos) == 85 &&
        str_code_at(source, pos + 1) == 76 {
        is_u64 = true
        pos = pos + 2
        col = col + 2
      } else if !is_double && pos < len && str_code_at(source, pos) == 85 {
        is_u32 = true
        pos = pos + 1
        col = col + 1
      } else if !is_double && pos < len && str_code_at(source, pos) == 76 {
        is_i64 = true
        pos = pos + 1
        col = col + 1
      }
      let raw = source.slice(start_pos, pos)
      let sp = span_new(file, start_line, start_col)
      let k = if is_float {
        FloatLit(raw)
      } else if is_double {
        DoubleLit(raw)
      } else if is_u64 {
        UInt64Lit(raw)
      } else if is_u32 {
        UIntLit(raw)
      } else if is_i64 {
        Int64Lit(raw)
      } else {
        IntLit(raw)
      }
      tokens.push(Token::{ kind: k, span: sp, raw: raw, newline_before: nl })
      continue
    }

    // Three-char and two-char operators
    let sp = span_new(file, start_line, start_col)
    if pos + 2 < len &&
      ch == 61 &&
      str_code_at(source, pos + 1) == 61 &&
      str_code_at(source, pos + 2) == 61 {
      pos = pos + 3
      col = col + 3
      let d = diag_new(
        sp,
        "E_HABIT_STRICT_EQ",
        "Pion uses `==` (not `===`) for equality comparison",
        "`==`",
        "`===`",
        "replace `===` with `==`",
      )
      d.edits.push(
        text_edit_replace(
          file,
          start_line,
          start_col,
          start_line,
          start_col + 3,
          "==",
          "machine",
        ),
      )
      diags.push(d)
      tokens.push(Token::{ kind: EqEq, span: sp, raw: "==", newline_before: nl })
      continue
    }
    if pos + 2 < len &&
      ch == 33 &&
      str_code_at(source, pos + 1) == 61 &&
      str_code_at(source, pos + 2) == 61 {
      pos = pos + 3
      col = col + 3
      let d = diag_new(
        sp,
        "E_HABIT_STRICT_EQ",
        "Pion uses `!=` (not `!==`) for inequality comparison",
        "`!=`",
        "`!==`",
        "replace `!==` with `!=`",
      )
      d.edits.push(
        text_edit_replace(
          file,
          start_line,
          start_col,
          start_line,
          start_col + 3,
          "!=",
          "machine",
        ),
      )
      diags.push(d)
      tokens.push(Token::{ kind: BangEq, span: sp, raw: "!=", newline_before: nl })
      continue
    }
    if ch == 64 && pos + 1 < len && is_ident_start(str_code_at(source, pos + 1)) {
      let pkg_start = pos + 1
      let mut pkg_end = pkg_start + 1
      while pkg_end < len && is_ident_part(str_code_at(source, pkg_end)) {
        pkg_end = pkg_end + 1
      }
      if pkg_end + 1 < len &&
        str_code_at(source, pkg_end) == 46 &&
        is_ident_start(str_code_at(source, pkg_end + 1)) {
        let mem_start = pkg_end + 1
        let mut mem_end = mem_start + 1
        while mem_end < len && is_ident_part(str_code_at(source, mem_end)) {
          mem_end = mem_end + 1
        }
        let pkg_name = source.slice(pkg_start, pkg_end)
        let mem_name = source.slice(mem_start, mem_end)
        let total_len = mem_end - start_pos
        let d = diag_new(
          sp,
          "E_HABIT_MOONBIT_PKG",
          "Pion uses `::` (not MoonBit `@pkg.name`) for package-qualified names: write `" +
          pkg_name +
          "::" +
          mem_name +
          "`",
          "`" + pkg_name + "::" + mem_name + "`",
          "`@" + pkg_name + "." + mem_name + "`",
          "replace `@" + pkg_name + "." + mem_name + "` with `" + pkg_name + "::" + mem_name + "`",
        )
        d.edits.push(
          text_edit_replace(
            file,
            start_line,
            start_col,
            start_line,
            start_col + total_len,
            pkg_name + "::" + mem_name,
            "machine",
          ),
        )
        diags.push(d)
        let pkg_sp = span_new(file, start_line, start_col + 1)
        let dot_sp = span_new(file, start_line, start_col + 1 + pkg_name.length())
        let mem_sp = span_new(file, start_line, start_col + 2 + pkg_name.length())
        tokens.push(Token::{
          kind: Ident(pkg_name),
          span: pkg_sp,
          raw: pkg_name,
          newline_before: nl,
        })
        tokens.push(Token::{
          kind: ColonColon,
          span: dot_sp,
          raw: "::",
          newline_before: false,
        })
        tokens.push(Token::{
          kind: Ident(mem_name),
          span: mem_sp,
          raw: mem_name,
          newline_before: false,
        })
        pos = mem_end
        col = col + total_len
        continue
      }
    }
    if pos + 2 < len &&
      ch == 60 &&
      str_code_at(source, pos + 1) == 60 &&
      str_code_at(source, pos + 2) == 61 {
      pos = pos + 3
      col = col + 3
      tokens.push(Token::{ kind: LtLtEq, span: sp, raw: "<<=", newline_before: nl })
      continue
    }
    if pos + 2 < len &&
      ch == 62 &&
      str_code_at(source, pos + 1) == 62 &&
      str_code_at(source, pos + 2) == 61 {
      pos = pos + 3
      col = col + 3
      tokens.push(Token::{ kind: GtGtEq, span: sp, raw: ">>=", newline_before: nl })
      continue
    }
    if pos + 2 < len &&
      ch == 46 &&
      str_code_at(source, pos + 1) == 46 {
      let c3 = str_code_at(source, pos + 2)
      if c3 == 46 {
        pos = pos + 3
        col = col + 3
        tokens.push(Token::{ kind: Ellipsis, span: sp, raw: "...", newline_before: nl })
        continue
      }
      if c3 == 60 {
        pos = pos + 3
        col = col + 3
        tokens.push(Token::{ kind: DotDotLt, span: sp, raw: "..<", newline_before: nl })
        continue
      }
      if c3 == 61 {
        pos = pos + 3
        col = col + 3
        tokens.push(Token::{ kind: DotDotEq, span: sp, raw: "..=", newline_before: nl })
        continue
      }
    }
    if pos + 1 < len {
      let c2 = str_code_at(source, pos + 1)
      if ch == 124 && c2 == 62 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: PipeGt, span: sp, raw: "|>", newline_before: nl })
        continue
      }
      if ch == 43 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: PlusEq, span: sp, raw: "+=", newline_before: nl })
        continue
      }
      if ch == 45 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: MinusEq, span: sp, raw: "-=", newline_before: nl })
        continue
      }
      if ch == 42 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: StarEq, span: sp, raw: "*=", newline_before: nl })
        continue
      }
      if ch == 47 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: SlashEq, span: sp, raw: "/=", newline_before: nl })
        continue
      }
      if ch == 37 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: PercentEq, span: sp, raw: "%=", newline_before: nl })
        continue
      }
      if ch == 38 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: AmpEq, span: sp, raw: "&=", newline_before: nl })
        continue
      }
      if ch == 124 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: PipeEq, span: sp, raw: "|=", newline_before: nl })
        continue
      }
      if ch == 94 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: CaretEq, span: sp, raw: "^=", newline_before: nl })
        continue
      }
      if ch == 46 && c2 == 46 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: DotDot, span: sp, raw: "..", newline_before: nl })
        continue
      }
      if ch == 58 && c2 == 58 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: ColonColon, span: sp, raw: "::", newline_before: nl })
        continue
      }
      if ch == 45 && c2 == 62 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: Arrow, span: sp, raw: "->", newline_before: nl })
        continue
      }
      if ch == 61 && c2 == 62 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: FatArrow, span: sp, raw: "=>", newline_before: nl })
        continue
      }
      if ch == 61 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: EqEq, span: sp, raw: "==", newline_before: nl })
        continue
      }
      if ch == 33 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: BangEq, span: sp, raw: "!=", newline_before: nl })
        continue
      }
      if ch == 60 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: LtEq, span: sp, raw: "<=", newline_before: nl })
        continue
      }
      if ch == 62 && c2 == 61 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: GtEq, span: sp, raw: ">=", newline_before: nl })
        continue
      }
      if ch == 38 && c2 == 38 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: AmpAmp, span: sp, raw: "&&", newline_before: nl })
        continue
      }
      if ch == 124 && c2 == 124 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: PipePipe, span: sp, raw: "||", newline_before: nl })
        continue
      }
      if ch == 60 && c2 == 60 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: LtLt, span: sp, raw: "<<", newline_before: nl })
        continue
      }
      if ch == 62 && c2 == 62 {
        pos = pos + 2
        col = col + 2
        tokens.push(Token::{ kind: GtGt, span: sp, raw: ">>", newline_before: nl })
        continue
      }
    }

    // Single-char tokens
    pos = pos + 1
    col = col + 1
    let one = slice_str(source, start_pos, pos)
    let tok_kind = if ch == 40 {
      LParen
    } else if ch == 41 {
      RParen
    } else if ch == 123 {
      if interp_depths.length() > 0 {
        let top_idx = interp_depths.length() - 1
        interp_depths[top_idx] = interp_depths[top_idx] + 1
      }
      LBrace
    } else if ch == 125 {
      if interp_depths.length() > 0 {
        let top_idx = interp_depths.length() - 1
        if interp_depths[top_idx] > 0 {
          interp_depths[top_idx] = interp_depths[top_idx] - 1
        }
      }
      RBrace
    } else if ch == 91 {
      LBracket
    } else if ch == 93 {
      RBracket
    } else if ch == 44 {
      Comma
    } else if ch == 59 {
      Semi
    } else if ch == 58 {
      Colon
    } else if ch == 46 {
      Dot
    } else if ch == 63 {
      Question
    } else if ch == 126 {
      Tilde
    } else if ch == 35 {
      Hash
    } else if ch == 43 {
      Plus
    } else if ch == 45 {
      Minus
    } else if ch == 42 {
      Star
    } else if ch == 47 {
      Slash
    } else if ch == 37 {
      Percent
    } else if ch == 61 {
      Eq
    } else if ch == 60 {
      Lt
    } else if ch == 62 {
      Gt
    } else if ch == 33 {
      Bang
    } else if ch == 38 {
      Amp
    } else if ch == 124 {
      Pipe
    } else if ch == 94 {
      Caret
    } else {
      diags.push(
        diag_new(
          sp,
          "E_PARSE",
          "unexpected character `" + one + "`",
          "valid token",
          one,
          "remove or replace unexpected character `" + one + "`",
        ),
      )
      Invalid(one)
    }
    tokens.push(Token::{ kind: tok_kind, span: sp, raw: one, newline_before: nl })
  }

  tokens.push(Token::{
    kind: Eof,
    span: span_new(file, line, col),
    raw: "",
    newline_before: true,
  })
  LexResult::{ tokens: tokens, diagnostics: diags }
}
