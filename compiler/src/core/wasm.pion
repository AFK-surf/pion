}

///|
/// Pure-Wasm internal `pion_str_starts_with(s, pre)` / `pion_str_ends_with(s, suf)` -> i32.
fn wasm_build_str_affix_body(is_suffix : Bool) -> Array[Int] {
  // 5 i32 locals: 2=ps, 3=pp, 4=ls, 5=lp, 6=i
  let body : Array[Int] = [0x01, 0x05, 0x7F]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 5)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x4B) // lp > ls
  body.push(0x04); body.push(0x40); body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F); body.push(0x0B)
  if is_suffix {
    // ps = ps + (ls - lp)
    body.push(0x20); wasm_push_u32(body, 2)
    body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 5); body.push(0x6B)
    body.push(0x6A); body.push(0x21); wasm_push_u32(body, 2)
  }
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 5); body.push(0x4F)
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 6); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 6); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8)
  body.push(0x47)
  body.push(0x04); body.push(0x40); body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 6)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_arr_clear(a: i64) -> void`.
fn wasm_build_arr_clear_body(rc_dec_idx : Int) -> Array[Int] {
  // 4 i32 locals (1=p, 2=dp, 3=i, 4=n) + 1 i64 local (5=ev)
  let body : Array[Int] = [0x02, 0x04, 0x7F, 0x01, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 1) // p
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 16) // elem_is_obj
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24)
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2) // dp
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0xA7); body.push(0x21); wasm_push_u32(body, 4) // n
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 4); body.push(0x4F) // i >=_u n
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 5) // ev
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52) // ev != 0
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x10); wasm_push_u32(body, rc_dec_idx)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_bytes_new(len: i64) -> i64` (fast path for len <= 496 via shared slab).
fn wasm_build_bytes_new_body(alloc_uninit_idx : Int, slow_imp_idx : Int) -> Array[Int] {
  // 8 i32 locals (1=n, 2=cap, 3=need/new_hp, 4=cls, 5=alloc_sz, 6=base/p, 7=ctl, 8=dp/slot) + 1 i64 local (9=obj)
  let body : Array[Int] = [0x02, 0x08, 0x7F, 0x01, 0x7E]
  // if (len > 496L) return slow_imp(len)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x42); wasm_push_s64(body, 496L); body.push(0x55) // i64.gt_s
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x10); wasm_push_u32(body, slow_imp_idx); body.push(0x0F)
  body.push(0x0B)
  // n = len > 0L ? i32.wrap_i64(len) : 0
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x55)
  body.push(0x04); body.push(0x7F)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 1) // n
  // cap = n < 16 ? 16 : n
  body.push(0x41); wasm_push_s32(body, 16); body.push(0x48) // i32.lt_s
  body.push(0x04); body.push(0x7F)
  body.push(0x41); wasm_push_s32(body, 16)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 2) // cap
  // need = ((cap + 7) & -8) + 8
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x6A)
  body.push(0x41); wasm_push_s32(body, -8); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3) // need
  // Map need -> (cls, alloc_sz) for FREE_CLASSES[0..8] = [32, 48, 64, 96, 128, 192, 256, 384, 512]
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 64); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 32); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 32); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 48); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 48); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 64); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 192); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 96); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 3); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 96); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 128); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 4); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 128); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 5); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 192); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 256); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 6); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 256); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 384); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 384); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 512); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  // Pop slab freelist or bump from __pion_slab_ctl
  body.push(0x23); wasm_push_u32(body, 2); body.push(0x22); wasm_push_u32(body, 7) // ctl
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 8) // slot
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 6) // base
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x22); wasm_push_u32(body, 6) // base = heap_ptr
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 3) // new_hp
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 40)
  body.push(0x4B) // i32.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x10); wasm_push_u32(body, slow_imp_idx); body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x0B)
  // Write 8B raw block header + zero cap bytes
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 0x50494F4E)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 8) // dp
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0xFC); wasm_push_u32(body, 11); body.push(0x00) // memory.fill(dp, 0, cap)
  // Allocate PionBytes(24B, TAG_BYTES=2, drop_fn=0L)
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x10); wasm_push_u32(body, alloc_uninit_idx)
  body.push(0x22); wasm_push_u32(body, 9) // obj
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 6) // p
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // len=n
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 2); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap=cap
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 8); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 16) // dp
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_bytes_slice(b: i64, start: i64, end: i64) -> i64`.
fn wasm_build_bytes_slice_body(bytes_new_idx : Int) -> Array[Int] {
  // 3 i32 locals (3=pb, 4=n, 5=po) + 4 i64 locals (6=len, 7=a, 8=e, 9=out)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x04, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // pb
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x21); wasm_push_u32(body, 6) // len
  // a = start < 0 ? 0 : start
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x53)
  body.push(0x04); body.push(0x7E)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 7) // a
  // e = end > len ? len : end
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 6); body.push(0x55)
  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 8) // e
  // if (e < a) e = a
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x53)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x0B)
  // n = i32.wrap_i64(e - a)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x20); wasm_push_u32(body, 7); body.push(0x7D)
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 4) // n
  // out = pion_bytes_new(i64.extend_i32_u(n))
  body.push(0xAD)
  body.push(0x10); wasm_push_u32(body, bytes_new_idx)
  body.push(0x21); wasm_push_u32(body, 9) // out
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 5) // po
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_str_to_bytes(s: i64) -> i64`.
fn wasm_build_str_to_bytes_body(bytes_new_idx : Int) -> Array[Int] {
  // 3 i32 locals (1=ps, 2=len, 3=pb) + 1 i64 local (4=res)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x01, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 1) // ps
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 2) // len
  body.push(0xAD)
  body.push(0x10); wasm_push_u32(body, bytes_new_idx)
  body.push(0x21); wasm_push_u32(body, 4) // res
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 3) // pb
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_ptr_offset(p: i64, off: i64) -> i64`.
fn wasm_build_ptr_offset_body() -> Array[Int] {
  [0x00, 0x20, 0x00, 0x20, 0x01, 0x7C, 0x0B]
}

///|
/// Pure-Wasm internal `pion_ptr_read_{u8,i32,i64,ptr}(p: i64, off: i64)`.
/// load_op: 0x2D (i32.load8_u), 0x28 (i32.load), 0x29 (i64.load)
fn wasm_build_ptr_read_body(load_op : Int) -> Array[Int] {
  [0x00, 0x20, 0x00, 0xA7, 0x20, 0x01, 0xA7, 0x6A, load_op, 0x00, 0x00, 0x0B]
}

///|
/// Pure-Wasm internal `pion_ptr_write_{u8,i32,i64,ptr}(p: i64, off: i64, v)`.
/// store_op: 0x3A (i32.store8), 0x36 (i32.store), 0x37 (i64.store)
fn wasm_build_ptr_write_body(store_op : Int) -> Array[Int] {
  [0x00, 0x20, 0x00, 0xA7, 0x20, 0x01, 0xA7, 0x6A, 0x20, 0x02, store_op, 0x00, 0x00, 0x0B]
}

///|
/// Compile QBE SSA text directly into a valid WebAssembly 32-bit (.wasm) binary.
pub fn emit_wasm_from_ssa(ssa : String) -> Bytes {
  emit_wasm_from_ssa_units_traced([ssa], fn(_s : String) -> Unit { () })
}

///|
pub fn emit_wasm_from_ssa_units(units : Array[String]) -> Bytes {
  emit_wasm_from_ssa_units_traced(units, fn(_s : String) -> Unit { () })
}

///|
pub fn emit_wasm_from_ssa_units_traced(
  units : Array[String],
  on_stage : (String) -> Unit,
) -> Bytes {
  let p1 = wasm_parse_ssa_live_units(units, on_stage)
  on_stage("parse_p3_live_funcs(funcs=" + p1.funcs.length().to_string() + ",datas=" + p1.datas.length().to_string() + ")")
  let parsed = wasm_dedup_module(p1)
  on_stage("wasm_dedup_module(funcs=" + parsed.funcs.length().to_string() + ",datas=" + parsed.datas.length().to_string() + ")")

  let ctx = WasmModCtx::{
    sigs: [],
    sig_map: Map([]),
    import_names: [],
    import_sigs: [],
    import_ret_tys: [],
    import_map: Map([]),
    internal_map: Map([]),
    internal_ret_tys: Map([]),
    data_addrs: Map([]),
    fn_table_idx: Map([]),
    fn_table_list: [],
  }

  // 1. Lay out static data starting at WASM_DATA_BASE
  let mut cur_addr = WASM_DATA_BASE
  let mut di = 0
  while di < parsed.datas.length() {
    let dd = parsed.datas[di]
    cur_addr = wasm_align_up(cur_addr, dd.align)
    dd.addr = cur_addr
    ctx.data_addrs.set(dd.name, cur_addr)
    let mut ii = 0
    while ii < dd.items.length() {
      cur_addr = cur_addr + wasm_data_item_size(dd.items[ii])
      ii = ii + 1
    }
    di = di + 1
  }
  let static_end = cur_addr
  let slab_ctl_addr = wasm_align_up(static_end, 16)
  let heap_base = slab_ctl_addr + 64

  // 2. Register internal function names (indices will be shifted after imports are known)
  let internal_def_set : Map[String, Int] = Map([])
  let mut fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    internal_def_set.set(f.name, fi)
    ctx.internal_ret_tys.set(f.name, f.ret_ty)
    fi = fi + 1
  }

  // 3. Discover external imports from direct call instructions
  // Pure-Wasm internal fast paths are emitted on demand; slow paths call their JS imports.
  let imp_param_tys : Map[String, Array[Int]] = Map([])
  let imp_ret_ty : Map[String, Int] = Map([])
  let imp_order : Array[String] = []
  let mut uses_rc_inc = false
  let mut uses_rc_dec = false
  let mut uses_alloc = false
  let mut uses_alloc_uninit = false
  let mut uses_str_eq = false
  let mut uses_int_to_str = false
  let mut uses_str_concat = false
  let mut uses_str_concat_n = false
  let mut uses_map_has = false
  let mut uses_map_get = false
  let mut uses_map_try_get = false
  let mut uses_map_set = false
  let mut uses_arr_new = false
  let mut uses_arr_push = false
  let mut uses_arr_push_owned = false
  let mut uses_arr_set = false
  let mut uses_arr_pop = false
  let mut uses_arr_clear = false
  let mut uses_bytes_new = false
  let mut uses_bytes_slice = false
  let mut uses_bytes_to_str = false
  let mut uses_str_to_bytes = false
  let mut uses_strbuf_push_byte = false
  let mut uses_strbuf_push_char = false
  let mut uses_strbuf_push_str = false
  let mut uses_strbuf_push_int = false
  let mut uses_strbuf_reset = false
  let mut uses_strbuf_to_str = false
  let mut uses_str_slice = false
  let mut uses_str_cmp = false
  let mut uses_str_starts_with = false
  let mut uses_str_ends_with = false
  let mut uses_ptr_offset = false
  let mut uses_ptr_read_u8 = false
  let mut uses_ptr_read_i32 = false
  let mut uses_ptr_read_i64 = false
  let mut uses_ptr_read_ptr = false
  let mut uses_ptr_write_u8 = false
  let mut uses_ptr_write_i32 = false
  let mut uses_ptr_write_i64 = false
  let mut uses_ptr_write_ptr = false
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    let mut bi = 0
    while bi < f.blocks.length() {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if inst.op == "call" && inst.args.length() > 0 {
          let callee = inst.args[0]
          if str_code_at(callee, 0) == 36 {
            let sym = slice_str(callee, 1, callee.length())
            match internal_def_set.get(sym) {
              Some(_) => ()
              None =>
                if sym == "pion_rc_inc" {
                  uses_rc_inc = true
                } else if sym == "pion_rc_dec" {
                  uses_rc_dec = true
                  match imp_param_tys.get("pion_rc_dec_slow") {
                    None => {
                      imp_order.push("pion_rc_dec_slow")
                      imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
                      imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
                    }
                    Some(_) => ()
                  }
                } else if sym == "pion_str_eq" {
                  uses_str_eq = true
                } else if sym == "pion_int_to_str" {
                  uses_int_to_str = true
                } else if sym == "pion_str_concat" {
                  uses_str_concat = true
                } else if sym == "pion_map_has" {
                  uses_map_has = true
                } else if sym == "pion_map_get" {
                  uses_map_get = true
                } else if sym == "pion_map_try_get" {
                  uses_map_try_get = true
                } else if sym == "pion_arr_set" {
                  uses_arr_set = true
                } else if sym == "pion_arr_pop" {
                  uses_arr_pop = true
                } else if sym == "pion_arr_clear" {
                  uses_arr_clear = true
                } else if sym == "pion_bytes_slice" {
                  uses_bytes_slice = true
                } else if sym == "pion_bytes_to_str" {
                  uses_bytes_to_str = true
                } else if sym == "pion_str_to_bytes" {
                  uses_str_to_bytes = true
                } else if sym == "pion_strbuf_reset" {
                  uses_strbuf_reset = true
                } else if sym == "pion_strbuf_to_str" {
                  uses_strbuf_to_str = true
                } else if sym == "pion_str_slice" {
                  uses_str_slice = true
                } else if sym == "pion_str_cmp" {
                  uses_str_cmp = true
                } else if sym == "pion_str_starts_with" {
                  uses_str_starts_with = true
                } else if sym == "pion_str_ends_with" {
                  uses_str_ends_with = true
                } else if sym == "pion_ptr_offset" {
                  uses_ptr_offset = true
                } else if sym == "pion_ptr_read_u8" {
                  uses_ptr_read_u8 = true
                } else if sym == "pion_ptr_read_i32" {
                  uses_ptr_read_i32 = true
                } else if sym == "pion_ptr_read_i64" {
                  uses_ptr_read_i64 = true
                } else if sym == "pion_ptr_read_ptr" {
                  uses_ptr_read_ptr = true
                } else if sym == "pion_ptr_write_u8" {
                  uses_ptr_write_u8 = true
                } else if sym == "pion_ptr_write_i32" {
                  uses_ptr_write_i32 = true
                } else if sym == "pion_ptr_write_i64" {
                  uses_ptr_write_i64 = true
                } else if sym == "pion_ptr_write_ptr" {
                  uses_ptr_write_ptr = true
                } else {
                  if sym == "pion_alloc" {
                    uses_alloc = true
                  } else if sym == "pion_alloc_uninit" {
                    uses_alloc_uninit = true
                  } else if sym == "pion_str_concat_n" {
                    uses_str_concat_n = true
                  } else if sym == "pion_map_set" {
                    uses_map_set = true
                  } else if sym == "pion_arr_new" {
                    uses_arr_new = true
                  } else if sym == "pion_arr_push" {
                    uses_arr_push = true
                  } else if sym == "pion_arr_push_owned" {
                    uses_arr_push_owned = true
                  } else if sym == "pion_strbuf_push_byte" {
                    uses_strbuf_push_byte = true
                  } else if sym == "pion_strbuf_push_char" {
                    uses_strbuf_push_char = true
                  } else if sym == "pion_strbuf_push_str" {
                    uses_strbuf_push_str = true
                  } else if sym == "pion_strbuf_push_int" {
                    uses_strbuf_push_int = true
                  } else if sym == "pion_bytes_new" {
                    uses_bytes_new = true
                  }
                  match imp_param_tys.get(sym) {
                    None => {
                      imp_order.push(sym)
                      imp_param_tys.set(sym, inst.arg_tys)
                      imp_ret_ty.set(sym, inst.dst_ty)
                    }
                    Some(_) =>
                      if inst.dst_ty != WASM_TY_VOID {
                        imp_ret_ty.set(sym, inst.dst_ty)
                      }
                  }
                }
            }
          }
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
    fi = fi + 1
  }

  // Dependency propagation for pure-Wasm String, HashMap, Array & StringBuilder fast paths
  let uses_map_find = uses_map_has || uses_map_get || uses_map_try_get
  let uses_map_hash = uses_map_find || uses_map_set
  if uses_map_hash {
    uses_str_eq = true
  }
  if uses_arr_push {
    uses_rc_inc = true
  }
  if uses_map_set || uses_arr_set {
    uses_rc_inc = true
    uses_rc_dec = true
    match imp_param_tys.get("pion_rc_dec_slow") {
      None => {
        imp_order.push("pion_rc_dec_slow")
        imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
        imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_arr_clear {
    uses_rc_dec = true
    match imp_param_tys.get("pion_rc_dec_slow") {
      None => {
        imp_order.push("pion_rc_dec_slow")
        imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
        imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_bytes_slice || uses_str_to_bytes {
    uses_bytes_new = true
    match imp_param_tys.get("pion_bytes_new") {
      None => {
        imp_order.push("pion_bytes_new")
        imp_param_tys.set("pion_bytes_new", [WASM_TY_I64])
        imp_ret_ty.set("pion_bytes_new", WASM_TY_I64)
      }
      Some(_) => ()
    }
  }
  if uses_arr_set || uses_arr_pop {
    match imp_param_tys.get("pion_panic_oob") {
      None => {
        imp_order.push("pion_panic_oob")
        imp_param_tys.set("pion_panic_oob", [WASM_TY_I64, WASM_TY_I64])
        imp_ret_ty.set("pion_panic_oob", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_int_to_str ||
    uses_str_concat ||
    uses_str_concat_n ||
    uses_arr_new ||
    uses_bytes_new ||
    uses_bytes_to_str ||
    uses_strbuf_to_str ||
    uses_str_slice {
    uses_alloc_uninit = true
    match imp_param_tys.get("pion_alloc_uninit") {
      None => {
        imp_order.push("pion_alloc_uninit")
        imp_param_tys.set(
          "pion_alloc_uninit",
          [WASM_TY_I32, WASM_TY_I32, WASM_TY_I64],
        )
        imp_ret_ty.set("pion_alloc_uninit", WASM_TY_I64)
      }
      Some(_) => ()
    }
  }

  // Finalize import indices 0..num_imports-1
  let mut imi = 0
  while imi < imp_order.length() {
    let sym = imp_order[imi]
    let ptys = match imp_param_tys.get(sym) {
      Some(p) => p
      None => []
    }
    let rty = match imp_ret_ty.get(sym) {
      Some(r) => r
      None => WASM_TY_VOID
    }
    let sidx = wasm_intern_sig(ctx, ptys, rty)
    ctx.import_map.set(sym, imi)
    ctx.import_names.push(sym)
    ctx.import_sigs.push(sidx)
    ctx.import_ret_tys.push(rty)
    imi = imi + 1
  }
  let num_imports = imp_order.length()

  // Finalize internal function indices num_imports..
  let internal_sig_idxs : Array[Int] = []
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    ctx.internal_map.set(f.name, num_imports + fi)
    internal_sig_idxs.push(wasm_intern_sig(ctx, f.param_tys, f.ret_ty))
    fi = fi + 1
  }
  let mut rc_inc_internal_idx = -1
  if uses_rc_inc {
    let inc_idx = num_imports + internal_sig_idxs.length()
    rc_inc_internal_idx = inc_idx
    ctx.internal_map.set("pion_rc_inc", inc_idx)
    ctx.internal_ret_tys.set("pion_rc_inc", WASM_TY_VOID)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_VOID))
  }
  let mut rc_dec_slow_internal_idx = -1
  let mut rc_dec_internal_idx = -1
  let mut drop_sig_idx = -1
  if uses_rc_dec {
    let void_i64_sig = wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_VOID)
    drop_sig_idx = void_i64_sig
    let slow_int_idx = num_imports + internal_sig_idxs.length()
    rc_dec_slow_internal_idx = slow_int_idx
    ctx.internal_map.set("pion_rc_dec_slow", slow_int_idx)
    ctx.internal_ret_tys.set("pion_rc_dec_slow", WASM_TY_VOID)
    internal_sig_idxs.push(void_i64_sig)
    let dec_idx = num_imports + internal_sig_idxs.length()
    rc_dec_internal_idx = dec_idx
    ctx.internal_map.set("pion_rc_dec", dec_idx)
    ctx.internal_ret_tys.set("pion_rc_dec", WASM_TY_VOID)
    internal_sig_idxs.push(void_i64_sig)
  }
  if uses_alloc {
    let alloc_idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_alloc", alloc_idx)
    ctx.internal_ret_tys.set("pion_alloc", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I32, WASM_TY_I32, WASM_TY_I64], WASM_TY_I64),
    )
  }
  let mut alloc_uninit_internal_idx = -1
  if uses_alloc_uninit {
    let alloc_u_idx = num_imports + internal_sig_idxs.length()
    alloc_uninit_internal_idx = alloc_u_idx
    ctx.internal_map.set("pion_alloc_uninit", alloc_u_idx)
    ctx.internal_ret_tys.set("pion_alloc_uninit", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I32, WASM_TY_I32, WASM_TY_I64], WASM_TY_I64),
    )
  }
  let mut str_eq_internal_idx = -1
  if uses_str_eq {
    let idx = num_imports + internal_sig_idxs.length()
    str_eq_internal_idx = idx
    ctx.internal_map.set("pion_str_eq", idx)
    ctx.internal_ret_tys.set("pion_str_eq", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_int_to_str {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_int_to_str", idx)
    ctx.internal_ret_tys.set("pion_int_to_str", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_str_concat {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_concat", idx)
    ctx.internal_ret_tys.set("pion_str_concat", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_str_concat_n {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_concat_n", idx)
    ctx.internal_ret_tys.set("pion_str_concat_n", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  let mut map_hash_internal_idx = -1
  if uses_map_hash {
    let idx = num_imports + internal_sig_idxs.length()
    map_hash_internal_idx = idx
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I32], WASM_TY_I64),
    )
  }
  let mut map_find_internal_idx = -1
  if uses_map_find {
    let idx = num_imports + internal_sig_idxs.length()
    map_find_internal_idx = idx
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I32, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_map_has {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_map_has", idx)
    ctx.internal_ret_tys.set("pion_map_has", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_map_get {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_map_get", idx)
    ctx.internal_ret_tys.set("pion_map_get", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_map_try_get {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_map_try_get", idx)
    ctx.internal_ret_tys.set("pion_map_try_get", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_map_set {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_map_set", idx)
    ctx.internal_ret_tys.set("pion_map_set", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_arr_new {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_new", idx)
    ctx.internal_ret_tys.set("pion_arr_new", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I32], WASM_TY_I64),
    )
  }
  if uses_arr_push {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_push", idx)
    ctx.internal_ret_tys.set("pion_arr_push", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_arr_push_owned {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_push_owned", idx)
    ctx.internal_ret_tys.set("pion_arr_push_owned", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_arr_set {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_set", idx)
    ctx.internal_ret_tys.set("pion_arr_set", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_arr_pop {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_pop", idx)
    ctx.internal_ret_tys.set("pion_arr_pop", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_arr_clear {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_arr_clear", idx)
    ctx.internal_ret_tys.set("pion_arr_clear", WASM_TY_VOID)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_VOID))
  }
  let mut bytes_new_internal_idx = -1
  if uses_bytes_new {
    let idx = num_imports + internal_sig_idxs.length()
    bytes_new_internal_idx = idx
    ctx.internal_map.set("pion_bytes_new", idx)
    ctx.internal_ret_tys.set("pion_bytes_new", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_bytes_slice {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_bytes_slice", idx)
    ctx.internal_ret_tys.set("pion_bytes_slice", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_bytes_to_str {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_bytes_to_str", idx)
    ctx.internal_ret_tys.set("pion_bytes_to_str", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_str_to_bytes {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_to_bytes", idx)
    ctx.internal_ret_tys.set("pion_str_to_bytes", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_strbuf_push_byte {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_push_byte", idx)
    ctx.internal_ret_tys.set("pion_strbuf_push_byte", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I32], WASM_TY_VOID),
    )
  }
  if uses_strbuf_push_char {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_push_char", idx)
    ctx.internal_ret_tys.set("pion_strbuf_push_char", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I32], WASM_TY_VOID),
    )
  }
  if uses_strbuf_push_str {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_push_str", idx)
    ctx.internal_ret_tys.set("pion_strbuf_push_str", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_strbuf_push_int {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_push_int", idx)
    ctx.internal_ret_tys.set("pion_strbuf_push_int", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_strbuf_reset {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_reset", idx)
    ctx.internal_ret_tys.set("pion_strbuf_reset", WASM_TY_VOID)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_VOID))
  }
  if uses_strbuf_to_str {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_to_str", idx)
    ctx.internal_ret_tys.set("pion_strbuf_to_str", WASM_TY_I64)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_I64))
  }
  if uses_str_slice {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_slice", idx)
    ctx.internal_ret_tys.set("pion_str_slice", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_str_cmp {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_cmp", idx)
    ctx.internal_ret_tys.set("pion_str_cmp", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_str_starts_with {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_starts_with", idx)
    ctx.internal_ret_tys.set("pion_str_starts_with", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_str_ends_with {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_str_ends_with", idx)
    ctx.internal_ret_tys.set("pion_str_ends_with", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_ptr_offset {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_offset", idx)
    ctx.internal_ret_tys.set("pion_ptr_offset", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_ptr_read_u8 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_read_u8", idx)
    ctx.internal_ret_tys.set("pion_ptr_read_u8", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_ptr_read_i32 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_read_i32", idx)
    ctx.internal_ret_tys.set("pion_ptr_read_i32", WASM_TY_I32)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I32),
    )
  }
  if uses_ptr_read_i64 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_read_i64", idx)
    ctx.internal_ret_tys.set("pion_ptr_read_i64", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_ptr_read_ptr {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_read_ptr", idx)
    ctx.internal_ret_tys.set("pion_ptr_read_ptr", WASM_TY_I64)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64], WASM_TY_I64),
    )
  }
  if uses_ptr_write_u8 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_write_u8", idx)
    ctx.internal_ret_tys.set("pion_ptr_write_u8", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I32], WASM_TY_VOID),
    )
  }
  if uses_ptr_write_i32 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_write_i32", idx)
    ctx.internal_ret_tys.set("pion_ptr_write_i32", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I32], WASM_TY_VOID),
    )
  }
  if uses_ptr_write_i64 {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_write_i64", idx)
    ctx.internal_ret_tys.set("pion_ptr_write_i64", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }
  if uses_ptr_write_ptr {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_ptr_write_ptr", idx)
    ctx.internal_ret_tys.set("pion_ptr_write_ptr", WASM_TY_VOID)
    internal_sig_idxs.push(
      wasm_intern_sig(ctx, [WASM_TY_I64, WASM_TY_I64, WASM_TY_I64], WASM_TY_VOID),
    )
  }

  // 4. Discover address-taken internal functions (in data sections & non-direct-callee operands)
  di = 0
  while di < parsed.datas.length() {
    let dd = parsed.datas[di]
    let mut ii = 0
    while ii < dd.items.length() {
      let item = dd.items[ii]
      if item.kind == "l" && item.raw.length() > 1 && str_code_at(item.raw, 0) == 36 {
        let s = wasm_trim(item.raw)
        let plus = wasm_find_char(s, 43, 1)
        let minus = wasm_find_char(s, 45, 1)
        let sym = if plus > 0 {
          wasm_trim(slice_str(s, 1, plus))
        } else if minus > 0 {
          wasm_trim(slice_str(s, 1, minus))
        } else {
          slice_str(s, 1, s.length())
        }
        wasm_register_fn_addr(ctx, sym)
      }
      ii = ii + 1
    }
    di = di + 1
  }
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    let mut bi = 0
    while bi < f.blocks.length() {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if inst.op == "call" && inst.args.length() > 0 && str_code_at(inst.args[0], 0) != 36 {
          // Pre-intern indirect call signature so ctx is 100% read-only during parallel compile
          let _ = wasm_intern_sig(ctx, inst.arg_tys, inst.dst_ty)
        }
        let start_arg = if inst.op == "call" { 1 } else { 0 }
        let mut ai = start_arg
        while ai < inst.args.length() {
          wasm_scan_sym_operand(ctx, inst.args[ai])
          ai = ai + 1
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
    fi = fi + 1
  }

  // 5. Compile all internal function bodies
  on_stage("wasm_layout_imports")
  let code_bodies : Array[Array[Int]] = []
  fi = 0
  while fi < parsed.funcs.length() {
    code_bodies.push(wasm_compile_func(ctx, parsed.funcs[fi]))
    fi = fi + 1
  }
  if uses_rc_inc {
    code_bodies.push(wasm_build_rc_inc_body())
  }
  if uses_rc_dec {
    let slow_imp_idx = match ctx.import_map.get("pion_rc_dec_slow") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_rc_dec_slow_body(slow_imp_idx, drop_sig_idx))
    code_bodies.push(wasm_build_rc_dec_body(rc_dec_slow_internal_idx))
  }
  if uses_alloc {
    let alloc_imp_idx = match ctx.import_map.get("pion_alloc") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_alloc_body(alloc_imp_idx, true))
  }
  if uses_alloc_uninit {
    let alloc_u_imp_idx = match ctx.import_map.get("pion_alloc_uninit") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_alloc_body(alloc_u_imp_idx, false))
  }
  if uses_str_eq {
    code_bodies.push(wasm_build_str_eq_body())
  }
  if uses_int_to_str {
    code_bodies.push(wasm_build_int_to_str_body(alloc_uninit_internal_idx))
  }
  if uses_str_concat {
    code_bodies.push(wasm_build_str_concat_body(alloc_uninit_internal_idx))
  }
  if uses_str_concat_n {
    let concat_n_imp_idx = match ctx.import_map.get("pion_str_concat_n") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_str_concat_n_body(alloc_uninit_internal_idx, concat_n_imp_idx),
    )
  }
  if uses_map_hash {
    code_bodies.push(wasm_build_map_hash_body())
  }
  if uses_map_find {
    code_bodies.push(
      wasm_build_map_find_body(map_hash_internal_idx, str_eq_internal_idx),
    )
  }
  if uses_map_has {
    code_bodies.push(wasm_build_map_has_body(map_find_internal_idx))
  }
  if uses_map_get {
    code_bodies.push(wasm_build_map_get_body(map_find_internal_idx))
  }
  if uses_map_try_get {
    code_bodies.push(wasm_build_map_try_get_body(map_find_internal_idx))
  }
  if uses_map_set {
    let map_set_imp_idx = match ctx.import_map.get("pion_map_set") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_map_set_body(
        map_set_imp_idx,
        map_hash_internal_idx,
        str_eq_internal_idx,
        rc_inc_internal_idx,
        rc_dec_internal_idx,
      ),
    )
  }
  if uses_arr_new {
    let arr_new_imp_idx = match ctx.import_map.get("pion_arr_new") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_arr_new_body(alloc_uninit_internal_idx, arr_new_imp_idx),
    )
  }
  if uses_arr_push {
    let arr_push_imp_idx = match ctx.import_map.get("pion_arr_push") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_arr_push_body(arr_push_imp_idx, rc_inc_internal_idx),
    )
  }
  if uses_arr_push_owned {
    let arr_po_imp_idx = match ctx.import_map.get("pion_arr_push_owned") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_arr_push_body(arr_po_imp_idx, -1))
  }
  if uses_arr_set {
    let panic_oob_idx = match ctx.import_map.get("pion_panic_oob") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_arr_set_body(
        panic_oob_idx,
        rc_inc_internal_idx,
        rc_dec_internal_idx,
      ),
    )
  }
  if uses_arr_pop {
    let panic_oob_idx = match ctx.import_map.get("pion_panic_oob") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_arr_pop_body(panic_oob_idx))
  }
  if uses_arr_clear {
    code_bodies.push(wasm_build_arr_clear_body(rc_dec_internal_idx))
  }
  if uses_bytes_new {
    let bytes_new_imp_idx = match ctx.import_map.get("pion_bytes_new") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(
      wasm_build_bytes_new_body(alloc_uninit_internal_idx, bytes_new_imp_idx),
    )
  }
  if uses_bytes_slice {
    code_bodies.push(wasm_build_bytes_slice_body(bytes_new_internal_idx))
  }
  if uses_bytes_to_str {
    code_bodies.push(wasm_build_strbuf_to_str_body(alloc_uninit_internal_idx))
  }
  if uses_str_to_bytes {
    code_bodies.push(wasm_build_str_to_bytes_body(bytes_new_internal_idx))
  }
  if uses_strbuf_push_byte {
    let sb_pb_imp_idx = match ctx.import_map.get("pion_strbuf_push_byte") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_strbuf_push_byte_body(sb_pb_imp_idx, false))
  }
  if uses_strbuf_push_char {
    let sb_pc_imp_idx = match ctx.import_map.get("pion_strbuf_push_char") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_strbuf_push_byte_body(sb_pc_imp_idx, true))
  }
  if uses_strbuf_push_str {
    let sb_ps_imp_idx = match ctx.import_map.get("pion_strbuf_push_str") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_strbuf_push_str_body(sb_ps_imp_idx))
  }
  if uses_strbuf_push_int {
    let sb_pi_imp_idx = match ctx.import_map.get("pion_strbuf_push_int") {
      Some(k) => k
      None => 0
    }
    code_bodies.push(wasm_build_strbuf_push_int_body(sb_pi_imp_idx))
  }
  if uses_strbuf_reset {
    code_bodies.push(wasm_build_strbuf_reset_body())
  }
  if uses_strbuf_to_str {
    code_bodies.push(wasm_build_strbuf_to_str_body(alloc_uninit_internal_idx))
  }
  if uses_str_slice {
    code_bodies.push(wasm_build_str_slice_body(alloc_uninit_internal_idx))
  }
  if uses_str_cmp {
    code_bodies.push(wasm_build_str_cmp_body())
  }
  if uses_str_starts_with {
    code_bodies.push(wasm_build_str_affix_body(false))
  }
  if uses_str_ends_with {
    code_bodies.push(wasm_build_str_affix_body(true))
  }
  if uses_ptr_offset {
    code_bodies.push(wasm_build_ptr_offset_body())
  }
  if uses_ptr_read_u8 {
    code_bodies.push(wasm_build_ptr_read_body(0x2D))
  }
  if uses_ptr_read_i32 {
    code_bodies.push(wasm_build_ptr_read_body(0x28))
  }
  if uses_ptr_read_i64 {
    code_bodies.push(wasm_build_ptr_read_body(0x29))
  }
  if uses_ptr_read_ptr {
    code_bodies.push(wasm_build_ptr_read_body(0x29))
  }
  if uses_ptr_write_u8 {
    code_bodies.push(wasm_build_ptr_write_body(0x3A))
  }
  if uses_ptr_write_i32 {
    code_bodies.push(wasm_build_ptr_write_body(0x36))
  }
  if uses_ptr_write_i64 {
    code_bodies.push(wasm_build_ptr_write_body(0x37))
  }
  if uses_ptr_write_ptr {
    code_bodies.push(wasm_build_ptr_write_body(0x37))
  }
  on_stage("wasm_compile_func(n=" + code_bodies.length().to_string() + ")")

  // 6. Materialize static data bytes
  let data_bytes : Array[Int] = []
  if static_end > WASM_DATA_BASE {
    let mut pos = WASM_DATA_BASE
    di = 0
    while di < parsed.datas.length() {
      let dd = parsed.datas[di]
      while pos < dd.addr {
        data_bytes.push(0)
        pos = pos + 1
      }
      let mut ii = 0
      while ii < dd.items.length() {
        let item = dd.items[ii]
        if item.kind == "b" {
          if item.raw.length() > 0 && str_code_at(item.raw, 0) == 34 {
            let bs = wasm_unescape_qbe_str(item.raw)
            wasm_push_bytes(data_bytes, bs)
            pos = pos + bs.length()
          } else {
            data_bytes.push(wasm_parse_int64(item.raw).to_int() & 0xFF)
            pos = pos + 1
          }
        } else if item.kind == "h" {
          let v = wasm_parse_int64(item.raw).to_int()
          data_bytes.push(v & 0xFF)
          data_bytes.push(ushr32(v, 8) & 0xFF)
          pos = pos + 2
        } else if item.kind == "w" {
          let v = wasm_parse_int64(item.raw).to_int()
          wasm_push_i32_le(data_bytes, v)
          pos = pos + 4
        } else if item.kind == "l" {
          let v = wasm_eval_data_sym_expr(ctx, item.raw)
          wasm_push_i64_le(data_bytes, v)
          pos = pos + 8
        } else if item.kind == "s" {
          let raw_f = if item.raw.starts_with("s_") {
            slice_str(item.raw, 2, item.raw.length())
          } else {
            item.raw
          }
          let bits32 = wasm_f64_bits_to_f32_bits(wasm_parse_double_bits(raw_f))
          wasm_push_i32_le(data_bytes, bits32)
          pos = pos + 4
        } else if item.kind == "d" {
          let raw_d = if item.raw.starts_with("d_") {
            slice_str(item.raw, 2, item.raw.length())
          } else {
            item.raw
          }
          let bits64 = wasm_parse_double_bits(raw_d)
          wasm_push_i64_le(data_bytes, bits64)
          pos = pos + 8
        } else if item.kind == "z" {
          let zn = wasm_parse_int64(item.raw).to_int()
          let mut zi = 0
          while zi < zn {
            data_bytes.push(0)
            zi = zi + 1
          }
          pos = pos + zn
        }
        ii = ii + 1
      }
      di = di + 1
    }
  }

  // 7. Assemble Wasm32 binary module
  let out : Array[Int] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00]

  // Section 1: Type Section
  let sec_type : Array[Int] = []
  wasm_push_u32(sec_type, ctx.sigs.length())
  let mut si = 0
  while si < ctx.sigs.length() {
    let sg = ctx.sigs[si]
    sec_type.push(0x60)
    wasm_push_u32(sec_type, sg.param_tys.length())
    let mut pi = 0
    while pi < sg.param_tys.length() {
      sec_type.push(wasm_valtype_byte(sg.param_tys[pi]))
      pi = pi + 1
    }
    if sg.ret_ty == WASM_TY_VOID {
      sec_type.push(0x00)
    } else {
      sec_type.push(0x01)
      sec_type.push(wasm_valtype_byte(sg.ret_ty))
    }
    si = si + 1
  }
  wasm_push_section(out, 1, sec_type)

  // Section 2: Import Section
  if ctx.import_names.length() > 0 {
    let sec_imp : Array[Int] = []
    wasm_push_u32(sec_imp, ctx.import_names.length())
    imi = 0
    while imi < ctx.import_names.length() {
      wasm_push_str(sec_imp, "pion_rt")
      wasm_push_str(sec_imp, ctx.import_names[imi])
      sec_imp.push(0x00) // func import
      wasm_push_u32(sec_imp, ctx.import_sigs[imi])
      imi = imi + 1
    }
    wasm_push_section(out, 2, sec_imp)
  }

  // Section 3: Function Section
  if internal_sig_idxs.length() > 0 {
    let sec_fn : Array[Int] = []
    wasm_push_u32(sec_fn, internal_sig_idxs.length())
    fi = 0
    while fi < internal_sig_idxs.length() {
      wasm_push_u32(sec_fn, internal_sig_idxs[fi])
      fi = fi + 1
    }
    wasm_push_section(out, 3, sec_fn)
  }

  // Section 4: Table Section (1 funcref table, slot 0 reserved null)
  let table_len = ctx.fn_table_list.length() + 1
  let sec_tbl : Array[Int] = []
  wasm_push_u32(sec_tbl, 1)
  sec_tbl.push(0x70) // funcref
  sec_tbl.push(0x00) // min only
  wasm_push_u32(sec_tbl, table_len)
  wasm_push_section(out, 4, sec_tbl)

  // Section 5: Memory Section (static data + 16 pages = 1 MB initial heap; grows on demand)
  let needed_pages = (heap_base / 65536) + 16
  let min_pages = if needed_pages > 16 { needed_pages } else { 16 }
  let sec_mem : Array[Int] = []
  wasm_push_u32(sec_mem, 1)
  sec_mem.push(0x00) // min only
  wasm_push_u32(sec_mem, min_pages)
  wasm_push_section(out, 5, sec_mem)

  // Section 6: Global Section (global 0 = __pion_stack_ptr mut i32, global 1 = __heap_base const i32, global 2 = __pion_slab_ctl const i32)
  let sec_glob : Array[Int] = []
  wasm_push_u32(sec_glob, 3)
  sec_glob.push(0x7F) // i32
  sec_glob.push(0x01) // mut
  sec_glob.push(0x41) // i32.const
  wasm_push_s32(sec_glob, WASM_STACK_BASE)
  sec_glob.push(0x0B)
  sec_glob.push(0x7F) // i32
  sec_glob.push(0x00) // const
  sec_glob.push(0x41) // i32.const
  wasm_push_s32(sec_glob, heap_base)
  sec_glob.push(0x0B)
  sec_glob.push(0x7F) // i32
  sec_glob.push(0x00) // const
  sec_glob.push(0x41) // i32.const
  wasm_push_s32(sec_glob, slab_ctl_addr)
  sec_glob.push(0x0B)
  wasm_push_section(out, 6, sec_glob)

  // Section 7: Export Section
  let exp_names : Array[String] = [
    "memory",
    "__indirect_function_table",
    "__heap_base",
    "__pion_slab_ctl",
  ]
  let exp_kinds : Array[Int] = [0x02, 0x01, 0x03, 0x03]
  let exp_idxs : Array[Int] = [0, 0, 1, 2]
  let has_explicit_roots = wasm_has_explicit_roots(parsed.funcs)
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    if wasm_is_export_root(f, has_explicit_roots) {
      exp_names.push(f.name)
      exp_kinds.push(0x00)
      exp_idxs.push(num_imports + fi)
    }
    fi = fi + 1
  }
  let sec_exp : Array[Int] = []
  wasm_push_u32(sec_exp, exp_names.length())
  let mut ei = 0
  while ei < exp_names.length() {
    wasm_push_str(sec_exp, exp_names[ei])
    sec_exp.push(exp_kinds[ei])
    wasm_push_u32(sec_exp, exp_idxs[ei])
    ei = ei + 1
  }
  wasm_push_section(out, 7, sec_exp)

  // Section 9: Element Section (populate slots 1..N)
  if ctx.fn_table_list.length() > 0 {
    let sec_elem : Array[Int] = []
    wasm_push_u32(sec_elem, 1)
    sec_elem.push(0x00) // table 0 active
    sec_elem.push(0x41) // i32.const 1
    wasm_push_s32(sec_elem, 1)
    sec_elem.push(0x0B)
    wasm_push_u32(sec_elem, ctx.fn_table_list.length())
    let mut ti = 0
    while ti < ctx.fn_table_list.length() {
      let tname = ctx.fn_table_list[ti]
      let fidx = match ctx.internal_map.get(tname) {
        Some(k) => k
        None =>
          match ctx.import_map.get(tname) {
            Some(k) => k
            None => 0
          }
      }
      wasm_push_u32(sec_elem, fidx)
      ti = ti + 1
    }
    wasm_push_section(out, 9, sec_elem)
  }

  // Direct single-pass byte writer for Header+Sec1..9 + Section 10 (Code) + Section 11 (Data)
  // Eliminates allocating multi-megabyte sec_code / sec_data / out Array[Int] copies.
  let mut sec10_payload_len = 0
  let mut sec10_total_len = 0
  if code_bodies.length() > 0 {
    sec10_payload_len = wasm_u32_len(code_bodies.length())
    fi = 0
    while fi < code_bodies.length() {
      let blen = code_bodies[fi].length()
      sec10_payload_len = sec10_payload_len + wasm_u32_len(blen) + blen
      fi = fi + 1
    }
    sec10_total_len = 1 + wasm_u32_len(sec10_payload_len) + sec10_payload_len
  }

  let sec11_hdr : Array[Int] = []
  let mut sec11_payload_len = 0
  let mut sec11_total_len = 0
  if data_bytes.length() > 0 {
    wasm_push_u32(sec11_hdr, 1)
    sec11_hdr.push(0x00) // mem 0 active
    sec11_hdr.push(0x41) // i32.const WASM_DATA_BASE
    wasm_push_s32(sec11_hdr, WASM_DATA_BASE)
    sec11_hdr.push(0x0B)
    wasm_push_u32(sec11_hdr, data_bytes.length())
    sec11_payload_len = sec11_hdr.length() + data_bytes.length()
    sec11_total_len = 1 + wasm_u32_len(sec11_payload_len) + sec11_payload_len
  }

  let total_len = out.length() + sec10_total_len + sec11_total_len
  let p = ptr_alloc(total_len.to_int64())
  let mut woff = 0
  woff = wasm_ptr_write_arr(p, woff, out)
  if code_bodies.length() > 0 {
    ptr_write_u8(p, woff.to_int64(), 10)
    woff = woff + 1
    woff = wasm_ptr_write_u32(p, woff, sec10_payload_len)
    woff = wasm_ptr_write_u32(p, woff, code_bodies.length())
    fi = 0
    while fi < code_bodies.length() {
      let body = code_bodies[fi]
      woff = wasm_ptr_write_u32(p, woff, body.length())
      woff = wasm_ptr_write_arr(p, woff, body)
      fi = fi + 1
    }
  }
  if data_bytes.length() > 0 {
    ptr_write_u8(p, woff.to_int64(), 11)
    woff = woff + 1
    woff = wasm_ptr_write_u32(p, woff, sec11_payload_len)
    woff = wasm_ptr_write_arr(p, woff, sec11_hdr)
    woff = wasm_ptr_write_arr(p, woff, data_bytes)
  }
  let res_bytes = bytes_from_ptr(p, total_len)
  ptr_free(p)
  on_stage("wasm_sections_and_bytes(bytes=" + res_bytes.length().to_string() + ")")
  res_bytes
}
