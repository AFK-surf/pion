  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0x50494F4E00000030L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0x0110000100000000L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0x50494F4E00000040L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0x0210000100000000L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0x0000000100000001L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 24)
  // dst = base + 32; store len; dst += 8; short copy; NUL; return base + 32
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 5) // base + 32
  body.push(0x20); wasm_push_u32(body, 4); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 5) // payload dst = base + 40
