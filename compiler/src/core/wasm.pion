  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
