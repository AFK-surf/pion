///|
/// Pure-Wasm internal `pion_str_starts_with(s, pre)` / `pion_str_ends_with(s, suf)` -> i32.
fn wasm_build_str_affix_body(is_suffix : Bool) -> Array[Int] {
  // 5 i32 locals: 2=ps, 3=pp, 4=ls, 5=lp, 6=i
  let body : Array[Int] = [0x01, 0x05, 0x7F]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 5)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x4B) // lp > ls
  body.push(0x04); body.push(0x40); body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F); body.push(0x0B)
  if is_suffix {
    // ps = ps + (ls - lp)
    body.push(0x20); wasm_push_u32(body, 2)
    body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 5); body.push(0x6B)
    body.push(0x6A); body.push(0x21); wasm_push_u32(body, 2)
  }
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 5); body.push(0x4F)
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 6); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 6); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8)
  body.push(0x47)
  body.push(0x04); body.push(0x40); body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 6)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_arr_clear(a: i64) -> void` (P82-A: supports both standard 8B
/// arrays and flat inline RC struct arrays with `stride > 8` + `i32.ctz(mask)`).
fn wasm_build_arr_clear_body(rc_dec_idx : Int) -> Array[Int] {
  // 8 i32 locals (1=p, 2=dp, 3=i/elem_ptr, 4=n/end_ptr, 5=mask, 6=stride, 7=m, 8=bit) + 1 i64 local (9=ev)
  let body : Array[Int] = [0x02, 0x08, 0x7F, 0x01, 0x7E]
  // p = i32.wrap_i64(param 0); n = i32.wrap_i64(i64.load(p + 0)); i64.store(p + 0, 0L)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 1)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0xA7); body.push(0x21); wasm_push_u32(body, 4) // n
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  // mask = i32.load(p + 16); if (mask != 0 && n > 0)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x22); wasm_push_u32(body, 5) // mask
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x47) // mask != 0
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x4A) // n >_s 0
  body.push(0x71) // i32.and
  body.push(0x04); body.push(0x40)
  // dp = i32.wrap_i64(i64.load(p + 24)); if (dp != 0)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24)
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2) // dp
  body.push(0x04); body.push(0x40)
  // stride = i32.load(p + 20); if (stride <= 8)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x22); wasm_push_u32(body, 6) // stride
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x4C) // stride <=_s 8
  body.push(0x04); body.push(0x40)
  // Standard 8B object array: i = 0; while (i < n) { ev = i64.load(dp + (i << 3)); if (ev != 0) rc_dec(ev); i++ }
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 4); body.push(0x4F) // i >=_u n
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 9) // ev
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52) // ev != 0
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0x10); wasm_push_u32(body, rc_dec_idx)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B) // end loop
  body.push(0x0B) // end block
  // Flat inline RC struct array (stride > 8): pointer-increment outer loop + i32.ctz(mask) inner loop
  body.push(0x05)
  // end_ptr (4) = dp (2) + n (4) * stride (6); elem_ptr (3) = dp (2)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x6C) // i32.mul
  body.push(0x6A) // i32.add
  body.push(0x21); wasm_push_u32(body, 4) // end_ptr
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x21); wasm_push_u32(body, 3) // elem_ptr
  body.push(0x02); body.push(0x40) // outer block
  body.push(0x03); body.push(0x40) // outer loop
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 4); body.push(0x4F) // elem_ptr >=_u end_ptr
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x21); wasm_push_u32(body, 7) // m = mask
  body.push(0x02); body.push(0x40) // inner block
  body.push(0x03); body.push(0x40) // inner loop
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x45) // m == 0
  body.push(0x0D); wasm_push_u32(body, 1)
  // bit (8) = i32.ctz(m); m &= m - 1
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x68); body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B); body.push(0x71)
  body.push(0x21); wasm_push_u32(body, 7)
  // ev (9) = i64.load(elem_ptr + (bit << 3)); if (ev != 0L) call rc_dec_idx(ev)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 9)
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0x10); wasm_push_u32(body, rc_dec_idx)
  body.push(0x0B)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B) // end inner loop
  body.push(0x0B) // end inner block
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 6); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3) // elem_ptr += stride
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B) // end outer loop
  body.push(0x0B) // end outer block
  body.push(0x0B) // end if (stride <= 8)
  body.push(0x0B) // end if (dp != 0)
  body.push(0x0B) // end if (mask != 0 && n > 0)
  body.push(0x0B) // end fn
  body
}

///|
/// Pure-Wasm internal `pion_bytes_new(len: i64) -> i64` (fast path for len <= 496 via shared slab).
fn wasm_build_bytes_new_body(alloc_uninit_idx : Int, slow_imp_idx : Int) -> Array[Int] {
  // 8 i32 locals (1=n, 2=cap, 3=need/new_hp, 4=cls, 5=alloc_sz, 6=base/p, 7=ctl, 8=dp/slot) + 1 i64 local (9=obj)
  let body : Array[Int] = [0x02, 0x08, 0x7F, 0x01, 0x7E]
  // if (u64(len) > 496uL) return slow_imp(len) (handles len < 0 trap and len > 496)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x42); wasm_push_s64(body, 496L); body.push(0x56) // i64.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x10); wasm_push_u32(body, slow_imp_idx); body.push(0x0F)
  body.push(0x0B)
  // n = len > 0L ? i32.wrap_i64(len) : 0
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x55)
  body.push(0x04); body.push(0x7F)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 1) // n
  // cap = n < 16 ? 16 : n
  body.push(0x41); wasm_push_s32(body, 16); body.push(0x48) // i32.lt_s
  body.push(0x04); body.push(0x7F)
  body.push(0x41); wasm_push_s32(body, 16)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 2) // cap
  // need = ((cap + 7) & -8) + 8
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x6A)
  body.push(0x41); wasm_push_s32(body, -8); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3) // need
  // Map need -> (cls, alloc_sz) for FREE_CLASSES[0..8] = [32, 48, 64, 96, 128, 192, 256, 384, 512]
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 64); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 32); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 32); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 48); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 48); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 64); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 192); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 96); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 3); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 96); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 128); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 4); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 128); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 5); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 192); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 256); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 6); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 256); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 384); body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 384); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 512); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  // Pop slab freelist or bump from __pion_slab_ctl
  body.push(0x23); wasm_push_u32(body, 2); body.push(0x22); wasm_push_u32(body, 7) // ctl
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 8) // slot
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 6) // base
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x22); wasm_push_u32(body, 6) // base = heap_ptr
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 3) // new_hp
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 40)
  body.push(0x4B) // i32.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x10); wasm_push_u32(body, slow_imp_idx); body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x0B)
  // Write 8B raw block header + zero cap bytes
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 0x50494F4E)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 8) // dp
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0xFC); wasm_push_u32(body, 11); body.push(0x00) // memory.fill(dp, 0, cap)
  // Allocate PionBytes(24B, TAG_BYTES=2, drop_fn=0L)
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x10); wasm_push_u32(body, alloc_uninit_idx)
  body.push(0x22); wasm_push_u32(body, 9) // obj
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 6) // p
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // len=n
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 2); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap=cap
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 8); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 16) // dp
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_bytes_slice(b: i64, start: i64, end: i64) -> i64`.
fn wasm_build_bytes_slice_body(bytes_new_idx : Int) -> Array[Int] {
  // 3 i32 locals (3=pb, 4=n, 5=po) + 4 i64 locals (6=len, 7=a, 8=e, 9=out)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x04, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // pb
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x21); wasm_push_u32(body, 6) // len
  // a = start < 0 ? 0 : start
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x53)
  body.push(0x04); body.push(0x7E)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 7) // a
  // e = end > len ? len : end
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 6); body.push(0x55)
  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 8) // e
  // if (e < a) e = a
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x53)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x0B)
  // n = i32.wrap_i64(e - a)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x20); wasm_push_u32(body, 7); body.push(0x7D)
  body.push(0xA7); body.push(0x22); wasm_push_u32(body, 4) // n
  // out = pion_bytes_new(i64.extend_i32_u(n))
  body.push(0xAD)
  body.push(0x10); wasm_push_u32(body, bytes_new_idx)
  body.push(0x21); wasm_push_u32(body, 9) // out
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 5) // po
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_str_to_bytes(s: i64) -> i64`.
fn wasm_build_str_to_bytes_body(bytes_new_idx : Int) -> Array[Int] {
  // 3 i32 locals (1=ps, 2=len, 3=pb) + 1 i64 local (4=res)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x01, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 1) // ps
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 2) // len
  body.push(0xAD)
  body.push(0x10); wasm_push_u32(body, bytes_new_idx)
  body.push(0x21); wasm_push_u32(body, 4) // res
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0xA7); body.push(0x21); wasm_push_u32(body, 3) // pb
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_ptr_offset(p: i64, off: i64) -> i64`.
fn wasm_build_ptr_offset_body() -> Array[Int] {
  [0x00, 0x20, 0x00, 0x20, 0x01, 0x7C, 0x0B]
}

///|
/// Pure-Wasm internal `pion_ptr_read_{u8,i32,i64,ptr}(p: i64, off: i64)`.
/// load_op: 0x2D (i32.load8_u), 0x28 (i32.load), 0x29 (i64.load)
fn wasm_build_ptr_read_body(load_op : Int) -> Array[Int] {
  [0x00, 0x20, 0x00, 0xA7, 0x20, 0x01, 0xA7, 0x6A, load_op, 0x00, 0x00, 0x0B]
}

///|
/// Pure-Wasm internal `pion_ptr_write_{u8,i32,i64,ptr}(p: i64, off: i64, v)`.
/// store_op: 0x3A (i32.store8), 0x36 (i32.store), 0x37 (i64.store)
fn wasm_build_ptr_write_body(store_op : Int) -> Array[Int] {
  [0x00, 0x20, 0x00, 0xA7, 0x20, 0x01, 0xA7, 0x6A, 0x20, 0x02, store_op, 0x00, 0x00, 0x0B]
}

///|
/// Compile QBE SSA text directly into a valid WebAssembly 32-bit (.wasm) binary.
pub fn emit_wasm_from_ssa(ssa : String) -> Bytes {
  emit_wasm_from_ssa_units_opts([ssa], false, fn(_s : String) -> Unit { () })
}

///|
pub fn emit_wasm_from_ssa_opts(ssa : String, emit_names : Bool) -> Bytes {
  emit_wasm_from_ssa_units_opts([ssa], emit_names, fn(_s : String) -> Unit { () })
}

///|
pub fn emit_wasm_from_ssa_units(units : Array[String]) -> Bytes {
  emit_wasm_from_ssa_units_opts(units, false, fn(_s : String) -> Unit { () })
}

///|
fn wasm_load_op_for_ty(ty : Int) -> String {
  if ty == WASM_TY_I32 {
    "loadw"
  } else if ty == WASM_TY_I64 {
    "loadl"
  } else if ty == WASM_TY_F32 {
    "loads"
  } else {
    "loadd"
  }
}

///|
fn wasm_store_op_for_ty(ty : Int) -> String {
  if ty == WASM_TY_I32 {
    "storew"
  } else if ty == WASM_TY_I64 {
    "storel"
  } else if ty == WASM_TY_F32 {
    "stores"
  } else {
    "stored"
  }
}

///|
fn wasm_is_work_op(op : String) -> Bool {
  wasm_is_mem_load_op(op) || wasm_is_mem_store_op(op) ||
    op == "mul" || op == "div" || op == "udiv" || op == "rem" || op == "urem" ||
    op == "call" || op == "swtof" || op == "sltof" || op == "dtosi" || op == "dtoui" || op == "stosi" || op == "stoui"
}

///|
fn wasm_is_int_cmp_op(op : String) -> Bool {
  op == "csltl" || op == "cslel" || op == "cultl" || op == "culel" ||
    op == "csltw" || op == "cslew" || op == "cultw" || op == "culew" ||
    op == "csgtl" || op == "csgel" || op == "cugtl" || op == "cugel" ||
    op == "csgtw" || op == "csgew" || op == "cugtw" || op == "cugew" ||
    op == "ceql" || op == "cnel" || op == "ceqw" || op == "cnew"
}

///|
fn wasm_is_small_const_le64(s : String) -> Bool {
  let n = s.length()
  if n == 0 || n > 2 {
    return false
  }
  let mut i = 0
  while i < n {
    let ch = str_code_at(s, i)
    if ch < 48 || ch > 57 {
      return false
    }
    i = i + 1
  }
  wasm_parse_int64(s) <= 64L
}

///|
fn wasm_block_has_small_const_jnz(blk : WasmBlock) -> Bool {
  let n = blk.insts.length()
  if n < 2 {
    return false
  }
  let term = blk.insts[n - 1]
  if term.op != "jnz" || term.args.length() < 1 {
    return false
  }
  let cond_sym = term.args[0]
  let mut i = n - 2
  while i >= 0 {
    let inst = blk.insts[i]
    if inst.dst == cond_sym {
      if wasm_is_int_cmp_op(inst.op) && inst.args.length() == 2 {
        return wasm_is_small_const_le64(inst.args[0]) || wasm_is_small_const_le64(inst.args[1])
      }
      return false
    }
    i = i - 1
  }
  false
}

///|
/// P45-A / P46-A: SSA-level nested hot loop outlining (depth == 2 loops inside an outer loop).
/// Outlining inner loops into standalone Wasm functions allows default Node/V8 to tier-up
/// hot loops from Liftoff to TurboFan automatically (zero CLI flags).
fn wasm_outline_nested_loops(funcs : Array[WasmFunc]) -> Array[WasmFunc] {
  // Pre-scan: collect functions directly called inside any hot/dynamic loop (not small-const <= 64).
  // V8 already tiers up callees called inside large/dynamic loops (e.g. nbody::advance in while s < 7M),
  // whereas callees only called inside small-const loops (e.g. spectral_norm::mul_av in while r < 10)
  // still need nested-loop outlining to trigger TurboFan tier-up.
  let called_in_loop : Map[String, Bool] = Map([])
  let mut pfi = 0
  while pfi < funcs.length() {
    let pf = funcs[pfi]
    let pnb = pf.blocks.length()
    if pnb > 1 {
      let pbidx : Map[String, Int] = Map([])
      let mut pbi = 0
      while pbi < pnb {
        pbidx.set(pf.blocks[pbi].label, pbi)
        pbi = pbi + 1
      }
      let ple = wasm_analyze_structured_cfg(pf, pbidx)
      if ple.length() == pnb {
        let in_hot_loop : Array[Bool] = []
        pbi = 0
        while pbi < pnb {
          in_hot_loop.push(false)
          pbi = pbi + 1
        }
        pbi = 0
        while pbi < pnb {
          if ple[pbi] >= 0 {
            let ke = ple[pbi]
            let small_bound = wasm_block_has_small_const_jnz(pf.blocks[pbi]) ||
              wasm_block_has_small_const_jnz(pf.blocks[ke])
            if !small_bound {
              let mut k = pbi
              while k <= ke {
                in_hot_loop[k] = true
                k = k + 1
              }
            }
          }
          pbi = pbi + 1
        }
        pbi = 0
        while pbi < pnb {
          if in_hot_loop[pbi] {
            let insts = pf.blocks[pbi].insts
            let mut ii = 0
            while ii < insts.length() {
              let inst = insts[ii]
              if inst.op == "call" && inst.args.length() > 0 && str_code_at(inst.args[0], 0) == 36 {
                let csym = slice_str(inst.args[0], 1, inst.args[0].length())
                called_in_loop.set(csym, true)
              }
              ii = ii + 1
            }
          }
          pbi = pbi + 1
        }
      }
    }
    pfi = pfi + 1
  }

  let out_funcs : Array[WasmFunc] = []
  let extra_funcs : Array[WasmFunc] = []
  let mut ol_seq = 0
  let mut fi = 0
  while fi < funcs.length() {
    let f = funcs[fi]
    let nb = f.blocks.length()
    if nb < 4 || called_in_loop.contains(f.name) {
      out_funcs.push(f)
      fi = fi + 1
      continue
    }

    let block_idx : Map[String, Int] = Map([])
    let local_ty : Map[String, Int] = Map([])
    let def_counts : Map[String, Int] = Map([])
    let param_set : Map[String, Bool] = Map([])
    let mut pi = 0
    while pi < f.param_names.length() {
      local_ty.set(f.param_names[pi], f.param_tys[pi])
      param_set.set(f.param_names[pi], true)
      wasm_inc_sym_count(def_counts, f.param_names[pi])
      pi = pi + 1
    }
    let mut bi = 0
    while bi < nb {
      block_idx.set(f.blocks[bi].label, bi)
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if inst.dst.length() > 0 && inst.dst_ty != WASM_TY_VOID {
          if !local_ty.contains(inst.dst) {
            local_ty.set(inst.dst, inst.dst_ty)
          }
          wasm_inc_sym_count(def_counts, inst.dst)
        }
        ii = ii + 1
      }
      bi = bi + 1
    }

    let loop_end = wasm_analyze_structured_cfg(f, block_idx)
    if loop_end.length() != nb {
      out_funcs.push(f)
      fi = fi + 1
      continue
    }

    // Find all depth == 2 loop headers (strictly inside exactly 1 enclosing loop)
    let cand_hdrs : Array[Int] = []
    bi = 0
    while bi < nb {
      if loop_end[bi] >= 0 {
        let e = loop_end[bi]
        let mut enclosing = 0
        let mut oh = 0
        while oh < bi {
          if loop_end[oh] >= 0 && e <= loop_end[oh] {
            enclosing = enclosing + 1
          }
          oh = oh + 1
        }
        if enclosing == 1 {
          cand_hdrs.push(bi)
        }
      }
      bi = bi + 1
    }
    if cand_hdrs.length() == 0 {
      out_funcs.push(f)
      fi = fi + 1
      continue
    }

    // Promoted scalar alloc analysis (identical criteria to wasm_compile_func)
    let cand_names : Array[String] = []
    let slot_ok : Map[String, Bool] = Map([])
    let slot_ty : Map[String, Int] = Map([])
    let all_allocs : Array[String] = []
    let entry_single_allocs : Map[String, Bool] = Map([])
    bi = 0
    while bi < nb {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if (inst.op == "alloc4" || inst.op == "alloc8" || inst.op == "alloc16") && inst.dst.length() > 0 {
          all_allocs.push(inst.dst)
          if bi == 0 {
            let sz = if inst.args.length() > 0 { wasm_parse_int64(inst.args[0]).to_int() } else { 8 }
            let dcnt = match def_counts.get(inst.dst) { Some(c) => c; None => 0 }
            if dcnt == 1 && !param_set.contains(inst.dst) {
              entry_single_allocs.set(inst.dst, true)
              if sz >= 1 && sz <= 8 {
                cand_names.push(inst.dst)
                slot_ok.set(inst.dst, true)
                slot_ty.set(inst.dst, -1)
              }
            }
          }
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
    let has_cands = cand_names.length() > 0
    if has_cands {
      bi = 0
      while bi < nb {
        let insts = f.blocks[bi].insts
        let mut ii = 0
        while ii < insts.length() {
          let inst = insts[ii]
          let op = inst.op
          if op == "phi" {
            let mut k = 0
            while k + 1 < inst.args.length() {
              wasm_escape_slot(slot_ok, inst.args[k + 1])
              k = k + 2
            }
          } else if op == "storel" || op == "storew" || op == "stores" || op == "stored" {
            if inst.args.length() >= 2 {
              let v_op = wasm_trim(inst.args[0])
              let a_op = wasm_trim(inst.args[1])
              wasm_escape_slot(slot_ok, v_op)
              if a_op != v_op {
                let req_ty = if op == "storel" { WASM_TY_I64 } else if op == "storew" { WASM_TY_I32 } else if op == "stores" { WASM_TY_F32 } else { WASM_TY_F64 }
                wasm_mark_slot_type(slot_ok, slot_ty, a_op, req_ty)
              }
            }
          } else if op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" || op == "loads" || op == "loadd" {
            if inst.args.length() >= 1 {
              let a_op = wasm_trim(inst.args[0])
              let req_ty = if op == "loadl" { WASM_TY_I64 } else if op == "loads" { WASM_TY_F32 } else if op == "loadd" { WASM_TY_F64 } else { WASM_TY_I32 }
              wasm_mark_slot_type(slot_ok, slot_ty, a_op, req_ty)
            }
          } else {
            let mut ai = 0
            while ai < inst.args.length() {
              wasm_escape_slot(slot_ok, inst.args[ai])
              ai = ai + 1
            }
          }
          ii = ii + 1
        }
        bi = bi + 1
      }
    }
    let promoted_alloc_ty : Map[String, Int] = Map([])
    let mut ci = 0
    while ci < cand_names.length() {
      let cname = cand_names[ci]
      match slot_ok.get(cname) {
        Some(true) => {
          let sty = match slot_ty.get(cname) { Some(t) => t; None => -1 }
          if sty >= 0 {
            promoted_alloc_ty.set(cname, sty)
          }
        }
        _ => ()
      }
      ci = ci + 1
    }
    // P51-A: entry-block single-def allocs (`entry_single_allocs`) remain alive on the caller's
    // shadow stack across outlined calls, so non-promoted entry allocs can be safely passed as
    // read-only `i64` `in_ssa` pointer parameters; only non-entry or multi-def allocs are forbidden.
    let non_promoted_allocs : Map[String, Bool] = Map([])
    ci = 0
    while ci < all_allocs.length() {
      let aname = all_allocs[ci]
      if !promoted_alloc_ty.contains(aname) && !entry_single_allocs.contains(aname) {
        non_promoted_allocs.set(aname, true)
      }
      ci = ci + 1
    }

    // Evaluate each depth-2 candidate loop
    let ol_hdr_stub : Map[Int, WasmBlock] = Map([])
    let ol_skip_blk : Map[Int, Bool] = Map([])
    let ol_entry_allocs : Array[WasmInst] = []
    let mut any_outlined = false

    let mut chi = 0
    while chi < cand_hdrs.length() {
      let hdr = cand_hdrs[chi]
      let end = loop_end[hdr]
      chi = chi + 1

      // Reject if hdr has any phi
      let mut hdr_has_phi = false
      let mut ii = 0
      while ii < f.blocks[hdr].insts.length() {
        if f.blocks[hdr].insts[ii].op == "phi" {
          hdr_has_phi = true
          break
        }
        ii = ii + 1
      }
      if hdr_has_phi {
        continue
      }

      // Check admissibility: single exit, no ret/alloc/jtbl-exit/non-promoted-alloc, non-trivial work.
      // P48-A: cold trap blocks ending in `hlt` (e.g. `@arr_oob_*` bounds-check panics) are legal inside
      // outlined loops (Wasm `unreachable` traps identically from an outlined callee); mark `terminated = true`
      // on `hlt` so `bi + 1` is not mistaken for a fallthrough exit edge, and exclude cold trap blocks from
      // `inst_cnt` / `has_work` so tiny loops are not artificially promoted by panic blocks.
      let mut exit_blk = -1
      let mut valid = true
      let mut has_inner = false
      let mut inst_cnt = 0
      let mut has_work = false
      let mut has_hlt = false
      bi = hdr
      while bi <= end && valid {
        if loop_end[bi] == -2 {
          bi = bi + 1
          continue
        }
        if bi > hdr && loop_end[bi] >= 0 {
          has_inner = true
        }
        let insts = f.blocks[bi].insts
        let is_trap_blk = insts.length() > 0 && insts[insts.length() - 1].op == "hlt"
        if is_trap_blk {
          has_hlt = true
        } else {
          inst_cnt = inst_cnt + insts.length()
        }
        let mut terminated = false
        ii = 0
        while ii < insts.length() && valid {
          let inst = insts[ii]
          let op = inst.op
          if op == "ret" || op == "alloc4" || op == "alloc8" || op == "alloc16" {
            valid = false
            break
          }
          if !is_trap_blk && (inst.dst_ty == WASM_TY_F32 || inst.dst_ty == WASM_TY_F64 || wasm_is_work_op(op)) {
            has_work = true
          }
          if op == "phi" {
            let mut k = 0
            while k + 1 < inst.args.length() {
              let a = wasm_trim(inst.args[k + 1])
              if non_promoted_allocs.contains(a) { valid = false; break }
              k = k + 2
            }
          } else {
            let mut ai = 0
            while ai < inst.args.length() {
              let a = wasm_trim(inst.args[ai])
              if non_promoted_allocs.contains(a) { valid = false; break }
              ai = ai + 1
            }
          }
          if !valid { break }
          if op == "hlt" {
            terminated = true
          } else if op == "jmp" && inst.args.length() >= 1 {
            terminated = true
            match block_idx.get(inst.args[0]) {
              Some(t) =>
                if t < hdr || t > end {
                  if exit_blk < 0 { exit_blk = t } else if exit_blk != t { valid = false }
                }
              None => ()
            }
          } else if op == "jnz" && inst.args.length() >= 3 {
            terminated = true
            match block_idx.get(inst.args[1]) {
              Some(t1) =>
                if t1 < hdr || t1 > end {
                  if exit_blk < 0 { exit_blk = t1 } else if exit_blk != t1 { valid = false }
                }
              None => ()
            }
            match block_idx.get(inst.args[2]) {
              Some(t2) =>
                if t2 < hdr || t2 > end {
                  if exit_blk < 0 { exit_blk = t2 } else if exit_blk != t2 { valid = false }
                }
              None => ()
            }
          } else if op == "jtbl" && inst.args.length() >= 2 {
            terminated = true
            let mut ai = 1
            while ai < inst.args.length() {
              match block_idx.get(inst.args[ai]) {
                Some(t) => if t < hdr || t > end { valid = false }
                None => ()
              }
              ai = ai + 1
            }
          }
          ii = ii + 1
        }
        if valid && !terminated && bi + 1 < nb {
          let t = bi + 1
          if t < hdr || t > end {
            if exit_blk < 0 { exit_blk = t } else if exit_blk != t { valid = false }
          }
        }
        bi = bi + 1
      }
      // P48-A: loops containing `hlt` trap blocks (e.g. `@arr_oob_*`) are outlined only when
      // `has_inner` is true (depth >= 3 nested loops such as fannkuch_redux `while k != 0` /
      // `while r != n`), avoiding outlining cold BCE-slow fallback loops or tiny single-level
      // loops like `while r > 1` whose call overhead outweighs tier-up gain.
      if !valid || exit_blk < 0 || (has_hlt && !has_inner) || (!has_inner && (inst_cnt < 8 || !has_work)) {
        continue
      }

      // Check exit_blk has no phi referencing any block in [hdr .. end]
      let mut exit_has_loop_phi = false
      ii = 0
      while ii < f.blocks[exit_blk].insts.length() {
        let inst = f.blocks[exit_blk].insts[ii]
        if inst.op == "phi" {
          let mut k = 0
          while k + 1 < inst.args.length() {
            match block_idx.get(inst.args[k]) {
              Some(pidx) => if pidx >= hdr && pidx <= end { exit_has_loop_phi = true }
              None => ()
            }
            k = k + 2
          }
        }
        ii = ii + 1
      }
      if exit_has_loop_phi {
        continue
      }

      // Live-in / live-out analysis
      let slot_read_in : Map[String, Bool] = Map([])
      let slot_write_in : Map[String, Bool] = Map([])
      let slot_read_out : Map[String, Bool] = Map([])
      let touched_slots : Array[String] = []
      let touched_slot_seen : Map[String, Bool] = Map([])

      let ssa_def_in : Map[String, Bool] = Map([])
      let ssa_use_in : Map[String, Bool] = Map([])
      let ssa_def_out : Map[String, Bool] = Map([])
      let ssa_use_out : Map[String, Bool] = Map([])
      let ssa_in_order : Array[String] = []
      let ssa_in_seen : Map[String, Bool] = Map([])
      let ssa_def_in_order : Array[String] = []
      let ssa_def_in_seen : Map[String, Bool] = Map([])

      pi = 0
      while pi < f.param_names.length() {
        ssa_def_out.set(f.param_names[pi], true)
        pi = pi + 1
      }

      bi = 0
      while bi < nb {
        if loop_end[bi] == -2 {
          bi = bi + 1
          continue
        }
        let in_loop = bi >= hdr && bi <= end
        let insts = f.blocks[bi].insts
        ii = 0
        while ii < insts.length() {
          let inst = insts[ii]
          let op = inst.op
          if inst.dst.length() > 0 && inst.dst_ty != WASM_TY_VOID &&
            !promoted_alloc_ty.contains(inst.dst) && !non_promoted_allocs.contains(inst.dst) {
            if in_loop {
              ssa_def_in.set(inst.dst, true)
              if !ssa_def_in_seen.contains(inst.dst) {
                ssa_def_in_seen.set(inst.dst, true)
                ssa_def_in_order.push(inst.dst)
              }
            } else {
              ssa_def_out.set(inst.dst, true)
            }
          }
          if op == "storel" || op == "storew" || op == "stores" || op == "stored" {
            if inst.args.length() >= 2 {
              let v_op = wasm_trim(inst.args[0])
              let a_op = wasm_trim(inst.args[1])
              if promoted_alloc_ty.contains(a_op) {
                if in_loop {
                  slot_write_in.set(a_op, true)
                  if !touched_slot_seen.contains(a_op) {
                    touched_slot_seen.set(a_op, true)
                    touched_slots.push(a_op)
                  }
                }
              } else if a_op.length() > 0 && str_code_at(a_op, 0) == 37 && !non_promoted_allocs.contains(a_op) {
                if in_loop {
                  ssa_use_in.set(a_op, true)
                  if !ssa_in_seen.contains(a_op) { ssa_in_seen.set(a_op, true); ssa_in_order.push(a_op) }
                } else {
                  ssa_use_out.set(a_op, true)
                }
              }
              if v_op.length() > 0 && str_code_at(v_op, 0) == 37 && !promoted_alloc_ty.contains(v_op) && !non_promoted_allocs.contains(v_op) {
                if in_loop {
                  ssa_use_in.set(v_op, true)
                  if !ssa_in_seen.contains(v_op) { ssa_in_seen.set(v_op, true); ssa_in_order.push(v_op) }
                } else {
                  ssa_use_out.set(v_op, true)
                }
              }
            }
          } else if op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" || op == "loads" || op == "loadd" {
            if inst.args.length() >= 1 {
              let a_op = wasm_trim(inst.args[0])
              if promoted_alloc_ty.contains(a_op) {
                if in_loop {
                  slot_read_in.set(a_op, true)
                  if !touched_slot_seen.contains(a_op) {
                    touched_slot_seen.set(a_op, true)
                    touched_slots.push(a_op)
                  }
                } else {
                  slot_read_out.set(a_op, true)
                }
              } else if a_op.length() > 0 && str_code_at(a_op, 0) == 37 && !non_promoted_allocs.contains(a_op) {
                if in_loop {
                  ssa_use_in.set(a_op, true)
                  if !ssa_in_seen.contains(a_op) { ssa_in_seen.set(a_op, true); ssa_in_order.push(a_op) }
                } else {
                  ssa_use_out.set(a_op, true)
                }
              }
            }
          } else if op == "phi" {
            let mut k = 0
            while k + 1 < inst.args.length() {
              let v_op = wasm_trim(inst.args[k + 1])
              if v_op.length() > 0 && str_code_at(v_op, 0) == 37 && !promoted_alloc_ty.contains(v_op) && !non_promoted_allocs.contains(v_op) {
                if in_loop {
                  ssa_use_in.set(v_op, true)
                  if !ssa_in_seen.contains(v_op) { ssa_in_seen.set(v_op, true); ssa_in_order.push(v_op) }
                } else {
                  ssa_use_out.set(v_op, true)
                }
              }
              k = k + 2
            }
          } else {
            let start_ai = if op == "call" { 0 } else { 0 }
            let mut ai = start_ai
            while ai < inst.args.length() {
              let v_op = wasm_trim(inst.args[ai])
              if v_op.length() > 0 && str_code_at(v_op, 0) == 37 && !promoted_alloc_ty.contains(v_op) && !non_promoted_allocs.contains(v_op) {
                if in_loop {
                  ssa_use_in.set(v_op, true)
                  if !ssa_in_seen.contains(v_op) { ssa_in_seen.set(v_op, true); ssa_in_order.push(v_op) }
                } else {
                  ssa_use_out.set(v_op, true)
                }
              }
              ai = ai + 1
            }
          }
          ii = ii + 1
        }
        bi = bi + 1
      }

      // Collect live_in slots & SSA vars, and live_out list
      let in_slots : Array[String] = []
      let in_slot_set : Map[String, Bool] = Map([])
      let out_names : Array[String] = []
      let out_is_slot : Array[Bool] = []
      let out_tys : Array[Int] = []

      let mut ti = 0
      while ti < touched_slots.length() {
        let s = touched_slots[ti]
        let r_in = slot_read_in.contains(s)
        let w_in = slot_write_in.contains(s)
        let r_out = slot_read_out.contains(s)
        if r_in || (w_in && r_out) {
          in_slots.push(s)
          in_slot_set.set(s, true)
        }
        if w_in && r_out {
          let sty = match promoted_alloc_ty.get(s) { Some(t) => t; None => WASM_TY_I64 }
          out_names.push(s)
          out_is_slot.push(true)
          out_tys.push(sty)
        }
        ti = ti + 1
      }

      let in_ssa : Array[String] = []
      let mut ssa_ok = true
      let mut si = 0
      while si < ssa_in_order.length() {
        let v = ssa_in_order[si]
        if ssa_def_out.contains(v) {
          if ssa_def_in.contains(v) || !local_ty.contains(v) {
            ssa_ok = false
            break
          }
          in_ssa.push(v)
        }
        si = si + 1
      }
      if !ssa_ok {
        continue
      }
      si = 0
      while si < ssa_def_in_order.length() {
        let v = ssa_def_in_order[si]
        if ssa_use_out.contains(v) {
          if ssa_def_out.contains(v) || !local_ty.contains(v) {
            ssa_ok = false
            break
          }
          let vty = match local_ty.get(v) { Some(t) => t; None => WASM_TY_I64 }
          out_names.push(v)
          out_is_slot.push(false)
          out_tys.push(vty)
        }
        si = si + 1
      }
      if !ssa_ok {
        continue
      }

      let n_in = in_slots.length() + in_ssa.length()
      let n_out = out_names.length()
      if n_in > 24 || n_out > 8 {
        continue
      }

      // Build outlined WasmFunc $__pion_ol_<ol_seq>
      let ol_name = "__pion_ol_" + ol_seq.to_string()
      let ol_id_str = ol_seq.to_string()
      ol_seq = ol_seq + 1
      any_outlined = true

      let ol_param_names : Array[String] = []
      let ol_param_tys : Array[Int] = []
      let mut k = 0
      while k < in_slots.length() {
        let s = in_slots[k]
        let sty = match promoted_alloc_ty.get(s) { Some(t) => t; None => WASM_TY_I64 }
        ol_param_names.push("%__ol_in_" + k.to_string())
        ol_param_tys.push(sty)
        k = k + 1
      }
      k = 0
      while k < in_ssa.length() {
        let v = in_ssa[k]
        let vty = match local_ty.get(v) { Some(t) => t; None => WASM_TY_I64 }
        ol_param_names.push(v)
        ol_param_tys.push(vty)
        k = k + 1
      }
      if n_out >= 2 {
        ol_param_names.push("%__ol_out_ptr")
        ol_param_tys.push(WASM_TY_I64)
      }
      let ol_ret_ty = if n_out == 0 { WASM_TY_VOID } else { out_tys[0] }

      // Entry block of outlined function: allocate & initialize touched promoted slots
      let entry_insts : Array[WasmInst] = []
      k = 0
      while k < touched_slots.length() {
        let s = touched_slots[k]
        entry_insts.push(WasmInst::{ dst: s, dst_ty: WASM_TY_I64, op: "alloc8", args: ["8"], arg_tys: [] })
        k = k + 1
      }
      k = 0
      while k < in_slots.length() {
        let s = in_slots[k]
        let sty = match promoted_alloc_ty.get(s) { Some(t) => t; None => WASM_TY_I64 }
        entry_insts.push(WasmInst::{
          dst: "",
          dst_ty: WASM_TY_VOID,
          op: wasm_store_op_for_ty(sty),
          args: ["%__ol_in_" + k.to_string(), s],
          arg_tys: [],
        })
        k = k + 1
      }
      entry_insts.push(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "jmp", args: [f.blocks[hdr].label], arg_tys: [] })

      let ol_blocks : Array[WasmBlock] = [WasmBlock::{ label: "@__ol_entry", insts: entry_insts }]
      let exit_lbl = f.blocks[exit_blk].label

      // Copy loop blocks [hdr .. end], redirecting exit_lbl -> @__ol_exit
      bi = hdr
      while bi <= end {
        let orig_b = f.blocks[bi]
        let new_insts : Array[WasmInst] = []
        ii = 0
        while ii < orig_b.insts.length() {
          let inst = orig_b.insts[ii]
          if inst.op == "jmp" && inst.args.length() >= 1 && inst.args[0] == exit_lbl {
            new_insts.push(WasmInst::{ dst: inst.dst, dst_ty: inst.dst_ty, op: "jmp", args: ["@__ol_exit"], arg_tys: [] })
          } else if inst.op == "jnz" && inst.args.length() >= 3 && (inst.args[1] == exit_lbl || inst.args[2] == exit_lbl) {
            let t1 = if inst.args[1] == exit_lbl { "@__ol_exit" } else { inst.args[1] }
            let t2 = if inst.args[2] == exit_lbl { "@__ol_exit" } else { inst.args[2] }
            new_insts.push(WasmInst::{ dst: inst.dst, dst_ty: inst.dst_ty, op: "jnz", args: [inst.args[0], t1, t2], arg_tys: [] })
          } else {
            new_insts.push(inst)
          }
          ii = ii + 1
        }
        ol_blocks.push(WasmBlock::{ label: orig_b.label, insts: new_insts })
        bi = bi + 1
      }

      // Exit block of outlined function: write out[1..n_out-1] to out_ptr and ret out[0]
      let exit_insts : Array[WasmInst] = []
      k = 1
      while k < n_out {
        let addr_op = if k == 1 {
          "%__ol_out_ptr"
        } else {
          let an = "%__ol_op_" + k.to_string()
          exit_insts.push(WasmInst::{
            dst: an,
            dst_ty: WASM_TY_I64,
            op: "add",
            args: ["%__ol_out_ptr", ((k - 1) * 8).to_string()],
            arg_tys: [],
          })
          an
        }
        let val_op = if out_is_slot[k] {
          let vn = "%__ol_rv_" + k.to_string()
          exit_insts.push(WasmInst::{
            dst: vn,
            dst_ty: out_tys[k],
            op: wasm_load_op_for_ty(out_tys[k]),
            args: [out_names[k]],
            arg_tys: [],
          })
          vn
        } else {
          out_names[k]
        }
        exit_insts.push(WasmInst::{
          dst: "",
          dst_ty: WASM_TY_VOID,
          op: wasm_store_op_for_ty(out_tys[k]),
          args: [val_op, addr_op],
          arg_tys: [],
        })
        k = k + 1
      }
      if n_out == 0 {
        exit_insts.push(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "ret", args: [], arg_tys: [] })
      } else {
        let ret_op = if out_is_slot[0] {
          let vn = "%__ol_rv_0"
          exit_insts.push(WasmInst::{
            dst: vn,
            dst_ty: out_tys[0],
            op: wasm_load_op_for_ty(out_tys[0]),
            args: [out_names[0]],
            arg_tys: [],
          })
          vn
        } else {
          out_names[0]
        }
        exit_insts.push(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "ret", args: [ret_op], arg_tys: [] })
      }
      ol_blocks.push(WasmBlock::{ label: "@__ol_exit", insts: exit_insts })

      extra_funcs.push(WasmFunc::{
        name: ol_name,
        exported: false,
        ret_ty: ol_ret_ty,
        param_names: ol_param_names,
        param_tys: ol_param_tys,
        blocks: ol_blocks,
      })

      // Build caller stub block replacing f.blocks[hdr .. end]
      let stub_insts : Array[WasmInst] = []
      let call_args : Array[String] = ["$" + ol_name]
      let call_arg_tys : Array[Int] = []
      k = 0
      while k < in_slots.length() {
        let s = in_slots[k]
        let sty = match promoted_alloc_ty.get(s) { Some(t) => t; None => WASM_TY_I64 }
        let an = "%__ol_a_" + ol_id_str + "_" + k.to_string()
        stub_insts.push(WasmInst::{ dst: an, dst_ty: sty, op: wasm_load_op_for_ty(sty), args: [s], arg_tys: [] })
        call_args.push(an)
        call_arg_tys.push(sty)
        k = k + 1
      }
      k = 0
      while k < in_ssa.length() {
        let v = in_ssa[k]
        let vty = match local_ty.get(v) { Some(t) => t; None => WASM_TY_I64 }
        call_args.push(v)
        call_arg_tys.push(vty)
        k = k + 1
      }
      let buf_name = "%__ol_buf_" + ol_id_str
      if n_out >= 2 {
        ol_entry_allocs.push(WasmInst::{
          dst: buf_name,
          dst_ty: WASM_TY_I64,
          op: "alloc8",
          args: [((n_out - 1) * 8).to_string()],
          arg_tys: [],
        })
        call_args.push(buf_name)
        call_arg_tys.push(WASM_TY_I64)
      }
      let res_name = if n_out == 0 { "" } else { "%__ol_res_" + ol_id_str }
      stub_insts.push(WasmInst::{
        dst: res_name,
        dst_ty: ol_ret_ty,
        op: "call",
        args: call_args,
        arg_tys: call_arg_tys,
      })
      if n_out >= 1 {
        if out_is_slot[0] {
          stub_insts.push(WasmInst::{
            dst: "",
            dst_ty: WASM_TY_VOID,
            op: wasm_store_op_for_ty(out_tys[0]),
            args: [res_name, out_names[0]],
            arg_tys: [],
          })
        } else {
          stub_insts.push(WasmInst::{
            dst: out_names[0],
            dst_ty: out_tys[0],
            op: "copy",
            args: [res_name],
            arg_tys: [],
          })
        }
      }
      k = 1
      while k < n_out {
        let addr_op = if k == 1 {
          buf_name
        } else {
          let an = "%__ol_cp_" + ol_id_str + "_" + k.to_string()
          stub_insts.push(WasmInst::{
            dst: an,
            dst_ty: WASM_TY_I64,
            op: "add",
            args: [buf_name, ((k - 1) * 8).to_string()],
            arg_tys: [],
          })
          an
        }
        let rv = "%__ol_cr_" + ol_id_str + "_" + k.to_string()
        stub_insts.push(WasmInst::{
          dst: rv,
          dst_ty: out_tys[k],
          op: wasm_load_op_for_ty(out_tys[k]),
          args: [addr_op],
          arg_tys: [],
        })
        if out_is_slot[k] {
          stub_insts.push(WasmInst::{
            dst: "",
            dst_ty: WASM_TY_VOID,
            op: wasm_store_op_for_ty(out_tys[k]),
            args: [rv, out_names[k]],
            arg_tys: [],
          })
        } else {
          stub_insts.push(WasmInst::{
            dst: out_names[k],
            dst_ty: out_tys[k],
            op: "copy",
            args: [rv],
            arg_tys: [],
          })
        }
        k = k + 1
      }
      stub_insts.push(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "jmp", args: [exit_lbl], arg_tys: [] })
      ol_hdr_stub.set(hdr, WasmBlock::{ label: f.blocks[hdr].label, insts: stub_insts })
      bi = hdr + 1
      while bi <= end {
        ol_skip_blk.set(bi, true)
        bi = bi + 1
      }
    }

    if !any_outlined {
      out_funcs.push(f)
    } else {
      let new_blocks : Array[WasmBlock] = []
      bi = 0
      while bi < nb {
        if ol_skip_blk.contains(bi) {
          bi = bi + 1
          continue
        }
        if bi == 0 && ol_entry_allocs.length() > 0 {
          let b0_insts : Array[WasmInst] = []
          let mut ai = 0
          while ai < ol_entry_allocs.length() {
            b0_insts.push(ol_entry_allocs[ai])
            ai = ai + 1
          }
          let mut ii = 0
          while ii < f.blocks[0].insts.length() {
            b0_insts.push(f.blocks[0].insts[ii])
            ii = ii + 1
          }
          new_blocks.push(WasmBlock::{ label: f.blocks[0].label, insts: b0_insts })
        } else {
          match ol_hdr_stub.get(bi) {
            Some(stub) => new_blocks.push(stub)
            None => new_blocks.push(f.blocks[bi])
          }
        }
        bi = bi + 1
      }
      out_funcs.push(WasmFunc::{
        name: f.name,
        exported: f.exported,
        ret_ty: f.ret_ty,
        param_names: f.param_names,
        param_tys: f.param_tys,
        blocks: new_blocks,
      })
    }
    fi = fi + 1
  }

  let mut ei = 0
  while ei < extra_funcs.length() {
    out_funcs.push(extra_funcs[ei])
    ei = ei + 1
  }
  out_funcs
}

///|
pub fn emit_wasm_from_ssa_units_traced(
  units : Array[String],
  on_stage : (String) -> Unit,
) -> Bytes {
  emit_wasm_from_ssa_units_opts(units, false, on_stage)
}

///|
pub fn emit_wasm_from_ssa_units_opts(
  units : Array[String],
  emit_names : Bool,
  on_stage : (String) -> Unit,
) -> Bytes {
  let p1 = wasm_parse_ssa_live_units(units, on_stage)
  on_stage("parse_p3_live_funcs(funcs=" + p1.funcs.length().to_string() + ",datas=" + p1.datas.length().to_string() + ")")
  let parsed_dedup = wasm_dedup_module(p1)
  let outlined_funcs = wasm_outline_nested_loops(parsed_dedup.funcs)
  // P47-A: Drop non-exported, non-directly-called `pion_drop_slots_*` functions since their
  // addresses are encoded directly as tagged 31-bit slot-mask immediates (zero fn_table / call_indirect).
  let direct_called : Map[String, Bool] = Map([])
  let mut dci = 0
  while dci < outlined_funcs.length() {
    let df = outlined_funcs[dci]
    let mut dbi = 0
    while dbi < df.blocks.length() {
      let dinsts = df.blocks[dbi].insts
      let mut dii = 0
      while dii < dinsts.length() {
        let di = dinsts[dii]
        if di.op == "call" && di.args.length() > 0 && str_code_at(di.args[0], 0) == 36 {
          direct_called.set(slice_str(di.args[0], 1, di.args[0].length()), true)
        }
        dii = dii + 1
      }
      dbi = dbi + 1
    }
    dci = dci + 1
  }
  let slot_drop_masks : Map[String, Int64] = Map([])
  let filtered_funcs : Array[WasmFunc] = []
  dci = 0
  while dci < outlined_funcs.length() {
    let df = outlined_funcs[dci]
    if !direct_called.contains(df.name) &&
      (df.name.starts_with("pion_drop_slots_") ||
        df.name.starts_with("pion_drop_struct_") ||
        df.name.starts_with("pion_drop_clo_")) {
      let sm = wasm_try_extract_slot_drop_mask(df)
      if sm != 0L {
        slot_drop_masks.set(df.name, sm)
        dci = dci + 1
        continue
      }
    }
    filtered_funcs.push(df)
    dci = dci + 1
  }
  let parsed = WasmModuleParsed::{ funcs: filtered_funcs, datas: parsed_dedup.datas }
  on_stage("wasm_dedup_module(funcs=" + parsed.funcs.length().to_string() + ",datas=" + parsed.datas.length().to_string() + ",outlined=" + (outlined_funcs.length() - parsed_dedup.funcs.length()).to_string() + ")")

  let ctx = WasmModCtx::{
    sigs: [],
    sig_map: Map([]),
    import_names: [],
    import_sigs: [],
    import_ret_tys: [],
    import_map: Map([]),
    internal_map: Map([]),
    internal_ret_tys: Map([]),
    data_addrs: Map([]),
    fn_table_idx: Map([]),
    fn_table_list: [],
    slot_drop_masks: slot_drop_masks,
  }

  // 1. Lay out static data starting at WASM_DATA_BASE
  let mut cur_addr = WASM_DATA_BASE
  let mut di = 0
  while di < parsed.datas.length() {
    let dd = parsed.datas[di]
    cur_addr = wasm_align_up(cur_addr, dd.align)
    dd.addr = cur_addr
    ctx.data_addrs.set(dd.name, cur_addr)
    let mut ii = 0
    while ii < dd.items.length() {
      cur_addr = cur_addr + wasm_data_item_size(dd.items[ii])
      ii = ii + 1
    }
    di = di + 1
  }
  let static_end = cur_addr
  let slab_ctl_addr = wasm_align_up(static_end, 16)
  let heap_base = slab_ctl_addr + 96

  // 2. Register internal function names (indices will be shifted after imports are known)
  let internal_def_set : Map[String, Int] = Map([])
  let mut fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    internal_def_set.set(f.name, fi)
    ctx.internal_ret_tys.set(f.name, f.ret_ty)
    fi = fi + 1
  }

  // 3. Discover external imports from direct call instructions
  // Pure-Wasm internal fast paths are emitted on demand; slow paths call their JS imports.
  let imp_param_tys : Map[String, Array[Int]] = Map([])
  let imp_ret_ty : Map[String, Int] = Map([])
  let imp_order : Array[String] = []
  let mut uses_rc_inc = false
  let mut uses_rc_dec = false
  let mut uses_alloc = false
  let mut uses_alloc_uninit = false
  let mut uses_str_eq = false
  let mut uses_int_to_str = false
  let mut uses_str_concat = false
  let mut uses_str_concat_n = false
  let mut uses_map_has = false
  let mut uses_map_get = false
  let mut uses_map_try_get = false
  let mut uses_map_set = false
  let mut uses_map_keys = false
  let mut uses_arr_new = false
  let mut uses_arr_push = false
  let mut uses_arr_push_owned = false
  let mut uses_arr_set = false
  let mut uses_arr_pop = false
  let mut uses_arr_clear = false
  let mut uses_bytes_new = false
  let mut uses_bytes_slice = false
  let mut uses_bytes_to_str = false
  let mut uses_str_to_bytes = false
  let mut uses_strbuf_push_byte = false
  let mut uses_strbuf_push_char = false
  let mut uses_strbuf_push_str = false
  let mut uses_strbuf_push_slice = false
  let mut uses_strbuf_push_int = false
  let mut uses_strbuf_reset = false
  let mut uses_strbuf_to_str = false
  let mut uses_str_slice = false
  let mut uses_str_cmp = false
  let mut uses_str_starts_with = false
  let mut uses_str_ends_with = false
  let mut uses_str_split = false
  let mut uses_ptr_offset = false
  let mut uses_ptr_read_u8 = false
  let mut uses_ptr_read_i32 = false
  let mut uses_ptr_read_i64 = false
  let mut uses_ptr_read_ptr = false
  let mut uses_ptr_write_u8 = false
  let mut uses_ptr_write_i32 = false
  let mut uses_ptr_write_i64 = false
  let mut uses_ptr_write_ptr = false
  let mut uses_memset = false
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    let mut bi = 0
    while bi < f.blocks.length() {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if inst.op == "call" && inst.args.length() > 0 {
          let callee = inst.args[0]
          if str_code_at(callee, 0) == 36 {
            let sym = slice_str(callee, 1, callee.length())
            match internal_def_set.get(sym) {
              Some(_) => ()
              None =>
                if sym == "pion_rc_inc" {
                  uses_rc_inc = true
                } else if sym == "pion_rc_dec" {
                  uses_rc_dec = true
                  match imp_param_tys.get("pion_rc_dec_slow") {
                    None => {
                      imp_order.push("pion_rc_dec_slow")
                      imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
                      imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
                    }
                    Some(_) => ()
                  }
                } else if sym == "pion_str_eq" {
                  uses_str_eq = true
                } else if sym == "pion_int_to_str" {
                  uses_int_to_str = true
                } else if sym == "pion_str_concat" {
                  uses_str_concat = true
                } else if sym == "pion_map_has" {
                  uses_map_has = true
                } else if sym == "pion_map_get" {
                  uses_map_get = true
                } else if sym == "pion_map_try_get" {
                  uses_map_try_get = true
                } else if sym == "pion_map_keys" {
                  uses_map_keys = true
                } else if sym == "pion_arr_set" {
                  uses_arr_set = true
                } else if sym == "pion_arr_pop" {
                  uses_arr_pop = true
                } else if sym == "pion_arr_clear" {
                  uses_arr_clear = true
                } else if sym == "pion_bytes_slice" {
                  uses_bytes_slice = true
                } else if sym == "pion_bytes_to_str" {
                  uses_bytes_to_str = true
                } else if sym == "pion_str_to_bytes" {
                  uses_str_to_bytes = true
                } else if sym == "pion_strbuf_reset" {
                  uses_strbuf_reset = true
                } else if sym == "pion_strbuf_to_str" {
                  uses_strbuf_to_str = true
                } else if sym == "pion_str_slice" {
                  uses_str_slice = true
                } else if sym == "pion_str_cmp" {
                  uses_str_cmp = true
                } else if sym == "pion_str_starts_with" {
                  uses_str_starts_with = true
                } else if sym == "pion_str_ends_with" {
                  uses_str_ends_with = true
                } else if sym == "pion_ptr_offset" {
                  uses_ptr_offset = true
                } else if sym == "pion_ptr_read_u8" {
                  uses_ptr_read_u8 = true
                } else if sym == "pion_ptr_read_i32" {
                  uses_ptr_read_i32 = true
                } else if sym == "pion_ptr_read_i64" {
                  uses_ptr_read_i64 = true
                } else if sym == "pion_ptr_read_ptr" {
                  uses_ptr_read_ptr = true
                } else if sym == "pion_ptr_write_u8" {
                  uses_ptr_write_u8 = true
                } else if sym == "pion_ptr_write_i32" {
                  uses_ptr_write_i32 = true
                } else if sym == "pion_ptr_write_i64" {
                  uses_ptr_write_i64 = true
                } else if sym == "pion_ptr_write_ptr" {
                  uses_ptr_write_ptr = true
                } else if sym == "memset" {
                  uses_memset = true
                } else {
                  if sym == "pion_alloc" {
                    uses_alloc = true
                  } else if sym == "pion_alloc_uninit" {
                    uses_alloc_uninit = true
                  } else if sym == "pion_str_concat_n" {
                    uses_str_concat_n = true
                  } else if sym == "pion_map_set" {
                    uses_map_set = true
                  } else if sym == "pion_arr_new" {
                    uses_arr_new = true
                  } else if sym == "pion_arr_push" {
                    uses_arr_push = true
                  } else if sym == "pion_arr_push_owned" {
                    uses_arr_push_owned = true
                  } else if sym == "pion_strbuf_push_byte" {
                    uses_strbuf_push_byte = true
                  } else if sym == "pion_strbuf_push_char" {
                    uses_strbuf_push_char = true
                  } else if sym == "pion_strbuf_push_str" {
                    uses_strbuf_push_str = true
                  } else if sym == "pion_strbuf_push_slice" {
                    uses_strbuf_push_slice = true
                  } else if sym == "pion_strbuf_push_int" {
                    uses_strbuf_push_int = true
                  } else if sym == "pion_bytes_new" {
                    uses_bytes_new = true
                  } else if sym == "pion_str_split" {
                    uses_str_split = true
                  }
                  match imp_param_tys.get(sym) {
                    None => {
                      imp_order.push(sym)
                      imp_param_tys.set(sym, inst.arg_tys)
                      imp_ret_ty.set(sym, inst.dst_ty)
                    }
                    Some(_) =>
                      if inst.dst_ty != WASM_TY_VOID {
                        imp_ret_ty.set(sym, inst.dst_ty)
                      }
                  }
                }
            }
          }
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
    fi = fi + 1
  }

  // Dependency propagation for pure-Wasm String, HashMap, Array & StringBuilder fast paths
  let uses_map_find = uses_map_has || uses_map_get
  let uses_map_hash = uses_map_find || uses_map_set
  if uses_map_hash || uses_map_try_get {
    uses_str_eq = true
  }
  if uses_arr_push {
    uses_rc_inc = true
  }
  if uses_map_set || uses_arr_set {
    uses_rc_inc = true
    uses_rc_dec = true
    match imp_param_tys.get("pion_rc_dec_slow") {
      None => {
        imp_order.push("pion_rc_dec_slow")
        imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
        imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_arr_clear {
    uses_rc_dec = true
    match imp_param_tys.get("pion_rc_dec_slow") {
      None => {
        imp_order.push("pion_rc_dec_slow")
        imp_param_tys.set("pion_rc_dec_slow", [WASM_TY_I64])
        imp_ret_ty.set("pion_rc_dec_slow", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_bytes_slice || uses_str_to_bytes {
    uses_bytes_new = true
    match imp_param_tys.get("pion_bytes_new") {
      None => {
        imp_order.push("pion_bytes_new")
        imp_param_tys.set("pion_bytes_new", [WASM_TY_I64])
        imp_ret_ty.set("pion_bytes_new", WASM_TY_I64)
      }
      Some(_) => ()
    }
  }
  if uses_arr_set || uses_arr_pop {
    match imp_param_tys.get("pion_panic_oob") {
      None => {
        imp_order.push("pion_panic_oob")
        imp_param_tys.set("pion_panic_oob", [WASM_TY_I64, WASM_TY_I64])
        imp_ret_ty.set("pion_panic_oob", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_map_keys {
    uses_arr_new = true
    uses_rc_inc = true
    match imp_param_tys.get("pion_arr_new") {
      None => {
        imp_order.push("pion_arr_new")
        imp_param_tys.set("pion_arr_new", [WASM_TY_I64, WASM_TY_I32])
        imp_ret_ty.set("pion_arr_new", WASM_TY_I64)
      }
      Some(_) => ()
    }
  }
  if uses_str_split {
    uses_arr_new = true
    uses_arr_push_owned = true
    match imp_param_tys.get("pion_arr_new") {
      None => {
        imp_order.push("pion_arr_new")
        imp_param_tys.set("pion_arr_new", [WASM_TY_I64, WASM_TY_I32])
        imp_ret_ty.set("pion_arr_new", WASM_TY_I64)
      }
      Some(_) => ()
    }
    match imp_param_tys.get("pion_arr_push_owned") {
      None => {
        imp_order.push("pion_arr_push_owned")
        imp_param_tys.set("pion_arr_push_owned", [WASM_TY_I64, WASM_TY_I64])
        imp_ret_ty.set("pion_arr_push_owned", WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }
  if uses_int_to_str ||
    uses_str_concat ||
    uses_str_concat_n ||
    uses_arr_new ||
    uses_bytes_new ||
    uses_bytes_to_str ||
    uses_strbuf_to_str ||
    uses_str_slice {
    uses_alloc_uninit = true
    match imp_param_tys.get("pion_alloc_uninit") {
      None => {
        imp_order.push("pion_alloc_uninit")
        imp_param_tys.set(
          "pion_alloc_uninit",
          [WASM_TY_I32, WASM_TY_I32, WASM_TY_I64],
        )
        imp_ret_ty.set("pion_alloc_uninit", WASM_TY_I64)
      }
      Some(_) => ()
    }
  }

  let mut abi_imp_idx : Int = -1
  if imp_order.length() > 0 {
    let abi_imp_sym = "__pion_rt_abi_v" + WASM_RT_ABI_VERSION.to_string()
    match imp_param_tys.get(abi_imp_sym) {
      None => {
        abi_imp_idx = imp_order.length()
        imp_order.push(abi_imp_sym)
        imp_param_tys.set(abi_imp_sym, [])
        imp_ret_ty.set(abi_imp_sym, WASM_TY_VOID)
      }
      Some(_) => ()
    }
  }

  // Finalize import indices 0..num_imports-1
  let mut imi = 0
  while imi < imp_order.length() {
    let sym = imp_order[imi]
    let ptys = match imp_param_tys.get(sym) {
      Some(p) => p
      None => []
    }
    let rty = match imp_ret_ty.get(sym) {
      Some(r) => r
      None => WASM_TY_VOID
    }
    let sidx = wasm_intern_sig(ctx, ptys, rty)
    ctx.import_map.set(sym, imi)
    ctx.import_names.push(sym)
    ctx.import_sigs.push(sidx)
    ctx.import_ret_tys.push(rty)
    imi = imi + 1
  }
  let num_imports = imp_order.length()

  // Finalize internal function indices num_imports..
  let internal_sig_idxs : Array[Int] = []
  let def_func_names : Array[String] = []
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    ctx.internal_map.set(f.name, num_imports + fi)
    internal_sig_idxs.push(wasm_intern_sig(ctx, f.param_tys, f.ret_ty))
    def_func_names.push(f.name)
    fi = fi + 1
  }
  let mut rc_inc_internal_idx = -1
  if uses_rc_inc {
    let inc_idx = num_imports + internal_sig_idxs.length()
    rc_inc_internal_idx = inc_idx
    ctx.internal_map.set("pion_rc_inc", inc_idx)
    ctx.internal_ret_tys.set("pion_rc_inc", WASM_TY_VOID)
    internal_sig_idxs.push(wasm_intern_sig(ctx, [WASM_TY_I64], WASM_TY_VOID))
    def_func_names.push("pion_rc_inc")
