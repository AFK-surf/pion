  if uses_strbuf_push_slice {
    let idx = num_imports + internal_sig_idxs.length()
    ctx.internal_map.set("pion_strbuf_push_slice", idx)
    ctx.internal_ret_tys.set("pion_strbuf_push_slice", WASM_TY_VOID)
    internal_sig_idxs.push(
