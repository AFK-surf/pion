///| Zero-toolchain QBE SSA -> WebAssembly 32-bit (wasm32) binary backend.
///| Stage-0 bootstrap safe (uses only core Int/Int64/Double/Bytes/Array/Map/StringBuilder).

///|
let WASM_TY_VOID : Int = 0
let WASM_TY_I32 : Int = 1
let WASM_TY_I64 : Int = 2
let WASM_TY_F32 : Int = 3
let WASM_TY_F64 : Int = 4

let WASM_STACK_BASE : Int = 196608 // 0x30000 (64KB guard + 128KB shadow stack)
let WASM_DATA_BASE : Int = 196608  // 0x30000
// Wasm32 runtime ABI version (v2: 96B __pion_slab_ctl + dual-key wymix64 Map hash + flat inline RC struct arrays + iterative drop worklist)
let WASM_RT_ABI_VERSION : Int = 2

///|
fn wasm_valtype_byte(ty : Int) -> Int {
  if ty == WASM_TY_I32 {
    0x7F
  } else if ty == WASM_TY_I64 {
    0x7E
  } else if ty == WASM_TY_F32 {
    0x7D
  } else {
    0x7C
  }
}

///|
fn wasm_parse_qbe_ty(s : String) -> Int {
  if s == "w" || s == "ub" || s == "sb" || s == "uh" || s == "sh" {
    WASM_TY_I32
  } else if s == "l" {
    WASM_TY_I64
  } else if s == "s" {
    WASM_TY_F32
  } else if s == "d" {
    WASM_TY_F64
  } else {
    WASM_TY_VOID
  }
}

///|
fn wasm_ushr64(x : Int64, n : Int) -> Int64 {
  if n <= 0 {
    x
  } else {
    ((x >> 1) & 0x7FFFFFFFFFFFFFFFL) >> (n - 1)
  }
}

///|
/// Convert IEEE-754 f64 bits (Int64) to f32 bits (Int), round-to-nearest-even.
fn wasm_f64_bits_to_f32_bits(bits : Int64) -> Int {
  let sign = (wasm_ushr64(bits, 63) & 1L).to_int() << 31
  let exp64 = (wasm_ushr64(bits, 52) & 0x7FFL).to_int()
  let frac64 = bits & 0xFFFFFFFFFFFFFL
  if exp64 == 0x7FF {
    if frac64 == 0L {
      return sign | 0x7F800000
    }
    let payload = wasm_ushr64(frac64, 29).to_int() & 0x7FFFFF
    return sign | 0x7FC00000 | payload
  }
  let exp32 = exp64 - 1023 + 127
  if exp32 >= 255 {
    return sign | 0x7F800000
  }
  if exp32 <= 0 {
    if exp32 < -24 {
      return sign
    }
    let mant = frac64 | 0x10000000000000L
    let shift = 29 + (1 - exp32)
    let q = wasm_ushr64(mant, shift).to_int()
    let rem_mask = (1L << shift) - 1L
    let rem = mant & rem_mask
    let half = 1L << (shift - 1)
    let rounded = if rem > half || (rem == half && (q & 1) != 0) {
      q + 1
    } else {
      q
    }
    return sign | rounded
  }
  let q = wasm_ushr64(frac64, 29).to_int()
  let rem = frac64 & 0x1FFFFFFFL
  let half = 0x10000000L
  let mut mant32 = if rem > half || (rem == half && (q & 1) != 0) {
    q + 1
  } else {
    q
  }
  let mut e32 = exp32
  if mant32 >= 0x800000 {
    mant32 = 0
    e32 = e32 + 1
    if e32 >= 255 {
      return sign | 0x7F800000
    }
  }
  sign | (e32 << 23) | (mant32 & 0x7FFFFF)
}

///|
fn wasm_push_u32(buf : Array[Int], v0 : Int) -> Unit {
  let mut v = v0
  while true {
    let mut b = v & 0x7F
    v = ushr32(v, 7)
    if v != 0 {
      b = b | 0x80
    }
    buf.push(b)
    if v == 0 {
      break
    }
  }
}

///|
fn wasm_push_s32(buf : Array[Int], v0 : Int) -> Unit {
  let mut v = v0
  while true {
    let b = v & 0x7F
    v = v >> 7
    let done = (v == 0 && (b & 0x40) == 0) || (v == -1 && (b & 0x40) != 0)
    if done {
      buf.push(b)
      break
    } else {
      buf.push(b | 0x80)
    }
  }
}

///|
fn wasm_push_s64(buf : Array[Int], v0 : Int64) -> Unit {
  let mut v = v0
  while true {
    let b = (v & 0x7FL).to_int()
    v = v >> 7
    let done = (v == 0L && (b & 0x40) == 0) || (v == -1L && (b & 0x40) != 0)
    if done {
      buf.push(b)
      break
    } else {
      buf.push(b | 0x80)
    }
  }
}

///|
fn wasm_push_i32_le(buf : Array[Int], v0 : Int) -> Unit {
  buf.push(v0 & 0xFF)
  buf.push(ushr32(v0, 8) & 0xFF)
  buf.push(ushr32(v0, 16) & 0xFF)
  buf.push(ushr32(v0, 24) & 0xFF)
}

///|
fn wasm_push_i64_le(buf : Array[Int], v0 : Int64) -> Unit {
  let mut i = 0
  while i < 8 {
    buf.push((wasm_ushr64(v0, i * 8) & 0xFFL).to_int())
    i = i + 1
  }
}

///|
fn wasm_push_str(buf : Array[Int], s : String) -> Unit {
  let bs = str_to_utf8_ints(s)
  wasm_push_u32(buf, bs.length())
  let mut i = 0
  while i < bs.length() {
    buf.push(bs[i])
    i = i + 1
  }
}

///|
fn wasm_push_bytes(dst : Array[Int], src : Array[Int]) -> Unit {
  let mut i = 0
  while i < src.length() {
    dst.push(src[i])
    i = i + 1
  }
}

///|
fn wasm_push_section(out : Array[Int], id : Int, body : Array[Int]) -> Unit {
  out.push(id)
  wasm_push_u32(out, body.length())
  wasm_push_bytes(out, body)
}

///|
fn wasm_trim(s : String) -> String {
  let n = s.length()
  let mut a = 0
  while a < n {
    let c = str_code_at(s, a)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      a = a + 1
    } else {
      break
    }
  }
  let mut b = n
  while b > a {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  if a == 0 && b == n {
    return s
  }
  slice_str(s, a, b)
}

///|
fn wasm_strip_comment(line : String) -> String {
  let n = line.length()
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < n {
    let c = str_code_at(line, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return slice_str(line, 0, i)
    }
    i = i + 1
  }
  line
}

///|
fn wasm_split_lines(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if str_code_at(s, i) == 10 {
      out.push(slice_str(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    out.push(slice_str(s, start, n))
  }
  out
}

///|
fn wasm_find_char(s : String, ch : Int, from : Int) -> Int {
  let n = s.length()
  let mut i = from
  while i < n {
    if str_code_at(s, i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn wasm_find_char_outside_str(s : String, ch : Int, from : Int) -> Int {
  let n = s.length()
  let mut in_str = false
  let mut esc = false
  let mut i = from
  while i < n {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn wasm_split_commas(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut in_str = false
  let mut esc = false
  let mut start = 0
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 44 {
      let part = wasm_trim(slice_str(s, start, i))
      if part.length() > 0 {
        out.push(part)
      }
      start = i + 1
    }
    i = i + 1
  }
  let tail = wasm_trim(slice_str(s, start, n))
  if tail.length() > 0 {
    out.push(tail)
  }
  out
}

///|
fn wasm_split_ws(s : String) -> Array[String] {
  let out : Array[String] = []
  let n = s.length()
  let mut i = 0
  while i < n {
    while i < n {
      let c = str_code_at(s, i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        i = i + 1
      } else {
        break
      }
    }
    let start = i
    while i < n {
      let c = str_code_at(s, i)
      if c == 32 || c == 9 || c == 13 || c == 10 {
        break
      }
      i = i + 1
    }
    if i > start {
      out.push(slice_str(s, start, i))
    }
  }
  out
}

///|
fn wasm_parse_int64(raw : String) -> Int64 {
  let s = wasm_trim(raw)
  let n = s.length()
  if n == 0 {
    return 0L
  }
  let mut neg = false
  let mut i = 0
  let first = str_code_at(s, 0)
  if first == 45 {
    neg = true
    i = 1
  } else if first == 43 {
    i = 1
  }
  let mut acc : Int64 = 0L
  if i + 2 <= n && str_code_at(s, i) == 48 &&
    (str_code_at(s, i + 1) == 120 || str_code_at(s, i + 1) == 88) {
    i = i + 2
    while i < n {
      let c = str_code_at(s, i)
      let d = if c >= 48 && c <= 57 {
        c - 48
      } else if c >= 97 && c <= 102 {
        c - 97 + 10
      } else if c >= 65 && c <= 70 {
        c - 65 + 10
      } else {
        break
      }
      acc = (acc << 4) | d.to_int64()
      i = i + 1
    }
  } else {
    while i < n {
      let c = str_code_at(s, i)
      if c >= 48 && c <= 57 {
        acc = acc * 10L + (c - 48).to_int64()
      } else {
        break
      }
      i = i + 1
    }
  }
  if neg { 0L - acc } else { acc }
}

///|
fn wasm_hex_digit(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 97 + 10
  } else if c >= 65 && c <= 70 {
    c - 65 + 10
  } else {
    -1
  }
}

///|
/// Unescape a QBE data string literal `"..."` into raw bytes.
fn wasm_unescape_qbe_str(lit : String) -> Array[Int] {
  let out : Array[Int] = []
  let n = lit.length()
  let mut i = 0
  if i < n && str_code_at(lit, i) == 34 {
    i = i + 1
  }
  let end = if n > 0 && str_code_at(lit, n - 1) == 34 { n - 1 } else { n }
  while i < end {
    let c = str_code_at(lit, i)
    if c == 92 && i + 1 < end {
      let nx = str_code_at(lit, i + 1)
      if nx == 110 {
        out.push(10)
        i = i + 2
      } else if nx == 114 {
        out.push(13)
        i = i + 2
      } else if nx == 116 {
        out.push(9)
        i = i + 2
      } else if nx == 34 {
        out.push(34)
        i = i + 2
      } else if nx == 92 {
        out.push(92)
        i = i + 2
      } else if nx == 120 && i + 3 < end {
        let h1 = wasm_hex_digit(str_code_at(lit, i + 2))
        let h2 = wasm_hex_digit(str_code_at(lit, i + 3))
        if h1 >= 0 && h2 >= 0 {
          out.push((h1 << 4) | h2)
          i = i + 4
        } else {
          out.push(nx)
          i = i + 2
        }
      } else if nx >= 48 && nx <= 55 {
        // Octal escape \0 .. \377
        let mut oct_v = nx - 48
        let mut adv = 2
        if i + 2 < end {
          let o2 = str_code_at(lit, i + 2)
          if o2 >= 48 && o2 <= 55 {
            oct_v = oct_v * 8 + (o2 - 48)
            adv = 3
            if i + 3 < end {
              let o3 = str_code_at(lit, i + 3)
              if o3 >= 48 && o3 <= 55 {
                oct_v = oct_v * 8 + (o3 - 48)
                adv = 4
              }
            }
          }
        }
        out.push(oct_v & 0xFF)
        i = i + adv
      } else {
        out.push(nx)
        i = i + 2
      }
    } else {
      out.push(c & 0xFF)
      i = i + 1
    }
  }
  out
}

///|
fn wasm_parse_double_bits(num_str : String) -> Int64 {
  match num_str.to_double() {
    Some(d) => d.to_bits()
    None => 0L
  }
}

///|
struct WasmDataItem {
  kind : String // "b", "h", "w", "l", "s", "d", "z"
  raw : String  // raw value expression
}

///|
struct WasmDataDef {
  name : String
  align : Int
  items : Array[WasmDataItem]
  mut addr : Int
}

///|
struct WasmInst {
  dst : String
  dst_ty : Int
  op : String
  args : Array[String]
  arg_tys : Array[Int] // for call arguments
}

///|
struct WasmBlock {
  label : String
  insts : Array[WasmInst]
}

///|
struct WasmFunc {
  name : String
  exported : Bool
  ret_ty : Int
  param_names : Array[String]
  param_tys : Array[Int]
  blocks : Array[WasmBlock]
}

///|
struct WasmSig {
  param_tys : Array[Int]
  ret_ty : Int
}

///|
fn wasm_sig_key(param_tys : Array[Int], ret_ty : Int) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < param_tys.length() {
    sb.write_string(param_tys[i].to_string())
    sb.write_char(',')
    i = i + 1
  }
  sb.write_string("->")
  sb.write_string(ret_ty.to_string())
  sb.to_string()
}

///|
fn wasm_parse_data_def(text : String) -> Option[WasmDataDef] {
  let eq_idx = wasm_find_char(text, 61, 0)
  if eq_idx < 0 {
    return None
  }
  let lhs = wasm_trim(slice_str(text, 0, eq_idx))
  let dollar_idx = wasm_find_char(lhs, 36, 0)
  if dollar_idx < 0 {
    return None
  }
  let name = wasm_trim(slice_str(lhs, dollar_idx + 1, lhs.length()))
  let lb = wasm_find_char_outside_str(text, 123, eq_idx + 1)
  let rb = wasm_find_char_outside_str(text, 125, if lb >= 0 { lb + 1 } else { eq_idx + 1 })
  if lb < 0 || rb < 0 {
    return None
  }
  let mid = wasm_trim(slice_str(text, eq_idx + 1, lb))
  let mut align = 8
  if mid.starts_with("align ") {
    align = wasm_parse_int64(slice_str(mid, 6, mid.length())).to_int()
    if align < 1 {
      align = 1
    }
  }
  let inner = slice_str(text, lb + 1, rb)
  let parts = wasm_split_commas(inner)
  let items : Array[WasmDataItem] = []
  let mut i = 0
  while i < parts.length() {
    let p = wasm_trim(parts[i])
    if p.length() > 0 {
      let sp = wasm_find_char(p, 32, 0)
      if sp > 0 {
        let kind = slice_str(p, 0, sp)
        let raw = wasm_trim(slice_str(p, sp + 1, p.length()))
        items.push(WasmDataItem::{ kind: kind, raw: raw })
      }
    }
    i = i + 1
  }
  Some(WasmDataDef::{ name: name, align: align, items: items, addr: 0 })
}

///|
fn wasm_parse_call_args(arg_str : String, args_out : Array[String], tys_out : Array[Int]) -> Unit {
  let parts = wasm_split_commas(arg_str)
  let mut i = 0
  while i < parts.length() {
    let p = wasm_trim(parts[i])
    if p == "..." || p.length() == 0 {
      i = i + 1
      continue
    }
    let toks = wasm_split_ws(p)
    if toks.length() >= 2 {
      if toks[0] == "env" {
        tys_out.push(WASM_TY_I64)
        args_out.push(toks[1])
      } else {
        let ty = wasm_parse_qbe_ty(toks[0])
        tys_out.push(if ty == WASM_TY_VOID { WASM_TY_I64 } else { ty })
        args_out.push(toks[1])
      }
    }
    i = i + 1
  }
}

///|
fn wasm_parse_inst(line : String) -> Option[WasmInst] {
  let s = wasm_trim(line)
  if s.length() == 0 {
    return None
  }
  // Assignment: %dst =<ty> <op> ...
  if str_code_at(s, 0) == 37 {
    let eq_idx = wasm_find_char(s, 61, 0)
    if eq_idx < 0 {
      return None
    }
    let dst = wasm_trim(slice_str(s, 0, eq_idx))
    let rest0 = wasm_trim(slice_str(s, eq_idx + 1, s.length()))
    let sp1 = wasm_find_char(rest0, 32, 0)
    if sp1 < 0 {
      return None
    }
    let dst_ty = wasm_parse_qbe_ty(slice_str(rest0, 0, sp1))
    let rest1 = wasm_trim(slice_str(rest0, sp1 + 1, rest0.length()))
    if rest1.starts_with("call ") {
      let after_call = wasm_trim(slice_str(rest1, 5, rest1.length()))
      let lp = wasm_find_char(after_call, 40, 0)
      let rp = wasm_find_char(after_call, 41, if lp >= 0 { lp + 1 } else { 0 })
      if lp < 0 || rp < 0 {
        return None
      }
      let callee = wasm_trim(slice_str(after_call, 0, lp))
      let arg_str = slice_str(after_call, lp + 1, rp)
      let args : Array[String] = [callee]
      let arg_tys : Array[Int] = []
      wasm_parse_call_args(arg_str, args, arg_tys)
      return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: "call", args: args, arg_tys: arg_tys })
    }
    let sp2 = wasm_find_char(rest1, 32, 0)
    let op = if sp2 < 0 { rest1 } else { slice_str(rest1, 0, sp2) }
    let arg_raw = if sp2 < 0 { "" } else { wasm_trim(slice_str(rest1, sp2 + 1, rest1.length())) }
    if op == "phi" {
      let pairs = wasm_split_commas(arg_raw)
      let args : Array[String] = []
      let mut pi = 0
      while pi < pairs.length() {
        let ptoks = wasm_split_ws(pairs[pi])
        if ptoks.length() >= 2 {
          args.push(ptoks[0])
          args.push(ptoks[1])
        }
        pi = pi + 1
      }
      return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: "phi", args: args, arg_tys: [] })
    }
    let args = wasm_split_commas(arg_raw)
    return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: op, args: args, arg_tys: [] })
  }

  // Void call
  if s.starts_with("call ") {
    let after_call = wasm_trim(slice_str(s, 5, s.length()))
    let lp = wasm_find_char(after_call, 40, 0)
    let rp = wasm_find_char(after_call, 41, if lp >= 0 { lp + 1 } else { 0 })
    if lp < 0 || rp < 0 {
      return None
    }
    let callee = wasm_trim(slice_str(after_call, 0, lp))
    let arg_str = slice_str(after_call, lp + 1, rp)
    let args : Array[String] = [callee]
    let arg_tys : Array[Int] = []
    wasm_parse_call_args(arg_str, args, arg_tys)
    return Some(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "call", args: args, arg_tys: arg_tys })
  }

  // Other non-assigning instruction: store*, jmp, jnz, jtbl, ret, hlt, blit
  let sp = wasm_find_char(s, 32, 0)
  let op = if sp < 0 { s } else { slice_str(s, 0, sp) }
  let arg_raw = if sp < 0 { "" } else { wasm_trim(slice_str(s, sp + 1, s.length())) }
  let args = wasm_split_commas(arg_raw)
  Some(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: op, args: args, arg_tys: [] })
}

///|
struct WasmModuleParsed {
  datas : Array[WasmDataDef]
  funcs : Array[WasmFunc]
}

///|
fn wasm_skip_ws_range(s : String, from : Int, to : Int) -> Int {
  let mut i = from
  while i < to {
    let c = str_code_at(s, i)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      i = i + 1
    } else {
      break
    }
  }
  i
}

///|
fn wasm_rtrim_ws_range(s : String, from : Int, to : Int) -> Int {
  let mut b = to
  while b > from {
    let c = str_code_at(s, b - 1)
    if c == 32 || c == 9 || c == 13 || c == 10 {
      b = b - 1
    } else {
      break
    }
  }
  b
}

///|
fn wasm_strip_comment_end(s : String, from : Int, to : Int) -> Int {
  let mut in_str = false
  let mut esc = false
  let mut i = from
  while i < to {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 35 {
      return i
    }
    i = i + 1
  }
  to
}

///|
fn wasm_find_char_range(s : String, ch : Int, from : Int, to : Int) -> Int {
  let mut i = from
  while i < to {
    if str_code_at(s, i) == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn wasm_find_char_outside_str_range(s : String, ch : Int, from : Int, to : Int) -> Int {
  let mut in_str = false
  let mut esc = false
  let mut i = from
  while i < to {
    let c = str_code_at(s, i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == ch {
      return i
    }
    i = i + 1
  }
  -1
}

///|
fn wasm_starts_with_at(s : String, pos : Int, end_pos : Int, pat : String) -> Bool {
  let plen = pat.length()
  if end_pos - pos < plen {
    return false
  }
  let mut i = 0
  while i < plen {
    if str_code_at(s, pos + i) != str_code_at(pat, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn wasm_parse_qbe_ty_span(s : String, a0 : Int, b0 : Int) -> Int {
  let a = wasm_skip_ws_range(s, a0, b0)
  let b = wasm_rtrim_ws_range(s, a, b0)
  let len = b - a
  if len == 1 {
    let c = str_code_at(s, a)
    if c == 119 || c == 98 || c == 104 { // w, b, h
      return WASM_TY_I32
    }
    if c == 108 { // l
      return WASM_TY_I64
    }
    if c == 115 { // s
      return WASM_TY_F32
    }
    if c == 100 { // d
      return WASM_TY_F64
    }
    return WASM_TY_VOID
  }
  if len == 2 {
    let c0 = str_code_at(s, a)
    let c1 = str_code_at(s, a + 1)
    if (c0 == 115 || c0 == 117) && (c1 == 98 || c1 == 104) { // sb, ub, sh, uh
      return WASM_TY_I32
    }
  }
  if len > 0 && str_code_at(s, a) == 58 { // :agg
    return WASM_TY_I64
  }
  WASM_TY_VOID
}

///|
fn wasm_split_commas_span(s : String, a0 : Int, b0 : Int) -> Array[String] {
  let cpos = wasm_find_char_range(s, 44, a0, b0)
  if cpos < 0 {
    let ta = wasm_skip_ws_range(s, a0, b0)
    let tb = wasm_rtrim_ws_range(s, ta, b0)
    if tb > ta {
      return [slice_str(s, ta, tb)]
    }
    return []
  }
  let out : Array[String] = []
  let mut start = a0
  let mut i = cpos
  while i < b0 {
    if str_code_at(s, i) == 44 {
      let pa = wasm_skip_ws_range(s, start, i)
      let pb = wasm_rtrim_ws_range(s, pa, i)
      if pb > pa {
        out.push(slice_str(s, pa, pb))
      }
      start = i + 1
    }
    i = i + 1
  }
  let ta = wasm_skip_ws_range(s, start, b0)
  let tb = wasm_rtrim_ws_range(s, ta, b0)
  if tb > ta {
    out.push(slice_str(s, ta, tb))
  }
  out
}

///|
fn wasm_parse_call_args_span(
  s : String,
  a0 : Int,
  b0 : Int,
  args_out : Array[String],
  tys_out : Array[Int],
) -> Unit {
  let mut start = a0
  let mut i = a0
  while i <= b0 {
    if i == b0 || str_code_at(s, i) == 44 {
      let pa = wasm_skip_ws_range(s, start, i)
      let pb = wasm_rtrim_ws_range(s, pa, i)
      if pb > pa && !(pb - pa == 3 && str_code_at(s, pa) == 46) {
        // First token = type (or "env"), second token = value
        let mut t1_end = pa
        while t1_end < pb {
          let c = str_code_at(s, t1_end)
          if c == 32 || c == 9 {
            break
          }
          t1_end = t1_end + 1
        }
        let t2_start = wasm_skip_ws_range(s, t1_end, pb)
        if t2_start < pb {
          let mut t2_end = t2_start
          while t2_end < pb {
            let c = str_code_at(s, t2_end)
            if c == 32 || c == 9 {
              break
            }
            t2_end = t2_end + 1
          }
          if t1_end - pa == 3 && str_code_at(s, pa) == 101 && str_code_at(s, pa + 1) == 110 && str_code_at(s, pa + 2) == 118 {
            tys_out.push(WASM_TY_I64)
            args_out.push(slice_str(s, t2_start, t2_end))
          } else {
            let ty = wasm_parse_qbe_ty_span(s, pa, t1_end)
            tys_out.push(if ty == WASM_TY_VOID { WASM_TY_I64 } else { ty })
            args_out.push(slice_str(s, t2_start, t2_end))
          }
        }
      }
      start = i + 1
    }
    i = i + 1
  }
}

///|
fn wasm_parse_inst_span(s : String, a0 : Int, b0 : Int, empty_tys : Array[Int]) -> Option[WasmInst] {
  let a = wasm_skip_ws_range(s, a0, b0)
  let b = wasm_rtrim_ws_range(s, a, b0)
  if a >= b {
    return None
  }
  // Assignment: %dst =<ty> <op> ...
  if str_code_at(s, a) == 37 {
    let eq_idx = wasm_find_char_range(s, 61, a, b)
    if eq_idx < 0 {
      return None
    }
    let dst_b = wasm_rtrim_ws_range(s, a, eq_idx)
    let dst = slice_str(s, a, dst_b)
    let ty_a = wasm_skip_ws_range(s, eq_idx + 1, b)
    let sp1 = wasm_find_char_range(s, 32, ty_a, b)
    if sp1 < 0 {
      return None
    }
    let dst_ty = wasm_parse_qbe_ty_span(s, ty_a, sp1)
    let op_a = wasm_skip_ws_range(s, sp1 + 1, b)
    if wasm_starts_with_at(s, op_a, b, "call ") {
      let ac_a = wasm_skip_ws_range(s, op_a + 5, b)
      let lp = wasm_find_char_range(s, 40, ac_a, b)
      let rp = if lp >= 0 { wasm_find_char_range(s, 41, lp + 1, b) } else { -1 }
      if lp < 0 || rp < 0 {
        return None
      }
      let callee_b = wasm_rtrim_ws_range(s, ac_a, lp)
      let callee = slice_str(s, ac_a, callee_b)
      let args : Array[String] = [callee]
      let arg_tys : Array[Int] = []
      wasm_parse_call_args_span(s, lp + 1, rp, args, arg_tys)
      return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: "call", args: args, arg_tys: arg_tys })
    }
    let sp2 = wasm_find_char_range(s, 32, op_a, b)
    let op_b = if sp2 < 0 { b } else { sp2 }
    let op = slice_str(s, op_a, op_b)
    let arg_a = if sp2 < 0 { b } else { wasm_skip_ws_range(s, sp2 + 1, b) }
    if op == "phi" {
      let args : Array[String] = []
      let mut pstart = arg_a
      let mut pi = arg_a
      while pi <= b {
        if pi == b || str_code_at(s, pi) == 44 {
          let pa = wasm_skip_ws_range(s, pstart, pi)
          let pb = wasm_rtrim_ws_range(s, pa, pi)
          if pb > pa {
            let mut t1_end = pa
            while t1_end < pb && str_code_at(s, t1_end) != 32 && str_code_at(s, t1_end) != 9 {
              t1_end = t1_end + 1
            }
            let t2_start = wasm_skip_ws_range(s, t1_end, pb)
            if t2_start < pb {
              let mut t2_end = t2_start
              while t2_end < pb && str_code_at(s, t2_end) != 32 && str_code_at(s, t2_end) != 9 {
                t2_end = t2_end + 1
              }
              args.push(slice_str(s, pa, t1_end))
              args.push(slice_str(s, t2_start, t2_end))
            }
          }
          pstart = pi + 1
        }
        pi = pi + 1
      }
      return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: "phi", args: args, arg_tys: empty_tys })
    }
    let args = if arg_a < b { wasm_split_commas_span(s, arg_a, b) } else { [] }
    return Some(WasmInst::{ dst: dst, dst_ty: dst_ty, op: op, args: args, arg_tys: empty_tys })
  }

  // Void call
  if wasm_starts_with_at(s, a, b, "call ") {
    let ac_a = wasm_skip_ws_range(s, a + 5, b)
    let lp = wasm_find_char_range(s, 40, ac_a, b)
    let rp = if lp >= 0 { wasm_find_char_range(s, 41, lp + 1, b) } else { -1 }
    if lp < 0 || rp < 0 {
      return None
    }
    let callee_b = wasm_rtrim_ws_range(s, ac_a, lp)
    let callee = slice_str(s, ac_a, callee_b)
    let args : Array[String] = [callee]
    let arg_tys : Array[Int] = []
    wasm_parse_call_args_span(s, lp + 1, rp, args, arg_tys)
    return Some(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: "call", args: args, arg_tys: arg_tys })
  }

  // Other non-assigning instruction: store*, jmp, jnz, jtbl, ret, hlt, blit
  let sp = wasm_find_char_range(s, 32, a, b)
  let op = if sp < 0 { slice_str(s, a, b) } else { slice_str(s, a, sp) }
  let arg_a = if sp < 0 { b } else { wasm_skip_ws_range(s, sp + 1, b) }
  let args = if arg_a < b { wasm_split_commas_span(s, arg_a, b) } else { [] }
  Some(WasmInst::{ dst: "", dst_ty: WASM_TY_VOID, op: op, args: args, arg_tys: empty_tys })
}

///|
fn wasm_scan_raw_sym_refs(
  ssa : String,
  from : Int,
  to : Int,
  func_by_name : Map[String, Int],
  data_by_name : Map[String, Int],
  live_funcs : Array[Bool],
  live_datas : Array[Bool],
  func_q : Array[Int],
  data_q : Array[Int],
) -> Unit {
  let mut in_str = false
  let mut esc = false
  let mut in_comment = false
  let mut i = from
  while i < to {
    let c = str_code_at(ssa, i)
    if in_comment {
      if c == 10 {
        in_comment = false
      }
      i = i + 1
    } else if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
      i = i + 1
    } else if c == 34 {
      in_str = true
      i = i + 1
    } else if c == 35 {
      in_comment = true
      i = i + 1
    } else if c == 36 {
      let mut j = i + 1
      while j < to && wasm_is_sym_char(str_code_at(ssa, j)) {
        j = j + 1
      }
      if j > i + 1 {
        let sym = slice_str(ssa, i + 1, j)
        match func_by_name.get(sym) {
          Some(tfi) =>
            if !live_funcs[tfi] {
              live_funcs[tfi] = true
              func_q.push(tfi)
            }
          None =>
            match data_by_name.get(sym) {
              Some(tdi) =>
                if !live_datas[tdi] {
                  live_datas[tdi] = true
                  data_q.push(tdi)
                }
              None => ()
            }
        }
      }
      i = j
    } else {
      i = i + 1
    }
  }
}

///|
fn wasm_parse_one_func(
  ssa : String,
  name : String,
  exported : Bool,
  ha : Int,
  hb : Int,
  ba : Int,
  bb : Int,
  empty_tys : Array[Int],
) -> WasmFunc {
  let dollar = wasm_find_char_range(ssa, 36, ha, hb)
  let lp = wasm_find_char_range(ssa, 40, dollar + 1, hb)
  let rp = wasm_find_char_range(ssa, 41, lp + 1, hb)
  let ret_ty = wasm_parse_qbe_ty_span(ssa, ha, dollar)
  let param_names : Array[String] = []
  let param_tys : Array[Int] = []
  wasm_parse_call_args_span(ssa, lp + 1, rp, param_names, param_tys)
  let blocks : Array[WasmBlock] = []
  let mut cur_blk : Option[WasmBlock] = None
  let mut p = ba
  while p < bb {
    // Single-pass scan to EOL while tracking first `#` comment
    let mut eol = p
    let mut hash_pos = -1
    while eol < bb {
      let c = str_code_at(ssa, eol)
      if c == 10 {
        break
      }
      if c == 35 && hash_pos < 0 {
        hash_pos = eol
      }
      eol = eol + 1
    }
    let ce = if hash_pos >= 0 { hash_pos } else { eol }
    let la = wasm_skip_ws_range(ssa, p, ce)
    if la < ce {
      let lb = wasm_rtrim_ws_range(ssa, la, ce)
      if lb > la {
        if str_code_at(ssa, la) == 64 {
          let nb = WasmBlock::{ label: slice_str(ssa, la, lb), insts: [] }
          blocks.push(nb)
          cur_blk = Some(nb)
        } else {
          match wasm_parse_inst_span(ssa, la, lb, empty_tys) {
            Some(inst) =>
              match cur_blk {
                None => {
                  let nb = WasmBlock::{ label: "@start", insts: [inst] }
                  blocks.push(nb)
                  cur_blk = Some(nb)
                }
                Some(cb) => cb.insts.push(inst)
              }
            None => ()
          }
        }
      }
    }
    p = if eol < bb { eol + 1 } else { bb }
  }
  WasmFunc::{
    name: name,
    exported: exported,
    ret_ty: ret_ty,
    param_names: param_names,
    param_tys: param_tys,
    blocks: blocks,
  }
}

///|
fn wasm_parse_ssa_live_units(units : Array[String], on_stage : (String) -> Unit) -> WasmModuleParsed {
  let raw_d_unit : Array[Int] = []
  let raw_d_name : Array[String] = []
  let raw_d_a : Array[Int] = []
  let raw_d_b : Array[Int] = []
  let raw_d_multi : Array[Bool] = []
  let data_by_name : Map[String, Int] = Map([])

  let raw_f_unit : Array[Int] = []
  let raw_f_name : Array[String] = []
  let raw_f_exp : Array[Bool] = []
  let raw_f_ha : Array[Int] = []
  let raw_f_hb : Array[Int] = []
  let raw_f_ba : Array[Int] = []
  let raw_f_bb : Array[Int] = []
  let func_by_name : Map[String, Int] = Map([])

  // Pass 1: single linear byte scan across units to index all top-level data & function spans
  let mut ui = 0
  while ui < units.length() {
    let ssa = units[ui]
    let n = ssa.length()
    let mut pos = 0
    while pos < n {
      let mut eol = pos
      while eol < n && str_code_at(ssa, eol) != 10 {
        eol = eol + 1
      }
      let next_pos = if eol < n { eol + 1 } else { n }
      let la0 = wasm_skip_ws_range(ssa, pos, eol)
      if la0 >= eol || str_code_at(ssa, la0) == 35 {
        pos = next_pos
        continue
      }
      let cend = wasm_strip_comment_end(ssa, la0, eol)
      let la = la0
      let lb = wasm_rtrim_ws_range(ssa, la, cend)
      if la >= lb {
        pos = next_pos
        continue
      }
      if wasm_starts_with_at(ssa, la, lb, "data ") || wasm_starts_with_at(ssa, la, lb, "export data ") {
        let d_start = la
        let mut d_end = lb
        let mut is_multi = false
        let mut cur_la = la
        let mut cur_lb = lb
        let mut p = next_pos
        while wasm_find_char_outside_str_range(ssa, 125, cur_la, cur_lb) < 0 && p < n {
          is_multi = true
          let mut e2 = p
          while e2 < n && str_code_at(ssa, e2) != 10 {
            e2 = e2 + 1
          }
          let ce2 = wasm_strip_comment_end(ssa, p, e2)
          cur_la = wasm_skip_ws_range(ssa, p, ce2)
          cur_lb = wasm_rtrim_ws_range(ssa, cur_la, ce2)
          d_end = e2
          p = if e2 < n { e2 + 1 } else { n }
        }
        let eq_idx = wasm_find_char_range(ssa, 61, d_start, lb)
        if eq_idx > d_start {
          let dl = wasm_find_char_range(ssa, 36, d_start, eq_idx)
          if dl >= 0 {
            let na = dl + 1
            let nb = wasm_rtrim_ws_range(ssa, na, eq_idx)
            if nb > na {
              let dname = slice_str(ssa, na, nb)
              match data_by_name.get(dname) {
                Some(_) => ()
                None => {
                  let idx = raw_d_name.length()
                  data_by_name.set(dname, idx)
                  raw_d_unit.push(ui)
                  raw_d_name.push(dname)
                  raw_d_a.push(d_start)
                  raw_d_b.push(d_end)
                  raw_d_multi.push(is_multi)
                }
              }
            }
          }
        }
        pos = p
        continue
      }
      if wasm_starts_with_at(ssa, la, lb, "function ") || wasm_starts_with_at(ssa, la, lb, "export function ") {
        let exported = wasm_starts_with_at(ssa, la, lb, "export ")
        let kw_len = if exported { 16 } else { 9 }
        let hdr_a = wasm_skip_ws_range(ssa, la + kw_len, lb)
        let hdr_b = lb
        let dollar = wasm_find_char_range(ssa, 36, hdr_a, hdr_b)
        let lp = if dollar >= 0 { wasm_find_char_range(ssa, 40, dollar + 1, hdr_b) } else { -1 }
        let rp = if lp >= 0 { wasm_find_char_range(ssa, 41, lp + 1, hdr_b) } else { -1 }
        let body_start = next_pos
        let mut body_end = next_pos
        let mut p = next_pos
        // Fast closing-brace scan: in QBE SSA, `}` is at col 0 (or on a short line)
        while p < n {
          let c0 = str_code_at(ssa, p)
          if c0 == 125 {
            let mut e2 = p + 1
            while e2 < n && str_code_at(ssa, e2) != 10 {
              e2 = e2 + 1
            }
            let r = wasm_rtrim_ws_range(ssa, p + 1, e2)
            if r == p + 1 || str_code_at(ssa, wasm_skip_ws_range(ssa, p + 1, r)) == 35 {
              body_end = p
              p = if e2 < n { e2 + 1 } else { n }
              break
            }
            p = if e2 < n { e2 + 1 } else { n }
            body_end = p
            continue
          }
          let mut e2 = p
          while e2 < n && str_code_at(ssa, e2) != 10 {
            e2 = e2 + 1
          }
          if e2 - p <= 16 {
            let ba = wasm_skip_ws_range(ssa, p, e2)
            if ba < e2 && str_code_at(ssa, ba) == 125 {
              let bb = wasm_rtrim_ws_range(ssa, ba, e2)
              if bb == ba + 1 {
                body_end = p
                p = if e2 < n { e2 + 1 } else { n }
                break
              }
            }
          }
          p = if e2 < n { e2 + 1 } else { n }
          body_end = p
        }
        if dollar >= 0 && lp >= 0 && rp >= 0 {
          let fn_name_b = wasm_rtrim_ws_range(ssa, dollar + 1, lp)
          let fn_name = slice_str(ssa, dollar + 1, fn_name_b)
          match func_by_name.get(fn_name) {
            Some(_) => ()
            None => {
              let idx = raw_f_name.length()
              func_by_name.set(fn_name, idx)
              raw_f_unit.push(ui)
              raw_f_name.push(fn_name)
              raw_f_exp.push(exported)
              raw_f_ha.push(hdr_a)
              raw_f_hb.push(hdr_b)
              raw_f_ba.push(body_start)
              raw_f_bb.push(body_end)
            }
          }
        }
        pos = p
        continue
      }
      pos = next_pos
    }
    ui = ui + 1
  }

  // Pass 2: Raw-span reachability DCE BEFORE parsing instructions
  on_stage("parse_p1_index(raw_f=" + raw_f_name.length().to_string() + ",raw_d=" + raw_d_name.length().to_string() + ")")
  let nf = raw_f_name.length()
  let nd = raw_d_name.length()
  let mut has_explicit_roots = false
  let mut fi = 0
  while fi < nf {
    let fname = raw_f_name[fi]
    if fname == "main" || fname == "_start" ||
      (raw_f_exp[fi] && !wasm_is_internal_mangled_export(fname)) {
      has_explicit_roots = true
      break
    }
    fi = fi + 1
  }
  let live_funcs : Array[Bool] = []
  fi = 0
  while fi < nf {
    live_funcs.push(false)
    fi = fi + 1
  }
  let live_datas : Array[Bool] = []
  let mut di = 0
  while di < nd {
    live_datas.push(false)
    di = di + 1
  }
  let func_q : Array[Int] = []
  let data_q : Array[Int] = []
  fi = 0
  while fi < nf {
    let fname = raw_f_name[fi]
    let is_root = fname == "main" || fname == "_start" ||
      (raw_f_exp[fi] && (!has_explicit_roots || !wasm_is_internal_mangled_export(fname)))
    if is_root {
      live_funcs[fi] = true
      func_q.push(fi)
    }
    fi = fi + 1
  }
  if func_q.length() == 0 {
    fi = 0
    while fi < nf {
      live_funcs[fi] = true
      fi = fi + 1
    }
    di = 0
    while di < nd {
      live_datas[di] = true
      di = di + 1
    }
  } else {
    let mut fq_head = 0
    let mut dq_head = 0
    while fq_head < func_q.length() || dq_head < data_q.length() {
      while fq_head < func_q.length() {
        let cur_fi = func_q[fq_head]
        fq_head = fq_head + 1
        wasm_scan_raw_sym_refs(
          units[raw_f_unit[cur_fi]],
          raw_f_ba[cur_fi],
          raw_f_bb[cur_fi],
          func_by_name,
          data_by_name,
          live_funcs,
          live_datas,
          func_q,
          data_q,
        )
      }
      while dq_head < data_q.length() {
        let cur_di = data_q[dq_head]
        dq_head = dq_head + 1
        let dssa = units[raw_d_unit[cur_di]]
        let lb = wasm_find_char_outside_str_range(dssa, 123, raw_d_a[cur_di], raw_d_b[cur_di])
        if lb >= 0 {
          wasm_scan_raw_sym_refs(
            dssa,
            lb + 1,
            raw_d_b[cur_di],
            func_by_name,
            data_by_name,
            live_funcs,
            live_datas,
            func_q,
            data_q,
          )
        }
      }
    }
  }

  // Pass 2b: Raw-text exact pre-dedup for non-root live functions BEFORE parsing instructions!
  // Pre-filter by body byte length so unique-length functions skip slice_str + concat completely.
  let len_cnt : Map[Int, Int] = Map([])
  fi = 0
  while fi < nf {
    if live_funcs[fi] {
      let blen = raw_f_bb[fi] - raw_f_ba[fi]
      let prev = match len_cnt.get(blen) {
        Some(c) => c
        None => 0
      }
      len_cnt.set(blen, prev + 1)
    }
    fi = fi + 1
  }
  let raw_fn_aliases : Map[String, String] = Map([])
  let raw_seen_fn : Map[String, String] = Map([])
  fi = 0
  while fi < nf {
    if live_funcs[fi] {
      let blen = raw_f_bb[fi] - raw_f_ba[fi]
      let lcnt = match len_cnt.get(blen) {
        Some(c) => c
        None => 0
      }
      if lcnt > 1 {
        let fname = raw_f_name[fi]
        let is_root = fname == "main" || fname == "_start" ||
          (raw_f_exp[fi] && (!has_explicit_roots || !wasm_is_internal_mangled_export(fname)))
        if !is_root {
          let ssa = units[raw_f_unit[fi]]
          let ha = raw_f_ha[fi]
          let hb = raw_f_hb[fi]
          let dollar = wasm_find_char_range(ssa, 36, ha, hb)
          let lp = wasm_find_char_range(ssa, 40, dollar + 1, hb)
          let rp = wasm_find_char_range(ssa, 41, lp + 1, hb)
          if dollar >= 0 && lp >= 0 && rp >= 0 {
            let rkey = slice_str(ssa, ha, dollar) + "|" + slice_str(ssa, lp, rp) + "|" + slice_str(ssa, raw_f_ba[fi], raw_f_bb[fi])
            match raw_seen_fn.get(rkey) {
              Some(canon) => {
                raw_fn_aliases.set(fname, canon)
                live_funcs[fi] = false
              }
              None => raw_seen_fn.set(rkey, fname)
            }
          }
        }
      }
    }
    fi = fi + 1
  }

  // Pass 3: Parse ONLY live datas and unique live functions using zero-intermediate-slice span parser
  on_stage("parse_p2_raw_dce(raw_dedup=" + raw_fn_aliases.length().to_string() + ")")
  let datas : Array[WasmDataDef] = []
  di = 0
  while di < nd {
    if live_datas[di] {
      let ssa = units[raw_d_unit[di]]
      let text = if !raw_d_multi[di] {
        slice_str(ssa, raw_d_a[di], raw_d_b[di])
      } else {
        let sb = StringBuilder()
        let mut p = raw_d_a[di]
        let dend = raw_d_b[di]
        while p < dend {
          let mut eol = p
          while eol < dend && str_code_at(ssa, eol) != 10 {
            eol = eol + 1
          }
          let ce = wasm_strip_comment_end(ssa, p, eol)
          let la = wasm_skip_ws_range(ssa, p, ce)
          let lb = wasm_rtrim_ws_range(ssa, la, ce)
          if lb > la {
            sb.write_string(slice_str(ssa, la, lb))
            sb.write_char(' ')
          }
          p = if eol < dend { eol + 1 } else { dend }
        }
        sb.to_string()
      }
      match wasm_parse_data_def(text) {
        Some(dd) => datas.push(dd)
        None => ()
      }
    }
    di = di + 1
  }

  let empty_tys : Array[Int] = []
  let funcs : Array[WasmFunc] = []
  fi = 0
  while fi < nf {
    if live_funcs[fi] {
      funcs.push(
        wasm_parse_one_func(
          units[raw_f_unit[fi]],
          raw_f_name[fi],
          raw_f_exp[fi],
          raw_f_ha[fi],
          raw_f_hb[fi],
          raw_f_ba[fi],
          raw_f_bb[fi],
          empty_tys,
        ),
      )
    }
    fi = fi + 1
  }
  if raw_fn_aliases.length() > 0 {
    let mut rfi = 0
    while rfi < funcs.length() {
      let f = funcs[rfi]
      let mut rbi = 0
      while rbi < f.blocks.length() {
        let insts = f.blocks[rbi].insts
        let mut rii = 0
        while rii < insts.length() {
          let args = insts[rii].args
          let mut rai = 0
          while rai < args.length() {
            let a = args[rai]
            if a.length() > 1 && str_code_at(a, 0) == 36 {
              args[rai] = wasm_rewrite_sym_ref(a, raw_fn_aliases)
            }
            rai = rai + 1
          }
          rii = rii + 1
        }
        rbi = rbi + 1
      }
      rfi = rfi + 1
    }
    let mut rdi = 0
    while rdi < datas.length() {
      let items = datas[rdi].items
      let mut rii = 0
      while rii < items.length() {
        let r = items[rii].raw
        if r.length() > 1 && str_code_at(r, 0) == 36 {
          let nr = wasm_rewrite_sym_ref(r, raw_fn_aliases)
          if nr != r {
            items[rii] = WasmDataItem::{ kind: items[rii].kind, raw: nr }
          }
        }
        rii = rii + 1
      }
      rdi = rdi + 1
    }
  }
  WasmModuleParsed::{ datas: datas, funcs: funcs }
}

///|
fn wasm_parse_ssa(ssa : String) -> WasmModuleParsed {
  let lines = wasm_split_lines(ssa)
  let datas : Array[WasmDataDef] = []
  let funcs : Array[WasmFunc] = []
  let seen_datas : Map[String, Bool] = Map([])
  let seen_funcs : Map[String, Bool] = Map([])
  let n = lines.length()
  let mut i = 0
  while i < n {
    let raw_line = wasm_trim(wasm_strip_comment(lines[i]))
    if raw_line.length() == 0 {
      i = i + 1
      continue
    }
    if raw_line.starts_with("data ") || raw_line.starts_with("export data ") {
      let sb = StringBuilder()
      sb.write_string(raw_line)
      while wasm_find_char_outside_str(sb.to_string(), 125, 0) < 0 && i + 1 < n {
        i = i + 1
        sb.write_char(' ')
        sb.write_string(wasm_trim(wasm_strip_comment(lines[i])))
      }
      match wasm_parse_data_def(sb.to_string()) {
        Some(dd) =>
          match seen_datas.get(dd.name) {
            Some(_) => ()
            None => {
              seen_datas.set(dd.name, true)
              datas.push(dd)
            }
          }
        None => ()
      }
      i = i + 1
      continue
    }
    if raw_line.starts_with("function ") || raw_line.starts_with("export function ") {
      let exported = raw_line.starts_with("export ")
      let after_kw = if exported {
        wasm_trim(slice_str(raw_line, 16, raw_line.length()))
      } else {
        wasm_trim(slice_str(raw_line, 9, raw_line.length()))
      }
      let dollar = wasm_find_char(after_kw, 36, 0)
      let lp = wasm_find_char(after_kw, 40, if dollar >= 0 { dollar + 1 } else { 0 })
      let rp = wasm_find_char(after_kw, 41, if lp >= 0 { lp + 1 } else { 0 })
      if dollar < 0 || lp < 0 || rp < 0 {
        i = i + 1
        continue
      }
      let ret_ty_str = wasm_trim(slice_str(after_kw, 0, dollar))
      let ret_ty = wasm_parse_qbe_ty(ret_ty_str)
      let fn_name = wasm_trim(slice_str(after_kw, dollar + 1, lp))
      let param_str = slice_str(after_kw, lp + 1, rp)
      let param_names : Array[String] = []
      let param_tys : Array[Int] = []
      let pparts = wasm_split_commas(param_str)
      let mut pi = 0
      while pi < pparts.length() {
        let pp = wasm_trim(pparts[pi])
        if pp == "..." || pp.length() == 0 {
          pi = pi + 1
          continue
        }
        let ptoks = wasm_split_ws(pp)
        if ptoks.length() >= 2 {
          if ptoks[0] == "env" {
            param_tys.push(WASM_TY_I64)
            param_names.push(ptoks[1])
          } else {
            let pty = wasm_parse_qbe_ty(ptoks[0])
            param_tys.push(if pty == WASM_TY_VOID { WASM_TY_I64 } else { pty })
            param_names.push(ptoks[1])
          }
        }
        pi = pi + 1
      }
      let blocks : Array[WasmBlock] = []
      let mut cur_blk : Option[WasmBlock] = None
      i = i + 1
      while i < n {
        let bl = wasm_trim(wasm_strip_comment(lines[i]))
        if bl == "}" {
          i = i + 1
          break
        }
        if bl.length() == 0 {
          i = i + 1
          continue
        }
        if str_code_at(bl, 0) == 64 {
          let nb = WasmBlock::{ label: bl, insts: [] }
          blocks.push(nb)
          cur_blk = Some(nb)
        } else {
          match cur_blk {
            None => {
              let nb = WasmBlock::{ label: "@start", insts: [] }
              blocks.push(nb)
              cur_blk = Some(nb)
              match wasm_parse_inst(bl) {
                Some(inst) => nb.insts.push(inst)
                None => ()
              }
            }
            Some(cb) =>
              match wasm_parse_inst(bl) {
                Some(inst) => cb.insts.push(inst)
                None => ()
              }
          }
        }
        i = i + 1
      }
      match seen_funcs.get(fn_name) {
        Some(_) => ()
        None => {
          seen_funcs.set(fn_name, true)
          funcs.push(WasmFunc::{
            name: fn_name,
            exported: exported,
            ret_ty: ret_ty,
            param_names: param_names,
            param_tys: param_tys,
            blocks: blocks,
          })
        }
      }
      continue
    }
    i = i + 1
  }
  WasmModuleParsed::{ datas: datas, funcs: funcs }
}

///|
fn wasm_data_item_size(item : WasmDataItem) -> Int {
  if item.kind == "b" {
    if item.raw.length() > 0 && str_code_at(item.raw, 0) == 34 {
      wasm_unescape_qbe_str(item.raw).length()
    } else {
      1
    }
  } else if item.kind == "h" {
    2
  } else if item.kind == "w" || item.kind == "s" {
    4
  } else if item.kind == "l" || item.kind == "d" {
    8
  } else if item.kind == "z" {
    wasm_parse_int64(item.raw).to_int()
  } else {
    0
  }
}

///|
fn wasm_align_up(n0 : Int, align : Int) -> Int {
  if align <= 1 {
    return n0
  }
  let rem = n0 % align
  if rem == 0 { n0 } else { n0 + (align - rem) }
}

///|
struct WasmModCtx {
  sigs : Array[WasmSig]
  sig_map : Map[String, Int]
  import_names : Array[String]
  import_sigs : Array[Int]
  import_ret_tys : Array[Int]
  import_map : Map[String, Int]
  internal_map : Map[String, Int]
  internal_ret_tys : Map[String, Int]
  data_addrs : Map[String, Int]
  fn_table_idx : Map[String, Int]
  fn_table_list : Array[String]
  slot_drop_masks : Map[String, Int64]
}

///|
fn wasm_intern_sig(ctx : WasmModCtx, param_tys : Array[Int], ret_ty : Int) -> Int {
  let key = wasm_sig_key(param_tys, ret_ty)
  match ctx.sig_map.get(key) {
    Some(idx) => idx
    None => {
      let idx = ctx.sigs.length()
      ctx.sigs.push(WasmSig::{ param_tys: param_tys, ret_ty: ret_ty })
      ctx.sig_map.set(key, idx)
      idx
    }
  }
}

///|
/// Read-only signature lookup (safe for parallel wasm_compile_func after pre-interning).
fn wasm_lookup_sig(ctx : WasmModCtx, param_tys : Array[Int], ret_ty : Int) -> Int {
  let key = wasm_sig_key(param_tys, ret_ty)
  match ctx.sig_map.get(key) {
    Some(idx) => idx
    None => 0
  }
}

///|
/// P47-A: Parse compiler-generated `pion_drop_slots_<decimal_mask>` (emitted by `qbe_slots_canonical_key`
/// when all pointer slots are in 0..30) into a tagged 31-bit slot mask `(0x80000000L | mask)`; else 0L.
/// Symbols with `max_slot >= 31` use `pion_drop_slots_x_<hex>` and naturally return 0L (normal call_indirect).
fn wasm_try_parse_slot_drop_mask(sym : String) -> Int64 {
  let n = sym.length()
  if !sym.starts_with("pion_drop_slots_") || n <= 16 || n > 26 {
    return 0L
  }
  let mut i = 16
  let mut mask : Int64 = 0L
  while i < n {
    let ch = str_code_at(sym, i)
    if ch < 48 || ch > 57 {
      return 0L
    }
    mask = mask * 10L + (ch - 48).to_int64()
    if mask > 2147483647L {
      return 0L
    }
    i = i + 1
  }
  if mask <= 0L {
    return 0L
  }
  2147483648L | mask
}

///|
/// P47-A: Parse non-negative decimal integer literal; returns -1 if not pure digits.
fn wasm_try_parse_nonneg_int(s : String) -> Int {
  let t = wasm_trim(s)
  let n = t.length()
  if n == 0 || n > 9 {
    return -1
  }
  let mut i = 0
  let mut v = 0
  while i < n {
    let ch = str_code_at(t, i)
    if ch < 48 || ch > 57 {
      return -1
    }
    v = v * 10 + (ch - 48)
    i = i + 1
  }
  v
}

///|
/// P47-A: General SSA-level recognizer for pure slot-dropping functions (`$pion_drop_struct_*`,
/// `$pion_drop_slots_*`, `$pion_drop_clo_*`) that only load 8-byte aligned slots in 0..30
/// from `%p` and call `$pion_rc_dec` on each (with or without a `jnz` null guard).
/// Returns `(0x80000000L | mask)` on exact match, else `0L`.
fn wasm_try_extract_slot_drop_mask(f : WasmFunc) -> Int64 {
  if f.ret_ty != WASM_TY_VOID || f.param_names.length() != 1 ||
    f.param_tys.length() != 1 || f.param_tys[0] != WASM_TY_I64 {
    return 0L
  }
  let nb = f.blocks.length()
  if nb == 0 {
    return 0L
  }
  let p_sym = f.param_names[0]
  let addr_off : Map[String, Int] = Map([])
  let loaded_off : Map[String, Int] = Map([])
  // `%nz =w cnel %v, 0` null tests (full 64-bit guard before `jnz`): `%nz` -> `%v`.
  let nz_src : Map[String, String] = Map([])
  let mut mask : Int64 = 0L
  let mut count = 0
  let mut bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let ni = insts.length()
    let mut ii = 0
    while ii < ni {
      let inst = insts[ii]
      let op = inst.op
      if op == "add" && inst.args.length() == 2 && wasm_trim(inst.args[0]) == p_sym {
        let off = wasm_try_parse_nonneg_int(inst.args[1])
        if off < 0 || (off & 7) != 0 || (off >> 3) > 30 {
          return 0L
        }
        addr_off.set(inst.dst, off)
      } else if op == "loadl" && inst.args.length() == 1 {
        let src = wasm_trim(inst.args[0])
        if src == p_sym {
          loaded_off.set(inst.dst, 0)
        } else {
          match addr_off.get(src) {
            Some(off) => loaded_off.set(inst.dst, off)
            None => return 0L
          }
        }
      } else if op == "call" && inst.args.length() == 2 && inst.args[0] == "$pion_rc_dec" {
        let arg = wasm_trim(inst.args[1])
        match loaded_off.get(arg) {
          Some(off) => {
            mask = mask | (1L << (off >> 3))
            count = count + 1
          }
          None => return 0L
        }
      } else if op == "cnel" && inst.args.length() == 2 && wasm_trim(inst.args[1]) == "0" &&
        loaded_off.contains(wasm_trim(inst.args[0])) {
        nz_src.set(inst.dst, wasm_trim(inst.args[0]))
      } else if op == "jnz" && inst.args.length() == 3 && ii == ni - 1 {
        if bi + 2 >= nb {
          return 0L
        }
        let dec_lbl = f.blocks[bi + 1].label
        let next_lbl = f.blocks[bi + 2].label
        if inst.args[1] != dec_lbl || inst.args[2] != next_lbl {
          return 0L
        }
        let cond = match nz_src.get(wasm_trim(inst.args[0])) {
          Some(v) => v
          None => wasm_trim(inst.args[0])
        }
        let off = match loaded_off.get(cond) {
          Some(o) => o
          None => return 0L
        }
        let d_insts = f.blocks[bi + 1].insts
        let dlen = d_insts.length()
        if dlen != 1 && !(dlen == 2 && d_insts[1].op == "jmp" && d_insts[1].args.length() == 1 && d_insts[1].args[0] == next_lbl) {
          return 0L
        }
        if d_insts[0].op != "call" || d_insts[0].args.length() != 2 ||
          d_insts[0].args[0] != "$pion_rc_dec" || wasm_trim(d_insts[0].args[1]) != cond {
          return 0L
        }
        mask = mask | (1L << (off >> 3))
        count = count + 1
        bi = bi + 1
      } else if op == "ret" && bi == nb - 1 && ii == ni - 1 {
        ()
      } else {
        return 0L
      }
      ii = ii + 1
    }
    bi = bi + 1
  }
  if count == 0 || mask <= 0L {
    return 0L
  }
  2147483648L | mask
}

///|
fn wasm_register_fn_addr(ctx : WasmModCtx, sym : String) -> Unit {
  let exists = match ctx.internal_map.get(sym) {
    Some(_) => true
    None =>
      match ctx.import_map.get(sym) {
        Some(_) => true
        None => false
      }
  }
  if exists {
    match ctx.fn_table_idx.get(sym) {
      Some(_) => ()
      None => {
        let slot = ctx.fn_table_list.length() + 1
        ctx.fn_table_idx.set(sym, slot)
        ctx.fn_table_list.push(sym)
      }
    }
  }
}

///|
fn wasm_scan_sym_operand(ctx : WasmModCtx, op : String) -> Unit {
  if op.length() > 1 && str_code_at(op, 0) == 36 {
    let sym = slice_str(op, 1, op.length())
    wasm_register_fn_addr(ctx, sym)
  }
}

///|
fn wasm_eval_data_sym_expr(ctx : WasmModCtx, raw : String) -> Int64 {
  let s = wasm_trim(raw)
  if s.length() > 0 && str_code_at(s, 0) == 36 {
    // Support `$sym`, `$sym + off`, `$sym - off`
    let plus = wasm_find_char(s, 43, 1)
    let minus = wasm_find_char(s, 45, 1)
    let mut sym = slice_str(s, 1, s.length())
    let mut off : Int64 = 0L
    if plus > 0 {
      sym = wasm_trim(slice_str(s, 1, plus))
      off = wasm_parse_int64(slice_str(s, plus + 1, s.length()))
    } else if minus > 0 {
      sym = wasm_trim(slice_str(s, 1, minus))
      off = 0L - wasm_parse_int64(slice_str(s, minus + 1, s.length()))
    }
    match ctx.data_addrs.get(sym) {
      Some(addr) => return addr.to_int64() + off
      None => ()
    }
    match ctx.fn_table_idx.get(sym) {
      Some(slot) => return slot.to_int64() + off
      None => ()
    }
    if off == 0L {
      match ctx.slot_drop_masks.get(sym) {
        Some(sm) => return sm
        None => ()
      }
      let sm = wasm_try_parse_slot_drop_mask(sym)
      if sm != 0L {
        return sm
      }
    }
    return 0L
  }
  wasm_parse_int64(s)
}

///|
struct WasmFnCtx {
  local_idx : Map[String, Int]
  local_ty : Map[String, Int]
  extra_local_tys : Array[Int]
  n_params : Int
  alloc_offsets : Map[String, Int]
  frame_size : Int
  fp_local : Int
  pc_local : Int
  block_idx : Map[String, Int]
  // phi_moves[pred_blk][dst_blk] -> Array[(dst_local, dst_ty, src_operand)]
  has_phi : Bool
  phi_preds : Array[Int]
  phi_dsts : Array[Int]
  phi_dst_names : Array[String]
  phi_dst_tys : Array[Int]
  phi_src_ops : Array[String]
  phi_tmp_i32 : Int
  phi_tmp_i64 : Int
  phi_tmp_f32 : Int
  phi_tmp_f64 : Int
  use_counts : Map[String, Int]
  def_counts : Map[String, Int]
  promoted_alloc_ty : Map[String, Int]
  promoted_alloc_lidx : Map[String, Int]
  promoted_alloc_touched : Map[String, Bool]
  blk0_is_target : Bool
  const_copies : Map[String, String]
  addr_off_base : Map[String, String]
  addr_off_const : Map[String, Int]
  hot_blk : Array[Bool]
  mut div_tmp_i32 : Int
  mut div_tmp_i64 : Int
  mut alloc_tmp_i32 : Int
  mut alloc_tmp2_i32 : Int
  mut push_tmp_i64 : Int
  mut last_set_pos : Int
  mut last_set_end : Int
  mut last_set_sym : String
  mut last_set_ty : Int
  mut last_set_lidx : Int
  mut last_set_fresh : Bool
}

///|
fn wasm_fn_alloc_local(fctx : WasmFnCtx, ty : Int) -> Int {
  let idx = fctx.n_params + fctx.extra_local_tys.length()
  fctx.extra_local_tys.push(ty)
  idx
}

///|
fn wasm_get_div_tmp_i32(fctx : WasmFnCtx) -> Int {
  if fctx.div_tmp_i32 < 0 {
    fctx.div_tmp_i32 = wasm_fn_alloc_local(fctx, WASM_TY_I32)
  }
  fctx.div_tmp_i32
}

///|
fn wasm_get_div_tmp_i64(fctx : WasmFnCtx) -> Int {
  if fctx.div_tmp_i64 < 0 {
    fctx.div_tmp_i64 = wasm_fn_alloc_local(fctx, WASM_TY_I64)
  }
  fctx.div_tmp_i64
}

///|
fn wasm_try_parse_nonneg_i32_const(raw : String) -> Int64 {
  let s = wasm_trim(raw)
  let n = s.length()
  if n == 0 || n > 10 {
    return -1L
  }
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return -1L
    }
    i = i + 1
  }
  let v = wasm_parse_int64(s)
  if v >= 0L && v <= 2147483647L {
    v
  } else {
    -1L
  }
}

///|
fn wasm_try_parse_pos_i64_const(fctx : WasmFnCtx, raw : String) -> Int64 {
  let mut s = wasm_trim(raw)
  if s.length() > 0 && str_code_at(s, 0) == 37 {
    match fctx.const_copies.get(s) {
      Some(imm) => s = wasm_trim(imm)
      None => return 0L
    }
  }
  let n = s.length()
  if n == 0 || n > 19 {
    return 0L
  }
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return 0L
    }
    i = i + 1
  }
  let v = wasm_parse_int64(s)
  if v > 0L {
    v
  } else {
    0L
  }
}

///|
fn wasm_pow2_shift(d : Int64) -> Int {
  if d < 2L || (d & (d - 1L)) != 0L {
    return 0
  }
  let mut k = 0
  let mut v = d
  while v > 1L {
    v = v >> 1
    k = k + 1
  }
  k
}

///|
fn wasm_sdiv32_magic_p(d : Int64) -> Int {
  let lim : Int64 = 1L << 31
  let mut p = 32
  while p <= 62 {
    let two_p : Int64 = 1L << p
    let rem = two_p % d
    let delta = d - rem
    if two_p > lim * delta {
      return p
    }
    p = p + 1
  }
  -1
}

///|
fn wasm_is_mem_load_op(op : String) -> Bool {
  op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" ||
  op == "loadsh" || op == "loaduh" || op == "loadsb" || op == "loadub" ||
  op == "loads" || op == "loadd"
}

///|
fn wasm_is_mem_store_op(op : String) -> Bool {
  op == "storel" || op == "storew" || op == "storeh" || op == "storeb" ||
  op == "stores" || op == "stored"
}

///|
fn wasm_invert_int_cmp_op(op : String) -> String {
  if op == "ceqw" {
    "cnew"
  } else if op == "cnew" {
    "ceqw"
  } else if op == "csltw" {
    "csgew"
  } else if op == "csgew" {
    "csltw"
  } else if op == "cslew" {
    "csgtw"
  } else if op == "csgtw" {
    "cslew"
  } else if op == "cultw" {
    "cugew"
  } else if op == "cugew" {
    "cultw"
  } else if op == "culew" {
    "cugtw"
  } else if op == "cugtw" {
    "culew"
  } else if op == "ceql" {
    "cnel"
  } else if op == "cnel" {
    "ceql"
  } else if op == "csltl" {
    "csgel"
  } else if op == "csgel" {
    "csltl"
  } else if op == "cslel" {
    "csgtl"
  } else if op == "csgtl" {
    "cslel"
  } else if op == "cultl" {
    "cugel"
  } else if op == "cugel" {
    "cultl"
  } else if op == "culel" {
    "cugtl"
  } else if op == "cugtl" {
    "culel"
  } else {
    ""
  }
}

///|
fn wasm_emit_int_cmp_stack(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  op : String,
  a0 : String,
  a1 : String,
) -> Unit {
  let last_c = str_code_at(op, op.length() - 1)
  let cmp_ty = if last_c == 119 { WASM_TY_I32 } else { WASM_TY_I64 }
  let pred = slice_str(op, 1, op.length() - 1)
  wasm_emit_operand(ctx, fctx, code, a0, cmp_ty)
  wasm_emit_operand(ctx, fctx, code, a1, cmp_ty)
  if cmp_ty == WASM_TY_I32 {
    if pred == "eq" {
      code.push(0x46)
    } else if pred == "ne" {
      code.push(0x47)
    } else if pred == "slt" {
      code.push(0x48)
    } else if pred == "ult" {
      code.push(0x49)
    } else if pred == "sgt" {
      code.push(0x4A)
    } else if pred == "ugt" {
      code.push(0x4B)
    } else if pred == "sle" {
      code.push(0x4C)
    } else if pred == "ule" {
      code.push(0x4D)
    } else if pred == "sge" {
      code.push(0x4E)
    } else {
      code.push(0x4F)
    }
  } else {
    if pred == "eq" {
      code.push(0x51)
    } else if pred == "ne" {
      code.push(0x52)
    } else if pred == "slt" {
      code.push(0x53)
    } else if pred == "ult" {
      code.push(0x54)
    } else if pred == "sgt" {
      code.push(0x55)
    } else if pred == "ugt" {
      code.push(0x56)
    } else if pred == "sle" {
      code.push(0x57)
    } else if pred == "ule" {
      code.push(0x58)
    } else if pred == "sge" {
      code.push(0x59)
    } else {
      code.push(0x5A)
    }
  }
}

///|
fn wasm_fn_get_or_alloc_local(fctx : WasmFnCtx, sym : String, ty : Int) -> Int {
  match fctx.local_idx.get(sym) {
    Some(k) => k
    None => {
      let idx = fctx.n_params + fctx.extra_local_tys.length()
      fctx.extra_local_tys.push(ty)
      fctx.local_idx.set(sym, idx)
      idx
    }
  }
}

///|
fn wasm_inc_sym_count(counts : Map[String, Int], raw : String) -> Unit {
  let s = wasm_trim(raw)
  if s.length() > 0 && str_code_at(s, 0) == 37 {
    let prev = match counts.get(s) {
      Some(c) => c
      None => 0
    }
    counts.set(s, prev + 1)
  }
}

///|
fn wasm_emit_set_local(
  fctx : WasmFnCtx,
  code : Array[Int],
  sym : String,
  lty : Int,
) -> Unit {
  let use_cnt = match fctx.use_counts.get(sym) {
    Some(c) => c
    None => 0
  }
  let mut fresh = false
  let lidx = match fctx.local_idx.get(sym) {
    Some(k) => k
    None => {
      if use_cnt == 0 {
        fctx.last_set_pos = -1
        code.push(0x1A) // drop unused value without allocating a local slot
        return
      }
      fresh = true
      let idx = fctx.n_params + fctx.extra_local_tys.length()
      fctx.extra_local_tys.push(lty)
      fctx.local_idx.set(sym, idx)
      idx
    }
  }
  let pos = code.length()
  code.push(0x21) // local.set
  wasm_push_u32(code, lidx)
  fctx.last_set_pos = pos
  fctx.last_set_end = code.length()
  fctx.last_set_sym = sym
  fctx.last_set_ty = lty
  fctx.last_set_lidx = lidx
  fctx.last_set_fresh = fresh
}

///|
fn wasm_emit_operand(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  op : String,
  want_ty : Int,
) -> Unit {
  let s = wasm_trim(op)
  if s.length() == 0 {
    fctx.last_set_pos = -1
    if want_ty == WASM_TY_I32 {
      code.push(0x41)
      wasm_push_s32(code, 0)
    } else if want_ty == WASM_TY_I64 {
      code.push(0x42)
      wasm_push_s64(code, 0L)
    } else if want_ty == WASM_TY_F32 {
      code.push(0x43)
      wasm_push_i32_le(code, 0)
    } else {
      code.push(0x44)
      wasm_push_i64_le(code, 0L)
    }
    return
  }
  let c0 = str_code_at(s, 0)
  // Local variable %...
  if c0 == 37 {
    let lty = match fctx.local_ty.get(s) {
      Some(t) => t
      None => want_ty
    }
    match fctx.const_copies.get(s) {
      Some(imm) => {
        fctx.last_set_pos = -1
        wasm_emit_operand(ctx, fctx, code, imm, lty)
        if lty != want_ty {
          if lty == WASM_TY_I64 && want_ty == WASM_TY_I32 {
            code.push(0xA7) // i32.wrap_i64
          } else if lty == WASM_TY_I32 && want_ty == WASM_TY_I64 {
            code.push(0xAD) // i64.extend_i32_u
          } else if lty == WASM_TY_F32 && want_ty == WASM_TY_F64 {
            code.push(0xBB) // f64.promote_f32
          } else if lty == WASM_TY_F64 && want_ty == WASM_TY_F32 {
            code.push(0xB6) // f32.demote_f64
          }
        }
        return
      }
      None => ()
    }
    if fctx.last_set_pos >= 0 && code.length() == fctx.last_set_end &&
      s == fctx.last_set_sym && lty == fctx.last_set_ty {
      let use_cnt = match fctx.use_counts.get(s) {
        Some(c) => c
        None => 0
      }
      let def_cnt = match fctx.def_counts.get(s) {
        Some(c) => c
        None => 0
      }
      let set_pos = fctx.last_set_pos
      let set_end = fctx.last_set_end
      let set_lidx = fctx.last_set_lidx
      let set_fresh = fctx.last_set_fresh
      fctx.last_set_pos = -1
      if use_cnt == 1 && def_cnt == 1 {
        let mut pop_n = set_end - set_pos
        while pop_n > 0 {
          let _ = code.pop()
          pop_n = pop_n - 1
        }
        if set_fresh && set_lidx == fctx.n_params + fctx.extra_local_tys.length() - 1 {
          let _ = fctx.extra_local_tys.pop()
          fctx.local_idx.remove(s)
        }
      } else {
        // Multi-use adjacent read: convert local.set (0x21) -> local.tee (0x22)
        code[set_pos] = 0x22
      }
    } else {
      fctx.last_set_pos = -1
      let idx = wasm_fn_get_or_alloc_local(fctx, s, lty)
      code.push(0x20) // local.get
      wasm_push_u32(code, idx)
    }
    if lty != want_ty {
      if lty == WASM_TY_I64 && want_ty == WASM_TY_I32 {
        code.push(0xA7) // i32.wrap_i64
      } else if lty == WASM_TY_I32 && want_ty == WASM_TY_I64 {
        code.push(0xAD) // i64.extend_i32_u
      } else if lty == WASM_TY_F32 && want_ty == WASM_TY_F64 {
        code.push(0xBB) // f64.promote_f32
      } else if lty == WASM_TY_F64 && want_ty == WASM_TY_F32 {
        code.push(0xB6) // f32.demote_f64
      }
    }
    return
  }
  fctx.last_set_pos = -1
  // Global symbol $...
  if c0 == 36 {
    let sym = slice_str(s, 1, s.length())
    let mut addr : Int64 = 0L
    match ctx.data_addrs.get(sym) {
      Some(a) => addr = a.to_int64()
      None =>
        match ctx.fn_table_idx.get(sym) {
          Some(slot) => addr = slot.to_int64()
          None =>
            match ctx.slot_drop_masks.get(sym) {
              Some(sm) => addr = sm
              None => {
                let sm = wasm_try_parse_slot_drop_mask(sym)
                if sm != 0L {
                  addr = sm
                }
              }
            }
        }
    }
    if want_ty == WASM_TY_I32 {
      code.push(0x41)
      wasm_push_s32(code, addr.to_int())
    } else {
      code.push(0x42)
      wasm_push_s64(code, addr)
    }
    return
  }
  // Float / Double literal: d_... or s_...
  if s.starts_with("d_") {
    let bits = wasm_parse_double_bits(slice_str(s, 2, s.length()))
    if want_ty == WASM_TY_F32 {
      code.push(0x43)
      wasm_push_i32_le(code, wasm_f64_bits_to_f32_bits(bits))
    } else if want_ty == WASM_TY_I64 {
      code.push(0x42)
      wasm_push_s64(code, bits)
    } else {
      code.push(0x44)
      wasm_push_i64_le(code, bits)
    }
    return
  }
  if s.starts_with("s_") {
    let bits64 = wasm_parse_double_bits(slice_str(s, 2, s.length()))
    let bits32 = wasm_f64_bits_to_f32_bits(bits64)
    if want_ty == WASM_TY_F64 {
      code.push(0x43)
      wasm_push_i32_le(code, bits32)
      code.push(0xBB) // f64.promote_f32
    } else if want_ty == WASM_TY_I32 {
      code.push(0x41)
      wasm_push_s32(code, bits32)
    } else {
      code.push(0x43)
      wasm_push_i32_le(code, bits32)
    }
    return
  }
  // Integer literal
  let iv = wasm_parse_int64(s)
  if want_ty == WASM_TY_I32 {
    code.push(0x41)
    wasm_push_s32(code, iv.to_int())
  } else if want_ty == WASM_TY_I64 {
    code.push(0x42)
    wasm_push_s64(code, iv)
  } else if want_ty == WASM_TY_F32 {
    code.push(0x43)
    wasm_push_i32_le(code, iv.to_int())
  } else {
    code.push(0x44)
    wasm_push_i64_le(code, iv)
  }
}

///|
fn wasm_emit_addr(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  op : String,
) -> Unit {
  wasm_emit_operand(ctx, fctx, code, op, WASM_TY_I32)
}

///|
fn wasm_has_phi_edge(fctx : WasmFnCtx, pred_idx : Int, dst_idx : Int) -> Bool {
  if !fctx.has_phi {
    return false
  }
  let mut i = 0
  while i < fctx.phi_preds.length() {
    if fctx.phi_preds[i] == pred_idx && fctx.phi_dsts[i] == dst_idx {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn wasm_emit_phi_edge(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  pred_idx : Int,
  dst_idx : Int,
) -> Unit {
  fctx.last_set_pos = -1
  if !fctx.has_phi {
    return
  }
  let matched : Array[Int] = []
  let mut i = 0
  while i < fctx.phi_preds.length() {
    if fctx.phi_preds[i] == pred_idx && fctx.phi_dsts[i] == dst_idx {
      matched.push(i)
    }
    i = i + 1
  }
  if matched.length() == 0 {
    return
  }
  // Push all source values onto the Wasm operand stack first (handles parallel phi swaps safely!),
  // then pop them into destination locals in reverse order.
  i = 0
  while i < matched.length() {
    let k = matched[i]
    wasm_emit_operand(ctx, fctx, code, fctx.phi_src_ops[k], fctx.phi_dst_tys[k])
    i = i + 1
  }
  i = matched.length() - 1
  while i >= 0 {
    let k = matched[i]
    let lidx = wasm_fn_get_or_alloc_local(fctx, fctx.phi_dst_names[k], fctx.phi_dst_tys[k])
    code.push(0x21) // local.set
    wasm_push_u32(code, lidx)
    i = i - 1
  }
  fctx.last_set_pos = -1
}

///|
fn wasm_emit_jump_to(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  cur_blk : Int,
  target_lbl : String,
  disp_depth : Int,
) -> Unit {
  fctx.last_set_pos = -1
  let tidx = match fctx.block_idx.get(target_lbl) {
    Some(k) => k
    None => 0
  }
  wasm_emit_phi_edge(ctx, fctx, code, cur_blk, tidx)
  code.push(0x41) // i32.const
  wasm_push_s32(code, tidx)
  code.push(0x21) // local.set $pc
  wasm_push_u32(code, fctx.pc_local)
  code.push(0x0C) // br $disp
  wasm_push_u32(code, disp_depth)
  fctx.last_set_pos = -1
}

///|
fn wasm_emit_epilogue(fctx : WasmFnCtx, code : Array[Int]) -> Unit {
  fctx.last_set_pos = -1
  if fctx.frame_size > 0 {
    code.push(0x20) // local.get $fp
    wasm_push_u32(code, fctx.fp_local)
    code.push(0x41) // i32.const frame_size
    wasm_push_s32(code, fctx.frame_size)
    code.push(0x6A) // i32.add
    code.push(0x24) // global.set 0 ($__sp)
    wasm_push_u32(code, 0)
  }
}

///|
fn wasm_emit_inst(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  fn_ret_ty : Int,
  code : Array[Int],
  inst : WasmInst,
  cur_blk : Int,
  disp_depth : Int,
  multi_blk : Bool,
) -> Bool {
  let op = inst.op
  if op == "phi" {
    return false
  }
  if op == "hlt" {
    fctx.last_set_pos = -1
    code.push(0x00) // unreachable
    return true
  }
  if op == "ret" {
    if fn_ret_ty != WASM_TY_VOID {
      let arg0 = if inst.args.length() > 0 { inst.args[0] } else { "0" }
      wasm_emit_operand(ctx, fctx, code, arg0, fn_ret_ty)
    }
    wasm_emit_epilogue(fctx, code)
    code.push(0x0F) // return
    fctx.last_set_pos = -1
    return true
  }
  if op == "jmp" {
    if multi_blk && inst.args.length() > 0 {
      wasm_emit_jump_to(ctx, fctx, code, cur_blk, inst.args[0], disp_depth)
    }
    fctx.last_set_pos = -1
    return true
  }
  if op == "jnz" {
    if multi_blk && inst.args.length() >= 3 {
      let cond_op = inst.args[0]
      let cond_ty = if cond_op.length() > 0 && str_code_at(cond_op, 0) == 37 {
        match fctx.local_ty.get(cond_op) {
          Some(t) => t
          None => WASM_TY_I32
        }
      } else {
        WASM_TY_I32
      }
      if cond_ty == WASM_TY_I64 {
        wasm_emit_operand(ctx, fctx, code, cond_op, WASM_TY_I64)
        code.push(0x42) // i64.const 0
        wasm_push_s64(code, 0L)
        code.push(0x52) // i64.ne
      } else {
        wasm_emit_operand(ctx, fctx, code, cond_op, WASM_TY_I32)
      }
      fctx.last_set_pos = -1
      code.push(0x04) // if
      code.push(0x40) // void
      wasm_emit_jump_to(ctx, fctx, code, cur_blk, inst.args[1], disp_depth + 1)
      code.push(0x05) // else
      wasm_emit_jump_to(ctx, fctx, code, cur_blk, inst.args[2], disp_depth + 1)
      code.push(0x0B) // end
    }
    fctx.last_set_pos = -1
    return true
  }
  if op == "jtbl" {
    // jtbl %idx, @def, @l0, @l1, ..., @l_{M-1}
    if multi_blk && inst.args.length() >= 2 {
      let idx_op = inst.args[0]
      let def_lbl = inst.args[1]
      let m = inst.args.length() - 2
      // Nested block + br_table:
      // block $j_def
      //   block $j_{m-1} ... block $j_0
      //     <idx>
      //     br_table 0 1 ... m-1 m
      //   end -> jump_to(@l0, disp_depth + m)
      //   ...
      // end -> jump_to(@def, disp_depth)
      let mut k = 0
      while k <= m {
        code.push(0x02) // block
        code.push(0x40) // void
        k = k + 1
      }
      wasm_emit_operand(ctx, fctx, code, idx_op, WASM_TY_I32)
      code.push(0x0E) // br_table
      wasm_push_u32(code, m)
      k = 0
      while k < m {
        wasm_push_u32(code, k)
        k = k + 1
      }
      wasm_push_u32(code, m) // default -> $j_def
      k = 0
      while k < m {
        code.push(0x0B) // end $j_k
        wasm_emit_jump_to(ctx, fctx, code, cur_blk, inst.args[2 + k], disp_depth + (m - k))
        k = k + 1
      }
      code.push(0x0B) // end $j_def
      wasm_emit_jump_to(ctx, fctx, code, cur_blk, def_lbl, disp_depth)
    }
    return true
  }

  // Memory stores
  if op == "storel" || op == "storew" || op == "storeh" || op == "storeb" || op == "stores" || op == "stored" {
    if inst.args.length() >= 2 {
      if op == "storel" || op == "storew" || op == "stores" || op == "stored" {
        let addr = wasm_trim(inst.args[1])
        match fctx.promoted_alloc_ty.get(addr) {
          Some(sty) => {
            if sty >= 0 {
              let val_s = wasm_trim(inst.args[0])
              let val_eff = match fctx.const_copies.get(val_s) {
                Some(imm) => imm
                None => val_s
              }
              if cur_blk == 0 && !fctx.blk0_is_target && !fctx.promoted_alloc_touched.contains(addr) &&
                (val_eff == "0" || val_eff == "d_0.0" || val_eff == "s_0.0") {
                fctx.last_set_pos = -1
                return false
              }
              fctx.promoted_alloc_touched.set(addr, true)
              let lidx = match fctx.promoted_alloc_lidx.get(addr) {
                Some(k) => k
                None => {
                  let k = wasm_fn_alloc_local(fctx, sty)
                  fctx.promoted_alloc_lidx.set(addr, k)
                  k
                }
              }
              wasm_emit_operand(ctx, fctx, code, inst.args[0], sty)
              code.push(0x21) // local.set
              wasm_push_u32(code, lidx)
            }
            fctx.last_set_pos = -1
            return false
          }
          None => ()
        }
      }
      let store_addr_key = wasm_trim(inst.args[1])
      let mut store_off = 0
      match fctx.addr_off_base.get(store_addr_key) {
        Some(base_op) => {
          wasm_emit_addr(ctx, fctx, code, base_op)
          store_off = match fctx.addr_off_const.get(store_addr_key) {
            Some(c) => c
            None => 0
          }
        }
        None => wasm_emit_addr(ctx, fctx, code, inst.args[1])
      }
      let mut align_log2 = 0
      if op == "storel" {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
        code.push(0x37) // i64.store
        align_log2 = 3
      } else if op == "storew" {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
        code.push(0x36) // i32.store
        align_log2 = 2
      } else if op == "storeh" {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
        code.push(0x3B) // i32.store16
        align_log2 = 1
      } else if op == "storeb" {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
        code.push(0x3A) // i32.store8
        align_log2 = 0
      } else if op == "stores" {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
        code.push(0x38) // f32.store
        align_log2 = 2
      } else {
        wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
        code.push(0x39) // f64.store
        align_log2 = 3
      }
      wasm_push_u32(code, align_log2) // natural alignment
      wasm_push_u32(code, store_off) // offset
    }
    return false
  }

  // blit src, dst, n -> memory.copy(dst, src, n)
  if op == "blit" {
    if inst.args.length() >= 3 {
      wasm_emit_addr(ctx, fctx, code, inst.args[1]) // dst
      wasm_emit_addr(ctx, fctx, code, inst.args[0]) // src
      wasm_emit_operand(ctx, fctx, code, inst.args[2], WASM_TY_I32) // len
      code.push(0xFC)
      wasm_push_u32(code, 10) // memory.copy
      code.push(0x00)
      code.push(0x00)
    }
    return false
  }

  // Call (direct or indirect)
  if op == "call" {
    if inst.args.length() == 0 {
      return false
    }
    let callee = inst.args[0]
    let is_hot_site = cur_blk >= 0 && cur_blk < fctx.hot_blk.length() && fctx.hot_blk[cur_blk]
    // P45-A/P53-A: Inline cls=0..3 (<= 96B) free-list/bump fast path for small-constant pion_alloc_uninit at hot sites only
    if is_hot_site && callee == "$pion_alloc_uninit" && inst.args.length() >= 4 && inst.dst.length() > 0 && inst.dst_ty == WASM_TY_I64 {
      match ctx.internal_map.get("pion_alloc_uninit") {
        Some(alloc_u_fidx) => {
          let raw_sz = wasm_trim(inst.args[1])
          let sz_str = match fctx.const_copies.get(raw_sz) { Some(c) => c; None => raw_sz }
          let raw_tag = wasm_trim(inst.args[2])
          let tag_str = match fctx.const_copies.get(raw_tag) { Some(c) => c; None => raw_tag }
          let raw_drop = wasm_trim(inst.args[3])
          let drop_str = match fctx.const_copies.get(raw_drop) { Some(c) => c; None => raw_drop }
          let sz_v = wasm_try_parse_nonneg_i32_const(sz_str)
          let tag_v = wasm_try_parse_nonneg_i32_const(tag_str)
          let drop_is_const_or_sym = drop_str.length() > 0 && str_code_at(drop_str, 0) != 37
          if sz_v >= 0L && sz_v <= 64L && tag_v >= 0L && tag_v <= 65535L && drop_is_const_or_sym {
            let need_v = ((sz_v + 31L) & -8L) + 8L
            let cls = if need_v <= 32L {
              0
            } else if need_v <= 48L {
              1
            } else if need_v <= 64L {
              2
            } else {
              3
            }
            let blk_sz = if cls == 0 {
              32
            } else if cls == 1 {
              48
            } else if cls == 2 {
              64
            } else {
              96
            }
            let slot_off = cls * 4
            let tag_flags_u32 : Int64 = (tag_v & 65535L) | 1048576L | (cls.to_int64() << 24)
            let base_lidx = if fctx.alloc_tmp_i32 >= 0 {
              fctx.alloc_tmp_i32
            } else {
              let idx = wasm_fn_alloc_local(fctx, WASM_TY_I32)
              fctx.alloc_tmp_i32 = idx
              idx
            }
            let hp_lidx = if fctx.alloc_tmp2_i32 >= 0 {
              fctx.alloc_tmp2_i32
            } else {
              let idx = wasm_fn_alloc_local(fctx, WASM_TY_I32)
              fctx.alloc_tmp2_i32 = idx
              idx
            }
            fctx.last_set_pos = -1
            // P51-A/P52-A: Compact inline Slab freelist pop OR bump-pointer alloc (hp + blk_sz <= heap_end)
            // global.get 2 is immutable slab_ctl_addr (>= WASM_DATA_BASE); linear memory is zero-init
            code.push(0x23); wasm_push_u32(code, 2)
            code.push(0x28); wasm_push_u32(code, 2); wasm_push_u32(code, slot_off)
            code.push(0x22); wasm_push_u32(code, base_lidx)
            code.push(0x04); code.push(0x40) // if (base != 0): pop freelist
            code.push(0x23); wasm_push_u32(code, 2)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x28); wasm_push_u32(code, 2); wasm_push_u32(code, 8)
            code.push(0x36); wasm_push_u32(code, 2); wasm_push_u32(code, slot_off)
            code.push(0x05) // else: try inline bump-pointer allocation
            code.push(0x23); wasm_push_u32(code, 2)
            code.push(0x28); wasm_push_u32(code, 2); wasm_push_u32(code, 36)
            code.push(0x22); wasm_push_u32(code, hp_lidx) // hp
            code.push(0x41); wasm_push_s32(code, blk_sz)
            code.push(0x6A) // new_hp = hp + blk_sz
            code.push(0x22); wasm_push_u32(code, base_lidx) // temp hold new_hp in base_lidx
            code.push(0x23); wasm_push_u32(code, 2)
            code.push(0x28); wasm_push_u32(code, 2); wasm_push_u32(code, 40) // heap_end
            code.push(0x4D) // i32.le_u(new_hp, heap_end)
            code.push(0x04); code.push(0x40)
            code.push(0x23); wasm_push_u32(code, 2)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x36); wasm_push_u32(code, 2); wasm_push_u32(code, 36) // heap_ptr = new_hp
            code.push(0x20); wasm_push_u32(code, hp_lidx)
            code.push(0x21); wasm_push_u32(code, base_lidx) // base = hp
            code.push(0x05)
            code.push(0x41); wasm_push_s32(code, 0)
            code.push(0x21); wasm_push_u32(code, base_lidx) // base = 0
            code.push(0x0B)
            code.push(0x0B) // end freelist vs bump
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x04); code.push(0x7E) // if (base != 0) -> i64
            // alloc_sz=blk_sz @ base+0, ALLOC_MAGIC @ base+4 (single i64.store)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x42); wasm_push_s64(code, (0x50494F4EL << 32) | blk_sz.to_int64())
            code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 0)
            // owner_tid=1 @ base+8, local_rc=1 @ base+12 (single i64.store)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x42); wasm_push_s64(code, (1L << 32) | 1L)
            code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 8)
            // shared_rc=0 @ base+16, type_tag|flags @ base+20 (single i64.store)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x42); wasm_push_s64(code, tag_flags_u32 << 32)
            code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 16)
            // drop_fn @ base+24
            code.push(0x20); wasm_push_u32(code, base_lidx)
            wasm_emit_operand(ctx, fctx, code, drop_str, WASM_TY_I64)
            code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 24)
            // return i64.extend_i32_u(base + 32)
            code.push(0x20); wasm_push_u32(code, base_lidx)
            code.push(0x41); wasm_push_s32(code, 32)
            code.push(0x6A) // i32.add
            code.push(0xAD) // i64.extend_i32_u
            code.push(0x05) // else: call pion_alloc_uninit internal
            code.push(0x41); wasm_push_s32(code, sz_v.to_int())
            code.push(0x41); wasm_push_s32(code, tag_v.to_int())
            wasm_emit_operand(ctx, fctx, code, drop_str, WASM_TY_I64)
            code.push(0x10); wasm_push_u32(code, alloc_u_fidx)
            code.push(0x0B) // end if
            wasm_emit_set_local(fctx, code, inst.dst, WASM_TY_I64)
            return false
          }
        }
        None => ()
      }
    }
    // P52-A/P53-A/P82-A: Inline `len < cap && stride == 0` fast path for `pion_arr_push_owned(arr, val)` at hot sites only
    if is_hot_site && callee == "$pion_arr_push_owned" && inst.args.length() >= 3 && inst.dst.length() == 0 {
      match ctx.internal_map.get("pion_arr_push_owned") {
        Some(arr_po_fidx) => {
          let p_lidx = if fctx.alloc_tmp_i32 >= 0 {
            fctx.alloc_tmp_i32
          } else {
            let idx = wasm_fn_alloc_local(fctx, WASM_TY_I32)
            fctx.alloc_tmp_i32 = idx
            idx
          }
          let len_lidx = if fctx.push_tmp_i64 >= 0 {
            fctx.push_tmp_i64
          } else {
            let idx = wasm_fn_alloc_local(fctx, WASM_TY_I64)
            fctx.push_tmp_i64 = idx
            idx
          }
          fctx.last_set_pos = -1
          wasm_emit_operand(ctx, fctx, code, inst.args[1], WASM_TY_I64)
          code.push(0xA7) // i32.wrap_i64 -> p
          code.push(0x22); wasm_push_u32(code, p_lidx)
          code.push(0x29); wasm_push_u32(code, 2); wasm_push_u32(code, 0) // len
          code.push(0x22); wasm_push_u32(code, len_lidx)
          code.push(0x20); wasm_push_u32(code, p_lidx)
          code.push(0x29); wasm_push_u32(code, 2); wasm_push_u32(code, 8) // cap
          code.push(0x53) // i64.lt_s(len, cap)
          code.push(0x20); wasm_push_u32(code, p_lidx)
          code.push(0x28); wasm_push_u32(code, 2); wasm_push_u32(code, 20) // stride
          code.push(0x45) // stride == 0 (8B standard array; 1/4/>=16 go to pion_arr_push_owned)
          code.push(0x71) // i32.and
          code.push(0x04); code.push(0x40) // if (len < cap && stride == 0)
          // dp = i32.wrap_i64(i64.load(p + 24)); i64.store(dp + (i32(len) << 3), val)
          code.push(0x20); wasm_push_u32(code, p_lidx)
          code.push(0x29); wasm_push_u32(code, 2); wasm_push_u32(code, 24); code.push(0xA7)
          code.push(0x20); wasm_push_u32(code, len_lidx); code.push(0xA7)
          code.push(0x41); wasm_push_s32(code, 3); code.push(0x74); code.push(0x6A)
          wasm_emit_operand(ctx, fctx, code, inst.args[2], WASM_TY_I64)
          code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 0)
          // i64.store(p + 0, len + 1L)
          code.push(0x20); wasm_push_u32(code, p_lidx)
          code.push(0x20); wasm_push_u32(code, len_lidx)
          code.push(0x42); wasm_push_s64(code, 1L); code.push(0x7C)
          code.push(0x37); wasm_push_u32(code, 2); wasm_push_u32(code, 0)
          code.push(0x05) // else: call pion_arr_push_owned(i64(p), val)
          code.push(0x20); wasm_push_u32(code, p_lidx); code.push(0xAD)
          wasm_emit_operand(ctx, fctx, code, inst.args[2], WASM_TY_I64)
          code.push(0x10); wasm_push_u32(code, arr_po_fidx)
          code.push(0x0B) // end if
          return false
        }
        None => ()
      }
    }
    let mut ai = 0
    while ai < inst.arg_tys.length() {
      wasm_emit_operand(ctx, fctx, code, inst.args[1 + ai], inst.arg_tys[ai])
      ai = ai + 1
    }
    let mut actual_ret = inst.dst_ty
    if str_code_at(callee, 0) == 36 {
      let sym = slice_str(callee, 1, callee.length())
      match ctx.internal_map.get(sym) {
        Some(fidx) => {
          code.push(0x10) // call
          wasm_push_u32(code, fidx)
          actual_ret = match ctx.internal_ret_tys.get(sym) {
            Some(rt) => rt
            None => WASM_TY_VOID
          }
        }
        None =>
          match ctx.import_map.get(sym) {
            Some(iidx) => {
              code.push(0x10) // call
              wasm_push_u32(code, iidx)
              actual_ret = ctx.import_ret_tys[iidx]
            }
            None => code.push(0x00) // unreachable
          }
      }
    } else {
      // Indirect call via function table (signatures pre-interned in Step 4 so ctx is read-only)
      wasm_emit_operand(ctx, fctx, code, callee, WASM_TY_I32)
      let sig_idx = wasm_lookup_sig(ctx, inst.arg_tys, inst.dst_ty)
      code.push(0x11) // call_indirect
      wasm_push_u32(code, sig_idx)
      code.push(0x00) // table 0
      actual_ret = inst.dst_ty
    }
      if inst.dst.length() > 0 {
      if actual_ret == WASM_TY_VOID && inst.dst_ty != WASM_TY_VOID {
        wasm_emit_operand(ctx, fctx, code, "0", inst.dst_ty)
      } else if actual_ret != inst.dst_ty {
        if actual_ret == WASM_TY_I64 && inst.dst_ty == WASM_TY_I32 {
          code.push(0xA7)
        } else if actual_ret == WASM_TY_I32 && inst.dst_ty == WASM_TY_I64 {
          code.push(0xAD)
        }
      }
      if inst.dst_ty != WASM_TY_VOID {
        wasm_emit_set_local(fctx, code, inst.dst, inst.dst_ty)
      } else {
        fctx.last_set_pos = -1
        code.push(0x1A)
      }
    } else if actual_ret != WASM_TY_VOID {
      fctx.last_set_pos = -1
      code.push(0x1A) // drop unused return value
    } else {
      fctx.last_set_pos = -1
    }
    return false
  }

  // Value-producing instructions
  let dty = inst.dst_ty
  if inst.dst.length() == 0 || dty == WASM_TY_VOID {
    fctx.last_set_pos = -1
    return false
  }

  // Stack allocation: alloc4 / alloc8 / alloc16
  if op == "alloc4" || op == "alloc8" || op == "alloc16" {
    fctx.last_set_pos = -1
    if fctx.promoted_alloc_ty.contains(inst.dst) {
      return false
    }
    let off = match fctx.alloc_offsets.get(inst.dst) {
      Some(o) => o
      None => 0
    }
    code.push(0x20) // local.get $fp
    wasm_push_u32(code, fctx.fp_local)
    if off != 0 {
      code.push(0x41)
      wasm_push_s32(code, off)
      code.push(0x6A) // i32.add
    }
    if dty == WASM_TY_I64 {
      code.push(0xAD) // i64.extend_i32_u
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  // copy
  if op == "copy" {
    if fctx.const_copies.contains(inst.dst) {
      return false
    }
    wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  // Loads
  if op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" ||
    op == "loadsh" || op == "loaduh" || op == "loadsb" || op == "loadub" ||
    op == "loads" || op == "loadd" {
    if op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" || op == "loads" || op == "loadd" {
      let addr = wasm_trim(inst.args[0])
      match fctx.promoted_alloc_ty.get(addr) {
        Some(sty) => {
          if sty >= 0 {
            fctx.promoted_alloc_touched.set(addr, true)
            let lidx = match fctx.promoted_alloc_lidx.get(addr) {
              Some(k) => k
              None => {
                let k = wasm_fn_alloc_local(fctx, sty)
                fctx.promoted_alloc_lidx.set(addr, k)
                k
              }
            }
            fctx.last_set_pos = -1
            code.push(0x20) // local.get
            wasm_push_u32(code, lidx)
            if op == "loadsw" && dty == WASM_TY_I64 {
              code.push(0xAC) // i64.extend_i32_s
            } else if (op == "loadw" || op == "loaduw") && dty == WASM_TY_I64 {
              code.push(0xAD) // i64.extend_i32_u
            } else if op == "loadl" && dty == WASM_TY_I32 {
              code.push(0xA7) // i32.wrap_i64
            }
            wasm_emit_set_local(fctx, code, inst.dst, dty)
          } else {
            fctx.last_set_pos = -1
          }
          return false
        }
        None => ()
      }
    }
    let load_addr_key = wasm_trim(inst.args[0])
    let mut load_off = 0
    match fctx.addr_off_base.get(load_addr_key) {
      Some(base_op) => {
        wasm_emit_addr(ctx, fctx, code, base_op)
        load_off = match fctx.addr_off_const.get(load_addr_key) {
          Some(c) => c
          None => 0
        }
      }
      None => wasm_emit_addr(ctx, fctx, code, inst.args[0])
    }
    let mut align_log2 = 0
    if op == "loadl" {
      if dty == WASM_TY_I32 {
        code.push(0x28)
        align_log2 = 2
      } else {
        code.push(0x29)
        align_log2 = 3
      }
    } else if op == "loadw" || op == "loaduw" {
      code.push(if dty == WASM_TY_I64 { 0x35 } else { 0x28 })
      align_log2 = 2
    } else if op == "loadsw" {
      code.push(if dty == WASM_TY_I64 { 0x34 } else { 0x28 })
      align_log2 = 2
    } else if op == "loadsh" {
      code.push(if dty == WASM_TY_I64 { 0x32 } else { 0x2E })
      align_log2 = 1
    } else if op == "loaduh" {
      code.push(if dty == WASM_TY_I64 { 0x33 } else { 0x2F })
      align_log2 = 1
    } else if op == "loadsb" {
      code.push(if dty == WASM_TY_I64 { 0x30 } else { 0x2C })
      align_log2 = 0
    } else if op == "loadub" {
      code.push(if dty == WASM_TY_I64 { 0x31 } else { 0x2D })
      align_log2 = 0
    } else if op == "loads" {
      code.push(0x2A)
      align_log2 = 2
    } else {
      code.push(0x2B)
      align_log2 = 3
    }
    wasm_push_u32(code, align_log2) // natural alignment
    wasm_push_u32(code, load_off) // offset
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  // Unary ops: neg, sqrt, extsw, extuw, extsh, extuh, extsb, extub, exts, truncd, stosi, stoui, dtosi, dtoui, swtof, uwtof, sltof, ultof, cast
  if op == "neg" {
    if dty == WASM_TY_I32 {
      fctx.last_set_pos = -1
      code.push(0x41)
      wasm_push_s32(code, 0)
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
      code.push(0x6B) // i32.sub
    } else if dty == WASM_TY_I64 {
      fctx.last_set_pos = -1
      code.push(0x42)
      wasm_push_s64(code, 0L)
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
      code.push(0x7D) // i64.sub
    } else if dty == WASM_TY_F32 {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
      code.push(0x8C) // f32.neg
    } else {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
      code.push(0x9A) // f64.neg
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  if op == "sqrt" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
    code.push(if dty == WASM_TY_F32 { 0x91 } else { 0x9F })
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  if op == "clz" || op == "ctz" || op == "popcnt" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
    if dty == WASM_TY_I32 {
      if op == "clz" {
        code.push(0x67) // i32.clz
      } else if op == "ctz" {
        code.push(0x68) // i32.ctz
      } else {
        code.push(0x69) // i32.popcnt
      }
    } else {
      if op == "clz" {
        code.push(0x79) // i64.clz
      } else if op == "ctz" {
        code.push(0x7A) // i64.ctz
      } else {
        code.push(0x7B) // i64.popcnt
      }
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  if op == "extsw" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    if dty == WASM_TY_I64 {
      code.push(0xAC) // i64.extend_i32_s
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "extuw" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    if dty == WASM_TY_I64 {
      code.push(0xAD) // i64.extend_i32_u
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "extsh" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(0xC1) // i32.extend16_s
    if dty == WASM_TY_I64 {
      code.push(0xAC)
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "extuh" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(0x41)
    wasm_push_s32(code, 65535)
    code.push(0x71) // i32.and
    if dty == WASM_TY_I64 {
      code.push(0xAD)
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "extsb" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(0xC0) // i32.extend8_s
    if dty == WASM_TY_I64 {
      code.push(0xAC)
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "extub" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(0x41)
    wasm_push_s32(code, 255)
    code.push(0x71) // i32.and
    if dty == WASM_TY_I64 {
      code.push(0xAD)
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "exts" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
    code.push(0xBB) // f64.promote_f32
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "truncd" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
    code.push(0xB6) // f32.demote_f64
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "stosi" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
    code.push(0xFC)
    wasm_push_u32(code, if dty == WASM_TY_I64 { 0x04 } else { 0x00 }) // trunc_sat_f32_s
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "stoui" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
    code.push(0xFC)
    wasm_push_u32(code, if dty == WASM_TY_I64 { 0x05 } else { 0x01 }) // trunc_sat_f32_u
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "dtosi" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
    code.push(0xFC)
    wasm_push_u32(code, if dty == WASM_TY_I64 { 0x06 } else { 0x02 }) // trunc_sat_f64_s
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "dtoui" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
    code.push(0xFC)
    wasm_push_u32(code, if dty == WASM_TY_I64 { 0x07 } else { 0x03 }) // trunc_sat_f64_u
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "swtof" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(if dty == WASM_TY_F32 { 0xB2 } else { 0xB7 })
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "uwtof" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
    code.push(if dty == WASM_TY_F32 { 0xB3 } else { 0xB8 })
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "sltof" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
    code.push(if dty == WASM_TY_F32 { 0xB4 } else { 0xB9 })
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "ultof" {
    wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
    code.push(if dty == WASM_TY_F32 { 0xB5 } else { 0xBA })
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }
  if op == "cast" {
    if dty == WASM_TY_I32 {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F32)
      code.push(0xBC) // i32.reinterpret_f32
    } else if dty == WASM_TY_I64 {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_F64)
      code.push(0xBD) // i64.reinterpret_f64
    } else if dty == WASM_TY_F32 {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
      code.push(0xBE) // f32.reinterpret_i32
    } else {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
      code.push(0xBF) // f64.reinterpret_i64
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  // Binary arithmetic / bitwise / shifts
  if op == "add" || op == "sub" || op == "mul" || op == "div" || op == "udiv" ||
    op == "rem" || op == "urem" || op == "and" || op == "or" || op == "xor" ||
    op == "shl" || op == "shr" || op == "sar" || op == "ror" {
    if op == "add" && inst.dst.length() > 0 && fctx.addr_off_base.contains(inst.dst) {
      return false
    }
    // P42-C: Constant div/rem strength reduction (i32 & i64)
    if (dty == WASM_TY_I32 || dty == WASM_TY_I64) &&
      (op == "udiv" || op == "urem" || op == "div" || op == "rem") {
      let d = wasm_try_parse_pos_i64_const(fctx, inst.args[1])
      if d >= 2L {
        let k = wasm_pow2_shift(d)
        if op == "udiv" && k > 0 && ((dty == WASM_TY_I32 && k <= 31) || (dty == WASM_TY_I64 && k <= 63)) {
          wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
          if dty == WASM_TY_I32 {
            code.push(0x41)
            wasm_push_s32(code, k)
            code.push(0x76) // i32.shr_u
          } else {
            code.push(0x42)
            wasm_push_s64(code, k.to_int64())
            code.push(0x88) // i64.shr_u
          }
          wasm_emit_set_local(fctx, code, inst.dst, dty)
          return false
        }
        if op == "urem" && k > 0 && ((dty == WASM_TY_I32 && k <= 31) || (dty == WASM_TY_I64 && k <= 63)) {
          wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
          if dty == WASM_TY_I32 {
            code.push(0x41)
            wasm_push_s32(code, (d - 1L).to_int())
            code.push(0x71) // i32.and
          } else {
            code.push(0x42)
            wasm_push_s64(code, d - 1L)
            code.push(0x83) // i64.and
          }
          wasm_emit_set_local(fctx, code, inst.dst, dty)
          return false
        }
        if (op == "div" || op == "rem") && k > 0 &&
          ((dty == WASM_TY_I32 && k <= 30) || (dty == WASM_TY_I64 && k <= 62)) {
          if dty == WASM_TY_I32 {
            let xloc = wasm_get_div_tmp_i32(fctx)
            wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
            code.push(0x22) // local.tee $x
            wasm_push_u32(code, xloc)
            if op == "rem" {
              code.push(0x20) // local.get $x (left operand of sub)
              wasm_push_u32(code, xloc)
            }
            code.push(0x20) // local.get $x
            wasm_push_u32(code, xloc)
            if k == 1 {
              code.push(0x41)
              wasm_push_s32(code, 31)
              code.push(0x76) // i32.shr_u
            } else {
              code.push(0x41)
              wasm_push_s32(code, 31)
              code.push(0x75) // i32.shr_s
              code.push(0x41)
              wasm_push_s32(code, 32 - k)
              code.push(0x76) // i32.shr_u
            }
            code.push(0x6A) // i32.add
            if op == "div" {
              code.push(0x41)
              wasm_push_s32(code, k)
              code.push(0x75) // i32.shr_s
            } else {
              code.push(0x41)
              wasm_push_s32(code, (0L - d).to_int())
              code.push(0x71) // i32.and
              code.push(0x6B) // i32.sub
            }
          } else {
            let xloc = wasm_get_div_tmp_i64(fctx)
            wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I64)
            code.push(0x22) // local.tee $x
            wasm_push_u32(code, xloc)
            if op == "rem" {
              code.push(0x20) // local.get $x (left operand of sub)
              wasm_push_u32(code, xloc)
            }
            code.push(0x20) // local.get $x
            wasm_push_u32(code, xloc)
            if k == 1 {
              code.push(0x42)
              wasm_push_s64(code, 63L)
              code.push(0x88) // i64.shr_u
            } else {
              code.push(0x42)
              wasm_push_s64(code, 63L)
              code.push(0x87) // i64.shr_s
              code.push(0x42)
              wasm_push_s64(code, (64 - k).to_int64())
              code.push(0x88) // i64.shr_u
            }
            code.push(0x7C) // i64.add
            if op == "div" {
              code.push(0x42)
              wasm_push_s64(code, k.to_int64())
              code.push(0x87) // i64.shr_s
            } else {
              code.push(0x42)
              wasm_push_s64(code, 0L - d)
              code.push(0x83) // i64.and
              code.push(0x7D) // i64.sub
            }
          }
          wasm_emit_set_local(fctx, code, inst.dst, dty)
          return false
        }
        // Signed i32 non-power-of-2 constant div/rem via 64-bit magic multiplier
        if dty == WASM_TY_I32 && (op == "div" || op == "rem") && k == 0 && d >= 3L && d <= 1073741823L {
          let p = wasm_sdiv32_magic_p(d)
          if p >= 32 {
            let m : Int64 = (1L << p) / d + 1L
            if m < (1L << 32) {
              let xloc = wasm_get_div_tmp_i32(fctx)
              wasm_emit_operand(ctx, fctx, code, inst.args[0], WASM_TY_I32)
              code.push(0x22) // local.tee $x
              wasm_push_u32(code, xloc)
              if op == "rem" {
                code.push(0x20) // local.get $x
                wasm_push_u32(code, xloc)
              }
              code.push(0xAC) // i64.extend_i32_s
              code.push(0x42) // i64.const m
              wasm_push_s64(code, m)
              code.push(0x7E) // i64.mul
              code.push(0x42) // i64.const p
              wasm_push_s64(code, p.to_int64())
              code.push(0x87) // i64.shr_s
              code.push(0xA7) // i32.wrap_i64
              code.push(0x20) // local.get $x
              wasm_push_u32(code, xloc)
              code.push(0x41) // i32.const 31
              wasm_push_s32(code, 31)
              code.push(0x76) // i32.shr_u
              code.push(0x6A) // i32.add -> q
              if op == "rem" {
                code.push(0x41) // i32.const d
                wasm_push_s32(code, d.to_int())
                code.push(0x6C) // i32.mul
                code.push(0x6B) // i32.sub -> x - q * d
              }
              wasm_emit_set_local(fctx, code, inst.dst, WASM_TY_I32)
              return false
            }
          }
        }
      }
    }
    wasm_emit_operand(ctx, fctx, code, inst.args[0], dty)
    wasm_emit_operand(ctx, fctx, code, inst.args[1], dty)
    if dty == WASM_TY_I32 {
      if op == "add" {
        code.push(0x6A)
      } else if op == "sub" {
        code.push(0x6B)
      } else if op == "mul" {
        code.push(0x6C)
      } else if op == "div" {
        code.push(0x6D)
      } else if op == "udiv" {
        code.push(0x6E)
      } else if op == "rem" {
        code.push(0x6F)
      } else if op == "urem" {
        code.push(0x70)
      } else if op == "and" {
        code.push(0x71)
      } else if op == "or" {
        code.push(0x72)
      } else if op == "xor" {
        code.push(0x73)
      } else if op == "shl" {
        code.push(0x74)
      } else if op == "sar" {
        code.push(0x75)
      } else if op == "ror" {
        code.push(0x78) // i32.rotr
      } else {
        code.push(0x76)
      }
    } else if dty == WASM_TY_I64 {
      if op == "add" {
        code.push(0x7C)
      } else if op == "sub" {
        code.push(0x7D)
      } else if op == "mul" {
        code.push(0x7E)
      } else if op == "div" {
        code.push(0x7F)
      } else if op == "udiv" {
        code.push(0x80)
      } else if op == "rem" {
        code.push(0x81)
      } else if op == "urem" {
        code.push(0x82)
      } else if op == "and" {
        code.push(0x83)
      } else if op == "or" {
        code.push(0x84)
      } else if op == "xor" {
        code.push(0x85)
      } else if op == "shl" {
        code.push(0x86)
      } else if op == "sar" {
        code.push(0x87)
      } else if op == "ror" {
        code.push(0x8A) // i64.rotr
      } else {
        code.push(0x88)
      }
    } else if dty == WASM_TY_F32 {
      if op == "add" {
        code.push(0x92)
      } else if op == "sub" {
        code.push(0x93)
      } else if op == "mul" {
        code.push(0x94)
      } else {
        code.push(0x95)
      }
    } else {
      if op == "add" {
        code.push(0xA0)
      } else if op == "sub" {
        code.push(0xA1)
      } else if op == "mul" {
        code.push(0xA2)
      } else {
        code.push(0xA3)
      }
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  // Comparisons: c<pred><ty>
  if op.length() >= 3 && str_code_at(op, 0) == 99 {
    let last_c = str_code_at(op, op.length() - 1)
    let cmp_ty = if last_c == 119 {
      WASM_TY_I32
    } else if last_c == 108 {
      WASM_TY_I64
    } else if last_c == 115 {
      WASM_TY_F32
    } else {
      WASM_TY_F64
    }
    let pred = slice_str(op, 1, op.length() - 1)
    if (cmp_ty == WASM_TY_F32 || cmp_ty == WASM_TY_F64) && (pred == "o" || pred == "uo") {
      let eq_op = if cmp_ty == WASM_TY_F32 { 0x5B } else { 0x61 }
      // a == a
      wasm_emit_operand(ctx, fctx, code, inst.args[0], cmp_ty)
      wasm_emit_operand(ctx, fctx, code, inst.args[0], cmp_ty)
      code.push(eq_op)
      // b == b
      wasm_emit_operand(ctx, fctx, code, inst.args[1], cmp_ty)
      wasm_emit_operand(ctx, fctx, code, inst.args[1], cmp_ty)
      code.push(eq_op)
      code.push(0x71) // i32.and (both ordered)
      if pred == "uo" {
        code.push(0x45) // i32.eqz
      }
    } else {
      wasm_emit_operand(ctx, fctx, code, inst.args[0], cmp_ty)
      wasm_emit_operand(ctx, fctx, code, inst.args[1], cmp_ty)
      if cmp_ty == WASM_TY_I32 {
        if pred == "eq" {
          code.push(0x46)
        } else if pred == "ne" {
          code.push(0x47)
        } else if pred == "slt" {
          code.push(0x48)
        } else if pred == "ult" {
          code.push(0x49)
        } else if pred == "sgt" {
          code.push(0x4A)
        } else if pred == "ugt" {
          code.push(0x4B)
        } else if pred == "sle" {
          code.push(0x4C)
        } else if pred == "ule" {
          code.push(0x4D)
        } else if pred == "sge" {
          code.push(0x4E)
        } else {
          code.push(0x4F)
        }
      } else if cmp_ty == WASM_TY_I64 {
        if pred == "eq" {
          code.push(0x51)
        } else if pred == "ne" {
          code.push(0x52)
        } else if pred == "slt" {
          code.push(0x53)
        } else if pred == "ult" {
          code.push(0x54)
        } else if pred == "sgt" {
          code.push(0x55)
        } else if pred == "ugt" {
          code.push(0x56)
        } else if pred == "sle" {
          code.push(0x57)
        } else if pred == "ule" {
          code.push(0x58)
        } else if pred == "sge" {
          code.push(0x59)
        } else {
          code.push(0x5A)
        }
      } else if cmp_ty == WASM_TY_F32 {
        if pred == "eq" {
          code.push(0x5B)
        } else if pred == "ne" {
          code.push(0x5C)
        } else if pred == "lt" {
          code.push(0x5D)
        } else if pred == "gt" {
          code.push(0x5E)
        } else if pred == "le" {
          code.push(0x5F)
        } else {
          code.push(0x60)
        }
      } else {
        if pred == "eq" {
          code.push(0x61)
        } else if pred == "ne" {
          code.push(0x62)
        } else if pred == "lt" {
          code.push(0x63)
        } else if pred == "gt" {
          code.push(0x64)
        } else if pred == "le" {
          code.push(0x65)
        } else {
          code.push(0x66)
        }
      }
    }
    if dty == WASM_TY_I64 {
      code.push(0xAD) // i64.extend_i32_u
    }
    wasm_emit_set_local(fctx, code, inst.dst, dty)
    return false
  }

  false
}

///|
/// Opt 2: Structured CFG analysis & lowering (DAG + properly-nested natural loops).
/// Returns loop_end[bi] >= 0 for reachable loop headers, -1 for reachable non-headers,
/// -2 for unreachable dead blocks, or empty array if reachable CFG is irreducible.
fn wasm_analyze_structured_cfg(f : WasmFunc, block_idx : Map[String, Int]) -> Array[Int] {
  let nb = f.blocks.length()
  let loop_end : Array[Int] = []
  let blk_e0 : Array[Int] = []
  let blk_e1 : Array[Int] = []
  let all_v : Array[Int] = []
  let reach : Array[Bool] = []
  let mut bi = 0
  while bi < nb {
    loop_end.push(-1)
    reach.push(false)
    blk_e0.push(all_v.length())
    let insts = f.blocks[bi].insts
    let mut terminated = false
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      let op = inst.op
      if op == "jmp" && inst.args.length() > 0 {
        terminated = true
        match block_idx.get(inst.args[0]) {
          Some(tidx) => all_v.push(tidx)
          None => ()
        }
      } else if op == "jnz" && inst.args.length() >= 3 {
        terminated = true
        match block_idx.get(inst.args[1]) {
          Some(t1) => all_v.push(t1)
          None => ()
        }
        match block_idx.get(inst.args[2]) {
          Some(t2) => all_v.push(t2)
          None => ()
        }
      } else if op == "jtbl" && inst.args.length() >= 2 {
        terminated = true
        let mut ai = 1
        while ai < inst.args.length() {
          match block_idx.get(inst.args[ai]) {
            Some(ti) => all_v.push(ti)
            None => ()
          }
          ai = ai + 1
        }
      } else if op == "ret" || op == "hlt" {
        terminated = true
      }
      ii = ii + 1
    }
    if !terminated && bi + 1 < nb {
      all_v.push(bi + 1)
    }
    blk_e1.push(all_v.length())
    bi = bi + 1
  }

  // BFS reachability from entry block 0 so unreachable dead blocks cannot pollute CFG edges
  if nb > 0 {
    let queue : Array[Int] = [0]
    reach[0] = true
    let mut qi = 0
    while qi < queue.length() {
      let u = queue[qi]
      qi = qi + 1
      let mut ei = blk_e0[u]
      let e1 = blk_e1[u]
      while ei < e1 {
        let v = all_v[ei]
        if !reach[v] {
          reach[v] = true
          queue.push(v)
        }
        ei = ei + 1
      }
    }
  }

  // Pass 1: collect reachable CFG edges and find loop_end[hdr] for back-edges (dst <= src)
  let edge_u : Array[Int] = []
  let edge_v : Array[Int] = []
  bi = 0
  while bi < nb {
    if !reach[bi] {
      loop_end[bi] = -2
    } else {
      let mut ei = blk_e0[bi]
      let e1 = blk_e1[bi]
      while ei < e1 {
        let v = all_v[ei]
        edge_u.push(bi)
        edge_v.push(v)
        if v <= bi && bi > loop_end[v] {
          loop_end[v] = bi
        }
        ei = ei + 1
      }
    }
    bi = bi + 1
  }

  // Collect list of loop headers
  let hdrs : Array[Int] = []
  bi = 0
  while bi < nb {
    if loop_end[bi] >= 0 {
      hdrs.push(bi)
    }
    bi = bi + 1
  }

  // Condition 2: loop intervals must be properly nested or disjoint
  let nh = hdrs.length()
  let mut a = 0
  while a < nh {
    let h1 = hdrs[a]
    let e1 = loop_end[h1]
    let mut b = a + 1
    while b < nh {
      let h2 = hdrs[b]
      let e2 = loop_end[h2]
      // h1 < h2 always. Valid iff e1 < h2 (disjoint) or e2 <= e1 (nested).
      if e1 >= h2 && e2 > e1 {
        return []
      }
      b = b + 1
    }
    a = a + 1
  }

  // Condition 1: no edge from outside a loop [h, e] into its interior (h, e]
  let ne = edge_u.length()
  let mut ei = 0
  while ei < ne {
    let u = edge_u[ei]
    let v = edge_v[ei]
    let mut hi = 0
    while hi < nh {
      let h = hdrs[hi]
      let e = loop_end[h]
      if (u < h || u > e) && v > h && v <= e {
        return []
      }
      hi = hi + 1
    }
    ei = ei + 1
  }

  loop_end
}

///|
fn wasm_scope_depth(
  scope_is_loop : Array[Bool],
  scope_target : Array[Int],
  cur_blk : Int,
  target_blk : Int,
  extra_depth : Int,
) -> Int {
  let want_loop = target_blk <= cur_blk
  let n = scope_target.length()
  let mut i = n - 1
  while i >= 0 {
    if scope_is_loop[i] == want_loop && scope_target[i] == target_blk {
      return (n - 1 - i) + extra_depth
    }
    i = i - 1
  }
  extra_depth
}

///|
fn wasm_emit_structured_jump(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  cur_blk : Int,
  target_lbl : String,
  scope_is_loop : Array[Bool],
  scope_target : Array[Int],
  extra_depth : Int,
  allow_fallthrough : Bool,
) -> Unit {
  fctx.last_set_pos = -1
  let tidx = match fctx.block_idx.get(target_lbl) {
    Some(k) => k
    None => 0
  }
  wasm_emit_phi_edge(ctx, fctx, code, cur_blk, tidx)
  if allow_fallthrough && tidx == cur_blk + 1 {
    return
  }
  let depth = wasm_scope_depth(scope_is_loop, scope_target, cur_blk, tidx, extra_depth)
  code.push(0x0C) // br
  wasm_push_u32(code, depth)
  fctx.last_set_pos = -1
}

///|
fn wasm_emit_cond_i32(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  code : Array[Int],
  cond_op : String,
) -> Unit {
  let cond_ty = if cond_op.length() > 0 && str_code_at(cond_op, 0) == 37 {
    match fctx.local_ty.get(cond_op) {
      Some(t) => t
      None => WASM_TY_I32
    }
  } else {
    WASM_TY_I32
  }
  if cond_ty == WASM_TY_I64 {
    wasm_emit_operand(ctx, fctx, code, cond_op, WASM_TY_I64)
    code.push(0x42) // i64.const 0
    wasm_push_s64(code, 0L)
    code.push(0x52) // i64.ne
  } else {
    wasm_emit_operand(ctx, fctx, code, cond_op, WASM_TY_I32)
  }
}

///|
fn wasm_emit_structured_block(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  f : WasmFunc,
  code : Array[Int],
  bi : Int,
  scope_is_loop : Array[Bool],
  scope_target : Array[Int],
) -> Unit {
  fctx.last_set_pos = -1
  let nb = f.blocks.length()
  let insts = f.blocks[bi].insts
  let mut terminated = false
  let mut ii = 0
  while ii < insts.length() {
    let inst = insts[ii]
    let op = inst.op
    // P42-C: Fuse single-use integer comparison + inverted jnz fallthrough (zero i32.eqz!)
    if ii + 1 < insts.length() && insts[ii + 1].op == "jnz" && insts[ii + 1].args.length() >= 3 {
      let inv_op = wasm_invert_int_cmp_op(op)
      if inv_op.length() > 0 && inst.dst.length() > 0 && inst.args.length() >= 2 {
        let jnz = insts[ii + 1]
        if wasm_trim(jnz.args[0]) == inst.dst {
          let ucnt = match fctx.use_counts.get(inst.dst) { Some(c) => c; None => 0 }
          let dcnt = match fctx.def_counts.get(inst.dst) { Some(c) => c; None => 0 }
          if ucnt == 1 && dcnt == 1 {
            let t_lbl = jnz.args[1]
            let f_lbl = jnz.args[2]
            let t_idx = match fctx.block_idx.get(t_lbl) { Some(k) => k; None => 0 }
            let f_idx = match fctx.block_idx.get(f_lbl) { Some(k) => k; None => 0 }
            let t_has_phi = wasm_has_phi_edge(fctx, bi, t_idx)
            let f_has_phi = wasm_has_phi_edge(fctx, bi, f_idx)
            if !f_has_phi && (t_has_phi || (t_idx == bi + 1 && f_idx != bi + 1)) {
              wasm_emit_int_cmp_stack(ctx, fctx, code, inv_op, inst.args[0], inst.args[1])
              let f_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, f_idx, 0)
              code.push(0x0D) // br_if
              wasm_push_u32(code, f_depth)
              wasm_emit_phi_edge(ctx, fctx, code, bi, t_idx)
              if t_idx != bi + 1 {
                let t_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, t_idx, 0)
                code.push(0x0C) // br
                wasm_push_u32(code, t_depth)
              }
              terminated = true
              ii = ii + 2
              continue
            }
          }
        }
      }
    }
    if op == "jmp" {
      if inst.args.length() > 0 {
        wasm_emit_structured_jump(ctx, fctx, code, bi, inst.args[0], scope_is_loop, scope_target, 0, true)
      }
      terminated = true
    } else if op == "jnz" {
      if inst.args.length() >= 3 {
        let t_lbl = inst.args[1]
        let f_lbl = inst.args[2]
        let t_idx = match fctx.block_idx.get(t_lbl) { Some(k) => k; None => 0 }
        let f_idx = match fctx.block_idx.get(f_lbl) { Some(k) => k; None => 0 }
        let t_has_phi = wasm_has_phi_edge(fctx, bi, t_idx)
        let f_has_phi = wasm_has_phi_edge(fctx, bi, f_idx)
        wasm_emit_cond_i32(ctx, fctx, code, inst.args[0])
        if !f_has_phi && (t_has_phi || (t_idx == bi + 1 && f_idx != bi + 1)) {
          // Invert condition: br_if directly to false target, then fallthrough/jump to true target
          code.push(0x45) // i32.eqz
          let f_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, f_idx, 0)
          code.push(0x0D) // br_if
          wasm_push_u32(code, f_depth)
          wasm_emit_phi_edge(ctx, fctx, code, bi, t_idx)
          if t_idx != bi + 1 {
            let t_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, t_idx, 0)
            code.push(0x0C) // br
            wasm_push_u32(code, t_depth)
          }
        } else if !t_has_phi {
          // Fast path: br_if directly to true target, then handle false target (with fallthrough!)
          let t_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, t_idx, 0)
          code.push(0x0D) // br_if
          wasm_push_u32(code, t_depth)
          wasm_emit_phi_edge(ctx, fctx, code, bi, f_idx)
          if f_idx != bi + 1 {
            let f_depth = wasm_scope_depth(scope_is_loop, scope_target, bi, f_idx, 0)
            code.push(0x0C) // br
            wasm_push_u32(code, f_depth)
          }
        } else {
          code.push(0x04) // if
          code.push(0x40) // void
          wasm_emit_structured_jump(ctx, fctx, code, bi, t_lbl, scope_is_loop, scope_target, 1, false)
          code.push(0x05) // else
          wasm_emit_structured_jump(ctx, fctx, code, bi, f_lbl, scope_is_loop, scope_target, 1, false)
          code.push(0x0B) // end
        }
      }
      terminated = true
    } else if op == "jtbl" {
      if inst.args.length() >= 2 {
        let idx_op = inst.args[0]
        let def_lbl = inst.args[1]
        let m = inst.args.length() - 2
        let mut k = 0
        while k <= m {
          code.push(0x02) // block
          code.push(0x40) // void
          k = k + 1
        }
        wasm_emit_operand(ctx, fctx, code, idx_op, WASM_TY_I32)
        code.push(0x0E) // br_table
        wasm_push_u32(code, m)
        k = 0
        while k < m {
          wasm_push_u32(code, k)
          k = k + 1
        }
        wasm_push_u32(code, m)
        k = 0
        while k < m {
          code.push(0x0B) // end $j_k
          wasm_emit_structured_jump(ctx, fctx, code, bi, inst.args[2 + k], scope_is_loop, scope_target, m - k, false)
          k = k + 1
        }
        code.push(0x0B) // end $j_def
        wasm_emit_structured_jump(ctx, fctx, code, bi, def_lbl, scope_is_loop, scope_target, 0, true)
      }
      terminated = true
    } else {
      terminated = wasm_emit_inst(ctx, fctx, f.ret_ty, code, inst, bi, 0, false)
    }
    ii = ii + 1
  }
  if !terminated {
    if bi + 1 < nb {
      wasm_emit_phi_edge(ctx, fctx, code, bi, bi + 1)
    } else {
      if f.ret_ty != WASM_TY_VOID {
        wasm_emit_operand(ctx, fctx, code, "0", f.ret_ty)
      }
      wasm_emit_epilogue(fctx, code)
      code.push(0x0F) // return
    }
  }
}

///|
fn wasm_emit_structured_region(
  ctx : WasmModCtx,
  fctx : WasmFnCtx,
  f : WasmFunc,
  code : Array[Int],
  lo : Int,
  hi : Int,
  in_loop_hdr : Int,
  loop_end : Array[Int],
  scope_is_loop : Array[Bool],
  scope_target : Array[Int],
) -> Unit {
  // Partition [lo, hi] into sequential top-level items: Block(p) or Loop(p..loop_end[p])
  let item_start : Array[Int] = []
  let item_end : Array[Int] = []
  let item_is_loop : Array[Bool] = []
  let mut pos = lo
  while pos <= hi {
    if loop_end[pos] >= 0 && pos != in_loop_hdr {
      let le = loop_end[pos]
      item_start.push(pos)
      item_end.push(le)
      item_is_loop.push(true)
      pos = le + 1
    } else {
      item_start.push(pos)
      item_end.push(pos)
      item_is_loop.push(false)
      pos = pos + 1
    }
  }

  let k = item_start.length()
  // Open (k - 1) forward-target blocks in reverse order: outermost = item[k-1], innermost = item[1]
  let mut idx = k - 1
  while idx >= 1 {
    code.push(0x02) // block
    code.push(0x40) // void
    scope_is_loop.push(false)
    scope_target.push(item_start[idx])
    idx = idx - 1
  }

  // Emit each item; before item[idx] (for idx >= 1), close its block wrapper
  idx = 0
  while idx < k {
    if idx >= 1 {
      code.push(0x0B) // end block for item_start[idx]
      let _ = scope_is_loop.pop()
      let _ = scope_target.pop()
    }
    if item_is_loop[idx] {
      let hdr = item_start[idx]
      let le = item_end[idx]
      code.push(0x03) // loop $L_hdr
      code.push(0x40) // void
      scope_is_loop.push(true)
      scope_target.push(hdr)
      wasm_emit_structured_region(ctx, fctx, f, code, hdr, le, hdr, loop_end, scope_is_loop, scope_target)
      code.push(0x0B) // end loop $L_hdr
      let _ = scope_is_loop.pop()
      let _ = scope_target.pop()
    } else if loop_end[item_start[idx]] == -2 {
      code.push(0x00) // unreachable dead block
    } else {
      wasm_emit_structured_block(ctx, fctx, f, code, item_start[idx], scope_is_loop, scope_target)
    }
    idx = idx + 1
  }
}

///|
fn wasm_mark_slot_type(
  slot_ok : Map[String, Bool],
  slot_ty : Map[String, Int],
  name : String,
  req_ty : Int,
) -> Unit {
  match slot_ok.get(name) {
    Some(true) =>
      match slot_ty.get(name) {
        Some(cur) =>
          if cur == -1 {
            slot_ty.set(name, req_ty)
          } else if cur != req_ty {
            slot_ok.set(name, false)
          }
        None => ()
      }
    _ => ()
  }
}

///|
fn wasm_escape_slot(slot_ok : Map[String, Bool], raw : String) -> Unit {
  let s = wasm_trim(raw)
  if slot_ok.contains(s) {
    slot_ok.set(s, false)
  }
}

///|
///|
/// P45-A: Linear-scan live-range coloring for SSA locals in structured CFG functions.
/// Pre-assigns reused typed local slots in `local_idx` / `extra_local_tys` so V8 Liftoff
/// sees a compact stack frame instead of 45..173 permanent slots.
fn wasm_assign_colored_locals(
  f : WasmFunc,
  block_idx : Map[String, Int],
  loop_end : Array[Int],
  n_params : Int,
  param_set : Map[String, Bool],
  local_ty : Map[String, Int],
  use_counts : Map[String, Int],
  const_copies : Map[String, String],
  addr_off_base : Map[String, String],
  promoted_alloc_ty : Map[String, Int],
  alloc_offsets : Map[String, Int],
  local_idx : Map[String, Int],
  extra_local_tys : Array[Int],
) -> Unit {
  let nb = f.blocks.length()
  // Exclude phi destinations from sharing slots to avoid parallel-copy interference
  let phi_dst_set : Map[String, Bool] = Map([])
  let blk_start : Array[Int] = []
  let blk_end : Array[Int] = []
  let mut pos = 0
  let mut bi = 0
  while bi < nb {
    blk_start.push(pos)
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      if insts[ii].op == "phi" && insts[ii].dst.length() > 0 {
        phi_dst_set.set(insts[ii].dst, true)
      }
      pos = pos + 1
      ii = ii + 1
    }
    blk_end.push(pos)
    bi = bi + 1
  }

  let cand_syms : Array[String] = []
  let cand_first : Map[String, Int] = Map([])
  let cand_last : Map[String, Int] = Map([])

  // Helper: record a definition or use at `p` for eligible SSA symbol `raw`
  let mut cur_pos = 0
  bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if inst.dst.length() > 0 && inst.dst_ty != WASM_TY_VOID {
        let d = inst.dst
        let ucnt = match use_counts.get(d) { Some(c) => c; None => 0 }
        if ucnt >= 1 && !param_set.contains(d) && !const_copies.contains(d) &&
          !addr_off_base.contains(d) && !promoted_alloc_ty.contains(d) &&
          !alloc_offsets.contains(d) && !phi_dst_set.contains(d) && !local_idx.contains(d) {
          match cand_first.get(d) {
            Some(f0) => {
              if cur_pos < f0 { cand_first.set(d, cur_pos) }
              let l0 = match cand_last.get(d) { Some(v) => v; None => cur_pos }
              if cur_pos > l0 { cand_last.set(d, cur_pos) }
            }
            None => {
              cand_syms.push(d)
              cand_first.set(d, cur_pos)
              cand_last.set(d, cur_pos)
            }
          }
        }
      }
      if inst.op == "phi" {
        let mut pi = 0
        while pi + 1 < inst.args.length() {
          let pred_pos = match block_idx.get(inst.args[pi]) {
            Some(pidx) => blk_end[pidx]
            None => cur_pos
          }
          let s0 = wasm_trim(inst.args[pi + 1])
          let s = match addr_off_base.get(s0) { Some(b) => b; None => s0 }
          if cand_last.contains(s) {
            let l0 = match cand_last.get(s) { Some(v) => v; None => -1 }
            if pred_pos > l0 { cand_last.set(s, pred_pos) }
          }
          pi = pi + 2
        }
      } else {
        let mut ai = 0
        while ai < inst.args.length() {
          let s0 = wasm_trim(inst.args[ai])
          let s = match addr_off_base.get(s0) { Some(b) => b; None => s0 }
          if cand_last.contains(s) {
            let l0 = match cand_last.get(s) { Some(v) => v; None => -1 }
            if cur_pos > l0 { cand_last.set(s, cur_pos) }
          }
          ai = ai + 1
        }
      }
      cur_pos = cur_pos + 1
      ii = ii + 1
    }
    bi = bi + 1
  }

  let nc = cand_syms.length()
  if nc == 0 {
    return
  }

  // Also do a second pass for any uses that appeared before first_def (e.g. back-edge phis / out-of-order)
  cur_pos = 0
  bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if inst.op == "phi" {
        let mut pi = 0
        while pi + 1 < inst.args.length() {
          let pred_pos = match block_idx.get(inst.args[pi]) {
            Some(pidx) => blk_end[pidx]
            None => cur_pos
          }
          let s0 = wasm_trim(inst.args[pi + 1])
          let s = match addr_off_base.get(s0) { Some(b) => b; None => s0 }
          if cand_first.contains(s) {
            let f0 = match cand_first.get(s) { Some(v) => v; None => pred_pos }
            if pred_pos < f0 { cand_first.set(s, pred_pos) }
            let l0 = match cand_last.get(s) { Some(v) => v; None => -1 }
            if pred_pos > l0 { cand_last.set(s, pred_pos) }
          }
          pi = pi + 2
        }
      } else {
        let mut ai = 0
        while ai < inst.args.length() {
          let s0 = wasm_trim(inst.args[ai])
          let s = match addr_off_base.get(s0) { Some(b) => b; None => s0 }
          if cand_first.contains(s) {
            let f0 = match cand_first.get(s) { Some(v) => v; None => cur_pos }
            if cur_pos < f0 { cand_first.set(s, cur_pos) }
            let l0 = match cand_last.get(s) { Some(v) => v; None => -1 }
            if cur_pos > l0 { cand_last.set(s, cur_pos) }
          }
          ai = ai + 1
        }
      }
      cur_pos = cur_pos + 1
      ii = ii + 1
    }
    bi = bi + 1
  }

  // Extend live ranges crossing loop headers to the end of the loop
  let hdrs : Array[Int] = []
  bi = 0
  while bi < nb {
    if loop_end[bi] >= 0 {
      hdrs.push(bi)
    }
    bi = bi + 1
  }
  let nh = hdrs.length()
  let mut ci = 0
  while ci < nc {
    let sym = cand_syms[ci]
    let f0 = match cand_first.get(sym) { Some(v) => v; None => 0 }
    let mut l0 = match cand_last.get(sym) { Some(v) => v; None => f0 }
    let mut hi = 0
    while hi < nh {
      let h = hdrs[hi]
      let l_start = blk_start[h]
      let l_end = blk_end[loop_end[h]]
      if f0 < l_start && l0 >= l_start && l_end > l0 {
        l0 = l_end
      }
      hi = hi + 1
    }
    cand_last.set(sym, l0)
    ci = ci + 1
  }

  // Sort candidates by first_def ascending (insertion sort; nc is small per function)
  let order : Array[Int] = []
  let starts : Array[Int] = []
  let ends : Array[Int] = []
  ci = 0
  while ci < nc {
    order.push(ci)
    starts.push(match cand_first.get(cand_syms[ci]) { Some(v) => v; None => 0 })
    ends.push(match cand_last.get(cand_syms[ci]) { Some(v) => v; None => 0 })
    ci = ci + 1
  }
  let mut i = 1
  while i < nc {
    let key_idx = order[i]
    let key_s = starts[key_idx]
    let mut j = i - 1
    while j >= 0 && starts[order[j]] > key_s {
      order[j + 1] = order[j]
      j = j - 1
    }
    order[j + 1] = key_idx
    i = i + 1
  }

  // Greedy linear-scan slot assignment per Wasm value type (i32, i64, f32, f64)
  let slot_lidx : Array[Int] = []
  let slot_ty : Array[Int] = []
  let slot_end : Array[Int] = []
  i = 0
  while i < nc {
    let idx = order[i]
    let sym = cand_syms[idx]
    let s_pos = starts[idx]
    let e_pos = ends[idx]
    let ty = match local_ty.get(sym) { Some(t) => t; None => WASM_TY_I64 }
    let mut found = -1
    let mut si = 0
    while si < slot_lidx.length() {
      if slot_ty[si] == ty && slot_end[si] < s_pos {
        found = si
        break
      }
      si = si + 1
    }
    if found >= 0 {
      slot_end[found] = e_pos
      local_idx.set(sym, slot_lidx[found])
    } else {
      let lidx = n_params + extra_local_tys.length()
      extra_local_tys.push(ty)
      slot_lidx.push(lidx)
      slot_ty.push(ty)
      slot_end.push(e_pos)
      local_idx.set(sym, lidx)
    }
    i = i + 1
  }
}

///|
/// P53-A: Identify hot basic blocks where inlining `pion_alloc_uninit` (~140B)
/// and `pion_arr_push_owned` (~55B) is worthwhile:
///   - Condition A: self-recursive function (`call "$" + f.name`), excluding panic (`hlt`) blocks
///   - Condition B: natural loop bodies (exact backward reachability from back-edge `src -> dst` within `p >= dst`)
/// Cold blocks (initialization, one-shot branches, error/early-return paths) emit compact 4B `call`s.
fn wasm_compute_hot_blocks(
  f : WasmFunc,
  block_idx : Map[String, Int],
) -> Array[Bool] {
  let nb = f.blocks.length()
  let hot : Array[Bool] = []
  let mut bi = 0
  while bi < nb {
    hot.push(false)
    bi = bi + 1
  }
  if nb == 0 {
    return hot
  }

  // Condition A: self-recursive function (e.g., make_tree, jp_parse_value)
  let self_callee = "$" + f.name
  let mut is_self_rec = false
  bi = 0
  while bi < nb && !is_self_rec {
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if inst.op == "call" && inst.args.length() > 0 && inst.args[0] == self_callee {
        is_self_rec = true
        break
      }
      ii = ii + 1
    }
    bi = bi + 1
  }
  if is_self_rec {
    bi = 0
    while bi < nb {
      let insts = f.blocks[bi].insts
      let last_is_hlt = insts.length() > 0 && insts[insts.length() - 1].op == "hlt"
      if !last_is_hlt {
        hot[bi] = true
      }
      bi = bi + 1
    }
    return hot
  }

  // Condition B: natural loop bodies via exact backward reachability from back-edge sources (dst <= src)
  let pred_head : Array[Int] = []
  let seen_stamp : Array[Int] = []
  bi = 0
  while bi < nb {
    pred_head.push(-1)
    seen_stamp.push(0)
    bi = bi + 1
  }
  let pred_src : Array[Int] = []
  let pred_next : Array[Int] = []
  let back_src : Array[Int] = []
  let back_dst : Array[Int] = []

  bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let n = insts.length()
    if n > 0 {
      let term = insts[n - 1]
      if term.op == "jmp" && term.args.length() >= 1 {
        match block_idx.get(term.args[0]) {
          Some(v) => {
            pred_src.push(bi)
            pred_next.push(pred_head[v])
            pred_head[v] = pred_src.length() - 1
            if v <= bi {
              back_src.push(bi)
              back_dst.push(v)
            }
          }
          None => ()
        }
      } else if term.op == "jnz" && term.args.length() >= 3 {
        match block_idx.get(term.args[1]) {
          Some(v) => {
            pred_src.push(bi)
            pred_next.push(pred_head[v])
            pred_head[v] = pred_src.length() - 1
            if v <= bi {
              back_src.push(bi)
              back_dst.push(v)
            }
          }
          None => ()
        }
        match block_idx.get(term.args[2]) {
          Some(v) => {
            pred_src.push(bi)
            pred_next.push(pred_head[v])
            pred_head[v] = pred_src.length() - 1
            if v <= bi {
              back_src.push(bi)
              back_dst.push(v)
            }
          }
          None => ()
        }
      } else if term.op == "jtbl" && term.args.length() >= 2 {
        let mut ti = 1
        while ti < term.args.length() {
          match block_idx.get(term.args[ti]) {
            Some(v) => {
              pred_src.push(bi)
              pred_next.push(pred_head[v])
              pred_head[v] = pred_src.length() - 1
              if v <= bi {
                back_src.push(bi)
                back_dst.push(v)
              }
            }
            None => ()
          }
          ti = ti + 1
        }
      } else if term.op != "ret" && term.op != "hlt" && bi + 1 < nb {
        let v = bi + 1
        pred_src.push(bi)
        pred_next.push(pred_head[v])
        pred_head[v] = pred_src.length() - 1
      }
    } else if bi + 1 < nb {
      let v = bi + 1
      pred_src.push(bi)
      pred_next.push(pred_head[v])
      pred_head[v] = pred_src.length() - 1
    }
    bi = bi + 1
  }

  let mut ei = 0
  while ei < back_src.length() {
    let src = back_src[ei]
    let dst = back_dst[ei]
    let stamp = ei + 1
    hot[dst] = true
    seen_stamp[dst] = stamp
    let wl : Array[Int] = []
    if seen_stamp[src] != stamp {
      seen_stamp[src] = stamp
      hot[src] = true
      wl.push(src)
    }
    let mut wi = 0
    while wi < wl.length() {
      let cur = wl[wi]
      wi = wi + 1
      let mut pe = pred_head[cur]
      while pe >= 0 {
        let p = pred_src[pe]
        if p >= dst && seen_stamp[p] != stamp {
          seen_stamp[p] = stamp
          hot[p] = true
          wl.push(p)
        }
        pe = pred_next[pe]
      }
    }
    ei = ei + 1
  }
  hot
}

///|
fn wasm_compile_func(ctx : WasmModCtx, f : WasmFunc) -> Array[Int] {
  let local_idx : Map[String, Int] = Map([])
  let local_ty : Map[String, Int] = Map([])
  let extra_local_tys : Array[Int] = []
  let use_counts : Map[String, Int] = Map([])
  let def_counts : Map[String, Int] = Map([])
  let param_set : Map[String, Bool] = Map([])
  let n_params = f.param_names.length()
  let mut i = 0
  while i < n_params {
    local_idx.set(f.param_names[i], i)
    local_ty.set(f.param_names[i], f.param_tys[i])
    param_set.set(f.param_names[i], true)
    wasm_inc_sym_count(def_counts, f.param_names[i])
    i = i + 1
  }

  let block_idx : Map[String, Int] = Map([])
  let alloc_offsets : Map[String, Int] = Map([])
  let mut frame_off = 0
  let phi_preds : Array[Int] = []
  let phi_dsts : Array[Int] = []
  let phi_dst_names : Array[String] = []
  let phi_dst_tys : Array[Int] = []
  let phi_src_ops : Array[String] = []

  // Pass 1: map block labels, local types, def/use counts, and check whether any alloc exists
  // (Local indices are allocated lazily during emission so single-use adjacent temps consume 0 local slots.)
  let nb = f.blocks.length()
  let mut has_any_alloc = false
  let mut bi = 0
  while bi < nb {
    block_idx.set(f.blocks[bi].label, bi)
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if !has_any_alloc && (inst.op == "alloc4" || inst.op == "alloc8" || inst.op == "alloc16") {
        has_any_alloc = true
      }
      if inst.dst.length() > 0 && inst.dst_ty != WASM_TY_VOID {
        match local_ty.get(inst.dst) {
          Some(_) => ()
          None => local_ty.set(inst.dst, inst.dst_ty)
        }
        wasm_inc_sym_count(def_counts, inst.dst)
      }
      if inst.op == "phi" {
        let mut pi = 0
        while pi + 1 < inst.args.length() {
          wasm_inc_sym_count(use_counts, inst.args[pi + 1])
          pi = pi + 2
        }
      } else if inst.op == "cos" || inst.op == "cod" || inst.op == "cuos" || inst.op == "cuod" {
        // Float ordered/unordered comparisons emit each operand twice (a == a && b == b)
        if inst.args.length() >= 1 {
          wasm_inc_sym_count(use_counts, inst.args[0])
          wasm_inc_sym_count(use_counts, inst.args[0])
        }
        if inst.args.length() >= 2 {
          wasm_inc_sym_count(use_counts, inst.args[1])
          wasm_inc_sym_count(use_counts, inst.args[1])
        }
      } else {
        let mut ai = 0
        while ai < inst.args.length() {
          wasm_inc_sym_count(use_counts, inst.args[ai])
          ai = ai + 1
        }
      }
      ii = ii + 1
    }
    bi = bi + 1
  }

  // Pass 1b: collect non-escaping scalar alloc candidates in block 0 + pure-constant copies
  let cand_names : Array[String] = []
  let slot_ok : Map[String, Bool] = Map([])
  let slot_ty : Map[String, Int] = Map([])
  if has_any_alloc && nb > 0 {
    let b0_insts = f.blocks[0].insts
    let mut ii = 0
    while ii < b0_insts.length() {
      let inst = b0_insts[ii]
      if (inst.op == "alloc4" || inst.op == "alloc8" || inst.op == "alloc16") && inst.dst.length() > 0 {
        let sz = if inst.args.length() > 0 {
          wasm_parse_int64(inst.args[0]).to_int()
        } else {
          8
        }
        let dcnt = match def_counts.get(inst.dst) {
          Some(c) => c
          None => 0
        }
        if sz >= 1 && sz <= 8 && dcnt == 1 && !param_set.contains(inst.dst) {
          cand_names.push(inst.dst)
          slot_ok.set(inst.dst, true)
          slot_ty.set(inst.dst, -1)
        }
      }
      ii = ii + 1
    }
  }
  let has_cands = cand_names.length() > 0

  // Pass 2: escape & single-type consistency analysis, blk0_is_target, const_copies, and phi edges
  let blk0_lbl = if nb > 0 { f.blocks[0].label } else { "" }
  let mut blk0_is_target = false
  let const_copies : Map[String, String] = Map([])
  bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      let op = inst.op
      if op == "phi" {
        let mut pi = 0
        while pi + 1 < inst.args.length() {
          match block_idx.get(inst.args[pi]) {
            Some(pidx) => {
              phi_preds.push(pidx)
              phi_dsts.push(bi)
              phi_dst_names.push(inst.dst)
              phi_dst_tys.push(inst.dst_ty)
              phi_src_ops.push(inst.args[pi + 1])
            }
            None => ()
          }
          if has_cands {
            wasm_escape_slot(slot_ok, inst.args[pi + 1])
          }
          pi = pi + 2
        }
      } else if has_cands && (op == "storel" || op == "storew" || op == "stores" || op == "stored") {
        if inst.args.length() >= 2 {
          let v_op = wasm_trim(inst.args[0])
          let a_op = wasm_trim(inst.args[1])
          wasm_escape_slot(slot_ok, v_op)
          if a_op != v_op {
            let req_ty = if op == "storel" {
              WASM_TY_I64
            } else if op == "storew" {
              WASM_TY_I32
            } else if op == "stores" {
              WASM_TY_F32
            } else {
              WASM_TY_F64
            }
            wasm_mark_slot_type(slot_ok, slot_ty, a_op, req_ty)
          }
        } else {
          let mut ai = 0
          while ai < inst.args.length() {
            wasm_escape_slot(slot_ok, inst.args[ai])
            ai = ai + 1
          }
        }
      } else if has_cands && (op == "loadl" || op == "loadw" || op == "loadsw" || op == "loaduw" || op == "loads" || op == "loadd") {
        if inst.args.length() >= 1 {
          let a_op = wasm_trim(inst.args[0])
          let req_ty = if op == "loadl" {
            WASM_TY_I64
          } else if op == "loads" {
            WASM_TY_F32
          } else if op == "loadd" {
            WASM_TY_F64
          } else {
            WASM_TY_I32
          }
          wasm_mark_slot_type(slot_ok, slot_ty, a_op, req_ty)
        }
      } else {
        if op == "jmp" && inst.args.length() >= 1 {
          if inst.args[0] == blk0_lbl {
            blk0_is_target = true
          }
        } else if op == "jnz" && inst.args.length() >= 3 {
          if inst.args[1] == blk0_lbl || inst.args[2] == blk0_lbl {
            blk0_is_target = true
          }
        } else if op == "jtbl" && inst.args.length() >= 2 {
          let mut ji = 1
          while ji < inst.args.length() {
            if inst.args[ji] == blk0_lbl {
              blk0_is_target = true
            }
            ji = ji + 1
          }
        } else if op == "copy" && inst.dst.length() > 0 && inst.dst_ty != WASM_TY_VOID && inst.args.length() >= 1 {
          let dcnt = match def_counts.get(inst.dst) {
            Some(c) => c
            None => 0
          }
          let src = wasm_trim(inst.args[0])
          if dcnt == 1 && !param_set.contains(inst.dst) && src.length() > 0 {
            let sc0 = str_code_at(src, 0)
            if sc0 != 37 && sc0 != 36 {
              const_copies.set(inst.dst, src)
            }
          }
        }
        if has_cands {
          let mut ai = 0
          while ai < inst.args.length() {
            wasm_escape_slot(slot_ok, inst.args[ai])
            ai = ai + 1
          }
        }
      }
      ii = ii + 1
    }
    bi = bi + 1
  }

  let promoted_alloc_ty : Map[String, Int] = Map([])
  let mut ci = 0
  while ci < cand_names.length() {
    let cname = cand_names[ci]
    match slot_ok.get(cname) {
      Some(true) => {
        let sty = match slot_ty.get(cname) {
          Some(t) => t
          None => -1
        }
        promoted_alloc_ty.set(cname, sty)
      }
      _ => ()
    }
    ci = ci + 1
  }

  // Pass 2b (P42-C): fold `%p =l add %base, C` into load/store memarg.offset when all uses of %p are mem addresses
  let addr_cand_names : Array[String] = []
  let addr_cand_base : Map[String, String] = Map([])
  let addr_cand_off : Map[String, Int] = Map([])
  let addr_cand_ok : Map[String, Bool] = Map([])
  bi = 0
  while bi < nb {
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if inst.op == "add" && inst.dst_ty == WASM_TY_I64 && inst.dst.length() > 0 && inst.args.length() >= 2 {
        let dcnt = match def_counts.get(inst.dst) { Some(c) => c; None => 0 }
        let ucnt = match use_counts.get(inst.dst) { Some(c) => c; None => 0 }
        if dcnt == 1 && ucnt >= 1 && !param_set.contains(inst.dst) && !const_copies.contains(inst.dst) {
          let a0 = wasm_trim(inst.args[0])
          let a1 = wasm_trim(inst.args[1])
          let mut base = ""
          let mut off : Int64 = -1L
          if a0.length() > 0 && str_code_at(a0, 0) == 37 {
            let c1 = wasm_try_parse_nonneg_i32_const(a1)
            if c1 >= 0L {
              base = a0
              off = c1
            }
          }
          if off < 0L && a1.length() > 0 && str_code_at(a1, 0) == 37 {
            let c0 = wasm_try_parse_nonneg_i32_const(a0)
            if c0 >= 0L {
              base = a1
              off = c0
            }
          }
          if off >= 0L && base != inst.dst && !promoted_alloc_ty.contains(base) && !const_copies.contains(base) {
            let b_dcnt = match def_counts.get(base) { Some(c) => c; None => 0 }
            let b_ty = match local_ty.get(base) { Some(t) => t; None => -1 }
            if b_dcnt == 1 && (b_ty == WASM_TY_I64 || b_ty == WASM_TY_I32) {
              addr_cand_names.push(inst.dst)
              addr_cand_base.set(inst.dst, base)
              addr_cand_off.set(inst.dst, off.to_int())
              addr_cand_ok.set(inst.dst, true)
            }
          }
        }
      }
      ii = ii + 1
    }
    bi = bi + 1
  }
  let addr_off_base : Map[String, String] = Map([])
  let addr_off_const : Map[String, Int] = Map([])
  if addr_cand_names.length() > 0 {
    bi = 0
    while bi < nb {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        let op = inst.op
        if op == "phi" {
          let mut pi = 0
          while pi + 1 < inst.args.length() {
            let s = wasm_trim(inst.args[pi + 1])
            if addr_cand_ok.contains(s) {
              addr_cand_ok.set(s, false)
            }
            pi = pi + 2
          }
        } else if wasm_is_mem_load_op(op) {
          // args[0] is a valid memory address use
          ()
        } else if wasm_is_mem_store_op(op) {
          // args[0] is stored value (NOT address), args[1] is valid memory address use
          if inst.args.length() >= 1 {
            let s0 = wasm_trim(inst.args[0])
            if addr_cand_ok.contains(s0) {
              addr_cand_ok.set(s0, false)
            }
          }
        } else {
          let mut ai = 0
          while ai < inst.args.length() {
            let s = wasm_trim(inst.args[ai])
            if addr_cand_ok.contains(s) {
              addr_cand_ok.set(s, false)
            }
            ai = ai + 1
          }
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
    let mut ai = 0
    while ai < addr_cand_names.length() {
      let pname = addr_cand_names[ai]
      match addr_cand_ok.get(pname) {
        Some(true) => {
          let base = match addr_cand_base.get(pname) { Some(b) => b; None => "" }
          let off = match addr_cand_off.get(pname) { Some(o) => o; None => 0 }
          if base.length() > 0 {
            addr_off_base.set(pname, base)
            addr_off_const.set(pname, off)
            let p_uses = match use_counts.get(pname) { Some(c) => c; None => 1 }
            let b_uses = match use_counts.get(base) { Some(c) => c; None => 0 }
            use_counts.set(base, b_uses - 1 + p_uses)
          }
        }
        _ => ()
      }
      ai = ai + 1
    }
  }

  // Assign shadow-stack frame offsets ONLY for non-promoted allocs (skipped when function has no allocs)
  if has_any_alloc {
    bi = 0
    while bi < nb {
      let insts = f.blocks[bi].insts
      let mut ii = 0
      while ii < insts.length() {
        let inst = insts[ii]
        if (inst.op == "alloc4" || inst.op == "alloc8" || inst.op == "alloc16") &&
          !promoted_alloc_ty.contains(inst.dst) {
          let align = if inst.op == "alloc16" {
            16
          } else if inst.op == "alloc8" {
            8
          } else {
            4
          }
          let sz = if inst.args.length() > 0 {
            wasm_parse_int64(inst.args[0]).to_int()
          } else {
            8
          }
          frame_off = wasm_align_up(frame_off, align)
          alloc_offsets.set(inst.dst, frame_off)
          frame_off = frame_off + (if sz < 1 { 4 } else { sz })
        }
        ii = ii + 1
      }
      bi = bi + 1
    }
  }

  let frame_size = wasm_align_up(frame_off, 16)
  let fp_local = if frame_size > 0 {
    let idx = n_params + extra_local_tys.length()
    extra_local_tys.push(WASM_TY_I32)
    idx
  } else {
    -1
  }
  let multi_blk = nb > 1
  let loop_end = if multi_blk { wasm_analyze_structured_cfg(f, block_idx) } else { [] }
  let use_structured = multi_blk && loop_end.length() == nb
  let pc_local = if multi_blk && !use_structured {
    let idx = n_params + extra_local_tys.length()
    extra_local_tys.push(WASM_TY_I32)
    idx
  } else {
    -1
  }
  if use_structured {
    wasm_assign_colored_locals(
      f, block_idx, loop_end, n_params, param_set, local_ty, use_counts,
      const_copies, addr_off_base, promoted_alloc_ty, alloc_offsets,
      local_idx, extra_local_tys,
    )
  }

  let hot_blk = wasm_compute_hot_blocks(f, block_idx)

  let fctx = WasmFnCtx::{
    local_idx: local_idx,
    local_ty: local_ty,
    extra_local_tys: extra_local_tys,
    n_params: n_params,
    alloc_offsets: alloc_offsets,
    frame_size: frame_size,
    fp_local: fp_local,
    pc_local: pc_local,
    block_idx: block_idx,
    has_phi: phi_preds.length() > 0,
    phi_preds: phi_preds,
    phi_dsts: phi_dsts,
    phi_dst_names: phi_dst_names,
    phi_dst_tys: phi_dst_tys,
    phi_src_ops: phi_src_ops,
    phi_tmp_i32: -1,
    phi_tmp_i64: -1,
    phi_tmp_f32: -1,
    phi_tmp_f64: -1,
    use_counts: use_counts,
    def_counts: def_counts,
    promoted_alloc_ty: promoted_alloc_ty,
    promoted_alloc_lidx: Map([]),
    promoted_alloc_touched: Map([]),
    blk0_is_target: blk0_is_target,
    const_copies: const_copies,
    addr_off_base: addr_off_base,
    addr_off_const: addr_off_const,
    hot_blk: hot_blk,
    div_tmp_i32: -1,
    div_tmp_i64: -1,
    alloc_tmp_i32: -1,
    alloc_tmp2_i32: -1,
    push_tmp_i64: -1,
    last_set_pos: -1,
    last_set_end: -1,
    last_set_sym: "",
    last_set_ty: -1,
    last_set_lidx: -1,
    last_set_fresh: false,
  }

  let code : Array[Int] = []
  // Function prologue: allocate shadow stack frame
  if frame_size > 0 {
    code.push(0x23) // global.get 0 ($__sp)
    wasm_push_u32(code, 0)
    code.push(0x41) // i32.const frame_size
    wasm_push_s32(code, frame_size)
    code.push(0x6B) // i32.sub
    code.push(0x22) // local.tee $fp
    wasm_push_u32(code, fp_local)
    code.push(0x24) // global.set 0 ($__sp)
    wasm_push_u32(code, 0)
  }

  if nb == 0 {
    if f.ret_ty != WASM_TY_VOID {
      wasm_emit_operand(ctx, fctx, code, "0", f.ret_ty)
    }
    wasm_emit_epilogue(fctx, code)
  } else if !multi_blk {
    let insts = f.blocks[0].insts
    let mut terminated = false
    let mut ii = 0
    while ii < insts.length() {
      terminated = wasm_emit_inst(ctx, fctx, f.ret_ty, code, insts[ii], 0, 0, false)
      ii = ii + 1
    }
    if !terminated {
      if f.ret_ty != WASM_TY_VOID {
        wasm_emit_operand(ctx, fctx, code, "0", f.ret_ty)
      }
      wasm_emit_epilogue(fctx, code)
    }
  } else if use_structured {
    let scope_is_loop : Array[Bool] = []
    let scope_target : Array[Int] = []
    wasm_emit_structured_region(ctx, fctx, f, code, 0, nb - 1, -1, loop_end, scope_is_loop, scope_target)
    if f.ret_ty != WASM_TY_VOID {
      code.push(0x00) // unreachable for non-void result validation
    }
  } else {
    // $pc = 0; loop $disp { block $b_{nb-1} ... block $b_0 { local.get $pc; br_table 0..nb-1 0 } <blk 0> ... <blk nb-1> unreachable }
    code.push(0x41)
    wasm_push_s32(code, 0)
    code.push(0x21)
    wasm_push_u32(code, pc_local)
    code.push(0x03) // loop $disp
    code.push(0x40) // void
    bi = 0
    while bi < nb {
      code.push(0x02) // block $b
      code.push(0x40) // void
      bi = bi + 1
    }
    code.push(0x20) // local.get $pc
    wasm_push_u32(code, pc_local)
    code.push(0x0E) // br_table
    wasm_push_u32(code, nb)
    bi = 0
    while bi < nb {
      wasm_push_u32(code, bi)
      bi = bi + 1
    }
    wasm_push_u32(code, 0) // default
    bi = 0
    while bi < nb {
      fctx.last_set_pos = -1
      code.push(0x0B) // end $b_{bi}
      let disp_depth = nb - 1 - bi
      let insts = f.blocks[bi].insts
      let mut terminated = false
      let mut ii = 0
      while ii < insts.length() {
        terminated = wasm_emit_inst(ctx, fctx, f.ret_ty, code, insts[ii], bi, disp_depth, true)
        ii = ii + 1
      }
      if !terminated {
        if bi + 1 < nb {
          wasm_emit_jump_to(ctx, fctx, code, bi, f.blocks[bi + 1].label, disp_depth)
        } else {
          if f.ret_ty != WASM_TY_VOID {
            wasm_emit_operand(ctx, fctx, code, "0", f.ret_ty)
          }
          wasm_emit_epilogue(fctx, code)
          code.push(0x0F) // return
        }
      }
      bi = bi + 1
    }
    code.push(0x00) // unreachable
    code.push(0x0B) // end loop $disp
    if f.ret_ty != WASM_TY_VOID {
      code.push(0x00) // unreachable for non-void result validation after loop
    }
  }
  code.push(0x0B) // end function

  // Encode local declarations (run-length encoded) + code
  let rle_cnt : Array[Int] = []
  let rle_ty : Array[Int] = []
  i = 0
  while i < extra_local_tys.length() {
    let t = extra_local_tys[i]
    let k = rle_ty.length()
    if k > 0 && rle_ty[k - 1] == t {
      rle_cnt[k - 1] = rle_cnt[k - 1] + 1
    } else {
      rle_cnt.push(1)
      rle_ty.push(t)
    }
    i = i + 1
  }
  let body : Array[Int] = []
  wasm_push_u32(body, rle_cnt.length())
  i = 0
  while i < rle_cnt.length() {
    wasm_push_u32(body, rle_cnt[i])
    body.push(wasm_valtype_byte(rle_ty[i]))
    i = i + 1
  }
  wasm_push_bytes(body, code)
  body
}

///|
fn wasm_u32_len(v0 : Int) -> Int {
  let mut v = v0
  let mut len = 1
  while true {
    v = ushr32(v, 7)
    if v == 0 {
      break
    }
    len = len + 1
  }
  len
}

///|
fn wasm_ptr_write_u32(p : Ptr, off0 : Int, v0 : Int) -> Int {
  let mut v = v0
  let mut off = off0
  while true {
    let mut b = v & 0x7F
    v = ushr32(v, 7)
    if v != 0 {
      b = b | 0x80
    }
    ptr_write_u8(p, off.to_int64(), b)
    off = off + 1
    if v == 0 {
      break
    }
  }
  off
}

///|
fn wasm_ptr_write_arr(p : Ptr, off0 : Int, arr : Array[Int]) -> Int {
  let n = arr.length()
  let mut i = 0
  let mut off = off0
  while i < n {
    ptr_write_u8(p, off.to_int64(), arr[i] & 0xFF)
    off = off + 1
    i = i + 1
  }
  off
}

///|
fn wasm_int_array_to_bytes(arr : Array[Int]) -> Bytes {
  let n = arr.length()
  if n == 0 {
    return Bytes::new(0)
  }
  let p = ptr_alloc(n.to_int64())
  let mut i = 0
  while i < n {
    ptr_write_u8(p, i.to_int64(), arr[i] & 0xFF)
    i = i + 1
  }
  let b = bytes_from_ptr(p, n)
  ptr_free(p)
  b
}

///|
fn wasm_extract_sym_name(raw : String) -> String {
  let s = wasm_trim(raw)
  if s.length() <= 1 || str_code_at(s, 0) != 36 {
    return ""
  }
  let plus = wasm_find_char(s, 43, 1)
  let minus = wasm_find_char(s, 45, 1)
  if plus > 0 {
    wasm_trim(slice_str(s, 1, plus))
  } else if minus > 0 {
    wasm_trim(slice_str(s, 1, minus))
  } else {
    slice_str(s, 1, s.length())
  }
}

///|
fn wasm_is_internal_mangled_export(name : String) -> Bool {
  name.starts_with("pion_pkg_") ||
  name.starts_with("pion_init_consts_") ||
  name.starts_with("__pion_init_") ||
  name.starts_with("pion_fn_") ||
  name.starts_with("pion_m_") ||
  name.starts_with("pion_drop_") ||
  name.starts_with("pion_clo_") ||
  name.starts_with("pion_wrap_") ||
  name.starts_with("pion_impl_") ||
  name.starts_with("pion_trait_") ||
  name.starts_with("pion_vtable_")
}

///|
fn wasm_has_explicit_roots(funcs : Array[WasmFunc]) -> Bool {
  let mut i = 0
  while i < funcs.length() {
    let f = funcs[i]
    if f.name == "main" || f.name == "_start" ||
      (f.exported && !wasm_is_internal_mangled_export(f.name)) {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn wasm_is_export_root(f : WasmFunc, has_explicit_roots : Bool) -> Bool {
  f.name == "main" || f.name == "_start" ||
    (f.exported && (!has_explicit_roots || !wasm_is_internal_mangled_export(f.name)))
}

///|
fn wasm_is_ro_dedup_data(name : String) -> Bool {
  name.contains("pion_str_") ||
  name.contains("pion_cstr_") ||
  name.contains("pion_none_hdr")
}

///|
fn wasm_data_content_key(dd : WasmDataDef) -> String {
  let sb = StringBuilder()
  sb.write_string(dd.align.to_string())
  sb.write_char('|')
  let mut i = 0
  while i < dd.items.length() {
    let it = dd.items[i]
    // Never dedup data containing symbol relocations
    if it.raw.length() > 0 && str_code_at(it.raw, 0) == 36 {
      return ""
    }
    sb.write_string(it.kind)
    sb.write_char(':')
    sb.write_string(it.raw)
    sb.write_char(';')
    i = i + 1
  }
  sb.to_string()
}

///|
fn wasm_rewrite_sym_ref(raw : String, aliases : Map[String, String]) -> String {
  if raw.length() <= 1 || str_code_at(raw, 0) != 36 {
    return raw
  }
  let s = wasm_trim(raw)
  let plus = wasm_find_char(s, 43, 1)
  let minus = wasm_find_char(s, 45, 1)
  if plus > 0 {
    let sym = wasm_trim(slice_str(s, 1, plus))
    match aliases.get(sym) {
      Some(canon) => "$" + canon + slice_str(s, plus, s.length())
      None => raw
    }
  } else if minus > 0 {
    let sym = wasm_trim(slice_str(s, 1, minus))
    match aliases.get(sym) {
      Some(canon) => "$" + canon + slice_str(s, minus, s.length())
      None => raw
    }
  } else {
    let sym = slice_str(s, 1, s.length())
    match aliases.get(sym) {
      Some(canon) => "$" + canon
      None => raw
    }
  }
}

///|
fn wasm_func_bucket_key(f : WasmFunc) -> String {
  let mut total_insts = 0
  let mut h : Int64 = 1469598103934665603L
  h = (h ^ f.ret_ty.to_int64()) * 1099511628211L
  let mut pi = 0
  while pi < f.param_tys.length() {
    h = (h ^ f.param_tys[pi].to_int64()) * 1099511628211L
    pi = pi + 1
  }
  let mut bi = 0
  while bi < f.blocks.length() {
    let insts = f.blocks[bi].insts
    let ilen = insts.length()
    total_insts = total_insts + ilen
    h = (h ^ ilen.to_int64()) * 1099511628211L
    let mut ii = 0
    while ii < ilen {
      let inst = insts[ii]
      let oplen = inst.op.length()
      let c0 = if oplen > 0 { str_code_at(inst.op, 0) } else { 0 }
      let c1 = if oplen > 1 { str_code_at(inst.op, oplen - 1) } else { 0 }
      let sig = (inst.dst_ty << 20) | (inst.args.length() << 14) | (oplen << 10) | ((c0 & 31) << 5) | (c1 & 31)
      h = (h ^ sig.to_int64()) * 1099511628211L
      ii = ii + 1
    }
    bi = bi + 1
  }
  f.ret_ty.to_string() + ":" + f.param_tys.length().to_string() + ":" +
    f.blocks.length().to_string() + ":" + total_insts.to_string() + ":" + h.to_string()
}

///|
fn wasm_sb_write_uint(sb : StringBuilder, v0 : Int) -> Unit {
  if v0 < 10 {
    sb.write_char((48 + v0).unsafe_to_char())
    return
  }
  if v0 < 100 {
    sb.write_char((48 + v0 / 10).unsafe_to_char())
    sb.write_char((48 + v0 % 10).unsafe_to_char())
    return
  }
  sb.write_string(v0.to_string())
}

///|
fn wasm_func_fingerprint(f : WasmFunc) -> String {
  let sb = StringBuilder()
  wasm_sb_write_uint(sb, f.ret_ty)
  sb.write_char('(')
  let reg_map : Map[String, Int] = Map([])
  let mut next_reg = 0
  let mut pi = 0
  while pi < f.param_tys.length() {
    wasm_sb_write_uint(sb, f.param_tys[pi])
    sb.write_char(',')
    if pi < f.param_names.length() {
      reg_map.set(f.param_names[pi], next_reg)
      next_reg = next_reg + 1
    }
    pi = pi + 1
  }
  sb.write_char(')')
  let lbl_map : Map[String, Int] = Map([])
  let mut bi = 0
  while bi < f.blocks.length() {
    lbl_map.set(f.blocks[bi].label, bi)
    bi = bi + 1
  }
  bi = 0
  while bi < f.blocks.length() {
    sb.write_string("@b")
    wasm_sb_write_uint(sb, bi)
    sb.write_char(':')
    let insts = f.blocks[bi].insts
    let mut ii = 0
    while ii < insts.length() {
      let inst = insts[ii]
      if inst.dst.length() > 0 {
        let rid = match reg_map.get(inst.dst) {
          Some(r) => r
          None => {
            let r = next_reg
            next_reg = next_reg + 1
            reg_map.set(inst.dst, r)
            r
          }
        }
        sb.write_char('r')
        wasm_sb_write_uint(sb, rid)
        sb.write_char('=')
        wasm_sb_write_uint(sb, inst.dst_ty)
        sb.write_char(' ')
      }
      sb.write_string(inst.op)
      let mut ai = 0
      while ai < inst.args.length() {
        sb.write_char(' ')
        let a = inst.args[ai]
        if a.length() > 0 && str_code_at(a, 0) == 37 {
          let rid = match reg_map.get(a) {
            Some(r) => r
            None => {
              let r = next_reg
              next_reg = next_reg + 1
              reg_map.set(a, r)
              r
            }
          }
          sb.write_char('r')
          wasm_sb_write_uint(sb, rid)
        } else if a.length() > 0 && str_code_at(a, 0) == 64 {
          match lbl_map.get(a) {
            Some(lid) => {
              sb.write_string("@b")
              wasm_sb_write_uint(sb, lid)
            }
            None => sb.write_string(a)
          }
        } else {
          sb.write_string(a)
        }
        ai = ai + 1
      }
      if inst.arg_tys.length() > 0 {
        sb.write_char('[')
        let mut ti = 0
        while ti < inst.arg_tys.length() {
          wasm_sb_write_uint(sb, inst.arg_tys[ti])
          sb.write_char(',')
          ti = ti + 1
        }
        sb.write_char(']')
      }
      sb.write_char(';')
      ii = ii + 1
    }
    bi = bi + 1
  }
  sb.to_string()
}

///|
/// Deduplicate identical immutable static data (`pion_str_*`, `pion_cstr_*`, `pion_none_hdr`)
/// and identical non-root internal functions across multi-package units (2 rounds).
fn wasm_dedup_module(parsed : WasmModuleParsed) -> WasmModuleParsed {
  let aliases : Map[String, String] = Map([])
  // 1. Deduplicate immutable read-only static data
  let seen_data_key : Map[String, String] = Map([])
  let dedup_datas : Array[WasmDataDef] = []
  let mut di = 0
  while di < parsed.datas.length() {
    let dd = parsed.datas[di]
    let mut dropped = false
    if wasm_is_ro_dedup_data(dd.name) {
      let key = wasm_data_content_key(dd)
      if key.length() > 0 {
        match seen_data_key.get(key) {
          Some(canon) => {
            aliases.set(dd.name, canon)
            dropped = true
          }
          None => seen_data_key.set(key, dd.name)
        }
      }
    }
    if !dropped {
      dedup_datas.push(dd)
    }
    di = di + 1
  }

  let mut cur_funcs = parsed.funcs
  let has_explicit_roots = wasm_has_explicit_roots(cur_funcs)
  let mut fi = 0

  // Rewrite data aliases into funcs first, then run 2 rounds of identical-function dedup
  let mut dirty_funcs : Array[Bool] = []
  let mut round = 0
  while round < 3 {
    if round == 0 && aliases.length() > 0 {
      fi = 0
      while fi < cur_funcs.length() {
        let f = cur_funcs[fi]
        let mut bi = 0
        while bi < f.blocks.length() {
          let insts = f.blocks[bi].insts
          let mut ii = 0
          while ii < insts.length() {
            let args = insts[ii].args
            let mut ai = 0
            while ai < args.length() {
              let a = args[ai]
              if a.length() > 1 && str_code_at(a, 0) == 36 {
                args[ai] = wasm_rewrite_sym_ref(a, aliases)
              }
              ai = ai + 1
            }
            ii = ii + 1
          }
          bi = bi + 1
        }
        fi = fi + 1
      }
      di = 0
      while di < dedup_datas.length() {
        let items = dedup_datas[di].items
        let mut ii = 0
        while ii < items.length() {
          let r = items[ii].raw
          if r.length() > 1 && str_code_at(r, 0) == 36 {
            let nr = wasm_rewrite_sym_ref(r, aliases)
            if nr != r {
              items[ii] = WasmDataItem::{ kind: items[ii].kind, raw: nr }
            }
          }
          ii = ii + 1
        }
        di = di + 1
      }
    }
    if round >= 2 {
      break
    }
    let fn_aliases : Map[String, String] = Map([])
    let seen_fp : Map[String, String] = Map([])
    let next_funcs : Array[WasmFunc] = []
    let mut merged = 0
    // Pre-bucket non-root functions by structural shape + opcode hash;
    // unique buckets (and unchanged buckets in round >= 1) skip wasm_func_fingerprint completely.
    let bucket_cnt : Map[String, Int] = Map([])
    let bucket_dirty : Map[String, Bool] = Map([])
    let f_bkeys : Array[String] = []
    let f_is_root : Array[Bool] = []
    fi = 0
    while fi < cur_funcs.length() {
      let f = cur_funcs[fi]
      let is_root = wasm_is_export_root(f, has_explicit_roots)
      f_is_root.push(is_root)
      if is_root {
        f_bkeys.push("")
      } else {
        let bk = wasm_func_bucket_key(f)
        f_bkeys.push(bk)
        let prev = match bucket_cnt.get(bk) {
          Some(c) => c
          None => 0
        }
        bucket_cnt.set(bk, prev + 1)
        if round == 0 || (fi < dirty_funcs.length() && dirty_funcs[fi]) {
          bucket_dirty.set(bk, true)
        }
      }
      fi = fi + 1
    }
    fi = 0
    while fi < cur_funcs.length() {
      let f = cur_funcs[fi]
      if f_is_root[fi] {
        next_funcs.push(f)
      } else {
        let bk = f_bkeys[fi]
        let bcnt = match bucket_cnt.get(bk) {
          Some(c) => c
          None => 0
        }
        let is_dirty = round == 0 || bucket_dirty.contains(bk)
        if bcnt <= 1 || !is_dirty {
          next_funcs.push(f)
        } else {
          let fp = wasm_func_fingerprint(f)
          match seen_fp.get(fp) {
            Some(canon) => {
              fn_aliases.set(f.name, canon)
              merged = merged + 1
            }
            None => {
              seen_fp.set(fp, f.name)
              next_funcs.push(f)
            }
          }
        }
      }
      fi = fi + 1
    }
    if merged == 0 {
      break
    }
    cur_funcs = next_funcs
    dirty_funcs = []
    fi = 0
    while fi < cur_funcs.length() {
      let f = cur_funcs[fi]
      let mut changed = false
      let mut bi = 0
      while bi < f.blocks.length() {
        let insts = f.blocks[bi].insts
        let mut ii = 0
        while ii < insts.length() {
          let args = insts[ii].args
          let mut ai = 0
          while ai < args.length() {
            let a = args[ai]
            if a.length() > 1 && str_code_at(a, 0) == 36 {
              let na = wasm_rewrite_sym_ref(a, fn_aliases)
              if na != a {
                args[ai] = na
                changed = true
              }
            }
            ai = ai + 1
          }
          ii = ii + 1
        }
        bi = bi + 1
      }
      dirty_funcs.push(changed)
      fi = fi + 1
    }
    di = 0
    while di < dedup_datas.length() {
      let items = dedup_datas[di].items
      let mut ii = 0
      while ii < items.length() {
        let r = items[ii].raw
        if r.length() > 1 && str_code_at(r, 0) == 36 {
          let nr = wasm_rewrite_sym_ref(r, fn_aliases)
          if nr != r {
            items[ii] = WasmDataItem::{ kind: items[ii].kind, raw: nr }
          }
        }
        ii = ii + 1
      }
      di = di + 1
    }
    round = round + 1
  }
  WasmModuleParsed::{ datas: dedup_datas, funcs: cur_funcs }
}

///|
/// Opt 1: Call-graph & static-data reachability DCE from root exports (`main` + explicit `export`).
fn wasm_dce_module(parsed : WasmModuleParsed) -> WasmModuleParsed {
  let func_by_name : Map[String, Int] = Map([])
  let has_explicit_roots = wasm_has_explicit_roots(parsed.funcs)
  let mut fi = 0
  while fi < parsed.funcs.length() {
    let fname = parsed.funcs[fi].name
    func_by_name.set(fname, fi)
    fi = fi + 1
  }
  let data_by_name : Map[String, Int] = Map([])
  let mut di = 0
  while di < parsed.datas.length() {
    data_by_name.set(parsed.datas[di].name, di)
    di = di + 1
  }

  let live_funcs : Map[String, Bool] = Map([])
  let live_datas : Map[String, Bool] = Map([])
  let func_q : Array[Int] = []
  let data_q : Array[Int] = []

  // Seed roots: `main`, `_start`, plus explicit external exports (excluding internal mangled exports when explicit roots exist)
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    let is_root = wasm_is_export_root(f, has_explicit_roots)
    if is_root {
      match live_funcs.get(f.name) {
        Some(_) => ()
        None => {
          live_funcs.set(f.name, true)
          func_q.push(fi)
        }
      }
    }
    fi = fi + 1
  }
  if func_q.length() == 0 {
    return parsed
  }

  let mut fq_head = 0
  let mut dq_head = 0
  while fq_head < func_q.length() || dq_head < data_q.length() {
    while fq_head < func_q.length() {
      let f = parsed.funcs[func_q[fq_head]]
      fq_head = fq_head + 1
      let mut bi = 0
      while bi < f.blocks.length() {
        let insts = f.blocks[bi].insts
        let mut ii = 0
        while ii < insts.length() {
          let inst = insts[ii]
          let mut ai = 0
          while ai < inst.args.length() {
            let sym = wasm_extract_sym_name(inst.args[ai])
            if sym.length() > 0 {
              match func_by_name.get(sym) {
                Some(tfi) =>
                  match live_funcs.get(sym) {
                    Some(_) => ()
                    None => {
                      live_funcs.set(sym, true)
                      func_q.push(tfi)
                    }
                  }
                None =>
                  match data_by_name.get(sym) {
                    Some(tdi) =>
                      match live_datas.get(sym) {
                        Some(_) => ()
                        None => {
                          live_datas.set(sym, true)
                          data_q.push(tdi)
                        }
                      }
                    None => ()
                  }
              }
            }
            ai = ai + 1
          }
          ii = ii + 1
        }
        bi = bi + 1
      }
    }
    while dq_head < data_q.length() {
      let dd = parsed.datas[data_q[dq_head]]
      dq_head = dq_head + 1
      let mut ii = 0
      while ii < dd.items.length() {
        let item = dd.items[ii]
        let sym = wasm_extract_sym_name(item.raw)
        if sym.length() > 0 {
          match func_by_name.get(sym) {
            Some(tfi) =>
              match live_funcs.get(sym) {
                Some(_) => ()
                None => {
                  live_funcs.set(sym, true)
                  func_q.push(tfi)
                }
              }
            None =>
              match data_by_name.get(sym) {
                Some(tdi) =>
                  match live_datas.get(sym) {
                    Some(_) => ()
                    None => {
                      live_datas.set(sym, true)
                      data_q.push(tdi)
                    }
                  }
                None => ()
              }
          }
        }
        ii = ii + 1
      }
    }
  }

  let kept_funcs : Array[WasmFunc] = []
  fi = 0
  while fi < parsed.funcs.length() {
    let f = parsed.funcs[fi]
    match live_funcs.get(f.name) {
      Some(_) => kept_funcs.push(f)
      None => ()
    }
    fi = fi + 1
  }
  let kept_datas : Array[WasmDataDef] = []
  di = 0
  while di < parsed.datas.length() {
    let dd = parsed.datas[di]
    match live_datas.get(dd.name) {
      Some(_) => kept_datas.push(dd)
      None => ()
    }
    di = di + 1
  }
  WasmModuleParsed::{ datas: kept_datas, funcs: kept_funcs }
}

///|
fn wasm_is_sym_char(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
}

///|
/// Alpha-rename all file-local (non-exported) QBE `data` and `function` symbols in a package SSA
/// unit so multi-package `--target wasm32` builds never collide on `pion_clo_*`, `pion_str_*`, etc.
pub fn wasm_namespace_local_ssa(ssa : String, prefix : String) -> String {
  let n = ssa.length()
  let local_syms : Map[String, Bool] = Map([])
  let mut count = 0
  let mut pos = 0
  while pos < n {
    let mut eol = pos
    while eol < n && str_code_at(ssa, eol) != 10 {
      eol = eol + 1
    }
    let next_pos = if eol < n { eol + 1 } else { n }
    let cend = wasm_strip_comment_end(ssa, pos, eol)
    let la = wasm_skip_ws_range(ssa, pos, cend)
    let lb = wasm_rtrim_ws_range(ssa, la, cend)
    if lb > la {
      if wasm_starts_with_at(ssa, la, lb, "data ") {
        let eq = wasm_find_char_range(ssa, 61, la, lb)
        if eq > la {
          let dl = wasm_find_char_range(ssa, 36, la, eq)
          if dl >= 0 {
            let nb = wasm_rtrim_ws_range(ssa, dl + 1, eq)
            if nb > dl + 1 {
              local_syms.set(slice_str(ssa, dl + 1, nb), true)
              count = count + 1
            }
          }
        }
      } else if wasm_starts_with_at(ssa, la, lb, "function ") {
        let dl = wasm_find_char_range(ssa, 36, la + 9, lb)
        let lp = if dl >= 0 { wasm_find_char_range(ssa, 40, dl + 1, lb) } else { -1 }
        if dl >= 0 && lp > dl + 1 {
          let nb = wasm_rtrim_ws_range(ssa, dl + 1, lp)
          if nb > dl + 1 {
            local_syms.set(slice_str(ssa, dl + 1, nb), true)
            count = count + 1
          }
        }
      }
    }
    pos = next_pos
  }
  if count == 0 {
    return ssa
  }

  let sb = StringBuilder()
  let mut i = 0
  let mut seg_start = 0
  let mut in_str = false
  let mut esc = false
  let mut in_comment = false
  while i < n {
    let c = str_code_at(ssa, i)
    if in_comment {
      if c == 10 {
        in_comment = false
      }
      i = i + 1
    } else if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
      i = i + 1
    } else if c == 34 {
      in_str = true
      i = i + 1
    } else if c == 35 {
      in_comment = true
      i = i + 1
    } else if c == 36 {
      let mut j = i + 1
      while j < n && wasm_is_sym_char(str_code_at(ssa, j)) {
        j = j + 1
      }
      if j > i + 1 {
        let sym = slice_str(ssa, i + 1, j)
        match local_syms.get(sym) {
          Some(_) => {
            if i > seg_start {
              sb.write_string(slice_str(ssa, seg_start, i))
            }
            sb.write_char('$')
            sb.write_string(prefix)
            sb.write_string(sym)
            seg_start = j
          }
          None => ()
        }
      }
      i = j
    } else {
      i = i + 1
    }
  }
  if seg_start < n {
    sb.write_string(slice_str(ssa, seg_start, n))
  }
  sb.to_string()
}

///|
/// Pure-Wasm internal `pion_rc_inc(ptr: i64) -> void` fast path (zero JS boundary crossings).
fn wasm_build_rc_inc_body() -> Array[Int] {
  let body : Array[Int] = [0x01, 0x01, 0x7F] // 1 local: hdr (i32)
  // if (i32.wrap_i64(ptr) == 0) return
  body.push(0x20); wasm_push_u32(body, 0) // local.get 0 (ptr)
  body.push(0xA7)                         // i32.wrap_i64
  body.push(0x22); wasm_push_u32(body, 1) // local.tee 1
  body.push(0x45)                         // i32.eqz
  body.push(0x04); body.push(0x40)        // if (void)
  body.push(0x0F)                         // return
  body.push(0x0B)                         // end
  // hdr = p - 24
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x6B)                         // i32.sub
  body.push(0x22); wasm_push_u32(body, 1) // local.tee 1 (hdr)
  // if ((flags & FLAG_IMMORTAL(2)) != 0) return
  body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14) // i32.load16_u align=1 offset=14
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x71)                         // i32.and
  body.push(0x04); body.push(0x40)
  body.push(0x0F)
  body.push(0x0B)
  // if (owner_tid == 0) shared_rc += 1 else local_rc += 1
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i32.load align=2 offset=0
  body.push(0x45)                         // i32.eqz
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // shared_rc
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6A)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x05)                         // else
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 4) // local_rc
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6A)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x0B)                         // end if
  body.push(0x0B)                         // end func
  body
}

///|
/// Pure-Wasm internal `pion_rc_dec(ptr: i64) -> void` fast path; only calls JS `pion_rc_dec_slow` when rc == 0.
fn wasm_build_rc_dec_body(slow_imp_idx : Int) -> Array[Int] {
  let body : Array[Int] = [0x01, 0x02, 0x7F] // 2 locals: hdr (i32), rc (i32)
  // if (i32.wrap_i64(ptr) == 0) return
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 1)
  body.push(0x45)
  body.push(0x04); body.push(0x40)
  body.push(0x0F)
  body.push(0x0B)
  // hdr = p - 24
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 1)
  // if ((flags & FLAG_IMMORTAL(2)) != 0) return
  body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x71)
  body.push(0x04); body.push(0x40)
  body.push(0x0F)
  body.push(0x0B)
  // P52-A: Unique-owner fast path: owner_tid==1 && local_rc==1 -> call rc_dec_slow directly (zero dead local_rc=0 store)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x42); wasm_push_s64(body, 0x0000000100000001L)
  body.push(0x51)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // Hot path: if (owner_tid != 0) { rc = local_rc - 1; local_rc = rc } else { rc = shared_rc - 1; shared_rc = rc }
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 2) // local.tee 2 (rc)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 2) // local.tee 2 (rc)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x0B)
  // if (rc == 0) call $pion_rc_dec_slow(ptr)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x45)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0B)
  body.push(0x0B) // end func
  body
}

///|
/// Pure-Wasm internal `pion_alloc` / `pion_alloc_uninit` fast path (<= 512B slab + bump in linear memory).
/// Falls back to JS import `slow_imp_idx` when payload_sz > 480 or heap_ptr + alloc_sz > heap_end.
/// Signature: (param 0: payload_sz i32, param 1: type_tag i32, param 2: drop_fn i64) -> i64
fn wasm_build_alloc_body(slow_imp_idx : Int, zero_payload : Bool) -> Array[Int] {
  // 6 i32 locals: 3=need, 4=cls, 5=alloc_sz, 6=base, 7=ctl, 8=slot
  let body : Array[Int] = [0x01, 0x06, 0x7F]

  // if (i32.gt_u(payload_sz, 480)) return call slow_imp_idx(payload_sz, type_tag, drop_fn)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x41); wasm_push_s32(body, 480)
  body.push(0x4B) // i32.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)

  // need = ((payload_sz + 31) & -8) + 8  (in [32, 512])
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x41); wasm_push_s32(body, 31)
  body.push(0x6A) // i32.add
  body.push(0x41); wasm_push_s32(body, -8)
  body.push(0x71) // i32.and
  body.push(0x41); wasm_push_s32(body, 8)
  body.push(0x6A) // i32.add
  body.push(0x21); wasm_push_u32(body, 3) // local.set 3 (need)

  // Map need -> (cls, alloc_sz) for FREE_CLASSES[0..8] = [32, 48, 64, 96, 128, 192, 256, 384, 512]
  // Fast path: need <= 48 covers >90% of allocations (binary_trees / map_count / json) in 1-2 compares.
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 48)
  body.push(0x4D) // i32.le_u
  body.push(0x04); body.push(0x40)
  // need <= 48: 32 -> 0, 48 -> 1
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 32)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 32); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 48); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x05)
  // need > 48: binary search [64, 96, 128] vs [192, 256, 384, 512]
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 128)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  // 56..128
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 64)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 64); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 96)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 3); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 96); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 4); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 128); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  // 136..512
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 256)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  // 136..256
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 192)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 5); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 192); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 6); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 256); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x05)
  // 264..512
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 384)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 384); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 512); body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)

  // ctl = global.get 2 (__pion_slab_ctl)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x22); wasm_push_u32(body, 7) // local.tee 7 (ctl)
  // slot = ctl + (cls << 2)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x74) // i32.shl
  body.push(0x6A) // i32.add
  body.push(0x22); wasm_push_u32(body, 8) // local.tee 8 (slot)
  // base = i32.load(slot)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 6) // local.tee 6 (base)
  body.push(0x04); body.push(0x40) // if (base != 0)
  // Pop freelist: i32.store(slot, i32.load(base + 8))
  body.push(0x20); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x05) // else: bump allocate
  // base = i32.load(ctl + 36)  (heap_ptr)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x22); wasm_push_u32(body, 6) // local.tee 6 (base)
  // need = base + alloc_sz (reuse local 3 as new_hp)
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 3) // local.tee 3 (new_hp)
  // if (i32.gt_u(new_hp, i32.load(ctl + 40))) return slow path
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 40)
  body.push(0x4B) // i32.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // i32.store(ctl + 36, new_hp)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x0B) // end if (freelist vs bump)

  // Block header: [alloc_sz @ base+0, ALLOC_MAGIC(0x50494F4E) @ base+4]
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 0x50494F4E)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)

  // PionHeader @ base+8 (24B):
  //   base+8:  owner_tid = 1
  //   base+12: local_rc = 1
  //   base+16: shared_rc = 0
  //   base+20: type_tag:u16 | ((FLAG_SLAB(0x10) | (cls << 8)) << 16)
  //   base+24: drop_fn:i64
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 12)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 0xFFFF)
  body.push(0x71) // i32.and
  body.push(0x41); wasm_push_s32(body, 0x100000) // FLAG_SLAB(0x10) << 16
  body.push(0x72) // i32.or
  body.push(0x20); wasm_push_u32(body, 4) // cls
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x74) // i32.shl
  body.push(0x72) // i32.or
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 24)

  // payload_ptr = base + 32 (reuse local 3)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 32)
  body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 3) // local.tee 3 (payload_ptr)

  if zero_payload {
    // memory.fill(payload_ptr, 0, payload_sz)
    body.push(0x41); wasm_push_s32(body, 0)
    body.push(0x20); wasm_push_u32(body, 0)
    body.push(0xFC); wasm_push_u32(body, 11); body.push(0x00)
    body.push(0x20); wasm_push_u32(body, 3)
  }

  // return i64.extend_i32_u(payload_ptr)
  body.push(0xAD)
  body.push(0x0B) // end func
  body
}

///|
/// Pure-Wasm internal `__pion_raw_free_slab(ptr: i32) -> i32`.
/// Returns 1 if `ptr` was freed (null/guard/heap-top shrink/<=512B slab),
/// or 0 if `ptr` is a valid >512B non-heap-top block that must fall back to JS `rawFree`.
fn wasm_build_raw_free_slab_body() -> Array[Int] {
  // 7 i32 locals: 1=base, 2=ctl, 3=alloc_sz, 4=cls, 5=hp, 6=slot/hb, 7=rem
  let body : Array[Int] = [0x01, 0x07, 0x7F]

  // if (ptr == 0) return 1
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x45)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0F)
  body.push(0x0B)

  // base = ptr - 8; ctl = global.get 2; hp = i32.load(ctl + 36); hb = i32.load(ctl + 44)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x41); wasm_push_s32(body, 8)
  body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 1)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x22); wasm_push_u32(body, 2)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 44)
  body.push(0x21); wasm_push_u32(body, 6)

  // P58-A: Combined range + alignment guard: ((base - hb) >=_u (hp - hb)) | (base & 7) -> return 1
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x6B) // base - hb
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x6B) // hp - hb
  body.push(0x4F) // i32.ge_u
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 7)
  body.push(0x71) // base & 7
  body.push(0x72) // i32.or
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0F)
  body.push(0x0B)

  // if (i32.load(base + 4) != ALLOC_MAGIC(0x50494F4E)) return 1 (double-free / corrupt guard)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 0x50494F4E)
  body.push(0x47) // i32.ne
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0F)
  body.push(0x0B)

  // P58-A: Overflow-free size guard using rem = hp - base: if (alloc_sz < 16 || alloc_sz > rem) return 1
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x6B) // hp - base
  body.push(0x21); wasm_push_u32(body, 7) // rem
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 3) // alloc_sz
  body.push(0x41); wasm_push_s32(body, 16)
  body.push(0x49) // i32.lt_u
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x4B) // i32.gt_u
  body.push(0x72)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0F)
  body.push(0x0B)

  // Heap-top LIFO shrink: if (alloc_sz == rem) { magic=FREE_MAGIC; heap_ptr=base; return 1 }
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x46) // i32.eq
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 0x46524545)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 36)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0F)
  body.push(0x0B)

  // P58-A: Hot-first exact match alloc_sz -> cls in [0..8] ([32, 48, 64, 96] first, else [128..512]), else return 0
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 96)
  body.push(0x4D) // i32.le_u
  body.push(0x04); body.push(0x40)
  // <= 96: [32, 48] vs [64, 96]
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 48)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 32); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 48); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 64); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 96); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 3); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  // > 96: check <= 512 first, then [128, 192, 256] vs [384, 512]
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 512)
  body.push(0x4B) // i32.gt_u
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 256)
  body.push(0x4D)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 128); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 4); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 192); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 5); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 256); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 6); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 384); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 7); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 512); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)

  // slot = ctl + (cls << 2)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x74)
  body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 6)

  // i32.store(base + 4, FREE_MAGIC(0x46524545))
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 0x46524545)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)

  // i32.store(base + 8, i32.load(slot))
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)

  // i32.store(slot, base); return 1
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0B) // end func
  body
}

///|
/// P52-A: Compact inline unique-owner (`owner_tid==1 && local_rc==1`) leaf Slab recycle for `ev` (local 10, i64, non-zero).
/// Uses single `i64.load(thdr)==0x0000000100000001L` check (zero dead `local_rc=0` store!) + `(tflags & 0x12)==0x10`.
/// Uses locals `13=thdr, 14=tflags, 15=ttag, 16=tslot, 18=tbase`; preserves locals `1..11`.
fn wasm_emit_inline_rc_dec_leaf(
  body : Array[Int],
  rc_dec_internal_idx : Int,
  rc_dec_slow_internal_idx : Int,
) -> Unit {
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7)
  body.push(0x41); wasm_push_s32(body, 24); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 13) // thdr
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x42); wasm_push_s64(body, 0x0000000100000001L)
  body.push(0x51) // owner_tid == 1 && local_rc == 1
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 14) // tflags
  body.push(0x41); wasm_push_s32(body, 0x12); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x46) // FLAG_SLAB && !FLAG_IMMORTAL
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0x50)
  body.push(0x71) // && drop_fn == 0L
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 12)
  body.push(0x22); wasm_push_u32(body, 15) // ttag
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46); body.push(0x72)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 5); body.push(0x46); body.push(0x72)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 18) // tbase
  body.push(0x41); wasm_push_s32(body, 0x46524545)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 8); body.push(0x76)
  body.push(0x41); wasm_push_s32(body, 15); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 16) // tslot
  body.push(0x20); wasm_push_u32(body, 18)
  body.push(0x20); wasm_push_u32(body, 16); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 16); body.push(0x20); wasm_push_u32(body, 18)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x10); wasm_push_u32(body, rc_dec_slow_internal_idx)
  body.push(0x0B)
  body.push(0x05) // not leaf slab (could be immortal or container/drop_fn!=0)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 2); body.push(0x71); body.push(0x45)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x10); wasm_push_u32(body, rc_dec_slow_internal_idx)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05) // rc > 1 or shared
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x10); wasm_push_u32(body, rc_dec_internal_idx)
  body.push(0x0B)
}

///|
/// P56-A: Ultra-compact specialized 2-slot Slab tree destructor `pion_drop_s2(p: i32, slot: i32, expected_tf: i32) -> void`.
/// Handles direct 2-slot nodes (0x80000003), leaf children (tdrop == 0L, e.g. None/String), AND inline
/// unwrapping of boxed `Some(Node)` wrappers (0x80000002 -> recycle Some -> single-load `expected_tf` check
/// -> recurse/tail-loop directly into Node with zero `slot` recomputation and zero `pion_rc_dec_slow` re-entry).
fn wasm_build_drop_s2_body(self_idx : Int, rc_dec_idx : Int) -> Array[Int] {
  // Params: 0=p(i32), 1=slot(i32), 2=expected_tf(i32)
  // Locals: 3 i64 (3=ev0, 4=ev1, 5=tdrop) + 4 i32 (6=base/thdr, 7=tflags, 8=tslot, 9=ttag)
  let body : Array[Int] = [0x02, 0x03, 0x7E, 0x04, 0x7F]
  body.push(0x03); body.push(0x40) // loop $s2 [depth 0]
  // ev0 (3) = i64.load(p + 0); ev1 (4) = i64.load(p + 8)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x21); wasm_push_u32(body, 4)
  // Recycle base = p - 32 immediately to slot (1)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 0x46524545); body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  // If ev1 == 0L: promote ev0 -> ev1 so 100k left-leaning chains stay O(1) stack
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x50)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x0B)
  // === Process ev0 (left child when both children non-null) ===
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40) // [depth 1]
  body.push(0x02); body.push(0x40) // block $ev0_done [depth 2]
  body.push(0x20); wasm_push_u32(body, 3); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 24); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 6) // thdr
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x42); wasm_push_s64(body, 0x0000000100000001L); body.push(0x51)
  body.push(0x04); body.push(0x40) // [depth 3: unique owner]
  // P57-A: Homomorphic 0x80000003 fast path FIRST (zero tflags/ttag/tslot recomputation!)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 12)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x42); wasm_push_s64(body, 2147483651L); body.push(0x51)
  body.push(0x71)
  body.push(0x04); body.push(0x40) // [depth 4: homomorphic 0x80000003]
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 32)
  body.push(0x84); body.push(0x50)
  body.push(0x04); body.push(0x40) // [depth 5: leaf -> recycle directly to slot (1)]
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 6)
  body.push(0x41); wasm_push_s32(body, 0x46524545); body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x10); wasm_push_u32(body, self_idx)
  body.push(0x0B) // end 5
  body.push(0x0C); wasm_push_u32(body, 2) // br $ev0_done (4 - 2 = 2)
  body.push(0x0B) // end 4
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 7) // tflags
  body.push(0x41); wasm_push_s32(body, 0x12); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x46) // FLAG_SLAB && !FLAG_IMMORTAL
  body.push(0x04); body.push(0x40) // [depth 4]
