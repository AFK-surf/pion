  // d = i32.load(slab_ctl + 80)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 80)
  body.push(0x22); wasm_push_u32(body, 1) // local.tee 1 (d)
  // if (d >=u 64) { call slow_imp_idx(obj); return }
  body.push(0x41); wasm_push_s32(body, 64)
  body.push(0x4F) // i32.ge_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // i32.store(slab_ctl + 80, d + 1)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6A) // i32.add
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 80)
  // call inner_idx(obj)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x10); wasm_push_u32(body, inner_idx)
  // i32.store(slab_ctl + 80, d)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 80)
  // if (d == 0 && i32.load(slab_ctl + 84) != 0) { call slow_imp_idx(0L) }
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x45) // i32.eqz
  body.push(0x04); body.push(0x40)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 84)
  body.push(0x04); body.push(0x40)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B) // end func
  body
}

///|
fn wasm_build_rc_dec_slow_body(
  slow_imp_idx : Int,
  drop_sig_idx : Int,
  rc_dec_internal_idx : Int,
  raw_free_slab_idx : Int,
  rc_dec_slow_internal_idx : Int,
  drop_s2_internal_idx : Int,
) -> Array[Int] {
  // 9 i32 locals (1=p, 2=hdr, 3=tag, 4=drop_idx/flag1, 5=dp/es, 6=len/cap/base, 7=i/slot, 8=flag2/stride, 9=entry/tbase)
  // + 1 i64 local (10=ev/ev0) + 1 i32 local (11=mask_cur)
  // + 1 i64 local (12=tail_next/ev1) + 4 i32 locals (13=thdr, 14=tflags, 15=trc/ttag, 16=tslot)
  // + 1 i64 local (17=tdrop) + 3 i32 locals (18=sp0/tbase_arr, 19=stk_base, 20=sp)
  let body : Array[Int] = [0x07, 0x09, 0x7F, 0x01, 0x7E, 0x01, 0x7F, 0x01, 0x7E, 0x04, 0x7F, 0x01, 0x7E, 0x03, 0x7F]

  // P47-A: Tail-loop wrapper ($tail at depth 0) for zero-call_indirect iterative tree/list destruction
  body.push(0x03); body.push(0x40) // loop $tail (depth 0)

  // p = i32.wrap_i64(obj); if (p == 0) return
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 1)
  body.push(0x45)
  body.push(0x04); body.push(0x40)
  body.push(0x0F)
  body.push(0x0B)

  // hdr = p - 24
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x41); wasm_push_s32(body, 24)
  body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 2) // local.tee 2 (hdr)

  // tag = i32.load16_u(hdr + 12)
  body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 12)
  body.push(0x22); wasm_push_u32(body, 3) // local.tee 3 (tag)

  // is_fast_tag = i32.le_u(tag - 1, 6) | (tag == 11)  (tags 1..7 and TAG_STRBUF=11)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x6B) // i32.sub
  body.push(0x41); wasm_push_s32(body, 6)
  body.push(0x4D) // i32.le_u
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 11)
  body.push(0x46) // i32.eq
  body.push(0x72) // i32.or
  body.push(0x45) // i32.eqz -> not fast tag (e.g. MUTEX=8, CHANNEL=9)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)

  // drop_idx = i32.wrap_i64(i64.load(hdr + 16))
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40) // if (drop_idx != 0) [depth 1]
  // P47-A: if (drop_idx < 0): Tagged Slot-Mask (bit 31 set -> zero call_indirect!)
  // P52-A: Skip dead drop_fn=0L store on tagged masks (pure Wasm, never re-enters or calls JS).
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 0)
  body.push(0x48) // i32.lt_s
  body.push(0x04); body.push(0x40) // if (drop_idx < 0) [depth 2]
  // P56-A: Dispatch 2-slot Slab tagged mask 0x80000003 (-2147483645) to ultra-compact `pion_drop_s2`
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, -2147483645)
  body.push(0x46) // i32.eq
  body.push(0x04); body.push(0x40) // if (drop_idx == 0x80000003) [depth 3]
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46); body.push(0x72)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 5); body.push(0x46); body.push(0x72)
  body.push(0x04); body.push(0x40) // if (tag in {1, 4, 5}) [depth 4]
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 8) // flags
  body.push(0x41); wasm_push_s32(body, 0x12); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x46) // FLAG_SLAB && !FLAG_IMMORTAL
  body.push(0x04); body.push(0x40) // [depth 5]
  body.push(0x20); wasm_push_u32(body, 1) // p
  body.push(0x23); wasm_push_u32(body, 2) // ctl
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x41); wasm_push_s32(body, 8); body.push(0x76)
  body.push(0x41); wasm_push_s32(body, 15); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A) // slot
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 12) // expected_tf
  body.push(0x10); wasm_push_u32(body, drop_s2_internal_idx)
  body.push(0x0F)
  body.push(0x0B) // end FLAG_SLAB && !IMMORTAL
  body.push(0x0B) // end tag in {1, 4, 5}
  body.push(0x0B) // end drop_idx == 0x80000003
  // P52-A + P56-A: Specialized 1-slot fast path for 0x80000002 (-2147483646: JStr/JObj/JArr/Some)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, -2147483646)
  body.push(0x46)
  body.push(0x04); body.push(0x40) // [depth 3]
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46); body.push(0x72)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 5); body.push(0x46); body.push(0x72)
  body.push(0x04); body.push(0x40) // [depth 4]
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 8)
  body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x71)
  body.push(0x04); body.push(0x40) // [depth 5]
  // ev1 (10) = i64.load(p + 8); recycle current Slab object immediately
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x21); wasm_push_u32(body, 10)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 6) // base
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x41); wasm_push_s32(body, 8); body.push(0x76)
  body.push(0x41); wasm_push_s32(body, 15); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 7) // slot
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x41); wasm_push_s32(body, 0x46524545)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  // P56-A: Release sole child ev1 (local 10) with single-load unique-owner check (zero dead local_rc=0 store!)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40) // [depth 6]
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 24); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 13) // thdr
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x42); wasm_push_s64(body, 0x0000000100000001L); body.push(0x51)
  body.push(0x04); body.push(0x40) // [depth 7: unique owner (tid==1 && rc==1)]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 14) // tflags
  body.push(0x41); wasm_push_s32(body, 0x12); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x46) // FLAG_SLAB && !FLAG_IMMORTAL
  body.push(0x04); body.push(0x40) // [depth 8]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0x50)
  body.push(0x04); body.push(0x40) // [depth 9: tdrop == 0L]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 12)
  body.push(0x22); wasm_push_u32(body, 15)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46); body.push(0x72)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 5); body.push(0x46); body.push(0x72)
  body.push(0x04); body.push(0x40) // [depth 10: ttag in {1, 4, 5}]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 9)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 8); body.push(0x76)
  body.push(0x41); wasm_push_s32(body, 15); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 16)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0x41); wasm_push_s32(body, 0x46524545)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x20); wasm_push_u32(body, 16); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 16); body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0F)
  body.push(0x0B) // end ttag
  body.push(0x0B) // end tdrop == 0L
  body.push(0x0B) // end FLAG_SLAB && !IMMORTAL
  // Non-leaf sole child (if !FLAG_IMMORTAL) -> tail-loop br 8 ($tail at depth 0)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 2); body.push(0x71); body.push(0x45)
  body.push(0x04); body.push(0x40) // [depth 8]
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x21); wasm_push_u32(body, 0)
  body.push(0x0C); wasm_push_u32(body, 8)
  body.push(0x0B)
  body.push(0x05) // else rc > 1 or shared
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x10); wasm_push_u32(body, rc_dec_internal_idx)
  body.push(0x0B) // end unique owner
  body.push(0x0B) // end ev1 != 0
  body.push(0x0F)
  body.push(0x0B) // end FLAG_SLAB
  body.push(0x0B) // end tag in {1, 4, 5}
  body.push(0x0B) // end drop_idx == 0x80000002
  // Clear drop_fn before general bitmap loop so non-Slab (>480B) JS slow-path fallback cannot double-drop
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  // mask_cur (11) = drop_idx & 0x7FFFFFFF; tail_next (12) = 0L
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 0x7FFFFFFF)
  body.push(0x71)
  body.push(0x21); wasm_push_u32(body, 11)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x21); wasm_push_u32(body, 12)
  // while (mask_cur != 0)
  body.push(0x02); body.push(0x40) // block [depth 3]
  body.push(0x03); body.push(0x40) // loop [depth 4]
  body.push(0x20); wasm_push_u32(body, 11)
  body.push(0x45) // i32.eqz
  body.push(0x0D); wasm_push_u32(body, 1) // br_if block
  // bit (7) = i32.ctz(mask_cur); mask_cur &= mask_cur - 1
  body.push(0x20); wasm_push_u32(body, 11)
  body.push(0x68) // i32.ctz
  body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x20); wasm_push_u32(body, 11)
  body.push(0x20); wasm_push_u32(body, 11)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x71)
  body.push(0x21); wasm_push_u32(body, 11)
  // ev (10) = i64.load(p + (bit << 3)); if (ev != 0L)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74)
  body.push(0x6A)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 10)
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52) // i64.ne
  body.push(0x04); body.push(0x40) // if (ev != 0L) [depth 5]
  // if (tail_next != 0L): release previous non-last child with inline rc_dec + leaf Slab recycle
  body.push(0x20); wasm_push_u32(body, 12)
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40) // if (tail_next != 0L) [depth 6]
  body.push(0x20); wasm_push_u32(body, 12); body.push(0xA7)
  body.push(0x41); wasm_push_s32(body, 24); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 13) // thdr
  body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 14)
  body.push(0x22); wasm_push_u32(body, 14) // tflags
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x71); body.push(0x45) // (tflags & FLAG_IMMORTAL) == 0
  body.push(0x04); body.push(0x40) // if (not immortal) [depth 7]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // owner_tid
  body.push(0x04); body.push(0x40) // if (owner_tid != 0) [depth 8]
  body.push(0x20); wasm_push_u32(body, 13)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 15) // trc
  body.push(0x36); wasm_push_u32(body, 2); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x45) // if (trc == 0)
  body.push(0x04); body.push(0x40) // [depth 9]
  // Inline leaf Slab recycle if (tflags & 0x10) != 0 && drop_fn == 0 && ttag in {1, 4, 5}
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 0x10); body.push(0x71)
  body.push(0x04); body.push(0x40) // [depth 10]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x50) // drop_fn == 0L
  body.push(0x04); body.push(0x40) // [depth 11]
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x2F); wasm_push_u32(body, 1); wasm_push_u32(body, 12)
  body.push(0x22); wasm_push_u32(body, 15) // ttag
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46); body.push(0x72)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 5); body.push(0x46); body.push(0x72)
  body.push(0x04); body.push(0x40) // [depth 12]
  // base (9) = thdr - 8; tslot (16) = global.get 2 + (((tflags >> 8) & 15) << 2)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 9)
  body.push(0x23); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 8); body.push(0x76)
  body.push(0x41); wasm_push_s32(body, 15); body.push(0x71)
  body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 16)
