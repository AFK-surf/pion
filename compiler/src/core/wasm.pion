///|
/// Pure-Wasm internal `pion_str_slice(s: i64, start: i64, end: i64) -> i64`.
fn wasm_build_str_slice_body(alloc_uninit_idx : Int) -> Array[Int] {
  // 3 i32 locals (3=ps, 4=n, 5=dst) + 4 i64 locals (6=len, 7=a, 8=b, 9=res)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x04, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // ps
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x21); wasm_push_u32(body, 6) // len
  // a = start < 0 ? 0 : start
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x53)
  body.push(0x04); body.push(0x7E)
