  body.push(0x20); wasm_push_u32(body, 13); body.push(0x20); wasm_push_u32(body, 12); body.push(0x7D)
  body.push(0xA7); body.push(0x21); wasm_push_u32(body, 4) // n
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 12); body.push(0xA7); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 6) // src
