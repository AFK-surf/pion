///|
/// Pure-Wasm internal `pion_rc_dec_slow(obj: i64) -> void` fast path.
/// Handles String/Bytes/Array/Struct/Enum/Closure/Map/StrBuf (tags 1..7, 11) natively:
/// runs drop_fn via `call_indirect`, recursively rc_dec's Array/Map elements in Wasm,
/// and recycles buffers & headers via `__pion_raw_free_slab` with zero JS boundary crossings
/// (falling back to JS `pion_rc_dec_slow` only once for >512B non-top backing buffers).
///|
/// P73: Thin depth-bounded wrapper around `__pion_rc_dec_slow_inner`.
/// Shares `drop_depth` (`slab_ctl + 80`) and `defer_pending` (`slab_ctl + 84`) with JS runtime:
/// when `d >= 64`, defers `obj` to JS `pion_rc_dec_slow(obj)` and unwinds immediately;
/// when outermost `d == 0` finishes with `defer_pending != 0`, triggers JS `pion_rc_dec_slow(0L)` drain.
fn wasm_build_rc_dec_slow_entry_body(
  slow_imp_idx : Int,
  inner_idx : Int,
) -> Array[Int] {
  let body : Array[Int] = [0x01, 0x01, 0x7F] // 1 local: d (i32)
  // if (obj == 0L) return
  body.push(0x20); wasm_push_u32(body, 0)
  body.push(0x50) // i64.eqz
  body.push(0x04); body.push(0x40)
  body.push(0x0F)
