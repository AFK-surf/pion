}

///|
/// Pure-Wasm internal `pion_strbuf_push_str(sb: i64, s: i64) -> void` (non-grow fast path).
fn wasm_build_strbuf_push_str_body(slow_imp_idx : Int) -> Array[Int] {
  // 2 i32 locals (2=p, 3=ps) + 3 i64 locals (4=len, 5=slen, 6=new_len)
  let body : Array[Int] = [0x02, 0x02, 0x7F, 0x03, 0x7E]
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // ps
  body.push(0x45)
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 5); body.push(0x50) // slen == 0
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2) // p
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 4) // len
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x7C); body.push(0x22); wasm_push_u32(body, 6) // new_len
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap
  body.push(0x55) // i64.gt_s (new_len > cap)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // memory.copy(dp + len, ps + 8, slen)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0xA7)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_strbuf_push_int(sb: i64, v: i64) -> void` (32B shadow stack + non-grow fast path).
fn wasm_build_strbuf_push_int_body(slow_imp_idx : Int) -> Array[Int] {
  // 5 i32 locals (2=sp, 3=pos, 4=neg, 5=n, 6=p) + 3 i64 locals (7=u, 8=len, 9=new_len)
  let body : Array[Int] = [0x02, 0x05, 0x7F, 0x03, 0x7E]
