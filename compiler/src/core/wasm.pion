  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 11)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 13) // b
