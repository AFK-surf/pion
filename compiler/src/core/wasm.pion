  body.push(0x20); wasm_push_u32(body, 7); body.push(0x50)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 48)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x50)
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x42); wasm_push_s64(body, 10L); body.push(0x82)
  body.push(0xA7); body.push(0x41); wasm_push_s32(body, 48); body.push(0x6A)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x42); wasm_push_s64(body, 10L); body.push(0x80)
  body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  // if (neg != 0) { pos -= 1; store8(pos, '-') }
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 45)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x0B)
  // n = (sp + 32) - pos
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 5) // n
  // new_len = len + i64.extend_i32_u(n)
  body.push(0xAD)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 8) // len
  body.push(0x7C); body.push(0x22); wasm_push_u32(body, 9) // new_len
  // if (new_len > cap) { restore sp; call slow_imp(sb, v); return }
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x55) // i64.gt_s
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A)
  body.push(0x24); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
