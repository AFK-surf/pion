  body.push(0x20); wasm_push_u32(body, 8); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A)
  body.push(0x24); wasm_push_u32(body, 0)
  body.push(0x0B)
