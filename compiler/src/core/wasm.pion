///|
/// Pure-Wasm internal `pion_arr_push(a: i64, v: i64)` / `pion_arr_push_owned(a: i64, v: i64)`.
/// Pass `rc_inc_idx >= 0` for `pion_arr_push`, `< 0` for `pion_arr_push_owned`.
/// P49-A: handles initial `cap == 0` Slab allocation (`new_cap = 8`, cls=3/96B or cls=0/32B) in pure Wasm.
fn wasm_build_arr_push_body(slow_imp_idx : Int, rc_inc_idx : Int) -> Array[Int] {
  // 8 i32 locals (2=p, 3=dp, 4=stride, 5=ctl, 6=base, 7=alloc_sz, 8=slot, 9=new_hp) + 2 i64 locals (10=len, 11=cap)
