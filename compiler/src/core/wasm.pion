  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0xA7)
  body.push(0x21); wasm_push_u32(body, 5)
  body.push(0x0B)
  // m = la < lb ? la : lb
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 5); body.push(0x49)
  body.push(0x04); body.push(0x7F)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 5)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 6)
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x20); wasm_push_u32(body, 6); body.push(0x4F)
  body.push(0x0D); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 7); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8); body.push(0x22); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 7); body.push(0x6A)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 8); body.push(0x22); wasm_push_u32(body, 9)
  body.push(0x47)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x20); wasm_push_u32(body, 9); body.push(0x49)
  body.push(0x04); body.push(0x7F)
  body.push(0x41); wasm_push_s32(body, -1)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 1)
  body.push(0x0B)
  body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 5); body.push(0x49)
  body.push(0x04); body.push(0x40); body.push(0x41); wasm_push_s32(body, -1); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 5); body.push(0x4B)
