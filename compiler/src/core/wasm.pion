  body.push(0x37); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x20); wasm_push_u32(body, 4); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x20); wasm_push_u32(body, 4); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x29); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x37); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x20); wasm_push_u32(body, 4); body.push(0x6A)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A); body.push(0xAD)
