  body.push(0x04); body.push(0x7F)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 4); body.push(0x6A)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x0B)
  body.push(0x22); wasm_push_u32(body, 10) // slot
