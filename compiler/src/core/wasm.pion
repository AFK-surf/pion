  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 10) // len
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
