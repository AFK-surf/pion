  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B) // end if (len >= cap)
  if rc_inc_idx >= 0 {
    body.push(0x20); wasm_push_u32(body, 2); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
    body.push(0x04); body.push(0x40)
    body.push(0x20); wasm_push_u32(body, 1); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
    body.push(0x04); body.push(0x40)
    body.push(0x20); wasm_push_u32(body, 1); body.push(0x10); wasm_push_u32(body, rc_inc_idx)
    body.push(0x0B)
    body.push(0x0B)
  }
  // dp = i32.wrap_i64(p.data)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x21); wasm_push_u32(body, 3) // dp
  // if (p.elem_stride == 1) { dp[len] = (u8)v } else if (p.elem_stride == 4) { dp[len*4] = (u32)v } else { dp[len*8] = v }
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x22); wasm_push_u32(body, 4) // stride
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x3C); wasm_push_u32(body, 0); wasm_push_u32(body, 0) // i64.store8
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x3E); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i64.store32
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i64.store
  body.push(0x0B)
  body.push(0x0B)
  // len += 1
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x42); wasm_push_s64(body, 1L); body.push(0x7C)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_arr_set(a: i64, idx: i64, v: i64) -> void` (self-assignment safe).
fn wasm_build_arr_set_body(
  panic_oob_idx : Int,
  rc_inc_idx : Int,
  rc_dec_idx : Int,
) -> Array[Int] {
  // 3 i32 locals (3=p, 4=elem_is_obj, 5=off) + 2 i64 locals (6=len, 7=old_v)
  let body : Array[Int] = [0x02, 0x03, 0x7F, 0x02, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // p
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x21); wasm_push_u32(body, 6) // len
  // if (i64.ge_u(idx, len)) panic_oob(idx, len)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x20); wasm_push_u32(body, 6); body.push(0x5A) // i64.ge_u
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x10); wasm_push_u32(body, panic_oob_idx)
  body.push(0x0F)
  body.push(0x0B)
  // if (p.elem_stride == 1) { dp[idx] = (u8)v; return }
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x22); wasm_push_u32(body, 4) // stride (reuses local 4 before elem_is_obj)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x3C); wasm_push_u32(body, 0); wasm_push_u32(body, 0) // i64.store8
  body.push(0x0F)
  body.push(0x0B)
  // if (p.elem_stride == 4) { dp[idx*4] = (u32)v; return }
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x41); wasm_push_s32(body, 4); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x3E); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i64.store32
  body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 16)
  body.push(0x21); wasm_push_u32(body, 4) // elem_is_obj
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x22); wasm_push_u32(body, 5) // off
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x21); wasm_push_u32(body, 7) // old_v
  // rc_inc(v) before store & dec
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x10); wasm_push_u32(body, rc_inc_idx)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x52)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x10); wasm_push_u32(body, rc_dec_idx)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_arr_pop(a: i64) -> i64`.
fn wasm_build_arr_pop_body(panic_oob_idx : Int) -> Array[Int] {
  // 1 i32 local (1=p) + 2 i64 locals (2=len, 3=val)
  let body : Array[Int] = [0x02, 0x01, 0x7F, 0x02, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 1) // p
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 2) // len
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x57) // i64.le_s
  body.push(0x04); body.push(0x40)
  body.push(0x42); wasm_push_s64(body, -1L); body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x10); wasm_push_u32(body, panic_oob_idx)
  body.push(0x42); wasm_push_s64(body, 0L); body.push(0x0F)
  body.push(0x0B)
  // len = len - 1
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x42); wasm_push_s64(body, 1L); body.push(0x7D)
  body.push(0x21); wasm_push_u32(body, 2)
  // val = (p.elem_stride == 1) ? (u64)dp[len] : (p.elem_stride == 4) ? (u64)dp[len*4] : dp[len*8]
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0xA7); body.push(0x6A)
  body.push(0x31); wasm_push_u32(body, 0); wasm_push_u32(body, 0) // i64.load8_u
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x28); wasm_push_u32(body, 2); wasm_push_u32(body, 20)
  body.push(0x41); wasm_push_s32(body, 4); body.push(0x46)
  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 2); body.push(0x74); body.push(0x6A)
  body.push(0x35); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i64.load32_u
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 24); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 3); body.push(0x74); body.push(0x6A)
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0) // i64.load
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 3)
  // store new len
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_strbuf_push_byte(sb: i64, b: i32) -> void` (non-grow fast path).
fn wasm_build_strbuf_push_byte_body(slow_imp_idx : Int, ascii_guard : Bool) -> Array[Int] {
  // 1 i32 local (2=p) + 1 i64 local (3=len)
  let body : Array[Int] = [0x02, 0x01, 0x7F, 0x01, 0x7E]
  if ascii_guard {
    // if (i32.ge_u(cp, 0x80)) -> JS slow path (UTF-8 multi-byte)
    body.push(0x20); wasm_push_u32(body, 1); body.push(0x41); wasm_push_s32(body, 128); body.push(0x4F)
    body.push(0x04); body.push(0x40)
    body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
    body.push(0x10); wasm_push_u32(body, slow_imp_idx)
    body.push(0x0F)
    body.push(0x0B)
  }
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2) // p
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 3) // len
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap
  body.push(0x59) // len >= cap
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0xA7); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x42); wasm_push_s64(body, 1L); body.push(0x7C)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// P49-A: Shared fixed-width overlapping copy for `n <= 16` (zero `memory.copy` builtin stub),
/// falling back to `memory.copy` for `n > 16`. All three locals are `i32`.
fn wasm_emit_copy_short_or_bulk(
  body : Array[Int],
  dst_l : Int,
  src_l : Int,
  n_l : Int,
) -> Unit {
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0x41); wasm_push_s32(body, 16)
  body.push(0x4D) // i32.le_u(n, 16)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0x41); wasm_push_s32(body, 8)
  body.push(0x4F) // i32.ge_u(n, 8)
  body.push(0x04); body.push(0x40)
  // 8..16 bytes: two overlapping i64 load/store
  body.push(0x20); wasm_push_u32(body, dst_l)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x29); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x37); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, dst_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6B)
  body.push(0x29); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x37); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0x41); wasm_push_s32(body, 4)
  body.push(0x4F) // i32.ge_u(n, 4)
  body.push(0x04); body.push(0x40)
  // 4..7 bytes: two overlapping i32 load/store
  body.push(0x20); wasm_push_u32(body, dst_l)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x28); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, dst_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 4); body.push(0x6B)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 4); body.push(0x6B)
  body.push(0x28); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x36); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0x41); wasm_push_s32(body, 2)
  body.push(0x4F) // i32.ge_u(n, 2)
  body.push(0x04); body.push(0x40)
  // 2..3 bytes: i16 + overlapping last i8
  body.push(0x20); wasm_push_u32(body, dst_l)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x2F); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x3B); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, dst_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x20); wasm_push_u32(body, n_l); body.push(0x6A); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0x04); body.push(0x40)
  // 1 byte
  body.push(0x20); wasm_push_u32(body, dst_l)
  body.push(0x20); wasm_push_u32(body, src_l); body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x05)
  // n > 16: bulk memory.copy
  body.push(0x20); wasm_push_u32(body, dst_l)
  body.push(0x20); wasm_push_u32(body, src_l)
  body.push(0x20); wasm_push_u32(body, n_l)
  body.push(0xFC); wasm_push_u32(body, 10); body.push(0x00); body.push(0x00)
  body.push(0x0B)
}

///|
/// Pure-Wasm internal `pion_strbuf_push_str(sb: i64, s: i64) -> void` (non-grow fast path, zero memory.copy for <= 16B).
fn wasm_build_strbuf_push_str_body(slow_imp_idx : Int) -> Array[Int] {
  // 5 i32 locals (2=p, 3=ps, 4=dst, 5=src, 6=n32) + 3 i64 locals (7=len, 8=slen, 9=new_len)
  let body : Array[Int] = [0x02, 0x05, 0x7F, 0x03, 0x7E]
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 3) // ps
  body.push(0x45)
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 8); body.push(0x50) // slen == 0
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 2) // p
  body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0); body.push(0x22); wasm_push_u32(body, 7) // len
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x7C); body.push(0x22); wasm_push_u32(body, 9) // new_len
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap
  body.push(0x55) // i64.gt_s (new_len > cap)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // dst = dp + len; src = ps + 8; n32 = i32.wrap_i64(slen)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0xA7); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 4) // dst
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 5) // src
  body.push(0x20); wasm_push_u32(body, 8); body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 6) // n32
  // P56-A: 1-byte fast path (covers "\"" and "," in JSON serialization without 4-branch cascade)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x46)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x2D); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  wasm_emit_copy_short_or_bulk(body, 4, 5, 6)
  body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// Pure-Wasm internal `pion_strbuf_push_slice(sb: i64, s: i64, start: i64, end: i64) -> void` (non-grow fast path).
fn wasm_build_strbuf_push_slice_body(slow_imp_idx : Int) -> Array[Int] {
  // 5 i32 locals (4=p, 5=ps, 6=dst, 7=src, 8=n32) + 6 i64 locals (9=slen, 10=a, 11=b, 12=n, 13=len, 14=new_len)
  let body : Array[Int] = [0x02, 0x05, 0x7F, 0x06, 0x7E]
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 4) // p
  body.push(0x45)
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 5) // ps
  body.push(0x45)
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x21); wasm_push_u32(body, 9) // slen
  // a = start < 0 ? 0 : start
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x42); wasm_push_s64(body, 0L); body.push(0x53)
  body.push(0x04); body.push(0x7E)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 2)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 10) // a
  // b = end > slen ? slen : end
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x20); wasm_push_u32(body, 9); body.push(0x55)
  body.push(0x04); body.push(0x7E)
  body.push(0x20); wasm_push_u32(body, 9)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x0B)
  body.push(0x21); wasm_push_u32(body, 11) // b
  // if (a >= b) return
  body.push(0x20); wasm_push_u32(body, 10); body.push(0x20); wasm_push_u32(body, 11); body.push(0x59) // i64.ge_s
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  // n = b - a
  body.push(0x20); wasm_push_u32(body, 11); body.push(0x20); wasm_push_u32(body, 10); body.push(0x7D)
  body.push(0x22); wasm_push_u32(body, 12) // n
  // len = p.len; new_len = len + n
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 13) // len
  body.push(0x7C); body.push(0x22); wasm_push_u32(body, 14) // new_len
  // if (new_len > cap) -> slow_imp(sb, s, start, end)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8)
  body.push(0x55) // i64.gt_s
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 0); body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x20); wasm_push_u32(body, 3)
  body.push(0x10); wasm_push_u32(body, slow_imp_idx)
  body.push(0x0F)
  body.push(0x0B)
  // dst = dp + len; src = ps + 8 + a; n32 = i32.wrap_i64(n)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0xA7); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 6) // dst
  body.push(0x20); wasm_push_u32(body, 5); body.push(0x41); wasm_push_s32(body, 8); body.push(0x6A)
  body.push(0x20); wasm_push_u32(body, 10); body.push(0xA7); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 7) // src
  body.push(0x20); wasm_push_u32(body, 12); body.push(0xA7)
  body.push(0x21); wasm_push_u32(body, 8) // n32
  wasm_emit_copy_short_or_bulk(body, 6, 7, 8)
  body.push(0x20); wasm_push_u32(body, 4); body.push(0x20); wasm_push_u32(body, 14)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0B)
  body
}

///|
/// Emit division-free 2-digit ASCII store: `i32.store16(dst + offset, two_ascii(val))` for `0 <= val <= 99`.
/// Uses `d1 = (val * 205) >>> 11; d0 = val - d1 * 10; (d1 | (d0 << 8)) + 0x3030`.
fn wasm_emit_store_2digits(
  body : Array[Int],
  dst_local : Int,
  offset : Int,
  val_local : Int,
  d1_local : Int,
) -> Unit {
  // d1 = (val * 205) >>> 11
  body.push(0x20); wasm_push_u32(body, val_local)
  body.push(0x41); wasm_push_s32(body, 205); body.push(0x6C)
  body.push(0x41); wasm_push_s32(body, 11); body.push(0x76)
  body.push(0x21); wasm_push_u32(body, d1_local)
  // i32.store16(dst + offset, (d1 | ((val - d1 * 10) << 8)) + 0x3030)
  body.push(0x20); wasm_push_u32(body, dst_local)
  body.push(0x20); wasm_push_u32(body, d1_local)
  body.push(0x20); wasm_push_u32(body, val_local)
  body.push(0x20); wasm_push_u32(body, d1_local)
  body.push(0x41); wasm_push_s32(body, 10); body.push(0x6C); body.push(0x6B)
  body.push(0x41); wasm_push_s32(body, 8); body.push(0x74)
  body.push(0x72) // i32.or
  body.push(0x41); wasm_push_s32(body, 12336); body.push(0x6A) // + 0x3030
  body.push(0x3B); wasm_push_u32(body, 0); wasm_push_u32(body, offset) // i32.store16 align=0
}

///|
/// Pure-Wasm internal `pion_strbuf_push_int(sb: i64, v: i64) -> void`.
/// P63-A: Unified zero-shadow-stack 2-digit magic direct write for `0 <= v < 100_000_000` (1–8 digits,
/// `len + 8 <= cap`) via `hi = (v * 219902326L) >>> 41`, `lo = v - hi * 10000`, `x = select(hi, lo, hi)`,
/// plus 2-digit `/100` magic loop for general `<= 32-bit` values.
fn wasm_build_strbuf_push_int_body(slow_imp_idx : Int) -> Array[Int] {
  // 6 i32 locals (2=sp/data, 3=pos/r1, 4=neg, 5=n, 6=p, 7=dst)
  // + 4 i64 locals (8=u, 9=len, 10=new_len, 11=q)
  // + 5 i32 locals (12=hi, 13=lo, 14=x, 15=q1, 16=d1)
  let body : Array[Int] = [0x03, 0x06, 0x7F, 0x04, 0x7E, 0x05, 0x7F]
  // p = i32.wrap_i64(sb); if (p == 0) return
  body.push(0x20); wasm_push_u32(body, 0); body.push(0xA7); body.push(0x22); wasm_push_u32(body, 6)
  body.push(0x45)
  body.push(0x04); body.push(0x40); body.push(0x0F); body.push(0x0B)
  // P63-A unified 1–8 digit fast path: if (i64.lt_u(v, 100000000L)) && (len + 8L <= cap)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x42); wasm_push_s64(body, 100000000L)
  body.push(0x54) // i64.lt_u (false for all negative v and v >= 100000000)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x22); wasm_push_u32(body, 9) // len
  body.push(0x42); wasm_push_s64(body, 8L); body.push(0x7C) // len + 8
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 8) // cap
  body.push(0x57) // i64.le_s
  body.push(0x04); body.push(0x40)
  // data (2) = i32(i64[p+16]); dst (7) = data + i32(len)
  body.push(0x20); wasm_push_u32(body, 6); body.push(0x29); wasm_push_u32(body, 2); wasm_push_u32(body, 16); body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 2)
  body.push(0x20); wasm_push_u32(body, 9); body.push(0xA7); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 7)
  // hi (12) = i32((v * 219902326L) >>> 41); lo (13) = i32(v) - hi * 10000; x (14) = select(hi, lo, hi)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x42); wasm_push_s64(body, 219902326L); body.push(0x7E)
  body.push(0x42); wasm_push_s64(body, 41L); body.push(0x88); body.push(0xA7)
  body.push(0x22); wasm_push_u32(body, 12) // leaves hi on stack
  body.push(0x20); wasm_push_u32(body, 1); body.push(0xA7)
  body.push(0x20); wasm_push_u32(body, 12); body.push(0x41); wasm_push_s32(body, 10000); body.push(0x6C); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 13) // leaves lo on stack
  body.push(0x20); wasm_push_u32(body, 12) // cond = hi
  body.push(0x1B) // i32.select(hi, lo, hi)
  body.push(0x22); wasm_push_u32(body, 14) // x (0..9999)
  // Single 1–4 digit writer for x, advancing dst (7)
  body.push(0x41); wasm_push_s32(body, 10); body.push(0x49) // x < 10
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 48); body.push(0x6A)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6A); body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x05)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 100); body.push(0x49) // x < 100
  body.push(0x04); body.push(0x40)
  wasm_emit_store_2digits(body, 7, 0, 14, 16)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 2); body.push(0x6A); body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x05)
  // q1 (15) = (x * 5243) >>> 19; r1 (3) = x - q1 * 100
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 5243); body.push(0x6C)
  body.push(0x41); wasm_push_s32(body, 19); body.push(0x76); body.push(0x21); wasm_push_u32(body, 15)
  body.push(0x20); wasm_push_u32(body, 14)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 100); body.push(0x6C); body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 14); body.push(0x41); wasm_push_s32(body, 1000); body.push(0x49) // x < 1000
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 7)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 48); body.push(0x6A)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  wasm_emit_store_2digits(body, 7, 1, 3, 16)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 3); body.push(0x6A); body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x05)
  wasm_emit_store_2digits(body, 7, 0, 15, 16)
  wasm_emit_store_2digits(body, 7, 2, 3, 16)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 4); body.push(0x6A); body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x0B)
  body.push(0x0B)
  body.push(0x0B)
  // if (hi != 0): unconditionally append 4-digit lo (0000..9999)
  body.push(0x20); wasm_push_u32(body, 12)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 13); body.push(0x41); wasm_push_s32(body, 5243); body.push(0x6C)
  body.push(0x41); wasm_push_s32(body, 19); body.push(0x76); body.push(0x21); wasm_push_u32(body, 15)
  body.push(0x20); wasm_push_u32(body, 13)
  body.push(0x20); wasm_push_u32(body, 15); body.push(0x41); wasm_push_s32(body, 100); body.push(0x6C); body.push(0x6B)
  body.push(0x21); wasm_push_u32(body, 3)
  wasm_emit_store_2digits(body, 7, 0, 15, 16)
  wasm_emit_store_2digits(body, 7, 2, 3, 16)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x41); wasm_push_s32(body, 4); body.push(0x6A); body.push(0x21); wasm_push_u32(body, 7)
  body.push(0x0B)
  // sb->len = i64.extend_i32_u(dst - data); return
  body.push(0x20); wasm_push_u32(body, 6)
  body.push(0x20); wasm_push_u32(body, 7); body.push(0x20); wasm_push_u32(body, 2); body.push(0x6B); body.push(0xAD)
  body.push(0x37); wasm_push_u32(body, 2); wasm_push_u32(body, 0)
  body.push(0x0F)
  body.push(0x0B)
  body.push(0x0B)
  // General path: sp = global.get 0 - 32; global.set 0 sp
  body.push(0x23); wasm_push_u32(body, 0)
  body.push(0x41); wasm_push_s32(body, 32)
  body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 2)
  body.push(0x24); wasm_push_u32(body, 0)
  // if (v < 0) { neg = 1; u = 0 - v } else { neg = 0; u = v }
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x53) // i64.lt_s
  body.push(0x04); body.push(0x40)
  body.push(0x41); wasm_push_s32(body, 1); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x42); wasm_push_s64(body, 0L)
  body.push(0x20); wasm_push_u32(body, 1)
  body.push(0x7D) // i64.sub
  body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x05)
  body.push(0x41); wasm_push_s32(body, 0); body.push(0x21); wasm_push_u32(body, 4)
  body.push(0x20); wasm_push_u32(body, 1); body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x0B)
  // pos = sp + 32
  body.push(0x20); wasm_push_u32(body, 2); body.push(0x41); wasm_push_s32(body, 32); body.push(0x6A)
  body.push(0x21); wasm_push_u32(body, 3)
  // if (u == 0) { pos -= 1; store8(pos, '0') } else { ... }
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x50)
  body.push(0x04); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x41); wasm_push_s32(body, 48)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  body.push(0x05)
  // P45-A: >32-bit loop (single i64.div_u per digit) until u <= 0xFFFFFFFFL
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8)
  body.push(0x42); wasm_push_s64(body, 4294967295L) // 0xFFFFFFFFL
  body.push(0x58) // i64.le_u
  body.push(0x0D); wasm_push_u32(body, 1)
  // q = i64.div_u(u, 10L)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 10L); body.push(0x80)
  body.push(0x21); wasm_push_u32(body, 11)
  // pos -= 1; store8(pos, i32.wrap_i64(u - q * 10L) + 48)
  body.push(0x20); wasm_push_u32(body, 3); body.push(0x41); wasm_push_s32(body, 1); body.push(0x6B)
  body.push(0x22); wasm_push_u32(body, 3)
  body.push(0x20); wasm_push_u32(body, 8)
  body.push(0x20); wasm_push_u32(body, 11); body.push(0x42); wasm_push_s64(body, 10L); body.push(0x7E)
  body.push(0x7D); body.push(0xA7); body.push(0x41); wasm_push_s32(body, 48); body.push(0x6A)
  body.push(0x3A); wasm_push_u32(body, 0); wasm_push_u32(body, 0)
  // u = q
  body.push(0x20); wasm_push_u32(body, 11); body.push(0x21); wasm_push_u32(body, 8)
  body.push(0x0C); wasm_push_u32(body, 0)
  body.push(0x0B)
  body.push(0x0B)
  // P61-A: <=32-bit 2-digit zero-division loop: q = (u * 1374389535L) >>> 37 (exact u/100 for [0, 2^32-1])
  body.push(0x02); body.push(0x40)
  body.push(0x03); body.push(0x40)
  body.push(0x20); wasm_push_u32(body, 8); body.push(0x42); wasm_push_s64(body, 100L); body.push(0x54) // i64.lt_u
  body.push(0x0D); wasm_push_u32(body, 1)
  // q = i64.shr_u(i64.mul(u, 1374389535L), 37L)
  body.push(0x20); wasm_push_u32(body, 8)
