///| Unit tests for `lex_with_spans`, `query_types.pion`, `types.pion` query-mode
///| recording/rollback/merging, and `llbc.pion` `for x in arr` entry-length hoisting.

///|
fn qt_test_run(src : String) -> (CheckedPackage, QtFileCollector, String) {
  let path = "test.pion"
  let cr = check_source_files_with_imports_types(
    "app",
    [path],
    [src],
    [],
    [],
    [],
    false,
    0,
    Map([]),
  )
  let col = qt_collect_file(cr.pkg.files[0], src, cr.tc)
  let json = query_types_response_json(cr.pkg, [src], [path], cr.tc, cr.diagnostics, 0, Map([]))
  (cr, col, json)
}

///|
fn qt_test_find_expr(col : QtFileCollector, src : String, want : String) -> Option[QtExprOut] {
  let mut i = 0
  while i < col.exprs.length() {
    let e = col.exprs[i]
    if slice_str(src, e.start_byte, e.end_byte) == want {
      return Some(e)
    }
    i = i + 1
  }
  None
}

///|
fn qt_test_find_call(col : QtFileCollector, src : String, want : String) -> Option[QtCallOut] {
  let mut i = 0
  while i < col.calls.length() {
    let cl = col.calls[i]
    if slice_str(src, cl.start_byte, cl.end_byte) == want {
      return Some(cl)
    }
    i = i + 1
  }
  None
}

///|
fn qt_test_find_bind(col : QtFileCollector, src : String, name : String, kind : String) -> Option[QtBindOut] {
  let mut i = 0
  while i < col.binds.length() {
    let b = col.binds[i]
    if b.rec.name == name && b.rec.bind_kind == kind && slice_str(src, b.start_byte, b.end_byte) == name {
      return Some(b)
    }
    i = i + 1
  }
  None
}

///|
fn qt_test_str_contains(hay : String, needle : String) -> Bool {
  let hl = hay.length()
  let nl = needle.length()
  if nl == 0 {
    return true
  }
  let mut i = 0
  while i + nl <= hl {
    let mut j = 0
    let mut ok = true
    while j < nl {
      if str_code_at(hay, i + j) != str_code_at(needle, j) {
        ok = false
        break
      }
      j = j + 1
    }
    if ok {
      return true
    }
    i = i + 1
  }
  false
}

///|
test "query_types: golden slices for unary, move, pipes, pub let, dot-variant, interp, for-in" {
  let src =
  "pub let TOP : Int = 42\n" +
  "struct Box { f : Int }\n" +
  "enum Tag { A, B(Int) }\n" +
  "fn inc(x : Int) -> Int { x + 1 }\n" +
  "fn add(a : Int, b : Int) -> Int { a + b }\n" +
  "fn demo(a : Array[Int], x : Box) -> Int {\n" +
  "  let u = -(a).length()\n" +
  "  let m = (move(x)).f\n" +
  "  let p1 = 1 |> (inc)\n" +
  "  let p2 = 1 |> (add(2))\n" +
  "  let t1 : Tag = .A\n" +
  "  let t2 : Tag = .B(7)\n" +
  "  let s = \"v=\\{u}\"\n" +
  "  let raw =\n" +
  "    #|hello\n" +
  "    #|world\n" +
  "  let mut sum = 0\n" +
  "  for idx, v in a {\n" +
  "    sum = sum + idx + v\n" +
  "  }\n" +
  "  let _ = (t1, t2, s, raw)\n" +
  "  u + m + p1 + p2 + sum\n" +
  "}\n"
  let (cr, col, _) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "expected zero diagnostics: " + check_result_to_json(cr.diagnostics))

  // `-(a).length()`
  match qt_test_find_expr(col, src, "-(a).length()") {
    Some(e) => {
      debug_assert(ty_to_string(e.rec.ty) == "Int", "unary neg slice type")
      debug_assert(e.op_byte == e.start_byte, "unary op_byte at `-`")
    }
    None => debug_assert(false, "missing slice `-(a).length()`")
  }
  // `move(x)` and `(move(x)).f`
  match qt_test_find_expr(col, src, "move(x)") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Box", "move(x) slice type")
    None => debug_assert(false, "missing slice `move(x)`")
  }
  match qt_test_find_expr(col, src, "(move(x)).f") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Int", "(move(x)).f slice type")
    None => debug_assert(false, "missing slice `(move(x)).f`")
  }
  // `1 |> (inc)`
  match qt_test_find_expr(col, src, "1 |> (inc)") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Int", "1 |> (inc) type")
    None => debug_assert(false, "missing slice `1 |> (inc)`")
  }
  // `1 |> (add(2))`
  match qt_test_find_expr(col, src, "1 |> (add(2))") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Int", "1 |> (add(2)) type")
    None => debug_assert(false, "missing slice `1 |> (add(2))`")
  }
  // `.A` vs `.B(7)`
  match qt_test_find_expr(col, src, ".A") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Tag", ".A type")
    None => debug_assert(false, "missing slice `.A`")
  }
  match qt_test_find_expr(col, src, ".B(7)") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Tag", ".B(7) type")
    None => debug_assert(false, "missing slice `.B(7)`")
  }
  // `pub let TOP` (`DConst`)
  match qt_test_find_bind(col, src, "TOP", "const") {
    Some(b) => debug_assert(ty_to_string(b.rec.ty) == "Int", "TOP const binding type")
    None => debug_assert(false, "missing TOP const binding")
  }
  // `for idx, v in a` bindings and `for_iter` role
  match qt_test_find_bind(col, src, "idx", "for_in_idx") {
    Some(b) => debug_assert(ty_to_string(b.rec.ty) == "Int", "for_in_idx type")
    None => debug_assert(false, "missing idx binding")
  }
  match qt_test_find_bind(col, src, "v", "for_in") {
    Some(b) => debug_assert(ty_to_string(b.rec.ty) == "Int", "for_in elem type")
    None => debug_assert(false, "missing v binding")
  }
  let mut saw_for_iter = false
  let mut saw_interp_hole = false
  let mut i = 0
  while i < col.exprs.length() {
    if col.exprs[i].role == "for_iter" && slice_str(src, col.exprs[i].start_byte, col.exprs[i].end_byte) == "a" {
      saw_for_iter = true
    }
    if col.exprs[i].role == "interp_hole" && slice_str(src, col.exprs[i].start_byte, col.exprs[i].end_byte) == "u" {
      saw_interp_hole = true
    }
    i = i + 1
  }
  debug_assert(saw_for_iter, "expected for_iter role on `a`")
  debug_assert(saw_interp_hole, "expected interp_hole role on `u`")
}

///|
test "query_types: lex_with_spans recovery for @pkg.name, ===, and incomplete paren" {
  let src1 = "fn f(a : Int, b : Int) -> Bool { a === b }"
  let ls1 = lex_with_spans("r.pion", src1)
  let mut saw_strict = false
  let mut i = 0
  while i < ls1.tokens.length() {
    if slice_str(src1, ls1.starts[i], ls1.ends[i]) == "===" {
      saw_strict = true
    }
    i = i + 1
  }
  debug_assert(saw_strict, "expected 3-byte physical span for `===`")

  let src2 = "let _ = @foo.bar"
  let ls2 = lex_with_spans("r2.pion", src2)
  let mut saw_foo = false
  let mut saw_dot = false
  let mut saw_bar = false
  i = 0
  while i < ls2.tokens.length() {
    let sl = slice_str(src2, ls2.starts[i], ls2.ends[i])
    if sl == "foo" { saw_foo = true }
    if sl == "." { saw_dot = true }
    if sl == "bar" { saw_bar = true }
    i = i + 1
  }
  debug_assert(saw_foo && saw_dot && saw_bar, "expected individual physical sub-ranges for `@foo.bar`")

  // Incomplete syntax (missing `)`) must not crash or out-of-bounds
  let src3 = "fn f(x : Int) -> Int { (x + 1 }"
  let (_, col3, json3) = qt_test_run(src3)
  debug_assert(col3.exprs.length() > 0 && json3.length() > 0, "incomplete syntax exports safely")
}

///|
test "query_types: or-pattern swapped-arm order-independent ambiguity across all 3 tables" {
  let src_ab =
  #|enum E { A(Int), B(String) }
  #|fn g(e : E) -> String {
    #| match e {
      #| A(v) | B(v) => {
        #| let y = v
        #| y.to_string()
        #| }
      #| }
    #|}
  let src_ba =
  #|enum E { A(Int), B(String) }
  #|fn g(e : E) -> String {
    #| match e {
      #| B(v) | A(v) => {
        #| let y = v
        #| y.to_string()
        #| }
      #| }
    #|}
  let (_, col_ab, json_ab) = qt_test_run(src_ab)
  let (_, col_ba, json_ba) = qt_test_run(src_ba)
  // Swapping `A(v) | B(v)` <-> `B(v) | A(v)` must yield identical ambiguity & sorted candidates
  debug_assert(qt_test_str_contains(json_ab, "\"ambiguous\":true"), "expected ambiguous in A|B")
  debug_assert(qt_test_str_contains(json_ba, "\"ambiguous\":true"), "expected ambiguous in B|A")
  debug_assert(qt_test_str_contains(json_ab, "\"candidates\":[\"Int\",\"String\"]"), "sorted expr/bind candidates A|B")
  debug_assert(qt_test_str_contains(json_ba, "\"candidates\":[\"Int\",\"String\"]"), "sorted expr/bind candidates B|A")
  // Verify `let y = v` binding is marked ambiguous
  match qt_test_find_bind(col_ab, src_ab, "y", "let") {
    Some(b) => debug_assert(b.rec.ambiguous, "`let y = v` binding must be ambiguous")
    None => debug_assert(false, "missing `y` binding")
  }
  // Verify `y.to_string()` call is marked ambiguous
  match qt_test_find_call(col_ab, src_ab, "y.to_string()") {
    Some(cl) => debug_assert(cl.rec.ambiguous && cl.rec.kind == "ambiguous", "call must be ambiguous")
    None => debug_assert(false, "missing `y.to_string()` call")
  }
  // Verify `y` binding candidates match in both orders
  match qt_test_find_bind(col_ba, src_ba, "y", "let") {
    Some(b) => debug_assert(b.rec.ambiguous, "`let y = v` binding must be ambiguous in B|A")
    None => debug_assert(false, "missing `y` binding in B|A")
  }
}

///|
test "query_types: 2-pass generic method inference has no false ambiguity" {
  let src =
  #|struct Box[T] { v : T }
  #|fn Box::apply[T, U](self : Box[T], f : (T) -> U) -> U { f(self.v) }
  #|fn run() -> Int {
    #| let b = Box::{ v: 10 }
    #| b.apply(fn(x) { x + 1 })
    #|}
  let (cr, col, json) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "no diagnostics: " + check_result_to_json(cr.diagnostics))
  debug_assert(!qt_test_str_contains(json, "\"ambiguous\":true"), "2-pass generic method must NOT produce false ambiguous")
  match qt_test_find_call(col, src, "b.apply(fn(x) { x + 1 })") {
    Some(cl) => {
      debug_assert(cl.rec.kind == "pkg_method", "expected pkg_method")
      debug_assert(!cl.rec.ambiguous, "must not be ambiguous")
    }
    None => debug_assert(false, "missing b.apply call")
  }
}

///|
test "query_types: deferred let_infer and zero-side-effect error recovery" {
  let src =
  #|fn f() -> Array[Int] {
    #| let xs = []
    #| xs.push(1)
    #| xs
    #|}
  let (cr, col, _) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "no diags")
  match qt_test_find_bind(col, src, "xs", "let") {
    Some(b) => debug_assert(ty_to_string(b.rec.ty) == "Array[Int]", "deferred let_infer resolves xs to Array[Int]")
    None => debug_assert(false, "missing xs binding")
  }
  match qt_test_find_expr(col, src, "[]") {
    Some(e) => debug_assert(ty_to_string(e.rec.ty) == "Array[Int]", "deferred let_infer resolves [] to Array[Int]")
    None => debug_assert(false, "missing [] expr")
  }
  match qt_test_find_expr(col, src, "xs.push(1)") {
    Some(e) => {
      debug_assert(e.rec.has_receiver, "xs.push(1) has receiver_ty")
      debug_assert(ty_to_string(e.rec.receiver_ty) == "Array[Int]", "deferred let_infer resolves xs.push(1) receiver_ty to Array[Int]")
    }
    None => debug_assert(false, "missing xs.push(1) expr")
  }
  match qt_test_find_call(col, src, "xs.push(1)") {
    Some(cl) => {
      debug_assert(cl.rec.kind == "builtin", "xs.push(1) is builtin")
      debug_assert(
        cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Int",
        "xs.push(1) records param_tys:[Int]",
      )
    }
    None => debug_assert(false, "missing xs.push(1) call")
  }
  // Verify the `xs` reference inside `xs.push(1)` (before refinement finished) also refined to Array[Int]
  let mut saw_xs_ref = false
  let mut ei = 0
  while ei < col.exprs.length() {
    let e = col.exprs[ei]
    if slice_str(src, e.start_byte, e.end_byte) == "xs" {
      saw_xs_ref = true
      debug_assert(ty_to_string(e.rec.ty) == "Array[Int]", "all xs refs resolve to Array[Int]")
    }
    ei = ei + 1
  }
  debug_assert(saw_xs_ref, "found xs ref exprs")

  // Zero-side-effect error recovery: unknown method preserves receiver_ty and matches non-recording diagnostics
  let err_src =
  #|struct S { v : Int }
  #|fn bad(s : S) -> Int {
    #| let _ = s.nope(123)
    #| s.v
    #|}
  let cr_off = check_source_files_with_imports_mapped("app", ["e.pion"], [err_src], [], [], [], false, false)
  let cr_on = check_source_files_with_imports_types("app", ["e.pion"], [err_src], [], [], [], false, 0, Map([]))
  debug_assert(
    check_result_to_json(cr_off.diagnostics) == check_result_to_json(cr_on.diagnostics),
    "diagnostics with record_types ON must be byte-identical to OFF",
  )
  let col_err = qt_collect_file(cr_on.pkg.files[0], err_src, cr_on.tc)
  match qt_test_find_expr(col_err, err_src, "s.nope(123)") {
    Some(e) => {
      debug_assert(e.rec.has_receiver, "unknown method must preserve receiver_ty")
      debug_assert(ty_to_string(e.rec.receiver_ty) == "S", "receiver_ty must be S")
    }
    None => debug_assert(false, "missing s.nope(123) expr")
  }
  match qt_test_find_call(col_err, err_src, "s.nope(123)") {
    Some(cl) => debug_assert(cl.rec.kind == "unresolved", "unknown method must be unresolved, never builtin")
    None => debug_assert(false, "missing s.nope(123) call")
  }
}

///|
test "query_types: all 9+2 call_targets classifications" {
  let src =
  #|trait Show { fn show(self : Self) -> String }
  #|struct Obj { cb : (Int) -> Int }
  #|impl Show for Obj { fn show(self : Obj) -> String { "obj" } }
  #|fn Obj::ping(self : Obj) -> Int { 1 }
  #|fn helper(x : Int) -> Int { x }
  #|fn get_fn() -> (Int) -> Int { fn(n : Int) -> Int { n } }
  #|enum Color { Red(Int) }
  #|fn all_calls(o : Obj, fp : (Int) -> Int) -> Int {
    #| let fl = fn(n : Int) -> Int { n + 1 }
    #| let a = helper(1)
    #| let b = o.ping()
    #| let c = o.show()
    #| let d = [1].length()
    #| let e = Red(2)
    #| let f = fl(3)
    #| let g = fp(4)
    #| let h = o.cb(5)
    #| let k = (get_fn())(6)
    #| let _ = (c, e)
    #| a + b + d + f + g + h + k
    #|}
  let (cr, col, _) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "no diagnostics")
  match qt_test_find_call(col, src, "helper(1)") {
    Some(cl) => debug_assert(cl.rec.kind == "pkg_fn", "pkg_fn")
    None => debug_assert(false, "missing helper(1)")
  }
  match qt_test_find_call(col, src, "o.ping()") {
    Some(cl) => debug_assert(cl.rec.kind == "pkg_method", "pkg_method")
    None => debug_assert(false, "missing o.ping()")
  }
  match qt_test_find_call(col, src, "o.show()") {
    Some(cl) => debug_assert(cl.rec.kind == "trait_method", "trait_method")
    None => debug_assert(false, "missing o.show()")
  }
  match qt_test_find_call(col, src, "[1].length()") {
    Some(cl) => debug_assert(cl.rec.kind == "builtin", "builtin")
    None => debug_assert(false, "missing [1].length()")
  }
  match qt_test_find_call(col, src, "Red(2)") {
    Some(cl) => debug_assert(cl.rec.kind == "ctor", "ctor")
    None => debug_assert(false, "missing Red(2)")
  }
  match qt_test_find_call(col, src, "fl(3)") {
    Some(cl) => debug_assert(cl.rec.kind == "closure_local", "closure_local")
    None => debug_assert(false, "missing fl(3)")
  }
  match qt_test_find_call(col, src, "fp(4)") {
    Some(cl) => debug_assert(cl.rec.kind == "closure_param", "closure_param")
    None => debug_assert(false, "missing fp(4)")
  }
  match qt_test_find_call(col, src, "o.cb(5)") {
    Some(cl) => debug_assert(cl.rec.kind == "closure_field", "closure_field")
    None => debug_assert(false, "missing o.cb(5)")
  }
  match qt_test_find_call(col, src, "(get_fn())(6)") {
    Some(cl) => debug_assert(cl.rec.kind == "indirect", "indirect")
    None => debug_assert(false, "missing (get_fn())(6)")
  }
}

///|
test "query_types: per-file alias rendering, 3-segment static path, and target_canon" {
  let dep_src =
  #|pub struct Item { v : Int }
  #|pub fn Item::make() -> Item { Item::{ v: 1 } }
  #|pub fn make_top() -> Item { Item::{ v: 2 } }
  let dep_cr = check_source_files_with_imports_mapped("dep__7f7c505b", ["dep.pion"], [dep_src], [], [], [], true, false)
  debug_assert(dep_cr.diagnostics.length() == 0, "dep compiles: " + check_result_to_json(dep_cr.diagnostics))
  let imp = ImportedPkg::{ name: "dep__7f7c505b", tc: dep_cr.tc }
  let root_src = "import \"dep\" as d\nfn main() -> d::Item { let _ = d::make_top(); d::Item::make() }"
  let root_cr = check_source_files_with_imports_types(
    "root_pkg",
    ["main.pion"],
    [root_src],
    [imp],
    ["dep"],
    ["dep__7f7c505b"],
    true,
    0,
    Map([]),
  )
  debug_assert(root_cr.diagnostics.length() == 0, "root compiles: " + check_result_to_json(root_cr.diagnostics))
  let col = qt_collect_file(root_cr.pkg.files[0], root_src, root_cr.tc)
  match qt_test_find_expr(col, root_src, "d::Item::make") {
    Some(_) => ()
    None => debug_assert(false, "3-segment EPath callee span must cover full d::Item::make")
  }
  let json = query_types_response_json(root_cr.pkg, [root_src], ["main.pion"], root_cr.tc, root_cr.diagnostics, 0, Map([]))
  debug_assert(qt_test_str_contains(json, "\"ty\":\"d::Item\""), "display ty uses file alias d::Item")
  debug_assert(qt_test_str_contains(json, "\"ty_canon\":\"dep__7f7c505b::Item\""), "ty_canon emits canonical dep__7f7c505b::Item")
  debug_assert(qt_test_str_contains(json, "\"target\":\"d::Item::make\""), "target uses file alias d::Item::make")
  debug_assert(
    qt_test_str_contains(json, "\"target_canon\":\"dep__7f7c505b::Item::make\""),
    "target_canon emits canonical dep__7f7c505b::Item::make",
  )
}

///|
test "query_types: or-pattern callee determinism and ambiguous ty empty string" {
  let src_ab =
  #|enum E { A((Int) -> Int); B((String) -> Int) }
  #|fn g(e : E) -> Int {
    #| match e {
      #| A(f) | B(f) => f(1)
      #| }
    #|}
  let src_ba =
  #|enum E { A((Int) -> Int); B((String) -> Int) }
  #|fn g(e : E) -> Int {
    #| match e {
      #| B(f) | A(f) => f(1)
      #| }
    #|}
  let cr_ab = check_source_files_with_imports_types("app", ["m.pion"], [src_ab], [], [], [], false, 0, Map([]))
  let cr_ba = check_source_files_with_imports_types("app", ["m.pion"], [src_ba], [], [], [], false, 0, Map([]))
  let j_ab = query_types_response_json(cr_ab.pkg, [src_ab], ["m.pion"], cr_ab.tc, [], 0, Map([]))
  let j_ba = query_types_response_json(cr_ba.pkg, [src_ba], ["m.pion"], cr_ba.tc, [], 0, Map([]))
  let col_ab = qt_collect_file(cr_ab.pkg.files[0], src_ab, cr_ab.tc)
  let col_ba = qt_collect_file(cr_ba.pkg.files[0], src_ba, cr_ba.tc)
  // Callee `f` and call `f(1)` in the arm body must be identical regardless of arm order
  match (qt_test_find_expr(col_ab, src_ab, "f"), qt_test_find_expr(col_ba, src_ba, "f")) {
    (Some(ea), Some(eb)) => {
      debug_assert(ea.rec.ambiguous && eb.rec.ambiguous, "callee f is ambiguous in both orders")
      debug_assert(ea.start_byte == eb.start_byte && ea.end_byte == eb.end_byte, "callee f span identical")
    }
    _ => debug_assert(false, "missing callee f expr")
  }
  let cal_frag = "\"ty\":\"\",\"ambiguous\":true,\"candidates\":[\"(Int) -> Int\",\"(String) -> Int\"]"
  debug_assert(qt_test_str_contains(j_ab, cal_frag), "A|B ambiguous expr emits ty:\"\" and sorted candidates")
  debug_assert(qt_test_str_contains(j_ba, cal_frag), "B|A ambiguous expr emits ty:\"\" and sorted candidates")
  // Extract expr_tys + call_targets JSON prefix (before bindings, which differ only by pattern positions)
  let split_at = fn(s : String, needle : String) -> String {
    let n = s.length()
    let m = needle.length()
    let mut i = 0
    while i + m <= n {
      if slice_str(s, i, i + m) == needle {
        return slice_str(s, 0, i)
      }
      i = i + 1
    }
    s
  }
  debug_assert(
    split_at(j_ab, ",\"bindings\":") == split_at(j_ba, ",\"bindings\":"),
    "A(f) | B(f) and B(f) | A(f) must emit byte-identical expr_tys and call_targets JSON",
  )
}

///|
test "query_types: builtin free function io_println records exact param_tys" {
  let src =
  #|fn main(world : World) -> Unit {
    #| io_println(world, "hi")
    #|}
  let (cr, col, json) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "no diags")
  match qt_test_find_call(col, src, "io_println(world, \"hi\")") {
    Some(cl) => {
      debug_assert(cl.rec.kind == "builtin", "io_println is builtin")
      debug_assert(
        cl.rec.param_tys.length() == 2 &&
        ty_to_string(cl.rec.param_tys[0]) == "World" &&
        ty_to_string(cl.rec.param_tys[1]) == "String",
        "io_println records param_tys:[World, String]",
      )
    }
    None => debug_assert(false, "missing io_println call")
  }
  match qt_test_find_expr(col, src, "io_println") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "(World, String) -> Unit",
      "io_println callee expr has exact fn type, never () -> Unit",
    )
    None => debug_assert(false, "missing io_println callee expr")
  }
  debug_assert(!qt_test_str_contains(json, "\"() -> Unit\""), "must never fabricate () -> Unit for io_println")
}

///|
test "query_types: or-pattern builtin method [v].contains(v) is order-independent" {
  let src_ab =
  #|enum E { A(Int), B(String) }
  #|fn f(e : E) -> Bool {
    #| match e {
      #| A(v) | B(v) => [v].contains(v)
      #| }
    #|}
  let src_ba =
  #|enum E { A(Int), B(String) }
  #|fn f(e : E) -> Bool {
    #| match e {
      #| B(v) | A(v) => [v].contains(v)
      #| }
    #|}
  let (cr_ab, col_ab, j_ab) = qt_test_run(src_ab)
  let (cr_ba, col_ba, j_ba) = qt_test_run(src_ba)
  debug_assert(cr_ab.diagnostics.length() == 0 && cr_ba.diagnostics.length() == 0, "no diags")
  match qt_test_find_call(col_ab, src_ab, "[v].contains(v)") {
    Some(cl) => {
      debug_assert(cl.rec.ambiguous, "or-pattern builtin method must be ambiguous")
      debug_assert(cl.rec.candidates.length() == 2, "must have 2 candidates (Int and String)")
      debug_assert(
        cl.rec.candidates[0].param_tys.length() == 1 && cl.rec.candidates[1].param_tys.length() == 1,
        "neither candidate may drop param_tys",
      )
    }
    None => debug_assert(false, "missing [v].contains(v) call in A|B")
  }
  match qt_test_find_call(col_ba, src_ba, "[v].contains(v)") {
    Some(cl) => {
      debug_assert(cl.rec.ambiguous, "or-pattern builtin method must be ambiguous in B|A")
      debug_assert(cl.rec.candidates.length() == 2, "must have 2 candidates in B|A")
      debug_assert(
        cl.rec.candidates[0].param_tys.length() == 1 && cl.rec.candidates[1].param_tys.length() == 1,
        "neither candidate may drop param_tys in B|A",
      )
    }
    None => debug_assert(false, "missing [v].contains(v) call in B|A")
  }
  let split_at = fn(s : String, needle : String) -> String {
    let n = s.length()
    let m = needle.length()
    let mut i = 0
    while i + m <= n {
      if slice_str(s, i, i + m) == needle {
        return slice_str(s, 0, i)
      }
      i = i + 1
    }
    s
  }
  debug_assert(
    split_at(j_ab, ",\"bindings\":") == split_at(j_ba, ",\"bindings\":"),
    "A(v) | B(v) and B(v) | A(v) with [v].contains(v) must emit byte-identical expr_tys and call_targets",
  )
}

///|
test "query_types: builtin io_println wrong/missing args publish declared signature, never fabricated" {
  let src_wrong =
  #|fn main(world : World) -> Unit {
    #| io_println(world, 123)
    #|}
  let (cr_w, col_w, json_w) = qt_test_run(src_wrong)
  debug_assert(cr_w.diagnostics.length() > 0, "wrong arg emits type mismatch")
  match qt_test_find_call(col_w, src_wrong, "io_println(world, 123)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "World" &&
      ty_to_string(cl.rec.param_tys[1]) == "String",
      "io_println(world, 123) must publish declared [World, String]",
    )
    None => debug_assert(false, "missing io_println wrong-arg call")
  }
  match qt_test_find_expr(col_w, src_wrong, "io_println") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "(World, String) -> Unit",
      "io_println callee must be (World, String) -> Unit, never (World, Int) -> Unit",
    )
    None => debug_assert(false, "missing io_println callee expr")
  }
  debug_assert(!qt_test_str_contains(json_w, "(World, Int) -> Unit"), "must never fabricate (World, Int) -> Unit")

  let src_missing =
  #|fn main(world : World) -> Unit {
    #| io_println()
    #|}
  let (_, col_m, json_m) = qt_test_run(src_missing)
  match qt_test_find_call(col_m, src_missing, "io_println()") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "String",
      "io_println() inside World fn must publish declared [String]",
    )
    None => debug_assert(false, "missing io_println() call")
  }
  debug_assert(!qt_test_str_contains(json_m, "\"() -> Unit\""), "must never fabricate () -> Unit for io_println()")
}

///|
test "query_types: builtin constructors and methods publish declared param_tys on wrong/missing args" {
  let src =
  #|fn bad_builtins(xs : Array[Int], m : Map[String, Int]) -> Unit {
    #| let _ = StringBuilder::with_capacity("bad")
    #| let _ = AtomicInt::new("bad")
    #| xs.swap("bad", 0)
    #| m.set("x")
    #|}
  let (cr, col, json) = qt_test_run(src)
  let cr_plain = check_source_files("app", ["test.pion"], [src])
  debug_assert(cr.diagnostics.length() > 0, "all 4 bad calls emit diagnostics")
  debug_assert(
    diagnostics_array_to_json(cr.diagnostics) == diagnostics_array_to_json(cr_plain.diagnostics),
    "record_types on/off must emit byte-identical diagnostics",
  )
  match qt_test_find_call(col, src, "StringBuilder::with_capacity(\"bad\")") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Int",
      "StringBuilder::with_capacity must publish declared [Int]",
    )
    None => debug_assert(false, "missing StringBuilder::with_capacity call")
  }
  match qt_test_find_call(col, src, "AtomicInt::new(\"bad\")") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Int",
      "AtomicInt::new must publish declared [Int]",
    )
    None => debug_assert(false, "missing AtomicInt::new call")
  }
  match qt_test_find_call(col, src, "xs.swap(\"bad\", 0)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "Int" &&
      ty_to_string(cl.rec.param_tys[1]) == "Int",
      "Array::swap must publish declared [Int, Int]",
    )
    None => debug_assert(false, "missing xs.swap call")
  }
  match qt_test_find_call(col, src, "m.set(\"x\")") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "String" &&
      ty_to_string(cl.rec.param_tys[1]) == "Int",
      "Map::set with missing arg must still publish declared [String, Int]",
    )
    None => debug_assert(false, "missing m.set call")
  }
  debug_assert(!qt_test_str_contains(json, "(String) -> StringBuilder"), "must never fabricate (String) -> StringBuilder")
  debug_assert(!qt_test_str_contains(json, "(String) -> AtomicInt"), "must never fabricate (String) -> AtomicInt")
}

///|
test "query_types: aligned builtin sigs for write_byte, fs_mmap_ro, Bytes::new, panic, makei, RtPrim, Double::pow" {
  let src_ok =
  #|fn ok_cases(sb : StringBuilder, b : Byte, path : String, bs : Bytes) -> Unit {
    #| sb.write_byte(b)
    #| let _ = fs_mmap_ro(path)
    #| let _ = fs_write_atomic_bytes(path, bs)
    #| let _ = Bytes::new()
    #| let _ = Bytes::new(8)
    #|}
  let (cr_ok, col_ok, _) = qt_test_run(src_ok)
  debug_assert(cr_ok.diagnostics.length() == 0, "ok_cases has no diagnostics")
  match qt_test_find_call(col_ok, src_ok, "sb.write_byte(b)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Byte",
      "StringBuilder::write_byte must publish [Byte]",
    )
    None => debug_assert(false, "missing sb.write_byte call")
  }
  match qt_test_find_call(col_ok, src_ok, "fs_mmap_ro(path)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "String",
      "fs_mmap_ro in non-World fn must publish [String]",
    )
    None => debug_assert(false, "missing fs_mmap_ro call")
  }
  match qt_test_find_call(col_ok, src_ok, "fs_write_atomic_bytes(path, bs)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "String" &&
      ty_to_string(cl.rec.param_tys[1]) == "Bytes",
      "fs_write_atomic_bytes in non-World fn must publish [String, Bytes]",
    )
    None => debug_assert(false, "missing fs_write_atomic_bytes call")
  }
  match qt_test_find_call(col_ok, src_ok, "Bytes::new()") {
    Some(cl) => debug_assert(cl.rec.param_tys.length() == 0, "Bytes::new() must publish []")
    None => debug_assert(false, "missing Bytes::new() call")
  }
  match qt_test_find_expr(col_ok, src_ok, "Bytes::new") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "() -> Bytes",
      "Bytes::new() callee expr must be () -> Bytes",
    )
    None => debug_assert(false, "missing Bytes::new callee expr")
  }
  match qt_test_find_call(col_ok, src_ok, "Bytes::new(8)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Int",
      "Bytes::new(8) must publish [Int]",
    )
    None => debug_assert(false, "missing Bytes::new(8) call")
  }

  let src_panic =
  #|fn die() -> Never {
    #| panic()
    #|}
  let (_, _, json_panic) = qt_test_run(src_panic)
  debug_assert(
    !qt_test_str_contains(json_panic, "(String) -> Never"),
    "0-arg panic() must never fabricate (String) -> Never",
  )

  let src_makei =
  #|fn f() -> FixedArray[Int] {
    #| FixedArray::makei()
    #|}
  let (_, col_makei, json_makei) = qt_test_run(src_makei)
  match qt_test_find_call(col_makei, src_makei, "FixedArray::makei()") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "Int" &&
      ty_to_string(cl.rec.param_tys[1]) == "(Int) -> Int",
      "FixedArray::makei() must publish declared [Int, (Int) -> Int]",
    )
    None => debug_assert(false, "missing FixedArray::makei() call")
  }
  debug_assert(
    !qt_test_str_contains(json_makei, "() -> FixedArray[Int]"),
    "FixedArray::makei() must never fabricate () -> FixedArray[Int]",
  )

  let src_rt_pow =
  #|fn bad_rt_pow(x : Double) -> Unit {
    #| let _ = ptr_alloc("bad")
    #| let _ = x.pow("bad")
    #|}
  let (_, col_rp, _) = qt_test_run(src_rt_pow)
  match qt_test_find_call(col_rp, src_rt_pow, "ptr_alloc(\"bad\")") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Int64",
      "ptr_alloc(\"bad\") must publish RtPrim declared [Int64]",
    )
    None => debug_assert(false, "missing ptr_alloc call")
  }
  match qt_test_find_call(col_rp, src_rt_pow, "x.pow(\"bad\")") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 && ty_to_string(cl.rec.param_tys[0]) == "Double",
      "x.pow(\"bad\") must publish declared [Double]",
    )
    None => debug_assert(false, "missing x.pow call")
  }

  let src_nested_rt =
  #|fn size_fn() -> Int64 { 16L }
  #|fn alloc_nested() -> Ptr {
    #| ptr_alloc(size_fn())
    #|}
  let (cr_nr, col_nr, _) = qt_test_run(src_nested_rt)
  debug_assert(cr_nr.diagnostics.length() == 0, "nested ptr_alloc(size_fn()) has no diags")
  match qt_test_find_call(col_nr, src_nested_rt, "ptr_alloc(size_fn())") {
    Some(cl) =>
    debug_assert(
      !cl.rec.ambiguous &&
      cl.rec.param_tys.length() == 1 &&
      ty_to_string(cl.rec.param_tys[0]) == "Int64",
      "nested ptr_alloc(size_fn()) must have single non-ambiguous [Int64] target",
    )
    None => debug_assert(false, "missing nested ptr_alloc call")
  }
  match qt_test_find_expr(col_nr, src_nested_rt, "ptr_alloc") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "(Int64) -> Ptr",
      "nested ptr_alloc callee expr must be (Int64) -> Ptr",
    )
    None => debug_assert(false, "missing nested ptr_alloc callee expr")
  }
}

///|
test "query_types: dyn-coerced builtin ECall keeps concrete call_targets ret_ty and callee TFn" {
  let src =
  #|trait Mark {
    #| fn ok(self : Self) -> Bool
    #|}
  #|impl Mark for FixedArray[Int] {
    #| fn ok(self : FixedArray[Int]) -> Bool { true }
    #|}
  #|impl Mark for Bytes {
    #| fn ok(self : Bytes) -> Bool { true }
    #|}
  #|fn f() -> dyn Mark {
    #| FixedArray::makei(2, fn(i : Int) -> Int { i })
    #|}
  #|fn g() -> dyn Mark {
    #| Bytes::new(8)
    #|}
  let (cr, col, _) = qt_test_run(src)
  debug_assert(cr.diagnostics.length() == 0, "dyn-coerced builtins compile cleanly")
  let makei_src = "FixedArray::makei(2, fn(i : Int) -> Int { i })"
  match qt_test_find_expr(col, src, makei_src) {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "dyn Mark",
      "FixedArray::makei expr_tys must reflect dyn-coerced type dyn Mark",
    )
    None => debug_assert(false, "missing FixedArray::makei expr")
  }
  match qt_test_find_call(col, src, makei_src) {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 2 &&
      ty_to_string(cl.rec.param_tys[0]) == "Int" &&
      ty_to_string(cl.rec.param_tys[1]) == "(Int) -> Int" &&
      ty_to_string(cl.rec.ret_ty) == "FixedArray[Int]",
      "FixedArray::makei call_targets must keep concrete [Int, (Int) -> Int] -> FixedArray[Int]",
    )
    None => debug_assert(false, "missing FixedArray::makei call")
  }
  match qt_test_find_expr(col, src, "Bytes::new(8)") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "dyn Mark",
      "Bytes::new(8) expr_tys must reflect dyn-coerced type dyn Mark",
    )
    None => debug_assert(false, "missing Bytes::new(8) expr")
  }
  match qt_test_find_call(col, src, "Bytes::new(8)") {
    Some(cl) =>
    debug_assert(
      cl.rec.param_tys.length() == 1 &&
      ty_to_string(cl.rec.param_tys[0]) == "Int" &&
      ty_to_string(cl.rec.ret_ty) == "Bytes",
      "Bytes::new(8) call_targets must keep concrete [Int] -> Bytes",
    )
    None => debug_assert(false, "missing Bytes::new(8) call")
  }
  match qt_test_find_expr(col, src, "Bytes::new") {
    Some(e) =>
    debug_assert(
      ty_to_string(e.rec.ty) == "(Int) -> Bytes",
      "Bytes::new callee must be (Int) -> Bytes, never (Int) -> dyn Mark",
    )
    None => debug_assert(false, "missing Bytes::new callee expr")
  }
}

///|
test "llbc: for-in hoists Array.length before LSLoop" {
  let src =
  #|#verify
  #|fn sum_arr(a : Array[Int]) -> Int {
    #| let mut s = 0
    #| for x in a {
      #| s = s + x
      #| }
    #| s
    #|}
  let cr = check_source_files_full("app", ["v.pion"], [src])
  debug_assert(cr.diagnostics.length() == 0, "verify fn compiles cleanly")
  let lr = llbc_build([llbc_input_new("app", cr.pkg, cr.tc, true)])
  debug_assert(lr.diagnostics.length() == 0, "llbc lowers cleanly")
  debug_assert(lr.pkgs.length() == 1 && lr.pkgs[0].fns.length() == 1, "one lowered fn")
  let stmts = lr.pkgs[0].fns[0].body.stmts
  let mut len_idx = -1
  let mut loop_idx = -1
  let mut i = 0
  while i < stmts.length() {
    match stmts[i] {
      LSCall(_, _, CBuiltin(bn), _, _, _) =>
      if bn == "Pion.Array.length" && len_idx < 0 {
        len_idx = i
      }
      LSLoop(lbody) => {
        if loop_idx < 0 {
          loop_idx = i
        }
        // Ensure `Pion.Array.length` is NOT emitted inside LSLoop!
        let mut j = 0
        while j < lbody.stmts.length() {
          match lbody.stmts[j] {
            LSCall(_, _, CBuiltin(bn), _, _, _) =>
            debug_assert(bn != "Pion.Array.length", "Pion.Array.length must NOT be inside LSLoop")
            _ => ()
          }
          j = j + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
  debug_assert(len_idx >= 0 && loop_idx >= 0 && len_idx < loop_idx, "Array.length must be hoisted before LSLoop")
}
