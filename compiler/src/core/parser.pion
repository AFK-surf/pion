///|
pub struct ParseResult {
  file : SourceFile
  diagnostics : Array[Diagnostic]
}

///|
pub struct Parser {
  tokens : Array[Token]
  mut pos : Int
  diagnostics : Array[Diagnostic]
  jsx_parent_stack : Array[String]
  mut jsx_next_id : Int
  mut in_match_guard : Bool
  mut pending_gt : Bool
  mut pending_gt_span : Span
}

///|
fn parser_new(tokens : Array[Token], diags : Array[Diagnostic]) -> Parser {
  Parser::{
    tokens: tokens,
    pos: 0,
    diagnostics: diags,
    jsx_parent_stack: [],
    jsx_next_id: 0,
    in_match_guard: false,
    pending_gt: false,
    pending_gt_span: span_empty(),
  }
}

///|
fn p_peek(p : Parser) -> Token {
  if p.pos < p.tokens.length() {
    p.tokens[p.pos]
  } else {
    p.tokens[p.tokens.length() - 1]
  }
}

///|
fn p_peek_kind(p : Parser) -> TokenKind {
  if p.pos < p.tokens.length() {
    p.tokens[p.pos].kind
  } else {
    p.tokens[p.tokens.length() - 1].kind
  }
}

///|
fn p_peek_at(p : Parser, offset : Int) -> Token {
  let idx = p.pos + offset
  if idx >= 0 && idx < p.tokens.length() {
    p.tokens[idx]
  } else {
    p.tokens[p.tokens.length() - 1]
  }
}

///|
fn p_advance(p : Parser) -> Token {
  let tok = p_peek(p)
  if p.pos < p.tokens.length() - 1 {
    p.pos = p.pos + 1
  }
  tok
}

///|
fn p_is_eof(p : Parser) -> Bool {
  match p_peek_kind(p) {
    Eof => true
    _ => false
  }
}

///|
fn p_err(
  p : Parser,
  span : Span,
  msg : String,
  expected : String,
  found : String,
  fixit : String,
) -> Unit {
  p.diagnostics.push(diag_new(span, "E_PARSE", msg, expected, found, fixit))
}

///|
fn p_err_code(
  p : Parser,
  span : Span,
  code : String,
  msg : String,
  expected : String,
  found : String,
  fixit : String,
) -> Unit {
  p.diagnostics.push(diag_new(span, code, msg, expected, found, fixit))
}

///|
fn p_add_edit(p : Parser, edit : TextEdit) -> Unit {
  if p.diagnostics.length() > 0 && edit.line > 0 && edit.col > 0 {
    p.diagnostics[p.diagnostics.length() - 1].edits.push(edit)
  }
}

///|
fn p_skip_semis(p : Parser) -> Unit {
  while true {
    match p_peek_kind(p) {
      Semi => {
        let _ = p_advance(p)
      }
      _ => break
    }
  }
}

///|
fn p_sync_top(p : Parser) -> Unit {
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      KwPub | KwFn | KwStruct | KwEnum | KwVal | KwLet | KwType | KwImport | KwExtern | KwTrait | KwImpl =>
        break
      _ => {
        let _ = p_advance(p)
      }
    }
  }
}

///|
fn p_sync_stmt(p : Parser) -> Unit {
  while !p_is_eof(p) {
    let tok = p_peek(p)
    if tok.newline_before {
      break
    }
    match tok.kind {
      RBrace | Semi => break
      _ => {
        let _ = p_advance(p)
      }
    }
  }
}

///|
fn p_expect_ident(p : Parser, what : String) -> String {
  let tok = p_peek(p)
  match tok.kind {
    Ident(name) => {
      let _ = p_advance(p)
      name
    }
    _ => {
      p_err(
        p,
        tok.span,
        "expected " + what + ", found `" + tok.raw + "`",
        what,
        tok.raw,
        "provide a valid " + what,
      )
      "<error>"
    }
  }
}

///|
fn p_match_kind_lbrace(p : Parser) -> Bool {
  match p_peek_kind(p) {
    LBrace => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_rbrace(p : Parser) -> Bool {
  match p_peek_kind(p) {
    RBrace => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_lparen(p : Parser) -> Bool {
  match p_peek_kind(p) {
    LParen => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_rparen(p : Parser) -> Bool {
  match p_peek_kind(p) {
    RParen => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_lbracket(p : Parser) -> Bool {
  match p_peek_kind(p) {
    LBracket => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_rbracket(p : Parser) -> Bool {
  match p_peek_kind(p) {
    RBracket => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_comma(p : Parser) -> Bool {
  match p_peek_kind(p) {
    Comma => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_colon(p : Parser) -> Bool {
  match p_peek_kind(p) {
    Colon => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_coloncolon(p : Parser) -> Bool {
  match p_peek_kind(p) {
    ColonColon => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_arrow(p : Parser) -> Bool {
  match p_peek_kind(p) {
    Arrow => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_fatarrow(p : Parser) -> Bool {
  match p_peek_kind(p) {
    FatArrow => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_match_kind_eq(p : Parser) -> Bool {
  match p_peek_kind(p) {
    Eq => {
      let _ = p_advance(p)
      true
    }
    _ => false
  }
}

///|
fn p_expect_lbrace(p : Parser) -> Unit {
  if !p_match_kind_lbrace(p) {
    let tok = p_peek(p)
    p_err(
      p,
      tok.span,
      "expected `{`, found `" + tok.raw + "`",
      "`{`",
      tok.raw,
      "insert `{`",
    )
  }
}

///|
fn p_expect_rbrace(p : Parser) -> Unit {
  if !p_match_kind_rbrace(p) {
    let tok = p_peek(p)
    p_err(
      p,
      tok.span,
      "expected `}`, found `" + tok.raw + "`",
      "`}`",
      tok.raw,
      "insert matching `}`",
    )
  }
}

///|
fn p_expect_lparen(p : Parser) -> Unit {
  if !p_match_kind_lparen(p) {
    let tok = p_peek(p)
    p_err(
      p,
      tok.span,
      "expected `(`, found `" + tok.raw + "`",
      "`(`",
      tok.raw,
      "insert `(`",
    )
  }
}

///|
fn p_expect_rparen(p : Parser) -> Unit {
  if !p_match_kind_rparen(p) {
    let tok = p_peek(p)
    p_err(
      p,
      tok.span,
      "expected `)`, found `" + tok.raw + "`",
      "`)`",
      tok.raw,
      "insert matching `)`",
    )
  }
}

///|
fn p_match_angle_close(p : Parser) -> Option[Span] {
  if p.pending_gt {
    p.pending_gt = false
    return Some(p.pending_gt_span)
  }
  match p_peek_kind(p) {
    Gt => Some(p_advance(p).span)
    GtGt => {
      let sp = p_advance(p).span
      p.pending_gt = true
      p.pending_gt_span = span_new(sp.file, sp.line, sp.col + 1)
      Some(sp)
    }
    _ => None
  }
}

///|
fn p_looks_like_angle_type_args(p : Parser) -> Bool {
  let lt_tok = p_peek(p)
  if lt_tok.newline_before {
    return false
  }
  match lt_tok.kind {
    Lt => ()
    _ => return false
  }
  // Require the first token inside `<...>` to be a type-like start (uppercase
  // ident, pkg::Type, or `(`) so `x as Int < y` never triggers a false positive.
  let first = p_peek_at(p, 1)
  if first.newline_before {
    return false
  }
  let valid_first = match first.kind {
    Ident(s) =>
      if is_upper_start(s) {
        true
      } else {
        match p_peek_at(p, 2).kind {
          ColonColon => true
          _ => false
        }
      }
    LParen => true
    _ => false
  }
  if !valid_first {
    return false
  }
  let mut off = 1
  let mut depth = 1
  let mut saw_token = false
  while depth > 0 && off < 64 {
    let t = p_peek_at(p, off)
    if t.newline_before {
      return false
    }
    match t.kind {
      Lt => {
        depth = depth + 1
        if depth > 8 {
          return false
        }
      }
      Gt => depth = depth - 1
      GtGt => {
        if depth >= 2 {
          depth = depth - 2
        } else {
          depth = 0
        }
      }
      Ident(_) | ColonColon | Comma | LBracket | RBracket | LParen | RParen | Arrow =>
        saw_token = true
      _ => return false
    }
    off = off + 1
  }
  depth == 0 && saw_token
}

///|
fn p_parse_type_params(p : Parser) -> Array[String] {
  let params : Array[String] = []
  if !p_match_kind_lbracket(p) {
    match p_peek_kind(p) {
      Lt => {
        let lt_sp = p_advance(p).span
        let mut gt_sp = span_empty()
        while !p_is_eof(p) {
          match p_peek_kind(p) {
            Gt => {
              gt_sp = p_advance(p).span
              break
            }
            _ => {
              let name = p_expect_ident(p, "type parameter")
              params.push(name)
              if !p_match_kind_comma(p) {
                match p_peek_kind(p) {
                  Gt => gt_sp = p_advance(p).span
                  _ => ()
                }
                break
              }
            }
          }
        }
        p_err_code(
          p,
          lt_sp,
          "E_HABIT_ANGLE_GENERICS",
          "Pion uses square brackets `[T]` for generic type parameters, not angle brackets `<T>`",
          "`[T]`",
          "`<...>`",
          "replace `<...>` with `[...]`",
        )
        if gt_sp.line > 0 && lt_sp.line == gt_sp.line {
          p_add_edit(
            p,
            text_edit_replace(
              lt_sp.file,
              lt_sp.line,
              lt_sp.col,
              lt_sp.line,
              lt_sp.col + 1,
              "[",
              "machine",
            ),
          )
          p_add_edit(
            p,
            text_edit_replace(
              gt_sp.file,
              gt_sp.line,
              gt_sp.col,
              gt_sp.line,
              gt_sp.col + 1,
              "]",
              "machine",
            ),
          )
        }
      }
      _ => ()
    }
    return params
  }
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      RBracket => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let name = p_expect_ident(p, "type parameter")
        params.push(name)
        if !p_match_kind_comma(p) {
          if !p_match_kind_rbracket(p) {
            let tok = p_peek(p)
            p_err(
              p,
              tok.span,
              "expected `,` or `]` in type parameter list",
              "`,` or `]`",
              tok.raw,
              "close type parameter list with `]`",
            )
          }
          break
        }
      }
    }
  }
  params
}

///|
fn p_parse_type_expr(p : Parser) -> TypeExpr {
  let tok = p_peek(p)
  match tok.kind {
    LParen => {
      let _ = p_advance(p)
      let elems : Array[TypeExpr] = []
      if !p_match_kind_rparen(p) {
        while !p_is_eof(p) {
          elems.push(p_parse_type_expr(p))
          if !p_match_kind_comma(p) {
            p_expect_rparen(p)
            break
          }
          match p_peek_kind(p) {
            RParen => {
              let _ = p_advance(p)
              break
            }
            _ => ()
          }
        }
      }
      if p_match_kind_arrow(p) {
        let ret = p_parse_type_expr(p)
        TyFn(elems, ret, tok.span)
      } else if elems.length() == 1 {
        elems[0]
      } else {
        TyTuple(elems, tok.span)
      }
    }
    Ident(name) => {
      if name == "dyn" {
        match p_peek_at(p, 1).kind {
          Ident(_) => {
            let _ = p_advance(p)
            let mut tname = p_expect_ident(p, "trait name after `dyn`")
            if p_match_kind_coloncolon(p) {
              let mem = p_expect_ident(p, "trait name after `::`")
              tname = tname + "::" + mem
            }
            return TyDynTrait(tname, tok.span)
          }
          _ => ()
        }
      }
      let _ = p_advance(p)
      let mut full_name = name
      if p_match_kind_coloncolon(p) {
        let mem = p_expect_ident(p, "type name after `::`")
        full_name = name + "::" + mem
      }
      let args : Array[TypeExpr] = []
      if p_match_kind_lbracket(p) {
        while !p_is_eof(p) {
          match p_peek_kind(p) {
            RBracket => {
              let _ = p_advance(p)
              break
            }
            _ => {
              args.push(p_parse_type_expr(p))
              if !p_match_kind_comma(p) {
                if !p_match_kind_rbracket(p) {
                  let t2 = p_peek(p)
                  p_err(
                    p,
                    t2.span,
                    "expected `,` or `]` in type arguments",
                    "`,` or `]`",
                    t2.raw,
                    "close type arguments with `]`",
                  )
                }
                break
              }
            }
          }
        }
      } else if p_looks_like_angle_type_args(p) {
        let lt_sp = p_advance(p).span
        let mut gt_sp = span_empty()
        while !p_is_eof(p) {
          match p_match_angle_close(p) {
            Some(sp) => {
              gt_sp = sp
              break
            }
            None => {
              args.push(p_parse_type_expr(p))
              if !p_match_kind_comma(p) {
                match p_match_angle_close(p) {
                  Some(sp) => gt_sp = sp
                  None => ()
                }
                break
              }
            }
          }
        }
        p_err_code(
          p,
          lt_sp,
          "E_HABIT_ANGLE_GENERICS",
          "Pion uses square brackets `" +
          full_name +
          "[...]` for generic type arguments, not angle brackets `<...>`",
          "`" + full_name + "[...]`",
          "`" + full_name + "<...>`",
          "replace `<...>` with `[...]`",
        )
        if gt_sp.line > 0 && lt_sp.line == gt_sp.line {
          p_add_edit(
            p,
            text_edit_replace(
              lt_sp.file,
              lt_sp.line,
              lt_sp.col,
              lt_sp.line,
              lt_sp.col + 1,
              "[",
              "machine",
            ),
          )
          p_add_edit(
            p,
            text_edit_replace(
              gt_sp.file,
              gt_sp.line,
              gt_sp.col,
              gt_sp.line,
              gt_sp.col + 1,
              "]",
              "machine",
            ),
          )
        }
      }
      TyName(full_name, args, tok.span)
    }
    Amp => {
      let _ = p_advance(p)
      let is_mut = match p_peek_kind(p) {
        KwMut => {
          let _ = p_advance(p)
          true
        }
        _ => false
      }
      p_err_code(
        p,
        tok.span,
        "E_HABIT_RUST_REF",
        "Pion has no Rust-style reference types (`&T` / `&mut T`); pass values directly or use `mut param : T` for in-out parameters",
        "type expression (or `mut param : T`)",
        if is_mut { "`&mut`" } else { "`&`" },
        if is_mut {
          "remove `&mut` and mark the parameter `mut name : T` instead"
        } else {
          "remove `&`; Pion passes values without borrow references"
        },
      )
      p_parse_type_expr(p)
    }
    _ => {
      p_err(
        p,
        tok.span,
        "expected type, found `" + tok.raw + "`",
        "type expression",
        tok.raw,
        "write a valid type name",
      )
      TyMissing(tok.span)
    }
  }
}

///|
fn p_parse_struct_decl(
  p : Parser,
  is_pub : Bool,
  is_val : Bool,
  derive_eq : Bool,
  start_span : Span,
) -> Decl {
  let _ = p_advance(p) // consume 'struct'
  let name = p_expect_ident(p, "struct name")
  let tparams = p_parse_type_params(p)
  p_expect_lbrace(p)
  let fields : Array[FieldDecl] = []
  let mut end_span = start_span
  while !p_is_eof(p) {
    let before_pos = p.pos
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        end_span = p_advance(p).span
        break
      }
      _ => {
        let fspan = p_peek(p).span
        // `pub` on a field is accepted for MoonBit compatibility: the fields of a
        // `pub struct` are always visible to importers unless marked `priv`.
        match p_peek_kind(p) {
          KwPub => {
            let _ = p_advance(p)
          }
          _ => ()
        }
        let mut is_priv = false
        match p_peek_kind(p) {
          Ident(s) =>
            if s == "priv" {
              match p_peek_at(p, 1).kind {
                Colon => ()
                _ => {
                  is_priv = true
                  let _ = p_advance(p)
                }
              }
            }
          _ => ()
        }
        let mut is_mut = false
        match p_peek_kind(p) {
          KwMut => {
            is_mut = true
            let _ = p_advance(p)
          }
          _ => ()
        }
        let fname = p_expect_ident(p, "field name")
        let fty = if p_match_kind_colon(p) {
          p_parse_type_expr(p)
        } else {
          let t = p_peek(p)
          p_err(
            p,
            t.span,
            "expected `:` and field type for `" + fname + "`",
            "`: Type`",
            t.raw,
            "add `: Type` to field `" + fname + "`",
          )
          TyMissing(t.span)
        }
        fields.push(FieldDecl::{
          name: fname,
          is_priv: is_priv,
          is_mut: is_mut,
          ty: fty,
          span: fspan,
        })
        let _ = p_match_kind_comma(p)
        p_skip_semis(p)
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  DStruct(StructDecl::{
    is_pub: is_pub,
    is_val: is_val,
    derive_eq: derive_eq,
    name: name,
    type_params: tparams,
    fields: fields,
    span: start_span,
    end_span: end_span,
  })
}

///|
fn p_parse_enum_decl(
  p : Parser,
  is_pub : Bool,
  derive_eq : Bool,
  start_span : Span,
) -> Decl {
  let _ = p_advance(p) // consume 'enum'
  let name = p_expect_ident(p, "enum name")
  let tparams = p_parse_type_params(p)
  p_expect_lbrace(p)
  let variants : Array[VariantDecl] = []
  let mut end_span = start_span
  while !p_is_eof(p) {
    let before_pos = p.pos
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        end_span = p_advance(p).span
        break
      }
      _ => {
        let vspan = p_peek(p).span
        let vname = p_expect_ident(p, "variant name")
        let vfields : Array[TypeExpr] = []
        if p_match_kind_lparen(p) {
          while !p_is_eof(p) {
            let inner_before = p.pos
            match p_peek_kind(p) {
              RParen => {
                let _ = p_advance(p)
                break
              }
              _ => {
                vfields.push(p_parse_type_expr(p))
                if !p_match_kind_comma(p) {
                  p_expect_rparen(p)
                  break
                }
              }
            }
            if p.pos == inner_before {
              let _ = p_advance(p)
            }
          }
        }
        variants.push(VariantDecl::{
          name: vname,
          fields: vfields,
          span: vspan,
        })
        let _ = p_match_kind_comma(p)
        p_skip_semis(p)
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  DEnum(EnumDecl::{
    is_pub: is_pub,
    derive_eq: derive_eq,
    name: name,
    type_params: tparams,
    variants: variants,
    span: start_span,
    end_span: end_span,
  })
}

///|
fn p_parse_params(p : Parser) -> Array[Param] {
  let params : Array[Param] = []
  p_expect_lparen(p)
  while !p_is_eof(p) {
    let before_pos = p.pos
    match p_peek_kind(p) {
      RParen => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let pspan = p_peek(p).span
        let mut is_mut = false
        let mut is_into = false
        match p_peek_kind(p) {
          KwMut => {
            is_mut = true
            let _ = p_advance(p)
            let next_is_into_mod = match p_peek_kind(p) {
              Ident(s) =>
                if s == "into" {
                  match p_peek_at(p, 1).kind {
                    Ident(_) => true
                    _ => false
                  }
                } else {
                  false
                }
              _ => false
            }
            if next_is_into_mod {
              let isp = p_peek(p).span
              let _ = p_advance(p)
              is_into = true
              p_err(
                p,
                isp,
                "`into` and `mut` cannot be combined on the same parameter",
                "either `mut p : T` or `into p : T`",
                "`mut into`",
                "remove either `mut` or `into`",
              )
            }
          }
          Ident(s) =>
            if s == "into" {
              let next_is_mod = match p_peek_at(p, 1).kind {
                Ident(_) | KwMut => true
                _ => false
              }
              if next_is_mod {
                is_into = true
                let _ = p_advance(p)
                match p_peek_kind(p) {
                  KwMut => {
                    let msp = p_peek(p).span
                    is_mut = true
                    let _ = p_advance(p)
                    p_err(
                      p,
                      msp,
                      "`into` and `mut` cannot be combined on the same parameter",
                      "either `mut p : T` or `into p : T`",
                      "`into mut`",
                      "remove either `into` or `mut`",
                    )
                  }
                  _ => ()
                }
              }
            }
          _ => ()
        }
        let pname = p_expect_ident(p, "parameter name")
        let label_kind = match p_peek_kind(p) {
          Tilde => {
            let _ = p_advance(p)
            1
          }
          Question => {
            let _ = p_advance(p)
            2
          }
          _ => 0
        }
        let pty = if p_match_kind_colon(p) {
          p_parse_type_expr(p)
        } else {
          TyMissing(pspan)
        }
        let default_expr : Option[Expr] = match p_peek_kind(p) {
          Eq => {
            let _ = p_advance(p)
            Some(p_parse_expr(p))
          }
          _ => None
        }
        if is_mut {
          let has_default = match default_expr {
            Some(_) => true
            None => false
          }
          if label_kind != 0 || has_default {
            p_err(
              p,
              pspan,
              "`mut` parameter `" + pname + "` must be a plain positional parameter",
              "`mut " + pname + " : T`",
              if label_kind == 2 {
                "optional `" + pname + "?`"
              } else if label_kind == 1 {
                "labeled `" + pname + "~`"
              } else {
                "default value"
              },
              "remove `~` / `?` / the default value from `mut " + pname + "`",
            )
          }
        }
        params.push(Param::{
          name: pname,
          is_mut: is_mut,
          is_into: is_into,
          ty: pty,
          label_kind: label_kind,
          default_expr: default_expr,
          span: pspan,
        })
        if !p_match_kind_comma(p) {
          p_expect_rparen(p)
          break
        }
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  params
}

///|
pub struct ParsedTypeParams {
  names : Array[String]
  bounds : Array[TypeBound]
}

///|
fn p_parse_fn_type_params(p : Parser) -> ParsedTypeParams {
  let names : Array[String] = []
  let bounds : Array[TypeBound] = []
  if !p_match_kind_lbracket(p) {
    match p_peek_kind(p) {
      Lt => {
        let lt_sp = p_advance(p).span
        let mut gt_sp = span_empty()
        while !p_is_eof(p) {
          match p_peek_kind(p) {
            Gt => {
              gt_sp = p_advance(p).span
              break
            }
            _ => {
              let name = p_expect_ident(p, "type parameter")
              names.push(name)
              if p_match_kind_colon(p) {
                let trs : Array[String] = []
                while !p_is_eof(p) {
                  let mut tname = p_expect_ident(p, "trait bound")
                  if p_match_kind_coloncolon(p) {
                    let mem = p_expect_ident(p, "trait name after `::`")
                    tname = tname + "::" + mem
                  }
                  trs.push(tname)
                  match p_peek_kind(p) {
                    Plus => {
                      let _ = p_advance(p)
                    }
                    _ => break
                  }
                }
                if trs.length() > 0 {
                  bounds.push(TypeBound::{ param: name, traits: trs })
                }
              }
              if !p_match_kind_comma(p) {
                match p_peek_kind(p) {
                  Gt => gt_sp = p_advance(p).span
                  _ => ()
                }
                break
              }
            }
          }
        }
        p_err_code(
          p,
          lt_sp,
          "E_HABIT_ANGLE_GENERICS",
          "Pion uses square brackets `[T]` for generic type parameters, not angle brackets `<T>`",
          "`[T]`",
          "`<...>`",
          "replace `<...>` with `[...]`",
        )
        if gt_sp.line > 0 && lt_sp.line == gt_sp.line {
          p_add_edit(
            p,
            text_edit_replace(
              lt_sp.file,
              lt_sp.line,
              lt_sp.col,
              lt_sp.line,
              lt_sp.col + 1,
              "[",
              "machine",
            ),
          )
          p_add_edit(
            p,
            text_edit_replace(
              gt_sp.file,
              gt_sp.line,
              gt_sp.col,
              gt_sp.line,
              gt_sp.col + 1,
              "]",
              "machine",
            ),
          )
        }
      }
      _ => ()
    }
    return ParsedTypeParams::{ names: names, bounds: bounds }
  }
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      RBracket => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let name = p_expect_ident(p, "type parameter")
        names.push(name)
        if p_match_kind_colon(p) {
          let trs : Array[String] = []
          while !p_is_eof(p) {
            let mut tname = p_expect_ident(p, "trait bound")
            if p_match_kind_coloncolon(p) {
              let mem = p_expect_ident(p, "trait name after `::`")
              tname = tname + "::" + mem
            }
            trs.push(tname)
            match p_peek_kind(p) {
              Plus => {
                let _ = p_advance(p)
              }
              _ => break
            }
          }
          if trs.length() > 0 {
            bounds.push(TypeBound::{ param: name, traits: trs })
          }
        }
        if !p_match_kind_comma(p) {
          if !p_match_kind_rbracket(p) {
            let tok = p_peek(p)
            p_err(
              p,
              tok.span,
              "expected `,` or `]` in type parameter list",
              "`,` or `]`",
              tok.raw,
              "close type parameter list with `]`",
            )
          }
          break
        }
      }
    }
  }
  ParsedTypeParams::{ names: names, bounds: bounds }
}

///|
fn p_parse_fn_decl(
  p : Parser,
  is_pub : Bool,
  attrs : DeclAttrs,
  start_span : Span,
) -> Decl {
  let _ = p_advance(p) // consume 'fn'
  let mut tp = p_parse_fn_type_params(p)
  let first = p_expect_ident(p, "function name")
  let mut recv_ty = ""
  let mut fname = first
  if p_match_kind_coloncolon(p) {
    recv_ty = first
    fname = p_expect_ident(p, "method name")
  }
  if tp.names.length() == 0 {
    tp = p_parse_fn_type_params(p)
  }
  let lparen_span = p_peek(p).span
  let params = p_parse_params(p)
  let ret_ty = if p_match_kind_arrow(p) {
    p_parse_type_expr(p)
  } else {
    TyMissing(p_peek(p).span)
  }
  let body = p_parse_block_stmts(p)
  DFn(FnDecl::{
    is_pub: is_pub,
    no_io: attrs.no_io,
    is_into: attrs.into_attr,
    is_verify: attrs.verify && !attrs.verify_opaque,
    is_verify_opaque: attrs.verify_opaque,
    receiver_type: recv_ty,
    name: fname,
    type_params: tp.names,
    type_bounds: tp.bounds,
    params: params,
    ret_ty: ret_ty,
    body: body,
    span: start_span,
    lparen_span: lparen_span,
  })
}

///|
pub struct ParsedExternParams {
  params : Array[Param]
  vararg_from : Int
}

///|
fn p_parse_extern_params(p : Parser) -> ParsedExternParams {
  let params : Array[Param] = []
  let mut vararg_from = -1
  p_expect_lparen(p)
  while !p_is_eof(p) {
    let before_pos = p.pos
    match p_peek_kind(p) {
      RParen => {
        let _ = p_advance(p)
        break
      }
      Ellipsis => {
        let esp = p_peek(p).span
        let _ = p_advance(p)
        if vararg_from >= 0 {
          p_err(
            p,
            esp,
            "duplicate `...` in extern \"C\" parameter list",
            "parameter or `)`",
            "...",
            "only one `...` separator is allowed in an extern \"C\" declaration",
          )
        } else if params.length() == 0 {
          p_err(
            p,
            esp,
            "extern \"C\" variadic function requires at least one fixed parameter before `...`",
            "fixed parameter",
            "...",
            "declare at least one fixed parameter before `...` (C ABI requirement)",
          )
        } else {
          vararg_from = params.length()
        }
        if !p_match_kind_comma(p) {
          p_expect_rparen(p)
          break
        }
      }
      _ => {
        let pspan = p_peek(p).span
        match p_peek_kind(p) {
          KwMut => {
            p_err(
              p,
              pspan,
              "`extern \"C\" fn` parameters cannot be `mut`",
              "parameter name",
              "mut",
              "remove `mut`: C ABI parameters are passed by value",
            )
            let _ = p_advance(p)
          }
          Ident(s) =>
            if s == "into" {
              let next_is_mod = match p_peek_at(p, 1).kind {
                Ident(_) | KwMut => true
                _ => false
              }
              if next_is_mod {
                p_err(
                  p,
                  pspan,
                  "`extern \"C\" fn` parameters cannot be `into`",
                  "parameter name",
                  "into",
                  "remove `into`: C ABI parameters do not perform implicit conversions",
                )
                let _ = p_advance(p)
              }
            }
          _ => ()
        }
        let pname = p_expect_ident(p, "parameter name")
        let pty = if p_match_kind_colon(p) {
          p_parse_type_expr(p)
        } else {
          TyMissing(pspan)
        }
        params.push(Param::{
          name: pname,
          is_mut: false,
          is_into: false,
          ty: pty,
          label_kind: 0,
          default_expr: None,
          span: pspan,
        })
        if !p_match_kind_comma(p) {
          p_expect_rparen(p)
          break
        }
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  ParsedExternParams::{ params: params, vararg_from: vararg_from }
}

///|
fn p_parse_extern_fn_decl(p : Parser, is_pub : Bool, start_span : Span) -> Decl {
  let _ = p_advance(p) // consume 'extern'
  let abi_tok = p_peek(p)
  let abi = match abi_tok.kind {
    StringLit(s) => {
      let _ = p_advance(p)
      if s != "C" {
        p_err(
          p,
          abi_tok.span,
          "unsupported extern ABI `" + s + "` (only `\"C\"` is supported)",
          "`\"C\"`",
          abi_tok.raw,
          "use `extern \"C\" fn ...`",
        )
      }
      s
    }
    _ => {
      p_err(
        p,
        abi_tok.span,
        "expected ABI string `\"C\"` after `extern`, found `" + abi_tok.raw + "`",
        "`\"C\"`",
        abi_tok.raw,
        "write `extern \"C\" fn ...`",
      )
      "C"
    }
  }
  match p_peek_kind(p) {
    KwFn => {
      let _ = p_advance(p)
    }
    _ => {
      let t = p_peek(p)
      p_err(
        p,
        t.span,
        "expected `fn` after `extern \"C\"`, found `" + t.raw + "`",
        "`fn`",
        t.raw,
        "write `extern \"C\" fn <name>(...) -> <Ret>`",
      )
    }
  }
  let name = p_expect_ident(p, "extern function name")
  let eparams = p_parse_extern_params(p)
  let ret_ty = if p_match_kind_arrow(p) {
    p_parse_type_expr(p)
  } else {
    TyMissing(p_peek(p).span)
  }
  let mut c_symbol = name
  if p_match_kind_eq(p) {
    let sym_tok = p_peek(p)
    match sym_tok.kind {
      StringLit(s) => {
        let _ = p_advance(p)
        c_symbol = s
      }
      _ =>
        p_err(
          p,
          sym_tok.span,
          "expected C symbol name string after `=`, found `" + sym_tok.raw + "`",
          "string literal",
          sym_tok.raw,
          "write `= \"c_symbol\"`",
        )
    }
  }
  let mut has_body = false
  let mut body : Array[Stmt] = []
  match p_peek_kind(p) {
    LBrace => {
      has_body = true
      if eparams.vararg_from >= 0 {
        p_err(
          p,
          p_peek(p).span,
          "exported `extern \"C\" fn` with body cannot be variadic (`...`)",
          "fixed parameters",
          "...",
          "remove `...` from exported `extern \"C\" fn` definition",
        )
      }
      body = p_parse_block_stmts(p)
    }
    _ => ()
  }
  DExternFn(ExternFnDecl::{
    is_pub: is_pub,
    abi: abi,
    name: name,
    c_symbol: c_symbol,
    params: eparams.params,
    vararg_from: eparams.vararg_from,
    ret_ty: ret_ty,
    has_body: has_body,
    body: body,
    span: start_span,
  })
}

///|
fn p_parse_trait_decl(p : Parser, is_pub : Bool, start_span : Span) -> Decl {
  let _ = p_advance(p) // consume 'trait'
  let name = p_expect_ident(p, "trait name")
  p_expect_lbrace(p)
  let methods : Array[TraitMethodDecl] = []
  while !p_is_eof(p) {
    let before_pos = p.pos
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let mspan = p_peek(p).span
        match p_peek_kind(p) {
          KwFn => {
            let _ = p_advance(p)
          }
          _ => ()
        }
        let mname = p_expect_ident(p, "trait method name")
        let mparams = p_parse_params(p)
        let mret = if p_match_kind_arrow(p) {
          p_parse_type_expr(p)
        } else {
          TyMissing(p_peek(p).span)
        }
        methods.push(TraitMethodDecl::{
          name: mname,
          params: mparams,
          ret_ty: mret,
          span: mspan,
        })
        p_skip_semis(p)
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  DTrait(TraitDecl::{
    is_pub: is_pub,
    name: name,
    methods: methods,
    span: start_span,
  })
}

///|
fn p_parse_impl_decl(
  p : Parser,
  is_pub : Bool,
  impl_verify : Bool,
  start_span : Span,
) -> Decl {
  let _ = p_advance(p) // consume 'impl'
  let tp = p_parse_fn_type_params(p)
  let mut trait_name = p_expect_ident(p, "trait name")
  if p_match_kind_coloncolon(p) {
    let mem = p_expect_ident(p, "trait name after `::`")
    trait_name = trait_name + "::" + mem
  }
  match p_peek_kind(p) {
    KwFor => {
      let _ = p_advance(p)
    }
    _ => {
      let t = p_peek(p)
      p_err(
        p,
        t.span,
        "expected `for` in `impl` declaration, found `" + t.raw + "`",
        "`for`",
        t.raw,
        "write `impl " + trait_name + " for <Type> { ... }`",
      )
    }
  }
  let mut target_type = p_expect_ident(p, "target type name")
  if p_match_kind_coloncolon(p) {
    let mem = p_expect_ident(p, "type name after `::`")
    target_type = target_type + "::" + mem
  }
  let target_type_args : Array[TypeExpr] = []
  if p_match_kind_lbracket(p) {
    while !p_is_eof(p) {
      match p_peek_kind(p) {
        RBracket => {
          let _ = p_advance(p)
          break
        }
        _ => {
          target_type_args.push(p_parse_type_expr(p))
          if !p_match_kind_comma(p) {
            if !p_match_kind_rbracket(p) {
              let t2 = p_peek(p)
              p_err(
                p,
                t2.span,
                "expected `,` or `]` in `impl` target type arguments",
                "`,` or `]`",
                t2.raw,
                "close target type arguments with `]`",
              )
            }
            break
          }
        }
      }
    }
  }
  p_expect_lbrace(p)
  let methods : Array[FnDecl] = []
  while !p_is_eof(p) {
    let before_pos = p.pos
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let m_attrs = p_parse_decl_attrs(p)
        let mspan = p_peek(p).span
        match p_peek_kind(p) {
          KwPub => {
            let _ = p_advance(p)
          }
          _ => ()
        }
        match p_peek_kind(p) {
          KwFn => {
            let _ = p_advance(p)
          }
          _ => {
            let t = p_peek(p)
            p_err(
              p,
              t.span,
              "expected `fn` in `impl` block, found `" + t.raw + "`",
              "`fn`",
              t.raw,
              "start each `impl` method with `fn`",
            )
          }
        }
        let mname = p_expect_ident(p, "impl method name")
        let mtp = p_parse_fn_type_params(p)
        let mlp_span = p_peek(p).span
        let mparams = p_parse_params(p)
        let mret = if p_match_kind_arrow(p) {
          p_parse_type_expr(p)
        } else {
          TyMissing(p_peek(p).span)
        }
        let mbody = p_parse_block_stmts(p)
        methods.push(FnDecl::{
          is_pub: true,
          no_io: m_attrs.no_io,
          is_into: m_attrs.into_attr,
          is_verify: (impl_verify || m_attrs.verify) && !m_attrs.verify_opaque,
          is_verify_opaque: m_attrs.verify_opaque,
          receiver_type: target_type,
          name: mname,
          type_params: mtp.names,
          type_bounds: mtp.bounds,
          params: mparams,
          ret_ty: mret,
          body: mbody,
          span: mspan,
          lparen_span: mlp_span,
        })
        p_skip_semis(p)
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  DImpl(ImplDecl::{
    is_pub: is_pub,
    is_verify: impl_verify,
    type_params: tp.names,
    type_bounds: tp.bounds,
    trait_name: trait_name,
    target_type: target_type,
    target_type_args: target_type_args,
    methods: methods,
    span: start_span,
  })
}

///|
fn p_parse_const_decl(p : Parser, is_pub : Bool, start_span : Span) -> Decl {
  let _ = p_advance(p) // consume 'let'
  let name = p_expect_ident(p, "constant name")
  let cty = if p_match_kind_colon(p) {
    p_parse_type_expr(p)
  } else {
    TyMissing(start_span)
  }
  if !p_match_kind_eq(p) {
    let tok = p_peek(p)
    p_err(
      p,
      tok.span,
      "expected `=` in constant declaration `" + name + "`",
      "`=`",
      tok.raw,
      "add `= <expr>`",
    )
  }
  let val_expr = p_parse_expr(p)
  DConst(ConstDecl::{
    is_pub: is_pub,
    name: name,
    ty: cty,
    value: val_expr,
    span: start_span,
  })
}

///|
fn p_parse_block_stmts(p : Parser) -> Array[Stmt] {
  p_expect_lbrace(p)
  let stmts : Array[Stmt] = []
  while !p_is_eof(p) {
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let prev_pos = p.pos
        let st = p_parse_stmt(p)
        stmts.push(st)
        p_skip_semis(p)
        if p.pos == prev_pos {
          let _ = p_advance(p)
        }
      }
    }
  }
  stmts
}

///|
fn p_parse_stmt(p : Parser) -> Stmt {
  let tok = p_peek(p)
  match tok.kind {
    KwLet => {
      let _ = p_advance(p)
      match p_peek_kind(p) {
        LParen => {
          let _ = p_advance(p)
          let names : Array[String] = []
          while !p_is_eof(p) {
            match p_peek_kind(p) {
              RParen => {
                let _ = p_advance(p)
                break
              }
              _ => {
                let bname = p_expect_ident(p, "tuple binding name")
                names.push(bname)
                if !p_match_kind_comma(p) {
                  p_expect_rparen(p)
                  break
                }
              }
            }
          }
          let vty = if p_match_kind_colon(p) {
            p_parse_type_expr(p)
          } else {
            TyMissing(tok.span)
          }
          if !p_match_kind_eq(p) {
            let t2 = p_peek(p)
            p_err(
              p,
              t2.span,
              "expected `=` in tuple `let` destructuring",
              "`=`",
              t2.raw,
              "initialize tuple bindings with `= <expr>`",
            )
            p_sync_stmt(p)
            return SLetTuple(names, vty, EUnit(tok.span), tok.span)
          }
          let init = p_parse_expr(p)
          return SLetTuple(names, vty, init, tok.span)
        }
        _ => ()
      }
      let mut is_mut = false
      match p_peek_kind(p) {
        KwMut => {
          is_mut = true
          let _ = p_advance(p)
        }
        _ => ()
      }
      let name = p_expect_ident(p, "variable name")
      let vty = if p_match_kind_colon(p) {
        p_parse_type_expr(p)
      } else {
        TyMissing(tok.span)
      }
      if !p_match_kind_eq(p) {
        let t2 = p_peek(p)
        p_err(
          p,
          t2.span,
          "expected `=` in `let` binding `" + name + "`",
          "`=`",
          t2.raw,
          "initialize `" + name + "` with `= <expr>`",
        )
        p_sync_stmt(p)
        return SLet(name, is_mut, vty, EUnit(tok.span), tok.span)
      }
      let init = p_parse_expr(p)
      SLet(name, is_mut, vty, init, tok.span)
    }
    KwGuard => {
      let _ = p_advance(p)
      let cond = p_parse_expr(p)
      match p_peek_kind(p) {
        KwElse => {
          let _ = p_advance(p)
        }
        _ => {
          let t2 = p_peek(p)
          p_err(
            p,
            t2.span,
            "expected `else` after `guard` condition",
            "`else`",
            t2.raw,
            "write `guard <cond> else { ... }`",
          )
        }
      }
      let else_body = p_parse_block_stmts(p)
      SGuard(cond, else_body, tok.span)
    }
    KwWhile => {
      let _ = p_advance(p)
      let cond = p_parse_cond_expr(p)
      let body = p_parse_block_stmts(p)
      SWhile(cond, body, tok.span)
    }
    KwFor => {
      let _ = p_advance(p)
      let is_for_idx_in = match p_peek_kind(p) {
        Ident(_) =>
          match p_peek_at(p, 1).kind {
            Comma =>
              match p_peek_at(p, 2).kind {
                Ident(_) =>
                  match p_peek_at(p, 3).kind {
                    KwIn => true
                    _ => false
                  }
                _ => false
              }
            _ => false
          }
        _ => false
      }
      let is_for_in = match p_peek_kind(p) {
        Ident(_) =>
          match p_peek_at(p, 1).kind {
            KwIn => true
            _ => false
          }
        _ => false
      }
      if is_for_idx_in {
        let idx_name = p_expect_ident(p, "index variable")
        let _ = p_advance(p) // consume ','
        let var_name = p_expect_ident(p, "loop variable")
        let _ = p_advance(p) // consume 'in'
        let iter_expr = p_parse_expr(p)
        let body = p_parse_block_stmts(p)
        SForIn(idx_name, var_name, iter_expr, body, tok.span)
      } else if is_for_in {
        let var_name = p_expect_ident(p, "loop variable")
        let _ = p_advance(p) // consume 'in'
        let first_expr = p_parse_expr(p)
        let range_mode = match p_peek_kind(p) {
          DotDot | DotDotLt => 1
          DotDotEq => 2
          _ => 0
        }
        if range_mode > 0 {
          let _ = p_advance(p) // consume '..', '..<', or '..='
          let end_expr = p_parse_expr(p)
          let body = p_parse_block_stmts(p)
          SForRange(var_name, first_expr, end_expr, range_mode == 2, body, tok.span)
        } else {
          let body = p_parse_block_stmts(p)
          SForIn("", var_name, first_expr, body, tok.span)
        }
      } else {
        let init_stmt = p_parse_for_init_stmt(p)
        p_skip_semis(p)
        let cond = p_parse_expr(p)
        p_skip_semis(p)
        let step_stmt = p_parse_for_clause_stmt(p)
        let body = p_parse_block_stmts(p)
        SFor(init_stmt, cond, step_stmt, body, tok.span)
      }
    }
    KwReturn => {
      let _ = p_advance(p)
      let next = p_peek(p)
      let is_term = match next.kind {
        RBrace | Semi | Eof => true
        _ => false
      }
      let no_expr = next.newline_before || is_term
      if no_expr {
        SReturn(None, tok.span)
      } else {
        let e = p_parse_expr(p)
        SReturn(Some(e), tok.span)
      }
    }
    KwBreak => {
      let _ = p_advance(p)
      SBreak(tok.span)
    }
    KwContinue => {
      let _ = p_advance(p)
      SContinue(tok.span)
    }
    KwDebugAssert => {
      let _ = p_advance(p)
      p_expect_lparen(p)
      let cond = p_parse_expr(p)
      let msg = if p_match_kind_comma(p) {
        match p_peek_kind(p) {
          RParen => EString("assertion failed", tok.span)
          _ => {
            let m = p_parse_expr(p)
            let _ = p_match_kind_comma(p)
            m
          }
        }
      } else {
        EString("assertion failed", tok.span)
      }
      p_expect_rparen(p)
      SDebugAssert(cond, msg, tok.span)
    }
    _ => {
      match tok.kind {
        Ident(kw) => {
          let next1 = p_peek_at(p, 1)
          if kw == "bench_loop" {
            let next1_is_lbrace = match next1.kind {
              LBrace => !next1.newline_before
              _ => false
            }
            if next1_is_lbrace {
              let _ = p_advance(p)
              let body = p_parse_block_stmts(p)
              return SBenchLoop(body, tok.span)
            }
          }
          let next1_is_ident = match next1.kind {
            Ident(_) => !next1.newline_before
            _ => false
          }
          if kw == "const" && next1_is_ident {
            let _ = p_advance(p)
            p_err_code(
              p,
              tok.span,
              "E_HABIT_JS_CONST",
              "Pion uses `let` (not `const`) for immutable bindings",
              "`let`",
              "`const`",
              "replace `const` with `let`",
            )
            p_add_edit(
              p,
              text_edit_replace(
                tok.span.file,
                tok.span.line,
                tok.span.col,
                tok.span.line,
                tok.span.col + 5,
                "let",
                "machine",
              ),
            )
            let name = p_expect_ident(p, "variable name")
            let vty = if p_match_kind_colon(p) {
              p_parse_type_expr(p)
            } else {
              TyMissing(tok.span)
            }
            if !p_match_kind_eq(p) {
              p_sync_stmt(p)
              return SLet(name, false, vty, EUnit(tok.span), tok.span)
            }
            let init = p_parse_expr(p)
            return SLet(name, false, vty, init, tok.span)
          }
          if kw == "function" && next1_is_ident {
            let _ = p_advance(p)
            p_err_code(
              p,
              tok.span,
              "E_HABIT_JS_FUNCTION",
              "Pion uses `fn` (not `function`) to declare functions",
              "`fn`",
              "`function`",
              "replace `function` with `fn`",
            )
            p_add_edit(
              p,
              text_edit_replace(
                tok.span.file,
                tok.span.line,
                tok.span.col,
                tok.span.line,
                tok.span.col + 8,
                "fn",
                "machine",
              ),
            )
            p_sync_stmt(p)
            return SExpr(EUnit(tok.span), tok.span)
          }
        }
        _ => ()
      }
      let lhs = p_parse_expr(p)
      if p_match_kind_eq(p) {
        let rhs = p_parse_expr(p)
        SAssign(lhs, rhs, tok.span)
      } else {
        let cop = p_match_compound_assign_op(p)
        if cop != "" {
          let rhs = p_parse_expr(p)
          SCompoundAssign(cop, lhs, rhs, tok.span)
        } else {
          SExpr(lhs, tok.span)
        }
      }
    }
  }
}

///|
fn p_match_compound_assign_op(p : Parser) -> String {
  let op = match p_peek_kind(p) {
    PlusEq => "+"
    MinusEq => "-"
    StarEq => "*"
    SlashEq => "/"
    PercentEq => "%"
    AmpEq => "&"
    PipeEq => "|"
    CaretEq => "^"
    LtLtEq => "<<"
    GtGtEq => ">>"
    _ => ""
  }
  if op != "" {
    let _ = p_advance(p)
  }
  op
}

///|
fn p_parse_for_init_stmt(p : Parser) -> Stmt {
  let tok = p_peek(p)
  let stmt = p_parse_for_clause_stmt(p)
  match (tok.kind, stmt) {
    (Ident(_), SAssign(EIdent(name, id_sp), rhs, _)) =>
      SLet(name, true, TyMissing(id_sp), rhs, id_sp)
    _ => stmt
  }
}

///|
fn p_parse_for_clause_stmt(p : Parser) -> Stmt {
  let tok = p_peek(p)
  match tok.kind {
    KwLet => p_parse_stmt(p)
    _ => {
      let lhs = p_parse_expr(p)
      if p_match_kind_eq(p) {
        let rhs = p_parse_expr(p)
        SAssign(lhs, rhs, tok.span)
      } else {
        let cop = p_match_compound_assign_op(p)
        if cop != "" {
          let rhs = p_parse_expr(p)
          SCompoundAssign(cop, lhs, rhs, tok.span)
        } else {
          SExpr(lhs, tok.span)
        }
      }
    }
  }
}

///|
fn bin_prec(kind : TokenKind) -> Int {
  match kind {
    PipeGt => 1
    PipePipe => 2
    AmpAmp => 3
    Pipe => 4
    Caret => 5
    Amp => 6
    EqEq | BangEq => 7
    Lt | LtEq | Gt | GtEq => 8
    LtLt | GtGt => 9
    Plus | Minus => 10
    Star | Slash | Percent => 11
    _ => 0
  }
}

///|
fn p_parse_expr(p : Parser) -> Expr {
  p_parse_bin_expr(p, 1)
}

///|
fn p_parse_bin_expr(p : Parser, init_min_prec : Int) -> Expr {
  // Explicit stack for iterative binary-op & parenthesized sub-expression parsing
  // so 4,000+ deep left-chained or right-nested `1 + (1 + (...))` never overflows the stack.
  let f_is_paren : Array[Bool] = []
  let f_lhs : Array[Expr] = []
  let f_op : Array[Token] = []
  let f_min_prec : Array[Int] = []
  let mut cur_min_prec = init_min_prec
  let mut lhs = EUnit(p_peek(p).span)
  let mut need_operand = true
  while true {
    if need_operand {
      // Intercept plain `(` (not `()` and not `(...) => ...`) iteratively.
      let mut pushed_paren = false
      match p_peek_kind(p) {
        LParen => {
          let next_rparen = match p_peek_at(p, 1).kind {
            RParen => true
            _ => false
          }
          if !next_rparen && !p_looks_like_arrow_fn(p) {
            let ltok = p_advance(p)
            f_is_paren.push(true)
            f_lhs.push(EUnit(ltok.span))
            f_op.push(ltok)
            f_min_prec.push(cur_min_prec)
            cur_min_prec = 1
            pushed_paren = true
          }
        }
        _ => ()
      }
      if pushed_paren {
        continue
      }
      lhs = p_parse_unary_expr(p)
      need_operand = false
    }
    let tok = p_peek(p)
    // Handle `expr as Type` at high precedence and `expr is Pattern` at comparison precedence
    let mut handled_kw = false
    match tok.kind {
      KwAs =>
        if cur_min_prec <= 12 {
          let _ = p_advance(p)
          let target = p_parse_type_expr(p)
          lhs = EAs(lhs, target, tok.span)
          handled_kw = true
        }
      KwIs =>
        if cur_min_prec <= 7 {
          let _ = p_advance(p)
          let pat = p_parse_pattern(p)
          lhs = EIs(lhs, pat, tok.span)
          handled_kw = true
        }
      _ => ()
    }
    if handled_kw {
      continue
    }
    let prec = bin_prec(tok.kind)
    let mut take_bin = prec > 0 && prec >= cur_min_prec
    // Avoid treating a leading unary `-` or JSX `<Tag` / `<>` / `</` on a new line as binary op
    if take_bin && tok.newline_before {
      match tok.kind {
        Minus => take_bin = false
        Lt =>
          match p_peek_at(p, 1).kind {
            Ident(_) | Gt | Slash => take_bin = false
            _ => ()
          }
        _ => ()
      }
    }
    if take_bin {
      let op_tok = p_advance(p)
      f_is_paren.push(false)
      f_lhs.push(lhs)
      f_op.push(op_tok)
      f_min_prec.push(cur_min_prec)
      cur_min_prec = prec + 1
      need_operand = true
      continue
    }
    // Current precedence level finished; pop enclosing frame if any.
    if f_is_paren.length() == 0 {
      return lhs
    }
    let idx = f_is_paren.length() - 1
    let is_paren = f_is_paren[idx]
    let saved_lhs = f_lhs[idx]
    let op_tok = f_op[idx]
    let saved_min_prec = f_min_prec[idx]
    let _ = f_is_paren.pop()
    let _ = f_lhs.pop()
    let _ = f_op.pop()
    let _ = f_min_prec.pop()
    cur_min_prec = saved_min_prec
    if is_paren {
      if p_match_kind_comma(p) {
        let elems : Array[Expr] = [lhs]
        while !p_is_eof(p) {
          match p_peek_kind(p) {
            RParen => {
              let _ = p_advance(p)
              break
            }
            _ => {
              elems.push(p_parse_expr(p))
              if !p_match_kind_comma(p) {
                p_expect_rparen(p)
                break
              }
            }
          }
        }
        lhs = ETuple(elems, op_tok.span)
      } else {
        p_expect_rparen(p)
      }
      lhs = p_parse_postfix_tail(p, lhs)
    } else {
      match op_tok.kind {
        PipeGt =>
          match lhs {
            ECall(callee, args, sp) => {
              let new_args : Array[Expr] = [saved_lhs]
              let mut ai = 0
              while ai < args.length() {
                new_args.push(args[ai])
                ai = ai + 1
              }
              lhs = ECall(callee, new_args, sp)
            }
            _ => lhs = ECall(lhs, [saved_lhs], op_tok.span)
          }
        _ => lhs = EBinary(op_tok.raw, saved_lhs, lhs, op_tok.span)
      }
    }
  }
  lhs
}

///|
fn p_parse_unary_expr(p : Parser) -> Expr {
  let tok = p_peek(p)
  match tok.kind {
    Minus => {
      let _ = p_advance(p)
      let inner = p_parse_unary_expr(p)
      EUnary("-", inner, tok.span)
    }
    Bang => {
      let _ = p_advance(p)
      let inner = p_parse_unary_expr(p)
      EUnary("!", inner, tok.span)
    }
    KwMove => {
      let _ = p_advance(p)
      if p_match_kind_lparen(p) {
        let inner = p_parse_expr(p)
        p_expect_rparen(p)
        EMove(inner, tok.span)
      } else {
        let inner = p_parse_unary_expr(p)
        EMove(inner, tok.span)
      }
    }
    Amp => {
      let _ = p_advance(p)
      match p_peek_kind(p) {
        KwMut => {
          let _ = p_advance(p)
          p_err_code(
            p,
            tok.span,
            "E_HABIT_RUST_REF",
            "Pion has no `&mut` borrow expression; pass in-out arguments as `mut x`",
            "`mut <place>`",
            "`&mut`",
            "replace `&mut x` with `mut x`",
          )
          p_add_edit(
            p,
            text_edit_replace(
              tok.span.file,
              tok.span.line,
              tok.span.col,
              tok.span.line,
              tok.span.col + 1,
              "",
              "machine",
            ),
          )
          let inner = p_parse_unary_expr(p)
          EMutArg(inner, tok.span)
        }
        _ => {
          p_err_code(
            p,
            tok.span,
            "E_HABIT_RUST_REF",
            "Pion has no `&` borrow expression; pass values directly or use `mut x` for in-out parameters",
            "plain expression or `mut <place>`",
            "`&`",
            "remove `&` (or write `mut x` for a `mut` parameter)",
          )
          p_add_edit(
            p,
            text_edit_replace(
              tok.span.file,
              tok.span.line,
              tok.span.col,
              tok.span.line,
              tok.span.col + 1,
              "",
              "maybe",
            ),
          )
          p_parse_unary_expr(p)
        }
      }
    }
    _ => p_parse_postfix_expr(p)
  }
}

///|
fn p_parse_arg_list(p : Parser) -> Array[Expr] {
  let args : Array[Expr] = []
  p_expect_lparen(p)
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      RParen => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let cur = p_peek(p)
        let parsed_named = match cur.kind {
          Ident(arg_name) => {
            let next1 = p_peek_at(p, 1)
            match next1.kind {
              Eq => {
                let _ = p_advance(p)
                let _ = p_advance(p)
                let arg_val = p_parse_expr(p)
                args.push(ENamedArg(arg_name, false, arg_val, cur.span))
                true
              }
              Tilde => {
                let _ = p_advance(p)
                let _ = p_advance(p)
                args.push(
                  ENamedArg(arg_name, false, EIdent(arg_name, cur.span), cur.span),
                )
                true
              }
              Question =>
                match p_peek_at(p, 2).kind {
                  Eq => {
                    let _ = p_advance(p)
                    let _ = p_advance(p)
                    let _ = p_advance(p)
                    let arg_val = p_parse_expr(p)
                    args.push(ENamedArg(arg_name, true, arg_val, cur.span))
                    true
                  }
                  _ => false
                }
              _ => false
            }
          }
          _ => false
        }
        if !parsed_named {
          match cur.kind {
            KwMut => {
              let _ = p_advance(p)
              let inner = p_parse_expr(p)
              args.push(EMutArg(inner, cur.span))
            }
            _ => args.push(p_parse_expr(p))
          }
        }
        if !p_match_kind_comma(p) {
          p_expect_rparen(p)
          break
        }
      }
    }
  }
  args
}

///|
fn p_parse_postfix_expr(p : Parser) -> Expr {
  p_parse_postfix_tail(p, p_parse_primary_expr(p))
}

///|
fn p_parse_postfix_tail(p : Parser, init_expr : Expr) -> Expr {
  let mut expr = init_expr
  while !p_is_eof(p) {
    let tok = p_peek(p)
    match tok.kind {
      Dot => {
        if tok.newline_before {
          match p_peek_at(p, 1).kind {
            Ident(m) =>
              if is_upper_start(m) {
                break
              }
            _ => ()
          }
        }
        let _ = p_advance(p)
        match p_peek_kind(p) {
          IntLit(idx_str) => {
            let _ = p_advance(p)
            expr = EField(expr, idx_str, tok.span)
          }
          _ => {
            let mem = p_expect_ident(p, "field or method name")
            let next = p_peek(p)
            let next_lparen = match next.kind {
              LParen => true
              _ => false
            }
            let is_call = !next.newline_before && next_lparen
            if is_call {
              let args = p_parse_arg_list(p)
              expr = EMethodCall(expr, mem, args, tok.span)
            } else {
              expr = EField(expr, mem, tok.span)
            }
          }
        }
      }
      LParen => {
        if tok.newline_before {
          break
        }
        let args = p_parse_arg_list(p)
        expr = ECall(expr, args, tok.span)
      }
      LBracket => {
        if tok.newline_before {
          break
        }
        let _ = p_advance(p)
        let idx = p_parse_expr(p)
        if !p_match_kind_rbracket(p) {
          let t2 = p_peek(p)
          p_err(
            p,
            t2.span,
            "expected `]` after index expression",
            "`]`",
            t2.raw,
            "close index with `]`",
          )
        }
        expr = EIndex(expr, idx, tok.span)
      }
      Question => {
        if tok.newline_before {
          break
        }
        let _ = p_advance(p)
        expr = ETry(expr, tok.span)
      }
      _ => break
    }
  }
  expr
}

///|
pub struct StructLitParsed {
  spread : Option[Expr]
  fields : Array[FieldInit]
}

///|
fn p_parse_struct_lit_fields(p : Parser) -> StructLitParsed {
  p_expect_lbrace(p)
  let mut spread : Option[Expr] = None
  match p_peek_kind(p) {
    DotDot => {
      let _ = p_advance(p)
      let base = p_parse_expr(p)
      spread = Some(base)
      let _ = p_match_kind_comma(p)
    }
    _ => ()
  }
  let fields : Array[FieldInit] = []
  while !p_is_eof(p) {
    let before_pos = p.pos
    match p_peek_kind(p) {
      RBrace => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let fspan = p_peek(p).span
        let fname = p_expect_ident(p, "field name")
        let fval = if p_match_kind_colon(p) {
          p_parse_expr(p)
        } else {
          EIdent(fname, fspan)
        }
        fields.push(FieldInit::{ name: fname, value: fval, span: fspan })
        if !p_match_kind_comma(p) {
          p_expect_rbrace(p)
          break
        }
      }
    }
    if p.pos == before_pos {
      let _ = p_advance(p)
    }
  }
  StructLitParsed::{ spread: spread, fields: fields }
}

///|
fn p_looks_like_struct_lit(p : Parser) -> Bool {
  match p_peek_at(p, 1).kind {
    DotDot => true
    Ident(_) =>
      match p_peek_at(p, 2).kind {
        Colon => true
        _ => false
      }
    _ => false
  }
}

///|
///|
fn p_parse_cond_expr(p : Parser) -> Expr {
  match p_peek_kind(p) {
    KwLet => {
      let let_tok = p_advance(p)
      let pat = p_parse_pattern(p)
      if !p_match_kind_eq(p) {
        let eq_tok = p_peek(p)
        p_err(
          p,
          eq_tok.span,
          "expected `=` after pattern in `let` condition, found `" + eq_tok.raw + "`",
          "`=`",
          eq_tok.raw,
          "insert `=` between pattern and expression",
        )
      }
      // Parse scrutinee above `&&` / `||` (prec >= 4) and also support unparenthesized
      // `|>` pipes on the scrutinee before attaching trailing `&&` / `||` chains.
      let mut scrut = p_parse_bin_expr(p, 4)
      while true {
        match p_peek_kind(p) {
          PipeGt => {
            let op_tok = p_advance(p)
            let rhs = p_parse_bin_expr(p, 4)
            match rhs {
              ECall(callee, args, sp) => {
                let new_args : Array[Expr] = [scrut]
                let mut ai = 0
                while ai < args.length() {
                  new_args.push(args[ai])
                  ai = ai + 1
                }
                scrut = ECall(callee, new_args, sp)
              }
              _ => scrut = ECall(rhs, [scrut], op_tok.span)
            }
          }
          _ => break
        }
      }
      let mut lhs = EIs(scrut, pat, let_tok.span)
      while true {
        match p_peek_kind(p) {
          AmpAmp => {
            let op_tok = p_advance(p)
            let rhs = p_parse_bin_expr(p, 4)
            lhs = EBinary("&&", lhs, rhs, op_tok.span)
          }
          PipePipe => {
            let op_tok = p_advance(p)
            let rhs = p_parse_bin_expr(p, 3)
            lhs = EBinary("||", lhs, rhs, op_tok.span)
          }
          _ => break
        }
      }
      lhs
    }
    _ => p_parse_expr(p)
  }
}

///|
fn p_parse_if_expr(p : Parser) -> Expr {
  let tok = p_advance(p) // consume 'if'
  let cond = p_parse_cond_expr(p)
  let then_stmts = p_parse_block_stmts(p)
  let else_opt : Option[Expr] = match p_peek_kind(p) {
    KwElse => {
      let _ = p_advance(p)
      match p_peek_kind(p) {
        KwIf => Some(p_parse_if_expr(p))
        _ => {
          let else_span = p_peek(p).span
          let else_stmts = p_parse_block_stmts(p)
          Some(EBlock(else_stmts, else_span))
        }
      }
    }
    _ => None
  }
  EIf(cond, then_stmts, else_opt, tok.span)
}

///|
fn is_upper_start(s : String) -> Bool {
  if s.length() == 0 {
    false
  } else {
    let ch = str_code_at(s, 0)
    ch >= 65 && ch <= 90
  }
}

///|
fn p_parse_pattern(p : Parser) -> Pattern {
  let tok = p_peek(p)
  match tok.kind {
    BoolLit(b) => {
      let _ = p_advance(p)
      PBool(b, tok.span)
    }
    IntLit(s) => {
      let _ = p_advance(p)
      PInt(s, tok.span)
    }
    Minus => {
      let _ = p_advance(p)
      let t2 = p_peek(p)
      match t2.kind {
        IntLit(s) => {
          let _ = p_advance(p)
          PInt("-" + s, tok.span)
        }
        _ => {
          p_err(
            p,
            t2.span,
            "expected integer literal after `-` in pattern",
            "integer literal",
            t2.raw,
            "write an integer literal",
          )
          PWild(tok.span)
        }
      }
    }
    StringLit(s) => {
      let _ = p_advance(p)
      PString(s, tok.span)
    }
    CharLit(s) => {
      let _ = p_advance(p)
      PChar(s, tok.span)
    }
    Dot => {
      let _ = p_advance(p)
      let vname = p_expect_ident(p, "variant name after `.`")
      let sub = p_parse_pattern_args(p)
      PVariant("", vname, sub, true, tok.span)
    }
    LParen => {
      let _ = p_advance(p)
      let pats : Array[Pattern] = []
      while !p_is_eof(p) {
        match p_peek_kind(p) {
          RParen => {
            let _ = p_advance(p)
            break
          }
          _ => {
            pats.push(p_parse_pattern(p))
            if !p_match_kind_comma(p) {
              p_expect_rparen(p)
              break
            }
          }
        }
      }
      PTuple(pats, tok.span)
    }
    Ident(name) => {
      let _ = p_advance(p)
      if name == "_" {
        return PWild(tok.span)
      }
      if p_match_kind_coloncolon(p) {
        let vname = p_expect_ident(p, "variant name")
        if p_match_kind_coloncolon(p) {
          let vname2 = p_expect_ident(p, "variant name")
          let sub = p_parse_pattern_args(p)
          PVariant(name + "::" + vname, vname2, sub, true, tok.span)
        } else {
          let has_lparen = match p_peek_kind(p) {
            LParen => true
            _ => false
          }
          let sub = p_parse_pattern_args(p)
          PVariant(name, vname, sub, has_lparen, tok.span)
        }
      } else {
        match p_peek_kind(p) {
          LParen => {
            let sub = p_parse_pattern_args(p)
            PVariant("", name, sub, true, tok.span)
          }
          _ =>
            if is_upper_start(name) {
              PVariant("", name, [], false, tok.span)
            } else {
              PIdent(name, tok.span)
            }
        }
      }
    }
    _ => {
      p_err(
        p,
        tok.span,
        "expected pattern, found `" + tok.raw + "`",
        "pattern",
        tok.raw,
        "write a valid pattern or `_`",
      )
      let _ = p_advance(p)
      PWild(tok.span)
    }
  }
}

///|
fn p_parse_pattern_args(p : Parser) -> Array[Pattern] {
  let sub : Array[Pattern] = []
  if !p_match_kind_lparen(p) {
    return sub
  }
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      RParen => {
        let _ = p_advance(p)
        break
      }
      _ => {
        sub.push(p_parse_pattern(p))
        if !p_match_kind_comma(p) {
          p_expect_rparen(p)
          break
        }
      }
    }
  }
  sub
}

///|
fn p_parse_match_expr(p : Parser) -> Expr {
  let tok = p_advance(p) // consume 'match'
  let scrut = p_parse_expr(p)
  p_expect_lbrace(p)
  let arms : Array[MatchArm] = []
  while !p_is_eof(p) {
    p_skip_semis(p)
    match p_peek_kind(p) {
      RBrace => {
        let _ = p_advance(p)
        break
      }
      _ => {
        let arm_span = p_peek(p).span
        // Support `Pat1 | Pat2 => body` by expanding into separate arms
        let pats : Array[Pattern] = []
        pats.push(p_parse_pattern(p))
        while true {
          match p_peek_kind(p) {
            Pipe => {
              let _ = p_advance(p)
              pats.push(p_parse_pattern(p))
            }
            _ => break
          }
        }
        let guard_expr : Option[Expr] = match p_peek_kind(p) {
          KwIf => {
            let _ = p_advance(p)
            let prev_guard = p.in_match_guard
            p.in_match_guard = true
            let ge = p_parse_expr(p)
            p.in_match_guard = prev_guard
            Some(ge)
          }
          _ => None
        }
        if !p_match_kind_fatarrow(p) {
          let t2 = p_peek(p)
          p_err(
            p,
            t2.span,
            "expected `=>` in match arm",
            "`=>`",
            t2.raw,
            "add `=> <expr>` after match pattern",
          )
          p_sync_stmt(p)
          continue
        }
        let body = match p_peek_kind(p) {
          KwReturn | KwBreak | KwContinue | KwDebugAssert => {
            let st = p_parse_stmt(p)
            EBlock([st], arm_span)
          }
          _ => {
            let lhs = p_parse_expr(p)
            if p_match_kind_eq(p) {
              let rhs = p_parse_expr(p)
              EBlock([SAssign(lhs, rhs, arm_span)], arm_span)
            } else {
              let cop = p_match_compound_assign_op(p)
              if cop != "" {
                let rhs = p_parse_expr(p)
                EBlock([SCompoundAssign(cop, lhs, rhs, arm_span)], arm_span)
              } else {
                lhs
              }
            }
          }
        }
        let mut i = 0
        while i < pats.length() {
          arms.push(MatchArm::{ pat: pats[i], guard_expr: guard_expr, body: body, span: arm_span })
          i = i + 1
        }
        let _ = p_match_kind_comma(p)
        p_skip_semis(p)
      }
    }
  }
  EMatch(scrut, arms, tok.span)
}

///|
fn p_jsx_save_and_clear_stack(p : Parser) -> Array[String] {
  let saved : Array[String] = []
  let mut i = 0
  while i < p.jsx_parent_stack.length() {
    saved.push(p.jsx_parent_stack[i])
    i = i + 1
  }
  while p.jsx_parent_stack.length() > 0 {
    let _ = p.jsx_parent_stack.pop()
  }
  saved
}

///|
fn p_jsx_restore_stack(p : Parser, saved : Array[String]) -> Unit {
  while p.jsx_parent_stack.length() > 0 {
    let _ = p.jsx_parent_stack.pop()
  }
  let mut i = 0
  while i < saved.length() {
    p.jsx_parent_stack.push(saved[i])
    i = i + 1
  }
}

///|
fn p_parse_jsx_children(p : Parser) -> Array[Stmt] {
  let stmts : Array[Stmt] = []
  while !p_is_eof(p) {
    let ctok = p_peek(p)
    match ctok.kind {
      Lt =>
        match p_peek_at(p, 1).kind {
          Slash => break
          _ => {
            let prev_pos = p.pos
            let e = p_parse_primary_expr(p)
            stmts.push(SExpr(e, ctok.span))
            if p.pos == prev_pos {
              let _ = p_advance(p)
            }
          }
        }
      KwIf | KwFor | KwWhile | KwMatch | KwLet => {
        let prev_pos = p.pos
        let st = p_parse_stmt(p)
        stmts.push(st)
        p_skip_semis(p)
        if p.pos == prev_pos {
          let _ = p_advance(p)
        }
      }
      LBrace => {
        let _ = p_advance(p)
        while !p_is_eof(p) {
          p_skip_semis(p)
          match p_peek_kind(p) {
            RBrace => {
              let _ = p_advance(p)
              break
            }
            _ => {
              let prev_pos = p.pos
              let st = p_parse_stmt(p)
              stmts.push(st)
              p_skip_semis(p)
              if p.pos == prev_pos {
                let _ = p_advance(p)
              }
            }
          }
        }
      }
      Semi => {
        let _ = p_advance(p)
      }
      _ => {
        p_err(
          p,
          ctok.span,
          "unexpected token `" + ctok.raw + "` inside JSX children",
          "JSX element, control flow, `{ ... }`, or closing tag",
          ctok.raw,
          "wrap expressions in `{ ... }` or close the JSX element",
        )
        let _ = p_advance(p)
      }
    }
  }
  stmts
}

///|
fn p_parse_jsx_fragment(p : Parser, start_span : Span) -> Expr {
  let _ = p_advance(p) // consume '<'
  let _ = p_advance(p) // consume '>'
  let child_stmts = p_parse_jsx_children(p)
  let mut closed_ok = false
  match p_peek_kind(p) {
    Lt =>
      match p_peek_at(p, 1).kind {
        Slash => {
          let _ = p_advance(p)
          let _ = p_advance(p)
          match p_peek_kind(p) {
            Gt => {
              let _ = p_advance(p)
              closed_ok = true
            }
            _ => ()
          }
        }
        _ => ()
      }
    _ => ()
  }
  if !closed_ok {
    let t = p_peek(p)
    p_err(
      p,
      t.span,
      "expected `</>` to close JSX fragment",
      "`</>`",
      t.raw,
      "close the fragment with `</>`",
    )
  }
  EBlock(child_stmts, start_span)
}

///|
fn p_parse_jsx_element(p : Parser, start_span : Span) -> Expr {
  let _ = p_advance(p) // consume '<'
  let a_tok = p_advance(p)
  let a_name = match a_tok.kind {
    Ident(s) => s
    _ => ""
  }
  let mut tag_name = a_name
  let mut callee = EIdent(a_name, a_tok.span)
  if p_match_kind_coloncolon(p) {
    let b_name = p_expect_ident(p, "component name after `::`")
    tag_name = a_name + "::" + b_name
    callee = EPath(a_name, b_name, a_tok.span)
  }

  let mut explicit_parent : Option[Expr] = None
  let named_args : Array[Expr] = []
  while !p_is_eof(p) {
    let atok = p_peek(p)
    match atok.kind {
      Gt | Slash => break
      Ident(_) | KwIn => {
        let _ = p_advance(p)
        let aname = match atok.kind {
          Ident(s) => s
          KwIn => "in"
          _ => ""
        }
        let aval = match p_peek_kind(p) {
          Eq => {
            let _ = p_advance(p)
            let saved = p_jsx_save_and_clear_stack(p)
            let v = match p_peek_kind(p) {
              StringLit(_) | InterpStart(_) => p_parse_primary_expr(p)
              LBrace => {
                let _ = p_advance(p)
                let inner = p_parse_expr(p)
                p_expect_rbrace(p)
                inner
              }
              _ => {
                let bad = p_peek(p)
                p_err(
                  p,
                  bad.span,
                  "expected string literal or `{expr}` for JSX attribute `" + aname + "`",
                  "string literal or `{expr}`",
                  bad.raw,
                  "write `" + aname + "=\"...\"` or `" + aname + "={expr}`",
                )
                EUnit(bad.span)
              }
            }
            p_jsx_restore_stack(p, saved)
            v
          }
          FatArrow => {
            let _ = p_advance(p)
            let saved = p_jsx_save_and_clear_stack(p)
            let v = match p_peek_kind(p) {
              LBrace => {
                let body_stmts = p_parse_block_stmts(p)
                EClosure([], TyMissing(atok.span), body_stmts, atok.span)
              }
              _ => {
                let bad = p_peek(p)
                p_err(
                  p,
                  bad.span,
                  "expected `{ ... }` after `=>` for JSX attribute `" + aname + "`",
                  "`{ ... }`",
                  bad.raw,
                  "write `" + aname + "=>{ ... }`",
                )
                EUnit(bad.span)
              }
            }
            p_jsx_restore_stack(p, saved)
            v
          }
          _ => EBool(true, atok.span)
        }
        if aname == "in" {
          match explicit_parent {
            Some(_) =>
              p_err(
                p,
                atok.span,
                "duplicate `in` attribute on JSX element `<" + tag_name + ">`",
                "single `in` attribute",
                "duplicate `in`",
                "remove the duplicate `in={...}` attribute",
              )
            None => explicit_parent = Some(aval)
          }
        } else {
          named_args.push(ENamedArg(aname, false, aval, atok.span))
        }
      }
      _ => {
        p_err(
          p,
          atok.span,
          "expected attribute name, `>`, or `/>` in JSX element `<" + tag_name + ">`",
          "attribute name, `>`, or `/>`",
          atok.raw,
          "close the JSX tag with `>` or `/>`",
        )
        let _ = p_advance(p)
      }
    }
  }

  let call_args : Array[Expr] = []
  match explicit_parent {
    Some(pe) => call_args.push(pe)
    None =>
      if p.jsx_parent_stack.length() > 0 {
        let parent_ident = p.jsx_parent_stack[p.jsx_parent_stack.length() - 1]
        call_args.push(EIdent(parent_ident, start_span))
      }
  }
  let mut ni = 0
  while ni < named_args.length() {
    call_args.push(named_args[ni])
    ni = ni + 1
  }

  match p_peek_kind(p) {
    Slash => {
      let _ = p_advance(p)
      match p_peek_kind(p) {
        Gt => {
          let _ = p_advance(p)
        }
        _ => {
          let t = p_peek(p)
          p_err(
            p,
            t.span,
            "expected `>` after `/` in self-closing JSX tag `<" + tag_name + " />`",
            "`>`",
            t.raw,
            "close self-closing tag with `/>`",
          )
        }
      }
      ECall(callee, call_args, start_span)
    }
    Gt => {
      let _ = p_advance(p)
      let pname = "__jsx_p_" + p.jsx_next_id.to_string()
      p.jsx_next_id = p.jsx_next_id + 1
      p.jsx_parent_stack.push(pname)
      let child_stmts = p_parse_jsx_children(p)
      let _ = p.jsx_parent_stack.pop()

      let mut closed_header = false
      match p_peek_kind(p) {
        Lt =>
          match p_peek_at(p, 1).kind {
            Slash => {
              let _ = p_advance(p)
              let _ = p_advance(p)
              closed_header = true
            }
            _ => ()
          }
        _ => ()
      }
      if closed_header {
        let ca = p_expect_ident(p, "closing JSX tag name")
        let close_name = if p_match_kind_coloncolon(p) {
          let cb = p_expect_ident(p, "closing JSX component name after `::`")
          ca + "::" + cb
        } else {
          ca
        }
        if close_name != tag_name {
          p_err(
            p,
            p_peek(p).span,
            "mismatched JSX closing tag: expected `</" + tag_name + ">`, found `</" + close_name + ">`",
            "`</" + tag_name + ">`",
            "`</" + close_name + ">`",
            "change closing tag to `</" + tag_name + ">`",
          )
        }
        match p_peek_kind(p) {
          Gt => {
            let _ = p_advance(p)
          }
          _ => {
            let t = p_peek(p)
            p_err(
              p,
              t.span,
              "expected `>` to finish closing tag `</" + tag_name + ">`",
              "`>`",
              t.raw,
              "add `>` after `</" + tag_name + "`",
            )
          }
        }
      } else {
        let t = p_peek(p)
        p_err(
          p,
          t.span,
          "expected closing tag `</" + tag_name + ">`",
          "`</" + tag_name + ">`",
          t.raw,
          "close `<" + tag_name + ">` with `</" + tag_name + ">`",
        )
      }

      if child_stmts.length() > 0 {
        let child_param = Param::{
          name: pname,
          is_mut: false,
          is_into: false,
          ty: TyMissing(start_span),
          label_kind: 0,
          default_expr: None,
          span: start_span,
        }
        call_args.push(
          ENamedArg(
            "children",
            false,
            EClosure([child_param], TyMissing(start_span), child_stmts, start_span),
            start_span,
          ),
        )
      }
      ECall(callee, call_args, start_span)
    }
    _ => {
      let t = p_peek(p)
      p_err(
        p,
        t.span,
        "unterminated JSX opening tag `<" + tag_name + ">`",
        "`>` or `/>`",
        t.raw,
        "close `<" + tag_name + "` with `>` or `/>`",
      )
      ECall(callee, call_args, start_span)
    }
  }
}

///|
fn p_looks_like_arrow_fn(p : Parser) -> Bool {
  if p.in_match_guard {
    return false
  }
  match p_peek_kind(p) {
    LParen => ()
    _ => return false
  }
  let mut off = 1
  let mut depth = 1
  let mut brk = 0
  while depth > 0 && off < 128 {
    let t = p_peek_at(p, off)
    match t.kind {
      Eof => return false
      LParen => depth = depth + 1
      RParen => depth = depth - 1
      LBracket => brk = brk + 1
      RBracket => if brk > 0 { brk = brk - 1 }
      Ident(_) | Colon | ColonColon | Comma | Arrow | KwMut => ()
      _ =>
        if depth == 1 && brk == 0 {
          return false
        }
    }
    off = off + 1
  }
  if depth != 0 {
    return false
  }
  match p_peek_at(p, off).kind {
    FatArrow => true
    _ => false
  }
}

///|
fn p_looks_like_js_fn_expr(p : Parser) -> Bool {
  match p_peek_at(p, 1).kind {
    LParen => ()
    _ => return false
  }
  let mut off = 2
  let mut depth = 1
  while depth > 0 && off < 128 {
    match p_peek_at(p, off).kind {
      Eof => return false
      LParen => depth = depth + 1
      RParen => depth = depth - 1
      _ => ()
    }
    off = off + 1
  }
  if depth != 0 {
    return false
  }
  match p_peek_at(p, off).kind {
    LBrace | Arrow => true
    _ => false
  }
}

///|
fn p_parse_primary_expr(p : Parser) -> Expr {
  let tok = p_peek(p)
  match tok.kind {
    IntLit(s) => {
      let _ = p_advance(p)
      EInt(s, tok.span)
    }
    Int64Lit(s) => {
      let _ = p_advance(p)
      EInt64(s, tok.span)
    }
    UIntLit(s) => {
      let _ = p_advance(p)
      EUInt(s, tok.span)
    }
    UInt64Lit(s) => {
      let _ = p_advance(p)
      EUInt64(s, tok.span)
    }
    DoubleLit(s) => {
      let _ = p_advance(p)
      EDouble(s, tok.span)
    }
    FloatLit(s) => {
      let _ = p_advance(p)
      EFloat(s, tok.span)
    }
    BoolLit(b) => {
      let _ = p_advance(p)
      EBool(b, tok.span)
    }
    ByteLit(s) => {
      let _ = p_advance(p)
      EByte(s, tok.span)
    }
    CharLit(s) => {
      let _ = p_advance(p)
      EChar(s, tok.span)
    }
    StringLit(s) => {
      let _ = p_advance(p)
      EString(s, tok.span)
    }
    InterpStart(prefix) => {
      let _ = p_advance(p)
      let parts : Array[Expr] = []
      if prefix.length() > 0 {
        parts.push(EString(prefix, tok.span))
      }
      while !p_is_eof(p) {
        parts.push(p_parse_expr(p))
        let nt = p_peek(p)
        match nt.kind {
          InterpMid(mid) => {
            let _ = p_advance(p)
            if mid.length() > 0 {
              parts.push(EString(mid, nt.span))
            }
          }
          InterpEnd(suffix) => {
            let _ = p_advance(p)
            if suffix.length() > 0 {
              parts.push(EString(suffix, nt.span))
            }
            break
          }
          _ => {
            p_err(
              p,
              nt.span,
              "expected `}` to close string interpolation",
              "`}`",
              nt.raw,
              "close the interpolation expression with `}`",
            )
            break
          }
        }
      }
      EInterp(parts, tok.span)
    }
    KwIf => p_parse_if_expr(p)
    KwMatch => p_parse_match_expr(p)
    // `debug_assert(cond, msg)` in expression position is a `Unit` block.
    KwDebugAssert => {
      let st = p_parse_stmt(p)
      EBlock([st], tok.span)
    }
    KwFn => {
      let _ = p_advance(p)
      let params = p_parse_params(p)
      let mut cpi = 0
      while cpi < params.length() {
        if params[cpi].is_mut {
          p_err(
            p,
            params[cpi].span,
            "closure parameter `" + params[cpi].name + "` cannot be `mut`",
            "plain closure parameter",
            "mut " + params[cpi].name,
            "only top-level `fn`s, methods and trait methods take `mut` parameters",
          )
        }
        if params[cpi].is_into {
          p_err(
            p,
            params[cpi].span,
            "closure parameter `" + params[cpi].name + "` cannot be `into`",
            "plain closure parameter",
            "into " + params[cpi].name,
            "remove `into` from closure parameter `" + params[cpi].name + "`",
          )
        }
        cpi = cpi + 1
      }
      let ret_ty = if p_match_kind_arrow(p) {
        p_parse_type_expr(p)
      } else {
        TyMissing(p_peek(p).span)
      }
      let body = p_parse_block_stmts(p)
      EClosure(params, ret_ty, body, tok.span)
    }
    KwScope => {
      let _ = p_advance(p)
      p_expect_lparen(p)
      let w = p_parse_expr(p)
      let _ = p_match_kind_comma(p)
      let f = p_parse_expr(p)
      p_expect_rparen(p)
      EScope(w, f, tok.span)
    }
    KwSpawn => {
      let _ = p_advance(p)
      p_expect_lparen(p)
      let s = p_parse_expr(p)
      let _ = p_match_kind_comma(p)
      let f = p_parse_expr(p)
      p_expect_rparen(p)
      ESpawn(s, f, tok.span)
    }
    LParen => {
      if p_looks_like_arrow_fn(p) {
        let params = p_parse_params(p)
        let arrow_tok = p_advance(p) // consume '=>'
        p_err_code(
          p,
          tok.span,
          "E_HABIT_ARROW_FN",
          "Pion uses `fn(...) { ... }` for closures, not arrow syntax `(...) => ...`",
          "`fn(...) { ... }`",
          "`(...) => ...`",
          "replace `(...) => { ... }` with `fn(...) { ... }`",
        )
        match p_peek_kind(p) {
          LBrace => {
            p_add_edit(p, text_edit_insert(tok.span, 0, "fn"))
            p_add_edit(
              p,
              text_edit_replace(
                arrow_tok.span.file,
                arrow_tok.span.line,
                arrow_tok.span.col,
                arrow_tok.span.line,
                arrow_tok.span.col + 2,
                "",
                "machine",
              ),
            )
            let body = p_parse_block_stmts(p)
            return EClosure(params, TyMissing(tok.span), body, tok.span)
          }
          _ => {
            let body_e = p_parse_expr(p)
            return EClosure(
              params,
              TyMissing(tok.span),
              [SExpr(body_e, arrow_tok.span)],
              tok.span,
            )
          }
        }
      }
      let _ = p_advance(p)
      if p_match_kind_rparen(p) {
        return EUnit(tok.span)
      }
      let first = p_parse_expr(p)
      if p_match_kind_comma(p) {
        let elems : Array[Expr] = [first]
        while !p_is_eof(p) {
          match p_peek_kind(p) {
            RParen => {
              let _ = p_advance(p)
              break
            }
            _ => {
              elems.push(p_parse_expr(p))
              if !p_match_kind_comma(p) {
                p_expect_rparen(p)
                break
              }
            }
          }
        }
        ETuple(elems, tok.span)
      } else {
        p_expect_rparen(p)
        first
      }
    }
    LBracket => {
      let _ = p_advance(p)
      let elems : Array[Expr] = []
      while !p_is_eof(p) {
        match p_peek_kind(p) {
          RBracket => {
            let _ = p_advance(p)
            break
          }
          _ => {
            elems.push(p_parse_expr(p))
            if !p_match_kind_comma(p) {
              if !p_match_kind_rbracket(p) {
                let t2 = p_peek(p)
                p_err(
                  p,
                  t2.span,
                  "expected `,` or `]` in array literal",
                  "`,` or `]`",
                  t2.raw,
                  "close array literal with `]`",
                )
              }
              break
            }
          }
        }
      }
      EArrayLit(elems, tok.span)
    }
    LBrace =>
      if p_looks_like_struct_lit(p) {
        let sp_f = p_parse_struct_lit_fields(p)
        EStructLit("", sp_f.spread, sp_f.fields, tok.span)
      } else {
        let stmts = p_parse_block_stmts(p)
        EBlock(stmts, tok.span)
      }
    Dot =>
      match p_peek_at(p, 1).kind {
        Ident(vname) => {
          let _ = p_advance(p)
          let _ = p_advance(p)
          let args = match p_peek_kind(p) {
            LParen => p_parse_arg_list(p)
            _ => []
          }
          EDotVariant(vname, args, tok.span)
        }
        _ => {
          let next_tok = p_peek_at(p, 1)
          p_err(
            p,
            tok.span,
            "expected variant name after `.`",
            "variant identifier",
            next_tok.raw,
            "write `.Variant` or `.Variant(args...)`",
          )
          let _ = p_advance(p)
          EUnit(tok.span)
        }
      }
    Lt =>
      match p_peek_at(p, 1).kind {
        Gt => p_parse_jsx_fragment(p, tok.span)
        Ident(_) => p_parse_jsx_element(p, tok.span)
        _ => {
          p_err(
            p,
            tok.span,
            "expected expression, found `" + tok.raw + "`",
            "expression",
            tok.raw,
            "provide a valid expression",
          )
          if !p_is_eof(p) {
            let _ = p_advance(p)
          }
          EUnit(tok.span)
        }
      }
    Ident(name) => {
      if name == "function" && p_looks_like_js_fn_expr(p) {
        let _ = p_advance(p)
        p_err_code(
          p,
          tok.span,
          "E_HABIT_JS_FUNCTION",
          "Pion uses `fn` (not `function`) for closures",
          "`fn(...) { ... }`",
          "`function(...) { ... }`",
          "replace `function` with `fn`",
        )
        p_add_edit(
          p,
          text_edit_replace(
            tok.span.file,
            tok.span.line,
            tok.span.col,
            tok.span.line,
            tok.span.col + 8,
            "fn",
            "machine",
          ),
        )
        let params = p_parse_params(p)
        let ret_ty = if p_match_kind_arrow(p) {
          p_parse_type_expr(p)
        } else {
          TyMissing(p_peek(p).span)
        }
        let body = p_parse_block_stmts(p)
        return EClosure(params, ret_ty, body, tok.span)
      }
      if !p.in_match_guard {
        match p_peek_at(p, 1).kind {
          FatArrow => {
            let _ = p_advance(p)
            let arrow_tok = p_advance(p)
            p_err_code(
              p,
              tok.span,
              "E_HABIT_ARROW_FN",
              "Pion uses `fn(" + name + ") { ... }` for closures, not arrow syntax `" + name + " => ...`",
              "`fn(" + name + ") { ... }`",
              "`" + name + " => ...`",
              "replace `" + name + " => ...` with `fn(" + name + ") { ... }`",
            )
            let ps = [
              Param::{
                name: name,
                is_mut: false,
                is_into: false,
                ty: TyMissing(tok.span),
                label_kind: 0,
                default_expr: None,
                span: tok.span,
              },
            ]
            match p_peek_kind(p) {
              LBrace => {
                let body = p_parse_block_stmts(p)
                return EClosure(ps, TyMissing(tok.span), body, tok.span)
              }
              _ => {
                let body_e = p_parse_expr(p)
                return EClosure(
                  ps,
                  TyMissing(tok.span),
                  [SExpr(body_e, arrow_tok.span)],
                  tok.span,
                )
              }
            }
          }
          _ => ()
        }
      }
      let _ = p_advance(p)
      if p_match_kind_coloncolon(p) {
        match p_peek_kind(p) {
          LBrace => {
            let sp_f = p_parse_struct_lit_fields(p)
            EStructLit(name, sp_f.spread, sp_f.fields, tok.span)
          }
          _ => {
            let mem = p_expect_ident(p, "member name after `::`")
            if p_match_kind_coloncolon(p) {
              match p_peek_kind(p) {
                LBrace => {
                  let sp_f = p_parse_struct_lit_fields(p)
                  EStructLit(name + "::" + mem, sp_f.spread, sp_f.fields, tok.span)
                }
                _ => {
                  let mem2 = p_expect_ident(p, "member name after `::`")
                  EPath(name + "::" + mem, mem2, tok.span)
                }
              }
            } else {
              EPath(name, mem, tok.span)
            }
          }
        }
      } else {
        EIdent(name, tok.span)
      }
    }
    _ => {
      p_err(
        p,
        tok.span,
        "expected expression, found `" + tok.raw + "`",
        "expression",
        tok.raw,
        "provide a valid expression",
      )
      if !p_is_eof(p) {
        let _ = p_advance(p)
      }
      EUnit(tok.span)
    }
  }
}

///|
pub fn default_import_alias(pkg_path : String) -> String {
  let len = pkg_path.length()
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if str_code_at(pkg_path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  if last_slash >= 0 && last_slash + 1 < len {
    slice_str(pkg_path, last_slash + 1, len)
  } else {
    pkg_path
  }
}

///|
fn p_parse_import_decl(p : Parser, start_span : Span) -> ImportDecl {
  let _ = p_advance(p) // consume 'import'
  let path_tok = p_peek(p)
  let pkg_path = match path_tok.kind {
    StringLit(s) => {
      let _ = p_advance(p)
      s
    }
    _ => {
      p_err(
        p,
        path_tok.span,
        "expected package path string after `import`, found `" + path_tok.raw + "`",
        "string literal",
        path_tok.raw,
        "write `import \"pkg_name\"`",
      )
      ""
    }
  }
  let alias_name = match p_peek_kind(p) {
    KwAs => {
      let _ = p_advance(p)
      p_expect_ident(p, "import alias")
    }
    _ => default_import_alias(pkg_path)
  }
  ImportDecl::{ path: pkg_path, alias_name: alias_name, span: start_span }
}

///|
fn p_parse_test_decl(p : Parser, start_span : Span, is_bench : Bool) -> Decl {
  let _ = p_advance(p) // consume contextual 'test' or 'bench'
  let kw = if is_bench { "bench" } else { "test" }
  let name_tok = p_peek(p)
  let tname = match name_tok.kind {
    StringLit(s) => {
      let _ = p_advance(p)
      s
    }
    _ => {
      p_err(
        p,
        name_tok.span,
        "expected " + kw + " name string after `" + kw + "`, found `" + name_tok.raw + "`",
        "string literal",
        name_tok.raw,
        "write `" + kw + " \"name\" { ... }`",
      )
      "<unnamed>"
    }
  }
  let body = p_parse_block_stmts(p)
  DTest(TestDecl::{ name: tname, body: body, span: start_span, is_bench: is_bench })
}

///|
///|
pub struct DeclAttrs {
  derive_eq : Bool
  no_io : Bool
  into_attr : Bool
  verify : Bool
  verify_opaque : Bool
  /// File-level inner attribute `#![verify]`.
  file_verify : Bool
}

///|
fn p_parse_decl_attrs(p : Parser) -> DeclAttrs {
  let mut derive_eq = false
  let mut no_io = false
  let mut into_attr = false
  let mut verify = false
  let mut verify_opaque = false
  let mut file_verify = false
  while !p_is_eof(p) {
    match p_peek_kind(p) {
      Hash => {
        let hash_sp = p_advance(p).span
        let is_inner = match p_peek_kind(p) {
          Bang => {
            let _ = p_advance(p)
            true
          }
          _ => false
        }
        let has_bracket = p_match_kind_lbracket(p)
        let attr_name = match p_peek_kind(p) {
          Ident(s) => {
            let _ = p_advance(p)
            s
          }
          _ => ""
        }
        let is_known_attr = attr_name == "derive" ||
          attr_name == "no_io" ||
          attr_name == "render_thread" ||
          attr_name == "into" ||
          attr_name == "verify" ||
          attr_name == "verify_opaque"
        if p_match_kind_lparen(p) {
          let mut pdepth = 1
          while !p_is_eof(p) && pdepth > 0 {
            let before = p.pos
            match p_peek_kind(p) {
              LParen => {
                let _ = p_advance(p)
                pdepth = pdepth + 1
              }
              RParen => {
                let _ = p_advance(p)
                pdepth = pdepth - 1
              }
              Ident(tr) => {
                let _ = p_advance(p)
                if pdepth == 1 && attr_name == "derive" && tr == "Eq" {
                  derive_eq = true
                }
                let _ = p_match_kind_comma(p)
              }
              _ => {
                let _ = p_advance(p)
              }
            }
            if p.pos == before {
              let _ = p_advance(p)
            }
          }
        } else if attr_name == "no_io" || attr_name == "render_thread" {
          no_io = true
        } else if attr_name == "into" {
          into_attr = true
        } else if attr_name == "verify" {
          if is_inner {
            file_verify = true
          } else {
            verify = true
          }
        } else if attr_name == "verify_opaque" {
          verify_opaque = true
        }
        if has_bracket {
          if !is_known_attr {
            p_err_code(
              p,
              hash_sp,
              "E_HABIT_RUST_ATTR",
              "unsupported Rust-style attribute `#[" +
              attr_name +
              "]`; Pion supports `#derive(Eq)`, `#no_io`, `#render_thread`, `#into`, `#verify`, `#verify_opaque`",
              "supported Pion `#attr`",
              "`#[" + attr_name + "]`",
              if attr_name == "test" {
                "use `test \"name\" { ... }` instead of `#[test] fn ...`"
              } else {
                "remove `#[" + attr_name + "]` or use a supported Pion `#attr`"
              },
            )
          }
          while !p_is_eof(p) {
            match p_peek_kind(p) {
              RBracket => {
                let _ = p_advance(p)
                break
              }
              _ => {
                let _ = p_advance(p)
              }
            }
          }
        }
        p_skip_semis(p)
      }
      _ => break
    }
  }
  DeclAttrs::{
    derive_eq: derive_eq,
    no_io: no_io,
    into_attr: into_attr,
    verify: verify,
    verify_opaque: verify_opaque,
    file_verify: file_verify,
  }
}

///|
/// `#![verify]` (the lowering of `[verify] enabled = true`): every top-level
/// `fn`, method and `impl` method of the file is `#verify` unless it is
/// `#verify_opaque`.
fn p_apply_file_verify(decls : Array[Decl]) -> Unit {
  let mut i = 0
  while i < decls.length() {
    match decls[i] {
      DFn(fd) => if !fd.is_verify_opaque { fd.is_verify = true }
      DImpl(id) => {
        let mut j = 0
        while j < id.methods.length() {
          let md = id.methods[j]
          if !md.is_verify_opaque {
            md.is_verify = true
          }
          j = j + 1
        }
      }
      _ => ()
    }
    i = i + 1
  }
}

///|
pub fn parse_source(path : String, source : String) -> ParseResult {
  let lex_res = lex(path, source)
  let p = parser_new(lex_res.tokens, lex_res.diagnostics)
  let imports : Array[ImportDecl] = []
  let decls : Array[Decl] = []
  let mut file_verify = false

  while !p_is_eof(p) {
    p_skip_semis(p)
    if p_is_eof(p) {
      break
    }
    let attrs = p_parse_decl_attrs(p)
    let derive_eq = attrs.derive_eq
    if attrs.file_verify {
      file_verify = true
    }
    if p_is_eof(p) {
      break
    }
    let start_span = p_peek(p).span
    match p_peek_kind(p) {
      KwImport => {
        imports.push(p_parse_import_decl(p, start_span))
        continue
      }
      _ => ()
    }
    let mut is_pub = false
    match p_peek_kind(p) {
      KwPub => {
        is_pub = true
        let _ = p_advance(p)
      }
      _ => ()
    }
    let mut is_val = false
    match p_peek_kind(p) {
      KwVal => {
        is_val = true
        let _ = p_advance(p)
      }
      _ => ()
    }
    let tok = p_peek(p)
    match tok.kind {
      KwStruct =>
        decls.push(p_parse_struct_decl(p, is_pub, is_val, derive_eq, start_span))
      KwEnum => {
        if is_val {
          p_err(
            p,
            start_span,
            "`val` modifier is only allowed on `struct` declarations",
            "`struct`",
            "`enum`",
            "remove `val` before `enum`",
          )
        }
        decls.push(p_parse_enum_decl(p, is_pub, derive_eq, start_span))
      }
      KwFn => decls.push(p_parse_fn_decl(p, is_pub, attrs, start_span))
      KwExtern => decls.push(p_parse_extern_fn_decl(p, is_pub, start_span))
      KwTrait => decls.push(p_parse_trait_decl(p, is_pub, start_span))
      KwImpl => decls.push(p_parse_impl_decl(p, is_pub, attrs.verify, start_span))
      KwLet => decls.push(p_parse_const_decl(p, is_pub, start_span))
      Ident(kw) => {
        let next_is_str = match p_peek_at(p, 1).kind {
          StringLit(_) => true
          _ => false
        }
        if !is_pub && !is_val && (kw == "test" || kw == "bench") && next_is_str {
          decls.push(p_parse_test_decl(p, start_span, kw == "bench"))
        } else if !is_val && kw == "const" {
          p_err_code(
            p,
            tok.span,
            "E_HABIT_JS_CONST",
            "Pion uses `let` (not `const`) for immutable bindings and top-level constants",
            "`let`",
            "`const`",
            "replace `const` with `let`",
          )
          p_add_edit(
            p,
            text_edit_replace(
              tok.span.file,
              tok.span.line,
              tok.span.col,
              tok.span.line,
              tok.span.col + 5,
              "let",
              "machine",
            ),
          )
          decls.push(p_parse_const_decl(p, is_pub, start_span))
        } else if !is_val && kw == "function" {
          p_err_code(
            p,
            tok.span,
            "E_HABIT_JS_FUNCTION",
            "Pion uses `fn` (not `function`) to declare functions",
            "`fn`",
            "`function`",
            "replace `function` with `fn`",
          )
          p_add_edit(
            p,
            text_edit_replace(
              tok.span.file,
              tok.span.line,
              tok.span.col,
              tok.span.line,
              tok.span.col + 8,
              "fn",
              "machine",
            ),
          )
          decls.push(p_parse_fn_decl(p, is_pub, attrs, start_span))
        } else {
          p_err(
            p,
            tok.span,
            "expected top-level declaration (`import`, `fn`, `struct`, `enum`, `let`, `test`), found `" +
            tok.raw +
            "`",
            "top-level declaration",
            tok.raw,
            "start a declaration with `import`, `fn`, `struct`, `enum`, `let`, or `test`",
          )
          let _ = p_advance(p)
          p_sync_top(p)
        }
      }
      _ => {
        p_err(
          p,
          tok.span,
          "expected top-level declaration (`import`, `fn`, `struct`, `enum`, `let`, `test`), found `" +
          tok.raw +
          "`",
          "top-level declaration",
          tok.raw,
          "start a declaration with `import`, `fn`, `struct`, `enum`, `let`, or `test`",
        )
        let _ = p_advance(p)
        p_sync_top(p)
      }
    }
  }

  if file_verify {
    p_apply_file_verify(decls)
  }
  ParseResult::{
    file: SourceFile::{ path: path, imports: imports, decls: decls },
    diagnostics: p.diagnostics,
  }
}
