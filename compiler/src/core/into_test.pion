///| Tests for Track P3: opt-in single-hop `#into` converters and `into` parameter modifier.

///|
fn into_has_code(diags : Array[Diagnostic], code : String) -> Bool {
  let mut i = 0
  while i < diags.length() {
    if diags[i].code == code {
      return true
    }
    i = i + 1
  }
  false
}

///|
fn into_has_msg(diags : Array[Diagnostic], sub : String) -> Bool {
  let mut i = 0
  while i < diags.length() {
    match t_str_find(diags[i].message, sub) {
      Some(_) => return true
      None => ()
    }
    i = i + 1
  }
  false
}

///|
test "into: contextual keyword preserves variable and param named into" {
  let src =
    "fn id(into : Int) -> Int {\n" +
    "  let mut x = into\n" +
    "  let into = x + 42\n" +
    "  into\n" +
    "}\n"
  let r = check_source_files("main", ["main.pion"], [src])
  assert_eq(r.diagnostics.length(), 0)
}

///|
test "into: parse errors on mut+into, extern C, and closures" {
  let src1 = "fn f(into mut x : Int) -> Int { x }\n"
  let r1 = check_source_files("main", ["main.pion"], [src1])
  assert_eq(into_has_code(r1.diagnostics, "E_PARSE"), true)

  let src2 = "fn f(mut into x : Int) -> Int { x }\n"
  let r2 = check_source_files("main", ["main.pion"], [src2])
  assert_eq(into_has_code(r2.diagnostics, "E_PARSE"), true)

  let src3 = "extern \"C\" fn c_fn(into x : Int) -> Int\n"
  let r3 = check_source_files("main", ["main.pion"], [src3])
  assert_eq(into_has_code(r3.diagnostics, "E_PARSE"), true)

  let src4 = "fn g() -> Unit { let f = fn(into x : Int) -> Int { x }; let _ = f }\n"
  let r4 = check_source_files("main", ["main.pion"], [src4])
  assert_eq(into_has_code(r4.diagnostics, "E_PARSE"), true)
}

///|
test "into: E_INVALID_INTO signature validation" {
  // Free function
  let s_free = "#into\nfn free_conv(x : Int) -> String { x.to_string() }\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_free]).diagnostics, "E_INVALID_INTO"), true)

  // 2 parameters
  let s_two =
    "struct Box { v : Int }\n" +
    "#into\nfn Box::from_two(a : Int, b : Int) -> Box { Box::{ v: a + b } }\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_two]).diagnostics, "E_INVALID_INTO"), true)

  // mut parameter
  let s_mut =
    "struct Box { v : Int }\n" +
    "#into\nfn Box::from_mut(mut a : Int) -> Box { Box::{ v: a } }\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_mut]).diagnostics, "E_INVALID_INTO"), true)

  // World parameter
  let s_world =
    "struct Box { v : Int }\n" +
    "#into\nfn Box::from_world(w : World) -> Box { let _ = w; Box::{ v: 0 } }\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_world]).diagnostics, "E_INVALID_INTO"), true)

  // Wrong return type on static fn
  let s_ret =
    "struct A { v : Int }\n" +
    "struct B { v : Int }\n" +
    "#into\nfn A::from_int(x : Int) -> B { B::{ v: x } }\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_ret]).diagnostics, "E_INVALID_INTO"), true)

  // Trait impl method
  let s_impl =
    "trait Tr { fn go(self : Self) -> Int }\n" +
    "struct A { v : Int }\n" +
    "impl Tr for A {\n" +
    "  #into\n" +
    "  fn go(self : A) -> Int { self.v }\n" +
    "}\n"
  assert_eq(into_has_code(check_source_files("main", ["m.pion"], [s_impl]).diagnostics, "E_INVALID_INTO"), true)
}

///|
test "into: builtin String->StrView and Bytes->BytesView and non-into rejection" {
  let ok_src =
    "fn take_sv(into s : StrView) -> Int { s.length() }\n" +
    "fn take_bv(into b : BytesView) -> Int { b.length() }\n" +
    "fn caller(s : String, b : Bytes) -> Int {\n" +
    "  take_sv(s) + take_sv(s.as_view()) + take_bv(b) + take_bv(b.as_view())\n" +
    "}\n"
  let r_ok = check_source_files_full("main", ["main.pion"], [ok_src])
  assert_eq(r_ok.diagnostics.length(), 0)
  let qbe = emit_qbe_package_with_tc(r_ok.pkg, r_ok.tc, false)
  assert_eq(qbe.ssa.length() > 0, true)
  // P77-B/P81: `take_sv(s)` desugars to `take_sv(s.as_view())` and uses stack view (no heap pion_str_view)
  let sv_zero_alloc_src =
    "fn take_sv(into s : StrView) -> Int { s.length() }\n" +
    "fn caller(s : String) -> Int { take_sv(s) }\n"
  let r_za = check_source_files_full("main", ["main.pion"], [sv_zero_alloc_src])
  assert_eq(r_za.diagnostics.length(), 0)
  let qbe_za = emit_qbe_package_with_tc(r_za.pkg, r_za.tc, true)
  assert_eq(qbe_za.ssa.contains("pion_str_view"), false)

  // Without `into`, String must NOT implicitly convert to StrView
  let bad_src =
    "fn strict_sv(s : StrView) -> Int { s.length() }\n" +
    "fn caller(s : String) -> Int { strict_sv(s) }\n"
  let r_bad = check_source_files("main", ["main.pion"], [bad_src])
  assert_eq(into_has_code(r_bad.diagnostics, "E_TYPE_MISMATCH"), true)
}

///|
test "into: Tier 1 beats Tier 2, ambiguous same-tier reports E_AMBIGUOUS_INTO, 1-hop only" {
  // Tier 1 (concrete String) beats Tier 2 (bare T)
  let t1_wins =
    "enum AnyVal { Str(String); Other }\n" +
    "#into\nfn AnyVal::from_str(s : String) -> AnyVal { AnyVal::Str(s) }\n" +
    "#into\nfn AnyVal::from_any[T](v : T) -> AnyVal { let _ = v; AnyVal::Other }\n" +
    "fn take(into x : AnyVal) -> Int {\n" +
    "  match x { .Str(s) => s.length(); .Other => 0 }\n" +
    "}\n" +
    "fn use_it() -> Int { take(\"hi\") + take(123) }\n"
  let r1 = check_source_files("main", ["main.pion"], [t1_wins])
  assert_eq(r1.diagnostics.length(), 0)

  // Ambiguous Tier 1 (two concrete converters for Int -> Box)
  let amb_src =
    "struct Box { v : Int }\n" +
    "#into\nfn Box::from_a(x : Int) -> Box { Box::{ v: x } }\n" +
    "#into\nfn Box::from_b(x : Int) -> Box { Box::{ v: x + 1 } }\n" +
    "fn take(into b : Box) -> Int { b.v }\n" +
    "fn use_it() -> Int { take(1) }\n"
  let r_amb = check_source_files("main", ["main.pion"], [amb_src])
  assert_eq(into_has_code(r_amb.diagnostics, "E_AMBIGUOUS_INTO"), true)
  assert_eq(into_has_msg(r_amb.diagnostics, "Box::from_a"), true)
  assert_eq(into_has_msg(r_amb.diagnostics, "Box::from_b"), true)

  // Strict 1-hop: A -> B -> C must NOT chain
  let hop_src =
    "struct A { v : Int }\n" +
    "struct B { v : Int }\n" +
    "struct C { v : Int }\n" +
    "#into\nfn B::from_a(a : A) -> B { B::{ v: a.v } }\n" +
    "#into\nfn C::from_b(b : B) -> C { C::{ v: b.v } }\n" +
    "fn take_c(into c : C) -> Int { c.v }\n" +
    "fn use_it(a : A) -> Int { take_c(a) }\n"
  let r_hop = check_source_files("main", ["main.pion"], [hop_src])
  assert_eq(into_has_code(r_hop.diagnostics, "E_TYPE_MISMATCH"), true)
}

///|
test "into: pionsig v1 roundtrip, backward compat, and 3-pkg cross-pkg isolation" {
  // Package A: defines Live[T] + ReadSignal[T] + #into converters
  let pkg_a_src =
    "pub struct ReadSignal[T] { pub v : T }\n" +
    "pub fn ReadSignal::get[T](self : ReadSignal[T]) -> T { self.v }\n" +
    "pub enum Live[T] { Is(T); Fn(() -> T) }\n" +
    "#into\npub fn Live::of_value[T](v : T) -> Live[T] { Live::Is(v) }\n" +
    "#into\npub fn Live::of_fn[T](f : () -> T) -> Live[T] { Live::Fn(f) }\n" +
    "#into\npub fn Live::of_signal[T](s : ReadSignal[T]) -> Live[T] { Live::Fn(fn() -> T { s.get() }) }\n" +
    "pub struct Tag { pub id : Int }\n" +
    "#into\npub fn Tag::from_int(n : Int) -> Tag { Tag::{ id: n } }\n"
  let cr_a = check_source_files_with_imports("pkg_a", ["a.pion"], [pkg_a_src], [], true)
  assert_eq(cr_a.diagnostics.length(), 0)

  // Verify .pionsig v1 serialization & parsing roundtrip
  let sig_a = emit_pionsig(cr_a.pkg)
  match t_str_find(sig_a, "#into fn Live::of_value[T](v: T) -> Live[T]") {
    Some(_) => ()
    None => abort("expected #into fn in pionsig: " + sig_a)
  }
  match parse_pionsig(sig_a) {
    Ok(parsed) => assert_eq(parsed.pkg, "pkg_a")
    Err(e) => abort("parse_pionsig failed: " + e)
  }

  // Package B: imports A, declares component with `into` params + `into bg?`
  let pkg_b_src =
    "import \"pkg_a\" as a\n" +
    "pub fn Text(into text~ : a::Live[String] = .Is(\"\"), into bg? : a::Live[Int64]) -> Int {\n" +
    "  let _ = text\n" +
    "  let _ = bg\n" +
    "  1\n" +
    "}\n" +
    "pub fn use_tag(into t : a::Tag) -> Int { t.id }\n"
  let cr_b = check_source_files_with_imports(
    "pkg_b",
    ["b.pion"],
    [pkg_b_src],
    [imported_pkg_new("pkg_a", cr_a.tc)],
    true,
  )
  assert_eq(cr_b.diagnostics.length(), 0)

  // Verify .pionsig & .pionstub for pkg_b preserve `into` param modifier
  let sig_b = emit_pionsig(cr_b.pkg)
  match t_str_find(sig_b, "into t: a::Tag") {
    Some(_) => ()
    None => abort("expected `into t: a::Tag` in pionsig: " + sig_b)
  }
  let stub_b = emit_file_stub(cr_b.pkg.files[0])
  match t_str_find(stub_b, "into t : a::Tag") {
    Some(_) => ()
    None => abort("expected `into t : a::Tag` in pionstub: " + stub_b)
  }

  // Package C: imports A & B, calls Text via JSX with all 4 forms + optional `into bg?`
  let pkg_c_src =
    "import \"pkg_a\" as a\n" +
    "import \"pkg_b\" as b\n" +
    "pub fn render(status : a::ReadSignal[String], n : a::ReadSignal[Int]) -> Int {\n" +
    "  let _ = <b::Text text=\"hi\" bg={100L} />\n" +
    "  let _ = <b::Text text={status} />\n" +
    "  let _ = <b::Text text=>{ \"Done: \\{n.get()}\" } />\n" +
    "  let _ = <b::Text text={.Is(\"raw\")} />\n" +
    "  b::use_tag(7)\n" +
    "}\n"
  let cr_c = check_source_files_with_imports(
    "pkg_c",
    ["c.pion"],
    [pkg_c_src],
    [imported_pkg_new("pkg_a", cr_a.tc), imported_pkg_new("pkg_b", cr_b.tc)],
    true,
  )
  assert_eq(cr_c.diagnostics.length(), 0)

  // Unrelated third package X defines its own type with `#into`; importing X must NOT affect A/B
  let pkg_x_src =
    "pub struct Unrelated { pub v : Int }\n" +
    "#into\npub fn Unrelated::from_str(s : String) -> Unrelated { Unrelated::{ v: s.length() } }\n"
  let cr_x = check_source_files_with_imports("pkg_x", ["x.pion"], [pkg_x_src], [], true)
  assert_eq(cr_x.diagnostics.length(), 0)
  let pkg_bad_src =
    "import \"pkg_a\" as a\n" +
    "import \"pkg_b\" as b\n" +
    "import \"pkg_x\" as x\n" +
    "pub fn bad() -> Int {\n" +
    "  let _ = x::Unrelated::{ v: 1 }\n" +
    "  b::use_tag(\"not_an_int\")\n" +
    "}\n"
  let cr_bad = check_source_files_with_imports(
    "pkg_bad",
    ["bad.pion"],
    [pkg_bad_src],
    [
      imported_pkg_new("pkg_a", cr_a.tc),
      imported_pkg_new("pkg_b", cr_b.tc),
      imported_pkg_new("pkg_x", cr_x.tc),
    ],
    true,
  )
  assert_eq(into_has_code(cr_bad.diagnostics, "E_TYPE_MISMATCH"), true)
}

///|
test "into: ETry (?) error conversion via static #into and instance #into method" {
  let src =
    "struct IoErr { code : Int }\n" +
    "struct ParseErr { line : Int }\n" +
    "enum AppErr { Io(Int); Parse(Int) }\n" +
    "#into\nfn AppErr::from_io(e : IoErr) -> AppErr { AppErr::Io(e.code) }\n" +
    "#into\nfn ParseErr::to_app(self : ParseErr) -> AppErr { AppErr::Parse(self.line) }\n" +
    "fn read_io() -> Result[Int, IoErr] { Err(IoErr::{ code: 404 }) }\n" +
    "fn parse_x() -> Result[Int, ParseErr] { Err(ParseErr::{ line: 12 }) }\n" +
    "fn run(flag : Bool) -> Result[Int, AppErr] {\n" +
    "  if flag {\n" +
    "    let a = read_io()?\n" +
    "    Ok(a)\n" +
    "  } else {\n" +
    "    let b = parse_x()?\n" +
    "    Ok(b)\n" +
    "  }\n" +
    "}\n"
  let cr = check_source_files_full("main", ["main.pion"], [src])
  assert_eq(cr.diagnostics.length(), 0)
  let qbe = emit_qbe_package_with_tc(cr.pkg, cr.tc, false)
  assert_eq(qbe.ssa.length() > 0, true)
}

///|
test "into: bracketed #[into] allowed without E_HABIT_RUST_ATTR while #[inline] still reports it" {
  let ok_src =
    "struct Text { raw : String }\n" +
    "#[into]\n" +
    "fn Text::from_str(s : String) -> Text { Text::{ raw: s } }\n" +
    "fn take(into t : Text) -> String { t.raw }\n" +
    "fn main() -> String { take(\"ok\") }\n"
  let cr_ok = check_source_files_full("main", ["main.pion"], [ok_src])
  assert_eq(cr_ok.diagnostics.length(), 0)

  let bad_src =
    "#[inline]\n" +
    "fn f(x : Int) -> Int { x + 1 }\n"
  let cr_bad = check_source_files_full("main", ["main.pion"], [bad_src])
  assert_eq(into_has_code(cr_bad.diagnostics, "E_HABIT_RUST_ATTR"), true)
}
