///| Native QBE SSA post-pass:
///| 1. `cleanup_native_rc_ssa` (dev & release, zero new basic blocks):
///|    - Same-block strict-whitelist `pion_rc_inc(%x) ... pion_rc_dec(%x)` pair cancellation.
///|    - Multi-definition-safe elimination of RC on proven NULL / static immortal values
///|      (literal `0`, `$pion_str_*_hdr`, `$pion_none_hdr`, `$pion_enum_*_hdr`), through
///|      copies, phis and private stack slots.
///| 2. `inline_native_rc_ssa` (native `--release` only):
///|    - Runs `cleanup_native_rc_ssa` per function,
///|    - Enforces `Int64` product budget `est_blk * est_tmp <= 2^28`,
///|    - Expands remaining RC ops with zero-extra-block `phi` fast path covering
///|      both `owner_tid != 0` (`local_rc` at `-20`) and single-threaded frozen
///|      objects (`owner_tid == 0 && !(flags & 2)`, `shared_rc` at `-16`).
///| Stage-0 bootstrap safe (pure Pion, zero external dependencies).

///|
/// `slice_str` with an ASCII fast path. QBE SSA is almost all ASCII: such
/// ranges take a byte slice (and the full range reuses `s`) instead of
/// re-encoding one char at a time through a `StringBuilder`. A range with any
/// non-ASCII code unit falls back to `slice_str`, so the result is the same
/// on both hosts.
fn irc_slice(s : String, start : Int, end : Int) -> String {
  if end <= start {
    return ""
  }
  let mut i = start
  while i < end {
    if s.code_unit_at(i) >= 128 {
      return slice_str(s, start, end)
    }
    i = i + 1
  }
  if start == 0 && end == s.length() {
    s
  } else {
    s.slice(start, end)
  }
}

///|
fn irc_is_ws(c : Int) -> Bool {
  c == 32 || c == 9 || c == 13
}

///|
/// QBE identifier continuation characters (`vendor/qbe/parse.c:329`): `[A-Za-z0-9._$]`.
fn irc_is_qbe_ident_char(c : Int) -> Bool {
  (c >= 97 && c <= 122) ||
  (c >= 65 && c <= 90) ||
  (c >= 48 && c <= 57) ||
  c == 95 ||
  c == 46 ||
  c == 36
}

///|
fn irc_is_label_char(c : Int) -> Bool {
  irc_is_qbe_ident_char(c)
}

///|
fn irc_trim(s : String) -> String {
  let n = s.length()
  let mut start = 0
  while start < n && irc_is_ws(str_code_at(s, start)) {
    start = start + 1
  }
  let mut end = n
  while end > start && irc_is_ws(str_code_at(s, end - 1)) {
    end = end - 1
  }
  if start == 0 && end == n {
    s
  } else {
    irc_slice(s, start, end)
  }
}

///|
fn irc_starts_with(s : String, pre : String) -> Bool {
  let sl = s.length()
  let pl = pre.length()
  if sl < pl {
    return false
  }
  let mut i = 0
  while i < pl {
    if str_code_at(s, i) != str_code_at(pre, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn irc_ends_with(s : String, suf : String) -> Bool {
  let sl = s.length()
  let sufl = suf.length()
  if sl < sufl {
    return false
  }
  let off = sl - sufl
  let mut i = 0
  while i < sufl {
    if str_code_at(s, off + i) != str_code_at(suf, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn irc_split_lines(s : String) -> Array[String] {
  let lines : Array[String] = []
  let n = s.length()
  let mut start = 0
  let mut i = 0
  while i < n {
    if str_code_at(s, i) == 10 {
      lines.push(irc_slice(s, start, i))
      start = i + 1
    }
    i = i + 1
  }
  if start < n {
    lines.push(irc_slice(s, start, n))
  }
  lines
}

///|
fn irc_is_valid_qbe_val(arg : String) -> Bool {
  let n = arg.length()
  if n < 2 {
    return false
  }
  let c0 = str_code_at(arg, 0)
  if c0 != 37 && c0 != 36 {
    return false
  }
  let mut i = 1
  while i < n {
    let c = str_code_at(arg, i)
    if irc_is_ws(c) || c == 44 || c == 41 || c == 40 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn irc_is_valid_qbe_tmp(arg : String) -> Bool {
  arg.length() >= 2 && str_code_at(arg, 0) == 37 && irc_is_valid_qbe_val(arg)
}

///|
fn irc_is_static_immortal_hdr(sym : String) -> Bool {
  sym == "$pion_none_hdr" ||
  (irc_ends_with(sym, "_hdr") &&
    (irc_starts_with(sym, "$pion_str_") || irc_starts_with(sym, "$pion_enum_")))
}

///|
fn irc_is_immortal_arg(arg : String, immortal_regs : Map[String, Bool]) -> Bool {
  match immortal_regs.get(arg) {
    Some(b) => b
    None => false
  }
}

///|
fn irc_is_pure_reg_op(op : String) -> Bool {
  op == "copy" ||
  op == "neg" ||
  op == "add" ||
  op == "sub" ||
  op == "mul" ||
  op == "udiv" ||
  op == "div" ||
  op == "urem" ||
  op == "rem" ||
  op == "and" ||
  op == "or" ||
  op == "xor" ||
  op == "shl" ||
  op == "shr" ||
  op == "sar" ||
  op == "ror" ||
  op == "extsb" ||
  op == "extub" ||
  op == "extsh" ||
  op == "extuh" ||
  op == "extsw" ||
  op == "extuw" ||
  op == "exts" ||
  op == "truncd" ||
  op == "stosi" ||
  op == "stoui" ||
  op == "dtosi" ||
  op == "dtoui" ||
  op == "swtof" ||
  op == "uwtof" ||
  op == "sltof" ||
  op == "ultof" ||
  op == "cast" ||
  op == "ceqw" ||
  op == "cnew" ||
  op == "cslew" ||
  op == "csltw" ||
  op == "csgew" ||
  op == "csgtw" ||
  op == "culew" ||
  op == "cultw" ||
  op == "cugew" ||
  op == "cugtw" ||
  op == "ceql" ||
  op == "cnel" ||
  op == "cslel" ||
  op == "csltl" ||
  op == "csgel" ||
  op == "csgtl" ||
  op == "culel" ||
  op == "cultl" ||
  op == "cugel" ||
  op == "cugtl" ||
  op == "ceqs" ||
  op == "cnes" ||
  op == "cles" ||
  op == "clts" ||
  op == "cges" ||
  op == "cgts" ||
  op == "cos" ||
  op == "cuos" ||
  op == "ceqd" ||
  op == "cned" ||
  op == "cled" ||
  op == "cltd" ||
  op == "cged" ||
  op == "cgtd" ||
  op == "cod" ||
  op == "cuod"
}

///|
fn irc_is_load_op(op : String) -> Bool {
  op == "loadl" ||
  op == "loadw" ||
  op == "loadsw" ||
  op == "loaduw" ||
  op == "loadsh" ||
  op == "loaduh" ||
  op == "loadsb" ||
  op == "loadub" ||
  op == "loads" ||
  op == "loadd"
}

///|
fn irc_is_alloc_op(op : String) -> Bool {
  op == "alloc4" || op == "alloc8" || op == "alloc16"
}

///|
fn irc_is_nonneg_int_lit(s : String) -> Bool {
  let n = s.length()
  if n == 0 {
    return false
  }
  let mut i = 0
  while i < n {
    let c = str_code_at(s, i)
    if c < 48 || c > 57 {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn irc_find_char(s : String, start : Int, target : Int) -> Int {
  let n = s.length()
  let mut i = start
  while i < n {
    if str_code_at(s, i) == target {
      return i
    }
    i = i + 1
  }
  -1
}

///|
/// Exact match on runtime non-returning abort primitives (`runtime/pion_rt.h`).
/// Never prefix-match `$pion_panic` (which could match user `extern "C"` symbols
/// like `$pion_panic_probe`).
fn irc_is_panic_call(t : String) -> Bool {
  irc_ends_with(t, ")") &&
  (irc_starts_with(t, "call $pion_panic(") ||
    irc_starts_with(t, "call $pion_panic_oob("))
}

///|
fn irc_load_op_width(op : String) -> Int {
  if op == "loadub" || op == "loadsb" {
    1
  } else if op == "loaduh" || op == "loadsh" {
    2
  } else if op == "loadw" || op == "loadsw" || op == "loaduw" || op == "loads" {
    4
  } else if op == "loadl" || op == "loadd" {
    8
  } else {
    0
  }
}

///|
/// If `t` is `%lhs =<w|l|s|d> <rhs>`, returns `Some((lhs, ty_c, rhs))`.
fn irc_parse_typed_def(t : String) -> Option[(String, Int, String)] {
  let n = t.length()
  if n < 7 || str_code_at(t, 0) != 37 {
    return None
  }
  let mut eq_pos = -1
  let mut j = 1
  while j + 3 < n {
    let c = str_code_at(t, j)
    if c == 32 {
      if str_code_at(t, j + 1) == 61 && str_code_at(t, j + 3) == 32 {
        let kc = str_code_at(t, j + 2)
        if kc == 119 || kc == 108 || kc == 115 || kc == 100 {
          eq_pos = j
        }
      }
      break
    }
    if irc_is_ws(c) {
      break
    }
    j = j + 1
  }
  if eq_pos < 2 {
    return None
  }
  let lhs = irc_slice(t, 0, eq_pos)
  let ty_c = str_code_at(t, eq_pos + 2)
  let rhs = irc_trim(irc_slice(t, eq_pos + 4, n))
  if rhs.length() == 0 {
    return None
  }
  Some((lhs, ty_c, rhs))
}

///|
/// Strip QBE `# ...` comment (quote-aware for `"..."` globals/strings) and
/// surrounding whitespace.
fn irc_strip_comment(raw : String) -> String {
  if !raw.contains("#") {
    return irc_trim(raw)
  }
  let n = raw.length()
  let mut in_quote = false
  let mut escaped = false
  let mut i = 0
  while i < n {
    let c = str_code_at(raw, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 35 {
      return irc_trim(irc_slice(raw, 0, i))
    }
    i = i + 1
  }
  irc_trim(raw)
}

///|
/// Find `target` character outside double-quoted QBE strings/symbols.
fn irc_find_char_unquoted(s : String, start : Int, target : Int) -> Int {
  let n = s.length()
  let mut in_quote = false
  let mut escaped = false
  let mut i = start
  while i < n {
    let c = str_code_at(s, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == target {
      return i
    }
    i = i + 1
  }
  -1
}

///|
/// True if `t` starts with QBE keyword `kw` followed by any non-identifier
/// token separator (whitespace, `@`, `%`, `$`, `"`, `-`, etc., matching
/// `vendor/qbe/parse.c`).
fn irc_has_kw_sep(t : String, kw : String) -> Bool {
  irc_starts_with(t, kw) &&
  t.length() > kw.length() &&
  !irc_is_qbe_ident_char(str_code_at(t, kw.length()))
}

///|
/// Locate the index right after the `phi` opcode in `line[0..code_end)` by
/// scanning past the unquoted `=`, type specifier (`w`/`l`/`s`/`d` or `:T`),
/// and whitespace. Never mistakes a destination temp named `%phi` for a `phi`
/// instruction. Returns `-1` if `line` is not a `phi` instruction.
fn irc_find_phi_opcode_end(line : String, code_end : Int) -> Int {
  let mut eq = -1
  let mut in_quote = false
  let mut escaped = false
  let mut i = 0
  while i < code_end {
    let c = str_code_at(line, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 61 {
      eq = i
      break
    }
    i = i + 1
  }
  if eq < 0 {
    return -1
  }
  let mut p = eq + 1
  while p < code_end && irc_is_ws(str_code_at(line, p)) {
    p = p + 1
  }
  if p >= code_end {
    return -1
  }
  let tc = str_code_at(line, p)
  if tc == 58 {
    p = p + 1
    let ts = p
    while p < code_end && irc_is_qbe_ident_char(str_code_at(line, p)) {
      p = p + 1
    }
    if p == ts {
      return -1
    }
  } else if irc_is_qbe_ident_char(tc) {
    while p < code_end && irc_is_qbe_ident_char(str_code_at(line, p)) {
      p = p + 1
    }
  } else {
    return -1
  }
  while p < code_end && irc_is_ws(str_code_at(line, p)) {
    p = p + 1
  }
  if p + 3 <= code_end &&
    str_code_at(line, p) == 112 &&
    str_code_at(line, p + 1) == 104 &&
    str_code_at(line, p + 2) == 105 &&
    (p + 3 == code_end || !irc_is_qbe_ident_char(str_code_at(line, p + 3))) {
    p + 3
  } else {
    -1
  }
}

///|
/// True if a QBE instruction line is a `phi` instruction (`=... <ty> phi...`).
fn irc_line_has_phi(raw : String) -> Bool {
  let code_end = irc_strip_comment_end(raw, 0, raw.length())
  irc_find_phi_opcode_end(raw, code_end) >= 0
}

///|
struct IrcSafeInfo {
  def_count : Map[String, Int]
  valid_rc_objs : Map[String, Bool]
  safe_addrs : Map[String, Bool]
  dp_addr_of : Map[String, String]
}

///|
/// Collect uniquely-defined SSA temporaries proven to be unconditionally safe
/// load addresses:
/// - local stack slots (`alloc4`/`alloc8`/`alloc16`),
/// - proven RC heap object pointers (arguments to `$pion_rc_inc` and copies),
/// - non-negative literal offsets (`add %rc_obj, K`, `K >= 0`).
/// Also records `len_load_of`, `dp_addr_of` (only +8/+24 on `valid_rc_objs`),
/// and `cugel` bounds-check comparisons so `irc_cancel_same_block_rc` can allow
/// data-buffer element loads ONLY inside a trap-penetrated `@ok` block dominated
/// by a verified `cugel %idx, (loadl %arr)` bounds check.
/// Global symbols (e.g. `$pion_mt_flag`), negative offsets (`sub`, `-N`),
/// unchecked `extsw`/`shl`, arbitrary struct `TPtr` fields, and `phi`s are
/// NEVER included.
fn irc_collect_safe_load_info(
  fn_hdr : String,
  fn_lines : Array[String],
) -> IrcSafeInfo {
  let def_count : Map[String, Int] = Map::new()
  if irc_scan_fn_params(fn_hdr, def_count) < 0 {
    return IrcSafeInfo::{
      def_count: def_count,
      valid_rc_objs: Map::new(),
      safe_addrs: Map::new(),
      dp_addr_of: Map::new(),
    }
  }
  let mut i = 0
  while i < fn_lines.length() {
    let raw = fn_lines[i]
    let ws = irc_first_non_ws(raw)
    if ws < raw.length() && str_code_at(raw, ws) == 37 {
      let t = irc_strip_comment(raw)
      match irc_extract_def_lhs(t) {
        Some(lhs) => irc_bump_def(def_count, lhs)
        None => ()
      }
    }
    i = i + 1
  }

  let safe_addrs : Map[String, Bool] = Map::new()
  let valid_rc_objs : Map[String, Bool] = Map::new()
  let dp_addr_of : Map[String, String] = Map::new()

  i = 0
  while i < fn_lines.length() {
    let raw = fn_lines[i]
    let ws = irc_first_non_ws(raw)
    if ws < raw.length() && str_code_at(raw, ws) == 99 {
      let t = irc_strip_comment(raw)
      if irc_match_rc_call(t) == 1 {
        let arg = irc_extract_rc_arg(t)
        if irc_is_valid_qbe_tmp(arg) {
          let is_u = match def_count.get(arg) {
            Some(c) => c == 1
            None => false
          }
          if is_u {
            valid_rc_objs.set(arg, true)
            safe_addrs.set(arg, true)
          }
        }
      }
    }
    i = i + 1
  }

  i = 0
  while i < fn_lines.length() {
    let raw = fn_lines[i]
    let ws = irc_first_non_ws(raw)
    if ws < raw.length() && str_code_at(raw, ws) == 37 {
      let t = irc_strip_comment(raw)
      match irc_parse_typed_def(t) {
        Some((lhs, ty_c, rhs)) => {
          let is_u = match def_count.get(lhs) {
            Some(c) => c == 1
            None => false
          }
          if is_u && ty_c == 108 {
            let rn = rhs.length()
            let mut op_end = 0
            while op_end < rn && !irc_is_ws(str_code_at(rhs, op_end)) {
              op_end = op_end + 1
            }
            let op = irc_slice(rhs, 0, op_end)
            let rest = irc_trim(irc_slice(rhs, op_end, rn))
            if irc_is_alloc_op(op) {
              safe_addrs.set(lhs, true)
            } else if op == "copy" {
              if valid_rc_objs.contains(rest) {
                valid_rc_objs.set(lhs, true)
                safe_addrs.set(lhs, true)
              }
            } else if op == "add" {
              let comma = irc_find_char(rest, 0, 44)
              if comma > 0 {
                let a = irc_trim(irc_slice(rest, 0, comma))
                let b = irc_trim(irc_slice(rest, comma + 1, rest.length()))
                if valid_rc_objs.contains(a) && irc_is_nonneg_int_lit(b) {
                  safe_addrs.set(lhs, true)
                  // Only true heap data-pointer offsets: PionBytes.data (+16, kind 1)
                  // and PionArray.data (+24, kind 2). Never +8 (`cap`).
                  if b == "16" {
                    dp_addr_of.set(lhs, a + "|1")
                  } else if b == "24" {
                    dp_addr_of.set(lhs, a + "|2")
                  }
                }
              }
            }
          }
        }
        None => ()
      }
    }
    i = i + 1
  }
  IrcSafeInfo::{
    def_count: def_count,
    valid_rc_objs: valid_rc_objs,
    safe_addrs: safe_addrs,
    dp_addr_of: dp_addr_of,
  }
}

///|
/// If `t` is a whitelisted pure-register SSA instruction, a verified read-only
/// string comparison call (`$pion_str_eq` / `$pion_str_cmp`), or (when
/// `allow_safe_load` is true) a load from a proven-safe non-RC-header address
/// (unconditionally safe or dominated by a verified bounds check in this block),
/// returns `Some(lhs)`. Otherwise returns `None` (which terminates all open
/// `rc_inc` windows).
fn irc_whitelist_def_lhs_ex(
  t : String,
  safe_load_addrs : Map[String, Bool],
  blk_safe_loads : Map[String, Int],
  allow_safe_load : Bool,
) -> Option[String] {
  match irc_parse_typed_def(t) {
    None => None
    Some((lhs, ty_c, rhs)) => {
      let rn = rhs.length()
      let mut op_end = 0
      while op_end < rn && !irc_is_ws(str_code_at(rhs, op_end)) {
        op_end = op_end + 1
      }
      let op = irc_slice(rhs, 0, op_end)
      if op == "call" {
        if ty_c == 119 &&
          irc_ends_with(rhs, ")") &&
          (irc_starts_with(rhs, "call $pion_str_eq(") ||
            irc_starts_with(rhs, "call $pion_str_cmp(")) {
          return Some(lhs)
        }
        return None
      }
      if irc_is_pure_reg_op(op) {
        return Some(lhs)
      }
      if allow_safe_load && irc_is_load_op(op) {
        let addr = irc_trim(irc_slice(rhs, op_end, rn))
        if irc_is_valid_qbe_tmp(addr) {
          if safe_load_addrs.contains(addr) {
            return Some(lhs)
          }
          match blk_safe_loads.get(addr) {
            Some(req_w) =>
              if irc_load_op_width(op) == req_w {
                return Some(lhs)
              }
            None => ()
          }
        }
      }
      None
    }
  }
}

///|
/// Parse a standalone `call $pion_rc_inc(l <arg>)` or `call $pion_rc_dec(l <arg>)`.
/// Returns `1` for inc, `2` for dec, `0` otherwise.
fn irc_match_rc_call(t : String) -> Int {
  if irc_starts_with(t, "call $pion_rc_inc(l ") && irc_ends_with(t, ")") {
    1
  } else if irc_starts_with(t, "call $pion_rc_dec(l ") && irc_ends_with(t, ")") {
    2
  } else {
    0
  }
}

///|
fn irc_extract_rc_arg(t : String) -> String {
  // Both "call $pion_rc_inc(l " and "call $pion_rc_dec(l " have length 20
  irc_trim(irc_slice(t, 20, t.length() - 1))
}

///|
fn irc_first_non_ws(s : String) -> Int {
  let n = s.length()
  let mut i = 0
  while i < n && irc_is_ws(str_code_at(s, i)) {
    i = i + 1
  }
  i
}

///|
fn irc_slice_starts_with(s : String, start : Int, end : Int, pre : String) -> Bool {
  let pl = pre.length()
  if end - start < pl {
    return false
  }
  let mut i = 0
  while i < pl {
    if str_code_at(s, start + i) != str_code_at(pre, i) {
      return false
    }
    i = i + 1
  }
  true
}

///|
/// Advance QBE double-quote/escape state and top-level brace depth across
/// `s[start..end)` (stopping at an unquoted `#` comment).
/// Returns `(in_quote, escaped, brace_depth, brace_count)` where `brace_count`
/// is the number of unquoted, uncommented `{` or `}` characters seen.
fn irc_scan_line_lex(
  s : String,
  start : Int,
  end : Int,
  in_quote_in : Bool,
  escaped_in : Bool,
  depth_in : Int,
) -> (Bool, Bool, Int, Int) {
  let mut in_quote = in_quote_in
  let mut escaped = escaped_in
  let mut depth = depth_in
  let mut braces = 0
  let mut i = start
  while i < end {
    let c = str_code_at(s, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 35 {
      break
    } else if c == 123 {
      depth = depth + 1
      braces = braces + 1
    } else if c == 125 {
      if depth > 0 {
        depth = depth - 1
      }
      braces = braces + 1
    }
    i = i + 1
  }
  (in_quote, escaped, depth, braces)
}

///|
/// Return the index of the first unquoted `#` in `s[start..end)`, or `end`.
fn irc_strip_comment_end(s : String, start : Int, end : Int) -> Int {
  let mut in_quote = false
  let mut escaped = false
  let mut i = start
  while i < end {
    let c = str_code_at(s, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 35 {
      return i
    }
    i = i + 1
  }
  end
}

///|
fn irc_is_fn_hdr_range(s : String, line_start : Int, line_end : Int) -> Bool {
  let cend = irc_strip_comment_end(s, line_start, line_end)
  let mut ts = line_start
  while ts < cend && irc_is_ws(str_code_at(s, ts)) {
    ts = ts + 1
  }
  let mut te = cend
  while te > ts && irc_is_ws(str_code_at(s, te - 1)) {
    te = te - 1
  }
  if te <= ts || str_code_at(s, te - 1) != 123 {
    return false
  }
  if irc_slice_starts_with(s, ts, te, "export") &&
    te > ts + 6 &&
    irc_is_ws(str_code_at(s, ts + 6)) {
    let mut k = ts + 6
    while k < te && irc_is_ws(str_code_at(s, k)) {
      k = k + 1
    }
    ts = k
  }
  irc_slice_starts_with(s, ts, te, "function") &&
  te > ts + 8 &&
  !irc_is_qbe_ident_char(str_code_at(s, ts + 8))
}

///|
/// True when `s[line_start..line_end)` is a lone `}`, optionally surrounded by
/// whitespace and followed by a `#` comment.
fn irc_is_close_brace_range(s : String, line_start : Int, line_end : Int) -> Bool {
  let mut k = line_start
  while k < line_end && irc_is_ws(str_code_at(s, k)) {
    k = k + 1
  }
  if k == line_end || str_code_at(s, k) != 125 {
    return false
  }
  k = k + 1
  while k < line_end && irc_is_ws(str_code_at(s, k)) {
    k = k + 1
  }
  k == line_end || str_code_at(s, k) == 35
}

///|
/// Single-pass zero-allocation scan of a function body byte range `[start, end)`.
/// Returns bitmask:
/// - bit 0 (`1`) = contains `$pion_rc_`
/// - bit 1 (`2`) = contains `_hdr`
/// - bit 2 (`4`) = contains `call` keyword
fn irc_scan_body_flags(s : String, start : Int, end : Int) -> Int {
  let mut flags = 0
  let mut i = start
  while i < end {
    let c = str_code_at(s, i)
    if c == 36 && (flags & 1) == 0 && i + 9 <= end {
      // "$pion_rc_"
      if str_code_at(s, i + 1) == 112 &&
        str_code_at(s, i + 2) == 105 &&
        str_code_at(s, i + 3) == 111 &&
        str_code_at(s, i + 4) == 110 &&
        str_code_at(s, i + 5) == 95 &&
        str_code_at(s, i + 6) == 114 &&
        str_code_at(s, i + 7) == 99 &&
        str_code_at(s, i + 8) == 95 {
        flags = flags | 1
        if flags == 7 {
          return 7
        }
        i = i + 9
        continue
      }
    } else if c == 95 && (flags & 2) == 0 && i + 4 <= end {
      // "_hdr"
      if str_code_at(s, i + 1) == 104 &&
        str_code_at(s, i + 2) == 100 &&
        str_code_at(s, i + 3) == 114 {
        flags = flags | 2
        if flags == 7 {
          return 7
        }
        i = i + 4
        continue
      }
    } else if c == 99 && (flags & 4) == 0 && i + 5 <= end {
      // "call" followed by non-ident separator
      if str_code_at(s, i + 1) == 97 &&
        str_code_at(s, i + 2) == 108 &&
        str_code_at(s, i + 3) == 108 &&
        !irc_is_qbe_ident_char(str_code_at(s, i + 4)) {
        flags = flags | 4
        if flags == 7 {
          return 7
        }
        i = i + 4
        continue
      }
    }
    i = i + 1
  }
  flags
}

///|
fn irc_split_lines_range(s : String, start : Int, end : Int) -> Array[String] {
  let lines : Array[String] = []
  let mut cur = start
  let mut i = start
  while i < end {
    if str_code_at(s, i) == 10 {
      lines.push(irc_slice(s, cur, i))
      cur = i + 1
    }
    i = i + 1
  }
  if cur < end {
    lines.push(irc_slice(s, cur, end))
  }
  lines
}

///|
fn irc_parse_jmp_target(t : String) -> String {
  if irc_has_kw_sep(t, "jmp") {
    let rest = irc_trim(irc_slice(t, 3, t.length()))
    if rest.length() > 1 && str_code_at(rest, 0) == 64 {
      let lbl = irc_extract_label_tok(rest)
      if lbl == rest {
        return lbl
      }
    }
  }
  ""
}

///|
fn irc_parse_jnz_full(t : String) -> (String, String, String) {
  if !irc_has_kw_sep(t, "jnz") {
    return ("", "", "")
  }
  let c1 = irc_find_char_unquoted(t, 3, 44)
  if c1 < 0 {
    return ("", "", "")
  }
  let c2 = irc_find_char_unquoted(t, c1 + 1, 44)
  if c2 < 0 {
    return ("", "", "")
  }
  let cond = irc_trim(irc_slice(t, 3, c1))
  let a1 = irc_trim(irc_slice(t, c1 + 1, c2))
  let a2 = irc_trim(irc_slice(t, c2 + 1, t.length()))
  if a1.length() > 1 &&
    str_code_at(a1, 0) == 64 &&
    a2.length() > 1 &&
    str_code_at(a2, 0) == 64 {
    let l1 = irc_extract_label_tok(a1)
    let l2 = irc_extract_label_tok(a2)
    if l1 == a1 && l2 == a2 {
      return (cond, l1, l2)
    }
  }
  ("", "", "")
}

///|
/// Parse all target labels (`@default`, `@t0`, ...) from `jtbl %idx, @default, @t0, ...`
/// (or no-space `jtbl%idx,@default,@t0`). Quote-aware so commas inside `$"a,b"`
/// never split operands; returns empty array if any target operand is malformed.
fn irc_parse_jtbl_targets(t : String) -> Array[String] {
  let out : Array[String] = []
  if !irc_has_kw_sep(t, "jtbl") {
    return out
  }
  let n = t.length()
  let mut pos = irc_find_char_unquoted(t, 4, 44)
  if pos < 0 {
    return out
  }
  pos = pos + 1
  while pos < n {
    let next_c = irc_find_char_unquoted(t, pos, 44)
    let end = if next_c >= 0 { next_c } else { n }
    let tok = irc_trim(irc_slice(t, pos, end))
    if tok.length() > 1 && str_code_at(tok, 0) == 64 {
      let lbl = irc_extract_label_tok(tok)
      if lbl == tok {
        out.push(lbl)
      } else {
        return []
      }
    } else {
      return []
    }
    if next_c < 0 {
      break
    }
    pos = next_c + 1
  }
  out
}

///|
/// Conservatively scan any unquoted `@label` tokens on an unknown terminator line.
fn irc_collect_at_labels(t : String) -> Array[String] {
  let out : Array[String] = []
  let n = t.length()
  let mut in_quote = false
  let mut escaped = false
  let mut i = 0
  while i < n {
    let c = str_code_at(t, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 64 {
      let lbl = irc_extract_label_tok(irc_slice(t, i, n))
      if lbl.length() > 1 {
        out.push(lbl)
        i = i + lbl.length()
        continue
      }
    }
    i = i + 1
  }
  out
}

///|
/// Classify a proven compiler-emitted bounds-check trap block into a packed
/// `(kind << 4) | width` value:
/// - `PionBytes` (`@bytes_oob*` or `@bri8_oob*`): `(1 << 4) | 1 = 17`
/// - `PionArray` with exact proven element width:
///   - `@arr_oob_w1*`: `(2 << 4) | 1 = 33`
///   - `@arr_oob_w2*`: `(2 << 4) | 2 = 34`
///   - `@arr_oob_w4*`: `(2 << 4) | 4 = 36`
///   - `@arr_oob_w8*`: `(2 << 4) | 8 = 40`
/// - Any other label (including unqualified `@arr_oob_<id>` / `@swp_oob*` or plain
///   struct traps) or missing exact `call $pion_panic_oob(l <idx_reg>, l <len_reg>)`: `0`.
fn irc_trap_oob_kind(
  fn_lines : Array[String],
  b_start : Int,
  b_end : Int,
  idx_reg : String,
  len_reg : String,
) -> Int {
  let mut packed = 0
  let mut saw_lbl = false
  let want_call = "call $pion_panic_oob(l " + idx_reg + ", l " + len_reg + ")"
  let mut saw_call = false
  let mut i = b_start
  while i < b_end {
    let t = irc_strip_comment(fn_lines[i])
    if t.length() > 0 {
      if !saw_lbl && str_code_at(t, 0) == 64 {
        saw_lbl = true
        let lbl = irc_extract_label_tok(t)
        if irc_starts_with(lbl, "@bytes_oob") || irc_starts_with(lbl, "@bri8_oob") {
          packed = 17
        } else if irc_starts_with(lbl, "@arr_oob_w1") {
          packed = 33
        } else if irc_starts_with(lbl, "@arr_oob_w2") {
          packed = 34
        } else if irc_starts_with(lbl, "@arr_oob_w4") {
          packed = 36
        } else if irc_starts_with(lbl, "@arr_oob_w8") {
          packed = 40
        } else {
          return 0
        }
      } else if t == want_call {
        saw_call = true
      }
    }
    i = i + 1
  }
  if saw_call { packed } else { 0 }
}

///|
fn irc_is_trap_block(
  fn_lines : Array[String],
  b_start : Int,
  b_end : Int,
  safe_load_addrs : Map[String, Bool],
  allow_safe_load : Bool,
) -> Bool {
  let empty_blk : Map[String, Int] = Map::new()
  let mut last_idx = -1
  let mut i = b_end - 1
  while i >= b_start {
    let t = irc_strip_comment(fn_lines[i])
    if t.length() > 0 && str_code_at(t, 0) != 64 {
      last_idx = i
      break
    }
    i = i - 1
  }
  if last_idx < 0 || irc_strip_comment(fn_lines[last_idx]) != "hlt" {
    return false
  }
  i = b_start
  while i < last_idx {
    let t = irc_strip_comment(fn_lines[i])
    if t.length() == 0 || str_code_at(t, 0) == 64 {
      i = i + 1
      continue
    }
    if irc_is_panic_call(t) {
      i = i + 1
      continue
    }
    match irc_whitelist_def_lhs_ex(t, safe_load_addrs, empty_blk, allow_safe_load) {
      Some(_) => {
        i = i + 1
        continue
      }
      None => return false
    }
  }
  true
}

///|
struct IrcCfg {
  blk_starts : Array[Int]
  blk_ends : Array[Int]
  has_phi : Array[Bool]
  pred_count : Array[Int]
  term_idx : Array[Int]
  term_kind : Array[Int]
  term_cond : Array[String]
  term_b1 : Array[Int]
  term_b2 : Array[Int]
  succs : Array[Array[Int]]
  disable_cfg : Bool
}

///|
/// Shared O(N) QBE SSA basic-block & CFG builder (reused by both same-block
/// trap-branch RC cancellation and loop-guided selective inline_rc).
/// Handles `@label`, implicit fallthrough (`bi -> bi + 1`), `jmp`, `jnz`,
/// all `jtbl` targets, unreachable blocks, self-loops, and irreducible cycles.
/// Sets `disable_cfg = true` on duplicate/malformed labels, unknown targets,
/// or unparseable jump terminators.
fn irc_build_cfg(fn_lines : Array[String]) -> IrcCfg {
  let n = fn_lines.length()
  let blk_starts : Array[Int] = []
  let blk_ends : Array[Int] = []
  let label_to_blk : Map[String, Int] = Map::new()
  let has_phi : Array[Bool] = []
  let mut disable_cfg = false
  let mut cur_start = -1
  let mut cur_has_phi = false
  let mut li = 0
  while li < n {
    let raw = fn_lines[li]
    let ws = irc_first_non_ws(raw)
    if ws < raw.length() && str_code_at(raw, ws) == 64 {
      if cur_start >= 0 {
        blk_starts.push(cur_start)
        blk_ends.push(li)
        has_phi.push(cur_has_phi)
      }
      let line_t = irc_strip_comment(raw)
      let lbl = irc_extract_label_tok(line_t)
      if lbl.length() < 2 || lbl != line_t || label_to_blk.contains(lbl) {
        disable_cfg = true
      }
      label_to_blk.set(lbl, blk_starts.length())
      cur_start = li
      cur_has_phi = false
    } else {
      if cur_start < 0 {
        cur_start = li
        cur_has_phi = false
      }
      if ws < raw.length() && irc_line_has_phi(raw) {
        cur_has_phi = true
      }
    }
    li = li + 1
  }
  if cur_start >= 0 {
    blk_starts.push(cur_start)
    blk_ends.push(n)
    has_phi.push(cur_has_phi)
  }
  let nblk = blk_starts.length()
  let pred_count : Array[Int] = []
  let term_idx : Array[Int] = []
  let term_kind : Array[Int] = []
  let term_cond : Array[String] = []
  let term_b1 : Array[Int] = []
  let term_b2 : Array[Int] = []
  let succs : Array[Array[Int]] = []
  let mut bi = 0
  while bi < nblk {
    pred_count.push(0)
    term_idx.push(-1)
    term_kind.push(0)
    term_cond.push("")
    term_b1.push(-1)
    term_b2.push(-1)
    let empty_s : Array[Int] = []
    succs.push(empty_s)
    bi = bi + 1
  }
  bi = 0
  while bi < nblk {
    let bs = blk_starts[bi]
    let be = blk_ends[bi]
    let mut last_i = -1
    let mut k = be - 1
    while k >= bs {
      let t = irc_strip_comment(fn_lines[k])
      if t.length() > 0 && str_code_at(t, 0) != 64 {
        last_i = k
        break
      }
      k = k - 1
    }
    term_idx[bi] = last_i
    if last_i >= 0 {
      let lt = irc_strip_comment(fn_lines[last_i])
      if lt == "hlt" || lt == "ret" || irc_has_kw_sep(lt, "ret") {
        term_kind[bi] = 0
      } else {
        let jtgt = irc_parse_jmp_target(lt)
        if jtgt.length() > 0 {
          term_kind[bi] = 1
          match label_to_blk.get(jtgt) {
            Some(tb) => {
              term_b1[bi] = tb
              pred_count[tb] = pred_count[tb] + 1
              succs[bi].push(tb)
            }
            None => disable_cfg = true
          }
        } else {
          let (jcond, t1, t2) = irc_parse_jnz_full(lt)
          if t1.length() > 0 && t2.length() > 0 {
            term_kind[bi] = 2
            term_cond[bi] = jcond
            match label_to_blk.get(t1) {
              Some(tb1) => {
                term_b1[bi] = tb1
                pred_count[tb1] = pred_count[tb1] + 1
                succs[bi].push(tb1)
              }
              None => disable_cfg = true
            }
            match label_to_blk.get(t2) {
              Some(tb2) => {
                term_b2[bi] = tb2
                pred_count[tb2] = pred_count[tb2] + 1
                succs[bi].push(tb2)
              }
              None => disable_cfg = true
            }
          } else if irc_has_kw_sep(lt, "jtbl") {
            term_kind[bi] = 3
            let jtgts = irc_parse_jtbl_targets(lt)
            if jtgts.length() == 0 {
              disable_cfg = true
            }
            let mut ji = 0
            while ji < jtgts.length() {
              match label_to_blk.get(jtgts[ji]) {
                Some(tb) => {
                  pred_count[tb] = pred_count[tb] + 1
                  succs[bi].push(tb)
                }
                None => disable_cfg = true
              }
              ji = ji + 1
            }
          } else {
            // Fallthrough or unknown terminator: conservatively record any `@label`
            // targets plus fallthrough to `bi + 1`, and disable CFG-guided opts
            // whenever unparsed labels or jump keywords appear.
            term_kind[bi] = 4
            let unk_lbls = irc_collect_at_labels(lt)
            if unk_lbls.length() > 0 ||
              irc_has_kw_sep(lt, "jmp") ||
              irc_has_kw_sep(lt, "jnz") ||
              irc_has_kw_sep(lt, "jtbl") {
              disable_cfg = true
            }
            let mut ui = 0
            while ui < unk_lbls.length() {
              match label_to_blk.get(unk_lbls[ui]) {
                Some(tb) => {
                  pred_count[tb] = pred_count[tb] + 1
                  succs[bi].push(tb)
                }
                None => ()
              }
              ui = ui + 1
            }
            if bi + 1 < nblk {
              pred_count[bi + 1] = pred_count[bi + 1] + 1
              succs[bi].push(bi + 1)
            }
          }
        }
      }
    } else if bi + 1 < nblk {
      pred_count[bi + 1] = pred_count[bi + 1] + 1
      succs[bi].push(bi + 1)
    }
    bi = bi + 1
  }
  IrcCfg::{
    blk_starts: blk_starts,
    blk_ends: blk_ends,
    has_phi: has_phi,
    pred_count: pred_count,
    term_idx: term_idx,
    term_kind: term_kind,
    term_cond: term_cond,
    term_b1: term_b1,
    term_b2: term_b2,
    succs: succs,
    disable_cfg: disable_cfg,
  }
}

///|
/// Compute CFG blocks reachable from entry block `0` in O(V + E).
fn irc_compute_reachable_blocks(cfg : IrcCfg) -> Array[Bool] {
  let nblk = cfg.blk_starts.length()
  let reach : Array[Bool] = []
  let mut i = 0
  while i < nblk {
    reach.push(false)
    i = i + 1
  }
  if nblk == 0 {
    return reach
  }
  let stack : Array[Int] = [0]
  reach[0] = true
  while stack.length() > 0 {
    match stack.pop() {
      Some(v) => {
        let adj = cfg.succs[v]
        let mut ei = 0
        while ei < adj.length() {
          let w = adj[ei]
          if !reach[w] {
            reach[w] = true
            stack.push(w)
          }
          ei = ei + 1
        }
      }
      None => break
    }
  }
  reach
}

///|
/// Deterministic iterative Tarjan SCC over `0..nblk-1`.
/// Marks `in_loop[b] = true` iff `b` belongs to an SCC of size `> 1` or has a
/// self-loop edge `b -> b`. Handles reducible loops, irreducible multi-entry
/// loops, `jtbl` cycles, and unreachable cycles in O(V + E) with zero recursion.
fn irc_compute_loop_blocks(cfg : IrcCfg) -> Array[Bool] {
  let nblk = cfg.blk_starts.length()
  let index : Array[Int] = []
  let lowlink : Array[Int] = []
  let on_stack : Array[Bool] = []
  let in_loop : Array[Bool] = []
  let mut i = 0
  while i < nblk {
    index.push(-1)
    lowlink.push(0)
    on_stack.push(false)
    in_loop.push(false)
    i = i + 1
  }
  let tarjan_stack : Array[Int] = []
  let dfs_node : Array[Int] = []
  let dfs_edge : Array[Int] = []
  let mut next_index = 0
  let mut root = 0
  while root < nblk {
    if index[root] != -1 {
      root = root + 1
      continue
    }
    index[root] = next_index
    lowlink[root] = next_index
    next_index = next_index + 1
    tarjan_stack.push(root)
    on_stack[root] = true
    dfs_node.push(root)
    dfs_edge.push(0)
    while dfs_node.length() > 0 {
      let top = dfs_node.length() - 1
      let v = dfs_node[top]
      let ei = dfs_edge[top]
      let adj = cfg.succs[v]
      if ei < adj.length() {
        dfs_edge[top] = ei + 1
        let w = adj[ei]
        if w == v {
          in_loop[v] = true
        }
        if index[w] == -1 {
          index[w] = next_index
          lowlink[w] = next_index
          next_index = next_index + 1
          tarjan_stack.push(w)
          on_stack[w] = true
          dfs_node.push(w)
          dfs_edge.push(0)
        } else if on_stack[w] {
          if index[w] < lowlink[v] {
            lowlink[v] = index[w]
          }
        }
      } else {
        let _ = dfs_node.pop()
        let _ = dfs_edge.pop()
        if lowlink[v] == index[v] {
          let scc : Array[Int] = []
          while tarjan_stack.length() > 0 {
            match tarjan_stack.pop() {
              Some(w) => {
                on_stack[w] = false
                scc.push(w)
                if w == v {
                  break
                }
              }
              None => break
            }
          }
          if scc.length() > 1 {
            let mut si = 0
            while si < scc.length() {
              in_loop[scc[si]] = true
              si = si + 1
            }
          }
        }
        if dfs_node.length() > 0 {
          let parent = dfs_node[dfs_node.length() - 1]
          if lowlink[v] < lowlink[parent] {
            lowlink[parent] = lowlink[v]
          }
        }
      }
    }
    root = root + 1
  }
  in_loop
}

///| An inc is the sole operation which can start a cancellation window.
fn irc_block_has_inc(lines : Array[String], start : Int, end : Int) -> Bool {
  let mut i = start
  while i < end {
    let line = lines[i]
    if irc_slice_starts_with(line, irc_first_non_ws(line), line.length(), "call $pion_rc_inc(l ") {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Step 1: O(N) RC pair cancellation with:
/// - strict pure-register + verified read-only call + safe non-RC-header load whitelist,
/// - CFG single-predecessor trap-branch penetration across abort-only `$pion_panic*` + `hlt`
///   blocks (e.g. bounds checks), with bounds-checked container data-pointer element loads
///   enabled strictly inside the dominated `@ok` block.
fn irc_cancel_same_block_rc(
  fn_hdr : String,
  fn_lines : Array[String],
  disable_mask : Int,
) -> Array[String] {
  let n = fn_lines.length()
  if !irc_block_has_inc(fn_lines, 0, n) {
    return fn_lines
  }
  let allow_safe_load = (disable_mask & 4) == 0
  let allow_trap_pen = (disable_mask & 8) == 0
  let safe_info = if allow_safe_load {
    irc_collect_safe_load_info(fn_hdr, fn_lines)
  } else {
    IrcSafeInfo::{
      def_count: Map::new(),
      valid_rc_objs: Map::new(),
      safe_addrs: Map::new(),
      dp_addr_of: Map::new(),
    }
  }
  let safe_load_addrs = safe_info.safe_addrs

  let cfg = irc_build_cfg(fn_lines)
  let blk_starts = cfg.blk_starts
  let blk_ends = cfg.blk_ends
  let has_phi = cfg.has_phi
  let pred_count = cfg.pred_count
  let term_idx = cfg.term_idx
  let term_kind = cfg.term_kind
  let term_cond = cfg.term_cond
  let term_b1 = cfg.term_b1
  let term_b2 = cfg.term_b2
  let disable_xblock = cfg.disable_cfg
  let nblk = blk_starts.length()
  let mut bi = 0

  let deleted_idxs : Array[Int] = []
  let entry_open : Map[Int, Map[String, Array[Int]]] = Map::new()
  let entry_checked_pairs : Map[Int, Array[String]] = Map::new()

  bi = 0
  while bi < nblk {
    // Without an incoming window or a local inc, this block can neither
    // cancel an RC pair nor propagate facts across a trap branch.
    if !entry_open.contains(bi) && !irc_block_has_inc(fn_lines, blk_starts[bi], blk_ends[bi]) {
      bi = bi + 1
      continue
    }
    let mut open_stacks : Map[String, Array[Int]] = match entry_open.get(bi) {
      Some(m) => m
      None => Map::new()
    }
    let mut live_checked_pairs : Array[String] = []
    let mut checked_pairs : Map[String, Int] = Map::new()
    let mut checked_arr_kind : Map[String, Int] = Map::new()
    let mut checked_idxs : Map[String, Bool] = Map::new()
    let mut blk_dp_arr : Map[String, String] = Map::new()
    let mut blk_dp_kind : Map[String, Int] = Map::new()
    let mut blk_off_idx : Map[String, String] = Map::new()
    let mut blk_off_stride : Map[String, Int] = Map::new()
    let mut blk_safe_loads : Map[String, Int] = Map::new()
    let mut blk_len_of : Map[String, String] = Map::new()
    let mut blk_cugel_idx : Map[String, String] = Map::new()
    let mut blk_cugel_len : Map[String, String] = Map::new()
    match entry_checked_pairs.get(bi) {
      Some(pairs) => {
        let mut pi = 0
        while pi < pairs.length() {
          let entry = pairs[pi]
          let sep1 = irc_find_char(entry, 0, 124)
          if sep1 > 0 && sep1 + 1 < entry.length() {
            let sep2 = irc_find_char(entry, sep1 + 1, 124)
            if sep2 > sep1 + 1 && sep2 + 1 < entry.length() {
              let ar = irc_slice(entry, 0, sep1)
              let ir = irc_slice(entry, sep1 + 1, sep2)
              let ks = irc_slice(entry, sep2 + 1, entry.length())
              let packed = if ks == "17" {
                17
              } else if ks == "33" {
                33
              } else if ks == "34" {
                34
              } else if ks == "36" {
                36
              } else if ks == "40" {
                40
              } else {
                0
              }
              if packed > 0 {
                let kind = packed >> 4
                live_checked_pairs.push(entry)
                checked_pairs.set(ar + "|" + ir, packed)
                checked_arr_kind.set(ar, kind)
                checked_idxs.set(ir, true)
                blk_off_idx.set(ir, ir)
                blk_off_stride.set(ir, 1)
              }
            }
          }
          pi = pi + 1
        }
      }
      None => ()
    }
    let mut has_checked = live_checked_pairs.length() > 0

    let bs = blk_starts[bi]
    let be = blk_ends[bi]
    let ti = term_idx[bi]
    let mut i = bs
    while i < be {
      let raw = fn_lines[i]
      let ws = irc_first_non_ws(raw)
      if ws == raw.length() || str_code_at(raw, ws) == 64 || str_code_at(raw, ws) == 35 {
        i = i + 1
        continue
      }
      if i == ti && term_kind[bi] == 2 {
        // jnz terminator: check single-pred forward trap-branch penetration.
        if allow_trap_pen && !disable_xblock && open_stacks.length() > 0 {
          let b1 = term_b1[bi]
          let b2 = term_b2[bi]
          if b1 >= 0 && b2 >= 0 {
            let mut next_blk = -1
            let mut trap_blk = -1
            let mut trap_is_true_branch = false
            if b2 > bi &&
              pred_count[b2] == 1 &&
              !has_phi[b2] &&
              irc_is_trap_block(fn_lines, blk_starts[b1], blk_ends[b1], safe_load_addrs, allow_safe_load) {
              next_blk = b2
              trap_blk = b1
              trap_is_true_branch = true
            } else if b1 > bi &&
              pred_count[b1] == 1 &&
              !has_phi[b1] &&
              irc_is_trap_block(fn_lines, blk_starts[b2], blk_ends[b2], safe_load_addrs, allow_safe_load) {
              next_blk = b1
              trap_blk = b2
              trap_is_true_branch = false
            }
            if next_blk >= 0 {
              entry_open.set(next_blk, open_stacks)
              // Propagate ONLY surviving `live_checked_pairs` plus a live
              // intra-block bounds check proven in THIS block with no intervening
              // side effect (`blk_cugel_*` + `blk_len_of`) and exact container
              // width tag (`@bytes_oob*` / `@arr_oob_w{1,2,4,8}_<id>`).
              let next_pairs : Array[String] = []
              let mut pi = 0
              while pi < live_checked_pairs.length() {
                next_pairs.push(live_checked_pairs[pi])
                pi = pi + 1
              }
              if allow_safe_load && trap_is_true_branch && trap_blk >= 0 {
                let cond = term_cond[bi]
                match (blk_cugel_idx.get(cond), blk_cugel_len.get(cond)) {
                  (Some(idx_reg), Some(len_reg)) =>
                    match blk_len_of.get(len_reg) {
                      Some(arr_reg) => {
                        let packed = irc_trap_oob_kind(
                          fn_lines,
                          blk_starts[trap_blk],
                          blk_ends[trap_blk],
                          idx_reg,
                          len_reg,
                        )
                        if packed > 0 {
                          next_pairs.push(arr_reg + "|" + idx_reg + "|" + packed.to_string())
                        }
                      }
                      None => ()
                    }
                  _ => ()
                }
              }
              if next_pairs.length() > 0 {
                entry_checked_pairs.set(next_blk, next_pairs)
              }
            }
          }
        }
        open_stacks = Map::new()
        i = i + 1
        continue
      }
      let has_open = open_stacks.length() > 0
      let has_live_bounds = blk_len_of.length() > 0 || blk_cugel_idx.length() > 0
      let c0 = str_code_at(raw, ws)
      if !has_open && !has_checked && !has_live_bounds && c0 != 99 && !(allow_safe_load && c0 == 37) {
        i = i + 1
        continue
      }
      let t = irc_strip_comment(raw)
      if t.length() == 0 {
        i = i + 1
        continue
      }
      // Track live intra-block `loadl %rc_obj` (container len) and `cugel %idx, %len`,
      // plus safe data-buffer element addresses inside a bounds-checked `@ok` block.
      if allow_safe_load && c0 == 37 {
        match irc_parse_typed_def(t) {
          Some((lhs, ty_c, rhs)) => {
            let is_u = match safe_info.def_count.get(lhs) {
              Some(c) => c == 1
              None => false
            }
            if !is_u {
              // Redefinition invalidates any stale intra-block fact on `lhs`.
              blk_len_of.remove(lhs)
              blk_cugel_idx.remove(lhs)
              blk_cugel_len.remove(lhs)
            } else {
              let rn = rhs.length()
              let mut op_end = 0
              while op_end < rn && !irc_is_ws(str_code_at(rhs, op_end)) {
                op_end = op_end + 1
              }
              let op = irc_slice(rhs, 0, op_end)
              let rest = irc_trim(irc_slice(rhs, op_end, rn))
              if ty_c == 108 {
                if op == "loadl" {
                  if safe_info.valid_rc_objs.contains(rest) {
                    blk_len_of.set(lhs, rest)
                  }
                  if has_checked {
                    match safe_info.dp_addr_of.get(rest) {
                      Some(dp_val) => {
                        let sep = irc_find_char(dp_val, 0, 124)
                        if sep > 0 && sep + 1 < dp_val.length() {
                          let arr_reg = irc_slice(dp_val, 0, sep)
                          let ks = irc_slice(dp_val, sep + 1, dp_val.length())
                          let dp_kind = if ks == "2" { 2 } else if ks == "1" { 1 } else { 0 }
                          if dp_kind > 0 {
                            match checked_arr_kind.get(arr_reg) {
                              Some(ck) =>
                                if ck == dp_kind {
                                  blk_dp_arr.set(lhs, arr_reg)
                                  blk_dp_kind.set(lhs, dp_kind)
                                }
                              None => ()
                            }
                          }
                        }
                      }
                      None => ()
                    }
                  }
                } else if has_checked && op == "shl" {
                  let comma = irc_find_char(rest, 0, 44)
                  if comma > 0 {
                    let a = irc_trim(irc_slice(rest, 0, comma))
                    let b = irc_trim(irc_slice(rest, comma + 1, rest.length()))
                    if checked_idxs.contains(a) {
                      let stride = if b == "1" {
                        2
                      } else if b == "2" {
                        4
                      } else if b == "3" {
                        8
                      } else {
                        0
                      }
                      if stride > 0 {
                        blk_off_idx.set(lhs, a)
                        blk_off_stride.set(lhs, stride)
                      }
                    }
                  }
                } else if has_checked && op == "add" {
                  let comma = irc_find_char(rest, 0, 44)
                  if comma > 0 {
                    let a = irc_trim(irc_slice(rest, 0, comma))
                    let b = irc_trim(irc_slice(rest, comma + 1, rest.length()))
                    match (blk_dp_arr.get(a), blk_dp_kind.get(a)) {
                      (Some(arr_reg), Some(dp_kind)) =>
                        if b == "0" {
                          blk_safe_loads.set(lhs, 1)
                        } else {
                          match (blk_off_idx.get(b), blk_off_stride.get(b)) {
                            (Some(idx_reg), Some(stride)) =>
                              match checked_pairs.get(arr_reg + "|" + idx_reg) {
                                Some(packed) => {
                                  let pk = packed >> 4
                                  let pw = packed & 15
                                  if pk == dp_kind && stride == pw {
                                    blk_safe_loads.set(lhs, pw)
                                  }
                                }
                                None => ()
                              }
                            _ => ()
                          }
                        }
                      _ =>
                        match (blk_dp_arr.get(b), blk_dp_kind.get(b)) {
                          (Some(arr_reg), Some(dp_kind)) =>
                            if a == "0" {
                              blk_safe_loads.set(lhs, 1)
                            } else {
                              match (blk_off_idx.get(a), blk_off_stride.get(a)) {
                                (Some(idx_reg), Some(stride)) =>
                                  match checked_pairs.get(arr_reg + "|" + idx_reg) {
                                    Some(packed) => {
                                      let pk = packed >> 4
                                      let pw = packed & 15
                                      if pk == dp_kind && stride == pw {
                                        blk_safe_loads.set(lhs, pw)
                                      }
                                    }
                                    None => ()
                                  }
                                _ => ()
                              }
                            }
                          _ => ()
                        }
                    }
                  }
                }
              } else if ty_c == 119 && op == "cugel" {
                let comma = irc_find_char(rest, 0, 44)
                if comma > 0 {
                  let a = irc_trim(irc_slice(rest, 0, comma))
                  let b = irc_trim(irc_slice(rest, comma + 1, rest.length()))
                  if irc_is_valid_qbe_tmp(a) && blk_len_of.contains(b) {
                    let a_u = match safe_info.def_count.get(a) {
                      Some(c) => c == 1
                      None => false
                    }
                    if a_u {
                      blk_cugel_idx.set(lhs, a)
                      blk_cugel_len.set(lhs, b)
                    }
                  }
                }
              }
            }
          }
          None =>
            match irc_extract_def_lhs(t) {
              Some(lhs) => {
                blk_len_of.remove(lhs)
                blk_cugel_idx.remove(lhs)
                blk_cugel_len.remove(lhs)
              }
              None => ()
            }
        }
      }
      let kind = if c0 == 99 { irc_match_rc_call(t) } else { 0 }
      if kind == 1 {
        let arg = irc_extract_rc_arg(t)
        if irc_is_valid_qbe_tmp(arg) {
          match open_stacks.get(arg) {
            Some(stk) => stk.push(i)
            None => {
              let stk : Array[Int] = [i]
              open_stacks.set(arg, stk)
            }
          }
        } else {
          open_stacks = Map::new()
          blk_len_of = Map::new()
          blk_cugel_idx = Map::new()
          blk_cugel_len = Map::new()
          if has_checked {
            live_checked_pairs = []
            checked_pairs = Map::new()
            checked_arr_kind = Map::new()
            checked_idxs = Map::new()
            blk_dp_arr = Map::new()
            blk_dp_kind = Map::new()
            blk_off_idx = Map::new()
            blk_off_stride = Map::new()
            blk_safe_loads = Map::new()
            has_checked = false
          }
        }
      } else if kind == 2 {
        let arg = irc_extract_rc_arg(t)
        let mut matched = false
        match open_stacks.get(arg) {
          Some(stk) =>
            if stk.length() > 0 {
              match stk.pop() {
                Some(inc_idx) => {
                  deleted_idxs.push(inc_idx)
                  deleted_idxs.push(i)
                  matched = true
                }
                None => ()
              }
            }
          None => ()
        }
        if !matched {
          // Unmatched rc_dec may trigger a destructor; terminate all open windows
          // and invalidate all bounds-checked / live intra-block container facts.
          open_stacks = Map::new()
          blk_len_of = Map::new()
          blk_cugel_idx = Map::new()
          blk_cugel_len = Map::new()
          if has_checked {
            live_checked_pairs = []
            checked_pairs = Map::new()
            checked_arr_kind = Map::new()
            checked_idxs = Map::new()
            blk_dp_arr = Map::new()
            blk_dp_kind = Map::new()
            blk_off_idx = Map::new()
            blk_off_stride = Map::new()
            blk_safe_loads = Map::new()
            has_checked = false
          }
        }
      } else if has_open || has_checked || has_live_bounds {
        match irc_whitelist_def_lhs_ex(t, safe_load_addrs, blk_safe_loads, allow_safe_load) {
          Some(lhs) =>
            if has_open {
              match open_stacks.get(lhs) {
                Some(stk) => {
                  while stk.length() > 0 {
                    let _ = stk.pop()
                  }
                }
                None => ()
              }
            }
          None => {
            // Side effect (call, store, etc.): close open RC windows AND
            // invalidate all bounds-checked container pairs, derived data
            // pointers, and live intra-block len/cugel facts.
            open_stacks = Map::new()
            blk_len_of = Map::new()
            blk_cugel_idx = Map::new()
            blk_cugel_len = Map::new()
            if has_checked {
              live_checked_pairs = []
              checked_pairs = Map::new()
              checked_arr_kind = Map::new()
              checked_idxs = Map::new()
              blk_dp_arr = Map::new()
              blk_dp_kind = Map::new()
              blk_off_idx = Map::new()
              blk_off_stride = Map::new()
              blk_safe_loads = Map::new()
              has_checked = false
            }
          }
        }
      }
      i = i + 1
    }
    bi = bi + 1
  }

  if deleted_idxs.length() == 0 {
    return fn_lines
  }
  let deleted : Array[Bool] = []
  let mut di = 0
  while di < n {
    deleted.push(false)
    di = di + 1
  }
  let mut dj = 0
  while dj < deleted_idxs.length() {
    deleted[deleted_idxs[dj]] = true
    dj = dj + 1
  }
  let res : Array[String] = []
  let mut k = 0
  while k < n {
    if !deleted[k] {
      res.push(fn_lines[k])
    }
    k = k + 1
  }
  res
}

///|
fn irc_bump_def(def_count : Map[String, Int], name : String) -> Unit {
  let prev = match def_count.get(name) {
    Some(c) => c
    None => 0
  }
  def_count.set(name, prev + 1)
}

///|
/// Scan function signature `...(...) {` (quote- and comment-aware) and count
/// parameter `%name` definitions. Returns `-1` if the header is malformed or has
/// an unclosed quote / missing unquoted `(...)`.
fn irc_scan_fn_params(fn_hdr : String, def_count : Map[String, Int]) -> Int {
  let hdr = irc_strip_comment(fn_hdr)
  let n = hdr.length()
  let mut lp = -1
  let mut rp = -1
  let mut in_quote = false
  let mut escaped = false
  let mut i = 0
  while i < n {
    let c = str_code_at(hdr, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 40 && lp < 0 {
      lp = i
    } else if c == 41 && lp >= 0 {
      rp = i
      break
    }
    i = i + 1
  }
  if in_quote || lp < 0 || rp <= lp {
    return -1
  }
  let mut count = 0
  let mut p = lp + 1
  let mut p_in_quote = false
  let mut p_escaped = false
  while p < rp {
    let c = str_code_at(hdr, p)
    if p_in_quote {
      if p_escaped {
        p_escaped = false
      } else if c == 92 {
        p_escaped = true
      } else if c == 34 {
        p_in_quote = false
      }
      p = p + 1
    } else if c == 34 {
      p_in_quote = true
      p = p + 1
    } else if c == 37 {
      let mut q = p + 1
      while q < rp && irc_is_qbe_ident_char(str_code_at(hdr, q)) {
        q = q + 1
      }
      if q > p + 1 {
        irc_bump_def(def_count, irc_slice(hdr, p, q))
        count = count + 1
      }
      p = q
    } else {
      p = p + 1
    }
  }
  if p_in_quote { -1 } else { count }
}

///|
/// Extract `%lhs` if trimmed line `t` is any SSA definition (`%lhs =...`,
/// `%lhs=...`, `%lhs  =...`, `%lhs\t=...`).
fn irc_extract_def_lhs(t : String) -> Option[String] {
  let n = t.length()
  if n < 3 || str_code_at(t, 0) != 37 {
    return None
  }
  let mut j = 1
  while j < n {
    let c = str_code_at(t, j)
    if irc_is_ws(c) || c == 61 {
      break
    }
    j = j + 1
  }
  if j < 2 {
    return None
  }
  let mut k = j
  while k < n && irc_is_ws(str_code_at(t, k)) {
    k = k + 1
  }
  if k < n && str_code_at(t, k) == 61 {
    Some(irc_slice(t, 0, j))
  } else {
    None
  }
}

///|
/// Parses `storel <val>, <addr>` (comment-stripped) into `(val, addr)`.
fn irc_parse_storel(t : String) -> Option[(String, String)] {
  if !irc_starts_with(t, "storel ") {
    return None
  }
  let comma = irc_find_char_unquoted(t, 7, 44)
  if comma < 0 {
    return None
  }
  let v = irc_trim(irc_slice(t, 7, comma))
  let a = irc_trim(irc_slice(t, comma + 1, t.length()))
  if v.length() == 0 || !irc_is_valid_qbe_tmp(a) {
    return None
  }
  Some((v, a))
}

///|
/// Parses the operands of `phi @a v, @b w, ...` (`rest` is the text after `phi`).
/// An empty result means the line is malformed.
fn irc_parse_phi_vals(rest : String) -> Array[String] {
  let out : Array[String] = []
  let n = rest.length()
  let mut p = 0
  while p < n {
    let comma = irc_find_char_unquoted(rest, p, 44)
    let e = if comma < 0 { n } else { comma }
    let part = irc_trim(irc_slice(rest, p, e))
    let lbl = if part.length() > 1 && str_code_at(part, 0) == 64 {
      irc_extract_label_tok(part)
    } else {
      ""
    }
    let pval = irc_trim(irc_slice(part, lbl.length(), part.length()))
    if lbl.length() < 2 || pval.length() == 0 {
      return []
    }
    out.push(pval)
    p = e + 1
  }
  out
}

///|
/// RC provenance facts: temporaries on which `$pion_rc_inc`/`$pion_rc_dec` are
/// proven no-ops (`runtime/pion_rt.c` returns early for NULL and `IMMORTAL`).
/// A node is a uniquely defined temporary or a private stack slot (keyed
/// `"=" + %slot`); it becomes silent once all of its inputs are. `pending` counts
/// the inputs still unproven, `users` maps an input to the nodes waiting on it.
struct IrcSilent {
  silent : Map[String, Bool]
  pending : Map[String, Int]
  users : Map[String, Array[String]]
  queue : Array[String]
}

///|
fn irc_silent_mark(st : IrcSilent, node : String) -> Unit {
  if !st.silent.contains(node) {
    st.silent.set(node, true)
    st.queue.push(node)
  }
}

///|
/// Declares `node` silent as soon as every value of `inputs` is.
fn irc_silent_node(st : IrcSilent, node : String, inputs : Array[String]) -> Unit {
  let mut open = 0
  let mut i = 0
  while i < inputs.length() {
    let v = inputs[i]
    if v != "0" {
      open = open + 1
      match st.users.get(v) {
        Some(us) => us.push(node)
        None => {
          let us : Array[String] = [node]
          st.users.set(v, us)
        }
      }
    }
    i = i + 1
  }
  if open == 0 {
    irc_silent_mark(st, node)
  } else {
    st.pending.set(node, open)
  }
}

///|
/// Allocation-free classification of a `%x =l <op>` line this pass cares about:
/// `1` `loadl`, `2` `copy`, `3` `add ..., 24`, `4` `phi`, `5` `alloc8`; `0` for
/// anything else.
fn irc_silent_op(t : String) -> Int {
  let n = t.length()
  let mut j = 1
  while j < n && !irc_is_ws(str_code_at(t, j)) {
    j = j + 1
  }
  if !irc_slice_starts_with(t, j, n, " =l ") {
    return 0
  }
  let mut o = j + 4
  while o < n && irc_is_ws(str_code_at(t, o)) {
    o = o + 1
  }
  if irc_slice_starts_with(t, o, n, "loadl ") {
    1
  } else if irc_slice_starts_with(t, o, n, "copy ") {
    2
  } else if irc_slice_starts_with(t, o, n, "add ") {
    if irc_ends_with(t, ", 24") { 3 } else { 0 }
  } else if irc_slice_starts_with(t, o, n, "phi") {
    4
  } else if irc_slice_starts_with(t, o, n, "alloc8 ") {
    5
  } else {
    0
  }
}

///|
/// Index of `s[start, end)` in the 1024-entry slot name filter.
fn irc_name_bucket(s : String, start : Int, end : Int) -> Int {
  let mut h = 0
  let mut i = start
  while i < end {
    h = (h * 31 + str_code_at(s, i)) & 1023
    i = i + 1
  }
  h
}

///|
/// Step 2: collection of SSA temporaries proven to be NULL or statically immortal
/// (`$pion_str_*_hdr`, `$pion_none_hdr`, `$pion_enum_*_hdr`) on every path.
/// Seeds are literal `0` and `add $<immortal>_hdr, 24`; facts propagate (least
/// fixpoint, so a cycle never proves itself) through:
/// - `copy` and `phi` with all inputs proven,
/// - `loadl` of a private stack slot: the latest `storel` of the same block, else
///   every `storel` of the function, provided the entry block (which nothing jumps
///   to) allocates and initializes the slot before any load of it.
/// Only uniquely defined temporaries (`def_count == 1`) take part. A slot is private
/// when it is one `alloc8 8` whose temporary occurs nowhere but as the address of
/// `storel` / `=l loadl`; any other mention (call argument, arithmetic, narrower
/// access, stored value) disqualifies it.
fn irc_collect_immortal_regs(
  fn_hdr : String,
  fn_lines : Array[String],
) -> Map[String, Bool] {
  let def_count : Map[String, Int] = Map::new()
  if irc_scan_fn_params(fn_hdr, def_count) < 0 {
    return Map::new()
  }
  let n = fn_lines.length()
  // Pass A: definition counts, candidate slots, entry block.
  let slots : Map[String, Bool] = Map::new()
  let maybe_slot : Array[Bool] = Array::make(1024, false)
  let code : Array[String] = []
  let mut entry_lbl = ""
  let mut entry_end = n
  let mut entry_ok = false
  let mut i = 0
  while i < n {
    let t = irc_strip_comment(fn_lines[i])
    code.push(t)
    if t.length() > 0 {
      let c0 = str_code_at(t, 0)
      if c0 == 37 {
        match irc_extract_def_lhs(t) {
          Some(lhs) => {
            irc_bump_def(def_count, lhs)
            if irc_ends_with(t, " =l alloc8 8") && lhs.length() + 12 == t.length() {
              slots.set(lhs, entry_ok && entry_end == n)
              maybe_slot[irc_name_bucket(lhs, 0, lhs.length())] = true
            }
          }
          None => ()
        }
      } else if c0 == 64 {
        if entry_lbl == "" {
          entry_lbl = irc_extract_label_tok(t)
          entry_ok = true
        } else if entry_end == n {
          entry_end = i
        }
      } else if c0 == 106 {
        // `jmp` / `jnz` / `jtbl` back to the entry block.
        let targets = irc_collect_at_labels(t)
        if str_arr_contains(targets, entry_lbl) {
          entry_ok = false
        }
      } else if entry_lbl == "" {
        // Code before the first label: not a shape this pass understands.
        entry_lbl = "@"
        entry_ok = false
      }
    }
    i = i + 1
  }

  // Pass B: drop every slot with an occurrence that is not a whole-word access.
  if slots.length() > 0 {
    i = 0
    while i < n {
      let t = code[i]
      let tn = t.length()
      let mut scan_from = 0
      let mut scan_to = tn
      if tn > 0 {
        if str_code_at(t, 0) == 37 {
          // The definition itself is not a use (a second one is caught by `def_count`).
          scan_from = 1
          if irc_silent_op(t) == 1 {
            // The only operand is the address.
            scan_to = 0
          }
        } else {
          match irc_parse_storel(t) {
            Some(_) => {
              // Only the stored value can leak a slot address.
              scan_from = 7
              scan_to = irc_find_char_unquoted(t, 7, 44)
            }
            None => ()
          }
        }
      }
      let mut p = scan_from
      while p < scan_to {
        if str_code_at(t, p) == 37 {
          let mut q = p + 1
          while q < scan_to && irc_is_qbe_ident_char(str_code_at(t, q)) {
            q = q + 1
          }
          if q > p + 1 && maybe_slot[irc_name_bucket(t, p, q)] {
            slots.remove(irc_slice(t, p, q))
          }
          p = q
        } else {
          p = p + 1
        }
      }
      i = i + 1
    }
  }

  // Pass C: build the dependency graph.
  let st = IrcSilent::{
    silent: Map::new(),
    pending: Map::new(),
    users: Map::new(),
    queue: [],
  }
  // Values stored to each private slot; slots initialized by the entry block so far.
  let stores : Map[String, Array[String]] = Map::new()
  let entry_init : Map[String, Bool] = Map::new()
  let mut latest : Map[String, String] = Map::new()
  i = 0
  while i < n {
    let t = code[i]
    if t.length() > 0 {
      let c0 = str_code_at(t, 0)
      if c0 == 64 {
        if latest.length() > 0 {
          latest = Map::new()
        }
      } else if c0 == 115 {
        match irc_parse_storel(t) {
          Some((v, a)) =>
            if irc_unique_slot(slots, def_count, a) {
              latest.set(a, v)
              if i < entry_end && entry_ok {
                entry_init.set(a, true)
              }
              match stores.get(a) {
                Some(vs) => vs.push(v)
                None => {
                  let vs : Array[String] = [v]
                  stores.set(a, vs)
                }
              }
            }
          None => ()
        }
      } else if c0 == 37 {
        let op = irc_silent_op(t)
        match if op != 0 { irc_parse_typed_def(t) } else { None } {
          Some((lhs, ty_c, rhs)) =>
            if ty_c == 108 {
              if op == 1 {
                let a = irc_trim(irc_slice(rhs, 6, rhs.length()))
                if irc_def_is_unique(def_count, lhs) && irc_unique_slot(slots, def_count, a) {
                  match latest.get(a) {
                    Some(v) => irc_silent_node(st, lhs, [v])
                    None => if entry_init.contains(a) { irc_silent_node(st, lhs, ["=" + a]) }
                  }
                }
              } else if op == 5 {
                // A re-executed `alloc8` yields a new slot.
                latest.remove(lhs)
              } else if op == 2 {
                if irc_def_is_unique(def_count, lhs) {
                  irc_silent_node(st, lhs, [irc_trim(irc_slice(rhs, 5, rhs.length()))])
                }
              } else if op == 3 {
                let sym = irc_trim(irc_slice(rhs, 4, rhs.length() - 4))
                if irc_is_static_immortal_hdr(sym) && irc_def_is_unique(def_count, lhs) {
                  irc_silent_mark(st, lhs)
                }
              } else if irc_has_kw_sep(rhs, "phi") {
                let vals = irc_parse_phi_vals(irc_trim(irc_slice(rhs, 3, rhs.length())))
                if vals.length() > 0 && irc_def_is_unique(def_count, lhs) {
                  irc_silent_node(st, lhs, vals)
                }
              }
            }
          None => ()
        }
      }
    }
    i = i + 1
  }
  // A slot read across blocks is silent once all the values ever stored to it are.
  i = 0
  while i < n {
    let t = code[i]
    if irc_ends_with(t, " =l alloc8 8") {
      let a = irc_slice(t, 0, t.length() - 12)
      if entry_init.contains(a) {
        match stores.get(a) {
          Some(vs) => irc_silent_node(st, "=" + a, vs)
          None => ()
        }
      }
    }
    i = i + 1
  }

  // Least fixpoint.
  let mut qh = 0
  while qh < st.queue.length() {
    let cur = st.queue[qh]
    qh = qh + 1
    match st.users.get(cur) {
      Some(us) => {
        let mut ui = 0
        while ui < us.length() {
          let node = us[ui]
          match st.pending.get(node) {
            Some(open) => {
              st.pending.set(node, open - 1)
              if open == 1 {
                irc_silent_mark(st, node)
              }
            }
            None => ()
          }
          ui = ui + 1
        }
      }
      None => ()
    }
  }
  st.silent
}

///|
fn irc_def_is_unique(def_count : Map[String, Int], name : String) -> Bool {
  match def_count.get(name) {
    Some(c) => c == 1
    None => false
  }
}

///|
fn irc_unique_slot(
  slots : Map[String, Bool],
  def_count : Map[String, Int],
  name : String,
) -> Bool {
  match slots.get(name) {
    Some(in_entry) => in_entry && irc_def_is_unique(def_count, name)
    None => false
  }
}

///|
fn irc_has_rc_call(lines : Array[String]) -> Bool {
  let mut i = 0
  while i < lines.length() {
    let line = lines[i]
    if irc_slice_starts_with(line, irc_first_non_ws(line), line.length(), "call $pion_rc_") {
      return true
    }
    i = i + 1
  }
  false
}

///|
/// Run Step 1 (same-block RC pair cancellation) + Step 2 (elimination of RC calls on
/// proven NULL / immortal values) on a single function body. Zero CFG changes.
fn irc_cleanup_fn_body_fast(
  fn_hdr : String,
  fn_lines : Array[String],
  disable_mask : Int,
) -> Array[String] {
  let after_cancel = irc_cancel_same_block_rc(fn_hdr, fn_lines, disable_mask)
  if !irc_has_rc_call(after_cancel) {
    return after_cancel
  }
  let immortal_regs = irc_collect_immortal_regs(fn_hdr, after_cancel)
  let res : Array[String] = []
  let mut i = 0
  while i < after_cancel.length() {
    let line = after_cancel[i]
    let ws = irc_first_non_ws(line)
    if ws < line.length() && str_code_at(line, ws) == 99 {
      let t = irc_trim(line)
      let kind = irc_match_rc_call(t)
      if kind != 0 {
        let arg = irc_extract_rc_arg(t)
        if arg == "0" ||
          (irc_is_valid_qbe_val(arg) && irc_is_immortal_arg(arg, immortal_regs)) {
          i = i + 1
          continue
        }
      }
    }
    res.push(line)
    i = i + 1
  }
  res
}

///|
/// Extract a QBE global symbol starting at `$` at `s[pos]`: either `$"..."`
/// (quote/escape-aware) or `$[A-Za-z0-9._$]+`. Returns `""` if invalid.
fn irc_extract_global_sym(s : String, pos : Int, end : Int) -> String {
  if pos >= end || str_code_at(s, pos) != 36 {
    return ""
  }
  if pos + 1 < end && str_code_at(s, pos + 1) == 34 {
    let mut i = pos + 2
    let mut esc = false
    while i < end {
      let c = str_code_at(s, i)
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        return irc_slice(s, pos, i + 1)
      }
      i = i + 1
    }
    return ""
  }
  let mut j = pos + 1
  while j < end && irc_is_qbe_ident_char(str_code_at(s, j)) {
    j = j + 1
  }
  if j > pos + 1 {
    irc_slice(s, pos, j)
  } else {
    ""
  }
}

///|
/// Extract `$fn_name` (or `$"..."`) from a QBE function header line.
/// Matches only the leading `$` of a full QBE global symbol token (never an
/// interior `$` inside `$helper$tail`) and verifies only whitespace follows
/// before `(`.
fn irc_extract_fn_name(fn_hdr : String) -> String {
  let hdr = irc_strip_comment(fn_hdr)
  let lp = irc_find_char_unquoted(hdr, 0, 40)
  if lp <= 0 {
    return ""
  }
  let mut in_quote = false
  let mut escaped = false
  let mut last_dollar = -1
  let mut i = 0
  while i < lp {
    let c = str_code_at(hdr, i)
    if in_quote {
      if escaped {
        escaped = false
      } else if c == 92 {
        escaped = true
      } else if c == 34 {
        in_quote = false
      }
    } else if c == 34 {
      in_quote = true
    } else if c == 36 {
      if i == 0 || !irc_is_qbe_ident_char(str_code_at(hdr, i - 1)) {
        last_dollar = i
      }
    }
    i = i + 1
  }
  if last_dollar < 0 {
    return ""
  }
  let sym = irc_extract_global_sym(hdr, last_dollar, lp)
  if sym.length() == 0 {
    return ""
  }
  let mut tail = last_dollar + sym.length()
  while tail < lp {
    if !irc_is_ws(str_code_at(hdr, tail)) {
      return ""
    }
    tail = tail + 1
  }
  sym
}

///|
/// Extract direct call target `$callee` from a comment-stripped QBE line
/// (`call $callee(...)` or `%r =<ty> call $callee(...)`). Ignores `$pion_rc_inc`
/// and `$pion_rc_dec` and indirect `call %fp(...)`.
fn irc_extract_direct_call_target(t : String) -> String {
  let n = t.length()
  if n < 7 {
    return ""
  }
  let mut p = 0
  if irc_has_kw_sep(t, "call") {
    p = 4
  } else if str_code_at(t, 0) == 37 {
    let eq = irc_find_char_unquoted(t, 1, 61)
    if eq < 0 {
      return ""
    }
    p = eq + 1
    while p < n && irc_is_ws(str_code_at(t, p)) {
      p = p + 1
    }
    if p >= n {
      return ""
    }
    let tc = str_code_at(t, p)
    if tc == 58 {
      p = p + 1
      let ts = p
      while p < n && irc_is_qbe_ident_char(str_code_at(t, p)) {
        p = p + 1
      }
      if p == ts {
        return ""
      }
    } else if irc_is_qbe_ident_char(tc) {
      while p < n && irc_is_qbe_ident_char(str_code_at(t, p)) {
        p = p + 1
      }
    } else {
      return ""
    }
    while p < n && irc_is_ws(str_code_at(t, p)) {
      p = p + 1
    }
    if p + 4 < n &&
      irc_slice_starts_with(t, p, n, "call") &&
      !irc_is_qbe_ident_char(str_code_at(t, p + 4)) {
      p = p + 4
    } else {
      return ""
    }
  } else {
    return ""
  }
  while p < n && irc_is_ws(str_code_at(t, p)) {
    p = p + 1
  }
  let sym = irc_extract_global_sym(t, p, n)
  if sym.length() == 0 || sym == "$pion_rc_inc" || sym == "$pion_rc_dec" {
    ""
  } else {
    sym
  }
}

///|
/// Build per-line RC expansion mask from CFG loop membership and whole-function
/// hot/small override. Returns `(expand_mask, selected_count)`.
/// When `cfg.disable_cfg` is true, conservatively returns all-false (`selected_count = 0`).
fn irc_build_expand_mask(
  fn_lines : Array[String],
  cfg : IrcCfg,
  in_loop : Array[Bool],
  expand_whole_fn : Bool,
) -> (Array[Bool], Int) {
  let n = fn_lines.length()
  let mask : Array[Bool] = []
  let mut i = 0
  while i < n {
    mask.push(false)
    i = i + 1
  }
  if cfg.disable_cfg {
    return (mask, 0)
  }
  let nblk = cfg.blk_starts.length()
  let mut sel = 0
  let mut bi = 0
  while bi < nblk {
    let want_blk = expand_whole_fn || (bi < in_loop.length() && in_loop[bi])
    if want_blk {
      let bs = cfg.blk_starts[bi]
      let be = cfg.blk_ends[bi]
      let mut li = bs
      while li < be {
        let raw = fn_lines[li]
        let ws = irc_first_non_ws(raw)
        if ws < raw.length() && str_code_at(raw, ws) == 99 {
          let t = irc_strip_comment(raw)
          let kind = irc_match_rc_call(t)
          if kind != 0 && irc_is_valid_qbe_val(irc_extract_rc_arg(t)) {
            mask[li] = true
            sel = sel + 1
          }
        }
        li = li + 1
      }
    }
    bi = bi + 1
  }
  (mask, sel)
}

///|
/// Step 3: `Int64` exact product budget `est_blk * est_tmp <= 2^28` (`268435456L`).
/// Counts all base blocks and temporaries in the function, and adds expansion
/// cost ONLY for RC call sites selected in `expand_mask`.
fn irc_within_inline_budget_mask(
  fn_hdr : String,
  fn_lines : Array[String],
  expand_mask : Array[Bool],
) -> Bool {
  let dummy_defs : Map[String, Int] = Map::new()
  let nparams = irc_scan_fn_params(fn_hdr, dummy_defs)
  if nparams < 0 {
    return false
  }
  let mut nblk = 0L
  let mut ntmp = nparams.to_int64()
  let mut ninc = 0L
  let mut ndec = 0L

  let mut i = 0
  while i < fn_lines.length() {
    let t = irc_strip_comment(fn_lines[i])
    if t.length() > 1 && str_code_at(t, 0) == 64 {
      nblk = nblk + 1L
    } else if i < expand_mask.length() && expand_mask[i] {
      let kind = irc_match_rc_call(t)
      if kind == 1 {
        if irc_is_valid_qbe_val(irc_extract_rc_arg(t)) {
          ninc = ninc + 1L
        }
      } else if kind == 2 {
        if irc_is_valid_qbe_val(irc_extract_rc_arg(t)) {
          ndec = ndec + 1L
        }
      }
    } else {
      match irc_extract_def_lhs(t) {
        Some(_) => ntmp = ntmp + 1L
        None => ()
      }
    }
    i = i + 1
  }
  if nblk == 0L {
    nblk = 1L
  }
  let est_blk = nblk + 6L * ninc + 7L * ndec
  let est_tmp = ntmp + 12L * (ninc + ndec)
  let limit = 268435456L
  est_blk <= limit && est_tmp <= limit && est_blk * est_tmp <= limit
}

///|
fn irc_extract_label_tok(t : String) -> String {
  let n = t.length()
  let mut i = 1
  while i < n && irc_is_label_char(str_code_at(t, i)) {
    i = i + 1
  }
  irc_slice(t, 0, i)
}

///|
/// Token-level, quote- and comment-aware `phi` predecessor label rewriter.
/// Parses `phi <@pred> <val>, <@pred> <val>, ...` (including no-space `phi@pred`)
/// and ONLY rewrites the predecessor `@label` token of each pair, never touching
/// value operands (e.g. `$"sym@left"`) or trailing `#` comments.
fn irc_rewrite_phi_line(
  line : String,
  tail_map : Map[String, String],
  out : StringBuilder,
) -> Unit {
  let n = line.length()
  let code_end = irc_strip_comment_end(line, 0, n)
  let phi_end = irc_find_phi_opcode_end(line, code_end)
  if phi_end < 0 {
    out.write_string(line)
    return
  }
  let mut p = phi_end
  let mut last = 0
  while p < code_end {
    while p < code_end && irc_is_ws(str_code_at(line, p)) {
      p = p + 1
    }
    if p < code_end && str_code_at(line, p) == 64 {
      let mut j = p + 1
      while j < code_end && irc_is_label_char(str_code_at(line, j)) {
        j = j + 1
      }
      if j > p + 1 {
        let lbl = irc_slice(line, p, j)
        match tail_map.get(lbl) {
          Some(new_lbl) => {
            if p > last {
              out.write_string(irc_slice(line, last, p))
            }
            out.write_string(new_lbl)
            last = j
          }
          None => ()
        }
        p = j
      }
    }
    // Skip `<val>` operand (quote-aware) up to the next unquoted `,`.
    let mut v_in_quote = false
    let mut v_escaped = false
    while p < code_end {
      let c = str_code_at(line, p)
      if v_in_quote {
        if v_escaped {
          v_escaped = false
        } else if c == 92 {
          v_escaped = true
        } else if c == 34 {
          v_in_quote = false
        }
      } else if c == 34 {
        v_in_quote = true
      } else if c == 44 {
        p = p + 1
        break
      }
      p = p + 1
    }
  }
  if last == 0 {
    out.write_string(line)
  } else if last < n {
    out.write_string(irc_slice(line, last, n))
  }
}

///|
fn irc_emit_lines(lines : Array[String], out : StringBuilder) -> Unit {
  let mut k = 0
  while k < lines.length() {
    out.write_string(lines[k])
    out.write_char('\n')
    k = k + 1
  }
}

///|
/// Step 4: Expand RC calls selected in `expand_mask` with zero-extra-block `phi`
/// fast path (reusing `@_rci_fast_` / `@_rcd_fast_` for both `local_rc` at `-20`
/// and single-threaded frozen `shared_rc` at `-16`). Unselected RC calls stay as
/// compact `call $pion_rc_*` without splitting their basic block.
fn irc_expand_fn_body_mask(
  fn_lines : Array[String],
  expand_mask : Array[Bool],
  out : StringBuilder,
) -> Unit {
  let out_lines : Array[String] = []
  let tail_map : Map[String, String] = Map::new()
  let mut cur_orig = ""
  let mut cur_tail = ""
  let mut rc_id = 0

  let mut i = 0
  while i < fn_lines.length() {
    let line = fn_lines[i]
    let t = irc_strip_comment(line)
    if t.length() > 1 && str_code_at(t, 0) == 64 {
      if cur_orig.length() > 0 && cur_tail != cur_orig {
        tail_map.set(cur_orig, cur_tail)
      }
      let lbl = irc_extract_label_tok(t)
      cur_orig = lbl
      cur_tail = lbl
      out_lines.push(line)
    } else {
      if i < expand_mask.length() && expand_mask[i] {
        let kind = irc_match_rc_call(t)
        if kind != 0 {
          let arg = irc_extract_rc_arg(t)
          if irc_is_valid_qbe_val(arg) {
            let id_s = rc_id.to_string()
            rc_id = rc_id + 1
            if kind == 1 {
              out_lines.push("    %_rci_nz_" + id_s + " =w cnel " + arg + ", 0")
              out_lines.push(
                "    jnz %_rci_nz_" + id_s + ", @_rci_nn_" + id_s + ", @_rci_end_" + id_s,
              )
              out_lines.push("@_rci_nn_" + id_s)
              out_lines.push("    %_rci_mt_" + id_s + " =w loaduw $pion_mt_flag")
              out_lines.push(
                "    jnz %_rci_mt_" + id_s + ", @_rci_slow_" + id_s + ", @_rci_st_" + id_s,
              )
              out_lines.push("@_rci_st_" + id_s)
              out_lines.push("    %_rci_oa_" + id_s + " =l sub " + arg + ", 24")
              out_lines.push("    %_rci_ot_" + id_s + " =w loaduw %_rci_oa_" + id_s)
              out_lines.push("    %_rci_la_" + id_s + " =l sub " + arg + ", 20")
              out_lines.push(
                "    jnz %_rci_ot_" + id_s + ", @_rci_fast_" + id_s + ", @_rci_imm_" + id_s,
              )
              out_lines.push("@_rci_imm_" + id_s)
              out_lines.push("    %_rci_fa_" + id_s + " =l sub " + arg + ", 10")
              out_lines.push("    %_rci_fl_" + id_s + " =w loaduh %_rci_fa_" + id_s)
              out_lines.push("    %_rci_im_" + id_s + " =w and %_rci_fl_" + id_s + ", 2")
              out_lines.push("    %_rci_sa_" + id_s + " =l sub " + arg + ", 16")
              out_lines.push(
                "    jnz %_rci_im_" + id_s + ", @_rci_end_" + id_s + ", @_rci_fast_" + id_s,
              )
              out_lines.push("@_rci_fast_" + id_s)
              out_lines.push(
                "    %_rci_ra_" +
                id_s +
                " =l phi @_rci_st_" +
                id_s +
                " %_rci_la_" +
                id_s +
                ", @_rci_imm_" +
                id_s +
                " %_rci_sa_" +
                id_s,
              )
              out_lines.push("    %_rci_rc_" + id_s + " =w loaduw %_rci_ra_" + id_s)
              out_lines.push("    %_rci_r1_" + id_s + " =w add %_rci_rc_" + id_s + ", 1")
              out_lines.push("    storew %_rci_r1_" + id_s + ", %_rci_ra_" + id_s)
              out_lines.push("    jmp @_rci_end_" + id_s)
              out_lines.push("@_rci_slow_" + id_s)
              out_lines.push("    call $pion_rc_inc(l " + arg + ")")
              out_lines.push("@_rci_end_" + id_s)
              cur_tail = "@_rci_end_" + id_s
            } else {
              out_lines.push("    %_rcd_nz_" + id_s + " =w cnel " + arg + ", 0")
              out_lines.push(
                "    jnz %_rcd_nz_" + id_s + ", @_rcd_nn_" + id_s + ", @_rcd_end_" + id_s,
              )
              out_lines.push("@_rcd_nn_" + id_s)
              out_lines.push("    %_rcd_mt_" + id_s + " =w loaduw $pion_mt_flag")
              out_lines.push(
                "    jnz %_rcd_mt_" + id_s + ", @_rcd_slow_" + id_s + ", @_rcd_st_" + id_s,
              )
              out_lines.push("@_rcd_st_" + id_s)
              out_lines.push("    %_rcd_oa_" + id_s + " =l sub " + arg + ", 24")
              out_lines.push("    %_rcd_ot_" + id_s + " =w loaduw %_rcd_oa_" + id_s)
              out_lines.push("    %_rcd_la_" + id_s + " =l sub " + arg + ", 20")
              out_lines.push(
                "    jnz %_rcd_ot_" + id_s + ", @_rcd_fast_" + id_s + ", @_rcd_imm_" + id_s,
              )
              out_lines.push("@_rcd_imm_" + id_s)
              out_lines.push("    %_rcd_fa_" + id_s + " =l sub " + arg + ", 10")
              out_lines.push("    %_rcd_fl_" + id_s + " =w loaduh %_rcd_fa_" + id_s)
              out_lines.push("    %_rcd_im_" + id_s + " =w and %_rcd_fl_" + id_s + ", 2")
              out_lines.push("    %_rcd_sa_" + id_s + " =l sub " + arg + ", 16")
              out_lines.push(
                "    jnz %_rcd_im_" + id_s + ", @_rcd_end_" + id_s + ", @_rcd_fast_" + id_s,
              )
              out_lines.push("@_rcd_fast_" + id_s)
              out_lines.push(
                "    %_rcd_ra_" +
                id_s +
                " =l phi @_rcd_st_" +
                id_s +
                " %_rcd_la_" +
                id_s +
                ", @_rcd_imm_" +
                id_s +
                " %_rcd_sa_" +
                id_s,
              )
              out_lines.push("    %_rcd_rc_" + id_s + " =w loaduw %_rcd_ra_" + id_s)
              out_lines.push("    %_rcd_r1_" + id_s + " =w sub %_rcd_rc_" + id_s + ", 1")
              out_lines.push("    storew %_rcd_r1_" + id_s + ", %_rcd_ra_" + id_s)
              out_lines.push(
                "    jnz %_rcd_r1_" + id_s + ", @_rcd_end_" + id_s + ", @_rcd_drop_" + id_s,
              )
              out_lines.push("@_rcd_drop_" + id_s)
              out_lines.push("    call $pion_destroy_obj(l " + arg + ")")
              out_lines.push("    jmp @_rcd_end_" + id_s)
              out_lines.push("@_rcd_slow_" + id_s)
              out_lines.push("    call $pion_rc_dec(l " + arg + ")")
              out_lines.push("@_rcd_end_" + id_s)
              cur_tail = "@_rcd_end_" + id_s
            }
            i = i + 1
            continue
          }
        }
      }
      out_lines.push(line)
    }
    i = i + 1
  }

  if cur_orig.length() > 0 && cur_tail != cur_orig {
    tail_map.set(cur_orig, cur_tail)
  }

  let has_remap = tail_map.length() > 0
  let mut k = 0
  while k < out_lines.length() {
    let ln = out_lines[k]
    if has_remap && irc_line_has_phi(ln) {
      irc_rewrite_phi_line(ln, tail_map, out)
    } else {
      out.write_string(ln)
    }
    out.write_char('\n')
    k = k + 1
  }
}

///|
struct IrcModFn {
  line_start : Int
  body_end : Int
  close_end : Int
  fn_end : Int
  fn_hdr : String
  fn_name : String
  cleaned : Array[String]
  cfg : IrcCfg
  in_loop : Array[Bool]
  eff_insts : Int
  rc_count : Int
}

///|
/// Scan a function's lines block-by-block to compute:
/// - `eff_insts`: effective non-empty, non-comment, non-label instructions
/// - `rc_count`: remaining valid `$pion_rc_inc`/`$pion_rc_dec` calls
/// - direct call targets appended to `fn_callees` (all blocks) and
///   `loop_callees` (only blocks with `in_loop[bi] == true`, when `!cfg.disable_cfg`).
fn irc_analyze_fn_body(
  fn_lines : Array[String],
  cfg : IrcCfg,
  in_loop : Array[Bool],
  fn_callees : Array[String],
  loop_callees : Array[String],
) -> (Int, Int) {
  let seen_all : Map[String, Bool] = Map::new()
  let seen_loop : Map[String, Bool] = Map::new()
  let reachable = if cfg.disable_cfg { [] } else { irc_compute_reachable_blocks(cfg) }
  let mut eff_insts = 0
  let mut rc_count = 0
  let nblk = cfg.blk_starts.length()
  let mut bi = 0
  while bi < nblk {
    let bs = cfg.blk_starts[bi]
    let be = cfg.blk_ends[bi]
    let blk_reach = !cfg.disable_cfg && bi < reachable.length() && reachable[bi]
    let blk_hot = blk_reach && bi < in_loop.length() && in_loop[bi]
    let mut li = bs
    while li < be {
      let t = irc_strip_comment(fn_lines[li])
      if t.length() > 0 && str_code_at(t, 0) != 64 {
        eff_insts = eff_insts + 1
        let kind = irc_match_rc_call(t)
        if kind != 0 {
          if irc_is_valid_qbe_val(irc_extract_rc_arg(t)) {
            rc_count = rc_count + 1
          }
        } else if blk_reach {
          let callee = irc_extract_direct_call_target(t)
          if callee.length() > 0 {
            if !seen_all.contains(callee) {
              seen_all.set(callee, true)
              fn_callees.push(callee)
            }
            if blk_hot && !seen_loop.contains(callee) {
              seen_loop.set(callee, true)
              loop_callees.push(callee)
            }
          }
        }
      }
      li = li + 1
    }
    bi = bi + 1
  }
  (eff_insts, rc_count)
}

///|
/// Function-level two-tier fast-path driver over raw SSA text:
/// 1. Non-function lines and functions without `$pion_rc_` are streamed verbatim
///    without line splitting or Map allocation (in `do_inline` mode, non-RC
///    functions containing `call` are lightly scanned for loop-callee propagation
///    while still emitted verbatim).
/// 2. Functions with `$pion_rc_` always run `irc_cleanup_fn_body_fast` (0 code bloat).
/// 3. In `do_inline` mode, remaining RC calls are selectively expanded for:
///    - loop basic blocks (deterministic iterative Tarjan SCC),
///    - intra-module `called_in_loop` callees (direct loop callees + 1 hop, `eff_insts <= 128`),
///    - small leaf/recursive functions (`rc_count <= 2 && eff_insts <= 32`),
///    subject to the `Int64` product budget `est_blk * est_tmp <= 2^28`.
fn irc_process_ssa(ssa : String, do_inline : Bool, disable_mask : Int) -> String {
  if !ssa.contains("$pion_rc_inc") && !ssa.contains("$pion_rc_dec") {
    return ssa
  }
  let n = ssa.length()
  let out = StringBuilder()
  let mut raw_start = 0
  let mut pos = 0
  let mut in_quote = false
  let mut escaped = false
  let mut brace_depth = 0

  if !do_inline {
    while pos < n {
      let line_start = pos
      let mut line_end = pos
      while line_end < n && str_code_at(ssa, line_end) != 10 {
        line_end = line_end + 1
      }
      let next_pos = if line_end < n { line_end + 1 } else { n }
      let is_hdr = !in_quote &&
        brace_depth == 0 &&
        irc_is_fn_hdr_range(ssa, line_start, line_end)
      let (nq, ne, nd, n_braces) = irc_scan_line_lex(
        ssa,
        line_start,
        next_pos,
        in_quote,
        escaped,
        brace_depth,
      )
      in_quote = nq
      escaped = ne
      brace_depth = nd
      if is_hdr {
        if brace_depth == 0 {
          pos = next_pos
          continue
        }
        let body_start = next_pos
        let mut cur = body_start
        let mut body_end = n
        let mut close_end = n
        let mut fn_end = n
        let mut has_unclean = in_quote || brace_depth != 1 || n_braces != 1
        while cur < n {
          let ls = cur
          let mut le = cur
          // A line outside a string with no `"`, `#`, `{` or `}` leaves the lexer
          // state unchanged and cannot close the function: skip both checks.
          let mut plain = !in_quote
          while le < n {
            let b = ssa.code_unit_at(le)
            if b == 10 {
              break
            }
            if b == 34 || b == 35 || b == 123 || b == 125 {
              plain = false
            }
            le = le + 1
          }
          let np = if le < n { le + 1 } else { n }
          if !in_quote && !plain && brace_depth == 1 && irc_is_close_brace_range(ssa, ls, le) {
            brace_depth = 0
            body_end = ls
            close_end = le
            fn_end = np
            break
          }
          if !plain {
            let (bq, be, bd, b_braces) = irc_scan_line_lex(
              ssa,
              ls,
              np,
              in_quote,
              escaped,
              brace_depth,
            )
            in_quote = bq
            escaped = be
            brace_depth = bd
            if in_quote || b_braces > 0 {
              has_unclean = true
            }
          }
          if !in_quote && brace_depth == 0 {
            fn_end = np
            break
          }
          cur = np
        }
        if has_unclean || brace_depth != 0 {
          pos = fn_end
          continue
        }
        let flags = irc_scan_body_flags(ssa, body_start, body_end)
        if (flags & 1) == 0 {
          pos = fn_end
          continue
        }
        if line_start > raw_start {
          out.write_string(irc_slice(ssa, raw_start, line_start))
        }
        let fn_hdr = irc_slice(ssa, line_start, line_end)
        out.write_string(fn_hdr)
        out.write_char('\n')
        let body = irc_split_lines_range(ssa, body_start, body_end)
        let cleaned = irc_cleanup_fn_body_fast(fn_hdr, body, disable_mask)
        irc_emit_lines(cleaned, out)
        if body_end < n {
          out.write_string(irc_slice(ssa, body_end, close_end))
          out.write_char('\n')
        }
        pos = fn_end
        raw_start = fn_end
      } else {
        pos = next_pos
      }
    }
    if raw_start == 0 && n > 0 && str_code_at(ssa, n - 1) == 10 {
      return ssa
    }
    if raw_start < n {
      out.write_string(irc_slice(ssa, raw_start, n))
      if str_code_at(ssa, n - 1) != 10 {
        out.write_char('\n')
      }
    }
    return out.to_string()
  }

  // Release (`do_inline == true`):
  // Pass 1: clean all RC-bearing functions, build CFGs + Tarjan SCCs, and collect
  // intra-module call graph + loop-call seeds.
  let mod_fns : Array[IrcModFn] = []
  let fn_eff_insts : Map[String, Int] = Map::new()
  let all_callees : Map[String, Array[String]] = Map::new()
  let loop_callees : Array[String] = []

  while pos < n {
    let line_start = pos
    let mut line_end = pos
    while line_end < n && str_code_at(ssa, line_end) != 10 {
      line_end = line_end + 1
    }
    let next_pos = if line_end < n { line_end + 1 } else { n }
    let is_hdr = !in_quote &&
      brace_depth == 0 &&
      irc_is_fn_hdr_range(ssa, line_start, line_end)
    let (nq, ne, nd, n_braces) = irc_scan_line_lex(
      ssa,
      line_start,
      next_pos,
      in_quote,
      escaped,
      brace_depth,
    )
    in_quote = nq
    escaped = ne
    brace_depth = nd
    if is_hdr {
      if brace_depth == 0 {
        pos = next_pos
        continue
      }
      let body_start = next_pos
      let mut cur = body_start
      let mut body_end = n
      let mut close_end = n
      let mut fn_end = n
      let mut has_unclean = in_quote || brace_depth != 1 || n_braces != 1
      while cur < n {
        let ls = cur
        let mut le = cur
        // A line outside a string with no `"`, `#`, `{` or `}` leaves the lexer
        // state unchanged and cannot close the function: skip both checks.
        let mut plain = !in_quote
        while le < n {
          let b = ssa.code_unit_at(le)
          if b == 10 {
            break
          }
          if b == 34 || b == 35 || b == 123 || b == 125 {
            plain = false
          }
          le = le + 1
        }
        let np = if le < n { le + 1 } else { n }
        if !in_quote && !plain && brace_depth == 1 && irc_is_close_brace_range(ssa, ls, le) {
          brace_depth = 0
          body_end = ls
          close_end = le
          fn_end = np
          break
        }
        if !plain {
          let (bq, be, bd, b_braces) = irc_scan_line_lex(
            ssa,
            ls,
            np,
            in_quote,
            escaped,
            brace_depth,
          )
          in_quote = bq
          escaped = be
          brace_depth = bd
          if in_quote || b_braces > 0 {
            has_unclean = true
          }
        }
        if !in_quote && brace_depth == 0 {
          fn_end = np
          break
        }
        cur = np
      }
      if has_unclean || brace_depth != 0 {
        pos = fn_end
        continue
      }
      let flags = irc_scan_body_flags(ssa, body_start, body_end)
      let has_rc = (flags & 1) != 0
      let has_call = (flags & 4) != 0
      if !has_rc && !has_call {
        pos = fn_end
        continue
      }
      let fn_hdr = irc_slice(ssa, line_start, line_end)
      let fn_name = irc_extract_fn_name(fn_hdr)
      let body = irc_split_lines_range(ssa, body_start, body_end)
      if !has_rc {
        let cfg = irc_build_cfg(body)
        let in_loop = if cfg.disable_cfg { [] } else { irc_compute_loop_blocks(cfg) }
        let callees : Array[String] = []
        let (eff_insts, _) = irc_analyze_fn_body(body, cfg, in_loop, callees, loop_callees)
        if fn_name.length() > 0 {
          fn_eff_insts.set(fn_name, eff_insts)
          if callees.length() > 0 {
            all_callees.set(fn_name, callees)
          }
        }
        pos = fn_end
        continue
      }
      let cleaned = irc_cleanup_fn_body_fast(fn_hdr, body, disable_mask)
      let cfg = irc_build_cfg(cleaned)
      let in_loop = if cfg.disable_cfg { [] } else { irc_compute_loop_blocks(cfg) }
      let callees : Array[String] = []
      let (eff_insts, rc_count) = irc_analyze_fn_body(
        cleaned,
        cfg,
        in_loop,
        callees,
        loop_callees,
      )
      if fn_name.length() > 0 {
        fn_eff_insts.set(fn_name, eff_insts)
        if callees.length() > 0 {
          all_callees.set(fn_name, callees)
        }
      }
      mod_fns.push(IrcModFn::{
        line_start: line_start,
        body_end: body_end,
        close_end: close_end,
        fn_end: fn_end,
        fn_hdr: fn_hdr,
        fn_name: fn_name,
        cleaned: cleaned,
        cfg: cfg,
        in_loop: in_loop,
        eff_insts: eff_insts,
        rc_count: rc_count,
      })
      pos = fn_end
    } else {
      pos = next_pos
    }
  }

  // Propagate `called_in_loop` (direct loop callees + 1 hop) across compact
  // intra-module callees (`eff_insts <= 128`), plus small leaf/recursive fallback.
  let max_hot_callee_insts = 128
  let max_hot_hops = 1
  let small_fn_max_rc = 2
  let small_fn_max_insts = 32

  let hot_callees : Map[String, Bool] = Map::new()
  let mut frontier : Array[String] = []
  let mut li = 0
  while li < loop_callees.length() {
    let tgt = loop_callees[li]
    if !hot_callees.contains(tgt) {
      match fn_eff_insts.get(tgt) {
        Some(insts) =>
          if insts <= max_hot_callee_insts {
            hot_callees.set(tgt, true)
            frontier.push(tgt)
          }
        None => ()
      }
    }
    li = li + 1
  }
  let mut hop = 0
  while hop < max_hot_hops && frontier.length() > 0 {
    let next_frontier : Array[String] = []
    let mut fi = 0
    while fi < frontier.length() {
      let cur_fn = frontier[fi]
      match all_callees.get(cur_fn) {
        Some(callees) => {
          let mut ci = 0
          while ci < callees.length() {
            let tgt = callees[ci]
            if !hot_callees.contains(tgt) {
              match fn_eff_insts.get(tgt) {
                Some(insts) =>
                  if insts <= max_hot_callee_insts {
                    hot_callees.set(tgt, true)
                    next_frontier.push(tgt)
                  }
                None => ()
              }
            }
            ci = ci + 1
          }
        }
        None => ()
      }
      fi = fi + 1
    }
    frontier = next_frontier
    hop = hop + 1
  }

  // Pass 2: emit module with selective RC expansion.
  let mut mi = 0
  while mi < mod_fns.length() {
    let mf = mod_fns[mi]
    if mf.line_start > raw_start {
      out.write_string(irc_slice(ssa, raw_start, mf.line_start))
    }
    out.write_string(mf.fn_hdr)
    out.write_char('\n')
    if mf.rc_count == 0 || mf.cfg.disable_cfg {
      irc_emit_lines(mf.cleaned, out)
    } else {
      let is_hot = mf.fn_name.length() > 0 && hot_callees.contains(mf.fn_name)
      let is_small = mf.rc_count <= small_fn_max_rc && mf.eff_insts <= small_fn_max_insts
      let (expand_mask, sel_count) = irc_build_expand_mask(
        mf.cleaned,
        mf.cfg,
        mf.in_loop,
        is_hot || is_small,
      )
      if sel_count > 0 && irc_within_inline_budget_mask(mf.fn_hdr, mf.cleaned, expand_mask) {
        irc_expand_fn_body_mask(mf.cleaned, expand_mask, out)
      } else {
        irc_emit_lines(mf.cleaned, out)
      }
    }
    if mf.body_end < n {
      out.write_string(irc_slice(ssa, mf.body_end, mf.close_end))
      out.write_char('\n')
    }
    raw_start = mf.fn_end
    mi = mi + 1
  }

  if raw_start == 0 && n > 0 && str_code_at(ssa, n - 1) == 10 {
    return ssa
  }
  if raw_start < n {
    out.write_string(irc_slice(ssa, raw_start, n))
    if str_code_at(ssa, n - 1) != 10 {
      out.write_char('\n')
    }
  }
  out.to_string()
}

///|
/// Clean up native QBE SSA RC calls (same-block pair cancellation + multi-def-safe
/// static immortal RC elimination) with zero new basic blocks. Runs in both dev and
/// release native builds; never called for wasm32.
pub fn cleanup_native_rc_ssa(ssa : String) -> String {
  irc_process_ssa(ssa, false, 0)
}

///|
pub fn cleanup_native_rc_ssa_opts(ssa : String, disable_mask : Int) -> String {
  irc_process_ssa(ssa, false, disable_mask)
}

///|
/// Clean up RC calls, apply `Int64` product budget, and inline single-threaded
/// Biased RC fast paths (including single-threaded frozen `shared_rc` via `phi`)
/// in native QBE SSA (for release builds; never called for wasm32).
pub fn inline_native_rc_ssa(ssa : String) -> String {
  irc_process_ssa(ssa, true, 0)
}

///|
pub fn inline_native_rc_ssa_opts(ssa : String, disable_mask : Int) -> String {
  irc_process_ssa(ssa, true, disable_mask)
}
