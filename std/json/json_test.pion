///| std/json tests

fn parse_ok(src : String) -> JsonValue {
  match parse(src) {
    Ok(v) => v
    Err(e) => {
      debug_assert(false, "unexpected parse error: " + e)
      JNull
    }
  }
}

/// UTF-8 string of the given code points (keeps the sources ASCII-only).
fn cp_str(cps : Array[Int]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < cps.length() {
    sb.write_char(cps[i].unsafe_to_char())
    i = i + 1
  }
  sb.to_string()
}

fn opt_str_is(o : Option[String], want : String) -> Bool {
  match o {
    Some(s) => s == want
    None => false
  }
}

fn opt_int_is(o : Option[Int64], want : Int64) -> Bool {
  match o {
    Some(n) => n == want
    None => false
  }
}

fn opt_bool_is(o : Option[Bool], want : Bool) -> Bool {
  match o {
    Some(b) => b == want
    None => false
  }
}

fn parse_err(src : String) -> String {
  match parse(src) {
    Ok(_) => ""
    Err(e) => e
  }
}

test "parse scalars" {
  debug_assert(json_equal(parse_ok("null"), JNull), "null")
  debug_assert(json_equal(parse_ok(" true "), JBool(true)), "true")
  debug_assert(json_equal(parse_ok("false"), JBool(false)), "false")
  debug_assert(json_equal(parse_ok("0"), JInt(0L)), "zero")
  debug_assert(json_equal(parse_ok("-42"), JInt(-42L)), "negative int")
  debug_assert(json_equal(parse_ok("9007199254740993"), JInt(9007199254740993L)), "big int")
  debug_assert(json_equal(parse_ok("3.5"), JFloat(3.5)), "float")
  debug_assert(json_equal(parse_ok("-0.25"), JFloat(-0.25)), "negative float")
  debug_assert(json_equal(parse_ok("1e3"), JFloat(1000.0)), "exponent")
  debug_assert(json_equal(parse_ok("2.5E-1"), JFloat(0.25)), "negative exponent")
}

test "parse strings and escapes" {
  debug_assert(json_equal(parse_ok("\"hi\""), JStr("hi")), "plain")
  let esc = parse_ok("\"a\\\"b\\\\c\\/d\\n\\t\\r\"")
  debug_assert(json_equal(esc, JStr("a\"b\\c/d\n\t\r")), "simple escapes")
  let uni = parse_ok("\"\\u0041\\u00e9\\u4e2d\"")
  debug_assert(json_equal(uni, JStr(cp_str([65, 233, 20013]))), "unicode escapes")
  let pair = parse_ok("\"\\ud83d\\ude00\"")
  debug_assert(json_equal(pair, JStr(cp_str([128512]))), "surrogate pair")
  let zh = cp_str([20013, 25991])
  debug_assert(json_equal(parse_ok("\"" + zh + "\""), JStr(zh)), "raw utf-8")
  debug_assert(stringify(JStr(zh)) == "\"" + zh + "\"", "raw utf-8 is not escaped")
}

test "parse nested arrays and objects" {
  let v = parse_ok("{ \"name\" : \"pion\", \"tags\": [1, 2.5, \"x\", null, [true]], \"meta\": {\"ok\": false, \"n\": {}} }")
  match obj_get(v, "name") {
    Some(n) => {
      debug_assert(opt_str_is(as_str(n), "pion"), "name")
    }
    None => {
      debug_assert(false, "missing name")
    }
  }
  match obj_get(v, "tags") {
    Some(t) =>
    match as_arr(t) {
      Some(items) => {
        debug_assert(items.length() == 5, "tags length")
        debug_assert(opt_int_is(as_int(items[0]), 1L), "tags[0]")
        debug_assert(json_equal(items[1], JFloat(2.5)), "tags[1]")
        debug_assert(json_equal(items[3], JNull), "tags[3]")
        debug_assert(json_equal(items[4], JArr([JBool(true)])), "tags[4]")
      }
      None => {
        debug_assert(false, "tags not array")
      }
    }
    None => {
      debug_assert(false, "missing tags")
    }
  }
  match obj_get(v, "meta") {
    Some(m) => {
      match obj_get(m, "ok") {
        Some(okv) => {
          debug_assert(opt_bool_is(as_bool(okv), false), "meta.ok")
        }
        None => {
          debug_assert(false, "missing meta.ok")
        }
      }
      match obj_get(m, "n") {
        Some(nv) => {
          debug_assert(json_equal(nv, JObj([])), "meta.n empty object")
        }
        None => {
          debug_assert(false, "missing meta.n")
        }
      }
    }
    None => {
      debug_assert(false, "missing meta")
    }
  }
  match obj_get(v, "absent") {
    Some(_) => {
      debug_assert(false, "absent key found")
    }
    None => ()
  }
  debug_assert(json_equal(parse_ok("[]"), JArr([])), "empty array")
}

test "stringify and roundtrip" {
  let e_acute = cp_str([233])
  let v = JObj([
    field("s", JStr("q\"uote\\ \n\t" + e_acute)),
    field("i", JInt(-7L)),
    field("f", JFloat(1.0)),
    field("b", JBool(true)),
    field("n", JNull),
    field("a", JArr([JInt(1L), JStr("two"), JArr([])])),
  ])
  let text = stringify(v)
  debug_assert(
    text ==
    "{\"s\":\"q\\\"uote\\\\ \\n\\t" +
    e_acute +
    "\",\"i\":-7,\"f\":1.0,\"b\":true,\"n\":null,\"a\":[1,\"two\",[]]}",
    "stringify output: " + text
  )
  let back = parse_ok(text)
  debug_assert(json_equal(back, v), "roundtrip")
  debug_assert(stringify(parse_ok(" [ 1 , {\"k\" : [ ] } ] ")) == "[1,{\"k\":[]}]", "compact")
  debug_assert(stringify(parse_ok("\"\\u0001\\u001f\"")) == "\"\\u0001\\u001f\"", "control escapes")
  debug_assert(stringify(JFloat(0.1)) == "0.1", "float 0.1")
  debug_assert(json_equal(parse_ok(stringify(JFloat(123.456))), JFloat(123.456)), "float roundtrip")
}

test "ToJson trait monomorphization" {
  debug_assert(encode(42) == "42", "Int")
  debug_assert(encode(7L) == "7", "Int64")
  debug_assert(encode(true) == "true", "Bool")
  debug_assert(encode("a\"b") == "\"a\\\"b\"", "String")
  debug_assert(encode(JArr([JInt(1L), JNull])) == "[1,null]", "JsonValue")
  let direct = (5).to_json()
  debug_assert(json_equal(direct, JInt(5L)), "method call on Int")
  let sv = "x".to_json()
  debug_assert(json_equal(sv, JStr("x")), "method call on String")
}

test "invalid input errors carry offsets" {
  debug_assert(parse_err("") == "unexpected end of input at offset 0", "empty: " + parse_err(""))
  debug_assert(parse_err("[1, 2") == "expected ',' or ']' in array at offset 5", "array: " + parse_err("[1, 2"))
  debug_assert(parse_err("{\"a\" 1}") == "expected ':' after object key at offset 5", "colon: " + parse_err("{\"a\" 1}"))
  debug_assert(parse_err("{1:2}") == "expected string key in object at offset 1", "key: " + parse_err("{1:2}"))
  debug_assert(parse_err("tru") == "invalid literal at offset 0", "literal: " + parse_err("tru"))
  debug_assert(parse_err("\"abc") == "unterminated string at offset 4", "string: " + parse_err("\"abc"))
  debug_assert(parse_err("\"\\x\"") == "invalid escape character at offset 2", "escape: " + parse_err("\"\\x\""))
  debug_assert(parse_err("01") == "leading zero in number at offset 1", "zero: " + parse_err("01"))
  debug_assert(parse_err("1.") == "expected digit after decimal point at offset 2", "frac: " + parse_err("1."))
  debug_assert(parse_err("[1] x") == "trailing characters after JSON value at offset 4", "trailing: " + parse_err("[1] x"))
  debug_assert(parse_err("@") == "unexpected character '@' at offset 0", "char: " + parse_err("@"))
  debug_assert(parse_err("\"\\ud800\"") == "unpaired surrogate in \\u escape at offset 7", "surrogate: " + parse_err("\"\\ud800\""))
}
