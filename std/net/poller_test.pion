///| std/net tests (pure: event masks, interest and the write queue's bookkeeping).
///| Real kqueue/epoll IO runs in `examples/http_event_server --self-test`.

test "event constants match the runtime ABI" {
  debug_assert(POLL_ADD == 1 && POLL_MOD == 2 && POLL_DEL == 3, "poll ops")
  debug_assert(EV_READ == 1 && EV_WRITE == 2 && EV_ERR == 4, "event bits")
  debug_assert(IO_AGAIN == -2 && MAX_EVENTS == 256, "again / batch")
}

test "masks, interest and descriptions" {
  debug_assert(has_event(EV_READ | EV_ERR, EV_READ), "read in read|err")
  debug_assert(!has_event(EV_READ, EV_WRITE), "no write in read")
  debug_assert(has_event(3, EV_READ | EV_WRITE), "both bits")
  debug_assert(!has_event(EV_READ, EV_READ | EV_WRITE), "all bits required")
  debug_assert(interest(true, false) == EV_READ, "read only")
  debug_assert(interest(true, true) == 3, "read|write")
  debug_assert(interest(false, true) == EV_WRITE, "write only")
  debug_assert(interest(false, false) == 0, "none")
  debug_assert(describe_events(7) == "READ|WRITE|ERR", "all: " + describe_events(7))
  debug_assert(describe_events(EV_WRITE) == "WRITE", "write")
  debug_assert(describe_events(0) == "-", "empty")
  debug_assert(is_again(-2) && !is_again(-1) && !is_again(0), "again")
}

test "write queue keeps only unsent bytes" {
  let q = write_queue_new()
  debug_assert(wq_pending(q) == 0, "empty")
  wq_push(q, "hello ")
  wq_push(q, "world")
  debug_assert(wq_pending(q) == 11 && q.data == "hello world", "appended: " + q.data)
  wq_advance(q, 4)
  debug_assert(wq_pending(q) == 7 && q.off == 4, "partial send")
  wq_push(q, "!")
  debug_assert(q.data == "o world!" && q.off == 0, "compacted on push: " + q.data)
  wq_advance(q, 8)
  debug_assert(wq_pending(q) == 0 && q.data == "" && q.off == 0, "drained resets")
  wq_push(q, "next")
  debug_assert(q.data == "next", "reuse after drain")
}
