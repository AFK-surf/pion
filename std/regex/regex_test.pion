///| std/regex tests

fn re(pattern : String) -> Regex {
  match compile(pattern) {
    Ok(r) => r
    Err(e) => {
      debug_assert(false, "unexpected compile error: " + e)
      re("")
    }
  }
}

fn compile_err(pattern : String) -> String {
  match compile(pattern) {
    Ok(_) => ""
    Err(e) => e
  }
}

/// `start..end:text` of the first match, or `none`.
fn first(pattern : String, text : String) -> String {
  match find(re(pattern), text) {
    Some(m) => m.start.to_string() + ".." + m.end.to_string() + ":" + m.text
    None => "none"
  }
}

/// Every match text joined by `|`.
fn all(pattern : String, text : String) -> String {
  let ms = find_all(re(pattern), text)
  let parts : Array[String] = []
  let mut i = 0
  while i < ms.length() {
    parts.push(ms[i].text)
    i = i + 1
  }
  parts.join("|")
}

fn repeat_str(s : String, n : Int) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < n {
    sb.write_string(s)
    i = i + 1
  }
  sb.to_string()
}

test "literals, dot and anchors" {
  debug_assert(is_match(re("abc"), "xxabcxx"), "substring")
  debug_assert(!is_match(re("abd"), "xxabcxx"), "no match")
  debug_assert(first("b.d", "abcd bxd") == "1..4:bcd", "dot: " + first("b.d", "abcd bxd"))
  debug_assert(first("a.c", "a\nc") == "none", "dot skips newline")
  debug_assert(first("^ab", "abab") == "0..2:ab", "^ at start")
  debug_assert(first("^b", "abab") == "none", "^ only at start")
  debug_assert(first("ab$", "abab") == "2..4:ab", "$ at end")
  debug_assert(first("^$", "") == "0..0:", "empty text")
  debug_assert(is_match(re(""), "anything"), "empty pattern")
  debug_assert(first("x*", "abc") == "0..0:", "empty match at 0")
}

test "escapes and Perl classes" {
  debug_assert(first("\\d+", "order #4521 ok") == "7..11:4521", "\\d+")
  debug_assert(first("\\D+", "12ab34") == "2..4:ab", "\\D+")
  debug_assert(first("\\w+", "  hello_42! ") == "2..10:hello_42", "\\w+")
  debug_assert(first("\\W+", "ab, cd") == "2..4:, ", "\\W+")
  debug_assert(first("\\s+", "a \t\nb") == "1..4: \t\n", "\\s+")
  debug_assert(first("\\S+", "  xy  ") == "2..4:xy", "\\S+")
  debug_assert(first("a\\.b", "axb a.b") == "4..7:a.b", "escaped dot")
  debug_assert(first("\\\\", "a\\b") == "1..2:\\", "escaped backslash")
  debug_assert(first("\\(\\d\\)", "f(7)") == "1..4:(7)", "escaped parens")
  debug_assert(first("\\t", "a\tb") == "1..2:\t", "\\t")
}

test "character classes" {
  debug_assert(all("[a-c0-9_]+", "xxab1_zz c9") == "ab1_|c9", "ranges: " + all("[a-c0-9_]+", "xxab1_zz c9"))
  debug_assert(all("[^a-z ]+", "ab12 CD!e") == "12|CD!", "negated: " + all("[^a-z ]+", "ab12 CD!e"))
  debug_assert(first("[]a]+", "x]a]y") == "1..4:]a]", "leading ]")
  debug_assert(first("[a-]+", "x-a-y") == "1..4:-a-", "trailing -")
  debug_assert(first("[\\d.]+", "v1.25b") == "1..5:1.25", "escape in class")
  debug_assert(first("[\\s,]+", "a, \tb") == "1..4:, \t", "\\s in class")
  debug_assert(first("[^,]+", "é,b") == "0..2:é", "negated class keeps UTF-8 whole")
  debug_assert(first("[éa]+", "xaéay") == "1..5:aéa", "non-ASCII class member")
}

test "groups, alternation and quantifiers" {
  debug_assert(first("(ab)+", "xababab") == "1..7:ababab", "group +")
  debug_assert(first("(?:ab)+c", "ababc") == "0..5:ababc", "non-capturing group")
  debug_assert(all("cat|dog|bird", "dog cat fish bird") == "dog|cat|bird", "alternation")
  debug_assert(first("gr(a|e)y", "grey gray") == "0..4:grey", "alternation in group")
  debug_assert(first("colou?r", "color colour") == "0..5:color", "?")
  debug_assert(first("ab*", "abbbc") == "0..4:abbb", "greedy *")
  debug_assert(first("ab*?", "abbbc") == "0..1:a", "lazy *?")
  debug_assert(first("a.+?c", "abcabc") == "0..3:abc", "lazy +?")
  debug_assert(first("a.+c", "abcabc") == "0..6:abcabc", "greedy +")
  debug_assert(first("a{3}", "aaaaa") == "0..3:aaa", "{n}")
  debug_assert(first("a{2,}", "aaaaa") == "0..5:aaaaa", "{n,}")
  debug_assert(first("a{2,3}", "aaaaa") == "0..3:aaa", "{n,m}")
  debug_assert(first("a{2,3}?", "aaaaa") == "0..2:aa", "lazy {n,m}?")
  debug_assert(first("x{a", "x{a") == "0..3:x{a", "non-quantifier brace is literal")
  debug_assert(first("a|", "b") == "0..0:", "empty alternative")
  debug_assert(first("(a|ab)(c|bcd)", "abcd") == "0..4:abcd", "leftmost-first alternation")
}

test "UTF-8 text" {
  debug_assert(first("值.", "键值对") == "3..9:值对", "multi-byte literal and dot")
  debug_assert(first("é+", "caféé!") == "3..7:éé", "quantifier applies to whole character")
  debug_assert(all("\\w+", "naïve café") == "na|ve|caf", "\\w is ASCII")
  debug_assert(all("[^ ]+", "日本 語") == "日本|語", "negated class over CJK")
  debug_assert(all(".", "a🚀") == "a|🚀", "dot takes 4-byte characters")
}

test "find_all and replace_all" {
  debug_assert(all("\\d+", "a1b22c333") == "1|22|333", "find_all digits")
  debug_assert(find_all(re("z"), "abc").length() == 0, "no matches")
  let empties = find_all(re("a*"), "baaac")
  debug_assert(empties.length() == 3, "empty matches: " + empties.length().to_string())
  debug_assert(empties[0].start == 0 && empties[0].end == 0, "empty at 0")
  debug_assert(empties[1].text == "aaa" && empties[2].start == 5, "aaa then empty at end")
  let ms = find_all(re("[a-z]+@[a-z]+\\.com"), "mail ann@x.com, bob@yz.com.")
  debug_assert(ms.length() == 2 && ms[1].start == 16 && ms[1].end == 26, "match offsets")
  debug_assert(replace_all(re("\\s+"), "a  b\t\nc", " ") == "a b c", "collapse spaces")
  debug_assert(replace_all(re("\\d"), "a1b2", "#") == "a#b#", "replace digits")
  debug_assert(replace_all(re("x"), "abc", "y") == "abc", "nothing replaced")
  debug_assert(replace_all(re(""), "ab", "-") == "-a-b-", "empty pattern")
  debug_assert(replace_all(re("é"), "été", "e") == "ete", "UTF-8 replace")
  debug_assert(escape("a.b*c") == "a\\.b\\*c", "escape")
  debug_assert(is_match(re(escape("1+1=2?")), "is 1+1=2?"), "escaped literal")
}

test "invalid patterns are errors" {
  debug_assert(compile_err("(ab").starts_with("missing closing `)` at offset 0"), compile_err("(ab"))
  debug_assert(compile_err("ab)").starts_with("unmatched `)` at offset 2"), compile_err("ab)"))
  debug_assert(compile_err("[a-z").starts_with("missing closing `]` for character class at offset 0"), compile_err("[a-z"))
  debug_assert(compile_err("[z-a]").starts_with("invalid character class range"), compile_err("[z-a]"))
  debug_assert(compile_err("*a").starts_with("missing argument to repetition operator"), compile_err("*a"))
  debug_assert(compile_err("a|+").starts_with("missing argument to repetition operator"), compile_err("a|+"))
  debug_assert(compile_err("ab\\").starts_with("trailing backslash"), compile_err("ab\\"))
  debug_assert(compile_err("\\q").starts_with("unknown escape `\\q`"), compile_err("\\q"))
  debug_assert(compile_err("a{3,2}").starts_with("invalid repetition range"), compile_err("a{3,2}"))
  debug_assert(compile_err("a{1001}").starts_with("repetition count above 1000"), compile_err("a{1001}"))
  debug_assert(compile_err("(?i)a").starts_with("unsupported group flag"), compile_err("(?i)a"))
  debug_assert(compile_err("[^é]").starts_with("non-ASCII character in negated class"), compile_err("[^é]"))
}

test "ReDoS: (a?){n}a{n} is linear" {
  // A backtracking engine needs 2^n steps here; the Pike VM needs O(n^2).
  let a25 = repeat_str("a", 25)
  let r25 = re("(a?){25}a{25}")
  debug_assert(is_match(r25, a25), "(a?){25}a{25} on a^25")
  debug_assert(first("(a?){25}a{25}", a25) == "0..25:" + a25, "full match")
  let a100 = repeat_str("a", 100)
  debug_assert(is_match(re("(a?){100}a{100}"), a100), "(a?){100}a{100} on a^100")
  debug_assert(!is_match(re("(a?){100}a{100}"), repeat_str("a", 99)), "a^99 fails fast")
}

test "ReDoS: nested quantifiers on long input" {
  let long_a = repeat_str("a", 20000)
  debug_assert(!is_match(re("(a*)*b"), long_a), "(a*)*b")
  debug_assert(!is_match(re("(a|aa)+$"), long_a + "!"), "(a|aa)+$")
  debug_assert(!is_match(re("^(\\w+\\s?)*$"), repeat_str("word ", 4000) + "!"), "^(\\w+\\s?)*$")
  debug_assert(!is_match(re("(x+x+)+y"), repeat_str("x", 5000)), "(x+x+)+y")
  match find(re("(a+)+$"), long_a) {
    Some(m) => { debug_assert(m.start == 0 && m.end == 20000, "(a+)+$ full span") }
    None => { debug_assert(false, "(a+)+$ should match") }
  }
  debug_assert(program_size(re("(a?){25}a{25}")) < 200, "program stays small")
}
