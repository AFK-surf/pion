///| std/tls tests (pure: platform backend linkage, version, host classification
///| and the server's argument / certificate error paths). Real loopback
///| handshakes run in `std/tls/e2e/run_e2e.sh` (client + `tls_wrap_fd`) and
///| `run_server_e2e.sh` (server).

test "linked TLS backend reports its version" {
  let v = tls_version()
  debug_assert(
    v.starts_with("OpenSSL ") ||
    v.starts_with("LibreSSL ") ||
    v.starts_with("Apple Network.framework") ||
    v.starts_with("Windows Schannel"),
    "tls_version: " + v,
  )
  debug_assert(v.length() > 9, "version text: " + v)
}

test "IPv4 literals are told apart from host names" {
  debug_assert(is_ipv4_literal("127.0.0.1"), "loopback")
  debug_assert(is_ipv4_literal("255.255.255.255"), "broadcast")
  debug_assert(!is_ipv4_literal("256.0.0.1"), "octet too large")
  debug_assert(!is_ipv4_literal("localhost"), "host name")
  debug_assert(!is_ipv4_literal("1.2.3"), "three parts")
  debug_assert(!is_ipv4_literal("1.2.3.4.5"), "five parts")
  debug_assert(!is_ipv4_literal("1..3.4"), "empty part")
  debug_assert(!is_ipv4_literal("example.com"), "dns name")
  debug_assert(!is_ipv4_literal(""), "empty")
}

test "listen arguments are validated before anything is allocated" {
  match check_listen_args(0, "cert.pem", "key.pem") {
    Ok(_) => ()
    Err(e) => debug_assert(false, "valid args rejected: " + e)
  }
  match check_listen_args(65535, "c", "k") {
    Ok(_) => ()
    Err(e) => debug_assert(false, "port 65535 rejected: " + e)
  }
  match check_listen_args(-1, "c", "k") {
    Ok(_) => debug_assert(false, "negative port accepted")
    Err(e) => debug_assert(e.contains("invalid port -1"), e)
  }
  match check_listen_args(65536, "c", "k") {
    Ok(_) => debug_assert(false, "port 65536 accepted")
    Err(e) => debug_assert(e.contains("invalid port 65536"), e)
  }
  match check_listen_args(443, "", "k") {
    Ok(_) => debug_assert(false, "empty certificate path accepted")
    Err(e) => debug_assert(e.contains("certificate"), e)
  }
  match check_listen_args(443, "c", "") {
    Ok(_) => debug_assert(false, "empty key path accepted")
    Err(e) => debug_assert(e.contains("private key"), e)
  }
}

test "a missing certificate file is an Err with a clear reason" {
  let out_fd = ptr_alloc(8L)
  let out_port = ptr_alloc(8L)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let cert = "/nonexistent/pion-tls/cert.pem"
  let key = "/nonexistent/pion-tls/key.pem"
  let lh = c_tls_listen("127.0.0.1".as_cstr(), 0, cert.as_cstr(), key.as_cstr(), out_fd, out_port, err_buf, 512)
  let e = cstr_to_str(err_buf)
  ptr_free(out_fd)
  ptr_free(out_port)
  ptr_free(err_buf)
  debug_assert(ptr_is_null(lh), "listener built from a missing certificate")
  if tls_version().starts_with("Windows Schannel") {
    debug_assert(e.contains("not supported on Windows Schannel"), e)
  } else {
    debug_assert(e.starts_with("loading certificate chain `/nonexistent/pion-tls/cert.pem` failed: "), e)
    debug_assert(e.length() > 65, "reason attached: " + e)
  }
}

test "a file that is not PEM is rejected as a certificate" {
  let out_fd = ptr_alloc(8L)
  let out_port = ptr_alloc(8L)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let lh = c_tls_listen("127.0.0.1".as_cstr(), 0, "/dev/null".as_cstr(), "/dev/null".as_cstr(), out_fd, out_port, err_buf, 512)
  let e = cstr_to_str(err_buf)
  ptr_free(out_fd)
  ptr_free(out_port)
  ptr_free(err_buf)
  debug_assert(ptr_is_null(lh), "listener built from /dev/null")
  if tls_version().starts_with("Windows Schannel") {
    debug_assert(e.contains("not supported on Windows Schannel"), e)
  } else {
    debug_assert(e.starts_with("loading certificate chain `/dev/null` failed"), e)
  }
}
