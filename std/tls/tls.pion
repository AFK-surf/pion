///| std/tls: system-native TLS 1.2 / 1.3 client and server across Linux, macOS
///| and Windows, with zero OpenSSL dependency on macOS and Windows.
///|
///| Platform backends (selected via `[link.linux]` / `[link.macos]` /
///| `[link.windows]` in `std/tls/pion.toml`, zero bytes added to `libpionrt.a`):
///|   - macOS: Apple `Network.framework` + `Security.framework` +
///|     `CoreFoundation` (TLS 1.2/1.3, system Keychain trust store, in-memory
///|     `SecIdentityCreate` for server mode with zero Keychain writes).
///|   - Windows: Windows `Schannel` (`secur32` + `crypt32` + `ws2_32`, TLS
///|     1.2/1.3, Windows root certificate store, `SSL_CERT_FILE` exclusive root
///|     engine for tests/custom CAs).
///|   - Linux: system OpenSSL (`libssl` + `libcrypto`, TLS 1.2/1.3, default
///|     verify paths honouring `SSL_CERT_FILE` / `SSL_CERT_DIR`).
///|
///| Certificate verification checks the host name (or IP address) against the
///| certificate and enforces TLS 1.2 minimum. `tls_connect` supports full DNS
///| resolution (IPv4/IPv6); `tls_wrap_fd` upgrades an already-connected TCP
///| socket (e.g. after HTTP CONNECT or SOCKS5 proxy negotiation) in place.

import "http"

extern "C" fn c_tls_version() -> Ptr = "pion_tls_version"
extern "C" fn c_tls_connect(
  host : Ptr,
  port : Int,
  verify_cert : Int,
  out_fd : Ptr,
  err_buf : Ptr,
  err_cap : Int,
) -> Ptr = "pion_tls_connect"
extern "C" fn c_tls_wrap_fd(
  fd : Int,
  host : Ptr,
  verify_cert : Int,
  err_buf : Ptr,
  err_cap : Int,
) -> Ptr = "pion_tls_wrap_fd"
extern "C" fn c_tls_protocol(h : Ptr, buf : Ptr, cap : Int) -> Int = "pion_tls_protocol"
extern "C" fn c_tls_cipher(h : Ptr, buf : Ptr, cap : Int) -> Int = "pion_tls_cipher"
extern "C" fn c_tls_write(
  h : Ptr,
  data : Ptr,
  len : Int,
  err_buf : Ptr,
  err_cap : Int,
) -> Int = "pion_tls_write"
extern "C" fn c_tls_read(h : Ptr, buf : Ptr, max_bytes : Int) -> Int = "pion_tls_read"
extern "C" fn c_tls_close(h : Ptr) -> Unit = "pion_tls_close"
extern "C" fn c_tls_listen(
  host : Ptr,
  port : Int,
  cert_pem : Ptr,
  key_pem : Ptr,
  out_fd : Ptr,
  out_port : Ptr,
  err_buf : Ptr,
  err_cap : Int,
) -> Ptr = "pion_tls_listen"
extern "C" fn c_tls_accept(
  lh : Ptr,
  out_fd : Ptr,
  sni_buf : Ptr,
  sni_cap : Int,
  err_buf : Ptr,
  err_cap : Int,
) -> Ptr = "pion_tls_accept"
extern "C" fn c_tls_listener_close(lh : Ptr) -> Unit = "pion_tls_listener_close"

/// An established TLS session over a TCP socket. `host` is the name a client
/// connected to, or on the server side the SNI name the client sent (`""` when
/// it sent none, e.g. for an IP literal).
pub struct TlsConn {
  handle : Ptr
  pub fd : Int
  pub host : String
}

/// A listening TLS server socket. `port` is the bound port (the ephemeral one
/// when `tls_listen` was given 0).
pub struct TlsListener {
  handle : Ptr
  pub fd : Int
  pub port : Int
}

/// Version text of the active platform TLS backend.
pub fn tls_version() -> String {
  cstr_to_str(c_tls_version())
}

/// True for a dotted IPv4 literal such as `127.0.0.1` (no SNI is sent for it,
/// and it is verified as an IP address rather than a DNS name).
pub fn is_ipv4_literal(host : String) -> Bool {
  if host.length() == 0 {
    return false
  }
  let parts = host.split(".")
  if parts.length() != 4 {
    return false
  }
  let mut i = 0
  while i < 4 {
    let p = parts[i]
    if p.length() == 0 || p.length() > 3 {
      return false
    }
    let mut v = 0
    let mut j = 0
    while j < p.length() {
      let c = p.code_unit_at(j)
      if c < 48 || c > 57 {
        return false
      }
      v = v * 10 + (c - 48)
      j = j + 1
    }
    if v > 255 {
      return false
    }
    i = i + 1
  }
  true
}

/// Connects to `host:port` over TCP (full DNS + IPv4/IPv6 resolution) and
/// completes a TLS 1.2/1.3 handshake with SNI. With `verify_cert` the peer
/// chain must verify against the system CA store (or `SSL_CERT_FILE`) and match
/// `host`; without it any certificate is accepted.
pub fn tls_connect(
  w : World,
  host : String,
  port : Int,
  verify_cert : Bool,
) -> Result[TlsConn, String] {
  let _ = w
  let out_fd = ptr_alloc(8L)
  ptr_write_i32(out_fd, 0L, -1)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let vflag = if verify_cert { 1 } else { 0 }
  let h = c_tls_connect(host.as_cstr(), port, vflag, out_fd, err_buf, 512)
  let fd = ptr_read_i32(out_fd, 0L)
  ptr_free(out_fd)
  if ptr_is_null(h) {
    let msg = cstr_to_str(err_buf)
    ptr_free(err_buf)
    return Err(
      if msg.length() > 0 {
        msg
      } else {
        "TLS handshake with " + host + ":" + port.to_string() + " failed"
      },
    )
  }
  ptr_free(err_buf)
  Ok(TlsConn::{ handle: h, fd: fd, host: host })
}

/// Upgrades an already-connected TCP socket `fd` (for example after an HTTP
/// `CONNECT` or `SOCKS5` proxy handshake) to client-side TLS 1.2/1.3 with SNI
/// set to `host` and optional certificate/hostname verification.
///
/// Ownership contract:
/// - On `Ok(conn)`, `TlsConn` takes ownership of `fd` and closes it in
///   `tls_close(w, conn)`.
/// - On `Err(msg)`, `fd` is NOT closed; the caller retains ownership and is
///   responsible for closing it.
pub fn tls_wrap_fd(
  w : World,
  fd : Int,
  host : String,
  verify_cert : Bool,
) -> Result[TlsConn, String] {
  let _ = w
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let vflag = if verify_cert { 1 } else { 0 }
  let h = c_tls_wrap_fd(fd, host.as_cstr(), vflag, err_buf, 512)
  if ptr_is_null(h) {
    let msg = cstr_to_str(err_buf)
    ptr_free(err_buf)
    return Err(
      if msg.length() > 0 {
        msg
      } else {
        "TLS handshake with " + host + " failed"
      },
    )
  }
  ptr_free(err_buf)
  Ok(TlsConn::{ handle: h, fd: fd, host: host })
}

/// Negotiated protocol, e.g. `TLSv1.3` or `TLSv1.2`.
pub fn tls_protocol(conn : TlsConn) -> String {
  if ptr_is_null(conn.handle) {
    return ""
  }
  let buf = ptr_alloc(64L)
  ptr_write_i32(buf, 0L, 0)
  let n = c_tls_protocol(conn.handle, buf, 64)
  let s = if n > 0 { cstr_to_str(buf) } else { "" }
  ptr_free(buf)
  s
}

/// Negotiated cipher suite, e.g. `TLS_AES_256_GCM_SHA384`.
pub fn tls_cipher(conn : TlsConn) -> String {
  if ptr_is_null(conn.handle) {
    return ""
  }
  let buf = ptr_alloc(128L)
  ptr_write_i32(buf, 0L, 0)
  let n = c_tls_cipher(conn.handle, buf, 128)
  let s = if n > 0 { cstr_to_str(buf) } else { "" }
  ptr_free(buf)
  s
}

/// Sends every byte of `data`; returns the number of bytes written.
pub fn tls_write(w : World, conn : TlsConn, data : String) -> Result[Int, String] {
  let _ = w
  let n = data.length()
  if n == 0 {
    return Ok(0)
  }
  if ptr_is_null(conn.handle) {
    return Err("TLS write on closed connection")
  }
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let rc = c_tls_write(conn.handle, data.as_cstr(), n, err_buf, 512)
  if rc != n {
    let msg = cstr_to_str(err_buf)
    ptr_free(err_buf)
    return Err(if msg.length() > 0 { msg } else { "TLS write failed" })
  }
  ptr_free(err_buf)
  Ok(n)
}

/// Sends every byte of `data` (binary-safe); returns the number of bytes written.
pub fn tls_write_bytes(w : World, conn : TlsConn, data : Bytes) -> Result[Int, String] {
  let _ = w
  let n = data.length()
  if n == 0 {
    return Ok(0)
  }
  if ptr_is_null(conn.handle) {
    return Err("TLS write on closed connection")
  }
  let buf = ptr_alloc(n.to_int64())
  bytes_copy_to_ptr(data, 0, buf, n)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let rc = c_tls_write(conn.handle, buf, n, err_buf, 512)
  ptr_free(buf)
  if rc != n {
    let msg = cstr_to_str(err_buf)
    ptr_free(err_buf)
    return Err(if msg.length() > 0 { msg } else { "TLS write failed" })
  }
  ptr_free(err_buf)
  Ok(n)
}

/// Reads up to `max_bytes` decrypted bytes; returns an empty `Bytes` on EOF or error.
pub fn tls_read_bytes(w : World, conn : TlsConn, max_bytes : Int) -> Bytes {
  let _ = w
  if max_bytes <= 0 || ptr_is_null(conn.handle) {
    return Bytes::new(0)
  }
  let buf = ptr_alloc((max_bytes + 8).to_int64())
  let n = c_tls_read(conn.handle, buf, max_bytes)
  if n <= 0 {
    ptr_free(buf)
    return Bytes::new(0)
  }
  let out = bytes_from_ptr(buf, n)
  ptr_free(buf)
  out
}

/// Reads up to `max_bytes` decrypted bytes as a `String`; `""` at end of stream or on error.
pub fn tls_read(w : World, conn : TlsConn, max_bytes : Int) -> String {
  let b = tls_read_bytes(w, conn, max_bytes)
  if b.length() == 0 {
    ""
  } else {
    b.to_string()
  }
}

/// Closes the TLS session and underlying socket.
pub fn tls_close(w : World, conn : TlsConn) -> Unit {
  let _ = w
  if !ptr_is_null(conn.handle) {
    c_tls_close(conn.handle)
  }
}

/// Blocking HTTPS/1.1 call (`std/http` framing over `tls_connect`): send one
/// request with `Connection: close`, read one response (content-length,
/// chunked, or until the server closes), close.
pub fn https_request(
  w : World,
  host : String,
  port : Int,
  method : String,
  path : String,
  body : String,
  verify_cert : Bool,
) -> Result[http::HttpResponse, String] {
  let conn = tls_connect(w, host, port, verify_cert)?
  let req = http::format_request(method, host, port, path, body)
  match tls_write(w, conn, req) {
    Ok(_) => ()
    Err(e) => {
      tls_close(w, conn)
      return Err(e)
    }
  }
  let sb = StringBuilder()
  let mut buf = ""
  while true {
    let chunk = tls_read(w, conn, 65536)
    if chunk.length() == 0 {
      break
    }
    sb.write_string(chunk)
    buf = sb.to_string()
    if buf.length() > http::MAX_MESSAGE_BYTES {
      tls_close(w, conn)
      return Err("response too large")
    }
    if http::response_len(buf) >= 0 {
      break
    }
  }
  tls_close(w, conn)
  if buf.length() == 0 {
    return Err("connection closed before response")
  }
  let n = http::response_len(buf)
  http::parse_response(if n >= 0 { buf.slice(0, n) } else { buf })
}

/// Checks `tls_listen` arguments before anything is allocated.
fn check_listen_args(port : Int, cert_pem : String, key_pem : String) -> Result[Unit, String] {
  if port < 0 || port > 65535 {
    return Err("invalid port " + port.to_string() + " (want 0..65535)")
  }
  if cert_pem.length() == 0 {
    return Err("missing certificate chain file (PEM)")
  }
  if key_pem.length() == 0 {
    return Err("missing private key file (PEM)")
  }
  Ok(())
}

/// Listens on `host:port` (`""` = any address, port 0 = ephemeral) as a TLS
/// 1.2/1.3 server presenting the PEM certificate chain `cert_pem` with the PEM
/// private key `key_pem`.
pub fn tls_listen(
  w : World,
  host : String,
  port : Int,
  cert_pem : String,
  key_pem : String,
) -> Result[TlsListener, String] {
  let _ = w
  check_listen_args(port, cert_pem, key_pem)?
  let out_fd = ptr_alloc(8L)
  let out_port = ptr_alloc(8L)
  ptr_write_i32(out_fd, 0L, -1)
  ptr_write_i32(out_port, 0L, 0)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let lh = c_tls_listen(
    host.as_cstr(),
    port,
    cert_pem.as_cstr(),
    key_pem.as_cstr(),
    out_fd,
    out_port,
    err_buf,
    512,
  )
  let fd = ptr_read_i32(out_fd, 0L)
  let bound_port = ptr_read_i32(out_port, 0L)
  ptr_free(out_fd)
  ptr_free(out_port)
  if ptr_is_null(lh) {
    let msg = cstr_to_str(err_buf)
    ptr_free(err_buf)
    return Err(
      if msg.length() > 0 {
        msg
      } else {
        "listen on " + host + ":" + port.to_string() + " failed"
      },
    )
  }
  ptr_free(err_buf)
  Ok(TlsListener::{ handle: lh, fd: fd, port: bound_port })
}

/// Accepts the next TCP connection and completes its server-side TLS
/// handshake. A failed handshake (a client that rejected the certificate, a
/// non-TLS peer) closes that connection and returns `Err`; the listener stays
/// usable. Only a failing `accept` itself starts its message with `accept`.
pub fn tls_accept(w : World, listener : TlsListener) -> Result[TlsConn, String] {
  let _ = w
  if ptr_is_null(listener.handle) {
    return Err("accept on closed listener")
  }
  let out_fd = ptr_alloc(8L)
  ptr_write_i32(out_fd, 0L, -1)
  let sni_buf = ptr_alloc(256L)
  ptr_write_i32(sni_buf, 0L, 0)
  let err_buf = ptr_alloc(512L)
  ptr_write_i32(err_buf, 0L, 0)
  let h = c_tls_accept(listener.handle, out_fd, sni_buf, 256, err_buf, 512)
  let fd = ptr_read_i32(out_fd, 0L)
  ptr_free(out_fd)
  if ptr_is_null(h) {
    let msg = cstr_to_str(err_buf)
    ptr_free(sni_buf)
    ptr_free(err_buf)
    return Err(if msg.length() > 0 { msg } else { "TLS server handshake failed" })
  }
  let host = cstr_to_str(sni_buf)
  ptr_free(sni_buf)
  ptr_free(err_buf)
  Ok(TlsConn::{ handle: h, fd: fd, host: host })
}

/// Closes the TLS listener and releases its resources.
pub fn tls_listener_close(w : World, listener : TlsListener) -> Unit {
  let _ = w
  if !ptr_is_null(listener.handle) {
    c_tls_listener_close(listener.handle)
  }
}

/// Reads one HTTP/1.x request (head plus `content-length` or chunked body, at
/// most `http::MAX_MESSAGE_BYTES`) from a TLS connection and parses it.
pub fn tls_read_http_request(w : World, conn : TlsConn) -> Result[http::HttpRequest, String] {
  let sb = StringBuilder()
  let mut buf = ""
  while true {
    let chunk = tls_read(w, conn, 65536)
    if chunk.length() == 0 {
      break
    }
    sb.write_string(chunk)
    buf = sb.to_string()
    if buf.length() > http::MAX_MESSAGE_BYTES {
      return Err("request too large")
    }
    let n = http::request_len(buf)
    if n >= 0 {
      return http::parse_request(buf.slice(0, n))
    }
  }
  if buf.length() == 0 {
    return Err("connection closed before request")
  }
  http::parse_request(buf)
}

/// Writes one response with `Content-Length` and `Connection: close`; returns
/// the number of bytes written.
pub fn tls_write_http_response(
  w : World,
  conn : TlsConn,
  status : Int,
  content_type : String,
  body : String,
) -> Result[Int, String] {
  if status < 100 || status > 599 {
    return Err("invalid HTTP status " + status.to_string())
  }
  let resp = http::HttpResponse::{
    status: status,
    status_text: http::status_text_for(status),
    content_type: content_type,
    body: body,
  }
  tls_write(w, conn, http::format_response(resp))
}
