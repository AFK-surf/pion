///| std/tls end-to-end client: real TLS handshakes against the local HTTPS
///| server started by `run_e2e.sh` (self-signed `localhost` certificate trusted
///| through `SSL_CERT_FILE`).
///|
///|   tls_e2e <port> <expected protocol, e.g. TLSv1.3>
///|
///| Exactly four connections, in order:
///|   1. https_request POST /echo (verified, SNI `localhost`): 200, same JSON body
///|   2. tls_connect + tls_write/tls_read GET /info (verified): protocol, SNI
///|   3. tls_connect to `127.0.0.1` with verification: must fail (the
///|      certificate names only `localhost`)
///|   4. https_request GET /info to `127.0.0.1` without verification: 200

import "tls"
import "http"
import "json"

fn str_field(body : String, key : String) -> String {
  match json::parse(body) {
    Ok(v) =>
    match json::obj_get(v, key) {
      Some(x) =>
      match json::as_str(x) {
        Some(s) => s
        None => ""
      }
      None => ""
    }
    Err(_) => ""
  }
}

fn parse_port(s : String) -> Int {
  if s.length() == 0 || s.length() > 5 {
    return 0
  }
  let mut v = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c < 48 || c > 57 {
      return 0
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  v
}

fn run(world : World, port : Int, want_proto : String) -> Result[Unit, String] {
  io_println(world, "linked: " + tls::tls_version())

  // 1. POST JSON through https_request with full verification.
  let payload = "{\"msg\":\"hello over TLS\",\"n\":42,\"utf8\":\"值 🚀\"}"
  let r1 = tls::https_request(world, "localhost", port, "POST", "/echo", payload, true)?
  if r1.status != 200 || r1.body != payload || r1.content_type != "application/json" {
    return Err("echo mismatch: " + r1.status.to_string() + " " + r1.content_type + " " + r1.body)
  }
  io_println(world, "https_request POST /echo: 200, " + r1.body.length().to_string() + " bytes echoed exactly")

  // 2. Low-level API, reading the response in small pieces.
  let conn = tls::tls_connect(world, "localhost", port, true)?
  let proto = tls::tls_protocol(conn)
  let cipher = tls::tls_cipher(conn)
  let req = http::format_request("GET", "localhost", port, "/info", "")
  let wrote = tls::tls_write(world, conn, req)?
  let sb = StringBuilder()
  while true {
    let part = tls::tls_read(world, conn, 7)
    if part.length() == 0 {
      break
    }
    sb.write_string(part)
  }
  tls::tls_close(world, conn)
  let info = http::parse_response(sb.to_string())?
  let server_proto = str_field(info.body, "version")
  let sni = str_field(info.body, "sni")
  if proto != want_proto || server_proto != want_proto || sni != "localhost" || wrote != req.length() {
    return Err("info mismatch: client=" + proto + " server=" + server_proto + " sni=" + sni)
  }
  io_println(world, "tls_connect: " + proto + " " + cipher + ", server saw " + server_proto + " sni=" + sni)

  // 3. Verification must reject a host the certificate does not name.
  match tls::tls_connect(world, "127.0.0.1", port, true) {
    Ok(c) => {
      tls::tls_close(world, c)
      return Err("verification accepted 127.0.0.1 for a localhost-only certificate")
    }
    Err(e) => io_println(world, "verify rejects 127.0.0.1: " + e)
  }

  // 4. Without verification the same address works (no SNI for IP literals).
  let r4 = tls::https_request(world, "127.0.0.1", port, "GET", "/info", "", false)?
  if r4.status != 200 || str_field(r4.body, "version") != want_proto || str_field(r4.body, "sni") != "" {
    return Err("unverified request mismatch: " + r4.body)
  }
  io_println(world, "https_request 127.0.0.1 (verify off): 200 " + r4.body)
  Ok(())
}

pub fn main(world : World) -> Int {
  let args = world_args(world)
  if args.length() != 3 {
    io_eprintln(world, "usage: tls_e2e <port> <expected protocol>")
    return 2
  }
  let port = parse_port(args[1])
  match run(world, port, args[2]) {
    Ok(_) => {
      io_println(world, "tls e2e ok")
      0
    }
    Err(e) => {
      io_eprintln(world, "tls e2e FAILED: " + e)
      1
    }
  }
}
