///| std/http: HTTP/1.1 request/response parsing, formatting and a blocking client/server over POSIX TCP (pure Pion)

import "json"

pub struct HttpRequest {
  pub method : String
  pub path : String
  pub query : String
  pub headers : Map[String, String]
  pub body : String
}

pub struct HttpResponse {
  pub status : Int
  pub status_text : String
  pub content_type : String
  pub body : String
}

/// Largest request or response accepted by the TCP helpers (8 MiB).
pub let MAX_MESSAGE_BYTES : Int = 8388608

/// ASCII-lowercases `s` (header names are case-insensitive).
pub fn ascii_lower(s : String) -> String {
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      let sb = StringBuilder()
      if i > 0 {
        sb.write_string(s.slice(0, i))
      }
      sb.write_char((c + 32).unsafe_to_char())
      let mut run_start = i + 1
      i = i + 1
      while i < n {
        let c2 = s.code_unit_at(i)
        if c2 >= 65 && c2 <= 90 {
          if i > run_start {
            sb.write_string(s.slice(run_start, i))
          }
          sb.write_char((c2 + 32).unsafe_to_char())
          run_start = i + 1
        }
        i = i + 1
      }
      if n > run_start {
        sb.write_string(s.slice(run_start, n))
      }
      return sb.to_string()
    }
    i = i + 1
  }
  s
}

/// Reason phrase of the common status codes.
pub fn status_text_for(status : Int) -> String {
  if status == 200 {
    "OK"
  } else if status == 201 {
    "Created"
  } else if status == 204 {
    "No Content"
  } else if status == 400 {
    "Bad Request"
  } else if status == 404 {
    "Not Found"
  } else if status == 405 {
    "Method Not Allowed"
  } else if status == 413 {
    "Payload Too Large"
  } else if status == 500 {
    "Internal Server Error"
  } else if status == 503 {
    "Service Unavailable"
  } else {
    "Unknown"
  }
}

/// Offset of the blank line ending the head (`\r\n\r\n` or `\n\n`) and its length.
fn head_end(raw : String) -> (Int, Int) {
  let crlf = raw.index_of("\r\n\r\n")
  let lf = raw.index_of("\n\n")
  if crlf >= 0 && (lf < 0 || crlf <= lf) {
    (crlf, 4)
  } else if lf >= 0 {
    (lf, 2)
  } else {
    (-1, 0)
  }
}

fn split_head_lines(head : String) -> Array[String] {
  let lines = head.split("\n")
  let out : Array[String] = []
  let mut i = 0
  while i < lines.length() {
    let ln = lines[i]
    if ln.length() > 0 && ln.code_unit_at(ln.length() - 1) == 13 {
      out.push(ln.slice(0, ln.length() - 1))
    } else {
      out.push(ln)
    }
    i = i + 1
  }
  out
}

/// Parses `Name: value` lines (from index 1) into lowercase-keyed headers.
fn parse_header_lines(lines : Array[String]) -> Result[Map[String, String], String] {
  let headers : Map[String, String] = Map::new()
  let mut i = 1
  while i < lines.length() {
    let ln = lines[i]
    if ln.length() > 0 {
      let colon = ln.index_of(":")
      if colon <= 0 {
        return Err("malformed header line " + i.to_string() + ": `" + ln + "`")
      }
      let name = ascii_lower(ln.slice(0, colon).trim())
      let value = ln.slice(colon + 1, ln.length()).trim()
      headers.set(name, value)
    }
    i = i + 1
  }
  Ok(headers)
}

fn parse_decimal(s : String) -> Option[Int] {
  let t = s.trim()
  if t.length() == 0 || t.length() > 9 {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + (c - 48)
    i = i + 1
  }
  Some(v)
}

fn hex_value(s : String) -> Option[Int] {
  let t = s.trim()
  if t.length() == 0 || t.length() > 7 {
    return None
  }
  let mut v = 0
  let mut i = 0
  while i < t.length() {
    let h = hex_nibble(t.code_unit_at(i))
    if h < 0 {
      return None
    }
    v = v * 16 + h
    i = i + 1
  }
  Some(v)
}

/// The line of `s` starting at `from` (without `\r\n`/`\n`) and the offset
/// after it, or `None` while the line is incomplete.
fn line_at(s : String, from : Int) -> Option[(String, Int)] {
  let n = s.length()
  let mut end = from
  while end < n {
    if s.code_unit_at(end) == 10 {
      let cut = if end > from && s.code_unit_at(end - 1) == 13 { end - 1 } else { end }
      return Some((s.slice(from, cut), end + 1))
    }
    end = end + 1
  }
  None
}

/// Decodes a `Transfer-Encoding: chunked` body at the start of `rest`: the body
/// and the bytes consumed (through the trailer section). Incomplete input is
/// `Err("incomplete chunked body")`.
pub fn decode_chunked(rest : String) -> Result[(String, Int), String] {
  let sb = StringBuilder()
  let mut pos = 0
  let mut total = 0
  while true {
    let (line, next) = match line_at(rest, pos) {
      Some(l) => l
      None => return Err("incomplete chunked body")
    }
    let semi = line.index_of(";")
    let size_s = if semi >= 0 { line.slice(0, semi) } else { line }
    let size = match hex_value(size_s) {
      Some(n) => n
      None => return Err("invalid chunk size `" + line + "`")
    }
    pos = next
    if size == 0 {
      while true {
        match line_at(rest, pos) {
          Some(tl) => {
            pos = tl.1
            if tl.0.length() == 0 {
              break
            }
          }
          None => return Err("incomplete chunked body")
        }
      }
      return Ok((sb.to_string(), pos))
    }
    total = total + size
    if total > MAX_MESSAGE_BYTES {
      return Err("chunked body too large")
    }
    if pos + size > rest.length() {
      return Err("incomplete chunked body")
    }
    sb.write_string(rest.slice(pos, pos + size))
    pos = pos + size
    if pos < rest.length() && rest.code_unit_at(pos) == 13 {
      pos = pos + 1
    }
    if pos >= rest.length() {
      return Err("incomplete chunked body")
    }
    if rest.code_unit_at(pos) != 10 {
      return Err("missing CRLF after chunk data")
    }
    pos = pos + 1
  }
  Err("incomplete chunked body")
}

fn is_chunked(headers : Map[String, String]) -> Bool {
  match headers.get("transfer-encoding") {
    Some(te) => ascii_lower(te).contains("chunked")
    None => false
  }
}

/// Body bytes after the head: de-chunked for `transfer-encoding: chunked`, cut
/// to `content-length` when present, else the rest.
fn take_body(rest : String, headers : Map[String, String]) -> Result[String, String] {
  if is_chunked(headers) {
    let (body, _) = decode_chunked(rest)?
    return Ok(body)
  }
  match headers.get("content-length") {
    Some(cl) =>
    match parse_decimal(cl) {
      Some(n) =>
      if rest.length() < n {
        Err(
          "incomplete body: expected " +
          n.to_string() +
          " bytes, got " +
          rest.length().to_string(),
        )
      } else {
        Ok(rest.slice(0, n))
      }
      None => Err("invalid content-length `" + cl + "`")
    }
    None => Ok(rest)
  }
}

/// Parses a complete HTTP/1.x request (head and body).
pub fn parse_request(raw : String) -> Result[HttpRequest, String] {
  let (he, sep) = head_end(raw)
  if he < 0 {
    return Err("incomplete request head")
  }
  let lines = split_head_lines(raw.slice(0, he))
  let parts = lines[0].split(" ")
  if parts.length() != 3 || parts[0].length() == 0 || parts[1].length() == 0 {
    return Err("malformed request line `" + lines[0] + "`")
  }
  if !parts[2].starts_with("HTTP/1.") {
    return Err("unsupported protocol `" + parts[2] + "`")
  }
  let target = parts[1]
  let q = target.index_of("?")
  let path = if q >= 0 { target.slice(0, q) } else { target }
  let query = if q >= 0 { target.slice(q + 1, target.length()) } else { "" }
  let headers = parse_header_lines(lines)?
  if parts[2] == "HTTP/1.0" && !headers.contains("connection") {
    // HTTP/1.0 closes after each response unless the client asks otherwise.
    headers.set("connection", "close")
  }
  let body = take_body(raw.slice(he + sep, raw.length()), headers)?
  Ok(HttpRequest::{
    method: parts[0],
    path: path,
    query: query,
    headers: headers,
    body: body,
  })
}

/// Parses a complete HTTP/1.x response (head and body).
pub fn parse_response(raw : String) -> Result[HttpResponse, String] {
  let (he, sep) = head_end(raw)
  if he < 0 {
    return Err("incomplete response head")
  }
  let lines = split_head_lines(raw.slice(0, he))
  let status_line = lines[0]
  if !status_line.starts_with("HTTP/1.") {
    return Err("malformed status line `" + status_line + "`")
  }
  let sp1 = status_line.index_of(" ")
  if sp1 < 0 {
    return Err("malformed status line `" + status_line + "`")
  }
  let after = status_line.slice(sp1 + 1, status_line.length())
  let sp2 = after.index_of(" ")
  let code_s = if sp2 >= 0 { after.slice(0, sp2) } else { after }
  let text = if sp2 >= 0 { after.slice(sp2 + 1, after.length()) } else { "" }
  let status = match parse_decimal(code_s) {
    Some(n) =>
    if code_s.length() == 3 {
      n
    } else {
      return Err("invalid status code `" + code_s + "`")
    }
    None => return Err("invalid status code `" + code_s + "`")
  }
  let headers = parse_header_lines(lines)?
  let body = take_body(raw.slice(he + sep, raw.length()), headers)?
  let ctype = match headers.get("content-type") {
    Some(ct) => ct
    None => ""
  }
  Ok(HttpResponse::{
    status: status,
    status_text: text,
    content_type: ctype,
    body: body,
  })
}

/// Serializes a response with `Content-Length` and `Connection: close`.
pub fn format_response(resp : HttpResponse) -> String {
  format_response_ka(resp, false)
}

/// Serializes a response with `Content-Length` and `Connection: keep-alive`
/// (the connection stays open for the next request) or `Connection: close`.
pub fn format_response_ka(resp : HttpResponse, keep_alive : Bool) -> String {
  let sb = StringBuilder()
  sb.write_string("HTTP/1.1 ")
  sb.write_string(resp.status.to_string())
  sb.write_string(" ")
  sb.write_string(resp.status_text)
  sb.write_string("\r\n")
  if resp.content_type.length() > 0 {
    sb.write_string("Content-Type: ")
    sb.write_string(resp.content_type)
    sb.write_string("\r\n")
  }
  sb.write_string("Content-Length: ")
  sb.write_string(resp.body.length().to_string())
  if keep_alive {
    sb.write_string("\r\nConnection: keep-alive\r\n\r\n")
  } else {
    sb.write_string("\r\nConnection: close\r\n\r\n")
  }
  sb.write_string(resp.body)
  sb.to_string()
}

/// Serializes a request with `Host`, `Content-Length` and `Connection: close`.
pub fn format_request(
  method : String,
  host : String,
  port : Int,
  path : String,
  body : String,
) -> String {
  method +
  " " +
  path +
  " HTTP/1.1\r\nHost: " +
  host +
  ":" +
  port.to_string() +
  "\r\nContent-Length: " +
  body.length().to_string() +
  "\r\nConnection: close\r\n\r\n" +
  body
}

/// `200 OK` with an `application/json` body.
pub fn ok_json(body : String) -> HttpResponse {
  HttpResponse::{
    status: 200,
    status_text: "OK",
    content_type: "application/json",
    body: body,
  }
}

/// Error status with body `{"error":"<msg>"}`.
pub fn err_json(status : Int, msg : String) -> HttpResponse {
  let body = json::stringify(json::JObj([json::field("error", json::JStr(msg))]))
  HttpResponse::{
    status: status,
    status_text: status_text_for(status),
    content_type: "application/json",
    body: body,
  }
}

fn hex_nibble(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    -1
  }
}

/// Percent-decodes `s` (`+` becomes a space); malformed escapes are kept as is.
pub fn url_decode(s : String) -> String {
  let n = s.length()
  let mut has_encoded = false
  let mut scan = 0
  while scan < n {
    let c = s.code_unit_at(scan)
    if c == 43 || c == 37 {
      has_encoded = true
      break
    }
    scan = scan + 1
  }
  if !has_encoded {
    return s
  }
  let bytes = s.to_bytes()
  let out = Bytes::new(n)
  let mut o = 0
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 43 {
      out[o] = b' '
      i = i + 1
    } else if c == 37 && i + 2 < n && hex_nibble(s.code_unit_at(i + 1)) >= 0 &&
    hex_nibble(s.code_unit_at(i + 2)) >= 0 {
      let v = hex_nibble(s.code_unit_at(i + 1)) * 16 + hex_nibble(s.code_unit_at(i + 2))
      out[o] = v.to_byte()
      i = i + 3
    } else {
      out[o] = bytes[i]
      i = i + 1
    }
    o = o + 1
  }
  out.slice(0, o).to_string()
}

/// Splits `a=1&b=x%20y` into decoded pairs; later duplicates win.
pub fn query_params(query : String) -> Map[String, String] {
  let out : Map[String, String] = Map::new()
  if query.length() == 0 {
    return out
  }
  let pairs = query.split("&")
  let mut i = 0
  while i < pairs.length() {
    let pr = pairs[i]
    if pr.length() > 0 {
      let eq = pr.index_of("=")
      if eq >= 0 {
        out.set(url_decode(pr.slice(0, eq)), url_decode(pr.slice(eq + 1, pr.length())))
      } else {
        out.set(url_decode(pr), "")
      }
    }
    i = i + 1
  }
  out
}

/// Parses a URL query string (`a=1&b=x+y%2Fz`): `+` and `%XX` are decoded
/// (`url_decode`), a bare key maps to `""`, later duplicates win.
pub fn parse_query(query : String) -> Map[String, String] {
  query_params(query)
}

/// Header value by case-insensitive name.
pub fn header(req : HttpRequest, name : String) -> Option[String] {
  req.headers.get(ascii_lower(name))
}

/// True when the connection may carry another request after answering `req`:
/// HTTP/1.1 keeps it unless `Connection: close`; HTTP/1.0 closes unless the
/// client sent `Connection: keep-alive`.
pub fn should_keep_alive(req : HttpRequest) -> Bool {
  match req.headers.get("connection") {
    Some(v) => !ascii_lower(v).contains("close")
    None => true
  }
}

/// Leading empty lines a client may send between pipelined messages.
fn skip_blank_lines(buf : String) -> Int {
  let mut i = 0
  while i < buf.length() {
    let c = buf.code_unit_at(i)
    if c != 13 && c != 10 {
      break
    }
    i = i + 1
  }
  i
}

/// Byte length of the first complete message in `buf` (head, then a chunked,
/// `content-length` or — for requests — empty body), or -1 while incomplete.
/// Responses without either framing run to the end of the connection (-1). A
/// malformed head counts as the whole buffer so parsing reports the error.
fn message_len(buf : String, is_request : Bool) -> Int {
  let (he, sep) = head_end(buf)
  if he < 0 {
    return -1
  }
  let body_at = he + sep
  let lines = split_head_lines(buf.slice(0, he))
  let headers = match parse_header_lines(lines) {
    Ok(h) => h
    Err(_) => return buf.length()
  }
  if !is_request {
    let st = lines[0]
    if st.starts_with("HTTP/1.1 1") || st.starts_with("HTTP/1.0 1") ||
    st.starts_with("HTTP/1.1 204") || st.starts_with("HTTP/1.1 304") {
      return body_at
    }
  }
  if is_chunked(headers) {
    return match decode_chunked(buf.slice(body_at, buf.length())) {
      Ok(r) => body_at + r.1
      Err(e) => if e == "incomplete chunked body" { -1 } else { buf.length() }
    }
  }
  match headers.get("content-length") {
    Some(cl) =>
    match parse_decimal(cl) {
      Some(n) => if buf.length() - body_at >= n { body_at + n } else { -1 }
      None => buf.length()
    }
    None => if is_request { body_at } else { -1 }
  }
}

/// Length of the first complete request in `buf` (after leading blank lines),
/// or -1 while more bytes are needed; bytes past it belong to the next request.
pub fn request_len(buf : String) -> Int {
  let skip = skip_blank_lines(buf)
  let n = message_len(buf.slice(skip, buf.length()), true)
  if n < 0 {
    -1
  } else {
    skip + n
  }
}

/// Length of the first complete response in `buf`, or -1 while more bytes are
/// needed (or, without `content-length`/chunking, until the peer closes).
pub fn response_len(buf : String) -> Int {
  message_len(buf, false)
}

/// Reads one request from `fd` (head plus `content-length` or chunked body) and parses it.
pub fn read_http_request(w : World, fd : Int) -> Result[HttpRequest, String] {
  let sb = StringBuilder()
  let mut buf = ""
  while true {
    let chunk = tcp_read(w, fd, 65536)
    if chunk.length() == 0 {
      break
    }
    sb.write_string(chunk)
    buf = sb.to_string()
    if buf.length() > MAX_MESSAGE_BYTES {
      return Err("request too large")
    }
    if request_len(buf) >= 0 {
      break
    }
  }
  if buf.length() == 0 {
    return Err("connection closed before request")
  }
  parse_request(buf)
}

/// Reads one response from `fd`: up to its `content-length` or last chunk, or
/// until the server closes when neither is given.
pub fn read_http_response(w : World, fd : Int) -> Result[HttpResponse, String] {
  let sb = StringBuilder()
  let mut buf = ""
  while true {
    let chunk = tcp_read(w, fd, 65536)
    if chunk.length() == 0 {
      break
    }
    sb.write_string(chunk)
    buf = sb.to_string()
    if buf.length() > MAX_MESSAGE_BYTES {
      return Err("response too large")
    }
    if response_len(buf) >= 0 {
      break
    }
  }
  if buf.length() == 0 {
    return Err("connection closed before response")
  }
  let n = response_len(buf)
  parse_response(if n >= 0 { buf.slice(0, n) } else { buf })
}

/// Writes `resp` to `fd` with `Connection: close`; true when every byte was sent.
pub fn write_http_response(w : World, fd : Int, resp : HttpResponse) -> Bool {
  write_http_response_ka(w, fd, resp, false)
}

/// Writes `resp` to `fd` announcing `Connection: keep-alive` or `close`; true
/// when every byte was sent.
pub fn write_http_response_ka(w : World, fd : Int, resp : HttpResponse, keep_alive : Bool) -> Bool {
  let text = format_response_ka(resp, keep_alive)
  tcp_write(w, fd, text) == text.length()
}

/// A buffered HTTP/1.1 connection: reads message after message from one socket,
/// keeping bytes past the current message (pipelined requests, coalesced TCP
/// segments) for the next read.
pub struct HttpConn {
  pub fd : Int
  mut buf : String
}

/// Wraps an accepted or connected socket.
pub fn new_conn(fd : Int) -> HttpConn {
  HttpConn::{ fd: fd, buf: "" }
}

/// Bytes received but not yet consumed by a read.
pub fn conn_buffered(conn : HttpConn) -> Int {
  conn.buf.length()
}

/// Next request on the connection: `Ok(None)` when the peer closed cleanly
/// between requests, `Err` for a malformed, oversized or truncated request.
pub fn conn_read_request(w : World, conn : HttpConn) -> Result[Option[HttpRequest], String] {
  while true {
    let n = request_len(conn.buf)
    if n >= 0 {
      let raw = conn.buf.slice(skip_blank_lines(conn.buf), n)
      conn.buf = conn.buf.slice(n, conn.buf.length())
      let req = parse_request(raw)?
      return Ok(Some(req))
    }
    if conn.buf.length() > MAX_MESSAGE_BYTES {
      return Err("request too large")
    }
    let chunk = tcp_read(w, conn.fd, 65536)
    if chunk.length() == 0 {
      if skip_blank_lines(conn.buf) == conn.buf.length() {
        conn.buf = ""
        return Ok(None)
      }
      return Err("connection closed mid-request")
    }
    conn.buf = conn.buf + chunk
  }
  Ok(None)
}

/// Next response on the connection (a response without `content-length` or
/// chunking runs until the server closes).
pub fn conn_read_response(w : World, conn : HttpConn) -> Result[HttpResponse, String] {
  while true {
    let n = response_len(conn.buf)
    if n >= 0 {
      let raw = conn.buf.slice(0, n)
      conn.buf = conn.buf.slice(n, conn.buf.length())
      return parse_response(raw)
    }
    if conn.buf.length() > MAX_MESSAGE_BYTES {
      return Err("response too large")
    }
    let chunk = tcp_read(w, conn.fd, 65536)
    if chunk.length() == 0 {
      if conn.buf.length() == 0 {
        return Err("connection closed before response")
      }
      let raw = conn.buf
      conn.buf = ""
      return parse_response(raw)
    }
    conn.buf = conn.buf + chunk
  }
  Err("unreachable")
}

/// Serializes a request with `Host`, `Content-Length` and `Connection: keep-alive`
/// (or `close`), for clients that reuse one connection.
pub fn format_request_ka(
  method : String,
  host : String,
  port : Int,
  path : String,
  body : String,
  keep_alive : Bool,
) -> String {
  let conn = if keep_alive { "keep-alive" } else { "close" }
  method +
  " " +
  path +
  " HTTP/1.1\r\nHost: " +
  host +
  ":" +
  port.to_string() +
  "\r\nContent-Length: " +
  body.length().to_string() +
  "\r\nConnection: " +
  conn +
  "\r\n\r\n" +
  body
}

/// Blocking HTTP/1.1 client call: connect, send, read one response, close.
pub fn http_request(
  w : World,
  host : String,
  port : Int,
  method : String,
  path : String,
  body : String,
) -> Result[HttpResponse, String] {
  let fd = tcp_connect(w, host, port)
  if fd < 0 {
    return Err("connect to " + host + ":" + port.to_string() + " failed")
  }
  let req = format_request(method, host, port, path, body)
  if tcp_write(w, fd, req) != req.length() {
    tcp_close(w, fd)
    return Err("failed to send request")
  }
  let resp = read_http_response(w, fd)
  tcp_close(w, fd)
  resp
}
