///| Cross-package `mutation_summary` ABI propagation, struct field type injection,
///| and soundness invariant tests (S1-S7).

fn mk_test_dep_abi(
  pkg_name : String,
  structs : Option[Array[AbiStructSchema]],
  fms : Array[AbiFnMutationSummary],
) -> PackageAbi {
  PackageAbi::{
    package_name: pkg_name,
    enums: [],
    struct_val_fields: [],
    structs: structs,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: fms,
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
}

fn find_iter_dot(tokens : Array[Token]) -> Int {
  let mut i = 1
  while i + 2 < tokens.length() {
    if tokens[i].kind == TokenKind::Dot && tokens[i + 1].raw == "iter" && tokens[i + 2].kind == TokenKind::LParen {
      return i
    }
    i = i + 1
  }
  -1
}

fn find_search_by_cb(tokens : Array[Token]) -> (Int, Int, Int) {
  let mut i = 1
  while i + 2 < tokens.length() {
    if tokens[i].kind == TokenKind::Dot && tokens[i + 1].raw == "search_by" && tokens[i + 2].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, i + 2)
      let bo = outermost_body_open(tokens, i)
      return (i + 3, rp, bo)
    }
    i = i + 1
  }
  (-1, -1, -1)
}

test "cross_pkg_abi_fn_mutation_summary_roundtrip_and_compat" {
  let abi = mk_test_dep_abi(
    "dep",
    None,
    [
      AbiFnMutationSummary::{
        name: "zeta",
        mutates_any_array: false,
        reaches_shrink: false,
        unknown: false,
        mutated_elem_types: ["dep::Row", "Int", "Int"],
      },
      AbiFnMutationSummary::{
        name: "alpha",
        mutates_any_array: false,
        reaches_shrink: false,
        unknown: false,
        mutated_elem_types: [],
      },
    ],
  )
  let sha = compute_abi_payload_sha256(abi)
  let pion_src = "// abi-sha256: " + sha + "\npub fn alpha() -> Int { 1 }\n"
  let abi_json = render_abi_json(abi, [("lib.pion", pion_src)])
  // Deterministic ordering: `alpha` before `zeta`, `Int` before `dep::Row`, deduplicated.
  let idx_alpha = abi_json.index_of("\"name\":\"alpha\"")
  let idx_zeta = abi_json.index_of("\"name\":\"zeta\"")
  assert_true(idx_alpha > 0 && idx_zeta > idx_alpha, "line 78")
  assert_true(str_has(abi_json, "\"mutated_elem_types\":[\"Int\",\"dep::Row\"]"), "line 79")

  // Bidirectional verification succeeds.
  let diags : Array[Diag] = []
  let parsed_opt = verify_and_parse_dep_abi("dep", "/tmp/dep", [("lib.pion", pion_src)], Some(abi_json), diags)
  assert_true(diags.length() == 0, "line 84")
  match parsed_opt {
    Some(p) => {
      assert_true(p.fn_mutation_summaries.length() == 2, "line 87")
      assert_true(p.fn_mutation_summaries[0].name == "alpha", "line 88")
      assert_true(p.fn_mutation_summaries[0].unknown == false, "line 89")
      assert_true(p.fn_mutation_summaries[1].name == "zeta", "line 90")
      assert_true(p.fn_mutation_summaries[1].mutated_elem_types.length() == 2, "line 91")
    }
    None => assert_true(false, "expected parsed PackageAbi")
  }

  // Tampering with `fn_mutation_summaries` fails bidirectional SHA-256 check.
  let tampered = str_replace_all(abi_json, "\"unknown\":false", "\"unknown\":true")
  let t_diags : Array[Diag] = []
  let t_opt = verify_and_parse_dep_abi("dep", "/tmp/dep", [("lib.pion", pion_src)], Some(tampered), t_diags)
  let t_is_none = match t_opt {
    None => true
    Some(_) => false
  }
  assert_true(t_is_none, "tampered fn_mutation_summaries must fail")
  assert_true(t_diags.length() > 0 && t_diags[0].code == "MBT2PION_DEP_ABI_ERROR", "line 101")

  // Backward compatibility: legacy ABI JSON without `fn_mutation_summaries` parses cleanly.
  let legacy_abi = empty_package_abi("legacy")
  let legacy_sha = compute_abi_payload_sha256(legacy_abi)
  let legacy_pion = "// abi-sha256: " + legacy_sha + "\npub fn f() -> Int { 0 }\n"
  let legacy_json = render_abi_json(legacy_abi, [("lib.pion", legacy_pion)])
  assert_true(!str_has(legacy_json, "fn_mutation_summaries"), "line 108")
  let l_diags : Array[Diag] = []
  let l_opt = verify_and_parse_dep_abi("legacy", "/tmp/legacy", [("lib.pion", legacy_pion)], Some(legacy_json), l_diags)
  assert_true(l_diags.length() == 0, "line 111")
  match l_opt {
    Some(lp) => assert_true(lp.fn_mutation_summaries.length() == 0, "legacy ABI must default fn_mutation_summaries to empty")
    None => assert_true(false, "expected parsed legacy PackageAbi")
  }

  // Exporting qualifies local struct names in `mutated_elem_types`.
  let dep_gen = [
    GeneratedFile::{
      rel_path: "lib.pion",
      content: "pub struct Item { id : Int }\npub fn touch_item(xs : Array[Item], v : Item) -> Unit { xs.push(v) }\npub fn pure_read(x : Int) -> Int { x + 1 }\n",
      source_file: "lib.mbt",
      anchors: [],
    },
  ]
  let st = empty_symbol_table()
  st.local_types["Item"] = true
  let exported = collect_exported_abi_fn_mutation_summaries(
    dep_gen,
    "dep",
    st,
    Map(),
    CrossPkgMutationContext::empty(),
    empty_pkg_query_types(),
  )
  assert_true(exported.length() == 2, "line 136")
  assert_true(exported[0].name == "pure_read", "line 137")
  assert_true(!exported[0].unknown && !exported[0].mutates_any_array && exported[0].mutated_elem_types.length() == 0, "line 138")
  assert_true(exported[1].name == "touch_item", "line 139")
  assert_true(!exported[1].unknown && !exported[1].mutates_any_array, "line 140")
  assert_true(exported[1].mutated_elem_types.length() == 1 && exported[1].mutated_elem_types[0] == "dep::Item", "line 141")
}

test "cross_pkg_s1_missing_summary_fail_closed" {
  let dep_abi = mk_test_dep_abi("dep", None, [])
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("dep", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let src = "fn find_it(rows : Array[Int], target : Int) -> Option[Int] {\n  rows.iter().find_first(fn(r) { dep::text(r) == target })\n}\nfn search_it(rows : Array[Int], target : Int) -> Option[Int] {\n  rows.search_by(fn(r) { @dep.text(r) == target })\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_with_cross_pkg([toks], ["a.pion"], [src], empty_pkg_query_types(), Map(), Map(), ctx)
  let dot_i = find_iter_dot(toks)
  assert_true(dot_i > 0, "line 156")
  assert_true(immediate_iter_consumer_allow_with_summary(toks, dot_i, ms, src, None, "Int") == None, "line 157")
  let (sb_s, sb_e, sb_bo) = find_search_by_cb(toks)
  let sb_sum = summarize_callback_arg(ms, toks, sb_s, sb_e, sb_bo, src, None, "Int", Map())
  assert_true(sb_sum.unknown, "line 160")
}

test "cross_pkg_s2_dep_unknown_propagates_fail_closed" {
  let dep_gen = [
    GeneratedFile::{
      rel_path: "lib.pion",
      content: "pub fn run_cb(x : Int, f : (Int) -> Bool) -> Bool { f(x) }\npub struct Box { v : Int }\npub fn Box::check(self : Box, f : (Int) -> Bool) -> Bool { f(self.v) }\n",
      source_file: "lib.mbt",
      anchors: [],
    },
  ]
  let st = empty_symbol_table()
  st.local_types["Box"] = true
  let exported = collect_exported_abi_fn_mutation_summaries(
    dep_gen,
    "dep",
    st,
    Map(),
    CrossPkgMutationContext::empty(),
    empty_pkg_query_types(),
  )
  let dep_abi = mk_test_dep_abi("dep", None, exported)
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("dep", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let src = "fn p(x : Int) -> Bool { x > 0 }\nfn use_iter(rows : Array[Int]) -> Option[Int] {\n  rows.iter().find_first(fn(r) { dep::run_cb(r, p) })\n}\nfn use_search(rows : Array[dep::Box]) -> Option[Int] {\n  rows.search_by(fn(b) { b.check(p) })\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_with_cross_pkg([toks], ["a.pion"], [src], empty_pkg_query_types(), Map(), Map(), ctx)
  let dot_i = find_iter_dot(toks)
  assert_true(immediate_iter_consumer_allow_with_summary(toks, dot_i, ms, src, None, "Int") == None, "line 193")
  let (sb_s, sb_e, sb_bo) = find_search_by_cb(toks)
  let sb_sum = summarize_callback_arg(ms, toks, sb_s, sb_e, sb_bo, src, None, "dep::Box", Map())
  assert_true(sb_sum.unknown, "line 196")
}

test "cross_pkg_s3_dep_mutates_elem_type_fail_closed" {
  let dep_gen = [
    GeneratedFile::{
      rel_path: "lib.pion",
      content: "pub struct Item { id : Int }\npub fn push_int(xs : Array[Int], v : Int) -> Bool { xs.push(v); true }\npub fn push_item(xs : Array[Item], v : Item) -> Bool { xs.push(v); true }\n",
      source_file: "lib.mbt",
      anchors: [],
    },
  ]
  let st = empty_symbol_table()
  st.local_types["Item"] = true
  let exported = collect_exported_abi_fn_mutation_summaries(
    dep_gen,
    "dep",
    st,
    Map(),
    CrossPkgMutationContext::empty(),
    empty_pkg_query_types(),
  )
  let dep_abi = mk_test_dep_abi("dep", None, exported)
  // Load under both canonical `dep` and alias `d`.
  let ctx = CrossPkgMutationContext::{
    dep_abis: [("d", dep_abi)],
    using_values: Map(),
    using_types: Map(),
    pkg_aliases: Map(),
  }
  let src_int = "fn f(rows : Array[Int], other : Array[Int]) -> Option[Int] {\n  rows.iter().find_first(fn(r) { d::push_int(other, r) })\n}\n"
  let toks_int = lex_moonbit(src_int)
  let ms_int = collect_pkg_mutation_summary_with_cross_pkg([toks_int], ["a.pion"], [src_int], empty_pkg_query_types(), Map(), Map(), ctx)
  // Same element type `Int` MUST fail closed.
  assert_true(immediate_iter_consumer_allow_with_summary(toks_int, find_iter_dot(toks_int), ms_int, src_int, None, "Int") == None, "line 230")
  // Disjoint element type `String` is allowed.
  let src_str = "fn g(rows : Array[String], other : Array[Int]) -> Option[String] {\n  rows.iter().find_first(fn(r) { d::push_int(other, r.length()) })\n}\n"
  let toks_str = lex_moonbit(src_str)
  let ms_str = collect_pkg_mutation_summary_with_cross_pkg([toks_str], ["a.pion"], [src_str], empty_pkg_query_types(), Map(), Map(), ctx)
  assert_true(immediate_iter_consumer_allow_with_summary(toks_str, find_iter_dot(toks_str), ms_str, src_str, None, "String") != None, "line 235")

  // Aliased cross-package struct `d::Item` MUST fail closed when dep mutates `dep::Item`.
  let src_item = "fn h(rows : Array[d::Item], other : Array[d::Item]) -> Option[d::Item] {\n  rows.iter().find_first(fn(r) { d::push_item(other, r) })\n}\n"
  let toks_item = lex_moonbit(src_item)
  let ms_item = collect_pkg_mutation_summary_with_cross_pkg([toks_item], ["a.pion"], [src_item], empty_pkg_query_types(), Map(), Map(), ctx)
  assert_true(immediate_iter_consumer_allow_with_summary(toks_item, find_iter_dot(toks_item), ms_item, src_item, None, "d::Item") == None, "line 241")
}

