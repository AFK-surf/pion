///| Stage A.5: Type-Probe Pass for silent-compile drift sites.
///|
///| Instruments syntactically ambiguous silent-drift sites on a scratch copy
///| (supporting both simple identifiers and complex/chained receivers like
///| `self.text.length()`, `f().length()`, `arr[i].length()`, `(a + b) / n`, `self.r.val`):
///| - `<recv>.length()` -> `<recv>.mbt_len_probe()`
///| - `<recv>[i]` -> `<recv>.mbt_idx_probe(i)`
///| - `<lhs> / <rhs>` (when `<rhs>` not statically proven non-zero) -> `<lhs>.mbt_div_probe(<rhs>)`
///| - `<lhs> % <rhs>` (when `<rhs>` not statically proven non-zero) -> `<lhs>.mbt_mod_probe(<rhs>)`
///| - `<recv>.to_string()` & `"...\{x}..."` -> `<recv>.mbt_show_probe()`
///| - `<recv>.val` -> `<recv>.mbt_val_probe()`
///|
///| Calls `pionc check --json` via callback, enforces strict coverage guard
///| (`probe_diagnostics_received == probes_instrumented` every round; mismatch hard-fails),
///| matches same-line multi-probes by `(file, line, col)` / occurrence order consuming each
///| diagnostic at most once, rewrites each site to canonical `mbt_compat::*` helpers,
///| records `semantic_drift_ledger.json`, iterates for nested probes, and enforces
///| 0 `mbt_*_probe` residuals.

import "json" as json

pub struct ProbeSite {
  probe_id : String
  file : String
  probe_kind : String
  start_byte : Int
  end_byte : Int
  op_byte : Int
  line : Int
  col : Int
  lhs_expr : String
  rhs_expr : String
  assign_op : String
  slice_hi : String
  divisor_is_zero : Bool
  rhs_has_lit : Bool
  rhs_is_neg : Bool
  rhs_u64 : UInt64
  rhs_overflow : Bool
}

pub struct ProbeResult {
  file : String
  line : Int
  col : Int
  probe_kind : String
  probe_id : String
  resolved_type : String
}

///| Parse `pionc check --json` stdout into structured `PioncDiag`s.
pub fn parse_pionc_diagnostics(json_text : String) -> Array[PioncDiag] {
  let out : Array[PioncDiag] = []
  let trimmed = json_text.trim()
  if trimmed.length() == 0 {
    return out
  }
  let start = trimmed.index_of("{")
  let clean = if start >= 0 { trimmed.slice(start, trimmed.length()) } else { trimmed }
  let root = match json::parse(clean) {
    Ok(v) => v
    Err(_) => return out
  }
  match json::obj_get(root, "diagnostics") {
    Some(arr_v) =>
    match json::as_arr(arr_v) {
      Some(items) => {
        for it in items {
          let file = match json::obj_get(it, "file") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          let line = match json::obj_get(it, "line") {
            Some(v) => match json::as_int(v) { Some(n) => n.to_int(), None => 0 }
            None => 0
          }
          let col = match json::obj_get(it, "col") {
            Some(v) => match json::as_int(v) { Some(n) => n.to_int(), None => 0 }
            None => 0
          }
          let code = match json::obj_get(it, "code") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          let message = match json::obj_get(it, "message") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          let expected = match json::obj_get(it, "expected") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          let found = match json::obj_get(it, "found") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          let fixit = match json::obj_get(it, "fixit") {
            Some(v) => match json::as_str(v) { Some(s) => s, None => "" }
            None => ""
          }
          out.push(PioncDiag::{
            file: file,
            line: line,
            col: col,
            code: code,
            message: message,
            expected: expected,
            found: found,
            fixit: fixit,
          })
        }
      }
      None => ()
    }
    None => ()
  }
  out
}

///| Extract `(probe_kind, probe_id, resolved_type)` from a `pionc` diagnostic message of the form:
///| `unknown method `mbt_*_probe[__p<id>]` on type `<T>``
pub fn extract_probe_with_id_from_diag(d : PioncDiag) -> Option[(String, String, String)] {
  let prefix = "unknown method `mbt_"
  let p_idx = d.message.index_of(prefix)
  if p_idx < 0 {
    return None
  }
  let after_m = d.message.slice(p_idx + 16, d.message.length())
  let tick_end = after_m.index_of("`")
  if tick_end < 0 {
    return None
  }
  let raw_name = after_m.slice(0, tick_end)
  let mut probe_kind = raw_name
  let mut probe_id = ""
  let tag_idx = raw_name.index_of("__p")
  if tag_idx > 0 {
    probe_kind = raw_name.slice(0, tag_idx)
    probe_id = raw_name.slice(tag_idx + 2, raw_name.length())
  }
  if !probe_kind.ends_with("_probe") {
    return None
  }
  let on_ty = " on type `"
  let ty_idx = after_m.index_of(on_ty)
  if ty_idx < 0 {
    return None
  }
  let after_ty = after_m.slice(ty_idx + on_ty.length(), after_m.length())
  let ty_end = after_ty.index_of("`")
  if ty_end < 0 {
    return None
  }
  let resolved_ty = after_ty.slice(0, ty_end)
  Some((probe_kind, probe_id, resolved_ty))
}

///| Backwards-compatible wrapper returning `(probe_kind, resolved_type)`.
pub fn extract_probe_from_diag(d : PioncDiag) -> Option[(String, String)] {
  match extract_probe_with_id_from_diag(d) {
    Some((k, _, t)) => Some((k, t))
    None => None
  }
}

///| Parse an integer literal token (`0`, `1`, `0x1`, `0xffffffff`, `0xffffffffffffffffL`,
///| `0b1`, `0o1`, `1_`, `0UL`, etc.) into its exact unsigned 64-bit magnitude and an overflow flag.
///| Never truncates or saturates silently so bit-width/signedness checks in `can_omit_div_check`
///| are 100% exact (Astra Round 4 P0-3).
pub fn parse_int_literal_u64(tok : Token) -> Option[(UInt64, Bool)] {
  if tok.kind != TokenKind::IntLit {
    return None
  }
  let s = tok.raw
  let mut end = s.length()
  while end > 0 {
    let lc = s.code_unit_at(end - 1)
    if lc == 76 || lc == 108 || lc == 85 || lc == 117 {
      end = end - 1
    } else {
      break
    }
  }
  if end <= 0 {
    return None
  }
  let mut i = 0
  let mut base : UInt64 = 10UL
  if end >= 2 && s.code_unit_at(0) == 48 {
    let p1 = s.code_unit_at(1)
    if p1 == 120 || p1 == 88 {
      base = 16UL
      i = 2
    } else if p1 == 98 || p1 == 66 {
      base = 2UL
      i = 2
    } else if p1 == 111 || p1 == 79 {
      base = 8UL
      i = 2
    }
  }
  let max_u64 : UInt64 = 18446744073709551615UL
  let mut acc : UInt64 = 0UL
  let mut overflowed = false
  let mut saw_digit = false
  while i < end {
    let c = s.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    let d_i = if c >= 48 && c <= 57 {
      c - 48
    } else if c >= 97 && c <= 102 {
      c - 97 + 10
    } else if c >= 65 && c <= 70 {
      c - 65 + 10
    } else {
      -1
    }
    if d_i < 0 {
      return None
    }
    let d = d_i.to_int64().reinterpret_as_uint64()
    if d >= base {
      return None
    }
    saw_digit = true
    if !overflowed {
      if acc > (max_u64 - d) / base {
        overflowed = true
      } else {
        acc = acc * base + d
      }
    }
    i = i + 1
  }
  if saw_digit { Some((acc, overflowed)) } else { None }
}

///| Strictly decide whether a constant integer divisor on `resolved_type` can safely omit
///| the runtime `div_checked_*` / `mod_checked_*` helper without risking div-by-zero OR
///| signed `MIN / -1` overflow (including all-ones bit patterns like `0xffffffff` / `0xffffffffffffffffL`).
pub fn can_omit_div_check(resolved_type : String, site : ProbeSite) -> Bool {
  if !site.rhs_has_lit || site.rhs_overflow {
    return false
  }
  if resolved_type == "Int" {
    if !site.rhs_is_neg {
      return site.rhs_u64 >= 1UL && site.rhs_u64 <= 2147483647UL
    }
    return site.rhs_u64 >= 2UL && site.rhs_u64 <= 2147483648UL
  }
  if resolved_type == "Int64" {
    if !site.rhs_is_neg {
      return site.rhs_u64 >= 1UL && site.rhs_u64 <= 9223372036854775807UL
    }
    return site.rhs_u64 >= 2UL && site.rhs_u64 <= 9223372036854775808UL
  }
  if resolved_type == "UInt" {
    return !site.rhs_is_neg && site.rhs_u64 >= 1UL && site.rhs_u64 <= 4294967295UL
  }
  if resolved_type == "UInt64" {
    return !site.rhs_is_neg && site.rhs_u64 >= 1UL
  }
  if resolved_type == "Byte" {
    return !site.rhs_is_neg && site.rhs_u64 >= 1UL && site.rhs_u64 <= 255UL
  }
  false
}

///| Check whether a numeric literal token is statically known to be non-zero.
pub fn is_statically_nonzero_literal(tok : Token) -> Bool {
  if tok.kind == TokenKind::IntLit {
    return match parse_int_literal_u64(tok) {
      Some((v, ovf)) => ovf || v != 0UL
      None => false
    }
  }
  if tok.kind != TokenKind::FloatLit {
    return false
  }
  let s = tok.raw
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 101 || c == 69 || c == 102 || c == 70 {
      return false
    }
    if c >= 49 && c <= 57 {
      return true
    }
    i = i + 1
  }
  false
}

///| Check whether a numeric literal token is statically known to be zero (`0`, `0L`, `0U`, `0x0`, `0.0e5`).
pub fn is_statically_zero_literal(tok : Token) -> Bool {
  if tok.kind != TokenKind::IntLit && tok.kind != TokenKind::FloatLit {
    return false
  }
  !is_statically_nonzero_literal(tok)
}

///| Canonical `mbt_compat::*` checked division/modulo helper names aligned 1:1 with `tools/mbt_compat`.
pub fn checked_div_helper(ty : String, is_mod : Bool) -> Option[String] {
  let op = if is_mod { "mod_checked_" } else { "div_checked_" }
  if ty == "Int" {
    Some("mbt_compat::" + op + "i32")
  } else if ty == "Int64" {
    Some("mbt_compat::" + op + "i64")
  } else if ty == "UInt" {
    Some("mbt_compat::" + op + "u32")
  } else if ty == "UInt64" {
    Some("mbt_compat::" + op + "u64")
  } else if ty == "Byte" {
    Some("mbt_compat::" + op + "byte")
  } else {
    None
  }
}

pub fn is_float_type(ty : String) -> Bool {
  ty == "Double" || ty == "Float"
}

pub fn is_unsupported_int_type(ty : String) -> Bool {
  ty == "Int16" || ty == "UInt16" || ty == "Int8" || ty == "UInt8" || ty == "Int128" || ty == "UInt128"
}

fn is_literal_expr_token(k : TokenKind) -> Bool {
  k == TokenKind::IntLit || k == TokenKind::FloatLit ||
  k == TokenKind::StringLit || k == TokenKind::InterpString ||
  k == TokenKind::RawMultiline || k == TokenKind::InterpMultiline ||
  k == TokenKind::ByteStringLit || k == TokenKind::CharLit || k == TokenKind::ByteCharLit
}

///| Walk backwards from `end_idx` (inclusive, the last token of a receiver expression) to find
///| the starting token index of a postfix/primary receiver chain:
///| supports `ident`, `a.b.c`, `f(x).y`, `arr[i]`, `(a + b)`, `pkg::fn(x)`, and string/char/num literals.
///| Returns `-1` if `end_idx` cannot end a probeable receiver expression.
fn find_receiver_start(tokens : Array[Token], end_idx : Int) -> Int {
  if end_idx < 0 || end_idx >= tokens.length() {
    return -1
  }
  let mut cur = end_idx
  while cur >= 0 {
    let k = tokens[cur].kind
    if k == TokenKind::RParen || k == TokenKind::RBracket {
      let close_k = k
      let open_k = if k == TokenKind::RParen { TokenKind::LParen } else { TokenKind::LBracket }
      let mut depth = 0
      let mut j = cur
      while j >= 0 {
        if tokens[j].kind == close_k {
          depth = depth + 1
        } else if tokens[j].kind == open_k {
          depth = depth - 1
          if depth == 0 {
            break
          }
        }
        j = j - 1
      }
      if depth != 0 {
        return -1
      }
      cur = j
      // If preceded on the SAME line by ident / `)` / `]` / literal, this was a call `f(...)` or index `arr[...]` — continue walking!
      // NEVER cross a newline into the previous statement (e.g. `let d = 7.0\n(d / 2).to_string()`).
      if cur > 0 && !tokens[cur].newline_before {
        let pk = tokens[cur - 1].kind
        if pk == TokenKind::Ident || pk == TokenKind::UpperIdent || pk == TokenKind::RParen || pk == TokenKind::RBracket || is_literal_expr_token(pk) {
          cur = cur - 1
          continue
        }
      }
      return cur
    }
    if k == TokenKind::Ident || k == TokenKind::UpperIdent || is_literal_expr_token(k) {
      if cur > 0 && (tokens[cur - 1].kind == TokenKind::Dot || tokens[cur - 1].kind == TokenKind::ColonColon) {
        if cur >= 2 {
          cur = cur - 2
          continue
        }
      }
      return cur
    }
    return -1
  }
  -1
}

///| Check whether a RHS expression represents a statically known Byte zero (`0.to_byte()`, `b'\x00'`, `b'\0'`).
fn is_byte_zero_expr(rhs : String) -> Bool {
  let t = rhs.trim()
  t == "0.to_byte()" || t == "(0).to_byte()" || t == "0x0.to_byte()" || t == "0x00.to_byte()" ||
  t == "b'\\x00'" || t == "b'\\0'" || t == "b'\\u{0}'"
}

///| Find end token index (inclusive) of a unary/postfix RHS operand for `*`, `/`, or `%`.
///| Handles unary `-` / `+` / `!` (e.g. `a / -b`, `a / -(b + c)`), parenthesized `(b - c)`,
///| literals (incl. string/byte char), field chains `h.n`, qualified `pkg::fn(x)`, and indexed `arr[i]`.
fn find_rhs_end(tokens : Array[Token], start_idx : Int, limit : Int) -> Int {
  let mut cur = start_idx
  while cur < limit && (tokens[cur].kind == TokenKind::Minus || tokens[cur].kind == TokenKind::Plus || tokens[cur].kind == TokenKind::Bang) {
    cur = cur + 1
  }
  if cur >= limit {
    return -1
  }
  let k = tokens[cur].kind
  if k == TokenKind::LParen {
    cur = find_matching_delim(tokens, cur)
  } else if k == TokenKind::Ident || k == TokenKind::UpperIdent || is_literal_expr_token(k) {
    let _ = 0
  } else {
    return -1
  }
  while cur + 1 < limit {
    let nk = tokens[cur + 1].kind
    if (nk == TokenKind::Dot || nk == TokenKind::ColonColon) && cur + 2 < limit &&
    (tokens[cur + 2].kind == TokenKind::Ident || tokens[cur + 2].kind == TokenKind::UpperIdent) {
      cur = cur + 2
    } else if nk == TokenKind::LParen || nk == TokenKind::LBracket {
      cur = find_matching_delim(tokens, cur + 1)
    } else {
      break
    }
  }
  cur
}

///| Walk backwards across a full left-associative multiplicative LHS chain (`a * b`, `xs[i] * 2`,
///| `pkg::f(x) * 3L`, unary `-a`) ending at `end_idx` (inclusive).
///| Returns the starting token index of the full LHS operand of `/` or `%`.
fn find_mul_lhs_start(tokens : Array[Token], end_idx : Int) -> Int {
  let mut start = find_receiver_start(tokens, end_idx)
  if start < 0 {
    return -1
  }
  // Include leading unary `-` if preceded by an operator/delimiter/keyword
  if start > 0 && tokens[start - 1].kind == TokenKind::Minus {
    let is_unary = if start == 1 {
      true
    } else {
      let pk = tokens[start - 2].kind
      pk != TokenKind::Ident && pk != TokenKind::UpperIdent && !is_literal_expr_token(pk) &&
      pk != TokenKind::RParen && pk != TokenKind::RBracket
    }
    if is_unary {
      start = start - 1
    }
  }
  // Extend left across `*`, `/`, `%` (same precedence, left-associative!)
  while start >= 2 &&
  (tokens[start - 1].kind == TokenKind::Star || tokens[start - 1].kind == TokenKind::Slash || tokens[start - 1].kind == TokenKind::Percent) {
    let prev_start = find_receiver_start(tokens, start - 2)
    if prev_start < 0 {
      break
    }
    start = prev_start
    if start > 0 && tokens[start - 1].kind == TokenKind::Minus {
      let is_unary = if start == 1 {
        true
      } else {
        let pk = tokens[start - 2].kind
        pk != TokenKind::Ident && pk != TokenKind::UpperIdent && !is_literal_expr_token(pk) &&
        pk != TokenKind::RParen && pk != TokenKind::RBracket
      }
      if is_unary {
        start = start - 1
      }
    }
  }
  start
}

///| Check whether a receiver starting at `recv_start` is inside a declaration header (NOT struct field init `Box::{ n: expr }`).
fn is_non_expr_receiver(tokens : Array[Token], recv_start : Int) -> Bool {
  if recv_start <= 0 {
    return false
  }
  let pk = tokens[recv_start - 1].kind
  let pr = tokens[recv_start - 1].raw
  if pk == TokenKind::Keyword && (pr == "fn" || pr == "struct" || pr == "enum" || pr == "let" || pr == "mut" || pr == "type" || pr == "trait") {
    return true
  }
  if pk == TokenKind::Arrow {
    return true
  }
  false
}

///| Pre-scan all files in a package (incl. `00_init_order.pion`) to classify top-level
///| declared values (`const`/`let`) vs declared types (`struct`/`enum`/`type`/`trait` + builtins)
///| so `CAP[1]` (uppercase value constant) is NEVER mistaken for a generic type parameter `Array[T]` (Astra Round 6 P0-1).
fn collect_package_value_and_type_names(files : Array[GeneratedFile]) -> (Map[String, Bool], Map[String, Bool]) {
  let declared_values : Map[String, Bool] = Map()
  let declared_types : Map[String, Bool] = Map()
  let builtins = [
    "Array", "Map", "OrderedMap", "Option", "Result", "Ref", "Set",
    "FixedArray", "ArrayView", "ArrayBuf", "Iter", "Fn", "Channel", "Mutex", "Arc",
  ]
  for b in builtins {
    declared_types[b] = true
  }
  for f in files {
    let toks = lex_moonbit(f.content)
    let n = toks.length() - 1
    let mut depth = 0
    let mut i = 0
    while i < n {
      let tk = toks[i]
      if tk.kind == TokenKind::LBrace || tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket {
        depth = depth + 1
      } else if tk.kind == TokenKind::RBrace || tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket {
        if depth > 0 { depth = depth - 1 }
      } else if depth == 0 && tk.kind == TokenKind::Keyword && i + 1 < n {
        if tk.raw == "const" || tk.raw == "let" {
          let mut ni = i + 1
          if ni < n && toks[ni].kind == TokenKind::Keyword && toks[ni].raw == "mut" {
            ni = ni + 1
          }
          if ni < n && (toks[ni].kind == TokenKind::Ident || toks[ni].kind == TokenKind::UpperIdent) {
            declared_values[toks[ni].raw] = true
          }
        } else if tk.raw == "struct" || tk.raw == "enum" || tk.raw == "type" || tk.raw == "trait" {
          if toks[i + 1].kind == TokenKind::UpperIdent || toks[i + 1].kind == TokenKind::Ident {
            declared_types[toks[i + 1].raw] = true
          }
        }
      }
      i = i + 1
    }
  }
  (declared_values, declared_types)
}

///| Collect cross-package qualified value vs type names from `api_map` (Astra Round 7 P0):
///| ensures `acme::CAP[1]` is classified by `acme::CAP` and NEVER shadowed by a local `struct CAP`.
fn collect_qualified_api_names(api_map : ApiMap) -> (Map[String, Bool], Map[String, Bool]) {
  let qual_values : Map[String, Bool] = Map()
  let qual_types : Map[String, Bool] = Map()
  // Built-in `mbt_compat` generic types must always be recognized as type-arg brackets
  // (e.g. `mbt_compat::Ref[Int]` inside enum variant tuple payloads) and never probed as indexing.
  qual_types["mbt_compat::Ref"] = true
  qual_types["mbt_compat::OrderedMap"] = true
  qual_types["mbt_compat::OrderedSet"] = true
  qual_types["mbt_compat::ArrayView"] = true
  qual_types["mbt_compat::ArrayBuf"] = true
  qual_types["mbt_compat::MbtIter"] = true
  qual_types["mbt_compat::MbtCell"] = true
  qual_types["mbt_compat::MbtJson"] = true
  for sym in api_map.symbols {
    if sym.target_pkg.length() > 0 && sym.target_name.length() > 0 {
      let qname = sym.target_pkg + "::" + sym.target_name
      if sym.kind == "const" || sym.kind == "val" || sym.kind == "let" {
        qual_values[qname] = true
      } else if sym.kind == "type" || sym.kind == "struct" || sym.kind == "enum" || sym.kind == "trait" {
        qual_types[qname] = true
      }
    }
  }
  (qual_values, qual_types)
}

///| Check whether the tokens inside `[lbr_idx + 1 .. close_br - 1]` look strictly like type arguments
///| (no numeric/string literals, arithmetic ops, declared value names, or expression-continuation token after `]`).
fn bracket_looks_like_type_args(
  tokens : Array[Token],
  lbr_idx : Int,
  close_br : Int,
  declared_values : Map[String, Bool],
) -> Bool {
  if close_br <= lbr_idx + 1 {
    return false
  }
  // 1. Check token immediately following `]`: expression operators / member access prove this is value indexing!
  if close_br + 1 < tokens.length() - 1 {
    let nr = tokens[close_br + 1].raw
    if nr == "." || nr == "[" ||
    nr == "+" || nr == "-" || nr == "*" || nr == "/" || nr == "%" ||
    nr == "==" || nr == "!=" || nr == "<" || nr == ">" ||
    nr == "<=" || nr == ">=" || nr == "&&" || nr == "||" {
      return false
    }
  }
  let first = tokens[lbr_idx + 1]
  let valid_start = first.kind == TokenKind::UpperIdent ||
  first.kind == TokenKind::LParen ||
  (first.kind == TokenKind::Ident && lbr_idx + 2 < close_br && tokens[lbr_idx + 2].kind == TokenKind::ColonColon) ||
  (first.kind == TokenKind::Keyword && first.raw == "dyn")
  if !valid_start {
    return false
  }
  let mut k = lbr_idx + 1
  while k < close_br {
    let kk = tokens[k].kind
    if kk == TokenKind::IntLit || kk == TokenKind::FloatLit || kk == TokenKind::StringLit ||
    kk == TokenKind::Plus || kk == TokenKind::Minus || kk == TokenKind::Star || kk == TokenKind::Slash || kk == TokenKind::Percent {
      return false
    }
    if (kk == TokenKind::Ident || kk == TokenKind::UpperIdent) &&
    (k == lbr_idx + 1 || tokens[k - 1].kind != TokenKind::ColonColon) &&
    declared_values.contains(tokens[k].raw) {
      return false
    }
    k = k + 1
  }
  true
}

///| Determine whether the `:` at `colon_idx` is a type annotation (`let x : T`, `const X : T`,
///| `fn f(x : T)`, `struct S { f : T }`) vs a struct-literal field value (`Box::{ n: expr }`) (Astra Round 8 P0-1).
fn is_colon_in_type_annotation(tokens : Array[Token], colon_idx : Int) -> Bool {
  let mut depth = 0
  let mut seen_stmt_sep = false
  let mut k = colon_idx - 1
  while k >= 0 {
    let tk = tokens[k]
    if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
      depth = depth + 1
    } else if tk.kind == TokenKind::LParen {
      if depth == 0 {
        let mut p = k - 1
        if p >= 0 && tokens[p].kind == TokenKind::RBracket {
          let mut bd = 1
          p = p - 1
          while p >= 0 && bd > 0 {
            if tokens[p].kind == TokenKind::RBracket { bd = bd + 1 } else if tokens[p].kind == TokenKind::LBracket { bd = bd - 1 }
            p = p - 1
          }
        }
        while p >= 0 && (tokens[p].kind == TokenKind::Ident || tokens[p].kind == TokenKind::UpperIdent || tokens[p].kind == TokenKind::ColonColon) {
          p = p - 1
        }
        if p >= 0 && tokens[p].kind == TokenKind::RBracket {
          let mut bd = 1
          p = p - 1
          while p >= 0 && bd > 0 {
            if tokens[p].kind == TokenKind::RBracket { bd = bd + 1 } else if tokens[p].kind == TokenKind::LBracket { bd = bd - 1 }
            p = p - 1
          }
        }
        return p >= 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "fn"
      }
      depth = depth - 1
    } else if tk.kind == TokenKind::LBracket {
      if depth > 0 { depth = depth - 1 }
    } else if tk.kind == TokenKind::LBrace {
      if depth == 0 {
        if k >= 1 && tokens[k - 1].kind == TokenKind::ColonColon {
          return false
        }
        let mut p = k - 1
        if p >= 0 && tokens[p].kind == TokenKind::RBracket {
          let mut bd = 1
          p = p - 1
          while p >= 0 && bd > 0 {
            if tokens[p].kind == TokenKind::RBracket { bd = bd + 1 } else if tokens[p].kind == TokenKind::LBracket { bd = bd - 1 }
            p = p - 1
          }
        }
        while p >= 0 && (tokens[p].kind == TokenKind::UpperIdent || tokens[p].kind == TokenKind::Ident) {
          p = p - 1
        }
        return p >= 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "struct"
      }
      depth = depth - 1
    } else if depth == 0 {
      if tk.kind == TokenKind::Semi || tk.kind == TokenKind::Comma || tk.kind == TokenKind::Eq {
        seen_stmt_sep = true
      } else if !seen_stmt_sep && tk.kind == TokenKind::Keyword && (tk.raw == "let" || tk.raw == "const") {
        return true
      }
    }
    k = k - 1
  }
  false
}

///| Find the enclosing unmatched `[` token index before `pos`, or -1 if none.
fn find_enclosing_lbracket(tokens : Array[Token], pos : Int) -> Int {
  let mut depth = 0
  let mut k = pos - 1
  while k >= 0 {
    let kk = tokens[k].kind
    if kk == TokenKind::RBracket {
      depth = depth + 1
    } else if kk == TokenKind::LBracket {
      if depth == 0 {
        return k
      }
      depth = depth - 1
    } else if kk == TokenKind::LBrace || kk == TokenKind::RBrace || kk == TokenKind::Semi {
      return -1
    }
    k = k - 1
  }
  -1
}

///| Find the enclosing unmatched `(` token index before `pos`, or -1 if none.
fn find_enclosing_lparen(tokens : Array[Token], pos : Int) -> Int {
  let mut depth = 0
  let mut k = pos - 1
  while k >= 0 {
    let kk = tokens[k].kind
    if kk == TokenKind::RParen {
      depth = depth + 1
    } else if kk == TokenKind::LParen {
      if depth == 0 {
        return k
      }
      depth = depth - 1
    } else if kk == TokenKind::LBrace || kk == TokenKind::RBrace || kk == TokenKind::Semi {
      return -1
    }
    k = k - 1
  }
  -1
}

///| Check whether token position `pos` (the start of a type name) sits syntactically inside a type expression:
///| after `:` (type annotation), `->`, `type Name =`, inside an enclosing type-argument `[...]`, or inside a
///| tuple/function/enum-payload `(...)` whose own position is in a type context.
fn is_pos_in_type_context(
  tokens : Array[Token],
  pos : Int,
  declared_values : Map[String, Bool],
  declared_types : Map[String, Bool],
  qual_values : Map[String, Bool],
  qual_types : Map[String, Bool],
) -> Bool {
  if pos <= 0 {
    return false
  }
  let pk = tokens[pos - 1].kind
  let pr = tokens[pos - 1].raw
  if pk == TokenKind::Keyword && (pr == "fn" || pr == "struct" || pr == "enum" || pr == "type" || pr == "trait" || pr == "impl") {
    return true
  }
  if pk == TokenKind::Arrow {
    return true
  }
  if pk == TokenKind::Colon && is_colon_in_type_annotation(tokens, pos - 1) {
    return true
  }
  if pk == TokenKind::Eq && pos >= 3 {
    // `type Alias = T[U]` or `type Alias[A] = T[U]`
    let mut k = pos - 2
    if k >= 0 && tokens[k].kind == TokenKind::RBracket {
      let mut bd = 1
      k = k - 1
      while k >= 0 && bd > 0 {
        if tokens[k].kind == TokenKind::RBracket { bd = bd + 1 } else if tokens[k].kind == TokenKind::LBracket { bd = bd - 1 }
        k = k - 1
      }
    }
    if k >= 1 && tokens[k].kind == TokenKind::UpperIdent && tokens[k - 1].kind == TokenKind::Keyword && tokens[k - 1].raw == "type" {
      return true
    }
  }
  if pk == TokenKind::LBracket || pk == TokenKind::Comma || pk == TokenKind::LParen {
    let outer_lbr = find_enclosing_lbracket(tokens, pos)
    let outer_lp = find_enclosing_lparen(tokens, pos)
    // Check whichever enclosing delimiter (`[` or `(`) is innermost
    if outer_lbr > outer_lp && outer_lbr >= 0 {
      if is_type_arg_brackets(tokens, outer_lbr, declared_values, declared_types, qual_values, qual_types) {
        return true
      }
    }
    if outer_lp > outer_lbr && outer_lp >= 0 {
      // Tuple type `(T, U)` or function type `(T) -> U` in a type context
      if is_pos_in_type_context(tokens, outer_lp, declared_values, declared_types, qual_values, qual_types) {
        return true
      }
      // Check if `( ... ) ->` function type
      let close_lp = find_matching_delim(tokens, outer_lp)
      if close_lp + 1 < tokens.length() && tokens[close_lp + 1].kind == TokenKind::Arrow {
        return true
      }
      // Check if enum variant payload inside `enum E { Variant(T[U]) }`
      if outer_lp >= 1 && tokens[outer_lp - 1].kind == TokenKind::UpperIdent {
        let mut lb = outer_lp - 2
        let mut d = 0
        while lb >= 0 {
          let lk = tokens[lb].kind
          if lk == TokenKind::RBrace { d = d + 1 }
          else if lk == TokenKind::LBrace {
            if d == 0 {
              let mut p = lb - 1
              if p >= 0 && tokens[p].kind == TokenKind::RBracket {
                let mut bd = 1
                p = p - 1
                while p >= 0 && bd > 0 {
                  if tokens[p].kind == TokenKind::RBracket { bd = bd + 1 } else if tokens[p].kind == TokenKind::LBracket { bd = bd - 1 }
                  p = p - 1
                }
              }
              while p >= 0 && (tokens[p].kind == TokenKind::UpperIdent || tokens[p].kind == TokenKind::Ident) {
                p = p - 1
              }
              if p >= 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "enum" {
                return true
              }
              break
            }
            d = d - 1
          }
          lb = lb - 1
        }
      }
    }
  }
  false
}

///| Distinguish generic type parameter brackets (`Array[T]`, `Option[acme::Wrap[Int]]`, `fn id[T]`)
///| from value indexing brackets (`CAP[1]`, `acme::CAP[1]`, `xs[0]`, `"中A"[1]`) using symbol categories
///| and qualified `pkg::Name` isolation (Astra Round 6 P0-1 + Round 7 P0).
fn is_type_arg_brackets(
  tokens : Array[Token],
  lbr_idx : Int,
  declared_values : Map[String, Bool],
  declared_types : Map[String, Bool],
  qual_values : Map[String, Bool],
  qual_types : Map[String, Bool],
) -> Bool {
  if lbr_idx <= 0 {
    return false
  }
  let prev = tokens[lbr_idx - 1]
  // `fn foo[T]` or `fn Type::foo[T]` generic parameter list on lowercase fn/method name
  if prev.kind == TokenKind::Ident {
    if lbr_idx >= 2 && tokens[lbr_idx - 2].kind == TokenKind::Keyword && tokens[lbr_idx - 2].raw == "fn" {
      return true
    }
    let fn_recv = find_receiver_start(tokens, lbr_idx - 1)
    if fn_recv > 0 && tokens[fn_recv - 1].kind == TokenKind::Keyword && tokens[fn_recv - 1].raw == "fn" {
      return true
    }
    return false
  }
  if prev.kind != TokenKind::UpperIdent {
    return false
  }
  let nm = prev.raw
  let is_qualified = lbr_idx >= 3 &&
  tokens[lbr_idx - 2].kind == TokenKind::ColonColon &&
  (tokens[lbr_idx - 3].kind == TokenKind::Ident || tokens[lbr_idx - 3].kind == TokenKind::UpperIdent)
  if is_qualified {
    // Cross-package qualified symbol `pkg::Name`: classify ONLY by `qual_values`/`qual_types`
    // and syntactic type position — NEVER let local package `declared_types` shadow it!
    let qname = tokens[lbr_idx - 3].raw + "::" + nm
    if qual_values.contains(qname) {
      return false
    }
    if qual_types.contains(qname) {
      return true
    }
  } else {
    // Unqualified local symbol: check current package `declared_values` / `declared_types`
    if declared_values.contains(nm) {
      return false
    }
    if declared_types.contains(nm) {
      return true
    }
  }
  // 3 & 4. Syntactic type context (`fn`/`struct`/`enum`/`type`/`trait`/`impl`, `->`, `:`, `type X =`,
  //        or nested inside enclosing type-arg `[...]` / tuple / fn / enum-payload `(...)`).
  let recv_start = find_receiver_start(tokens, lbr_idx - 1)
  if recv_start > 0 {
    let pk = tokens[recv_start - 1].kind
    let pr = tokens[recv_start - 1].raw
    if pk == TokenKind::Keyword && (pr == "fn" || pr == "struct" || pr == "enum" || pr == "type" || pr == "trait" || pr == "impl") {
      return true
    }
    if pk == TokenKind::Arrow {
      return true
    }
    let close_br = find_matching_delim(tokens, lbr_idx)
    if bracket_looks_like_type_args(tokens, lbr_idx, close_br, declared_values) &&
    is_pos_in_type_context(tokens, recv_start, declared_values, declared_types, qual_values, qual_types) {
      return true
    }
  }
  // 5. Unknown uppercase identifier (including unknown qualified `ext::CAP[1]`): treat as value index (fail-closed!)
  false
}

///| Lexer-accurate check for nested `__mbt_ufcs_dispatch` placeholders inside `[start, end)`
///| (including inside `InterpString`/`InterpMultiline` `\{...}` expressions, while ignoring plain string literals).
fn has_nested_ufcs_dispatch(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && tk.raw == "__mbt_ufcs_dispatch" {
      return true
    }
    if (tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline) &&
    str_has(tk.raw, "__mbt_ufcs_dispatch") {
      let parts = split_interp_string(tk.raw, tk.kind == TokenKind::InterpMultiline)
      for p in parts {
        if p.is_expr && str_has(p.text, "__mbt_ufcs_dispatch") {
          let itoks = lex_moonbit(p.text)
          if has_nested_ufcs_dispatch(itoks, 0, itoks.length() - 1) {
            return true
          }
        }
      }
    }
    k = k + 1
  }
  false
}

///| Instrument a single Pion file with `mbt_*_probe` calls for one pass.
///| Supports chained/complex receivers (`self.text.length()`, `f().length()`, `arr[i].length()`,
///| `(a + b) / n`, `self.r.val`, `"{d}"`, and slice placeholders) while skipping already-proven safe offsets.
pub fn instrument_probes_for_file(file : String, content : String) -> (String, Array[ProbeSite]) {
  instrument_probes_for_file_with_api_map(file, content, empty_api_map())
}

pub fn instrument_probes_for_file_with_api_map(
  file : String,
  content : String,
  api_map : ApiMap,
) -> (String, Array[ProbeSite]) {
  let empty_safe : Map[Int, Bool] = Map()
  let (dvals, dtypes) = collect_package_value_and_type_names([
    GeneratedFile::{ rel_path: file, content: content, source_file: file, anchors: [] },
  ])
  let (qvals, qtypes) = collect_qualified_api_names(api_map)
  instrument_probes_for_file_with_safe(file, content, empty_safe, 0, dvals, dtypes, qvals, qtypes, Map())
}

fn is_u16_arith_or_bit_raw(r : String) -> Bool {
  r == "+" || r == "-" || r == "*" || r == "/" || r == "%" ||
  r == "&" || r == "|" || r == "^" || r == "<<" || r == ">>" || r == "~"
}

fn is_u16_cmp_raw(r : String) -> Bool {
  r == "==" || r == "!=" || r == "<" || r == "<=" || r == ">" || r == ">="
}

fn is_u16_int_lit_0_65535(raw : String) -> Bool {
  let n = raw.length()
  if n == 0 { return false }
  let mut base = 10
  let mut i = 0
  if n >= 2 && raw.code_unit_at(0) == 48 {
    let c1 = raw.code_unit_at(1)
    if c1 == 120 || c1 == 88 { base = 16; i = 2 }
    else if c1 == 111 || c1 == 79 { base = 8; i = 2 }
    else if c1 == 98 || c1 == 66 { base = 2; i = 2 }
  }
  let mut acc = 0
  let mut seen = false
  while i < n {
    let c = raw.code_unit_at(i)
    if c == 95 { i = i + 1; continue }
    let d = if c >= 48 && c <= 57 { c - 48 }
    else if c >= 97 && c <= 102 { c - 87 }
    else if c >= 65 && c <= 70 { c - 55 }
    else { -1 }
    if d < 0 || d >= base { return false }
    seen = true
    acc = acc * base + d
    if acc > 65535 { return false }
    i = i + 1
  }
  seen && acc >= 0 && acc <= 65535
}

fn find_matching_open_delim_back(tokens : Array[Token], close_idx : Int) -> Int {
  let ck = tokens[close_idx].kind
  let mut d = 0
  let mut k = close_idx
  while k >= 0 {
    let tk = tokens[k].kind
    if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      d = d + 1
    } else if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      d = d - 1
      if d == 0 {
        if (ck == TokenKind::RParen && tk == TokenKind::LParen) ||
        (ck == TokenKind::RBracket && tk == TokenKind::LBracket) ||
        (ck == TokenKind::RBrace && tk == TokenKind::LBrace) {
          return k
        }
        return -1
      }
    }
    k = k - 1
  }
  -1
}

fn is_safe_u16_peer_expr(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e { return false }
  if e == s + 1 && tokens[s].kind == TokenKind::IntLit {
    return is_u16_int_lit_0_65535(tokens[s].raw)
  }
  if tokens[e - 1].kind == TokenKind::RParen {
    let lp = find_matching_open_delim_back(tokens, e - 1)
    if lp < s { return false }
    if lp >= s + 2 && tokens[lp - 2].kind == TokenKind::Dot &&
    (tokens[lp - 1].raw == "code_unit_at" || tokens[lp - 1].raw.starts_with("mbt_code_unit_at_probe")) {
      return find_receiver_start(tokens, lp - 3) == s
    }
    if lp == s + 3 && tokens[s].raw == "mbt_compat" &&
    tokens[s + 1].kind == TokenKind::ColonColon && tokens[s + 2].raw == "utf16_code_unit_at" {
      return true
    }
    return false
  }
  if tokens[e - 1].kind == TokenKind::RBracket {
    let lb = find_matching_open_delim_back(tokens, e - 1)
    if lb > s {
      return find_receiver_start(tokens, lb - 1) == s
    }
  }
  false
}

fn is_safe_code_unit_at_context(tokens : Array[Token], recv_start : Int, close_p : Int) -> Bool {
  let n = tokens.length()
  // Context A1: immediate safe widening/conversion/compare method chain
  if close_p + 3 < n && tokens[close_p + 1].kind == TokenKind::Dot &&
  tokens[close_p + 2].kind == TokenKind::Ident && tokens[close_p + 3].kind == TokenKind::LParen &&
  !tokens[close_p + 3].newline_before {
    let m = tokens[close_p + 2].raw
    if (m == "to_int" || m == "to_uint" || m == "to_int64" || m == "to_uint64" || m == "to_byte" || m == "to_string") &&
    close_p + 4 < n && tokens[close_p + 4].kind == TokenKind::RParen {
      return true
    }
    if m == "compare" {
      let cmp_rp = find_matching_delim(tokens, close_p + 3)
      if cmp_rp > close_p + 4 && cmp_rp < n {
        let mut arg_count = 0
        let mut has_empty_mid = false
        let mut a_s = close_p + 4
        let mut a_e = -1
        let mut seg_s = close_p + 4
        let mut d = 0
        let mut k = close_p + 4
        while k <= cmp_rp {
          if k == cmp_rp || (d == 0 && tokens[k].kind == TokenKind::Comma) {
            if k > seg_s {
              arg_count = arg_count + 1
              if arg_count == 1 {
                a_s = seg_s
                a_e = k
              }
            } else if k < cmp_rp {
              has_empty_mid = true
            }
            seg_s = k + 1
          } else {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
          }
          k = k + 1
        }
        if !has_empty_mid && arg_count == 1 && is_safe_u16_peer_expr(tokens, a_s, a_e) {
          return true
        }
      }
    }
  }
  // Context A2: sole argument of `<peer>.compare(<site>)` with safe peer receiver
  if recv_start >= 4 && tokens[recv_start - 1].kind == TokenKind::LParen &&
  !tokens[recv_start - 1].newline_before &&
  tokens[recv_start - 2].kind == TokenKind::Ident && tokens[recv_start - 2].raw == "compare" &&
  tokens[recv_start - 3].kind == TokenKind::Dot &&
  close_p + 1 < n && tokens[close_p + 1].kind == TokenKind::RParen {
    let cmp_recv_s = find_receiver_start(tokens, recv_start - 4)
    if cmp_recv_s >= 0 && is_safe_u16_peer_expr(tokens, cmp_recv_s, recv_start - 3) {
      return true
    }
  }
  // For Context B/C, the site itself must not be directly adjacent to arithmetic/bitwise/postfix ops
  if recv_start > 0 && is_u16_arith_or_bit_raw(tokens[recv_start - 1].raw) {
    return false
  }
  if close_p + 1 < n {
    let nxt = tokens[close_p + 1]
    if is_u16_arith_or_bit_raw(nxt.raw) || nxt.kind == TokenKind::Dot ||
    nxt.kind == TokenKind::LBracket || nxt.kind == TokenKind::LParen {
      return false
    }
  }
  // Context B1: `<site> <cmp> <peer>`
  if close_p + 2 < n && is_u16_cmp_raw(tokens[close_p + 1].raw) {
    let ps = close_p + 2
    let mut pe = ps
    let mut d = 0
    while pe < n {
      let tk = tokens[pe]
      if tk.kind == TokenKind::Eof { break }
      if d == 0 {
        if tk.kind == TokenKind::Comma || tk.kind == TokenKind::RParen ||
        tk.kind == TokenKind::RBracket || tk.kind == TokenKind::LBrace || tk.kind == TokenKind::RBrace ||
        tk.kind == TokenKind::Semi || tk.kind == TokenKind::FatArrow ||
        tk.raw == "&&" || tk.raw == "||" || is_u16_cmp_raw(tk.raw) ||
        (pe > ps && tk.newline_before && !is_u16_arith_or_bit_raw(tk.raw) && tk.kind != TokenKind::Dot) ||
        (tk.kind == TokenKind::Keyword && (tk.raw == "else" || tk.raw == "in" || tk.raw == "as")) {
          break
        }
      }
      if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace { d = d + 1 }
      else if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      pe = pe + 1
    }
    if is_safe_u16_peer_expr(tokens, ps, pe) {
      return true
    }
  }
  // Context B2: `<peer> <cmp> <site>`
  if recv_start >= 2 && is_u16_cmp_raw(tokens[recv_start - 1].raw) {
    let pe = recv_start - 1
    let mut ps = pe
    let mut d = 0
    while ps > 0 {
      let tk = tokens[ps - 1]
      if d == 0 {
        if tk.kind == TokenKind::Comma || tk.kind == TokenKind::LParen ||
        tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace ||
        tk.kind == TokenKind::Semi || tk.kind == TokenKind::FatArrow ||
        tk.raw == "&&" || tk.raw == "||" || tk.raw == "=" || is_u16_cmp_raw(tk.raw) ||
        (tk.kind == TokenKind::Keyword && (tk.raw == "if" || tk.raw == "while" || tk.raw == "return" || tk.raw == "else" || tk.raw == "let")) {
          break
        }
      }
      if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace { d = d + 1 }
      else if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace { if d > 0 { d = d - 1 } }
      ps = ps - 1
    }
    if is_safe_u16_peer_expr(tokens, ps, pe) {
      return true
    }
  }
  // Context C: direct argument to `physical_equal(arg0, arg1)` with a safe peer
  let mut scan_p = recv_start - 1
  let mut pd = 0
  let mut enc_lp = -1
  while scan_p >= 0 {
    let tk = tokens[scan_p]
    if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
      pd = pd + 1
    } else if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace {
      if pd == 0 {
        if tk.kind == TokenKind::LParen { enc_lp = scan_p }
        break
      }
      pd = pd - 1
    }
    scan_p = scan_p - 1
  }
  let is_peq_call = enc_lp >= 1 && tokens[enc_lp - 1].raw == "physical_equal" &&
  !(enc_lp >= 2 && (tokens[enc_lp - 2].kind == TokenKind::Dot || tokens[enc_lp - 2].kind == TokenKind::ColonColon))
  let is_mbt_int_cmp_call = enc_lp >= 3 && tokens[enc_lp - 1].raw == "int_compare" &&
  tokens[enc_lp - 2].kind == TokenKind::ColonColon && tokens[enc_lp - 3].raw == "mbt_compat" &&
  !(enc_lp >= 4 && (tokens[enc_lp - 4].kind == TokenKind::Dot || tokens[enc_lp - 4].kind == TokenKind::ColonColon))
  if is_peq_call || is_mbt_int_cmp_call {
    let enc_rp = find_matching_delim(tokens, enc_lp)
    if enc_rp > close_p && enc_rp < n {
      let args : Array[(Int, Int)] = []
      let mut has_empty_mid = false
      let mut as_i = enc_lp + 1
      let mut ad = 0
      let mut ak = enc_lp + 1
      while ak <= enc_rp {
        if ak == enc_rp || (ad == 0 && tokens[ak].kind == TokenKind::Comma) {
          if ak > as_i {
            args.push((as_i, ak))
          } else if ak < enc_rp {
            has_empty_mid = true
          }
          as_i = ak + 1
        } else {
          let kk = tokens[ak].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { ad = ad + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if ad > 0 { ad = ad - 1 } }
        }
        ak = ak + 1
      }
      if !has_empty_mid && args.length() == 2 {
        let (a0s, a0e) = args[0]
        let (a1s, a1e) = args[1]
        if recv_start == a0s && close_p + 1 == a0e && is_safe_u16_peer_expr(tokens, a1s, a1e) {
          return true
        }
        if recv_start == a1s && close_p + 1 == a1e && is_safe_u16_peer_expr(tokens, a0s, a0e) {
          return true
        }
      }
    }
  }
  false
}

fn instrument_probes_for_file_with_safe(
  file : String,
  content : String,
  safe_offsets : Map[Int, Bool],
  base_offset : Int,
  declared_values : Map[String, Bool],
  declared_types : Map[String, Bool],
  qual_values : Map[String, Bool],
  qual_types : Map[String, Bool],
  val_placeholders : Map[String, Bool],
) -> (String, Array[ProbeSite]) {
  let tokens = lex_moonbit(content)
  let n = tokens.length() - 1
  let sites : Array[ProbeSite] = []
  let edits : Array[(Int, Int, String)] = []
  let mut covered_end = 0
  let mut slice_only_pass = false
  if str_has(content, "__mbt_slice_owned") || str_has(content, "__mbt_slice_borrow") ||
  str_has(content, "__mbt_slice_ro_join") || str_has(content, "__mbt_slice_ro_show") ||
  str_has(content, "__mbt_match_scrut") || str_has(content, "__mbt_ufcs_dispatch") || str_has(content, "__mbt_show_trait") {
    let mut si = 0
    while si < n {
      if (tokens[si].kind == TokenKind::InterpString || tokens[si].kind == TokenKind::InterpMultiline) &&
      has_nested_ufcs_dispatch(tokens, si, si + 1) {
        slice_only_pass = true
        break
      }
      if si + 3 < n && tokens[si].kind == TokenKind::Ident && tokens[si].raw == "mbt_compat" &&
      tokens[si + 1].kind == TokenKind::ColonColon &&
      (tokens[si + 2].raw == "__mbt_slice_owned" || tokens[si + 2].raw == "__mbt_slice_borrow" ||
        tokens[si + 2].raw == "__mbt_slice_ro_join" || tokens[si + 2].raw == "__mbt_slice_ro_show" ||
        tokens[si + 2].raw == "__mbt_match_scrut" || tokens[si + 2].raw == "__mbt_ufcs_dispatch" ||
        tokens[si + 2].raw == "__mbt_show_trait") &&
      tokens[si + 3].kind == TokenKind::LParen &&
      !safe_offsets.contains(base_offset + tokens[si + 2].start_byte) {
        slice_only_pass = true
        break
      }
      si = si + 1
    }
  }
  let mut i = 0

  while i < n {
    let t = tokens[i]
    if t.start_byte < covered_end {
      i = i + 1
      continue
    }

    // 0a. Astra Round 3 P0-2 & E1-4: Stage A slice placeholders `mbt_compat::__mbt_slice_{owned,borrow,ro_join,ro_show}(recv, lo, hi)`
    //     Resolved in a dedicated slice-first pass so downstream uses (`let v = x[0:1]; v[0]`, `v.length()`)
    //     see the real resolved `Array[T]` / `String` / `ArrayView[T]` type in the next round!
    if t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    (tokens[i + 2].raw == "__mbt_slice_owned" || tokens[i + 2].raw == "__mbt_slice_borrow" ||
      tokens[i + 2].raw == "__mbt_slice_ro_join" || tokens[i + 2].raw == "__mbt_slice_ro_show") &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p > i + 3 {
        // Split depth-0 comma-separated arguments `(recv, lo, hi)`
        let s_args : Array[String] = []
        let mut recv_s = -1
        let mut recv_e = -1
        let mut ai = i + 4
        while ai < close_p {
          if tokens[ai].kind == TokenKind::Comma {
            ai = ai + 1
            continue
          }
          let mut ae = ai
          let mut ad = 0
          while ae < close_p {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace {
              ad = ad + 1
            } else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
              ad = ad - 1
            } else if ad == 0 && ak == TokenKind::Comma {
              break
            }
            ae = ae + 1
          }
          if ae > ai {
            if s_args.length() == 0 {
              recv_s = ai
              recv_e = ae
            }
            s_args.push(content.slice(tokens[ai].start_byte, tokens[ae - 1].end_byte).trim())
          }
          ai = ae + 1
        }
        if (s_args.length() == 3 || (s_args.length() == 4 && (tokens[i + 2].raw == "__mbt_slice_ro_join" || tokens[i + 2].raw == "__mbt_slice_owned"))) &&
        !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
          let raw_sh = tokens[i + 2].raw
          let pkind = if raw_sh == "__mbt_slice_owned" {
            "mbt_slice_owned_probe"
          } else if raw_sh == "__mbt_slice_ro_join" {
            "mbt_slice_ro_join_probe"
          } else if raw_sh == "__mbt_slice_ro_show" {
            "mbt_slice_ro_show_probe"
          } else {
            "mbt_slice_borrow_probe"
          }
          // A borrowed slice whose receiver is a proven-fresh allocation (inline, or the hygienic
          // `let __mbt_sl_N = <fresh>;` temp Stage A binds right before it) has no other owner, so a view
          // over a buffer of its own is exact: tag it for `rewrite_for_probe_hygienic`.
          let fresh_recv = pkind == "mbt_slice_borrow_probe" && recv_s >= 0 &&
          (is_proven_fresh_array_alloc(tokens, recv_s, recv_e) || slice_temp_bound_fresh(tokens, i, s_args[0]))
          let sep_arg = if s_args.length() == 4 { s_args[3] } else if fresh_recv { fresh_slice_recv_tag() } else { "" }
          let start_b = t.start_byte
          let end_b = tokens[close_p].end_byte
          sites.push(ProbeSite::{
            probe_id: "",
            file: file,
            probe_kind: pkind,
            start_byte: start_b,
            end_byte: end_b,
            op_byte: base_offset + tokens[i + 2].start_byte,
            line: t.line,
            col: t.col,
            lhs_expr: s_args[0],
            rhs_expr: s_args[1],
            assign_op: sep_arg,
            slice_hi: s_args[2],
            divisor_is_zero: false,
            rhs_has_lit: false,
            rhs_is_neg: false,
            rhs_u64: 0UL,
            rhs_overflow: false,
          })
          edits.push((start_b, end_b, "(" + s_args[0] + ")." + pkind + "(" + s_args[1] + ", " + s_args[2] + ")"))
          covered_end = end_b
          i = close_p + 1
          continue
        }
      }
    }

    // 0a2. E1-2 Layer 3: Stage A ambiguous match scrutinee placeholder `mbt_compat::__mbt_match_scrut(var, "<spec>")`
    if t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "__mbt_match_scrut" &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p > i + 3 && !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
        let m_args : Array[String] = []
        let mut ai = i + 4
        while ai < close_p {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < close_p {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if ae > ai {
            m_args.push(content.slice(tokens[ai].start_byte, tokens[ae - 1].end_byte).trim())
          }
          ai = ae + 1
        }
        if m_args.length() == 2 {
          let start_b = t.start_byte
          let end_b = tokens[close_p].end_byte
          sites.push(ProbeSite::{
            probe_id: "",
            file: file,
            probe_kind: "mbt_match_scrut_probe",
            start_byte: start_b,
            end_byte: end_b,
            op_byte: base_offset + tokens[i + 2].start_byte,
            line: t.line,
            col: t.col,
            lhs_expr: m_args[0],
            rhs_expr: m_args[1],
            assign_op: "",
            slice_hi: "",
            divisor_is_zero: false,
            rhs_has_lit: false,
            rhs_is_neg: false,
            rhs_u64: 0UL,
            rhs_overflow: false,
          })
          edits.push((start_b, end_b, "(" + m_args[0] + ").mbt_match_scrut_probe()"))
          covered_end = end_b
          i = close_p + 1
          continue
        }
      }
    }

    // 0a2b. Wave M2-F3b: `Show::to_string(x)` placeholder `mbt_compat::__mbt_show_trait(x)`, resolved by the
    //       exact type of `x` (`rewrite_for_probe_hygienic`, allowlist; everything else fails closed).
    if t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "__mbt_show_trait" &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      // `(x, "T1|pkg::T2|..")`: the last top-level argument is the allowlist string literal Stage A computed.
      let mut last_comma = -1
      let mut cd = 0
      let mut ck = i + 4
      while ck < close_p {
        let kk = tokens[ck].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { cd = cd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { cd = cd - 1 }
        else if cd == 0 && kk == TokenKind::Comma { last_comma = ck }
        ck = ck + 1
      }
      if last_comma > i + 4 && last_comma + 2 == close_p && tokens[last_comma + 1].kind == TokenKind::StringLit &&
      !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
        let arg = content.slice(tokens[i + 4].start_byte, tokens[last_comma - 1].end_byte).trim()
        let lit = tokens[last_comma + 1].raw
        let allow_list = if lit.length() >= 2 { lit.slice(1, lit.length() - 1) } else { "" }
        let start_b = t.start_byte
        let end_b = tokens[close_p].end_byte
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_show_trait_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: base_offset + tokens[i + 2].start_byte,
          line: t.line,
          col: t.col,
          lhs_expr: arg,
          rhs_expr: allow_list,
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, "(" + arg + ").mbt_show_trait_probe()"))
        covered_end = end_b
        i = close_p + 1
        continue
      }
    }

    // 0a3. Wave M2-F1: Stage A generic-context object-safe UFCS placeholder
    //      `mbt_compat::__mbt_ufcs_dispatch(recv, "<mname>", "<fwd_name>" [, rest_args...])`
    //      Probes the exact compiler-resolved type of `recv` to dispatch `dyn Trait` vs generic forwarder.
    if t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "__mbt_ufcs_dispatch" &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p > i + 3 && !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
        let u_args : Array[String] = []
        let u_arg_spans : Array[(Int, Int)] = []
        let u_arg_tok_spans : Array[(Int, Int)] = []
        let mut ai = i + 4
        while ai < close_p {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < close_p {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if ae > ai {
            let asb = tokens[ai].start_byte
            let aeb = tokens[ae - 1].end_byte
            u_args.push(content.slice(asb, aeb).trim())
            u_arg_spans.push((asb, aeb))
            u_arg_tok_spans.push((ai, ae))
          }
          ai = ae + 1
        }
        if u_args.length() >= 3 && has_nested_ufcs_dispatch(tokens, u_arg_tok_spans[0].0, u_arg_tok_spans[0].1) {
          // Only defer outer when `u_args[0]` (the receiver) itself contains a nested `__mbt_ufcs_dispatch`;
          // nested calls inside `rest_args` (e.g. unannotated closure callbacks) resolve in Round 2 AFTER
          // the outer call is lowered and supplies full contextual parameter types!
          let (asb, aeb) = u_arg_spans[0]
          let arg_txt = content.slice(asb, aeb)
          let (inst_arg, inner_sites) = instrument_probes_for_file_with_safe(
            file,
            arg_txt,
            safe_offsets,
            base_offset + asb,
            declared_values,
            declared_types,
            qual_values,
            qual_types,
            val_placeholders,
          )
          for isite in inner_sites {
            sites.push(ProbeSite::{
              probe_id: "",
              file: file,
              probe_kind: isite.probe_kind,
              start_byte: asb + isite.start_byte,
              end_byte: asb + isite.end_byte,
              op_byte: isite.op_byte,
              line: isite.line,
              col: isite.col,
              lhs_expr: isite.lhs_expr,
              rhs_expr: isite.rhs_expr,
              assign_op: isite.assign_op,
              slice_hi: isite.slice_hi,
              divisor_is_zero: isite.divisor_is_zero,
              rhs_has_lit: isite.rhs_has_lit,
              rhs_is_neg: isite.rhs_is_neg,
              rhs_u64: isite.rhs_u64,
              rhs_overflow: isite.rhs_overflow,
            })
          }
          let start_b = t.start_byte
          let end_b = tokens[close_p].end_byte
          edits.push((start_b, end_b, "({ let _ = (" + inst_arg + "); 0 })"))
          covered_end = end_b
          i = close_p + 1
          continue
        }
        if u_args.length() >= 3 {
          let mname_raw = u_args[1]
          let fwd_raw = u_args[2]
          let mname = if mname_raw.length() >= 2 && mname_raw.starts_with("\"") && mname_raw.ends_with("\"") {
            mname_raw.slice(1, mname_raw.length() - 1)
          } else {
            mname_raw
          }
          let fwd_name = if fwd_raw.length() >= 2 && fwd_raw.starts_with("\"") && fwd_raw.ends_with("\"") {
            fwd_raw.slice(1, fwd_raw.length() - 1)
          } else {
            fwd_raw
          }
          let rest_sb = StringBuilder()
          let mut ri = 3
          while ri < u_args.length() {
            if ri > 3 { rest_sb.write_string(", ") }
            rest_sb.write_string(u_args[ri])
            ri = ri + 1
          }
          let start_b = t.start_byte
          let end_b = tokens[close_p].end_byte
          sites.push(ProbeSite::{
            probe_id: "",
            file: file,
            probe_kind: "mbt_ufcs_probe",
            start_byte: start_b,
            end_byte: end_b,
            op_byte: base_offset + tokens[i + 2].start_byte,
            line: t.line,
            col: t.col,
            lhs_expr: u_args[0],
            rhs_expr: rest_sb.to_string(),
            assign_op: mname + "|" + fwd_name,
            slice_hi: "",
            divisor_is_zero: false,
            rhs_has_lit: false,
            rhs_is_neg: false,
            rhs_u64: 0UL,
            rhs_overflow: false,
          })
          edits.push((start_b, end_b, "(" + u_args[0] + ").mbt_ufcs_probe()"))
          covered_end = end_b
          i = close_p + 1
          continue
        }
      }
    }

    // 0b. Stage A `debug_inspect` placeholder `mbt_compat::__mbt_debug_fmt(expr)` -> `(expr).mbt_debug_probe()`
    if !slice_only_pass && t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "__mbt_debug_fmt" &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p > i + 4 && !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
        let arg_expr = content.slice(tokens[i + 4].start_byte, tokens[close_p - 1].end_byte).trim()
        let start_b = t.start_byte
        let end_b = tokens[close_p].end_byte
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_debug_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: base_offset + tokens[i + 2].start_byte,
          line: t.line,
          col: t.col,
          lhs_expr: arg_expr,
          rhs_expr: "",
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, "(" + arg_expr + ").mbt_debug_probe()"))
        covered_end = end_b
        i = close_p + 1
        continue
      }
    }

    // 0c. Stage A nested array-pattern type-gate placeholder `mbt_compat::__mbt_arrpat_len(expr)` -> `(expr).mbt_arrpat_len_probe()`
    if !slice_only_pass && t.kind == TokenKind::Ident && t.raw == "mbt_compat" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "__mbt_arrpat_len" &&
    tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p > i + 4 && !safe_offsets.contains(base_offset + tokens[i + 2].start_byte) {
        let arg_expr = content.slice(tokens[i + 4].start_byte, tokens[close_p - 1].end_byte).trim()
        let start_b = t.start_byte
        let end_b = tokens[close_p].end_byte
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_arrpat_len_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: base_offset + tokens[i + 2].start_byte,
          line: t.line,
          col: t.col,
          lhs_expr: arg_expr,
          rhs_expr: "",
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, "(" + arg_expr + ").mbt_arrpat_len_probe()"))
        covered_end = end_b
        i = close_p + 1
        continue
      }
    }

    if slice_only_pass && !((t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline) && has_nested_ufcs_dispatch(tokens, i, i + 1)) {
      i = i + 1
      continue
    }

    // 0b. Interpolated string `"...\{expr}..."` — recursively instrument ANY inner expression
    //     (e.g. `"r=\{a / b} len=\{s.length()}"`) AND probe simple idents for `Double` formatting!
    //     `$|` multiline interpolation lines are rebuilt the same way (prefix `$|`, no closing quote).
    if t.kind == TokenKind::InterpString || (t.kind == TokenKind::InterpMultiline && t.raw.starts_with("$|")) {
      let is_ml = t.kind == TokenKind::InterpMultiline
      let parts = split_interp_string(t.raw, is_ml)
      let mut any_interp_probe = false
      let rebuilt = StringBuilder()
      rebuilt.write_string(if is_ml { "$|" } else { "\"" })
      let mut part_off = t.start_byte + (if is_ml { 2 } else { 1 })
      for p in parts {
        if !p.is_expr {
          rebuilt.write_string(p.text)
          part_off = part_off + p.text.length()
        } else {
          // `p.text` sits inside `\{` ... `}`
          let expr_start_byte = part_off + 2
          let (inner_inst, inner_sites) = instrument_probes_for_file_with_safe(
            file,
            p.text,
            safe_offsets,
            base_offset + expr_start_byte,
            declared_values,
            declared_types,
            qual_values,
            qual_types,
            val_placeholders,
          )
          if inner_sites.length() > 0 {
            any_interp_probe = true
            for isite in inner_sites {
              sites.push(ProbeSite::{
                probe_id: "",
                file: file,
                probe_kind: isite.probe_kind,
                start_byte: expr_start_byte + isite.start_byte,
                end_byte: expr_start_byte + isite.end_byte,
                op_byte: isite.op_byte,
                line: t.line,
                col: t.col,
                lhs_expr: isite.lhs_expr,
                rhs_expr: isite.rhs_expr,
                assign_op: isite.assign_op,
                slice_hi: isite.slice_hi,
                divisor_is_zero: isite.divisor_is_zero,
                rhs_has_lit: isite.rhs_has_lit,
                rhs_is_neg: isite.rhs_is_neg,
                rhs_u64: isite.rhs_u64,
                rhs_overflow: isite.rhs_overflow,
              })
            }
            rebuilt.write_string("\\{" + inner_inst + "}")
          } else {
            let et = p.text.trim()
            let show_op_byte = base_offset + expr_start_byte
            // A plain `a.b.c` path is probed as is; any other expression (`self.f + self.f`, `get_f()`,
            // `-x`, `if c { a } else { b }`) is parenthesized so pionc reports the type of the whole hole.
            // A hole that is exactly one call of a MoonBit formatter (`mbt_compat::float_to_string(x)`) is skipped;
            // `mbt_compat::float_to_string(x) |> read` or `f(x).to_string()` are still probed as a whole.
            let simple = is_simple_ident_path(et)
            let already = is_whole_formatter_call(et)
            if !slice_only_pass && !safe_offsets.contains(show_op_byte) && et.length() > 0 && !already {
              any_interp_probe = true
              sites.push(ProbeSite::{
                probe_id: "",
                file: file,
                probe_kind: "mbt_show_probe",
                start_byte: expr_start_byte,
                end_byte: expr_start_byte + p.text.length(),
                op_byte: show_op_byte,
                line: t.line,
                col: t.col,
                lhs_expr: et,
                rhs_expr: "__INTERP_SHOW__",
                assign_op: "",
                slice_hi: "",
                divisor_is_zero: false,
                rhs_has_lit: false,
                rhs_is_neg: false,
                rhs_u64: 0UL,
                rhs_overflow: false,
              })
              rebuilt.write_string(if simple { "\\{" + et + ".mbt_show_probe()}" } else { "\\{(" + et + ").mbt_show_probe()}" })
            } else {
              rebuilt.write_string("\\{" + p.text + "}")
            }
          }
          part_off = part_off + 2 + p.text.length() + 1
        }
      }
      if !is_ml {
        rebuilt.write_string("\"")
      }
      if any_interp_probe {
        edits.push((t.start_byte, t.end_byte, rebuilt.to_string()))
        covered_end = t.end_byte
        i = i + 1
        continue
      }
      if slice_only_pass {
        i = i + 1
        continue
      }
    }

    // 1. `<recv>.length()` -> `<recv>.mbt_len_probe()`
    //    (Opus Round 4 P0 + Round 6 P1: NEVER skip when followed by `*`/`/`/`%` OR on `mbt_compat::*` calls
    //    such as `mbt_compat::arr_filter(xs, f).length()` / `mbt_compat::utf16_slice(s, 0, 2).length()`!)
    if t.kind == TokenKind::Dot && i + 3 < n &&
    tokens[i + 1].raw == "length" &&
    tokens[i + 2].kind == TokenKind::LParen &&
    tokens[i + 3].kind == TokenKind::RParen {
      let op_b = base_offset + tokens[i + 1].start_byte
      let recv_start = find_receiver_start(tokens, i - 1)
      if !safe_offsets.contains(op_b) && recv_start >= 0 && tokens[recv_start].start_byte >= covered_end && !is_non_expr_receiver(tokens, recv_start) {
        let start_b = tokens[recv_start].start_byte
        let end_b = tokens[i + 3].end_byte
        let recv_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_len_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: tokens[i + 1].line,
          col: tokens[i + 1].col,
          lhs_expr: recv_expr,
          rhs_expr: "",
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, recv_expr + ".mbt_len_probe()"))
        covered_end = end_b
        i = i + 4
        continue
      }
    }

    // 1b. `<recv>.code_unit_at(<idx>)` -> `<recv>.mbt_code_unit_at_probe(<idx>)`
    //     Routes `String::code_unit_at(i)` to `mbt_compat::utf16_code_unit_at_u16(s, i)`
    //     while leaving non-`String` receivers (e.g. `Bytes`) intact.
    if t.kind == TokenKind::Dot && i + 3 < n &&
    tokens[i + 1].raw == "code_unit_at" &&
    tokens[i + 2].kind == TokenKind::LParen {
      let op_b = base_offset + tokens[i + 1].start_byte
      let close_p = find_matching_delim(tokens, i + 2)
      let recv_start = find_receiver_start(tokens, i - 1)
      let mut arg_count = 0
      let mut has_empty_mid = false
      let mut arg_s = i + 3
      let mut arg_e = -1
      if close_p > i + 3 {
        let mut seg_s = i + 3
        let mut d = 0
        let mut k = i + 3
        while k <= close_p {
          if k == close_p || (d == 0 && tokens[k].kind == TokenKind::Comma) {
            if k > seg_s {
              arg_count = arg_count + 1
              if arg_count == 1 {
                arg_s = seg_s
                arg_e = k
              }
            } else if k < close_p {
              has_empty_mid = true
            }
            seg_s = k + 1
          } else {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
              d = d + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
              if d > 0 { d = d - 1 }
            }
          }
          k = k + 1
        }
      }
      if !safe_offsets.contains(op_b) && !has_empty_mid && arg_count == 1 && arg_e > arg_s &&
      recv_start >= 0 && tokens[recv_start].start_byte >= covered_end &&
      !is_non_expr_receiver(tokens, recv_start) {
        let start_b = tokens[recv_start].start_byte
        let end_b = tokens[close_p].end_byte
        let recv_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        let arg_expr = content.slice(tokens[arg_s].start_byte, tokens[arg_e - 1].end_byte).trim()
        let safe_u16 = is_safe_code_unit_at_context(tokens, recv_start, close_p)
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_code_unit_at_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: tokens[i + 1].line,
          col: tokens[i + 1].col,
          lhs_expr: recv_expr,
          rhs_expr: arg_expr,
          assign_op: if safe_u16 { "safe_u16" } else { "" },
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, recv_expr + ".mbt_code_unit_at_probe(" + arg_expr + ")"))
        covered_end = end_b
        i = close_p + 1
        continue
      }
    }

    // 2. `<recv>.to_string()` -> `<recv>.mbt_show_probe()`
    if t.kind == TokenKind::Dot && i + 3 < n &&
    tokens[i + 1].raw == "to_string" &&
    tokens[i + 2].kind == TokenKind::LParen &&
    tokens[i + 3].kind == TokenKind::RParen {
      let op_b = base_offset + tokens[i + 1].start_byte
      let recv_start = find_receiver_start(tokens, i - 1)
      if !safe_offsets.contains(op_b) && recv_start >= 0 && tokens[recv_start].start_byte >= covered_end && !is_non_expr_receiver(tokens, recv_start) {
        let start_b = tokens[recv_start].start_byte
        let end_b = tokens[i + 3].end_byte
        let recv_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_show_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: tokens[i + 1].line,
          col: tokens[i + 1].col,
          lhs_expr: recv_expr,
          rhs_expr: "",
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, recv_expr + ".mbt_show_probe()"))
        covered_end = end_b
        i = i + 4
        continue
      }
    }

    // 3. `<recv>.<val_placeholder>` (or legacy `<recv>.val`) read/write/compound-write
    if t.kind == TokenKind::Dot && i + 1 < n &&
    (val_placeholders.contains(tokens[i + 1].raw) || tokens[i + 1].raw == "val") {
      let op_b = base_offset + tokens[i + 1].start_byte
      let recv_start = find_receiver_start(tokens, i - 1)
      if !safe_offsets.contains(op_b) && recv_start >= 0 && tokens[recv_start].start_byte >= covered_end && !is_non_expr_receiver(tokens, recv_start) {
        let start_b = tokens[recv_start].start_byte
        let recv_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        if i + 2 < n && (tokens[i + 2].kind == TokenKind::Eq || tokens[i + 2].kind == TokenKind::AssignOp) {
          let rhs_end = find_expr_end(tokens, i + 3, n)
          if rhs_end > i + 3 {
            let end_b = tokens[rhs_end - 1].end_byte
            let rhs_expr = content.slice(tokens[i + 3].start_byte, end_b).trim()
            let aop = if tokens[i + 2].kind == TokenKind::Eq {
              "="
            } else {
              let rraw = tokens[i + 2].raw
              if rraw.ends_with("=") && rraw.length() > 1 { rraw.slice(0, rraw.length() - 1) } else { rraw }
            }
            sites.push(ProbeSite::{
              probe_id: "",
              file: file,
              probe_kind: "mbt_val_set_probe",
              start_byte: start_b,
              end_byte: end_b,
              op_byte: op_b,
              line: tokens[i + 1].line,
              col: tokens[i + 1].col,
              lhs_expr: recv_expr,
              rhs_expr: rhs_expr,
              assign_op: aop,
              slice_hi: "",
              divisor_is_zero: false,
              rhs_has_lit: false,
              rhs_is_neg: false,
              rhs_u64: 0UL,
              rhs_overflow: false,
            })
            let probed_rhs = probe_nested_val_reads(rhs_expr, val_placeholders)
            let probed_lhs = probe_nested_val_reads(recv_expr, val_placeholders)
            edits.push((start_b, end_b, probed_lhs + ".mbt_val_set_probe(" + probed_rhs + ")"))
            covered_end = end_b
            i = rhs_end
            continue
          }
        }
        let end_b = tokens[i + 1].end_byte
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_val_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: tokens[i + 1].line,
          col: tokens[i + 1].col,
          lhs_expr: recv_expr,
          rhs_expr: "",
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, recv_expr + ".mbt_val_probe()"))
        covered_end = end_b
        i = i + 2
        continue
      }
    }

    // 4. `<recv>[<idx>]` -> `<recv>.mbt_idx_probe(<idx>)`
    //    (Opus Round 4 P0: NEVER skip when followed by `*`/`/`/`%` or `.length()`/`.to_string()`/`.val` —
    //    `safe_offsets` ensures outer probes run cleanly in subsequent rounds!
    //    NEVER treat a newline-leading `[a, b]` array literal after a previous statement as indexing!)
    if t.kind == TokenKind::LBracket && i > 0 && !t.newline_before {
      let op_b = base_offset + t.start_byte
      let close_br = find_matching_delim(tokens, i)
      let next_is_eq = close_br + 1 < n && tokens[close_br + 1].kind == TokenKind::Eq
      let recv_start = find_receiver_start(tokens, i - 1)
      if !safe_offsets.contains(op_b) && !next_is_eq && recv_start >= 0 && close_br > i + 1 &&
      tokens[recv_start].start_byte >= covered_end &&
      !is_type_arg_brackets(tokens, i, declared_values, declared_types, qual_values, qual_types) &&
      !is_non_expr_receiver(tokens, recv_start) {
        let start_b = tokens[recv_start].start_byte
        let end_b = tokens[close_br].end_byte
        let recv_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        let idx_expr = content.slice(tokens[i + 1].start_byte, tokens[close_br - 1].end_byte).trim()
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: "mbt_idx_probe",
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: t.line,
          col: t.col,
          lhs_expr: recv_expr,
          rhs_expr: idx_expr,
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: false,
          rhs_has_lit: false,
          rhs_is_neg: false,
          rhs_u64: 0UL,
          rhs_overflow: false,
        })
        edits.push((start_b, end_b, recv_expr + ".mbt_idx_probe(" + idx_expr + ")"))
        covered_end = end_b
        i = close_br + 1
        continue
      }
    }

    // 5. `<lhs> / <rhs>` or `<lhs> % <rhs>`:
    //    - Parses full left-associative `*` LHS chain (e.g. `a * b / c` -> `(a * b) / c`)
    //    - Parses unary/postfix RHS (e.g. `a / -b`, `a / (b - c)`, `a / -0x1`, `a / 0xffffffff`)
    //    - Records exact parsed `UInt64` magnitude & sign without deciding omission until `resolved_type` is known!
    if (t.kind == TokenKind::Slash || t.kind == TokenKind::Percent) && i > 0 && i + 1 < n {
      let op_b = base_offset + t.start_byte
      if safe_offsets.contains(op_b) {
        i = i + 1
        continue
      }
      let lhs_start = find_mul_lhs_start(tokens, i - 1)
      let rhs_end = find_rhs_end(tokens, i + 1, n)
      if lhs_start >= 0 && rhs_end >= i + 1 && tokens[lhs_start].start_byte >= covered_end && !is_non_expr_receiver(tokens, lhs_start) {
        let is_mod = t.kind == TokenKind::Percent
        let pkind = if is_mod { "mbt_mod_probe" } else { "mbt_div_probe" }
        let rhs_lit_idx = if rhs_end == i + 1 && (tokens[i + 1].kind == TokenKind::IntLit || tokens[i + 1].kind == TokenKind::FloatLit) {
          i + 1
        } else if rhs_end == i + 2 && (tokens[i + 1].kind == TokenKind::Minus || tokens[i + 1].kind == TokenKind::Plus) &&
        (tokens[i + 2].kind == TokenKind::IntLit || tokens[i + 2].kind == TokenKind::FloatLit) {
          i + 2
        } else {
          -1
        }
        let start_b = tokens[lhs_start].start_byte
        let end_b = tokens[rhs_end].end_byte
        let lhs_expr = content.slice(start_b, tokens[i - 1].end_byte).trim()
        let rhs_expr = content.slice(tokens[i + 1].start_byte, end_b).trim()
        let is_zero = (rhs_lit_idx >= 0 && is_statically_zero_literal(tokens[rhs_lit_idx])) || is_byte_zero_expr(rhs_expr)
        let is_neg = rhs_end == i + 2 && tokens[i + 1].kind == TokenKind::Minus
        let mut has_int_lit = false
        let mut mag_u64 : UInt64 = 0UL
        let mut ovf = false
        if rhs_lit_idx >= 0 && tokens[rhs_lit_idx].kind == TokenKind::IntLit {
          match parse_int_literal_u64(tokens[rhs_lit_idx]) {
            Some((v, o)) => {
              has_int_lit = true
              mag_u64 = v
              ovf = o
            }
            None => ()
          }
        }
        sites.push(ProbeSite::{
          probe_id: "",
          file: file,
          probe_kind: pkind,
          start_byte: start_b,
          end_byte: end_b,
          op_byte: op_b,
          line: t.line,
          col: t.col,
          lhs_expr: lhs_expr,
          rhs_expr: rhs_expr,
          assign_op: "",
          slice_hi: "",
          divisor_is_zero: is_zero,
          rhs_has_lit: has_int_lit,
          rhs_is_neg: is_neg,
          rhs_u64: mag_u64,
          rhs_overflow: ovf,
        })
        edits.push((start_b, end_b, "(" + lhs_expr + ")." + pkind + "(" + rhs_expr + ")"))
        covered_end = end_b
        i = rhs_end + 1
        continue
      }
    }

    i = i + 1
  }

  let instrumented = apply_byte_edits(content, edits)
  (instrumented, sites)
}

///| Check whether `resolved_type` strictly matches `[ref].type_name` or default `mbt_compat::Ref`.
fn is_recipe_ref_type(resolved_type : String, recipes : Recipes) -> Bool {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.type_name.length() > 0 {
    let tn = recipes.ref_recipe.type_name
    return resolved_type == tn || resolved_type.starts_with(tn + "[")
  }
  resolved_type == "mbt_compat::Ref" || resolved_type.starts_with("mbt_compat::Ref[") ||
  resolved_type == "Ref" || resolved_type.starts_with("Ref[")
}

///| Strip trailing generic arguments `[...]` from a resolved type name.
fn strip_type_args(ty : String) -> String {
  let br = ty.index_of("[")
  if br > 0 { ty.slice(0, br).trim() } else { ty.trim() }
}

///| Check whether an expression is a pure simple identifier (safe to repeat without side effects).
fn is_simple_ident_expr(expr : String) -> Bool {
  let s = expr.trim()
  if s.length() == 0 {
    return false
  }
  let c0 = s.code_unit_at(0)
  if !is_alpha(c0) {
    return false
  }
  let mut i = 1
  while i < s.length() {
    if !is_alnum(s.code_unit_at(i)) {
      return false
    }
    i = i + 1
  }
  true
}

///| Recursively synthesize MoonBit `Debug`-compatible formatting expression for `expr : ty`.
///| Returns `None` for unsupported user structs/enums/unknown types (caller fails closed).
fn gen_debug_fmt_expr(expr : String, ty : String, depth : Int) -> Option[String] {
  let t = ty.trim()
  if t == "String" {
    return Some("mbt_compat::debug_string(" + expr + ")")
  }
  if t == "Char" {
    return Some("mbt_compat::debug_char(" + expr + ")")
  }
  if t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Bool" || t == "Float" {
    return Some("(" + expr + ").to_string()")
  }
  if t == "Byte" {
    return Some("mbt_compat::debug_byte(" + expr + ")")
  }
  if t == "Double" {
    return Some("mbt_compat::double_to_string(" + expr + ")")
  }
  if t == "Unit" {
    return Some("({ let _ = " + expr + "; \"()\" })")
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ov = "__mbt_dbg_o_" + depth.to_string()
    match gen_debug_fmt_expr(ov, inner, depth + 1) {
      Some(ifmt) =>
      return Some("match (" + expr + ") { Some(" + ov + ") => \"Some(\" + (" + ifmt + ") + \")\", None => \"None\" }")
      None => return None
    }
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let av = "__mbt_dbg_a_" + depth.to_string()
    let iv = "__mbt_dbg_i_" + depth.to_string()
    let sbv = "__mbt_dbg_sb_" + depth.to_string()
    match gen_debug_fmt_expr(av + "[" + iv + "]", inner, depth + 1) {
      Some(efmt) =>
      return Some(
        "{ let " + av + " = " + expr + "; let " + sbv + " = StringBuilder(); " + sbv + ".write_string(\"[\"); let mut " + iv + " = 0; while " + iv + " < " + av + ".length() { if " + iv + " > 0 { " + sbv + ".write_string(\", \") }; " + sbv + ".write_string(" + efmt + "); " + iv + " = " + iv + " + 1 }; " + sbv + ".write_string(\"]\"); " + sbv + ".to_string() }",
      )
      None => return None
    }
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let tv = "__mbt_dbg_t_" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let " + tv + " = " + expr + "; \"(\"")
      let mut k = 0
      while k < elems.length() {
        match gen_debug_fmt_expr(tv + "." + k.to_string(), elems[k], depth * 10 + k + 1) {
          Some(efmt) => {
            if k > 0 { sb.write_string(" + \", \"") }
            sb.write_string(" + (" + efmt + ")")
          }
          None => return None
        }
        k = k + 1
      }
      sb.write_string(" + \")\" }")
      return Some(sb.to_string())
    }
  }
  None
}

///| Compute the rewritten expression for a single `(ProbeSite, resolved_type)` pair.
///| Returns `Some(replacement)` if a rewrite is needed, or `None` if original code stays untouched.
pub fn rewrite_for_probe(
  site : ProbeSite,
  resolved_type : String,
  recipes : Recipes,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Option[String] {
  rewrite_for_probe_with_fields(site, resolved_type, recipes, Map(), diags, drift_ledger)
}

///| Replace nested non-assignment `.val` / registered placeholder reads inside an expression
///| with `.mbt_val_probe()` so outer `.mbt_val_set_probe(...)` checks cleanly.
fn probe_nested_val_reads(expr : String, val_placeholders : Map[String, Bool]) -> String {
  if !str_has(expr, ".") {
    return expr
  }
  let toks = lex_moonbit(expr)
  let tn = toks.length() - 1
  let edits : Array[(Int, Int, String)] = []
  let mut i = 0
  while i + 1 < tn {
    if toks[i].kind == TokenKind::Dot &&
    (val_placeholders.contains(toks[i + 1].raw) || toks[i + 1].raw == "val") {
      let is_nested_assign = i + 2 < tn &&
      (toks[i + 2].kind == TokenKind::Eq || toks[i + 2].kind == TokenKind::AssignOp)
      if !is_nested_assign {
        edits.push((toks[i].start_byte, toks[i + 1].end_byte, ".mbt_val_probe()"))
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  if edits.length() == 0 {
    expr
  } else {
    apply_byte_edits(expr, edits)
  }
}

pub fn rewrite_for_probe_with_fields(
  site : ProbeSite,
  resolved_type : String,
  recipes : Recipes,
  struct_val_fields : Map[String, String],
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Option[String] {
  rewrite_for_probe_hygienic(site, resolved_type, recipes, struct_val_fields, Map(), diags, drift_ledger)
}

///| Strict freshness for borrowed-slice views: `[s, e)` is exactly an array literal `[...]` or a call of an
///| `mbt_compat` helper that always returns a newly allocated `Array` (Stage B rewrites the builtin
///| `Array::copy`/`map`/`filter`/... to these). Unlike `is_fresh_container_alloc`, a method call such as
///| `x.copy()` is never trusted: a user-defined `copy` may return an alias.
fn is_proven_fresh_array_alloc(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e {
    return false
  }
  if tokens[s].kind == TokenKind::LBracket && find_matching_delim(tokens, s) == e - 1 {
    return true
  }
  if e >= s + 5 && tokens[s].kind == TokenKind::Ident && tokens[s].raw == "mbt_compat" &&
  tokens[s + 1].kind == TokenKind::ColonColon && tokens[s + 3].kind == TokenKind::LParen &&
  find_matching_delim(tokens, s + 3) == e - 1 {
    let nm = tokens[s + 2].raw
    // Not `arr_to_array`: it is the identity (`.to_array()` of an already lowered slice) and returns its argument.
    return nm == "arr_copy" || nm == "array_slice_clamp" || nm == "arr_concat" || nm == "arr_filter" ||
    nm == "arr_filter_map" || nm == "arr_map"
  }
  false
}

///| True iff `et` is a plain `a.b.c` path: a letter first, then only `[A-Za-z0-9_.]`, no empty segment and no
///| trailing `.` (so `x|>f`, `f==f`, `a+b`, `arr[0]` are not paths and get parenthesized as a whole).
fn is_simple_ident_path(et : String) -> Bool {
  if et.length() == 0 || !is_alpha(et.code_unit_at(0)) || et.ends_with(".") || str_has(et, "..") {
    return false
  }
  for k in 0..<et.length() {
    let c = et.code_unit_at(k)
    if !(is_alnum(c) || c == 46) {
      return false
    }
  }
  true
}

///| True iff `et` is exactly one call `mbt_compat::{double,float,bytes,byte}_to_string(...)`: the `(` after the
///| name is matched (skipping string / char literals) by the final character of `et`.
fn is_whole_formatter_call(et : String) -> Bool {
  let mut open = -1
  for pre in ["mbt_compat::double_to_string(", "mbt_compat::float_to_string(", "mbt_compat::bytes_to_string(",
    "mbt_compat::byte_to_string(", "mbt_compat::mbt_json_to_string("] {
    if et.starts_with(pre) {
      open = pre.length() - 1
    }
  }
  if open < 0 {
    return false
  }
  let mut d = 0
  let mut k = open
  while k < et.length() {
    let c = et.code_unit_at(k)
    if c == 34 || c == 39 {
      // skip a string / char literal (with `\` escapes)
      k = k + 1
      while k < et.length() && et.code_unit_at(k) != c {
        if et.code_unit_at(k) == 92 { k = k + 1 }
        k = k + 1
      }
    } else if c == 40 {
      d = d + 1
    } else if c == 41 {
      d = d - 1
      if d == 0 {
        return k == et.length() - 1
      }
    }
    k = k + 1
  }
  false
}

///| `mbt_compat` formatter reproducing MoonBit's `to_string` / `Show` for builtin types whose Pion
///| `to_string()` prints differently (`Double` is handled by its own branch).
fn moonbit_show_helper(ty : String) -> Option[String] {
  if ty == "Float" {
    Some("mbt_compat::float_to_string")
  } else if ty == "Bytes" {
    Some("mbt_compat::bytes_to_string")
  } else if ty == "Byte" {
    Some("mbt_compat::byte_to_string")
  } else if ty == "MbtJson" || ty == "mbt_compat::MbtJson" {
    Some("mbt_compat::mbt_json_to_string")
  } else {
    None
  }
}

///| Builtin types whose Pion `to_string()` prints exactly what MoonBit's `Show::to_string` prints. User types are
///| accepted only through the Stage A allowlist (a transpiled `impl Show ... with output` without an inherent
///| `fn T::to_string`); everything else (`Float`, `Byte`, `Bytes`, views, containers, tuples, generics) fails closed.
fn is_show_trait_exact_type(ty : String) -> Bool {
  ty == "Int" || ty == "Int64" || ty == "UInt" || ty == "UInt64" || ty == "Bool" || ty == "Char" || ty == "String"
}

///| `assign_op` tag of a `mbt_slice_borrow_probe` site whose receiver is a proven-fresh allocation.
fn fresh_slice_recv_tag() -> String {
  "\"__FRESH_RECV__\""
}

///| True iff `name` is a Stage A hygienic slice temp (`__mbt_sl_N`) bound immediately before token `i` as
///| `let name = <init>;` with `<init>` a proven-fresh array allocation (`is_proven_fresh_array_alloc`).
fn slice_temp_bound_fresh(tokens : Array[Token], i : Int, name : String) -> Bool {
  if !name.starts_with("__mbt_sl_") || i < 5 || tokens[i - 1].kind != TokenKind::Semi {
    return false
  }
  // Walk back over the initializer to the matching `let name =` at the same nesting depth.
  let mut k = i - 2
  let mut d = 0
  while k >= 2 {
    let kk = tokens[k].kind
    if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d + 1
    } else if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 { return false }
      d = d - 1
    } else if d == 0 && kk == TokenKind::Semi {
      return false
    } else if d == 0 && kk == TokenKind::Eq && tokens[k - 1].kind == TokenKind::Ident && tokens[k - 1].raw == name &&
    tokens[k - 2].kind == TokenKind::Keyword && tokens[k - 2].raw == "let" {
      return is_proven_fresh_array_alloc(tokens, k + 1, i - 1)
    }
    k = k - 1
  }
  false
}

fn rewrite_for_probe_hygienic(
  site : ProbeSite,
  resolved_type : String,
  recipes : Recipes,
  struct_val_fields : Map[String, String],
  used_idents : Map[String, Bool],
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Option[String] {
  if site.probe_kind == "mbt_len_probe" {
    if resolved_type == "String" {
      drift_ledger.push(DriftEntry::{
        category: "string_utf16_len",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: site.lhs_expr + ".length()",
        resolution: "mbt_compat::utf16_len",
        status: "resolved",
        detail: "String.length() routed to UTF-16 code-unit length",
      })
      return Some("mbt_compat::utf16_len(" + site.lhs_expr + ")")
    }
    return None
  }

  if site.probe_kind == "mbt_idx_probe" {
    if resolved_type == "String" {
      drift_ledger.push(DriftEntry::{
        category: "string_utf16_index",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: site.lhs_expr + "[" + site.rhs_expr + "]",
        resolution: "mbt_compat::utf16_code_unit_at",
        status: "resolved",
        detail: "String[i] routed to UTF-16 code unit access",
      })
      return Some("mbt_compat::utf16_code_unit_at(" + site.lhs_expr + ", " + site.rhs_expr + ")")
    }
    if resolved_type.starts_with("OrderedMap[") || resolved_type.starts_with("mbt_compat::OrderedMap[") {
      return Some("mbt_compat::opt_unwrap(" + site.lhs_expr + ".get(" + site.rhs_expr + "))")
    }
    if resolved_type.starts_with("ArrayView[") || resolved_type.starts_with("mbt_compat::ArrayView[") ||
    resolved_type.starts_with("ArrayBuf[") || resolved_type.starts_with("mbt_compat::ArrayBuf[") {
      return Some(site.lhs_expr + ".get(" + site.rhs_expr + ")")
    }
    return None
  }

  if site.probe_kind == "mbt_code_unit_at_probe" {
    if resolved_type == "String" {
      if site.assign_op != "safe_u16" {
        diags.push(diag_error(
          "MBT2PION_UINT16_ESCAPE",
          site.file,
          site.line,
          site.col,
          "String::code_unit_at(i) in unchecked UInt16 context (arithmetic/binding/escape) is not supported (fail-closed)",
        ))
        drift_ledger.push(DriftEntry::{
          category: "string_utf16_code_unit_at",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: site.lhs_expr + ".code_unit_at(" + site.rhs_expr + ")",
          resolution: "blocked",
          status: "unresolved",
          detail: "String.code_unit_at(i) outside safe UInt16 context",
        })
        return None
      }
      drift_ledger.push(DriftEntry::{
        category: "string_utf16_code_unit_at",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: site.lhs_expr + ".code_unit_at(" + site.rhs_expr + ")",
        resolution: "mbt_compat::utf16_code_unit_at",
        status: "resolved",
        detail: "String.code_unit_at(i) routed to UTF-16 code unit access",
      })
      return Some("mbt_compat::utf16_code_unit_at(" + site.lhs_expr + ", " + site.rhs_expr + ")")
    }
    return None
  }

  if site.probe_kind == "mbt_div_probe" || site.probe_kind == "mbt_mod_probe" {
    let is_mod = site.probe_kind == "mbt_mod_probe"
    if is_float_type(resolved_type) {
      return None
    }
    if is_unsupported_int_type(resolved_type) {
      diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_INT_DIV",
        site.file,
        site.line,
        site.col,
        "unsupported integer type `" + resolved_type + "` for checked division/modulo",
      ))
      drift_ledger.push(DriftEntry::{
        category: "int_div_zero",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: site.lhs_expr + (if is_mod { " % " } else { " / " }) + site.rhs_expr,
        resolution: "blocked",
        status: "unresolved",
        detail: "unsupported integer type " + resolved_type,
      })
      return None
    }
    match checked_div_helper(resolved_type, is_mod) {
      Some(helper) => {
        if site.divisor_is_zero {
          let trap_call = if is_mod { "mbt_compat::trap_rem_zero()" } else { "mbt_compat::trap_div_zero()" }
          drift_ledger.push(DriftEntry::{
            category: "int_div_zero",
            file: site.file,
            line: site.line,
            col: site.col,
            expr: site.lhs_expr + (if is_mod { " % 0" } else { " / 0" }),
            resolution: trap_call,
            status: "resolved",
            detail: "statically known zero divisor on " + resolved_type + " lowered to explicit trap",
          })
          return Some("{ let _ = " + site.lhs_expr + "; " + trap_call + " }")
        }
        if can_omit_div_check(resolved_type, site) {
          // Supported integer type with strictly bit-width/signedness-proven safe constant divisor: omit runtime check
          return None
        }
        drift_ledger.push(DriftEntry::{
          category: "int_div_zero",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: site.lhs_expr + (if is_mod { " % " } else { " / " }) + site.rhs_expr,
          resolution: helper,
          status: "resolved",
          detail: "runtime divisor on " + resolved_type + " lowered to checked helper (wasm-gc trap oracle)",
        })
        return Some(helper + "(" + site.lhs_expr + ", " + site.rhs_expr + ")")
      }
      None => return None
    }
  }

  if site.probe_kind == "mbt_show_probe" {
    if resolved_type == "Double" {
      drift_ledger.push(DriftEntry::{
        category: "double_to_string",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: if site.rhs_expr == "__INTERP_SHOW__" { "\\{" + site.lhs_expr + "}" } else { site.lhs_expr + ".to_string()" },
        resolution: "mbt_compat::double_to_string",
        status: "resolved",
        detail: "Double formatting routed to MoonBit-compatible formatter",
      })
      return Some("mbt_compat::double_to_string(" + site.lhs_expr + ")")
    }
    match moonbit_show_helper(resolved_type) {
      Some(helper) => {
        drift_ledger.push(DriftEntry::{
          category: "show_to_string",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: if site.rhs_expr == "__INTERP_SHOW__" { "\\{" + site.lhs_expr + "}" } else { site.lhs_expr + ".to_string()" },
          resolution: helper,
          status: "resolved",
          detail: resolved_type + " formatting routed to MoonBit-compatible formatter",
        })
        return Some(helper + "(" + site.lhs_expr + ")")
      }
      None => ()
    }
    return None
  }

  if site.probe_kind == "mbt_show_trait_probe" {
    let expr_desc = "Show::to_string(" + site.lhs_expr + ")"
    if resolved_type == "Double" {
      drift_ledger.push(DriftEntry::{
        category: "show_trait_to_string",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: expr_desc,
        resolution: "mbt_compat::double_to_string",
        status: "resolved",
        detail: "Show::to_string on Double routed to MoonBit-compatible formatter",
      })
      return Some("mbt_compat::double_to_string(" + site.lhs_expr + ")")
    }
    match moonbit_show_helper(resolved_type) {
      Some(helper) => {
        drift_ledger.push(DriftEntry::{
          category: "show_trait_to_string",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: helper,
          status: "resolved",
          detail: "Show::to_string on " + resolved_type + " routed to MoonBit-compatible formatter",
        })
        return Some(helper + "(" + site.lhs_expr + ")")
      }
      None => ()
    }
    let mut user_show = false
    for an in site.rhs_expr.split("|") {
      if an.length() > 0 && an == resolved_type {
        user_show = true
      }
    }
    if is_show_trait_exact_type(resolved_type) || user_show {
      drift_ledger.push(DriftEntry::{
        category: "show_trait_to_string",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: expr_desc,
        resolution: "to_string",
        status: "resolved",
        detail: if user_show {
          "Show::to_string on " + resolved_type + " calls its transpiled `impl Show` (no inherent to_string)"
        } else {
          "Show::to_string on " + resolved_type + " has identical Pion to_string output"
        },
      })
      return Some("(" + site.lhs_expr + ").to_string()")
    }
    diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      site.file,
      site.line,
      site.col,
      "`" + expr_desc + "` on type `" + resolved_type + "` has no MoonBit-exact lowering (fail-closed)",
    ))
    drift_ledger.push(DriftEntry::{
      category: "show_trait_to_string",
      file: site.file,
      line: site.line,
      col: site.col,
      expr: expr_desc,
      resolution: "blocked",
      status: "unresolved",
      detail: "Show::to_string on unsupported type " + resolved_type,
    })
    return Some("\"\"")
  }

  if site.probe_kind == "mbt_debug_probe" {
    match gen_debug_fmt_expr(site.lhs_expr, resolved_type, 0) {
      Some(fmt_expr) => {
        drift_ledger.push(DriftEntry::{
          category: "debug_inspect",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: "debug_inspect(" + site.lhs_expr + ")",
          resolution: "mbt_compat::debug_fmt(" + resolved_type + ")",
          status: "resolved",
          detail: "debug_inspect formatted with MoonBit Debug semantics for " + resolved_type,
        })
        return Some(fmt_expr)
      }
      None => {
        diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          site.file,
          site.line,
          site.col,
          "debug_inspect does not support MoonBit Debug formatting for type `" + resolved_type + "` (fail-closed; refusing silent `.to_string()` fallback)",
        ))
        drift_ledger.push(DriftEntry::{
          category: "debug_inspect",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: "debug_inspect(" + site.lhs_expr + ")",
          resolution: "blocked",
          status: "unresolved",
          detail: "unsupported Debug type " + resolved_type,
        })
        return Some("\"\"")
      }
    }
  }

  if site.probe_kind == "mbt_arrpat_len_probe" {
    let t = resolved_type.trim()
    if t.starts_with("Array[") || t.starts_with("FixedArray[") || t.starts_with("ArrayView[") ||
    t.starts_with("mbt_compat::ArrayView[") || t.starts_with("ArrayBuf[") || t.starts_with("mbt_compat::ArrayBuf[") {
      return Some("(" + site.lhs_expr + ").length()")
    }
    diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      site.file,
      site.line,
      site.col,
      "array pattern matching on `" + t + "` is not supported (only Array/FixedArray/ArrayView)",
    ))
    return Some("0")
  }

  if site.probe_kind == "mbt_ufcs_probe" {
    let sep = site.assign_op.index_of("|")
    if sep > 0 {
      let mname = site.assign_op.slice(0, sep)
      let fwd_name = site.assign_op.slice(sep + 1, site.assign_op.length())
      if resolved_type.starts_with("dyn ") {
        return Some("(" + site.lhs_expr + ")." + mname + "(" + site.rhs_expr + ")")
      }
      let all_args = if site.rhs_expr.length() > 0 {
        site.lhs_expr + ", " + site.rhs_expr
      } else {
        site.lhs_expr
      }
      return Some(fwd_name + "(" + all_args + ")")
    }
    return None
  }

  if site.probe_kind == "mbt_match_scrut_probe" {
    let base_ty = strip_type_args(resolved_type)
    let spec_str = match json::parse(site.rhs_expr) {
      Ok(sv) => match json::as_str(sv) { Some(s) => s, None => "" }
      Err(_) => ""
    }
    let spec_opt = match json::parse(spec_str) {
      Ok(v) => Some(v)
      Err(_) => None
    }
    match spec_opt {
      Some(spec) => {
        let ms_var = match json::obj_get(spec, "v") {
          Some(vv) => match json::as_str(vv) { Some(s) => s, None => site.lhs_expr }
          None => site.lhs_expr
        }
        let incomplete = match json::obj_get(spec, "incomplete") {
          Some(iv) => match json::as_bool(iv) { Some(b) => b, None => false }
          None => false
        }
        let arms_arr = match json::obj_get(spec, "arms") {
          Some(av) => match json::as_arr(av) { Some(xs) => xs, None => [] }
          None => []
        }
        let cand_opt = match json::obj_get(spec, "cands") {
          Some(cv) => json::obj_get(cv, base_ty)
          None => None
        }
        match cand_opt {
          Some(cobj) => {
            let is_ok = match json::obj_get(cobj, "ok") {
              Some(ov) => match json::as_bool(ov) { Some(b) => b, None => false }
              None => false
            }
            if is_ok {
              let pats_arr = match json::obj_get(cobj, "pats") {
                Some(pv) => match json::as_arr(pv) { Some(xs) => xs, None => [] }
                None => []
              }
              if pats_arr.length() == arms_arr.length() {
                let msb = StringBuilder()
                msb.write_string("match " + ms_var + " {\n")
                let mut ai = 0
                while ai < arms_arr.length() {
                  let pat_s = match json::as_str(pats_arr[ai]) { Some(s) => s, None => "_" }
                  let g_s = match json::obj_get(arms_arr[ai], "g") {
                    Some(gv) => match json::as_str(gv) { Some(s) => s, None => "" }
                    None => ""
                  }
                  let b_s = match json::obj_get(arms_arr[ai], "b") {
                    Some(bv) => match json::as_str(bv) { Some(s) => s, None => "()" }
                    None => "()"
                  }
                  let sep_s = match json::obj_get(arms_arr[ai], "sep") {
                    Some(sv) => match json::as_str(sv) { Some(s) => s, None => "" }
                    None => ""
                  }
                  msb.write_string("  " + pat_s)
                  if g_s.length() > 0 {
                    msb.write_string(" if " + g_s)
                  }
                  msb.write_string(" => " + b_s + sep_s + "\n")
                  ai = ai + 1
                }
                msb.write_string("}")
                return Some(msb.to_string())
              }
            }
            let ecode = match json::obj_get(cobj, "err_code") {
              Some(ev) => match json::as_str(ev) { Some(s) => s, None => "MBT2PION_ENUM_LABEL_ERROR" }
              None => "MBT2PION_ENUM_LABEL_ERROR"
            }
            let emsg = match json::obj_get(cobj, "err_msg") {
              Some(ev) => match json::as_str(ev) { Some(s) => s, None => "enum pattern resolution failed for `" + base_ty + "`" }
              None => "enum pattern resolution failed for `" + base_ty + "`"
            }
            diags.push(diag_error(ecode, site.file, site.line, site.col, emsg))
            return Some("panic(\"enum label error\")")
          }
          None => {
            let detail = if incomplete {
              "ambiguous enum match on `" + base_ty + "` (incomplete candidate enum sources: missing --dep/api_map metadata)"
            } else {
              "ambiguous enum match on `" + base_ty + "` does not match candidate enum set"
            }
            diags.push(diag_error("MBT2PION_AMBIGUOUS_CTOR", site.file, site.line, site.col, detail))
            return Some("panic(\"ambiguous enum match\")")
          }
        }
      }
      None => {
        diags.push(diag_error("MBT2PION_AMBIGUOUS_CTOR", site.file, site.line, site.col, "malformed match scrutinee probe metadata"))
        return Some("panic(\"ambiguous enum match\")")
      }
    }
  }

  if site.probe_kind == "mbt_val_probe" || site.probe_kind == "mbt_val_set_probe" {
    let is_ref = is_recipe_ref_type(resolved_type, recipes)
    let target_field = if is_ref {
      if recipes.ref_recipe.enabled && recipes.ref_recipe.field_name.length() > 0 {
        recipes.ref_recipe.field_name
      } else {
        "v"
      }
    } else {
      let base_ty = strip_type_args(resolved_type)
      match struct_val_fields.get(base_ty) {
        Some(renamed) => renamed
        None => {
          // Strict fail-closed: NEVER fall back to hardcoded `val_`!
          let err_code = if str_has(base_ty, "::") {
            "MBT2PION_DEP_ABI_ERROR"
          } else {
            "MBT2PION_UNDISPOSED_PROBE_SITE"
          }
          diags.push(diag_error(
            err_code,
            site.file,
            site.line,
            site.col,
            "cannot resolve `.val` field mapping for `" + resolved_type + "` (missing local or verified --dep ABI mapping)",
          ))
          drift_ledger.push(DriftEntry::{
            category: "mbt_val_probe",
            file: site.file,
            line: site.line,
            col: site.col,
            expr: site.lhs_expr + ".val",
            resolution: "blocked",
            status: "unresolved",
            detail: "missing .val field mapping for " + resolved_type,
          })
          return None
        }
      }
    }
    if site.assign_op.length() == 0 {
      return Some(site.lhs_expr + "." + target_field)
    }
    if site.assign_op == "=" {
      if is_simple_ident_expr(site.lhs_expr) && !str_has(site.rhs_expr, "{") && !str_has(site.rhs_expr, ";") {
        return Some(site.lhs_expr + "." + target_field + " = " + site.rhs_expr)
      }
      let r_tmp = fresh_stage_b_ident(used_idents, "__mbt_r")
      return Some(
        "{ let " + r_tmp + " = " + site.lhs_expr + "; " + r_tmp + "." + target_field + " = (" + site.rhs_expr + ") }",
      )
    }
    // Compound assignment (`+=`, `-=`, `*=`, `/=`, etc.): ALWAYS evaluate `<recv>` ONCE into a
    // hygienic temp BEFORE evaluating `<rhs>` (even for simple ident `r`, so `r.val += { r = b; 10 }`
    // mutates the original receiver `a` rather than reassigned `b`!).
    let r_tmp = fresh_stage_b_ident(used_idents, "__mbt_r")
    return Some(
      "{ let " + r_tmp + " = " + site.lhs_expr + "; " + r_tmp + "." + target_field + " = " + r_tmp + "." + target_field + " " + site.assign_op + " (" + site.rhs_expr + ") }",
    )
  }

  // Astra Round 3 P0-2 & E1-4: exact per-node slice type classification (zero receiver-name heuristics!)
  if site.probe_kind == "mbt_slice_owned_probe" || site.probe_kind == "mbt_slice_borrow_probe" ||
  site.probe_kind == "mbt_slice_ro_join_probe" || site.probe_kind == "mbt_slice_ro_show_probe" {
    let is_owned = site.probe_kind == "mbt_slice_owned_probe"
    let is_empty_op = is_owned && site.assign_op == "\"__IS_EMPTY__\""
    let is_iter_op = is_owned && site.assign_op == "\"__ITER__\""
    let is_contains_op = is_owned && site.assign_op == "\"__CONTAINS__\""
    let is_for_ro_op = is_owned && site.assign_op == "\"__FOR_RO__\""
    let is_ro_view_op = is_owned && site.assign_op == "\"__RO_VIEW__\""
    let is_ro_join = site.probe_kind == "mbt_slice_ro_join_probe"
    let is_ro_show = site.probe_kind == "mbt_slice_ro_show_probe"
    let expr_desc = site.lhs_expr + "[" + site.rhs_expr + ":" + site.slice_hi + "]"
    if resolved_type == "String" {
      drift_ledger.push(DriftEntry::{
        category: "string_utf16_slice",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: expr_desc,
        resolution: "mbt_compat::utf16_slice",
        status: "resolved",
        detail: "String slice routed to UTF-16 clamped slice",
      })
      let sc = "mbt_compat::utf16_slice(" + site.lhs_expr + ", " + site.rhs_expr + ", " + site.slice_hi + ")"
      if is_iter_op {
        return Some("mbt_compat::str_iter(" + sc + ")")
      }
      return Some(if is_empty_op { "(" + sc + ").length() == 0" } else { sc })
    }
    if resolved_type == "Bytes" {
      let sc = "mbt_compat::bytes_slice(" + site.lhs_expr + ", " + site.rhs_expr + ", " + site.slice_hi + ")"
      if is_iter_op {
        diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SLICE",
          site.file,
          site.line,
          site.col,
          "`.iter()` on Bytes slice `" + expr_desc + "` is not supported",
        ))
        return Some(sc)
      }
      if is_ro_show {
        return Some(emit_bytes_show_block_a5(sc, used_idents))
      }
      return Some(if is_empty_op { "(" + sc + ").length() == 0" } else { sc })
    }
    if resolved_type.starts_with("FixedArray[") && resolved_type.ends_with("]") {
      let elem_ty = resolved_type.slice(11, resolved_type.length() - 1).trim()
      let ro_elem_ok = is_immutable_scalar_or_tuple_a5(elem_ty)
      let ro_ok = (is_owned && (is_ro_view_op || (!is_iter_op && !is_contains_op && !is_for_ro_op) || ro_elem_ok)) ||
      (is_ro_join && elem_ty == "String") ||
      (is_ro_show && is_builtin_scalar_type_a5(elem_ty))
      if ro_ok {
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::fixed_array_slice_clamp",
          status: "resolved",
          detail: "immediate read-only/owned FixedArray slice copy lowered to fixed_array_slice_clamp",
        })
      } else {
        diags.push(diag_error(
          "MBT2PION_BORROWED_ARRAY_SLICE",
          site.file,
          site.line,
          site.col,
          "borrowed slice `" + expr_desc + "` on FixedArray cannot guarantee shared backing ownership without .to_owned()/.to_array()",
        ))
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::fixed_array_slice_clamp",
          status: "unresolved",
          detail: "borrowed slice on FixedArray cannot guarantee shared backing ownership without .to_owned()/.to_array()",
        })
      }
      let slice_call = "mbt_compat::fixed_array_slice_clamp(" + site.lhs_expr + ", " + site.rhs_expr + ", " + site.slice_hi + ")"
      if ro_ok && is_ro_join {
        return Some(emit_ro_join_block_a5(slice_call, site.assign_op, used_idents))
      }
      if ro_ok && is_ro_show {
        match emit_ro_show_block_a5(slice_call, elem_ty, used_idents) {
          Some(fmt_s) => return Some(fmt_s)
          None => ()
        }
      }
      if ro_ok && is_empty_op {
        return Some("mbt_compat::arr_is_empty(" + slice_call + ")")
      }
      if ro_ok && is_iter_op {
        return Some("mbt_compat::arr_iter(" + slice_call + ")")
      }
      if ro_ok && is_ro_view_op {
        let sv_tmp = fresh_stage_b_ident(used_idents, "__mbt_sv")
        return Some("{ let " + sv_tmp + " = " + slice_call + "; mbt_compat::ArrayBuf::from_array(" + sv_tmp + ").view(0, " + sv_tmp + ".length()) }")
      }
      return Some(slice_call)
    }
    if resolved_type.starts_with("Array[") && resolved_type.ends_with("]") {
      let elem_ty = resolved_type.slice(6, resolved_type.length() - 1).trim()
      let ro_elem_ok = is_immutable_scalar_or_tuple_a5(elem_ty)
      let ro_ok = (is_owned && (is_ro_view_op || (!is_iter_op && !is_contains_op && !is_for_ro_op) || ro_elem_ok)) ||
      (is_ro_join && elem_ty == "String") ||
      (is_ro_show && is_builtin_scalar_type_a5(elem_ty))
      if !ro_ok && site.probe_kind == "mbt_slice_borrow_probe" && site.assign_op == fresh_slice_recv_tag() {
        // The receiver is a proven-fresh allocation nobody else holds: a view over its own backing buffer
        // observes exactly what MoonBit's `ArrayView` over it would (same clamped bounds as `array_slice_clamp`).
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::ArrayBuf::view",
          status: "resolved",
          detail: "borrowed slice of a fresh Array lowered to a view over its own ArrayBuf",
        })
        return Some(
          "mbt_compat::ArrayBuf::from_array(" + site.lhs_expr + ").view(" + site.rhs_expr + ", " + site.slice_hi + ")",
        )
      }
      if ro_ok {
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::array_slice_clamp",
          status: "resolved",
          detail: "immediate read-only/owned slice copy lowered to array_slice_clamp",
        })
      } else {
        diags.push(diag_error(
          "MBT2PION_BORROWED_ARRAY_SLICE",
          site.file,
          site.line,
          site.col,
          "borrowed slice `" + expr_desc + "` on non-local Array cannot guarantee shared backing ownership without ArrayBuf owner or .to_owned()/.to_array()",
        ))
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::array_slice_clamp",
          status: "unresolved",
          detail: "borrowed slice on non-local Array cannot guarantee shared backing ownership without ArrayBuf owner or .to_owned()/.to_array()",
        })
      }
      let slice_call = "mbt_compat::array_slice_clamp(" + site.lhs_expr + ", " + site.rhs_expr + ", " + site.slice_hi + ")"
      if ro_ok && is_ro_join {
        return Some(emit_ro_join_block_a5(slice_call, site.assign_op, used_idents))
      }
      if ro_ok && is_ro_show {
        match emit_ro_show_block_a5(slice_call, elem_ty, used_idents) {
          Some(fmt_s) => return Some(fmt_s)
          None => ()
        }
      }
      if ro_ok && is_empty_op {
        return Some("mbt_compat::arr_is_empty(" + slice_call + ")")
      }
      if ro_ok && is_iter_op {
        return Some("mbt_compat::arr_iter(" + slice_call + ")")
      }
      if ro_ok && is_ro_view_op {
        let sv_tmp = fresh_stage_b_ident(used_idents, "__mbt_sv")
        return Some("{ let " + sv_tmp + " = " + slice_call + "; mbt_compat::ArrayBuf::from_array(" + sv_tmp + ").view(0, " + sv_tmp + ".length()) }")
      }
      return Some(slice_call)
    }
    if resolved_type.starts_with("ArrayView[") || resolved_type.starts_with("mbt_compat::ArrayView[") ||
    resolved_type.starts_with("ArrayBuf[") || resolved_type.starts_with("mbt_compat::ArrayBuf[") {
      let br_i = resolved_type.index_of("[")
      let elem_ty = if br_i > 0 && resolved_type.ends_with("]") {
        resolved_type.slice(br_i + 1, resolved_type.length() - 1).trim()
      } else {
        ""
      }
      let view_expr = "(" + site.lhs_expr + ").view(" + site.rhs_expr + ", " + site.slice_hi + ")"
      let arr_expr = view_expr + ".to_owned()"
      if is_empty_op {
        drift_ledger.push(DriftEntry::{
          category: "array_view_slice",
          file: site.file,
          line: site.line,
          col: site.col,
          expr: expr_desc,
          resolution: "mbt_compat::ArrayView::is_empty",
          status: "resolved",
          detail: "backing-stable ArrayBuf/ArrayView slice is_empty",
        })
        return Some(view_expr + ".is_empty()")
      }
      if is_ro_join {
        if elem_ty == "String" {
          drift_ledger.push(DriftEntry::{
            category: "array_view_slice",
            file: site.file,
            line: site.line,
            col: site.col,
            expr: expr_desc,
            resolution: "mbt_compat::ArrayView::to_array",
            status: "resolved",
            detail: "backing-stable ArrayBuf/ArrayView[String] read-only join",
          })
          return Some(emit_ro_join_block_a5(arr_expr, site.assign_op, used_idents))
        }
        diags.push(diag_error(
          "MBT2PION_BORROWED_ARRAY_SLICE",
          site.file,
          site.line,
          site.col,
          "`.join(...)` on slice `" + expr_desc + "` requires String elements (found `" + resolved_type + "`)",
        ))
        return Some("\"\"")
      }
      if is_ro_show {
        if is_builtin_scalar_type_a5(elem_ty) {
          match emit_ro_show_block_a5(arr_expr, elem_ty, used_idents) {
            Some(fmt_s) => {
              drift_ledger.push(DriftEntry::{
                category: "array_view_slice",
                file: site.file,
                line: site.line,
                col: site.col,
                expr: expr_desc,
                resolution: "mbt_compat::ArrayView::to_array",
                status: "resolved",
                detail: "backing-stable ArrayBuf/ArrayView scalar read-only show",
              })
              return Some(fmt_s)
            }
            None => ()
          }
        }
        diags.push(diag_error(
          "MBT2PION_BORROWED_ARRAY_SLICE",
          site.file,
          site.line,
          site.col,
          "string interpolation/to_string on slice `" + expr_desc + "` requires built-in scalar elements (found `" + resolved_type + "`)",
        ))
        return Some("\"\"")
      }
      drift_ledger.push(DriftEntry::{
        category: "array_view_slice",
        file: site.file,
        line: site.line,
        col: site.col,
        expr: expr_desc,
        resolution: if is_owned { "mbt_compat::ArrayView::to_array" } else { "mbt_compat::ArrayView::view" },
        status: "resolved",
        detail: "backing-stable ArrayBuf/ArrayView slice",
      })
      if is_iter_op {
        if is_immutable_scalar_or_tuple_a5(elem_ty) {
          return Some("mbt_compat::arr_iter(" + arr_expr + ")")
        }
        diags.push(diag_error(
          "MBT2PION_BORROWED_ARRAY_SLICE",
          site.file,
          site.line,
          site.col,
          "`.iter()` on slice `" + expr_desc + "` requires immutable built-in scalar elements (found `" + resolved_type + "`)",
        ))
        return Some(arr_expr)
      }
      if is_owned {
        return Some(arr_expr)
      }
      return Some(view_expr)
    }
    diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SLICE",
      site.file,
      site.line,
      site.col,
      "unsupported slice receiver type `" + resolved_type + "` for `" + expr_desc + "`",
    ))
    drift_ledger.push(DriftEntry::{
      category: "array_view_slice",
      file: site.file,
      line: site.line,
      col: site.col,
      expr: expr_desc,
      resolution: "blocked",
      status: "unresolved",
      detail: "unsupported slice receiver type " + resolved_type,
    })
    return Some("mbt_compat::array_slice_clamp(" + site.lhs_expr + ", " + site.rhs_expr + ", " + site.slice_hi + ")")
  }

  None
}

///| E1-4: Emit hygienic inline `Array[String]::join(sep)` block shared by Array/FixedArray/ArrayView/ArrayBuf.
fn emit_ro_join_block_a5(arr_expr : String, sep_expr : String, used_idents : Map[String, Bool]) -> String {
  let ja = fresh_stage_b_ident(used_idents, "__mbt_ja")
  let js = fresh_stage_b_ident(used_idents, "__mbt_js")
  let ji = fresh_stage_b_ident(used_idents, "__mbt_ji")
  "({ let " + ja + " = " + arr_expr + "; let " + js + " = StringBuilder(); let mut " + ji + " = 0; while " + ji + " < " + ja + ".length() { if " + ji + " > 0 { " + js + ".write_string(" + sep_expr + ") }; " + js + ".write_string(" + ja + "[" + ji + "]); " + ji + " = " + ji + " + 1 }; " + js + ".to_string() })"
}

///| E1-4: Emit MoonBit `Show` format for built-in scalar array slices (String/Char unquoted `[a, b]`).
fn emit_ro_show_block_a5(arr_expr : String, elem_ty : String, used_idents : Map[String, Bool]) -> Option[String] {
  if elem_ty == "String" || elem_ty == "Char" {
    let ja = fresh_stage_b_ident(used_idents, "__mbt_ja")
    let js = fresh_stage_b_ident(used_idents, "__mbt_js")
    let ji = fresh_stage_b_ident(used_idents, "__mbt_ji")
    let write_op = if elem_ty == "String" { ".write_string(" } else { ".write_char(" }
    return Some(
      "({ let " + ja + " = " + arr_expr + "; let " + js + " = StringBuilder(); " + js + ".write_string(\"[\"); let mut " + ji + " = 0; while " + ji + " < " + ja + ".length() { if " + ji + " > 0 { " + js + ".write_string(\", \") }; " + js + write_op + ja + "[" + ji + "]); " + ji + " = " + ji + " + 1 }; " + js + ".write_string(\"]\"); " + js + ".to_string() })",
    )
  }
  match gen_debug_fmt_expr(arr_expr, "Array[" + elem_ty + "]", 0) {
    Some(s) => Some("(" + s + ")")
    None => None
  }
}

///| E1-4: Emit hygienic MoonBit-compatible `b"..."` formatter for `Bytes` slice `.to_string()` / `\{...}`.
///| MoonBit `BytesView::to_string()` prints printable ASCII 0x20..=0x7e except `"` (0x22) and `\` (0x5c)
///| verbatim, and formats all other bytes (including 0x09/0x0a/0x0d/0x22/0x5c) as `\xHH` lowercase hex.
fn emit_bytes_show_block_a5(bytes_expr : String, used_idents : Map[String, Bool]) -> String {
  let bv = fresh_stage_b_ident(used_idents, "__mbt_bs")
  let sb = fresh_stage_b_ident(used_idents, "__mbt_bsb")
  let bi = fresh_stage_b_ident(used_idents, "__mbt_bi")
  let ch = fresh_stage_b_ident(used_idents, "__mbt_bc")
  "({ let " + bv + " = " + bytes_expr + "; let " + sb + " = StringBuilder(); " + sb + ".write_string(\"b\\\"\"); let mut " + bi + " = 0; let __hex = \"0123456789abcdef\"; while " + bi + " < " + bv + ".length() { let " + ch + " = " + bv + "[" + bi + "].to_int(); if " + ch + " >= 32 && " + ch + " <= 126 && " + ch + " != 34 && " + ch + " != 92 { " + sb + ".write_char((" + ch + ").unsafe_to_char()) } else { " + sb + ".write_string(\"\\\\x\"); " + sb + ".write_string(__hex.slice(" + ch + " / 16, " + ch + " / 16 + 1)); " + sb + ".write_string(__hex.slice(" + ch + " % 16, " + ch + " % 16 + 1)) }; " + bi + " = " + bi + " + 1 }; " + sb + ".write_string(\"\\\"\"); " + sb + ".to_string() })"
}

///| E1-4: True iff `t` is a pure built-in scalar type whose `Show` cannot mutate external state.
fn is_builtin_scalar_type_a5(t : String) -> Bool {
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Double" || t == "Float" || t == "Bool" || t == "Char" ||
  t == "Byte" || t == "String"
}

///| True iff `t` is an immutable built-in scalar or a tuple of immutable built-in scalars
///| (value semantics, zero mutable fields, safe for read-only slice copy lowering).
fn is_immutable_scalar_or_tuple_a5(t : String) -> Bool {
  let tr = t.trim()
  if is_builtin_scalar_type_a5(tr) {
    return true
  }
  if tr.starts_with("(") && tr.ends_with(")") && tr.length() >= 4 {
    let inner = tr.slice(1, tr.length() - 1)
    let mut s = 0
    let mut d = 0
    let mut k = 0
    let mut count = 0
    while k <= inner.length() {
      let at_e = k == inner.length()
      let ch = if at_e { 44 } else { inner.code_unit_at(k) }
      if !at_e && (ch == 40 || ch == 91 || ch == 123) { d = d + 1 }
      else if !at_e && (ch == 41 || ch == 93 || ch == 125) { if d > 0 { d = d - 1 } }
      else if d == 0 && ch == 44 {
        let part = inner.slice(s, k).trim()
        if !is_immutable_scalar_or_tuple_a5(part) {
          return false
        }
        count = count + 1
        s = k + 1
      }
      k = k + 1
    }
    return count >= 2
  }
  false
}

///| Apply non-overlapping byte-range edits `(start, end, replacement)` to a string.
pub fn apply_byte_edits(src : String, edits : Array[(Int, Int, String)]) -> String {
  if edits.length() == 0 {
    return src
  }
  let sorted = stable_merge_sort_a5(edits, fn(a : (Int, Int, String), b : (Int, Int, String)) -> Bool { a.0 > b.0 })
  let sb = StringBuilder()
  let mut cursor = 0
  for e in sorted {
    if e.0 >= cursor && e.1 <= src.length() {
      sb.write_string(src.slice(cursor, e.0))
      sb.write_string(e.2)
      cursor = e.1
    }
  }
  if cursor < src.length() {
    sb.write_string(src.slice(cursor, src.length()))
  }
  sb.to_string()
}

///| Check whether a file still contains any real `mbt_*_probe` or slice placeholder identifier
///| (lexed so string literals like `".mbt_len_probe("` and comments never trigger false positives,
///| while interpolated string `\{...}` expression holes ARE checked!).
pub fn has_probe_residual(content : String) -> Bool {
  let toks = lex_moonbit(content)
  let tn = toks.length() - 1
  let mut i = 0
  while i < tn {
    let t = toks[i]
    if t.kind == TokenKind::Ident {
      let r = t.raw
      if r.starts_with("mbt_len_probe") ||
      r.starts_with("mbt_code_unit_at_probe") ||
      r.starts_with("mbt_idx_probe") ||
      r.starts_with("mbt_div_probe") ||
      r.starts_with("mbt_mod_probe") ||
      r.starts_with("mbt_show_probe") ||
      r.starts_with("mbt_show_trait_probe") ||
      r.starts_with("mbt_val_probe") ||
      r.starts_with("mbt_val_set_probe") ||
      r.starts_with("mbt_slice_owned_probe") ||
      r.starts_with("mbt_slice_borrow_probe") ||
      r.starts_with("mbt_ufcs_probe") ||
      r.starts_with("mbt_debug_probe") ||
      r == "__mbt_slice_owned" ||
      r == "__mbt_slice_borrow" ||
      r == "__mbt_ufcs_dispatch" ||
      r == "__mbt_debug_fmt" ||
      (i > 0 && toks[i - 1].kind == TokenKind::Dot && i + 1 < tn && toks[i + 1].kind == TokenKind::LParen &&
        (r == "mbt_arrpat_len_probe" || r.starts_with("mbt_arrpat_len_probe__") ||
          r == "mbt_match_scrut_probe" || r.starts_with("mbt_match_scrut_probe__") ||
          r == "mbt_slice_ro_join_probe" || r.starts_with("mbt_slice_ro_join_probe__") ||
          r == "mbt_slice_ro_show_probe" || r.starts_with("mbt_slice_ro_show_probe__"))) ||
      ((r == "__mbt_arrpat_len" || r == "__mbt_match_scrut" || r == "__mbt_slice_ro_join" || r == "__mbt_slice_ro_show" ||
        r == "__mbt_show_trait") &&
      i >= 2 && toks[i - 2].kind == TokenKind::Ident && toks[i - 2].raw == "mbt_compat" &&
      toks[i - 1].kind == TokenKind::ColonColon && i + 1 < tn && toks[i + 1].kind == TokenKind::LParen) {
        return true
      }
    } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let parts = split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline)
      for p in parts {
        if p.is_expr && has_probe_residual(p.text) {
          return true
        }
      }
    }
    i = i + 1
  }
  false
}

///| Remap a set of proven-safe byte offsets through a list of non-overlapping byte edits,
///| including offsets nested inside preserved `lhs_expr`/`rhs_expr` sub-expressions!
fn remap_safe_offsets(
  src : String,
  old_safe : Array[Int],
  edits : Array[(Int, Int, String, String, String)],
) -> (Array[Int], Map[Int, Bool]) {
  let sorted = stable_merge_sort_a5(
    edits,
    fn(a : (Int, Int, String, String, String), b : (Int, Int, String, String, String)) -> Bool { a.0 > b.0 },
  )
  // For each `pos`, the reference scan stops at the first edit `k` with `pos < s_k` or
  // `s_k <= pos < en_k`, i.e. the first `k` with `pos < max(s_k, en_k)`, after summing the length
  // deltas of edits `0..k`. Prefix maxima of `max(s_k, en_k)` are non-decreasing, so that first `k`
  // is a binary search, and prefix delta sums make every offset O(log E) instead of O(E).
  let ne = sorted.length()
  let prefix_max : Array[Int] = []
  let prefix_delta : Array[Int] = [0]
  let mut run_max = 0
  let mut run_delta = 0
  let mut k = 0
  while k < ne {
    let e = sorted[k]
    let m = if e.1 > e.0 { e.1 } else { e.0 }
    run_max = if k == 0 || m > run_max { m } else { run_max }
    prefix_max.push(run_max)
    run_delta = run_delta + e.2.length() - (e.1 - e.0)
    prefix_delta.push(run_delta)
    k = k + 1
  }
  let new_list : Array[Int] = []
  let new_map : Map[Int, Bool] = Map()
  for pos in old_safe {
    // First `k` with `prefix_max[k] > pos` (`ne` when none).
    let mut lo = 0
    let mut hi = ne
    while lo < hi {
      let mid = (lo + hi) / 2
      if prefix_max[mid] > pos {
        hi = mid
      } else {
        lo = mid + 1
      }
    }
    let delta = prefix_delta[lo]
    let mut mapped = -1
    if lo == ne {
      mapped = pos + delta
    } else {
      let e = sorted[lo]
      let s = e.0
      let en = e.1
      let repl = e.2
      let lhs_e = e.3
      let rhs_e = e.4
      if pos < s {
        mapped = pos + delta
      } else {
        let orig_slice = src.slice(s, en)
        let new_edit_start = s + delta
        if lhs_e.length() > 0 {
          let l_old = orig_slice.index_of(lhs_e)
          let l_new = repl.index_of(lhs_e)
          if l_old >= 0 && l_new >= 0 && pos >= s + l_old && pos < s + l_old + lhs_e.length() {
            mapped = new_edit_start + l_new + (pos - (s + l_old))
          }
        }
        if mapped < 0 && rhs_e.length() > 0 {
          let r_old = orig_slice.index_of(rhs_e)
          let r_new = repl.index_of(rhs_e)
          if r_old >= 0 && r_new >= 0 && pos >= s + r_old && pos < s + r_old + rhs_e.length() {
            mapped = new_edit_start + r_new + (pos - (s + r_old))
          }
        }
      }
    }
    if mapped >= 0 && !new_map.contains(mapped) {
      new_map[mapped] = true
      new_list.push(mapped)
    }
  }
  (new_list, new_map)
}

///| Independent raw-token post-Stage-A.5 audit (Astra Round 5 P0-1):
///| Completely independent of `find_receiver_start` and `is_non_expr_receiver`, scans raw tokens
///| (recursively entering `InterpString` `\{...}`) for ANY undisposed `.length()`, `.to_string()`,
///| `.val`, or expression `[i]` whose operator byte offset is NOT in `safe_offsets`!
fn audit_undisposed_raw_tokens(
  file : String,
  content : String,
  safe_offsets : Map[Int, Bool],
  base_offset : Int,
  line_offset : Int,
  declared_values : Map[String, Bool],
  declared_types : Map[String, Bool],
  qual_values : Map[String, Bool],
  qual_types : Map[String, Bool],
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Unit {
  let toks = lex_moonbit(content)
  let n = toks.length() - 1
  let mut i = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::InterpString {
      let parts = split_interp_string(t.raw, false)
      let mut part_off = t.start_byte + 1
      for p in parts {
        if !p.is_expr {
          part_off = part_off + p.text.length()
        } else {
          let expr_start = part_off + 2
          audit_undisposed_raw_tokens(
            file,
            p.text,
            safe_offsets,
            base_offset + expr_start,
            if line_offset > 0 { line_offset } else { t.line },
            declared_values,
            declared_types,
            qual_values,
            qual_types,
            diags,
            drift_ledger,
          )
          part_off = part_off + 2 + p.text.length() + 1
        }
      }
    } else if t.kind == TokenKind::Dot && i + 3 < n &&
    (toks[i + 1].raw == "length" || toks[i + 1].raw == "to_string") &&
    toks[i + 2].kind == TokenKind::LParen &&
    toks[i + 3].kind == TokenKind::RParen {
      let op_b = base_offset + toks[i + 1].start_byte
      if !safe_offsets.contains(op_b) {
        let ln = if line_offset > 0 { line_offset } else { toks[i + 1].line }
        let kind_s = if toks[i + 1].raw == "length" { "mbt_len_probe" } else { "mbt_show_probe" }
        diags.push(diag_error(
          "MBT2PION_UNDISPOSED_PROBE_SITE",
          file,
          ln,
          toks[i + 1].col,
          "undisposed `." + toks[i + 1].raw + "()` call remained after Stage A.5",
        ))
        drift_ledger.push(DriftEntry::{
          category: kind_s,
          file: file,
          line: ln,
          col: toks[i + 1].col,
          expr: "." + toks[i + 1].raw + "()",
          resolution: "blocked",
          status: "unresolved",
          detail: "undisposed probe candidate after Stage A.5 (raw-token audit)",
        })
      }
    } else if t.kind == TokenKind::Dot && i + 3 < n &&
    toks[i + 1].raw == "code_unit_at" &&
    toks[i + 2].kind == TokenKind::LParen {
      let close_p = find_matching_delim(toks, i + 2)
      let mut arg_count = 0
      let mut has_empty_mid = false
      if close_p > i + 3 {
        let mut seg_s = i + 3
        let mut d = 0
        let mut k = i + 3
        while k <= close_p {
          if k == close_p || (d == 0 && toks[k].kind == TokenKind::Comma) {
            if k > seg_s {
              arg_count = arg_count + 1
            } else if k < close_p {
              has_empty_mid = true
            }
            seg_s = k + 1
          } else {
            let kk = toks[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
              d = d + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
              if d > 0 { d = d - 1 }
            }
          }
          k = k + 1
        }
      }
      if !has_empty_mid && arg_count == 1 {
        let op_b = base_offset + toks[i + 1].start_byte
        if !safe_offsets.contains(op_b) {
          let ln = if line_offset > 0 { line_offset } else { toks[i + 1].line }
          diags.push(diag_error(
            "MBT2PION_UNDISPOSED_PROBE_SITE",
            file,
            ln,
            toks[i + 1].col,
            "undisposed `.code_unit_at(...)` call remained after Stage A.5",
          ))
          drift_ledger.push(DriftEntry::{
            category: "mbt_code_unit_at_probe",
            file: file,
            line: ln,
            col: toks[i + 1].col,
            expr: ".code_unit_at(...)",
            resolution: "blocked",
            status: "unresolved",
            detail: "undisposed probe candidate after Stage A.5 (raw-token audit)",
          })
        }
      }
    } else if t.kind == TokenKind::Dot && i + 1 < n && toks[i + 1].raw == "val" {
      let op_b = base_offset + toks[i + 1].start_byte
      if !safe_offsets.contains(op_b) {
        let ln = if line_offset > 0 { line_offset } else { toks[i + 1].line }
        diags.push(diag_error(
          "MBT2PION_UNDISPOSED_PROBE_SITE",
          file,
          ln,
          toks[i + 1].col,
          "undisposed `.val` field access remained after Stage A.5",
        ))
        drift_ledger.push(DriftEntry::{
          category: "mbt_val_probe",
          file: file,
          line: ln,
          col: toks[i + 1].col,
          expr: ".val",
          resolution: "blocked",
          status: "unresolved",
          detail: "undisposed .val access after Stage A.5 (raw-token audit)",
        })
      }
    } else if t.kind == TokenKind::LBracket && i > 0 && !t.newline_before {
      let pk = toks[i - 1].kind
      let is_expr_prev = pk == TokenKind::Ident || pk == TokenKind::UpperIdent || pk == TokenKind::RParen || pk == TokenKind::RBracket || is_literal_expr_token(pk)
      let close_br = find_matching_delim(toks, i)
      let next_is_eq = close_br + 1 < n && toks[close_br + 1].kind == TokenKind::Eq
      let op_b = base_offset + t.start_byte
      if is_expr_prev && !is_type_arg_brackets(toks, i, declared_values, declared_types, qual_values, qual_types) && !next_is_eq && close_br > i + 1 && !safe_offsets.contains(op_b) {
        let ln = if line_offset > 0 { line_offset } else { t.line }
        diags.push(diag_error(
          "MBT2PION_UNDISPOSED_PROBE_SITE",
          file,
          ln,
          t.col,
          "undisposed `[...]` index expression remained after Stage A.5",
        ))
        drift_ledger.push(DriftEntry::{
          category: "mbt_idx_probe",
          file: file,
          line: ln,
          col: t.col,
          expr: "[...]",
          resolution: "blocked",
          status: "unresolved",
          detail: "undisposed index expression after Stage A.5 (raw-token audit)",
        })
      }
    }
    i = i + 1
  }
}

///| Post-Stage-A.5 audit (Astra Round 3 P0-3): any `/` or `%` remaining in the final output
///| (including inside `InterpString` `\{...}`) that was NOT proven safe in `safe_offsets` MUST block publish!
fn audit_undisposed_div_mod(
  file : String,
  content : String,
  safe_offsets : Map[Int, Bool],
  base_offset : Int,
  line_offset : Int,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> Unit {
  let toks = lex_moonbit(content)
  let n = toks.length() - 1
  let mut i = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::InterpString {
      let parts = split_interp_string(t.raw, false)
      let mut part_off = t.start_byte + 1
      for p in parts {
        if !p.is_expr {
          part_off = part_off + p.text.length()
        } else {
          let expr_start = part_off + 2
          audit_undisposed_div_mod(
            file,
            p.text,
            safe_offsets,
            base_offset + expr_start,
            if line_offset > 0 { line_offset } else { t.line },
            diags,
            drift_ledger,
          )
          part_off = part_off + 2 + p.text.length() + 1
        }
      }
    } else if t.kind == TokenKind::Slash || t.kind == TokenKind::Percent {
      let op_b = base_offset + t.start_byte
      if !safe_offsets.contains(op_b) {
        let ln = if line_offset > 0 { line_offset } else { t.line }
        diags.push(diag_error(
          "MBT2PION_UNDISPOSED_DIV_MOD",
          file,
          ln,
          t.col,
          "undisposed `" + t.raw + "` operator remained after Stage A.5 (round cap reached or unrecognized operand boundary)",
        ))
        drift_ledger.push(DriftEntry::{
          category: "int_div_zero",
          file: file,
          line: ln,
          col: t.col,
          expr: t.raw,
          resolution: "blocked",
          status: "unresolved",
          detail: "undisposed division/modulo operator after Stage A.5",
        })
      }
    }
    i = i + 1
  }
}

///| Sort `ProbeResult`s deterministically by `(file, line, col)` so same-line multi-probes
///| align 1:1 in left-to-right occurrence order with `ProbeSite`s!
fn sort_probe_results(xs : Array[ProbeResult]) -> Array[ProbeResult] {
  stable_merge_sort_a5(xs, probe_result_gt)
}

///| Injective `(probe_id, probe_kind)` map key (length-prefixed, so no separator can collide).
fn probe_match_key_a5(probe_id : String, probe_kind : String) -> String {
  probe_id.length().to_string() + ":" + probe_id + "|" + probe_kind
}

fn probe_result_gt(a : ProbeResult, b : ProbeResult) -> Bool {
  let c = str_cmp(a.file, b.file)
  if c != 0 {
    c > 0
  } else if a.line != b.line {
    a.line > b.line
  } else {
    a.col > b.col
  }
}

///| Stable O(N log N) bottom-up merge sort returning a new array: an element moves ahead of an
///| earlier one only when `gt(earlier, later)`, so the order is exactly that of a stable
///| insertion sort with the same strict `gt` comparator (ties keep their input order).
fn stable_merge_sort_a5[T](xs : Array[T], gt : (T, T) -> Bool) -> Array[T] {
  let n = xs.length()
  let mut src : Array[T] = []
  for x in xs {
    src.push(x)
  }
  if n < 2 {
    return src
  }
  let mut dst : Array[T] = []
  for x in xs {
    dst.push(x)
  }
  let mut width = 1
  while width < n {
    let mut lo = 0
    while lo < n {
      let mid = if lo + width < n { lo + width } else { n }
      let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
      let mut i = lo
      let mut j = mid
      let mut o = lo
      while i < mid && j < hi {
        if gt(src[i], src[j]) {
          dst[o] = src[j]
          j = j + 1
        } else {
          dst[o] = src[i]
          i = i + 1
        }
        o = o + 1
      }
      while i < mid {
        dst[o] = src[i]
        i = i + 1
        o = o + 1
      }
      while j < hi {
        dst[o] = src[j]
        j = j + 1
        o = o + 1
      }
      lo = hi
    }
    let tmp = src
    src = dst
    dst = tmp
    width = width * 2
  }
  src
}

///| Execute Stage A.5 on a set of generated files using a `check_fn` callback that runs
///| `pionc check --json` on the instrumented file map and returns the raw JSON output.
///| Enforces the mandatory coverage guard (`probe_diagnostics_received == probes_instrumented`),
///| tracks proven-safe operator offsets across up to `max_rounds` (default 64) iterations,
///| consumes each `ProbeResult` at most once in `(file, line, col)` order, and blocks on any
///| undisposed `/` or `%` operator remaining after convergence!
pub fn run_stage_a5(
  files : Array[GeneratedFile],
  recipes : Recipes,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_full(files, recipes, empty_api_map(), check_fn, diags, drift_ledger, 64)
}

pub fn run_stage_a5_with_api_map(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_full(files, recipes, api_map, check_fn, diags, drift_ledger, 64)
}

pub fn run_stage_a5_with_max_rounds(
  files : Array[GeneratedFile],
  recipes : Recipes,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  max_rounds : Int,
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_full(files, recipes, empty_api_map(), check_fn, diags, drift_ledger, max_rounds)
}

pub fn run_stage_a5_full(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  max_rounds : Int,
) -> (Array[GeneratedFile], Int, Int, Int) {
  let dummy_disps : Array[ProbeDisposition] = []
  run_stage_a5_ex(files, recipes, api_map, Map(), check_fn, diags, drift_ledger, dummy_disps, max_rounds)
}

fn collect_probe_ident_spans(src : String, base_off : Int, out : Array[(Int, Int, String)]) -> Unit {
  let toks = lex_moonbit(src)
  let tn = toks.length() - 1
  let mut ti = 0
  while ti < tn {
    let t = toks[ti]
    if ti + 2 < tn && t.kind == TokenKind::Dot &&
    toks[ti + 1].kind == TokenKind::Ident &&
    toks[ti + 2].kind == TokenKind::LParen {
      let r = toks[ti + 1].raw
      if r.starts_with("mbt_") && r.ends_with("_probe") {
        out.push((base_off + toks[ti + 1].start_byte, base_off + toks[ti + 1].end_byte, r))
        ti = ti + 3
        continue
      }
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let raw = t.raw
      let rlen = raw.length()
      let mut p = 0
      while p + 1 < rlen {
        if raw.code_unit_at(p) == 92 && raw.code_unit_at(p + 1) == 123 {
          let hole_s = p + 2
          let mut q = hole_s
          let mut d = 1
          let mut in_s = false
          let mut esc = false
          while q < rlen && d > 0 {
            let c = raw.code_unit_at(q)
            if in_s {
              if esc { esc = false }
              else if c == 92 { esc = true }
              else if c == 34 { in_s = false }
            } else if c == 34 {
              in_s = true
            } else if c == 123 {
              d = d + 1
            } else if c == 125 {
              d = d - 1
              if d == 0 { break }
            }
            q = q + 1
          }
          if d == 0 && q > hole_s {
            collect_probe_ident_spans(raw.slice(hole_s, q), base_off + t.start_byte + hole_s, out)
            p = q + 1
            continue
          }
        }
        p = p + 1
      }
    }
    ti = ti + 1
  }
}

///| Tag each real `.<probe_kind>(` call in `inst_src` (including inside `\{...}` interp holes!)
///| with a unique `__<probe_id>` suffix using `lex_moonbit` tokens (NEVER raw substring search,
///| so string/char literals like `".mbt_len_probe("` or comments can NEVER corrupt probe IDs!).
fn tag_instrumented_probes_unique(inst_src : String, sites : Array[ProbeSite]) -> String {
  if sites.length() == 0 {
    return inst_src
  }
  let spans : Array[(Int, Int, String)] = []
  collect_probe_ident_spans(inst_src, 0, spans)
  let edits : Array[(Int, Int, String)] = []
  let mut si = 0
  for site in sites {
    while si < spans.length() {
      let sp = spans[si]
      si = si + 1
      if sp.2 == site.probe_kind {
        edits.push((sp.0, sp.1, site.probe_kind + "__" + site.probe_id))
        break
      }
    }
  }
  if edits.length() == 0 {
    return inst_src
  }
  apply_byte_edits(inst_src, edits)
}

///| Parse `// origin-probes: kind=l1:c1,l2:c2;...` for a specific `probe_kind`.
fn parse_origin_probes_for_kind(spec : String, probe_kind : String) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let prefix = probe_kind + "="
  let groups = spec.split(";")
  for g in groups {
    let gt = g.trim()
    if gt.starts_with(prefix) {
      let coords = gt.slice(prefix.length(), gt.length()).split(",")
      for c in coords {
        let ct = c.trim()
        let ci = ct.index_of(":")
        if ci > 0 {
          let ln = parse_simple_pos_int(ct.slice(0, ci), 1)
          let cl = parse_simple_pos_int(ct.slice(ci + 1, ct.length()), 1)
          out.push((ln, cl))
        }
      }
      break
    }
  }
  out
}

///| Find the enclosing `// origin:` header index and optional `// origin-probes:` line for `line_1based`
///| in `00_init_order.pion` or `00_init_order_test.pion`.
fn find_init_origin_header(content : String, file : String, line_1based : Int) -> (Int, String, String) {
  if file != "00_init_order.pion" && file != "00_init_order_test.pion" {
    return (-1, "", "")
  }
  let lines = content.split("\n")
  let mut li = if line_1based - 1 < lines.length() { line_1based - 1 } else { lines.length() - 1 }
  while li >= 0 {
    let t = lines[li].trim()
    if t.starts_with("// origin: ") {
      let origin_rest = t.slice(11, t.length()).trim()
      let probes_rest = if li + 1 < lines.length() && lines[li + 1].trim().starts_with("// origin-probes: ") {
        let p = lines[li + 1].trim()
        p.slice(18, p.length()).trim()
      } else {
        ""
      }
      return (li, origin_rest, probes_rest)
    }
    li = li - 1
  }
  (-1, "", "")
}

///| Resolve original MoonBit `(file, line, col)` from nearest `// origin:` + `// origin-probes:`
///| metadata above `line_1based` in `00_init_order.pion` or `00_init_order_test.pion`.
///| When `probe_slot >= 0` and `// origin-probes:` has an entry for `probe_kind` at `probe_slot`,
///| returns the exact original MoonBit token `(line, col)` directly (zero column-offset arithmetic!).
fn resolve_init_order_origin_slot(
  content : String,
  file : String,
  line_1based : Int,
  col_1based : Int,
  probe_kind : String,
  probe_slot : Int,
) -> (String, Int, Int) {
  let (li, rest, probes_rest) = find_init_origin_header(content, file, line_1based)
  if li < 0 {
    return (file, line_1based, col_1based)
  }
  let c1 = rest.index_of(":")
  if c1 > 0 {
    let orig_f = rest.slice(0, c1)
    if probe_kind.length() > 0 && probe_slot >= 0 && probes_rest.length() > 0 {
      let coords = parse_origin_probes_for_kind(probes_rest, probe_kind)
      if probe_slot < coords.length() {
        return (orig_f, coords[probe_slot].0, coords[probe_slot].1)
      }
    }
    let after1 = rest.slice(c1 + 1, rest.length())
    let parts = after1.split(":")
    let orig_l = if parts.length() >= 1 { parse_simple_pos_int(parts[0], line_1based) } else { line_1based }
    let rhs_orig_col = if parts.length() >= 3 { parse_simple_pos_int(parts[2], 1) } else { 1 }
    let rhs_gen_col = if parts.length() >= 4 { parse_simple_pos_int(parts[3], 1) } else { 1 }
    let decl_start_line = if probes_rest.length() > 0 { li + 3 } else { li + 2 }
    let line_delta = if line_1based > decl_start_line { line_1based - decl_start_line } else { 0 }
    let orig_col = if line_delta == 0 {
      let adj = col_1based - (rhs_gen_col - rhs_orig_col)
      if adj < 1 { 1 } else { adj }
    } else {
      col_1based
    }
    return (orig_f, orig_l + line_delta, orig_col)
  }
  (file, line_1based, col_1based)
}

fn resolve_init_order_origin(content : String, file : String, line_1based : Int, col_1based : Int) -> (String, Int, Int) {
  resolve_init_order_origin_slot(content, file, line_1based, col_1based, "", -1)
}

fn parse_simple_pos_int(s : String, fallback : Int) -> Int {
  let t = s.trim()
  if t.length() == 0 {
    return fallback
  }
  let mut acc = 0
  let mut i = 0
  while i < t.length() {
    let c = t.code_unit_at(i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    } else {
      return fallback
    }
    i = i + 1
  }
  acc
}

pub fn run_stage_a5_ex(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  struct_val_fields : Map[String, String],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  probe_dispositions : Array[ProbeDisposition],
  max_rounds : Int,
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_with_val_sites(
    files,
    recipes,
    api_map,
    struct_val_fields,
    [],
    check_fn,
    diags,
    drift_ledger,
    probe_dispositions,
    max_rounds,
  )
}

///| Resolve original MoonBit `(file, line, col)` from structured `InitOriginRecord`s when available,
///| falling back to `// origin:` comment scanning only when no structured records exist (e.g. unit test mocks).
fn lookup_init_origin_record(
  init_origins_by_file : Map[String, Array[InitOriginRecord]],
  file : String,
  line_1based : Int,
) -> Option[InitOriginRecord] {
  match init_origins_by_file.get(file) {
    Some(recs) => {
      let mut best : Option[InitOriginRecord] = None
      for r in recs {
        if line_1based >= r.start_line && line_1based <= r.end_line {
          return Some(r)
        }
        if r.start_line <= line_1based {
          best = Some(r)
        }
      }
      best
    }
    None => None
  }
}

fn count_newlines_str(s : String) -> Int {
  let mut c = 0
  let mut i = 0
  while i < s.length() {
    if s.code_unit_at(i) == 10 {
      c = c + 1
    }
    i = i + 1
  }
  c
}

fn byte_off_to_line_1based(s : String, off : Int) -> Int {
  let lim = if off < s.length() { off } else { s.length() }
  let mut ln = 1
  let mut i = 0
  while i < lim {
    if s.code_unit_at(i) == 10 {
      ln = ln + 1
    }
    i = i + 1
  }
  ln
}

fn remap_init_origin_records(
  recs : Array[InitOriginRecord],
  old_content : String,
  edits : Array[(Int, Int, String)],
) -> Array[InitOriginRecord] {
  if recs.length() == 0 || edits.length() == 0 {
    return recs
  }
  let mut cur : Array[InitOriginRecord] = recs
  // Collect (edit_line, delta_lines) for every edit that changes newline count
  let line_deltas : Array[(Int, Int)] = []
  for ed in edits {
    let old_nl = count_newlines_str(old_content.slice(ed.0, ed.1))
    let new_nl = count_newlines_str(ed.2)
    let d = new_nl - old_nl
    if d != 0 {
      line_deltas.push((byte_off_to_line_1based(old_content, ed.0), d))
    }
  }
  if line_deltas.length() == 0 {
    return cur
  }
  let next : Array[InitOriginRecord] = []
  for r in cur {
    let mut sl = r.start_line
    let mut el = r.end_line
    let mut dl = r.decl_start_line
    for ld in line_deltas {
      let edit_line = ld.0
      let d = ld.1
      if r.start_line > edit_line {
        sl = sl + d
        el = el + d
        dl = dl + d
      } else if r.end_line >= edit_line {
        el = el + d
        if r.decl_start_line > edit_line {
          dl = dl + d
        }
      }
    }
    next.push(InitOriginRecord::{
      start_line: sl,
      end_line: el,
      decl_start_line: dl,
      source_file: r.source_file,
      line: r.line,
      col: r.col,
      rhs_orig_col: r.rhs_orig_col,
      rhs_gen_col: r.rhs_gen_col,
      probe_origins: r.probe_origins,
    })
  }
  cur = next
  cur
}

fn resolve_init_order_origin_structured(
  init_origins_by_file : Map[String, Array[InitOriginRecord]],
  content : String,
  file : String,
  line_1based : Int,
  col_1based : Int,
  probe_kind : String,
  probe_slot : Int,
) -> (String, Int, Int) {
  match lookup_init_origin_record(init_origins_by_file, file, line_1based) {
    Some(rec) => {
      if probe_kind.length() > 0 && probe_slot >= 0 && rec.probe_origins.length() > 0 {
        let coords = parse_origin_probes_for_kind(rec.probe_origins, probe_kind)
        if probe_slot < coords.length() {
          return (rec.source_file, coords[probe_slot].0, coords[probe_slot].1)
        }
      }
      let line_delta = if line_1based > rec.decl_start_line { line_1based - rec.decl_start_line } else { 0 }
      let orig_col = if line_delta == 0 {
        let adj = col_1based - (rec.rhs_gen_col - rec.rhs_orig_col)
        if adj < 1 { 1 } else { adj }
      } else {
        col_1based
      }
      return (rec.source_file, rec.line + line_delta, orig_col)
    }
    None => ()
  }
  resolve_init_order_origin_slot(content, file, line_1based, col_1based, probe_kind, probe_slot)
}

pub fn run_stage_a5_with_val_sites(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  struct_val_fields : Map[String, String],
  val_probe_sites : Array[ValProbeSite],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  probe_dispositions : Array[ProbeDisposition],
  max_rounds : Int,
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_core(
    files,
    recipes,
    api_map,
    struct_val_fields,
    val_probe_sites,
    Map(),
    check_fn,
    diags,
    drift_ledger,
    probe_dispositions,
    max_rounds,
    true,
  )
}

pub fn run_stage_a5_with_val_sites_and_origins(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  struct_val_fields : Map[String, String],
  val_probe_sites : Array[ValProbeSite],
  init_origins_in : Map[String, Array[InitOriginRecord]],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  probe_dispositions : Array[ProbeDisposition],
  max_rounds : Int,
) -> (Array[GeneratedFile], Int, Int, Int) {
  run_stage_a5_core(
    files,
    recipes,
    api_map,
    struct_val_fields,
    val_probe_sites,
    init_origins_in,
    check_fn,
    diags,
    drift_ledger,
    probe_dispositions,
    max_rounds,
    false,
  )
}

fn run_stage_a5_core(
  files : Array[GeneratedFile],
  recipes : Recipes,
  api_map : ApiMap,
  struct_val_fields : Map[String, String],
  val_probe_sites : Array[ValProbeSite],
  init_origins_in : Map[String, Array[InitOriginRecord]],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
  drift_ledger : Array[DriftEntry],
  probe_dispositions : Array[ProbeDisposition],
  max_rounds : Int,
  allow_untagged : Bool,
) -> (Array[GeneratedFile], Int, Int, Int) {
  // P0-1(b): bucket registered `.val` placeholders by owning file `vps.file` so a placeholder
  // allocated in file A can NEVER match a legitimate user field of the same name in file B.
  let val_placeholders_by_file : Map[String, Map[String, Bool]] = Map()
  for vps in val_probe_sites {
    match val_placeholders_by_file.get(vps.file) {
      Some(m) => m[vps.placeholder_ident] = true
      None => {
        let m : Map[String, Bool] = Map()
        m[vps.placeholder_ident] = true
        val_placeholders_by_file[vps.file] = m
      }
    }
  }
  let init_origins_by_file : Map[String, Array[InitOriginRecord]] = Map()
  for k in init_origins_in.keys() {
    match init_origins_in.get(k) {
      Some(v) => init_origins_by_file[k] = v
      None => ()
    }
  }
  let mut cur_files : Array[GeneratedFile] = []
  let safe_list_by_file : Map[String, Array[Int]] = Map()
  let safe_map_by_file : Map[String, Map[Int, Bool]] = Map()
  let failed_list_by_file : Map[String, Array[Int]] = Map()
  let failed_map_by_file : Map[String, Map[Int, Bool]] = Map()
  let init_used_slots : Map[String, Map[Int, Bool]] = Map()
  for f in files {
    cur_files.push(f)
    safe_list_by_file[f.rel_path] = []
    safe_map_by_file[f.rel_path] = Map()
    failed_list_by_file[f.rel_path] = []
    failed_map_by_file[f.rel_path] = Map()
  }
  let (declared_values, declared_types) = collect_package_value_and_type_names(cur_files)
  let (qual_values, qual_types) = collect_qualified_api_names(api_map)
  let mut total_rounds = 0
  let mut total_instrumented = 0
  let mut total_resolved = 0
  let mut global_probe_seq = 0

  let mut round = 0
  while round < max_rounds {
    let instrumented_batch : Array[(String, String)] = []
    let sites_by_file : Map[String, Array[ProbeSite]] = Map()
    let mut round_probes = 0

    for f in cur_files {
      let smap = match safe_map_by_file.get(f.rel_path) {
        Some(m) => m
        None => Map()
      }
      let fmap = match failed_map_by_file.get(f.rel_path) {
        Some(m) => m
        None => Map()
      }
      let skip_map : Map[Int, Bool] = Map()
      for k in smap.keys() { skip_map[k] = true }
      for k in fmap.keys() { skip_map[k] = true }
      let file_val_placeholders = match val_placeholders_by_file.get(f.rel_path) {
        Some(m) => m
        None => Map()
      }
      let (inst_src, raw_sites) = instrument_probes_for_file_with_safe(
        f.rel_path,
        f.content,
        skip_map,
        0,
        declared_values,
        declared_types,
        qual_values,
        qual_types,
        file_val_placeholders,
      )
      let numbered_sites : Array[ProbeSite] = []
      for rs in raw_sites {
        global_probe_seq = global_probe_seq + 1
        let pid = "p" + (round + 1).to_string() + "_" + global_probe_seq.to_string()
        numbered_sites.push(ProbeSite::{
          probe_id: pid,
          file: rs.file,
          probe_kind: rs.probe_kind,
          start_byte: rs.start_byte,
          end_byte: rs.end_byte,
          op_byte: rs.op_byte,
          line: rs.line,
          col: rs.col,
          lhs_expr: rs.lhs_expr,
          rhs_expr: rs.rhs_expr,
          assign_op: rs.assign_op,
          slice_hi: rs.slice_hi,
          divisor_is_zero: rs.divisor_is_zero,
          rhs_has_lit: rs.rhs_has_lit,
          rhs_is_neg: rs.rhs_is_neg,
          rhs_u64: rs.rhs_u64,
          rhs_overflow: rs.rhs_overflow,
        })
      }
      let tagged_src = tag_instrumented_probes_unique(inst_src, numbered_sites)
      instrumented_batch.push((f.rel_path, tagged_src))
      sites_by_file[f.rel_path] = numbered_sites
      round_probes = round_probes + numbered_sites.length()
    }

    if round_probes == 0 {
      break
    }

    total_rounds = total_rounds + 1
    total_instrumented = total_instrumented + round_probes

    let raw_json = check_fn(instrumented_batch)
    let pionc_diags = parse_pionc_diagnostics(raw_json)

    let raw_results : Array[ProbeResult] = []
    for pd in pionc_diags {
      match extract_probe_with_id_from_diag(pd) {
        Some((pkind, pid, rty)) =>
        raw_results.push(ProbeResult::{
          file: pd.file,
          line: pd.line,
          col: pd.col,
          probe_kind: pkind,
          probe_id: pid,
          resolved_type: rty,
        })
        None => ()
      }
    }

    // Per-probe-ID 1-to-1 disposal with multi-round fixpoint retry for cascading probes:
    // 1. Match by unique `probe_id` first (zero same-line collision); fall back to (file, line, col, kind)
    //    only when a mock check_fn returns untagged probe names.
    // 2. Defer reporting unresolved probes until fixpoint (`!any_changed && !newly_marked_safe`) so
    //    cascading probes (e.g. `let part = n % 10; part.to_string()`) are retried and resolved once
    //    upstream probes rewrite!
    // 3. Zero silent fallback guessing on unresolved probes; map `00_init_order.pion` locations back
    //    to their `// origin: <file>:<line>:<col>` comment.
    let probe_results = sort_probe_results(raw_results)
    let consumed : Array[Bool] = []
    let mut ci = 0
    while ci < probe_results.length() {
      consumed.push(false)
      ci = ci + 1
    }
    // O(1) per-site lookup indexes (ascending `probe_results` indices per bucket):
    // Pass 1 buckets tagged results by `(probe_id, probe_kind)`; Pass 2 buckets untagged results by
    // `line|probe_kind` (empty unless some result is untagged, e.g. unit-test mocks).
    let tagged_index : Map[String, Array[Int]] = Map()
    let tagged_cursor : Map[String, Int] = Map()
    let untagged_index : Map[String, Array[Int]] = Map()
    let mut pri = 0
    while pri < probe_results.length() {
      let pr = probe_results[pri]
      let bkey = if pr.probe_id.length() > 0 {
        probe_match_key_a5(pr.probe_id, pr.probe_kind)
      } else {
        pr.line.to_string() + "|" + pr.probe_kind
      }
      let bucket_map = if pr.probe_id.length() > 0 { tagged_index } else { untagged_index }
      match bucket_map.get(bkey) {
        Some(b) => b.push(pri)
        None => bucket_map[bkey] = [pri]
      }
      pri = pri + 1
    }

    let next_files : Array[GeneratedFile] = []
    let round_unresolved : Array[(String, String, ProbeSite, Int)] = []
    let mut any_changed = false
    let mut newly_marked_safe = false
    for f in cur_files {
      let sites = match sites_by_file.get(f.rel_path) {
        Some(xs) => xs
        None => []
      }
      let slist = match safe_list_by_file.get(f.rel_path) {
        Some(xs) => xs
        None => []
      }
      let smap = match safe_map_by_file.get(f.rel_path) {
        Some(m) => m
        None => Map()
      }
      let flist = match failed_list_by_file.get(f.rel_path) {
        Some(xs) => xs
        None => []
      }
      let fmap = match failed_map_by_file.get(f.rel_path) {
        Some(m) => m
        None => Map()
      }
      let edits : Array[(Int, Int, String)] = []
      let remap_edits : Array[(Int, Int, String, String, String)] = []
      let round_seen_per_item_kind : Map[String, Int] = Map()
      let round_newly_used : Array[(String, Int)] = []
      // Lexed at most once per file per round, on the first matched site; each rewrite still gets
      // its own fresh copy because `fresh_stage_b_ident` records the names it allocates.
      let mut file_used_idents_base : Option[Map[String, Bool]] = None
      for site in sites {
        // Compute exact slot index in this `InitItem`'s `probe_origins` list (using structured
        // `InitOriginRecord`s when available so user/redacted `// origin:` comments can never hijack it!)
        let mut site_slot = -1
        let mut slot_key = ""
        if f.rel_path == "00_init_order.pion" || f.rel_path == "00_init_order_test.pion" {
          let mut hdr_origin = ""
          let mut hdr_probes = ""
          let mut has_hdr = false
          match lookup_init_origin_record(init_origins_by_file, f.rel_path, site.line) {
            Some(rec) => {
              has_hdr = true
              hdr_origin = rec.source_file + ":" + rec.line.to_string() + ":" + rec.col.to_string() + ":" + rec.start_line.to_string()
              hdr_probes = rec.probe_origins
            }
            None => {
              let (hdr_li, ho, hp) = find_init_origin_header(f.content, f.rel_path, site.line)
              if hdr_li >= 0 {
                has_hdr = true
                hdr_origin = ho
                hdr_probes = hp
              }
            }
          }
          if has_hdr && hdr_probes.length() > 0 {
            slot_key = f.rel_path + "|" + hdr_origin + "|" + site.probe_kind
            let rem_idx = match round_seen_per_item_kind.get(slot_key) {
              Some(k) => k
              None => 0
            }
            round_seen_per_item_kind[slot_key] = rem_idx + 1
            let used_m = match init_used_slots.get(slot_key) {
              Some(m) => m
              None => Map()
            }
            let total_coords = parse_origin_probes_for_kind(hdr_probes, site.probe_kind).length()
            let mut avail_seen = 0
            let mut cand = 0
            while cand < total_coords {
              if !used_m.contains(cand) {
                if avail_seen == rem_idx {
                  site_slot = cand
                  break
                }
                avail_seen = avail_seen + 1
              }
              cand = cand + 1
            }
          }
        }
        let mut matched_idx = -1
        let mut match_conflict = false
        let round_prefix = "p" + (round + 1).to_string() + "_"
        // Pass 1: exact 1-to-1 match by globally unique current-round `probe_id`
        // (fail-closed on duplicate/conflicting/untrusted diagnostics!)
        if site.probe_id.length() > 0 && site.probe_id.starts_with(round_prefix) {
          let tkey = probe_match_key_a5(site.probe_id, site.probe_kind)
          match tagged_index.get(tkey) {
            Some(bucket) => {
              let mut cur = match tagged_cursor.get(tkey) {
                Some(c) => c
                None => 0
              }
              while cur < bucket.length() && consumed[bucket[cur]] {
                cur = cur + 1
              }
              tagged_cursor[tkey] = cur
              if cur < bucket.length() {
                let first_idx = bucket[cur]
                let first_pr = probe_results[first_idx]
                let first_ty = first_pr.resolved_type.trim()
                // Reject untrusted/error placeholder receiver types (outer `Array[<error>]` is valid for len/idx!)
                let trusted_ty = first_ty.length() > 0 &&
                first_ty != "?" &&
                first_ty != "<error>" &&
                first_ty != "<unknown>" &&
                first_ty != "TError"
                // Check for duplicate diagnostics on the same unique probe_id:
                // Reject any differing type OR differing source span (file/line/col);
                // allow exact-span identical-type duplicates because `pionc` itself checks
                // or-pattern arm bodies (`A(n) | B(n) => body`) once per branch.
                let mut dup_conflict = false
                let mut bi = cur
                while bi < bucket.length() {
                  if !consumed[bucket[bi]] {
                    let bpr = probe_results[bucket[bi]]
                    if bpr.resolved_type.trim() != first_ty ||
                    bpr.file != first_pr.file ||
                    bpr.line != first_pr.line ||
                    bpr.col != first_pr.col {
                      dup_conflict = true
                    }
                  }
                  bi = bi + 1
                }
                if !trusted_ty || dup_conflict {
                  match_conflict = true
                  // Consume all duplicate/conflicting entries for this probe_id so they don't leak
                  let mut ci2 = cur
                  while ci2 < bucket.length() {
                    consumed[bucket[ci2]] = true
                    ci2 = ci2 + 1
                  }
                } else {
                  matched_idx = first_idx
                  // Consume exact-span identical-type duplicates (e.g. pionc or-pattern arms)
                  let mut ci2 = cur + 1
                  while ci2 < bucket.length() {
                    consumed[bucket[ci2]] = true
                    ci2 = ci2 + 1
                  }
                }
              }
            }
            None => ()
          }
        }
        // Pass 2: fallback for untagged diagnostics (legacy unit-test mocks ONLY — strictly disabled
        // in CLI/publish entry `run_stage_a5_with_val_sites_and_origins`, and never when tagged diags
        // exist or Pass 1 detected a conflict).
        if allow_untagged && matched_idx < 0 && !match_conflict && tagged_index.length() == 0 {
          match untagged_index.get(site.line.to_string() + "|" + site.probe_kind) {
            Some(bucket) => {
              let mut best_col_dist = 1000000
              let mut tied_ambig = false
              for pi2 in bucket {
                let pr = probe_results[pi2]
                if !consumed[pi2] && (pr.file == site.file || pr.file.ends_with("/" + site.file)) {
                  let rty = pr.resolved_type.trim()
                  if rty.length() == 0 || rty == "?" || rty == "<error>" || rty == "TError" {
                    continue
                  }
                  let dist = if pr.col >= site.col { pr.col - site.col } else { site.col - pr.col }
                  if matched_idx < 0 || dist < best_col_dist {
                    matched_idx = pi2
                    best_col_dist = dist
                    tied_ambig = false
                  } else if dist == best_col_dist {
                    tied_ambig = true
                  }
                }
              }
              if tied_ambig {
                matched_idx = -1
              }
            }
            None => ()
          }
        }
        if matched_idx >= 0 {
          consumed[matched_idx] = true
          total_resolved = total_resolved + 1
          let matched_ty = probe_results[matched_idx].resolved_type
          if slot_key.length() > 0 && site_slot >= 0 {
            round_newly_used.push((slot_key, site_slot))
          }
          let (disp_file, disp_line, disp_col) = resolve_init_order_origin_structured(init_origins_by_file, f.content, f.rel_path, site.line, site.col, site.probe_kind, site_slot)
          let file_used_idents = match file_used_idents_base {
            Some(base) => base.copy()
            None => {
              let base = collect_used_idents(f.content)
              file_used_idents_base = Some(base)
              base.copy()
            }
          }
          match rewrite_for_probe_hygienic(site, matched_ty, recipes, struct_val_fields, file_used_idents, diags, drift_ledger) {
            Some(repl) => {
              edits.push((site.start_byte, site.end_byte, repl))
              remap_edits.push((site.start_byte, site.end_byte, repl, site.lhs_expr, site.rhs_expr))
              probe_dispositions.push(ProbeDisposition::{
                probe_id: site.probe_id,
                probe_kind: site.probe_kind,
                file: disp_file,
                line: disp_line,
                col: disp_col,
                resolved_type: matched_ty,
                disposition: "rewritten",
              })
            }
            None => {
              if !smap.contains(site.op_byte) {
                smap[site.op_byte] = true
                slist.push(site.op_byte)
                newly_marked_safe = true
              }
              probe_dispositions.push(ProbeDisposition::{
                probe_id: site.probe_id,
                probe_kind: site.probe_kind,
                file: disp_file,
                line: disp_line,
                col: disp_col,
                resolved_type: matched_ty,
                disposition: "kept_safe",
              })
            }
          }
        } else {
          // Defer unresolved probe reporting until fixpoint so cascading probes can resolve in the next round.
          round_unresolved.push((f.rel_path, f.content, site, site_slot))
        }
      }
      for nu in round_newly_used {
        match init_used_slots.get(nu.0) {
          Some(m) => m[nu.1] = true
          None => {
            let m : Map[Int, Bool] = Map()
            m[nu.1] = true
            init_used_slots[nu.0] = m
          }
        }
      }
      if edits.length() > 0 {
        any_changed = true
        let updated = apply_byte_edits(f.content, edits)
        match init_origins_by_file.get(f.rel_path) {
          Some(recs) => init_origins_by_file[f.rel_path] = remap_init_origin_records(recs, f.content, edits)
          None => ()
        }
        let (nl, nm) = remap_safe_offsets(f.content, slist, remap_edits)
        let (nfl, nfm) = remap_safe_offsets(f.content, flist, remap_edits)
        safe_list_by_file[f.rel_path] = nl
        safe_map_by_file[f.rel_path] = nm
        failed_list_by_file[f.rel_path] = nfl
        failed_map_by_file[f.rel_path] = nfm
        next_files.push(GeneratedFile::{
          rel_path: f.rel_path,
          content: updated,
          source_file: f.source_file,
          anchors: f.anchors,
        })
      } else {
        safe_list_by_file[f.rel_path] = slist
        safe_map_by_file[f.rel_path] = smap
        failed_list_by_file[f.rel_path] = flist
        failed_map_by_file[f.rel_path] = fmap
        next_files.push(f)
      }
    }
    cur_files = next_files
    let will_continue = (any_changed || newly_marked_safe) && (round + 1 < max_rounds)
    if !will_continue {
      // Fixpoint reached: report every remaining unresolved probe fail-closed (zero silent fallback).
      for entry in round_unresolved {
        let (rel_p, fcontent, site, site_slot) = entry
        let (rep_file, rep_line, rep_col) = resolve_init_order_origin_structured(init_origins_by_file, fcontent, rel_p, site.line, site.col, site.probe_kind, site_slot)
        diags.push(diag_error(
          "MBT2PION_UNDISPOSED_PROBE_SITE",
          rep_file,
          rep_line,
          rep_col,
          "unresolved Stage A.5 probe `" + site.probe_id + "` (" + site.probe_kind + ") at " + rep_file + ":" + rep_line.to_string() + ":" + rep_col.to_string(),
        ))
        drift_ledger.push(DriftEntry::{
          category: site.probe_kind,
          file: rep_file,
          line: rep_line,
          col: rep_col,
          expr: site.lhs_expr,
          resolution: "blocked",
          status: "unresolved",
          detail: "probe " + site.probe_id + " received no type diagnostic from pionc",
        })
        probe_dispositions.push(ProbeDisposition::{
          probe_id: site.probe_id,
          probe_kind: site.probe_kind,
          file: rep_file,
          line: rep_line,
          col: rep_col,
          resolved_type: "",
          disposition: "unresolved",
        })
        match failed_map_by_file.get(rel_p) {
          Some(fmap) =>
          if !fmap.contains(site.op_byte) {
            fmap[site.op_byte] = true
            match failed_list_by_file.get(rel_p) {
              Some(flist) => flist.push(site.op_byte)
              None => ()
            }
          }
          None => ()
        }
      }
      break
    }
    round = round + 1
  }

  for f in cur_files {
    if has_probe_residual(f.content) {
      diags.push(diag_error(
        "MBT2PION_PROBE_RESIDUAL",
        f.rel_path,
        1,
        1,
        "Stage A.5 residual probe identifier found in final output of " + f.rel_path,
      ))
    }
    let smap = match safe_map_by_file.get(f.rel_path) {
      Some(m) => m
      None => Map()
    }
    let fmap = match failed_map_by_file.get(f.rel_path) {
      Some(m) => m
      None => Map()
    }
    let audit_skip : Map[Int, Bool] = Map()
    for k in smap.keys() { audit_skip[k] = true }
    for k in fmap.keys() { audit_skip[k] = true }
    audit_undisposed_div_mod(f.rel_path, f.content, audit_skip, 0, 0, diags, drift_ledger)
    // Astra Round 5 P0-1: independent raw-token audit covering `.length()`, `.to_string()`,
    // `.val`, and `[i]` without sharing `find_receiver_start` / `is_non_expr_receiver`!
    audit_undisposed_raw_tokens(
      f.rel_path,
      f.content,
      audit_skip,
      0,
      0,
      declared_values,
      declared_types,
      qual_values,
      qual_types,
      diags,
      drift_ledger,
    )
  }

  (cur_files, total_rounds, total_instrumented, total_resolved)
}
