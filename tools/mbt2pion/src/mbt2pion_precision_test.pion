///| Unit tests for Stage B query-types caching, mutation_summary precision
///| (private pure map fields, top-level pure map/typed bindings, leading-dot/Option Eq,
///| local closure parameter scoping, String::split), and mbt_compat lowering
///| (MbtJson Debug, String::split().next(), interpolation expected-type isolation).

fn prec_make_qt_json(rel : String, entries : Array[(Int, Int, String)]) -> String {
  let parts : Array[String] = []
  for e in entries {
    parts.push("{\"start_byte\":" + e.0.to_string() + ",\"end_byte\":" + e.1.to_string() + ",\"ty\":\"" + e.2 + "\"}")
  }
  "{\"id\":1,\"ok\":true,\"diagnostics\":[],\"types\":[{\"file\":\"src/" + rel + "\",\"expr_tys\":[" + parts.join(",") + "],\"call_targets\":[]}]}"
}

test "Stage B round_qt: single RPC per round, per-file reuse, and E_UNKNOWN_PACKAGE guard" {
  let rel_a = "a.pion"
  let rel_b = "b.pion"
  let src_a = "fn run_a(xs : Array[Int]) -> Bool {\n  let _e = xs.is_empty()\n  xs.iter().any(fn(x) { x > 0 })\n}\n"
  let src_b = "fn run_b(ys : Array[Int]) -> Bool {\n  ys.iter().any(fn(y) { y > 0 })\n}\n"

  // Case 1: Normal multi-round lowering rewrites `xs.is_empty()` in Round 0,
  // then lowers `xs.iter()` / `ys.iter()` in Round 1. Verify at most 1 qt RPC per round
  // (never double-fetching in the same round) and 0 extra RPCs once clean.
  let qt_calls : Array[Int] = [0]
  let check_calls : Array[Int] = [0]
  let make_diags_json = fn(batch : Array[(String, String)]) -> String {
    let items : Array[String] = []
    for f in batch {
      let path = f.0
      let src = f.1
      let off1 = src.index_of(".is_empty()")
      if off1 >= 0 {
        let (ln, col) = byte_offset_to_line_col(src, off1 + 1)
        items.push("{\"code\":\"E_TYPE_MISMATCH\",\"file\":\"src/" + path + "\",\"line\":" + ln.to_string() + ",\"col\":" + col.to_string() + ",\"message\":\"unknown method `is_empty` on type `Array[Int]`\"}")
      }
      let off2 = src.index_of(".iter()")
      if off2 >= 0 {
        let (ln, col) = byte_offset_to_line_col(src, off2 + 1)
        items.push("{\"code\":\"E_TYPE_MISMATCH\",\"file\":\"src/" + path + "\",\"line\":" + ln.to_string() + ",\"col\":" + col.to_string() + ",\"message\":\"unknown method `iter` on type `Array[Int]`\"}")
      }
    }
    "[" + items.join(",") + "]"
  }
  let check_cb = fn(batch : Array[(String, String)]) -> String {
    check_calls[0] = check_calls[0] + 1
    "{\"diagnostics\":" + make_diags_json(batch) + "}"
  }
  let qt_cb = fn(batch : Array[(String, String)]) -> String {
    qt_calls[0] = qt_calls[0] + 1
    let mut first = true
    let sb = StringBuilder()
    sb.write_string("{\"id\":1,\"ok\":true,\"diagnostics\":")
    sb.write_string(make_diags_json(batch))
    sb.write_string(",\"types\":[")
    for f in batch {
      if !first { sb.write_string(",") }
      first = false
      sb.write_string("{\"file\":\"src/" + f.0 + "\",\"expr_tys\":[],\"call_targets\":[]}")
    }
    sb.write_string("]}")
    sb.to_string()
  }
  let files = [
    GeneratedFile::{ rel_path: rel_a, content: src_a, source_file: "a.mbt", anchors: [] },
    GeneratedFile::{ rel_path: rel_b, content: src_b, source_file: "b.mbt", anchors: [] },
  ]
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let (out_files, _iters, _hist, _out_qt) = run_stage_b_with_ops_deps_and_qt(
    files,
    ApiMap::{ symbols: [], pkg_aliases: Map() },
    Map(),
    Map(),
    check_cb,
    Some(qt_cb),
    empty_pkg_query_types(),
    diags,
    ledger,
  )
  assert_true(diags.length() == 0, "multi-file Stage B with cached qt must succeed")
  assert_true(str_has(out_files[0].content, "mbt_compat::arr_iter(xs)"), "a.pion iter lowered")
  assert_true(str_has(out_files[1].content, "mbt_compat::arr_iter(ys)"), "b.pion iter lowered")
  assert_true(qt_calls[0] <= 2, "at most 1 qt RPC per round with capacity work, got " + qt_calls[0].to_string())

  // Case 2: E_UNKNOWN_PACKAGE guard prevents repeated qt refresh loops when an external package is missing.
  let qt_calls_unk : Array[Int] = [0]
  let check_unk = fn(_batch : Array[(String, String)]) -> String {
    "{\"diagnostics\":[{\"code\":\"E_UNKNOWN_PACKAGE\",\"file\":\"src/a.pion\",\"line\":1,\"col\":1,\"message\":\"unknown package `dep`\"}]}"
  }
  let qt_unk = fn(_batch : Array[(String, String)]) -> String {
    qt_calls_unk[0] = qt_calls_unk[0] + 1
    "{\"id\":1,\"ok\":false,\"diagnostics\":[{\"code\":\"E_UNKNOWN_PACKAGE\",\"file\":\"src/a.pion\",\"line\":1,\"col\":1,\"message\":\"unknown package `dep`\"}],\"types\":[]}"
  }
  let diags_unk : Array[Diag] = []
  let ledger_unk : Array[DriftEntry] = []
  let _ = run_stage_b_with_ops_deps_and_qt(
    [GeneratedFile::{ rel_path: rel_a, content: src_a, source_file: "a.mbt", anchors: [] }],
    ApiMap::{ symbols: [], pkg_aliases: Map() },
    Map(),
    Map(),
    check_unk,
    Some(qt_unk),
    empty_pkg_query_types(),
    diags_unk,
    ledger_unk,
  )
  assert_true(qt_calls_unk[0] <= 1, "E_UNKNOWN_PACKAGE must not trigger repeated qt refreshes, got " + qt_calls_unk[0].to_string())
}

test "mutation_summary: pure_map_fields positive and all fail-closed negatives" {
  // Positive: private mbt_compat::OrderedMap field on non-pub(all) non-generic struct,
  // initialized via ordered_map_new(), mutated via index/remove, copied from same struct field, and same-struct spread `Tracker::{ ..self }`.
  let pos_src = "pub struct Tracker {\n  mut group_reads : mbt_compat::OrderedMap[Int, (Bool, Array[Int])]\n}\n\nfn Tracker::new() -> Tracker {\n  Tracker::{ group_reads: mbt_compat::ordered_map_new() }\n}\n\nfn Tracker::set_group(self : Tracker, id : Int, g : Bool, hs : Array[Int]) -> Unit {\n  self.group_reads[id] = (g, hs)\n}\n\nfn Tracker::clear_group(self : Tracker, id : Int) -> Unit {\n  self.group_reads.remove(id)\n}\n\nfn Tracker::copy_from(self : Tracker, o : Tracker) -> Unit {\n  let _held = Tracker::{ ..self }\n  self.group_reads = o.group_reads\n}\n\nfn Tracker::reads_under(self : Tracker, id : Int, depth : Int) -> Bool {\n  match self.group_reads.get(id) {\n    Some((glass, heads)) => glass || depth > 8 || heads.iter().any(fn(g) { self.reads_under(g, depth + 1) })\n    Option::None => true\n  }\n}\n"
  let rel = "tracker.pion"
  let heads_off = pos_src.index_of("heads.iter()")
  let qt = parse_pkg_query_types_json(prec_make_qt_json(rel, [(heads_off, heads_off + 5, "Array[Int]")]))
  let pkg_pos = collect_pkg_mutation_summary([lex_moonbit(pos_src)], [rel], [pos_src], qt, Map(), Map())
  assert_true(pkg_pos.pure_map_fields.contains("Tracker::group_reads"), "Tracker::group_reads must be proven pure")
  match lookup_fn_mutation_summary(pkg_pos, "Tracker::reads_under") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "Tracker::reads_under must be pure")
    None => assert_true(false, "Tracker::reads_under summary must exist")
  }

  // Neg 1: pub(all) struct -> external code can construct with new_by -> fail-closed!
  let neg_pub_all = "pub(all) struct S1 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S1::new() -> S1 { S1::{ m: mbt_compat::ordered_map_new() } }\nfn S1::has(self : S1, k : Int) -> Bool { self.m.contains(k) }\n"
  let p1 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_pub_all)])
  assert_true(!p1.pure_map_fields.contains("S1::m"), "pub(all) struct field must be fail-closed")
  assert_true(match lookup_fn_mutation_summary(p1, "S1::has") { Some(s) => s.unknown, None => false }, "S1::has must fail-closed")

  // Neg 2: pub field on non-pub(all) struct -> external write possible -> fail-closed!
  let neg_pub_field = "pub struct S2 {\n  pub mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S2::new() -> S2 { S2::{ m: mbt_compat::ordered_map_new() } }\nfn S2::has(self : S2, k : Int) -> Bool { self.m.contains(k) }\n"
  let p2 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_pub_field)])
  assert_true(!p2.pure_map_fields.contains("S2::m"), "pub field must be fail-closed")

  // Neg 3: initialized via new_by -> fail-closed!
  let neg_new_by = "pub struct S3 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S3::new() -> S3 { S3::{ m: OrderedMap::new_by(fn(k) { k }, fn(a, b) { a == b }) } }\nfn S3::has(self : S3, k : Int) -> Bool { self.m.contains(k) }\n"
  let p3 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_new_by)])
  assert_true(!p3.pure_map_fields.contains("S3::m"), "new_by field init must be fail-closed")

  // Neg 4: untyped struct update `{ ..ext, x: 1 }` and spread with bad override -> fail-closed!
  let neg_update = "pub struct S4 {\n  mut x : Int\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S4::upd(ext : S4) -> S4 { { ..ext, x: 1 } }\nfn S4::has(self : S4, k : Int) -> Bool { self.m.contains(k) }\n"
  let p4 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_update)])
  assert_true(!p4.pure_map_fields.contains("S4::m"), "untyped struct update { ..ext } must be fail-closed")
  let neg_update_override = "pub struct S4b {\n  mut x : Int\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S4b::upd(self : S4b, pm : mbt_compat::OrderedMap[Int, Int]) -> S4b { S4b::{ ..self, m: pm } }\nfn S4b::has(self : S4b, k : Int) -> Bool { self.m.contains(k) }\n"
  let p4b = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_update_override)])
  assert_true(!p4b.pure_map_fields.contains("S4b::m"), "struct spread with param override must be fail-closed")

  // Neg 5: assigned from function param -> fail-closed!
  let neg_param = "pub struct S5 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S5::set_m(self : S5, pm : mbt_compat::OrderedMap[Int, Int]) -> Unit { self.m = pm }\nfn S5::has(self : S5, k : Int) -> Bool { self.m.contains(k) }\n"
  let p5 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_param)])
  assert_true(!p5.pure_map_fields.contains("S5::m"), "field assigned from param must be fail-closed")

  // Neg 6: unknown receiver write `unk.m = pm` -> fail-closed!
  let neg_unk_recv = "pub struct S6 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S6::new() -> S6 { S6::{ m: mbt_compat::ordered_map_new() } }\nfn tamper(u : UnknownType, pm : mbt_compat::OrderedMap[Int, Int]) -> Unit { u.m = pm }\nfn S6::has(self : S6, k : Int) -> Bool { self.m.contains(k) }\n"
  let p6 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_unk_recv)])
  assert_true(!p6.pure_map_fields.contains("S6::m"), "unknown receiver write to .m must be fail-closed")

  // Neg 7: multiline continuation `self.m = ordered_map_new()\n |> wrap(ext)` -> fail-closed!
  let neg_multiline = "pub struct S7 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn wrap(a : mbt_compat::OrderedMap[Int, Int], b : mbt_compat::OrderedMap[Int, Int]) -> mbt_compat::OrderedMap[Int, Int] { b }\nfn S7::bad(self : S7, ext : mbt_compat::OrderedMap[Int, Int]) -> Unit {\n  self.m = mbt_compat::ordered_map_new()\n  |> wrap(ext)\n}\nfn S7::has(self : S7, k : Int) -> Bool { self.m.contains(k) }\n"
  let p7 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_multiline)])
  assert_true(!p7.pure_map_fields.contains("S7::m"), "multiline pipe continuation must be fail-closed")

  // Neg 8: `&mut self.m` -> fail-closed!
  let neg_mut_ref = "pub struct S8 {\n  mut m : mbt_compat::OrderedMap[Int, Int]\n}\nfn S8::new() -> S8 { S8::{ m: mbt_compat::ordered_map_new() } }\nfn S8::leak(self : S8) -> Unit { take_mut(&mut self.m) }\nfn S8::has(self : S8, k : Int) -> Bool { self.m.contains(k) }\n"
  let p8 = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_mut_ref)])
  assert_true(!p8.pure_map_fields.contains("S8::m"), "&mut self.m must be fail-closed")
}

test "mutation_summary: pure_map_globals, top_level_var_types, and shadowing negatives" {
  let src = "let pure_tbl : mbt_compat::OrderedMap[Int, String] = mbt_compat::ordered_map_new()\nlet mut mut_tbl : mbt_compat::OrderedMap[Int, String] = mbt_compat::ordered_map_new()\nlet voided : Array[(Int, String)] = []\n\nstruct CustomEq { id : Int }\nimpl Eq for CustomEq {\n  fn op_eq(self : CustomEq, other : CustomEq) -> Bool { self.id == other.id }\n}\n\nfn read_pure_global(k : Int) -> Option[String] {\n  pure_tbl.get(k)\n}\n\nfn read_mut_global(k : Int) -> Option[String] {\n  mut_tbl.get(k)\n}\n\nfn shadow_global_with_param(pure_tbl : mbt_compat::OrderedMap[Int, String], k : Int) -> Option[String] {\n  pure_tbl.get(k)\n}\n\nfn check_voided(target : Int) -> Bool {\n  let waits = fn(id) { voided.iter().any(fn(v) { v.0 == id }) }\n  waits(target)\n}\n"
  let pkg = collect_pkg_mutation_summary_tokens([lex_moonbit(src)])
  assert_true(pkg.pure_map_globals.contains("pure_tbl"), "immutable pure_tbl must be in pure_map_globals")
  assert_true(!pkg.pure_map_globals.contains("mut_tbl"), "mut_tbl must NOT be in pure_map_globals")
  assert_true(match lookup_fn_mutation_summary(pkg, "read_pure_global") { Some(s) => !s.unknown, None => false }, "read_pure_global must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "read_mut_global") { Some(s) => s.unknown, None => false }, "read_mut_global must fail-closed")
  assert_true(match lookup_fn_mutation_summary(pkg, "shadow_global_with_param") { Some(s) => s.unknown, None => false }, "param shadowing pure_tbl must fail-closed")
  assert_true(match lookup_fn_mutation_summary(pkg, "check_voided") { Some(s) => !s.unknown && !s.mutates_any_array, None => false }, "top-level typed Array[(Int, String)] + homogeneous == must be pure")
}

test "mutation_summary: leading-dot enum, Some/None Eq, trailing comma, closure params, String::split, and pure_map_ret_fns" {
  let src = "enum Mode {\n  UseNode\n  Other(Int)\n} derive(Eq)\n\nstruct WithTrailing {\n  items : Array[(Int, Bool),]\n} derive(Eq)\n\nstruct Custom { xs : Array[Int] }\nimpl Eq for Custom {\n  fn op_eq(self : Custom, other : Custom) -> Bool { self.xs.clear(); true }\n}\n\nfn flip_key_set(ks : Array[Int]) -> mbt_compat::OrderedMap[Int, Unit] {\n  let m : mbt_compat::OrderedMap[Int, Unit] = mbt_compat::ordered_map_new()\n  for k in ks {\n    m[k] = ()\n  }\n  m\n}\n\nfn flip_check(was : Array[Int], ks : Array[Int]) -> Bool {\n  let ks_set = flip_key_set(ks)\n  !was.iter().any(fn(k) { !ks_set.contains(k) })\n}\n\nfn check_eq_dot(m : Mode) -> Bool {\n  m == .UseNode && m == .Other(1)\n}\n\nfn check_eq_opt(ce : Option[Mode]) -> Bool {\n  ce == Some(.UseNode) && ce != None && ce != Option::None\n}\n\nfn check_eq_trailing(wt : WithTrailing, wts : Array[WithTrailing]) -> Bool {\n  wts.iter().any(fn(old) { old == wt })\n}\n\nfn check_closure_split(s : String) -> Bool {\n  let local_fn = fn(n : Int, text : String) -> Bool {\n    text.split(\" \").any(fn(v) { v.to_owned() == \"ok\" }) && n >= 0\n  }\n  local_fn(1, s)\n}\n\nfn bad_closure_param_shadow() -> Bool {\n  let m : mbt_compat::OrderedMap[Int, Int] = mbt_compat::ordered_map_new()\n  let f = fn(m : mbt_compat::OrderedMap[Int, Int]) -> Bool { m.contains(1) }\n  f(m)\n}\n\nfn pure_mbt_compat_helpers(s : String, j : mbt_compat::MbtJson) -> Bool {\n  let _ = mbt_compat::str_split_first(s, \",\")\n  let _ = mbt_compat::mbt_json_debug(j)\n  true\n}\n"
  let pkg = collect_pkg_mutation_summary_tokens([lex_moonbit(src)])
  assert_true(pkg.pure_map_ret_fns.contains("flip_key_set"), "flip_key_set returning mbt_compat::OrderedMap must be in pure_map_ret_fns")
  assert_true(match lookup_fn_mutation_summary(pkg, "flip_check") { Some(s) => !s.unknown && !s.mutates_any_array, None => false }, "flip_check must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "check_eq_dot") { Some(s) => !s.unknown, None => false }, "leading-dot enum Eq must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "check_eq_opt") { Some(s) => !s.unknown, None => false }, "Some/None Eq must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "check_eq_trailing") { Some(s) => !s.unknown, None => false }, "trailing-comma derive(Eq) must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "check_closure_split") { Some(s) => !s.unknown, None => false }, "local closure params + String::split must be pure")
  assert_true(match lookup_fn_mutation_summary(pkg, "bad_closure_param_shadow") { Some(s) => s.unknown, None => false }, "closure param shadowing pure map local must fail-closed")
  assert_true(match lookup_fn_mutation_summary(pkg, "pure_mbt_compat_helpers") { Some(s) => !s.unknown, None => false }, "str_split_first and mbt_json_debug must be pure RO")
}

test "Stage B str_split_first lowering positive and fail-closed negative" {
  let pos_src = "fn first_tok(s : String) -> Option[String] {\n  s.split(\",\").next()\n}\n"
  let neg_src = "fn arr_next(xs : Array[String]) -> Option[String] {\n  xs.next()\n}\n"
  let mk_check = fn(batch : Array[(String, String)]) -> String {
    let items : Array[String] = []
    for f in batch {
      let off = f.1.index_of(".next()")
      if off >= 0 {
        let (ln, col) = byte_offset_to_line_col(f.1, off + 1)
        items.push("{\"code\":\"E_TYPE_MISMATCH\",\"file\":\"src/" + f.0 + "\",\"line\":" + ln.to_string() + ",\"col\":" + col.to_string() + ",\"message\":\"unknown method `next` on type `Array[String]`\"}")
      }
    }
    "{\"diagnostics\":[" + items.join(",") + "]}"
  }
  let diags_pos : Array[Diag] = []
  let ledger_pos : Array[DriftEntry] = []
  let (out_pos, _it_p, _hist_p) = run_stage_b(
    [GeneratedFile::{ rel_path: "pos.pion", content: pos_src, source_file: "pos.mbt", anchors: [] }],
    ApiMap::{ symbols: [], pkg_aliases: Map() },
    mk_check,
    diags_pos,
    ledger_pos,
  )
  assert_true(diags_pos.length() == 0, "s.split(\",\").next() must lower cleanly")
  assert_true(str_has(out_pos[0].content, "mbt_compat::str_split_first(s, \",\")"), "must rewrite to mbt_compat::str_split_first")

  let diags_neg : Array[Diag] = []
  let ledger_neg : Array[DriftEntry] = []
  let (out_neg, _it_n, _hist_n) = run_stage_b(
    [GeneratedFile::{ rel_path: "neg.pion", content: neg_src, source_file: "neg.mbt", anchors: [] }],
    ApiMap::{ symbols: [], pkg_aliases: Map() },
    mk_check,
    diags_neg,
    ledger_neg,
  )
  assert_true(!str_has(out_neg[0].content, "str_split_first"), "must leave ordinary xs.next() untouched")
}

test "Stage A.5 MbtJson debug lowering and Stage A interpolation expected-type isolation" {
  match gen_debug_fmt_expr("v", "mbt_compat::MbtJson", 0) {
    Some(s) => assert_true(s == "mbt_compat::mbt_json_debug(v)", "gen_debug_fmt_expr for mbt_compat::MbtJson: " + s)
    None => assert_true(false, "gen_debug_fmt_expr must support mbt_compat::MbtJson")
  }
  match gen_debug_fmt_expr("v", "MbtJson", 0) {
    Some(s) => assert_true(s == "mbt_compat::mbt_json_debug(v)", "gen_debug_fmt_expr for MbtJson: " + s)
    None => assert_true(false, "gen_debug_fmt_expr must support MbtJson")
  }
  let src = "pub fn mk_json(flag : Bool) -> Json {\n  Json::string(\"prefix:\\{match flag { true => \"a\"; false => \"b\" }}\")\n}\n"
  let noop_check = fn(_batch : Array[(String, String)]) -> String { "{\"diagnostics\":[]}" }
  let res = transpile_package(
    [SourceFile::{ rel_path: "main.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let out = res.files[0].content
  assert_true(!str_has(out, "MbtJson::string(\"a\")"), "expected MbtJson type must not leak into string interpolation arms")
}

test "mutation_summary: canonical hashed mbt_compat OrderedMap recognized, external hashed pkg rejected" {
  assert_true(!ms_is_qualified_external_ty("mbt_compat__5958c766::OrderedMap[Int, (Bool, Array[Int])]"), "hashed mbt_compat canonical type must not be rejected as external")
  assert_true(ms_is_qualified_external_ty("evil__deadbeef::OrderedMap[Int, Int]"), "hashed external package must remain rejected")
  assert_true(ms_is_qualified_external_ty("evil::mbt_compat::OrderedMap[Int, Int]"), "nested mbt_compat under external package must remain rejected")
  let src = "struct Damage {\n  group_reads : mbt_compat::OrderedMap[Int, (Bool, Array[Int])]\n}\nfn Damage::new() -> Damage {\n  Damage::{ group_reads: mbt_compat::ordered_map_new() }\n}\nfn Damage::reads_under(self : Damage, id : Int) -> Bool {\n  match self.group_reads.get(id) {\n    Some((g, hs)) => g || hs.iter().any(fn(x) { self.reads_under(x) })\n    Option::None => true\n  }\n}\n"
  let recv_off = src.index_of("self.group_reads")
  let recv_end = recv_off + "self.group_reads".length()
  let heads_off = src.index_of("hs.iter()")
  let qt_json = "{\"id\":1,\"ok\":true,\"diagnostics\":[],\"types\":[{\"file\":\"src/occlude.pion\",\"expr_tys\":[{\"start_byte\":" + recv_off.to_string() + ",\"end_byte\":" + recv_end.to_string() + ",\"ty\":\"mbt_compat::OrderedMap[Int, (Bool, Array[Int])]\",\"ty_canon\":\"mbt_compat__5958c766::OrderedMap[Int, (Bool, Array[Int])]\"},{\"start_byte\":" + heads_off.to_string() + ",\"end_byte\":" + (heads_off + 2).to_string() + ",\"ty\":\"Array[Int]\"}],\"call_targets\":[]}]}"
  let pqt = parse_pkg_query_types_json(qt_json)
  let pkg = collect_pkg_mutation_summary([lex_moonbit(src)], ["occlude.pion"], [src], pqt, Map(), Map())
  match lookup_fn_mutation_summary(pkg, "Damage::reads_under") {
    Some(s) => assert_true(!s.unknown, "Damage::reads_under must be pure with canonical hashed mbt_compat::OrderedMap")
    None => assert_true(false, "missing Damage::reads_under summary")
  }
  // Multi-arm leading-dot match (`.PLinear(g)` on new line after `UpperIdent` / `Ident`) must not be treated as method call.
  let dot_src = "enum Units { UserSpaceOnUse\n  ObjectBoundingBox }\nenum Paint { PColor(Int)\n  PLinear(Units)\n  PRadial(Units) }\nfn Paint::units(self : Paint) -> Units {\n  match self {\n    .PColor(_) => .UserSpaceOnUse\n    .PLinear(u) => u\n    .PRadial(u) => u\n  }\n}\n"
  let dot_pkg = collect_pkg_mutation_summary_tokens([lex_moonbit(dot_src)])
  match lookup_fn_mutation_summary(dot_pkg, "Paint::units") {
    Some(s) => assert_true(!s.unknown, "Paint::units with multiline leading-dot match arms must be pure")
    None => assert_true(false, "missing Paint::units summary")
  }
}
