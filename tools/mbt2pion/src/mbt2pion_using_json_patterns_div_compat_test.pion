///| Unit tests for `using_values` return type inference, Map index/unwrap_or expected-type
///| propagation, Json literal typed-expr wrapping, newline-safe checked div/mod RHS scan,
///| nested float literal & empty-array or-patterns, nested Option match exhaustiveness,
///| cross-package enum rest patterns, multiline array concat, first-class `physical_equal`,
///| incomplete generic spread-array guards, and stdlib compat mappings.

test "item 1: using_values imported function return type inference and generic shadow guard" {
  let dep_src = SourceFile::{
    rel_path: "dep.mbt",
    content: "pub fn get_opt(x : Int) -> Json? {\n" +
    "  if x > 0 { Some(Json::null()) } else { None }\n" +
    "}\n" +
    "pub fn get_gen[T](x : T) -> T? {\n" +
    "  Some(x)\n" +
    "}\n",
    is_test: false,
  }
  let dep_res = transpile_package([dep_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(dep_res.blockers == 0, "dep transpile must succeed")
  let src = SourceFile::{
    rel_path: "use_ret.mbt",
    content: "using @dep { get_opt, get_gen }\n\n" +
    "pub fn copy_obj(x : Int) -> Map[String, Json] {\n" +
    "  let m = match get_opt(x) {\n" +
    "    Some(Object(obj)) => obj.copy()\n" +
    "    _ => {}\n" +
    "  }\n" +
    "  m\n" +
    "}\n\n" +
    "pub fn use_gen(x : Int) -> Int {\n" +
    "  match get_gen(x) {\n" +
    "    Some(v) => v\n" +
    "    None => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_with_abis([src], empty_api_map(), default_recipes(), [], [], [], [("dep", dep_res.abi)], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "use_ret blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "_ => mbt_compat::ordered_map_new()"), "using_values fn returning Option[Json] must lower _ => {} to ordered_map_new(): " + out)
  assert_true(!str_has(out, "Option[T]"), "generic using_values fn must not leak formal type parameter T: " + out)
}

test "item 2: map index/set, Option::unwrap_or expected type, and Json literal typed-expr wrapping" {
  let src = SourceFile::{
    rel_path: "json_prop.mbt",
    content: "pub struct Holder {\n" +
    "  st : Map[String, Json]\n" +
    "}\n\n" +
    "pub fn update_maps(st : Map[String, Json], h : Holder, plain : Map[String, String]) -> Unit {\n" +
    "  st[\"a\"] = { \"k\": 1 }\n" +
    "  st[\"b\"] = []\n" +
    "  st[\"c\"] = \"hi\"\n" +
    "  st.set(\"d\", { \"ok\": true })\n" +
    "  h.st[\"e\"] = []\n" +
    "  plain[\"k\"] = \"raw\"\n" +
    "}\n\n" +
    "pub fn with_unwrap(m : Map[Int, Json], o : Int?) -> (Json, Int) {\n" +
    "  let j = m.get(1).unwrap_or({ \"resolved\": false })\n" +
    "  let n = o.unwrap_or(0)\n" +
    "  (j, n)\n" +
    "}\n\n" +
    "pub fn build_json(name : String, score : Double, count : Int, flag : Bool, arr : Array[Json], obj : Map[String, Json], existing : Json) -> Json {\n" +
    "  let o : Json = { \"s\": name, \"d\": score, \"i\": count, \"b\": flag, \"a\": arr, \"m\": obj, \"j\": existing }\n" +
    "  let _ : Json = [name, score, count, flag, arr, obj, existing]\n" +
    "  o\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "json_prop blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "st[\"a\"] = mbt_compat::MbtJson::Object("), "st[k] = obj must propagate MbtJson: " + out)
  assert_true(str_has(out, "st[\"b\"] = mbt_compat::MbtJson::Array([])"), "st[k] = [] must propagate MbtJson: " + out)
  assert_true(str_has(out, "st[\"c\"] = mbt_compat::MbtJson::String(\"hi\")"), "st[k] = str must propagate MbtJson: " + out)
  assert_true(str_has(out, "st.set(\"d\", mbt_compat::MbtJson::Object("), "st.set(k, obj) must propagate MbtJson: " + out)
  assert_true(str_has(out, "h.st[\"e\"] = mbt_compat::MbtJson::Array([])"), "h.st[k] = [] must propagate MbtJson: " + out)
  assert_true(str_has(out, "plain[\"k\"] = \"raw\""), "Map[String, String] must not wrap string in MbtJson: " + out)
  assert_true(str_has(out, "m.get(1).unwrap_or(mbt_compat::MbtJson::Object("), "map.get(1).unwrap_or(obj) must propagate MbtJson: " + out)
  assert_true(str_has(out, "o.unwrap_or(0)"), "Option[Int]::unwrap_or(0) must not wrap Int in MbtJson: " + out)
  assert_true(str_has(out, "(\"s\", mbt_compat::MbtJson::String(name))"), "Json obj String expr must wrap: " + out)
  assert_true(str_has(out, "(\"d\", mbt_compat::MbtJson::number(score))"), "Json obj Double expr must wrap: " + out)
  assert_true(str_has(out, "(\"i\", mbt_compat::MbtJson::number((count).to_double()))"), "Json obj Int expr must wrap: " + out)
  assert_true(str_has(out, "(\"b\", mbt_compat::MbtJson::boolean(flag))"), "Json obj Bool expr must wrap: " + out)
  assert_true(str_has(out, "(\"a\", mbt_compat::MbtJson::array(arr))"), "Json obj Array[Json] expr must wrap: " + out)
  assert_true(str_has(out, "(\"m\", mbt_compat::MbtJson::object(obj))"), "Json obj Map[String, Json] expr must wrap: " + out)
  assert_true(str_has(out, "(\"j\", existing)"), "Json obj existing Json expr must not double-wrap: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::Array([mbt_compat::MbtJson::String(name), mbt_compat::MbtJson::number(score), mbt_compat::MbtJson::number((count).to_double()), mbt_compat::MbtJson::boolean(flag), mbt_compat::MbtJson::array(arr), mbt_compat::MbtJson::object(obj), existing])"), "Json array typed exprs must wrap cleanly: " + out)
}

test "item 3: checked div/mod RHS scan never crosses newline into next line [ or (" {
  let src = "pub fn f(a : Int, m : Int, n : Int) -> Array[Int] {\n" +
  "  let long = a * m / n\n" +
  "  [long, 2]\n" +
  "}\n\n" +
  "pub fn g(t : Int) -> String {\n" +
  "  let m = t % 60\n" +
  "  (t / 60).to_string() + m.to_string()\n" +
  "}\n\n" +
  "pub fn h(a : Int, xs : Array[Int]) -> Int {\n" +
  "  a / xs[0]\n" +
  "}\n"
  let (inst, sites) = instrument_probes_for_file("div_nl.pion", src)
  assert_true(str_has(inst, "(a * m).mbt_div_probe(n)"), "a * m / n must probe rhs `n` without crossing newline: " + inst)
  assert_true(str_has(inst, "[long, 2]"), "next line `[long, 2]` must remain intact: " + inst)
  assert_true(str_has(inst, "(t).mbt_mod_probe(60)"), "t % 60 must probe rhs `60` without crossing newline: " + inst)
  assert_true(str_has(inst, "(t).mbt_div_probe(60)"), "next line `(t / 60)` must remain intact: " + inst)
  assert_true(str_has(inst, "(a).mbt_div_probe(xs[0])"), "same-line `a / xs[0]` must still include `[0]` in RHS: " + inst)
  let mut saw_div_n = false
  let mut saw_mod_60 = false
  let mut saw_div_xs0 = false
  let d_diags : Array[Diag] = []
  let d_ledger : Array[DriftEntry] = []
  for s in sites {
    match rewrite_for_probe(s, "Int", default_recipes(), d_diags, d_ledger) {
      Some(rw) => {
        if rw == "mbt_compat::div_checked_i32(a * m, n)" { saw_div_n = true }
        if rw == "mbt_compat::mod_checked_i32(t, 60)" { saw_mod_60 = true }
        if rw == "mbt_compat::div_checked_i32(a, xs[0])" { saw_div_xs0 = true }
      }
      None => ()
    }
  }
  assert_true(saw_div_n, "must rewrite `a * m / n` to div_checked_i32(a * m, n)")
  assert_true(saw_div_xs0, "must rewrite `a / xs[0]` to div_checked_i32(a, xs[0])")
  let _ = saw_mod_60
}

test "item 4: nested float literal patterns, empty-array or-patterns, and nested Option exhaustiveness" {
  let src = SourceFile::{
    rel_path: "patterns.mbt",
    content: "pub fn match_flt(x : (Double, Int)?, flag : Bool) -> Int {\n" +
    "  match x {\n" +
    "    Some((-2.0, _)) => 1\n" +
    "    Some((1.5, n)) if flag => n\n" +
    "    Some((3.0, _)) | Some((-3.0, _)) => 2\n" +
    "    Some((-4.0 | 4.0, n)) => n + 10\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n\n" +
    "pub struct Pt { x : Double }\n\n" +
    "pub fn match_flt_skip(p : Pt, d : Double) -> Int {\n" +
    "  let a = match p {\n" +
    "    { x: 1.0 } => 1\n" +
    "    _ => 0\n" +
    "  }\n" +
    "  let b = match d {\n" +
    "    0.0..<1.0 => 2\n" +
    "    _ => 0\n" +
    "  }\n" +
    "  a + b\n" +
    "}\n\n" +
    "pub fn match_or_empty(j : Json?) -> Int {\n" +
    "  match j {\n" +
    "    Some(Array([])) | Some(Null) | None => 0\n" +
    "    _ => 1\n" +
    "  }\n" +
    "}\n\n" +
    "pub fn match_json_or_empty(j : Json) -> Bool {\n" +
    "  match j {\n" +
    "    Null | Array([]) => true\n" +
    "    _ => false\n" +
    "  }\n" +
    "}\n\n" +
    "pub fn match_opt_arr(opt : Array[Int]?) -> Int {\n" +
    "  match opt {\n" +
    "    None => 0\n" +
    "    Some([]) => 1\n" +
    "    Some(list) => list.length()\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "patterns blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "__mbt_flt_") && str_has(out, "== -2.0"), "nested negative float literal pattern must lower to __mbt_flt_N guard: " + out)
  assert_true(str_has(out, "== 1.5) && (flag)"), "existing guard must conjoin with float literal guard: " + out)
  assert_true(str_has(out, "== -4.0") && str_has(out, "== 4.0") && !str_has(out, "== -4.0 && "), "nested or-pattern (-4.0 | 4.0) must split into independent arms with separate guards: " + out)
  let skip_idx = out.index_of("pub fn match_flt_skip")
  assert_true(skip_idx > 0, "must emit match_flt_skip")
  let skip_part = out.slice(skip_idx, out.index_of("pub fn match_or_empty"))
  assert_true(str_has(skip_part, ".x == 1.0") && !str_has(skip_part, "__mbt_flt_"), "struct pattern { x: 1.0 } and range 0.0..<1.0 must skip B2d: " + skip_part)
  assert_true(str_has(skip_part, "0.0..<1.0"), "range pattern 0.0..<1.0 must not be corrupted by B2d: " + skip_part)
  assert_true(!str_has(out, "Array([])"), "or-pattern with empty Array([]) must never emit illegal Array([]): " + out)
  assert_true(str_has(out, ".length() == 0"), "empty Array([]) alternative must lower to length() == 0 guard: " + out)
  let opt_idx = out.index_of("pub fn match_opt_arr")
  assert_true(opt_idx > 0, "must emit match_opt_arr")
  let opt_part = out.slice(opt_idx, out.length())
  assert_true(str_has(opt_part, "_ => panic(\"unreachable\")"), "nested Option match after None arm must append _ => panic(\"unreachable\"): " + opt_part)
}

test "item 5: cross-package enum rest pattern expands to exact variant arity" {
  let dep_src = SourceFile::{
    rel_path: "dep.mbt",
    content: "pub enum Named {\n" +
    "  Chat(String, Int, Bool, String)\n" +
    "  Plain(Int)\n" +
    "}\n\n" +
    "pub enum Kind {\n" +
    "  Quoted(String, String, Int, Bool)\n" +
    "  Marked(Int, String, Bool, Double)\n" +
    "}\n",
    is_test: false,
  }
  let dep_res = transpile_package([dep_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(dep_res.blockers == 0, "dep enum transpile must succeed")
  let src = SourceFile::{
    rel_path: "rest_pat.mbt",
    content: "using @dep { type Named, type Kind }\n\n" +
    "pub fn check_named(n : Named) -> Int {\n" +
    "  match n {\n" +
    "    Named::Chat(..) => 1\n" +
    "    @dep.Named::Chat(a, ..) => a.length()\n" +
    "    Named::Plain(_) => 0\n" +
    "  }\n" +
    "}\n\n" +
    "pub fn check_kind(k : Kind) -> Int {\n" +
    "  match k {\n" +
    "    Quoted(..) => 1\n" +
    "    Marked(x, ..) => x\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_with_abis([src], empty_api_map(), default_recipes(), [], [], [], [("dep", dep_res.abi)], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "rest_pat blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "dep::Named::Chat(_, _, _, _)"), "Named::Chat(..) must expand to 4 wildcards: " + out)
  assert_true(str_has(out, "dep::Named::Chat(a, _, _, _)"), "@dep.Named::Chat(a, ..) must expand to (a, _, _, _): " + out)
  assert_true(str_has(out, "Quoted(_, _, _, _)"), "Quoted(..) must expand to 4 wildcards: " + out)
  assert_true(str_has(out, "Marked(x, _, _, _)"), "Marked(x, ..) must expand to (x, _, _, _): " + out)
}

test "item 6: stage B multiline array concat rewrite across >32 lines and closing brace" {
  let sb = StringBuilder()
  sb.write_string("pub fn build(rhs : Array[Int]) -> Array[Int] {\n")
  sb.write_string("  let xs = [\n")
  let mut k = 0
  while k < 36 {
    sb.write_string("    " + k.to_string() + ",\n")
    k = k + 1
  }
  sb.write_string("  ] +\n")
  sb.write_string("  rhs\n")
  sb.write_string("  xs\n")
  sb.write_string("}\n")
  let pion_src = sb.to_string()
  let files = [GeneratedFile::{ rel_path: "ml_concat.pion", source_file: "ml_concat.mbt", content: pion_src, anchors: [] }]
  let mock_check : (Array[(String, String)]) -> String = fn(fs) {
    let lines = fs[0].1.split("\n")
    let mut li = 0
    while li < lines.length() {
      let ln = lines[li]
      if str_has(ln, "] +") {
        let c = ln.index_of("+") + 1
        return "{\"diagnostics\":[{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"ml_concat.pion\",\"line\":" + (li + 1).to_string() + ",\"col\":" + c.to_string() + ",\"message\":\"operator `+` is not supported on `Array[Int]`\"}]}"
      }
      li = li + 1
    }
    "{\"diagnostics\":[]}"
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let (out_files, _, _) = run_stage_b(files, empty_api_map(), mock_check, diags, ledger)
  let out = out_files[0].content
  assert_true(str_has(out, "mbt_compat::arr_concat(["), "multiline >32-line array concat must rewrite to arr_concat: " + out)
  assert_true(str_has(out, "], rhs)"), "arr_concat must capture multiline rhs cleanly: " + out)
}

test "item 7: first-class physical_equal closure wrapper and incomplete generic spread guard" {
  let src = SourceFile::{
    rel_path: "pe_spread.mbt",
    content: "pub fn use_pe(a : Int, b : Int) -> Bool {\n" +
    "  let f = physical_equal\n" +
    "  let _ = f(a, b)\n" +
    "  physical_equal(a, b)\n" +
    "}\n\n" +
    "pub fn shadowed_pe(physical_equal : Int) -> Int {\n" +
    "  physical_equal\n" +
    "}\n\n" +
    "pub fn spread_opt(xs : Array[Int?], m : Map[Int, Int]) -> Array[Int?] {\n" +
    "  let res : Array[Int?] = [..xs, m.get(1)]\n" +
    "  res\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "pe_spread blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "let f = fn(__mbt_pe_a, __mbt_pe_b) { physical_equal(__mbt_pe_a, __mbt_pe_b) }"), "first-class physical_equal must wrap in closure: " + out)
  assert_true(str_has(out, "physical_equal(a, b)"), "direct physical_equal(a, b) call must not be wrapped: " + out)
  let sh_idx = out.index_of("pub fn shadowed_pe")
  assert_true(sh_idx > 0, "must emit shadowed_pe")
  assert_true(!str_has(out.slice(sh_idx, out.index_of("pub fn spread_opt")), "__mbt_pe_a"), "shadowed physical_equal must not be wrapped: " + out)
  assert_true(!is_liftable_static_type("Array[Option]"), "is_liftable_static_type must reject Array[Option]")
  assert_true(!is_liftable_static_type("Array[Map]"), "is_liftable_static_type must reject Array[Map]")
  assert_true(!is_liftable_static_type("Array[OrderedMap]"), "is_liftable_static_type must reject Array[OrderedMap]")
  assert_true(is_liftable_static_type("Array[Option[Int]]"), "is_liftable_static_type must accept Array[Option[Int]]")
  assert_true(!str_has(out, ": Array[Option]"), "spread array must never emit illegal : Array[Option]: " + out)
}

test "item 8: stdlib compat mappings, Array::count zero-arg guard, and mutation_summary registration" {
  assert_true(match lookup_missing_method_helper("String", "trim_start") { Some(s) => s == "mbt_compat::str_trim_start", None => false }, "String::trim_start")
  assert_true(match lookup_missing_method_helper("String", "trim_end") { Some(s) => s == "mbt_compat::str_trim_end", None => false }, "String::trim_end")
  assert_true(match lookup_missing_method_helper("String", "strip_prefix") { Some(s) => s == "mbt_compat::str_strip_prefix", None => false }, "String::strip_prefix")
  assert_true(match lookup_missing_method_helper("String", "clamped_view") { Some(s) => s == "mbt_compat::str_clamped_view", None => false }, "String::clamped_view")
  assert_true(match lookup_missing_method_helper("Int64", "compare") { Some(s) => s == "mbt_compat::i64_compare", None => false }, "Int64::compare")
  assert_true(match lookup_missing_method_helper("Array[Int]", "find_first") { Some(s) => s == "mbt_compat::arr_find_first", None => false }, "Array::find_first")
  assert_true(match lookup_missing_method_helper("Array[Int]", "exact_view") { Some(s) => s == "mbt_compat::arr_exact_view", None => false }, "Array::exact_view")
  assert_true(match lookup_missing_method_helper("Array[Int]", "to_owned") { Some(s) => s == "mbt_compat::arr_copy", None => false }, "Array::to_owned")
  assert_true(match lookup_missing_method_helper("Array[Int]", "count") { None => true, Some(_) => false }, "Array::count handled by 0-arg guard")
  assert_true(match rewrite_array_count_zero_arg_at("  let n = xs.filter(f).count()", 24) { Some(s) => s == "  let n = xs.filter(f).length()", None => false }, "0-arg Array::count() rewrites to .length()")
  assert_true(match rewrite_array_count_zero_arg_at("  let n = xs.count(pred)", 14) { None => true, Some(_) => false }, "1-arg Array::count(pred) must not rewrite to .length()")
  assert_true(ms_is_mbt_compat_pure_ro("str_trim_start"), "str_trim_start must be pure_ro")
  assert_true(ms_is_mbt_compat_pure_ro("str_strip_prefix"), "str_strip_prefix must be pure_ro")
  assert_true(ms_is_mbt_compat_pure_ro("i64_compare"), "i64_compare must be pure_ro")
  assert_true(!ms_is_mbt_compat_pure_ro("arr_exact_view"), "arr_exact_view returns live shared ArrayView and must stay fail-closed like arr_view")
  assert_true(ms_is_mbt_compat_hof_ro("arr_find_first"), "arr_find_first must be hof_ro")
}
