///| Core data structures and deterministic helpers for the project-agnostic
///| MoonBit -> Pion transpiler (`mbt2pion`).

import "json" as json

///| Source span in a `.mbt` file (byte offsets + 1-based line/col).
pub struct Span {
  file : String
  start_byte : Int
  end_byte : Int
  line : Int
  col : Int
  end_line : Int
  end_col : Int
}

pub fn span_new(
  file : String,
  start_byte : Int,
  end_byte : Int,
  line : Int,
  col : Int,
  end_line : Int,
  end_col : Int,
) -> Span {
  Span::{ file: file, start_byte: start_byte, end_byte: end_byte, line: line, col: col, end_line: end_line, end_col: end_col }
}

pub fn span_empty(file : String) -> Span {
  span_new(file, 0, 0, 1, 1, 1, 1)
}

///| Mapping between an original MoonBit source span and a generated Pion output span.
pub struct SpanMapEntry {
  src_file : String
  src_start : Int
  src_end : Int
  src_line : Int
  src_col : Int
  out_file : String
  out_line : Int
  out_col : Int
  out_start : Int
  out_end : Int
  kind : String
}

///| Structured transpiler diagnostic.
pub struct Diag {
  severity : String
  code : String
  file : String
  line : Int
  col : Int
  message : String
}

pub fn diag_error(code : String, file : String, line : Int, col : Int, message : String) -> Diag {
  Diag::{ severity: "error", code: code, file: file, line: line, col: col, message: message }
}

pub fn diag_warn(code : String, file : String, line : Int, col : Int, message : String) -> Diag {
  Diag::{ severity: "warning", code: code, file: file, line: line, col: col, message: message }
}

///| One entry in `semantic_drift_ledger.json`.
pub struct DriftEntry {
  category : String
  file : String
  line : Int
  col : Int
  expr : String
  resolution : String
  status : String
  detail : String
}

///| One entry in the source-span disposition matrix of `migration_report.json`.
pub struct DispositionEntry {
  file : String
  decl : String
  line : Int
  col : Int
  disposition : String
  detail : String
}

///| Platform-neutral header metadata. Never contains host binary hashes or timings.
pub struct HeaderMeta {
  mbt2pion_commit : String
  toolchain_lock : String
  source_commit : String
  api_map_sha256 : String
  recipes_sha256 : String
  abi_sha256 : String
  target : String
}

pub fn default_header_meta(target : String) -> HeaderMeta {
  HeaderMeta::{
    mbt2pion_commit: "dev",
    toolchain_lock: "unpinned",
    source_commit: "working-tree",
    api_map_sha256: "none",
    recipes_sha256: "none",
    abi_sha256: "",
    target: target,
  }
}

///| Input source file (relative path inside `--src`, plus verbatim UTF-8 content).
pub struct SourceFile {
  rel_path : String
  content : String
  is_test : Bool
}

///| Generated `.pion` file with declaration anchors for overlay matching.
pub struct DeclAnchor {
  source_file : String
  decl_identity : String
  normalized_source_cst_hash : String
  pre_overlay_generated_hash : String
  start_byte : Int
  end_byte : Int
  line : Int
  col : Int
}

pub struct GeneratedFile {
  rel_path : String
  content : String
  source_file : String
  anchors : Array[DeclAnchor]
}

///| Parameter descriptor in `api_map.json` or symbol tables.
pub struct ApiParam {
  name : String
  ty : String
  is_optional : Bool
  has_default : Bool
  unit : String
  str_param : String
  map_boundary : String
}

///| Cross-package API mapping entry loaded from `--api-map`.
pub struct ApiSymbol {
  src_pkg : String
  src_name : String
  kind : String
  target_pkg : String
  target_name : String
  target_enum : String
  arity : Int
  params : Array[ApiParam]
  ret_ty : String
  ret_unit : String
  ret_map_boundary : String
  autofill_loc : Bool
  external_tilde_default : Bool
}

pub struct ApiMap {
  symbols : Array[ApiSymbol]
  pkg_aliases : Map[String, String]
}

pub fn empty_api_map() -> ApiMap {
  ApiMap::{ symbols: [], pkg_aliases: Map() }
}

///| Declarative recipes loaded from `--recipes` (zero hardcoded project identifiers).
pub struct RefRecipe {
  enabled : Bool
  ctor_call : String
  field_name : String
  type_name : String
}

pub struct TraitRecipe {
  derive_name : String
  target_trait : String
  method_name : String
  kind : String
}

pub struct EqRecipe {
  wrapper_call : String
  helper_prefix : String
}

pub struct AssetBypassRule {
  path : String
  sha256 : String
  reason : String
  allowed_decls : Array[String]
}

///| Declarative `[comments]` redaction rule (`replace = [{ from = "...", to = "..." }]`).
pub struct CommentReplaceRule {
  from : String
  to : String
}

pub struct Recipes {
  ref_recipe : RefRecipe
  trait_recipes : Array[TraitRecipe]
  eq_recipe : EqRecipe
  allowed_derives : Array[String]
  ignored_derives : Array[String]
  asset_bypass : Array[AssetBypassRule]
  comment_replaces : Array[CommentReplaceRule]
}

pub fn default_recipes() -> Recipes {
  Recipes::{
    ref_recipe: RefRecipe::{ enabled: false, ctor_call: "", field_name: "v", type_name: "" },
    trait_recipes: [],
    eq_recipe: EqRecipe::{ wrapper_call: "", helper_prefix: "__mbt_eq_" },
    allowed_derives: ["Eq", "Hash"],
    ignored_derives: ["Debug"],
    asset_bypass: [],
    comment_replaces: [],
  }
}

///| Cross-package ABI metadata types (serialized into `mbt2pion_abi.json`).
pub struct AbiEnumField {
  label : String
  ty : String
}

pub struct AbiEnumVariant {
  name : String
  fields : Array[AbiEnumField]
}

pub struct AbiEnumSchema {
  pkg : String
  name : String
  can_match : Bool
  can_construct : Bool
  variants : Array[AbiEnumVariant]
}

pub struct AbiStructValRename {
  pkg : String
  struct_name : String
  renamed_field : String
}

///| Exported field metadata for a cross-package struct (in exact declaration order).
pub struct AbiStructField {
  src_name : String
  emit_name : String
  is_mut : Bool
  visibility : String
  ty : String
}

///| Exported cross-package struct metadata for ABI v2.
pub struct AbiStructSchema {
  pkg : String
  name : String
  type_params : Array[String]
  fields : Array[AbiStructField]
  can_construct : Bool
  can_update : Bool
  complete : Bool
}

pub struct AbiCompanionSpec {
  name : String
  source : String
  sha256 : String
}

pub struct AbiCompanionFile {
  path : String
  sha256 : String
}

pub struct OpImplEntry {
  pkg : String
  type_name : String
  op : String
  fn_name : String
}

pub struct AbiReexport {
  name : String
  kind : String
  target_pkg : String
  target_name : String
}

pub struct AbiValueSchema {
  name : String
  ty : String
}

pub struct AbiRaisingFn {
  name : String
  err_ty : String
}

pub struct PackageAbi {
  package_name : String
  enums : Array[AbiEnumSchema]
  struct_val_fields : Array[AbiStructValRename]
  structs : Option[Array[AbiStructSchema]]
  companion_files : Array[AbiCompanionFile]
  op_impls : Array[OpImplEntry]
  reexports : Array[AbiReexport]
  values : Array[AbiValueSchema]
  raising_fns : Array[AbiRaisingFn]
  ffi_shim_prefix : String
  publishable : Bool
  empty_target_pkg : Bool
}

pub fn empty_package_abi(pkg_name : String) -> PackageAbi {
  PackageAbi::{
    package_name: pkg_name,
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
  }
}

///| Registered tool-generated `.val` placeholder site (Astra v2 P1-3).
pub struct ValProbeSite {
  site_id : Int
  placeholder_ident : String
  file : String
  line : Int
  col : Int
}

///| Structured origin metadata for one item emitted into `00_init_order*.pion` (Astra P1-5).
///| Passed directly from `render_init_order_file_with_origins` to Stage A.5 so user/redacted
///| comments containing `// origin:` can never hijack probe origin mapping.
pub struct InitOriginRecord {
  start_line : Int
  end_line : Int
  decl_start_line : Int
  source_file : String
  line : Int
  col : Int
  rhs_orig_col : Int
  rhs_gen_col : Int
  probe_origins : String
}

///| Declaration-granularity double-hash-anchored overlay specification.
pub struct OverlaySpec {
  id : String
  source_file : String
  decl_identity : String
  target : String
  normalized_source_cst_hash : String
  pre_overlay_generated_hash : String
  replacement : String
  reason : String
  behavior_test : String
  upstream_issue_or_removal_condition : String
}

///| Parsed `pionc check --json` diagnostic.
pub struct PioncDiag {
  file : String
  line : Int
  col : Int
  code : String
  message : String
  expected : String
  found : String
  fixit : String
}

///| Transpiler options.
pub struct TranspileOptions {
  target : String
  mode : String
  with_tests : Bool
  src_prefix : String
  moon_pkg_content : String
  ffi_shim_prefix : String
  header : HeaderMeta
}

pub fn default_options() -> TranspileOptions {
  TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
}

///| Recorded C-ABI symbol mapping for one `extern "C"` declaration in the package.
pub struct FfiSymbolMapping {
  file : String
  line : Int
  col : Int
  fn_name : String
  emitted_pion_fn : String
  raw_c_symbol : String
  emitted_c_symbol : String
  bridged : Bool
}

///| Per-probe-ID final disposition recorded in `migration_report.json` (Wave M1.2 A.1).
pub struct ProbeDisposition {
  probe_id : String
  probe_kind : String
  file : String
  line : Int
  col : Int
  resolved_type : String
  disposition : String
}

///| File accounting entry with exact path and SHA-256 for disjoint partition conservation (Wave M1.2 A.6).
pub struct FileAccountingEntry {
  path : String
  sha256 : String
  reason : String
}

///| Full transpilation output.
pub struct TranspileResult {
  files : Array[GeneratedFile]
  span_map : Array[SpanMapEntry]
  diagnostics : Array[Diag]
  drift_ledger : Array[DriftEntry]
  dispositions : Array[DispositionEntry]
  probe_dispositions : Array[ProbeDisposition]
  excluded_manifest_assets : Array[FileAccountingEntry]
  excluded_by_target : Array[FileAccountingEntry]
  emitted_sources : Array[FileAccountingEntry]
  synthesized_files : Array[String]
  pionc_diag_histogram : Array[(String, Int)]
  probe_rounds : Int
  probes_instrumented : Int
  probes_resolved : Int
  stage_b_iterations : Int
  blockers : Int
  abi : PackageAbi
  abi_sha256 : String
  ffi_symbols : Array[FfiSymbolMapping]
}

///| Deterministic lexicographic sort for `Array[String]` (insertion/merge sort).
pub fn sort_strings(xs : Array[String]) -> Array[String] {
  let out : Array[String] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j], key) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

///| Byte-wise lexicographic string comparison (<0, 0, >0).
pub fn str_cmp(a : String, b : String) -> Int {
  let la = a.length()
  let lb = b.length()
  let n = if la < lb { la } else { lb }
  let mut i = 0
  while i < n {
    let ca = a.code_unit_at(i)
    let cb = b.code_unit_at(i)
    if ca != cb {
      return ca - cb
    }
    i = i + 1
  }
  la - lb
}

///| Deterministic sorted keys of a `Map[String, V]`.
pub fn sorted_map_keys[V](m : Map[String, V]) -> Array[String] {
  sort_strings(m.keys())
}

///| Deterministic sort of `(String, Int)` pairs by key.
pub fn sort_histogram(pairs : Array[(String, Int)]) -> Array[(String, Int)] {
  let out : Array[(String, Int)] = []
  for p in pairs {
    out.push(p)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j].0, key.0) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

///| Lowercase ASCII characters in a string.
pub fn ascii_to_lower(s : String) -> String {
  let sb = StringBuilder()
  let n = s.length()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c >= 65 && c <= 90 {
      let lower_c = c + 32
      let ch = "abcdefghijklmnopqrstuvwxyz".slice(lower_c - 97, lower_c - 96)
      sb.write_string(ch)
    } else {
      sb.write_string(s.slice(i, i + 1))
    }
    i = i + 1
  }
  sb.to_string()
}

///| Check whether `haystack` contains `needle`.
pub fn str_has(haystack : String, needle : String) -> Bool {
  if needle.length() == 0 {
    return true
  }
  haystack.index_of(needle) >= 0
}

///| Replace all non-overlapping occurrences of `old_s` with `new_s`.
pub fn str_replace_all(s : String, old_s : String, new_s : String) -> String {
  if old_s.length() == 0 {
    return s
  }
  let sb = StringBuilder()
  let mut pos = 0
  let n = s.length()
  let m = old_s.length()
  while pos <= n - m {
    let mut matched = true
    let mut k = 0
    while k < m {
      if s.code_unit_at(pos + k) != old_s.code_unit_at(k) {
        matched = false
        break
      }
      k = k + 1
    }
    if matched {
      sb.write_string(new_s)
      pos = pos + m
    } else {
      sb.write_string(s.slice(pos, pos + 1))
      pos = pos + 1
    }
  }
  if pos < n {
    sb.write_string(s.slice(pos, n))
  }
  sb.to_string()
}

///| Normalize inter-token whitespace/comments for declaration CST hashing (platform-neutral)
///| using the MoonBit lexer so string/char/raw literals preserve every byte verbatim!
pub fn normalize_for_hash(s : String) -> String {
  let toks = lex_moonbit(s)
  let sb = StringBuilder()
  let mut i = 0
  let n = toks.length() - 1
  while i < n {
    if i > 0 {
      sb.write_string(" ")
    }
    sb.write_string(toks[i].raw)
    i = i + 1
  }
  sb.to_string()
}

///| Compute deterministic SHA-256 hex digest of a string.
pub fn content_sha256(s : String) -> String {
  sha256_hex(s)
}

///| Escape a string for JSON output using `std/json`.
pub fn json_str(s : String) -> json::JsonValue {
  json::JsonValue::JStr(s)
}

pub fn json_int(n : Int) -> json::JsonValue {
  json::JsonValue::JInt(n.to_int64())
}

pub fn json_bool(b : Bool) -> json::JsonValue {
  json::JsonValue::JBool(b)
}

pub fn json_arr(xs : Array[json::JsonValue]) -> json::JsonValue {
  json::JsonValue::JArr(xs)
}

pub fn json_obj(fs : Array[json::JsonField]) -> json::JsonValue {
  json::JsonValue::JObj(fs)
}

pub fn json_field(k : String, v : json::JsonValue) -> json::JsonField {
  json::field(k, v)
}
