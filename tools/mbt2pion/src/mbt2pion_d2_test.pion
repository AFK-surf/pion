///| Wave M2-D2 unit tests: FuncRef, labeled enum punning/bare reordering,
///| type ascription, const pattern inlining, using / pub using, array spread,
///| and nested constructor array patterns with hygienic pre-guard binding snapshot.

test "d2-1: FuncRef[T] unwraps to T while respecting local shadowing" {
  let src = SourceFile::{
    rel_path: "funcref.mbt",
    content: "pub struct Hooks {\n  cb : FuncRef[(Int, Double, String) -> Unit]\n  opt : FuncRef[(Int, Int) -> Int]?\n}\n\npub fn apply(f : FuncRef[(Int, Int) -> Int], a : Int, b : Int) -> Int {\n  f(a, b)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "cb : (Int, Double, String) -> Unit"), "FuncRef unwraps in struct field")
  assert_true(str_has(out, "opt : Option[(Int, Int) -> Int]"), "FuncRef? unwraps to Option[fn]")
  assert_true(str_has(out, "f : (Int, Int) -> Int"), "FuncRef unwraps in fn param")
  assert_true(!str_has(out, "FuncRef"), "no residual FuncRef in output")
}

test "d2-2: labeled enum bare/qualified/punned direct declaration-order reordering" {
  let src = SourceFile::{
    rel_path: "enums.mbt",
    content: "pub(all) enum Ev {\n  NavAction(x~ : Int, y~ : Int, w~ : Int, h~ : Int)\n  Fold(hinge~ : Int, val~ : Int)\n}\n\npub fn mk(out : Array[Ev], hinge : Int, val : Int, val_ : Int) -> Unit {\n  let _ = val_\n  out.push(NavAction(h=1, x=2, w=3, y=4))\n  out.push(Ev::NavAction(w=30, h=40, y=20, x=10))\n  out.push(Fold(val~, hinge~))\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "NavAction(2, 4, 3, 1)"), "bare NavAction reordered in declaration order")
  assert_true(str_has(out, "Ev::NavAction(10, 20, 30, 40)"), "qualified Ev::NavAction reordered")
  assert_true(str_has(out, "Fold(hinge, val_1)"), "punned Fold respects active lexical rename for val~")
}

test "d2-3: type ascription Float::from_double exactness and trait-object fail-closed" {
  let ok_src = SourceFile::{
    rel_path: "asc.mbt",
    content: "pub struct UtPt { x : Int; y : Int }\n\npub fn demo(h : Float) -> (Float, Int, Int?) {\n  let a = (0.1 : Float)\n  let b = (4.0 : Float) - h\n  let c = ({ x: 1, y: 2 } : UtPt).x\n  let d = (None : Int?)\n  (a + b, c, d)\n}\n",
    is_test: false,
  }
  let res = transpile_package([ok_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "Float::from_double(0.1)"), "(0.1 : Float) uses Float::from_double")
  assert_true(str_has(out, "Float::from_double(4.0)"), "(4.0 : Float) uses Float::from_double")
  assert_true(!str_has(out, "4.0f"), "never emits lowercase 4.0f")
  assert_true(str_has(out, " : UtPt = UtPt::{ x: 1, y: 2 }"), "struct ascription propagates expected type")

  let bad_src = SourceFile::{
    rel_path: "asc_bad.mbt",
    content: "pub fn bad(x : Int) -> Unit {\n  let _ = (x : &Show)\n}\n",
    is_test: false,
  }
  let bad_res = transpile_package([bad_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "trait object ascription must fail closed")
  assert_true(bad_res.diagnostics[0].code == "MBT2PION_UNSUPPORTED_SYNTAX", "must emit MBT2PION_UNSUPPORTED_SYNTAX")
}

test "d2-4: const pattern inlining, private/pub using, and array spread" {
  let src = SourceFile::{
    rel_path: "d24.mbt",
    content: "using @dep { helper, type Box }\nconst KIND : Int = 64\npub const PUB_KIND : Int = 128\n\npub fn classify(v : Int, b : Box, a : Array[Int]) -> (String, Int, Array[Int]) {\n  let tag = match v {\n    KIND => \"k\"\n    PUB_KIND => \"p\"\n    _ => \"other\"\n  }\n  let xs = [..a, 5, ..a]\n  (tag, helper(b), xs)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let mut out = ""
  for gf in res.files {
    if gf.rel_path == "d24.pion" {
      out = gf.content
    }
  }
  assert_true(str_has(out, "64 => \"k\""), "private const inlined in pattern")
  assert_true(str_has(out, "128 => \"p\""), "pub const inlined in pattern")
  assert_true(str_has(out, "b : dep::Box"), "using type expanded")
  assert_true(str_has(out, "dep::helper(b)"), "using value expanded")
  assert_true(str_has(out, ".push(5)"), "array spread lowered")

  // Non-literal const in pattern must fail closed
  let bad_const = SourceFile::{
    rel_path: "bad_const.mbt",
    content: "const COMPUTED : Int = 1 + 2\npub fn f(v : Int) -> Int {\n  match v {\n    COMPUTED => 1\n    _ => 0\n  }\n}\n",
    is_test: false,
  }
  let bc_res = transpile_package([bad_const], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bc_res.blockers > 0, "non-literal const in pattern must fail closed")

  // pub using must emit MBT2PION_UNSUPPORTED_SYNTAX
  let pub_u = SourceFile::{
    rel_path: "pub_using.mbt",
    content: "pub using @dep { type Box }\npub fn id_box(b : Box) -> Box { b }\n",
    is_test: false,
  }
  let pu_res = transpile_package([pub_u], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(pu_res.blockers > 0, "pub using must fail closed")
  assert_true(str_has(pu_res.files[0].content, "dep::Box"), "pub using still expands locally for audit")
}

test "d2-5: nested constructor array pattern with hygienic pre-guard binding isolation" {
  let src = SourceFile::{
    rel_path: "nested_ap.mbt",
    content: "pub fn check_rect(v : Json?) -> Double {\n  match v {\n    Some(Array([Number(x, ..), Number(y, ..), Number(w, ..), Number(h, ..)])) => x + y + w + h\n    _ => -1.0\n  }\n}\n\npub fn shadow_fall(a : Array[Int]) -> Int {\n  let x = 77\n  match Some(a) {\n    Some([x, _]) if x == 0 => x\n    _ => x\n  }\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::MbtJson::Array("), "nested Array ctor qualified")
  assert_true(str_has(out, "mbt_compat::MbtJson::Number("), "inner Number(x, ..) lowered")
  assert_true(str_has(out, "__mbt_pb_x_"), "hygienic binding allocated for x")
  assert_true(str_has(out, "_ => x"), "outer x restored on fallthrough arm")

  // Labeled enum arg inside nested array pattern must NOT treat label `x=` as a binder or hijack outer `x`
  let lbl_src = SourceFile::{
    rel_path: "nested_lbl.mbt",
    content: "pub(all) enum Ev { NavAction(x~ : Int, y~ : Int) }\npub fn check_lbl(opt : Array[Ev]?) -> Int {\n  let x = 77\n  match opt {\n    Some([Ev::NavAction(x=nx, y=ny)]) => nx + ny + x\n    _ => x\n  }\n}\n",
    is_test: false,
  }
  let lbl_res = transpile_package([lbl_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(lbl_res.blockers, 0)
  let lbl_out = lbl_res.files[0].content
  assert_true(!str_has(lbl_out, "__mbt_pb_x_"), "enum label `x=` must NOT be treated as a pattern binder")
  assert_true(str_has(lbl_out, "+ x"), "outer `x` must remain unhijacked inside arm body")

  // Option[String] / Option[Bytes] matching `Some([c, _])` must fail closed
  let str_src = SourceFile::{
    rel_path: "opt_str.mbt",
    content: "pub fn bad_str(opt : Option[String]) -> Int {\n  match opt {\n    Some([c, _]) => c.to_int()\n    _ => 0\n  }\n}\n",
    is_test: false,
  }
  let str_res = transpile_package([str_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(str_res.blockers > 0, "Option[String] nested array pattern must fail closed")
  assert_true(str_res.diagnostics[0].code == "MBT2PION_UNSUPPORTED_SYNTAX", "must emit MBT2PION_UNSUPPORTED_SYNTAX")
}
