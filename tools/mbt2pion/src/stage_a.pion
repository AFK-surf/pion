///| Stage A: Lossless CST parsing + deterministic syntax, symbol, control-flow,
///| and recipe-driven lowering from MoonBit to Pion.
///|
///| Preserves Pion-native constructs untouched:
///| - diverging `guard ... else { return/break/continue/panic }`
///| - `if x is Pat && ...`, `|>`, `ignore`, `#|`, `///|`, `for i = 0; ...`,
///|   `for i, x in arr`, `0..<n`, `{ ..s, x: 1 }`, anonymous `{ x: 1 }`,
///|   intra-package unqualified enum constructors, untyped closure params `fn(n, s) { ... }`.
///|
///| Performs all mandatory Stage A rewrites:
///| - Value-returning `guard` + enclosing block remainder -> `if`/`match`
///| - Top-level `let` + `fn init` extraction for `00_init_order.pion`
///| - Optional-parameter forwarding with defaults (lazy callee `None` branch + external call-site branch)
///| - Cross-package unqualified constructors -> `.Case` / `pkg::Enum::Case` (hard-fail on ambiguity)
///| - Cascade `..m()` -> temp receiver evaluated once, returns receiver
///| - `T?` -> `Option[T]` (respecting `() -> T?` precedence)
///| - `pub(all)` / `pub(open)` / `priv`, `(a) => e`, local `fn`, `impl T for X with m(self)`
///| - `b"..."` -> `"\x...".to_bytes()`, `xs[a:b]`, Map literals, rest patterns `Ctor(_, ..)`
///| - Keyword identifier renaming (`val`/`in`/`scope`/`move`/`spawn`/`import`)
///| - Real `SourceLoc` injection (`loc="<rel>.mbt:<line>:<col>"`)
///| - Strict `#derive(...)` allowlist + declarative `--recipes` synthesis
///| - Lossless CST <-> output span map + per-declaration CST hashes

import "json" as json

///| Pion reserved keywords that are valid identifiers in MoonBit.
pub fn is_pion_reserved_ident(s : String) -> Bool {
  s == "val" || s == "in" || s == "scope" || s == "move" || s == "spawn" || s == "import"
}

pub fn rename_keyword_ident(s : String) -> String {
  if is_pion_reserved_ident(s) { s + "_" } else { s }
}

///| Compute collision-free Pion identifier renames for a list of raw parameter or binder names
///| (e.g. `["val", "val_"]` -> `{"val": "val_1"}` so `val` never collides with `val_`).
fn compute_param_renames(raw_names : Array[String]) -> Map[String, String] {
  let out : Map[String, String] = Map()
  let raw_set : Map[String, Bool] = Map()
  for rn in raw_names {
    raw_set[rn] = true
  }
  let used_targets : Map[String, Bool] = Map()
  for rn in raw_names {
    if !is_pion_reserved_ident(rn) {
      used_targets[rn] = true
    }
  }
  for rn in raw_names {
    if is_pion_reserved_ident(rn) {
      let mut cand = rn + "_"
      let mut k = 1
      while raw_set.contains(cand) || used_targets.contains(cand) {
        cand = rn + "_" + k.to_string()
        k = k + 1
      }
      used_targets[cand] = true
      if cand != rn + "_" {
        out[rn] = cand
      }
    }
  }
  out
}

///| Compute collision-free renames for lexical binders introduced in a `let`, `for`, or `match` arm,
///| avoiding BOTH outer `ctx.scope_vars` (e.g. parameter `val_`) AND sibling binders in the same pattern.
fn compute_scoped_binder_renames(ctx : StageAContext, raw_names : Array[String]) -> Map[String, String] {
  let out : Map[String, String] = Map()
  let occupied : Map[String, Bool] = Map()
  for sv in ctx.scope_vars {
    occupied[sv.name] = true
  }
  for lv in ctx.symtab.local_value_names.keys() {
    occupied[lv] = true
  }
  for cd in ctx.symtab.const_defs.keys() {
    occupied[cd] = true
  }
  for rn in raw_names {
    if rn != "_" && !is_pion_reserved_ident(rn) {
      occupied[rn] = true
    }
  }
  for rn in raw_names {
    if is_pion_reserved_ident(rn) {
      let mut cand = rn + "_"
      let mut k = 1
      while occupied.contains(cand) {
        cand = rn + "_" + k.to_string()
        k = k + 1
      }
      occupied[cand] = true
      if cand != rn + "_" || (lookup_ident_rename(ctx, rn) is Some(_)) {
        out[rn] = cand
      }
    }
  }
  out
}

fn restore_ident_renames(ctx : StageAContext, saved_len : Int) -> Unit {
  while ctx.ident_renames.length() > saved_len {
    let _ = ctx.ident_renames.pop()
  }
}

///| Return true iff `pat_s` is an irrefutable simple binder pattern (a single lowercase identifier or `_`).
fn is_irrefutable_simple_pat(pat_s : String) -> Bool {
  let p = pat_s.trim()
  if p.length() == 0 {
    return false
  }
  if p == "_" {
    return true
  }
  if p == "true" || p == "false" {
    return false
  }
  let c0 = p.code_unit_at(0)
  if !((c0 >= 97 && c0 <= 122) || c0 == 95) {
    return false
  }
  let mut k = 1
  while k < p.length() {
    let c = p.code_unit_at(k)
    if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
      return false
    }
    k = k + 1
  }
  true
}

///| Collect raw (un-renamed) lowercase binder names in pattern slice `[start, end)`.
fn collect_raw_pattern_binders(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let out : Array[String] = []
  let mut rbi = start
  while rbi < end {
    let rbt = tokens[rbi]
    if rbt.kind == TokenKind::Ident && rbt.raw != "_" &&
    !(rbi > start && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
    !(rbi + 1 < end && (tokens[rbi + 1].kind == TokenKind::Colon || tokens[rbi + 1].kind == TokenKind::Eq)) {
      out.push(rbt.raw)
    }
    rbi = rbi + 1
  }
  out
}

fn lookup_ident_rename(ctx : StageAContext, raw : String) -> Option[String] {
  let mut idx = ctx.ident_renames.length() - 1
  while idx >= 0 {
    match ctx.ident_renames[idx].get(raw) {
      Some(v) => return Some(v)
      None => ()
    }
    idx = idx - 1
  }
  None
}

fn resolve_ident_in_scope(ctx : StageAContext, raw : String) -> String {
  match lookup_ident_rename(ctx, raw) {
    Some(v) => v
    None => rename_keyword_ident(raw)
  }
}

fn callee_param_rename(renames : Option[Map[String, String]], raw : String) -> String {
  match renames {
    Some(m) => match m.get(raw) {
      Some(v) => v
      None => rename_keyword_ident(raw)
    }
    None => rename_keyword_ident(raw)
  }
}

///| Find matching closing delimiter (`)`, `}`, `]`) starting at `open_idx`.
pub fn find_matching_delim(tokens : Array[Token], open_idx : Int) -> Int {
  if open_idx >= tokens.length() {
    return open_idx
  }
  let open_k = tokens[open_idx].kind
  let close_k = if open_k == TokenKind::LParen {
    TokenKind::RParen
  } else if open_k == TokenKind::LBrace {
    TokenKind::RBrace
  } else if open_k == TokenKind::LBracket {
    TokenKind::RBracket
  } else {
    return open_idx
  }
  let mut depth = 0
  let mut i = open_idx
  while i < tokens.length() {
    let k = tokens[i].kind
    if k == open_k {
      depth = depth + 1
    } else if k == close_k {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  tokens.length() - 1
}

///| Check whether a block `{ ... }` (tokens `[open_brace, close_brace]`) unconditionally diverges
///| (ends with `return`, `break`, `continue`, `panic(...)`, or `abort(...)`).
pub fn block_diverges(tokens : Array[Token], open_brace : Int, close_brace : Int) -> Bool {
  if close_brace <= open_brace + 1 {
    return false
  }
  // Scan top-level statements inside the block
  let mut i = open_brace + 1
  let mut last_stmt_start = i
  while i < close_brace {
    let k = tokens[i].kind
    if k == TokenKind::LBrace || k == TokenKind::LParen || k == TokenKind::LBracket {
      i = find_matching_delim(tokens, i) + 1
      continue
    }
    if k == TokenKind::Semi {
      if i + 1 < close_brace {
        last_stmt_start = i + 1
      }
      i = i + 1
      continue
    }
    if tokens[i].newline_before && i > open_brace + 1 {
      // Check if previous token ends a statement
      let pk = tokens[i - 1].kind
      if pk != TokenKind::Plus && pk != TokenKind::Minus && pk != TokenKind::Star &&
      pk != TokenKind::Slash && pk != TokenKind::Eq && pk != TokenKind::Comma &&
      pk != TokenKind::PipeGt && pk != TokenKind::AmpAmp && pk != TokenKind::PipePipe &&
      pk != TokenKind::FatArrow && pk != TokenKind::Arrow {
        last_stmt_start = i
      }
    }
    i = i + 1
  }
  if last_stmt_start < close_brace {
    let t = tokens[last_stmt_start]
    if t.kind == TokenKind::Keyword &&
    (t.raw == "return" || t.raw == "break" || t.raw == "continue") {
      return true
    }
    if t.kind == TokenKind::Ident && (t.raw == "panic" || t.raw == "abort") {
      return true
    }
  }
  false
}

///| Convert a MoonBit byte string `b"..."` to a Pion `"...".to_bytes()` literal.
pub fn lower_byte_string(raw : String) -> String {
  if raw.starts_with("b\"") && raw.ends_with("\"") {
    let inner = raw.slice(1, raw.length())
    return inner + ".to_bytes()"
  }
  raw
}

///| Convert a MoonBit byte char `b'x'` to a Pion `Byte` cast.
pub fn lower_byte_char(raw : String) -> String {
  if raw.starts_with("b'") && raw.ends_with("'") && raw.length() >= 4 {
    let ch = raw.slice(2, raw.length() - 1)
    if ch.length() == 1 {
      return ch.code_unit_at(0).to_string() + ".to_byte()"
    }
    if ch == "\\n" {
      return "10.to_byte()"
    }
    if ch == "\\r" {
      return "13.to_byte()"
    }
    if ch == "\\t" {
      return "9.to_byte()"
    }
    if ch == "\\0" {
      return "0.to_byte()"
    }
    if ch == "\\\\" {
      return "92.to_byte()"
    }
    if ch == "\\'" {
      return "39.to_byte()"
    }
    if ch.length() == 4 && ch.starts_with("\\x") {
      let mut v = 0
      let mut ok = true
      let mut k = 2
      while k < 4 {
        let c = ch.code_unit_at(k)
        let d = if c >= 48 && c <= 57 {
          c - 48
        } else if c >= 97 && c <= 102 {
          c - 97 + 10
        } else if c >= 65 && c <= 70 {
          c - 65 + 10
        } else {
          -1
        }
        if d < 0 {
          ok = false
        } else {
          v = v * 16 + d
        }
        k = k + 1
      }
      if ok {
        return v.to_string() + ".to_byte()"
      }
    }
  }
  raw
}

///| Lower a MoonBit type expression slice `[start, end)` to Pion:
///| - `T?` -> `Option[T]` recursively (respecting `() -> T?` -> `() -> Option[T]`)
///| - `SourceLoc` -> `String`
///| - `Json` -> `json::JsonValue`
///| - `Map[K, V]` -> `mbt_compat::OrderedMap[K, V]`
///| - `Ref[T]` -> recipe-configured Ref type if enabled
///| - `@pkg.Type` -> `pkg::Type`
pub fn lower_type_tokens(
  tokens : Array[Token],
  start : Int,
  end : Int,
  symtab : SymbolTable,
  recipes : Recipes,
) -> String {
  let parts : Array[String] = []
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    // MoonBit `noraise` annotation in function/closure type signatures is equivalent to plain Pion fn types.
    if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "noraise" {
      i = i + 1
      continue
    }
    let mut piece = ""
    if t.kind == TokenKind::Amp && i + 1 < end {
      // MoonBit trait object type `&Trait` / `&@pkg.Trait` -> Pion `dyn Trait` / `dyn pkg::Trait`
      if tokens[i + 1].kind == TokenKind::UpperIdent {
        let mut tname = tokens[i + 1].raw
        if !symtab.local_types.contains(tname) && !symtab.active_generics.contains(tname) {
          match symtab.using_types.get(tname) {
            Some(ut) => tname = ut
            None => ()
          }
        }
        i = i + 2
        if i < end && tokens[i].kind == TokenKind::LBracket {
          let close_b = find_matching_delim(tokens, i)
          let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
          tname = tname + "[" + inner + "]"
          i = close_b + 1
        }
        piece = "dyn " + tname
      } else if tokens[i + 1].kind == TokenKind::PkgRef && i + 3 < end &&
      tokens[i + 2].kind == TokenKind::Dot && tokens[i + 3].kind == TokenKind::UpperIdent {
        let raw_pkg = tokens[i + 1].raw.slice(1, tokens[i + 1].raw.length())
        let mapped = match symtab.pkg_aliases.get(raw_pkg) {
          Some(p) => p
          None => raw_pkg
        }
        let mut tname = mapped + "::" + tokens[i + 3].raw
        i = i + 4
        if i < end && tokens[i].kind == TokenKind::LBracket {
          let close_b = find_matching_delim(tokens, i)
          let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
          tname = tname + "[" + inner + "]"
          i = close_b + 1
        }
        piece = "dyn " + tname
      } else {
        piece = t.raw
        i = i + 1
      }
    } else if t.kind == TokenKind::PkgRef {
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let mapped = match symtab.pkg_aliases.get(raw_pkg) {
        Some(p) => p
        None => raw_pkg
      }
      if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
        if is_moonbit_core_pkg(symtab, raw_pkg, "json") && tokens[i + 2].raw == "Json" {
          piece = "mbt_compat::MbtJson"
          i = i + 3
        } else if is_moonbit_core_pkg(symtab, raw_pkg, "set") && tokens[i + 2].raw == "Set" {
          let mut qname = "mbt_compat::OrderedSet"
          i = i + 3
          if i < end && tokens[i].kind == TokenKind::LBracket {
            let close_b = find_matching_delim(tokens, i)
            let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
            qname = qname + "[" + inner + "]"
            i = close_b + 1
          }
          piece = qname
        } else {
          let self_test_pkg = match symtab.pkg_aliases.get("__mbt_cur_test_self_pkg__") {
            Some(sp) => sp
            None => ""
          }
          let mut qname = if self_test_pkg.length() > 0 && raw_pkg == self_test_pkg {
            tokens[i + 2].raw
          } else {
            mapped + "::" + tokens[i + 2].raw
          }
          i = i + 3
          if i < end && tokens[i].kind == TokenKind::LBracket {
            let close_b = find_matching_delim(tokens, i)
            let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
            qname = qname + "[" + inner + "]"
            i = close_b + 1
          }
          piece = qname
        }
      } else {
        piece = mapped
        i = i + 1
      }
    } else if t.kind == TokenKind::Ident && i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::UpperIdent {
      // Qualified type `pkg::Type[...]` parsed as a single atom so `pkg::Item?` -> `Option[pkg::Item]`!
      let mut qname = t.raw + "::" + tokens[i + 2].raw
      i = i + 3
      if i < end && tokens[i].kind == TokenKind::LBracket {
        let close_b = find_matching_delim(tokens, i)
        let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
        qname = qname + "[" + inner + "]"
        i = close_b + 1
      }
      piece = qname
    } else if t.kind == TokenKind::UpperIdent && t.raw == "FuncRef" &&
    !symtab.active_generics.contains("FuncRef") && !symtab.local_types.contains("FuncRef") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      piece = lower_type_tokens(tokens, i + 2, close_b, symtab, recipes)
      i = close_b + 1
    } else if t.kind == TokenKind::UpperIdent {
      let mut name = t.raw
      if symtab.active_generics.contains(name) {
        // P1 (P0-4): Active generic type param (e.g. `fn[Json] id(x : Json) -> Json`) MUST stay untouched!
        name = t.raw
      } else if name == "SourceLoc" {
        name = "String"
      } else if name == "Int32" && !symtab.local_types.contains("Int32") && !symtab.using_types.contains("Int32") &&
      !symtab.type_aliases.contains("Int32") {
        // MoonBit's built-in `Int32` is `#alias(Int32)` of `Int` (same 32-bit wrapping type). A local or `using`
        // type of that name and `@pkg.Int32` (lowered as a qualified type above) are left alone.
        name = "Int"
      } else if name == "StringView" {
        name = "String"
      } else if name == "BytesView" {
        name = "Bytes"
      } else if name == "Json" && !symtab.local_types.contains("Json") {
        name = "mbt_compat::MbtJson"
      } else if name == "Set" && !symtab.local_types.contains("Set") {
        name = "mbt_compat::OrderedSet"
      } else if name == "Map" {
        name = "mbt_compat::OrderedMap"
      } else if name == "ReadOnlyArray" {
        name = "Array"
      } else if name == "ArrayView" {
        name = "mbt_compat::ArrayView"
      } else if name == "Ref" && !symtab.local_types.contains("Ref") {
        name = if recipes.ref_recipe.enabled && recipes.ref_recipe.type_name.length() > 0 {
          recipes.ref_recipe.type_name
        } else {
          "mbt_compat::Ref"
        }
      } else {
        match symtab.type_aliases.get(name) {
          Some(aliased) =>
          if !(i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket) || !str_has(aliased, "[") {
            name = aliased
          }
          None =>
          if !symtab.local_types.contains(name) {
            match symtab.using_types.get(name) {
              Some(ut) => name = ut
              None => ()
            }
          }
        }
      }
      if i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
        let close_b = find_matching_delim(tokens, i + 1)
        let inner = lower_type_tokens(tokens, i + 2, close_b, symtab, recipes)
        piece = name + "[" + inner + "]"
        i = close_b + 1
      } else {
        piece = name
        i = i + 1
      }
    } else if t.kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i)
      let inner = lower_type_tokens(tokens, i + 1, close_p, symtab, recipes)
      piece = "(" + inner + ")"
      i = close_p + 1
    } else if t.kind == TokenKind::Arrow {
      // `() -> T?` binds `?` tighter than `->`: lower the entire return type on the right!
      let rhs = lower_type_tokens(tokens, i + 1, end, symtab, recipes)
      parts.push(" -> " + rhs)
      return join_str_array(parts)
    } else if t.kind == TokenKind::Comma {
      parts.push(", ")
      i = i + 1
      continue
    } else if t.kind == TokenKind::Question {
      // Postfix `T?` applies to the previous type atom
      if parts.length() > 0 {
        let last = parts[parts.length() - 1]
        parts[parts.length() - 1] = "Option[" + last + "]"
      }
      i = i + 1
      continue
    } else {
      piece = t.raw
      i = i + 1
    }
    // Check immediately following `?` on this type atom
    while i < end && tokens[i].kind == TokenKind::Question {
      if is_parenthesized_fn_type(piece) {
        piece = "Option[" + piece.slice(1, piece.length() - 1) + "]"
      } else {
        piece = "Option[" + piece + "]"
      }
      i = i + 1
    }
    if parts.length() > 0 && piece.length() > 0 {
      let prev_p = parts[parts.length() - 1]
      if prev_p.length() > 0 {
        let lc = prev_p.code_unit_at(prev_p.length() - 1)
        let fc = piece.code_unit_at(0)
        let prev_word_end = is_alnum(lc) || lc == 93 || lc == 41
        let cur_word_start = is_alpha(fc)
        if prev_word_end && cur_word_start {
          parts.push(" ")
        }
      }
    }
    parts.push(piece)
  }
  join_str_array(parts)
}

fn is_parenthesized_fn_type(piece : String) -> Bool {
  if !(piece.starts_with("(") && piece.ends_with(")")) || piece.length() < 6 {
    return false
  }
  let inner = piece.slice(1, piece.length() - 1)
  let n = inner.length()
  let mut depth = 0
  let mut has_arrow = false
  let mut i = 0
  while i < n {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 {
      if c == 44 {
        // Depth-0 comma means this is a tuple type `(A, B)`, NOT a single parenthesized fn type!
        return false
      }
      if c == 45 && i + 1 < n && inner.code_unit_at(i + 1) == 62 {
        has_arrow = true
      }
    }
    i = i + 1
  }
  has_arrow
}

fn join_str_array(xs : Array[String]) -> String {
  let sb = StringBuilder()
  for x in xs {
    sb.write_string(x)
  }
  sb.to_string()
}

///| Outer variable binding tracked in lexical scope for recursive local `fn` lifting (Wave M1.2 A.2).
struct ScopeVar {
  name : String
  ty : String
  is_mut : Bool
  is_boxed : Bool
}

///| Lifted recursive local `fn` metadata so direct calls rewrite to the lifted top-level symbol.
struct LiftedLocalFn {
  lifted_name : String
  env_args : Array[String]
}

///| Stage A context for lowering a package.
pub struct StageAContext {
  symtab : SymbolTable
  recipes : Recipes
  opts : TranspileOptions
  diags : Array[Diag]
  drift_ledger : Array[DriftEntry]
  dispositions : Array[DispositionEntry]
  span_map : Array[SpanMapEntry]
  init_items : Array[InitItem]
  test_init_items : Array[InitItem]
  fn_bodies : Array[FnBodyRefs]
  migrated_opt_default_fns : Map[String, Bool]
  borrowed_bufs : Map[String, Bool]
  borrowed_views : Map[String, Bool]
  struct_field_renames : Map[String, Map[String, String]]
  struct_field_order : Map[String, Array[String]]
  struct_type_params : Map[String, Array[String]]
  struct_val_fields : Map[String, String]
  trait_methods : Map[String, Map[String, (Array[String], String)]]
  local_method_names : Map[String, Bool]
  ufcs_forwarders : Map[String, String]
  all_source_texts : Array[String]
  val_probe_sites : Array[ValProbeSite]
  exported_abi_enums : Array[AbiEnumSchema]
  exported_abi_struct_vals : Array[AbiStructValRename]
  scope_vars : Array[ScopeVar]
  ident_renames : Array[Map[String, String]]
  boxed_mut_vars : Map[String, Bool]
  lifted_local_fns : Map[String, LiftedLocalFn]
  lifted_fns : Array[String]
  expected_type_stack : Array[String]
  mut inferred_exp_depth : Int
  match_arr_cache_ctor : Array[String]
  match_arr_cache_elems : Array[Map[Int, String]]
  match_arr_cache_suffix : Array[Map[Int, String]]
  match_arr_cache_len : Array[String]
  active_generics : Map[String, Bool]
  used_idents : Map[String, Bool]
  synth_sp_temps : Map[String, Bool]
  mut cur_is_test : Bool
  mut cur_is_blackbox : Bool
  mut cur_out_rel : String
  mut cur_lowering_init : Bool
  mut cur_in_test_block : Bool
  mut cur_fn_is_raising : Bool
  mut in_closure_depth : Int
  mut in_try_catch_depth : Int
  mut in_for_header : Bool
  mut direct_owned_slice_arg : Bool
  mut in_interp_top : Bool
  mut self_pkg_name : String
  mut cur_enclosing_fn : String
  mut cur_fn_ret_ty : String
  mut lift_counter : Int
  mut temp_counter : Int
  mut val_site_seq : Int
  mut init_order_seq : Int
  mut ufcs_seq : Int
}

pub fn stage_a_context_new(
  symtab : SymbolTable,
  recipes : Recipes,
  opts : TranspileOptions,
) -> StageAContext {
  StageAContext::{
    symtab: symtab,
    recipes: recipes,
    opts: opts,
    diags: [],
    drift_ledger: [],
    dispositions: [],
    span_map: [],
    init_items: [],
    test_init_items: [],
    fn_bodies: [],
    migrated_opt_default_fns: Map(),
    borrowed_bufs: Map(),
    borrowed_views: Map(),
    struct_field_renames: Map(),
    struct_field_order: Map(),
    struct_type_params: Map(),
    struct_val_fields: Map(),
    trait_methods: Map(),
    local_method_names: Map(),
    ufcs_forwarders: Map(),
    all_source_texts: [],
    val_probe_sites: [],
    exported_abi_enums: [],
    exported_abi_struct_vals: [],
    scope_vars: [],
    ident_renames: [],
    boxed_mut_vars: Map(),
    lifted_local_fns: Map(),
    lifted_fns: [],
    expected_type_stack: [],
    inferred_exp_depth: 0,
    match_arr_cache_ctor: [],
    match_arr_cache_elems: [],
    match_arr_cache_suffix: [],
    match_arr_cache_len: [],
    active_generics: Map(),
    used_idents: Map(),
    synth_sp_temps: Map(),
    cur_is_test: false,
    cur_is_blackbox: false,
    cur_out_rel: "",
    cur_lowering_init: false,
    cur_in_test_block: false,
    cur_fn_is_raising: false,
    in_closure_depth: 0,
    in_try_catch_depth: 0,
    in_for_header: false,
    direct_owned_slice_arg: false,
    in_interp_top: false,
    self_pkg_name: "",
    cur_enclosing_fn: "top",
    cur_fn_ret_ty: "",
    lift_counter: 0,
    temp_counter: 0,
    val_site_seq: 0,
    init_order_seq: 0,
    ufcs_seq: 0,
  }
}

///| Allocate a per-file collision-free placeholder identifier for a `.val` field access,
///| avoiding ALL identifiers occurring in the source file and registering `(site_id, placeholder_ident)`.
fn alloc_fresh_val_placeholder(ctx : StageAContext, line : Int, col : Int) -> String {
  ctx.val_site_seq = ctx.val_site_seq + 1
  let sid = ctx.val_site_seq
  let mut cand = "__mbt_val_p" + sid.to_string()
  let mut bump = 1
  while ctx.used_idents.contains(cand) {
    cand = "__mbt_val_p" + sid.to_string() + "_" + bump.to_string()
    bump = bump + 1
  }
  ctx.used_idents[cand] = true
  let out_f = if ctx.cur_lowering_init {
    if ctx.cur_is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
  } else {
    ctx.cur_out_rel
  }
  ctx.val_probe_sites.push(ValProbeSite::{
    site_id: sid,
    placeholder_ident: cand,
    file: out_f,
    line: line,
    col: col,
  })
  cand
}

///| Return true iff `[arg_s, arg_e)` is a single direct postfix slice expression `<recv>[lo:hi]`
///| (never a function call wrapping a slice like `f(a[1:3])`, and never a multi-arg or binary expr).
fn is_direct_slice_arg(tokens : Array[Token], arg_s : Int, arg_e : Int) -> Bool {
  let mut e = arg_e
  while e > arg_s && tokens[e - 1].kind == TokenKind::Comma {
    e = e - 1
  }
  if e <= arg_s + 2 {
    return false
  }
  let t = tokens[arg_s]
  let mut cur = -1
  if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::ByteStringLit {
    cur = arg_s + 1
  } else if t.kind == TokenKind::PkgRef && arg_s + 2 < e && tokens[arg_s + 1].kind == TokenKind::Dot {
    cur = arg_s + 3
  } else if t.kind == TokenKind::LParen {
    if is_arrow_fn_at(tokens, arg_s, e) >= 0 {
      return false
    }
    cur = find_matching_delim(tokens, arg_s) + 1
  } else if t.kind == TokenKind::LBracket {
    cur = find_matching_delim(tokens, arg_s) + 1
  } else {
    return false
  }
  let mut last_was_slice = false
  while cur < e {
    let ck = tokens[cur].kind
    if ck == TokenKind::LBracket && !tokens[cur].newline_before {
      let cbr = find_matching_delim(tokens, cur)
      if cbr >= e {
        return false
      }
      last_was_slice = find_slice_colon(tokens, cur, cbr) >= 0
      cur = cbr + 1
    } else if ck == TokenKind::LParen && !tokens[cur].newline_before {
      let cp = find_matching_delim(tokens, cur)
      if cp >= e {
        return false
      }
      last_was_slice = false
      cur = cp + 1
    } else if ck == TokenKind::Dot && cur + 1 < e &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::IntLit) {
      last_was_slice = false
      cur = cur + 2
    } else if ck == TokenKind::ColonColon && cur + 1 < e &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::UpperIdent) {
      last_was_slice = false
      cur = cur + 2
    } else {
      return false
    }
  }
  cur == e && last_was_slice
}

fn current_expected_type(ctx : StageAContext) -> String {
  let n = ctx.expected_type_stack.length()
  if n > 0 { ctx.expected_type_stack[n - 1] } else { "" }
}

fn push_expected_type(ctx : StageAContext, ty : String) -> Unit {
  ctx.expected_type_stack.push(ty)
}

fn pop_expected_type(ctx : StageAContext) -> Unit {
  if ctx.expected_type_stack.length() > 0 {
    let _ = ctx.expected_type_stack.pop()
  }
}

///| Allocate a deterministic collision-free Pion field name for a MoonBit reserved-keyword field
///| (e.g. `val` in `struct S { val : Int; val_ : Int }` -> `val_1`, never colliding with `val_`!).
fn allocate_collision_free_field_name(
  raw_name : String,
  existing : Map[String, Bool],
  used : Map[String, Bool],
) -> String {
  if !is_pion_reserved_ident(raw_name) {
    return raw_name
  }
  let cand0 = raw_name + "_"
  if !existing.contains(cand0) && !used.contains(cand0) {
    return cand0
  }
  let mut idx = 1
  while true {
    let cand = raw_name + "_" + idx.to_string()
    if !existing.contains(cand) && !used.contains(cand) {
      return cand
    }
    idx = idx + 1
  }
  cand0
}

fn rename_struct_field(ctx : StageAContext, struct_name : String, raw_field : String) -> String {
  match ctx.struct_field_renames.get(struct_name) {
    Some(rmap) =>
    match rmap.get(raw_field) {
      Some(renamed) => return renamed
      None => ()
    }
    None => ()
  }
  if raw_field == "val" {
    match ctx.symtab.dep_struct_val_fields.get(struct_name) {
      Some(renamed) => return renamed
      None => ()
    }
  }
  // Check F4-3 ABI v2 `structs` metadata for foreign structs (preserves `emit_name`, e.g. `val_1` vs `val_`)
  let fq = match ctx.symtab.using_types.get(struct_name) {
    Some(q) => strip_type_args_sym(q)
    None => strip_type_args_sym(struct_name)
  }
  let fcc = fq.index_of("::")
  if fcc > 0 && fcc + 2 < fq.length() {
    match symtab_lookup_struct_schema(ctx.symtab, fq.slice(0, fcc), fq.slice(fcc + 2, fq.length())) {
      Some(schema) => {
        for sf in schema.fields {
          if sf.src_name == raw_field && sf.emit_name.length() > 0 {
            return sf.emit_name
          }
        }
      }
      None => ()
    }
  }
  rename_keyword_ident(raw_field)
}

///| Lower a struct literal or destructuring pattern `{ field: expr, .. }` with collision-free
///| field renaming for `struct_name`.
fn lower_struct_brace(
  ctx : StageAContext,
  struct_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
  in_pattern : Bool,
) -> String {
  let sb = StringBuilder()
  sb.write_string("{")
  let mut i = open_b + 1
  while i < close_b {
    let t = tokens[i]
    if t.kind == TokenKind::Comma {
      sb.write_string(t.leading_trivia + ",")
      i = i + 1
      continue
    }
    // Spread `..base`
    if t.kind == TokenKind::DotDot {
      sb.write_string(t.leading_trivia + "..")
      let mut e = i + 1
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
          d = d + 1
        } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
          d = d - 1
        } else if d == 0 && ek == TokenKind::Comma {
          break
        }
        e = e + 1
      }
      sb.write_string(lower_expr_range(ctx, tokens, i + 1, e, file, in_pattern))
      i = e
      continue
    }
    // Field `name: val` or shorthand `name`
    if t.kind == TokenKind::Ident || t.kind == TokenKind::Keyword {
      let raw_f = t.raw
      let renamed_f = rename_struct_field(ctx, struct_name, raw_f)
      if i + 1 < close_b && tokens[i + 1].kind == TokenKind::Colon {
        sb.write_string(t.leading_trivia + renamed_f + tokens[i + 1].leading_trivia + ":")
        let mut e = i + 2
        let mut d = 0
        while e < close_b {
          let ek = tokens[e].kind
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
            d = d + 1
          } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
            d = d - 1
          } else if d == 0 && ek == TokenKind::Comma {
            break
          }
          e = e + 1
        }
        let field_exp_ty = match ctx.symtab.struct_field_types.get(struct_name) {
          Some(fmap) => match fmap.get(raw_f) { Some(ft) => ft, None => "" }
          None => ""
        }
        push_expected_type(ctx, field_exp_ty)
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, in_pattern))
        pop_expected_type(ctx)
        i = e
        continue
      }
      // Shorthand `field` (followed by `,` or `}`)
      if i + 1 == close_b || tokens[i + 1].kind == TokenKind::Comma {
        let local_var = resolve_ident_in_scope(ctx, raw_f)
        if renamed_f != local_var {
          sb.write_string(t.leading_trivia + renamed_f + ": " + local_var)
        } else {
          sb.write_string(t.leading_trivia + renamed_f)
        }
        i = i + 1
        continue
      }
    }
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, close_b, file, in_pattern)
    sb.write_string(piece)
    i = next_i
  }
  sb.write_string(tokens[close_b].leading_trivia + "}")
  sb.to_string()
}

///| Return true iff expression `[start, end)` inside a struct update `{ ..base, f: val }`
///| is strictly pure (whitelist of pure atoms, paths, tuples, and `Some`/`Ok`/`Err` constructors).
///| All operators (potentially user-overloaded, e.g. `Add::add`), indexing, blocks, calls,
///| interpolation, pipes, assignments, and control flow are treated as potentially effectful.
fn is_pure_struct_update_val(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::IntLit || tk == TokenKind::FloatLit || tk == TokenKind::CharLit ||
    tk == TokenKind::ByteCharLit || tk == TokenKind::ByteStringLit || tk == TokenKind::RawMultiline ||
    tk == TokenKind::Ident || tk == TokenKind::UpperIdent || tk == TokenKind::PkgRef ||
    tk == TokenKind::Dot || tk == TokenKind::ColonColon || tk == TokenKind::Comma ||
    tk == TokenKind::RParen {
      k = k + 1
      continue
    }
    if tk == TokenKind::StringLit && !str_has(tokens[k].raw, "\\{") {
      k = k + 1
      continue
    }
    if tk == TokenKind::Keyword && (tokens[k].raw == "true" || tokens[k].raw == "false") {
      k = k + 1
      continue
    }
    if tk == TokenKind::LParen {
      if k > start {
        let pk = tokens[k - 1].kind
        if pk == TokenKind::Ident || pk == TokenKind::RParen || pk == TokenKind::RBracket {
          return false
        }
        if pk == TokenKind::UpperIdent {
          let pr = tokens[k - 1].raw
          if pr != "Some" && pr != "Ok" && pr != "Err" {
            return false
          }
        }
      }
      k = k + 1
      continue
    }
    return false
  }
  true
}

///| Instantiate a local struct field type `raw_field_ty` using the concrete type arguments
///| extracted from `base_ty` (e.g. `GenRow[Array[Float]]` -> `T => Array[Float]`).
///| Returns `""` if `raw_field_ty` is empty, contains `?`, or retains any unbound struct
///| type parameter not in `ctx.active_generics` (so we never emit invalid `: T =`).
fn instantiate_struct_field_ty(
  ctx : StageAContext,
  sname : String,
  raw_field_ty : String,
  base_ty : String,
) -> String {
  let tparams = match ctx.struct_type_params.get(sname) {
    Some(ps) => ps
    None => []
  }
  instantiate_struct_field_ty_with_tparams(ctx, tparams, raw_field_ty, base_ty)
}

fn instantiate_struct_field_ty_with_tparams(
  ctx : StageAContext,
  tparams : Array[String],
  raw_field_ty : String,
  base_ty : String,
) -> String {
  let ft = raw_field_ty.trim()
  if ft.length() == 0 || str_has(ft, "?") {
    return ""
  }
  if tparams.length() == 0 {
    return ft
  }
  // Extract top-level comma-separated type arguments from `base_ty` (`S[A, B]`)
  let subst : Map[String, String] = Map()
  let lb = base_ty.index_of("[")
  if lb > 0 && base_ty.ends_with("]") {
    let inner = base_ty.slice(lb + 1, base_ty.length() - 1)
    let targs : Array[String] = []
    let mut s = 0
    let mut d = 0
    let mut k = 0
    while k <= inner.length() {
      let at_e = k == inner.length()
      let ch = if at_e { 44 } else { inner.code_unit_at(k) }
      if !at_e && (ch == 40 || ch == 91 || ch == 123) { d = d + 1 }
      else if !at_e && (ch == 41 || ch == 93 || ch == 125) { if d > 0 { d = d - 1 } }
      else if d == 0 && ch == 44 {
        targs.push(inner.slice(s, k).trim())
        s = k + 1
      }
      k = k + 1
    }
    if targs.length() == tparams.length() {
      let mut pi = 0
      while pi < tparams.length() {
        if targs[pi].length() > 0 && !str_has(targs[pi], "?") {
          subst[tparams[pi]] = targs[pi]
        }
        pi = pi + 1
      }
    }
  }
  let tparam_set : Map[String, Bool] = Map()
  for tp in tparams { tparam_set[tp] = true }
  let ftoks = lex_moonbit(ft)
  let sb = StringBuilder()
  let mut ti = 0
  while ti < ftoks.length() - 1 {
    let tok = ftoks[ti]
    let is_qual = ti > 0 && (ftoks[ti - 1].kind == TokenKind::ColonColon || ftoks[ti - 1].kind == TokenKind::Dot)
    if !is_qual && (tok.kind == TokenKind::UpperIdent || tok.kind == TokenKind::Ident) && tparam_set.contains(tok.raw) {
      match subst.get(tok.raw) {
        Some(rep) => sb.write_string(tok.leading_trivia + rep)
        None => {
          if ctx.active_generics.contains(tok.raw) {
            sb.write_string(tok.leading_trivia + tok.raw)
          } else {
            return ""
          }
        }
      }
    } else {
      sb.write_string(tok.leading_trivia + tok.raw)
    }
    ti = ti + 1
  }
  sb.to_string().trim()
}

///| Lower a struct update `{ ..base, f1: e1, ... }` preserving Moon's exact evaluation order:
///| - Pure overrides: emit `sname::{ ..base, ... }` directly.
///| - Local struct (known declaration order) with effectful overrides:
///|   - Strictly increasing declaration order -> bind `base` once, emit all fields in declaration order.
///|   - Out-of-order overrides -> bind `base` once, evaluate overrides in source order into temps,
///|     then construct `sname::{ ..base_tmp, f1: tmp1, ... }` so unoverridden fields read post-effect state.
///| - Foreign struct (unknown field order/mutability) with effectful overrides -> fail-closed
///|   with `MBT2PION_UNSUPPORTED_SYNTAX` (never silently produce wrong values).
fn lower_struct_update_expr(
  ctx : StageAContext,
  sname : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let mut base_s = -1
  let mut base_e = -1
  let overrides : Array[(String, Bool, Int, Int)] = []
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if tokens[i].kind == TokenKind::DotDot {
      base_s = i + 1
      base_e = e
    } else if (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    i + 1 < e && tokens[i + 1].kind == TokenKind::Colon {
      overrides.push((tokens[i].raw, false, i + 2, e))
    } else if (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) && e == i + 1 {
      overrides.push((tokens[i].raw, true, i, e))
    }
    i = e + 1
  }
  let mut all_pure = true
  for ov in overrides {
    if !ov.1 && !is_pure_struct_update_val(tokens, ov.2, ov.3) {
      all_pure = false
      break
    }
  }
  // Resolve local vs foreign struct layout BEFORE `all_pure` optimization:
  // any foreign struct with `priv` fields, non-`pub(all)`, or legacy/incomplete ABI MUST fail closed
  // BEFORE `all_pure` or any expansion!
  let mut resolved_decl_fields : Option[Array[String]] = ctx.struct_field_order.get(sname)
  let mut foreign_emit_names : Map[String, String] = Map()
  let mut foreign_field_tys : Map[String, String] = Map()
  let mut foreign_tparams : Array[String] = []
  let mut is_foreign_expand = false
  if resolved_decl_fields is None {
    let base_static_for_targs = if base_s > 0 && base_e > base_s {
      let bt = infer_simple_expr_type(ctx, tokens, base_s, base_e).trim()
      if bt.length() > 0 { bt } else { current_expected_type(ctx).trim() }
    } else {
      current_expected_type(ctx).trim()
    }
    let targs_list = extract_type_args_list(base_static_for_targs)
    let qres = if targs_list.length() > 0 {
      symtab_query_foreign_struct_update_with_targs(ctx.symtab, sname, targs_list.length())
    } else {
      symtab_query_foreign_struct_update(ctx.symtab, sname)
    }
    match qres {
      ForeignStructUpdateInfo::Expandable(schema) => {
        is_foreign_expand = true
        foreign_tparams = schema.type_params
        let dfs : Array[String] = []
        for sf in schema.fields {
          dfs.push(sf.src_name)
          foreign_emit_names[sf.src_name] = if sf.emit_name.length() > 0 { sf.emit_name } else { rename_keyword_ident(sf.src_name) }
          foreign_field_tys[sf.src_name] = qualify_dep_field_type_f3d2(ctx, schema.pkg + "::" + schema.name, sf.ty)
        }
        resolved_decl_fields = Some(dfs)
      }
      ForeignStructUpdateInfo::Rejected(reason) => {
        ctx.diags.push(diag_error(
          "MBT2PION_DEP_ABI_ERROR",
          file,
          tokens[open_b].line,
          tokens[open_b].col,
          "cross-package struct update on `" + sname + "` rejected: " + reason,
        ))
        return sname + "::" + lower_struct_brace(ctx, sname, tokens, open_b, close_b, file, false)
      }
      ForeignStructUpdateInfo::Unknown(reason) => {
        if !all_pure || str_has(reason, "legacy ABI") || str_has(reason, "ambiguous") ||
        str_has(reason, "incomplete") || ctx.symtab.dep_pkg_names.length() > 0 {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            tokens[open_b].line,
            tokens[open_b].col,
            "cross-package struct update on `" + sname + "` blocked (unknown/legacy ABI): " + reason,
          ))
          return sname + "::" + lower_struct_brace(ctx, sname, tokens, open_b, close_b, file, false)
        }
      }
    }
  }
  if all_pure || base_s < 0 || base_e <= base_s {
    return sname + "::" + lower_struct_brace(ctx, sname, tokens, open_b, close_b, file, false)
  }
  match resolved_decl_fields {
    None => {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[open_b].line,
        tokens[open_b].col,
        "struct update with potentially effectful field expression on foreign struct `" + sname + "` (unknown field order/mutability) is not supported (fail-closed)",
      ))
      sname + "::" + lower_struct_brace(ctx, sname, tokens, open_b, close_b, file, false)
    }
    Some(decl_fields) => {
      let decl_idx : Map[String, Int] = Map()
      let mut di = 0
      while di < decl_fields.length() {
        decl_idx[decl_fields[di]] = di
        di = di + 1
      }
      let mut in_order = true
      let mut prev_idx = -1
      for ov in overrides {
        match decl_idx.get(ov.0) {
          Some(ci) => {
            if ci <= prev_idx {
              in_order = false
            }
            prev_idx = ci
          }
          None => in_order = false
        }
      }
      let base_var = fresh_temp(ctx, "su_b")
      let base_expr = lower_expr_range(ctx, tokens, base_s, base_e, file, false).trim()
      let base_static_ty = {
        let bt = infer_simple_expr_type(ctx, tokens, base_s, base_e).trim()
        if bt.length() > 0 { bt } else { current_expected_type(ctx).trim() }
      }
      if in_order {
        let ov_map : Map[String, (Bool, Int, Int)] = Map()
        for ov in overrides {
          ov_map[ov.0] = (ov.1, ov.2, ov.3)
        }
        let sb = StringBuilder()
        sb.write_string("{ let " + base_var + " = " + base_expr + "; " + sname + "::{ ")
        let mut first = true
        for df in decl_fields {
          if !first { sb.write_string(", ") }
          first = false
          let rf = if is_foreign_expand {
            match foreign_emit_names.get(df) { Some(en) => en, None => rename_struct_field(ctx, sname, df) }
          } else {
            rename_struct_field(ctx, sname, df)
          }
          match ov_map.get(df) {
            Some(ov) => {
              if ov.0 {
                sb.write_string(rf + ": " + resolve_ident_in_scope(ctx, df))
              } else {
                let raw_ft = if is_foreign_expand {
                  match foreign_field_tys.get(df) { Some(ft) => ft, None => "" }
                } else {
                  match ctx.symtab.struct_field_types.get(sname) {
                    Some(fmap) => match fmap.get(df) { Some(ft) => ft, None => "" }
                    None => ""
                  }
                }
                let field_exp_ty = if is_foreign_expand {
                  instantiate_struct_field_ty_with_tparams(ctx, foreign_tparams, raw_ft, base_static_ty)
                } else {
                  instantiate_struct_field_ty(ctx, sname, raw_ft, base_static_ty)
                }
                push_expected_type(ctx, if field_exp_ty.length() > 0 { field_exp_ty } else { raw_ft })
                let vs = lower_expr_range(ctx, tokens, ov.1, ov.2, file, false).trim()
                pop_expected_type(ctx)
                sb.write_string(rf + ": " + vs)
              }
            }
            None => sb.write_string(rf + ": " + base_var + "." + rf)
          }
        }
        sb.write_string(" } }")
        sb.to_string()
      } else {
        let sb = StringBuilder()
        sb.write_string("{ let " + base_var + " = " + base_expr + "; ")
        let field_tmps : Array[(String, String)] = []
        for ov in overrides {
          let rf = if is_foreign_expand {
            match foreign_emit_names.get(ov.0) { Some(en) => en, None => rename_struct_field(ctx, sname, ov.0) }
          } else {
            rename_struct_field(ctx, sname, ov.0)
          }
          let tv = fresh_temp(ctx, "su_f")
          let field_exp_ty = if is_foreign_expand {
            match foreign_field_tys.get(ov.0) { Some(ft) => ft.trim(), None => "" }
          } else {
            match ctx.symtab.struct_field_types.get(sname) {
              Some(fmap) => match fmap.get(ov.0) { Some(ft) => ft.trim(), None => "" }
              None => ""
            }
          }
          let annot_ty = if is_foreign_expand {
            instantiate_struct_field_ty_with_tparams(ctx, foreign_tparams, field_exp_ty, base_static_ty)
          } else {
            instantiate_struct_field_ty(ctx, sname, field_exp_ty, base_static_ty)
          }
          let vs = if ov.1 {
            resolve_ident_in_scope(ctx, ov.0)
          } else {
            push_expected_type(ctx, if annot_ty.length() > 0 { annot_ty } else { field_exp_ty })
            let s = lower_expr_range(ctx, tokens, ov.2, ov.3, file, false).trim()
            pop_expected_type(ctx)
            s
          }
          if annot_ty.length() > 0 {
            sb.write_string("let " + tv + " : " + annot_ty + " = " + vs + "; ")
          } else {
            sb.write_string("let " + tv + " = " + vs + "; ")
          }
          field_tmps.push((rf, tv))
        }
        sb.write_string(sname + "::{ .." + base_var)
        for ft in field_tmps {
          sb.write_string(", " + ft.0 + ": " + ft.1)
        }
        sb.write_string(" } }")
        sb.to_string()
      }
    }
  }
}

///| Check whether an anonymous `{ ... }` is a MoonBit struct literal containing shorthand fields
///| (e.g. `{ key, title, content, disabled }` or `{ from, to, lit: false }`) which Pion requires
///| to be written with explicit `field: field` syntax when the struct name is omitted.
fn is_anon_shorthand_struct_lit(tokens : Array[Token], open_b : Int, close_b : Int) -> Bool {
  if close_b <= open_b + 2 {
    return false
  }
  let mut has_comma = false
  let mut has_shorthand = false
  let mut item_count = 0
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      has_comma = true
      i = i + 1
      continue
    }
    // Find end of this comma-separated item at depth 0
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if e <= i {
      return false
    }
    item_count = item_count + 1
    if tokens[i].kind == TokenKind::DotDot {
      // Spread `..base` is valid in struct literal
      let _ = 0
    } else if e == i + 1 && tokens[i].kind == TokenKind::Ident {
      has_shorthand = true
    } else if e >= i + 3 && (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    tokens[i + 1].kind == TokenKind::Colon {
      // `field: expr` is valid
      let _ = 0
    } else {
      return false
    }
    i = e
  }
  has_shorthand && has_comma && item_count >= 1
}

///| Lower an anonymous struct literal `{ a, b, c: expr }` expanding bare shorthand `a` -> `a: a`.
fn lower_anon_shorthand_struct_lit(
  ctx : StageAContext,
  struct_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  sb.write_string("{")
  let mut i = open_b + 1
  while i < close_b {
    let t = tokens[i]
    if t.kind == TokenKind::Comma {
      sb.write_string(t.leading_trivia + ",")
      i = i + 1
      continue
    }
    if t.kind == TokenKind::DotDot {
      sb.write_string(t.leading_trivia + "..")
      let mut e = i + 1
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
        else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && ek == TokenKind::Comma { break }
        e = e + 1
      }
      sb.write_string(lower_expr_range(ctx, tokens, i + 1, e, file, false))
      i = e
      continue
    }
    if (t.kind == TokenKind::Ident || t.kind == TokenKind::Keyword) && i + 1 < close_b && tokens[i + 1].kind == TokenKind::Colon {
      let raw_f = t.raw
      let renamed_f = if struct_name.length() > 0 { rename_struct_field(ctx, struct_name, raw_f) } else { rename_keyword_ident(raw_f) }
      sb.write_string(t.leading_trivia + renamed_f + tokens[i + 1].leading_trivia + ":")
      let mut e = i + 2
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
        else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && ek == TokenKind::Comma { break }
        e = e + 1
      }
      if struct_name.length() > 0 {
        let field_exp_ty = match ctx.symtab.struct_field_types.get(struct_name) {
          Some(fmap) => match fmap.get(raw_f) { Some(ft) => ft, None => "" }
          None => ""
        }
        push_expected_type(ctx, field_exp_ty)
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, false))
        pop_expected_type(ctx)
      } else {
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, false))
      }
      i = e
      continue
    }
    if t.kind == TokenKind::Ident && (i + 1 == close_b || tokens[i + 1].kind == TokenKind::Comma) {
      let renamed_f = if struct_name.length() > 0 { rename_struct_field(ctx, struct_name, t.raw) } else { rename_keyword_ident(t.raw) }
      let local_v = resolve_ident_in_scope(ctx, t.raw)
      sb.write_string(t.leading_trivia + renamed_f + ": " + local_v)
      i = i + 1
      continue
    }
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, close_b, file, false)
    sb.write_string(piece)
    i = next_i
  }
  sb.write_string(tokens[close_b].leading_trivia + "}")
  sb.to_string()
}

///| Resolve an anonymous `{ ... }` struct literal to its concrete local struct name `S`
///| (using expected type first, then unique field-set match across `ctx.struct_field_renames`)
///| so we emit explicit `S::{ ... }` instead of anonymous `{ ... }` (which avoids Pion native SIGSEGV!).
fn resolve_anon_struct_literal_name(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
) -> Option[String] {
  if close_b <= open_b + 2 {
    return None
  }
  // Verify every top-level comma-separated item is a struct field (`f: expr`, `..base`, or shorthand `f`)
  // and collect field names. A bare single-item `{ x }` without `:` is a block, NOT a struct literal!
  let fields : Array[String] = []
  let mut has_colon = false
  let mut has_spread = false
  let mut base_s = -1
  let mut base_e = -1
  let mut has_comma = false
  let mut item_count = 0
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      has_comma = true
      i = i + 1
      continue
    }
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if e <= i {
      return None
    }
    item_count = item_count + 1
    if tokens[i].kind == TokenKind::DotDot {
      has_spread = true
      if base_s < 0 && i + 1 < e {
        base_s = i + 1
        base_e = e
      }
    } else if e >= i + 3 && (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    tokens[i + 1].kind == TokenKind::Colon {
      has_colon = true
      fields.push(tokens[i].raw)
    } else if e == i + 1 && tokens[i].kind == TokenKind::Ident {
      fields.push(tokens[i].raw)
    } else {
      return None
    }
    i = e
  }
  if item_count == 0 || (!has_colon && !has_spread && !has_comma) {
    return None
  }
  // For struct update `{ ..base, f: v }`, prioritize `base`'s known static type, then outer expected type;
  // NEVER guess a local struct by matching only overridden field names (fail-closed when unknown or conflicting).
  let raw_exp = current_expected_type(ctx).trim()
  let exp_base = {
    let bi = raw_exp.index_of("[")
    if bi > 0 { raw_exp.slice(0, bi).trim() } else { raw_exp }
  }
  if has_spread {
    let raw_base = if base_s > 0 && base_e > base_s {
      infer_simple_expr_type(ctx, tokens, base_s, base_e).trim()
    } else {
      ""
    }
    let base_name = {
      let bi = raw_base.index_of("[")
      if bi > 0 { raw_base.slice(0, bi).trim() } else { raw_base }
    }
    let resolve_struct_cand = fn(raw_cand : String) -> String {
      if raw_cand.length() == 0 {
        return ""
      }
      let cand = match ctx.symtab.using_types.get(raw_cand) {
        Some(q) => strip_type_args_sym(q)
        None =>
        match ctx.symtab.type_aliases.get(raw_cand) {
          Some(a) => strip_type_args_sym(a)
          None => raw_cand
        }
      }
      match ctx.struct_field_renames.get(cand) {
        Some(rmap) => {
          for f in fields {
            if !rmap.contains(f) {
              return ""
            }
          }
          cand
        }
        None => if str_has(cand, "::") { cand } else { "" }
      }
    }
    let resolved_base = resolve_struct_cand(base_name)
    let resolved_exp = resolve_struct_cand(exp_base)
    if resolved_base.length() > 0 && resolved_exp.length() > 0 && resolved_base != resolved_exp {
      return None
    }
    if resolved_base.length() > 0 {
      return Some(resolved_base)
    }
    if resolved_exp.length() > 0 {
      return Some(resolved_exp)
    }
    return None
  }
  // 1. Expected type in context takes priority
  if exp_base.length() > 0 {
    match ctx.struct_field_renames.get(exp_base) {
      Some(rmap) => {
        let mut all_present = true
        for f in fields {
          if !rmap.contains(f) {
            all_present = false
            break
          }
        }
        if all_present && fields.length() == rmap.length() {
          return Some(exp_base)
        }
      }
      None => ()
    }
  }
  // 2. Exact unique field-set match across all local structs
  let exact_matches : Array[String] = []
  for sname in sorted_map_keys(ctx.struct_field_renames) {
    match ctx.struct_field_renames.get(sname) {
      Some(rmap) => {
        let mut all_present = true
        for f in fields {
          if !rmap.contains(f) {
            all_present = false
            break
          }
        }
        if all_present && fields.length() == rmap.length() {
          exact_matches.push(sname)
        }
      }
      None => ()
    }
  }
  if exact_matches.length() == 1 {
    return Some(exact_matches[0])
  }
  None
}

fn fresh_temp(ctx : StageAContext, prefix : String) -> String {
  while true {
    ctx.temp_counter = ctx.temp_counter + 1
    let cand = "__mbt_" + prefix + "_" + ctx.temp_counter.to_string()
    if !ctx.used_idents.contains(cand) {
      ctx.used_idents[cand] = true
      return cand
    }
  }
  "__mbt_" + prefix + "_0"
}

///| Parsed parameter of a MoonBit function.
struct ParsedParam {
  name : String
  pion_name : String
  ty : String
  is_opt : Bool
  is_tilde : Bool
  default_expr : String
  is_loc : Bool
}

///| Parse `#derive(A, B)` attribute argument list.
fn parse_derive_names(attr_raw : String) -> Array[String] {
  let lp = attr_raw.index_of("(")
  let rp = attr_raw.index_of(")")
  if lp < 0 || rp <= lp {
    return []
  }
  let inner = attr_raw.slice(lp + 1, rp)
  let parts = inner.split(",")
  let out : Array[String] = []
  for p in parts {
    let t = p.trim()
    if t.length() > 0 {
      out.push(t)
    }
  }
  out
}

///| Check if a type name is primitive for Pion `derive(Eq)`.
fn is_primitive_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Byte" ||
  t == "Bool" || t == "Double" || t == "Float" || t == "Char" || t == "String" || t == "Unit"
}

///| Lower a MoonBit parameter list `(a : Int, x? : Int = 17, loc~ : SourceLoc)`
///| returning `(pion_param_list_str, lazy_default_stmts, has_opt_default)`.
fn lower_param_list(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  autofill_loc : Bool,
) -> (String, String, Bool) {
  let (s, pre, has_opt, _) = lower_param_list_scoped(ctx, tokens, open_p, close_p, file, autofill_loc, false)
  (s, pre, has_opt)
}

fn lower_param_list_scoped(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  autofill_loc : Bool,
  use_outer_scope : Bool,
) -> (String, String, Bool, Map[String, String]) {
  // Pre-collect raw param names so colliding keyword params (e.g. `val~` + `val_~`, or nested `fn(val)`
  // inside an outer scope with `val_` / `val_1`) get collision-free names.
  let raw_pnames_for_rename : Array[String] = []
  let mut rpi = open_p + 1
  while rpi < close_p {
    if tokens[rpi].kind == TokenKind::Comma { rpi = rpi + 1; continue }
    let mut rpe = rpi
    let mut rpd = 0
    while rpe < close_p {
      let rk = tokens[rpe].kind
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rpd = rpd + 1 }
      else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { rpd = rpd - 1 }
      else if rk == TokenKind::Comma && rpd == 0 { break }
      rpe = rpe + 1
    }
    if rpe > rpi {
      raw_pnames_for_rename.push(tokens[rpi].raw)
    }
    rpi = rpe + 1
  }
  let local_param_renames = if use_outer_scope {
    compute_scoped_binder_renames(ctx, raw_pnames_for_rename)
  } else {
    compute_param_renames(raw_pnames_for_rename)
  }

  let params : Array[ParsedParam] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    // Find end of this parameter (top-level comma or close_p)
    let mut p_end = i
    let mut depth = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if k == TokenKind::Comma && depth == 0 {
        break
      }
      p_end = p_end + 1
    }
    if p_end > i {
      let pname = tokens[i].raw
      let pion_name = match local_param_renames.get(pname) {
        Some(rn) => rn
        None => rename_keyword_ident(pname)
      }
      let mut cur = i + 1
      let mut is_opt = false
      let mut is_tilde = false
      if cur < p_end && tokens[cur].kind == TokenKind::Question {
        is_opt = true
        cur = cur + 1
      } else if cur < p_end && tokens[cur].kind == TokenKind::Tilde {
        is_tilde = true
        cur = cur + 1
      }
      // Find `:` and top-level `=`
      let mut colon_idx = -1
      let mut eq_idx = -1
      let mut scan = cur
      let mut d2 = 0
      while scan < p_end {
        let sk = tokens[scan].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace {
          d2 = d2 + 1
        } else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace {
          d2 = d2 - 1
        } else if d2 == 0 {
          if sk == TokenKind::Colon && colon_idx < 0 {
            colon_idx = scan
          } else if sk == TokenKind::Eq && eq_idx < 0 {
            eq_idx = scan
          }
        }
        scan = scan + 1
      }
      let ty_end = if eq_idx >= 0 { eq_idx } else { p_end }
      let raw_ty = if colon_idx >= 0 {
        lower_type_tokens_checked(ctx, tokens, colon_idx + 1, ty_end, file)
      } else {
        ""
      }
      let is_loc = (autofill_loc && pname == "loc") ||
      (colon_idx >= 0 && colon_idx + 2 == ty_end && tokens[colon_idx + 1].raw == "SourceLoc")
      let def_expr = if eq_idx >= 0 {
        if raw_ty.length() > 0 { push_expected_type(ctx, raw_ty) }
        let lowered_def = lower_expr_range(ctx, tokens, eq_idx + 1, p_end, file, false).trim()
        if raw_ty.length() > 0 { pop_expected_type(ctx) }
        lowered_def
      } else {
        ""
      }
      params.push(ParsedParam::{
        name: pname,
        pion_name: pion_name,
        ty: if is_loc { "String" } else { raw_ty },
        is_opt: is_opt,
        is_tilde: is_tilde,
        default_expr: def_expr,
        is_loc: is_loc,
      })
    }
    i = p_end + 1
  }

  let sig_sb = StringBuilder()
  let prelude_sb = StringBuilder()
  let mut has_opt_default = false
  let mut pi = 0
  while pi < params.length() {
    let p = params[pi]
    if pi > 0 {
      sig_sb.write_string(", ")
    }
    if p.is_loc && p.is_tilde && (p.default_expr.length() == 0 || p.default_expr == "_") {
      sig_sb.write_string(p.pion_name + "~ : String = \"\"")
    } else if p.is_loc && !p.is_opt && !p.is_tilde {
      sig_sb.write_string(p.pion_name + " : String")
    } else if (p.is_opt || p.is_tilde) && p.default_expr.length() > 0 {
      // Migrated callee: preserve `x? : T` in Pion signature and lazily evaluate default in `None` branch!
      // This allows `f(x?=x)` forwarding while preserving side-effect laziness.
      has_opt_default = true
      sig_sb.write_string(p.pion_name + "? : " + p.ty)
      prelude_sb.write_string(
        "  let " + p.pion_name + " = match " + p.pion_name + " { Some(__mbt_v) => __mbt_v, None => " + p.default_expr + " }\n",
      )
    } else if p.is_opt {
      sig_sb.write_string(p.pion_name + "? : " + p.ty)
    } else if p.is_tilde {
      sig_sb.write_string(p.pion_name + "~ : " + p.ty)
    } else if p.ty.length() > 0 {
      sig_sb.write_string(p.pion_name + " : " + p.ty)
    } else {
      sig_sb.write_string(p.pion_name)
    }
    pi = pi + 1
  }
  (sig_sb.to_string(), prelude_sb.to_string(), has_opt_default, local_param_renames)
}

///| Lower an interpolated string `"..."` or `$|...` by recursively lowering each `\{...}` expression
///| while preserving literal bytes verbatim!
fn lower_interp_string(
  ctx : StageAContext,
  raw : String,
  is_multiline : Bool,
  file : String,
) -> String {
  let parts = split_interp_string(if is_multiline { strip_trailing_cr(raw) } else { raw }, is_multiline)
  let sb = StringBuilder()
  if is_multiline {
    sb.write_string("\"")
  } else {
    sb.write_string("\"")
  }
  for part in parts {
    if !part.is_expr {
      let fixed_part_q = lower_mbt_string_surrogates("\"" + part.text + "\"", file, 1, 1, ctx.diags)
      let fixed_part = if fixed_part_q.length() >= 2 {
        fixed_part_q.slice(1, fixed_part_q.length() - 1)
      } else {
        part.text
      }
      if is_multiline {
        // Escape `"` in `$|...` when emitting normal Pion string literal
        sb.write_string(str_replace_all(fixed_part, "\"", "\\\""))
      } else {
        sb.write_string(fixed_part)
      }
    } else {
      let inner_toks = lex_moonbit(part.text)
      let saved_it = ctx.in_interp_top
      ctx.in_interp_top = true
      let lowered = lower_expr_range(ctx, inner_toks, 0, inner_toks.length() - 1, file, false).trim()
      ctx.in_interp_top = saved_it
      sb.write_string("\\{")
      sb.write_string(lowered)
      sb.write_string("}")
    }
  }
  sb.write_string("\"")
  sb.to_string()
}

///| Drop the `\r` a CRLF source leaves at the end of a `#|` / `$|` line token.
fn strip_trailing_cr(raw : String) -> String {
  if raw.ends_with("\r") { raw.slice(0, raw.length() - 1) } else { raw }
}

///| A MoonBit multiline string is a run of consecutive `#|` / `$|` lines joined by `\n`. Pion keeps pure `#|` runs
///| natively, but each `$|` line lowers to its own `"..."` literal, so a run of 2+ lines that contains a `$|` line
///| is lowered to one parenthesized concatenation `("l0" + "\n" + "l1" ...)`; `#|` lines become escaped literals.
///| Returns `None` for a single line or a pure `#|` run (unchanged lowering).
fn lower_multiline_group(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let mut j = i + 1
  let mut has_interp = tokens[i].kind == TokenKind::InterpMultiline
  while j < end && tokens[j].newline_before &&
  (tokens[j].kind == TokenKind::InterpMultiline || tokens[j].kind == TokenKind::RawMultiline) {
    if tokens[j].kind == TokenKind::InterpMultiline { has_interp = true }
    j = j + 1
  }
  if j == i + 1 || !has_interp {
    return None
  }
  let sb = StringBuilder()
  sb.write_string("(")
  let mut k = i
  while k < j {
    if k > i {
      sb.write_string(" + \"\\n\" + ")
    }
    let tk = tokens[k]
    if tk.kind == TokenKind::InterpMultiline {
      sb.write_string(lower_interp_string(ctx, tk.raw, true, file))
    } else {
      let raw_line = strip_trailing_cr(tk.raw)
      let body = if raw_line.starts_with("#|") { raw_line.slice(2, raw_line.length()) } else { raw_line }
      sb.write_string("\"" + str_replace_all(str_replace_all(body, "\\", "\\\\"), "\"", "\\\"") + "\"")
    }
    k = k + 1
  }
  sb.write_string(")")
  Some((sb.to_string(), j))
}

///| Check whether `{ ... }` is a MoonBit Map literal `{ "k": v, ... }` (string/int key followed by `:`).
fn is_map_literal(tokens : Array[Token], open_b : Int, close_b : Int) -> Bool {
  if close_b <= open_b + 3 {
    return false
  }
  let k1 = tokens[open_b + 1].kind
  let k2 = tokens[open_b + 2].kind
  (k1 == TokenKind::StringLit || k1 == TokenKind::IntLit || k1 == TokenKind::CharLit) &&
  k2 == TokenKind::Colon
}

///| True iff `raw` is a plain decimal integer literal (digits and `_`, no hex/bin/oct prefix or `L`/`U` suffix).
fn is_plain_decimal_int_lit(raw : String) -> Bool {
  if raw.length() == 0 {
    return false
  }
  if raw.starts_with("0x") || raw.starts_with("0X") || raw.starts_with("0b") || raw.starts_with("0B") ||
  raw.starts_with("0o") || raw.starts_with("0O") {
    return false
  }
  let mut k = 0
  while k < raw.length() {
    let c = raw.code_unit_at(k)
    if !((c >= 48 && c <= 57) || c == 95) {
      return false
    }
    k = k + 1
  }
  true
}

///| Coerce a standalone plain decimal integer literal (or `-<digits>`) to a `Double` literal (`N.0`).
fn coerce_standalone_int_to_double_f42(s : String) -> String {
  let tr = s.trim()
  if is_plain_decimal_int_lit(tr) {
    return tr + ".0"
  }
  if tr.starts_with("-") && tr.length() > 1 && is_plain_decimal_int_lit(tr.slice(1, tr.length()).trim()) {
    return "-" + tr.slice(1, tr.length()).trim() + ".0"
  }
  s
}

///| True iff the immediately preceding same-line token is a binary/postfix/path operator
///| so the token at `i` is an operand/member and MUST NOT be wrapped as a standalone `MbtJson` literal.
fn prev_tok_breaks_json_lit(tokens : Array[Token], i : Int) -> Bool {
  if i <= 0 || tokens[i].newline_before {
    return false
  }
  let pk = tokens[i - 1].kind
  pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
  pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::EqEq ||
  pk == TokenKind::BangEq || pk == TokenKind::Lt || pk == TokenKind::LtEq ||
  pk == TokenKind::Gt || pk == TokenKind::GtEq || pk == TokenKind::AmpAmp ||
  pk == TokenKind::PipePipe || pk == TokenKind::Dot || pk == TokenKind::ColonColon ||
  pk == TokenKind::PipeGt || pk == TokenKind::DotDot || pk == TokenKind::DotDotLt ||
  pk == TokenKind::DotDotEq || pk == TokenKind::DotDotLtEq
}

///| Lower a Map literal `{ k1: v1, k2: v2 }` to `mbt_compat::ordered_map_from([(k1, v1), (k2, v2)])`.
fn lower_map_literal(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  // Bind the pairs to a `let` first unless the literal is a direct typed value (see `hoist_pairs_literal`).
  let has_chain = close_b + 1 < tokens.length() && tokens[close_b + 1].kind == TokenKind::Dot
  let kv = if has_chain { "" } else { expected_map_kv(ctx) }
  let kv_parts = if kv.length() > 0 { split_top_level_type_list(kv) } else { [] }
  let k_exp = if kv_parts.length() == 2 { kv_parts[0].trim() } else { "" }
  let v_exp = if kv_parts.length() == 2 { kv_parts[1].trim() } else { "" }
  let hoist = !(kv.length() > 0 && is_direct_statement_value(tokens, open_b, close_b + 1))
  let sfx = if has_chain { "" } else { tuple_key_ctor_suffix(ctx) }
  let pairs_nm = if hoist { alloc_pairs_name(ctx, tokens[open_b].line, tokens[open_b].col) } else { "" }
  let ann = if kv.length() > 0 { " : Array[(" + kv + ")]" } else { "" }
  sb.write_string(if hoist { "({ let " + pairs_nm + ann + " = [" } else { "mbt_compat::ordered_map_from_array" + sfx + "([" })
  let mut i = open_b + 1
  let mut first = true
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    // Find `:` and entry end `,`
    let mut colon_i = -1
    let mut end_i = i
    let mut depth = 0
    while end_i < close_b {
      let k = tokens[end_i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if depth == 0 {
        if k == TokenKind::Colon && colon_i < 0 {
          colon_i = end_i
        } else if k == TokenKind::Comma {
          break
        }
      }
      end_i = end_i + 1
    }
    if colon_i > i {
      if !first {
        sb.write_string(", ")
      }
      push_expected_type(ctx, k_exp)
      let raw_k_expr = lower_expr_range(ctx, tokens, i, colon_i, file, false).trim()
      pop_expected_type(ctx)
      let k_expr = if k_exp == "Double" { coerce_standalone_int_to_double_f42(raw_k_expr) } else { raw_k_expr }
      push_expected_type(ctx, v_exp)
      let raw_v_expr = lower_expr_range(ctx, tokens, colon_i + 1, end_i, file, false).trim()
      pop_expected_type(ctx)
      let v_expr = if v_exp == "Double" { coerce_standalone_int_to_double_f42(raw_v_expr) } else { raw_v_expr }
      sb.write_string("(" + k_expr + ", " + v_expr + ")")
      first = false
    }
    i = end_i + 1
  }
  sb.write_string(if hoist { "]; mbt_compat::ordered_map_from_array" + sfx + "(" + pairs_nm + ") })" } else { "])" })
  sb.to_string()
}

fn effective_ref_type(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.type_name.length() > 0 {
    recipes.ref_recipe.type_name
  } else {
    "mbt_compat::Ref"
  }
}

fn effective_ref_ctor(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.ctor_call.length() > 0 {
    recipes.ref_recipe.ctor_call
  } else {
    "mbt_compat::ref_new"
  }
}

fn effective_ref_field(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.field_name.length() > 0 {
    recipes.ref_recipe.field_name
  } else {
    "v"
  }
}

fn is_known_mbt_ref_type(ctx : StageAContext, ty : String) -> Bool {
  if ctx.symtab.local_types.contains("Ref") || ctx.active_generics.contains("Ref") {
    return false
  }
  let base = strip_type_args_sym(ty)
  if base == "mbt_compat::Ref" || base == "Ref" {
    return true
  }
  let ref_ty = effective_ref_type(ctx.recipes)
  base == ref_ty
}

///| Sound static `.val` field resolver (P1-1): resolves `.val` directly in Stage A ONLY when
///| the receiver's static type is provably unshadowed `mbt_compat::Ref` (or recipe `ref_recipe.type_name`)
///| or a local struct registered in `ctx.struct_val_fields`. Returns `None` for unknown/foreign receivers
///| so Stage A.5 + both negative gates (`MBT2PION_UNDISPOSED_PROBE_SITE`, `MBT2PION_DEP_ABI_ERROR`) stay intact.
fn try_resolve_static_val_field_from_ty(ctx : StageAContext, recv_ty : String) -> Option[String] {
  if recv_ty.length() == 0 {
    return None
  }
  if is_known_mbt_ref_type(ctx, recv_ty) {
    return Some(effective_ref_field(ctx.recipes))
  }
  let base = strip_type_args_sym(recv_ty)
  match ctx.struct_val_fields.get(base) {
    Some(rf) => return Some(rf)
    None => ()
  }
  None
}

///| Split top-level comma-separated type arguments inside `s` (respecting `[]` and `()`).
fn split_top_level_type_args(s : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  let n = s.length()
  while i < n {
    let ch = s.code_unit_at(i)
    if ch == 91 || ch == 40 {
      depth = depth + 1
    } else if ch == 93 || ch == 41 {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 && ch == 44 {
      out.push(s.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  if start <= n {
    let tail = s.slice(start, n).trim()
    if tail.length() > 0 { out.push(tail) }
  }
  out
}

///| Shallowly match a generic return-type pattern `pat` (e.g. `T`, `Option[T]`, `Array[T]`, `Result[T, E]`)
///| against concrete expected type `concrete`, recording type-parameter bindings in `subst`.
fn match_pipe_type_pattern(pat : String, concrete : String, subst : Map[String, String]) -> Unit {
  let p = pat.trim()
  let c = concrete.trim()
  if p.length() == 0 || c.length() == 0 {
    return
  }
  let p_lb = p.index_of("[")
  let p_lp = p.index_of("(")
  if p_lb < 0 && p_lp < 0 && !str_has(p, "::") && !str_has(p, ",") && !str_has(p, " ") {
    if p != "Int" && p != "Int64" && p != "UInt" && p != "UInt64" && p != "Double" &&
    p != "Float" && p != "Bool" && p != "String" && p != "Char" && p != "Unit" &&
    p != "Byte" && p != "Bytes" && p != "Json" && p != "Never" {
      subst[p] = c
    }
    return
  }
  if p_lb > 0 && p.ends_with("]") {
    let head = p.slice(0, p_lb).trim()
    let c_lb = c.index_of("[")
    if c_lb > 0 && c.ends_with("]") && c.slice(0, c_lb).trim() == head {
      let pargs = split_top_level_type_args(p.slice(p_lb + 1, p.length() - 1))
      let cargs = split_top_level_type_args(c.slice(c_lb + 1, c.length() - 1))
      if pargs.length() == cargs.length() {
        let mut idx = 0
        while idx < pargs.length() {
          match_pipe_type_pattern(pargs[idx], cargs[idx], subst)
          idx = idx + 1
        }
      }
    }
    return
  }
  if p.starts_with("(") && p.ends_with(")") && c.starts_with("(") && c.ends_with(")") {
    let pargs = split_top_level_type_args(p.slice(1, p.length() - 1))
    let cargs = split_top_level_type_args(c.slice(1, c.length() - 1))
    if pargs.length() == cargs.length() {
      let mut idx = 0
      while idx < pargs.length() {
        match_pipe_type_pattern(pargs[idx], cargs[idx], subst)
        idx = idx + 1
      }
    }
  }
}

///| Derive the expected parameter type of a generic `|>` target by unifying its return type `ret_ty`
///| with the enclosing expected type `cur_exp` and substituting into `raw_p` (e.g. `Array[T] -> T`).
fn unify_pipe_ret_to_param(ret_ty : String, cur_exp : String, raw_p : String) -> String {
  let rt = ret_ty.trim()
  let ce = cur_exp.trim()
  let rp = raw_p.trim()
  if rt.length() == 0 || ce.length() == 0 || rp.length() == 0 {
    return ""
  }
  if rp == rt {
    return ce
  }
  let subst : Map[String, String] = Map()
  match_pipe_type_pattern(rt, ce, subst)
  if subst.length() == 0 {
    return ""
  }
  let toks = lex_moonbit(rp)
  let sb = StringBuilder()
  let mut replaced = false
  let mut i = 0
  while i < toks.length() - 1 {
    let tok = toks[i]
    let is_qual = i > 0 && (toks[i - 1].kind == TokenKind::ColonColon || toks[i - 1].kind == TokenKind::Dot)
    if !is_qual && (tok.kind == TokenKind::UpperIdent || tok.kind == TokenKind::Ident) {
      match subst.get(tok.raw) {
        Some(rep) => {
          sb.write_string(tok.leading_trivia + rep)
          replaced = true
        }
        None => sb.write_string(tok.leading_trivia + tok.raw)
      }
    } else {
      sb.write_string(tok.leading_trivia + tok.raw)
    }
    i = i + 1
  }
  if replaced { sb.to_string().trim() } else { "" }
}

///| Resolve the effective outer expected type for a `.map`/`.filter_map` call ending at `close_p`:
///| skips enclosing grouping `)` (not call `f(...)` closing parens), clears expected type on
///| chained `.method(...)`, and for `|> callee` resolves `callee`'s target parameter expected type
///| (respecting local variable shadowing, `_` placeholder position, and generic `ret -> param` unification).
fn resolve_method_closure_outer_exp(
  ctx : StageAContext,
  tokens : Array[Token],
  close_p : Int,
) -> String {
  let n = tokens.length()
  let mut after = close_p + 1
  while after < n && tokens[after].kind == TokenKind::RParen {
    let mut lp = after - 1
    let mut d = 1
    while lp >= 0 {
      let k = tokens[lp].kind
      if k == TokenKind::RParen {
        d = d + 1
      } else if k == TokenKind::LParen {
        d = d - 1
        if d == 0 {
          break
        }
      }
      lp = lp - 1
    }
    if lp < 0 {
      break
    }
    if lp > 0 && (tokens[lp - 1].kind == TokenKind::Ident || tokens[lp - 1].kind == TokenKind::UpperIdent ||
      tokens[lp - 1].kind == TokenKind::RParen || tokens[lp - 1].kind == TokenKind::RBracket) {
      break
    }
    after = after + 1
  }
  if after < n && tokens[after].kind == TokenKind::Dot {
    return ""
  }
  if after < n && tokens[after].kind == TokenKind::PipeGt {
    let ti = after + 1
    let mut callee_key = ""
    let mut is_bare = false
    let mut after_callee = ti
    if ti + 2 < n && tokens[ti].kind == TokenKind::PkgRef &&
    tokens[ti + 1].kind == TokenKind::Dot && tokens[ti + 2].kind == TokenKind::Ident {
      let raw_pkg = tokens[ti].raw.slice(1, tokens[ti].raw.length())
      let pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
        Some(mp) => mp
        None => raw_pkg
      }
      callee_key = pkg + "::" + tokens[ti + 2].raw
      after_callee = ti + 3
    } else if ti + 2 < n && tokens[ti].kind == TokenKind::UpperIdent &&
    tokens[ti + 1].kind == TokenKind::ColonColon && tokens[ti + 2].kind == TokenKind::Ident {
      callee_key = tokens[ti].raw + "::" + tokens[ti + 2].raw
      after_callee = ti + 3
    } else if ti < n && tokens[ti].kind == TokenKind::Ident {
      callee_key = tokens[ti].raw
      is_bare = true
      after_callee = ti + 1
    }
    // Determine pipe target parameter index (0 by default, or index of bare `_` placeholder in `callee(...)`).
    let mut pipe_pos = 0
    if after_callee < n && tokens[after_callee].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, after_callee)
      let mut ai = after_callee + 1
      let mut arg_idx = 0
      while ai < cp {
        let mut ae = ai
        let mut ad = 0
        while ae < cp {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { if ad > 0 { ad = ad - 1 } }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae == ai + 1 && tokens[ai].raw == "_" {
          pipe_pos = arg_idx
          break
        }
        arg_idx = arg_idx + 1
        ai = ae + 1
      }
    }
    if callee_key.length() > 0 {
      // Local variable / closure shadows any package-level `fn` of the same name.
      if is_bare {
        match lookup_scope_var(ctx, resolve_ident_in_scope(ctx, callee_key)) {
          Some(sv) => {
            let lptys = extract_expected_fn_param_types(sv.ty)
            if pipe_pos < lptys.length() {
              return lptys[pipe_pos].trim()
            }
            return ""
          }
          None => ()
        }
      }
      let callee_tparams : Map[String, Bool] = Map()
      match ctx.symtab.fn_type_params.get(callee_key) {
        Some(tps) => { for tp in tps { callee_tparams[tp] = true } }
        None => ()
      }
      match ctx.symtab.fn_param_types.get(callee_key) {
        Some(pts) =>
        if pipe_pos < pts.length() && pts[pipe_pos].1.trim().length() > 0 {
          let cand_p = pts[pipe_pos].1.trim()
          let mut has_free_tp = false
          if callee_tparams.length() > 0 {
            let ptoks = lex_moonbit(cand_p)
            let mut pti = 0
            while pti < ptoks.length() - 1 {
              let pt = ptoks[pti]
              let is_qual = pti > 0 && (ptoks[pti - 1].kind == TokenKind::ColonColon || ptoks[pti - 1].kind == TokenKind::Dot)
              if !is_qual && (pt.kind == TokenKind::UpperIdent || pt.kind == TokenKind::Ident) && callee_tparams.contains(pt.raw) {
                has_free_tp = true
                break
              }
              pti = pti + 1
            }
          }
          if !has_free_tp {
            return cand_p
          }
        }
        None => ()
      }
      let raw_p = match ctx.symtab.fn_raw_param_types.get(callee_key) {
        Some(rpts) => if pipe_pos < rpts.length() { rpts[pipe_pos].1.trim() } else { "" }
        None =>
        match ctx.symtab.fn_param_types.get(callee_key) {
          Some(pts) => if pipe_pos < pts.length() { pts[pipe_pos].1.trim() } else { "" }
          None => ""
        }
      }
      let ret_ty = match ctx.symtab.fn_ret_types.get(callee_key) {
        Some(rt) => rt.trim()
        None => ""
      }
      let unified = unify_pipe_ret_to_param(ret_ty, current_expected_type(ctx), raw_p)
      if unified.length() > 0 {
        return unified
      }
    }
    return ""
  }
  current_expected_type(ctx).trim()
}

///| Lower a single-parameter untyped closure `fn(x) { ... }` passed to `.map`/`.filter`/`.each`:
///| propagates `param_ty`, isolates `expected_type_stack` (`Bool` / `Unit` / `""`), and applies
///| scoped binder renames (`compute_scoped_binder_renames` + `ctx.ident_renames` push/pop).
fn lower_single_param_method_closure(
  ctx : StageAContext,
  tokens : Array[Token],
  fn_i : Int,
  close_p : Int,
  _end : Int,
  file : String,
  method_name : String,
  param_ty : String,
) -> Option[String] {
  if param_ty.length() == 0 || fn_i + 5 >= close_p {
    return None
  }
  if !(tokens[fn_i].kind == TokenKind::Keyword && tokens[fn_i].raw == "fn" &&
    tokens[fn_i + 1].kind == TokenKind::LParen && tokens[fn_i + 2].kind == TokenKind::Ident &&
    tokens[fn_i + 3].kind == TokenKind::RParen && tokens[fn_i + 4].kind == TokenKind::LBrace &&
    find_matching_delim(tokens, fn_i + 4) == close_p - 1) {
    return None
  }
  let raw_pname = tokens[fn_i + 2].raw
  let rn = if raw_pname == "_" { Map() } else { compute_scoped_binder_renames(ctx, [raw_pname]) }
  ctx.ident_renames.push(rn)
  let pname = match rn.get(raw_pname) {
    Some(r) => r
    None => raw_pname
  }
  let saved_sc = ctx.scope_vars.length()
  ctx.scope_vars.push(ScopeVar::{ name: pname, ty: param_ty, is_mut: false, is_boxed: false })
  let outer_exp = resolve_method_closure_outer_exp(ctx, tokens, close_p)
  let body_exp = if method_name == "filter" {
    "Bool"
  } else if method_name == "each" {
    "Unit"
  } else if method_name == "map" {
    if outer_exp.starts_with("Array[") && outer_exp.ends_with("]") {
      outer_exp.slice(6, outer_exp.length() - 1).trim()
    } else if outer_exp.starts_with("Option[") && outer_exp.ends_with("]") {
      outer_exp.slice(7, outer_exp.length() - 1).trim()
    } else if outer_exp == "mbt_compat::MbtJson" || outer_exp == "Json" {
      "mbt_compat::MbtJson"
    } else {
      ""
    }
  } else if method_name == "filter_map" {
    if outer_exp.starts_with("Array[") && outer_exp.ends_with("]") {
      "Option[" + outer_exp.slice(6, outer_exp.length() - 1).trim() + "]"
    } else {
      ""
    }
  } else {
    ""
  }
  push_expected_type(ctx, body_exp)
  let body_s = lower_block_range(ctx, tokens, fn_i + 4, close_p - 1, file, "")
  pop_expected_type(ctx)
  restore_scope_vars(ctx, saved_sc)
  let _ = ctx.ident_renames.pop()
  Some("fn(" + pname + ") " + body_s)
}

fn lookup_ident_static_type(ctx : StageAContext, raw_ident : String) -> String {
  let eff = resolve_ident_in_scope(ctx, raw_ident)
  match lookup_scope_var(ctx, eff) {
    Some(sv) => return sv.ty
    None => ()
  }
  if eff != raw_ident {
    match lookup_scope_var(ctx, raw_ident) {
      Some(sv) => return sv.ty
      None => ()
    }
  }
  match ctx.symtab.val_types.get(raw_ident) {
    Some(vt) => return vt
    None => ()
  }
  match ctx.symtab.val_types.get(eff) {
    Some(vt) => return vt
    None => ()
  }
  ""
}

fn extract_container_value_type(ty : String) -> String {
  let t = ty.trim()
  let lb = t.index_of("[")
  if lb <= 0 || !t.ends_with("]") {
    return ""
  }
  let base = t.slice(0, lb).trim()
  let inner = t.slice(lb + 1, t.length() - 1).trim()
  if base == "Array" || base == "FixedArray" || base == "ReadOnlyArray" || base == "ArrayView" || base == "mbt_compat::ArrayView" || base == "mbt_compat::ArrayBuf" {
    return inner
  }
  if base == "Map" || base == "mbt_compat::OrderedMap" {
    let mut i = 0
    let mut d = 0
    while i < inner.length() {
      let c = inner.code_unit_at(i)
      if c == 40 || c == 91 || c == 123 { d = d + 1 }
      else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
      else if d == 0 && c == 44 {
        return inner.slice(i + 1, inner.length()).trim()
      }
      i = i + 1
    }
  }
  ""
}

fn extract_tuple_elem_type(ty : String, idx : Int) -> String {
  let t = ty.trim()
  if !t.starts_with("(") || !t.ends_with(")") || idx < 0 {
    return ""
  }
  let inner = t.slice(1, t.length() - 1)
  let mut cur = 0
  let mut start = 0
  let mut d = 0
  let mut i = 0
  while i < inner.length() {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { d = d + 1 }
    else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
    else if d == 0 && c == 44 {
      if cur == idx { return inner.slice(start, i).trim() }
      cur = cur + 1
      start = i + 1
    }
    i = i + 1
  }
  if cur == idx { inner.slice(start, inner.length()).trim() } else { "" }
}

///| Resolve the static type of a root-anchored dot chain ending at `end_idx`
///| (e.g. `x`, `a.b.c`, `@pkg.v.field`), walking all the way back to the true chain head
///| and returning `""` whenever the head is preceded by `.`, `::`, `)`, `]`, or `}` (e.g. `f().inner.items`).
fn resolve_dot_chain_static_type(ctx : StageAContext, tokens : Array[Token], end_idx : Int) -> String {
  if end_idx < 0 || tokens[end_idx].kind != TokenKind::Ident {
    return ""
  }
  let rev_segs : Array[String] = []
  let mut head_i = end_idx
  while head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::Ident {
    rev_segs.push(tokens[head_i].raw)
    head_i = head_i - 2
  }
  let mut cur_ty = ""
  if head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::PkgRef {
    let raw_pkg = tokens[head_i - 2].raw.slice(1, tokens[head_i - 2].raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None => raw_pkg
    }
    let vname = tokens[head_i].raw
    cur_ty = match ctx.symtab.val_types.get(mapped_pkg + "::" + vname) {
      Some(t) => t
      None => match ctx.symtab.val_types.get(raw_pkg + "::" + vname) {
        Some(t) => t
        None => ""
      }
    }
  } else if head_i >= 1 && (tokens[head_i - 1].kind == TokenKind::Dot ||
    tokens[head_i - 1].kind == TokenKind::ColonColon ||
    (!tokens[head_i].newline_before && (tokens[head_i - 1].kind == TokenKind::RParen ||
      tokens[head_i - 1].kind == TokenKind::RBracket ||
      tokens[head_i - 1].kind == TokenKind::RBrace))) {
    return ""
  } else {
    cur_ty = lookup_ident_static_type(ctx, tokens[head_i].raw)
  }
  if cur_ty.length() == 0 {
    return ""
  }
  let mut ri = rev_segs.length() - 1
  while ri >= 0 {
    let sbase = strip_type_args_sym(cur_ty)
    match ctx.symtab.struct_field_types.get(sbase) {
      Some(fmap) =>
      match fmap.get(rev_segs[ri]) {
        Some(fty) => cur_ty = fty
        None => return ""
      }
      None => return ""
    }
    ri = ri - 1
  }
  cur_ty
}

///| Extract the true root identifier of a dot chain ending at `end_idx`, or `""` if not root-anchored.
fn extract_dot_chain_root_ident(tokens : Array[Token], end_idx : Int) -> String {
  if end_idx < 0 || tokens[end_idx].kind != TokenKind::Ident {
    return ""
  }
  let mut head_i = end_idx
  while head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::Ident {
    head_i = head_i - 2
  }
  if head_i >= 1 && (tokens[head_i - 1].kind == TokenKind::Dot ||
    tokens[head_i - 1].kind == TokenKind::ColonColon ||
    (!tokens[head_i].newline_before && (tokens[head_i - 1].kind == TokenKind::RParen ||
      tokens[head_i - 1].kind == TokenKind::RBracket ||
      tokens[head_i - 1].kind == TokenKind::RBrace))) {
    return ""
  }
  tokens[head_i].raw
}

fn try_resolve_static_val_field(ctx : StageAContext, tokens : Array[Token], dot_i : Int) -> Option[String] {
  if dot_i <= 0 {
    return None
  }
  // Case 0a: `(r.N).val` (parenthesized tuple element access — NEVER a function call `mk(r.0).val`!)
  if dot_i >= 5 && tokens[dot_i - 1].kind == TokenKind::RParen &&
  tokens[dot_i - 2].kind == TokenKind::IntLit && tokens[dot_i - 3].kind == TokenKind::Dot &&
  tokens[dot_i - 4].kind == TokenKind::Ident && tokens[dot_i - 5].kind == TokenKind::LParen &&
  !(dot_i >= 6 && !tokens[dot_i - 5].newline_before && (
    tokens[dot_i - 6].kind == TokenKind::Ident ||
    tokens[dot_i - 6].kind == TokenKind::UpperIdent ||
    tokens[dot_i - 6].kind == TokenKind::RParen ||
    tokens[dot_i - 6].kind == TokenKind::RBracket)) {
    let rty = lookup_ident_static_type(ctx, tokens[dot_i - 4].raw)
    if rty.length() > 0 {
      let mut idx = 0
      let raw_n = tokens[dot_i - 2].raw
      let mut k = 0
      while k < raw_n.length() {
        let c = raw_n.code_unit_at(k)
        if c >= 48 && c <= 57 { idx = idx * 10 + (c - 48) }
        k = k + 1
      }
      let ety = extract_tuple_elem_type(rty, idx)
      return try_resolve_static_val_field_from_ty(ctx, ety)
    }
    return None
  }
  // Case 0b: `<dot_chain>[k].val` (root-anchored dot chain before `[k]`)
  if dot_i >= 3 && tokens[dot_i - 1].kind == TokenKind::RBracket {
    let mut ob = dot_i - 2
    let mut d = 1
    while ob >= 0 && d > 0 {
      if tokens[ob].kind == TokenKind::RBracket { d = d + 1 }
      else if tokens[ob].kind == TokenKind::LBracket { d = d - 1 }
      if d == 0 { break }
      ob = ob - 1
    }
    if ob >= 1 && tokens[ob].kind == TokenKind::LBracket {
      let cty = resolve_dot_chain_static_type(ctx, tokens, ob - 1)
      if cty.length() > 0 {
        let vty = extract_container_value_type(cty)
        return try_resolve_static_val_field_from_ty(ctx, vty)
      }
    }
    return None
  }
  // Case 1/2/3: unified root-anchored dot chain (`@pkg.v.val`, `a.b.c.val`, `x.val`)
  let rty = resolve_dot_chain_static_type(ctx, tokens, dot_i - 1)
  if rty.length() > 0 {
    return try_resolve_static_val_field_from_ty(ctx, rty)
  }
  None
}

///| Check whether a `.val` assignment (`=` or `+=` etc.) must defer to Stage A.5's single-evaluation
///| receiver snapshot `{ let __mbt_r = <recv>; __mbt_r.v = ... }` instead of lowering directly to `.v`,
///| because Pion's LLBC keeps `root: r` by place reference when `r` is `mut` or RHS contains `{ ... }`.
fn should_defer_val_assign_to_a5(
  ctx : StageAContext,
  tokens : Array[Token],
  dot_i : Int,
  op_i : Int,
  end : Int,
) -> Bool {
  if op_i >= end || (tokens[op_i].kind != TokenKind::Eq && tokens[op_i].kind != TokenKind::AssignOp) {
    return false
  }
  let is_simple_ident_recv = dot_i >= 1 && tokens[dot_i - 1].kind == TokenKind::Ident &&
  !(dot_i >= 2 && (tokens[dot_i - 2].kind == TokenKind::Dot || tokens[dot_i - 2].kind == TokenKind::ColonColon ||
    (!tokens[dot_i - 1].newline_before && (tokens[dot_i - 2].kind == TokenKind::RParen || tokens[dot_i - 2].kind == TokenKind::RBracket || tokens[dot_i - 2].kind == TokenKind::RBrace))))
  let mut root_raw = ""
  if dot_i >= 5 && tokens[dot_i - 1].kind == TokenKind::RParen &&
  tokens[dot_i - 2].kind == TokenKind::IntLit && tokens[dot_i - 3].kind == TokenKind::Dot &&
  tokens[dot_i - 4].kind == TokenKind::Ident && tokens[dot_i - 5].kind == TokenKind::LParen &&
  !(dot_i >= 6 && !tokens[dot_i - 5].newline_before && (
    tokens[dot_i - 6].kind == TokenKind::Ident ||
    tokens[dot_i - 6].kind == TokenKind::UpperIdent ||
    tokens[dot_i - 6].kind == TokenKind::RParen ||
    tokens[dot_i - 6].kind == TokenKind::RBracket)) {
    root_raw = tokens[dot_i - 4].raw
  } else if dot_i >= 3 && tokens[dot_i - 1].kind == TokenKind::RBracket {
    let mut ob = dot_i - 2
    let mut d = 1
    while ob >= 0 && d > 0 {
      if tokens[ob].kind == TokenKind::RBracket { d = d + 1 }
      else if tokens[ob].kind == TokenKind::LBracket { d = d - 1 }
      if d == 0 { break }
      ob = ob - 1
    }
    if ob >= 1 && tokens[ob].kind == TokenKind::LBracket {
      root_raw = extract_dot_chain_root_ident(tokens, ob - 1)
    }
  } else {
    root_raw = extract_dot_chain_root_ident(tokens, dot_i - 1)
  }
  let mut root_is_known_immut = false
  if root_raw.length() > 0 {
    let eff = resolve_ident_in_scope(ctx, root_raw)
    match lookup_scope_var(ctx, eff) {
      Some(sv) => if sv.is_mut { return true } else { root_is_known_immut = true }
      None =>
      if eff != root_raw {
        match lookup_scope_var(ctx, root_raw) {
          Some(sv) => if sv.is_mut { return true } else { root_is_known_immut = true }
          None => ()
        }
      }
    }
  }
  if tokens[op_i].kind == TokenKind::Eq && is_simple_ident_recv && root_is_known_immut {
    return false
  }
  let rhs_end = find_expr_end(tokens, op_i + 1, end)
  let mut k = op_i + 1
  while k < rhs_end {
    // Skip closure literal bodies `fn(...) [-> T] { ... }` (not executed during RHS evaluation)
    if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "fn" &&
    k + 1 < rhs_end && tokens[k + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, k + 1)
      let mut lb = cp + 1
      while lb < rhs_end && tokens[lb].kind != TokenKind::LBrace {
        lb = lb + 1
      }
      if lb < rhs_end && tokens[lb].kind == TokenKind::LBrace {
        k = find_matching_delim(tokens, lb) + 1
        continue
      }
    }
    if tokens[k].kind == TokenKind::LBrace {
      return true
    }
    k = k + 1
  }
  false
}

///| Check if `{ val: expr }` is a Ref literal (defaults to `mbt_compat::ref_new`, overridable by `--recipes`).
///| NEVER misclassify `{ val: expr }` as `Ref` when expected type is a local struct with `val`
///| or when a local single-field `struct { val : ... }` exists and expected type is not `Ref[...]`.
fn try_lower_ref_literal(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> Option[String] {
  if ctx.symtab.local_types.contains("Ref") || ctx.active_generics.contains("Ref") {
    return None
  }
  let ref_ty = effective_ref_type(ctx.recipes)
  let ref_ctor = effective_ref_ctor(ctx.recipes)
  if close_b > open_b + 3 && tokens[open_b + 1].raw == "val" && tokens[open_b + 2].kind == TokenKind::Colon {
    let raw_exp = current_expected_type(ctx).trim()
    let exp_base = {
      let bi = raw_exp.index_of("[")
      if bi > 0 { raw_exp.slice(0, bi).trim() } else { raw_exp }
    }
    let is_ref_exp = exp_base == "Ref" || exp_base == "mbt_compat::Ref" || exp_base == ref_ty
    if !is_ref_exp {
      if exp_base.length() > 0 && ctx.struct_val_fields.contains(exp_base) {
        return None
      }
      for sname in ctx.struct_val_fields.keys() {
        match ctx.struct_field_renames.get(sname) {
          Some(rmap) =>
          if rmap.length() == 1 && rmap.contains("val") {
            return None
          }
          None => ()
        }
      }
    }
    // Ensure there are no other fields at depth 0
    let mut i = open_b + 3
    let mut depth = 0
    while i < close_b {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        // trailing comma ok if nothing after
        if i + 1 < close_b {
          return None
        }
      }
      i = i + 1
    }
    let val_expr = lower_expr_range(ctx, tokens, open_b + 3, close_b, file, false).trim()
    let clean_val = if val_expr.ends_with(",") { val_expr.slice(0, val_expr.length() - 1).trim() } else { val_expr }
    return Some(ref_ctor + "(" + clean_val + ")")
  }
  None
}

///| Check whether `( ... ) => ...` at `open_p` is an arrow function (not a match arm / constructor pattern).
fn is_arrow_fn_at(tokens : Array[Token], open_p : Int, end : Int) -> Int {
  // Constructor patterns like `Failure(msg) => ...` or `Some(v) => ...` are NEVER arrow functions (#12a P1-2)!
  if open_p > 0 && (tokens[open_p - 1].kind == TokenKind::UpperIdent || tokens[open_p - 1].kind == TokenKind::Ident) {
    return -1
  }
  let close_p = find_matching_delim(tokens, open_p)
  if close_p + 1 < end && tokens[close_p + 1].kind == TokenKind::FatArrow {
    // Verify params inside parens look like simple parameter bindings (not tuple patterns like `(None, None) =>`!)
    let mut i = open_p + 1
    let mut after_colon = false
    let mut depth = 0
    while i < close_p {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        after_colon = false
      } else if depth == 0 && k == TokenKind::Colon {
        after_colon = true
      } else if depth == 0 && !after_colon {
        if k != TokenKind::Ident && k != TokenKind::Underscore {
          return -1
        }
      } else if k != TokenKind::Ident && k != TokenKind::Underscore && k != TokenKind::Comma &&
      k != TokenKind::Colon && k != TokenKind::UpperIdent && k != TokenKind::LBracket &&
      k != TokenKind::RBracket && k != TokenKind::Question && k != TokenKind::Arrow &&
      k != TokenKind::ColonColon && k != TokenKind::PkgRef && k != TokenKind::Dot {
        return -1
      }
      i = i + 1
    }
    return close_p
  }
  -1
}

///| Find the end of a single expression (stopping at `,`, `;`, `)`, `}`, `]`, or newline statement boundary).
///| Preserves consecutive `#|` / `$|` multiline strings, `if ... else`, and newline-leading chained calls/operators.
fn find_expr_end(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut i = start
  let mut depth = 0
  while i < end {
    let k = tokens[i].kind
    if depth == 0 && i > start && tokens[i].newline_before {
      let pk = tokens[i - 1].kind
      let is_multiline_str_cont = (k == TokenKind::RawMultiline || k == TokenKind::InterpMultiline) &&
      (pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline)
      let is_else_cont = k == TokenKind::Keyword && tokens[i].raw == "else"
      let is_leading_cont = k == TokenKind::PipeGt || k == TokenKind::Dot || k == TokenKind::DotDot ||
      k == TokenKind::AmpAmp || k == TokenKind::PipePipe || k == TokenKind::Plus ||
      k == TokenKind::Star || k == TokenKind::Slash || k == TokenKind::Percent ||
      k == TokenKind::EqEq || k == TokenKind::BangEq || is_multiline_str_cont || is_else_cont
      let is_trailing_cont = pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
      pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::Eq ||
      pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::PipeGt ||
      pk == TokenKind::Colon || pk == TokenKind::Arrow || pk == TokenKind::FatArrow ||
      pk == TokenKind::Dot || pk == TokenKind::Comma ||
      (pk == TokenKind::Keyword && (tokens[i - 1].raw == "match" || tokens[i - 1].raw == "if"))
      if !is_leading_cont && !is_trailing_cont {
        return i
      }
    }
    if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
      depth = depth + 1
      i = i + 1
      continue
    }
    if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
      if depth == 0 {
        return i
      }
      depth = depth - 1
      i = i + 1
      continue
    }
    if depth == 0 && (k == TokenKind::Comma || k == TokenKind::Semi) {
      return i
    }
    i = i + 1
  }
  end
}

///| Find the end of a top-level `let` / `const` initializer expression using balanced token boundaries
///| (never truncating multi-line expressions, `#|`/`$|` blocks, chained calls, or `if`/`match` arms!).
fn find_top_level_let_expr_end(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut i = start
  let mut depth = 0
  while i < end {
    let k = tokens[i].kind
    if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
      depth = depth + 1
      i = i + 1
      continue
    }
    if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
      if depth == 0 {
        return i
      }
      depth = depth - 1
      i = i + 1
      continue
    }
    if depth == 0 && k == TokenKind::Semi {
      return i
    }
    if depth == 0 && i > start && tokens[i].newline_before {
      let pk = tokens[i - 1].kind
      let is_multiline_str_cont = (k == TokenKind::RawMultiline || k == TokenKind::InterpMultiline) &&
      (pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline)
      let is_else_cont = k == TokenKind::Keyword && tokens[i].raw == "else"
      let is_leading_cont = k == TokenKind::PipeGt || k == TokenKind::Dot || k == TokenKind::DotDot ||
      k == TokenKind::AmpAmp || k == TokenKind::PipePipe || k == TokenKind::Plus ||
      k == TokenKind::Minus || k == TokenKind::Star || k == TokenKind::Slash ||
      k == TokenKind::Percent || k == TokenKind::EqEq || k == TokenKind::BangEq ||
      k == TokenKind::Pipe || k == TokenKind::Amp || k == TokenKind::Caret ||
      k == TokenKind::Shl || k == TokenKind::Shr ||
      is_multiline_str_cont || is_else_cont
      let is_trailing_cont = pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
      pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::Eq ||
      pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::PipeGt ||
      pk == TokenKind::Pipe || pk == TokenKind::Amp || pk == TokenKind::Caret ||
      pk == TokenKind::Shl || pk == TokenKind::Shr ||
      pk == TokenKind::Colon || pk == TokenKind::Arrow || pk == TokenKind::FatArrow ||
      pk == TokenKind::Dot || pk == TokenKind::Comma
      if !is_leading_cont && !is_trailing_cont {
        // Stop on any new top-level declaration (except anonymous `fn(` closure)
        let is_anon_fn = k == TokenKind::Keyword && tokens[i].raw == "fn" &&
        i + 1 < end && tokens[i + 1].kind == TokenKind::LParen
        if is_top_level_decl_start(tokens, i) && !is_anon_fn {
          return i
        }
        return i
      }
    }
    i = i + 1
  }
  end
}

///| Look up the innermost lexical `ScopeVar` matching `name`.
fn lookup_scope_var(ctx : StageAContext, name : String) -> Option[ScopeVar] {
  let mut i = ctx.scope_vars.length() - 1
  while i >= 0 {
    if ctx.scope_vars[i].name == name {
      return Some(ctx.scope_vars[i])
    }
    i = i - 1
  }
  None
}

///| Truncate `ctx.scope_vars` back to `saved_len` on block exit.
fn restore_scope_vars(ctx : StageAContext, saved_len : Int) -> Unit {
  while ctx.scope_vars.length() > saved_len {
    let _ = ctx.scope_vars.pop()
  }
}

///| Extract depth-0 generic type parameter names from `[T, U : Bound, ...]`, skipping bounds after `:` / `::` / `+`.
fn collect_generic_param_names(tokens : Array[Token], open_br : Int, close_br : Int) -> Array[String] {
  let out : Array[String] = []
  let mut gi = open_br + 1
  let mut gd = 0
  while gi < close_br {
    let gk = tokens[gi].kind
    if gk == TokenKind::LBracket || gk == TokenKind::LParen {
      gd = gd + 1
    } else if gk == TokenKind::RBracket || gk == TokenKind::RParen {
      if gd > 0 { gd = gd - 1 }
    } else if gd == 0 && gk == TokenKind::UpperIdent {
      let prev_bound = gi > open_br + 1 &&
      (tokens[gi - 1].kind == TokenKind::Colon || tokens[gi - 1].kind == TokenKind::ColonColon || tokens[gi - 1].kind == TokenKind::Plus)
      if !prev_bound {
        out.push(tokens[gi].raw)
      }
    }
    gi = gi + 1
  }
  out
}

///| Push generic parameter names onto `ctx.active_generics` and `ctx.symtab.active_generics`,
///| returning ONLY newly added names so `pop_active_generics` never removes an outer same-named generic.
fn push_active_generics(ctx : StageAContext, names : Array[String]) -> Array[String] {
  let added : Array[String] = []
  for gn in names {
    if !ctx.symtab.active_generics.contains(gn) {
      ctx.active_generics[gn] = true
      ctx.symtab.active_generics[gn] = true
      added.push(gn)
    }
  }
  added
}

///| Remove previously added generic parameter names on declaration exit.
fn pop_active_generics(ctx : StageAContext, added : Array[String]) -> Unit {
  for gn in added {
    ctx.active_generics.remove(gn)
    ctx.symtab.active_generics.remove(gn)
  }
}

///| Recursively collect all lowercase pattern-bound identifiers in `[s, e)` (normalized via `rename_keyword_ident`).
fn collect_pat_binders_rec(tokens : Array[Token], s : Int, e : Int, out : Array[String]) -> Unit {
  let mut i = s
  while i < e {
    let t = tokens[i]
    if t.kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i)
      let mut fi = i + 1
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
          fi = fi + 1
          continue
        }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        if fi + 1 < fe && (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
        tokens[fi + 1].kind == TokenKind::Colon {
          collect_pat_binders_rec(tokens, fi + 2, fe, out)
        } else if fi < fe && tokens[fi].kind == TokenKind::Ident {
          if tokens[fi].raw != "_" {
            out.push(rename_keyword_ident(tokens[fi].raw))
          }
          if fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Keyword && tokens[fi + 1].raw == "as" &&
          tokens[fi + 2].kind == TokenKind::Ident && tokens[fi + 2].raw != "_" {
            out.push(rename_keyword_ident(tokens[fi + 2].raw))
          }
        }
        fi = fe + 1
      }
      i = cb + 1
      continue
    }
    if t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      let mut ai = i + 1
      while ai < cp {
        if tokens[ai].kind == TokenKind::Comma || tokens[ai].kind == TokenKind::DotDot {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < cp {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ai + 1 < ae && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          collect_pat_binders_rec(tokens, ai + 2, ae, out)
        } else if ai + 1 < ae && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          if tokens[ai].raw != "_" {
            out.push(rename_keyword_ident(tokens[ai].raw))
          }
        } else {
          collect_pat_binders_rec(tokens, ai, ae, out)
        }
        ai = ae + 1
      }
      i = cp + 1
      continue
    }
    if t.kind == TokenKind::LBracket {
      let cbr = find_matching_delim(tokens, i)
      collect_pat_binders_rec(tokens, i + 1, cbr, out)
      i = cbr + 1
      continue
    }
    if t.kind == TokenKind::Ident && t.raw != "_" {
      let prev_qual = i > s && (tokens[i - 1].kind == TokenKind::ColonColon || tokens[i - 1].kind == TokenKind::Dot)
      if !prev_qual {
        out.push(rename_keyword_ident(t.raw))
      }
    }
    i = i + 1
  }
}

///| Collect all pattern-bound lowercase variable names in `[start, end)`.
fn collect_pattern_binders(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let out : Array[String] = []
  collect_pat_binders_rec(tokens, start, end, out)
  out
}

///| Push a list of lexical binder names onto `ctx.scope_vars`.
fn push_scope_binders(ctx : StageAContext, names : Array[String]) -> Unit {
  for nm in names {
    if nm.length() > 0 && nm != "_" {
      ctx.scope_vars.push(ScopeVar::{ name: nm, ty: "", is_mut: false, is_boxed: false })
    }
  }
}

///| Lower a boolean condition `[start, end)` segment-by-segment across depth-0 `&&`,
///| pushing any `is <Pat>` binders onto `ctx.scope_vars` so subsequent `&&` segments
///| and the guarded body observe lexical shadowing.
fn lower_cond_with_is_binders(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut seg_s = start
  while seg_s < end {
    let mut seg_e = seg_s
    let mut d = 0
    while seg_e < end {
      let k = tokens[seg_e].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && k == TokenKind::AmpAmp { break }
      seg_e = seg_e + 1
    }
    sb.write_string(lower_expr_range(ctx, tokens, seg_s, seg_e, file, false))
    // Scan this segment for depth-0 `is <Pat>` and push its binders for subsequent `&&` and body
    let mut k = seg_s
    let mut kd = 0
    while k < seg_e {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { kd = kd + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if kd > 0 { kd = kd - 1 } }
      else if kd == 0 && kk == TokenKind::Keyword && tokens[k].raw == "is" && k + 1 < seg_e {
        let mut pe = k + 1
        let mut pd = 0
        while pe < seg_e {
          let pk = tokens[pe].kind
          if pd == 0 && pe > k + 1 && tokens[pe].newline_before { break }
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
            if pd == 0 { break }
            pd = pd - 1
          } else if pd == 0 && (pk == TokenKind::PipePipe || pk == TokenKind::EqEq || pk == TokenKind::BangEq) {
            break
          }
          pe = pe + 1
        }
        let lhs_ty = infer_simple_expr_type(ctx, tokens, seg_s, k).trim()
        if lhs_ty.starts_with("Option[") && lhs_ty.ends_with("]") &&
        k + 4 < pe && tokens[k + 1].kind == TokenKind::UpperIdent && tokens[k + 1].raw == "Some" &&
        tokens[k + 2].kind == TokenKind::LParen && find_matching_delim(tokens, k + 2) == pe - 1 &&
        k + 4 == pe - 1 && tokens[k + 3].kind == TokenKind::Ident && tokens[k + 3].raw != "_" {
          let inner_t = lhs_ty.slice(7, lhs_ty.length() - 1).trim()
          ctx.scope_vars.push(ScopeVar::{
            name: resolve_ident_in_scope(ctx, tokens[k + 3].raw),
            ty: inner_t,
            is_mut: false,
            is_boxed: false,
          })
        } else {
          push_scope_binders(ctx, collect_pattern_binders(tokens, k + 1, pe))
        }
        k = pe
        continue
      }
      k = k + 1
    }
    if seg_e < end && tokens[seg_e].kind == TokenKind::AmpAmp {
      sb.write_string(tokens[seg_e].leading_trivia + "&&")
      seg_s = seg_e + 1
    } else {
      break
    }
  }
  sb.to_string()
}

///| Best-effort static type inference for an unannotated `let [mut] x = <rhs>` initializer
///| (literals, bools, struct literals, and outer scope variables). Returns `""` if unknown.
fn infer_simple_expr_type(ctx : StageAContext, tokens : Array[Token], start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let t = tokens[start]
  if start + 1 == end {
    if t.kind == TokenKind::IntLit {
      let r = t.raw
      if r.ends_with("UL") || r.ends_with("ul") { return "UInt64" }
      if r.ends_with("L") || r.ends_with("l") { return "Int64" }
      if r.ends_with("U") || r.ends_with("u") { return "UInt" }
      return "Int"
    }
    if t.kind == TokenKind::FloatLit {
      if t.raw.ends_with("F") { return "Float" }
      return "Double"
    }
    if t.kind == TokenKind::StringLit || t.kind == TokenKind::InterpString || t.kind == TokenKind::RawMultiline || t.kind == TokenKind::InterpMultiline {
      return "String"
    }
    if t.kind == TokenKind::CharLit { return "Char" }
    if t.kind == TokenKind::ByteCharLit { return "Byte" }
    if t.kind == TokenKind::ByteStringLit { return "Bytes" }
    if t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false") { return "Bool" }
    if t.kind == TokenKind::Ident {
      let nm = resolve_ident_in_scope(ctx, t.raw)
      match lookup_scope_var(ctx, nm) {
        Some(sv) => return sv.ty
        None => ()
      }
      match ctx.symtab.val_types.get(t.raw) {
        Some(vt) => return vt
        None => ()
      }
    }
    if t.kind == TokenKind::UpperIdent {
      match ctx.symtab.ctors.get(t.raw) {
        Some(targets) => {
          let mut local_cnt = 0
          let mut local_enum = ""
          for ct in targets {
            if ct.is_local {
              local_cnt = local_cnt + 1
              local_enum = ct.enum_name
            }
          }
          if local_cnt == 1 && local_enum.length() > 0 {
            return local_enum
          }
        }
        None => ()
      }
      match ctx.symtab.enum_schemas_by_ctor.get(t.raw) {
        Some(cands) =>
        if cands.length() == 1 {
          let es = cands[0].0
          return if es.pkg.length() > 0 { es.pkg + "::" + es.name } else { es.name }
        }
        None => ()
      }
    }
  }
  // Cross-package value/constant reference `@pkg.val` -> look up `symtab.val_types`
  if t.kind == TokenKind::PkgRef && start + 3 == end &&
  tokens[start + 1].kind == TokenKind::Dot && tokens[start + 2].kind == TokenKind::Ident {
    let raw_pkg = t.raw.slice(1, t.raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None => raw_pkg
    }
    let vname = tokens[start + 2].raw
    match ctx.symtab.val_types.get(mapped_pkg + "::" + vname) {
      Some(vt) => if vt.length() > 0 { return vt }
      None => ()
    }
    match ctx.symtab.val_types.get(raw_pkg + "::" + vname) {
      Some(vt) => if vt.length() > 0 { return vt }
      None => ()
    }
  }
  // Sound Ref literal `{ val: expr }` or `Ref::new(expr)` -> `mbt_compat::Ref` (when unshadowed)
  if !ctx.symtab.local_types.contains("Ref") && !ctx.active_generics.contains("Ref") {
    if t.kind == TokenKind::LBrace && find_matching_delim(tokens, start) == end - 1 {
      let cb = end - 1
      if cb > start + 3 && tokens[start + 1].raw == "val" && tokens[start + 2].kind == TokenKind::Colon {
        let mut has_single_val_struct = false
        for sname in ctx.struct_val_fields.keys() {
          match ctx.struct_field_renames.get(sname) {
            Some(rmap) => if rmap.length() == 1 && rmap.contains("val") { has_single_val_struct = true; break }
            None => ()
          }
        }
        if !has_single_val_struct {
          let mut single = true
          let mut k = start + 3
          let mut d = 0
          while k < cb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
            else if d == 0 && kk == TokenKind::Comma && k + 1 < cb { single = false; break }
            k = k + 1
          }
          if single {
            return infer_ref_with_inner_type(ctx, tokens, start + 3, cb)
          }
        }
      }
    }
    if t.kind == TokenKind::UpperIdent && t.raw == "Ref" {
      if start + 3 < end && tokens[start + 1].kind == TokenKind::ColonColon && tokens[start + 2].raw == "new" &&
      tokens[start + 3].kind == TokenKind::LParen && find_matching_delim(tokens, start + 3) == end - 1 {
        return infer_ref_with_inner_type(ctx, tokens, start + 4, end - 1)
      }
      if start + 1 < end && tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1 {
        return infer_ref_with_inner_type(ctx, tokens, start + 2, end - 1)
      }
    }
  }
  if t.kind == TokenKind::LBrace && find_matching_delim(tokens, start) == end - 1 {
    match resolve_anon_struct_literal_name(ctx, tokens, start, end - 1) {
      Some(sname) => return sname
      None => ()
    }
  }
  if t.kind == TokenKind::LParen && find_matching_delim(tokens, start) == end - 1 {
    let cp = end - 1
    let tup_tys : Array[String] = []
    let mut ti = start + 1
    let mut has_comma = false
    while ti < cp {
      if tokens[ti].kind == TokenKind::Comma { has_comma = true; ti = ti + 1; continue }
      let mut te = ti
      let mut td = 0
      while te < cp {
        let tk = tokens[te].kind
        if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
        else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
        else if td == 0 && tk == TokenKind::Comma { has_comma = true; break }
        te = te + 1
      }
      if te > ti {
        tup_tys.push(infer_simple_expr_type(ctx, tokens, ti, te))
      }
      ti = te + 1
    }
    if has_comma && tup_tys.length() >= 2 {
      return "(" + join_comma(tup_tys) + ")"
    }
  }
  // `match recv.field.get(...) { Some(h) => h, ... }` -> infer from arms first; only fall back to
  // container value type of `recv.field` if arm inference cannot determine the result type.
  if t.kind == TokenKind::Keyword && t.raw == "match" && start + 5 < end &&
  tokens[start + 1].kind == TokenKind::Ident && tokens[start + 2].kind == TokenKind::Dot &&
  tokens[start + 3].kind == TokenKind::Ident && tokens[start + 4].kind == TokenKind::Dot &&
  tokens[start + 5].raw == "get" {
    let mt = infer_match_expr_type_f3d2(ctx, tokens, start, end)
    if mt.length() > 0 {
      return mt
    }
    let base_ty = lookup_ident_static_type(ctx, tokens[start + 1].raw)
    if base_ty.length() > 0 {
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
        Some(fm) =>
        match fm.get(tokens[start + 3].raw) {
          Some(ft) => {
            let vty = extract_container_value_type(ft)
            if vty.length() > 0 {
              return vty
            }
          }
          None => ()
        }
        None => ()
      }
    }
  }
  // Indexing `arr[idx]` -> container element type `T` (e.g. `let pool = pools[d]` -> `Pool`)
  if t.kind == TokenKind::Ident && start + 2 < end && tokens[start + 1].kind == TokenKind::LBracket &&
  find_matching_delim(tokens, start + 1) == end - 1 {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      let ety = extract_container_value_type(base_ty)
      if ety.length() > 0 {
        return ety
      }
    }
  }
  // Container `.get(k)` -> `Option[V]` (e.g. `items.get(prev)` -> `Option[flex::FlipItem]`)
  if t.kind == TokenKind::Ident && start + 4 < end && tokens[start + 1].kind == TokenKind::Dot &&
  tokens[start + 2].raw == "get" && tokens[start + 3].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 3) == end - 1 {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      let vty = extract_container_value_type(base_ty)
      if vty.length() > 0 {
        return "Option[" + vty + "]"
      }
    }
  }
  // Field signal/cell `.get()` / `.untracked()` -> inner type `T` (e.g. `self.notch.get()` -> `Option[Notch]`)
  if t.kind == TokenKind::Ident && start + 7 == end &&
  tokens[start + 1].kind == TokenKind::Dot && tokens[start + 2].kind == TokenKind::Ident &&
  tokens[start + 3].kind == TokenKind::Dot &&
  (tokens[start + 4].raw == "get" || tokens[start + 4].raw == "untracked") &&
  tokens[start + 5].kind == TokenKind::LParen && tokens[start + 6].kind == TokenKind::RParen {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
        Some(fm) =>
        match fm.get(tokens[start + 2].raw) {
          Some(ft) => {
            let lb = ft.index_of("[")
            if lb > 0 && ft.ends_with("]") {
              let inner = ft.slice(lb + 1, ft.length() - 1).trim()
              if inner.length() > 0 {
                return inner
              }
            }
          }
          None => ()
        }
        None => ()
      }
    }
  }
  // Method `.last()` / `.get(...)` on local container -> `Option[T]`
  if t.kind == TokenKind::Ident && start + 3 < end && tokens[start + 1].kind == TokenKind::Dot &&
  (tokens[start + 2].raw == "last" || tokens[start + 2].raw == "get") &&
  tokens[start + 3].kind == TokenKind::LParen && find_matching_delim(tokens, start + 3) == end - 1 {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      let ety = extract_container_value_type(base_ty)
      if ety.length() > 0 {
        return "Option[" + ety + "]"
      }
    }
  }
  // Field access `a.b`, `a.b[idx]`, `a.b.last()`, `a.b.get(...)`, and `.values().collect()` -> `Array[V]`
  if t.kind == TokenKind::Ident && start + 2 < end && tokens[start + 1].kind == TokenKind::Dot && tokens[start + 2].kind == TokenKind::Ident {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      let mut cur_ty = ""
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
        Some(fm) => match fm.get(tokens[start + 2].raw) { Some(ft) => cur_ty = ft, None => () }
        None => ()
      }
      if cur_ty.length() > 0 {
        if start + 3 == end {
          return cur_ty
        }
        if start + 4 < end && tokens[start + 3].kind == TokenKind::LBracket &&
        find_matching_delim(tokens, start + 3) == end - 1 {
          let ety = extract_container_value_type(cur_ty)
          if ety.length() > 0 {
            return ety
          }
        }
        if start + 5 < end && tokens[start + 3].kind == TokenKind::Dot &&
        (tokens[start + 4].raw == "last" || tokens[start + 4].raw == "get") &&
        tokens[start + 5].kind == TokenKind::LParen && find_matching_delim(tokens, start + 5) == end - 1 {
          let ety = extract_container_value_type(cur_ty)
          if ety.length() > 0 {
            return "Option[" + ety + "]"
          }
        }
        if start + 5 < end && tokens[start + 3].kind == TokenKind::Dot && tokens[start + 4].raw == "values" {
          let vty = extract_container_value_type(cur_ty)
          if vty.length() > 0 {
            return "Array[" + vty + "]"
          }
        }
      }
    }
  }
  if start + 2 == end && t.kind == TokenKind::Minus && tokens[start + 1].kind == TokenKind::IntLit {
    let r = tokens[start + 1].raw
    if r.ends_with("L") || r.ends_with("l") { return "Int64" }
    return "Int"
  }
  if start + 2 == end && t.kind == TokenKind::Minus && tokens[start + 1].kind == TokenKind::FloatLit {
    let r = tokens[start + 1].raw
    if r.ends_with("F") { return "Float" }
    return "Double"
  }
  if t.kind == TokenKind::UpperIdent && start + 2 < end && tokens[start + 1].kind == TokenKind::ColonColon && tokens[start + 2].kind == TokenKind::LBrace &&
  find_matching_delim(tokens, start + 2) == end - 1 {
    return t.raw
  }
  if t.kind == TokenKind::UpperIdent && ctx.symtab.tuple_structs.contains(t.raw) && start + 1 < end && tokens[start + 1].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 1) == end - 1 {
    return t.raw
  }
  if t.kind == TokenKind::LBracket {
    let cb = find_matching_delim(tokens, start)
    if cb == end - 1 && cb > start + 1 {
      let mut first_end = start + 1
      let mut d = 0
      while first_end < cb {
        let k = tokens[first_end].kind
        if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
        else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && k == TokenKind::Comma { break }
        first_end = first_end + 1
      }
      let ety = infer_simple_expr_type(ctx, tokens, start + 1, first_end)
      if ety.length() > 0 {
        return "Array[" + ety + "]"
      }
    }
  }
  // Bare local function call `foo(...)` -> look up `symtab.fn_ret_types` (for Option/Array/Tuple/Struct returns)
  if t.kind == TokenKind::Ident && start + 1 < end &&
  tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1 {
    match ctx.symtab.fn_ret_types.get(t.raw) {
      Some(rty) =>
      if rty.length() > 0 && (rty.starts_with("Option[") || rty.starts_with("Array[") || rty.starts_with("(") || ctx.struct_field_renames.contains(strip_type_args_sym(rty))) {
        return rty
      }
      None => ()
    }
  }
  // Local static method call `Type::method(...)` -> look up `symtab.fn_ret_types`
  if t.kind == TokenKind::UpperIdent && start + 3 < end &&
  tokens[start + 1].kind == TokenKind::ColonColon && tokens[start + 2].kind == TokenKind::Ident &&
  tokens[start + 3].kind == TokenKind::LParen && find_matching_delim(tokens, start + 3) == end - 1 {
    match ctx.symtab.fn_ret_types.get(t.raw + "::" + tokens[start + 2].raw) {
      Some(rty) => if rty.length() > 0 { return rty }
      None => ()
    }
  }
  // Local method call `recv.method(...)` -> look up `Type::method` in `symtab.fn_ret_types`,
  // and `arr.map(fn(x) { { ..x, ... } })` preserves `Array[T]`!
  if t.kind == TokenKind::Ident && start + 3 < end &&
  tokens[start + 1].kind == TokenKind::Dot && tokens[start + 2].kind == TokenKind::Ident &&
  tokens[start + 3].kind == TokenKind::LParen && find_matching_delim(tokens, start + 3) == end - 1 {
    let rbase = lookup_ident_static_type(ctx, t.raw)
    if rbase.length() > 0 {
      if tokens[start + 2].raw == "map" && rbase.starts_with("Array[") && rbase.ends_with("]") &&
      start + 11 < end && tokens[start + 4].kind == TokenKind::Keyword && tokens[start + 4].raw == "fn" &&
      tokens[start + 5].kind == TokenKind::LParen && tokens[start + 6].kind == TokenKind::Ident &&
      tokens[start + 7].kind == TokenKind::RParen && tokens[start + 8].kind == TokenKind::LBrace &&
      tokens[start + 9].kind == TokenKind::LBrace && tokens[start + 10].kind == TokenKind::DotDot &&
      tokens[start + 11].kind == TokenKind::Ident && tokens[start + 11].raw == tokens[start + 6].raw &&
      find_matching_delim(tokens, start + 9) + 1 == find_matching_delim(tokens, start + 8) {
        return rbase
      }
      match ctx.symtab.fn_ret_types.get(strip_type_args_sym(rbase) + "::" + tokens[start + 2].raw) {
        Some(rty) =>
        if rty.length() > 0 && (rty.starts_with("(") || rty.starts_with("Array[") || ctx.struct_field_renames.contains(strip_type_args_sym(rty))) {
          return rty
        }
        None => ()
      }
    }
  }
  // Package-qualified call `@pkg.fn(...)` -> look up `symtab.fn_ret_types` (ONLY when no trailing `.method(...)` chain!)
  if t.kind == TokenKind::PkgRef && start + 3 < end &&
  tokens[start + 1].kind == TokenKind::Dot && tokens[start + 3].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 3) == end - 1 {
    let raw_pkg = t.raw.slice(1, t.raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None => raw_pkg
    }
    let fname = tokens[start + 2].raw
    let rty = match ctx.symtab.fn_ret_types.get(raw_pkg + "::" + fname) {
      Some(r) => r
      None => match ctx.symtab.fn_ret_types.get(mapped_pkg + "::" + fname) {
        Some(r) => r
        None => ""
      }
    }
    if rty.length() > 0 {
      // Substitute single type param `[T]` from first argument when possible (e.g. `Signal[T]` -> `Signal[Double]`)
      if str_has(rty, "[T]") {
        let cp = find_matching_delim(tokens, start + 3)
        if cp > start + 4 {
          let arg_ty = infer_simple_expr_type(ctx, tokens, start + 4, cp)
          if arg_ty.length() > 0 {
            return str_replace_all(rty, "[T]", "[" + arg_ty + "]")
          }
        }
      }
      return rty
    }
  }
  // Local function call `f(...)` -> look up `symtab.fn_ret_types` (ONLY when no trailing `.method(...)` chain!)
  if t.kind == TokenKind::Ident && start + 1 < end && tokens[start + 1].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 1) == end - 1 {
    let fname = rename_keyword_ident(t.raw)
    if ctx.cur_is_blackbox {
      match ctx.symtab.blackbox_fn_ret_types.get(fname) {
        Some(r) => if r.length() > 0 { return r }
        None => ()
      }
      if !ctx.symtab.blackbox_decls.contains(t.raw) {
        match ctx.symtab.fn_ret_types.get(fname) {
          Some(r) => if r.length() > 0 { return r }
          None => ()
        }
      }
    } else {
      match ctx.symtab.fn_ret_types.get(fname) {
        Some(r) => if r.length() > 0 { return r }
        None => ()
      }
    }
    match lookup_scope_var(ctx, fname) {
      Some(sv) => {
        let arrow_i = sv.ty.index_of("->")
        if arrow_i >= 0 {
          return sv.ty.slice(arrow_i + 2, sv.ty.length()).trim()
        }
      }
      None => ()
    }
  }
  // `recv.m(...).unwrap_or(...)` where `Type::m` of the statically typed receiver returns `Option[T]` -> `T`
  if t.kind == TokenKind::Ident && start + 3 < end && tokens[start + 1].kind == TokenKind::Dot &&
  tokens[start + 2].kind == TokenKind::Ident && tokens[start + 3].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, start + 3)
    if cp + 3 < end && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].raw == "unwrap_or" &&
    tokens[cp + 3].kind == TokenKind::LParen && find_matching_delim(tokens, cp + 3) == end - 1 {
      let base = strip_type_args_sym(lookup_ident_static_type(ctx, t.raw))
      if base.length() > 0 && !ctx.active_generics.contains(base) {
        match ctx.symtab.fn_ret_types.get(base + "::" + tokens[start + 2].raw) {
          Some(rty) =>
          if rty.starts_with("Option[") && rty.ends_with("]") {
            let inner = rty.slice(7, rty.length() - 1).trim()
            if inner.length() > 0 && !ctx.active_generics.contains(inner) {
              return inner
            }
          }
          None => ()
        }
      }
    }
  }
  // Trailing Option-returning stdlib method calls `.get(...)`, `.rev_find(...)`, `.search(...)`, `.pop()`
  if end >= start + 4 && tokens[end - 1].kind == TokenKind::RParen {
    // Walk back to matching LParen
    let mut d = 1
    let mut lp = end - 2
    while lp > start && d > 0 {
      let lk = tokens[lp].kind
      if lk == TokenKind::RParen { d = d + 1 }
      else if lk == TokenKind::LParen { d = d - 1; if d == 0 { break } }
      lp = lp - 1
    }
    if d == 0 && lp >= start + 2 && tokens[lp - 2].kind == TokenKind::Dot && tokens[lp - 1].kind == TokenKind::Ident {
      let mn = tokens[lp - 1].raw
      if mn == "get" || mn == "rev_find" || mn == "search" || mn == "pop" || mn == "last" {
        return "Option"
      }
    }
  }
  // Parenthesized field call `(obj.field)()` -> look up `struct_field_types` closure return type
  if t.kind == TokenKind::LParen && start + 4 < end &&
  tokens[start + 1].kind == TokenKind::Ident && tokens[start + 2].kind == TokenKind::Dot &&
  tokens[start + 3].kind == TokenKind::Ident && tokens[start + 4].kind == TokenKind::RParen &&
  start + 5 < end && tokens[start + 5].kind == TokenKind::LParen {
    match lookup_scope_var(ctx, rename_keyword_ident(tokens[start + 1].raw)) {
      Some(sv) =>
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(sv.ty)) {
        Some(fmap) =>
        match fmap.get(tokens[start + 3].raw) {
          Some(fty) => {
            let arrow_i = fty.index_of("->")
            if arrow_i >= 0 {
              return fty.slice(arrow_i + 2, fty.length()).trim()
            }
          }
          None => ()
        }
        None => ()
      }
      None => ()
    }
  }
  // Zero-arg anonymous closure `fn() { ... }` -> infer `() -> <ret>` from explicit ret or last expr
  if t.kind == TokenKind::Keyword && t.raw == "fn" && start + 2 < end &&
  tokens[start + 1].kind == TokenKind::LParen && tokens[start + 2].kind == TokenKind::RParen {
    if start + 3 < end && tokens[start + 3].kind == TokenKind::Arrow {
      let mut lb = start + 4
      while lb < end && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
      let rty = lower_type_tokens(tokens, start + 4, lb, ctx.symtab, ctx.recipes).trim()
      if rty.length() > 0 { return "() -> " + rty }
    } else if start + 3 < end && tokens[start + 3].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, start + 3)
      // Scan for `None => <lit>` or tail literal inside body
      let mut k = cb - 1
      while k > start + 3 {
        if tokens[k].kind == TokenKind::FloatLit {
          if tokens[k].raw.ends_with("F") { return "() -> Float" }
          return "() -> Double"
        }
        if tokens[k].kind == TokenKind::IntLit { return "() -> Int" }
        if tokens[k].kind == TokenKind::StringLit { return "() -> String" }
        if tokens[k].kind == TokenKind::Keyword && (tokens[k].raw == "true" || tokens[k].raw == "false") { return "() -> Bool" }
        k = k - 1
      }
    }
  }
  infer_expr_type_f3d2(ctx, tokens, start, end)
}

///| Parsed local `fn` header inside a block.
struct LocalFnDecl {
  start_tok : Int
  end_tok : Int
  name : String
  open_p : Int
  close_p : Int
  ret_start : Int
  ret_end : Int
  lb : Int
  rb : Int
  line : Int
  col : Int
}

///| Try to parse a local `fn name(params) [-> Ret] { body }` starting at `i` within `[i, end)`.
fn try_parse_local_fn_decl(tokens : Array[Token], i : Int, end : Int) -> Option[LocalFnDecl] {
  if i + 2 >= end {
    return None
  }
  if !(tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "fn" &&
    tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LParen) {
    return None
  }
  let fn_name = rename_keyword_ident(tokens[i + 1].raw)
  let open_p = i + 2
  let close_p = find_matching_delim(tokens, open_p)
  let mut cur = close_p + 1
  let mut ret_start = -1
  let mut ret_end = -1
  if cur < end && tokens[cur].kind == TokenKind::Arrow {
    ret_start = cur + 1
    let mut r_end = cur + 1
    let mut rd = 0
    while r_end < end {
      let rk = tokens[r_end].kind
      if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
        break
      }
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
        rd = rd + 1
      } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
        if rd > 0 { rd = rd - 1 }
      }
      r_end = r_end + 1
    }
    ret_end = r_end
    cur = r_end
  } else {
    let mut rd = 0
    while cur < end {
      let rk = tokens[cur].kind
      if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
        break
      }
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
        rd = rd + 1
      } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
        if rd > 0 { rd = rd - 1 }
      }
      cur = cur + 1
    }
  }
  if cur >= end || tokens[cur].kind != TokenKind::LBrace {
    return None
  }
  let rb = find_matching_delim(tokens, cur)
  Some(LocalFnDecl::{
    start_tok: i,
    end_tok: rb + 1,
    name: fn_name,
    open_p: open_p,
    close_p: close_p,
    ret_start: ret_start,
    ret_end: ret_end,
    lb: cur,
    rb: rb,
    line: tokens[i].line,
    col: tokens[i].col,
  })
}

///| Collect all identifier names referenced (not after `.` or `::`) inside `[start, end)`,
///| including identifiers inside `\{...}` string interpolation holes.
fn collect_body_ident_set(tokens : Array[Token], start : Int, end : Int) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  let empty_bound : Map[String, Bool] = Map()
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline || t.kind == TokenKind::StringLit {
      if str_has(t.raw, "\\{") {
        collect_free_interp_holes_f3d2(t.raw, empty_bound, out)
      }
      i = i + 1
      continue
    }
    if t.kind == TokenKind::Ident {
      let prev_dot_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      let next_colon = i + 1 < end && tokens[i + 1].kind == TokenKind::Colon
      if !prev_dot_cc && !next_colon {
        out[rename_keyword_ident(t.raw)] = true
      }
    }
    i = i + 1
  }
  out
}

///| Check whether a local `fn` group is recursive (any member directly or mutually references a member).
fn local_fn_group_is_recursive(tokens : Array[Token], group : Array[LocalFnDecl]) -> Bool {
  let gnames : Map[String, Bool] = Map()
  for g in group {
    gnames[g.name] = true
  }
  for g in group {
    let refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
    for gn in gnames.keys() {
      if refs.contains(gn) {
        return true
      }
    }
  }
  false
}

///| Check whether `fn_name` is used as a first-class escaping value (i.e. NOT immediately followed by `(`)
///| anywhere in `[start, end)`.
fn is_local_fn_used_as_value(tokens : Array[Token], start : Int, end : Int, fn_name : String) -> Bool {
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    if t.kind == TokenKind::Ident && rename_keyword_ident(t.raw) == fn_name {
      let prev_dot_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      if !prev_dot_cc {
        let next_is_call = i + 1 < end && tokens[i + 1].kind == TokenKind::LParen
        if !next_is_call {
          return true
        }
      }
    }
    i = i + 1
  }
  false
}

///| Pre-scan a top-level `fn` body for `let mut` variables referenced inside any recursive local `fn`.
fn prescan_boxed_mut_vars(tokens : Array[Token], start : Int, end : Int, boxed : Map[String, Bool]) -> Unit {
  let mut_vars : Map[String, Bool] = Map()
  let mut i = start
  while i < end {
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" &&
    i + 2 < end && tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut" &&
    tokens[i + 2].kind == TokenKind::Ident {
      mut_vars[rename_keyword_ident(tokens[i + 2].raw)] = true
    }
    i = i + 1
  }
  if mut_vars.length() == 0 {
    return
  }
  i = start
  while i < end {
    match try_parse_local_fn_decl(tokens, i, end) {
      Some(first_decl) => {
        let group : Array[LocalFnDecl] = [first_decl]
        let mut scan = first_decl.end_tok
        while scan < end {
          if tokens[scan].kind == TokenKind::Semi {
            scan = scan + 1
            continue
          }
          match try_parse_local_fn_decl(tokens, scan, end) {
            Some(nxt) => {
              group.push(nxt)
              scan = nxt.end_tok
            }
            None => break
          }
        }
        if local_fn_group_is_recursive(tokens, group) {
          for g in group {
            let refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
            for mv in mut_vars.keys() {
              if refs.contains(mv) {
                boxed[mv] = true
              }
            }
          }
        }
        i = scan
        continue
      }
      None => ()
    }
    i = i + 1
  }
}

///| Extract raw (unrenamed) parameter names from `[open_p, close_p]` for collision-free keyword param renaming.
fn extract_raw_param_names(tokens : Array[Token], open_p : Int, close_p : Int) -> Array[String] {
  let out : Array[String] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    let mut p_end = i
    let mut d = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Comma { break }
      p_end = p_end + 1
    }
    if p_end > i {
      out.push(tokens[i].raw)
    }
    i = p_end + 1
  }
  out
}

///| Pion parses `.Ctor` followed by `(` as a constructor call even across a newline, so a match arm whose body is a
///| bare `.Ctor` would swallow the next arm's tuple pattern `(a, b) => ...` as arguments (MoonBit never continues
///| a call across a newline). When the next arm (at `next_i`, no `,` in between) starts with `(`, parenthesize it.
fn guard_dot_variant_arm_tail(body : String, tokens : Array[Token], next_i : Int, end : Int) -> String {
  if next_i >= end || tokens[next_i].kind != TokenKind::LParen {
    return body
  }
  let t = body.trim()
  if t.length() < 2 || t.code_unit_at(0) != 46 || !is_upper(t.code_unit_at(1)) {
    return body
  }
  let mut k = 2
  while k < t.length() {
    if !is_alnum(t.code_unit_at(k)) {
      return body
    }
    k = k + 1
  }
  let lead = body.slice(0, body.index_of(t))
  lead + "(" + t + ")"
}

///| True iff `tokens[s..e)` is a plain `ident(.field)*` path (no calls, indexing or operators).
fn is_plain_field_path(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e || tokens[s].kind != TokenKind::Ident {
    return false
  }
  let mut k = s + 1
  while k < e {
    if k + 1 >= e || tokens[k].kind != TokenKind::Dot || tokens[k + 1].kind != TokenKind::Ident {
      return false
    }
    k = k + 2
  }
  true
}

///| True iff the parenthesized list `tokens[open_p..=close_p]` has a depth-0 comma (more than one argument).
fn paren_has_top_level_comma(tokens : Array[Token], open_p : Int, close_p : Int) -> Bool {
  let mut k = open_p + 1
  let mut d = 0
  while k < close_p {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
    else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
    else if d == 0 && kk == TokenKind::Comma { return true }
    k = k + 1
  }
  false
}

///| Simple Pion types an inferred closure parameter may be annotated with: built-in scalars, `String`, or a
///| bare non-generic local type name. Anything else (generics, `Option[...]`, tuples, closures) is never guessed.
fn is_simple_closure_param_type(ctx : StageAContext, ty : String) -> Bool {
  if ty == "String" || ty == "Int" || ty == "Int64" || ty == "UInt" || ty == "UInt64" || ty == "Double" ||
  ty == "Float" || ty == "Bool" || ty == "Byte" || ty == "Char" {
    return true
  }
  ctx.symtab.local_types.contains(ty) && !ctx.active_generics.contains(ty)
}

fn is_open_delim(k : TokenKind) -> Bool {
  k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace
}

fn is_close_delim(k : TokenKind) -> Bool {
  k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace
}

fn is_name_tok(t : Token, name : String) -> Bool {
  t.kind == TokenKind::Ident && t.raw == name
}

fn is_stmt_keyword(t : Token) -> Bool {
  t.kind == TokenKind::Keyword &&
  (t.raw == "else" || t.raw == "then" || t.raw == "let" || t.raw == "return" || t.raw == "for" || t.raw == "while" ||
    t.raw == "match" || t.raw == "if" || t.raw == "break" || t.raw == "continue")
}

///| True iff identifier `name` may be (re)bound anywhere inside `(body_s, body_e)`. Every binding form of MoonBit
///| is scanned structurally and over-approximated (any doubt counts as a binding, so inference fails closed):
///| 1. `let`: the whole pattern up to the depth-0 `=` (`let { k } = h`, `let (a,\n k) = ..`, `let mut k`);
///| 2. `for`: everything up to the depth-0 `in` or loop-body `{` (`for i, { k } in ..`, C-style headers);
///| 3. `fn`: its name and parameter list;
///| 4. `is`: the pattern up to `&&`/`||`/`;`/`=>`/`=`/a statement keyword/a non-pattern `{`;
///| 5. `=>`: the whole arm head or arrow-closure parameters before it (struct, nested, guarded and or-patterns);
///| plus `as name`.
fn closure_body_binds_name(tokens : Array[Token], body_s : Int, body_e : Int, name : String) -> Bool {
  let mut i = body_s + 1
  while i < body_e {
    let t = tokens[i]
    if t.kind == TokenKind::Keyword && t.raw == "let" {
      let mut k = i + 1
      let mut d = 0
      while k < body_e {
        let kk = tokens[k].kind
        if is_open_delim(kk) {
          d = d + 1
        } else if is_close_delim(kk) {
          d = d - 1
          if d < 0 { break }
        } else if d == 0 && (kk == TokenKind::Eq || kk == TokenKind::Semi) {
          break
        } else if is_name_tok(tokens[k], name) {
          return true
        }
        k = k + 1
      }
    } else if t.kind == TokenKind::Keyword && t.raw == "for" && !(i + 1 < body_e && tokens[i + 1].kind == TokenKind::LBrace) {
      let mut k = i + 1
      let mut d = 0
      while k < body_e {
        let kk = tokens[k].kind
        if d == 0 && (kk == TokenKind::LBrace || (kk == TokenKind::Keyword && tokens[k].raw == "in")) {
          break
        }
        if is_open_delim(kk) {
          d = d + 1
        } else if is_close_delim(kk) {
          d = d - 1
          if d < 0 { break }
        } else if is_name_tok(tokens[k], name) {
          return true
        }
        k = k + 1
      }
    } else if t.kind == TokenKind::Keyword && t.raw == "fn" {
      let mut k = i + 1
      if k < body_e && tokens[k].kind == TokenKind::Ident {
        if tokens[k].raw == name {
          return true
        }
        k = k + 1
      }
      if k < body_e && tokens[k].kind == TokenKind::LBracket {
        k = find_matching_delim(tokens, k) + 1
      }
      if k < body_e && tokens[k].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, k)
        let mut q = k + 1
        while q < cp && q < body_e {
          if is_name_tok(tokens[q], name) {
            return true
          }
          q = q + 1
        }
      }
    } else if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "is" {
      let mut k = i + 1
      let mut d = 0
      while k < body_e {
        let tk = tokens[k]
        let kk = tk.kind
        if d == 0 && (kk == TokenKind::AmpAmp || kk == TokenKind::PipePipe || kk == TokenKind::Semi ||
          kk == TokenKind::FatArrow || kk == TokenKind::Eq || is_stmt_keyword(tk)) {
          break
        }
        if d == 0 && kk == TokenKind::LBrace {
          let pk = tokens[k - 1]
          let pattern_brace = pk.raw == "is" || pk.kind == TokenKind::Pipe || pk.kind == TokenKind::LParen ||
          pk.kind == TokenKind::Comma || pk.kind == TokenKind::Colon || pk.kind == TokenKind::LBracket
          if !pattern_brace {
            break
          }
        }
        if is_open_delim(kk) {
          d = d + 1
        } else if is_close_delim(kk) {
          d = d - 1
          if d < 0 { break }
        } else if is_name_tok(tk, name) {
          return true
        }
        k = k + 1
      }
    } else if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "as" {
      if i + 1 < body_e && is_name_tok(tokens[i + 1], name) {
        return true
      }
    } else if t.kind == TokenKind::FatArrow {
      // Walk back over the arm head / arrow-closure parameters (and, conservatively, the previous arm's body) to the
      // enclosing group, the previous `=>`, or a `;` / `=`. Line breaks are never boundaries: guards and
      // or-patterns may span lines (`Some({ k }) if 1 >\n  0 =>`).
      let mut k = i - 1
      let mut d = 0
      while k > body_s {
        let tk = tokens[k]
        let kk = tk.kind
        if is_close_delim(kk) {
          d = d + 1
        } else if is_open_delim(kk) {
          if d == 0 { break }
          d = d - 1
        } else if d == 0 && (kk == TokenKind::Semi || kk == TokenKind::Eq || kk == TokenKind::FatArrow) {
          break
        } else if is_name_tok(tk, name) {
          return true
        }
        k = k - 1
      }
    }
    i = i + 1
  }
  false
}

///| Infer the type of untyped closure parameter `pname` from its uses in `[body_s, body_e)`: every use as a whole
///| positional argument of `recv.m(...)` (receiver a plain scope variable of known type, not a field `a.recv`, with a
///| known `Type::m`) or of a known local function `f(...)` must agree on one simple type. Fail-closed (returns "")
///| when `pname`, the receiver or the callee is rebound in the body, when a call has named/labeled arguments or a
///| different argument count than the callee's parameters (so positions map 1:1), when there is no such use, any use
///| disagrees, or the type is not simple; pionc then reports the unannotated parameter.
fn infer_closure_param_type_from_body(
  ctx : StageAContext,
  tokens : Array[Token],
  body_s : Int,
  body_e : Int,
  pname : String,
  own_names : Array[String],
  own_tys : Array[String],
) -> String {
  if closure_body_binds_name(tokens, body_s, body_e, pname) {
    return ""
  }
  let mut found = ""
  let mut j = body_s + 1
  while j < body_e {
    let tk = tokens[j]
    if tk.kind == TokenKind::Ident && tk.raw == pname && j + 1 < body_e &&
    (tokens[j - 1].kind == TokenKind::LParen || tokens[j - 1].kind == TokenKind::Comma) &&
    (tokens[j + 1].kind == TokenKind::RParen || tokens[j + 1].kind == TokenKind::Comma) {
      // Find the enclosing `(` and this argument's positional index.
      let mut k = j - 1
      let mut d = 0
      let mut arg_idx = 0
      while k > body_s {
        let kk = tokens[k].kind
        if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
          d = d + 1
        } else if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
          if d == 0 { break }
          d = d - 1
        } else if d == 0 && kk == TokenKind::Comma {
          arg_idx = arg_idx + 1
        }
        k = k - 1
      }
      if k <= body_s || tokens[k].kind != TokenKind::LParen || tokens[k].newline_before || k < 1 ||
      tokens[k - 1].kind != TokenKind::Ident {
        return ""
      }
      // All arguments must be positional: no `name=`, `name~`, `name?=`, `name?` or `~` at depth 0.
      let close_p = find_matching_delim(tokens, k)
      let mut commas = 0
      let mut q = k + 1
      let mut qd = 0
      while q < close_p {
        let qk = tokens[q].kind
        if qk == TokenKind::LParen || qk == TokenKind::LBracket || qk == TokenKind::LBrace {
          qd = qd + 1
        } else if qk == TokenKind::RParen || qk == TokenKind::RBracket || qk == TokenKind::RBrace {
          qd = qd - 1
        } else if qd == 0 && qk == TokenKind::Comma {
          commas = commas + 1
        } else if qd == 0 && (qk == TokenKind::Tilde || qk == TokenKind::QuestionEq ||
          (qk == TokenKind::Ident && q + 1 < close_p &&
            (tokens[q + 1].kind == TokenKind::Eq || tokens[q + 1].kind == TokenKind::Question ||
              tokens[q + 1].kind == TokenKind::QuestionEq || tokens[q + 1].kind == TokenKind::Tilde))) {
          return ""
        }
        q = q + 1
      }
      // `(a, b)` has 2 arguments; a trailing comma `(a, b,)` does not add one. `pname` itself is one, so >= 1.
      let n_args = if tokens[close_p - 1].kind == TokenKind::Comma { commas } else { commas + 1 }
      let callee = tokens[k - 1].raw
      let mut pts : Array[(String, String)] = []
      let mut strip_self = false
      if k >= 3 && tokens[k - 2].kind == TokenKind::Dot && tokens[k - 3].kind == TokenKind::Ident {
        // The receiver must be a plain variable (`recv.m(..)`), never a field (`a.recv.m(..)`, `T::recv.m(..)`),
        // and must not be rebound inside the closure body.
        if k >= 4 && (tokens[k - 4].kind == TokenKind::Dot || tokens[k - 4].kind == TokenKind::ColonColon) {
          return ""
        }
        let recv = tokens[k - 3].raw
        if recv == pname || closure_body_binds_name(tokens, body_s, body_e, recv) {
          return ""
        }
        // A sibling parameter of this closure shadows any outer variable of the same name: use its own
        // annotation (none -> unknown -> fail closed), never the outer scope.
        let mut own_i = -1
        for oi, on in own_names {
          if on == recv { own_i = oi }
        }
        let recv_ty = if own_i >= 0 {
          if own_i < own_tys.length() { own_tys[own_i] } else { "" }
        } else {
          match lookup_scope_var(ctx, rename_keyword_ident(recv)) {
            Some(sv) => sv.ty
            None => ""
          }
        }
        if own_i >= 0 && recv_ty.length() == 0 {
          return ""
        }
        let rbase = strip_type_args_sym(recv_ty)
        if rbase.length() > 0 {
          match ctx.symtab.fn_param_types.get(rbase + "::" + callee) {
            Some(p) => {
              pts = p
              strip_self = true
            }
            None => ()
          }
        }
      } else if own_names.contains(callee) {
        // A closure parameter named like a local function shadows it.
        return ""
      } else if k >= 2 && tokens[k - 2].kind != TokenKind::Dot && tokens[k - 2].kind != TokenKind::ColonColon &&
      ctx.symtab.local_fn_names.contains(callee) && lookup_scope_var(ctx, callee) is None &&
      !closure_body_binds_name(tokens, body_s, body_e, callee) {
        match ctx.symtab.fn_param_types.get(callee) {
          Some(p) => pts = p
          None => ()
        }
      }
      let off = if strip_self && pts.length() > 0 && pts[0].0 == "self" { 1 } else { 0 }
      if strip_self && off == 0 {
        return ""
      }
      // Positions map 1:1 only when every parameter is passed positionally (labeled/optional/autofill parameters
      // are either named, which was rejected above, or omitted, which changes the count).
      if pts.length() == 0 || pts.length() - off != n_args || arg_idx + off >= pts.length() {
        return ""
      }
      let ty = pts[arg_idx + off].1.trim()
      if !is_simple_closure_param_type(ctx, ty) || (found.length() > 0 && found != ty) {
        return ""
      }
      found = ty
    }
    j = j + 1
  }
  found
}

///| MoonBit infers untyped closure parameters (`let n = fn(aid) { doc.attr_number(child, aid) }`) from their
///| uses, but Pion needs an expected function type or annotations. When no function type is expected, annotate
///| each plain untyped parameter whose type `infer_closure_param_type_from_body` determines unambiguously.
fn annotate_untyped_closure_params(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  end : Int,
  p_str : String,
  p_tys : Array[String],
) -> (String, Array[String]) {
  // Only a closure bound by an unannotated `let name = fn(...)` has nothing Pion could infer it from; a closure in
  // argument/field/return position gets its parameter types from the expected function type.
  let fn_i = open_p - 1
  let is_let_init = fn_i >= 3 && tokens[fn_i - 1].kind == TokenKind::Eq && tokens[fn_i - 2].kind == TokenKind::Ident &&
  tokens[fn_i - 3].kind == TokenKind::Keyword &&
  (tokens[fn_i - 3].raw == "let" || (tokens[fn_i - 3].raw == "mut" && fn_i >= 4 && tokens[fn_i - 4].raw == "let"))
  if !is_let_init || str_has(current_expected_type(ctx), "->") {
    return (p_str, p_tys)
  }
  // Locate the body `{ ... }` after an optional `-> Ret`.
  let mut b = close_p + 1
  let mut rd = 0
  while b < end {
    let bk = tokens[b].kind
    if rd == 0 && bk == TokenKind::LBrace { break }
    if rd == 0 && (bk == TokenKind::RBrace || bk == TokenKind::RParen || bk == TokenKind::Semi) { return (p_str, p_tys) }
    if bk == TokenKind::LParen || bk == TokenKind::LBracket { rd = rd + 1 }
    else if bk == TokenKind::RParen || bk == TokenKind::RBracket { rd = rd - 1 }
    b = b + 1
  }
  if b >= end {
    return (p_str, p_tys)
  }
  let body_e = find_matching_delim(tokens, b)
  let segs = p_str.split(", ")
  if segs.length() != p_tys.length() {
    return (p_str, p_tys)
  }
  // Each parameter must be exactly one identifier token (`fn(a, b)`) to be annotated.
  let own_names = extract_raw_param_names(tokens, open_p, close_p)
  let single : Array[String] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    if tokens[i].kind == TokenKind::Ident && i + 1 <= close_p &&
    (i + 1 == close_p || tokens[i + 1].kind == TokenKind::Comma) {
      single.push(tokens[i].raw)
      i = i + 2
    } else {
      single.push("")
      let mut d = 0
      while i < close_p {
        let k = tokens[i].kind
        if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
        else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && k == TokenKind::Comma { break }
        i = i + 1
      }
      i = i + 1
    }
  }
  if single.length() != p_tys.length() {
    return (p_str, p_tys)
  }
  let out_tys : Array[String] = []
  let sb = StringBuilder()
  let mut changed = false
  let mut pi = 0
  while pi < p_tys.length() {
    let mut seg = segs[pi]
    let mut ty = p_tys[pi]
    let raw = single[pi]
    if ty.length() == 0 && raw.length() > 0 && raw != "_" && !is_pion_reserved_ident(raw) && seg.trim() == raw {
      let inf = infer_closure_param_type_from_body(ctx, tokens, b, body_e, raw, own_names, p_tys)
      if inf.length() > 0 {
        seg = seg + " : " + inf
        ty = inf
        changed = true
      }
    }
    if pi > 0 { sb.write_string(", ") }
    sb.write_string(seg)
    out_tys.push(ty)
    pi = pi + 1
  }
  if !changed {
    return (p_str, p_tys)
  }
  (sb.to_string(), out_tys)
}

///| Extract `(param_names, param_types, all_typed)` from a parameter list `[open_p, close_p]`.
fn extract_param_info(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
) -> (Array[String], Array[String], Bool) {
  let names : Array[String] = []
  let tys : Array[String] = []
  let mut all_typed = true
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    let mut p_end = i
    let mut d = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Comma { break }
      p_end = p_end + 1
    }
    if p_end > i {
      let pname = rename_keyword_ident(tokens[i].raw)
      let mut colon_i = -1
      let mut eq_i = -1
      let mut s = i + 1
      let mut d2 = 0
      while s < p_end {
        let sk = tokens[s].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { d2 = d2 + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { d2 = d2 - 1 }
        else if d2 == 0 {
          if sk == TokenKind::Colon && colon_i < 0 { colon_i = s }
          else if sk == TokenKind::Eq && eq_i < 0 { eq_i = s }
        }
        s = s + 1
      }
      let ty_end = if eq_i >= 0 { eq_i } else { p_end }
      let is_opt_param = i + 1 < p_end && tokens[i + 1].kind == TokenKind::Question && eq_i < 0
      let raw_pty = if colon_i >= 0 {
        lower_type_tokens_checked(ctx, tokens, colon_i + 1, ty_end, file).trim()
      } else {
        all_typed = false
        ""
      }
      let pty = if is_opt_param && raw_pty.length() > 0 && !raw_pty.starts_with("Option[") {
        "Option[" + raw_pty + "]"
      } else {
        raw_pty
      }
      names.push(pname)
      tys.push(pty)
    }
    i = p_end + 1
  }
  (names, tys, all_typed)
}

///| Lower a block `{ ... }` handling value-returning `guard` statements by rewriting
///| non-diverging `guard cond else { fallback }; rest...` into `if`/`match` with the remainder!
pub fn lower_block_range(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
  prelude : String,
) -> String {
  let saved_scope = ctx.scope_vars.length()
  let saved_renames = ctx.ident_renames.length()
  let saved_lifted : Array[(String, LiftedLocalFn)] = []
  for k in ctx.lifted_local_fns.keys() {
    match ctx.lifted_local_fns.get(k) {
      Some(v) => saved_lifted.push((k, v))
      None => ()
    }
  }
  let sb = StringBuilder()
  sb.write_string("{")
  if prelude.length() > 0 {
    sb.write_string("\n")
    sb.write_string(prelude)
  }
  let inner = lower_stmts_range(ctx, tokens, open_b + 1, close_b, file)
  sb.write_string(inner)
  sb.write_string(tokens[close_b].leading_trivia)
  sb.write_string("}")
  restore_scope_vars(ctx, saved_scope)
  restore_ident_renames(ctx, saved_renames)
  ctx.lifted_local_fns.clear()
  for kv in saved_lifted {
    ctx.lifted_local_fns[kv.0] = kv.1
  }
  sb.to_string()
}

///| Lower a sequence of statements inside a block `[start, end)`.
///| Rewrites value-returning `guard` with its remainder; preserves diverging `guard` untouched!
fn lower_stmts_range(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let t = tokens[i]
    // Check for `guard <cond> else { ... }`
    if t.kind == TokenKind::Keyword && t.raw == "guard" {
      // Find matching `else` at depth 0
      let mut j = i + 1
      let mut depth = 0
      let mut else_idx = -1
      while j < end {
        let jk = tokens[j].kind
        if jk == TokenKind::LParen || jk == TokenKind::LBrace || jk == TokenKind::LBracket {
          depth = depth + 1
        } else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace {
          depth = depth - 1
        } else if depth == 0 && jk == TokenKind::Keyword && tokens[j].raw == "else" {
          else_idx = j
          break
        }
        j = j + 1
      }
      if else_idx > i && else_idx + 1 < end && tokens[else_idx + 1].kind == TokenKind::LBrace {
        let else_open = else_idx + 1
        let else_close = find_matching_delim(tokens, else_open)
        if !block_diverges(tokens, else_open, else_close) {
          // Value-returning `guard`! Rewrite together with the remainder `[after_else, end)`.
          let mut after_else = else_close + 1
          if after_else < end && tokens[after_else].kind == TokenKind::Semi {
            after_else = after_else + 1
          }
          let else_body = lower_block_range(ctx, tokens, else_open, else_close, file, "")
          // Check if condition is `<scrut> is <Pat>` (without top-level `&&`) -> lower to `match <scrut> { <Pat> => { <rest> }, _ => <else> }`
          let mut is_idx = -1
          let mut has_ampamp = false
          let mut ci = i + 1
          let mut cd = 0
          while ci < else_idx {
            let ck = tokens[ci].kind
            if ck == TokenKind::LParen || ck == TokenKind::LBracket || ck == TokenKind::LBrace {
              cd = cd + 1
            } else if ck == TokenKind::RParen || ck == TokenKind::RBracket || ck == TokenKind::RBrace {
              cd = cd - 1
            } else if cd == 0 {
              if ck == TokenKind::Keyword && tokens[ci].raw == "is" && is_idx < 0 {
                is_idx = ci
              } else if ck == TokenKind::AmpAmp {
                has_ampamp = true
              }
            }
            ci = ci + 1
          }
          sb.write_string(t.leading_trivia)
          match try_lower_value_guard_is_chain(ctx, tokens, i, else_idx, else_body, after_else, end, file) {
            Some(vg_code) => {
              sb.write_string(vg_code)
              return sb.to_string()
            }
            None => ()
          }
          let saved_g_sc = ctx.scope_vars.length()
          let saved_g_rn = ctx.ident_renames.length()
          let cond_str = lower_cond_with_is_binders(ctx, tokens, i + 1, else_idx, file).trim()
          let rest_body = lower_stmts_range(ctx, tokens, after_else, end, file)
          restore_scope_vars(ctx, saved_g_sc)
          restore_ident_renames(ctx, saved_g_rn)
          if is_idx > i + 1 && !has_ampamp {
            let scrut_str = lower_expr_range(ctx, tokens, i + 1, is_idx, file, false).trim()
            let pat_str = lower_expr_range(ctx, tokens, is_idx + 1, else_idx, file, true).trim()
            sb.write_string("match " + scrut_str + " {\n    " + pat_str + " => {\n" + rest_body + "\n    }\n    _ => " + else_body + "\n  }")
          } else {
            sb.write_string("if " + cond_str + " {\n" + rest_body + "\n  } else " + else_body)
          }
          ctx.drift_ledger.push(DriftEntry::{
            category: "value_guard",
            file: file,
            line: t.line,
            col: t.col,
            expr: "guard " + cond_str,
            resolution: if is_idx > i + 1 && !has_ampamp { "rewritten_to_match_with_remainder" } else { "rewritten_to_if_else_with_remainder" },
            status: "resolved",
            detail: "non-diverging guard else rewritten with enclosing block remainder",
          })
          return sb.to_string()
        }
        // Diverging `guard`: lower `else` first (without `is` binders), then lower cond pushing `is` binders for remainder of block!
        let else_body = lower_block_range(ctx, tokens, else_open, else_close, file, "")
        match try_lower_diverging_guard_is_chain(ctx, tokens, i, else_idx, else_body, file) {
          Some(dg_code) => {
            sb.write_string(t.leading_trivia)
            sb.write_string(dg_code)
            i = else_close + 1
            continue
          }
          None => ()
        }
        let cond_str = lower_cond_with_is_binders(ctx, tokens, i + 1, else_idx, file)
        sb.write_string(t.leading_trivia)
        sb.write_string("guard" + cond_str + tokens[else_idx].leading_trivia + "else" + tokens[else_open].leading_trivia + else_body)
        i = else_close + 1
        continue
      }
    }

    // Local named `fn go(a : T) -> R { ... }` — strict declaration-order visibility!
    // Each local `fn` sees ONLY itself and previously declared local `fn`s (NEVER forward-binds
    // to a later sibling local `fn`, matching MoonBit's lexical scoping).
    // - Non-recursive -> `let go = fn(a : T) -> R { ... }` (zero self-capture, params shadow outer boxed vars)
    // - Self-recursive -> lifted to package-private top-level function
    //   `__mbt_local_<enclosing>_<name>_<id>(env..., params...) -> R` (ZERO RC cycles!)
    match try_parse_local_fn_decl(tokens, i, end) {
      Some(g) => {
        let next_after = g.end_tok
        let body_refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
        let is_self_rec = body_refs.contains(g.name)
        let (p_names, p_tys, all_typed) = extract_param_info(ctx, tokens, g.open_p, g.close_p, file)
        let param_set : Map[String, Bool] = Map()
        for pn in p_names { param_set[pn] = true }
        if !is_self_rec {
          let (p_str, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, g.open_p, g.close_p, file, false, true)
          let raw_p_names = extract_raw_param_names(tokens, g.open_p, g.close_p)
          let ret_str = if g.ret_start >= 0 && g.ret_end > g.ret_start {
            " -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
          } else {
            ""
          }
          // Push own params as non-boxed ScopeVars + scoped ident_renames so shadowed outer vars/keywords stay hygienic!
          let saved_sc = ctx.scope_vars.length()
          let saved_rn = ctx.ident_renames.length()
          if p_renames.length() > 0 {
            ctx.ident_renames.push(p_renames)
          }
          let mut pi = 0
          while pi < raw_p_names.length() {
            let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
            ctx.scope_vars.push(ScopeVar::{
              name: eff_pn,
              ty: if pi < p_tys.length() { p_tys[pi] } else { "" },
              is_mut: false,
              is_boxed: false,
            })
            pi = pi + 1
          }
          let body = lower_block_range(ctx, tokens, g.lb, g.rb, file, p_pre)
          restore_scope_vars(ctx, saved_sc)
          restore_ident_renames(ctx, saved_rn)
          sb.write_string(tokens[g.start_tok].leading_trivia)
          sb.write_string("let " + g.name + " = fn(" + p_str + ")" + ret_str + " " + body)
          // Register this local fn in scope for subsequent statements/local fns (declaration order!)
          let fn_ty = if all_typed && g.ret_start >= 0 && g.ret_end > g.ret_start {
            "(" + join_comma(p_tys) + ") -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
          } else {
            ""
          }
          ctx.scope_vars.push(ScopeVar::{ name: g.name, ty: fn_ty, is_mut: false, is_boxed: false })
          i = next_after
          continue
        }
        // Self-recursive local fn: collect lexically FREE captured outer `ScopeVar`s (respecting inner shadowing)
        let init_bound : Map[String, Bool] = Map()
        init_bound[g.name] = true
        for pn in p_names { init_bound[pn] = true }
        let free_refs = collect_free_body_idents_f3d2(tokens, g.lb + 1, g.rb, init_bound)
        // Transitively include env_args of any already-lifted local fn called from this body
        let extra_env : Array[String] = []
        for r in free_refs.keys() {
          match ctx.lifted_local_fns.get(r) {
            Some(lf) => { for ea in lf.env_args { extra_env.push(ea) } }
            None => ()
          }
        }
        for ea in extra_env {
          if !init_bound.contains(ea) { free_refs[ea] = true }
        }
        let captured : Array[ScopeVar] = []
        let cap_seen : Map[String, Bool] = Map()
        for r in sorted_map_keys(free_refs) {
          if r == g.name || param_set.contains(r) || cap_seen.contains(r) {
            continue
          }
          match lookup_scope_var(ctx, r) {
            Some(sv) => {
              cap_seen[r] = true
              captured.push(sv)
            }
            None => ()
          }
        }
        let enc_clean = sanitize_file_id(ctx.cur_enclosing_fn)
        ctx.lift_counter = ctx.lift_counter + 1
        let lift_id = ctx.lift_counter.to_string()
        let lname = "__mbt_local_" + enc_clean + "_" + g.name + "_" + lift_id
        let mut can_lift = true
        let env_params : Array[String] = []
        let env_args : Array[String] = []
        let cap_decls = StringBuilder()
        let cap_body_pre = StringBuilder()
        let cap_scope_vars : Array[ScopeVar] = []
        let used_idents : Map[String, Bool] = Map()
        collect_all_idents_with_interp_f3d2(tokens, used_idents)
        for cur_sv in ctx.scope_vars {
          used_idents[cur_sv.name] = true
        }
        for k in ctx.symtab.local_value_names.keys() { used_idents[k] = true }
        for k in ctx.symtab.const_defs.keys() { used_idents[k] = true }
        for k in ctx.symtab.local_fn_names.keys() { used_idents[k] = true }
        for k in ctx.symtab.fn_param_types.keys() { used_idents[k] = true }
        for k in ctx.symtab.prod_pub_decls.keys() { used_idents[k] = true }
        for k in ctx.symtab.blackbox_decls.keys() { used_idents[k] = true }
        for k in ctx.symtab.using_values.keys() { used_idents[k] = true }
        for k in ctx.symtab.val_types.keys() { used_idents[k] = true }
        for sv in captured {
          if !is_liftable_static_type(sv.ty) {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              g.line,
              g.col,
              "cannot lift recursive local fn `" + g.name + "`: captured variable `" + sv.name + "` lacks a statically known type",
            ))
            can_lift = false
          } else {
            let base_alias = "__mbt_cap_" + lift_id + "_" + sv.name
            let mut cap_alias = base_alias
            let mut cap_sfx = 1
            while used_idents.contains(cap_alias) {
              cap_alias = base_alias + "_" + cap_sfx.to_string()
              cap_sfx = cap_sfx + 1
            }
            used_idents[cap_alias] = true
            let outer_ref = resolve_ident_in_scope(ctx, sv.name)
            cap_decls.write_string("let " + cap_alias + " = " + outer_ref + "; ")
            cap_body_pre.write_string("let " + sv.name + " = " + cap_alias + "; ")
            if sv.is_boxed {
              env_params.push(cap_alias + " : mbt_compat::MbtCell[" + sv.ty + "]")
            } else {
              env_params.push(cap_alias + " : " + sv.ty)
            }
            env_args.push(cap_alias)
            cap_scope_vars.push(ScopeVar::{
              name: cap_alias,
              ty: sv.ty,
              is_mut: false,
              is_boxed: sv.is_boxed,
            })
          }
        }
        if !all_typed {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            g.line,
            g.col,
            "cannot lift recursive local fn `" + g.name + "`: parameter type annotation required",
          ))
          can_lift = false
        }
        // Register lifted name BEFORE lowering body so self-calls rewrite to `lname(env..., args...)`
        ctx.lifted_local_fns[g.name] = LiftedLocalFn::{
          lifted_name: lname,
          env_args: env_args,
        }
        let (p_str, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, g.open_p, g.close_p, file, false, true)
        let raw_p_names = extract_raw_param_names(tokens, g.open_p, g.close_p)
        let ret_str = if g.ret_start >= 0 && g.ret_end > g.ret_start {
          " -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
        } else {
          " -> Unit"
        }
        let saved_sc = ctx.scope_vars.length()
        let saved_rn = ctx.ident_renames.length()
        if p_renames.length() > 0 {
          ctx.ident_renames.push(p_renames)
        }
        let eff_p_names : Array[String] = []
        let mut pi = 0
        while pi < raw_p_names.length() {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          eff_p_names.push(eff_pn)
          ctx.scope_vars.push(ScopeVar::{
            name: eff_pn,
            ty: if pi < p_tys.length() { p_tys[pi] } else { "" },
            is_mut: false,
            is_boxed: false,
          })
          pi = pi + 1
        }
        let full_body_pre = cap_body_pre.to_string() + p_pre
        let body = lower_block_range(ctx, tokens, g.lb, g.rb, file, full_body_pre)
        restore_scope_vars(ctx, saved_sc)
        restore_ident_renames(ctx, saved_rn)
        for csv in cap_scope_vars {
          ctx.scope_vars.push(csv)
        }
        let full_params = if env_params.length() > 0 && p_str.length() > 0 {
          join_comma(env_params) + ", " + p_str
        } else if env_params.length() > 0 {
          join_comma(env_params)
        } else {
          p_str
        }
        ctx.lifted_fns.push("fn " + lname + "(" + full_params + ")" + ret_str + " " + body + "\n")
        let escapes = is_local_fn_used_as_value(tokens, next_after, end, g.name) ||
        is_local_fn_used_as_value(tokens, g.lb + 1, g.rb, g.name)
        sb.write_string(tokens[g.start_tok].leading_trivia)
        let cap_decls_s = cap_decls.to_string()
        if cap_decls_s.length() > 0 {
          sb.write_string(cap_decls_s)
        }
        if escapes {
          let call_args_all : Array[String] = []
          for ea in env_args { call_args_all.push(ea) }
          for pn in eff_p_names { call_args_all.push(pn) }
          sb.write_string("let " + g.name + " = fn(" + p_str + ")" + ret_str + " { " + lname + "(" + join_comma(call_args_all) + ") }")
        } else {
          sb.write_string("// lifted recursive local fn: " + lname)
        }
        let _ = can_lift
        i = next_after
        continue
      }
      None => ()
    }

    // Check placeholder pipe at statement expression boundary (when not inside a `let` / `guard` / `fn` keyword)
    if !(t.kind == TokenKind::Keyword && (t.raw == "let" || t.raw == "guard" || t.raw == "fn" || t.raw == "if" || t.raw == "match" || t.raw == "while" || t.raw == "for" || t.raw == "return")) {
      match try_lower_placeholder_pipe_chain(ctx, tokens, i, end, file) {
        Some((pipe_code, next_i)) => {
          sb.write_string(pipe_code)
          i = next_i
          continue
        }
        None => ()
      }
    }

    // Otherwise lower one expression/token step
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, end, file, false)
    sb.write_string(piece)
    i = next_i
  }
  sb.to_string()
}

///| Recursively emit nested `match` branches for 1+ optional forwarded arguments on an external `x~` callee.
fn emit_ext_opt_branches(
  sb : StringBuilder,
  callee_expr : String,
  temps : Array[String],
  arg_labels : Array[String],
  ext_opt_indices : Array[Int],
  opt_vars : Array[String],
  present : Array[Bool],
  depth : Int,
) -> Unit {
  if depth == ext_opt_indices.length() {
    sb.write_string(callee_expr + "(")
    let mut first = true
    let mut k = 0
    while k < temps.length() {
      let mut opt_pos = -1
      let mut oi = 0
      while oi < ext_opt_indices.length() {
        if ext_opt_indices[oi] == k {
          opt_pos = oi
          break
        }
        oi = oi + 1
      }
      if opt_pos >= 0 {
        if present[opt_pos] {
          if !first {
            sb.write_string(", ")
          }
          sb.write_string(arg_labels[k] + "=" + opt_vars[opt_pos])
          first = false
        }
      } else {
        if !first {
          sb.write_string(", ")
        }
        if arg_labels[k].length() > 0 {
          sb.write_string(arg_labels[k] + "=" + temps[k])
        } else {
          sb.write_string(temps[k])
        }
        first = false
      }
      k = k + 1
    }
    sb.write_string(")")
    return
  }
  let idx = ext_opt_indices[depth]
  let vname = opt_vars[depth]
  sb.write_string("match " + temps[idx] + " { Some(" + vname + ") => ")
  present[depth] = true
  emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, depth + 1)
  sb.write_string(", None => ")
  present[depth] = false
  emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, depth + 1)
  sb.write_string(" }")
}

///| Lower a call argument list `(arg1, x~, y?, ...)` handling:
///| - `x~` -> `x=x`
///| - `x?` -> `x?=x` (or external call-site branching when `is_external_tilde`)
///| - `SourceLoc` autofill injection `loc="<rel>.mbt:<line>:<col>"` when `needs_loc` and no explicit `loc=`
fn lower_call_args(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  call_line : Int,
  call_col : Int,
  callee_expr : String,
  needs_loc : Bool,
  is_external_tilde : Bool,
) -> String {
  let saved_interp_top_call = ctx.in_interp_top
  ctx.in_interp_top = false
  // Split arguments at depth-0 commas
  let raw_args : Array[(Int, Int)] = []
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        break
      }
      a_end = a_end + 1
    }
    raw_args.push((cur, a_end))
    cur = a_end + 1
  }

  // Check for optional forwarding `x?` OR explicit `x?=expr` on a fixed external `x~ : T = d` callee (Astra P1-3)
  let ext_opt_indices : Array[Int] = []
  if is_external_tilde {
    let mut ai = 0
    while ai < raw_args.length() {
      let (s, e) = raw_args[ai]
      if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Question {
        ext_opt_indices.push(ai)
      } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::QuestionEq {
        ext_opt_indices.push(ai)
      }
      ai = ai + 1
    }
  }

  // Look up callee parameter types for per-use-site expected-type guidance (Wave M1.2 A.5)
  let is_dot_method = callee_expr.starts_with("__dot__::")
  let lookup_callee = if is_dot_method {
    callee_expr.slice(9, callee_expr.length())
  } else {
    callee_expr
  }
  let raw_callee_pts0 : Array[(String, String)] = if lookup_callee.starts_with("__method__::") {
    let mname = lookup_callee.slice(12, lookup_callee.length())
    match ctx.symtab.method_unique_param_types.get(mname) {
      Some(pts) => pts
      None => []
    }
  } else if ctx.cur_is_blackbox {
    match ctx.symtab.blackbox_fn_param_types.get(lookup_callee) {
      Some(pts) => pts
      None =>
      if ctx.symtab.blackbox_decls.contains(lookup_callee) {
        []
      } else {
        match ctx.symtab.fn_param_types.get(lookup_callee) {
          Some(pts) => pts
          None => []
        }
      }
    }
  } else {
    match ctx.symtab.fn_param_types.get(lookup_callee) {
      Some(pts) => pts
      None => []
    }
  }
  let raw_callee_pts : Array[(String, String)] = if raw_callee_pts0.length() > 0 || is_dot_method {
    raw_callee_pts0
  } else {
    lookup_local_closure_param_types_f3d2(ctx, lookup_callee)
  }
  // When called as `recv.method(...)` via `Type::method` lookup, strip leading `self` parameter!
  let callee_pts : Array[(String, String)] = if is_dot_method &&
  raw_callee_pts.length() > 0 && raw_callee_pts[0].0 == "self" {
    let trimmed : Array[(String, String)] = []
    let mut k = 1
    while k < raw_callee_pts.length() {
      trimmed.push(raw_callee_pts[k])
      k = k + 1
    }
    trimmed
  } else {
    raw_callee_pts
  }
  let callee_renames : Option[Map[String, String]] = if is_dot_method {
    match ctx.symtab.fn_param_renames.get(lookup_callee) {
      Some(m) => Some(m)
      None => ctx.symtab.method_unique_param_renames.get(lookup_callee)
    }
  } else {
    ctx.symtab.fn_param_renames.get(lookup_callee)
  }
  let arg_exp_tys = compute_call_arg_expected_types_f3d2(ctx, lookup_callee, is_dot_method, callee_pts, tokens, raw_args)
  let mut has_explicit_loc = false
  let lowered_args : Array[String] = []
  // Parallel metadata per argument: `(label_or_empty, value_expr, is_ext_opt)`
  let arg_labels : Array[String] = []
  let arg_vals : Array[String] = []
  let arg_is_ext_opt : Array[Bool] = []
  let mut ai = 0
  while ai < raw_args.length() {
    let (s, e) = raw_args[ai]
    let exp_ty_ai = if ai < arg_exp_tys.length() { arg_exp_tys[ai] } else { "" }
    if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Tilde {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      let val_nm = resolve_ident_in_scope(ctx, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      lowered_args.push(lbl + "=" + val_nm)
      arg_labels.push(lbl)
      arg_vals.push(val_nm)
      arg_is_ext_opt.push(false)
    } else if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Question {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      let val_nm = resolve_ident_in_scope(ctx, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      lowered_args.push(lbl + "?=" + val_nm)
      arg_labels.push(lbl)
      arg_vals.push(val_nm)
      arg_is_ext_opt.push(is_external_tilde)
    } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::QuestionEq {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      let saved_exp = ctx.expected_type_stack.length()
      push_expected_type(ctx, exp_ty_ai)
      let val_s = lower_expr_range(ctx, tokens, s + 2, e, file, false).trim()
      restore_expected_type_stack(ctx, saved_exp)
      lowered_args.push(lbl + "?=" + val_s)
      arg_labels.push(lbl)
      arg_vals.push(val_s)
      arg_is_ext_opt.push(is_external_tilde)
    } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Eq {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      let saved_exp = ctx.expected_type_stack.length()
      push_expected_type(ctx, exp_ty_ai)
      let val_s = lower_expr_range(ctx, tokens, s + 2, e, file, false).trim()
      restore_expected_type_stack(ctx, saved_exp)
      lowered_args.push(lbl + "=" + val_s)
      arg_labels.push(lbl)
      arg_vals.push(val_s)
      arg_is_ext_opt.push(false)
    } else {
      let saved_exp = ctx.expected_type_stack.length()
      push_expected_type(ctx, exp_ty_ai)
      let val_s = lower_expr_range(ctx, tokens, s, e, file, false).trim()
      restore_expected_type_stack(ctx, saved_exp)
      lowered_args.push(val_s)
      arg_labels.push("")
      arg_vals.push(val_s)
      arg_is_ext_opt.push(false)
    }
    ai = ai + 1
  }

  if needs_loc && !has_explicit_loc {
    let rel = if ctx.opts.src_prefix.length() > 0 {
      ctx.opts.src_prefix + "/" + file
    } else {
      file
    }
    let loc_lit = "\"" + rel + ":" + call_line.to_string() + ":" + call_col.to_string() + "\""
    lowered_args.push("loc=" + loc_lit)
    arg_labels.push("loc")
    arg_vals.push(loc_lit)
    arg_is_ext_opt.push(false)
  }

  // External fixed `x~ : T = d` callee with 1+ `x?` forwardings:
  // Evaluate EVERY argument expression strictly once left-to-right, preserve all named labels,
  // and generate nested `match` branches for all 2^k `Some`/`None` combinations!
  if ext_opt_indices.length() > 0 {
    let sb = StringBuilder()
    sb.write_string("{ ")
    let temps : Array[String] = []
    let mut k = 0
    while k < arg_vals.length() {
      let tname = fresh_temp(ctx, "arg")
      temps.push(tname)
      sb.write_string("let " + tname + " = " + arg_vals[k] + "; ")
      k = k + 1
    }
    let present : Array[Bool] = []
    let opt_vars : Array[String] = []
    k = 0
    while k < ext_opt_indices.length() {
      present.push(false)
      opt_vars.push("__mbt_v" + k.to_string())
      k = k + 1
    }
    emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, 0)
    sb.write_string(" }")
    ctx.in_interp_top = saved_interp_top_call
    return sb.to_string()
  }

  let sb = StringBuilder()
  sb.write_string(callee_expr + "(")
  let mut k = 0
  while k < lowered_args.length() {
    if k > 0 {
      sb.write_string(", ")
    }
    sb.write_string(lowered_args[k])
    k = k + 1
  }
  ctx.in_interp_top = saved_interp_top_call
  sb.write_string(")")
  sb.to_string()
}

///| Pre-scan a function body `[start, end)` for borrowed slices `a[lo:hi]` (NOT followed by
///| `.to_owned()` or `.to_array()`). Local arrays initialized from `[...]` that have borrowed
///| slices are promoted to `mbt_compat::ArrayBuf[T]`, and views derived from them (including
///| nested views `v[lo:hi]`) are tracked as `mbt_compat::ArrayView[T]`.
fn prescan_borrowed_slices(
  tokens : Array[Token],
  start : Int,
  end : Int,
  bufs : Map[String, Bool],
  views : Map[String, Bool],
) -> Unit {
  // Collect local `let [mut] <name> = [...]` array literal declarations
  let local_arrs : Map[String, Bool] = Map()
  let mut i = start
  while i < end {
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" {
      let mut ni = i + 1
      if ni < end && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni < end && tokens[ni].kind == TokenKind::Ident {
        let vname = rename_keyword_ident(tokens[ni].raw)
        let mut eq_i = ni + 1
        while eq_i < end && tokens[eq_i].kind != TokenKind::Eq && !tokens[eq_i].newline_before {
          eq_i = eq_i + 1
        }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq && tokens[eq_i + 1].kind == TokenKind::LBracket {
          local_arrs[vname] = true
        }
        // `let xs [: Array[T]] = Array(capacity=n)` / `Array::new(..)`: an `ArrayBuf` with reserved capacity.
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq {
          let (ctor_close, _, _) = array_ctor_capacity_range(tokens, eq_i + 1, end)
          if ctor_close >= 0 {
            local_arrs[vname] = true
          }
        }
      }
    }
    i = i + 1
  }

  // Fixpoint: find borrowed slices `recv[lo:hi]` (not followed by `.to_owned()` / `.to_array()`)
  let mut changed = true
  while changed {
    changed = false
    i = start
    while i < end {
      if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" {
        let mut ni = i + 1
        if ni < end && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
          ni = ni + 1
        }
        if ni < end && tokens[ni].kind == TokenKind::Ident {
          let lhs_name = rename_keyword_ident(tokens[ni].raw)
          let mut eq_i = ni + 1
          while eq_i < end && tokens[eq_i].kind != TokenKind::Eq && !tokens[eq_i].newline_before {
            eq_i = eq_i + 1
          }
          if eq_i + 2 < end && tokens[eq_i].kind == TokenKind::Eq &&
          tokens[eq_i + 1].kind == TokenKind::Ident && tokens[eq_i + 2].kind == TokenKind::LBracket {
            let recv_name = rename_keyword_ident(tokens[eq_i + 1].raw)
            let close_br = find_matching_delim(tokens, eq_i + 2)
            let mut has_colon = false
            let mut k = eq_i + 3
            let mut d = 0
            while k < close_br {
              let kk = tokens[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
                d = d + 1
              } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
                d = d - 1
              } else if d == 0 && kk == TokenKind::Colon {
                has_colon = true
                break
              }
              k = k + 1
            }
            let followed_by_owned = close_br + 2 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
            (tokens[close_br + 2].raw == "to_owned" || tokens[close_br + 2].raw == "to_array")
            if has_colon && !followed_by_owned {
              if local_arrs.contains(recv_name) {
                if !bufs.contains(recv_name) {
                  bufs[recv_name] = true
                  changed = true
                }
                if !views.contains(lhs_name) {
                  views[lhs_name] = true
                  changed = true
                }
              } else if views.contains(recv_name) {
                if !views.contains(lhs_name) {
                  views[lhs_name] = true
                  changed = true
                }
              }
            }
          }
        }
      }
      // P0-3 & E1-3: `match <local_arr> { ... .. as <tail> ... }` and `match Ctor(<local_arr>) { ... .. as <tail> ... }`
      // promote `<local_arr>` to `ArrayBuf` and `<tail>` to `ArrayView` so `.. as tail` shares the backing buffer.
      if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "match" {
        let mut scrut_nm = ""
        let mut mb_open = -1
        if i + 2 < end && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LBrace {
          scrut_nm = rename_keyword_ident(tokens[i + 1].raw)
          mb_open = i + 2
        } else if i + 5 < end && tokens[i + 1].kind == TokenKind::UpperIdent &&
        tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::Ident &&
        tokens[i + 4].kind == TokenKind::RParen && tokens[i + 5].kind == TokenKind::LBrace {
          scrut_nm = rename_keyword_ident(tokens[i + 3].raw)
          mb_open = i + 5
        }
        if mb_open >= 0 && (local_arrs.contains(scrut_nm) || views.contains(scrut_nm)) {
          let mb = find_matching_delim(tokens, mb_open)
          let mut mi = mb_open + 1
          while mi + 2 < mb {
            if tokens[mi].kind == TokenKind::DotDot &&
            tokens[mi + 1].kind == TokenKind::Keyword && tokens[mi + 1].raw == "as" &&
            tokens[mi + 2].kind == TokenKind::Ident && tokens[mi + 2].raw != "_" {
              let tail_nm = rename_keyword_ident(tokens[mi + 2].raw)
              if local_arrs.contains(scrut_nm) && !bufs.contains(scrut_nm) {
                bufs[scrut_nm] = true
                changed = true
              }
              if !views.contains(tail_nm) {
                views[tail_nm] = true
                changed = true
              }
            }
            mi = mi + 1
          }
        }
      }
      i = i + 1
    }
  }
}

///| Lower a top-level `fn` body with borrowed-slice `ArrayBuf`/`ArrayView` tracking.
fn lower_fn_body_with_views(
  ctx : StageAContext,
  tokens : Array[Token],
  lb : Int,
  rb : Int,
  file : String,
  preamble : String,
) -> String {
  ctx.borrowed_bufs.clear()
  ctx.borrowed_views.clear()
  prescan_borrowed_slices(tokens, lb, rb, ctx.borrowed_bufs, ctx.borrowed_views)
  let body = lower_block_range(ctx, tokens, lb, rb, file, preamble)
  ctx.borrowed_bufs.clear()
  ctx.borrowed_views.clear()
  body
}

///| Check if a pipe stage `[st_start, st_end)` uses placeholder `_`.
///| Returns: 0 = no placeholder (pass plain pipe through natively!),
///|          1 = valid single top-level `_` arg in `<callee>(e0, ..., _, ..., ek)`,
///|          -1 = unsupported placeholder shape (multiple `_`, nested `_`, or non-call RHS).
fn classify_pipe_stage_placeholder(tokens : Array[Token], st_start : Int, st_end : Int) -> (Int, Int, Int) {
  // Find depth-0 call `(` ... `)` at end of stage
  let mut open_p = -1
  let mut i = st_start
  let mut d = 0
  while i < st_end {
    let tk = tokens[i].kind
    if tk == TokenKind::LParen {
      if d == 0 {
        let cp = find_matching_delim(tokens, i)
        if cp + 1 == st_end {
          open_p = i
          break
        }
      }
      d = d + 1
    } else if tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      d = d + 1
    } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    }
    i = i + 1
  }
  if open_p <= st_start {
    // Non-call RHS: only unsupported if `_` is literally the top-level stage expression
    if st_end == st_start + 1 && tokens[st_start].kind == TokenKind::Underscore {
      return (-1, -1, -1)
    }
    return (0, -1, -1)
  }
  let close_p = st_end - 1
  // Count top-level `_` args vs nested `_` (ignoring `_` inside closure params/patterns!)
  let mut top_underscores = 0
  let mut ai = open_p + 1
  while ai < close_p {
    if tokens[ai].kind == TokenKind::Comma {
      ai = ai + 1
      continue
    }
    let mut ae = ai
    let mut ad = 0
    while ae < close_p {
      let ak = tokens[ae].kind
      if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
      else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
      else if ad == 0 && ak == TokenKind::Comma { break }
      ae = ae + 1
    }
    if ae == ai + 1 && tokens[ai].kind == TokenKind::Underscore {
      top_underscores = top_underscores + 1
    } else {
      // Check for nested `_` ONLY outside closure bodies/params and match patterns
      let mut j = ai
      while j < ae {
        if tokens[j].kind == TokenKind::Keyword && tokens[j].raw == "fn" && j + 1 < ae && tokens[j + 1].kind == TokenKind::LParen {
          let fcp = find_matching_delim(tokens, j + 1)
          let mut flb = fcp + 1
          while flb < ae && tokens[flb].kind != TokenKind::LBrace { flb = flb + 1 }
          if flb < ae {
            j = find_matching_delim(tokens, flb) + 1
            continue
          }
        }
        if tokens[j].kind == TokenKind::LBrace {
          j = find_matching_delim(tokens, j) + 1
          continue
        }
        if tokens[j].kind == TokenKind::Underscore && !(j + 1 < ae && tokens[j + 1].kind == TokenKind::FatArrow) {
          return (-1, -1, -1)
        }
        j = j + 1
      }
    }
    ai = ae + 1
  }
  if top_underscores == 0 {
    (0, -1, -1)
  } else if top_underscores == 1 {
    (1, open_p, close_p)
  } else {
    (-1, -1, -1)
  }
}

///| Lower a pipe chain starting at `i` ONLY if at least one depth-0 `|>` stage uses `_` placeholder!
///| Plain `lhs |> f(args)` and `lhs |> ignore` return `None` so they pass through natively untouched!
fn try_lower_placeholder_pipe_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let expr_end = find_expr_end(tokens, i, end)
  if expr_end <= i + 2 {
    return None
  }
  // Collect depth-0 `|>` indices within `[i, expr_end)`
  let pipe_idxs : Array[Int] = []
  let mut k = i
  let mut d = 0
  while k < expr_end {
    let tk = tokens[k].kind
    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { d = d + 1 }
    else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
    else if d == 0 && tk == TokenKind::PipeGt {
      pipe_idxs.push(k)
    }
    k = k + 1
  }
  if pipe_idxs.length() == 0 {
    return None
  }
  // Check if ANY stage uses a placeholder `_`
  let mut any_placeholder = false
  let mut pi = 0
  while pi < pipe_idxs.length() {
    let st_s = pipe_idxs[pi] + 1
    let st_e = if pi + 1 < pipe_idxs.length() { pipe_idxs[pi + 1] } else { expr_end }
    let (cls, _, _) = classify_pipe_stage_placeholder(tokens, st_s, st_e)
    if cls != 0 {
      any_placeholder = true
      break
    }
    pi = pi + 1
  }
  if !any_placeholder {
    return None
  }
  // Lower left-to-right preserving exact evaluation order & single-eval count
  let mut acc = lower_expr_range(ctx, tokens, i, pipe_idxs[0], file, false).trim()
  pi = 0
  while pi < pipe_idxs.length() {
    let st_s = pipe_idxs[pi] + 1
    let st_e = if pi + 1 < pipe_idxs.length() { pipe_idxs[pi + 1] } else { expr_end }
    let (cls, open_p, close_p) = classify_pipe_stage_placeholder(tokens, st_s, st_e)
    if cls == 0 {
      let rhs_s = lower_expr_range(ctx, tokens, st_s, st_e, file, false).trim()
      acc = acc + " |> " + rhs_s
    } else if cls < 0 {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_PIPE_PLACEHOLDER",
        file,
        tokens[pipe_idxs[pi]].line,
        tokens[pipe_idxs[pi]].col,
        "unsupported placeholder pipe shape (multiple `_`, nested `_`, or non-call target)",
      ))
      let rhs_s = lower_expr_range(ctx, tokens, st_s, st_e, file, false).trim()
      acc = acc + " |> " + rhs_s
    } else {
      let callee_s = lower_expr_range(ctx, tokens, st_s, open_p, file, false).trim()
      let p_tmp = fresh_temp(ctx, "p")
      let sb = StringBuilder()
      sb.write_string("{ let " + p_tmp + " = " + acc + "; ")
      let call_args : Array[String] = []
      let mut ai = open_p + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae == ai + 1 && tokens[ai].kind == TokenKind::Underscore {
          call_args.push(p_tmp)
        } else if ae == ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          let lbl = rename_keyword_ident(tokens[ai].raw)
          let a_tmp = fresh_temp(ctx, "pa")
          sb.write_string("let " + a_tmp + " = " + lbl + "; ")
          call_args.push(lbl + "=" + a_tmp)
        } else if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = rename_keyword_ident(tokens[ai].raw)
          let a_tmp = fresh_temp(ctx, "pa")
          let a_expr = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          sb.write_string("let " + a_tmp + " = " + a_expr + "; ")
          call_args.push(lbl + "=" + a_tmp)
        } else {
          let a_tmp = fresh_temp(ctx, "pa")
          let a_expr = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          sb.write_string("let " + a_tmp + " = " + a_expr + "; ")
          call_args.push(a_tmp)
        }
        ai = ae + 1
      }
      sb.write_string(callee_s + "(" + join_comma(call_args) + ") }")
      acc = sb.to_string()
    }
    pi = pi + 1
  }
  Some((tokens[i].leading_trivia + acc, expr_end))
}

///| Expand a pattern containing `|` inside parens: `(A | B)` -> `A | B`, `Ctor(A | B)` -> `Ctor(A) | Ctor(B)`.
fn expand_or_is_pattern(ctx : StageAContext, tokens : Array[Token], start : Int, end : Int, file : String) -> String {
  if start >= end {
    return ""
  }
  // Case 1: `(A | B | ...)`
  if tokens[start].kind == TokenKind::LParen && find_matching_delim(tokens, start) == end - 1 {
    return lower_expr_range(ctx, tokens, start + 1, end - 1, file, true).trim()
  }
  // Case 2: `Ctor(A | B)` -> `Ctor(A) | Ctor(B)`
  if tokens[start].kind == TokenKind::UpperIdent && start + 1 < end &&
  tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1 {
    let head = lower_expr_range(ctx, tokens, start, start + 1, file, true).trim()
    let open_p = start + 1
    let close_p = end - 1
    let alts : Array[String] = []
    let mut cur = open_p + 1
    let mut i = open_p + 1
    let mut d = 0
    while i < close_p {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Pipe {
        let part = lower_expr_range(ctx, tokens, cur, i, file, true).trim()
        alts.push(head + "(" + part + ")")
        cur = i + 1
      }
      i = i + 1
    }
    if cur < close_p {
      let part = lower_expr_range(ctx, tokens, cur, close_p, file, true).trim()
      alts.push(head + "(" + part + ")")
    }
    if alts.length() > 1 {
      let sb = StringBuilder()
      let mut ai = 0
      while ai < alts.length() {
        if ai > 0 { sb.write_string(" | ") }
        sb.write_string(alts[ai])
        ai = ai + 1
      }
      return sb.to_string()
    }
  }
  lower_expr_range(ctx, tokens, start, end, file, true).trim()
}

///| Lower `<lhs> is <or_pat>` (where `<or_pat>` contains `|`, e.g. `x is (A | B)` or `x is Some(A | B)`)
///| into `(match <lhs> { <expanded_pat> => true, _ => false })` because Pion `is` does not accept `|` patterns.
fn try_lower_or_is_expr(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  // Scan forward through a single postfix/primary `<lhs>` to see if `is` immediately follows at depth 0
  let mut k = i
  let mut d = 0
  let mut is_idx = -1
  while k < end {
    let tk = tokens[k].kind
    if d == 0 && k > i && tokens[k].newline_before {
      break
    }
    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      if d == 0 && tk == TokenKind::LBrace { break }
      d = d + 1
    } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      if d == 0 { break }
      d = d - 1
    } else if d == 0 {
      if tk == TokenKind::Keyword && tokens[k].raw == "is" {
        is_idx = k
        break
      }
      if tk == TokenKind::AmpAmp || tk == TokenKind::PipePipe || tk == TokenKind::Comma ||
      tk == TokenKind::Semi || tk == TokenKind::Eq || tk == TokenKind::EqEq || tk == TokenKind::BangEq ||
      tk == TokenKind::FatArrow || tk == TokenKind::PipeGt {
        break
      }
    }
    k = k + 1
  }
  if is_idx <= i || is_idx + 1 >= end {
    return None
  }
  // Find end of pattern after `is`
  let mut pat_end = is_idx + 1
  let mut pd = 0
  let mut has_pipe = false
  let mut has_struct_pat = false
  let mut has_array_pat = false
  while pat_end < end {
    let pk = tokens[pat_end].kind
    if pd == 0 && pat_end > is_idx + 1 && tokens[pat_end].newline_before {
      break
    }
    if pk == TokenKind::Pipe {
      has_pipe = true
    }
    if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
      if pd == 0 && pk == TokenKind::LBrace && !(pat_end > is_idx + 1 && tokens[pat_end - 1].kind == TokenKind::ColonColon) {
        break
      }
      if pd > 0 && pk == TokenKind::LBrace {
        has_struct_pat = true
      }
      if pd > 0 && pk == TokenKind::LBracket {
        has_array_pat = true
      }
      pd = pd + 1
    } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
      if pd == 0 { break }
      pd = pd - 1
    } else if pd == 0 && (pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::Comma || pk == TokenKind::Semi || pk == TokenKind::EqEq || pk == TokenKind::BangEq || (pk == TokenKind::Keyword && tokens[pat_end].raw == "else")) {
      break
    }
    pat_end = pat_end + 1
  }
  if !has_pipe && !has_struct_pat && !has_array_pat {
    return None
  }
  let lhs_str = lower_expr_range(ctx, tokens, i, is_idx, file, false).trim()
  if has_array_pat {
    let p_start = is_idx + 1
    if p_start + 1 < pat_end && (tokens[p_start].kind == TokenKind::UpperIdent || tokens[p_start].kind == TokenKind::Dot) {
      let mut open_p = p_start + 1
      if tokens[p_start].kind == TokenKind::Dot && open_p + 1 < pat_end { open_p = p_start + 2 }
      if open_p < pat_end && tokens[open_p].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, open_p)
        if open_p + 1 < close_p && tokens[open_p + 1].kind == TokenKind::LBracket {
          let close_br = find_matching_delim(tokens, open_p + 1)
          let ctor_head = lower_expr_range(ctx, tokens, p_start, open_p, file, true).trim()
          let tmp_a = fresh_temp(ctx, "isa")
          let elem_wilds : Array[String] = []
          let mut ei = open_p + 2
          while ei < close_br {
            if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
            let mut ee = ei
            let mut ed = 0
            while ee < close_br {
              let ek = tokens[ee].kind
              if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
              else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
              else if ed == 0 && ek == TokenKind::Comma { break }
              ee = ee + 1
            }
            elem_wilds.push(wildcard_pattern_str(ctx, tokens, ei, ee, file))
            ei = ee + 1
          }
          let csb = StringBuilder()
          csb.write_string(tmp_a + ".length() == " + elem_wilds.length().to_string())
          let mut idx = 0
          while idx < elem_wilds.length() {
            csb.write_string(" && (" + tmp_a + "[" + idx.to_string() + "] is " + elem_wilds[idx] + ")")
            idx = idx + 1
          }
          return Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + ctor_head + "(" + tmp_a + ") => (" + csb.to_string() + "), _ => false })", pat_end))
        }
      }
    }
    return None
  }
  if has_struct_pat {
    // Lower pure-predicate `<lhs> is Ctor({ f1: p1, .. })` and `<lhs> is (None | Some({ f1: p1, .. }))`
    // via recursive struct-pattern peeling into `(match <lhs> { ..., _ => false })`.
    // Fail closed if the pattern introduces any variable binder (which a `(match ...)` wrapper would swallow).
    let mut ps = is_idx + 1
    let mut pe = pat_end
    while ps + 1 < pe && tokens[ps].kind == TokenKind::LParen && find_matching_delim(tokens, ps) == pe - 1 {
      ps = ps + 1
      pe = pe - 1
    }
    let mut has_var_binder = false
    let mut vk = ps
    while vk < pe {
      if tokens[vk].kind == TokenKind::Ident && tokens[vk].raw != "_" &&
      !(vk > ps && (tokens[vk - 1].kind == TokenKind::Dot || tokens[vk - 1].kind == TokenKind::ColonColon)) &&
      !(vk + 1 < pe && tokens[vk + 1].kind == TokenKind::Colon) {
        has_var_binder = true
        break
      }
      vk = vk + 1
    }
    if has_var_binder {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[vk].line,
        tokens[vk].col,
        "struct pattern with variable bindings in `is` expression is not supported",
      ))
      return None
    }
    let lhs_ty_sp = infer_simple_expr_type(ctx, tokens, i, is_idx)
    if lhs_ty_sp.length() > 0 {
      push_expected_type(ctx, lhs_ty_sp)
    }
    let arms : Array[String] = []
    let mut bi = ps
    let mut ok_all = true
    while bi < pe {
      let mut be = bi
      let mut bd = 0
      while be < pe {
        let bk = tokens[be].kind
        if bk == TokenKind::LParen || bk == TokenKind::LBracket || bk == TokenKind::LBrace { bd = bd + 1 }
        else if bk == TokenKind::RParen || bk == TokenKind::RBracket || bk == TokenKind::RBrace { if bd > 0 { bd = bd - 1 } }
        else if bd == 0 && bk == TokenKind::Pipe { break }
        be = be + 1
      }
      if be > bi {
        if pattern_contains_struct_pat(tokens, bi, be) {
          let (outer_p, obls) = peel_struct_patterns_in_pat(ctx, tokens, bi, be, file)
          if obls.length() > 0 {
            let (full_g, _) = expand_struct_pat_obligations(ctx, tokens, obls, 0, file, "", "true")
            arms.push(outer_p.trim() + " if (" + full_g + ") => true")
          } else {
            ok_all = false
            break
          }
        } else {
          let ps_s = lower_expr_range(ctx, tokens, bi, be, file, true).trim()
          arms.push(ps_s + " => true")
        }
      }
      bi = be + 1
    }
    if lhs_ty_sp.length() > 0 {
      pop_expected_type(ctx)
    }
    if ok_all && arms.length() > 0 {
      return Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + join_comma(arms) + ", _ => false })", pat_end))
    }
    return None
  }
  let lhs_ty0 = infer_simple_expr_type(ctx, tokens, i, is_idx)
  let lhs_ty = if lhs_ty0.length() > 0 { lhs_ty0 } else { infer_or_is_pattern_enum_f3d2(ctx, tokens, is_idx + 1, pat_end) }
  let saved_exp_is = ctx.expected_type_stack.length()
  if lhs_ty.length() > 0 {
    push_expected_type(ctx, lhs_ty)
  }
  let pat_str = expand_or_is_pattern(ctx, tokens, is_idx + 1, pat_end, file)
  restore_expected_type_stack(ctx, saved_exp_is)
  Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + pat_str + " => true, _ => false })", pat_end))
}

///| Lower a struct pattern `{ f1: p1, f2: { g: p2, .. }, .. }` against bound variable `var_name`
///| into a boolean guard expression `var_name.f1 is p1 && var_name.f2.g == p2`.
fn lower_struct_pat_guards(
  ctx : StageAContext,
  var_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let parts : Array[String] = []
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma || tokens[i].kind == TokenKind::DotDot {
      i = i + 1
      continue
    }
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    i + 1 < e && tokens[i + 1].kind == TokenKind::Colon {
      let fname = rename_keyword_ident(tokens[i].raw)
      let fexpr = var_name + "." + fname
      let vs = i + 2
      if vs < e && tokens[vs].kind == TokenKind::LBrace {
        let cb = find_matching_delim(tokens, vs)
        let nested = lower_struct_pat_guards(ctx, fexpr, tokens, vs, cb, file)
        if nested.length() > 0 { parts.push(nested) }
      } else if vs < e {
        let vt = tokens[vs]
        if vs + 1 == e && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
          vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
          parts.push(fexpr + " == " + vt.raw)
        } else {
          let ps = lower_expr_range(ctx, tokens, vs, e, file, true).trim()
          if ps != "_" {
            parts.push("(" + fexpr + " is " + ps + ")")
          }
        }
      }
    }
    i = e + 1
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < parts.length() {
    if k > 0 { sb.write_string(" && ") }
    sb.write_string(parts[k])
    k = k + 1
  }
  sb.to_string()
}

///| Lower an expression range `[start, end)`.
pub fn lower_expr_range(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
  in_pattern : Bool,
) -> String {
  if !in_pattern && start < end {
    match try_lower_placeholder_pipe_chain(ctx, tokens, start, end, file) {
      Some((pipe_code, next_i)) =>
      if next_i >= end {
        return pipe_code
      } else {
        return pipe_code + lower_expr_range(ctx, tokens, next_i, end, file, false)
      }
      None => ()
    }
  }
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, end, file, in_pattern)
    sb.write_string(piece)
    i = next_i
  }
  sb.to_string()
}

///| Map allowlisted raising `@pkg.fn` calls to their non-panicking `Result` helpers for controlled `catch`.
///| Uses `is_moonbit_core_pkg` so user packages aliased as `@string` / `@json` / `@utf8` are NEVER hijacked!
fn lookup_controlled_catch_result_fn(symtab : SymbolTable, raw_pkg : String, sym_raw : String) -> String {
  if is_moonbit_core_pkg(symtab, raw_pkg, "json") && sym_raw == "parse" {
    return "mbt_compat::mbt_json_parse"
  }
  if is_moonbit_core_pkg(symtab, raw_pkg, "encoding/utf8") && sym_raw == "decode" {
    return "mbt_compat::utf8_decode_strict"
  }
  if (is_moonbit_core_pkg(symtab, raw_pkg, "string") || is_moonbit_core_pkg(symtab, raw_pkg, "strconv")) && sym_raw == "parse_int" {
    return "mbt_compat::str_try_parse_int"
  }
  if (is_moonbit_core_pkg(symtab, raw_pkg, "string") || is_moonbit_core_pkg(symtab, raw_pkg, "strconv")) && sym_raw == "parse_double" {
    return "mbt_compat::str_try_parse_double"
  }
  ""
}

///| Lower a controlled `catch` block `{ <arms> }` attached to an allowlisted Result-returning call:
///| - `@json.parse(e) catch { _ => fallback }` -> `match mbt_compat::mbt_json_parse(e) { Ok(__ok) => __ok, Err(_) => fallback }`
///| - `Some(@utf8.decode(b)) catch { _ => None }` -> `match mbt_compat::utf8_decode_strict(b) { Ok(__ok) => Some(__ok), Err(_) => None }`
fn try_lower_controlled_catch(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let trivia = tokens[i].leading_trivia
  let mut wrap_ctor = ""
  let mut pkg_i = -1
  let mut after_call = -1
  if tokens[i].kind == TokenKind::PkgRef && i + 3 < end &&
  tokens[i + 1].kind == TokenKind::Dot && tokens[i + 3].kind == TokenKind::LParen {
    pkg_i = i
    after_call = find_matching_delim(tokens, i + 3) + 1
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 5 < end && tokens[i + 1].kind == TokenKind::LBrace {
    // Controlled `try { @pkg.fn(args) } catch { <arms> }` or `try { Ctor(@pkg.fn(args)) } catch { <arms> }`
    let try_rb = find_matching_delim(tokens, i + 1)
    let mut inner_s = i + 2
    while inner_s < try_rb && tokens[inner_s].kind == TokenKind::Semi {
      inner_s = inner_s + 1
    }
    let mut inner_e = try_rb
    while inner_e > inner_s && tokens[inner_e - 1].kind == TokenKind::Semi {
      inner_e = inner_e - 1
    }
    if inner_s + 3 < inner_e && tokens[inner_s].kind == TokenKind::PkgRef &&
    tokens[inner_s + 1].kind == TokenKind::Dot && tokens[inner_s + 3].kind == TokenKind::LParen &&
    find_matching_delim(tokens, inner_s + 3) + 1 == inner_e {
      pkg_i = inner_s
      after_call = try_rb + 1
    } else if inner_s + 5 < inner_e && tokens[inner_s].kind == TokenKind::UpperIdent &&
    tokens[inner_s + 1].kind == TokenKind::LParen &&
    tokens[inner_s + 2].kind == TokenKind::PkgRef &&
    tokens[inner_s + 3].kind == TokenKind::Dot &&
    tokens[inner_s + 5].kind == TokenKind::LParen {
      let outer_rp = find_matching_delim(tokens, inner_s + 1)
      let inner_rp = find_matching_delim(tokens, inner_s + 5)
      if outer_rp + 1 == inner_e && inner_rp + 1 == outer_rp {
        wrap_ctor = tokens[inner_s].raw
        pkg_i = inner_s + 2
        after_call = try_rb + 1
      }
    }
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 4 < end && tokens[i + 1].kind == TokenKind::PkgRef &&
  tokens[i + 2].kind == TokenKind::Dot && tokens[i + 4].kind == TokenKind::LParen {
    // Brace-less `try @pkg.fn(args) catch { _ => ... }`
    pkg_i = i + 1
    after_call = find_matching_delim(tokens, i + 4) + 1
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 6 < end && tokens[i + 1].kind == TokenKind::UpperIdent &&
  tokens[i + 2].kind == TokenKind::LParen &&
  tokens[i + 3].kind == TokenKind::PkgRef &&
  tokens[i + 4].kind == TokenKind::Dot &&
  tokens[i + 6].kind == TokenKind::LParen {
    // Brace-less `try Some(@json.parse(s)) catch { _ => None }`
    let outer_rp = find_matching_delim(tokens, i + 2)
    let inner_rp = find_matching_delim(tokens, i + 6)
    if inner_rp + 1 == outer_rp {
      wrap_ctor = tokens[i + 1].raw
      pkg_i = i + 3
      after_call = outer_rp + 1
    }
  } else if tokens[i].kind == TokenKind::UpperIdent && i + 5 < end &&
  tokens[i + 1].kind == TokenKind::LParen &&
  tokens[i + 2].kind == TokenKind::PkgRef &&
  tokens[i + 3].kind == TokenKind::Dot &&
  tokens[i + 5].kind == TokenKind::LParen {
    let outer_rp = find_matching_delim(tokens, i + 1)
    let inner_rp = find_matching_delim(tokens, i + 5)
    if inner_rp + 1 == outer_rp {
      wrap_ctor = tokens[i].raw
      pkg_i = i + 2
      after_call = outer_rp + 1
    }
  }
  if pkg_i < 0 || after_call < 0 || after_call + 1 >= end {
    return None
  }
  if !((tokens[after_call].kind == TokenKind::Keyword || tokens[after_call].kind == TokenKind::Ident) &&
    tokens[after_call].raw == "catch" && tokens[after_call + 1].kind == TokenKind::LBrace) {
    return None
  }
  let raw_pkg = tokens[pkg_i].raw.slice(1, tokens[pkg_i].raw.length())
  let sym_raw = tokens[pkg_i + 2].raw
  let res_fn = lookup_controlled_catch_result_fn(ctx.symtab, raw_pkg, sym_raw)
  if res_fn.length() == 0 {
    return None
  }
  let call_lp = pkg_i + 3
  let call_rp = find_matching_delim(tokens, call_lp)
  let raw_call_str = lower_call_args(ctx, tokens, call_lp, call_rp, file, tokens[pkg_i].line, tokens[pkg_i].col, res_fn, false, false)
  let call_str = if res_fn == "mbt_compat::str_try_parse_int" && str_has(raw_call_str, "base=") {
    raw_call_str.replace(", base=", ", radix=")
  } else {
    raw_call_str
  }
  let catch_lb = after_call + 1
  let catch_rb = find_matching_delim(tokens, catch_lb)
  let ok_var = fresh_temp(ctx, "ok")
  let ok_expr = if wrap_ctor.length() > 0 { wrap_ctor + "(" + ok_var + ")" } else { ok_var }
  // Fast path: single wildcard arm `_ => <fallback>`
  let mut arm_s = catch_lb + 1
  while arm_s < catch_rb && (tokens[arm_s].kind == TokenKind::Semi || tokens[arm_s].kind == TokenKind::Comma) {
    arm_s = arm_s + 1
  }
  let mut is_single_wild = false
  if arm_s + 1 < catch_rb && tokens[arm_s].kind == TokenKind::Underscore && tokens[arm_s + 1].kind == TokenKind::FatArrow {
    // Check there is no second top-level `=>` inside `{ ... }`
    let mut k = arm_s + 2
    let mut d = 0
    let mut second_arm = false
    while k < catch_rb {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && kk == TokenKind::FatArrow { second_arm = true; break }
      k = k + 1
    }
    if !second_arm {
      is_single_wild = true
    }
  }
  if is_single_wild {
    let mut fb_end = catch_rb
    while fb_end > arm_s + 2 && (tokens[fb_end - 1].kind == TokenKind::Semi || tokens[fb_end - 1].kind == TokenKind::Comma) {
      fb_end = fb_end - 1
    }
    let fb_str = lower_expr_range(ctx, tokens, arm_s + 2, fb_end, file, false).trim()
    return Some((trivia + "match " + call_str + " { Ok(" + ok_var + ") => " + ok_expr + ", Err(_) => " + fb_str + " }", catch_rb + 1))
  }
  // P1-2 + Opus P2-1: Controlled `catch` that binds or matches the error value MUST fail closed
  // (never silently substitute a fake `String` error where MoonBit yields `Failure`/`ParseError`).
  ctx.diags.push(diag_error(
    "MBT2PION_UNSUPPORTED_SYNTAX",
    file,
    tokens[catch_lb].line,
    tokens[catch_lb].col,
    "controlled `catch` only supports wildcard `_ => <fallback>` (binding or matching error values requires an overlay)",
  ))
  Some((trivia + "MBT2PION_MANUAL", catch_rb + 1))
}

///| Find a top-level `:` inside `[open_br .. close_br]`, returning its index or `-1`.
fn find_slice_colon(tokens : Array[Token], open_br : Int, close_br : Int) -> Int {
  let mut k = open_br + 1
  let mut d = 0
  while k < close_br {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
    else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
    else if d == 0 && kk == TokenKind::Colon { return k }
    k = k + 1
  }
  -1
}

///| General postfix slice lowering for ANY receiver expression:
///| `f(x)[:]`, `@pkg.f(x)[lo:hi]`, `a.b().c[lo:]`, `[1, 2, 3][:]`, `(expr)[lo:hi]`, `arr[0][1:]`.
///| Evaluates complex receivers strictly ONCE when `hi` is omitted via a hygienic temp binding.
fn try_lower_general_postfix_slice(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  if i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon) {
    return None
  }
  let t = tokens[i]
  let mut cur = -1
  if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::ByteStringLit {
    cur = i + 1
  } else if t.kind == TokenKind::PkgRef {
    if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
      cur = i + 3
    } else {
      return None
    }
  } else if t.kind == TokenKind::LParen {
    if is_arrow_fn_at(tokens, i, end) >= 0 {
      return None
    }
    cur = find_matching_delim(tokens, i) + 1
  } else if t.kind == TokenKind::LBracket {
    cur = find_matching_delim(tokens, i) + 1
  } else {
    return None
  }
  let mut slice_br = -1
  let mut slice_colon = -1
  while cur < end {
    let ck = tokens[cur].kind
    if ck == TokenKind::LBracket && !tokens[cur].newline_before {
      let cbr = find_matching_delim(tokens, cur)
      let col_i = find_slice_colon(tokens, cur, cbr)
      if col_i >= 0 {
        slice_br = cur
        slice_colon = col_i
        break
      }
      cur = cbr + 1
    } else if ck == TokenKind::LParen && !tokens[cur].newline_before {
      cur = find_matching_delim(tokens, cur) + 1
    } else if ck == TokenKind::Dot && cur + 1 < end &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::IntLit) {
      cur = cur + 2
    } else if ck == TokenKind::ColonColon && cur + 1 < end &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::UpperIdent) {
      cur = cur + 2
    } else {
      break
    }
  }
  if slice_br < 0 {
    return None
  }
  // Leave bare `ident[lo:hi]` to the dedicated `Ident` handler (which also checks `borrowed_bufs`/`borrowed_views`).
  if t.kind == TokenKind::Ident && slice_br == i + 1 {
    return None
  }
  let trivia = t.leading_trivia
  let outer_owned_exempt = ctx.direct_owned_slice_arg
  ctx.direct_owned_slice_arg = false
  let allow_interp_top = ctx.in_interp_top
  ctx.in_interp_top = false
  let mut recv_str = lower_expr_range(ctx, tokens, i, slice_br, file, false).trim()
  let mut cur_br = slice_br
  let mut cur_col = slice_colon
  let mut final_next = cur_br
  while cur_br >= 0 {
    let close_br = find_matching_delim(tokens, cur_br)
    let lo = if cur_col > cur_br + 1 {
      lower_expr_range(ctx, tokens, cur_br + 1, cur_col, file, false).trim()
    } else {
      "0"
    }
    let has_hi = close_br > cur_col + 1
    let has_chained_slice = close_br + 1 < end && tokens[close_br + 1].kind == TokenKind::LBracket &&
    !tokens[close_br + 1].newline_before &&
    find_slice_colon(tokens, close_br + 1, find_matching_delim(tokens, close_br + 1)) >= 0
    let (helper, next_after, extra_arg) = classify_slice_consumer(
      ctx,
      tokens,
      close_br,
      end,
      outer_owned_exempt,
      has_chained_slice,
      allow_interp_top,
      if t.kind == TokenKind::Ident { t.raw } else { "" },
      file,
    )
    let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
    if has_hi {
      let hi = lower_expr_range(ctx, tokens, cur_col + 1, close_br, file, false).trim()
      if helper == "mbt_compat::__mbt_slice_borrow" && cur_br == slice_br && !is_plain_field_path(tokens, i, slice_br) {
        // Bind a computed receiver (not a plain `a.b.c` path, which can never be fresh) to a hygienic temp, as the
        // open-ended form does, so Stage B lowers it
        // as a plain `let` initializer and Stage A.5 can prove it fresh (`slice_temp_bound_fresh`). MoonBit
        // evaluates the receiver before the bounds, so the order is unchanged.
        let sl_var = fresh_temp(ctx, "sl")
        recv_str = "({ let " + sl_var + " = " + recv_str + "; " + helper + "(" + sl_var + ", " + lo + ", " + hi + extra_tail + ") })"
      } else {
        recv_str = helper + "(" + recv_str + ", " + lo + ", " + hi + extra_tail + ")"
      }
    } else {
      let sl_var = fresh_temp(ctx, "sl")
      recv_str = "({ let " + sl_var + " = " + recv_str + "; " + helper + "(" + sl_var + ", " + lo + ", " + sl_var + ".length()" + extra_tail + ") })"
    }
    final_next = next_after
    // Handle chained slices like `f(x)[:][1:]`
    if final_next < end && tokens[final_next].kind == TokenKind::LBracket && !tokens[final_next].newline_before {
      let next_cbr = find_matching_delim(tokens, final_next)
      let next_col = find_slice_colon(tokens, final_next, next_cbr)
      if next_col >= 0 {
        cur_br = final_next
        cur_col = next_col
        continue
      }
    }
    break
  }
  Some((trivia + recv_str, final_next))
}

///| Lower one token or compound syntactic form starting at `i` within `[i, end)`.
///| Returns `(lowered_text, next_token_index)`.
fn lower_one_token_or_form(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
  in_pattern : Bool,
) -> (String, Int) {
  let t = tokens[i]
  let trivia = t.leading_trivia

  // 0a. Controlled `catch` expressions on allowlisted Result-returning stdlib calls
  if !in_pattern {
    match try_lower_controlled_catch(ctx, tokens, i, end, file) {
      Some((ccode, next_i)) => return (ccode, next_i)
      None => ()
    }
  }

  // 0b. General postfix slice `expr[lo:hi]` / `expr[:]` / `expr[lo:]` on complex receivers
  if !in_pattern {
    match try_lower_general_postfix_slice(ctx, tokens, i, end, file) {
      Some((scode, next_i)) => return (scode, next_i)
      None => ()
    }
  }

  // 0. `<lhs> is (<Pat1> | <Pat2>)` or `<lhs> is Ctor(<Pat1> | <Pat2>)` -> `(match <lhs> { ... => true, _ => false })`
  if !in_pattern && (t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent || t.kind == TokenKind::LParen) {
    match try_lower_or_is_expr(ctx, tokens, i, end, file) {
      Some((mcode, next_i)) => return (mcode, next_i)
      None => ()
    }
  }

  // 1. Interpolated string `"..."` or `$|...`
  if t.kind == TokenKind::InterpString {
    let ls = lower_interp_string(ctx, t.raw, false, file)
    if !in_pattern && is_expected_mbt_json(ctx) && !prev_tok_breaks_json_lit(tokens, i) && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::String(" + ls + ")", i + 1)
    }
    return (trivia + ls, i + 1)
  }
  if t.kind == TokenKind::InterpMultiline || t.kind == TokenKind::RawMultiline {
    match lower_multiline_group(ctx, tokens, i, end, file) {
      Some((s_out, next_i)) => return (trivia + s_out, next_i)
      None => ()
    }
  }
  if t.kind == TokenKind::InterpMultiline {
    return (trivia + lower_interp_string(ctx, t.raw, true, file), i + 1)
  }
  // Plain string literal `"..."`: merge UTF-16 surrogate pairs & wrap under expected `MbtJson`
  if t.kind == TokenKind::StringLit {
    let fixed_s = lower_mbt_string_surrogates(t.raw, file, t.line, t.col, ctx.diags)
    if !in_pattern && is_expected_mbt_json(ctx) && !prev_tok_breaks_json_lit(tokens, i) && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::String(" + fixed_s + ")", i + 1)
    }
    return (trivia + fixed_s, i + 1)
  }
  // `..<=` inclusive range: strictly inside `for` loop headers -> `..=`, fail-closed elsewhere!
  if t.kind == TokenKind::DotDotLtEq {
    if !in_pattern && ctx.in_for_header {
      return (trivia + "..=", i + 1)
    }
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "inclusive range `..<=` is only supported in `for` loop headers",
    ))
    return (trivia + "..=", i + 1)
  }
  // Recursive MoonBit JSON literals under expected `mbt_compat::MbtJson`
  if !in_pattern && is_expected_mbt_json(ctx) && !prev_tok_breaks_json_lit(tokens, i) {
    if t.kind == TokenKind::Keyword && t.raw == "true" && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::True", i + 1)
    }
    if t.kind == TokenKind::Keyword && t.raw == "false" && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::False", i + 1)
    }
    if t.kind == TokenKind::Ident && t.raw == "null" &&
    !(i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
    !(lookup_scope_var(ctx, "null") is Some(_)) && !ctx.symtab.local_value_names.contains("null") &&
    !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::Null", i + 1)
    }
    if t.kind == TokenKind::Minus && i + 1 < end &&
    (tokens[i + 1].kind == TokenKind::IntLit || tokens[i + 1].kind == TokenKind::FloatLit) &&
    !next_tok_breaks_json_lit(tokens, i + 2, end) {
      return (trivia + lower_json_number_lit(ctx, true, tokens[i + 1].raw, tokens[i + 1].kind == TokenKind::FloatLit, file, t.line, t.col), i + 2)
    }
    if (t.kind == TokenKind::IntLit || t.kind == TokenKind::FloatLit) &&
    !(i > 0 && tokens[i - 1].kind == TokenKind::Dot) &&
    !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + lower_json_number_lit(ctx, false, t.raw, t.kind == TokenKind::FloatLit, file, t.line, t.col), i + 1)
    }
  }
  // Raw multiline `#|...` is Pion-native: preserve verbatim (minus a CRLF line's trailing `\r`, which MoonBit
  // does not keep in the string).
  if t.kind == TokenKind::RawMultiline {
    return (trivia + strip_trailing_cr(t.raw), i + 1)
  }
  // Byte string `b"..."` & byte char `b'x'`
  if t.kind == TokenKind::ByteStringLit {
    return (trivia + lower_byte_string(t.raw), i + 1)
  }
  if t.kind == TokenKind::ByteCharLit {
    return (trivia + lower_byte_char(t.raw), i + 1)
  }

  // 1a. Fail-loud on unsupported MoonBit error-handling keywords (`raise`, `noraise`, `try`, `catch`) (#12a P1-2)
  if is_unsupported_error_kw(t) && !(i > 0 && tokens[i - 1].kind == TokenKind::Dot) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "unsupported MoonBit error-handling syntax `" + t.raw + "` (requires explicit lowering or overlay)",
    ))
    return (trivia + t.raw, i + 1)
  }

  // 1b. Local `let` with tuple destructuring `let (a, b) [: (T0, T1)] = expr`
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, i + 1)
    let mut tup_eq_i = -1
    let mut tup_ann_ty = ""
    if cp + 1 < end && tokens[cp + 1].kind == TokenKind::Eq {
      tup_eq_i = cp + 1
    } else if cp + 2 < end && tokens[cp + 1].kind == TokenKind::Colon {
      let mut scan = cp + 2
      let mut sd = 0
      while scan < end {
        let sk = tokens[scan].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { sd = sd + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
        else if sd == 0 && sk == TokenKind::Eq { tup_eq_i = scan; break }
        scan = scan + 1
      }
      if tup_eq_i > cp + 2 {
        tup_ann_ty = lower_type_tokens_checked(ctx, tokens, cp + 2, tup_eq_i, file).trim()
      }
    }
    if tup_eq_i > cp {
      // Check if there is any nested `(` inside `( ... )`
      let mut has_nested = false
      let mut nk = i + 2
      while nk < cp {
        if tokens[nk].kind == TokenKind::LParen { has_nested = true; break }
        nk = nk + 1
      }
      if has_nested {
        let rhs_end = find_expr_end(tokens, tup_eq_i + 1, end)
        let rhs_s = lower_expr_range(ctx, tokens, tup_eq_i + 1, rhs_end, file, false).trim()
        let raw_b = collect_raw_pattern_binders(tokens, i + 1, cp + 1)
        let tup_rn = compute_scoped_binder_renames(ctx, raw_b)
        if tup_rn.length() > 0 {
          ctx.ident_renames.push(tup_rn)
        }
        let outer_vars : Array[String] = []
        let inner_lets : Array[String] = []
        let mut ai = i + 2
        while ai < cp {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < cp {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if tokens[ai].kind == TokenKind::LParen && ae - 1 == find_matching_delim(tokens, ai) {
            let tv = fresh_temp(ctx, "tup")
            outer_vars.push(tv)
            let inner_pat = lower_expr_range(ctx, tokens, ai, ae, file, true).trim()
            inner_lets.push("let " + inner_pat + " = " + tv)
          } else {
            outer_vars.push(lower_expr_range(ctx, tokens, ai, ae, file, true).trim())
          }
          ai = ae + 1
        }
        let sb = StringBuilder()
        let ty_part = if tup_ann_ty.length() > 0 { " : " + tup_ann_ty } else { "" }
        sb.write_string(trivia + "let (" + join_comma(outer_vars) + ")" + ty_part + " = " + rhs_s)
        for il in inner_lets {
          sb.write_string("; " + il)
        }
        let rhs_ty_nest = if tup_ann_ty.length() > 0 { tup_ann_ty } else { infer_simple_expr_type(ctx, tokens, tup_eq_i + 1, rhs_end).trim() }
        if rhs_ty_nest.length() > 0 {
          register_tuple_pattern_types_f3d2(ctx, tokens, i + 1, cp + 1, rhs_ty_nest)
        } else {
          for rb in raw_b {
            ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
          }
        }
        return (sb.to_string(), rhs_end)
      } else {
        // Single-level tuple destructuring `let (a, b) [: (T0, T1)] = rhs`: lower RHS first, then register binders with inferred element types!
        let rhs_end = find_expr_end(tokens, tup_eq_i + 1, end)
        let rhs_ty = if tup_ann_ty.length() > 0 { tup_ann_ty } else { infer_simple_expr_type(ctx, tokens, tup_eq_i + 1, rhs_end).trim() }
        let saved_tup_exp = ctx.expected_type_stack.length()
        push_expected_type(ctx, tup_ann_ty)
        let rhs_s = lower_expr_range(ctx, tokens, tup_eq_i + 1, rhs_end, file, false)
        restore_expected_type_stack(ctx, saved_tup_exp)
        let raw_b = collect_raw_pattern_binders(tokens, i + 1, cp + 1)
        let tup_rn = compute_scoped_binder_renames(ctx, raw_b)
        if tup_rn.length() > 0 {
          ctx.ident_renames.push(tup_rn)
        }
        let pat_s = lower_expr_range(ctx, tokens, i + 1, cp + 1, file, true)
        let ty_part = if tup_ann_ty.length() > 0 { " : " + tup_ann_ty } else { "" }
        let elem_tys : Array[String] = []
        if rhs_ty.starts_with("(") && rhs_ty.ends_with(")") {
          let inner_t = rhs_ty.slice(1, rhs_ty.length() - 1)
          let mut si = 0
          let mut sstart = 0
          let mut sd = 0
          while si < inner_t.length() {
            let ch = inner_t.code_unit_at(si)
            if ch == 40 || ch == 91 || ch == 123 { sd = sd + 1 }
            else if ch == 41 || ch == 93 || ch == 125 { if sd > 0 { sd = sd - 1 } }
            else if sd == 0 && ch == 44 {
              elem_tys.push(inner_t.slice(sstart, si).trim())
              sstart = si + 1
            }
            si = si + 1
          }
          elem_tys.push(inner_t.slice(sstart, inner_t.length()).trim())
        }
        if elem_tys.length() > 0 {
          let mut ti = i + 2
          let mut tidx = 0
          while ti < cp {
            if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
            let mut te = ti
            let mut td = 0
            while te < cp {
              let tk = tokens[te].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
              else if td == 0 && tk == TokenKind::Comma { break }
              te = te + 1
            }
            let ety = if tidx < elem_tys.length() { elem_tys[tidx] } else { "" }
            if te == ti + 1 && tokens[ti].kind == TokenKind::Ident && tokens[ti].raw != "_" {
              ctx.scope_vars.push(ScopeVar::{
                name: resolve_ident_in_scope(ctx, tokens[ti].raw),
                ty: ety,
                is_mut: false,
                is_boxed: false,
              })
            } else {
              for rb in collect_raw_pattern_binders(tokens, ti, te) {
                ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
              }
            }
            tidx = tidx + 1
            ti = te + 1
          }
        } else {
          for rb in raw_b {
            ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
          }
        }
        return (trivia + "let" + pat_s + ty_part + tokens[tup_eq_i].leading_trivia + "=" + rhs_s, rhs_end)
      }
    }
  }

  // 1b1. Local `let { f1: v1, f2, .. } = expr` struct destructuring -> temp binding + field lets
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace {
    let cb = find_matching_delim(tokens, i + 1)
    if cb + 1 < end && tokens[cb + 1].kind == TokenKind::Eq {
      let rhs_end = find_expr_end(tokens, cb + 2, end)
      let rhs_s = lower_expr_range(ctx, tokens, cb + 2, rhs_end, file, false).trim()
      let tmp_s = fresh_temp(ctx, "ds")
      let sb = StringBuilder()
      sb.write_string(trivia + "let " + tmp_s + " = " + rhs_s)
      let mut fi = i + 2
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
          fi = fi + 1
          continue
        }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) {
          let fname = rename_keyword_ident(tokens[fi].raw)
          if fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
            let pat_s = lower_expr_range(ctx, tokens, fi + 2, fe, file, true).trim()
            if pat_s != "_" {
              sb.write_string("; let " + pat_s + " = " + tmp_s + "." + fname)
            }
          } else {
            sb.write_string("; let " + fname + " = " + tmp_s + "." + fname)
          }
        }
        fi = fe + 1
      }
      push_scope_binders(ctx, collect_pattern_binders(tokens, i + 1, cb + 1))
      return (sb.to_string(), rhs_end)
    }
  }

  // 1b1b. Local `let TupleStruct(p0, p1, ..) = expr` destructuring -> temp binding + field lets
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 2 < end &&
  tokens[i + 1].kind == TokenKind::UpperIdent && ctx.symtab.tuple_structs.contains(tokens[i + 1].raw) &&
  tokens[i + 2].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, i + 2)
    if cp + 1 < end && tokens[cp + 1].kind == TokenKind::Eq {
      let rhs_end = find_expr_end(tokens, cp + 2, end)
      let rhs_s = lower_expr_range(ctx, tokens, cp + 2, rhs_end, file, false).trim()
      let tmp_s = fresh_temp(ctx, "ts")
      let sb = StringBuilder()
      sb.write_string(trivia + "let " + tmp_s + " = " + rhs_s)
      let mut pi = i + 3
      let mut fidx = 0
      while pi < cp {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        if tokens[pi].kind == TokenKind::DotDot {
          break
        }
        let mut pe = pi
        let mut pd = 0
        while pe < cp {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
          else if pd == 0 && pk == TokenKind::Comma { break }
          pe = pe + 1
        }
        emit_tuple_struct_destructure(ctx, sb, tmp_s + "._" + fidx.to_string(), tokens, pi, pe, file)
        fidx = fidx + 1
        pi = pe + 1
      }
      push_scope_binders(ctx, collect_pattern_binders(tokens, i + 2, cp + 1))
      return (sb.to_string(), rhs_end)
    }
  }

  // 1b2. Local `let [mut] <name> [: <Type>] =` — lower `<Type>` through `lower_type_tokens`,
  //     box `let mut` locals captured by lifted recursive local `fn`s into `mbt_compat::MbtCell`,
  //     track `ScopeVar` for inner closures (pushed AFTER lowering RHS so `let x = x + 1` sees outer `x`!),
  //     and wrap `ArrayBuf`-promoted array literals!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" {
    let mut name_i = i + 1
    let mut is_mut = false
    if name_i < end && tokens[name_i].kind == TokenKind::Keyword && tokens[name_i].raw == "mut" {
      is_mut = true
      name_i = name_i + 1
    }
    if name_i + 1 < end && (tokens[name_i].kind == TokenKind::Ident || tokens[name_i].raw == "_") {
      let raw_lname = tokens[name_i].raw
      let let_rn = if raw_lname == "_" { Map() } else { compute_scoped_binder_renames(ctx, [raw_lname]) }
      let lname = if raw_lname == "_" {
        "_"
      } else {
        match let_rn.get(raw_lname) {
          Some(v) => v
          None => rename_keyword_ident(raw_lname)
        }
      }
      let mut_kw = if is_mut { "mut " } else { "" }
      let is_boxed = is_mut && lname != "_" && ctx.boxed_mut_vars.contains(lname)
      if name_i + 2 < end && tokens[name_i + 1].kind == TokenKind::Colon {
        let mut eq_i = name_i + 2
        let mut td = 0
        while eq_i < end {
          let tk = tokens[eq_i].kind
          if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
            td = td + 1
          } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
            td = td - 1
          } else if td == 0 && tk == TokenKind::Eq {
            break
          }
          eq_i = eq_i + 1
        }
        if eq_i < end && tokens[eq_i].kind == TokenKind::Eq {
          let lty = lower_type_tokens_checked(ctx, tokens, name_i + 2, eq_i, file).trim()
          if is_boxed {
            let rhs_end = find_expr_end(tokens, eq_i + 1, end)
            let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false).trim()
            if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
            if lname != "_" {
              ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
            }
            return (trivia + "let " + lname + " : mbt_compat::MbtCell[" + lty + "] = mbt_compat::MbtCell::{ v: " + rhs_s + " }", rhs_end)
          }
          if ctx.borrowed_bufs.contains(lname) && eq_i + 1 < end && tokens[eq_i + 1].kind == TokenKind::LBracket {
            let close_arr = find_matching_delim(tokens, eq_i + 1)
            let arr_lit = lower_expr_range(ctx, tokens, eq_i + 1, close_arr + 1, file, false).trim()
            if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
            if lname != "_" {
              ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
            }
            return (trivia + "let " + mut_kw + lname + " = mbt_compat::ArrayBuf::from_array(" + arr_lit + ")", close_arr + 1)
          }
          if ctx.borrowed_bufs.contains(lname) && !has_local_ctor(ctx.symtab, "Array") && lty.starts_with("Array[") {
            match lower_array_ctor_as_buf(ctx, tokens, eq_i + 1, end, file) {
              Some((buf_s, after)) => {
                if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
                if lname != "_" {
                  ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
                }
                return (trivia + "let " + mut_kw + lname + " : mbt_compat::ArrayBuf[" + lty.slice(6, lty.length() - 1) + "] = " + buf_s, after)
              }
              None => ()
            }
          }
          let rhs_end = find_expr_end(tokens, eq_i + 1, end)
          push_expected_type(ctx, lty)
          let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false)
          pop_expected_type(ctx)
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + mut_kw + lname + " : " + lty + " =" + rhs_s, rhs_end)
        }
      } else if name_i + 1 < end && tokens[name_i + 1].kind == TokenKind::Eq {
        let eq_i = name_i + 1
        let rhs_end = find_expr_end(tokens, eq_i + 1, end)
        let inf_ty = infer_simple_expr_type(ctx, tokens, eq_i + 1, rhs_end)
        if is_boxed {
          let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false).trim()
          let ty_ann = if inf_ty.length() > 0 { " : mbt_compat::MbtCell[" + inf_ty + "]" } else { "" }
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + lname + ty_ann + " = mbt_compat::MbtCell::{ v: " + rhs_s + " }", rhs_end)
        }
        if ctx.borrowed_bufs.contains(lname) && eq_i + 1 < end && tokens[eq_i + 1].kind == TokenKind::LBracket {
          let close_arr = find_matching_delim(tokens, eq_i + 1)
          let arr_lit = lower_expr_range(ctx, tokens, eq_i + 1, close_arr + 1, file, false).trim()
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + mut_kw + lname + " = mbt_compat::ArrayBuf::from_array(" + arr_lit + ")", close_arr + 1)
        }
        let rhs_s = {
          push_expected_type(ctx, "")
          let r = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false)
          pop_expected_type(ctx)
          r
        }
        if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
        if lname != "_" {
          ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
        }
        return (trivia + "let " + mut_kw + lname + " =" + rhs_s, rhs_end)
      }
    }
  }

  // 1b3. `return <expr>`: push enclosing function return type for expected-type enum disambiguation
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "return" && ctx.cur_fn_ret_ty.length() > 0 {
    let next_i = i + 1
    if next_i < end && !tokens[next_i].newline_before &&
    tokens[next_i].kind != TokenKind::RBrace && tokens[next_i].kind != TokenKind::Semi &&
    tokens[next_i].kind != TokenKind::RParen && tokens[next_i].kind != TokenKind::Comma {
      let expr_end = find_expr_end(tokens, next_i, end)
      if expr_end > next_i {
        push_expected_type(ctx, ctx.cur_fn_ret_ty)
        let expr_s = lower_expr_range(ctx, tokens, next_i, expr_end, file, false)
        pop_expected_type(ctx)
        return (trivia + "return" + expr_s, expr_end)
      }
    }
  }

  // 1b4. `if <cond> { ... }`: isolate condition expected type as `Bool`, scope `is <Pat>` binders into
  //      subsequent `&&` and the `then` block only (restored before `else`), while preserving outer expected type for branches!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "if" {
    let mut lb = i + 1
    let mut pd = 0
    while lb < end {
      let lk = tokens[lb].kind
      if pd == 0 && lk == TokenKind::LBrace {
        if !(lb > i + 1 && tokens[lb - 1].kind == TokenKind::ColonColon) {
          break
        }
      }
      if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { pd = pd + 1 }
      else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      lb = lb + 1
    }
    if lb < end && tokens[lb].kind == TokenKind::LBrace && lb > i + 1 {
      let close_b = find_matching_delim(tokens, lb)
      match try_lower_if_is_chain(ctx, tokens, i, lb, close_b, end, file, trivia) {
        Some(res) => return res
        None => ()
      }
      let saved_if_sc = ctx.scope_vars.length()
      let saved_if_exp = ctx.expected_type_stack.length()
      let mut pushed_if_sib = false
      if current_expected_type(ctx).trim().length() == 0 {
        let sib_brs = collect_if_else_branch_spans_f3d2(tokens, i, end)
        let sib_ty = infer_sibling_branches_expected_type_f3d2(ctx, tokens, sib_brs)
        if sib_ty.length() > 0 {
          push_expected_type(ctx, sib_ty)
          pushed_if_sib = true
        }
      }
      push_expected_type(ctx, "Bool")
      let cond_s = lower_cond_with_is_binders(ctx, tokens, i + 1, lb, file)
      pop_expected_type(ctx)
      let then_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
      restore_scope_vars(ctx, saved_if_sc)
      if (pushed_if_sib || current_expected_type(ctx).starts_with("__qual__::")) && close_b + 2 < end &&
      tokens[close_b + 1].kind == TokenKind::Keyword && tokens[close_b + 1].raw == "else" {
        if tokens[close_b + 2].kind == TokenKind::LBrace {
          let else_lb = close_b + 2
          let else_rb = find_matching_delim(tokens, else_lb)
          let else_s = lower_block_range(ctx, tokens, else_lb, else_rb, file, "")
          restore_expected_type_stack(ctx, saved_if_exp)
          return (
            trivia + "if" + cond_s + tokens[lb].leading_trivia + then_s +
            tokens[close_b + 1].leading_trivia + "else" + tokens[else_lb].leading_trivia + else_s,
            else_rb + 1,
          )
        } else if tokens[close_b + 2].kind == TokenKind::Keyword && tokens[close_b + 2].raw == "if" {
          let (elif_s, elif_end) = lower_one_token_or_form(ctx, tokens, close_b + 2, end, file, false)
          restore_expected_type_stack(ctx, saved_if_exp)
          return (
            trivia + "if" + cond_s + tokens[lb].leading_trivia + then_s +
            tokens[close_b + 1].leading_trivia + "else" + elif_s,
            elif_end,
          )
        }
      }
      restore_expected_type_stack(ctx, saved_if_exp)
      // Unify `if cond { float_expr } else { 1.0 }` -> `Float::from_double(1.0)` when no outer expected type is set
      if current_expected_type(ctx).trim().length() == 0 && close_b + 2 < end &&
      tokens[close_b + 1].kind == TokenKind::Keyword && tokens[close_b + 1].raw == "else" &&
      tokens[close_b + 2].kind == TokenKind::LBrace {
        let else_lb = close_b + 2
        let else_rb = find_matching_delim(tokens, else_lb)
        if else_rb == else_lb + 2 && tokens[else_lb + 1].kind == TokenKind::FloatLit && !tokens[else_lb + 1].raw.ends_with("F") {
          let then_ty = infer_simple_expr_type(ctx, tokens, lb + 1, close_b)
          if then_ty == "Float" {
            return (
              trivia + "if" + cond_s + tokens[lb].leading_trivia + then_s +
              tokens[close_b + 1].leading_trivia + "else" + tokens[else_lb].leading_trivia +
              "{ Float::from_double(" + tokens[else_lb + 1].raw + ") }",
              else_rb + 1,
            )
          }
        }
      }
      return (trivia + "if" + cond_s + tokens[lb].leading_trivia + then_s, close_b + 1)
    }
  }

  // 1b5. `for` loop (`for x in iter { ... }`, `for i, x in iter { ... }`, `for i = 0; cond; step { ... }`):
  //      push loop binders onto `ctx.scope_vars` so they shadow any colliding black-box private top-levels!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "for" {
    let mut lb = i + 1
    let mut pd = 0
    while lb < end {
      let lk = tokens[lb].kind
      if pd == 0 && lk == TokenKind::LBrace {
        if !(lb > i + 1 && tokens[lb - 1].kind == TokenKind::ColonColon) {
          break
        }
      }
      if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { pd = pd + 1 }
      else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      lb = lb + 1
    }
    if lb < end && tokens[lb].kind == TokenKind::LBrace && lb > i + 1 {
      let close_b = find_matching_delim(tokens, lb)
      // Check for depth-0 `in` vs depth-0 `;` in `[i + 1, lb)`
      let mut in_idx = -1
      let mut semi1 = -1
      let mut k = i + 1
      let mut kd = 0
      while k < lb {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { kd = kd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if kd > 0 { kd = kd - 1 } }
        else if kd == 0 {
          if kk == TokenKind::Keyword && tokens[k].raw == "in" && in_idx < 0 { in_idx = k }
          else if kk == TokenKind::Semi && semi1 < 0 { semi1 = k }
        }
        k = k + 1
      }
      if in_idx > i + 1 {
        let saved_fh = ctx.in_for_header
        ctx.in_for_header = true
        let iter_ty = infer_simple_expr_type(ctx, tokens, in_idx + 1, lb)
        let mut iter_s = lower_expr_range(ctx, tokens, in_idx + 1, lb, file, false)
        ctx.in_for_header = saved_fh
        // Immediate read-only `for k in xs[lo:hi] { ... }`: allow owned slice copy ONLY when `xs` is
        // a plain identifier not referenced in the loop body and the loop body makes only pure read calls
        // (Stage A.5 additionally enforces immutable scalar/tuple elements).
        if str_has(iter_s, "mbt_compat::__mbt_slice_borrow(") && in_idx + 2 < lb &&
        tokens[in_idx + 1].kind == TokenKind::Ident && tokens[in_idx + 2].kind == TokenKind::LBracket &&
        find_matching_delim(tokens, in_idx + 2) == lb - 1 {
          let sl_recv = tokens[in_idx + 1].raw
          if for_slice_body_is_ro_safe_f42(ctx, tokens, lb + 1, close_b, sl_recv, in_idx + 2) {
            let b_idx = iter_s.index_of("mbt_compat::__mbt_slice_borrow(")
            if b_idx >= 0 {
              let mut rp_idx = -1
              let mut scan = iter_s.length() - 1
              while scan > b_idx {
                if iter_s.slice(scan, scan + 1) == ")" {
                  rp_idx = scan
                  break
                }
                scan = scan - 1
              }
              if rp_idx > b_idx {
                iter_s = iter_s.slice(0, b_idx) + "mbt_compat::__mbt_slice_owned(" +
                iter_s.slice(b_idx + 31, rp_idx) + ", \"__FOR_RO__\")" + iter_s.slice(rp_idx + 1, iter_s.length())
              }
            }
          }
        }
        let saved_for_sc = ctx.scope_vars.length()
        let saved_for_rn = ctx.ident_renames.length()
        let raw_for_b = collect_raw_pattern_binders(tokens, i + 1, in_idx)
        let for_rn = compute_scoped_binder_renames(ctx, raw_for_b)
        if for_rn.length() > 0 {
          ctx.ident_renames.push(for_rn)
        }
        let vars_s = lower_expr_range(ctx, tokens, i + 1, in_idx, file, true)
        for rb in raw_for_b {
          ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
        }
        let elem_ty = extract_container_value_type(iter_ty)
        if elem_ty.length() > 0 {
          if in_idx == i + 2 && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 1].raw != "_" {
            ctx.scope_vars.push(ScopeVar::{
              name: resolve_ident_in_scope(ctx, tokens[i + 1].raw),
              ty: elem_ty,
              is_mut: false,
              is_boxed: false,
            })
          } else if in_idx == i + 4 && tokens[i + 2].kind == TokenKind::Comma && tokens[i + 3].kind == TokenKind::Ident && tokens[i + 3].raw != "_" {
            ctx.scope_vars.push(ScopeVar::{
              name: resolve_ident_in_scope(ctx, tokens[i + 3].raw),
              ty: elem_ty,
              is_mut: false,
              is_boxed: false,
            })
          } else if tokens[i + 1].kind == TokenKind::LParen && find_matching_delim(tokens, i + 1) == in_idx - 1 &&
          elem_ty.starts_with("(") && elem_ty.ends_with(")") {
            let mut ti = i + 2
            let mut tidx = 0
            while ti < in_idx - 1 {
              if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
              if tokens[ti].kind == TokenKind::Ident && tokens[ti].raw != "_" {
                let et = extract_tuple_elem_type(elem_ty, tidx)
                if et.length() > 0 {
                  ctx.scope_vars.push(ScopeVar::{
                    name: resolve_ident_in_scope(ctx, tokens[ti].raw),
                    ty: et,
                    is_mut: false,
                    is_boxed: false,
                  })
                }
              }
              tidx = tidx + 1
              ti = ti + 1
            }
          }
        }
        let body_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
        // Lower tuple-destructuring `for (a, b) in xs { ... }` and `for i, (a, b) in xs { ... }`
        // BEFORE restoring `ctx.ident_renames` / `ctx.scope_vars` so bindings match the renamed body!
        let mut tuple_out : Option[String] = None
        if tokens[i + 1].kind == TokenKind::LParen && find_matching_delim(tokens, i + 1) == in_idx - 1 {
          if is_irrefutable_tuple_pattern(tokens, i + 1, in_idx) {
            let tmp_v = fresh_temp(ctx, "for")
            let let_stmts = emit_flat_tuple_let_bindings(ctx, tokens, i + 1, in_idx, tmp_v)
            let patched_body = if body_s.starts_with("{") {
              "{ " + let_stmts + body_s.slice(1, body_s.length())
            } else {
              body_s
            }
            tuple_out = Some(trivia + "for " + tmp_v + tokens[in_idx].leading_trivia + "in" + iter_s + tokens[lb].leading_trivia + patched_body)
          } else {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[i + 1].line,
              tokens[i + 1].col,
              "invalid or refutable tuple pattern in `for ... in` loop header",
            ))
          }
        } else if i + 3 < in_idx && (tokens[i + 1].kind == TokenKind::Ident || tokens[i + 1].kind == TokenKind::Underscore) &&
        tokens[i + 2].kind == TokenKind::Comma && tokens[i + 3].kind == TokenKind::LParen &&
        find_matching_delim(tokens, i + 3) == in_idx - 1 {
          if is_irrefutable_tuple_pattern(tokens, i + 3, in_idx) {
            let tmp_v = fresh_temp(ctx, "for")
            let idx_s = lower_expr_range(ctx, tokens, i + 1, i + 2, file, true)
            let let_stmts = emit_flat_tuple_let_bindings(ctx, tokens, i + 3, in_idx, tmp_v)
            let patched_body = if body_s.starts_with("{") {
              "{ " + let_stmts + body_s.slice(1, body_s.length())
            } else {
              body_s
            }
            tuple_out = Some(trivia + "for" + idx_s + ", " + tmp_v + tokens[in_idx].leading_trivia + "in" + iter_s + tokens[lb].leading_trivia + patched_body)
          } else {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[i + 3].line,
              tokens[i + 3].col,
              "invalid or refutable tuple pattern in `for ... in` loop header",
            ))
          }
        }
        restore_scope_vars(ctx, saved_for_sc)
        restore_ident_renames(ctx, saved_for_rn)
        match tuple_out {
          Some(s) => return (s, close_b + 1)
          None => return (trivia + "for" + vars_s + tokens[in_idx].leading_trivia + "in" + iter_s + tokens[lb].leading_trivia + body_s, close_b + 1)
        }
      } else if semi1 > i + 1 {
        // C-style `for v1 = init1, v2 = init2; cond; step { body }`
        let loop_vars : Array[String] = []
        let init_sb = StringBuilder()
        let mut vi = i + 1
        while vi < semi1 {
          if tokens[vi].kind == TokenKind::Ident && vi + 1 < semi1 && tokens[vi + 1].kind == TokenKind::Eq {
            let vname = rename_keyword_ident(tokens[vi].raw)
            loop_vars.push(vname)
            init_sb.write_string(tokens[vi].leading_trivia + vname + tokens[vi + 1].leading_trivia + "=")
            let mut ve = vi + 2
            let mut vd = 0
            while ve < semi1 {
              let vk = tokens[ve].kind
              if vk == TokenKind::LParen || vk == TokenKind::LBracket || vk == TokenKind::LBrace { vd = vd + 1 }
              else if vk == TokenKind::RParen || vk == TokenKind::RBracket || vk == TokenKind::RBrace { if vd > 0 { vd = vd - 1 } }
              else if vd == 0 && vk == TokenKind::Comma { break }
              ve = ve + 1
            }
            init_sb.write_string(lower_expr_range(ctx, tokens, vi + 2, ve, file, false))
            if ve < semi1 && tokens[ve].kind == TokenKind::Comma {
              init_sb.write_string(tokens[ve].leading_trivia + ",")
              vi = ve + 1
            } else {
              vi = ve
            }
          } else {
            let (p, ni) = lower_one_token_or_form(ctx, tokens, vi, semi1, file, false)
            init_sb.write_string(p)
            vi = ni
          }
        }
        let saved_for_sc = ctx.scope_vars.length()
        push_scope_binders(ctx, loop_vars)
        let rest_hdr = lower_expr_range(ctx, tokens, semi1, lb, file, false)
        let body_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
        restore_scope_vars(ctx, saved_for_sc)
        return (trivia + "for" + init_sb.to_string() + rest_hdr + tokens[lb].leading_trivia + body_s, close_b + 1)
      }
    }
  }

  // 1c. Anonymous closure `fn(params) [-> Ret] { body }` — run all param & return types through `lower_type_tokens_checked`!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "fn" && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
    let open_p = i + 1
    let close_p = find_matching_delim(tokens, open_p)
    let (p_str0, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, open_p, close_p, file, false, true)
    let raw_p_names = extract_raw_param_names(tokens, open_p, close_p)
    let (_, p_tys0, _) = extract_param_info(ctx, tokens, open_p, close_p, file)
    let (p_str, p_tys) = annotate_untyped_closure_params(ctx, tokens, open_p, close_p, end, p_str0, p_tys0)
    let mut cur = close_p + 1
    let mut ret_str = ""
    if cur < end && tokens[cur].kind == TokenKind::Arrow {
      let mut r_end = cur + 1
      let mut rd = 0
      while r_end < end {
        let rk = tokens[r_end].kind
        if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
          break
        }
        if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
        else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
        r_end = r_end + 1
      }
      ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, cur + 1, r_end, file)
      cur = r_end
    }
    if cur < end && tokens[cur].kind == TokenKind::LBrace {
      let close_b = find_matching_delim(tokens, cur)
      let saved_fn_sc = ctx.scope_vars.length()
      let saved_fn_rn = ctx.ident_renames.length()
      if p_renames.length() > 0 {
        ctx.ident_renames.push(p_renames)
      }
      let exp_fn_ptys = extract_expected_fn_param_types(current_expected_type(ctx))
      let mut pi = 0
      while pi < raw_p_names.length() {
        if raw_p_names[pi] != "_" {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          let pty0 = if pi < p_tys.length() { p_tys[pi] } else { "" }
          let pty = if pty0.length() > 0 {
            pty0
          } else if pi < exp_fn_ptys.length() {
            exp_fn_ptys[pi]
          } else {
            ""
          }
          ctx.scope_vars.push(ScopeVar::{ name: eff_pn, ty: pty, is_mut: false, is_boxed: false })
        }
        pi = pi + 1
      }
      let exp_ret_ty = if ret_str.trim().starts_with("->") {
        ret_str.trim().slice(2, ret_str.trim().length()).trim()
      } else {
        extract_fn_ret_type_str(current_expected_type(ctx)).trim()
      }
      let saved_clo_exp = ctx.expected_type_stack.length()
      push_expected_type(ctx, exp_ret_ty)
      ctx.in_closure_depth = ctx.in_closure_depth + 1
      let mut body = lower_block_range(ctx, tokens, cur, close_b, file, p_pre)
      if exp_ret_ty == "Double" {
        let bt = body.trim()
        if bt.starts_with("{") && bt.ends_with("}") && bt.length() >= 3 {
          let inner_b = bt.slice(1, bt.length() - 1).trim()
          let coerced_b = coerce_standalone_int_to_double_f42(inner_b)
          if coerced_b != inner_b {
            body = "{ " + coerced_b + " }"
          }
        }
      }
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_expected_type_stack(ctx, saved_clo_exp)
      restore_scope_vars(ctx, saved_fn_sc)
      restore_ident_renames(ctx, saved_fn_rn)
      return (trivia + "fn(" + p_str + ")" + ret_str + " " + body, close_b + 1)
    }
  }

  // 1d. `is <Pattern>` expression — lower RHS in pattern mode (`in_pattern = true`), stopping at depth-0 newline!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "is" && i + 1 < end {
    let mut pat_end = i + 1
    let mut pd = 0
    while pat_end < end {
      let pk = tokens[pat_end].kind
      if pd == 0 && pat_end > i + 1 && tokens[pat_end].newline_before {
        break
      }
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
        if pd == 0 && pk == TokenKind::LBrace {
          // `{` at depth 0 starts the `if` body block unless preceded by `::`
          if !(pat_end > i + 1 && tokens[pat_end - 1].kind == TokenKind::ColonColon) {
            break
          }
        }
        pd = pd + 1
      } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
        if pd == 0 { break }
        pd = pd - 1
      } else if pd == 0 && (pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::Comma || pk == TokenKind::Semi || pk == TokenKind::EqEq || pk == TokenKind::BangEq || (pk == TokenKind::Keyword && tokens[pat_end].raw == "else")) {
        break
      }
      pat_end = pat_end + 1
    }
    let mut lhs_s = i
    let mut ld = 0
    while lhs_s > 0 {
      let pk = tokens[lhs_s - 1].kind
      if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
        ld = ld + 1
        lhs_s = lhs_s - 1
        continue
      }
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
        if ld == 0 { break }
        ld = ld - 1
        lhs_s = lhs_s - 1
        continue
      }
      if ld == 0 {
        if pk == TokenKind::Bang || pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe ||
        pk == TokenKind::Comma || pk == TokenKind::Semi || pk == TokenKind::Eq ||
        pk == TokenKind::FatArrow || pk == TokenKind::Keyword {
          break
        }
        if lhs_s < i && tokens[lhs_s].newline_before {
          break
        }
      }
      lhs_s = lhs_s - 1
    }
    let lhs_ty = if lhs_s < i { infer_simple_expr_type(ctx, tokens, lhs_s, i) } else { "" }
    if lhs_ty.length() > 0 {
      push_expected_type(ctx, lhs_ty)
    }
    let pat_str = lower_expr_range(ctx, tokens, i + 1, pat_end, file, true)
    if lhs_ty.length() > 0 {
      pop_expected_type(ctx)
    }
    return (trivia + "is" + pat_str, pat_end)
  }

  // 1e. `as &Trait` / `as &@pkg.Trait` -> `as dyn Trait` / `as dyn pkg::Trait`
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "as" &&
  i + 2 < end && tokens[i + 1].kind == TokenKind::Amp {
    if tokens[i + 2].kind == TokenKind::UpperIdent {
      let mut tname = tokens[i + 2].raw
      if !ctx.symtab.local_types.contains(tname) && !ctx.active_generics.contains(tname) {
        match ctx.symtab.using_types.get(tname) {
          Some(ut) => tname = ut
          None => ()
        }
      }
      return (trivia + "as dyn " + tname, i + 3)
    }
    if tokens[i + 2].kind == TokenKind::PkgRef && i + 4 < end &&
    tokens[i + 3].kind == TokenKind::Dot && tokens[i + 4].kind == TokenKind::UpperIdent {
      let raw_pkg = tokens[i + 2].raw.slice(1, tokens[i + 2].raw.length())
      let mapped = match ctx.symtab.pkg_aliases.get(raw_pkg) {
        Some(p) => p
        None => raw_pkg
      }
      return (trivia + "as dyn " + mapped + "::" + tokens[i + 4].raw, i + 5)
    }
  }

  // 2. Arrow functions: `(a, b) => expr` AND single-param `x => expr` / `_ => expr`
  //    Also handles type ascription `(expr : Type)` -> `(expr)` (or `Float::from_double(lit)` for Float).
  //    (strictly distinguished from match arms because `lower_match_arms` handles arm `=>` with `in_pattern = true`!)
  if !in_pattern && t.kind == TokenKind::LParen {
    let close_p = is_arrow_fn_at(tokens, i, end)
    if close_p >= 0 {
      let (p_str, _, _, p_renames) = lower_param_list_scoped(ctx, tokens, i, close_p, file, false, true)
      let raw_p_names = extract_raw_param_names(tokens, i, close_p)
      let (_, p_tys, _) = extract_param_info(ctx, tokens, i, close_p, file)
      let saved_arr_sc = ctx.scope_vars.length()
      let saved_arr_rn = ctx.ident_renames.length()
      if p_renames.length() > 0 {
        ctx.ident_renames.push(p_renames)
      }
      let exp_fn_ptys = extract_expected_fn_param_types(current_expected_type(ctx))
      let mut pi = 0
      while pi < raw_p_names.length() {
        if raw_p_names[pi] != "_" {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          let pty0 = if pi < p_tys.length() { p_tys[pi] } else { "" }
          let pty = if pty0.length() > 0 {
            pty0
          } else if pi < exp_fn_ptys.length() {
            exp_fn_ptys[pi]
          } else {
            ""
          }
          ctx.scope_vars.push(ScopeVar::{ name: eff_pn, ty: pty, is_mut: false, is_boxed: false })
        }
        pi = pi + 1
      }
      let exp_arr_ret = extract_fn_ret_type_str(current_expected_type(ctx)).trim()
      let saved_arr_exp = ctx.expected_type_stack.length()
      push_expected_type(ctx, exp_arr_ret)
      let body_start = close_p + 2
      ctx.in_closure_depth = ctx.in_closure_depth + 1
      if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
        let body_close = find_matching_delim(tokens, body_start)
        let mut body = lower_block_range(ctx, tokens, body_start, body_close, file, "")
        if exp_arr_ret == "Double" {
          let bt = body.trim()
          if bt.starts_with("{") && bt.ends_with("}") && bt.length() >= 3 {
            let inner_b = bt.slice(1, bt.length() - 1).trim()
            let coerced_b = coerce_standalone_int_to_double_f42(inner_b)
            if coerced_b != inner_b {
              body = "{ " + coerced_b + " }"
            }
          }
        }
        ctx.in_closure_depth = ctx.in_closure_depth - 1
        restore_expected_type_stack(ctx, saved_arr_exp)
        restore_scope_vars(ctx, saved_arr_sc)
        restore_ident_renames(ctx, saved_arr_rn)
        return (trivia + "fn(" + p_str + ") " + body, body_close + 1)
      }
      let body_end = find_expr_end(tokens, body_start, end)
      let raw_body_expr = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      let body_expr = if exp_arr_ret == "Double" {
        coerce_standalone_int_to_double_f42(raw_body_expr)
      } else {
        raw_body_expr
      }
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_expected_type_stack(ctx, saved_arr_exp)
      restore_scope_vars(ctx, saved_arr_sc)
      restore_ident_renames(ctx, saved_arr_rn)
      return (trivia + "fn(" + p_str + ") { " + body_expr + " }", body_end)
    }
    // Check type ascription `(expr : Type)` (single top-level `:`, no top-level `,`, RHS starts with type token)
    let cp = find_matching_delim(tokens, i)
    if cp > i + 3 {
      let mut colon_pos = -1
      let mut colon_cnt = 0
      let mut has_comma = false
      let mut sk = i + 1
      let mut sd = 0
      while sk < cp {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
        else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { sd = sd - 1 }
        else if sd == 0 {
          if skk == TokenKind::Colon {
            colon_pos = sk
            colon_cnt = colon_cnt + 1
          } else if skk == TokenKind::Comma {
            has_comma = true
          }
        }
        sk = sk + 1
      }
      if colon_cnt == 1 && !has_comma && colon_pos > i + 1 && colon_pos + 1 < cp {
        let rhs_k = tokens[colon_pos + 1].kind
        if rhs_k == TokenKind::Amp {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[colon_pos + 1].line,
            tokens[colon_pos + 1].col,
            "trait object type ascription `(&Trait)` is not supported",
          ))
          let inner_e = lower_expr_range(ctx, tokens, i + 1, colon_pos, file, false).trim()
          return (trivia + "(" + inner_e + ")", cp + 1)
        }
        if rhs_k == TokenKind::UpperIdent || rhs_k == TokenKind::PkgRef || rhs_k == TokenKind::LParen {
          let asc_ty = lower_type_tokens_checked(ctx, tokens, colon_pos + 1, cp, file).trim()
          // Never silently strip type ascription `(e : T)`!
          // Fast path for numeric literals (including unary `-`): emit exact typed Pion literal/conversion.
          let is_pos_int = colon_pos == i + 2 && tokens[i + 1].kind == TokenKind::IntLit
          let is_neg_int = colon_pos == i + 3 && tokens[i + 1].kind == TokenKind::Minus && tokens[i + 2].kind == TokenKind::IntLit
          let is_pos_flt = colon_pos == i + 2 && tokens[i + 1].kind == TokenKind::FloatLit
          let is_neg_flt = colon_pos == i + 3 && tokens[i + 1].kind == TokenKind::Minus && tokens[i + 2].kind == TokenKind::FloatLit
          if is_pos_int || is_neg_int {
            let num_raw = if is_neg_int { "-" + tokens[i + 2].raw } else { tokens[i + 1].raw }
            let has_suffix = num_raw.ends_with("L") || num_raw.ends_with("l") || num_raw.ends_with("U") || num_raw.ends_with("u")
            if asc_ty == "Int64" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "L" }), cp + 1)
            } else if asc_ty == "UInt" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "U" }), cp + 1)
            } else if asc_ty == "UInt64" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "UL" }), cp + 1)
            } else if asc_ty == "Double" {
              let raw_body = if is_neg_int { tokens[i + 2].raw } else { tokens[i + 1].raw }
              let is_nondec = raw_body.starts_with("0x") || raw_body.starts_with("0X") || raw_body.starts_with("0b") || raw_body.starts_with("0B") || raw_body.starts_with("0o") || raw_body.starts_with("0O")
              if is_nondec {
                if nondec_int_exceeds_u64(raw_body) {
                  ctx.diags.push(diag_error(
                    "MBT2PION_UNSUPPORTED_SYNTAX",
                    file,
                    tokens[i + 1].line,
                    tokens[i + 1].col,
                    "non-decimal integer literal `" + raw_body + "` exceeds 64-bit unsigned range for `Double` ascription",
                  ))
                  return (trivia + "0.0", cp + 1)
                }
                let u64_raw = if has_suffix { raw_body } else { raw_body + "UL" }
                let d_expr = if is_neg_int { "(-(" + u64_raw + ").to_double())" } else { "(" + u64_raw + ").to_double()" }
                return (trivia + d_expr, cp + 1)
              }
              return (trivia + num_raw + ".0", cp + 1)
            } else if asc_ty == "Float" {
              let raw_body = if is_neg_int { tokens[i + 2].raw } else { tokens[i + 1].raw }
              let is_nondec = raw_body.starts_with("0x") || raw_body.starts_with("0X") || raw_body.starts_with("0b") || raw_body.starts_with("0B") || raw_body.starts_with("0o") || raw_body.starts_with("0O")
              if is_nondec {
                if nondec_int_exceeds_u64(raw_body) {
                  ctx.diags.push(diag_error(
                    "MBT2PION_UNSUPPORTED_SYNTAX",
                    file,
                    tokens[i + 1].line,
                    tokens[i + 1].col,
                    "non-decimal integer literal `" + raw_body + "` exceeds 64-bit unsigned range for `Float` ascription",
                  ))
                  return (trivia + "Float::from_double(0.0)", cp + 1)
                }
                let u64_raw = if has_suffix { raw_body } else { raw_body + "UL" }
                let d_expr = if is_neg_int { "(-(" + u64_raw + ").to_double())" } else { "(" + u64_raw + ").to_double()" }
                return (trivia + "Float::from_double(" + d_expr + ")", cp + 1)
              }
              return (trivia + "Float::from_double(" + num_raw + ".0)", cp + 1)
            } else if asc_ty == "Byte" {
              return (trivia + "(" + num_raw + ").to_byte()", cp + 1)
            } else if asc_ty == "Int16" {
              return (trivia + "(" + num_raw + ").to_int16()", cp + 1)
            } else if asc_ty == "Int" {
              return (trivia + num_raw, cp + 1)
            }
          }
          if is_pos_flt || is_neg_flt {
            let raw_tok = if is_neg_flt { tokens[i + 2].raw } else { tokens[i + 1].raw }
            if !raw_tok.starts_with("0x") && !raw_tok.starts_with("0X") {
              let mut flt_raw = if is_neg_flt { "-" + raw_tok } else { raw_tok }
              if flt_raw.ends_with("F") {
                flt_raw = flt_raw.slice(0, flt_raw.length() - 1)
              }
              if asc_ty == "Float" {
                return (trivia + "Float::from_double(" + flt_raw + ")", cp + 1)
              } else if asc_ty == "Double" {
                return (trivia + flt_raw, cp + 1)
              }
            } else if asc_ty == "Float" {
              let hex_body = if raw_tok.ends_with("F") { raw_tok.slice(0, raw_tok.length() - 1) } else { raw_tok }
              match parse_hex_float_to_bits(hex_body) {
                Some(bits64) => {
                  let sign_prefix = if is_neg_flt { "-" } else { "" }
                  return (trivia + "Float::from_double(" + sign_prefix + "Double::from_bits(" + bits64.to_string() + "L))", cp + 1)
                }
                None => ()
              }
            }
          }
          push_expected_type(ctx, asc_ty)
          let inner_e = lower_expr_range(ctx, tokens, i + 1, colon_pos, file, false).trim()
          pop_expected_type(ctx)
          let asc_tmp = fresh_temp(ctx, "asc")
          return (trivia + "({ let " + asc_tmp + " : " + asc_ty + " = " + inner_e + "; " + asc_tmp + " })", cp + 1)
        }
      }
    }
    match lower_tuple_expr_with_expected_f3d2(ctx, tokens, i, cp, file) {
      Some(tup_s) => return (trivia + tup_s, cp + 1)
      None => ()
    }
  }
  if !in_pattern && (t.kind == TokenKind::Ident || t.kind == TokenKind::Underscore) &&
  i + 1 < end && tokens[i + 1].kind == TokenKind::FatArrow &&
  !(i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
    let saved_arr_sc = ctx.scope_vars.length()
    let saved_arr_rn = ctx.ident_renames.length()
    let arr_rn = if t.kind == TokenKind::Underscore { Map() } else { compute_scoped_binder_renames(ctx, [t.raw]) }
    if arr_rn.length() > 0 {
      ctx.ident_renames.push(arr_rn)
    }
    let pname = if t.kind == TokenKind::Underscore { "_" } else { resolve_ident_in_scope(ctx, t.raw) }
    if pname != "_" {
      ctx.scope_vars.push(ScopeVar::{ name: pname, ty: "", is_mut: false, is_boxed: false })
    }
    let body_start = i + 2
    ctx.in_closure_depth = ctx.in_closure_depth + 1
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      let body_close = find_matching_delim(tokens, body_start)
      let body = lower_block_range(ctx, tokens, body_start, body_close, file, "")
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_scope_vars(ctx, saved_arr_sc)
      restore_ident_renames(ctx, saved_arr_rn)
      return (trivia + "fn(" + pname + ") " + body, body_close + 1)
    }
    let body_end = find_expr_end(tokens, body_start, end)
    let body_expr = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
    ctx.in_closure_depth = ctx.in_closure_depth - 1
    restore_scope_vars(ctx, saved_arr_sc)
    restore_ident_renames(ctx, saved_arr_rn)
    return (trivia + "fn(" + pname + ") { " + body_expr + " }", body_end)
  }

  // 3. Nested `{ ... }` block, Map literal, Ref literal `{ val: e }`, or anonymous struct literal `S::{ ... }`
  if !in_pattern && (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) &&
  t.raw == "try" && i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace {
    let close_tb = find_matching_delim(tokens, i + 1)
    ctx.in_try_catch_depth = ctx.in_try_catch_depth + 1
    let tbody = lower_block_range(ctx, tokens, i + 1, close_tb, file, "")
    ctx.in_try_catch_depth = ctx.in_try_catch_depth - 1
    return (trivia + "try" + tokens[i + 1].leading_trivia + tbody, close_tb + 1)
  }
  if t.kind == TokenKind::LBrace {
    let close_b = find_matching_delim(tokens, i)
    if !in_pattern {
      if close_b == i + 1 {
        let raw_exp = current_expected_type(ctx).trim()
        if is_expected_mbt_json(ctx) {
          return (trivia + "mbt_compat::MbtJson::Object(mbt_compat::ordered_map_new())", close_b + 1)
        }
        if str_has(raw_exp, "OrderedMap") || raw_exp.starts_with("Map[") {
          return (trivia + "mbt_compat::ordered_map_new" + tuple_key_ctor_suffix(ctx) + "()", close_b + 1)
        }
      }
      match try_lower_ref_literal(ctx, tokens, i, close_b, file) {
        Some(ref_code) => return (trivia + ref_code, close_b + 1)
        None => ()
      }
      if is_map_literal(tokens, i, close_b) {
        if is_expected_mbt_json(ctx) && !next_tok_breaks_json_lit(tokens, close_b + 1, end) {
          let sb = StringBuilder()
          sb.write_string("mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([")
          let mut cur = i + 1
          let mut first = true
          while cur < close_b {
            if tokens[cur].kind == TokenKind::Comma {
              cur = cur + 1
              continue
            }
            let mut col_i = cur
            let mut d = 0
            while col_i < close_b {
              let kk = tokens[col_i].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Colon { break }
              col_i = col_i + 1
            }
            if col_i >= close_b { break }
            let mut v_end = col_i + 1
            d = 0
            while v_end < close_b {
              let kk = tokens[v_end].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Comma { break }
              v_end = v_end + 1
            }
            push_expected_type(ctx, "")
            let k_s = lower_expr_range(ctx, tokens, cur, col_i, file, false).trim()
            pop_expected_type(ctx)
            push_expected_type(ctx, "mbt_compat::MbtJson")
            let v_s = lower_expr_range(ctx, tokens, col_i + 1, v_end, file, false).trim()
            pop_expected_type(ctx)
            if !first { sb.write_string(", ") }
            first = false
            sb.write_string("(" + k_s + ", " + v_s + ")")
            cur = v_end + 1
          }
          sb.write_string("]))")
          return (trivia + sb.to_string(), close_b + 1)
        }
        let ml = lower_map_literal(ctx, tokens, i, close_b, file)
        return (trivia + ml, close_b + 1)
      }
      match resolve_anon_struct_literal_name(ctx, tokens, i, close_b) {
        Some(sname) => {
          if close_b > i + 2 && tokens[i + 1].kind == TokenKind::DotDot {
            return (trivia + lower_struct_update_expr(ctx, sname, tokens, i, close_b, file), close_b + 1)
          }
          let body_s = if is_anon_shorthand_struct_lit(tokens, i, close_b) {
            lower_anon_shorthand_struct_lit(ctx, sname, tokens, i, close_b, file)
          } else {
            lower_struct_brace(ctx, sname, tokens, i, close_b, file, false)
          }
          return (trivia + sname + "::" + body_s, close_b + 1)
        }
        None => {
          // Fail closed on struct update `{ ..base, ... }` whose struct type cannot be determined
          // from `base` or the outer expected type (never guess a local struct by field name!).
          if close_b > i + 2 && tokens[i + 1].kind == TokenKind::DotDot {
            ctx.diags.push(diag_error(
              "MBT2PION_AMBIGUOUS_STRUCT_UPDATE",
              file,
              t.line,
              t.col,
              "cannot determine struct type for struct update `{ ..base, ... }` from base expression or expected type",
            ))
          }
        }
      }
      if is_anon_shorthand_struct_lit(tokens, i, close_b) {
        return (trivia + lower_anon_shorthand_struct_lit(ctx, "", tokens, i, close_b, file), close_b + 1)
      }
    }
    let blk = lower_block_range(ctx, tokens, i, close_b, file, "")
    return (trivia + blk, close_b + 1)
  }

  // 3a. Tuple literal expected-type propagation `(e0, e1, ...)` under `(T0, T1, ...)`
  if !in_pattern && t.kind == TokenKind::LParen {
    let exp_tup = current_expected_type(ctx).trim()
    if exp_tup.starts_with("(") && exp_tup.ends_with(")") {
      let is_call_paren = i > 0 && !t.newline_before && {
        let pk = tokens[i - 1].kind
        pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
        pk == TokenKind::RParen || pk == TokenKind::RBracket
      }
      if !is_call_paren && is_arrow_fn_at(tokens, i, end) < 0 {
        let close_p = find_matching_delim(tokens, i)
        if close_p > i + 1 && paren_has_top_level_comma(tokens, i, close_p) {
          let etys = split_top_level_type_list(exp_tup.slice(1, exp_tup.length() - 1))
          let spans : Array[(Int, Int)] = []
          let mut ti = i + 1
          while ti < close_p {
            if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
            let mut te = ti
            let mut td = 0
            while te < close_p {
              let tk = tokens[te].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
              else if td == 0 && tk == TokenKind::Comma { break }
              te = te + 1
            }
            if te > ti { spans.push((ti, te)) }
            ti = te + 1
          }
          if spans.length() == etys.length() && spans.length() >= 2 {
            let sb = StringBuilder()
            sb.write_string("(")
            let mut si = 0
            while si < spans.length() {
              if si > 0 { sb.write_string(", ") }
              let (es, ee) = spans[si]
              push_expected_type(ctx, etys[si].trim())
              let piece = lower_expr_range(ctx, tokens, es, ee, file, in_pattern).trim()
              pop_expected_type(ctx)
              sb.write_string(piece)
              si = si + 1
            }
            sb.write_string(")")
            return (trivia + sb.to_string(), close_p + 1)
          }
        }
      }
    }
  }

  // 3b. Array literal under expected `MbtJson` (`[1, "a", []]` -> `mbt_compat::MbtJson::Array([...])`)
  //     and array literal with spread `[..xs, a, ..ys]`.
  //     NEVER mistake postfix indexing `arr[idx]` (same-line `[` after an expression token) for an array literal!
  if !in_pattern && t.kind == TokenKind::LBracket {
    let close_br = find_matching_delim(tokens, i)
    let is_indexing_lbr = i > 0 && !t.newline_before && {
      let pk = tokens[i - 1].kind
      pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
      pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace ||
      pk == TokenKind::IntLit || pk == TokenKind::FloatLit || pk == TokenKind::StringLit ||
      pk == TokenKind::RawMultiline || pk == TokenKind::InterpString || pk == TokenKind::CharLit ||
      pk == TokenKind::ByteCharLit || pk == TokenKind::ByteStringLit ||
      (pk == TokenKind::Keyword && (tokens[i - 1].raw == "self" || tokens[i - 1].raw == "true" || tokens[i - 1].raw == "false"))
    }
    if is_indexing_lbr {
      push_expected_type(ctx, "")
      let idx_inner = lower_expr_range(ctx, tokens, i + 1, close_br, file, false)
      pop_expected_type(ctx)
      return (trivia + "[" + idx_inner + tokens[close_br].leading_trivia + "]", close_br + 1)
    }
    if is_expected_mbt_json(ctx) && !prev_tok_breaks_json_lit(tokens, i) && !next_tok_breaks_json_lit(tokens, close_br + 1, end) {
      let sb = StringBuilder()
      sb.write_string("mbt_compat::MbtJson::Array([")
      let mut ai = i + 1
      let mut first = true
      while ai < close_br {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_br {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai {
          push_expected_type(ctx, "mbt_compat::MbtJson")
          let item_e = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          pop_expected_type(ctx)
          if !first { sb.write_string(", ") }
          first = false
          sb.write_string(item_e)
        }
        ai = ae + 1
      }
      sb.write_string("])")
      return (trivia + sb.to_string(), close_br + 1)
    }
    if close_br > i + 1 {
      let mut has_spread = false
      let mut sk = i + 1
      let mut sd = 0
      let mut at_elem_start = true
      while sk < close_br {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace {
          sd = sd + 1
          at_elem_start = false
        } else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace {
          sd = sd - 1
          at_elem_start = false
        } else if sd == 0 && skk == TokenKind::Comma {
          at_elem_start = true
        } else if sd == 0 && at_elem_start && skk == TokenKind::DotDot {
          has_spread = true
          break
        } else {
          at_elem_start = false
        }
        sk = sk + 1
      }
      if has_spread {
        let exp_sp = current_expected_type(ctx).trim()
        let sp_ty_ann = if exp_sp.starts_with("Array[") && exp_sp.ends_with("]") && is_liftable_static_type(exp_sp) {
          " : " + exp_sp
        } else {
          ""
        }
        let arr_tmp = fresh_temp(ctx, "sp")
        let sb = StringBuilder()
        sb.write_string(trivia + "({ let " + arr_tmp + sp_ty_ann + " = []; ")
        let mut ai = i + 1
        while ai < close_br {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < close_br {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if tokens[ai].kind == TokenKind::DotDot && ai + 1 < ae {
            let elem_tmp = fresh_temp(ctx, "spe")
            let spread_e = lower_expr_range(ctx, tokens, ai + 1, ae, file, false).trim()
            sb.write_string("for " + elem_tmp + " in " + spread_e + " { " + arr_tmp + ".push(" + elem_tmp + ") }; ")
          } else if ae > ai {
            let item_e = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
            sb.write_string(arr_tmp + ".push(" + item_e + "); ")
          }
          ai = ae + 1
        }
        sb.write_string(arr_tmp + " })")
        return (sb.to_string(), close_br + 1)
      }
      // Propagate `Array[T]` / `FixedArray[T]` expected element type into array literal elements
      let exp_arr = current_expected_type(ctx).trim()
      let arr_elem_ty = if exp_arr.starts_with("Array[") && exp_arr.ends_with("]") {
        exp_arr.slice(6, exp_arr.length() - 1).trim()
      } else if exp_arr.starts_with("FixedArray[") && exp_arr.ends_with("]") {
        exp_arr.slice(11, exp_arr.length() - 1).trim()
      } else {
        ""
      }
      if arr_elem_ty.length() > 0 {
        let sb = StringBuilder()
        sb.write_string("[")
        let mut ai = i + 1
        let mut first = true
        while ai < close_br {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < close_br {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if ae > ai {
            if !first { sb.write_string(", ") }
            first = false
            match byte_lit_for_int_token(tokens, ai, ae, arr_elem_ty) {
              Some(bl) => sb.write_string(bl)
              None => {
                push_expected_type(ctx, arr_elem_ty)
                sb.write_string(lower_expr_range(ctx, tokens, ai, ae, file, false).trim())
                pop_expected_type(ctx)
              }
            }
          }
          ai = ae + 1
        }
        sb.write_string("]")
        return (trivia + sb.to_string(), close_br + 1)
      }
    }
  }

  // 4. `match expr { pat => body, ... }` — preserve match arms and lower patterns with scrutinee expected type!
  if t.kind == TokenKind::Keyword && t.raw == "match" {
    let mut brace_i = i + 1
    let mut depth = 0
    while brace_i < end {
      let bk = tokens[brace_i].kind
      if bk == TokenKind::LParen || bk == TokenKind::LBracket {
        depth = depth + 1
      } else if bk == TokenKind::RParen || bk == TokenKind::RBracket {
        depth = depth - 1
      } else if bk == TokenKind::LBrace && depth == 0 {
        let cb_try = find_matching_delim(tokens, brace_i)
        if cb_try + 1 < end && tokens[cb_try + 1].kind == TokenKind::LBrace {
          // Only treat `[brace_i, cb_try]` as a scrutinee block (e.g. `match { expr } { arms }`)
          // when it contains NO top-level `=>` arm separator; otherwise `[brace_i, cb_try]` is
          // already the match arms block and the following `{ ... }` is a separate statement/struct literal.
          let mut has_top_arrow = false
          let mut ak = brace_i + 1
          let mut ad = 0
          while ak < cb_try {
            let akk = tokens[ak].kind
            if akk == TokenKind::LParen || akk == TokenKind::LBracket || akk == TokenKind::LBrace {
              ad = ad + 1
            } else if akk == TokenKind::RParen || akk == TokenKind::RBracket || akk == TokenKind::RBrace {
              if ad > 0 { ad = ad - 1 }
            } else if ad == 0 && akk == TokenKind::FatArrow {
              has_top_arrow = true
              break
            }
            ak = ak + 1
          }
          if !has_top_arrow {
            brace_i = cb_try + 1
            continue
          }
        }
        break
      }
      brace_i = brace_i + 1
    }
    if brace_i < end {
      let close_b = find_matching_delim(tokens, brace_i)
      let scrut_ty = infer_simple_expr_type(ctx, tokens, i + 1, brace_i)
      push_expected_type(ctx, "")
      let scrut = lower_expr_range(ctx, tokens, i + 1, brace_i, file, false)
      pop_expected_type(ctx)
      let mut eff_scrut_ty = scrut_ty
      if eff_scrut_ty.length() == 0 {
        eff_scrut_ty = infer_sibling_pattern_enum_f42(ctx, tokens, brace_i + 1, close_b)
      }
      if eff_scrut_ty.length() == 0 {
        let (bare_ctors, has_labeled) = collect_match_top_bare_ctors(ctx, tokens, brace_i + 1, close_b)
        if bare_ctors.length() > 0 {
          let (inter, any_ambig) = symtab_intersect_ctor_enums(ctx.symtab, bare_ctors)
          if any_ambig {
            let complete = symtab_sources_complete(ctx.symtab)
            if complete && inter.length() == 1 && (!has_labeled || ctx.symtab.enum_schemas.contains(inter[0])) {
              eff_scrut_ty = inter[0]
            } else {
              let probed = lower_ambig_match_probe(ctx, tokens, brace_i, close_b, scrut, file, inter, !complete)
              return (trivia + probed, close_b + 1)
            }
          }
        }
      }
      let saved_match_exp = ctx.expected_type_stack.length()
      if current_expected_type(ctx).trim().length() == 0 {
        let sib_body_ty = infer_sibling_branches_expected_type_f3d2(ctx, tokens, collect_match_arm_body_spans_f3d2(tokens, brace_i + 1, close_b))
        if sib_body_ty.length() > 0 {
          push_expected_type(ctx, sib_body_ty)
        }
      }
      // P0-2: Push sentinel so outer match's array element cache NEVER leaks into a nested `match`!
      ctx.match_arr_cache_ctor.push("__BLOCKED__")
      ctx.match_arr_cache_elems.push(Map())
      ctx.match_arr_cache_suffix.push(Map())
      ctx.match_arr_cache_len.push("")
      let arms = lower_match_arms_with_ty(ctx, tokens, brace_i + 1, close_b, file, eff_scrut_ty)
      let _ = ctx.match_arr_cache_ctor.pop()
      let _ = ctx.match_arr_cache_elems.pop()
      let _ = ctx.match_arr_cache_suffix.pop()
      let _ = ctx.match_arr_cache_len.pop()
      restore_expected_type_stack(ctx, saved_match_exp)
      return (trivia + "match" + scrut + tokens[brace_i].leading_trivia + "{" + arms + tokens[close_b].leading_trivia + "}", close_b + 1)
    }
  }

  // 5. Package-qualified reference `@pkg.sym` (including `@math`/`@double`/`@utf8`/`@string`/`@int`/`@uint` and `api_map` routing)
  if t.kind == TokenKind::PkgRef {
    let raw_pkg = t.raw.slice(1, t.raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None =>
      match ctx.symtab.moon_import_paths.get(raw_pkg) {
        Some(fp) => {
          let def_al = moon_import_default_alias(fp)
          if !ctx.symtab.dep_pkg_names.contains(raw_pkg) && ctx.symtab.dep_pkg_names.contains(def_al) {
            def_al
          } else {
            raw_pkg
          }
        }
        None => raw_pkg
      }
    }
    if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
      let sym_tok = tokens[i + 2]
      let sym_raw = sym_tok.raw
      // Built-in MoonBit stdlib package mappings (project-agnostic; guarded by `is_moonbit_core_pkg`)
      if !ctx.symtab.api_by_key.contains(raw_pkg + "::" + sym_raw) {
        if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "double") {
          if sym_raw == "not_a_number" { return (trivia + "mbt_compat::double_nan()", i + 3) }
          if sym_raw == "infinity" { return (trivia + "mbt_compat::double_inf()", i + 3) }
          if sym_raw == "neg_infinity" { return (trivia + "mbt_compat::double_neg_inf()", i + 3) }
          if sym_raw == "max_value" { return (trivia + "mbt_compat::double_max_value()", i + 3) }
          if sym_raw == "min_value" { return (trivia + "mbt_compat::double_min_value()", i + 3) }
          if sym_raw == "min_positive" { return (trivia + "mbt_compat::double_min_positive()", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "math") {
          if sym_raw == "PI" { return (trivia + "mbt_compat::double_pi()", i + 3) }
          if sym_raw == "sin" || sym_raw == "cos" || sym_raw == "tan" || sym_raw == "asin" ||
          sym_raw == "acos" || sym_raw == "atan" || sym_raw == "atan2" || sym_raw == "exp" ||
          sym_raw == "ln" || sym_raw == "pow" || sym_raw == "floor" || sym_raw == "ceil" ||
          sym_raw == "round" || sym_raw == "trunc" || sym_raw == "sqrt" || sym_raw == "cbrt" ||
          sym_raw == "hypot" || sym_raw == "maximum" || sym_raw == "minimum" {
            let fn_name = "mbt_compat::math_" + sym_raw
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "encoding/utf8") {
          if sym_raw == "decode_lossy" || sym_raw == "encode" {
            let fn_name = "mbt_compat::utf8_" + sym_raw
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "string") {
          if sym_raw == "parse_int" {
            let fn_name = "mbt_compat::str_parse_int"
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "set") {
          if sym_raw == "new" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            if close_p == i + 4 {
              return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
            }
          }
          if sym_raw == "from_array" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
            return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
          }
          if sym_raw == "from_iter" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
            return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
          }
          if sym_raw == "Set" && i + 5 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 5].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 5)
            let mname = tokens[i + 4].raw
            if mname == "new" && close_p == i + 6 {
              return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
            }
            if mname == "from_array" {
              let inner = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
              return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
            }
            if mname == "from_iter" {
              let inner = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
              return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
            }
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "int") {
          if sym_raw == "max_value" { return (trivia + "2147483647", i + 3) }
          if sym_raw == "min_value" { return (trivia + "(-2147483647 - 1)", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "int64") {
          if sym_raw == "max_value" { return (trivia + "9223372036854775807L", i + 3) }
          if sym_raw == "min_value" { return (trivia + "(-9223372036854775807L - 1L)", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "uint") {
          if sym_raw == "max_value" { return (trivia + "4294967295U", i + 3) }
          if sym_raw == "min_value" { return (trivia + "0U", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "uint64") {
          if sym_raw == "max_value" { return (trivia + "18446744073709551615UL", i + 3) }
          if sym_raw == "min_value" { return (trivia + "0UL", i + 3) }
        }
      }
      let sym_name = rename_keyword_ident(sym_tok.raw)
      let lookup_key = raw_pkg + "::" + sym_tok.raw
      let target_expr = match ctx.symtab.api_by_key.get(lookup_key) {
        Some(asym) =>
        if asym.target_pkg.length() > 0 {
          asym.target_pkg + "::" + asym.target_name
        } else {
          asym.target_name
        }
        None =>
        if ctx.cur_is_test && ctx.self_pkg_name.length() > 0 && raw_pkg == ctx.self_pkg_name {
          sym_name
        } else {
          mapped_pkg + "::" + sym_name
        }
      }
      // §6: Cross-package enum `@pkg.Enum::Variant(...)` or `@pkg.Variant(...)` labeled args & readonly check
      if sym_tok.kind == TokenKind::UpperIdent {
        if i + 4 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 4].kind == TokenKind::UpperIdent {
          let ename = sym_tok.raw
          let vname = tokens[i + 4].raw
          if i + 5 < end && tokens[i + 5].kind == TokenKind::LParen && !tokens[i + 5].newline_before {
            let close_p = find_matching_delim(tokens, i + 5)
            match check_and_lower_enum_site_d2(ctx, mapped_pkg, ename, vname, tokens, i + 5, close_p, file, t.line, t.col, in_pattern) {
              Some(args_s) => return (trivia + target_expr + "::" + vname + args_s, close_p + 1)
              None => ()
            }
          } else {
            let _ = check_and_lower_enum_site_d2(ctx, mapped_pkg, ename, vname, tokens, -1, -1, file, t.line, t.col, in_pattern)
          }
        } else if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen && !tokens[i + 3].newline_before {
          let close_p = find_matching_delim(tokens, i + 3)
          match check_and_lower_enum_site_d2(ctx, mapped_pkg, "", sym_tok.raw, tokens, i + 3, close_p, file, t.line, t.col, in_pattern) {
            Some(args_s) => {
              let full_ctor = match resolve_enum_schema_d2(ctx, mapped_pkg, "", sym_tok.raw) {
                Some((sch, _)) => mapped_pkg + "::" + sch.name + "::" + sym_tok.raw
                None => target_expr
              }
              return (trivia + full_ctor + args_s, close_p + 1)
            }
            None => ()
          }
        } else if !in_pattern {
          let _ = check_and_lower_enum_site_d2(ctx, mapped_pkg, "", sym_tok.raw, tokens, -1, -1, file, t.line, t.col, in_pattern)
        }
      }
      // Check if this is a cross-package struct literal or pattern `@pkg.Struct::{ ... }`
      if i + 4 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 4].kind == TokenKind::LBrace {
        let close_b = find_matching_delim(tokens, i + 4)
        if !in_pattern && close_b > i + 6 && tokens[i + 5].kind == TokenKind::DotDot {
          return (trivia + lower_struct_update_expr(ctx, target_expr, tokens, i + 4, close_b, file), close_b + 1)
        }
        let body = lower_struct_brace(ctx, target_expr, tokens, i + 4, close_b, file, in_pattern)
        return (trivia + target_expr + "::" + body, close_b + 1)
      }
      // Check if this is a call `@pkg.fn(...)`
      if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, i + 3)
        let needs_loc = ctx.symtab.autofill_loc_fns.contains(lookup_key)
        let is_ext = ctx.symtab.external_tilde_fns.contains(lookup_key)
        let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, target_expr, needs_loc, is_ext)
        return (trivia + call_str, close_p + 1)
      }
      return (trivia + target_expr, i + 3)
    }
    return (trivia + mapped_pkg, i + 1)
  }

  // 6. Unqualified `UpperIdent`:
  //    - constructor rest pattern expansion `Ctor(a, ..)` -> `Ctor(a, _, _)` using enum arity
  //    - struct literal cascade `S::{ ... }..init()`
  //    - cross-package enum constructor resolution
  if t.kind == TokenKind::UpperIdent {
    let prev_colon2 = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let prev_dot = i > 0 && tokens[i - 1].kind == TokenKind::Dot
    let next_colon2 = i + 1 < end && tokens[i + 1].kind == TokenKind::ColonColon
    // §D2-4: `const` pattern inlining (both `pub const` and private `const`; fail-closed on non-literal const)
    if in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    !(i + 1 < end && tokens[i + 1].kind == TokenKind::LParen) &&
    !has_local_ctor(ctx.symtab, t.raw) && !ctx.active_generics.contains(t.raw) &&
    !(lookup_scope_var(ctx, t.raw) is Some(_)) {
      match ctx.symtab.const_defs.get(t.raw) {
        Some(cd) =>
        if cd.is_literal {
          return (trivia + cd.literal_pion, i + 1)
        } else {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            t.line,
            t.col,
            "non-literal const `" + t.raw + "` cannot be used as a pattern",
          ))
          return (trivia + t.raw, i + 1)
        }
        None => ()
      }
    }
    // Direct `Ref(expr)` lowering (defaults to `mbt_compat::ref_new`, overridable by `--recipes`)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Ref" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let inner = lower_expr_range(ctx, tokens, i + 2, close_p, file, false).trim()
      return (trivia + effective_ref_ctor(ctx.recipes) + "(" + inner + ")", close_p + 1)
    }
    // Tuple struct construction `TupleStruct(a, b)` -> `TupleStruct::{ _0: a, _1: b }`
    if !in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    ctx.symtab.tuple_structs.contains(t.raw) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let sb = StringBuilder()
      sb.write_string(t.raw + "::{ ")
      let mut ai = i + 2
      let mut fidx = 0
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai {
          if fidx > 0 { sb.write_string(", ") }
          let arg_s = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          sb.write_string("_" + fidx.to_string() + ": " + arg_s)
          fidx = fidx + 1
        }
        ai = ae + 1
      }
      sb.write_string(" }")
      return (trivia + sb.to_string(), close_p + 1)
    }
    // Tuple struct pattern `TupleStruct(p0, p1)` -> `TupleStruct::{ _0: p0, _1: p1 }`
    if in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    ctx.symtab.tuple_structs.contains(t.raw) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let sb = StringBuilder()
      sb.write_string(t.raw + "::{ ")
      let mut pi = i + 2
      let mut fidx = 0
      let mut has_rest = false
      while pi < close_p {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        if tokens[pi].kind == TokenKind::DotDot {
          has_rest = true
          pi = pi + 1
          continue
        }
        let mut pe = pi
        let mut pd = 0
        while pe < close_p {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
          else if pd == 0 && pk == TokenKind::Comma { break }
          pe = pe + 1
        }
        if pe > pi {
          if fidx > 0 { sb.write_string(", ") }
          let pat_s = lower_expr_range(ctx, tokens, pi, pe, file, true).trim()
          sb.write_string("_" + fidx.to_string() + ": " + pat_s)
          fidx = fidx + 1
        }
        pi = pe + 1
      }
      if has_rest {
        if fidx > 0 { sb.write_string(", ..") } else { sb.write_string("..") }
      }
      sb.write_string(" }")
      return (trivia + sb.to_string(), close_p + 1)
    }
    // `Hash::hash(expr)` -> `mbt_compat::mbt_hash(expr)` (guarded against local `Hash` type/trait!)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Hash" &&
    !ctx.symtab.local_types.contains("Hash") &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "hash" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::mbt_hash(" + inner + ")", close_p + 1)
    }
    // `Json::*` constructors, helpers, and patterns -> `mbt_compat::MbtJson::*` (guarded against local `Json`!)
    if !prev_colon2 && !prev_dot && t.raw == "Json" &&
    !ctx.symtab.local_types.contains("Json") &&
    i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon {
      let member = tokens[i + 2].raw
      if member == "Number" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, i + 3)
        let mut pat_v = ""
        let mut repr_arg = ""
        let mut pi = i + 4
        while pi < close_p {
          if tokens[pi].kind == TokenKind::Comma || tokens[pi].kind == TokenKind::DotDot {
            pi = pi + 1
            continue
          }
          let mut pe = pi
          let mut pd = 0
          while pe < close_p {
            let pk = tokens[pe].kind
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
            else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
            else if pd == 0 && pk == TokenKind::Comma { break }
            pe = pe + 1
          }
          if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
          pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Eq {
            if !in_pattern { push_expected_type(ctx, "Option[String]") }
            repr_arg = lower_expr_range(ctx, tokens, pi + 2, pe, file, in_pattern).trim()
            if !in_pattern { pop_expected_type(ctx) }
          } else if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
          pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Tilde {
            repr_arg = "repr"
          } else if pe > pi && pat_v.length() == 0 {
            if !in_pattern { push_expected_type(ctx, "Double") }
            pat_v = lower_expr_range(ctx, tokens, pi, pe, file, in_pattern).trim()
            if !in_pattern { pop_expected_type(ctx) }
          }
          pi = pe + 1
        }
        let inner_v = if pat_v.length() > 0 { pat_v } else if in_pattern { "_" } else { "0.0" }
        let inner_r = if repr_arg.length() > 0 { repr_arg } else if in_pattern { "_" } else { "Option::None" }
        return (trivia + "mbt_compat::MbtJson::Number(" + inner_v + ", " + inner_r + ")", close_p + 1)
      }
      if !in_pattern && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let j_arg_exp = if member == "array" || member == "Array" {
          "Array[mbt_compat::MbtJson]"
        } else if member == "number" {
          "Double"
        } else if member == "boolean" {
          "Bool"
        } else if member == "string" || member == "String" {
          "String"
        } else if member == "object" || member == "Object" {
          "Map[String, mbt_compat::MbtJson]"
        } else {
          ""
        }
        if j_arg_exp.length() > 0 {
          let close_p = find_matching_delim(tokens, i + 3)
          push_expected_type(ctx, j_arg_exp)
          let arg_s = lower_expr_range(ctx, tokens, i + 4, close_p, file, false)
          pop_expected_type(ctx)
          return (
            trivia + "mbt_compat::MbtJson::" + member + tokens[i + 3].leading_trivia + "(" + arg_s + tokens[close_p].leading_trivia + ")",
            close_p + 1,
          )
        }
      }
      if member == "Null" || member == "True" || member == "False" || member == "Number" ||
      member == "String" || member == "Array" || member == "Object" ||
      member == "null" || member == "boolean" || member == "number" ||
      member == "string" || member == "array" || member == "object" {
        return (trivia + "mbt_compat::MbtJson::" + member, i + 3)
      }
    }
    // Unqualified `Number(...)` when expected type is `mbt_compat::MbtJson`, or in pattern position
    // with `..` / `repr=` / `repr~` when unshadowed by any local or imported constructor `Number`
    if !prev_colon2 && !prev_dot && t.raw == "Number" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let exp_is_json = current_expected_type(ctx).trim() == "mbt_compat::MbtJson"
      let unshadowed_number = !has_local_ctor(ctx.symtab, "Number") &&
      !ctx.symtab.ctors.contains("Number") &&
      !ctx.symtab.enum_schemas_by_ctor.contains("Number")
      let is_json_num_pat = exp_is_json || (in_pattern && unshadowed_number && {
        let mut has_m = false
        let mut qi = i + 2
        let mut qd = 0
        while qi < close_p {
          let qk = tokens[qi].kind
          if qk == TokenKind::LParen || qk == TokenKind::LBracket || qk == TokenKind::LBrace { qd = qd + 1 }
          else if qk == TokenKind::RParen || qk == TokenKind::RBracket || qk == TokenKind::RBrace { if qd > 0 { qd = qd - 1 } }
          else if qd == 0 {
            if qk == TokenKind::DotDot { has_m = true; break }
            if qk == TokenKind::Ident && tokens[qi].raw == "repr" && qi + 1 < close_p &&
            (tokens[qi + 1].kind == TokenKind::Eq || tokens[qi + 1].kind == TokenKind::Tilde) {
              has_m = true
              break
            }
          }
          qi = qi + 1
        }
        has_m
      })
      if is_json_num_pat {
        let mut pat_v = ""
        let mut repr_arg = ""
        let mut pos_count = 0
        let mut pi = i + 2
        while pi < close_p {
          if tokens[pi].kind == TokenKind::Comma || tokens[pi].kind == TokenKind::DotDot {
            pi = pi + 1
            continue
          }
          let mut pe = pi
          let mut pd = 0
          while pe < close_p {
            let pk = tokens[pe].kind
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
