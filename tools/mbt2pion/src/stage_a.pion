        let mut ue = ui
        let mut ud = 0
        while ue < close_p {
          let uk = tokens[ue].kind
          if uk == TokenKind::LParen || uk == TokenKind::LBracket || uk == TokenKind::LBrace { ud = ud + 1 }
          else if uk == TokenKind::RParen || uk == TokenKind::RBracket || uk == TokenKind::RBrace { ud = ud - 1 }
          else if ud == 0 && uk == TokenKind::Comma { break }
          ue = ue + 1
        }
        if ue > ui { raw_uargs.push((ui, ue)) }
        ui = ue + 1
      }
      if raw_uargs.length() >= 1 {
        let (t_ptys, t_rty) : (Array[String], String) = match ctx.trait_methods.get(t.raw) {
          Some(mm) => match mm.get(mname) { Some(sig) => sig, None => ([], "") }
          None => ([], "")
        }
        if t_ptys.length() >= 1 && t_ptys[0] == "Self" {
          let recv_s = lower_expr_range(ctx, tokens, raw_uargs[0].0, raw_uargs[0].1, file, false).trim()
          let arg_sb = StringBuilder()
          let mut ai = 1
          while ai < raw_uargs.length() {
            if ai > 1 { arg_sb.write_string(", ") }
            let exp_pt = if ai < t_ptys.length() { t_ptys[ai] } else { "" }
            if exp_pt.length() > 0 && exp_pt != "Self" { push_expected_type(ctx, exp_pt) }
            arg_sb.write_string(lower_expr_range(ctx, tokens, raw_uargs[ai].0, raw_uargs[ai].1, file, false).trim())
            if exp_pt.length() > 0 && exp_pt != "Self" { pop_expected_type(ctx) }
            ai = ai + 1
          }
          let rest_args = arg_sb.to_string()
          let obj_safe = is_trait_object_safe(ctx, t.raw)
          if obj_safe && ctx.active_generics.length() == 0 {
            return (trivia + "((" + recv_s + ") as dyn " + t.raw + ")." + mname + "(" + rest_args + ")", close_p + 1)
          }
          let fwd_key = t.raw + "::" + mname
          let fwd_name = match ctx.ufcs_forwarders.get(fwd_key) {
            Some(existing) => existing
            None => {
              let mut cand = "__mbt_ufcs_" + ctx.ufcs_seq.to_string()
              ctx.ufcs_seq = ctx.ufcs_seq + 1
              while ufcs_name_collides(ctx, cand) {
                cand = "__mbt_ufcs_" + ctx.ufcs_seq.to_string()
                ctx.ufcs_seq = ctx.ufcs_seq + 1
              }
              ctx.used_idents[cand] = true
              ctx.ufcs_forwarders[fwd_key] = cand
              let fp_sb = StringBuilder()
              let fa_sb = StringBuilder()
              fp_sb.write_string("__mbt_r : __MbtT")
              let mut pi = 1
              while pi < t_ptys.length() {
                let pty_sub = replace_self_type_in_pion(t_ptys[pi], "__MbtT")
                fp_sb.write_string(", _a" + pi.to_string() + " : " + pty_sub)
                if pi > 1 { fa_sb.write_string(", ") }
                fa_sb.write_string("_a" + pi.to_string())
                pi = pi + 1
              }
              let ret_part = if t_rty.length() > 0 {
                " -> " + replace_self_type_in_pion(t_rty, "__MbtT")
              } else {
                ""
              }
              ctx.lifted_fns.push(
                "fn " + cand + "[__MbtT : " + t.raw + "](" + fp_sb.to_string() + ")" + ret_part + " {\n  __mbt_r." + mname + "(" + fa_sb.to_string() + ")\n}\n"
              )
              cand
            }
          }
          if obj_safe {
            let tail = if rest_args.length() > 0 { ", " + rest_args } else { "" }
            return (trivia + "mbt_compat::__mbt_ufcs_dispatch(" + recv_s + ", \"" + mname + "\", \"" + fwd_name + "\"" + tail + ")", close_p + 1)
          }
          let all_args = if rest_args.length() > 0 { recv_s + ", " + rest_args } else { recv_s }
          return (trivia + fwd_name + "(" + all_args + ")", close_p + 1)
        }
      }
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Map" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      let inner = lower_type_tokens_checked(ctx, tokens, i + 2, close_b, file)
      return (trivia + "mbt_compat::OrderedMap[" + inner + "]", close_b + 1)
    }
    // `Ref::new(x)` -> `mbt_compat::mbt_ref(x)` (or recipe `ref_recipe.ctor_call`) when `Ref` is unshadowed
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Ref" &&
    !ctx.symtab.local_types.contains("Ref") && !ctx.active_generics.contains("Ref") &&
    !(lookup_scope_var(ctx, "Ref") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "new" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + effective_ref_ctor(ctx.recipes) + "(" + inner + ")", close_p + 1)
    }
    // `Set::new()` / `Set::from_array(...)` / `Set::from_iter(...)` (guarded against local/generic `Set`)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.symtab.local_value_names.contains("Set") &&
    !ctx.active_generics.contains("Set") && !(lookup_scope_var(ctx, "Set") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let mname = tokens[i + 2].raw
      if mname == "new" && close_p == i + 4 {
        return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
      }
      if mname == "from_array" {
        let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
      }
      if mname == "from_iter" {
        let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
      }
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.symtab.local_value_names.contains("Set") &&
    !ctx.symtab.local_fn_names.contains("Set") && !ctx.active_generics.contains("Set") &&
    !(lookup_scope_var(ctx, "Set") is Some(_)) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let inner = lower_expr_range(ctx, tokens, i + 2, close_p, file, false).trim()
      return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.active_generics.contains("Set") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      let inner = lower_type_tokens_checked(ctx, tokens, i + 2, close_b, file)
      return (trivia + "mbt_compat::OrderedSet[" + inner + "]", close_b + 1)
    }
    // Qualified `Enum::Variant(...)` or `Enum::Variant` labeled enum ctor/pattern & readonly visibility check
    if !prev_colon2 && !prev_dot && i + 2 < end &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::UpperIdent {
      let ename = if !ctx.symtab.local_types.contains(t.raw) {
        match ctx.symtab.using_types.get(t.raw) {
          Some(ut) => ut
          None => t.raw
        }
      } else {
        t.raw
      }
      let vname = tokens[i + 2].raw
      if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen && !tokens[i + 3].newline_before {
        let close_p = find_matching_delim(tokens, i + 3)
        match check_and_lower_enum_site_d2(ctx, "", ename, vname, tokens, i + 3, close_p, file, t.line, t.col, in_pattern) {
          Some(args_s) => return (trivia + ename + "::" + vname + args_s, close_p + 1)
          None => ()
        }
      } else {
        let _ = check_and_lower_enum_site_d2(ctx, "", ename, vname, tokens, -1, -1, file, t.line, t.col, in_pattern)
      }
    }
    let ctor_exp_ty = {
      let cur_e = current_expected_type(ctx).trim()
      if !in_pattern && (cur_e.length() == 0 || cur_e == "Bool") && !prev_colon2 && !prev_dot && !next_colon2 {
        let op_i = if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before {
          find_matching_delim(tokens, i + 1) + 1
        } else {
          i + 1
        }
        if op_i + 1 < end && (tokens[op_i].kind == TokenKind::EqEq || tokens[op_i].kind == TokenKind::BangEq) {
          let re = find_eq_rhs_end_f3d2(tokens, op_i + 1, end)
          let rty = infer_simple_expr_type(ctx, tokens, op_i + 1, re).trim()
          if rty.length() > 0 { rty } else { cur_e }
        } else {
          cur_e
        }
      } else {
        cur_e
      }
    }
    let head_name = if !prev_colon2 && !prev_dot && !next_colon2 {
      match resolve_ctor_at_site(ctx.symtab, t.raw, ctor_exp_ty, in_pattern, ctx.active_generics, file, t.line, t.col, ctx.diags) {
        Some(resolved) =>
        if ctx.inferred_exp_depth > 0 && !in_pattern && resolved.starts_with(".") {
          let eb = strip_type_args_sym(ctor_exp_ty)
          if eb.length() > 0 { eb + "::" + resolved.slice(1, resolved.length()) } else { resolved }
        } else {
          resolved
        }
        None =>
        if !in_pattern && !has_local_ctor(ctx.symtab, t.raw) && !ctx.symtab.local_value_names.contains(t.raw) && !ctx.active_generics.contains(t.raw) {
          match ctx.symtab.using_values.get(t.raw) {
            Some(uv) => uv
            None => t.raw
          }
        } else {
          t.raw
        }
      }
    } else if !prev_colon2 && !prev_dot && next_colon2 && !ctx.symtab.local_types.contains(t.raw) && !ctx.active_generics.contains(t.raw) {
      match ctx.symtab.using_types.get(t.raw) {
        Some(ut) => ut
        None => t.raw
      }
    } else {
      t.raw
    }
    // Bare `Variant(...)` or `Variant` labeled enum ctor/pattern & readonly visibility check
    if !prev_colon2 && !prev_dot && !next_colon2 {
      if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before {
        let close_p = find_matching_delim(tokens, i + 1)
        match check_and_lower_enum_site_d2(ctx, "", "", t.raw, tokens, i + 1, close_p, file, t.line, t.col, in_pattern) {
          Some(args_s) => return (trivia + head_name + args_s, close_p + 1)
          None => ()
        }
      } else {
        let _ = check_and_lower_enum_site_d2(ctx, "", "", t.raw, tokens, -1, -1, file, t.line, t.col, in_pattern)
      }
    }

    // Propagate `Option[T]` / `Result[T, E]` inner type into `Some(...)` / `Ok(...)` / `Err(...)` (both expr & pattern!)
    if !prev_colon2 && !prev_dot && (t.raw == "Some" || t.raw == "Ok" || t.raw == "Err") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before &&
    !has_local_ctor(ctx.symtab, t.raw) {
      let exp_wrap = current_expected_type(ctx).trim()
      let inner_ty = if t.raw == "Some" {
        unwrap_option_type_str(exp_wrap)
      } else if t.raw == "Ok" {
        unwrap_result_type_str(exp_wrap).0
      } else {
        unwrap_result_type_str(exp_wrap).1
      }
      if inner_ty.length() > 0 {
        let close_p = find_matching_delim(tokens, i + 1)
        if close_p > i + 1 {
          let saved_wexp = ctx.expected_type_stack.length()
          push_expected_type(ctx, inner_ty)
          let inner_s = lower_expr_range(ctx, tokens, i + 2, close_p, file, in_pattern).trim()
          restore_expected_type_stack(ctx, saved_wexp)
          return (trivia + t.raw + "(" + inner_s + ")", close_p + 1)
        }
      }
    }

    // In pattern context: check `Ctor(..., ..)` / `Ctor(..)` / `Ctor(.., ..)` rest pattern expansion!
    if in_pattern && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let raw_pats : Array[(Int, Int)] = []
      let mut has_rest = false
      let mut rest_pos = -1
      let mut pi = i + 2
      while pi < close_p {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        let mut pe = pi
        let mut pd = 0
        while pe < close_p {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
            pd = pd + 1
          } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
            pd = pd - 1
          } else if pd == 0 && pk == TokenKind::Comma {
            break
          }
          pe = pe + 1
        }
        if pe == pi + 1 && tokens[pi].kind == TokenKind::DotDot {
          has_rest = true
          if rest_pos < 0 {
            rest_pos = raw_pats.length()
          }
        } else {
          raw_pats.push((pi, pe))
        }
        pi = pe + 1
      }
      if has_rest {
        let arity = lookup_ctor_arity(ctx.symtab, t.raw)
        if arity < 0 || arity < raw_pats.length() {
          ctx.diags.push(diag_error(
            "MBT2PION_MANUAL",
            file,
            t.line,
            t.col,
            "cannot expand constructor rest pattern `" + t.raw + "(.., ..)` because variant arity is unknown",
          ))
          let fb = StringBuilder()
          fb.write_string(trivia + head_name + "(")
          let mut fi = 0
          while fi < raw_pats.length() {
            if fi > 0 { fb.write_string(", ") }
            let (s, e) = raw_pats[fi]
            fb.write_string(lower_expr_range(ctx, tokens, s, e, file, true).trim())
            fi = fi + 1
          }
          if raw_pats.length() > 0 { fb.write_string(", ") }
          fb.write_string("_)")
          return (fb.to_string(), close_p + 1)
        }
        let psb = StringBuilder()
        psb.write_string(trivia + head_name + "(")
        let missing = arity - raw_pats.length()
        let insert_at = if rest_pos >= 0 { rest_pos } else { raw_pats.length() }
        let mut emitted = 0
        let mut idx = 0
        while idx < raw_pats.length() {
          if idx == insert_at {
            let mut m = 0
            while m < missing {
              if emitted > 0 {
                psb.write_string(", ")
              }
              psb.write_string("_")
              emitted = emitted + 1
              m = m + 1
            }
          }
          if emitted > 0 {
            psb.write_string(", ")
          }
          let (s, e) = raw_pats[idx]
          psb.write_string(lower_expr_range(ctx, tokens, s, e, file, true).trim())
          emitted = emitted + 1
          idx = idx + 1
        }
        if insert_at == raw_pats.length() {
          let mut m = 0
          while m < missing {
            if emitted > 0 {
              psb.write_string(", ")
            }
            psb.write_string("_")
            emitted = emitted + 1
            m = m + 1
          }
        }
        psb.write_string(")")
        return (psb.to_string(), close_p + 1)
      }
    }

    // Struct literal or struct destructuring pattern `S::{ ... }` (with collision-free field renaming & cascade)
    if i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::LBrace {
      let close_b = find_matching_delim(tokens, i + 2)
      let struct_lit = if !in_pattern && close_b > i + 4 && tokens[i + 3].kind == TokenKind::DotDot {
        lower_struct_update_expr(ctx, head_name, tokens, i + 2, close_b, file)
      } else {
        head_name + "::" + lower_struct_brace(ctx, t.raw, tokens, i + 2, close_b, file, in_pattern)
      }
      if !in_pattern && close_b + 1 < end && tokens[close_b + 1].kind == TokenKind::DotDot &&
      close_b + 2 < end && tokens[close_b + 2].kind == TokenKind::Ident {
        return lower_cascade_chain(ctx, trivia, struct_lit, tokens, close_b + 1, end, file)
      }
      return (trivia + struct_lit, close_b + 1)
    }

    return (trivia + head_name, i + 1)
  }

  // 7. Identifier: check for `letrec`, test assertions, cascade `recv..m1()..m2()`, slicing `xs[a:b]` & `a.b[lo:hi]`, call with `loc`/external `x?`, or keyword rename
  if t.kind == TokenKind::Ident {
    let prev_dot = i > 0 && tokens[i - 1].kind == TokenKind::Dot
    if !in_pattern && !prev_dot && t.raw == "letrec" {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        t.line,
        t.col,
        "unsupported MoonBit `letrec` syntax (requires explicit lowering or overlay)",
      ))
      return (trivia + t.raw, i + 1)
    }
    // §1: Never emit bare `.val` (keyword in Pion -> parse cascade); emit a registered collision-free
    // placeholder for field access, or `val_` for method calls `.val(...)`!
    let prev_cc_id = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let is_val_method_call = prev_dot && t.raw == "val" && i + 1 < end &&
    tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before
    let base_name = if prev_dot && t.raw == "val" && !is_val_method_call {
      if should_defer_val_assign_to_a5(ctx, tokens, i - 1, i + 1, end) {
        alloc_fresh_val_placeholder(ctx, t.line, t.col)
      } else {
        match try_resolve_static_val_field(ctx, tokens, i - 1) {
          Some(resolved_f) => resolved_f
          None => alloc_fresh_val_placeholder(ctx, t.line, t.col)
        }
      }
    } else if !prev_dot && !prev_cc_id && (!in_pattern || !(i + 1 < end && tokens[i + 1].kind == TokenKind::Colon)) {
      resolve_ident_in_scope(ctx, t.raw)
    } else {
      rename_keyword_ident(t.raw)
    }
    let name_bb = if ctx.cur_is_blackbox && !in_pattern && !prev_dot && !prev_cc_id &&
    !(lookup_scope_var(ctx, base_name) is Some(_)) && !ctx.lifted_local_fns.contains(base_name) {
      match ctx.symtab.blackbox_colliding_privs.get(t.raw) {
        Some(renamed) => renamed
        None => base_name
      }
    } else {
      base_name
    }
    let name = if !in_pattern && !prev_dot && !prev_cc_id &&
    !(lookup_scope_var(ctx, name_bb) is Some(_)) && !ctx.lifted_local_fns.contains(name_bb) &&
    !ctx.symtab.local_value_names.contains(t.raw) && !ctx.symtab.local_fn_names.contains(t.raw) {
      match ctx.symtab.using_values.get(t.raw) {
        Some(uv) => uv
        None => name_bb
      }
    } else {
      name_bb
    }
    let mut next_i = i + 1

    // Check direct call to a lifted recursive local `fn` -> call lifted top-level symbol with env_args!
    if !in_pattern && !prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      match ctx.lifted_local_fns.get(name) {
        Some(lf) => {
          let close_p = find_matching_delim(tokens, next_i)
          let inner_call = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, "", false, false)
          // `inner_call` is `(a, b)` -> prepend `env_args`
          let inner_args = if inner_call.length() >= 2 { inner_call.slice(1, inner_call.length() - 1).trim() } else { "" }
          let full_args = if lf.env_args.length() > 0 && inner_args.length() > 0 {
            join_comma(lf.env_args) + ", " + inner_args
          } else if lf.env_args.length() > 0 {
            join_comma(lf.env_args)
          } else {
            inner_args
          }
          return (trivia + lf.lifted_name + "(" + full_args + ")", close_p + 1)
        }
        None => ()
      }
    }

    // Check MoonBit builtin test assertions (`assert_eq`, `assert_not_eq`, `assert_true`, `assert_false`, `fail`, `inspect`).
    // P0-2: Black-box `*_test.mbt` files ONLY check their own file's decls + local scope (never pollute or read
    //       production/white-box `symtab`, and production/white-box NEVER read black-box `*_test.mbt` decls!).
    // P0-3: Bind ALL arguments (positional + `msg=`/`content=`/`loc=` named args) in exact left-to-right source
    //       order so side effects (e.g. `msg={ n = n + 1; "..." }` or `msg=abort(...)`) always execute!
    let prev_cc = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let is_cur_blackbox = file.ends_with("_test.mbt") && !file.ends_with("_wbtest.mbt")
    let is_shadowed_assert = if is_cur_blackbox {
      ctx.symtab.blackbox_decls.contains(t.raw) ||
      ctx.symtab.prod_pub_decls.contains(t.raw) ||
      ctx.lifted_local_fns.contains(name) ||
      (lookup_scope_var(ctx, name) is Some(_))
    } else {
      ctx.symtab.local_value_names.contains(t.raw) ||
      ctx.symtab.local_fn_names.contains(t.raw) ||
      ctx.symtab.fn_param_types.contains(t.raw) ||
      ctx.symtab.fn_ret_types.contains(t.raw) ||
      ctx.symtab.autofill_loc_fns.contains(t.raw) ||
      ctx.symtab.external_tilde_fns.contains(t.raw) ||
      ctx.lifted_local_fns.contains(name) ||
      (lookup_scope_var(ctx, name) is Some(_))
    }
    if !in_pattern && !prev_dot && !prev_cc && !is_shadowed_assert && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before &&
    (t.raw == "assert_eq" || t.raw == "assert_not_eq" || t.raw == "assert_true" || t.raw == "assert_false" || t.raw == "fail" || t.raw == "inspect" || t.raw == "debug_inspect") {
      let close_p = find_matching_delim(tokens, next_i)
      // Opus P2-1: Evaluate assertion arguments in MoonBit parameter declaration order
      // (positional args first, then `msg=`/`content=`, then `loc=`), matching Moon native & wasm-gc!
      let pos_binds : Array[String] = []
      let msg_binds : Array[String] = []
      let content_binds : Array[String] = []
      let loc_binds : Array[String] = []
      let other_binds : Array[String] = []
      let pos_temps : Array[String] = []
      let mut msg_temp = ""
      let mut content_temp = ""
      let mut has_unsupported_arg = false
      let mut ai = next_i + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = tokens[ai].raw
          let rhs = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          let tmp = fresh_temp(ctx, "aa")
          let ty_ann = if lbl == "msg" || lbl == "content" || lbl == "loc" { " : String" } else { "" }
          let stmt = "let " + tmp + ty_ann + " = " + rhs + "; "
          if lbl == "msg" {
            msg_temp = tmp
            msg_binds.push(stmt)
          } else if lbl == "content" {
            content_temp = tmp
            content_binds.push(stmt)
          } else if lbl == "loc" {
            loc_binds.push(stmt)
          } else {
            has_unsupported_arg = true
            other_binds.push(stmt)
          }
        } else if ae == ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          let lbl = tokens[ai].raw
          let tmp = fresh_temp(ctx, "aa")
          let ty_ann = if lbl == "msg" || lbl == "content" || lbl == "loc" { " : String" } else { "" }
          let stmt = "let " + tmp + ty_ann + " = " + rename_keyword_ident(lbl) + "; "
          if lbl == "msg" {
            msg_temp = tmp
            msg_binds.push(stmt)
          } else if lbl == "content" {
            content_temp = tmp
            content_binds.push(stmt)
          } else if lbl == "loc" {
            loc_binds.push(stmt)
          } else {
            has_unsupported_arg = true
            other_binds.push(stmt)
          }
        } else if ae > ai {
          let rhs = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          if (t.raw == "assert_eq" || t.raw == "assert_not_eq") && (rhs == "None" || rhs == "[]") {
            // Pure polymorphic literals stay inline so Pion bidirectional inference sees the other operand's type!
            pos_temps.push(rhs)
          } else {
            let tmp = fresh_temp(ctx, "aa")
            pos_binds.push("let " + tmp + " = " + rhs + "; ")
            pos_temps.push(tmp)
          }
        }
        ai = ae + 1
      }
      if has_unsupported_arg {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          t.line,
          t.col,
          "unsupported named argument in assertion `" + t.raw + "`",
        ))
      }
      let pre = join_str_array(pos_binds) + join_str_array(msg_binds) + join_str_array(content_binds) + join_str_array(loc_binds) + join_str_array(other_binds)
      let loc_str = "\"" + file + ":" + t.line.to_string() + "\""
      let msg_suffix = if msg_temp.length() > 0 { " + \": \" + " + msg_temp } else { "" }
      if t.raw == "assert_eq" && pos_temps.length() >= 2 {
        return (trivia + "{ " + pre + "if !(" + pos_temps[0] + " == " + pos_temps[1] + ") { panic(\"assert_eq failed at " + file + ":" + t.line.to_string() + "\"" + msg_suffix + ") } }", close_p + 1)
      }
      if t.raw == "assert_not_eq" && pos_temps.length() >= 2 {
        return (trivia + "{ " + pre + "if " + pos_temps[0] + " == " + pos_temps[1] + " { panic(\"assert_not_eq failed at " + file + ":" + t.line.to_string() + "\"" + msg_suffix + ") } }", close_p + 1)
      }
      if t.raw == "assert_true" && pos_temps.length() >= 1 {
        if msg_temp.length() > 0 {
          return (trivia + "{ " + pre + "if !(" + pos_temps[0] + ") { panic(\"assertion failed at " + file + ":" + t.line.to_string() + ": \" + " + msg_temp + ") } }", close_p + 1)
        }
        return (trivia + "{ " + pre + "mbt_compat::assert_true(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "assert_false" && pos_temps.length() >= 1 {
        if msg_temp.length() > 0 {
          return (trivia + "{ " + pre + "if " + pos_temps[0] + " { panic(\"assertion failed at " + file + ":" + t.line.to_string() + ": \" + " + msg_temp + ") } }", close_p + 1)
        }
        return (trivia + "{ " + pre + "mbt_compat::assert_false(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "fail" && pos_temps.length() >= 1 {
        // §7 Effect-Safe `fail(...)` -> `panic(...)`: ONLY when unshadowed, NOT inside any
        // closure/lambda, NOT inside `try ... catch`, and inside top-level `test` or non-`raise` fn!
        if ctx.in_closure_depth > 0 || ctx.in_try_catch_depth > 0 || (ctx.cur_fn_is_raising && !ctx.cur_in_test_block) {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            t.line,
            t.col,
            "`fail(...)` inside a closure, `raise` function, or `try ... catch` cannot be safely lowered to `panic` (fail-closed)",
          ))
        }
        return (trivia + "{ " + pre + "mbt_compat::fail(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "inspect" && pos_temps.length() >= 1 && content_temp.length() > 0 {
        return (trivia + "{ " + pre + "mbt_compat::inspect_eq((" + pos_temps[0] + ").to_string(), " + content_temp + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "debug_inspect" && pos_temps.length() >= 1 && content_temp.length() > 0 {
        return (trivia + "{ " + pre + "mbt_compat::inspect_eq(mbt_compat::__mbt_debug_fmt(" + pos_temps[0] + "), " + content_temp + ", " + loc_str + ") }", close_p + 1)
      }
    }
    // Bare `println(x)` (no `World` receiver, unshadowed) -> `mbt_compat::mbt_println((x).to_string())`
    if !in_pattern && !prev_dot && !prev_cc && !is_shadowed_assert && t.raw == "println" &&
    next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let inner = lower_expr_range(ctx, tokens, next_i + 1, close_p, file, false).trim()
      if inner.length() == 0 {
        return (trivia + "mbt_compat::mbt_println(\"\")", close_p + 1)
      }
      return (trivia + "mbt_compat::mbt_println((" + inner + ").to_string())", close_p + 1)
    }

    // Check boxed mutable outer variable captured by lifted recursive local `fn` -> `name.v`
    if !in_pattern && !prev_dot && !(i > 0 && tokens[i - 1].kind == TokenKind::ColonColon) {
      match lookup_scope_var(ctx, name) {
        Some(sv) =>
        if sv.is_boxed {
          // Reject storing an escaping recursive local fn as a VALUE into a captured mutable cell (cycle risk!)
          if next_i < end && tokens[next_i].kind == TokenKind::Eq {
            let rhs_end = find_expr_end(tokens, next_i + 1, end)
            for lfk in ctx.lifted_local_fns.keys() {
              if is_local_fn_used_as_value(tokens, next_i + 1, rhs_end, lfk) {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  file,
                  t.line,
                  t.col,
                  "storing recursive local fn `" + lfk + "` into captured mutable cell `" + name + "` may form an RC cycle",
                ))
              }
            }
          }
          return (trivia + name + ".v", next_i)
        }
        None => ()
      }
    }

    // `.replace_all(old=a, new=b)` -> `.replace(a, b)`
    if !in_pattern && prev_dot && t.raw == "replace_all" && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let mut old_e = ""
      let mut new_e = ""
      let pos_args : Array[String] = []
      let mut ai = next_i + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = tokens[ai].raw
          let rhs = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          if lbl == "old" { old_e = rhs } else if lbl == "new" { new_e = rhs }
        } else if ae > ai {
          pos_args.push(lower_expr_range(ctx, tokens, ai, ae, file, false).trim())
        }
        ai = ae + 1
      }
      if old_e.length() == 0 && pos_args.length() >= 1 { old_e = pos_args[0] }
      if new_e.length() == 0 && pos_args.length() >= 2 { new_e = pos_args[1] }
      if old_e.length() > 0 && new_e.length() > 0 {
        return (trivia + "replace(" + old_e + ", " + new_e + ")", close_p + 1)
      }
    }

    // §5: Fail-closed gate on raising callbacks passed to `.retain(cb)` / `.filter_map(cb)`
    // (Astra P0-1 / P1-2: receiver-mutation gate runs in Stage B only once `pionc` confirms `Array[...]`!)
    if !in_pattern && prev_dot && (t.raw == "retain" || t.raw == "filter_map") &&
    next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      check_non_raising_callback(ctx, tokens, next_i + 1, close_p, t.raw, file, t.line, t.col)
    }

    // Check method call `recv.method(...)` with expected-type guidance from `Type::method` or unique method signature
    if !in_pattern && prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let mut method_key = ""
      if i >= 2 && tokens[i - 2].kind == TokenKind::Ident {
        match lookup_scope_var(ctx, rename_keyword_ident(tokens[i - 2].raw)) {
          Some(sv) => {
            let rbase = strip_type_args_sym(sv.ty)
            if rbase.length() > 0 && ctx.symtab.fn_param_types.contains(rbase + "::" + t.raw) {
              method_key = "__dot__::" + rbase + "::" + t.raw
            }
          }
          None => ()
        }
      }
      if method_key.length() == 0 && i >= 2 &&
      (tokens[i - 2].kind == TokenKind::RParen || tokens[i - 2].kind == TokenKind::RBracket || tokens[i - 2].kind == TokenKind::Ident) {
        let recv_s = find_dot_receiver_start_f3d2(tokens, 0, i - 1)
        if recv_s >= 0 && recv_s < i - 1 {
          let rty = infer_simple_expr_type(ctx, tokens, recv_s, i - 1)
          let rbase = strip_type_args_sym(rty)
          if rbase.length() > 0 && ctx.symtab.fn_param_types.contains(rbase + "::" + t.raw) {
            method_key = "__dot__::" + rbase + "::" + t.raw
          }
        }
      }
      if method_key.length() == 0 && ctx.symtab.method_unique_param_types.contains(t.raw) {
        method_key = "__method__::" + t.raw
      }
      if method_key.length() > 0 {
        let close_p = find_matching_delim(tokens, next_i)
        let call_str = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, method_key, false, false)
        // Replace `method_key` prefix back with `name`
        let args_only = if call_str.starts_with(method_key) {
          call_str.slice(method_key.length(), call_str.length())
        } else {
          call_str
        }
        return (trivia + name + args_only, close_p + 1)
      }
    }

    // Check function call `foo(...)` or `Type::method(...)` — NEVER merge a newline-separated trailing tuple `(a, b)` into a call!
    if !in_pattern && !prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let type_qual = if prev_cc && i >= 2 && tokens[i - 2].kind == TokenKind::UpperIdent {
        tokens[i - 2].raw + "::" + t.raw
      } else {
        name
      }
      // `@pkg.Type::method(...)`: the dependency's signature is keyed `pkg::Type::method`; prefer it when known so
      // arguments get the dependency's parameter types (e.g. a bare `Alpha` resolves against `pkg::MaskType`).
      let pkg_qual = if type_qual != name && i >= 4 && tokens[i - 3].kind == TokenKind::Dot &&
      tokens[i - 4].kind == TokenKind::PkgRef {
        let raw_pkg = tokens[i - 4].raw.slice(1, tokens[i - 4].raw.length())
        let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
          Some(p) => p
          None => raw_pkg
        }
        mapped_pkg + "::" + type_qual
      } else {
        ""
      }
      let qual_lookup = if pkg_qual.length() > 0 && ctx.symtab.fn_param_types.contains(pkg_qual) {
        pkg_qual
      } else {
        type_qual
      }
      let needs_loc = if ctx.cur_is_blackbox {
        if ctx.symtab.blackbox_decls.contains(t.raw) {
          ctx.symtab.blackbox_autofill_loc_fns.contains(t.raw)
        } else {
          ctx.symtab.autofill_loc_fns.contains(qual_lookup) || ctx.symtab.autofill_loc_fns.contains(t.raw)
        }
      } else {
        ctx.symtab.autofill_loc_fns.contains(qual_lookup) || ctx.symtab.autofill_loc_fns.contains(t.raw)
      }
      let is_ext = ctx.symtab.external_tilde_fns.contains(qual_lookup) || ctx.symtab.external_tilde_fns.contains(t.raw)
      let call_raw = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, qual_lookup, needs_loc, is_ext)
      let call_str = if qual_lookup != name && call_raw.starts_with(qual_lookup) {
        name + call_raw.slice(qual_lookup.length(), call_raw.length())
      } else {
        call_raw
      }
      // Check if followed by `.map(fn(x) { ... })` where `qual_lookup` returns `Option[T]` / `Array[T]`
      if close_p + 3 < end && tokens[close_p + 1].kind == TokenKind::Dot &&
      tokens[close_p + 2].kind == TokenKind::Ident && tokens[close_p + 2].raw == "map" &&
      tokens[close_p + 3].kind == TokenKind::LParen {
        let map_cp = find_matching_delim(tokens, close_p + 3)
        let ret_ty = match ctx.symtab.fn_ret_types.get(qual_lookup) {
          Some(r) => r.trim()
          None => ""
        }
        let inner_ty = if ret_ty.starts_with("Option[") && ret_ty.ends_with("]") {
          ret_ty.slice(7, ret_ty.length() - 1).trim()
        } else {
          extract_container_value_type(ret_ty)
        }
        match lower_single_param_method_closure(ctx, tokens, close_p + 4, map_cp, end, file, "map", inner_ty) {
          Some(cl_s) => return (trivia + call_str + ".map(" + cl_s + ")", map_cp + 1)
          None => ()
        }
      }
      // Check if followed by cascade `..m()`!
      if close_p + 1 < end && tokens[close_p + 1].kind == TokenKind::DotDot &&
      close_p + 2 < end && tokens[close_p + 2].kind == TokenKind::Ident {
        return lower_cascade_chain(ctx, trivia, call_str, tokens, close_p + 1, end, file)
      }
      return (trivia + call_str, close_p + 1)
    }

    // Check slice `xs[a:b]`
    if !in_pattern && next_i < end && tokens[next_i].kind == TokenKind::LBracket {
      let close_br = find_matching_delim(tokens, next_i)
      // Look for top-level `:` inside `[...]`
      let mut colon_i = -1
      let mut k = next_i + 1
      let mut d = 0
      while k < close_br {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
          d = d + 1
        } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
          d = d - 1
        } else if d == 0 && kk == TokenKind::Colon {
          colon_i = k
          break
        }
        k = k + 1
      }
      if colon_i >= 0 {
        let own_exempt = ctx.direct_owned_slice_arg
        ctx.direct_owned_slice_arg = false
        let lo = if colon_i > next_i + 1 {
          lower_expr_range(ctx, tokens, next_i + 1, colon_i, file, false).trim()
        } else {
          "0"
        }
        let hi = if close_br > colon_i + 1 {
          lower_expr_range(ctx, tokens, colon_i + 1, close_br, file, false).trim()
        } else {
          name + ".length()"
        }
        let (sl_helper, next_after, extra_arg) = classify_slice_consumer(ctx, tokens, close_br, end, own_exempt, false, ctx.in_interp_top, t.raw, file)
        if sl_helper == "mbt_compat::__mbt_slice_borrow" && (ctx.borrowed_bufs.contains(name) || ctx.borrowed_views.contains(name)) {
          ctx.drift_ledger.push(DriftEntry::{
            category: "array_view_slice",
            file: file,
            line: t.line,
            col: t.col,
            expr: name + "[" + lo + ":" + hi + "]",
            resolution: "mbt_compat::ArrayView::view",
            status: "resolved",
            detail: "borrowed slice lowered to backing-stable ArrayBuf/ArrayView::view",
          })
          return (trivia + name + ".view(" + lo + ", " + hi + ")", close_br + 1)
        }
        let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
        return (trivia + sl_helper + "(" + name + ", " + lo + ", " + hi + extra_tail + ")", next_after)
      }
      // Indexing `a[i]` or `a[i] = rhs` on a promoted `ArrayBuf` / `ArrayView`
      if ctx.borrowed_bufs.contains(name) || ctx.borrowed_views.contains(name) {
        let idx_s = lower_expr_range(ctx, tokens, next_i + 1, close_br, file, false).trim()
        if close_br + 1 < end && tokens[close_br + 1].kind == TokenKind::Eq {
          let rhs_end = find_expr_end(tokens, close_br + 2, end)
          let rhs_s = lower_expr_range(ctx, tokens, close_br + 2, rhs_end, file, false).trim()
          return (trivia + name + ".set(" + idx_s + ", " + rhs_s + ")", rhs_end)
        }
        return (trivia + name + ".get(" + idx_s + ")", close_br + 1)
      }
      // Container index assignment `c[k] = rhs`: propagate container value type as expected type for `rhs`!
      if close_br + 1 < end && tokens[close_br + 1].kind == TokenKind::Eq {
        let cty = lookup_ident_static_type(ctx, t.raw)
        let vty = if cty.length() > 0 { extract_container_value_type(cty) } else { "" }
        if vty.length() > 0 {
          let idx_s = lower_expr_range(ctx, tokens, next_i + 1, close_br, file, false)
          let rhs_end = find_expr_end(tokens, close_br + 2, end)
          push_expected_type(ctx, vty)
          let rhs_s = lower_expr_range(ctx, tokens, close_br + 2, rhs_end, file, false)
          pop_expected_type(ctx)
          return (trivia + name + tokens[next_i].leading_trivia + "[" + idx_s + tokens[close_br].leading_trivia + "]" + tokens[close_br + 1].leading_trivia + "=" + rhs_s, rhs_end)
        }
      }
    }

    // Local field `.map(fn(x) { ... })` where `recv.field` has `Option[T]` / `Array[T]` static type:
    if !in_pattern && !prev_dot && !prev_cc &&
    next_i + 4 < end && tokens[next_i].kind == TokenKind::Dot &&
    tokens[next_i + 1].kind == TokenKind::Ident && tokens[next_i + 2].kind == TokenKind::Dot &&
    tokens[next_i + 3].kind == TokenKind::Ident && tokens[next_i + 3].raw == "map" &&
    tokens[next_i + 4].kind == TokenKind::LParen {
      let base_ty = lookup_ident_static_type(ctx, t.raw)
      let fty = if base_ty.length() > 0 {
        match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
          Some(fm) => match fm.get(tokens[next_i + 1].raw) { Some(ft) => ft.trim(), None => "" }
          None => ""
        }
      } else {
        ""
      }
      let inner_ty = if fty.starts_with("Option[") && fty.ends_with("]") {
        fty.slice(7, fty.length() - 1).trim()
      } else {
        extract_container_value_type(fty)
      }
      let close_p = find_matching_delim(tokens, next_i + 4)
      match lower_single_param_method_closure(ctx, tokens, next_i + 5, close_p, end, file, "map", inner_ty) {
        Some(cl_s) => {
          let rf = rename_struct_field(ctx, strip_type_args_sym(base_ty), tokens[next_i + 1].raw)
          return (trivia + name + "." + rf + ".map(" + cl_s + ")", close_p + 1)
        }
        None => ()
      }
    }

    // Local container `.map(fn(x) { ... })` / `.filter(fn(x) { ... })` / `.each(fn(x) { ... })` / `.filter_map(fn(x) { ... })`:
    // propagate known element type `T` onto untyped single closure parameter `x`!
    if !in_pattern && !prev_dot && !prev_cc &&
    next_i + 2 < end && tokens[next_i].kind == TokenKind::Dot &&
    tokens[next_i + 1].kind == TokenKind::Ident && tokens[next_i + 2].kind == TokenKind::LParen &&
    (tokens[next_i + 1].raw == "map" || tokens[next_i + 1].raw == "filter" || tokens[next_i + 1].raw == "each" || tokens[next_i + 1].raw == "filter_map") {
      let cty = lookup_ident_static_type(ctx, t.raw)
      let ety = if cty.starts_with("Option[") && cty.ends_with("]") {
        cty.slice(7, cty.length() - 1).trim()
      } else if cty.length() > 0 {
        extract_container_value_type(cty)
      } else {
        ""
      }
      let close_p = find_matching_delim(tokens, next_i + 2)
      let mname = tokens[next_i + 1].raw
      match lower_single_param_method_closure(ctx, tokens, next_i + 3, close_p, end, file, mname, ety) {
        Some(cl_s) => return (trivia + name + "." + mname + "(" + cl_s + ")", close_p + 1)
        None => ()
      }
    }

    // Check local container expected type for `arr.unsafe_set(i, v)` / `arr.set(i, v)` / `arr.push(v)`
    if !in_pattern && !prev_dot && !prev_cc &&
    next_i + 2 < end && tokens[next_i].kind == TokenKind::Dot &&
    tokens[next_i + 1].kind == TokenKind::Ident && tokens[next_i + 2].kind == TokenKind::LParen &&
    (tokens[next_i + 1].raw == "unsafe_set" || tokens[next_i + 1].raw == "set" || tokens[next_i + 1].raw == "push") {
      let mut arr_ty = ""
      match lookup_scope_var(ctx, name) {
        Some(sv) => arr_ty = sv.ty
        None =>
        match ctx.symtab.val_types.get(t.raw) {
          Some(vt) => arr_ty = vt
          None => ()
        }
      }
      let elem_ty = if arr_ty.starts_with("Array[") && arr_ty.ends_with("]") {
        arr_ty.slice(6, arr_ty.length() - 1).trim()
      } else if arr_ty.starts_with("FixedArray[") && arr_ty.ends_with("]") {
        arr_ty.slice(11, arr_ty.length() - 1).trim()
      } else {
        ""
      }
      if elem_ty.length() > 0 {
        let mname = tokens[next_i + 1].raw
        let close_p = find_matching_delim(tokens, next_i + 2)
        if mname == "push" {
          push_expected_type(ctx, elem_ty)
          let a0 = lower_expr_range(ctx, tokens, next_i + 3, close_p, file, false).trim()
          pop_expected_type(ctx)
          return (trivia + name + ".push(" + a0 + ")", close_p + 1)
        }
        let mut comma_p = -1
        let mut k = next_i + 3
        let mut d = 0
        while k < close_p {
          let kk = tokens[k].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && kk == TokenKind::Comma { comma_p = k; break }
          k = k + 1
        }
        if comma_p > next_i + 3 && comma_p + 1 < close_p {
          let a0 = lower_expr_range(ctx, tokens, next_i + 3, comma_p, file, false).trim()
          push_expected_type(ctx, elem_ty)
          let a1 = lower_expr_range(ctx, tokens, comma_p + 1, close_p, file, false).trim()
          pop_expected_type(ctx)
          return (trivia + name + "." + mname + "(" + a0 + ", " + a1 + ")", close_p + 1)
        }
      }
    }

    // Check ident-guided expected type for `ident == rhs` / `ident != rhs`
    if !in_pattern && !prev_dot && !prev_cc && next_i < end &&
    (tokens[next_i].kind == TokenKind::EqEq || tokens[next_i].kind == TokenKind::BangEq) {
      let id_ty = lookup_ident_static_type(ctx, t.raw)
      if id_ty.length() > 0 {
        let op_tok = tokens[next_i]
        let rhs_start = next_i + 1
        let rhs_end = find_eq_rhs_end_f3d2(tokens, rhs_start, end)
        if rhs_end > rhs_start {
          let saved_eq_exp = ctx.expected_type_stack.length()
          push_expected_type(ctx, id_ty)
          let rhs_s = lower_expr_range(ctx, tokens, rhs_start, rhs_end, file, false)
          restore_expected_type_stack(ctx, saved_eq_exp)
          return (trivia + name + op_tok.leading_trivia + op_tok.raw + rhs_s, rhs_end)
        }
      }
    }

    // Check multi-hop field assignment/equality `x.a.b = rhs` / `==` / `!=`
    if !in_pattern && !prev_dot && !prev_cc {
      match try_lower_chained_field_assign_or_eq_f3d2(ctx, trivia, name, tokens, i, next_i, end, file) {
        Some(res_pair) => return res_pair
        None => ()
      }
      match try_lower_map_keys_iter_chain_f42(ctx, trivia, name, tokens, i, next_i, end, file) {
        Some(res_pair) => return res_pair
        None => ()
      }
    }

    // Check field-guided expected type for `x.field = rhs`, `x.field == rhs`, `x.field != rhs`,
    // and `x.field.unsafe_set(i, v)` / `x.field.set(i, v)` / `x.field.push(v)`!
    if !in_pattern && !prev_dot && !prev_cc &&
    next_i + 2 < end && tokens[next_i].kind == TokenKind::Dot && tokens[next_i + 1].kind == TokenKind::Ident {
      let field_raw = tokens[next_i + 1].raw
      let mut field_ty = ""
      match lookup_scope_var(ctx, name) {
        Some(sv) => {
          let sbase = strip_type_args_sym(sv.ty)
          match ctx.symtab.struct_field_types.get(sbase) {
            Some(fm) =>
            match fm.get(field_raw) {
              Some(ft) => field_ty = ft
              None => ()
            }
            None => ()
          }
        }
        None => ()
      }
      if field_ty.length() > 0 {
        let after_f = next_i + 2
        if after_f < end && (tokens[after_f].kind == TokenKind::Eq || tokens[after_f].kind == TokenKind::EqEq || tokens[after_f].kind == TokenKind::BangEq) {
          let op_tok = tokens[after_f]
          let rhs_start = after_f + 1
          let rhs_end = if op_tok.kind == TokenKind::Eq {
            find_expr_end(tokens, rhs_start, end)
          } else {
            // For `==` / `!=`, stop at logical operators / block `{` / `,` / `)` / `;` / newline
            let mut re = rhs_start
            let mut rd = 0
            while re < end {
              let rk = tokens[re].kind
              if rd == 0 && re > rhs_start && tokens[re].newline_before { break }
              if rd == 0 && (rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::Comma || rk == TokenKind::Semi || rk == TokenKind::LBrace) { break }
              if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
              else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                if rd == 0 { break }
                rd = rd - 1
              }
              re = re + 1
            }
            re
          }
          if rhs_end > rhs_start {
            let f_out = if field_raw == "val" {
              if should_defer_val_assign_to_a5(ctx, tokens, next_i, after_f, end) {
                alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
              } else {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              }
            } else {
              rename_keyword_ident(field_raw)
            }
            push_expected_type(ctx, field_ty)
            let rhs_s = lower_expr_range(ctx, tokens, rhs_start, rhs_end, file, false)
            pop_expected_type(ctx)
            return (trivia + name + "." + f_out + op_tok.leading_trivia + op_tok.raw + rhs_s, rhs_end)
          }
        }
        // `x.arr_field.unsafe_set(i, v)` / `.set(i, v)` / `.push(v)` when `field_ty` is `Array[T]` / `FixedArray[T]`
        if after_f + 2 < end && tokens[after_f].kind == TokenKind::Dot &&
        tokens[after_f + 1].kind == TokenKind::Ident && tokens[after_f + 2].kind == TokenKind::LParen &&
        (tokens[after_f + 1].raw == "unsafe_set" || tokens[after_f + 1].raw == "set" || tokens[after_f + 1].raw == "push") {
          let elem_ty = if field_ty.starts_with("Array[") && field_ty.ends_with("]") {
            field_ty.slice(6, field_ty.length() - 1).trim()
          } else if field_ty.starts_with("FixedArray[") && field_ty.ends_with("]") {
            field_ty.slice(11, field_ty.length() - 1).trim()
          } else {
            ""
          }
          if elem_ty.length() > 0 {
            let mname = tokens[after_f + 1].raw
            let close_p = find_matching_delim(tokens, after_f + 2)
            if mname == "push" {
              let f_out = if field_raw == "val" {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              } else {
                rename_keyword_ident(field_raw)
              }
              push_expected_type(ctx, elem_ty)
              let a0 = lower_expr_range(ctx, tokens, after_f + 3, close_p, file, false).trim()
              pop_expected_type(ctx)
              return (trivia + name + "." + f_out + ".push(" + a0 + ")", close_p + 1)
            }
            let mut comma_p = -1
            let mut k = after_f + 3
            let mut d = 0
            while k < close_p {
              let kk = tokens[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Comma { comma_p = k; break }
              k = k + 1
            }
            if comma_p > after_f + 3 && comma_p + 1 < close_p {
              let f_out = if field_raw == "val" {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              } else {
                rename_keyword_ident(field_raw)
              }
              let a0 = lower_expr_range(ctx, tokens, after_f + 3, comma_p, file, false).trim()
              push_expected_type(ctx, elem_ty)
              let a1 = lower_expr_range(ctx, tokens, comma_p + 1, close_p, file, false).trim()
              pop_expected_type(ctx)
              return (trivia + name + "." + f_out + "." + mname + "(" + a0 + ", " + a1 + ")", close_p + 1)
            }
          }
        }
      }
    }

    // Check chained field access followed by slice `a.b[lo:hi]` or cascade `a.b.c..m1(...)..m2(...)`
    if !in_pattern && !prev_dot {
      let mut chain_end = next_i
      let chain_segs : Array[(String, Int, Int)] = []
      while chain_end + 1 < end && tokens[chain_end].kind == TokenKind::Dot && tokens[chain_end + 1].kind == TokenKind::Ident {
        chain_segs.push((tokens[chain_end + 1].raw, tokens[chain_end + 1].line, tokens[chain_end + 1].col))
        chain_end = chain_end + 2
      }
      if chain_end > next_i && chain_end < end && tokens[chain_end].kind == TokenKind::LBracket && !tokens[chain_end].newline_before {
        let close_br = find_matching_delim(tokens, chain_end)
        let mut colon_i = -1
        let mut k = chain_end + 1
        let mut d = 0
        while k < close_br {
          let kk = tokens[k].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && kk == TokenKind::Colon { colon_i = k; break }
          k = k + 1
        }
        if colon_i >= 0 {
          let chain_sb = StringBuilder()
          chain_sb.write_string(name)
          for seg in chain_segs {
            let fname = if seg.0 == "val" {
              alloc_fresh_val_placeholder(ctx, seg.1, seg.2)
            } else {
              rename_keyword_ident(seg.0)
            }
            chain_sb.write_string("." + fname)
          }
          let chain_str = chain_sb.to_string()
          let lo = if colon_i > chain_end + 1 {
            lower_expr_range(ctx, tokens, chain_end + 1, colon_i, file, false).trim()
          } else {
            "0"
          }
          let hi = if close_br > colon_i + 1 {
            lower_expr_range(ctx, tokens, colon_i + 1, close_br, file, false).trim()
          } else {
            chain_str + ".length()"
          }
          let (sl_helper, next_after, extra_arg) = classify_slice_consumer(ctx, tokens, close_br, end, false, false, ctx.in_interp_top, t.raw, file)
          let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
          return (trivia + sl_helper + "(" + chain_str + ", " + lo + ", " + hi + extra_tail + ")", next_after)
        }
      }
      if chain_end < end && tokens[chain_end].kind == TokenKind::DotDot &&
      chain_end + 1 < end && tokens[chain_end + 1].kind == TokenKind::Ident {
        let chain_sb = StringBuilder()
        chain_sb.write_string(name)
        for seg in chain_segs {
          let fname = if seg.0 == "val" {
            alloc_fresh_val_placeholder(ctx, seg.1, seg.2)
          } else {
            rename_keyword_ident(seg.0)
          }
          chain_sb.write_string("." + fname)
        }
        return lower_cascade_chain(ctx, trivia, chain_sb.to_string(), tokens, chain_end, end, file)
      }
    }

    // Tuple struct numeric field access `<ident>.0` -> `<ident>._0` when `<ident>` is a known tuple struct!
    if !in_pattern && !prev_dot && next_i + 1 < end && tokens[next_i].kind == TokenKind::Dot && tokens[next_i + 1].kind == TokenKind::IntLit {
      match lookup_scope_var(ctx, name) {
        Some(sv) =>
        if ctx.symtab.tuple_structs.contains(strip_type_args_sym(sv.ty)) {
          return (trivia + name + "._" + tokens[next_i + 1].raw, next_i + 2)
        }
        None => ()
      }
    }

    if in_pattern && next_i < end && tokens[next_i].kind == TokenKind::Tilde {
      next_i = next_i + 1
    }

    return (trivia + name, next_i)
  }

  // 8. Unhandled pattern rest `..` outside a recognized constructor pattern -> hard fail
  if in_pattern && t.kind == TokenKind::DotDot {
    ctx.diags.push(diag_error(
      "MBT2PION_MANUAL",
      file,
      t.line,
      t.col,
      "unsupported rest pattern `..` outside known enum constructor",
    ))
    return (trivia + "_", i + 1)
  }

  // 9. Keyword `in` used as identifier (outside `for ... in ...`)
  if t.kind == TokenKind::Keyword && t.raw == "in" {
    return (trivia + "in", i + 1)
  }

  // 10. Nested tuple index `.1.0` lexed as `.` + `FloatLit("1.0")` -> `.1 .0` (prevents Pion float-lexing E_PARSE!)
  if !in_pattern && t.kind == TokenKind::Dot && i + 1 < end && tokens[i + 1].kind == TokenKind::FloatLit {
    let fraw = tokens[i + 1].raw
    let dot_pos = fraw.index_of(".")
    if dot_pos > 0 && dot_pos + 1 < fraw.length() {
      let p1 = fraw.slice(0, dot_pos)
      let p2 = fraw.slice(dot_pos + 1, fraw.length())
      let mut all_digits = true
      let mut k = 0
      while k < p1.length() { if !is_digit(p1.code_unit_at(k)) { all_digits = false }; k = k + 1 }
      k = 0
      while k < p2.length() { if !is_digit(p2.code_unit_at(k)) { all_digits = false }; k = k + 1 }
      if all_digits {
        return (trivia + "." + p1 + " ." + p2, i + 2)
      }
    }
  }

  // 10a. Reject MoonBit-invalid lowercase `f` suffix (`1.5f`, `0x1.8p0f`) fail-closed before Pion accepts it
  if t.kind == TokenKind::FloatLit && i + 1 < end &&
  tokens[i + 1].leading_trivia.length() == 0 &&
  tokens[i + 1].kind == TokenKind::Ident &&
  tokens[i + 1].raw == "f" {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "lowercase float suffix `f` is not valid in MoonBit",
    ))
    return (trivia + t.raw + "f", i + 2)
  }

  // 10b. Hex float literal (`0x1.0p1023`, `0x1.fp-1022`, `0x1p-54`, and Float32 `0x1.8p0F`, `0x1.0p-149F`)
  //      MoonBit rounds hex Float32 via binary64 then narrows to binary32: `Float::from_double(Double::from_bits(<bits64>L))`
  if t.kind == TokenKind::FloatLit && (t.raw.starts_with("0x") || t.raw.starts_with("0X")) {
    if t.raw.ends_with("F") {
      if in_pattern {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          t.line,
          t.col,
          "Float32 literal `" + t.raw + "` is not supported in pattern position",
        ))
        return (trivia + t.raw, i + 1)
      }
      let hex_body = t.raw.slice(0, t.raw.length() - 1)
      match parse_hex_float_to_bits(hex_body) {
        Some(bits64) => return (trivia + "Float::from_double(Double::from_bits(" + bits64.to_string() + "L))", i + 1)
        None => ()
      }
    } else if !in_pattern {
      match parse_hex_float_to_bits(t.raw) {
        Some(bits) => return (trivia + "Double::from_bits(" + bits.to_string() + "L)", i + 1)
        None => ()
      }
    }
  }

  // 10c. MoonBit decimal Float32 literal (`1.5F`, `0.0F`, `1.0e3F`)
  if t.kind == TokenKind::FloatLit && t.raw.ends_with("F") {
    if in_pattern {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        t.line,
        t.col,
        "Float32 literal `" + t.raw + "` is not supported in pattern position",
      ))
      return (trivia + t.raw, i + 1)
    }
    let body = t.raw.slice(0, t.raw.length() - 1)
    return (trivia + "Float::from_double(" + body + ")", i + 1)
  }

  (trivia + t.raw, i + 1)
}

///| Parse a MoonBit hexadecimal floating-point literal (`0x1.0p1023`, `0x1.fp-1022`, `0x1p-54`)
///| into its exact IEEE-754 binary64 bit pattern (ties-to-even rounding, subnormals, overflow/underflow).
pub fn parse_hex_float_to_bits(raw : String) -> Option[Int64] {
  let n = raw.length()
  if n < 4 || !(raw.starts_with("0x") || raw.starts_with("0X")) {
    return None
  }
  let mut p_idx = -1
  let mut k = 2
  while k < n {
    let c = raw.code_unit_at(k)
    if c == 112 || c == 80 {
      p_idx = k
      break
    }
    k = k + 1
  }
  if p_idx < 0 || p_idx + 1 >= n {
    return None
  }
  // Parse signed decimal exponent after `p`/`P`
  let mut ei = p_idx + 1
  let mut exp_neg = false
  if raw.code_unit_at(ei) == 45 {
    exp_neg = true
    ei = ei + 1
  } else if raw.code_unit_at(ei) == 43 {
    ei = ei + 1
  }
  let mut exp_abs = 0
  let mut saw_exp_dig = false
  while ei < n {
    let c = raw.code_unit_at(ei)
    if c == 95 { ei = ei + 1; continue }
    if c < 48 || c > 57 { return None }
    saw_exp_dig = true
    if exp_abs < 1000000 {
      exp_abs = exp_abs * 10 + (c - 48)
    }
    ei = ei + 1
  }
  if !saw_exp_dig {
    return None
  }
  let mut exp = if exp_neg { -exp_abs } else { exp_abs }

  // Collect significant bits of mantissa into 55-bit buffer (bit 54 = MSB, bits 53..2 = 52 frac, bit 1 = guard, bit 0 = sticky)
  let mut sig : UInt64 = 0UL
  let mut bits_collected = 0
  let mut sticky = false
  let mut seen_dot = false
  let mut seen_nz = false
  let mut int_bits_after_msb = 0
  let mut mi = 2
  while mi < p_idx {
    let c = raw.code_unit_at(mi)
    if c == 95 { mi = mi + 1; continue }
    if c == 46 {
      if seen_dot { return None }
      seen_dot = true
      mi = mi + 1
      continue
    }
    let dig = if c >= 48 && c <= 57 { c - 48 }
    else if c >= 97 && c <= 102 { c - 97 + 10 }
    else if c >= 65 && c <= 70 { c - 65 + 10 }
    else { return None }
    let mut b = 3
    while b >= 0 {
      let bit = (dig >> b) & 1
      if !seen_nz {
        if bit != 0 {
          seen_nz = true
          sig = 1UL
          bits_collected = 1
          if seen_dot {
            exp = exp - 1
          }
        } else if seen_dot {
          exp = exp - 1
        }
      } else {
        if !seen_dot {
          int_bits_after_msb = int_bits_after_msb + 1
        }
        if bits_collected < 54 {
          sig = (sig << 1UL) | bit.to_int64().reinterpret_as_uint64()
          bits_collected = bits_collected + 1
        } else if bit != 0 {
          sticky = true
        }
      }
      b = b - 1
    }
    mi = mi + 1
  }
  if !seen_nz {
    return Some(0L)
  }
  // Align `sig` so MSB is at bit 54 (55 bits total: 53 significand + guard at bit 1 + sticky at bit 0)
  while bits_collected < 54 {
    sig = sig << 1UL
    bits_collected = bits_collected + 1
  }
  sig = (sig << 1UL) | (if sticky { 1UL } else { 0UL })
  let mut msb_exp = exp + int_bits_after_msb

  if msb_exp > 1023 {
    return Some(0x7ff0000000000000L)
  }
  if msb_exp < -1075 {
    return Some(0L)
  }
  if msb_exp >= -1022 {
    // Normal number: round ties-to-even at bit 2
    let gbit = (sig >> 1UL) & 1UL
    let st = sig & 1UL
    let mut mant53 = sig >> 2UL
    if gbit == 1UL && (st == 1UL || (mant53 & 1UL) == 1UL) {
      mant53 = mant53 + 1UL
      if (mant53 >> 53UL) != 0UL {
        mant53 = mant53 >> 1UL
        msb_exp = msb_exp + 1
      }
    }
    if msb_exp > 1023 {
      return Some(0x7ff0000000000000L)
    }
    let exp_bits = (msb_exp + 1023).to_int64().reinterpret_as_uint64()
    let frac_bits = mant53 & 0x000fffffffffffffUL
    let packed = (exp_bits << 52UL) | frac_bits
    return Some(packed.reinterpret_as_int64())
  }
  // Subnormal number: `-1075 <= msb_exp < -1022`
  let shift = -1022 - msb_exp
  // Shift `sig` right by `shift` preserving sticky in bit 0
  let mut sub_sig = sig
  let mut s = 0
  while s < shift {
    let lost = sub_sig & 1UL
    sub_sig = (sub_sig >> 1UL) | lost
    s = s + 1
  }
  let gbit = (sub_sig >> 1UL) & 1UL
  let st = sub_sig & 1UL
  let mut mant = sub_sig >> 2UL
  if gbit == 1UL && (st == 1UL || (mant & 1UL) == 1UL) {
    mant = mant + 1UL
  }
  Some(mant.reinterpret_as_int64())
}

///| Lower a cascade chain `recv..m1(a)..m2(b)` into a hygienic block that evaluates `recv` ONCE
///| and returns `recv`!
fn lower_cascade_chain(
  ctx : StageAContext,
  trivia : String,
  recv_expr : String,
  tokens : Array[Token],
  start_dotdot : Int,
  end : Int,
  file : String,
) -> (String, Int) {
  let tmp = fresh_temp(ctx, "cas")
  let sb = StringBuilder()
  sb.write_string(trivia)
  sb.write_string("{ let " + tmp + " = " + recv_expr + "; ")
  let mut cur = start_dotdot
  while cur < end && tokens[cur].kind == TokenKind::DotDot && cur + 1 < end && tokens[cur + 1].kind == TokenKind::Ident {
    let mname = rename_keyword_ident(tokens[cur + 1].raw)
    if cur + 2 < end && tokens[cur + 2].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, cur + 2)
      let call_str = lower_call_args(ctx, tokens, cur + 2, close_p, file, tokens[cur + 1].line, tokens[cur + 1].col, tmp + "." + mname, false, false)
      sb.write_string(call_str + "; ")
      cur = close_p + 1
    } else {
      sb.write_string(tmp + "." + mname + "; ")
      cur = cur + 2
    }
  }
  sb.write_string(tmp + " }")
  (sb.to_string(), cur)
}

///| Return true if `cand` collides with any known identifier or appears as a substring anywhere in any package source file
///| (including nested `InterpString` `\{...}` blocks).
fn ufcs_name_collides(ctx : StageAContext, cand : String) -> Bool {
  if ctx.used_idents.contains(cand) {
    return true
  }
  for src in ctx.all_source_texts {
    if str_has(src, cand) {
      return true
    }
  }
  false
}

///| Return true iff every method in `tname` takes `Self` as first param and never mentions standalone `Self`
///| in any subsequent param type or return type (i.e. safe for `as dyn Trait` dynamic dispatch).
fn is_trait_object_safe(ctx : StageAContext, tname : String) -> Bool {
  match ctx.trait_methods.get(tname) {
    Some(mm) => {
      for mk in mm.keys() {
        match mm.get(mk) {
          Some((pts, rty)) => {
            if pts.length() < 1 || pts[0] != "Self" {
              return false
            }
            let mut pi = 1
            while pi < pts.length() {
              if replace_self_type_in_pion(pts[pi], "__MbtT") != pts[pi] {
                return false
              }
              pi = pi + 1
            }
            if rty.length() > 0 && replace_self_type_in_pion(rty, "__MbtT") != rty {
              return false
            }
          }
          None => ()
        }
      }
      true
    }
    None => false
  }
}

///| Replace standalone `Self` type identifier inside a Pion type string with `subst` (e.g. `__MbtT`).
fn replace_self_type_in_pion(ty : String, subst : String) -> String {
  if !str_has(ty, "Self") {
    return ty
  }
  let toks = lex_moonbit(ty)
  let n = toks.length() - 1
  let sb = StringBuilder()
  let mut last_b = 0
  let mut k = 0
  while k < n {
    let tk = toks[k]
    if tk.kind == TokenKind::UpperIdent && tk.raw == "Self" &&
    !(k > 0 && (toks[k - 1].kind == TokenKind::Dot || toks[k - 1].kind == TokenKind::ColonColon)) {
      sb.write_string(ty.slice(last_b, tk.start_byte))
      sb.write_string(subst)
      last_b = tk.end_byte
    }
    k = k + 1
  }
  sb.write_string(ty.slice(last_b, ty.length()))
  sb.to_string()
}

///| Strict read-only pure method whitelist for E1-4 immediate slice `.iter()` consumers.
fn slice_iter_is_pure_method(m : String) -> Bool {
  m == "to_string" || m == "length" || m == "is_empty" || m == "abs" ||
  m == "contains" || m == "has_prefix" || m == "has_suffix" ||
  m == "to_int" || m == "to_double" || m == "to_float" ||
  m == "to_int64" || m == "to_uint" || m == "trim"
}

///| Return the body start token index of an explicit inline lambda (`fn(...) { ... }`, `x => ...`, `(...) => ...`),
///| or -1 if `[start, end)` is not a recognized explicit inline lambda.
fn slice_iter_lambda_body_start(tokens : Array[Token], start : Int, end : Int) -> Int {
  if start >= end {
    return -1
  }
  let t0 = tokens[start]
  if t0.kind == TokenKind::Keyword && t0.raw == "fn" &&
  start + 1 < end && tokens[start + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, start + 1)
    if cp > start + 1 && cp + 1 < end && tokens[cp + 1].kind == TokenKind::LBrace {
      return cp + 1
    }
    return -1
  }
  if t0.kind == TokenKind::Ident && start + 2 < end && tokens[start + 1].kind == TokenKind::FatArrow {
    return start + 2
  }
  if t0.kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, start)
    if cp > start && cp + 2 < end && tokens[cp + 1].kind == TokenKind::FatArrow {
      return cp + 2
    }
  }
  -1
}

///| Check whether `[start, end)` is a single non-interpolated literal or simple identifier (for `take`/`drop`/`join`).
fn slice_iter_is_simple_arg(tokens : Array[Token], start : Int, end : Int, recv_root : String) -> Bool {
  if end != start + 1 {
    return false
  }
  let tk = tokens[start]
  if tk.kind == TokenKind::Ident {
    return !(recv_root.length() > 0 && tk.raw == recv_root)
  }
  tk.kind == TokenKind::IntLit || tk.kind == TokenKind::FloatLit ||
  tk.kind == TokenKind::StringLit || tk.kind == TokenKind::RawMultiline ||
  tk.kind == TokenKind::CharLit || tk.kind == TokenKind::ByteCharLit ||
  (tk.kind == TokenKind::Keyword && (tk.raw == "true" || tk.raw == "false"))
}

///| Extract parameter names of an inline lambda (`fn(x, y : T) { ... }`, `x => ...`, `(x, y) => ...`).
fn extract_slice_lambda_params(tokens : Array[Token], start : Int, end : Int) -> Map[String, Bool] {
  let params : Map[String, Bool] = Map()
  if start >= end {
    return params
  }
  let t0 = tokens[start]
  if t0.kind == TokenKind::Ident && start + 1 < end && tokens[start + 1].kind == TokenKind::FatArrow {
    params[t0.raw] = true
    return params
  }
  let lp = if t0.kind == TokenKind::Keyword && t0.raw == "fn" &&
  start + 1 < end && tokens[start + 1].kind == TokenKind::LParen {
    start + 1
  } else if t0.kind == TokenKind::LParen {
    start
  } else {
    -1
  }
  if lp < 0 {
    return params
  }
  let cp = find_matching_delim(tokens, lp)
  if cp <= lp || cp >= end {
    return params
  }
  let mut k = lp + 1
  let mut depth = 0
  let mut at_param_start = true
  while k < cp {
    let tk = tokens[k]
    if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace {
      depth = depth + 1
      at_param_start = false
    } else if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
      at_param_start = false
    } else if depth == 0 && tk.kind == TokenKind::Comma {
      at_param_start = true
    } else if depth == 0 && at_param_start && tk.kind == TokenKind::Ident {
      params[tk.raw] = true
      at_param_start = false
    } else if depth == 0 {
      at_param_start = false
    }
    k = k + 1
  }
  params
}

///| E1-4 / Wave M2-F1: Strict POSITIVE allowlist for inline `.iter()` lambda bodies and pure constant exprs.
///| Rejects every token outside the allowlist (including `InterpString`, `InterpMultiline`, `|>`, `=`, `[...]`,
///| `::`, `@pkg`, `UpperIdent`, external identifiers, free/indirect calls, and non-whitelisted or shadowed methods).
fn slice_iter_args_are_pure(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  lambda_params : Map[String, Bool],
) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k]
    let kind = tk.kind
    // 1. Non-interpolated literals only (InterpString / InterpMultiline strictly rejected)
    if kind == TokenKind::IntLit || kind == TokenKind::FloatLit ||
    kind == TokenKind::StringLit || kind == TokenKind::RawMultiline ||
    kind == TokenKind::CharLit || kind == TokenKind::ByteCharLit {
      k = k + 1
      continue
    }
    // 2. Keywords: strictly true / false / if / else
    if kind == TokenKind::Keyword {
      if tk.raw == "true" || tk.raw == "false" || tk.raw == "if" || tk.raw == "else" {
        k = k + 1
        continue
      }
      return false
    }
    // 3. Allowed operators and punctuation (no |>, =, +=, [, ], ::, .., ?, =>, ->)
    if kind == TokenKind::Plus || kind == TokenKind::Minus || kind == TokenKind::Star ||
    kind == TokenKind::Slash || kind == TokenKind::Percent ||
    kind == TokenKind::EqEq || kind == TokenKind::BangEq ||
    kind == TokenKind::Lt || kind == TokenKind::LtEq ||
    kind == TokenKind::Gt || kind == TokenKind::GtEq ||
    kind == TokenKind::AmpAmp || kind == TokenKind::PipePipe || kind == TokenKind::Bang ||
    kind == TokenKind::RParen || kind == TokenKind::LBrace || kind == TokenKind::RBrace ||
    kind == TokenKind::Comma || kind == TokenKind::Dot || kind == TokenKind::Semi {
      k = k + 1
      continue
    }
    // LParen allowed for grouping or pure method call arg list, never indirect call `)(` or `}(`
    if kind == TokenKind::LParen {
      if k > start && (tokens[k - 1].kind == TokenKind::RParen || tokens[k - 1].kind == TokenKind::RBrace) {
        return false
      }
      k = k + 1
      continue
    }
    // 4. Ident: strictly (a) own lambda param (not called), (b) immutable local scalar var (not called),
    //    or (c) `.pure_method(...)` on lambda param / allowlisted `(...)`
    if kind == TokenKind::Ident {
      let preceded_by_dot = k > start && tokens[k - 1].kind == TokenKind::Dot
      if !preceded_by_dot {
        if !(k + 1 < end && tokens[k + 1].kind == TokenKind::LParen) {
          if lambda_params.contains(tk.raw) {
            k = k + 1
            continue
          }
          match lookup_scope_var(ctx, resolve_ident_in_scope(ctx, tk.raw)) {
            Some(sv) => {
              let sty = sv.ty.trim()
              if !sv.is_mut && !sv.is_boxed &&
              (sty == "Int" || sty == "Int64" || sty == "UInt" || sty == "UInt64" ||
                sty == "Double" || sty == "Float" || sty == "Bool" || sty == "Char" ||
                sty == "Byte" || sty == "String") {
                k = k + 1
                continue
              }
            }
            None => ()
          }
        }
        return false
      }
      // Dot method call: must be whitelisted, not shadowed locally, followed by `(`, and receiver must be lambda param or `)`
      if slice_iter_is_pure_method(tk.raw) && !ctx.local_method_names.contains(tk.raw) &&
      k + 1 < end && tokens[k + 1].kind == TokenKind::LParen && k >= start + 2 {
        let rk = tokens[k - 2].kind
        if (rk == TokenKind::Ident && lambda_params.contains(tokens[k - 2].raw) &&
          !(k >= start + 3 && tokens[k - 3].kind == TokenKind::Dot)) ||
        rk == TokenKind::RParen {
          k = k + 1
          continue
        }
      }
      return false
    }
    // 5. Everything else (`UpperIdent`, `PkgRef`, `InterpString`, `PipeGt`, `Eq`, `[`, `]`, etc.) strictly rejected
    return false
  }
  true
}

///| E1-4 / Wave M2-F1: Return true iff `.iter()` at `close_br + 1 .. close_br + 5` is immediately
///| consumed by a pure read-only iterator chain ending in a terminal consumer (no escaping `Iter`,
///| no mutation of backing array, positive-allowlisted inline lambda bodies only).
fn is_pure_immediate_iter_consumer(
  ctx : StageAContext,
  tokens : Array[Token],
  after_iter : Int,
  end : Int,
  recv_root : String,
) -> Bool {
  let empty_params : Map[String, Bool] = Map()
  let mut cur = after_iter
  while cur + 2 < end && tokens[cur].kind == TokenKind::Dot &&
  tokens[cur + 1].kind == TokenKind::Ident && tokens[cur + 2].kind == TokenKind::LParen {
    let mname = tokens[cur + 1].raw
    let close_p = find_matching_delim(tokens, cur + 2)
    if close_p < cur + 2 || close_p >= end {
      return false
    }
    // Split top-level arguments inside `(cur + 3 .. close_p)`
    let args : Array[(Int, Int)] = []
    let mut ai = cur + 3
    while ai < close_p {
      if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
      let mut ae = ai
      let mut ad = 0
      while ae < close_p {
        let ak = tokens[ae].kind
        if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
        else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
        else if ad == 0 && ak == TokenKind::Comma { break }
        ae = ae + 1
      }
      if ae > ai { args.push((ai, ae)) }
      ai = ae + 1
    }
    if mname == "collect" || mname == "count" || mname == "to_array" {
      return args.length() == 0
    }
    if mname == "rev" || mname == "enumerate" {
      if args.length() != 0 { return false }
      cur = close_p + 1
      continue
    }
    if mname == "join" {
      return args.length() == 1 && slice_iter_is_simple_arg(tokens, args[0].0, args[0].1, recv_root)
    }
    if mname == "take" || mname == "drop" {
      if args.length() != 1 || !slice_iter_is_simple_arg(tokens, args[0].0, args[0].1, recv_root) {
        return false
      }
      cur = close_p + 1
      continue
    }
    if mname == "any" || mname == "all" || mname == "find_first" {
      if args.length() != 1 { return false }
      let bstart = slice_iter_lambda_body_start(tokens, args[0].0, args[0].1)
      if bstart < 0 { return false }
      let lparams = extract_slice_lambda_params(tokens, args[0].0, args[0].1)
      return slice_iter_args_are_pure(ctx, tokens, bstart, args[0].1, lparams)
    }
    if mname == "map" || mname == "filter" {
      if args.length() != 1 { return false }
      let bstart = slice_iter_lambda_body_start(tokens, args[0].0, args[0].1)
      if bstart < 0 { return false }
      let lparams = extract_slice_lambda_params(tokens, args[0].0, args[0].1)
      if !slice_iter_args_are_pure(ctx, tokens, bstart, args[0].1, lparams) {
        return false
      }
      cur = close_p + 1
      continue
    }
    if mname == "fold" {
      if args.length() != 2 { return false }
      let bstart = slice_iter_lambda_body_start(tokens, args[1].0, args[1].1)
      if bstart < 0 { return false }
      let lparams = extract_slice_lambda_params(tokens, args[1].0, args[1].1)
      return slice_iter_args_are_pure(ctx, tokens, args[0].0, args[0].1, empty_params) &&
      slice_iter_args_are_pure(ctx, tokens, bstart, args[1].1, lparams)
    }
    return false
  }
  false
}

///| Lower match arms inside `match expr { pat => body, ... }`.
///| E1-4: Strictly classify immediate read-only slice consumers.
///| Returns `(helper_name, next_token_idx, extra_arg)`. Anything outside the exact whitelist stays `__mbt_slice_borrow` (fail-closed).
fn classify_slice_consumer(
  ctx : StageAContext,
  tokens : Array[Token],
  close_br : Int,
  end : Int,
  own_exempt : Bool,
  has_chained_slice : Bool,
  allow_interp_top : Bool,
  recv_root : String,
  file : String,
) -> (String, Int, String) {
  let followed_by_owned = close_br + 2 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  (tokens[close_br + 2].raw == "to_owned" || tokens[close_br + 2].raw == "to_array")
  if followed_by_owned {
    let next_after = if close_br + 4 < end &&
    tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
      close_br + 5
    } else {
      close_br + 1
    }
    return ("mbt_compat::__mbt_slice_owned", next_after, "")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "length" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
    return ("mbt_compat::__mbt_slice_owned", close_br + 1, "")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "is_empty" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
    return ("mbt_compat::__mbt_slice_owned", close_br + 5, "\"__IS_EMPTY__\"")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "iter" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen &&
  is_pure_immediate_iter_consumer(ctx, tokens, close_br + 5, end, recv_root) {
    return ("mbt_compat::__mbt_slice_owned", close_br + 5, "\"__ITER__\"")
  }
  // Immediate read-only `.contains(simple_arg)` on slice (Stage A.5 enforces immutable scalar/tuple elements)
  if !has_chained_slice && close_br + 3 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "contains" && tokens[close_br + 3].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, close_br + 3)
    if cp > close_br + 4 && cp < end && !paren_has_top_level_comma(tokens, close_br + 3, cp) &&
    slice_iter_is_simple_arg(tokens, close_br + 4, cp, recv_root) {
      return ("mbt_compat::__mbt_slice_owned", close_br + 1, "\"__CONTAINS__\"")
    }
  }
  // Read-only `ArrayView[T]` argument slice of a strictly read-only plain-ident array passed directly
  // to a same-file local function whose corresponding parameter is strictly read-only & non-escaping
  // and whose transitive call graph performs no non-fresh array mutations (e.g. `patch_all(list, ops[i:i+run], o)`).
  if !has_chained_slice && recv_root.length() > 0 {
    let exp_t = current_expected_type(ctx).trim()
    if exp_t.starts_with("ArrayView[") || exp_t.starts_with("mbt_compat::ArrayView[") {
      // Find opening `[` of this slice and verify receiver is a plain ident (not a call result like `xs.map(...)[1:3]`)
      let mut ob_scan = close_br - 1
      let mut br_d = 1
      while ob_scan >= 0 && br_d > 0 {
        let kk = tokens[ob_scan].kind
        if kk == TokenKind::RBracket { br_d = br_d + 1 }
        else if kk == TokenKind::LBracket { br_d = br_d - 1 }
        if br_d == 0 { break }
        ob_scan = ob_scan - 1
      }
      let is_plain_ident_recv = ob_scan >= 1 &&
      tokens[ob_scan - 1].kind == TokenKind::Ident &&
      tokens[ob_scan - 1].raw == recv_root &&
      !(ob_scan >= 2 && tokens[ob_scan - 2].kind == TokenKind::Dot)
      if is_plain_ident_recv &&
      ident_is_strictly_ro_in_enclosing_fn_f42(ctx, tokens, close_br, recv_root, ob_scan, 0) {
        // Verify direct call argument to a same-file local fn whose return type does NOT escape ArrayView
        let mut p_scan = ob_scan - 2
        let mut p_d = 0
        let mut enclosing_lp = -1
        let mut arg_pos = 0
        while p_scan >= 0 {
          let kk = tokens[p_scan].kind
          if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { p_d = p_d + 1 }
          else if kk == TokenKind::LParen {
            if p_d == 0 {
              enclosing_lp = p_scan
              break
            }
            p_d = p_d - 1
          } else if kk == TokenKind::LBracket || kk == TokenKind::LBrace {
            if p_d == 0 { break }
            p_d = p_d - 1
          } else if p_d == 0 && kk == TokenKind::Comma {
            arg_pos = arg_pos + 1
          }
          p_scan = p_scan - 1
        }
        if enclosing_lp >= 1 && tokens[enclosing_lp - 1].kind == TokenKind::Ident &&
        !(enclosing_lp >= 2 && tokens[enclosing_lp - 2].kind == TokenKind::Dot) &&
        (close_br + 1 == end || (close_br + 1 < end && (tokens[close_br + 1].kind == TokenKind::RParen || tokens[close_br + 1].kind == TokenKind::Comma))) {
          let call_rp = find_matching_delim(tokens, enclosing_lp)
          // Reject if `recv_root` is also referenced in any OTHER argument of the same call,
          // OR if any argument AFTER the slice argument is not strictly side-effect-free
          // (blocks `read(xs[0:3], { ys[1] = 9 })` where `ys` aliases `xs`).
          let mut other_arg_refs_recv = false
          let mut ak = enclosing_lp + 1
          while ak < call_rp {
            if ak >= ob_scan - 1 && ak <= close_br {
              ak = close_br + 1
              continue
            }
            if tokens[ak].kind == TokenKind::Ident && tokens[ak].raw == recv_root &&
            !(ak > enclosing_lp && tokens[ak - 1].kind == TokenKind::Dot) {
              other_arg_refs_recv = true
              break
            }
            ak = ak + 1
          }
          let mut trailing_args_pure = true
          let mut tk_after = close_br + 1
          while tk_after < call_rp {
            let tk = tokens[tk_after]
            let kk = tk.kind
            let ok_tok = kk == TokenKind::Comma || kk == TokenKind::Dot ||
            kk == TokenKind::RParen || kk == TokenKind::Ident || kk == TokenKind::UpperIdent ||
            kk == TokenKind::IntLit || kk == TokenKind::FloatLit ||
            (kk == TokenKind::StringLit && !str_has(tk.raw, "\\{")) ||
            kk == TokenKind::CharLit ||
            (kk == TokenKind::Keyword && (tk.raw == "true" || tk.raw == "false")) ||
            (kk == TokenKind::LParen &&
              (tk_after == close_br + 1 ||
                tokens[tk_after - 1].kind == TokenKind::Comma ||
                tokens[tk_after - 1].kind == TokenKind::LParen))
            if !ok_tok {
              trailing_args_pure = false
              break
            }
            tk_after = tk_after + 1
          }
          if !other_arg_refs_recv && trailing_args_pure {
            let callee_name = tokens[enclosing_lp - 1].raw
            let callee_shadowed = match lookup_scope_var(ctx, callee_name) {
              Some(_) => true
              None => false
            }
            if !callee_shadowed {
              let target_elem_ty = extract_array_view_elem_f42(exp_t)
              match ctx.symtab.fn_ret_types.get(callee_name) {
                Some(ret_ty) =>
                if !str_has(ret_ty, "ArrayView") && !str_has(ret_ty, "->") && !str_has(ret_ty, "Iter") &&
                callee_param_is_ro_non_escaping_f42(ctx, tokens, callee_name, arg_pos, target_elem_ty, 0) {
                  return ("mbt_compat::__mbt_slice_owned", close_br + 1, "\"__RO_VIEW__\"")
                }
                None => ()
              }
            }
          }
        }
      }
    }
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "join" && tokens[close_br + 3].kind == TokenKind::LParen {
    let jp_end = find_matching_delim(tokens, close_br + 3)
    if jp_end == close_br + 5 {
      let st = tokens[close_br + 4]
      let is_pure_sep = st.kind == TokenKind::StringLit || st.kind == TokenKind::RawMultiline ||
      (st.kind == TokenKind::Ident && match lookup_scope_var(ctx, resolve_ident_in_scope(ctx, st.raw)) {
        Some(sv) => !sv.is_mut
        None => true
      })
      if is_pure_sep {
        let sep_s = lower_expr_range(ctx, tokens, close_br + 4, jp_end, file, false).trim()
        return ("mbt_compat::__mbt_slice_ro_join", jp_end + 1, sep_s)
      }
    }
  }
  let followed_by_to_str = !has_chained_slice && close_br + 4 < end &&
  tokens[close_br + 1].kind == TokenKind::Dot && tokens[close_br + 2].raw == "to_string" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen
  if followed_by_to_str {
    return ("mbt_compat::__mbt_slice_ro_show", close_br + 5, "")
  }
  if allow_interp_top && !has_chained_slice && close_br + 1 == end {
    return ("mbt_compat::__mbt_slice_ro_show", close_br + 1, "")
  }
  if own_exempt && !has_chained_slice {
    return ("mbt_compat::__mbt_slice_owned", close_br + 1, "")
  }
  ("mbt_compat::__mbt_slice_borrow", close_br + 1, "")
}

///| E1-2: Scan top-level arm patterns in a `match` body and collect bare enum constructor names
///| plus whether any bare constructor pattern uses labeled arguments (`x~` or `x=pat`).
fn collect_match_top_bare_ctors(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
) -> (Array[String], Bool) {
  let ctors : Array[String] = []
  let seen : Map[String, Bool] = Map()
  let mut has_labeled = false
  let mut i = start
  while i < end {
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    while fa < end {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket { depth = depth - 1 }
      else if depth == 0 {
        if k == TokenKind::FatArrow { break }
        else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 { if_idx = fa }
      }
      fa = fa + 1
    }
    if fa >= end { break }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    // Scan depth-0 `|` segments in `[i, pat_end)`
    let mut seg_s = i
    while seg_s < pat_end {
      let mut seg_e = seg_s
      let mut sd = 0
      while seg_e < pat_end {
        let sk = tokens[seg_e].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBrace || sk == TokenKind::LBracket { sd = sd + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBrace || sk == TokenKind::RBracket { sd = sd - 1 }
        else if sd == 0 && sk == TokenKind::Pipe { break }
        seg_e = seg_e + 1
      }
      if seg_s < seg_e && tokens[seg_s].kind == TokenKind::UpperIdent {
        let is_qual = seg_s + 1 < seg_e && tokens[seg_s + 1].kind == TokenKind::ColonColon
        let cname = tokens[seg_s].raw
        if !is_qual && !ctx.symtab.const_defs.contains(cname) &&
        !ctx.active_generics.contains(cname) && !ctx.symtab.local_value_names.contains(cname) &&
        !((cname == "Some" || cname == "None" || cname == "Ok" || cname == "Err") && !has_local_ctor(ctx.symtab, cname)) {
          if !seen.contains(cname) {
            seen[cname] = true
            ctors.push(cname)
          }
          if seg_s + 1 < seg_e && tokens[seg_s + 1].kind == TokenKind::LParen {
            let rp = find_matching_delim(tokens, seg_s + 1)
            if rp < seg_e && paren_has_labeled_arg(tokens, seg_s + 1, rp) {
              has_labeled = true
            }
          }
        }
      }
      seg_s = seg_e + 1
    }
    let body_start = fa + 1
    let mut next_i = body_start
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      next_i = find_matching_delim(tokens, body_start) + 1
    } else if body_start < end {
      next_i = find_expr_end(tokens, body_start, end)
    }
    if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      next_i = next_i + 1
    }
    if next_i <= i { break }
    i = next_i
  }
  (ctors, has_labeled)
}

///| E1-2 Layer 3: Lower an ambiguous `match <scrut> { ... }` to a single-eval scrutinee binding
///| plus `mbt_compat::__mbt_match_scrut(__mbt_ms_N, "<spec>")` so Stage A.5 resolves the exact
///| package-qualified enum type BEFORE selecting/reordering labeled enum patterns.
fn lower_ambig_match_probe(
  ctx : StageAContext,
  tokens : Array[Token],
  brace_i : Int,
  close_b : Int,
  scrut_s : String,
  file : String,
  cands : Array[String],
  incomplete : Bool,
) -> String {
  let ms_var = fresh_temp(ctx, "ms")
  let arm_starts : Array[Int] = []
  let pat_ends : Array[Int] = []
  let arm_renames : Array[Map[String, String]] = []
  let guard_strs : Array[String] = []
  let body_strs : Array[String] = []
  let trail_seps : Array[String] = []

  let mut i = brace_i + 1
  while i < close_b {
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    while fa < close_b {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket { depth = depth - 1 }
      else if depth == 0 {
        if k == TokenKind::FatArrow { break }
        else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 { if_idx = fa }
      }
      fa = fa + 1
    }
    if fa >= close_b { break }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    let saved_arm_sc = ctx.scope_vars.length()
    let arm_raw_binders : Array[String] = []
    let mut rbi = i
    while rbi < pat_end {
      let rbt = tokens[rbi]
      if rbt.kind == TokenKind::Ident &&
      !(rbi > i && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
      !(rbi + 1 < pat_end && (tokens[rbi + 1].kind == TokenKind::Colon || tokens[rbi + 1].kind == TokenKind::Eq)) {
        arm_raw_binders.push(rbt.raw)
      }
      rbi = rbi + 1
    }
    let pat_rn = compute_scoped_binder_renames(ctx, arm_raw_binders)
    let pushed_rn = pat_rn.length() > 0
    if pushed_rn { ctx.ident_renames.push(pat_rn) }
    for rb in arm_raw_binders {
      if rb != "_" {
        ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
      }
    }
    ctx.match_arr_cache_ctor.push("__BLOCKED__")
    ctx.match_arr_cache_elems.push(Map())
    ctx.match_arr_cache_suffix.push(Map())
    ctx.match_arr_cache_len.push("")
    let g_str = if if_idx >= 0 {
      push_expected_type(ctx, "")
      let gs = collapse_guard_newlines(lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim())
      pop_expected_type(ctx)
      gs
    } else {
      ""
    }
    let body_start = fa + 1
    let mut body_raw = ""
    let mut next_i = body_start
    if body_start < close_b && tokens[body_start].kind == TokenKind::LBrace {
      let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, close_b, file, false)
      body_raw = blk
      next_i = ni
    } else if body_start < close_b && tokens[body_start].kind == TokenKind::Keyword &&
    (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
      let body_end = find_loop_stmt_end(tokens, body_start, close_b)
      let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      body_raw = "{ " + inner_b + " }"
      next_i = body_end
    } else {
      let body_end = find_expr_end(tokens, body_start, close_b)
      body_raw = lower_expr_range(ctx, tokens, body_start, body_end, file, false)
      next_i = body_end
    }
    let _ = ctx.match_arr_cache_ctor.pop()
    let _ = ctx.match_arr_cache_elems.pop()
    let _ = ctx.match_arr_cache_suffix.pop()
    let _ = ctx.match_arr_cache_len.pop()
    if pushed_rn { let _ = ctx.ident_renames.pop() }
    restore_scope_vars(ctx, saved_arm_sc)
    let mut trail_sep = ""
    if next_i < close_b && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      trail_sep = tokens[next_i].raw
      next_i = next_i + 1
    }
    arm_starts.push(i)
    pat_ends.push(pat_end)
    arm_renames.push(pat_rn)
    guard_strs.push(g_str)
    body_strs.push(body_raw.trim())
    trail_seps.push(trail_sep)
    if next_i <= i { break }
    i = next_i
  }

  let arms_json : Array[json::JsonValue] = []
  let mut ai = 0
  while ai < arm_starts.length() {
    arms_json.push(json_obj([
      json_field("g", json_str(guard_strs[ai])),
      json_field("b", json_str(body_strs[ai])),
      json_field("sep", json_str(trail_seps[ai])),
    ]))
    ai = ai + 1
  }

  let cand_fields : Array[json::JsonField] = []
  for ek in cands {
    let diags_before = ctx.diags.length()
    push_expected_type(ctx, ek)
    let pats_json : Array[json::JsonValue] = []
    let mut pi = 0
    while pi < arm_starts.length() {
      let rn = arm_renames[pi]
      let pushed = rn.length() > 0
      if pushed { ctx.ident_renames.push(rn) }
      let alts = expand_nested_or_pat(ctx, tokens, arm_starts[pi], pat_ends[pi], file)
      if pushed { let _ = ctx.ident_renames.pop() }
      let pat_sb = StringBuilder()
      let mut ki = 0
      while ki < alts.length() {
        if ki > 0 { pat_sb.write_string(" | ") }
        pat_sb.write_string(alts[ki])
        ki = ki + 1
      }
      pats_json.push(json_str(pat_sb.to_string()))
      pi = pi + 1
    }
    pop_expected_type(ctx)
    let mut err_code = ""
    let mut err_msg = ""
    let mut di = diags_before
    while di < ctx.diags.length() {
      if ctx.diags[di].severity == "error" {
        err_code = ctx.diags[di].code
        err_msg = ctx.diags[di].message
        break
      }
      di = di + 1
    }
    while ctx.diags.length() > diags_before {
      let _ = ctx.diags.pop()
    }
    if err_code.length() > 0 {
      cand_fields.push(json_field(ek, json_obj([
        json_field("ok", json_bool(false)),
        json_field("err_code", json_str(err_code)),
        json_field("err_msg", json_str(err_msg)),
      ])))
    } else {
      cand_fields.push(json_field(ek, json_obj([
        json_field("ok", json_bool(true)),
        json_field("pats", json_arr(pats_json)),
      ])))
    }
  }

  let spec = json_obj([
    json_field("v", json_str(ms_var)),
    json_field("incomplete", json_bool(incomplete)),
    json_field("arms", json_arr(arms_json)),
    json_field("cands", json_obj(cand_fields)),
  ])
  let spec_lit = json::stringify(json_str(json::stringify(spec)))
  "{ let " + ms_var + " = " + scrut_s.trim() + "; mbt_compat::__mbt_match_scrut(" + ms_var + ", " + spec_lit + ") }"
}

fn nondec_int_exceeds_u64(raw : String) -> Bool {
  if raw.length() < 3 {
    return false
  }
  let p = raw.code_unit_at(1)
  let mut end = raw.length()
  while end > 2 {
    let lc = raw.code_unit_at(end - 1)
    if lc == 85 || lc == 117 || lc == 76 || lc == 108 {
      end = end - 1
    } else {
      break
    }
  }
  let mut first_nz = -1
  let mut sig_len = 0
  let mut idx = 2
  while idx < end {
    let ch = raw.code_unit_at(idx)
    if ch == 95 {
      idx = idx + 1
      continue
    }
    if sig_len == 0 && ch == 48 {
      idx = idx + 1
      continue
    }
    if sig_len == 0 {
      first_nz = ch
    }
    sig_len = sig_len + 1
    idx = idx + 1
  }
  if p == 120 || p == 88 {
    sig_len > 16
  } else if p == 98 || p == 66 {
    sig_len > 64
  } else if p == 111 || p == 79 {
    sig_len > 22 || (sig_len == 22 && first_nz > 49)
  } else {
    false
  }
}

fn collapse_guard_newlines(s : String) -> String {
  if !str_has(s, "\n") && !str_has(s, "\r") {
    return s
  }
  let sb = StringBuilder()
  let n = s.length()
  let mut i = 0
  let mut in_str = false
  let mut in_chr = false
  let mut in_comment = false
  let mut brace_d = 0
  while i < n {
    let c = s.code_unit_at(i)
    if in_comment {
      sb.write_byte(c.to_byte())
      if c == 10 { in_comment = false }
      i = i + 1
      continue
    }
    if in_str {
      sb.write_byte(c.to_byte())
      if c == 92 && i + 1 < n {
        sb.write_byte(s.code_unit_at(i + 1).to_byte())
        i = i + 2
        continue
      }
      if c == 34 { in_str = false }
      i = i + 1
      continue
    }
    if in_chr {
      sb.write_byte(c.to_byte())
      if c == 92 && i + 1 < n {
        sb.write_byte(s.code_unit_at(i + 1).to_byte())
        i = i + 2
        continue
      }
      if c == 39 { in_chr = false }
      i = i + 1
      continue
    }
    if c == 47 && i + 1 < n && s.code_unit_at(i + 1) == 47 {
      in_comment = true
      sb.write_byte(c.to_byte())
      sb.write_byte(47.to_byte())
      i = i + 2
      continue
    }
    if (c == 35 || c == 36) && i + 1 < n && s.code_unit_at(i + 1) == 124 {
      in_comment = true
      sb.write_byte(c.to_byte())
      sb.write_byte(124.to_byte())
      i = i + 2
      continue
    }
    if c == 34 {
      in_str = true
      sb.write_byte(c.to_byte())
      i = i + 1
      continue
    }
    if c == 39 {
      in_chr = true
      sb.write_byte(c.to_byte())
      i = i + 1
      continue
    }
    if c == 123 {
      brace_d = brace_d + 1
      sb.write_byte(c.to_byte())
      i = i + 1
      continue
    }
    if c == 125 {
      if brace_d > 0 { brace_d = brace_d - 1 }
      sb.write_byte(c.to_byte())
      i = i + 1
      continue
    }
    if (c == 10 || c == 13) && brace_d == 0 {
      sb.write_byte(32.to_byte())
      i = i + 1
      while i < n && (s.code_unit_at(i) == 32 || s.code_unit_at(i) == 9 || s.code_unit_at(i) == 10 || s.code_unit_at(i) == 13) {
        i = i + 1
      }
      continue
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.to_string().trim()
}

fn guard_arrow_trivia(triv : String) -> String {
  if (str_has(triv, "\n") || str_has(triv, "\r")) && !str_has(triv, "//") {
    " "
  } else {
    triv
  }
}

fn lower_match_arms(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  lower_match_arms_with_ty(ctx, tokens, start, end, file, "")
}

///| Expand nested `|` or-patterns inside `(...)` into top-level `pat1 | pat2 | ...`.
fn expand_nested_or_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> Array[String] {
  // Check for depth-0 `|` first
  let mut k = start
  let mut d = 0
  let pipe_positions : Array[Int] = []
  let mut has_nested_pipe = false
  let mut first_lp = -1
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 && kk == TokenKind::LParen && first_lp < 0 {
        first_lp = k
      }
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d - 1
    } else if kk == TokenKind::Pipe {
      if d == 0 {
        pipe_positions.push(k)
      } else {
        has_nested_pipe = true
      }
    }
    k = k + 1
  }
  if pipe_positions.length() > 0 {
    let out : Array[String] = []
    let mut seg_s = start
    for pp in pipe_positions {
      let sub = expand_nested_or_pat(ctx, tokens, seg_s, pp, file)
      for s in sub { out.push(s) }
      seg_s = pp + 1
    }
    let last_sub = expand_nested_or_pat(ctx, tokens, seg_s, end, file)
    for s in last_sub { out.push(s) }
    return out
  }
  if !has_nested_pipe || first_lp < 0 {
    return [lower_expr_range(ctx, tokens, start, end, file, true).trim()]
  }
  let rp = find_matching_delim(tokens, first_lp)
  let prefix = if first_lp > start { lower_expr_range(ctx, tokens, start, first_lp, file, true).trim() } else { "" }
  let suffix = if rp + 1 < end { lower_expr_range(ctx, tokens, rp + 1, end, file, true).trim() } else { "" }
  // Split comma-separated items inside `( ... )` and take Cartesian product
  let item_alts : Array[Array[String]] = []
  let mut ai = first_lp + 1
  while ai < rp {
    if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
    let mut ae = ai
    let mut ad = 0
    while ae < rp {
      let ak = tokens[ae].kind
      if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
      else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
      else if ad == 0 && ak == TokenKind::Comma { break }
      ae = ae + 1
    }
    item_alts.push(expand_nested_or_pat(ctx, tokens, ai, ae, file))
    ai = ae + 1
  }
  let mut combos : Array[String] = [""]
  let mut ci = 0
  while ci < item_alts.length() {
    let next_combos : Array[String] = []
    for c in combos {
      for alt in item_alts[ci] {
        if ci == 0 {
          next_combos.push(alt)
        } else {
          next_combos.push(c + ", " + alt)
        }
      }
    }
    combos = next_combos
    ci = ci + 1
  }
  let out : Array[String] = []
  for c in combos {
    out.push(prefix + "(" + c + ")" + suffix)
  }
  out
}

///| Replace lowercase pattern binders with `_` for use in boolean `is` guards.
fn wildcard_pattern_str(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let t = tokens[i]
    if t.kind == TokenKind::Ident && !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      sb.write_string(t.leading_trivia + "_")
      i = i + 1
    } else {
      let (p, ni) = lower_one_token_or_form(ctx, tokens, i, end, file, true)
      sb.write_string(p)
      i = ni
    }
  }
  sb.to_string().trim()
}

///| D2-2: Resolve `(AbiEnumSchema, AbiEnumVariant)` for a constructor/pattern site.
///| When `expected_type` does not match any candidate (e.g. inside `out.push(NavAction(...))`
///| inheriting an unrelated enclosing return type), falls back to unguided unique/local lookup
///| while preserving fail-closed ambiguity rejection.
fn resolve_enum_schema_d2(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
) -> Option[(AbiEnumSchema, AbiEnumVariant)] {
  if enum_hint.length() > 0 {
    let key = if pkg_hint.length() > 0 && !str_has(enum_hint, "::") {
      pkg_hint + "::" + enum_hint
    } else {
      enum_hint
    }
    match ctx.symtab.enum_schemas.get(key) {
      Some(sch) => {
        for v in sch.variants {
          if v.name == ctor_name {
            return Some((sch, v))
          }
        }
      }
      None => ()
    }
  }
  match ctx.symtab.enum_schemas_by_ctor.get(ctor_name) {
    Some(cands) => {
      let exp_base = strip_type_args_sym(current_expected_type(ctx))
      if exp_base.length() > 0 && pkg_hint.length() == 0 && enum_hint.length() == 0 {
        let exp_matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
        let exp_local : Array[(AbiEnumSchema, AbiEnumVariant)] = []
        for c in cands {
          let sch = c.0
          let full_e = if sch.pkg.length() > 0 { sch.pkg + "::" + sch.name } else { sch.name }
          if str_has(exp_base, "::") {
            if full_e == exp_base { exp_matched.push(c) }
          } else if sch.name == exp_base {
            exp_matched.push(c)
            if sch.pkg.length() == 0 { exp_local.push(c) }
          }
        }
        if exp_matched.length() == 1 {
          return Some(exp_matched[0])
        }
        if exp_local.length() == 1 {
          return Some(exp_local[0])
        }
      }
      let matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      let local_matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      for c in cands {
        let sch = c.0
        if pkg_hint.length() > 0 && sch.pkg != pkg_hint {
          continue
        }
        if enum_hint.length() > 0 {
          let full_e = if sch.pkg.length() > 0 { sch.pkg + "::" + sch.name } else { sch.name }
          if sch.name != enum_hint && full_e != enum_hint {
            continue
          }
        }
        matched.push(c)
        if sch.pkg.length() == 0 {
          local_matched.push(c)
        }
      }
      if matched.length() == 1 {
        return Some(matched[0])
      }
      if pkg_hint.length() == 0 && local_matched.length() == 1 {
        return Some(local_matched[0])
      }
      None
    }
    None => None
  }
}

///| D2-2: Reorder labeled enum constructor/pattern arguments directly into declaration positional order
///| (exact MoonBit declaration-order evaluation, ZERO call-site temporaries, hygienic punning `ident~`).
fn lower_labeled_enum_args_d2(
  ctx : StageAContext,
  schema : AbiEnumSchema,
  variant : AbiEnumVariant,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> String {
  let nfields = variant.fields.length()
  let slots : Array[String] = []
  let filled : Array[Bool] = []
  let mut fi = 0
  while fi < nfields {
    slots.push("")
    filled.push(false)
    fi = fi + 1
  }
  let mut has_rest = false
  let mut next_pos = 0
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { depth = depth - 1 }
      else if depth == 0 && k == TokenKind::Comma { break }
      a_end = a_end + 1
    }
    if in_pattern && a_end == cur + 1 && tokens[cur].kind == TokenKind::DotDot {
      has_rest = true
      cur = a_end + 1
      continue
    }
    let is_punning = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    a_end == cur + 2 && tokens[cur + 1].kind == TokenKind::Tilde
    let is_named = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    cur + 2 < a_end && tokens[cur + 1].kind == TokenKind::Eq
    if is_punning || is_named {
      let lbl = tokens[cur].raw
      let mut target_idx = -1
      let mut k = 0
      while k < nfields {
        if variant.fields[k].label == lbl {
          target_idx = k
          break
        }
        k = k + 1
      }
      if target_idx < 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "unknown label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else if filled[target_idx] {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "duplicate label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        let val_s = if is_punning {
          if !in_pattern && tokens[cur].kind == TokenKind::Ident {
            lower_expr_range(ctx, tokens, cur, cur + 1, file, false).trim()
          } else {
            resolve_ident_in_scope(ctx, lbl)
          }
        } else {
          let fexp = substitute_enum_field_expected_type(ctx, schema, variant.fields[target_idx].ty, current_expected_type(ctx))
          let saved_ef = ctx.expected_type_stack.length()
          push_expected_type(ctx, fexp)
          let lowered = lower_expr_range(ctx, tokens, cur + 2, a_end, file, in_pattern).trim()
          restore_expected_type_stack(ctx, saved_ef)
          lowered
        }
        slots[target_idx] = val_s
        filled[target_idx] = true
      }
    } else if a_end > cur {
      while next_pos < nfields && (filled[next_pos] || variant.fields[next_pos].label.length() > 0) {
        next_pos = next_pos + 1
      }
      if next_pos >= nfields {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "too many positional arguments for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        let fexp = substitute_enum_field_expected_type(ctx, schema, variant.fields[next_pos].ty, current_expected_type(ctx))
        let saved_ef = ctx.expected_type_stack.length()
        push_expected_type(ctx, fexp)
        let lowered = lower_expr_range(ctx, tokens, cur, a_end, file, in_pattern).trim()
        restore_expected_type_stack(ctx, saved_ef)
        slots[next_pos] = lowered
        filled[next_pos] = true
        next_pos = next_pos + 1
      }
    }
    cur = a_end + 1
  }
  let ordered : Array[String] = []
  let mut k = 0
  while k < nfields {
    if filled[k] {
      ordered.push(slots[k])
    } else if in_pattern && (has_rest || variant.fields[k].label.length() > 0) {
      ordered.push("_")
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_ENUM_LABEL_ERROR",
        file,
        line,
        col,
        "missing required field `" + (if variant.fields[k].label.length() > 0 { variant.fields[k].label } else { "#" + k.to_string() }) + "` for enum variant `" + schema.name + "::" + variant.name + "`",
      ))
      ordered.push("_")
    }
    k = k + 1
  }
  "(" + join_comma(ordered) + ")"
}

fn check_and_lower_enum_site_d2(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> Option[String] {
  let has_lbl = open_p >= 0 && paren_has_labeled_arg(tokens, open_p, close_p)
  match resolve_enum_schema_d2(ctx, pkg_hint, enum_hint, ctor_name) {
    Some((sch, variant)) => {
      if sch.pkg.length() > 0 {
        if !in_pattern && !sch.can_construct {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot construct readonly `pub enum` variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "` from outside its package",
          ))
        } else if in_pattern && !sch.can_match {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot pattern-match private enum variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "`",
          ))
        }
      }
      if open_p < 0 {
        return None
      }
      let mut schema_has_labels = false
      for f in variant.fields {
        if f.label.length() > 0 {
          schema_has_labels = true
          break
        }
      }
      if has_lbl || schema_has_labels {
        return Some(lower_labeled_enum_args_d2(ctx, sch, variant, tokens, open_p, close_p, file, line, col, in_pattern))
      }
      return lower_positional_enum_args_f3d2(ctx, sch, variant, tokens, open_p, close_p, file, in_pattern)
    }
    None => {
      if has_lbl {
        let err_code = if pkg_hint.length() > 0 && !ctx.symtab.verified_abi_deps.contains(pkg_hint) {
          "MBT2PION_DEP_ABI_ERROR"
        } else {
          "MBT2PION_ENUM_LABEL_ERROR"
        }
        ctx.diags.push(diag_error(
          err_code,
          file,
          line,
          col,
          "labeled enum variant `" + ctor_name + "` requires local declaration or verified `--dep` `mbt2pion_abi.json` metadata",
        ))
      }
      None
    }
  }
}

///| MoonBit types an unsuffixed integer literal by its expected type (`[0, 255] : FixedArray[Byte]`), while Pion only
///| infers `Int`. When the expected element type is `Byte` and `[start, end)` is exactly one integer literal in
///| `0..=255`, return the equivalent Pion byte literal `b'\xNN'` (valid in top-level initializers too); anything
///| else (out of range, suffixed, expressions) returns `None` and keeps the regular lowering (pionc fails closed).
fn byte_lit_for_int_token(tokens : Array[Token], start : Int, end : Int, elem_ty : String) -> Option[String] {
  if elem_ty != "Byte" || end != start + 1 || tokens[start].kind != TokenKind::IntLit {
    return None
  }
  match parse_json_int_literal_u64(tokens[start].raw) {
    Some(v) =>
    if v <= 255UL {
      let n = v.to_int()
      let hex = "0123456789abcdef"
      Some("b'\\x" + hex.slice(n / 16, n / 16 + 1) + hex.slice(n % 16, n % 16 + 1) + "'")
    } else {
      None
    }
    None => None
  }
}

///| D2-4: Extract a compile-time scalar/string literal from a `const` RHS token range.
fn extract_const_literal_pion(tokens : Array[Token], start : Int, end : Int) -> Option[String] {
  let mut e = end
  while e > start && tokens[e - 1].kind == TokenKind::Semi {
    e = e - 1
  }
  let len = e - start
  if len == 1 {
    let t = tokens[start]
    if t.kind == TokenKind::IntLit || t.kind == TokenKind::CharLit || t.kind == TokenKind::StringLit {
      return Some(t.raw)
    }
    if t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false") {
      return Some(t.raw)
    }
    if t.kind == TokenKind::FloatLit && !t.raw.ends_with("F") && !t.raw.starts_with("0x") && !t.raw.starts_with("0X") {
      return Some(t.raw)
    }
    return None
  }
  if len == 2 && tokens[start].kind == TokenKind::Minus {
    let t = tokens[start + 1]
    if t.kind == TokenKind::IntLit {
      return Some("-" + t.raw)
    }
    if t.kind == TokenKind::FloatLit && !t.raw.ends_with("F") && !t.raw.starts_with("0x") && !t.raw.starts_with("0X") {
      return Some("-" + t.raw)
    }
  }
  None
}

///| D2-5: Recognize a constructor-wrapped array pattern of depth >= 1, e.g.:
///| `Some([x, _])`, `Option::Some([a, b, ..])`, `Some(Array([Number(x, ..), ...]))`,
///| `Some(Json::Array([Number(x, ..), ..]))`, `Some([x, _] as arr)`.
///| Returns `Some((lbr, rbr, as_var_idx, outer_prefix, outer_suffix, is_json_array))`.
fn find_nested_ctor_array_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  pat_end : Int,
  file : String,
) -> Option[(Int, Int, Int, String, String, Bool)] {
  let prefix_sb = StringBuilder()
  let suffix_sb = StringBuilder()
  let mut cur = start
  let mut cur_end = pat_end
  let mut depth_layers = 0
  let mut last_ctor_raw = ""
  while cur < cur_end {
    let mut lp = -1
    let mut ctor_raw = ""
    if cur + 1 < cur_end && tokens[cur].kind == TokenKind::UpperIdent && tokens[cur + 1].kind == TokenKind::LParen {
      lp = cur + 1
      ctor_raw = tokens[cur].raw
    } else if cur + 3 < cur_end && tokens[cur].kind == TokenKind::UpperIdent &&
    tokens[cur + 1].kind == TokenKind::ColonColon && tokens[cur + 2].kind == TokenKind::UpperIdent &&
    tokens[cur + 3].kind == TokenKind::LParen {
      lp = cur + 3
      ctor_raw = tokens[cur].raw + "::" + tokens[cur + 2].raw
    } else {
      break
    }
    let rp = find_matching_delim(tokens, lp)
    if rp != cur_end - 1 {
      return None
    }
    let head_s = if ctor_raw == "Array" && !has_local_ctor(ctx.symtab, "Array") {
      "mbt_compat::MbtJson::Array"
    } else if ctor_raw == "Json::Array" && !ctx.symtab.local_types.contains("Json") {
      "mbt_compat::MbtJson::Array"
    } else {
      lower_expr_range(ctx, tokens, cur, lp, file, true).trim()
    }
    prefix_sb.write_string(head_s + "(")
    suffix_sb.write_string(")")
    last_ctor_raw = ctor_raw
    depth_layers = depth_layers + 1
    cur = lp + 1
    cur_end = rp
    if cur < cur_end && tokens[cur].kind == TokenKind::LBracket {
      let rbr = find_matching_delim(tokens, cur)
      let has_as = rbr + 2 == cur_end - 1 && tokens[rbr + 1].kind == TokenKind::Keyword &&
      tokens[rbr + 1].raw == "as" && tokens[rbr + 2].kind == TokenKind::Ident
      if rbr == cur_end - 1 || has_as {
        let as_idx = if has_as { rbr + 2 } else { -1 }
        let is_json_arr = (last_ctor_raw == "Array" || last_ctor_raw == "Json::Array") && !has_local_ctor(ctx.symtab, "Array")
        return Some((cur, rbr, as_idx, prefix_sb.to_string(), suffix_sb.to_string(), is_json_arr))
      }
      return None
    }
  }
  None
}

fn merge_inferred_arm_types(a : String, b : String) -> (String, Bool) {
  let ta = a.trim()
  let tb = b.trim()
  if ta.length() == 0 {
    return (tb, true)
  }
  if tb.length() == 0 {
    return (ta, true)
  }
  if ta == tb {
    return (ta, true)
  }
  if ta.starts_with("(") && ta.ends_with(")") && tb.starts_with("(") && tb.ends_with(")") {
    let pa = split_top_level_type_list(ta.slice(1, ta.length() - 1))
    let pb = split_top_level_type_list(tb.slice(1, tb.length() - 1))
    if pa.length() == pb.length() && pa.length() >= 2 {
      let merged : Array[String] = []
      let mut idx = 0
      while idx < pa.length() {
        let (me, ok) = merge_inferred_arm_types(pa[idx], pb[idx])
        if !ok {
          return ("", false)
        }
        merged.push(me)
        idx = idx + 1
      }
      return ("(" + join_comma(merged) + ")", true)
    }
  }
  ("", false)
}

fn is_diverging_match_arm(ctx : StageAContext, tokens : Array[Token], bs : Int, be : Int) -> Bool {
  if bs >= be { return false }
  let is_div_start = fn(idx : Int, limit : Int) -> Bool {
    if idx >= limit { return false }
    let tk = tokens[idx]
    if tk.kind == TokenKind::Keyword &&
    (tk.raw == "return" || tk.raw == "break" || tk.raw == "continue" || tk.raw == "raise") {
      return true
    }
    if tk.kind == TokenKind::Ident && (tk.raw == "panic" || tk.raw == "abort") &&
    idx + 1 < limit && tokens[idx + 1].kind == TokenKind::LParen &&
    !ctx.symtab.local_fn_names.contains(tk.raw) &&
    lookup_ident_static_type(ctx, tk.raw).length() == 0 {
      return true
    }
    false
  }
  if is_div_start(bs, be) {
    return true
  }
  if tokens[bs].kind == TokenKind::LBrace && find_matching_delim(tokens, bs) + 1 == be {
    let inner_s = bs + 1
    let inner_e = be - 1
    let mut last_s = inner_s
    let mut k = inner_s
    let mut d = 0
    while k < inner_e {
      let tk = tokens[k]
      if d == 0 && (tk.kind == TokenKind::Semi || (k > inner_s && tk.newline_before)) {
        if tk.kind == TokenKind::Semi {
          if k + 1 < inner_e { last_s = k + 1 }
        } else {
          last_s = k
        }
      }
      if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket || tk.kind == TokenKind::LBrace { d = d + 1 }
      else if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      k = k + 1
    }
    return is_div_start(last_s, inner_e)
  }
  false
}

fn infer_match_arms_common_type(ctx : StageAContext, tokens : Array[Token], start : Int, end : Int) -> String {
  let mut acc = ""
  let mut i = start
  while i < end {
    let mut fa = i
    let mut fd = 0
    while fa < end {
      let fk = tokens[fa].kind
      if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
      else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if fd > 0 { fd = fd - 1 } }
      else if fd == 0 && fk == TokenKind::FatArrow { break }
      fa = fa + 1
    }
    if fa >= end { break }
    let bs = fa + 1
    let mut be = bs
    if bs < end && tokens[bs].kind == TokenKind::LBrace {
      be = find_matching_delim(tokens, bs) + 1
    } else if bs < end {
      be = find_expr_end(tokens, bs, end)
    }
    if be > bs && !is_diverging_match_arm(ctx, tokens, bs, be) {
      let aty = if tokens[bs].kind == TokenKind::LBrace && be == find_matching_delim(tokens, bs) + 1 {
        infer_block_ret_type_f3d2(ctx, tokens, bs, be - 1)
      } else {
        infer_simple_expr_type(ctx, tokens, bs, be)
      }
      if aty.length() > 0 {
        let (m, ok) = merge_inferred_arm_types(acc, aty)
        if !ok {
          return ""
        }
        acc = m
      }
    }
    let mut ni = be
    if ni < end && (tokens[ni].kind == TokenKind::Comma || tokens[ni].kind == TokenKind::Semi) {
      ni = ni + 1
    }
    if ni <= i { break }
    i = ni
  }
  acc
}

fn is_range_pat_atom_bound(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e { return false }
  if s + 1 == e {
    let k = tokens[s].kind
    return k == TokenKind::IntLit || k == TokenKind::CharLit || k == TokenKind::ByteCharLit
  }
  if s + 2 == e && tokens[s].kind == TokenKind::Minus && tokens[s + 1].kind == TokenKind::IntLit {
    return true
  }
  false
}

fn lower_match_arms_with_ty(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
  scrut_ty : String,
) -> String {
  let sb = StringBuilder()
  let mut pushed_inferred_arm_exp = false
  if current_expected_type(ctx).trim().length() == 0 {
    let inferred_arm_ty = infer_match_arms_common_type(ctx, tokens, start, end).trim()
    if inferred_arm_ty.length() > 0 {
      push_expected_type(ctx, inferred_arm_ty)
      ctx.inferred_exp_depth = ctx.inferred_exp_depth + 1
      pushed_inferred_arm_exp = true
    }
  }
  let mut had_guarded_struct_arm = false
  let mut has_unguarded_catchall = false
  let is_exh_arr = is_exhaustive_array_match_arms(tokens, start, end)
  let mut i = start
  while i < end {
    // Find `=>` at depth 0
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    let mut top_as_idx = -1
    while fa < end {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 {
        if k == TokenKind::FatArrow {
          break
        } else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 {
          if_idx = fa
        } else if k == TokenKind::Keyword && tokens[fa].raw == "as" && if_idx < 0 && top_as_idx < 0 {
          top_as_idx = fa
        }
      }
      fa = fa + 1
    }
    if fa >= end {
      sb.write_string(lower_expr_range(ctx, tokens, i, end, file, false))
      break
    }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    let saved_arm_sc = ctx.scope_vars.length()

    // §D2-5: Nested fixed-length / trailing-rest array pattern inside constructor(s) of arbitrary depth
    // with pre-guard binding snapshot AND strict hygienic binding-scope isolation (Astra P0-2 & P0-3).
    push_expected_type(ctx, scrut_ty)
    let nested_arr_opt = find_nested_ctor_array_pat(ctx, tokens, i, pat_end, file)
    pop_expected_type(ctx)
    match nested_arr_opt {
      Some((lbr, rbr, as_idx, outer_prefix, outer_suffix, is_json_arr)) => {
        let lead_triv = tokens[i].leading_trivia
        // Static unwrap for `Option[T]` / `Result[T, E]` (fast fail-closed for String/Bytes; unproven types go through Stage A.5 `__mbt_arrpat_len` probe!)
        let scrut_t = scrut_ty.trim()
        let mut unwrapped_inner = ""
        if (outer_prefix == "Some(" || outer_prefix == "Option::Some(") &&
        scrut_t.starts_with("Option[") && scrut_t.ends_with("]") {
          unwrapped_inner = scrut_t.slice(7, scrut_t.length() - 1).trim()
        } else if (outer_prefix == "Ok(" || outer_prefix == "Result::Ok(" ||
          outer_prefix == "Err(" || outer_prefix == "Result::Err(") &&
        scrut_t.starts_with("Result[") && scrut_t.ends_with("]") {
          let rbody = scrut_t.slice(7, scrut_t.length() - 1)
          let mut ri = 0
          let mut rd = 0
          let mut rcomma = -1
          while ri < rbody.length() {
            let ch = rbody.code_unit_at(ri)
            if ch == 40 || ch == 91 || ch == 123 { rd = rd + 1 }
            else if ch == 41 || ch == 93 || ch == 125 { if rd > 0 { rd = rd - 1 } }
            else if rd == 0 && ch == 44 { rcomma = ri; break }
            ri = ri + 1
          }
          if outer_prefix == "Err(" || outer_prefix == "Result::Err(" {
            unwrapped_inner = if rcomma > 0 { rbody.slice(rcomma + 1, rbody.length()).trim() } else { "" }
          } else {
            unwrapped_inner = if rcomma > 0 { rbody.slice(0, rcomma).trim() } else { rbody.trim() }
          }
        }
        let inner_clean = strip_type_args_sym(unwrapped_inner)
        if inner_clean == "String" || inner_clean == "Bytes" {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[lbr].line,
            tokens[lbr].col,
            "array pattern matching on `" + inner_clean + "` is not supported (only Array/FixedArray/ArrayView)",
          ))
        }
        let is_proven_arr = is_json_arr || inner_clean == "Array" || inner_clean == "FixedArray" ||
        inner_clean == "ArrayView" || inner_clean == "mbt_compat::ArrayView" ||
        inner_clean == "ArrayBuf" || inner_clean == "mbt_compat::ArrayBuf"
        // 1. Collect all raw lowercase binders in this arm's pattern & allocate globally unique hygienic temps!
        let raw_binders : Array[String] = []
        let hyg_map : Map[String, String] = Map()
        let mut bi = lbr + 1
        while bi < pat_end {
          let bt = tokens[bi]
          if bt.kind == TokenKind::Ident && bt.raw != "_" &&
          !(bi > lbr && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < pat_end && (tokens[bi + 1].kind == TokenKind::Colon || tokens[bi + 1].kind == TokenKind::Eq)) &&
          !hyg_map.contains(bt.raw) {
            raw_binders.push(bt.raw)
            hyg_map[bt.raw] = fresh_temp(ctx, "pb_" + bt.raw)
          }
          bi = bi + 1
        }
        // 2. Push `hyg_map` ONLY while lowering pattern binders (`prefix_pats`, `suffix_pats`, `rest_as_var`, `arr_var`)!
        let saved_hyg_rn = ctx.ident_renames.length()
        if hyg_map.length() > 0 {
          ctx.ident_renames.push(hyg_map)
        }
        let prefix_pats : Array[String] = []
        let suffix_pats : Array[String] = []
        let mut has_rest = false
        let mut rest_as_var = ""
        let mut seen_rest = false
        let mut invalid_rest = false
        let mut ei = lbr + 1
        while ei < rbr {
          if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
          let mut ee = ei
          let mut ed = 0
          while ee < rbr {
            let ek = tokens[ee].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && ek == TokenKind::Comma { break }
            ee = ee + 1
          }
          if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
            if seen_rest { invalid_rest = true } else { seen_rest = true; has_rest = true }
          } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
          tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
          (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
              if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
              }
            }
          } else if ee > ei {
            if is_json_arr { push_expected_type(ctx, "mbt_compat::MbtJson") }
            let lp = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
            if is_json_arr { pop_expected_type(ctx) }
            if seen_rest { suffix_pats.push(lp) } else { prefix_pats.push(lp) }
          }
          ei = ee + 1
        }
        if invalid_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[lbr].line,
            tokens[lbr].col,
            "array pattern cannot contain more than one `..` rest pattern",
          ))
        }
        let arr_var = if as_idx >= 0 { resolve_ident_in_scope(ctx, tokens[as_idx].raw) } else { fresh_temp(ctx, "ap") }
        // 3. POP `hyg_map` BEFORE lowering guard & body so inner `let x` / `fn(x)` shadowing uses native Pion lexical scope!
        restore_ident_renames(ctx, saved_hyg_rn)
        let arm_kw_renames = compute_scoped_binder_renames(ctx, raw_binders)
        let saved_kw_rn = ctx.ident_renames.length()
        if arm_kw_renames.length() > 0 {
          ctx.ident_renames.push(arm_kw_renames)
        }
        let rebind_sb = StringBuilder()
        for raw_b in raw_binders {
          let scoped_b = resolve_ident_in_scope(ctx, raw_b)
          ctx.scope_vars.push(ScopeVar::{ name: scoped_b, ty: "", is_mut: false, is_boxed: false })
          match hyg_map.get(raw_b) {
            Some(hv) => rebind_sb.write_string("let " + scoped_b + " = " + hv + "; ")
            None => ()
          }
        }
        let rebind_prefix = rebind_sb.to_string()
        // 4. Lower user guard & arm body under regular keyword renames only
        ctx.match_arr_cache_ctor.push("__BLOCKED__")
        ctx.match_arr_cache_elems.push(Map())
        ctx.match_arr_cache_suffix.push(Map())
        ctx.match_arr_cache_len.push("")
        let guard_str = if if_idx >= 0 {
          lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim()
        } else {
          ""
        }
        let body_start = fa + 1
        let mut body_raw = ""
        let mut next_i = body_start
        if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
          let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, end, file, false)
          body_raw = blk
          next_i = ni
        } else if body_start < end && tokens[body_start].kind == TokenKind::Keyword &&
        (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
          let body_end = find_loop_stmt_end(tokens, body_start, end)
          let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
          body_raw = tokens[body_start].leading_trivia + "{ " + inner_b + " }"
          next_i = body_end
        } else {
          let body_end = find_expr_end(tokens, body_start, end)
          body_raw = guard_dot_variant_arm_tail(lower_expr_range(ctx, tokens, body_start, body_end, file, false), tokens, body_end, end)
          next_i = body_end
        }
        let _ = ctx.match_arr_cache_ctor.pop()
        let _ = ctx.match_arr_cache_elems.pop()
        let _ = ctx.match_arr_cache_suffix.pop()
        let _ = ctx.match_arr_cache_len.pop()
        // 5. POP keyword renames & restore outer scope BEFORE lowering `<next_arm_chain>` (Astra P0-3)!
        restore_ident_renames(ctx, saved_kw_rn)
        restore_scope_vars(ctx, saved_arm_sc)
        let mut trail_sep = ""
        if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
          trail_sep = tokens[next_i].leading_trivia + tokens[next_i].raw
          next_i = next_i + 1
        }
        // 6. Build pre-guard element/length snapshots & sequential decision chain with exact explicit-slot caching (E1-3)
        let mc_var = fresh_temp(ctx, "mc")
        let cache_hit = ctx.match_arr_cache_ctor.length() > 0 &&
        ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == outer_prefix
        let cached_p : Map[Int, String] = if cache_hit {
          ctx.match_arr_cache_elems[ctx.match_arr_cache_elems.length() - 1]
        } else {
          Map()
        }
        let cached_s : Map[Int, String] = if cache_hit && ctx.match_arr_cache_suffix.length() > 0 {
          ctx.match_arr_cache_suffix[ctx.match_arr_cache_suffix.length() - 1]
        } else {
          Map()
        }
        let cached_len : String = if cache_hit && ctx.match_arr_cache_len.length() > 0 {
          ctx.match_arr_cache_len[ctx.match_arr_cache_len.length() - 1]
        } else {
          ""
        }
        let ext_p : Map[Int, String] = Map()
        for k in cached_p.keys() {
          match cached_p.get(k) { Some(v) => ext_p[k] = v, None => () }
        }
        let ext_s : Map[Int, String] = Map()
        for k in cached_s.keys() {
          match cached_s.get(k) { Some(v) => ext_s[k] = v, None => () }
        }
        let bind_sb = StringBuilder()
        let all_pats : Array[String] = []
        let all_exprs : Array[String] = []
        let mut sbi = 0
        while sbi < prefix_pats.length() {
          all_pats.push(prefix_pats[sbi])
          match ext_p.get(sbi) {
            Some(ev) => all_exprs.push(ev)
            None => {
              let el_v = fresh_temp(ctx, "el")
              bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + sbi.to_string() + "]; ")
              ext_p[sbi] = el_v
              all_exprs.push(el_v)
            }
          }
          sbi = sbi + 1
        }
        if suffix_pats.length() > 0 {
          let mut need_len_snap = false
          let mut si0 = 0
          while si0 < suffix_pats.length() {
            if !ext_s.contains(suffix_pats.length() - si0) { need_len_snap = true; break }
            si0 = si0 + 1
          }
          let len_snap = if need_len_snap {
            let ls = fresh_temp(ctx, "ln")
            bind_sb.write_string("let " + ls + " = " + arr_var + ".length(); ")
            ls
          } else {
            ""
          }
          let mut si = 0
          while si < suffix_pats.length() {
            let dist = suffix_pats.length() - si
            all_pats.push(suffix_pats[si])
            match ext_s.get(dist) {
              Some(prev_ev) => all_exprs.push(prev_ev)
              None => {
                let el_v = fresh_temp(ctx, "el")
                bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + len_snap + " - " + dist.to_string() + "]; ")
                ext_s[dist] = el_v
                all_exprs.push(el_v)
              }
            }
            si = si + 1
          }
        }
        let rest_end_expr = if suffix_pats.length() == 0 {
          arr_var + ".length()"
        } else {
          arr_var + ".length() - " + suffix_pats.length().to_string()
        }
        let rest_bind_prefix = if rest_as_var.length() > 0 {
          "let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
        } else {
          ""
        }
        let min_len = prefix_pats.length() + suffix_pats.length()
        let rest_uncached = if next_i < end {
          lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
        } else {
          ""
        }
        let none_uncached = if rest_uncached.length() > 0 {
          "match " + mc_var + " { " + rest_uncached + " }"
        } else {
          "panic(\"unreachable\")"
        }
        let next_cached_len = if cached_len.length() > 0 {
          cached_len
        } else if !has_rest {
          min_len.to_string()
        } else {
          ""
        }
        let none_cached = if guard_str.length() > 0 && next_i < end && (min_len > 0 || !has_rest) {
          ctx.match_arr_cache_ctor.push(outer_prefix)
          ctx.match_arr_cache_elems.push(ext_p)
          ctx.match_arr_cache_suffix.push(ext_s)
          ctx.match_arr_cache_len.push(next_cached_len)
          let rc = lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
          let _ = ctx.match_arr_cache_ctor.pop()
          let _ = ctx.match_arr_cache_elems.pop()
          let _ = ctx.match_arr_cache_suffix.pop()
          let _ = ctx.match_arr_cache_len.pop()
          if rc.length() > 0 { "match " + mc_var + " { " + rc + " }" } else { "panic(\"unreachable\")" }
        } else {
          none_uncached
        }
        let len_op = if has_rest { " >= " } else { " == " }
        let live_len_expr = if is_proven_arr { arr_var + ".length()" } else { "mbt_compat::__mbt_arrpat_len(" + arr_var + ")" }
        let len_lhs = if cached_len.length() > 0 { cached_len } else { live_len_expr }
        let len_cond = len_lhs + len_op + min_len.to_string()
        let outer_pat = outer_prefix + arr_var + outer_suffix
        let body_t = body_raw.trim()
        let body_rebound = if rebind_prefix.length() > 0 { "{ " + rebind_prefix + body_t + " }" } else { body_t }
        let guard_rebound = if rebind_prefix.length() > 0 { "{ " + rebind_prefix + guard_str + " }" } else { guard_str }
        let inner_branch = if all_pats.length() == 0 {
          if guard_str.length() > 0 {
            rest_bind_prefix + "if (" + guard_rebound + ") { " + body_rebound + " } else { " + none_cached + " }"
          } else {
            rest_bind_prefix + body_rebound
          }
        } else {
          let tup_e = if all_pats.length() == 1 { all_exprs[0] } else { "(" + join_comma(all_exprs) + ")" }
          let tup_p = if all_pats.length() == 1 { all_pats[0] } else { "(" + join_comma(all_pats) + ")" }
          let matched_arm = if guard_str.length() > 0 {
            "if (" + guard_rebound + ") { " + body_rebound + " } else { " + none_cached + " }"
          } else {
            body_rebound
          }
          bind_sb.to_string() + rest_bind_prefix + "match " + tup_e + " { " + tup_p + " => " + matched_arm + ", _ => " + none_cached + " }"
        }
        let inner_match = "match " + mc_var + " { " + outer_pat + " => if " + len_cond + " { " + inner_branch + " } else { " + none_uncached + " }, _ => " + none_uncached + " }"
        sb.write_string(lead_triv + mc_var + tokens[fa].leading_trivia + "=> " + inner_match + trail_sep)
        break
      }
      None => ()
    }
    // P1-2: Compute collision-free binder renames for this arm's pattern (e.g. `{ val, val_, .. }`)
    // BEFORE lowering guard & body so `val` -> `val_1` and `val_` -> `val_` consistently!
    let arm_raw_binders : Array[String] = []
    let mut rbi = i
    while rbi < pat_end {
      let rbt = tokens[rbi]
      if rbt.kind == TokenKind::Ident &&
      !(rbi > i && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
      !(rbi + 1 < pat_end && tokens[rbi + 1].kind == TokenKind::Colon) {
        arm_raw_binders.push(rbt.raw)
      }
      rbi = rbi + 1
    }
    let arm_pat_renames = compute_scoped_binder_renames(ctx, arm_raw_binders)
    let pushed_arm_renames = arm_pat_renames.length() > 0
    if pushed_arm_renames {
      ctx.ident_renames.push(arm_pat_renames)
    }
    for rb in arm_raw_binders {
      if rb != "_" {
        ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
      }
    }
    // Sound static binder typing for `Some(v)` / `(Some(v), ...)` / `Ctor(v0, ...)` / `.Ctor(v0, ...)` in match arms (P1-1)
    if scrut_ty.starts_with("(") && scrut_ty.ends_with(")") &&
    i < pat_end && tokens[i].kind == TokenKind::LParen && find_matching_delim(tokens, i) == pat_end - 1 {
      let mut ti = i + 1
      let mut tidx = 0
      while ti < pat_end - 1 {
        if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
        let mut te = ti
        let mut td = 0
        while te < pat_end - 1 {
          let tk = tokens[te].kind
          if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
          else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
          else if td == 0 && tk == TokenKind::Comma { break }
          te = te + 1
        }
        let elem_ty = extract_tuple_elem_type(scrut_ty, tidx).trim()
        if elem_ty.starts_with("Option[") && elem_ty.ends_with("]") &&
        te == ti + 4 && tokens[ti].kind == TokenKind::UpperIdent && tokens[ti].raw == "Some" &&
        tokens[ti + 1].kind == TokenKind::LParen && tokens[ti + 2].kind == TokenKind::Ident &&
        tokens[ti + 2].raw != "_" && tokens[ti + 3].kind == TokenKind::RParen {
          let inner_t = elem_ty.slice(7, elem_ty.length() - 1).trim()
          ctx.scope_vars.push(ScopeVar::{
            name: resolve_ident_in_scope(ctx, tokens[ti + 2].raw),
            ty: inner_t,
            is_mut: false,
            is_boxed: false,
          })
        } else if elem_ty.length() > 0 && te == ti + 1 && tokens[ti].kind == TokenKind::Ident && tokens[ti].raw != "_" {
          ctx.scope_vars.push(ScopeVar::{
            name: resolve_ident_in_scope(ctx, tokens[ti].raw),
            ty: elem_ty,
            is_mut: false,
            is_boxed: false,
          })
        }
        tidx = tidx + 1
        ti = te + 1
      }
    }
    let mut ct_scan = i
    while ct_scan + 2 < pat_end {
      let ctt = tokens[ct_scan]
      if ctt.kind == TokenKind::UpperIdent && tokens[ct_scan + 1].kind == TokenKind::LParen {
        let cp_c = find_matching_delim(tokens, ct_scan + 1)
        if cp_c < pat_end {
          let cname = ctt.raw
          // `Some(v)` when `scrut_ty` is `Option[T]`
          if cname == "Some" && scrut_ty.starts_with("Option[") && scrut_ty.ends_with("]") {
            let inner_t = scrut_ty.slice(7, scrut_ty.length() - 1).trim()
            if ct_scan + 3 == cp_c && tokens[ct_scan + 2].kind == TokenKind::Ident && tokens[ct_scan + 2].raw != "_" {
              ctx.scope_vars.push(ScopeVar::{
                name: resolve_ident_in_scope(ctx, tokens[ct_scan + 2].raw),
                ty: inner_t,
                is_mut: false,
                is_boxed: false,
              })
            }
          } else {
            match ctx.symtab.enum_schemas_by_ctor.get(cname) {
              Some(cands) => {
                let mut picked_vfields : Option[Array[AbiEnumField]] = None
                if cands.length() == 1 {
                  picked_vfields = Some(cands[0].1.fields)
                } else if scrut_ty.length() > 0 {
                  let sc_base = strip_type_args_sym(scrut_ty)
                  for cand in cands {
                    if cand.0.name == sc_base || (cand.0.pkg.length() > 0 && cand.0.pkg + "::" + cand.0.name == sc_base) {
                      picked_vfields = Some(cand.1.fields)
                      break
                    }
                  }
                }
                match picked_vfields {
                  Some(vfields) => {
                    let mut ai = ct_scan + 2
                    let mut fidx = 0
                    while ai < cp_c && fidx < vfields.length() {
                      if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
                      let mut ae = ai
                      let mut ad = 0
                      while ae < cp_c {
                        let ak = tokens[ae].kind
                        if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
                        else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
                        else if ad == 0 && ak == TokenKind::Comma { break }
                        ae = ae + 1
                      }
                      if ae == ai + 1 && tokens[ai].kind == TokenKind::Ident && tokens[ai].raw != "_" {
                        let fty = vfields[fidx].ty
                        if fty.length() > 0 {
                          ctx.scope_vars.push(ScopeVar::{
                            name: resolve_ident_in_scope(ctx, tokens[ai].raw),
                            ty: fty,
                            is_mut: false,
                            is_boxed: false,
                          })
                        }
                      }
                      fidx = fidx + 1
                      ai = ae + 1
                    }
                  }
                  None => ()
                }
              }
              None => ()
            }
          }
        }
      }
      ct_scan = ct_scan + 1
    }
    // P0-2: Block outer match's array element cache while lowering arm guard & body so nested matches never read outer cache!
    ctx.match_arr_cache_ctor.push("__BLOCKED__")
    ctx.match_arr_cache_elems.push(Map())
    ctx.match_arr_cache_suffix.push(Map())
    ctx.match_arr_cache_len.push("")
    let guard_str = if if_idx >= 0 {
      push_expected_type(ctx, "")
      let gs = collapse_guard_newlines(lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim())
      pop_expected_type(ctx)
      gs
    } else {
      ""
    }

    // Parse body first so special pattern lowerings can wrap it cleanly!
    let body_start = fa + 1
    let mut body_raw = ""
    let mut next_i = body_start
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, end, file, false)
      body_raw = blk
      next_i = ni
    } else if body_start < end && tokens[body_start].kind == TokenKind::Keyword &&
    (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
      let body_end = find_loop_stmt_end(tokens, body_start, end)
      let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      body_raw = tokens[body_start].leading_trivia + "{ " + inner_b + " }"
      next_i = body_end
    } else {
      let body_end = find_expr_end(tokens, body_start, end)
      body_raw = guard_dot_variant_arm_tail(lower_expr_range(ctx, tokens, body_start, body_end, file, false), tokens, body_end, end)
      next_i = body_end
    }
    let _ = ctx.match_arr_cache_ctor.pop()
    let _ = ctx.match_arr_cache_elems.pop()
    let _ = ctx.match_arr_cache_suffix.pop()
    let _ = ctx.match_arr_cache_len.pop()
    restore_scope_vars(ctx, saved_arm_sc)
    let mut trail_sep = ""
    if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      trail_sep = tokens[next_i].leading_trivia + tokens[next_i].raw
      next_i = next_i + 1
    }

    push_expected_type(ctx, scrut_ty)
    let lead_triv = tokens[i].leading_trivia
    let mut handled_special = false

    // Special case B2b: numeric/char range pattern `lo..=hi` / `lo..<hi` / `lo..<=hi`
    // (including `|`-separated range/literal alternatives like `'0'..='9' | 'a'..='f'`).
    if !handled_special && pat_end > i {
      let mut has_top_range_op = false
      let mut rscan = i
      let mut rdep = 0
      while rscan < pat_end {
        let rk = tokens[rscan].kind
        if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rdep = rdep + 1 }
        else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rdep > 0 { rdep = rdep - 1 } }
        else if rdep == 0 && (rk == TokenKind::DotDotEq || rk == TokenKind::DotDotLt || rk == TokenKind::DotDotLtEq) {
          has_top_range_op = true
          break
        }
        rscan = rscan + 1
      }
      if has_top_range_op {
        // Split top-level `|` alternatives and verify each is a non-empty simple range or scalar literal
        let alts : Array[(Int, Int)] = []
        let mut all_valid = true
        let mut as_i = i
        let mut adep = 0
        let mut ak = i
        while ak <= pat_end {
          if ak == pat_end || (adep == 0 && tokens[ak].kind == TokenKind::Pipe) {
            if ak <= as_i {
              all_valid = false
              break
            }
            alts.push((as_i, ak))
            as_i = ak + 1
          } else {
            let kk = tokens[ak].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { adep = adep + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if adep > 0 { adep = adep - 1 } }
          }
          ak = ak + 1
        }
        if alts.length() == 0 {
          all_valid = false
        }
        let conds : Array[String] = []
        let rv = fresh_temp(ctx, "rp")
        if all_valid {
          for alt in alts {
            let (al_s, al_e) = alt
            let mut rop = -1
            let mut j = al_s
            while j < al_e {
              let jk = tokens[j].kind
              if jk == TokenKind::DotDotEq || jk == TokenKind::DotDotLt || jk == TokenKind::DotDotLtEq {
                rop = j
                break
              }
              j = j + 1
            }
            if rop > al_s && rop + 1 < al_e &&
            is_range_pat_atom_bound(tokens, al_s, rop) &&
            is_range_pat_atom_bound(tokens, rop + 1, al_e) {
              let lo_s = lower_expr_range(ctx, tokens, al_s, rop, file, false).trim()
              let hi_s = lower_expr_range(ctx, tokens, rop + 1, al_e, file, false).trim()
              let hi_op = if tokens[rop].kind == TokenKind::DotDotLt { " < " } else { " <= " }
              conds.push("(" + rv + " >= " + lo_s + " && " + rv + hi_op + hi_s + ")")
            } else if rop < 0 && is_range_pat_atom_bound(tokens, al_s, al_e) {
              let v_s = lower_expr_range(ctx, tokens, al_s, al_e, file, false).trim()
              conds.push("(" + rv + " == " + v_s + ")")
            } else {
              all_valid = false
              break
            }
          }
        }
        if all_valid && conds.length() > 0 {
          let mut range_guard = ""
          let mut ci = 0
          while ci < conds.length() {
            if ci > 0 { range_guard = range_guard + " || " }
            range_guard = range_guard + conds[ci]
            ci = ci + 1
          }
          let full_guard = if guard_str.length() > 0 {
            "(" + range_guard + ") && (" + guard_str + ")"
          } else {
            range_guard
          }
          let fa_triv = guard_arrow_trivia(tokens[fa].leading_trivia)
          sb.write_string(lead_triv + rv + " if " + full_guard + fa_triv + "=>" + body_raw + trail_sep)
          had_guarded_struct_arm = true
          handled_special = true
        }
      }
    }

    // Special case B3 (P1-2): top-level struct pattern `{ f1, f2: pat, .. }` or `S::{ f1, f2: pat, .. }`
    // Pion does not support struct patterns in `match`, so lower to a hygienic binding `sp` with
    // `rename_struct_field` field accesses and collision-free local binders (`val` -> `val_1`, `val_` -> `val_`).
    let mut sp_open_b = -1
    let mut sp_explicit_sname = ""
    if !handled_special && tokens[i].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i)
      if cb == pat_end - 1 {
        sp_open_b = i
      }
    } else if !handled_special && i + 2 < pat_end && tokens[i].kind == TokenKind::UpperIdent &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i + 2)
      if cb == pat_end - 1 {
        sp_open_b = i + 2
        sp_explicit_sname = tokens[i].raw
      }
    }
    if !handled_special && sp_open_b >= 0 {
      let cb = find_matching_delim(tokens, sp_open_b)
      // Resolve struct name: explicit `S::` > `scrut_ty` > unique field-set superset in `ctx.struct_field_renames`
      let mut resolved_sname = sp_explicit_sname
      if resolved_sname.length() == 0 {
        let sc = strip_type_args_sym(scrut_ty)
        if sc.length() > 0 && ctx.struct_field_renames.contains(sc) {
          resolved_sname = sc
        }
      }
      if resolved_sname.length() == 0 {
        let mentioned : Array[String] = []
        let mut mf = sp_open_b + 1
        while mf < cb {
          if tokens[mf].kind == TokenKind::Comma || tokens[mf].kind == TokenKind::DotDot { mf = mf + 1; continue }
          let mut mfe = mf
          let mut mfd = 0
          while mfe < cb {
            let mfk = tokens[mfe].kind
            if mfk == TokenKind::LParen || mfk == TokenKind::LBracket || mfk == TokenKind::LBrace { mfd = mfd + 1 }
            else if mfk == TokenKind::RParen || mfk == TokenKind::RBracket || mfk == TokenKind::RBrace { mfd = mfd - 1 }
            else if mfd == 0 && mfk == TokenKind::Comma { break }
            mfe = mfe + 1
          }
          if tokens[mf].kind == TokenKind::Ident || tokens[mf].kind == TokenKind::Keyword {
            mentioned.push(tokens[mf].raw)
          }
          mf = mfe + 1
        }
        if mentioned.length() > 0 {
          let mut match_cnt = 0
          let mut match_name = ""
          for cand_s in ctx.struct_field_renames.keys() {
            match ctx.struct_field_renames.get(cand_s) {
              Some(rmap) => {
                let mut all_ok = true
                for fraw in mentioned {
                  if !rmap.contains(fraw) { all_ok = false; break }
                }
                if all_ok {
                  match_cnt = match_cnt + 1
                  match_name = cand_s
                }
              }
              None => ()
            }
          }
          if match_cnt == 1 {
            resolved_sname = match_name
          }
        }
      }
      let bind_var = fresh_temp(ctx, "sp")
      let non_bind_guards : Array[String] = []
      let bind_fields : Array[(String, String)] = []
      let mut fi = sp_open_b + 1
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot { fi = fi + 1; continue }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        let raw_f = tokens[fi].raw
        let access_f = if resolved_sname.length() > 0 {
          rename_struct_field(ctx, resolved_sname, raw_f)
        } else if raw_f == "val" {
          alloc_fresh_val_placeholder(ctx, tokens[fi].line, tokens[fi].col)
        } else {
          rename_keyword_ident(raw_f)
        }
        let fexpr = bind_var + "." + access_f
        if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
        fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
          let vs = fi + 2
          let mut has_binder = false
          let mut bi = vs
          while bi < fe {
            if tokens[bi].kind == TokenKind::Ident &&
            !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
            !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
              has_binder = true
            }
            bi = bi + 1
          }
          if has_binder {
            let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
            bind_fields.push((fexpr, pat_s))
          } else if vs < fe {
            let vt = tokens[vs]
            if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
              vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
              non_bind_guards.push(fexpr + " == " + vt.raw)
            } else {
              let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
              if ps != "_" {
                non_bind_guards.push("(" + fexpr + " is " + ps + ")")
              }
            }
          }
        } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
          let local_b = resolve_ident_in_scope(ctx, raw_f)
          bind_fields.push((fexpr, local_b))
        }
        fi = fe + 1
      }
      let nbg_sb = StringBuilder()
      let mut ni = 0
      while ni < non_bind_guards.length() {
        if ni > 0 { nbg_sb.write_string(" && ") }
        nbg_sb.write_string(non_bind_guards[ni])
        ni = ni + 1
      }
      let fguards = nbg_sb.to_string()
      if bind_fields.length() > 0 {
        let mut all_irrefutable = true
        for bf in bind_fields {
          if !is_irrefutable_simple_pat(bf.1) {
            all_irrefutable = false
            break
          }
        }
        let scrut_e = if bind_fields.length() == 1 {
          bind_fields[0].0
        } else {
          let es : Array[String] = []
          for bf in bind_fields { es.push(bf.0) }
          "(" + join_comma(es) + ")"
        }
        let pat_e = if bind_fields.length() == 1 {
          bind_fields[0].1
        } else {
          let ps : Array[String] = []
          for bf in bind_fields { ps.push(bf.1) }
          "(" + join_comma(ps) + ")"
        }
        if all_irrefutable && fguards.length() == 0 && guard_str.length() == 0 {
          has_unguarded_catchall = true
          sb.write_string(lead_triv + bind_var + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep)
        } else {
          had_guarded_struct_arm = true
          let guard_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          let match_g = "(match " + scrut_e + " { " + pat_e + " => " + guard_rhs + ", _ => false })"
          let full_g = if fguards.length() > 0 { "(" + fguards + ") && " + match_g } else { match_g }
          sb.write_string(lead_triv + bind_var + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep)
        }
      } else {
        let full_g = if fguards.length() > 0 && guard_str.length() > 0 {
          "(" + fguards + ") && (" + guard_str + ")"
        } else if fguards.length() > 0 {
          fguards
        } else {
          guard_str
        }
        let g_part = if full_g.length() > 0 {
          had_guarded_struct_arm = true
          " if " + full_g
        } else {
          has_unguarded_catchall = true
          ""
        }
        sb.write_string(lead_triv + bind_var + g_part + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
      }
      handled_special = true
    }

    // Special case A: top-level or nested/parenthesized `as` pattern (`pat as x`, `(pat as x)`,
    // `Some(Object(_) as v)`, `((A(v) | B(v)) as x)`). Preserves single-eval, guard visibility,
    // failure backtrack, outer shadowing, and never hoists bindings out of the arm.
    if !handled_special && !pattern_contains_struct_pat(tokens, i, pat_end) &&
    pattern_contains_as_kw_f42(tokens, i, pat_end) &&
    !pattern_has_array_pat_without_inner_as_f42(tokens, i, pat_end) {
      let (outer_pat, as_obls, bad_or_as) = peel_as_patterns_in_pat(ctx, tokens, i, pat_end, file)
      if bad_or_as || as_obls.length() == 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          tokens[i].line,
          tokens[i].col,
          "`as` pattern in unsupported position (or-branch, labeled arg, or array pattern) is not supported (fail-closed)",
        ))
        handled_special = true
      } else {
        let (full_g, full_b) = expand_as_pat_obligations(ctx, as_obls, 0, guard_str, body_raw.trim())
        let g_suffix = if full_g == "true" { "" } else { " if " + full_g }
        sb.write_string(lead_triv + outer_pat.trim() + g_suffix + tokens[fa].leading_trivia + "=> " + full_b + trail_sep)
        handled_special = true
      }
    }

    // Special case B2: Tuple struct pattern `TupleStruct(p0, p1, ...) [if guard] => body`
    // Pion does not support struct patterns (`Pair::{ _0: 1, _1: n }`), so lower to a hygienic
    // binding `__ts` with an outer `if` guard + inner `match` over `(__ts._0, __ts._1, ...)`.
    if !handled_special && i + 1 < pat_end && tokens[i].kind == TokenKind::UpperIdent &&
    ctx.symtab.tuple_structs.contains(tokens[i].raw) && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      if cp == pat_end - 1 {
        let sub_pats : Array[String] = []
        let sub_ranges : Array[(Int, Int)] = []
        let mut has_array_subpat = false
        let mut all_irrefutable = true
        let mut bad_rest = false
        let mut saw_rest = false
        let mut pi = i + 2
        while pi < cp {
          if tokens[pi].kind == TokenKind::Comma { pi = pi + 1; continue }
          if tokens[pi].kind == TokenKind::DotDot {
            saw_rest = true
            pi = pi + 1
            continue
          }
          if saw_rest {
            bad_rest = true
          }
          let mut pe = pi
          let mut pd = 0
          while pe < cp {
            let pk = tokens[pe].kind
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
            else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
            else if pd == 0 && pk == TokenKind::Comma { break }
            pe = pe + 1
          }
          if pe > pi {
            if tokens[pi].kind == TokenKind::LBracket && find_matching_delim(tokens, pi) == pe - 1 {
              has_array_subpat = true
            }
            let ps = lower_expr_range(ctx, tokens, pi, pe, file, true).trim()
            sub_pats.push(ps)
            sub_ranges.push((pi, pe))
            if !(pe == pi + 1 && (tokens[pi].kind == TokenKind::Ident || tokens[pi].kind == TokenKind::Underscore)) {
              all_irrefutable = false
            }
          }
          pi = pe + 1
        }
        if bad_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "non-trailing `..` rest pattern in tuple struct `" + tokens[i].raw + "` is not supported",
          ))
        }
        let ts_var = fresh_temp(ctx, "ts")
        if has_array_subpat {
          // Astra P1-2: Option-threading lowering for nested array sub-patterns inside tuple structs;
          // binds array elements ONCE before guard so guard mutations cannot corrupt bound values!
          let len_checks : Array[String] = []
          let flat_exprs : Array[String] = []
          let flat_pats : Array[String] = []
          let mut k = 0
          while k < sub_ranges.length() {
            let sr = sub_ranges[k]
            let field_e = ts_var + "._" + k.to_string()
            if tokens[sr.0].kind == TokenKind::LBracket && find_matching_delim(tokens, sr.0) == sr.1 - 1 {
              let cbr = sr.1 - 1
              let elems : Array[String] = []
              let mut has_trailing_rest = false
              let mut seen_rest = false
              let mut invalid_rest = false
              let mut ei = sr.0 + 1
              while ei < cbr {
                if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
                let mut ee = ei
                let mut ed = 0
                while ee < cbr {
                  let ek = tokens[ee].kind
                  if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
                  else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
                  else if ed == 0 && ek == TokenKind::Comma { break }
                  ee = ee + 1
                }
                if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
                  if seen_rest {
                    invalid_rest = true
                  } else {
                    seen_rest = true
                    has_trailing_rest = true
                  }
                } else if ee > ei {
                  if seen_rest {
                    invalid_rest = true
                  }
                  elems.push(lower_expr_range(ctx, tokens, ei, ee, file, true).trim())
                }
                ei = ee + 1
              }
              if invalid_rest {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  file,
                  tokens[sr.0].line,
                  tokens[sr.0].col,
                  "array rest pattern `..` is only supported at the end of an array pattern",
                ))
              }
              let len_op = if has_trailing_rest { " >= " } else { " == " }
              len_checks.push(field_e + ".length()" + len_op + elems.length().to_string())
              let mut j = 0
              while j < elems.length() {
                flat_exprs.push(field_e + "[" + j.to_string() + "]")
                flat_pats.push(elems[j])
                j = j + 1
              }
            } else {
              flat_exprs.push(field_e)
              flat_pats.push(sub_pats[k])
            }
            k = k + 1
          }
          let lc_sb = StringBuilder()
          let mut li = 0
          while li < len_checks.length() {
            if li > 0 { lc_sb.write_string(" && ") }
            lc_sb.write_string(len_checks[li])
            li = li + 1
          }
          let g_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          let inner_opt = if flat_exprs.length() == 0 {
            "if " + lc_sb.to_string() + " && " + g_rhs + " { Some(" + body_raw.trim() + ") } else { None }"
          } else {
            let scrut_f = if flat_exprs.length() == 1 { flat_exprs[0] } else { "(" + join_comma(flat_exprs) + ")" }
            let pat_f = if flat_pats.length() == 1 { flat_pats[0] } else { "(" + join_comma(flat_pats) + ")" }
            "if " + lc_sb.to_string() + " { match " + scrut_f + " { " + pat_f + " => if " + g_rhs + " { Some(" + body_raw.trim() + ") } else { None }, _ => None } } else { None }"
          }
          let res_var = fresh_temp(ctx, "tsr")
          let rest_arms = if next_i < end {
            lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
          } else {
            ""
          }
          let none_arm = if rest_arms.length() > 0 {
            "match " + ts_var + " { " + rest_arms + " }"
          } else {
            "panic(\"unreachable\")"
          }
          sb.write_string(
            lead_triv + ts_var + tokens[fa].leading_trivia + "=> match (" + inner_opt + ") { Some(" + res_var + ") => " + res_var + ", None => " + none_arm + " }" + trail_sep,
          )
          pop_expected_type(ctx)
          break
        } else if sub_pats.length() == 0 {
          if guard_str.length() > 0 {
            sb.write_string(lead_triv + ts_var + " if " + guard_str + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
          } else {
            sb.write_string(lead_triv + ts_var + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
          }
        } else if all_irrefutable && guard_str.length() == 0 {
          let bind_sb = StringBuilder()
          let mut k = 0
          while k < sub_pats.length() {
            if sub_pats[k] != "_" {
              bind_sb.write_string("let " + sub_pats[k] + " = " + ts_var + "._" + k.to_string() + "; ")
            }
            k = k + 1
          }
          sb.write_string(lead_triv + ts_var + tokens[fa].leading_trivia + "=> { " + bind_sb.to_string() + body_raw.trim() + " }" + trail_sep)
        } else {
          let f_exprs : Array[String] = []
          let mut k = 0
          while k < sub_pats.length() {
            f_exprs.push(ts_var + "._" + k.to_string())
            k = k + 1
          }
          let scrut_f = if f_exprs.length() == 1 { f_exprs[0] } else { "(" + join_comma(f_exprs) + ")" }
          let pat_f = if sub_pats.length() == 1 { sub_pats[0] } else { "(" + join_comma(sub_pats) + ")" }
          let g_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          sb.write_string(
            lead_triv + ts_var + " if (match " + scrut_f + " { " + pat_f + " => " + g_rhs + ", _ => false })" +
            tokens[fa].leading_trivia + "=> match " + scrut_f + " { " + pat_f + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep,
          )
        }
        handled_special = true
      }
    }

    // Special case B: Arbitrary nested/tuple/constructor struct patterns (`Ctor({ ... })`,
    // `Some({ hit: Some({ back: Some(p), .. }), .. })`, `(Some({ way: Some(w), .. }), _)`, etc.).
    // Recursively peels every `{ ... }` / `S::{ ... }` inside the pattern into hygienic bindings
    // and nests `match` checks + arm `guard_str` inside the outer `if` guard for clean fallthrough.
    if !handled_special && pattern_contains_struct_pat(tokens, i, pat_end) {
      let mut has_top_pipe = false
      let mut pk = i
      let mut pdp = 0
      while pk < pat_end {
        let pkk = tokens[pk].kind
        if pkk == TokenKind::LParen || pkk == TokenKind::LBracket || pkk == TokenKind::LBrace { pdp = pdp + 1 }
        else if pkk == TokenKind::RParen || pkk == TokenKind::RBracket || pkk == TokenKind::RBrace { if pdp > 0 { pdp = pdp - 1 } }
        else if pdp == 0 && pkk == TokenKind::Pipe { has_top_pipe = true; break }
        pk = pk + 1
      }
      if !has_top_pipe {
        let (outer_pat, obls) = peel_struct_patterns_in_pat(ctx, tokens, i, pat_end, file)
        if obls.length() > 0 {
          if if_idx >= 0 && !guard_tokens_are_pure(tokens, if_idx + 1, fa) &&
          struct_pat_obls_have_binders(tokens, obls) {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[if_idx].line,
              tokens[if_idx].col,
              "struct pattern with bindings and non-pure `if` guard is not supported (guard may mutate bound fields)",
            ))
          } else {
            let (full_g, full_b) = expand_struct_pat_obligations(
              ctx,
              tokens,
              obls,
              0,
              file,
              guard_str,
              body_raw.trim(),
            )
            let g_suffix = if full_g == "true" { "" } else { " if " + full_g }
            sb.write_string(lead_triv + outer_pat.trim() + g_suffix + tokens[fa].leading_trivia + "=> " + full_b + trail_sep)
            handled_special = true
          }
        }
      } else {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          tokens[i].line,
          tokens[i].col,
          "struct pattern inside or-pattern `|` in `match` arm is not supported",
        ))
      }
    }

    // Special case D: top-level array pattern `[]`, `[one]`, `[.., last]`, `[a, .. as mid, z]` (and optional `as whole`)
    if !handled_special && tokens[i].kind == TokenKind::LBracket {
      let cbr = find_matching_delim(tokens, i)
      let has_as = cbr + 2 == pat_end - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
      if cbr == pat_end - 1 || has_as {
        let scrut_clean = strip_type_args_sym(scrut_ty)
        if scrut_clean == "String" || scrut_clean == "Bytes" {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "array pattern matching on `" + scrut_clean + "` is not supported (only Array/FixedArray/ArrayView)",
          ))
        }
        let is_proven_arr = scrut_clean == "Array" || scrut_clean == "FixedArray" ||
        scrut_clean == "ArrayView" || scrut_clean == "mbt_compat::ArrayView" ||
        scrut_clean == "ArrayBuf" || scrut_clean == "mbt_compat::ArrayBuf"
        let mut has_rest = false
        let mut rest_as_var = ""
        let mut seen_rest = false
        let mut invalid_rest = false
        let prefix_pats : Array[String] = []
        let suffix_pats : Array[String] = []
        let mut ei = i + 1
        while ei < cbr {
          if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
          let mut ee = ei
          let mut ed = 0
          while ee < cbr {
            let ek = tokens[ee].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && ek == TokenKind::Comma { break }
            ee = ee + 1
          }
          if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
            }
          } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
          tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
          (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
              if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
              }
            }
          } else if ee > ei {
            let lp = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
            if seen_rest { suffix_pats.push(lp) } else { prefix_pats.push(lp) }
          }
          ei = ee + 1
        }
        if invalid_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "array pattern cannot contain more than one `..` rest pattern",
          ))
          handled_special = true
        } else {
          let arr_var = if has_as { rename_keyword_ident(tokens[cbr + 2].raw) } else { fresh_temp(ctx, "ap") }
          let min_len = prefix_pats.length() + suffix_pats.length()
          let len_op = if has_rest { " >= " } else { " == " }
          let cache_hit_top = ctx.match_arr_cache_ctor.length() > 0 &&
          ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == ""
          let cached_len_top : String = if cache_hit_top && ctx.match_arr_cache_len.length() > 0 {
            ctx.match_arr_cache_len[ctx.match_arr_cache_len.length() - 1]
          } else {
            ""
          }
          let live_len_expr = if is_proven_arr { arr_var + ".length()" } else { "mbt_compat::__mbt_arrpat_len(" + arr_var + ")" }
          let len_lhs_top = if cached_len_top.length() > 0 { cached_len_top } else { live_len_expr }
          let len_cond = len_lhs_top + len_op + min_len.to_string()
          let rest_end_expr = if suffix_pats.length() == 0 {
            arr_var + ".length()"
          } else {
            arr_var + ".length() - " + suffix_pats.length().to_string()
          }
          let rest_tmp_var = if rest_as_var.length() > 0 { fresh_temp(ctx, "rb") } else { "" }
          let rest_eval_prefix = if rest_as_var.length() > 0 {
            "let " + rest_tmp_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
          } else {
            ""
          }
          let rest_rebind_prefix = if rest_as_var.length() > 0 {
            "let " + rest_as_var + " = " + rest_tmp_var + "; "
          } else {
            ""
          }
          let rest_bind_prefix = if rest_as_var.length() > 0 {
            "let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
          } else {
            ""
          }
          let body_with_rest = if rest_bind_prefix.length() > 0 {
            "{ " + rest_bind_prefix + body_raw.trim() + " }"
          } else {
            body_raw.trim()
          }
          if min_len == 0 {
            let full_g = if guard_str.length() > 0 {
              len_cond + " && (" + (if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }) + ")"
            } else {
              len_cond
            }
            sb.write_string(lead_triv + arr_var + " if " + full_g + tokens[fa].leading_trivia + "=> " + body_with_rest + trail_sep)
          } else {
            let cache_hit = ctx.match_arr_cache_ctor.length() > 0 &&
            ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == ""
            let cached_p : Map[Int, String] = if cache_hit {
              ctx.match_arr_cache_elems[ctx.match_arr_cache_elems.length() - 1]
            } else {
              Map()
            }
            let cached_s : Map[Int, String] = if cache_hit && ctx.match_arr_cache_suffix.length() > 0 {
              ctx.match_arr_cache_suffix[ctx.match_arr_cache_suffix.length() - 1]
            } else {
              Map()
            }
            if guard_str.length() > 0 || suffix_pats.length() > 0 || rest_as_var.length() > 0 || cached_p.length() > 0 || cached_s.length() > 0 {
              let res_var = fresh_temp(ctx, "apr")
              let ext_p : Map[Int, String] = Map()
              for k in cached_p.keys() {
                match cached_p.get(k) { Some(v) => ext_p[k] = v, None => () }
              }
              let ext_s : Map[Int, String] = Map()
              for k in cached_s.keys() {
                match cached_s.get(k) { Some(v) => ext_s[k] = v, None => () }
              }
              let bind_sb = StringBuilder()
              let all_pats : Array[String] = []
              let all_exprs : Array[String] = []
              let mut bi = 0
              while bi < prefix_pats.length() {
                all_pats.push(prefix_pats[bi])
                match ext_p.get(bi) {
                  Some(ev) => all_exprs.push(ev)
                  None => {
                    let el_v = fresh_temp(ctx, "el")
                    bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + bi.to_string() + "]; ")
                    ext_p[bi] = el_v
                    all_exprs.push(el_v)
                  }
                }
                bi = bi + 1
              }
              if suffix_pats.length() > 0 {
                let mut need_len_snap = false
                let mut si0 = 0
                while si0 < suffix_pats.length() {
                  if !ext_s.contains(suffix_pats.length() - si0) { need_len_snap = true; break }
                  si0 = si0 + 1
                }
                let len_snap = if need_len_snap {
                  let ls = fresh_temp(ctx, "ln")
                  bind_sb.write_string("let " + ls + " = " + arr_var + ".length(); ")
                  ls
                } else {
                  ""
                }
                let mut si = 0
                while si < suffix_pats.length() {
                  let dist = suffix_pats.length() - si
                  all_pats.push(suffix_pats[si])
                  match ext_s.get(dist) {
                    Some(prev_ev) => all_exprs.push(prev_ev)
                    None => {
                      let el_v = fresh_temp(ctx, "el")
                      bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + len_snap + " - " + dist.to_string() + "]; ")
                      ext_s[dist] = el_v
                      all_exprs.push(el_v)
                    }
                  }
                  si = si + 1
                }
              }
              let el_scrut_e = if all_pats.length() == 1 { all_exprs[0] } else { "(" + join_comma(all_exprs) + ")" }
              let pat_e = if all_pats.length() == 1 { all_pats[0] } else { "(" + join_comma(all_pats) + ")" }
              let rest_uncached = if next_i < end {
                lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
              } else {
                ""
              }
              let none_uncached = if rest_uncached.length() > 0 {
                if is_exh_arr && !str_has(rest_uncached, "_ => panic(\"unreachable\")") {
                  "match " + arr_var + " { " + rest_uncached + "\n    _ => panic(\"unreachable\") }"
                } else {
                  "match " + arr_var + " { " + rest_uncached + " }"
                }
              } else {
                "panic(\"unreachable\")"
              }
              let next_cached_len_top = if cached_len_top.length() > 0 {
                cached_len_top
              } else if !has_rest {
                min_len.to_string()
              } else {
                ""
              }
              let none_cached = if guard_str.length() > 0 && next_i < end {
                ctx.match_arr_cache_ctor.push("")
                ctx.match_arr_cache_elems.push(ext_p)
                ctx.match_arr_cache_suffix.push(ext_s)
                ctx.match_arr_cache_len.push(next_cached_len_top)
                let rc = lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
                let _ = ctx.match_arr_cache_ctor.pop()
                let _ = ctx.match_arr_cache_elems.pop()
                let _ = ctx.match_arr_cache_suffix.pop()
                let _ = ctx.match_arr_cache_len.pop()
                if rc.length() > 0 {
                  if is_exh_arr && !str_has(rc, "_ => panic(\"unreachable\")") {
                    "match " + arr_var + " { " + rc + "\n    _ => panic(\"unreachable\") }"
                  } else {
                    "match " + arr_var + " { " + rc + " }"
                  }
                } else {
                  "panic(\"unreachable\")"
                }
              } else {
                none_uncached
              }
              let inner_arm = if guard_str.length() > 0 {
                let g_arm = "if (" + guard_str + ") { Option::Some(" + body_raw.trim() + ") } else { Option::None }"
                if rest_rebind_prefix.length() > 0 { "{ " + rest_rebind_prefix + g_arm + " }" } else { g_arm }
              } else {
                if rest_rebind_prefix.length() > 0 {
                  "{ " + rest_rebind_prefix + "Option::Some(" + body_raw.trim() + ") }"
                } else {
                  "Option::Some(" + body_raw.trim() + ")"
                }
              }
              sb.write_string(
                lead_triv + arr_var + tokens[fa].leading_trivia + "=> if " + len_cond + " { " + bind_sb.to_string() + rest_eval_prefix + "match (match " + el_scrut_e + " { " + pat_e + " => " + inner_arm + ", _ => Option::None }) { Option::Some(" + res_var + ") => " + res_var + ", Option::None => " + none_cached + " } } else { " + none_uncached + " }" + trail_sep,
              )
              pop_expected_type(ctx)
              if pushed_arm_renames { let _ = ctx.ident_renames.pop() }
              break
            }
            let es : Array[String] = []
            let mut idx = 0
            while idx < prefix_pats.length() {
              es.push(arr_var + "[" + idx.to_string() + "]")
              idx = idx + 1
            }
            let scrut_e = if prefix_pats.length() == 1 { es[0] } else { "(" + join_comma(es) + ")" }
            let pat_e = if prefix_pats.length() == 1 { prefix_pats[0] } else { "(" + join_comma(prefix_pats) + ")" }
            let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => true, _ => false })"
            sb.write_string(lead_triv + arr_var + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
          }
          handled_special = true
        }
      }
    }

    // Special case E (P1-3): Tuple pattern `(p0, p1, ...)` containing one or more nested array patterns
    // (e.g. `([_, _] as fs, _) => fs[1]` or `([a, b, .. as tail], x) if a > x => ...`).
    if !handled_special && tokens[i].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp == pat_end - 1 {
        let tup_ranges : Array[(Int, Int)] = []
        let mut has_nested_arr = false
        let mut ti = i + 1
        while ti < cp {
          if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
          let mut te = ti
          let mut td = 0
          while te < cp {
            let tk = tokens[te].kind
            if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
            else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
            else if td == 0 && tk == TokenKind::Comma { break }
            te = te + 1
          }
          if te > ti {
            tup_ranges.push((ti, te))
            if tokens[ti].kind == TokenKind::LBracket {
              let cbr = find_matching_delim(tokens, ti)
              let has_as = cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
              if cbr == te - 1 || has_as {
                has_nested_arr = true
              }
            }
          }
          ti = te + 1
        }
        if has_nested_arr && tup_ranges.length() >= 2 {
          // Extract tuple scrutinee element types if `scrut_ty` is `(T0, T1, ...)` for String/Bytes rejection.
          let scrut_elem_tys : Array[String] = []
          let st_trim = scrut_ty.trim()
          if st_trim.starts_with("(") && st_trim.ends_with(")") {
            let inner_st = st_trim.slice(1, st_trim.length() - 1)
            let mut si = 0
            let mut sstart = 0
            let mut sd = 0
            while si < inner_st.length() {
              let ch = inner_st.code_unit_at(si)
              if ch == 40 || ch == 91 || ch == 123 { sd = sd + 1 }
              else if ch == 41 || ch == 93 || ch == 125 { if sd > 0 { sd = sd - 1 } }
              else if sd == 0 && ch == 44 {
                scrut_elem_tys.push(inner_st.slice(sstart, si).trim())
                sstart = si + 1
              }
              si = si + 1
            }
            scrut_elem_tys.push(inner_st.slice(sstart, inner_st.length()).trim())
          }
          let outer_pats : Array[String] = []
          let len_conds : Array[String] = []
          let rest_binds_sb = StringBuilder()
          let el_exprs : Array[String] = []
          let el_pats : Array[String] = []
          let mut invalid_rest = false
          let mut k = 0
          while k < tup_ranges.length() {
            let (ts, te) = tup_ranges[k]
            let is_arr_el = if tokens[ts].kind == TokenKind::LBracket {
              let cbr = find_matching_delim(tokens, ts)
              cbr == te - 1 || (cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as")
            } else {
              false
            }
            if is_arr_el {
              if k < scrut_elem_tys.length() {
                let ec = strip_type_args_sym(scrut_elem_tys[k])
                if ec == "String" || ec == "Bytes" {
                  ctx.diags.push(diag_error(
                    "MBT2PION_UNSUPPORTED_SYNTAX",
                    file,
                    tokens[ts].line,
                    tokens[ts].col,
                    "array pattern matching on `" + ec + "` is not supported (only Array/FixedArray/ArrayView)",
                  ))
                }
              }
              let cbr = find_matching_delim(tokens, ts)
              let has_as = cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
              let arr_var = if has_as { resolve_ident_in_scope(ctx, tokens[cbr + 2].raw) } else { fresh_temp(ctx, "ap") }
              outer_pats.push(arr_var)
              let mut has_trailing_rest = false
              let mut rest_as_var = ""
              let mut seen_rest = false
              let mut elem_cnt = 0
              let mut ei = ts + 1
              while ei < cbr {
                if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
                let mut ee = ei
                let mut ed = 0
                while ee < cbr {
                  let ek = tokens[ee].kind
                  if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
                  else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
                  else if ed == 0 && ek == TokenKind::Comma { break }
                  ee = ee + 1
                }
                if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
                  if seen_rest { invalid_rest = true } else { seen_rest = true; has_trailing_rest = true }
                } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
                tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
                (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
                  if seen_rest {
                    invalid_rest = true
                  } else {
                    seen_rest = true
                    has_trailing_rest = true
                    if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                      rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
                    }
                  }
                } else if ee > ei {
                  if seen_rest { invalid_rest = true }
                  let ep = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
                  if ep != "_" {
                    el_exprs.push(arr_var + "[" + elem_cnt.to_string() + "]")
                    el_pats.push(ep)
                  }
                  elem_cnt = elem_cnt + 1
                }
                ei = ee + 1
              }
              let len_op = if has_trailing_rest { " >= " } else { " == " }
              len_conds.push(arr_var + ".length()" + len_op + elem_cnt.to_string())
              if rest_as_var.length() > 0 {
                rest_binds_sb.write_string("let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + elem_cnt.to_string() + ", " + arr_var + ".length()); ")
              }
            } else {
              outer_pats.push(lower_expr_range(ctx, tokens, ts, te, file, true).trim())
            }
            k = k + 1
          }
          if invalid_rest {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[i].line,
              tokens[i].col,
              "array rest pattern `..` is only supported at the end of an array pattern",
            ))
            handled_special = true
          } else {
            let outer_pat = "(" + join_comma(outer_pats) + ")"
            let lc_sb = StringBuilder()
            let mut li = 0
            while li < len_conds.length() {
              if li > 0 { lc_sb.write_string(" && ") }
              lc_sb.write_string(len_conds[li])
              li = li + 1
            }
            let len_cond = lc_sb.to_string()
            let rest_bind_prefix = rest_binds_sb.to_string()
            let body_with_rest = if rest_bind_prefix.length() > 0 {
              "{ " + rest_bind_prefix + body_raw.trim() + " }"
            } else {
              body_raw.trim()
            }
            if el_pats.length() == 0 {
              let full_g = if guard_str.length() > 0 {
                len_cond + " && (" + (if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }) + ")"
              } else {
                len_cond
              }
              sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> " + body_with_rest + trail_sep)
            } else {
              let scrut_e = if el_exprs.length() == 1 { el_exprs[0] } else { "(" + join_comma(el_exprs) + ")" }
              let pat_e = if el_pats.length() == 1 { el_pats[0] } else { "(" + join_comma(el_pats) + ")" }
              if guard_str.length() > 0 {
                let guard_rhs = if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }
                let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => (" + guard_rhs + "), _ => false })"
                sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
              } else {
                let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => true, _ => false })"
                sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
              }
            }
            handled_special = true
          }
        }
      }
    }

    if !handled_special {
      let expanded = expand_nested_or_pat(ctx, tokens, i, pat_end, file)
      if guard_str.length() == 0 && expanded.length() == 1 && is_irrefutable_simple_pat(expanded[0]) {
        has_unguarded_catchall = true
      }
      let pat_sb = StringBuilder()
      let mut ei = 0
      while ei < expanded.length() {
        if ei > 0 { pat_sb.write_string(" | ") }
        pat_sb.write_string(expanded[ei])
        ei = ei + 1
      }
      let g_part = if guard_str.length() > 0 { " if " + guard_str } else { "" }
      let fa_triv = if guard_str.length() > 0 { guard_arrow_trivia(tokens[fa].leading_trivia) } else { tokens[fa].leading_trivia }
      sb.write_string(lead_triv + pat_sb.to_string() + g_part + fa_triv + "=>" + body_raw + trail_sep)
    }
    if pushed_arm_renames {
      let _ = ctx.ident_renames.pop()
    }
    pop_expected_type(ctx)
    i = next_i
  }
  if (had_guarded_struct_arm || is_exh_arr) && !has_unguarded_catchall {
    sb.write_string("\n    _ => panic(\"unreachable\")")
  }
  if pushed_inferred_arm_exp {
    ctx.inferred_exp_depth = ctx.inferred_exp_depth - 1
    pop_expected_type(ctx)
  }
  sb.to_string()
}

fn is_unsupported_error_kw(tk : Token) -> Bool {
  (tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident) &&
  (tk.raw == "raise" || tk.raw == "try" || tk.raw == "catch")
}

fn check_unsupported_error_tokens(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> Unit {
  let mut k = start
  while k < end {
    if is_unsupported_error_kw(tokens[k]) && !(k > 0 && tokens[k - 1].kind == TokenKind::Dot) {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[k].line,
        tokens[k].col,
        "unsupported MoonBit error-handling syntax `" + tokens[k].raw + "` (requires explicit lowering or overlay)",
      ))
    }
    k = k + 1
  }
}

fn count_error_diags(diags : Array[Diag]) -> Int {
  let mut c = 0
  for d in diags {
    if d.severity == "error" {
      c = c + 1
    }
  }
  c
}

///| Split top-level comma-separated `#cfg(...)` arguments respecting nested `(...)` and `"..."`.
fn split_cfg_args(inner : String) -> Array[String] {
  let out : Array[String] = []
  let mut depth = 0
  let mut in_str = false
  let mut start = 0
  let mut i = 0
  let n = inner.length()
  while i < n {
    let c = inner.code_unit_at(i)
    if in_str {
      if c == 92 && i + 1 < n {
        i = i + 2
        continue
      }
      if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 40 {
      depth = depth + 1
    } else if c == 41 {
      if depth > 0 { depth = depth - 1 }
    } else if c == 44 && depth == 0 {
      out.push(inner.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  if start <= n {
    let last = inner.slice(start, n).trim()
    if last.length() > 0 {
      out.push(last)
    }
  }
  out
}

fn hex_digit_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn sb_write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 127 {
    sb.write_byte(cp.to_byte())
  } else if cp <= 2047 {
    sb.write_byte((192 | (cp >> 6)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else if cp <= 65535 {
    sb.write_byte((224 | (cp >> 12)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else {
    sb.write_byte((240 | (cp >> 18)).to_byte())
    sb.write_byte((128 | ((cp >> 12) & 63)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  }
}

///| Strictly decode an RFC 8259 JSON double-quoted string literal (`\"`, `\\`, `\/`, `\b`, `\f`,
///| `\n`, `\r`, `\t`, and `\uHHHH` with UTF-16 surrogate-pair assembly). Fail-closed on any
///| non-JSON escape (`\'`, `\xHH`, `\u{...}`, etc.), truncated escape, unpaired surrogate,
///| or unescaped control character (< 0x20).
pub fn decode_mbt_string_lit(raw : String) -> Result[String, String] {
  let n = raw.length()
  if n < 2 || raw.code_unit_at(0) != 34 || raw.code_unit_at(n - 1) != 34 {
    return Err("unterminated string literal")
  }
  let sb = StringBuilder()
  let end = n - 1
  let mut i = 1
  while i < end {
    let b = raw.code_unit_at(i)
    if b < 32 {
      return Err("unescaped control character in string literal")
    }
    if b != 92 {
      sb.write_byte(b.to_byte())
      i = i + 1
      continue
    }
    i = i + 1
    if i >= end {
      return Err("truncated escape sequence in string literal")
    }
    let esc = raw.code_unit_at(i)
    if esc == 34 {
      sb.write_byte(34.to_byte())
      i = i + 1
    } else if esc == 92 {
      sb.write_byte(92.to_byte())
      i = i + 1
    } else if esc == 47 {
      sb.write_byte(47.to_byte())
      i = i + 1
    } else if esc == 110 {
      sb.write_byte(10.to_byte())
      i = i + 1
    } else if esc == 114 {
      sb.write_byte(13.to_byte())
      i = i + 1
    } else if esc == 116 {
      sb.write_byte(9.to_byte())
      i = i + 1
    } else if esc == 98 {
      sb.write_byte(8.to_byte())
      i = i + 1
    } else if esc == 102 {
      sb.write_byte(12.to_byte())
      i = i + 1
    } else if esc == 117 {
      if i + 4 >= end {
        return Err("truncated \\uHHHH escape in string literal")
      }
      let d1 = hex_digit_val(raw.code_unit_at(i + 1))
      let d2 = hex_digit_val(raw.code_unit_at(i + 2))
      let d3 = hex_digit_val(raw.code_unit_at(i + 3))
      let d4 = hex_digit_val(raw.code_unit_at(i + 4))
      if d1 < 0 || d2 < 0 || d3 < 0 || d4 < 0 {
        return Err("invalid hex digit in \\uHHHH escape")
      }
      let cp = (d1 << 12) | (d2 << 8) | (d3 << 4) | d4
      if cp >= 56320 && cp <= 57343 {
        return Err("unpaired UTF-16 surrogate escape")
      }
      if cp >= 55296 && cp <= 56319 {
        if i + 10 >= end || raw.code_unit_at(i + 5) != 92 || raw.code_unit_at(i + 6) != 117 {
          return Err("unpaired UTF-16 surrogate escape")
        }
        let l1 = hex_digit_val(raw.code_unit_at(i + 7))
        let l2 = hex_digit_val(raw.code_unit_at(i + 8))
        let l3 = hex_digit_val(raw.code_unit_at(i + 9))
        let l4 = hex_digit_val(raw.code_unit_at(i + 10))
        if l1 < 0 || l2 < 0 || l3 < 0 || l4 < 0 {
          return Err("invalid hex digit in low surrogate \\uHHHH escape")
        }
        let lo = (l1 << 12) | (l2 << 8) | (l3 << 4) | l4
        if lo < 56320 || lo > 57343 {
          return Err("unpaired UTF-16 surrogate escape")
        }
        let full_cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
        sb_write_utf8_cp(sb, full_cp)
        i = i + 11
      } else {
        sb_write_utf8_cp(sb, cp)
        i = i + 5
      }
    } else {
      return Err("unrecognized escape sequence in string literal")
    }
  }
  Ok(sb.to_string())
}

///| Canonical single MoonBit source backend selected for a Pion target:
///|   - `native` -> `"native"`
///|   - `wasm32` -> `"wasm-gc"`
///| Shared by BOTH `#cfg(target=...)` declaration evaluation and `moon.pkg` file-target rules.
pub fn moon_source_backend_for_target(pion_target : String) -> String {
  if pion_target == "native" {
    "native"
  } else if pion_target == "wasm32" {
    "wasm-gc"
  } else {
    pion_target
  }
}

///| Statically evaluate a `#cfg(...)` inner boolean expression for `pion_target` (#12a P1-1).
///| Supports `target="native"|"wasm"|"wasm-gc"|"js"|"llvm"`, `any(...)`, `all(...)`, `not(...)`.
///| Returns `None` on any unknown/complex predicate (must fail-loud with `MBT2PION_UNSUPPORTED_CFG`!).
fn eval_cfg_expr(raw : String, pion_target : String) -> Option[Bool] {
  let s = raw.trim()
  if s.length() == 0 {
    return None
  }
  if s.starts_with("not(") && s.ends_with(")") {
    match eval_cfg_expr(s.slice(4, s.length() - 1), pion_target) {
      Some(b) => return Some(!b)
      None => return None
    }
  }
  if s.starts_with("any(") && s.ends_with(")") {
    let parts = split_cfg_args(s.slice(4, s.length() - 1))
    if parts.length() == 0 {
      return None
    }
    let mut any_true = false
    for p in parts {
      match eval_cfg_expr(p, pion_target) {
        Some(b) => if b { any_true = true }
        None => return None
      }
    }
    return Some(any_true)
  }
  if s.starts_with("all(") && s.ends_with(")") {
    let parts = split_cfg_args(s.slice(4, s.length() - 1))
    if parts.length() == 0 {
      return None
    }
    let mut all_true = true
    for p in parts {
      match eval_cfg_expr(p, pion_target) {
        Some(b) => if !b { all_true = false }
        None => return None
      }
    }
    return Some(all_true)
  }
  let eq_i = s.index_of("=")
  if eq_i > 0 {
    let lhs = s.slice(0, eq_i).trim()
    let rhs = s.slice(eq_i + 1, s.length()).trim()
    if lhs == "target" && rhs.length() >= 2 && rhs.starts_with("\"") && rhs.ends_with("\"") {
      let tv = rhs.slice(1, rhs.length() - 1)
      if tv == "native" || tv == "wasm" || tv == "wasm-gc" || tv == "js" || tv == "llvm" {
        return Some(tv == moon_source_backend_for_target(pion_target))
      }
    }
  }
  None
}

///| Lower a type token range while scanning for unsupported MoonBit error tokens (`raise`/`noraise`).
fn lower_type_tokens_checked(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  check_unsupported_error_tokens(ctx, tokens, start, end, file)
  lower_type_tokens(tokens, start, end, ctx.symtab, ctx.recipes)
}

///| Statically evaluate a `#cfg(...)` attribute against `pion_target`.
pub fn eval_cfg_attr(raw_attr : String, pion_target : String) -> Option[Bool] {
  let s = raw_attr.trim()
  if !s.starts_with("#cfg(") || !s.ends_with(")") {
    return None
  }
  eval_cfg_expr(s.slice(5, s.length() - 1), pion_target)
}

///| Return true if token `k` starts a new top-level declaration.
fn is_top_level_decl_start(tokens : Array[Token], k : Int) -> Bool {
  let tk = tokens[k]
  if tk.kind == TokenKind::Attr {
    return true
  }
  if tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident {
    let r = tk.raw
    return r == "pub" || r == "priv" || r == "fn" || r == "struct" || r == "enum" ||
    r == "let" || r == "const" || r == "type" || r == "trait" || r == "impl" ||
    r == "test" || r == "extern" || r == "async" || r == "typealias" || r == "fnalias" ||
    r == "suberror" || r == "using"
  }
  false
}

///| Skip one complete top-level declaration starting at `start_i` (after leading `#` attributes).
fn skip_top_level_decl(tokens : Array[Token], start_i : Int, n : Int) -> Int {
  let mut i = start_i
  if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::LParen {
      i = find_matching_delim(tokens, i) + 1
    }
  } else if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "async" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "extern" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::StringLit {
      i = i + 1
    }
  }
  if i >= n {
    return n
  }
  let kw = tokens[i]
  let is_kw = kw.kind == TokenKind::Keyword || kw.kind == TokenKind::Ident
  if is_kw && (kw.raw == "let" || kw.raw == "const") {
    let mut eq_i = i + 1
    let mut depth = 0
    while eq_i < n {
      let ek = tokens[eq_i].kind
      if depth == 0 && tokens[eq_i].newline_before && is_top_level_decl_start(tokens, eq_i) {
        return eq_i
      }
      if depth == 0 && ek == TokenKind::Eq {
        return find_expr_end(tokens, eq_i + 1, n)
      }
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
        depth = depth + 1
      } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      }
      eq_i = eq_i + 1
    }
    return eq_i
  }
  if is_kw && (kw.raw == "struct" || kw.raw == "enum" || kw.raw == "suberror") {
    let mut k = i + 1
    if k < n && (tokens[k].kind == TokenKind::UpperIdent || tokens[k].kind == TokenKind::Ident) {
      k = k + 1
    }
    if k < n && tokens[k].kind == TokenKind::LBracket {
      k = find_matching_delim(tokens, k) + 1
    }
    if k < n && tokens[k].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k) + 1
    } else if k < n && tokens[k].kind == TokenKind::LBrace {
      k = find_matching_delim(tokens, k) + 1
    }
    if k < n && (tokens[k].kind == TokenKind::Keyword || tokens[k].kind == TokenKind::Ident) &&
    tokens[k].raw == "derive" && k + 1 < n && tokens[k + 1].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k + 1) + 1
    }
    return k
  }
  if is_kw && (kw.raw == "fn" || kw.raw == "impl" || kw.raw == "test" || kw.raw == "trait") {
    let mut k = i + 1
    let mut depth = 0
    while k < n {
      let kk = tokens[k].kind
      if depth == 0 && tokens[k].newline_before && is_top_level_decl_start(tokens, k) {
        return k
      }
      if depth == 0 && kk == TokenKind::LBrace {
        return find_matching_delim(tokens, k) + 1
      }
      if depth == 0 && kk == TokenKind::Eq {
        let mut e = find_expr_end(tokens, k + 1, n)
        while e < n && tokens[e].kind == TokenKind::StringLit && !tokens[e].newline_before {
          e = e + 1
        }
        return e
      }
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        depth = depth + 1
      } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      }
      k = k + 1
    }
    return k
  }
  if is_kw && kw.raw == "using" {
    let mut k = i + 1
    while k < n && tokens[k].kind != TokenKind::LBrace {
      if tokens[k].newline_before && is_top_level_decl_start(tokens, k) {
        return k
      }
      k = k + 1
    }
    if k < n && tokens[k].kind == TokenKind::LBrace {
      return find_matching_delim(tokens, k) + 1
    }
    return k
  }
  if is_kw && (kw.raw == "type" || kw.raw == "typealias" || kw.raw == "fnalias") {
    let mut k = i + 1
    while k < n {
      let kk = tokens[k].kind
      if tokens[k].newline_before {
        let r = tokens[k].raw
        if is_top_level_decl_start(tokens, k) || (r != "=" && r != "->" && r != "|" && r != "/") {
          break
        }
      }
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        k = find_matching_delim(tokens, k) + 1
        continue
      }
      k = k + 1
    }
    if k < n && (tokens[k].kind == TokenKind::Keyword || tokens[k].kind == TokenKind::Ident) &&
    tokens[k].raw == "derive" && k + 1 < n && tokens[k + 1].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k + 1) + 1
    }
    return k
  }
  i + 1
}

///| Extract a concise declaration label (`fn:foo`, `struct:Bar`, etc.) starting at `start_i` (after `#` attrs).
fn peek_decl_label(tokens : Array[Token], start_i : Int, n : Int) -> String {
  let mut i = start_i
  if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::LParen {
      i = find_matching_delim(tokens, i) + 1
    }
  } else if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "async" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "extern" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::StringLit {
      i = i + 1
    }
  }
  if i >= n {
    return "<decl>"
  }
  let kw = tokens[i].raw
  let mut ni = i + 1
  if ni < n && tokens[ni].kind == TokenKind::LBracket {
    ni = find_matching_delim(tokens, ni) + 1
  }
  if ni < n && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
    ni = ni + 1
  }
  if ni < n {
    kw + ":" + tokens[ni].raw
  } else {
    kw
  }
}

///| Stateless check whether a top-level declaration keyword at `kw_idx` is immediately
///| preceded by a `pub` / `pub(...)` visibility modifier (never leaks across declarations).
fn is_decl_pub(tokens : Array[Token], kw_idx : Int) -> Bool {
  let mut j = kw_idx - 1
  while j >= 0 {
    let tk = tokens[j]
    if tk.kind == TokenKind::Keyword && tk.raw == "pub" {
      return true
    }
    if tk.kind == TokenKind::Keyword && (tk.raw == "async" || tk.raw == "extern") {
      j = j - 1
      continue
    }
    if tk.kind == TokenKind::StringLit && j > 0 && tokens[j - 1].kind == TokenKind::Keyword && tokens[j - 1].raw == "extern" {
      j = j - 2
      continue
    }
    if tk.kind == TokenKind::RParen {
      let mut d = 1
      let mut p = j - 1
      while p >= 0 && d > 0 {
        if tokens[p].kind == TokenKind::RParen { d = d + 1 }
        else if tokens[p].kind == TokenKind::LParen { d = d - 1 }
        p = p - 1
      }
      if p >= 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "pub" {
        return true
      }
      return false
    }
    return false
  }
  false
}

///| Extract exact original MoonBit `(line, col)` coordinates for every Stage A.5 probe candidate
///| in `[start, end)` (recursing into `InterpString`/`InterpMultiline` `\{...}` holes) in exact
///| left-to-right token order, grouped by probe kind: `kind=l1:c1,l2:c2;...`.
fn collect_init_probe_origins_into(
  tokens : Array[Token],
  start : Int,
  end : Int,
  line_base : Int,
  col_base : Int,
  by_kind : Map[String, Array[String]],
) -> Unit {
  let lim = if end < tokens.length() { end } else { tokens.length() }
  let push_coord = fn(kind : String, ln : Int, cl : Int) -> Unit {
    let real_ln = if line_base > 0 { line_base + ln - 1 } else { ln }
    let real_cl = if line_base > 0 && ln == 1 { col_base + cl - 1 } else { cl }
    let pair = real_ln.to_string() + ":" + real_cl.to_string()
    match by_kind.get(kind) {
      Some(xs) => xs.push(pair)
      None => by_kind[kind] = [pair]
    }
  }
  let mut i = start
  while i < lim {
    let t = tokens[i]
    if t.kind == TokenKind::Dot && i + 1 < lim {
      if i + 3 < lim && tokens[i + 1].raw == "length" && tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::RParen {
        push_coord("mbt_len_probe", tokens[i + 1].line, tokens[i + 1].col)
        i = i + 4
        continue
      }
      if i + 3 < lim && tokens[i + 1].raw == "code_unit_at" && tokens[i + 2].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 2)
        if cp > i + 3 && cp < lim {
          let mut arg_count = 0
          let mut has_empty_mid = false
          let mut seg_s = i + 3
          let mut d = 0
          let mut k = i + 3
          while k <= cp {
            if k == cp || (d == 0 && tokens[k].kind == TokenKind::Comma) {
              if k > seg_s {
                arg_count = arg_count + 1
              } else if k < cp {
                has_empty_mid = true
              }
              seg_s = k + 1
            } else {
              let kk = tokens[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
            }
            k = k + 1
          }
          if !has_empty_mid && arg_count == 1 {
            push_coord("mbt_code_unit_at_probe", tokens[i + 1].line, tokens[i + 1].col)
            i = i + 3
            continue
          }
        }
      }
      if i + 3 < lim && tokens[i + 1].raw == "to_string" && tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::RParen {
        push_coord("mbt_show_probe", tokens[i + 1].line, tokens[i + 1].col)
        i = i + 4
        continue
      }
      if tokens[i + 1].raw == "val" {
        let is_set = i + 2 < lim && (tokens[i + 2].kind == TokenKind::Eq || tokens[i + 2].kind == TokenKind::AssignOp)
        push_coord(if is_set { "mbt_val_set_probe" } else { "mbt_val_probe" }, tokens[i + 1].line, tokens[i + 1].col)
        i = i + 2
        continue
      }
    } else if t.kind == TokenKind::LBracket && i > start && !t.newline_before {
      let pk = tokens[i - 1].kind
      if pk == TokenKind::Ident || pk == TokenKind::RParen || pk == TokenKind::RBracket ||
      pk == TokenKind::StringLit || pk == TokenKind::InterpString ||
      pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline || pk == TokenKind::RBrace {
        let cb = find_matching_delim(tokens, i)
        if cb < lim {
          let mut has_colon = false
          let mut d = 0
          let mut k = i + 1
          while k < cb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
            else if d == 0 && kk == TokenKind::Colon { has_colon = true; break }
            k = k + 1
          }
          if has_colon {
            let is_owned = cb + 4 < lim && tokens[cb + 1].kind == TokenKind::Dot && tokens[cb + 2].raw == "to_owned" &&
            tokens[cb + 3].kind == TokenKind::LParen && tokens[cb + 4].kind == TokenKind::RParen
            push_coord(if is_owned { "mbt_slice_owned_probe" } else { "mbt_slice_borrow_probe" }, t.line, t.col)
          } else {
            push_coord("mbt_idx_probe", t.line, t.col)
          }
        }
      }
    } else if t.kind == TokenKind::Slash {
      push_coord("mbt_div_probe", t.line, t.col)
    } else if t.kind == TokenKind::Percent {
      push_coord("mbt_mod_probe", t.line, t.col)
    } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let raw = t.raw
      let rlen = raw.length()
      let mut p = 0
      let mut cur_ln = t.line
      let mut cur_cl = t.col
      while p < rlen {
        let ch = raw.code_unit_at(p)
        if ch == 92 && p + 1 < rlen && raw.code_unit_at(p + 1) != 123 {
          if raw.code_unit_at(p + 1) == 10 {
            cur_ln = cur_ln + 1
            cur_cl = 1
          } else {
            cur_cl = cur_cl + 2
          }
          p = p + 2
          continue
        }
        if ch == 92 && p + 1 < rlen && raw.code_unit_at(p + 1) == 123 {
          let h_start = p + 2
          cur_cl = cur_cl + 2
          let h_ln = cur_ln
          let h_cl = cur_cl
          let mut hd = 1
          let mut in_str = false
          let mut hp = h_start
          let mut h_end = rlen
          while hp < rlen {
            let hc = raw.code_unit_at(hp)
            if in_str {
              if hc == 92 && hp + 1 < rlen {
                if raw.code_unit_at(hp + 1) == 10 {
                  cur_ln = cur_ln + 1
                  cur_cl = 1
                } else {
                  cur_cl = cur_cl + 2
                }
                hp = hp + 2
                continue
              }
              if hc == 34 {
                in_str = false
              }
            } else {
              if hc == 34 {
                in_str = true
              } else if hc == 123 {
                hd = hd + 1
              } else if hc == 125 {
                hd = hd - 1
                if hd == 0 { h_end = hp; break }
              }
            }
            if hc == 10 { cur_ln = cur_ln + 1; cur_cl = 1 } else { cur_cl = cur_cl + 1 }
            hp = hp + 1
          }
          if h_end > h_start {
            let hole_raw = raw.slice(h_start, h_end)
            let et = hole_raw.trim()
            let h_toks = lex_moonbit(hole_raw)
            if et.length() > 0 && is_alpha(et.code_unit_at(0)) && !str_has(et, "(") && !str_has(et, " ") && !str_has(et, "::") && h_toks.length() >= 2 {
              let id_tok = h_toks[0]
              let show_ln = h_ln + id_tok.line - 1
              let show_cl = if id_tok.line == 1 { h_cl + id_tok.col - 1 } else { id_tok.col }
              push_coord("mbt_show_probe", show_ln, show_cl)
            }
            collect_init_probe_origins_into(h_toks, 0, h_toks.length() - 1, h_ln, h_cl, by_kind)
          }
          p = if h_end < rlen { h_end + 1 } else { rlen }
          cur_cl = cur_cl + 1
          continue
        }
        if ch == 10 { cur_ln = cur_ln + 1; cur_cl = 1 } else { cur_cl = cur_cl + 1 }
        p = p + 1
      }
    }
    i = i + 1
  }
}

fn collect_init_probe_origins(tokens : Array[Token], start : Int, end : Int) -> String {
  let by_kind : Map[String, Array[String]] = Map()
  collect_init_probe_origins_into(tokens, start, end, 0, 0, by_kind)
  let keys = sorted_map_keys(by_kind)
  if keys.length() == 0 {
    return ""
  }
  let parts : Array[String] = []
  for k in keys {
    match by_kind.get(k) {
      Some(coords) => {
        let sb = StringBuilder()
        sb.write_string(k + "=")
        let mut ci = 0
        while ci < coords.length() {
          if ci > 0 { sb.write_string(",") }
          sb.write_string(coords[ci])
          ci = ci + 1
        }
        parts.push(sb.to_string())
      }
      None => ()
    }
  }
  let out = StringBuilder()
  let mut pi = 0
  while pi < parts.length() {
    if pi > 0 { out.write_string(";") }
    out.write_string(parts[pi])
    pi = pi + 1
  }
  out.to_string()
}

///| Pre-scan all source files to register intra-package enums, `#callsite(autofill(loc))`,
///| and migrated functions with optional defaults into `ctx.symtab`.
///| Skips declarations excluded by `#cfg(...)` for `ctx.opts.target` (#12a P1-1).
pub fn prescan_package_symbols(ctx : StageAContext, files : Array[SourceFile]) -> Unit {
  let prod_all_decls : Map[String, Bool] = Map()
  let bb_priv_decls : Array[String] = []
  let bb_all_idents : Map[String, Bool] = Map()
  let method_seen_count : Map[String, Int] = Map()
  // Pre-pass 0: collect all local_types, raw_type_aliases, and using_types across all files
  // (respecting #cfg exclusions) before the main prescan loop so struct_field_types,
  // exported_abi_enums, fn_param_types, fn_ret_types, and recursive #derive(Eq) detection all
  // observe the same converged, single-lowered `ctx.symtab.type_aliases`.
  let raw_type_aliases : Map[String, String] = Map()
  let pending_using_types : Array[(String, String)] = []
  for sf in files {
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut pi = 0
    let mut p_cfg_excluded = false
    while pi < n {
      let pt = tokens[pi]
      if pt.kind == TokenKind::Attr {
        if pt.raw.starts_with("#cfg") {
          match eval_cfg_attr(pt.raw, ctx.opts.target) {
            Some(false) => p_cfg_excluded = true
            None => p_cfg_excluded = true
            Some(true) => ()
          }
        }
        pi = pi + 1
        continue
      }
      if p_cfg_excluded {
        p_cfg_excluded = false
        pi = skip_top_level_decl(tokens, pi, n)
        continue
      }
      if pt.kind == TokenKind::Keyword &&
      (pt.raw == "struct" || pt.raw == "enum" || pt.raw == "type" || pt.raw == "suberror" || pt.raw == "trait") &&
      pi + 1 < n && tokens[pi + 1].kind == TokenKind::UpperIdent {
        ctx.symtab.local_types[tokens[pi + 1].raw] = true
      }
      if pt.kind == TokenKind::Keyword && pt.raw == "type" && pi + 3 < n &&
      tokens[pi + 1].kind == TokenKind::UpperIdent && tokens[pi + 2].kind == TokenKind::Eq {
        let aname = tokens[pi + 1].raw
        let rhs_end = find_top_level_let_expr_end(tokens, pi + 3, n)
        if rhs_end > pi + 3 {
          let raw_rhs = sf.content.slice(tokens[pi + 3].start_byte, tokens[rhs_end - 1].end_byte).trim()
          if raw_rhs.length() > 0 {
            raw_type_aliases[aname] = raw_rhs
          }
        }
        pi = rhs_end
        continue
      }
      if (pt.kind == TokenKind::Keyword || pt.kind == TokenKind::Ident) && pt.raw == "using" &&
      pi + 2 < n && tokens[pi + 1].kind == TokenKind::PkgRef && tokens[pi + 2].kind == TokenKind::LBrace {
        let raw_pkg = tokens[pi + 1].raw.slice(1, tokens[pi + 1].raw.length())
        let target_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
          Some(p) => p
          None => raw_pkg
        }
        let rb = find_matching_delim(tokens, pi + 2)
        let mut uk = pi + 3
        while uk < rb {
          let ut = tokens[uk]
          if ut.kind == TokenKind::Comma || ut.kind == TokenKind::Semi {
            uk = uk + 1
            continue
          }
          if (ut.kind == TokenKind::Keyword || ut.kind == TokenKind::Ident) &&
          (ut.raw == "type" || ut.raw == "trait") && uk + 1 < rb &&
          (tokens[uk + 1].kind == TokenKind::UpperIdent || tokens[uk + 1].kind == TokenKind::Ident) {
            let tname = tokens[uk + 1].raw
            pending_using_types.push((tname, target_pkg + "::" + tname))
            uk = uk + 2
            continue
          }
          uk = uk + 1
        }
        pi = rb + 1
        continue
      }
      if pt.kind == TokenKind::LBrace {
        pi = find_matching_delim(tokens, pi) + 1
        continue
      }
      pi = pi + 1
    }
  }
  for ut in pending_using_types {
    if !ctx.symtab.local_types.contains(ut.0) {
      ctx.symtab.using_types[ut.0] = ut.1
    }
  }
  // Step A: fixed-point expand type alias chains on raw MoonBit source text (bounded to 16 iterations)
  // so MoonBit types (e.g. `ReadOnlyArray[Int]`) are never prematurely lowered and re-aliased.
  let mut ta_iter = 0
  while ta_iter < 16 {
    let mut ta_changed = false
    for aname in raw_type_aliases.keys() {
      match raw_type_aliases.get(aname) {
        Some(cur_raw) => {
          let rtoks = lex_moonbit(cur_raw)
          let rn = rtoks.length() - 1
          let sb = StringBuilder()
          let mut pos = 0
          let mut did_sub = false
          let mut k = 0
          while k < rn {
            let tk = rtoks[k]
            if tk.kind == TokenKind::UpperIdent &&
            !(k > 0 && rtoks[k - 1].kind == TokenKind::Dot) &&
            tk.raw != aname &&
            !(k + 1 < rn && rtoks[k + 1].kind == TokenKind::LBracket) {
              match raw_type_aliases.get(tk.raw) {
                Some(aliased) => {
                  sb.write_string(cur_raw.slice(pos, tk.start_byte))
                  let needs_parens = k + 1 < rn && rtoks[k + 1].kind == TokenKind::Question && eq_is_fn_type(aliased)
                  if needs_parens {
                    sb.write_string("(" + aliased + ")")
                  } else {
                    sb.write_string(aliased)
                  }
                  pos = tk.end_byte
                  did_sub = true
                }
                None => ()
              }
            }
            k = k + 1
          }
          if did_sub {
            sb.write_string(cur_raw.slice(pos, cur_raw.length()))
            let next_raw = sb.to_string().trim()
            if next_raw != cur_raw && next_raw.length() > 0 {
              raw_type_aliases[aname] = next_raw
              ta_changed = true
            }
          }
        }
        None => ()
      }
    }
    if !ta_changed {
      break
    }
    ta_iter = ta_iter + 1
  }
  let mut has_unresolved_alias = false
  for aname in raw_type_aliases.keys() {
    match raw_type_aliases.get(aname) {
      Some(cur_raw) => {
        let rtoks = lex_moonbit(cur_raw)
        let rn = rtoks.length() - 1
        let mut k = 0
        while k < rn {
          let tk = rtoks[k]
          if tk.kind == TokenKind::UpperIdent &&
          !(k > 0 && (rtoks[k - 1].kind == TokenKind::Dot || rtoks[k - 1].kind == TokenKind::ColonColon)) &&
          !(k + 1 < rn && rtoks[k + 1].kind == TokenKind::LBracket) &&
          (tk.raw == aname || (ta_iter == 16 && raw_type_aliases.contains(tk.raw))) {
            has_unresolved_alias = true
            break
          }
          k = k + 1
        }
      }
      None => ()
    }
    if has_unresolved_alias {
      break
    }
  }
  if has_unresolved_alias {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      "<type-alias>",
      1,
      1,
      "type alias expansion did not converge within 16 rounds or contains a cyclic alias",
    ))
  }
  // Step B: lower each fully expanded MoonBit alias RHS exactly once with an empty `type_aliases` map.
  for old_k in ctx.symtab.type_aliases.keys() {
    ctx.symtab.type_aliases.remove(old_k)
  }
  let lowered_aliases : Map[String, String] = Map()
  for aname in raw_type_aliases.keys() {
    match raw_type_aliases.get(aname) {
      Some(exp_raw) => {
        let rtoks = lex_moonbit(exp_raw)
        let rty = lower_type_tokens(rtoks, 0, rtoks.length() - 1, ctx.symtab, ctx.recipes).trim()
        if rty.length() > 0 {
          lowered_aliases[aname] = rty
        }
      }
      None => ()
    }
  }
  for aname in lowered_aliases.keys() {
    match lowered_aliases.get(aname) {
      Some(rty) => ctx.symtab.type_aliases[aname] = rty
      None => ()
    }
  }
  for sf in files {
    ctx.all_source_texts.push(sf.content)
    let is_blackbox = sf.rel_path.ends_with("_test.mbt") && !sf.rel_path.ends_with("_wbtest.mbt")
    let bb_decls : Map[String, Bool] = if is_blackbox { ctx.symtab.blackbox_decls } else { Map() }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    // P0-1(a): Pre-populate `ctx.used_idents` across ALL package files before lowering any file
    // so fresh temps and `.val` placeholders can NEVER collide with any user identifier in any file.
    let mut ui = 0
    while ui < n {
      let ut = tokens[ui]
      if ut.kind == TokenKind::Ident || ut.kind == TokenKind::UpperIdent {
        ctx.used_idents[ut.raw] = true
        if is_blackbox {
          bb_all_idents[ut.raw] = true
        }
      }
      ui = ui + 1
    }
    let mut i = 0
    let mut next_autofill = false
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::Attr {
        if t.raw.starts_with("#callsite") && str_has(t.raw, "autofill(loc)") {
          next_autofill = true
        } else if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, ctx.opts.target) {
            Some(false) => {
              next_cfg_excluded = true
              next_autofill = false
            }
            None => {
              next_cfg_excluded = true
              next_autofill = false
            }
            Some(true) => ()
          }
        }
        i = i + 1
        continue
      }
      if next_autofill {
        let keep_af = (t.kind == TokenKind::Keyword &&
          (t.raw == "pub" || t.raw == "priv" || t.raw == "fn" || t.raw == "async")) ||
        t.kind == TokenKind::LParen || t.kind == TokenKind::RParen ||
        (t.kind == TokenKind::Ident && (t.raw == "all" || t.raw == "open" || t.raw == "readonly"))
        if !keep_af {
          next_autofill = false
        }
      }
      if next_cfg_excluded {
        next_cfg_excluded = false
        next_autofill = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      // P0-4: Record all locally defined types (`struct`, `enum`, `type`, `suberror`, `trait`) so stdlib rewrites
      // (`Json` -> `mbt_compat::MbtJson`, `Hash::hash` -> `mbt_compat::mbt_hash`) NEVER hijack local types!
      if t.kind == TokenKind::Keyword &&
      (t.raw == "struct" || t.raw == "enum" || t.raw == "type" || t.raw == "suberror" || t.raw == "trait") &&
      i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        ctx.symtab.local_types[tokens[i + 1].raw] = true
      }
      if t.kind == TokenKind::Keyword && t.raw == "struct" && i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        next_autofill = false
        let sname = tokens[i + 1].raw
        let mut lb = i + 2
        let mut struct_added_g : Array[String] = []
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, lb)
          let gparams = collect_generic_param_names(tokens, lb, close_gb)
          ctx.struct_type_params[sname] = gparams
          struct_added_g = push_active_generics(ctx, gparams)
          lb = close_gb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let raw_fields : Array[String] = []
          let existing_set : Map[String, Bool] = Map()
          let mut fi = lb + 1
          while fi < rb {
            if tokens[fi].kind == TokenKind::Semi || tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            if tokens[fi].kind == TokenKind::Keyword && (tokens[fi].raw == "pub" || tokens[fi].raw == "priv") {
              fi = fi + 1
            }
            if fi < rb && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
              fi = fi + 1
            }
            if fi >= rb { break }
            let raw_f = tokens[fi].raw
            raw_fields.push(raw_f)
            existing_set[raw_f] = true
            let mut fc = fi + 1
            while fc < rb && tokens[fc].kind != TokenKind::Colon {
              fc = fc + 1
            }
            let mut f_end = if fc < rb { fc + 1 } else { fi + 1 }
            let mut fd = 0
            while f_end < rb {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
                fd = fd + 1
              } else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
                fd = fd - 1
              } else if fd == 0 && (fk == TokenKind::Semi || fk == TokenKind::Comma || tokens[f_end].newline_before) {
                break
              }
              f_end = f_end + 1
            }
            if fc < rb && f_end > fc + 1 {
              let fty = lower_type_tokens(tokens, fc + 1, f_end, ctx.symtab, ctx.recipes).trim()
              let fmap = match ctx.symtab.struct_field_types.get(sname) {
                Some(m) => m
                None => {
                  let m : Map[String, String] = Map()
                  ctx.symtab.struct_field_types[sname] = m
                  m
                }
              }
              fmap[raw_f] = fty
            }
            fi = f_end
          }
          pop_active_generics(ctx, struct_added_g)
          let renames : Map[String, String] = Map()
          let used_names : Map[String, Bool] = Map()
          for rf in raw_fields {
            if !is_pion_reserved_ident(rf) {
              renames[rf] = rf
              used_names[rf] = true
            }
          }
          for rf in raw_fields {
            if is_pion_reserved_ident(rf) {
              let new_name = allocate_collision_free_field_name(rf, existing_set, used_names)
              renames[rf] = new_name
              used_names[new_name] = true
              if rf == "val" {
                ctx.struct_val_fields[sname] = new_name
                if is_decl_pub(tokens, i) {
                  ctx.exported_abi_struct_vals.push(AbiStructValRename::{
                    pkg: ctx.self_pkg_name,
                    struct_name: sname,
                    renamed_field: new_name,
                  })
                }
              }
            }
          }
          ctx.struct_field_renames[sname] = renames
          ctx.struct_field_order[sname] = raw_fields
          // Prescan non-primitive `#derive(Eq)` / trailing `derive(Eq)` and `#derive(Hash)` structs!
          let mut has_eq_derive = false
          let mut has_hash_derive = false
          if rb + 2 < n && (tokens[rb + 1].kind == TokenKind::Keyword || tokens[rb + 1].kind == TokenKind::Ident) &&
          tokens[rb + 1].raw == "derive" && tokens[rb + 2].kind == TokenKind::LParen {
            let dp = find_matching_delim(tokens, rb + 2)
            let mut di = rb + 3
            while di < dp {
              if tokens[di].raw == "Eq" { has_eq_derive = true }
              if tokens[di].raw == "Hash" { has_hash_derive = true }
              di = di + 1
            }
          }
          let mut back_i = i - 1
          while back_i >= 0 && (tokens[back_i].kind == TokenKind::Keyword || tokens[back_i].kind == TokenKind::LParen ||
            tokens[back_i].kind == TokenKind::RParen || tokens[back_i].kind == TokenKind::Ident || tokens[back_i].kind == TokenKind::Attr) {
            if tokens[back_i].kind == TokenKind::Attr && tokens[back_i].raw.starts_with("#derive") {
              if str_has(tokens[back_i].raw, "Eq") { has_eq_derive = true }
              if str_has(tokens[back_i].raw, "Hash") { has_hash_derive = true }
            }
            if tokens[back_i].kind == TokenKind::Keyword && !(tokens[back_i].raw == "pub" || tokens[back_i].raw == "priv") {
              break
            }
            back_i = back_i - 1
          }
          if has_hash_derive {
            ctx.symtab.hashable_types[sname] = true
          }
          let _ = has_eq_derive
          i = rb + 1
          continue
        } else if lb < n && tokens[lb].kind == TokenKind::LParen {
          // Tuple struct prescan: `struct Name[T](A, B, ...)`
          let rp = find_matching_delim(tokens, lb)
          let mut fi = lb + 1
          let mut fidx = 0
          let fmap = match ctx.symtab.struct_field_types.get(sname) {
            Some(m) => m
            None => {
              let m : Map[String, String] = Map()
              ctx.symtab.struct_field_types[sname] = m
              m
            }
          }
          while fi < rp {
            if tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            let mut ty_s = fi
            if ty_s < rp && tokens[ty_s].kind == TokenKind::Keyword && (tokens[ty_s].raw == "pub" || tokens[ty_s].raw == "priv") {
              ty_s = ty_s + 1
            }
            if ty_s < rp && tokens[ty_s].kind == TokenKind::Keyword && tokens[ty_s].raw == "mut" {
              ty_s = ty_s + 1
            }
            let mut f_end = ty_s
            let mut fd = 0
            while f_end < rp {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
              else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
              else if fd == 0 && fk == TokenKind::Comma { break }
              f_end = f_end + 1
            }
            if f_end > ty_s {
              let fty = lower_type_tokens(tokens, ty_s, f_end, ctx.symtab, ctx.recipes).trim()
              fmap["_" + fidx.to_string()] = fty
              fidx = fidx + 1
            }
            fi = f_end + 1
          }
          ctx.symtab.tuple_structs[sname] = fidx
          pop_active_generics(ctx, struct_added_g)
          i = rp + 1
          continue
        } else {
          pop_active_generics(ctx, struct_added_g)
        }
      }
      // Prescan types referenced in any `pub` declaration signature (for enum constructor visibility fail-closed check)
      if t.kind == TokenKind::Keyword && t.raw == "pub" {
        let mut pi = i + 1
        let mut is_pub_all = false
        if pi < n && tokens[pi].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, pi)
          if pi + 1 < cp && (tokens[pi + 1].raw == "all" || tokens[pi + 1].raw == "open") {
            is_pub_all = true
          }
          pi = cp + 1
        }
        if pi < n && tokens[pi].kind == TokenKind::Keyword && tokens[pi].raw == "fn" {
          // Collect generic type params (`pub fn[T] f(...)` or `pub fn f[T](...)`) so they never shadow local enum names
          let local_tparams : Map[String, Bool] = Map()
          let mut tp_scan = pi + 1
          if tp_scan < n && tokens[tp_scan].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, tp_scan)
            let mut k = tp_scan + 1
            let mut bd = 0
            while k < cb {
              let kk = tokens[k].kind
              if kk == TokenKind::LBracket || kk == TokenKind::LParen { bd = bd + 1 }
              else if kk == TokenKind::RBracket || kk == TokenKind::RParen { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && kk == TokenKind::UpperIdent && (k == tp_scan + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            tp_scan = cb + 1
          }
          // Advance past fn name (possibly `Type::method`) and check trailing `[T]`
          while tp_scan < n && tokens[tp_scan].kind != TokenKind::LParen && tokens[tp_scan].kind != TokenKind::LBracket &&
          tokens[tp_scan].kind != TokenKind::LBrace && tokens[tp_scan].kind != TokenKind::Eq {
            tp_scan = tp_scan + 1
          }
          if tp_scan < n && tokens[tp_scan].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, tp_scan)
            let mut k = tp_scan + 1
            let mut bd = 0
            while k < cb {
              let kk = tokens[k].kind
              if kk == TokenKind::LBracket || kk == TokenKind::LParen { bd = bd + 1 }
              else if kk == TokenKind::RBracket || kk == TokenKind::RParen { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && kk == TokenKind::UpperIdent && (k == tp_scan + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
          }
          // Scan params and return type up to `{` or `=`
          let mut si = pi + 1
          let mut sd = 0
          while si < n {
            let sk = tokens[si].kind
            if sd == 0 && (sk == TokenKind::LBrace || sk == TokenKind::Eq) { break }
            if sk == TokenKind::LParen || sk == TokenKind::LBracket { sd = sd + 1 }
            else if sk == TokenKind::RParen || sk == TokenKind::RBracket { if sd > 0 { sd = sd - 1 } }
            else if sk == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi < n && tokens[pi].kind == TokenKind::Keyword && (tokens[pi].raw == "let" || tokens[pi].raw == "const") {
          let mut si = pi + 1
          let mut seen_col = false
          while si < n && tokens[si].kind != TokenKind::Eq && tokens[si].kind != TokenKind::Semi {
            if si > pi + 1 && tokens[si].newline_before && is_top_level_decl_start(tokens, si) { break }
            if tokens[si].kind == TokenKind::Colon { seen_col = true }
            else if seen_col && tokens[si].kind == TokenKind::UpperIdent {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi + 1 < n && tokens[pi].kind == TokenKind::Keyword &&
        (tokens[pi].raw == "type" || tokens[pi].raw == "typealias") {
          let local_tparams : Map[String, Bool] = Map()
          let mut si = pi + 2
          if si < n && tokens[si].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, si)
            let mut k = si + 1
            while k < cb {
              if tokens[k].kind == TokenKind::UpperIdent && (k == si + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            si = cb + 1
          }
          let mut seen_eq = false
          while si < n && tokens[si].kind != TokenKind::Semi {
            if tokens[si].newline_before && is_top_level_decl_start(tokens, si) { break }
            if tokens[si].kind == TokenKind::Eq {
              seen_eq = true
            } else if seen_eq && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi + 1 < n && tokens[pi].kind == TokenKind::Keyword &&
        (tokens[pi].raw == "struct" || tokens[pi].raw == "enum") {
          let is_struct_decl = tokens[pi].raw == "struct"
          let local_tparams : Map[String, Bool] = Map()
          let mut lb = pi + 2
          if lb < n && tokens[lb].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, lb)
            let mut k = lb + 1
            while k < cb {
              if tokens[k].kind == TokenKind::UpperIdent && (k == lb + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            lb = cb + 1
          }
          if lb < n && (tokens[lb].kind == TokenKind::LBrace || tokens[lb].kind == TokenKind::LParen) {
            let rb = find_matching_delim(tokens, lb)
            if is_pub_all {
              let mut si = lb + 1
              while si < rb {
                if tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
                  let prev_c = si >= lb + 1 && (tokens[si - 1].kind == TokenKind::Colon || tokens[si - 1].kind == TokenKind::LParen ||
                    tokens[si - 1].kind == TokenKind::Comma || tokens[si - 1].kind == TokenKind::LBracket)
                  if prev_c { ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true }
                }
                si = si + 1
              }
            } else if is_struct_decl && tokens[lb].kind == TokenKind::LBrace {
              // Regular `pub struct`: scan fields explicitly marked `pub`
              let mut si = lb + 1
              let mut in_pub_field = false
              let mut seen_colon = false
              while si < rb {
                if tokens[si].newline_before || tokens[si].kind == TokenKind::Semi {
                  in_pub_field = false
                  seen_colon = false
                }
                if tokens[si].kind == TokenKind::Keyword && tokens[si].raw == "pub" {
                  in_pub_field = true
                  seen_colon = false
                } else if in_pub_field && tokens[si].kind == TokenKind::Colon {
                  seen_colon = true
                } else if in_pub_field && seen_colon && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
                  ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
                }
                si = si + 1
              }
            }
          }
        }
      }
      // Bare `struct` (default abstract-public in MoonBit) with explicitly `pub` fields
      if t.kind == TokenKind::Keyword && t.raw == "struct" && (i == 0 || (tokens[i - 1].raw != "pub" && tokens[i - 1].raw != "priv" && tokens[i - 1].kind != TokenKind::RParen)) {
        let local_tparams : Map[String, Bool] = Map()
        let mut lb = i + 2
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let cb = find_matching_delim(tokens, lb)
          let mut k = lb + 1
          while k < cb {
            if tokens[k].kind == TokenKind::UpperIdent && (k == lb + 1 || tokens[k - 1].kind == TokenKind::Comma) {
              local_tparams[tokens[k].raw] = true
            }
            k = k + 1
          }
          lb = cb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let mut si = lb + 1
          let mut in_pub_field = false
          let mut seen_colon = false
          while si < rb {
            if tokens[si].newline_before || tokens[si].kind == TokenKind::Semi {
              in_pub_field = false
              seen_colon = false
            }
            if tokens[si].kind == TokenKind::Keyword && tokens[si].raw == "pub" {
              in_pub_field = true
              seen_colon = false
            } else if in_pub_field && tokens[si].kind == TokenKind::Colon {
              seen_colon = true
            } else if in_pub_field && seen_colon && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "enum" && i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        next_autofill = false
        let ename = tokens[i + 1].raw
        let enum_is_pub = is_decl_pub(tokens, i)
        let mut enum_is_pub_all = false
        if i >= 4 && tokens[i - 1].kind == TokenKind::RParen && tokens[i - 3].kind == TokenKind::LParen &&
        tokens[i - 4].kind == TokenKind::Keyword && tokens[i - 4].raw == "pub" &&
        (tokens[i - 2].raw == "all" || tokens[i - 2].raw == "open") {
          enum_is_pub_all = true
        }
        let mut lb = i + 2
        let mut enum_added_g : Array[String] = []
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, lb)
          enum_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, lb, close_gb))
          lb = close_gb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let abi_variants : Array[AbiEnumVariant] = []
          let mut k = lb + 1
          let mut depth = 0
          while k < rb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBrace || kk == TokenKind::LBracket {
              depth = depth + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBrace || kk == TokenKind::RBracket {
              depth = depth - 1
            } else if depth == 0 && kk == TokenKind::UpperIdent {
              let prev_c = k > lb + 1 && (tokens[k - 1].kind == TokenKind::Colon || tokens[k - 1].kind == TokenKind::ColonColon)
              if !prev_c {
                let vname = tokens[k].raw
                let vfields : Array[AbiEnumField] = []
                if k + 1 < rb && tokens[k + 1].kind == TokenKind::LParen {
                  let vp = find_matching_delim(tokens, k + 1)
                  let mut vi = k + 2
                  while vi < vp {
                    if tokens[vi].kind == TokenKind::Comma {
                      vi = vi + 1
                      continue
                    }
                    let mut ve = vi
                    let mut vd = 0
                    while ve < vp {
                      let vk = tokens[ve].kind
                      if vk == TokenKind::LParen || vk == TokenKind::LBracket || vk == TokenKind::LBrace { vd = vd + 1 }
                      else if vk == TokenKind::RParen || vk == TokenKind::RBracket || vk == TokenKind::RBrace { vd = vd - 1 }
                      else if vd == 0 && vk == TokenKind::Comma { break }
                      ve = ve + 1
                    }
                    if ve > vi {
                      let mut f_lbl = ""
                      let mut ty_s = vi
                      if ty_s < ve && tokens[ty_s].kind == TokenKind::Keyword && tokens[ty_s].raw == "mut" {
                        ty_s = ty_s + 1
                      }
                      if ty_s + 1 < ve && (tokens[ty_s].kind == TokenKind::Ident || tokens[ty_s].kind == TokenKind::Keyword) {
                        if tokens[ty_s + 1].kind == TokenKind::Tilde && ty_s + 2 < ve && tokens[ty_s + 2].kind == TokenKind::Colon {
                          f_lbl = tokens[ty_s].raw
                          ty_s = ty_s + 3
                        } else if tokens[ty_s + 1].kind == TokenKind::Colon {
                          f_lbl = tokens[ty_s].raw
                          ty_s = ty_s + 2
                        }
                      }
                      let fty = lower_type_tokens(tokens, ty_s, ve, ctx.symtab, ctx.recipes).trim()
                      vfields.push(AbiEnumField::{ label: f_lbl, ty: fty })
                    }
                    vi = ve + 1
                  }
                }
                abi_variants.push(AbiEnumVariant::{ name: vname, fields: vfields })
              }
            }
            k = k + 1
          }
          let local_schema = AbiEnumSchema::{
            pkg: "",
            name: ename,
            can_match: true,
            can_construct: true,
            variants: abi_variants,
          }
          symtab_register_enum_schema(ctx.symtab, local_schema)
          if enum_added_g.length() > 0 {
            ctx.symtab.enum_type_params[ename] = enum_added_g
          }
          if enum_is_pub && !sf.is_test {
            ctx.exported_abi_enums.push(AbiEnumSchema::{
              pkg: ctx.self_pkg_name,
              name: ename,
              can_match: true,
              can_construct: enum_is_pub_all,
              variants: abi_variants,
            })
          }
          pop_active_generics(ctx, enum_added_g)
          i = rb + 1
          continue
        }
        pop_active_generics(ctx, enum_added_g)
      }
      if t.kind == TokenKind::Keyword && t.raw == "type" && i + 3 < n &&
      tokens[i + 1].kind == TokenKind::UpperIdent && tokens[i + 2].kind == TokenKind::Eq {
        next_autofill = false
        let rhs_end = find_top_level_let_expr_end(tokens, i + 3, n)
        i = rhs_end
        continue
      }
      if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "using" &&
      i + 2 < n && tokens[i + 1].kind == TokenKind::PkgRef && tokens[i + 2].kind == TokenKind::LBrace {
        next_autofill = false
        let raw_pkg = tokens[i + 1].raw.slice(1, tokens[i + 1].raw.length())
        let target_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
          Some(p) => p
          None => raw_pkg
        }
        let rb = find_matching_delim(tokens, i + 2)
        let mut uk = i + 3
        while uk < rb {
          let ut = tokens[uk]
          if ut.kind == TokenKind::Comma || ut.kind == TokenKind::Semi {
            uk = uk + 1
            continue
          }
          if (ut.kind == TokenKind::Keyword || ut.kind == TokenKind::Ident) &&
          (ut.raw == "type" || ut.raw == "trait") && uk + 1 < rb &&
          (tokens[uk + 1].kind == TokenKind::UpperIdent || tokens[uk + 1].kind == TokenKind::Ident) {
            let tname = tokens[uk + 1].raw
            let qual = target_pkg + "::" + tname
            if !ctx.symtab.local_types.contains(tname) {
              ctx.symtab.using_types[tname] = qual
            }
            uk = uk + 2
            continue
          }
          if ut.kind == TokenKind::Ident || ut.kind == TokenKind::UpperIdent {
            let vname = ut.raw
            ctx.symtab.using_values[vname] = target_pkg + "::" + vname
          }
          uk = uk + 1
        }
        i = rb + 1
        continue
      }
      if t.kind == TokenKind::Keyword && (t.raw == "const" || t.raw == "let") && i + 1 < n {
        let decl_pub = is_decl_pub(tokens, i)
        let is_const_decl = t.raw == "const"
        next_autofill = false
        let mut ni = i + 1
        if tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" && ni + 1 < n {
          ni = ni + 1
        }
        if ni < n && (tokens[ni].kind == TokenKind::Ident || tokens[ni].kind == TokenKind::UpperIdent) {
          let vname = tokens[ni].raw
          if is_blackbox {
            bb_decls[vname] = true
            if !decl_pub {
              bb_priv_decls.push(vname)
            }
          } else {
            ctx.symtab.local_value_names[vname] = true
            prod_all_decls[vname] = true
            if !sf.is_test && decl_pub {
              ctx.symtab.prod_pub_decls[vname] = true
            }
          }
          // Record top-level `let`/`const` static type for sound static `.val` resolution (P1-1)
          let mut const_eq_i = -1
          if ni + 2 < n && tokens[ni + 1].kind == TokenKind::Colon {
            let mut eq_i = ni + 2
            let mut td = 0
            while eq_i < n {
              let tk = tokens[eq_i].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
              else if td == 0 && tk == TokenKind::Eq { break }
              eq_i = eq_i + 1
            }
            if eq_i < n && tokens[eq_i].kind == TokenKind::Eq {
              const_eq_i = eq_i
              let vty = lower_type_tokens(tokens, ni + 2, eq_i, ctx.symtab, ctx.recipes).trim()
              if vty.length() > 0 {
                ctx.symtab.val_types[vname] = vty
              }
            }
          } else if ni + 2 < n && tokens[ni + 1].kind == TokenKind::Eq {
            const_eq_i = ni + 1
            let rhs_end = find_top_level_let_expr_end(tokens, ni + 2, n)
            let inf_ty = infer_simple_expr_type(ctx, tokens, ni + 2, rhs_end)
            if inf_ty.length() > 0 {
              ctx.symtab.val_types[vname] = inf_ty
            }
          }
          // §D2-4: Record compile-time literal status for `[pub] const` pattern inlining
          if is_const_decl && const_eq_i >= 0 && (!is_blackbox || !ctx.symtab.const_defs.contains(vname)) {
            let rhs_end = find_top_level_let_expr_end(tokens, const_eq_i + 1, n)
            match extract_const_literal_pion(tokens, const_eq_i + 1, rhs_end) {
              Some(lit_s) => ctx.symtab.const_defs[vname] = ConstDef::{ is_literal: true, literal_pion: lit_s }
              None => ctx.symtab.const_defs[vname] = ConstDef::{ is_literal: false, literal_pion: "" }
            }
          }
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "fn" && i + 1 < n {
        let decl_pub = is_decl_pub(tokens, i)
        let mut name_i = i + 1
        let mut fn_added_g : Array[String] = []
        if tokens[name_i].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, name_i)
          fn_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, name_i, close_gb))
          name_i = close_gb + 1
        }
        if name_i < n {
          let fn_tok = tokens[name_i]
          if fn_tok.kind == TokenKind::UpperIdent && name_i + 3 < n &&
          tokens[name_i + 1].kind == TokenKind::ColonColon &&
          tokens[name_i + 2].kind == TokenKind::Ident &&
          tokens[name_i + 3].kind == TokenKind::LParen {
            let mname = tokens[name_i + 2].raw
            let qual_fn = fn_tok.raw + "::" + mname
            if mname == "to_string" {
              ctx.symtab.inherent_to_string_types[fn_tok.raw] = true
            }
            ctx.local_method_names[mname] = true
            let cp = find_matching_delim(tokens, name_i + 3)
            let (pnames, ptys, _) = extract_param_info(ctx, tokens, name_i + 3, cp, sf.rel_path)
            let pts : Array[(String, String)] = []
            let mut pk = 0
            while pk < pnames.length() {
              let raw_pt = if pk < ptys.length() { ptys[pk] } else { "" }
              let clean_pt = if raw_pt.length() > 0 && ctx.active_generics.contains(strip_type_args_sym(raw_pt)) { "" } else { raw_pt }
              pts.push((pnames[pk], clean_pt))
              pk = pk + 1
            }
            if is_blackbox {
              ctx.symtab.blackbox_fn_param_types[qual_fn] = pts
            } else {
              ctx.symtab.local_fn_names[qual_fn] = true
              ctx.symtab.fn_param_types[qual_fn] = pts
              register_local_fn_meta_f3d2(ctx, qual_fn, tokens, name_i + 3, cp, pnames, ptys)
              let p_renames = compute_param_renames(extract_raw_param_names(tokens, name_i + 3, cp))
              if p_renames.length() > 0 {
                ctx.symtab.fn_param_renames[qual_fn] = p_renames
              }
              if next_autofill {
                ctx.symtab.autofill_loc_fns[qual_fn] = true
              }
              let prev_cnt = match method_seen_count.get(mname) {
                Some(c) => c
                None => 0
              }
              method_seen_count[mname] = prev_cnt + 1
              if prev_cnt == 0 {
                let no_self : Array[(String, String)] = []
                let mut sk = if pts.length() > 0 && pts[0].0 == "self" { 1 } else { 0 }
                while sk < pts.length() {
                  no_self.push(pts[sk])
                  sk = sk + 1
                }
                if no_self.length() > 0 {
                  ctx.symtab.method_unique_param_types[mname] = no_self
                }
                if p_renames.length() > 0 {
                  ctx.symtab.method_unique_param_renames[mname] = p_renames
                }
              } else {
                ctx.symtab.method_unique_param_types.remove(mname)
                ctx.symtab.method_unique_param_renames.remove(mname)
              }
              if cp + 1 < n && tokens[cp + 1].kind == TokenKind::Arrow {
                let mut re = cp + 2
                let mut rd = 0
                while re < n {
                  let rk = tokens[re].kind
                  if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq) { break }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
                  re = re + 1
                }
                let rty = lower_type_tokens(tokens, cp + 2, re, ctx.symtab, ctx.recipes).trim()
                if rty.length() > 0 {
                  ctx.symtab.fn_ret_types[qual_fn] = rty
                }
              }
            }
          } else if fn_tok.kind == TokenKind::Ident && fn_tok.raw != "init" {
            if is_blackbox {
              bb_decls[fn_tok.raw] = true
              if !decl_pub {
                bb_priv_decls.push(fn_tok.raw)
              }
              if next_autofill {
                ctx.symtab.blackbox_autofill_loc_fns[fn_tok.raw] = true
              }
            } else {
              ctx.symtab.local_fn_names[fn_tok.raw] = true
              prod_all_decls[fn_tok.raw] = true
              if !sf.is_test && decl_pub {
                ctx.symtab.prod_pub_decls[fn_tok.raw] = true
              }
              if next_autofill {
                ctx.symtab.autofill_loc_fns[fn_tok.raw] = true
              }
            }
            if name_i + 1 < n && tokens[name_i + 1].kind == TokenKind::LParen {
              let cp = find_matching_delim(tokens, name_i + 1)
              // Detect `raise` in function signature for raising-callback fail-closed gate (§5)
              let mut rscan = cp + 1
              let mut rsd = 0
              while rscan < n {
                let rsk = tokens[rscan].kind
                if rsd == 0 && (rsk == TokenKind::LBrace || rsk == TokenKind::Eq) { break }
                if rsk == TokenKind::LParen || rsk == TokenKind::LBracket || rsk == TokenKind::LBrace { rsd = rsd + 1 }
                else if rsk == TokenKind::RParen || rsk == TokenKind::RBracket || rsk == TokenKind::RBrace { if rsd > 0 { rsd = rsd - 1 } }
                else if rsd == 0 && (rsk == TokenKind::Keyword || rsk == TokenKind::Ident) && tokens[rscan].raw == "raise" {
                  ctx.symtab.local_raising_fns[fn_tok.raw] = true
                  break
                }
                rscan = rscan + 1
              }
              let (pnames, ptys, _) = extract_param_info(ctx, tokens, name_i + 1, cp, sf.rel_path)
              let pts : Array[(String, String)] = []
              let mut pk = 0
              while pk < pnames.length() {
                let raw_pt = if pk < ptys.length() { ptys[pk] } else { "" }
                let clean_pt = if raw_pt.length() > 0 && ctx.active_generics.contains(strip_type_args_sym(raw_pt)) { "" } else { raw_pt }
                pts.push((pnames[pk], clean_pt))
                pk = pk + 1
              }
              let p_renames = compute_param_renames(extract_raw_param_names(tokens, name_i + 1, cp))
              if is_blackbox {
                ctx.symtab.blackbox_fn_param_types[fn_tok.raw] = pts
              } else {
                ctx.symtab.fn_param_types[fn_tok.raw] = pts
                register_local_fn_meta_f3d2(ctx, fn_tok.raw, tokens, name_i + 1, cp, pnames, ptys)
              }
              if p_renames.length() > 0 {
                ctx.symtab.fn_param_renames[fn_tok.raw] = p_renames
              }
              if cp + 1 < n && tokens[cp + 1].kind == TokenKind::Arrow {
                let mut re = cp + 2
                let mut rd = 0
                while re < n {
                  let rk = tokens[re].kind
                  if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq) { break }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
                  re = re + 1
                }
                let rty = lower_type_tokens(tokens, cp + 2, re, ctx.symtab, ctx.recipes).trim()
                if rty.length() > 0 {
                  if is_blackbox {
                    ctx.symtab.blackbox_fn_ret_types[fn_tok.raw] = rty
                  } else {
                    ctx.symtab.fn_ret_types[fn_tok.raw] = rty
                  }
                }
              }
            }
          }
        }
        pop_active_generics(ctx, fn_added_g)
        next_autofill = false
      }
      if t.kind == TokenKind::Keyword && t.raw == "impl" && i + 1 < n && tokens[i + 1].raw == "Show" {
        ctx.local_method_names["to_string"] = true
        // `impl Show for T with output(..)` is lowered to `T::to_string` with MoonBit's `Show` formatting.
        if i + 5 < n && tokens[i + 2].raw == "for" && tokens[i + 3].kind == TokenKind::UpperIdent &&
        tokens[i + 4].raw == "with" && tokens[i + 5].raw == "output" {
          ctx.symtab.show_impl_types[tokens[i + 3].raw] = true
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "impl" && i + 5 < n && tokens[i + 1].raw == "Eq" &&
      tokens[i + 2].raw == "for" && tokens[i + 3].kind == TokenKind::UpperIdent &&
      tokens[i + 4].raw == "with" {
        let mut eq_mi = i + 5
        if eq_mi < n && tokens[eq_mi].kind == TokenKind::Keyword && tokens[eq_mi].raw == "fn" {
          eq_mi = eq_mi + 1
        }
        if eq_mi < n && tokens[eq_mi].raw == "equal" {
          ctx.symtab.custom_impl_eq_types[tokens[i + 3].raw] = true
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "trait" && i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        next_autofill = false
        let tname = tokens[i + 1].raw
        ctx.symtab.local_types[tname] = true
        let mut lb = i + 2
        while lb < n && tokens[lb].kind != TokenKind::LBrace &&
        !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
          lb = lb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let mmap : Map[String, (Array[String], String)] = match ctx.trait_methods.get(tname) {
            Some(m) => m
            None => Map()
          }
          let mut mi = lb + 1
          while mi < rb {
            if tokens[mi].kind == TokenKind::Ident && mi + 1 < rb && tokens[mi + 1].kind == TokenKind::LParen {
              let mname = rename_keyword_ident(tokens[mi].raw)
              let cp = find_matching_delim(tokens, mi + 1)
              let mut ret_ty = ""
              let mut next_mi = cp + 1
              if cp + 1 < rb && tokens[cp + 1].kind == TokenKind::Arrow {
                let mut re = cp + 2
                let mut rd = 0
                while re < rb {
                  let rk = tokens[re].kind
                  if rd == 0 && re > cp + 2 && tokens[re].newline_before { break }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
                  re = re + 1
                }
                ret_ty = lower_type_tokens(tokens, cp + 2, re, ctx.symtab, ctx.recipes).trim()
                next_mi = re
              }
              let ptys : Array[String] = []
              let mut pi = mi + 2
              while pi < cp {
                if tokens[pi].kind == TokenKind::Comma { pi = pi + 1; continue }
                let mut pe = pi
                let mut pd = 0
                while pe < cp {
                  let pk = tokens[pe].kind
                  if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
                  else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
                  else if pd == 0 && pk == TokenKind::Comma { break }
                  pe = pe + 1
                }
                let mut col_i = -1
                let mut ck = pi
                let mut cd = 0
                while ck < pe {
                  let ckk = tokens[ck].kind
                  if ckk == TokenKind::LParen || ckk == TokenKind::LBracket || ckk == TokenKind::LBrace { cd = cd + 1 }
                  else if ckk == TokenKind::RParen || ckk == TokenKind::RBracket || ckk == TokenKind::RBrace { cd = cd - 1 }
                  else if cd == 0 && ckk == TokenKind::Colon { col_i = ck; break }
                  ck = ck + 1
                }
                if col_i >= 0 && col_i + 1 < pe {
                  ptys.push(lower_type_tokens(tokens, col_i + 1, pe, ctx.symtab, ctx.recipes).trim())
                } else if pe > pi {
                  ptys.push(lower_type_tokens(tokens, pi, pe, ctx.symtab, ctx.recipes).trim())
                }
                pi = pe + 1
              }
              mmap[mname] = (ptys, ret_ty)
              mi = next_mi
              continue
            }
            mi = mi + 1
          }
          ctx.trait_methods[tname] = mmap
          i = rb + 1
          continue
        }
      }
      if t.kind == TokenKind::Keyword && (t.raw == "test" || t.raw == "trait" || t.raw == "impl") {
        next_autofill = false
      }
      if t.kind == TokenKind::LBrace {
        next_autofill = false
        i = find_matching_delim(tokens, i) + 1
        continue
      }
      i = i + 1
    }
  }
  // Compute black-box `*_test.mbt` private top-level collisions against production declarations (P0-1: avoid ALL local idents!)
  for nm in bb_priv_decls {
    if prod_all_decls.contains(nm) && !ctx.symtab.blackbox_colliding_privs.contains(nm) {
      let mut cand = "__mbt_bbtest_" + nm
      let mut seq = 1
      while prod_all_decls.contains(cand) || ctx.symtab.blackbox_decls.contains(cand) ||
      bb_all_idents.contains(cand) || ctx.used_idents.contains(cand) {
        cand = "__mbt_bbtest_" + nm + "_" + seq.to_string()
        seq = seq + 1
      }
      bb_all_idents[cand] = true
      ctx.used_idents[cand] = true
      ctx.symtab.blackbox_colliding_privs[nm] = cand
      match ctx.symtab.blackbox_fn_param_types.get(nm) {
        Some(pts) => ctx.symtab.blackbox_fn_param_types[cand] = pts
        None => ()
      }
      match ctx.symtab.blackbox_fn_ret_types.get(nm) {
        Some(rty) => ctx.symtab.blackbox_fn_ret_types[cand] = rty
        None => ()
      }
      if ctx.symtab.blackbox_autofill_loc_fns.contains(nm) {
        ctx.symtab.blackbox_autofill_loc_fns[cand] = true
      }
    }
  }
  prescan_recursive_derive_eq_types(ctx, files)
}

///| Lower a single `.mbt` file through Stage A, emitting declaration anchors,
///| extracting top-level `let`/`fn init` into `ctx.init_items`, and recording span maps.
///| Exact Pion compiler C-ABI parameter type allowlist (`compiler/src/core/types.pion`).
fn is_pion_c_abi_param_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" ||
  t == "Float" || t == "Float32" || t == "Bool" || t == "Byte" || t == "Int8" || t == "Ptr"
}

///| Exact Pion compiler C-ABI return type allowlist (param types + `Unit`).
fn is_pion_c_abi_ret_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Unit" || is_pion_c_abi_param_type(t)
}

///| Validate every parameter in a lowered `p_str` (`x : T, y : U`) against Pion's C-ABI allowlist.
fn check_pion_c_abi_params(p_str : String) -> Bool {
  let s = p_str.trim()
  if s.length() == 0 {
    return true
  }
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i <= s.length() {
    let at_end = i == s.length()
    let c = if at_end { 44 } else { s.code_unit_at(i) }
    if !at_end && (c == 40 || c == 91 || c == 123) {
      depth = depth + 1
    } else if !at_end && (c == 41 || c == 93 || c == 125) {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 && c == 44 {
      let part = s.slice(start, i).trim()
      if part.length() > 0 {
        let ci = part.index_of(":")
        if ci < 0 {
          return false
        }
        if !is_pion_c_abi_param_type(part.slice(ci + 1, part.length())) {
          return false
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  true
}

pub fn lower_file_stage_a(ctx : StageAContext, sf : SourceFile) -> GeneratedFile {
  ctx.lifted_fns.clear()
  ctx.cur_is_test = sf.is_test
  ctx.symtab.pkg_aliases["__mbt_cur_test_self_pkg__"] = if sf.is_test { ctx.self_pkg_name } else { "" }
  ctx.cur_is_blackbox = sf.rel_path.ends_with("_test.mbt") && !sf.rel_path.ends_with("_wbtest.mbt")
  let raw_tokens = lex_moonbit(sf.content)
  let tokens = redact_tokens_comments(raw_tokens, ctx.recipes.comment_replaces)
  let n = tokens.length() - 1
  // Pre-populate `ctx.used_idents` with every source identifier so `fresh_temp` & `.val` placeholders NEVER collide!
  let mut ui = 0
  while ui < n {
    if tokens[ui].kind == TokenKind::Ident {
      ctx.used_idents[tokens[ui].raw] = true
    }
    ui = ui + 1
  }
  let out_sb = StringBuilder()
  let anchors : Array[DeclAnchor] = []
  // Pre-count split `impl Trait for Type with method` declarations per `(Trait|Type)` in this file
  // so multi-method MoonBit trait impls are merged into a single Pion `impl Trait for Type { ... }` block.
  let impl_counts : Map[String, Int] = Map()
  let merged_impl_methods : Map[String, Array[String]] = Map()
  let merged_impl_seen : Map[String, Int] = Map()
  let mut ci_scan = 0
  while ci_scan < n {
    if tokens[ci_scan].kind == TokenKind::Keyword && tokens[ci_scan].raw == "impl" &&
    !(ci_scan + 1 < n && tokens[ci_scan + 1].kind == TokenKind::LBracket) {
      let mut w_i = -1
      let mut f_i = -1
      let mut lb_s = ci_scan + 1
      while lb_s < n && tokens[lb_s].kind != TokenKind::LBrace &&
      !(tokens[lb_s].newline_before && is_top_level_decl_start(tokens, lb_s)) {
        if tokens[lb_s].kind == TokenKind::Keyword && tokens[lb_s].raw == "for" && f_i < 0 { f_i = lb_s }
        else if tokens[lb_s].kind == TokenKind::Keyword && tokens[lb_s].raw == "with" && w_i < 0 { w_i = lb_s }
        lb_s = lb_s + 1
      }
      if f_i > ci_scan && w_i > f_i && lb_s < n && tokens[lb_s].kind == TokenKind::LBrace {
        let tn = lower_type_tokens(tokens, ci_scan + 1, f_i, ctx.symtab, ctx.recipes).trim()
        let st = lower_type_tokens(tokens, f_i + 1, w_i, ctx.symtab, ctx.recipes).trim()
        let mn = if w_i + 1 < lb_s { rename_keyword_ident(tokens[w_i + 1].raw) } else { "" }
        if !(tn == "Show" && mn == "output") && !(tn == "Eq" && !ctx.symtab.local_types.contains("Eq")) && tn.length() > 0 && st.length() > 0 {
          let ikey = tn + "|" + st
          let prev_c = match impl_counts.get(ikey) { Some(v) => v, None => 0 }
          impl_counts[ikey] = prev_c + 1
        }
        ci_scan = find_matching_delim(tokens, lb_s) + 1
        continue
      }
    }
    if tokens[ci_scan].kind == TokenKind::LBrace {
      ci_scan = find_matching_delim(tokens, ci_scan) + 1
      continue
    }
    ci_scan = ci_scan + 1
  }
  let mut i = 0
  let mut init_seq_in_file = 0
  let file_id = sanitize_file_id(sf.rel_path)
  let out_rel = if sf.rel_path.ends_with("_wbtest.mbt") {
    sf.rel_path.slice(0, sf.rel_path.length() - 11) + "_wbtest_test.pion"
  } else if sf.rel_path.ends_with(".mbt") {
    sf.rel_path.slice(0, sf.rel_path.length() - 4) + ".pion"
  } else {
    sf.rel_path + ".pion"
  }
  ctx.cur_out_rel = out_rel

  while i < n {
    let decl_start = i
    let mut autofill_loc = false
    let mut attrs_trivia = StringBuilder()
    let mut kept_attrs = StringBuilder()

    // Collect leading attributes (`#callsite`, `#warnings`, `#deprecated`, `#cfg`, `#derive`, `#borrow`/`#owned`)
    let mut pending_derives : Array[String] = []
    let pending_cfgs : Array[Token] = []
    let pending_ffi_attrs : Array[String] = []
    while i < n && tokens[i].kind == TokenKind::Attr {
      let at = tokens[i]
      attrs_trivia.write_string(at.leading_trivia)
      if at.raw.starts_with("#callsite") && str_has(at.raw, "autofill(loc)") {
        autofill_loc = true
      } else if at.raw.starts_with("#cfg") {
        pending_cfgs.push(at)
      } else if at.raw.starts_with("#borrow") || at.raw.starts_with("#owned") {
        pending_ffi_attrs.push(at.raw)
        kept_attrs.write_string("// mbt-attr: " + at.raw + "\n")
      } else if at.raw.starts_with("#warnings") || at.raw.starts_with("#deprecated") {
        // Strip MoonBit-only compiler directives cleanly
        kept_attrs.write_string("// mbt-attr: " + at.raw + "\n")
      } else if at.raw.starts_with("#derive") {
        let ds = parse_derive_names(at.raw)
        for d in ds {
          pending_derives.push(d)
        }
      } else {
        kept_attrs.write_string(at.raw + "\n")
      }
      i = i + 1
    }
    if i >= n {
      out_sb.write_string(attrs_trivia.to_string())
      out_sb.write_string(kept_attrs.to_string())
      break
    }

    // Evaluate `#cfg(...)` attributes statically against `ctx.opts.target` (#12a P1-1):
    // - Unknown/complex predicate -> fail-loud `MBT2PION_UNSUPPORTED_CFG` + disposition "unsupported"
    // - Statically false -> skip declaration completely + disposition "excluded_by_cfg"
    if pending_cfgs.length() > 0 {
      let mut cfg_unsupported = false
      let mut cfg_unsupported_raw = ""
      let mut cfg_excluded = false
      let mut cfg_excluded_raw = ""
      for cat in pending_cfgs {
        match eval_cfg_attr(cat.raw, ctx.opts.target) {
          None => {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_CFG",
              sf.rel_path,
              cat.line,
              cat.col,
              "unsupported `#cfg` predicate `" + cat.raw + "` cannot be statically evaluated for target=" + ctx.opts.target,
            ))
            cfg_unsupported = true
            if cfg_unsupported_raw.length() == 0 {
              cfg_unsupported_raw = cat.raw
            }
          }
          Some(false) => {
            cfg_excluded = true
            if cfg_excluded_raw.length() == 0 {
              cfg_excluded_raw = cat.raw
            }
          }
          Some(true) => ()
        }
      }
      if cfg_unsupported {
        let lbl = peek_decl_label(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: lbl,
          line: tokens[i].line,
          col: tokens[i].col,
          disposition: "unsupported",
          detail: "unsupported #cfg predicate " + cfg_unsupported_raw,
        })
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if cfg_excluded {
        let lbl = peek_decl_label(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: lbl,
          line: tokens[i].line,
          col: tokens[i].col,
          disposition: "excluded_by_cfg",
          detail: "excluded by " + cfg_excluded_raw + " for target=" + ctx.opts.target,
        })
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
    }

    let decl_err_before = count_error_diags(ctx.diags)

    // Parse visibility (`pub`, `pub(all)`, `pub(open)`, `priv`)
    let mut vis = ""
    let mut pub_fields = false
    let mut explicit_priv = false
    let mut vis_trivia = tokens[i].leading_trivia
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
      vis = "pub "
      i = i + 1
      if i < n && tokens[i].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i)
        if i + 1 < cp && (tokens[i + 1].raw == "all" || tokens[i + 1].raw == "open") {
          pub_fields = true
        }
        i = cp + 1
      }
    } else if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
      vis = ""
      explicit_priv = true
      i = i + 1
    }
    if i >= n {
      break
    }

    let mut extern_abi = ""
    let mut extern_prefix = ""
    if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) && tokens[i].raw == "extern" {
      let mut ei = i + 1
      let mut abi = ""
      if ei < n && tokens[ei].kind == TokenKind::StringLit {
        abi = tokens[ei].raw
        ei = ei + 1
      }
      if ei < n && tokens[ei].kind == TokenKind::Keyword && tokens[ei].raw == "fn" {
        extern_abi = abi
        extern_prefix = if abi.length() > 0 { "extern " + abi + " " } else { "extern " }
        i = ei
      }
    }

    let kw = tokens[i]
    let decl_line = kw.line
    let decl_col = kw.col

    // --- 1. `fn init { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "fn" && i + 1 < n && tokens[i + 1].raw == "init" {
      let mut lb = i + 2
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        init_seq_in_file = init_seq_in_file + 1
        ctx.init_order_seq = ctx.init_order_seq + 1
        let init_name = "__mbt_init_" + file_id + "_" + init_seq_in_file.to_string()
        let saved_li = ctx.cur_lowering_init
        ctx.cur_lowering_init = true
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        ctx.cur_lowering_init = saved_li
        let (refs, calls, arg_closures) = collect_init_refs_full(tokens, lb, rb + 1)
        let init_target = if sf.is_test { ctx.test_init_items } else { ctx.init_items }
        let init_file_lbl = if sf.is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
        let init_prefix = "let " + init_name + " : Unit = "
        init_target.push(InitItem::{
          id: init_name,
          name: init_name,
          is_fn_init: true,
          source_file: sf.rel_path,
          order_index: ctx.init_order_seq,
          line: decl_line,
          col: decl_col,
          rhs_orig_col: tokens[lb].col,
          rhs_gen_col: init_prefix.length() + 1,
          probe_origins: collect_init_probe_origins(tokens, lb, rb + 1),
          code: init_prefix + body,
          referenced_idents: refs,
          called_fns: calls,
          arg_closure_refs: arg_closures,
        })
        out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
        out_sb.write_string("// moved to " + init_file_lbl + ": " + init_name + "\n")
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: init_name,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "moved_to_00_init_order" },
          detail: if had_err { "fn init contains unsupported syntax" } else { "fn init lowered to topological let Unit binding" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 2. Top-level `let` / `const` -> moved to `00_init_order.pion` ---
    if kw.kind == TokenKind::Keyword && (kw.raw == "let" || kw.raw == "const") && i + 1 < n {
      let mut name_i = i + 1
      let mut is_mut = false
      if tokens[name_i].kind == TokenKind::Keyword && tokens[name_i].raw == "mut" {
        is_mut = true
        name_i = name_i + 1
      }
      let raw_name = tokens[name_i].raw
      let pion_name = if ctx.cur_is_blackbox && vis.length() == 0 {
        match ctx.symtab.blackbox_colliding_privs.get(raw_name) {
          Some(rn) => rn
          None => rename_keyword_ident(raw_name)
        }
      } else {
        rename_keyword_ident(raw_name)
      }
      // Find `=` and end of initializer expression
      let mut eq_i = name_i + 1
      let mut colon_i = -1
      while eq_i < n && tokens[eq_i].kind != TokenKind::Eq {
        if tokens[eq_i].kind == TokenKind::Colon && colon_i < 0 {
          colon_i = eq_i
        }
        eq_i = eq_i + 1
      }
      if eq_i < n {
        let expr_end = find_top_level_let_expr_end(tokens, eq_i + 1, n)
        let mut let_exp_ty = ""
        let ty_str = if colon_i > name_i {
          let lt = lower_type_tokens_checked(ctx, tokens, colon_i + 1, eq_i, sf.rel_path)
          let_exp_ty = lt.trim()
          " : " + lt
        } else {
          let inf = infer_simple_expr_type(ctx, tokens, eq_i + 1, expr_end)
          if inf == "Int" || inf == "Double" || inf == "String" || inf == "Bool" ||
          inf == "Int64" || inf == "UInt" || inf == "UInt64" || inf == "Char" || inf == "Byte" {
            " : " + inf
          } else {
            ""
          }
        }
        push_expected_type(ctx, let_exp_ty)
        let saved_li = ctx.cur_lowering_init
        ctx.cur_lowering_init = true
        let raw_val_str = lower_expr_range(ctx, tokens, eq_i + 1, expr_end, sf.rel_path, false)
        ctx.cur_lowering_init = saved_li
        pop_expected_type(ctx)
        let mut vs = 0
        while vs < raw_val_str.length() && (raw_val_str.code_unit_at(vs) == 32 || raw_val_str.code_unit_at(vs) == 9) {
          vs = vs + 1
        }
        let mut ve = raw_val_str.length()
        while ve > vs {
          let ch = raw_val_str.code_unit_at(ve - 1)
          if ch == 32 || ch == 9 || ch == 10 || ch == 13 { ve = ve - 1 } else { break }
        }
        let val_str = raw_val_str.slice(vs, ve)
        let (refs, calls, arg_closures) = collect_init_refs_full(tokens, eq_i + 1, expr_end)
        ctx.init_order_seq = ctx.init_order_seq + 1
        let mut_kw = if is_mut { "mut " } else { "" }
        let is_multiline_val = val_str.starts_with("\n") || val_str.starts_with("\r")
        let eq_sep = if is_multiline_val { " =" } else { " = " }
        let let_prefix = vis + "let " + mut_kw + pion_name + ty_str + eq_sep
        let code = let_prefix + val_str
        let rhs_orig_col = if is_multiline_val || eq_i + 1 >= n { 1 } else { tokens[eq_i + 1].col }
        let rhs_gen_col = if is_multiline_val { 1 } else { let_prefix.length() + 1 }
        let init_target = if sf.is_test { ctx.test_init_items } else { ctx.init_items }
        let init_file_lbl = if sf.is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
        init_target.push(InitItem::{
          id: pion_name,
          name: pion_name,
          is_fn_init: false,
          source_file: sf.rel_path,
          order_index: ctx.init_order_seq,
          line: decl_line,
          col: decl_col,
          rhs_orig_col: rhs_orig_col,
          rhs_gen_col: rhs_gen_col,
          probe_origins: collect_init_probe_origins(tokens, eq_i + 1, expr_end),
          code: code,
          referenced_idents: refs,
          called_fns: calls,
          arg_closure_refs: arg_closures,
        })
        out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
        out_sb.write_string("// moved to " + init_file_lbl + ": " + pion_name + "\n")
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "let:" + pion_name,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "moved_to_00_init_order" },
          detail: if had_err { "top-level let contains unsupported syntax" } else { "top-level let scheduled in topological order" },
        })
        i = expr_end
        continue
      }
    }

    // --- 2b. Top-level `type Alias = T` -> expanded inline at use sites ---
    if kw.kind == TokenKind::Keyword && kw.raw == "type" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::UpperIdent && tokens[i + 2].kind == TokenKind::Eq {
      let aname = tokens[i + 1].raw
      let rhs_end = find_top_level_let_expr_end(tokens, i + 3, n)
      out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
      out_sb.write_string("// type alias expanded: " + aname + "\n")
      ctx.dispositions.push(DispositionEntry::{
        file: sf.rel_path,
        decl: "type:" + aname,
        line: decl_line,
        col: decl_col,
        disposition: "transpiled",
        detail: "type alias expanded inline at use sites",
      })
      i = rhs_end
      continue
    }

    // --- 2c. Top-level `[pub] using @pkg { ... }` ---
    if (kw.kind == TokenKind::Keyword || kw.kind == TokenKind::Ident) && kw.raw == "using" &&
    i + 2 < n && tokens[i + 1].kind == TokenKind::PkgRef && tokens[i + 2].kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, i + 2)
      let raw_pkg = tokens[i + 1].raw
      out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
      out_sb.write_string("// using " + raw_pkg + " expanded\n")
      if vis.length() > 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "`pub using` cross-package re-export from `" + raw_pkg + "` is not yet lowered to ABI",
        ))
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "using:" + raw_pkg,
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "pub using cross-package re-export requires ABI re-export",
        })
      } else {
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "using:" + raw_pkg,
          line: decl_line,
          col: decl_col,
          disposition: "transpiled",
          detail: "private using expanded locally at use sites",
        })
      }
      i = rb + 1
      continue
    }

    // --- 3. `struct` / `enum` declarations with strict `#derive(...)` allowlist + `--recipes` synthesis ---
    if kw.kind == TokenKind::Keyword && (kw.raw == "struct" || kw.raw == "enum") && i + 1 < n {
      let kind_kw = kw.raw
      let tname = tokens[i + 1].raw
      let mut lb = i + 2
      let mut type_added_generics : Array[String] = []
      if lb < n && tokens[lb].kind == TokenKind::LBracket {
        let close_gb = find_matching_delim(tokens, lb)
        type_added_generics = push_active_generics(ctx, collect_generic_param_names(tokens, lb, close_gb))
        lb = close_gb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let mut decl_end = rb + 1
        // Check trailing `derive(...)`
        if decl_end < n && (tokens[decl_end].kind == TokenKind::Keyword || tokens[decl_end].kind == TokenKind::Ident) && tokens[decl_end].raw == "derive" &&
        decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          let dp = find_matching_delim(tokens, decl_end + 1)
          let mut di = decl_end + 2
          while di < dp {
            if tokens[di].kind == TokenKind::UpperIdent || tokens[di].kind == TokenKind::Ident {
              pending_derives.push(tokens[di].raw)
            }
            di = di + 1
          }
          decl_end = dp + 1
        }
        // Validate derives against strict allowlist + recipes!
        let mut pion_derives : Array[String] = []
        let mut recipe_impls_sb = StringBuilder()
        let mut all_fields_primitive = true
        let field_names : Array[String] = []

        // Parse struct fields or enum variants (preserving types for recursive structural equality)
        let field_types : Array[(String, String)] = []
        let enum_variants : Array[(String, Array[String])] = []
        let body_sb = StringBuilder()
        if kind_kw == "struct" {
          let mut fi = lb + 1
          while fi < rb {
            if tokens[fi].kind == TokenKind::Semi || tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            let mut f_mut = false
            let mut f_pub = pub_fields
            if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "pub" {
              f_pub = true
              fi = fi + 1
            } else if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "priv" {
              f_pub = false
              fi = fi + 1
            }
            if fi < rb && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
              f_mut = true
              fi = fi + 1
            }
            if fi >= rb {
              break
            }
            let fname_raw = tokens[fi].raw
            let fname = rename_struct_field(ctx, tname, fname_raw)
            let mut fc = fi + 1
            while fc < rb && tokens[fc].kind != TokenKind::Colon {
              fc = fc + 1
            }
            let mut f_end = fc + 1
            let mut fd = 0
            while f_end < rb {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
                fd = fd + 1
              } else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
                fd = fd - 1
              } else if fd == 0 && (fk == TokenKind::Semi || fk == TokenKind::Comma || tokens[f_end].newline_before) {
                break
              }
              f_end = f_end + 1
            }
            let fty = if fc < rb {
              lower_type_tokens_checked(ctx, tokens, fc + 1, f_end, sf.rel_path)
            } else {
              ""
            }
            if !is_primitive_type(fty) {
              all_fields_primitive = false
            }
            field_names.push(fname)
            field_types.push((fname, fty))
            body_sb.write_string("  ")
            if f_pub {
              body_sb.write_string("pub ")
            }
            if f_mut {
              body_sb.write_string("mut ")
            }
            body_sb.write_string(fname + " : " + fty + "\n")
            fi = f_end
          }
        } else {
          // enum body: lower type params inside variants & record payload types
          let mut ei = lb + 1
          while ei < rb {
            if tokens[ei].kind == TokenKind::UpperIdent {
              let vname = tokens[ei].raw
              let varg_tys : Array[String] = []
              body_sb.write_string("  " + vname)
              if ei + 1 < rb && tokens[ei + 1].kind == TokenKind::LParen {
                let vp = find_matching_delim(tokens, ei + 1)
                let mut ai = ei + 2
                let arg_strs : Array[String] = []
                while ai < vp {
                  if tokens[ai].kind == TokenKind::Comma {
                    ai = ai + 1
                    continue
                  }
                  let mut ae = ai
                  let mut ad = 0
                  while ae < vp {
                    let ak = tokens[ae].kind
                    if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace {
                      ad = ad + 1
                    } else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
                      ad = ad - 1
                    } else if ad == 0 && ak == TokenKind::Comma {
                      break
                    }
                    ae = ae + 1
                  }
                  // Strip optional MoonBit labeled enum payload prefix: `[mut] name[~] : Type` -> `Type`
                  let mut ty_start = ai
                  if ty_start < ae && tokens[ty_start].kind == TokenKind::Keyword && tokens[ty_start].raw == "mut" {
                    ty_start = ty_start + 1
                  }
                  if ty_start + 1 < ae && tokens[ty_start].kind == TokenKind::Ident {
                    if tokens[ty_start + 1].kind == TokenKind::Tilde && ty_start + 2 < ae && tokens[ty_start + 2].kind == TokenKind::Colon {
                      ty_start = ty_start + 3
                    } else if tokens[ty_start + 1].kind == TokenKind::Colon {
                      ty_start = ty_start + 2
                    }
                  }
                  let aty = lower_type_tokens_checked(ctx, tokens, ty_start, ae, sf.rel_path).trim()
                  if !is_primitive_type(aty) {
                    all_fields_primitive = false
                  }
                  varg_tys.push(aty)
                  arg_strs.push(aty)
                  ai = ae + 1
                }
                body_sb.write_string("(" + join_comma(arg_strs) + ")")
                ei = vp + 1
              } else {
                ei = ei + 1
              }
              enum_variants.push((vname, varg_tys))
              body_sb.write_string("\n")
            } else {
              ei = ei + 1
            }
          }
        }

        let generics = if lb > i + 2 {
          lower_type_tokens_checked(ctx, tokens, i + 2, lb, sf.rel_path)
        } else {
          ""
        }
        let type_vis = if kind_kw == "struct" {
          if vis.length() > 0 { vis } else if explicit_priv { "" } else { "pub " }
        } else {
          // §6 Enum visibility:
          // - `pub(all)` / `pub(open)` -> `pub enum` (`can_match: true, can_construct: true` in ABI)
          // - `pub enum` (readonly externally) -> `pub enum` (`can_match: true, can_construct: false` in ABI)
          // - bare `enum` / `priv enum` -> private; fails closed (`MBT2PION_UNSUPPORTED_VISIBILITY`) if exposed in `pub` sig.
          if pub_fields || vis.length() > 0 {
            "pub "
          } else if explicit_priv {
            ""
          } else if ctx.symtab.pub_sig_referenced_types.contains(tname) {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_VISIBILITY",
              sf.rel_path,
              decl_line,
              decl_col,
              "abstract/read-only enum `" + tname + "` is referenced in a public signature, but Pion `pub enum` cannot hide constructors (use `pub(all)` or overlay)",
            ))
            ""
          } else {
            ""
          }
        }
        let use_native_derive_eq = if kind_kw == "struct" {
          should_use_native_derive_eq_struct(tname, field_types, ctx.symtab.recursive_derive_eq_types)
        } else {
          should_use_native_derive_eq_enum(tname, enum_variants, ctx.symtab.recursive_derive_eq_types)
        }
        for d in pending_derives {
          if d == "Debug" {
            continue
          }
          let mut allowed = d == "Hash"
          for ad in ctx.recipes.allowed_derives {
            if ad == d {
              allowed = true
            }
          }
          for tr in ctx.recipes.trait_recipes {
            if tr.derive_name == d {
              allowed = true
            }
          }
          if !allowed {
            let mut ignored = false
            for ider in ctx.recipes.ignored_derives {
              if ider == d {
                ignored = true
              }
            }
            if ignored {
              continue
            }
          }
          if !allowed {
            ctx.diags.push(diag_error(
              "MBT2PION_UNKNOWN_DERIVE",
              sf.rel_path,
              decl_line,
              decl_col,
              "unrecognized `#derive(" + d + ")` on `" + tname + "` (not in strict allowlist or recipes)",
            ))
          } else {
            if d == "Eq" && use_native_derive_eq {
              pion_derives.push("Eq")
            } else if d == "Eq" {
              // Direct `Bytes` or recursive `#derive(Eq)` type: synthesize native Pion `[pub] impl[T : Eq, ...] Eq`
              recipe_impls_sb.write_string(gen_explicit_derive_eq_impl(type_vis, tname, type_added_generics, kind_kw == "struct", field_types, enum_variants))
            } else if d == "Hash" {
              let mut all_hashable = true
              if kind_kw == "struct" {
                for ft in field_types {
                  if !is_hashable_type(ft.1, ctx.symtab.hashable_types) { all_hashable = false }
                }
              } else {
                for ev in enum_variants {
                  for aty in ev.1 {
                    if !is_hashable_type(aty, ctx.symtab.hashable_types) { all_hashable = false }
                  }
                }
              }
              if !all_hashable {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  decl_line,
                  decl_col,
                  "`#derive(Hash)` on `" + tname + "` contains a non-hashable field or payload type",
                ))
              } else {
                ctx.symtab.hashable_types[tname] = true
                let hc_body = if kind_kw == "struct" {
                  gen_struct_hash_combine_body("self", "hasher", field_types)
                } else {
                  gen_enum_hash_combine_body("self", "hasher", enum_variants)
                }
                recipe_impls_sb.write_string("\nimpl mbt_compat::MbtHash for " + tname + " {\n  fn hash_combine(self : " + tname + ", hasher : mbt_compat::MbtHasher) -> Unit {\n    " + hc_body + "\n  }\n}\n")
                recipe_impls_sb.write_string("\npub fn " + tname + "::hash(self : " + tname + ") -> Int {\n  mbt_compat::mbt_hash(self)\n}\n")
                // §5: When `Hash` is derived alongside `#derive(Eq)` or built-in `impl Eq`, emit `impl mbt_compat::MapKey`!
                let mut also_has_eq = false
                for pd in pending_derives {
                  if pd == "Eq" { also_has_eq = true }
                }
                if also_has_eq || (!ctx.symtab.local_types.contains("Eq") && ctx.symtab.custom_impl_eq_types.contains(tname)) {
                  recipe_impls_sb.write_string("\nimpl mbt_compat::MapKey for " + tname + " {\n  fn key_hash(self : " + tname + ") -> Int {\n    mbt_compat::mbt_hash(self)\n  }\n  fn key_eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    self == other\n  }\n}\n")
                }
              }
            }
            // Declarative recipe trait-impl synthesis for BOTH `struct` and `enum` (zero hardcoded project symbols!)
            for tr in ctx.recipes.trait_recipes {
              if tr.derive_name == d {
                let mname = if tr.method_name.length() > 0 { tr.method_name } else { "eq" }
                let eq_body = if kind_kw == "struct" {
                  gen_struct_eq_body("self", "other", field_types, ctx.symtab.custom_eq_types)
                } else {
                  gen_enum_eq_body("self", "other", enum_variants, ctx.symtab.custom_eq_types)
                }
                recipe_impls_sb.write_string("\nimpl " + tr.target_trait + " for " + tname + " {\n")
                if tr.kind == "eq_hash" {
                  let hash_body = if kind_kw == "struct" {
                    gen_struct_hash_body("self", field_types)
                  } else {
                    gen_enum_hash_body("self", enum_variants)
                  }
                  recipe_impls_sb.write_string("  fn eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n")
                  recipe_impls_sb.write_string("  fn hash(self : " + tname + ") -> Int {\n    " + hash_body + "\n  }\n}\n")
                } else {
                  recipe_impls_sb.write_string("  fn " + mname + "(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n}\n")
                }
              }
            }
          }
        }

        let derive_prefix = if pion_derives.length() > 0 {
          "#derive(" + join_comma(pion_derives) + ")\n"
        } else {
          ""
        }
        let decl_code = derive_prefix + type_vis + kind_kw + " " + tname + generics + " {\n" + body_sb.to_string() + "}" + recipe_impls_sb.to_string()
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        let out_start = out_sb.to_string().length()
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: kind_kw + ":" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[decl_end - 1].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: kind_kw + ":" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: kind_kw + ":" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { kind_kw + " contains unsupported syntax" } else { kind_kw + " lowered cleanly" },
        })
        let _ = out_start
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      } else if kind_kw == "struct" && lb < n && tokens[lb].kind == TokenKind::LParen {
        // Tuple struct: `[pub|priv] struct Name[T](A, B, ...)` -> `[pub] struct Name[T] { _0 : A; _1 : B; ... }`
        let rp = find_matching_delim(tokens, lb)
        let mut decl_end = rp + 1
        if decl_end < n && (tokens[decl_end].kind == TokenKind::Keyword || tokens[decl_end].kind == TokenKind::Ident) &&
        tokens[decl_end].raw == "derive" && decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          let dp = find_matching_delim(tokens, decl_end + 1)
          let mut di = decl_end + 2
          while di < dp {
            if tokens[di].kind == TokenKind::UpperIdent || tokens[di].kind == TokenKind::Ident {
              pending_derives.push(tokens[di].raw)
            }
            di = di + 1
          }
          decl_end = dp + 1
        }
        let mut all_fields_primitive = true
        let field_types : Array[(String, String)] = []
        let body_sb = StringBuilder()
        let mut fi = lb + 1
        let mut fidx = 0
        while fi < rp {
          if tokens[fi].kind == TokenKind::Comma {
            fi = fi + 1
            continue
          }
          let mut f_pub = pub_fields
          let mut f_mut = false
          if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "pub" {
            f_pub = true
            fi = fi + 1
          } else if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "priv" {
            f_pub = false
            fi = fi + 1
          }
          if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
            f_mut = true
            fi = fi + 1
          }
          let mut f_end = fi
          let mut fd = 0
          while f_end < rp {
            let fk = tokens[f_end].kind
            if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
            else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
            else if fd == 0 && fk == TokenKind::Comma { break }
            f_end = f_end + 1
          }
          if f_end > fi {
            let fname = "_" + fidx.to_string()
            let fty = lower_type_tokens_checked(ctx, tokens, fi, f_end, sf.rel_path).trim()
            if !is_primitive_type(fty) {
              all_fields_primitive = false
            }
            field_types.push((fname, fty))
            body_sb.write_string("  ")
            if f_pub { body_sb.write_string("pub ") }
            if f_mut { body_sb.write_string("mut ") }
            body_sb.write_string(fname + " : " + fty + "\n")
            fidx = fidx + 1
          }
          fi = f_end + 1
        }
        let generics = if lb > i + 2 {
          lower_type_tokens_checked(ctx, tokens, i + 2, lb, sf.rel_path)
        } else {
          ""
        }
        let type_vis = if vis.length() > 0 { vis } else if explicit_priv { "" } else { "pub " }
        let mut pion_derives : Array[String] = []
        let mut recipe_impls_sb = StringBuilder()
        let use_native_derive_eq = should_use_native_derive_eq_struct(tname, field_types, ctx.symtab.recursive_derive_eq_types)
        for d in pending_derives {
          if d == "Debug" {
            continue
          }
          let mut allowed = d == "Hash"
          for ad in ctx.recipes.allowed_derives {
            if ad == d { allowed = true }
          }
          for tr in ctx.recipes.trait_recipes {
            if tr.derive_name == d { allowed = true }
          }
          if !allowed {
            let mut ignored = false
            for ider in ctx.recipes.ignored_derives {
              if ider == d { ignored = true }
            }
            if ignored { continue }
          }
          if !allowed {
            ctx.diags.push(diag_error(
              "MBT2PION_UNKNOWN_DERIVE",
              sf.rel_path,
              decl_line,
              decl_col,
              "unrecognized `#derive(" + d + ")` on `" + tname + "` (not in strict allowlist or recipes)",
            ))
          } else {
            if d == "Eq" && use_native_derive_eq {
              pion_derives.push("Eq")
            } else if d == "Eq" {
              recipe_impls_sb.write_string(gen_explicit_derive_eq_impl(type_vis, tname, type_added_generics, true, field_types, []))
            } else if d == "Hash" {
              let mut all_hashable = true
              for ft in field_types {
                if !is_hashable_type(ft.1, ctx.symtab.hashable_types) { all_hashable = false }
              }
              if !all_hashable {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  decl_line,
                  decl_col,
                  "`#derive(Hash)` on `" + tname + "` contains a non-hashable field type",
                ))
              } else {
                ctx.symtab.hashable_types[tname] = true
                let hc_body = gen_struct_hash_combine_body("self", "hasher", field_types)
                recipe_impls_sb.write_string("\nimpl mbt_compat::MbtHash for " + tname + " {\n  fn hash_combine(self : " + tname + ", hasher : mbt_compat::MbtHasher) -> Unit {\n    " + hc_body + "\n  }\n}\n")
                recipe_impls_sb.write_string("\npub fn " + tname + "::hash(self : " + tname + ") -> Int {\n  mbt_compat::mbt_hash(self)\n}\n")
                // §5: When `Hash` is derived alongside `#derive(Eq)` or built-in `impl Eq`, emit `impl mbt_compat::MapKey`!
                let mut also_has_eq = false
                for pd in pending_derives {
                  if pd == "Eq" { also_has_eq = true }
                }
                if also_has_eq || (!ctx.symtab.local_types.contains("Eq") && ctx.symtab.custom_impl_eq_types.contains(tname)) {
                  recipe_impls_sb.write_string("\nimpl mbt_compat::MapKey for " + tname + " {\n  fn key_hash(self : " + tname + ") -> Int {\n    mbt_compat::mbt_hash(self)\n  }\n  fn key_eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    self == other\n  }\n}\n")
                }
              }
            }
            for tr in ctx.recipes.trait_recipes {
              if tr.derive_name == d {
                let mname = if tr.method_name.length() > 0 { tr.method_name } else { "eq" }
                let eq_body = gen_struct_eq_body("self", "other", field_types, ctx.symtab.custom_eq_types)
                recipe_impls_sb.write_string("\nimpl " + tr.target_trait + " for " + tname + " {\n")
                if tr.kind == "eq_hash" {
                  let hash_body = gen_struct_hash_body("self", field_types)
                  recipe_impls_sb.write_string("  fn eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n")
                  recipe_impls_sb.write_string("  fn hash(self : " + tname + ") -> Int {\n    " + hash_body + "\n  }\n}\n")
                } else {
                  recipe_impls_sb.write_string("  fn " + mname + "(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n}\n")
                }
              }
            }
          }
        }
        let derive_prefix = if pion_derives.length() > 0 {
          "#derive(" + join_comma(pion_derives) + ")\n"
        } else {
          ""
        }
        let decl_code = derive_prefix + type_vis + "struct " + tname + generics + " {\n" + body_sb.to_string() + "}" + recipe_impls_sb.to_string()
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "struct:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[decl_end - 1].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: "struct:" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "struct:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "tuple struct contains unsupported syntax" } else { "tuple struct lowered to named-field struct" },
        })
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      } else {
        let mut decl_end = lb
        if decl_end < n && (tokens[decl_end].kind == TokenKind::Keyword || tokens[decl_end].kind == TokenKind::Ident) &&
        tokens[decl_end].raw == "derive" && decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          decl_end = find_matching_delim(tokens, decl_end + 1) + 1
        }
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "unsupported brace-less `" + kind_kw + " " + tname + "` declaration",
        ))
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + src_slice)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: kind_kw + ":" + tname,
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "brace-less " + kind_kw + " declaration is unsupported",
        })
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      }
    }

    // --- 4. `impl Trait for Type with method(self, ...) -> R { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "impl" {
      let (handled_eq_impl, next_eq_i) = try_lower_builtin_eq_impl(
        ctx,
        sf,
        tokens,
        n,
        decl_start,
        i,
        vis,
        attrs_trivia.to_string(),
        kept_attrs.to_string(),
        vis_trivia,
        decl_line,
        decl_col,
        decl_err_before,
        out_sb,
        anchors,
      )
      if handled_eq_impl {
        i = next_eq_i
        continue
      }
      // pionc 0.1.0 does not support generic `impl[T : ...]` -> fail loud!
      if i + 1 < n && tokens[i + 1].kind == TokenKind::LBracket {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "unsupported generic `impl[...]` declaration (pionc does not support generic impl blocks)",
        ))
        let decl_end = skip_top_level_decl(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "impl:generic",
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "generic impl block is unsupported by pionc",
        })
        i = decl_end
        continue
      }
      let mut with_i = -1
      let mut lb = i + 1
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        if tokens[lb].kind == TokenKind::Keyword && tokens[lb].raw == "with" {
          with_i = lb
        }
        lb = lb + 1
      }
      if with_i > i && lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        // Find `for` between `impl` and `with`
        let mut for_i = -1
        let mut k = i + 1
        while k < with_i {
          if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "for" {
            for_i = k
            break
          }
          k = k + 1
        }
        let trait_name = if for_i > i {
          lower_type_tokens_checked(ctx, tokens, i + 1, for_i, sf.rel_path).trim()
        } else {
          ""
        }
        let self_ty = if for_i > i {
          lower_type_tokens_checked(ctx, tokens, for_i + 1, with_i, sf.rel_path).trim()
        } else {
          ""
        }
        let mname = rename_keyword_ident(tokens[with_i + 1].raw)
        let mut open_p = with_i + 2
        while open_p < lb && tokens[open_p].kind != TokenKind::LParen {
          open_p = open_p + 1
        }
        let close_p = if open_p < lb { find_matching_delim(tokens, open_p) } else { open_p }
        // Look up trait method signature for filling omitted MoonBit `impl ... with` param/return types
        let trait_sig_opt : Option[(Array[String], String)] = match ctx.trait_methods.get(trait_name) {
          Some(mm) => mm.get(mname)
          None => None
        }
        let (p_str, p_pre, _) = if open_p < lb {
          lower_param_list(ctx, tokens, open_p, close_p, sf.rel_path, autofill_loc)
        } else {
          ("", "", false)
        }
        let impl_param_scope : Array[(String, String)] = []
        let typed_params = if open_p < lb {
          let tp_sb = StringBuilder()
          let mut pi = open_p + 1
          let mut pidx = 0
          while pi < close_p {
            if tokens[pi].kind == TokenKind::Comma { pi = pi + 1; continue }
            let mut pe = pi
            let mut pd = 0
            while pe < close_p {
              let pk = tokens[pe].kind
              if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
              else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
              else if pd == 0 && pk == TokenKind::Comma { break }
              pe = pe + 1
            }
            if pe > pi {
              if pidx > 0 { tp_sb.write_string(", ") }
              let mut col_i = -1
              let mut ck = pi
              let mut cd = 0
              while ck < pe {
                let ckk = tokens[ck].kind
                if ckk == TokenKind::LParen || ckk == TokenKind::LBracket || ckk == TokenKind::LBrace { cd = cd + 1 }
                else if ckk == TokenKind::RParen || ckk == TokenKind::RBracket || ckk == TokenKind::RBrace { cd = cd - 1 }
                else if cd == 0 && ckk == TokenKind::Colon { col_i = ck; break }
                ck = ck + 1
              }
              let raw_pn = rename_keyword_ident(tokens[pi].raw)
              if col_i >= 0 && col_i + 1 < pe {
                let pty = lower_type_tokens_checked(ctx, tokens, col_i + 1, pe, sf.rel_path).trim()
                tp_sb.write_string(raw_pn + " : " + pty)
                impl_param_scope.push((raw_pn, pty))
              } else if pidx == 0 && (raw_pn == "self" || raw_pn == "_self" || (trait_name == "Debug" && mname == "to_repr")) {
                tp_sb.write_string(raw_pn + " : " + self_ty)
                impl_param_scope.push((raw_pn, self_ty))
              } else {
                let mut filled_ty = ""
                match trait_sig_opt {
                  Some((tptys, _)) =>
                  if pidx < tptys.length() {
                    filled_ty = if tptys[pidx] == "Self" { self_ty } else { tptys[pidx] }
                  }
                  None => ()
                }
                if filled_ty.length() > 0 {
                  tp_sb.write_string(raw_pn + " : " + filled_ty)
                  impl_param_scope.push((raw_pn, filled_ty))
                } else {
                  tp_sb.write_string(raw_pn)
                  impl_param_scope.push((raw_pn, ""))
                }
              }
              pidx = pidx + 1
            }
            pi = pe + 1
          }
          tp_sb.to_string()
        } else {
          p_str
        }
        let mut ret_str = ""
        if close_p + 1 < lb && tokens[close_p + 1].kind == TokenKind::Arrow {
          ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, close_p + 2, lb, sf.rel_path)
        } else {
          if close_p + 1 < lb {
            check_unsupported_error_tokens(ctx, tokens, close_p + 1, lb, sf.rel_path)
          }
          match trait_sig_opt {
            Some((_, tret)) =>
            if tret.length() > 0 {
              ret_str = " -> " + (if tret == "Self" { self_ty } else { tret })
            }
            None => ()
          }
        }
        let saved_impl_sc = ctx.scope_vars.length()
        for ip in impl_param_scope {
          if ip.0.length() > 0 && ip.0 != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: ip.0, ty: ip.1, is_mut: false, is_boxed: false })
          }
        }
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, p_pre)
        restore_scope_vars(ctx, saved_impl_sc)
        let ikey = trait_name + "|" + self_ty
        let total_for_key = match impl_counts.get(ikey) { Some(v) => v, None => 1 }
        if !(trait_name == "Show" && mname == "output") && !(trait_name == "Debug" && mname == "to_repr") && total_for_key > 1 {
          let m_entry = "  fn " + mname + "(" + typed_params + ")" + ret_str + " " + body
          let mlist = match merged_impl_methods.get(ikey) { Some(xs) => xs, None => [] }
          mlist.push(m_entry)
          merged_impl_methods[ikey] = mlist
          let seen_now = (match merged_impl_seen.get(ikey) { Some(v) => v, None => 0 }) + 1
          merged_impl_seen[ikey] = seen_now
          if seen_now == total_for_key {
            let msb = StringBuilder()
            msb.write_string("impl " + trait_name + " for " + self_ty + " {\n")
            for me in mlist {
              msb.write_string(me)
              msb.write_string("\n")
            }
            msb.write_string("}")
            let decl_code = msb.to_string()
            let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
            out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
            let anchor_start = out_sb.to_string().length()
            out_sb.write_string(decl_code)
            let anchor_end = out_sb.to_string().length()
            anchors.push(DeclAnchor::{
              source_file: sf.rel_path,
              decl_identity: "impl:" + trait_name + ":" + self_ty,
              normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
              pre_overlay_generated_hash: content_sha256(decl_code),
              start_byte: anchor_start,
              end_byte: anchor_end,
              line: decl_line,
              col: decl_col,
            })
          }
          let had_err = count_error_diags(ctx.diags) > decl_err_before
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "impl:" + trait_name + ":" + self_ty + "::" + mname,
            line: decl_line,
            col: decl_col,
            disposition: if had_err { "unsupported" } else { "transpiled" },
            detail: if had_err { "impl method contains unsupported syntax" } else { "impl method merged cleanly" },
          })
          i = rb + 1
          continue
        }
        let decl_code = if trait_name == "Show" && mname == "output" {
          // MoonBit `impl Show for T with output(self, logger) { ... }` -> Pion `pub fn T::to_string(self : T) -> String`
          // Wrap body in a hygienic zero-arg closure so early `return` returns `Unit` from the closure, not from `to_string`!
          let comma_p = p_str.index_of(",")
          let logger_param = if comma_p > 0 {
            let after_c = p_str.slice(comma_p + 1, p_str.length()).trim()
            let col_c = after_c.index_of(":")
            let raw_lp = if col_c > 0 { after_c.slice(0, col_c).trim() } else { after_c }
            if raw_lp.length() > 0 && raw_lp != "_" { raw_lp } else { "__mbt_logger" }
          } else {
            "__mbt_logger"
          }
          let mut run_var = "__mbt_show_run"
          while run_var == logger_param || str_has(body, run_var) {
            run_var = run_var + "_"
          }
          "pub fn " + self_ty + "::to_string(self : " + self_ty + ") -> String {\n  let " + logger_param + " = StringBuilder()\n  let " + run_var + " : () -> Unit = fn() -> Unit " + body + "\n  " + run_var + "()\n  " + logger_param + ".to_string()\n}"
        } else if trait_name == "Debug" && mname == "to_repr" {
          // MoonBit `impl Debug for T with to_repr(x) { ... }` -> Pion `pub fn T::to_repr(x : T) -> String`
          let comma_p = p_str.index_of(",")
          let first_p = if comma_p > 0 { p_str.slice(0, comma_p).trim() } else { p_str.trim() }
          let col_p = first_p.index_of(":")
          let raw_sp = if col_p > 0 { first_p.slice(0, col_p).trim() } else { first_p }
          let self_param = if raw_sp.length() > 0 && raw_sp != "_" { raw_sp } else { "self" }
          "pub fn " + self_ty + "::to_repr(" + self_param + " : " + self_ty + ") -> String " + body
        } else {
          "impl " + trait_name + " for " + self_ty + " {\n  fn " + mname + "(" + typed_params + ")" + ret_str + " " + body + "\n}"
        }
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "impl:" + trait_name + ":" + self_ty + "::" + mname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "impl:" + trait_name + ":" + self_ty + "::" + mname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "impl method contains unsupported syntax" } else { "impl method lowered cleanly" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 5. Top-level `fn` (including `extern "<abi>" fn`, `fn[T]`, `Type::method`, and body-less `= ...`) ---
    if kw.kind == TokenKind::Keyword && kw.raw == "fn" && i + 1 < n {
      let mut name_start = i + 1
      let mut leading_generics = ""
      let fn_generic_names : Array[String] = []
      if name_start < n && tokens[name_start].kind == TokenKind::LBracket {
        let close_gb = find_matching_delim(tokens, name_start)
        let added_fn_g = push_active_generics(ctx, collect_generic_param_names(tokens, name_start, close_gb))
        for gn in added_fn_g { fn_generic_names.push(gn) }
        leading_generics = lower_generic_bounds_brackets(ctx, tokens, name_start, close_gb, sf.rel_path)
        name_start = close_gb + 1
      }
      let mut name_end = name_start
      let name_sb = StringBuilder()
      while name_end < n && tokens[name_end].kind != TokenKind::LParen && tokens[name_end].kind != TokenKind::LBrace &&
      !(tokens[name_end].newline_before && is_top_level_decl_start(tokens, name_end)) {
        if tokens[name_end].kind == TokenKind::Ident {
          name_sb.write_string(rename_keyword_ident(tokens[name_end].raw))
        } else {
          name_sb.write_string(tokens[name_end].raw)
        }
        name_end = name_end + 1
      }
      let raw_fn_base = name_sb.to_string()
      let fn_name_base = if ctx.cur_is_blackbox && vis.length() == 0 && !str_has(raw_fn_base, "::") {
        match ctx.symtab.blackbox_colliding_privs.get(raw_fn_base) {
          Some(rn) => rn
          None => raw_fn_base
        }
      } else {
        raw_fn_base
      }
      let fn_name = fn_name_base + leading_generics
      if name_end < n && tokens[name_end].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, name_end)
        let (p_str, p_pre, has_opt_def) = lower_param_list(ctx, tokens, name_end, close_p, sf.rel_path, autofill_loc)
        if has_opt_def {
          ctx.migrated_opt_default_fns[fn_name] = true
        }
        let mut lb = close_p + 1
        let mut ret_str = ""
        let mut fn_has_raise = false
        if lb < n && tokens[lb].kind == TokenKind::Arrow {
          let mut r_end = lb + 1
          let mut rd = 0
          let mut test_raise_i = -1
          while r_end < n {
            let rk = tokens[r_end].kind
            if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq ||
              (tokens[r_end].newline_before && is_top_level_decl_start(tokens, r_end))) {
              break
            }
            if rd == 0 && (rk == TokenKind::Keyword || rk == TokenKind::Ident) && tokens[r_end].raw == "raise" {
              fn_has_raise = true
              if sf.is_test && test_raise_i < 0 {
                test_raise_i = r_end
              }
            }
            if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
              rd = rd + 1
            } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
              if rd > 0 { rd = rd - 1 }
            }
            r_end = r_end + 1
          }
          let ty_stop = if test_raise_i > lb { test_raise_i } else { r_end }
          ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, lb + 1, ty_stop, sf.rel_path)
          lb = r_end
        } else {
          let sig_start = lb
          let mut rd = 0
          while lb < n {
            let rk = tokens[lb].kind
            if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq ||
              (tokens[lb].newline_before && is_top_level_decl_start(tokens, lb))) {
              break
            }
            if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
              rd = rd + 1
            } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
              if rd > 0 { rd = rd - 1 }
            }
            lb = lb + 1
          }
          // In test files (`*_test.mbt` / `*_wbtest.mbt`), strip bare `raise` on test helpers
          // (assertion helpers use `panic` in Pion instead of MoonBit checked `raise`).
          let is_test_bare_raise = sf.is_test && lb > sig_start &&
          (tokens[sig_start].kind == TokenKind::Keyword || tokens[sig_start].kind == TokenKind::Ident) &&
          tokens[sig_start].raw == "raise"
          if lb > sig_start && (tokens[sig_start].kind == TokenKind::Keyword || tokens[sig_start].kind == TokenKind::Ident) &&
          tokens[sig_start].raw == "raise" {
            fn_has_raise = true
          }
          if is_test_bare_raise {
            ret_str = " -> Unit"
          } else {
            check_unsupported_error_tokens(ctx, tokens, sig_start, lb, sf.rel_path)
          }
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          if extern_prefix.length() > 0 && extern_abi != "\"C\"" {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              sf.rel_path,
              decl_line,
              decl_col,
              "unsupported non-C extern function ABI `" + extern_abi + "`",
            ))
          }
          let rb = find_matching_delim(tokens, lb)
          let (refs, calls, fn_arg_closures) = collect_init_refs_full(tokens, lb, rb + 1)
          ctx.fn_bodies.push(FnBodyRefs::{ name: fn_name, referenced_idents: refs, called_fns: calls, arg_closure_refs: fn_arg_closures })
          let saved_enclosing = ctx.cur_enclosing_fn
          let saved_ret_ty = ctx.cur_fn_ret_ty
          let saved_raising = ctx.cur_fn_is_raising
          ctx.cur_enclosing_fn = fn_name_base
          ctx.cur_fn_is_raising = fn_has_raise
          let clean_ret_ty = if ret_str.starts_with(" -> ") {
            ret_str.slice(4, ret_str.length()).trim()
          } else {
            ""
          }
          ctx.cur_fn_ret_ty = clean_ret_ty
          let saved_sc = ctx.scope_vars.length()
          let (tp_names, tp_tys, _) = extract_param_info(ctx, tokens, name_end, close_p, sf.rel_path)
          let raw_tp_names = extract_raw_param_names(tokens, name_end, close_p)
          let fn_p_renames = compute_param_renames(raw_tp_names)
          let pushed_fn_renames = fn_p_renames.length() > 0
          if pushed_fn_renames {
            ctx.ident_renames.push(fn_p_renames)
          }
          let mut tpi = 0
          while tpi < tp_names.length() {
            let raw_tp = if tpi < raw_tp_names.length() { raw_tp_names[tpi] } else { tp_names[tpi] }
            let eff_tp_name = match fn_p_renames.get(raw_tp) {
              Some(rn) => rn
              None => tp_names[tpi]
            }
            ctx.scope_vars.push(ScopeVar::{
              name: eff_tp_name,
              ty: if tpi < tp_tys.length() { tp_tys[tpi] } else { "" },
              is_mut: false,
              is_boxed: false,
            })
            tpi = tpi + 1
          }
          ctx.boxed_mut_vars.clear()
          prescan_boxed_mut_vars(tokens, lb, rb, ctx.boxed_mut_vars)
          push_expected_type(ctx, clean_ret_ty)
          let body = lower_fn_body_with_views(ctx, tokens, lb, rb, sf.rel_path, p_pre)
          pop_expected_type(ctx)
          if pushed_fn_renames {
            let _ = ctx.ident_renames.pop()
          }
          ctx.boxed_mut_vars.clear()
          restore_scope_vars(ctx, saved_sc)
          ctx.cur_enclosing_fn = saved_enclosing
          ctx.cur_fn_ret_ty = saved_ret_ty
          ctx.cur_fn_is_raising = saved_raising
          for gn in fn_generic_names {
            ctx.active_generics.remove(gn)
            ctx.symtab.active_generics.remove(gn)
          }
          let decl_code = vis + extern_prefix + "fn " + fn_name + "(" + p_str + ")" + ret_str + " " + body
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
          let anchor_start = out_sb.to_string().length()
          out_sb.write_string(decl_code)
          let anchor_end = out_sb.to_string().length()
          anchors.push(DeclAnchor::{
            source_file: sf.rel_path,
            decl_identity: "fn:" + fn_name,
            normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
            pre_overlay_generated_hash: content_sha256(decl_code),
            start_byte: anchor_start,
            end_byte: anchor_end,
            line: decl_line,
            col: decl_col,
          })
          ctx.span_map.push(SpanMapEntry::{
            src_file: sf.rel_path,
            src_start: tokens[decl_start].start_byte,
            src_end: tokens[rb].end_byte,
            src_line: decl_line,
            src_col: decl_col,
            out_file: out_rel,
            out_line: decl_line,
            out_col: decl_col,
            out_start: anchor_start,
            out_end: anchor_end,
            kind: "fn:" + fn_name,
          })
          let had_err = count_error_diags(ctx.diags) > decl_err_before
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: if had_err { "unsupported" } else { "transpiled" },
            detail: if had_err { "function contains unsupported syntax" } else { "function lowered cleanly" },
          })
          i = rb + 1
          continue
        } else if lb < n && tokens[lb].kind == TokenKind::Eq {
          let mut decl_end = find_expr_end(tokens, lb + 1, n)
          while decl_end < n && tokens[decl_end].kind == TokenKind::StringLit && !tokens[decl_end].newline_before {
            decl_end = decl_end + 1
          }
          let rhs_raw = if decl_end > lb + 1 {
            sf.content.slice(tokens[lb + 1].start_byte, tokens[decl_end - 1].end_byte).trim()
          } else {
            ""
          }
          let is_legal_c_ffi = extern_abi == "\"C\"" && decl_end == lb + 2 && tokens[lb + 1].kind == TokenKind::StringLit
          if !is_legal_c_ffi {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              sf.rel_path,
              decl_line,
              decl_col,
              "unsupported MoonBit extern/intrinsic function declaration `= ...` (requires explicit lowering or overlay)",
            ))
          } else {
            let ret_ty = if ret_str.starts_with(" -> ") {
              ret_str.slice(4, ret_str.length()).trim()
            } else {
              "Unit"
            }
            if pending_ffi_attrs.length() > 0 || !check_pion_c_abi_params(p_str) || !is_pion_c_abi_ret_type(ret_ty) {
              ctx.diags.push(diag_error(
                "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
                sf.rel_path,
                decl_line,
                decl_col,
                "extern \"C\" function `" + fn_name + "` uses non-C-ABI Pion type or unsupported MoonBit FFI attribute (requires explicit lowering or overlay)",
              ))
            }
          }
          let decl_code = if is_legal_c_ffi {
            vis + "extern \"C\" fn " + fn_name + "(" + p_str + ")" + ret_str + " = " + rhs_raw
          } else {
            vis + extern_prefix + "fn " + fn_name + "(" + p_str + ")" + ret_str + " = " + rhs_raw
          }
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
          let anchor_start = out_sb.to_string().length()
          out_sb.write_string(decl_code)
          let anchor_end = out_sb.to_string().length()
          anchors.push(DeclAnchor::{
            source_file: sf.rel_path,
            decl_identity: "fn:" + fn_name,
            normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
            pre_overlay_generated_hash: content_sha256(decl_code),
            start_byte: anchor_start,
            end_byte: anchor_end,
            line: decl_line,
            col: decl_col,
          })
          ctx.span_map.push(SpanMapEntry::{
            src_file: sf.rel_path,
            src_start: tokens[decl_start].start_byte,
            src_end: tokens[decl_end - 1].end_byte,
            src_line: decl_line,
            src_col: decl_col,
            out_file: out_rel,
            out_line: decl_line,
            out_col: decl_col,
            out_start: anchor_start,
            out_end: anchor_end,
            kind: "fn:" + fn_name,
          })
          let had_err = count_error_diags(ctx.diags) > decl_err_before
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: if had_err { "unsupported" } else { "transpiled" },
            detail: if had_err { "extern/intrinsic function requires explicit lowering or overlay" } else { "extern \"C\" function lowered cleanly" },
          })
          i = decl_end
          continue
        } else {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            sf.rel_path,
            decl_line,
            decl_col,
            "unsupported body-less function declaration `" + fn_name + "`",
          ))
          let decl_end = lb
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + src_slice)
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: "unsupported",
            detail: "body-less function declaration is unsupported",
          })
          i = decl_end
          continue
        }
      }
    }

    // --- 5b. Top-level `trait Name { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "trait" && i + 1 < n {
      let tname = tokens[i + 1].raw
      let mut trait_added_g : Array[String] = []
      if i + 2 < n && tokens[i + 2].kind == TokenKind::LBracket {
        let cgb = find_matching_delim(tokens, i + 2)
        trait_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, i + 2, cgb))
      }
      let mut lb = i + 2
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      check_unsupported_error_tokens(ctx, tokens, i + 2, lb, sf.rel_path)
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let header_extra = if lb > i + 2 {
          " " + sf.content.slice(tokens[i + 2].start_byte, tokens[lb - 1].end_byte).trim()
        } else {
          ""
        }
        let raw_body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        // Rewrite top-level trait method signatures:
        // - First param `Self` -> `self : Self`
        // - Any unnamed positional param (no top-level `:`) -> `_p<idx> : <Type>`
        // Never touches return tuples `-> (Self, Self)` or named fn-type params `f : (Self) -> Int`.
        let btoks = lex_moonbit(raw_body)
        let bn = btoks.length() - 1
        let body_sb = StringBuilder()
        let mut last_b = 0
        let mut bdepth = 0
        let mut pdepth = 0
        let mut bk = 0
        while bk < bn {
          let btk = btoks[bk]
          if btk.kind == TokenKind::LBrace {
            bdepth = bdepth + 1
          } else if btk.kind == TokenKind::RBrace {
            bdepth = bdepth - 1
          } else if btk.kind == TokenKind::LParen {
            pdepth = pdepth + 1
          } else if btk.kind == TokenKind::RParen {
            pdepth = pdepth - 1
          } else if bdepth == 1 && pdepth == 0 && btk.kind == TokenKind::Ident &&
          !(bk > 0 && (btoks[bk - 1].kind == TokenKind::Colon || btoks[bk - 1].kind == TokenKind::Arrow ||
            btoks[bk - 1].kind == TokenKind::Dot || btoks[bk - 1].kind == TokenKind::ColonColon)) &&
          bk + 1 < bn && btoks[bk + 1].kind == TokenKind::LParen {
            let lp_i = bk + 1
            let cp_i = find_matching_delim(btoks, lp_i)
            if cp_i > lp_i && cp_i < bn {
              let segs : Array[(Int, Int)] = []
              let mut si = lp_i + 1
              while si < cp_i {
                if btoks[si].kind == TokenKind::Comma { si = si + 1; continue }
                let mut se = si
                let mut sd = 0
                while se < cp_i {
                  let sk = btoks[se].kind
                  if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { sd = sd + 1 }
                  else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { sd = sd - 1 }
                  else if sd == 0 && sk == TokenKind::Comma { break }
                  se = se + 1
                }
                if se > si { segs.push((si, se)) }
                si = se + 1
              }
              let mut pi = 0
              while pi < segs.length() {
                let (ps, pe) = segs[pi]
                let mut has_top_colon = false
                let mut pk = ps
                let mut pd2 = 0
                while pk < pe {
                  let pkk = btoks[pk].kind
                  if pkk == TokenKind::LParen || pkk == TokenKind::LBracket || pkk == TokenKind::LBrace { pd2 = pd2 + 1 }
                  else if pkk == TokenKind::RParen || pkk == TokenKind::RBracket || pkk == TokenKind::RBrace { pd2 = pd2 - 1 }
                  else if pd2 == 0 && pkk == TokenKind::Colon { has_top_colon = true; break }
                  pk = pk + 1
                }
                if !has_top_colon {
                  let seg_start_b = btoks[ps].start_byte
                  let seg_end_b = btoks[pe - 1].end_byte
                  if pi == 0 && pe == ps + 1 && btoks[ps].kind == TokenKind::UpperIdent && btoks[ps].raw == "Self" {
                    body_sb.write_string(raw_body.slice(last_b, seg_start_b))
                    body_sb.write_string("self : Self")
                    last_b = seg_end_b
                  } else if !(btoks[ps].kind == TokenKind::Ident && btoks[ps].raw == "self") {
                    body_sb.write_string(raw_body.slice(last_b, seg_start_b))
                    body_sb.write_string("_p" + pi.to_string() + " : " + raw_body.slice(seg_start_b, seg_end_b))
                    last_b = seg_end_b
                  }
                }
                pi = pi + 1
              }
              bk = cp_i
            }
          }
          bk = bk + 1
        }
        body_sb.write_string(raw_body.slice(last_b, raw_body.length()))
        let body = body_sb.to_string()
        pop_active_generics(ctx, trait_added_g)
        let decl_code = vis + "trait " + tname + header_extra + " " + body
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "trait:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[rb].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: "trait:" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "trait:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "trait contains unsupported syntax" } else { "trait lowered cleanly" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 6. `test "name" { ... }` (and unnamed `test { ... }` -> deterministic `"<file>_L<line>"`) ---
    if kw.kind == TokenKind::Keyword && kw.raw == "test" {
      let mut lb = i + 1
      let mut tname = "\"" + file_id + "_L" + decl_line.to_string() + "\""
      if lb < n && tokens[lb].kind == TokenKind::StringLit {
        tname = tokens[lb].raw
        lb = lb + 1
      }
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let saved_tb = ctx.cur_in_test_block
        ctx.cur_in_test_block = true
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        ctx.cur_in_test_block = saved_tb
        let decl_code = "test " + tname + " " + body
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "test:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "test:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "test block contains unsupported syntax" } else { "test block lowered with assertions preserved" },
        })
        i = rb + 1
        continue
      }
    }

    // Fallback: emit single token/form
    out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + vis)
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, n, sf.rel_path, false)
    out_sb.write_string(piece)
    i = next_i
  }

  // Append any lifted package-private top-level functions for recursive local `fn`s (Wave M1.2 A.2)
  if ctx.lifted_fns.length() > 0 {
    out_sb.write_string("\n")
    for lf in ctx.lifted_fns {
      out_sb.write_string(lf)
      out_sb.write_string("\n")
    }
  }

  // Append trailing EOF trivia
  if tokens.length() > 0 {
    out_sb.write_string(tokens[tokens.length() - 1].leading_trivia)
  }

  GeneratedFile::{
    rel_path: out_rel,
    content: out_sb.to_string(),
    source_file: sf.rel_path,
    anchors: anchors,
  }
}

///| Generate a recursive structural equality expression for two values of type `ty`
///| (handles `Option[T]` and `Array[T]` without emitting invalid Pion `==`!).
///| Split top-level comma-separated tuple element types inside `(...)`.
fn split_tuple_types(inner : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i < inner.length() {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { depth = depth + 1 }
    else if c == 41 || c == 93 || c == 125 { if depth > 0 { depth = depth - 1 } }
    else if c == 44 && depth == 0 {
      out.push(inner.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  let tail = inner.slice(start, inner.length()).trim()
  if tail.length() > 0 { out.push(tail) }
  out
}

fn gen_eq_expr(a : String, b : String, ty : String, depth : Int, custom_eq : Map[String, String]) -> String {
  let t = ty.trim()
  match custom_eq.get(t) {
    Some(eq_fn) => return eq_fn + "(" + a + ", " + b + ")"
    None => ()
  }
  if t == "Bytes" {
    let ba = "__ba_" + depth.to_string()
    let bb = "__bb_" + depth.to_string()
    let bl = "__bl_" + depth.to_string()
    let bi = "__bi_" + depth.to_string()
    let beq = "__beq_" + depth.to_string()
    return "{ let " + ba + " = " + a + "; let " + bb + " = " + b + "; let " + bl + " = " + ba + ".length(); let mut " + beq + " = " + bl + " == " + bb + ".length(); if " + beq + " { let mut " + bi + " = 0; while " + bi + " < " + bl + " { if " + ba + "[" + bi + "] != " + bb + "[" + bi + "] { " + beq + " = false; break }; " + bi + " = " + bi + " + 1 } }; " + beq + " }"
  }
  if t == "MbtJson" || t == "mbt_compat::MbtJson" {
    return "mbt_compat::mbt_json_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("OrderedSet[") || t.starts_with("mbt_compat::OrderedSet[") {
    return "mbt_compat::ordered_set_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let ta = "__ta_" + depth.to_string()
      let tb = "__tb_" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let " + ta + " = " + a + "; let " + tb + " = " + b + "; ")
      let mut k = 0
      while k < elems.length() {
        if k > 0 { sb.write_string(" && ") }
        let ak = ta + "." + k.to_string()
        let bk = tb + "." + k.to_string()
        sb.write_string("(" + gen_eq_expr(ak, bk, elems[k], depth * 10 + k + 1, custom_eq) + ")")
        k = k + 1
      }
      sb.write_string(" }")
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ax = "__oa_" + depth.to_string()
    let bx = "__ob_" + depth.to_string()
    let inner_eq = gen_eq_expr(ax, bx, inner, depth + 1, custom_eq)
    return "match (" + a + ", " + b + ") { (Some(" + ax + "), Some(" + bx + ")) => " + inner_eq + ", (None, None) => true, _ => false }"
  }
  if t.starts_with("Result[") && t.ends_with("]") {
    let args = split_tuple_types(t.slice(7, t.length() - 1))
    if args.length() == 2 {
      let ok_a = "__ra_" + depth.to_string()
      let ok_b = "__rb_" + depth.to_string()
      let err_a = "__ea_" + depth.to_string()
      let err_b = "__eb_" + depth.to_string()
      let ok_eq = gen_eq_expr(ok_a, ok_b, args[0], depth * 2 + 1, custom_eq)
      let err_eq = gen_eq_expr(err_a, err_b, args[1], depth * 2 + 2, custom_eq)
      return "match (" + a + ", " + b + ") { (Ok(" + ok_a + "), Ok(" + ok_b + ")) => " + ok_eq + ", (Err(" + err_a + "), Err(" + err_b + ")) => " + err_eq + ", _ => false }"
    }
  }
  if (t.starts_with("Array[") || t.starts_with("FixedArray[") || t.starts_with("ImmArray[")) && t.ends_with("]") {
    let open_idx = t.index_of("[")
    let inner = t.slice(open_idx + 1, t.length() - 1).trim()
    let aa = "__aa_" + depth.to_string()
    let ab = "__ab_" + depth.to_string()
    let al = "__al_" + depth.to_string()
    let idx = "__ai_" + depth.to_string()
    let eqv = "__aeq_" + depth.to_string()
    let elem_eq = gen_eq_expr(aa + "[" + idx + "]", ab + "[" + idx + "]", inner, depth + 1, custom_eq)
    return "{ let " + aa + " = " + a + "; let " + ab + " = " + b + "; let " + al + " = " + aa + ".length(); let mut " + eqv + " = " + al + " == " + ab + ".length(); if " + eqv + " { let mut " + idx + " = 0; while " + idx + " < " + al + " { if !(" + elem_eq + ") { " + eqv + " = false; break }; " + idx + " = " + idx + " + 1 } }; " + eqv + " }"
  }
  a + " == " + b
}

fn gen_struct_eq_body(lhs : String, rhs : String, field_types : Array[(String, String)], custom_eq : Map[String, String]) -> String {
  if field_types.length() == 0 {
    return "true"
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < field_types.length() {
    if k > 0 {
      sb.write_string(" && ")
    }
    let ft = field_types[k]
    sb.write_string("(" + gen_eq_expr(lhs + "." + ft.0, rhs + "." + ft.0, ft.1, k, custom_eq) + ")")
    k = k + 1
  }
  sb.to_string()
}

fn gen_enum_eq_body(lhs : String, rhs : String, variants : Array[(String, Array[String])], custom_eq : Map[String, String]) -> String {
  if variants.length() == 0 {
    return "true"
  }
  let sb = StringBuilder()
  sb.write_string("match (" + lhs + ", " + rhs + ") {\n")
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      (." + vname + ", ." + vname + ") => true\n")
    } else {
      let la : Array[String] = []
      let ra : Array[String] = []
      let conds = StringBuilder()
      let mut k = 0
      while k < args.length() {
        let an = "__a" + k.to_string()
        let bn = "__b" + k.to_string()
        la.push(an)
        ra.push(bn)
        if k > 0 {
          conds.write_string(" && ")
        }
        conds.write_string("(" + gen_eq_expr(an, bn, args[k], k, custom_eq) + ")")
        k = k + 1
      }
      sb.write_string("      (." + vname + "(" + join_comma(la) + "), ." + vname + "(" + join_comma(ra) + ")) => " + conds.to_string() + "\n")
    }
  }
  sb.write_string("      _ => false\n    }")
  sb.to_string()
}

///| Check whether `ty` is statically hashable for `#derive(Hash)` synthesis (fail-closed on unknown/non-hashable types).
fn is_hashable_type(ty : String, hashable_types : Map[String, Bool]) -> Bool {
  let t = ty.trim()
  if t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Double" || t == "Float" || t == "Bool" || t == "Byte" ||
  t == "Char" || t == "String" || t == "Unit" {
    return true
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    return is_hashable_type(t.slice(7, t.length() - 1), hashable_types)
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    return is_hashable_type(t.slice(6, t.length() - 1), hashable_types)
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      for el in elems {
        if !is_hashable_type(el, hashable_types) {
          return false
        }
      }
      return true
    }
  }
  hashable_types.contains(strip_type_args_sym(t))
}

///| Generate a deterministic FNV-1a / mix hash expression for a value of type `ty`.
fn gen_hash_expr(v : String, ty : String, depth : Int) -> String {
  let t = ty.trim()
  if t == "Int" {
    return v
  }
  if t == "Int64" {
    return "(" + v + " ^ (" + v + " >> 32L)).to_int()"
  }
  if t == "UInt" {
    return v + ".reinterpret_as_int()"
  }
  if t == "UInt64" {
    let x = "__hu" + depth.to_string()
    return "{ let " + x + " = " + v + ".reinterpret_as_int64(); (" + x + " ^ (" + x + " >> 32L)).to_int() }"
  }
  if t == "Double" {
    return "mbt_compat::double_hash(" + v + ")"
  }
  if t == "Float" {
    return "mbt_compat::double_hash(" + v + ".to_double())"
  }
  if t == "Bool" {
    return "if " + v + " { 1 } else { 0 }"
  }
  if t == "Byte" || t == "Char" {
    return v + ".to_int()"
  }
  if t == "String" {
    return "mbt_compat::hash_string(" + v + ")"
  }
  if t == "Unit" {
    return "0"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let th = "__hth" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let mut " + th + " = -2128831035; ")
      let mut k = 0
      while k < elems.length() {
        let eh = gen_hash_expr(v + "." + k.to_string(), elems[k], depth + 1 + k)
        sb.write_string(th + " = (" + th + " ^ (" + eh + ")) * 16777619; ")
        k = k + 1
      }
      sb.write_string(th + " }")
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ov = "__ho" + depth.to_string()
    let ih = gen_hash_expr(ov, inner, depth + 1)
    return "match " + v + " { Some(" + ov + ") => ((-2128831035 ^ 1) * 16777619 ^ (" + ih + ")) * 16777619, None => 0 }"
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let ah = "__hah" + depth.to_string()
    let ai = "__hai" + depth.to_string()
    let eh = gen_hash_expr(v + "[" + ai + "]", inner, depth + 1)
    return "{ let mut " + ah + " = -2128831035; let mut " + ai + " = 0; while " + ai + " < " + v + ".length() { " + ah + " = (" + ah + " ^ (" + eh + ")) * 16777619; " + ai + " = " + ai + " + 1 }; " + ah + " }"
  }
  // Recursive trait `hash` call for nested key types
  v + ".hash()"
}

fn gen_hash_combine_stmt(v : String, ty : String, hasher : String, depth : Int) -> String {
  let t = ty.trim()
  if t == "Unit" {
    return hasher + ".combine_unit()"
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let hv = "__hv" + depth.to_string()
    return "match " + v + " { Option::None => " + hasher + ".combine_int(0), Option::Some(" + hv + ") => { " + hasher + ".combine_int(1); " + gen_hash_combine_stmt(hv, inner, hasher, depth + 1) + " } }"
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let he = "__he" + depth.to_string()
    return "for " + he + " in " + v + " { " + gen_hash_combine_stmt(he, inner, hasher, depth + 1) + " }"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let ht = "__ht" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let " + ht + " = " + v + "; ")
      let mut idx = 0
      while idx < elems.length() {
        sb.write_string(gen_hash_combine_stmt(ht + "." + idx.to_string(), elems[idx], hasher, depth + 1) + "; ")
        idx = idx + 1
      }
      sb.write_string("}")
      return sb.to_string()
    }
  }
  v + ".hash_combine(" + hasher + ")"
}

fn gen_struct_hash_combine_body(self_var : String, hasher : String, field_types : Array[(String, String)]) -> String {
  if field_types.length() == 0 {
    return "let _ = " + hasher
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < field_types.length() {
    let ft = field_types[k]
    if k > 0 { sb.write_string("\n    ") }
    sb.write_string(gen_hash_combine_stmt(self_var + "." + ft.0, ft.1, hasher, k))
    k = k + 1
  }
  sb.to_string()
}

fn gen_enum_hash_combine_body(self_var : String, hasher : String, variants : Array[(String, Array[String])]) -> String {
  if variants.length() == 0 {
    return "let _ = " + hasher
  }
  let sb = StringBuilder()
  sb.write_string("match " + self_var + " {\n")
  let mut tag = 0
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      ." + vname + " => " + hasher + ".combine_int(" + tag.to_string() + ")\n")
    } else {
      let pat_vars : Array[String] = []
      let body_sb = StringBuilder()
      body_sb.write_string("{ " + hasher + ".combine_int(" + tag.to_string() + "); ")
      let mut k = 0
      while k < args.length() {
        let vn = "__v" + k.to_string()
        pat_vars.push(vn)
        body_sb.write_string(gen_hash_combine_stmt(vn, args[k], hasher, k) + "; ")
        k = k + 1
      }
      body_sb.write_string("}")
      sb.write_string("      ." + vname + "(" + join_comma(pat_vars) + ") => " + body_sb.to_string() + "\n")
    }
    tag = tag + 1
  }
  sb.write_string("    }")
  sb.to_string()
}

fn gen_struct_hash_body(self_var : String, field_types : Array[(String, String)]) -> String {
  if field_types.length() == 0 {
    return "0"
  }
  let sb = StringBuilder()
  sb.write_string("let mut __h = -2128831035\n")
  let mut k = 0
  while k < field_types.length() {
    let ft = field_types[k]
    sb.write_string("    __h = (__h ^ (" + gen_hash_expr(self_var + "." + ft.0, ft.1, k) + ")) * 16777619\n")
    k = k + 1
  }
  sb.write_string("    mbt_compat::hash_mix(__h)")
  sb.to_string()
}

fn gen_enum_hash_body(self_var : String, variants : Array[(String, Array[String])]) -> String {
  if variants.length() == 0 {
    return "0"
  }
  let sb = StringBuilder()
  sb.write_string("match " + self_var + " {\n")
  let mut tag = 1
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      ." + vname + " => mbt_compat::hash_mix((-2128831035 ^ " + tag.to_string() + ") * 16777619)\n")
    } else {
      let pat_vars : Array[String] = []
      let body_sb = StringBuilder()
      body_sb.write_string("{ let mut __h = (-2128831035 ^ " + tag.to_string() + ") * 16777619; ")
      let mut k = 0
      while k < args.length() {
        let vn = "__v" + k.to_string()
        pat_vars.push(vn)
        body_sb.write_string("__h = (__h ^ (" + gen_hash_expr(vn, args[k], k) + ")) * 16777619; ")
        k = k + 1
      }
      body_sb.write_string("mbt_compat::hash_mix(__h) }")
      sb.write_string("      ." + vname + "(" + join_comma(pat_vars) + ") => " + body_sb.to_string() + "\n")
    }
    tag = tag + 1
  }
  sb.write_string("    }")
  sb.to_string()
}

fn join_comma(xs : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}

///| Find the exclusive end token index of a `for` / `while` loop statement starting at `start`
///| (spanning past any depth-0 `,` in `for k, v in ...` or `;` in `for i = 0; ...; ...`,
///| up to and including the loop body's closing `}` and optional `else { ... }`).
fn find_loop_stmt_end(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut lb = start + 1
  let mut pd = 0
  while lb < end {
    let lk = tokens[lb].kind
    if pd == 0 && lk == TokenKind::LBrace {
      if !(lb > start + 1 && tokens[lb - 1].kind == TokenKind::ColonColon) {
        let cb = find_matching_delim(tokens, lb)
        let next_is_multiline_cont = cb + 1 < end && tokens[cb + 1].newline_before && (
          (tokens[cb + 1].kind == TokenKind::Dot && cb + 2 < end && tokens[cb + 2].kind == TokenKind::Ident) ||
          tokens[cb + 1].kind == TokenKind::AmpAmp ||
          tokens[cb + 1].kind == TokenKind::PipePipe ||
          tokens[cb + 1].kind == TokenKind::PipeGt
        )
        let is_cond_block = cb + 1 < end && (next_is_multiline_cont || (!tokens[cb + 1].newline_before && (
          tokens[cb + 1].kind == TokenKind::LBrace ||
          tokens[cb + 1].kind == TokenKind::AmpAmp ||
          tokens[cb + 1].kind == TokenKind::PipePipe ||
          tokens[cb + 1].kind == TokenKind::EqEq ||
          tokens[cb + 1].kind == TokenKind::BangEq ||
          tokens[cb + 1].kind == TokenKind::Lt ||
          tokens[cb + 1].kind == TokenKind::LtEq ||
          tokens[cb + 1].kind == TokenKind::Gt ||
          tokens[cb + 1].kind == TokenKind::GtEq ||
          tokens[cb + 1].kind == TokenKind::Plus ||
          tokens[cb + 1].kind == TokenKind::Minus ||
          tokens[cb + 1].kind == TokenKind::Star ||
          tokens[cb + 1].kind == TokenKind::Slash ||
          tokens[cb + 1].kind == TokenKind::Percent ||
          tokens[cb + 1].kind == TokenKind::Dot ||
          tokens[cb + 1].kind == TokenKind::LBracket ||
          tokens[cb + 1].kind == TokenKind::LParen ||
          tokens[cb + 1].kind == TokenKind::PipeGt ||
          (tokens[cb + 1].kind == TokenKind::Keyword && (tokens[cb + 1].raw == "is" || tokens[cb + 1].raw == "as"))
        )))
        if is_cond_block {
          lb = cb + 1
          continue
        }
        break
      }
    }
    if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace {
      pd = pd + 1
    } else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace {
      if pd > 0 { pd = pd - 1 }
    }
    lb = lb + 1
  }
  if lb < end && tokens[lb].kind == TokenKind::LBrace {
    let mut after = find_matching_delim(tokens, lb) + 1
    if after < end && tokens[after].kind == TokenKind::Keyword && tokens[after].raw == "else" {
      if after + 1 < end && tokens[after + 1].kind == TokenKind::LBrace {
        after = find_matching_delim(tokens, after + 1) + 1
      }
    }
    return after
  }
  find_expr_end(tokens, start, end)
}

///| Conservative purity check for `match` arm `if` guard tokens `[start, end)`:
///| returns `false` if the guard contains any call, assignment, or block expression that could mutate fields.
fn guard_tokens_are_pure(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::LBrace || tk == TokenKind::Eq || tk == TokenKind::AssignOp ||
    tk == TokenKind::PipeGt || tk == TokenKind::LBracket ||
    tk == TokenKind::InterpString || tk == TokenKind::InterpMultiline {
      return false
    }
    if tk == TokenKind::LParen && k > start {
      let pk = tokens[k - 1].kind
      if pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
      pk == TokenKind::RParen || pk == TokenKind::RBracket {
        return false
      }
    }
    k = k + 1
  }
  true
}

///| Return true if any struct-pattern obligation in `obls` introduces at least one variable binder.
fn struct_pat_obls_have_binders(
  tokens : Array[Token],
  obls : Array[(String, Int, Int, String)],
) -> Bool {
  for ob in obls {
    let open_b = ob.1
    let close_b = ob.2
    let mut k = open_b + 1
    while k < close_b {
      if tokens[k].kind == TokenKind::Ident && tokens[k].raw != "_" &&
      !(k > open_b + 1 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) &&
      !(k + 1 < close_b && tokens[k + 1].kind == TokenKind::Colon) {
        return true
      }
      k = k + 1
    }
  }
  false
}

///| Check that `[start, end)` is a syntactically valid irrefutable tuple pattern `(p1, p2, ...)`
///| with >= 2 comma-separated elements whose leaves are only identifiers, `_`, or nested >= 2-tuples
///| (fail-closed on 0/1-tuples, missing commas, constructors, literals, or structs).
fn is_irrefutable_tuple_pattern(tokens : Array[Token], start : Int, end : Int) -> Bool {
  if start >= end || tokens[start].kind != TokenKind::LParen {
    return false
  }
  if find_matching_delim(tokens, start) != end - 1 {
    return false
  }
  let mut k = start + 1
  let mut elem_count = 0
  let mut expect_elem = true
  while k < end - 1 {
    let tk = tokens[k].kind
    if expect_elem {
      if tk == TokenKind::Ident || tk == TokenKind::Underscore {
        elem_count = elem_count + 1
        expect_elem = false
        k = k + 1
      } else if tk == TokenKind::LParen {
        let cp = find_matching_delim(tokens, k)
        if cp >= end - 1 || !is_irrefutable_tuple_pattern(tokens, k, cp + 1) {
          return false
        }
        elem_count = elem_count + 1
        expect_elem = false
        k = cp + 1
      } else {
        return false
      }
    } else {
      if tk != TokenKind::Comma {
        return false
      }
      expect_elem = true
      k = k + 1
    }
  }
  elem_count >= 2
}

///| Flatten a potentially nested irrefutable tuple pattern `(p1, (p2, p3))` against `rhs_var`
///| into a sequence of flat Pion `let (a, b) = v; ` statements.
fn emit_flat_tuple_let_bindings(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  rhs_var : String,
) -> String {
  let names : Array[String] = []
  let nested : Array[(String, Int, Int)] = []
  let mut k = start + 1
  while k < end - 1 {
    if tokens[k].kind == TokenKind::Comma {
      k = k + 1
      continue
    }
    if tokens[k].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, k)
      let sub_v = fresh_temp(ctx, "ft")
      names.push(sub_v)
      nested.push((sub_v, k, cp + 1))
      k = cp + 1
    } else if tokens[k].kind == TokenKind::Underscore {
      names.push("_")
      k = k + 1
    } else {
      names.push(resolve_ident_in_scope(ctx, tokens[k].raw))
      k = k + 1
    }
  }
  let sb = StringBuilder()
  sb.write_string("let (" + join_comma(names) + ") = " + rhs_var + ";")
  for sub in nested {
    sb.write_string(" " + emit_flat_tuple_let_bindings(ctx, tokens, sub.1, sub.2, sub.0))
  }
  sb.to_string()
}

///| Return true if pattern token slice `[start, end)` contains any `{` struct pattern.
fn pattern_contains_struct_pat(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    if tokens[k].kind == TokenKind::LBrace {
      return true
    }
    k = k + 1
  }
  false
}

///| Recursively replace every outermost `{ ... }` / `S::{ ... }` struct pattern inside `[start, end)`
///| with a hygienic binding variable, returning `(pion_pattern, [(bind_var, open_b, close_b, explicit_sname)])`.
fn peel_struct_patterns_in_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> (String, Array[(String, Int, Int, String)]) {
  // Reject any depth-0 or-pattern `|` at this level if any branch contains `{ ... }`:
  // peeling `{ ... }` into a fresh binding on one side of `|` produces invalid asymmetric or-patterns.
  let mut pk = start
  let mut pd = 0
  let mut has_pipe = false
  while pk < end {
    let pkk = tokens[pk].kind
    if pkk == TokenKind::LParen || pkk == TokenKind::LBracket || pkk == TokenKind::LBrace { pd = pd + 1 }
    else if pkk == TokenKind::RParen || pkk == TokenKind::RBracket || pkk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
    else if pd == 0 && pkk == TokenKind::Pipe { has_pipe = true; break }
    pk = pk + 1
  }
  if has_pipe && pattern_contains_struct_pat(tokens, start, end) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      tokens[pk].line,
      tokens[pk].col,
      "struct pattern inside nested or-pattern `|` is not supported",
    ))
    return ("", [])
  }
  let sb = StringBuilder()
  let obls : Array[(String, Int, Int, String)] = []
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, k)
      let has_as = cb + 2 < end && tokens[cb + 1].kind == TokenKind::Keyword &&
      tokens[cb + 1].raw == "as" && tokens[cb + 2].kind == TokenKind::Ident
      let bind_var = if has_as {
        resolve_ident_in_scope(ctx, tokens[cb + 2].raw)
      } else {
        let tmp = fresh_temp(ctx, "sp")
        ctx.synth_sp_temps[tmp] = true
        tmp
      }
      sb.write_string(tokens[k].leading_trivia + bind_var)
      let inferred_sname = strip_type_args_sym(current_expected_type(ctx))
      obls.push((bind_var, k, cb, inferred_sname))
      k = if has_as { cb + 3 } else { cb + 1 }
    } else if k + 2 < end && tk == TokenKind::UpperIdent &&
    tokens[k + 1].kind == TokenKind::ColonColon && tokens[k + 2].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, k + 2)
      let has_as = cb + 2 < end && tokens[cb + 1].kind == TokenKind::Keyword &&
      tokens[cb + 1].raw == "as" && tokens[cb + 2].kind == TokenKind::Ident
      let bind_var = if has_as {
        resolve_ident_in_scope(ctx, tokens[cb + 2].raw)
      } else {
        let tmp = fresh_temp(ctx, "sp")
        ctx.synth_sp_temps[tmp] = true
        tmp
      }
      sb.write_string(tokens[k].leading_trivia + bind_var)
      obls.push((bind_var, k + 2, cb, tokens[k].raw))
      k = if has_as { cb + 3 } else { cb + 1 }
    } else if tk == TokenKind::LParen {
      let cp = find_matching_delim(tokens, k)
      if pattern_contains_struct_pat(tokens, k + 1, cp) {
        let (inner_s, inner_obls) = peel_struct_patterns_in_pat(ctx, tokens, k + 1, cp, file)
        if inner_obls.length() == 0 {
          return ("", [])
        }
        sb.write_string(tokens[k].leading_trivia + "(" + inner_s + tokens[cp].leading_trivia + ")")
        for ob in inner_obls { obls.push(ob) }
        k = cp + 1
      } else {
        sb.write_string(lower_expr_range(ctx, tokens, k, cp + 1, file, true))
        k = cp + 1
      }
    } else if (tk == TokenKind::UpperIdent || tk == TokenKind::Ident) &&
    k + 1 < end && tokens[k + 1].kind == TokenKind::LParen &&
    pattern_contains_struct_pat(tokens, k + 2, find_matching_delim(tokens, k + 1)) {
      let cp = find_matching_delim(tokens, k + 1)
      sb.write_string(lower_expr_range(ctx, tokens, k, k + 1, file, true))
      let saved_sp_exp = ctx.expected_type_stack.length()
      let cur_e = current_expected_type(ctx).trim()
      if tokens[k].raw == "Some" {
        let inner_t = unwrap_option_type_str(cur_e)
        if inner_t.length() > 0 { push_expected_type(ctx, inner_t) }
      } else if tokens[k].raw == "Ok" {
        let inner_t = unwrap_result_type_str(cur_e).0
        if inner_t.length() > 0 { push_expected_type(ctx, inner_t) }
      } else if tokens[k].raw == "Err" {
        let inner_t = unwrap_result_type_str(cur_e).1
        if inner_t.length() > 0 { push_expected_type(ctx, inner_t) }
      }
      let (inner_s, inner_obls) = peel_struct_patterns_in_pat(ctx, tokens, k + 2, cp, file)
      restore_expected_type_stack(ctx, saved_sp_exp)
      if inner_obls.length() == 0 {
        return ("", [])
      }
      sb.write_string(tokens[k + 1].leading_trivia + "(" + inner_s + tokens[cp].leading_trivia + ")")
      for ob in inner_obls { obls.push(ob) }
      k = cp + 1
    } else if (tk == TokenKind::UpperIdent || tk == TokenKind::Ident) &&
    k + 3 < end && tokens[k + 1].kind == TokenKind::ColonColon &&
    tokens[k + 2].kind == TokenKind::UpperIdent && tokens[k + 3].kind == TokenKind::LParen &&
    pattern_contains_struct_pat(tokens, k + 4, find_matching_delim(tokens, k + 3)) {
      sb.write_string(lower_expr_range(ctx, tokens, k, k + 3, file, true))
      k = k + 3
    } else {
      let (piece, nk) = lower_one_token_or_form(ctx, tokens, k, end, file, true)
      sb.write_string(piece)
      k = nk
    }
  }
  (sb.to_string(), obls)
}

///| Expand peeled struct-pattern obligations recursively into `(guard_bool_expr, body_expr)`.
fn expand_struct_pat_obligations(
  ctx : StageAContext,
  tokens : Array[Token],
  obls : Array[(String, Int, Int, String)],
  idx : Int,
  file : String,
  guard_str : String,
  body_str : String,
) -> (String, String) {
  if idx >= obls.length() {
    let g = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
    return (g, body_str)
  }
  let (bind_var, open_b, close_b, explicit_sname) = obls[idx]
  let non_bind_guards : Array[String] = []
  let bind_fields : Array[(String, String)] = []
  let next_obls : Array[(String, Int, Int, String)] = []
  let mut oi = idx + 1
  while oi < obls.length() {
    next_obls.push(obls[oi])
    oi = oi + 1
  }
  let mut fi = open_b + 1
  while fi < close_b {
    if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
      fi = fi + 1
      continue
    }
    let mut fe = fi
    let mut fd = 0
    while fe < close_b {
      let fk = tokens[fe].kind
      if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
      else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
      else if fd == 0 && fk == TokenKind::Comma { break }
      fe = fe + 1
    }
    let raw_f = tokens[fi].raw
    let access_f = if explicit_sname.length() > 0 {
      rename_struct_field(ctx, explicit_sname, raw_f)
    } else {
      rename_keyword_ident(raw_f)
    }
    if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
    fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
      let fexpr = bind_var + "." + access_f
      let vs = fi + 2
      let sp_field_exp = lookup_struct_field_ty_f3d2(ctx, explicit_sname, raw_f)
      let saved_sp_fexp = ctx.expected_type_stack.length()
      if sp_field_exp.length() > 0 {
        push_expected_type(ctx, sp_field_exp)
      }
      if pattern_contains_struct_pat(tokens, vs, fe) {
        let (peeled_pat, child_obls) = peel_struct_patterns_in_pat(ctx, tokens, vs, fe, file)
        bind_fields.push((fexpr, peeled_pat.trim()))
        for cob in child_obls {
          next_obls.push(cob)
        }
      } else {
        let mut has_binder = false
        let mut bi = vs
        while bi < fe {
          if tokens[bi].kind == TokenKind::Ident &&
          !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
            has_binder = true
          }
          bi = bi + 1
        }
        if has_binder {
          let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
          bind_fields.push((fexpr, pat_s))
        } else if vs < fe {
          let vt = tokens[vs]
          if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
            vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
            non_bind_guards.push(fexpr + " == " + vt.raw)
          } else {
            let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
            if ps != "_" {
              non_bind_guards.push("(match " + fexpr + " { " + ps + " => true, _ => false })")
            }
          }
        }
      }
      restore_expected_type_stack(ctx, saved_sp_fexp)
    } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
      let bind_name = resolve_ident_in_scope(ctx, raw_f)
      bind_fields.push((bind_var + "." + access_f, bind_name))
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[fi].line,
        tokens[fi].col,
        "unsupported field pattern inside struct pattern",
      ))
    }
    fi = fe + 1
  }
  let (inner_g, inner_b) = expand_struct_pat_obligations(
    ctx,
    tokens,
    next_obls,
    0,
    file,
    guard_str,
    body_str,
  )
  let nbg_sb = StringBuilder()
  let mut ni = 0
  while ni < non_bind_guards.length() {
    if ni > 0 { nbg_sb.write_string(" && ") }
    nbg_sb.write_string(non_bind_guards[ni])
    ni = ni + 1
  }
  let fguards = nbg_sb.to_string()
  if bind_fields.length() > 0 {
    let scrut_e = if bind_fields.length() == 1 {
      bind_fields[0].0
    } else {
      let es : Array[String] = []
      for bf in bind_fields { es.push(bf.0) }
      "(" + join_comma(es) + ")"
    }
    let pat_e = if bind_fields.length() == 1 {
      bind_fields[0].1
    } else {
      let ps : Array[String] = []
      for bf in bind_fields { ps.push(bf.1) }
      "(" + join_comma(ps) + ")"
    }
    let mut all_irrefutable = true
    for bf in bind_fields {
      if !is_irrefutable_simple_pat(bf.1) {
        all_irrefutable = false
        break
      }
    }
    let full_g = if all_irrefutable && fguards.length() == 0 && inner_g == "true" {
      "true"
    } else {
      let match_g = "(match " + scrut_e + " { " + pat_e + " => " + inner_g + ", _ => false })"
      if fguards.length() > 0 { "(" + fguards + ") && " + match_g } else { match_g }
    }
    let full_b = "match " + scrut_e + " { " + pat_e + " => " + inner_b + ", _ => panic(\"unreachable\") }"
    (full_g, full_b)
  } else {
    let full_g = if fguards.length() > 0 && inner_g != "true" {
      "(" + fguards + ") && " + inner_g
    } else if fguards.length() > 0 {
      fguards
    } else {
      inner_g
    }
    (full_g, inner_b)
  }
}

///| True iff pattern token range `[s, e)` contains a `Keyword("as")` token (excluding `.. as rest` in arrays).
fn pattern_contains_as_kw_f42(tokens : Array[Token], s : Int, e : Int) -> Bool {
  let mut k = s
  while k < e {
    if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "as" &&
    !(k > s && tokens[k - 1].kind == TokenKind::DotDot) {
      return true
    }
    k = k + 1
  }
  false
}

///| True iff pattern token range `[s, e)` binds at least one lowercase identifier (excluding `_`, paths, labels).
fn pat_tokens_have_binders(tokens : Array[Token], s : Int, e : Int) -> Bool {
  let mut k = s
  while k < e {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && tk.raw != "_" &&
    !(k > s && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) &&
    !(k + 1 < e && (tokens[k + 1].kind == TokenKind::Colon || tokens[k + 1].kind == TokenKind::Eq || tokens[k + 1].kind == TokenKind::Tilde)) {
      return true
    }
    k = k + 1
  }
  false
}

///| Peel all `as <ident>` sub-patterns inside a match-arm pattern `[s, e)`, including
///| parenthesized `(pat as x)`, nested `Some(Object(_) as v)`, and `((A(v) | B(v)) as x)`.
///| Rejects `as` hidden inside an or-pattern branch (`A(1 as x) | B(2)`) fail-closed.
fn peel_as_patterns_in_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  s : Int,
  e : Int,
  file : String,
) -> (String, Array[(String, String, Bool)], Bool) {
  // 1. Peel redundant outer grouping parens `( ... )` (no top-level comma)
  let mut a = s
  let mut b = e
  while a < b && tokens[a].kind == TokenKind::LParen && find_matching_delim(tokens, a) == b - 1 &&
  !paren_has_top_level_comma(tokens, a, b - 1) {
    a = a + 1
    b = b - 1
  }
  if a >= b {
    return ("", [], false)
  }
  // 2. Check for top-level `as <ident>`, `|`, or `=` (labeled ctor arg) at `[a, b)`
  let mut top_as = -1
  let mut has_top_pipe = false
  let mut has_top_eq = false
  let mut d = 0
  let mut k = a
  while k < b {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
    else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
    else if d == 0 {
      if kk == TokenKind::Keyword && tokens[k].raw == "as" {
        top_as = k
      } else if kk == TokenKind::Pipe {
        has_top_pipe = true
      } else if kk == TokenKind::Eq {
        has_top_eq = true
      }
    }
    k = k + 1
  }
  if has_top_eq && pattern_contains_as_kw_f42(tokens, a, b) {
    return ("", [], true)
  }
  if top_as > a && top_as + 1 < b && top_as + 2 == b &&
  (tokens[top_as + 1].kind == TokenKind::Ident || tokens[top_as + 1].kind == TokenKind::Keyword) {
    let as_name = resolve_ident_in_scope(ctx, tokens[top_as + 1].raw)
    let (inner_pat, inner_obls, inner_bad) = peel_as_patterns_in_pat(ctx, tokens, a, top_as, file)
    if inner_bad {
      return ("", [], true)
    }
    let raw_inner = inner_pat.trim()
    let json_ctor_head = if raw_inner.starts_with("Object(") {
      "Object"
    } else if raw_inner.starts_with("Array(") {
      "Array"
    } else if raw_inner.starts_with("String(") {
      "String"
    } else if raw_inner.starts_with("Number(") {
      "Number"
    } else if raw_inner == "Null" {
      "Null"
    } else if raw_inner == "True" {
      "True"
    } else if raw_inner == "False" {
      "False"
    } else {
      ""
    }
    let norm_inner = if json_ctor_head.length() > 0 && !ctx.symtab.ctors.contains(json_ctor_head) {
      "mbt_compat::MbtJson::" + raw_inner
    } else {
      raw_inner
    }
    let obls : Array[(String, String, Bool)] = [(as_name, norm_inner, pat_tokens_have_binders(tokens, a, top_as))]
    for ob in inner_obls {
      obls.push(ob)
    }
    return (as_name, obls, false)
  }
  // 3. If top-level `|` contains `as` inside any branch, fail closed!
  if has_top_pipe {
    if pattern_contains_as_kw_f42(tokens, a, b) {
      return ("", [], true)
    }
    return (lower_expr_range(ctx, tokens, a, b, file, true).trim(), [], false)
  }
  // 4. Otherwise walk `[a, b)` and recursively peel `as` inside constructor/tuple `(...)` arguments
  if !pattern_contains_as_kw_f42(tokens, a, b) {
    return (lower_expr_range(ctx, tokens, a, b, file, true).trim(), [], false)
  }
  let sb = StringBuilder()
  let obls : Array[(String, String, Bool)] = []
  let mut p = a
  while p < b {
    // If `Ctor(...)` or `Pkg::Ctor(...)` contains `as` inside its `(...)`, emit only the constructor
    // prefix here so the next iteration enters the `LParen` branch and peels nested `as` arguments!
    if tokens[p].kind == TokenKind::UpperIdent || tokens[p].kind == TokenKind::Ident || tokens[p].kind == TokenKind::PkgRef {
      let mut q = p
      while q < b && (tokens[q].kind == TokenKind::UpperIdent || tokens[q].kind == TokenKind::Ident ||
        tokens[q].kind == TokenKind::PkgRef || tokens[q].kind == TokenKind::Dot || tokens[q].kind == TokenKind::ColonColon) {
        q = q + 1
      }
      if q > p && q < b && tokens[q].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, q)
        if cp < b && pattern_contains_as_kw_f42(tokens, q + 1, cp) {
          sb.write_string(lower_expr_range(ctx, tokens, p, q, file, true))
          p = q
          continue
        }
      }
    }
    if tokens[p].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, p)
      if cp < b && pattern_contains_as_kw_f42(tokens, p + 1, cp) {
        sb.write_string(tokens[p].leading_trivia + "(")
        let mut arg_s = p + 1
        let mut first_arg = true
        while arg_s < cp {
          if tokens[arg_s].kind == TokenKind::Comma { arg_s = arg_s + 1; continue }
          let mut arg_e = arg_s
          let mut ad = 0
          while arg_e < cp {
            let ak = tokens[arg_e].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { if ad > 0 { ad = ad - 1 } }
            else if ad == 0 && ak == TokenKind::Comma { break }
            arg_e = arg_e + 1
          }
          if !first_arg { sb.write_string(", ") }
          first_arg = false
          if arg_e > arg_s {
            let (ap, aobls, abad) = peel_as_patterns_in_pat(ctx, tokens, arg_s, arg_e, file)
            if abad {
              return ("", [], true)
            }
            sb.write_string(ap)
            for ob in aobls { obls.push(ob) }
          }
          arg_s = arg_e + 1
        }
        sb.write_string(")")
        p = cp + 1
        continue
      }
    }
    let (piece, next_p) = lower_one_token_or_form(ctx, tokens, p, b, file, true)
    sb.write_string(piece)
    p = next_p
  }
  (sb.to_string().trim(), obls, false)
}

///| True iff `[s, e)` contains an array pattern `[...]` AND no `as` keyword appears inside any `[...]`,
///| so patterns like `([_, _] as fs, _)` fall through to Special case C (array-pattern lowering)
///| while `[A(n) as x, ..]` is still caught fail-closed by Special case A.
fn pattern_has_array_pat_without_inner_as_f42(tokens : Array[Token], s : Int, e : Int) -> Bool {
  let mut has_lb = false
  let mut br_depth = 0
  let mut k = s
  while k < e {
    let kk = tokens[k].kind
    if kk == TokenKind::LBracket {
      has_lb = true
      br_depth = br_depth + 1
    } else if kk == TokenKind::RBracket {
      if br_depth > 0 {
        br_depth = br_depth - 1
      }
    } else if br_depth > 0 && kk == TokenKind::Keyword && tokens[k].raw == "as" {
      return false
    }
    k = k + 1
  }
  has_lb
}

///| Extract element type from `ArrayView[T]` / `mbt_compat::ArrayView[T]` (normalizing `mbt_compat::MbtJson` -> `Json`).
fn extract_array_view_elem_f42(exp_t : String) -> String {
  let lb = exp_t.index_of("[")
  if lb < 0 || !exp_t.ends_with("]") {
    return ""
  }
  let inner = exp_t.slice(lb + 1, exp_t.length() - 1).trim()
  if inner == "mbt_compat::MbtJson" || inner == "MbtJson" {
    "Json"
  } else {
    inner
  }
}

///| True iff `m` is shadowed by a method on a local user-defined type in `ctx.symtab.local_types`.
fn is_method_shadowed_f42(ctx : StageAContext, m : String) -> Bool {
  if ctx.symtab.local_types.contains("Array") || ctx.symtab.local_types.contains("ArrayView") {
    return true
  }
  let suffix = "::" + m
  for lt in ctx.symtab.local_types.keys() {
    if ctx.symtab.fn_ret_types.contains(lt + suffix) {
      return true
    }
  }
  false
}

///| True iff `m` is a strictly pure read-only method name (and not shadowed by a local type method).
fn is_pure_ro_method_f42(ctx : StageAContext, m : String) -> Bool {
  if !(m == "length" || m == "is_empty" || m == "get" || m == "contains" || m == "copy" ||
    m == "unwrap_or" || m == "is_some" || m == "is_none") {
    return false
  }
  !is_method_shadowed_f42(ctx, m)
}

///| True iff `recv_ident` is strictly read-only in its enclosing `fn`, never referenced inside
///| `for ... in recv_ident[lo:hi] { body }`, and `body` contains no index writes, indirect calls,
///| pipes, string interpolations, or unwhitelisted/shadowed calls.
fn for_slice_body_is_ro_safe_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  recv_ident : String,
  allowed_slice_lb : Int,
) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k]
    if tk.kind == TokenKind::PipeGt || tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline {
      return false
    }
    // Reject any index assignment `arr[i] = ...` inside the loop body
    if tk.kind == TokenKind::RBracket && k + 1 < end &&
    (tokens[k + 1].kind == TokenKind::Eq || tokens[k + 1].kind == TokenKind::AssignOp) {
      return false
    }
    // Reject any indirect call `f()(...)` or `arr[i](...)`
    if (tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket) &&
    k + 1 < end && tokens[k + 1].kind == TokenKind::LParen {
      return false
    }
    if tk.kind == TokenKind::Ident {
      if tk.raw == recv_ident && !(k > start && tokens[k - 1].kind == TokenKind::Dot) {
        return false
      }
      // Reject any call `f(...)` or `.m(...)` except strictly whitelisted, unshadowed pure read methods
      if k + 1 < end && tokens[k + 1].kind == TokenKind::LParen {
        let is_dot = k > start && tokens[k - 1].kind == TokenKind::Dot
        if !is_dot {
          return false
        }
        if !is_pure_ro_method_f42(ctx, tk.raw) {
          return false
        }
      }
    }
    k = k + 1
  }
  ident_is_strictly_ro_in_enclosing_fn_f42(ctx, tokens, start, recv_ident, allowed_slice_lb, 0)
}

///| Check whether token `i` is a direct argument to a same-file local call `callee(...)`, returning
///| `Some((callee_name, arg_idx))` if so.
fn direct_local_call_arg_info_f42(tokens : Array[Token], i : Int, bound_start : Int) -> Option[(String, Int)] {
  if i <= bound_start || i + 1 >= tokens.length() {
    return None
  }
  let prev_k = tokens[i - 1].kind
  let next_k = tokens[i + 1].kind
  if !(prev_k == TokenKind::LParen || prev_k == TokenKind::Comma) {
    return None
  }
  if !(next_k == TokenKind::RParen || next_k == TokenKind::Comma) {
    return None
  }
  let mut p_scan = i - 1
  let mut p_d = 0
  let mut arg_pos = 0
  let mut lp = -1
  while p_scan >= bound_start {
    let kk = tokens[p_scan].kind
    if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      p_d = p_d + 1
    } else if kk == TokenKind::LParen {
      if p_d == 0 {
        lp = p_scan
        break
      }
      p_d = p_d - 1
    } else if kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if p_d == 0 { return None }
      p_d = p_d - 1
    } else if p_d == 0 && kk == TokenKind::Comma {
      arg_pos = arg_pos + 1
    }
    p_scan = p_scan - 1
  }
  if lp >= 1 && tokens[lp - 1].kind == TokenKind::Ident &&
  !(lp >= 2 && (tokens[lp - 2].kind == TokenKind::Dot || tokens[lp - 2].kind == TokenKind::ColonColon)) {
    return Some((tokens[lp - 1].raw, arg_pos))
  }
  None
}

///| True iff `tokens[i]` (an ident `name`) is used strictly in a read-only, non-aliasing,
///| non-escaping position inside `[fn_open + 1, fn_close)`.
///| Sub-slice syntax `<name>[lo:hi]` is ONLY allowed when `i + 1 == allowed_slice_lb`.
fn ident_occ_is_strictly_ro_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  fn_open : Int,
  fn_close : Int,
  allow_let_decl : Bool,
  allowed_slice_lb : Int,
  depth : Int,
) -> Bool {
  // Form A: immutable `let <name> = ...` declaration (rejects `let mut <name>`)
  if allow_let_decl && i > fn_open && tokens[i - 1].kind == TokenKind::Keyword && tokens[i - 1].raw == "let" {
    return true
  }
  // Form B: `for x in <name>`
  if i > fn_open && tokens[i - 1].kind == TokenKind::Keyword && tokens[i - 1].raw == "in" {
    return true
  }
  // Form C: pure read-only method `<name>.<ro_method>(...)`
  if i + 3 < fn_close && tokens[i + 1].kind == TokenKind::Dot &&
  tokens[i + 2].kind == TokenKind::Ident && tokens[i + 3].kind == TokenKind::LParen &&
  is_pure_ro_method_f42(ctx, tokens[i + 2].raw) {
    return true
  }
  // Form D: read-only single-element index `<name>[idx]` (or the single authorized slice `allowed_slice_lb`).
  // Rejects sub-slices `<name>[lo:hi]` everywhere else, index writes, pipes `|>`, and non-pure methods.
  if i + 1 < fn_close && tokens[i + 1].kind == TokenKind::LBracket {
    let cb = find_matching_delim(tokens, i + 1)
    if cb > i + 1 && cb < fn_close {
      let mut is_slice_syntax = false
      let mut sk = i + 2
      let mut sd = 0
      while sk < cb {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
        else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
        else if sd == 0 && skk == TokenKind::Colon {
          is_slice_syntax = true
          break
        }
        sk = sk + 1
      }
      if is_slice_syntax && i + 1 != allowed_slice_lb {
        // Also allow immediately consumed pure read-only slices `<name>[lo:hi].contains/length/is_empty(...)`
        // or another direct call argument to a verified RO non-escaping local fn (never `let sub = ops[0:2]`!).
        let is_imm_ro_slice = allow_let_decl && cb + 3 < fn_close &&
        tokens[cb + 1].kind == TokenKind::Dot && tokens[cb + 2].kind == TokenKind::Ident &&
        tokens[cb + 3].kind == TokenKind::LParen &&
        (tokens[cb + 2].raw == "contains" || tokens[cb + 2].raw == "length" || tokens[cb + 2].raw == "is_empty") &&
        !is_method_shadowed_f42(ctx, tokens[cb + 2].raw)
        let mut is_ro_call_arg_slice = false
        if !is_imm_ro_slice && allow_let_decl && depth < 1 &&
        i > fn_open && (tokens[i - 1].kind == TokenKind::LParen || tokens[i - 1].kind == TokenKind::Comma) &&
        cb + 1 < fn_close && (tokens[cb + 1].kind == TokenKind::RParen || tokens[cb + 1].kind == TokenKind::Comma) {
          let mut ps = i - 1
          let mut pd = 0
          let mut ap = 0
          let mut clp = -1
          while ps >= fn_open {
            let pk = tokens[ps].kind
            if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd + 1 }
            else if pk == TokenKind::LParen {
              if pd == 0 { clp = ps; break }
              pd = pd - 1
            } else if pk == TokenKind::LBracket || pk == TokenKind::LBrace {
              if pd == 0 { break }
              pd = pd - 1
            } else if pd == 0 && pk == TokenKind::Comma {
              ap = ap + 1
            }
            ps = ps - 1
          }
          if clp >= 1 && tokens[clp - 1].kind == TokenKind::Ident &&
          !(clp >= 2 && (tokens[clp - 2].kind == TokenKind::Dot || tokens[clp - 2].kind == TokenKind::ColonColon)) {
            let cname = tokens[clp - 1].raw
            if callee_param_is_ro_non_escaping_f42(ctx, tokens, cname, ap, "", depth + 1) {
              is_ro_call_arg_slice = true
            }
          }
        }
        if !is_imm_ro_slice && !is_ro_call_arg_slice {
          return false
        }
      }
      if cb + 1 < fn_close && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp ||
        tokens[cb + 1].kind == TokenKind::PipeGt) {
        return false
      }
      if cb + 3 < fn_close && tokens[cb + 1].kind == TokenKind::Dot &&
      tokens[cb + 2].kind == TokenKind::Ident && tokens[cb + 3].kind == TokenKind::LParen &&
      !is_pure_ro_method_f42(ctx, tokens[cb + 2].raw) {
        return false
      }
      return true
    }
    return false
  }
  // Form E: direct argument to a same-file local fn whose corresponding parameter is strictly RO & non-escaping
  if depth < 2 {
    match direct_local_call_arg_info_f42(tokens, i, fn_open) {
      Some((callee_name, arg_pos)) =>
      if callee_param_is_ro_non_escaping_f42(ctx, tokens, callee_name, arg_pos, "", depth + 1) {
        return true
      }
      None => ()
    }
  }
  false
}

///| True iff `recv_ident` is strictly read-only, never aliased, never escaped, and never mutated
///| anywhere in its enclosing top-level `fn` (supporting `fn name`, `fn Type::method`, and `fn[T] name`).
fn ident_is_strictly_ro_in_enclosing_fn_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  pos : Int,
  recv_ident : String,
  allowed_slice_lb : Int,
  depth : Int,
) -> Bool {
  let mut fn_open = -1
  let mut k = pos
  let mut d = 0
  while k >= 0 {
    let kk = tokens[k].kind
    if kk == TokenKind::RBrace { d = d + 1 }
    else if kk == TokenKind::LBrace {
      if d == 0 {
        fn_open = k
      } else {
        d = d - 1
      }
    } else if d == 0 && kk == TokenKind::Keyword && tokens[k].raw == "fn" && fn_open >= 0 &&
    k + 1 < tokens.length() && (tokens[k + 1].kind == TokenKind::Ident ||
      tokens[k + 1].kind == TokenKind::UpperIdent || tokens[k + 1].kind == TokenKind::LBracket) {
      break
    }
    k = k - 1
  }
  if fn_open < 0 {
    return false
  }
  let fn_close = find_matching_delim(tokens, fn_open)
  if fn_close <= fn_open {
    return false
  }
  let mut i = fn_open + 1
  while i < fn_close {
    let tk = tokens[i]
    if tk.kind == TokenKind::Ident && tk.raw == recv_ident &&
    !(i > fn_open && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      if !ident_occ_is_strictly_ro_f42(ctx, tokens, i, fn_open, fn_close, true, allowed_slice_lb, depth) {
        return false
      }
    }
    i = i + 1
  }
  true
}

///| Locate top-level `fn <fn_name>(...) { ... }` in `tokens`, returning `Some((param_names, fn_lp, fn_rp, fn_open, fn_close))`.
fn find_top_level_fn_f42(tokens : Array[Token], fn_name : String) -> Option[(Array[String], Int, Int, Int, Int)] {
  let n = tokens.length()
  let mut bd = 0
  let mut fn_lp = -1
  let mut k = 0
  while k < n {
    let kk = tokens[k].kind
    if kk == TokenKind::LBrace { bd = bd + 1 }
    else if kk == TokenKind::RBrace { if bd > 0 { bd = bd - 1 } }
    else if bd == 0 && kk == TokenKind::Keyword && tokens[k].raw == "fn" {
      if k + 2 < n && tokens[k + 1].kind == TokenKind::Ident && tokens[k + 1].raw == fn_name {
        let mut scan = k + 2
        if scan < n && tokens[scan].kind == TokenKind::LBracket {
          scan = find_matching_delim(tokens, scan) + 1
        }
        if scan < n && tokens[scan].kind == TokenKind::LParen {
          fn_lp = scan
          break
        }
      }
    }
    k = k + 1
  }
  if fn_lp < 0 {
    return None
  }
  let fn_rp = find_matching_delim(tokens, fn_lp)
  if fn_rp <= fn_lp {
    return None
  }
  let param_names : Array[String] = []
  let mut ps = fn_lp + 1
  while ps < fn_rp {
    if tokens[ps].kind == TokenKind::Comma { ps = ps + 1; continue }
    let mut pe = ps
    let mut pd = 0
    while pe < fn_rp {
      let pk = tokens[pe].kind
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
      else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      else if pd == 0 && pk == TokenKind::Comma { break }
      pe = pe + 1
    }
    let mut pn_idx = ps
    while pn_idx < pe && (tokens[pn_idx].kind == TokenKind::Tilde ||
      (tokens[pn_idx].kind == TokenKind::Keyword && tokens[pn_idx].raw == "mut")) {
      pn_idx = pn_idx + 1
    }
    if pn_idx < pe && tokens[pn_idx].kind == TokenKind::Ident {
      param_names.push(tokens[pn_idx].raw)
    } else {
      param_names.push("")
    }
    ps = pe + 1
  }
  let mut fn_open = fn_rp + 1
  while fn_open < n && tokens[fn_open].kind != TokenKind::LBrace {
    fn_open = fn_open + 1
  }
  if fn_open >= n {
    return None
  }
  let fn_close = find_matching_delim(tokens, fn_open)
  if fn_close <= fn_open {
    return None
  }
  Some((param_names, fn_lp, fn_rp, fn_open, fn_close))
}

///| True iff `t` is a known built-in primitive/Json type name or a non-aliased local nominal type.
fn is_known_nominal_or_prim_f42(ctx : StageAContext, t : String) -> Bool {
  if ctx.symtab.type_aliases.contains(t) {
    return false
  }
  let is_prim = t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Double" || t == "Float" || t == "Bool" || t == "Char" ||
  t == "Byte" || t == "String" || t == "Json"
  if is_prim {
    return !ctx.symtab.local_types.contains(t)
  }
  ctx.symtab.local_types.contains(t)
}

///| True iff `tokens` declares a top-level `struct <name> { ... }` whose field types are all closed built-in types.
fn file_declares_closed_struct_f42(ctx : StageAContext, tokens : Array[Token], name : String) -> Bool {
  let n = tokens.length()
  let mut bd = 0
  let mut k = 0
  while k < n {
    let kk = tokens[k].kind
    if kk == TokenKind::LBrace { bd = bd + 1 }
    else if kk == TokenKind::RBrace { if bd > 0 { bd = bd - 1 } }
    else if bd == 0 && tokens[k].raw == "struct" && k + 1 < n &&
    tokens[k + 1].kind == TokenKind::UpperIdent && tokens[k + 1].raw == name {
      let mut sb_open = k + 2
      while sb_open < n && tokens[sb_open].kind != TokenKind::LBrace {
        if tokens[sb_open].kind == TokenKind::PkgRef {
          return false
        }
        sb_open = sb_open + 1
      }
      if sb_open >= n {
        return false
      }
      let sb_close = find_matching_delim(tokens, sb_open)
      if sb_close <= sb_open {
        return false
      }
      let mut sj = sb_open + 1
      while sj < sb_close {
        let stk = tokens[sj]
        if stk.kind == TokenKind::PkgRef {
          return false
        }
        if stk.kind == TokenKind::UpperIdent && !is_closed_builtin_ty_f42(ctx, stk.raw) {
          return false
        }
        sj = sj + 1
      }
      return true
    }
    k = k + 1
  }
  false
}

///| True iff `name` is a module-level `let` of type `Array[E]` whose element type `E` is provably
///| disjoint from `target_elem_ty` (e.g. `keyed_ats : Array[KeyedAt]` vs `Json`), rejecting type aliases
///| and cross-file or non-closed nominal structs.
fn is_disjoint_global_array_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  name : String,
  target_elem_ty : String,
) -> Bool {
  if target_elem_ty.length() == 0 {
    return false
  }
  let norm_target = if target_elem_ty == "mbt_compat::MbtJson" || target_elem_ty == "MbtJson" { "Json" } else { target_elem_ty.trim() }
  if !is_known_nominal_or_prim_f42(ctx, norm_target) {
    return false
  }
  match ctx.symtab.val_types.get(name) {
    Some(vt) => {
      let t = vt.trim()
      if t.starts_with("Array[") && t.ends_with("]") {
        let e = t.slice(6, t.length() - 1).trim()
        let norm_e = if e == "mbt_compat::MbtJson" || e == "MbtJson" { "Json" } else { e }
        if !(norm_e.length() > 0 && norm_e != norm_target && !str_has(norm_e, "Array") &&
          is_known_nominal_or_prim_f42(ctx, norm_e)) {
          return false
        }
        if ctx.symtab.local_types.contains(norm_e) && !file_declares_closed_struct_f42(ctx, tokens, norm_e) {
          return false
        }
        return true
      }
      false
    }
    None => false
  }
}

///| True iff `idx` is at a statement boundary inside `fn_close` (newline followed by `.` continues the expr).
fn is_stmt_end_f42(tokens : Array[Token], idx : Int, fn_close : Int) -> Bool {
  if idx >= fn_close || tokens[idx].kind == TokenKind::Semi || tokens[idx].kind == TokenKind::RBrace {
    return true
  }
  tokens[idx].newline_before && tokens[idx].kind != TokenKind::Dot
}

///| True iff the RHS of `let <x> [: Ty] = <rhs>` allocates a provably fresh local collection.
fn let_rhs_is_fresh_alloc_f42(ctx : StageAContext, tokens : Array[Token], rhs_start : Int, fn_close : Int) -> Bool {
  if rhs_start >= fn_close {
    return false
  }
  let tk = tokens[rhs_start]
  if tk.kind == TokenKind::LBracket {
    let cb = find_matching_delim(tokens, rhs_start)
    return cb > rhs_start && cb < fn_close && is_stmt_end_f42(tokens, cb + 1, fn_close)
  }
  if tk.kind == TokenKind::LBrace {
    let rb = find_matching_delim(tokens, rhs_start)
    if rb <= rhs_start || rb >= fn_close || !is_stmt_end_f42(tokens, rb + 1, fn_close) {
      return false
    }
    if rb == rhs_start + 1 {
      return true
    }
    if rb > rhs_start + 2 &&
    (tokens[rhs_start + 1].kind == TokenKind::StringLit || tokens[rhs_start + 1].kind == TokenKind::IntLit) &&
    tokens[rhs_start + 2].kind == TokenKind::Colon {
      return true
    }
    return false
  }
  if (tk.kind == TokenKind::UpperIdent && (tk.raw == "Map" || tk.raw == "StringBuilder")) &&
  rhs_start + 1 < fn_close && tokens[rhs_start + 1].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, rhs_start + 1)
    return rp > rhs_start + 1 && rp < fn_close && is_stmt_end_f42(tokens, rp + 1, fn_close)
  }
  if tk.kind == TokenKind::UpperIdent && (tk.raw == "Array" || tk.raw == "Map") &&
  rhs_start + 3 < fn_close && tokens[rhs_start + 1].kind == TokenKind::ColonColon &&
  tokens[rhs_start + 2].kind == TokenKind::Ident && tokens[rhs_start + 2].raw == "new" &&
  tokens[rhs_start + 3].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, rhs_start + 3)
    return rp > rhs_start + 3 && rp < fn_close && is_stmt_end_f42(tokens, rp + 1, fn_close)
  }
  let mut k = rhs_start
  let mut d = 0
  while k < fn_close {
    if k > rhs_start && d == 0 && is_stmt_end_f42(tokens, k, fn_close) {
      break
    }
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
    else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
    else if d == 0 && kk == TokenKind::Dot && k + 3 < fn_close &&
    tokens[k + 1].kind == TokenKind::Ident && tokens[k + 1].raw == "copy" &&
    !is_method_shadowed_f42(ctx, "copy") &&
    tokens[k + 2].kind == TokenKind::LParen && tokens[k + 3].kind == TokenKind::RParen {
      if is_stmt_end_f42(tokens, k + 4, fn_close) {
        return true
      }
    }
    k = k + 1
  }
  false
}

///| True iff `m` maps `k` to `true`.
fn map_bool_get_f42(m : Map[String, Bool], k : String) -> Bool {
  match m.get(k) {
    Some(b) => b
    None => false
  }
}

///| True iff `rt` is a Map/OrderedMap (or Option thereof) return type.
fn is_map_ret_type_f42(rt : String) -> Bool {
  let t = rt.trim()
  t.starts_with("Map[") || t.starts_with("OrderedMap[") || t.starts_with("mbt_compat::OrderedMap[") ||
  t.starts_with("Option[Map[") || t.starts_with("Option[OrderedMap[") || t.starts_with("Option[mbt_compat::OrderedMap[")
}

///| True iff RHS at `rhs` is a provably Map/Option[Map]-returning direct call or `if ... { Some(call(...)) } else { None }` at statement boundary.
fn is_map_rhs_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  rhs : Int,
  fn_close : Int,
  bound_scope : Array[(String, Int)],
) -> Bool {
  if rhs >= fn_close {
    return false
  }
  if tokens[rhs].kind == TokenKind::Ident && rhs + 1 < fn_close && tokens[rhs + 1].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, rhs + 1)
    if rp > rhs + 1 && rp < fn_close && is_stmt_end_f42(tokens, rp + 1, fn_close) {
      let callee = tokens[rhs].raw
      if bound_scope_has_f42(bound_scope, callee) {
        return false
      }
      match ctx.symtab.fn_ret_types.get(callee) {
        Some(rt) => return is_map_ret_type_f42(rt)
        None => return false
      }
    }
    return false
  }
  if tokens[rhs].kind == TokenKind::Keyword && tokens[rhs].raw == "if" {
    let mut lb_if = rhs + 1
    while lb_if < fn_close && tokens[lb_if].kind != TokenKind::LBrace {
      lb_if = lb_if + 1
    }
    if lb_if >= fn_close {
      return false
    }
    let rb_if = find_matching_delim(tokens, lb_if)
    if rb_if <= lb_if || rb_if + 4 >= fn_close {
      return false
    }
    if !(tokens[lb_if + 1].kind == TokenKind::UpperIdent && tokens[lb_if + 1].raw == "Some" &&
      tokens[lb_if + 2].kind == TokenKind::LParen && tokens[lb_if + 3].kind == TokenKind::Ident &&
      tokens[lb_if + 4].kind == TokenKind::LParen) {
      return false
    }
    let call_rp = find_matching_delim(tokens, lb_if + 4)
    let some_rp = find_matching_delim(tokens, lb_if + 2)
    if call_rp + 1 != some_rp || some_rp + 1 != rb_if {
      return false
    }
    // Strictly require `else { None }` ending at statement boundary
    if !(tokens[rb_if + 1].kind == TokenKind::Keyword && tokens[rb_if + 1].raw == "else" &&
      tokens[rb_if + 2].kind == TokenKind::LBrace &&
      tokens[rb_if + 3].kind == TokenKind::UpperIdent && tokens[rb_if + 3].raw == "None" &&
      tokens[rb_if + 4].kind == TokenKind::RBrace &&
      is_stmt_end_f42(tokens, rb_if + 5, fn_close)) {
      return false
    }
    let callee = tokens[lb_if + 3].raw
    if bound_scope_has_f42(bound_scope, callee) {
      return false
    }
    match ctx.symtab.fn_ret_types.get(callee) {
      Some(rt) => return is_map_ret_type_f42(rt)
      None => return false
    }
  }
  false
}

///| True iff this file or package defines a custom `impl Eq` (or `equal`/`op_equal`/`not_equal` method).
fn has_custom_eq_impl_f42(ctx : StageAContext, tokens : Array[Token]) -> Bool {
  if is_method_shadowed_f42(ctx, "equal") || is_method_shadowed_f42(ctx, "op_equal") || is_method_shadowed_f42(ctx, "not_equal") {
    return true
  }
  let n = tokens.length()
  let mut k = 0
  while k < n {
    if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "impl" {
      let mut j = k + 1
      let lim = if k + 16 < n { k + 16 } else { n }
      while j < lim && tokens[j].kind != TokenKind::LBrace {
        if tokens[j].kind == TokenKind::UpperIdent && tokens[j].raw == "Eq" {
          return true
        }
        j = j + 1
      }
    }
    k = k + 1
  }
  false
}

///| Lexical lookup in `mscope` stack `(name, depth, flag)`.
fn map_scope_lookup_f42(mscope : Array[(String, Int, Bool)], name : String) -> Bool {
  let mut idx = mscope.length() - 1
  while idx >= 0 {
    let (n, _, v) = mscope[idx]
    if n == name {
      return v
    }
    idx = idx - 1
  }
  false
}

///| Pop all entries at `depth` from `mscope`.
fn pop_scope_depth_f42(mscope : Array[(String, Int, Bool)], depth : Int) -> Unit {
  while mscope.length() > 0 {
    let (_, sd, _) = mscope[mscope.length() - 1]
    if sd != depth {
      break
    }
    let _ = mscope.pop()
  }
}

///| True iff this file contains any `impl` declaration (disables RO_VIEW lowering when custom traits exist).
fn has_any_impl_f42(tokens : Array[Token]) -> Bool {
  let n = tokens.length()
  let mut k = 0
  while k < n {
    if tokens[k].raw == "impl" {
      return true
    }
    k = k + 1
  }
  false
}

///| True iff `t` is in the closed built-in type whitelist and not shadowed by local types or aliases.
fn is_closed_builtin_ty_f42(ctx : StageAContext, t : String) -> Bool {
  if ctx.symtab.local_types.contains(t) || ctx.symtab.type_aliases.contains(t) {
    return false
  }
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Double" || t == "Float" || t == "Bool" || t == "Char" ||
  t == "Byte" || t == "String" || t == "Json" || t == "Unit" ||
  t == "Array" || t == "ArrayView" || t == "Map" || t == "Option"
}

///| Lexical lookup in `bscope` stack `(name, depth)` of all bound locals and parameters.
fn bound_scope_has_f42(bscope : Array[(String, Int)], name : String) -> Bool {
  let mut idx = bscope.length() - 1
  while idx >= 0 {
    let (n, _) = bscope[idx]
    if n == name {
      return true
    }
    idx = idx - 1
  }
  false
}

///| Pop all entries at `depth` from `bscope`.
fn pop_bound_depth_f42(bscope : Array[(String, Int)], depth : Int) -> Unit {
  while bscope.length() > 0 {
    let (_, sd) = bscope[bscope.length() - 1]
    if sd != depth {
      break
    }
    let _ = bscope.pop()
  }
}

///| True iff `fn_name` and every same-file function transitively reachable from it performs NO
///| non-fresh array mutations (closed-world built-in types, zero `impl`, zero `@dep`, zero default args).
fn fn_has_no_nonfresh_mutation_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  fn_name : String,
  target_elem_ty : String,
  inline_closure_params : Map[String, Bool],
  visited : Map[String, Bool],
) -> Bool {
  if has_any_impl_f42(tokens) {
    return false
  }
  let mut visit_key = fn_name + "|"
  for ic in inline_closure_params.keys() {
    if map_bool_get_f42(inline_closure_params, ic) {
      visit_key = visit_key + ic + ","
    }
  }
  if visited.contains(visit_key) {
    return true
  }
  visited[visit_key] = true
  let (param_names, fn_lp, fn_rp, fn_open, fn_close) = match find_top_level_fn_f42(tokens, fn_name) {
    Some(info) => info
    None => return false
  }
  // Signature closed-world gate: reject default param exprs (`=`), external `@dep` types, and non-builtin types.
  let mut sk = fn_lp
  while sk < fn_open {
    let stk = tokens[sk]
    if sk > fn_lp && sk < fn_rp && stk.kind == TokenKind::Eq {
      return false
    }
    if stk.kind == TokenKind::PkgRef {
      return false
    }
    if stk.kind == TokenKind::UpperIdent && !is_closed_builtin_ty_f42(ctx, stk.raw) {
      return false
    }
    sk = sk + 1
  }
  let has_custom_eq = has_custom_eq_impl_f42(ctx, tokens)
  // Pass 1: collect all reassigned variable names anywhere in the function body.
  let reassigned : Map[String, Bool] = Map()
  let mut p = fn_open + 1
  while p < fn_close {
    let tk = tokens[p]
    if tk.kind == TokenKind::Ident && p + 1 < fn_close &&
    (tokens[p + 1].kind == TokenKind::Eq || tokens[p + 1].kind == TokenKind::AssignOp) &&
    !(p > fn_open && tokens[p - 1].kind == TokenKind::Keyword && (tokens[p - 1].raw == "let" || tokens[p - 1].raw == "mut")) {
      reassigned[tk.raw] = true
    }
    p = p + 1
  }
  // Pass 2: single lexical walk with depth-tracked stacks for bound names, fresh locals, closures, and maps.
  let bound_scope : Array[(String, Int)] = []
  for pn in param_names {
    if pn.length() > 0 {
      bound_scope.push((pn, 0))
    }
  }
  let fresh_scope : Array[(String, Int, Bool)] = []
  let closure_scope : Array[(String, Int, Bool)] = []
  for ic in inline_closure_params.keys() {
    if map_bool_get_f42(inline_closure_params, ic) {
      closure_scope.push((ic, 0, true))
    }
  }
  let map_scope : Array[(String, Int, Bool)] = []
  let mut bdepth = 0
  let mut i = fn_open + 1
  while i < fn_close {
    let tk = tokens[i]
    if tk.kind == TokenKind::PkgRef {
      return false
    }
    if tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline ||
    (tk.kind == TokenKind::StringLit && str_has(tk.raw, "\\{")) {
      return false
    }
    if tk.kind == TokenKind::UpperIdent && ctx.symtab.local_types.contains(tk.raw) {
      return false
    }
    if tk.kind == TokenKind::LBrace {
      // Reject anonymous struct literals `{ ident: ... }` / `{ ident, ... }` unless directly passed to `<disjoint_global>.push(...)`
      if i + 2 < fn_close && tokens[i + 1].kind == TokenKind::Ident &&
      (tokens[i + 2].kind == TokenKind::Colon || tokens[i + 2].kind == TokenKind::Comma) {
        let ok_disjoint_push = i >= 4 &&
        tokens[i - 1].kind == TokenKind::LParen &&
        tokens[i - 2].kind == TokenKind::Ident && tokens[i - 2].raw == "push" &&
        tokens[i - 3].kind == TokenKind::Dot &&
        tokens[i - 4].kind == TokenKind::Ident &&
        !bound_scope_has_f42(bound_scope, tokens[i - 4].raw) &&
        is_disjoint_global_array_f42(ctx, tokens, tokens[i - 4].raw, target_elem_ty)
        if !ok_disjoint_push {
          return false
        }
      }
      bdepth = bdepth + 1
    } else if tk.kind == TokenKind::RBrace {
      pop_bound_depth_f42(bound_scope, bdepth)
      pop_scope_depth_f42(fresh_scope, bdepth)
      pop_scope_depth_f42(closure_scope, bdepth)
      pop_scope_depth_f42(map_scope, bdepth)
      if bdepth > 0 { bdepth = bdepth - 1 }
    }
    // `let [mut] <v> [: Ty] = <rhs>` or destructuring `let <pat> = <rhs>`: push lexical entries at `bdepth`
    if tk.kind == TokenKind::Keyword && tk.raw == "let" && i + 2 < fn_close {
      let is_mut = tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut"
      let v_idx = if is_mut { i + 2 } else { i + 1 }
      let is_simple_let = v_idx + 1 < fn_close && tokens[v_idx].kind == TokenKind::Ident &&
      (tokens[v_idx + 1].kind == TokenKind::Eq || tokens[v_idx + 1].kind == TokenKind::Colon)
      if is_simple_let {
        let vname = tokens[v_idx].raw
        let mut eq_idx = v_idx + 1
        let mut ld = 0
        while eq_idx < fn_close {
          let ek = tokens[eq_idx].kind
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ld = ld + 1 }
          else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if ld > 0 { ld = ld - 1 } }
          else if ld == 0 && ek == TokenKind::Eq { break }
          else if ld == 0 && (tokens[eq_idx].newline_before || ek == TokenKind::Semi) { eq_idx = -1; break }
          eq_idx = eq_idx + 1
        }
        if eq_idx > v_idx && eq_idx + 1 < fn_close {
          let rhs = eq_idx + 1
          let mut rhs_refs_self = false
          let mut rk = rhs
          let mut rd = 0
          while rk < fn_close {
            let rtk = tokens[rk]
            if rd == 0 && rk > rhs && (rtk.kind == TokenKind::Semi || (rtk.newline_before && rtk.kind != TokenKind::Dot)) {
              break
            }
            if rtk.kind == TokenKind::LParen || rtk.kind == TokenKind::LBracket || rtk.kind == TokenKind::LBrace {
              rd = rd + 1
            } else if rtk.kind == TokenKind::RParen || rtk.kind == TokenKind::RBracket || rtk.kind == TokenKind::RBrace {
              if rd == 0 { break }
              rd = rd - 1
            } else if rtk.kind == TokenKind::Ident && rtk.raw == vname &&
            !(rk > rhs && (tokens[rk - 1].kind == TokenKind::Dot || tokens[rk - 1].kind == TokenKind::ColonColon)) {
              rhs_refs_self = true
            }
            rk = rk + 1
          }
          if rhs_refs_self && ctx.symtab.val_types.contains(vname) {
            return false
          }
          let can_trust = !is_mut && !reassigned.contains(vname) && !rhs_refs_self
          let is_fn_rhs = tokens[rhs].kind == TokenKind::Keyword && tokens[rhs].raw == "fn"
          let is_fresh_rhs = !is_fn_rhs && let_rhs_is_fresh_alloc_f42(ctx, tokens, rhs, fn_close)
          let is_map_rhs = is_map_rhs_f42(ctx, tokens, rhs, fn_close, bound_scope)
          bound_scope.push((vname, bdepth))
          fresh_scope.push((vname, bdepth, can_trust && is_fresh_rhs))
          closure_scope.push((vname, bdepth, can_trust && is_fn_rhs))
          map_scope.push((vname, bdepth, can_trust && is_map_rhs))
        }
      } else {
        // Destructuring `let <pat> = <rhs>`: shadow every pattern identifier at `bdepth` as untrusted (`false`)
        let mut eq_idx = i + 1
        let mut ld = 0
        while eq_idx < fn_close {
          let ek = tokens[eq_idx].kind
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ld = ld + 1 }
          else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { if ld > 0 { ld = ld - 1 } }
          else if ld == 0 && ek == TokenKind::Eq { break }
          else if ld == 0 && (tokens[eq_idx].newline_before || ek == TokenKind::Semi) { eq_idx = -1; break }
          eq_idx = eq_idx + 1
        }
        if eq_idx > i + 1 {
          let mut pk = i + 1
          while pk < eq_idx {
            if tokens[pk].kind == TokenKind::Ident &&
            !(pk > i + 1 && (tokens[pk - 1].kind == TokenKind::Dot || tokens[pk - 1].kind == TokenKind::ColonColon)) {
              let bn = tokens[pk].raw
              bound_scope.push((bn, bdepth))
              fresh_scope.push((bn, bdepth, false))
              closure_scope.push((bn, bdepth, false))
              map_scope.push((bn, bdepth, false))
            }
            pk = pk + 1
          }
        }
      }
    }
    // `if`/`guard`/`while` `... is <pat>`: shadow every pattern identifier at `bdepth` as untrusted (`false`)
    if (tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident) && tk.raw == "is" && i + 1 < fn_close {
      let mut pk = i + 1
      let mut pd = 0
      while pk < fn_close {
        let ptk = tokens[pk]
        if pd == 0 {
          if ptk.kind == TokenKind::Semi || ptk.kind == TokenKind::AmpAmp || ptk.kind == TokenKind::PipePipe ||
          (ptk.kind == TokenKind::Keyword && ptk.raw == "else") ||
          (pk > i + 1 && ptk.newline_before) {
            break
          }
          if ptk.kind == TokenKind::LBrace && pk > i + 1 &&
          tokens[pk - 1].kind != TokenKind::Pipe && tokens[pk - 1].kind != TokenKind::LParen &&
          tokens[pk - 1].kind != TokenKind::Comma && tokens[pk - 1].kind != TokenKind::Colon {
            break
          }
        }
        if ptk.kind == TokenKind::LParen || ptk.kind == TokenKind::LBracket || ptk.kind == TokenKind::LBrace {
          pd = pd + 1
        } else if ptk.kind == TokenKind::RParen || ptk.kind == TokenKind::RBracket || ptk.kind == TokenKind::RBrace {
          if pd == 0 { break }
          pd = pd - 1
        } else if ptk.kind == TokenKind::Ident &&
        !(pk > i + 1 && (tokens[pk - 1].kind == TokenKind::Dot || tokens[pk - 1].kind == TokenKind::ColonColon)) {
          let bn = ptk.raw
          bound_scope.push((bn, bdepth))
          fresh_scope.push((bn, bdepth, false))
          closure_scope.push((bn, bdepth, false))
          map_scope.push((bn, bdepth, false))
        }
        pk = pk + 1
      }
    }
    // `for <v1> [, <v2>] in ... {`: shadow loop binders at `bdepth + 1`
    if tk.kind == TokenKind::Keyword && tk.raw == "for" {
      let mut fk = i + 1
      while fk < fn_close && !(tokens[fk].kind == TokenKind::Keyword && tokens[fk].raw == "in") &&
      tokens[fk].kind != TokenKind::LBrace && tokens[fk].kind != TokenKind::Semi {
        if tokens[fk].kind == TokenKind::Ident {
          let bn = tokens[fk].raw
          bound_scope.push((bn, bdepth + 1))
          fresh_scope.push((bn, bdepth + 1, false))
          closure_scope.push((bn, bdepth + 1, false))
          map_scope.push((bn, bdepth + 1, false))
        }
        fk = fk + 1
      }
    }
    // Local function or inline closure `fn [name] ( <params> )` or `fn { <pat> => ... }`: shadow binders at `bdepth + 1`
    if tk.kind == TokenKind::Keyword && tk.raw == "fn" {
      let mut fn_lp = i + 1
      if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::Ident {
        let local_fn_nm = tokens[fn_lp].raw
        bound_scope.push((local_fn_nm, bdepth))
        fresh_scope.push((local_fn_nm, bdepth, false))
        closure_scope.push((local_fn_nm, bdepth, false))
        map_scope.push((local_fn_nm, bdepth, false))
        fn_lp = fn_lp + 1
      }
      if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::LBrace {
        let fc = find_matching_delim(tokens, fn_lp)
        let mut fp = fn_lp + 1
        let mut fd = 0
        let mut in_pat = true
        let mut arrow_pos = -2
        while fp < fc {
          let fk = tokens[fp].kind
          if fd == 0 && fk == TokenKind::FatArrow {
            in_pat = false
            arrow_pos = fp
          } else if fd == 0 && !in_pat && fp > arrow_pos + 1 && (tokens[fp].newline_before || fk == TokenKind::Semi) {
            in_pat = true
          }
          if in_pat && fk == TokenKind::Ident &&
          !(fp + 1 < fc && tokens[fp + 1].kind == TokenKind::LParen) &&
          !(fp > fn_lp && (tokens[fp - 1].kind == TokenKind::Dot || tokens[fp - 1].kind == TokenKind::ColonColon)) {
            let bn = tokens[fp].raw
            bound_scope.push((bn, bdepth + 1))
            fresh_scope.push((bn, bdepth + 1, false))
            closure_scope.push((bn, bdepth + 1, false))
            map_scope.push((bn, bdepth + 1, false))
          }
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { if fd > 0 { fd = fd - 1 } }
          fp = fp + 1
        }
      } else if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, fn_lp)
        if cp > fn_lp && cp < fn_close {
          let mut ps = fn_lp + 1
          while ps < cp {
            if tokens[ps].kind == TokenKind::Comma { ps = ps + 1; continue }
            let mut pe = ps
            let mut pd = 0
            while pe < cp {
              let pk = tokens[pe].kind
              if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
              else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
              else if pd == 0 && pk == TokenKind::Comma { break }
              pe = pe + 1
            }
            if ps < pe && tokens[ps].kind == TokenKind::Ident {
              let pn = tokens[ps].raw
              bound_scope.push((pn, bdepth + 1))
              fresh_scope.push((pn, bdepth + 1, false))
              closure_scope.push((pn, bdepth + 1, false))
              map_scope.push((pn, bdepth + 1, false))
            }
            ps = pe + 1
          }
        }
      }
    }
    // Single-param `<ident> => ...` or multi-param `(a, b) => ...` arrow closure: reject if any param shadows a trusted local, global, or local fn
    if tk.kind == TokenKind::Ident && i + 1 < fn_close && tokens[i + 1].kind == TokenKind::FatArrow {
      let pn = tk.raw
      if map_scope_lookup_f42(fresh_scope, pn) || map_scope_lookup_f42(closure_scope, pn) || map_scope_lookup_f42(map_scope, pn) ||
      ctx.symtab.val_types.contains(pn) || ctx.symtab.local_fn_names.contains(pn) {
        return false
      }
      bound_scope.push((pn, bdepth))
    } else if tk.kind == TokenKind::RParen && i + 1 < fn_close && tokens[i + 1].kind == TokenKind::FatArrow {
      let mut lp = i - 1
      let mut pd = 1
      while lp > fn_open && pd > 0 {
        if tokens[lp].kind == TokenKind::RParen { pd = pd + 1 }
        else if tokens[lp].kind == TokenKind::LParen { pd = pd - 1 }
        if pd > 0 { lp = lp - 1 }
      }
      if pd == 0 && !(lp > fn_open && tokens[lp - 1].kind == TokenKind::UpperIdent) {
        let mut pk = lp + 1
        while pk < i {
          if tokens[pk].kind == TokenKind::Ident &&
          !(pk > lp + 1 && (tokens[pk - 1].kind == TokenKind::Dot || tokens[pk - 1].kind == TokenKind::ColonColon)) {
            let pn = tokens[pk].raw
            if map_scope_lookup_f42(fresh_scope, pn) || map_scope_lookup_f42(closure_scope, pn) || map_scope_lookup_f42(map_scope, pn) ||
            ctx.symtab.val_types.contains(pn) || ctx.symtab.local_fn_names.contains(pn) {
              return false
            }
            bound_scope.push((pn, bdepth))
          }
          pk = pk + 1
        }
      }
    }
    // `match <scrut> { ... }`: bind pattern variables at `bdepth + 1` (only `Some(m)` on a map_scope scrutinee gets map=true)
    if tk.kind == TokenKind::Keyword && tk.raw == "match" && i + 2 < fn_close {
      let mut mb_open = i + 1
      while mb_open < fn_close && tokens[mb_open].kind != TokenKind::LBrace {
        mb_open = mb_open + 1
      }
      if mb_open < fn_close {
        let scrut_is_map = i + 2 == mb_open && tokens[i + 1].kind == TokenKind::Ident && map_scope_lookup_f42(map_scope, tokens[i + 1].raw)
        let mc = find_matching_delim(tokens, mb_open)
        let mut mp = mb_open + 1
        let mut md = 0
        let mut in_pat = true
        let mut arrow_pos = -2
        while mp < mc {
          let mk = tokens[mp].kind
          if md == 0 && mk == TokenKind::FatArrow {
            in_pat = false
            arrow_pos = mp
          } else if md == 0 && !in_pat && mp > arrow_pos + 1 && (tokens[mp].newline_before || mk == TokenKind::Semi) {
            in_pat = true
          }
          if in_pat {
            if scrut_is_map && mk == TokenKind::UpperIdent && tokens[mp].raw == "Some" &&
            mp + 3 < mc && tokens[mp + 1].kind == TokenKind::LParen &&
            tokens[mp + 2].kind == TokenKind::Ident && tokens[mp + 3].kind == TokenKind::RParen {
              let mn = tokens[mp + 2].raw
              let mut mn_in_outer = ctx.symtab.val_types.contains(mn)
              for pn in param_names {
                if pn == mn { mn_in_outer = true }
              }
              for entry in fresh_scope {
                let (en, _, _) = entry
                if en == mn { mn_in_outer = true }
              }
              for entry in closure_scope {
                let (en, _, _) = entry
                if en == mn { mn_in_outer = true }
              }
              for entry in map_scope {
                let (en, _, _) = entry
                if en == mn { mn_in_outer = true }
              }
              bound_scope.push((mn, bdepth + 1))
              fresh_scope.push((mn, bdepth + 1, false))
              closure_scope.push((mn, bdepth + 1, false))
              map_scope.push((mn, bdepth + 1, !reassigned.contains(mn) && !mn_in_outer))
              mp = mp + 4
              continue
            } else if mk == TokenKind::Ident &&
            !(mp + 1 < mc && tokens[mp + 1].kind == TokenKind::LParen) &&
            !(mp > mb_open && (tokens[mp - 1].kind == TokenKind::Dot || tokens[mp - 1].kind == TokenKind::ColonColon)) {
              let bn = tokens[mp].raw
              bound_scope.push((bn, bdepth + 1))
              fresh_scope.push((bn, bdepth + 1, false))
              closure_scope.push((bn, bdepth + 1, false))
              map_scope.push((bn, bdepth + 1, false))
            }
          }
          if mk == TokenKind::LParen || mk == TokenKind::LBracket || mk == TokenKind::LBrace { md = md + 1 }
          else if mk == TokenKind::RParen || mk == TokenKind::RBracket || mk == TokenKind::RBrace { if md > 0 { md = md - 1 } }
          mp = mp + 1
        }
      }
    }
    // Reject free references to non-builtin / non-disjoint module globals; restrict disjoint global array use sites
    if tk.kind == TokenKind::Ident &&
    !(i > fn_open && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
    !bound_scope_has_f42(bound_scope, tk.raw) && !ctx.symtab.local_fn_names.contains(tk.raw) {
      match ctx.symtab.val_types.get(tk.raw) {
        Some(vt) =>
        if is_closed_builtin_ty_f42(ctx, vt.trim()) {
          ()
        } else if is_disjoint_global_array_f42(ctx, tokens, tk.raw, target_elem_ty) {
          let is_allowed_method = if i + 3 < fn_close &&
          tokens[i + 1].kind == TokenKind::Dot &&
          tokens[i + 2].kind == TokenKind::Ident &&
          tokens[i + 3].kind == TokenKind::LParen {
            let gm = tokens[i + 2].raw
            if gm == "length" || gm == "push" || gm == "clear" {
              true
            } else if gm == "remove" || gm == "pop" {
              let prev_k = if i > fn_open + 1 { tokens[i - 1].kind } else { TokenKind::Semi }
              let at_stmt_start = i == fn_open + 1 ||
              prev_k == TokenKind::LBrace || prev_k == TokenKind::Semi ||
              (tk.newline_before &&
                (prev_k == TokenKind::RBrace || prev_k == TokenKind::RParen ||
                  prev_k == TokenKind::RBracket || prev_k == TokenKind::Ident ||
                  prev_k == TokenKind::UpperIdent || prev_k == TokenKind::IntLit ||
                  prev_k == TokenKind::FloatLit || prev_k == TokenKind::StringLit ||
                  prev_k == TokenKind::CharLit))
              let call_rp = find_matching_delim(tokens, i + 3)
              at_stmt_start && call_rp > i + 3 && call_rp + 2 < fn_close &&
              tokens[call_rp + 1].kind == TokenKind::PipeGt &&
              tokens[call_rp + 2].kind == TokenKind::Ident && tokens[call_rp + 2].raw == "ignore"
            } else {
              false
            }
          } else {
            false
          }
          let is_allowed_for = i >= fn_open + 2 &&
          tokens[i - 1].kind == TokenKind::Keyword && tokens[i - 1].raw == "in" &&
          tokens[i - 2].kind == TokenKind::Ident &&
          i + 1 < fn_close && tokens[i + 1].kind == TokenKind::LBrace
          if is_allowed_for {
            let lv = tokens[i - 2].raw
            let lc = find_matching_delim(tokens, i + 1)
            let mut lk = i + 2
            while lk < lc {
              if tokens[lk].kind == TokenKind::Ident && tokens[lk].raw == lv &&
              !(lk > i + 1 && (tokens[lk - 1].kind == TokenKind::Dot || tokens[lk - 1].kind == TokenKind::ColonColon)) {
                let is_field_read = lk + 2 < lc &&
                tokens[lk + 1].kind == TokenKind::Dot &&
                tokens[lk + 2].kind == TokenKind::Ident &&
                !(lk + 3 < lc && tokens[lk + 3].kind == TokenKind::LParen)
                if !is_field_read {
                  return false
                }
              }
              lk = lk + 1
            }
          } else if !is_allowed_method {
            return false
          }
        } else {
          return false
        }
        None => ()
      }
    }
    if (tk.kind == TokenKind::EqEq || tk.kind == TokenKind::BangEq) && has_custom_eq {
      return false
    }
    if (tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket) &&
    i + 1 < fn_close && tokens[i + 1].kind == TokenKind::LParen {
      return false
    }
    if tk.kind == TokenKind::PipeGt {
      if !(i + 1 < fn_close && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 1].raw == "ignore" &&
        !bound_scope_has_f42(bound_scope, "ignore") && !ctx.symtab.local_fn_names.contains("ignore")) {
        return false
      }
    }
    if tk.kind == TokenKind::LBracket {
      let cb = find_matching_delim(tokens, i)
      if cb > i && cb + 1 < fn_close &&
      (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
        if i > fn_open && tokens[i - 1].kind == TokenKind::UpperIdent && tokens[cb + 1].kind == TokenKind::Eq {
          i = i + 1
          continue
        }
        if !(i > fn_open && tokens[i - 1].kind == TokenKind::Ident &&
          !(i >= 2 && (tokens[i - 2].kind == TokenKind::Dot || tokens[i - 2].kind == TokenKind::ColonColon))) {
          return false
        }
        let r = tokens[i - 1].raw
        if !(map_scope_lookup_f42(fresh_scope, r) || map_scope_lookup_f42(map_scope, r) ||
          (!bound_scope_has_f42(bound_scope, r) && is_disjoint_global_array_f42(ctx, tokens, r, target_elem_ty))) {
          return false
        }
      }
    }
    if tk.kind == TokenKind::Ident && i + 1 < fn_close && tokens[i + 1].kind == TokenKind::LParen {
      if i > fn_open && tokens[i - 1].kind == TokenKind::Dot {
        let m = tk.raw
        if is_pure_ro_method_f42(ctx, m) ||
        ((m == "stringify" || m == "to_string" || m == "to_int" || m == "to_double" || m == "floor") &&
          !is_method_shadowed_f42(ctx, m)) {
          ()
        } else if m == "map" && !is_method_shadowed_f42(ctx, "map") {
          if !(i + 2 < fn_close && tokens[i + 2].kind == TokenKind::Keyword && tokens[i + 2].raw == "fn") {
            return false
          }
        } else {
          let is_pure_container_mut = (m == "push" || m == "pop" || m == "insert" || m == "remove" ||
            m == "clear" || m == "set" || m == "swap" || m == "reverse" || m == "truncate" || m == "resize") &&
          !is_method_shadowed_f42(ctx, m)
          if !is_pure_container_mut {
            return false
          }
          if !(i >= 2 && tokens[i - 2].kind == TokenKind::Ident &&
            !(i >= 3 && (tokens[i - 3].kind == TokenKind::Dot || tokens[i - 3].kind == TokenKind::ColonColon))) {
            return false
          }
          let r = tokens[i - 2].raw
          if !(map_scope_lookup_f42(fresh_scope, r) || map_scope_lookup_f42(map_scope, r) ||
            (!bound_scope_has_f42(bound_scope, r) && is_disjoint_global_array_f42(ctx, tokens, r, target_elem_ty))) {
            return false
          }
        }
      } else if i >= 2 && tokens[i - 1].kind == TokenKind::ColonColon {
        let q = tokens[i - 2].raw
        let m = tk.raw
        let ok_qual = (q == "Json" && (m == "array" || m == "object" || m == "null" || m == "number" || m == "string" || m == "boolean")) ||
        ((q == "Array" || q == "Map") && m == "new")
        if !ok_qual {
          return false
        }
      } else {
        let g = tk.raw
        if ((g == "ignore" || g == "physical_equal") &&
          !bound_scope_has_f42(bound_scope, g) && !ctx.symtab.local_fn_names.contains(g)) ||
        map_scope_lookup_f42(closure_scope, g) {
          ()
        } else if !bound_scope_has_f42(bound_scope, g) && ctx.symtab.local_fn_names.contains(g) {
          let call_rp = find_matching_delim(tokens, i + 1)
          let child_inline : Map[String, Bool] = Map()
          match find_top_level_fn_f42(tokens, g) {
            Some((g_params, _, _, _, _)) => {
              let mut as_idx = i + 2
              let mut a_pos = 0
              while as_idx < call_rp {
                if tokens[as_idx].kind == TokenKind::Comma { as_idx = as_idx + 1; continue }
                let mut ae = as_idx
                let mut ad = 0
                while ae < call_rp {
                  let ak = tokens[ae].kind
                  if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
                  else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { if ad > 0 { ad = ad - 1 } }
                  else if ad == 0 && ak == TokenKind::Comma { break }
                  ae = ae + 1
                }
                let is_inline_fn = (as_idx < ae && tokens[as_idx].kind == TokenKind::Keyword && tokens[as_idx].raw == "fn") ||
                (as_idx + 1 == ae && tokens[as_idx].kind == TokenKind::Ident && map_scope_lookup_f42(closure_scope, tokens[as_idx].raw))
                if is_inline_fn && a_pos < g_params.length() && g_params[a_pos].length() > 0 {
                  child_inline[g_params[a_pos]] = true
                }
                a_pos = a_pos + 1
                as_idx = ae + 1
              }
            }
            None => return false
          }
          if !fn_has_no_nonfresh_mutation_f42(ctx, tokens, g, target_elem_ty, child_inline, visited) {
            return false
          }
        } else {
          return false
        }
      }
    }
    i = i + 1
  }
  true
}

///| True iff `callee_name` is a same-file top-level `fn` whose `arg_pos`-th parameter is strictly
///| read-only and non-escaping (zero index writes, zero sub-slices, zero mutating methods, zero
///| aliasing/return/storage), and whose transitive call graph performs no non-fresh array mutations.
fn callee_param_is_ro_non_escaping_f42(
  ctx : StageAContext,
  tokens : Array[Token],
  callee_name : String,
  arg_pos : Int,
  target_elem_ty : String,
  depth : Int,
) -> Bool {
  if arg_pos < 0 || !ctx.symtab.local_fn_names.contains(callee_name) {
    return false
  }
  let (param_names, _, _, fn_open, fn_close) = match find_top_level_fn_f42(tokens, callee_name) {
    Some(info) => info
    None => return false
  }
  if arg_pos >= param_names.length() || param_names[arg_pos].length() == 0 {
    return false
  }
  let target_param = param_names[arg_pos]
  // Track closure body spans (`fn [name](...) { ... }`, `fn { ... }`, and non-match arrow closures `=> ...`)
  // so that capturing `target_param` inside any closure immediately fails closed (prevents lifetime escape).
  let match_brace_depths : Array[Int] = []
  let match_arm_arrow_seen : Array[Bool] = []
  let mut bdepth = 0
  let mut pdepth = 0
  let mut closure_end = -1
  let mut i = fn_open + 1
  while i < fn_close {
    let tk = tokens[i]
    if pdepth == 0 && match_brace_depths.length() > 0 && match_brace_depths[match_brace_depths.length() - 1] == bdepth &&
    (tk.newline_before || tk.kind == TokenKind::Semi) {
      match_arm_arrow_seen[match_arm_arrow_seen.length() - 1] = false
    }
    if tk.kind == TokenKind::Keyword && tk.raw == "match" {
      let mut mb = i + 1
      while mb < fn_close && tokens[mb].kind != TokenKind::LBrace { mb = mb + 1 }
      if mb < fn_close {
        match_brace_depths.push(bdepth + 1)
        match_arm_arrow_seen.push(false)
      }
    }
    if tk.kind == TokenKind::LParen {
      pdepth = pdepth + 1
    } else if tk.kind == TokenKind::RParen {
      if pdepth > 0 { pdepth = pdepth - 1 }
    } else if tk.kind == TokenKind::LBrace {
      bdepth = bdepth + 1
    } else if tk.kind == TokenKind::RBrace {
      if match_brace_depths.length() > 0 && match_brace_depths[match_brace_depths.length() - 1] == bdepth {
        let _ = match_brace_depths.pop()
        let _ = match_arm_arrow_seen.pop()
      }
      if bdepth > 0 { bdepth = bdepth - 1 }
    }
    if tk.kind == TokenKind::Keyword && tk.raw == "fn" {
      let mut fn_lp = i + 1
      if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::Ident {
        fn_lp = fn_lp + 1
      }
      if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::LBrace {
        let cb_close = find_matching_delim(tokens, fn_lp)
        if cb_close > closure_end { closure_end = cb_close }
      } else if fn_lp < fn_close && tokens[fn_lp].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, fn_lp)
        if cp > fn_lp && cp < fn_close {
          let mut cb_open = cp + 1
          while cb_open < fn_close && tokens[cb_open].kind != TokenKind::LBrace { cb_open = cb_open + 1 }
          if cb_open < fn_close {
            let cb_close = find_matching_delim(tokens, cb_open)
            if cb_close > closure_end { closure_end = cb_close }
          }
        }
      }
    } else if tk.kind == TokenKind::FatArrow {
      let at_match_level = match_brace_depths.length() > 0 && match_brace_depths[match_brace_depths.length() - 1] == bdepth
      let is_first_match_arrow = at_match_level && pdepth == 0 && !match_arm_arrow_seen[match_arm_arrow_seen.length() - 1]
      if is_first_match_arrow {
        match_arm_arrow_seen[match_arm_arrow_seen.length() - 1] = true
      } else if i + 1 < fn_close {
        if tokens[i + 1].kind == TokenKind::LBrace {
          let cb_close = find_matching_delim(tokens, i + 1)
          if cb_close > closure_end { closure_end = cb_close }
        } else {
          let mut ae = i + 1
          let mut ad = 0
          while ae < fn_close {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
              if ad == 0 { break }
              ad = ad - 1
            } else if ad == 0 && (ak == TokenKind::Comma || ak == TokenKind::Semi || tokens[ae].newline_before) {
              break
            }
            ae = ae + 1
          }
          if ae - 1 > closure_end { closure_end = ae - 1 }
        }
      }
    }
    if tk.kind == TokenKind::Ident && tk.raw == target_param &&
    !(i > fn_open && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      if i <= closure_end {
        return false
      }
      if !ident_occ_is_strictly_ro_f42(ctx, tokens, i, fn_open, fn_close, false, -1, depth) {
        return false
      }
    }
    i = i + 1
  }
  let visited : Map[String, Bool] = Map()
  fn_has_no_nonfresh_mutation_f42(ctx, tokens, callee_name, target_elem_ty, Map(), visited)
}

///| True iff `m` is an `Iter` consumer/combinator method name on MoonBit `Map::keys()`.
fn is_iter_chain_method_f42(m : String) -> Bool {
  m == "head" || m == "next" || m == "any" || m == "all" || m == "map" ||
  m == "filter" || m == "filter_map" || m == "find_first" || m == "take" ||
  m == "drop" || m == "count" || m == "fold" || m == "each" || m == "join" ||
  m == "collect" || m == "to_array"
}

///| Lower `<map_expr>.keys().<iter_method>(...)` to `mbt_compat::ordered_map_keys_iter(<map_expr>).<iter_method>(...)`
///| when `<map_expr>` has known `OrderedMap[K, V]` / `Map[K, V]` type, preserving MoonBit's lazy `Iter[K]` semantics
///| (including consuming `Iter::head()` and rewriting `.next()` to `.head()`).
fn try_lower_map_keys_iter_chain_f42(
  ctx : StageAContext,
  trivia : String,
  name : String,
  tokens : Array[Token],
  i : Int,
  next_i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let mut cur = next_i
  while cur < end {
    if cur + 3 < end && tokens[cur].kind == TokenKind::Dot &&
    tokens[cur + 1].kind == TokenKind::Ident && tokens[cur + 1].raw == "keys" &&
    tokens[cur + 2].kind == TokenKind::LParen && tokens[cur + 3].kind == TokenKind::RParen {
      if cur + 6 < end && tokens[cur + 4].kind == TokenKind::Dot &&
      tokens[cur + 5].kind == TokenKind::Ident && is_iter_chain_method_f42(tokens[cur + 5].raw) &&
      tokens[cur + 6].kind == TokenKind::LParen {
        let recv_ty = infer_postfix_chain_type(ctx, tokens, i, cur).trim()
        let base_ty = strip_type_args_sym(recv_ty)
        if base_ty == "OrderedMap" || base_ty == "mbt_compat::OrderedMap" || base_ty == "Map" {
          let recv_sb = StringBuilder()
          recv_sb.write_string(name)
          let mut p = next_i
          while p < cur {
            if tokens[p].kind == TokenKind::Dot && p + 1 < cur {
              recv_sb.write_string("." + rename_keyword_ident(tokens[p + 1].raw))
              p = p + 2
            } else if tokens[p].kind == TokenKind::LBracket {
              let cb = find_matching_delim(tokens, p)
              push_expected_type(ctx, "")
              let idx_s = lower_expr_range(ctx, tokens, p + 1, cb, file, false)
              pop_expected_type(ctx)
              recv_sb.write_string("[" + idx_s + tokens[cb].leading_trivia + "]")
              p = cb + 1
            } else {
              return None
            }
          }
          if tokens[cur + 5].raw == "next" && cur + 7 < end && tokens[cur + 7].kind == TokenKind::RParen {
            return Some((trivia + "mbt_compat::ordered_map_keys_iter(" + recv_sb.to_string() + ").head()", cur + 8))
          }
          return Some((trivia + "mbt_compat::ordered_map_keys_iter(" + recv_sb.to_string() + ")", cur + 4))
        }
      }
      return None
    }
    if cur + 1 < end && tokens[cur].kind == TokenKind::Dot && tokens[cur + 1].kind == TokenKind::Ident {
      if tokens[cur + 1].raw == "val" {
        return None
      }
      cur = cur + 2
    } else if tokens[cur].kind == TokenKind::LBracket && !tokens[cur].newline_before {
      let cb = find_matching_delim(tokens, cur)
      if cb >= end { return None }
      cur = cb + 1
    } else {
      return None
    }
  }
  None
}

///| Strip balanced outer grouping parens `( ... )` (with no top-level comma) from a pattern string.
fn strip_outer_parens_pat_f42(s : String) -> String {
  let mut p = s.trim()
  while p.length() >= 2 && p.starts_with("(") && p.ends_with(")") {
    let mut d = 0
    let mut matched_end = true
    let mut has_comma = false
    let mut i = 0
    while i < p.length() {
      let c = p.code_unit_at(i)
      if c == 40 || c == 91 || c == 123 { d = d + 1 }
      else if c == 41 || c == 93 || c == 125 {
        d = d - 1
        if d == 0 && i < p.length() - 1 {
          matched_end = false
          break
        }
      } else if d == 1 && c == 44 {
        has_comma = true
      }
      i = i + 1
    }
    if matched_end && !has_comma {
      p = p.slice(1, p.length() - 1).trim()
    } else {
      break
    }
  }
  p
}

///| Split `s` on top-level `sep_byte` (ignoring nested `()`, `[]`, `{}`).
fn split_top_level_byte_f42(s : String, sep_byte : Int) -> Array[String] {
  let out : Array[String] = []
  let mut d = 0
  let mut start = 0
  let mut i = 0
  while i < s.length() {
    let c = s.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { d = d + 1 }
    else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
    else if d == 0 && c == sep_byte {
      out.push(s.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  out.push(s.slice(start, s.length()).trim())
  out
}

///| True iff `pat` is provably irrefutable (either a simple irrefutable pattern or a top-level
///| or-pattern covering ALL variants of a single known enum with irrefutable sub-patterns).
fn is_irrefutable_as_inner_pat_f42(ctx : StageAContext, pat : String) -> Bool {
  let p = strip_outer_parens_pat_f42(pat)
  if is_irrefutable_simple_pat(p) {
    return true
  }
  let alts = split_top_level_byte_f42(p, 124) // '|'
  if alts.length() < 2 {
    return false
  }
  let seen_variants : Map[String, Bool] = Map()
  let mut qual = ""
  let mut has_qual = false
  let mut first_variant = ""
  for raw_alt in alts {
    let alt = strip_outer_parens_pat_f42(raw_alt)
    if alt.length() == 0 {
      return false
    }
    let lp = alt.index_of("(")
    let head = if lp >= 0 {
      if !alt.ends_with(")") {
        return false
      }
      let args_str = alt.slice(lp + 1, alt.length() - 1).trim()
      if args_str.length() > 0 {
        let args = split_top_level_byte_f42(args_str, 44) // ','
        for arg in args {
          if arg != ".." && !is_irrefutable_simple_pat(arg) {
            return false
          }
        }
      }
      alt.slice(0, lp).trim()
    } else {
      alt
    }
    // Split `head` on last `::`
    let mut last_cc = -1
    let mut scan = 0
    while scan + 1 < head.length() {
      if head.code_unit_at(scan) == 58 && head.code_unit_at(scan + 1) == 58 {
        last_cc = scan
        scan = scan + 2
      } else {
        scan = scan + 1
      }
    }
    let (aq, av) = if last_cc >= 0 {
      (head.slice(0, last_cc).trim(), head.slice(last_cc + 2, head.length()).trim())
    } else {
      ("", head)
    }
    if av.length() == 0 {
      return false
    }
    if aq.length() > 0 {
      if has_qual && qual != aq {
        return false
      }
      qual = aq
      has_qual = true
    }
    if first_variant.length() == 0 {
      first_variant = av
    }
    seen_variants[av] = true
  }
  // Builtin Option / Result / Bool exhaustiveness (guarded against local constructor shadowing)
  if (!has_qual || qual == "Option") && seen_variants.contains("Some") && seen_variants.contains("None") &&
  !ctx.symtab.ctors.contains("Some") && !ctx.symtab.ctors.contains("None") {
    return true
  }
  if (!has_qual || qual == "Result") && seen_variants.contains("Ok") && seen_variants.contains("Err") &&
  !ctx.symtab.ctors.contains("Ok") && !ctx.symtab.ctors.contains("Err") {
    return true
  }
  if !has_qual && seen_variants.contains("true") && seen_variants.contains("false") {
    return true
  }
  // Enum schema exhaustiveness
  let schema_opt : Option[AbiEnumSchema] = if has_qual {
    match ctx.symtab.enum_schemas.get(qual) {
      Some(s) => Some(s)
      None => {
        let cc = qual.index_of("::")
        if cc > 0 {
          symtab_lookup_enum_schema(ctx.symtab, qual.slice(0, cc), qual.slice(cc + 2, qual.length()))
        } else {
          None
        }
      }
    }
  } else {
    match ctx.symtab.ctors.get(first_variant) {
      Some(targets) =>
      if targets.length() == 1 {
        let t = targets[0]
        match ctx.symtab.enum_schemas.get(t.enum_name) {
          Some(s) => Some(s)
          None => symtab_lookup_enum_schema(ctx.symtab, t.pkg, t.enum_name)
        }
      } else {
        None
      }
      None => None
    }
  }
  match schema_opt {
    Some(en) => {
      if en.variants.length() == 0 {
        return false
      }
      for v in en.variants {
        if !seen_variants.contains(v.name) {
          return false
        }
      }
      true
    }
    None => false
  }
}

///| Expand peeled `as`-pattern obligations recursively into `(guard_bool_expr, body_expr)`.
///| Only produces `full_g == "true"` when `inner_pat` is provably irrefutable and `ng == "true"`.
fn expand_as_pat_obligations(
  ctx : StageAContext,
  obls : Array[(String, String, Bool)],
  idx : Int,
  guard_str : String,
  body_str : String,
) -> (String, String) {
  if idx >= obls.length() {
    let g = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
    return (g, body_str)
  }
  let (as_var, inner_pat, has_binders) = obls[idx]
  let (ng, nb) = expand_as_pat_obligations(ctx, obls, idx + 1, guard_str, body_str)
  let irref = is_irrefutable_as_inner_pat_f42(ctx, inner_pat)
  let full_g = if irref && ng == "true" {
    "true"
  } else {
    "(match " + as_var + " { " + inner_pat + " => " + ng + ", _ => false })"
  }
  let full_b = if has_binders {
    if irref {
      "match " + as_var + " { " + inner_pat + " => " + nb + " }"
    } else {
      "match " + as_var + " { " + inner_pat + " => " + nb + ", _ => panic(\"unreachable\") }"
    }
  } else {
    nb
  }
  (full_g, full_b)
}
