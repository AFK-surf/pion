///| Stage A: Lossless CST parsing + deterministic syntax, symbol, control-flow,
///| and recipe-driven lowering from MoonBit to Pion.
///|
///| Preserves Pion-native constructs untouched:
///| - diverging `guard ... else { return/break/continue/panic }`
///| - `if x is Pat && ...`, `|>`, `ignore`, `#|`, `///|`, `for i = 0; ...`,
///|   `for i, x in arr`, `0..<n`, `{ ..s, x: 1 }`, anonymous `{ x: 1 }`,
///|   intra-package unqualified enum constructors, untyped closure params `fn(n, s) { ... }`.
///|
///| Performs all mandatory Stage A rewrites:
///| - Value-returning `guard` + enclosing block remainder -> `if`/`match`
///| - Top-level `let` + `fn init` extraction for `00_init_order.pion`
///| - Optional-parameter forwarding with defaults (lazy callee `None` branch + external call-site branch)
///| - Cross-package unqualified constructors -> `.Case` / `pkg::Enum::Case` (hard-fail on ambiguity)
///| - Cascade `..m()` -> temp receiver evaluated once, returns receiver
///| - `T?` -> `Option[T]` (respecting `() -> T?` precedence)
///| - `pub(all)` / `pub(open)` / `priv`, `(a) => e`, local `fn`, `impl T for X with m(self)`
///| - `b"..."` -> `"\x...".to_bytes()`, `xs[a:b]`, Map literals, rest patterns `Ctor(_, ..)`
///| - Keyword identifier renaming (`val`/`in`/`scope`/`move`/`spawn`/`import`)
///| - Real `SourceLoc` injection (`loc="<rel>.mbt:<line>:<col>"`)
///| - Strict `#derive(...)` allowlist + declarative `--recipes` synthesis
///| - Lossless CST <-> output span map + per-declaration CST hashes

import "json" as json

///| Pion reserved keywords that are valid identifiers in MoonBit.
pub fn is_pion_reserved_ident(s : String) -> Bool {
  s == "val" || s == "in" || s == "scope" || s == "move" || s == "spawn" || s == "import"
}

pub fn rename_keyword_ident(s : String) -> String {
  if is_pion_reserved_ident(s) { s + "_" } else { s }
}

///| Compute collision-free Pion identifier renames for a list of raw parameter or binder names
///| (e.g. `["val", "val_"]` -> `{"val": "val_1"}` so `val` never collides with `val_`).
fn compute_param_renames(raw_names : Array[String]) -> Map[String, String] {
  let out : Map[String, String] = Map()
  let raw_set : Map[String, Bool] = Map()
  for rn in raw_names {
    raw_set[rn] = true
  }
  let used_targets : Map[String, Bool] = Map()
  for rn in raw_names {
    if !is_pion_reserved_ident(rn) {
      used_targets[rn] = true
    }
  }
  for rn in raw_names {
    if is_pion_reserved_ident(rn) {
      let mut cand = rn + "_"
      let mut k = 1
      while raw_set.contains(cand) || used_targets.contains(cand) {
        cand = rn + "_" + k.to_string()
        k = k + 1
      }
      used_targets[cand] = true
      if cand != rn + "_" {
        out[rn] = cand
      }
    }
  }
  out
}

///| Compute collision-free renames for lexical binders introduced in a `let`, `for`, or `match` arm,
///| avoiding BOTH outer `ctx.scope_vars` (e.g. parameter `val_`) AND sibling binders in the same pattern.
fn compute_scoped_binder_renames(ctx : StageAContext, raw_names : Array[String]) -> Map[String, String] {
  let out : Map[String, String] = Map()
  let occupied : Map[String, Bool] = Map()
  for sv in ctx.scope_vars {
    occupied[sv.name] = true
  }
  for rn in raw_names {
    if rn != "_" && !is_pion_reserved_ident(rn) {
      occupied[rn] = true
    }
  }
  for rn in raw_names {
    if is_pion_reserved_ident(rn) {
      let mut cand = rn + "_"
      let mut k = 1
      while occupied.contains(cand) {
        cand = rn + "_" + k.to_string()
        k = k + 1
      }
      occupied[cand] = true
      if cand != rn + "_" || (lookup_ident_rename(ctx, rn) is Some(_)) {
        out[rn] = cand
      }
    }
  }
  out
}

fn restore_ident_renames(ctx : StageAContext, saved_len : Int) -> Unit {
  while ctx.ident_renames.length() > saved_len {
    let _ = ctx.ident_renames.pop()
  }
}

///| Return true iff `pat_s` is an irrefutable simple binder pattern (a single lowercase identifier or `_`).
fn is_irrefutable_simple_pat(pat_s : String) -> Bool {
  let p = pat_s.trim()
  if p.length() == 0 {
    return false
  }
  if p == "_" {
    return true
  }
  if p == "true" || p == "false" {
    return false
  }
  let c0 = p.code_unit_at(0)
  if !((c0 >= 97 && c0 <= 122) || c0 == 95) {
    return false
  }
  let mut k = 1
  while k < p.length() {
    let c = p.code_unit_at(k)
    if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95) {
      return false
    }
    k = k + 1
  }
  true
}

///| Collect raw (un-renamed) lowercase binder names in pattern slice `[start, end)`.
fn collect_raw_pattern_binders(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let out : Array[String] = []
  let mut rbi = start
  while rbi < end {
    let rbt = tokens[rbi]
    if rbt.kind == TokenKind::Ident && rbt.raw != "_" &&
    !(rbi > start && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
    !(rbi + 1 < end && (tokens[rbi + 1].kind == TokenKind::Colon || tokens[rbi + 1].kind == TokenKind::Eq)) {
      out.push(rbt.raw)
    }
    rbi = rbi + 1
  }
  out
}

fn lookup_ident_rename(ctx : StageAContext, raw : String) -> Option[String] {
  let mut idx = ctx.ident_renames.length() - 1
  while idx >= 0 {
    match ctx.ident_renames[idx].get(raw) {
      Some(v) => return Some(v)
      None => ()
    }
    idx = idx - 1
  }
  None
}

fn resolve_ident_in_scope(ctx : StageAContext, raw : String) -> String {
  match lookup_ident_rename(ctx, raw) {
    Some(v) => v
    None => rename_keyword_ident(raw)
  }
}

fn callee_param_rename(renames : Option[Map[String, String]], raw : String) -> String {
  match renames {
    Some(m) => match m.get(raw) {
      Some(v) => v
      None => rename_keyword_ident(raw)
    }
    None => rename_keyword_ident(raw)
  }
}

///| Find matching closing delimiter (`)`, `}`, `]`) starting at `open_idx`.
pub fn find_matching_delim(tokens : Array[Token], open_idx : Int) -> Int {
  if open_idx >= tokens.length() {
    return open_idx
  }
  let open_k = tokens[open_idx].kind
  let close_k = if open_k == TokenKind::LParen {
    TokenKind::RParen
  } else if open_k == TokenKind::LBrace {
    TokenKind::RBrace
  } else if open_k == TokenKind::LBracket {
    TokenKind::RBracket
  } else {
    return open_idx
  }
  let mut depth = 0
  let mut i = open_idx
  while i < tokens.length() {
    let k = tokens[i].kind
    if k == open_k {
      depth = depth + 1
    } else if k == close_k {
      depth = depth - 1
      if depth == 0 {
        return i
      }
    }
    i = i + 1
  }
  tokens.length() - 1
}

///| Check whether a block `{ ... }` (tokens `[open_brace, close_brace]`) unconditionally diverges
///| (ends with `return`, `break`, `continue`, `panic(...)`, or `abort(...)`).
pub fn block_diverges(tokens : Array[Token], open_brace : Int, close_brace : Int) -> Bool {
  if close_brace <= open_brace + 1 {
    return false
  }
  // Scan top-level statements inside the block
  let mut i = open_brace + 1
  let mut last_stmt_start = i
  while i < close_brace {
    let k = tokens[i].kind
    if k == TokenKind::LBrace || k == TokenKind::LParen || k == TokenKind::LBracket {
      i = find_matching_delim(tokens, i) + 1
      continue
    }
    if k == TokenKind::Semi {
      if i + 1 < close_brace {
        last_stmt_start = i + 1
      }
      i = i + 1
      continue
    }
    if tokens[i].newline_before && i > open_brace + 1 {
      // Check if previous token ends a statement
      let pk = tokens[i - 1].kind
      if pk != TokenKind::Plus && pk != TokenKind::Minus && pk != TokenKind::Star &&
      pk != TokenKind::Slash && pk != TokenKind::Eq && pk != TokenKind::Comma &&
      pk != TokenKind::PipeGt && pk != TokenKind::AmpAmp && pk != TokenKind::PipePipe &&
      pk != TokenKind::FatArrow && pk != TokenKind::Arrow {
        last_stmt_start = i
      }
    }
    i = i + 1
  }
  if last_stmt_start < close_brace {
    let t = tokens[last_stmt_start]
    if t.kind == TokenKind::Keyword &&
    (t.raw == "return" || t.raw == "break" || t.raw == "continue") {
      return true
    }
    if t.kind == TokenKind::Ident && (t.raw == "panic" || t.raw == "abort") {
      return true
    }
  }
  false
}

///| Convert a MoonBit byte string `b"..."` to a Pion `"...".to_bytes()` literal.
pub fn lower_byte_string(raw : String) -> String {
  if raw.starts_with("b\"") && raw.ends_with("\"") {
    let inner = raw.slice(1, raw.length())
    return inner + ".to_bytes()"
  }
  raw
}

///| Convert a MoonBit byte char `b'x'` to a Pion `Byte` cast.
pub fn lower_byte_char(raw : String) -> String {
  if raw.starts_with("b'") && raw.ends_with("'") && raw.length() >= 4 {
    let ch = raw.slice(2, raw.length() - 1)
    if ch.length() == 1 {
      return ch.code_unit_at(0).to_string() + ".to_byte()"
    }
    if ch == "\\n" {
      return "10.to_byte()"
    }
    if ch == "\\r" {
      return "13.to_byte()"
    }
    if ch == "\\t" {
      return "9.to_byte()"
    }
    if ch == "\\0" {
      return "0.to_byte()"
    }
    if ch == "\\\\" {
      return "92.to_byte()"
    }
    if ch == "\\'" {
      return "39.to_byte()"
    }
    if ch.length() == 4 && ch.starts_with("\\x") {
      let mut v = 0
      let mut ok = true
      let mut k = 2
      while k < 4 {
        let c = ch.code_unit_at(k)
        let d = if c >= 48 && c <= 57 {
          c - 48
        } else if c >= 97 && c <= 102 {
          c - 97 + 10
        } else if c >= 65 && c <= 70 {
          c - 65 + 10
        } else {
          -1
        }
        if d < 0 {
          ok = false
        } else {
          v = v * 16 + d
        }
        k = k + 1
      }
      if ok {
        return v.to_string() + ".to_byte()"
      }
    }
  }
  raw
}

///| Lower a MoonBit type expression slice `[start, end)` to Pion:
///| - `T?` -> `Option[T]` recursively (respecting `() -> T?` -> `() -> Option[T]`)
///| - `SourceLoc` -> `String`
///| - `Json` -> `json::JsonValue`
///| - `Map[K, V]` -> `mbt_compat::OrderedMap[K, V]`
///| - `Ref[T]` -> recipe-configured Ref type if enabled
///| - `@pkg.Type` -> `pkg::Type`
pub fn lower_type_tokens(
  tokens : Array[Token],
  start : Int,
  end : Int,
  symtab : SymbolTable,
  recipes : Recipes,
) -> String {
  let parts : Array[String] = []
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    // MoonBit `noraise` annotation in function/closure type signatures is equivalent to plain Pion fn types.
    if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "noraise" {
      i = i + 1
      continue
    }
    let mut piece = ""
    if t.kind == TokenKind::PkgRef {
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let mapped = match symtab.pkg_aliases.get(raw_pkg) {
        Some(p) => p
        None => raw_pkg
      }
      if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
        if is_moonbit_core_pkg(symtab, raw_pkg, "json") && tokens[i + 2].raw == "Json" {
          piece = "mbt_compat::MbtJson"
          i = i + 3
        } else if is_moonbit_core_pkg(symtab, raw_pkg, "set") && tokens[i + 2].raw == "Set" {
          let mut qname = "mbt_compat::OrderedSet"
          i = i + 3
          if i < end && tokens[i].kind == TokenKind::LBracket {
            let close_b = find_matching_delim(tokens, i)
            let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
            qname = qname + "[" + inner + "]"
            i = close_b + 1
          }
          piece = qname
        } else {
          let self_test_pkg = match symtab.pkg_aliases.get("__mbt_cur_test_self_pkg__") {
            Some(sp) => sp
            None => ""
          }
          let mut qname = if self_test_pkg.length() > 0 && raw_pkg == self_test_pkg {
            tokens[i + 2].raw
          } else {
            mapped + "::" + tokens[i + 2].raw
          }
          i = i + 3
          if i < end && tokens[i].kind == TokenKind::LBracket {
            let close_b = find_matching_delim(tokens, i)
            let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
            qname = qname + "[" + inner + "]"
            i = close_b + 1
          }
          piece = qname
        }
      } else {
        piece = mapped
        i = i + 1
      }
    } else if t.kind == TokenKind::Ident && i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::UpperIdent {
      // Qualified type `pkg::Type[...]` parsed as a single atom so `pkg::Item?` -> `Option[pkg::Item]`!
      let mut qname = t.raw + "::" + tokens[i + 2].raw
      i = i + 3
      if i < end && tokens[i].kind == TokenKind::LBracket {
        let close_b = find_matching_delim(tokens, i)
        let inner = lower_type_tokens(tokens, i + 1, close_b, symtab, recipes)
        qname = qname + "[" + inner + "]"
        i = close_b + 1
      }
      piece = qname
    } else if t.kind == TokenKind::UpperIdent && t.raw == "FuncRef" &&
    !symtab.active_generics.contains("FuncRef") && !symtab.local_types.contains("FuncRef") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      piece = lower_type_tokens(tokens, i + 2, close_b, symtab, recipes)
      i = close_b + 1
    } else if t.kind == TokenKind::UpperIdent {
      let mut name = t.raw
      if symtab.active_generics.contains(name) {
        // P1 (P0-4): Active generic type param (e.g. `fn[Json] id(x : Json) -> Json`) MUST stay untouched!
        name = t.raw
      } else if name == "SourceLoc" {
        name = "String"
      } else if name == "StringView" {
        name = "String"
      } else if name == "BytesView" {
        name = "Bytes"
      } else if name == "Json" && !symtab.local_types.contains("Json") {
        name = "mbt_compat::MbtJson"
      } else if name == "Set" && !symtab.local_types.contains("Set") {
        name = "mbt_compat::OrderedSet"
      } else if name == "Map" {
        name = "mbt_compat::OrderedMap"
      } else if name == "ReadOnlyArray" {
        name = "Array"
      } else if name == "ArrayView" {
        name = "mbt_compat::ArrayView"
      } else if name == "Ref" && !symtab.local_types.contains("Ref") {
        name = if recipes.ref_recipe.enabled && recipes.ref_recipe.type_name.length() > 0 {
          recipes.ref_recipe.type_name
        } else {
          "mbt_compat::Ref"
        }
      } else {
        match symtab.type_aliases.get(name) {
          Some(aliased) =>
          if !(i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket) || !str_has(aliased, "[") {
            name = aliased
          }
          None =>
          if !symtab.local_types.contains(name) {
            match symtab.using_types.get(name) {
              Some(ut) => name = ut
              None => ()
            }
          }
        }
      }
      if i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
        let close_b = find_matching_delim(tokens, i + 1)
        let inner = lower_type_tokens(tokens, i + 2, close_b, symtab, recipes)
        piece = name + "[" + inner + "]"
        i = close_b + 1
      } else {
        piece = name
        i = i + 1
      }
    } else if t.kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i)
      let inner = lower_type_tokens(tokens, i + 1, close_p, symtab, recipes)
      piece = "(" + inner + ")"
      i = close_p + 1
    } else if t.kind == TokenKind::Arrow {
      // `() -> T?` binds `?` tighter than `->`: lower the entire return type on the right!
      let rhs = lower_type_tokens(tokens, i + 1, end, symtab, recipes)
      parts.push(" -> " + rhs)
      return join_str_array(parts)
    } else if t.kind == TokenKind::Comma {
      parts.push(", ")
      i = i + 1
      continue
    } else if t.kind == TokenKind::Question {
      // Postfix `T?` applies to the previous type atom
      if parts.length() > 0 {
        let last = parts[parts.length() - 1]
        parts[parts.length() - 1] = "Option[" + last + "]"
      }
      i = i + 1
      continue
    } else {
      piece = t.raw
      i = i + 1
    }
    // Check immediately following `?` on this type atom
    while i < end && tokens[i].kind == TokenKind::Question {
      if is_parenthesized_fn_type(piece) {
        piece = "Option[" + piece.slice(1, piece.length() - 1) + "]"
      } else {
        piece = "Option[" + piece + "]"
      }
      i = i + 1
    }
    if parts.length() > 0 && piece.length() > 0 {
      let prev_p = parts[parts.length() - 1]
      if prev_p.length() > 0 {
        let lc = prev_p.code_unit_at(prev_p.length() - 1)
        let fc = piece.code_unit_at(0)
        let prev_word_end = is_alnum(lc) || lc == 93 || lc == 41
        let cur_word_start = is_alpha(fc)
        if prev_word_end && cur_word_start {
          parts.push(" ")
        }
      }
    }
    parts.push(piece)
  }
  join_str_array(parts)
}

fn is_parenthesized_fn_type(piece : String) -> Bool {
  if !(piece.starts_with("(") && piece.ends_with(")")) || piece.length() < 6 {
    return false
  }
  let inner = piece.slice(1, piece.length() - 1)
  let n = inner.length()
  let mut depth = 0
  let mut has_arrow = false
  let mut i = 0
  while i < n {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 {
      if c == 44 {
        // Depth-0 comma means this is a tuple type `(A, B)`, NOT a single parenthesized fn type!
        return false
      }
      if c == 45 && i + 1 < n && inner.code_unit_at(i + 1) == 62 {
        has_arrow = true
      }
    }
    i = i + 1
  }
  has_arrow
}

fn join_str_array(xs : Array[String]) -> String {
  let sb = StringBuilder()
  for x in xs {
    sb.write_string(x)
  }
  sb.to_string()
}

///| Outer variable binding tracked in lexical scope for recursive local `fn` lifting (Wave M1.2 A.2).
struct ScopeVar {
  name : String
  ty : String
  is_mut : Bool
  is_boxed : Bool
}

///| Lifted recursive local `fn` metadata so direct calls rewrite to the lifted top-level symbol.
struct LiftedLocalFn {
  lifted_name : String
  env_args : Array[String]
}

///| Stage A context for lowering a package.
pub struct StageAContext {
  symtab : SymbolTable
  recipes : Recipes
  opts : TranspileOptions
  diags : Array[Diag]
  drift_ledger : Array[DriftEntry]
  dispositions : Array[DispositionEntry]
  span_map : Array[SpanMapEntry]
  init_items : Array[InitItem]
  test_init_items : Array[InitItem]
  fn_bodies : Array[FnBodyRefs]
  migrated_opt_default_fns : Map[String, Bool]
  borrowed_bufs : Map[String, Bool]
  borrowed_views : Map[String, Bool]
  struct_field_renames : Map[String, Map[String, String]]
  struct_val_fields : Map[String, String]
  val_probe_sites : Array[ValProbeSite]
  exported_abi_enums : Array[AbiEnumSchema]
  exported_abi_struct_vals : Array[AbiStructValRename]
  scope_vars : Array[ScopeVar]
  ident_renames : Array[Map[String, String]]
  boxed_mut_vars : Map[String, Bool]
  lifted_local_fns : Map[String, LiftedLocalFn]
  lifted_fns : Array[String]
  expected_type_stack : Array[String]
  match_arr_cache_ctor : Array[String]
  match_arr_cache_elems : Array[Map[Int, String]]
  match_arr_cache_suffix : Array[Map[Int, String]]
  match_arr_cache_len : Array[String]
  active_generics : Map[String, Bool]
  used_idents : Map[String, Bool]
  mut cur_is_test : Bool
  mut cur_is_blackbox : Bool
  mut cur_out_rel : String
  mut cur_lowering_init : Bool
  mut cur_in_test_block : Bool
  mut cur_fn_is_raising : Bool
  mut in_closure_depth : Int
  mut in_try_catch_depth : Int
  mut in_for_header : Bool
  mut direct_owned_slice_arg : Bool
  mut in_interp_top : Bool
  mut self_pkg_name : String
  mut cur_enclosing_fn : String
  mut cur_fn_ret_ty : String
  mut lift_counter : Int
  mut temp_counter : Int
  mut val_site_seq : Int
  mut init_order_seq : Int
}

pub fn stage_a_context_new(
  symtab : SymbolTable,
  recipes : Recipes,
  opts : TranspileOptions,
) -> StageAContext {
  StageAContext::{
    symtab: symtab,
    recipes: recipes,
    opts: opts,
    diags: [],
    drift_ledger: [],
    dispositions: [],
    span_map: [],
    init_items: [],
    test_init_items: [],
    fn_bodies: [],
    migrated_opt_default_fns: Map(),
    borrowed_bufs: Map(),
    borrowed_views: Map(),
    struct_field_renames: Map(),
    struct_val_fields: Map(),
    val_probe_sites: [],
    exported_abi_enums: [],
    exported_abi_struct_vals: [],
    scope_vars: [],
    ident_renames: [],
    boxed_mut_vars: Map(),
    lifted_local_fns: Map(),
    lifted_fns: [],
    expected_type_stack: [],
    match_arr_cache_ctor: [],
    match_arr_cache_elems: [],
    match_arr_cache_suffix: [],
    match_arr_cache_len: [],
    active_generics: Map(),
    used_idents: Map(),
    cur_is_test: false,
    cur_is_blackbox: false,
    cur_out_rel: "",
    cur_lowering_init: false,
    cur_in_test_block: false,
    cur_fn_is_raising: false,
    in_closure_depth: 0,
    in_try_catch_depth: 0,
    in_for_header: false,
    direct_owned_slice_arg: false,
    in_interp_top: false,
    self_pkg_name: "",
    cur_enclosing_fn: "top",
    cur_fn_ret_ty: "",
    lift_counter: 0,
    temp_counter: 0,
    val_site_seq: 0,
    init_order_seq: 0,
  }
}

///| Allocate a per-file collision-free placeholder identifier for a `.val` field access,
///| avoiding ALL identifiers occurring in the source file and registering `(site_id, placeholder_ident)`.
fn alloc_fresh_val_placeholder(ctx : StageAContext, line : Int, col : Int) -> String {
  ctx.val_site_seq = ctx.val_site_seq + 1
  let sid = ctx.val_site_seq
  let mut cand = "__mbt_val_p" + sid.to_string()
  let mut bump = 1
  while ctx.used_idents.contains(cand) {
    cand = "__mbt_val_p" + sid.to_string() + "_" + bump.to_string()
    bump = bump + 1
  }
  ctx.used_idents[cand] = true
  let out_f = if ctx.cur_lowering_init {
    if ctx.cur_is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
  } else {
    ctx.cur_out_rel
  }
  ctx.val_probe_sites.push(ValProbeSite::{
    site_id: sid,
    placeholder_ident: cand,
    file: out_f,
    line: line,
    col: col,
  })
  cand
}

///| Return true iff `[arg_s, arg_e)` is a single direct postfix slice expression `<recv>[lo:hi]`
///| (never a function call wrapping a slice like `f(a[1:3])`, and never a multi-arg or binary expr).
fn is_direct_slice_arg(tokens : Array[Token], arg_s : Int, arg_e : Int) -> Bool {
  let mut e = arg_e
  while e > arg_s && tokens[e - 1].kind == TokenKind::Comma {
    e = e - 1
  }
  if e <= arg_s + 2 {
    return false
  }
  let t = tokens[arg_s]
  let mut cur = -1
  if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::ByteStringLit {
    cur = arg_s + 1
  } else if t.kind == TokenKind::PkgRef && arg_s + 2 < e && tokens[arg_s + 1].kind == TokenKind::Dot {
    cur = arg_s + 3
  } else if t.kind == TokenKind::LParen {
    if is_arrow_fn_at(tokens, arg_s, e) >= 0 {
      return false
    }
    cur = find_matching_delim(tokens, arg_s) + 1
  } else if t.kind == TokenKind::LBracket {
    cur = find_matching_delim(tokens, arg_s) + 1
  } else {
    return false
  }
  let mut last_was_slice = false
  while cur < e {
    let ck = tokens[cur].kind
    if ck == TokenKind::LBracket && !tokens[cur].newline_before {
      let cbr = find_matching_delim(tokens, cur)
      if cbr >= e {
        return false
      }
      last_was_slice = find_slice_colon(tokens, cur, cbr) >= 0
      cur = cbr + 1
    } else if ck == TokenKind::LParen && !tokens[cur].newline_before {
      let cp = find_matching_delim(tokens, cur)
      if cp >= e {
        return false
      }
      last_was_slice = false
      cur = cp + 1
    } else if ck == TokenKind::Dot && cur + 1 < e &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::IntLit) {
      last_was_slice = false
      cur = cur + 2
    } else if ck == TokenKind::ColonColon && cur + 1 < e &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::UpperIdent) {
      last_was_slice = false
      cur = cur + 2
    } else {
      return false
    }
  }
  cur == e && last_was_slice
}

fn current_expected_type(ctx : StageAContext) -> String {
  let n = ctx.expected_type_stack.length()
  if n > 0 { ctx.expected_type_stack[n - 1] } else { "" }
}

fn push_expected_type(ctx : StageAContext, ty : String) -> Unit {
  ctx.expected_type_stack.push(ty)
}

fn pop_expected_type(ctx : StageAContext) -> Unit {
  if ctx.expected_type_stack.length() > 0 {
    let _ = ctx.expected_type_stack.pop()
  }
}

///| Allocate a deterministic collision-free Pion field name for a MoonBit reserved-keyword field
///| (e.g. `val` in `struct S { val : Int; val_ : Int }` -> `val_1`, never colliding with `val_`!).
fn allocate_collision_free_field_name(
  raw_name : String,
  existing : Map[String, Bool],
  used : Map[String, Bool],
) -> String {
  if !is_pion_reserved_ident(raw_name) {
    return raw_name
  }
  let cand0 = raw_name + "_"
  if !existing.contains(cand0) && !used.contains(cand0) {
    return cand0
  }
  let mut idx = 1
  while true {
    let cand = raw_name + "_" + idx.to_string()
    if !existing.contains(cand) && !used.contains(cand) {
      return cand
    }
    idx = idx + 1
  }
  cand0
}

fn rename_struct_field(ctx : StageAContext, struct_name : String, raw_field : String) -> String {
  match ctx.struct_field_renames.get(struct_name) {
    Some(rmap) =>
    match rmap.get(raw_field) {
      Some(renamed) => return renamed
      None => ()
    }
    None => ()
  }
  if raw_field == "val" {
    match ctx.symtab.dep_struct_val_fields.get(struct_name) {
      Some(renamed) => return renamed
      None => ()
    }
  }
  rename_keyword_ident(raw_field)
}

///| Lower a struct literal or destructuring pattern `{ field: expr, .. }` with collision-free
///| field renaming for `struct_name`.
fn lower_struct_brace(
  ctx : StageAContext,
  struct_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
  in_pattern : Bool,
) -> String {
  let sb = StringBuilder()
  sb.write_string("{")
  let mut i = open_b + 1
  while i < close_b {
    let t = tokens[i]
    if t.kind == TokenKind::Comma {
      sb.write_string(t.leading_trivia + ",")
      i = i + 1
      continue
    }
    // Spread `..base`
    if t.kind == TokenKind::DotDot {
      sb.write_string(t.leading_trivia + "..")
      let mut e = i + 1
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
          d = d + 1
        } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
          d = d - 1
        } else if d == 0 && ek == TokenKind::Comma {
          break
        }
        e = e + 1
      }
      sb.write_string(lower_expr_range(ctx, tokens, i + 1, e, file, in_pattern))
      i = e
      continue
    }
    // Field `name: val` or shorthand `name`
    if t.kind == TokenKind::Ident || t.kind == TokenKind::Keyword {
      let raw_f = t.raw
      let renamed_f = rename_struct_field(ctx, struct_name, raw_f)
      if i + 1 < close_b && tokens[i + 1].kind == TokenKind::Colon {
        sb.write_string(t.leading_trivia + renamed_f + tokens[i + 1].leading_trivia + ":")
        let mut e = i + 2
        let mut d = 0
        while e < close_b {
          let ek = tokens[e].kind
          if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
            d = d + 1
          } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
            d = d - 1
          } else if d == 0 && ek == TokenKind::Comma {
            break
          }
          e = e + 1
        }
        let field_exp_ty = match ctx.symtab.struct_field_types.get(struct_name) {
          Some(fmap) => match fmap.get(raw_f) { Some(ft) => ft, None => "" }
          None => ""
        }
        push_expected_type(ctx, field_exp_ty)
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, in_pattern))
        pop_expected_type(ctx)
        i = e
        continue
      }
      // Shorthand `field` (followed by `,` or `}`)
      if i + 1 == close_b || tokens[i + 1].kind == TokenKind::Comma {
        let local_var = resolve_ident_in_scope(ctx, raw_f)
        if renamed_f != local_var {
          sb.write_string(t.leading_trivia + renamed_f + ": " + local_var)
        } else {
          sb.write_string(t.leading_trivia + renamed_f)
        }
        i = i + 1
        continue
      }
    }
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, close_b, file, in_pattern)
    sb.write_string(piece)
    i = next_i
  }
  sb.write_string(tokens[close_b].leading_trivia + "}")
  sb.to_string()
}

///| Check whether an anonymous `{ ... }` is a MoonBit struct literal containing shorthand fields
///| (e.g. `{ key, title, content, disabled }` or `{ from, to, lit: false }`) which Pion requires
///| to be written with explicit `field: field` syntax when the struct name is omitted.
fn is_anon_shorthand_struct_lit(tokens : Array[Token], open_b : Int, close_b : Int) -> Bool {
  if close_b <= open_b + 2 {
    return false
  }
  let mut has_comma = false
  let mut has_shorthand = false
  let mut item_count = 0
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      has_comma = true
      i = i + 1
      continue
    }
    // Find end of this comma-separated item at depth 0
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if e <= i {
      return false
    }
    item_count = item_count + 1
    if tokens[i].kind == TokenKind::DotDot {
      // Spread `..base` is valid in struct literal
      let _ = 0
    } else if e == i + 1 && tokens[i].kind == TokenKind::Ident {
      has_shorthand = true
    } else if e >= i + 3 && (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    tokens[i + 1].kind == TokenKind::Colon {
      // `field: expr` is valid
      let _ = 0
    } else {
      return false
    }
    i = e
  }
  has_shorthand && has_comma && item_count >= 1
}

///| Lower an anonymous struct literal `{ a, b, c: expr }` expanding bare shorthand `a` -> `a: a`.
fn lower_anon_shorthand_struct_lit(
  ctx : StageAContext,
  struct_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  sb.write_string("{")
  let mut i = open_b + 1
  while i < close_b {
    let t = tokens[i]
    if t.kind == TokenKind::Comma {
      sb.write_string(t.leading_trivia + ",")
      i = i + 1
      continue
    }
    if t.kind == TokenKind::DotDot {
      sb.write_string(t.leading_trivia + "..")
      let mut e = i + 1
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
        else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && ek == TokenKind::Comma { break }
        e = e + 1
      }
      sb.write_string(lower_expr_range(ctx, tokens, i + 1, e, file, false))
      i = e
      continue
    }
    if (t.kind == TokenKind::Ident || t.kind == TokenKind::Keyword) && i + 1 < close_b && tokens[i + 1].kind == TokenKind::Colon {
      let raw_f = t.raw
      let renamed_f = if struct_name.length() > 0 { rename_struct_field(ctx, struct_name, raw_f) } else { rename_keyword_ident(raw_f) }
      sb.write_string(t.leading_trivia + renamed_f + tokens[i + 1].leading_trivia + ":")
      let mut e = i + 2
      let mut d = 0
      while e < close_b {
        let ek = tokens[e].kind
        if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
        else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && ek == TokenKind::Comma { break }
        e = e + 1
      }
      if struct_name.length() > 0 {
        let field_exp_ty = match ctx.symtab.struct_field_types.get(struct_name) {
          Some(fmap) => match fmap.get(raw_f) { Some(ft) => ft, None => "" }
          None => ""
        }
        push_expected_type(ctx, field_exp_ty)
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, false))
        pop_expected_type(ctx)
      } else {
        sb.write_string(lower_expr_range(ctx, tokens, i + 2, e, file, false))
      }
      i = e
      continue
    }
    if t.kind == TokenKind::Ident && (i + 1 == close_b || tokens[i + 1].kind == TokenKind::Comma) {
      let renamed_f = if struct_name.length() > 0 { rename_struct_field(ctx, struct_name, t.raw) } else { rename_keyword_ident(t.raw) }
      let local_v = resolve_ident_in_scope(ctx, t.raw)
      sb.write_string(t.leading_trivia + renamed_f + ": " + local_v)
      i = i + 1
      continue
    }
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, close_b, file, false)
    sb.write_string(piece)
    i = next_i
  }
  sb.write_string(tokens[close_b].leading_trivia + "}")
  sb.to_string()
}

///| Resolve an anonymous `{ ... }` struct literal to its concrete local struct name `S`
///| (using expected type first, then unique field-set match across `ctx.struct_field_renames`)
///| so we emit explicit `S::{ ... }` instead of anonymous `{ ... }` (which avoids Pion native SIGSEGV!).
fn resolve_anon_struct_literal_name(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
) -> Option[String] {
  if close_b <= open_b + 2 {
    return None
  }
  // Verify every top-level comma-separated item is a struct field (`f: expr`, `..base`, or shorthand `f`)
  // and collect field names. A bare single-item `{ x }` without `:` is a block, NOT a struct literal!
  let fields : Array[String] = []
  let mut has_colon = false
  let mut has_spread = false
  let mut has_comma = false
  let mut item_count = 0
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      has_comma = true
      i = i + 1
      continue
    }
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if e <= i {
      return None
    }
    item_count = item_count + 1
    if tokens[i].kind == TokenKind::DotDot {
      has_spread = true
    } else if e >= i + 3 && (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    tokens[i + 1].kind == TokenKind::Colon {
      has_colon = true
      fields.push(tokens[i].raw)
    } else if e == i + 1 && tokens[i].kind == TokenKind::Ident {
      fields.push(tokens[i].raw)
    } else {
      return None
    }
    i = e
  }
  if item_count == 0 || (!has_colon && !has_spread && !has_comma) {
    return None
  }
  // 1. Expected type in context takes priority
  let raw_exp = current_expected_type(ctx).trim()
  let exp_base = {
    let bi = raw_exp.index_of("[")
    if bi > 0 { raw_exp.slice(0, bi).trim() } else { raw_exp }
  }
  if exp_base.length() > 0 {
    match ctx.struct_field_renames.get(exp_base) {
      Some(rmap) => {
        let mut all_present = true
        for f in fields {
          if !rmap.contains(f) {
            all_present = false
            break
          }
        }
        if all_present && (has_spread || fields.length() == rmap.length()) {
          return Some(exp_base)
        }
      }
      None => ()
    }
  }
  // 2. Exact unique field-set match across all local structs
  let exact_matches : Array[String] = []
  let superset_matches : Array[String] = []
  for sname in sorted_map_keys(ctx.struct_field_renames) {
    match ctx.struct_field_renames.get(sname) {
      Some(rmap) => {
        let mut all_present = true
        for f in fields {
          if !rmap.contains(f) {
            all_present = false
            break
          }
        }
        if all_present {
          if !has_spread && fields.length() == rmap.length() {
            exact_matches.push(sname)
          } else if has_spread {
            superset_matches.push(sname)
          }
        }
      }
      None => ()
    }
  }
  if exact_matches.length() == 1 {
    return Some(exact_matches[0])
  }
  if has_spread && superset_matches.length() == 1 {
    return Some(superset_matches[0])
  }
  None
}

fn fresh_temp(ctx : StageAContext, prefix : String) -> String {
  while true {
    ctx.temp_counter = ctx.temp_counter + 1
    let cand = "__mbt_" + prefix + "_" + ctx.temp_counter.to_string()
    if !ctx.used_idents.contains(cand) {
      ctx.used_idents[cand] = true
      return cand
    }
  }
  "__mbt_" + prefix + "_0"
}

///| Parsed parameter of a MoonBit function.
struct ParsedParam {
  name : String
  pion_name : String
  ty : String
  is_opt : Bool
  is_tilde : Bool
  default_expr : String
  is_loc : Bool
}

///| Parse `#derive(A, B)` attribute argument list.
fn parse_derive_names(attr_raw : String) -> Array[String] {
  let lp = attr_raw.index_of("(")
  let rp = attr_raw.index_of(")")
  if lp < 0 || rp <= lp {
    return []
  }
  let inner = attr_raw.slice(lp + 1, rp)
  let parts = inner.split(",")
  let out : Array[String] = []
  for p in parts {
    let t = p.trim()
    if t.length() > 0 {
      out.push(t)
    }
  }
  out
}

///| Check if a type name is primitive for Pion `derive(Eq)`.
fn is_primitive_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Byte" ||
  t == "Bool" || t == "Double" || t == "Float" || t == "Char" || t == "String" || t == "Unit"
}

///| Lower a MoonBit parameter list `(a : Int, x? : Int = 17, loc~ : SourceLoc)`
///| returning `(pion_param_list_str, lazy_default_stmts, has_opt_default)`.
fn lower_param_list(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  autofill_loc : Bool,
) -> (String, String, Bool) {
  let (s, pre, has_opt, _) = lower_param_list_scoped(ctx, tokens, open_p, close_p, file, autofill_loc, false)
  (s, pre, has_opt)
}

fn lower_param_list_scoped(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  autofill_loc : Bool,
  use_outer_scope : Bool,
) -> (String, String, Bool, Map[String, String]) {
  // Pre-collect raw param names so colliding keyword params (e.g. `val~` + `val_~`, or nested `fn(val)`
  // inside an outer scope with `val_` / `val_1`) get collision-free names.
  let raw_pnames_for_rename : Array[String] = []
  let mut rpi = open_p + 1
  while rpi < close_p {
    if tokens[rpi].kind == TokenKind::Comma { rpi = rpi + 1; continue }
    let mut rpe = rpi
    let mut rpd = 0
    while rpe < close_p {
      let rk = tokens[rpe].kind
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rpd = rpd + 1 }
      else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { rpd = rpd - 1 }
      else if rk == TokenKind::Comma && rpd == 0 { break }
      rpe = rpe + 1
    }
    if rpe > rpi {
      raw_pnames_for_rename.push(tokens[rpi].raw)
    }
    rpi = rpe + 1
  }
  let local_param_renames = if use_outer_scope {
    compute_scoped_binder_renames(ctx, raw_pnames_for_rename)
  } else {
    compute_param_renames(raw_pnames_for_rename)
  }

  let params : Array[ParsedParam] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    // Find end of this parameter (top-level comma or close_p)
    let mut p_end = i
    let mut depth = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if k == TokenKind::Comma && depth == 0 {
        break
      }
      p_end = p_end + 1
    }
    if p_end > i {
      let pname = tokens[i].raw
      let pion_name = match local_param_renames.get(pname) {
        Some(rn) => rn
        None => rename_keyword_ident(pname)
      }
      let mut cur = i + 1
      let mut is_opt = false
      let mut is_tilde = false
      if cur < p_end && tokens[cur].kind == TokenKind::Question {
        is_opt = true
        cur = cur + 1
      } else if cur < p_end && tokens[cur].kind == TokenKind::Tilde {
        is_tilde = true
        cur = cur + 1
      }
      // Find `:` and top-level `=`
      let mut colon_idx = -1
      let mut eq_idx = -1
      let mut scan = cur
      let mut d2 = 0
      while scan < p_end {
        let sk = tokens[scan].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace {
          d2 = d2 + 1
        } else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace {
          d2 = d2 - 1
        } else if d2 == 0 {
          if sk == TokenKind::Colon && colon_idx < 0 {
            colon_idx = scan
          } else if sk == TokenKind::Eq && eq_idx < 0 {
            eq_idx = scan
          }
        }
        scan = scan + 1
      }
      let ty_end = if eq_idx >= 0 { eq_idx } else { p_end }
      let raw_ty = if colon_idx >= 0 {
        lower_type_tokens_checked(ctx, tokens, colon_idx + 1, ty_end, file)
      } else {
        ""
      }
      let is_loc = (autofill_loc && pname == "loc") ||
      (colon_idx >= 0 && colon_idx + 1 < ty_end && tokens[colon_idx + 1].raw == "SourceLoc")
      let def_expr = if eq_idx >= 0 {
        if raw_ty.length() > 0 { push_expected_type(ctx, raw_ty) }
        let lowered_def = lower_expr_range(ctx, tokens, eq_idx + 1, p_end, file, false).trim()
        if raw_ty.length() > 0 { pop_expected_type(ctx) }
        lowered_def
      } else {
        ""
      }
      params.push(ParsedParam::{
        name: pname,
        pion_name: pion_name,
        ty: if is_loc { "String" } else { raw_ty },
        is_opt: is_opt,
        is_tilde: is_tilde,
        default_expr: def_expr,
        is_loc: is_loc,
      })
    }
    i = p_end + 1
  }

  let sig_sb = StringBuilder()
  let prelude_sb = StringBuilder()
  let mut has_opt_default = false
  let mut pi = 0
  while pi < params.length() {
    let p = params[pi]
    if pi > 0 {
      sig_sb.write_string(", ")
    }
    if p.is_loc && (p.is_tilde || p.is_opt) {
      sig_sb.write_string(p.pion_name + "~ : String = \"\"")
    } else if p.is_loc {
      sig_sb.write_string(p.pion_name + " : String")
    } else if (p.is_opt || p.is_tilde) && p.default_expr.length() > 0 {
      // Migrated callee: preserve `x? : T` in Pion signature and lazily evaluate default in `None` branch!
      // This allows `f(x?=x)` forwarding while preserving side-effect laziness.
      has_opt_default = true
      sig_sb.write_string(p.pion_name + "? : " + p.ty)
      prelude_sb.write_string(
        "  let " + p.pion_name + " = match " + p.pion_name + " { Some(__mbt_v) => __mbt_v, None => " + p.default_expr + " }\n",
      )
    } else if p.is_opt {
      sig_sb.write_string(p.pion_name + "? : " + p.ty)
    } else if p.is_tilde {
      sig_sb.write_string(p.pion_name + "~ : " + p.ty)
    } else if p.ty.length() > 0 {
      sig_sb.write_string(p.pion_name + " : " + p.ty)
    } else {
      sig_sb.write_string(p.pion_name)
    }
    pi = pi + 1
  }
  (sig_sb.to_string(), prelude_sb.to_string(), has_opt_default, local_param_renames)
}

///| Lower an interpolated string `"..."` or `$|...` by recursively lowering each `\{...}` expression
///| while preserving literal bytes verbatim!
fn lower_interp_string(
  ctx : StageAContext,
  raw : String,
  is_multiline : Bool,
  file : String,
) -> String {
  let parts = split_interp_string(raw, is_multiline)
  let sb = StringBuilder()
  if is_multiline {
    sb.write_string("\"")
  } else {
    sb.write_string("\"")
  }
  for part in parts {
    if !part.is_expr {
      let fixed_part_q = lower_mbt_string_surrogates("\"" + part.text + "\"", file, 1, 1, ctx.diags)
      let fixed_part = if fixed_part_q.length() >= 2 {
        fixed_part_q.slice(1, fixed_part_q.length() - 1)
      } else {
        part.text
      }
      if is_multiline {
        // Escape `"` in `$|...` when emitting normal Pion string literal
        sb.write_string(str_replace_all(fixed_part, "\"", "\\\""))
      } else {
        sb.write_string(fixed_part)
      }
    } else {
      let inner_toks = lex_moonbit(part.text)
      let saved_it = ctx.in_interp_top
      ctx.in_interp_top = true
      let lowered = lower_expr_range(ctx, inner_toks, 0, inner_toks.length() - 1, file, false).trim()
      ctx.in_interp_top = saved_it
      sb.write_string("\\{")
      sb.write_string(lowered)
      sb.write_string("}")
    }
  }
  sb.write_string("\"")
  sb.to_string()
}

///| Check whether `{ ... }` is a MoonBit Map literal `{ "k": v, ... }` (string/int key followed by `:`).
fn is_map_literal(tokens : Array[Token], open_b : Int, close_b : Int) -> Bool {
  if close_b <= open_b + 3 {
    return false
  }
  let k1 = tokens[open_b + 1].kind
  let k2 = tokens[open_b + 2].kind
  (k1 == TokenKind::StringLit || k1 == TokenKind::IntLit || k1 == TokenKind::CharLit) &&
  k2 == TokenKind::Colon
}

///| Lower a Map literal `{ k1: v1, k2: v2 }` to `mbt_compat::ordered_map_from([(k1, v1), (k2, v2)])`.
fn lower_map_literal(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  sb.write_string("mbt_compat::ordered_map_from_array([")
  let mut i = open_b + 1
  let mut first = true
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    // Find `:` and entry end `,`
    let mut colon_i = -1
    let mut end_i = i
    let mut depth = 0
    while end_i < close_b {
      let k = tokens[end_i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if depth == 0 {
        if k == TokenKind::Colon && colon_i < 0 {
          colon_i = end_i
        } else if k == TokenKind::Comma {
          break
        }
      }
      end_i = end_i + 1
    }
    if colon_i > i {
      if !first {
        sb.write_string(", ")
      }
      let k_expr = lower_expr_range(ctx, tokens, i, colon_i, file, false).trim()
      let v_expr = lower_expr_range(ctx, tokens, colon_i + 1, end_i, file, false).trim()
      sb.write_string("(" + k_expr + ", " + v_expr + ")")
      first = false
    }
    i = end_i + 1
  }
  sb.write_string("])")
  sb.to_string()
}

fn effective_ref_type(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.type_name.length() > 0 {
    recipes.ref_recipe.type_name
  } else {
    "mbt_compat::Ref"
  }
}

fn effective_ref_ctor(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.ctor_call.length() > 0 {
    recipes.ref_recipe.ctor_call
  } else {
    "mbt_compat::ref_new"
  }
}

fn effective_ref_field(recipes : Recipes) -> String {
  if recipes.ref_recipe.enabled && recipes.ref_recipe.field_name.length() > 0 {
    recipes.ref_recipe.field_name
  } else {
    "v"
  }
}

fn is_known_mbt_ref_type(ctx : StageAContext, ty : String) -> Bool {
  if ctx.symtab.local_types.contains("Ref") || ctx.active_generics.contains("Ref") {
    return false
  }
  let base = strip_type_args_sym(ty)
  if base == "mbt_compat::Ref" || base == "Ref" {
    return true
  }
  let ref_ty = effective_ref_type(ctx.recipes)
  base == ref_ty
}

///| Sound static `.val` field resolver (P1-1): resolves `.val` directly in Stage A ONLY when
///| the receiver's static type is provably unshadowed `mbt_compat::Ref` (or recipe `ref_recipe.type_name`)
///| or a local struct registered in `ctx.struct_val_fields`. Returns `None` for unknown/foreign receivers
///| so Stage A.5 + both negative gates (`MBT2PION_UNDISPOSED_PROBE_SITE`, `MBT2PION_DEP_ABI_ERROR`) stay intact.
fn try_resolve_static_val_field_from_ty(ctx : StageAContext, recv_ty : String) -> Option[String] {
  if recv_ty.length() == 0 {
    return None
  }
  if is_known_mbt_ref_type(ctx, recv_ty) {
    return Some(effective_ref_field(ctx.recipes))
  }
  let base = strip_type_args_sym(recv_ty)
  match ctx.struct_val_fields.get(base) {
    Some(rf) => return Some(rf)
    None => ()
  }
  None
}

fn lookup_ident_static_type(ctx : StageAContext, raw_ident : String) -> String {
  let eff = resolve_ident_in_scope(ctx, raw_ident)
  match lookup_scope_var(ctx, eff) {
    Some(sv) => return sv.ty
    None => ()
  }
  if eff != raw_ident {
    match lookup_scope_var(ctx, raw_ident) {
      Some(sv) => return sv.ty
      None => ()
    }
  }
  match ctx.symtab.val_types.get(raw_ident) {
    Some(vt) => return vt
    None => ()
  }
  match ctx.symtab.val_types.get(eff) {
    Some(vt) => return vt
    None => ()
  }
  ""
}

fn extract_container_value_type(ty : String) -> String {
  let t = ty.trim()
  let lb = t.index_of("[")
  if lb <= 0 || !t.ends_with("]") {
    return ""
  }
  let base = t.slice(0, lb).trim()
  let inner = t.slice(lb + 1, t.length() - 1).trim()
  if base == "Array" || base == "FixedArray" || base == "ReadOnlyArray" || base == "ArrayView" || base == "mbt_compat::ArrayView" || base == "mbt_compat::ArrayBuf" {
    return inner
  }
  if base == "Map" || base == "mbt_compat::OrderedMap" {
    let mut i = 0
    let mut d = 0
    while i < inner.length() {
      let c = inner.code_unit_at(i)
      if c == 40 || c == 91 || c == 123 { d = d + 1 }
      else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
      else if d == 0 && c == 44 {
        return inner.slice(i + 1, inner.length()).trim()
      }
      i = i + 1
    }
  }
  ""
}

fn extract_tuple_elem_type(ty : String, idx : Int) -> String {
  let t = ty.trim()
  if !t.starts_with("(") || !t.ends_with(")") || idx < 0 {
    return ""
  }
  let inner = t.slice(1, t.length() - 1)
  let mut cur = 0
  let mut start = 0
  let mut d = 0
  let mut i = 0
  while i < inner.length() {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { d = d + 1 }
    else if c == 41 || c == 93 || c == 125 { if d > 0 { d = d - 1 } }
    else if d == 0 && c == 44 {
      if cur == idx { return inner.slice(start, i).trim() }
      cur = cur + 1
      start = i + 1
    }
    i = i + 1
  }
  if cur == idx { inner.slice(start, inner.length()).trim() } else { "" }
}

///| Resolve the static type of a root-anchored dot chain ending at `end_idx`
///| (e.g. `x`, `a.b.c`, `@pkg.v.field`), walking all the way back to the true chain head
///| and returning `""` whenever the head is preceded by `.`, `::`, `)`, `]`, or `}` (e.g. `f().inner.items`).
fn resolve_dot_chain_static_type(ctx : StageAContext, tokens : Array[Token], end_idx : Int) -> String {
  if end_idx < 0 || tokens[end_idx].kind != TokenKind::Ident {
    return ""
  }
  let rev_segs : Array[String] = []
  let mut head_i = end_idx
  while head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::Ident {
    rev_segs.push(tokens[head_i].raw)
    head_i = head_i - 2
  }
  let mut cur_ty = ""
  if head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::PkgRef {
    let raw_pkg = tokens[head_i - 2].raw.slice(1, tokens[head_i - 2].raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None => raw_pkg
    }
    let vname = tokens[head_i].raw
    cur_ty = match ctx.symtab.val_types.get(mapped_pkg + "::" + vname) {
      Some(t) => t
      None => match ctx.symtab.val_types.get(raw_pkg + "::" + vname) {
        Some(t) => t
        None => ""
      }
    }
  } else if head_i >= 1 && (tokens[head_i - 1].kind == TokenKind::Dot ||
    tokens[head_i - 1].kind == TokenKind::ColonColon ||
    (!tokens[head_i].newline_before && (tokens[head_i - 1].kind == TokenKind::RParen ||
      tokens[head_i - 1].kind == TokenKind::RBracket ||
      tokens[head_i - 1].kind == TokenKind::RBrace))) {
    return ""
  } else {
    cur_ty = lookup_ident_static_type(ctx, tokens[head_i].raw)
  }
  if cur_ty.length() == 0 {
    return ""
  }
  let mut ri = rev_segs.length() - 1
  while ri >= 0 {
    let sbase = strip_type_args_sym(cur_ty)
    match ctx.symtab.struct_field_types.get(sbase) {
      Some(fmap) =>
      match fmap.get(rev_segs[ri]) {
        Some(fty) => cur_ty = fty
        None => return ""
      }
      None => return ""
    }
    ri = ri - 1
  }
  cur_ty
}

///| Extract the true root identifier of a dot chain ending at `end_idx`, or `""` if not root-anchored.
fn extract_dot_chain_root_ident(tokens : Array[Token], end_idx : Int) -> String {
  if end_idx < 0 || tokens[end_idx].kind != TokenKind::Ident {
    return ""
  }
  let mut head_i = end_idx
  while head_i >= 2 && tokens[head_i - 1].kind == TokenKind::Dot && tokens[head_i - 2].kind == TokenKind::Ident {
    head_i = head_i - 2
  }
  if head_i >= 1 && (tokens[head_i - 1].kind == TokenKind::Dot ||
    tokens[head_i - 1].kind == TokenKind::ColonColon ||
    (!tokens[head_i].newline_before && (tokens[head_i - 1].kind == TokenKind::RParen ||
      tokens[head_i - 1].kind == TokenKind::RBracket ||
      tokens[head_i - 1].kind == TokenKind::RBrace))) {
    return ""
  }
  tokens[head_i].raw
}

fn try_resolve_static_val_field(ctx : StageAContext, tokens : Array[Token], dot_i : Int) -> Option[String] {
  if dot_i <= 0 {
    return None
  }
  // Case 0a: `(r.N).val` (parenthesized tuple element access — NEVER a function call `mk(r.0).val`!)
  if dot_i >= 5 && tokens[dot_i - 1].kind == TokenKind::RParen &&
  tokens[dot_i - 2].kind == TokenKind::IntLit && tokens[dot_i - 3].kind == TokenKind::Dot &&
  tokens[dot_i - 4].kind == TokenKind::Ident && tokens[dot_i - 5].kind == TokenKind::LParen &&
  !(dot_i >= 6 && !tokens[dot_i - 5].newline_before && (
    tokens[dot_i - 6].kind == TokenKind::Ident ||
    tokens[dot_i - 6].kind == TokenKind::UpperIdent ||
    tokens[dot_i - 6].kind == TokenKind::RParen ||
    tokens[dot_i - 6].kind == TokenKind::RBracket)) {
    let rty = lookup_ident_static_type(ctx, tokens[dot_i - 4].raw)
    if rty.length() > 0 {
      let mut idx = 0
      let raw_n = tokens[dot_i - 2].raw
      let mut k = 0
      while k < raw_n.length() {
        let c = raw_n.code_unit_at(k)
        if c >= 48 && c <= 57 { idx = idx * 10 + (c - 48) }
        k = k + 1
      }
      let ety = extract_tuple_elem_type(rty, idx)
      return try_resolve_static_val_field_from_ty(ctx, ety)
    }
    return None
  }
  // Case 0b: `<dot_chain>[k].val` (root-anchored dot chain before `[k]`)
  if dot_i >= 3 && tokens[dot_i - 1].kind == TokenKind::RBracket {
    let mut ob = dot_i - 2
    let mut d = 1
    while ob >= 0 && d > 0 {
      if tokens[ob].kind == TokenKind::RBracket { d = d + 1 }
      else if tokens[ob].kind == TokenKind::LBracket { d = d - 1 }
      if d == 0 { break }
      ob = ob - 1
    }
    if ob >= 1 && tokens[ob].kind == TokenKind::LBracket {
      let cty = resolve_dot_chain_static_type(ctx, tokens, ob - 1)
      if cty.length() > 0 {
        let vty = extract_container_value_type(cty)
        return try_resolve_static_val_field_from_ty(ctx, vty)
      }
    }
    return None
  }
  // Case 1/2/3: unified root-anchored dot chain (`@pkg.v.val`, `a.b.c.val`, `x.val`)
  let rty = resolve_dot_chain_static_type(ctx, tokens, dot_i - 1)
  if rty.length() > 0 {
    return try_resolve_static_val_field_from_ty(ctx, rty)
  }
  None
}

///| Check whether a `.val` assignment (`=` or `+=` etc.) must defer to Stage A.5's single-evaluation
///| receiver snapshot `{ let __mbt_r = <recv>; __mbt_r.v = ... }` instead of lowering directly to `.v`,
///| because Pion's LLBC keeps `root: r` by place reference when `r` is `mut` or RHS contains `{ ... }`.
fn should_defer_val_assign_to_a5(
  ctx : StageAContext,
  tokens : Array[Token],
  dot_i : Int,
  op_i : Int,
  end : Int,
) -> Bool {
  if op_i >= end || (tokens[op_i].kind != TokenKind::Eq && tokens[op_i].kind != TokenKind::AssignOp) {
    return false
  }
  let is_simple_ident_recv = dot_i >= 1 && tokens[dot_i - 1].kind == TokenKind::Ident &&
  !(dot_i >= 2 && (tokens[dot_i - 2].kind == TokenKind::Dot || tokens[dot_i - 2].kind == TokenKind::ColonColon ||
    (!tokens[dot_i - 1].newline_before && (tokens[dot_i - 2].kind == TokenKind::RParen || tokens[dot_i - 2].kind == TokenKind::RBracket || tokens[dot_i - 2].kind == TokenKind::RBrace))))
  let mut root_raw = ""
  if dot_i >= 5 && tokens[dot_i - 1].kind == TokenKind::RParen &&
  tokens[dot_i - 2].kind == TokenKind::IntLit && tokens[dot_i - 3].kind == TokenKind::Dot &&
  tokens[dot_i - 4].kind == TokenKind::Ident && tokens[dot_i - 5].kind == TokenKind::LParen &&
  !(dot_i >= 6 && !tokens[dot_i - 5].newline_before && (
    tokens[dot_i - 6].kind == TokenKind::Ident ||
    tokens[dot_i - 6].kind == TokenKind::UpperIdent ||
    tokens[dot_i - 6].kind == TokenKind::RParen ||
    tokens[dot_i - 6].kind == TokenKind::RBracket)) {
    root_raw = tokens[dot_i - 4].raw
  } else if dot_i >= 3 && tokens[dot_i - 1].kind == TokenKind::RBracket {
    let mut ob = dot_i - 2
    let mut d = 1
    while ob >= 0 && d > 0 {
      if tokens[ob].kind == TokenKind::RBracket { d = d + 1 }
      else if tokens[ob].kind == TokenKind::LBracket { d = d - 1 }
      if d == 0 { break }
      ob = ob - 1
    }
    if ob >= 1 && tokens[ob].kind == TokenKind::LBracket {
      root_raw = extract_dot_chain_root_ident(tokens, ob - 1)
    }
  } else {
    root_raw = extract_dot_chain_root_ident(tokens, dot_i - 1)
  }
  let mut root_is_known_immut = false
  if root_raw.length() > 0 {
    let eff = resolve_ident_in_scope(ctx, root_raw)
    match lookup_scope_var(ctx, eff) {
      Some(sv) => if sv.is_mut { return true } else { root_is_known_immut = true }
      None =>
      if eff != root_raw {
        match lookup_scope_var(ctx, root_raw) {
          Some(sv) => if sv.is_mut { return true } else { root_is_known_immut = true }
          None => ()
        }
      }
    }
  }
  if tokens[op_i].kind == TokenKind::Eq && is_simple_ident_recv && root_is_known_immut {
    return false
  }
  let rhs_end = find_expr_end(tokens, op_i + 1, end)
  let mut k = op_i + 1
  while k < rhs_end {
    // Skip closure literal bodies `fn(...) [-> T] { ... }` (not executed during RHS evaluation)
    if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "fn" &&
    k + 1 < rhs_end && tokens[k + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, k + 1)
      let mut lb = cp + 1
      while lb < rhs_end && tokens[lb].kind != TokenKind::LBrace {
        lb = lb + 1
      }
      if lb < rhs_end && tokens[lb].kind == TokenKind::LBrace {
        k = find_matching_delim(tokens, lb) + 1
        continue
      }
    }
    if tokens[k].kind == TokenKind::LBrace {
      return true
    }
    k = k + 1
  }
  false
}

///| Check if `{ val: expr }` is a Ref literal (defaults to `mbt_compat::ref_new`, overridable by `--recipes`).
///| NEVER misclassify `{ val: expr }` as `Ref` when expected type is a local struct with `val`
///| or when a local single-field `struct { val : ... }` exists and expected type is not `Ref[...]`.
fn try_lower_ref_literal(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> Option[String] {
  if ctx.symtab.local_types.contains("Ref") || ctx.active_generics.contains("Ref") {
    return None
  }
  let ref_ty = effective_ref_type(ctx.recipes)
  let ref_ctor = effective_ref_ctor(ctx.recipes)
  if close_b > open_b + 3 && tokens[open_b + 1].raw == "val" && tokens[open_b + 2].kind == TokenKind::Colon {
    let raw_exp = current_expected_type(ctx).trim()
    let exp_base = {
      let bi = raw_exp.index_of("[")
      if bi > 0 { raw_exp.slice(0, bi).trim() } else { raw_exp }
    }
    let is_ref_exp = exp_base == "Ref" || exp_base == "mbt_compat::Ref" || exp_base == ref_ty
    if !is_ref_exp {
      if exp_base.length() > 0 && ctx.struct_val_fields.contains(exp_base) {
        return None
      }
      for sname in ctx.struct_val_fields.keys() {
        match ctx.struct_field_renames.get(sname) {
          Some(rmap) =>
          if rmap.length() == 1 && rmap.contains("val") {
            return None
          }
          None => ()
        }
      }
    }
    // Ensure there are no other fields at depth 0
    let mut i = open_b + 3
    let mut depth = 0
    while i < close_b {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        // trailing comma ok if nothing after
        if i + 1 < close_b {
          return None
        }
      }
      i = i + 1
    }
    let val_expr = lower_expr_range(ctx, tokens, open_b + 3, close_b, file, false).trim()
    let clean_val = if val_expr.ends_with(",") { val_expr.slice(0, val_expr.length() - 1).trim() } else { val_expr }
    return Some(ref_ctor + "(" + clean_val + ")")
  }
  None
}

///| Check whether `( ... ) => ...` at `open_p` is an arrow function (not a match arm / constructor pattern).
fn is_arrow_fn_at(tokens : Array[Token], open_p : Int, end : Int) -> Int {
  // Constructor patterns like `Failure(msg) => ...` or `Some(v) => ...` are NEVER arrow functions (#12a P1-2)!
  if open_p > 0 && (tokens[open_p - 1].kind == TokenKind::UpperIdent || tokens[open_p - 1].kind == TokenKind::Ident) {
    return -1
  }
  let close_p = find_matching_delim(tokens, open_p)
  if close_p + 1 < end && tokens[close_p + 1].kind == TokenKind::FatArrow {
    // Verify params inside parens look like simple parameter bindings (not tuple patterns like `(None, None) =>`!)
    let mut i = open_p + 1
    let mut after_colon = false
    let mut depth = 0
    while i < close_p {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        after_colon = false
      } else if depth == 0 && k == TokenKind::Colon {
        after_colon = true
      } else if depth == 0 && !after_colon {
        if k != TokenKind::Ident && k != TokenKind::Underscore {
          return -1
        }
      } else if k != TokenKind::Ident && k != TokenKind::Underscore && k != TokenKind::Comma &&
      k != TokenKind::Colon && k != TokenKind::UpperIdent && k != TokenKind::LBracket &&
      k != TokenKind::RBracket && k != TokenKind::Question && k != TokenKind::Arrow &&
      k != TokenKind::ColonColon && k != TokenKind::PkgRef && k != TokenKind::Dot {
        return -1
      }
      i = i + 1
    }
    return close_p
  }
  -1
}

///| Find the end of a single expression (stopping at `,`, `;`, `)`, `}`, `]`, or newline statement boundary).
///| Preserves consecutive `#|` / `$|` multiline strings, `if ... else`, and newline-leading chained calls/operators.
fn find_expr_end(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut i = start
  let mut depth = 0
  while i < end {
    let k = tokens[i].kind
    if depth == 0 && i > start && tokens[i].newline_before {
      let pk = tokens[i - 1].kind
      let is_multiline_str_cont = (k == TokenKind::RawMultiline && pk == TokenKind::RawMultiline) ||
      (k == TokenKind::InterpMultiline && pk == TokenKind::InterpMultiline)
      let is_else_cont = k == TokenKind::Keyword && tokens[i].raw == "else"
      let is_leading_cont = k == TokenKind::PipeGt || k == TokenKind::Dot || k == TokenKind::DotDot ||
      k == TokenKind::AmpAmp || k == TokenKind::PipePipe || k == TokenKind::Plus ||
      k == TokenKind::Star || k == TokenKind::Slash || k == TokenKind::Percent ||
      k == TokenKind::EqEq || k == TokenKind::BangEq || is_multiline_str_cont || is_else_cont
      let is_trailing_cont = pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
      pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::Eq ||
      pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::PipeGt ||
      pk == TokenKind::Colon || pk == TokenKind::Arrow || pk == TokenKind::FatArrow ||
      pk == TokenKind::Dot || pk == TokenKind::Comma
      if !is_leading_cont && !is_trailing_cont {
        return i
      }
    }
    if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
      depth = depth + 1
      i = i + 1
      continue
    }
    if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
      if depth == 0 {
        return i
      }
      depth = depth - 1
      i = i + 1
      continue
    }
    if depth == 0 && (k == TokenKind::Comma || k == TokenKind::Semi) {
      return i
    }
    i = i + 1
  }
  end
}

///| Find the end of a top-level `let` / `const` initializer expression using balanced token boundaries
///| (never truncating multi-line expressions, `#|`/`$|` blocks, chained calls, or `if`/`match` arms!).
fn find_top_level_let_expr_end(tokens : Array[Token], start : Int, end : Int) -> Int {
  let mut i = start
  let mut depth = 0
  while i < end {
    let k = tokens[i].kind
    if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
      depth = depth + 1
      i = i + 1
      continue
    }
    if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
      if depth == 0 {
        return i
      }
      depth = depth - 1
      i = i + 1
      continue
    }
    if depth == 0 && k == TokenKind::Semi {
      return i
    }
    if depth == 0 && i > start && tokens[i].newline_before {
      let pk = tokens[i - 1].kind
      let is_multiline_str_cont = (k == TokenKind::RawMultiline && pk == TokenKind::RawMultiline) ||
      (k == TokenKind::InterpMultiline && pk == TokenKind::InterpMultiline)
      let is_else_cont = k == TokenKind::Keyword && tokens[i].raw == "else"
      let is_leading_cont = k == TokenKind::PipeGt || k == TokenKind::Dot || k == TokenKind::DotDot ||
      k == TokenKind::AmpAmp || k == TokenKind::PipePipe || k == TokenKind::Plus ||
      k == TokenKind::Minus || k == TokenKind::Star || k == TokenKind::Slash ||
      k == TokenKind::Percent || k == TokenKind::EqEq || k == TokenKind::BangEq ||
      k == TokenKind::Pipe || k == TokenKind::Amp || k == TokenKind::Caret ||
      k == TokenKind::Shl || k == TokenKind::Shr ||
      is_multiline_str_cont || is_else_cont
      let is_trailing_cont = pk == TokenKind::Plus || pk == TokenKind::Minus || pk == TokenKind::Star ||
      pk == TokenKind::Slash || pk == TokenKind::Percent || pk == TokenKind::Eq ||
      pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::PipeGt ||
      pk == TokenKind::Pipe || pk == TokenKind::Amp || pk == TokenKind::Caret ||
      pk == TokenKind::Shl || pk == TokenKind::Shr ||
      pk == TokenKind::Colon || pk == TokenKind::Arrow || pk == TokenKind::FatArrow ||
      pk == TokenKind::Dot || pk == TokenKind::Comma
      if !is_leading_cont && !is_trailing_cont {
        // Stop on any new top-level declaration (except anonymous `fn(` closure)
        let is_anon_fn = k == TokenKind::Keyword && tokens[i].raw == "fn" &&
        i + 1 < end && tokens[i + 1].kind == TokenKind::LParen
        if is_top_level_decl_start(tokens, i) && !is_anon_fn {
          return i
        }
        return i
      }
    }
    i = i + 1
  }
  end
}

///| Look up the innermost lexical `ScopeVar` matching `name`.
fn lookup_scope_var(ctx : StageAContext, name : String) -> Option[ScopeVar] {
  let mut i = ctx.scope_vars.length() - 1
  while i >= 0 {
    if ctx.scope_vars[i].name == name {
      return Some(ctx.scope_vars[i])
    }
    i = i - 1
  }
  None
}

///| Truncate `ctx.scope_vars` back to `saved_len` on block exit.
fn restore_scope_vars(ctx : StageAContext, saved_len : Int) -> Unit {
  while ctx.scope_vars.length() > saved_len {
    let _ = ctx.scope_vars.pop()
  }
}

///| Extract depth-0 generic type parameter names from `[T, U : Bound, ...]`, skipping bounds after `:` / `::` / `+`.
fn collect_generic_param_names(tokens : Array[Token], open_br : Int, close_br : Int) -> Array[String] {
  let out : Array[String] = []
  let mut gi = open_br + 1
  let mut gd = 0
  while gi < close_br {
    let gk = tokens[gi].kind
    if gk == TokenKind::LBracket || gk == TokenKind::LParen {
      gd = gd + 1
    } else if gk == TokenKind::RBracket || gk == TokenKind::RParen {
      if gd > 0 { gd = gd - 1 }
    } else if gd == 0 && gk == TokenKind::UpperIdent {
      let prev_bound = gi > open_br + 1 &&
      (tokens[gi - 1].kind == TokenKind::Colon || tokens[gi - 1].kind == TokenKind::ColonColon || tokens[gi - 1].kind == TokenKind::Plus)
      if !prev_bound {
        out.push(tokens[gi].raw)
      }
    }
    gi = gi + 1
  }
  out
}

///| Push generic parameter names onto `ctx.active_generics` and `ctx.symtab.active_generics`,
///| returning ONLY newly added names so `pop_active_generics` never removes an outer same-named generic.
fn push_active_generics(ctx : StageAContext, names : Array[String]) -> Array[String] {
  let added : Array[String] = []
  for gn in names {
    if !ctx.symtab.active_generics.contains(gn) {
      ctx.active_generics[gn] = true
      ctx.symtab.active_generics[gn] = true
      added.push(gn)
    }
  }
  added
}

///| Remove previously added generic parameter names on declaration exit.
fn pop_active_generics(ctx : StageAContext, added : Array[String]) -> Unit {
  for gn in added {
    ctx.active_generics.remove(gn)
    ctx.symtab.active_generics.remove(gn)
  }
}

///| Recursively collect all lowercase pattern-bound identifiers in `[s, e)` (normalized via `rename_keyword_ident`).
fn collect_pat_binders_rec(tokens : Array[Token], s : Int, e : Int, out : Array[String]) -> Unit {
  let mut i = s
  while i < e {
    let t = tokens[i]
    if t.kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i)
      let mut fi = i + 1
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
          fi = fi + 1
          continue
        }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        if fi + 1 < fe && (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
        tokens[fi + 1].kind == TokenKind::Colon {
          collect_pat_binders_rec(tokens, fi + 2, fe, out)
        } else if fi < fe && tokens[fi].kind == TokenKind::Ident {
          if tokens[fi].raw != "_" {
            out.push(rename_keyword_ident(tokens[fi].raw))
          }
          if fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Keyword && tokens[fi + 1].raw == "as" &&
          tokens[fi + 2].kind == TokenKind::Ident && tokens[fi + 2].raw != "_" {
            out.push(rename_keyword_ident(tokens[fi + 2].raw))
          }
        }
        fi = fe + 1
      }
      i = cb + 1
      continue
    }
    if t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      let mut ai = i + 1
      while ai < cp {
        if tokens[ai].kind == TokenKind::Comma || tokens[ai].kind == TokenKind::DotDot {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < cp {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ai + 1 < ae && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          collect_pat_binders_rec(tokens, ai + 2, ae, out)
        } else if ai + 1 < ae && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          if tokens[ai].raw != "_" {
            out.push(rename_keyword_ident(tokens[ai].raw))
          }
        } else {
          collect_pat_binders_rec(tokens, ai, ae, out)
        }
        ai = ae + 1
      }
      i = cp + 1
      continue
    }
    if t.kind == TokenKind::LBracket {
      let cbr = find_matching_delim(tokens, i)
      collect_pat_binders_rec(tokens, i + 1, cbr, out)
      i = cbr + 1
      continue
    }
    if t.kind == TokenKind::Ident && t.raw != "_" {
      let prev_qual = i > s && (tokens[i - 1].kind == TokenKind::ColonColon || tokens[i - 1].kind == TokenKind::Dot)
      if !prev_qual {
        out.push(rename_keyword_ident(t.raw))
      }
    }
    i = i + 1
  }
}

///| Collect all pattern-bound lowercase variable names in `[start, end)`.
fn collect_pattern_binders(tokens : Array[Token], start : Int, end : Int) -> Array[String] {
  let out : Array[String] = []
  collect_pat_binders_rec(tokens, start, end, out)
  out
}

///| Push a list of lexical binder names onto `ctx.scope_vars`.
fn push_scope_binders(ctx : StageAContext, names : Array[String]) -> Unit {
  for nm in names {
    if nm.length() > 0 && nm != "_" {
      ctx.scope_vars.push(ScopeVar::{ name: nm, ty: "", is_mut: false, is_boxed: false })
    }
  }
}

///| Lower a boolean condition `[start, end)` segment-by-segment across depth-0 `&&`,
///| pushing any `is <Pat>` binders onto `ctx.scope_vars` so subsequent `&&` segments
///| and the guarded body observe lexical shadowing.
fn lower_cond_with_is_binders(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut seg_s = start
  while seg_s < end {
    let mut seg_e = seg_s
    let mut d = 0
    while seg_e < end {
      let k = tokens[seg_e].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && k == TokenKind::AmpAmp { break }
      seg_e = seg_e + 1
    }
    sb.write_string(lower_expr_range(ctx, tokens, seg_s, seg_e, file, false))
    // Scan this segment for depth-0 `is <Pat>` and push its binders for subsequent `&&` and body
    let mut k = seg_s
    let mut kd = 0
    while k < seg_e {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { kd = kd + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if kd > 0 { kd = kd - 1 } }
      else if kd == 0 && kk == TokenKind::Keyword && tokens[k].raw == "is" && k + 1 < seg_e {
        let mut pe = k + 1
        let mut pd = 0
        while pe < seg_e {
          let pk = tokens[pe].kind
          if pd == 0 && pe > k + 1 && tokens[pe].newline_before { break }
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
            if pd == 0 { break }
            pd = pd - 1
          } else if pd == 0 && (pk == TokenKind::PipePipe || pk == TokenKind::EqEq || pk == TokenKind::BangEq) {
            break
          }
          pe = pe + 1
        }
        push_scope_binders(ctx, collect_pattern_binders(tokens, k + 1, pe))
        k = pe
        continue
      }
      k = k + 1
    }
    if seg_e < end && tokens[seg_e].kind == TokenKind::AmpAmp {
      sb.write_string(tokens[seg_e].leading_trivia + "&&")
      seg_s = seg_e + 1
    } else {
      break
    }
  }
  sb.to_string()
}

///| Best-effort static type inference for an unannotated `let [mut] x = <rhs>` initializer
///| (literals, bools, struct literals, and outer scope variables). Returns `""` if unknown.
fn infer_simple_expr_type(ctx : StageAContext, tokens : Array[Token], start : Int, end : Int) -> String {
  if start >= end {
    return ""
  }
  let t = tokens[start]
  if start + 1 == end {
    if t.kind == TokenKind::IntLit {
      let r = t.raw
      if r.ends_with("UL") || r.ends_with("ul") { return "UInt64" }
      if r.ends_with("L") || r.ends_with("l") { return "Int64" }
      if r.ends_with("U") || r.ends_with("u") { return "UInt" }
      return "Int"
    }
    if t.kind == TokenKind::FloatLit {
      if t.raw.ends_with("F") { return "Float" }
      return "Double"
    }
    if t.kind == TokenKind::StringLit || t.kind == TokenKind::InterpString || t.kind == TokenKind::RawMultiline || t.kind == TokenKind::InterpMultiline {
      return "String"
    }
    if t.kind == TokenKind::CharLit { return "Char" }
    if t.kind == TokenKind::ByteCharLit { return "Byte" }
    if t.kind == TokenKind::ByteStringLit { return "Bytes" }
    if t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false") { return "Bool" }
    if t.kind == TokenKind::Ident {
      let nm = resolve_ident_in_scope(ctx, t.raw)
      match lookup_scope_var(ctx, nm) {
        Some(sv) => return sv.ty
        None => ()
      }
      match ctx.symtab.val_types.get(t.raw) {
        Some(vt) => return vt
        None => ()
      }
    }
  }
  // Sound Ref literal `{ val: expr }` or `Ref::new(expr)` -> `mbt_compat::Ref` (when unshadowed)
  if !ctx.symtab.local_types.contains("Ref") && !ctx.active_generics.contains("Ref") {
    if t.kind == TokenKind::LBrace && find_matching_delim(tokens, start) == end - 1 {
      let cb = end - 1
      if cb > start + 3 && tokens[start + 1].raw == "val" && tokens[start + 2].kind == TokenKind::Colon {
        let mut has_single_val_struct = false
        for sname in ctx.struct_val_fields.keys() {
          match ctx.struct_field_renames.get(sname) {
            Some(rmap) => if rmap.length() == 1 && rmap.contains("val") { has_single_val_struct = true; break }
            None => ()
          }
        }
        if !has_single_val_struct {
          let mut single = true
          let mut k = start + 3
          let mut d = 0
          while k < cb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
            else if d == 0 && kk == TokenKind::Comma && k + 1 < cb { single = false; break }
            k = k + 1
          }
          if single {
            return effective_ref_type(ctx.recipes)
          }
        }
      }
    }
    if t.kind == TokenKind::UpperIdent && t.raw == "Ref" &&
    ((start + 3 < end && tokens[start + 1].kind == TokenKind::ColonColon && tokens[start + 2].raw == "new" && tokens[start + 3].kind == TokenKind::LParen && find_matching_delim(tokens, start + 3) == end - 1) ||
      (start + 1 < end && tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1)) {
      return effective_ref_type(ctx.recipes)
    }
  }
  if t.kind == TokenKind::LBrace && find_matching_delim(tokens, start) == end - 1 {
    match resolve_anon_struct_literal_name(ctx, tokens, start, end - 1) {
      Some(sname) => return sname
      None => ()
    }
  }
  if t.kind == TokenKind::LParen && find_matching_delim(tokens, start) == end - 1 {
    let cp = end - 1
    let tup_tys : Array[String] = []
    let mut ti = start + 1
    let mut has_comma = false
    while ti < cp {
      if tokens[ti].kind == TokenKind::Comma { has_comma = true; ti = ti + 1; continue }
      let mut te = ti
      let mut td = 0
      while te < cp {
        let tk = tokens[te].kind
        if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
        else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
        else if td == 0 && tk == TokenKind::Comma { has_comma = true; break }
        te = te + 1
      }
      if te > ti {
        tup_tys.push(infer_simple_expr_type(ctx, tokens, ti, te))
      }
      ti = te + 1
    }
    if has_comma && tup_tys.length() >= 2 {
      return "(" + join_comma(tup_tys) + ")"
    }
  }
  // `match recv.field.get(...) { Some(h) => h, ... }` -> container value type of `recv.field`
  if t.kind == TokenKind::Keyword && t.raw == "match" && start + 5 < end &&
  tokens[start + 1].kind == TokenKind::Ident && tokens[start + 2].kind == TokenKind::Dot &&
  tokens[start + 3].kind == TokenKind::Ident && tokens[start + 4].kind == TokenKind::Dot &&
  tokens[start + 5].raw == "get" {
    let base_ty = lookup_ident_static_type(ctx, tokens[start + 1].raw)
    if base_ty.length() > 0 {
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
        Some(fm) =>
        match fm.get(tokens[start + 3].raw) {
          Some(ft) => {
            let vty = extract_container_value_type(ft)
            if vty.length() > 0 {
              return vty
            }
          }
          None => ()
        }
        None => ()
      }
    }
  }
  // Field access `a.b` and `.values().collect()` -> `Array[V]`
  if t.kind == TokenKind::Ident && start + 2 < end && tokens[start + 1].kind == TokenKind::Dot && tokens[start + 2].kind == TokenKind::Ident {
    let base_ty = lookup_ident_static_type(ctx, t.raw)
    if base_ty.length() > 0 {
      let mut cur_ty = ""
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(base_ty)) {
        Some(fm) => match fm.get(tokens[start + 2].raw) { Some(ft) => cur_ty = ft, None => () }
        None => ()
      }
      if cur_ty.length() > 0 {
        if start + 3 == end {
          return cur_ty
        }
        if start + 5 < end && tokens[start + 3].kind == TokenKind::Dot && tokens[start + 4].raw == "values" {
          let vty = extract_container_value_type(cur_ty)
          if vty.length() > 0 {
            return "Array[" + vty + "]"
          }
        }
      }
    }
  }
  if start + 2 == end && t.kind == TokenKind::Minus && tokens[start + 1].kind == TokenKind::IntLit {
    let r = tokens[start + 1].raw
    if r.ends_with("L") || r.ends_with("l") { return "Int64" }
    return "Int"
  }
  if start + 2 == end && t.kind == TokenKind::Minus && tokens[start + 1].kind == TokenKind::FloatLit {
    let r = tokens[start + 1].raw
    if r.ends_with("F") { return "Float" }
    return "Double"
  }
  if t.kind == TokenKind::UpperIdent && start + 2 < end && tokens[start + 1].kind == TokenKind::ColonColon && tokens[start + 2].kind == TokenKind::LBrace &&
  find_matching_delim(tokens, start + 2) == end - 1 {
    return t.raw
  }
  if t.kind == TokenKind::UpperIdent && ctx.symtab.tuple_structs.contains(t.raw) && start + 1 < end && tokens[start + 1].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 1) == end - 1 {
    return t.raw
  }
  if t.kind == TokenKind::LBracket {
    let cb = find_matching_delim(tokens, start)
    if cb == end - 1 && cb > start + 1 {
      let mut first_end = start + 1
      let mut d = 0
      while first_end < cb {
        let k = tokens[first_end].kind
        if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
        else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
        else if d == 0 && k == TokenKind::Comma { break }
        first_end = first_end + 1
      }
      let ety = infer_simple_expr_type(ctx, tokens, start + 1, first_end)
      if ety.length() > 0 {
        return "Array[" + ety + "]"
      }
    }
  }
  // Package-qualified call `@pkg.fn(...)` -> look up `symtab.fn_ret_types` (ONLY when no trailing `.method(...)` chain!)
  if t.kind == TokenKind::PkgRef && start + 3 < end &&
  tokens[start + 1].kind == TokenKind::Dot && tokens[start + 3].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 3) == end - 1 {
    let raw_pkg = t.raw.slice(1, t.raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None => raw_pkg
    }
    let fname = tokens[start + 2].raw
    let rty = match ctx.symtab.fn_ret_types.get(raw_pkg + "::" + fname) {
      Some(r) => r
      None => match ctx.symtab.fn_ret_types.get(mapped_pkg + "::" + fname) {
        Some(r) => r
        None => ""
      }
    }
    if rty.length() > 0 {
      // Substitute single type param `[T]` from first argument when possible (e.g. `Signal[T]` -> `Signal[Double]`)
      if str_has(rty, "[T]") {
        let cp = find_matching_delim(tokens, start + 3)
        if cp > start + 4 {
          let arg_ty = infer_simple_expr_type(ctx, tokens, start + 4, cp)
          if arg_ty.length() > 0 {
            return str_replace_all(rty, "[T]", "[" + arg_ty + "]")
          }
        }
      }
      return rty
    }
  }
  // Local function call `f(...)` -> look up `symtab.fn_ret_types` (ONLY when no trailing `.method(...)` chain!)
  if t.kind == TokenKind::Ident && start + 1 < end && tokens[start + 1].kind == TokenKind::LParen &&
  find_matching_delim(tokens, start + 1) == end - 1 {
    let fname = rename_keyword_ident(t.raw)
    if ctx.cur_is_blackbox {
      match ctx.symtab.blackbox_fn_ret_types.get(fname) {
        Some(r) => if r.length() > 0 { return r }
        None => ()
      }
      if !ctx.symtab.blackbox_decls.contains(t.raw) {
        match ctx.symtab.fn_ret_types.get(fname) {
          Some(r) => if r.length() > 0 { return r }
          None => ()
        }
      }
    } else {
      match ctx.symtab.fn_ret_types.get(fname) {
        Some(r) => if r.length() > 0 { return r }
        None => ()
      }
    }
    match lookup_scope_var(ctx, fname) {
      Some(sv) => {
        let arrow_i = sv.ty.index_of("->")
        if arrow_i >= 0 {
          return sv.ty.slice(arrow_i + 2, sv.ty.length()).trim()
        }
      }
      None => ()
    }
  }
  // Trailing Option-returning stdlib method calls `.get(...)`, `.rev_find(...)`, `.search(...)`, `.pop()`
  if end >= start + 4 && tokens[end - 1].kind == TokenKind::RParen {
    // Walk back to matching LParen
    let mut d = 1
    let mut lp = end - 2
    while lp > start && d > 0 {
      let lk = tokens[lp].kind
      if lk == TokenKind::RParen { d = d + 1 }
      else if lk == TokenKind::LParen { d = d - 1; if d == 0 { break } }
      lp = lp - 1
    }
    if d == 0 && lp >= start + 2 && tokens[lp - 2].kind == TokenKind::Dot && tokens[lp - 1].kind == TokenKind::Ident {
      let mn = tokens[lp - 1].raw
      if mn == "get" || mn == "rev_find" || mn == "search" || mn == "search_by" || mn == "pop" || mn == "last" {
        return "Option"
      }
    }
  }
  // Parenthesized field call `(obj.field)()` -> look up `struct_field_types` closure return type
  if t.kind == TokenKind::LParen && start + 4 < end &&
  tokens[start + 1].kind == TokenKind::Ident && tokens[start + 2].kind == TokenKind::Dot &&
  tokens[start + 3].kind == TokenKind::Ident && tokens[start + 4].kind == TokenKind::RParen &&
  start + 5 < end && tokens[start + 5].kind == TokenKind::LParen {
    match lookup_scope_var(ctx, rename_keyword_ident(tokens[start + 1].raw)) {
      Some(sv) =>
      match ctx.symtab.struct_field_types.get(strip_type_args_sym(sv.ty)) {
        Some(fmap) =>
        match fmap.get(tokens[start + 3].raw) {
          Some(fty) => {
            let arrow_i = fty.index_of("->")
            if arrow_i >= 0 {
              return fty.slice(arrow_i + 2, fty.length()).trim()
            }
          }
          None => ()
        }
        None => ()
      }
      None => ()
    }
  }
  // Zero-arg anonymous closure `fn() { ... }` -> infer `() -> <ret>` from explicit ret or last expr
  if t.kind == TokenKind::Keyword && t.raw == "fn" && start + 2 < end &&
  tokens[start + 1].kind == TokenKind::LParen && tokens[start + 2].kind == TokenKind::RParen {
    if start + 3 < end && tokens[start + 3].kind == TokenKind::Arrow {
      let mut lb = start + 4
      while lb < end && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
      let rty = lower_type_tokens(tokens, start + 4, lb, ctx.symtab, ctx.recipes).trim()
      if rty.length() > 0 { return "() -> " + rty }
    } else if start + 3 < end && tokens[start + 3].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, start + 3)
      // Scan for `None => <lit>` or tail literal inside body
      let mut k = cb - 1
      while k > start + 3 {
        if tokens[k].kind == TokenKind::FloatLit {
          if tokens[k].raw.ends_with("F") { return "() -> Float" }
          return "() -> Double"
        }
        if tokens[k].kind == TokenKind::IntLit { return "() -> Int" }
        if tokens[k].kind == TokenKind::StringLit { return "() -> String" }
        if tokens[k].kind == TokenKind::Keyword && (tokens[k].raw == "true" || tokens[k].raw == "false") { return "() -> Bool" }
        k = k - 1
      }
    }
  }
  ""
}

///| Parsed local `fn` header inside a block.
struct LocalFnDecl {
  start_tok : Int
  end_tok : Int
  name : String
  open_p : Int
  close_p : Int
  ret_start : Int
  ret_end : Int
  lb : Int
  rb : Int
  line : Int
  col : Int
}

///| Try to parse a local `fn name(params) [-> Ret] { body }` starting at `i` within `[i, end)`.
fn try_parse_local_fn_decl(tokens : Array[Token], i : Int, end : Int) -> Option[LocalFnDecl] {
  if i + 2 >= end {
    return None
  }
  if !(tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "fn" &&
    tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LParen) {
    return None
  }
  let fn_name = rename_keyword_ident(tokens[i + 1].raw)
  let open_p = i + 2
  let close_p = find_matching_delim(tokens, open_p)
  let mut cur = close_p + 1
  let mut ret_start = -1
  let mut ret_end = -1
  if cur < end && tokens[cur].kind == TokenKind::Arrow {
    ret_start = cur + 1
    let mut r_end = cur + 1
    let mut rd = 0
    while r_end < end {
      let rk = tokens[r_end].kind
      if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
        break
      }
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
        rd = rd + 1
      } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
        if rd > 0 { rd = rd - 1 }
      }
      r_end = r_end + 1
    }
    ret_end = r_end
    cur = r_end
  } else {
    let mut rd = 0
    while cur < end {
      let rk = tokens[cur].kind
      if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
        break
      }
      if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
        rd = rd + 1
      } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
        if rd > 0 { rd = rd - 1 }
      }
      cur = cur + 1
    }
  }
  if cur >= end || tokens[cur].kind != TokenKind::LBrace {
    return None
  }
  let rb = find_matching_delim(tokens, cur)
  Some(LocalFnDecl::{
    start_tok: i,
    end_tok: rb + 1,
    name: fn_name,
    open_p: open_p,
    close_p: close_p,
    ret_start: ret_start,
    ret_end: ret_end,
    lb: cur,
    rb: rb,
    line: tokens[i].line,
    col: tokens[i].col,
  })
}

///| Collect all identifier names referenced (not after `.` or `::`) inside `[start, end)`.
fn collect_body_ident_set(tokens : Array[Token], start : Int, end : Int) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    if t.kind == TokenKind::Ident {
      let prev_dot_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      let next_colon = i + 1 < end && tokens[i + 1].kind == TokenKind::Colon
      if !prev_dot_cc && !next_colon {
        out[rename_keyword_ident(t.raw)] = true
      }
    }
    i = i + 1
  }
  out
}

///| Check whether a local `fn` group is recursive (any member directly or mutually references a member).
fn local_fn_group_is_recursive(tokens : Array[Token], group : Array[LocalFnDecl]) -> Bool {
  let gnames : Map[String, Bool] = Map()
  for g in group {
    gnames[g.name] = true
  }
  for g in group {
    let refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
    for gn in gnames.keys() {
      if refs.contains(gn) {
        return true
      }
    }
  }
  false
}

///| Check whether `fn_name` is used as a first-class escaping value (i.e. NOT immediately followed by `(`)
///| anywhere in `[start, end)`.
fn is_local_fn_used_as_value(tokens : Array[Token], start : Int, end : Int, fn_name : String) -> Bool {
  let mut i = start
  while i < end && i < tokens.length() {
    let t = tokens[i]
    if t.kind == TokenKind::Ident && rename_keyword_ident(t.raw) == fn_name {
      let prev_dot_cc = i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      if !prev_dot_cc {
        let next_is_call = i + 1 < end && tokens[i + 1].kind == TokenKind::LParen
        if !next_is_call {
          return true
        }
      }
    }
    i = i + 1
  }
  false
}

///| Pre-scan a top-level `fn` body for `let mut` variables referenced inside any recursive local `fn`.
fn prescan_boxed_mut_vars(tokens : Array[Token], start : Int, end : Int, boxed : Map[String, Bool]) -> Unit {
  let mut_vars : Map[String, Bool] = Map()
  let mut i = start
  while i < end {
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" &&
    i + 2 < end && tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut" &&
    tokens[i + 2].kind == TokenKind::Ident {
      mut_vars[rename_keyword_ident(tokens[i + 2].raw)] = true
    }
    i = i + 1
  }
  if mut_vars.length() == 0 {
    return
  }
  i = start
  while i < end {
    match try_parse_local_fn_decl(tokens, i, end) {
      Some(first_decl) => {
        let group : Array[LocalFnDecl] = [first_decl]
        let mut scan = first_decl.end_tok
        while scan < end {
          if tokens[scan].kind == TokenKind::Semi {
            scan = scan + 1
            continue
          }
          match try_parse_local_fn_decl(tokens, scan, end) {
            Some(nxt) => {
              group.push(nxt)
              scan = nxt.end_tok
            }
            None => break
          }
        }
        if local_fn_group_is_recursive(tokens, group) {
          for g in group {
            let refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
            for mv in mut_vars.keys() {
              if refs.contains(mv) {
                boxed[mv] = true
              }
            }
          }
        }
        i = scan
        continue
      }
      None => ()
    }
    i = i + 1
  }
}

///| Extract raw (unrenamed) parameter names from `[open_p, close_p]` for collision-free keyword param renaming.
fn extract_raw_param_names(tokens : Array[Token], open_p : Int, close_p : Int) -> Array[String] {
  let out : Array[String] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    let mut p_end = i
    let mut d = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Comma { break }
      p_end = p_end + 1
    }
    if p_end > i {
      out.push(tokens[i].raw)
    }
    i = p_end + 1
  }
  out
}

///| Extract `(param_names, param_types, all_typed)` from a parameter list `[open_p, close_p]`.
fn extract_param_info(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
) -> (Array[String], Array[String], Bool) {
  let names : Array[String] = []
  let tys : Array[String] = []
  let mut all_typed = true
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma {
      i = i + 1
      continue
    }
    let mut p_end = i
    let mut d = 0
    while p_end < close_p {
      let k = tokens[p_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Comma { break }
      p_end = p_end + 1
    }
    if p_end > i {
      let pname = rename_keyword_ident(tokens[i].raw)
      let mut colon_i = -1
      let mut eq_i = -1
      let mut s = i + 1
      let mut d2 = 0
      while s < p_end {
        let sk = tokens[s].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { d2 = d2 + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { d2 = d2 - 1 }
        else if d2 == 0 {
          if sk == TokenKind::Colon && colon_i < 0 { colon_i = s }
          else if sk == TokenKind::Eq && eq_i < 0 { eq_i = s }
        }
        s = s + 1
      }
      let ty_end = if eq_i >= 0 { eq_i } else { p_end }
      let is_opt_param = i + 1 < p_end && tokens[i + 1].kind == TokenKind::Question && eq_i < 0
      let raw_pty = if colon_i >= 0 {
        lower_type_tokens_checked(ctx, tokens, colon_i + 1, ty_end, file).trim()
      } else {
        all_typed = false
        ""
      }
      let pty = if is_opt_param && raw_pty.length() > 0 && !raw_pty.starts_with("Option[") {
        "Option[" + raw_pty + "]"
      } else {
        raw_pty
      }
      names.push(pname)
      tys.push(pty)
    }
    i = p_end + 1
  }
  (names, tys, all_typed)
}

///| Lower a block `{ ... }` handling value-returning `guard` statements by rewriting
///| non-diverging `guard cond else { fallback }; rest...` into `if`/`match` with the remainder!
pub fn lower_block_range(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
  prelude : String,
) -> String {
  let saved_scope = ctx.scope_vars.length()
  let saved_renames = ctx.ident_renames.length()
  let saved_lifted : Array[(String, LiftedLocalFn)] = []
  for k in ctx.lifted_local_fns.keys() {
    match ctx.lifted_local_fns.get(k) {
      Some(v) => saved_lifted.push((k, v))
      None => ()
    }
  }
  let sb = StringBuilder()
  sb.write_string("{")
  if prelude.length() > 0 {
    sb.write_string("\n")
    sb.write_string(prelude)
  }
  let inner = lower_stmts_range(ctx, tokens, open_b + 1, close_b, file)
  sb.write_string(inner)
  sb.write_string(tokens[close_b].leading_trivia)
  sb.write_string("}")
  restore_scope_vars(ctx, saved_scope)
  restore_ident_renames(ctx, saved_renames)
  ctx.lifted_local_fns.clear()
  for kv in saved_lifted {
    ctx.lifted_local_fns[kv.0] = kv.1
  }
  sb.to_string()
}

///| Lower a sequence of statements inside a block `[start, end)`.
///| Rewrites value-returning `guard` with its remainder; preserves diverging `guard` untouched!
fn lower_stmts_range(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let t = tokens[i]
    // Check for `guard <cond> else { ... }`
    if t.kind == TokenKind::Keyword && t.raw == "guard" {
      // Find matching `else` at depth 0
      let mut j = i + 1
      let mut depth = 0
      let mut else_idx = -1
      while j < end {
        let jk = tokens[j].kind
        if jk == TokenKind::LParen || jk == TokenKind::LBrace || jk == TokenKind::LBracket {
          depth = depth + 1
        } else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace {
          depth = depth - 1
        } else if depth == 0 && jk == TokenKind::Keyword && tokens[j].raw == "else" {
          else_idx = j
          break
        }
        j = j + 1
      }
      if else_idx > i && else_idx + 1 < end && tokens[else_idx + 1].kind == TokenKind::LBrace {
        let else_open = else_idx + 1
        let else_close = find_matching_delim(tokens, else_open)
        if !block_diverges(tokens, else_open, else_close) {
          // Value-returning `guard`! Rewrite together with the remainder `[after_else, end)`.
          let mut after_else = else_close + 1
          if after_else < end && tokens[after_else].kind == TokenKind::Semi {
            after_else = after_else + 1
          }
          let else_body = lower_block_range(ctx, tokens, else_open, else_close, file, "")
          // Check if condition is `<scrut> is <Pat>` (without top-level `&&`) -> lower to `match <scrut> { <Pat> => { <rest> }, _ => <else> }`
          let mut is_idx = -1
          let mut has_ampamp = false
          let mut ci = i + 1
          let mut cd = 0
          while ci < else_idx {
            let ck = tokens[ci].kind
            if ck == TokenKind::LParen || ck == TokenKind::LBracket || ck == TokenKind::LBrace {
              cd = cd + 1
            } else if ck == TokenKind::RParen || ck == TokenKind::RBracket || ck == TokenKind::RBrace {
              cd = cd - 1
            } else if cd == 0 {
              if ck == TokenKind::Keyword && tokens[ci].raw == "is" && is_idx < 0 {
                is_idx = ci
              } else if ck == TokenKind::AmpAmp {
                has_ampamp = true
              }
            }
            ci = ci + 1
          }
          sb.write_string(t.leading_trivia)
          let saved_g_sc = ctx.scope_vars.length()
          let saved_g_rn = ctx.ident_renames.length()
          let cond_str = lower_cond_with_is_binders(ctx, tokens, i + 1, else_idx, file).trim()
          let rest_body = lower_stmts_range(ctx, tokens, after_else, end, file)
          restore_scope_vars(ctx, saved_g_sc)
          restore_ident_renames(ctx, saved_g_rn)
          if is_idx > i + 1 && !has_ampamp {
            let scrut_str = lower_expr_range(ctx, tokens, i + 1, is_idx, file, false).trim()
            let pat_str = lower_expr_range(ctx, tokens, is_idx + 1, else_idx, file, true).trim()
            sb.write_string("match " + scrut_str + " {\n    " + pat_str + " => {\n" + rest_body + "\n    }\n    _ => " + else_body + "\n  }")
          } else {
            sb.write_string("if " + cond_str + " {\n" + rest_body + "\n  } else " + else_body)
          }
          ctx.drift_ledger.push(DriftEntry::{
            category: "value_guard",
            file: file,
            line: t.line,
            col: t.col,
            expr: "guard " + cond_str,
            resolution: if is_idx > i + 1 && !has_ampamp { "rewritten_to_match_with_remainder" } else { "rewritten_to_if_else_with_remainder" },
            status: "resolved",
            detail: "non-diverging guard else rewritten with enclosing block remainder",
          })
          return sb.to_string()
        }
        // Diverging `guard`: lower `else` first (without `is` binders), then lower cond pushing `is` binders for remainder of block!
        let else_body = lower_block_range(ctx, tokens, else_open, else_close, file, "")
        let cond_str = lower_cond_with_is_binders(ctx, tokens, i + 1, else_idx, file)
        sb.write_string(t.leading_trivia)
        sb.write_string("guard" + cond_str + tokens[else_idx].leading_trivia + "else" + tokens[else_open].leading_trivia + else_body)
        i = else_close + 1
        continue
      }
    }

    // Local named `fn go(a : T) -> R { ... }` — strict declaration-order visibility!
    // Each local `fn` sees ONLY itself and previously declared local `fn`s (NEVER forward-binds
    // to a later sibling local `fn`, matching MoonBit's lexical scoping).
    // - Non-recursive -> `let go = fn(a : T) -> R { ... }` (zero self-capture, params shadow outer boxed vars)
    // - Self-recursive -> lifted to package-private top-level function
    //   `__mbt_local_<enclosing>_<name>_<id>(env..., params...) -> R` (ZERO RC cycles!)
    match try_parse_local_fn_decl(tokens, i, end) {
      Some(g) => {
        let next_after = g.end_tok
        let body_refs = collect_body_ident_set(tokens, g.lb + 1, g.rb)
        let is_self_rec = body_refs.contains(g.name)
        let (p_names, p_tys, all_typed) = extract_param_info(ctx, tokens, g.open_p, g.close_p, file)
        let param_set : Map[String, Bool] = Map()
        for pn in p_names { param_set[pn] = true }
        if !is_self_rec {
          let (p_str, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, g.open_p, g.close_p, file, false, true)
          let raw_p_names = extract_raw_param_names(tokens, g.open_p, g.close_p)
          let ret_str = if g.ret_start >= 0 && g.ret_end > g.ret_start {
            " -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
          } else {
            ""
          }
          // Push own params as non-boxed ScopeVars + scoped ident_renames so shadowed outer vars/keywords stay hygienic!
          let saved_sc = ctx.scope_vars.length()
          let saved_rn = ctx.ident_renames.length()
          if p_renames.length() > 0 {
            ctx.ident_renames.push(p_renames)
          }
          let mut pi = 0
          while pi < raw_p_names.length() {
            let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
            ctx.scope_vars.push(ScopeVar::{
              name: eff_pn,
              ty: if pi < p_tys.length() { p_tys[pi] } else { "" },
              is_mut: false,
              is_boxed: false,
            })
            pi = pi + 1
          }
          let body = lower_block_range(ctx, tokens, g.lb, g.rb, file, p_pre)
          restore_scope_vars(ctx, saved_sc)
          restore_ident_renames(ctx, saved_rn)
          sb.write_string(tokens[g.start_tok].leading_trivia)
          sb.write_string("let " + g.name + " = fn(" + p_str + ")" + ret_str + " " + body)
          // Register this local fn in scope for subsequent statements/local fns (declaration order!)
          let fn_ty = if all_typed && g.ret_start >= 0 && g.ret_end > g.ret_start {
            "(" + join_comma(p_tys) + ") -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
          } else {
            ""
          }
          ctx.scope_vars.push(ScopeVar::{ name: g.name, ty: fn_ty, is_mut: false, is_boxed: false })
          i = next_after
          continue
        }
        // Self-recursive local fn: collect captured outer `ScopeVar`s (excluding `g.name` AND `g`'s own params!)
        let captured : Array[ScopeVar] = []
        let cap_seen : Map[String, Bool] = Map()
        for r in sorted_map_keys(body_refs) {
          if r == g.name || param_set.contains(r) || cap_seen.contains(r) {
            continue
          }
          match lookup_scope_var(ctx, r) {
            Some(sv) => {
              cap_seen[r] = true
              captured.push(sv)
            }
            None => ()
          }
        }
        let mut can_lift = true
        let env_params : Array[String] = []
        let env_args : Array[String] = []
        for sv in captured {
          if sv.ty.length() == 0 {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              g.line,
              g.col,
              "cannot lift recursive local fn `" + g.name + "`: captured variable `" + sv.name + "` lacks a statically known type",
            ))
            can_lift = false
          } else if sv.is_boxed {
            env_params.push(sv.name + " : mbt_compat::MbtCell[" + sv.ty + "]")
            env_args.push(sv.name)
          } else {
            env_params.push(sv.name + " : " + sv.ty)
            env_args.push(sv.name)
          }
        }
        if !all_typed {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            g.line,
            g.col,
            "cannot lift recursive local fn `" + g.name + "`: parameter type annotation required",
          ))
          can_lift = false
        }
        let enc_clean = sanitize_file_id(ctx.cur_enclosing_fn)
        ctx.lift_counter = ctx.lift_counter + 1
        let lname = "__mbt_local_" + enc_clean + "_" + g.name + "_" + ctx.lift_counter.to_string()
        // Register lifted name BEFORE lowering body so self-calls rewrite to `lname(env..., args...)`
        ctx.lifted_local_fns[g.name] = LiftedLocalFn::{
          lifted_name: lname,
          env_args: env_args,
        }
        let (p_str, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, g.open_p, g.close_p, file, false, true)
        let raw_p_names = extract_raw_param_names(tokens, g.open_p, g.close_p)
        let ret_str = if g.ret_start >= 0 && g.ret_end > g.ret_start {
          " -> " + lower_type_tokens_checked(ctx, tokens, g.ret_start, g.ret_end, file)
        } else {
          " -> Unit"
        }
        let saved_sc = ctx.scope_vars.length()
        let saved_rn = ctx.ident_renames.length()
        if p_renames.length() > 0 {
          ctx.ident_renames.push(p_renames)
        }
        let eff_p_names : Array[String] = []
        let mut pi = 0
        while pi < raw_p_names.length() {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          eff_p_names.push(eff_pn)
          ctx.scope_vars.push(ScopeVar::{
            name: eff_pn,
            ty: if pi < p_tys.length() { p_tys[pi] } else { "" },
            is_mut: false,
            is_boxed: false,
          })
          pi = pi + 1
        }
        let body = lower_block_range(ctx, tokens, g.lb, g.rb, file, p_pre)
        restore_scope_vars(ctx, saved_sc)
        restore_ident_renames(ctx, saved_rn)
        let full_params = if env_params.length() > 0 && p_str.length() > 0 {
          join_comma(env_params) + ", " + p_str
        } else if env_params.length() > 0 {
          join_comma(env_params)
        } else {
          p_str
        }
        ctx.lifted_fns.push("fn " + lname + "(" + full_params + ")" + ret_str + " " + body + "\n")
        let escapes = is_local_fn_used_as_value(tokens, next_after, end, g.name) ||
        is_local_fn_used_as_value(tokens, g.lb + 1, g.rb, g.name)
        sb.write_string(tokens[g.start_tok].leading_trivia)
        if escapes {
          let call_args_all : Array[String] = []
          for ea in env_args { call_args_all.push(ea) }
          for pn in eff_p_names { call_args_all.push(pn) }
          sb.write_string("let " + g.name + " = fn(" + p_str + ")" + ret_str + " { " + lname + "(" + join_comma(call_args_all) + ") }")
        } else {
          sb.write_string("// lifted recursive local fn: " + lname)
        }
        let _ = can_lift
        i = next_after
        continue
      }
      None => ()
    }

    // Check placeholder pipe at statement expression boundary (when not inside a `let` / `guard` / `fn` keyword)
    if !(t.kind == TokenKind::Keyword && (t.raw == "let" || t.raw == "guard" || t.raw == "fn" || t.raw == "if" || t.raw == "match" || t.raw == "while" || t.raw == "for" || t.raw == "return")) {
      match try_lower_placeholder_pipe_chain(ctx, tokens, i, end, file) {
        Some((pipe_code, next_i)) => {
          sb.write_string(pipe_code)
          i = next_i
          continue
        }
        None => ()
      }
    }

    // Otherwise lower one expression/token step
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, end, file, false)
    sb.write_string(piece)
    i = next_i
  }
  sb.to_string()
}

///| Recursively emit nested `match` branches for 1+ optional forwarded arguments on an external `x~` callee.
fn emit_ext_opt_branches(
  sb : StringBuilder,
  callee_expr : String,
  temps : Array[String],
  arg_labels : Array[String],
  ext_opt_indices : Array[Int],
  opt_vars : Array[String],
  present : Array[Bool],
  depth : Int,
) -> Unit {
  if depth == ext_opt_indices.length() {
    sb.write_string(callee_expr + "(")
    let mut first = true
    let mut k = 0
    while k < temps.length() {
      let mut opt_pos = -1
      let mut oi = 0
      while oi < ext_opt_indices.length() {
        if ext_opt_indices[oi] == k {
          opt_pos = oi
          break
        }
        oi = oi + 1
      }
      if opt_pos >= 0 {
        if present[opt_pos] {
          if !first {
            sb.write_string(", ")
          }
          sb.write_string(arg_labels[k] + "=" + opt_vars[opt_pos])
          first = false
        }
      } else {
        if !first {
          sb.write_string(", ")
        }
        if arg_labels[k].length() > 0 {
          sb.write_string(arg_labels[k] + "=" + temps[k])
        } else {
          sb.write_string(temps[k])
        }
        first = false
      }
      k = k + 1
    }
    sb.write_string(")")
    return
  }
  let idx = ext_opt_indices[depth]
  let vname = opt_vars[depth]
  sb.write_string("match " + temps[idx] + " { Some(" + vname + ") => ")
  present[depth] = true
  emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, depth + 1)
  sb.write_string(", None => ")
  present[depth] = false
  emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, depth + 1)
  sb.write_string(" }")
}

///| Lower a call argument list `(arg1, x~, y?, ...)` handling:
///| - `x~` -> `x=x`
///| - `x?` -> `x?=x` (or external call-site branching when `is_external_tilde`)
///| - `SourceLoc` autofill injection `loc="<rel>.mbt:<line>:<col>"` when `needs_loc` and no explicit `loc=`
fn lower_call_args(
  ctx : StageAContext,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  call_line : Int,
  call_col : Int,
  callee_expr : String,
  needs_loc : Bool,
  is_external_tilde : Bool,
) -> String {
  let saved_interp_top_call = ctx.in_interp_top
  ctx.in_interp_top = false
  // Split arguments at depth-0 commas
  let raw_args : Array[(Int, Int)] = []
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 && k == TokenKind::Comma {
        break
      }
      a_end = a_end + 1
    }
    raw_args.push((cur, a_end))
    cur = a_end + 1
  }

  // Check for optional forwarding `x?` OR explicit `x?=expr` on a fixed external `x~ : T = d` callee (Astra P1-3)
  let ext_opt_indices : Array[Int] = []
  if is_external_tilde {
    let mut ai = 0
    while ai < raw_args.length() {
      let (s, e) = raw_args[ai]
      if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Question {
        ext_opt_indices.push(ai)
      } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::QuestionEq {
        ext_opt_indices.push(ai)
      }
      ai = ai + 1
    }
  }

  // Look up callee parameter types for per-use-site expected-type guidance (Wave M1.2 A.5)
  let is_dot_method = callee_expr.starts_with("__dot__::")
  let lookup_callee = if is_dot_method {
    callee_expr.slice(9, callee_expr.length())
  } else {
    callee_expr
  }
  let raw_callee_pts : Array[(String, String)] = if lookup_callee.starts_with("__method__::") {
    let mname = lookup_callee.slice(12, lookup_callee.length())
    match ctx.symtab.method_unique_param_types.get(mname) {
      Some(pts) => pts
      None => []
    }
  } else if ctx.cur_is_blackbox {
    match ctx.symtab.blackbox_fn_param_types.get(lookup_callee) {
      Some(pts) => pts
      None =>
      if ctx.symtab.blackbox_decls.contains(lookup_callee) {
        []
      } else {
        match ctx.symtab.fn_param_types.get(lookup_callee) {
          Some(pts) => pts
          None => []
        }
      }
    }
  } else {
    match ctx.symtab.fn_param_types.get(lookup_callee) {
      Some(pts) => pts
      None => []
    }
  }
  // When called as `recv.method(...)` via `Type::method` lookup, strip leading `self` parameter!
  let callee_pts : Array[(String, String)] = if is_dot_method &&
  raw_callee_pts.length() > 0 && raw_callee_pts[0].0 == "self" {
    let trimmed : Array[(String, String)] = []
    let mut k = 1
    while k < raw_callee_pts.length() {
      trimmed.push(raw_callee_pts[k])
      k = k + 1
    }
    trimmed
  } else {
    raw_callee_pts
  }
  let callee_renames : Option[Map[String, String]] = if is_dot_method {
    match ctx.symtab.fn_param_renames.get(lookup_callee) {
      Some(m) => Some(m)
      None => ctx.symtab.method_unique_param_renames.get(lookup_callee)
    }
  } else {
    ctx.symtab.fn_param_renames.get(lookup_callee)
  }
  let mut pos_param_idx = 0
  let mut has_explicit_loc = false
  let lowered_args : Array[String] = []
  // Parallel metadata per argument: `(label_or_empty, value_expr, is_ext_opt)`
  let arg_labels : Array[String] = []
  let arg_vals : Array[String] = []
  let arg_is_ext_opt : Array[Bool] = []
  let mut ai = 0
  while ai < raw_args.length() {
    let (s, e) = raw_args[ai]
    if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Tilde {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      let val_nm = resolve_ident_in_scope(ctx, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      lowered_args.push(lbl + "=" + val_nm)
      arg_labels.push(lbl)
      arg_vals.push(val_nm)
      arg_is_ext_opt.push(false)
    } else if e - s == 2 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Question {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      let val_nm = resolve_ident_in_scope(ctx, tokens[s].raw)
      lowered_args.push(lbl + "?=" + val_nm)
      arg_labels.push(lbl)
      arg_vals.push(val_nm)
      arg_is_ext_opt.push(is_external_tilde)
    } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::QuestionEq {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      let mut exp_ty = ""
      for pt in callee_pts {
        if pt.0 == tokens[s].raw { exp_ty = pt.1; break }
      }
      push_expected_type(ctx, exp_ty)
      let val_s = lower_expr_range(ctx, tokens, s + 2, e, file, false).trim()
      pop_expected_type(ctx)
      lowered_args.push(lbl + "?=" + val_s)
      arg_labels.push(lbl)
      arg_vals.push(val_s)
      arg_is_ext_opt.push(is_external_tilde)
    } else if e - s >= 3 && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::Eq {
      let lbl = callee_param_rename(callee_renames, tokens[s].raw)
      if tokens[s].raw == "loc" {
        has_explicit_loc = true
      }
      let mut exp_ty = ""
      for pt in callee_pts {
        if pt.0 == tokens[s].raw { exp_ty = pt.1; break }
      }
      push_expected_type(ctx, exp_ty)
      let val_s = lower_expr_range(ctx, tokens, s + 2, e, file, false).trim()
      pop_expected_type(ctx)
      lowered_args.push(lbl + "=" + val_s)
      arg_labels.push(lbl)
      arg_vals.push(val_s)
      arg_is_ext_opt.push(false)
    } else {
      let exp_ty = if pos_param_idx < callee_pts.length() { callee_pts[pos_param_idx].1 } else { "" }
      pos_param_idx = pos_param_idx + 1
      push_expected_type(ctx, exp_ty)
      let val_s = lower_expr_range(ctx, tokens, s, e, file, false).trim()
      pop_expected_type(ctx)
      lowered_args.push(val_s)
      arg_labels.push("")
      arg_vals.push(val_s)
      arg_is_ext_opt.push(false)
    }
    ai = ai + 1
  }

  if needs_loc && !has_explicit_loc {
    let rel = if ctx.opts.src_prefix.length() > 0 {
      ctx.opts.src_prefix + "/" + file
    } else {
      file
    }
    let loc_lit = "\"" + rel + ":" + call_line.to_string() + ":" + call_col.to_string() + "\""
    lowered_args.push("loc=" + loc_lit)
    arg_labels.push("loc")
    arg_vals.push(loc_lit)
    arg_is_ext_opt.push(false)
  }

  // External fixed `x~ : T = d` callee with 1+ `x?` forwardings:
  // Evaluate EVERY argument expression strictly once left-to-right, preserve all named labels,
  // and generate nested `match` branches for all 2^k `Some`/`None` combinations!
  if ext_opt_indices.length() > 0 {
    let sb = StringBuilder()
    sb.write_string("{ ")
    let temps : Array[String] = []
    let mut k = 0
    while k < arg_vals.length() {
      let tname = fresh_temp(ctx, "arg")
      temps.push(tname)
      sb.write_string("let " + tname + " = " + arg_vals[k] + "; ")
      k = k + 1
    }
    let present : Array[Bool] = []
    let opt_vars : Array[String] = []
    k = 0
    while k < ext_opt_indices.length() {
      present.push(false)
      opt_vars.push("__mbt_v" + k.to_string())
      k = k + 1
    }
    emit_ext_opt_branches(sb, callee_expr, temps, arg_labels, ext_opt_indices, opt_vars, present, 0)
    sb.write_string(" }")
    ctx.in_interp_top = saved_interp_top_call
    return sb.to_string()
  }

  let sb = StringBuilder()
  sb.write_string(callee_expr + "(")
  let mut k = 0
  while k < lowered_args.length() {
    if k > 0 {
      sb.write_string(", ")
    }
    sb.write_string(lowered_args[k])
    k = k + 1
  }
  ctx.in_interp_top = saved_interp_top_call
  sb.write_string(")")
  sb.to_string()
}

///| Pre-scan a function body `[start, end)` for borrowed slices `a[lo:hi]` (NOT followed by
///| `.to_owned()` or `.to_array()`). Local arrays initialized from `[...]` that have borrowed
///| slices are promoted to `mbt_compat::ArrayBuf[T]`, and views derived from them (including
///| nested views `v[lo:hi]`) are tracked as `mbt_compat::ArrayView[T]`.
fn prescan_borrowed_slices(
  tokens : Array[Token],
  start : Int,
  end : Int,
  bufs : Map[String, Bool],
  views : Map[String, Bool],
) -> Unit {
  // Collect local `let [mut] <name> = [...]` array literal declarations
  let local_arrs : Map[String, Bool] = Map()
  let mut i = start
  while i < end {
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" {
      let mut ni = i + 1
      if ni < end && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni < end && tokens[ni].kind == TokenKind::Ident {
        let vname = rename_keyword_ident(tokens[ni].raw)
        let mut eq_i = ni + 1
        while eq_i < end && tokens[eq_i].kind != TokenKind::Eq && !tokens[eq_i].newline_before {
          eq_i = eq_i + 1
        }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq && tokens[eq_i + 1].kind == TokenKind::LBracket {
          local_arrs[vname] = true
        }
      }
    }
    i = i + 1
  }

  // Fixpoint: find borrowed slices `recv[lo:hi]` (not followed by `.to_owned()` / `.to_array()`)
  let mut changed = true
  while changed {
    changed = false
    i = start
    while i < end {
      if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "let" {
        let mut ni = i + 1
        if ni < end && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
          ni = ni + 1
        }
        if ni < end && tokens[ni].kind == TokenKind::Ident {
          let lhs_name = rename_keyword_ident(tokens[ni].raw)
          let mut eq_i = ni + 1
          while eq_i < end && tokens[eq_i].kind != TokenKind::Eq && !tokens[eq_i].newline_before {
            eq_i = eq_i + 1
          }
          if eq_i + 2 < end && tokens[eq_i].kind == TokenKind::Eq &&
          tokens[eq_i + 1].kind == TokenKind::Ident && tokens[eq_i + 2].kind == TokenKind::LBracket {
            let recv_name = rename_keyword_ident(tokens[eq_i + 1].raw)
            let close_br = find_matching_delim(tokens, eq_i + 2)
            let mut has_colon = false
            let mut k = eq_i + 3
            let mut d = 0
            while k < close_br {
              let kk = tokens[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
                d = d + 1
              } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
                d = d - 1
              } else if d == 0 && kk == TokenKind::Colon {
                has_colon = true
                break
              }
              k = k + 1
            }
            let followed_by_owned = close_br + 2 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
            (tokens[close_br + 2].raw == "to_owned" || tokens[close_br + 2].raw == "to_array")
            if has_colon && !followed_by_owned {
              if local_arrs.contains(recv_name) {
                if !bufs.contains(recv_name) {
                  bufs[recv_name] = true
                  changed = true
                }
                if !views.contains(lhs_name) {
                  views[lhs_name] = true
                  changed = true
                }
              } else if views.contains(recv_name) {
                if !views.contains(lhs_name) {
                  views[lhs_name] = true
                  changed = true
                }
              }
            }
          }
        }
      }
      // P0-3 & E1-3: `match <local_arr> { ... .. as <tail> ... }` and `match Ctor(<local_arr>) { ... .. as <tail> ... }`
      // promote `<local_arr>` to `ArrayBuf` and `<tail>` to `ArrayView` so `.. as tail` shares the backing buffer.
      if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "match" {
        let mut scrut_nm = ""
        let mut mb_open = -1
        if i + 2 < end && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LBrace {
          scrut_nm = rename_keyword_ident(tokens[i + 1].raw)
          mb_open = i + 2
        } else if i + 5 < end && tokens[i + 1].kind == TokenKind::UpperIdent &&
        tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::Ident &&
        tokens[i + 4].kind == TokenKind::RParen && tokens[i + 5].kind == TokenKind::LBrace {
          scrut_nm = rename_keyword_ident(tokens[i + 3].raw)
          mb_open = i + 5
        }
        if mb_open >= 0 && (local_arrs.contains(scrut_nm) || views.contains(scrut_nm)) {
          let mb = find_matching_delim(tokens, mb_open)
          let mut mi = mb_open + 1
          while mi + 2 < mb {
            if tokens[mi].kind == TokenKind::DotDot &&
            tokens[mi + 1].kind == TokenKind::Keyword && tokens[mi + 1].raw == "as" &&
            tokens[mi + 2].kind == TokenKind::Ident && tokens[mi + 2].raw != "_" {
              let tail_nm = rename_keyword_ident(tokens[mi + 2].raw)
              if local_arrs.contains(scrut_nm) && !bufs.contains(scrut_nm) {
                bufs[scrut_nm] = true
                changed = true
              }
              if !views.contains(tail_nm) {
                views[tail_nm] = true
                changed = true
              }
            }
            mi = mi + 1
          }
        }
      }
      i = i + 1
    }
  }
}

///| Lower a top-level `fn` body with borrowed-slice `ArrayBuf`/`ArrayView` tracking.
fn lower_fn_body_with_views(
  ctx : StageAContext,
  tokens : Array[Token],
  lb : Int,
  rb : Int,
  file : String,
  preamble : String,
) -> String {
  ctx.borrowed_bufs.clear()
  ctx.borrowed_views.clear()
  prescan_borrowed_slices(tokens, lb, rb, ctx.borrowed_bufs, ctx.borrowed_views)
  let body = lower_block_range(ctx, tokens, lb, rb, file, preamble)
  ctx.borrowed_bufs.clear()
  ctx.borrowed_views.clear()
  body
}

///| Check if a pipe stage `[st_start, st_end)` uses placeholder `_`.
///| Returns: 0 = no placeholder (pass plain pipe through natively!),
///|          1 = valid single top-level `_` arg in `<callee>(e0, ..., _, ..., ek)`,
///|          -1 = unsupported placeholder shape (multiple `_`, nested `_`, or non-call RHS).
fn classify_pipe_stage_placeholder(tokens : Array[Token], st_start : Int, st_end : Int) -> (Int, Int, Int) {
  // Find depth-0 call `(` ... `)` at end of stage
  let mut open_p = -1
  let mut i = st_start
  let mut d = 0
  while i < st_end {
    let tk = tokens[i].kind
    if tk == TokenKind::LParen {
      if d == 0 {
        let cp = find_matching_delim(tokens, i)
        if cp + 1 == st_end {
          open_p = i
          break
        }
      }
      d = d + 1
    } else if tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      d = d + 1
    } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      if d > 0 { d = d - 1 }
    }
    i = i + 1
  }
  if open_p <= st_start {
    // Non-call RHS: only unsupported if `_` is literally the top-level stage expression
    if st_end == st_start + 1 && tokens[st_start].kind == TokenKind::Underscore {
      return (-1, -1, -1)
    }
    return (0, -1, -1)
  }
  let close_p = st_end - 1
  // Count top-level `_` args vs nested `_` (ignoring `_` inside closure params/patterns!)
  let mut top_underscores = 0
  let mut ai = open_p + 1
  while ai < close_p {
    if tokens[ai].kind == TokenKind::Comma {
      ai = ai + 1
      continue
    }
    let mut ae = ai
    let mut ad = 0
    while ae < close_p {
      let ak = tokens[ae].kind
      if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
      else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
      else if ad == 0 && ak == TokenKind::Comma { break }
      ae = ae + 1
    }
    if ae == ai + 1 && tokens[ai].kind == TokenKind::Underscore {
      top_underscores = top_underscores + 1
    } else {
      // Check for nested `_` ONLY outside closure bodies/params and match patterns
      let mut j = ai
      while j < ae {
        if tokens[j].kind == TokenKind::Keyword && tokens[j].raw == "fn" && j + 1 < ae && tokens[j + 1].kind == TokenKind::LParen {
          let fcp = find_matching_delim(tokens, j + 1)
          let mut flb = fcp + 1
          while flb < ae && tokens[flb].kind != TokenKind::LBrace { flb = flb + 1 }
          if flb < ae {
            j = find_matching_delim(tokens, flb) + 1
            continue
          }
        }
        if tokens[j].kind == TokenKind::LBrace {
          j = find_matching_delim(tokens, j) + 1
          continue
        }
        if tokens[j].kind == TokenKind::Underscore && !(j + 1 < ae && tokens[j + 1].kind == TokenKind::FatArrow) {
          return (-1, -1, -1)
        }
        j = j + 1
      }
    }
    ai = ae + 1
  }
  if top_underscores == 0 {
    (0, -1, -1)
  } else if top_underscores == 1 {
    (1, open_p, close_p)
  } else {
    (-1, -1, -1)
  }
}

///| Lower a pipe chain starting at `i` ONLY if at least one depth-0 `|>` stage uses `_` placeholder!
///| Plain `lhs |> f(args)` and `lhs |> ignore` return `None` so they pass through natively untouched!
fn try_lower_placeholder_pipe_chain(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let expr_end = find_expr_end(tokens, i, end)
  if expr_end <= i + 2 {
    return None
  }
  // Collect depth-0 `|>` indices within `[i, expr_end)`
  let pipe_idxs : Array[Int] = []
  let mut k = i
  let mut d = 0
  while k < expr_end {
    let tk = tokens[k].kind
    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { d = d + 1 }
    else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
    else if d == 0 && tk == TokenKind::PipeGt {
      pipe_idxs.push(k)
    }
    k = k + 1
  }
  if pipe_idxs.length() == 0 {
    return None
  }
  // Check if ANY stage uses a placeholder `_`
  let mut any_placeholder = false
  let mut pi = 0
  while pi < pipe_idxs.length() {
    let st_s = pipe_idxs[pi] + 1
    let st_e = if pi + 1 < pipe_idxs.length() { pipe_idxs[pi + 1] } else { expr_end }
    let (cls, _, _) = classify_pipe_stage_placeholder(tokens, st_s, st_e)
    if cls != 0 {
      any_placeholder = true
      break
    }
    pi = pi + 1
  }
  if !any_placeholder {
    return None
  }
  // Lower left-to-right preserving exact evaluation order & single-eval count
  let mut acc = lower_expr_range(ctx, tokens, i, pipe_idxs[0], file, false).trim()
  pi = 0
  while pi < pipe_idxs.length() {
    let st_s = pipe_idxs[pi] + 1
    let st_e = if pi + 1 < pipe_idxs.length() { pipe_idxs[pi + 1] } else { expr_end }
    let (cls, open_p, close_p) = classify_pipe_stage_placeholder(tokens, st_s, st_e)
    if cls == 0 {
      let rhs_s = lower_expr_range(ctx, tokens, st_s, st_e, file, false).trim()
      acc = acc + " |> " + rhs_s
    } else if cls < 0 {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_PIPE_PLACEHOLDER",
        file,
        tokens[pipe_idxs[pi]].line,
        tokens[pipe_idxs[pi]].col,
        "unsupported placeholder pipe shape (multiple `_`, nested `_`, or non-call target)",
      ))
      let rhs_s = lower_expr_range(ctx, tokens, st_s, st_e, file, false).trim()
      acc = acc + " |> " + rhs_s
    } else {
      let callee_s = lower_expr_range(ctx, tokens, st_s, open_p, file, false).trim()
      let p_tmp = fresh_temp(ctx, "p")
      let sb = StringBuilder()
      sb.write_string("{ let " + p_tmp + " = " + acc + "; ")
      let call_args : Array[String] = []
      let mut ai = open_p + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae == ai + 1 && tokens[ai].kind == TokenKind::Underscore {
          call_args.push(p_tmp)
        } else if ae == ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          let lbl = rename_keyword_ident(tokens[ai].raw)
          let a_tmp = fresh_temp(ctx, "pa")
          sb.write_string("let " + a_tmp + " = " + lbl + "; ")
          call_args.push(lbl + "=" + a_tmp)
        } else if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = rename_keyword_ident(tokens[ai].raw)
          let a_tmp = fresh_temp(ctx, "pa")
          let a_expr = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          sb.write_string("let " + a_tmp + " = " + a_expr + "; ")
          call_args.push(lbl + "=" + a_tmp)
        } else {
          let a_tmp = fresh_temp(ctx, "pa")
          let a_expr = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          sb.write_string("let " + a_tmp + " = " + a_expr + "; ")
          call_args.push(a_tmp)
        }
        ai = ae + 1
      }
      sb.write_string(callee_s + "(" + join_comma(call_args) + ") }")
      acc = sb.to_string()
    }
    pi = pi + 1
  }
  Some((tokens[i].leading_trivia + acc, expr_end))
}

///| Expand a pattern containing `|` inside parens: `(A | B)` -> `A | B`, `Ctor(A | B)` -> `Ctor(A) | Ctor(B)`.
fn expand_or_is_pattern(ctx : StageAContext, tokens : Array[Token], start : Int, end : Int, file : String) -> String {
  if start >= end {
    return ""
  }
  // Case 1: `(A | B | ...)`
  if tokens[start].kind == TokenKind::LParen && find_matching_delim(tokens, start) == end - 1 {
    return lower_expr_range(ctx, tokens, start + 1, end - 1, file, true).trim()
  }
  // Case 2: `Ctor(A | B)` -> `Ctor(A) | Ctor(B)`
  if tokens[start].kind == TokenKind::UpperIdent && start + 1 < end &&
  tokens[start + 1].kind == TokenKind::LParen && find_matching_delim(tokens, start + 1) == end - 1 {
    let head = lower_expr_range(ctx, tokens, start, start + 1, file, true).trim()
    let open_p = start + 1
    let close_p = end - 1
    let alts : Array[String] = []
    let mut cur = open_p + 1
    let mut i = open_p + 1
    let mut d = 0
    while i < close_p {
      let k = tokens[i].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d = d + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && k == TokenKind::Pipe {
        let part = lower_expr_range(ctx, tokens, cur, i, file, true).trim()
        alts.push(head + "(" + part + ")")
        cur = i + 1
      }
      i = i + 1
    }
    if cur < close_p {
      let part = lower_expr_range(ctx, tokens, cur, close_p, file, true).trim()
      alts.push(head + "(" + part + ")")
    }
    if alts.length() > 1 {
      let sb = StringBuilder()
      let mut ai = 0
      while ai < alts.length() {
        if ai > 0 { sb.write_string(" | ") }
        sb.write_string(alts[ai])
        ai = ai + 1
      }
      return sb.to_string()
    }
  }
  lower_expr_range(ctx, tokens, start, end, file, true).trim()
}

///| Lower `<lhs> is <or_pat>` (where `<or_pat>` contains `|`, e.g. `x is (A | B)` or `x is Some(A | B)`)
///| into `(match <lhs> { <expanded_pat> => true, _ => false })` because Pion `is` does not accept `|` patterns.
fn try_lower_or_is_expr(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  // Scan forward through a single postfix/primary `<lhs>` to see if `is` immediately follows at depth 0
  let mut k = i
  let mut d = 0
  let mut is_idx = -1
  while k < end {
    let tk = tokens[k].kind
    if d == 0 && k > i && tokens[k].newline_before {
      break
    }
    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
      if d == 0 && tk == TokenKind::LBrace { break }
      d = d + 1
    } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
      if d == 0 { break }
      d = d - 1
    } else if d == 0 {
      if tk == TokenKind::Keyword && tokens[k].raw == "is" {
        is_idx = k
        break
      }
      if tk == TokenKind::AmpAmp || tk == TokenKind::PipePipe || tk == TokenKind::Comma ||
      tk == TokenKind::Semi || tk == TokenKind::Eq || tk == TokenKind::EqEq || tk == TokenKind::BangEq ||
      tk == TokenKind::FatArrow || tk == TokenKind::PipeGt {
        break
      }
    }
    k = k + 1
  }
  if is_idx <= i || is_idx + 1 >= end {
    return None
  }
  // Find end of pattern after `is`
  let mut pat_end = is_idx + 1
  let mut pd = 0
  let mut has_pipe = false
  let mut has_struct_pat = false
  let mut has_array_pat = false
  while pat_end < end {
    let pk = tokens[pat_end].kind
    if pd == 0 && pat_end > is_idx + 1 && tokens[pat_end].newline_before {
      break
    }
    if pk == TokenKind::Pipe {
      has_pipe = true
    }
    if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
      if pd == 0 && pk == TokenKind::LBrace && !(pat_end > is_idx + 1 && tokens[pat_end - 1].kind == TokenKind::ColonColon) {
        break
      }
      if pd > 0 && pk == TokenKind::LBrace {
        has_struct_pat = true
      }
      if pd > 0 && pk == TokenKind::LBracket {
        has_array_pat = true
      }
      pd = pd + 1
    } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
      if pd == 0 { break }
      pd = pd - 1
    } else if pd == 0 && (pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::Comma || pk == TokenKind::Semi || pk == TokenKind::EqEq || pk == TokenKind::BangEq || (pk == TokenKind::Keyword && tokens[pat_end].raw == "else")) {
      break
    }
    pat_end = pat_end + 1
  }
  if !has_pipe && !has_struct_pat && !has_array_pat {
    return None
  }
  let lhs_str = lower_expr_range(ctx, tokens, i, is_idx, file, false).trim()
  if has_array_pat {
    let p_start = is_idx + 1
    if p_start + 1 < pat_end && (tokens[p_start].kind == TokenKind::UpperIdent || tokens[p_start].kind == TokenKind::Dot) {
      let mut open_p = p_start + 1
      if tokens[p_start].kind == TokenKind::Dot && open_p + 1 < pat_end { open_p = p_start + 2 }
      if open_p < pat_end && tokens[open_p].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, open_p)
        if open_p + 1 < close_p && tokens[open_p + 1].kind == TokenKind::LBracket {
          let close_br = find_matching_delim(tokens, open_p + 1)
          let ctor_head = lower_expr_range(ctx, tokens, p_start, open_p, file, true).trim()
          let tmp_a = fresh_temp(ctx, "isa")
          let elem_wilds : Array[String] = []
          let mut ei = open_p + 2
          while ei < close_br {
            if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
            let mut ee = ei
            let mut ed = 0
            while ee < close_br {
              let ek = tokens[ee].kind
              if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
              else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
              else if ed == 0 && ek == TokenKind::Comma { break }
              ee = ee + 1
            }
            elem_wilds.push(wildcard_pattern_str(ctx, tokens, ei, ee, file))
            ei = ee + 1
          }
          let csb = StringBuilder()
          csb.write_string(tmp_a + ".length() == " + elem_wilds.length().to_string())
          let mut idx = 0
          while idx < elem_wilds.length() {
            csb.write_string(" && (" + tmp_a + "[" + idx.to_string() + "] is " + elem_wilds[idx] + ")")
            idx = idx + 1
          }
          return Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + ctor_head + "(" + tmp_a + ") => (" + csb.to_string() + "), _ => false })", pat_end))
        }
      }
    }
    return None
  }
  if has_struct_pat {
    // Lower `<lhs> is Ctor({ f1: p1, .. })` -> `(match <lhs> { Ctor(__mbt_s) => (__mbt_s.f1 is p1 && ...), _ => false })`
    let p_start = is_idx + 1
    if p_start + 1 < pat_end && (tokens[p_start].kind == TokenKind::UpperIdent || tokens[p_start].kind == TokenKind::Dot) {
      let mut open_p = p_start + 1
      if tokens[p_start].kind == TokenKind::Dot && open_p + 1 < pat_end {
        open_p = p_start + 2
      }
      if open_p < pat_end && tokens[open_p].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, open_p)
        if open_p + 1 < close_p && tokens[open_p + 1].kind == TokenKind::LBrace {
          let close_b = find_matching_delim(tokens, open_p + 1)
          let ctor_head = lower_expr_range(ctx, tokens, p_start, open_p, file, true).trim()
          let tmp_s = fresh_temp(ctx, "is")
          let conds = lower_struct_pat_guards(ctx, tmp_s, tokens, open_p + 1, close_b, file)
          let cond_expr = if conds.length() > 0 { conds } else { "true" }
          return Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + ctor_head + "(" + tmp_s + ") => (" + cond_expr + "), _ => false })", pat_end))
        }
      }
    }
    return None
  }
  let pat_str = expand_or_is_pattern(ctx, tokens, is_idx + 1, pat_end, file)
  Some((tokens[i].leading_trivia + "(match " + lhs_str + " { " + pat_str + " => true, _ => false })", pat_end))
}

///| Lower a struct pattern `{ f1: p1, f2: { g: p2, .. }, .. }` against bound variable `var_name`
///| into a boolean guard expression `var_name.f1 is p1 && var_name.f2.g == p2`.
fn lower_struct_pat_guards(
  ctx : StageAContext,
  var_name : String,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let parts : Array[String] = []
  let mut i = open_b + 1
  while i < close_b {
    if tokens[i].kind == TokenKind::Comma || tokens[i].kind == TokenKind::DotDot {
      i = i + 1
      continue
    }
    let mut e = i
    let mut d = 0
    while e < close_b {
      let ek = tokens[e].kind
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { d = d + 1 }
      else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && ek == TokenKind::Comma { break }
      e = e + 1
    }
    if (tokens[i].kind == TokenKind::Ident || tokens[i].kind == TokenKind::Keyword) &&
    i + 1 < e && tokens[i + 1].kind == TokenKind::Colon {
      let fname = rename_keyword_ident(tokens[i].raw)
      let fexpr = var_name + "." + fname
      let vs = i + 2
      if vs < e && tokens[vs].kind == TokenKind::LBrace {
        let cb = find_matching_delim(tokens, vs)
        let nested = lower_struct_pat_guards(ctx, fexpr, tokens, vs, cb, file)
        if nested.length() > 0 { parts.push(nested) }
      } else if vs < e {
        let vt = tokens[vs]
        if vs + 1 == e && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
          vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
          parts.push(fexpr + " == " + vt.raw)
        } else {
          let ps = lower_expr_range(ctx, tokens, vs, e, file, true).trim()
          if ps != "_" {
            parts.push("(" + fexpr + " is " + ps + ")")
          }
        }
      }
    }
    i = e + 1
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < parts.length() {
    if k > 0 { sb.write_string(" && ") }
    sb.write_string(parts[k])
    k = k + 1
  }
  sb.to_string()
}

///| Lower an expression range `[start, end)`.
pub fn lower_expr_range(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
  in_pattern : Bool,
) -> String {
  if !in_pattern && start < end {
    match try_lower_placeholder_pipe_chain(ctx, tokens, start, end, file) {
      Some((pipe_code, next_i)) =>
      if next_i >= end {
        return pipe_code
      } else {
        return pipe_code + lower_expr_range(ctx, tokens, next_i, end, file, false)
      }
      None => ()
    }
  }
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, end, file, in_pattern)
    sb.write_string(piece)
    i = next_i
  }
  sb.to_string()
}

///| Map allowlisted raising `@pkg.fn` calls to their non-panicking `Result` helpers for controlled `catch`.
///| Uses `is_moonbit_core_pkg` so user packages aliased as `@string` / `@json` / `@utf8` are NEVER hijacked!
fn lookup_controlled_catch_result_fn(symtab : SymbolTable, raw_pkg : String, sym_raw : String) -> String {
  if is_moonbit_core_pkg(symtab, raw_pkg, "json") && sym_raw == "parse" {
    return "mbt_compat::mbt_json_parse"
  }
  if is_moonbit_core_pkg(symtab, raw_pkg, "encoding/utf8") && sym_raw == "decode" {
    return "mbt_compat::utf8_decode_strict"
  }
  if (is_moonbit_core_pkg(symtab, raw_pkg, "string") || is_moonbit_core_pkg(symtab, raw_pkg, "strconv")) && sym_raw == "parse_int" {
    return "mbt_compat::str_try_parse_int"
  }
  if (is_moonbit_core_pkg(symtab, raw_pkg, "string") || is_moonbit_core_pkg(symtab, raw_pkg, "strconv")) && sym_raw == "parse_double" {
    return "mbt_compat::str_try_parse_double"
  }
  ""
}

///| Lower a controlled `catch` block `{ <arms> }` attached to an allowlisted Result-returning call:
///| - `@json.parse(e) catch { _ => fallback }` -> `match mbt_compat::mbt_json_parse(e) { Ok(__ok) => __ok, Err(_) => fallback }`
///| - `Some(@utf8.decode(b)) catch { _ => None }` -> `match mbt_compat::utf8_decode_strict(b) { Ok(__ok) => Some(__ok), Err(_) => None }`
fn try_lower_controlled_catch(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let trivia = tokens[i].leading_trivia
  let mut wrap_ctor = ""
  let mut pkg_i = -1
  let mut after_call = -1
  if tokens[i].kind == TokenKind::PkgRef && i + 3 < end &&
  tokens[i + 1].kind == TokenKind::Dot && tokens[i + 3].kind == TokenKind::LParen {
    pkg_i = i
    after_call = find_matching_delim(tokens, i + 3) + 1
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 5 < end && tokens[i + 1].kind == TokenKind::LBrace {
    // Controlled `try { @pkg.fn(args) } catch { <arms> }` or `try { Ctor(@pkg.fn(args)) } catch { <arms> }`
    let try_rb = find_matching_delim(tokens, i + 1)
    let mut inner_s = i + 2
    while inner_s < try_rb && tokens[inner_s].kind == TokenKind::Semi {
      inner_s = inner_s + 1
    }
    let mut inner_e = try_rb
    while inner_e > inner_s && tokens[inner_e - 1].kind == TokenKind::Semi {
      inner_e = inner_e - 1
    }
    if inner_s + 3 < inner_e && tokens[inner_s].kind == TokenKind::PkgRef &&
    tokens[inner_s + 1].kind == TokenKind::Dot && tokens[inner_s + 3].kind == TokenKind::LParen &&
    find_matching_delim(tokens, inner_s + 3) + 1 == inner_e {
      pkg_i = inner_s
      after_call = try_rb + 1
    } else if inner_s + 5 < inner_e && tokens[inner_s].kind == TokenKind::UpperIdent &&
    tokens[inner_s + 1].kind == TokenKind::LParen &&
    tokens[inner_s + 2].kind == TokenKind::PkgRef &&
    tokens[inner_s + 3].kind == TokenKind::Dot &&
    tokens[inner_s + 5].kind == TokenKind::LParen {
      let outer_rp = find_matching_delim(tokens, inner_s + 1)
      let inner_rp = find_matching_delim(tokens, inner_s + 5)
      if outer_rp + 1 == inner_e && inner_rp + 1 == outer_rp {
        wrap_ctor = tokens[inner_s].raw
        pkg_i = inner_s + 2
        after_call = try_rb + 1
      }
    }
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 4 < end && tokens[i + 1].kind == TokenKind::PkgRef &&
  tokens[i + 2].kind == TokenKind::Dot && tokens[i + 4].kind == TokenKind::LParen {
    // Brace-less `try @pkg.fn(args) catch { _ => ... }`
    pkg_i = i + 1
    after_call = find_matching_delim(tokens, i + 4) + 1
  } else if (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "try" && i + 6 < end && tokens[i + 1].kind == TokenKind::UpperIdent &&
  tokens[i + 2].kind == TokenKind::LParen &&
  tokens[i + 3].kind == TokenKind::PkgRef &&
  tokens[i + 4].kind == TokenKind::Dot &&
  tokens[i + 6].kind == TokenKind::LParen {
    // Brace-less `try Some(@json.parse(s)) catch { _ => None }`
    let outer_rp = find_matching_delim(tokens, i + 2)
    let inner_rp = find_matching_delim(tokens, i + 6)
    if inner_rp + 1 == outer_rp {
      wrap_ctor = tokens[i + 1].raw
      pkg_i = i + 3
      after_call = outer_rp + 1
    }
  } else if tokens[i].kind == TokenKind::UpperIdent && i + 5 < end &&
  tokens[i + 1].kind == TokenKind::LParen &&
  tokens[i + 2].kind == TokenKind::PkgRef &&
  tokens[i + 3].kind == TokenKind::Dot &&
  tokens[i + 5].kind == TokenKind::LParen {
    let outer_rp = find_matching_delim(tokens, i + 1)
    let inner_rp = find_matching_delim(tokens, i + 5)
    if inner_rp + 1 == outer_rp {
      wrap_ctor = tokens[i].raw
      pkg_i = i + 2
      after_call = outer_rp + 1
    }
  }
  if pkg_i < 0 || after_call < 0 || after_call + 1 >= end {
    return None
  }
  if !((tokens[after_call].kind == TokenKind::Keyword || tokens[after_call].kind == TokenKind::Ident) &&
    tokens[after_call].raw == "catch" && tokens[after_call + 1].kind == TokenKind::LBrace) {
    return None
  }
  let raw_pkg = tokens[pkg_i].raw.slice(1, tokens[pkg_i].raw.length())
  let sym_raw = tokens[pkg_i + 2].raw
  let res_fn = lookup_controlled_catch_result_fn(ctx.symtab, raw_pkg, sym_raw)
  if res_fn.length() == 0 {
    return None
  }
  let call_lp = pkg_i + 3
  let call_rp = find_matching_delim(tokens, call_lp)
  let raw_call_str = lower_call_args(ctx, tokens, call_lp, call_rp, file, tokens[pkg_i].line, tokens[pkg_i].col, res_fn, false, false)
  let call_str = if res_fn == "mbt_compat::str_try_parse_int" && str_has(raw_call_str, "base=") {
    raw_call_str.replace(", base=", ", radix=")
  } else {
    raw_call_str
  }
  let catch_lb = after_call + 1
  let catch_rb = find_matching_delim(tokens, catch_lb)
  let ok_var = fresh_temp(ctx, "ok")
  let ok_expr = if wrap_ctor.length() > 0 { wrap_ctor + "(" + ok_var + ")" } else { ok_var }
  // Fast path: single wildcard arm `_ => <fallback>`
  let mut arm_s = catch_lb + 1
  while arm_s < catch_rb && (tokens[arm_s].kind == TokenKind::Semi || tokens[arm_s].kind == TokenKind::Comma) {
    arm_s = arm_s + 1
  }
  let mut is_single_wild = false
  if arm_s + 1 < catch_rb && tokens[arm_s].kind == TokenKind::Underscore && tokens[arm_s + 1].kind == TokenKind::FatArrow {
    // Check there is no second top-level `=>` inside `{ ... }`
    let mut k = arm_s + 2
    let mut d = 0
    let mut second_arm = false
    while k < catch_rb {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
      else if d == 0 && kk == TokenKind::FatArrow { second_arm = true; break }
      k = k + 1
    }
    if !second_arm {
      is_single_wild = true
    }
  }
  if is_single_wild {
    let mut fb_end = catch_rb
    while fb_end > arm_s + 2 && (tokens[fb_end - 1].kind == TokenKind::Semi || tokens[fb_end - 1].kind == TokenKind::Comma) {
      fb_end = fb_end - 1
    }
    let fb_str = lower_expr_range(ctx, tokens, arm_s + 2, fb_end, file, false).trim()
    return Some((trivia + "match " + call_str + " { Ok(" + ok_var + ") => " + ok_expr + ", Err(_) => " + fb_str + " }", catch_rb + 1))
  }
  // P1-2 + Opus P2-1: Controlled `catch` that binds or matches the error value MUST fail closed
  // (never silently substitute a fake `String` error where MoonBit yields `Failure`/`ParseError`).
  ctx.diags.push(diag_error(
    "MBT2PION_UNSUPPORTED_SYNTAX",
    file,
    tokens[catch_lb].line,
    tokens[catch_lb].col,
    "controlled `catch` only supports wildcard `_ => <fallback>` (binding or matching error values requires an overlay)",
  ))
  Some((trivia + "MBT2PION_MANUAL", catch_rb + 1))
}

///| Find a top-level `:` inside `[open_br .. close_br]`, returning its index or `-1`.
fn find_slice_colon(tokens : Array[Token], open_br : Int, close_br : Int) -> Int {
  let mut k = open_br + 1
  let mut d = 0
  while k < close_br {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
    else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
    else if d == 0 && kk == TokenKind::Colon { return k }
    k = k + 1
  }
  -1
}

///| General postfix slice lowering for ANY receiver expression:
///| `f(x)[:]`, `@pkg.f(x)[lo:hi]`, `a.b().c[lo:]`, `[1, 2, 3][:]`, `(expr)[lo:hi]`, `arr[0][1:]`.
///| Evaluates complex receivers strictly ONCE when `hi` is omitted via a hygienic temp binding.
fn try_lower_general_postfix_slice(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  if i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon) {
    return None
  }
  let t = tokens[i]
  let mut cur = -1
  if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::ByteStringLit {
    cur = i + 1
  } else if t.kind == TokenKind::PkgRef {
    if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
      cur = i + 3
    } else {
      return None
    }
  } else if t.kind == TokenKind::LParen {
    if is_arrow_fn_at(tokens, i, end) >= 0 {
      return None
    }
    cur = find_matching_delim(tokens, i) + 1
  } else if t.kind == TokenKind::LBracket {
    cur = find_matching_delim(tokens, i) + 1
  } else {
    return None
  }
  let mut slice_br = -1
  let mut slice_colon = -1
  while cur < end {
    let ck = tokens[cur].kind
    if ck == TokenKind::LBracket && !tokens[cur].newline_before {
      let cbr = find_matching_delim(tokens, cur)
      let col_i = find_slice_colon(tokens, cur, cbr)
      if col_i >= 0 {
        slice_br = cur
        slice_colon = col_i
        break
      }
      cur = cbr + 1
    } else if ck == TokenKind::LParen && !tokens[cur].newline_before {
      cur = find_matching_delim(tokens, cur) + 1
    } else if ck == TokenKind::Dot && cur + 1 < end &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::IntLit) {
      cur = cur + 2
    } else if ck == TokenKind::ColonColon && cur + 1 < end &&
    (tokens[cur + 1].kind == TokenKind::Ident || tokens[cur + 1].kind == TokenKind::UpperIdent) {
      cur = cur + 2
    } else {
      break
    }
  }
  if slice_br < 0 {
    return None
  }
  // Leave bare `ident[lo:hi]` to the dedicated `Ident` handler (which also checks `borrowed_bufs`/`borrowed_views`).
  if t.kind == TokenKind::Ident && slice_br == i + 1 {
    return None
  }
  let trivia = t.leading_trivia
  let outer_owned_exempt = ctx.direct_owned_slice_arg
  ctx.direct_owned_slice_arg = false
  let allow_interp_top = ctx.in_interp_top
  ctx.in_interp_top = false
  let mut recv_str = lower_expr_range(ctx, tokens, i, slice_br, file, false).trim()
  let mut cur_br = slice_br
  let mut cur_col = slice_colon
  let mut final_next = cur_br
  while cur_br >= 0 {
    let close_br = find_matching_delim(tokens, cur_br)
    let lo = if cur_col > cur_br + 1 {
      lower_expr_range(ctx, tokens, cur_br + 1, cur_col, file, false).trim()
    } else {
      "0"
    }
    let has_hi = close_br > cur_col + 1
    let has_chained_slice = close_br + 1 < end && tokens[close_br + 1].kind == TokenKind::LBracket &&
    !tokens[close_br + 1].newline_before &&
    find_slice_colon(tokens, close_br + 1, find_matching_delim(tokens, close_br + 1)) >= 0
    let (helper, next_after, extra_arg) = classify_slice_consumer(
      ctx,
      tokens,
      close_br,
      end,
      outer_owned_exempt,
      has_chained_slice,
      allow_interp_top,
      file,
    )
    let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
    if has_hi {
      let hi = lower_expr_range(ctx, tokens, cur_col + 1, close_br, file, false).trim()
      recv_str = helper + "(" + recv_str + ", " + lo + ", " + hi + extra_tail + ")"
    } else {
      let sl_var = fresh_temp(ctx, "sl")
      recv_str = "({ let " + sl_var + " = " + recv_str + "; " + helper + "(" + sl_var + ", " + lo + ", " + sl_var + ".length()" + extra_tail + ") })"
    }
    final_next = next_after
    // Handle chained slices like `f(x)[:][1:]`
    if final_next < end && tokens[final_next].kind == TokenKind::LBracket && !tokens[final_next].newline_before {
      let next_cbr = find_matching_delim(tokens, final_next)
      let next_col = find_slice_colon(tokens, final_next, next_cbr)
      if next_col >= 0 {
        cur_br = final_next
        cur_col = next_col
        continue
      }
    }
    break
  }
  Some((trivia + recv_str, final_next))
}

///| Lower one token or compound syntactic form starting at `i` within `[i, end)`.
///| Returns `(lowered_text, next_token_index)`.
fn lower_one_token_or_form(
  ctx : StageAContext,
  tokens : Array[Token],
  i : Int,
  end : Int,
  file : String,
  in_pattern : Bool,
) -> (String, Int) {
  let t = tokens[i]
  let trivia = t.leading_trivia

  // 0a. Controlled `catch` expressions on allowlisted Result-returning stdlib calls
  if !in_pattern {
    match try_lower_controlled_catch(ctx, tokens, i, end, file) {
      Some((ccode, next_i)) => return (ccode, next_i)
      None => ()
    }
  }

  // 0b. General postfix slice `expr[lo:hi]` / `expr[:]` / `expr[lo:]` on complex receivers
  if !in_pattern {
    match try_lower_general_postfix_slice(ctx, tokens, i, end, file) {
      Some((scode, next_i)) => return (scode, next_i)
      None => ()
    }
  }

  // 0. `<lhs> is (<Pat1> | <Pat2>)` or `<lhs> is Ctor(<Pat1> | <Pat2>)` -> `(match <lhs> { ... => true, _ => false })`
  if !in_pattern && (t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent || t.kind == TokenKind::LParen) {
    match try_lower_or_is_expr(ctx, tokens, i, end, file) {
      Some((mcode, next_i)) => return (mcode, next_i)
      None => ()
    }
  }

  // 1. Interpolated string `"..."` or `$|...`
  if t.kind == TokenKind::InterpString {
    let ls = lower_interp_string(ctx, t.raw, false, file)
    if !in_pattern && is_expected_mbt_json(ctx) && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::String(" + ls + ")", i + 1)
    }
    return (trivia + ls, i + 1)
  }
  if t.kind == TokenKind::InterpMultiline {
    return (trivia + lower_interp_string(ctx, t.raw, true, file), i + 1)
  }
  // Plain string literal `"..."`: merge UTF-16 surrogate pairs & wrap under expected `MbtJson`
  if t.kind == TokenKind::StringLit {
    let fixed_s = lower_mbt_string_surrogates(t.raw, file, t.line, t.col, ctx.diags)
    if !in_pattern && is_expected_mbt_json(ctx) && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::String(" + fixed_s + ")", i + 1)
    }
    return (trivia + fixed_s, i + 1)
  }
  // `..<=` inclusive range: strictly inside `for` loop headers -> `..=`, fail-closed elsewhere!
  if t.kind == TokenKind::DotDotLtEq {
    if !in_pattern && ctx.in_for_header {
      return (trivia + "..=", i + 1)
    }
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "inclusive range `..<=` is only supported in `for` loop headers",
    ))
    return (trivia + "..=", i + 1)
  }
  // Recursive MoonBit JSON literals under expected `mbt_compat::MbtJson`
  if !in_pattern && is_expected_mbt_json(ctx) {
    if t.kind == TokenKind::Keyword && t.raw == "true" && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::True", i + 1)
    }
    if t.kind == TokenKind::Keyword && t.raw == "false" && !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::False", i + 1)
    }
    if t.kind == TokenKind::Ident && t.raw == "null" &&
    !(i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
    !(lookup_scope_var(ctx, "null") is Some(_)) && !ctx.symtab.local_value_names.contains("null") &&
    !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + "mbt_compat::MbtJson::Null", i + 1)
    }
    if t.kind == TokenKind::Minus && i + 1 < end &&
    (tokens[i + 1].kind == TokenKind::IntLit || tokens[i + 1].kind == TokenKind::FloatLit) &&
    !next_tok_breaks_json_lit(tokens, i + 2, end) {
      return (trivia + lower_json_number_lit(ctx, true, tokens[i + 1].raw, tokens[i + 1].kind == TokenKind::FloatLit, file, t.line, t.col), i + 2)
    }
    if (t.kind == TokenKind::IntLit || t.kind == TokenKind::FloatLit) &&
    !(i > 0 && tokens[i - 1].kind == TokenKind::Dot) &&
    !next_tok_breaks_json_lit(tokens, i + 1, end) {
      return (trivia + lower_json_number_lit(ctx, false, t.raw, t.kind == TokenKind::FloatLit, file, t.line, t.col), i + 1)
    }
  }
  // Raw multiline `#|...` is Pion-native: preserve verbatim!
  if t.kind == TokenKind::RawMultiline {
    return (trivia + t.raw, i + 1)
  }
  // Byte string `b"..."` & byte char `b'x'`
  if t.kind == TokenKind::ByteStringLit {
    return (trivia + lower_byte_string(t.raw), i + 1)
  }
  if t.kind == TokenKind::ByteCharLit {
    return (trivia + lower_byte_char(t.raw), i + 1)
  }

  // 1a. Fail-loud on unsupported MoonBit error-handling keywords (`raise`, `noraise`, `try`, `catch`) (#12a P1-2)
  if is_unsupported_error_kw(t) && !(i > 0 && tokens[i - 1].kind == TokenKind::Dot) {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "unsupported MoonBit error-handling syntax `" + t.raw + "` (requires explicit lowering or overlay)",
    ))
    return (trivia + t.raw, i + 1)
  }

  // 1b. Local `let` with tuple destructuring `let (a, b) [: (T0, T1)] = expr`
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, i + 1)
    let mut tup_eq_i = -1
    let mut tup_ann_ty = ""
    if cp + 1 < end && tokens[cp + 1].kind == TokenKind::Eq {
      tup_eq_i = cp + 1
    } else if cp + 2 < end && tokens[cp + 1].kind == TokenKind::Colon {
      let mut scan = cp + 2
      let mut sd = 0
      while scan < end {
        let sk = tokens[scan].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { sd = sd + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { if sd > 0 { sd = sd - 1 } }
        else if sd == 0 && sk == TokenKind::Eq { tup_eq_i = scan; break }
        scan = scan + 1
      }
      if tup_eq_i > cp + 2 {
        tup_ann_ty = lower_type_tokens_checked(ctx, tokens, cp + 2, tup_eq_i, file).trim()
      }
    }
    if tup_eq_i > cp {
      // Check if there is any nested `(` inside `( ... )`
      let mut has_nested = false
      let mut nk = i + 2
      while nk < cp {
        if tokens[nk].kind == TokenKind::LParen { has_nested = true; break }
        nk = nk + 1
      }
      if has_nested {
        let rhs_end = find_expr_end(tokens, tup_eq_i + 1, end)
        let rhs_s = lower_expr_range(ctx, tokens, tup_eq_i + 1, rhs_end, file, false).trim()
        let raw_b = collect_raw_pattern_binders(tokens, i + 1, cp + 1)
        let tup_rn = compute_scoped_binder_renames(ctx, raw_b)
        if tup_rn.length() > 0 {
          ctx.ident_renames.push(tup_rn)
        }
        let outer_vars : Array[String] = []
        let inner_lets : Array[String] = []
        let mut ai = i + 2
        while ai < cp {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < cp {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if tokens[ai].kind == TokenKind::LParen && ae - 1 == find_matching_delim(tokens, ai) {
            let tv = fresh_temp(ctx, "tup")
            outer_vars.push(tv)
            let inner_pat = lower_expr_range(ctx, tokens, ai, ae, file, true).trim()
            inner_lets.push("let " + inner_pat + " = " + tv)
          } else {
            outer_vars.push(lower_expr_range(ctx, tokens, ai, ae, file, true).trim())
          }
          ai = ae + 1
        }
        let sb = StringBuilder()
        let ty_part = if tup_ann_ty.length() > 0 { " : " + tup_ann_ty } else { "" }
        sb.write_string(trivia + "let (" + join_comma(outer_vars) + ")" + ty_part + " = " + rhs_s)
        for il in inner_lets {
          sb.write_string("; " + il)
        }
        for rb in raw_b {
          ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
        }
        return (sb.to_string(), rhs_end)
      } else {
        // Single-level tuple destructuring `let (a, b) [: (T0, T1)] = rhs`: lower RHS first, then register binders with inferred element types!
        let rhs_end = find_expr_end(tokens, tup_eq_i + 1, end)
        let rhs_ty = if tup_ann_ty.length() > 0 { tup_ann_ty } else { infer_simple_expr_type(ctx, tokens, tup_eq_i + 1, rhs_end).trim() }
        let rhs_s = lower_expr_range(ctx, tokens, tup_eq_i + 1, rhs_end, file, false)
        let raw_b = collect_raw_pattern_binders(tokens, i + 1, cp + 1)
        let tup_rn = compute_scoped_binder_renames(ctx, raw_b)
        if tup_rn.length() > 0 {
          ctx.ident_renames.push(tup_rn)
        }
        let pat_s = lower_expr_range(ctx, tokens, i + 1, cp + 1, file, true)
        let ty_part = if tup_ann_ty.length() > 0 { " : " + tup_ann_ty } else { "" }
        let elem_tys : Array[String] = []
        if rhs_ty.starts_with("(") && rhs_ty.ends_with(")") {
          let inner_t = rhs_ty.slice(1, rhs_ty.length() - 1)
          let mut si = 0
          let mut sstart = 0
          let mut sd = 0
          while si < inner_t.length() {
            let ch = inner_t.code_unit_at(si)
            if ch == 40 || ch == 91 || ch == 123 { sd = sd + 1 }
            else if ch == 41 || ch == 93 || ch == 125 { if sd > 0 { sd = sd - 1 } }
            else if sd == 0 && ch == 44 {
              elem_tys.push(inner_t.slice(sstart, si).trim())
              sstart = si + 1
            }
            si = si + 1
          }
          elem_tys.push(inner_t.slice(sstart, inner_t.length()).trim())
        }
        if elem_tys.length() > 0 {
          let mut ti = i + 2
          let mut tidx = 0
          while ti < cp {
            if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
            let mut te = ti
            let mut td = 0
            while te < cp {
              let tk = tokens[te].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
              else if td == 0 && tk == TokenKind::Comma { break }
              te = te + 1
            }
            let ety = if tidx < elem_tys.length() { elem_tys[tidx] } else { "" }
            if te == ti + 1 && tokens[ti].kind == TokenKind::Ident && tokens[ti].raw != "_" {
              ctx.scope_vars.push(ScopeVar::{
                name: resolve_ident_in_scope(ctx, tokens[ti].raw),
                ty: ety,
                is_mut: false,
                is_boxed: false,
              })
            } else {
              for rb in collect_raw_pattern_binders(tokens, ti, te) {
                ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
              }
            }
            tidx = tidx + 1
            ti = te + 1
          }
        } else {
          for rb in raw_b {
            ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
          }
        }
        return (trivia + "let" + pat_s + ty_part + tokens[tup_eq_i].leading_trivia + "=" + rhs_s, rhs_end)
      }
    }
  }

  // 1b1. Local `let { f1: v1, f2, .. } = expr` struct destructuring -> temp binding + field lets
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace {
    let cb = find_matching_delim(tokens, i + 1)
    if cb + 1 < end && tokens[cb + 1].kind == TokenKind::Eq {
      let rhs_end = find_expr_end(tokens, cb + 2, end)
      let rhs_s = lower_expr_range(ctx, tokens, cb + 2, rhs_end, file, false).trim()
      let tmp_s = fresh_temp(ctx, "ds")
      let sb = StringBuilder()
      sb.write_string(trivia + "let " + tmp_s + " = " + rhs_s)
      let mut fi = i + 2
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot {
          fi = fi + 1
          continue
        }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) {
          let fname = rename_keyword_ident(tokens[fi].raw)
          if fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
            let pat_s = lower_expr_range(ctx, tokens, fi + 2, fe, file, true).trim()
            if pat_s != "_" {
              sb.write_string("; let " + pat_s + " = " + tmp_s + "." + fname)
            }
          } else {
            sb.write_string("; let " + fname + " = " + tmp_s + "." + fname)
          }
        }
        fi = fe + 1
      }
      push_scope_binders(ctx, collect_pattern_binders(tokens, i + 1, cb + 1))
      return (sb.to_string(), rhs_end)
    }
  }

  // 1b1b. Local `let TupleStruct(p0, p1, ..) = expr` destructuring -> temp binding + field lets
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" && i + 2 < end &&
  tokens[i + 1].kind == TokenKind::UpperIdent && ctx.symtab.tuple_structs.contains(tokens[i + 1].raw) &&
  tokens[i + 2].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, i + 2)
    if cp + 1 < end && tokens[cp + 1].kind == TokenKind::Eq {
      let rhs_end = find_expr_end(tokens, cp + 2, end)
      let rhs_s = lower_expr_range(ctx, tokens, cp + 2, rhs_end, file, false).trim()
      let tmp_s = fresh_temp(ctx, "ts")
      let sb = StringBuilder()
      sb.write_string(trivia + "let " + tmp_s + " = " + rhs_s)
      let mut pi = i + 3
      let mut fidx = 0
      while pi < cp {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        if tokens[pi].kind == TokenKind::DotDot {
          break
        }
        let mut pe = pi
        let mut pd = 0
        while pe < cp {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
          else if pd == 0 && pk == TokenKind::Comma { break }
          pe = pe + 1
        }
        emit_tuple_struct_destructure(ctx, sb, tmp_s + "._" + fidx.to_string(), tokens, pi, pe, file)
        fidx = fidx + 1
        pi = pe + 1
      }
      push_scope_binders(ctx, collect_pattern_binders(tokens, i + 2, cp + 1))
      return (sb.to_string(), rhs_end)
    }
  }

  // 1b2. Local `let [mut] <name> [: <Type>] =` — lower `<Type>` through `lower_type_tokens`,
  //     box `let mut` locals captured by lifted recursive local `fn`s into `mbt_compat::MbtCell`,
  //     track `ScopeVar` for inner closures (pushed AFTER lowering RHS so `let x = x + 1` sees outer `x`!),
  //     and wrap `ArrayBuf`-promoted array literals!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "let" {
    let mut name_i = i + 1
    let mut is_mut = false
    if name_i < end && tokens[name_i].kind == TokenKind::Keyword && tokens[name_i].raw == "mut" {
      is_mut = true
      name_i = name_i + 1
    }
    if name_i + 1 < end && (tokens[name_i].kind == TokenKind::Ident || tokens[name_i].raw == "_") {
      let raw_lname = tokens[name_i].raw
      let let_rn = if raw_lname == "_" { Map() } else { compute_scoped_binder_renames(ctx, [raw_lname]) }
      let lname = if raw_lname == "_" {
        "_"
      } else {
        match let_rn.get(raw_lname) {
          Some(v) => v
          None => rename_keyword_ident(raw_lname)
        }
      }
      let mut_kw = if is_mut { "mut " } else { "" }
      let is_boxed = is_mut && lname != "_" && ctx.boxed_mut_vars.contains(lname)
      if name_i + 2 < end && tokens[name_i + 1].kind == TokenKind::Colon {
        let mut eq_i = name_i + 2
        let mut td = 0
        while eq_i < end {
          let tk = tokens[eq_i].kind
          if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace {
            td = td + 1
          } else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace {
            td = td - 1
          } else if td == 0 && tk == TokenKind::Eq {
            break
          }
          eq_i = eq_i + 1
        }
        if eq_i < end && tokens[eq_i].kind == TokenKind::Eq {
          let lty = lower_type_tokens_checked(ctx, tokens, name_i + 2, eq_i, file).trim()
          if is_boxed {
            let rhs_end = find_expr_end(tokens, eq_i + 1, end)
            let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false).trim()
            if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
            if lname != "_" {
              ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
            }
            return (trivia + "let " + lname + " : mbt_compat::MbtCell[" + lty + "] = mbt_compat::MbtCell::{ v: " + rhs_s + " }", rhs_end)
          }
          if ctx.borrowed_bufs.contains(lname) && eq_i + 1 < end && tokens[eq_i + 1].kind == TokenKind::LBracket {
            let close_arr = find_matching_delim(tokens, eq_i + 1)
            let arr_lit = lower_expr_range(ctx, tokens, eq_i + 1, close_arr + 1, file, false).trim()
            if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
            if lname != "_" {
              ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
            }
            return (trivia + "let " + mut_kw + lname + " = mbt_compat::ArrayBuf::from_array(" + arr_lit + ")", close_arr + 1)
          }
          let rhs_end = find_expr_end(tokens, eq_i + 1, end)
          push_expected_type(ctx, lty)
          let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false)
          pop_expected_type(ctx)
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: lty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + mut_kw + lname + " : " + lty + " =" + rhs_s, rhs_end)
        }
      } else if name_i + 1 < end && tokens[name_i + 1].kind == TokenKind::Eq {
        let eq_i = name_i + 1
        let rhs_end = find_expr_end(tokens, eq_i + 1, end)
        let inf_ty = infer_simple_expr_type(ctx, tokens, eq_i + 1, rhs_end)
        if is_boxed {
          let rhs_s = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false).trim()
          let ty_ann = if inf_ty.length() > 0 { " : mbt_compat::MbtCell[" + inf_ty + "]" } else { "" }
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + lname + ty_ann + " = mbt_compat::MbtCell::{ v: " + rhs_s + " }", rhs_end)
        }
        if ctx.borrowed_bufs.contains(lname) && eq_i + 1 < end && tokens[eq_i + 1].kind == TokenKind::LBracket {
          let close_arr = find_matching_delim(tokens, eq_i + 1)
          let arr_lit = lower_expr_range(ctx, tokens, eq_i + 1, close_arr + 1, file, false).trim()
          if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
          if lname != "_" {
            ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
          }
          return (trivia + "let " + mut_kw + lname + " = mbt_compat::ArrayBuf::from_array(" + arr_lit + ")", close_arr + 1)
        }
        let rhs_s = {
          push_expected_type(ctx, "")
          let r = lower_expr_range(ctx, tokens, eq_i + 1, rhs_end, file, false)
          pop_expected_type(ctx)
          r
        }
        if let_rn.length() > 0 { ctx.ident_renames.push(let_rn) }
        if lname != "_" {
          ctx.scope_vars.push(ScopeVar::{ name: lname, ty: inf_ty, is_mut: is_mut, is_boxed: is_boxed })
        }
        return (trivia + "let " + mut_kw + lname + " =" + rhs_s, rhs_end)
      }
    }
  }

  // 1b3. `return <expr>`: push enclosing function return type for expected-type enum disambiguation
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "return" && ctx.cur_fn_ret_ty.length() > 0 {
    let next_i = i + 1
    if next_i < end && !tokens[next_i].newline_before &&
    tokens[next_i].kind != TokenKind::RBrace && tokens[next_i].kind != TokenKind::Semi &&
    tokens[next_i].kind != TokenKind::RParen && tokens[next_i].kind != TokenKind::Comma {
      let expr_end = find_expr_end(tokens, next_i, end)
      if expr_end > next_i {
        push_expected_type(ctx, ctx.cur_fn_ret_ty)
        let expr_s = lower_expr_range(ctx, tokens, next_i, expr_end, file, false)
        pop_expected_type(ctx)
        return (trivia + "return" + expr_s, expr_end)
      }
    }
  }

  // 1b4. `if <cond> { ... }`: isolate condition expected type as `Bool`, scope `is <Pat>` binders into
  //      subsequent `&&` and the `then` block only (restored before `else`), while preserving outer expected type for branches!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "if" {
    let mut lb = i + 1
    let mut pd = 0
    while lb < end {
      let lk = tokens[lb].kind
      if pd == 0 && lk == TokenKind::LBrace {
        if !(lb > i + 1 && tokens[lb - 1].kind == TokenKind::ColonColon) {
          break
        }
      }
      if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { pd = pd + 1 }
      else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      lb = lb + 1
    }
    if lb < end && tokens[lb].kind == TokenKind::LBrace && lb > i + 1 {
      let close_b = find_matching_delim(tokens, lb)
      let saved_if_sc = ctx.scope_vars.length()
      push_expected_type(ctx, "Bool")
      let cond_s = lower_cond_with_is_binders(ctx, tokens, i + 1, lb, file)
      pop_expected_type(ctx)
      let then_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
      restore_scope_vars(ctx, saved_if_sc)
      return (trivia + "if" + cond_s + tokens[lb].leading_trivia + then_s, close_b + 1)
    }
  }

  // 1b5. `for` loop (`for x in iter { ... }`, `for i, x in iter { ... }`, `for i = 0; cond; step { ... }`):
  //      push loop binders onto `ctx.scope_vars` so they shadow any colliding black-box private top-levels!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "for" {
    let mut lb = i + 1
    let mut pd = 0
    while lb < end {
      let lk = tokens[lb].kind
      if pd == 0 && lk == TokenKind::LBrace {
        if !(lb > i + 1 && tokens[lb - 1].kind == TokenKind::ColonColon) {
          break
        }
      }
      if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { pd = pd + 1 }
      else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { if pd > 0 { pd = pd - 1 } }
      lb = lb + 1
    }
    if lb < end && tokens[lb].kind == TokenKind::LBrace && lb > i + 1 {
      let close_b = find_matching_delim(tokens, lb)
      // Check for depth-0 `in` vs depth-0 `;` in `[i + 1, lb)`
      let mut in_idx = -1
      let mut semi1 = -1
      let mut k = i + 1
      let mut kd = 0
      while k < lb {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { kd = kd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if kd > 0 { kd = kd - 1 } }
        else if kd == 0 {
          if kk == TokenKind::Keyword && tokens[k].raw == "in" && in_idx < 0 { in_idx = k }
          else if kk == TokenKind::Semi && semi1 < 0 { semi1 = k }
        }
        k = k + 1
      }
      if in_idx > i + 1 {
        let saved_fh = ctx.in_for_header
        ctx.in_for_header = true
        let iter_ty = infer_simple_expr_type(ctx, tokens, in_idx + 1, lb)
        let iter_s = lower_expr_range(ctx, tokens, in_idx + 1, lb, file, false)
        ctx.in_for_header = saved_fh
        let saved_for_sc = ctx.scope_vars.length()
        let saved_for_rn = ctx.ident_renames.length()
        let raw_for_b = collect_raw_pattern_binders(tokens, i + 1, in_idx)
        let for_rn = compute_scoped_binder_renames(ctx, raw_for_b)
        if for_rn.length() > 0 {
          ctx.ident_renames.push(for_rn)
        }
        let vars_s = lower_expr_range(ctx, tokens, i + 1, in_idx, file, true)
        for rb in raw_for_b {
          ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
        }
        let elem_ty = extract_container_value_type(iter_ty)
        if elem_ty.length() > 0 {
          if in_idx == i + 2 && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 1].raw != "_" {
            ctx.scope_vars.push(ScopeVar::{
              name: resolve_ident_in_scope(ctx, tokens[i + 1].raw),
              ty: elem_ty,
              is_mut: false,
              is_boxed: false,
            })
          } else if in_idx == i + 4 && tokens[i + 2].kind == TokenKind::Comma && tokens[i + 3].kind == TokenKind::Ident && tokens[i + 3].raw != "_" {
            ctx.scope_vars.push(ScopeVar::{
              name: resolve_ident_in_scope(ctx, tokens[i + 3].raw),
              ty: elem_ty,
              is_mut: false,
              is_boxed: false,
            })
          } else if tokens[i + 1].kind == TokenKind::LParen && find_matching_delim(tokens, i + 1) == in_idx - 1 &&
          elem_ty.starts_with("(") && elem_ty.ends_with(")") {
            let mut ti = i + 2
            let mut tidx = 0
            while ti < in_idx - 1 {
              if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
              if tokens[ti].kind == TokenKind::Ident && tokens[ti].raw != "_" {
                let et = extract_tuple_elem_type(elem_ty, tidx)
                if et.length() > 0 {
                  ctx.scope_vars.push(ScopeVar::{
                    name: resolve_ident_in_scope(ctx, tokens[ti].raw),
                    ty: et,
                    is_mut: false,
                    is_boxed: false,
                  })
                }
              }
              tidx = tidx + 1
              ti = ti + 1
            }
          }
        }
        let body_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
        restore_scope_vars(ctx, saved_for_sc)
        restore_ident_renames(ctx, saved_for_rn)
        return (trivia + "for" + vars_s + tokens[in_idx].leading_trivia + "in" + iter_s + tokens[lb].leading_trivia + body_s, close_b + 1)
      } else if semi1 > i + 1 {
        // C-style `for v1 = init1, v2 = init2; cond; step { body }`
        let loop_vars : Array[String] = []
        let init_sb = StringBuilder()
        let mut vi = i + 1
        while vi < semi1 {
          if tokens[vi].kind == TokenKind::Ident && vi + 1 < semi1 && tokens[vi + 1].kind == TokenKind::Eq {
            let vname = rename_keyword_ident(tokens[vi].raw)
            loop_vars.push(vname)
            init_sb.write_string(tokens[vi].leading_trivia + vname + tokens[vi + 1].leading_trivia + "=")
            let mut ve = vi + 2
            let mut vd = 0
            while ve < semi1 {
              let vk = tokens[ve].kind
              if vk == TokenKind::LParen || vk == TokenKind::LBracket || vk == TokenKind::LBrace { vd = vd + 1 }
              else if vk == TokenKind::RParen || vk == TokenKind::RBracket || vk == TokenKind::RBrace { if vd > 0 { vd = vd - 1 } }
              else if vd == 0 && vk == TokenKind::Comma { break }
              ve = ve + 1
            }
            init_sb.write_string(lower_expr_range(ctx, tokens, vi + 2, ve, file, false))
            if ve < semi1 && tokens[ve].kind == TokenKind::Comma {
              init_sb.write_string(tokens[ve].leading_trivia + ",")
              vi = ve + 1
            } else {
              vi = ve
            }
          } else {
            let (p, ni) = lower_one_token_or_form(ctx, tokens, vi, semi1, file, false)
            init_sb.write_string(p)
            vi = ni
          }
        }
        let saved_for_sc = ctx.scope_vars.length()
        push_scope_binders(ctx, loop_vars)
        let rest_hdr = lower_expr_range(ctx, tokens, semi1, lb, file, false)
        let body_s = lower_block_range(ctx, tokens, lb, close_b, file, "")
        restore_scope_vars(ctx, saved_for_sc)
        return (trivia + "for" + init_sb.to_string() + rest_hdr + tokens[lb].leading_trivia + body_s, close_b + 1)
      }
    }
  }

  // 1c. Anonymous closure `fn(params) [-> Ret] { body }` — run all param & return types through `lower_type_tokens_checked`!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "fn" && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
    let open_p = i + 1
    let close_p = find_matching_delim(tokens, open_p)
    let (p_str, p_pre, _, p_renames) = lower_param_list_scoped(ctx, tokens, open_p, close_p, file, false, true)
    let raw_p_names = extract_raw_param_names(tokens, open_p, close_p)
    let (_, p_tys, _) = extract_param_info(ctx, tokens, open_p, close_p, file)
    let mut cur = close_p + 1
    let mut ret_str = ""
    if cur < end && tokens[cur].kind == TokenKind::Arrow {
      let mut r_end = cur + 1
      let mut rd = 0
      while r_end < end {
        let rk = tokens[r_end].kind
        if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::RBrace || rk == TokenKind::RParen || rk == TokenKind::Semi) {
          break
        }
        if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
        else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
        r_end = r_end + 1
      }
      ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, cur + 1, r_end, file)
      cur = r_end
    }
    if cur < end && tokens[cur].kind == TokenKind::LBrace {
      let close_b = find_matching_delim(tokens, cur)
      let saved_fn_sc = ctx.scope_vars.length()
      let saved_fn_rn = ctx.ident_renames.length()
      if p_renames.length() > 0 {
        ctx.ident_renames.push(p_renames)
      }
      let mut pi = 0
      while pi < raw_p_names.length() {
        if raw_p_names[pi] != "_" {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          let pty = if pi < p_tys.length() { p_tys[pi] } else { "" }
          ctx.scope_vars.push(ScopeVar::{ name: eff_pn, ty: pty, is_mut: false, is_boxed: false })
        }
        pi = pi + 1
      }
      ctx.in_closure_depth = ctx.in_closure_depth + 1
      let body = lower_block_range(ctx, tokens, cur, close_b, file, p_pre)
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_scope_vars(ctx, saved_fn_sc)
      restore_ident_renames(ctx, saved_fn_rn)
      return (trivia + "fn(" + p_str + ")" + ret_str + " " + body, close_b + 1)
    }
  }

  // 1d. `is <Pattern>` expression — lower RHS in pattern mode (`in_pattern = true`), stopping at depth-0 newline!
  if !in_pattern && t.kind == TokenKind::Keyword && t.raw == "is" && i + 1 < end {
    let mut pat_end = i + 1
    let mut pd = 0
    while pat_end < end {
      let pk = tokens[pat_end].kind
      if pd == 0 && pat_end > i + 1 && tokens[pat_end].newline_before {
        break
      }
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
        if pd == 0 && pk == TokenKind::LBrace {
          // `{` at depth 0 starts the `if` body block unless preceded by `::`
          if !(pat_end > i + 1 && tokens[pat_end - 1].kind == TokenKind::ColonColon) {
            break
          }
        }
        pd = pd + 1
      } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
        if pd == 0 { break }
        pd = pd - 1
      } else if pd == 0 && (pk == TokenKind::AmpAmp || pk == TokenKind::PipePipe || pk == TokenKind::Comma || pk == TokenKind::Semi || pk == TokenKind::EqEq || pk == TokenKind::BangEq || (pk == TokenKind::Keyword && tokens[pat_end].raw == "else")) {
        break
      }
      pat_end = pat_end + 1
    }
    let pat_str = lower_expr_range(ctx, tokens, i + 1, pat_end, file, true)
    return (trivia + "is" + pat_str, pat_end)
  }

  // 2. Arrow functions: `(a, b) => expr` AND single-param `x => expr` / `_ => expr`
  //    Also handles type ascription `(expr : Type)` -> `(expr)` (or `Float::from_double(lit)` for Float).
  //    (strictly distinguished from match arms because `lower_match_arms` handles arm `=>` with `in_pattern = true`!)
  if !in_pattern && t.kind == TokenKind::LParen {
    let close_p = is_arrow_fn_at(tokens, i, end)
    if close_p >= 0 {
      let (p_str, _, _, p_renames) = lower_param_list_scoped(ctx, tokens, i, close_p, file, false, true)
      let raw_p_names = extract_raw_param_names(tokens, i, close_p)
      let (_, p_tys, _) = extract_param_info(ctx, tokens, i, close_p, file)
      let saved_arr_sc = ctx.scope_vars.length()
      let saved_arr_rn = ctx.ident_renames.length()
      if p_renames.length() > 0 {
        ctx.ident_renames.push(p_renames)
      }
      let mut pi = 0
      while pi < raw_p_names.length() {
        if raw_p_names[pi] != "_" {
          let eff_pn = resolve_ident_in_scope(ctx, raw_p_names[pi])
          let pty = if pi < p_tys.length() { p_tys[pi] } else { "" }
          ctx.scope_vars.push(ScopeVar::{ name: eff_pn, ty: pty, is_mut: false, is_boxed: false })
        }
        pi = pi + 1
      }
      let body_start = close_p + 2
      ctx.in_closure_depth = ctx.in_closure_depth + 1
      if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
        let body_close = find_matching_delim(tokens, body_start)
        let body = lower_block_range(ctx, tokens, body_start, body_close, file, "")
        ctx.in_closure_depth = ctx.in_closure_depth - 1
        restore_scope_vars(ctx, saved_arr_sc)
        restore_ident_renames(ctx, saved_arr_rn)
        return (trivia + "fn(" + p_str + ") " + body, body_close + 1)
      }
      let body_end = find_expr_end(tokens, body_start, end)
      let body_expr = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_scope_vars(ctx, saved_arr_sc)
      restore_ident_renames(ctx, saved_arr_rn)
      return (trivia + "fn(" + p_str + ") { " + body_expr + " }", body_end)
    }
    // Check type ascription `(expr : Type)` (single top-level `:`, no top-level `,`, RHS starts with type token)
    let cp = find_matching_delim(tokens, i)
    if cp > i + 3 {
      let mut colon_pos = -1
      let mut colon_cnt = 0
      let mut has_comma = false
      let mut sk = i + 1
      let mut sd = 0
      while sk < cp {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace { sd = sd + 1 }
        else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace { sd = sd - 1 }
        else if sd == 0 {
          if skk == TokenKind::Colon {
            colon_pos = sk
            colon_cnt = colon_cnt + 1
          } else if skk == TokenKind::Comma {
            has_comma = true
          }
        }
        sk = sk + 1
      }
      if colon_cnt == 1 && !has_comma && colon_pos > i + 1 && colon_pos + 1 < cp {
        let rhs_k = tokens[colon_pos + 1].kind
        if rhs_k == TokenKind::Amp {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[colon_pos + 1].line,
            tokens[colon_pos + 1].col,
            "trait object type ascription `(&Trait)` is not supported",
          ))
          let inner_e = lower_expr_range(ctx, tokens, i + 1, colon_pos, file, false).trim()
          return (trivia + "(" + inner_e + ")", cp + 1)
        }
        if rhs_k == TokenKind::UpperIdent || rhs_k == TokenKind::PkgRef || rhs_k == TokenKind::LParen {
          let asc_ty = lower_type_tokens_checked(ctx, tokens, colon_pos + 1, cp, file).trim()
          // Never silently strip type ascription `(e : T)`!
          // Fast path for numeric literals (including unary `-`): emit exact typed Pion literal/conversion.
          let is_pos_int = colon_pos == i + 2 && tokens[i + 1].kind == TokenKind::IntLit
          let is_neg_int = colon_pos == i + 3 && tokens[i + 1].kind == TokenKind::Minus && tokens[i + 2].kind == TokenKind::IntLit
          let is_pos_flt = colon_pos == i + 2 && tokens[i + 1].kind == TokenKind::FloatLit
          let is_neg_flt = colon_pos == i + 3 && tokens[i + 1].kind == TokenKind::Minus && tokens[i + 2].kind == TokenKind::FloatLit
          if is_pos_int || is_neg_int {
            let num_raw = if is_neg_int { "-" + tokens[i + 2].raw } else { tokens[i + 1].raw }
            let has_suffix = num_raw.ends_with("L") || num_raw.ends_with("l") || num_raw.ends_with("U") || num_raw.ends_with("u")
            if asc_ty == "Int64" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "L" }), cp + 1)
            } else if asc_ty == "UInt" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "U" }), cp + 1)
            } else if asc_ty == "UInt64" {
              return (trivia + (if has_suffix { num_raw } else { num_raw + "UL" }), cp + 1)
            } else if asc_ty == "Double" {
              return (trivia + num_raw + ".0", cp + 1)
            } else if asc_ty == "Float" {
              return (trivia + "Float::from_double(" + num_raw + ".0)", cp + 1)
            } else if asc_ty == "Byte" {
              return (trivia + "(" + num_raw + ").to_byte()", cp + 1)
            } else if asc_ty == "Int16" {
              return (trivia + "(" + num_raw + ").to_int16()", cp + 1)
            } else if asc_ty == "Int" {
              return (trivia + num_raw, cp + 1)
            }
          }
          if is_pos_flt || is_neg_flt {
            let raw_tok = if is_neg_flt { tokens[i + 2].raw } else { tokens[i + 1].raw }
            if !raw_tok.starts_with("0x") && !raw_tok.starts_with("0X") {
              let mut flt_raw = if is_neg_flt { "-" + raw_tok } else { raw_tok }
              if flt_raw.ends_with("F") {
                flt_raw = flt_raw.slice(0, flt_raw.length() - 1)
              }
              if asc_ty == "Float" {
                return (trivia + "Float::from_double(" + flt_raw + ")", cp + 1)
              } else if asc_ty == "Double" {
                return (trivia + flt_raw, cp + 1)
              }
            } else if asc_ty == "Float" {
              let hex_body = if raw_tok.ends_with("F") { raw_tok.slice(0, raw_tok.length() - 1) } else { raw_tok }
              match parse_hex_float_to_bits(hex_body) {
                Some(bits64) => {
                  let sign_prefix = if is_neg_flt { "-" } else { "" }
                  return (trivia + "Float::from_double(" + sign_prefix + "Double::from_bits(" + bits64.to_string() + "L))", cp + 1)
                }
                None => ()
              }
            }
          }
          push_expected_type(ctx, asc_ty)
          let inner_e = lower_expr_range(ctx, tokens, i + 1, colon_pos, file, false).trim()
          pop_expected_type(ctx)
          let asc_tmp = fresh_temp(ctx, "asc")
          return (trivia + "({ let " + asc_tmp + " : " + asc_ty + " = " + inner_e + "; " + asc_tmp + " })", cp + 1)
        }
      }
    }
  }
  if !in_pattern && (t.kind == TokenKind::Ident || t.kind == TokenKind::Underscore) &&
  i + 1 < end && tokens[i + 1].kind == TokenKind::FatArrow &&
  !(i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
    let saved_arr_sc = ctx.scope_vars.length()
    let saved_arr_rn = ctx.ident_renames.length()
    let arr_rn = if t.kind == TokenKind::Underscore { Map() } else { compute_scoped_binder_renames(ctx, [t.raw]) }
    if arr_rn.length() > 0 {
      ctx.ident_renames.push(arr_rn)
    }
    let pname = if t.kind == TokenKind::Underscore { "_" } else { resolve_ident_in_scope(ctx, t.raw) }
    if pname != "_" {
      ctx.scope_vars.push(ScopeVar::{ name: pname, ty: "", is_mut: false, is_boxed: false })
    }
    let body_start = i + 2
    ctx.in_closure_depth = ctx.in_closure_depth + 1
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      let body_close = find_matching_delim(tokens, body_start)
      let body = lower_block_range(ctx, tokens, body_start, body_close, file, "")
      ctx.in_closure_depth = ctx.in_closure_depth - 1
      restore_scope_vars(ctx, saved_arr_sc)
      restore_ident_renames(ctx, saved_arr_rn)
      return (trivia + "fn(" + pname + ") " + body, body_close + 1)
    }
    let body_end = find_expr_end(tokens, body_start, end)
    let body_expr = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
    ctx.in_closure_depth = ctx.in_closure_depth - 1
    restore_scope_vars(ctx, saved_arr_sc)
    restore_ident_renames(ctx, saved_arr_rn)
    return (trivia + "fn(" + pname + ") { " + body_expr + " }", body_end)
  }

  // 3. Nested `{ ... }` block, Map literal, Ref literal `{ val: e }`, or anonymous struct literal `S::{ ... }`
  if !in_pattern && (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) &&
  t.raw == "try" && i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace {
    let close_tb = find_matching_delim(tokens, i + 1)
    ctx.in_try_catch_depth = ctx.in_try_catch_depth + 1
    let tbody = lower_block_range(ctx, tokens, i + 1, close_tb, file, "")
    ctx.in_try_catch_depth = ctx.in_try_catch_depth - 1
    return (trivia + "try" + tokens[i + 1].leading_trivia + tbody, close_tb + 1)
  }
  if t.kind == TokenKind::LBrace {
    let close_b = find_matching_delim(tokens, i)
    if !in_pattern {
      if close_b == i + 1 {
        let raw_exp = current_expected_type(ctx).trim()
        if is_expected_mbt_json(ctx) {
          return (trivia + "mbt_compat::MbtJson::Object(mbt_compat::ordered_map_new())", close_b + 1)
        }
        if str_has(raw_exp, "OrderedMap") || raw_exp.starts_with("Map[") {
          return (trivia + "mbt_compat::ordered_map_new()", close_b + 1)
        }
      }
      match try_lower_ref_literal(ctx, tokens, i, close_b, file) {
        Some(ref_code) => return (trivia + ref_code, close_b + 1)
        None => ()
      }
      if is_map_literal(tokens, i, close_b) {
        if is_expected_mbt_json(ctx) {
          let sb = StringBuilder()
          sb.write_string("mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([")
          let mut cur = i + 1
          let mut first = true
          while cur < close_b {
            if tokens[cur].kind == TokenKind::Comma {
              cur = cur + 1
              continue
            }
            let mut col_i = cur
            let mut d = 0
            while col_i < close_b {
              let kk = tokens[col_i].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Colon { break }
              col_i = col_i + 1
            }
            if col_i >= close_b { break }
            let mut v_end = col_i + 1
            d = 0
            while v_end < close_b {
              let kk = tokens[v_end].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Comma { break }
              v_end = v_end + 1
            }
            push_expected_type(ctx, "")
            let k_s = lower_expr_range(ctx, tokens, cur, col_i, file, false).trim()
            pop_expected_type(ctx)
            push_expected_type(ctx, "mbt_compat::MbtJson")
            let v_s = lower_expr_range(ctx, tokens, col_i + 1, v_end, file, false).trim()
            pop_expected_type(ctx)
            if !first { sb.write_string(", ") }
            first = false
            sb.write_string("(" + k_s + ", " + v_s + ")")
            cur = v_end + 1
          }
          sb.write_string("]))")
          return (trivia + sb.to_string(), close_b + 1)
        }
        let ml = lower_map_literal(ctx, tokens, i, close_b, file)
        return (trivia + ml, close_b + 1)
      }
      match resolve_anon_struct_literal_name(ctx, tokens, i, close_b) {
        Some(sname) => {
          let body_s = if is_anon_shorthand_struct_lit(tokens, i, close_b) {
            lower_anon_shorthand_struct_lit(ctx, sname, tokens, i, close_b, file)
          } else {
            lower_struct_brace(ctx, sname, tokens, i, close_b, file, false)
          }
          return (trivia + sname + "::" + body_s, close_b + 1)
        }
        None => ()
      }
      if is_anon_shorthand_struct_lit(tokens, i, close_b) {
        return (trivia + lower_anon_shorthand_struct_lit(ctx, "", tokens, i, close_b, file), close_b + 1)
      }
    }
    let blk = lower_block_range(ctx, tokens, i, close_b, file, "")
    return (trivia + blk, close_b + 1)
  }

  // 3b. Array literal under expected `MbtJson` (`[1, "a", []]` -> `mbt_compat::MbtJson::Array([...])`)
  //     and array literal with spread `[..xs, a, ..ys]`
  if !in_pattern && t.kind == TokenKind::LBracket {
    let close_br = find_matching_delim(tokens, i)
    if is_expected_mbt_json(ctx) && !next_tok_breaks_json_lit(tokens, close_br + 1, end) {
      let sb = StringBuilder()
      sb.write_string("mbt_compat::MbtJson::Array([")
      let mut ai = i + 1
      let mut first = true
      while ai < close_br {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_br {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai {
          push_expected_type(ctx, "mbt_compat::MbtJson")
          let item_e = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          pop_expected_type(ctx)
          if !first { sb.write_string(", ") }
          first = false
          sb.write_string(item_e)
        }
        ai = ae + 1
      }
      sb.write_string("])")
      return (trivia + sb.to_string(), close_br + 1)
    }
    if close_br > i + 1 {
      let mut has_spread = false
      let mut sk = i + 1
      let mut sd = 0
      let mut at_elem_start = true
      while sk < close_br {
        let skk = tokens[sk].kind
        if skk == TokenKind::LParen || skk == TokenKind::LBracket || skk == TokenKind::LBrace {
          sd = sd + 1
          at_elem_start = false
        } else if skk == TokenKind::RParen || skk == TokenKind::RBracket || skk == TokenKind::RBrace {
          sd = sd - 1
          at_elem_start = false
        } else if sd == 0 && skk == TokenKind::Comma {
          at_elem_start = true
        } else if sd == 0 && at_elem_start && skk == TokenKind::DotDot {
          has_spread = true
          break
        } else {
          at_elem_start = false
        }
        sk = sk + 1
      }
      if has_spread {
        let arr_tmp = fresh_temp(ctx, "sp")
        let sb = StringBuilder()
        sb.write_string(trivia + "({ let " + arr_tmp + " = []; ")
        let mut ai = i + 1
        while ai < close_br {
          if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
          let mut ae = ai
          let mut ad = 0
          while ae < close_br {
            let ak = tokens[ae].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { break }
            ae = ae + 1
          }
          if tokens[ai].kind == TokenKind::DotDot && ai + 1 < ae {
            let elem_tmp = fresh_temp(ctx, "spe")
            let spread_e = lower_expr_range(ctx, tokens, ai + 1, ae, file, false).trim()
            sb.write_string("for " + elem_tmp + " in " + spread_e + " { " + arr_tmp + ".push(" + elem_tmp + ") }; ")
          } else if ae > ai {
            let item_e = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
            sb.write_string(arr_tmp + ".push(" + item_e + "); ")
          }
          ai = ae + 1
        }
        sb.write_string(arr_tmp + " })")
        return (sb.to_string(), close_br + 1)
      }
    }
  }

  // 4. `match expr { pat => body, ... }` — preserve match arms and lower patterns with scrutinee expected type!
  if t.kind == TokenKind::Keyword && t.raw == "match" {
    let mut brace_i = i + 1
    let mut depth = 0
    while brace_i < end {
      let bk = tokens[brace_i].kind
      if bk == TokenKind::LParen || bk == TokenKind::LBracket {
        depth = depth + 1
      } else if bk == TokenKind::RParen || bk == TokenKind::RBracket {
        depth = depth - 1
      } else if bk == TokenKind::LBrace && depth == 0 {
        let cb_try = find_matching_delim(tokens, brace_i)
        if cb_try + 1 < end && tokens[cb_try + 1].kind == TokenKind::LBrace {
          brace_i = cb_try + 1
        }
        break
      }
      brace_i = brace_i + 1
    }
    if brace_i < end {
      let close_b = find_matching_delim(tokens, brace_i)
      let scrut_ty = infer_simple_expr_type(ctx, tokens, i + 1, brace_i)
      push_expected_type(ctx, "")
      let scrut = lower_expr_range(ctx, tokens, i + 1, brace_i, file, false)
      pop_expected_type(ctx)
      let mut eff_scrut_ty = scrut_ty
      if eff_scrut_ty.length() == 0 {
        let (bare_ctors, has_labeled) = collect_match_top_bare_ctors(ctx, tokens, brace_i + 1, close_b)
        if bare_ctors.length() > 0 {
          let (inter, any_ambig) = symtab_intersect_ctor_enums(ctx.symtab, bare_ctors)
          if any_ambig {
            let complete = symtab_sources_complete(ctx.symtab)
            if complete && inter.length() == 1 && (!has_labeled || ctx.symtab.enum_schemas.contains(inter[0])) {
              eff_scrut_ty = inter[0]
            } else {
              let probed = lower_ambig_match_probe(ctx, tokens, brace_i, close_b, scrut, file, inter, !complete)
              return (trivia + probed, close_b + 1)
            }
          }
        }
      }
      // P0-2: Push sentinel so outer match's array element cache NEVER leaks into a nested `match`!
      ctx.match_arr_cache_ctor.push("__BLOCKED__")
      ctx.match_arr_cache_elems.push(Map())
      ctx.match_arr_cache_suffix.push(Map())
      ctx.match_arr_cache_len.push("")
      let arms = lower_match_arms_with_ty(ctx, tokens, brace_i + 1, close_b, file, eff_scrut_ty)
      let _ = ctx.match_arr_cache_ctor.pop()
      let _ = ctx.match_arr_cache_elems.pop()
      let _ = ctx.match_arr_cache_suffix.pop()
      let _ = ctx.match_arr_cache_len.pop()
      return (trivia + "match" + scrut + tokens[brace_i].leading_trivia + "{" + arms + tokens[close_b].leading_trivia + "}", close_b + 1)
    }
  }

  // 5. Package-qualified reference `@pkg.sym` (including `@math`/`@double`/`@utf8`/`@string`/`@int`/`@uint` and `api_map` routing)
  if t.kind == TokenKind::PkgRef {
    let raw_pkg = t.raw.slice(1, t.raw.length())
    let mapped_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
      Some(p) => p
      None =>
      match ctx.symtab.moon_import_paths.get(raw_pkg) {
        Some(fp) => {
          let def_al = moon_import_default_alias(fp)
          if !ctx.symtab.dep_pkg_names.contains(raw_pkg) && ctx.symtab.dep_pkg_names.contains(def_al) {
            def_al
          } else {
            raw_pkg
          }
        }
        None => raw_pkg
      }
    }
    if i + 2 < end && tokens[i + 1].kind == TokenKind::Dot {
      let sym_tok = tokens[i + 2]
      let sym_raw = sym_tok.raw
      // Built-in MoonBit stdlib package mappings (project-agnostic; guarded by `is_moonbit_core_pkg`)
      if !ctx.symtab.api_by_key.contains(raw_pkg + "::" + sym_raw) {
        if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "double") {
          if sym_raw == "not_a_number" { return (trivia + "mbt_compat::double_nan()", i + 3) }
          if sym_raw == "infinity" { return (trivia + "mbt_compat::double_inf()", i + 3) }
          if sym_raw == "neg_infinity" { return (trivia + "mbt_compat::double_neg_inf()", i + 3) }
          if sym_raw == "max_value" { return (trivia + "mbt_compat::double_max_value()", i + 3) }
          if sym_raw == "min_value" { return (trivia + "mbt_compat::double_min_value()", i + 3) }
          if sym_raw == "min_positive" { return (trivia + "mbt_compat::double_min_positive()", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "math") {
          if sym_raw == "PI" { return (trivia + "mbt_compat::double_pi()", i + 3) }
          if sym_raw == "sin" || sym_raw == "cos" || sym_raw == "tan" || sym_raw == "asin" ||
          sym_raw == "acos" || sym_raw == "atan" || sym_raw == "atan2" || sym_raw == "exp" ||
          sym_raw == "ln" || sym_raw == "pow" || sym_raw == "floor" || sym_raw == "ceil" ||
          sym_raw == "round" || sym_raw == "trunc" || sym_raw == "sqrt" || sym_raw == "cbrt" ||
          sym_raw == "hypot" || sym_raw == "maximum" || sym_raw == "minimum" {
            let fn_name = "mbt_compat::math_" + sym_raw
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "encoding/utf8") {
          if sym_raw == "decode_lossy" || sym_raw == "encode" {
            let fn_name = "mbt_compat::utf8_" + sym_raw
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "string") {
          if sym_raw == "parse_int" {
            let fn_name = "mbt_compat::str_parse_int"
            if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
              let close_p = find_matching_delim(tokens, i + 3)
              let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, fn_name, false, false)
              return (trivia + call_str, close_p + 1)
            }
            return (trivia + fn_name, i + 3)
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "set") {
          if sym_raw == "new" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            if close_p == i + 4 {
              return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
            }
          }
          if sym_raw == "from_array" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
            return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
          }
          if sym_raw == "from_iter" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 3)
            let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
            return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
          }
          if sym_raw == "Set" && i + 5 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 5].kind == TokenKind::LParen {
            let close_p = find_matching_delim(tokens, i + 5)
            let mname = tokens[i + 4].raw
            if mname == "new" && close_p == i + 6 {
              return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
            }
            if mname == "from_array" {
              let inner = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
              return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
            }
            if mname == "from_iter" {
              let inner = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
              return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
            }
          }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "int") {
          if sym_raw == "max_value" { return (trivia + "2147483647", i + 3) }
          if sym_raw == "min_value" { return (trivia + "(-2147483647 - 1)", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "int64") {
          if sym_raw == "max_value" { return (trivia + "9223372036854775807L", i + 3) }
          if sym_raw == "min_value" { return (trivia + "(-9223372036854775807L - 1L)", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "uint") {
          if sym_raw == "max_value" { return (trivia + "4294967295U", i + 3) }
          if sym_raw == "min_value" { return (trivia + "0U", i + 3) }
        } else if is_moonbit_core_pkg(ctx.symtab, raw_pkg, "uint64") {
          if sym_raw == "max_value" { return (trivia + "18446744073709551615UL", i + 3) }
          if sym_raw == "min_value" { return (trivia + "0UL", i + 3) }
        }
      }
      let sym_name = rename_keyword_ident(sym_tok.raw)
      let lookup_key = raw_pkg + "::" + sym_tok.raw
      let target_expr = match ctx.symtab.api_by_key.get(lookup_key) {
        Some(asym) =>
        if asym.target_pkg.length() > 0 {
          asym.target_pkg + "::" + asym.target_name
        } else {
          asym.target_name
        }
        None =>
        if ctx.cur_is_test && ctx.self_pkg_name.length() > 0 && raw_pkg == ctx.self_pkg_name {
          sym_name
        } else {
          mapped_pkg + "::" + sym_name
        }
      }
      // §6: Cross-package enum `@pkg.Enum::Variant(...)` or `@pkg.Variant(...)` labeled args & readonly check
      if sym_tok.kind == TokenKind::UpperIdent {
        if i + 4 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 4].kind == TokenKind::UpperIdent {
          let ename = sym_tok.raw
          let vname = tokens[i + 4].raw
          if i + 5 < end && tokens[i + 5].kind == TokenKind::LParen && !tokens[i + 5].newline_before {
            let close_p = find_matching_delim(tokens, i + 5)
            match check_and_lower_enum_site_d2(ctx, mapped_pkg, ename, vname, tokens, i + 5, close_p, file, t.line, t.col, in_pattern) {
              Some(args_s) => return (trivia + target_expr + "::" + vname + args_s, close_p + 1)
              None => ()
            }
          } else {
            let _ = check_and_lower_enum_site_d2(ctx, mapped_pkg, ename, vname, tokens, -1, -1, file, t.line, t.col, in_pattern)
          }
        } else if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen && !tokens[i + 3].newline_before {
          let close_p = find_matching_delim(tokens, i + 3)
          match check_and_lower_enum_site_d2(ctx, mapped_pkg, "", sym_tok.raw, tokens, i + 3, close_p, file, t.line, t.col, in_pattern) {
            Some(args_s) => {
              let full_ctor = match resolve_enum_schema_d2(ctx, mapped_pkg, "", sym_tok.raw) {
                Some((sch, _)) => mapped_pkg + "::" + sch.name + "::" + sym_tok.raw
                None => target_expr
              }
              return (trivia + full_ctor + args_s, close_p + 1)
            }
            None => ()
          }
        } else if !in_pattern {
          let _ = check_and_lower_enum_site_d2(ctx, mapped_pkg, "", sym_tok.raw, tokens, -1, -1, file, t.line, t.col, in_pattern)
        }
      }
      // Check if this is a cross-package struct literal or pattern `@pkg.Struct::{ ... }`
      if i + 4 < end && tokens[i + 3].kind == TokenKind::ColonColon && tokens[i + 4].kind == TokenKind::LBrace {
        let close_b = find_matching_delim(tokens, i + 4)
        let body = lower_struct_brace(ctx, target_expr, tokens, i + 4, close_b, file, in_pattern)
        return (trivia + target_expr + "::" + body, close_b + 1)
      }
      // Check if this is a call `@pkg.fn(...)`
      if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, i + 3)
        let needs_loc = ctx.symtab.autofill_loc_fns.contains(lookup_key)
        let is_ext = ctx.symtab.external_tilde_fns.contains(lookup_key)
        let call_str = lower_call_args(ctx, tokens, i + 3, close_p, file, t.line, t.col, target_expr, needs_loc, is_ext)
        return (trivia + call_str, close_p + 1)
      }
      return (trivia + target_expr, i + 3)
    }
    return (trivia + mapped_pkg, i + 1)
  }

  // 6. Unqualified `UpperIdent`:
  //    - constructor rest pattern expansion `Ctor(a, ..)` -> `Ctor(a, _, _)` using enum arity
  //    - struct literal cascade `S::{ ... }..init()`
  //    - cross-package enum constructor resolution
  if t.kind == TokenKind::UpperIdent {
    let prev_colon2 = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let prev_dot = i > 0 && tokens[i - 1].kind == TokenKind::Dot
    let next_colon2 = i + 1 < end && tokens[i + 1].kind == TokenKind::ColonColon
    // §D2-4: `const` pattern inlining (both `pub const` and private `const`; fail-closed on non-literal const)
    if in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    !(i + 1 < end && tokens[i + 1].kind == TokenKind::LParen) &&
    !has_local_ctor(ctx.symtab, t.raw) && !ctx.active_generics.contains(t.raw) &&
    !(lookup_scope_var(ctx, t.raw) is Some(_)) {
      match ctx.symtab.const_defs.get(t.raw) {
        Some(cd) =>
        if cd.is_literal {
          return (trivia + cd.literal_pion, i + 1)
        } else {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            t.line,
            t.col,
            "non-literal const `" + t.raw + "` cannot be used as a pattern",
          ))
          return (trivia + t.raw, i + 1)
        }
        None => ()
      }
    }
    // Direct `Ref(expr)` lowering (defaults to `mbt_compat::ref_new`, overridable by `--recipes`)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Ref" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let inner = lower_expr_range(ctx, tokens, i + 2, close_p, file, false).trim()
      return (trivia + effective_ref_ctor(ctx.recipes) + "(" + inner + ")", close_p + 1)
    }
    // Tuple struct construction `TupleStruct(a, b)` -> `TupleStruct::{ _0: a, _1: b }`
    if !in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    ctx.symtab.tuple_structs.contains(t.raw) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let sb = StringBuilder()
      sb.write_string(t.raw + "::{ ")
      let mut ai = i + 2
      let mut fidx = 0
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma {
          ai = ai + 1
          continue
        }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai {
          if fidx > 0 { sb.write_string(", ") }
          let arg_s = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          sb.write_string("_" + fidx.to_string() + ": " + arg_s)
          fidx = fidx + 1
        }
        ai = ae + 1
      }
      sb.write_string(" }")
      return (trivia + sb.to_string(), close_p + 1)
    }
    // Tuple struct pattern `TupleStruct(p0, p1)` -> `TupleStruct::{ _0: p0, _1: p1 }`
    if in_pattern && !prev_colon2 && !prev_dot && !next_colon2 &&
    ctx.symtab.tuple_structs.contains(t.raw) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let sb = StringBuilder()
      sb.write_string(t.raw + "::{ ")
      let mut pi = i + 2
      let mut fidx = 0
      let mut has_rest = false
      while pi < close_p {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        if tokens[pi].kind == TokenKind::DotDot {
          has_rest = true
          pi = pi + 1
          continue
        }
        let mut pe = pi
        let mut pd = 0
        while pe < close_p {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
          else if pd == 0 && pk == TokenKind::Comma { break }
          pe = pe + 1
        }
        if pe > pi {
          if fidx > 0 { sb.write_string(", ") }
          let pat_s = lower_expr_range(ctx, tokens, pi, pe, file, true).trim()
          sb.write_string("_" + fidx.to_string() + ": " + pat_s)
          fidx = fidx + 1
        }
        pi = pe + 1
      }
      if has_rest {
        if fidx > 0 { sb.write_string(", ..") } else { sb.write_string("..") }
      }
      sb.write_string(" }")
      return (trivia + sb.to_string(), close_p + 1)
    }
    // `Hash::hash(expr)` -> `mbt_compat::mbt_hash(expr)` (guarded against local `Hash` type/trait!)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Hash" &&
    !ctx.symtab.local_types.contains("Hash") &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "hash" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::mbt_hash(" + inner + ")", close_p + 1)
    }
    // `Json::*` constructors, helpers, and patterns -> `mbt_compat::MbtJson::*` (guarded against local `Json`!)
    if !prev_colon2 && !prev_dot && t.raw == "Json" &&
    !ctx.symtab.local_types.contains("Json") &&
    i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon {
      let member = tokens[i + 2].raw
      if member == "Number" && i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, i + 3)
        let mut pat_v = ""
        let mut repr_arg = ""
        let mut pi = i + 4
        while pi < close_p {
          if tokens[pi].kind == TokenKind::Comma || tokens[pi].kind == TokenKind::DotDot {
            pi = pi + 1
            continue
          }
          let mut pe = pi
          let mut pd = 0
          while pe < close_p {
            let pk = tokens[pe].kind
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
            else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
            else if pd == 0 && pk == TokenKind::Comma { break }
            pe = pe + 1
          }
          if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
          pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Eq {
            repr_arg = lower_expr_range(ctx, tokens, pi + 2, pe, file, in_pattern).trim()
          } else if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
          pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Tilde {
            repr_arg = "repr"
          } else if pe > pi && pat_v.length() == 0 {
            pat_v = lower_expr_range(ctx, tokens, pi, pe, file, in_pattern).trim()
          }
          pi = pe + 1
        }
        let inner_v = if pat_v.length() > 0 { pat_v } else if in_pattern { "_" } else { "0.0" }
        let inner_r = if repr_arg.length() > 0 { repr_arg } else if in_pattern { "_" } else { "Option::None" }
        return (trivia + "mbt_compat::MbtJson::Number(" + inner_v + ", " + inner_r + ")", close_p + 1)
      }
      if member == "Null" || member == "True" || member == "False" || member == "Number" ||
      member == "String" || member == "Array" || member == "Object" ||
      member == "null" || member == "boolean" || member == "number" ||
      member == "string" || member == "array" || member == "object" {
        return (trivia + "mbt_compat::MbtJson::" + member, i + 3)
      }
    }
    // Unqualified `Number(...)` when expected type is `mbt_compat::MbtJson`
    if !prev_colon2 && !prev_dot && t.raw == "Number" &&
    !has_local_ctor(ctx.symtab, "Number") &&
    current_expected_type(ctx).trim() == "mbt_compat::MbtJson" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let mut pat_v = ""
      let mut repr_arg = ""
      let mut pi = i + 2
      while pi < close_p {
        if tokens[pi].kind == TokenKind::Comma || tokens[pi].kind == TokenKind::DotDot {
          pi = pi + 1
          continue
        }
        let mut pe = pi
        let mut pd = 0
        while pe < close_p {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
          else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
          else if pd == 0 && pk == TokenKind::Comma { break }
          pe = pe + 1
        }
        if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
        pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Eq {
          repr_arg = lower_expr_range(ctx, tokens, pi + 2, pe, file, in_pattern).trim()
        } else if tokens[pi].kind == TokenKind::Ident && tokens[pi].raw == "repr" &&
        pi + 1 < pe && tokens[pi + 1].kind == TokenKind::Tilde {
          repr_arg = "repr"
        } else if pe > pi && pat_v.length() == 0 {
          pat_v = lower_expr_range(ctx, tokens, pi, pe, file, in_pattern).trim()
        }
        pi = pe + 1
      }
      let inner_v = if pat_v.length() > 0 { pat_v } else if in_pattern { "_" } else { "0.0" }
      let inner_r = if repr_arg.length() > 0 { repr_arg } else if in_pattern { "_" } else { "Option::None" }
      return (trivia + "mbt_compat::MbtJson::Number(" + inner_v + ", " + inner_r + ")", close_p + 1)
    }
    // `String::from_array(chars)` -> `mbt_compat::str_from_char_array(chars)`
    // Immediate-copy owned-slice exemption ONLY when `String` is unshadowed and arg is a direct sole slice.
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "String" &&
    !ctx.symtab.local_types.contains("String") && !ctx.symtab.local_value_names.contains("String") &&
    !ctx.active_generics.contains("String") && !(lookup_scope_var(ctx, "String") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "from_array" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let saved_own = ctx.direct_owned_slice_arg
      ctx.direct_owned_slice_arg = is_direct_slice_arg(tokens, i + 4, close_p)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      ctx.direct_owned_slice_arg = saved_own
      return (trivia + "mbt_compat::str_from_char_array(" + inner + ")", close_p + 1)
    }
    // `StringBuilder(capacity=<hint>)` -> `{ let _ = <hint>; StringBuilder() }` (preserves side effects & probes!)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "StringBuilder" &&
    !ctx.symtab.local_types.contains("StringBuilder") && !ctx.symtab.local_value_names.contains("StringBuilder") &&
    !ctx.active_generics.contains("StringBuilder") && !(lookup_scope_var(ctx, "StringBuilder") is Some(_)) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      if i + 4 < close_p && tokens[i + 2].kind == TokenKind::Ident &&
      (tokens[i + 2].raw == "capacity" || tokens[i + 2].raw == "size_hint") &&
      tokens[i + 3].kind == TokenKind::Eq {
        let cap_e = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        let clean_cap = if cap_e.ends_with(",") { cap_e.slice(0, cap_e.length() - 1).trim() } else { cap_e }
        return (trivia + "{ let _ = " + clean_cap + "; StringBuilder() }", close_p + 1)
      }
    }
    // `StringBuilder::new(capacity|size_hint=<hint>)` -> `{ let _ = <hint>; StringBuilder::new() }`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "StringBuilder" &&
    !ctx.symtab.local_types.contains("StringBuilder") && !ctx.symtab.local_value_names.contains("StringBuilder") &&
    !ctx.active_generics.contains("StringBuilder") && !(lookup_scope_var(ctx, "StringBuilder") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "new" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if i + 6 < close_p && tokens[i + 4].kind == TokenKind::Ident &&
      (tokens[i + 4].raw == "capacity" || tokens[i + 4].raw == "size_hint") &&
      tokens[i + 5].kind == TokenKind::Eq {
        let cap_e = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
        let clean_cap = if cap_e.ends_with(",") { cap_e.slice(0, cap_e.length() - 1).trim() } else { cap_e }
        return (trivia + "{ let _ = " + clean_cap + "; StringBuilder::new() }", close_p + 1)
      }
    }
    // `Map([])` -> `mbt_compat::ordered_map_new()`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Map" &&
    i + 4 < end && tokens[i + 1].kind == TokenKind::LParen &&
    tokens[i + 2].kind == TokenKind::LBracket && tokens[i + 3].kind == TokenKind::RBracket &&
    tokens[i + 4].kind == TokenKind::RParen {
      return (trivia + "mbt_compat::ordered_map_new()", i + 5)
    }
    // `Map::new()` -> `mbt_compat::ordered_map_new()`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Map" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "new" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p == i + 4 {
        return (trivia + "mbt_compat::ordered_map_new()", close_p + 1)
      }
    }
    // `FixedArray::makei(...)` -> `mbt_compat::fixed_array_makei(...)`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "FixedArray" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "makei" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::fixed_array_makei(" + inner + ")", close_p + 1)
    }
    // `Array()` / `Array(capacity=<expr>)` -> `[]` / `{ let _ = <expr>; [] }` (only when `Array` is not a local enum ctor!)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Array" &&
    !has_local_ctor(ctx.symtab, "Array") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      if close_p == i + 2 {
        return (trivia + "[]", close_p + 1)
      }
      if i + 4 < close_p && tokens[i + 2].kind == TokenKind::Ident && tokens[i + 2].raw == "capacity" && tokens[i + 3].kind == TokenKind::Eq {
        let cap_e = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        let clean_cap = if cap_e.ends_with(",") { cap_e.slice(0, cap_e.length() - 1).trim() } else { cap_e }
        return (trivia + "{ let _ = " + clean_cap + "; [] }", close_p + 1)
      }
    }
    // `Array::make(n, val)` / `FixedArray::make(n, val)`: propagate element type from expected `Array[T]` / `FixedArray[T]`
    if !in_pattern && !prev_colon2 && !prev_dot && (t.raw == "Array" || t.raw == "FixedArray") &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "make" && tokens[i + 3].kind == TokenKind::LParen {
      let cur_exp = current_expected_type(ctx).trim()
      let elem_exp = if cur_exp.starts_with("Array[") && cur_exp.ends_with("]") {
        cur_exp.slice(6, cur_exp.length() - 1).trim()
      } else if cur_exp.starts_with("FixedArray[") && cur_exp.ends_with("]") {
        cur_exp.slice(11, cur_exp.length() - 1).trim()
      } else {
        ""
      }
      if elem_exp.length() > 0 {
        let close_p = find_matching_delim(tokens, i + 3)
        let mut comma_p = -1
        let mut k = i + 4
        let mut d = 0
        while k < close_p {
          let kk = tokens[k].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && kk == TokenKind::Comma { comma_p = k; break }
          k = k + 1
        }
        if comma_p > i + 4 && comma_p + 1 < close_p {
          let a0 = lower_expr_range(ctx, tokens, i + 4, comma_p, file, false).trim()
          push_expected_type(ctx, elem_exp)
          let a1 = lower_expr_range(ctx, tokens, comma_p + 1, close_p, file, false).trim()
          pop_expected_type(ctx)
          return (trivia + t.raw + "::make(" + a0 + ", " + a1 + ")", close_p + 1)
        }
      }
    }
    // `Array::new()` / `Array::new(capacity=<expr>)` -> `[]` / `{ let _ = <expr>; [] }`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Array" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "new" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      if close_p == i + 4 {
        return (trivia + "[]", close_p + 1)
      }
      if i + 6 < close_p && tokens[i + 4].kind == TokenKind::Ident && tokens[i + 4].raw == "capacity" && tokens[i + 5].kind == TokenKind::Eq {
        let cap_e = lower_expr_range(ctx, tokens, i + 6, close_p, file, false).trim()
        let clean_cap = if cap_e.ends_with(",") { cap_e.slice(0, cap_e.length() - 1).trim() } else { cap_e }
        return (trivia + "{ let _ = " + clean_cap + "; [] }", close_p + 1)
      }
    }
    // `Array::makei(...)` -> `mbt_compat::arr_makei(...)`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Array" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "makei" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::arr_makei(" + inner + ")", close_p + 1)
    }
    // `Bytes::makei(...)` -> `mbt_compat::bytes_makei(...)`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Bytes" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "makei" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::bytes_makei(" + inner + ")", close_p + 1)
    }
    // `Bytes::from_array(...)` -> `mbt_compat::bytes_from_array(...)`
    // §2: Immediate-copy owned-slice exemption ONLY when `Bytes` is unshadowed and arg is a direct sole slice.
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Bytes" &&
    !ctx.symtab.local_types.contains("Bytes") && !ctx.symtab.local_value_names.contains("Bytes") &&
    !ctx.active_generics.contains("Bytes") && !(lookup_scope_var(ctx, "Bytes") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "from_array" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let saved_own = ctx.direct_owned_slice_arg
      ctx.direct_owned_slice_arg = is_direct_slice_arg(tokens, i + 4, close_p)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      ctx.direct_owned_slice_arg = saved_own
      return (trivia + "mbt_compat::bytes_from_array(" + inner + ")", close_p + 1)
    }
    // `Int::unsafe_to_char(...)` -> `mbt_compat::int_unsafe_to_char(...)`
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Int" &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "unsafe_to_char" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + "mbt_compat::int_unsafe_to_char(" + inner + ")", close_p + 1)
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Map" &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      let inner = lower_type_tokens_checked(ctx, tokens, i + 2, close_b, file)
      return (trivia + "mbt_compat::OrderedMap[" + inner + "]", close_b + 1)
    }
    // `Ref::new(x)` -> `mbt_compat::mbt_ref(x)` (or recipe `ref_recipe.ctor_call`) when `Ref` is unshadowed
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Ref" &&
    !ctx.symtab.local_types.contains("Ref") && !ctx.active_generics.contains("Ref") &&
    !(lookup_scope_var(ctx, "Ref") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon &&
    tokens[i + 2].raw == "new" && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
      return (trivia + effective_ref_ctor(ctx.recipes) + "(" + inner + ")", close_p + 1)
    }
    // `Set::new()` / `Set::from_array(...)` / `Set::from_iter(...)` (guarded against local/generic `Set`)
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.symtab.local_value_names.contains("Set") &&
    !ctx.active_generics.contains("Set") && !(lookup_scope_var(ctx, "Set") is Some(_)) &&
    i + 3 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 3].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 3)
      let mname = tokens[i + 2].raw
      if mname == "new" && close_p == i + 4 {
        return (trivia + "mbt_compat::ordered_set_new()", close_p + 1)
      }
      if mname == "from_array" {
        let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
      }
      if mname == "from_iter" {
        let inner = lower_expr_range(ctx, tokens, i + 4, close_p, file, false).trim()
        return (trivia + "mbt_compat::ordered_set_from_iter(" + inner + ")", close_p + 1)
      }
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.symtab.local_value_names.contains("Set") &&
    !ctx.symtab.local_fn_names.contains("Set") && !ctx.active_generics.contains("Set") &&
    !(lookup_scope_var(ctx, "Set") is Some(_)) &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let inner = lower_expr_range(ctx, tokens, i + 2, close_p, file, false).trim()
      return (trivia + "mbt_compat::ordered_set_from_array(" + inner + ")", close_p + 1)
    }
    if !in_pattern && !prev_colon2 && !prev_dot && t.raw == "Set" &&
    !ctx.symtab.local_types.contains("Set") && !ctx.active_generics.contains("Set") &&
    i + 1 < end && tokens[i + 1].kind == TokenKind::LBracket {
      let close_b = find_matching_delim(tokens, i + 1)
      let inner = lower_type_tokens_checked(ctx, tokens, i + 2, close_b, file)
      return (trivia + "mbt_compat::OrderedSet[" + inner + "]", close_b + 1)
    }
    // Qualified `Enum::Variant(...)` or `Enum::Variant` labeled enum ctor/pattern & readonly visibility check
    if !prev_colon2 && !prev_dot && i + 2 < end &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::UpperIdent {
      let ename = if !ctx.symtab.local_types.contains(t.raw) {
        match ctx.symtab.using_types.get(t.raw) {
          Some(ut) => ut
          None => t.raw
        }
      } else {
        t.raw
      }
      let vname = tokens[i + 2].raw
      if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen && !tokens[i + 3].newline_before {
        let close_p = find_matching_delim(tokens, i + 3)
        match check_and_lower_enum_site_d2(ctx, "", ename, vname, tokens, i + 3, close_p, file, t.line, t.col, in_pattern) {
          Some(args_s) => return (trivia + ename + "::" + vname + args_s, close_p + 1)
          None => ()
        }
      } else {
        let _ = check_and_lower_enum_site_d2(ctx, "", ename, vname, tokens, -1, -1, file, t.line, t.col, in_pattern)
      }
    }
    let head_name = if !prev_colon2 && !prev_dot && !next_colon2 {
      match resolve_ctor_at_site(ctx.symtab, t.raw, current_expected_type(ctx), in_pattern, ctx.active_generics, file, t.line, t.col, ctx.diags) {
        Some(resolved) => resolved
        None =>
        if !in_pattern && !has_local_ctor(ctx.symtab, t.raw) && !ctx.symtab.local_value_names.contains(t.raw) && !ctx.active_generics.contains(t.raw) {
          match ctx.symtab.using_values.get(t.raw) {
            Some(uv) => uv
            None => t.raw
          }
        } else {
          t.raw
        }
      }
    } else if !prev_colon2 && !prev_dot && next_colon2 && !ctx.symtab.local_types.contains(t.raw) && !ctx.active_generics.contains(t.raw) {
      match ctx.symtab.using_types.get(t.raw) {
        Some(ut) => ut
        None => t.raw
      }
    } else {
      t.raw
    }
    // Bare `Variant(...)` or `Variant` labeled enum ctor/pattern & readonly visibility check
    if !prev_colon2 && !prev_dot && !next_colon2 {
      if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before {
        let close_p = find_matching_delim(tokens, i + 1)
        match check_and_lower_enum_site_d2(ctx, "", "", t.raw, tokens, i + 1, close_p, file, t.line, t.col, in_pattern) {
          Some(args_s) => return (trivia + head_name + args_s, close_p + 1)
          None => ()
        }
      } else {
        let _ = check_and_lower_enum_site_d2(ctx, "", "", t.raw, tokens, -1, -1, file, t.line, t.col, in_pattern)
      }
    }

    // In pattern context: check `Ctor(..., ..)` / `Ctor(..)` / `Ctor(.., ..)` rest pattern expansion!
    if in_pattern && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, i + 1)
      let raw_pats : Array[(Int, Int)] = []
      let mut has_rest = false
      let mut rest_pos = -1
      let mut pi = i + 2
      while pi < close_p {
        if tokens[pi].kind == TokenKind::Comma {
          pi = pi + 1
          continue
        }
        let mut pe = pi
        let mut pd = 0
        while pe < close_p {
          let pk = tokens[pe].kind
          if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
            pd = pd + 1
          } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
            pd = pd - 1
          } else if pd == 0 && pk == TokenKind::Comma {
            break
          }
          pe = pe + 1
        }
        if pe == pi + 1 && tokens[pi].kind == TokenKind::DotDot {
          has_rest = true
          if rest_pos < 0 {
            rest_pos = raw_pats.length()
          }
        } else {
          raw_pats.push((pi, pe))
        }
        pi = pe + 1
      }
      if has_rest {
        let arity = lookup_ctor_arity(ctx.symtab, t.raw)
        if arity < 0 || arity < raw_pats.length() {
          ctx.diags.push(diag_error(
            "MBT2PION_MANUAL",
            file,
            t.line,
            t.col,
            "cannot expand constructor rest pattern `" + t.raw + "(.., ..)` because variant arity is unknown",
          ))
          let fb = StringBuilder()
          fb.write_string(trivia + head_name + "(")
          let mut fi = 0
          while fi < raw_pats.length() {
            if fi > 0 { fb.write_string(", ") }
            let (s, e) = raw_pats[fi]
            fb.write_string(lower_expr_range(ctx, tokens, s, e, file, true).trim())
            fi = fi + 1
          }
          if raw_pats.length() > 0 { fb.write_string(", ") }
          fb.write_string("_)")
          return (fb.to_string(), close_p + 1)
        }
        let psb = StringBuilder()
        psb.write_string(trivia + head_name + "(")
        let missing = arity - raw_pats.length()
        let insert_at = if rest_pos >= 0 { rest_pos } else { raw_pats.length() }
        let mut emitted = 0
        let mut idx = 0
        while idx < raw_pats.length() {
          if idx == insert_at {
            let mut m = 0
            while m < missing {
              if emitted > 0 {
                psb.write_string(", ")
              }
              psb.write_string("_")
              emitted = emitted + 1
              m = m + 1
            }
          }
          if emitted > 0 {
            psb.write_string(", ")
          }
          let (s, e) = raw_pats[idx]
          psb.write_string(lower_expr_range(ctx, tokens, s, e, file, true).trim())
          emitted = emitted + 1
          idx = idx + 1
        }
        if insert_at == raw_pats.length() {
          let mut m = 0
          while m < missing {
            if emitted > 0 {
              psb.write_string(", ")
            }
            psb.write_string("_")
            emitted = emitted + 1
            m = m + 1
          }
        }
        psb.write_string(")")
        return (psb.to_string(), close_p + 1)
      }
    }

    // Struct literal or struct destructuring pattern `S::{ ... }` (with collision-free field renaming & cascade)
    if i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::LBrace {
      let close_b = find_matching_delim(tokens, i + 2)
      let struct_lit = head_name + "::" + lower_struct_brace(ctx, t.raw, tokens, i + 2, close_b, file, in_pattern)
      if !in_pattern && close_b + 1 < end && tokens[close_b + 1].kind == TokenKind::DotDot &&
      close_b + 2 < end && tokens[close_b + 2].kind == TokenKind::Ident {
        return lower_cascade_chain(ctx, trivia, struct_lit, tokens, close_b + 1, end, file)
      }
      return (trivia + struct_lit, close_b + 1)
    }

    return (trivia + head_name, i + 1)
  }

  // 7. Identifier: check for `letrec`, test assertions, cascade `recv..m1()..m2()`, slicing `xs[a:b]` & `a.b[lo:hi]`, call with `loc`/external `x?`, or keyword rename
  if t.kind == TokenKind::Ident {
    let prev_dot = i > 0 && tokens[i - 1].kind == TokenKind::Dot
    if !in_pattern && !prev_dot && t.raw == "letrec" {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        t.line,
        t.col,
        "unsupported MoonBit `letrec` syntax (requires explicit lowering or overlay)",
      ))
      return (trivia + t.raw, i + 1)
    }
    // §1: Never emit bare `.val` (keyword in Pion -> parse cascade); emit a registered collision-free
    // placeholder for field access, or `val_` for method calls `.val(...)`!
    let prev_cc_id = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let is_val_method_call = prev_dot && t.raw == "val" && i + 1 < end &&
    tokens[i + 1].kind == TokenKind::LParen && !tokens[i + 1].newline_before
    let base_name = if prev_dot && t.raw == "val" && !is_val_method_call {
      if should_defer_val_assign_to_a5(ctx, tokens, i - 1, i + 1, end) {
        alloc_fresh_val_placeholder(ctx, t.line, t.col)
      } else {
        match try_resolve_static_val_field(ctx, tokens, i - 1) {
          Some(resolved_f) => resolved_f
          None => alloc_fresh_val_placeholder(ctx, t.line, t.col)
        }
      }
    } else if !prev_dot && !prev_cc_id && (!in_pattern || !(i + 1 < end && tokens[i + 1].kind == TokenKind::Colon)) {
      resolve_ident_in_scope(ctx, t.raw)
    } else {
      rename_keyword_ident(t.raw)
    }
    let name_bb = if ctx.cur_is_blackbox && !in_pattern && !prev_dot && !prev_cc_id &&
    !(lookup_scope_var(ctx, base_name) is Some(_)) && !ctx.lifted_local_fns.contains(base_name) {
      match ctx.symtab.blackbox_colliding_privs.get(t.raw) {
        Some(renamed) => renamed
        None => base_name
      }
    } else {
      base_name
    }
    let name = if !in_pattern && !prev_dot && !prev_cc_id &&
    !(lookup_scope_var(ctx, name_bb) is Some(_)) && !ctx.lifted_local_fns.contains(name_bb) &&
    !ctx.symtab.local_value_names.contains(t.raw) && !ctx.symtab.local_fn_names.contains(t.raw) {
      match ctx.symtab.using_values.get(t.raw) {
        Some(uv) => uv
        None => name_bb
      }
    } else {
      name_bb
    }
    let mut next_i = i + 1

    // Check direct call to a lifted recursive local `fn` -> call lifted top-level symbol with env_args!
    if !in_pattern && !prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      match ctx.lifted_local_fns.get(name) {
        Some(lf) => {
          let close_p = find_matching_delim(tokens, next_i)
          let inner_call = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, "", false, false)
          // `inner_call` is `(a, b)` -> prepend `env_args`
          let inner_args = if inner_call.length() >= 2 { inner_call.slice(1, inner_call.length() - 1).trim() } else { "" }
          let full_args = if lf.env_args.length() > 0 && inner_args.length() > 0 {
            join_comma(lf.env_args) + ", " + inner_args
          } else if lf.env_args.length() > 0 {
            join_comma(lf.env_args)
          } else {
            inner_args
          }
          return (trivia + lf.lifted_name + "(" + full_args + ")", close_p + 1)
        }
        None => ()
      }
    }

    // Check MoonBit builtin test assertions (`assert_eq`, `assert_not_eq`, `assert_true`, `assert_false`, `fail`, `inspect`).
    // P0-2: Black-box `*_test.mbt` files ONLY check their own file's decls + local scope (never pollute or read
    //       production/white-box `symtab`, and production/white-box NEVER read black-box `*_test.mbt` decls!).
    // P0-3: Bind ALL arguments (positional + `msg=`/`content=`/`loc=` named args) in exact left-to-right source
    //       order so side effects (e.g. `msg={ n = n + 1; "..." }` or `msg=abort(...)`) always execute!
    let prev_cc = i > 0 && tokens[i - 1].kind == TokenKind::ColonColon
    let is_cur_blackbox = file.ends_with("_test.mbt") && !file.ends_with("_wbtest.mbt")
    let is_shadowed_assert = if is_cur_blackbox {
      ctx.symtab.blackbox_decls.contains(t.raw) ||
      ctx.symtab.prod_pub_decls.contains(t.raw) ||
      ctx.lifted_local_fns.contains(name) ||
      (lookup_scope_var(ctx, name) is Some(_))
    } else {
      ctx.symtab.local_value_names.contains(t.raw) ||
      ctx.symtab.local_fn_names.contains(t.raw) ||
      ctx.symtab.fn_param_types.contains(t.raw) ||
      ctx.symtab.fn_ret_types.contains(t.raw) ||
      ctx.symtab.autofill_loc_fns.contains(t.raw) ||
      ctx.symtab.external_tilde_fns.contains(t.raw) ||
      ctx.lifted_local_fns.contains(name) ||
      (lookup_scope_var(ctx, name) is Some(_))
    }
    if !in_pattern && !prev_dot && !prev_cc && !is_shadowed_assert && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before &&
    (t.raw == "assert_eq" || t.raw == "assert_not_eq" || t.raw == "assert_true" || t.raw == "assert_false" || t.raw == "fail" || t.raw == "inspect" || t.raw == "debug_inspect") {
      let close_p = find_matching_delim(tokens, next_i)
      // Opus P2-1: Evaluate assertion arguments in MoonBit parameter declaration order
      // (positional args first, then `msg=`/`content=`, then `loc=`), matching Moon native & wasm-gc!
      let pos_binds : Array[String] = []
      let msg_binds : Array[String] = []
      let content_binds : Array[String] = []
      let loc_binds : Array[String] = []
      let other_binds : Array[String] = []
      let pos_temps : Array[String] = []
      let mut msg_temp = ""
      let mut content_temp = ""
      let mut has_unsupported_arg = false
      let mut ai = next_i + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = tokens[ai].raw
          let rhs = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          let tmp = fresh_temp(ctx, "aa")
          let ty_ann = if lbl == "msg" || lbl == "content" || lbl == "loc" { " : String" } else { "" }
          let stmt = "let " + tmp + ty_ann + " = " + rhs + "; "
          if lbl == "msg" {
            msg_temp = tmp
            msg_binds.push(stmt)
          } else if lbl == "content" {
            content_temp = tmp
            content_binds.push(stmt)
          } else if lbl == "loc" {
            loc_binds.push(stmt)
          } else {
            has_unsupported_arg = true
            other_binds.push(stmt)
          }
        } else if ae == ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Tilde {
          let lbl = tokens[ai].raw
          let tmp = fresh_temp(ctx, "aa")
          let ty_ann = if lbl == "msg" || lbl == "content" || lbl == "loc" { " : String" } else { "" }
          let stmt = "let " + tmp + ty_ann + " = " + rename_keyword_ident(lbl) + "; "
          if lbl == "msg" {
            msg_temp = tmp
            msg_binds.push(stmt)
          } else if lbl == "content" {
            content_temp = tmp
            content_binds.push(stmt)
          } else if lbl == "loc" {
            loc_binds.push(stmt)
          } else {
            has_unsupported_arg = true
            other_binds.push(stmt)
          }
        } else if ae > ai {
          let rhs = lower_expr_range(ctx, tokens, ai, ae, file, false).trim()
          if (t.raw == "assert_eq" || t.raw == "assert_not_eq") && (rhs == "None" || rhs == "[]") {
            // Pure polymorphic literals stay inline so Pion bidirectional inference sees the other operand's type!
            pos_temps.push(rhs)
          } else {
            let tmp = fresh_temp(ctx, "aa")
            pos_binds.push("let " + tmp + " = " + rhs + "; ")
            pos_temps.push(tmp)
          }
        }
        ai = ae + 1
      }
      if has_unsupported_arg {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          t.line,
          t.col,
          "unsupported named argument in assertion `" + t.raw + "`",
        ))
      }
      let pre = join_str_array(pos_binds) + join_str_array(msg_binds) + join_str_array(content_binds) + join_str_array(loc_binds) + join_str_array(other_binds)
      let loc_str = "\"" + file + ":" + t.line.to_string() + "\""
      let msg_suffix = if msg_temp.length() > 0 { " + \": \" + " + msg_temp } else { "" }
      if t.raw == "assert_eq" && pos_temps.length() >= 2 {
        return (trivia + "{ " + pre + "if !(" + pos_temps[0] + " == " + pos_temps[1] + ") { panic(\"assert_eq failed at " + file + ":" + t.line.to_string() + "\"" + msg_suffix + ") } }", close_p + 1)
      }
      if t.raw == "assert_not_eq" && pos_temps.length() >= 2 {
        return (trivia + "{ " + pre + "if " + pos_temps[0] + " == " + pos_temps[1] + " { panic(\"assert_not_eq failed at " + file + ":" + t.line.to_string() + "\"" + msg_suffix + ") } }", close_p + 1)
      }
      if t.raw == "assert_true" && pos_temps.length() >= 1 {
        if msg_temp.length() > 0 {
          return (trivia + "{ " + pre + "if !(" + pos_temps[0] + ") { panic(\"assertion failed at " + file + ":" + t.line.to_string() + ": \" + " + msg_temp + ") } }", close_p + 1)
        }
        return (trivia + "{ " + pre + "mbt_compat::assert_true(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "assert_false" && pos_temps.length() >= 1 {
        if msg_temp.length() > 0 {
          return (trivia + "{ " + pre + "if " + pos_temps[0] + " { panic(\"assertion failed at " + file + ":" + t.line.to_string() + ": \" + " + msg_temp + ") } }", close_p + 1)
        }
        return (trivia + "{ " + pre + "mbt_compat::assert_false(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "fail" && pos_temps.length() >= 1 {
        // §7 Effect-Safe `fail(...)` -> `panic(...)`: ONLY when unshadowed, NOT inside any
        // closure/lambda, NOT inside `try ... catch`, and inside top-level `test` or non-`raise` fn!
        if ctx.in_closure_depth > 0 || ctx.in_try_catch_depth > 0 || (ctx.cur_fn_is_raising && !ctx.cur_in_test_block) {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            t.line,
            t.col,
            "`fail(...)` inside a closure, `raise` function, or `try ... catch` cannot be safely lowered to `panic` (fail-closed)",
          ))
        }
        return (trivia + "{ " + pre + "mbt_compat::fail(" + pos_temps[0] + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "inspect" && pos_temps.length() >= 1 && content_temp.length() > 0 {
        return (trivia + "{ " + pre + "mbt_compat::inspect_eq((" + pos_temps[0] + ").to_string(), " + content_temp + ", " + loc_str + ") }", close_p + 1)
      }
      if t.raw == "debug_inspect" && pos_temps.length() >= 1 && content_temp.length() > 0 {
        return (trivia + "{ " + pre + "mbt_compat::inspect_eq(mbt_compat::__mbt_debug_fmt(" + pos_temps[0] + "), " + content_temp + ", " + loc_str + ") }", close_p + 1)
      }
    }
    // Bare `println(x)` (no `World` receiver, unshadowed) -> `mbt_compat::mbt_println((x).to_string())`
    if !in_pattern && !prev_dot && !prev_cc && !is_shadowed_assert && t.raw == "println" &&
    next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let inner = lower_expr_range(ctx, tokens, next_i + 1, close_p, file, false).trim()
      if inner.length() == 0 {
        return (trivia + "mbt_compat::mbt_println(\"\")", close_p + 1)
      }
      return (trivia + "mbt_compat::mbt_println((" + inner + ").to_string())", close_p + 1)
    }

    // Check boxed mutable outer variable captured by lifted recursive local `fn` -> `name.v`
    if !in_pattern && !prev_dot && !(i > 0 && tokens[i - 1].kind == TokenKind::ColonColon) {
      match lookup_scope_var(ctx, name) {
        Some(sv) =>
        if sv.is_boxed {
          // Reject storing an escaping recursive local fn as a VALUE into a captured mutable cell (cycle risk!)
          if next_i < end && tokens[next_i].kind == TokenKind::Eq {
            let rhs_end = find_expr_end(tokens, next_i + 1, end)
            for lfk in ctx.lifted_local_fns.keys() {
              if is_local_fn_used_as_value(tokens, next_i + 1, rhs_end, lfk) {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  file,
                  t.line,
                  t.col,
                  "storing recursive local fn `" + lfk + "` into captured mutable cell `" + name + "` may form an RC cycle",
                ))
              }
            }
          }
          return (trivia + name + ".v", next_i)
        }
        None => ()
      }
    }

    // `.replace_all(old=a, new=b)` -> `.replace(a, b)`
    if !in_pattern && prev_dot && t.raw == "replace_all" && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let mut old_e = ""
      let mut new_e = ""
      let pos_args : Array[String] = []
      let mut ai = next_i + 1
      while ai < close_p {
        if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
        let mut ae = ai
        let mut ad = 0
        while ae < close_p {
          let ak = tokens[ae].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          ae = ae + 1
        }
        if ae > ai + 2 && tokens[ai].kind == TokenKind::Ident && tokens[ai + 1].kind == TokenKind::Eq {
          let lbl = tokens[ai].raw
          let rhs = lower_expr_range(ctx, tokens, ai + 2, ae, file, false).trim()
          if lbl == "old" { old_e = rhs } else if lbl == "new" { new_e = rhs }
        } else if ae > ai {
          pos_args.push(lower_expr_range(ctx, tokens, ai, ae, file, false).trim())
        }
        ai = ae + 1
      }
      if old_e.length() == 0 && pos_args.length() >= 1 { old_e = pos_args[0] }
      if new_e.length() == 0 && pos_args.length() >= 2 { new_e = pos_args[1] }
      if old_e.length() > 0 && new_e.length() > 0 {
        return (trivia + "replace(" + old_e + ", " + new_e + ")", close_p + 1)
      }
    }

    // §5: Fail-closed gate on raising callbacks passed to `.retain(cb)` / `.filter_map(cb)`
    // (Astra P0-1 / P1-2: receiver-mutation gate runs in Stage B only once `pionc` confirms `Array[...]`!)
    if !in_pattern && prev_dot && (t.raw == "retain" || t.raw == "filter_map") &&
    next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      check_non_raising_callback(ctx, tokens, next_i + 1, close_p, t.raw, file, t.line, t.col)
    }

    // Check method call `recv.method(...)` with expected-type guidance from `Type::method` or unique method signature
    if !in_pattern && prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let mut method_key = ""
      if i >= 2 && tokens[i - 2].kind == TokenKind::Ident {
        match lookup_scope_var(ctx, rename_keyword_ident(tokens[i - 2].raw)) {
          Some(sv) => {
            let rbase = strip_type_args_sym(sv.ty)
            if rbase.length() > 0 && ctx.symtab.fn_param_types.contains(rbase + "::" + t.raw) {
              method_key = "__dot__::" + rbase + "::" + t.raw
            }
          }
          None => ()
        }
      }
      if method_key.length() == 0 && ctx.symtab.method_unique_param_types.contains(t.raw) {
        method_key = "__method__::" + t.raw
      }
      if method_key.length() > 0 {
        let close_p = find_matching_delim(tokens, next_i)
        let call_str = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, method_key, false, false)
        // Replace `method_key` prefix back with `name`
        let args_only = if call_str.starts_with(method_key) {
          call_str.slice(method_key.length(), call_str.length())
        } else {
          call_str
        }
        return (trivia + name + args_only, close_p + 1)
      }
    }

    // Check function call `foo(...)` or `Type::method(...)` — NEVER merge a newline-separated trailing tuple `(a, b)` into a call!
    if !in_pattern && !prev_dot && next_i < end && tokens[next_i].kind == TokenKind::LParen && !tokens[next_i].newline_before {
      let close_p = find_matching_delim(tokens, next_i)
      let qual_lookup = if prev_cc && i >= 2 && tokens[i - 2].kind == TokenKind::UpperIdent {
        tokens[i - 2].raw + "::" + t.raw
      } else {
        name
      }
      let needs_loc = if ctx.cur_is_blackbox {
        if ctx.symtab.blackbox_decls.contains(t.raw) {
          ctx.symtab.blackbox_autofill_loc_fns.contains(t.raw)
        } else {
          ctx.symtab.autofill_loc_fns.contains(qual_lookup) || ctx.symtab.autofill_loc_fns.contains(t.raw)
        }
      } else {
        ctx.symtab.autofill_loc_fns.contains(qual_lookup) || ctx.symtab.autofill_loc_fns.contains(t.raw)
      }
      let is_ext = ctx.symtab.external_tilde_fns.contains(qual_lookup) || ctx.symtab.external_tilde_fns.contains(t.raw)
      let call_raw = lower_call_args(ctx, tokens, next_i, close_p, file, t.line, t.col, qual_lookup, needs_loc, is_ext)
      let call_str = if qual_lookup != name && call_raw.starts_with(qual_lookup) {
        name + call_raw.slice(qual_lookup.length(), call_raw.length())
      } else {
        call_raw
      }
      // Check if followed by cascade `..m()`!
      if close_p + 1 < end && tokens[close_p + 1].kind == TokenKind::DotDot &&
      close_p + 2 < end && tokens[close_p + 2].kind == TokenKind::Ident {
        return lower_cascade_chain(ctx, trivia, call_str, tokens, close_p + 1, end, file)
      }
      return (trivia + call_str, close_p + 1)
    }

    // Check slice `xs[a:b]`
    if !in_pattern && next_i < end && tokens[next_i].kind == TokenKind::LBracket {
      let close_br = find_matching_delim(tokens, next_i)
      // Look for top-level `:` inside `[...]`
      let mut colon_i = -1
      let mut k = next_i + 1
      let mut d = 0
      while k < close_br {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
          d = d + 1
        } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
          d = d - 1
        } else if d == 0 && kk == TokenKind::Colon {
          colon_i = k
          break
        }
        k = k + 1
      }
      if colon_i >= 0 {
        let own_exempt = ctx.direct_owned_slice_arg
        ctx.direct_owned_slice_arg = false
        let lo = if colon_i > next_i + 1 {
          lower_expr_range(ctx, tokens, next_i + 1, colon_i, file, false).trim()
        } else {
          "0"
        }
        let hi = if close_br > colon_i + 1 {
          lower_expr_range(ctx, tokens, colon_i + 1, close_br, file, false).trim()
        } else {
          name + ".length()"
        }
        let (sl_helper, next_after, extra_arg) = classify_slice_consumer(ctx, tokens, close_br, end, own_exempt, false, ctx.in_interp_top, file)
        if sl_helper == "mbt_compat::__mbt_slice_borrow" && (ctx.borrowed_bufs.contains(name) || ctx.borrowed_views.contains(name)) {
          ctx.drift_ledger.push(DriftEntry::{
            category: "array_view_slice",
            file: file,
            line: t.line,
            col: t.col,
            expr: name + "[" + lo + ":" + hi + "]",
            resolution: "mbt_compat::ArrayView::view",
            status: "resolved",
            detail: "borrowed slice lowered to backing-stable ArrayBuf/ArrayView::view",
          })
          return (trivia + name + ".view(" + lo + ", " + hi + ")", close_br + 1)
        }
        let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
        return (trivia + sl_helper + "(" + name + ", " + lo + ", " + hi + extra_tail + ")", next_after)
      }
      // Indexing `a[i]` or `a[i] = rhs` on a promoted `ArrayBuf` / `ArrayView`
      if ctx.borrowed_bufs.contains(name) || ctx.borrowed_views.contains(name) {
        let idx_s = lower_expr_range(ctx, tokens, next_i + 1, close_br, file, false).trim()
        if close_br + 1 < end && tokens[close_br + 1].kind == TokenKind::Eq {
          let rhs_end = find_expr_end(tokens, close_br + 2, end)
          let rhs_s = lower_expr_range(ctx, tokens, close_br + 2, rhs_end, file, false).trim()
          return (trivia + name + ".set(" + idx_s + ", " + rhs_s + ")", rhs_end)
        }
        return (trivia + name + ".get(" + idx_s + ")", close_br + 1)
      }
    }

    // Check field-guided expected type for `x.field = rhs`, `x.field == rhs`, `x.field != rhs`,
    // and `x.field.unsafe_set(i, v)` / `x.field.set(i, v)` / `x.field.push(v)`!
    if !in_pattern && !prev_dot && !prev_cc &&
    next_i + 2 < end && tokens[next_i].kind == TokenKind::Dot && tokens[next_i + 1].kind == TokenKind::Ident {
      let field_raw = tokens[next_i + 1].raw
      let mut field_ty = ""
      match lookup_scope_var(ctx, name) {
        Some(sv) => {
          let sbase = strip_type_args_sym(sv.ty)
          match ctx.symtab.struct_field_types.get(sbase) {
            Some(fm) =>
            match fm.get(field_raw) {
              Some(ft) => field_ty = ft
              None => ()
            }
            None => ()
          }
        }
        None => ()
      }
      if field_ty.length() > 0 {
        let after_f = next_i + 2
        if after_f < end && (tokens[after_f].kind == TokenKind::Eq || tokens[after_f].kind == TokenKind::EqEq || tokens[after_f].kind == TokenKind::BangEq) {
          let op_tok = tokens[after_f]
          let rhs_start = after_f + 1
          let rhs_end = if op_tok.kind == TokenKind::Eq {
            find_expr_end(tokens, rhs_start, end)
          } else {
            // For `==` / `!=`, stop at logical operators / block `{` / `,` / `)` / `;` / newline
            let mut re = rhs_start
            let mut rd = 0
            while re < end {
              let rk = tokens[re].kind
              if rd == 0 && re > rhs_start && tokens[re].newline_before { break }
              if rd == 0 && (rk == TokenKind::AmpAmp || rk == TokenKind::PipePipe || rk == TokenKind::Comma || rk == TokenKind::Semi || rk == TokenKind::LBrace) { break }
              if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
              else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                if rd == 0 { break }
                rd = rd - 1
              }
              re = re + 1
            }
            re
          }
          if rhs_end > rhs_start {
            let f_out = if field_raw == "val" {
              if should_defer_val_assign_to_a5(ctx, tokens, next_i, after_f, end) {
                alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
              } else {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              }
            } else {
              rename_keyword_ident(field_raw)
            }
            push_expected_type(ctx, field_ty)
            let rhs_s = lower_expr_range(ctx, tokens, rhs_start, rhs_end, file, false)
            pop_expected_type(ctx)
            return (trivia + name + "." + f_out + op_tok.leading_trivia + op_tok.raw + rhs_s, rhs_end)
          }
        }
        // `x.arr_field.unsafe_set(i, v)` / `.set(i, v)` / `.push(v)` when `field_ty` is `Array[T]` / `FixedArray[T]`
        if after_f + 2 < end && tokens[after_f].kind == TokenKind::Dot &&
        tokens[after_f + 1].kind == TokenKind::Ident && tokens[after_f + 2].kind == TokenKind::LParen &&
        (tokens[after_f + 1].raw == "unsafe_set" || tokens[after_f + 1].raw == "set" || tokens[after_f + 1].raw == "push") {
          let elem_ty = if field_ty.starts_with("Array[") && field_ty.ends_with("]") {
            field_ty.slice(6, field_ty.length() - 1).trim()
          } else if field_ty.starts_with("FixedArray[") && field_ty.ends_with("]") {
            field_ty.slice(11, field_ty.length() - 1).trim()
          } else {
            ""
          }
          if elem_ty.length() > 0 {
            let mname = tokens[after_f + 1].raw
            let close_p = find_matching_delim(tokens, after_f + 2)
            if mname == "push" {
              let f_out = if field_raw == "val" {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              } else {
                rename_keyword_ident(field_raw)
              }
              push_expected_type(ctx, elem_ty)
              let a0 = lower_expr_range(ctx, tokens, after_f + 3, close_p, file, false).trim()
              pop_expected_type(ctx)
              return (trivia + name + "." + f_out + ".push(" + a0 + ")", close_p + 1)
            }
            let mut comma_p = -1
            let mut k = after_f + 3
            let mut d = 0
            while k < close_p {
              let kk = tokens[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::Comma { comma_p = k; break }
              k = k + 1
            }
            if comma_p > after_f + 3 && comma_p + 1 < close_p {
              let f_out = if field_raw == "val" {
                match try_resolve_static_val_field(ctx, tokens, next_i) {
                  Some(rf) => rf
                  None => alloc_fresh_val_placeholder(ctx, tokens[next_i + 1].line, tokens[next_i + 1].col)
                }
              } else {
                rename_keyword_ident(field_raw)
              }
              let a0 = lower_expr_range(ctx, tokens, after_f + 3, comma_p, file, false).trim()
              push_expected_type(ctx, elem_ty)
              let a1 = lower_expr_range(ctx, tokens, comma_p + 1, close_p, file, false).trim()
              pop_expected_type(ctx)
              return (trivia + name + "." + f_out + "." + mname + "(" + a0 + ", " + a1 + ")", close_p + 1)
            }
          }
        }
      }
    }

    // Check chained field access followed by slice `a.b[lo:hi]` or cascade `a.b.c..m1(...)..m2(...)`
    if !in_pattern && !prev_dot {
      let mut chain_end = next_i
      let chain_segs : Array[(String, Int, Int)] = []
      while chain_end + 1 < end && tokens[chain_end].kind == TokenKind::Dot && tokens[chain_end + 1].kind == TokenKind::Ident {
        chain_segs.push((tokens[chain_end + 1].raw, tokens[chain_end + 1].line, tokens[chain_end + 1].col))
        chain_end = chain_end + 2
      }
      if chain_end > next_i && chain_end < end && tokens[chain_end].kind == TokenKind::LBracket && !tokens[chain_end].newline_before {
        let close_br = find_matching_delim(tokens, chain_end)
        let mut colon_i = -1
        let mut k = chain_end + 1
        let mut d = 0
        while k < close_br {
          let kk = tokens[k].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
          else if d == 0 && kk == TokenKind::Colon { colon_i = k; break }
          k = k + 1
        }
        if colon_i >= 0 {
          let chain_sb = StringBuilder()
          chain_sb.write_string(name)
          for seg in chain_segs {
            let fname = if seg.0 == "val" {
              alloc_fresh_val_placeholder(ctx, seg.1, seg.2)
            } else {
              rename_keyword_ident(seg.0)
            }
            chain_sb.write_string("." + fname)
          }
          let chain_str = chain_sb.to_string()
          let lo = if colon_i > chain_end + 1 {
            lower_expr_range(ctx, tokens, chain_end + 1, colon_i, file, false).trim()
          } else {
            "0"
          }
          let hi = if close_br > colon_i + 1 {
            lower_expr_range(ctx, tokens, colon_i + 1, close_br, file, false).trim()
          } else {
            chain_str + ".length()"
          }
          let (sl_helper, next_after, extra_arg) = classify_slice_consumer(ctx, tokens, close_br, end, false, false, ctx.in_interp_top, file)
          let extra_tail = if extra_arg.length() > 0 { ", " + extra_arg } else { "" }
          return (trivia + sl_helper + "(" + chain_str + ", " + lo + ", " + hi + extra_tail + ")", next_after)
        }
      }
      if chain_end < end && tokens[chain_end].kind == TokenKind::DotDot &&
      chain_end + 1 < end && tokens[chain_end + 1].kind == TokenKind::Ident {
        let chain_sb = StringBuilder()
        chain_sb.write_string(name)
        for seg in chain_segs {
          let fname = if seg.0 == "val" {
            alloc_fresh_val_placeholder(ctx, seg.1, seg.2)
          } else {
            rename_keyword_ident(seg.0)
          }
          chain_sb.write_string("." + fname)
        }
        return lower_cascade_chain(ctx, trivia, chain_sb.to_string(), tokens, chain_end, end, file)
      }
    }

    // Tuple struct numeric field access `<ident>.0` -> `<ident>._0` when `<ident>` is a known tuple struct!
    if !in_pattern && !prev_dot && next_i + 1 < end && tokens[next_i].kind == TokenKind::Dot && tokens[next_i + 1].kind == TokenKind::IntLit {
      match lookup_scope_var(ctx, name) {
        Some(sv) =>
        if ctx.symtab.tuple_structs.contains(strip_type_args_sym(sv.ty)) {
          return (trivia + name + "._" + tokens[next_i + 1].raw, next_i + 2)
        }
        None => ()
      }
    }

    if in_pattern && next_i < end && tokens[next_i].kind == TokenKind::Tilde {
      next_i = next_i + 1
    }

    return (trivia + name, next_i)
  }

  // 8. Unhandled pattern rest `..` outside a recognized constructor pattern -> hard fail
  if in_pattern && t.kind == TokenKind::DotDot {
    ctx.diags.push(diag_error(
      "MBT2PION_MANUAL",
      file,
      t.line,
      t.col,
      "unsupported rest pattern `..` outside known enum constructor",
    ))
    return (trivia + "_", i + 1)
  }

  // 9. Keyword `in` used as identifier (outside `for ... in ...`)
  if t.kind == TokenKind::Keyword && t.raw == "in" {
    return (trivia + "in", i + 1)
  }

  // 10. Nested tuple index `.1.0` lexed as `.` + `FloatLit("1.0")` -> `.1 .0` (prevents Pion float-lexing E_PARSE!)
  if !in_pattern && t.kind == TokenKind::Dot && i + 1 < end && tokens[i + 1].kind == TokenKind::FloatLit {
    let fraw = tokens[i + 1].raw
    let dot_pos = fraw.index_of(".")
    if dot_pos > 0 && dot_pos + 1 < fraw.length() {
      let p1 = fraw.slice(0, dot_pos)
      let p2 = fraw.slice(dot_pos + 1, fraw.length())
      let mut all_digits = true
      let mut k = 0
      while k < p1.length() { if !is_digit(p1.code_unit_at(k)) { all_digits = false }; k = k + 1 }
      k = 0
      while k < p2.length() { if !is_digit(p2.code_unit_at(k)) { all_digits = false }; k = k + 1 }
      if all_digits {
        return (trivia + "." + p1 + " ." + p2, i + 2)
      }
    }
  }

  // 10a. Reject MoonBit-invalid lowercase `f` suffix (`1.5f`, `0x1.8p0f`) fail-closed before Pion accepts it
  if t.kind == TokenKind::FloatLit && i + 1 < end &&
  tokens[i + 1].leading_trivia.length() == 0 &&
  tokens[i + 1].kind == TokenKind::Ident &&
  tokens[i + 1].raw == "f" {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      file,
      t.line,
      t.col,
      "lowercase float suffix `f` is not valid in MoonBit",
    ))
    return (trivia + t.raw + "f", i + 2)
  }

  // 10b. Hex float literal (`0x1.0p1023`, `0x1.fp-1022`, `0x1p-54`, and Float32 `0x1.8p0F`, `0x1.0p-149F`)
  //      MoonBit rounds hex Float32 via binary64 then narrows to binary32: `Float::from_double(Double::from_bits(<bits64>L))`
  if t.kind == TokenKind::FloatLit && (t.raw.starts_with("0x") || t.raw.starts_with("0X")) {
    if t.raw.ends_with("F") {
      if in_pattern {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          t.line,
          t.col,
          "Float32 literal `" + t.raw + "` is not supported in pattern position",
        ))
        return (trivia + t.raw, i + 1)
      }
      let hex_body = t.raw.slice(0, t.raw.length() - 1)
      match parse_hex_float_to_bits(hex_body) {
        Some(bits64) => return (trivia + "Float::from_double(Double::from_bits(" + bits64.to_string() + "L))", i + 1)
        None => ()
      }
    } else if !in_pattern {
      match parse_hex_float_to_bits(t.raw) {
        Some(bits) => return (trivia + "Double::from_bits(" + bits.to_string() + "L)", i + 1)
        None => ()
      }
    }
  }

  // 10c. MoonBit decimal Float32 literal (`1.5F`, `0.0F`, `1.0e3F`)
  if t.kind == TokenKind::FloatLit && t.raw.ends_with("F") {
    if in_pattern {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        t.line,
        t.col,
        "Float32 literal `" + t.raw + "` is not supported in pattern position",
      ))
      return (trivia + t.raw, i + 1)
    }
    let body = t.raw.slice(0, t.raw.length() - 1)
    return (trivia + "Float::from_double(" + body + ")", i + 1)
  }

  (trivia + t.raw, i + 1)
}

///| Parse a MoonBit hexadecimal floating-point literal (`0x1.0p1023`, `0x1.fp-1022`, `0x1p-54`)
///| into its exact IEEE-754 binary64 bit pattern (ties-to-even rounding, subnormals, overflow/underflow).
pub fn parse_hex_float_to_bits(raw : String) -> Option[Int64] {
  let n = raw.length()
  if n < 4 || !(raw.starts_with("0x") || raw.starts_with("0X")) {
    return None
  }
  let mut p_idx = -1
  let mut k = 2
  while k < n {
    let c = raw.code_unit_at(k)
    if c == 112 || c == 80 {
      p_idx = k
      break
    }
    k = k + 1
  }
  if p_idx < 0 || p_idx + 1 >= n {
    return None
  }
  // Parse signed decimal exponent after `p`/`P`
  let mut ei = p_idx + 1
  let mut exp_neg = false
  if raw.code_unit_at(ei) == 45 {
    exp_neg = true
    ei = ei + 1
  } else if raw.code_unit_at(ei) == 43 {
    ei = ei + 1
  }
  let mut exp_abs = 0
  let mut saw_exp_dig = false
  while ei < n {
    let c = raw.code_unit_at(ei)
    if c == 95 { ei = ei + 1; continue }
    if c < 48 || c > 57 { return None }
    saw_exp_dig = true
    if exp_abs < 1000000 {
      exp_abs = exp_abs * 10 + (c - 48)
    }
    ei = ei + 1
  }
  if !saw_exp_dig {
    return None
  }
  let mut exp = if exp_neg { -exp_abs } else { exp_abs }

  // Collect significant bits of mantissa into 55-bit buffer (bit 54 = MSB, bits 53..2 = 52 frac, bit 1 = guard, bit 0 = sticky)
  let mut sig : UInt64 = 0UL
  let mut bits_collected = 0
  let mut sticky = false
  let mut seen_dot = false
  let mut seen_nz = false
  let mut int_bits_after_msb = 0
  let mut mi = 2
  while mi < p_idx {
    let c = raw.code_unit_at(mi)
    if c == 95 { mi = mi + 1; continue }
    if c == 46 {
      if seen_dot { return None }
      seen_dot = true
      mi = mi + 1
      continue
    }
    let dig = if c >= 48 && c <= 57 { c - 48 }
    else if c >= 97 && c <= 102 { c - 97 + 10 }
    else if c >= 65 && c <= 70 { c - 65 + 10 }
    else { return None }
    let mut b = 3
    while b >= 0 {
      let bit = (dig >> b) & 1
      if !seen_nz {
        if bit != 0 {
          seen_nz = true
          sig = 1UL
          bits_collected = 1
          if seen_dot {
            exp = exp - 1
          }
        } else if seen_dot {
          exp = exp - 1
        }
      } else {
        if !seen_dot {
          int_bits_after_msb = int_bits_after_msb + 1
        }
        if bits_collected < 54 {
          sig = (sig << 1UL) | bit.to_int64().reinterpret_as_uint64()
          bits_collected = bits_collected + 1
        } else if bit != 0 {
          sticky = true
        }
      }
      b = b - 1
    }
    mi = mi + 1
  }
  if !seen_nz {
    return Some(0L)
  }
  // Align `sig` so MSB is at bit 54 (55 bits total: 53 significand + guard at bit 1 + sticky at bit 0)
  while bits_collected < 54 {
    sig = sig << 1UL
    bits_collected = bits_collected + 1
  }
  sig = (sig << 1UL) | (if sticky { 1UL } else { 0UL })
  let mut msb_exp = exp + int_bits_after_msb

  if msb_exp > 1023 {
    return Some(0x7ff0000000000000L)
  }
  if msb_exp < -1075 {
    return Some(0L)
  }
  if msb_exp >= -1022 {
    // Normal number: round ties-to-even at bit 2
    let gbit = (sig >> 1UL) & 1UL
    let st = sig & 1UL
    let mut mant53 = sig >> 2UL
    if gbit == 1UL && (st == 1UL || (mant53 & 1UL) == 1UL) {
      mant53 = mant53 + 1UL
      if (mant53 >> 53UL) != 0UL {
        mant53 = mant53 >> 1UL
        msb_exp = msb_exp + 1
      }
    }
    if msb_exp > 1023 {
      return Some(0x7ff0000000000000L)
    }
    let exp_bits = (msb_exp + 1023).to_int64().reinterpret_as_uint64()
    let frac_bits = mant53 & 0x000fffffffffffffUL
    let packed = (exp_bits << 52UL) | frac_bits
    return Some(packed.reinterpret_as_int64())
  }
  // Subnormal number: `-1075 <= msb_exp < -1022`
  let shift = -1022 - msb_exp
  // Shift `sig` right by `shift` preserving sticky in bit 0
  let mut sub_sig = sig
  let mut s = 0
  while s < shift {
    let lost = sub_sig & 1UL
    sub_sig = (sub_sig >> 1UL) | lost
    s = s + 1
  }
  let gbit = (sub_sig >> 1UL) & 1UL
  let st = sub_sig & 1UL
  let mut mant = sub_sig >> 2UL
  if gbit == 1UL && (st == 1UL || (mant & 1UL) == 1UL) {
    mant = mant + 1UL
  }
  Some(mant.reinterpret_as_int64())
}

///| Lower a cascade chain `recv..m1(a)..m2(b)` into a hygienic block that evaluates `recv` ONCE
///| and returns `recv`!
fn lower_cascade_chain(
  ctx : StageAContext,
  trivia : String,
  recv_expr : String,
  tokens : Array[Token],
  start_dotdot : Int,
  end : Int,
  file : String,
) -> (String, Int) {
  let tmp = fresh_temp(ctx, "cas")
  let sb = StringBuilder()
  sb.write_string(trivia)
  sb.write_string("{ let " + tmp + " = " + recv_expr + "; ")
  let mut cur = start_dotdot
  while cur < end && tokens[cur].kind == TokenKind::DotDot && cur + 1 < end && tokens[cur + 1].kind == TokenKind::Ident {
    let mname = rename_keyword_ident(tokens[cur + 1].raw)
    if cur + 2 < end && tokens[cur + 2].kind == TokenKind::LParen {
      let close_p = find_matching_delim(tokens, cur + 2)
      let call_str = lower_call_args(ctx, tokens, cur + 2, close_p, file, tokens[cur + 1].line, tokens[cur + 1].col, tmp + "." + mname, false, false)
      sb.write_string(call_str + "; ")
      cur = close_p + 1
    } else {
      sb.write_string(tmp + "." + mname + "; ")
      cur = cur + 2
    }
  }
  sb.write_string(tmp + " }")
  (sb.to_string(), cur)
}

///| Lower match arms inside `match expr { pat => body, ... }`.
///| E1-4: Strictly classify immediate read-only slice consumers.
///| Returns `(helper_name, next_token_idx, extra_arg)`. Anything outside the exact whitelist stays `__mbt_slice_borrow` (fail-closed).
fn classify_slice_consumer(
  ctx : StageAContext,
  tokens : Array[Token],
  close_br : Int,
  end : Int,
  own_exempt : Bool,
  has_chained_slice : Bool,
  allow_interp_top : Bool,
  file : String,
) -> (String, Int, String) {
  let followed_by_owned = close_br + 2 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  (tokens[close_br + 2].raw == "to_owned" || tokens[close_br + 2].raw == "to_array")
  if followed_by_owned {
    let next_after = if close_br + 4 < end &&
    tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
      close_br + 5
    } else {
      close_br + 1
    }
    return ("mbt_compat::__mbt_slice_owned", next_after, "")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "length" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
    return ("mbt_compat::__mbt_slice_owned", close_br + 1, "")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "is_empty" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen {
    return ("mbt_compat::__mbt_slice_owned", close_br + 5, "\"__IS_EMPTY__\"")
  }
  if !has_chained_slice && close_br + 4 < end && tokens[close_br + 1].kind == TokenKind::Dot &&
  tokens[close_br + 2].raw == "join" && tokens[close_br + 3].kind == TokenKind::LParen {
    let jp_end = find_matching_delim(tokens, close_br + 3)
    if jp_end == close_br + 5 {
      let st = tokens[close_br + 4]
      let is_pure_sep = st.kind == TokenKind::StringLit || st.kind == TokenKind::RawMultiline ||
      (st.kind == TokenKind::Ident && match lookup_scope_var(ctx, resolve_ident_in_scope(ctx, st.raw)) {
        Some(sv) => !sv.is_mut
        None => true
      })
      if is_pure_sep {
        let sep_s = lower_expr_range(ctx, tokens, close_br + 4, jp_end, file, false).trim()
        return ("mbt_compat::__mbt_slice_ro_join", jp_end + 1, sep_s)
      }
    }
  }
  let followed_by_to_str = !has_chained_slice && close_br + 4 < end &&
  tokens[close_br + 1].kind == TokenKind::Dot && tokens[close_br + 2].raw == "to_string" &&
  tokens[close_br + 3].kind == TokenKind::LParen && tokens[close_br + 4].kind == TokenKind::RParen
  if followed_by_to_str {
    return ("mbt_compat::__mbt_slice_ro_show", close_br + 5, "")
  }
  if allow_interp_top && !has_chained_slice && close_br + 1 == end {
    return ("mbt_compat::__mbt_slice_ro_show", close_br + 1, "")
  }
  if own_exempt && !has_chained_slice {
    return ("mbt_compat::__mbt_slice_owned", close_br + 1, "")
  }
  ("mbt_compat::__mbt_slice_borrow", close_br + 1, "")
}

///| E1-2: Scan top-level arm patterns in a `match` body and collect bare enum constructor names
///| plus whether any bare constructor pattern uses labeled arguments (`x~` or `x=pat`).
fn collect_match_top_bare_ctors(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
) -> (Array[String], Bool) {
  let ctors : Array[String] = []
  let seen : Map[String, Bool] = Map()
  let mut has_labeled = false
  let mut i = start
  while i < end {
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    while fa < end {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket { depth = depth - 1 }
      else if depth == 0 {
        if k == TokenKind::FatArrow { break }
        else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 { if_idx = fa }
      }
      fa = fa + 1
    }
    if fa >= end { break }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    // Scan depth-0 `|` segments in `[i, pat_end)`
    let mut seg_s = i
    while seg_s < pat_end {
      let mut seg_e = seg_s
      let mut sd = 0
      while seg_e < pat_end {
        let sk = tokens[seg_e].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBrace || sk == TokenKind::LBracket { sd = sd + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBrace || sk == TokenKind::RBracket { sd = sd - 1 }
        else if sd == 0 && sk == TokenKind::Pipe { break }
        seg_e = seg_e + 1
      }
      if seg_s < seg_e && tokens[seg_s].kind == TokenKind::UpperIdent {
        let is_qual = seg_s + 1 < seg_e && tokens[seg_s + 1].kind == TokenKind::ColonColon
        let cname = tokens[seg_s].raw
        if !is_qual && !ctx.symtab.const_defs.contains(cname) &&
        !ctx.active_generics.contains(cname) && !ctx.symtab.local_value_names.contains(cname) &&
        !((cname == "Some" || cname == "None" || cname == "Ok" || cname == "Err") && !has_local_ctor(ctx.symtab, cname)) {
          if !seen.contains(cname) {
            seen[cname] = true
            ctors.push(cname)
          }
          if seg_s + 1 < seg_e && tokens[seg_s + 1].kind == TokenKind::LParen {
            let rp = find_matching_delim(tokens, seg_s + 1)
            if rp < seg_e && paren_has_labeled_arg(tokens, seg_s + 1, rp) {
              has_labeled = true
            }
          }
        }
      }
      seg_s = seg_e + 1
    }
    let body_start = fa + 1
    let mut next_i = body_start
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      next_i = find_matching_delim(tokens, body_start) + 1
    } else if body_start < end {
      next_i = find_expr_end(tokens, body_start, end)
    }
    if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      next_i = next_i + 1
    }
    if next_i <= i { break }
    i = next_i
  }
  (ctors, has_labeled)
}

///| E1-2 Layer 3: Lower an ambiguous `match <scrut> { ... }` to a single-eval scrutinee binding
///| plus `mbt_compat::__mbt_match_scrut(__mbt_ms_N, "<spec>")` so Stage A.5 resolves the exact
///| package-qualified enum type BEFORE selecting/reordering labeled enum patterns.
fn lower_ambig_match_probe(
  ctx : StageAContext,
  tokens : Array[Token],
  brace_i : Int,
  close_b : Int,
  scrut_s : String,
  file : String,
  cands : Array[String],
  incomplete : Bool,
) -> String {
  let ms_var = fresh_temp(ctx, "ms")
  let arm_starts : Array[Int] = []
  let pat_ends : Array[Int] = []
  let arm_renames : Array[Map[String, String]] = []
  let guard_strs : Array[String] = []
  let body_strs : Array[String] = []
  let trail_seps : Array[String] = []

  let mut i = brace_i + 1
  while i < close_b {
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    while fa < close_b {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket { depth = depth - 1 }
      else if depth == 0 {
        if k == TokenKind::FatArrow { break }
        else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 { if_idx = fa }
      }
      fa = fa + 1
    }
    if fa >= close_b { break }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    let saved_arm_sc = ctx.scope_vars.length()
    let arm_raw_binders : Array[String] = []
    let mut rbi = i
    while rbi < pat_end {
      let rbt = tokens[rbi]
      if rbt.kind == TokenKind::Ident &&
      !(rbi > i && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
      !(rbi + 1 < pat_end && (tokens[rbi + 1].kind == TokenKind::Colon || tokens[rbi + 1].kind == TokenKind::Eq)) {
        arm_raw_binders.push(rbt.raw)
      }
      rbi = rbi + 1
    }
    let pat_rn = compute_scoped_binder_renames(ctx, arm_raw_binders)
    let pushed_rn = pat_rn.length() > 0
    if pushed_rn { ctx.ident_renames.push(pat_rn) }
    for rb in arm_raw_binders {
      if rb != "_" {
        ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
      }
    }
    ctx.match_arr_cache_ctor.push("__BLOCKED__")
    ctx.match_arr_cache_elems.push(Map())
    ctx.match_arr_cache_suffix.push(Map())
    ctx.match_arr_cache_len.push("")
    let g_str = if if_idx >= 0 { lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim() } else { "" }
    let body_start = fa + 1
    let mut body_raw = ""
    let mut next_i = body_start
    if body_start < close_b && tokens[body_start].kind == TokenKind::LBrace {
      let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, close_b, file, false)
      body_raw = blk
      next_i = ni
    } else if body_start < close_b && tokens[body_start].kind == TokenKind::Keyword &&
    (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
      let body_end = find_expr_end(tokens, body_start, close_b)
      let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      body_raw = "{ " + inner_b + " }"
      next_i = body_end
    } else {
      let body_end = find_expr_end(tokens, body_start, close_b)
      body_raw = lower_expr_range(ctx, tokens, body_start, body_end, file, false)
      next_i = body_end
    }
    let _ = ctx.match_arr_cache_ctor.pop()
    let _ = ctx.match_arr_cache_elems.pop()
    let _ = ctx.match_arr_cache_suffix.pop()
    let _ = ctx.match_arr_cache_len.pop()
    if pushed_rn { let _ = ctx.ident_renames.pop() }
    restore_scope_vars(ctx, saved_arm_sc)
    let mut trail_sep = ""
    if next_i < close_b && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      trail_sep = tokens[next_i].raw
      next_i = next_i + 1
    }
    arm_starts.push(i)
    pat_ends.push(pat_end)
    arm_renames.push(pat_rn)
    guard_strs.push(g_str)
    body_strs.push(body_raw.trim())
    trail_seps.push(trail_sep)
    if next_i <= i { break }
    i = next_i
  }

  let arms_json : Array[json::JsonValue] = []
  let mut ai = 0
  while ai < arm_starts.length() {
    arms_json.push(json_obj([
      json_field("g", json_str(guard_strs[ai])),
      json_field("b", json_str(body_strs[ai])),
      json_field("sep", json_str(trail_seps[ai])),
    ]))
    ai = ai + 1
  }

  let cand_fields : Array[json::JsonField] = []
  for ek in cands {
    let diags_before = ctx.diags.length()
    push_expected_type(ctx, ek)
    let pats_json : Array[json::JsonValue] = []
    let mut pi = 0
    while pi < arm_starts.length() {
      let rn = arm_renames[pi]
      let pushed = rn.length() > 0
      if pushed { ctx.ident_renames.push(rn) }
      let alts = expand_nested_or_pat(ctx, tokens, arm_starts[pi], pat_ends[pi], file)
      if pushed { let _ = ctx.ident_renames.pop() }
      let pat_sb = StringBuilder()
      let mut ki = 0
      while ki < alts.length() {
        if ki > 0 { pat_sb.write_string(" | ") }
        pat_sb.write_string(alts[ki])
        ki = ki + 1
      }
      pats_json.push(json_str(pat_sb.to_string()))
      pi = pi + 1
    }
    pop_expected_type(ctx)
    let mut err_code = ""
    let mut err_msg = ""
    let mut di = diags_before
    while di < ctx.diags.length() {
      if ctx.diags[di].severity == "error" {
        err_code = ctx.diags[di].code
        err_msg = ctx.diags[di].message
        break
      }
      di = di + 1
    }
    while ctx.diags.length() > diags_before {
      let _ = ctx.diags.pop()
    }
    if err_code.length() > 0 {
      cand_fields.push(json_field(ek, json_obj([
        json_field("ok", json_bool(false)),
        json_field("err_code", json_str(err_code)),
        json_field("err_msg", json_str(err_msg)),
      ])))
    } else {
      cand_fields.push(json_field(ek, json_obj([
        json_field("ok", json_bool(true)),
        json_field("pats", json_arr(pats_json)),
      ])))
    }
  }

  let spec = json_obj([
    json_field("v", json_str(ms_var)),
    json_field("incomplete", json_bool(incomplete)),
    json_field("arms", json_arr(arms_json)),
    json_field("cands", json_obj(cand_fields)),
  ])
  let spec_lit = json::stringify(json_str(json::stringify(spec)))
  "{ let " + ms_var + " = " + scrut_s.trim() + "; mbt_compat::__mbt_match_scrut(" + ms_var + ", " + spec_lit + ") }"
}

fn lower_match_arms(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  lower_match_arms_with_ty(ctx, tokens, start, end, file, "")
}

///| Expand nested `|` or-patterns inside `(...)` into top-level `pat1 | pat2 | ...`.
fn expand_nested_or_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> Array[String] {
  // Check for depth-0 `|` first
  let mut k = start
  let mut d = 0
  let pipe_positions : Array[Int] = []
  let mut has_nested_pipe = false
  let mut first_lp = -1
  while k < end {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 && kk == TokenKind::LParen && first_lp < 0 {
        first_lp = k
      }
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d - 1
    } else if kk == TokenKind::Pipe {
      if d == 0 {
        pipe_positions.push(k)
      } else {
        has_nested_pipe = true
      }
    }
    k = k + 1
  }
  if pipe_positions.length() > 0 {
    let out : Array[String] = []
    let mut seg_s = start
    for pp in pipe_positions {
      let sub = expand_nested_or_pat(ctx, tokens, seg_s, pp, file)
      for s in sub { out.push(s) }
      seg_s = pp + 1
    }
    let last_sub = expand_nested_or_pat(ctx, tokens, seg_s, end, file)
    for s in last_sub { out.push(s) }
    return out
  }
  if !has_nested_pipe || first_lp < 0 {
    return [lower_expr_range(ctx, tokens, start, end, file, true).trim()]
  }
  let rp = find_matching_delim(tokens, first_lp)
  let prefix = if first_lp > start { lower_expr_range(ctx, tokens, start, first_lp, file, true).trim() } else { "" }
  let suffix = if rp + 1 < end { lower_expr_range(ctx, tokens, rp + 1, end, file, true).trim() } else { "" }
  // Split comma-separated items inside `( ... )` and take Cartesian product
  let item_alts : Array[Array[String]] = []
  let mut ai = first_lp + 1
  while ai < rp {
    if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
    let mut ae = ai
    let mut ad = 0
    while ae < rp {
      let ak = tokens[ae].kind
      if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
      else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
      else if ad == 0 && ak == TokenKind::Comma { break }
      ae = ae + 1
    }
    item_alts.push(expand_nested_or_pat(ctx, tokens, ai, ae, file))
    ai = ae + 1
  }
  let mut combos : Array[String] = [""]
  let mut ci = 0
  while ci < item_alts.length() {
    let next_combos : Array[String] = []
    for c in combos {
      for alt in item_alts[ci] {
        if ci == 0 {
          next_combos.push(alt)
        } else {
          next_combos.push(c + ", " + alt)
        }
      }
    }
    combos = next_combos
    ci = ci + 1
  }
  let out : Array[String] = []
  for c in combos {
    out.push(prefix + "(" + c + ")" + suffix)
  }
  out
}

///| Replace lowercase pattern binders with `_` for use in boolean `is` guards.
fn wildcard_pattern_str(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let t = tokens[i]
    if t.kind == TokenKind::Ident && !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      sb.write_string(t.leading_trivia + "_")
      i = i + 1
    } else {
      let (p, ni) = lower_one_token_or_form(ctx, tokens, i, end, file, true)
      sb.write_string(p)
      i = ni
    }
  }
  sb.to_string().trim()
}

///| D2-2: Resolve `(AbiEnumSchema, AbiEnumVariant)` for a constructor/pattern site.
///| When `expected_type` does not match any candidate (e.g. inside `out.push(NavAction(...))`
///| inheriting an unrelated enclosing return type), falls back to unguided unique/local lookup
///| while preserving fail-closed ambiguity rejection.
fn resolve_enum_schema_d2(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
) -> Option[(AbiEnumSchema, AbiEnumVariant)] {
  if enum_hint.length() > 0 {
    let key = if pkg_hint.length() > 0 && !str_has(enum_hint, "::") {
      pkg_hint + "::" + enum_hint
    } else {
      enum_hint
    }
    match ctx.symtab.enum_schemas.get(key) {
      Some(sch) => {
        for v in sch.variants {
          if v.name == ctor_name {
            return Some((sch, v))
          }
        }
      }
      None => ()
    }
  }
  match ctx.symtab.enum_schemas_by_ctor.get(ctor_name) {
    Some(cands) => {
      let exp_base = strip_type_args_sym(current_expected_type(ctx))
      if exp_base.length() > 0 && pkg_hint.length() == 0 && enum_hint.length() == 0 {
        let exp_matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
        let exp_local : Array[(AbiEnumSchema, AbiEnumVariant)] = []
        for c in cands {
          let sch = c.0
          let full_e = if sch.pkg.length() > 0 { sch.pkg + "::" + sch.name } else { sch.name }
          if str_has(exp_base, "::") {
            if full_e == exp_base { exp_matched.push(c) }
          } else if sch.name == exp_base {
            exp_matched.push(c)
            if sch.pkg.length() == 0 { exp_local.push(c) }
          }
        }
        if exp_matched.length() == 1 {
          return Some(exp_matched[0])
        }
        if exp_local.length() == 1 {
          return Some(exp_local[0])
        }
      }
      let matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      let local_matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      for c in cands {
        let sch = c.0
        if pkg_hint.length() > 0 && sch.pkg != pkg_hint {
          continue
        }
        if enum_hint.length() > 0 {
          let full_e = if sch.pkg.length() > 0 { sch.pkg + "::" + sch.name } else { sch.name }
          if sch.name != enum_hint && full_e != enum_hint {
            continue
          }
        }
        matched.push(c)
        if sch.pkg.length() == 0 {
          local_matched.push(c)
        }
      }
      if matched.length() == 1 {
        return Some(matched[0])
      }
      if pkg_hint.length() == 0 && local_matched.length() == 1 {
        return Some(local_matched[0])
      }
      None
    }
    None => None
  }
}

///| D2-2: Reorder labeled enum constructor/pattern arguments directly into declaration positional order
///| (exact MoonBit declaration-order evaluation, ZERO call-site temporaries, hygienic punning `ident~`).
fn lower_labeled_enum_args_d2(
  ctx : StageAContext,
  schema : AbiEnumSchema,
  variant : AbiEnumVariant,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> String {
  let nfields = variant.fields.length()
  let slots : Array[String] = []
  let filled : Array[Bool] = []
  let mut fi = 0
  while fi < nfields {
    slots.push("")
    filled.push(false)
    fi = fi + 1
  }
  let mut has_rest = false
  let mut next_pos = 0
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { depth = depth - 1 }
      else if depth == 0 && k == TokenKind::Comma { break }
      a_end = a_end + 1
    }
    if in_pattern && a_end == cur + 1 && tokens[cur].kind == TokenKind::DotDot {
      has_rest = true
      cur = a_end + 1
      continue
    }
    let is_punning = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    a_end == cur + 2 && tokens[cur + 1].kind == TokenKind::Tilde
    let is_named = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    cur + 2 < a_end && tokens[cur + 1].kind == TokenKind::Eq
    if is_punning || is_named {
      let lbl = tokens[cur].raw
      let mut target_idx = -1
      let mut k = 0
      while k < nfields {
        if variant.fields[k].label == lbl {
          target_idx = k
          break
        }
        k = k + 1
      }
      if target_idx < 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "unknown label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else if filled[target_idx] {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "duplicate label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        let val_s = if is_punning {
          if !in_pattern && tokens[cur].kind == TokenKind::Ident {
            lower_expr_range(ctx, tokens, cur, cur + 1, file, false).trim()
          } else {
            resolve_ident_in_scope(ctx, lbl)
          }
        } else {
          push_expected_type(ctx, variant.fields[target_idx].ty)
          let lowered = lower_expr_range(ctx, tokens, cur + 2, a_end, file, in_pattern).trim()
          pop_expected_type(ctx)
          lowered
        }
        slots[target_idx] = val_s
        filled[target_idx] = true
      }
    } else if a_end > cur {
      while next_pos < nfields && (filled[next_pos] || variant.fields[next_pos].label.length() > 0) {
        next_pos = next_pos + 1
      }
      if next_pos >= nfields {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "too many positional arguments for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        push_expected_type(ctx, variant.fields[next_pos].ty)
        let lowered = lower_expr_range(ctx, tokens, cur, a_end, file, in_pattern).trim()
        pop_expected_type(ctx)
        slots[next_pos] = lowered
        filled[next_pos] = true
        next_pos = next_pos + 1
      }
    }
    cur = a_end + 1
  }
  let ordered : Array[String] = []
  let mut k = 0
  while k < nfields {
    if filled[k] {
      ordered.push(slots[k])
    } else if in_pattern && (has_rest || variant.fields[k].label.length() > 0) {
      ordered.push("_")
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_ENUM_LABEL_ERROR",
        file,
        line,
        col,
        "missing required field `" + (if variant.fields[k].label.length() > 0 { variant.fields[k].label } else { "#" + k.to_string() }) + "` for enum variant `" + schema.name + "::" + variant.name + "`",
      ))
      ordered.push("_")
    }
    k = k + 1
  }
  "(" + join_comma(ordered) + ")"
}

fn check_and_lower_enum_site_d2(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> Option[String] {
  let has_lbl = open_p >= 0 && paren_has_labeled_arg(tokens, open_p, close_p)
  match resolve_enum_schema_d2(ctx, pkg_hint, enum_hint, ctor_name) {
    Some((sch, variant)) => {
      if sch.pkg.length() > 0 {
        if !in_pattern && !sch.can_construct {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot construct readonly `pub enum` variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "` from outside its package",
          ))
        } else if in_pattern && !sch.can_match {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot pattern-match private enum variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "`",
          ))
        }
      }
      if open_p < 0 {
        return None
      }
      let mut schema_has_labels = false
      for f in variant.fields {
        if f.label.length() > 0 {
          schema_has_labels = true
          break
        }
      }
      if has_lbl || schema_has_labels {
        return Some(lower_labeled_enum_args_d2(ctx, sch, variant, tokens, open_p, close_p, file, line, col, in_pattern))
      }
      None
    }
    None => {
      if has_lbl {
        let err_code = if pkg_hint.length() > 0 && !ctx.symtab.verified_abi_deps.contains(pkg_hint) {
          "MBT2PION_DEP_ABI_ERROR"
        } else {
          "MBT2PION_ENUM_LABEL_ERROR"
        }
        ctx.diags.push(diag_error(
          err_code,
          file,
          line,
          col,
          "labeled enum variant `" + ctor_name + "` requires local declaration or verified `--dep` `mbt2pion_abi.json` metadata",
        ))
      }
      None
    }
  }
}

///| D2-4: Extract a compile-time scalar/string literal from a `const` RHS token range.
fn extract_const_literal_pion(tokens : Array[Token], start : Int, end : Int) -> Option[String] {
  let mut e = end
  while e > start && tokens[e - 1].kind == TokenKind::Semi {
    e = e - 1
  }
  let len = e - start
  if len == 1 {
    let t = tokens[start]
    if t.kind == TokenKind::IntLit || t.kind == TokenKind::CharLit || t.kind == TokenKind::StringLit {
      return Some(t.raw)
    }
    if t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false") {
      return Some(t.raw)
    }
    if t.kind == TokenKind::FloatLit && !t.raw.ends_with("F") && !t.raw.starts_with("0x") && !t.raw.starts_with("0X") {
      return Some(t.raw)
    }
    return None
  }
  if len == 2 && tokens[start].kind == TokenKind::Minus {
    let t = tokens[start + 1]
    if t.kind == TokenKind::IntLit {
      return Some("-" + t.raw)
    }
    if t.kind == TokenKind::FloatLit && !t.raw.ends_with("F") && !t.raw.starts_with("0x") && !t.raw.starts_with("0X") {
      return Some("-" + t.raw)
    }
  }
  None
}

///| D2-5: Recognize a constructor-wrapped array pattern of depth >= 1, e.g.:
///| `Some([x, _])`, `Option::Some([a, b, ..])`, `Some(Array([Number(x, ..), ...]))`,
///| `Some(Json::Array([Number(x, ..), ..]))`, `Some([x, _] as arr)`.
///| Returns `Some((lbr, rbr, as_var_idx, outer_prefix, outer_suffix, is_json_array))`.
fn find_nested_ctor_array_pat(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  pat_end : Int,
  file : String,
) -> Option[(Int, Int, Int, String, String, Bool)] {
  let prefix_sb = StringBuilder()
  let suffix_sb = StringBuilder()
  let mut cur = start
  let mut cur_end = pat_end
  let mut depth_layers = 0
  let mut last_ctor_raw = ""
  while cur < cur_end {
    let mut lp = -1
    let mut ctor_raw = ""
    if cur + 1 < cur_end && tokens[cur].kind == TokenKind::UpperIdent && tokens[cur + 1].kind == TokenKind::LParen {
      lp = cur + 1
      ctor_raw = tokens[cur].raw
    } else if cur + 3 < cur_end && tokens[cur].kind == TokenKind::UpperIdent &&
    tokens[cur + 1].kind == TokenKind::ColonColon && tokens[cur + 2].kind == TokenKind::UpperIdent &&
    tokens[cur + 3].kind == TokenKind::LParen {
      lp = cur + 3
      ctor_raw = tokens[cur].raw + "::" + tokens[cur + 2].raw
    } else {
      break
    }
    let rp = find_matching_delim(tokens, lp)
    if rp != cur_end - 1 {
      return None
    }
    let head_s = if ctor_raw == "Array" && !has_local_ctor(ctx.symtab, "Array") {
      "mbt_compat::MbtJson::Array"
    } else if ctor_raw == "Json::Array" && !ctx.symtab.local_types.contains("Json") {
      "mbt_compat::MbtJson::Array"
    } else {
      lower_expr_range(ctx, tokens, cur, lp, file, true).trim()
    }
    prefix_sb.write_string(head_s + "(")
    suffix_sb.write_string(")")
    last_ctor_raw = ctor_raw
    depth_layers = depth_layers + 1
    cur = lp + 1
    cur_end = rp
    if cur < cur_end && tokens[cur].kind == TokenKind::LBracket {
      let rbr = find_matching_delim(tokens, cur)
      let has_as = rbr + 2 == cur_end - 1 && tokens[rbr + 1].kind == TokenKind::Keyword &&
      tokens[rbr + 1].raw == "as" && tokens[rbr + 2].kind == TokenKind::Ident
      if rbr == cur_end - 1 || has_as {
        let as_idx = if has_as { rbr + 2 } else { -1 }
        let is_json_arr = (last_ctor_raw == "Array" || last_ctor_raw == "Json::Array") && !has_local_ctor(ctx.symtab, "Array")
        return Some((cur, rbr, as_idx, prefix_sb.to_string(), suffix_sb.to_string(), is_json_arr))
      }
      return None
    }
  }
  None
}

fn lower_match_arms_with_ty(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
  scrut_ty : String,
) -> String {
  let sb = StringBuilder()
  let mut had_guarded_struct_arm = false
  let mut has_unguarded_catchall = false
  let mut i = start
  while i < end {
    // Find `=>` at depth 0
    let mut fa = i
    let mut depth = 0
    let mut if_idx = -1
    let mut top_as_idx = -1
    while fa < end {
      let k = tokens[fa].kind
      if k == TokenKind::LParen || k == TokenKind::LBrace || k == TokenKind::LBracket {
        depth = depth + 1
      } else if k == TokenKind::RParen || k == TokenKind::RBrace || k == TokenKind::RBracket {
        depth = depth - 1
      } else if depth == 0 {
        if k == TokenKind::FatArrow {
          break
        } else if k == TokenKind::Keyword && tokens[fa].raw == "if" && if_idx < 0 {
          if_idx = fa
        } else if k == TokenKind::Keyword && tokens[fa].raw == "as" && if_idx < 0 && top_as_idx < 0 {
          top_as_idx = fa
        }
      }
      fa = fa + 1
    }
    if fa >= end {
      sb.write_string(lower_expr_range(ctx, tokens, i, end, file, false))
      break
    }
    let pat_end = if if_idx >= 0 { if_idx } else { fa }
    let saved_arm_sc = ctx.scope_vars.length()

    // §D2-5: Nested fixed-length / trailing-rest array pattern inside constructor(s) of arbitrary depth
    // with pre-guard binding snapshot AND strict hygienic binding-scope isolation (Astra P0-2 & P0-3).
    push_expected_type(ctx, scrut_ty)
    let nested_arr_opt = find_nested_ctor_array_pat(ctx, tokens, i, pat_end, file)
    pop_expected_type(ctx)
    match nested_arr_opt {
      Some((lbr, rbr, as_idx, outer_prefix, outer_suffix, is_json_arr)) => {
        let lead_triv = tokens[i].leading_trivia
        // Static unwrap for `Option[T]` / `Result[T, E]` (fast fail-closed for String/Bytes; unproven types go through Stage A.5 `__mbt_arrpat_len` probe!)
        let scrut_t = scrut_ty.trim()
        let mut unwrapped_inner = ""
        if (outer_prefix == "Some(" || outer_prefix == "Option::Some(") &&
        scrut_t.starts_with("Option[") && scrut_t.ends_with("]") {
          unwrapped_inner = scrut_t.slice(7, scrut_t.length() - 1).trim()
        } else if (outer_prefix == "Ok(" || outer_prefix == "Result::Ok(" ||
          outer_prefix == "Err(" || outer_prefix == "Result::Err(") &&
        scrut_t.starts_with("Result[") && scrut_t.ends_with("]") {
          let rbody = scrut_t.slice(7, scrut_t.length() - 1)
          let mut ri = 0
          let mut rd = 0
          let mut rcomma = -1
          while ri < rbody.length() {
            let ch = rbody.code_unit_at(ri)
            if ch == 40 || ch == 91 || ch == 123 { rd = rd + 1 }
            else if ch == 41 || ch == 93 || ch == 125 { if rd > 0 { rd = rd - 1 } }
            else if rd == 0 && ch == 44 { rcomma = ri; break }
            ri = ri + 1
          }
          if outer_prefix == "Err(" || outer_prefix == "Result::Err(" {
            unwrapped_inner = if rcomma > 0 { rbody.slice(rcomma + 1, rbody.length()).trim() } else { "" }
          } else {
            unwrapped_inner = if rcomma > 0 { rbody.slice(0, rcomma).trim() } else { rbody.trim() }
          }
        }
        let inner_clean = strip_type_args_sym(unwrapped_inner)
        if inner_clean == "String" || inner_clean == "Bytes" {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[lbr].line,
            tokens[lbr].col,
            "array pattern matching on `" + inner_clean + "` is not supported (only Array/FixedArray/ArrayView)",
          ))
        }
        let is_proven_arr = is_json_arr || inner_clean == "Array" || inner_clean == "FixedArray" ||
        inner_clean == "ArrayView" || inner_clean == "mbt_compat::ArrayView" ||
        inner_clean == "ArrayBuf" || inner_clean == "mbt_compat::ArrayBuf"
        // 1. Collect all raw lowercase binders in this arm's pattern & allocate globally unique hygienic temps!
        let raw_binders : Array[String] = []
        let hyg_map : Map[String, String] = Map()
        let mut bi = lbr + 1
        while bi < pat_end {
          let bt = tokens[bi]
          if bt.kind == TokenKind::Ident && bt.raw != "_" &&
          !(bi > lbr && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
          !(bi + 1 < pat_end && (tokens[bi + 1].kind == TokenKind::Colon || tokens[bi + 1].kind == TokenKind::Eq)) &&
          !hyg_map.contains(bt.raw) {
            raw_binders.push(bt.raw)
            hyg_map[bt.raw] = fresh_temp(ctx, "pb_" + bt.raw)
          }
          bi = bi + 1
        }
        // 2. Push `hyg_map` ONLY while lowering pattern binders (`prefix_pats`, `suffix_pats`, `rest_as_var`, `arr_var`)!
        let saved_hyg_rn = ctx.ident_renames.length()
        if hyg_map.length() > 0 {
          ctx.ident_renames.push(hyg_map)
        }
        let prefix_pats : Array[String] = []
        let suffix_pats : Array[String] = []
        let mut has_rest = false
        let mut rest_as_var = ""
        let mut seen_rest = false
        let mut invalid_rest = false
        let mut ei = lbr + 1
        while ei < rbr {
          if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
          let mut ee = ei
          let mut ed = 0
          while ee < rbr {
            let ek = tokens[ee].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && ek == TokenKind::Comma { break }
            ee = ee + 1
          }
          if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
            if seen_rest { invalid_rest = true } else { seen_rest = true; has_rest = true }
          } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
          tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
          (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
              if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
              }
            }
          } else if ee > ei {
            if is_json_arr { push_expected_type(ctx, "mbt_compat::MbtJson") }
            let lp = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
            if is_json_arr { pop_expected_type(ctx) }
            if seen_rest { suffix_pats.push(lp) } else { prefix_pats.push(lp) }
          }
          ei = ee + 1
        }
        if invalid_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[lbr].line,
            tokens[lbr].col,
            "array pattern cannot contain more than one `..` rest pattern",
          ))
        }
        let arr_var = if as_idx >= 0 { resolve_ident_in_scope(ctx, tokens[as_idx].raw) } else { fresh_temp(ctx, "ap") }
        // 3. POP `hyg_map` BEFORE lowering guard & body so inner `let x` / `fn(x)` shadowing uses native Pion lexical scope!
        restore_ident_renames(ctx, saved_hyg_rn)
        let arm_kw_renames = compute_scoped_binder_renames(ctx, raw_binders)
        let saved_kw_rn = ctx.ident_renames.length()
        if arm_kw_renames.length() > 0 {
          ctx.ident_renames.push(arm_kw_renames)
        }
        let rebind_sb = StringBuilder()
        for raw_b in raw_binders {
          let scoped_b = resolve_ident_in_scope(ctx, raw_b)
          ctx.scope_vars.push(ScopeVar::{ name: scoped_b, ty: "", is_mut: false, is_boxed: false })
          match hyg_map.get(raw_b) {
            Some(hv) => rebind_sb.write_string("let " + scoped_b + " = " + hv + "; ")
            None => ()
          }
        }
        let rebind_prefix = rebind_sb.to_string()
        // 4. Lower user guard & arm body under regular keyword renames only
        ctx.match_arr_cache_ctor.push("__BLOCKED__")
        ctx.match_arr_cache_elems.push(Map())
        ctx.match_arr_cache_suffix.push(Map())
        ctx.match_arr_cache_len.push("")
        let guard_str = if if_idx >= 0 {
          lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim()
        } else {
          ""
        }
        let body_start = fa + 1
        let mut body_raw = ""
        let mut next_i = body_start
        if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
          let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, end, file, false)
          body_raw = blk
          next_i = ni
        } else if body_start < end && tokens[body_start].kind == TokenKind::Keyword &&
        (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
          let body_end = find_expr_end(tokens, body_start, end)
          let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
          body_raw = tokens[body_start].leading_trivia + "{ " + inner_b + " }"
          next_i = body_end
        } else {
          let body_end = find_expr_end(tokens, body_start, end)
          body_raw = lower_expr_range(ctx, tokens, body_start, body_end, file, false)
          next_i = body_end
        }
        let _ = ctx.match_arr_cache_ctor.pop()
        let _ = ctx.match_arr_cache_elems.pop()
        let _ = ctx.match_arr_cache_suffix.pop()
        let _ = ctx.match_arr_cache_len.pop()
        // 5. POP keyword renames & restore outer scope BEFORE lowering `<next_arm_chain>` (Astra P0-3)!
        restore_ident_renames(ctx, saved_kw_rn)
        restore_scope_vars(ctx, saved_arm_sc)
        let mut trail_sep = ""
        if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
          trail_sep = tokens[next_i].leading_trivia + tokens[next_i].raw
          next_i = next_i + 1
        }
        // 6. Build pre-guard element/length snapshots & sequential decision chain with exact explicit-slot caching (E1-3)
        let mc_var = fresh_temp(ctx, "mc")
        let cache_hit = ctx.match_arr_cache_ctor.length() > 0 &&
        ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == outer_prefix
        let cached_p : Map[Int, String] = if cache_hit {
          ctx.match_arr_cache_elems[ctx.match_arr_cache_elems.length() - 1]
        } else {
          Map()
        }
        let cached_s : Map[Int, String] = if cache_hit && ctx.match_arr_cache_suffix.length() > 0 {
          ctx.match_arr_cache_suffix[ctx.match_arr_cache_suffix.length() - 1]
        } else {
          Map()
        }
        let cached_len : String = if cache_hit && ctx.match_arr_cache_len.length() > 0 {
          ctx.match_arr_cache_len[ctx.match_arr_cache_len.length() - 1]
        } else {
          ""
        }
        let ext_p : Map[Int, String] = Map()
        for k in cached_p.keys() {
          match cached_p.get(k) { Some(v) => ext_p[k] = v, None => () }
        }
        let ext_s : Map[Int, String] = Map()
        for k in cached_s.keys() {
          match cached_s.get(k) { Some(v) => ext_s[k] = v, None => () }
        }
        let bind_sb = StringBuilder()
        let all_pats : Array[String] = []
        let all_exprs : Array[String] = []
        let mut sbi = 0
        while sbi < prefix_pats.length() {
          all_pats.push(prefix_pats[sbi])
          match ext_p.get(sbi) {
            Some(ev) => all_exprs.push(ev)
            None => {
              let el_v = fresh_temp(ctx, "el")
              bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + sbi.to_string() + "]; ")
              ext_p[sbi] = el_v
              all_exprs.push(el_v)
            }
          }
          sbi = sbi + 1
        }
        if suffix_pats.length() > 0 {
          let mut need_len_snap = false
          let mut si0 = 0
          while si0 < suffix_pats.length() {
            if !ext_s.contains(suffix_pats.length() - si0) { need_len_snap = true; break }
            si0 = si0 + 1
          }
          let len_snap = if need_len_snap {
            let ls = fresh_temp(ctx, "ln")
            bind_sb.write_string("let " + ls + " = " + arr_var + ".length(); ")
            ls
          } else {
            ""
          }
          let mut si = 0
          while si < suffix_pats.length() {
            let dist = suffix_pats.length() - si
            all_pats.push(suffix_pats[si])
            match ext_s.get(dist) {
              Some(prev_ev) => all_exprs.push(prev_ev)
              None => {
                let el_v = fresh_temp(ctx, "el")
                bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + len_snap + " - " + dist.to_string() + "]; ")
                ext_s[dist] = el_v
                all_exprs.push(el_v)
              }
            }
            si = si + 1
          }
        }
        let rest_end_expr = if suffix_pats.length() == 0 {
          arr_var + ".length()"
        } else {
          arr_var + ".length() - " + suffix_pats.length().to_string()
        }
        let rest_bind_prefix = if rest_as_var.length() > 0 {
          "let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
        } else {
          ""
        }
        let min_len = prefix_pats.length() + suffix_pats.length()
        let rest_uncached = if next_i < end {
          lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
        } else {
          ""
        }
        let none_uncached = if rest_uncached.length() > 0 {
          "match " + mc_var + " { " + rest_uncached + " }"
        } else {
          "panic(\"unreachable\")"
        }
        let next_cached_len = if cached_len.length() > 0 {
          cached_len
        } else if !has_rest {
          min_len.to_string()
        } else {
          ""
        }
        let none_cached = if guard_str.length() > 0 && next_i < end && (min_len > 0 || !has_rest) {
          ctx.match_arr_cache_ctor.push(outer_prefix)
          ctx.match_arr_cache_elems.push(ext_p)
          ctx.match_arr_cache_suffix.push(ext_s)
          ctx.match_arr_cache_len.push(next_cached_len)
          let rc = lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
          let _ = ctx.match_arr_cache_ctor.pop()
          let _ = ctx.match_arr_cache_elems.pop()
          let _ = ctx.match_arr_cache_suffix.pop()
          let _ = ctx.match_arr_cache_len.pop()
          if rc.length() > 0 { "match " + mc_var + " { " + rc + " }" } else { "panic(\"unreachable\")" }
        } else {
          none_uncached
        }
        let len_op = if has_rest { " >= " } else { " == " }
        let live_len_expr = if is_proven_arr { arr_var + ".length()" } else { "mbt_compat::__mbt_arrpat_len(" + arr_var + ")" }
        let len_lhs = if cached_len.length() > 0 { cached_len } else { live_len_expr }
        let len_cond = len_lhs + len_op + min_len.to_string()
        let outer_pat = outer_prefix + arr_var + outer_suffix
        let body_t = body_raw.trim()
        let body_rebound = if rebind_prefix.length() > 0 { "{ " + rebind_prefix + body_t + " }" } else { body_t }
        let guard_rebound = if rebind_prefix.length() > 0 { "{ " + rebind_prefix + guard_str + " }" } else { guard_str }
        let inner_branch = if all_pats.length() == 0 {
          if guard_str.length() > 0 {
            rest_bind_prefix + "if (" + guard_rebound + ") { " + body_rebound + " } else { " + none_cached + " }"
          } else {
            rest_bind_prefix + body_rebound
          }
        } else {
          let tup_e = if all_pats.length() == 1 { all_exprs[0] } else { "(" + join_comma(all_exprs) + ")" }
          let tup_p = if all_pats.length() == 1 { all_pats[0] } else { "(" + join_comma(all_pats) + ")" }
          let matched_arm = if guard_str.length() > 0 {
            "if (" + guard_rebound + ") { " + body_rebound + " } else { " + none_cached + " }"
          } else {
            body_rebound
          }
          bind_sb.to_string() + rest_bind_prefix + "match " + tup_e + " { " + tup_p + " => " + matched_arm + ", _ => " + none_cached + " }"
        }
        let inner_match = "match " + mc_var + " { " + outer_pat + " => if " + len_cond + " { " + inner_branch + " } else { " + none_uncached + " }, _ => " + none_uncached + " }"
        sb.write_string(lead_triv + mc_var + tokens[fa].leading_trivia + "=> " + inner_match + trail_sep)
        break
      }
      None => ()
    }
    // P1-2: Compute collision-free binder renames for this arm's pattern (e.g. `{ val, val_, .. }`)
    // BEFORE lowering guard & body so `val` -> `val_1` and `val_` -> `val_` consistently!
    let arm_raw_binders : Array[String] = []
    let mut rbi = i
    while rbi < pat_end {
      let rbt = tokens[rbi]
      if rbt.kind == TokenKind::Ident &&
      !(rbi > i && (tokens[rbi - 1].kind == TokenKind::Dot || tokens[rbi - 1].kind == TokenKind::ColonColon)) &&
      !(rbi + 1 < pat_end && tokens[rbi + 1].kind == TokenKind::Colon) {
        arm_raw_binders.push(rbt.raw)
      }
      rbi = rbi + 1
    }
    let arm_pat_renames = compute_scoped_binder_renames(ctx, arm_raw_binders)
    let pushed_arm_renames = arm_pat_renames.length() > 0
    if pushed_arm_renames {
      ctx.ident_renames.push(arm_pat_renames)
    }
    for rb in arm_raw_binders {
      if rb != "_" {
        ctx.scope_vars.push(ScopeVar::{ name: resolve_ident_in_scope(ctx, rb), ty: "", is_mut: false, is_boxed: false })
      }
    }
    // Sound static binder typing for `Some(v)` / `Ctor(v0, ...)` / `.Ctor(v0, ...)` in match arms (P1-1)
    let mut ct_scan = i
    while ct_scan + 2 < pat_end {
      let ctt = tokens[ct_scan]
      if ctt.kind == TokenKind::UpperIdent && tokens[ct_scan + 1].kind == TokenKind::LParen {
        let cp_c = find_matching_delim(tokens, ct_scan + 1)
        if cp_c < pat_end {
          let cname = ctt.raw
          // `Some(v)` when `scrut_ty` is `Option[T]`
          if cname == "Some" && scrut_ty.starts_with("Option[") && scrut_ty.ends_with("]") {
            let inner_t = scrut_ty.slice(7, scrut_ty.length() - 1).trim()
            if ct_scan + 3 == cp_c && tokens[ct_scan + 2].kind == TokenKind::Ident && tokens[ct_scan + 2].raw != "_" {
              ctx.scope_vars.push(ScopeVar::{
                name: resolve_ident_in_scope(ctx, tokens[ct_scan + 2].raw),
                ty: inner_t,
                is_mut: false,
                is_boxed: false,
              })
            }
          } else {
            match ctx.symtab.enum_schemas_by_ctor.get(cname) {
              Some(cands) =>
              if cands.length() == 1 {
                let vfields = cands[0].1.fields
                let mut ai = ct_scan + 2
                let mut fidx = 0
                while ai < cp_c && fidx < vfields.length() {
                  if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
                  let mut ae = ai
                  let mut ad = 0
                  while ae < cp_c {
                    let ak = tokens[ae].kind
                    if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
                    else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
                    else if ad == 0 && ak == TokenKind::Comma { break }
                    ae = ae + 1
                  }
                  if ae == ai + 1 && tokens[ai].kind == TokenKind::Ident && tokens[ai].raw != "_" {
                    let fty = vfields[fidx].ty
                    if fty.length() > 0 {
                      ctx.scope_vars.push(ScopeVar::{
                        name: resolve_ident_in_scope(ctx, tokens[ai].raw),
                        ty: fty,
                        is_mut: false,
                        is_boxed: false,
                      })
                    }
                  }
                  fidx = fidx + 1
                  ai = ae + 1
                }
              }
              None => ()
            }
          }
        }
      }
      ct_scan = ct_scan + 1
    }
    // P0-2: Block outer match's array element cache while lowering arm guard & body so nested matches never read outer cache!
    ctx.match_arr_cache_ctor.push("__BLOCKED__")
    ctx.match_arr_cache_elems.push(Map())
    ctx.match_arr_cache_suffix.push(Map())
    ctx.match_arr_cache_len.push("")
    let guard_str = if if_idx >= 0 {
      lower_expr_range(ctx, tokens, if_idx + 1, fa, file, false).trim()
    } else {
      ""
    }

    // Parse body first so special pattern lowerings can wrap it cleanly!
    let body_start = fa + 1
    let mut body_raw = ""
    let mut next_i = body_start
    if body_start < end && tokens[body_start].kind == TokenKind::LBrace {
      let (blk, ni) = lower_one_token_or_form(ctx, tokens, body_start, end, file, false)
      body_raw = blk
      next_i = ni
    } else if body_start < end && tokens[body_start].kind == TokenKind::Keyword &&
    (tokens[body_start].raw == "for" || tokens[body_start].raw == "while") {
      let body_end = find_expr_end(tokens, body_start, end)
      let inner_b = lower_expr_range(ctx, tokens, body_start, body_end, file, false).trim()
      body_raw = tokens[body_start].leading_trivia + "{ " + inner_b + " }"
      next_i = body_end
    } else {
      let body_end = find_expr_end(tokens, body_start, end)
      body_raw = lower_expr_range(ctx, tokens, body_start, body_end, file, false)
      next_i = body_end
    }
    let _ = ctx.match_arr_cache_ctor.pop()
    let _ = ctx.match_arr_cache_elems.pop()
    let _ = ctx.match_arr_cache_suffix.pop()
    let _ = ctx.match_arr_cache_len.pop()
    restore_scope_vars(ctx, saved_arm_sc)
    let mut trail_sep = ""
    if next_i < end && (tokens[next_i].kind == TokenKind::Comma || tokens[next_i].kind == TokenKind::Semi) {
      trail_sep = tokens[next_i].leading_trivia + tokens[next_i].raw
      next_i = next_i + 1
    }

    push_expected_type(ctx, scrut_ty)
    let lead_triv = tokens[i].leading_trivia
    let mut handled_special = false

    // Special case B3 (P1-2): top-level struct pattern `{ f1, f2: pat, .. }` or `S::{ f1, f2: pat, .. }`
    // Pion does not support struct patterns in `match`, so lower to a hygienic binding `sp` with
    // `rename_struct_field` field accesses and collision-free local binders (`val` -> `val_1`, `val_` -> `val_`).
    let mut sp_open_b = -1
    let mut sp_explicit_sname = ""
    if !handled_special && tokens[i].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i)
      if cb == pat_end - 1 {
        sp_open_b = i
      }
    } else if !handled_special && i + 2 < pat_end && tokens[i].kind == TokenKind::UpperIdent &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::LBrace {
      let cb = find_matching_delim(tokens, i + 2)
      if cb == pat_end - 1 {
        sp_open_b = i + 2
        sp_explicit_sname = tokens[i].raw
      }
    }
    if !handled_special && sp_open_b >= 0 {
      let cb = find_matching_delim(tokens, sp_open_b)
      // Resolve struct name: explicit `S::` > `scrut_ty` > unique field-set superset in `ctx.struct_field_renames`
      let mut resolved_sname = sp_explicit_sname
      if resolved_sname.length() == 0 {
        let sc = strip_type_args_sym(scrut_ty)
        if sc.length() > 0 && ctx.struct_field_renames.contains(sc) {
          resolved_sname = sc
        }
      }
      if resolved_sname.length() == 0 {
        let mentioned : Array[String] = []
        let mut mf = sp_open_b + 1
        while mf < cb {
          if tokens[mf].kind == TokenKind::Comma || tokens[mf].kind == TokenKind::DotDot { mf = mf + 1; continue }
          let mut mfe = mf
          let mut mfd = 0
          while mfe < cb {
            let mfk = tokens[mfe].kind
            if mfk == TokenKind::LParen || mfk == TokenKind::LBracket || mfk == TokenKind::LBrace { mfd = mfd + 1 }
            else if mfk == TokenKind::RParen || mfk == TokenKind::RBracket || mfk == TokenKind::RBrace { mfd = mfd - 1 }
            else if mfd == 0 && mfk == TokenKind::Comma { break }
            mfe = mfe + 1
          }
          if tokens[mf].kind == TokenKind::Ident || tokens[mf].kind == TokenKind::Keyword {
            mentioned.push(tokens[mf].raw)
          }
          mf = mfe + 1
        }
        if mentioned.length() > 0 {
          let mut match_cnt = 0
          let mut match_name = ""
          for cand_s in ctx.struct_field_renames.keys() {
            match ctx.struct_field_renames.get(cand_s) {
              Some(rmap) => {
                let mut all_ok = true
                for fraw in mentioned {
                  if !rmap.contains(fraw) { all_ok = false; break }
                }
                if all_ok {
                  match_cnt = match_cnt + 1
                  match_name = cand_s
                }
              }
              None => ()
            }
          }
          if match_cnt == 1 {
            resolved_sname = match_name
          }
        }
      }
      let bind_var = fresh_temp(ctx, "sp")
      let non_bind_guards : Array[String] = []
      let bind_fields : Array[(String, String)] = []
      let mut fi = sp_open_b + 1
      while fi < cb {
        if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot { fi = fi + 1; continue }
        let mut fe = fi
        let mut fd = 0
        while fe < cb {
          let fk = tokens[fe].kind
          if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
          else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
          else if fd == 0 && fk == TokenKind::Comma { break }
          fe = fe + 1
        }
        let raw_f = tokens[fi].raw
        let access_f = if resolved_sname.length() > 0 {
          rename_struct_field(ctx, resolved_sname, raw_f)
        } else if raw_f == "val" {
          alloc_fresh_val_placeholder(ctx, tokens[fi].line, tokens[fi].col)
        } else {
          rename_keyword_ident(raw_f)
        }
        let fexpr = bind_var + "." + access_f
        if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
        fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
          let vs = fi + 2
          let mut has_binder = false
          let mut bi = vs
          while bi < fe {
            if tokens[bi].kind == TokenKind::Ident &&
            !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
            !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
              has_binder = true
            }
            bi = bi + 1
          }
          if has_binder {
            let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
            bind_fields.push((fexpr, pat_s))
          } else if vs < fe {
            let vt = tokens[vs]
            if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
              vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
              non_bind_guards.push(fexpr + " == " + vt.raw)
            } else {
              let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
              if ps != "_" {
                non_bind_guards.push("(" + fexpr + " is " + ps + ")")
              }
            }
          }
        } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
          let local_b = resolve_ident_in_scope(ctx, raw_f)
          bind_fields.push((fexpr, local_b))
        }
        fi = fe + 1
      }
      let nbg_sb = StringBuilder()
      let mut ni = 0
      while ni < non_bind_guards.length() {
        if ni > 0 { nbg_sb.write_string(" && ") }
        nbg_sb.write_string(non_bind_guards[ni])
        ni = ni + 1
      }
      let fguards = nbg_sb.to_string()
      if bind_fields.length() > 0 {
        let mut all_irrefutable = true
        for bf in bind_fields {
          if !is_irrefutable_simple_pat(bf.1) {
            all_irrefutable = false
            break
          }
        }
        let scrut_e = if bind_fields.length() == 1 {
          bind_fields[0].0
        } else {
          let es : Array[String] = []
          for bf in bind_fields { es.push(bf.0) }
          "(" + join_comma(es) + ")"
        }
        let pat_e = if bind_fields.length() == 1 {
          bind_fields[0].1
        } else {
          let ps : Array[String] = []
          for bf in bind_fields { ps.push(bf.1) }
          "(" + join_comma(ps) + ")"
        }
        if all_irrefutable && fguards.length() == 0 && guard_str.length() == 0 {
          has_unguarded_catchall = true
          sb.write_string(lead_triv + bind_var + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep)
        } else {
          had_guarded_struct_arm = true
          let guard_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          let match_g = "(match " + scrut_e + " { " + pat_e + " => " + guard_rhs + ", _ => false })"
          let full_g = if fguards.length() > 0 { "(" + fguards + ") && " + match_g } else { match_g }
          sb.write_string(lead_triv + bind_var + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep)
        }
      } else {
        let full_g = if fguards.length() > 0 && guard_str.length() > 0 {
          "(" + fguards + ") && (" + guard_str + ")"
        } else if fguards.length() > 0 {
          fguards
        } else {
          guard_str
        }
        let g_part = if full_g.length() > 0 {
          had_guarded_struct_arm = true
          " if " + full_g
        } else {
          has_unguarded_catchall = true
          ""
        }
        sb.write_string(lead_triv + bind_var + g_part + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
      }
      handled_special = true
    }

    // Special case A: top-level `<Pat> as <name>` -> `<name> if (<name> is <Pat>) [&& (guard)] => body`
    if top_as_idx > i && top_as_idx + 1 < pat_end {
      let as_name = resolve_ident_in_scope(ctx, tokens[top_as_idx + 1].raw)
      let inner_pat = lower_expr_range(ctx, tokens, i, top_as_idx, file, true).trim()
      let full_guard = if guard_str.length() > 0 {
        "(" + as_name + " is " + inner_pat + ") && (" + guard_str + ")"
      } else {
        as_name + " is " + inner_pat
      }
      sb.write_string(lead_triv + as_name + " if " + full_guard + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
      handled_special = true
    }

    // Special case B2: Tuple struct pattern `TupleStruct(p0, p1, ...) [if guard] => body`
    // Pion does not support struct patterns (`Pair::{ _0: 1, _1: n }`), so lower to a hygienic
    // binding `__ts` with an outer `if` guard + inner `match` over `(__ts._0, __ts._1, ...)`.
    if !handled_special && i + 1 < pat_end && tokens[i].kind == TokenKind::UpperIdent &&
    ctx.symtab.tuple_structs.contains(tokens[i].raw) && tokens[i + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i + 1)
      if cp == pat_end - 1 {
        let sub_pats : Array[String] = []
        let sub_ranges : Array[(Int, Int)] = []
        let mut has_array_subpat = false
        let mut all_irrefutable = true
        let mut bad_rest = false
        let mut saw_rest = false
        let mut pi = i + 2
        while pi < cp {
          if tokens[pi].kind == TokenKind::Comma { pi = pi + 1; continue }
          if tokens[pi].kind == TokenKind::DotDot {
            saw_rest = true
            pi = pi + 1
            continue
          }
          if saw_rest {
            bad_rest = true
          }
          let mut pe = pi
          let mut pd = 0
          while pe < cp {
            let pk = tokens[pe].kind
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
            else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
            else if pd == 0 && pk == TokenKind::Comma { break }
            pe = pe + 1
          }
          if pe > pi {
            if tokens[pi].kind == TokenKind::LBracket && find_matching_delim(tokens, pi) == pe - 1 {
              has_array_subpat = true
            }
            let ps = lower_expr_range(ctx, tokens, pi, pe, file, true).trim()
            sub_pats.push(ps)
            sub_ranges.push((pi, pe))
            if !(pe == pi + 1 && (tokens[pi].kind == TokenKind::Ident || tokens[pi].kind == TokenKind::Underscore)) {
              all_irrefutable = false
            }
          }
          pi = pe + 1
        }
        if bad_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "non-trailing `..` rest pattern in tuple struct `" + tokens[i].raw + "` is not supported",
          ))
        }
        let ts_var = fresh_temp(ctx, "ts")
        if has_array_subpat {
          // Astra P1-2: Option-threading lowering for nested array sub-patterns inside tuple structs;
          // binds array elements ONCE before guard so guard mutations cannot corrupt bound values!
          let len_checks : Array[String] = []
          let flat_exprs : Array[String] = []
          let flat_pats : Array[String] = []
          let mut k = 0
          while k < sub_ranges.length() {
            let sr = sub_ranges[k]
            let field_e = ts_var + "._" + k.to_string()
            if tokens[sr.0].kind == TokenKind::LBracket && find_matching_delim(tokens, sr.0) == sr.1 - 1 {
              let cbr = sr.1 - 1
              let elems : Array[String] = []
              let mut has_trailing_rest = false
              let mut seen_rest = false
              let mut invalid_rest = false
              let mut ei = sr.0 + 1
              while ei < cbr {
                if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
                let mut ee = ei
                let mut ed = 0
                while ee < cbr {
                  let ek = tokens[ee].kind
                  if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
                  else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
                  else if ed == 0 && ek == TokenKind::Comma { break }
                  ee = ee + 1
                }
                if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
                  if seen_rest {
                    invalid_rest = true
                  } else {
                    seen_rest = true
                    has_trailing_rest = true
                  }
                } else if ee > ei {
                  if seen_rest {
                    invalid_rest = true
                  }
                  elems.push(lower_expr_range(ctx, tokens, ei, ee, file, true).trim())
                }
                ei = ee + 1
              }
              if invalid_rest {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  file,
                  tokens[sr.0].line,
                  tokens[sr.0].col,
                  "array rest pattern `..` is only supported at the end of an array pattern",
                ))
              }
              let len_op = if has_trailing_rest { " >= " } else { " == " }
              len_checks.push(field_e + ".length()" + len_op + elems.length().to_string())
              let mut j = 0
              while j < elems.length() {
                flat_exprs.push(field_e + "[" + j.to_string() + "]")
                flat_pats.push(elems[j])
                j = j + 1
              }
            } else {
              flat_exprs.push(field_e)
              flat_pats.push(sub_pats[k])
            }
            k = k + 1
          }
          let lc_sb = StringBuilder()
          let mut li = 0
          while li < len_checks.length() {
            if li > 0 { lc_sb.write_string(" && ") }
            lc_sb.write_string(len_checks[li])
            li = li + 1
          }
          let g_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          let inner_opt = if flat_exprs.length() == 0 {
            "if " + lc_sb.to_string() + " && " + g_rhs + " { Some(" + body_raw.trim() + ") } else { None }"
          } else {
            let scrut_f = if flat_exprs.length() == 1 { flat_exprs[0] } else { "(" + join_comma(flat_exprs) + ")" }
            let pat_f = if flat_pats.length() == 1 { flat_pats[0] } else { "(" + join_comma(flat_pats) + ")" }
            "if " + lc_sb.to_string() + " { match " + scrut_f + " { " + pat_f + " => if " + g_rhs + " { Some(" + body_raw.trim() + ") } else { None }, _ => None } } else { None }"
          }
          let res_var = fresh_temp(ctx, "tsr")
          let rest_arms = if next_i < end {
            lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
          } else {
            ""
          }
          let none_arm = if rest_arms.length() > 0 {
            "match " + ts_var + " { " + rest_arms + " }"
          } else {
            "panic(\"unreachable\")"
          }
          sb.write_string(
            lead_triv + ts_var + tokens[fa].leading_trivia + "=> match (" + inner_opt + ") { Some(" + res_var + ") => " + res_var + ", None => " + none_arm + " }" + trail_sep,
          )
          pop_expected_type(ctx)
          break
        } else if sub_pats.length() == 0 {
          if guard_str.length() > 0 {
            sb.write_string(lead_triv + ts_var + " if " + guard_str + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
          } else {
            sb.write_string(lead_triv + ts_var + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
          }
        } else if all_irrefutable && guard_str.length() == 0 {
          let bind_sb = StringBuilder()
          let mut k = 0
          while k < sub_pats.length() {
            if sub_pats[k] != "_" {
              bind_sb.write_string("let " + sub_pats[k] + " = " + ts_var + "._" + k.to_string() + "; ")
            }
            k = k + 1
          }
          sb.write_string(lead_triv + ts_var + tokens[fa].leading_trivia + "=> { " + bind_sb.to_string() + body_raw.trim() + " }" + trail_sep)
        } else {
          let f_exprs : Array[String] = []
          let mut k = 0
          while k < sub_pats.length() {
            f_exprs.push(ts_var + "._" + k.to_string())
            k = k + 1
          }
          let scrut_f = if f_exprs.length() == 1 { f_exprs[0] } else { "(" + join_comma(f_exprs) + ")" }
          let pat_f = if sub_pats.length() == 1 { sub_pats[0] } else { "(" + join_comma(sub_pats) + ")" }
          let g_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          sb.write_string(
            lead_triv + ts_var + " if (match " + scrut_f + " { " + pat_f + " => " + g_rhs + ", _ => false })" +
            tokens[fa].leading_trivia + "=> match " + scrut_f + " { " + pat_f + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep,
          )
        }
        handled_special = true
      }
    }

    // Special case B: `Ctor({ ... } [as x])` struct pattern inside constructor pattern
    // Preserves ALL non-binding field guards AND ALL binding fields (0/1/2/N, order-independent),
    // and evaluates structure match + arm `guard_str` together inside the outer `if` guard so
    // guard failure falls through cleanly to the next arm!
    let mut bc_lp = -1
    if !handled_special && i + 1 < pat_end && tokens[i].kind == TokenKind::UpperIdent && tokens[i + 1].kind == TokenKind::LParen {
      bc_lp = i + 1
    } else if !handled_special && i + 3 < pat_end && tokens[i].kind == TokenKind::UpperIdent &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::UpperIdent &&
    tokens[i + 3].kind == TokenKind::LParen {
      bc_lp = i + 3
    }
    if bc_lp > i {
      let cp = find_matching_delim(tokens, bc_lp)
      if cp == pat_end - 1 && bc_lp + 1 < cp && tokens[bc_lp + 1].kind == TokenKind::LBrace {
        let cb = find_matching_delim(tokens, bc_lp + 1)
        let ctor_head = lower_expr_range(ctx, tokens, i, bc_lp, file, true).trim()
        let has_as = cb + 2 < cp && tokens[cb + 1].kind == TokenKind::Keyword && tokens[cb + 1].raw == "as"
        let bind_var = if has_as { rename_keyword_ident(tokens[cb + 2].raw) } else { fresh_temp(ctx, "sp") }
        let non_bind_guards : Array[String] = []
        let bind_fields : Array[(String, String)] = []
        let mut fi = bc_lp + 2
        while fi < cb {
          if tokens[fi].kind == TokenKind::Comma || tokens[fi].kind == TokenKind::DotDot { fi = fi + 1; continue }
          let mut fe = fi
          let mut fd = 0
          while fe < cb {
            let fk = tokens[fe].kind
            if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
            else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
            else if fd == 0 && fk == TokenKind::Comma { break }
            fe = fe + 1
          }
          if (tokens[fi].kind == TokenKind::Ident || tokens[fi].kind == TokenKind::Keyword) &&
          fi + 2 < fe && tokens[fi + 1].kind == TokenKind::Colon {
            let fname = rename_keyword_ident(tokens[fi].raw)
            let fexpr = bind_var + "." + fname
            let vs = fi + 2
            let mut has_binder = false
            let mut bi = vs
            while bi < fe {
              if tokens[bi].kind == TokenKind::Ident &&
              !(bi > vs && (tokens[bi - 1].kind == TokenKind::Dot || tokens[bi - 1].kind == TokenKind::ColonColon)) &&
              !(bi + 1 < fe && tokens[bi + 1].kind == TokenKind::Colon) {
                has_binder = true
              }
              bi = bi + 1
            }
            if has_binder {
              let pat_s = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
              bind_fields.push((fexpr, pat_s))
            } else if vs < fe && tokens[vs].kind == TokenKind::LBrace {
              let ncb = find_matching_delim(tokens, vs)
              let nested = lower_struct_pat_guards(ctx, fexpr, tokens, vs, ncb, file)
              if nested.length() > 0 { non_bind_guards.push(nested) }
            } else if vs < fe {
              let vt = tokens[vs]
              if vs + 1 == fe && (vt.kind == TokenKind::Keyword && (vt.raw == "true" || vt.raw == "false") ||
                vt.kind == TokenKind::IntLit || vt.kind == TokenKind::FloatLit || vt.kind == TokenKind::StringLit || vt.kind == TokenKind::CharLit) {
                non_bind_guards.push(fexpr + " == " + vt.raw)
              } else {
                let ps = lower_expr_range(ctx, tokens, vs, fe, file, true).trim()
                if ps != "_" {
                  non_bind_guards.push("(" + fexpr + " is " + ps + ")")
                }
              }
            }
          } else if tokens[fi].kind == TokenKind::Ident && fe == fi + 1 {
            // Shorthand field binder `{ x, .. }` -> binds `x` to `bind_var.x`
            let fname = rename_keyword_ident(tokens[fi].raw)
            bind_fields.push((bind_var + "." + fname, fname))
          } else {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[fi].line,
              tokens[fi].col,
              "unsupported field pattern inside constructor struct pattern",
            ))
          }
          fi = fe + 1
        }
        let nbg_sb = StringBuilder()
        let mut ni = 0
        while ni < non_bind_guards.length() {
          if ni > 0 { nbg_sb.write_string(" && ") }
          nbg_sb.write_string(non_bind_guards[ni])
          ni = ni + 1
        }
        let fguards = nbg_sb.to_string()
        if bind_fields.length() > 0 {
          let scrut_e = if bind_fields.length() == 1 {
            bind_fields[0].0
          } else {
            let es : Array[String] = []
            for bf in bind_fields { es.push(bf.0) }
            "(" + join_comma(es) + ")"
          }
          let pat_e = if bind_fields.length() == 1 {
            bind_fields[0].1
          } else {
            let ps : Array[String] = []
            for bf in bind_fields { ps.push(bf.1) }
            "(" + join_comma(ps) + ")"
          }
          let guard_rhs = if guard_str.length() > 0 { "(" + guard_str + ")" } else { "true" }
          let match_g = "(match " + scrut_e + " { " + pat_e + " => " + guard_rhs + ", _ => false })"
          let full_g = if fguards.length() > 0 { "(" + fguards + ") && " + match_g } else { match_g }
          sb.write_string(lead_triv + ctor_head + "(" + bind_var + ") if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_raw.trim() + ", _ => panic(\"unreachable\") }" + trail_sep)
        } else {
          let full_g = if fguards.length() > 0 && guard_str.length() > 0 {
            "(" + fguards + ") && (" + guard_str + ")"
          } else if fguards.length() > 0 {
            fguards
          } else {
            guard_str
          }
          let g_suffix = if full_g.length() > 0 { " if " + full_g } else { "" }
          sb.write_string(lead_triv + ctor_head + "(" + bind_var + ")" + g_suffix + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
        }
        handled_special = true
      }
    }

    // Special case D: top-level array pattern `[]`, `[one]`, `[.., last]`, `[a, .. as mid, z]` (and optional `as whole`)
    if !handled_special && tokens[i].kind == TokenKind::LBracket {
      let cbr = find_matching_delim(tokens, i)
      let has_as = cbr + 2 == pat_end - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
      if cbr == pat_end - 1 || has_as {
        let scrut_clean = strip_type_args_sym(scrut_ty)
        if scrut_clean == "String" || scrut_clean == "Bytes" {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "array pattern matching on `" + scrut_clean + "` is not supported (only Array/FixedArray/ArrayView)",
          ))
        }
        let is_proven_arr = scrut_clean == "Array" || scrut_clean == "FixedArray" ||
        scrut_clean == "ArrayView" || scrut_clean == "mbt_compat::ArrayView" ||
        scrut_clean == "ArrayBuf" || scrut_clean == "mbt_compat::ArrayBuf"
        let mut has_rest = false
        let mut rest_as_var = ""
        let mut seen_rest = false
        let mut invalid_rest = false
        let prefix_pats : Array[String] = []
        let suffix_pats : Array[String] = []
        let mut ei = i + 1
        while ei < cbr {
          if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
          let mut ee = ei
          let mut ed = 0
          while ee < cbr {
            let ek = tokens[ee].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
            else if ed == 0 && ek == TokenKind::Comma { break }
            ee = ee + 1
          }
          if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
            }
          } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
          tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
          (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
            if seen_rest {
              invalid_rest = true
            } else {
              seen_rest = true
              has_rest = true
              if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
              }
            }
          } else if ee > ei {
            let lp = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
            if seen_rest { suffix_pats.push(lp) } else { prefix_pats.push(lp) }
          }
          ei = ee + 1
        }
        if invalid_rest {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            file,
            tokens[i].line,
            tokens[i].col,
            "array pattern cannot contain more than one `..` rest pattern",
          ))
          handled_special = true
        } else {
          let arr_var = if has_as { rename_keyword_ident(tokens[cbr + 2].raw) } else { fresh_temp(ctx, "ap") }
          let min_len = prefix_pats.length() + suffix_pats.length()
          let len_op = if has_rest { " >= " } else { " == " }
          let cache_hit_top = ctx.match_arr_cache_ctor.length() > 0 &&
          ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == ""
          let cached_len_top : String = if cache_hit_top && ctx.match_arr_cache_len.length() > 0 {
            ctx.match_arr_cache_len[ctx.match_arr_cache_len.length() - 1]
          } else {
            ""
          }
          let live_len_expr = if is_proven_arr { arr_var + ".length()" } else { "mbt_compat::__mbt_arrpat_len(" + arr_var + ")" }
          let len_lhs_top = if cached_len_top.length() > 0 { cached_len_top } else { live_len_expr }
          let len_cond = len_lhs_top + len_op + min_len.to_string()
          let rest_end_expr = if suffix_pats.length() == 0 {
            arr_var + ".length()"
          } else {
            arr_var + ".length() - " + suffix_pats.length().to_string()
          }
          let rest_tmp_var = if rest_as_var.length() > 0 { fresh_temp(ctx, "rb") } else { "" }
          let rest_eval_prefix = if rest_as_var.length() > 0 {
            "let " + rest_tmp_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
          } else {
            ""
          }
          let rest_rebind_prefix = if rest_as_var.length() > 0 {
            "let " + rest_as_var + " = " + rest_tmp_var + "; "
          } else {
            ""
          }
          let rest_bind_prefix = if rest_as_var.length() > 0 {
            "let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + prefix_pats.length().to_string() + ", " + rest_end_expr + "); "
          } else {
            ""
          }
          let body_with_rest = if rest_bind_prefix.length() > 0 {
            "{ " + rest_bind_prefix + body_raw.trim() + " }"
          } else {
            body_raw.trim()
          }
          if min_len == 0 {
            let full_g = if guard_str.length() > 0 {
              len_cond + " && (" + (if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }) + ")"
            } else {
              len_cond
            }
            sb.write_string(lead_triv + arr_var + " if " + full_g + tokens[fa].leading_trivia + "=> " + body_with_rest + trail_sep)
          } else {
            let cache_hit = ctx.match_arr_cache_ctor.length() > 0 &&
            ctx.match_arr_cache_ctor[ctx.match_arr_cache_ctor.length() - 1] == ""
            let cached_p : Map[Int, String] = if cache_hit {
              ctx.match_arr_cache_elems[ctx.match_arr_cache_elems.length() - 1]
            } else {
              Map()
            }
            let cached_s : Map[Int, String] = if cache_hit && ctx.match_arr_cache_suffix.length() > 0 {
              ctx.match_arr_cache_suffix[ctx.match_arr_cache_suffix.length() - 1]
            } else {
              Map()
            }
            if guard_str.length() > 0 || suffix_pats.length() > 0 || rest_as_var.length() > 0 || cached_p.length() > 0 || cached_s.length() > 0 {
              let res_var = fresh_temp(ctx, "apr")
              let ext_p : Map[Int, String] = Map()
              for k in cached_p.keys() {
                match cached_p.get(k) { Some(v) => ext_p[k] = v, None => () }
              }
              let ext_s : Map[Int, String] = Map()
              for k in cached_s.keys() {
                match cached_s.get(k) { Some(v) => ext_s[k] = v, None => () }
              }
              let bind_sb = StringBuilder()
              let all_pats : Array[String] = []
              let all_exprs : Array[String] = []
              let mut bi = 0
              while bi < prefix_pats.length() {
                all_pats.push(prefix_pats[bi])
                match ext_p.get(bi) {
                  Some(ev) => all_exprs.push(ev)
                  None => {
                    let el_v = fresh_temp(ctx, "el")
                    bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + bi.to_string() + "]; ")
                    ext_p[bi] = el_v
                    all_exprs.push(el_v)
                  }
                }
                bi = bi + 1
              }
              if suffix_pats.length() > 0 {
                let mut need_len_snap = false
                let mut si0 = 0
                while si0 < suffix_pats.length() {
                  if !ext_s.contains(suffix_pats.length() - si0) { need_len_snap = true; break }
                  si0 = si0 + 1
                }
                let len_snap = if need_len_snap {
                  let ls = fresh_temp(ctx, "ln")
                  bind_sb.write_string("let " + ls + " = " + arr_var + ".length(); ")
                  ls
                } else {
                  ""
                }
                let mut si = 0
                while si < suffix_pats.length() {
                  let dist = suffix_pats.length() - si
                  all_pats.push(suffix_pats[si])
                  match ext_s.get(dist) {
                    Some(prev_ev) => all_exprs.push(prev_ev)
                    None => {
                      let el_v = fresh_temp(ctx, "el")
                      bind_sb.write_string("let " + el_v + " = " + arr_var + "[" + len_snap + " - " + dist.to_string() + "]; ")
                      ext_s[dist] = el_v
                      all_exprs.push(el_v)
                    }
                  }
                  si = si + 1
                }
              }
              let el_scrut_e = if all_pats.length() == 1 { all_exprs[0] } else { "(" + join_comma(all_exprs) + ")" }
              let pat_e = if all_pats.length() == 1 { all_pats[0] } else { "(" + join_comma(all_pats) + ")" }
              let rest_uncached = if next_i < end {
                lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
              } else {
                ""
              }
              let none_uncached = if rest_uncached.length() > 0 {
                "match " + arr_var + " { " + rest_uncached + " }"
              } else {
                "panic(\"unreachable\")"
              }
              let next_cached_len_top = if cached_len_top.length() > 0 {
                cached_len_top
              } else if !has_rest {
                min_len.to_string()
              } else {
                ""
              }
              let none_cached = if guard_str.length() > 0 && next_i < end {
                ctx.match_arr_cache_ctor.push("")
                ctx.match_arr_cache_elems.push(ext_p)
                ctx.match_arr_cache_suffix.push(ext_s)
                ctx.match_arr_cache_len.push(next_cached_len_top)
                let rc = lower_match_arms_with_ty(ctx, tokens, next_i, end, file, scrut_ty).trim()
                let _ = ctx.match_arr_cache_ctor.pop()
                let _ = ctx.match_arr_cache_elems.pop()
                let _ = ctx.match_arr_cache_suffix.pop()
                let _ = ctx.match_arr_cache_len.pop()
                if rc.length() > 0 { "match " + arr_var + " { " + rc + " }" } else { "panic(\"unreachable\")" }
              } else {
                none_uncached
              }
              let inner_arm = if guard_str.length() > 0 {
                let g_arm = "if (" + guard_str + ") { Option::Some(" + body_raw.trim() + ") } else { Option::None }"
                if rest_rebind_prefix.length() > 0 { "{ " + rest_rebind_prefix + g_arm + " }" } else { g_arm }
              } else {
                if rest_rebind_prefix.length() > 0 {
                  "{ " + rest_rebind_prefix + "Option::Some(" + body_raw.trim() + ") }"
                } else {
                  "Option::Some(" + body_raw.trim() + ")"
                }
              }
              sb.write_string(
                lead_triv + arr_var + tokens[fa].leading_trivia + "=> if " + len_cond + " { " + bind_sb.to_string() + rest_eval_prefix + "match (match " + el_scrut_e + " { " + pat_e + " => " + inner_arm + ", _ => Option::None }) { Option::Some(" + res_var + ") => " + res_var + ", Option::None => " + none_cached + " } } else { " + none_uncached + " }" + trail_sep,
              )
              pop_expected_type(ctx)
              if pushed_arm_renames { let _ = ctx.ident_renames.pop() }
              break
            }
            let es : Array[String] = []
            let mut idx = 0
            while idx < prefix_pats.length() {
              es.push(arr_var + "[" + idx.to_string() + "]")
              idx = idx + 1
            }
            let scrut_e = if prefix_pats.length() == 1 { es[0] } else { "(" + join_comma(es) + ")" }
            let pat_e = if prefix_pats.length() == 1 { prefix_pats[0] } else { "(" + join_comma(prefix_pats) + ")" }
            let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => true, _ => false })"
            sb.write_string(lead_triv + arr_var + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
          }
          handled_special = true
        }
      }
    }

    // Special case E (P1-3): Tuple pattern `(p0, p1, ...)` containing one or more nested array patterns
    // (e.g. `([_, _] as fs, _) => fs[1]` or `([a, b, .. as tail], x) if a > x => ...`).
    if !handled_special && tokens[i].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp == pat_end - 1 {
        let tup_ranges : Array[(Int, Int)] = []
        let mut has_nested_arr = false
        let mut ti = i + 1
        while ti < cp {
          if tokens[ti].kind == TokenKind::Comma { ti = ti + 1; continue }
          let mut te = ti
          let mut td = 0
          while te < cp {
            let tk = tokens[te].kind
            if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
            else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
            else if td == 0 && tk == TokenKind::Comma { break }
            te = te + 1
          }
          if te > ti {
            tup_ranges.push((ti, te))
            if tokens[ti].kind == TokenKind::LBracket {
              let cbr = find_matching_delim(tokens, ti)
              let has_as = cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
              if cbr == te - 1 || has_as {
                has_nested_arr = true
              }
            }
          }
          ti = te + 1
        }
        if has_nested_arr && tup_ranges.length() >= 2 {
          // Extract tuple scrutinee element types if `scrut_ty` is `(T0, T1, ...)` for String/Bytes rejection.
          let scrut_elem_tys : Array[String] = []
          let st_trim = scrut_ty.trim()
          if st_trim.starts_with("(") && st_trim.ends_with(")") {
            let inner_st = st_trim.slice(1, st_trim.length() - 1)
            let mut si = 0
            let mut sstart = 0
            let mut sd = 0
            while si < inner_st.length() {
              let ch = inner_st.code_unit_at(si)
              if ch == 40 || ch == 91 || ch == 123 { sd = sd + 1 }
              else if ch == 41 || ch == 93 || ch == 125 { if sd > 0 { sd = sd - 1 } }
              else if sd == 0 && ch == 44 {
                scrut_elem_tys.push(inner_st.slice(sstart, si).trim())
                sstart = si + 1
              }
              si = si + 1
            }
            scrut_elem_tys.push(inner_st.slice(sstart, inner_st.length()).trim())
          }
          let outer_pats : Array[String] = []
          let len_conds : Array[String] = []
          let rest_binds_sb = StringBuilder()
          let el_exprs : Array[String] = []
          let el_pats : Array[String] = []
          let mut invalid_rest = false
          let mut k = 0
          while k < tup_ranges.length() {
            let (ts, te) = tup_ranges[k]
            let is_arr_el = if tokens[ts].kind == TokenKind::LBracket {
              let cbr = find_matching_delim(tokens, ts)
              cbr == te - 1 || (cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as")
            } else {
              false
            }
            if is_arr_el {
              if k < scrut_elem_tys.length() {
                let ec = strip_type_args_sym(scrut_elem_tys[k])
                if ec == "String" || ec == "Bytes" {
                  ctx.diags.push(diag_error(
                    "MBT2PION_UNSUPPORTED_SYNTAX",
                    file,
                    tokens[ts].line,
                    tokens[ts].col,
                    "array pattern matching on `" + ec + "` is not supported (only Array/FixedArray/ArrayView)",
                  ))
                }
              }
              let cbr = find_matching_delim(tokens, ts)
              let has_as = cbr + 2 == te - 1 && tokens[cbr + 1].kind == TokenKind::Keyword && tokens[cbr + 1].raw == "as"
              let arr_var = if has_as { resolve_ident_in_scope(ctx, tokens[cbr + 2].raw) } else { fresh_temp(ctx, "ap") }
              outer_pats.push(arr_var)
              let mut has_trailing_rest = false
              let mut rest_as_var = ""
              let mut seen_rest = false
              let mut elem_cnt = 0
              let mut ei = ts + 1
              while ei < cbr {
                if tokens[ei].kind == TokenKind::Comma { ei = ei + 1; continue }
                let mut ee = ei
                let mut ed = 0
                while ee < cbr {
                  let ek = tokens[ee].kind
                  if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace { ed = ed + 1 }
                  else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace { ed = ed - 1 }
                  else if ed == 0 && ek == TokenKind::Comma { break }
                  ee = ee + 1
                }
                if ee == ei + 1 && tokens[ei].kind == TokenKind::DotDot {
                  if seen_rest { invalid_rest = true } else { seen_rest = true; has_trailing_rest = true }
                } else if ee == ei + 3 && tokens[ei].kind == TokenKind::DotDot &&
                tokens[ei + 1].kind == TokenKind::Keyword && tokens[ei + 1].raw == "as" &&
                (tokens[ei + 2].kind == TokenKind::Ident || tokens[ei + 2].kind == TokenKind::Underscore) {
                  if seen_rest {
                    invalid_rest = true
                  } else {
                    seen_rest = true
                    has_trailing_rest = true
                    if tokens[ei + 2].kind == TokenKind::Ident && tokens[ei + 2].raw != "_" {
                      rest_as_var = resolve_ident_in_scope(ctx, tokens[ei + 2].raw)
                    }
                  }
                } else if ee > ei {
                  if seen_rest { invalid_rest = true }
                  let ep = lower_expr_range(ctx, tokens, ei, ee, file, true).trim()
                  if ep != "_" {
                    el_exprs.push(arr_var + "[" + elem_cnt.to_string() + "]")
                    el_pats.push(ep)
                  }
                  elem_cnt = elem_cnt + 1
                }
                ei = ee + 1
              }
              let len_op = if has_trailing_rest { " >= " } else { " == " }
              len_conds.push(arr_var + ".length()" + len_op + elem_cnt.to_string())
              if rest_as_var.length() > 0 {
                rest_binds_sb.write_string("let " + rest_as_var + " = mbt_compat::__mbt_slice_borrow(" + arr_var + ", " + elem_cnt.to_string() + ", " + arr_var + ".length()); ")
              }
            } else {
              outer_pats.push(lower_expr_range(ctx, tokens, ts, te, file, true).trim())
            }
            k = k + 1
          }
          if invalid_rest {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              tokens[i].line,
              tokens[i].col,
              "array rest pattern `..` is only supported at the end of an array pattern",
            ))
            handled_special = true
          } else {
            let outer_pat = "(" + join_comma(outer_pats) + ")"
            let lc_sb = StringBuilder()
            let mut li = 0
            while li < len_conds.length() {
              if li > 0 { lc_sb.write_string(" && ") }
              lc_sb.write_string(len_conds[li])
              li = li + 1
            }
            let len_cond = lc_sb.to_string()
            let rest_bind_prefix = rest_binds_sb.to_string()
            let body_with_rest = if rest_bind_prefix.length() > 0 {
              "{ " + rest_bind_prefix + body_raw.trim() + " }"
            } else {
              body_raw.trim()
            }
            if el_pats.length() == 0 {
              let full_g = if guard_str.length() > 0 {
                len_cond + " && (" + (if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }) + ")"
              } else {
                len_cond
              }
              sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> " + body_with_rest + trail_sep)
            } else {
              let scrut_e = if el_exprs.length() == 1 { el_exprs[0] } else { "(" + join_comma(el_exprs) + ")" }
              let pat_e = if el_pats.length() == 1 { el_pats[0] } else { "(" + join_comma(el_pats) + ")" }
              if guard_str.length() > 0 {
                let guard_rhs = if rest_bind_prefix.length() > 0 { "{ " + rest_bind_prefix + guard_str + " }" } else { guard_str }
                let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => (" + guard_rhs + "), _ => false })"
                sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
              } else {
                let full_g = len_cond + " && (match " + scrut_e + " { " + pat_e + " => true, _ => false })"
                sb.write_string(lead_triv + outer_pat + " if " + full_g + tokens[fa].leading_trivia + "=> match " + scrut_e + " { " + pat_e + " => " + body_with_rest + ", _ => panic(\"unreachable\") }" + trail_sep)
              }
            }
            handled_special = true
          }
        }
      }
    }

    if !handled_special {
      let expanded = expand_nested_or_pat(ctx, tokens, i, pat_end, file)
      if guard_str.length() == 0 && expanded.length() == 1 && is_irrefutable_simple_pat(expanded[0]) {
        has_unguarded_catchall = true
      }
      let pat_sb = StringBuilder()
      let mut ei = 0
      while ei < expanded.length() {
        if ei > 0 { pat_sb.write_string(" | ") }
        pat_sb.write_string(expanded[ei])
        ei = ei + 1
      }
      let g_part = if guard_str.length() > 0 { " if " + guard_str } else { "" }
      sb.write_string(lead_triv + pat_sb.to_string() + g_part + tokens[fa].leading_trivia + "=>" + body_raw + trail_sep)
    }
    if pushed_arm_renames {
      let _ = ctx.ident_renames.pop()
    }
    pop_expected_type(ctx)
    i = next_i
  }
  if had_guarded_struct_arm && !has_unguarded_catchall {
    sb.write_string("\n    _ => panic(\"unreachable\")")
  }
  sb.to_string()
}

fn is_unsupported_error_kw(tk : Token) -> Bool {
  (tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident) &&
  (tk.raw == "raise" || tk.raw == "try" || tk.raw == "catch")
}

fn check_unsupported_error_tokens(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> Unit {
  let mut k = start
  while k < end {
    if is_unsupported_error_kw(tokens[k]) && !(k > 0 && tokens[k - 1].kind == TokenKind::Dot) {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tokens[k].line,
        tokens[k].col,
        "unsupported MoonBit error-handling syntax `" + tokens[k].raw + "` (requires explicit lowering or overlay)",
      ))
    }
    k = k + 1
  }
}

fn count_error_diags(diags : Array[Diag]) -> Int {
  let mut c = 0
  for d in diags {
    if d.severity == "error" {
      c = c + 1
    }
  }
  c
}

///| Split top-level comma-separated `#cfg(...)` arguments respecting nested `(...)` and `"..."`.
fn split_cfg_args(inner : String) -> Array[String] {
  let out : Array[String] = []
  let mut depth = 0
  let mut in_str = false
  let mut start = 0
  let mut i = 0
  let n = inner.length()
  while i < n {
    let c = inner.code_unit_at(i)
    if in_str {
      if c == 92 && i + 1 < n {
        i = i + 2
        continue
      }
      if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 40 {
      depth = depth + 1
    } else if c == 41 {
      if depth > 0 { depth = depth - 1 }
    } else if c == 44 && depth == 0 {
      out.push(inner.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  if start <= n {
    let last = inner.slice(start, n).trim()
    if last.length() > 0 {
      out.push(last)
    }
  }
  out
}

fn hex_digit_val(c : Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn sb_write_utf8_cp(sb : StringBuilder, cp : Int) -> Unit {
  if cp <= 127 {
    sb.write_byte(cp.to_byte())
  } else if cp <= 2047 {
    sb.write_byte((192 | (cp >> 6)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else if cp <= 65535 {
    sb.write_byte((224 | (cp >> 12)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  } else {
    sb.write_byte((240 | (cp >> 18)).to_byte())
    sb.write_byte((128 | ((cp >> 12) & 63)).to_byte())
    sb.write_byte((128 | ((cp >> 6) & 63)).to_byte())
    sb.write_byte((128 | (cp & 63)).to_byte())
  }
}

///| Strictly decode an RFC 8259 JSON double-quoted string literal (`\"`, `\\`, `\/`, `\b`, `\f`,
///| `\n`, `\r`, `\t`, and `\uHHHH` with UTF-16 surrogate-pair assembly). Fail-closed on any
///| non-JSON escape (`\'`, `\xHH`, `\u{...}`, etc.), truncated escape, unpaired surrogate,
///| or unescaped control character (< 0x20).
pub fn decode_mbt_string_lit(raw : String) -> Result[String, String] {
  let n = raw.length()
  if n < 2 || raw.code_unit_at(0) != 34 || raw.code_unit_at(n - 1) != 34 {
    return Err("unterminated string literal")
  }
  let sb = StringBuilder()
  let end = n - 1
  let mut i = 1
  while i < end {
    let b = raw.code_unit_at(i)
    if b < 32 {
      return Err("unescaped control character in string literal")
    }
    if b != 92 {
      sb.write_byte(b.to_byte())
      i = i + 1
      continue
    }
    i = i + 1
    if i >= end {
      return Err("truncated escape sequence in string literal")
    }
    let esc = raw.code_unit_at(i)
    if esc == 34 {
      sb.write_byte(34.to_byte())
      i = i + 1
    } else if esc == 92 {
      sb.write_byte(92.to_byte())
      i = i + 1
    } else if esc == 47 {
      sb.write_byte(47.to_byte())
      i = i + 1
    } else if esc == 110 {
      sb.write_byte(10.to_byte())
      i = i + 1
    } else if esc == 114 {
      sb.write_byte(13.to_byte())
      i = i + 1
    } else if esc == 116 {
      sb.write_byte(9.to_byte())
      i = i + 1
    } else if esc == 98 {
      sb.write_byte(8.to_byte())
      i = i + 1
    } else if esc == 102 {
      sb.write_byte(12.to_byte())
      i = i + 1
    } else if esc == 117 {
      if i + 4 >= end {
        return Err("truncated \\uHHHH escape in string literal")
      }
      let d1 = hex_digit_val(raw.code_unit_at(i + 1))
      let d2 = hex_digit_val(raw.code_unit_at(i + 2))
      let d3 = hex_digit_val(raw.code_unit_at(i + 3))
      let d4 = hex_digit_val(raw.code_unit_at(i + 4))
      if d1 < 0 || d2 < 0 || d3 < 0 || d4 < 0 {
        return Err("invalid hex digit in \\uHHHH escape")
      }
      let cp = (d1 << 12) | (d2 << 8) | (d3 << 4) | d4
      if cp >= 56320 && cp <= 57343 {
        return Err("unpaired UTF-16 surrogate escape")
      }
      if cp >= 55296 && cp <= 56319 {
        if i + 10 >= end || raw.code_unit_at(i + 5) != 92 || raw.code_unit_at(i + 6) != 117 {
          return Err("unpaired UTF-16 surrogate escape")
        }
        let l1 = hex_digit_val(raw.code_unit_at(i + 7))
        let l2 = hex_digit_val(raw.code_unit_at(i + 8))
        let l3 = hex_digit_val(raw.code_unit_at(i + 9))
        let l4 = hex_digit_val(raw.code_unit_at(i + 10))
        if l1 < 0 || l2 < 0 || l3 < 0 || l4 < 0 {
          return Err("invalid hex digit in low surrogate \\uHHHH escape")
        }
        let lo = (l1 << 12) | (l2 << 8) | (l3 << 4) | l4
        if lo < 56320 || lo > 57343 {
          return Err("unpaired UTF-16 surrogate escape")
        }
        let full_cp = 65536 + ((cp - 55296) << 10) + (lo - 56320)
        sb_write_utf8_cp(sb, full_cp)
        i = i + 11
      } else {
        sb_write_utf8_cp(sb, cp)
        i = i + 5
      }
    } else {
      return Err("unrecognized escape sequence in string literal")
    }
  }
  Ok(sb.to_string())
}

///| Canonical single MoonBit source backend selected for a Pion target:
///|   - `native` -> `"native"`
///|   - `wasm32` -> `"wasm-gc"`
///| Shared by BOTH `#cfg(target=...)` declaration evaluation and `moon.pkg` file-target rules.
pub fn moon_source_backend_for_target(pion_target : String) -> String {
  if pion_target == "native" {
    "native"
  } else if pion_target == "wasm32" {
    "wasm-gc"
  } else {
    pion_target
  }
}

///| Statically evaluate a `#cfg(...)` inner boolean expression for `pion_target` (#12a P1-1).
///| Supports `target="native"|"wasm"|"wasm-gc"|"js"|"llvm"`, `any(...)`, `all(...)`, `not(...)`.
///| Returns `None` on any unknown/complex predicate (must fail-loud with `MBT2PION_UNSUPPORTED_CFG`!).
fn eval_cfg_expr(raw : String, pion_target : String) -> Option[Bool] {
  let s = raw.trim()
  if s.length() == 0 {
    return None
  }
  if s.starts_with("not(") && s.ends_with(")") {
    match eval_cfg_expr(s.slice(4, s.length() - 1), pion_target) {
      Some(b) => return Some(!b)
      None => return None
    }
  }
  if s.starts_with("any(") && s.ends_with(")") {
    let parts = split_cfg_args(s.slice(4, s.length() - 1))
    if parts.length() == 0 {
      return None
    }
    let mut any_true = false
    for p in parts {
      match eval_cfg_expr(p, pion_target) {
        Some(b) => if b { any_true = true }
        None => return None
      }
    }
    return Some(any_true)
  }
  if s.starts_with("all(") && s.ends_with(")") {
    let parts = split_cfg_args(s.slice(4, s.length() - 1))
    if parts.length() == 0 {
      return None
    }
    let mut all_true = true
    for p in parts {
      match eval_cfg_expr(p, pion_target) {
        Some(b) => if !b { all_true = false }
        None => return None
      }
    }
    return Some(all_true)
  }
  let eq_i = s.index_of("=")
  if eq_i > 0 {
    let lhs = s.slice(0, eq_i).trim()
    let rhs = s.slice(eq_i + 1, s.length()).trim()
    if lhs == "target" && rhs.length() >= 2 && rhs.starts_with("\"") && rhs.ends_with("\"") {
      let tv = rhs.slice(1, rhs.length() - 1)
      if tv == "native" || tv == "wasm" || tv == "wasm-gc" || tv == "js" || tv == "llvm" {
        return Some(tv == moon_source_backend_for_target(pion_target))
      }
    }
  }
  None
}

///| Lower a type token range while scanning for unsupported MoonBit error tokens (`raise`/`noraise`).
fn lower_type_tokens_checked(
  ctx : StageAContext,
  tokens : Array[Token],
  start : Int,
  end : Int,
  file : String,
) -> String {
  check_unsupported_error_tokens(ctx, tokens, start, end, file)
  lower_type_tokens(tokens, start, end, ctx.symtab, ctx.recipes)
}

///| Statically evaluate a `#cfg(...)` attribute against `pion_target`.
pub fn eval_cfg_attr(raw_attr : String, pion_target : String) -> Option[Bool] {
  let s = raw_attr.trim()
  if !s.starts_with("#cfg(") || !s.ends_with(")") {
    return None
  }
  eval_cfg_expr(s.slice(5, s.length() - 1), pion_target)
}

///| Return true if token `k` starts a new top-level declaration.
fn is_top_level_decl_start(tokens : Array[Token], k : Int) -> Bool {
  let tk = tokens[k]
  if tk.kind == TokenKind::Attr {
    return true
  }
  if tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident {
    let r = tk.raw
    return r == "pub" || r == "priv" || r == "fn" || r == "struct" || r == "enum" ||
    r == "let" || r == "const" || r == "type" || r == "trait" || r == "impl" ||
    r == "test" || r == "extern" || r == "async" || r == "typealias" || r == "fnalias" ||
    r == "suberror" || r == "using"
  }
  false
}

///| Skip one complete top-level declaration starting at `start_i` (after leading `#` attributes).
fn skip_top_level_decl(tokens : Array[Token], start_i : Int, n : Int) -> Int {
  let mut i = start_i
  if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::LParen {
      i = find_matching_delim(tokens, i) + 1
    }
  } else if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "async" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "extern" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::StringLit {
      i = i + 1
    }
  }
  if i >= n {
    return n
  }
  let kw = tokens[i]
  let is_kw = kw.kind == TokenKind::Keyword || kw.kind == TokenKind::Ident
  if is_kw && (kw.raw == "let" || kw.raw == "const") {
    let mut eq_i = i + 1
    let mut depth = 0
    while eq_i < n {
      let ek = tokens[eq_i].kind
      if depth == 0 && tokens[eq_i].newline_before && is_top_level_decl_start(tokens, eq_i) {
        return eq_i
      }
      if depth == 0 && ek == TokenKind::Eq {
        return find_expr_end(tokens, eq_i + 1, n)
      }
      if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
        depth = depth + 1
      } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      }
      eq_i = eq_i + 1
    }
    return eq_i
  }
  if is_kw && (kw.raw == "struct" || kw.raw == "enum" || kw.raw == "suberror") {
    let mut k = i + 1
    if k < n && (tokens[k].kind == TokenKind::UpperIdent || tokens[k].kind == TokenKind::Ident) {
      k = k + 1
    }
    if k < n && tokens[k].kind == TokenKind::LBracket {
      k = find_matching_delim(tokens, k) + 1
    }
    if k < n && tokens[k].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k) + 1
    } else if k < n && tokens[k].kind == TokenKind::LBrace {
      k = find_matching_delim(tokens, k) + 1
    }
    if k < n && (tokens[k].kind == TokenKind::Keyword || tokens[k].kind == TokenKind::Ident) &&
    tokens[k].raw == "derive" && k + 1 < n && tokens[k + 1].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k + 1) + 1
    }
    return k
  }
  if is_kw && (kw.raw == "fn" || kw.raw == "impl" || kw.raw == "test" || kw.raw == "trait") {
    let mut k = i + 1
    let mut depth = 0
    while k < n {
      let kk = tokens[k].kind
      if depth == 0 && tokens[k].newline_before && is_top_level_decl_start(tokens, k) {
        return k
      }
      if depth == 0 && kk == TokenKind::LBrace {
        return find_matching_delim(tokens, k) + 1
      }
      if depth == 0 && kk == TokenKind::Eq {
        let mut e = find_expr_end(tokens, k + 1, n)
        while e < n && tokens[e].kind == TokenKind::StringLit && !tokens[e].newline_before {
          e = e + 1
        }
        return e
      }
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        depth = depth + 1
      } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      }
      k = k + 1
    }
    return k
  }
  if is_kw && kw.raw == "using" {
    let mut k = i + 1
    while k < n && tokens[k].kind != TokenKind::LBrace {
      if tokens[k].newline_before && is_top_level_decl_start(tokens, k) {
        return k
      }
      k = k + 1
    }
    if k < n && tokens[k].kind == TokenKind::LBrace {
      return find_matching_delim(tokens, k) + 1
    }
    return k
  }
  if is_kw && (kw.raw == "type" || kw.raw == "typealias" || kw.raw == "fnalias") {
    let mut k = i + 1
    while k < n {
      let kk = tokens[k].kind
      if tokens[k].newline_before {
        let r = tokens[k].raw
        if is_top_level_decl_start(tokens, k) || (r != "=" && r != "->" && r != "|" && r != "/") {
          break
        }
      }
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        k = find_matching_delim(tokens, k) + 1
        continue
      }
      k = k + 1
    }
    if k < n && (tokens[k].kind == TokenKind::Keyword || tokens[k].kind == TokenKind::Ident) &&
    tokens[k].raw == "derive" && k + 1 < n && tokens[k + 1].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k + 1) + 1
    }
    return k
  }
  i + 1
}

///| Extract a concise declaration label (`fn:foo`, `struct:Bar`, etc.) starting at `start_i` (after `#` attrs).
fn peek_decl_label(tokens : Array[Token], start_i : Int, n : Int) -> String {
  let mut i = start_i
  if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::LParen {
      i = find_matching_delim(tokens, i) + 1
    }
  } else if i < n && tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "async" {
    i = i + 1
  }
  if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) &&
  tokens[i].raw == "extern" {
    i = i + 1
    if i < n && tokens[i].kind == TokenKind::StringLit {
      i = i + 1
    }
  }
  if i >= n {
    return "<decl>"
  }
  let kw = tokens[i].raw
  let mut ni = i + 1
  if ni < n && tokens[ni].kind == TokenKind::LBracket {
    ni = find_matching_delim(tokens, ni) + 1
  }
  if ni < n && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
    ni = ni + 1
  }
  if ni < n {
    kw + ":" + tokens[ni].raw
  } else {
    kw
  }
}

///| Stateless check whether a top-level declaration keyword at `kw_idx` is immediately
///| preceded by a `pub` / `pub(...)` visibility modifier (never leaks across declarations).
fn is_decl_pub(tokens : Array[Token], kw_idx : Int) -> Bool {
  let mut j = kw_idx - 1
  while j >= 0 {
    let tk = tokens[j]
    if tk.kind == TokenKind::Keyword && tk.raw == "pub" {
      return true
    }
    if tk.kind == TokenKind::Keyword && (tk.raw == "async" || tk.raw == "extern") {
      j = j - 1
      continue
    }
    if tk.kind == TokenKind::StringLit && j > 0 && tokens[j - 1].kind == TokenKind::Keyword && tokens[j - 1].raw == "extern" {
      j = j - 2
      continue
    }
    if tk.kind == TokenKind::RParen {
      let mut d = 1
      let mut p = j - 1
      while p >= 0 && d > 0 {
        if tokens[p].kind == TokenKind::RParen { d = d + 1 }
        else if tokens[p].kind == TokenKind::LParen { d = d - 1 }
        p = p - 1
      }
      if p >= 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "pub" {
        return true
      }
      return false
    }
    return false
  }
  false
}

///| Extract exact original MoonBit `(line, col)` coordinates for every Stage A.5 probe candidate
///| in `[start, end)` (recursing into `InterpString`/`InterpMultiline` `\{...}` holes) in exact
///| left-to-right token order, grouped by probe kind: `kind=l1:c1,l2:c2;...`.
fn collect_init_probe_origins_into(
  tokens : Array[Token],
  start : Int,
  end : Int,
  line_base : Int,
  col_base : Int,
  by_kind : Map[String, Array[String]],
) -> Unit {
  let lim = if end < tokens.length() { end } else { tokens.length() }
  let push_coord = fn(kind : String, ln : Int, cl : Int) -> Unit {
    let real_ln = if line_base > 0 { line_base + ln - 1 } else { ln }
    let real_cl = if line_base > 0 && ln == 1 { col_base + cl - 1 } else { cl }
    let pair = real_ln.to_string() + ":" + real_cl.to_string()
    match by_kind.get(kind) {
      Some(xs) => xs.push(pair)
      None => by_kind[kind] = [pair]
    }
  }
  let mut i = start
  while i < lim {
    let t = tokens[i]
    if t.kind == TokenKind::Dot && i + 1 < lim {
      if i + 3 < lim && tokens[i + 1].raw == "length" && tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::RParen {
        push_coord("mbt_len_probe", tokens[i + 1].line, tokens[i + 1].col)
        i = i + 4
        continue
      }
      if i + 3 < lim && tokens[i + 1].raw == "to_string" && tokens[i + 2].kind == TokenKind::LParen && tokens[i + 3].kind == TokenKind::RParen {
        push_coord("mbt_show_probe", tokens[i + 1].line, tokens[i + 1].col)
        i = i + 4
        continue
      }
      if tokens[i + 1].raw == "val" {
        let is_set = i + 2 < lim && (tokens[i + 2].kind == TokenKind::Eq || tokens[i + 2].kind == TokenKind::AssignOp)
        push_coord(if is_set { "mbt_val_set_probe" } else { "mbt_val_probe" }, tokens[i + 1].line, tokens[i + 1].col)
        i = i + 2
        continue
      }
    } else if t.kind == TokenKind::LBracket && i > start && !t.newline_before {
      let pk = tokens[i - 1].kind
      if pk == TokenKind::Ident || pk == TokenKind::RParen || pk == TokenKind::RBracket ||
      pk == TokenKind::StringLit || pk == TokenKind::InterpString ||
      pk == TokenKind::RawMultiline || pk == TokenKind::InterpMultiline || pk == TokenKind::RBrace {
        let cb = find_matching_delim(tokens, i)
        if cb < lim {
          let mut has_colon = false
          let mut d = 0
          let mut k = i + 1
          while k < cb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { if d > 0 { d = d - 1 } }
            else if d == 0 && kk == TokenKind::Colon { has_colon = true; break }
            k = k + 1
          }
          if has_colon {
            let is_owned = cb + 4 < lim && tokens[cb + 1].kind == TokenKind::Dot && tokens[cb + 2].raw == "to_owned" &&
            tokens[cb + 3].kind == TokenKind::LParen && tokens[cb + 4].kind == TokenKind::RParen
            push_coord(if is_owned { "mbt_slice_owned_probe" } else { "mbt_slice_borrow_probe" }, t.line, t.col)
          } else {
            push_coord("mbt_idx_probe", t.line, t.col)
          }
        }
      }
    } else if t.kind == TokenKind::Slash {
      push_coord("mbt_div_probe", t.line, t.col)
    } else if t.kind == TokenKind::Percent {
      push_coord("mbt_mod_probe", t.line, t.col)
    } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let raw = t.raw
      let rlen = raw.length()
      let mut p = 0
      let mut cur_ln = t.line
      let mut cur_cl = t.col
      while p < rlen {
        let ch = raw.code_unit_at(p)
        if ch == 92 && p + 1 < rlen && raw.code_unit_at(p + 1) != 123 {
          if raw.code_unit_at(p + 1) == 10 {
            cur_ln = cur_ln + 1
            cur_cl = 1
          } else {
            cur_cl = cur_cl + 2
          }
          p = p + 2
          continue
        }
        if ch == 92 && p + 1 < rlen && raw.code_unit_at(p + 1) == 123 {
          let h_start = p + 2
          cur_cl = cur_cl + 2
          let h_ln = cur_ln
          let h_cl = cur_cl
          let mut hd = 1
          let mut in_str = false
          let mut hp = h_start
          let mut h_end = rlen
          while hp < rlen {
            let hc = raw.code_unit_at(hp)
            if in_str {
              if hc == 92 && hp + 1 < rlen {
                if raw.code_unit_at(hp + 1) == 10 {
                  cur_ln = cur_ln + 1
                  cur_cl = 1
                } else {
                  cur_cl = cur_cl + 2
                }
                hp = hp + 2
                continue
              }
              if hc == 34 {
                in_str = false
              }
            } else {
              if hc == 34 {
                in_str = true
              } else if hc == 123 {
                hd = hd + 1
              } else if hc == 125 {
                hd = hd - 1
                if hd == 0 { h_end = hp; break }
              }
            }
            if hc == 10 { cur_ln = cur_ln + 1; cur_cl = 1 } else { cur_cl = cur_cl + 1 }
            hp = hp + 1
          }
          if h_end > h_start {
            let hole_raw = raw.slice(h_start, h_end)
            let et = hole_raw.trim()
            let h_toks = lex_moonbit(hole_raw)
            if et.length() > 0 && is_alpha(et.code_unit_at(0)) && !str_has(et, "(") && !str_has(et, " ") && !str_has(et, "::") && h_toks.length() >= 2 {
              let id_tok = h_toks[0]
              let show_ln = h_ln + id_tok.line - 1
              let show_cl = if id_tok.line == 1 { h_cl + id_tok.col - 1 } else { id_tok.col }
              push_coord("mbt_show_probe", show_ln, show_cl)
            }
            collect_init_probe_origins_into(h_toks, 0, h_toks.length() - 1, h_ln, h_cl, by_kind)
          }
          p = if h_end < rlen { h_end + 1 } else { rlen }
          cur_cl = cur_cl + 1
          continue
        }
        if ch == 10 { cur_ln = cur_ln + 1; cur_cl = 1 } else { cur_cl = cur_cl + 1 }
        p = p + 1
      }
    }
    i = i + 1
  }
}

fn collect_init_probe_origins(tokens : Array[Token], start : Int, end : Int) -> String {
  let by_kind : Map[String, Array[String]] = Map()
  collect_init_probe_origins_into(tokens, start, end, 0, 0, by_kind)
  let keys = sorted_map_keys(by_kind)
  if keys.length() == 0 {
    return ""
  }
  let parts : Array[String] = []
  for k in keys {
    match by_kind.get(k) {
      Some(coords) => {
        let sb = StringBuilder()
        sb.write_string(k + "=")
        let mut ci = 0
        while ci < coords.length() {
          if ci > 0 { sb.write_string(",") }
          sb.write_string(coords[ci])
          ci = ci + 1
        }
        parts.push(sb.to_string())
      }
      None => ()
    }
  }
  let out = StringBuilder()
  let mut pi = 0
  while pi < parts.length() {
    if pi > 0 { out.write_string(";") }
    out.write_string(parts[pi])
    pi = pi + 1
  }
  out.to_string()
}

///| Pre-scan all source files to register intra-package enums, `#callsite(autofill(loc))`,
///| and migrated functions with optional defaults into `ctx.symtab`.
///| Skips declarations excluded by `#cfg(...)` for `ctx.opts.target` (#12a P1-1).
pub fn prescan_package_symbols(ctx : StageAContext, files : Array[SourceFile]) -> Unit {
  let prod_all_decls : Map[String, Bool] = Map()
  let bb_priv_decls : Array[String] = []
  let bb_all_idents : Map[String, Bool] = Map()
  let method_seen_count : Map[String, Int] = Map()
  for sf in files {
    let is_blackbox = sf.rel_path.ends_with("_test.mbt") && !sf.rel_path.ends_with("_wbtest.mbt")
    let bb_decls : Map[String, Bool] = if is_blackbox { ctx.symtab.blackbox_decls } else { Map() }
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    // P0-1(a): Pre-populate `ctx.used_idents` across ALL package files before lowering any file
    // so fresh temps and `.val` placeholders can NEVER collide with any user identifier in any file.
    let mut ui = 0
    while ui < n {
      let ut = tokens[ui]
      if ut.kind == TokenKind::Ident || ut.kind == TokenKind::UpperIdent {
        ctx.used_idents[ut.raw] = true
        if is_blackbox {
          bb_all_idents[ut.raw] = true
        }
      }
      ui = ui + 1
    }
    let mut i = 0
    let mut next_autofill = false
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::Attr {
        if t.raw.starts_with("#callsite") && str_has(t.raw, "autofill(loc)") {
          next_autofill = true
        } else if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, ctx.opts.target) {
            Some(false) => next_cfg_excluded = true
            None => next_cfg_excluded = true
            Some(true) => ()
          }
        }
        i = i + 1
        continue
      }
      if next_cfg_excluded {
        next_cfg_excluded = false
        next_autofill = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      // P0-4: Record all locally defined types (`struct`, `enum`, `type`, `suberror`, `trait`) so stdlib rewrites
      // (`Json` -> `mbt_compat::MbtJson`, `Hash::hash` -> `mbt_compat::mbt_hash`) NEVER hijack local types!
      if t.kind == TokenKind::Keyword &&
      (t.raw == "struct" || t.raw == "enum" || t.raw == "type" || t.raw == "suberror" || t.raw == "trait") &&
      i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        ctx.symtab.local_types[tokens[i + 1].raw] = true
      }
      if t.kind == TokenKind::Keyword && t.raw == "struct" && i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        next_autofill = false
        let sname = tokens[i + 1].raw
        let mut lb = i + 2
        let mut struct_added_g : Array[String] = []
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, lb)
          struct_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, lb, close_gb))
          lb = close_gb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let raw_fields : Array[String] = []
          let existing_set : Map[String, Bool] = Map()
          let mut fi = lb + 1
          while fi < rb {
            if tokens[fi].kind == TokenKind::Semi || tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            if tokens[fi].kind == TokenKind::Keyword && (tokens[fi].raw == "pub" || tokens[fi].raw == "priv") {
              fi = fi + 1
            }
            if fi < rb && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
              fi = fi + 1
            }
            if fi >= rb { break }
            let raw_f = tokens[fi].raw
            raw_fields.push(raw_f)
            existing_set[raw_f] = true
            let mut fc = fi + 1
            while fc < rb && tokens[fc].kind != TokenKind::Colon {
              fc = fc + 1
            }
            let mut f_end = if fc < rb { fc + 1 } else { fi + 1 }
            let mut fd = 0
            while f_end < rb {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
                fd = fd + 1
              } else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
                fd = fd - 1
              } else if fd == 0 && (fk == TokenKind::Semi || fk == TokenKind::Comma || tokens[f_end].newline_before) {
                break
              }
              f_end = f_end + 1
            }
            if fc < rb && f_end > fc + 1 {
              let fty = lower_type_tokens(tokens, fc + 1, f_end, ctx.symtab, ctx.recipes).trim()
              let fmap = match ctx.symtab.struct_field_types.get(sname) {
                Some(m) => m
                None => {
                  let m : Map[String, String] = Map()
                  ctx.symtab.struct_field_types[sname] = m
                  m
                }
              }
              fmap[raw_f] = fty
            }
            fi = f_end
          }
          pop_active_generics(ctx, struct_added_g)
          let renames : Map[String, String] = Map()
          let used_names : Map[String, Bool] = Map()
          for rf in raw_fields {
            if !is_pion_reserved_ident(rf) {
              renames[rf] = rf
              used_names[rf] = true
            }
          }
          for rf in raw_fields {
            if is_pion_reserved_ident(rf) {
              let new_name = allocate_collision_free_field_name(rf, existing_set, used_names)
              renames[rf] = new_name
              used_names[new_name] = true
              if rf == "val" {
                ctx.struct_val_fields[sname] = new_name
                if is_decl_pub(tokens, i) {
                  ctx.exported_abi_struct_vals.push(AbiStructValRename::{
                    pkg: ctx.self_pkg_name,
                    struct_name: sname,
                    renamed_field: new_name,
                  })
                }
              }
            }
          }
          ctx.struct_field_renames[sname] = renames
          // Prescan non-primitive `#derive(Eq)` / trailing `derive(Eq)` and `#derive(Hash)` structs!
          let mut has_eq_derive = false
          let mut has_hash_derive = false
          if rb + 2 < n && (tokens[rb + 1].kind == TokenKind::Keyword || tokens[rb + 1].kind == TokenKind::Ident) &&
          tokens[rb + 1].raw == "derive" && tokens[rb + 2].kind == TokenKind::LParen {
            let dp = find_matching_delim(tokens, rb + 2)
            let mut di = rb + 3
            while di < dp {
              if tokens[di].raw == "Eq" { has_eq_derive = true }
              if tokens[di].raw == "Hash" { has_hash_derive = true }
              di = di + 1
            }
          }
          let mut back_i = i - 1
          while back_i >= 0 && (tokens[back_i].kind == TokenKind::Keyword || tokens[back_i].kind == TokenKind::LParen ||
            tokens[back_i].kind == TokenKind::RParen || tokens[back_i].kind == TokenKind::Ident || tokens[back_i].kind == TokenKind::Attr) {
            if tokens[back_i].kind == TokenKind::Attr && tokens[back_i].raw.starts_with("#derive") {
              if str_has(tokens[back_i].raw, "Eq") { has_eq_derive = true }
              if str_has(tokens[back_i].raw, "Hash") { has_hash_derive = true }
            }
            if tokens[back_i].kind == TokenKind::Keyword && !(tokens[back_i].raw == "pub" || tokens[back_i].raw == "priv") {
              break
            }
            back_i = back_i - 1
          }
          if has_hash_derive {
            ctx.symtab.hashable_types[sname] = true
          }
          if has_eq_derive {
            let mut all_prim = true
            match ctx.symtab.struct_field_types.get(sname) {
              Some(fm) => {
                for fk in fm.keys() {
                  match fm.get(fk) {
                    Some(ft) => if !is_primitive_type(ft) { all_prim = false }
                    None => ()
                  }
                }
              }
              None => ()
            }
            if !all_prim {
              ctx.symtab.custom_eq_types[sname] = ctx.recipes.eq_recipe.helper_prefix + ascii_to_lower(sname)
            }
          }
          i = rb + 1
          continue
        } else if lb < n && tokens[lb].kind == TokenKind::LParen {
          // Tuple struct prescan: `struct Name[T](A, B, ...)`
          let rp = find_matching_delim(tokens, lb)
          let mut fi = lb + 1
          let mut fidx = 0
          let fmap = match ctx.symtab.struct_field_types.get(sname) {
            Some(m) => m
            None => {
              let m : Map[String, String] = Map()
              ctx.symtab.struct_field_types[sname] = m
              m
            }
          }
          while fi < rp {
            if tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            let mut ty_s = fi
            if ty_s < rp && tokens[ty_s].kind == TokenKind::Keyword && (tokens[ty_s].raw == "pub" || tokens[ty_s].raw == "priv") {
              ty_s = ty_s + 1
            }
            if ty_s < rp && tokens[ty_s].kind == TokenKind::Keyword && tokens[ty_s].raw == "mut" {
              ty_s = ty_s + 1
            }
            let mut f_end = ty_s
            let mut fd = 0
            while f_end < rp {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
              else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
              else if fd == 0 && fk == TokenKind::Comma { break }
              f_end = f_end + 1
            }
            if f_end > ty_s {
              let fty = lower_type_tokens(tokens, ty_s, f_end, ctx.symtab, ctx.recipes).trim()
              fmap["_" + fidx.to_string()] = fty
              fidx = fidx + 1
            }
            fi = f_end + 1
          }
          ctx.symtab.tuple_structs[sname] = fidx
          pop_active_generics(ctx, struct_added_g)
          i = rp + 1
          continue
        } else {
          pop_active_generics(ctx, struct_added_g)
        }
      }
      // Prescan types referenced in any `pub` declaration signature (for enum constructor visibility fail-closed check)
      if t.kind == TokenKind::Keyword && t.raw == "pub" {
        let mut pi = i + 1
        let mut is_pub_all = false
        if pi < n && tokens[pi].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, pi)
          if pi + 1 < cp && (tokens[pi + 1].raw == "all" || tokens[pi + 1].raw == "open") {
            is_pub_all = true
          }
          pi = cp + 1
        }
        if pi < n && tokens[pi].kind == TokenKind::Keyword && tokens[pi].raw == "fn" {
          // Collect generic type params (`pub fn[T] f(...)` or `pub fn f[T](...)`) so they never shadow local enum names
          let local_tparams : Map[String, Bool] = Map()
          let mut tp_scan = pi + 1
          if tp_scan < n && tokens[tp_scan].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, tp_scan)
            let mut k = tp_scan + 1
            let mut bd = 0
            while k < cb {
              let kk = tokens[k].kind
              if kk == TokenKind::LBracket || kk == TokenKind::LParen { bd = bd + 1 }
              else if kk == TokenKind::RBracket || kk == TokenKind::RParen { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && kk == TokenKind::UpperIdent && (k == tp_scan + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            tp_scan = cb + 1
          }
          // Advance past fn name (possibly `Type::method`) and check trailing `[T]`
          while tp_scan < n && tokens[tp_scan].kind != TokenKind::LParen && tokens[tp_scan].kind != TokenKind::LBracket &&
          tokens[tp_scan].kind != TokenKind::LBrace && tokens[tp_scan].kind != TokenKind::Eq {
            tp_scan = tp_scan + 1
          }
          if tp_scan < n && tokens[tp_scan].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, tp_scan)
            let mut k = tp_scan + 1
            let mut bd = 0
            while k < cb {
              let kk = tokens[k].kind
              if kk == TokenKind::LBracket || kk == TokenKind::LParen { bd = bd + 1 }
              else if kk == TokenKind::RBracket || kk == TokenKind::RParen { if bd > 0 { bd = bd - 1 } }
              else if bd == 0 && kk == TokenKind::UpperIdent && (k == tp_scan + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
          }
          // Scan params and return type up to `{` or `=`
          let mut si = pi + 1
          let mut sd = 0
          while si < n {
            let sk = tokens[si].kind
            if sd == 0 && (sk == TokenKind::LBrace || sk == TokenKind::Eq) { break }
            if sk == TokenKind::LParen || sk == TokenKind::LBracket { sd = sd + 1 }
            else if sk == TokenKind::RParen || sk == TokenKind::RBracket { if sd > 0 { sd = sd - 1 } }
            else if sk == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi < n && tokens[pi].kind == TokenKind::Keyword && (tokens[pi].raw == "let" || tokens[pi].raw == "const") {
          let mut si = pi + 1
          let mut seen_col = false
          while si < n && tokens[si].kind != TokenKind::Eq && tokens[si].kind != TokenKind::Semi {
            if si > pi + 1 && tokens[si].newline_before && is_top_level_decl_start(tokens, si) { break }
            if tokens[si].kind == TokenKind::Colon { seen_col = true }
            else if seen_col && tokens[si].kind == TokenKind::UpperIdent {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi + 1 < n && tokens[pi].kind == TokenKind::Keyword &&
        (tokens[pi].raw == "type" || tokens[pi].raw == "typealias") {
          let local_tparams : Map[String, Bool] = Map()
          let mut si = pi + 2
          if si < n && tokens[si].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, si)
            let mut k = si + 1
            while k < cb {
              if tokens[k].kind == TokenKind::UpperIdent && (k == si + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            si = cb + 1
          }
          let mut seen_eq = false
          while si < n && tokens[si].kind != TokenKind::Semi {
            if tokens[si].newline_before && is_top_level_decl_start(tokens, si) { break }
            if tokens[si].kind == TokenKind::Eq {
              seen_eq = true
            } else if seen_eq && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        } else if pi + 1 < n && tokens[pi].kind == TokenKind::Keyword &&
        (tokens[pi].raw == "struct" || tokens[pi].raw == "enum") {
          let is_struct_decl = tokens[pi].raw == "struct"
          let local_tparams : Map[String, Bool] = Map()
          let mut lb = pi + 2
          if lb < n && tokens[lb].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, lb)
            let mut k = lb + 1
            while k < cb {
              if tokens[k].kind == TokenKind::UpperIdent && (k == lb + 1 || tokens[k - 1].kind == TokenKind::Comma) {
                local_tparams[tokens[k].raw] = true
              }
              k = k + 1
            }
            lb = cb + 1
          }
          if lb < n && (tokens[lb].kind == TokenKind::LBrace || tokens[lb].kind == TokenKind::LParen) {
            let rb = find_matching_delim(tokens, lb)
            if is_pub_all {
              let mut si = lb + 1
              while si < rb {
                if tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
                  let prev_c = si >= lb + 1 && (tokens[si - 1].kind == TokenKind::Colon || tokens[si - 1].kind == TokenKind::LParen ||
                    tokens[si - 1].kind == TokenKind::Comma || tokens[si - 1].kind == TokenKind::LBracket)
                  if prev_c { ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true }
                }
                si = si + 1
              }
            } else if is_struct_decl && tokens[lb].kind == TokenKind::LBrace {
              // Regular `pub struct`: scan fields explicitly marked `pub`
              let mut si = lb + 1
              let mut in_pub_field = false
              let mut seen_colon = false
              while si < rb {
                if tokens[si].newline_before || tokens[si].kind == TokenKind::Semi {
                  in_pub_field = false
                  seen_colon = false
                }
                if tokens[si].kind == TokenKind::Keyword && tokens[si].raw == "pub" {
                  in_pub_field = true
                  seen_colon = false
                } else if in_pub_field && tokens[si].kind == TokenKind::Colon {
                  seen_colon = true
                } else if in_pub_field && seen_colon && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
                  ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
                }
                si = si + 1
              }
            }
          }
        }
      }
      // Bare `struct` (default abstract-public in MoonBit) with explicitly `pub` fields
      if t.kind == TokenKind::Keyword && t.raw == "struct" && (i == 0 || (tokens[i - 1].raw != "pub" && tokens[i - 1].raw != "priv" && tokens[i - 1].kind != TokenKind::RParen)) {
        let local_tparams : Map[String, Bool] = Map()
        let mut lb = i + 2
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let cb = find_matching_delim(tokens, lb)
          let mut k = lb + 1
          while k < cb {
            if tokens[k].kind == TokenKind::UpperIdent && (k == lb + 1 || tokens[k - 1].kind == TokenKind::Comma) {
              local_tparams[tokens[k].raw] = true
            }
            k = k + 1
          }
          lb = cb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let mut si = lb + 1
          let mut in_pub_field = false
          let mut seen_colon = false
          while si < rb {
            if tokens[si].newline_before || tokens[si].kind == TokenKind::Semi {
              in_pub_field = false
              seen_colon = false
            }
            if tokens[si].kind == TokenKind::Keyword && tokens[si].raw == "pub" {
              in_pub_field = true
              seen_colon = false
            } else if in_pub_field && tokens[si].kind == TokenKind::Colon {
              seen_colon = true
            } else if in_pub_field && seen_colon && tokens[si].kind == TokenKind::UpperIdent && !local_tparams.contains(tokens[si].raw) {
              ctx.symtab.pub_sig_referenced_types[tokens[si].raw] = true
            }
            si = si + 1
          }
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "enum" && i + 1 < n && tokens[i + 1].kind == TokenKind::UpperIdent {
        next_autofill = false
        let ename = tokens[i + 1].raw
        let enum_is_pub = is_decl_pub(tokens, i)
        let mut enum_is_pub_all = false
        if i >= 4 && tokens[i - 1].kind == TokenKind::RParen && tokens[i - 3].kind == TokenKind::LParen &&
        tokens[i - 4].kind == TokenKind::Keyword && tokens[i - 4].raw == "pub" &&
        (tokens[i - 2].raw == "all" || tokens[i - 2].raw == "open") {
          enum_is_pub_all = true
        }
        let mut lb = i + 2
        let mut enum_added_g : Array[String] = []
        if lb < n && tokens[lb].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, lb)
          enum_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, lb, close_gb))
          lb = close_gb + 1
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(tokens, lb)
          let abi_variants : Array[AbiEnumVariant] = []
          let mut k = lb + 1
          let mut depth = 0
          while k < rb {
            let kk = tokens[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBrace || kk == TokenKind::LBracket {
              depth = depth + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBrace || kk == TokenKind::RBracket {
              depth = depth - 1
            } else if depth == 0 && kk == TokenKind::UpperIdent {
              let prev_c = k > lb + 1 && (tokens[k - 1].kind == TokenKind::Colon || tokens[k - 1].kind == TokenKind::ColonColon)
              if !prev_c {
                let vname = tokens[k].raw
                let vfields : Array[AbiEnumField] = []
                if k + 1 < rb && tokens[k + 1].kind == TokenKind::LParen {
                  let vp = find_matching_delim(tokens, k + 1)
                  let mut vi = k + 2
                  while vi < vp {
                    if tokens[vi].kind == TokenKind::Comma {
                      vi = vi + 1
                      continue
                    }
                    let mut ve = vi
                    let mut vd = 0
                    while ve < vp {
                      let vk = tokens[ve].kind
                      if vk == TokenKind::LParen || vk == TokenKind::LBracket || vk == TokenKind::LBrace { vd = vd + 1 }
                      else if vk == TokenKind::RParen || vk == TokenKind::RBracket || vk == TokenKind::RBrace { vd = vd - 1 }
                      else if vd == 0 && vk == TokenKind::Comma { break }
                      ve = ve + 1
                    }
                    if ve > vi {
                      let mut f_lbl = ""
                      let mut ty_s = vi
                      if ty_s < ve && tokens[ty_s].kind == TokenKind::Keyword && tokens[ty_s].raw == "mut" {
                        ty_s = ty_s + 1
                      }
                      if ty_s + 1 < ve && (tokens[ty_s].kind == TokenKind::Ident || tokens[ty_s].kind == TokenKind::Keyword) {
                        if tokens[ty_s + 1].kind == TokenKind::Tilde && ty_s + 2 < ve && tokens[ty_s + 2].kind == TokenKind::Colon {
                          f_lbl = tokens[ty_s].raw
                          ty_s = ty_s + 3
                        } else if tokens[ty_s + 1].kind == TokenKind::Colon {
                          f_lbl = tokens[ty_s].raw
                          ty_s = ty_s + 2
                        }
                      }
                      let fty = lower_type_tokens(tokens, ty_s, ve, ctx.symtab, ctx.recipes).trim()
                      vfields.push(AbiEnumField::{ label: f_lbl, ty: fty })
                    }
                    vi = ve + 1
                  }
                }
                abi_variants.push(AbiEnumVariant::{ name: vname, fields: vfields })
              }
            }
            k = k + 1
          }
          let local_schema = AbiEnumSchema::{
            pkg: "",
            name: ename,
            can_match: true,
            can_construct: true,
            variants: abi_variants,
          }
          symtab_register_enum_schema(ctx.symtab, local_schema)
          if enum_is_pub && !sf.is_test {
            ctx.exported_abi_enums.push(AbiEnumSchema::{
              pkg: ctx.self_pkg_name,
              name: ename,
              can_match: true,
              can_construct: enum_is_pub_all,
              variants: abi_variants,
            })
          }
          pop_active_generics(ctx, enum_added_g)
          i = rb + 1
          continue
        }
        pop_active_generics(ctx, enum_added_g)
      }
      if t.kind == TokenKind::Keyword && t.raw == "type" && i + 3 < n &&
      tokens[i + 1].kind == TokenKind::UpperIdent && tokens[i + 2].kind == TokenKind::Eq {
        next_autofill = false
        let aname = tokens[i + 1].raw
        let rhs_end = find_top_level_let_expr_end(tokens, i + 3, n)
        let rty = lower_type_tokens(tokens, i + 3, rhs_end, ctx.symtab, ctx.recipes).trim()
        if rty.length() > 0 {
          ctx.symtab.type_aliases[aname] = rty
        }
        i = rhs_end
        continue
      }
      if (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "using" &&
      i + 2 < n && tokens[i + 1].kind == TokenKind::PkgRef && tokens[i + 2].kind == TokenKind::LBrace {
        next_autofill = false
        let raw_pkg = tokens[i + 1].raw.slice(1, tokens[i + 1].raw.length())
        let target_pkg = match ctx.symtab.pkg_aliases.get(raw_pkg) {
          Some(p) => p
          None => raw_pkg
        }
        let rb = find_matching_delim(tokens, i + 2)
        let mut uk = i + 3
        while uk < rb {
          let ut = tokens[uk]
          if ut.kind == TokenKind::Comma || ut.kind == TokenKind::Semi {
            uk = uk + 1
            continue
          }
          if (ut.kind == TokenKind::Keyword || ut.kind == TokenKind::Ident) &&
          (ut.raw == "type" || ut.raw == "trait") && uk + 1 < rb &&
          (tokens[uk + 1].kind == TokenKind::UpperIdent || tokens[uk + 1].kind == TokenKind::Ident) {
            let tname = tokens[uk + 1].raw
            let qual = target_pkg + "::" + tname
            if !ctx.symtab.local_types.contains(tname) {
              ctx.symtab.using_types[tname] = qual
            }
            uk = uk + 2
            continue
          }
          if ut.kind == TokenKind::Ident || ut.kind == TokenKind::UpperIdent {
            let vname = ut.raw
            ctx.symtab.using_values[vname] = target_pkg + "::" + vname
          }
          uk = uk + 1
        }
        i = rb + 1
        continue
      }
      if t.kind == TokenKind::Keyword && (t.raw == "const" || t.raw == "let") && i + 1 < n {
        let decl_pub = is_decl_pub(tokens, i)
        let is_const_decl = t.raw == "const"
        next_autofill = false
        let mut ni = i + 1
        if tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" && ni + 1 < n {
          ni = ni + 1
        }
        if ni < n && (tokens[ni].kind == TokenKind::Ident || tokens[ni].kind == TokenKind::UpperIdent) {
          let vname = tokens[ni].raw
          if is_blackbox {
            bb_decls[vname] = true
            if !decl_pub {
              bb_priv_decls.push(vname)
            }
          } else {
            ctx.symtab.local_value_names[vname] = true
            prod_all_decls[vname] = true
            if !sf.is_test && decl_pub {
              ctx.symtab.prod_pub_decls[vname] = true
            }
          }
          // Record top-level `let`/`const` static type for sound static `.val` resolution (P1-1)
          let mut const_eq_i = -1
          if ni + 2 < n && tokens[ni + 1].kind == TokenKind::Colon {
            let mut eq_i = ni + 2
            let mut td = 0
            while eq_i < n {
              let tk = tokens[eq_i].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
              else if td == 0 && tk == TokenKind::Eq { break }
              eq_i = eq_i + 1
            }
            if eq_i < n && tokens[eq_i].kind == TokenKind::Eq {
              const_eq_i = eq_i
              let vty = lower_type_tokens(tokens, ni + 2, eq_i, ctx.symtab, ctx.recipes).trim()
              if vty.length() > 0 {
                ctx.symtab.val_types[vname] = vty
              }
            }
          } else if ni + 2 < n && tokens[ni + 1].kind == TokenKind::Eq {
            const_eq_i = ni + 1
            let rhs_end = find_top_level_let_expr_end(tokens, ni + 2, n)
            let inf_ty = infer_simple_expr_type(ctx, tokens, ni + 2, rhs_end)
            if inf_ty.length() > 0 {
              ctx.symtab.val_types[vname] = inf_ty
            }
          }
          // §D2-4: Record compile-time literal status for `[pub] const` pattern inlining
          if is_const_decl && const_eq_i >= 0 && (!is_blackbox || !ctx.symtab.const_defs.contains(vname)) {
            let rhs_end = find_top_level_let_expr_end(tokens, const_eq_i + 1, n)
            match extract_const_literal_pion(tokens, const_eq_i + 1, rhs_end) {
              Some(lit_s) => ctx.symtab.const_defs[vname] = ConstDef::{ is_literal: true, literal_pion: lit_s }
              None => ctx.symtab.const_defs[vname] = ConstDef::{ is_literal: false, literal_pion: "" }
            }
          }
        }
      }
      if t.kind == TokenKind::Keyword && t.raw == "fn" && i + 1 < n {
        let decl_pub = is_decl_pub(tokens, i)
        let mut name_i = i + 1
        let mut fn_added_g : Array[String] = []
        if tokens[name_i].kind == TokenKind::LBracket {
          let close_gb = find_matching_delim(tokens, name_i)
          fn_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, name_i, close_gb))
          name_i = close_gb + 1
        }
        if name_i < n {
          let fn_tok = tokens[name_i]
          if fn_tok.kind == TokenKind::UpperIdent && name_i + 3 < n &&
          tokens[name_i + 1].kind == TokenKind::ColonColon &&
          tokens[name_i + 2].kind == TokenKind::Ident &&
          tokens[name_i + 3].kind == TokenKind::LParen {
            let mname = tokens[name_i + 2].raw
            let qual_fn = fn_tok.raw + "::" + mname
            let cp = find_matching_delim(tokens, name_i + 3)
            let (pnames, ptys, _) = extract_param_info(ctx, tokens, name_i + 3, cp, sf.rel_path)
            let pts : Array[(String, String)] = []
            let mut pk = 0
            while pk < pnames.length() {
              let raw_pt = if pk < ptys.length() { ptys[pk] } else { "" }
              let clean_pt = if raw_pt.length() > 0 && ctx.active_generics.contains(strip_type_args_sym(raw_pt)) { "" } else { raw_pt }
              pts.push((pnames[pk], clean_pt))
              pk = pk + 1
            }
            if !is_blackbox {
              ctx.symtab.fn_param_types[qual_fn] = pts
              let p_renames = compute_param_renames(extract_raw_param_names(tokens, name_i + 3, cp))
              if p_renames.length() > 0 {
                ctx.symtab.fn_param_renames[qual_fn] = p_renames
              }
              if next_autofill {
                ctx.symtab.autofill_loc_fns[qual_fn] = true
              }
              let prev_cnt = match method_seen_count.get(mname) {
                Some(c) => c
                None => 0
              }
              method_seen_count[mname] = prev_cnt + 1
              if prev_cnt == 0 {
                let no_self : Array[(String, String)] = []
                let mut sk = if pts.length() > 0 && pts[0].0 == "self" { 1 } else { 0 }
                while sk < pts.length() {
                  no_self.push(pts[sk])
                  sk = sk + 1
                }
                if no_self.length() > 0 {
                  ctx.symtab.method_unique_param_types[mname] = no_self
                }
                if p_renames.length() > 0 {
                  ctx.symtab.method_unique_param_renames[mname] = p_renames
                }
              } else {
                ctx.symtab.method_unique_param_types.remove(mname)
                ctx.symtab.method_unique_param_renames.remove(mname)
              }
              if cp + 1 < n && tokens[cp + 1].kind == TokenKind::Arrow {
                let mut re = cp + 2
                let mut rd = 0
                while re < n {
                  let rk = tokens[re].kind
                  if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq) { break }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
                  re = re + 1
                }
                let rty = lower_type_tokens(tokens, cp + 2, re, ctx.symtab, ctx.recipes).trim()
                if rty.length() > 0 {
                  ctx.symtab.fn_ret_types[qual_fn] = rty
                }
              }
            }
          } else if fn_tok.kind == TokenKind::Ident && fn_tok.raw != "init" {
            if is_blackbox {
              bb_decls[fn_tok.raw] = true
              if !decl_pub {
                bb_priv_decls.push(fn_tok.raw)
              }
              if next_autofill {
                ctx.symtab.blackbox_autofill_loc_fns[fn_tok.raw] = true
              }
            } else {
              ctx.symtab.local_fn_names[fn_tok.raw] = true
              prod_all_decls[fn_tok.raw] = true
              if !sf.is_test && decl_pub {
                ctx.symtab.prod_pub_decls[fn_tok.raw] = true
              }
              if next_autofill {
                ctx.symtab.autofill_loc_fns[fn_tok.raw] = true
              }
            }
            if name_i + 1 < n && tokens[name_i + 1].kind == TokenKind::LParen {
              let cp = find_matching_delim(tokens, name_i + 1)
              // Detect `raise` in function signature for raising-callback fail-closed gate (§5)
              let mut rscan = cp + 1
              let mut rsd = 0
              while rscan < n {
                let rsk = tokens[rscan].kind
                if rsd == 0 && (rsk == TokenKind::LBrace || rsk == TokenKind::Eq) { break }
                if rsk == TokenKind::LParen || rsk == TokenKind::LBracket || rsk == TokenKind::LBrace { rsd = rsd + 1 }
                else if rsk == TokenKind::RParen || rsk == TokenKind::RBracket || rsk == TokenKind::RBrace { if rsd > 0 { rsd = rsd - 1 } }
                else if rsd == 0 && (rsk == TokenKind::Keyword || rsk == TokenKind::Ident) && tokens[rscan].raw == "raise" {
                  ctx.symtab.local_raising_fns[fn_tok.raw] = true
                  break
                }
                rscan = rscan + 1
              }
              let (pnames, ptys, _) = extract_param_info(ctx, tokens, name_i + 1, cp, sf.rel_path)
              let pts : Array[(String, String)] = []
              let mut pk = 0
              while pk < pnames.length() {
                let raw_pt = if pk < ptys.length() { ptys[pk] } else { "" }
                let clean_pt = if raw_pt.length() > 0 && ctx.active_generics.contains(strip_type_args_sym(raw_pt)) { "" } else { raw_pt }
                pts.push((pnames[pk], clean_pt))
                pk = pk + 1
              }
              let p_renames = compute_param_renames(extract_raw_param_names(tokens, name_i + 1, cp))
              if is_blackbox {
                ctx.symtab.blackbox_fn_param_types[fn_tok.raw] = pts
              } else {
                ctx.symtab.fn_param_types[fn_tok.raw] = pts
              }
              if p_renames.length() > 0 {
                ctx.symtab.fn_param_renames[fn_tok.raw] = p_renames
              }
              if cp + 1 < n && tokens[cp + 1].kind == TokenKind::Arrow {
                let mut re = cp + 2
                let mut rd = 0
                while re < n {
                  let rk = tokens[re].kind
                  if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq) { break }
                  if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { rd = rd + 1 }
                  else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace { if rd > 0 { rd = rd - 1 } }
                  re = re + 1
                }
                let rty = lower_type_tokens(tokens, cp + 2, re, ctx.symtab, ctx.recipes).trim()
                if rty.length() > 0 {
                  if is_blackbox {
                    ctx.symtab.blackbox_fn_ret_types[fn_tok.raw] = rty
                  } else {
                    ctx.symtab.fn_ret_types[fn_tok.raw] = rty
                  }
                }
              }
            }
          }
        }
        pop_active_generics(ctx, fn_added_g)
        next_autofill = false
      }
      if t.kind == TokenKind::Keyword && (t.raw == "test" || t.raw == "trait" || t.raw == "impl") {
        next_autofill = false
      }
      if t.kind == TokenKind::LBrace {
        next_autofill = false
        i = find_matching_delim(tokens, i) + 1
        continue
      }
      i = i + 1
    }
  }
  // Compute black-box `*_test.mbt` private top-level collisions against production declarations (P0-1: avoid ALL local idents!)
  for nm in bb_priv_decls {
    if prod_all_decls.contains(nm) && !ctx.symtab.blackbox_colliding_privs.contains(nm) {
      let mut cand = "__mbt_bbtest_" + nm
      let mut seq = 1
      while prod_all_decls.contains(cand) || ctx.symtab.blackbox_decls.contains(cand) ||
      bb_all_idents.contains(cand) || ctx.used_idents.contains(cand) {
        cand = "__mbt_bbtest_" + nm + "_" + seq.to_string()
        seq = seq + 1
      }
      bb_all_idents[cand] = true
      ctx.used_idents[cand] = true
      ctx.symtab.blackbox_colliding_privs[nm] = cand
      match ctx.symtab.blackbox_fn_param_types.get(nm) {
        Some(pts) => ctx.symtab.blackbox_fn_param_types[cand] = pts
        None => ()
      }
      match ctx.symtab.blackbox_fn_ret_types.get(nm) {
        Some(rty) => ctx.symtab.blackbox_fn_ret_types[cand] = rty
        None => ()
      }
      if ctx.symtab.blackbox_autofill_loc_fns.contains(nm) {
        ctx.symtab.blackbox_autofill_loc_fns[cand] = true
      }
    }
  }
}

///| Lower a single `.mbt` file through Stage A, emitting declaration anchors,
///| extracting top-level `let`/`fn init` into `ctx.init_items`, and recording span maps.
///| Exact Pion compiler C-ABI parameter type allowlist (`compiler/src/core/types.pion`).
fn is_pion_c_abi_param_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" ||
  t == "Float" || t == "Float32" || t == "Bool" || t == "Byte" || t == "Int8" || t == "Ptr"
}

///| Exact Pion compiler C-ABI return type allowlist (param types + `Unit`).
fn is_pion_c_abi_ret_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Unit" || is_pion_c_abi_param_type(t)
}

///| Validate every parameter in a lowered `p_str` (`x : T, y : U`) against Pion's C-ABI allowlist.
fn check_pion_c_abi_params(p_str : String) -> Bool {
  let s = p_str.trim()
  if s.length() == 0 {
    return true
  }
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i <= s.length() {
    let at_end = i == s.length()
    let c = if at_end { 44 } else { s.code_unit_at(i) }
    if !at_end && (c == 40 || c == 91 || c == 123) {
      depth = depth + 1
    } else if !at_end && (c == 41 || c == 93 || c == 125) {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 && c == 44 {
      let part = s.slice(start, i).trim()
      if part.length() > 0 {
        let ci = part.index_of(":")
        if ci < 0 {
          return false
        }
        if !is_pion_c_abi_param_type(part.slice(ci + 1, part.length())) {
          return false
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  true
}

pub fn lower_file_stage_a(ctx : StageAContext, sf : SourceFile) -> GeneratedFile {
  ctx.lifted_fns.clear()
  ctx.cur_is_test = sf.is_test
  ctx.symtab.pkg_aliases["__mbt_cur_test_self_pkg__"] = if sf.is_test { ctx.self_pkg_name } else { "" }
  ctx.cur_is_blackbox = sf.rel_path.ends_with("_test.mbt") && !sf.rel_path.ends_with("_wbtest.mbt")
  let raw_tokens = lex_moonbit(sf.content)
  let tokens = redact_tokens_comments(raw_tokens, ctx.recipes.comment_replaces)
  let n = tokens.length() - 1
  // Pre-populate `ctx.used_idents` with every source identifier so `fresh_temp` & `.val` placeholders NEVER collide!
  let mut ui = 0
  while ui < n {
    if tokens[ui].kind == TokenKind::Ident {
      ctx.used_idents[tokens[ui].raw] = true
    }
    ui = ui + 1
  }
  let out_sb = StringBuilder()
  let anchors : Array[DeclAnchor] = []
  let mut i = 0
  let mut init_seq_in_file = 0
  let file_id = sanitize_file_id(sf.rel_path)
  let out_rel = if sf.rel_path.ends_with("_wbtest.mbt") {
    sf.rel_path.slice(0, sf.rel_path.length() - 11) + "_wbtest_test.pion"
  } else if sf.rel_path.ends_with(".mbt") {
    sf.rel_path.slice(0, sf.rel_path.length() - 4) + ".pion"
  } else {
    sf.rel_path + ".pion"
  }
  ctx.cur_out_rel = out_rel

  while i < n {
    let decl_start = i
    let mut autofill_loc = false
    let mut attrs_trivia = StringBuilder()
    let mut kept_attrs = StringBuilder()

    // Collect leading attributes (`#callsite`, `#warnings`, `#deprecated`, `#cfg`, `#derive`, `#borrow`/`#owned`)
    let mut pending_derives : Array[String] = []
    let pending_cfgs : Array[Token] = []
    let pending_ffi_attrs : Array[String] = []
    while i < n && tokens[i].kind == TokenKind::Attr {
      let at = tokens[i]
      attrs_trivia.write_string(at.leading_trivia)
      if at.raw.starts_with("#callsite") && str_has(at.raw, "autofill(loc)") {
        autofill_loc = true
      } else if at.raw.starts_with("#cfg") {
        pending_cfgs.push(at)
      } else if at.raw.starts_with("#borrow") || at.raw.starts_with("#owned") {
        pending_ffi_attrs.push(at.raw)
        kept_attrs.write_string("// mbt-attr: " + at.raw + "\n")
      } else if at.raw.starts_with("#warnings") || at.raw.starts_with("#deprecated") {
        // Strip MoonBit-only compiler directives cleanly
        kept_attrs.write_string("// mbt-attr: " + at.raw + "\n")
      } else if at.raw.starts_with("#derive") {
        let ds = parse_derive_names(at.raw)
        for d in ds {
          pending_derives.push(d)
        }
      } else {
        kept_attrs.write_string(at.raw + "\n")
      }
      i = i + 1
    }
    if i >= n {
      out_sb.write_string(attrs_trivia.to_string())
      out_sb.write_string(kept_attrs.to_string())
      break
    }

    // Evaluate `#cfg(...)` attributes statically against `ctx.opts.target` (#12a P1-1):
    // - Unknown/complex predicate -> fail-loud `MBT2PION_UNSUPPORTED_CFG` + disposition "unsupported"
    // - Statically false -> skip declaration completely + disposition "excluded_by_cfg"
    if pending_cfgs.length() > 0 {
      let mut cfg_unsupported = false
      let mut cfg_unsupported_raw = ""
      let mut cfg_excluded = false
      let mut cfg_excluded_raw = ""
      for cat in pending_cfgs {
        match eval_cfg_attr(cat.raw, ctx.opts.target) {
          None => {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_CFG",
              sf.rel_path,
              cat.line,
              cat.col,
              "unsupported `#cfg` predicate `" + cat.raw + "` cannot be statically evaluated for target=" + ctx.opts.target,
            ))
            cfg_unsupported = true
            if cfg_unsupported_raw.length() == 0 {
              cfg_unsupported_raw = cat.raw
            }
          }
          Some(false) => {
            cfg_excluded = true
            if cfg_excluded_raw.length() == 0 {
              cfg_excluded_raw = cat.raw
            }
          }
          Some(true) => ()
        }
      }
      if cfg_unsupported {
        let lbl = peek_decl_label(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: lbl,
          line: tokens[i].line,
          col: tokens[i].col,
          disposition: "unsupported",
          detail: "unsupported #cfg predicate " + cfg_unsupported_raw,
        })
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if cfg_excluded {
        let lbl = peek_decl_label(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: lbl,
          line: tokens[i].line,
          col: tokens[i].col,
          disposition: "excluded_by_cfg",
          detail: "excluded by " + cfg_excluded_raw + " for target=" + ctx.opts.target,
        })
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
    }

    let decl_err_before = count_error_diags(ctx.diags)

    // Parse visibility (`pub`, `pub(all)`, `pub(open)`, `priv`)
    let mut vis = ""
    let mut pub_fields = false
    let mut explicit_priv = false
    let mut vis_trivia = tokens[i].leading_trivia
    if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "pub" {
      vis = "pub "
      i = i + 1
      if i < n && tokens[i].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i)
        if i + 1 < cp && (tokens[i + 1].raw == "all" || tokens[i + 1].raw == "open") {
          pub_fields = true
        }
        i = cp + 1
      }
    } else if tokens[i].kind == TokenKind::Keyword && tokens[i].raw == "priv" {
      vis = ""
      explicit_priv = true
      i = i + 1
    }
    if i >= n {
      break
    }

    let mut extern_abi = ""
    let mut extern_prefix = ""
    if i < n && (tokens[i].kind == TokenKind::Keyword || tokens[i].kind == TokenKind::Ident) && tokens[i].raw == "extern" {
      let mut ei = i + 1
      let mut abi = ""
      if ei < n && tokens[ei].kind == TokenKind::StringLit {
        abi = tokens[ei].raw
        ei = ei + 1
      }
      if ei < n && tokens[ei].kind == TokenKind::Keyword && tokens[ei].raw == "fn" {
        extern_abi = abi
        extern_prefix = if abi.length() > 0 { "extern " + abi + " " } else { "extern " }
        i = ei
      }
    }

    let kw = tokens[i]
    let decl_line = kw.line
    let decl_col = kw.col

    // --- 1. `fn init { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "fn" && i + 1 < n && tokens[i + 1].raw == "init" {
      let mut lb = i + 2
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        init_seq_in_file = init_seq_in_file + 1
        ctx.init_order_seq = ctx.init_order_seq + 1
        let init_name = "__mbt_init_" + file_id + "_" + init_seq_in_file.to_string()
        let saved_li = ctx.cur_lowering_init
        ctx.cur_lowering_init = true
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        ctx.cur_lowering_init = saved_li
        let (refs, calls, arg_closures) = collect_init_refs_full(tokens, lb, rb + 1)
        let init_target = if sf.is_test { ctx.test_init_items } else { ctx.init_items }
        let init_file_lbl = if sf.is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
        let init_prefix = "let " + init_name + " : Unit = "
        init_target.push(InitItem::{
          id: init_name,
          name: init_name,
          is_fn_init: true,
          source_file: sf.rel_path,
          order_index: ctx.init_order_seq,
          line: decl_line,
          col: decl_col,
          rhs_orig_col: tokens[lb].col,
          rhs_gen_col: init_prefix.length() + 1,
          probe_origins: collect_init_probe_origins(tokens, lb, rb + 1),
          code: init_prefix + body,
          referenced_idents: refs,
          called_fns: calls,
          arg_closure_refs: arg_closures,
        })
        out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
        out_sb.write_string("// moved to " + init_file_lbl + ": " + init_name + "\n")
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: init_name,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "moved_to_00_init_order" },
          detail: if had_err { "fn init contains unsupported syntax" } else { "fn init lowered to topological let Unit binding" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 2. Top-level `let` / `const` -> moved to `00_init_order.pion` ---
    if kw.kind == TokenKind::Keyword && (kw.raw == "let" || kw.raw == "const") && i + 1 < n {
      let mut name_i = i + 1
      let mut is_mut = false
      if tokens[name_i].kind == TokenKind::Keyword && tokens[name_i].raw == "mut" {
        is_mut = true
        name_i = name_i + 1
      }
      let raw_name = tokens[name_i].raw
      let pion_name = if ctx.cur_is_blackbox && vis.length() == 0 {
        match ctx.symtab.blackbox_colliding_privs.get(raw_name) {
          Some(rn) => rn
          None => rename_keyword_ident(raw_name)
        }
      } else {
        rename_keyword_ident(raw_name)
      }
      // Find `=` and end of initializer expression
      let mut eq_i = name_i + 1
      let mut colon_i = -1
      while eq_i < n && tokens[eq_i].kind != TokenKind::Eq {
        if tokens[eq_i].kind == TokenKind::Colon && colon_i < 0 {
          colon_i = eq_i
        }
        eq_i = eq_i + 1
      }
      if eq_i < n {
        let expr_end = find_top_level_let_expr_end(tokens, eq_i + 1, n)
        let mut let_exp_ty = ""
        let ty_str = if colon_i > name_i {
          let lt = lower_type_tokens_checked(ctx, tokens, colon_i + 1, eq_i, sf.rel_path)
          let_exp_ty = lt.trim()
          " : " + lt
        } else {
          let inf = infer_simple_expr_type(ctx, tokens, eq_i + 1, expr_end)
          if inf == "Int" || inf == "Double" || inf == "String" || inf == "Bool" ||
          inf == "Int64" || inf == "UInt" || inf == "UInt64" || inf == "Char" || inf == "Byte" {
            " : " + inf
          } else {
            ""
          }
        }
        push_expected_type(ctx, let_exp_ty)
        let saved_li = ctx.cur_lowering_init
        ctx.cur_lowering_init = true
        let raw_val_str = lower_expr_range(ctx, tokens, eq_i + 1, expr_end, sf.rel_path, false)
        ctx.cur_lowering_init = saved_li
        pop_expected_type(ctx)
        let mut vs = 0
        while vs < raw_val_str.length() && (raw_val_str.code_unit_at(vs) == 32 || raw_val_str.code_unit_at(vs) == 9) {
          vs = vs + 1
        }
        let mut ve = raw_val_str.length()
        while ve > vs {
          let ch = raw_val_str.code_unit_at(ve - 1)
          if ch == 32 || ch == 9 || ch == 10 || ch == 13 { ve = ve - 1 } else { break }
        }
        let val_str = raw_val_str.slice(vs, ve)
        let (refs, calls, arg_closures) = collect_init_refs_full(tokens, eq_i + 1, expr_end)
        ctx.init_order_seq = ctx.init_order_seq + 1
        let mut_kw = if is_mut { "mut " } else { "" }
        let is_multiline_val = val_str.starts_with("\n") || val_str.starts_with("\r")
        let eq_sep = if is_multiline_val { " =" } else { " = " }
        let let_prefix = vis + "let " + mut_kw + pion_name + ty_str + eq_sep
        let code = let_prefix + val_str
        let rhs_orig_col = if is_multiline_val || eq_i + 1 >= n { 1 } else { tokens[eq_i + 1].col }
        let rhs_gen_col = if is_multiline_val { 1 } else { let_prefix.length() + 1 }
        let init_target = if sf.is_test { ctx.test_init_items } else { ctx.init_items }
        let init_file_lbl = if sf.is_test { "00_init_order_test.pion" } else { "00_init_order.pion" }
        init_target.push(InitItem::{
          id: pion_name,
          name: pion_name,
          is_fn_init: false,
          source_file: sf.rel_path,
          order_index: ctx.init_order_seq,
          line: decl_line,
          col: decl_col,
          rhs_orig_col: rhs_orig_col,
          rhs_gen_col: rhs_gen_col,
          probe_origins: collect_init_probe_origins(tokens, eq_i + 1, expr_end),
          code: code,
          referenced_idents: refs,
          called_fns: calls,
          arg_closure_refs: arg_closures,
        })
        out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
        out_sb.write_string("// moved to " + init_file_lbl + ": " + pion_name + "\n")
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "let:" + pion_name,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "moved_to_00_init_order" },
          detail: if had_err { "top-level let contains unsupported syntax" } else { "top-level let scheduled in topological order" },
        })
        i = expr_end
        continue
      }
    }

    // --- 2b. Top-level `type Alias = T` -> expanded inline at use sites ---
    if kw.kind == TokenKind::Keyword && kw.raw == "type" && i + 3 < n &&
    tokens[i + 1].kind == TokenKind::UpperIdent && tokens[i + 2].kind == TokenKind::Eq {
      let aname = tokens[i + 1].raw
      let rhs_end = find_top_level_let_expr_end(tokens, i + 3, n)
      out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
      out_sb.write_string("// type alias expanded: " + aname + "\n")
      ctx.dispositions.push(DispositionEntry::{
        file: sf.rel_path,
        decl: "type:" + aname,
        line: decl_line,
        col: decl_col,
        disposition: "transpiled",
        detail: "type alias expanded inline at use sites",
      })
      i = rhs_end
      continue
    }

    // --- 2c. Top-level `[pub] using @pkg { ... }` ---
    if (kw.kind == TokenKind::Keyword || kw.kind == TokenKind::Ident) && kw.raw == "using" &&
    i + 2 < n && tokens[i + 1].kind == TokenKind::PkgRef && tokens[i + 2].kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, i + 2)
      let raw_pkg = tokens[i + 1].raw
      out_sb.write_string(attrs_trivia.to_string() + vis_trivia)
      out_sb.write_string("// using " + raw_pkg + " expanded\n")
      if vis.length() > 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "`pub using` cross-package re-export from `" + raw_pkg + "` is not yet lowered to ABI",
        ))
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "using:" + raw_pkg,
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "pub using cross-package re-export requires ABI re-export",
        })
      } else {
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "using:" + raw_pkg,
          line: decl_line,
          col: decl_col,
          disposition: "transpiled",
          detail: "private using expanded locally at use sites",
        })
      }
      i = rb + 1
      continue
    }

    // --- 3. `struct` / `enum` declarations with strict `#derive(...)` allowlist + `--recipes` synthesis ---
    if kw.kind == TokenKind::Keyword && (kw.raw == "struct" || kw.raw == "enum") && i + 1 < n {
      let kind_kw = kw.raw
      let tname = tokens[i + 1].raw
      let mut lb = i + 2
      let mut type_added_generics : Array[String] = []
      if lb < n && tokens[lb].kind == TokenKind::LBracket {
        let close_gb = find_matching_delim(tokens, lb)
        type_added_generics = push_active_generics(ctx, collect_generic_param_names(tokens, lb, close_gb))
        lb = close_gb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let mut decl_end = rb + 1
        // Check trailing `derive(...)`
        if decl_end < n && tokens[decl_end].kind == TokenKind::Keyword && tokens[decl_end].raw == "derive" &&
        decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          let dp = find_matching_delim(tokens, decl_end + 1)
          let mut di = decl_end + 2
          while di < dp {
            if tokens[di].kind == TokenKind::UpperIdent || tokens[di].kind == TokenKind::Ident {
              pending_derives.push(tokens[di].raw)
            }
            di = di + 1
          }
          decl_end = dp + 1
        }
        // Validate derives against strict allowlist + recipes!
        let mut pion_derives : Array[String] = []
        let mut recipe_impls_sb = StringBuilder()
        let mut all_fields_primitive = true
        let field_names : Array[String] = []

        // Parse struct fields or enum variants (preserving types for recursive structural equality)
        let field_types : Array[(String, String)] = []
        let enum_variants : Array[(String, Array[String])] = []
        let body_sb = StringBuilder()
        if kind_kw == "struct" {
          let mut fi = lb + 1
          while fi < rb {
            if tokens[fi].kind == TokenKind::Semi || tokens[fi].kind == TokenKind::Comma {
              fi = fi + 1
              continue
            }
            let mut f_mut = false
            let mut f_pub = pub_fields
            if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "pub" {
              f_pub = true
              fi = fi + 1
            } else if tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "priv" {
              f_pub = false
              fi = fi + 1
            }
            if fi < rb && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
              f_mut = true
              fi = fi + 1
            }
            if fi >= rb {
              break
            }
            let fname_raw = tokens[fi].raw
            let fname = rename_struct_field(ctx, tname, fname_raw)
            let mut fc = fi + 1
            while fc < rb && tokens[fc].kind != TokenKind::Colon {
              fc = fc + 1
            }
            let mut f_end = fc + 1
            let mut fd = 0
            while f_end < rb {
              let fk = tokens[f_end].kind
              if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
                fd = fd + 1
              } else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
                fd = fd - 1
              } else if fd == 0 && (fk == TokenKind::Semi || fk == TokenKind::Comma || tokens[f_end].newline_before) {
                break
              }
              f_end = f_end + 1
            }
            let fty = if fc < rb {
              lower_type_tokens_checked(ctx, tokens, fc + 1, f_end, sf.rel_path)
            } else {
              ""
            }
            if !is_primitive_type(fty) {
              all_fields_primitive = false
            }
            field_names.push(fname)
            field_types.push((fname, fty))
            body_sb.write_string("  ")
            if f_pub {
              body_sb.write_string("pub ")
            }
            if f_mut {
              body_sb.write_string("mut ")
            }
            body_sb.write_string(fname + " : " + fty + "\n")
            fi = f_end
          }
        } else {
          // enum body: lower type params inside variants & record payload types
          let mut ei = lb + 1
          while ei < rb {
            if tokens[ei].kind == TokenKind::UpperIdent {
              let vname = tokens[ei].raw
              let varg_tys : Array[String] = []
              body_sb.write_string("  " + vname)
              if ei + 1 < rb && tokens[ei + 1].kind == TokenKind::LParen {
                let vp = find_matching_delim(tokens, ei + 1)
                let mut ai = ei + 2
                let arg_strs : Array[String] = []
                while ai < vp {
                  if tokens[ai].kind == TokenKind::Comma {
                    ai = ai + 1
                    continue
                  }
                  let mut ae = ai
                  let mut ad = 0
                  while ae < vp {
                    let ak = tokens[ae].kind
                    if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace {
                      ad = ad + 1
                    } else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace {
                      ad = ad - 1
                    } else if ad == 0 && ak == TokenKind::Comma {
                      break
                    }
                    ae = ae + 1
                  }
                  // Strip optional MoonBit labeled enum payload prefix: `[mut] name[~] : Type` -> `Type`
                  let mut ty_start = ai
                  if ty_start < ae && tokens[ty_start].kind == TokenKind::Keyword && tokens[ty_start].raw == "mut" {
                    ty_start = ty_start + 1
                  }
                  if ty_start + 1 < ae && tokens[ty_start].kind == TokenKind::Ident {
                    if tokens[ty_start + 1].kind == TokenKind::Tilde && ty_start + 2 < ae && tokens[ty_start + 2].kind == TokenKind::Colon {
                      ty_start = ty_start + 3
                    } else if tokens[ty_start + 1].kind == TokenKind::Colon {
                      ty_start = ty_start + 2
                    }
                  }
                  let aty = lower_type_tokens_checked(ctx, tokens, ty_start, ae, sf.rel_path).trim()
                  if !is_primitive_type(aty) {
                    all_fields_primitive = false
                  }
                  varg_tys.push(aty)
                  arg_strs.push(aty)
                  ai = ae + 1
                }
                body_sb.write_string("(" + join_comma(arg_strs) + ")")
                ei = vp + 1
              } else {
                ei = ei + 1
              }
              enum_variants.push((vname, varg_tys))
              body_sb.write_string("\n")
            } else {
              ei = ei + 1
            }
          }
        }

        for d in pending_derives {
          if d == "Debug" {
            continue
          }
          let mut allowed = d == "Hash"
          for ad in ctx.recipes.allowed_derives {
            if ad == d {
              allowed = true
            }
          }
          for tr in ctx.recipes.trait_recipes {
            if tr.derive_name == d {
              allowed = true
            }
          }
          if !allowed {
            let mut ignored = false
            for ider in ctx.recipes.ignored_derives {
              if ider == d {
                ignored = true
              }
            }
            if ignored {
              continue
            }
          }
          if !allowed {
            ctx.diags.push(diag_error(
              "MBT2PION_UNKNOWN_DERIVE",
              sf.rel_path,
              decl_line,
              decl_col,
              "unrecognized `#derive(" + d + ")` on `" + tname + "` (not in strict allowlist or recipes)",
            ))
          } else {
            if d == "Eq" && all_fields_primitive {
              pion_derives.push("Eq")
            } else if d == "Eq" {
              // Synthesize recursive structural equality function for non-primitive struct or enum
              let eq_fn_name = ctx.recipes.eq_recipe.helper_prefix + ascii_to_lower(tname)
              ctx.symtab.custom_eq_types[tname] = eq_fn_name
              let eq_body = if kind_kw == "struct" {
                gen_struct_eq_body("a", "b", field_types, ctx.symtab.custom_eq_types)
              } else {
                gen_enum_eq_body("a", "b", enum_variants, ctx.symtab.custom_eq_types)
              }
              recipe_impls_sb.write_string("\npub fn " + eq_fn_name + "(a : " + tname + ", b : " + tname + ") -> Bool {\n  " + eq_body + "\n}\n")
            } else if d == "Hash" {
              let mut all_hashable = true
              if kind_kw == "struct" {
                for ft in field_types {
                  if !is_hashable_type(ft.1, ctx.symtab.hashable_types) { all_hashable = false }
                }
              } else {
                for ev in enum_variants {
                  for aty in ev.1 {
                    if !is_hashable_type(aty, ctx.symtab.hashable_types) { all_hashable = false }
                  }
                }
              }
              if !all_hashable {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  decl_line,
                  decl_col,
                  "`#derive(Hash)` on `" + tname + "` contains a non-hashable field or payload type",
                ))
              } else {
                ctx.symtab.hashable_types[tname] = true
                let hc_body = if kind_kw == "struct" {
                  gen_struct_hash_combine_body("self", "hasher", field_types)
                } else {
                  gen_enum_hash_combine_body("self", "hasher", enum_variants)
                }
                recipe_impls_sb.write_string("\nimpl mbt_compat::MbtHash for " + tname + " {\n  fn hash_combine(self : " + tname + ", hasher : mbt_compat::MbtHasher) -> Unit {\n    " + hc_body + "\n  }\n}\n")
                recipe_impls_sb.write_string("\npub fn " + tname + "::hash(self : " + tname + ") -> Int {\n  mbt_compat::mbt_hash(self)\n}\n")
                // §5: When both `Eq` and `Hash` are derived, also emit `impl mbt_compat::MapKey`!
                let mut also_has_eq = false
                for pd in pending_derives {
                  if pd == "Eq" { also_has_eq = true }
                }
                if also_has_eq {
                  let mk_eq_body = if all_fields_primitive {
                    "self == other"
                  } else {
                    ctx.recipes.eq_recipe.helper_prefix + ascii_to_lower(tname) + "(self, other)"
                  }
                  recipe_impls_sb.write_string("\nimpl mbt_compat::MapKey for " + tname + " {\n  fn key_hash(self : " + tname + ") -> Int {\n    mbt_compat::mbt_hash(self)\n  }\n  fn key_eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + mk_eq_body + "\n  }\n}\n")
                }
              }
            }
            // Declarative recipe trait-impl synthesis for BOTH `struct` and `enum` (zero hardcoded project symbols!)
            for tr in ctx.recipes.trait_recipes {
              if tr.derive_name == d {
                let mname = if tr.method_name.length() > 0 { tr.method_name } else { "eq" }
                let eq_body = if kind_kw == "struct" {
                  gen_struct_eq_body("self", "other", field_types, ctx.symtab.custom_eq_types)
                } else {
                  gen_enum_eq_body("self", "other", enum_variants, ctx.symtab.custom_eq_types)
                }
                recipe_impls_sb.write_string("\nimpl " + tr.target_trait + " for " + tname + " {\n")
                if tr.kind == "eq_hash" {
                  let hash_body = if kind_kw == "struct" {
                    gen_struct_hash_body("self", field_types)
                  } else {
                    gen_enum_hash_body("self", enum_variants)
                  }
                  recipe_impls_sb.write_string("  fn eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n")
                  recipe_impls_sb.write_string("  fn hash(self : " + tname + ") -> Int {\n    " + hash_body + "\n  }\n}\n")
                } else {
                  recipe_impls_sb.write_string("  fn " + mname + "(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n}\n")
                }
              }
            }
          }
        }

        let generics = if lb > i + 2 {
          lower_type_tokens_checked(ctx, tokens, i + 2, lb, sf.rel_path)
        } else {
          ""
        }
        let derive_prefix = if pion_derives.length() > 0 {
          "#derive(" + join_comma(pion_derives) + ")\n"
        } else {
          ""
        }
        let type_vis = if kind_kw == "struct" {
          if vis.length() > 0 { vis } else if explicit_priv { "" } else { "pub " }
        } else {
          // §6 Enum visibility:
          // - `pub(all)` / `pub(open)` -> `pub enum` (`can_match: true, can_construct: true` in ABI)
          // - `pub enum` (readonly externally) -> `pub enum` (`can_match: true, can_construct: false` in ABI)
          // - bare `enum` / `priv enum` -> private; fails closed (`MBT2PION_UNSUPPORTED_VISIBILITY`) if exposed in `pub` sig.
          if pub_fields || vis.length() > 0 {
            "pub "
          } else if explicit_priv {
            ""
          } else if ctx.symtab.pub_sig_referenced_types.contains(tname) {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_VISIBILITY",
              sf.rel_path,
              decl_line,
              decl_col,
              "abstract/read-only enum `" + tname + "` is referenced in a public signature, but Pion `pub enum` cannot hide constructors (use `pub(all)` or overlay)",
            ))
            ""
          } else {
            ""
          }
        }
        let decl_code = derive_prefix + type_vis + kind_kw + " " + tname + generics + " {\n" + body_sb.to_string() + "}" + recipe_impls_sb.to_string()
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        let out_start = out_sb.to_string().length()
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: kind_kw + ":" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[decl_end - 1].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: kind_kw + ":" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: kind_kw + ":" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { kind_kw + " contains unsupported syntax" } else { kind_kw + " lowered cleanly" },
        })
        let _ = out_start
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      } else if kind_kw == "struct" && lb < n && tokens[lb].kind == TokenKind::LParen {
        // Tuple struct: `[pub|priv] struct Name[T](A, B, ...)` -> `[pub] struct Name[T] { _0 : A; _1 : B; ... }`
        let rp = find_matching_delim(tokens, lb)
        let mut decl_end = rp + 1
        if decl_end < n && (tokens[decl_end].kind == TokenKind::Keyword || tokens[decl_end].kind == TokenKind::Ident) &&
        tokens[decl_end].raw == "derive" && decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          let dp = find_matching_delim(tokens, decl_end + 1)
          let mut di = decl_end + 2
          while di < dp {
            if tokens[di].kind == TokenKind::UpperIdent || tokens[di].kind == TokenKind::Ident {
              pending_derives.push(tokens[di].raw)
            }
            di = di + 1
          }
          decl_end = dp + 1
        }
        let mut all_fields_primitive = true
        let field_types : Array[(String, String)] = []
        let body_sb = StringBuilder()
        let mut fi = lb + 1
        let mut fidx = 0
        while fi < rp {
          if tokens[fi].kind == TokenKind::Comma {
            fi = fi + 1
            continue
          }
          let mut f_pub = pub_fields
          let mut f_mut = false
          if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "pub" {
            f_pub = true
            fi = fi + 1
          } else if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "priv" {
            f_pub = false
            fi = fi + 1
          }
          if fi < rp && tokens[fi].kind == TokenKind::Keyword && tokens[fi].raw == "mut" {
            f_mut = true
            fi = fi + 1
          }
          let mut f_end = fi
          let mut fd = 0
          while f_end < rp {
            let fk = tokens[f_end].kind
            if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace { fd = fd + 1 }
            else if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { fd = fd - 1 }
            else if fd == 0 && fk == TokenKind::Comma { break }
            f_end = f_end + 1
          }
          if f_end > fi {
            let fname = "_" + fidx.to_string()
            let fty = lower_type_tokens_checked(ctx, tokens, fi, f_end, sf.rel_path).trim()
            if !is_primitive_type(fty) {
              all_fields_primitive = false
            }
            field_types.push((fname, fty))
            body_sb.write_string("  ")
            if f_pub { body_sb.write_string("pub ") }
            if f_mut { body_sb.write_string("mut ") }
            body_sb.write_string(fname + " : " + fty + "\n")
            fidx = fidx + 1
          }
          fi = f_end + 1
        }
        let mut pion_derives : Array[String] = []
        let mut recipe_impls_sb = StringBuilder()
        for d in pending_derives {
          if d == "Debug" {
            continue
          }
          let mut allowed = d == "Hash"
          for ad in ctx.recipes.allowed_derives {
            if ad == d { allowed = true }
          }
          for tr in ctx.recipes.trait_recipes {
            if tr.derive_name == d { allowed = true }
          }
          if !allowed {
            let mut ignored = false
            for ider in ctx.recipes.ignored_derives {
              if ider == d { ignored = true }
            }
            if ignored { continue }
          }
          if !allowed {
            ctx.diags.push(diag_error(
              "MBT2PION_UNKNOWN_DERIVE",
              sf.rel_path,
              decl_line,
              decl_col,
              "unrecognized `#derive(" + d + ")` on `" + tname + "` (not in strict allowlist or recipes)",
            ))
          } else {
            if d == "Eq" && all_fields_primitive {
              pion_derives.push("Eq")
            } else if d == "Eq" {
              let eq_fn_name = ctx.recipes.eq_recipe.helper_prefix + ascii_to_lower(tname)
              ctx.symtab.custom_eq_types[tname] = eq_fn_name
              let eq_body = gen_struct_eq_body("a", "b", field_types, ctx.symtab.custom_eq_types)
              recipe_impls_sb.write_string("\npub fn " + eq_fn_name + "(a : " + tname + ", b : " + tname + ") -> Bool {\n  " + eq_body + "\n}\n")
            } else if d == "Hash" {
              let mut all_hashable = true
              for ft in field_types {
                if !is_hashable_type(ft.1, ctx.symtab.hashable_types) { all_hashable = false }
              }
              if !all_hashable {
                ctx.diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  decl_line,
                  decl_col,
                  "`#derive(Hash)` on `" + tname + "` contains a non-hashable field type",
                ))
              } else {
                ctx.symtab.hashable_types[tname] = true
                let hc_body = gen_struct_hash_combine_body("self", "hasher", field_types)
                recipe_impls_sb.write_string("\nimpl mbt_compat::MbtHash for " + tname + " {\n  fn hash_combine(self : " + tname + ", hasher : mbt_compat::MbtHasher) -> Unit {\n    " + hc_body + "\n  }\n}\n")
                recipe_impls_sb.write_string("\npub fn " + tname + "::hash(self : " + tname + ") -> Int {\n  mbt_compat::mbt_hash(self)\n}\n")
                // §5: When both `Eq` and `Hash` are derived, also emit `impl mbt_compat::MapKey`!
                let mut also_has_eq = false
                for pd in pending_derives {
                  if pd == "Eq" { also_has_eq = true }
                }
                if also_has_eq {
                  let mk_eq_body = if all_fields_primitive {
                    "self == other"
                  } else {
                    ctx.recipes.eq_recipe.helper_prefix + ascii_to_lower(tname) + "(self, other)"
                  }
                  recipe_impls_sb.write_string("\nimpl mbt_compat::MapKey for " + tname + " {\n  fn key_hash(self : " + tname + ") -> Int {\n    mbt_compat::mbt_hash(self)\n  }\n  fn key_eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + mk_eq_body + "\n  }\n}\n")
                }
              }
            }
            for tr in ctx.recipes.trait_recipes {
              if tr.derive_name == d {
                let mname = if tr.method_name.length() > 0 { tr.method_name } else { "eq" }
                let eq_body = gen_struct_eq_body("self", "other", field_types, ctx.symtab.custom_eq_types)
                recipe_impls_sb.write_string("\nimpl " + tr.target_trait + " for " + tname + " {\n")
                if tr.kind == "eq_hash" {
                  let hash_body = gen_struct_hash_body("self", field_types)
                  recipe_impls_sb.write_string("  fn eq(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n")
                  recipe_impls_sb.write_string("  fn hash(self : " + tname + ") -> Int {\n    " + hash_body + "\n  }\n}\n")
                } else {
                  recipe_impls_sb.write_string("  fn " + mname + "(self : " + tname + ", other : " + tname + ") -> Bool {\n    " + eq_body + "\n  }\n}\n")
                }
              }
            }
          }
        }
        let generics = if lb > i + 2 {
          lower_type_tokens_checked(ctx, tokens, i + 2, lb, sf.rel_path)
        } else {
          ""
        }
        let derive_prefix = if pion_derives.length() > 0 {
          "#derive(" + join_comma(pion_derives) + ")\n"
        } else {
          ""
        }
        let type_vis = if vis.length() > 0 { vis } else if explicit_priv { "" } else { "pub " }
        let decl_code = derive_prefix + type_vis + "struct " + tname + generics + " {\n" + body_sb.to_string() + "}" + recipe_impls_sb.to_string()
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "struct:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[decl_end - 1].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: "struct:" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "struct:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "tuple struct contains unsupported syntax" } else { "tuple struct lowered to named-field struct" },
        })
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      } else {
        let mut decl_end = lb
        if decl_end < n && (tokens[decl_end].kind == TokenKind::Keyword || tokens[decl_end].kind == TokenKind::Ident) &&
        tokens[decl_end].raw == "derive" && decl_end + 1 < n && tokens[decl_end + 1].kind == TokenKind::LParen {
          decl_end = find_matching_delim(tokens, decl_end + 1) + 1
        }
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "unsupported brace-less `" + kind_kw + " " + tname + "` declaration",
        ))
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + src_slice)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: kind_kw + ":" + tname,
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "brace-less " + kind_kw + " declaration is unsupported",
        })
        pop_active_generics(ctx, type_added_generics)
        i = decl_end
        continue
      }
    }

    // --- 4. `impl Trait for Type with method(self, ...) -> R { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "impl" {
      // pionc 0.1.0 does not support generic `impl[T : ...]` -> fail loud!
      if i + 1 < n && tokens[i + 1].kind == TokenKind::LBracket {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          sf.rel_path,
          decl_line,
          decl_col,
          "unsupported generic `impl[...]` declaration (pionc does not support generic impl blocks)",
        ))
        let decl_end = skip_top_level_decl(tokens, i, n)
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "impl:generic",
          line: decl_line,
          col: decl_col,
          disposition: "unsupported",
          detail: "generic impl block is unsupported by pionc",
        })
        i = decl_end
        continue
      }
      let mut with_i = -1
      let mut lb = i + 1
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        if tokens[lb].kind == TokenKind::Keyword && tokens[lb].raw == "with" {
          with_i = lb
        }
        lb = lb + 1
      }
      if with_i > i && lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        // Find `for` between `impl` and `with`
        let mut for_i = -1
        let mut k = i + 1
        while k < with_i {
          if tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "for" {
            for_i = k
            break
          }
          k = k + 1
        }
        let trait_name = if for_i > i {
          lower_type_tokens_checked(ctx, tokens, i + 1, for_i, sf.rel_path).trim()
        } else {
          ""
        }
        let self_ty = if for_i > i {
          lower_type_tokens_checked(ctx, tokens, for_i + 1, with_i, sf.rel_path).trim()
        } else {
          ""
        }
        let mname = rename_keyword_ident(tokens[with_i + 1].raw)
        let mut open_p = with_i + 2
        while open_p < lb && tokens[open_p].kind != TokenKind::LParen {
          open_p = open_p + 1
        }
        let close_p = if open_p < lb { find_matching_delim(tokens, open_p) } else { open_p }
        let (p_str, p_pre, _) = if open_p < lb {
          lower_param_list(ctx, tokens, open_p, close_p, sf.rel_path, autofill_loc)
        } else {
          ("", "", false)
        }
        // Ensure `self` has explicit `: SelfTy`
        let typed_params = if p_str == "self" {
          "self : " + self_ty
        } else if p_str.starts_with("self,") {
          "self : " + self_ty + p_str.slice(4, p_str.length())
        } else {
          p_str
        }
        let mut ret_str = ""
        if close_p + 1 < lb && tokens[close_p + 1].kind == TokenKind::Arrow {
          ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, close_p + 2, lb, sf.rel_path)
        } else if close_p + 1 < lb {
          check_unsupported_error_tokens(ctx, tokens, close_p + 1, lb, sf.rel_path)
        }
        let saved_impl_sc = ctx.scope_vars.length()
        if self_ty.length() > 0 && (p_str == "self" || p_str.starts_with("self,") || p_str.starts_with("self ") || p_str.starts_with("self:")) {
          ctx.scope_vars.push(ScopeVar::{ name: "self", ty: self_ty, is_mut: false, is_boxed: false })
        }
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, p_pre)
        restore_scope_vars(ctx, saved_impl_sc)
        let decl_code = if trait_name == "Show" && mname == "output" {
          // MoonBit `impl Show for T with output(self, logger) { ... }` -> Pion `pub fn T::to_string(self : T) -> String`
          // Wrap body in a hygienic zero-arg closure so early `return` returns `Unit` from the closure, not from `to_string`!
          let comma_p = p_str.index_of(",")
          let logger_param = if comma_p > 0 {
            let after_c = p_str.slice(comma_p + 1, p_str.length()).trim()
            let col_c = after_c.index_of(":")
            let raw_lp = if col_c > 0 { after_c.slice(0, col_c).trim() } else { after_c }
            if raw_lp.length() > 0 && raw_lp != "_" { raw_lp } else { "__mbt_logger" }
          } else {
            "__mbt_logger"
          }
          let mut run_var = "__mbt_show_run"
          while run_var == logger_param || str_has(body, run_var) {
            run_var = run_var + "_"
          }
          "pub fn " + self_ty + "::to_string(self : " + self_ty + ") -> String {\n  let " + logger_param + " = StringBuilder()\n  let " + run_var + " : () -> Unit = fn() -> Unit " + body + "\n  " + run_var + "()\n  " + logger_param + ".to_string()\n}"
        } else {
          "impl " + trait_name + " for " + self_ty + " {\n  fn " + mname + "(" + typed_params + ")" + ret_str + " " + body + "\n}"
        }
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "impl:" + trait_name + ":" + self_ty + "::" + mname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "impl:" + trait_name + ":" + self_ty + "::" + mname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "impl method contains unsupported syntax" } else { "impl method lowered cleanly" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 5. Top-level `fn` (including `extern "<abi>" fn`, `fn[T]`, `Type::method`, and body-less `= ...`) ---
    if kw.kind == TokenKind::Keyword && kw.raw == "fn" && i + 1 < n {
      let mut name_start = i + 1
      let mut leading_generics = ""
      let fn_generic_names : Array[String] = []
      if name_start < n && tokens[name_start].kind == TokenKind::LBracket {
        let close_gb = find_matching_delim(tokens, name_start)
        let added_fn_g = push_active_generics(ctx, collect_generic_param_names(tokens, name_start, close_gb))
        for gn in added_fn_g { fn_generic_names.push(gn) }
        leading_generics = lower_generic_bounds_brackets(ctx, tokens, name_start, close_gb, sf.rel_path)
        name_start = close_gb + 1
      }
      let mut name_end = name_start
      let name_sb = StringBuilder()
      while name_end < n && tokens[name_end].kind != TokenKind::LParen && tokens[name_end].kind != TokenKind::LBrace &&
      !(tokens[name_end].newline_before && is_top_level_decl_start(tokens, name_end)) {
        if tokens[name_end].kind == TokenKind::Ident {
          name_sb.write_string(rename_keyword_ident(tokens[name_end].raw))
        } else {
          name_sb.write_string(tokens[name_end].raw)
        }
        name_end = name_end + 1
      }
      let raw_fn_base = name_sb.to_string()
      let fn_name_base = if ctx.cur_is_blackbox && vis.length() == 0 && !str_has(raw_fn_base, "::") {
        match ctx.symtab.blackbox_colliding_privs.get(raw_fn_base) {
          Some(rn) => rn
          None => raw_fn_base
        }
      } else {
        raw_fn_base
      }
      let fn_name = fn_name_base + leading_generics
      if name_end < n && tokens[name_end].kind == TokenKind::LParen {
        let close_p = find_matching_delim(tokens, name_end)
        let (p_str, p_pre, has_opt_def) = lower_param_list(ctx, tokens, name_end, close_p, sf.rel_path, autofill_loc)
        if has_opt_def {
          ctx.migrated_opt_default_fns[fn_name] = true
        }
        let mut lb = close_p + 1
        let mut ret_str = ""
        let mut fn_has_raise = false
        if lb < n && tokens[lb].kind == TokenKind::Arrow {
          let mut r_end = lb + 1
          let mut rd = 0
          let mut test_raise_i = -1
          while r_end < n {
            let rk = tokens[r_end].kind
            if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq ||
              (tokens[r_end].newline_before && is_top_level_decl_start(tokens, r_end))) {
              break
            }
            if rd == 0 && (rk == TokenKind::Keyword || rk == TokenKind::Ident) && tokens[r_end].raw == "raise" {
              fn_has_raise = true
              if sf.is_test && test_raise_i < 0 {
                test_raise_i = r_end
              }
            }
            if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
              rd = rd + 1
            } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
              if rd > 0 { rd = rd - 1 }
            }
            r_end = r_end + 1
          }
          let ty_stop = if test_raise_i > lb { test_raise_i } else { r_end }
          ret_str = " -> " + lower_type_tokens_checked(ctx, tokens, lb + 1, ty_stop, sf.rel_path)
          lb = r_end
        } else {
          let sig_start = lb
          let mut rd = 0
          while lb < n {
            let rk = tokens[lb].kind
            if rd == 0 && (rk == TokenKind::LBrace || rk == TokenKind::Eq ||
              (tokens[lb].newline_before && is_top_level_decl_start(tokens, lb))) {
              break
            }
            if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace {
              rd = rd + 1
            } else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
              if rd > 0 { rd = rd - 1 }
            }
            lb = lb + 1
          }
          // In test files (`*_test.mbt` / `*_wbtest.mbt`), strip bare `raise` on test helpers
          // (assertion helpers use `panic` in Pion instead of MoonBit checked `raise`).
          let is_test_bare_raise = sf.is_test && lb > sig_start &&
          (tokens[sig_start].kind == TokenKind::Keyword || tokens[sig_start].kind == TokenKind::Ident) &&
          tokens[sig_start].raw == "raise"
          if lb > sig_start && (tokens[sig_start].kind == TokenKind::Keyword || tokens[sig_start].kind == TokenKind::Ident) &&
          tokens[sig_start].raw == "raise" {
            fn_has_raise = true
          }
          if is_test_bare_raise {
            ret_str = " -> Unit"
          } else {
            check_unsupported_error_tokens(ctx, tokens, sig_start, lb, sf.rel_path)
          }
        }
        if lb < n && tokens[lb].kind == TokenKind::LBrace {
          if extern_prefix.length() > 0 && extern_abi != "\"C\"" {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              sf.rel_path,
              decl_line,
              decl_col,
              "unsupported non-C extern function ABI `" + extern_abi + "`",
            ))
          }
          let rb = find_matching_delim(tokens, lb)
          let (refs, calls, fn_arg_closures) = collect_init_refs_full(tokens, lb, rb + 1)
          ctx.fn_bodies.push(FnBodyRefs::{ name: fn_name, referenced_idents: refs, called_fns: calls, arg_closure_refs: fn_arg_closures })
          let saved_enclosing = ctx.cur_enclosing_fn
          let saved_ret_ty = ctx.cur_fn_ret_ty
          let saved_raising = ctx.cur_fn_is_raising
          ctx.cur_enclosing_fn = fn_name_base
          ctx.cur_fn_is_raising = fn_has_raise
          let clean_ret_ty = if ret_str.starts_with(" -> ") {
            ret_str.slice(4, ret_str.length()).trim()
          } else {
            ""
          }
          ctx.cur_fn_ret_ty = clean_ret_ty
          let saved_sc = ctx.scope_vars.length()
          let (tp_names, tp_tys, _) = extract_param_info(ctx, tokens, name_end, close_p, sf.rel_path)
          let raw_tp_names = extract_raw_param_names(tokens, name_end, close_p)
          let fn_p_renames = compute_param_renames(raw_tp_names)
          let pushed_fn_renames = fn_p_renames.length() > 0
          if pushed_fn_renames {
            ctx.ident_renames.push(fn_p_renames)
          }
          let mut tpi = 0
          while tpi < tp_names.length() {
            let raw_tp = if tpi < raw_tp_names.length() { raw_tp_names[tpi] } else { tp_names[tpi] }
            let eff_tp_name = match fn_p_renames.get(raw_tp) {
              Some(rn) => rn
              None => tp_names[tpi]
            }
            ctx.scope_vars.push(ScopeVar::{
              name: eff_tp_name,
              ty: if tpi < tp_tys.length() { tp_tys[tpi] } else { "" },
              is_mut: false,
              is_boxed: false,
            })
            tpi = tpi + 1
          }
          ctx.boxed_mut_vars.clear()
          prescan_boxed_mut_vars(tokens, lb, rb, ctx.boxed_mut_vars)
          push_expected_type(ctx, clean_ret_ty)
          let body = lower_fn_body_with_views(ctx, tokens, lb, rb, sf.rel_path, p_pre)
          pop_expected_type(ctx)
          if pushed_fn_renames {
            let _ = ctx.ident_renames.pop()
          }
          ctx.boxed_mut_vars.clear()
          restore_scope_vars(ctx, saved_sc)
          ctx.cur_enclosing_fn = saved_enclosing
          ctx.cur_fn_ret_ty = saved_ret_ty
          ctx.cur_fn_is_raising = saved_raising
          for gn in fn_generic_names {
            ctx.active_generics.remove(gn)
            ctx.symtab.active_generics.remove(gn)
          }
          let decl_code = vis + extern_prefix + "fn " + fn_name + "(" + p_str + ")" + ret_str + " " + body
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
          let anchor_start = out_sb.to_string().length()
          out_sb.write_string(decl_code)
          let anchor_end = out_sb.to_string().length()
          anchors.push(DeclAnchor::{
            source_file: sf.rel_path,
            decl_identity: "fn:" + fn_name,
            normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
            pre_overlay_generated_hash: content_sha256(decl_code),
            start_byte: anchor_start,
            end_byte: anchor_end,
            line: decl_line,
            col: decl_col,
          })
          ctx.span_map.push(SpanMapEntry::{
            src_file: sf.rel_path,
            src_start: tokens[decl_start].start_byte,
            src_end: tokens[rb].end_byte,
            src_line: decl_line,
            src_col: decl_col,
            out_file: out_rel,
            out_line: decl_line,
            out_col: decl_col,
            out_start: anchor_start,
            out_end: anchor_end,
            kind: "fn:" + fn_name,
          })
          let had_err = count_error_diags(ctx.diags) > decl_err_before
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: if had_err { "unsupported" } else { "transpiled" },
            detail: if had_err { "function contains unsupported syntax" } else { "function lowered cleanly" },
          })
          i = rb + 1
          continue
        } else if lb < n && tokens[lb].kind == TokenKind::Eq {
          let mut decl_end = find_expr_end(tokens, lb + 1, n)
          while decl_end < n && tokens[decl_end].kind == TokenKind::StringLit && !tokens[decl_end].newline_before {
            decl_end = decl_end + 1
          }
          let rhs_raw = if decl_end > lb + 1 {
            sf.content.slice(tokens[lb + 1].start_byte, tokens[decl_end - 1].end_byte).trim()
          } else {
            ""
          }
          let is_legal_c_ffi = extern_abi == "\"C\"" && decl_end == lb + 2 && tokens[lb + 1].kind == TokenKind::StringLit
          if !is_legal_c_ffi {
            ctx.diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              sf.rel_path,
              decl_line,
              decl_col,
              "unsupported MoonBit extern/intrinsic function declaration `= ...` (requires explicit lowering or overlay)",
            ))
          } else {
            let ret_ty = if ret_str.starts_with(" -> ") {
              ret_str.slice(4, ret_str.length()).trim()
            } else {
              "Unit"
            }
            if pending_ffi_attrs.length() > 0 || !check_pion_c_abi_params(p_str) || !is_pion_c_abi_ret_type(ret_ty) {
              ctx.diags.push(diag_error(
                "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
                sf.rel_path,
                decl_line,
                decl_col,
                "extern \"C\" function `" + fn_name + "` uses non-C-ABI Pion type or unsupported MoonBit FFI attribute (requires explicit lowering or overlay)",
              ))
            }
          }
          let decl_code = if is_legal_c_ffi {
            vis + "extern \"C\" fn " + fn_name + "(" + p_str + ")" + ret_str + " = " + rhs_raw
          } else {
            vis + extern_prefix + "fn " + fn_name + "(" + p_str + ")" + ret_str + " = " + rhs_raw
          }
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
          let anchor_start = out_sb.to_string().length()
          out_sb.write_string(decl_code)
          let anchor_end = out_sb.to_string().length()
          anchors.push(DeclAnchor::{
            source_file: sf.rel_path,
            decl_identity: "fn:" + fn_name,
            normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
            pre_overlay_generated_hash: content_sha256(decl_code),
            start_byte: anchor_start,
            end_byte: anchor_end,
            line: decl_line,
            col: decl_col,
          })
          ctx.span_map.push(SpanMapEntry::{
            src_file: sf.rel_path,
            src_start: tokens[decl_start].start_byte,
            src_end: tokens[decl_end - 1].end_byte,
            src_line: decl_line,
            src_col: decl_col,
            out_file: out_rel,
            out_line: decl_line,
            out_col: decl_col,
            out_start: anchor_start,
            out_end: anchor_end,
            kind: "fn:" + fn_name,
          })
          let had_err = count_error_diags(ctx.diags) > decl_err_before
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: if had_err { "unsupported" } else { "transpiled" },
            detail: if had_err { "extern/intrinsic function requires explicit lowering or overlay" } else { "extern \"C\" function lowered cleanly" },
          })
          i = decl_end
          continue
        } else {
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_SYNTAX",
            sf.rel_path,
            decl_line,
            decl_col,
            "unsupported body-less function declaration `" + fn_name + "`",
          ))
          let decl_end = lb
          let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[decl_end - 1].end_byte)
          out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + src_slice)
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "fn:" + fn_name,
            line: decl_line,
            col: decl_col,
            disposition: "unsupported",
            detail: "body-less function declaration is unsupported",
          })
          i = decl_end
          continue
        }
      }
    }

    // --- 5b. Top-level `trait Name { ... }` ---
    if kw.kind == TokenKind::Keyword && kw.raw == "trait" && i + 1 < n {
      let tname = tokens[i + 1].raw
      let mut trait_added_g : Array[String] = []
      if i + 2 < n && tokens[i + 2].kind == TokenKind::LBracket {
        let cgb = find_matching_delim(tokens, i + 2)
        trait_added_g = push_active_generics(ctx, collect_generic_param_names(tokens, i + 2, cgb))
      }
      let mut lb = i + 2
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      check_unsupported_error_tokens(ctx, tokens, i + 2, lb, sf.rel_path)
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let header_extra = if lb > i + 2 {
          " " + sf.content.slice(tokens[i + 2].start_byte, tokens[lb - 1].end_byte).trim()
        } else {
          ""
        }
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        pop_active_generics(ctx, trait_added_g)
        let decl_code = vis + "trait " + tname + header_extra + " " + body
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "trait:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        ctx.span_map.push(SpanMapEntry::{
          src_file: sf.rel_path,
          src_start: tokens[decl_start].start_byte,
          src_end: tokens[rb].end_byte,
          src_line: decl_line,
          src_col: decl_col,
          out_file: out_rel,
          out_line: decl_line,
          out_col: decl_col,
          out_start: anchor_start,
          out_end: anchor_end,
          kind: "trait:" + tname,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "trait:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "trait contains unsupported syntax" } else { "trait lowered cleanly" },
        })
        i = rb + 1
        continue
      }
    }

    // --- 6. `test "name" { ... }` (and unnamed `test { ... }` -> deterministic `"<file>_L<line>"`) ---
    if kw.kind == TokenKind::Keyword && kw.raw == "test" {
      let mut lb = i + 1
      let mut tname = "\"" + file_id + "_L" + decl_line.to_string() + "\""
      if lb < n && tokens[lb].kind == TokenKind::StringLit {
        tname = tokens[lb].raw
        lb = lb + 1
      }
      while lb < n && tokens[lb].kind != TokenKind::LBrace &&
      !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
        lb = lb + 1
      }
      if lb < n && tokens[lb].kind == TokenKind::LBrace {
        let rb = find_matching_delim(tokens, lb)
        let saved_tb = ctx.cur_in_test_block
        ctx.cur_in_test_block = true
        let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
        ctx.cur_in_test_block = saved_tb
        let decl_code = "test " + tname + " " + body
        let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
        out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia)
        let anchor_start = out_sb.to_string().length()
        out_sb.write_string(decl_code)
        let anchor_end = out_sb.to_string().length()
        anchors.push(DeclAnchor::{
          source_file: sf.rel_path,
          decl_identity: "test:" + tname,
          normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
          pre_overlay_generated_hash: content_sha256(decl_code),
          start_byte: anchor_start,
          end_byte: anchor_end,
          line: decl_line,
          col: decl_col,
        })
        let had_err = count_error_diags(ctx.diags) > decl_err_before
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "test:" + tname,
          line: decl_line,
          col: decl_col,
          disposition: if had_err { "unsupported" } else { "transpiled" },
          detail: if had_err { "test block contains unsupported syntax" } else { "test block lowered with assertions preserved" },
        })
        i = rb + 1
        continue
      }
    }

    // Fallback: emit single token/form
    out_sb.write_string(attrs_trivia.to_string() + kept_attrs.to_string() + vis_trivia + vis)
    let (piece, next_i) = lower_one_token_or_form(ctx, tokens, i, n, sf.rel_path, false)
    out_sb.write_string(piece)
    i = next_i
  }

  // Append any lifted package-private top-level functions for recursive local `fn`s (Wave M1.2 A.2)
  if ctx.lifted_fns.length() > 0 {
    out_sb.write_string("\n")
    for lf in ctx.lifted_fns {
      out_sb.write_string(lf)
      out_sb.write_string("\n")
    }
  }

  // Append trailing EOF trivia
  if tokens.length() > 0 {
    out_sb.write_string(tokens[tokens.length() - 1].leading_trivia)
  }

  GeneratedFile::{
    rel_path: out_rel,
    content: out_sb.to_string(),
    source_file: sf.rel_path,
    anchors: anchors,
  }
}

///| Generate a recursive structural equality expression for two values of type `ty`
///| (handles `Option[T]` and `Array[T]` without emitting invalid Pion `==`!).
///| Split top-level comma-separated tuple element types inside `(...)`.
fn split_tuple_types(inner : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i < inner.length() {
    let c = inner.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 { depth = depth + 1 }
    else if c == 41 || c == 93 || c == 125 { if depth > 0 { depth = depth - 1 } }
    else if c == 44 && depth == 0 {
      out.push(inner.slice(start, i).trim())
      start = i + 1
    }
    i = i + 1
  }
  let tail = inner.slice(start, inner.length()).trim()
  if tail.length() > 0 { out.push(tail) }
  out
}

fn gen_eq_expr(a : String, b : String, ty : String, depth : Int, custom_eq : Map[String, String]) -> String {
  let t = ty.trim()
  match custom_eq.get(t) {
    Some(eq_fn) => return eq_fn + "(" + a + ", " + b + ")"
    None => ()
  }
  if t == "Bytes" {
    return "mbt_compat::bytes_eq(" + a + ", " + b + ")"
  }
  if t == "MbtJson" || t == "mbt_compat::MbtJson" {
    return "mbt_compat::mbt_json_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("OrderedSet[") || t.starts_with("mbt_compat::OrderedSet[") {
    return "mbt_compat::ordered_set_eq(" + a + ", " + b + ")"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let sb = StringBuilder()
      let mut k = 0
      while k < elems.length() {
        if k > 0 { sb.write_string(" && ") }
        let ak = "(" + a + ")." + k.to_string()
        let bk = "(" + b + ")." + k.to_string()
        sb.write_string("(" + gen_eq_expr(ak, bk, elems[k], depth * 10 + k + 1, custom_eq) + ")")
        k = k + 1
      }
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ax = "__oa_" + depth.to_string()
    let bx = "__ob_" + depth.to_string()
    let inner_eq = gen_eq_expr(ax, bx, inner, depth + 1, custom_eq)
    return "match (" + a + ", " + b + ") { (Some(" + ax + "), Some(" + bx + ")) => " + inner_eq + ", (None, None) => true, _ => false }"
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let idx = "__ai_" + depth.to_string()
    let eqv = "__aeq_" + depth.to_string()
    let elem_eq = gen_eq_expr(a + "[" + idx + "]", b + "[" + idx + "]", inner, depth + 1, custom_eq)
    return "{ let mut " + eqv + " = " + a + ".length() == " + b + ".length(); if " + eqv + " { let mut " + idx + " = 0; while " + idx + " < " + a + ".length() { if !(" + elem_eq + ") { " + eqv + " = false; break }; " + idx + " = " + idx + " + 1 } }; " + eqv + " }"
  }
  a + " == " + b
}

fn gen_struct_eq_body(lhs : String, rhs : String, field_types : Array[(String, String)], custom_eq : Map[String, String]) -> String {
  if field_types.length() == 0 {
    return "true"
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < field_types.length() {
    if k > 0 {
      sb.write_string(" && ")
    }
    let ft = field_types[k]
    sb.write_string("(" + gen_eq_expr(lhs + "." + ft.0, rhs + "." + ft.0, ft.1, k, custom_eq) + ")")
    k = k + 1
  }
  sb.to_string()
}

fn gen_enum_eq_body(lhs : String, rhs : String, variants : Array[(String, Array[String])], custom_eq : Map[String, String]) -> String {
  if variants.length() == 0 {
    return "true"
  }
  let sb = StringBuilder()
  sb.write_string("match (" + lhs + ", " + rhs + ") {\n")
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      (." + vname + ", ." + vname + ") => true\n")
    } else {
      let la : Array[String] = []
      let ra : Array[String] = []
      let conds = StringBuilder()
      let mut k = 0
      while k < args.length() {
        let an = "__a" + k.to_string()
        let bn = "__b" + k.to_string()
        la.push(an)
        ra.push(bn)
        if k > 0 {
          conds.write_string(" && ")
        }
        conds.write_string("(" + gen_eq_expr(an, bn, args[k], k, custom_eq) + ")")
        k = k + 1
      }
      sb.write_string("      (." + vname + "(" + join_comma(la) + "), ." + vname + "(" + join_comma(ra) + ")) => " + conds.to_string() + "\n")
    }
  }
  sb.write_string("      _ => false\n    }")
  sb.to_string()
}

///| Check whether `ty` is statically hashable for `#derive(Hash)` synthesis (fail-closed on unknown/non-hashable types).
fn is_hashable_type(ty : String, hashable_types : Map[String, Bool]) -> Bool {
  let t = ty.trim()
  if t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Double" || t == "Float" || t == "Bool" || t == "Byte" ||
  t == "Char" || t == "String" || t == "Unit" {
    return true
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    return is_hashable_type(t.slice(7, t.length() - 1), hashable_types)
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    return is_hashable_type(t.slice(6, t.length() - 1), hashable_types)
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      for el in elems {
        if !is_hashable_type(el, hashable_types) {
          return false
        }
      }
      return true
    }
  }
  hashable_types.contains(strip_type_args_sym(t))
}

///| Generate a deterministic FNV-1a / mix hash expression for a value of type `ty`.
fn gen_hash_expr(v : String, ty : String, depth : Int) -> String {
  let t = ty.trim()
  if t == "Int" {
    return v
  }
  if t == "Int64" {
    return "(" + v + " ^ (" + v + " >> 32L)).to_int()"
  }
  if t == "UInt" {
    return v + ".reinterpret_as_int()"
  }
  if t == "UInt64" {
    let x = "__hu" + depth.to_string()
    return "{ let " + x + " = " + v + ".reinterpret_as_int64(); (" + x + " ^ (" + x + " >> 32L)).to_int() }"
  }
  if t == "Double" {
    return "mbt_compat::double_hash(" + v + ")"
  }
  if t == "Float" {
    return "mbt_compat::double_hash(" + v + ".to_double())"
  }
  if t == "Bool" {
    return "if " + v + " { 1 } else { 0 }"
  }
  if t == "Byte" || t == "Char" {
    return v + ".to_int()"
  }
  if t == "String" {
    return "mbt_compat::hash_string(" + v + ")"
  }
  if t == "Unit" {
    return "0"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let th = "__hth" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let mut " + th + " = -2128831035; ")
      let mut k = 0
      while k < elems.length() {
        let eh = gen_hash_expr(v + "." + k.to_string(), elems[k], depth + 1 + k)
        sb.write_string(th + " = (" + th + " ^ (" + eh + ")) * 16777619; ")
        k = k + 1
      }
      sb.write_string(th + " }")
      return sb.to_string()
    }
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let ov = "__ho" + depth.to_string()
    let ih = gen_hash_expr(ov, inner, depth + 1)
    return "match " + v + " { Some(" + ov + ") => ((-2128831035 ^ 1) * 16777619 ^ (" + ih + ")) * 16777619, None => 0 }"
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let ah = "__hah" + depth.to_string()
    let ai = "__hai" + depth.to_string()
    let eh = gen_hash_expr(v + "[" + ai + "]", inner, depth + 1)
    return "{ let mut " + ah + " = -2128831035; let mut " + ai + " = 0; while " + ai + " < " + v + ".length() { " + ah + " = (" + ah + " ^ (" + eh + ")) * 16777619; " + ai + " = " + ai + " + 1 }; " + ah + " }"
  }
  // Recursive trait `hash` call for nested key types
  v + ".hash()"
}

fn gen_hash_combine_stmt(v : String, ty : String, hasher : String, depth : Int) -> String {
  let t = ty.trim()
  if t == "Unit" {
    return hasher + ".combine_unit()"
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    let inner = t.slice(7, t.length() - 1).trim()
    let hv = "__hv" + depth.to_string()
    return "match " + v + " { Option::None => " + hasher + ".combine_int(0), Option::Some(" + hv + ") => { " + hasher + ".combine_int(1); " + gen_hash_combine_stmt(hv, inner, hasher, depth + 1) + " } }"
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    let inner = t.slice(6, t.length() - 1).trim()
    let he = "__he" + depth.to_string()
    return "for " + he + " in " + v + " { " + gen_hash_combine_stmt(he, inner, hasher, depth + 1) + " }"
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      let ht = "__ht" + depth.to_string()
      let sb = StringBuilder()
      sb.write_string("{ let " + ht + " = " + v + "; ")
      let mut idx = 0
      while idx < elems.length() {
        sb.write_string(gen_hash_combine_stmt(ht + "." + idx.to_string(), elems[idx], hasher, depth + 1) + "; ")
        idx = idx + 1
      }
      sb.write_string("}")
      return sb.to_string()
    }
  }
  v + ".hash_combine(" + hasher + ")"
}

fn gen_struct_hash_combine_body(self_var : String, hasher : String, field_types : Array[(String, String)]) -> String {
  if field_types.length() == 0 {
    return "let _ = " + hasher
  }
  let sb = StringBuilder()
  let mut k = 0
  while k < field_types.length() {
    let ft = field_types[k]
    if k > 0 { sb.write_string("\n    ") }
    sb.write_string(gen_hash_combine_stmt(self_var + "." + ft.0, ft.1, hasher, k))
    k = k + 1
  }
  sb.to_string()
}

fn gen_enum_hash_combine_body(self_var : String, hasher : String, variants : Array[(String, Array[String])]) -> String {
  if variants.length() == 0 {
    return "let _ = " + hasher
  }
  let sb = StringBuilder()
  sb.write_string("match " + self_var + " {\n")
  let mut tag = 0
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      ." + vname + " => " + hasher + ".combine_int(" + tag.to_string() + ")\n")
    } else {
      let pat_vars : Array[String] = []
      let body_sb = StringBuilder()
      body_sb.write_string("{ " + hasher + ".combine_int(" + tag.to_string() + "); ")
      let mut k = 0
      while k < args.length() {
        let vn = "__v" + k.to_string()
        pat_vars.push(vn)
        body_sb.write_string(gen_hash_combine_stmt(vn, args[k], hasher, k) + "; ")
        k = k + 1
      }
      body_sb.write_string("}")
      sb.write_string("      ." + vname + "(" + join_comma(pat_vars) + ") => " + body_sb.to_string() + "\n")
    }
    tag = tag + 1
  }
  sb.write_string("    }")
  sb.to_string()
}

fn gen_struct_hash_body(self_var : String, field_types : Array[(String, String)]) -> String {
  if field_types.length() == 0 {
    return "0"
  }
  let sb = StringBuilder()
  sb.write_string("let mut __h = -2128831035\n")
  let mut k = 0
  while k < field_types.length() {
    let ft = field_types[k]
    sb.write_string("    __h = (__h ^ (" + gen_hash_expr(self_var + "." + ft.0, ft.1, k) + ")) * 16777619\n")
    k = k + 1
  }
  sb.write_string("    mbt_compat::hash_mix(__h)")
  sb.to_string()
}

fn gen_enum_hash_body(self_var : String, variants : Array[(String, Array[String])]) -> String {
  if variants.length() == 0 {
    return "0"
  }
  let sb = StringBuilder()
  sb.write_string("match " + self_var + " {\n")
  let mut tag = 1
  for v in variants {
    let vname = v.0
    let args = v.1
    if args.length() == 0 {
      sb.write_string("      ." + vname + " => mbt_compat::hash_mix((-2128831035 ^ " + tag.to_string() + ") * 16777619)\n")
    } else {
      let pat_vars : Array[String] = []
      let body_sb = StringBuilder()
      body_sb.write_string("{ let mut __h = (-2128831035 ^ " + tag.to_string() + ") * 16777619; ")
      let mut k = 0
      while k < args.length() {
        let vn = "__v" + k.to_string()
        pat_vars.push(vn)
        body_sb.write_string("__h = (__h ^ (" + gen_hash_expr(vn, args[k], k) + ")) * 16777619; ")
        k = k + 1
      }
      body_sb.write_string("mbt_compat::hash_mix(__h) }")
      sb.write_string("      ." + vname + "(" + join_comma(pat_vars) + ") => " + body_sb.to_string() + "\n")
    }
    tag = tag + 1
  }
  sb.write_string("    }")
  sb.to_string()
}

fn join_comma(xs : Array[String]) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < xs.length() {
    if i > 0 {
      sb.write_string(", ")
    }
    sb.write_string(xs[i])
    i = i + 1
  }
  sb.to_string()
}
