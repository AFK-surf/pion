///| Unit tests for MbtJson expected-type propagation, `if`/`match` type inference
///| isolation, `is` float-literal pattern desugaring, field-chain `.push`/`.set`,
///| tuple expected-type propagation, and local `let` closure inference/call propagation.

test "stage A: if/match infer_expr_type_f3d2 never falls through to Bool and shadows is binders" {
  let src = SourceFile::{
    rel_path: "json_if_match_infer.mbt",
    content: "pub enum Tag {\n" +
    "  Tag(Int)\n" +
    "}\n\n" +
    "pub fn check_infer(w : Int, col_w : Int, s : String, n : Json, p : Map[String, Json]) -> Json {\n" +
    "  let kept = if w == col_w {\n" +
    "    Json::null()\n" +
    "  } else {\n" +
    "    Json::string(s)\n" +
    "  }\n" +
    "  let num_val = (if n is Number(n, ..) { Some(n) } else { None }).unwrap_or(0.0)\n" +
    "  let dirs = match p.get(\"k\") {\n" +
    "    Some(Array(a)) => a.copy()\n" +
    "    _ => []\n" +
    "  }\n" +
    "  let _ = num_val\n" +
    "  { \"kept\": kept, \"dirs\": dirs }\n" +
    "}\n\n" +
    "pub fn check_shadow_non_json(n : Json, t : Tag) -> Int {\n" +
    "  let _ = n\n" +
    "  (if t is Tag(n) { Some(n) } else { None }).unwrap_or(0)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "check_infer blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(!str_has(out, "MbtJson::boolean(kept)"), "if-expr Json local must never be inferred as Bool: " + out)
  assert_true(str_has(out, "(\"kept\", kept)"), "kept must stay MbtJson directly: " + out)
  assert_true(str_has(out, ".unwrap_or(0.0)"), "is Number(n, ..) must shadow outer Json n so 0.0 stays Double: " + out)
  assert_true(!str_has(out, ".unwrap_or(mbt_compat::MbtJson::Number("), "0.0 must not be wrapped as MbtJson: " + out)
  assert_true(str_has(out, "(\"dirs\", mbt_compat::MbtJson::array(dirs))"), "Some(Array(a)) => a.copy() must infer Array[MbtJson]: " + out)
  assert_true(str_has(out, ".unwrap_or(0)"), "non-Json binder shadow must keep Int 0: " + out)
}

test "stage A: is float-literal patterns desugar in standalone, if-chain, and guard" {
  let src = SourceFile::{
    rel_path: "is_float_pat.mbt",
    content: "pub fn check_floats(v : Json?, j : Json, pair : (Double, String)?, flag : Bool) -> Int {\n" +
    "  let ok1 = v is Some(Number(17.0, _))\n" +
    "  let ok2 = j is Number(7.0, ..)\n" +
    "  let ok3 = v is Some(Number(-1.5, _))\n" +
    "  if flag && pair is Some((1.5, label)) && label == \"ok\" {\n" +
    "    let _ = (ok1, ok2, ok3)\n" +
    "    return 1\n" +
    "  }\n" +
    "  guard pair is Some((2.5, tag)) else {\n" +
    "    return 0\n" +
    "  }\n" +
    "  tag.length()\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "is_float_pat blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(!str_has(out, "Number(17.0"), "raw 17.0 must not remain in pattern: " + out)
  assert_true(!str_has(out, "Number(7.0"), "raw 7.0 must not remain in pattern: " + out)
  assert_true(!str_has(out, "Number(-1.5"), "raw -1.5 must not remain in pattern: " + out)
  assert_true(str_has(out, "== 17.0"), "standalone is 17.0 must emit float guard: " + out)
  assert_true(str_has(out, "== 7.0"), "standalone is 7.0 with rest must emit float guard: " + out)
  assert_true(str_has(out, "== -1.5"), "standalone is -1.5 must emit negative float guard: " + out)
  assert_true(str_has(out, "== 1.5") && str_has(out, "label == \"ok\""), "if-chain float pattern must preserve user binder label: " + out)
  assert_true(str_has(out, "== 2.5") && str_has(out, "tag.length()"), "guard float pattern must preserve user binder tag: " + out)
}

test "stage A: match/if branch tail wrapping and multi-statement block expected type" {
  let src = SourceFile::{
    rel_path: "json_branch_tail.mbt",
    content: "pub fn build_payload(opt : Json?, arr : Array[Json], cond : Bool, key : String) -> Json? {\n" +
    "  match key {\n" +
    "    \"k\" => {\n" +
    "      let count = 1\n" +
    "      let _ = count\n" +
    "      Some({\n" +
    "        \"a\": 1.0,\n" +
    "        \"b\": false,\n" +
    "        \"s\": match opt {\n" +
    "          Some(String(x)) => x\n" +
    "          _ => \"\"\n" +
    "        },\n" +
    "        \"items\": if cond {\n" +
    "          arr.copy()\n" +
    "        } else {\n" +
    "          Json::null()\n" +
    "        }\n" +
    "      })\n" +
    "    }\n" +
    "    _ => None\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "json_branch_tail blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "let count = 1"), "preceding stmt in multi-stmt arm must not wrap 1 as MbtJson: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::Object("), "tail Some({ ... }) must receive MbtJson expected type: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::String(x)"), "match arm tail String binder must wrap as MbtJson::String: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::array(arr.copy())"), "if branch tail Array[MbtJson] must wrap as MbtJson::array: " + out)
}

test "stage A: Bool stdlib methods, field-chain push/set, and tuple expected type propagation" {
  let src = SourceFile::{
    rel_path: "json_methods_chains_tuples.mbt",
    content: "pub struct Cell[T] {\n" +
    "  mut v : T\n" +
    "}\n\n" +
    "pub fn[T] Cell::set(self : Cell[T], x : T) -> Unit {\n" +
    "  self.v = x\n" +
    "}\n\n" +
    "pub struct Counter[T] {\n" +
    "  mut n : Int\n" +
    "}\n\n" +
    "pub fn[T] Counter::set(self : Counter[T], flag : Int) -> Unit {\n" +
    "  self.n = flag\n" +
    "}\n\n" +
    "pub struct BoxHolder {\n" +
    "  available : Cell[Json?]\n" +
    "  items : Array[Json]\n" +
    "  counter : Counter[Json]\n" +
    "  kv : Map[String, Json]\n" +
    "}\n\n" +
    "pub struct State {\n" +
    "  holder : BoxHolder\n" +
    "}\n\n" +
    "pub fn check_all(st : State, s : String, xs : Array[String], w : String) -> (String, Json?)? {\n" +
    "  st.holder.items.push({\n" +
    "    \"pre\": s.has_prefix(\"ab\"),\n" +
    "    \"suf\": s.has_suffix(\"yz\"),\n" +
    "    \"has\": s.contains(\"m\"),\n" +
    "    \"empty\": xs.is_empty()\n" +
    "  })\n" +
    "  st.holder.available.set(Some({ \"ok\": true }))\n" +
    "  st.holder.counter.set(42)\n" +
    "  st.holder.kv.set(\"k\", 1.0,)\n" +
    "  Some((w, Some({ \"loaded\": 6000.0 })))\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "json_methods_chains_tuples blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::MbtJson::boolean(s.has_prefix(\"ab\"))"), "has_prefix must wrap as MbtJson::boolean: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::boolean(s.has_suffix(\"yz\"))"), "has_suffix must wrap as MbtJson::boolean: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::boolean(s.contains(\"m\"))"), "contains must wrap as MbtJson::boolean: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::boolean(xs.is_empty())"), "is_empty must wrap as MbtJson::boolean: " + out)
  assert_true(str_has(out, "st.holder.available.set(Some(mbt_compat::MbtJson::Object("), "field-chain Cell.set must propagate Option[MbtJson]: " + out)
  assert_true(str_has(out, "st.holder.counter.set(42)"), "custom Counter.set must NOT wrap 42 as MbtJson: " + out)
  assert_true(!str_has(out, "1.0,)"), "trailing comma in 2-arg set must be stripped: " + out)
  assert_true(str_has(out, "Some((w, Some(mbt_compat::MbtJson::Object("), "tuple expected type must propagate into second element: " + out)
}

test "stage A: local let closure param inference and call-site expected type propagation" {
  let src = SourceFile::{
    rel_path: "local_closure_infer_prop.mbt",
    content: "pub struct Item {\n" +
    "  id : Int\n" +
    "}\n\n" +
    "fn row(id : String, title : String, tag : String, ago : String, more : Bool) -> Int {\n" +
    "  let _ = (id, title, tag, ago, more)\n" +
    "  0\n" +
    "}\n\n" +
    "fn run_cb(cb : () -> Unit) -> Unit {\n" +
    "  cb()\n" +
    "}\n\n" +
    "pub fn test_closures(done : (Item) -> Unit) -> Unit {\n" +
    "  let emit = fn(id, title, extra : Map[String, Json]) {\n" +
    "    let _ = row(id, title, \"x\", \"now\", false)\n" +
    "    let _ = extra\n" +
    "  }\n" +
    "  emit(\"a\", \"b\", { \"count\": 3.0 })\n" +
    "  let done = fn(r) {\n" +
    "    run_cb(fn() { done(r) })\n" +
    "  }\n" +
    "  done(Item::{ id: 1 })\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "local_closure_infer_prop blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "fn(id : String, title : String, extra : mbt_compat::OrderedMap[String, mbt_compat::MbtJson])"), "must infer id and title even with comma-bearing generic param: " + out)
  assert_true(str_has(out, "(\"count\", mbt_compat::MbtJson::Number("), "call to local closure emit must propagate Map[String, MbtJson] to arg: " + out)
  assert_true(str_has(out, "let done = fn(r : Item)"), "must infer r : Item from outer shadowed closure done : (Item) -> Unit: " + out)
}

test "stage A: float is-patterns fail closed on nested pipe, array, and struct patterns" {
  let cases : Array[(String, String)] = [
    ("nested_pipe_if", "pub fn f(x : Double?) -> Int {\n  if x is Some(1.5 | 2.5) { 1 } else { 0 }\n}\n"),
    ("nested_pipe_guard", "pub fn f(x : Json?) -> Int {\n  guard x is Some(Number(1.0, ..) | Number(2.0, ..)) else { return 0 }\n  1\n}\n"),
    ("standalone_array_float", "pub fn f(x : Array[Double]?) -> Bool {\n  x is Some([1.5])\n}\n"),
    ("standalone_struct_float", "pub struct Pt { x : Double; y : Int }\npub fn f(p : Pt) -> Bool {\n  p is { x: 1.5, y: 1 }\n}\n"),
    ("if_struct_float", "pub struct Pt { x : Double; y : Int }\npub fn f(p : Pt) -> Int {\n  if p is { x: 1.5, y } { y } else { 0 }\n}\n"),
  ]
  for c in cases {
    let src = SourceFile::{ rel_path: c.0 + ".mbt", content: c.1, is_test: false }
    let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
    let mut saw_unsup = false
    for d in res.diagnostics {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_unsup = true }
    }
    assert_true(saw_unsup, "case " + c.0 + " must fail closed with MBT2PION_UNSUPPORTED_SYNTAX")
  }
}

test "stage A: IIFE closure RHS does not pollute local_closure_params" {
  let src = SourceFile::{
    rel_path: "iife_no_pollute.mbt",
    content: "fn make_int_fn() -> (Int) -> Int {\n" +
    "  fn(n : Int) { n + 1 }\n" +
    "}\n\n" +
    "pub fn run() -> Int {\n" +
    "  let cb = fn(x : Json) {\n" +
    "    let _ = x\n" +
    "    make_int_fn()\n" +
    "  }(Json::null())\n" +
    "  cb(42)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "iife_no_pollute blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "cb(42)"), "IIFE result cb(42) must keep Int 42 untouched: " + out)
  assert_true(!str_has(out, "cb(mbt_compat::MbtJson::"), "IIFE must never leak outer closure Json param into cb(42): " + out)
}

test "stage A: @dep.val.field chain, Ref.val = rhs propagation, and arr.map(fn_var) inference" {
  let dep_doc = "{\"packages\":[{\"name\":\"dep\",\"items\":[" +
  "{\"kind\":\"struct\",\"name\":\"Cell\",\"sig\":\"pub struct Cell[T] { mut v : T }\"}," +
  "{\"kind\":\"fn\",\"name\":\"Cell::set\",\"sig\":\"pub fn[T] Cell::set(self : Cell[T], x : T) -> Unit\"}," +
  "{\"kind\":\"struct\",\"name\":\"Holder\",\"sig\":\"pub struct Holder { available : Cell[Option[mbt_compat::MbtJson]] }\"}," +
  "{\"kind\":\"let\",\"name\":\"holder\",\"sig\":\"pub let holder : Holder\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "dep_ref_map.mbt",
    content: "fn transform(x : Json) -> Json {\n" +
    "  x\n" +
    "}\n\n" +
    "pub fn update(box_ref : Ref[(String, Json?)?], mode : String, k : String, xs : Array[Json], fxs : FixedArray[Json], cond : Bool) -> Json {\n" +
    "  @dep.holder.available.set(Some({ \"ok\": true }))\n" +
    "  box_ref.val = match mode {\n" +
    "    \"a\" => Some((k, Some({ \"loaded\": 6000.0 })))\n" +
    "    _ => None\n" +
    "  }\n" +
    "  let _mapped_fixed : FixedArray[Json] = fxs.map(transform)\n" +
    "  {\n" +
    "    \"items\": if cond {\n" +
    "      Json::null()\n" +
    "    } else if !cond {\n" +
    "      xs.map(transform)\n" +
    "    } else {\n" +
    "      Json::null()\n" +
    "    },\n" +
    "    \"fixed_raw\": fxs.map(transform),\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_doc], [], default_options(), [], false, noop_check)
  let dmsg = if res.diagnostics.length() > 0 { res.diagnostics[0].code + ": " + res.diagnostics[0].message } else { "" }
  assert_true(res.blockers == 0, "dep_ref_map blockers=" + res.blockers.to_string() + " " + dmsg)
  let out = res.files[0].content
  assert_true(str_has(out, "dep::holder.available.set(Some(mbt_compat::MbtJson::Object("), "@dep.val.field.set must propagate Option[MbtJson]: " + out)
  assert_true(str_has(out, "Some((k, Some(mbt_compat::MbtJson::Object("), "Ref.val = match ... must propagate tuple+Option+MbtJson: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::array(xs.map(transform))"), "xs.map(transform) must infer Array[MbtJson] and wrap as MbtJson::array: " + out)
  assert_true(!str_has(out, "mbt_compat::MbtJson::array(fxs.map(transform))"), "FixedArray::map must not be mis-inferred as Array and wrapped in MbtJson::array: " + out)
}
