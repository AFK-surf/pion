///| Self-contained lowering helpers for JSON literals, UTF-16 surrogate pairs,
///| labeled enum constructors/patterns, raising-callback fail-closed checks,
///| nested tuple-struct destructuring, and `[K : Hash + Eq]` generic bounds.

import "json" as json

// ---------------------------------------------------------------------------
// 1. Recursive MoonBit JSON literals under expected type `mbt_compat::MbtJson`
// ---------------------------------------------------------------------------

fn is_expected_mbt_json(ctx : StageAContext) -> Bool {
  current_expected_type(ctx).trim() == "mbt_compat::MbtJson" &&
  !ctx.symtab.local_types.contains("Json") &&
  !ctx.active_generics.contains("Json")
}

///| True if the token immediately following a literal continues a compound expression
///| (so `1 + 2` or `"a" + "b"` is NOT prematurely wrapped as `MbtJson::Number(1) + 2`).
fn next_tok_breaks_json_lit(tokens : Array[Token], next_i : Int, end : Int) -> Bool {
  if next_i >= end || tokens[next_i].newline_before {
    return false
  }
  let nk = tokens[next_i].kind
  nk == TokenKind::Plus || nk == TokenKind::Minus || nk == TokenKind::Star ||
  nk == TokenKind::Slash || nk == TokenKind::Percent || nk == TokenKind::EqEq ||
  nk == TokenKind::BangEq || nk == TokenKind::Lt || nk == TokenKind::LtEq ||
  nk == TokenKind::Gt || nk == TokenKind::GtEq || nk == TokenKind::AmpAmp ||
  nk == TokenKind::PipePipe || nk == TokenKind::Dot || nk == TokenKind::LBracket ||
  nk == TokenKind::LParen || nk == TokenKind::PipeGt || nk == TokenKind::DotDot ||
  nk == TokenKind::DotDotLt || nk == TokenKind::DotDotEq || nk == TokenKind::DotDotLtEq
}

fn int_to_u64(x : Int) -> UInt64 {
  x.to_int64().reinterpret_as_uint64()
}

///| Exact 0-ULP round-to-nearest-even conversion of a `UInt64` integer to IEEE-754 binary64 bits.
fn u64_to_ieee754_bits(v : UInt64) -> UInt64 {
  if v == 0UL {
    return 0UL
  }
  // Find MSB index `msb` in [0, 63]
  let mut msb = 63
  while msb > 0 {
    if ((v >> int_to_u64(msb)) & 1UL) != 0UL {
      break
    }
    msb = msb - 1
  }
  let mut exp : UInt64 = int_to_u64(1023 + msb)
  let mut mant : UInt64 = 0UL
  if msb <= 52 {
    mant = (v << int_to_u64(52 - msb)) & 0x000FFFFFFFFFFFFFUL
  } else {
    let shift = msb - 52
    let shifted = v >> int_to_u64(shift)
    let rem_mask = (1UL << int_to_u64(shift)) - 1UL
    let rem = v & rem_mask
    let half = 1UL << int_to_u64(shift - 1)
    let mut rounded = shifted
    if rem > half || (rem == half && (shifted & 1UL) != 0UL) {
      rounded = rounded + 1UL
      if rounded == (1UL << 53UL) {
        rounded = rounded >> 1UL
        exp = exp + 1UL
      }
    }
    mant = rounded & 0x000FFFFFFFFFFFFFUL
  }
  (exp << 52UL) | mant
}

fn u64_to_hex16(v : UInt64) -> String {
  let digits = "0123456789ABCDEF"
  let sb = StringBuilder()
  let mut shift = 60
  while shift >= 0 {
    let nib = ((v >> int_to_u64(shift)) & 15UL).to_int()
    sb.write_string(digits.slice(nib, nib + 1))
    shift = shift - 4
  }
  sb.to_string()
}

fn parse_decimal_u64_exact(raw : String) -> Option[UInt64] {
  let mut acc : UInt64 = 0UL
  let mut any = false
  let mut i = 0
  while i < raw.length() {
    let c = raw.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    if c < 48 || c > 57 {
      return None
    }
    any = true
    let d = int_to_u64(c - 48)
    if acc > 1844674407370955161UL || (acc == 1844674407370955161UL && d > 5UL) {
      return None
    }
    acc = acc * 10UL + d
    i = i + 1
  }
  if any { Some(acc) } else { None }
}

fn is_pure_decimal_int(raw : String) -> Bool {
  let mut any = false
  let mut i = 0
  while i < raw.length() {
    let c = raw.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    if c < 48 || c > 57 {
      return false
    }
    any = true
    i = i + 1
  }
  any
}

///| Parse a MoonBit integer literal (decimal, `0x`/`0X`, `0b`/`0B`, `0o`/`0O`) into `UInt64`
///| with exact overflow checking against `u64::MAX`.
fn parse_json_int_literal_u64(raw : String) -> Option[UInt64] {
  let n = raw.length()
  let mut base : UInt64 = 10UL
  let mut i = 0
  if n >= 2 && raw.code_unit_at(0) == 48 {
    let p = raw.code_unit_at(1)
    if p == 120 || p == 88 {
      base = 16UL
      i = 2
    } else if p == 98 || p == 66 {
      base = 2UL
      i = 2
    } else if p == 111 || p == 79 {
      base = 8UL
      i = 2
    }
  }
  let mut acc : UInt64 = 0UL
  let mut any = false
  while i < n {
    let c = raw.code_unit_at(i)
    if c == 95 {
      i = i + 1
      continue
    }
    let dv = if c >= 48 && c <= 57 {
      c - 48
    } else if base == 16UL && c >= 97 && c <= 102 {
      c - 97 + 10
    } else if base == 16UL && c >= 65 && c <= 70 {
      c - 65 + 10
    } else {
      return None
    }
    let d = int_to_u64(dv)
    if d >= base {
      return None
    }
    any = true
    if acc > (18446744073709551615UL - d) / base {
      return None
    }
    acc = acc * base + d
    i = i + 1
  }
  if any { Some(acc) } else { None }
}

fn is_zero_num_str(raw : String) -> Bool {
  let n = raw.length()
  let mut is_hex = false
  let mut i = 0
  if n >= 2 && raw.code_unit_at(0) == 48 {
    let p = raw.code_unit_at(1)
    if p == 120 || p == 88 {
      is_hex = true
      i = 2
    } else if p == 98 || p == 66 || p == 111 || p == 79 {
      i = 2
    }
  }
  let mut any_digit = false
  while i < n {
    let c = raw.code_unit_at(i)
    if is_hex {
      if c == 112 || c == 80 {
        break
      }
      if (c >= 49 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) {
        return false
      }
      if c == 48 {
        any_digit = true
      }
    } else {
      if c == 101 || c == 69 {
        break
      }
      if c >= 49 && c <= 57 {
        return false
      }
      if c == 48 {
        any_digit = true
      }
    }
    i = i + 1
  }
  any_digit
}

// ---------------------------------------------------------------------------
// 1b. Compile-time 0-ULP IEEE-754 binary64 decimal parser (mirrors mbt_compat/parse_double)
//     Overflow -> +/-Infinity (0x7FF0000000000000 / 0xFFF0000000000000)
//     Underflow -> +/-0.0 (0x0000000000000000 / 0x8000000000000000)
// ---------------------------------------------------------------------------

struct JsonDec {
  digits : Array[Byte]
  mut digits_num : Int
  mut decimal_point : Int
  mut negative : Bool
  mut truncated : Bool
  mut overflowed : Int
}

fn jdec_new() -> JsonDec {
  let digits : Array[Byte] = []
  let mut k = 0
  while k < 800 {
    digits.push(0.to_byte())
    k = k + 1
  }
  JsonDec::{ digits: digits, digits_num: 0, decimal_point: 0, negative: false, truncated: false, overflowed: 0 }
}

fn jdec_powtab(idx : Int) -> Int {
  let tbl : Array[Int] = [1, 3, 6, 9, 13, 16, 19, 23, 26, 29, 33, 36, 39, 43, 46, 49, 53, 56, 59]
  if idx >= tbl.length() { 60 } else { tbl[idx] }
}

fn jdec_left_cheat(s : Int) -> (Int, String) {
  let tbl : Array[(Int, String)] = [
    (0, ""), (1, "5"), (1, "25"), (1, "125"), (2, "625"), (2, "3125"), (2, "15625"),
    (3, "78125"), (3, "390625"), (3, "1953125"), (4, "9765625"), (4, "48828125"), (4, "244140625"),
    (4, "1220703125"), (5, "6103515625"), (5, "30517578125"), (5, "152587890625"), (6, "762939453125"),
    (6, "3814697265625"), (6, "19073486328125"), (7, "95367431640625"), (7, "476837158203125"),
    (7, "2384185791015625"), (7, "11920928955078125"), (8, "59604644775390625"), (8, "298023223876953125"),
    (8, "1490116119384765625"), (9, "7450580596923828125"), (9, "37252902984619140625"),
    (9, "186264514923095703125"), (10, "931322574615478515625"), (10, "4656612873077392578125"),
    (10, "23283064365386962890625"), (10, "116415321826934814453125"), (11, "582076609134674072265625"),
    (11, "2910383045673370361328125"), (11, "14551915228366851806640625"), (12, "72759576141834259033203125"),
    (12, "363797880709171295166015625"), (12, "1818989403545856475830078125"),
    (13, "9094947017729282379150390625"), (13, "45474735088646411895751953125"),
    (13, "227373675443232059478759765625"), (13, "1136868377216160297393798828125"),
    (14, "5684341886080801486968994140625"), (14, "28421709430404007434844970703125"),
    (14, "142108547152020037174224853515625"), (15, "710542735760100185871124267578125"),
    (15, "3552713678800500929355621337890625"), (15, "17763568394002504646778106689453125"),
    (16, "88817841970012523233890533447265625"), (16, "444089209850062616169452667236328125"),
    (16, "2220446049250313080847263336181640625"), (16, "11102230246251565404236316680908203125"),
    (17, "55511151231257827021181583404541015625"), (17, "277555756156289135105907917022705078125"),
    (17, "1387778780781445675529539585113525390625"), (18, "6938893903907228377647697925567626953125"),
    (18, "34694469519536141888238489627838134765625"), (18, "173472347597680709441192448139190673828125"),
    (19, "867361737988403547205962240695953369140625"),
  ]
  tbl[s]
}

fn jdec_trim(d : JsonDec) -> Unit {
  while d.digits_num > 0 && d.digits[d.digits_num - 1].to_int() == 0 {
    d.digits_num = d.digits_num - 1
  }
  if d.digits_num == 0 { d.decimal_point = 0 }
}

fn jdec_left_shift(d : JsonDec, s : Int) -> Unit {
  let (nd, cheat) = jdec_left_cheat(s)
  let mut less = false
  let mut ci = 0
  while ci < cheat.length() {
    if ci >= d.digits_num { less = true; break }
    let cd = cheat.code_unit_at(ci) - 48
    let sd = d.digits[ci].to_int()
    if sd != cd { less = sd < cd; break }
    ci = ci + 1
  }
  let new_digits = if less { nd - 1 } else { nd }
  let mut ri = d.digits_num - 1
  let mut wi = d.digits_num + new_digits
  let mut acc : Int64 = 0L
  while ri >= 0 {
    acc = acc + (d.digits[ri].to_int().to_int64() << s)
    let quo = acc / 10L
    let rem = (acc - quo * 10L).to_int()
    wi = wi - 1
    if wi < d.digits.length() { d.digits[wi] = rem.to_byte() } else if rem != 0 { d.truncated = true }
    acc = quo
    ri = ri - 1
  }
  while acc > 0L {
    let quo = acc / 10L
    let rem = (acc - quo * 10L).to_int()
    wi = wi - 1
    if wi < d.digits.length() { d.digits[wi] = rem.to_byte() } else if rem != 0 { d.truncated = true }
    acc = quo
  }
  d.digits_num = d.digits_num + new_digits
  if d.digits_num > d.digits.length() { d.digits_num = d.digits.length() }
  d.decimal_point = d.decimal_point + new_digits
  jdec_trim(d)
}

fn jdec_right_shift(d : JsonDec, s : Int) -> Unit {
  let mut ri = 0
  let mut wi = 0
  let mut acc : UInt64 = 0UL
  let su = int_to_u64(s)
  while (acc >> su) == 0UL {
    if ri >= d.digits_num {
      while (acc >> su) == 0UL { acc = acc * 10UL; ri = ri + 1 }
      break
    }
    acc = acc * 10UL + int_to_u64(d.digits[ri].to_int())
    ri = ri + 1
  }
  d.decimal_point = d.decimal_point - (ri - 1)
  let mask : UInt64 = (1UL << su) - 1UL
  while ri < d.digits_num {
    d.digits[wi] = (acc >> su).to_int().to_byte()
    wi = wi + 1
    acc = (acc & mask) * 10UL + int_to_u64(d.digits[ri].to_int())
    ri = ri + 1
  }
  while acc > 0UL {
    let out = acc >> su
    if wi < d.digits.length() { d.digits[wi] = out.to_int().to_byte(); wi = wi + 1 } else if out > 0UL { d.truncated = true }
    acc = (acc & mask) * 10UL
  }
  d.digits_num = wi
  jdec_trim(d)
}

fn jdec_shift(d : JsonDec, s_in : Int) -> Unit {
  if d.digits_num == 0 { return }
  let mut s = s_in
  if s > 0 {
    while s > 59 { jdec_left_shift(d, 59); s = s - 59 }
    jdec_left_shift(d, s)
  } else if s < 0 {
    while s < -59 { jdec_right_shift(d, 59); s = s + 59 }
    jdec_right_shift(d, -s)
  }
}

fn jdec_assemble_bits(mantissa : Int64, exponent : Int, negative : Bool) -> UInt64 {
  let biased_exp = exponent + 1023
  let mut bits = (mantissa & ((1L << 52) - 1L)).reinterpret_as_uint64()
  bits = bits | (int_to_u64(biased_exp & 0x7FF) << 52UL)
  if negative { bits = bits | 0x8000000000000000UL }
  bits
}

fn parse_decimal_double_to_bits(neg : Bool, raw : String) -> Option[UInt64] {
  let n = raw.length()
  if n == 0 { return None }
  let d = jdec_new()
  d.negative = neg
  let mut i = 0
  let mut has_dp = false
  let mut has_digits = false
  while i < n {
    let c = raw.code_unit_at(i)
    if c == 95 { i = i + 1; continue }
    if c == 46 {
      if has_dp { return None }
      has_dp = true
      d.decimal_point = d.digits_num
      i = i + 1
      continue
    }
    if c >= 48 && c <= 57 {
      has_digits = true
      let dig = c - 48
      if dig == 0 && d.digits_num == 0 {
        if has_dp && d.decimal_point > -1000000 { d.decimal_point = d.decimal_point - 1 }
        i = i + 1
        continue
      }
      if d.digits_num < d.digits.length() {
        d.digits[d.digits_num] = dig.to_byte()
        d.digits_num = d.digits_num + 1
      } else {
        if !has_dp { d.overflowed = d.overflowed + 1 }
        if dig != 0 { d.truncated = true }
      }
      i = i + 1
      continue
    }
    break
  }
  if !has_digits { return None }
  if !has_dp { d.decimal_point = d.digits_num }
  if i < n && (raw.code_unit_at(i) == 101 || raw.code_unit_at(i) == 69) {
    i = i + 1
    let mut exp_sign = 1
    if i < n && raw.code_unit_at(i) == 43 { i = i + 1 }
    else if i < n && raw.code_unit_at(i) == 45 { exp_sign = -1; i = i + 1 }
    if i >= n || !(raw.code_unit_at(i) >= 48 && raw.code_unit_at(i) <= 57) { return None }
    let eff_dp = d.decimal_point + d.overflowed
    let exp_limit = if exp_sign > 0 { if eff_dp < 311 { 311 - eff_dp } else { 0 } } else if eff_dp > -331 { eff_dp + 331 } else { 0 }
    let mut exp_val = 0
    while i < n {
      let c = raw.code_unit_at(i)
      if c == 95 { i = i + 1; continue }
      if c >= 48 && c <= 57 {
        if exp_val < exp_limit {
          exp_val = exp_val * 10 + (c - 48)
          if exp_val > exp_limit { exp_val = exp_limit }
        }
        i = i + 1
      } else {
        break
      }
    }
    d.decimal_point = d.decimal_point + exp_sign * exp_val
  }
  if i != n { return None }
  jdec_trim(d)
  let eff_dp = d.decimal_point + d.overflowed
  if d.digits_num == 0 || eff_dp < -330 {
    return Some(if neg { 0x8000000000000000UL } else { 0x0000000000000000UL })
  }
  if eff_dp > 310 {
    return Some(if neg { 0xFFF0000000000000UL } else { 0x7FF0000000000000UL })
  }
  d.decimal_point = eff_dp
  let mut exponent = 0
  while d.decimal_point > 0 {
    let sh = jdec_powtab(d.decimal_point)
    jdec_shift(d, -sh)
    exponent = exponent + sh
  }
  while d.decimal_point < 0 || (d.decimal_point == 0 && d.digits[0].to_int() < 5) {
    let sh = jdec_powtab(-d.decimal_point)
    jdec_shift(d, sh)
    exponent = exponent - sh
  }
  exponent = exponent - 1
  if exponent < -1022 {
    let sh = -1022 - exponent
    jdec_shift(d, -sh)
    exponent = exponent + sh
  }
  if exponent + 1023 >= 2047 {
    return Some(if neg { 0xFFF0000000000000UL } else { 0x7FF0000000000000UL })
  }
  jdec_shift(d, 53)
  let mut mantissa : Int64 = 0L
  let mut mi = 0
  while mi < d.decimal_point && mi < d.digits_num {
    mantissa = mantissa * 10L + d.digits[mi].to_int().to_int64()
    mi = mi + 1
  }
  while mi < d.decimal_point {
    mantissa = mantissa * 10L
    mi = mi + 1
  }
  let mut round_up = false
  if d.decimal_point >= 0 && d.decimal_point < d.digits_num {
    let dig = d.digits[d.decimal_point].to_int()
    if dig == 5 && d.decimal_point + 1 == d.digits_num {
      round_up = d.truncated || (d.decimal_point > 0 && (d.digits[d.decimal_point - 1].to_int() % 2) != 0)
    } else {
      round_up = dig >= 5
    }
  }
  if round_up { mantissa = mantissa + 1L }
  if mantissa == (2L << 52) {
    mantissa = mantissa >> 1
    exponent = exponent + 1
    if exponent + 1023 >= 2047 {
      return Some(if neg { 0xFFF0000000000000UL } else { 0x7FF0000000000000UL })
    }
  }
  if (mantissa & (1L << 52)) == 0L { exponent = -1023 }
  Some(jdec_assemble_bits(mantissa, exponent, neg))
}

///| Lower a numeric literal under expected `mbt_compat::MbtJson` purely at compile time
///| into exact 0-ULP `Double::from_bits(0x<hex16>UL.reinterpret_as_int64())` (zero runtime parsing/panic).
fn lower_json_number_lit(
  ctx : StageAContext,
  neg : Bool,
  raw : String,
  is_float : Bool,
  file : String,
  line : Int,
  col : Int,
) -> String {
  if is_zero_num_str(raw) {
    let bits_hex = if neg { "8000000000000000" } else { "0000000000000000" }
    return "mbt_compat::MbtJson::Number(Double::from_bits(0x" + bits_hex + "UL.reinterpret_as_int64()), Option::None)"
  }
  if !is_float {
    match parse_json_int_literal_u64(raw) {
      Some(u) => {
        let mut bits = u64_to_ieee754_bits(u)
        if neg { bits = bits | 0x8000000000000000UL }
        return "mbt_compat::MbtJson::Number(Double::from_bits(0x" + u64_to_hex16(bits) + "UL.reinterpret_as_int64()), Option::None)"
      }
      None =>
      if !is_pure_decimal_int(raw) {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          line,
          col,
          "unsupported or out-of-range integer literal `" + raw + "` in Json context",
        ))
        return "mbt_compat::MbtJson::Number(0.0, Option::None)"
      }
    }
  }
  // Hexadecimal floating-point literal `0x...p...`
  if is_float && (raw.starts_with("0x") || raw.starts_with("0X")) {
    match parse_hex_float_to_bits(raw) {
      Some(b64) => {
        let mut bits = b64.reinterpret_as_uint64()
        if neg { bits = bits | 0x8000000000000000UL }
        return "mbt_compat::MbtJson::Number(Double::from_bits(0x" + u64_to_hex16(bits) + "UL.reinterpret_as_int64()), Option::None)"
      }
      None => {
        ctx.diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_SYNTAX",
          file,
          line,
          col,
          "unsupported hexadecimal float literal `" + raw + "` in Json context",
        ))
        return "mbt_compat::MbtJson::Number(0.0, Option::None)"
      }
    }
  }
  // Decimal float or >u64::MAX pure decimal integer: exact compile-time 0-ULP IEEE-754 binary64 bits
  match parse_decimal_double_to_bits(neg, raw) {
    Some(bits) =>
    "mbt_compat::MbtJson::Number(Double::from_bits(0x" + u64_to_hex16(bits) + "UL.reinterpret_as_int64()), Option::None)"
    None => {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        line,
        col,
        "unsupported numeric literal `" + raw + "` in Json context",
      ))
      "mbt_compat::MbtJson::Number(0.0, Option::None)"
    }
  }
}

// ---------------------------------------------------------------------------
// 2. UTF-16 Surrogate Pair Lowering (`\uD83D\uDE00` -> `\u{1F600}`)
// ---------------------------------------------------------------------------

fn hex_upper_cp(cp : Int) -> String {
  let digits = "0123456789ABCDEF"
  let rev : Array[String] = []
  let mut v = cp
  if v == 0 {
    return "0"
  }
  while v > 0 {
    let nib = v & 15
    rev.push(digits.slice(nib, nib + 1))
    v = v >> 4
  }
  let sb = StringBuilder()
  let mut i = rev.length() - 1
  while i >= 0 {
    sb.write_string(rev[i])
    i = i - 1
  }
  sb.to_string()
}

///| Rewrite MoonBit `\uHHHH` UTF-16 surrogate pairs in string literal content to Pion `\u{...}`
///| scalar escapes; fail closed (`MBT2PION_UNSUPPORTED_SYNTAX`) on lone surrogates;
///| strictly respect escaped `\\uD800` (never misread an escaped backslash!).
fn lower_mbt_string_surrogates(
  s : String,
  file : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> String {
  if !str_has(s, "\\u") {
    return s
  }
  let n = s.length()
  let sb = StringBuilder()
  let mut i = 0
  while i < n {
    let c = s.code_unit_at(i)
    if c == 92 && i + 1 < n {
      let nxt = s.code_unit_at(i + 1)
      if nxt == 92 {
        // Escaped backslash `\\`: emit both bytes verbatim so `\\uD800` is untouched!
        sb.write_string("\\\\")
        i = i + 2
        continue
      }
      if nxt == 117 && i + 5 < n && s.code_unit_at(i + 2) != 123 {
        let d1 = hex_digit_val(s.code_unit_at(i + 2))
        let d2 = hex_digit_val(s.code_unit_at(i + 3))
        let d3 = hex_digit_val(s.code_unit_at(i + 4))
        let d4 = hex_digit_val(s.code_unit_at(i + 5))
        if d1 >= 0 && d2 >= 0 && d3 >= 0 && d4 >= 0 {
          let cp = (d1 << 12) | (d2 << 8) | (d3 << 4) | d4
          if cp >= 0xD800 && cp <= 0xDBFF {
            // High surrogate: must be immediately followed by low surrogate `\uDC00..\uDFFF`
            if i + 11 < n && s.code_unit_at(i + 6) == 92 && s.code_unit_at(i + 7) == 117 && s.code_unit_at(i + 8) != 123 {
              let l1 = hex_digit_val(s.code_unit_at(i + 8))
              let l2 = hex_digit_val(s.code_unit_at(i + 9))
              let l3 = hex_digit_val(s.code_unit_at(i + 10))
              let l4 = hex_digit_val(s.code_unit_at(i + 11))
              if l1 >= 0 && l2 >= 0 && l3 >= 0 && l4 >= 0 {
                let lo = (l1 << 12) | (l2 << 8) | (l3 << 4) | l4
                if lo >= 0xDC00 && lo <= 0xDFFF {
                  let full_cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00)
                  sb.write_string("\\u{" + hex_upper_cp(full_cp) + "}")
                  i = i + 12
                  continue
                }
              }
            }
            diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              line,
              col,
              "unpaired UTF-16 high surrogate escape `\\u" + s.slice(i + 2, i + 6) + "` in string literal",
            ))
            sb.write_string(s.slice(i, i + 6))
            i = i + 6
            continue
          }
          if cp >= 0xDC00 && cp <= 0xDFFF {
            diags.push(diag_error(
              "MBT2PION_UNSUPPORTED_SYNTAX",
              file,
              line,
              col,
              "unpaired UTF-16 low surrogate escape `\\u" + s.slice(i + 2, i + 6) + "` in string literal",
            ))
            sb.write_string(s.slice(i, i + 6))
            i = i + 6
            continue
          }
          // Non-surrogate `\uHHHH`: emit Pion `\u{HHHH}`
          sb.write_string("\\u{" + s.slice(i + 2, i + 6) + "}")
          i = i + 6
          continue
        }
      }
      sb.write_byte(c.to_byte())
      sb.write_byte(nxt.to_byte())
      i = i + 2
      continue
    }
    sb.write_byte(c.to_byte())
    i = i + 1
  }
  sb.to_string()
}

// ---------------------------------------------------------------------------
// 3. Labeled Enum Constructors & Patterns + Readonly Visibility Gate (§6)
// ---------------------------------------------------------------------------

///| Check whether a parenthesized argument/pattern list contains any labeled arg (`lbl=...` or `lbl~`).
fn paren_has_labeled_arg(tokens : Array[Token], open_p : Int, close_p : Int) -> Bool {
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { depth = depth - 1 }
      else if depth == 0 && k == TokenKind::Comma { break }
      a_end = a_end + 1
    }
    if (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) && cur + 1 < a_end {
      if tokens[cur + 1].kind == TokenKind::Eq || tokens[cur + 1].kind == TokenKind::Tilde {
        return true
      }
    }
    cur = a_end + 1
  }
  false
}

///| Resolve `(AbiEnumSchema, AbiEnumVariant)` for a constructor/pattern site.
fn resolve_enum_schema_for_site(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
) -> Option[(AbiEnumSchema, AbiEnumVariant)] {
  if enum_hint.length() > 0 {
    let key = if pkg_hint.length() > 0 { pkg_hint + "::" + enum_hint } else { enum_hint }
    match ctx.symtab.enum_schemas.get(key) {
      Some(sch) => {
        for v in sch.variants {
          if v.name == ctor_name {
            return Some((sch, v))
          }
        }
      }
      None => ()
    }
  }
  match ctx.symtab.enum_schemas_by_ctor.get(ctor_name) {
    Some(cands) => {
      let exp_base = strip_type_args_sym(current_expected_type(ctx))
      let matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      let local_matched : Array[(AbiEnumSchema, AbiEnumVariant)] = []
      for c in cands {
        let sch = c.0
        if pkg_hint.length() > 0 && sch.pkg != pkg_hint {
          continue
        }
        if enum_hint.length() > 0 && sch.name != enum_hint {
          continue
        }
        let full_e = if sch.pkg.length() > 0 { sch.pkg + "::" + sch.name } else { sch.name }
        if exp_base.length() > 0 && pkg_hint.length() == 0 && enum_hint.length() == 0 {
          if str_has(exp_base, "::") {
            if full_e == exp_base { matched.push(c) }
          } else if sch.name == exp_base {
            matched.push(c)
            if sch.pkg.length() == 0 { local_matched.push(c) }
          }
        } else {
          matched.push(c)
          if sch.pkg.length() == 0 { local_matched.push(c) }
        }
      }
      if matched.length() == 1 {
        return Some(matched[0])
      }
      if pkg_hint.length() == 0 && local_matched.length() == 1 {
        return Some(local_matched[0])
      }
      None
    }
    None => None
  }
}

///| Reorder labeled enum constructor/pattern arguments directly into declaration positional order
///| (ZERO call-site temporary variables; strict fail-closed on unknown/duplicate/missing labels).
fn lower_labeled_enum_args(
  ctx : StageAContext,
  schema : AbiEnumSchema,
  variant : AbiEnumVariant,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> String {
  let nfields = variant.fields.length()
  let slots : Array[String] = []
  let filled : Array[Bool] = []
  let mut fi = 0
  while fi < nfields {
    slots.push("")
    filled.push(false)
    fi = fi + 1
  }
  let mut has_rest = false
  let mut next_pos = 0
  let mut cur = open_p + 1
  while cur < close_p {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut a_end = cur
    let mut depth = 0
    while a_end < close_p {
      let k = tokens[a_end].kind
      if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { depth = depth + 1 }
      else if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace { depth = depth - 1 }
      else if depth == 0 && k == TokenKind::Comma { break }
      a_end = a_end + 1
    }
    if in_pattern && a_end == cur + 1 && tokens[cur].kind == TokenKind::DotDot {
      has_rest = true
      cur = a_end + 1
      continue
    }
    let is_punning = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    a_end == cur + 2 && tokens[cur + 1].kind == TokenKind::Tilde
    let is_named = (tokens[cur].kind == TokenKind::Ident || tokens[cur].kind == TokenKind::Keyword) &&
    cur + 2 < a_end && tokens[cur + 1].kind == TokenKind::Eq
    if is_punning || is_named {
      let lbl = tokens[cur].raw
      let mut target_idx = -1
      let mut k = 0
      while k < nfields {
        if variant.fields[k].label == lbl {
          target_idx = k
          break
        }
        k = k + 1
      }
      if target_idx < 0 {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "unknown label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else if filled[target_idx] {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "duplicate label `" + lbl + "` for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        let val_s = if is_punning {
          rename_keyword_ident(lbl)
        } else {
          push_expected_type(ctx, variant.fields[target_idx].ty)
          let lowered = lower_expr_range(ctx, tokens, cur + 2, a_end, file, in_pattern).trim()
          pop_expected_type(ctx)
          lowered
        }
        slots[target_idx] = val_s
        filled[target_idx] = true
      }
    } else if a_end > cur {
      // Positional argument: bind to next unfilled positional (unlabeled) slot
      while next_pos < nfields && (filled[next_pos] || variant.fields[next_pos].label.length() > 0) {
        next_pos = next_pos + 1
      }
      if next_pos >= nfields {
        ctx.diags.push(diag_error(
          "MBT2PION_ENUM_LABEL_ERROR",
          file,
          tokens[cur].line,
          tokens[cur].col,
          "too many positional arguments for enum variant `" + schema.name + "::" + variant.name + "`",
        ))
      } else {
        push_expected_type(ctx, variant.fields[next_pos].ty)
        let lowered = lower_expr_range(ctx, tokens, cur, a_end, file, in_pattern).trim()
        pop_expected_type(ctx)
        slots[next_pos] = lowered
        filled[next_pos] = true
        next_pos = next_pos + 1
      }
    }
    cur = a_end + 1
  }
  let ordered : Array[String] = []
  let mut k = 0
  while k < nfields {
    if filled[k] {
      ordered.push(slots[k])
    } else if in_pattern && (has_rest || variant.fields[k].label.length() > 0) {
      ordered.push("_")
    } else {
      ctx.diags.push(diag_error(
        "MBT2PION_ENUM_LABEL_ERROR",
        file,
        line,
        col,
        "missing required field `" + (if variant.fields[k].label.length() > 0 { variant.fields[k].label } else { "#" + k.to_string() }) + "` for enum variant `" + schema.name + "::" + variant.name + "`",
      ))
      ordered.push("_")
    }
    k = k + 1
  }
  "(" + join_comma(ordered) + ")"
}

///| Check external enum visibility (`can_construct` / `can_match`) and optionally lower labeled args.
///| Returns `Some(args_str)` if labeled/reordered args were produced, or `None` for normal lowering.
fn check_and_lower_enum_site(
  ctx : StageAContext,
  pkg_hint : String,
  enum_hint : String,
  ctor_name : String,
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  file : String,
  line : Int,
  col : Int,
  in_pattern : Bool,
) -> Option[String] {
  let has_lbl = open_p >= 0 && paren_has_labeled_arg(tokens, open_p, close_p)
  match resolve_enum_schema_for_site(ctx, pkg_hint, enum_hint, ctor_name) {
    Some((sch, variant)) => {
      if sch.pkg.length() > 0 {
        if !in_pattern && !sch.can_construct {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot construct readonly `pub enum` variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "` from outside its package",
          ))
        } else if in_pattern && !sch.can_match {
          ctx.diags.push(diag_error(
            "MBT2PION_DEP_ABI_ERROR",
            file,
            line,
            col,
            "cannot pattern-match private enum variant `" + sch.pkg + "::" + sch.name + "::" + variant.name + "`",
          ))
        }
      }
      if open_p < 0 {
        return None
      }
      let mut schema_has_labels = false
      for f in variant.fields {
        if f.label.length() > 0 {
          schema_has_labels = true
          break
        }
      }
      if has_lbl || schema_has_labels {
        return Some(lower_labeled_enum_args(ctx, sch, variant, tokens, open_p, close_p, file, line, col, in_pattern))
      }
      None
    }
    None => {
      if has_lbl {
        let err_code = if pkg_hint.length() > 0 && !ctx.symtab.verified_abi_deps.contains(pkg_hint) {
          "MBT2PION_DEP_ABI_ERROR"
        } else {
          "MBT2PION_ENUM_LABEL_ERROR"
        }
        ctx.diags.push(diag_error(
          err_code,
          file,
          line,
          col,
          "labeled enum variant `" + ctor_name + "` requires local declaration or verified `--dep` `mbt2pion_abi.json` metadata",
        ))
      }
      None
    }
  }
}

// ---------------------------------------------------------------------------
// 4. Raising-Callback Fail-Closed Gate for `retain` / `filter_map` (§5)
// ---------------------------------------------------------------------------

fn check_non_raising_callback(
  ctx : StageAContext,
  tokens : Array[Token],
  arg_s : Int,
  arg_e : Int,
  method_name : String,
  file : String,
  line : Int,
  col : Int,
) -> Unit {
  if arg_s >= arg_e {
    return
  }
  // 1. Named function reference `f`
  if arg_e == arg_s + 1 && tokens[arg_s].kind == TokenKind::Ident {
    let fname = tokens[arg_s].raw
    if ctx.symtab.local_raising_fns.contains(fname) {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        line,
        col,
        "passing raising function `" + fname + "` as callback to `." + method_name + "(...)` is not supported (fail-closed)",
      ))
      return
    }
  }
  // 2. Inline closure/arrow fn: scan body for `raise`, unshadowed `fail(...)`, or calls to known raising fns
  let mut k = arg_s
  while k < arg_e {
    let tk = tokens[k]
    if (tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident) && tk.raw == "raise" {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tk.line,
        tk.col,
        "raising callback passed to `." + method_name + "(...)` is not supported (fail-closed)",
      ))
      return
    }
    if tk.kind == TokenKind::Ident && tk.raw == "fail" && k + 1 < arg_e && tokens[k + 1].kind == TokenKind::LParen &&
    !ctx.symtab.local_fn_names.contains("fail") && !(lookup_scope_var(ctx, "fail") is Some(_)) {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tk.line,
        tk.col,
        "callback calling `fail(...)` passed to `." + method_name + "(...)` is not supported (fail-closed)",
      ))
      return
    }
    if tk.kind == TokenKind::Ident && k + 1 < arg_e && tokens[k + 1].kind == TokenKind::LParen &&
    ctx.symtab.local_raising_fns.contains(tk.raw) {
      ctx.diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        file,
        tk.line,
        tk.col,
        "callback calling raising function `" + tk.raw + "` passed to `." + method_name + "(...)` is not supported (fail-closed)",
      ))
      return
    }
    k = k + 1
  }
}

fn is_array_mutating_method(m : String) -> Bool {
  m == "pop" || m == "push" || m == "clear" || m == "truncate" || m == "resize" ||
  m == "drain" || m == "remove" || m == "insert" || m == "append" || m == "retain" ||
  m == "set" || m == "unsafe_set" || m == "swap" || m == "sort" || m == "sort_by" ||
  m == "sort_by_key" || m == "rev_in_place" || m == "map_in_place" || m == "push_iter" ||
  m == "shrink_to_fit" || m == "dedup" || m == "blit_to"
}

///| Return true iff `[s, e)` is a proven-fresh allocation expression (independent container object).
fn is_fresh_container_alloc(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e {
    return false
  }
  // `[...]` array literal
  if tokens[s].kind == TokenKind::LBracket && find_matching_delim(tokens, s) == e - 1 {
    return true
  }
  // `<expr>.copy()`
  if e >= s + 4 && tokens[e - 4].kind == TokenKind::Dot && tokens[e - 3].raw == "copy" &&
  tokens[e - 2].kind == TokenKind::LParen && tokens[e - 1].kind == TokenKind::RParen {
    return true
  }
  // `mbt_compat::arr_copy(...)` / `array_slice_clamp(...)` / `arr_concat(...)` / `arr_filter(...)` / `arr_filter_map(...)` / `arr_map(...)` / `OrderedMap::new()` / `ordered_set_new()`
  if e >= s + 5 && tokens[s].raw == "mbt_compat" && tokens[s + 1].kind == TokenKind::ColonColon {
    let nm = tokens[s + 2].raw
    if (nm == "arr_copy" || nm == "array_slice_clamp" || nm == "arr_concat" ||
      nm == "arr_filter" || nm == "arr_filter_map" || nm == "arr_map" || nm == "arr_to_array" ||
      nm == "ordered_set_new" || nm == "ordered_set_from_array" ||
      nm == "ordered_map_new" || nm == "ordered_map_from_array") &&
    tokens[s + 3].kind == TokenKind::LParen && find_matching_delim(tokens, s + 3) == e - 1 {
      return true
    }
    if e >= s + 7 && (nm == "OrderedMap" || nm == "OrderedSet") &&
    tokens[s + 3].kind == TokenKind::ColonColon && (tokens[s + 4].raw == "new" || tokens[s + 4].raw == "from_array") &&
    tokens[s + 5].kind == TokenKind::LParen && find_matching_delim(tokens, s + 5) == e - 1 {
      return true
    }
  }
  // `Array::new(...)` / `Array::make(...)` / `Map::new(...)` / `Map()`
  if e >= s + 5 && (tokens[s].raw == "Array" || tokens[s].raw == "Map") &&
  tokens[s + 1].kind == TokenKind::ColonColon && (tokens[s + 2].raw == "new" || tokens[s + 2].raw == "make") &&
  tokens[s + 3].kind == TokenKind::LParen && find_matching_delim(tokens, s + 3) == e - 1 {
    return true
  }
  if e >= s + 3 && tokens[s].raw == "Map" && tokens[s + 1].kind == TokenKind::LParen &&
  find_matching_delim(tokens, s + 1) == e - 1 {
    return true
  }
  false
}

///| Revoke from `fresh` any bare identifier appearing as a value in `[s, e)` (not followed by `.` or `[`,
///| and not the callee of a function call), implementing undirected alias revocation.
fn revoke_bare_idents_in_range(
  tokens : Array[Token],
  s : Int,
  e : Int,
  fresh : Map[String, Bool],
) -> Unit {
  let mut k = s
  while k < e {
    let tk = tokens[k]
    let prev_qual = k > s && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)
    if tk.kind == TokenKind::Ident && !prev_qual && fresh.contains(tk.raw) {
      let next_is_access_or_call = k + 1 < e && (tokens[k + 1].kind == TokenKind::Dot ||
        tokens[k + 1].kind == TokenKind::LBracket || tokens[k + 1].kind == TokenKind::LParen ||
        tokens[k + 1].kind == TokenKind::Colon)
      if !next_is_access_or_call {
        fresh.remove(tk.raw)
      }
    }
    k = k + 1
  }
}

fn is_mbt_compat_arr_mutating(m : String) -> Bool {
  m == "arr_retain" || m == "arr_push" || m == "arr_pop" || m == "arr_clear" ||
  m == "arr_truncate" || m == "arr_remove" || m == "arr_insert" || m == "arr_append" ||
  m == "arr_set" || m == "arr_unsafe_set" || m == "arr_swap" || m == "arr_sort" ||
  m == "arr_sort_by" || m == "arr_sort_by_key" || m == "arr_splice" || m == "arr_drain" ||
  m == "arr_resize" || m == "arr_dedup" || m == "arr_rev_in_place" || m == "arr_map_in_place" ||
  m == "arr_push_iter" || m == "arr_shrink_to_fit" || m == "arr_blit_to"
}

fn clone_bool_map(m : Map[String, Bool]) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  for k in m.keys() {
    out[k] = true
  }
  out
}

fn clone_local_fn_map(
  m : Map[String, (Int, Int, Map[String, Bool])],
) -> Map[String, (Int, Int, Map[String, Bool])] {
  let out : Map[String, (Int, Int, Map[String, Bool])] = Map()
  for k in m.keys() {
    match m.get(k) {
      Some(v) => out[k] = v
      None => ()
    }
  }
  out
}

///| Collect parameter names from `(a : T, b : U)` in `tokens[open_p..close_p]`.
fn collect_pion_fn_param_names(tokens : Array[Token], open_p : Int, close_p : Int) -> Array[String] {
  let out : Array[String] = []
  let mut i = open_p + 1
  while i < close_p {
    if tokens[i].kind == TokenKind::Comma { i = i + 1; continue }
    let mut pe = i
    let mut pd = 0
    while pe < close_p {
      let pk = tokens[pe].kind
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
      else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
      else if pd == 0 && pk == TokenKind::Comma { break }
      pe = pe + 1
    }
    if tokens[i].kind == TokenKind::Ident && tokens[i].raw != "_" {
      out.push(tokens[i].raw)
    }
    i = pe + 1
  }
  out
}

///| Package-level function body index for Stage B inter-procedural mutation checking.
struct StageBPkgFn {
  tokens : Array[Token]
  body_s : Int
  body_e : Int
  params : Array[String]
}

fn collect_stage_b_pkg_fns_cached(
  cur_files : Array[GeneratedFile],
  file_tokens : Map[String, Array[Token]],
) -> Map[String, StageBPkgFn] {
  let out : Map[String, StageBPkgFn] = Map()
  for f in cur_files {
    let toks = match file_tokens.get(f.rel_path) {
      Some(ts) => ts
      None => {
        let ts = lex_moonbit(f.content)
        file_tokens[f.rel_path] = ts
        ts
      }
    }
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let tk = toks[i]
      if tk.kind == TokenKind::LBrace {
        depth = depth + 1
      } else if tk.kind == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
      } else if depth == 0 && tk.kind == TokenKind::Keyword && tk.raw == "fn" {
        let mut ni = i + 1
        if ni < n && toks[ni].kind == TokenKind::LBracket {
          ni = find_matching_delim(toks, ni) + 1
        }
        if ni < n && toks[ni].kind == TokenKind::Ident {
          let fname = toks[ni].raw
          let mut pi = ni + 1
          if pi < n && toks[pi].kind == TokenKind::LBracket {
            pi = find_matching_delim(toks, pi) + 1
          }
          if pi < n && toks[pi].kind == TokenKind::LParen {
            let cp = find_matching_delim(toks, pi)
            let pnames = collect_pion_fn_param_names(toks, pi, cp)
            let mut lb = cp + 1
            while lb < n && toks[lb].kind != TokenKind::LBrace {
              lb = lb + 1
            }
            if lb < n && toks[lb].kind == TokenKind::LBrace {
              let rb = find_matching_delim(toks, lb)
              out[fname] = StageBPkgFn::{
                tokens: toks,
                body_s: lb + 1,
                body_e: rb,
                params: pnames,
              }
              i = rb + 1
              continue
            }
          }
        }
      }
      i = i + 1
    }
  }
  out
}

fn collect_stage_b_pkg_fns(cur_files : Array[GeneratedFile]) -> Map[String, StageBPkgFn] {
  let cache : Map[String, Array[Token]] = Map()
  collect_stage_b_pkg_fns_cached(cur_files, cache)
}

///| Check whether a scope `[s, e)` mutates any non-disjoint array or calls a helper that does.
///| Mutates `inner_fresh` in place for this scope; callers pass a cloned map when entering child scopes.
fn stage_b_scope_may_mutate(
  tokens : Array[Token],
  s : Int,
  e : Int,
  inner_fresh : Map[String, Bool],
  cb_params : Map[String, Bool],
  local_fn_bodies : Map[String, (Int, Int, Map[String, Bool])],
  pkg_fns : Map[String, StageBPkgFn],
  visited_fns : Map[String, Bool],
  recv_root : String,
) -> Bool {
  let inner_local_fns = clone_local_fn_map(local_fn_bodies)
  let mut k = s
  while k < e {
    let tk = tokens[k]
    // 0. Child block `{ ... }` — isolate inner `let` bindings, propagate revocations of existing `inner_fresh` keys
    if tk.kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, k)
      let child_fresh = clone_bool_map(inner_fresh)
      if stage_b_scope_may_mutate(tokens, k + 1, rb, child_fresh, cb_params, inner_local_fns, pkg_fns, visited_fns, recv_root) {
        return true
      }
      let to_revoke : Array[String] = []
      for fk in inner_fresh.keys() {
        if !child_fresh.contains(fk) {
          to_revoke.push(fk)
        }
      }
      for rk in to_revoke {
        inner_fresh.remove(rk)
      }
      k = rb + 1
      continue
    }
    // 1. Local `let [mut] v [: T] = rhs` inside this scope
    if tk.kind == TokenKind::Keyword && tk.raw == "let" {
      let mut ni = k + 1
      if ni < e && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni + 1 < e && tokens[ni].kind == TokenKind::Ident {
        let lhs_name = tokens[ni].raw
        let mut eq_i = ni + 1
        if eq_i < e && tokens[eq_i].kind == TokenKind::Colon {
          let mut td = 0
          while eq_i < e {
            let ttk = tokens[eq_i].kind
            if ttk == TokenKind::LParen || ttk == TokenKind::LBracket || ttk == TokenKind::LBrace { td = td + 1 }
            else if ttk == TokenKind::RParen || ttk == TokenKind::RBracket || ttk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
            else if td == 0 && ttk == TokenKind::Eq { break }
            eq_i = eq_i + 1
          }
        }
        if eq_i < e && tokens[eq_i].kind == TokenKind::Eq && eq_i + 1 < e {
          let rhs_s = eq_i + 1
          let rhs_e = find_expr_end(tokens, rhs_s, e)
          // Check RHS itself for mutations (unless RHS is a closure literal `fn(...) { ... }`, which is registered and checked when called)
          if tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn" &&
          rhs_s + 1 < rhs_e && tokens[rhs_s + 1].kind == TokenKind::LParen {
            let cp = find_matching_delim(tokens, rhs_s + 1)
            let lpm : Map[String, Bool] = Map()
            for pn in collect_pion_fn_param_names(tokens, rhs_s + 1, cp) { lpm[pn] = true }
            let mut lb = cp + 1
            while lb < rhs_e && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
            if lb < rhs_e && tokens[lb].kind == TokenKind::LBrace {
              let rb = find_matching_delim(tokens, lb)
              inner_local_fns[lhs_name] = (lb + 1, rb, lpm)
            } else {
              inner_local_fns.remove(lhs_name)
            }
          } else {
            if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
              if stage_b_scope_may_mutate(tokens, rhs_s, rhs_e, inner_fresh, cb_params, inner_local_fns, pkg_fns, visited_fns, recv_root) {
                return true
              }
            }
            if rhs_e == rhs_s + 1 && tokens[rhs_s].kind == TokenKind::Ident {
              match inner_local_fns.get(tokens[rhs_s].raw) {
                Some(fb) => inner_local_fns[lhs_name] = fb
                None => inner_local_fns.remove(lhs_name)
              }
            } else {
              inner_local_fns.remove(lhs_name)
            }
          }
          if is_fresh_container_alloc(tokens, rhs_s, rhs_e) {
            inner_fresh[lhs_name] = true
          } else {
            inner_fresh.remove(lhs_name)
            if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
              revoke_bare_idents_in_range(tokens, rhs_s, rhs_e, inner_fresh)
            }
          }
          k = rhs_e
          continue
        }
      }
    }
    let prev_qual = k > s && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)
    // 1b. Static qualified array mutation: `Array::<mutating>(arg0, ...)` or `mbt_compat::arr_<mutating>(arg0, ...)`
    if (tk.raw == "Array" || tk.raw == "mbt_compat") && !prev_qual &&
    k + 3 < e && tokens[k + 1].kind == TokenKind::ColonColon &&
    tokens[k + 2].kind == TokenKind::Ident && tokens[k + 3].kind == TokenKind::LParen {
      let qm = tokens[k + 2].raw
      let is_static_mut = (tk.raw == "Array" && is_array_mutating_method(qm)) ||
      (tk.raw == "mbt_compat" && is_mbt_compat_arr_mutating(qm))
      if is_static_mut {
        let cp = find_matching_delim(tokens, k + 3)
        let a0s = k + 4
        let mut a0e = a0s
        let mut ad = 0
        while a0e < cp {
          let ak = tokens[a0e].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          a0e = a0e + 1
        }
        let arg0_disjoint = a0e == a0s + 1 && tokens[a0s].kind == TokenKind::Ident &&
        (inner_fresh.contains(tokens[a0s].raw) || cb_params.contains(tokens[a0s].raw))
        if !arg0_disjoint {
          return true
        }
      }
    }
    if tk.kind == TokenKind::Ident && !prev_qual {
      // 2. Reassignment `v = rhs`
      if k + 1 < e && tokens[k + 1].kind == TokenKind::Eq {
        let rhs_s = k + 2
        let rhs_e = find_expr_end(tokens, rhs_s, e)
        if tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn" &&
        rhs_s + 1 < rhs_e && tokens[rhs_s + 1].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, rhs_s + 1)
          let lpm : Map[String, Bool] = Map()
          for pn in collect_pion_fn_param_names(tokens, rhs_s + 1, cp) { lpm[pn] = true }
          let mut lb = cp + 1
          while lb < rhs_e && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
          if lb < rhs_e && tokens[lb].kind == TokenKind::LBrace {
            let rb = find_matching_delim(tokens, lb)
            inner_local_fns[tk.raw] = (lb + 1, rb, lpm)
          } else {
            inner_local_fns.remove(tk.raw)
          }
        } else {
          if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
            if stage_b_scope_may_mutate(tokens, rhs_s, rhs_e, inner_fresh, cb_params, inner_local_fns, pkg_fns, visited_fns, recv_root) {
              return true
            }
          }
          if rhs_e == rhs_s + 1 && tokens[rhs_s].kind == TokenKind::Ident {
            match inner_local_fns.get(tokens[rhs_s].raw) {
              Some(fb) => inner_local_fns[tk.raw] = fb
              None => inner_local_fns.remove(tk.raw)
            }
          } else {
            inner_local_fns.remove(tk.raw)
          }
        }
        if !is_fresh_container_alloc(tokens, rhs_s, rhs_e) {
          inner_fresh.remove(tk.raw)
          if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
            revoke_bare_idents_in_range(tokens, rhs_s, rhs_e, inner_fresh)
          }
        }
        k = rhs_e
        continue
      }
      // 3. Function call `callee(args...)`
      if k + 1 < e && tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before {
        let cp = find_matching_delim(tokens, k + 1)
        let callee = tk.raw
        // First scan arguments for mutations
        if stage_b_scope_may_mutate(tokens, k + 2, cp, inner_fresh, cb_params, inner_local_fns, pkg_fns, visited_fns, recv_root) {
          return true
        }
        // Check local fn / closure variable
        match inner_local_fns.get(callee) {
          Some((bs, be, lparams)) =>
          if !visited_fns.contains("local:" + callee) {
            visited_fns["local:" + callee] = true
            let call_fresh = clone_bool_map(inner_fresh)
            let hit = stage_b_scope_may_mutate(tokens, bs, be, call_fresh, lparams, inner_local_fns, pkg_fns, visited_fns, recv_root)
            visited_fns.remove("local:" + callee)
            if hit {
              return true
            }
          }
          None =>
          // Check package top-level function
          match pkg_fns.get(callee) {
            Some(pf) =>
            if !visited_fns.contains("pkg:" + callee) {
              visited_fns["pkg:" + callee] = true
              // Determine which call args are proven-fresh (e.g. `tweak(b)` where `b` is fresh vs `tweak(a)` where `a` is not)
              let pf_fresh : Map[String, Bool] = Map()
              let mut ai = k + 2
              let mut arg_idx = 0
              while ai < cp && arg_idx < pf.params.length() {
                if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
                let mut ae = ai
                let mut ad = 0
                while ae < cp {
                  let ak = tokens[ae].kind
                  if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
                  else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
                  else if ad == 0 && ak == TokenKind::Comma { break }
                  ae = ae + 1
                }
                let is_arg_fresh = is_fresh_container_alloc(tokens, ai, ae) ||
                (ae == ai + 1 && tokens[ai].kind == TokenKind::Ident && inner_fresh.contains(tokens[ai].raw))
                if is_arg_fresh {
                  pf_fresh[pf.params[arg_idx]] = true
                }
                arg_idx = arg_idx + 1
                ai = ae + 1
              }
              let empty_locals : Map[String, (Int, Int, Map[String, Bool])] = Map()
              let empty_cb : Map[String, Bool] = Map()
              let hit = stage_b_scope_may_mutate(pf.tokens, pf.body_s, pf.body_e, pf_fresh, empty_cb, empty_locals, pkg_fns, visited_fns, recv_root)
              visited_fns.remove("pkg:" + callee)
              if hit {
                return true
              }
            }
            None =>
            // External/unknown function or fn-typed param: fail-closed if `recv_root` is passed as a bare argument
            if recv_root.length() > 0 && callee != "panic" && callee != "abort" && callee != "ignore" && callee != "println" && callee != "io_println" {
              let mut ai = k + 2
              while ai < cp {
                if tokens[ai].kind == TokenKind::Comma { ai = ai + 1; continue }
                let mut ae = ai
                let mut ad = 0
                while ae < cp {
                  let ak = tokens[ae].kind
                  if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
                  else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
                  else if ad == 0 && ak == TokenKind::Comma { break }
                  ae = ae + 1
                }
                if ae == ai + 1 && tokens[ai].kind == TokenKind::Ident && tokens[ai].raw == recv_root && !inner_fresh.contains(recv_root) {
                  return true
                }
                ai = ae + 1
              }
            }
          }
        }
        // Opus #39 P2 #1: fail-closed if a mutating method or `[i] =` is applied to call result `f(...).push(...)` / `f(...)[0] = ...`
        let mut post = cp + 1
        while post < e && !tokens[post].newline_before {
          if post + 2 < e && tokens[post].kind == TokenKind::Dot &&
          tokens[post + 1].kind == TokenKind::Ident && tokens[post + 2].kind == TokenKind::LParen {
            if is_array_mutating_method(tokens[post + 1].raw) {
              return true
            }
            post = find_matching_delim(tokens, post + 2) + 1
          } else if post + 1 < e && tokens[post].kind == TokenKind::Dot &&
          (tokens[post + 1].kind == TokenKind::Ident || tokens[post + 1].kind == TokenKind::IntLit) {
            post = post + 2
          } else if tokens[post].kind == TokenKind::LParen {
            post = find_matching_delim(tokens, post) + 1
          } else if tokens[post].kind == TokenKind::LBracket {
            let cb = find_matching_delim(tokens, post)
            if cb + 1 < e && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
              return true
            }
            post = cb + 1
          } else {
            break
          }
        }
        k = cp + 1
        continue
      }
      // 3b. Direct mutation on any parenthesized/call expression `(...).push(...)` or `(...)[0] = ...`
    } else if tk.kind == TokenKind::RParen && !prev_qual {
      let mut post = k + 1
      while post < e && !tokens[post].newline_before {
        if post + 2 < e && tokens[post].kind == TokenKind::Dot &&
        tokens[post + 1].kind == TokenKind::Ident && tokens[post + 2].kind == TokenKind::LParen {
          if is_array_mutating_method(tokens[post + 1].raw) {
            return true
          }
          post = find_matching_delim(tokens, post + 2) + 1
        } else if post + 1 < e && tokens[post].kind == TokenKind::Dot &&
        (tokens[post + 1].kind == TokenKind::Ident || tokens[post + 1].kind == TokenKind::IntLit) {
          post = post + 2
        } else if tokens[post].kind == TokenKind::LBracket {
          let cb = find_matching_delim(tokens, post)
          if cb + 1 < e && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
            return true
          }
          post = cb + 1
        } else {
          break
        }
      }
    }
    if tk.kind == TokenKind::Ident && !prev_qual {
      // 4. Direct/nested array mutation: walk full access chain (`.field`, `.0`, `[idx]`) first;
      //    any `path_depth > 0` fails closed even if root container is fresh (e.g. `wrap[0].push`, `t.0.push`).
      let mut p = k + 1
      let mut path_depth = 0
      while p < e {
        if p + 2 < e && tokens[p].kind == TokenKind::Dot &&
        tokens[p + 1].kind == TokenKind::Ident && tokens[p + 2].kind != TokenKind::LParen {
          p = p + 2
          path_depth = path_depth + 1
        } else if p + 1 < e && tokens[p].kind == TokenKind::Dot &&
        tokens[p + 1].kind == TokenKind::IntLit {
          p = p + 2
          path_depth = path_depth + 1
        } else if tokens[p].kind == TokenKind::LBracket {
          let cb = find_matching_delim(tokens, p)
          if cb + 1 < e && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
            break
          }
          p = cb + 1
          path_depth = path_depth + 1
        } else {
          break
        }
      }
      let is_disjoint_root = path_depth == 0 && (inner_fresh.contains(tk.raw) || cb_params.contains(tk.raw))
      if !is_disjoint_root {
        // Mutating method call `<x>...pop(...)` / `<x>...push(...)` / `<x>...set(...)` / etc.
        if p + 2 < e && tokens[p].kind == TokenKind::Dot &&
        tokens[p + 1].kind == TokenKind::Ident && tokens[p + 2].kind == TokenKind::LParen &&
        is_array_mutating_method(tokens[p + 1].raw) {
          return true
        }
        // Index assignment `<x>...[...] = ...` (excluding `==`, `!=`, `=>`)
        if p < e && tokens[p].kind == TokenKind::LBracket {
          let cb = find_matching_delim(tokens, p)
          if cb + 1 < e && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
            return true
          }
        }
      }
    }
    k = k + 1
  }
  false
}

///| Astra P0-1 / P1-1 / P1-2: Stage B proven-disjoint receiver-mutation gate for `Array::retain` & `Array::filter_map`.
///| Invoked ONLY after `pionc check --json` proves the receiver is `Array[...]` (0 false positives on custom `Holder::retain`).
fn stage_b_check_array_retain_mutation(
  cur_files : Array[GeneratedFile],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  mname : String,
  diags : Array[Diag],
) -> Unit {
  let file_tokens : Map[String, Array[Token]] = Map()
  let pkg_fns = collect_stage_b_pkg_fns_cached(cur_files, file_tokens)
  stage_b_check_array_retain_mutation_cached(file_tokens, pkg_fns, f_rel, content, line, col, mname, diags)
}

fn stage_b_check_array_retain_mutation_cached(
  file_tokens : Map[String, Array[Token]],
  pkg_fns : Map[String, StageBPkgFn],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  mname : String,
  diags : Array[Diag],
) -> Unit {
  stage_b_check_array_retain_mutation_with_root(file_tokens, pkg_fns, f_rel, content, line, col, mname, "", diags)
}

fn stage_b_check_array_retain_mutation_with_root(
  file_tokens : Map[String, Array[Token]],
  pkg_fns : Map[String, StageBPkgFn],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  mname : String,
  recv_root_override : String,
  diags : Array[Diag],
) -> Unit {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let n = tokens.length() - 1
  // Find `.retain(` or `.filter_map(` on `line` closest to `col`
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == mname &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return
  }
  let arg_s = dot_i + 3
  let arg_e = find_matching_delim(tokens, dot_i + 2)
  if arg_s >= arg_e {
    return
  }
  let recv_root = if recv_root_override.length() > 0 { recv_root_override } else { extract_dot_chain_root_ident(tokens, dot_i - 1) }
  // Find enclosing top-level function / test block `[fn_lb, fn_rb]`
  let mut fn_lb = 0
  let mut fn_rb = n
  let mut scan = dot_i
  let mut depth = 0
  while scan >= 0 {
    let sk = tokens[scan].kind
    if sk == TokenKind::RBrace {
      depth = depth + 1
    } else if sk == TokenKind::LBrace {
      if depth == 0 {
        fn_lb = scan
        let mut check_i = scan - 1
        let mut cd = 0
        let mut found_outer = false
        while check_i >= 0 {
          let ck = tokens[check_i].kind
          if ck == TokenKind::RBrace { cd = cd + 1 }
          else if ck == TokenKind::LBrace {
            if cd == 0 { found_outer = true; break }
            cd = cd - 1
          }
          check_i = check_i - 1
        }
        if !found_outer {
          fn_rb = find_matching_delim(tokens, fn_lb)
          break
        }
      } else {
        depth = depth - 1
      }
    }
    scan = scan - 1
  }

  // Pass 1: collect candidate `fresh_disjoint` locals + `local_fn_bodies` + `local_let_vars` in `[fn_lb + 1, fn_rb)` (excluding `[arg_s, arg_e)`)
  let fresh_disjoint : Map[String, Bool] = Map()
  let local_fn_bodies : Map[String, (Int, Int, Map[String, Bool])] = Map()
  let local_let_vars : Map[String, Bool] = Map()
  let mut si = fn_lb + 1
  while si < fn_rb {
    if si >= arg_s && si < arg_e {
      si = arg_e
      continue
    }
    let st = tokens[si]
    if st.kind == TokenKind::Keyword && st.raw == "let" {
      let mut ni = si + 1
      if ni < fn_rb && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni + 1 < fn_rb && tokens[ni].kind == TokenKind::Ident {
        let lhs_name = tokens[ni].raw
        local_let_vars[lhs_name] = true
        let mut eq_i = ni + 1
        if eq_i < fn_rb && tokens[eq_i].kind == TokenKind::Colon {
          let mut td = 0
          while eq_i < fn_rb {
            let ttk = tokens[eq_i].kind
            if ttk == TokenKind::LParen || ttk == TokenKind::LBracket || ttk == TokenKind::LBrace { td = td + 1 }
            else if ttk == TokenKind::RParen || ttk == TokenKind::RBracket || ttk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
            else if td == 0 && ttk == TokenKind::Eq { break }
            eq_i = eq_i + 1
          }
        }
        if eq_i < fn_rb && tokens[eq_i].kind == TokenKind::Eq && eq_i + 1 < fn_rb {
          let rhs_s = eq_i + 1
          let rhs_e = find_expr_end(tokens, rhs_s, fn_rb)
          if is_fresh_container_alloc(tokens, rhs_s, rhs_e) && lhs_name != recv_root && recv_root != "__MBT2PION_UNKNOWN_RECV__" {
            fresh_disjoint[lhs_name] = true
          }
          if tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn" &&
          rhs_s + 1 < rhs_e && tokens[rhs_s + 1].kind == TokenKind::LParen {
            let cp = find_matching_delim(tokens, rhs_s + 1)
            let lpm : Map[String, Bool] = Map()
            for pn in collect_pion_fn_param_names(tokens, rhs_s + 1, cp) { lpm[pn] = true }
            let mut lb = cp + 1
            while lb < rhs_e && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
            if lb < rhs_e && tokens[lb].kind == TokenKind::LBrace {
              let rb = find_matching_delim(tokens, lb)
              local_fn_bodies[lhs_name] = (lb + 1, rb, lpm)
            }
          } else if rhs_e == rhs_s + 1 && tokens[rhs_s].kind == TokenKind::Ident {
            match local_fn_bodies.get(tokens[rhs_s].raw) {
              Some(fb) => local_fn_bodies[lhs_name] = fb
              None => ()
            }
          }
        }
      }
    }
    si = si + 1
  }

  // Pass 2: Undirected alias revocation across `[fn_lb + 1, fn_rb)` (excluding `[arg_s, arg_e)`)
  si = fn_lb + 1
  while si < fn_rb {
    if si >= arg_s && si < arg_e {
      si = arg_e
      continue
    }
    let st = tokens[si]
    if st.kind == TokenKind::Keyword && st.raw == "let" {
      let mut ni = si + 1
      if ni < fn_rb && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" {
        ni = ni + 1
      }
      if ni + 1 < fn_rb && tokens[ni].kind == TokenKind::Ident {
        let lhs_name = tokens[ni].raw
        let mut eq_i = ni + 1
        if eq_i < fn_rb && tokens[eq_i].kind == TokenKind::Colon {
          let mut td = 0
          while eq_i < fn_rb {
            let ttk = tokens[eq_i].kind
            if ttk == TokenKind::LParen || ttk == TokenKind::LBracket || ttk == TokenKind::LBrace { td = td + 1 }
            else if ttk == TokenKind::RParen || ttk == TokenKind::RBracket || ttk == TokenKind::RBrace { if td > 0 { td = td - 1 } }
            else if td == 0 && ttk == TokenKind::Eq { break }
            eq_i = eq_i + 1
          }
        }
        if eq_i < fn_rb && tokens[eq_i].kind == TokenKind::Eq && eq_i + 1 < fn_rb {
          let rhs_s = eq_i + 1
          let rhs_e = find_expr_end(tokens, rhs_s, fn_rb)
          if !is_fresh_container_alloc(tokens, rhs_s, rhs_e) {
            fresh_disjoint.remove(lhs_name)
            if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
              revoke_bare_idents_in_range(tokens, rhs_s, rhs_e, fresh_disjoint)
            }
          }
        }
      }
    } else if st.kind == TokenKind::Ident && !(si > fn_lb && (tokens[si - 1].kind == TokenKind::Dot || tokens[si - 1].kind == TokenKind::ColonColon ||
      (tokens[si - 1].kind == TokenKind::Keyword && (tokens[si - 1].raw == "let" || tokens[si - 1].raw == "mut")))) &&
    si + 1 < fn_rb && tokens[si + 1].kind == TokenKind::Eq {
      let rhs_s = si + 2
      let rhs_e = find_expr_end(tokens, rhs_s, fn_rb)
      local_fn_bodies.remove(st.raw)
      if !is_fresh_container_alloc(tokens, rhs_s, rhs_e) {
        fresh_disjoint.remove(st.raw)
        if !(tokens[rhs_s].kind == TokenKind::Keyword && tokens[rhs_s].raw == "fn") {
          revoke_bare_idents_in_range(tokens, rhs_s, rhs_e, fresh_disjoint)
        }
      }
    }
    si = si + 1
  }
  if recv_root.length() > 0 {
    fresh_disjoint.remove(recv_root)
  }

  let visited_fns : Map[String, Bool] = Map()
  let mut may_mutate = false
  if tokens[arg_s].kind == TokenKind::Keyword && tokens[arg_s].raw == "fn" &&
  arg_s + 1 < arg_e && tokens[arg_s + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, arg_s + 1)
    let cb_params : Map[String, Bool] = Map()
    for pn in collect_pion_fn_param_names(tokens, arg_s + 1, cp) { cb_params[pn] = true }
    let mut lb = cp + 1
    while lb < arg_e && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
    if lb < arg_e && tokens[lb].kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, lb)
      may_mutate = stage_b_scope_may_mutate(tokens, lb + 1, rb, clone_bool_map(fresh_disjoint), cb_params, local_fn_bodies, pkg_fns, visited_fns, recv_root)
    }
  } else if arg_e == arg_s + 1 && tokens[arg_s].kind == TokenKind::Ident {
    let cb_name = tokens[arg_s].raw
    match local_fn_bodies.get(cb_name) {
      Some((bs, be, lparams)) => {
        visited_fns["local:" + cb_name] = true
        may_mutate = stage_b_scope_may_mutate(tokens, bs, be, clone_bool_map(fresh_disjoint), lparams, local_fn_bodies, pkg_fns, visited_fns, recv_root)
        visited_fns.remove("local:" + cb_name)
      }
      None =>
      match pkg_fns.get(cb_name) {
        Some(pf) => {
          visited_fns["pkg:" + cb_name] = true
          let empty_f : Map[String, Bool] = Map()
          let empty_l : Map[String, (Int, Int, Map[String, Bool])] = Map()
          let cb_p : Map[String, Bool] = Map()
          for pn in pf.params { cb_p[pn] = true }
          may_mutate = stage_b_scope_may_mutate(pf.tokens, pf.body_s, pf.body_e, empty_f, cb_p, empty_l, pkg_fns, visited_fns, recv_root)
          visited_fns.remove("pkg:" + cb_name)
        }
        None =>
        if local_let_vars.contains(cb_name) {
          may_mutate = true
        }
      }
    }
  } else {
    let empty_p : Map[String, Bool] = Map()
    may_mutate = stage_b_scope_may_mutate(tokens, arg_s, arg_e, clone_bool_map(fresh_disjoint), empty_p, local_fn_bodies, pkg_fns, visited_fns, recv_root)
  }

  if may_mutate {
    let mut dup = false
    for existing in diags {
      if existing.code == "MBT2PION_UNSUPPORTED_SYNTAX" && existing.file == f_rel && existing.line == line && existing.col == col {
        dup = true
        break
      }
    }
    if !dup {
      diags.push(diag_error(
        "MBT2PION_UNSUPPORTED_SYNTAX",
        f_rel,
        line,
        col,
        "callback mutating receiver or non-disjoint array inside `Array::" + mname + "(...)` is not supported (fail-closed)",
      ))
    }
  }
}

// ---------------------------------------------------------------------------
// 5. Recursive Nested Tuple-Struct Destructuring (`let W(V(p, q), name) = w`)
// ---------------------------------------------------------------------------

fn emit_tuple_struct_destructure(
  ctx : StageAContext,
  sb : StringBuilder,
  val_expr : String,
  tokens : Array[Token],
  pi : Int,
  pe : Int,
  file : String,
) -> Unit {
  if pi >= pe {
    return
  }
  if pi + 1 < pe && tokens[pi].kind == TokenKind::UpperIdent &&
  ctx.symtab.tuple_structs.contains(tokens[pi].raw) && tokens[pi + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, pi + 1)
    if cp == pe - 1 {
      let inner_tmp = fresh_temp(ctx, "ts")
      sb.write_string("; let " + inner_tmp + " = " + val_expr)
      let mut si = pi + 2
      let mut fidx = 0
      while si < cp {
        if tokens[si].kind == TokenKind::Comma {
          si = si + 1
          continue
        }
        if tokens[si].kind == TokenKind::DotDot {
          break
        }
        let mut se = si
        let mut sd = 0
        while se < cp {
          let sk = tokens[se].kind
          if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { sd = sd + 1 }
          else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { sd = sd - 1 }
          else if sd == 0 && sk == TokenKind::Comma { break }
          se = se + 1
        }
        emit_tuple_struct_destructure(ctx, sb, inner_tmp + "._" + fidx.to_string(), tokens, si, se, file)
        fidx = fidx + 1
        si = se + 1
      }
      return
    }
  }
  let pat_s = lower_expr_range(ctx, tokens, pi, pe, file, true).trim()
  if pat_s.length() > 0 && pat_s != "_" {
    sb.write_string("; let " + pat_s + " = " + val_expr)
  }
}

// ---------------------------------------------------------------------------
// 6. Generic Bounds Lowering (`[K : Hash + Eq]` -> `[K : mbt_compat::MbtHash + Eq + mbt_compat::MapKey]`)
// ---------------------------------------------------------------------------

fn lower_generic_bounds_brackets(
  ctx : StageAContext,
  tokens : Array[Token],
  open_b : Int,
  close_b : Int,
  file : String,
) -> String {
  let params : Array[String] = []
  let mut cur = open_b + 1
  while cur < close_b {
    if tokens[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut pe = cur
    let mut pd = 0
    while pe < close_b {
      let pk = tokens[pe].kind
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
      else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
      else if pd == 0 && pk == TokenKind::Comma { break }
      pe = pe + 1
    }
    if pe > cur {
      // Find depth-0 `:` separating type param name from bounds
      let mut col_i = -1
      let mut k = cur
      let mut bd = 0
      while k < pe {
        let kk = tokens[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { bd = bd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { bd = bd - 1 }
        else if bd == 0 && kk == TokenKind::Colon { col_i = k; break }
        k = k + 1
      }
      if col_i > cur && col_i + 1 < pe {
        let tp_name = tokens[cur].raw
        let mut has_hash = false
        let mut has_eq = false
        let bounds : Array[String] = []
        let mut bs = col_i + 1
        while bs < pe {
          if tokens[bs].kind == TokenKind::Plus {
            bs = bs + 1
            continue
          }
          let mut be = bs
          let mut bdepth = 0
          while be < pe {
            let bk = tokens[be].kind
            if bk == TokenKind::LParen || bk == TokenKind::LBracket || bk == TokenKind::LBrace { bdepth = bdepth + 1 }
            else if bk == TokenKind::RParen || bk == TokenKind::RBracket || bk == TokenKind::RBrace { bdepth = bdepth - 1 }
            else if bdepth == 0 && bk == TokenKind::Plus { break }
            be = be + 1
          }
          if be > bs {
            let raw_b = lower_type_tokens_checked(ctx, tokens, bs, be, file).trim()
            if raw_b == "Hash" && !ctx.symtab.local_types.contains("Hash") {
              has_hash = true
              bounds.push("mbt_compat::MbtHash")
            } else if raw_b == "Eq" && !ctx.symtab.local_types.contains("Eq") {
              has_eq = true
            } else {
              bounds.push(raw_b)
            }
          }
          bs = be + 1
        }
        if has_eq {
          bounds.push("Eq")
        }
        if has_hash && has_eq {
          bounds.push("mbt_compat::MapKey")
        }
        if bounds.length() == 0 {
          params.push(tp_name)
        } else {
          let bsb = StringBuilder()
          let mut bi = 0
          while bi < bounds.length() {
            if bi > 0 { bsb.write_string(" + ") }
            bsb.write_string(bounds[bi])
            bi = bi + 1
          }
          params.push(tp_name + " : " + bsb.to_string())
        }
      } else {
        params.push(lower_type_tokens_checked(ctx, tokens, cur, pe, file).trim())
      }
    }
    cur = pe + 1
  }
  "[" + join_comma(params) + "]"
}

// ---------------------------------------------------------------------------
// 7. Collision-Free Operator Trait Lowering (`Add`/`Sub`/`Mul`/`Neg`/`Div`)
//    + Active Type-Directed `Neg` (`-p`) Probing Pass
// ---------------------------------------------------------------------------

fn canonical_op_for_trait_method(trait_name : String, method_name : String) -> Option[String] {
  if trait_name == "Add" && (method_name == "add" || method_name == "op_add") {
    return Some("add")
  }
  if trait_name == "Sub" && (method_name == "sub" || method_name == "op_sub") {
    return Some("sub")
  }
  if trait_name == "Mul" && (method_name == "mul" || method_name == "op_mul") {
    return Some("mul")
  }
  if trait_name == "Neg" && (method_name == "neg" || method_name == "op_neg") {
    return Some("neg")
  }
  if trait_name == "Div" && (method_name == "div" || method_name == "op_div") {
    return Some("div")
  }
  None
}

fn sanitize_op_type_ident(ty : String) -> String {
  let sb = StringBuilder()
  let mut i = 0
  while i < ty.length() {
    let c = ty.code_unit_at(i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      sb.write_byte(c.to_byte())
    } else {
      sb.write_string("_")
    }
    i = i + 1
  }
  let out = sb.to_string()
  if out.length() == 0 { "T" } else { out }
}

fn alloc_collision_free_op_fn(used_syms : Map[String, Bool], op : String, type_name : String) -> String {
  let base = "mbt_op_" + op + "_" + sanitize_op_type_ident(type_name)
  if !used_syms.contains(base) {
    used_syms[base] = true
    return base
  }
  let mut n = 1
  while true {
    let cand = base + "_" + n.to_string()
    if !used_syms.contains(cand) {
      used_syms[cand] = true
      return cand
    }
    n = n + 1
  }
  base
}

///| Fill omitted parameter types from `self_ty` in `impl (Add|Sub|Mul|Neg|Div)` param list.
fn fill_op_impl_params(src : String, toks : Array[Token], open_p : Int, close_p : Int, self_ty : String) -> String {
  let parts : Array[String] = []
  let mut cur = open_p + 1
  while cur < close_p {
    if toks[cur].kind == TokenKind::Comma {
      cur = cur + 1
      continue
    }
    let mut pe = cur
    let mut pd = 0
    while pe < close_p {
      let pk = toks[pe].kind
      if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
      else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
      else if pd == 0 && pk == TokenKind::Comma { break }
      pe = pe + 1
    }
    if pe > cur {
      let mut has_colon = false
      let mut k = cur
      let mut bd = 0
      while k < pe {
        let kk = toks[k].kind
        if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { bd = bd + 1 }
        else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { bd = bd - 1 }
        else if bd == 0 && kk == TokenKind::Colon { has_colon = true; break }
        k = k + 1
      }
      let raw_p = src.slice(toks[cur].start_byte, toks[pe - 1].end_byte).trim()
      if has_colon {
        parts.push(raw_p)
      } else {
        parts.push(raw_p + " : " + self_ty)
      }
    }
    cur = pe + 1
  }
  join_comma(parts)
}

///| Pre-pass before Stage A: lower `[pub] impl (Add|Sub|Mul|Neg|Div) for <Type> with <op>(...) [-> Ret] { ... }`
///| into collision-free top-level functions `mbt_op_<op>_<Type>` (NEVER colliding with inherent `Type::add`!).
pub fn preprocess_op_trait_impls(
  sources : Array[SourceFile],
  self_pkg : String,
) -> (Array[SourceFile], Array[OpImplEntry]) {
  let used_syms : Map[String, Bool] = Map()
  let pub_types : Map[String, Bool] = Map()
  // Pass 1: collect ALL identifiers (at ANY lexical depth, so local closures/bindings can never shadow
  // generated `mbt_op_<op>_<Type>` helpers — Astra P0-1) & top-level `pub` types across all source files
  for sf in sources {
    let toks = lex_moonbit(sf.content)
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent {
        used_syms[t.raw] = true
      }
      if depth == 0 {
        if t.kind == TokenKind::Keyword && t.raw == "pub" {
          let mut k = i + 1
          if k < n && toks[k].kind == TokenKind::LParen {
            k = find_matching_delim(toks, k) + 1
          }
          if k + 1 < n && toks[k].kind == TokenKind::Keyword &&
          (toks[k].raw == "struct" || toks[k].raw == "enum" || toks[k].raw == "type") &&
          toks[k + 1].kind == TokenKind::UpperIdent {
            pub_types[toks[k + 1].raw] = true
          }
        }
      }
      i = i + 1
    }
  }

  let out_sources : Array[SourceFile] = []
  let op_entries : Array[OpImplEntry] = []
  for sf in sources {
    let src = sf.content
    let toks = lex_moonbit(src)
    let n = toks.length() - 1
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 {
        let mut is_pub = false
        let mut impl_i = i
        if t.kind == TokenKind::Keyword && t.raw == "pub" {
          is_pub = true
          impl_i = i + 1
          if impl_i < n && toks[impl_i].kind == TokenKind::LParen {
            impl_i = find_matching_delim(toks, impl_i) + 1
          }
        }
        if impl_i < n && toks[impl_i].kind == TokenKind::Keyword && toks[impl_i].raw == "impl" &&
        !(impl_i + 1 < n && toks[impl_i + 1].kind == TokenKind::LBracket) {
          let mut for_i = -1
          let mut with_i = -1
          let mut lb = impl_i + 1
          while lb < n && toks[lb].kind != TokenKind::LBrace {
            if toks[lb].kind == TokenKind::Keyword && toks[lb].raw == "for" && for_i < 0 {
              for_i = lb
            } else if toks[lb].kind == TokenKind::Keyword && toks[lb].raw == "with" && with_i < 0 {
              with_i = lb
            }
            lb = lb + 1
          }
          if for_i > impl_i && with_i > for_i + 1 && lb < n && toks[lb].kind == TokenKind::LBrace && with_i + 1 < lb {
            let trait_name = src.slice(toks[impl_i + 1].start_byte, toks[for_i - 1].end_byte).trim()
            let self_ty = src.slice(toks[for_i + 1].start_byte, toks[with_i - 1].end_byte).trim()
            let mname = toks[with_i + 1].raw
            // Only non-generic concrete type names (no `[`)
            if !str_has(self_ty, "[") {
              match canonical_op_for_trait_method(trait_name, mname) {
                Some(canon_op) => {
                  let mut open_p = with_i + 2
                  while open_p < lb && toks[open_p].kind != TokenKind::LParen {
                    open_p = open_p + 1
                  }
                  if open_p < lb {
                    let close_p = find_matching_delim(toks, open_p)
                    let typed_params = fill_op_impl_params(src, toks, open_p, close_p, self_ty)
                    let ret_str = if close_p + 1 < lb && toks[close_p + 1].kind == TokenKind::Arrow {
                      " -> " + src.slice(toks[close_p + 2].start_byte, toks[lb - 1].end_byte).trim()
                    } else {
                      " -> " + self_ty
                    }
                    let fn_name = alloc_collision_free_op_fn(used_syms, canon_op, self_ty)
                    let emit_pub = is_pub || pub_types.contains(self_ty)
                    let vis = if emit_pub { "pub " } else { "" }
                    let repl_hdr = vis + "fn " + fn_name + "(" + typed_params + ")" + ret_str + " "
                    edits.push((toks[i].start_byte, toks[lb].start_byte, repl_hdr))
                    op_entries.push(OpImplEntry::{
                      pkg: self_pkg,
                      type_name: self_ty,
                      op: canon_op,
                      fn_name: fn_name,
                    })
                    let rb = find_matching_delim(toks, lb)
                    i = rb + 1
                    continue
                  }
                }
                None => ()
              }
            }
          }
        }
      }
      i = i + 1
    }
    if edits.length() > 0 {
      out_sources.push(SourceFile::{
        rel_path: sf.rel_path,
        content: apply_byte_edits(src, edits),
        is_test: sf.is_test,
      })
    } else {
      out_sources.push(sf)
    }
  }
  (out_sources, op_entries)
}

///| Build lookup map `type_name|op -> helper_fn_name` from local + verified `--dep` ABIs.
pub fn build_op_impl_lookup(
  local_ops : Array[OpImplEntry],
  dep_abis : Array[(String, PackageAbi)],
) -> Map[String, String] {
  let out : Map[String, String] = Map()
  for op in local_ops {
    out[op.type_name + "|" + op.op] = op.fn_name
  }
  for pair in dep_abis {
    let dname = pair.0
    for op in pair.1.op_impls {
      let qual_ty = dname + "::" + op.type_name
      let qual_fn = dname + "::" + op.fn_name
      out[qual_ty + "|" + op.op] = qual_fn
    }
  }
  out
}

pub fn has_any_neg_impl(op_lookup : Map[String, String]) -> Bool {
  for k in op_lookup.keys() {
    if k.ends_with("|neg") {
      return true
    }
  }
  false
}

fn is_value_ending_tok(t : Token) -> Bool {
  t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::IntLit || t.kind == TokenKind::FloatLit ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::CharLit ||
  t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline ||
  t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket || t.kind == TokenKind::RBrace ||
  (t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false" || t.raw == "self"))
}

struct NegProbeCandidate {
  probe_id : String
  file : String
  minus_byte : Int
  end_byte : Int
  operand_expr : String
}

///| Active type-directed unary `Neg` (`-p`, `-p.x`, `-get_p().y`, `-(a + b)`, `-as_int(-p)`, `------p`) probing pass.
///| Uses innermost-first probing and iterates up to 64 rounds (fail-closed if exceeded).
///| Only runs when `has_any_neg_impl(op_lookup)` is true (zero overhead otherwise).
pub fn run_neg_probe_pass(
  files : Array[GeneratedFile],
  op_lookup : Map[String, String],
  check_fn : (Array[(String, String)]) -> String,
  diags : Array[Diag],
) -> (Array[GeneratedFile], Bool) {
  if !has_any_neg_impl(op_lookup) {
    return (files, false)
  }
  let mut cur_files = files
  let mut total_changed = false
  let safe_by_file : Map[String, Map[Int, Bool]] = Map()
  let mut seq = 0
  let mut round = 0
  let mut last_round_progressed = false
  while round < 64 {
    let cands_by_file : Map[String, Array[NegProbeCandidate]] = Map()
    let scratch_batch : Array[(String, String)] = []
    let mut total_cands = 0
    for gf in cur_files {
      let smap = match safe_by_file.get(gf.rel_path) {
        Some(m) => m
        None => {
          let m : Map[Int, Bool] = Map()
          safe_by_file[gf.rel_path] = m
          m
        }
      }
      let toks = lex_moonbit(gf.content)
      let tn = toks.length() - 1
      let fcands : Array[NegProbeCandidate] = []
      let scratch_edits : Array[(Int, Int, String)] = []
      let mut last_end = 0
      let mut i = 0
      let mut depth = 0
      while i < tn {
        let t = toks[i]
        if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
        if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
        if t.kind == TokenKind::Minus && t.start_byte >= last_end && !smap.contains(t.start_byte) {
          let is_unary = i == 0 || t.newline_before || !is_value_ending_tok(toks[i - 1])
          if is_unary && i + 1 < tn {
            let nxt = toks[i + 1]
            // Parse full postfix expression starting at `i + 1`
            let mut j = i + 1
            let mut valid_base = false
            if nxt.kind == TokenKind::LParen || nxt.kind == TokenKind::LBracket || nxt.kind == TokenKind::LBrace {
              j = find_matching_delim(toks, j) + 1
              valid_base = true
            } else if nxt.kind == TokenKind::Keyword && nxt.raw == "match" {
              let mut mk = j + 1
              while mk < tn {
                if toks[mk].kind == TokenKind::LParen || toks[mk].kind == TokenKind::LBracket {
                  mk = find_matching_delim(toks, mk) + 1
                } else if toks[mk].kind == TokenKind::LBrace {
                  if mk > j + 1 && toks[mk - 1].kind == TokenKind::ColonColon {
                    mk = find_matching_delim(toks, mk) + 1
                  } else {
                    j = find_matching_delim(toks, mk) + 1
                    valid_base = true
                    break
                  }
                } else {
                  mk = mk + 1
                }
              }
            } else if nxt.kind == TokenKind::Keyword && nxt.raw == "if" {
              let mut ik = j + 1
              let mut found_then = false
              while ik < tn {
                if toks[ik].kind == TokenKind::LParen || toks[ik].kind == TokenKind::LBracket {
                  ik = find_matching_delim(toks, ik) + 1
                } else if toks[ik].kind == TokenKind::LBrace {
                  if ik > j + 1 && toks[ik - 1].kind == TokenKind::ColonColon {
                    ik = find_matching_delim(toks, ik) + 1
                  } else {
                    ik = find_matching_delim(toks, ik) + 1
                    found_then = true
                    break
                  }
                } else {
                  ik = ik + 1
                }
              }
              if found_then {
                while ik < tn && toks[ik].kind == TokenKind::Keyword && toks[ik].raw == "else" {
                  ik = ik + 1
                  if ik < tn && toks[ik].kind == TokenKind::Keyword && toks[ik].raw == "if" {
                    ik = ik + 1
                    let mut found_elif = false
                    while ik < tn {
                      if toks[ik].kind == TokenKind::LParen || toks[ik].kind == TokenKind::LBracket {
                        ik = find_matching_delim(toks, ik) + 1
                      } else if toks[ik].kind == TokenKind::LBrace {
                        if ik > 0 && toks[ik - 1].kind == TokenKind::ColonColon {
                          ik = find_matching_delim(toks, ik) + 1
                        } else {
                          ik = find_matching_delim(toks, ik) + 1
                          found_elif = true
                          break
                        }
                      } else {
                        ik = ik + 1
                      }
                    }
                    if !found_elif {
                      break
                    }
                  } else if ik < tn && toks[ik].kind == TokenKind::LBrace {
                    ik = find_matching_delim(toks, ik) + 1
                    j = ik
                    valid_base = true
                    break
                  } else {
                    break
                  }
                }
              }
            } else if nxt.kind == TokenKind::Ident || nxt.kind == TokenKind::UpperIdent ||
            (nxt.kind == TokenKind::Keyword && nxt.raw == "self") {
              j = j + 1
              while j + 1 < tn && toks[j].kind == TokenKind::ColonColon &&
              (toks[j + 1].kind == TokenKind::Ident || toks[j + 1].kind == TokenKind::UpperIdent) {
                j = j + 2
              }
              if j + 1 < tn && toks[j].kind == TokenKind::ColonColon && toks[j + 1].kind == TokenKind::LBrace {
                j = find_matching_delim(toks, j + 1) + 1
              }
              valid_base = true
            } else if nxt.kind == TokenKind::IntLit || nxt.kind == TokenKind::FloatLit {
              // Skip bare numeric literals `-1`, `-3.14` (always primitive numeric!)
              valid_base = false
            }
            if valid_base {
              while j < tn && !toks[j].newline_before {
                if toks[j].kind == TokenKind::Dot && j + 1 < tn &&
                (toks[j + 1].kind == TokenKind::Ident || toks[j + 1].kind == TokenKind::IntLit) {
                  j = j + 2
                } else if toks[j].kind == TokenKind::LParen {
                  j = find_matching_delim(toks, j) + 1
                } else if toks[j].kind == TokenKind::LBracket {
                  j = find_matching_delim(toks, j) + 1
                } else {
                  break
                }
              }
              // Innermost-first (Astra P0-2 / `-as_int(-p)`): if `[i + 1 .. j)` contains any unprobed
              // inner unary `-` (excluding bare numeric literals), defer this outer `-` to a later round!
              let mut has_inner_unprobed = false
              let mut k = i + 1
              while k < j {
                if toks[k].kind == TokenKind::Minus && !smap.contains(toks[k].start_byte) {
                  let k_unary = k == 0 || toks[k].newline_before || !is_value_ending_tok(toks[k - 1])
                  if k_unary && k + 1 < tn &&
                  toks[k + 1].kind != TokenKind::IntLit && toks[k + 1].kind != TokenKind::FloatLit {
                    has_inner_unprobed = true
                    break
                  }
                }
                k = k + 1
              }
              if !has_inner_unprobed && j > i + 1 {
                let end_b = toks[j - 1].end_byte
                let expr_s = gf.content.slice(toks[i + 1].start_byte, end_b).trim()
                if expr_s.length() > 0 {
                  let pid = "p" + seq.to_string()
                  seq = seq + 1
                  fcands.push(NegProbeCandidate::{
                    probe_id: pid,
                    file: gf.rel_path,
                    minus_byte: t.start_byte,
                    end_byte: end_b,
                    operand_expr: expr_s,
                  })
                  scratch_edits.push((t.start_byte, end_b, "(" + expr_s + ").mbt_neg_probe__" + pid + "()"))
                  last_end = end_b
                  total_cands = total_cands + 1
                  i = j
                  continue
                }
              }
            }
          }
        }
        i = i + 1
      }
      cands_by_file[gf.rel_path] = fcands
      let scratch_src = if scratch_edits.length() > 0 {
        apply_byte_edits(gf.content, scratch_edits)
      } else {
        gf.content
      }
      scratch_batch.push((gf.rel_path, scratch_src))
    }
    if total_cands == 0 {
      last_round_progressed = false
      break
    }
    let raw_json = check_fn(scratch_batch)
    let pdiags = parse_pionc_diagnostics(raw_json)
    let resolved_by_id : Map[String, String] = Map()
    for d in pdiags {
      match extract_probe_with_id_from_diag(d) {
        Some((pkind, pid, rty)) =>
        if pkind == "mbt_neg_probe" && pid.length() > 0 {
          resolved_by_id[pid] = rty
        }
        None => ()
      }
    }
    let mut round_changed = false
    let mut new_safe_added = false
    let next_files : Array[GeneratedFile] = []
    for gf in cur_files {
      let fcands = match cands_by_file.get(gf.rel_path) {
        Some(xs) => xs
        None => []
      }
      let smap = match safe_by_file.get(gf.rel_path) {
        Some(m) => m
        None => Map()
      }
      let real_edits : Array[(Int, Int, String)] = []
      for c in fcands {
        match resolved_by_id.get(c.probe_id) {
          Some(rty) =>
          match op_lookup.get(rty + "|neg") {
            Some(fn_name) => {
              real_edits.push((c.minus_byte, c.end_byte, fn_name + "(" + c.operand_expr + ")"))
            }
            None => {
              if !smap.contains(c.minus_byte) {
                smap[c.minus_byte] = true
                new_safe_added = true
              }
            }
          }
          None => {
            if !smap.contains(c.minus_byte) {
              smap[c.minus_byte] = true
              new_safe_added = true
            }
          }
        }
      }
      if real_edits.length() > 0 {
        round_changed = true
        total_changed = true
        // Reset safe offsets for this file since byte offsets shifted
        safe_by_file[gf.rel_path] = Map()
        next_files.push(GeneratedFile::{
          rel_path: gf.rel_path,
          content: apply_byte_edits(gf.content, real_edits),
          source_file: gf.source_file,
          anchors: gf.anchors,
        })
      } else {
        next_files.push(gf)
      }
    }
    cur_files = next_files
    last_round_progressed = round_changed || new_safe_added
    if !last_round_progressed {
      break
    }
    round = round + 1
  }
  if round == 64 && last_round_progressed {
    diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      "<neg-probe>",
      1,
      1,
      "unary `-` operator trait lowering did not converge within 64 rounds (fail-closed)",
    ))
  }
  (cur_files, total_changed)
}

// 7. Wave M2-E2 (§E2-1): `pub using` ABI Canonical Re-Exports
fn resolve_dep_pkg_alias(raw_pkg : String, pkg_aliases : Map[String, String], moon_import_paths : Map[String, String], _known_pkgs : Map[String, Bool]) -> String {
  match pkg_aliases.get(raw_pkg) { Some(p) => return p, None => () }
  match moon_import_paths.get(raw_pkg) { Some(fp) => { let d = moon_import_default_alias(fp); if d.length() > 0 { return d } }, None => () }
  raw_pkg
}
fn build_dep_pub_index(dep_doc_jsons : Array[String], dep_abis : Array[(String, PackageAbi)]) -> (Map[String, Map[String, Bool]], Map[String, Map[String, Bool]], Map[String, Bool], Map[String, Map[String, AbiReexport]]) {
  let pub_types : Map[String, Map[String, Bool]] = Map(); let pub_values : Map[String, Map[String, Bool]] = Map()
  let known_pkgs : Map[String, Bool] = Map(); let dep_re : Map[String, Map[String, AbiReexport]] = Map()
  for dj in dep_doc_jsons {
    if dj.trim().length() == 0 { continue }
    let root = match json::parse(dj) { Ok(v) => v, Err(_) => continue }
    let pkgs = match json::obj_get(root, "packages") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
    let last_i = pkgs.length() - 1; let mut pi = 0
    for pkg in pkgs {
      let pname = j_str(pkg, "name", ""); let is_root = pi == last_i; pi = pi + 1; if pname.length() == 0 { continue }
      if is_root { known_pkgs[pname] = true }
      let tmap = match pub_types.get(pname) { Some(m) => m, None => { let m : Map[String, Bool] = Map(); pub_types[pname] = m; m } }
      let vmap = match pub_values.get(pname) { Some(m) => m, None => { let m : Map[String, Bool] = Map(); pub_values[pname] = m; m } }
      let items = match json::obj_get(pkg, "items") { Some(v) => match json::as_arr(v) { Some(a) => a, None => continue }, None => continue }
      for it in items {
        let k = j_str(it, "kind", ""); let nm = j_str(it, "name", ""); if nm.length() == 0 { continue }
        if k == "struct" || k == "enum" || k == "type" || k == "typealias" { tmap[nm] = true }
        else if k == "fn" || k == "let" || k == "const" || k == "var" || k == "val" || k == "global" { vmap[nm] = true }
      }
    }
  }
  for pair in dep_abis {
    known_pkgs[pair.0] = true
    if pair.1.reexports.length() > 0 { let rmap : Map[String, AbiReexport] = Map(); for r in pair.1.reexports { rmap[r.name] = r }; dep_re[pair.0] = rmap }
  }
  (pub_types, pub_values, known_pkgs, dep_re)
}
fn parse_using_block_items(tokens : Array[Token], lb : Int, rb : Int) -> Option[Array[(String, String)]] {
  let out : Array[(String, String)] = []; let mut k = lb + 1
  while k < rb {
    let t = tokens[k]
    if t.kind == TokenKind::Comma || t.kind == TokenKind::Semi { k = k + 1; continue }
    if is_kw_or_id(t, "type") && k + 1 < rb && (tokens[k + 1].kind == TokenKind::UpperIdent || tokens[k + 1].kind == TokenKind::Ident) {
      let nm = tokens[k + 1].raw; k = k + 2; if k < rb && is_kw_or_id(tokens[k], "as") { return None }; out.push(("type", nm)); continue
    }
    if (t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent) && t.raw != "trait" && t.raw != "as" {
      let nm = t.raw; k = k + 1; if k < rb && is_kw_or_id(tokens[k], "as") { return None }; out.push(("value", nm)); continue
    }
    return None
  }
  Some(out)
}
fn resolve_reexport_chain(start_pkg : String, start_name : String, want_kind : String, dep_re : Map[String, Map[String, AbiReexport]], file : String, line : Int, col : Int, diags : Array[Diag]) -> Option[(String, String)] {
  let mut cur_pkg = start_pkg; let mut cur_name = start_name; let visited : Map[String, Bool] = Map()
  while true {
    let vk = cur_pkg + "::" + cur_name
    if visited.contains(vk) { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", file, line, col, "cyclic `pub using` involving `" + vk + "`")); return None }
    visited[vk] = true
    match dep_re.get(cur_pkg) {
      Some(rmap) => match rmap.get(cur_name) {
        Some(re) => { if want_kind.length() > 0 && re.kind != want_kind { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", file, line, col, "`pub using` kind mismatch for `" + start_name + "`")); return None }; cur_pkg = re.target_pkg; cur_name = re.target_name }
        None => break
      }
      None => break
    }
  }
  Some((cur_pkg, cur_name))
}

pub fn preprocess_pub_using(sources : Array[SourceFile], pkg_aliases : Map[String, String], moon_import_paths : Map[String, String], dep_doc_jsons : Array[String], dep_abis : Array[(String, PackageAbi)], diags : Array[Diag]) -> (Array[SourceFile], Array[AbiReexport]) {
  let (pub_types, pub_values, known_pkgs, dep_re) = build_dep_pub_index(dep_doc_jsons, dep_abis)
  let out_sources : Array[SourceFile] = []; let reexports : Array[AbiReexport] = []; let seen_exports : Map[String, String] = Map()
  for sf in sources {
    let toks = lex_moonbit(sf.content); let n = toks.length() - 1; let edits : Array[(Int, Int, String)] = []; let mut i = 0; let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "pub" && i + 3 < n && is_kw_or_id(toks[i + 1], "using") && toks[i + 2].kind == TokenKind::PkgRef && toks[i + 3].kind == TokenKind::LBrace {
        let rb = find_matching_delim(toks, i + 3)
        match parse_using_block_items(toks, i + 3, rb) {
          Some(items) => {
            let dep_pkg = resolve_dep_pkg_alias(toks[i + 2].raw.slice(1, toks[i + 2].raw.length()), pkg_aliases, moon_import_paths, known_pkgs)
            for it in items {
              match resolve_reexport_chain(dep_pkg, it.1, it.0, dep_re, sf.rel_path, t.line, t.col, diags) {
                Some((tpkg, tname)) => {
                  let ok = known_pkgs.contains(tpkg) && (if it.0 == "type" { match pub_types.get(tpkg) { Some(m) => m.contains(tname), None => false } } else { match pub_values.get(tpkg) { Some(m) => m.contains(tname), None => false } })
                  if !ok { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", sf.rel_path, t.line, t.col, "`pub using` target `" + tpkg + "::" + tname + "` (" + it.0 + ") missing, private, or wrong kind")) }
                  else {
                    let sig = it.0 + ":" + tpkg + "::" + tname
                    match seen_exports.get(it.1) { Some(prev) => if prev != sig { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", sf.rel_path, t.line, t.col, "conflicting `pub using` for `" + it.1 + "`")) }, None => { seen_exports[it.1] = sig; reexports.push(AbiReexport::{ name: it.1, kind: it.0, target_pkg: tpkg, target_name: tname }) } }
                  }
                }
                None => ()
              }
            }
            edits.push((toks[i].start_byte, toks[i + 1].start_byte, ""))
          }
          None => ()
        }
        i = rb + 1; continue
      }
      i = i + 1
    }
    out_sources.push(if edits.length() > 0 { SourceFile::{ rel_path: sf.rel_path, content: apply_byte_edits(sf.content, edits), is_test: sf.is_test } } else { sf })
  }
  (out_sources, reexports)
}
fn rewrite_reexport_snippet(src : String, file : String, pkg_aliases : Map[String, String], moon_import_paths : Map[String, String], known_pkgs : Map[String, Bool], dep_re : Map[String, Map[String, AbiReexport]], allow_using : Bool, diags : Array[Diag]) -> (String, Bool) {
  let toks = lex_moonbit(src); let n = toks.length() - 1; let edits : Array[(Int, Int, String)] = []; let mut i = 0; let mut depth = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
    if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
    if allow_using && depth == 0 && is_kw_or_id(t, "using") && i + 2 < n && toks[i + 1].kind == TokenKind::PkgRef && toks[i + 2].kind == TokenKind::LBrace {
      let rb = find_matching_delim(toks, i + 2)
      match parse_using_block_items(toks, i + 2, rb) {
        Some(items) => {
          let raw_pkg = toks[i + 1].raw.slice(1, toks[i + 1].raw.length())
          let dep_pkg = resolve_dep_pkg_alias(raw_pkg, pkg_aliases, moon_import_paths, known_pkgs)
          let mut changed = dep_pkg != raw_pkg && known_pkgs.contains(dep_pkg); let by_pkg : Map[String, Array[String]] = Map()
          for it in items {
            let (tpkg, tname) = match resolve_reexport_chain(dep_pkg, it.1, it.0, dep_re, file, t.line, t.col, diags) { Some(p) => p, None => (dep_pkg, it.1) }
            if tpkg != raw_pkg || tname != it.1 { changed = true; if !known_pkgs.contains(tpkg) { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", file, t.line, t.col, "missing transitive `--dep " + tpkg + "=...` for `" + it.1 + "`")) } }
            let arr = match by_pkg.get(tpkg) { Some(xs) => xs, None => { let xs : Array[String] = []; by_pkg[tpkg] = xs; xs } }
            arr.push(if it.0 == "type" { "type " + tname } else { tname })
          }
          if changed {
            let sb = StringBuilder(); let mut first = true
            for pk in sorted_map_keys(by_pkg) { if !first { sb.write_string("\n") }; first = false; let xs = match by_pkg.get(pk) { Some(v) => v, None => [] }; sb.write_string("using @" + pk + " { " + join_comma(xs) + " }") }
            edits.push((toks[i].start_byte, toks[rb].end_byte, sb.to_string()))
          }
        }
        None => ()
      }
      i = rb + 1; continue
    }
    if t.kind == TokenKind::PkgRef && i + 2 < n && toks[i + 1].kind == TokenKind::Dot && (toks[i + 2].kind == TokenKind::UpperIdent || toks[i + 2].kind == TokenKind::Ident) {
      let raw_pkg = t.raw.slice(1, t.raw.length()); let dep_pkg = resolve_dep_pkg_alias(raw_pkg, pkg_aliases, moon_import_paths, known_pkgs)
      match dep_re.get(dep_pkg) { Some(rmap) => match rmap.get(toks[i + 2].raw) { Some(re) => if !known_pkgs.contains(re.target_pkg) { diags.push(diag_error("MBT2PION_DEP_ABI_ERROR", file, t.line, t.col, "missing transitive `--dep " + re.target_pkg + "=...`")) } else { edits.push((toks[i].start_byte, toks[i + 2].end_byte, "@" + re.target_pkg + "." + re.target_name)) }, None => () }, None => () }
      i = i + 3; continue
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let is_ml = t.kind == TokenKind::InterpMultiline; let mut any_ch = false; let sb = StringBuilder()
      sb.write_string(if is_ml { "$|" } else { "\"" })
      for p in split_interp_string(t.raw, is_ml) { if p.is_expr { let (ns, ch) = rewrite_reexport_snippet(p.text, file, pkg_aliases, moon_import_paths, known_pkgs, dep_re, false, diags); if ch { any_ch = true }; sb.write_string("\\{" + ns + "}") } else { sb.write_string(p.text) } }
      if !is_ml { sb.write_string("\"") }
      if any_ch { edits.push((t.start_byte, t.end_byte, sb.to_string())) }
    }
    i = i + 1
  }
  if edits.length() > 0 { (apply_byte_edits(src, edits), true) } else { (src, false) }
}
pub fn rewrite_dep_reexports(sources : Array[SourceFile], pkg_aliases : Map[String, String], moon_import_paths : Map[String, String], dep_doc_jsons : Array[String], dep_abis : Array[(String, PackageAbi)], diags : Array[Diag]) -> Array[SourceFile] {
  let (_, _, known_pkgs, dep_re) = build_dep_pub_index(dep_doc_jsons, dep_abis)
  if dep_re.length() == 0 && moon_import_paths.length() == 0 { return sources }
  let out : Array[SourceFile] = []
  for sf in sources { let (ns, ch) = rewrite_reexport_snippet(sf.content, sf.rel_path, pkg_aliases, moon_import_paths, known_pkgs, dep_re, true, diags); out.push(if ch { SourceFile::{ rel_path: sf.rel_path, content: ns, is_test: sf.is_test } } else { sf }) }
  out
}

// 8. Wave M2-E2 (§E2-2): Controlled `suberror` / `raise` / `try ... catch`
enum ErrFrame {
  SourceFn(String, Option[String])
  TryBlk(String, Bool)
}

struct ErrLowerState {
  file : String; is_test : Bool
  suberror_names : Map[String, Bool]; suberror_ctors : Map[String, String]
  pkg_raise_fns : Map[String, String]; pkg_raise_methods : Map[String, String]; pkg_non_raise_methods : Map[String, Bool]
  pkg_raise_method_names : Map[String, Bool]; pkg_fn_ret_types : Map[String, String]; pkg_all_fns : Map[String, Bool]; pkg_concrete_types : Map[String, Bool]
  cat_a_approved : Map[String, Bool]; cat_a_rejected : Map[String, Bool]
  failure_enum : String; outcome_enum : String; used_idents : Map[String, Bool]
  frames : Array[ErrFrame]; lex_raise_closures : Array[Map[String, String]]; lex_var_types : Array[Map[String, String]]
  diags : Array[Diag]; mut need_failure : Bool; mut need_outcome : Bool; mut tmp_seq : Int
}

fn is_kw_or_id(t : Token, s : String) -> Bool { (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == s }
fn err_step_d(k : TokenKind, d : Int) -> Int { if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace { d + 1 } else if (k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace) && d > 0 { d - 1 } else { d } }
fn err_unsup(st : ErrLowerState, ln : Int, col : Int, msg : String) -> Unit { st.diags.push(diag_error("MBT2PION_UNSUPPORTED_SYNTAX", st.file, ln, col, msg)) }
fn err_alloc_unique(used : Map[String, Bool], base : String) -> String { let mut nm = base; let mut k = 1; while used.contains(nm) { nm = base + "_" + k.to_string(); k = k + 1 }; used[nm] = true; nm }
fn err_base_upper_ident(ty : String) -> String {
  let s = ty.trim(); if s.length() == 0 { return "" }
  let c0 = s.code_unit_at(0); if c0 < 65 || c0 > 90 { return "" }
  let mut i = 1; while i < s.length() { let c = s.code_unit_at(i); if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 { i = i + 1 } else { break } }
  s.slice(0, i)
}
fn err_is_lex_bound(st : ErrLowerState, name : String) -> Bool {
  let mut i = st.lex_raise_closures.length() - 1
  while i >= 0 { if st.lex_raise_closures[i].contains(name) || st.lex_var_types[i].contains(name) { return true }; i = i - 1 }
  false
}
fn err_is_builtin_fail(st : ErrLowerState, tokens : Array[Token], i : Int, start : Int, end : Int) -> Bool {
  tokens[i].kind == TokenKind::Ident && tokens[i].raw == "fail" && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen &&
  !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
  !st.pkg_all_fns.contains("fail") && !err_is_lex_bound(st, "fail")
}
fn err_lookup_raise_fn(st : ErrLowerState, name : String) -> Option[String] {
  let mut i = st.lex_raise_closures.length() - 1
  while i >= 0 { match st.lex_raise_closures[i].get(name) { Some(v) => return if v.length() > 0 { Some(v) } else { None }, None => () }; i = i - 1 }
  st.pkg_raise_fns.get(name)
}
fn err_lookup_var_type(st : ErrLowerState, name : String) -> String {
  let mut i = st.lex_var_types.length() - 1
  while i >= 0 { match st.lex_var_types[i].get(name) { Some(v) => return v, None => () }; i = i - 1 }
  ""
}
fn err_canon_ty(st : ErrLowerState, raw_err : String) -> String { if raw_err == "Failure" { st.need_failure = true; st.failure_enum } else { raw_err } }
fn err_enclosing_ret_stmt(frames : Array[ErrFrame], val_expr : String) -> String {
  if frames.length() == 0 { return "return " + val_expr }
  match frames[frames.length() - 1] { ErrFrame::SourceFn(_, None) => "return " + val_expr, ErrFrame::SourceFn(_, Some(_)) => "return Ok(" + val_expr + ")", ErrFrame::TryBlk(_, _) => "return MbtTryRet(" + val_expr + ")" }
}
fn err_active_raise_stmt(st : ErrLowerState, err_expr : String, line : Int, col : Int) -> String {
  if st.frames.length() > 0 { match st.frames[st.frames.length() - 1] { ErrFrame::TryBlk(_, true) => return "return MbtTryErr(" + err_expr + ")", ErrFrame::TryBlk(_, false) => return "return Some(" + err_expr + ")", ErrFrame::SourceFn(_, Some(_)) => return "return Err(" + err_expr + ")", ErrFrame::SourceFn(_, None) => () } }
  err_unsup(st, line, col, "uncaught `raise` or raising call outside error handler"); "return Err(" + err_expr + ")"
}
fn err_enclosing_source_ret_ty(frames : Array[ErrFrame]) -> String { let mut i = frames.length() - 1; while i >= 0 { match frames[i] { ErrFrame::SourceFn(rty, _) => return rty, ErrFrame::TryBlk(_, _) => () }; i = i - 1 }; "Unit" }
fn err_wrap_call(st : ErrLowerState, call_expr : String, line : Int, col : Int) -> String {
  let seq = st.tmp_seq; st.tmp_seq = seq + 1; let vv = err_alloc_unique(st.used_idents, "__mbt_cv_" + seq.to_string()); let ev = err_alloc_unique(st.used_idents, "__mbt_ce_" + seq.to_string())
  "(match " + call_expr + " { Ok(" + vv + ") => " + vv + "; Err(" + ev + ") => " + err_active_raise_stmt(st, ev, line, col) + " })"
}
fn err_is_builtin_stdlib_try(tokens : Array[Token], start : Int, catch_i : Int) -> Bool {
  let mut s = start; let mut e = catch_i
  if s < e && tokens[s].kind == TokenKind::LBrace && find_matching_delim(tokens, s) + 1 == e { s = s + 1; e = e - 1 }
  while s < e && tokens[s].kind == TokenKind::Semi { s = s + 1 }
  while e > s && tokens[e - 1].kind == TokenKind::Semi { e = e - 1 }
  if s + 3 < e && tokens[s].kind == TokenKind::PkgRef && tokens[s + 1].kind == TokenKind::Dot && tokens[s + 3].kind == TokenKind::LParen && find_matching_delim(tokens, s + 3) + 1 == e { return true }
  if s + 5 < e && tokens[s].kind == TokenKind::UpperIdent && tokens[s + 1].kind == TokenKind::LParen && tokens[s + 2].kind == TokenKind::PkgRef && tokens[s + 3].kind == TokenKind::Dot && tokens[s + 5].kind == TokenKind::LParen { let op = find_matching_delim(tokens, s + 1); if op + 1 == e && find_matching_delim(tokens, s + 5) + 1 == op { return true } }
  false
}
fn err_scan_try_body(tokens : Array[Token], s : Int, e : Int) -> (Bool, Bool) {
  let mut has_ret = false; let mut has_bc = false; let mut ld = 0; let lbds : Array[Int] = []; let mut bd = 0; let mut i = s
  while i < e {
    let t = tokens[i]
    if t.kind == TokenKind::Keyword && t.raw == "fn" { let mut j = i + 1; while j < e && tokens[j].kind != TokenKind::LBrace { j = if tokens[j].kind == TokenKind::LParen || tokens[j].kind == TokenKind::LBracket { find_matching_delim(tokens, j) + 1 } else { j + 1 } }; if j < e && tokens[j].kind == TokenKind::LBrace { i = find_matching_delim(tokens, j) + 1; continue } }
    if t.kind == TokenKind::Keyword && (t.raw == "while" || t.raw == "for" || t.raw == "loop") { ld = ld + 1; lbds.push(bd) }
    else if t.kind == TokenKind::LBrace { bd = bd + 1 }
    else if t.kind == TokenKind::RBrace { if bd > 0 { bd = bd - 1 }; while lbds.length() > 0 && lbds[lbds.length() - 1] == bd { let _ = lbds.pop(); if ld > 0 { ld = ld - 1 } } }
    else if t.kind == TokenKind::Keyword && t.raw == "return" { has_ret = true }
    else if t.kind == TokenKind::Keyword && (t.raw == "break" || t.raw == "continue") && ld == 0 { has_bc = true }
    else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) { if p.is_expr { let ht = lex_moonbit(p.text); let (hr, hbc) = err_scan_try_body(ht, 0, ht.length() - 1); if hr { has_ret = true }; if hbc && ld == 0 { has_bc = true } } }
    }
    i = i + 1
  }
  (has_ret, has_bc)
}
fn err_find_stmt_expr_end(tokens : Array[Token], start : Int, limit : Int) -> Int {
  let mut i = start; let mut d = 0
  while i < limit { let t = tokens[i]; if d == 0 && (t.kind == TokenKind::Semi || t.kind == TokenKind::RBrace || t.kind == TokenKind::Comma || t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket || (i > start && t.newline_before && !(t.kind == TokenKind::Keyword && t.raw == "else"))) { break }; d = err_step_d(t.kind, d); i = i + 1 }
  i
}
fn err_parse_fn_header(src : String, tokens : Array[Token], fn_i : Int, limit : Int) -> Option[(String, Int, Int, String, Bool, String, Bool, Int)] {
  let mut k = fn_i + 1
  if k < limit && tokens[k].kind == TokenKind::LBracket { k = find_matching_delim(tokens, k) + 1 }
  let name_sb = StringBuilder(); while k < limit && tokens[k].kind != TokenKind::LParen && tokens[k].kind != TokenKind::LBrace { name_sb.write_string(tokens[k].raw); k = k + 1 }
  if k >= limit || tokens[k].kind != TokenKind::LParen { return None }
  let open_p = k; let close_p = find_matching_delim(tokens, open_p); let mut has_rp = false; let mut pi = open_p + 1
  while pi < close_p { if is_kw_or_id(tokens[pi], "raise") { has_rp = true; break }; pi = pi + 1 }
  let mut cur = close_p + 1; let mut ret_ty = "Unit"; let mut has_r = false; let mut err_ty = ""
  if cur < limit && tokens[cur].kind == TokenKind::Arrow {
    let rt_s = cur + 1; let mut rt_e = rt_s; let mut rd = 0
    while rt_e < limit { if rd == 0 && (tokens[rt_e].kind == TokenKind::LBrace || tokens[rt_e].kind == TokenKind::Eq) { break }; if rd == 0 && is_kw_or_id(tokens[rt_e], "raise") { has_r = true; break }; rd = err_step_d(tokens[rt_e].kind, rd); rt_e = rt_e + 1 }
    if rt_e > rt_s { ret_ty = src.slice(tokens[rt_s].start_byte, tokens[rt_e - 1].end_byte).trim() }
    cur = rt_e
  } else if cur < limit && is_kw_or_id(tokens[cur], "raise") { has_r = true }
  if has_r { cur = cur + 1; let et_s = cur; while cur < limit && tokens[cur].kind != TokenKind::LBrace && tokens[cur].kind != TokenKind::Eq { cur = cur + 1 }; if cur > et_s { err_ty = src.slice(tokens[et_s].start_byte, tokens[cur - 1].end_byte).trim() } }
  while cur < limit && tokens[cur].kind != TokenKind::LBrace { if tokens[cur].kind == TokenKind::Eq { return None }; cur = cur + 1 }
  if cur >= limit || tokens[cur].kind != TokenKind::LBrace { return None }
  Some((name_sb.to_string(), open_p, close_p, ret_ty, has_r, err_ty, has_rp, cur))
}
fn err_seed_param_types(tokens : Array[Token], open_p : Int, close_p : Int, fn_name : String, vmap : Map[String, String], cmap : Map[String, String]) -> Unit {
  let cc = fn_name.index_of("::"); if cc > 0 { vmap["self"] = fn_name.slice(0, cc) }
  let mut k = open_p + 1; let mut d = 0
  while k < close_p {
    if d == 0 && (tokens[k].kind == TokenKind::Ident || tokens[k].kind == TokenKind::Keyword) {
      let pn = tokens[k].raw
      if pn != "mut" { cmap[pn] = ""; let mut ti = k + 1; if ti < close_p && (tokens[ti].kind == TokenKind::Tilde || tokens[ti].kind == TokenKind::Question) { ti = ti + 1 }; if ti + 1 < close_p && tokens[ti].kind == TokenKind::Colon && tokens[ti + 1].kind == TokenKind::UpperIdent { vmap[pn] = tokens[ti + 1].raw } else if pn != "self" { vmap[pn] = "" } }
      while k < close_p && !(d == 0 && tokens[k].kind == TokenKind::Comma) { d = err_step_d(tokens[k].kind, d); k = k + 1 }
    }
    k = k + 1
  }
}
fn err_validate_catch_arms(st : ErrLowerState, tokens : Array[Token], lb : Int, rb : Int, is_failure : Bool) -> String {
  let mut inf = ""; let mut k = lb + 1; let mut d = 0; let cv : Map[String, Bool] = Map(); let mut arm_s = k
  while k <= rb {
    if k == rb || (d == 0 && (tokens[k].kind == TokenKind::Semi || (k > arm_s && tokens[k].newline_before))) {
      let mut fa = arm_s; let mut ad = 0; while fa < k && !(ad == 0 && tokens[fa].kind == TokenKind::FatArrow) { ad = err_step_d(tokens[fa].kind, ad); fa = fa + 1 }
      if fa < k && tokens[fa].kind == TokenKind::FatArrow {
        let mut p = arm_s
        while p < fa {
          let pt = tokens[p]
          if pt.kind == TokenKind::UpperIdent {
            if pt.raw == "Failure" {
              inf = "Failure"
              if p + 1 < fa && tokens[p + 1].kind == TokenKind::LParen { let cp = find_matching_delim(tokens, p + 1); let mut pi = p + 2; while pi < cp { if tokens[pi].kind != TokenKind::Underscore && tokens[pi].kind != TokenKind::Comma { err_unsup(st, pt.line, pt.col, "binding `Failure(...)` payload is unsupported"); break }; pi = pi + 1 }; p = cp + 1; continue }
            } else { match st.suberror_ctors.get(pt.raw) { Some(en) => if inf.length() == 0 { inf = en }, None => () } }
          } else if pt.kind == TokenKind::Ident && p == arm_s && fa == arm_s + 1 { cv[pt.raw] = true; if is_failure { err_unsup(st, pt.line, pt.col, "binding `Failure` to `" + pt.raw + "` is unsupported") } }
          p = p + 1
        }
        let mut b = fa + 1; while b + 2 < k { if tokens[b].kind == TokenKind::Ident && cv.contains(tokens[b].raw) && tokens[b + 1].kind == TokenKind::Dot && tokens[b + 2].raw == "to_string" { err_unsup(st, tokens[b].line, tokens[b].col, "calling `.to_string()` on caught error is unsupported") }; b = b + 1 }
        arm_s = k + (if k < rb && tokens[k].kind == TokenKind::Semi { 1 } else { 0 })
      }
    }
    if k < rb { d = err_step_d(tokens[k].kind, d) }; k = k + 1
  }
  inf
}
fn err_infer_body_err_ty(st : ErrLowerState, tokens : Array[Token], s : Int, e : Int) -> (String, Bool) { err_infer_body_err_ty_sh(st, tokens, s, e, false) }
fn err_infer_body_err_ty_sh(st : ErrLowerState, tokens : Array[Token], s : Int, e : Int, init_fail_sh : Bool) -> (String, Bool) {
  let mut found = ""; let mut mixed = false; let shadow_fail : Array[Bool] = [init_fail_sh]; let mut i = s
  while i < e {
    let t = tokens[i]; let mut cand = ""
    if t.kind == TokenKind::LBrace { shadow_fail.push(false); i = i + 1; continue }
    if t.kind == TokenKind::RBrace { if shadow_fail.length() > 1 { let _ = shadow_fail.pop() }; i = i + 1; continue }
    if t.kind == TokenKind::Keyword && t.raw == "let" { let ni = if i + 1 < e && tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut" { i + 2 } else { i + 1 }; if ni < e && tokens[ni].kind == TokenKind::Ident && tokens[ni].raw == "fail" { shadow_fail[shadow_fail.length() - 1] = true } }
    if is_kw_or_id(t, "try") { let te = err_try_body_end(tokens, i, e); if te > i { i = te + 1; continue } }
    let mut fail_sh = false; for sfv in shadow_fail { if sfv { fail_sh = true } }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) { if p.is_expr { let ht = lex_moonbit(p.text); let (hf, hm) = err_infer_body_err_ty_sh(st, ht, 0, ht.length() - 1, fail_sh); if hm { mixed = true }; if hf.length() > 0 { if found.length() == 0 { found = hf } else if found != hf { mixed = true } } } }
      i = i + 1; continue
    }
    if is_kw_or_id(t, "raise") && i + 1 < e && tokens[i + 1].kind == TokenKind::UpperIdent { cand = if tokens[i + 1].raw == "Failure" { "Failure" } else { match st.suberror_ctors.get(tokens[i + 1].raw) { Some(en) => en, None => "" } } }
    else if !fail_sh && err_is_builtin_fail(st, tokens, i, s, e) { cand = "Failure" }
    else if t.kind == TokenKind::Ident && i + 1 < e && tokens[i + 1].kind == TokenKind::LParen && !(i > s && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      match err_lookup_raise_fn(st, t.raw) { Some(et) => cand = et, None => if !err_is_lex_bound(st, t.raw) { let cp = find_matching_delim(tokens, i + 1); if cp + 3 < e && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].kind == TokenKind::Ident && tokens[cp + 3].kind == TokenKind::LParen { match st.pkg_fn_ret_types.get(t.raw) { Some(rt) => match st.pkg_raise_methods.get(rt + "::" + tokens[cp + 2].raw) { Some(et) => cand = et, None => () }, None => () } } } }
    }
    else if t.kind == TokenKind::UpperIdent && i + 3 < e && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::Ident && tokens[i + 3].kind == TokenKind::LParen { match st.pkg_raise_methods.get(t.raw + "::" + tokens[i + 2].raw) { Some(et) => cand = et, None => () } }
    else if t.kind == TokenKind::Ident && i + 3 < e && tokens[i + 1].kind == TokenKind::Dot && tokens[i + 2].kind == TokenKind::Ident && tokens[i + 3].kind == TokenKind::LParen { let rty = err_lookup_var_type(st, t.raw); if rty.length() > 0 { match st.pkg_raise_methods.get(rty + "::" + tokens[i + 2].raw) { Some(et) => cand = et, None => () } } }
    if cand.length() > 0 { let cn = if cand == st.failure_enum { "Failure" } else { cand }; if found.length() == 0 { found = cn } else if found != cn { mixed = true } }
    i = i + 1
  }
  (found, mixed)
}
fn err_body_ends_with_return_or_raise(tokens : Array[Token], lb : Int, rb : Int) -> Bool {
  let mut s = lb + 1; while s < rb && tokens[s].kind == TokenKind::Semi { s = s + 1 }
  if s >= rb || !(is_kw_or_id(tokens[s], "raise") || (tokens[s].kind == TokenKind::Keyword && tokens[s].raw == "return")) { return false }
  let mut k = err_find_stmt_expr_end(tokens, s + 1, rb); while k < rb && tokens[k].kind == TokenKind::Semi { k = k + 1 }; k >= rb
}

fn err_brace_has_fat_arrow(tokens : Array[Token], lb : Int, rb : Int) -> Bool {
  let mut k = lb + 1; let mut d = 0
  while k < rb { if d == 0 && tokens[k].kind == TokenKind::FatArrow { return true }; d = err_step_d(tokens[k].kind, d); k = k + 1 }
  false
}

fn err_is_expr_cont(tokens : Array[Token], idx : Int, end : Int) -> Bool {
  if idx >= end { return false }
  let t = tokens[idx]; let same_line = !str_has(t.leading_trivia, "\n")
  is_kw_or_id(t, "is") || is_kw_or_id(t, "as") ||
  (t.kind == TokenKind::Dot && (same_line || (idx + 1 < end && tokens[idx + 1].kind != TokenKind::UpperIdent))) ||
  (same_line && (t.kind == TokenKind::LParen || t.kind == TokenKind::LBracket || t.kind == TokenKind::LBrace || t.raw == "!" || t.raw == "?" || t.raw == "+" || t.raw == "-")) ||
  t.raw == "==" || t.raw == "!=" || t.raw == "<=" || t.raw == ">=" || t.raw == "&&" || t.raw == "||" ||
  t.raw == "|>" || t.raw == "<<" || t.raw == ">>" || t.raw == "*" || t.raw == "/" ||
  t.raw == "%" || t.raw == "<" || t.raw == ">" || t.raw == "&" || t.raw == "|" || t.raw == "^"
}

fn err_shadow_pat_idents(tokens : Array[Token], s : Int, e : Int, vmap : Map[String, String], cmap : Map[String, String]) -> Unit {
  let mut k = s
  while k < e {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && tk.raw != "_" && !(k > s && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) && !(k + 1 < e && tokens[k + 1].kind == TokenKind::Colon) {
      vmap[tk.raw] = ""; cmap[tk.raw] = ""
    }
    k = k + 1
  }
}

fn err_lower_match_arms(st : ErrLowerState, src : String, tokens : Array[Token], lb : Int, rb : Int) -> String {
  let sb = StringBuilder(); let mut k = lb + 1; let mut d = 0; let mut arm_s = k; let mut cur_fa = -1
  while k <= rb {
    if k < rb && d == 0 && cur_fa < 0 && tokens[k].kind == TokenKind::FatArrow { cur_fa = k }
    let is_end = k == rb || (d == 0 && (tokens[k].kind == TokenKind::Semi || (cur_fa >= 0 && k > cur_fa + 1 && tokens[k].newline_before)))
    if is_end {
      if cur_fa >= arm_s && cur_fa < k {
        let mut gi = -1; let mut gd = 0; let mut p = arm_s
        while p < cur_fa { if gd == 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "if" { gi = p; break }; gd = err_step_d(tokens[p].kind, gd); p = p + 1 }
        let pat_e = if gi >= 0 { gi } else { cur_fa }
        let vm : Map[String, String] = Map(); let cm : Map[String, String] = Map()
        err_shadow_pat_idents(tokens, arm_s, pat_e, vm, cm)
        st.lex_var_types.push(vm); st.lex_raise_closures.push(cm)
        let mut pk = arm_s; while pk < pat_e { sb.write_string(tokens[pk].leading_trivia + tokens[pk].raw); pk = pk + 1 }
        if gi >= 0 { sb.write_string(lower_err_range(st, src, tokens, gi, cur_fa)) }
        sb.write_string(tokens[cur_fa].leading_trivia + tokens[cur_fa].raw)
        sb.write_string(lower_err_range(st, src, tokens, cur_fa + 1, k))
        let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop()
      } else {
        sb.write_string(lower_err_range(st, src, tokens, arm_s, k))
      }
      if k < rb && tokens[k].kind == TokenKind::Semi { sb.write_string(tokens[k].leading_trivia + tokens[k].raw); arm_s = k + 1 } else { arm_s = k }
      cur_fa = -1
    }
    if k < rb { d = err_step_d(tokens[k].kind, d) }; k = k + 1
  }
  sb.to_string()
}

fn lower_err_range(st : ErrLowerState, src : String, tokens : Array[Token], start : Int, end : Int) -> String {
  let mut hi = start; let mut hd = 0
  while hi < end {
    let ht = tokens[hi]
    if hd == 0 && ht.kind == TokenKind::Keyword && ht.raw == "fn" {
      let mut ni = hi + 1; if ni < end && tokens[ni].kind == TokenKind::LBracket { ni = find_matching_delim(tokens, ni) + 1 }
      if ni + 1 < end && tokens[ni].kind == TokenKind::Ident && tokens[ni + 1].kind == TokenKind::LParen { st.lex_var_types[st.lex_var_types.length() - 1][tokens[ni].raw] = ""; st.lex_raise_closures[st.lex_raise_closures.length() - 1][tokens[ni].raw] = "" }
    }
    hd = err_step_d(ht.kind, hd); hi = hi + 1
  }
  let sb = StringBuilder(); let mut i = start
  while i < end {
    let t = tokens[i]
    if t.kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, i); st.lex_raise_closures.push(Map()); st.lex_var_types.push(Map())
      sb.write_string(t.leading_trivia + "{" + lower_err_range(st, src, tokens, i + 1, rb) + tokens[rb].leading_trivia + "}")
      let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop(); i = rb + 1; continue
    }
    if t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end {
      let ni = if tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut" { i + 2 } else { i + 1 }
      if ni < end && tokens[ni].kind == TokenKind::Ident {
        let vname = tokens[ni].raw; let mut eq_i = ni + 1; let mut ann_ty = ""
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Colon {
          if tokens[eq_i + 1].kind == TokenKind::UpperIdent { ann_ty = tokens[eq_i + 1].raw }
          let mut td = 0; while eq_i < end && !(td == 0 && tokens[eq_i].kind == TokenKind::Eq) { td = err_step_d(tokens[eq_i].kind, td); eq_i = eq_i + 1 }
        }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq {
          if tokens[eq_i + 1].kind == TokenKind::Keyword && tokens[eq_i + 1].raw == "fn" {
            match err_parse_fn_header(src, tokens, eq_i + 1, end) {
              Some((_, op, cp, rty, has_r, ety, has_rp, clb)) => if has_r || has_rp {
                let crb = find_matching_delim(tokens, clb)
                if has_rp || ety == "Error" || (ety.length() == 0 && !st.is_test) || (ety.length() > 0 && ety != "Failure" && !st.suberror_names.contains(ety)) { err_unsup(st, tokens[eq_i + 1].line, tokens[eq_i + 1].col, "unsupported `raise` in local closure `" + vname + "`") }
                else if ety.length() > 0 {
                  let ce = err_canon_ty(st, ety); st.lex_raise_closures[st.lex_raise_closures.length() - 1][vname] = ce; st.lex_var_types[st.lex_var_types.length() - 1][vname] = ""
                  let pm : Map[String, String] = Map(); let cm : Map[String, String] = Map(); err_seed_param_types(tokens, op, cp, "", pm, cm)
                  st.lex_var_types.push(pm); st.lex_raise_closures.push(cm); st.frames.push(ErrFrame::SourceFn(rty, Some(ce)))
                  let bt = lower_err_range(st, src, tokens, clb + 1, crb); let _ = st.frames.pop(); let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop()
                  let w = if err_body_ends_with_return_or_raise(tokens, clb, crb) { bt } else if rty == "Unit" { bt + "; Ok(())" } else { " Ok({" + bt + " })" }
                  sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + " fn" + src.slice(tokens[op].start_byte, tokens[cp].end_byte) + " -> Result[" + rty + ", " + ce + "] {" + w + " }"); i = crb + 1; continue
                }
              }
              None => ()
            }
          }
          let rhs_end = err_find_stmt_expr_end(tokens, eq_i + 1, end)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + lower_err_range(st, src, tokens, eq_i + 1, rhs_end))
          let mut rhs_ce = rhs_end
          while rhs_ce > eq_i + 1 && tokens[rhs_ce - 1].kind == TokenKind::Semi { rhs_ce = rhs_ce - 1 }
          if ann_ty.length() == 0 && eq_i + 1 < rhs_ce {
            let r1 = tokens[eq_i + 1]
            if r1.kind == TokenKind::UpperIdent && eq_i + 2 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::ColonColon {
              if eq_i + 3 < rhs_ce && tokens[eq_i + 3].kind == TokenKind::LBrace && find_matching_delim(tokens, eq_i + 3) + 1 == rhs_ce { ann_ty = r1.raw }
              else if eq_i + 4 < rhs_ce && tokens[eq_i + 3].kind == TokenKind::Ident && tokens[eq_i + 4].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 4) + 1 == rhs_ce { ann_ty = match st.pkg_fn_ret_types.get(r1.raw + "::" + tokens[eq_i + 3].raw) { Some(rt) => rt, None => r1.raw } }
            } else if r1.kind == TokenKind::Ident && eq_i + 2 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 2) + 1 == rhs_ce && !err_is_lex_bound(st, r1.raw) {
              match st.pkg_fn_ret_types.get(r1.raw) { Some(rt) => ann_ty = rt, None => () }
            } else if r1.kind == TokenKind::Ident && eq_i + 4 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::Dot && tokens[eq_i + 3].kind == TokenKind::Ident && tokens[eq_i + 4].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 4) + 1 == rhs_ce {
              let xr = err_lookup_var_type(st, r1.raw); if xr.length() > 0 { match st.pkg_fn_ret_types.get(xr + "::" + tokens[eq_i + 3].raw) { Some(rt) => ann_ty = rt, None => () } }
            }
          }
          st.lex_raise_closures[st.lex_raise_closures.length() - 1][vname] = ""; st.lex_var_types[st.lex_var_types.length() - 1][vname] = ann_ty; i = rhs_end; continue
        }
      } else if ni < end {
        let mut eq_i = ni; let mut ld = 0
        while eq_i < end && !(ld == 0 && (tokens[eq_i].kind == TokenKind::Eq || tokens[eq_i].kind == TokenKind::Semi || tokens[eq_i].kind == TokenKind::RBrace)) { ld = err_step_d(tokens[eq_i].kind, ld); eq_i = eq_i + 1 }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq {
          let rhs_end = err_find_stmt_expr_end(tokens, eq_i + 1, end)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + lower_err_range(st, src, tokens, eq_i + 1, rhs_end))
          err_shadow_pat_idents(tokens, ni, eq_i, st.lex_var_types[st.lex_var_types.length() - 1], st.lex_raise_closures[st.lex_raise_closures.length() - 1])
          i = rhs_end; continue
        }
      }
    }
    if t.kind == TokenKind::Keyword && t.raw == "match" {
      let mut mlb = i + 1; let mut md = 0; let mut found_lb = -1
      while mlb < end {
        if md == 0 && tokens[mlb].kind == TokenKind::LBrace {
          let mrb = find_matching_delim(tokens, mlb)
          if err_brace_has_fat_arrow(tokens, mlb, mrb) || (mrb == mlb + 1 && !(mlb > i + 1 && tokens[mlb - 1].kind == TokenKind::ColonColon) && !(mrb + 1 < end && (tokens[mrb + 1].kind == TokenKind::LBrace || err_is_expr_cont(tokens, mrb + 1, end)))) { found_lb = mlb; break }
          mlb = mrb + 1; continue
        }
        md = err_step_d(tokens[mlb].kind, md); mlb = mlb + 1
      }
      if found_lb >= 0 {
        let mrb = find_matching_delim(tokens, found_lb)
        sb.write_string(t.leading_trivia + "match" + lower_err_range(st, src, tokens, i + 1, found_lb) + tokens[found_lb].leading_trivia + "{" + err_lower_match_arms(st, src, tokens, found_lb, mrb) + tokens[mrb].leading_trivia + "}")
        i = mrb + 1; continue
      }
    }
    if t.kind == TokenKind::Keyword && (t.raw == "if" || t.raw == "while") {
      let mut tlb = i + 1; let mut cd = 0; let mut found_tb = -1
      while tlb < end {
        if cd == 0 && tokens[tlb].kind == TokenKind::LBrace {
          let trb = find_matching_delim(tokens, tlb)
          let cont = (tlb > i + 1 && (tokens[tlb - 1].kind == TokenKind::ColonColon || is_kw_or_id(tokens[tlb - 1], "is"))) || err_is_expr_cont(tokens, trb + 1, end)
          if !cont { found_tb = tlb; break }
          tlb = trb + 1; continue
        }
        cd = err_step_d(tokens[tlb].kind, cd); tlb = tlb + 1
      }
      if found_tb >= 0 {
        let trb = find_matching_delim(tokens, found_tb)
        st.lex_var_types.push(Map()); st.lex_raise_closures.push(Map())
        sb.write_string(t.leading_trivia + t.raw + lower_err_range(st, src, tokens, i + 1, found_tb) + tokens[found_tb].leading_trivia + "{" + lower_err_range(st, src, tokens, found_tb + 1, trb) + tokens[trb].leading_trivia + "}")
        let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop(); i = trb + 1; continue
      }
    }
    if t.kind == TokenKind::Keyword && t.raw == "for" {
      let mut flb = i + 1; let mut fd = 0
      while flb < end && !(fd == 0 && tokens[flb].kind == TokenKind::LBrace) { fd = err_step_d(tokens[flb].kind, fd); flb = flb + 1 }
      if flb < end && tokens[flb].kind == TokenKind::LBrace {
        let frb = find_matching_delim(tokens, flb); let vm : Map[String, String] = Map(); let cm : Map[String, String] = Map()
        let mut in_i = -1; let mut sc = i + 1; let mut sd = 0
        while sc < flb { if sd == 0 && is_kw_or_id(tokens[sc], "in") { in_i = sc; break }; sd = err_step_d(tokens[sc].kind, sd); sc = sc + 1 }
        if in_i > i { err_shadow_pat_idents(tokens, i + 1, in_i, vm, cm) }
        else { let mut fk = i + 1; let mut fkd = 0; while fk < flb && !(fkd == 0 && tokens[fk].kind == TokenKind::Semi) { if fkd == 0 && tokens[fk].kind == TokenKind::Ident && fk + 1 < flb && tokens[fk + 1].kind == TokenKind::Eq { vm[tokens[fk].raw] = ""; cm[tokens[fk].raw] = "" }; fkd = err_step_d(tokens[fk].kind, fkd); fk = fk + 1 } }
        st.lex_var_types.push(vm); st.lex_raise_closures.push(cm)
        sb.write_string(t.leading_trivia + "for" + lower_err_range(st, src, tokens, i + 1, flb) + tokens[flb].leading_trivia + "{" + lower_err_range(st, src, tokens, flb + 1, frb) + tokens[frb].leading_trivia + "}")
        let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop(); i = frb + 1; continue
      }
    }
    if is_kw_or_id(t, "is") && i + 1 < end {
      let mut pe = i + 1; let mut pd = 0
      while pe < end { let pt = tokens[pe]; if pd == 0 && (pt.raw == "&&" || pt.raw == "||" || pt.kind == TokenKind::LBrace || pt.kind == TokenKind::RParen || pt.kind == TokenKind::Semi || (pt.kind == TokenKind::Keyword && pt.raw == "else") || (pe > i + 1 && pt.newline_before)) { break }; pd = err_step_d(pt.kind, pd); pe = pe + 1 }
      if pe > i + 1 { err_shadow_pat_idents(tokens, i + 1, pe, st.lex_var_types[st.lex_var_types.length() - 1], st.lex_raise_closures[st.lex_raise_closures.length() - 1]); sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[pe - 1].end_byte)); i = pe; continue }
    }
    if t.kind == TokenKind::Keyword && t.raw == "fn" {
      match err_parse_fn_header(src, tokens, i, end) {
        Some((lfn, op, cp, rty, has_r, _, has_rp, clb)) => {
          if lfn.length() > 0 { st.lex_var_types[st.lex_var_types.length() - 1][lfn] = ""; st.lex_raise_closures[st.lex_raise_closures.length() - 1][lfn] = "" }
          let crb = find_matching_delim(tokens, clb); if has_r || has_rp { err_unsup(st, t.line, t.col, "unsupported inline raising closure") }
          let pm : Map[String, String] = Map(); let cm : Map[String, String] = Map(); err_seed_param_types(tokens, op, cp, "", pm, cm)
          st.lex_var_types.push(pm); st.lex_raise_closures.push(cm); st.frames.push(ErrFrame::SourceFn(rty, None))
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[clb].end_byte) + lower_err_range(st, src, tokens, clb + 1, crb) + tokens[crb].leading_trivia + "}")
          let _ = st.frames.pop(); let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop(); i = crb + 1; continue
        }
        None => ()
      }
    }
    if is_kw_or_id(t, "try") {
      if i + 1 < end && (tokens[i + 1].kind == TokenKind::Bang || tokens[i + 1].kind == TokenKind::Question) { err_unsup(st, t.line, t.col, "`try!` / `try?` is unsupported"); sb.write_string(t.leading_trivia + t.raw); i = i + 1; continue }
      let mut body_s = i + 1; let mut body_e = i + 1; let mut catch_i = -1
      if i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace { let tb = find_matching_delim(tokens, i + 1); body_s = i + 2; body_e = tb; if tb + 1 < end && is_kw_or_id(tokens[tb + 1], "catch") { catch_i = tb + 1 } }
      else { let mut sc = i + 1; let mut sd = 0; while sc < end { if sd == 0 && is_kw_or_id(tokens[sc], "catch") { catch_i = sc; break }; sd = err_step_d(tokens[sc].kind, sd); sc = sc + 1 }; body_e = catch_i }
      if catch_i < 0 || catch_i + 1 >= end || tokens[catch_i + 1].kind != TokenKind::LBrace { err_unsup(st, t.line, t.col, "unsupported `try` without `catch`"); sb.write_string(t.leading_trivia + t.raw); i = i + 1; continue }
      let catch_lb = catch_i + 1; let catch_rb = find_matching_delim(tokens, catch_lb)
      if catch_rb + 1 < end && is_kw_or_id(tokens[catch_rb + 1], "noraise") { err_unsup(st, tokens[catch_rb + 1].line, tokens[catch_rb + 1].col, "`try ... catch ... noraise` is unsupported"); sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[catch_rb].end_byte)); i = catch_rb + 1; continue }
      if err_is_builtin_stdlib_try(tokens, i + 1, catch_i) { sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[catch_rb].end_byte)); i = catch_rb + 1; continue }
      let diag_before = st.diags.length()
      let (has_ret, has_bc) = err_scan_try_body(tokens, body_s, body_e); if has_bc { err_unsup(st, t.line, t.col, "`break`/`continue` across `try` boundary is unsupported") }
      let (body_et, mixed_et) = err_infer_body_err_ty(st, tokens, body_s, body_e); if mixed_et { err_unsup(st, t.line, t.col, "polymorphic or mixed error types in `try` are unsupported") }
      let catch_et = err_validate_catch_arms(st, tokens, catch_lb, catch_rb, body_et == "Failure"); if catch_et == "Failure" && body_et != "Failure" { let _ = err_validate_catch_arms(st, tokens, catch_lb, catch_rb, true) }
      let raw_et = if body_et.length() > 0 { body_et } else { catch_et }; if raw_et.length() == 0 { err_unsup(st, t.line, t.col, "cannot infer concrete closed error type for `try`") }
      if st.diags.length() > diag_before { sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[catch_rb].end_byte)); i = catch_rb + 1; continue }
      let canon_et = err_canon_ty(st, raw_et); if has_ret { st.need_outcome = true }
      let seq = st.tmp_seq; st.tmp_seq = seq + 1
      let fn_v = err_alloc_unique(st.used_idents, "__mbt_try_" + seq.to_string()); let val_v = err_alloc_unique(st.used_idents, "__mbt_tval_" + seq.to_string()); let vv = err_alloc_unique(st.used_idents, "__mbt_tv_" + seq.to_string()); let ev = err_alloc_unique(st.used_idents, "__mbt_te_" + seq.to_string()); let rv = err_alloc_unique(st.used_idents, "__mbt_tr_" + seq.to_string()); let src_ret = err_enclosing_source_ret_ty(st.frames)
      st.frames.push(ErrFrame::TryBlk(canon_et, has_ret)); st.lex_raise_closures.push(Map()); st.lex_var_types.push(Map())
      let lb_txt = lower_err_range(st, src, tokens, body_s, body_e); let _ = st.lex_var_types.pop(); let _ = st.lex_raise_closures.pop(); let _ = st.frames.pop()
      let lc_txt = err_lower_match_arms(st, src, tokens, catch_lb, catch_rb); let unwrap_v = "match " + val_v + " { Some(" + vv + ") => " + vv + "; None => abort(\"unreachable\") }"
      sb.write_string(t.leading_trivia + (if has_ret { "{ let mut " + val_v + " = None; let " + fn_v + " = fn() -> " + st.outcome_enum + "[" + src_ret + ", " + canon_et + "] { " + val_v + " = Some({" + lb_txt + " }); MbtTryOk }; match " + fn_v + "() { MbtTryOk => " + unwrap_v + "; MbtTryRet(" + rv + ") => " + err_enclosing_ret_stmt(st.frames, rv) + "; MbtTryErr(" + ev + ") => match " + ev + " {" + lc_txt + " } } }" } else { "{ let mut " + val_v + " = None; let " + fn_v + " = fn() -> Option[" + canon_et + "] { " + val_v + " = Some({" + lb_txt + " }); None }; match " + fn_v + "() { None => " + unwrap_v + "; Some(" + ev + ") => match " + ev + " {" + lc_txt + " } } }" }))
      i = catch_rb + 1; continue
    }
    if is_kw_or_id(t, "raise") { let ee = err_find_stmt_expr_end(tokens, i + 1, end); sb.write_string(t.leading_trivia + err_active_raise_stmt(st, lower_err_range(st, src, tokens, i + 1, ee).trim(), t.line, t.col)); i = ee; continue }
    if t.kind == TokenKind::Keyword && t.raw == "return" && st.frames.length() > 0 {
      let need_rw = match st.frames[st.frames.length() - 1] { ErrFrame::SourceFn(_, None) => false, _ => true }
      if need_rw {
        let bare = i + 1 >= end || tokens[i + 1].kind == TokenKind::Semi || tokens[i + 1].kind == TokenKind::RBrace || tokens[i + 1].kind == TokenKind::Comma || tokens[i + 1].kind == TokenKind::RParen || tokens[i + 1].kind == TokenKind::RBracket || tokens[i + 1].newline_before
        let ee = if bare { i + 1 } else { err_find_stmt_expr_end(tokens, i + 1, end) }
        sb.write_string(t.leading_trivia + err_enclosing_ret_stmt(st.frames, if bare { "()" } else { lower_err_range(st, src, tokens, i + 1, ee).trim() }))
        i = ee; continue
      }
    }
    if err_is_builtin_fail(st, tokens, i, start, end) && st.frames.length() > 0 && st.failure_enum.length() > 0 {
      let active_et = match st.frames[st.frames.length() - 1] { ErrFrame::TryBlk(et, _) => et, ErrFrame::SourceFn(_, Some(et)) => et, _ => "" }
      if active_et == st.failure_enum { let cp = find_matching_delim(tokens, i + 1); sb.write_string(t.leading_trivia + err_active_raise_stmt(st, "Failure(" + lower_err_range(st, src, tokens, i + 2, cp) + ")", t.line, t.col)); i = cp + 1; continue }
    }
    if t.kind == TokenKind::UpperIdent && i + 2 < end && tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::Ident {
      let qk = t.raw + "::" + tokens[i + 2].raw
      if st.pkg_raise_methods.contains(qk) {
        if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen { let cp = find_matching_delim(tokens, i + 3); sb.write_string(t.leading_trivia + err_wrap_call(st, qk + "(" + lower_err_range(st, src, tokens, i + 4, cp) + ")", t.line, t.col)); i = cp + 1; continue }
        err_unsup(st, t.line, t.col, "raising method `" + qk + "` cannot be used as a function value")
      } else if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
        let cp = find_matching_delim(tokens, i + 3)
        if cp + 3 < end && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].kind == TokenKind::Ident && tokens[cp + 3].kind == TokenKind::LParen && st.pkg_raise_method_names.contains(tokens[cp + 2].raw) {
          let mn = tokens[cp + 2].raw; let cp2 = find_matching_delim(tokens, cp + 3)
          let rt = match st.pkg_fn_ret_types.get(qk) { Some(v) => v, None => "" }
          if st.pkg_concrete_types.contains(rt) && (st.pkg_raise_methods.contains(rt + "::" + mn) || st.pkg_non_raise_methods.contains(rt + "::" + mn)) {
            let call_s = qk + "(" + lower_err_range(st, src, tokens, i + 4, cp) + ")." + mn + "(" + lower_err_range(st, src, tokens, cp + 4, cp2) + ")"
            sb.write_string(t.leading_trivia + (if st.pkg_raise_methods.contains(rt + "::" + mn) { err_wrap_call(st, call_s, t.line, t.col) } else { call_s })); i = cp2 + 1; continue
          }
          err_unsup(st, tokens[cp + 2].line, tokens[cp + 2].col, "cannot prove target declaration for potentially raising method `." + mn + "()`")
        }
      }
    }
    if t.kind == TokenKind::Ident && i + 3 < end && tokens[i + 1].kind == TokenKind::Dot && tokens[i + 2].kind == TokenKind::Ident && tokens[i + 3].kind == TokenKind::LParen && !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      let mn = tokens[i + 2].raw
      if st.pkg_raise_method_names.contains(mn) {
        let rty = err_lookup_var_type(st, t.raw)
        if st.pkg_concrete_types.contains(rty) && (st.pkg_raise_methods.contains(rty + "::" + mn) || st.pkg_non_raise_methods.contains(rty + "::" + mn)) {
          let cp = find_matching_delim(tokens, i + 3); let call_s = t.raw + "." + mn + "(" + lower_err_range(st, src, tokens, i + 4, cp) + ")"
          sb.write_string(t.leading_trivia + (if st.pkg_raise_methods.contains(rty + "::" + mn) { err_wrap_call(st, call_s, t.line, t.col) } else { call_s })); i = cp + 1; continue
        }
        err_unsup(st, tokens[i + 2].line, tokens[i + 2].col, "cannot prove target declaration for potentially raising method `." + mn + "()`")
      }
    }
    if t.kind == TokenKind::Ident && !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) && !(i + 1 < end && (tokens[i + 1].kind == TokenKind::Colon || tokens[i + 1].kind == TokenKind::Eq || tokens[i + 1].kind == TokenKind::Tilde)) {
      match err_lookup_raise_fn(st, t.raw) {
        Some(_) =>
        if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen { let cp = find_matching_delim(tokens, i + 1); sb.write_string(t.leading_trivia + err_wrap_call(st, t.raw + "(" + lower_err_range(st, src, tokens, i + 2, cp) + ")", t.line, t.col)); i = cp + 1; continue }
        else { err_unsup(st, t.line, t.col, "raising function `" + t.raw + "` cannot be used as a function value") }
        None =>
        if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, i + 1)
          if cp + 3 < end && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].kind == TokenKind::Ident && tokens[cp + 3].kind == TokenKind::LParen && st.pkg_raise_method_names.contains(tokens[cp + 2].raw) {
            let mn = tokens[cp + 2].raw; let cp2 = find_matching_delim(tokens, cp + 3)
            let rt = if !err_is_lex_bound(st, t.raw) { match st.pkg_fn_ret_types.get(t.raw) { Some(v) => v, None => "" } } else { "" }
            if st.pkg_concrete_types.contains(rt) && (st.pkg_raise_methods.contains(rt + "::" + mn) || st.pkg_non_raise_methods.contains(rt + "::" + mn)) {
              let call_s = t.raw + "(" + lower_err_range(st, src, tokens, i + 2, cp) + ")." + mn + "(" + lower_err_range(st, src, tokens, cp + 4, cp2) + ")"
              sb.write_string(t.leading_trivia + (if st.pkg_raise_methods.contains(rt + "::" + mn) { err_wrap_call(st, call_s, t.line, t.col) } else { call_s })); i = cp2 + 1; continue
            }
            err_unsup(st, tokens[cp + 2].line, tokens[cp + 2].col, "cannot prove target declaration for potentially raising method `." + mn + "()`")
          }
        }
      }
    }
    if t.kind == TokenKind::Dot && i + 2 < end && tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LParen && st.pkg_raise_method_names.contains(tokens[i + 1].raw) {
      err_unsup(st, tokens[i + 1].line, tokens[i + 1].col, "cannot resolve receiver type for potentially raising method `." + tokens[i + 1].raw + "()`")
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let is_ml = t.kind == TokenKind::InterpMultiline; let isb = StringBuilder(); isb.write_string(if is_ml { "$|" } else { "\"" })
      for p in split_interp_string(t.raw, is_ml) { if p.is_expr { let ht = lex_moonbit(p.text); isb.write_string("\\{" + lower_err_range(st, p.text, ht, 0, ht.length() - 1) + "}") } else { isb.write_string(p.text) } }
      if !is_ml { isb.write_string("\"") }; sb.write_string(t.leading_trivia + isb.to_string()); i = i + 1; continue
    }
    sb.write_string(t.leading_trivia + t.raw); i = i + 1
  }
  sb.to_string()
}

fn err_try_body_end(toks : Array[Token], ti : Int, lim : Int) -> Int {
  if ti + 1 < lim && toks[ti + 1].kind == TokenKind::LBrace { return find_matching_delim(toks, ti + 1) }
  let mut sc = ti + 1; let mut sd = 0
  while sc < lim { if sd == 0 && is_kw_or_id(toks[sc], "catch") { return sc }; sd = err_step_d(toks[sc].kind, sd); sc = sc + 1 }
  -1
}

pub fn preprocess_controlled_errors(sources : Array[SourceFile], diags : Array[Diag]) -> Array[SourceFile] {
  let all_toks : Array[Array[Token]] = []; let mut any_err_kw = false; let used_idents : Map[String, Bool] = Map()
  for sf in sources {
    let toks = lex_moonbit(sf.content); let mut i = 0
    while i < toks.length() - 1 {
      let t = toks[i]
      if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent { used_idents[t.raw] = true }
      if is_kw_or_id(t, "suberror") || is_kw_or_id(t, "raise") || is_kw_or_id(t, "try") { any_err_kw = true }
      i = i + 1
    }
    all_toks.push(toks)
  }
  if !any_err_kw { return sources }
  let failure_enum = err_alloc_unique(used_idents, "MbtFailure"); let outcome_enum = err_alloc_unique(used_idents, "MbtTryOutcome")
  let suberror_names : Map[String, Bool] = Map(); let suberror_ctors : Map[String, String] = Map()
  let pkg_raise_fns : Map[String, String] = Map(); let pkg_raise_methods : Map[String, String] = Map(); let pkg_non_raise_methods : Map[String, Bool] = Map()
  let pkg_raise_method_names : Map[String, Bool] = Map(); let pkg_fn_ret_types : Map[String, String] = Map(); let pkg_all_fns : Map[String, Bool] = Map()
  let pkg_concrete_types : Map[String, Bool] = Map()
  for bt in ["Int", "Int64", "UInt", "UInt64", "Double", "Float", "Bool", "Char", "Byte", "String", "Bytes", "Unit", "Array", "FixedArray", "Map", "Option", "Result", "StringBuilder"] { pkg_concrete_types[bt] = true }
  let cat_a_cands : Map[String, (String, Int, Int)] = Map(); let cat_a_rejected : Map[String, Bool] = Map()
  let fn_callees : Map[String, Array[String]] = Map(); let called_in_try : Map[String, Bool] = Map()

  let mut fi = 0
  while fi < sources.length() {
    let toks = all_toks[fi]; let n = toks.length() - 1; let mut i = 0; let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && (is_kw_or_id(t, "struct") || is_kw_or_id(t, "enum")) && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent { pkg_concrete_types[toks[i + 1].raw] = true }
      if depth == 0 && is_kw_or_id(t, "suberror") && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let en = toks[i + 1].raw; suberror_names[en] = true; suberror_ctors[en] = en; pkg_concrete_types[en] = true
        if i + 2 < n && toks[i + 2].kind == TokenKind::LBrace { let rb = find_matching_delim(toks, i + 2); let mut k = i + 3; let mut bd = 0; while k < rb { if bd == 0 && toks[k].kind == TokenKind::UpperIdent && (k == i + 3 || toks[k].newline_before || toks[k - 1].kind == TokenKind::Semi) { suberror_ctors[toks[k].raw] = en }; bd = err_step_d(toks[k].kind, bd); k = k + 1 }; i = rb + 1; continue }
      }
      i = i + 1
    }
    fi = fi + 1
  }
  fi = 0
  while fi < sources.length() {
    let sf = sources[fi]; let toks = all_toks[fi]; let n = toks.length() - 1; let mut i = 0; let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "fn" {
        let is_pub = (i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "pub") || (i >= 4 && toks[i - 1].kind == TokenKind::RParen && toks[i - 3].kind == TokenKind::LParen && toks[i - 4].kind == TokenKind::Keyword && toks[i - 4].raw == "pub")
        match err_parse_fn_header(sf.content, toks, i, n) {
          Some((fname, _, _, rty, has_r, ety, has_rp, lb)) => {
            let rb = find_matching_delim(toks, lb); let callees : Array[String] = []; let mut k = lb + 1; let mut td = 0; let t_ends : Array[Int] = []; let mut body_err = false
            while k < rb {
              while t_ends.length() > 0 && k >= t_ends[t_ends.length() - 1] { let _ = t_ends.pop(); if td > 0 { td = td - 1 } }
              let kt = toks[k]
              if is_kw_or_id(kt, "raise") || is_kw_or_id(kt, "try") || is_kw_or_id(kt, "catch") { body_err = true }
              if is_kw_or_id(kt, "try") { let te = err_try_body_end(toks, k, rb); if te > k { td = td + 1; t_ends.push(te) } }
              if kt.kind == TokenKind::Ident && k + 1 < rb && toks[k + 1].kind == TokenKind::LParen && !(k > lb + 1 && (toks[k - 1].kind == TokenKind::Dot || toks[k - 1].kind == TokenKind::ColonColon)) { callees.push(kt.raw); if td > 0 { called_in_try[kt.raw] = true } }
              k = k + 1
            }
            if fname.length() > 0 {
              fn_callees[fname] = callees; pkg_all_fns[fname] = true
              let rt = err_base_upper_ident(rty); let mut is_tp = false
              if i + 1 < n && toks[i + 1].kind == TokenKind::LBracket { let cb = find_matching_delim(toks, i + 1); let mut tk = i + 2; while tk < cb { if toks[tk].kind == TokenKind::UpperIdent && toks[tk].raw == rt { is_tp = true; break }; tk = tk + 1 } }
              if rt.length() > 0 && pkg_concrete_types.contains(rt) && !is_tp { pkg_fn_ret_types[fname] = rt }
            }
            if has_r || has_rp {
              if is_pub { diags.push(diag_error("MBT2PION_UNSUPPORTED_SYNTAX", sf.rel_path, t.line, t.col, "public `raise` function `" + fname + "` is unsupported")); cat_a_rejected[fname] = true }
              else if has_rp || ety == "Error" || (ety.length() == 0 && (!sf.is_test || body_err)) || (ety.length() > 0 && ety != "Failure" && !suberror_names.contains(ety)) { diags.push(diag_error("MBT2PION_UNSUPPORTED_SYNTAX", sf.rel_path, t.line, t.col, "unsupported `raise` signature on `" + fname + "`")); cat_a_rejected[fname] = true }
              else if ety.length() == 0 { cat_a_cands[fname] = (sf.rel_path, t.line, t.col) }
              else { let ce = if ety == "Failure" { failure_enum } else { ety }; let cc = fname.index_of("::"); if cc > 0 { pkg_raise_methods[fname] = ce; pkg_raise_method_names[fname.slice(cc + 2, fname.length())] = true } else { pkg_raise_fns[fname] = ce } }
            } else if str_has(fname, "::") { pkg_non_raise_methods[fname] = true }
            i = rb + 1; continue
          }
          None => ()
        }
      }
      if is_kw_or_id(t, "try") { let tb = err_try_body_end(toks, i, n); if tb > i { let ks = if i + 1 < tb && toks[i + 1].kind == TokenKind::LBrace { i + 2 } else { i + 1 }; let mut k = ks; while k < tb { if toks[k].kind == TokenKind::Ident && k + 1 < tb && toks[k + 1].kind == TokenKind::LParen && !(k > ks && (toks[k - 1].kind == TokenKind::Dot || toks[k - 1].kind == TokenKind::ColonColon)) { called_in_try[toks[k].raw] = true }; k = k + 1 } } }
      i = i + 1
    }
    fi = fi + 1
  }
  let mut ch_try = true
  while ch_try { ch_try = false; for caller in called_in_try.keys() { match fn_callees.get(caller) { Some(cs) => { for c in cs { if !called_in_try.contains(c) { called_in_try[c] = true; ch_try = true } } }, None => () } } }
  let cat_a_val : Map[String, Bool] = Map()
  if cat_a_cands.length() > 0 {
    fi = 0
    while fi < sources.length() {
      let toks = all_toks[fi]; let mut i = 0
      while i < toks.length() - 1 {
        let t = toks[i]
        if t.kind == TokenKind::Ident && cat_a_cands.contains(t.raw) && !(i > 0 && ((toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "fn") || toks[i - 1].kind == TokenKind::Dot || toks[i - 1].kind == TokenKind::ColonColon)) && !(i + 1 < toks.length() - 1 && (toks[i + 1].kind == TokenKind::LParen || toks[i + 1].kind == TokenKind::Colon || toks[i + 1].kind == TokenKind::Eq)) { cat_a_val[t.raw] = true }
        if t.kind == TokenKind::UpperIdent && i + 2 < toks.length() - 1 && toks[i + 1].kind == TokenKind::ColonColon && toks[i + 2].kind == TokenKind::Ident { let qk = t.raw + "::" + toks[i + 2].raw; if cat_a_cands.contains(qk) && !(i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "fn") && !(i + 3 < toks.length() - 1 && toks[i + 3].kind == TokenKind::LParen) { cat_a_val[qk] = true } }
        i = i + 1
      }
      fi = fi + 1
    }
  }
  let cat_a_approved : Map[String, Bool] = Map()
  for cname in cat_a_cands.keys() {
    let mut ok = !called_in_try.contains(cname) && !cat_a_val.contains(cname)
    if ok { match fn_callees.get(cname) { Some(cs) => { for c in cs { if pkg_raise_fns.contains(c) || cat_a_rejected.contains(c) { ok = false; break } } }, None => () } }
    if ok { cat_a_approved[cname] = true } else { cat_a_rejected[cname] = true; match cat_a_cands.get(cname) { Some((cf, cl, cc)) => diags.push(diag_error("MBT2PION_UNSUPPORTED_SYNTAX", cf, cl, cc, "test helper `" + cname + "` violates Category A `raise` conditions")), None => () } }
  }

  let out_sources : Array[SourceFile] = []; let mut any_fail = false; let mut any_out = false; fi = 0
  while fi < sources.length() {
    let sf = sources[fi]; let src = sf.content; let toks = all_toks[fi]; let n = toks.length() - 1
    let st = ErrLowerState::{ file: sf.rel_path, is_test: sf.is_test, suberror_names: suberror_names, suberror_ctors: suberror_ctors, pkg_raise_fns: pkg_raise_fns, pkg_raise_methods: pkg_raise_methods, pkg_non_raise_methods: pkg_non_raise_methods, pkg_raise_method_names: pkg_raise_method_names, pkg_fn_ret_types: pkg_fn_ret_types, pkg_all_fns: pkg_all_fns, pkg_concrete_types: pkg_concrete_types, cat_a_approved: cat_a_approved, cat_a_rejected: cat_a_rejected, failure_enum: failure_enum, outcome_enum: outcome_enum, used_idents: used_idents, frames: [], lex_raise_closures: [Map()], lex_var_types: [Map()], diags: diags, need_failure: false, need_outcome: false, tmp_seq: 0 }
    let edits : Array[(Int, Int, String)] = []; let mut i = 0; let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && is_kw_or_id(t, "suberror") && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let ename = toks[i + 1].raw; let sb_b = if i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "priv" { toks[i - 1].start_byte } else { t.start_byte }
        if i + 2 < n && toks[i + 2].kind == TokenKind::LBrace { edits.push((sb_b, t.end_byte, "enum")) }
        else if i + 2 < n && toks[i + 2].kind == TokenKind::LParen { let cp = find_matching_delim(toks, i + 2); edits.push((sb_b, toks[cp].end_byte, "enum " + ename + " { " + ename + src.slice(toks[i + 2].start_byte, toks[cp].end_byte) + " }")); i = cp + 1; continue }
        else { edits.push((sb_b, toks[i + 1].end_byte, "enum " + ename + " { " + ename + " }")); i = i + 2; continue }
      }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "fn" {
        match err_parse_fn_header(src, toks, i, n) {
          Some((fname, op, cp, rty, has_r, ety, _, lb)) => {
            let rb = find_matching_delim(toks, lb)
            if cat_a_rejected.contains(fname) { i = rb + 1; continue }
            if has_r && ety.length() == 0 && cat_a_approved.contains(fname) { edits.push((t.start_byte, toks[lb].start_byte, src.slice(t.start_byte, toks[cp].end_byte) + " -> " + rty + " ")); i = rb + 1; continue }
            let pm : Map[String, String] = Map(); let cm : Map[String, String] = Map()
            err_seed_param_types(toks, op, cp, fname, pm, cm); st.lex_var_types.push(pm); st.lex_raise_closures.push(cm)
            if has_r && ety.length() > 0 {
              let ce = err_canon_ty(st, ety); st.frames.push(ErrFrame::SourceFn(rty, Some(ce)))
              let bt = lower_err_range(st, src, toks, lb + 1, rb); let _ = st.frames.pop()
              let w = if err_body_ends_with_return_or_raise(toks, lb, rb) { "{" + bt + " }" } else if rty == "Unit" { "{" + bt + "; Ok(()) }" } else { "{ Ok({" + bt + " }) }" }
              edits.push((t.start_byte, toks[rb].end_byte, src.slice(t.start_byte, toks[cp].end_byte) + " -> Result[" + rty + ", " + ce + "] " + w))
            } else {
              st.frames.push(ErrFrame::SourceFn(rty, None)); let nb = lower_err_range(st, src, toks, lb + 1, rb); let _ = st.frames.pop()
              if nb != src.slice(toks[lb].end_byte, toks[rb].start_byte) { edits.push((toks[lb].end_byte, toks[rb].start_byte, nb)) }
            }
            let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop(); i = rb + 1; continue
          }
          None => ()
        }
      }
      if depth == 0 && is_kw_or_id(t, "test") {
        let mut lb = i + 1; while lb < n && toks[lb].kind != TokenKind::LBrace { lb = lb + 1 }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, lb); st.lex_var_types.push(Map()); st.lex_raise_closures.push(Map()); st.frames.push(ErrFrame::SourceFn("Unit", None))
          let nb = lower_err_range(st, src, toks, lb + 1, rb); let _ = st.frames.pop(); let _ = st.lex_raise_closures.pop(); let _ = st.lex_var_types.pop()
          if nb != src.slice(toks[lb].end_byte, toks[rb].start_byte) { edits.push((toks[lb].end_byte, toks[rb].start_byte, nb)) }
          i = rb + 1; continue
        }
      }
      i = i + 1
    }
    if st.need_failure { any_fail = true }
    if st.need_outcome { any_out = true }
    out_sources.push(if edits.length() > 0 { SourceFile::{ rel_path: sf.rel_path, content: apply_byte_edits(src, edits), is_test: sf.is_test } } else { sf })
    fi = fi + 1
  }
  if (any_fail || any_out) && out_sources.length() > 0 {
    let h = (if any_fail { "enum " + failure_enum + " {\n  Failure(String)\n}\n\n" } else { "" }) + (if any_out { "enum " + outcome_enum + "[R, E] {\n  MbtTryOk\n  MbtTryRet(R)\n  MbtTryErr(E)\n}\n\n" } else { "" })
    let mut ti = 0; let mut k = 0; while k < out_sources.length() { if !out_sources[k].is_test { ti = k; break }; k = k + 1 }
    out_sources[ti] = SourceFile::{ rel_path: out_sources[ti].rel_path, content: h + out_sources[ti].content, is_test: out_sources[ti].is_test }
  }
  out_sources
}

fn iter_arg_tokens_are_pure(tokens : Array[Token], start : Int, end : Int) -> Bool {
  let mut k = start
  while k < end {
    let tk = tokens[k].kind
    if tk == TokenKind::LBrace || tk == TokenKind::Eq || tk == TokenKind::AssignOp ||
    tk == TokenKind::PipeGt || tk == TokenKind::LBracket {
      return false
    }
    if tk == TokenKind::LParen && k > start {
      let pk = tokens[k - 1].kind
      if pk == TokenKind::Ident || pk == TokenKind::UpperIdent ||
      pk == TokenKind::RParen || pk == TokenKind::RBracket {
        return false
      }
    }
    k = k + 1
  }
  true
}

///| Stage B fail-closed guard for `Array::iter()` (`mbt_compat::arr_iter`):
///| Pion `Array[T]` does not expose an independent snapshot backing buffer like MoonBit's `Array::iter()`,
///| so reject escaping/mutated `Array::iter()` (e.g. `shrink_to_fit` / `pop` / self-`push_iter` / mutating
///| callback chains) with `MBT2PION_ARRAY_ITER_MUTATION` while allowing fresh literals and pure immediate consumers.
fn stage_b_check_array_iter_mutation_cached(
  file_tokens : Map[String, Array[Token]],
  pkg_fns : Map[String, StageBPkgFn],
  f_rel : String,
  content : String,
  line : Int,
  col : Int,
  diags : Array[Diag],
) -> Unit {
  let tokens = match file_tokens.get(f_rel) {
    Some(ts) => ts
    None => {
      let ts = lex_moonbit(content)
      file_tokens[f_rel] = ts
      ts
    }
  }
  let n = tokens.length() - 1
  let mut dot_i = -1
  let mut best_dist = 1000000
  let mut ti = 0
  while ti + 2 < n {
    if tokens[ti].kind == TokenKind::Dot && tokens[ti + 1].raw == "iter" &&
    tokens[ti + 2].kind == TokenKind::LParen && tokens[ti + 1].line == line {
      let dist = if tokens[ti + 1].col >= col { tokens[ti + 1].col - col } else { col - tokens[ti + 1].col }
      if dist < best_dist {
        best_dist = dist
        dot_i = ti
      }
    }
    ti = ti + 1
  }
  if dot_i <= 0 {
    return
  }
  let iter_rp = find_matching_delim(tokens, dot_i + 2)
  // 1. Fresh array literal `[...].iter()` cannot be aliased or externally mutated.
  if tokens[dot_i - 1].kind == TokenKind::RBracket {
    let mut lb = dot_i - 1
    let mut bd = 0
    while lb >= 0 {
      if tokens[lb].kind == TokenKind::RBracket { bd = bd + 1 }
      else if tokens[lb].kind == TokenKind::LBracket {
        bd = bd - 1
        if bd == 0 { break }
      }
      lb = lb - 1
    }
    if lb >= 0 {
      let is_index_expr = lb > 0 && (
        tokens[lb - 1].kind == TokenKind::Ident ||
        tokens[lb - 1].kind == TokenKind::RParen ||
        tokens[lb - 1].kind == TokenKind::RBracket
      )
      if !is_index_expr {
        return
      }
    }
  }
  let recv_root = extract_dot_chain_root_ident(tokens, dot_i - 1)
  // 2. Check if immediately consumed by an iterator chain ending in a terminal consumer.
  let mut cur = iter_rp + 1
  let mut terminated = false
  let mut impure_arg = false
  let chain_cb_sites : Array[(Int, Int, String)] = []
  while cur + 2 < n && tokens[cur].kind == TokenKind::Dot && tokens[cur + 2].kind == TokenKind::LParen {
    let cm = tokens[cur + 1].raw
    let crp = find_matching_delim(tokens, cur + 2)
    if cm == "map" || cm == "filter" || cm == "filter_map" {
      chain_cb_sites.push((tokens[cur + 1].line, tokens[cur + 1].col, cm))
      cur = crp + 1
      continue
    }
    if cm == "take" || cm == "drop" || cm == "zip" {
      if !iter_arg_tokens_are_pure(tokens, cur + 3, crp) {
        impure_arg = true
      }
      cur = crp + 1
      continue
    }
    if cm == "any" || cm == "all" || cm == "find_first" || cm == "fold" || cm == "each" {
      chain_cb_sites.push((tokens[cur + 1].line, tokens[cur + 1].col, cm))
      terminated = true
      break
    }
    if cm == "collect" || cm == "to_array" || cm == "count" || cm == "join" {
      if !iter_arg_tokens_are_pure(tokens, cur + 3, crp) {
        impure_arg = true
      }
      terminated = true
      break
    }
    break
  }
  if terminated {
    if impure_arg {
      diags.push(diag_error(
        "MBT2PION_ARRAY_ITER_MUTATION",
        f_rel,
        line,
        col,
        "Array::iter() chain argument contains non-pure expression that may mutate receiver during iteration",
      ))
      return
    }
    // Verify none of the callbacks in the immediate consumer chain mutate the receiver array.
    if chain_cb_sites.length() > 0 {
      let eff_root = if recv_root.length() > 0 { recv_root } else { "__MBT2PION_UNKNOWN_RECV__" }
      for cb in chain_cb_sites {
        let before_n = diags.length()
        stage_b_check_array_retain_mutation_with_root(file_tokens, pkg_fns, f_rel, content, cb.0, cb.1, cb.2, eff_root, diags)
        if diags.length() > before_n {
          let label = if recv_root.length() > 0 { "`" + recv_root + "`" } else { "receiver" }
          diags[before_n] = diag_error(
            "MBT2PION_ARRAY_ITER_MUTATION",
            f_rel,
            line,
            col,
            "Array::iter() callback may mutate " + label + " during iteration",
          )
          return
        }
      }
    }
    return
  }
  // 3. Check if immediately passed as the argument to `dst.push_iter(src.iter())` or `mbt_compat::arr_push_iter(dst, src.iter())`.
  //    Walk backward past the receiver expression of `.iter()` to see if it sits directly inside `push_iter(`.
  let mut rstart = dot_i - 1
  while rstart > 0 {
    let rk = tokens[rstart].kind
    if rk == TokenKind::RParen || rk == TokenKind::RBracket {
      let mut d = 0
      while rstart >= 0 {
        let tk = tokens[rstart].kind
        if tk == TokenKind::RParen || tk == TokenKind::RBracket { d = d + 1 }
        else if tk == TokenKind::LParen || tk == TokenKind::LBracket {
          d = d - 1
          if d == 0 { break }
        }
        rstart = rstart - 1
      }
      if rstart > 0 && (tokens[rstart - 1].kind == TokenKind::Ident || tokens[rstart - 1].kind == TokenKind::Dot) {
        rstart = rstart - 1
        continue
      }
      break
    } else if rk == TokenKind::Ident && rstart >= 2 && tokens[rstart - 1].kind == TokenKind::Dot {
      rstart = rstart - 2
      continue
    } else {
      break
    }
  }
  if iter_rp + 1 < n && tokens[iter_rp + 1].kind == TokenKind::RParen {
    if rstart >= 3 && tokens[rstart - 1].kind == TokenKind::LParen &&
    tokens[rstart - 2].raw == "push_iter" && tokens[rstart - 3].kind == TokenKind::Dot {
      let dst_root = extract_dot_chain_root_ident(tokens, rstart - 4)
      if recv_root.length() == 0 || dst_root.length() == 0 || dst_root == recv_root {
        diags.push(diag_error(
          "MBT2PION_ARRAY_ITER_MUTATION",
          f_rel,
          line,
          col,
          "self-appending or aliased `push_iter(*.iter())` cannot guarantee backing buffer isolation",
        ))
      }
      return
    }
    if rstart >= 2 && tokens[rstart - 1].kind == TokenKind::Comma {
      // `mbt_compat::arr_push_iter(dst, src.iter())`
      let mut pi = rstart - 2
      let mut pd = 0
      while pi >= 0 {
        let pk = tokens[pi].kind
        if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd + 1 }
        else if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
          if pd == 0 { break }
          pd = pd - 1
        }
        pi = pi - 1
      }
      if pi >= 1 && tokens[pi].kind == TokenKind::LParen && tokens[pi - 1].raw == "arr_push_iter" {
        let dst_root = extract_dot_chain_root_ident(tokens, rstart - 2)
        if recv_root.length() == 0 || dst_root.length() == 0 || dst_root == recv_root {
          diags.push(diag_error(
            "MBT2PION_ARRAY_ITER_MUTATION",
            f_rel,
            line,
            col,
            "self-appending or aliased `arr_push_iter(_, *.iter())` cannot guarantee backing buffer isolation",
          ))
        }
        return
      }
    }
  }
  // 4. Escaping `Array::iter()` (e.g. `let it = xs.iter()`):
  //    Default fail-closed; ONLY allow when ALL 3 invariants hold in the enclosing function:
  //    (a) bound to an immutable local `let it = xs.iter()` whose only uses are terminal non-escaping consumers;
  //    (b) `xs` is a freshly allocated local array (`let xs = [...]` / `Array::new()` / `Array::make(...)`);
  //    (c) every other occurrence of `xs` in the function is strictly append-only (`xs.push(...)`) or pure read
  //        (`xs.length()` / `xs.is_empty()` / `xs.copy()` / non-mutating `xs[i]`), never aliased or passed out.
  let mut safe_append_only = false
  if recv_root.length() > 0 && dot_i >= 4 &&
  tokens[dot_i - 1].kind == TokenKind::Ident && tokens[dot_i - 1].raw == recv_root &&
  tokens[dot_i - 2].kind == TokenKind::Eq &&
  tokens[dot_i - 3].kind == TokenKind::Ident &&
  tokens[dot_i - 4].kind == TokenKind::Keyword && tokens[dot_i - 4].raw == "let" &&
  (iter_rp + 1 >= n || tokens[iter_rp + 1].newline_before || tokens[iter_rp + 1].kind == TokenKind::Semi) {
    let it_var = tokens[dot_i - 3].raw
    let mut fn_lb = 0
    let mut fn_rb = n
    let mut scan = dot_i
    let mut depth = 0
    while scan >= 0 {
      let sk = tokens[scan].kind
      if sk == TokenKind::RBrace { depth = depth + 1 }
      else if sk == TokenKind::LBrace {
        if depth == 0 {
          fn_lb = scan
          let mut check_i = scan - 1
          let mut cd = 0
          let mut found_outer = false
          while check_i >= 0 {
            let ck = tokens[check_i].kind
            if ck == TokenKind::RBrace { cd = cd + 1 }
            else if ck == TokenKind::LBrace {
              if cd == 0 { found_outer = true; break }
              cd = cd - 1
            }
            check_i = check_i - 1
          }
          if !found_outer {
            fn_rb = find_matching_delim(tokens, fn_lb)
            break
          }
        } else {
          depth = depth - 1
        }
      }
      scan = scan - 1
    }
    let mut xs_is_fresh_local = false
    let mut xs_decl_idx = -1
    let mut xs_ok = true
    let mut it_ok = true
    let mut si = fn_lb + 1
    while si < fn_rb {
      let st = tokens[si]
      // Check fresh local declaration: `let [mut] <xs> [: T] = [...] | Array::new(...) | Array::make(...)`
      if st.kind == TokenKind::Keyword && st.raw == "let" {
        let mut ni = si + 1
        if ni < fn_rb && tokens[ni].kind == TokenKind::Keyword && tokens[ni].raw == "mut" { ni = ni + 1 }
        if ni < fn_rb && tokens[ni].kind == TokenKind::Ident && tokens[ni].raw == recv_root {
          let mut eq_i = ni + 1
          if eq_i < fn_rb && tokens[eq_i].kind == TokenKind::Colon {
            let mut td = 0
            while eq_i < fn_rb && !(td == 0 && tokens[eq_i].kind == TokenKind::Eq) {
              let tk = tokens[eq_i].kind
              if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
              else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
              eq_i = eq_i + 1
            }
          }
          if eq_i + 1 < fn_rb && tokens[eq_i].kind == TokenKind::Eq {
            let rhs = tokens[eq_i + 1]
            let fresh_rhs = rhs.kind == TokenKind::LBracket ||
            (rhs.raw == "Array" && eq_i + 3 < fn_rb && tokens[eq_i + 2].kind == TokenKind::ColonColon &&
              (tokens[eq_i + 3].raw == "new" || tokens[eq_i + 3].raw == "make" || tokens[eq_i + 3].raw == "from_iter"))
            if fresh_rhs && xs_decl_idx < 0 && ni < dot_i {
              xs_is_fresh_local = true
              xs_decl_idx = ni
            } else {
              xs_ok = false
            }
          } else {
            xs_ok = false
          }
        }
      }
      // Verify every occurrence of `recv_root` (not preceded by `.` or `::`)
      if st.kind == TokenKind::Ident && st.raw == recv_root &&
      !(si > fn_lb && (tokens[si - 1].kind == TokenKind::Dot || tokens[si - 1].kind == TokenKind::ColonColon)) {
        if si != xs_decl_idx && si != dot_i - 1 {
          let is_dot_call = si + 3 < fn_rb && tokens[si + 1].kind == TokenKind::Dot && tokens[si + 3].kind == TokenKind::LParen
          let is_allowed_method = is_dot_call && (
            tokens[si + 2].raw == "push" || tokens[si + 2].raw == "length" ||
            tokens[si + 2].raw == "is_empty" || tokens[si + 2].raw == "copy"
          )
          let mut is_read_index = false
          if si + 1 < fn_rb && tokens[si + 1].kind == TokenKind::LBracket {
            let cbr = find_matching_delim(tokens, si + 1)
            if cbr + 1 >= fn_rb || (tokens[cbr + 1].kind != TokenKind::Eq && tokens[cbr + 1].kind != TokenKind::AssignOp) {
              is_read_index = true
            }
          }
          if !is_allowed_method && !is_read_index {
            xs_ok = false
          }
        }
      }
      // Verify every occurrence of `it_var` (not preceded by `.` or `::`) is only a pure terminal consumer call
      if st.kind == TokenKind::Ident && st.raw == it_var &&
      !(si > fn_lb && (tokens[si - 1].kind == TokenKind::Dot || tokens[si - 1].kind == TokenKind::ColonColon)) {
        if si != dot_i - 3 {
          let is_term = si + 3 < fn_rb && tokens[si + 1].kind == TokenKind::Dot && tokens[si + 3].kind == TokenKind::LParen &&
          (tokens[si + 2].raw == "count" || tokens[si + 2].raw == "to_array" || tokens[si + 2].raw == "collect")
          if !is_term {
            it_ok = false
          } else {
            let trp = find_matching_delim(tokens, si + 3)
            if !iter_arg_tokens_are_pure(tokens, si + 4, trp) {
              it_ok = false
            }
          }
        }
      }
      si = si + 1
    }
    if xs_is_fresh_local && xs_ok && it_ok {
      safe_append_only = true
    }
  }
  if !safe_append_only {
    diags.push(diag_error(
      "MBT2PION_ARRAY_ITER_MUTATION",
      f_rel,
      line,
      col,
      "escaping `Array::iter()` cannot guarantee backing buffer isolation; consume immediately or copy first",
    ))
  }
}
