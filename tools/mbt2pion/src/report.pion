///| Platform-neutral generated file header emitter + structured JSON reports:
///| - `migration_report.json` (source-span disposition matrix + diagnostic code histogram + blockers)
///| - `semantic_drift_ledger.json` (all 7 silent-drift classes + status)
///| - `run_report.json` (host/timing metadata strictly kept OUT of generated `.pion` files)

import "json" as json

///| Emit strictly platform-neutral header for every generated `.pion` file.
///| Contains ONLY: `mbt2pion_commit`, `toolchain_lock`, `source_commit`,
///| `api_map_sha256`, `recipes_sha256`, `target`, and `"DO NOT HAND-EDIT"`.
///| NEVER embeds host binary SHA-256, host OS/arch, timestamps, or absolute paths!
pub fn render_platform_neutral_header(meta : HeaderMeta, source_rel : String) -> String {
  let sb = StringBuilder()
  sb.write_string("// GENERATED BY mbt2pion — DO NOT HAND-EDIT\n")
  sb.write_string("// source: " + source_rel + "\n")
  sb.write_string("// target: " + meta.target + "\n")
  sb.write_string("// mbt2pion_commit: " + meta.mbt2pion_commit + "\n")
  sb.write_string("// toolchain_lock: " + meta.toolchain_lock + "\n")
  sb.write_string("// source_commit: " + meta.source_commit + "\n")
  sb.write_string("// api_map_sha256: " + meta.api_map_sha256 + "\n")
  sb.write_string("// recipes_sha256: " + meta.recipes_sha256 + "\n")
  sb.write_string("\n")
  sb.to_string()
}

///| Serialize `migration_report.json` deterministically.
pub fn render_migration_report_json(res : TranspileResult, opts : TranspileOptions) -> String {
  let diag_arr : Array[json::JsonValue] = []
  for d in res.diagnostics {
    diag_arr.push(json_obj([
      json_field("severity", json_str(d.severity)),
      json_field("code", json_str(d.code)),
      json_field("file", json_str(d.file)),
      json_field("line", json_int(d.line)),
      json_field("col", json_int(d.col)),
      json_field("message", json_str(d.message)),
    ]))
  }

  let disp_arr : Array[json::JsonValue] = []
  for dp in res.dispositions {
    disp_arr.push(json_obj([
      json_field("file", json_str(dp.file)),
      json_field("decl", json_str(dp.decl)),
      json_field("line", json_int(dp.line)),
      json_field("col", json_int(dp.col)),
      json_field("disposition", json_str(dp.disposition)),
      json_field("detail", json_str(dp.detail)),
    ]))
  }

  let hist_fields : Array[json::JsonField] = []
  for p in res.pionc_diag_histogram {
    hist_fields.push(json_field(p.0, json_int(p.1)))
  }

  let file_arr : Array[json::JsonValue] = []
  for gf in res.files {
    let anc_arr : Array[json::JsonValue] = []
    for a in gf.anchors {
      anc_arr.push(json_obj([
        json_field("decl_identity", json_str(a.decl_identity)),
        json_field("normalized_source_cst_hash", json_str(a.normalized_source_cst_hash)),
        json_field("pre_overlay_generated_hash", json_str(a.pre_overlay_generated_hash)),
      ]))
    }
    file_arr.push(json_obj([
      json_field("rel_path", json_str(gf.rel_path)),
      json_field("source_file", json_str(gf.source_file)),
      json_field("sha256", json_str(content_sha256(gf.content))),
      json_field("anchors", json_arr(anc_arr)),
    ]))
  }

  let span_arr : Array[json::JsonValue] = []
  for sp in res.span_map {
    span_arr.push(json_obj([
      json_field("src_file", json_str(sp.src_file)),
      json_field("src_start", json_int(sp.src_start)),
      json_field("src_end", json_int(sp.src_end)),
      json_field("src_line", json_int(sp.src_line)),
      json_field("src_col", json_int(sp.src_col)),
      json_field("out_file", json_str(sp.out_file)),
      json_field("out_start", json_int(sp.out_start)),
      json_field("out_end", json_int(sp.out_end)),
      json_field("out_line", json_int(sp.out_line)),
      json_field("out_col", json_int(sp.out_col)),
      json_field("kind", json_str(sp.kind)),
    ]))
  }

  let probe_disp_arr : Array[json::JsonValue] = []
  for pd in res.probe_dispositions {
    probe_disp_arr.push(json_obj([
      json_field("probe_id", json_str(pd.probe_id)),
      json_field("probe_kind", json_str(pd.probe_kind)),
      json_field("file", json_str(pd.file)),
      json_field("line", json_int(pd.line)),
      json_field("col", json_int(pd.col)),
      json_field("resolved_type", json_str(pd.resolved_type)),
      json_field("disposition", json_str(pd.disposition)),
    ]))
  }

  let excl_assets_arr : Array[json::JsonValue] = []
  for ea in res.excluded_manifest_assets {
    excl_assets_arr.push(json_obj([
      json_field("path", json_str(ea.path)),
      json_field("sha256", json_str(ea.sha256)),
      json_field("reason", json_str(ea.reason)),
    ]))
  }

  let excl_target_arr : Array[json::JsonValue] = []
  for et in res.excluded_by_target {
    excl_target_arr.push(json_obj([
      json_field("path", json_str(et.path)),
      json_field("sha256", json_str(et.sha256)),
      json_field("reason", json_str(et.reason)),
    ]))
  }

  let emitted_src_arr : Array[json::JsonValue] = []
  for es in res.emitted_sources {
    emitted_src_arr.push(json_obj([
      json_field("path", json_str(es.path)),
      json_field("sha256", json_str(es.sha256)),
      json_field("reason", json_str(es.reason)),
    ]))
  }

  let synth_arr : Array[json::JsonValue] = []
  for sf in res.synthesized_files {
    synth_arr.push(json_str(sf))
  }

  let root = json_obj([
    json_field("schema_version", json_int(1)),
    json_field("target", json_str(opts.target)),
    json_field("mode", json_str(opts.mode)),
    json_field("blockers", json_int(res.blockers)),
    json_field("files_generated", json_int(res.files.length())),
    json_field("probe_rounds", json_int(res.probe_rounds)),
    json_field("probes_instrumented", json_int(res.probes_instrumented)),
    json_field("probes_resolved", json_int(res.probes_resolved)),
    json_field("stage_b_iterations", json_int(res.stage_b_iterations)),
    json_field("pionc_diagnostic_histogram", json_obj(hist_fields)),
    json_field("diagnostics", json_arr(diag_arr)),
    json_field("dispositions", json_arr(disp_arr)),
    json_field("probe_dispositions", json_arr(probe_disp_arr)),
    json_field("excluded_manifest_assets", json_arr(excl_assets_arr)),
    json_field("excluded_by_target", json_arr(excl_target_arr)),
    json_field("emitted", json_arr(emitted_src_arr)),
    json_field("synthesized_files", json_arr(synth_arr)),
    json_field("span_map", json_arr(span_arr)),
    json_field("files", json_arr(file_arr)),
  ])
  json::stringify(root) + "\n"
}

///| Serialize `semantic_drift_ledger.json` deterministically.
pub fn render_drift_ledger_json(res : TranspileResult, opts : TranspileOptions) -> String {
  let entries : Array[json::JsonValue] = []
  let mut unresolved = 0
  for e in res.drift_ledger {
    if e.status != "resolved" {
      unresolved = unresolved + 1
    }
    entries.push(json_obj([
      json_field("category", json_str(e.category)),
      json_field("file", json_str(e.file)),
      json_field("line", json_int(e.line)),
      json_field("col", json_int(e.col)),
      json_field("expr", json_str(e.expr)),
      json_field("resolution", json_str(e.resolution)),
      json_field("status", json_str(e.status)),
      json_field("detail", json_str(e.detail)),
    ]))
  }
  let root = json_obj([
    json_field("schema_version", json_int(1)),
    json_field("target", json_str(opts.target)),
    json_field("div_zero_reference_oracle", json_str("moon_wasm_gc_trap")),
    json_field("total_entries", json_int(res.drift_ledger.length())),
    json_field("unresolved_entries", json_int(unresolved)),
    json_field("entries", json_arr(entries)),
  ])
  json::stringify(root) + "\n"
}

///| Serialize `run_report.json` (host/timing telemetry, strictly separate from generated `.pion` headers).
pub fn render_run_report_json(
  opts : TranspileOptions,
  elapsed_ms : Int64,
  host_os : String,
  pionc_version : String,
  ok : Bool,
  blockers : Int,
) -> String {
  let root = json_obj([
    json_field("schema_version", json_int(1)),
    json_field("ok", json_bool(ok)),
    json_field("mode", json_str(opts.mode)),
    json_field("target", json_str(opts.target)),
    json_field("blockers", json_int(blockers)),
    json_field("elapsed_ms", json::JsonValue::JInt(elapsed_ms)),
    json_field("host_os", json_str(host_os)),
    json_field("pionc_version", json_str(pionc_version)),
  ])
  json::stringify(root) + "\n"
}
