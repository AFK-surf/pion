///| Unit tests for generic C-ABI FFI bridge lowering, application-pattern lowerings,
///| string-keyed map patterns in `if`/`guard ... is` chains, and builtin compat ABI schemas.

test "lower_ffi: direct scalar extern C passes through unchanged" {
  let used : Map[String, Bool] = Map()
  let r = try_lower_extern_c_fn(
    "pub ",
    "host_now",
    "a : Int, b : Double",
    " -> Double",
    "\"c_host_now\"",
    [],
    used,
  )
  assert_true(r.ok, "scalar C FFI must succeed")
  assert_true(!r.needs_bridge, "scalar C FFI must not emit wrapper")
  assert_true(
    r.code == "pub extern \"C\" fn host_now(a : Int, b : Double) -> Double = \"c_host_now\"",
    "scalar C FFI code mismatch",
  )
}

test "lower_ffi: borrowed String and Bytes params lower to Ptr+Int bridge with zero leaks" {
  let used : Map[String, Bool] = Map()
  let r1 = try_lower_extern_c_fn(
    "",
    "ffi_start",
    "data_dir : String, cloud : String, beta : Int",
    " -> Int",
    "\"c_start\"",
    ["#borrow(data_dir, cloud)"],
    used,
  )
  assert_true(r1.ok, "String borrow bridge must succeed")
  assert_true(r1.needs_bridge, "String param must emit bridge")
  assert_true(
    str_has(
      r1.code,
      "extern \"C\" fn __mbt_c_ffi_ffi_start(data_dir_ptr : Ptr, data_dir_len : Int, cloud_ptr : Ptr, cloud_len : Int, beta : Int) -> Int = \"pion_c_start\"",
    ),
    "must emit C-ABI extern decl with explicit shim prefix",
  )
  assert_true(
    str_has(
      r1.code,
      "data_dir.as_cstr(), data_dir.to_bytes().length(), cloud.as_cstr(), cloud.to_bytes().length(), beta",
    ),
    "must pass as_cstr + UTF-8 byte length via to_bytes().length()",
  )

  let r2 = try_lower_extern_c_fn(
    "",
    "ffi_send_bytes",
    "payload : String, data : Bytes",
    " -> Unit",
    "\"c_send_bytes\"",
    ["#borrow(payload, data)"],
    used,
  )
  assert_true(r2.ok, "String+Bytes borrow bridge must succeed")
  assert_true(str_has(r2.code, "mbt_compat::mbt_ffi_bytes_copy_to_ptr(data, 0,"), "must copy Bytes to raw buffer via mbt_compat")
  assert_true(str_has(r2.code, "mbt_compat::mbt_ffi_ptr_free("), "must free temporary Bytes buffer via mbt_compat")
}

test "lower_ffi: String and Bytes return types lower to cstr_to_str and bytes_from_ptr" {
  let used : Map[String, Bool] = Map()
  let rs = try_lower_extern_c_fn(
    "pub ",
    "ffi_scheme",
    "",
    " -> String",
    "\"c_scheme\"",
    [],
    used,
  )
  assert_true(rs.ok, "String return bridge must succeed")
  assert_true(str_has(rs.code, "-> Ptr = \"pion_c_scheme\""), "underlying extern returns Ptr with shim prefix")
  assert_true(str_has(rs.code, "if mbt_compat::mbt_ffi_ptr_is_null("), "wrapper guards NULL Ptr before cstr_to_str")
  assert_true(str_has(rs.code, "mbt_compat::mbt_ffi_cstr_to_str("), "wrapper converts Ptr via mbt_compat::mbt_ffi_cstr_to_str")

  let rb = try_lower_extern_c_fn(
    "",
    "ffi_read_buf",
    "tag : String",
    " -> Bytes",
    "\"c_read_buf\"",
    ["#borrow(tag)"],
    used,
  )
  assert_true(rb.ok, "Bytes return bridge must succeed")
  assert_true(str_has(rb.code, "__out_len : Ptr) -> Ptr = \"pion_c_read_buf\""), "Bytes return appends out_len Ptr with shim prefix")
  assert_true(str_has(rb.code, "mbt_compat::mbt_ffi_ptr_read_i32("), "wrapper reads out_len")
  assert_true(str_has(rb.code, "if mbt_compat::mbt_ffi_ptr_is_null(") && str_has(rb.code, "<= 0 { \"\".to_bytes() }"), "wrapper guards NULL Ptr or non-positive len")
  assert_true(str_has(rb.code, "mbt_compat::mbt_ffi_bytes_from_ptr("), "wrapper builds Bytes via mbt_compat::mbt_ffi_bytes_from_ptr")
  assert_true(str_has(rb.code, "mbt_compat::mbt_ffi_ptr_free("), "wrapper frees out_len box")
}

test "lower_ffi: fail-closed on invalid attributes, unannotated or owned params, or unsupported types" {
  let used : Map[String, Bool] = Map()
  let bad_attr = try_lower_extern_c_fn("", "f1", "x : Int", " -> Int", "\"c_f1\"", ["#unknown(x)"], used)
  assert_true(!bad_attr.ok, "unknown FFI attribute must fail closed")

  let bad_param = try_lower_extern_c_fn("", "f2", "x : String", " -> Int", "\"c_f2\"", ["#borrow(missing)"], used)
  assert_true(!bad_param.ok, "borrow referencing unknown param must fail closed")

  let bad_scalar = try_lower_extern_c_fn("", "f3", "x : Int", " -> Int", "\"c_f3\"", ["#borrow(x)"], used)
  assert_true(!bad_scalar.ok, "borrow on scalar Int must fail closed")

  let bad_owned = try_lower_extern_c_fn("", "f4", "s : String", " -> Int", "\"c_f4\"", ["#owned(s)"], used)
  assert_true(!bad_owned.ok, "#owned attribute must fail closed")

  let bad_unannotated_str = try_lower_extern_c_fn("", "f4b", "s : String", " -> Int", "\"c_f4b\"", [], used)
  assert_true(!bad_unannotated_str.ok, "unannotated String param (default owned) must fail closed")

  let bad_unannotated_bytes = try_lower_extern_c_fn("", "f4c", "b : Bytes", " -> Int", "\"c_f4c\"", [], used)
  assert_true(!bad_unannotated_bytes.ok, "unannotated Bytes param (default owned) must fail closed")

  let bad_ty = try_lower_extern_c_fn("", "f5", "xs : Array[Int]", " -> Int", "\"c_f5\"", [], used)
  assert_true(!bad_ty.ok, "unsupported Array param must fail closed")

  let bad_ret = try_lower_extern_c_fn("", "f6", "x : Int", " -> Option[Int]", "\"c_f6\"", [], used)
  assert_true(!bad_ret.ok, "unsupported Option return must fail closed")

  let bad_ret_nospace = try_lower_extern_c_fn("", "f6b", "x : Int", "-> Option[Int]", "\"c_f6b\"", [], used)
  assert_true(!bad_ret_nospace.ok, "non-spaced -> Option[Int] return must fail closed")

  let bad_ret_malformed = try_lower_extern_c_fn("", "f6c", "x : Int", "Int", "\"c_f6c\"", [], used)
  assert_true(!bad_ret_malformed.ok, "malformed return annotation without -> must fail closed")

  let bad_ret_empty = try_lower_extern_c_fn("", "f6d", "x : Int", "-> ", "\"c_f6d\"", [], used)
  assert_true(!bad_ret_empty.ok, "empty return type after -> must fail closed")

  let bad_pname = try_lower_extern_c_fn("", "f7", "x~ : Int", " -> Int", "\"c_f7\"", [], used)
  assert_true(!bad_pname.ok, "labeled/non-ident param name must fail closed")

  let bad_dup = try_lower_extern_c_fn("", "f8", "x : Int, x : Int", " -> Int", "\"c_f8\"", [], used)
  assert_true(!bad_dup.ok, "duplicate param name must fail closed")

  let bad_sym = try_lower_extern_c_fn("", "f9", "x : Int", " -> Int", "c_f9", [], used)
  assert_true(!bad_sym.ok, "non-quoted C symbol literal must fail closed")

  let bad_pfx = try_lower_extern_c_fn_with_prefix("", "f10", "s : String", " -> Int", "\"c_f10\"", ["#borrow(s)"], used, "")
  assert_true(!bad_pfx.ok, "empty shim_prefix on bridged FFI must fail closed")

  let bad_pfx_digit = try_lower_extern_c_fn_with_prefix("", "f11", "s : String", " -> Int", "\"c_f11\"", ["#borrow(s)"], used, "9pion_")
  assert_true(!bad_pfx_digit.ok, "digit-leading shim_prefix must fail closed")

  let bad_pfx_dash = try_lower_extern_c_fn_with_prefix("", "f12", "s : String", " -> Int", "\"c_f12\"", ["#borrow(s)"], used, "pion-bad_")
  assert_true(!bad_pfx_dash.ok, "hyphenated shim_prefix must fail closed")

  let bad_sym_space = try_lower_extern_c_fn("", "f13", "x : Int", " -> Int", "\"bad sym\"", [], used)
  assert_true(!bad_sym_space.ok, "C symbol containing whitespace must fail closed")

  let bad_sym_digit = try_lower_extern_c_fn("", "f14", "s : String", " -> Int", "\"1bad\"", ["#borrow(s)"], used)
  assert_true(!bad_sym_digit.ok, "digit-leading C symbol must fail closed")

  let bad_sym_quote = try_lower_extern_c_fn("", "f15", "x : Int", " -> Int", "\"a\\\"b\"", [], used)
  assert_true(!bad_sym_quote.ok, "C symbol with embedded escape/quote must fail closed")
}

test "lower_ffi: C-ABI param collision avoidance and verbatim oracle alignment" {
  let used1 : Map[String, Bool] = Map()
  let col1 = try_lower_extern_c_fn(
    "",
    "send_col",
    "data : Bytes, data_len : Int",
    " -> Int",
    "\"c_send_col\"",
    ["#borrow(data)"],
    used1,
  )
  assert_true(col1.ok, "data + data_len collision must resolve cleanly")
  assert_true(
    str_has(col1.code, "extern \"C\" fn __mbt_c_ffi_send_col(data_ptr : Ptr, data_len_1 : Int, data_len : Int) -> Int = \"pion_c_send_col\""),
    "synthesized data_len must avoid colliding with direct param data_len",
  )

  let used2 : Map[String, Bool] = Map()
  let col2 = try_lower_extern_c_fn(
    "",
    "read_col",
    "__out_len : Int",
    " -> Bytes",
    "\"c_read_col\"",
    [],
    used2,
  )
  assert_true(col2.ok, "__out_len direct param + Bytes return must resolve cleanly")
  assert_true(
    str_has(col2.code, "extern \"C\" fn __mbt_c_ffi_read_col(__out_len : Int, __out_len_1 : Ptr) -> Ptr = \"pion_c_read_col\""),
    "synthesized __out_len must avoid colliding with direct param __out_len",
  )

  // Wrapper local temp must never shadow source parameter `__ffi_data_len`
  let used4 : Map[String, Bool] = Map()
  let sh = try_lower_extern_c_fn(
    "",
    "pick",
    "data : Bytes, __ffi_data_len : Int",
    " -> Int",
    "\"demo_pick\"",
    ["#borrow(data)"],
    used4,
  )
  assert_true(sh.ok, "pick(data, __ffi_data_len) must lower cleanly")
  assert_true(
    str_has(sh.code, "let __ffi_data_len_1 = data.length()"),
    "wrapper local must rename to __ffi_data_len_1 to avoid shadowing param",
  )
  assert_true(
    str_has(sh.code, "__mbt_c_ffi_pick(__ffi_data_buf, __ffi_data_len_1, __ffi_data_len)"),
    "C call must pass __ffi_data_len_1 as bytes len and original __ffi_data_len as 3rd arg",
  )

  // Verbatim alignment check with run_f5_2_oracle.py FFI_BRIDGE_PION
  let used3 : Map[String, Bool] = Map()
  let v1 = try_lower_extern_c_fn(
    "",
    "ffi_start",
    "data_dir : String, cloud : String, beta : Int",
    " -> Int",
    "\"demo_start\"",
    ["#borrow(data_dir, cloud)"],
    used3,
  )
  let expected_v1 = "extern \"C\" fn __mbt_c_ffi_ffi_start(data_dir_ptr : Ptr, data_dir_len : Int, cloud_ptr : Ptr, cloud_len : Int, beta : Int) -> Int = \"pion_demo_start\"\nfn ffi_start(data_dir : String, cloud : String, beta : Int) -> Int {\n  let __ffi_res = __mbt_c_ffi_ffi_start(data_dir.as_cstr(), data_dir.to_bytes().length(), cloud.as_cstr(), cloud.to_bytes().length(), beta)\n  __ffi_res\n}"
  assert_true(v1.ok && v1.code == expected_v1, "verbatim output for ffi_start must match oracle")
}

test "lower_apps: builtin ctor rest arity, char ranges, split-next, array-concat, and map patterns" {
  assert_true(expand_builtin_ctor_rest("Number", 1) is None, "unqualified Number must NOT match unconditionally")
  assert_true(lookup_mbt_json_unqualified_ctor_arity("Number") is Some(2), "qualified-context MbtJson::Number arity is 2")
  assert_true(expand_builtin_ctor_rest("Json::Number", 1) is Some(1), "Json::Number(d, ..) needs 1 wildcard")
  assert_true(expand_builtin_ctor_rest("MbtJson::Number", 2) is Some(0), "MbtJson::Number(d, r, ..) needs 0 wildcards")
  assert_true(expand_builtin_ctor_rest("Json::Number", 3) is None, "over-arity Json::Number must fail closed")
  assert_true(expand_builtin_ctor_rest("UnknownCtor", 1) is None, "unknown ctor must fail closed")

  let toks = lex_moonbit("'0'..='9' | 'a'..<'g' | '_'")
  match lower_char_range_arm_pat(toks, 0, toks.length() - 1, "__ch") {
    Some((bv, cond)) => {
      assert_true(bv == "__ch", "bind_var mismatch")
      assert_true(
        cond == "(__ch >= '0' && __ch <= '9') || (__ch >= 'a' && __ch < 'g') || (__ch == '_')",
        "char range cond mismatch",
      )
    }
    None => assert_true(false, "char range pattern must lower")
  }

  let trailing_pipe = lex_moonbit("'0'..='9' |")
  assert_true(
    lower_char_range_arm_pat(trailing_pipe, 0, trailing_pipe.length() - 1, "__ch") is None,
    "trailing dangling pipe must fail closed",
  )
  let leading_pipe = lex_moonbit("| '0'..='9'")
  assert_true(
    lower_char_range_arm_pat(leading_pipe, 0, leading_pipe.length() - 1, "__ch") is None,
    "leading dangling pipe must fail closed",
  )

  let non_range = lex_moonbit("'x'")
  assert_true(
    lower_char_range_arm_pat(non_range, 0, non_range.length() - 1, "__ch") is None,
    "plain char literal without range must return None",
  )

  let sn = lower_string_split_next("key", "\"/\"", "__sp")
  assert_true(str_has(sn, "if __sp.length() > 0 { Some(__sp[0]) } else { None }"), "split().next() must lower safely")

  let ac = lower_array_concat_expr("xs", "ys", "__ac")
  assert_true(ac == "mbt_compat::arr_concat(xs, ys)", "Array concat must delegate to mbt_compat::arr_concat")

  assert_true(is_string_to_owned_method("to_owned", "String"), "String::to_owned recognized")
  assert_true(is_string_to_owned_method("to_owned", "StrView"), "StrView::to_owned recognized")
  assert_true(!is_string_to_owned_method("to_owned", "Bytes"), "non-String to_owned rejected")

  let mp = lower_string_map_pattern_chain(
    "obj",
    [("\"a\"", "x", false), ("\"b\"", "opt_y", true)],
    "x",
    "0",
  )
  assert_true(
    str_has(mp, "match obj.get(\"a\") { Some(x) => { let opt_y = obj.get(\"b\"); x }, _ => 0 }"),
    "map pattern chain must nest deterministically",
  )
}

test "lower_is_chain: string-keyed map patterns inside if/guard is chains" {
  let src = "pub fn lookup_pair(m : Map[String, Int]) -> Int {\n  if m is { \"x\": a, \"y\": b, .. } && a > 0 {\n    a + b\n  } else {\n    -1\n  }\n}\n\npub fn guard_opt_key(m : Map[String, Int]) -> Int {\n  guard m is { \"k\": v, \"opt\"?: ov, .. } else {\n    return 0\n  }\n  match ov {\n    Some(w) => v + w\n    None => v\n  }\n}\n"
  let sf = SourceFile::{ rel_path: "map_is.mbt", content: src, is_test: false }
  let res = transpile_package([sf], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(res.blockers, 0)
  assert_true(res.files.length() == 1, "expected 1 output file")
  let out = res.files[0].content
  assert_true(str_has(out, ".get(\"x\")"), "must lower string key x via .get(\"x\")")
  assert_true(str_has(out, ".get(\"y\")"), "must lower string key y via .get(\"y\")")
  assert_true(str_has(out, ".get(\"opt\")"), "must lower optional string key via .get(\"opt\")")
}

test "abi: builtin_mbt_compat_enum_schemas exposes canonical MbtJson::Number arity 2" {
  let schemas = builtin_mbt_compat_enum_schemas()
  assert_eq(schemas.length(), 1)
  assert_true(schemas[0].pkg == "mbt_compat", "pkg mismatch")
  assert_true(schemas[0].name == "MbtJson", "name mismatch")
  let mut num_arity = -1
  for v in schemas[0].variants {
    if v.name == "Number" {
      num_arity = v.fields.length()
    }
  }
  assert_eq(num_arity, 2)
}

test "stage_a_ffi: default empty prefix stays fail-closed, opt-in prefix lowers bridged extern C and preserves direct scalars" {
  let src = "pub extern \"C\" fn raw_add(a : Int, b : Int) -> Int = \"c_raw_add\"\n\n#borrow(msg, data)\npub extern \"C\" fn send_msg(msg : String, data : Bytes, tag : Int) -> Int = \"c_send_msg\"\n\npub extern \"C\" fn get_name() -> String = \"c_get_name\"\n"
  let sf = SourceFile::{ rel_path: "ffi_mod.mbt", content: src, is_test: false }

  // 1. Default (ffi_shim_prefix == "") must fail closed on bridged extern C
  let res_def = transpile_package([sf], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(res_def.blockers > 0, "default empty ffi_shim_prefix must block bridged extern C")
  let mut has_ffi_err = false
  for d in res_def.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" {
      has_ffi_err = true
    }
  }
  assert_true(has_ffi_err, "must emit MBT2PION_UNSUPPORTED_FFI_SIGNATURE by default")

  // 2. Opt-in ffi_shim_prefix == "pion_" must lower cleanly with 0 blockers
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  let res_ok = transpile_package([sf], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(res_ok.blockers, 0)
  assert_eq(res_ok.files.length(), 1)
  let out = res_ok.files[0].content
  assert_true(
    str_has(out, "pub extern \"C\" fn raw_add(a : Int, b : Int) -> Int = \"c_raw_add\""),
    "direct scalar extern C must keep original C symbol without prefix",
  )
  assert_true(
    str_has(out, "extern \"C\" fn __mbt_c_ffi_send_msg(msg_ptr : Ptr, msg_len : Int, data_ptr : Ptr, data_len : Int, tag : Int) -> Int = \"pion_c_send_msg\""),
    "bridged extern C must use prefixed C symbol",
  )
  assert_true(
    str_has(out, "extern \"C\" fn __mbt_c_ffi_get_name() -> Ptr = \"pion_c_get_name\""),
    "String return extern C must use prefixed C symbol",
  )
  assert_eq(res_ok.ffi_symbols.length(), 3)
  assert_true(res_ok.ffi_symbols[0].fn_name == "raw_add" && res_ok.ffi_symbols[0].raw_c_symbol == "c_raw_add" && res_ok.ffi_symbols[0].emitted_c_symbol == "c_raw_add" && !res_ok.ffi_symbols[0].bridged, "scalar symbol mapping mismatch")
  assert_true(res_ok.ffi_symbols[1].fn_name == "send_msg" && res_ok.ffi_symbols[1].raw_c_symbol == "c_send_msg" && res_ok.ffi_symbols[1].emitted_c_symbol == "pion_c_send_msg" && res_ok.ffi_symbols[1].bridged, "bridged send_msg mapping mismatch")
  assert_true(res_ok.ffi_symbols[2].fn_name == "get_name" && res_ok.ffi_symbols[2].raw_c_symbol == "c_get_name" && res_ok.ffi_symbols[2].emitted_c_symbol == "pion_c_get_name" && res_ok.ffi_symbols[2].bridged, "bridged get_name mapping mismatch")

  let rep = render_migration_report_json(res_ok, opts_pfx)
  assert_true(str_has(rep, "\"ffi_shim_prefix\":\"pion_\""), "migration report must include ffi_shim_prefix")
  assert_true(str_has(rep, "\"emitted_c_symbol\":\"pion_c_send_msg\""), "migration report must include ffi_symbols table")
}

test "stage_a_ffi: package-wide C symbol collision fails closed in both declaration orders" {
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  // Order 1: direct scalar `"pion_foo"` before bridged `"foo"`
  let src1 = "extern \"C\" fn raw_foo(x : Int) -> Int = \"pion_foo\"\n#borrow(s)\nextern \"C\" fn bridged_foo(s : String) -> Int = \"foo\"\n"
  let r1 = transpile_package([SourceFile::{ rel_path: "c1.mbt", content: src1, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r1.blockers > 0, "direct then bridged symbol collision must fail closed")

  // Order 2: bridged `"foo"` before direct scalar `"pion_foo"`
  let src2 = "#borrow(s)\nextern \"C\" fn bridged_foo(s : String) -> Int = \"foo\"\nextern \"C\" fn raw_foo(x : Int) -> Int = \"pion_foo\"\n"
  let r2 = transpile_package([SourceFile::{ rel_path: "c2.mbt", content: src2, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r2.blockers > 0, "bridged then direct symbol collision must fail closed")

  // Order 3: two bridged functions emitting same prefixed C symbol
  let src3 = "#borrow(s)\nextern \"C\" fn f_a(s : String) -> Int = \"dup\"\n#borrow(s)\nextern \"C\" fn f_b(s : String) -> Int = \"dup\"\n"
  let r3 = transpile_package([SourceFile::{ rel_path: "c3.mbt", content: src3, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r3.blockers > 0, "duplicate bridged C symbol must fail closed")
}

test "abi: ffi_shim_prefix enters abi_sha256 when non-empty and stays backward-compatible when empty" {
  let base_abi = empty_package_abi("demo")
  let base_payload = render_canonical_abi_payload(base_abi)
  assert_true(!str_has(base_payload, "ffi_shim_prefix"), "empty ffi_shim_prefix must be omitted for backward-compatible abi_sha256")
  let sha_empty = compute_abi_payload_sha256(base_abi)

  let pfx_abi = PackageAbi::{
    package_name: "demo",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "pion_",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let pfx_payload = render_canonical_abi_payload(pfx_abi)
  assert_true(str_has(pfx_payload, "\"ffi_shim_prefix\":\"pion_\""), "non-empty ffi_shim_prefix must appear in canonical ABI payload")
  let sha_pion = compute_abi_payload_sha256(pfx_abi)
  assert_true(sha_pion != sha_empty, "non-empty ffi_shim_prefix must change abi_sha256")

  let alt_abi = PackageAbi::{
    package_name: "demo",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "alt_",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  assert_true(compute_abi_payload_sha256(alt_abi) != sha_pion, "different ffi_shim_prefix must produce distinct abi_sha256")

  // Round-trip through render_abi_json + verify_and_parse_dep_abi
  let hdr = "// abi-sha256: " + sha_pion + "\npub fn f() -> Int { 1 }\n"
  let pfiles = [("a.pion", hdr)]
  let raw_json = render_abi_json(pfx_abi, pfiles)
  let diags : Array[Diag] = []
  match verify_and_parse_dep_abi("demo", "/tmp/demo", pfiles, Some(raw_json), diags) {
    Some(parsed) => {
      assert_eq(diags.length(), 0)
      assert_true(parsed.ffi_shim_prefix == "pion_", "parsed ABI must preserve ffi_shim_prefix")
    }
    None => assert_true(false, "valid ABI with ffi_shim_prefix must verify cleanly")
  }

  // Tampered invalid ffi_shim_prefix in mbt2pion_abi.json must fail closed
  let bad_json = str_replace_all(raw_json, "\"pion_\"", "\"123-bad\"")
  let bad_diags : Array[Diag] = []
  let bad_res = verify_and_parse_dep_abi("demo", "/tmp/demo", pfiles, Some(bad_json), bad_diags)
  assert_true(bad_res is None && bad_diags.length() > 0, "tampered invalid ffi_shim_prefix in ABI must fail closed")
}

test "stage_a_ffi: invalid raw C symbol, invalid pipeline ffi_shim_prefix without externs, and cross-file helper collision avoidance" {
  // 1. Default empty prefix must still reject invalid C symbol identifiers
  let bad_sym_src = "pub extern \"C\" fn bad_sym(x : Int) -> Int = \"bad sym\"\n"
  let r_bad_sym = transpile_package(
    [SourceFile::{ rel_path: "bad.mbt", content: bad_sym_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_bad_sym.blockers > 0, "invalid C symbol in default mode must fail closed")

  // 2. Invalid opts.ffi_shim_prefix on a package with zero extern C decls must fail closed and never leak into ABI
  let bad_opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "123-bad",
    header: default_header_meta("native"),
  }
  let r_bad_opts = transpile_package(
    [SourceFile::{ rel_path: "pure.mbt", content: "pub fn add(a : Int, b : Int) -> Int { a + b }\n", is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    bad_opts,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_bad_opts.blockers > 0, "invalid ffi_shim_prefix without externs must still block")
  assert_true(r_bad_opts.abi.ffi_shim_prefix == "", "invalid ffi_shim_prefix must never be emitted into PackageAbi")

  // 3. Cross-file used_idents pre-population avoids colliding with a user function in a later file
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  let sf_a = SourceFile::{
    rel_path: "a.mbt",
    content: "#borrow(s)\npub extern \"C\" fn foo(s : String) -> Int = \"c_foo\"\n",
    is_test: false,
  }
  let sf_b = SourceFile::{
    rel_path: "b.mbt",
    content: "pub fn __mbt_c_ffi_foo() -> Int { 42 }\n",
    is_test: false,
  }
  let r_multi = transpile_package(
    [sf_a, sf_b],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_eq(r_multi.blockers, 0)
  assert_eq(r_multi.files.length(), 2)
  assert_true(
    str_has(r_multi.files[0].content, "extern \"C\" fn __mbt_c_ffi_foo_1("),
    "generated bridged helper in a.mbt must rename to avoid colliding with __mbt_c_ffi_foo in b.mbt",
  )
}

test "stage_a_ffi: unshadowable mbt_compat wrappers, normalized scalar signatures, companion collision, and Float32/Int8 allowlist" {
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }

  // 1. User-defined cstr_to_str in another file must NOT hijack bridged String return wrapper
  let sf_greet = SourceFile::{
    rel_path: "a.mbt",
    content: "pub extern \"C\" fn greeting() -> String = \"greeting\"\n",
    is_test: false,
  }
  let sf_shadow = SourceFile::{
    rel_path: "b.mbt",
    content: "pub fn[T] cstr_to_str(_x : T) -> String { \"custom\" }\n",
    is_test: false,
  }
  let r_unshadow = transpile_package([sf_greet, sf_shadow], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_unshadow.blockers, 0)
  assert_true(
    str_has(r_unshadow.files[0].content, "mbt_compat::mbt_ffi_cstr_to_str("),
    "bridged wrapper must call mbt_compat::mbt_ffi_cstr_to_str",
  )
  assert_true(
    str_has(r_unshadow.files[0].content, "import \"mbt_compat\""),
    "auto-import must emit mbt_compat import for bridged wrapper",
  )

  // 1b. Shadowing `mbt_compat` at package level must fail closed on bridged extern C,
  // while an unrelated function's local parameter named `mbt_compat` in another file must PASS!
  let sf_shadow_mc = SourceFile::{
    rel_path: "mc.mbt",
    content: "pub fn mbt_compat() -> Int { 1 }\npub extern \"C\" fn greeting() -> String = \"greeting\"\n",
    is_test: false,
  }
  let r_mc_shadow = transpile_package([sf_shadow_mc], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_mc_shadow.blockers > 0, "user binding shadowing mbt_compat must fail closed for bridged extern C")

  let sf_unrelated_param = SourceFile::{
    rel_path: "unrel.mbt",
    content: "pub fn unrelated(mbt_compat : Int) -> Int { mbt_compat }\n",
    is_test: false,
  }
  let r_unrel = transpile_package([sf_greet, sf_unrelated_param], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_unrel.blockers, 0)

  // 2. Normalized scalar C-ABI signatures: same types with different param names must PASS in both modes
  let sf_inc1 = SourceFile::{
    rel_path: "f1.mbt",
    content: "pub extern \"C\" fn first(x : Int) -> Int = \"increment\"\n",
    is_test: false,
  }
  let sf_inc2 = SourceFile::{
    rel_path: "f2.mbt",
    content: "pub extern \"C\" fn second(value : Int) -> Int = \"increment\"\n",
    is_test: false,
  }
  let r_inc_def = transpile_package([sf_inc1, sf_inc2], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_inc_def.blockers, 0)
  let r_inc_pfx = transpile_package([sf_inc1, sf_inc2], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_inc_pfx.blockers, 0)

  // 2b. Different parameter types on same scalar C symbol must fail closed
  let sf_inc_bad = SourceFile::{
    rel_path: "f3.mbt",
    content: "pub extern \"C\" fn third(value : Int64) -> Int = \"increment\"\n",
    is_test: false,
  }
  let r_inc_bad = transpile_package([sf_inc1, sf_inc_bad], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_inc_bad.blockers > 0, "mismatched scalar parameter types for same C symbol must fail closed")

  // 3. Companion file extern "C" symbol colliding with generated bridged symbol must fail closed
  let comp_src = "extern \"C\" fn hand_greeting() -> Ptr = \"pion_greeting\"\n"
  let comp_files = [("hand_ffi.pion", comp_src, content_sha256(comp_src))]
  let r_comp_col = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    comp_files,
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_col.blockers > 0, "companion extern C colliding with bridged symbol must fail closed")
  let mut saw_both = false
  for d in r_comp_col.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && str_has(d.message, "hand_ffi.pion") && str_has(d.message, "a.mbt") {
      saw_both = true
    }
  }
  assert_true(saw_both, "companion collision diagnostic must mention both companion and source files")

  // 3b. Multiline return type and omitted `= "<sym>"` (defaults to fn name) in companion must also collide
  let comp_multiline = "extern \"C\" fn other() ->\n  Ptr = \"pion_greeting\"\n"
  let r_comp_ml = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("ml_ffi.pion", comp_multiline, content_sha256(comp_multiline))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_ml.blockers > 0, "multiline companion extern C colliding with bridged symbol must fail closed")

  let comp_omitted = "extern \"C\" fn pion_greeting() -> Ptr\npub fn helper() -> Int { 1 }\n"
  let r_comp_om = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("om_ffi.pion", comp_omitted, content_sha256(comp_omitted))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_om.blockers > 0, "companion extern C omitting = sym (defaulting to fn name) must collide fail-closed")

  // 4. Unified scalar allowlist: Float32 and Int8 pass cleanly in both default and prefixed modes
  let sf_f32_i8 = SourceFile::{
    rel_path: "scalars.mbt",
    content: "pub extern \"C\" fn f32_i8(a : Float32, b : Int8) -> Float32 = \"c_f32_i8\"\n",
    is_test: false,
  }
  let r_s_def = transpile_package([sf_f32_i8], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_s_def.blockers, 0)
  let r_s_pfx = transpile_package([sf_f32_i8], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_s_pfx.blockers, 0)

  // 5. Post-overlay FFI symbol reconciliation & collision check
  let ov_src = "pub extern \"C\" fn value(x : Int) -> Int = \"old_symbol\"\n"
  let sf_ov = SourceFile::{ rel_path: "ov.mbt", content: ov_src, is_test: false }
  let r_base = transpile_package([sf_ov], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_base.blockers, 0)
  assert_true(r_base.files.length() == 1 && r_base.files[0].anchors.length() == 1, "expected 1 anchor for ov.mbt")
  let anc = r_base.files[0].anchors[0]
  let ov_rename = OverlaySpec::{
    id: "ov-rename-c-sym",
    source_file: "ov.mbt",
    decl_identity: anc.decl_identity,
    target: "native",
    normalized_source_cst_hash: anc.normalized_source_cst_hash,
    pre_overlay_generated_hash: anc.pre_overlay_generated_hash,
    replacement: "pub extern \"C\" fn value(x : Int) -> Int = \"new_symbol\"",
    reason: "redirect C symbol",
    behavior_test: "test_ov",
    upstream_issue_or_removal_condition: "none",
  }
  let r_ov_ok = transpile_package([sf_ov], empty_api_map(), default_recipes(), [ov_rename], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_ov_ok.blockers, 0)
  assert_eq(r_ov_ok.ffi_symbols.length(), 1)
  assert_true(
    r_ov_ok.ffi_symbols[0].raw_c_symbol == "old_symbol" && r_ov_ok.ffi_symbols[0].emitted_c_symbol == "new_symbol",
    "post-overlay ffi_symbols must reflect new_symbol while preserving raw_c_symbol old_symbol",
  )

  // 5b. Overlay redirecting C symbol into a collision with another declaration must fail closed
  let sf_ov2 = SourceFile::{
    rel_path: "ov2.mbt",
    content: "pub extern \"C\" fn other(x : Int64) -> Int = \"new_symbol\"\n",
    is_test: false,
  }
  let r_ov_col = transpile_package([sf_ov, sf_ov2], empty_api_map(), default_recipes(), [ov_rename], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_ov_col.blockers > 0, "overlay-introduced C symbol collision must fail closed")

  // 5c. Overlay freeing `"old_symbol"` -> `"new_symbol"` lets companion claim `"old_symbol"` with 0 blockers,
  // while companion claiming `"new_symbol"` still fails closed!
  let comp_old = "extern \"C\" fn take_old(x : Int64) -> Int = \"old_symbol\"\n"
  let r_ov_comp_ok = transpile_package_with_abis_and_companions(
    [sf_ov],
    empty_api_map(),
    default_recipes(),
    [ov_rename],
    [],
    [],
    [],
    [("take_old.pion", comp_old, content_sha256(comp_old))],
    [],
    default_options(),
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_eq(r_ov_comp_ok.blockers, 0)

  let comp_new = "extern \"C\" fn take_new(x : Int64) -> Int = \"new_symbol\"\n"
  let r_ov_comp_bad = transpile_package_with_abis_and_companions(
    [sf_ov],
    empty_api_map(),
    default_recipes(),
    [ov_rename],
    [],
    [],
    [],
    [("take_new.pion", comp_new, content_sha256(comp_new))],
    [],
    default_options(),
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_ov_comp_bad.blockers > 0, "companion colliding with post-overlay new_symbol must fail closed")

  // 5d. Exact emitted_pion_fn matching (no prefix mis-attribution): `foo` + `foo_bar`, overlay removes `foo` extern
  let sf_pfx_pair = SourceFile::{
    rel_path: "pair.mbt",
    content: "pub extern \"C\" fn foo() -> Int = \"c_int\"\npub extern \"C\" fn foo_bar() -> String = \"c_text\"\n",
    is_test: false,
  }
  let r_pair_base = transpile_package([sf_pfx_pair], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_pair_base.blockers, 0)
  assert_true(r_pair_base.files[0].anchors.length() == 2, "expected 2 anchors for pair.mbt")
  let anc_foo = r_pair_base.files[0].anchors[0]
  let ov_replace_foo = OverlaySpec::{
    id: "ov-replace-foo-pure",
    source_file: "pair.mbt",
    decl_identity: anc_foo.decl_identity,
    target: "native",
    normalized_source_cst_hash: anc_foo.normalized_source_cst_hash,
    pre_overlay_generated_hash: anc_foo.pre_overlay_generated_hash,
    replacement: "pub fn foo() -> Int { 1 }",
    reason: "replace foo with pure Pion",
    behavior_test: "test_ov_pair",
    upstream_issue_or_removal_condition: "none",
  }
  let r_pair_ov = transpile_package([sf_pfx_pair], empty_api_map(), default_recipes(), [ov_replace_foo], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_pair_ov.blockers, 0)
  assert_eq(r_pair_ov.ffi_symbols.length(), 1)
  assert_true(
    r_pair_ov.ffi_symbols[0].fn_name == "foo_bar" &&
    r_pair_ov.ffi_symbols[0].raw_c_symbol == "c_text" &&
    r_pair_ov.ffi_symbols[0].emitted_c_symbol == "pion_c_text" &&
    r_pair_ov.ffi_symbols[0].bridged,
    "exact emitted_pion_fn match must attribute __mbt_c_ffi_foo_bar to foo_bar / c_text, never foo / c_int",
  )

  // 6. Escaped C symbol string literal decoding in overlay & companion
  let ov_esc = OverlaySpec::{
    id: "ov-escaped-c-sym",
    source_file: "ov.mbt",
    decl_identity: anc.decl_identity,
    target: "native",
    normalized_source_cst_hash: anc.normalized_source_cst_hash,
    pre_overlay_generated_hash: anc.pre_overlay_generated_hash,
    replacement: "pub extern \"C\" fn value(x : Int) -> Int = \"new_symb\\u{6f}l\"",
    reason: "redirect C symbol with unicode escape",
    behavior_test: "test_ov_esc",
    upstream_issue_or_removal_condition: "none",
  }
  let r_ov_esc = transpile_package([sf_ov], empty_api_map(), default_recipes(), [ov_esc], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_ov_esc.blockers, 0)
  assert_eq(r_ov_esc.ffi_symbols.length(), 1)
  assert_true(
    r_ov_esc.ffi_symbols[0].emitted_c_symbol == "new_symbol",
    "escaped C symbol literal must decode to new_symbol in report",
  )

  let comp_esc = "extern \"C\" fn esc_greet() -> Ptr = \"pion_greet\\u{69}ng\"\n"
  let r_comp_esc = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("esc_ffi.pion", comp_esc, content_sha256(comp_esc))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_esc.blockers > 0, "companion with unicode-escaped C symbol colliding with bridged symbol must fail closed")

  // 7. Companion extern "C" fn with `{ body }` (omitted or explicit `= "<sym>"`) follows identical collision rule
  let comp_body_omitted = "extern \"C\" fn pion_greeting() -> Ptr {\n  ptr_null()\n}\n"
  let r_comp_body1 = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("body1.pion", comp_body_omitted, content_sha256(comp_body_omitted))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_body1.blockers > 0, "companion extern C fn with body and omitted = sym must collide fail-closed")

  let comp_body_explicit = "extern \"C\" fn other_body() -> Ptr = \"pion_greeting\" {\n  ptr_null()\n}\n"
  let r_comp_body2 = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("body2.pion", comp_body_explicit, content_sha256(comp_body_explicit))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_body2.blockers > 0, "companion extern C fn with body and explicit = sym must collide fail-closed")

  // 8. Comments inside scalar extern "C" parameter / return type annotations must be ignored when comparing signatures
  let comp_comment_sig = "extern \"C\" fn alias_inc(\n  // input integer\n  v : Int\n) ->\n  // host integer\n  Int = \"increment\"\n"
  let r_comp_comment = transpile_package_with_abis_and_companions(
    [sf_inc1],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("comment_sig.pion", comp_comment_sig, content_sha256(comp_comment_sig))],
    [],
    default_options(),
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_eq(r_comp_comment.blockers, 0)

  // 9. Pion lexer-aligned unknown escapes (`\C`, `\g`, `\w`, `\b`) in final `.pion` overlay & companion
  let ov_pion_esc = OverlaySpec::{
    id: "ov-pion-unknown-esc",
    source_file: "ov.mbt",
    decl_identity: anc.decl_identity,
    target: "native",
    normalized_source_cst_hash: anc.normalized_source_cst_hash,
    pre_overlay_generated_hash: anc.pre_overlay_generated_hash,
    replacement: "pub extern \"\\C\" fn value(x : Int) -> Int = \"ne\\w_sym\\bol\"",
    reason: "verify Pion lexer unknown escape decoding",
    behavior_test: "test_ov_pion_esc",
    upstream_issue_or_removal_condition: "none",
  }
  let r_ov_pion_esc = transpile_package([sf_ov], empty_api_map(), default_recipes(), [ov_pion_esc], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(r_ov_pion_esc.blockers, 0)
  assert_eq(r_ov_pion_esc.ffi_symbols.length(), 1)
  assert_true(
    r_ov_pion_esc.ffi_symbols[0].emitted_c_symbol == "new_symbol",
    "Pion unknown escapes \\w and \\b must decode to literal w and b (new_symbol)",
  )

  let comp_unknown_esc = "extern \"\\C\" fn u_greet() -> Ptr = \"pion_\\greeting\"\n"
  let r_comp_uesc = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("uesc.pion", comp_unknown_esc, content_sha256(comp_unknown_esc))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_comp_uesc.blockers > 0, "companion with \\C and \\g unknown escapes colliding with pion_greeting must fail closed")

  // 10. MoonBit `.mbt` source rejects escaped C function names (`"new_symb\u006fl"`) in both default and prefixed modes
  let sf_mbt_esc = SourceFile::{
    rel_path: "mbt_esc.mbt",
    content: "pub extern \"C\" fn value(x : Int) -> Int = \"new_symb\\u006fl\"\n",
    is_test: false,
  }
  let r_mbt_esc_def = transpile_package([sf_mbt_esc], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_mbt_esc_def.blockers > 0, "escaped C symbol in .mbt source must fail closed in default mode")
  let r_mbt_esc_pfx = transpile_package([sf_mbt_esc], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_mbt_esc_pfx.blockers > 0, "escaped C symbol in .mbt source must fail closed in prefixed mode")

  // 11. Collision diagnostic reports exact `.mbt` source line:col (line 3, NOT generated `.pion` line)
  let sf_lines = SourceFile::{
    rel_path: "test.mbt",
    content: "pub extern \"C\" fn g1() -> String = \"g1\"\npub extern \"C\" fn g2() -> String = \"g2\"\npub extern \"C\" fn same(x : Int) -> Int = \"pion_g1\"\n",
    is_test: false,
  }
  let r_lines = transpile_package([sf_lines], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_lines.blockers > 0, "line 3 scalar colliding with bridged pion_g1 must fail closed")
  let mut saw_exact_loc = false
  for d in r_lines.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && d.file == "test.mbt" && d.line == 3 && d.col == 1 {
      saw_exact_loc = true
    }
  }
  assert_true(saw_exact_loc, "collision diagnostic must report exact source location test.mbt:3:1")

  // 12. Companion with MoonBit keyword as valid Pion fn name (`suberror`) collides on same symbol and passes on distinct symbol
  let comp_suberr_col = "extern \"C\" fn suberror() -> Ptr = \"pion_greeting\"\n"
  let r_suberr_col = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("suberr_col.pion", comp_suberr_col, content_sha256(comp_suberr_col))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_true(r_suberr_col.blockers > 0, "companion extern C fn suberror colliding with pion_greeting must fail closed")

  let comp_suberr_ok = "extern \"C\" fn suberror() -> Ptr = \"distinct_sym\"\n"
  let r_suberr_ok = transpile_package_with_abis_and_companions(
    [sf_greet],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    [],
    [],
    [("suberr_ok.pion", comp_suberr_ok, content_sha256(comp_suberr_ok))],
    [],
    opts_pfx,
    [],
    false,
    fn(_) { "{\"ok\":true,\"diagnostics\":[]}" },
  )
  assert_eq(r_suberr_ok.blockers, 0)

  // 13. decode_pion_string_lit maps `\x80`..`\xFF` to U+E080..U+E0FF (valid UTF-8, matching pionc lexer)
  match (decode_pion_string_lit("\"val\\x80\""), decode_pion_string_lit("\"val\\u{e080}\"")) {
    (Ok(a), Ok(b)) => assert_true(a == b, "\\x80 must decode identically to \\u{e080}")
    _ => assert_true(false, "both \\x80 and \\u{e080} must decode cleanly")
  }

  // 14. InterpString in companion ABI (`"\{1}"`) or C symbol (`"pion_\{1}"`) must fail closed with MBT2PION_UNSUPPORTED_FFI_SIGNATURE
  let interp_diags1 : Array[Diag] = []
  let _ = collect_pion_extern_c_decls("i1.pion", "extern \"\\{1}\" fn bad_abi() -> Int = \"ok\"\n", interp_diags1)
  assert_true(
    interp_diags1.length() > 0 && interp_diags1[0].code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
    "InterpString in extern ABI must emit MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
  )
  let interp_diags2 : Array[Diag] = []
  let _ = collect_pion_extern_c_decls("i2.pion", "extern \"C\" fn bad_sym() -> Int = \"pion_\\{1}\"\n", interp_diags2)
  assert_true(
    interp_diags2.length() > 0 && interp_diags2[0].code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
    "InterpString in extern C symbol must emit MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
  )

  // 15. Original pre-preprocess line:col preserved even when multiline `impl Add for V with add(...)` precedes externs
  let sf_pre_lines = SourceFile::{
    rel_path: "pre.mbt",
    content: "pub struct V { x : Int }\npub impl Add for V with add(\n  self,\n  other\n) {\n  V::{ x: self.x + other.x }\n}\npub extern \"C\" fn g1() -> String = \"g1\"\npub extern \"C\" fn g2() -> String = \"g2\"\npub extern \"C\" fn same(x : Int) -> Int = \"pion_g1\"\n",
    is_test: false,
  }
  let r_pre_lines = transpile_package([sf_pre_lines], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_pre_lines.blockers > 0, "collision after multiline impl Add must fail closed")
  let mut saw_orig_line10 = false
  for d in r_pre_lines.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && d.file == "pre.mbt" && d.line == 10 && d.col == 1 {
      saw_orig_line10 = true
    }
  }
  assert_true(saw_orig_line10, "collision diagnostic must report original line 10:1 (not post-preprocess compressed line)")

  // 16. `#cfg` conditional compilation: inactive branch must not hijack original line:col (both orders)
  let sf_cfg1 = SourceFile::{
    rel_path: "cfg1.mbt",
    content: "pub extern \"C\" fn alpha() -> String = \"a\"\n#cfg(target=\"js\")\npub extern \"C\" fn same(x : Int) -> Int = \"spare\"\n#cfg(target=\"native\")\npub extern \"C\" fn same(x : Int) -> Int = \"pion_a\"\n",
    is_test: false,
  }
  let r_cfg1 = transpile_package([sf_cfg1], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_cfg1.blockers > 0, "native #cfg branch colliding with pion_a must fail closed")
  let mut saw_cfg1_l5 = false
  for d in r_cfg1.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && d.file == "cfg1.mbt" && d.line == 5 && d.col == 1 {
      saw_cfg1_l5 = true
    }
  }
  assert_true(saw_cfg1_l5, "#cfg(target=\"js\") first: native collision must report cfg1.mbt:5:1")

  let sf_cfg2 = SourceFile::{
    rel_path: "cfg2.mbt",
    content: "pub extern \"C\" fn alpha() -> String = \"a\"\n#cfg(target=\"native\")\npub extern \"C\" fn same(x : Int) -> Int = \"pion_a\"\n#cfg(target=\"js\")\npub extern \"C\" fn same(x : Int) -> Int = \"spare\"\n",
    is_test: false,
  }
  let r_cfg2 = transpile_package([sf_cfg2], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_cfg2.blockers > 0, "native #cfg branch first colliding with pion_a must fail closed")
  let mut saw_cfg2_l3 = false
  for d in r_cfg2.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && d.file == "cfg2.mbt" && d.line == 3 && d.col == 1 {
      saw_cfg2_l3 = true
    }
  }
  assert_true(saw_cfg2_l3, "#cfg(target=\"native\") first: native collision must report cfg2.mbt:3:1")

  // 17. Pion reserved keyword fn name (`val` -> `val_`) after multiline `impl Add` + `#cfg(js/native)` preserves original line:col
  let sf_val_cfg = SourceFile::{
    rel_path: "val_cfg.mbt",
    content: "pub struct V { x : Int }\npub impl Add for V with add(\n  self,\n  other\n) {\n  V::{ x: self.x + other.x }\n}\npub extern \"C\" fn alpha() -> String = \"a\"\n#cfg(target=\"js\")\npub extern \"C\" fn val(x : Int) -> Int = \"spare\"\n#cfg(target=\"native\")\npub extern \"C\" fn val(x : Int) -> Int = \"pion_a\"\n",
    is_test: false,
  }
  let r_val_cfg = transpile_package([sf_val_cfg], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r_val_cfg.blockers > 0, "keyword-renamed fn val colliding with pion_a must fail closed")
  let mut saw_val_l12 = false
  for d in r_val_cfg.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" && d.file == "val_cfg.mbt" && d.line == 12 && d.col == 1 {
      saw_val_l12 = true
    }
  }
  assert_true(saw_val_l12, "keyword-renamed fn val collision must report original val_cfg.mbt:12:1")
}
