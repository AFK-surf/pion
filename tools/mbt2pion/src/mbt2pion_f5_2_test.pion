///| Unit tests for generic C-ABI FFI bridge lowering, application-pattern lowerings,
///| string-keyed map patterns in `if`/`guard ... is` chains, and builtin compat ABI schemas.

test "lower_ffi: direct scalar extern C passes through unchanged" {
  let used : Map[String, Bool] = Map()
  let r = try_lower_extern_c_fn(
    "pub ",
    "host_now",
    "a : Int, b : Double",
    " -> Double",
    "\"c_host_now\"",
    [],
    used,
  )
  assert_true(r.ok, "scalar C FFI must succeed")
  assert_true(!r.needs_bridge, "scalar C FFI must not emit wrapper")
  assert_true(
    r.code == "pub extern \"C\" fn host_now(a : Int, b : Double) -> Double = \"c_host_now\"",
    "scalar C FFI code mismatch",
  )
}

test "lower_ffi: borrowed String and Bytes params lower to Ptr+Int bridge with zero leaks" {
  let used : Map[String, Bool] = Map()
  let r1 = try_lower_extern_c_fn(
    "",
    "ffi_start",
    "data_dir : String, cloud : String, beta : Int",
    " -> Int",
    "\"c_start\"",
    ["#borrow(data_dir, cloud)"],
    used,
  )
  assert_true(r1.ok, "String borrow bridge must succeed")
  assert_true(r1.needs_bridge, "String param must emit bridge")
  assert_true(
    str_has(
      r1.code,
      "extern \"C\" fn __mbt_c_ffi_ffi_start(data_dir_ptr : Ptr, data_dir_len : Int, cloud_ptr : Ptr, cloud_len : Int, beta : Int) -> Int = \"pion_c_start\"",
    ),
    "must emit C-ABI extern decl with explicit shim prefix",
  )
  assert_true(
    str_has(
      r1.code,
      "data_dir.as_cstr(), data_dir.to_bytes().length(), cloud.as_cstr(), cloud.to_bytes().length(), beta",
    ),
    "must pass as_cstr + UTF-8 byte length via to_bytes().length()",
  )

  let r2 = try_lower_extern_c_fn(
    "",
    "ffi_send_bytes",
    "payload : String, data : Bytes",
    " -> Unit",
    "\"c_send_bytes\"",
    ["#borrow(payload, data)"],
    used,
  )
  assert_true(r2.ok, "String+Bytes borrow bridge must succeed")
  assert_true(str_has(r2.code, "bytes_copy_to_ptr(data, 0,"), "must copy Bytes to raw buffer")
  assert_true(str_has(r2.code, "ptr_free("), "must free temporary Bytes buffer")
}

test "lower_ffi: String and Bytes return types lower to cstr_to_str and bytes_from_ptr" {
  let used : Map[String, Bool] = Map()
  let rs = try_lower_extern_c_fn(
    "pub ",
    "ffi_scheme",
    "",
    " -> String",
    "\"c_scheme\"",
    [],
    used,
  )
  assert_true(rs.ok, "String return bridge must succeed")
  assert_true(str_has(rs.code, "-> Ptr = \"pion_c_scheme\""), "underlying extern returns Ptr with shim prefix")
  assert_true(str_has(rs.code, "if ptr_is_null("), "wrapper guards NULL Ptr before cstr_to_str")
  assert_true(str_has(rs.code, "cstr_to_str("), "wrapper converts Ptr via cstr_to_str")

  let rb = try_lower_extern_c_fn(
    "",
    "ffi_read_buf",
    "tag : String",
    " -> Bytes",
    "\"c_read_buf\"",
    ["#borrow(tag)"],
    used,
  )
  assert_true(rb.ok, "Bytes return bridge must succeed")
  assert_true(str_has(rb.code, "__out_len : Ptr) -> Ptr = \"pion_c_read_buf\""), "Bytes return appends out_len Ptr with shim prefix")
  assert_true(str_has(rb.code, "ptr_read_i32("), "wrapper reads out_len")
  assert_true(str_has(rb.code, "if ptr_is_null(") && str_has(rb.code, "<= 0 { \"\".to_bytes() }"), "wrapper guards NULL Ptr or non-positive len")
  assert_true(str_has(rb.code, "bytes_from_ptr("), "wrapper builds Bytes via bytes_from_ptr")
  assert_true(str_has(rb.code, "ptr_free("), "wrapper frees out_len box")
}

test "lower_ffi: fail-closed on invalid attributes, unannotated or owned params, or unsupported types" {
  let used : Map[String, Bool] = Map()
  let bad_attr = try_lower_extern_c_fn("", "f1", "x : Int", " -> Int", "\"c_f1\"", ["#unknown(x)"], used)
  assert_true(!bad_attr.ok, "unknown FFI attribute must fail closed")

  let bad_param = try_lower_extern_c_fn("", "f2", "x : String", " -> Int", "\"c_f2\"", ["#borrow(missing)"], used)
  assert_true(!bad_param.ok, "borrow referencing unknown param must fail closed")

  let bad_scalar = try_lower_extern_c_fn("", "f3", "x : Int", " -> Int", "\"c_f3\"", ["#borrow(x)"], used)
  assert_true(!bad_scalar.ok, "borrow on scalar Int must fail closed")

  let bad_owned = try_lower_extern_c_fn("", "f4", "s : String", " -> Int", "\"c_f4\"", ["#owned(s)"], used)
  assert_true(!bad_owned.ok, "#owned attribute must fail closed")

  let bad_unannotated_str = try_lower_extern_c_fn("", "f4b", "s : String", " -> Int", "\"c_f4b\"", [], used)
  assert_true(!bad_unannotated_str.ok, "unannotated String param (default owned) must fail closed")

  let bad_unannotated_bytes = try_lower_extern_c_fn("", "f4c", "b : Bytes", " -> Int", "\"c_f4c\"", [], used)
  assert_true(!bad_unannotated_bytes.ok, "unannotated Bytes param (default owned) must fail closed")

  let bad_ty = try_lower_extern_c_fn("", "f5", "xs : Array[Int]", " -> Int", "\"c_f5\"", [], used)
  assert_true(!bad_ty.ok, "unsupported Array param must fail closed")

  let bad_ret = try_lower_extern_c_fn("", "f6", "x : Int", " -> Option[Int]", "\"c_f6\"", [], used)
  assert_true(!bad_ret.ok, "unsupported Option return must fail closed")

  let bad_ret_nospace = try_lower_extern_c_fn("", "f6b", "x : Int", "-> Option[Int]", "\"c_f6b\"", [], used)
  assert_true(!bad_ret_nospace.ok, "non-spaced -> Option[Int] return must fail closed")

  let bad_ret_malformed = try_lower_extern_c_fn("", "f6c", "x : Int", "Int", "\"c_f6c\"", [], used)
  assert_true(!bad_ret_malformed.ok, "malformed return annotation without -> must fail closed")

  let bad_ret_empty = try_lower_extern_c_fn("", "f6d", "x : Int", "-> ", "\"c_f6d\"", [], used)
  assert_true(!bad_ret_empty.ok, "empty return type after -> must fail closed")

  let bad_pname = try_lower_extern_c_fn("", "f7", "x~ : Int", " -> Int", "\"c_f7\"", [], used)
  assert_true(!bad_pname.ok, "labeled/non-ident param name must fail closed")

  let bad_dup = try_lower_extern_c_fn("", "f8", "x : Int, x : Int", " -> Int", "\"c_f8\"", [], used)
  assert_true(!bad_dup.ok, "duplicate param name must fail closed")

  let bad_sym = try_lower_extern_c_fn("", "f9", "x : Int", " -> Int", "c_f9", [], used)
  assert_true(!bad_sym.ok, "non-quoted C symbol literal must fail closed")

  let bad_pfx = try_lower_extern_c_fn_with_prefix("", "f10", "s : String", " -> Int", "\"c_f10\"", ["#borrow(s)"], used, "")
  assert_true(!bad_pfx.ok, "empty shim_prefix on bridged FFI must fail closed")

  let bad_pfx_digit = try_lower_extern_c_fn_with_prefix("", "f11", "s : String", " -> Int", "\"c_f11\"", ["#borrow(s)"], used, "9pion_")
  assert_true(!bad_pfx_digit.ok, "digit-leading shim_prefix must fail closed")

  let bad_pfx_dash = try_lower_extern_c_fn_with_prefix("", "f12", "s : String", " -> Int", "\"c_f12\"", ["#borrow(s)"], used, "pion-bad_")
  assert_true(!bad_pfx_dash.ok, "hyphenated shim_prefix must fail closed")
}

test "lower_ffi: C-ABI param collision avoidance and verbatim oracle alignment" {
  let used1 : Map[String, Bool] = Map()
  let col1 = try_lower_extern_c_fn(
    "",
    "send_col",
    "data : Bytes, data_len : Int",
    " -> Int",
    "\"c_send_col\"",
    ["#borrow(data)"],
    used1,
  )
  assert_true(col1.ok, "data + data_len collision must resolve cleanly")
  assert_true(
    str_has(col1.code, "extern \"C\" fn __mbt_c_ffi_send_col(data_ptr : Ptr, data_len_1 : Int, data_len : Int) -> Int = \"pion_c_send_col\""),
    "synthesized data_len must avoid colliding with direct param data_len",
  )

  let used2 : Map[String, Bool] = Map()
  let col2 = try_lower_extern_c_fn(
    "",
    "read_col",
    "__out_len : Int",
    " -> Bytes",
    "\"c_read_col\"",
    [],
    used2,
  )
  assert_true(col2.ok, "__out_len direct param + Bytes return must resolve cleanly")
  assert_true(
    str_has(col2.code, "extern \"C\" fn __mbt_c_ffi_read_col(__out_len : Int, __out_len_1 : Ptr) -> Ptr = \"pion_c_read_col\""),
    "synthesized __out_len must avoid colliding with direct param __out_len",
  )

  // Wrapper local temp must never shadow source parameter `__ffi_data_len`
  let used4 : Map[String, Bool] = Map()
  let sh = try_lower_extern_c_fn(
    "",
    "pick",
    "data : Bytes, __ffi_data_len : Int",
    " -> Int",
    "\"demo_pick\"",
    ["#borrow(data)"],
    used4,
  )
  assert_true(sh.ok, "pick(data, __ffi_data_len) must lower cleanly")
  assert_true(
    str_has(sh.code, "let __ffi_data_len_1 = data.length()"),
    "wrapper local must rename to __ffi_data_len_1 to avoid shadowing param",
  )
  assert_true(
    str_has(sh.code, "__mbt_c_ffi_pick(__ffi_data_buf, __ffi_data_len_1, __ffi_data_len)"),
    "C call must pass __ffi_data_len_1 as bytes len and original __ffi_data_len as 3rd arg",
  )

  // Verbatim alignment check with run_f5_2_oracle.py FFI_BRIDGE_PION
  let used3 : Map[String, Bool] = Map()
  let v1 = try_lower_extern_c_fn(
    "",
    "ffi_start",
    "data_dir : String, cloud : String, beta : Int",
    " -> Int",
    "\"demo_start\"",
    ["#borrow(data_dir, cloud)"],
    used3,
  )
  let expected_v1 = "extern \"C\" fn __mbt_c_ffi_ffi_start(data_dir_ptr : Ptr, data_dir_len : Int, cloud_ptr : Ptr, cloud_len : Int, beta : Int) -> Int = \"pion_demo_start\"\nfn ffi_start(data_dir : String, cloud : String, beta : Int) -> Int {\n  let __ffi_res = __mbt_c_ffi_ffi_start(data_dir.as_cstr(), data_dir.to_bytes().length(), cloud.as_cstr(), cloud.to_bytes().length(), beta)\n  __ffi_res\n}"
  assert_true(v1.ok && v1.code == expected_v1, "verbatim output for ffi_start must match oracle")
}

test "lower_apps: builtin ctor rest arity, char ranges, split-next, array-concat, and map patterns" {
  assert_true(expand_builtin_ctor_rest("Number", 1) is None, "unqualified Number must NOT match unconditionally")
  assert_true(lookup_mbt_json_unqualified_ctor_arity("Number") is Some(2), "qualified-context MbtJson::Number arity is 2")
  assert_true(expand_builtin_ctor_rest("Json::Number", 1) is Some(1), "Json::Number(d, ..) needs 1 wildcard")
  assert_true(expand_builtin_ctor_rest("MbtJson::Number", 2) is Some(0), "MbtJson::Number(d, r, ..) needs 0 wildcards")
  assert_true(expand_builtin_ctor_rest("Json::Number", 3) is None, "over-arity Json::Number must fail closed")
  assert_true(expand_builtin_ctor_rest("UnknownCtor", 1) is None, "unknown ctor must fail closed")

  let toks = lex_moonbit("'0'..='9' | 'a'..<'g' | '_'")
  match lower_char_range_arm_pat(toks, 0, toks.length() - 1, "__ch") {
    Some((bv, cond)) => {
      assert_true(bv == "__ch", "bind_var mismatch")
      assert_true(
        cond == "(__ch >= '0' && __ch <= '9') || (__ch >= 'a' && __ch < 'g') || (__ch == '_')",
        "char range cond mismatch",
      )
    }
    None => assert_true(false, "char range pattern must lower")
  }

  let trailing_pipe = lex_moonbit("'0'..='9' |")
  assert_true(
    lower_char_range_arm_pat(trailing_pipe, 0, trailing_pipe.length() - 1, "__ch") is None,
    "trailing dangling pipe must fail closed",
  )
  let leading_pipe = lex_moonbit("| '0'..='9'")
  assert_true(
    lower_char_range_arm_pat(leading_pipe, 0, leading_pipe.length() - 1, "__ch") is None,
    "leading dangling pipe must fail closed",
  )

  let non_range = lex_moonbit("'x'")
  assert_true(
    lower_char_range_arm_pat(non_range, 0, non_range.length() - 1, "__ch") is None,
    "plain char literal without range must return None",
  )

  let sn = lower_string_split_next("key", "\"/\"", "__sp")
  assert_true(str_has(sn, "if __sp.length() > 0 { Some(__sp[0]) } else { None }"), "split().next() must lower safely")

  let ac = lower_array_concat_expr("xs", "ys", "__ac")
  assert_true(str_has(ac, "(xs).copy(); __ac.append(ys); __ac"), "Array concat must copy and append")

  assert_true(is_string_to_owned_method("to_owned", "String"), "String::to_owned recognized")
  assert_true(is_string_to_owned_method("to_owned", "StrView"), "StrView::to_owned recognized")
  assert_true(!is_string_to_owned_method("to_owned", "Bytes"), "non-String to_owned rejected")

  let mp = lower_string_map_pattern_chain(
    "obj",
    [("\"a\"", "x", false), ("\"b\"", "opt_y", true)],
    "x",
    "0",
  )
  assert_true(
    str_has(mp, "match obj.get(\"a\") { Some(x) => { let opt_y = obj.get(\"b\"); x }, _ => 0 }"),
    "map pattern chain must nest deterministically",
  )
}

test "lower_is_chain: string-keyed map patterns inside if/guard is chains" {
  let src = "pub fn lookup_pair(m : Map[String, Int]) -> Int {\n  if m is { \"x\": a, \"y\": b, .. } && a > 0 {\n    a + b\n  } else {\n    -1\n  }\n}\n\npub fn guard_opt_key(m : Map[String, Int]) -> Int {\n  guard m is { \"k\": v, \"opt\"?: ov, .. } else {\n    return 0\n  }\n  match ov {\n    Some(w) => v + w\n    None => v\n  }\n}\n"
  let sf = SourceFile::{ rel_path: "map_is.mbt", content: src, is_test: false }
  let res = transpile_package([sf], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(res.blockers, 0)
  assert_true(res.files.length() == 1, "expected 1 output file")
  let out = res.files[0].content
  assert_true(str_has(out, ".get(\"x\")"), "must lower string key x via .get(\"x\")")
  assert_true(str_has(out, ".get(\"y\")"), "must lower string key y via .get(\"y\")")
  assert_true(str_has(out, ".get(\"opt\")"), "must lower optional string key via .get(\"opt\")")
}

test "abi: builtin_mbt_compat_enum_schemas exposes canonical MbtJson::Number arity 2" {
  let schemas = builtin_mbt_compat_enum_schemas()
  assert_eq(schemas.length(), 1)
  assert_true(schemas[0].pkg == "mbt_compat", "pkg mismatch")
  assert_true(schemas[0].name == "MbtJson", "name mismatch")
  let mut num_arity = -1
  for v in schemas[0].variants {
    if v.name == "Number" {
      num_arity = v.fields.length()
    }
  }
  assert_eq(num_arity, 2)
}

test "stage_a_ffi: default empty prefix stays fail-closed, opt-in prefix lowers bridged extern C and preserves direct scalars" {
  let src = "pub extern \"C\" fn raw_add(a : Int, b : Int) -> Int = \"c_raw_add\"\n\n#borrow(msg, data)\npub extern \"C\" fn send_msg(msg : String, data : Bytes, tag : Int) -> Int = \"c_send_msg\"\n\npub extern \"C\" fn get_name() -> String = \"c_get_name\"\n"
  let sf = SourceFile::{ rel_path: "ffi_mod.mbt", content: src, is_test: false }

  // 1. Default (ffi_shim_prefix == "") must fail closed on bridged extern C
  let res_def = transpile_package([sf], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(res_def.blockers > 0, "default empty ffi_shim_prefix must block bridged extern C")
  let mut has_ffi_err = false
  for d in res_def.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_FFI_SIGNATURE" {
      has_ffi_err = true
    }
  }
  assert_true(has_ffi_err, "must emit MBT2PION_UNSUPPORTED_FFI_SIGNATURE by default")

  // 2. Opt-in ffi_shim_prefix == "pion_" must lower cleanly with 0 blockers
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  let res_ok = transpile_package([sf], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(res_ok.blockers, 0)
  assert_eq(res_ok.files.length(), 1)
  let out = res_ok.files[0].content
  assert_true(
    str_has(out, "pub extern \"C\" fn raw_add(a : Int, b : Int) -> Int = \"c_raw_add\""),
    "direct scalar extern C must keep original C symbol without prefix",
  )
  assert_true(
    str_has(out, "extern \"C\" fn __mbt_c_ffi_send_msg(msg_ptr : Ptr, msg_len : Int, data_ptr : Ptr, data_len : Int, tag : Int) -> Int = \"pion_c_send_msg\""),
    "bridged extern C must use prefixed C symbol",
  )
  assert_true(
    str_has(out, "extern \"C\" fn __mbt_c_ffi_get_name() -> Ptr = \"pion_c_get_name\""),
    "String return extern C must use prefixed C symbol",
  )
  assert_eq(res_ok.ffi_symbols.length(), 3)
  assert_true(res_ok.ffi_symbols[0].fn_name == "raw_add" && res_ok.ffi_symbols[0].raw_c_symbol == "c_raw_add" && res_ok.ffi_symbols[0].emitted_c_symbol == "c_raw_add" && !res_ok.ffi_symbols[0].bridged, "scalar symbol mapping mismatch")
  assert_true(res_ok.ffi_symbols[1].fn_name == "send_msg" && res_ok.ffi_symbols[1].raw_c_symbol == "c_send_msg" && res_ok.ffi_symbols[1].emitted_c_symbol == "pion_c_send_msg" && res_ok.ffi_symbols[1].bridged, "bridged send_msg mapping mismatch")
  assert_true(res_ok.ffi_symbols[2].fn_name == "get_name" && res_ok.ffi_symbols[2].raw_c_symbol == "c_get_name" && res_ok.ffi_symbols[2].emitted_c_symbol == "pion_c_get_name" && res_ok.ffi_symbols[2].bridged, "bridged get_name mapping mismatch")

  let rep = render_migration_report_json(res_ok, opts_pfx)
  assert_true(str_has(rep, "\"ffi_shim_prefix\":\"pion_\""), "migration report must include ffi_shim_prefix")
  assert_true(str_has(rep, "\"emitted_c_symbol\":\"pion_c_send_msg\""), "migration report must include ffi_symbols table")
}

test "stage_a_ffi: package-wide C symbol collision fails closed in both declaration orders" {
  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  // Order 1: direct scalar `"pion_foo"` before bridged `"foo"`
  let src1 = "extern \"C\" fn raw_foo(x : Int) -> Int = \"pion_foo\"\n#borrow(s)\nextern \"C\" fn bridged_foo(s : String) -> Int = \"foo\"\n"
  let r1 = transpile_package([SourceFile::{ rel_path: "c1.mbt", content: src1, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r1.blockers > 0, "direct then bridged symbol collision must fail closed")

  // Order 2: bridged `"foo"` before direct scalar `"pion_foo"`
  let src2 = "#borrow(s)\nextern \"C\" fn bridged_foo(s : String) -> Int = \"foo\"\nextern \"C\" fn raw_foo(x : Int) -> Int = \"pion_foo\"\n"
  let r2 = transpile_package([SourceFile::{ rel_path: "c2.mbt", content: src2, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r2.blockers > 0, "bridged then direct symbol collision must fail closed")

  // Order 3: two bridged functions emitting same prefixed C symbol
  let src3 = "#borrow(s)\nextern \"C\" fn f_a(s : String) -> Int = \"dup\"\n#borrow(s)\nextern \"C\" fn f_b(s : String) -> Int = \"dup\"\n"
  let r3 = transpile_package([SourceFile::{ rel_path: "c3.mbt", content: src3, is_test: false }], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(r3.blockers > 0, "duplicate bridged C symbol must fail closed")
}

test "abi: ffi_shim_prefix enters abi_sha256 when non-empty and stays backward-compatible when empty" {
  let base_abi = empty_package_abi("demo")
  let base_payload = render_canonical_abi_payload(base_abi)
  assert_true(!str_has(base_payload, "ffi_shim_prefix"), "empty ffi_shim_prefix must be omitted for backward-compatible abi_sha256")
  let sha_empty = compute_abi_payload_sha256(base_abi)

  let pfx_abi = PackageAbi::{
    package_name: "demo",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    ffi_shim_prefix: "pion_",
    publishable: true,
  }
  let pfx_payload = render_canonical_abi_payload(pfx_abi)
  assert_true(str_has(pfx_payload, "\"ffi_shim_prefix\":\"pion_\""), "non-empty ffi_shim_prefix must appear in canonical ABI payload")
  let sha_pion = compute_abi_payload_sha256(pfx_abi)
  assert_true(sha_pion != sha_empty, "non-empty ffi_shim_prefix must change abi_sha256")

  let alt_abi = PackageAbi::{
    package_name: "demo",
    enums: [],
    struct_val_fields: [],
    structs: None,
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    ffi_shim_prefix: "alt_",
    publishable: true,
  }
  assert_true(compute_abi_payload_sha256(alt_abi) != sha_pion, "different ffi_shim_prefix must produce distinct abi_sha256")

  // Round-trip through render_abi_json + verify_and_parse_dep_abi
  let hdr = "// abi-sha256: " + sha_pion + "\npub fn f() -> Int { 1 }\n"
  let pfiles = [("a.pion", hdr)]
  let raw_json = render_abi_json(pfx_abi, pfiles)
  let diags : Array[Diag] = []
  match verify_and_parse_dep_abi("demo", "/tmp/demo", pfiles, Some(raw_json), diags) {
    Some(parsed) => {
      assert_eq(diags.length(), 0)
      assert_true(parsed.ffi_shim_prefix == "pion_", "parsed ABI must preserve ffi_shim_prefix")
    }
    None => assert_true(false, "valid ABI with ffi_shim_prefix must verify cleanly")
  }

  // Tampered invalid ffi_shim_prefix in mbt2pion_abi.json must fail closed
  let bad_json = str_replace_all(raw_json, "\"pion_\"", "\"123-bad\"")
  let bad_diags : Array[Diag] = []
  let bad_res = verify_and_parse_dep_abi("demo", "/tmp/demo", pfiles, Some(bad_json), bad_diags)
  assert_true(bad_res is None && bad_diags.length() > 0, "tampered invalid ffi_shim_prefix in ABI must fail closed")
}
