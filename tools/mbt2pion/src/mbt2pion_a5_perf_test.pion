///| Wave M2-F3a unit tests: Stage A.5 algorithmic speedups must stay byte-for-byte equivalent to
///| the previous quadratic reference implementations (kept below as `ref_*` oracles):
///| stable merge sort, `apply_byte_edits`, `sort_probe_results`, `remap_safe_offsets`, the
///| per-round probe result indexes (1-to-1 tagged match + untagged nearest-column fallback) and
///| the per-site fresh copy of the lexed identifier set.

fn perf_lcg_next(state : Array[Int]) -> Int {
  // 31-bit LCG; deterministic across platforms.
  let next = (state[0] * 1103515245 + 12345) & 2147483647
  state[0] = next
  next / 65536
}

fn perf_rand(state : Array[Int], bound : Int) -> Int {
  perf_lcg_next(state) % bound
}

fn ref_insertion_sort_edits(edits : Array[(Int, Int, String)]) -> Array[(Int, Int, String)] {
  let sorted : Array[(Int, Int, String)] = []
  for e in edits {
    sorted.push(e)
  }
  let mut i = 1
  while i < sorted.length() {
    let key = sorted[i]
    let mut j = i - 1
    while j >= 0 && sorted[j].0 > key.0 {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = key
    i = i + 1
  }
  sorted
}

fn ref_apply_byte_edits(src : String, edits : Array[(Int, Int, String)]) -> String {
  if edits.length() == 0 {
    return src
  }
  let sorted = ref_insertion_sort_edits(edits)
  let sb = StringBuilder()
  let mut cursor = 0
  for e in sorted {
    if e.0 >= cursor && e.1 <= src.length() {
      sb.write_string(src.slice(cursor, e.0))
      sb.write_string(e.2)
      cursor = e.1
    }
  }
  if cursor < src.length() {
    sb.write_string(src.slice(cursor, src.length()))
  }
  sb.to_string()
}

fn ref_sort_probe_results(xs : Array[ProbeResult]) -> Array[ProbeResult] {
  let out : Array[ProbeResult] = []
  for x in xs {
    out.push(x)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 {
      let c = str_cmp(out[j].file, key.file)
      let gt = if c != 0 {
        c > 0
      } else if out[j].line != key.line {
        out[j].line > key.line
      } else {
        out[j].col > key.col
      }
      if gt {
        out[j + 1] = out[j]
        j = j - 1
      } else {
        break
      }
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn ref_remap_safe_offsets(
  src : String,
  old_safe : Array[Int],
  edits : Array[(Int, Int, String, String, String)],
) -> (Array[Int], Map[Int, Bool]) {
  let sorted : Array[(Int, Int, String, String, String)] = []
  for e in edits {
    sorted.push(e)
  }
  let mut i = 1
  while i < sorted.length() {
    let key = sorted[i]
    let mut j = i - 1
    while j >= 0 && sorted[j].0 > key.0 {
      sorted[j + 1] = sorted[j]
      j = j - 1
    }
    sorted[j + 1] = key
    i = i + 1
  }
  let new_list : Array[Int] = []
  let new_map : Map[Int, Bool] = Map()
  for pos in old_safe {
    let mut delta = 0
    let mut mapped = -1
    let mut inside = false
    for e in sorted {
      let s = e.0
      let en = e.1
      let repl = e.2
      let lhs_e = e.3
      let rhs_e = e.4
      if pos < s {
        mapped = pos + delta
        inside = true
        break
      }
      if pos >= s && pos < en {
        inside = true
        let orig_slice = src.slice(s, en)
        let new_edit_start = s + delta
        if lhs_e.length() > 0 {
          let l_old = orig_slice.index_of(lhs_e)
          let l_new = repl.index_of(lhs_e)
          if l_old >= 0 && l_new >= 0 && pos >= s + l_old && pos < s + l_old + lhs_e.length() {
            mapped = new_edit_start + l_new + (pos - (s + l_old))
          }
        }
        if mapped < 0 && rhs_e.length() > 0 {
          let r_old = orig_slice.index_of(rhs_e)
          let r_new = repl.index_of(rhs_e)
          if r_old >= 0 && r_new >= 0 && pos >= s + r_old && pos < s + r_old + rhs_e.length() {
            mapped = new_edit_start + r_new + (pos - (s + r_old))
          }
        }
        break
      }
      delta = delta + repl.length() - (en - s)
    }
    if !inside {
      mapped = pos + delta
    }
    if mapped >= 0 && !new_map.contains(mapped) {
      new_map[mapped] = true
      new_list.push(mapped)
    }
  }
  (new_list, new_map)
}

fn perf_same_ints(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut i = 0
  while i < a.length() {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  true
}

fn perf_count(hay : String, needle : String) -> Int {
  let mut n = 0
  let mut rest = hay
  while true {
    let i = rest.index_of(needle)
    if i < 0 {
      break
    }
    n = n + 1
    rest = rest.slice(i + needle.length(), rest.length())
  }
  n
}

test "f3a-1: stable merge sort equals stable insertion sort (heavy duplicate keys)" {
  let st = [7]
  let mut trial = 0
  while trial < 60 {
    let n = perf_rand(st, 90)
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    while i < n {
      let k = perf_rand(st, 9)
      edits.push((k, k + perf_rand(st, 3), "t" + i.to_string()))
      i = i + 1
    }
    let got = stable_merge_sort_a5(edits, fn(a : (Int, Int, String), b : (Int, Int, String)) -> Bool { a.0 > b.0 })
    let want = ref_insertion_sort_edits(edits)
    assert_eq(got.length(), want.length())
    let mut j = 0
    while j < got.length() {
      assert_eq(got[j].0, want[j].0)
      assert_eq(got[j].1, want[j].1)
      assert_true(got[j].2 == want[j].2, "stable tie order")
      j = j + 1
    }
    // the input array is left untouched
    if n > 0 {
      assert_true(edits[0].2 == "t0", "input untouched")
    }
    trial = trial + 1
  }
  let one = stable_merge_sort_a5([(3, 3, "x")], fn(a : (Int, Int, String), b : (Int, Int, String)) -> Bool { a.0 > b.0 })
  assert_eq(one.length(), 1)
  let none : Array[(Int, Int, String)] = []
  assert_eq(stable_merge_sort_a5(none, fn(a : (Int, Int, String), b : (Int, Int, String)) -> Bool { a.0 > b.0 }).length(), 0)
}

test "f3a-2: sort_probe_results matches the insertion-sort order including ties" {
  let files = ["a.pion", "a", "ab.pion", "b.pion", "dir/a.pion", ""]
  let st = [11]
  let mut trial = 0
  while trial < 40 {
    let n = perf_rand(st, 70)
    let xs : Array[ProbeResult] = []
    let mut i = 0
    while i < n {
      xs.push(ProbeResult::{
        file: files[perf_rand(st, files.length())],
        line: perf_rand(st, 4),
        col: perf_rand(st, 4),
        probe_kind: "mbt_len_probe",
        probe_id: "p" + i.to_string(),
        resolved_type: "Int",
      })
      i = i + 1
    }
    let got = sort_probe_results(xs)
    let want = ref_sort_probe_results(xs)
    assert_eq(got.length(), want.length())
    let mut j = 0
    while j < got.length() {
      assert_true(got[j].probe_id == want[j].probe_id, "probe result order")
      j = j + 1
    }
    trial = trial + 1
  }
}

test "f3a-3: apply_byte_edits on shuffled, overlapping and out-of-range edits equals reference" {
  let st = [23]
  let src = "let alpha = beta.length() + gamma[3] / delta % 7; fn f(x : Int) -> Int { x }\n"
  let mut trial = 0
  while trial < 200 {
    let n = perf_rand(st, 12)
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    while i < n {
      let s = perf_rand(st, src.length() + 3)
      let e = s + perf_rand(st, 6)
      edits.push((s, e, "<" + i.to_string() + ">"))
      i = i + 1
    }
    assert_true(apply_byte_edits(src, edits) == ref_apply_byte_edits(src, edits), "apply_byte_edits trial " + trial.to_string())
    trial = trial + 1
  }
}

test "f3a-4: remap_safe_offsets equals reference (unsorted edits, nested lhs/rhs, boundaries, out-of-range)" {
  let src = "aa xs[i] bb ys.length() cc p / q dd zz % ww ee\n"
  // Deterministic hand case: offsets before, at the start of, inside lhs, inside rhs, inside the
  // rewritten glue, exactly at the end of an edit and past the end of the source, unsorted edits.
  let e1 = (3, 8, "mbt_compat::arr_get(xs, i)", "xs", "i")
  let e2 = (12, 23, "ys.length()", "ys", "")
  let e3 = (27, 32, "mbt_compat::div_int(p, q)", "p", "q")
  let hand_edits = [e3, e1, e2]
  let hand_pos = [0, 2, 3, 4, 6, 7, 8, 12, 13, 26, 27, 29, 31, 32, 40, 200, -1, 3, 31]
  let (gl, gm) = remap_safe_offsets(src, hand_pos, hand_edits)
  let (wl, wm) = ref_remap_safe_offsets(src, hand_pos, hand_edits)
  assert_true(perf_same_ints(gl, wl), "hand case list")
  assert_eq(gm.length(), wm.length())
  for k in wl {
    assert_true(gm.contains(k), "hand case map")
  }
  // Randomized differential: random (possibly overlapping / zero-width / inverted) edits whose
  // replacements embed the original lhs/rhs at shifted positions.
  let st = [97]
  let mut trial = 0
  while trial < 300 {
    let ne = perf_rand(st, 8)
    let edits : Array[(Int, Int, String, String, String)] = []
    let mut i = 0
    while i < ne {
      let s = perf_rand(st, src.length())
      let span = perf_rand(st, 9)
      let en = if perf_rand(st, 10) == 0 { s - 1 } else if s + span <= src.length() { s + span } else { src.length() }
      let orig = if en > s { src.slice(s, en) } else { "" }
      let lhs = if orig.length() >= 2 { orig.slice(0, 2) } else { orig }
      let rhs = if orig.length() >= 3 { orig.slice(orig.length() - 1, orig.length()) } else { "" }
      let repl = if perf_rand(st, 2) == 0 { "f(" + lhs + ", " + rhs + ")" } else { "{" + rhs + "}" }
      edits.push((s, en, repl, lhs, rhs))
      i = i + 1
    }
    let np = perf_rand(st, 25)
    let poss : Array[Int] = []
    let mut j = 0
    while j < np {
      poss.push(perf_rand(st, src.length() + 6) - 2)
      j = j + 1
    }
    let (rl, rm) = remap_safe_offsets(src, poss, edits)
    let (fl, fm) = ref_remap_safe_offsets(src, poss, edits)
    assert_true(perf_same_ints(rl, fl), "random remap list trial " + trial.to_string())
    assert_eq(rm.length(), fm.length())
    trial = trial + 1
  }
  // No edits: identity (deduplicated, first-seen order).
  let no_edits : Array[(Int, Int, String, String, String)] = []
  let (il, _) = remap_safe_offsets(src, [5, 1, 5, 9], no_edits)
  assert_true(perf_same_ints(il, [5, 1, 9]), "identity remap without edits")
}

test "f3a-5: tagged probe results match 1-to-1 by probe id regardless of diagnostic order" {
  // Three same-line `.length()` probes whose (tagged) diagnostics come back in reverse order and
  // carry unrelated positions: each site must take its own id's type.
  let src = "pub fn f(a : String, b : Array[Int], c : Bytes) -> Int { a.length() + b.length() + c.length() }\n"
  let mock = fn(batch : Array[(String, String)]) -> String {
    let body = batch[0].1
    let ids : Array[String] = []
    let mut rest = body
    while true {
      let i = rest.index_of("mbt_len_probe__")
      if i < 0 {
        break
      }
      let after = rest.slice(i + 15, rest.length())
      let close = after.index_of("(")
      ids.push(after.slice(0, close))
      rest = after
    }
    let tys = ["String", "Array[Int]", "Bytes"]
    let sb = StringBuilder()
    sb.write_string("{\"ok\":false,\"diagnostics\":[")
    let mut k = ids.length() - 1
    while k >= 0 {
      if k < ids.length() - 1 {
        sb.write_string(",")
      }
      sb.write_string(
        "{\"file\":\"t.pion\",\"line\":9,\"col\":1,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe__" +
        ids[k] + "` on type `" + tys[k] + "`\"}",
      )
      k = k - 1
    }
    sb.write_string("]}")
    sb.to_string()
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let disps : Array[ProbeDisposition] = []
  let (out, _, inst, resolved) = run_stage_a5_ex(
    [GeneratedFile::{ rel_path: "t.pion", content: src, source_file: "t.mbt", anchors: [] }],
    default_recipes(),
    empty_api_map(),
    Map(),
    mock,
    diags,
    ledger,
    disps,
    8,
  )
  assert_eq(inst, 3)
  assert_eq(resolved, 3)
  assert_true(!has_probe_residual(out[0].content), "no residual probes")
  assert_eq(disps.length(), 3)
  assert_true(disps[0].resolved_type == "String", "resolved type " + "String")
  assert_true(disps[1].resolved_type == "Array[Int]", "resolved type " + "Array[Int]")
  assert_true(disps[2].resolved_type == "Bytes", "resolved type " + "Bytes")
}

test "f3a-6: untagged fallback keeps file-suffix match, same-line nearest column and 1-to-1 consumption" {
  // Untagged mock diagnostics (no `__p` id): sites on the same line are matched by the nearest
  // column among unconsumed results whose file is equal to or ends with `/<site file>`.
  let src = "pub fn f(a : String, b : Array[Int]) -> Int {\n  a.length() + b.length()\n}\n"
  let mock = fn(batch : Array[(String, String)]) -> String {
    let _ = batch
    "{\"ok\":false,\"diagnostics\":[" +
    "{\"file\":\"/abs/out/u.pion\",\"line\":2,\"col\":17,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe` on type `Array[Int]`\"}," +
    "{\"file\":\"other_u.pion\",\"line\":2,\"col\":4,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe` on type `Bytes`\"}," +
    "{\"file\":\"u.pion\",\"line\":2,\"col\":4,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe` on type `String`\"}" +
    "]}"
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let disps : Array[ProbeDisposition] = []
  let (out, _, inst, resolved) = run_stage_a5_ex(
    [GeneratedFile::{ rel_path: "u.pion", content: src, source_file: "u.mbt", anchors: [] }],
    default_recipes(),
    empty_api_map(),
    Map(),
    mock,
    diags,
    ledger,
    disps,
    8,
  )
  assert_eq(inst, 2)
  assert_eq(resolved, 2)
  assert_true(!has_probe_residual(out[0].content), "no residual probes")
  assert_true(disps[0].resolved_type == "String", "resolved type " + "String")
  assert_true(disps[1].resolved_type == "Array[Int]", "resolved type " + "Array[Int]")
}

test "f3a-7: every rewrite in a file gets a fresh copy of the lexed identifier set" {
  // Two Bytes read-only show slices in one file: each rewrite allocates `__mbt_bs`/`__mbt_bsb`/...
  // from its own copy of the file's identifiers, so both use the base names (no `_1` suffixes),
  // exactly as when the identifier set was re-lexed per site; user identifiers are still avoided.
  let src = "pub fn f(a : Bytes, __mbt_bi : Bytes) -> String {\n  mbt_compat::__mbt_slice_ro_show(a, 0, 1) + mbt_compat::__mbt_slice_ro_show(__mbt_bi, 0, 1)\n}\n"
  let mock = fn(batch : Array[(String, String)]) -> String {
    let body = batch[0].1
    let sb = StringBuilder()
    sb.write_string("{\"ok\":false,\"diagnostics\":[")
    let mut rest = body
    let mut first = true
    while true {
      let i = rest.index_of("mbt_slice_ro_show_probe__")
      if i < 0 {
        break
      }
      let after = rest.slice(i + 25, rest.length())
      let close = after.index_of("(")
      if !first {
        sb.write_string(",")
      }
      first = false
      sb.write_string(
        "{\"file\":\"w.pion\",\"line\":2,\"col\":1,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_slice_ro_show_probe__" +
        after.slice(0, close) + "` on type `Bytes`\"}",
      )
      rest = after
    }
    sb.write_string("]}")
    sb.to_string()
  }
  let diags : Array[Diag] = []
  let ledger : Array[DriftEntry] = []
  let (out, _, _, resolved) = run_stage_a5(
    [GeneratedFile::{ rel_path: "w.pion", content: src, source_file: "w.mbt", anchors: [] }],
    default_recipes(),
    mock,
    diags,
    ledger,
  )
  assert_eq(resolved, 2)
  let c = out[0].content
  assert_eq(perf_count(c, "let __mbt_bs = "), 2)
  assert_eq(perf_count(c, "let __mbt_bsb = "), 2)
  assert_eq(perf_count(c, "let mut __mbt_bi_1 = "), 2)
  assert_eq(perf_count(c, "__mbt_bs_1"), 0)
}
