///| Universal MoonBit checked-error lowering module (`suberror` / `raise` / `try` /
///| `catch` / `catch!` / `noraise` / `try?` / `try!`) to native Pion `Result` / `match` / `?`.
///|
///| Design invariants:
///| - Project-agnostic: zero hardcoded domain identifiers.
///| - Lossless token-based rewriting using `lex_moonbit` (preserves trivia/comments).
///| - Zero-closure direct `match` fast paths for `expr catch { ... }`,
///|   `try call(...) catch { ... } [noraise { ... }]`, and
///|   `try Ctor(call(...)) catch { ... } [noraise { ... }]`, so `return` / `break` /
///|   `continue` inside `catch` arms work natively without closure boundaries.
///| - Compound `try` bodies with nonlocal `return` lower via `MbtTryOutcome[R, E]`;
///|   `break`/`continue` across a compound `try` boundary fail closed.
///| - Exact MoonBit `catch` exhaustiveness checking: ordinary incomplete `catch`
///|   fails closed (`MBT2PION_UNSUPPORTED_SYNTAX`) and never auto-rethrows; explicit
///|   rethrow (`e => raise e`) and `catch!` rethrow only to an enclosing raising
///|   boundary with identical concrete error type.
///| - External raising calls resolve via canonical package identity (`moon_import_paths`,
///|   `pkg_aliases`) and verified dependency ABI (`raising_fns`).
///| - Strictly fail-closed (`MBT2PION_UNSUPPORTED_SYNTAX`) on bare `raise`, `raise Error`,
///|   higher-order `raise` parameters, anonymous/escaped raising closures, unknown
///|   external raising calls, first-class raising function values, and unresolved
///|   raising method receivers.

///| Configuration for checked-error lowering.
pub struct ErrorLowerConfig {
  /// Map from `<stdlib_pkg>::<fn>` (e.g. `"json::parse"`) to its Result-returning Pion helper
  /// (e.g. `"mbt_compat::mbt_json_parse"`).
  known_raising_calls : Map[String, String]
  /// Emit postfix `?` for error propagation when true; expand to explicit `match` when false.
  use_try_op : Bool
  /// Unused legacy default error type (bare `raise` outside Category A fails closed).
  default_err_type : String
}

///| Default configuration with standard MoonBit core raising functions mapped to `mbt_compat`.
pub fn default_error_lower_config() -> ErrorLowerConfig {
  let known : Map[String, String] = Map()
  known["json::parse"] = "mbt_compat::mbt_json_parse"
  known["utf8::decode"] = "mbt_compat::utf8_decode_strict"
  known["encoding/utf8::decode"] = "mbt_compat::utf8_decode_strict"
  known["string::parse_int"] = "mbt_compat::str_try_parse_int"
  known["strconv::parse_int"] = "mbt_compat::str_try_parse_int"
  known["string::parse_double"] = "mbt_compat::str_try_parse_double"
  known["strconv::parse_double"] = "mbt_compat::str_try_parse_double"
  ErrorLowerConfig::{
    known_raising_calls: known,
    use_try_op: true,
    default_err_type: "String",
  }
}

///| External package & ABI context for canonical cross-package error resolution.
///| Alias-scoped and canonical-package-scoped tables are kept separate so lookup is
///| 100% invariant to `dep_abis` load order.
pub struct ExternalErrorEnv {
  pkg_aliases : Map[String, String]
  moon_import_paths : Map[String, String]
  dep_pkg_names : Map[String, Bool]
  dep_alias_names : Map[String, Bool]
  dep_alias_to_canon_pkg : Map[String, String]
  dep_raising_fns_by_alias : Map[String, String]
  dep_raising_fns_by_canon : Map[String, String]
  dep_raising_fns_canon_ambig : Map[String, Bool]
  dep_error_ctors_by_alias : Map[String, Array[(String, Int)]]
  dep_error_ctors_by_canon : Map[String, Array[(String, Int)]]
  dep_error_ctors_canon_ambig : Map[String, Bool]
  dep_error_ctor_fields_by_alias : Map[String, Array[String]]
  dep_error_ctor_fields_by_canon : Map[String, Array[String]]
  dep_ctor_to_err_by_alias : Map[String, String]
  dep_ctor_to_err_by_canon : Map[String, String]
  dep_ctor_to_err_canon_ambig : Map[String, Bool]
  cat_a_rewritten : Map[String, Bool]
}

pub fn empty_external_error_env() -> ExternalErrorEnv {
  ExternalErrorEnv::{
    pkg_aliases: Map(),
    moon_import_paths: Map(),
    dep_pkg_names: Map(),
    dep_alias_names: Map(),
    dep_alias_to_canon_pkg: Map(),
    dep_raising_fns_by_alias: Map(),
    dep_raising_fns_by_canon: Map(),
    dep_raising_fns_canon_ambig: Map(),
    dep_error_ctors_by_alias: Map(),
    dep_error_ctors_by_canon: Map(),
    dep_error_ctors_canon_ambig: Map(),
    dep_error_ctor_fields_by_alias: Map(),
    dep_error_ctor_fields_by_canon: Map(),
    dep_ctor_to_err_by_alias: Map(),
    dep_ctor_to_err_by_canon: Map(),
    dep_ctor_to_err_canon_ambig: Map(),
    cat_a_rewritten: Map(),
  }
}

pub fn external_error_env_with_cat_a(
  env : ExternalErrorEnv,
  cat_a_rewritten : Map[String, Bool],
) -> ExternalErrorEnv {
  ExternalErrorEnv::{
    pkg_aliases: env.pkg_aliases,
    moon_import_paths: env.moon_import_paths,
    dep_pkg_names: env.dep_pkg_names,
    dep_alias_names: env.dep_alias_names,
    dep_alias_to_canon_pkg: env.dep_alias_to_canon_pkg,
    dep_raising_fns_by_alias: env.dep_raising_fns_by_alias,
    dep_raising_fns_by_canon: env.dep_raising_fns_by_canon,
    dep_raising_fns_canon_ambig: env.dep_raising_fns_canon_ambig,
    dep_error_ctors_by_alias: env.dep_error_ctors_by_alias,
    dep_error_ctors_by_canon: env.dep_error_ctors_by_canon,
    dep_error_ctors_canon_ambig: env.dep_error_ctors_canon_ambig,
    dep_error_ctor_fields_by_alias: env.dep_error_ctor_fields_by_alias,
    dep_error_ctor_fields_by_canon: env.dep_error_ctor_fields_by_canon,
    dep_ctor_to_err_by_alias: env.dep_ctor_to_err_by_alias,
    dep_ctor_to_err_by_canon: env.dep_ctor_to_err_by_canon,
    dep_ctor_to_err_canon_ambig: env.dep_ctor_to_err_canon_ambig,
    cat_a_rewritten: cat_a_rewritten,
  }
}

fn le_ctor_list_sig(xs : Array[(String, Int)]) -> String {
  let parts : Array[String] = []
  for x in xs {
    parts.push(x.0 + ":" + x.1.to_string())
  }
  let sorted = sort_strings(parts)
  let sb = StringBuilder()
  for idx, p in sorted {
    if idx > 0 { sb.write_string(",") }
    sb.write_string(p)
  }
  sb.to_string()
}

fn le_add_dep_ctor_alias(
  dep_error_ctors : Map[String, Array[(String, Int)]],
  dep_ctor_to_err : Map[String, String],
  pkg : String,
  enum_name : String,
  ctor_name : String,
  arity : Int,
) -> Unit {
  if pkg.length() == 0 || enum_name.length() == 0 || ctor_name.length() == 0 {
    return
  }
  let ek = pkg + "::" + enum_name
  let list = match dep_error_ctors.get(ek) {
    Some(xs) => xs
    None => {
      let xs : Array[(String, Int)] = []
      dep_error_ctors[ek] = xs
      xs
    }
  }
  for existing in list {
    if existing.0 == ctor_name {
      return
    }
  }
  list.push((ctor_name, arity))
  dep_ctor_to_err[pkg + "::" + ctor_name] = ek
}

///| Build load-order-invariant `ExternalErrorEnv` from `SymbolTable`, verified `dep_abis`,
///| and the set of Category A test helper functions already rewritten in pass 1.
pub fn build_external_error_env(
  symtab : SymbolTable,
  dep_abis : Array[(String, PackageAbi)],
  cat_a_rewritten : Map[String, Bool],
) -> ExternalErrorEnv {
  let pkg_aliases : Map[String, String] = Map()
  for k in symtab.pkg_aliases.keys() {
    match symtab.pkg_aliases.get(k) {
      Some(v) => pkg_aliases[k] = v
      None => ()
    }
  }
  let moon_import_paths : Map[String, String] = Map()
  for k in symtab.moon_import_paths.keys() {
    match symtab.moon_import_paths.get(k) {
      Some(v) => moon_import_paths[k] = v
      None => ()
    }
  }
  let dep_pkg_names : Map[String, Bool] = Map()
  for k in symtab.dep_pkg_names.keys() {
    dep_pkg_names[k] = true
  }
  let dep_alias_names : Map[String, Bool] = Map()
  for k in symtab.dep_alias_names.keys() {
    dep_alias_names[k] = true
  }
  let dep_alias_to_canon_pkg : Map[String, String] = Map()
  for k in symtab.dep_alias_to_canon_pkg.keys() {
    match symtab.dep_alias_to_canon_pkg.get(k) {
      Some(v) => dep_alias_to_canon_pkg[k] = v
      None => ()
    }
  }
  let dep_raising_fns_by_alias : Map[String, String] = Map()
  let dep_raising_fns_by_canon : Map[String, String] = Map()
  let dep_raising_fns_canon_ambig : Map[String, Bool] = Map()
  let dep_error_ctors_by_alias : Map[String, Array[(String, Int)]] = Map()
  let dep_error_ctors_by_canon : Map[String, Array[(String, Int)]] = Map()
  let dep_error_ctors_canon_ambig : Map[String, Bool] = Map()
  let dep_error_ctor_fields_by_alias : Map[String, Array[String]] = Map()
  let dep_error_ctor_fields_by_canon : Map[String, Array[String]] = Map()
  let dep_ctor_to_err_by_alias : Map[String, String] = Map()
  let dep_ctor_to_err_by_canon : Map[String, String] = Map()
  let dep_ctor_to_err_canon_ambig : Map[String, Bool] = Map()
  for pair in dep_abis {
    let dep_alias = pair.0
    let abi = pair.1
    if dep_alias.length() > 0 {
      dep_pkg_names[dep_alias] = true
      dep_alias_names[dep_alias] = true
      dep_alias_to_canon_pkg[dep_alias] = if abi.package_name.length() > 0 { abi.package_name } else { dep_alias }
    }
    if abi.package_name.length() > 0 { dep_pkg_names[abi.package_name] = true }
    for rf in abi.raising_fns {
      if dep_alias.length() > 0 {
        dep_raising_fns_by_alias[dep_alias + "::" + rf.name] = rf.err_ty
      }
      if abi.package_name.length() > 0 {
        let ck = abi.package_name + "::" + rf.name
        if !dep_raising_fns_canon_ambig.contains(ck) {
          match dep_raising_fns_by_canon.get(ck) {
            Some(prev) =>
            if prev != rf.err_ty {
              dep_raising_fns_canon_ambig[ck] = true
              let _ = dep_raising_fns_by_canon.remove(ck)
            }
            None => dep_raising_fns_by_canon[ck] = rf.err_ty
          }
        }
      }
    }
    for en in abi.enums {
      let cur_vars : Array[(String, Int)] = []
      for v in en.variants {
        cur_vars.push((v.name, v.fields.length()))
        let ftypes : Array[String] = []
        for f in v.fields { ftypes.push(f.ty.trim()) }
        if dep_alias.length() > 0 {
          le_add_dep_ctor_alias(dep_error_ctors_by_alias, dep_ctor_to_err_by_alias, dep_alias, en.name, v.name, v.fields.length())
          dep_error_ctor_fields_by_alias[dep_alias + "::" + en.name + "::" + v.name] = ftypes
        }
        if abi.package_name.length() > 0 {
          dep_error_ctor_fields_by_canon[abi.package_name + "::" + en.name + "::" + v.name] = ftypes
        }
      }
      if abi.package_name.length() > 0 {
        let ek = abi.package_name + "::" + en.name
        if !dep_error_ctors_canon_ambig.contains(ek) {
          match dep_error_ctors_by_canon.get(ek) {
            Some(prev_vars) =>
            if le_ctor_list_sig(prev_vars) != le_ctor_list_sig(cur_vars) {
              dep_error_ctors_canon_ambig[ek] = true
              let _ = dep_error_ctors_by_canon.remove(ek)
            }
            None => dep_error_ctors_by_canon[ek] = cur_vars
          }
        }
        for v in en.variants {
          let cck = abi.package_name + "::" + v.name
          if !dep_ctor_to_err_canon_ambig.contains(cck) {
            match dep_ctor_to_err_by_canon.get(cck) {
              Some(prev_ek) =>
              if prev_ek != ek {
                dep_ctor_to_err_canon_ambig[cck] = true
                let _ = dep_ctor_to_err_by_canon.remove(cck)
              }
              None => dep_ctor_to_err_by_canon[cck] = ek
            }
          }
        }
      }
    }
  }
  for cname in symtab.ctors.keys() {
    match symtab.ctors.get(cname) {
      Some(targets) => {
        for ct in targets {
          if !ct.is_local && ct.pkg.length() > 0 && ct.enum_name.length() > 0 {
            let ek = ct.pkg + "::" + ct.enum_name
            if !dep_error_ctors_canon_ambig.contains(ek) {
              le_add_dep_ctor_alias(dep_error_ctors_by_canon, dep_ctor_to_err_by_canon, ct.pkg, ct.enum_name, ct.ctor_name, ct.arity)
            }
          }
        }
      }
      None => ()
    }
  }
  ExternalErrorEnv::{
    pkg_aliases: pkg_aliases,
    moon_import_paths: moon_import_paths,
    dep_pkg_names: dep_pkg_names,
    dep_alias_names: dep_alias_names,
    dep_alias_to_canon_pkg: dep_alias_to_canon_pkg,
    dep_raising_fns_by_alias: dep_raising_fns_by_alias,
    dep_raising_fns_by_canon: dep_raising_fns_by_canon,
    dep_raising_fns_canon_ambig: dep_raising_fns_canon_ambig,
    dep_error_ctors_by_alias: dep_error_ctors_by_alias,
    dep_error_ctors_by_canon: dep_error_ctors_by_canon,
    dep_error_ctors_canon_ambig: dep_error_ctors_canon_ambig,
    dep_error_ctor_fields_by_alias: dep_error_ctor_fields_by_alias,
    dep_error_ctor_fields_by_canon: dep_error_ctor_fields_by_canon,
    dep_ctor_to_err_by_alias: dep_ctor_to_err_by_alias,
    dep_ctor_to_err_by_canon: dep_ctor_to_err_by_canon,
    dep_ctor_to_err_canon_ambig: dep_ctor_to_err_canon_ambig,
    cat_a_rewritten: cat_a_rewritten,
  }
}

enum LeFrame {
  PlainFn(String)
  RaisingFn(String, String)
  TryBlk(String, Bool)
}

struct LeState {
  file : String
  is_test : Bool
  cfg : ErrorLowerConfig
  env : ExternalErrorEnv
  suberror_names : Map[String, Bool]
  suberror_ctors : Map[String, String]
  suberror_variants : Map[String, Array[String]]
  suberror_variant_fields : Map[String, Array[String]]
  pkg_raise_fns : Map[String, String]
  pkg_raise_methods : Map[String, String]
  pkg_non_raise_methods : Map[String, Bool]
  pkg_raise_method_names : Map[String, Bool]
  pkg_fn_ret_types : Map[String, String]
  pkg_all_fns : Map[String, Bool]
  pkg_top_bindings : Map[String, Bool]
  pkg_concrete_types : Map[String, Bool]
  failure_enum : String
  outcome_enum : String
  used_idents : Map[String, Bool]
  frames : Array[LeFrame]
  lex_var_types : Array[Map[String, String]]
  lex_raise_closures : Array[Map[String, String]]
  lex_err_vars : Array[Map[String, String]]
  diags : Array[Diag]
  mut need_failure : Bool
  mut need_outcome : Bool
  mut tmp_seq : Int
}

fn le_is_kw(t : Token, s : String) -> Bool {
  (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == s
}

fn le_step_depth(k : TokenKind, d : Int) -> Int {
  if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
    d + 1
  } else if (k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace) && d > 0 {
    d - 1
  } else {
    d
  }
}

fn le_unsup(st : LeState, line : Int, col : Int, msg : String) -> Unit {
  st.diags.push(diag_error("MBT2PION_UNSUPPORTED_SYNTAX", st.file, line, col, msg))
}

fn le_alloc_unique(used : Map[String, Bool], base : String) -> String {
  let mut nm = base
  let mut k = 1
  while used.contains(nm) {
    nm = base + "_" + k.to_string()
    k = k + 1
  }
  used[nm] = true
  nm
}

fn le_fresh_ident(st : LeState, prefix : String) -> String {
  let mut seq = st.tmp_seq
  st.tmp_seq = seq + 1
  let mut nm = prefix + seq.to_string()
  while st.used_idents.contains(nm) {
    seq = st.tmp_seq
    st.tmp_seq = seq + 1
    nm = prefix + seq.to_string()
  }
  st.used_idents[nm] = true
  nm
}

fn le_base_type_ident(ty : String) -> String {
  let s = ty.trim()
  if s.length() == 0 {
    return ""
  }
  let c0 = s.code_unit_at(0)
  if c0 < 65 || c0 > 90 {
    return ""
  }
  let mut i = 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
      i = i + 1
    } else {
      break
    }
  }
  s.slice(0, i)
}

fn le_resolve_dep_pkg(env : ExternalErrorEnv, raw_pkg : String) -> String {
  resolve_dep_pkg_identity(
    env.pkg_aliases,
    env.moon_import_paths,
    env.dep_pkg_names,
    env.dep_alias_names,
    env.dep_alias_to_canon_pkg,
    raw_pkg,
  )
}

fn le_canon_err_ty(st : LeState, raw_et : String) -> String {
  let s = raw_et.trim()
  if s == "Failure" || s == st.failure_enum {
    st.need_failure = true
    return st.failure_enum
  }
  if s.starts_with("@") {
    let dot = s.index_of(".")
    if dot > 1 {
      let rp = s.slice(1, dot)
      let tn = s.slice(dot + 1, s.length()).trim()
      return le_resolve_dep_pkg(st.env, rp) + "::" + tn
    }
  }
  s
}

fn le_emit_err_ty(st : LeState, canon_et : String) -> String {
  if canon_et == "Failure" || canon_et == st.failure_enum {
    st.need_failure = true
    return st.failure_enum
  }
  if canon_et == "__stdlib_err__" {
    return "String"
  }
  canon_et
}

fn le_lookup_dep_raising_fn(env : ExternalErrorEnv, target_pkg : String, fn_name : String) -> Option[String] {
  match env.dep_raising_fns_by_alias.get(target_pkg + "::" + fn_name) {
    Some(et) => return Some(et)
    None => ()
  }
  if env.dep_alias_names.contains(target_pkg) {
    return None
  }
  if !env.dep_raising_fns_canon_ambig.contains(target_pkg + "::" + fn_name) {
    match env.dep_raising_fns_by_canon.get(target_pkg + "::" + fn_name) {
      Some(et) => return Some(et)
      None => ()
    }
  }
  None
}

fn le_lookup_dep_error_ctors(env : ExternalErrorEnv, canon_et : String) -> Option[Array[(String, Int)]] {
  match env.dep_error_ctors_by_alias.get(canon_et) {
    Some(xs) => return Some(xs)
    None => ()
  }
  let sep = canon_et.index_of("::")
  let pkg = if sep > 0 { canon_et.slice(0, sep) } else { "" }
  if pkg.length() > 0 && env.dep_alias_names.contains(pkg) {
    return None
  }
  if !env.dep_error_ctors_canon_ambig.contains(canon_et) {
    return env.dep_error_ctors_by_canon.get(canon_et)
  }
  None
}

fn le_lookup_dep_error_ctor_fields(env : ExternalErrorEnv, canon_et : String, vname : String) -> Option[Array[String]] {
  let fk = canon_et + "::" + vname
  match env.dep_error_ctor_fields_by_alias.get(fk) {
    Some(fs) => return Some(fs)
    None => ()
  }
  let sep = canon_et.index_of("::")
  let pkg = if sep > 0 { canon_et.slice(0, sep) } else { "" }
  if pkg.length() > 0 && env.dep_alias_names.contains(pkg) {
    return None
  }
  if !env.dep_error_ctors_canon_ambig.contains(canon_et) {
    return env.dep_error_ctor_fields_by_canon.get(fk)
  }
  None
}

fn le_lookup_dep_ctor_to_err(env : ExternalErrorEnv, target_pkg : String, ctor_name : String) -> Option[String] {
  match env.dep_ctor_to_err_by_alias.get(target_pkg + "::" + ctor_name) {
    Some(ek) => return Some(ek)
    None => ()
  }
  if env.dep_alias_names.contains(target_pkg) {
    return None
  }
  if !env.dep_ctor_to_err_canon_ambig.contains(target_pkg + "::" + ctor_name) {
    return env.dep_ctor_to_err_by_canon.get(target_pkg + "::" + ctor_name)
  }
  None
}

///| Resolve `@raw_pkg.fn_name` using canonical package identity (`moon_import_paths`, `pkg_aliases`)
///| and load-order-invariant dependency ABI (`dep_raising_fns_by_alias` -> `dep_raising_fns_by_canon`).
///| Returns `Some((lowered_callee, raw_err_ty))` if raising, `None` if non-raising/unknown.
pub fn le_resolve_external_call_raw(
  cfg : ErrorLowerConfig,
  env : ExternalErrorEnv,
  raw_pkg : String,
  fn_name : String,
) -> Option[(String, String)] {
  match env.moon_import_paths.get(raw_pkg) {
    Some(full_path) => {
      let std_key = if full_path == "moonbitlang/core/json" {
        "json::" + fn_name
      } else if full_path == "moonbitlang/core/encoding/utf8" {
        "encoding/utf8::" + fn_name
      } else if full_path == "moonbitlang/core/strconv" {
        "strconv::" + fn_name
      } else if full_path == "moonbitlang/core/string" {
        "string::" + fn_name
      } else {
        ""
      }
      if std_key.length() > 0 {
        match cfg.known_raising_calls.get(std_key) {
          Some(target_fn) => return Some((target_fn, "__stdlib_err__"))
          None => return None
        }
      }
      // User dependency with explicit import path: NEVER match stdlib `known_raising_calls`!
      let target_pkg = le_resolve_dep_pkg(env, raw_pkg)
      match le_lookup_dep_raising_fn(env, target_pkg, fn_name) {
        Some(et) => return Some(("@" + raw_pkg + "." + fn_name, et))
        None => return None
      }
    }
    None => ()
  }
  let target_pkg = le_resolve_dep_pkg(env, raw_pkg)
  match le_lookup_dep_raising_fn(env, target_pkg, fn_name) {
    Some(et) => return Some(("@" + raw_pkg + "." + fn_name, et))
    None => ()
  }
  match env.pkg_aliases.get(raw_pkg) {
    Some(mp) =>
    if mp != raw_pkg && !mp.starts_with("moonbitlang/core/") {
      return None
    }
    None => ()
  }
  if env.dep_pkg_names.contains(raw_pkg) {
    return None
  }
  match cfg.known_raising_calls.get(raw_pkg + "::" + fn_name) {
    Some(target_fn) => Some((target_fn, "__stdlib_err__"))
    None => None
  }
}

fn le_resolve_external_call(st : LeState, raw_pkg : String, fn_name : String) -> Option[(String, String)] {
  match le_resolve_external_call_raw(st.cfg, st.env, raw_pkg, fn_name) {
    Some((callee, raw_et)) => Some((callee, le_canon_err_ty(st, raw_et)))
    None => None
  }
}

fn le_is_known_dep_pkg(st : LeState, raw_pkg : String) -> Bool {
  if st.env.dep_pkg_names.contains(raw_pkg) {
    return true
  }
  let canon = le_resolve_dep_pkg(st.env, raw_pkg)
  st.env.dep_pkg_names.contains(canon)
}

///| Check whether `@raw_pkg.fn_name` is a known pure non-raising MoonBit stdlib function.
///| Never matches user dependencies with custom import paths, non-core aliases, or dep_pkg_names.
pub fn le_is_known_non_raising_stdlib(env : ExternalErrorEnv, raw_pkg : String, fn_name : String) -> Bool {
  match env.moon_import_paths.get(raw_pkg) {
    Some(full_path) =>
    return (full_path == "moonbitlang/core/encoding/utf8" && (fn_name == "encode" || fn_name == "decode_lossy")) ||
    (full_path == "moonbitlang/core/json" && fn_name == "stringify")
    None => ()
  }
  match env.pkg_aliases.get(raw_pkg) {
    Some(mp) =>
    if mp != raw_pkg && !mp.starts_with("moonbitlang/core/") {
      return false
    }
    None => ()
  }
  if env.dep_pkg_names.contains(raw_pkg) {
    return false
  }
  ((raw_pkg == "utf8" || raw_pkg == "encoding/utf8") && (fn_name == "encode" || fn_name == "decode_lossy")) ||
  (raw_pkg == "json" && fn_name == "stringify")
}

fn le_is_lex_bound(st : LeState, name : String) -> Bool {
  let mut i = st.lex_var_types.length() - 1
  while i >= 0 {
    if st.lex_var_types[i].contains(name) || st.lex_raise_closures[i].contains(name) {
      return true
    }
    i = i - 1
  }
  false
}

fn le_lookup_var_type(st : LeState, name : String) -> String {
  let mut i = st.lex_var_types.length() - 1
  while i >= 0 {
    match st.lex_var_types[i].get(name) {
      Some(v) => return v
      None => ()
    }
    i = i - 1
  }
  ""
}

fn le_lookup_raise_fn(st : LeState, name : String) -> Option[String] {
  let mut i = st.lex_raise_closures.length() - 1
  while i >= 0 {
    match st.lex_raise_closures[i].get(name) {
      Some(v) => return if v.length() > 0 { Some(v) } else { None }
      None => ()
    }
    i = i - 1
  }
  if le_is_lex_bound(st, name) {
    return None
  }
  st.pkg_raise_fns.get(name)
}

fn le_lookup_err_var(st : LeState, name : String) -> Option[String] {
  let mut i = st.lex_err_vars.length() - 1
  while i >= 0 {
    match st.lex_err_vars[i].get(name) {
      Some(v) => return if v.length() > 0 { Some(v) } else { None }
      None => ()
    }
    if i < st.lex_var_types.length() && st.lex_var_types[i].contains(name) {
      return None
    }
    if i < st.lex_raise_closures.length() && st.lex_raise_closures[i].contains(name) {
      return None
    }
    i = i - 1
  }
  None
}

///| Infer the concrete error type of a `raise <expr>` operand `[expr_s, expr_e)`.
///| Supports local `Ctor`, `Enum::Ctor`, `Failure`, cross-package `@pkg.Ctor` and `@pkg.Enum::Ctor`,
///| and caught error variables bound in `st.lex_err_vars`.
fn le_infer_raise_expr_err_ty(st : LeState, tokens : Array[Token], expr_s : Int, expr_e : Int) -> String {
  if expr_s >= expr_e {
    return ""
  }
  let nt = tokens[expr_s]
  if expr_s + 1 == expr_e && nt.kind == TokenKind::Ident {
    return match le_lookup_err_var(st, nt.raw) { Some(vet) => vet, None => "" }
  }
  if nt.kind == TokenKind::UpperIdent {
    if nt.raw == "Failure" {
      return st.failure_enum
    }
    match st.suberror_ctors.get(nt.raw) {
      Some(en) => return en
      None => ()
    }
    if expr_s + 2 < expr_e && tokens[expr_s + 1].kind == TokenKind::ColonColon && tokens[expr_s + 2].kind == TokenKind::UpperIdent {
      match st.suberror_ctors.get(tokens[expr_s + 2].raw) {
        Some(en2) => return en2
        None => if st.suberror_names.contains(nt.raw) { return nt.raw }
      }
    }
    return ""
  }
  if nt.kind == TokenKind::PkgRef && expr_s + 2 < expr_e && tokens[expr_s + 1].kind == TokenKind::Dot && tokens[expr_s + 2].kind == TokenKind::UpperIdent {
    let rp = nt.raw.slice(1, nt.raw.length())
    let cp = le_resolve_dep_pkg(st.env, rp)
    // Cross-package `@pkg.Enum::Ctor(...)`
    if expr_s + 4 < expr_e && tokens[expr_s + 3].kind == TokenKind::ColonColon && tokens[expr_s + 4].kind == TokenKind::UpperIdent {
      match le_lookup_dep_ctor_to_err(st.env, cp, tokens[expr_s + 4].raw) {
        Some(ek) => return ek
        None => return cp + "::" + tokens[expr_s + 2].raw
      }
    }
    // Cross-package `@pkg.Ctor(...)`
    match le_lookup_dep_ctor_to_err(st.env, cp, tokens[expr_s + 2].raw) {
      Some(ek) => return ek
      None => ()
    }
  }
  ""
}

fn le_emit_abort_call(st : LeState, msg : String, line : Int, col : Int) -> String {
  if le_is_lex_bound(st, "mbt_compat") || st.pkg_all_fns.contains("mbt_compat") ||
  st.pkg_concrete_types.contains("mbt_compat") || st.pkg_top_bindings.contains("mbt_compat") ||
  st.env.dep_pkg_names.contains("mbt_compat") || st.env.pkg_aliases.contains("mbt_compat") ||
  st.env.moon_import_paths.contains("mbt_compat") {
    le_unsup(st, line, col, "cannot lower `try!`/outcome abort because `mbt_compat` is shadowed in this package or scope")
  }
  "mbt_compat::mbt_abort(\"" + msg + "\")"
}

fn le_is_builtin_fail(st : LeState, tokens : Array[Token], i : Int, start : Int, end : Int) -> Bool {
  tokens[i].kind == TokenKind::Ident && tokens[i].raw == "fail" && i + 1 < end &&
  tokens[i + 1].kind == TokenKind::LParen &&
  !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
  !st.pkg_all_fns.contains("fail") && !le_is_lex_bound(st, "fail")
}

fn le_active_err_ty(st : LeState) -> Option[String] {
  if st.frames.length() == 0 {
    return None
  }
  match st.frames[st.frames.length() - 1] {
    LeFrame::RaisingFn(_, et) => Some(et)
    LeFrame::TryBlk(et, _) => Some(et)
    LeFrame::PlainFn(_) => None
  }
}

fn le_in_raising_context(st : LeState) -> Bool {
  match le_active_err_ty(st) {
    Some(_) => true
    None => false
  }
}

fn le_enclosing_source_ret_ty(frames : Array[LeFrame]) -> String {
  let mut i = frames.length() - 1
  while i >= 0 {
    match frames[i] {
      LeFrame::PlainFn(rty) => return rty
      LeFrame::RaisingFn(rty, _) => return rty
      LeFrame::TryBlk(_, _) => ()
    }
    i = i - 1
  }
  "Unit"
}

fn le_enclosing_ret_stmt(frames : Array[LeFrame], val_expr : String) -> String {
  if frames.length() == 0 {
    return "return " + val_expr
  }
  match frames[frames.length() - 1] {
    LeFrame::PlainFn(_) => "return " + val_expr
    LeFrame::RaisingFn(_, _) => "return Ok(" + val_expr + ")"
    LeFrame::TryBlk(_, _) => "return MbtTryRet(" + val_expr + ")"
  }
}

fn le_active_raise_stmt(st : LeState, err_expr : String, line : Int, col : Int) -> String {
  if st.frames.length() > 0 {
    match st.frames[st.frames.length() - 1] {
      LeFrame::TryBlk(_, true) => return "return MbtTryErr(" + err_expr + ")"
      LeFrame::TryBlk(_, false) => return "return Err(" + err_expr + ")"
      LeFrame::RaisingFn(_, _) => return "return Err(" + err_expr + ")"
      LeFrame::PlainFn(_) => ()
    }
  }
  le_unsup(st, line, col, "uncaught `raise` outside raising function or `try`")
  "return Err(" + err_expr + ")"
}

fn le_propagate_call(st : LeState, call_expr : String, call_err_ty : String, line : Int, col : Int) -> String {
  match le_active_err_ty(st) {
    None => {
      le_unsup(st, line, col, "uncaught raising call outside raising function or `try`/`catch`")
      return call_expr
    }
    Some(outer_et) => {
      if call_err_ty.length() > 0 && call_err_ty != "__stdlib_err__" && outer_et.length() > 0 &&
      outer_et != "__stdlib_err__" && call_err_ty != outer_et {
        le_unsup(st, line, col, "cannot propagate error type `" + call_err_ty + "` into boundary expecting `" + outer_et + "`")
      }
      match st.frames[st.frames.length() - 1] {
        LeFrame::TryBlk(_, true) => {
          let ok_v = le_fresh_ident(st, "__mbt_ok_")
          let err_v = le_fresh_ident(st, "__mbt_err_")
          "(match " + call_expr + " { Ok(" + ok_v + ") => " + ok_v + ", Err(" + err_v + ") => return MbtTryErr(" + err_v + ") })"
        }
        LeFrame::TryBlk(_, false) => {
          let ok_v = le_fresh_ident(st, "__mbt_ok_")
          let err_v = le_fresh_ident(st, "__mbt_err_")
          "(match " + call_expr + " { Ok(" + ok_v + ") => " + ok_v + ", Err(" + err_v + ") => return Err(" + err_v + ") })"
        }
        LeFrame::RaisingFn(_, _) =>
        if st.cfg.use_try_op {
          call_expr + "?"
        } else {
          let ok_v = le_fresh_ident(st, "__mbt_ok_")
          let err_v = le_fresh_ident(st, "__mbt_err_")
          "(match " + call_expr + " { Ok(" + ok_v + ") => " + ok_v + ", Err(" + err_v + ") => return Err(" + err_v + ") })"
        }
        LeFrame::PlainFn(_) => call_expr
      }
    }
  }
}

fn le_is_cont_op(t : Token) -> Bool {
  t.kind == TokenKind::Dot || t.kind == TokenKind::ColonColon ||
  t.raw == "+" || t.raw == "-" || t.raw == "*" || t.raw == "/" || t.raw == "%" ||
  t.raw == "&&" || t.raw == "||" || t.raw == "==" || t.raw == "!=" ||
  t.raw == "<" || t.raw == "<=" || t.raw == ">" || t.raw == ">=" || t.raw == "|>"
}

fn le_looks_like_arrow_params(tokens : Array[Token], lp : Int, rp : Int) -> Bool {
  let mut k = lp + 1
  let mut d = 0
  let mut in_type = false
  while k < rp {
    let tk = tokens[k]
    if d == 0 {
      if tk.kind == TokenKind::Comma {
        in_type = false
        k = k + 1
        continue
      }
      if tk.kind == TokenKind::Colon {
        in_type = true
        k = k + 1
        continue
      }
      if !in_type {
        if tk.kind == TokenKind::Ident || tk.kind == TokenKind::Underscore || tk.raw == "_" || tk.kind == TokenKind::Tilde {
          k = k + 1
          continue
        }
        return false
      }
    }
    d = le_step_depth(tk.kind, d)
    k = k + 1
  }
  true
}

fn le_is_pat_stop_op(t : Token) -> Bool {
  t.raw == "&&" || t.raw == "||" || t.raw == "==" || t.raw == "!=" ||
  t.raw == "<" || t.raw == "<=" || t.raw == ">" || t.raw == ">=" ||
  t.raw == "|>" || t.raw == "=" || t.raw == "+" || t.raw == "-" ||
  t.raw == "*" || t.raw == "/" || t.raw == "%"
}

///| Find end of `<pat>` after `is` starting at `pat_s`, stopping at depth-0 operators/delimiters.
fn le_find_is_pat_end(tokens : Array[Token], pat_s : Int, limit : Int) -> Int {
  let mut pe = pat_s
  let mut pd = 0
  while pe < limit {
    let pt = tokens[pe]
    let is_body_lbrace = pt.kind == TokenKind::LBrace && pe > pat_s && tokens[pe - 1].kind != TokenKind::ColonColon
    if pd == 0 && (le_is_pat_stop_op(pt) || is_body_lbrace ||
      pt.kind == TokenKind::RParen || pt.kind == TokenKind::RBracket || pt.kind == TokenKind::RBrace ||
      pt.kind == TokenKind::Semi || pt.kind == TokenKind::Comma ||
      (pt.kind == TokenKind::Keyword && pt.raw == "else") ||
      (pe > pat_s && pt.newline_before)) {
      break
    }
    pd = le_step_depth(pt.kind, pd)
    pe = pe + 1
  }
  pe
}

///| Find end of an `&&` chain starting at `chain_start`, stopping at any depth-0 token with
///| lower precedence than `&&` (`||`, `|>`, `=`, `+=`/`-=`/`*=`/`/=`/`%=`, `=>`, `catch`,
///| `noraise`, `else`, delimiters, or newline starting a new statement).
fn le_find_and_chain_end(tokens : Array[Token], chain_start : Int, end : Int) -> Int {
  let mut ce = chain_start
  let mut cd = 0
  while ce < end {
    let ct = tokens[ce]
    if cd == 0 && (ct.raw == "||" || ct.raw == "|>" ||
      ct.kind == TokenKind::Eq || ct.raw == "+=" || ct.raw == "-=" || ct.raw == "*=" || ct.raw == "/=" || ct.raw == "%=" ||
      ct.kind == TokenKind::FatArrow ||
      ct.kind == TokenKind::Semi || ct.kind == TokenKind::RBrace ||
      ct.kind == TokenKind::RParen || ct.kind == TokenKind::RBracket || ct.kind == TokenKind::Comma ||
      (ct.kind == TokenKind::Keyword && ct.raw == "else") ||
      le_is_kw(ct, "catch") || le_is_kw(ct, "noraise") ||
      (ce > chain_start && ct.newline_before && !le_is_cont_op(tokens[ce - 1]) && !le_is_cont_op(ct))) {
      break
    }
    cd = le_step_depth(ct.kind, cd)
    ce = ce + 1
  }
  ce
}

///| Lower an `if`/`while`/`guard` condition `[cs, ce)`.
///| Only top-level (depth 0, no top-level `||`/`|>`/`catch`/`noraise`, unnegated, unwrapping paired `(...)`)
///| `&&`-chain `is <pat>` expressions inject pattern bindings into the enclosing lexical scope.
fn le_lower_cond_with_is(
  st : LeState,
  src : String,
  tokens : Array[Token],
  cs : Int,
  ce : Int,
) -> String {
  let mut has_lower_prec = false
  let mut k = cs
  let mut d = 0
  while k < ce {
    if d == 0 && (tokens[k].raw == "||" || tokens[k].raw == "|>" || le_is_kw(tokens[k], "catch") || le_is_kw(tokens[k], "noraise")) {
      has_lower_prec = true
      break
    }
    d = le_step_depth(tokens[k].kind, d)
    k = k + 1
  }
  if has_lower_prec {
    return le_lower_range(st, src, tokens, cs, ce)
  }
  let sb = StringBuilder()
  let mut seg_s = cs
  k = cs
  d = 0
  while k <= ce {
    if k == ce || (d == 0 && tokens[k].raw == "&&") {
      if seg_s < k {
        if tokens[seg_s].kind == TokenKind::LParen && find_matching_delim(tokens, seg_s) == k - 1 {
          sb.write_string(tokens[seg_s].leading_trivia + "(" + le_lower_cond_with_is(st, src, tokens, seg_s + 1, k - 1) + tokens[k - 1].leading_trivia + ")")
        } else {
          sb.write_string(le_lower_range(st, src, tokens, seg_s, k))
          // Inject `is <pat>` binders into scope only if segment is unnegated and `<pat>` spans to segment end
          if tokens[seg_s].raw != "!" {
            let mut si = seg_s
            let mut sd = 0
            let mut is_i = -1
            while si < k {
              if sd == 0 && le_is_kw(tokens[si], "is") {
                is_i = si
                break
              }
              sd = le_step_depth(tokens[si].kind, sd)
              si = si + 1
            }
            if is_i >= seg_s && is_i + 1 < k {
              let pat_e = le_find_is_pat_end(tokens, is_i + 1, k)
              if pat_e == k {
                let top = st.lex_var_types.length() - 1
                le_shadow_pat_idents(tokens, is_i + 1, pat_e, st.lex_var_types[top], st.lex_raise_closures[top])
              }
            }
          }
        }
      }
      if k < ce {
        sb.write_string(tokens[k].leading_trivia + tokens[k].raw)
        seg_s = k + 1
      }
    }
    if k < ce { d = le_step_depth(tokens[k].kind, d) }
    k = k + 1
  }
  sb.to_string()
}

///| Parse comma-separated field types inside a constructor's `(...)` parameter list.
fn le_parse_ctor_field_types(src : String, tokens : Array[Token], lp : Int, rp : Int) -> Array[String] {
  let out : Array[String] = []
  let mut seg_s = lp + 1
  let mut k = lp + 1
  let mut d = 0
  while k <= rp {
    if k == rp || (d == 0 && tokens[k].kind == TokenKind::Comma) {
      if seg_s < k {
        let mut ts = seg_s
        if ts + 1 < k && tokens[ts].kind == TokenKind::Ident && tokens[ts + 1].kind == TokenKind::Tilde && ts + 2 < k && tokens[ts + 2].kind == TokenKind::Colon {
          ts = ts + 3
        } else if ts + 1 < k && tokens[ts].kind == TokenKind::Ident && tokens[ts + 1].kind == TokenKind::Colon {
          ts = ts + 2
        }
        if ts < k {
          out.push(src.slice(tokens[ts].start_byte, tokens[k - 1].end_byte).trim())
        }
      }
      seg_s = k + 1
    }
    if k < rp { d = le_step_depth(tokens[k].kind, d) }
    k = k + 1
  }
  out
}

fn le_find_stmt_expr_end(tokens : Array[Token], start : Int, limit : Int) -> Int {
  let mut i = start
  let mut d = 0
  while i < limit {
    let t = tokens[i]
    if d == 0 && (t.kind == TokenKind::Semi || t.kind == TokenKind::RBrace ||
      t.kind == TokenKind::Comma || t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket ||
      (i > start && t.newline_before && !le_is_cont_op(tokens[i - 1]) && !le_is_cont_op(t) &&
        !(t.kind == TokenKind::Keyword && t.raw == "else") &&
        !le_is_kw(t, "catch") && !le_is_kw(t, "noraise"))) {
      break
    }
    d = le_step_depth(t.kind, d)
    i = i + 1
  }
  i
}

fn le_find_try_expr_end(tokens : Array[Token], start : Int, limit : Int) -> Int {
  let mut i = start
  let mut d = 0
  while i < limit {
    let t = tokens[i]
    if d == 0 {
      if t.kind == TokenKind::Semi || t.kind == TokenKind::RBrace ||
      t.kind == TokenKind::Comma || t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket {
        break
      }
      if i > start && t.kind == TokenKind::LBrace {
        let prev = tokens[i - 1]
        let is_body_head = prev.kind == TokenKind::ColonColon ||
        prev.kind == TokenKind::FatArrow || prev.kind == TokenKind::Arrow ||
        le_is_kw(prev, "match") || le_is_kw(prev, "if") || le_is_kw(prev, "else") ||
        le_is_kw(prev, "while") || le_is_kw(prev, "for") || le_is_kw(prev, "loop") ||
        le_is_kw(prev, "try") || le_is_kw(prev, "catch") || le_is_kw(prev, "noraise")
        if !is_body_head {
          break
        }
      }
      if i > start && t.newline_before && !le_is_cont_op(tokens[i - 1]) && !le_is_cont_op(t) &&
      !(t.kind == TokenKind::Keyword && t.raw == "else") &&
      !le_is_kw(t, "catch") && !le_is_kw(t, "noraise") {
        break
      }
    }
    d = le_step_depth(t.kind, d)
    i = i + 1
  }
  i
}

///| Parse a `fn` declaration header:
///| returns `(fn_name, open_p, close_p, ret_ty, has_raise, err_ty, has_raise_in_params, body_lbrace)`.
fn le_parse_fn_header(
  src : String,
  tokens : Array[Token],
  fn_i : Int,
  limit : Int,
) -> Option[(String, Int, Int, String, Bool, String, Bool, Int)] {
  let mut k = fn_i + 1
  if k < limit && tokens[k].kind == TokenKind::LBracket {
    k = find_matching_delim(tokens, k) + 1
  }
  let name_sb = StringBuilder()
  while k < limit && tokens[k].kind != TokenKind::LParen && tokens[k].kind != TokenKind::LBrace {
    if tokens[k].kind == TokenKind::LBracket {
      k = find_matching_delim(tokens, k) + 1
      continue
    }
    name_sb.write_string(tokens[k].raw)
    k = k + 1
  }
  if k >= limit || tokens[k].kind != TokenKind::LParen {
    return None
  }
  let open_p = k
  let close_p = find_matching_delim(tokens, open_p)
  let mut has_raise_param = false
  let mut pi = open_p + 1
  while pi < close_p {
    if le_is_kw(tokens[pi], "raise") {
      has_raise_param = true
      break
    }
    pi = pi + 1
  }
  let mut cur = close_p + 1
  let mut ret_ty = ""
  let mut has_raise = false
  let mut err_ty = ""
  if cur < limit && tokens[cur].kind == TokenKind::Arrow {
    let rt_s = cur + 1
    let mut rt_e = rt_s
    let mut rd = 0
    while rt_e < limit {
      if rd == 0 && (tokens[rt_e].kind == TokenKind::LBrace || tokens[rt_e].kind == TokenKind::Eq) {
        break
      }
      if rd == 0 && le_is_kw(tokens[rt_e], "raise") {
        has_raise = true
        break
      }
      rd = le_step_depth(tokens[rt_e].kind, rd)
      rt_e = rt_e + 1
    }
    if rt_e > rt_s {
      ret_ty = src.slice(tokens[rt_s].start_byte, tokens[rt_e - 1].end_byte).trim()
    }
    cur = rt_e
  } else if cur < limit && le_is_kw(tokens[cur], "raise") {
    has_raise = true
  }
  if has_raise {
    cur = cur + 1
    let et_s = cur
    while cur < limit && tokens[cur].kind != TokenKind::LBrace && tokens[cur].kind != TokenKind::Eq {
      cur = cur + 1
    }
    if cur > et_s {
      err_ty = src.slice(tokens[et_s].start_byte, tokens[cur - 1].end_byte).trim()
    }
  }
  while cur < limit && tokens[cur].kind != TokenKind::LBrace {
    if tokens[cur].kind == TokenKind::Eq {
      return None
    }
    cur = cur + 1
  }
  if cur >= limit || tokens[cur].kind != TokenKind::LBrace {
    return None
  }
  Some((name_sb.to_string(), open_p, close_p, ret_ty, has_raise, err_ty, has_raise_param, cur))
}

fn le_seed_params(
  tokens : Array[Token],
  open_p : Int,
  close_p : Int,
  fn_name : String,
  vmap : Map[String, String],
  cmap : Map[String, String],
) -> Unit {
  let cc = fn_name.index_of("::")
  if cc > 0 {
    vmap["self"] = fn_name.slice(0, cc)
  }
  let mut k = open_p + 1
  let mut d = 0
  while k < close_p {
    if d == 0 && (tokens[k].kind == TokenKind::Ident || tokens[k].kind == TokenKind::Keyword) {
      let pn = tokens[k].raw
      if pn != "mut" {
        cmap[pn] = ""
        let mut ti = k + 1
        if ti < close_p && (tokens[ti].kind == TokenKind::Tilde || tokens[ti].kind == TokenKind::Question) {
          ti = ti + 1
        }
        if ti + 1 < close_p && tokens[ti].kind == TokenKind::Colon && tokens[ti + 1].kind == TokenKind::UpperIdent {
          vmap[pn] = tokens[ti + 1].raw
        } else if pn != "self" {
          vmap[pn] = ""
        }
      }
      while k < close_p && !(d == 0 && tokens[k].kind == TokenKind::Comma) {
        d = le_step_depth(tokens[k].kind, d)
        k = k + 1
      }
    }
    k = k + 1
  }
}

fn le_shadow_pat_idents(
  tokens : Array[Token],
  s : Int,
  e : Int,
  vmap : Map[String, String],
  cmap : Map[String, String],
) -> Unit {
  let mut k = s
  while k < e {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && tk.raw != "_" &&
    !(k > s && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) &&
    !(k + 1 < e && tokens[k + 1].kind == TokenKind::Colon) {
      vmap[tk.raw] = ""
      cmap[tk.raw] = ""
    }
    k = k + 1
  }
}

///| True iff the body `{ ... }` consists solely of a single top-level `raise ...` or `return ...`.
fn le_body_always_exits(tokens : Array[Token], lb : Int, rb : Int) -> Bool {
  let mut s = lb + 1
  while s < rb && tokens[s].kind == TokenKind::Semi {
    s = s + 1
  }
  if s >= rb {
    return false
  }
  if !(le_is_kw(tokens[s], "raise") || (tokens[s].kind == TokenKind::Keyword && tokens[s].raw == "return")) {
    return false
  }
  let mut k = le_find_stmt_expr_end(tokens, s + 1, rb)
  while k < rb && tokens[k].kind == TokenKind::Semi {
    k = k + 1
  }
  k >= rb
}

///| Check whether `t` can legally end a MoonBit expression (LL(1) predecessor grammar).
fn le_can_end_expr(t : Token) -> Bool {
  (t.kind == TokenKind::Ident && t.raw != "noraise") || t.kind == TokenKind::UpperIdent ||
  t.kind == TokenKind::IntLit || t.kind == TokenKind::FloatLit ||
  t.kind == TokenKind::StringLit || t.kind == TokenKind::InterpString ||
  t.kind == TokenKind::RawMultiline || t.kind == TokenKind::InterpMultiline ||
  t.kind == TokenKind::ByteStringLit || t.kind == TokenKind::CharLit ||
  t.kind == TokenKind::ByteCharLit || t.kind == TokenKind::RParen ||
  t.kind == TokenKind::RBracket || t.kind == TokenKind::RBrace ||
  t.kind == TokenKind::Underscore ||
  (t.kind == TokenKind::Keyword && (t.raw == "true" || t.raw == "false" || t.raw == "self"))
}

///| Check whether the token immediately following a `{ ... }` block continues an expression.
fn le_is_expr_cont_after_brace(t : Token) -> Bool {
  (t.kind == TokenKind::LBrace && !t.newline_before) ||
  (t.kind == TokenKind::Minus && !t.newline_before) ||
  (t.kind == TokenKind::LBracket && !t.newline_before) ||
  (t.kind == TokenKind::LParen && !t.newline_before) ||
  t.kind == TokenKind::Dot || t.kind == TokenKind::PipeGt ||
  t.kind == TokenKind::AmpAmp || t.kind == TokenKind::PipePipe ||
  t.kind == TokenKind::EqEq || t.kind == TokenKind::BangEq ||
  t.kind == TokenKind::Lt || t.kind == TokenKind::LtEq ||
  t.kind == TokenKind::Gt || t.kind == TokenKind::GtEq ||
  t.kind == TokenKind::Plus || t.kind == TokenKind::Star ||
  t.kind == TokenKind::Slash || t.kind == TokenKind::Percent ||
  t.kind == TokenKind::Amp || t.kind == TokenKind::Pipe ||
  t.kind == TokenKind::Caret || t.kind == TokenKind::Shl ||
  t.kind == TokenKind::Shr ||
  (t.kind == TokenKind::Keyword && (t.raw == "is" || t.raw == "in"))
}

///| Locate the opening `{` of a `match` / `loop` / `while` / `for` / `if` body using LL(1)
///| expression-ending predecessor grammar, skipping nested delimiters and control-flow expressions.
fn le_find_header_body_lbrace(tokens : Array[Token], kw_idx : Int, e : Int) -> Int {
  let kw_raw = tokens[kw_idx].raw
  let mut semi_count = 0
  let mut k = kw_idx + 1
  while k < e {
    let tk = tokens[k]
    if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket {
      k = find_matching_delim(tokens, k) + 1
      continue
    }
    if tk.kind == TokenKind::Semi {
      semi_count = semi_count + 1
      k = k + 1
      continue
    }
    if tk.kind == TokenKind::Keyword && tk.raw == "fn" {
      let mut j = k + 1
      while j < e && tokens[j].kind != TokenKind::LBrace {
        j = if tokens[j].kind == TokenKind::LParen || tokens[j].kind == TokenKind::LBracket {
          find_matching_delim(tokens, j) + 1
        } else {
          j + 1
        }
      }
      if j < e && tokens[j].kind == TokenKind::LBrace {
        k = find_matching_delim(tokens, j) + 1
        continue
      }
    }
    if tk.kind == TokenKind::Keyword && tk.raw == "if" {
      let tlb = le_find_header_body_lbrace(tokens, k, e)
      if tlb >= 0 {
        k = find_matching_delim(tokens, tlb) + 1
        while k < e && tokens[k].kind == TokenKind::Keyword && tokens[k].raw == "else" {
          if k + 1 < e && tokens[k + 1].kind == TokenKind::Keyword && tokens[k + 1].raw == "if" {
            let elb = le_find_header_body_lbrace(tokens, k + 1, e)
            if elb >= 0 {
              k = find_matching_delim(tokens, elb) + 1
              continue
            }
            break
          }
          if k + 1 < e && tokens[k + 1].kind == TokenKind::LBrace {
            k = find_matching_delim(tokens, k + 1) + 1
            continue
          }
          break
        }
        continue
      }
    }
    if tk.kind == TokenKind::Keyword &&
    (tk.raw == "match" || tk.raw == "loop" || tk.raw == "while" || tk.raw == "for") {
      let nlb = le_find_header_body_lbrace(tokens, k, e)
      if nlb >= 0 {
        k = find_matching_delim(tokens, nlb) + 1
        continue
      }
    }
    if (tk.kind == TokenKind::Keyword && (tk.raw == "try" || tk.raw == "catch")) || le_is_kw(tk, "noraise") {
      if k + 1 < e && tokens[k + 1].kind == TokenKind::LBrace {
        k = find_matching_delim(tokens, k + 1) + 1
        continue
      }
      if k + 2 < e &&
      (tokens[k + 1].kind == TokenKind::Question || tokens[k + 1].kind == TokenKind::Bang) &&
      tokens[k + 2].kind == TokenKind::LBrace {
        k = find_matching_delim(tokens, k + 2) + 1
        continue
      }
    }
    if tk.kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, k)
      if k == kw_idx + 1 {
        if kw_raw == "for" {
          if rb + 1 < e && le_is_expr_cont_after_brace(tokens[rb + 1]) {
            k = rb + 1
            continue
          }
          return k
        }
        k = rb + 1
        continue
      }
      let prev_ends_expr = le_can_end_expr(tokens[k - 1]) ||
      ((tokens[k - 1].kind == TokenKind::Bang || tokens[k - 1].kind == TokenKind::Question) &&
        k - 2 > kw_idx &&
        !tokens[k - 1].newline_before &&
        le_can_end_expr(tokens[k - 2]))
      if prev_ends_expr {
        return k
      }
      if kw_raw == "for" && tokens[k - 1].kind == TokenKind::Semi {
        if semi_count >= 2 {
          return k
        }
        if semi_count == 1 {
          if rb + 1 < e && (tokens[rb + 1].kind == TokenKind::Semi || le_is_expr_cont_after_brace(tokens[rb + 1])) {
            k = rb + 1
            continue
          }
          return k
        }
      }
      k = rb + 1
      continue
    }
    k = k + 1
  }
  -1
}

fn le_find_match_lbrace(tokens : Array[Token], match_idx : Int, e : Int) -> Int {
  le_find_header_body_lbrace(tokens, match_idx, e)
}

fn le_find_loop_body_lbrace(tokens : Array[Token], kw_idx : Int, e : Int) -> Int {
  le_find_header_body_lbrace(tokens, kw_idx, e)
}

///| Scan a `try` body range `[s, e)` for control-flow statements crossing the `try` boundary.
///| Returns `(has_return, has_break_or_continue)`.
///| Skips inner `fn` and arrow closures while never skipping `match`/`catch`/`catch!`/`noraise`/`loop` arms.
fn le_scan_try_control_flow_depth(tokens : Array[Token], s : Int, e : Int, init_ld : Int) -> (Bool, Bool) {
  let mut has_ret = false
  let mut has_bc = false
  let mut ld = init_ld
  let loop_depths : Array[Int] = []
  let loop_body_lbraces : Map[Int, Bool] = Map()
  let arm_block_lbraces : Map[Int, Bool] = Map()
  let in_arm_block_stack : Array[Bool] = []
  let mut bd = 0
  let mut i = s
  while i < e {
    let t = tokens[i]
    if t.kind == TokenKind::Keyword && t.raw == "fn" {
      let mut j = i + 1
      while j < e && tokens[j].kind != TokenKind::LBrace {
        j = if tokens[j].kind == TokenKind::LParen || tokens[j].kind == TokenKind::LBracket {
          find_matching_delim(tokens, j) + 1
        } else {
          j + 1
        }
      }
      if j < e && tokens[j].kind == TokenKind::LBrace {
        i = find_matching_delim(tokens, j) + 1
        continue
      }
    }
    if t.kind == TokenKind::Keyword && t.raw == "match" {
      let mlb = le_find_match_lbrace(tokens, i, e)
      if mlb >= 0 { arm_block_lbraces[mlb] = true }
    } else if (t.kind == TokenKind::Keyword && t.raw == "catch") || le_is_kw(t, "noraise") {
      if i + 1 < e && tokens[i + 1].kind == TokenKind::LBrace {
        arm_block_lbraces[i + 1] = true
      } else if i + 2 < e && tokens[i + 1].kind == TokenKind::Bang && tokens[i + 2].kind == TokenKind::LBrace {
        arm_block_lbraces[i + 2] = true
      }
    }
    let in_arm_block = in_arm_block_stack.length() > 0 && in_arm_block_stack[in_arm_block_stack.length() - 1]
    let allow_arrow = !in_arm_block || (i > s && tokens[i - 1].kind == TokenKind::FatArrow)
    let is_single_param = t.kind == TokenKind::Ident || t.kind == TokenKind::Underscore || t.raw == "_"
    if allow_arrow && is_single_param && i + 2 < e && tokens[i + 1].kind == TokenKind::FatArrow {
      if tokens[i + 2].kind == TokenKind::LBrace {
        i = find_matching_delim(tokens, i + 2) + 1
      } else {
        i = le_find_stmt_expr_end(tokens, i + 2, e)
      }
      continue
    }
    if allow_arrow && t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp + 2 < e && tokens[cp + 1].kind == TokenKind::FatArrow && le_looks_like_arrow_params(tokens, i, cp) {
        if tokens[cp + 2].kind == TokenKind::LBrace {
          i = find_matching_delim(tokens, cp + 2) + 1
        } else {
          i = le_find_stmt_expr_end(tokens, cp + 2, e)
        }
        continue
      }
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) {
        if p.is_expr {
          let ht = lex_moonbit(p.text)
          let (hr, hbc) = le_scan_try_control_flow_depth(ht, 0, ht.length() - 1, ld)
          if hr { has_ret = true }
          if hbc { has_bc = true }
        }
      }
      i = i + 1
      continue
    }
    if t.kind == TokenKind::Keyword && (t.raw == "while" || t.raw == "for" || t.raw == "loop") {
      let blb = if t.raw == "loop" {
        le_find_match_lbrace(tokens, i, e)
      } else {
        le_find_loop_body_lbrace(tokens, i, e)
      }
      if blb >= 0 {
        loop_body_lbraces[blb] = true
        if t.raw == "loop" { arm_block_lbraces[blb] = true }
      }
    } else if t.kind == TokenKind::LParen || t.kind == TokenKind::LBracket {
      in_arm_block_stack.push(false)
    } else if t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket {
      if in_arm_block_stack.length() > 0 { let _ = in_arm_block_stack.pop() }
    } else if t.kind == TokenKind::LBrace {
      if loop_body_lbraces.contains(i) {
        ld = ld + 1
        loop_depths.push(bd)
      }
      bd = bd + 1
      in_arm_block_stack.push(arm_block_lbraces.contains(i))
    } else if t.kind == TokenKind::RBrace {
      if bd > 0 { bd = bd - 1 }
      if in_arm_block_stack.length() > 0 { let _ = in_arm_block_stack.pop() }
      while loop_depths.length() > 0 && loop_depths[loop_depths.length() - 1] == bd {
        let _ = loop_depths.pop()
        if ld > 0 { ld = ld - 1 }
      }
    } else if t.kind == TokenKind::Keyword && t.raw == "return" {
      has_ret = true
    } else if t.kind == TokenKind::Keyword && (t.raw == "break" || t.raw == "continue") && ld == 0 {
      has_bc = true
    }
    i = i + 1
  }
  (has_ret, has_bc)
}

fn le_scan_try_control_flow(tokens : Array[Token], s : Int, e : Int) -> (Bool, Bool) {
  le_scan_try_control_flow_depth(tokens, s, e, 0)
}

///| Locate `catch` or `catch!` after a `try` expression starting at `try_i`.
///| Returns `(body_s, body_e, catch_i, is_catch_bang, catch_lb, catch_rb)`.
fn le_find_try_parts(tokens : Array[Token], try_i : Int, end : Int) -> (Int, Int, Int, Bool, Int, Int) {
  let mut body_s = try_i + 1
  let mut body_e = try_i + 1
  let mut catch_i = -1
  if try_i + 1 < end && tokens[try_i + 1].kind == TokenKind::LBrace {
    let tb = find_matching_delim(tokens, try_i + 1)
    body_s = try_i + 2
    body_e = tb
    if tb + 1 < end && le_is_kw(tokens[tb + 1], "catch") {
      catch_i = tb + 1
    }
  } else {
    let mut sc = try_i + 1
    let mut sd = 0
    while sc < end {
      if sd == 0 {
        if le_is_kw(tokens[sc], "catch") {
          catch_i = sc
          break
        }
        if tokens[sc].kind == TokenKind::Semi || tokens[sc].kind == TokenKind::RBrace ||
        tokens[sc].kind == TokenKind::RParen || tokens[sc].kind == TokenKind::RBracket ||
        (sc > try_i + 1 && tokens[sc].newline_before) {
          break
        }
      }
      sd = le_step_depth(tokens[sc].kind, sd)
      sc = sc + 1
    }
    body_e = catch_i
  }
  if catch_i < 0 {
    return (body_s, body_e, -1, false, -1, -1)
  }
  if catch_i + 2 < end && tokens[catch_i + 1].kind == TokenKind::Bang && tokens[catch_i + 2].kind == TokenKind::LBrace {
    let clb = catch_i + 2
    let crb = find_matching_delim(tokens, clb)
    return (body_s, body_e, catch_i, true, clb, crb)
  }
  if catch_i + 1 < end && tokens[catch_i + 1].kind == TokenKind::LBrace {
    let clb = catch_i + 1
    let crb = find_matching_delim(tokens, clb)
    return (body_s, body_e, catch_i, false, clb, crb)
  }
  (body_s, body_e, catch_i, false, -1, -1)
}

///| Check if postfix `catch { ... }` or `catch! { ... }` immediately follows token index `rp`.
///| Returns `Some((is_catch_bang, catch_lb, catch_rb))`.
fn le_match_postfix_catch(tokens : Array[Token], rp : Int, end : Int) -> Option[(Bool, Int, Int)] {
  if rp + 1 >= end || !le_is_kw(tokens[rp + 1], "catch") {
    return None
  }
  if rp + 3 < end && tokens[rp + 2].kind == TokenKind::Bang && tokens[rp + 3].kind == TokenKind::LBrace {
    let clb = rp + 3
    return Some((true, clb, find_matching_delim(tokens, clb)))
  }
  if rp + 2 < end && tokens[rp + 2].kind == TokenKind::LBrace {
    let clb = rp + 2
    return Some((false, clb, find_matching_delim(tokens, clb)))
  }
  None
}

///| Infer the concrete error type raised inside `[s, e)`.
///| Returns `(has_known, has_unknown_ext, err_ty, is_mixed)`.
fn le_analyze_try_body_sh(
  st : LeState,
  tokens : Array[Token],
  s : Int,
  e : Int,
  init_fail_sh : Bool,
) -> (Bool, Bool, String, Bool) {
  le_analyze_try_body_sh_ex(st, tokens, s, e, init_fail_sh, false)
}

fn le_analyze_try_body_sh_ex(
  st : LeState,
  tokens : Array[Token],
  s : Int,
  e : Int,
  init_fail_sh : Bool,
  init_in_arms : Bool,
) -> (Bool, Bool, String, Bool) {
  let mut has_known = false
  let mut has_unknown_ext = false
  let mut found_et = ""
  let mut mixed_et = false
  let shadow_fail : Array[Bool] = [init_fail_sh]
  let arm_block_lbraces : Map[Int, Bool] = Map()
  let in_arm_block_stack : Array[Bool] = [init_in_arms]
  let mut i = s
  while i < e {
    let t = tokens[i]
    let mut cand_et = ""
    if t.kind == TokenKind::Keyword && (t.raw == "match" || t.raw == "loop") {
      let mlb = le_find_match_lbrace(tokens, i, e)
      if mlb >= 0 { arm_block_lbraces[mlb] = true }
    }
    if t.kind == TokenKind::LParen || t.kind == TokenKind::LBracket {
      in_arm_block_stack.push(false)
    } else if t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket {
      if in_arm_block_stack.length() > 1 { let _ = in_arm_block_stack.pop() }
    }
    if t.kind == TokenKind::LBrace {
      shadow_fail.push(false)
      in_arm_block_stack.push(arm_block_lbraces.contains(i))
      i = i + 1
      continue
    }
    if t.kind == TokenKind::RBrace {
      if shadow_fail.length() > 1 { let _ = shadow_fail.pop() }
      if in_arm_block_stack.length() > 1 { let _ = in_arm_block_stack.pop() }
      i = i + 1
      continue
    }
    if t.kind == TokenKind::Keyword && t.raw == "let" {
      let ni = if i + 1 < e && tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut" { i + 2 } else { i + 1 }
      if ni < e && tokens[ni].kind == TokenKind::Ident && tokens[ni].raw == "fail" {
        shadow_fail[shadow_fail.length() - 1] = true
      }
    }
    // Skip inner `fn` and arrow closures (their internal raises belong to the closure, not this `try`)
    if t.kind == TokenKind::Keyword && t.raw == "fn" {
      let mut j = i + 1
      while j < e && tokens[j].kind != TokenKind::LBrace {
        j = if tokens[j].kind == TokenKind::LParen || tokens[j].kind == TokenKind::LBracket {
          find_matching_delim(tokens, j) + 1
        } else {
          j + 1
        }
      }
      if j < e && tokens[j].kind == TokenKind::LBrace {
        i = find_matching_delim(tokens, j) + 1
        continue
      }
    }
    let in_arm_block = in_arm_block_stack[in_arm_block_stack.length() - 1]
    let allow_arrow = !in_arm_block || (i > s && tokens[i - 1].kind == TokenKind::FatArrow)
    if allow_arrow && (t.kind == TokenKind::Ident || t.kind == TokenKind::Underscore || t.raw == "_") && i + 2 < e &&
    tokens[i + 1].kind == TokenKind::FatArrow &&
    !(i > s && tokens[i - 1].kind == TokenKind::Dot) {
      if tokens[i + 2].kind == TokenKind::LBrace {
        i = find_matching_delim(tokens, i + 2) + 1
      } else {
        i = le_find_stmt_expr_end(tokens, i + 2, e)
      }
      continue
    }
    if allow_arrow && t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp + 2 < e && tokens[cp + 1].kind == TokenKind::FatArrow && le_looks_like_arrow_params(tokens, i, cp) {
        if tokens[cp + 2].kind == TokenKind::LBrace {
          i = find_matching_delim(tokens, cp + 2) + 1
        } else {
          i = le_find_stmt_expr_end(tokens, cp + 2, e)
        }
        continue
      }
    }
    // Inner `try`: its body's errors are caught by its own `catch`, EXCEPT if its `catch` rethrows (`catch!` or `raise`)!
    if le_is_kw(t, "try") {
      if i + 1 < e && (tokens[i + 1].kind == TokenKind::Question || tokens[i + 1].kind == TokenKind::Bang) {
        let es = i + 2
        let ee = if es < e && tokens[es].kind == TokenKind::LBrace {
          find_matching_delim(tokens, es) + 1
        } else {
          le_find_try_expr_end(tokens, es, e)
        }
        i = ee
        continue
      }
      let (ibs, ibe, _, is_cb, clb, crb) = le_find_try_parts(tokens, i, e)
      if clb >= 0 && crb >= clb {
        let mut fail_sh = false
        for sfv in shadow_fail { if sfv { fail_sh = true } }
        let (ihk, ihu, iet, imix) = le_analyze_try_body_sh_ex(st, tokens, ibs, ibe, fail_sh, false)
        // Check if inner `catch` rethrows (via `catch!` or explicit `raise` inside `catch` arms)
        let (chk, chu, cet, cmix) = le_analyze_try_body_sh_ex(st, tokens, clb + 1, crb, fail_sh, true)
        if chk {
          has_known = true
          if cmix { mixed_et = true }
          let eff_cet = if cet.length() > 0 { cet } else { iet }
          if eff_cet.length() > 0 {
            if found_et.length() == 0 { found_et = eff_cet } else if found_et != eff_cet { mixed_et = true }
          }
        }
        if chu { has_unknown_ext = true }
        if is_cb && ihk {
          has_known = true
          if imix { mixed_et = true }
          if ihu { has_unknown_ext = true }
          if iet.length() > 0 {
            if found_et.length() == 0 { found_et = iet } else if found_et != iet { mixed_et = true }
          }
        }
        let mut after_inner = crb + 1
        if crb + 2 < e && le_is_kw(tokens[crb + 1], "noraise") && tokens[crb + 2].kind == TokenKind::LBrace {
          let nlb = crb + 2
          let nrb = find_matching_delim(tokens, nlb)
          let (nhk, nhu, net, nmix) = le_analyze_try_body_sh_ex(st, tokens, nlb + 1, nrb, fail_sh, true)
          if nhk {
            has_known = true
            if nmix { mixed_et = true }
            if net.length() > 0 {
              if found_et.length() == 0 { found_et = net } else if found_et != net { mixed_et = true }
            }
          }
          if nhu { has_unknown_ext = true }
          after_inner = nrb + 1
        }
        i = after_inner
        continue
      }
    }
    let mut fail_sh = false
    for sfv in shadow_fail { if sfv { fail_sh = true } }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) {
        if p.is_expr {
          let ht = lex_moonbit(p.text)
          let (hk, hu, het, hmix) = le_analyze_try_body_sh(st, ht, 0, ht.length() - 1, fail_sh)
          if hk { has_known = true }
          if hu { has_unknown_ext = true }
          if hmix { mixed_et = true }
          if het.length() > 0 {
            if found_et.length() == 0 { found_et = het } else if found_et != het { mixed_et = true }
          }
        }
      }
      i = i + 1
      continue
    }
    if le_is_kw(t, "raise") {
      has_known = true
      let ee = le_find_stmt_expr_end(tokens, i + 1, e)
      cand_et = le_infer_raise_expr_err_ty(st, tokens, i + 1, ee)
    } else if !fail_sh && le_is_builtin_fail(st, tokens, i, s, e) {
      has_known = true
      st.need_failure = true
      cand_et = st.failure_enum
    } else if t.kind == TokenKind::PkgRef && i + 3 < e &&
    tokens[i + 1].kind == TokenKind::Dot && tokens[i + 3].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, i + 3)
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let fn_name = tokens[i + 2].raw
      match le_resolve_external_call(st, raw_pkg, fn_name) {
        Some((_, et)) => {
          match le_match_postfix_catch(tokens, rp, e) {
            Some((is_cb, clb, crb)) => {
              let (ahk, ahu, aet, amix) = le_analyze_try_body_sh(st, tokens, i + 4, rp, fail_sh)
              if ahk { has_known = true }
              if ahu { has_unknown_ext = true }
              if amix { mixed_et = true }
              if aet.length() > 0 {
                if found_et.length() == 0 { found_et = aet } else if found_et != aet { mixed_et = true }
              }
              if is_cb {
                has_known = true
                if found_et.length() == 0 { found_et = et } else if found_et != et { mixed_et = true }
              }
              let (chk, chu, cet, cmix) = le_analyze_try_body_sh_ex(st, tokens, clb + 1, crb, fail_sh, true)
              if chk {
                has_known = true
                if cmix { mixed_et = true }
                let eff = if cet.length() > 0 { cet } else { et }
                if eff.length() > 0 {
                  if found_et.length() == 0 { found_et = eff } else if found_et != eff { mixed_et = true }
                }
              }
              if chu { has_unknown_ext = true }
              i = crb + 1
              continue
            }
            None => {
              has_known = true
              cand_et = et
            }
          }
        }
        None =>
        if !le_is_known_dep_pkg(st, raw_pkg) && !le_is_known_non_raising_stdlib(st.env, raw_pkg, fn_name) {
          has_unknown_ext = true
        }
      }
    } else if t.kind == TokenKind::UpperIdent && i + 3 < e &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::Ident &&
    tokens[i + 3].kind == TokenKind::LParen {
      let qk = t.raw + "::" + tokens[i + 2].raw
      let rp = find_matching_delim(tokens, i + 3)
      match st.pkg_raise_methods.get(qk) {
        Some(et) =>
        match le_match_postfix_catch(tokens, rp, e) {
          Some((is_cb, clb, crb)) => {
            let (ahk, ahu, aet, amix) = le_analyze_try_body_sh(st, tokens, i + 4, rp, fail_sh)
            if ahk { has_known = true }
            if ahu { has_unknown_ext = true }
            if amix { mixed_et = true }
            if aet.length() > 0 {
              if found_et.length() == 0 { found_et = aet } else if found_et != aet { mixed_et = true }
            }
            if is_cb {
              has_known = true
              if found_et.length() == 0 { found_et = et } else if found_et != et { mixed_et = true }
            }
            let (chk, chu, cet, cmix) = le_analyze_try_body_sh_ex(st, tokens, clb + 1, crb, fail_sh, true)
            if chk {
              has_known = true
              if cmix { mixed_et = true }
              let eff = if cet.length() > 0 { cet } else { et }
              if eff.length() > 0 {
                if found_et.length() == 0 { found_et = eff } else if found_et != eff { mixed_et = true }
              }
            }
            if chu { has_unknown_ext = true }
            i = crb + 1
            continue
          }
          None => { has_known = true; cand_et = et }
        }
        None =>
        if rp + 3 < e && tokens[rp + 1].kind == TokenKind::Dot && tokens[rp + 2].kind == TokenKind::Ident && tokens[rp + 3].kind == TokenKind::LParen {
          match st.pkg_fn_ret_types.get(qk) {
            Some(rt) =>
            match st.pkg_raise_methods.get(rt + "::" + tokens[rp + 2].raw) {
              Some(et) => { has_known = true; cand_et = et }
              None => ()
            }
            None => ()
          }
        }
      }
    } else if t.kind == TokenKind::Ident && i + 3 < e &&
    tokens[i + 1].kind == TokenKind::Dot && tokens[i + 2].kind == TokenKind::Ident &&
    tokens[i + 3].kind == TokenKind::LParen &&
    !(i > s && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      let mn = tokens[i + 2].raw
      let rp = find_matching_delim(tokens, i + 3)
      if st.pkg_raise_method_names.contains(mn) {
        let rty = le_lookup_var_type(st, t.raw)
        if rty.length() > 0 {
          match st.pkg_raise_methods.get(rty + "::" + mn) {
            Some(et) =>
            match le_match_postfix_catch(tokens, rp, e) {
              Some((is_cb, clb, crb)) => {
                let (ahk, ahu, aet, amix) = le_analyze_try_body_sh(st, tokens, i + 4, rp, fail_sh)
                if ahk { has_known = true }
                if ahu { has_unknown_ext = true }
                if amix { mixed_et = true }
                if aet.length() > 0 {
                  if found_et.length() == 0 { found_et = aet } else if found_et != aet { mixed_et = true }
                }
                if is_cb {
                  has_known = true
                  if found_et.length() == 0 { found_et = et } else if found_et != et { mixed_et = true }
                }
                let (chk, chu, cet, cmix) = le_analyze_try_body_sh_ex(st, tokens, clb + 1, crb, fail_sh, true)
                if chk {
                  has_known = true
                  if cmix { mixed_et = true }
                  let eff = if cet.length() > 0 { cet } else { et }
                  if eff.length() > 0 {
                    if found_et.length() == 0 { found_et = eff } else if found_et != eff { mixed_et = true }
                  }
                }
                if chu { has_unknown_ext = true }
                i = crb + 1
                continue
              }
              None => { has_known = true; cand_et = et }
            }
            None => ()
          }
        }
      }
    } else if t.kind == TokenKind::Ident && i + 1 < e && tokens[i + 1].kind == TokenKind::LParen &&
    !(i > s && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      let rp = find_matching_delim(tokens, i + 1)
      match le_lookup_raise_fn(st, t.raw) {
        Some(et) =>
        match le_match_postfix_catch(tokens, rp, e) {
          Some((is_cb, clb, crb)) => {
            let (ahk, ahu, aet, amix) = le_analyze_try_body_sh(st, tokens, i + 2, rp, fail_sh)
            if ahk { has_known = true }
            if ahu { has_unknown_ext = true }
            if amix { mixed_et = true }
            if aet.length() > 0 {
              if found_et.length() == 0 { found_et = aet } else if found_et != aet { mixed_et = true }
            }
            if is_cb {
              has_known = true
              if found_et.length() == 0 { found_et = et } else if found_et != et { mixed_et = true }
            }
            let (chk, chu, cet, cmix) = le_analyze_try_body_sh_ex(st, tokens, clb + 1, crb, fail_sh, true)
            if chk {
              has_known = true
              if cmix { mixed_et = true }
              let eff = if cet.length() > 0 { cet } else { et }
              if eff.length() > 0 {
                if found_et.length() == 0 { found_et = eff } else if found_et != eff { mixed_et = true }
              }
            }
            if chu { has_unknown_ext = true }
            i = crb + 1
            continue
          }
          None => { has_known = true; cand_et = et }
        }
        None =>
        if !le_is_lex_bound(st, t.raw) && rp + 3 < e && tokens[rp + 1].kind == TokenKind::Dot &&
        tokens[rp + 2].kind == TokenKind::Ident && tokens[rp + 3].kind == TokenKind::LParen {
          match st.pkg_fn_ret_types.get(t.raw) {
            Some(rt) =>
            match st.pkg_raise_methods.get(rt + "::" + tokens[rp + 2].raw) {
              Some(et) => { has_known = true; cand_et = et }
              None => ()
            }
            None => ()
          }
        }
      }
    }
    if cand_et.length() > 0 {
      if found_et.length() == 0 {
        found_et = cand_et
      } else if found_et != cand_et {
        mixed_et = true
      }
    }
    i = i + 1
  }
  (has_known, has_unknown_ext, found_et, mixed_et)
}

fn le_analyze_try_body(st : LeState, tokens : Array[Token], s : Int, e : Int) -> (Bool, Bool) {
  let (hk, hu, _, _) = le_analyze_try_body_sh(st, tokens, s, e, false)
  (hk, hu)
}

///| Check whether a constructor pattern's argument list `( ... )` is fully irrefutable.
fn le_is_irrefutable_ctor_args(tokens : Array[Token], lp : Int, rp : Int) -> Bool {
  // Single `()` Unit literal payload: `C(())` is irrefutable
  if lp + 3 == rp && tokens[lp + 1].kind == TokenKind::LParen && tokens[lp + 2].kind == TokenKind::RParen {
    return true
  }
  let mut k = lp + 1
  while k < rp {
    let tk = tokens[k]
    if tk.kind == TokenKind::Comma {
      k = k + 1
      continue
    }
    // `..` rest pattern
    if tk.raw == ".." {
      k = k + 1
      continue
    }
    // `_` wildcard
    if tk.kind == TokenKind::Underscore || (tk.kind == TokenKind::Ident && tk.raw == "_") {
      k = k + 1
      continue
    }
    // `()` Unit literal argument
    if tk.kind == TokenKind::LParen && k + 1 < rp && tokens[k + 1].kind == TokenKind::RParen &&
    (k + 2 == rp || tokens[k + 2].kind == TokenKind::Comma) {
      k = k + 2
      continue
    }
    // Plain variable binding `x`, labeled pun `x~`, or labeled irrefutable `x: _` / `x: y`
    if tk.kind == TokenKind::Ident {
      if k + 1 < rp && tokens[k + 1].kind == TokenKind::Tilde {
        k = k + 2
        continue
      }
      if k + 2 < rp && tokens[k + 1].kind == TokenKind::Colon {
        let vt = tokens[k + 2]
        if vt.kind == TokenKind::Underscore || vt.kind == TokenKind::Ident {
          if k + 3 == rp || tokens[k + 3].kind == TokenKind::Comma {
            k = k + 3
            continue
          }
        }
        return false
      }
      if k + 1 == rp || tokens[k + 1].kind == TokenKind::Comma {
        k = k + 1
        continue
      }
      return false
    }
    return false
  }
  true
}

///| Check whether a constructor pattern's argument list `( ... )` is a single Bool literal `(true)` or `(false)`.
fn le_ctor_single_bool_lit(tokens : Array[Token], lp : Int, rp : Int) -> String {
  let mut s = lp + 1
  let mut e = rp
  if e > s && tokens[e - 1].kind == TokenKind::Comma {
    e = e - 1
  }
  while s < e && tokens[s].kind == TokenKind::LParen && find_matching_delim(tokens, s) + 1 == e {
    s = s + 1
    e = e - 1
  }
  if s + 1 == e && (tokens[s].raw == "true" || tokens[s].raw == "false") {
    return tokens[s].raw
  }
  ""
}

///| Check whether a single unguarded pattern slice `[ps0, pe0)` covers all errors, a specific constructor,
///| or a single Bool literal constructor payload.
///| Returns `(covers_all, covered_ctor_name, bool_ctor_name, bool_lit_val)`.
fn le_check_single_pat(tokens : Array[Token], ps0 : Int, pe0 : Int) -> (Bool, String, String, String) {
  let mut ps = ps0
  let mut pe = pe0
  while ps < pe && tokens[ps].kind == TokenKind::LParen && find_matching_delim(tokens, ps) + 1 == pe {
    ps = ps + 1
    pe = pe - 1
  }
  if ps >= pe {
    return (false, "", "", "")
  }
  // Wildcard `_` or plain variable binding `e`
  if ps + 1 == pe {
    if tokens[ps].kind == TokenKind::Underscore || tokens[ps].kind == TokenKind::Ident {
      return (true, "", "", "")
    }
    if tokens[ps].kind == TokenKind::UpperIdent {
      return (false, tokens[ps].raw, "", "")
    }
    return (false, "", "", "")
  }
  // Skip optional `@pkg.` and `Enum::` prefixes to find the constructor `UpperIdent`
  let mut k = ps
  if k + 2 <= pe && tokens[k].kind == TokenKind::PkgRef && tokens[k + 1].kind == TokenKind::Dot {
    k = k + 2
  }
  while k + 2 < pe && tokens[k].kind == TokenKind::UpperIdent && tokens[k + 1].kind == TokenKind::ColonColon {
    k = k + 2
  }
  if k >= pe || tokens[k].kind != TokenKind::UpperIdent {
    return (false, "", "", "")
  }
  let cname = tokens[k].raw
  if k + 1 == pe {
    return (false, cname, "", "")
  }
  if k + 1 < pe && tokens[k + 1].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, k + 1)
    if rp + 1 == pe {
      if le_is_irrefutable_ctor_args(tokens, k + 1, rp) {
        return (false, cname, "", "")
      }
      let bl = le_ctor_single_bool_lit(tokens, k + 1, rp)
      if bl.length() > 0 {
        return (false, "", cname, bl)
      }
    }
  }
  (false, "", "", "")
}

///| Validate `Failure` catch arms (forbid binding `Failure(m)` payload or bare variable)
///| and check MoonBit exhaustiveness of `catch { ... }` for error type `canon_et`.
///| Returns `true` iff the `catch` arms are provably exhaustive.
fn le_validate_and_check_catch(
  st : LeState,
  tokens : Array[Token],
  lb : Int,
  rb : Int,
  canon_et : String,
) -> Bool {
  let is_failure = canon_et == st.failure_enum || canon_et == "Failure"
  let mut covers_all = false
  let covered_ctors : Map[String, Bool] = Map()
  let covered_bool_true : Map[String, Bool] = Map()
  let covered_bool_false : Map[String, Bool] = Map()
  let mut k = lb + 1
  let mut d = 0
  let mut arm_s = k
  let mut cur_fa = -1
  while k <= rb {
    if k < rb && d == 0 && cur_fa < 0 && tokens[k].kind == TokenKind::FatArrow {
      cur_fa = k
    }
    let is_end = k == rb || (d == 0 && (tokens[k].kind == TokenKind::Semi ||
      (cur_fa >= 0 && tokens[k].kind == TokenKind::Comma) ||
      (cur_fa >= 0 && k > cur_fa + 1 && tokens[k].newline_before)))
    if is_end {
      if cur_fa >= arm_s && cur_fa < k {
        // Find optional guard `if ...` at depth 0
        let mut gi = -1
        let mut gd = 0
        let mut p = arm_s
        while p < cur_fa {
          if gd == 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "if" {
            gi = p
            break
          }
          gd = le_step_depth(tokens[p].kind, gd)
          p = p + 1
        }
        let pat_e = if gi >= 0 { gi } else { cur_fa }
        // Check `Failure` and opaque stdlib error pattern restrictions:
        // - `canon_et == "__stdlib_err__"` ONLY permits `_` wildcard patterns (no bindings, no constructors).
        // - `Failure` forbids any identifier binding (including `(e)`, `_ | e`, `Failure(m)`).
        if canon_et == "__stdlib_err__" {
          let mut s_seg = arm_s
          let mut s_d = 0
          let mut s_p = arm_s
          while s_p <= pat_e {
            if s_p == pat_e || (s_d == 0 && tokens[s_p].kind == TokenKind::Pipe) {
              let mut ps = s_seg
              let mut pe = s_p
              while ps < pe && tokens[ps].kind == TokenKind::LParen && find_matching_delim(tokens, ps) + 1 == pe {
                ps = ps + 1
                pe = pe - 1
              }
              let ok_wild = ps + 1 == pe && (tokens[ps].kind == TokenKind::Underscore || (tokens[ps].kind == TokenKind::Ident && tokens[ps].raw == "_"))
              if !ok_wild {
                let err_tok = if ps < pat_e { tokens[ps] } else { tokens[arm_s] }
                le_unsup(st, err_tok.line, err_tok.col, "opaque stdlib error `catch` only supports `_` wildcard pattern")
              }
              s_seg = s_p + 1
            }
            if s_p < pat_e { s_d = le_step_depth(tokens[s_p].kind, s_d) }
            s_p = s_p + 1
          }
        } else if is_failure {
          let mut fp = arm_s
          while fp < pat_e {
            let pt = tokens[fp]
            if pt.kind == TokenKind::Ident && pt.raw != "_" &&
            !(fp > arm_s && (tokens[fp - 1].kind == TokenKind::Dot || tokens[fp - 1].kind == TokenKind::ColonColon)) &&
            !(fp + 1 < pat_e && tokens[fp + 1].kind == TokenKind::Colon) {
              le_unsup(st, pt.line, pt.col, "binding error value `" + pt.raw + "` for `Failure` is unsupported")
            }
            fp = fp + 1
          }
        }
        // Exhaustiveness contribution: guarded arms NEVER count
        if gi < 0 {
          let mut seg_s = arm_s
          let mut sd = 0
          let mut sp = arm_s
          while sp <= pat_e {
            if sp == pat_e || (sd == 0 && tokens[sp].kind == TokenKind::Pipe) {
              let (ca, cn, bcn, bval) = le_check_single_pat(tokens, seg_s, sp)
              if ca { covers_all = true }
              if cn.length() > 0 { covered_ctors[cn] = true }
              if bcn.length() > 0 && bval == "true" { covered_bool_true[bcn] = true }
              if bcn.length() > 0 && bval == "false" { covered_bool_false[bcn] = true }
              seg_s = sp + 1
            }
            if sp < pat_e { sd = le_step_depth(tokens[sp].kind, sd) }
            sp = sp + 1
          }
        }
      }
      if k < rb && (tokens[k].kind == TokenKind::Semi || (cur_fa >= 0 && tokens[k].kind == TokenKind::Comma)) {
        arm_s = k + 1
      } else {
        arm_s = k
      }
      cur_fa = -1
    }
    if k < rb { d = le_step_depth(tokens[k].kind, d) }
    k = k + 1
  }
  if covers_all {
    return true
  }
  if is_failure {
    return covered_ctors.contains("Failure")
  }
  match st.suberror_variants.get(canon_et) {
    Some(variants) => {
      if variants.length() == 0 { return false }
      for v in variants {
        if covered_ctors.contains(v) {
          continue
        }
        if covered_bool_true.contains(v) && covered_bool_false.contains(v) {
          match st.suberror_variant_fields.get(canon_et + "::" + v) {
            Some(fs) => if fs.length() == 1 && fs[0] == "Bool" { continue }
            None => ()
          }
        }
        return false
      }
      return true
    }
    None => ()
  }
  match le_lookup_dep_error_ctors(st.env, canon_et) {
    Some(dep_vars) => {
      if dep_vars.length() == 0 { return false }
      for dv in dep_vars {
        if covered_ctors.contains(dv.0) {
          continue
        }
        if covered_bool_true.contains(dv.0) && covered_bool_false.contains(dv.0) {
          match le_lookup_dep_error_ctor_fields(st.env, canon_et, dv.0) {
            Some(fs) => if fs.length() == 1 && fs[0] == "Bool" { continue }
            None => ()
          }
        }
        return false
      }
      return true
    }
    None => ()
  }
  false
}

///| Check if `{ ... }` arms represent a single wildcard arm `_ => <body>`.
fn le_match_single_wildcard_arm(tokens : Array[Token], lb : Int, rb : Int) -> Option[(Int, Int)] {
  let mut s = lb + 1
  while s < rb && (tokens[s].kind == TokenKind::Semi || tokens[s].kind == TokenKind::Comma) {
    s = s + 1
  }
  let mut e = rb
  while e > s && (tokens[e - 1].kind == TokenKind::Semi || tokens[e - 1].kind == TokenKind::Comma) {
    e = e - 1
  }
  if s + 2 >= e {
    return None
  }
  let is_wild = tokens[s].kind == TokenKind::Underscore || (tokens[s].kind == TokenKind::Ident && tokens[s].raw == "_")
  if !is_wild || tokens[s + 1].kind != TokenKind::FatArrow {
    return None
  }
  let mut k = s + 2
  let mut d = 0
  while k < e {
    if d == 0 && tokens[k].kind == TokenKind::FatArrow {
      return None
    }
    d = le_step_depth(tokens[k].kind, d)
    k = k + 1
  }
  Some((s + 2, e))
}

///| Check if `{ ... }` arms represent a single simple variable binding arm `v => <body>`.
fn le_match_single_var_arm(tokens : Array[Token], lb : Int, rb : Int) -> Option[(String, Int, Int)] {
  let mut s = lb + 1
  while s < rb && (tokens[s].kind == TokenKind::Semi || tokens[s].kind == TokenKind::Comma) {
    s = s + 1
  }
  let mut e = rb
  while e > s && (tokens[e - 1].kind == TokenKind::Semi || tokens[e - 1].kind == TokenKind::Comma) {
    e = e - 1
  }
  if s + 2 >= e {
    return None
  }
  if tokens[s].kind != TokenKind::Ident || tokens[s + 1].kind != TokenKind::FatArrow {
    return None
  }
  let mut k = s + 2
  let mut d = 0
  while k < e {
    if d == 0 && tokens[k].kind == TokenKind::FatArrow {
      return None
    }
    d = le_step_depth(tokens[k].kind, d)
    k = k + 1
  }
  Some((tokens[s].raw, s + 2, e))
}

fn le_lower_match_arms_with_err_ty(
  st : LeState,
  src : String,
  tokens : Array[Token],
  lb : Int,
  rb : Int,
  catch_err_ty : String,
) -> String {
  let sb = StringBuilder()
  let mut k = lb + 1
  let mut d = 0
  let mut arm_s = k
  let mut cur_fa = -1
  while k <= rb {
    if k < rb && d == 0 && cur_fa < 0 && tokens[k].kind == TokenKind::FatArrow {
      cur_fa = k
    }
    let is_end = k == rb || (d == 0 && (tokens[k].kind == TokenKind::Semi ||
      (cur_fa >= 0 && tokens[k].kind == TokenKind::Comma) ||
      (cur_fa >= 0 && k > cur_fa + 1 && tokens[k].newline_before)))
    if is_end {
      if cur_fa >= arm_s && cur_fa < k {
        let mut gi = -1
        let mut gd = 0
        let mut p = arm_s
        while p < cur_fa {
          if gd == 0 && tokens[p].kind == TokenKind::Keyword && tokens[p].raw == "if" {
            gi = p
            break
          }
          gd = le_step_depth(tokens[p].kind, gd)
          p = p + 1
        }
        let pat_e = if gi >= 0 { gi } else { cur_fa }
        let vm : Map[String, String] = Map()
        let cm : Map[String, String] = Map()
        let evm : Map[String, String] = Map()
        le_shadow_pat_idents(tokens, arm_s, pat_e, vm, cm)
        if catch_err_ty.length() > 0 && pat_e == arm_s + 1 && tokens[arm_s].kind == TokenKind::Ident && tokens[arm_s].raw != "_" {
          evm[tokens[arm_s].raw] = catch_err_ty
        }
        st.lex_var_types.push(vm)
        st.lex_raise_closures.push(cm)
        st.lex_err_vars.push(evm)
        let mut pk = arm_s
        while pk < pat_e {
          sb.write_string(tokens[pk].leading_trivia + tokens[pk].raw)
          pk = pk + 1
        }
        if gi >= 0 {
          sb.write_string(le_lower_range(st, src, tokens, gi, cur_fa))
        }
        sb.write_string(tokens[cur_fa].leading_trivia + tokens[cur_fa].raw)
        sb.write_string(le_lower_range(st, src, tokens, cur_fa + 1, k))
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
      } else {
        sb.write_string(le_lower_range(st, src, tokens, arm_s, k))
      }
      if k < rb && (tokens[k].kind == TokenKind::Semi || (cur_fa >= 0 && tokens[k].kind == TokenKind::Comma)) {
        sb.write_string(tokens[k].leading_trivia + tokens[k].raw)
        arm_s = k + 1
      } else {
        arm_s = k
      }
      cur_fa = -1
    }
    if k < rb {
      d = le_step_depth(tokens[k].kind, d)
    }
    k = k + 1
  }
  sb.to_string()
}

fn le_lower_match_arms(
  st : LeState,
  src : String,
  tokens : Array[Token],
  lb : Int,
  rb : Int,
) -> String {
  le_lower_match_arms_with_err_ty(st, src, tokens, lb, rb, "")
}

///| Render the error handling body for a `catch` / `catch!` block (enforcing exact MoonBit exhaustiveness).
fn le_render_catch_body(
  st : LeState,
  src : String,
  tokens : Array[Token],
  catch_lb : Int,
  catch_rb : Int,
  canon_et : String,
  is_catch_bang : Bool,
  catch_line : Int,
  catch_col : Int,
) -> (String, String) {
  let is_exh = le_validate_and_check_catch(st, tokens, catch_lb, catch_rb, canon_et)
  let mut rethrow_arm = ""
  if !is_exh {
    if !is_catch_bang {
      le_unsup(st, catch_line, catch_col, "non-exhaustive `catch` for error type `" + canon_et + "` is unsupported")
    } else {
      match le_active_err_ty(st) {
        Some(outer_et) =>
        if outer_et.length() > 0 && outer_et != "Error" && outer_et != "__stdlib_err__" && outer_et == canon_et {
          let rt_v = le_fresh_ident(st, "__mbt_rethrow_")
          rethrow_arm = ", " + rt_v + " => " + le_active_raise_stmt(st, rt_v, catch_line, catch_col)
        } else {
          le_unsup(st, catch_line, catch_col, "`catch!` rethrow requires an enclosing raising boundary with identical error type `" + canon_et + "`")
        }
        None => le_unsup(st, catch_line, catch_col, "`catch!` rethrow outside a raising boundary is unsupported")
      }
    }
  }
  if rethrow_arm.length() == 0 {
    match le_match_single_wildcard_arm(tokens, catch_lb, catch_rb) {
      Some((bs, be)) => {
        let body = le_lower_range(st, src, tokens, bs, be).trim()
        return ("_", body)
      }
      None => ()
    }
  }
  let err_v = le_fresh_ident(st, "__mbt_err_")
  let arms = le_lower_match_arms_with_err_ty(st, src, tokens, catch_lb, catch_rb, canon_et).trim()
  (err_v, "match " + err_v + " { " + arms + rethrow_arm + " }")
}

fn le_render_catch_err_arm(
  st : LeState,
  src : String,
  tokens : Array[Token],
  catch_lb : Int,
  catch_rb : Int,
  canon_et : String,
  is_catch_bang : Bool,
  catch_line : Int,
  catch_col : Int,
) -> String {
  let (pat, body) = le_render_catch_body(st, src, tokens, catch_lb, catch_rb, canon_et, is_catch_bang, catch_line, catch_col)
  "Err(" + pat + ") => " + body
}

///| Render the `Ok(...) => ...` arm for optional `noraise { ... }` and optional `wrap_ctor`.
fn le_render_ok_arm(
  st : LeState,
  src : String,
  tokens : Array[Token],
  wrap_ctor : String,
  noraise_lb : Int,
  noraise_rb : Int,
) -> String {
  let ok_v = le_fresh_ident(st, "__mbt_ok_")
  let val_expr = if wrap_ctor.length() > 0 { wrap_ctor + "(" + ok_v + ")" } else { ok_v }
  if noraise_lb < 0 {
    return "Ok(" + ok_v + ") => " + val_expr
  }
  if wrap_ctor.length() == 0 {
    match le_match_single_var_arm(tokens, noraise_lb, noraise_rb) {
      Some((vname, bs, be)) => {
        let vm : Map[String, String] = Map()
        let cm : Map[String, String] = Map()
        vm[vname] = ""
        cm[vname] = ""
        st.lex_var_types.push(vm)
        st.lex_raise_closures.push(cm)
        st.lex_err_vars.push(Map())
        let body = le_lower_range(st, src, tokens, bs, be).trim()
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        return "Ok(" + vname + ") => " + body
      }
      None => ()
    }
  }
  let ok_arms = le_lower_match_arms(st, src, tokens, noraise_lb, noraise_rb).trim()
  "Ok(" + ok_v + ") => match " + val_expr + " { " + ok_arms + " }"
}

///| Attempt to recognize `[s0, e0)` as a single known raising call (optionally wrapped in
///| a single constructor `Ctor(call)`).
///| Returns `Some((wrap_ctor, lowered_result_call, canon_err_ty))` when matched without emitting `?`.
fn le_try_lower_direct_result_call(
  st : LeState,
  src : String,
  tokens : Array[Token],
  s0 : Int,
  e0 : Int,
) -> Option[(String, String, String)] {
  let mut s = s0
  let mut e = e0
  if s < e && tokens[s].kind == TokenKind::LBrace && find_matching_delim(tokens, s) + 1 == e {
    s = s + 1
    e = e - 1
  }
  while s < e && tokens[s].kind == TokenKind::Semi { s = s + 1 }
  while e > s && tokens[e - 1].kind == TokenKind::Semi { e = e - 1 }
  if s >= e {
    return None
  }
  // Check optional outer `Ctor(...)` wrapper: e.g. `Some(@json.parse(s))`
  let mut wrap_ctor = ""
  if tokens[s].kind == TokenKind::UpperIdent && s + 1 < e && tokens[s + 1].kind == TokenKind::LParen {
    let outer_rp = find_matching_delim(tokens, s + 1)
    if outer_rp + 1 == e {
      wrap_ctor = tokens[s].raw
      s = s + 2
      e = outer_rp
    }
  }
  // 1. `@pkg.fn(args)`
  if s + 3 < e && tokens[s].kind == TokenKind::PkgRef &&
  tokens[s + 1].kind == TokenKind::Dot && tokens[s + 3].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, s + 3)
    if rp + 1 == e {
      let raw_pkg = tokens[s].raw.slice(1, tokens[s].raw.length())
      match le_resolve_external_call(st, raw_pkg, tokens[s + 2].raw) {
        Some((target_fn, err_ty)) => {
          let (arg_k, arg_u) = le_analyze_try_body(st, tokens, s + 4, rp)
          if arg_k || arg_u { return None }
          let args = le_lower_range(st, src, tokens, s + 4, rp)
          return Some((wrap_ctor, target_fn + "(" + args + ")", err_ty))
        }
        None => return None
      }
    }
  }
  // 2. `Type::method(args)`
  if s + 3 < e && tokens[s].kind == TokenKind::UpperIdent &&
  tokens[s + 1].kind == TokenKind::ColonColon && tokens[s + 2].kind == TokenKind::Ident &&
  tokens[s + 3].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, s + 3)
    if rp + 1 == e {
      let qk = tokens[s].raw + "::" + tokens[s + 2].raw
      match st.pkg_raise_methods.get(qk) {
        Some(err_ty) => {
          let (arg_k, arg_u) = le_analyze_try_body(st, tokens, s + 4, rp)
          if arg_k || arg_u { return None }
          let args = le_lower_range(st, src, tokens, s + 4, rp)
          return Some((wrap_ctor, qk + "(" + args + ")", err_ty))
        }
        None => ()
      }
    }
  }
  // 3. `recv.method(args)`
  if s + 3 < e && tokens[s].kind == TokenKind::Ident &&
  tokens[s + 1].kind == TokenKind::Dot && tokens[s + 2].kind == TokenKind::Ident &&
  tokens[s + 3].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, s + 3)
    if rp + 1 == e {
      let mn = tokens[s + 2].raw
      let rty = le_lookup_var_type(st, tokens[s].raw)
      if rty.length() > 0 {
        match st.pkg_raise_methods.get(rty + "::" + mn) {
          Some(err_ty) => {
            let (arg_k, arg_u) = le_analyze_try_body(st, tokens, s + 4, rp)
            if arg_k || arg_u { return None }
            let args = le_lower_range(st, src, tokens, s + 4, rp)
            return Some((wrap_ctor, tokens[s].raw + "." + mn + "(" + args + ")", err_ty))
          }
          None => ()
        }
      }
    }
  }
  // 4. `fn_name(args)` or local raising closure `closure(args)`
  if s + 1 < e && tokens[s].kind == TokenKind::Ident && tokens[s + 1].kind == TokenKind::LParen {
    let rp = find_matching_delim(tokens, s + 1)
    if rp + 1 == e {
      match le_lookup_raise_fn(st, tokens[s].raw) {
        Some(err_ty) => {
          let (arg_k, arg_u) = le_analyze_try_body(st, tokens, s + 2, rp)
          if arg_k || arg_u { return None }
          let args = le_lower_range(st, src, tokens, s + 2, rp)
          return Some((wrap_ctor, tokens[s].raw + "(" + args + ")", err_ty))
        }
        None => ()
      }
    }
  }
  None
}

///| Lower a compound `try` body into either a Result IIFE (no nonlocal `return`)
///| or a `MbtTryOutcome[R, E]` IIFE (when nonlocal `return` crosses the `try` boundary).
///| Returns `Some((is_outcome, lowered_try_expr, canon_err_ty))`.
fn le_lower_compound_try(
  st : LeState,
  src : String,
  tokens : Array[Token],
  body_s : Int,
  body_e : Int,
  catch_lb : Int,
  catch_rb : Int,
  is_catch_bang : Bool,
  noraise_lb : Int,
  noraise_rb : Int,
  mode : String,
  line : Int,
  col : Int,
) -> Option[String] {
  let (has_ret, has_bc) = le_scan_try_control_flow(tokens, body_s, body_e)
  if has_bc {
    le_unsup(st, line, col, "`break`/`continue` across compound `try` boundary is unsupported")
    return None
  }
  let (has_known, has_unknown_ext, body_et, mixed_et) = le_analyze_try_body_sh(st, tokens, body_s, body_e, false)
  if mixed_et {
    le_unsup(st, line, col, "polymorphic or mixed error types inside `try` expression are unsupported")
    return None
  }
  if !has_known || has_unknown_ext {
    le_unsup(st, line, col, "cannot statically prove raising calls inside `try` expression")
    return None
  }
  let canon_et = body_et
  if has_ret {
    let src_ret = le_enclosing_source_ret_ty(st.frames)
    if canon_et.length() == 0 {
      le_unsup(st, line, col, "cannot infer concrete error type for compound `try` with `return`")
      return None
    }
    if src_ret.length() == 0 {
      le_unsup(st, line, col, "cannot infer enclosing return type for compound `try` with `return` inside unannotated closure")
      return None
    }
    st.need_outcome = true
    let emit_et = le_emit_err_ty(st, canon_et)
    let fn_v = le_fresh_ident(st, "__mbt_try_")
    let val_v = le_fresh_ident(st, "__mbt_tval_")
    let vv = le_fresh_ident(st, "__mbt_tv_")
    let rv = le_fresh_ident(st, "__mbt_tr_")
    st.frames.push(LeFrame::TryBlk(canon_et, true))
    st.lex_var_types.push(Map())
    st.lex_raise_closures.push(Map())
    st.lex_err_vars.push(Map())
    let lowered_body = le_lower_range(st, src, tokens, body_s, body_e).trim()
    let _ = st.lex_err_vars.pop()
    let _ = st.lex_raise_closures.pop()
    let _ = st.lex_var_types.pop()
    let _ = st.frames.pop()
    let unreach_call = le_emit_abort_call(st, "unreachable", line, col)
    let ok_branch = if mode == "try_q" {
      "match " + val_v + " { Some(" + vv + ") => Ok(" + vv + "); None => " + unreach_call + " }"
    } else if mode == "try_bang" {
      "match " + val_v + " { Some(" + vv + ") => " + vv + "; None => " + unreach_call + " }"
    } else if noraise_lb < 0 {
      "match " + val_v + " { Some(" + vv + ") => " + vv + "; None => " + unreach_call + " }"
    } else {
      let ok_arms = le_lower_match_arms(st, src, tokens, noraise_lb, noraise_rb).trim()
      "match " + val_v + " { Some(" + vv + ") => match " + vv + " { " + ok_arms + " }; None => " + unreach_call + " }"
    }
    let err_branch = if mode == "try_q" {
      let ev = le_fresh_ident(st, "__mbt_te_")
      "MbtTryErr(" + ev + ") => Err(" + ev + ")"
    } else if mode == "try_bang" {
      "MbtTryErr(_) => " + le_emit_abort_call(st, "try! failed", line, col)
    } else {
      let (epat, ebody) = le_render_catch_body(st, src, tokens, catch_lb, catch_rb, canon_et, is_catch_bang, line, col)
      "MbtTryErr(" + epat + ") => " + ebody
    }
    let ret_arm = "MbtTryRet(" + rv + ") => " + le_enclosing_ret_stmt(st.frames, rv)
    return Some("{ let mut " + val_v + " = None; let " + fn_v + " = fn() -> " + st.outcome_enum + "[" + src_ret + ", " + emit_et + "] { " + val_v + " = Some({ " + lowered_body + "\n}); MbtTryOk }; match " + fn_v + "() { MbtTryOk => " + ok_branch + "; " + ret_arm + "; " + err_branch + " } }")
  }
  st.frames.push(LeFrame::TryBlk(canon_et, false))
  st.lex_var_types.push(Map())
  st.lex_raise_closures.push(Map())
  st.lex_err_vars.push(Map())
  let lowered = le_lower_range(st, src, tokens, body_s, body_e).trim()
  let _ = st.lex_err_vars.pop()
  let _ = st.lex_raise_closures.pop()
  let _ = st.lex_var_types.pop()
  let _ = st.frames.pop()
  let iife_expr = "(fn() { Ok({ " + lowered + "\n}) })()"
  if mode == "try_q" {
    return Some(iife_expr)
  }
  if mode == "try_bang" {
    let ok_v = le_fresh_ident(st, "__mbt_ok_")
    return Some("match " + iife_expr + " { Ok(" + ok_v + ") => " + ok_v + ", Err(_) => " + le_emit_abort_call(st, "try! failed", line, col) + " }")
  }
  let ok_arm = le_render_ok_arm(st, src, tokens, "", noraise_lb, noraise_rb)
  let err_arm = le_render_catch_err_arm(st, src, tokens, catch_lb, catch_rb, canon_et, is_catch_bang, line, col)
  Some("match " + iife_expr + " { " + ok_arm + ", " + err_arm + " }")
}

fn le_emit_postfix_catch(
  st : LeState,
  src : String,
  tokens : Array[Token],
  call_s : Int,
  arg_s : Int,
  rp : Int,
  callee_prefix : String,
  canon_et : String,
  is_catch_bang : Bool,
  catch_lb : Int,
  catch_rb : Int,
  line : Int,
  col : Int,
) -> String {
  let (arg_k, arg_u) = le_analyze_try_body(st, tokens, arg_s, rp)
  if arg_k || arg_u {
    match le_lower_compound_try(st, src, tokens, call_s, rp + 1, catch_lb, catch_rb, is_catch_bang, -1, -1, "catch", line, col) {
      Some(expr) => return expr
      None => return src.slice(tokens[call_s].start_byte, tokens[catch_rb].end_byte)
    }
  }
  let args = le_lower_range(st, src, tokens, arg_s, rp)
  let call_s_str = callee_prefix + "(" + args + ")"
  let ok_arm = le_render_ok_arm(st, src, tokens, "", -1, -1)
  let err_arm = le_render_catch_err_arm(st, src, tokens, catch_lb, catch_rb, canon_et, is_catch_bang, line, col)
  "match " + call_s_str + " { " + ok_arm + ", " + err_arm + " }"
}

fn le_lower_range(
  st : LeState,
  src : String,
  tokens : Array[Token],
  start : Int,
  end : Int,
) -> String {
  // Hoist local named `fn foo(...)` declarations so they shadow package-level raising fns
  let mut hi = start
  let mut hd = 0
  while hi < end {
    let ht = tokens[hi]
    if hd == 0 && ht.kind == TokenKind::Keyword && ht.raw == "fn" {
      let mut ni = hi + 1
      if ni < end && tokens[ni].kind == TokenKind::LBracket { ni = find_matching_delim(tokens, ni) + 1 }
      if ni + 1 < end && tokens[ni].kind == TokenKind::Ident && tokens[ni + 1].kind == TokenKind::LParen {
        st.lex_var_types[st.lex_var_types.length() - 1][tokens[ni].raw] = ""
        st.lex_raise_closures[st.lex_raise_closures.length() - 1][tokens[ni].raw] = ""
      }
    }
    hd = le_step_depth(ht.kind, hd)
    hi = hi + 1
  }
  let sb = StringBuilder()
  let mut i = start
  while i < end {
    let t = tokens[i]
    // Block scope `{ ... }`
    if t.kind == TokenKind::LBrace {
      let rb = find_matching_delim(tokens, i)
      st.lex_var_types.push(Map())
      st.lex_raise_closures.push(Map())
      st.lex_err_vars.push(Map())
      sb.write_string(t.leading_trivia + "{" + le_lower_range(st, src, tokens, i + 1, rb) + tokens[rb].leading_trivia + "}")
      let _ = st.lex_err_vars.pop()
      let _ = st.lex_raise_closures.pop()
      let _ = st.lex_var_types.pop()
      i = rb + 1
      continue
    }
    // `let [mut] x [: Ty] = ...` tracking local var types + controlled local raising closures
    if t.kind == TokenKind::Keyword && t.raw == "let" && i + 1 < end {
      let is_mut = tokens[i + 1].kind == TokenKind::Keyword && tokens[i + 1].raw == "mut"
      let ni = if is_mut { i + 2 } else { i + 1 }
      if ni < end && tokens[ni].kind == TokenKind::Ident {
        let vname = tokens[ni].raw
        let mut eq_i = ni + 1
        let mut ann_ty = ""
        let has_type_ann = eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Colon
        if has_type_ann {
          if tokens[eq_i + 1].kind == TokenKind::UpperIdent {
            ann_ty = tokens[eq_i + 1].raw
          }
          let mut td = 0
          while eq_i < end && !(td == 0 && tokens[eq_i].kind == TokenKind::Eq) {
            td = le_step_depth(tokens[eq_i].kind, td)
            eq_i = eq_i + 1
          }
        }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq {
          // Local raising closure `let ok = fn(...) -> T raise E { ... }` (immutable, unannotated only)
          if tokens[eq_i + 1].kind == TokenKind::Keyword && tokens[eq_i + 1].raw == "fn" {
            match le_parse_fn_header(src, tokens, eq_i + 1, end) {
              Some((_, op, cp, rty, has_r, ety, has_rp, clb)) =>
              if has_r || has_rp {
                let crb = find_matching_delim(tokens, clb)
                let valid_et = ety.length() > 0 && ety != "Error" &&
                (ety == "Failure" || st.suberror_names.contains(ety) || ety.starts_with("@") || str_has(ety, "::"))
                if is_mut || has_type_ann || has_rp || !valid_et {
                  le_unsup(st, tokens[eq_i + 1].line, tokens[eq_i + 1].col, "unsupported `raise` in local closure `" + vname + "`")
                  sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[crb].end_byte))
                  i = crb + 1
                  continue
                }
                let eff_rty = if rty.length() > 0 { rty } else { "Unit" }
                let canon_et = le_canon_err_ty(st, ety)
                let emit_et = if ety == "Failure" { st.failure_enum } else { ety }
                st.lex_raise_closures[st.lex_raise_closures.length() - 1][vname] = canon_et
                st.lex_var_types[st.lex_var_types.length() - 1][vname] = ""
                st.lex_err_vars[st.lex_err_vars.length() - 1][vname] = ""
                let pm : Map[String, String] = Map()
                let cm : Map[String, String] = Map()
                le_seed_params(tokens, op, cp, "", pm, cm)
                st.lex_var_types.push(pm)
                st.lex_raise_closures.push(cm)
                st.lex_err_vars.push(Map())
                st.frames.push(LeFrame::RaisingFn(eff_rty, canon_et))
                let bt = le_lower_range(st, src, tokens, clb + 1, crb)
                let _ = st.frames.pop()
                let _ = st.lex_err_vars.pop()
                let _ = st.lex_raise_closures.pop()
                let _ = st.lex_var_types.pop()
                let tail_triv = tokens[crb].leading_trivia
                let tail_nl = if tail_triv.ends_with("\n") { "" } else { "\n" }
                let wrapped = if le_body_always_exits(tokens, clb, crb) {
                  "{" + bt + tail_triv + "}"
                } else if eff_rty == "Unit" {
                  "{" + bt + tail_triv + tail_nl + "  Ok(())\n}"
                } else {
                  "{ Ok({" + bt + tail_triv + tail_nl + "}) }"
                }
                sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + " fn" + src.slice(tokens[op].start_byte, tokens[cp].end_byte) + " -> Result[" + eff_rty + ", " + emit_et + "] " + wrapped)
                i = crb + 1
                continue
              }
              None => ()
            }
          }
          let rhs_end = le_find_stmt_expr_end(tokens, eq_i + 1, end)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + le_lower_range(st, src, tokens, eq_i + 1, rhs_end))
          let mut rhs_ce = rhs_end
          while rhs_ce > eq_i + 1 && tokens[rhs_ce - 1].kind == TokenKind::Semi { rhs_ce = rhs_ce - 1 }
          if ann_ty.length() == 0 && eq_i + 1 < rhs_ce {
            let r1 = tokens[eq_i + 1]
            if r1.kind == TokenKind::UpperIdent && eq_i + 2 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::ColonColon {
              if eq_i + 3 < rhs_ce && tokens[eq_i + 3].kind == TokenKind::LBrace && find_matching_delim(tokens, eq_i + 3) + 1 == rhs_ce {
                ann_ty = r1.raw
              } else if eq_i + 4 < rhs_ce && tokens[eq_i + 3].kind == TokenKind::Ident && tokens[eq_i + 4].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 4) + 1 == rhs_ce {
                ann_ty = match st.pkg_fn_ret_types.get(r1.raw + "::" + tokens[eq_i + 3].raw) { Some(rt) => rt, None => "" }
              }
            } else if r1.kind == TokenKind::Ident && eq_i + 2 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 2) + 1 == rhs_ce && !le_is_lex_bound(st, r1.raw) {
              match st.pkg_fn_ret_types.get(r1.raw) { Some(rt) => ann_ty = rt, None => () }
            } else if r1.kind == TokenKind::Ident && eq_i + 4 < rhs_ce && tokens[eq_i + 2].kind == TokenKind::Dot && tokens[eq_i + 3].kind == TokenKind::Ident && tokens[eq_i + 4].kind == TokenKind::LParen && find_matching_delim(tokens, eq_i + 4) + 1 == rhs_ce {
              let xr = le_lookup_var_type(st, r1.raw)
              if xr.length() > 0 {
                match st.pkg_fn_ret_types.get(xr + "::" + tokens[eq_i + 3].raw) { Some(rt) => ann_ty = rt, None => () }
              }
            }
          }
          st.lex_raise_closures[st.lex_raise_closures.length() - 1][vname] = ""
          st.lex_var_types[st.lex_var_types.length() - 1][vname] = ann_ty
          i = rhs_end
          continue
        }
      } else if ni < end {
        let mut eq_i = ni
        let mut ld = 0
        while eq_i < end && !(ld == 0 && (tokens[eq_i].kind == TokenKind::Eq || tokens[eq_i].kind == TokenKind::Semi || tokens[eq_i].kind == TokenKind::RBrace)) {
          ld = le_step_depth(tokens[eq_i].kind, ld)
          eq_i = eq_i + 1
        }
        if eq_i + 1 < end && tokens[eq_i].kind == TokenKind::Eq {
          let rhs_end = le_find_stmt_expr_end(tokens, eq_i + 1, end)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[eq_i].end_byte) + le_lower_range(st, src, tokens, eq_i + 1, rhs_end))
          le_shadow_pat_idents(tokens, ni, eq_i, st.lex_var_types[st.lex_var_types.length() - 1], st.lex_raise_closures[st.lex_raise_closures.length() - 1])
          i = rhs_end
          continue
        }
      }
    }
    // Expression-level `<expr> catch[!] { ... } [noraise { ... }]` shorthand:
    // `catch` binds looser than `&&`/`||`/`|>`, so it wraps the entire preceding expression.
    let prev_ends_stmt_c = i > start && t.newline_before && !le_is_cont_op(tokens[i - 1]) && !le_is_cont_op(t)
    let is_expr_start_c = i == start || prev_ends_stmt_c ||
    tokens[i - 1].kind == TokenKind::Eq ||
    tokens[i - 1].kind == TokenKind::Colon ||
    tokens[i - 1].kind == TokenKind::Semi ||
    tokens[i - 1].kind == TokenKind::LParen ||
    tokens[i - 1].kind == TokenKind::LBracket ||
    tokens[i - 1].kind == TokenKind::LBrace ||
    tokens[i - 1].kind == TokenKind::Comma ||
    tokens[i - 1].kind == TokenKind::FatArrow ||
    (tokens[i - 1].kind == TokenKind::Keyword &&
      (tokens[i - 1].raw == "return" || tokens[i - 1].raw == "break" ||
        tokens[i - 1].raw == "raise" || tokens[i - 1].raw == "else"))
    let is_stmt_head_c = (t.kind == TokenKind::Keyword &&
      (t.raw == "let" || t.raw == "const" || t.raw == "fn" || t.raw == "for" ||
        t.raw == "while" || t.raw == "return" || t.raw == "break" || t.raw == "continue" ||
        t.raw == "else")) ||
    le_is_kw(t, "try") || le_is_kw(t, "guard") || le_is_kw(t, "raise") ||
    le_is_kw(t, "catch") || le_is_kw(t, "noraise") ||
    t.kind == TokenKind::Semi || t.kind == TokenKind::Comma ||
    t.kind == TokenKind::RBrace || t.kind == TokenKind::RParen || t.kind == TokenKind::RBracket
    if is_expr_start_c && !is_stmt_head_c {
      let mut sc = i
      let mut sd = 0
      let mut found_catch_i = -1
      while sc < end {
        let st_t = tokens[sc]
        if sd == 0 {
          if sc > i && le_is_kw(st_t, "catch") {
            found_catch_i = sc
            break
          }
          if le_is_kw(st_t, "try") {
            if sc + 1 < end && (tokens[sc + 1].kind == TokenKind::Question || tokens[sc + 1].kind == TokenKind::Bang) {
              let es = sc + 2
              sc = if es < end && tokens[es].kind == TokenKind::LBrace {
                find_matching_delim(tokens, es) + 1
              } else {
                le_find_try_expr_end(tokens, es, end)
              }
              continue
            }
            let (_, _, _, _, clb0, crb0) = le_find_try_parts(tokens, sc, end)
            if clb0 >= 0 && crb0 >= clb0 {
              let mut nxt = crb0 + 1
              if crb0 + 2 < end && le_is_kw(tokens[crb0 + 1], "noraise") && tokens[crb0 + 2].kind == TokenKind::LBrace {
                nxt = find_matching_delim(tokens, crb0 + 2) + 1
              }
              sc = nxt
              continue
            }
          }
          if st_t.kind == TokenKind::Semi || st_t.kind == TokenKind::Comma ||
          st_t.kind == TokenKind::RBrace || st_t.kind == TokenKind::RParen ||
          st_t.kind == TokenKind::RBracket || st_t.kind == TokenKind::FatArrow ||
          st_t.kind == TokenKind::Eq ||
          (st_t.kind == TokenKind::Keyword && st_t.raw == "else") ||
          (sc > i && st_t.newline_before && !le_is_cont_op(tokens[sc - 1]) && !le_is_cont_op(st_t)) {
            break
          }
        }
        sd = le_step_depth(st_t.kind, sd)
        sc = sc + 1
      }
      if found_catch_i > i {
        match le_match_postfix_catch(tokens, found_catch_i - 1, end) {
          Some((is_cb, catch_lb, catch_rb)) => {
            let mut noraise_lb = -1
            let mut noraise_rb = -1
            let mut after_try = catch_rb + 1
            if catch_rb + 2 < end && le_is_kw(tokens[catch_rb + 1], "noraise") && tokens[catch_rb + 2].kind == TokenKind::LBrace {
              noraise_lb = catch_rb + 2
              noraise_rb = find_matching_delim(tokens, noraise_lb)
              after_try = noraise_rb + 1
            }
            match le_try_lower_direct_result_call(st, src, tokens, i, found_catch_i) {
              Some((wrap_ctor, res_call, canon_et)) => {
                let ok_arm = le_render_ok_arm(st, src, tokens, wrap_ctor, noraise_lb, noraise_rb)
                let err_arm = le_render_catch_err_arm(st, src, tokens, catch_lb, catch_rb, canon_et, is_cb, tokens[found_catch_i].line, tokens[found_catch_i].col)
                sb.write_string(t.leading_trivia + "match " + res_call + " { " + ok_arm + ", " + err_arm + " }")
              }
              None =>
              match le_lower_compound_try(st, src, tokens, i, found_catch_i, catch_lb, catch_rb, is_cb, noraise_lb, noraise_rb, "catch", tokens[found_catch_i].line, tokens[found_catch_i].col) {
                Some(expr) => sb.write_string(t.leading_trivia + expr)
                None => sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[after_try - 1].end_byte))
              }
            }
            i = after_try
            continue
          }
          None => ()
        }
      }
    }
    // `if` / `while` push lexical scope so top-level `is <pat>` binders are visible in `then`/body only
    if t.kind == TokenKind::Keyword && (t.raw == "if" || t.raw == "while") {
      let tlb = le_find_header_body_lbrace(tokens, i, end)
      if tlb >= 0 {
        let trb = find_matching_delim(tokens, tlb)
        st.lex_var_types.push(Map())
        st.lex_raise_closures.push(Map())
        st.lex_err_vars.push(Map())
        let cond_str = le_lower_cond_with_is(st, src, tokens, i + 1, tlb)
        sb.write_string(t.leading_trivia + t.raw + cond_str + tokens[tlb].leading_trivia + "{" + le_lower_range(st, src, tokens, tlb + 1, trb) + tokens[trb].leading_trivia + "}")
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        i = trb + 1
        continue
      }
    }
    // `guard <cond> else { ... }`: binders from unnegated `is <pat>` apply to subsequent `&&` and
    // statements AFTER the `else { ... }` block, never inside `else { ... }`.
    if le_is_kw(t, "guard") {
      let mut else_i = -1
      let mut gd = 0
      let mut gk = i + 1
      while gk < end {
        if gd == 0 && tokens[gk].kind == TokenKind::Keyword && tokens[gk].raw == "else" {
          else_i = gk
          break
        }
        if gd == 0 && (tokens[gk].kind == TokenKind::Semi || tokens[gk].kind == TokenKind::RBrace) {
          break
        }
        gd = le_step_depth(tokens[gk].kind, gd)
        gk = gk + 1
      }
      if else_i > i && else_i + 1 < end && tokens[else_i + 1].kind == TokenKind::LBrace {
        let elb = else_i + 1
        let erb = find_matching_delim(tokens, elb)
        let g_vm : Map[String, String] = Map()
        let g_cm : Map[String, String] = Map()
        st.lex_var_types.push(g_vm)
        st.lex_raise_closures.push(g_cm)
        st.lex_err_vars.push(Map())
        let cond_str = le_lower_cond_with_is(st, src, tokens, i + 1, else_i)
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        st.lex_var_types.push(Map())
        st.lex_raise_closures.push(Map())
        st.lex_err_vars.push(Map())
        let else_str = le_lower_range(st, src, tokens, elb + 1, erb)
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        let top = st.lex_var_types.length() - 1
        for k in g_vm.keys() { st.lex_var_types[top][k] = "" }
        for k in g_cm.keys() { st.lex_raise_closures[top][k] = "" }
        sb.write_string(t.leading_trivia + t.raw + cond_str + tokens[else_i].leading_trivia + "else" + tokens[elb].leading_trivia + "{" + else_str + tokens[erb].leading_trivia + "}")
        i = erb + 1
        continue
      }
    }
    // Positive grouping `(Some(x) is Some(g)) && ...` propagates `g` to the `&&` chain only;
    // uses a strict positive allowlist and respects newline statement boundaries.
    let prev_starts_new_stmt = i > start && t.newline_before &&
    tokens[i - 1].raw != "!" &&
    tokens[i - 1].raw != "==" && tokens[i - 1].raw != "!=" &&
    tokens[i - 1].raw != "<" && tokens[i - 1].raw != "<=" &&
    tokens[i - 1].raw != ">" && tokens[i - 1].raw != ">=" &&
    tokens[i - 1].raw != "+" && tokens[i - 1].raw != "-" &&
    tokens[i - 1].raw != "*" && tokens[i - 1].raw != "/" &&
    tokens[i - 1].raw != "%" && tokens[i - 1].raw != "|>" &&
    tokens[i - 1].kind != TokenKind::Dot && tokens[i - 1].kind != TokenKind::ColonColon
    let is_pos_group_lparen = i == start || prev_starts_new_stmt ||
    tokens[i - 1].kind == TokenKind::Eq ||
    tokens[i - 1].kind == TokenKind::Colon ||
    tokens[i - 1].kind == TokenKind::Semi ||
    tokens[i - 1].kind == TokenKind::LParen ||
    tokens[i - 1].kind == TokenKind::LBracket ||
    tokens[i - 1].kind == TokenKind::LBrace ||
    tokens[i - 1].kind == TokenKind::Comma ||
    tokens[i - 1].kind == TokenKind::FatArrow ||
    tokens[i - 1].raw == "&&" ||
    tokens[i - 1].raw == "||" ||
    (tokens[i - 1].kind == TokenKind::Keyword &&
      (tokens[i - 1].raw == "return" || tokens[i - 1].raw == "break" ||
        tokens[i - 1].raw == "raise" || tokens[i - 1].raw == "if" ||
        tokens[i - 1].raw == "while" || tokens[i - 1].raw == "guard" ||
        tokens[i - 1].raw == "else"))
    if is_pos_group_lparen && t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp + 1 < end && tokens[cp + 1].raw == "&&" {
        let p_vm : Map[String, String] = Map()
        let p_cm : Map[String, String] = Map()
        st.lex_var_types.push(p_vm)
        st.lex_raise_closures.push(p_cm)
        st.lex_err_vars.push(Map())
        let inner_s = le_lower_cond_with_is(st, src, tokens, i + 1, cp)
        if p_vm.length() > 0 || p_cm.length() > 0 {
          let ce = le_find_and_chain_end(tokens, cp + 2, end)
          let chain_s = le_lower_range(st, src, tokens, cp + 1, ce)
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          sb.write_string(t.leading_trivia + "(" + inner_s + tokens[cp].leading_trivia + ")" + chain_s)
          i = ce
          continue
        }
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        sb.write_string(t.leading_trivia + "(" + inner_s + tokens[cp].leading_trivia + ")")
        i = cp + 1
        continue
      }
    }
    // `is <pat>` outside `if`/`while`/`guard` top-level `&&`: never leaks into outer scope;
    // only scopes binders to an immediately following `&&` chain.
    if le_is_kw(t, "is") && i + 1 < end {
      let pe = le_find_is_pat_end(tokens, i + 1, end)
      if pe > i + 1 {
        sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[pe - 1].end_byte))
        if pe < end && tokens[pe].raw == "&&" {
          let ce = le_find_and_chain_end(tokens, pe + 1, end)
          let vm : Map[String, String] = Map()
          let cm : Map[String, String] = Map()
          le_shadow_pat_idents(tokens, i + 1, pe, vm, cm)
          st.lex_var_types.push(vm)
          st.lex_raise_closures.push(cm)
          st.lex_err_vars.push(Map())
          sb.write_string(le_lower_range(st, src, tokens, pe, ce))
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          i = ce
          continue
        }
        i = pe
        continue
      }
    }
    // Comparison/equality RHS `is <pat>`: MoonBit gives `is` higher precedence than `==`/`!=`/`<`/`<=`/`>`/`>=`,
    // whereas Pion parses `a == b is P` as `(a == b) is P`. Parenthesize `(b is P)` explicitly!
    if t.raw == "==" || t.raw == "!=" || t.raw == "<" || t.raw == "<=" || t.raw == ">" || t.raw == ">=" {
      let mut is_i = -1
      let mut j = i + 1
      let mut jd = 0
      while j < end {
        let jt = tokens[j]
        if jd == 0 {
          if le_is_kw(jt, "is") {
            is_i = j
            break
          }
          if jt.raw == "&&" || jt.raw == "||" || jt.raw == "|>" ||
          jt.raw == "==" || jt.raw == "!=" || jt.raw == "<" || jt.raw == "<=" || jt.raw == ">" || jt.raw == ">=" ||
          jt.kind == TokenKind::Eq || jt.raw == "+=" || jt.raw == "-=" || jt.raw == "*=" || jt.raw == "/=" || jt.raw == "%=" ||
          jt.kind == TokenKind::FatArrow ||
          jt.kind == TokenKind::Semi || jt.kind == TokenKind::Comma ||
          jt.kind == TokenKind::RParen || jt.kind == TokenKind::RBracket || jt.kind == TokenKind::RBrace ||
          (jt.kind == TokenKind::Keyword && jt.raw == "else") ||
          le_is_kw(jt, "catch") || le_is_kw(jt, "noraise") ||
          (j > i + 1 && jt.newline_before && !le_is_cont_op(tokens[j - 1]) && !le_is_cont_op(jt)) {
            break
          }
        }
        jd = le_step_depth(jt.kind, jd)
        j = j + 1
      }
      if is_i > i + 1 {
        let pe = le_find_is_pat_end(tokens, is_i + 1, end)
        if pe > is_i + 1 {
          let lhs_is = le_lower_range(st, src, tokens, i + 1, is_i).trim()
          let pat_txt = src.slice(tokens[is_i].start_byte, tokens[pe - 1].end_byte)
          sb.write_string(t.leading_trivia + t.raw + " (" + lhs_is + " " + pat_txt + ")")
          i = pe
          continue
        }
      }
    }
    // `for <pat> in <iter> { ... }` and C-style `for` shadowing loop binders
    if t.kind == TokenKind::Keyword && t.raw == "for" {
      let flb = le_find_header_body_lbrace(tokens, i, end)
      if flb >= 0 {
        let frb = find_matching_delim(tokens, flb)
        let vm : Map[String, String] = Map()
        let cm : Map[String, String] = Map()
        let mut in_i = -1
        let mut sc = i + 1
        let mut sd = 0
        while sc < flb {
          if sd == 0 && le_is_kw(tokens[sc], "in") {
            in_i = sc
            break
          }
          sd = le_step_depth(tokens[sc].kind, sd)
          sc = sc + 1
        }
        let header_str = if in_i > i {
          le_shadow_pat_idents(tokens, i + 1, in_i, vm, cm)
          src.slice(tokens[i].end_byte, tokens[in_i].end_byte) + le_lower_range(st, src, tokens, in_i + 1, flb)
        } else {
          let mut fk = i + 1
          let mut fkd = 0
          while fk < flb && !(fkd == 0 && tokens[fk].kind == TokenKind::Semi) {
            if fkd == 0 && tokens[fk].kind == TokenKind::Ident && fk + 1 < flb && tokens[fk + 1].kind == TokenKind::Eq {
              vm[tokens[fk].raw] = ""
              cm[tokens[fk].raw] = ""
            }
            fkd = le_step_depth(tokens[fk].kind, fkd)
            fk = fk + 1
          }
          le_lower_range(st, src, tokens, i + 1, flb)
        }
        st.lex_var_types.push(vm)
        st.lex_raise_closures.push(cm)
        st.lex_err_vars.push(Map())
        sb.write_string(t.leading_trivia + "for" + header_str + tokens[flb].leading_trivia + "{" + le_lower_range(st, src, tokens, flb + 1, frb) + tokens[frb].leading_trivia + "}")
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        i = frb + 1
        continue
      }
    }
    // `match <scrut> { ... }` and `loop <args> { ... }` lower arms via `le_lower_match_arms`
    if t.kind == TokenKind::Keyword && (t.raw == "match" || t.raw == "loop") {
      let found_lb = le_find_match_lbrace(tokens, i, end)
      if found_lb >= 0 {
        let mrb = find_matching_delim(tokens, found_lb)
        sb.write_string(t.leading_trivia + t.raw + le_lower_range(st, src, tokens, i + 1, found_lb) + tokens[found_lb].leading_trivia + "{" + le_lower_match_arms(st, src, tokens, found_lb, mrb) + tokens[mrb].leading_trivia + "}")
        i = mrb + 1
        continue
      }
    }
    // Arrow closures (block and expression bodies): `x => ...`, `_ => ...`, and `(a, b) => ...`
    if (t.kind == TokenKind::Ident || t.kind == TokenKind::Underscore || t.raw == "_") && i + 2 < end &&
    tokens[i + 1].kind == TokenKind::FatArrow &&
    !(i > start && tokens[i - 1].kind == TokenKind::Dot) {
      let pm : Map[String, String] = Map()
      let cm : Map[String, String] = Map()
      if t.kind == TokenKind::Ident { pm[t.raw] = ""; cm[t.raw] = "" }
      st.lex_var_types.push(pm)
      st.lex_raise_closures.push(cm)
      st.lex_err_vars.push(Map())
      st.frames.push(LeFrame::PlainFn(""))
      if tokens[i + 2].kind == TokenKind::LBrace {
        let crb = find_matching_delim(tokens, i + 2)
        sb.write_string(t.leading_trivia + t.raw + tokens[i + 1].leading_trivia + "=>" + tokens[i + 2].leading_trivia + "{" + le_lower_range(st, src, tokens, i + 3, crb) + tokens[crb].leading_trivia + "}")
        let _ = st.frames.pop()
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        i = crb + 1
      } else {
        let expr_e = le_find_stmt_expr_end(tokens, i + 2, end)
        sb.write_string(t.leading_trivia + t.raw + tokens[i + 1].leading_trivia + "=>" + le_lower_range(st, src, tokens, i + 2, expr_e))
        let _ = st.frames.pop()
        let _ = st.lex_err_vars.pop()
        let _ = st.lex_raise_closures.pop()
        let _ = st.lex_var_types.pop()
        i = expr_e
      }
      continue
    }
    if t.kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, i)
      if cp + 2 < end && tokens[cp + 1].kind == TokenKind::FatArrow && le_looks_like_arrow_params(tokens, i, cp) {
        let pm : Map[String, String] = Map()
        let cm : Map[String, String] = Map()
        le_seed_params(tokens, i, cp, "", pm, cm)
        st.lex_var_types.push(pm)
        st.lex_raise_closures.push(cm)
        st.lex_err_vars.push(Map())
        st.frames.push(LeFrame::PlainFn(""))
        if tokens[cp + 2].kind == TokenKind::LBrace {
          let crb = find_matching_delim(tokens, cp + 2)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[cp + 2].end_byte) + le_lower_range(st, src, tokens, cp + 3, crb) + tokens[crb].leading_trivia + "}")
          let _ = st.frames.pop()
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          i = crb + 1
        } else {
          let expr_e = le_find_stmt_expr_end(tokens, cp + 2, end)
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[cp + 1].end_byte) + le_lower_range(st, src, tokens, cp + 2, expr_e))
          let _ = st.frames.pop()
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          i = expr_e
        }
        continue
      }
    }
    // Inline `fn` closure: reject raising closures fail-closed, isolate non-raising closures
    if t.kind == TokenKind::Keyword && t.raw == "fn" {
      match le_parse_fn_header(src, tokens, i, end) {
        Some((lfn, op, cp, rty, has_r, _, has_rp, clb)) => {
          if lfn.length() > 0 {
            st.lex_var_types[st.lex_var_types.length() - 1][lfn] = ""
            st.lex_raise_closures[st.lex_raise_closures.length() - 1][lfn] = ""
          }
          let crb = find_matching_delim(tokens, clb)
          if has_r || has_rp {
            le_unsup(st, t.line, t.col, "unsupported raising inline closure or higher-order `raise` parameter")
          }
          let pm : Map[String, String] = Map()
          let cm : Map[String, String] = Map()
          le_seed_params(tokens, op, cp, "", pm, cm)
          st.lex_var_types.push(pm)
          st.lex_raise_closures.push(cm)
          st.lex_err_vars.push(Map())
          st.frames.push(LeFrame::PlainFn(rty))
          sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[clb].end_byte) + le_lower_range(st, src, tokens, clb + 1, crb) + tokens[crb].leading_trivia + "}")
          let _ = st.frames.pop()
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          i = crb + 1
          continue
        }
        None => ()
      }
    }
    // `try?`, `try!`, and `try <body> catch[!] { ... } [noraise { ... }]`
    if le_is_kw(t, "try") {
      // 1. `try? <expr>` and `try! <expr>`
      if i + 1 < end && (tokens[i + 1].kind == TokenKind::Question || tokens[i + 1].kind == TokenKind::Bang) {
        let is_bang = tokens[i + 1].kind == TokenKind::Bang
        let expr_s = i + 2
        let expr_e = if expr_s < end && tokens[expr_s].kind == TokenKind::LBrace {
          find_matching_delim(tokens, expr_s) + 1
        } else {
          le_find_try_expr_end(tokens, expr_s, end)
        }
        match le_try_lower_direct_result_call(st, src, tokens, expr_s, expr_e) {
          Some((wrap_ctor, res_call, _)) => {
            let res_expr = if wrap_ctor.length() == 0 {
              res_call
            } else {
              let ok_v = le_fresh_ident(st, "__mbt_ok_")
              let err_v = le_fresh_ident(st, "__mbt_err_")
              "match " + res_call + " { Ok(" + ok_v + ") => Ok(" + wrap_ctor + "(" + ok_v + ")), Err(" + err_v + ") => Err(" + err_v + ") }"
            }
            if is_bang {
              let ok_v = le_fresh_ident(st, "__mbt_ok_")
              sb.write_string(t.leading_trivia + "match " + res_expr + " { Ok(" + ok_v + ") => " + ok_v + ", Err(_) => " + le_emit_abort_call(st, "try! failed", t.line, t.col) + " }")
            } else {
              sb.write_string(t.leading_trivia + res_expr)
            }
          }
          None => {
            let (bs, be) = if expr_s < expr_e && tokens[expr_s].kind == TokenKind::LBrace && find_matching_delim(tokens, expr_s) + 1 == expr_e {
              (expr_s + 1, expr_e - 1)
            } else {
              (expr_s, expr_e)
            }
            let mode = if is_bang { "try_bang" } else { "try_q" }
            match le_lower_compound_try(st, src, tokens, bs, be, -1, -1, false, -1, -1, mode, t.line, t.col) {
              Some(expr) => sb.write_string(t.leading_trivia + expr)
              None => sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[expr_e - 1].end_byte))
            }
          }
        }
        i = expr_e
        continue
      }
      // 2. `try <body> catch[!] { ... } [noraise { ... }]`
      let (body_s, body_e, catch_i, is_catch_bang, catch_lb, catch_rb) = le_find_try_parts(tokens, i, end)
      if catch_i < 0 || catch_lb < 0 {
        le_unsup(st, t.line, t.col, "unsupported `try` without `catch { ... }`")
        sb.write_string(t.leading_trivia + t.raw)
        i = i + 1
        continue
      }
      let mut noraise_lb = -1
      let mut noraise_rb = -1
      let mut after_try = catch_rb + 1
      if catch_rb + 2 < end && le_is_kw(tokens[catch_rb + 1], "noraise") && tokens[catch_rb + 2].kind == TokenKind::LBrace {
        noraise_lb = catch_rb + 2
        noraise_rb = find_matching_delim(tokens, noraise_lb)
        after_try = noraise_rb + 1
      }
      // Fast path A & B: single raising call or `Ctor(raising_call)` -> zero-closure direct `match`
      match le_try_lower_direct_result_call(st, src, tokens, body_s, body_e) {
        Some((wrap_ctor, res_call, canon_et)) => {
          let ok_arm = le_render_ok_arm(st, src, tokens, wrap_ctor, noraise_lb, noraise_rb)
          let err_arm = le_render_catch_err_arm(st, src, tokens, catch_lb, catch_rb, canon_et, is_catch_bang, tokens[catch_i].line, tokens[catch_i].col)
          sb.write_string(t.leading_trivia + "match " + res_call + " { " + ok_arm + ", " + err_arm + " }")
          i = after_try
          continue
        }
        None => ()
      }
      // General path C: compound/multi-statement `try` body -> Result or MbtTryOutcome IIFE
      match le_lower_compound_try(st, src, tokens, body_s, body_e, catch_lb, catch_rb, is_catch_bang, noraise_lb, noraise_rb, "catch", tokens[catch_i].line, tokens[catch_i].col) {
        Some(expr) => sb.write_string(t.leading_trivia + expr)
        None => sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[after_try - 1].end_byte))
      }
      i = after_try
      continue
    }
    // `raise <expr>`
    if le_is_kw(t, "raise") {
      let ee = le_find_stmt_expr_end(tokens, i + 1, end)
      let err_expr = le_lower_range(st, src, tokens, i + 1, ee).trim()
      // Verify error type matches enclosing raising boundary (exact type equality, no `Error`, no opaque stdlib)
      match le_active_err_ty(st) {
        Some(outer_et) => {
          if outer_et == "Error" || outer_et.length() == 0 || outer_et == "__stdlib_err__" {
            le_unsup(st, t.line, t.col, "cannot `raise` into polymorphic, untyped, or opaque stdlib error boundary")
          } else if i + 1 < ee {
            let raised_et = le_infer_raise_expr_err_ty(st, tokens, i + 1, ee)
            if raised_et.length() > 0 && raised_et != outer_et {
              le_unsup(st, t.line, t.col, "cannot `raise` error type `" + raised_et + "` inside boundary expecting `" + outer_et + "`")
            }
          }
        }
        None => ()
      }
      sb.write_string(t.leading_trivia + le_active_raise_stmt(st, err_expr, t.line, t.col))
      i = ee
      continue
    }
    // `return [expr]` inside a `RaisingFn` or `TryBlk(_, true)`
    if t.kind == TokenKind::Keyword && t.raw == "return" && st.frames.length() > 0 {
      let need_rw = match st.frames[st.frames.length() - 1] {
        LeFrame::RaisingFn(_, _) => true
        LeFrame::TryBlk(_, true) => true
        _ => false
      }
      if need_rw {
        let is_bare = i + 1 >= end || tokens[i + 1].kind == TokenKind::Semi ||
        tokens[i + 1].kind == TokenKind::RBrace || tokens[i + 1].kind == TokenKind::Comma ||
        tokens[i + 1].kind == TokenKind::RParen || tokens[i + 1].kind == TokenKind::RBracket ||
        tokens[i + 1].newline_before
        if is_bare {
          sb.write_string(t.leading_trivia + le_enclosing_ret_stmt(st.frames, "()"))
          i = i + 1
          continue
        }
        let ee = le_find_stmt_expr_end(tokens, i + 1, end)
        let val_s = le_lower_range(st, src, tokens, i + 1, ee).trim()
        sb.write_string(t.leading_trivia + le_enclosing_ret_stmt(st.frames, val_s))
        i = ee
        continue
      }
    }
    // Builtin `fail(msg)` inside a `Failure` raising boundary
    if le_is_builtin_fail(st, tokens, i, start, end) && st.frames.length() > 0 {
      let active_et = match le_active_err_ty(st) { Some(et) => et, None => "" }
      if active_et == st.failure_enum {
        let cp = find_matching_delim(tokens, i + 1)
        st.need_failure = true
        sb.write_string(t.leading_trivia + le_active_raise_stmt(st, "Failure(" + le_lower_range(st, src, tokens, i + 2, cp) + ")", t.line, t.col))
        i = cp + 1
        continue
      }
    }
    // External call `@pkg.fn(args)` (with optional postfix `catch[!] { ... }`)
    if t.kind == TokenKind::PkgRef && i + 3 < end &&
    tokens[i + 1].kind == TokenKind::Dot && tokens[i + 3].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, i + 3)
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let fn_name = tokens[i + 2].raw
      let catch_opt = le_match_postfix_catch(tokens, rp, end)
      match le_resolve_external_call(st, raw_pkg, fn_name) {
        Some((target_fn, err_ty)) => {
          match catch_opt {
            Some((is_cb, catch_lb, catch_rb)) => {
              sb.write_string(t.leading_trivia + le_emit_postfix_catch(st, src, tokens, i, i + 4, rp, target_fn, err_ty, is_cb, catch_lb, catch_rb, t.line, t.col))
              i = catch_rb + 1
              continue
            }
            None => ()
          }
          let args = le_lower_range(st, src, tokens, i + 4, rp)
          let call_s = target_fn + "(" + args + ")"
          sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
          i = rp + 1
          continue
        }
        None =>
        match catch_opt {
          Some((_, _, catch_rb)) => {
            le_unsup(st, t.line, t.col, "unknown or non-raising external function `@" + raw_pkg + "." + fn_name + "` in `catch`")
            sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[catch_rb].end_byte))
            i = catch_rb + 1
            continue
          }
          None => ()
        }
      }
    }
    // First-class value reference to external raising function `@pkg.fn` (without `(`) -> fail closed
    if t.kind == TokenKind::PkgRef && i + 2 < end && tokens[i + 1].kind == TokenKind::Dot &&
    (tokens[i + 2].kind == TokenKind::Ident || tokens[i + 2].kind == TokenKind::UpperIdent) &&
    !(i + 3 < end && tokens[i + 3].kind == TokenKind::LParen) {
      let raw_pkg = t.raw.slice(1, t.raw.length())
      let fn_name = tokens[i + 2].raw
      match le_resolve_external_call(st, raw_pkg, fn_name) {
        Some(_) => le_unsup(st, t.line, t.col, "raising function `" + t.raw + "." + fn_name + "` cannot be used as a first-class value")
        None => ()
      }
    }
    // Postfix `Ctor(raising_call) catch[!] { ... }` (e.g. `Some(@utf8.decode(b)) catch { _ => None }`)
    if t.kind == TokenKind::UpperIdent && i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, i + 1)
      match le_match_postfix_catch(tokens, rp, end) {
        Some((is_cb, catch_lb, catch_rb)) => {
          match le_try_lower_direct_result_call(st, src, tokens, i, rp + 1) {
            Some((wrap_ctor, res_call, canon_et)) => {
              let ok_arm = le_render_ok_arm(st, src, tokens, wrap_ctor, -1, -1)
              let err_arm = le_render_catch_err_arm(st, src, tokens, catch_lb, catch_rb, canon_et, is_cb, t.line, t.col)
              sb.write_string(t.leading_trivia + "match " + res_call + " { " + ok_arm + ", " + err_arm + " }")
            }
            None =>
            match le_lower_compound_try(st, src, tokens, i, rp + 1, catch_lb, catch_rb, is_cb, -1, -1, "catch", t.line, t.col) {
              Some(expr) => sb.write_string(t.leading_trivia + expr)
              None => sb.write_string(t.leading_trivia + src.slice(t.start_byte, tokens[catch_rb].end_byte))
            }
          }
          i = catch_rb + 1
          continue
        }
        None => ()
      }
    }
    // Qualified method `Type::method(args)` (with optional postfix `catch[!] { ... }` or chained `.method()`)
    if t.kind == TokenKind::UpperIdent && i + 2 < end &&
    tokens[i + 1].kind == TokenKind::ColonColon && tokens[i + 2].kind == TokenKind::Ident {
      let qk = t.raw + "::" + tokens[i + 2].raw
      match st.pkg_raise_methods.get(qk) {
        Some(err_ty) => {
          if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
            let rp = find_matching_delim(tokens, i + 3)
            match le_match_postfix_catch(tokens, rp, end) {
              Some((is_cb, catch_lb, catch_rb)) => {
                sb.write_string(t.leading_trivia + le_emit_postfix_catch(st, src, tokens, i, i + 4, rp, qk, err_ty, is_cb, catch_lb, catch_rb, t.line, t.col))
                i = catch_rb + 1
                continue
              }
              None => ()
            }
            let args = le_lower_range(st, src, tokens, i + 4, rp)
            let call_s = qk + "(" + args + ")"
            sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
            i = rp + 1
            continue
          }
          le_unsup(st, t.line, t.col, "raising method `" + qk + "` cannot be used as a first-class value")
        }
        None =>
        if i + 3 < end && tokens[i + 3].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, i + 3)
          if cp + 3 < end && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].kind == TokenKind::Ident &&
          tokens[cp + 3].kind == TokenKind::LParen && st.pkg_raise_method_names.contains(tokens[cp + 2].raw) {
            let mn = tokens[cp + 2].raw
            let cp2 = find_matching_delim(tokens, cp + 3)
            let rt = match st.pkg_fn_ret_types.get(qk) { Some(v) => v, None => "" }
            if st.pkg_concrete_types.contains(rt) &&
            (st.pkg_raise_methods.contains(rt + "::" + mn) || st.pkg_non_raise_methods.contains(rt + "::" + mn)) {
              let call_s = qk + "(" + le_lower_range(st, src, tokens, i + 4, cp) + ")." + mn + "(" + le_lower_range(st, src, tokens, cp + 4, cp2) + ")"
              match st.pkg_raise_methods.get(rt + "::" + mn) {
                Some(err_ty) => sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
                None => sb.write_string(t.leading_trivia + call_s)
              }
              i = cp2 + 1
              continue
            }
            le_unsup(st, tokens[cp + 2].line, tokens[cp + 2].col, "cannot statically resolve receiver type for potentially raising method `." + mn + "()`")
          }
        }
      }
    }
    // Receiver method call `recv.method(args)` (with optional postfix `catch[!] { ... }`)
    if t.kind == TokenKind::Ident && i + 3 < end &&
    tokens[i + 1].kind == TokenKind::Dot && tokens[i + 2].kind == TokenKind::Ident &&
    tokens[i + 3].kind == TokenKind::LParen &&
    !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) {
      let mn = tokens[i + 2].raw
      if st.pkg_raise_method_names.contains(mn) {
        let rty = le_lookup_var_type(st, t.raw)
        let rp = find_matching_delim(tokens, i + 3)
        if st.pkg_concrete_types.contains(rty) &&
        (st.pkg_raise_methods.contains(rty + "::" + mn) || st.pkg_non_raise_methods.contains(rty + "::" + mn)) {
          match st.pkg_raise_methods.get(rty + "::" + mn) {
            Some(err_ty) => {
              match le_match_postfix_catch(tokens, rp, end) {
                Some((is_cb, catch_lb, catch_rb)) => {
                  sb.write_string(t.leading_trivia + le_emit_postfix_catch(st, src, tokens, i, i + 4, rp, t.raw + "." + mn, err_ty, is_cb, catch_lb, catch_rb, t.line, t.col))
                  i = catch_rb + 1
                  continue
                }
                None => ()
              }
              let args = le_lower_range(st, src, tokens, i + 4, rp)
              let call_s = t.raw + "." + mn + "(" + args + ")"
              sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
            }
            None => {
              let args = le_lower_range(st, src, tokens, i + 4, rp)
              let call_s = t.raw + "." + mn + "(" + args + ")"
              sb.write_string(t.leading_trivia + call_s)
            }
          }
          i = rp + 1
          continue
        }
        le_unsup(st, tokens[i + 2].line, tokens[i + 2].col, "cannot statically resolve receiver type for potentially raising method `." + mn + "()`")
      }
    }
    // Same-package raising function or local raising closure `fn_name(args)` (or chained `fn().method()`)
    if t.kind == TokenKind::Ident &&
    !(i > start && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
    !(i + 1 < end && (tokens[i + 1].kind == TokenKind::Colon || tokens[i + 1].kind == TokenKind::Eq || tokens[i + 1].kind == TokenKind::Tilde)) {
      match le_lookup_raise_fn(st, t.raw) {
        Some(err_ty) => {
          if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
            let rp = find_matching_delim(tokens, i + 1)
            match le_match_postfix_catch(tokens, rp, end) {
              Some((is_cb, catch_lb, catch_rb)) => {
                sb.write_string(t.leading_trivia + le_emit_postfix_catch(st, src, tokens, i, i + 2, rp, t.raw, err_ty, is_cb, catch_lb, catch_rb, t.line, t.col))
                i = catch_rb + 1
                continue
              }
              None => ()
            }
            let args = le_lower_range(st, src, tokens, i + 2, rp)
            let call_s = t.raw + "(" + args + ")"
            sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
            i = rp + 1
            continue
          }
          le_unsup(st, t.line, t.col, "raising function `" + t.raw + "` cannot be used as a first-class value")
        }
        None =>
        if i + 1 < end && tokens[i + 1].kind == TokenKind::LParen {
          let cp = find_matching_delim(tokens, i + 1)
          if cp + 3 < end && tokens[cp + 1].kind == TokenKind::Dot && tokens[cp + 2].kind == TokenKind::Ident &&
          tokens[cp + 3].kind == TokenKind::LParen && st.pkg_raise_method_names.contains(tokens[cp + 2].raw) {
            let mn = tokens[cp + 2].raw
            let cp2 = find_matching_delim(tokens, cp + 3)
            let rt = if !le_is_lex_bound(st, t.raw) {
              match st.pkg_fn_ret_types.get(t.raw) { Some(v) => v, None => "" }
            } else {
              ""
            }
            if st.pkg_concrete_types.contains(rt) &&
            (st.pkg_raise_methods.contains(rt + "::" + mn) || st.pkg_non_raise_methods.contains(rt + "::" + mn)) {
              let call_s = t.raw + "(" + le_lower_range(st, src, tokens, i + 2, cp) + ")." + mn + "(" + le_lower_range(st, src, tokens, cp + 4, cp2) + ")"
              match st.pkg_raise_methods.get(rt + "::" + mn) {
                Some(err_ty) => sb.write_string(t.leading_trivia + le_propagate_call(st, call_s, err_ty, t.line, t.col))
                None => sb.write_string(t.leading_trivia + call_s)
              }
              i = cp2 + 1
              continue
            }
            le_unsup(st, tokens[cp + 2].line, tokens[cp + 2].col, "cannot statically resolve receiver type for potentially raising method `." + mn + "()`")
          }
        }
      }
    }
    // Unresolved `.method()` whose name matches a raising method in this package
    if t.kind == TokenKind::Dot && i + 2 < end &&
    tokens[i + 1].kind == TokenKind::Ident && tokens[i + 2].kind == TokenKind::LParen &&
    st.pkg_raise_method_names.contains(tokens[i + 1].raw) {
      le_unsup(st, tokens[i + 1].line, tokens[i + 1].col, "cannot statically resolve receiver type for potentially raising method `." + tokens[i + 1].raw + "()`")
    }
    // Unexpected standalone `catch { ... }` or `catch! { ... }` on an unrecognized LHS expression -> fail-closed
    if le_is_kw(t, "catch") && ((i + 1 < end && tokens[i + 1].kind == TokenKind::LBrace) ||
      (i + 2 < end && tokens[i + 1].kind == TokenKind::Bang && tokens[i + 2].kind == TokenKind::LBrace)) {
      le_unsup(st, t.line, t.col, "unsupported `catch` attached to non-raising or unknown expression")
    }
    // Interpolated string holes `\{...}`
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let is_ml = t.kind == TokenKind::InterpMultiline
      let isb = StringBuilder()
      isb.write_string(if is_ml { "$|" } else { "\"" })
      for p in split_interp_string(t.raw, is_ml) {
        if p.is_expr {
          let ht = lex_moonbit(p.text)
          isb.write_string("\\{" + le_lower_range(st, p.text, ht, 0, ht.length() - 1) + "}")
        } else {
          isb.write_string(p.text)
        }
      }
      if !is_ml { isb.write_string("\"") }
      sb.write_string(t.leading_trivia + isb.to_string())
      i = i + 1
      continue
    }
    sb.write_string(t.leading_trivia + t.raw)
    i = i + 1
  }
  sb.to_string()
}

///| Lower MoonBit checked-error declarations and expressions (`suberror`, `raise`, `try`,
///| `catch`, `catch!`, `noraise`, `try?`, `try!`) across a package's source files into Pion
///| `Result`/`match`/`?`, resolving cross-package raising calls via `ExternalErrorEnv`.
pub fn lower_checked_errors_with_env(
  sources : Array[SourceFile],
  cfg : ErrorLowerConfig,
  env : ExternalErrorEnv,
  diags : Array[Diag],
) -> Array[SourceFile] {
  let all_toks : Array[Array[Token]] = []
  let used_idents : Map[String, Bool] = Map()
  let mut any_err_kw = false
  for sf in sources {
    let toks = lex_moonbit(sf.content)
    let mut i = 0
    while i < toks.length() - 1 {
      let t = toks[i]
      if t.kind == TokenKind::Ident || t.kind == TokenKind::UpperIdent {
        used_idents[t.raw] = true
      }
      if le_is_kw(t, "suberror") || le_is_kw(t, "raise") || le_is_kw(t, "try") || le_is_kw(t, "catch") || le_is_kw(t, "is") {
        any_err_kw = true
      } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
        if le_interp_has_err_kw(t) {
          any_err_kw = true
        }
      }
      i = i + 1
    }
    all_toks.push(toks)
  }
  if !any_err_kw && env.dep_raising_fns_by_alias.length() == 0 && env.dep_raising_fns_by_canon.length() == 0 {
    return sources
  }

  let failure_enum = le_alloc_unique(used_idents, "MbtFailure")
  let outcome_enum = le_alloc_unique(used_idents, "MbtTryOutcome")
  let suberror_names : Map[String, Bool] = Map()
  let suberror_ctors : Map[String, String] = Map()
  let suberror_variants : Map[String, Array[String]] = Map()
  let suberror_variant_fields : Map[String, Array[String]] = Map()
  let pkg_raise_fns : Map[String, String] = Map()
  let pkg_raise_methods : Map[String, String] = Map()
  let pkg_non_raise_methods : Map[String, Bool] = Map()
  let pkg_raise_method_names : Map[String, Bool] = Map()
  let pkg_fn_ret_types : Map[String, String] = Map()
  let pkg_all_fns : Map[String, Bool] = Map()
  let pkg_top_bindings : Map[String, Bool] = Map()
  let pkg_concrete_types : Map[String, Bool] = Map()
  let rejected_fns : Map[String, Bool] = Map()
  for bt in ["Int", "Int64", "UInt", "UInt64", "Double", "Float", "Bool", "Char", "Byte", "String", "Bytes", "Unit", "Array", "FixedArray", "Map", "Option", "Result", "StringBuilder"] {
    pkg_concrete_types[bt] = true
  }
  for rk in env.dep_raising_fns_by_alias.keys() {
    let c1 = rk.index_of("::")
    if c1 > 0 {
      let rest = rk.slice(c1 + 2, rk.length())
      let c2 = rest.index_of("::")
      if c2 > 0 {
        pkg_raise_method_names[rest.slice(c2 + 2, rest.length())] = true
      }
    }
  }

  // Pass 0a: collect concrete types and `suberror` declarations + full variant lists
  let mut fi = 0
  while fi < sources.length() {
    let toks = all_toks[fi]
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && (le_is_kw(t, "struct") || le_is_kw(t, "enum")) &&
      i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        pkg_concrete_types[toks[i + 1].raw] = true
      }
      if depth == 0 && t.kind == TokenKind::Keyword && (t.raw == "let" || t.raw == "const") && i + 1 < n {
        let ni = if toks[i + 1].kind == TokenKind::Keyword && toks[i + 1].raw == "mut" { i + 2 } else { i + 1 }
        if ni < n && (toks[ni].kind == TokenKind::Ident || toks[ni].kind == TokenKind::UpperIdent) {
          pkg_top_bindings[toks[ni].raw] = true
        }
      }
      if depth == 0 && le_is_kw(t, "suberror") && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let src0 = sources[fi].content
        let en = toks[i + 1].raw
        suberror_names[en] = true
        pkg_concrete_types[en] = true
        if i + 2 < n && toks[i + 2].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, i + 2)
          let vars : Array[String] = []
          let mut k = i + 3
          let mut bd = 0
          while k < rb {
            if bd == 0 && toks[k].kind == TokenKind::UpperIdent &&
            (k == i + 3 || toks[k].newline_before || toks[k - 1].kind == TokenKind::Semi) {
              let vn = toks[k].raw
              suberror_ctors[vn] = en
              vars.push(vn)
              if k + 1 < rb && toks[k + 1].kind == TokenKind::LParen {
                let vrp = find_matching_delim(toks, k + 1)
                suberror_variant_fields[en + "::" + vn] = le_parse_ctor_field_types(src0, toks, k + 1, vrp)
              } else {
                suberror_variant_fields[en + "::" + vn] = []
              }
            }
            bd = le_step_depth(toks[k].kind, bd)
            k = k + 1
          }
          suberror_variants[en] = vars
          i = rb + 1
          continue
        } else if i + 2 < n && toks[i + 2].kind == TokenKind::LParen {
          let cp = find_matching_delim(toks, i + 2)
          suberror_ctors[en] = en
          suberror_variants[en] = [en]
          suberror_variant_fields[en + "::" + en] = le_parse_ctor_field_types(src0, toks, i + 2, cp)
        } else if i + 2 < n && !toks[i + 2].newline_before && !le_is_kw(toks[i + 2], "derive") &&
        toks[i + 2].kind != TokenKind::Semi {
          let mut pe = i + 2
          let mut pd = 0
          while pe < n {
            if pd == 0 && (toks[pe].newline_before || toks[pe].kind == TokenKind::Semi || le_is_kw(toks[pe], "derive")) {
              break
            }
            pd = le_step_depth(toks[pe].kind, pd)
            pe = pe + 1
          }
          let pty = src0.slice(toks[i + 2].start_byte, toks[pe - 1].end_byte).trim()
          suberror_ctors[en] = en
          suberror_variants[en] = [en]
          suberror_variant_fields[en + "::" + en] = [pty]
        } else {
          suberror_ctors[en] = en
          suberror_variants[en] = [en]
          suberror_variant_fields[en + "::" + en] = []
        }
      }
      i = i + 1
    }
    fi = fi + 1
  }

  // Pass 0b: collect top-level raising / non-raising function & method signatures
  fi = 0
  while fi < sources.length() {
    let sf = sources[fi]
    let toks = all_toks[fi]
    let n = toks.length() - 1
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "fn" {
        let is_pub = (i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "pub") ||
        (i >= 4 && toks[i - 1].kind == TokenKind::RParen && toks[i - 3].kind == TokenKind::LParen &&
          toks[i - 4].kind == TokenKind::Keyword && toks[i - 4].raw == "pub")
        match le_parse_fn_header(sf.content, toks, i, n) {
          Some((fname, _, _, rty, has_r, ety, has_rp, lb)) => {
            let rb = find_matching_delim(toks, lb)
            let eff_rty = if rty.length() > 0 { rty } else { "Unit" }
            if fname.length() > 0 {
              pkg_all_fns[fname] = true
              let rt = le_base_type_ident(eff_rty)
              let mut is_tp = false
              if i + 1 < n && toks[i + 1].kind == TokenKind::LBracket {
                let cb = find_matching_delim(toks, i + 1)
                let mut tk = i + 2
                while tk < cb {
                  if toks[tk].kind == TokenKind::UpperIdent && toks[tk].raw == rt { is_tp = true; break }
                  tk = tk + 1
                }
              }
              if rt.length() > 0 && pkg_concrete_types.contains(rt) && !is_tp {
                pkg_fn_ret_types[fname] = rt
              }
            }
            if has_rp {
              diags.push(diag_error(
                "MBT2PION_UNSUPPORTED_SYNTAX",
                sf.rel_path,
                t.line,
                t.col,
                "higher-order `raise` function parameter in `" + fname + "` is unsupported",
              ))
              rejected_fns[fname] = true
            } else if has_r {
              // Bare `raise` (outside already-rewritten Category A test helpers), `raise Error`,
              // `pub fn ... raise Failure`, and `pub fn Type::method ... raise E` MUST fail closed!
              if ety.length() == 0 || ety == "Error" {
                diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  t.line,
                  t.col,
                  "bare `raise` or polymorphic `raise Error` on `" + fname + "` is unsupported; specify a concrete `suberror` type",
                ))
                rejected_fns[fname] = true
              } else if is_pub && ety == "Failure" {
                diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  t.line,
                  t.col,
                  "public `raise Failure` on `" + fname + "` is unsupported; declare a `pub suberror`",
                ))
                rejected_fns[fname] = true
              } else if is_pub && str_has(fname, "::") {
                diags.push(diag_error(
                  "MBT2PION_UNSUPPORTED_SYNTAX",
                  sf.rel_path,
                  t.line,
                  t.col,
                  "public raising method `" + fname + "` is unsupported; use a top-level `pub fn ... raise E`",
                ))
                rejected_fns[fname] = true
              } else {
                let canon_et = if ety == "Failure" {
                  failure_enum
                } else if ety.starts_with("@") {
                  let dot = ety.index_of(".")
                  if dot > 1 {
                    let rp = ety.slice(1, dot)
                    let tn = ety.slice(dot + 1, ety.length()).trim()
                    le_resolve_dep_pkg(env, rp) + "::" + tn
                  } else {
                    ety
                  }
                } else {
                  ety
                }
                let cc = fname.index_of("::")
                if cc > 0 {
                  pkg_raise_methods[fname] = canon_et
                  pkg_raise_method_names[fname.slice(cc + 2, fname.length())] = true
                } else {
                  pkg_raise_fns[fname] = canon_et
                }
              }
            } else if str_has(fname, "::") {
              pkg_non_raise_methods[fname] = true
            }
            i = rb + 1
            continue
          }
          None => ()
        }
      }
      i = i + 1
    }
    fi = fi + 1
  }

  // Pass 1: lower every file
  let out_sources : Array[SourceFile] = []
  let mut any_fail = false
  let mut any_out = false
  fi = 0
  while fi < sources.length() {
    let sf = sources[fi]
    let src = sf.content
    let toks = all_toks[fi]
    let n = toks.length() - 1
    let st = LeState::{
      file: sf.rel_path,
      is_test: sf.is_test,
      cfg: cfg,
      env: env,
      suberror_names: suberror_names,
      suberror_ctors: suberror_ctors,
      suberror_variants: suberror_variants,
      suberror_variant_fields: suberror_variant_fields,
      pkg_raise_fns: pkg_raise_fns,
      pkg_raise_methods: pkg_raise_methods,
      pkg_non_raise_methods: pkg_non_raise_methods,
      pkg_raise_method_names: pkg_raise_method_names,
      pkg_fn_ret_types: pkg_fn_ret_types,
      pkg_all_fns: pkg_all_fns,
      pkg_top_bindings: pkg_top_bindings,
      pkg_concrete_types: pkg_concrete_types,
      failure_enum: failure_enum,
      outcome_enum: outcome_enum,
      used_idents: used_idents,
      frames: [],
      lex_var_types: [Map()],
      lex_raise_closures: [Map()],
      lex_err_vars: [Map()],
      diags: diags,
      need_failure: false,
      need_outcome: false,
      tmp_seq: 0,
    }
    let edits : Array[(Int, Int, String)] = []
    let mut i = 0
    let mut depth = 0
    while i < n {
      let t = toks[i]
      if t.kind == TokenKind::LBrace { depth = depth + 1; i = i + 1; continue }
      if t.kind == TokenKind::RBrace { if depth > 0 { depth = depth - 1 }; i = i + 1; continue }

      // 1. `suberror` declaration lowering
      if depth == 0 && le_is_kw(t, "suberror") && i + 1 < n && toks[i + 1].kind == TokenKind::UpperIdent {
        let ename = toks[i + 1].raw
        let mut start_b = t.start_byte
        let mut vis_prefix = ""
        if i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "priv" {
          start_b = toks[i - 1].start_byte
        } else if i > 0 && toks[i - 1].kind == TokenKind::Keyword && toks[i - 1].raw == "pub" {
          start_b = toks[i - 1].start_byte
          vis_prefix = "pub "
        } else if i >= 4 && toks[i - 1].kind == TokenKind::RParen && toks[i - 3].kind == TokenKind::LParen &&
        toks[i - 4].kind == TokenKind::Keyword && toks[i - 4].raw == "pub" {
          start_b = toks[i - 4].start_byte
          vis_prefix = src.slice(toks[i - 4].start_byte, toks[i - 1].end_byte) + " "
        }
        if i + 2 < n && toks[i + 2].kind == TokenKind::LBrace {
          edits.push((start_b, t.end_byte, vis_prefix + "enum"))
          i = i + 2
          continue
        }
        if i + 2 < n && toks[i + 2].kind == TokenKind::LParen {
          let cp = find_matching_delim(toks, i + 2)
          let payload = src.slice(toks[i + 2].start_byte, toks[cp].end_byte)
          edits.push((start_b, toks[cp].end_byte, vis_prefix + "enum " + ename + " { " + ename + payload + " }"))
          i = cp + 1
          continue
        }
        if i + 2 < n && !toks[i + 2].newline_before && !le_is_kw(toks[i + 2], "derive") &&
        toks[i + 2].kind != TokenKind::Semi {
          let mut pe = i + 2
          let mut pd = 0
          while pe < n {
            if pd == 0 && (toks[pe].newline_before || toks[pe].kind == TokenKind::Semi || le_is_kw(toks[pe], "derive")) {
              break
            }
            pd = le_step_depth(toks[pe].kind, pd)
            pe = pe + 1
          }
          let payload_ty = src.slice(toks[i + 2].start_byte, toks[pe - 1].end_byte).trim()
          edits.push((start_b, toks[pe - 1].end_byte, vis_prefix + "enum " + ename + " { " + ename + "(" + payload_ty + ") }"))
          i = pe
          continue
        }
        edits.push((start_b, toks[i + 1].end_byte, vis_prefix + "enum " + ename + " { " + ename + " }"))
        i = i + 2
        continue
      }

      // 2. Top-level `fn` declarations
      if depth == 0 && t.kind == TokenKind::Keyword && t.raw == "fn" {
        match le_parse_fn_header(src, toks, i, n) {
          Some((fname, op, cp, rty, has_r, ety, _, lb)) => {
            let rb = find_matching_delim(toks, lb)
            let eff_rty = if rty.length() > 0 { rty } else { "Unit" }
            // Verify Category A helper invariant, then still lower its body as `PlainFn` so any
            // missed raising call/method fails closed in `le_propagate_call`.
            let cat_a_key = sf.rel_path + "::" + fname
            if sf.is_test && env.cat_a_rewritten.contains(cat_a_key) && has_r {
              le_unsup(st, t.line, t.col, "internal invariant violation: Category A helper `" + fname + "` still contains `raise`")
              i = rb + 1
              continue
            }
            if rejected_fns.contains(fname) {
              i = rb + 1
              continue
            }
            let pm : Map[String, String] = Map()
            let cm : Map[String, String] = Map()
            le_seed_params(toks, op, cp, fname, pm, cm)
            st.lex_var_types.push(pm)
            st.lex_raise_closures.push(cm)
            st.lex_err_vars.push(Map())
            if has_r {
              let canon_et = le_canon_err_ty(st, ety)
              let emit_et = if ety == "Failure" { st.failure_enum } else { ety }
              st.frames.push(LeFrame::RaisingFn(eff_rty, canon_et))
              let bt = le_lower_range(st, src, toks, lb + 1, rb)
              let _ = st.frames.pop()
              let tail_triv = toks[rb].leading_trivia
              let tail_nl = if tail_triv.ends_with("\n") { "" } else { "\n" }
              let wrapped = if le_body_always_exits(toks, lb, rb) {
                "{" + bt + tail_triv + "}"
              } else if eff_rty == "Unit" {
                "{" + bt + tail_triv + tail_nl + "  Ok(())\n}"
              } else {
                "{ Ok({" + bt + tail_triv + tail_nl + "}) }"
              }
              edits.push((
                t.start_byte,
                toks[rb].end_byte,
                src.slice(t.start_byte, toks[cp].end_byte) + " -> Result[" + eff_rty + ", " + emit_et + "] " + wrapped,
              ))
            } else {
              st.frames.push(LeFrame::PlainFn(eff_rty))
              let nb = le_lower_range(st, src, toks, lb + 1, rb) + toks[rb].leading_trivia
              let _ = st.frames.pop()
              if nb != src.slice(toks[lb].end_byte, toks[rb].start_byte) {
                edits.push((toks[lb].end_byte, toks[rb].start_byte, nb))
              }
            }
            let _ = st.lex_err_vars.pop()
            let _ = st.lex_raise_closures.pop()
            let _ = st.lex_var_types.pop()
            i = rb + 1
            continue
          }
          None => ()
        }
      }

      // 3. Top-level `test` blocks
      if depth == 0 && le_is_kw(t, "test") {
        let mut lb = i + 1
        while lb < n && toks[lb].kind != TokenKind::LBrace { lb = lb + 1 }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, lb)
          st.lex_var_types.push(Map())
          st.lex_raise_closures.push(Map())
          st.lex_err_vars.push(Map())
          st.frames.push(LeFrame::PlainFn("Unit"))
          let nb = le_lower_range(st, src, toks, lb + 1, rb) + toks[rb].leading_trivia
          let _ = st.frames.pop()
          let _ = st.lex_err_vars.pop()
          let _ = st.lex_raise_closures.pop()
          let _ = st.lex_var_types.pop()
          if nb != src.slice(toks[lb].end_byte, toks[rb].start_byte) {
            edits.push((toks[lb].end_byte, toks[rb].start_byte, nb))
          }
          i = rb + 1
          continue
        }
      }

      // Skip `struct` / `enum` / `type` / `trait` declarations (Stage A handles `raise` in type definitions + dispositions)
      if depth == 0 && (le_is_kw(t, "struct") || le_is_kw(t, "enum") || le_is_kw(t, "type") || le_is_kw(t, "trait")) {
        let mut sk = i + 1
        while sk < n && toks[sk].kind != TokenKind::LBrace && toks[sk].kind != TokenKind::Semi && !toks[sk].newline_before {
          sk = sk + 1
        }
        if sk < n && toks[sk].kind == TokenKind::LBrace {
          i = find_matching_delim(toks, sk) + 1
          continue
        }
      }
      // Top-level `let`/`const`: skip type annotations, then run lexically-scoped RHS validation
      if depth == 0 && t.kind == TokenKind::Keyword && (t.raw == "let" || t.raw == "const") {
        let mut eq_i = i + 1
        let mut td = 0
        while eq_i < n && !(td == 0 && (toks[eq_i].kind == TokenKind::Eq || toks[eq_i].kind == TokenKind::Semi)) {
          td = le_step_depth(toks[eq_i].kind, td)
          eq_i = eq_i + 1
        }
        if eq_i < n && toks[eq_i].kind == TokenKind::Eq {
          let rhs_end = le_find_stmt_expr_end(toks, eq_i + 1, n)
          let mut has_err_kw = false
          let mut rk = eq_i + 1
          while rk < rhs_end {
            let rt = toks[rk]
            if le_is_kw(rt, "raise") || le_is_kw(rt, "try") || le_is_kw(rt, "catch") {
              le_unsup(st, rt.line, rt.col, "unsupported `" + rt.raw + "` in top-level `let`/`const` initializer")
              has_err_kw = true
            } else if rt.kind == TokenKind::InterpString || rt.kind == TokenKind::InterpMultiline {
              le_scan_residual_err_in_interp(st, rt)
            }
            rk = rk + 1
          }
          if !has_err_kw {
            st.lex_var_types.push(Map())
            st.lex_raise_closures.push(Map())
            st.lex_err_vars.push(Map())
            st.frames.push(LeFrame::PlainFn(""))
            let _ = le_lower_range(st, src, toks, eq_i + 1, rhs_end)
            let _ = st.frames.pop()
            let _ = st.lex_err_vars.pop()
            let _ = st.lex_raise_closures.pop()
            let _ = st.lex_var_types.pop()
          }
          i = rhs_end
          continue
        }
      }

      // 4. Fail-closed on residual `raise` / `try` / `catch` outside top-level `fn` / `test`
      if le_is_kw(t, "raise") || le_is_kw(t, "try") || le_is_kw(t, "catch") {
        le_unsup(st, t.line, t.col, "unsupported `" + t.raw + "` outside top-level `fn`/`test`")
      } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
        le_scan_residual_err_in_interp(st, t)
      }

      i = i + 1
    }
    if st.need_failure { any_fail = true }
    if st.need_outcome { any_out = true }
    out_sources.push(if edits.length() > 0 {
      SourceFile::{ rel_path: sf.rel_path, content: apply_byte_edits(src, edits), is_test: sf.is_test }
    } else {
      sf
    })
    fi = fi + 1
  }
  if (any_fail || any_out) && out_sources.length() > 0 {
    let h = (if any_fail { "enum " + failure_enum + " {\n  Failure(String)\n}\n\n" } else { "" }) +
    (if any_out { "enum " + outcome_enum + "[R, E] {\n  MbtTryOk\n  MbtTryRet(R)\n  MbtTryErr(E)\n}\n\n" } else { "" })
    let mut ti = 0
    let mut k = 0
    while k < out_sources.length() {
      if !out_sources[k].is_test { ti = k; break }
      k = k + 1
    }
    out_sources[ti] = SourceFile::{ rel_path: out_sources[ti].rel_path, content: h + out_sources[ti].content, is_test: out_sources[ti].is_test }
  }
  out_sources
}

///| Lower MoonBit checked-error declarations and expressions with empty external ABI env.
pub fn lower_checked_errors(
  sources : Array[SourceFile],
  cfg : ErrorLowerConfig,
  diags : Array[Diag],
) -> Array[SourceFile] {
  lower_checked_errors_with_env(sources, cfg, empty_external_error_env(), diags)
}

///| Return true iff a string interpolation token contains `suberror`/`raise`/`try`/`catch` in any `\{...}` hole.
fn le_interp_has_err_kw(t : Token) -> Bool {
  if t.kind != TokenKind::InterpString && t.kind != TokenKind::InterpMultiline {
    return false
  }
  for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) {
    if p.is_expr {
      let ht = lex_moonbit(p.text)
      let mut k = 0
      while k < ht.length() - 1 {
        let h = ht[k]
        if le_is_kw(h, "suberror") || le_is_kw(h, "raise") || le_is_kw(h, "try") || le_is_kw(h, "catch") {
          return true
        }
        if (h.kind == TokenKind::InterpString || h.kind == TokenKind::InterpMultiline) && le_interp_has_err_kw(h) {
          return true
        }
        k = k + 1
      }
    }
  }
  false
}

///| Scan string interpolation holes at top-level (outside `fn`/`test`) for residual error keywords.
fn le_scan_residual_err_in_interp(st : LeState, t : Token) -> Unit {
  if t.kind != TokenKind::InterpString && t.kind != TokenKind::InterpMultiline {
    return
  }
  for p in split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline) {
    if p.is_expr {
      let ht = lex_moonbit(p.text)
      let mut k = 0
      while k < ht.length() - 1 {
        let h = ht[k]
        if le_is_kw(h, "raise") || le_is_kw(h, "try") || le_is_kw(h, "catch") {
          le_unsup(st, t.line, t.col, "unsupported `" + h.raw + "` inside top-level string interpolation")
        } else if h.kind == TokenKind::InterpString || h.kind == TokenKind::InterpMultiline {
          le_scan_residual_err_in_interp(st, h)
        }
        k = k + 1
      }
    }
  }
}

///| Convenience helper for lowering checked-error syntax in a single source string.
pub fn lower_checked_errors_single(
  src : String,
  file : String,
  cfg : ErrorLowerConfig,
  diags : Array[Diag],
) -> String {
  let out = lower_checked_errors([SourceFile::{ rel_path: file, content: src, is_test: false }], cfg, diags)
  if out.length() > 0 { out[0].content } else { src }
}
