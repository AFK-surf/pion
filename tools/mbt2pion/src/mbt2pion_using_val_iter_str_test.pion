///| Unit tests for:
///| 1. `lookup_ident_static_type` resolving `using_values` (and respecting local shadowing).
///| 2. `.iter().any/all/find_first/filter/filter_map/map/each(fn(x) { ... })` element type binding.
///| 3. Pure `mbt_compat::str_*` read-only helpers and `"String"` return types in `mutation_summary`.
///| 4. `resolve_anon_struct_literal_name` unique `[struct_defaults]` matching without expected type.

test "using_values static type resolution propagates MbtJson on field chain and respects local shadowing" {
  let dep_mbti =
  "package \"dep\"\n\n" +
  "pub(all) struct Cell[T] {\n" +
  "  mut value : T\n" +
  "}\n" +
  "#callsite(autofill(loc))\n" +
  "pub fn[T] Cell::set(Self[T], T, loc~ : SourceLoc) -> Unit\n\n" +
  "pub(all) struct Holder {\n" +
  "  cell : Cell[Json?]\n" +
  "}\n" +
  "pub let state : Holder\n"

  let dep_abi = PackageAbi::{
    package_name: "dep",
    enums: [],
    struct_val_fields: [],
    structs: Some([
      AbiStructSchema::{
        pkg: "dep",
        name: "Holder",
        type_params: [],
        fields: [
          AbiStructField::{ src_name: "cell", emit_name: "cell", ty: "dep::Cell[Option[mbt_compat::MbtJson]]", is_mut: false, visibility: "pub" },
        ],
        can_construct: true,
        can_update: true,
        complete: true,
      },
    ]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [AbiValueSchema::{ name: "state", ty: "dep::Holder" }],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let src =
  "using @dep { state }\n\n" +
  "pub struct LocalCell {\n" +
  "  mut v : String\n" +
  "}\n" +
  "pub fn LocalCell::set(self : LocalCell, v : String) -> Unit {\n" +
  "  self.v = v\n" +
  "}\n" +
  "pub struct LocalHolder {\n" +
  "  cell : LocalCell\n" +
  "}\n\n" +
  "pub fn update_imported() -> Unit {\n" +
  "  state.cell.set(Some({ \"k\": \"v\", \"arr\": [\"a\"] }))\n" +
  "}\n\n" +
  "pub fn update_shadowed(h : LocalHolder) -> Unit {\n" +
  "  let state = h\n" +
  "  state.cell.set(\"plain\")\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["dep"] = "dep"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }
  let res = transpile_package_with_abis(
    [SourceFile::{ rel_path: "use_val.mbt", content: src, is_test: false }],
    api,
    default_recipes(),
    [],
    [("dep.mbti", dep_mbti)],
    [],
    [("dep", dep_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "mbt_compat::MbtJson::Object(mbt_compat::ordered_map_from_array([(\"k\", mbt_compat::MbtJson::String(\"v\")), (\"arr\", mbt_compat::MbtJson::Array([mbt_compat::MbtJson::String(\"a\")]))]))"),
    "imported using value field chain must wrap nested Json object and array: " + out,
  )
  assert_true(
    str_has(out, "state.cell.set(\"plain\")"),
    "shadowed local state must not inherit using_values MbtJson type: " + out,
  )
}

test "iter method chain closure binds array element type for MbtJson equality without mis-wrapping String or leaking" {
  let src =
  "pub fn items(_p : Int, _k : String) -> Array[Json] {\n" +
  "  []\n" +
  "}\n\n" +
  "pub fn check_calls(p : Int, xs : Array[Json], ss : Array[String], r : String) -> Bool {\n" +
  "  let a = items(p, \"a\").iter().any(fn(r) { r == \"alpha\" })\n" +
  "  let b = xs.iter().find_first(fn(u) { u == \"beta\" })\n" +
  "  let c = xs.iter().all(fn(v) { v != \"gamma\" })\n" +
  "  let d = xs.iter().filter(fn(w) { w == \"delta\" }).count() > 0\n" +
  "  let e = ss.iter().any(fn(s) { s == \"plain\" })\n" +
  "  let f = xs.iter().any(fn(x : String) { x == \"explicit\" })\n" +
  "  let g = r == \"outer\"\n" +
  "  a && b is Some(_) && c && d && e && f && g\n" +
  "}\n"

  let res = transpile_package(
    [SourceFile::{ rel_path: "iter_cb.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "== mbt_compat::MbtJson::String(\"alpha\")"),
    "items(p, a).iter().any(fn(r) { r == alpha }) must wrap literal as MbtJson::String: " + out,
  )
  assert_true(
    str_has(out, "== mbt_compat::MbtJson::String(\"beta\")"),
    "xs.iter().find_first(fn(u) { u == beta }) must wrap literal as MbtJson::String: " + out,
  )
  assert_true(
    str_has(out, "!= mbt_compat::MbtJson::String(\"gamma\")"),
    "xs.iter().all(fn(v) { v != gamma }) must wrap literal as MbtJson::String: " + out,
  )
  assert_true(
    str_has(out, "== mbt_compat::MbtJson::String(\"delta\")"),
    "xs.iter().filter(fn(w) { w == delta }) must wrap literal as MbtJson::String: " + out,
  )
  assert_true(
    str_has(out, "s == \"plain\""),
    "Array[String].iter().any must not wrap String literal: " + out,
  )
  assert_true(
    str_has(out, "x == \"explicit\""),
    "explicit closure param annotation must take precedence over inferred Array[Json] element type: " + out,
  )
  assert_true(
    str_has(out, "r == \"outer\""),
    "closure param type must not leak to outer scope: " + out,
  )
}

test "mutation_summary treats pure mbt_compat str_* helpers as pure String and fails closed on impure args" {
  let src =
  "pub fn norm_key(s : String) -> String {\n" +
  "  let t = mbt_compat::str_trim(s)\n" +
  "  let o = mbt_compat::str_to_owned(t)\n" +
  "  let r = mbt_compat::str_replace_all(o, \"-\", \"_\")\n" +
  "  mbt_compat::str_to_lower(r)\n" +
  "}\n\n" +
  "pub fn mutate_and_str(xs : Array[String]) -> String {\n" +
  "  xs.push(\"x\")\n" +
  "  \"x\"\n" +
  "}\n\n" +
  "pub fn impure_str_arg(xs : Array[String]) -> String {\n" +
  "  mbt_compat::str_to_owned(mutate_and_str(xs))\n" +
  "}\n\n" +
  "pub fn find_norm(xs : Array[String], target : String) -> Option[String] {\n" +
  "  xs.iter().find_first(fn(s) { norm_key(s) == norm_key(target) })\n" +
  "}\n\n" +
  "pub fn find_impure(xs : Array[String]) -> Option[String] {\n" +
  "  xs.iter().find_first(fn(s) { mbt_compat::str_to_owned(mutate_and_str(xs)) == s })\n" +
  "}\n"

  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary([toks], ["str_pure.pion"], [src], empty_pkg_query_types(), Map(), Map())

  match ms.summaries.get("norm_key") {
    Some(sum) => {
      assert_true(!sum.unknown, "norm_key must not be unknown")
      assert_true(!sum.mutates_any_array && sum.mutated_elem_types.length() == 0, "norm_key must not mutate arrays")
    }
    None => assert_true(false, "missing summary for norm_key")
  }
  match ms.summaries.get("impure_str_arg") {
    Some(sum) => {
      assert_true(
        sum.unknown || sum.mutates_any_array || sum.mutated_elem_types.length() > 0,
        "str_to_owned(mutate_and_str(xs)) must record mutation / fail closed",
      )
    }
    None => assert_true(false, "missing summary for impure_str_arg")
  }

  let iter_dots : Array[Int] = []
  let mut ti = 1
  while ti + 2 < toks.length() {
    if toks[ti].kind == TokenKind::Dot && toks[ti + 1].raw == "iter" && toks[ti + 2].kind == TokenKind::LParen {
      iter_dots.push(ti)
    }
    ti = ti + 1
  }
  assert_eq(iter_dots.length(), 2)
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[0], ms, src, None, "String") != None,
    "pure norm_key in .iter().find_first must pass Gate C",
  )
  assert_true(
    immediate_iter_consumer_allow_with_summary(toks, iter_dots[1], ms, src, None, "String") == None,
    "impure arg inside str_to_owned in .iter().find_first must fail closed",
  )
}

test "resolve_anon_struct_literal_name matches unique struct_defaults dep struct without expected type and fails closed on ambiguity" {
  let box_schema = AbiStructSchema::{
    pkg: "cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "compact", emit_name: "compact", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let alt_schema = AbiStructSchema::{
    pkg: "cfg",
    name: "AltCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "extra", emit_name: "extra", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let cfg_abi = PackageAbi::{
    package_name: "cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_schema, alt_schema]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let src =
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn make_cfg() -> @cfg.BoxCfg {\n" +
  "  @cfg.BoxCfg::{ a: 0, b: false }\n" +
  "}\n\n" +
  "pub fn build(h : Host, cond : Bool) -> Host {\n" +
  "  h.apply(wrap(fn() {\n" +
  "    if cond {\n" +
  "      make_cfg()\n" +
  "    } else {\n" +
  "      { a: 1, b: true }\n" +
  "    }\n" +
  "  }))\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["cfg"] = "cfg"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }

  // Positive: unique [struct_defaults."cfg::BoxCfg"] match without expected type.
  let uniq_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"false\"\n"
  let udiags : Array[Diag] = []
  let uniq_recipes = parse_recipes_toml(uniq_toml, "recipes.toml", udiags)
  assert_eq(udiags.length(), 0)
  let res_uniq = transpile_package_with_abis(
    [SourceFile::{ rel_path: "anon_cfg.mbt", content: src, is_test: false }],
    api,
    uniq_recipes,
    [],
    [],
    [],
    [("cfg", cfg_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_uniq.diagnostics.length(), 0)
  let out_uniq = res_uniq.files[0].content
  assert_true(
    str_has(out_uniq, "cfg::BoxCfg::{ a: 1, b: true, compact: false, pad: Option::None }"),
    "unique struct_defaults dep struct must resolve anon literal without expected type: " + out_uniq,
  )

  // Negative (ambiguity fail-closed): two different [struct_defaults] targets both cover `{ a: 1, b: true }`.
  let ambig_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"false\"\n\n" +
  "[struct_defaults.\"cfg::AltCfg\"]\n" +
  "extra = \"false\"\n"
  let adiags : Array[Diag] = []
  let ambig_recipes = parse_recipes_toml(ambig_toml, "recipes.toml", adiags)
  assert_eq(adiags.length(), 0)
  let res_ambig = transpile_package_with_abis(
    [SourceFile::{ rel_path: "anon_cfg_ambig.mbt", content: src, is_test: false }],
    api,
    ambig_recipes,
    [],
    [],
    [],
    [("cfg", cfg_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_ambig.diagnostics.length(), 0)
  let out_ambig = res_ambig.files[0].content
  assert_true(
    !str_has(out_ambig, "cfg::BoxCfg::{ a: 1, b: true") &&
    !str_has(out_ambig, "cfg::AltCfg::{ a: 1, b: true"),
    "ambiguous struct_defaults targets must fail closed without prefixing or appending defaults: " + out_ambig,
  )
}

test "custom receiver Bag::iter returning Array[Json] still infers filter callback element type" {
  let src =
  "pub struct Bag {\n" +
  "  items : Array[Json]\n" +
  "}\n\n" +
  "pub fn Bag::iter(self : Bag) -> Array[Json] {\n" +
  "  self.items\n" +
  "}\n\n" +
  "pub fn pick_custom(b : Bag) -> Array[Json] {\n" +
  "  b.iter().filter(fn(item) { item == \"custom\" })\n" +
  "}\n"

  let res = transpile_package(
    [SourceFile::{ rel_path: "custom_iter.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "item == mbt_compat::MbtJson::String(\"custom\")"),
    "custom Bag::iter -> Array[Json] must keep filter callback MbtJson wrapping: " + out,
  )
}

test "struct_defaults deduplicates aliases of same canonical ABI struct, merges split rules, and rejects keyword-rename field spoofing" {
  let box_schema = AbiStructSchema::{
    pkg: "canon_cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "compact", emit_name: "compact", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let kw_schema = AbiStructSchema::{
    pkg: "canon_cfg",
    name: "KwCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "val_", emit_name: "val_", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "id", emit_name: "id", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "extra", emit_name: "extra", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let cfg_abi = PackageAbi::{
    package_name: "canon_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_schema, kw_schema]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let src =
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn build(h : Host, cond : Bool) -> Host {\n" +
  "  h.apply(wrap(fn() {\n" +
  "    if cond {\n" +
  "      @cfg.BoxCfg::{ a: 0, b: false }\n" +
  "    } else {\n" +
  "      { a: 1, b: true }\n" +
  "    }\n" +
  "  }))\n" +
  "}\n\n" +
  "pub fn spoof_kw(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { val: 1, id: 2 } }))\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["cfg"] = "cfg"
  pkg_aliases["cfg_alias"] = "cfg_alias"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }

  // Case 1: Same canonical ABI struct registered under two aliases with identical defaults.
  let dup_alias_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"false\"\n\n" +
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n" +
  "compact = \"false\"\n\n" +
  "[struct_defaults.\"cfg::KwCfg\"]\n" +
  "extra = \"false\"\n"
  let d1 : Array[Diag] = []
  let rec_dup = parse_recipes_toml(dup_alias_toml, "dup.toml", d1)
  assert_eq(d1.length(), 0)
  let res_dup = transpile_package_with_abis(
    [SourceFile::{ rel_path: "alias_dup.mbt", content: src, is_test: false }],
    api,
    rec_dup,
    [],
    [],
    [],
    [("cfg", cfg_abi), ("cfg_alias", cfg_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_dup.diagnostics.length(), 0)
  let out_dup = res_dup.files[0].content
  assert_true(
    str_has(out_dup, "cfg::BoxCfg::{ a: 1, b: true, compact: false, pad: Option::None }"),
    "duplicate alias rules for same canonical ABI struct must deduplicate to unique candidate: " + out_dup,
  )
  assert_true(
    !str_has(out_dup, "KwCfg::{"),
    "source field `val` must not spoof ABI struct field `val_` via keyword rename: " + out_dup,
  )

  // Case 2: Split partial defaults across two aliases of the same canonical ABI struct.
  let split_alias_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n\n" +
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "compact = \"false\"\n"
  let d2 : Array[Diag] = []
  let rec_split = parse_recipes_toml(split_alias_toml, "split.toml", d2)
  assert_eq(d2.length(), 0)
  let res_split = transpile_package_with_abis(
    [SourceFile::{ rel_path: "alias_split.mbt", content: src, is_test: false }],
    api,
    rec_split,
    [],
    [],
    [],
    [("cfg", cfg_abi), ("cfg_alias", cfg_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_split.diagnostics.length(), 0)
  let out_split = res_split.files[0].content
  assert_true(
    str_has(out_split, "cfg::BoxCfg::{ a: 1, b: true, compact: false, pad: Option::None }"),
    "split partial defaults across aliases must merge consistently for both coverage and emission: " + out_split,
  )
}

test "struct_defaults distinguishes colliding canonical package ABIs and deduplicates src_name vs emit_name defaults" {
  // Case 1: Two distinct ABIs both claim canonical package `canon_cfg`, imported under `cfg` and `cfg_alias`.
  let abi_a = PackageAbi::{
    package_name: "canon_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([
      AbiStructSchema::{
        pkg: "canon_cfg",
        name: "BoxCfg",
        type_params: [],
        fields: [
          AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
          AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
          AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
        ],
        can_construct: true,
        can_update: true,
        complete: true,
      },
    ]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_b = PackageAbi::{
    package_name: "canon_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([
      AbiStructSchema::{
        pkg: "canon_cfg",
        name: "BoxCfg",
        type_params: [],
        fields: [
          AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
          AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
          AbiStructField::{ src_name: "other_pad", emit_name: "other_pad", ty: "Int", is_mut: false, visibility: "pub" },
        ],
        can_construct: true,
        can_update: true,
        complete: true,
      },
    ]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let src_collide =
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn make_explicit() -> @cfg.BoxCfg {\n" +
  "  @cfg.BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_anon_ambig(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 1, b: true } }))\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["cfg"] = "cfg"
  pkg_aliases["cfg_alias"] = "cfg_alias"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }
  let collide_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n\n" +
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "other_pad = \"0\"\n"
  let dc : Array[Diag] = []
  let rec_collide = parse_recipes_toml(collide_toml, "collide.toml", dc)
  assert_eq(dc.length(), 0)
  let res_collide = transpile_package_with_abis(
    [SourceFile::{ rel_path: "collide.mbt", content: src_collide, is_test: false }],
    api,
    rec_collide,
    [],
    [],
    [],
    [("cfg", abi_a), ("cfg_alias", abi_b)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_collide.diagnostics.length(), 0)
  let out_collide = res_collide.files[0].content
  assert_true(
    str_has(out_collide, "cfg::BoxCfg::{ a: 1, b: true, pad: Option::None }"),
    "explicit @cfg.BoxCfg must only receive cfg defaults: " + out_collide,
  )
  assert_true(
    !str_has(out_collide, "other_pad"),
    "explicit @cfg.BoxCfg must never receive defaults from colliding ABI cfg_alias: " + out_collide,
  )
  assert_true(
    str_has(out_collide, "wrap(fn() { { a: 1, b: true } })"),
    "anonymous literal matching two colliding ABIs must fail closed: " + out_collide,
  )

  // Case 2: Same ABI imported under two aliases where one rule uses `src_name` (`pad`) and another uses `emit_name` (`pad_out`).
  let abi_renamed = PackageAbi::{
    package_name: "canon_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([
      AbiStructSchema::{
        pkg: "canon_cfg",
        name: "BoxCfg",
        type_params: [],
        fields: [
          AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
          AbiStructField::{ src_name: "pad", emit_name: "pad_out", ty: "Option[Int]", is_mut: false, visibility: "pub" },
        ],
        can_construct: true,
        can_update: true,
        complete: true,
      },
    ]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let src_renamed =
  "pub fn make_renamed() -> @cfg.BoxCfg {\n" +
  "  @cfg.BoxCfg::{ a: 7 }\n" +
  "}\n"
  let renamed_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n\n" +
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "pad_out = \"Option::None\"\n"
  let dr : Array[Diag] = []
  let rec_renamed = parse_recipes_toml(renamed_toml, "renamed.toml", dr)
  assert_eq(dr.length(), 0)
  let res_renamed = transpile_package_with_abis(
    [SourceFile::{ rel_path: "renamed.mbt", content: src_renamed, is_test: false }],
    api,
    rec_renamed,
    [],
    [],
    [],
    [("cfg", abi_renamed), ("cfg_alias", abi_renamed)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_renamed.diagnostics.length(), 0)
  let out_renamed = res_renamed.files[0].content
  assert_true(
    str_has(out_renamed, "cfg::BoxCfg::{ a: 7, pad_out: Option::None }"),
    "src_name and emit_name rules must emit pad_out once: " + out_renamed,
  )
  assert_true(
    !str_has(out_renamed, "pad_out: Option::None, pad_out:"),
    "must never emit duplicate pad_out keys: " + out_renamed,
  )
}

test "pub using re-export ABI identity deduplicates same defining package and keeps distinct defining packages fail-closed" {
  let canon_box = AbiStructSchema::{
    pkg: "canon_cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let other_box = AbiStructSchema::{
    pkg: "other_cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let canon_abi = PackageAbi::{
    package_name: "canon_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([canon_box]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let other_abi = PackageAbi::{
    package_name: "other_cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([other_box]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  // Re-exporting package `cfg_alias` re-exports `canon_cfg::BoxCfg` as `BoxCfg`
  // and `other_cfg::BoxCfg` as `OtherBox`.
  let reexport_abi = PackageAbi::{
    package_name: "cfg_alias_pkg",
    enums: [],
    struct_val_fields: [],
    structs: Some([]),
    companion_files: [],
    op_impls: [],
    reexports: [
      AbiReexport::{ name: "BoxCfg", kind: "type", target_pkg: "canon_cfg", target_name: "BoxCfg" },
      AbiReexport::{ name: "OtherBox", kind: "type", target_pkg: "other_cfg", target_name: "BoxCfg" },
    ],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let src =
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn build(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 1, b: true } }))\n" +
  "}\n"

  let pkg_aliases : Map[String, String] = Map()
  pkg_aliases["cfg"] = "cfg"
  pkg_aliases["cfg_alias"] = "cfg_alias"
  pkg_aliases["other"] = "other"
  let api = ApiMap::{
    symbols: [],
    pkg_aliases: pkg_aliases,
  }

  // Probe 1: `cfg::BoxCfg` and re-exported `cfg_alias::BoxCfg` both resolve to `canon_cfg::BoxCfg` -> deduplicate to 1 candidate.
  let same_reexport_toml =
  "[struct_defaults.\"cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n\n" +
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n"
  let d1 : Array[Diag] = []
  let rec_same = parse_recipes_toml(same_reexport_toml, "reexport_same.toml", d1)
  assert_eq(d1.length(), 0)
  let res_same = transpile_package_with_abis(
    [SourceFile::{ rel_path: "reexport_same.mbt", content: src, is_test: false }],
    api,
    rec_same,
    [],
    [],
    [],
    [("cfg", canon_abi), ("cfg_alias", reexport_abi), ("other", other_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_same.diagnostics.length(), 0)
  let out_same = res_same.files[0].content
  assert_true(
    str_has(out_same, "cfg::BoxCfg::{ a: 1, b: true, pad: Option::None }"),
    "re-exported alias of same defining package must deduplicate to unique candidate: " + out_same,
  )

  // Probe 2: `cfg_alias::BoxCfg` (from `canon_cfg::BoxCfg`) and `cfg_alias::OtherBox` (from `other_cfg::BoxCfg`)
  // have distinct defining-package ABI identities -> must fail closed on ambiguity.
  let diff_reexport_toml =
  "[struct_defaults.\"cfg_alias::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n\n" +
  "[struct_defaults.\"cfg_alias::OtherBox\"]\n" +
  "pad = \"Option::None\"\n"
  let d2 : Array[Diag] = []
  let rec_diff = parse_recipes_toml(diff_reexport_toml, "reexport_diff.toml", d2)
  assert_eq(d2.length(), 0)
  let res_diff = transpile_package_with_abis(
    [SourceFile::{ rel_path: "reexport_diff.mbt", content: src, is_test: false }],
    api,
    rec_diff,
    [],
    [],
    [],
    [("cfg", canon_abi), ("cfg_alias", reexport_abi), ("other", other_abi)],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res_diff.diagnostics.length(), 0)
  let out_diff = res_diff.files[0].content
  assert_true(
    str_has(out_diff, "wrap(fn() { { a: 1, b: true } })") &&
    !str_has(out_diff, "BoxCfg::{") &&
    !str_has(out_diff, "OtherBox::{"),
    "two re-exports from distinct defining packages must fail closed on ambiguity: " + out_diff,
  )
}

test "moon.pkg source import alias and swapped aliases resolve struct_defaults without flipping" {
  // Case 1: `import { "demo/cfg" @source_cfg }` + `--dep cfg` + `[struct_defaults."source_cfg::BoxCfg"]`
  let cfg_box = AbiStructSchema::{
    pkg: "cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let cfg_abi = PackageAbi::{
    package_name: "cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([cfg_box]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let src_alias =
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn make_explicit() -> @source_cfg.BoxCfg {\n" +
  "  @source_cfg.BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_anon(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 2, b: true } }))\n" +
  "}\n"

  let opts_alias = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/cfg\" @source_cfg,\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let rec_alias_toml =
  "[struct_defaults.\"source_cfg::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n"
  let da : Array[Diag] = []
  let rec_alias = parse_recipes_toml(rec_alias_toml, "source_alias.toml", da)
  assert_eq(da.length(), 0)
  let res_alias = transpile_package_with_abis(
    [SourceFile::{ rel_path: "source_alias.mbt", content: src_alias, is_test: false }],
    empty_api_map(),
    rec_alias,
    [],
    [],
    [],
    [("cfg", cfg_abi)],
    [],
    opts_alias,
    [],
    false,
    noop_check,
  )
  assert_eq(res_alias.diagnostics.length(), 0)
  let out_alias = res_alias.files[0].content
  assert_true(
    str_has(out_alias, "cfg::BoxCfg::{ a: 1, b: true, pad: Option::None }"),
    "explicit @source_cfg.BoxCfg must lower to cfg::BoxCfg with pad default: " + out_alias,
  )
  assert_true(
    str_has(out_alias, "cfg::BoxCfg::{ a: 2, b: true, pad: Option::None }"),
    "anonymous literal under moon.pkg @source_cfg alias must resolve to cfg::BoxCfg with pad default: " + out_alias,
  )

  // Case 2: Swapped aliases `import { "demo/a" @b, "demo/b" @a }` + `--dep a --dep b` + `[struct_defaults."b::BoxCfg"]`.
  let box_a = AbiStructSchema::{
    pkg: "a",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let box_b = AbiStructSchema::{
    pkg: "b",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let abi_a = PackageAbi::{
    package_name: "a",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_a]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_b = PackageAbi::{
    package_name: "b",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_b]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let src_swap =
  "pub fn make_from_b() -> @b.BoxCfg {\n" +
  "  @b.BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_from_a() -> @a.BoxCfg {\n" +
  "  @a.BoxCfg::{ a: 2, b: false }\n" +
  "}\n"

  let opts_swap = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/a\" @b,\n  \"demo/b\" @a,\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let rec_swap_toml =
  "[struct_defaults.\"b::BoxCfg\"]\n" +
  "pad = \"Option::None\"\n"
  let ds : Array[Diag] = []
  let rec_swap = parse_recipes_toml(rec_swap_toml, "swap.toml", ds)
  assert_eq(ds.length(), 0)
  let res_swap = transpile_package_with_abis(
    [SourceFile::{ rel_path: "swap.mbt", content: src_swap, is_test: false }],
    empty_api_map(),
    rec_swap,
    [],
    [],
    [],
    [("a", abi_a), ("b", abi_b)],
    [],
    opts_swap,
    [],
    false,
    noop_check,
  )
  assert_eq(res_swap.diagnostics.length(), 0)
  let out_swap = res_swap.files[0].content
  assert_true(
    str_has(out_swap, "a::BoxCfg::{ a: 1, b: true, pad: Option::None }"),
    "swapped @b.BoxCfg (dep a) must receive pad default: " + out_swap,
  )
  assert_true(
    str_has(out_swap, "b::BoxCfg::{ a: 2, b: false }") &&
    !str_has(out_swap, "b::BoxCfg::{ a: 2, b: false, pad:"),
    "swapped @a.BoxCfg (dep b) must never receive pad default: " + out_swap,
  )
}

test "type_aliases and private using_types targets never double-map under swapped or source moon.pkg aliases" {
  // Case 1: Swapped aliases `import { "demo/a" @b, "demo/b" @a }` + `type Picked = @b.BoxCfg` + `[struct_defaults.Picked]`.
  let box_a = AbiStructSchema::{
    pkg: "a",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let box_b = AbiStructSchema::{
    pkg: "b",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let abi_a = PackageAbi::{
    package_name: "a",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_a]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_b = PackageAbi::{
    package_name: "b",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_b]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let src_picked =
  "type Picked = @b.BoxCfg\n\n" +
  "pub fn make_from_b() -> @b.BoxCfg {\n" +
  "  @b.BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_from_a() -> @a.BoxCfg {\n" +
  "  @a.BoxCfg::{ a: 2, b: false }\n" +
  "}\n"

  let opts_swap = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/a\" @b,\n  \"demo/b\" @a,\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let rec_picked_toml =
  "[struct_defaults.Picked]\n" +
  "pad = \"Option::None\"\n"
  let dp : Array[Diag] = []
  let rec_picked = parse_recipes_toml(rec_picked_toml, "picked.toml", dp)
  assert_eq(dp.length(), 0)
  let res_picked = transpile_package_with_abis(
    [SourceFile::{ rel_path: "picked.mbt", content: src_picked, is_test: false }],
    empty_api_map(),
    rec_picked,
    [],
    [],
    [],
    [("a", abi_a), ("b", abi_b)],
    [],
    opts_swap,
    [],
    false,
    noop_check,
  )
  assert_eq(res_picked.diagnostics.length(), 0)
  let out_picked = res_picked.files[0].content
  assert_true(
    str_has(out_picked, "a::BoxCfg::{ a: 1, b: true, pad: Option::None }"),
    "type Picked = @b.BoxCfg rule must apply to a::BoxCfg without flipping: " + out_picked,
  )
  assert_true(
    str_has(out_picked, "b::BoxCfg::{ a: 2, b: false }") &&
    !str_has(out_picked, "b::BoxCfg::{ a: 2, b: false, pad:"),
    "type Picked = @b.BoxCfg rule must never flip onto b::BoxCfg: " + out_picked,
  )

  // Case 2: Private `using @source_cfg { type BoxCfg }` with `import { "demo/cfg" @source_cfg }`
  // works for both `[struct_defaults."source_cfg::BoxCfg"]` and `[struct_defaults.BoxCfg]`.
  let cfg_box = AbiStructSchema::{
    pkg: "cfg",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let cfg_abi = PackageAbi::{
    package_name: "cfg",
    enums: [],
    struct_val_fields: [],
    structs: Some([cfg_box]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let src_using =
  "using @source_cfg { type BoxCfg }\n\n" +
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn make_explicit() -> BoxCfg {\n" +
  "  BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_anon(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 2, b: true } }))\n" +
  "}\n"

  let opts_using = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/cfg\" @source_cfg,\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }

  let d_src : Array[Diag] = []
  let rec_src = parse_recipes_toml("[struct_defaults.\"source_cfg::BoxCfg\"]\npad = \"Option::None\"\n", "u1.toml", d_src)
  assert_eq(d_src.length(), 0)
  let res_u1 = transpile_package_with_abis(
    [SourceFile::{ rel_path: "using_src.mbt", content: src_using, is_test: false }],
    empty_api_map(),
    rec_src,
    [],
    [],
    [],
    [("cfg", cfg_abi)],
    [],
    opts_using,
    [],
    false,
    noop_check,
  )
  assert_eq(res_u1.diagnostics.length(), 0)
  let out_u1 = res_u1.files[0].content
  assert_true(
    str_has(out_u1, "cfg::BoxCfg::{ a: 1, b: true, pad: Option::None }") &&
    str_has(out_u1, "cfg::BoxCfg::{ a: 2, b: true, pad: Option::None }"),
    "private using with source_cfg::BoxCfg rule must fill explicit and anon literals: " + out_u1,
  )

  let d_bare : Array[Diag] = []
  let rec_bare = parse_recipes_toml("[struct_defaults.BoxCfg]\npad = \"Option::None\"\n", "u2.toml", d_bare)
  assert_eq(d_bare.length(), 0)
  let res_u2 = transpile_package_with_abis(
    [SourceFile::{ rel_path: "using_bare.mbt", content: src_using, is_test: false }],
    empty_api_map(),
    rec_bare,
    [],
    [],
    [],
    [("cfg", cfg_abi)],
    [],
    opts_using,
    [],
    false,
    noop_check,
  )
  assert_eq(res_u2.diagnostics.length(), 0)
  let out_u2 = res_u2.files[0].content
  assert_true(
    str_has(out_u2, "cfg::BoxCfg::{ a: 1, b: true, pad: Option::None }") &&
    str_has(out_u2, "cfg::BoxCfg::{ a: 2, b: true, pad: Option::None }"),
    "private using with bare BoxCfg rule must fill explicit and anon literals: " + out_u2,
  )
}

test "swapped aliases preserve private using and re-exported using via resolved_dep marker without double-mapping" {
  let box_a = AbiStructSchema::{
    pkg: "a",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "pad", emit_name: "pad", ty: "Option[Int]", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let box_b = AbiStructSchema::{
    pkg: "b",
    name: "BoxCfg",
    type_params: [],
    fields: [
      AbiStructField::{ src_name: "a", emit_name: "a", ty: "Int", is_mut: false, visibility: "pub" },
      AbiStructField::{ src_name: "b", emit_name: "b", ty: "Bool", is_mut: false, visibility: "pub" },
    ],
    can_construct: true,
    can_update: true,
    complete: true,
  }
  let abi_a = PackageAbi::{
    package_name: "a",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_a]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_b = PackageAbi::{
    package_name: "b",
    enums: [],
    struct_val_fields: [],
    structs: Some([box_b]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_wrap = PackageAbi::{
    package_name: "wrap_pkg",
    enums: [],
    struct_val_fields: [],
    structs: Some([]),
    companion_files: [],
    op_impls: [],
    reexports: [
      AbiReexport::{ name: "BoxCfg", kind: "type", target_pkg: "a", target_name: "BoxCfg" },
    ],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }

  let rec_toml = "[struct_defaults.BoxCfg]\npad = \"Option::None\"\n"
  let dr : Array[Diag] = []
  let rec = parse_recipes_toml(rec_toml, "swap_using.toml", dr)
  assert_eq(dr.length(), 0)

  // Case 1: Swapped aliases `a @b, b @a` + private `using @b { type BoxCfg }` + `[struct_defaults.BoxCfg]`
  // with a spoof-like user comment mentioning `resolved_dep` preserved verbatim.
  let user_comment = "// Example of a generated comment: // mbt2pion:resolved_dep used by the translator."
  let src_priv =
  user_comment + "\n" +
  "using @b { type BoxCfg }\n\n" +
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn make_qual_b() -> @b.BoxCfg {\n" +
  "  @b.BoxCfg::{ a: 1, b: true }\n" +
  "}\n\n" +
  "pub fn make_bare() -> BoxCfg {\n" +
  "  BoxCfg::{ a: 2, b: true }\n" +
  "}\n\n" +
  "pub fn make_anon(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 3, b: true } }))\n" +
  "}\n\n" +
  "pub fn make_qual_a() -> @a.BoxCfg {\n" +
  "  @a.BoxCfg::{ a: 4, b: false }\n" +
  "}\n"

  let opts_swap = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/a\" @b,\n  \"demo/b\" @a,\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let res_priv = transpile_package_with_abis(
    [SourceFile::{ rel_path: "swap_priv_using.mbt", content: src_priv, is_test: false }],
    empty_api_map(),
    rec,
    [],
    [],
    [],
    [("a", abi_a), ("b", abi_b)],
    [],
    opts_swap,
    [],
    false,
    noop_check,
  )
  assert_eq(res_priv.diagnostics.length(), 0)
  let out_priv = res_priv.files[0].content
  assert_true(
    str_has(out_priv, "a::BoxCfg::{ a: 1, b: true, pad: Option::None }") &&
    str_has(out_priv, "a::BoxCfg::{ a: 2, b: true, pad: Option::None }") &&
    str_has(out_priv, "a::BoxCfg::{ a: 3, b: true, pad: Option::None }"),
    "swapped alias private using @b must lower @b, bare BoxCfg, and anon literal to a::BoxCfg with pad: " + out_priv,
  )
  assert_true(
    str_has(out_priv, "b::BoxCfg::{ a: 4, b: false }") &&
    !str_has(out_priv, "b::BoxCfg::{ a: 4, b: false, pad:"),
    "swapped alias @a.BoxCfg (dep b) must never receive pad default: " + out_priv,
  )
  assert_true(
    str_has(out_priv, user_comment),
    "user comment containing resolved_dep text must be preserved verbatim and never spoof alias resolution: " + out_priv,
  )

  // Case 2: Swapped aliases `a @b, b @a` + wrapper package `wrap` re-exporting `a::BoxCfg` + `using @wrap { type BoxCfg }`.
  let src_reexport =
  "using @wrap { type BoxCfg }\n\n" +
  "pub fn make_from_wrap() -> BoxCfg {\n" +
  "  BoxCfg::{ a: 5, b: true }\n" +
  "}\n\n" +
  "pub fn make_qual_a() -> @a.BoxCfg {\n" +
  "  @a.BoxCfg::{ a: 6, b: false }\n" +
  "}\n"

  let opts_wrap = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "import {\n  \"demo/a\" @b,\n  \"demo/b\" @a,\n  \"demo/wrap\",\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let res_wrap = transpile_package_with_abis(
    [SourceFile::{ rel_path: "swap_wrap_using.mbt", content: src_reexport, is_test: false }],
    empty_api_map(),
    rec,
    [],
    [],
    [],
    [("a", abi_a), ("b", abi_b), ("wrap", abi_wrap)],
    [],
    opts_wrap,
    [],
    false,
    noop_check,
  )
  assert_eq(res_wrap.diagnostics.length(), 0)
  let out_wrap = res_wrap.files[0].content
  assert_true(
    str_has(out_wrap, "a::BoxCfg::{ a: 5, b: true, pad: Option::None }"),
    "re-exported using @wrap under swapped aliases must resolve to a::BoxCfg without flipping: " + out_wrap,
  )
  assert_true(
    str_has(out_wrap, "b::BoxCfg::{ a: 6, b: false }") &&
    !str_has(out_wrap, "b::BoxCfg::{ a: 6, b: false, pad:"),
    "re-exported using @wrap must never flip defaults onto b::BoxCfg: " + out_wrap,
  )
  assert_true(
    !str_has(out_wrap, "/*") && !str_has(out_wrap, "resolved_dep"),
    "internal resolved_dep marker must never leak into emitted .pion output: " + out_wrap,
  )
}

test "rewrite_dep_reexports v2 and legacy preserve non-reexported using verbatim under swapped aliases" {
  let abi_a = PackageAbi::{
    package_name: "a",
    enums: [],
    struct_val_fields: [],
    structs: Some([]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let abi_b = PackageAbi::{
    package_name: "b",
    enums: [],
    struct_val_fields: [],
    structs: Some([]),
    companion_files: [],
    op_impls: [],
    reexports: [],
    values: [],
    raising_fns: [],
    fn_mutation_summaries: [],
    ffi_shim_prefix: "",
    publishable: true,
    empty_target_pkg: false,
    empty_target: "",
  }
  let moon_imports : Map[String, String] = Map()
  moon_imports["b"] = "demo/a"
  moon_imports["a"] = "demo/b"
  let src = "using @b { type BoxCfg }\n"
  let files = [SourceFile::{ rel_path: "keep.mbt", content: src, is_test: false }]
  let d_v2 : Array[Diag] = []
  let out_v2 = rewrite_dep_reexports_v2(files, Map(), moon_imports, [], [("a", abi_a), ("b", abi_b)], d_v2)
  assert_eq(d_v2.length(), 0)
  assert_true(
    out_v2[0].content == src && !str_has(out_v2[0].content, "resolved_dep") && !str_has(out_v2[0].content, "using @a"),
    "rewrite_dep_reexports_v2 must keep non-reexported using @b verbatim: " + out_v2[0].content,
  )
  let d_leg : Array[Diag] = []
  let out_leg = rewrite_dep_reexports(files, Map(), moon_imports, [], [("a", abi_a), ("b", abi_b)], d_leg)
  assert_eq(d_leg.length(), 0)
  assert_true(
    out_leg[0].content == src && !str_has(out_leg[0].content, "resolved_dep") && !str_has(out_leg[0].content, "using @a"),
    "legacy rewrite_dep_reexports must keep non-reexported using @b verbatim: " + out_leg[0].content,
  )
}

test "build_struct_defaults_index resolves local type alias before checking local struct_field_renames" {
  let src =
  "pub struct Zed {\n" +
  "  a : Int\n" +
  "  b : Bool\n" +
  "  pad : Int\n" +
  "}\n\n" +
  "type Alias = Zed\n\n" +
  "pub struct Host {\n" +
  "  id : Int\n" +
  "}\n\n" +
  "pub fn[T] wrap(_f : () -> T) -> Int {\n" +
  "  0\n" +
  "}\n\n" +
  "pub fn Host::apply(self : Host, _w : Int) -> Host {\n" +
  "  self\n" +
  "}\n\n" +
  "pub fn build_anon(h : Host) -> Host {\n" +
  "  h.apply(wrap(fn() { { a: 1, b: true } }))\n" +
  "}\n"

  let rec_toml =
  "[struct_defaults.Alias]\n" +
  "pad = \"7\"\n\n" +
  "[struct_defaults.Zed]\n" +
  "pad = \"7\"\n"
  let dr : Array[Diag] = []
  let rec = parse_recipes_toml(rec_toml, "local_alias.toml", dr)
  assert_eq(dr.length(), 0)
  let res = transpile_package(
    [SourceFile::{ rel_path: "local_alias.mbt", content: src, is_test: false }],
    empty_api_map(),
    rec,
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.diagnostics.length(), 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "Zed::{ a: 1, b: true, pad: 7 }"),
    "local type Alias = Zed rule must resolve to Zed::{ a: 1, b: true, pad: 7 }: " + out,
  )
}
