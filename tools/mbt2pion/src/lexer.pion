///| Lossless MoonBit lexer (zero raw-text regex transforms).
///|
///| Preserves all whitespace and comments as `leading_trivia` on each token
///| (plus a final `Eof` token carrying any trailing trivia) and keeps literal
///| bytes verbatim.
///|
///| Handles:
///| - Nested `\{...}` string interpolation inside `"..."` and `$|...`
///| - Raw multiline strings `#|...` (no interpolation) vs `$|...` (interpolated)
///| - Char / byte literals `'a'`, `b'x'`, `'\u{...}'`, `'\x...'`
///| - Byte string literals `b"..."`
///| - Numeric literals `0x...L`, `1_000`, `0b...`, `0o...`, `1.5e-7`, `U`/`UL`/`L`
///| - Multiline-leading `|>` and `..` via `newline_before` flag
///| - Exact operator distinction: `..=` vs `..<` vs `..`, `=>` vs `->`, `?=` vs `?`
///| - Package-qualified identifiers `@pkg` and attributes `#attr(...)`

#derive(Eq)
pub enum TokenKind {
  Ident
  UpperIdent
  Keyword
  PkgRef
  Attr
  IntLit
  FloatLit
  StringLit
  InterpString
  RawMultiline
  InterpMultiline
  ByteStringLit
  CharLit
  ByteCharLit
  LParen
  RParen
  LBrace
  RBrace
  LBracket
  RBracket
  Comma
  Semi
  Colon
  ColonColon
  Dot
  DotDot
  DotDotLt
  DotDotLtEq
  DotDotEq
  Arrow
  FatArrow
  PipeGt
  Question
  QuestionEq
  Tilde
  Eq
  EqEq
  BangEq
  Lt
  LtEq
  Gt
  GtEq
  Plus
  Minus
  Star
  Slash
  Percent
  Bang
  AmpAmp
  PipePipe
  Amp
  Pipe
  Caret
  Shl
  Shr
  AssignOp
  Underscore
  Other
  Eof
}

pub struct Token {
  kind : TokenKind
  raw : String
  leading_trivia : String
  newline_before : Bool
  line : Int
  col : Int
  start_byte : Int
  end_byte : Int
}

fn is_alpha(c : Int) -> Bool {
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn is_upper(c : Int) -> Bool {
  c >= 65 && c <= 90
}

fn is_digit(c : Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_hex(c : Int) -> Bool {
  is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn is_alnum(c : Int) -> Bool {
  is_alpha(c) || is_digit(c)
}

pub fn is_mbt_keyword(s : String) -> Bool {
  s == "fn" ||
  s == "let" ||
  s == "mut" ||
  s == "pub" ||
  s == "priv" ||
  s == "struct" ||
  s == "enum" ||
  s == "type" ||
  s == "typealias" ||
  s == "trait" ||
  s == "impl" ||
  s == "with" ||
  s == "for" ||
  s == "in" ||
  s == "while" ||
  s == "loop" ||
  s == "if" ||
  s == "else" ||
  s == "match" ||
  s == "guard" ||
  s == "is" ||
  s == "as" ||
  s == "return" ||
  s == "break" ||
  s == "continue" ||
  s == "const" ||
  s == "test" ||
  s == "init" ||
  s == "true" ||
  s == "false" ||
  s == "derive" ||
  s == "raise" ||
  s == "try" ||
  s == "catch" ||
  s == "suberror" ||
  s == "extern" ||
  s == "using" ||
  s == "not" ||
  s == "and" ||
  s == "or"
}

struct LexState {
  src : String
  len : Int
  mut pos : Int
  mut line : Int
  mut col : Int
}

fn lex_peek(st : LexState, offset : Int) -> Int {
  let idx = st.pos + offset
  if idx >= 0 && idx < st.len {
    st.src.code_unit_at(idx)
  } else {
    -1
  }
}

fn lex_advance(st : LexState) -> Int {
  if st.pos >= st.len {
    return -1
  }
  let c = st.src.code_unit_at(st.pos)
  st.pos = st.pos + 1
  if c == 10 {
    st.line = st.line + 1
    st.col = 1
  } else {
    st.col = st.col + 1
  }
  c
}

///| Scan a string literal starting after the opening `"`, handling nested `\{...}`.
///| Returns `true` if any `\{...}` interpolation was seen.
fn scan_string_body(st : LexState) -> Bool {
  let mut has_interp = false
  while st.pos < st.len {
    let c = lex_advance(st)
    if c == 34 {
      // closing "
      return has_interp
    }
    if c == 92 {
      // backslash
      let nxt = lex_peek(st, 0)
      if nxt == 123 {
        // `\{` interpolation: scan balanced braces, respecting nested strings & chars
        has_interp = true
        let _ = lex_advance(st)
        let mut depth = 1
        while st.pos < st.len && depth > 0 {
          let ic = lex_advance(st)
          if ic == 123 {
            depth = depth + 1
          } else if ic == 125 {
            depth = depth - 1
          } else if ic == 34 {
            let _ = scan_string_body(st)
          } else if ic == 39 {
            scan_char_body(st)
          } else if ic == 47 && lex_peek(st, 0) == 47 {
            while st.pos < st.len && lex_peek(st, 0) != 10 {
              let _ = lex_advance(st)
            }
          } else if ic == 47 && lex_peek(st, 0) == 42 {
            let _ = lex_advance(st)
            let mut cdepth = 1
            while st.pos < st.len && cdepth > 0 {
              let cc = lex_advance(st)
              if cc == 47 && lex_peek(st, 0) == 42 {
                let _ = lex_advance(st)
                cdepth = cdepth + 1
              } else if cc == 42 && lex_peek(st, 0) == 47 {
                let _ = lex_advance(st)
                cdepth = cdepth - 1
              }
            }
          }
        }
      } else if st.pos < st.len {
        let _ = lex_advance(st)
      }
    }
  }
  has_interp
}

fn scan_char_body(st : LexState) -> Unit {
  while st.pos < st.len {
    let c = lex_advance(st)
    if c == 39 {
      return
    }
    if c == 92 && st.pos < st.len {
      let _ = lex_advance(st)
    }
  }
}

///| Scan line-oriented multiline string (`#|...` or `$|...`) until end of line.
fn scan_to_eol(st : LexState) -> Unit {
  while st.pos < st.len && lex_peek(st, 0) != 10 {
    let _ = lex_advance(st)
  }
}

///| Scan trivia (whitespace, `//`, `///`, `///|`, nested `/* ... */`).
///| Returns `(trivia_string, saw_newline)`.
fn scan_trivia(st : LexState) -> (String, Bool) {
  let start = st.pos
  let mut saw_nl = false
  while st.pos < st.len {
    let c = lex_peek(st, 0)
    if c == 32 || c == 9 || c == 13 {
      let _ = lex_advance(st)
    } else if c == 10 {
      saw_nl = true
      let _ = lex_advance(st)
    } else if c == 47 && lex_peek(st, 1) == 47 {
      // `//` comment (including `///` and `///|`)
      while st.pos < st.len && lex_peek(st, 0) != 10 {
        let _ = lex_advance(st)
      }
    } else if c == 47 && lex_peek(st, 1) == 42 {
      // nested `/* ... */`
      let _ = lex_advance(st)
      let _ = lex_advance(st)
      let mut depth = 1
      while st.pos < st.len && depth > 0 {
        let a = lex_advance(st)
        if a == 10 {
          saw_nl = true
        } else if a == 47 && lex_peek(st, 0) == 42 {
          let _ = lex_advance(st)
          depth = depth + 1
        } else if a == 42 && lex_peek(st, 0) == 47 {
          let _ = lex_advance(st)
          depth = depth - 1
        }
      }
    } else {
      break
    }
  }
  (st.src.slice(start, st.pos), saw_nl)
}

///| Tokenize a full MoonBit source string losslessly.
pub fn lex_moonbit(src : String) -> Array[Token] {
  let st = LexState::{ src: src, len: src.length(), pos: 0, line: 1, col: 1 }
  let tokens : Array[Token] = []
  while true {
    let (trivia, saw_nl) = scan_trivia(st)
    let tok_line = st.line
    let tok_col = st.col
    let start = st.pos
    if st.pos >= st.len {
      tokens.push(Token::{
        kind: TokenKind::Eof,
        raw: "",
        leading_trivia: trivia,
        newline_before: saw_nl,
        line: tok_line,
        col: tok_col,
        start_byte: start,
        end_byte: start,
      })
      break
    }
    let c = lex_peek(st, 0)
    let c1 = lex_peek(st, 1)
    let mut kind = TokenKind::Other

    // Raw multiline `#|...`
    if c == 35 && c1 == 124 {
      let _ = lex_advance(st)
      let _ = lex_advance(st)
      scan_to_eol(st)
      kind = TokenKind::RawMultiline
      // Interpolated multiline `$|...`
    } else if c == 36 && c1 == 124 {
      let _ = lex_advance(st)
      let _ = lex_advance(st)
      scan_to_eol(st)
      kind = TokenKind::InterpMultiline
      // Attribute `#ident...` (e.g. `#derive(...)`, `#callsite(...)`, `#warnings(...)`)
    } else if c == 35 && is_alpha(c1) {
      let _ = lex_advance(st)
      while st.pos < st.len && (is_alnum(lex_peek(st, 0)) || lex_peek(st, 0) == 46) {
        let _ = lex_advance(st)
      }
      if lex_peek(st, 0) == 40 {
        let _ = lex_advance(st)
        let mut depth = 1
        while st.pos < st.len && depth > 0 {
          let ac = lex_advance(st)
          if ac == 40 {
            depth = depth + 1
          } else if ac == 41 {
            depth = depth - 1
          } else if ac == 34 {
            let _ = scan_string_body(st)
          }
        }
      }
      kind = TokenKind::Attr
      // Byte string `b"..."`
    } else if c == 98 && c1 == 34 {
      let _ = lex_advance(st)
      let _ = lex_advance(st)
      let _ = scan_string_body(st)
      kind = TokenKind::ByteStringLit
      // Byte char `b'...'`
    } else if c == 98 && c1 == 39 {
      let _ = lex_advance(st)
      let _ = lex_advance(st)
      scan_char_body(st)
      kind = TokenKind::ByteCharLit
      // String `"..."` (may contain `\{...}`)
    } else if c == 34 {
      let _ = lex_advance(st)
      let has_interp = scan_string_body(st)
      kind = if has_interp { TokenKind::InterpString } else { TokenKind::StringLit }
      // Char `'...'`
    } else if c == 39 {
      let _ = lex_advance(st)
      scan_char_body(st)
      kind = TokenKind::CharLit
      // Package ref `@pkg` or `@org/pkg`
    } else if c == 64 && is_alpha(c1) {
      let _ = lex_advance(st)
      while st.pos < st.len && (is_alnum(lex_peek(st, 0)) || lex_peek(st, 0) == 47 || lex_peek(st, 0) == 45) {
        let _ = lex_advance(st)
      }
      kind = TokenKind::PkgRef
      // Numeric literals
    } else if is_digit(c) {
      let mut is_float = false
      if c == 48 && (c1 == 120 || c1 == 88) {
        // hex integer or hex float (`0x1.0p1023`, `0x1p-54`, `0x1.fp-1022`)
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        while st.pos < st.len && (is_hex(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
          let _ = lex_advance(st)
        }
        if lex_peek(st, 0) == 46 && is_hex(lex_peek(st, 1)) {
          is_float = true
          let _ = lex_advance(st)
          while st.pos < st.len && (is_hex(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
            let _ = lex_advance(st)
          }
        }
        if lex_peek(st, 0) == 112 || lex_peek(st, 0) == 80 {
          is_float = true
          let _ = lex_advance(st)
          if lex_peek(st, 0) == 43 || lex_peek(st, 0) == 45 {
            let _ = lex_advance(st)
          }
          while st.pos < st.len && (is_digit(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
            let _ = lex_advance(st)
          }
          // Optional Float32 suffix `F` on hex float literal (`0x1.8p0F`, `0x1p-149F`); never matches hex int `0xFF`
          if lex_peek(st, 0) == 70 && !is_alnum(lex_peek(st, 1)) {
            let _ = lex_advance(st)
          }
        }
      } else if c == 48 && (c1 == 98 || c1 == 66) {
        // binary
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        while st.pos < st.len && (lex_peek(st, 0) == 48 || lex_peek(st, 0) == 49 || lex_peek(st, 0) == 95) {
          let _ = lex_advance(st)
        }
      } else if c == 48 && (c1 == 111 || c1 == 79) {
        // octal
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        while st.pos < st.len && ((lex_peek(st, 0) >= 48 && lex_peek(st, 0) <= 55) || lex_peek(st, 0) == 95) {
          let _ = lex_advance(st)
        }
      } else {
        let mut has_dot = false
        while st.pos < st.len && (is_digit(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
          let _ = lex_advance(st)
        }
        if lex_peek(st, 0) == 46 && is_digit(lex_peek(st, 1)) {
          is_float = true
          has_dot = true
          let _ = lex_advance(st)
          while st.pos < st.len && (is_digit(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
            let _ = lex_advance(st)
          }
        }
        if lex_peek(st, 0) == 101 || lex_peek(st, 0) == 69 {
          is_float = true
          let _ = lex_advance(st)
          if lex_peek(st, 0) == 43 || lex_peek(st, 0) == 45 {
            let _ = lex_advance(st)
          }
          while st.pos < st.len && (is_digit(lex_peek(st, 0)) || lex_peek(st, 0) == 95) {
            let _ = lex_advance(st)
          }
        }
        // Optional Float32 suffix: uppercase `F` on decimal floats with `.` (aligned with MoonBit syntax)
        if is_float && has_dot && lex_peek(st, 0) == 70 && !is_alnum(lex_peek(st, 1)) {
          let _ = lex_advance(st)
        }
      }
      // Optional integer suffix: U, UL, L, N
      if !is_float {
        if lex_peek(st, 0) == 85 || lex_peek(st, 0) == 117 {
          let _ = lex_advance(st)
          if lex_peek(st, 0) == 76 || lex_peek(st, 0) == 108 {
            let _ = lex_advance(st)
          }
        } else if lex_peek(st, 0) == 76 || lex_peek(st, 0) == 108 || lex_peek(st, 0) == 78 {
          let _ = lex_advance(st)
        }
      }
      kind = if is_float { TokenKind::FloatLit } else { TokenKind::IntLit }
      // Identifier / keyword / underscore
    } else if is_alpha(c) {
      while st.pos < st.len && is_alnum(lex_peek(st, 0)) {
        let _ = lex_advance(st)
      }
      let raw_id = src.slice(start, st.pos)
      if raw_id == "_" {
        kind = TokenKind::Underscore
      } else if is_mbt_keyword(raw_id) {
        kind = TokenKind::Keyword
      } else if is_upper(c) {
        kind = TokenKind::UpperIdent
      } else {
        kind = TokenKind::Ident
      }
      // Punctuation & operators
    } else {
      let c2 = lex_peek(st, 2)
      let c3 = lex_peek(st, 3)
      if c == 46 && c1 == 46 && c2 == 60 && c3 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::DotDotLtEq
      } else if c == 46 && c1 == 46 && c2 == 60 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::DotDotLt
      } else if c == 46 && c1 == 46 && c2 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::DotDotEq
      } else if c == 46 && c1 == 46 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::DotDot
      } else if c == 46 {
        let _ = lex_advance(st)
        kind = TokenKind::Dot
      } else if c == 58 && c1 == 58 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::ColonColon
      } else if c == 58 {
        let _ = lex_advance(st)
        kind = TokenKind::Colon
      } else if c == 45 && c1 == 62 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::Arrow
      } else if c == 61 && c1 == 62 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::FatArrow
      } else if c == 61 && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::EqEq
      } else if c == 61 {
        let _ = lex_advance(st)
        kind = TokenKind::Eq
      } else if c == 124 && c1 == 62 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::PipeGt
      } else if c == 124 && c1 == 124 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::PipePipe
      } else if c == 124 {
        let _ = lex_advance(st)
        kind = TokenKind::Pipe
      } else if c == 38 && c1 == 38 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::AmpAmp
      } else if c == 38 {
        let _ = lex_advance(st)
        kind = TokenKind::Amp
      } else if c == 63 && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::QuestionEq
      } else if c == 63 {
        let _ = lex_advance(st)
        kind = TokenKind::Question
      } else if c == 126 {
        let _ = lex_advance(st)
        kind = TokenKind::Tilde
      } else if c == 33 && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::BangEq
      } else if c == 33 {
        let _ = lex_advance(st)
        kind = TokenKind::Bang
      } else if c == 60 && c1 == 60 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::Shl
      } else if c == 60 && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::LtEq
      } else if c == 60 {
        let _ = lex_advance(st)
        kind = TokenKind::Lt
      } else if c == 62 && c1 == 62 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::Shr
      } else if c == 62 && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::GtEq
      } else if c == 62 {
        let _ = lex_advance(st)
        kind = TokenKind::Gt
      } else if (c == 43 || c == 45 || c == 42 || c == 47 || c == 37) && c1 == 61 {
        let _ = lex_advance(st)
        let _ = lex_advance(st)
        kind = TokenKind::AssignOp
      } else if c == 43 {
        let _ = lex_advance(st)
        kind = TokenKind::Plus
      } else if c == 45 {
        let _ = lex_advance(st)
        kind = TokenKind::Minus
      } else if c == 42 {
        let _ = lex_advance(st)
        kind = TokenKind::Star
      } else if c == 47 {
        let _ = lex_advance(st)
        kind = TokenKind::Slash
      } else if c == 37 {
        let _ = lex_advance(st)
        kind = TokenKind::Percent
      } else if c == 94 {
        let _ = lex_advance(st)
        kind = TokenKind::Caret
      } else if c == 40 {
        let _ = lex_advance(st)
        kind = TokenKind::LParen
      } else if c == 41 {
        let _ = lex_advance(st)
        kind = TokenKind::RParen
      } else if c == 123 {
        let _ = lex_advance(st)
        kind = TokenKind::LBrace
      } else if c == 125 {
        let _ = lex_advance(st)
        kind = TokenKind::RBrace
      } else if c == 91 {
        let _ = lex_advance(st)
        kind = TokenKind::LBracket
      } else if c == 93 {
        let _ = lex_advance(st)
        kind = TokenKind::RBracket
      } else if c == 44 {
        let _ = lex_advance(st)
        kind = TokenKind::Comma
      } else if c == 59 {
        let _ = lex_advance(st)
        kind = TokenKind::Semi
      } else {
        let _ = lex_advance(st)
        kind = TokenKind::Other
      }
    }

    tokens.push(Token::{
      kind: kind,
      raw: src.slice(start, st.pos),
      leading_trivia: trivia,
      newline_before: saw_nl,
      line: tok_line,
      col: tok_col,
      start_byte: start,
      end_byte: st.pos,
    })
  }
  tokens
}

///| Reconstruct exact source text from a lossless token stream.
pub fn tokens_to_source(tokens : Array[Token]) -> String {
  let sb = StringBuilder()
  for t in tokens {
    sb.write_string(t.leading_trivia)
    sb.write_string(t.raw)
  }
  sb.to_string()
}

///| Segment of an interpolated string literal: either literal bytes or an expression slice.
pub struct InterpPart {
  is_expr : Bool
  text : String
}

///| Skip a string literal inside an interpolation expression, starting after the opening `"`.
///| Respects `\` escapes and nested `\{...}` interpolations.
fn skip_interp_string_lit(s : String, start : Int, n : Int) -> Int {
  let mut j = start
  while j < n {
    let sc = s.code_unit_at(j)
    if sc == 92 && j + 1 < n {
      if s.code_unit_at(j + 1) == 123 {
        let end_hole = skip_interp_hole(s, j + 2, n)
        j = if end_hole < n { end_hole + 1 } else { n }
      } else {
        j = j + 2
      }
    } else if sc == 34 {
      return j + 1
    } else {
      j = j + 1
    }
  }
  n
}

///| Skip a `\{...}` interpolation hole starting right after `\{`, returning the index of the
///| matching `}` (or `n` if unterminated). Respects nested braces, string literals (including
///| nested `\{...}`), char literals `'...'` / `b'...'`, `//` line comments, and nested `/*...*/`.
fn skip_interp_hole(s : String, start : Int, n : Int) -> Int {
  let mut j = start
  let mut depth = 1
  while j < n && depth > 0 {
    let ec = s.code_unit_at(j)
    if ec == 123 {
      depth = depth + 1
      j = j + 1
    } else if ec == 125 {
      depth = depth - 1
      if depth == 0 {
        return j
      }
      j = j + 1
    } else if ec == 34 {
      j = skip_interp_string_lit(s, j + 1, n)
    } else if ec == 39 {
      j = j + 1
      while j < n {
        let cc = s.code_unit_at(j)
        if cc == 92 && j + 1 < n {
          j = j + 2
        } else if cc == 39 {
          j = j + 1
          break
        } else {
          j = j + 1
        }
      }
    } else if ec == 47 && j + 1 < n && s.code_unit_at(j + 1) == 47 {
      j = j + 2
      while j < n && s.code_unit_at(j) != 10 {
        j = j + 1
      }
    } else if ec == 47 && j + 1 < n && s.code_unit_at(j + 1) == 42 {
      j = j + 2
      let mut cdepth = 1
      while j < n && cdepth > 0 {
        let cc = s.code_unit_at(j)
        if cc == 47 && j + 1 < n && s.code_unit_at(j + 1) == 42 {
          cdepth = cdepth + 1
          j = j + 2
        } else if cc == 42 && j + 1 < n && s.code_unit_at(j + 1) == 47 {
          cdepth = cdepth - 1
          j = j + 2
        } else {
          j = j + 1
        }
      }
    } else {
      j = j + 1
    }
  }
  n
}

///| Split a `"..."` or `$|...` string into verbatim literal bytes and `\{...}` expression bodies.
pub fn split_interp_string(raw : String, is_multiline : Bool) -> Array[InterpPart] {
  let parts : Array[InterpPart] = []
  let inner = if is_multiline {
    if raw.starts_with("$|") { raw.slice(2, raw.length()) } else { raw }
  } else {
    if raw.length() >= 2 { raw.slice(1, raw.length() - 1) } else { "" }
  }
  let n = inner.length()
  let mut i = 0
  let mut lit_start = 0
  while i < n {
    let c = inner.code_unit_at(i)
    if c == 92 && i + 1 < n {
      let nxt = inner.code_unit_at(i + 1)
      if nxt == 123 {
        if i > lit_start {
          parts.push(InterpPart::{ is_expr: false, text: inner.slice(lit_start, i) })
        }
        let expr_start = i + 2
        let j = skip_interp_hole(inner, expr_start, n)
        parts.push(InterpPart::{ is_expr: true, text: inner.slice(expr_start, j) })
        i = if j < n { j + 1 } else { n }
        lit_start = i
        continue
      }
      i = i + 2
    } else {
      i = i + 1
    }
  }
  if lit_start < n {
    parts.push(InterpPart::{ is_expr: false, text: inner.slice(lit_start, n) })
  }
  parts
}
