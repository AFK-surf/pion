///| Mutation summary & Stage B precision tests (paired positive + negative adversaries).

test "mutation_summary: param Map[String, MbtJson] and Json::Object guard rebinding fail closed" {
  // Negative 1: cross-package param Map[String, MbtJson] may carry custom new_by comparator -> MUST fail-closed!
  let param_map_src = "pub fn choose(xs : Array[Int], m : mbt_compat::OrderedMap[String, mbt_compat::MbtJson], log : Array[String]) -> Bool {\n  let _ = log\n  xs.iter().any(fn(_x) { m.contains(\"k\") })\n}\n"
  let pm_ms = collect_pkg_mutation_summary_tokens([lex_moonbit(param_map_src)])
  match lookup_fn_mutation_summary(pm_ms, "choose") {
    Some(s) => assert_true(s.unknown, "param Map[String, MbtJson] m.contains must fail-closed")
    None => assert_true(false, "expected choose summary")
  }

  // Negative 2: Json::Object(m) guard rebinding `if k is Json::Array(m) => { m.clear() }` MUST fail-closed!
  let rebind_src = "pub fn run_clear(xs : Array[mbt_compat::MbtJson], k : mbt_compat::MbtJson) -> Option[Int] {\n  xs.search_by(fn(j) {\n    match j {\n      mbt_compat::MbtJson::Object(m) if k is mbt_compat::MbtJson::Array(m) => {\n        m.clear()\n        true\n      }\n      _ => false\n    }\n  })\n}\n"
  let rb_toks = lex_moonbit(rebind_src)
  let rb_ms = collect_pkg_mutation_summary_tokens([rb_toks])
  let mut sb_line = 0
  let mut sb_col = 0
  for tk in rb_toks {
    if tk.raw == "search_by" { sb_line = tk.line; sb_col = tk.col }
  }
  let rb_ok = stage_b_check_hof_ro_with_summary(rb_toks, rb_ms, "rb.pion", rebind_src, None, "mbt_compat::MbtJson", sb_line, sb_col, "search_by", "mbt_compat::arr_search_by", true, [])
  assert_true(!rb_ok, "Json::Object(m) if k is Json::Array(m) => m.clear() MUST fail-closed in search_by")

  // Negative 3: Json::Object(m) guard rebinding with index write `m[0] = j` MUST fail-closed!
  let idx_src = "pub fn run_idx(xs : Array[mbt_compat::MbtJson], k : mbt_compat::MbtJson) -> Option[Int] {\n  xs.search_by(fn(j) {\n    match j {\n      mbt_compat::MbtJson::Object(m) if k is mbt_compat::MbtJson::Array(m) => {\n        m[0] = j\n        true\n      }\n      _ => false\n    }\n  })\n}\n"
  let idx_toks = lex_moonbit(idx_src)
  let idx_ms = collect_pkg_mutation_summary_tokens([idx_toks])
  let mut ix_line = 0
  let mut ix_col = 0
  for tk in idx_toks {
    if tk.raw == "search_by" { ix_line = tk.line; ix_col = tk.col }
  }
  let idx_ok = stage_b_check_hof_ro_with_summary(idx_toks, idx_ms, "ix.pion", idx_src, None, "mbt_compat::MbtJson", ix_line, ix_col, "search_by", "mbt_compat::arr_search_by", true, [])
  assert_true(!idx_ok, "Json::Object(m) if k is Json::Array(m) => m[0] = j MUST fail-closed in search_by")
}

test "mutation_summary: multi-op shift+add before == never bypasses custom Eq" {
  let src = "struct Evil { xs : Array[Int] }\n\nimpl Eq for Evil with equal(self, other) {\n  self.xs.push(1)\n  true\n}\n\nfn make_evil() -> Evil {\n  Evil::{ xs: [] }\n}\n\nfn check_shift_add_eq(e : Evil) -> Bool {\n  e << 1 + 2 == make_evil()\n}\n"
  let ms = collect_pkg_mutation_summary_tokens([lex_moonbit(src)])
  match lookup_fn_mutation_summary(ms, "check_shift_add_eq") {
    Some(s) => assert_true(s.unknown || s.mutates_any_array || s.mutated_elem_types.length() > 0, "e << 1 + 2 == make_evil() MUST NOT be treated as pure scalar Eq")
    None => assert_true(false, "expected check_shift_add_eq summary")
  }
}

test "mutation_summary: multiline match arm if-guard never pollutes callables or outer_sh" {
  let src = "fn check_guard(opt : Option[Int], xs : Array[Int]) -> Bool {\n  let m : mbt_compat::OrderedMap[Int, Int] = mbt_compat::ordered_map_new()\n  let ok = match opt {\n    Some(v)\n      if m.contains(v) && physical_equal(xs, xs) => true\n    _ => false\n  }\n  ok && xs.iter().any(fn(x) { m.contains(x) })\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  match lookup_fn_mutation_summary(ms, "check_guard") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "multiline match if-guard must not mark m or physical_equal as shadowed/callable")
    None => assert_true(false, "expected check_guard summary")
  }
}

test "mutation_summary: scalar RHS reassignment fallback respects statement boundary (pipe negative)" {
  let src = "fn make_array(x : Int) -> Array[Int] {\n  [x]\n}\n\nfn reassign_scalar_ok(flag : Bool) -> Unit {\n  let mut n = if flag { 0 } else { 1 }\n  n = 42\n  let _ = n\n}\n\nfn reassign_pipe(flag : Bool) -> Unit {\n  let mut xs = if flag { make_array(0) } else { make_array(1) }\n  xs = 1 |> make_array\n  let _ = xs\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  match lookup_fn_mutation_summary(ms, "reassign_scalar_ok") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "n = 42 at statement end must remain pure")
    None => assert_true(false, "expected reassign_scalar_ok summary")
  }
  match lookup_fn_mutation_summary(ms, "reassign_pipe") {
    Some(s) => assert_true(s.unknown || s.mutates_any_array, "xs = 1 |> make_array MUST NOT be treated as scalar reassignment")
    None => assert_true(false, "expected reassign_pipe summary")
  }
}

test "stage_b: Gate B/C generic param aliasing, shadowed Some Eq, and sort_by_key Counter fail closed" {
  // Positive: pure filter_map callback passes Gate B
  let pos_src = "fn check_fm(xs : Array[Int]) -> Array[Int] {\n  xs.filter_map(fn(x) { if x > 0 { Some(x + 1) } else { None } })\n}\n"
  let toks = lex_moonbit(pos_src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  let mut fm_line = 0
  let mut fm_col = 0
  for tk in toks {
    if tk.raw == "filter_map" { fm_line = tk.line; fm_col = tk.col }
  }
  let ok = stage_b_check_hof_ro_with_summary(toks, ms, "fm.pion", pos_src, None, "Int", fm_line, fm_col, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(ok, "pure filter_map callback must pass Gate B HOF check")

  // Negative 1: opaque callback on param array MUST fail-closed
  let neg_src = "fn run_param(ats : Array[Int], f : (Int) -> Option[Int]) -> Array[Int] {\n  ats.filter_map(fn(at) { f(at) })\n}\n"
  let ntoks = lex_moonbit(neg_src)
  let mut nline = 0
  let mut ncol = 0
  for tk in ntoks {
    if tk.raw == "filter_map" { nline = tk.line; ncol = tk.col }
  }
  let bad_ok = stage_b_check_hof_ro_with_summary(ntoks, collect_pkg_mutation_summary_tokens([ntoks]), "fm_neg.pion", neg_src, None, "Int", nline, ncol, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(!bad_ok, "aliased param array with opaque callback MUST fail-closed in filter_map")

  // Negative 2: generic `fn[T] walk(xs : Array[T], ys : Array[Int])` mutating `ys` MUST fail-closed in Gate B & Gate C!
  let gen_src = "fn[T] walk(xs : Array[T], ys : Array[Int]) -> Int {\n  xs.filter_map(fn(x) {\n    if ys.length() == 2 { ys.push(9) }\n    Some(x)\n  }).length()\n}\n"
  let gtoks = lex_moonbit(gen_src)
  let gms = collect_pkg_mutation_summary_tokens([gtoks])
  let mut gline = 0
  let mut gcol = 0
  for tk in gtoks {
    if tk.raw == "filter_map" { gline = tk.line; gcol = tk.col }
  }
  let gen_ok = stage_b_check_hof_ro_with_summary(gtoks, gms, "gen.pion", gen_src, None, "T", gline, gcol, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(!gen_ok, "generic Array[T] filter_map mutating Array[Int] MUST fail-closed (T may instantiate to Int)")

  // Negative 3: local `Flag::Some(Int)` shadowing `Some` + custom Eq pushing to receiver array MUST fail-closed!
  let sh_src = "enum Flag { Some(Int) }\nstruct Evil { xs : Array[Int] }\nimpl Eq for Evil with equal(self, _other) {\n  self.xs.push(9)\n  true\n}\nfn run_sh(xs : Array[Int]) -> Array[Int] {\n  let e = Evil::{ xs }\n  xs.filter_map(fn(x) {\n    let _ = e == e\n    Option::Some(x)\n  })\n}\n"
  let shtoks = lex_moonbit(sh_src)
  let shms = collect_pkg_mutation_summary_tokens([shtoks])
  let mut shline = 0
  let mut shcol = 0
  for tk in shtoks {
    if tk.raw == "filter_map" { shline = tk.line; shcol = tk.col }
  }
  let sh_ok = stage_b_check_hof_ro_with_summary(shtoks, shms, "sh.pion", sh_src, None, "Int", shline, shcol, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(!sh_ok, "filter_map callback with custom Eq pushing to receiver array MUST fail-closed")

  // Negative 4: sort_by_key mutating a non-array Counter field MUST be rejected
  let sk_src = "struct Counter { mut n : Int }\n\nfn run_sk(xs : Array[Int], c : Counter) -> Unit {\n  xs.sort_by_key(fn(x) {\n    c.n = c.n + 1\n    x\n  })\n}\n"
  let sk_toks = lex_moonbit(sk_src)
  let mut sk_line = 0
  let mut sk_col = 0
  for tk in sk_toks {
    if tk.raw == "sort_by_key" { sk_line = tk.line; sk_col = tk.col }
  }
  let sk_diags : Array[Diag] = []
  let sk_env = sort_key_env_of([sk_toks])
  let sk_ok = stage_b_check_sort_key_closure_cached(sk_toks, sk_env, "sk_neg.pion", sk_line, sk_col, sk_diags)
  assert_true(!sk_ok && sk_diags.length() > 0, "sort_by_key callback mutating Counter.n MUST be rejected")
}

test "stage_b: E_UNKNOWN_PACKAGE exits Stage B immediately on round 1" {
  let src = "import missing_pkg\nfn f(xs : Array[Int]) -> Int {\n  xs.length()\n}\n"
  let files : Array[GeneratedFile] = [
    GeneratedFile::{ rel_path: "u.pion", content: src, source_file: "u.mbt", anchors: [] },
  ]
  let calls = [0]
  let mock_check = fn(_batch : Array[(String, String)]) -> String {
    calls[0] = calls[0] + 1
    "{\"ok\":false,\"diagnostics\":[{\"code\":\"E_UNKNOWN_PACKAGE\",\"severity\":\"error\",\"file\":\"u.pion\",\"line\":1,\"col\":1,\"message\":\"unknown imported package `missing_pkg`\"}]}"
  }
  let (_, iters, _) = run_stage_b_with_ops_and_deps(files, ApiMap::{ symbols: [], pkg_aliases: Map() }, Map(), Map(), mock_check, [], [])
  assert_eq(iters, 1)
  assert_eq(calls[0], 1)
}
