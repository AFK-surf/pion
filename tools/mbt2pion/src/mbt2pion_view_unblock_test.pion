///| Mutation summary & Stage B precision tests (paired positive + negative adversaries).

test "mutation_summary: MbtJson::Object pure-map provenance positive & cross-arm/new_by negatives" {
  let pos_src = "struct Ev { out : Bool\n  msg : mbt_compat::MbtJson }\n\nfn id_of(m : mbt_compat::OrderedMap[String, mbt_compat::MbtJson]) -> Option[Int] {\n  match m.get(\"id\") {\n    Some(mbt_compat::MbtJson::Number(d, _)) => Some(d.to_int())\n    _ => None\n  }\n}\n\nfn answers(evs : Array[Ev], id : Int) -> Bool {\n  evs.iter().any(fn(e) {\n    !e.out && e.msg is mbt_compat::MbtJson::Object(m) && (m.contains(\"ok\") || m.contains(\"error\")) && id_of(m) == Some(id)\n  })\n}\n"
  let toks = lex_moonbit(pos_src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  match lookup_fn_mutation_summary(ms, "id_of") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "id_of on MbtJson::Object map must be pure when package never uses new_by")
    None => assert_true(false, "expected id_of summary")
  }
  match lookup_fn_mutation_summary(ms, "answers") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "answers with is MbtJson::Object(m) + id_of(m) must be pure")
    None => assert_true(false, "expected answers summary")
  }

  // Negative 1: when the package uses `OrderedMap::new_by`, MbtJson::Object map param must fail-closed!
  let neg_src = "fn make_bad() -> mbt_compat::OrderedMap[String, mbt_compat::MbtJson] {\n  OrderedMap::new_by(fn(k) { 0 }, fn(a, b) { a == b })\n}\n\nfn id_of(m : mbt_compat::OrderedMap[String, mbt_compat::MbtJson]) -> Option[Int] {\n  match m.get(\"id\") {\n    Some(mbt_compat::MbtJson::Number(d, _)) => Some(d.to_int())\n    _ => None\n  }\n}\n"
  let neg_ms = collect_pkg_mutation_summary_tokens([lex_moonbit(neg_src)])
  match lookup_fn_mutation_summary(neg_ms, "id_of") {
    Some(s) => assert_true(s.unknown, "id_of MUST fail-closed when package contains OrderedMap::new_by")
    None => assert_true(false, "expected neg id_of summary")
  }

  // Negative 2: cross-arm pattern binding with same ident `m` must NEVER inherit MbtJson::Object type from prior arm!
  let cross_arm_src = "enum Wrap { J(mbt_compat::MbtJson)\n  Other(mbt_compat::OrderedMap[Int, Int]) }\n\nfn check_cross(w : Wrap, k : Int) -> Bool {\n  match w {\n    J(mbt_compat::MbtJson::Object(m)) => m.contains(\"ok\")\n    Other(m) => m.contains(k)\n  }\n}\n"
  let cross_ms = collect_pkg_mutation_summary_tokens([lex_moonbit(cross_arm_src)])
  match lookup_fn_mutation_summary(cross_ms, "check_cross") {
    Some(s) => assert_true(s.unknown, "Other(m) arm MUST NOT inherit MbtJson::Object(m) type from prior match arm")
    None => assert_true(false, "expected check_cross summary")
  }

  // Negative 3 (Scenario A): `let _ = j is MbtJson::Object(m)` followed by `let m = evil_map` must NOT inherit pure-map type!
  let shadow_is_src = "fn check_shadow_is(j : mbt_compat::MbtJson, evil_map : mbt_compat::OrderedMap[String, Int]) -> Bool {\n  let _ = j is mbt_compat::MbtJson::Object(m)\n  let m = evil_map\n  m.contains(\"k\")\n}\n"
  let shadow_is_ms = collect_pkg_mutation_summary_tokens([lex_moonbit(shadow_is_src)])
  match lookup_fn_mutation_summary(shadow_is_ms, "check_shadow_is") {
    Some(s) => assert_true(s.unknown, "let m = evil_map after is MbtJson::Object(m) MUST fail-closed")
    None => assert_true(false, "expected check_shadow_is summary")
  }

  // Negative 4 (Scenario B): `match j { MbtJson::Object(m) => { let m = evil_map; m.contains(\"k\") } }` must NOT inherit pure-map type!
  let shadow_arm_src = "fn check_shadow_arm(j : mbt_compat::MbtJson, evil_map : mbt_compat::OrderedMap[String, Int]) -> Bool {\n  match j {\n    mbt_compat::MbtJson::Object(m) => {\n      let m = evil_map\n      m.contains(\"k\")\n    }\n    _ => false\n  }\n}\n"
  let shadow_arm_ms = collect_pkg_mutation_summary_tokens([lex_moonbit(shadow_arm_src)])
  match lookup_fn_mutation_summary(shadow_arm_ms, "check_shadow_arm") {
    Some(s) => assert_true(s.unknown, "let m = evil_map inside match arm block MUST fail-closed")
    None => assert_true(false, "expected check_shadow_arm summary")
  }
}

test "mutation_summary: multi-op shift+add before == never bypasses custom Eq" {
  let src = "struct Evil { xs : Array[Int] }\n\nimpl Eq for Evil with equal(self, other) {\n  self.xs.push(1)\n  true\n}\n\nfn make_evil() -> Evil {\n  Evil::{ xs: [] }\n}\n\nfn check_shift_add_eq(e : Evil) -> Bool {\n  e << 1 + 2 == make_evil()\n}\n"
  let ms = collect_pkg_mutation_summary_tokens([lex_moonbit(src)])
  match lookup_fn_mutation_summary(ms, "check_shift_add_eq") {
    Some(s) => assert_true(s.unknown || s.mutates_any_array || s.mutated_elem_types.length() > 0, "e << 1 + 2 == make_evil() MUST NOT be treated as pure scalar Eq")
    None => assert_true(false, "expected check_shift_add_eq summary")
  }
}

test "mutation_summary: multiline match arm if-guard never pollutes callables or outer_sh" {
  let src = "fn check_guard(opt : Option[Int], xs : Array[Int]) -> Bool {\n  let m : mbt_compat::OrderedMap[Int, Int] = mbt_compat::ordered_map_new()\n  let ok = match opt {\n    Some(v)\n      if m.contains(v) && physical_equal(xs, xs) => true\n    _ => false\n  }\n  ok && xs.iter().any(fn(x) { m.contains(x) })\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  match lookup_fn_mutation_summary(ms, "check_guard") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "multiline match if-guard must not mark m or physical_equal as shadowed/callable")
    None => assert_true(false, "expected check_guard summary")
  }
}

test "mutation_summary: scalar RHS reassignment fallback respects statement boundary (pipe negative)" {
  let src = "fn make_array(x : Int) -> Array[Int] {\n  [x]\n}\n\nfn reassign_scalar_ok(flag : Bool) -> Unit {\n  let mut n = if flag { 0 } else { 1 }\n  n = 42\n  let _ = n\n}\n\nfn reassign_pipe(flag : Bool) -> Unit {\n  let mut xs = if flag { make_array(0) } else { make_array(1) }\n  xs = 1 |> make_array\n  let _ = xs\n}\n"
  let toks = lex_moonbit(src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  match lookup_fn_mutation_summary(ms, "reassign_scalar_ok") {
    Some(s) => assert_true(!s.unknown && !s.mutates_any_array, "n = 42 at statement end must remain pure")
    None => assert_true(false, "expected reassign_scalar_ok summary")
  }
  match lookup_fn_mutation_summary(ms, "reassign_pipe") {
    Some(s) => assert_true(s.unknown || s.mutates_any_array, "xs = 1 |> make_array MUST NOT be treated as scalar reassignment")
    None => assert_true(false, "expected reassign_pipe summary")
  }
}

test "stage_b: HOF filter_map fallback positive & negative; sort_by_key mutating counter rejected" {
  let pos_src = "fn check_fm(xs : Array[Int]) -> Array[Int] {\n  xs.filter_map(fn(x) { if x > 0 { Some(x + 1) } else { None } })\n}\n"
  let toks = lex_moonbit(pos_src)
  let ms = collect_pkg_mutation_summary_tokens([toks])
  let mut fm_line = 0
  let mut fm_col = 0
  for tk in toks {
    if tk.raw == "filter_map" { fm_line = tk.line; fm_col = tk.col }
  }
  let ok = stage_b_check_hof_ro_with_summary(toks, ms, "fm.pion", pos_src, None, "Int", fm_line, fm_col, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(ok, "pure filter_map callback must pass Gate B HOF check")

  // Negative: opaque callback on param array MUST fail-closed
  let neg_src = "fn run_param(ats : Array[Int], f : (Int) -> Option[Int]) -> Array[Int] {\n  ats.filter_map(fn(at) { f(at) })\n}\n"
  let ntoks = lex_moonbit(neg_src)
  let mut nline = 0
  let mut ncol = 0
  for tk in ntoks {
    if tk.raw == "filter_map" { nline = tk.line; ncol = tk.col }
  }
  let bad_ok = stage_b_check_hof_ro_with_summary(ntoks, collect_pkg_mutation_summary_tokens([ntoks]), "fm_neg.pion", neg_src, None, "Int", nline, ncol, "filter_map", "mbt_compat::arr_filter_map", true, [])
  assert_true(!bad_ok, "aliased param array with opaque callback MUST fail-closed in filter_map")

  // Negative: sort_by_key mutating a non-array Counter field MUST be rejected (no mutation_summary fallback)
  let sk_src = "struct Counter { mut n : Int }\n\nfn run_sk(xs : Array[Int], c : Counter) -> Unit {\n  xs.sort_by_key(fn(x) {\n    c.n = c.n + 1\n    x\n  })\n}\n"
  let sk_toks = lex_moonbit(sk_src)
  let mut sk_line = 0
  let mut sk_col = 0
  for tk in sk_toks {
    if tk.raw == "sort_by_key" { sk_line = tk.line; sk_col = tk.col }
  }
  let sk_diags : Array[Diag] = []
  let sk_env = sort_key_env_of([sk_toks])
  let sk_ok = stage_b_check_sort_key_closure_cached(sk_toks, sk_env, "sk_neg.pion", sk_line, sk_col, sk_diags)
  assert_true(!sk_ok && sk_diags.length() > 0, "sort_by_key callback mutating Counter.n MUST be rejected")
}

test "stage_b: E_UNKNOWN_PACKAGE exits Stage B immediately on round 1" {
  let src = "import missing_pkg\nfn f(xs : Array[Int]) -> Int {\n  xs.length()\n}\n"
  let files : Array[GeneratedFile] = [
    GeneratedFile::{ rel_path: "u.pion", content: src, source_file: "u.mbt", anchors: [] },
  ]
  let calls = [0]
  let mock_check = fn(_batch : Array[(String, String)]) -> String {
    calls[0] = calls[0] + 1
    "{\"ok\":false,\"diagnostics\":[{\"code\":\"E_UNKNOWN_PACKAGE\",\"severity\":\"error\",\"file\":\"u.pion\",\"line\":1,\"col\":1,\"message\":\"unknown imported package `missing_pkg`\"}]}"
  }
  let (_, iters, _) = run_stage_b_with_ops_and_deps(files, ApiMap::{ symbols: [], pkg_aliases: Map() }, Map(), Map(), mock_check, [], [])
  assert_eq(iters, 1)
  assert_eq(calls[0], 1)
}
