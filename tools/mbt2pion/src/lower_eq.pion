///| Wave M2-F3d Track F3d-1b:
///| 1. Native Pion `#derive(Eq)` eligibility for non-primitive structs, tuple structs, enums,
///|    and generics:
///|    - Non-comparable fields (closures, `StringBuilder`, `Map`, `OrderedMap`, `mbt_compat::Ref`,
///|      `dyn Trait`) emit native `#derive(Eq)` so Pion's `FINAL_CHECK` rejects them fail-closed.
///|    - Types whose direct fields/payloads contain `Bytes` (including inside `Option`/`Array`/
///|      `FixedArray`/`ImmArray`/`Result`/tuples, and including generic types) emit native Pion
///|      `[pub] impl Eq` / `[pub] impl[T : Eq, ...] Eq` with inline byte comparison, eliminating
///|      declaration-order sensitivity and legacy `__mbt_eq_*` helpers.
///|    - All other types (including `MbtJson`, `OrderedSet`, nested structs/enums in any order)
///|      emit native Pion `#derive(Eq)` directly.
///| 2. MoonBit `[pub] impl Eq` / `[pub] impl[T, ...] Eq` lowering to Pion built-in `impl Eq`,
///|    with anti-hijacking (`!ctx.symtab.local_types.contains("Eq")`), omitted parameter/return type
///|    auto-fill, `Self` normalization, `impl_param_scope` binding, and fail-closed rejection of
///|    `with not_equal` or any non-`equal` method.

///| Return true if lowered type string `ty` has a top-level function arrow `->`.
fn eq_is_fn_type(ty : String) -> Bool {
  let s = ty.trim()
  let len = s.length()
  let mut depth = 0
  let mut i = 0
  while i < len {
    let c = s.code_unit_at(i)
    if c == 40 || c == 91 || c == 123 {
      depth = depth + 1
    } else if c == 41 || c == 93 || c == 125 {
      if depth > 0 {
        depth = depth - 1
      }
    } else if depth == 0 && c == 45 && i + 1 < len && s.code_unit_at(i + 1) == 62 {
      return true
    }
    i = i + 1
  }
  false
}

///| Split top-level comma-separated generic type arguments inside `[...]`.
fn eq_split_type_args(inner : String) -> Array[String] {
  split_tuple_types(inner)
}

///| Return true if `ty` statically contains a type that Pion native `#derive(Eq)` cannot compare
///| (closures, `StringBuilder`, `Map`, `OrderedMap`, `mbt_compat::Ref`, `dyn Trait`).
///| Such types emit native `#derive(Eq)` so Pion's `FINAL_CHECK` rejects them fail-closed.
fn eq_type_has_non_comparable(ty : String) -> Bool {
  let t = ty.trim()
  if t.length() == 0 {
    return false
  }
  if eq_is_fn_type(t) {
    return true
  }
  if t == "StringBuilder" || t.starts_with("dyn ") ||
  t.starts_with("Map[") || t.starts_with("OrderedMap[") ||
  t.starts_with("mbt_compat::OrderedMap[") || t.starts_with("mbt_compat::Ref[") {
    return true
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    return eq_type_has_non_comparable(t.slice(7, t.length() - 1))
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    return eq_type_has_non_comparable(t.slice(6, t.length() - 1))
  }
  if t.starts_with("FixedArray[") && t.ends_with("]") {
    return eq_type_has_non_comparable(t.slice(11, t.length() - 1))
  }
  if t.starts_with("ImmArray[") && t.ends_with("]") {
    return eq_type_has_non_comparable(t.slice(9, t.length() - 1))
  }
  if t.starts_with("Result[") && t.ends_with("]") {
    let args = eq_split_type_args(t.slice(7, t.length() - 1))
    for a in args {
      if eq_type_has_non_comparable(a) {
        return true
      }
    }
    return false
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      for el in elems {
        if eq_type_has_non_comparable(el) {
          return true
        }
      }
      return false
    }
    if elems.length() == 1 {
      return eq_type_has_non_comparable(elems[0])
    }
  }
  false
}

///| Return true if `ty` directly contains `Bytes` (or `Bytes` wrapped inside `Option`, `Array`,
///| `FixedArray`, `ImmArray`, `Result`, or tuples). Does NOT treat `MbtJson`, `OrderedSet`,
///| or other nominal structs/enums as compat fallback since they have native Pion `Eq`.
fn eq_type_has_direct_bytes(ty : String) -> Bool {
  let t = ty.trim()
  if t.length() == 0 || eq_is_fn_type(t) {
    return false
  }
  if t == "Bytes" {
    return true
  }
  if t.starts_with("Option[") && t.ends_with("]") {
    return eq_type_has_direct_bytes(t.slice(7, t.length() - 1))
  }
  if t.starts_with("Array[") && t.ends_with("]") {
    return eq_type_has_direct_bytes(t.slice(6, t.length() - 1))
  }
  if t.starts_with("FixedArray[") && t.ends_with("]") {
    return eq_type_has_direct_bytes(t.slice(11, t.length() - 1))
  }
  if t.starts_with("ImmArray[") && t.ends_with("]") {
    return eq_type_has_direct_bytes(t.slice(9, t.length() - 1))
  }
  if t.starts_with("Result[") && t.ends_with("]") {
    let args = eq_split_type_args(t.slice(7, t.length() - 1))
    for a in args {
      if eq_type_has_direct_bytes(a) {
        return true
      }
    }
    return false
  }
  if t.starts_with("(") && t.ends_with(")") {
    let elems = split_tuple_types(t.slice(1, t.length() - 1))
    if elems.length() >= 2 {
      for el in elems {
        if eq_type_has_direct_bytes(el) {
          return true
        }
      }
      return false
    }
    if elems.length() == 1 {
      return eq_type_has_direct_bytes(elems[0])
    }
  }
  false
}

///| Whether a `#derive(Eq)` struct / tuple struct should emit native Pion `#derive(Eq)` (`true`)
///| or synthesize a native Pion `[pub] impl[T : Eq, ...] Eq` (`false`, only when a direct field
///| contains `Bytes` and no field is non-comparable).
fn should_use_native_derive_eq_struct(field_types : Array[(String, String)]) -> Bool {
  let mut has_bytes = false
  for ft in field_types {
    if eq_type_has_non_comparable(ft.1) {
      return true
    }
    if eq_type_has_direct_bytes(ft.1) {
      has_bytes = true
    }
  }
  !has_bytes
}

///| Whether a `#derive(Eq)` enum should emit native Pion `#derive(Eq)` (`true`)
///| or synthesize a native Pion `[pub] impl[T : Eq, ...] Eq` (`false`, only when a direct payload
///| contains `Bytes` and no payload is non-comparable).
fn should_use_native_derive_eq_enum(variants : Array[(String, Array[String])]) -> Bool {
  let mut has_bytes = false
  for ev in variants {
    for aty in ev.1 {
      if eq_type_has_non_comparable(aty) {
        return true
      }
      if eq_type_has_direct_bytes(aty) {
        has_bytes = true
      }
    }
  }
  !has_bytes
}

///| Synthesize a native Pion `[pub] impl[T : Eq, ...] Eq for Type[T, ...]` block for a `#derive(Eq)`
///| struct, tuple struct, or enum whose direct fields/payloads contain `Bytes`.
fn gen_bytes_derive_eq_impl(
  type_vis : String,
  tname : String,
  generic_names : Array[String],
  is_struct : Bool,
  field_types : Array[(String, String)],
  enum_variants : Array[(String, Array[String])],
) -> String {
  let empty_custom : Map[String, String] = Map()
  let eq_body = if is_struct {
    gen_struct_eq_body("self", "other", field_types, empty_custom)
  } else {
    gen_enum_eq_body("self", "other", enum_variants, empty_custom)
  }
  let (gen_hdr, target_ty) = if generic_names.length() > 0 {
    let bounded : Array[String] = []
    for gn in generic_names {
      bounded.push(gn + " : Eq")
    }
    ("[" + join_comma(bounded) + "]", tname + "[" + join_comma(generic_names) + "]")
  } else {
    ("", tname)
  }
  "\n" + type_vis + "impl" + gen_hdr + " Eq for " + target_ty + " {\n  fn equal(self : " + target_ty + ", other : " + target_ty + ") -> Bool {\n    " + eq_body + "\n  }\n}\n"
}

///| Lower MoonBit built-in `[pub] impl Eq` or `[pub] impl[T, ...] Eq` to Pion built-in `impl Eq`.
///| Returns `(handled, next_token_index)`. When `handled == false`, the caller continues with
///| normal user-trait `impl` handling (or generic non-`Eq` `impl[...]` fail-closed rejection).
fn try_lower_builtin_eq_impl(
  ctx : StageAContext,
  sf : SourceFile,
  tokens : Array[Token],
  n : Int,
  decl_start : Int,
  impl_i : Int,
  vis : String,
  attrs_trivia : String,
  kept_attrs : String,
  vis_trivia : String,
  decl_line : Int,
  decl_col : Int,
  decl_err_before : Int,
  out_sb : StringBuilder,
  anchors : Array[DeclAnchor],
) -> (Bool, Int) {
  // Anti-hijacking: if the current package declares its own `trait Eq`, do NOT treat as built-in `Eq`.
  if ctx.symtab.local_types.contains("Eq") {
    return (false, impl_i)
  }
  let mut has_generics = false
  let mut gb_open = -1
  let mut gb_close = -1
  let mut trait_start = impl_i + 1
  if trait_start < n && tokens[trait_start].kind == TokenKind::LBracket {
    has_generics = true
    gb_open = trait_start
    gb_close = find_matching_delim(tokens, gb_open)
    if gb_close <= gb_open || gb_close >= n {
      return (false, impl_i)
    }
    trait_start = gb_close + 1
  }
  let mut for_i = -1
  let mut with_i = -1
  let mut lb = trait_start
  while lb < n && tokens[lb].kind != TokenKind::LBrace &&
  !(tokens[lb].newline_before && is_top_level_decl_start(tokens, lb)) {
    if tokens[lb].kind == TokenKind::Keyword && tokens[lb].raw == "for" && for_i < 0 {
      for_i = lb
    } else if tokens[lb].kind == TokenKind::Keyword && tokens[lb].raw == "with" && with_i < 0 {
      with_i = lb
    }
    lb = lb + 1
  }
  if for_i <= trait_start || with_i <= for_i || lb >= n || tokens[lb].kind != TokenKind::LBrace {
    return (false, impl_i)
  }
  let raw_trait = lower_type_tokens(tokens, trait_start, for_i, ctx.symtab, ctx.recipes).trim()
  if raw_trait != "Eq" {
    return (false, impl_i)
  }

  let rb = find_matching_delim(tokens, lb)
  let added_generics = if has_generics {
    push_active_generics(ctx, collect_generic_param_names(tokens, gb_open, gb_close))
  } else {
    []
  }
  let gen_header = if has_generics {
    lower_generic_bounds_brackets(ctx, tokens, gb_open, gb_close, sf.rel_path)
  } else {
    ""
  }
  let self_ty = lower_type_tokens_checked(ctx, tokens, for_i + 1, with_i, sf.rel_path).trim()
  let raw_mname = if with_i + 1 < lb { tokens[with_i + 1].raw } else { "" }
  let mname = rename_keyword_ident(raw_mname)

  // Fail-closed red line: built-in `impl Eq` only supports `with equal`.
  // `with not_equal` or any other method MUST be rejected with MBT2PION_UNSUPPORTED_SYNTAX.
  if mname != "equal" {
    ctx.diags.push(diag_error(
      "MBT2PION_UNSUPPORTED_SYNTAX",
      sf.rel_path,
      decl_line,
      decl_col,
      "built-in `impl Eq` only supports `with equal`; `with " + raw_mname + "` cannot be lowered without altering equality semantics",
    ))
    ctx.dispositions.push(DispositionEntry::{
      file: sf.rel_path,
      decl: "impl:Eq:" + self_ty + "::" + mname,
      line: decl_line,
      col: decl_col,
      disposition: "unsupported",
      detail: "built-in impl Eq only supports equal (not_equal/other methods fail closed)",
    })
    pop_active_generics(ctx, added_generics)
    return (true, rb + 1)
  }

  let mut open_p = with_i + 2
  while open_p < lb && tokens[open_p].kind != TokenKind::LParen {
    open_p = open_p + 1
  }
  let close_p = if open_p < lb { find_matching_delim(tokens, open_p) } else { open_p }
  let impl_param_scope : Array[(String, String)] = []
  let typed_params = if open_p < lb {
    let tp_sb = StringBuilder()
    let mut pi = open_p + 1
    let mut pidx = 0
    while pi < close_p {
      if tokens[pi].kind == TokenKind::Comma {
        pi = pi + 1
        continue
      }
      let mut pe = pi
      let mut pd = 0
      while pe < close_p {
        let pk = tokens[pe].kind
        if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace {
          pd = pd + 1
        } else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace {
          pd = pd - 1
        } else if pd == 0 && pk == TokenKind::Comma {
          break
        }
        pe = pe + 1
      }
      if pe > pi {
        if pidx > 0 {
          tp_sb.write_string(", ")
        }
        let mut col_i = -1
        let mut ck = pi
        let mut cd = 0
        while ck < pe {
          let ckk = tokens[ck].kind
          if ckk == TokenKind::LParen || ckk == TokenKind::LBracket || ckk == TokenKind::LBrace {
            cd = cd + 1
          } else if ckk == TokenKind::RParen || ckk == TokenKind::RBracket || ckk == TokenKind::RBrace {
            cd = cd - 1
          } else if cd == 0 && ckk == TokenKind::Colon {
            col_i = ck
            break
          }
          ck = ck + 1
        }
        let raw_pn = if tokens[pi].raw == "_" { "_" } else { rename_keyword_ident(tokens[pi].raw) }
        if col_i >= 0 && col_i + 1 < pe {
          let raw_pty = lower_type_tokens_checked(ctx, tokens, col_i + 1, pe, sf.rel_path).trim()
          let pty = if raw_pty == "Self" { self_ty } else { raw_pty }
          tp_sb.write_string(raw_pn + " : " + pty)
          impl_param_scope.push((raw_pn, pty))
        } else if pidx == 0 || pidx == 1 {
          tp_sb.write_string(raw_pn + " : " + self_ty)
          impl_param_scope.push((raw_pn, self_ty))
        } else {
          tp_sb.write_string(raw_pn)
          impl_param_scope.push((raw_pn, ""))
        }
        pidx = pidx + 1
      }
      pi = pe + 1
    }
    tp_sb.to_string()
  } else {
    ""
  }

  let ret_str = if close_p + 1 < lb && tokens[close_p + 1].kind == TokenKind::Arrow {
    let raw_ret = lower_type_tokens_checked(ctx, tokens, close_p + 2, lb, sf.rel_path).trim()
    " -> " + (if raw_ret == "Self" { self_ty } else { raw_ret })
  } else {
    if close_p + 1 < lb {
      check_unsupported_error_tokens(ctx, tokens, close_p + 1, lb, sf.rel_path)
    }
    " -> Bool"
  }

  let saved_impl_sc = ctx.scope_vars.length()
  for ip in impl_param_scope {
    if ip.0.length() > 0 && ip.0 != "_" {
      ctx.scope_vars.push(ScopeVar::{ name: ip.0, ty: ip.1, is_mut: false, is_boxed: false })
    }
  }
  let body = lower_block_range(ctx, tokens, lb, rb, sf.rel_path, "")
  restore_scope_vars(ctx, saved_impl_sc)
  pop_active_generics(ctx, added_generics)

  let impl_vis = if vis.length() > 0 { vis } else { "" }
  let decl_code = impl_vis + "impl" + gen_header + " Eq for " + self_ty + " {\n  fn equal(" + typed_params + ")" + ret_str + " " + body + "\n}"
  let src_slice = sf.content.slice(tokens[decl_start].start_byte, tokens[rb].end_byte)
  out_sb.write_string(attrs_trivia + kept_attrs + vis_trivia)
  let anchor_start = out_sb.to_string().length()
  out_sb.write_string(decl_code)
  let anchor_end = out_sb.to_string().length()
  anchors.push(DeclAnchor::{
    source_file: sf.rel_path,
    decl_identity: "impl:Eq:" + self_ty + "::equal",
    normalized_source_cst_hash: content_sha256(normalize_for_hash(src_slice)),
    pre_overlay_generated_hash: content_sha256(decl_code),
    start_byte: anchor_start,
    end_byte: anchor_end,
    line: decl_line,
    col: decl_col,
  })
  let had_err = count_error_diags(ctx.diags) > decl_err_before
  ctx.dispositions.push(DispositionEntry::{
    file: sf.rel_path,
    decl: "impl:Eq:" + self_ty + "::equal",
    line: decl_line,
    col: decl_col,
    disposition: if had_err { "unsupported" } else { "transpiled" },
    detail: if had_err { "impl Eq method contains unsupported syntax" } else { "built-in impl Eq lowered cleanly" },
  })
  (true, rb + 1)
}
