///| Wave M2-F2 unit tests:
///| 1. Optional `SourceLoc` parameter (`made_for? : SourceLoc` -> `Option[String]`, preserving `loc~ : SourceLoc` autofill)
///| 2. Value type ascription `(expr : ConcreteType)` while keeping `(x : &Show)` fail-closed
///| 3. `match` arm `if` guards (multiline continuation, `is` in guard, no expected-type leak)
///| 4. `Int::min` / `Int::max` / `Double::min` / `Double::max` (type-directed, no custom-type hijack)

test "F2-1: optional SourceLoc preserves Option[String] while autofill loc~ stays String" {
  let src = "#callsite(autofill(loc))\n" +
  "pub fn outer(made_for? : SourceLoc, loc~ : SourceLoc) -> String {\n" +
  "  made_for.unwrap_or(loc)\n" +
  "}\n\n" +
  "#callsite(autofill(loc))\n" +
  "pub fn with_def(loc~ : SourceLoc, made_for? : SourceLoc = loc) -> String {\n" +
  "  made_for\n" +
  "}\n\n" +
  "pub fn pos_opt(made_for : SourceLoc?, loc : SourceLoc) -> String {\n" +
  "  made_for.unwrap_or(loc)\n" +
  "}\n\n" +
  "pub fn legacy_loc(x : Int, loc~ : SourceLoc = _) -> String {\n" +
  "  x.to_string() + loc\n" +
  "}\n\n" +
  "pub fn caller(opt : SourceLoc?, s : SourceLoc) -> String {\n" +
  "  outer() + \"|\" + outer(made_for=s) + \"|\" + outer(made_for?=opt) + \"|\" + with_def() + \"|\" + pos_opt(opt, s) + \"|\" + legacy_loc(1)\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "loc_opt.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "optional SourceLoc should transpile with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "made_for? : String, loc~ : String = \"\""), "made_for? : SourceLoc lowers to made_for? : String")
  assert_true(str_has(out, "pub fn pos_opt(made_for : Option[String], loc : String)"), "positional SourceLoc? preserves Option[String]")
  assert_true(str_has(out, "pub fn legacy_loc(x : Int, loc~ : String = \"\")"), "loc~ : SourceLoc = _ lowers to loc~ : String = \"\"")
  assert_true(str_has(out, "made_for.unwrap_or(loc)"), "made_for.unwrap_or(loc) preserved")
  assert_true(str_has(out, "let made_for = match made_for { Some(__mbt_v) => __mbt_v, None => loc }"), "defaulted optional SourceLoc keeps lazy prelude")
  assert_true(str_has(out, "outer(loc=\"loc_opt.mbt:"), "autofill loc injected at callsite")
  assert_true(str_has(out, "made_for?=opt"), "optional forwarding preserved")
}

test "F2-2: value type ascription lowers literals and expressions while trait object fails closed" {
  let ok_src = "pub fn color_calc(hue : Float, x : Double) -> (Float, Double, Int64, Double, Float, Double, Double) {\n" +
  "  let a = (4.0 : Float) - hue\n" +
  "  let b = (x : Double) + (0 : Double)\n" +
  "  let c = (1 : Int64)\n" +
  "  let d = (0x10 : Double)\n" +
  "  let e = (0x10 : Float)\n" +
  "  let f = (0x8000000000000000 : Double)\n" +
  "  let g = (-0x0 : Double)\n" +
  "  (a, b, c, d, e, f, g)\n" +
  "}\n"
  let ok_res = transpile_package([SourceFile::{ rel_path: "asc_ok.mbt", content: ok_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(ok_res.blockers == 0, "value type ascriptions should have 0 blockers")
  let out = ok_res.files[0].content
  assert_true(str_has(out, "Float::from_double(4.0) - hue"), "(4.0 : Float) lowers cleanly")
  assert_true(str_has(out, "1L"), "(1 : Int64) lowers to 1L")
  assert_true(str_has(out, "(0x10UL).to_double()"), "(0x10 : Double) uses UInt64 literal")
  assert_true(str_has(out, "Float::from_double((0x10UL).to_double())"), "(0x10 : Float) uses UInt64 literal")
  assert_true(str_has(out, "(0x8000000000000000UL).to_double()"), "high-bit hex stays positive via UInt64")
  assert_true(str_has(out, "(-(0x0UL).to_double())"), "negative hex zero keeps -0.0 sign outside to_double")

  let bad_src = "pub fn bad(x : Int) -> Unit { let _ = (x : &Show) }\n"
  let bad_res = transpile_package([SourceFile::{ rel_path: "asc_bad.mbt", content: bad_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "trait object ascription must fail closed")
  let mut saw_unsup = false
  for d in bad_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_unsup = true }
  }
  assert_true(saw_unsup, "trait object ascription must emit MBT2PION_UNSUPPORTED_SYNTAX")

  let ovf_src = "pub fn ovf() -> (Double, Float) { ((0x10000000000000000 : Double), (0x10000000000000000 : Float)) }\n"
  let ovf_res = transpile_package([SourceFile::{ rel_path: "asc_ovf.mbt", content: ovf_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(ovf_res.blockers >= 2, ">64-bit hex float ascriptions must fail closed")
  let mut ovf_unsup = 0
  for d in ovf_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { ovf_unsup = ovf_unsup + 1 }
  }
  assert_true(ovf_unsup >= 2, ">64-bit hex float ascriptions must emit MBT2PION_UNSUPPORTED_SYNTAX")
}

test "F2-3: match arm if guards handle multiline continuations, is-patterns, and no expected-type leak" {
  let src = "fn lookup(k : Int) -> Int? { if k > 0 { Some(k * 10) } else { None } }\n" +
  "pub fn guarded(a : Int?, b : Int?) -> Float {\n" +
  "  match (a, b) {\n" +
  "    (Some(x), Some(y)) if x > 0\n" +
  "      && lookup(y) is Some(z)\n" +
  "      => Float::from_int(x + z)\n" +
  "    (Some(x), _) if {\n" +
  "      let s =\n" +
  "        #|one}\n" +
  "        #|two//\n" +
  "      let y = x + s.length()\n" +
  "      y > 5\n" +
  "    } => 3.0\n" +
  "    (Some(x), _) if x.to_double() > 1.5 => 2.0\n" +
  "    _ => 0.0\n" +
  "  }\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "guard.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "match arm if guard should transpile with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "if x > 0 && lookup(y) is Some(z) =>"), "multiline guard collapsed before =>")
  assert_true(str_has(out, "let y = x + s.length()\n      y > 5"), "block newlines after #|...} inside match guard are preserved")
  assert_true(str_has(out, "if x.to_double() > 1.5 =>"), "Float return expected type does not leak into Double guard")
}

test "F2-4: Int and Double min/max map to mbt_compat without hijacking custom types" {
  assert_true(lookup_missing_method_helper("Int", "min") == Some("mbt_compat::int_min"), "Int::min mapped")
  assert_true(lookup_missing_method_helper("Int", "max") == Some("mbt_compat::int_max"), "Int::max mapped")
  assert_true(lookup_missing_method_helper("Double", "min") == Some("mbt_compat::double_min"), "Double::min mapped")
  assert_true(lookup_missing_method_helper("Double", "max") == Some("mbt_compat::double_max"), "Double::max mapped")
  assert_true(lookup_missing_method_helper("RangeBox", "min") == None, "custom type .min not hijacked")
  assert_true(lookup_missing_method_helper("RangeBox", "max") == None, "custom type .max not hijacked")

  let src = "pub fn static_mm(a : Int, b : Int, x : Double, y : Double) -> (Int, Double) {\n" +
  "  (Int::min(a, Int::max(b, 0)), Double::max(x, Double::min(y, 1.0)))\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "mm.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "static Int/Double min/max should have 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::int_min(a, mbt_compat::int_max(b, 0))"), "static Int::min/max lowered")
  assert_true(str_has(out, "mbt_compat::double_max(x, mbt_compat::double_min(y, 1.0))"), "static Double::min/max lowered")

  let local_src = "fn Int::min(self : Int, y : Int) -> Int { self + y }\n" +
  "pub fn call_local() -> Int { Int::min(2, 3) }\n"
  let local_res = transpile_package([SourceFile::{ rel_path: "mm_local.mbt", content: local_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(local_res.blockers == 0, "local Int::min should transpile with 0 blockers")
  let local_out = local_res.files[0].content
  assert_true(str_has(local_out, "Int::min(2, 3)") && !str_has(local_out, "mbt_compat::int_min"), "local Int::min must not be hijacked")
}
