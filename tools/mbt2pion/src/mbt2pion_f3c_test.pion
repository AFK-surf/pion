///| Wave M2-F3c unit tests:
///| 1. `match` arm `for`/`while` bodies (with `,`/`;`), multiline `match` scrutinees,
///|    and tuple-destructuring `for (a, b) in xs` / `for i, (a, b) in xs` (fail-closed on refutable patterns)
///| 2. High-frequency core method helpers (`Array::search_by`, `shrink_to_fit`, `push_iter`, `rev`, `drain`,
///|    `Option::map_or`, `bind`, `Char::is_ascii_alphabetic`) without custom-type hijack
///| 3. Recursive nested & tuple-wrapped struct patterns in `match` arms and `is (None | Some({ ... }))`

test "F3c-1a: match arm for-in with comma, C-style for, and multiline match arm body" {
  let src = "pub fn arm_loops(opt : Int?, pairs : Map[Int, Int], xs : Array[Int]) -> Int {\n" +
  "  let mut acc = 0\n" +
  "  match opt {\n" +
  "    Some(limit) if limit > 0 =>\n" +
  "      for k, v in pairs {\n" +
  "        if k < limit {\n" +
  "          acc = acc + v\n" +
  "        }\n" +
  "      }\n" +
  "    Some(_) =>\n" +
  "      for i = 0; i < xs.length(); i = i + 1 {\n" +
  "        acc = acc + xs[i]\n" +
  "      }\n" +
  "    None =>\n" +
  "      match\n" +
  "        xs.get(0) {\n" +
  "        Some(v) => acc = acc + v\n" +
  "        None => ()\n" +
  "      }\n" +
  "  }\n" +
  "  acc\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "arm_loops.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "match arm loops should transpile with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "{ for k, v in pairs {"), "for k, v in inside match arm stays intact")
  assert_true(str_has(out, "{ for i = 0; i < xs.length(); i = i + 1 {"), "C-style for inside match arm stays intact")
  assert_true(!str_has(out, "{ for k },"), "comma in for k, v must never split match arm")
  assert_true(!str_has(out, "__mbt_sp_"), "multiline match body must never be misparsed as struct pattern")
}

test "F3c-1b: tuple destructuring for-in lowers cleanly and rejects refutable patterns fail-closed" {
  let ok_src = "pub fn sum_pairs(xs : Array[(Int, Int)], nested : Array[((Int, Int), Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (a, b) in xs {\n" +
  "    s = s + a + b\n" +
  "  }\n" +
  "  for i, (a, _) in xs {\n" +
  "    s = s + i * a\n" +
  "  }\n" +
  "  for ((x, y), z) in nested {\n" +
  "    s = s + x + y + z\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let ok_res = transpile_package([SourceFile::{ rel_path: "for_tup.mbt", content: ok_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(ok_res.blockers == 0, "irrefutable tuple for-in should have 0 blockers")
  let out = ok_res.files[0].content
  assert_true(str_has(out, "let (a, b) = __mbt_for_"), "for (a, b) in lowers to let (a, b) = tmp")
  assert_true(str_has(out, "let (a, _) = __mbt_for_"), "for i, (a, _) in lowers to let (a, _) = tmp")
  assert_true(str_has(out, "let (__mbt_ft_") && str_has(out, "let (x, y) = __mbt_ft_"), "nested tuple for-in flattens cleanly")

  let bad_src = "pub fn bad_for(xs : Array[(Int?, Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (Some(a), b) in xs {\n" +
  "    s = s + a + b\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let bad_res = transpile_package([SourceFile::{ rel_path: "for_bad.mbt", content: bad_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "refutable pattern in for-in must fail closed")
  let mut saw_unsup = false
  for d in bad_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_unsup = true }
  }
  assert_true(saw_unsup, "refutable for-in must emit MBT2PION_UNSUPPORTED_SYNTAX")

  // P1-1: keyword/shadowed tuple binders must match the renamed loop body (emitted before restore_ident_renames)
  let kw_src = "pub fn kw_tuple_for(xs : Array[(Int, Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (val, move) in xs {\n" +
  "    s = s + val + move\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let kw_res = transpile_package([SourceFile::{ rel_path: "for_kw.mbt", content: kw_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(kw_res.blockers == 0, "keyword tuple binders in for-in should have 0 blockers")
  let kw_out = kw_res.files[0].content
  assert_true(str_has(kw_out, "let (val_, move_) = __mbt_for_"), "keyword tuple binders use renamed idents")
  assert_true(str_has(kw_out, "s = s + val_ + move_"), "body uses same renamed idents as let binding")

  // P1-2: malformed / 1-element / 0-element tuple headers must fail closed
  for bad_hdr in ["()", "(a)", "((a), b)", "(a b)"] {
    let m_src = "pub fn bad_hdr(xs : Array[Int]) -> Int {\n  for " + bad_hdr + " in xs { () }\n  0\n}\n"
    let m_res = transpile_package([SourceFile::{ rel_path: "for_hdr_bad.mbt", content: m_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
    assert_true(m_res.blockers > 0, "invalid tuple header `" + bad_hdr + "` must fail closed")
    let mut saw_u = false
    for d in m_res.diagnostics {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_u = true }
    }
    assert_true(saw_u, "invalid tuple header `" + bad_hdr + "` must emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
}

test "F3c-2: high-frequency Array/Option/Char methods map to mbt_compat without custom-type hijack" {
  assert_true(lookup_missing_method_helper("Array[Int]", "search_by") == Some("mbt_compat::arr_search_by"), "Array::search_by mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "shrink_to_fit") == Some("mbt_compat::arr_shrink_to_fit"), "Array::shrink_to_fit mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "push_iter") == Some("mbt_compat::arr_push_iter"), "Array::push_iter mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "rev") == Some("mbt_compat::arr_rev"), "Array::rev mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "drain") == Some("mbt_compat::arr_drain"), "Array::drain mapped")
  assert_true(lookup_missing_method_helper("Option[Int]", "map_or") == Some("mbt_compat::opt_map_or"), "Option::map_or mapped")
  assert_true(lookup_missing_method_helper("Option[Int]", "bind") == Some("mbt_compat::opt_bind"), "Option::bind mapped")
  assert_true(lookup_missing_method_helper("Char", "is_ascii_alphabetic") == Some("mbt_compat::char_is_ascii_alphabetic"), "Char::is_ascii_alphabetic mapped")
  assert_true(lookup_missing_method_helper("CustomList", "search_by") == None, "custom search_by not hijacked")
  assert_true(lookup_missing_method_helper("CustomList", "drain") == None, "custom drain not hijacked")
  assert_true(lookup_missing_method_helper("CustomOpt", "map_or") == None, "custom map_or not hijacked")
  assert_true(lookup_missing_method_helper("CustomOpt", "bind") == None, "custom bind not hijacked")
}

test "F3c-3: recursive nested struct patterns, tuple-wrapped struct patterns, and or-is struct patterns" {
  let src = "priv struct Leaf { rest : Int }\n" +
  "priv struct Mid { back : Leaf? }\n" +
  "priv struct Outer { hit : Mid?, way : Leaf? }\n\n" +
  "pub fn inspect_nested(a : Outer?, b : Mid?) -> Int {\n" +
  "  if a is None && b is (None | Some({ back: None, .. })) {\n" +
  "    return -1\n" +
  "  }\n" +
  "  let x = match a {\n" +
  "    Some({ hit: Some({ back: Some(p), .. }), .. }) => p.rest\n" +
  "    _ => 0\n" +
  "  }\n" +
  "  let y = match (a, b) {\n" +
  "    (Some({ way: Some(w), .. }), _) => w.rest\n" +
  "    (_, Some({ back: Some(p), .. })) => p.rest + 10\n" +
  "    _ => 100\n" +
  "  }\n" +
  "  x + y\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "nested_sp.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "nested & tuple struct patterns should have 0 blockers")
  let out = res.files[0].content
  assert_true(!str_has(out, "{ back:"), "no raw struct pattern left in output")
  assert_true(!str_has(out, "{ way:"), "no raw tuple-wrapped struct pattern left in output")
  assert_true(!str_has(out, "{ hit:"), "no raw outer struct pattern left in output")
  assert_true(str_has(out, "match b { Option::None => true, Option::Some("), "is (None | Some({ ... })) lowered cleanly with expected type")

  // P1-3a: nested or-pattern containing struct pattern in match arm must fail closed
  let or_sp_src = "priv struct Box { a : Int }\n" +
  "pub fn bad_or_sp(x : Box?, y : Int) -> Int {\n" +
  "  match (x, y) {\n" +
  "    (None | Some({ a: 1, .. }), _) => 1\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let or_sp_res = transpile_package([SourceFile::{ rel_path: "or_sp_bad.mbt", content: or_sp_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(or_sp_res.blockers > 0, "nested or-pattern with struct pattern must fail closed")
  let mut saw_or_u = false
  for d in or_sp_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_or_u = true }
  }
  assert_true(saw_or_u, "nested or-pattern with struct pattern must emit MBT2PION_UNSUPPORTED_SYNTAX")

  // P1-3b: `is` expression with struct pattern introducing variable bindings (nested, shorthand, `as`) must fail closed
  for bad_is in [
    "b is Some({ back: Some(p), .. }) && p.rest > 0",
    "b is Some({ back, .. })",
    "b is Some({ back: None, .. } as m)",
  ] {
    let is_bind_src = "priv struct Leaf { rest : Int }\n" +
    "priv struct Mid { back : Leaf? }\n" +
    "pub fn bad_is_bind(b : Mid?) -> Int {\n" +
    "  if " + bad_is + " { 1 } else { 0 }\n" +
    "}\n"
    let is_bind_res = transpile_package([SourceFile::{ rel_path: "is_bind_bad.mbt", content: is_bind_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
    assert_true(is_bind_res.blockers > 0, "`is` struct pattern with variable binder `" + bad_is + "` must fail closed")
    let mut saw_is_u = false
    for d in is_bind_res.diagnostics {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_is_u = true }
    }
    assert_true(saw_is_u, "`is` struct pattern with variable binder `" + bad_is + "` must emit MBT2PION_UNSUPPORTED_SYNTAX")
  }

  // Red-team: field-level or-pattern inside struct pattern lowers via `(match f { A | B => true, _ => false })`
  let field_or_src = "priv enum Kind { A; B; C }\n" +
  "priv struct Item { kind : Kind }\n" +
  "pub fn check_kind(x : Item?) -> Int {\n" +
  "  match x {\n" +
  "    Some({ kind: A | B, .. }) => 1\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let field_or_res = transpile_package([SourceFile::{ rel_path: "field_or.mbt", content: field_or_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(field_or_res.blockers == 0, "field-level or-pattern inside struct pattern should have 0 blockers")
  let field_or_out = field_or_res.files[0].content
  assert_true(str_has(field_or_out, "=> true, _ => false })"), "field-level or-pattern uses match instead of invalid `is A | B`")
  assert_true(!str_has(field_or_out, " is A | B"), "must not emit invalid Pion `is A | B`")
}

test "F3c-4: Astra P1 regressions (search_by/iter mutation fail-closed, same-ctor or-is guard, mutating match guard, while block cond)" {
  // P1-2: same-outer-ctor or-is (`Some({ x: 1 }) | Some({ x: 2 })`) uses `if` guards for fallthrough
  let or_is_src = "priv struct S { x : Int }\n" +
  "pub fn check_same_ctor(s : S?) -> Bool {\n" +
  "  s is (Some({ x: 1 }) | Some({ x: 2 }))\n" +
  "}\n"
  let or_is_res = transpile_package([SourceFile::{ rel_path: "same_ctor_is.mbt", content: or_is_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(or_is_res.blockers == 0, "same-ctor or-is should have 0 blockers")
  let or_is_out = or_is_res.files[0].content
  assert_true(str_has(or_is_out, "if (__mbt_sp_") && str_has(or_is_out, "=> true"), "same-ctor or-is must emit `if` guard so fallthrough reaches second Some")

  // P1-3: struct pattern with bindings + non-pure `if` guard fails closed; pure `if` guard succeeds
  let mut_g_src = "priv struct Box { mut x : Int? }\n" +
  "fn change(b : Box) -> Bool { b.x = Some(9); true }\n" +
  "pub fn bad_guard(s : Box) -> Int {\n" +
  "  match (Some(s), 0) {\n" +
  "    (Some({ x: Some(k) }), _) if change(s) => k\n" +
  "    _ => -1\n" +
  "  }\n" +
  "}\n"
  let mut_g_res = transpile_package([SourceFile::{ rel_path: "guard_change.mbt", content: mut_g_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(mut_g_res.blockers > 0, "non-pure guard with struct-pattern bindings must fail closed")
  let mut saw_mg = false
  for d in mut_g_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_mg = true }
  }
  assert_true(saw_mg, "non-pure guard with struct-pattern bindings must emit MBT2PION_UNSUPPORTED_SYNTAX")

  let pure_g_src = "priv struct Box { x : Int? }\n" +
  "pub fn ok_guard(s : Box?, target : Int) -> Int {\n" +
  "  match s {\n" +
  "    Some({ x: Some(k) }) if k == target => k\n" +
  "    _ => -1\n" +
  "  }\n" +
  "}\n"
  let pure_g_res = transpile_package([SourceFile::{ rel_path: "guard_pure.mbt", content: pure_g_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(pure_g_res.blockers == 0, "pure guard with struct-pattern bindings should succeed")

  // P1-5: `match` arm `while { n < t } { n = n + 1 }` block condition does not truncate at condition `{`
  let wh_src = "pub fn while_block_cond(opt : Int?) -> Int {\n" +
  "  let mut n = 0\n" +
  "  match opt {\n" +
  "    Some(t) => while { n < t } { n = n + 1 }\n" +
  "    None => ()\n" +
  "  }\n" +
  "  n\n" +
  "}\n"
  let wh_res = transpile_package([SourceFile::{ rel_path: "while_expr.mbt", content: wh_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(wh_res.blockers == 0, "while block condition in match arm should have 0 blockers")
  let wh_out = wh_res.files[0].content
  assert_true(str_has(wh_out, "{ while { n < t } { n = n + 1 } }"), "while block condition and loop body both stay inside match arm wrapper")

  // P1-1: `Array::search_by` callback mutating receiver fails closed via Stage B guard
  let sb_pop_diags : Array[Diag] = []
  let sb_pop_src = "pub fn f(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { if x == 1 { let _ = xs.pop() }; x == 2 })\n}\n"
  let sb_ft1 : Map[String, Array[Token]] = Map()
  let sb_pf1 : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_retain_mutation_cached(sb_ft1, sb_pf1, "sb_pop.pion", sb_pop_src, 2, 6, "search_by", sb_pop_diags)
  assert_true(sb_pop_diags.length() > 0, "search_by callback calling xs.pop() must fail closed")

  let sb_wr_diags : Array[Diag] = []
  let sb_wr_src = "pub fn f(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { xs[1] = 99; x == 2 })\n}\n"
  let sb_ft2 : Map[String, Array[Token]] = Map()
  let sb_pf2 : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_retain_mutation_cached(sb_ft2, sb_pf2, "sb_wr.pion", sb_wr_src, 2, 6, "search_by", sb_wr_diags)
  assert_true(sb_wr_diags.length() > 0, "search_by callback mutating xs[1] must fail closed")

  // P1-4: escaping/mutated `Array::iter()` and self-`push_iter` fail closed with MBT2PION_ARRAY_ITER_MUTATION
  let sh_diags : Array[Diag] = []
  let sh_src = "pub fn f(a : Array[Int]) -> Int {\n  let it = a.iter()\n  a.shrink_to_fit()\n  a[0] = 42\n  it.count()\n}\n"
  let sh_ft : Map[String, Array[Token]] = Map()
  let sh_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(sh_ft, sh_pf, "shrink_iter.pion", sh_src, 2, 14, sh_diags)
  assert_true(sh_diags.length() > 0 && sh_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "shrink_iter must emit MBT2PION_ARRAY_ITER_MUTATION")

  let ic_diags : Array[Diag] = []
  let ic_src = "pub fn f(a : Array[Int]) -> Int {\n  let it = a.iter()\n  let _ = a.pop()\n  it.count()\n}\n"
  let ic_ft : Map[String, Array[Token]] = Map()
  let ic_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(ic_ft, ic_pf, "iter_change.pion", ic_src, 2, 14, ic_diags)
  assert_true(ic_diags.length() > 0 && ic_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "iter_change must emit MBT2PION_ARRAY_ITER_MUTATION")

  let sa_diags : Array[Diag] = []
  let sa_src = "pub fn f(xs : Array[Int]) -> Unit {\n  xs.push_iter(xs.iter())\n}\n"
  let sa_ft : Map[String, Array[Token]] = Map()
  let sa_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(sa_ft, sa_pf, "self_append.pion", sa_src, 2, 19, sa_diags)
  assert_true(sa_diags.length() > 0 && sa_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "self push_iter(xs.iter()) must emit MBT2PION_ARRAY_ITER_MUTATION")

  let ok_it_diags : Array[Diag] = []
  let ok_it_src = "pub fn f(dst : Array[Int], src : Array[Int]) -> Bool {\n  dst.push_iter(src.iter())\n  src.iter().any(fn(x) { x > 0 })\n}\n"
  let ok_ft : Map[String, Array[Token]] = Map()
  let ok_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(ok_ft, ok_pf, "ok_iter.pion", ok_it_src, 2, 21, ok_it_diags)
  stage_b_check_array_iter_mutation_cached(ok_ft, ok_pf, "ok_iter.pion", ok_it_src, 3, 7, ok_it_diags)
  assert_true(ok_it_diags.length() == 0, "disjoint push_iter and pure immediate .iter().any() must pass with 0 diagnostics")

  // Safe append-only local snapshot (`m2_r2_iter_fold_and_snap` pattern): fresh local + only push + non-escaping count()
  let snap_diags : Array[Diag] = []
  let snap_src = "pub fn snap() -> Int {\n  let xs = [1, 2]\n  let it = xs.iter()\n  xs.push(3)\n  it.count()\n}\n"
  let snap_ft : Map[String, Array[Token]] = Map()
  let snap_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(snap_ft, snap_pf, "snap.pion", snap_src, 3, 15, snap_diags)
  assert_true(snap_diags.length() == 0, "fresh local array with append-only push and non-escaping it.count() must pass")

  // Architect hardening: local fresh array `let xs = [1, 2]; xs.iter().any(fn(x) { let _ = xs.pop(); x == 2 })` must fail closed
  let loc_cb_diags : Array[Diag] = []
  let loc_cb_src = "pub fn f() -> Bool {\n  let xs = [1, 2]\n  xs.iter().any(fn(x) { let _ = xs.pop(); x == 2 })\n}\n"
  let loc_cb_ft : Map[String, Array[Token]] = Map()
  let loc_cb_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(loc_cb_ft, loc_cb_pf, "loc_cb.pion", loc_cb_src, 3, 6, loc_cb_diags)
  assert_true(loc_cb_diags.length() > 0 && loc_cb_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "local fresh array mutated inside .iter().any() callback must fail closed")

  // Architect hardening: escaping return `fn make_it(a) { a.iter() }`, alias mutation `let b = a; let it = a.iter(); b.pop()`,
  // and impure take arg `a.iter().take({ let _ = a.pop(); 1 }).to_array()` must all fail closed
  let esc_ret_diags : Array[Diag] = []
  let esc_ret_src = "pub fn make_it(a : Array[Int]) -> Iter[Int] {\n  a.iter()\n}\n"
  let esc_ret_ft : Map[String, Array[Token]] = Map()
  let esc_ret_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(esc_ret_ft, esc_ret_pf, "esc_ret.pion", esc_ret_src, 2, 5, esc_ret_diags)
  assert_true(esc_ret_diags.length() > 0 && esc_ret_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "returned escaping a.iter() must fail closed")

  let alias_diags : Array[Diag] = []
  let alias_src = "pub fn f(a : Array[Int]) -> Int {\n  let b = a\n  let it = a.iter()\n  let _ = b.pop()\n  it.count()\n}\n"
  let alias_ft : Map[String, Array[Token]] = Map()
  let alias_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(alias_ft, alias_pf, "alias_iter.pion", alias_src, 3, 14, alias_diags)
  assert_true(alias_diags.length() > 0 && alias_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "escaping a.iter() with alias mutation must fail closed")

  let take_diags : Array[Diag] = []
  let take_src = "pub fn f(a : Array[Int]) -> Array[Int] {\n  a.iter().take({ let _ = a.pop(); 1 }).to_array()\n}\n"
  let take_ft : Map[String, Array[Token]] = Map()
  let take_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(take_ft, take_pf, "impure_take.pion", take_src, 2, 5, take_diags)
  assert_true(take_diags.length() > 0 && take_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "impure take() argument mutating receiver must fail closed")

  // Architect hardening: pipe-operator `|>` in guard with struct-pattern bindings must fail closed
  let pipe_g_src = "priv struct Box { mut x : Int? }\n" +
  "fn change(b : Box) -> Bool { b.x = Some(9); true }\n" +
  "pub fn bad_pipe_guard(s : Box) -> Int {\n" +
  "  match (Some(s), 0) {\n" +
  "    (Some({ x: Some(k) }), _) if s |> change => k\n" +
  "    _ => -1\n" +
  "  }\n" +
  "}\n"
  let pipe_g_res = transpile_package([SourceFile::{ rel_path: "guard_pipe.mbt", content: pipe_g_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(pipe_g_res.blockers > 0, "pipe operator in guard with struct-pattern bindings must fail closed")

  // Red-team P1-1: `while` / `for` in match arm followed on the next line by `(2, n) => ...` or `.B => ...`
  // must NOT swallow the next match arm as a loop condition continuation.
  let next_arm_src = "priv enum Tag { A; B }\n" +
  "pub fn loop_next_tuple_arm(x : (Int, Int)) -> Int {\n" +
  "  let mut s = 0\n" +
  "  match x {\n" +
  "    (1, n) => while s < n { s = s + 1 }\n" +
  "    (2, n) => { s = n * 10 }\n" +
  "    _ => ()\n" +
  "  }\n" +
  "  s\n" +
  "}\n" +
  "pub fn loop_next_dot_arm(t : Tag, n : Int) -> Int {\n" +
  "  let mut s = 0\n" +
  "  match t {\n" +
  "    .A => for i = 0; i < n; i = i + 1 { s = s + i }\n" +
  "    .B => { s = 99 }\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let next_arm_res = transpile_package([SourceFile::{ rel_path: "loop_next_arm.mbt", content: next_arm_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(next_arm_res.blockers == 0, "while/for arm followed by next-line tuple/dot match arm should have 0 blockers")
  let next_arm_out = next_arm_res.files[0].content
  assert_true(str_has(next_arm_out, "(1, n) => { while s < n { s = s + 1 } }"), "while arm must close before next-line `(2, n) =>` arm")
  assert_true(str_has(next_arm_out, "(2, n) => { s = n * 10 }"), "next-line `(2, n) =>` arm must stay intact")
  assert_true(str_has(next_arm_out, "=> { s = 99 }"), "next-line `.B =>` arm must stay intact")

  // Astra round-2 final 4 edges:
  // (1) InterpString in guard / search_by callback / iter callback or append-only scope fails closed
  let g_interp_src = "priv struct Box { mut x : Int? }\n" +
  "fn change(b : Box) -> Int { b.x = Some(9); 1 }\n" +
  "pub fn bad_interp_guard(s : Box) -> Int {\n" +
  "  match (Some(s), 0) {\n" +
  "    (Some({ x: Some(k) }), _) if \"\\{change(s)}\" == \"1\" => k\n" +
  "    _ => -1\n" +
  "  }\n" +
  "}\n"
  let g_interp_res = transpile_package([SourceFile::{ rel_path: "guard_interp.mbt", content: g_interp_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(g_interp_res.blockers > 0, "InterpString in guard with struct-pattern bindings must fail closed")

  let sb_eff_diags : Array[Diag] = []
  let sb_eff_src = "pub fn f(xs : Array[Int]) -> Option[Int] {\n  xs.search_by(fn(x) { let _ = \"\\{xs.pop()}\"; x == 2 })\n}\n"
  let sb_eff_ft : Map[String, Array[Token]] = Map()
  let sb_eff_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_retain_mutation_cached(sb_eff_ft, sb_eff_pf, "search_effect.pion", sb_eff_src, 2, 6, "search_by", sb_eff_diags)
  assert_true(sb_eff_diags.length() > 0, "search_by callback with InterpString must fail closed")

  let it_eff_diags : Array[Diag] = []
  let it_eff_src = "pub fn f() -> Int {\n  let xs = [1, 2]\n  let it = xs.iter()\n  let _ = \"\\{xs.pop()}\"\n  it.count()\n}\n"
  let it_eff_ft : Map[String, Array[Token]] = Map()
  let it_eff_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(it_eff_ft, it_eff_pf, "iter_effect.pion", it_eff_src, 3, 15, it_eff_diags)
  assert_true(it_eff_diags.length() > 0 && it_eff_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "append-only iter scope with InterpString must fail closed")

  // (2) Custom Holder::copy() must NOT be treated as fresh_disjoint
  let sb_cp_diags : Array[Diag] = []
  let sb_cp_src = "pub fn f(h : Holder, xs : Array[Int]) -> Option[Int] {\n  let alias_arr = h.copy()\n  xs.search_by(fn(x) { let _ = alias_arr.pop(); x == 2 })\n}\n"
  let sb_cp_ft : Map[String, Array[Token]] = Map()
  let sb_cp_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_retain_mutation_cached(sb_cp_ft, sb_cp_pf, "search_copy.pion", sb_cp_src, 3, 6, "search_by", sb_cp_diags)
  assert_true(sb_cp_diags.length() > 0, "custom h.copy() alias mutated in search_by callback must fail closed")

  // (3) Case 4 `let xs = [a][0]` indexed RHS must NOT pass as fresh local array
  let it_al_diags : Array[Diag] = []
  let it_al_src = "pub fn f(a : Array[Int]) -> Int {\n  let xs : Array[Int] = [a][0]\n  let it = xs.iter()\n  xs.push(3)\n  it.count()\n}\n"
  let it_al_ft : Map[String, Array[Token]] = Map()
  let it_al_pf : Map[String, StageBPkgFn] = Map()
  stage_b_check_array_iter_mutation_cached(it_al_ft, it_al_pf, "iter_alias.pion", it_al_src, 3, 15, it_al_diags)
  assert_true(it_al_diags.length() > 0 && it_al_diags[0].code == "MBT2PION_ARRAY_ITER_MUTATION", "indexed `[a][0]` RHS must not qualify as fresh local array for iter")

  // (4) Multiline lowercase method chain `.ok()` after block condition in `while` arm
  let wd_src = "priv struct CBox { n : Int }\n" +
  "fn CBox::ok(self : CBox) -> Bool { self.n > 0 }\n" +
  "pub fn while_dot_cond(opt : Int?) -> Int {\n" +
  "  let mut n = 3\n" +
  "  match opt {\n" +
  "    Some(_) => while { CBox::{ n: n } }\n" +
  "      .ok() { n = n - 1 }\n" +
  "    None => ()\n" +
  "  }\n" +
  "  n\n" +
  "}\n"
  let wd_res = transpile_package([SourceFile::{ rel_path: "while_dot.mbt", content: wd_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(wd_res.blockers == 0, "multiline `.ok()` continuation after while block condition should have 0 blockers")
  let wd_out = wd_res.files[0].content
  assert_true(str_has(wd_out, ".ok() { n = n - 1 } }"), "multiline `.ok()` and loop body must stay inside match arm wrapper")
}
