///| Wave M2-F3c unit tests:
///| 1. `match` arm `for`/`while` bodies (with `,`/`;`), multiline `match` scrutinees,
///|    and tuple-destructuring `for (a, b) in xs` / `for i, (a, b) in xs` (fail-closed on refutable patterns)
///| 2. High-frequency core method helpers (`Array::search_by`, `shrink_to_fit`, `push_iter`, `rev`, `drain`,
///|    `Option::map_or`, `bind`, `Char::is_ascii_alphabetic`) without custom-type hijack
///| 3. Recursive nested & tuple-wrapped struct patterns in `match` arms and `is (None | Some({ ... }))`

test "F3c-1a: match arm for-in with comma, C-style for, and multiline match arm body" {
  let src = "pub fn arm_loops(opt : Int?, pairs : Map[Int, Int], xs : Array[Int]) -> Int {\n" +
  "  let mut acc = 0\n" +
  "  match opt {\n" +
  "    Some(limit) if limit > 0 =>\n" +
  "      for k, v in pairs {\n" +
  "        if k < limit {\n" +
  "          acc = acc + v\n" +
  "        }\n" +
  "      }\n" +
  "    Some(_) =>\n" +
  "      for i = 0; i < xs.length(); i = i + 1 {\n" +
  "        acc = acc + xs[i]\n" +
  "      }\n" +
  "    None =>\n" +
  "      match\n" +
  "        xs.get(0) {\n" +
  "        Some(v) => acc = acc + v\n" +
  "        None => ()\n" +
  "      }\n" +
  "  }\n" +
  "  acc\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "arm_loops.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "match arm loops should transpile with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "{ for k, v in pairs {"), "for k, v in inside match arm stays intact")
  assert_true(str_has(out, "{ for i = 0; i < xs.length(); i = i + 1 {"), "C-style for inside match arm stays intact")
  assert_true(!str_has(out, "{ for k },"), "comma in for k, v must never split match arm")
  assert_true(!str_has(out, "__mbt_sp_"), "multiline match body must never be misparsed as struct pattern")
}

test "F3c-1b: tuple destructuring for-in lowers cleanly and rejects refutable patterns fail-closed" {
  let ok_src = "pub fn sum_pairs(xs : Array[(Int, Int)], nested : Array[((Int, Int), Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (a, b) in xs {\n" +
  "    s = s + a + b\n" +
  "  }\n" +
  "  for i, (a, _) in xs {\n" +
  "    s = s + i * a\n" +
  "  }\n" +
  "  for ((x, y), z) in nested {\n" +
  "    s = s + x + y + z\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let ok_res = transpile_package([SourceFile::{ rel_path: "for_tup.mbt", content: ok_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(ok_res.blockers == 0, "irrefutable tuple for-in should have 0 blockers")
  let out = ok_res.files[0].content
  assert_true(str_has(out, "let (a, b) = __mbt_for_"), "for (a, b) in lowers to let (a, b) = tmp")
  assert_true(str_has(out, "let (a, _) = __mbt_for_"), "for i, (a, _) in lowers to let (a, _) = tmp")
  assert_true(str_has(out, "let (__mbt_ft_") && str_has(out, "let (x, y) = __mbt_ft_"), "nested tuple for-in flattens cleanly")

  let bad_src = "pub fn bad_for(xs : Array[(Int?, Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (Some(a), b) in xs {\n" +
  "    s = s + a + b\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let bad_res = transpile_package([SourceFile::{ rel_path: "for_bad.mbt", content: bad_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "refutable pattern in for-in must fail closed")
  let mut saw_unsup = false
  for d in bad_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_unsup = true }
  }
  assert_true(saw_unsup, "refutable for-in must emit MBT2PION_UNSUPPORTED_SYNTAX")

  // P1-1: keyword/shadowed tuple binders must match the renamed loop body (emitted before restore_ident_renames)
  let kw_src = "pub fn kw_tuple_for(xs : Array[(Int, Int)]) -> Int {\n" +
  "  let mut s = 0\n" +
  "  for (val, move) in xs {\n" +
  "    s = s + val + move\n" +
  "  }\n" +
  "  s\n" +
  "}\n"
  let kw_res = transpile_package([SourceFile::{ rel_path: "for_kw.mbt", content: kw_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(kw_res.blockers == 0, "keyword tuple binders in for-in should have 0 blockers")
  let kw_out = kw_res.files[0].content
  assert_true(str_has(kw_out, "let (val_, move_) = __mbt_for_"), "keyword tuple binders use renamed idents")
  assert_true(str_has(kw_out, "s = s + val_ + move_"), "body uses same renamed idents as let binding")

  // P1-2: malformed / 1-element / 0-element tuple headers must fail closed
  for bad_hdr in ["()", "(a)", "((a), b)", "(a b)"] {
    let m_src = "pub fn bad_hdr(xs : Array[Int]) -> Int {\n  for " + bad_hdr + " in xs { () }\n  0\n}\n"
    let m_res = transpile_package([SourceFile::{ rel_path: "for_hdr_bad.mbt", content: m_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
    assert_true(m_res.blockers > 0, "invalid tuple header `" + bad_hdr + "` must fail closed")
    let mut saw_u = false
    for d in m_res.diagnostics {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_u = true }
    }
    assert_true(saw_u, "invalid tuple header `" + bad_hdr + "` must emit MBT2PION_UNSUPPORTED_SYNTAX")
  }
}

test "F3c-2: high-frequency Array/Option/Char methods map to mbt_compat without custom-type hijack" {
  assert_true(lookup_missing_method_helper("Array[Int]", "search_by") == Some("mbt_compat::arr_search_by"), "Array::search_by mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "shrink_to_fit") == Some("mbt_compat::arr_shrink_to_fit"), "Array::shrink_to_fit mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "push_iter") == Some("mbt_compat::arr_push_iter"), "Array::push_iter mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "rev") == Some("mbt_compat::arr_rev"), "Array::rev mapped")
  assert_true(lookup_missing_method_helper("Array[Int]", "drain") == Some("mbt_compat::arr_drain"), "Array::drain mapped")
  assert_true(lookup_missing_method_helper("Option[Int]", "map_or") == Some("mbt_compat::opt_map_or"), "Option::map_or mapped")
  assert_true(lookup_missing_method_helper("Option[Int]", "bind") == Some("mbt_compat::opt_bind"), "Option::bind mapped")
  assert_true(lookup_missing_method_helper("Char", "is_ascii_alphabetic") == Some("mbt_compat::char_is_ascii_alphabetic"), "Char::is_ascii_alphabetic mapped")
  assert_true(lookup_missing_method_helper("CustomList", "search_by") == None, "custom search_by not hijacked")
  assert_true(lookup_missing_method_helper("CustomList", "drain") == None, "custom drain not hijacked")
  assert_true(lookup_missing_method_helper("CustomOpt", "map_or") == None, "custom map_or not hijacked")
  assert_true(lookup_missing_method_helper("CustomOpt", "bind") == None, "custom bind not hijacked")
}

test "F3c-3: recursive nested struct patterns, tuple-wrapped struct patterns, and or-is struct patterns" {
  let src = "priv struct Leaf { rest : Int }\n" +
  "priv struct Mid { back : Leaf? }\n" +
  "priv struct Outer { hit : Mid?, way : Leaf? }\n\n" +
  "pub fn inspect_nested(a : Outer?, b : Mid?) -> Int {\n" +
  "  if a is None && b is (None | Some({ back: None, .. })) {\n" +
  "    return -1\n" +
  "  }\n" +
  "  let x = match a {\n" +
  "    Some({ hit: Some({ back: Some(p), .. }), .. }) => p.rest\n" +
  "    _ => 0\n" +
  "  }\n" +
  "  let y = match (a, b) {\n" +
  "    (Some({ way: Some(w), .. }), _) => w.rest\n" +
  "    (_, Some({ back: Some(p), .. })) => p.rest + 10\n" +
  "    _ => 100\n" +
  "  }\n" +
  "  x + y\n" +
  "}\n"
  let res = transpile_package([SourceFile::{ rel_path: "nested_sp.mbt", content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(res.blockers == 0, "nested & tuple struct patterns should have 0 blockers")
  let out = res.files[0].content
  assert_true(!str_has(out, "{ back:"), "no raw struct pattern left in output")
  assert_true(!str_has(out, "{ way:"), "no raw tuple-wrapped struct pattern left in output")
  assert_true(!str_has(out, "{ hit:"), "no raw outer struct pattern left in output")
  assert_true(str_has(out, "match b { Option::None => true, Option::Some("), "is (None | Some({ ... })) lowered cleanly with expected type")

  // P1-3a: nested or-pattern containing struct pattern in match arm must fail closed
  let or_sp_src = "priv struct Box { a : Int }\n" +
  "pub fn bad_or_sp(x : Box?, y : Int) -> Int {\n" +
  "  match (x, y) {\n" +
  "    (None | Some({ a: 1, .. }), _) => 1\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let or_sp_res = transpile_package([SourceFile::{ rel_path: "or_sp_bad.mbt", content: or_sp_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(or_sp_res.blockers > 0, "nested or-pattern with struct pattern must fail closed")
  let mut saw_or_u = false
  for d in or_sp_res.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_or_u = true }
  }
  assert_true(saw_or_u, "nested or-pattern with struct pattern must emit MBT2PION_UNSUPPORTED_SYNTAX")

  // P1-3b: `is` expression with struct pattern introducing variable bindings (nested, shorthand, `as`) must fail closed
  for bad_is in [
    "b is Some({ back: Some(p), .. }) && p.rest > 0",
    "b is Some({ back, .. })",
    "b is Some({ back: None, .. } as m)",
  ] {
    let is_bind_src = "priv struct Leaf { rest : Int }\n" +
    "priv struct Mid { back : Leaf? }\n" +
    "pub fn bad_is_bind(b : Mid?) -> Int {\n" +
    "  if " + bad_is + " { 1 } else { 0 }\n" +
    "}\n"
    let is_bind_res = transpile_package([SourceFile::{ rel_path: "is_bind_bad.mbt", content: is_bind_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
    assert_true(is_bind_res.blockers > 0, "`is` struct pattern with variable binder `" + bad_is + "` must fail closed")
    let mut saw_is_u = false
    for d in is_bind_res.diagnostics {
      if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" { saw_is_u = true }
    }
    assert_true(saw_is_u, "`is` struct pattern with variable binder `" + bad_is + "` must emit MBT2PION_UNSUPPORTED_SYNTAX")
  }

  // Red-team: field-level or-pattern inside struct pattern lowers via `(match f { A | B => true, _ => false })`
  let field_or_src = "priv enum Kind { A; B; C }\n" +
  "priv struct Item { kind : Kind }\n" +
  "pub fn check_kind(x : Item?) -> Int {\n" +
  "  match x {\n" +
  "    Some({ kind: A | B, .. }) => 1\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let field_or_res = transpile_package([SourceFile::{ rel_path: "field_or.mbt", content: field_or_src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(field_or_res.blockers == 0, "field-level or-pattern inside struct pattern should have 0 blockers")
  let field_or_out = field_or_res.files[0].content
  assert_true(str_has(field_or_out, "=> true, _ => false })"), "field-level or-pattern uses match instead of invalid `is A | B`")
  assert_true(!str_has(field_or_out, " is A | B"), "must not emit invalid Pion `is A | B`")
}
