///| Wave M2-F3d Track F3d-1b unit tests:
///| 1. Native `#derive(Eq)` on non-primitive structs, tuple structs, enums, and generics
///|    (Array, FixedArray, Option, Result, tuples, nested types, `#derive(Eq, Hash)` -> `self == other`).
///| 2. MoonBit `[pub] impl Eq` / `[pub] impl[T, ...] Eq` lowered to Pion built-in `impl Eq`:
///|    - Omitted param & return types auto-filled (`: <self_ty>` and `-> Bool`)
///|    - `impl_param_scope` enables tuple-struct `.0 -> ._0` & enum variant resolution in `equal`
///|    - Generic `impl[T]`, `impl[T : Eq]`, `impl[A, B : Eq]`
///|    - Wildcard `_` and reserved-keyword parameter names
///|    - Anti-hijacking when package declares custom `trait Eq`
///| 3. Fail-closed negative cases:
///|    - `impl Eq ... with not_equal` (standalone or split after `with equal`) -> `MBT2PION_UNSUPPORTED_SYNTAX`
///|    - Non-`Eq` generic `impl[T : Eq] Show for ...` -> `MBT2PION_UNSUPPORTED_SYNTAX`
///|    - `#derive(Eq)` with closure field emits `#derive(Eq)` directly (never masked by `__mbt_eq_*`)

fn f3d1b_transpile(rel : String, src : String) -> TranspileResult {
  transpile_package([SourceFile::{ rel_path: rel, content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
}

fn f3d1b_all_out(res : TranspileResult) -> String {
  let sb = StringBuilder()
  for f in res.files {
    sb.write_string(f.content)
    sb.write_string("\n")
  }
  sb.to_string()
}

test "F3d1b-1: non-primitive #derive(Eq) structs, tuple structs, enums, generics, and MapKey" {
  let src = "#derive(Eq)\n" +
  "pub(all) struct Item {\n" +
  "  name : String\n" +
  "  tags : Array[String]\n" +
  "  opt : Option[Int]\n" +
  "  pair : (Int, Bool)\n" +
  "}\n\n" +
  "#derive(Eq)\n" +
  "pub struct Wrap[T](Array[T], Option[T])\n\n" +
  "pub(all) enum Node[T] {\n" +
  "  Leaf(T)\n" +
  "  Branch(Array[Node[T]], Result[Int, String])\n" +
  "} derive(Eq)\n\n" +
  "#derive(Eq, Hash)\n" +
  "pub(all) struct ComplexKey {\n" +
  "  id : Int\n" +
  "  parts : Array[String]\n" +
  "}\n"
  let res = f3d1b_transpile("eq_derive.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "#derive(Eq)\npub struct Item"), "non-primitive struct gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct Wrap[T]"), "generic tuple struct gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub enum Node[T]"), "generic enum with trailing derive(Eq) gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct ComplexKey"), "#derive(Eq, Hash) non-primitive struct gets native #derive(Eq): " + out)
  assert_true(!str_has(out, "__mbt_eq_"), "must NOT synthesize __mbt_eq_* helpers for native-compatible types: " + out)
  assert_true(str_has(out, "fn key_eq(self : ComplexKey, other : ComplexKey) -> Bool {\n    self == other\n  }"), "MapKey::key_eq uses native self == other: " + out)
}

test "F3d1b-2: concrete and generic built-in impl Eq lowering with auto-fill and scope" {
  let src = "pub(all) struct Picked {\n" +
  "  tag : Int\n" +
  "  same : (Picked) -> Bool\n" +
  "}\n\n" +
  "impl Eq for Picked with equal(a, b) {\n" +
  "  (a.same)(b)\n" +
  "}\n\n" +
  "pub(all) enum Anchor {\n" +
  "  Node(Int)\n" +
  "  At(Double, Double)\n" +
  "  Unanchored\n" +
  "}\n\n" +
  "pub impl Eq for Anchor with equal(self, other) {\n" +
  "  match (self, other) {\n" +
  "    (Node(a), Node(b)) => a == b\n" +
  "    (At(x, y), At(x2, y2)) => x == x2 && y == y2\n" +
  "    (Unanchored, Unanchored) => true\n" +
  "    _ => false\n" +
  "  }\n" +
  "}\n\n" +
  "struct TheseItems[T](Array[T])\n\n" +
  "impl[T] Eq for TheseItems[T] with equal(a, b) {\n" +
  "  guard a.0.length() == b.0.length() else { return false }\n" +
  "  for i in 0..<a.0.length() {\n" +
  "    if !physical_equal(a.0[i], b.0[i]) {\n" +
  "      return false\n" +
  "    }\n" +
  "  }\n" +
  "  true\n" +
  "}\n\n" +
  "pub struct Box[T] {\n" +
  "  v : T\n" +
  "}\n\n" +
  "pub impl[T : Eq] Eq for Box[T] with equal(a, b) {\n" +
  "  a.v == b.v\n" +
  "}\n\n" +
  "pub struct Pair[A, B] {\n" +
  "  first : A\n" +
  "  second : B\n" +
  "}\n\n" +
  "impl[A, B : Eq] Eq for Pair[A, B] with equal(x, y) {\n" +
  "  x.second == y.second\n" +
  "}\n\n" +
  "struct Wild { x : Int }\n" +
  "impl Eq for Wild with equal(_, _) {\n" +
  "  true\n" +
  "}\n"
  let res = f3d1b_transpile("eq_impl.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "impl Eq for Picked {\n  fn equal(a : Picked, b : Picked) -> Bool"), "concrete private impl Eq auto-fills params & return: " + out)
  assert_true(str_has(out, "pub impl Eq for Anchor {\n  fn equal(self : Anchor, other : Anchor) -> Bool"), "pub impl Eq preserves pub visibility: " + out)
  assert_true(str_has(out, "impl[T] Eq for TheseItems[T] {\n  fn equal(a : TheseItems[T], b : TheseItems[T]) -> Bool"), "generic impl[T] Eq lowered: " + out)
  assert_true(str_has(out, "a._0.length() == b._0.length()"), "impl_param_scope lowers tuple-struct .0 -> ._0: " + out)
  assert_true(str_has(out, "pub impl[T : Eq] Eq for Box[T] {\n  fn equal(a : Box[T], b : Box[T]) -> Bool"), "generic bounded pub impl[T : Eq] Eq lowered: " + out)
  assert_true(str_has(out, "impl[A, B : Eq] Eq for Pair[A, B] {\n  fn equal(x : Pair[A, B], y : Pair[A, B]) -> Bool"), "partial-bound generic impl[A, B : Eq] Eq lowered: " + out)
  assert_true(str_has(out, "impl Eq for Wild {\n  fn equal(_ : Wild, _ : Wild) -> Bool"), "wildcard params auto-filled: " + out)
}

test "F3d1b-3: fail-closed not_equal, split equal+not_equal, closure #derive(Eq), and anti-hijacking" {
  // 1. Standalone `with not_equal` -> MBT2PION_UNSUPPORTED_SYNTAX
  let neg1 = "pub struct S { x : Int }\nimpl Eq for S with not_equal(a, b) { a.x != b.x }\n"
  let r1 = f3d1b_transpile("neg_neq.mbt", neg1)
  assert_true(r1.blockers > 0, "impl Eq with not_equal must block")
  let mut saw_neq1 = false
  for d in r1.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "not_equal") {
      saw_neq1 = true
    }
  }
  assert_true(saw_neq1, "must report MBT2PION_UNSUPPORTED_SYNTAX for not_equal")

  // 2. Split `with equal` + `with not_equal` on same type -> MUST fail-closed (never merged/dropped)
  let neg2 = "pub struct S2 { x : Int }\nimpl Eq for S2 with equal(a, b) { a.x == b.x }\nimpl Eq for S2 with not_equal(a, b) { a.x != b.x }\n"
  let r2 = f3d1b_transpile("neg_split.mbt", neg2)
  assert_true(r2.blockers > 0, "split equal + not_equal must block")
  let mut saw_neq2 = false
  for d in r2.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "not_equal") {
      saw_neq2 = true
    }
  }
  assert_true(saw_neq2, "split not_equal must report MBT2PION_UNSUPPORTED_SYNTAX")

  // 3. Closure field in `#derive(Eq)` emits `#derive(Eq)` directly (never masked by `__mbt_eq_*`),
  //    so Pion's FINAL_CHECK rejects it fail-closed at declaration time.
  let neg3 = "#derive(Eq)\npub struct HasCb { cb : () -> Unit }\n"
  let r3 = f3d1b_transpile("neg_cb.mbt", neg3)
  let out3 = f3d1b_all_out(r3)
  assert_true(str_has(out3, "#derive(Eq)\npub struct HasCb") && !str_has(out3, "__mbt_eq_"), "closure #derive(Eq) emits native #derive(Eq) for Pion FINAL_CHECK rejection: " + out3)

  // 4. Anti-hijacking: local `trait Eq` uses ordinary user-trait lowering, not built-in `Eq`
  let hijack_src = "pub trait Eq {\n  check(Self, Self) -> Bool\n}\n" +
  "pub struct LocalT { x : Int }\n" +
  "impl Eq for LocalT with check(a, b) { a.x == b.x }\n" +
  "impl[T] Eq for Array[T] with check(a, b) { true }\n"
  let r4 = f3d1b_transpile("hijack.mbt", hijack_src)
  let out4 = f3d1b_all_out(r4)
  assert_true(str_has(out4, "impl Eq for LocalT {\n  fn check(a : LocalT, b : LocalT) -> Bool"), "local trait Eq uses normal trait path: " + out4)
  let mut saw_gen_user_eq = false
  for d in r4.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "generic `impl[...]`") {
      saw_gen_user_eq = true
    }
  }
  assert_true(saw_gen_user_eq, "generic impl[...] for user-declared trait Eq stays fail-closed")
}
