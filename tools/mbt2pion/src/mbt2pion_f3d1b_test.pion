///| Wave M2-F3d Track F3d-1b unit tests:
///| 1. Native `#derive(Eq)` on non-primitive structs, tuple structs, enums, and generics
///|    (Array, FixedArray, Option, Result, tuples, nested types, `#derive(Eq, Hash)` -> `self == other`).
///| 2. MoonBit `[pub] impl Eq` / `[pub] impl[T, ...] Eq` lowered to Pion built-in `impl Eq`:
///|    - Omitted param & return types auto-filled (`: <self_ty>` and `-> Bool`)
///|    - `impl_param_scope` enables tuple-struct `.0 -> ._0` & enum variant resolution in `equal`
///|    - Generic `impl[T]`, `impl[T : Eq]`, `impl[A, B : Eq]`
///|    - Wildcard `_` and reserved-keyword parameter names
///|    - Anti-hijacking when package declares custom `trait Eq`
///| 3. Fail-closed negative cases:
///|    - `impl Eq ... with not_equal` (standalone or split after `with equal`) -> `MBT2PION_UNSUPPORTED_SYNTAX`
///|    - Non-`Eq` generic `impl[T : Eq] Show for ...` -> `MBT2PION_UNSUPPORTED_SYNTAX`
///|    - `#derive(Eq)` with closure field emits `#derive(Eq)` directly (never masked by `__mbt_eq_*`)

fn f3d1b_transpile(rel : String, src : String) -> TranspileResult {
  transpile_package([SourceFile::{ rel_path: rel, content: src, is_test: false }], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
}

fn f3d1b_all_out(res : TranspileResult) -> String {
  let sb = StringBuilder()
  for f in res.files {
    sb.write_string(f.content)
    sb.write_string("\n")
  }
  sb.to_string()
}

test "F3d1b-1: non-primitive #derive(Eq) structs, tuple structs, enums, generics, and MapKey" {
  let src = "#derive(Eq)\n" +
  "pub(all) struct Item {\n" +
  "  name : String\n" +
  "  tags : Array[String]\n" +
  "  opt : Option[Int]\n" +
  "  pair : (Int, Bool)\n" +
  "}\n\n" +
  "#derive(Eq)\n" +
  "pub struct Wrap[T](Array[T], Option[T])\n\n" +
  "pub(all) enum Choice[T] {\n" +
  "  One(T)\n" +
  "  Many(Array[T], Result[Int, String])\n" +
  "} derive(Eq)\n\n" +
  "pub(all) enum Node[T] {\n" +
  "  Leaf(T)\n" +
  "  Branch(Array[Node[T]], Result[Int, String])\n" +
  "} derive(Eq)\n\n" +
  "#derive(Eq, Hash)\n" +
  "pub(all) struct ComplexKey {\n" +
  "  id : Int\n" +
  "  parts : Array[String]\n" +
  "}\n"
  let res = f3d1b_transpile("eq_derive.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "#derive(Eq)\npub struct Item"), "non-primitive struct gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct Wrap[T]"), "generic tuple struct gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub enum Choice[T]"), "non-recursive generic enum with trailing derive(Eq) gets native #derive(Eq): " + out)
  assert_true(str_has(out, "pub impl[T : Eq] Eq for Node[T]"), "self-recursive generic enum with trailing derive(Eq) gets explicit pub impl[T : Eq] Eq: " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct ComplexKey"), "#derive(Eq, Hash) non-primitive struct gets native #derive(Eq): " + out)
  assert_true(!str_has(out, "__mbt_eq_"), "must NOT synthesize __mbt_eq_* helpers for native-compatible types: " + out)
  assert_true(str_has(out, "fn key_eq(self : ComplexKey, other : ComplexKey) -> Bool {\n    self == other\n  }"), "MapKey::key_eq uses native self == other: " + out)
}

test "F3d1b-2: concrete and generic built-in impl Eq lowering with auto-fill and scope" {
  let src = "pub(all) struct Picked {\n" +
  "  tag : Int\n" +
  "  same : (Picked) -> Bool\n" +
  "}\n\n" +
  "impl Eq for Picked with equal(a, b) {\n" +
  "  (a.same)(b)\n" +
  "}\n\n" +
  "pub(all) enum Anchor {\n" +
  "  Node(Int)\n" +
  "  At(Double, Double)\n" +
  "  Unanchored\n" +
  "}\n\n" +
  "pub impl Eq for Anchor with equal(self, other) {\n" +
  "  match (self, other) {\n" +
  "    (Node(a), Node(b)) => a == b\n" +
  "    (At(x, y), At(x2, y2)) => x == x2 && y == y2\n" +
  "    (Unanchored, Unanchored) => true\n" +
  "    _ => false\n" +
  "  }\n" +
  "}\n\n" +
  "struct TheseItems[T](Array[T])\n\n" +
  "impl[T] Eq for TheseItems[T] with equal(a, b) {\n" +
  "  guard a.0.length() == b.0.length() else { return false }\n" +
  "  for i in 0..<a.0.length() {\n" +
  "    if !physical_equal(a.0[i], b.0[i]) {\n" +
  "      return false\n" +
  "    }\n" +
  "  }\n" +
  "  true\n" +
  "}\n\n" +
  "pub struct Box[T] {\n" +
  "  v : T\n" +
  "}\n\n" +
  "pub impl[T : Eq] Eq for Box[T] with equal(a, b) {\n" +
  "  a.v == b.v\n" +
  "}\n\n" +
  "pub struct Pair[A, B] {\n" +
  "  first : A\n" +
  "  second : B\n" +
  "}\n\n" +
  "impl[A, B : Eq] Eq for Pair[A, B] with equal(x, y) {\n" +
  "  x.second == y.second\n" +
  "}\n\n" +
  "struct Wild { x : Int }\n" +
  "impl Eq for Wild with equal(_, _) {\n" +
  "  true\n" +
  "}\n"
  let res = f3d1b_transpile("eq_impl.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "impl Eq for Picked {\n  fn equal(a : Picked, b : Picked) -> Bool"), "concrete private impl Eq auto-fills params & return: " + out)
  assert_true(str_has(out, "pub impl Eq for Anchor {\n  fn equal(self : Anchor, other : Anchor) -> Bool"), "pub impl Eq preserves pub visibility: " + out)
  assert_true(str_has(out, "impl[T] Eq for TheseItems[T] {\n  fn equal(a : TheseItems[T], b : TheseItems[T]) -> Bool"), "generic impl[T] Eq lowered: " + out)
  assert_true(str_has(out, "a._0.length() == b._0.length()"), "impl_param_scope lowers tuple-struct .0 -> ._0: " + out)
  assert_true(str_has(out, "pub impl[T : Eq] Eq for Box[T] {\n  fn equal(a : Box[T], b : Box[T]) -> Bool"), "generic bounded pub impl[T : Eq] Eq lowered: " + out)
  assert_true(str_has(out, "impl[A, B : Eq] Eq for Pair[A, B] {\n  fn equal(x : Pair[A, B], y : Pair[A, B]) -> Bool"), "partial-bound generic impl[A, B : Eq] Eq lowered: " + out)
  assert_true(str_has(out, "impl Eq for Wild {\n  fn equal(_ : Wild, _ : Wild) -> Bool"), "wildcard params auto-filled: " + out)
}

test "F3d1b-3: fail-closed not_equal, split equal+not_equal, closure #derive(Eq), and anti-hijacking" {
  // 1. Standalone `with not_equal` -> MBT2PION_UNSUPPORTED_SYNTAX
  let neg1 = "pub struct S { x : Int }\nimpl Eq for S with not_equal(a, b) { a.x != b.x }\n"
  let r1 = f3d1b_transpile("neg_neq.mbt", neg1)
  assert_true(r1.blockers > 0, "impl Eq with not_equal must block")
  let mut saw_neq1 = false
  for d in r1.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "not_equal") {
      saw_neq1 = true
    }
  }
  assert_true(saw_neq1, "must report MBT2PION_UNSUPPORTED_SYNTAX for not_equal")

  // 2. Split `with equal` + `with not_equal` on same type -> MUST fail-closed (never merged/dropped)
  let neg2 = "pub struct S2 { x : Int }\nimpl Eq for S2 with equal(a, b) { a.x == b.x }\nimpl Eq for S2 with not_equal(a, b) { a.x != b.x }\n"
  let r2 = f3d1b_transpile("neg_split.mbt", neg2)
  assert_true(r2.blockers > 0, "split equal + not_equal must block")
  let mut saw_neq2 = false
  for d in r2.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "not_equal") {
      saw_neq2 = true
    }
  }
  assert_true(saw_neq2, "split not_equal must report MBT2PION_UNSUPPORTED_SYNTAX")

  // 3. Closure field in `#derive(Eq)` emits `#derive(Eq)` directly (never masked by `__mbt_eq_*`),
  //    so Pion's FINAL_CHECK rejects it fail-closed at declaration time.
  let neg3 = "#derive(Eq)\npub struct HasCb { cb : () -> Unit }\n"
  let r3 = f3d1b_transpile("neg_cb.mbt", neg3)
  let out3 = f3d1b_all_out(r3)
  assert_true(str_has(out3, "#derive(Eq)\npub struct HasCb") && !str_has(out3, "__mbt_eq_"), "closure #derive(Eq) emits native #derive(Eq) for Pion FINAL_CHECK rejection: " + out3)

  // 4. Anti-hijacking: local `trait Eq` uses ordinary user-trait lowering, not built-in `Eq`
  let hijack_src = "pub trait Eq {\n  check(Self, Self) -> Bool\n}\n" +
  "pub struct LocalT { x : Int }\n" +
  "impl Eq for LocalT with check(a, b) { a.x == b.x }\n" +
  "impl[T] Eq for Array[T] with check(a, b) { true }\n"
  let r4 = f3d1b_transpile("hijack.mbt", hijack_src)
  let out4 = f3d1b_all_out(r4)
  assert_true(str_has(out4, "impl Eq for LocalT {\n  fn check(a : LocalT, b : LocalT) -> Bool"), "local trait Eq uses normal trait path: " + out4)
  let mut saw_gen_user_eq = false
  for d in r4.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "generic `impl[...]`") {
      saw_gen_user_eq = true
    }
  }
  assert_true(saw_gen_user_eq, "generic impl[...] for user-declared trait Eq stays fail-closed")
}

test "F3d1b-4: R2 forward-declared Bytes/Json/enum chains, generic BytesBox, Hash+impl Eq MapKey, and Self" {
  // 1. Top-down forward-declared Bytes & Json chains + enum chain
  let src = "#derive(Eq)\npub(all) struct Outer { m : Mid }\n" +
  "#derive(Eq)\npub(all) struct Mid { l : Leaf }\n" +
  "#derive(Eq)\npub(all) struct Leaf { data : Bytes }\n\n" +
  "#derive(Eq)\npub(all) struct OuterJ { m : MidJ }\n" +
  "#derive(Eq)\npub(all) struct MidJ { l : LeafJ }\n" +
  "#derive(Eq)\npub(all) struct LeafJ { j : Json }\n\n" +
  "#derive(Eq)\npub(all) struct OuterE { inner : InnerE; n : Int }\n" +
  "#derive(Eq)\npub(all) enum InnerE { Raw(Bytes); Num(Int) }\n\n" +
  "#derive(Eq)\npriv struct BytesBox[T] { v : T; data : Bytes }\n\n" +
  "#derive(Hash)\npub(all) struct HashKey { id : Int }\n" +
  "pub impl Eq for HashKey with equal(a : Self, b : Self) -> Bool { a.id == b.id }\n"
  let res = f3d1b_transpile("r2_eq.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "#derive(Eq)\npub struct Outer"), "Outer gets native #derive(Eq): " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct Mid"), "Mid gets native #derive(Eq): " + out)
  assert_true(str_has(out, "pub impl Eq for Leaf {\n  fn equal(self : Leaf, other : Leaf) -> Bool"), "Leaf with Bytes gets native pub impl Eq: " + out)
  assert_true(str_has(out, "#derive(Eq)\npub struct LeafJ"), "LeafJ with Json gets native #derive(Eq): " + out)
  assert_true(str_has(out, "pub impl Eq for InnerE {\n  fn equal(self : InnerE, other : InnerE) -> Bool"), "InnerE enum with Bytes gets native pub impl Eq: " + out)
  assert_true(str_has(out, "impl[T : Eq] Eq for BytesBox[T] {\n  fn equal(self : BytesBox[T], other : BytesBox[T]) -> Bool"), "private generic BytesBox[T] gets private impl[T : Eq] Eq: " + out)
  assert_true(!str_has(out, "__mbt_eq_"), "zero legacy __mbt_eq_* helpers emitted: " + out)
  assert_true(str_has(out, "impl mbt_compat::MapKey for HashKey"), "#derive(Hash) + pub impl Eq synthesizes MapKey: " + out)
  assert_true(str_has(out, "pub impl Eq for HashKey {\n  fn equal(a : HashKey, b : HashKey) -> Bool"), "Self parameter types normalized to HashKey: " + out)
}

test "F3d1b-5: R3 recursive derive(Eq) -> impl Eq, single-eval array/tuple gen_eq_expr, and with fn equal/not_equal" {
  let src = "#derive(Eq)\npub(all) enum MdInline {\n  Text(String)\n  Bold(Array[MdInline])\n}\n\n" +
  "#derive(Eq)\npub(all) struct MdItem {\n  task : Bool?\n  blocks : Array[MdBlock]\n}\n\n" +
  "#derive(Eq)\npub(all) enum MdBlock {\n  Para(Array[MdInline])\n  List(Array[MdItem])\n  Rule\n}\n\n" +
  "#derive(Eq)\npub(all) enum Tree[T] {\n  Leaf(T)\n  Node(Array[Tree[T]])\n}\n\n" +
  "#derive(Eq)\npub(all) struct MutWrap[T] {\n  tag : T\n  data : Bytes\n  pair : (Int, Bytes)\n  mut v : Array[Int]\n}\n\n" +
  "#derive(Hash)\npub(all) struct FnEqKey {\n  id : Int\n}\n" +
  "pub impl Eq for FnEqKey with fn equal(a, b) {\n  a.id == b.id\n}\n"
  let res = f3d1b_transpile("r3_eq.mbt", src)
  let out = f3d1b_all_out(res)
  assert_eq(res.blockers, 0)
  assert_true(str_has(out, "pub impl Eq for MdInline {\n  fn equal(self : MdInline, other : MdInline) -> Bool"), "self-recursive MdInline emits explicit pub impl Eq: " + out)
  assert_true(str_has(out, "pub impl Eq for MdItem {\n  fn equal(self : MdItem, other : MdItem) -> Bool"), "mutually-recursive MdItem emits explicit pub impl Eq: " + out)
  assert_true(str_has(out, "pub impl Eq for MdBlock {\n  fn equal(self : MdBlock, other : MdBlock) -> Bool"), "mutually-recursive MdBlock emits explicit pub impl Eq: " + out)
  assert_true(str_has(out, "pub impl[T : Eq] Eq for Tree[T] {\n  fn equal(self : Tree[T], other : Tree[T]) -> Bool"), "generic recursive Tree[T] emits explicit pub impl[T : Eq] Eq: " + out)
  assert_true(str_has(out, "let __aa_") && str_has(out, "let __ab_") && str_has(out, "let __al_"), "Array eq binds lhs/rhs/len once: " + out)
  assert_true(str_has(out, "let __ta_") && str_has(out, "let __tb_"), "Tuple eq binds lhs/rhs once: " + out)
  assert_true(str_has(out, "let __bl_"), "Bytes eq binds len once: " + out)
  assert_true(str_has(out, "impl mbt_compat::MapKey for FnEqKey"), "#derive(Hash) + with fn equal synthesizes MapKey: " + out)
  assert_true(str_has(out, "pub impl Eq for FnEqKey {\n  fn equal(a : FnEqKey, b : FnEqKey) -> Bool"), "with fn equal lowered to built-in impl Eq: " + out)

  // Negative: `with fn not_equal` must fail closed with MBT2PION_UNSUPPORTED_SYNTAX
  let neg = "pub struct BadFnNeq { x : Int }\nimpl Eq for BadFnNeq with fn not_equal(a, b) { a.x != b.x }\n"
  let rneg = f3d1b_transpile("neg_fn_neq.mbt", neg)
  assert_true(rneg.blockers > 0, "with fn not_equal must block")
  let mut saw_fn_neq = false
  for d in rneg.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "not_equal") {
      saw_fn_neq = true
    }
  }
  assert_true(saw_fn_neq, "with fn not_equal must report MBT2PION_UNSUPPORTED_SYNTAX")
}

test "F3d1b-6: recursive #derive(Eq) through single-file, cross-file, and chained type aliases" {
  // 1. Single-file self-recursive enum via type alias + forward & reverse chained aliases
  let single = "type Kids = Array[AliasTree]\n" +
  "#derive(Eq)\npriv enum AliasTree { Leaf(Int); Branch(Kids) }\n\n" +
  "type MidWrap = Array[ChainNode]\n" +
  "type OuterWrap = MidWrap\n" +
  "#derive(Eq)\npub(all) enum ChainNode { End(Int); Next(OuterWrap) }\n\n" +
  "type FwdKids = FwdMid\n" +
  "type FwdMid = Array[FwdTree]\n" +
  "#derive(Eq)\npriv enum FwdTree { FLeaf(Int); FBranch(FwdKids) }\n"
  let r1 = f3d1b_transpile("alias_single.mbt", single)
  let o1 = f3d1b_all_out(r1)
  assert_eq(r1.blockers, 0)
  assert_true(str_has(o1, "impl Eq for AliasTree {\n  fn equal(self : AliasTree, other : AliasTree) -> Bool"), "single-file alias recursion emits explicit impl Eq: " + o1)
  assert_true(!str_has(o1, "#derive(Eq)\nenum AliasTree"), "AliasTree must not emit #derive(Eq): " + o1)
  assert_true(str_has(o1, "pub impl Eq for ChainNode {\n  fn equal(self : ChainNode, other : ChainNode) -> Bool"), "reverse chained alias recursion emits explicit pub impl Eq: " + o1)
  assert_true(str_has(o1, "Next(Array[ChainNode])") && !str_has(o1, "Next(MidWrap)"), "reverse chained alias fully expands to Array[ChainNode]: " + o1)
  assert_true(!str_has(o1, "#derive(Eq)\npub enum ChainNode"), "ChainNode must not emit #derive(Eq): " + o1)
  assert_true(str_has(o1, "impl Eq for FwdTree {\n  fn equal(self : FwdTree, other : FwdTree) -> Bool"), "forward chained alias recursion emits explicit impl Eq: " + o1)
  assert_true(str_has(o1, "FBranch(Array[FwdTree])") && !str_has(o1, "FBranch(FwdMid)"), "forward chained alias fully expands to Array[FwdTree]: " + o1)
  assert_true(!str_has(o1, "#derive(Eq)\nenum FwdTree"), "FwdTree must not emit #derive(Eq): " + o1)

  // 2. Cross-file mutual recursion through type alias: A.More(Kids), type Kids = Array[B], B { a : A }
  let files : Array[SourceFile] = [
    SourceFile::{ rel_path: "file_a.mbt", content: "#derive(Eq)\npub(all) enum A { Done; More(CrossKids) }\n", is_test: false },
    SourceFile::{ rel_path: "file_alias.mbt", content: "pub type CrossKids = Array[B]\n", is_test: false },
    SourceFile::{ rel_path: "file_b.mbt", content: "#derive(Eq)\npub(all) struct B { a : A }\n", is_test: false },
  ]
  let r2 = transpile_package(files, empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let o2 = f3d1b_all_out(r2)
  assert_eq(r2.blockers, 0)
  assert_true(str_has(o2, "pub impl Eq for A {\n  fn equal(self : A, other : A) -> Bool"), "cross-file alias mutual recursion A emits pub impl Eq: " + o2)
  assert_true(str_has(o2, "pub impl Eq for B {\n  fn equal(self : B, other : B) -> Bool"), "cross-file alias mutual recursion B emits pub impl Eq: " + o2)
  assert_true(!str_has(o2, "#derive(Eq)\npub enum A") && !str_has(o2, "#derive(Eq)\npub struct B"), "A and B must not emit #derive(Eq): " + o2)
}
