///| Unit tests for `FixedArray[T]` `#borrow(...)` C-ABI FFI bridging under `--ffi-shim-prefix`.

test "lower_ffi: borrowed FixedArray[T] lowers all 5 supported element types with in-out copy-back" {
  let used : Map[String, Bool] = Map()
  let r_draw = try_lower_extern_c_fn(
    "pub ",
    "ffi_draw_timed",
    "inst : FixedArray[Double], count : Int, r : Double, g : Double, b : Double, out : FixedArray[Double]",
    " -> Unit",
    "\"mb_render_draw_timed\"",
    ["#borrow(inst, out)"],
    used,
  )
  assert_true(r_draw.ok && r_draw.needs_bridge, "FixedArray[Double] bridge must succeed")
  assert_true(
    str_has(
      r_draw.code,
      "extern \"C\" fn __mbt_c_ffi_ffi_draw_timed(inst_ptr : Ptr, inst_len : Int, count : Int, r : Double, g : Double, b : Double, out_ptr : Ptr, out_len : Int) -> Unit = \"pion_mb_render_draw_timed\"",
    ),
    "FixedArray[Double] C prototype must pass (Ptr, Int) pairs with shim prefix",
  )
  assert_true(
    str_has(r_draw.code, "mbt_compat::mbt_ffi_fixed_array_double_to_ptr(inst)") &&
    str_has(r_draw.code, "mbt_compat::mbt_ffi_fixed_array_double_from_ptr(inst, __ffi_inst_buf)") &&
    str_has(r_draw.code, "mbt_compat::mbt_ffi_fixed_array_double_to_ptr(out)") &&
    str_has(r_draw.code, "mbt_compat::mbt_ffi_fixed_array_double_from_ptr(out, __ffi_out_buf)"),
    "FixedArray[Double] wrapper must copy-in and copy-back both arrays",
  )

  let r_byte = try_lower_extern_c_fn(
    "",
    "ffi_glyph_picture",
    "key : Int, out : FixedArray[Byte]",
    " -> Int",
    "\"mb_host_glyph_picture\"",
    ["#borrow(out)"],
    used,
  )
  assert_true(r_byte.ok && r_byte.needs_bridge, "FixedArray[Byte] bridge must succeed")
  assert_true(
    str_has(r_byte.code, "mbt_compat::mbt_ffi_fixed_array_byte_to_ptr(out)") &&
    str_has(r_byte.code, "mbt_compat::mbt_ffi_fixed_array_byte_from_ptr(out, __ffi_out_buf)") &&
    str_has(r_byte.code, "let __ffi_res = __mbt_c_ffi_ffi_glyph_picture("),
    "FixedArray[Byte] wrapper must capture return value before copy-back and free",
  )

  let r_int = try_lower_extern_c_fn(
    "",
    "ffi_glyphs_ahead",
    "keys : FixedArray[Int], n : Int",
    " -> Unit",
    "\"mb_host_glyphs_ahead\"",
    ["#borrow(keys)"],
    used,
  )
  assert_true(r_int.ok && r_int.needs_bridge, "FixedArray[Int] bridge must succeed")
  assert_true(
    str_has(r_int.code, "mbt_compat::mbt_ffi_fixed_array_int_to_ptr(keys)") &&
    str_has(r_int.code, "mbt_compat::mbt_ffi_fixed_array_int_from_ptr(keys, __ffi_keys_buf)"),
    "FixedArray[Int] wrapper must use int helpers",
  )

  let r_f32 = try_lower_extern_c_fn(
    "",
    "ffi_vec_f32",
    "a : FixedArray[Float], b : FixedArray[Float32]",
    " -> Float",
    "\"c_vec_f32\"",
    ["#borrow(a, b)"],
    used,
  )
  assert_true(r_f32.ok && r_f32.needs_bridge, "FixedArray[Float] and FixedArray[Float32] bridge must succeed")
  assert_true(
    str_has(r_f32.code, "mbt_compat::mbt_ffi_fixed_array_float_to_ptr(a)") &&
    str_has(r_f32.code, "mbt_compat::mbt_ffi_fixed_array_float_to_ptr(b)") &&
    str_has(r_f32.code, "mbt_compat::mbt_ffi_fixed_array_float_from_ptr(a, __ffi_a_buf)") &&
    str_has(r_f32.code, "mbt_compat::mbt_ffi_fixed_array_float_from_ptr(b, __ffi_b_buf)"),
    "FixedArray[Float] and FixedArray[Float32] must use float helpers",
  )

  let r_i64 = try_lower_extern_c_fn(
    "",
    "ffi_timestamps",
    "ts : FixedArray[Int64]",
    " -> Int64",
    "\"c_timestamps\"",
    ["#borrow(ts)"],
    used,
  )
  assert_true(r_i64.ok && r_i64.needs_bridge, "FixedArray[Int64] bridge must succeed")
  assert_true(
    str_has(r_i64.code, "mbt_compat::mbt_ffi_fixed_array_int64_to_ptr(ts)") &&
    str_has(r_i64.code, "mbt_compat::mbt_ffi_fixed_array_int64_from_ptr(ts, __ffi_ts_buf)"),
    "FixedArray[Int64] wrapper must use int64 helpers",
  )
}

test "lower_ffi: mixed String + Bytes + FixedArray params with Bytes return preserves cleanup order" {
  let used : Map[String, Bool] = Map()
  let r = try_lower_extern_c_fn(
    "pub ",
    "ffi_mixed",
    "label : String, raw : Bytes, pts : FixedArray[Double], flags : FixedArray[Byte]",
    " -> Bytes",
    "\"c_mixed\"",
    ["#borrow(label, raw, pts, flags)"],
    used,
  )
  assert_true(r.ok && r.needs_bridge, "mixed bridged FFI must succeed")
  assert_true(
    str_has(
      r.code,
      "extern \"C\" fn __mbt_c_ffi_ffi_mixed(label_ptr : Ptr, label_len : Int, raw_ptr : Ptr, raw_len : Int, pts_ptr : Ptr, pts_len : Int, flags_ptr : Ptr, flags_len : Int, __out_len : Ptr) -> Ptr = \"pion_c_mixed\"",
    ),
    "mixed C extern signature mismatch",
  )
  assert_true(
    str_has(r.code, "if !mbt_compat::mbt_ffi_ptr_is_null(__ffi_pts_buf)") &&
    str_has(r.code, "if !mbt_compat::mbt_ffi_ptr_is_null(__ffi_flags_buf)") &&
    str_has(r.code, "mbt_compat::mbt_ffi_bytes_from_ptr("),
    "mixed wrapper must guard NULL buffers and build Bytes return before freeing",
  )
}

test "lower_ffi: fail-closed on unannotated, owned, unsupported element, or returned FixedArray" {
  let used : Map[String, Bool] = Map()

  let unannotated = try_lower_extern_c_fn(
    "",
    "bad_unann",
    "xs : FixedArray[Double]",
    " -> Unit",
    "\"c_bad_unann\"",
    [],
    used,
  )
  assert_true(!unannotated.ok, "unannotated FixedArray param must fail closed")

  let owned = try_lower_extern_c_fn(
    "",
    "bad_owned",
    "xs : FixedArray[Int]",
    " -> Unit",
    "\"c_bad_owned\"",
    ["#owned(xs)"],
    used,
  )
  assert_true(!owned.ok, "#owned FixedArray param must fail closed")

  let bad_elem_str = try_lower_extern_c_fn(
    "",
    "bad_elem_str",
    "xs : FixedArray[String]",
    " -> Unit",
    "\"c_bad_elem_str\"",
    ["#borrow(xs)"],
    used,
  )
  assert_true(!bad_elem_str.ok, "FixedArray[String] param must fail closed")

  let bad_elem_struct = try_lower_extern_c_fn(
    "",
    "bad_elem_struct",
    "xs : FixedArray[Point]",
    " -> Unit",
    "\"c_bad_elem_struct\"",
    ["#borrow(xs)"],
    used,
  )
  assert_true(!bad_elem_struct.ok, "FixedArray[Point] param must fail closed")

  let bad_ret = try_lower_extern_c_fn(
    "",
    "bad_ret",
    "n : Int",
    " -> FixedArray[Double]",
    "\"c_bad_ret\"",
    [],
    used,
  )
  assert_true(!bad_ret.ok, "FixedArray return type must fail closed")
}

test "stage_a_ffi: FixedArray extern C fails closed without prefix and lowers cleanly with prefix" {
  let src = "#borrow(inst, out)\npub extern \"C\" fn ffi_draw_timed(inst : FixedArray[Double], count : Int, r : Double, g : Double, b : Double, out : FixedArray[Double]) -> Unit = \"mb_render_draw_timed\"\n\n#borrow(out)\npub extern \"C\" fn ffi_glyph_picture(key : Int, out : FixedArray[Byte]) -> Int = \"mb_host_glyph_picture\"\n\n#borrow(keys)\npub extern \"C\" fn ffi_glyphs_ahead(keys : FixedArray[Int], n : Int) -> Unit = \"mb_host_glyphs_ahead\"\n"
  let sf = SourceFile::{ rel_path: "fixed_ffi.mbt", content: src, is_test: false }

  let res_def = transpile_package([sf], empty_api_map(), default_recipes(), [], [], default_options(), [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_true(res_def.blockers > 0, "default empty ffi_shim_prefix must block FixedArray extern C")

  let opts_pfx = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "",
    moon_pkg_content: "",
    ffi_shim_prefix: "pion_",
    header: default_header_meta("native"),
  }
  let res_ok = transpile_package([sf], empty_api_map(), default_recipes(), [], [], opts_pfx, [], false, fn(_) {
    "{\"ok\":true,\"diagnostics\":[]}"
  })
  assert_eq(res_ok.blockers, 0)
  assert_eq(res_ok.files.length(), 1)
  let out = res_ok.files[0].content
  assert_true(str_has(out, "import \"mbt_compat\""), "must auto-import mbt_compat for FixedArray FFI bridge")
  assert_true(str_has(out, "\"pion_mb_render_draw_timed\""), "must emit prefixed C symbol for draw_timed")
  assert_true(str_has(out, "\"pion_mb_host_glyph_picture\""), "must emit prefixed C symbol for glyph_picture")
  assert_true(str_has(out, "\"pion_mb_host_glyphs_ahead\""), "must emit prefixed C symbol for glyphs_ahead")
  assert_eq(res_ok.ffi_symbols.length(), 3)
}
