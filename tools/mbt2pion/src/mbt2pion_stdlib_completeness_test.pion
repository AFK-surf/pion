///| Unit tests for stdlib method mappings and Stage A / Stage B lowering completeness.

test "stdlib_completeness: lookup_missing_method_helper covers all added methods" {
  assert_true(lookup_missing_method_helper("String", "unsafe_substring") == Some("mbt_compat::str_unsafe_substring"), "String::unsafe_substring")
  assert_true(lookup_missing_method_helper("String", "escape") == Some("mbt_compat::str_escape"), "String::escape")
  assert_true(lookup_missing_method_helper("String", "replace") == Some("mbt_compat::str_replace"), "String::replace")
  assert_true(lookup_missing_method_helper("String", "trim") == Some("mbt_compat::str_trim"), "String::trim")
  assert_true(lookup_missing_method_helper("Int", "clamp") == Some("mbt_compat::int_clamp"), "Int::clamp")
  assert_true(lookup_missing_method_helper("Double", "clamp") == Some("mbt_compat::double_clamp"), "Double::clamp")
  assert_true(lookup_missing_method_helper("Int", "until") == Some("mbt_compat::int_until"), "Int::until")
  assert_true(lookup_missing_method_helper("Byte", "to_int64") == Some("mbt_compat::byte_to_int64"), "Byte::to_int64")
  assert_true(lookup_missing_method_helper("FixedArray[Int]", "map") == Some("mbt_compat::fixed_array_map"), "FixedArray::map")
  assert_true(lookup_missing_method_helper("FixedArray[Int]", "fold") == Some("mbt_compat::fixed_array_fold"), "FixedArray::fold")
  assert_true(lookup_missing_method_helper("Option[Int]", "filter") == Some("mbt_compat::opt_filter"), "Option::filter")
  assert_true(lookup_missing_method_helper("Option[Int]", "unwrap_or_else") == Some("mbt_compat::opt_unwrap_or_else"), "Option::unwrap_or_else")
  assert_true(lookup_missing_method_helper("Array[Int]", "resize") == Some("mbt_compat::arr_resize"), "Array::resize")
  assert_true(lookup_missing_method_helper("Array[Int]", "unsafe_blit_fixed") == Some("mbt_compat::arr_unsafe_blit_fixed"), "Array::unsafe_blit_fixed")
  assert_true(lookup_missing_method_helper("Array[Int]", "unsafe_pop") == Some("mbt_compat::arr_unsafe_pop"), "Array::unsafe_pop")
  assert_true(lookup_missing_method_helper("Array[Int]", "rev_each") == Some("mbt_compat::arr_rev_each"), "Array::rev_each")
  assert_true(lookup_missing_method_helper("mbt_compat::OrderedMap[String, Int]", "map") == Some("mbt_compat::ordered_map_map"), "OrderedMap::map")
}

test "stdlib_completeness: multiline chained receiver backtracking (B1)" {
  // Single-line `.map(...)` on a multiline leading-`.` chain:
  let lines1 : Array[String] = [
    "  let out = rl",
    "    .rects(a, a + s.length())",
    "    .map(fn(r) { r })",
  ]
  let ok1 = rewrite_method_call_at(lines1, 2, 6, "map", "mbt_compat::arr_map")
  assert_true(ok1, "multiline chain single-line args rewrites")
  assert_true(lines1[0] == "  let out = mbt_compat::arr_map(rl", "line 0 wraps rl")
  assert_true(lines1[1] == "    .rects(a, a + s.length()), fn(r) { r })", "line 1 closes call")
  assert_true(lines1[2] == "", "line 2 cleared")

  // Multiline `.map(\n  fn(r) {\n    r\n  }\n)` on a multiline leading-`.` chain:
  let lines2 : Array[String] = [
    "  let out = rl",
    "    .rects(a, b)",
    "    .map(fn(r) {",
    "      r",
    "    })",
  ]
  let ok2 = rewrite_method_call_at(lines2, 2, 6, "map", "mbt_compat::arr_map")
  assert_true(ok2, "multiline chain multiline args rewrites")
  assert_true(lines2[0] == "  let out = mbt_compat::arr_map(rl", "line 0 wraps rl for multiline args")
  assert_true(lines2[1] == "    .rects(a, b), fn(r) {", "line 1 joins normalized multiline args")
  assert_true(lines2[3] == "    })", "line 3 closes multiline call cleanly without embedded newlines")
  assert_true(lines2[4] == "", "line 4 cleared for multiline args")
  // Multiline `.fold(\n  init=100,\n  fn(a, x) { a - x },\n)` with single-line receiver on preceding line:
  let lines3 : Array[String] = [
    "  let total = fa",
    "    .fold(",
    "      init=100,",
    "      fn(a, x) { a - x },",
    "    )",
  ]
  assert_true(rewrite_method_call_at(lines3, 1, 6, "fold", "mbt_compat::fixed_array_fold"), "single-line recv + multiline fold")
  assert_true(lines3[0] == "  let total = mbt_compat::fixed_array_fold(fa, 100, fn(a, x) { a - x })", "unified multiline fold normalized cleanly")
  assert_true(lines3[1] == "", "dot line cleared")
  assert_true(!str_has(lines3.join("\n"), "init="), "init= stripped across multiline call")

  // Receiver containing `)` inside string literal:
  let lines4 : Array[String] = [
    "  let out = make(\")\")",
    "    .map(fn(x) { x })",
  ]
  assert_true(rewrite_method_call_at(lines4, 1, 6, "map", "mbt_compat::arr_map"), "receiver with ) in string literal")
  assert_true(lines4[0] == "  let out = mbt_compat::arr_map(make(\")\"), fn(x) { x })", "receiver with ) wrapped cleanly")
}

test "stdlib_completeness: fold init= stripping, trailing init= reorder, spaced calls, and ~ shorthand" {
  // Array::fold with init= (multiline and spaces)
  let lf : Array[String] = [
    "  let s = xs.fold(",
    "    init = 0,",
    "    fn(acc, x) { acc + x }",
    "  )",
  ]
  assert_true(rewrite_method_call_at(lf, 0, 14, "fold", "mbt_compat::arr_fold"), "multiline arr_fold")
  assert_true(lf[0] == "  let s = mbt_compat::arr_fold(xs, 0, fn(acc, x) { acc + x })", "arr_fold normalized cleanly")
  assert_true(!str_has(lf.join("\n"), "init"), "init= stripped across multiline call")

  // Trailing init= after callback:
  let lf_tail : Array[String] = ["  let s = xs.fold(fn(acc, x) { acc + x }, init=10)"]
  assert_true(rewrite_method_call_at(lf_tail, 0, 14, "fold", "mbt_compat::arr_fold"), "trailing init= arr_fold")
  assert_true(lf_tail[0] == "  let s = mbt_compat::arr_fold(xs, 10, fn(acc, x) { acc + x })", "trailing init= reordered first")

  // Spaced method call + shorthand `~` + `char_set=` alias:
  let lsp1 : Array[String] = ["  let t = s.__mbt_str_trim (chars~)"]
  assert_true(rewrite_method_call_at(lsp1, 0, 13, "__mbt_str_trim", "mbt_compat::str_trim"), "spaced trim with chars~")
  assert_true(lsp1[0] == "  let t = mbt_compat::str_trim(s, chars=chars)", "spaced trim expanded chars~")

  let lsp2 : Array[String] = ["  let t = s.__mbt_str_trim(char_set=\"x\")"]
  assert_true(rewrite_method_call_at(lsp2, 0, 13, "__mbt_str_trim", "mbt_compat::str_trim"), "trim char_set= alias")
  assert_true(lsp2[0] == "  let t = mbt_compat::str_trim(s, chars=\"x\")", "char_set= rewritten to chars=")

  let lsp3 : Array[String] = ["  let t = s.__mbt_str_replace (old~, new~)"]
  assert_true(rewrite_method_call_at(lsp3, 0, 13, "__mbt_str_replace", "mbt_compat::str_replace"), "spaced replace with old~, new~")
  assert_true(lsp3[0] == "  let t = mbt_compat::str_replace(s, old=old, new=new)", "spaced replace expanded old~, new~")

  // FixedArray::fold single line with init=
  let lfa : Array[String] = ["  let s = fa.fold(init=0, fn(a, x) { a + x })"]
  assert_true(rewrite_method_call_at(lfa, 0, 14, "fold", "mbt_compat::fixed_array_fold"), "fixed_array_fold")
  assert_true(lfa[0] == "  let s = mbt_compat::fixed_array_fold(fa, 0, fn(a, x) { a + x })", "fixed_array_fold init= stripped")

  // String::replace positional -> named old=/new=
  let lr1 : Array[String] = ["  let t = s.replace(\"a\", \"b\")"]
  assert_true(rewrite_method_call_at(lr1, 0, 13, "replace", "mbt_compat::str_replace"), "str_replace positional")
  assert_true(lr1[0] == "  let t = mbt_compat::str_replace(s, old=\"a\", new=\"b\")", "str_replace named normalized")

  // String::replace named preserved
  let lr2 : Array[String] = ["  let t = s.replace(old=\"a\", new=\"b\")"]
  assert_true(rewrite_method_call_at(lr2, 0, 13, "replace", "mbt_compat::str_replace"), "str_replace named")
  assert_true(lr2[0] == "  let t = mbt_compat::str_replace(s, old=\"a\", new=\"b\")", "str_replace named kept")

  // String::replace positional with string literals containing "old="/"new=" (P2-6)
  let lr3 : Array[String] = ["  let t = s.replace(\"old=\", \"new=\")"]
  assert_true(rewrite_method_call_at(lr3, 0, 13, "replace", "mbt_compat::str_replace"), "str_replace literal containing old=")
  assert_true(lr3[0] == "  let t = mbt_compat::str_replace(s, old=\"old=\", new=\"new=\")", "str_replace literal normalized")

  // String::trim positional -> chars= (including literal containing "chars=")
  let lt1 : Array[String] = ["  let t = s.trim(\"x\")"]
  assert_true(rewrite_method_call_at(lt1, 0, 13, "trim", "mbt_compat::str_trim"), "str_trim positional")
  assert_true(lt1[0] == "  let t = mbt_compat::str_trim(s, chars=\"x\")", "str_trim chars= normalized")
  let lt2 : Array[String] = ["  let t = s.trim(\"chars=\")"]
  assert_true(rewrite_method_call_at(lt2, 0, 13, "trim", "mbt_compat::str_trim"), "str_trim literal containing chars=")
  assert_true(lt2[0] == "  let t = mbt_compat::str_trim(s, chars=\"chars=\")", "str_trim literal normalized")
}

test "stdlib_completeness: Stage B non-String trim/replace restore and fail-closed guard (P1-5)" {
  // 1. Non-String receiver with trivia before `(`: `foo.__mbt_str_trim (x)` -> `foo.trim (x)` (never `foo.trim((x)`),
  //    and `foo.__mbt_str_replace(old=a, new=b)` -> `foo.replace(old=a, new=b)`.
  let files_r : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "custom.pion",
      source_file: "custom.mbt",
      content: "fn f(foo : Custom) -> Unit {\n  foo.__mbt_str_trim (1)\n  foo.__mbt_str_replace(old=1, new=2)\n}\n",
      anchors: [],
    },
  ]
  let mut round_r = 0
  let check_r = fn(_fs : Array[(String, String)]) -> String {
    round_r = round_r + 1
    if round_r == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"custom.pion\",\"line\":2,\"col\":7,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `__mbt_str_trim` on type `Custom`\",\"expected\":\"method\",\"found\":\"__mbt_str_trim\"},{\"file\":\"custom.pion\",\"line\":3,\"col\":7,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `__mbt_str_replace` on type `Custom`\",\"expected\":\"method\",\"found\":\"__mbt_str_replace\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_r : Array[Diag] = []
  let drift_r : Array[DriftEntry] = []
  let (out_r, _, _) = run_stage_b(files_r, empty_api_map(), check_r, diags_r, drift_r)
  assert_true(str_has(out_r[0].content, "foo.trim (1)") && !str_has(out_r[0].content, "foo.trim(("), "non-String __mbt_str_trim restores with trivia intact")
  assert_true(str_has(out_r[0].content, "foo.replace(old=1, new=2)"), "non-String __mbt_str_replace restores")

  // 2. Fail-closed guard: `unknown named argument` on user-defined `UserType::replace` / `UserType::trim`
  //    MUST NOT be hijacked to `mbt_compat::str_replace` / `mbt_compat::str_trim`.
  let files_neg : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "neg.pion",
      source_file: "neg.mbt",
      content: "fn f(u : UserType) -> Unit {\n  u.replace(old=\"a\", new=\"b\")\n  u.trim(chars=\"x\")\n}\n",
      anchors: [],
    },
  ]
  let check_neg = fn(_fs : Array[(String, String)]) -> String {
    "{\"ok\":false,\"diagnostics\":[{\"file\":\"neg.pion\",\"line\":2,\"col\":13,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown named argument `old` in call to `UserType::replace`\",\"expected\":\"valid named parameter\",\"found\":\"old\"},{\"file\":\"neg.pion\",\"line\":3,\"col\":10,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown named argument `chars` in call to `UserType::trim`\",\"expected\":\"valid named parameter\",\"found\":\"chars\"}]}"
  }
  let diags_neg : Array[Diag] = []
  let drift_neg : Array[DriftEntry] = []
  let (out_neg, _, _) = run_stage_b(files_neg, empty_api_map(), check_neg, diags_neg, drift_neg)
  assert_true(!str_has(out_neg[0].content, "mbt_compat::str_replace"), "UserType::replace not hijacked")
  assert_true(!str_has(out_neg[0].content, "mbt_compat::str_trim"), "UserType::trim not hijacked")
}

test "stdlib_completeness: @env.get_env_var fail-closed without api-map and lowers with api-map (A4)" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  let opts = TranspileOptions::{
    target: "native",
    mode: "publish",
    with_tests: false,
    src_prefix: "envdemo",
    moon_pkg_content: "import {\n  \"moonbitlang/core/env\",\n}\n",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "main.mbt",
    content: "pub fn read_home() -> String? {\n  @env.get_env_var(\"HOME\")\n}\n",
    is_test: false,
  }
  // 1. Without --api-map: fail-closed with MBT2PION_UNSUPPORTED_SYNTAX blocker
  let res_unmapped = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res_unmapped.blockers > 0, "@env.get_env_var without --api-map fails closed in publish mode")
  let mut has_env_blocker = false
  for d in res_unmapped.diagnostics {
    if d.code == "MBT2PION_UNSUPPORTED_SYNTAX" && str_has(d.message, "--api-map") {
      has_env_blocker = true
    }
  }
  assert_true(has_env_blocker, "emits MBT2PION_UNSUPPORTED_SYNTAX mentioning --api-map")

  // 2. With explicit --api-map: lowers to mapped host capability and filters core/env import
  let api_map = ApiMap::{
    symbols: [
      ApiSymbol::{
        src_pkg: "env",
        src_name: "get_env_var",
        kind: "fn",
        target_pkg: "host_env",
        target_name: "read_var",
        target_enum: "",
        arity: 1,
        params: [],
        ret_ty: "Option[String]",
        ret_unit: "",
        ret_map_boundary: "",
        autofill_loc: false,
        external_tilde_default: false,
      },
    ],
    pkg_aliases: Map(),
  }
  let res_mapped = transpile_package([src], api_map, default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res_mapped.blockers == 0, "@env.get_env_var with --api-map transpiles cleanly")
  let mut out = ""
  for f in res_mapped.files {
    if f.rel_path == "main.pion" {
      out = f.content
    }
  }
  assert_true(str_has(out, "host_env::read_var(\"HOME\")"), "lowers @env.get_env_var via --api-map")
  assert_true(!str_has(out, "import \"env\""), "filters out moonbitlang/core/env import")
}

test "stdlib_completeness: Stage B multiline normalize_helper_args and interpolated receiver" {
  // 1. Multiline Array::fold with trailing init=
  let ml_fold : Array[String] = [
    "  let n = xs.fold(",
    "    fn(acc, x) { acc + x },",
    "    init=10,",
    "  )",
  ]
  assert_true(rewrite_method_call_at(ml_fold, 0, 14, "fold", "mbt_compat::arr_fold"), "multiline arr_fold trailing init")
  let ml_fold_joined = ml_fold.join("\n")
  assert_true(str_has(ml_fold_joined, "mbt_compat::arr_fold(xs, 10, fn(acc, x) { acc + x })"), "multiline arr_fold reordered init before closure")

  // 2. Multiline FixedArray::fold with trailing init~
  let ml_fa : Array[String] = [
    "  let n = fa.fold(",
    "    fn(acc, x) { acc + x },",
    "    init~,",
    "  )",
  ]
  assert_true(rewrite_method_call_at(ml_fa, 0, 14, "fold", "mbt_compat::fixed_array_fold"), "multiline fixed_array_fold trailing init~")
  let ml_fa_joined = ml_fa.join("\n")
  assert_true(str_has(ml_fa_joined, "mbt_compat::fixed_array_fold(fa, init, fn(acc, x) { acc + x })"), "multiline fixed_array_fold expanded init~ before closure")

  // 3. Multiline String::trim with char_set=
  let ml_trim : Array[String] = [
    "  let t = s.trim(",
    "    char_set=\"x\",",
    "  )",
  ]
  assert_true(rewrite_method_call_at(ml_trim, 0, 13, "trim", "mbt_compat::str_trim"), "multiline str_trim char_set=")
  assert_true(str_has(ml_trim.join("\n"), "mbt_compat::str_trim(s, chars=\"x\")"), "multiline str_trim normalized char_set= to chars=")

  // 4. Multiline String::replace with old~ and new~
  let ml_rep : Array[String] = [
    "  let t = s.replace(",
    "    old~,",
    "    new~,",
    "  )",
  ]
  assert_true(rewrite_method_call_at(ml_rep, 0, 13, "replace", "mbt_compat::str_replace"), "multiline str_replace shorthand")
  assert_true(str_has(ml_rep.join("\n"), "mbt_compat::str_replace(s, old=old, new=new)"), "multiline str_replace expanded old~ and new~")

  // 5. Receiver containing interpolated string with inner quote/paren: name("\{")"}").map(fn(x) { x + 1 })
  let interp_recv : Array[String] = ["  let ys = name(\"\\{\")\"}\").map(fn(x) { x + 1 })"]
  assert_true(rewrite_method_call_at(interp_recv, 0, 27, "map", "mbt_compat::arr_map"), "interpolated string receiver")
  assert_true(
    interp_recv[0] == "  let ys = mbt_compat::arr_map(name(\"\\{\")\"}\"), fn(x) { x + 1 })",
    "interpolated string receiver preserved intact",
  )

  // 6. Multiline fold with comment before trailing init=
  let ml_cmt_fold : Array[String] = [
    "  let n = xs.fold(",
    "    fn(acc, x) { acc + x },",
    "    // Initial value.",
    "    init=10,",
    "  )",
  ]
  assert_true(rewrite_method_call_at(ml_cmt_fold, 0, 14, "fold", "mbt_compat::arr_fold"), "multiline fold with comment before init=")
  assert_true(
    ml_cmt_fold[0] == "  let n = mbt_compat::arr_fold(xs, 10, fn(acc, x) { acc + x })",
    "multiline fold strips comment and reorders init=",
  )

  // 7. Multiline trim with trailing comment before closing ) and chained .to_owned()
  let ml_cmt_trim : Array[String] = [
    "  let t = s.trim(",
    "    char_set=\"x\", // Trailing comment.",
    "  ).to_owned()",
  ]
  assert_true(rewrite_method_call_at(ml_cmt_trim, 0, 13, "trim", "mbt_compat::str_trim"), "multiline trim with trailing comment")
  assert_true(
    ml_cmt_trim[0] == "  let t = mbt_compat::str_trim(s, chars=\"x\").to_owned()",
    "trailing comment does not swallow ).to_owned()",
  )

  // 8. Argument containing char literal paren '('
  let chr_paren : Array[String] = [
    "  let n = xs.fold(fn(a, c) { if c == '(' { a + 1 } else { a } }, init=0)",
  ]
  assert_true(rewrite_method_call_at(chr_paren, 0, 14, "fold", "mbt_compat::arr_fold"), "fold arg with '(' char literal")
  assert_true(
    chr_paren[0] == "  let n = mbt_compat::arr_fold(xs, 0, fn(a, c) { if c == '(' { a + 1 } else { a } })",
    "char literal '(' does not break closing paren matching",
  )

  // 9. Newline-chained receiver with trailing line comment before .fold(...)
  let recv_cmt : Array[String] = [
    "  let n = xs // the receiver",
    "    .fold(init=0, fn(a, x) { a + x })",
  ]
  assert_true(rewrite_method_call_at(recv_cmt, 1, 6, "fold", "mbt_compat::arr_fold"), "chained receiver with trailing comment")
  assert_true(
    recv_cmt[0] == "  let n = mbt_compat::arr_fold(xs, 0, fn(a, x) { a + x })",
    "trailing comment excluded from receiver slice",
  )

  // 10. Statement newline boundary before `[1, 2].map(...)` and `([1, 2]).map(...)`:
  //     must NEVER swallow the preceding statement as an index/call callee.
  let stmt_arr : Array[String] = [
    "  let _n = xs.length()",
    "  [1, 2].map(fn(x) { x + 1 })",
  ]
  assert_true(rewrite_method_call_at(stmt_arr, 1, 9, "map", "mbt_compat::arr_map"), "newline-leading array literal receiver")
  assert_true(stmt_arr[0] == "  let _n = xs.length()", "preceding statement untouched for array literal")
  assert_true(stmt_arr[1] == "  mbt_compat::arr_map([1, 2], fn(x) { x + 1 })", "array literal rewritten cleanly")

  let stmt_paren : Array[String] = [
    "  let _n = x",
    "  ([1, 2]).map(fn(v) { v + 1 })",
  ]
  assert_true(rewrite_method_call_at(stmt_paren, 1, 11, "map", "mbt_compat::arr_map"), "newline-leading parenthesized receiver")
  assert_true(stmt_paren[0] == "  let _n = x", "preceding statement untouched for paren receiver")
  assert_true(stmt_paren[1] == "  mbt_compat::arr_map(([1, 2]), fn(v) { v + 1 })", "paren receiver rewritten cleanly")
}

test "stdlib_completeness: bare fn main lowering (B4)" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  let opts = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "entry",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "main.mbt",
    content: "fn main {\n  let mut limit = 1\n  fn walk(k : Int) -> Int {\n    if k < limit { walk(k + 1) } else { k }\n  }\n  limit = 5\n  let _ = walk(0)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res.blockers == 0, "bare fn main transpiles cleanly")
  let mut out = ""
  for f in res.files {
    if f.rel_path == "main.pion" {
      out = f.content
    }
  }
  assert_true(str_has(out, "fn main() -> Unit {"), "bare fn main lowered to fn main() -> Unit")
  assert_true(str_has(out, "mbt_compat::MbtCell::{ v:"), "bare fn main boxes captured let mut via MbtCell")
}

test "stdlib_completeness: Stage B T : Compare method .compare(b) routing" {
  let files_cmp : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "cmp.pion",
      source_file: "cmp.mbt",
      content: "pub fn cmp[T : mbt_compat::MbtCompare](a : T, b : T) -> Int {\n  a.compare(b)\n}\n",
      anchors: [],
    },
  ]
  let mut r_cmp = 0
  let check_cmp = fn(_fs : Array[(String, String)]) -> String {
    r_cmp = r_cmp + 1
    if r_cmp == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"cmp.pion\",\"line\":2,\"col\":4,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `compare` on type `T`\",\"expected\":\"method\",\"found\":\"compare\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_c : Array[Diag] = []
  let drift_c : Array[DriftEntry] = []
  let (out_c, _, _) = run_stage_b(files_cmp, empty_api_map(), check_cmp, diags_c, drift_c)
  assert_true(str_has(out_c[0].content, "mbt_compat::mbt_compare(a, b)"), "T.compare(b) routed to mbt_compat::mbt_compare")
}

test "stdlib_completeness: Show and Compare generic bounds & Compare::compare (B5)" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  let opts = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "bounds",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "lib.mbt",
    content: "pub fn[T : Show] fmt(x : T) -> String {\n  x.to_string()\n}\npub fn[T : Compare] cmp_vals(a : T, b : T) -> Int {\n  Compare::compare(a, b)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res.blockers == 0, "Show/Compare bounds transpile cleanly")
  let mut out = ""
  for f in res.files {
    if f.rel_path == "lib.pion" {
      out = f.content
    }
  }
  assert_true(str_has(out, "T : mbt_compat::MbtShow"), "Show bound lowered to MbtShow")
  assert_true(str_has(out, "T : mbt_compat::MbtCompare"), "Compare bound lowered to MbtCompare")
  assert_true(str_has(out, "mbt_compat::mbt_compare(a, b)"), "Compare::compare lowered to mbt_compat::mbt_compare")
}

test "stdlib_completeness: local closure shadows #callsite(autofill(loc)) top-level fn (B7)" {
  let noop_check = fn(_ : Array[(String, String)]) -> String {
    "{\"ok\":true,\"diagnostics\":[]}"
  }
  let opts = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "shadow",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "lib.mbt",
    content: "#callsite(autofill(loc))\npub fn old(loc~ : SourceLoc) -> String {\n  loc.to_string()\n}\npub fn caller() -> Int {\n  let old = fn() { 42 }\n  old()\n}\npub fn real_call() -> String {\n  old()\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res.blockers == 0, "shadowed autofill transpiles cleanly")
  let mut out = ""
  for f in res.files {
    if f.rel_path == "lib.pion" {
      out = f.content
    }
  }
  // Inside `caller`, `old()` must NOT have `loc=` injected; inside `real_call`, `old(...)` MUST have `loc=`!
  let caller_idx = out.index_of("pub fn caller()")
  let real_idx = out.index_of("pub fn real_call()")
  assert_true(caller_idx >= 0 && real_idx > caller_idx, "both fns emitted")
  let caller_body = out.slice(caller_idx, real_idx)
  let real_body = out.slice(real_idx, out.length())
  assert_true(str_has(caller_body, "old()") && !str_has(caller_body, "loc="), "local closure old() gets no loc=")
  assert_true(str_has(real_body, "loc="), "unshadowed top-level old() still gets loc=")
}

test "stdlib_completeness: Stage B for-in OrderedMap/MbtIter, op_set, and tuple .0 guard (B2, B3, B8)" {
  // 1. B2: `for entry in m` on OrderedMap yields `(K, V)` via `ordered_map_iter_lazy`,
  //    and `for x in it` on MbtIter lowers to pull loop.
  let files_b2 : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "loop.pion",
      source_file: "loop.mbt",
      content: "fn f(m : mbt_compat::OrderedMap[Int, String], it : mbt_compat::MbtIter[Int]) -> Int {\n  let mut s = 0\n  for entry in m {\n    let (k, _v) = entry\n    s = s + k\n  }\n  for k, _v in m {\n    s = s + k\n  }\n  for x in it {\n    s = s + x\n  }\n  s\n}\n",
      anchors: [],
    },
  ]
  let mut round_b2 = 0
  let check_b2 = fn(_fs : Array[(String, String)]) -> String {
    round_b2 = round_b2 + 1
    if round_b2 == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"loop.pion\",\"line\":3,\"col\":16,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"mbt_compat::OrderedMap[Int, String]\"},{\"file\":\"loop.pion\",\"line\":7,\"col\":16,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"mbt_compat::OrderedMap[Int, String]\"},{\"file\":\"loop.pion\",\"line\":10,\"col\":12,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"mbt_compat::MbtIter[Int]\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_b2 : Array[Diag] = []
  let drift_b2 : Array[DriftEntry] = []
  let (out_b2, rounds_b2, _) = run_stage_b(files_b2, empty_api_map(), check_b2, diags_b2, drift_b2)
  assert_true(rounds_b2 > 0, "B2 converged")
  assert_true(str_has(out_b2[0].content, "mbt_compat::ordered_map_iter_lazy(m)"), "for entry in map uses ordered_map_iter_lazy")
  assert_true(str_has(out_b2[0].content, "Some(entry) =>"), "for entry in map binds entry tuple")
  assert_true(str_has(out_b2[0].content, "Some((k, _v)) =>"), "for k, v in map unifies onto ordered_map_iter_lazy")
  assert_true(str_has(out_b2[0].content, "Some(x) =>"), "for x in MbtIter lowers")

  // 2. B3: User type with `op_set` rewrites `g[k] = v` -> `g.op_set(k, v)`; user type WITHOUT `op_set` stays fail-closed.
  let files_b3 : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "idx.pion",
      source_file: "idx.mbt",
      content: "struct Grid { xs : Array[Int] }\nfn Grid::op_set(self : Grid, i : Int, v : Int) -> Unit { self.xs[i] = v }\nstruct NoSet { x : Int }\nfn f(g : Grid, n : NoSet) -> Unit {\n  g[0] = 7\n  n[0] = 7\n}\n",
      anchors: [],
    },
  ]
  let mut round_b3 = 0
  let check_b3 = fn(_fs : Array[(String, String)]) -> String {
    round_b3 = round_b3 + 1
    if round_b3 == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"idx.pion\",\"line\":5,\"col\":3,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"cannot assign to indexed type `Grid`\",\"expected\":\"Array[T]\",\"found\":\"Grid\"},{\"file\":\"idx.pion\",\"line\":6,\"col\":3,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"cannot assign to indexed type `NoSet`\",\"expected\":\"Array[T]\",\"found\":\"NoSet\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_b3 : Array[Diag] = []
  let drift_b3 : Array[DriftEntry] = []
  let (out_b3, _, _) = run_stage_b(files_b3, empty_api_map(), check_b3, diags_b3, drift_b3)
  assert_true(str_has(out_b3[0].content, "g.op_set(0, 7)"), "Grid with op_set rewrites to g.op_set")
  assert_true(str_has(out_b3[0].content, "n[0] = 7") && !str_has(out_b3[0].content, "n.op_set"), "NoSet without op_set stays fail-closed")

  // 3. B8a: `cannot access field \`0\` on \`(Double, Double, Double, Double)\`` MUST NOT rewrite `.0` -> `._0`,
  //    while `struct \`Boxed\` has no field \`0\`` MUST rewrite `.0` -> `._0`.
  let files_b8 : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "tup.pion",
      source_file: "tup.mbt",
      content: "fn f(t : (Double, Double, Double, Double), b : Boxed) -> Double {\n  let a = t.0\n  let c = b.0\n  a + c\n}\n",
      anchors: [],
    },
  ]
  let mut round_b8 = 0
  let check_b8 = fn(_fs : Array[(String, String)]) -> String {
    round_b8 = round_b8 + 1
    if round_b8 == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"tup.pion\",\"line\":2,\"col\":12,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"cannot access field `0` on `(Double, Double, Double, Double)`\",\"expected\":\"struct\",\"found\":\"(Double, Double, Double, Double)\"},{\"file\":\"tup.pion\",\"line\":3,\"col\":12,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"struct `Boxed` has no field `0`\",\"expected\":\"valid field of `Boxed`\",\"found\":\"0\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_b8 : Array[Diag] = []
  let drift_b8 : Array[DriftEntry] = []
  let (out_b8, _, _) = run_stage_b(files_b8, empty_api_map(), check_b8, diags_b8, drift_b8)
  assert_true(str_has(out_b8[0].content, "let a = t.0") && !str_has(out_b8[0].content, "t._0"), "tuple .0 preserved")
  assert_true(str_has(out_b8[0].content, "let c = b._0"), "tuple struct .0 rewritten to ._0")

  // 4. B8b: `o["k"] = Json::boolean(true)` on `Map[String, Json]`
  let opts_j = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "jmap",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src_j = SourceFile::{
    rel_path: "j.mbt",
    content: "pub fn mk() -> Json {\n  let o : Map[String, Json] = {}\n  o[\"k\"] = Json::boolean(true)\n  Json::object(o)\n}\n",
    is_test: false,
  }
  let mut round_j = 0
  let check_j = fn(_fs : Array[(String, String)]) -> String {
    round_j = round_j + 1
    if round_j == 1 {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"j.pion\",\"line\":5,\"col\":3,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"cannot assign to indexed type `mbt_compat::OrderedMap[String, mbt_compat::MbtJson]`\",\"expected\":\"Array[T]\",\"found\":\"mbt_compat::OrderedMap[String, mbt_compat::MbtJson]\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let res_j = transpile_package([src_j], empty_api_map(), default_recipes(), [], [], opts_j, [], false, check_j)
  assert_true(res_j.blockers == 0, "Json::boolean in Map[String, Json] transpiles cleanly")
  let mut out_j = ""
  for f in res_j.files {
    if f.rel_path == "j.pion" {
      out_j = f.content
    }
  }
  assert_true(str_has(out_j, "mbt_compat::MbtJson::boolean(true)"), "Json::boolean(true) lowered cleanly")
}

test "stdlib_completeness: FixedArray[String]::join mapping, RO mutation summary, and chained map.join" {
  assert_true(
    lookup_missing_method_helper("FixedArray[String]", "join") == Some("mbt_compat::fixed_array_join"),
    "FixedArray[String]::join maps to mbt_compat::fixed_array_join",
  )
  assert_true(
    lookup_missing_method_helper("FixedArray[Int]", "join") is None,
    "FixedArray[Int]::join must not map",
  )
  assert_true(
    ms_is_mbt_compat_pure_ro("fixed_array_join"),
    "fixed_array_join must be classified as pure read-only in mutation_summary",
  )

  // Chained `r.map(fn(x) { x.to_string() }).join(", ")` on `FixedArray[Double]`
  let files_fa : Array[GeneratedFile] = [
    GeneratedFile::{
      rel_path: "fa_join.pion",
      source_file: "fa_join.mbt",
      content: "fn fmt_row(r : FixedArray[Double]) -> String {\n  r.map(fn(x) { x.to_string() }).join(\", \")\n}\n",
      anchors: [],
    },
  ]
  let mut round_fa = 0
  let check_fa = fn(fs : Array[(String, String)]) -> String {
    round_fa = round_fa + 1
    let c = fs[0].1
    if str_has(c, "r.map(") {
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"fa_join.pion\",\"line\":2,\"col\":4,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `map` on type `FixedArray[Double]`\"}]}"
    } else if str_has(c, ").join(") {
      let ls = c.split("\n")
      let col = ls[1].index_of(".join(") + 1
      "{\"ok\":false,\"diagnostics\":[{\"file\":\"fa_join.pion\",\"line\":2,\"col\":" + col.to_string() + ",\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `join` on type `FixedArray[String]`\"}]}"
    } else {
      "{\"ok\":true,\"diagnostics\":[]}"
    }
  }
  let diags_fa : Array[Diag] = []
  let drift_fa : Array[DriftEntry] = []
  let (out_fa, _, _) = run_stage_b(files_fa, empty_api_map(), check_fa, diags_fa, drift_fa)
  assert_true(
    str_has(out_fa[0].content, "mbt_compat::fixed_array_join(mbt_compat::fixed_array_map(r, fn(x) { x.to_string() }), \", \")"),
    "chained FixedArray.map(...).join(...) rewritten cleanly:\n" + out_fa[0].content,
  )
}

test "stdlib_completeness: Int64 min/max/clamp and bare function values for Int/Double/Int64" {
  assert_true(lookup_missing_method_helper("Int64", "min") == Some("mbt_compat::int64_min"), "Int64::min")
  assert_true(lookup_missing_method_helper("Int64", "max") == Some("mbt_compat::int64_max"), "Int64::max")
  assert_true(lookup_missing_method_helper("Int64", "clamp") == Some("mbt_compat::int64_clamp"), "Int64::clamp")
  assert_true(
    ms_is_mbt_compat_pure_ro("int64_min") && ms_is_mbt_compat_pure_ro("int64_max") && ms_is_mbt_compat_pure_ro("int64_clamp"),
    "int64_min/max/clamp must be pure read-only in mutation_summary",
  )

  let opts = TranspileOptions::{
    target: "native",
    mode: "audit",
    with_tests: false,
    src_prefix: "bare",
    moon_pkg_content: "",
    ffi_shim_prefix: "",
    header: default_header_meta("native"),
  }
  let src = SourceFile::{
    rel_path: "bare.mbt",
    content: "pub fn demo(x : Int, a : Int64, b : Int64, xs : Array[Int]) -> (Char, Array[Char], Int64, (Int, Int) -> Int, (Double, Double) -> Double, (Int64, Int64) -> Int64) {\n" +
    "  let c = x |> Int::unsafe_to_char\n" +
    "  let cs = xs.map(Int::unsafe_to_char)\n" +
    "  let v = Int64::clamp(Int64::max(a, Int64::min(a, b)), min=0L, max=255L)\n" +
    "  let f1 = Int::min\n" +
    "  let f2 = Double::max\n" +
    "  let f3 = Int64::min\n" +
    "  (c, cs, v, f1, f2, f3)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  assert_true(res.blockers == 0, "bare function values and Int64 static calls transpile with 0 blockers")
  let mut out = ""
  for f in res.files {
    if f.rel_path == "bare.pion" { out = f.content }
  }
  assert_true(str_has(out, "mbt_compat::int_unsafe_to_char"), "Int::unsafe_to_char bare fn:\n" + out)
  assert_true(str_has(out, "mbt_compat::int64_clamp(mbt_compat::int64_max(a, mbt_compat::int64_min(a, b)), min=0L, max=255L)"), "Int64 static calls:\n" + out)
  assert_true(str_has(out, "let f1 = mbt_compat::int_min"), "Int::min bare fn:\n" + out)
  assert_true(str_has(out, "let f2 = mbt_compat::double_max"), "Double::max bare fn:\n" + out)
  assert_true(str_has(out, "let f3 = mbt_compat::int64_min"), "Int64::min bare fn:\n" + out)

  // Local shadowing negative test: local `fn Int::min` must NOT be lowered
  let shadow = SourceFile::{
    rel_path: "shadow.mbt",
    content: "fn Int::min(a : Int, b : Int) -> Int { a }\npub fn use_local() -> (Int, Int) -> Int { Int::min }\n",
    is_test: false,
  }
  let sres = transpile_package([shadow], empty_api_map(), default_recipes(), [], [], opts, [], false, noop_check)
  let mut sout = ""
  for f in sres.files {
    if f.rel_path == "shadow.pion" { sout = f.content }
  }
  assert_true(!str_has(sout, "mbt_compat::int_min"), "local Int::min must not be lowered:\n" + sout)
}
