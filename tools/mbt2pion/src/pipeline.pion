///| End-to-end 3-stage deterministic transpilation pipeline (`mbt2pion`).
///|
///| Orchestrates:
///| 1. Deterministic source file ordering
///| 2. Stage A (symbol prescan, lossless CST lowering, topological `00_init_order.pion`)
///| 3. Declaration-granularity double-hash-anchored Overlays
///| 4. Stage A.5 (type-probe pass with mandatory coverage guard)
///| 5. Stage B (`pionc check --json` type-directed fixpoint pass)
///| 6. Platform-neutral header prepending
///| 7. Hard merge/publish gate checks (0 `MBT2PION_MANUAL`, 0 `mbt_*_probe` residuals,
///|    0 unresolved drift entries, 0 error diagnostics).

///| Collect sorted unique external package prefixes (`<pkg>::`) actually referenced in `content`,
///| ignoring comments, plain string literals, uppercase type/enum namespaces, `self`/`super`, and
///| packages already imported in `content`. Recursively scans `\{...}` inside interpolated strings!
pub fn collect_referenced_packages(content : String) -> Array[String] {
  let tokens = lex_moonbit(content)
  let n = tokens.length() - 1
  let already : Map[String, Bool] = Map()
  let found : Map[String, Bool] = Map()
  let mut i = 0
  while i < n {
    let t = tokens[i]
    if t.kind == TokenKind::Keyword && t.raw == "import" && i + 1 < n && tokens[i + 1].kind == TokenKind::StringLit {
      let raw_s = tokens[i + 1].raw
      if raw_s.length() >= 2 {
        already[raw_s.slice(1, raw_s.length() - 1)] = true
      }
      i = i + 2
      continue
    }
    if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let parts = split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline)
      for p in parts {
        if p.is_expr {
          let inner_pkgs = collect_referenced_packages(p.text)
          for ip in inner_pkgs {
            if !already.contains(ip) {
              found[ip] = true
            }
          }
        }
      }
      i = i + 1
      continue
    }
    if t.kind == TokenKind::Ident && i + 1 < n && tokens[i + 1].kind == TokenKind::ColonColon {
      let prev_dot_or_cc = i > 0 && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)
      let c0 = if t.raw.length() > 0 { t.raw.code_unit_at(0) } else { 0 }
      let is_lower = c0 >= 97 && c0 <= 122
      if !prev_dot_or_cc && is_lower && t.raw != "self" && t.raw != "super" && !already.contains(t.raw) {
        found[t.raw] = true
      }
    }
    i = i + 1
  }
  sorted_map_keys(found)
}

///| Render deterministic `import "<pkg>"` block for a generated `.pion` file.
pub fn render_auto_imports(content : String) -> String {
  let pkgs = collect_referenced_packages(content)
  if pkgs.length() == 0 {
    return ""
  }
  let sb = StringBuilder()
  for pkg in pkgs {
    sb.write_string("import \"" + pkg + "\"\n")
  }
  sb.write_string("\n")
  sb.to_string()
}

///| Prepend platform-neutral headers to every generated file
fn prepend_headers_and_imports(
  gen_files : Array[GeneratedFile],
  opts : TranspileOptions,
  val_probe_sites : Array[ValProbeSite],
  diags : Array[Diag],
) -> Array[GeneratedFile] {
  let final_files : Array[GeneratedFile] = []
  let reg_placeholders_by_file : Map[String, Array[ValProbeSite]] = Map()
  for vps in val_probe_sites {
    let list = match reg_placeholders_by_file.get(vps.file) {
      Some(xs) => xs
      None => {
        let xs : Array[ValProbeSite] = []
        reg_placeholders_by_file[vps.file] = xs
        xs
      }
    }
    list.push(vps)
  }
  for gf in gen_files {
    let hdr = render_platform_neutral_header(opts.header, gf.source_file)
    let imports = render_auto_imports(gf.content)
    let full = hdr + imports + gf.content
    // Hard gate: check for `MBT2PION_MANUAL` markers
    if str_has(full, "MBT2PION_MANUAL") {
      diags.push(diag_error(
        "MBT2PION_MANUAL",
        gf.rel_path,
        1,
        1,
        "unresolved MBT2PION_MANUAL marker in " + gf.rel_path,
      ))
    }
    // Hard gate: check for `mbt_*_probe` residuals
    if has_probe_residual(full) {
      diags.push(diag_error(
        "MBT2PION_PROBE_RESIDUAL",
        gf.rel_path,
        1,
        1,
        "probe residual found in final output of " + gf.rel_path,
      ))
    }
    // Hard gate (Astra v2 P1-3): 100% of tool-registered `.val` placeholder sites MUST be disposed!
    match reg_placeholders_by_file.get(gf.rel_path) {
      Some(sites) => {
        let live_idents = collect_ident_tokens_set(full)
        for vps in sites {
          if live_idents.contains(vps.placeholder_ident) {
            diags.push(diag_error(
              "MBT2PION_UNDISPOSED_PROBE_SITE",
              gf.rel_path,
              vps.line,
              vps.col,
              "undisposed registered `.val` placeholder `" + vps.placeholder_ident + "` (site_id=" + vps.site_id.to_string() + ") remained in final output",
            ))
          }
        }
      }
      None => ()
    }
    final_files.push(GeneratedFile::{
      rel_path: gf.rel_path,
      content: full,
      source_file: gf.source_file,
      anchors: gf.anchors,
    })
  }
  final_files
}

///| Collect all `Ident` token raw names in `content` (ignoring string literals and comments,
///| but recursing into `InterpString` `\{...}` holes) for exact registered-placeholder checking.
fn collect_ident_tokens_set(content : String) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  let toks = lex_moonbit(content)
  let tn = toks.length() - 1
  let mut i = 0
  while i < tn {
    let t = toks[i]
    if t.kind == TokenKind::Ident {
      out[t.raw] = true
    } else if t.kind == TokenKind::InterpString || t.kind == TokenKind::InterpMultiline {
      let parts = split_interp_string(t.raw, t.kind == TokenKind::InterpMultiline)
      for p in parts {
        if p.is_expr {
          let inner = collect_ident_tokens_set(p.text)
          for k in inner.keys() {
            out[k] = true
          }
        }
      }
    }
    i = i + 1
  }
  out
}

///| Split a comma-separated bracket list interior respecting nested `[...]` and `"..."` strings.
fn split_bracket_items(inner : String) -> Array[String] {
  let out : Array[String] = []
  let mut start = 0
  let mut depth = 0
  let mut in_str = false
  let mut esc = false
  let mut i = 0
  while i < inner.length() {
    let c = inner.code_unit_at(i)
    if in_str {
      if esc {
        esc = false
      } else if c == 92 {
        esc = true
      } else if c == 34 {
        in_str = false
      }
    } else if c == 34 {
      in_str = true
    } else if c == 91 {
      depth = depth + 1
    } else if c == 93 {
      if depth > 0 { depth = depth - 1 }
    } else if c == 44 && depth == 0 {
      let piece = inner.slice(start, i).trim()
      if piece.length() > 0 {
        out.push(piece)
      }
      start = i + 1
    }
    i = i + 1
  }
  let tail = inner.slice(start, inner.length()).trim()
  if tail.length() > 0 {
    out.push(tail)
  }
  out
}

///| Structured AST for `moon.pkg` / `moon.pkg.json` target-rule expressions.
pub enum TargetRuleExpr {
  Atom(String)
  List(Array[TargetRuleExpr])
}

///| Format a `TargetRuleExpr` for diagnostics and compatibility display.
pub fn format_target_rule_expr(expr : TargetRuleExpr) -> String {
  match expr {
    TargetRuleExpr::Atom(s) => "\"" + s + "\""
    TargetRuleExpr::List(items) => {
      let parts : Array[String] = []
      for it in items {
        parts.push(format_target_rule_expr(it))
      }
      "[" + join_comma(parts) + "]"
    }
  }
}

///| Parse a structured `TargetRuleExpr` directly from `lex_moonbit` tokens
///| (decodes every string literal escape and rejects malformed syntax fail-closed).
fn parse_target_rule_expr_tokens(tokens : Array[Token], val_i : Int, limit : Int) -> Result[(TargetRuleExpr, Int), String] {
  if val_i >= limit {
    return Err("malformed moon.pkg target rule: unexpected end of expression")
  }
  let tok = tokens[val_i]
  if tok.kind == TokenKind::StringLit {
    match decode_mbt_string_lit(tok.raw) {
      Ok(decoded) => return Ok((TargetRuleExpr::Atom(decoded), val_i + 1))
      Err(e) => return Err("malformed moon.pkg target rule string: " + e)
    }
  }
  if tok.kind == TokenKind::LBracket {
    let rb = find_matching_delim(tokens, val_i)
    if rb >= limit || tokens[rb].kind != TokenKind::RBracket {
      return Err("malformed moon.pkg target rule: unclosed `[`")
    }
    let items : Array[TargetRuleExpr] = []
    let mut k = val_i + 1
    while k < rb {
      if tokens[k].kind == TokenKind::Comma {
        return Err("malformed moon.pkg target rule: empty array item")
      }
      match parse_target_rule_expr_tokens(tokens, k, rb) {
        Err(e) => return Err(e)
        Ok((item_ast, next_k)) => {
          items.push(item_ast)
          k = next_k
        }
      }
      if k < rb {
        if tokens[k].kind == TokenKind::Comma {
          k = k + 1
        } else {
          return Err("malformed moon.pkg target rule: expected `,` in array near `" + tokens[k].raw + "`")
        }
      }
    }
    return Ok((TargetRuleExpr::List(items), rb + 1))
  }
  Err("invalid moon.pkg target rule expression near `" + tok.raw + "`")
}

///| Strictly parse a `{ "file.mbt": <rule_expr>, ... }` targets table from `lex_moonbit` tokens,
///| decoding all filename keys and checking duplicate keys AFTER decoding.
fn parse_targets_table_tokens(
  tokens : Array[Token],
  start : Int,
  limit : Int,
  out : Map[String, TargetRuleExpr],
) -> Result[Int, String] {
  if start >= limit || tokens[start].kind != TokenKind::LBrace {
    return Err("malformed moon.pkg targets table: expected `{ ... }`")
  }
  let rb = find_matching_delim(tokens, start)
  if rb >= limit || tokens[rb].kind != TokenKind::RBrace {
    return Err("malformed moon.pkg targets table: unclosed `{`")
  }
  let mut k = start + 1
  while k < rb {
    if tokens[k].kind != TokenKind::StringLit {
      return Err("malformed moon.pkg targets table: expected quoted filename key near `" + tokens[k].raw + "`")
    }
    let fname = match decode_mbt_string_lit(tokens[k].raw) {
      Ok(s) => s
      Err(e) => return Err("malformed moon.pkg targets filename key: " + e)
    }
    if fname.length() == 0 {
      return Err("malformed moon.pkg targets table: empty filename key")
    }
    k = k + 1
    if k >= rb || tokens[k].kind != TokenKind::Colon {
      return Err("malformed moon.pkg targets table: expected `:` after `" + fname + "`")
    }
    k = k + 1
    match parse_target_rule_expr_tokens(tokens, k, rb) {
      Err(e) => return Err(e)
      Ok((expr_ast, next_k)) => {
        if out.contains(fname) {
          return Err("duplicate target rule for " + fname)
        }
        out[fname] = expr_ast
        k = next_k
      }
    }
    if k < rb {
      if tokens[k].kind == TokenKind::Comma {
        k = k + 1
      } else {
        return Err("malformed moon.pkg targets table: expected `,` or `}` after rule for `" + fname + "`")
      }
    }
  }
  Ok(rb + 1)
}

///| Lexer-backed strict parser for BOTH `moon.pkg.json` (`"targets": { ... }`) AND
///| real MoonBit `moon.pkg` DSL (`options(targets: { ... })`).
///| Decodes JSON/MoonBit string escapes in field names, filenames, and rule atoms,
///| rejects duplicate `targets` fields and duplicate decoded filenames fail-closed.
pub fn parse_moon_pkg_targets_strict(content : String) -> Result[Map[String, TargetRuleExpr], String] {
  let out : Map[String, TargetRuleExpr] = Map()
  let tokens = lex_moonbit(content)
  let n = tokens.length() - 1
  if n <= 0 {
    return Ok(out)
  }
  let mut seen_targets = false
  // 1. JSON manifest (`moon.pkg.json`): root `{ ... }` top-level `"targets": { ... }`
  if tokens[0].kind == TokenKind::LBrace {
    let rb = find_matching_delim(tokens, 0)
    if rb >= n || tokens[rb].kind != TokenKind::RBrace {
      return Err("malformed moon.pkg.json: unclosed top-level `{`")
    }
    let mut k = 1
    while k < rb {
      if tokens[k].kind == TokenKind::Comma {
        k = k + 1
        continue
      }
      if tokens[k].kind == TokenKind::StringLit && k + 1 < rb && tokens[k + 1].kind == TokenKind::Colon {
        let key_decoded = match decode_mbt_string_lit(tokens[k].raw) {
          Ok(s) => s
          Err(e) => return Err("malformed moon.pkg.json key: " + e)
        }
        let val_i = k + 2
        if key_decoded == "targets" {
          if seen_targets {
            return Err("duplicate targets field in moon.pkg")
          }
          seen_targets = true
          match parse_targets_table_tokens(tokens, val_i, rb, out) {
            Err(e) => return Err(e)
            Ok(next_k) => {
              k = next_k
              continue
            }
          }
        }
        // Skip non-targets JSON value at top level
        if val_i < rb && (tokens[val_i].kind == TokenKind::LBrace || tokens[val_i].kind == TokenKind::LBracket || tokens[val_i].kind == TokenKind::LParen) {
          k = find_matching_delim(tokens, val_i) + 1
        } else {
          k = val_i
          while k < rb && tokens[k].kind != TokenKind::Comma {
            if tokens[k].kind == TokenKind::LBrace || tokens[k].kind == TokenKind::LBracket || tokens[k].kind == TokenKind::LParen {
              k = find_matching_delim(tokens, k) + 1
            } else {
              k = k + 1
            }
          }
        }
        continue
      }
      if tokens[k].kind == TokenKind::LBrace || tokens[k].kind == TokenKind::LBracket || tokens[k].kind == TokenKind::LParen {
        k = find_matching_delim(tokens, k) + 1
      } else {
        k = k + 1
      }
    }
    return Ok(out)
  }
  // 2. DSL manifest (`moon.pkg`): top-level `options( ... targets: { ... } ... )`
  let mut k = 0
  while k < n {
    if (tokens[k].kind == TokenKind::Ident || tokens[k].kind == TokenKind::Keyword) &&
    tokens[k].raw == "options" && k + 1 < n && tokens[k + 1].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, k + 1)
      if rp >= n || tokens[rp].kind != TokenKind::RParen {
        return Err("malformed moon.pkg: unclosed `options(...)`")
      }
      let mut j = k + 2
      while j < rp {
        if tokens[j].kind == TokenKind::Comma {
          j = j + 1
          continue
        }
        let mut is_targets_key = false
        if (tokens[j].kind == TokenKind::Ident || tokens[j].kind == TokenKind::Keyword) && tokens[j].raw == "targets" {
          is_targets_key = true
        } else if tokens[j].kind == TokenKind::StringLit && j + 1 < rp && tokens[j + 1].kind == TokenKind::Colon {
          match decode_mbt_string_lit(tokens[j].raw) {
            Ok(s) => if s == "targets" { is_targets_key = true }
            Err(e) => return Err("malformed moon.pkg option key: " + e)
          }
        }
        if is_targets_key && j + 1 < rp && tokens[j + 1].kind == TokenKind::Colon {
          if seen_targets {
            return Err("duplicate targets field in moon.pkg")
          }
          seen_targets = true
          match parse_targets_table_tokens(tokens, j + 2, rp, out) {
            Err(e) => return Err(e)
            Ok(next_j) => {
              j = next_j
              continue
            }
          }
        }
        // Skip non-targets field inside `options(...)`
        if tokens[j].kind == TokenKind::LBrace || tokens[j].kind == TokenKind::LBracket || tokens[j].kind == TokenKind::LParen {
          j = find_matching_delim(tokens, j) + 1
        } else {
          j = j + 1
        }
      }
      k = rp + 1
      continue
    }
    if tokens[k].kind == TokenKind::LBrace || tokens[k].kind == TokenKind::LBracket || tokens[k].kind == TokenKind::LParen {
      k = find_matching_delim(tokens, k) + 1
    } else {
      k = k + 1
    }
  }
  Ok(out)
}

///| Compatibility wrapper returning `Map[String, String]` (empty map on parse error).
pub fn parse_moon_pkg_targets(content : String) -> Map[String, String] {
  let out : Map[String, String] = Map()
  match parse_moon_pkg_targets_strict(content) {
    Ok(m) => {
      for k in m.keys() {
        match m.get(k) {
          Some(ast) => out[k] = format_target_rule_expr(ast)
          None => ()
        }
      }
    }
    Err(_) => ()
  }
  out
}

///| Recursively evaluate a decoded `TargetRuleExpr` AST for `pion_target` (fail-closed:
///| returns `None` on any unknown predicate, empty array, or malformed operator arity).
pub fn eval_target_rule_ast(pion_target : String, expr : TargetRuleExpr) -> Option[Bool] {
  match expr {
    TargetRuleExpr::Atom(v) => {
      if v == "all" {
        return Some(true)
      }
      if v == "native" || v == "wasm" || v == "wasm-gc" || v == "js" || v == "llvm" {
        return Some(v == moon_source_backend_for_target(pion_target))
      }
      None
    }
    TargetRuleExpr::List(items) => {
      if items.length() == 0 {
        return None
      }
      match items[0] {
        TargetRuleExpr::Atom("not") => {
          if items.length() < 2 {
            return None
          }
          let mut any_true = false
          let mut i = 1
          while i < items.length() {
            match eval_target_rule_ast(pion_target, items[i]) {
              None => return None
              Some(true) => any_true = true
              Some(false) => ()
            }
            i = i + 1
          }
          Some(!any_true)
        }
        TargetRuleExpr::Atom("and") => {
          if items.length() < 2 {
            return None
          }
          let mut all_true = true
          let mut i = 1
          while i < items.length() {
            match eval_target_rule_ast(pion_target, items[i]) {
              None => return None
              Some(false) => all_true = false
              Some(true) => ()
            }
            i = i + 1
          }
          Some(all_true)
        }
        TargetRuleExpr::Atom("or") => {
          if items.length() < 2 {
            return None
          }
          let mut any_true = false
          let mut i = 1
          while i < items.length() {
            match eval_target_rule_ast(pion_target, items[i]) {
              None => return None
              Some(true) => any_true = true
              Some(false) => ()
            }
            i = i + 1
          }
          Some(any_true)
        }
        _ => {
          let mut any_true = false
          for item in items {
            match eval_target_rule_ast(pion_target, item) {
              None => return None
              Some(true) => any_true = true
              Some(false) => ()
            }
          }
          Some(any_true)
        }
      }
    }
  }
}

///| Compatibility wrapper: parse `raw_expr` via `lex_moonbit` and evaluate via `eval_target_rule_ast`.
pub fn eval_moon_pkg_target_rule(pion_target : String, raw_expr : String) -> Option[Bool] {
  let tokens = lex_moonbit(raw_expr)
  let n = tokens.length() - 1
  if n <= 0 {
    return None
  }
  match parse_target_rule_expr_tokens(tokens, 0, n) {
    Ok((ast, next_i)) => if next_i == n { eval_target_rule_ast(pion_target, ast) } else { None }
    Err(_) => None
  }
}

///| Compatibility wrapper around `eval_moon_pkg_target_rule` for flat string-array rules.
pub fn target_matches_moon_rules(pion_target : String, rules : Array[String]) -> Bool {
  if rules.length() == 0 {
    return true
  }
  let sb = StringBuilder()
  sb.write_string("[")
  let mut i = 0
  while i < rules.length() {
    if i > 0 { sb.write_string(", ") }
    sb.write_string("\"" + rules[i] + "\"")
    i = i + 1
  }
  sb.write_string("]")
  match eval_moon_pkg_target_rule(pion_target, sb.to_string()) {
    Some(b) => b
    None => false
  }
}

///| Locate the full declaration byte range `[start_byte, end_byte)` in a finalized `.pion` file
///| using the lexer + balanced `{ ... }` brace matching (Astra P1-5 / Round 3 P1-2).
///| Supports `pub`/`pub(all)`/`pub(open)`, leading generics `fn[T]`, qualified names `Widget::value_of`,
///| and non-brace declarations (`let`/`const`/`type`). Takes the already lexed final file, so
///| `finalize_span_map` lexes each file once instead of once per declaration.
fn find_final_decl_span_in_tokens(toks : Array[Token], dkind : String, base_name : String) -> Option[(Int, Int)] {
  let n = toks.length() - 1
  let mut i = 0
  while i < n {
    let t = toks[i]
    if t.kind == TokenKind::Keyword && t.raw == dkind && i + 1 < n {
      let mut name_i = i + 1
      // Skip optional leading generic parameter list `fn[T, U]`
      if dkind == "fn" && name_i < n && toks[name_i].kind == TokenKind::LBracket {
        name_i = find_matching_delim(toks, name_i) + 1
      }
      // Build full qualified declaration name across `Ident`/`UpperIdent` + `::` (e.g. `Widget::value_of`)
      let name_sb = StringBuilder()
      let mut cur_n = name_i
      while cur_n < n && (toks[cur_n].kind == TokenKind::Ident || toks[cur_n].kind == TokenKind::UpperIdent) {
        name_sb.write_string(toks[cur_n].raw)
        cur_n = cur_n + 1
        if cur_n + 1 < n && toks[cur_n].kind == TokenKind::ColonColon &&
        (toks[cur_n + 1].kind == TokenKind::Ident || toks[cur_n + 1].kind == TokenKind::UpperIdent) {
          name_sb.write_string("::")
          cur_n = cur_n + 1
        } else {
          break
        }
      }
      if name_sb.to_string() == base_name {
        // Walk back to include leading `pub`, `pub(all)`, `pub(open)` if immediately preceding
        let mut start_tok = i
        if start_tok > 0 && toks[start_tok - 1].kind == TokenKind::Keyword && toks[start_tok - 1].raw == "pub" {
          start_tok = start_tok - 1
        } else if start_tok >= 4 && toks[start_tok - 1].kind == TokenKind::RParen &&
        toks[start_tok - 3].kind == TokenKind::LParen &&
        toks[start_tok - 4].kind == TokenKind::Keyword && toks[start_tok - 4].raw == "pub" {
          start_tok = start_tok - 4
        }
        if dkind == "let" || dkind == "const" || dkind == "type" {
          // Non-brace declaration: scan to end of balanced expression/line
          let mut end_tok = cur_n
          let mut d = 0
          while end_tok < n {
            let ek = toks[end_tok].kind
            if d == 0 && end_tok > cur_n && toks[end_tok].newline_before {
              break
            }
            if ek == TokenKind::LParen || ek == TokenKind::LBracket || ek == TokenKind::LBrace {
              d = d + 1
            } else if ek == TokenKind::RParen || ek == TokenKind::RBracket || ek == TokenKind::RBrace {
              d = d - 1
            }
            end_tok = end_tok + 1
          }
          let last_tok = if end_tok > start_tok { end_tok - 1 } else { start_tok }
          return Some((toks[start_tok].start_byte, toks[last_tok].end_byte))
        }
        let mut lb = cur_n
        while lb < n && toks[lb].kind != TokenKind::LBrace {
          lb = lb + 1
        }
        if lb < n && toks[lb].kind == TokenKind::LBrace {
          let rb = find_matching_delim(toks, lb)
          return Some((toks[start_tok].start_byte, toks[rb].end_byte))
        }
      }
    }
    i = i + 1
  }
  None
}

///| Recompute final byte/line/col `span_map` entries covering FULL declarations against
///| the final formatted `.pion` files (Astra P1-5).
pub fn finalize_span_map(
  files : Array[GeneratedFile],
  raw_spans : Array[SpanMapEntry],
) -> Array[SpanMapEntry] {
  let out : Array[SpanMapEntry] = []
  let content_by_file : Map[String, String] = Map()
  for gf in files {
    content_by_file[gf.rel_path] = gf.content
  }
  // Each final file is lexed at most once, on its first span (was once per declaration).
  let toks_by_file : Map[String, Array[Token]] = Map()
  for sp in raw_spans {
    match content_by_file.get(sp.out_file) {
      Some(final_txt) => {
        let mut out_start = sp.out_start
        let mut out_end = sp.out_end
        let mut out_line = sp.out_line
        let mut out_col = sp.out_col
        let decl_span = {
          let colon_i = sp.kind.index_of(":")
          if colon_i <= 0 {
            None
          } else {
            let dname = sp.kind.slice(colon_i + 1, sp.kind.length())
            let bi = dname.index_of("[")
            let base_name = if bi > 0 { dname.slice(0, bi) } else { dname }
            let toks = match toks_by_file.get(sp.out_file) {
              Some(ts) => ts
              None => {
                let ts = lex_moonbit(final_txt)
                toks_by_file[sp.out_file] = ts
                ts
              }
            }
            find_final_decl_span_in_tokens(toks, sp.kind.slice(0, colon_i), base_name)
          }
        }
        match decl_span {
          Some((s_b, e_b)) => {
            out_start = s_b
            out_end = e_b
            let (ln, cl) = byte_offset_to_line_col(final_txt, s_b)
            out_line = ln
            out_col = cl
          }
          None => ()
        }
        out.push(SpanMapEntry::{
          src_file: sp.src_file,
          src_start: sp.src_start,
          src_end: sp.src_end,
          src_line: sp.src_line,
          src_col: sp.src_col,
          out_file: sp.out_file,
          out_start: out_start,
          out_end: out_end,
          out_line: out_line,
          out_col: out_col,
          kind: sp.kind,
        })
      }
      None => out.push(sp)
    }
  }
  out
}

fn byte_offset_to_line_col(s : String, off : Int) -> (Int, Int) {
  let mut line = 1
  let mut col = 1
  let lim = if off < s.length() { off } else { s.length() }
  let mut i = 0
  while i < lim {
    if s.code_unit_at(i) == 10 {
      line = line + 1
      col = 1
    } else {
      col = col + 1
    }
    i = i + 1
  }
  (line, col)
}

///| Sort `SourceFile`s deterministically by `rel_path`.
fn sort_source_files(files : Array[SourceFile]) -> Array[SourceFile] {
  let out : Array[SourceFile] = []
  for f in files {
    out.push(f)
  }
  let mut i = 1
  while i < out.length() {
    let key = out[i]
    let mut j = i - 1
    while j >= 0 && str_cmp(out[j].rel_path, key.rel_path) > 0 {
      out[j + 1] = out[j]
      j = j - 1
    }
    out[j + 1] = key
    i = i + 1
  }
  out
}

fn is_valid_sha256_hex(s : String) -> Bool {
  if s.length() != 64 {
    return false
  }
  let mut i = 0
  while i < 64 {
    let c = s.code_unit_at(i)
    let is_hex = (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
    if !is_hex {
      return false
    }
    i = i + 1
  }
  true
}

fn is_valid_asset_rel_path(p : String) -> Bool {
  if p.length() == 0 || p.starts_with("/") || p.starts_with("\\") {
    return false
  }
  let segs = p.split("/")
  for seg in segs {
    if seg == ".." || seg == "." || seg.length() == 0 {
      return false
    }
  }
  true
}

fn is_valid_decl_ident(s : String) -> Bool {
  if s.length() == 0 {
    return false
  }
  let c0 = s.code_unit_at(0)
  let ok0 = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95
  if !ok0 {
    return false
  }
  let mut i = 1
  while i < s.length() {
    let c = s.code_unit_at(i)
    let ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
    if !ok {
      return false
    }
    i = i + 1
  }
  true
}

///| Run the full 3-stage deterministic `mbt2pion` pipeline.
///| `check_fn` invokes `pionc check --json` on a batch of `(rel_path, content)` files.
///| Pass a no-op callback `fn(_) { "{\"ok\":true,\"diagnostics\":[]}" }` when running Stage A standalone in unit tests.
pub fn transpile_package(
  sources : Array[SourceFile],
  api_map : ApiMap,
  recipes : Recipes,
  overlays : Array[OverlaySpec],
  mbti_files : Array[(String, String)],
  opts : TranspileOptions,
  pre_diags : Array[Diag],
  run_probes : Bool,
  check_fn : (Array[(String, String)]) -> String,
) -> TranspileResult {
  transpile_package_ex(sources, api_map, recipes, overlays, mbti_files, [], [], opts, pre_diags, run_probes, check_fn)
}

pub fn transpile_package_ex(
  sources : Array[SourceFile],
  api_map : ApiMap,
  recipes : Recipes,
  overlays : Array[OverlaySpec],
  mbti_files : Array[(String, String)],
  dep_doc_jsons : Array[String],
  asset_bypass_rules : Array[AssetBypassRule],
  opts : TranspileOptions,
  pre_diags : Array[Diag],
  run_probes : Bool,
  check_fn : (Array[(String, String)]) -> String,
) -> TranspileResult {
  transpile_package_with_abis(
    sources,
    api_map,
    recipes,
    overlays,
    mbti_files,
    dep_doc_jsons,
    [],
    asset_bypass_rules,
    opts,
    pre_diags,
    run_probes,
    check_fn,
  )
}

pub fn transpile_package_with_abis(
  sources : Array[SourceFile],
  api_map : ApiMap,
  recipes : Recipes,
  overlays : Array[OverlaySpec],
  mbti_files : Array[(String, String)],
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
  asset_bypass_rules : Array[AssetBypassRule],
  opts : TranspileOptions,
  pre_diags : Array[Diag],
  run_probes : Bool,
  check_fn : (Array[(String, String)]) -> String,
) -> TranspileResult {
  transpile_package_with_abis_and_companions(
    sources,
    api_map,
    recipes,
    overlays,
    mbti_files,
    dep_doc_jsons,
    dep_abis,
    [],
    asset_bypass_rules,
    opts,
    pre_diags,
    run_probes,
    check_fn,
  )
}

pub fn transpile_package_with_abis_and_companions(
  sources : Array[SourceFile],
  api_map : ApiMap,
  recipes : Recipes,
  overlays : Array[OverlaySpec],
  mbti_files : Array[(String, String)],
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
  companion_files : Array[(String, String, String)],
  asset_bypass_rules : Array[AssetBypassRule],
  opts : TranspileOptions,
  pre_diags : Array[Diag],
  run_probes : Bool,
  check_fn : (Array[(String, String)]) -> String,
) -> TranspileResult {
  transpile_package_with_query_types(
    sources,
    api_map,
    recipes,
    overlays,
    mbti_files,
    dep_doc_jsons,
    dep_abis,
    companion_files,
    asset_bypass_rules,
    opts,
    pre_diags,
    run_probes,
    check_fn,
    fn(_batch : Array[(String, String)]) -> String { "" },
  )
}

pub fn transpile_package_with_query_types(
  sources : Array[SourceFile],
  api_map : ApiMap,
  recipes : Recipes,
  overlays : Array[OverlaySpec],
  mbti_files : Array[(String, String)],
  dep_doc_jsons : Array[String],
  dep_abis : Array[(String, PackageAbi)],
  companion_files : Array[(String, String, String)],
  asset_bypass_rules : Array[AssetBypassRule],
  opts : TranspileOptions,
  pre_diags : Array[Diag],
  run_probes : Bool,
  check_fn : (Array[(String, String)]) -> String,
  query_types_cb : (Array[(String, String)]) -> String,
) -> TranspileResult {
  let sorted_sources = sort_source_files(sources)
  let symtab = empty_symbol_table()
  symtab_load_api_map(symtab, api_map)
  for pair in mbti_files {
    symtab_load_mbti(symtab, pair.0, pair.1)
  }
  for doc_json in dep_doc_jsons {
    symtab_load_pionc_doc_json(symtab, doc_json)
  }
  for dabi in dep_abis {
    symtab_load_dep_abi(symtab, dabi.0, dabi.1)
  }
  if opts.moon_pkg_content.length() > 0 {
    parse_moon_pkg_imports(opts.moon_pkg_content, symtab.moon_import_paths)
  }

  let ctx = stage_a_context_new(symtab, recipes, opts)
  // Fail closed when multiple non-core imports share a trailing segment without distinct `--dep` aliases
  for imp_al in symtab.moon_import_paths.keys() {
    match symtab.moon_import_paths.get(imp_al) {
      Some(fp) =>
      if !fp.starts_with("moonbitlang/core/") && !symtab.pkg_aliases.contains(imp_al) && !symtab.dep_alias_names.contains(imp_al) {
        let def_al = moon_import_default_alias(fp)
        if def_al.length() > 0 {
          let mut holders = 0
          for k2 in symtab.moon_import_paths.keys() {
            match symtab.moon_import_paths.get(k2) {
              Some(fp2) =>
              if !fp2.starts_with("moonbitlang/core/") && moon_import_default_alias(fp2) == def_al {
                holders = holders + 1
              }
              None => ()
            }
          }
          if holders > 1 {
            ctx.diags.push(diag_error(
              "MBT2PION_DEP_ABI_ERROR",
              "moon.pkg",
              1,
              1,
              "ambiguous dependency import `@" + imp_al + "` (`" + fp + "`): multiple imports share default segment `" + def_al + "` without a matching `--dep " + imp_al + "=<dir>`",
            ))
          }
        }
      }
      None => ()
    }
  }
  // Derive self package name for stripping `@<self_pkg>.` in black-box `*_test.mbt` files
  match api_map.pkg_aliases.get("__mbt_self_pkg__") {
    Some(sp) => ctx.self_pkg_name = sp
    None =>
    if opts.src_prefix.length() > 0 {
      let sp = if opts.src_prefix.ends_with("/") { opts.src_prefix.slice(0, opts.src_prefix.length() - 1) } else { opts.src_prefix }
      let mut ls = -1
      let mut si = 0
      while si < sp.length() {
        if sp.code_unit_at(si) == 47 { ls = si }
        si = si + 1
      }
      ctx.self_pkg_name = if ls >= 0 { sp.slice(ls + 1, sp.length()) } else { sp }
    }
  }
  for d in pre_diags {
    ctx.diags.push(d)
  }
  symtab_finalize_dep_reexports(symtab, ctx.diags)

  // Build validated asset-bypass table (combining `recipes.asset_bypass` and CLI `--asset-manifest`).
  // Strict disjoint partition order: 1) `excluded_manifest_assets` -> 2) `excluded_by_target` -> 3) `emitted`.
  let all_asset_rules : Array[AssetBypassRule] = []
  for r in recipes.asset_bypass { all_asset_rules.push(r) }
  for r in asset_bypass_rules { all_asset_rules.push(r) }
  let asset_rule_by_path : Map[String, AssetBypassRule] = Map()
  let asset_rule_matched : Map[String, Bool] = Map()
  for rule in all_asset_rules {
    if !is_valid_asset_rel_path(rule.path) {
      ctx.diags.push(diag_error(
        "MBT2PION_ASSET_MANIFEST_INVALID",
        rule.path,
        1,
        1,
        "invalid asset-bypass manifest path `" + rule.path + "` (must be a normalized relative path without leading `/` or `..`)",
      ))
      continue
    }
    if !is_valid_sha256_hex(rule.sha256) {
      ctx.diags.push(diag_error(
        "MBT2PION_ASSET_MANIFEST_INVALID",
        rule.path,
        1,
        1,
        "asset-bypass manifest entry `" + rule.path + "` requires a 64-character hex `sha256`",
      ))
    }
    if rule.allowed_decls.length() == 0 {
      ctx.diags.push(diag_error(
        "MBT2PION_ASSET_MANIFEST_INVALID",
        rule.path,
        1,
        1,
        "asset-bypass manifest entry `" + rule.path + "` requires a non-empty `allowed_decls` list",
      ))
    } else {
      for ad in rule.allowed_decls {
        if !is_valid_decl_ident(ad) {
          ctx.diags.push(diag_error(
            "MBT2PION_ASSET_MANIFEST_INVALID",
            rule.path,
            1,
            1,
            "invalid identifier `" + ad + "` in `allowed_decls` for `" + rule.path + "`",
          ))
        }
      }
    }
    if asset_rule_by_path.contains(rule.path) {
      ctx.diags.push(diag_error(
        "MBT2PION_ASSET_MANIFEST_ERROR",
        rule.path,
        1,
        1,
        "duplicate asset-bypass manifest entry for `" + rule.path + "`",
      ))
    } else {
      asset_rule_by_path[rule.path] = rule
    }
  }
  let excluded_manifest_assets : Array[FileAccountingEntry] = []
  let excluded_by_target : Array[FileAccountingEntry] = []

  // Filter test files unless `--with-tests` is enabled, AND apply `moon.pkg` / `moon.pkg.json` target rules (P1-3)
  let pkg_targets = if opts.moon_pkg_content.length() > 0 {
    match parse_moon_pkg_targets_strict(opts.moon_pkg_content) {
      Ok(m) => m
      Err(reason) => {
        ctx.diags.push(diag_error("MBT2PION_UNSUPPORTED_TARGET_RULE", "moon.pkg", 1, 1, reason))
        ctx.dispositions.push(DispositionEntry::{
          file: "moon.pkg",
          decl: "file:moon.pkg",
          line: 1,
          col: 1,
          disposition: "unsupported",
          detail: reason,
        })
        Map()
      }
    }
  } else {
    Map()
  }
  let selected : Array[SourceFile] = []
  for sf in sorted_sources {
    if sf.is_test && !opts.with_tests {
      ctx.dispositions.push(DispositionEntry::{
        file: sf.rel_path,
        decl: "<file>",
        line: 1,
        col: 1,
        disposition: "skipped_test_file",
        detail: "excluded because --with-tests not set",
      })
      continue
    }
    let sf_sha = content_sha256(sf.content)
    // Check basename and rel_path
    let mut base = sf.rel_path
    let mut ls = -1
    let mut bi = 0
    while bi < base.length() {
      if base.code_unit_at(bi) == 47 {
        ls = bi
      }
      bi = bi + 1
    }
    if ls >= 0 {
      base = base.slice(ls + 1, base.length())
    }
    // 1. Disjoint Set 1: `excluded_manifest_assets` (checked FIRST before target rules!)
    //    Strict exact normalized relative path match ONLY (never basename fallback across subdirectories).
    let asset_opt = match asset_rule_by_path.get(sf.rel_path) {
      Some(r) => Some((sf.rel_path, r))
      None => None
    }
    match asset_opt {
      Some((matched_key, rule)) => {
        asset_rule_matched[matched_key] = true
        if rule.sha256.length() > 0 && rule.sha256 != sf_sha {
          ctx.diags.push(diag_error(
            "MBT2PION_ASSET_MANIFEST_ERROR",
            sf.rel_path,
            1,
            1,
            "stale SHA-256 in asset manifest for `" + sf.rel_path + "`: manifest=" + rule.sha256 + " actual=" + sf_sha,
          ))
        }
        if rule.allowed_decls.length() > 0 {
          let allowed_set : Map[String, Bool] = Map()
          for ad in rule.allowed_decls { allowed_set[ad] = true }
          let defs = collect_file_defined_symbols(sf.content)
          for def_sym in defs {
            if !allowed_set.contains(def_sym) {
              ctx.diags.push(diag_error(
                "MBT2PION_ASSET_UNEXPECTED_DECL",
                sf.rel_path,
                1,
                1,
                "unexpected declaration `" + def_sym + "` inside asset-bypassed file `" + sf.rel_path + "`",
              ))
            }
          }
        }
        excluded_manifest_assets.push(FileAccountingEntry::{
          path: sf.rel_path,
          sha256: sf_sha,
          reason: rule.reason,
        })
        ctx.dispositions.push(DispositionEntry::{
          file: sf.rel_path,
          decl: "<file>",
          line: 1,
          col: 1,
          disposition: "excluded_manifest_asset",
          detail: rule.reason,
        })
        continue
      }
      None => ()
    }
    // 2. Disjoint Set 2: `excluded_by_target` (checked SECOND!)
    let rules_opt = match pkg_targets.get(sf.rel_path) {
      Some(r) => Some(r)
      None => pkg_targets.get(base)
    }
    match rules_opt {
      Some(rule_ast) =>
      match eval_target_rule_ast(opts.target, rule_ast) {
        Some(true) => ()
        Some(false) => {
          excluded_by_target.push(FileAccountingEntry::{
            path: sf.rel_path,
            sha256: sf_sha,
            reason: "excluded by moon.pkg targets for target=" + opts.target,
          })
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "<file>",
            line: 1,
            col: 1,
            disposition: "excluded_by_target",
            detail: "excluded by moon.pkg targets for target=" + opts.target,
          })
          continue
        }
        None => {
          let raw_rule = format_target_rule_expr(rule_ast)
          ctx.diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_TARGET_RULE",
            sf.rel_path,
            1,
            1,
            "unsupported moon.pkg target rule `" + raw_rule + "` for `" + sf.rel_path + "` cannot be statically evaluated for target=" + opts.target,
          ))
          ctx.dispositions.push(DispositionEntry::{
            file: sf.rel_path,
            decl: "file:" + sf.rel_path,
            line: 1,
            col: 1,
            disposition: "unsupported",
            detail: "unsupported moon.pkg target rule " + raw_rule,
          })
          continue
        }
      }
      None => ()
    }
    selected.push(sf)
  }
  // Conservation check: every manifest asset entry MUST match an actual source file (catches file swaps!)
  for rule in all_asset_rules {
    if !asset_rule_matched.contains(rule.path) {
      ctx.diags.push(diag_error(
        "MBT2PION_ASSET_MANIFEST_ERROR",
        rule.path,
        1,
        1,
        "asset manifest entry `" + rule.path + "` did not match any source file in --src",
      ))
    }
  }

  // Record original source SHA-256 before operator-trait pre-pass
  let orig_source_shas : Map[String, String] = Map()
  for sf in selected {
    orig_source_shas[sf.rel_path] = content_sha256(sf.content)
  }

  // §E2-1 / F4-3 pre-pass: dual-namespace `pub using` ABI canonical re-exports + consumer-side canonicalization
  let (re_selected, local_reexports) = preprocess_pub_using_v2(selected, symtab.pkg_aliases, symtab.moon_import_paths, dep_doc_jsons, dep_abis, ctx.diags)
  let canon_selected = rewrite_dep_reexports_v2(re_selected, symtab.pkg_aliases, symtab.moon_import_paths, dep_doc_jsons, dep_abis, ctx.diags)
  // §D1-3 pre-pass: lower `impl (Add|Sub|Mul|Neg|Div) for <Type>` into collision-free top-level functions
  let (op_selected, local_op_impls) = preprocess_op_trait_impls(canon_selected, ctx.self_pkg_name)
  let op_lookup = build_op_impl_lookup(local_op_impls, dep_abis)
  // Collect exported `pub fn ... raise E` ABI signatures BEFORE checked-error lowering rewrites `raise` -> `Result`
  let exported_abi_raising_fns = collect_exported_abi_raising_fns(op_selected, ctx.self_pkg_name, symtab, opts.target)
  // Unified checked-error pre-pass (two strictly non-overlapping phases):
  //   Phase 1: Category A private bare-`raise` test helpers (`preprocess_test_helper_raises_with_env`)
  //   Phase 2: Universal checked-error lowering (`lower_checked_errors_with_env`)
  let err_cfg = default_error_lower_config()
  let base_err_env = build_external_error_env(symtab, dep_abis, Map())
  let (cat_a_selected, cat_a_rewritten) = preprocess_test_helper_raises_with_env(op_selected, err_cfg, base_err_env, ctx.diags)
  let err_env = build_external_error_env(symtab, dep_abis, cat_a_rewritten)
  let err_selected = lower_checked_errors_with_env(cat_a_selected, err_cfg, err_env, ctx.diags)

  // Stage A.0: prescan intra-package symbols
  prescan_package_symbols(ctx, err_selected)

  // Stage A: lower every file
  let mut gen_files : Array[GeneratedFile] = []
  for sf in err_selected {
    gen_files.push(lower_file_stage_a(ctx, sf))
  }

  // Stage A: topological declaration reordering into single `00_init_order.pion`
  // Test files' top-level `let`/`fn init` are strictly isolated into `00_init_order_test.pion`
  // so `--with-tests` NEVER pollutes production `00_init_order.pion`.
  let init_files : Array[GeneratedFile] = []
  let init_origins_by_file : Map[String, Array[InitOriginRecord]] = Map()
  if ctx.init_items.length() > 0 {
    let sorted_inits = topo_sort_init_items(ctx.init_items, ctx.fn_bodies, ctx.diags)
    if sorted_inits.length() > 0 {
      let (init_body, init_recs) = render_init_order_file_with_origins(sorted_inits)
      init_origins_by_file["00_init_order.pion"] = init_recs
      init_files.push(GeneratedFile::{
        rel_path: "00_init_order.pion",
        content: init_body,
        source_file: "<package-init-order>",
        anchors: [],
      })
    }
  }
  if ctx.test_init_items.length() > 0 {
    let sorted_test_inits = topo_sort_init_items(ctx.test_init_items, ctx.fn_bodies, ctx.diags)
    if sorted_test_inits.length() > 0 {
      let (test_init_body, test_init_recs) = render_init_order_file_with_origins(sorted_test_inits)
      init_origins_by_file["00_init_order_test.pion"] = test_init_recs
      init_files.push(GeneratedFile::{
        rel_path: "00_init_order_test.pion",
        content: test_init_body,
        source_file: "<package-init-order>",
        anchors: [],
      })
    }
  }
  if init_files.length() > 0 {
    let with_init : Array[GeneratedFile] = []
    for inf in init_files {
      with_init.push(inf)
    }
    for gf in gen_files {
      with_init.push(gf)
    }
    gen_files = with_init
  }

  // Global output path uniqueness gate (fail-closed): reject any two outputs targeting the same `rel_path`!
  let seen_out_paths : Map[String, String] = Map()
  let seen_out_paths_lower : Map[String, String] = Map()
  for gf in gen_files {
    match seen_out_paths.get(gf.rel_path) {
      Some(prev_src) =>
      ctx.diags.push(diag_error(
        "MBT2PION_OUTPUT_PATH_COLLISION",
        gf.source_file,
        1,
        1,
        "output path collision on `" + gf.rel_path + "` between `" + prev_src + "` and `" + gf.source_file + "`",
      ))
      None => {
        seen_out_paths[gf.rel_path] = gf.source_file
        seen_out_paths_lower[ascii_to_lower(gf.rel_path)] = gf.rel_path
      }
    }
  }
  // §D1-1: Validate companion files against generated filenames and generated public types
  if companion_files.length() > 0 {
    let gen_types = collect_generated_type_names(gen_files)
    for cf in companion_files {
      let cname = cf.0
      let ctxt = cf.1
      let clow = ascii_to_lower(cname)
      if seen_out_paths.contains(cname) || seen_out_paths_lower.contains(clow) {
        ctx.diags.push(diag_error(
          "MBT2PION_ABI_COMPANION_ERROR",
          cname,
          1,
          1,
          "companion filename `" + cname + "` collides with a generated `.pion` output file",
        ))
      }
      validate_companion_declarations(cname, ctxt, gen_types, ctx.diags)
    }
  }

  // Declaration-granularity double-hash-anchored Overlays
  gen_files = apply_overlays(gen_files, overlays, opts.target, ctx.diags, ctx.dispositions)

  // Stage B pre-pass + Stage A.5 Type-Probe Pass + Active Neg probe pass + Stage B final fixpoint pass:
  // Running Stage B first fixes compile-time errors (`for k, v in m`, `for i, ch in s`,
  // `String` slices, missing methods, custom binary ops) so Stage A.5 & Neg probes see exact resolved types!
  let mut probe_rounds = 0
  let mut probes_instrumented = 0
  let mut probes_resolved = 0
  let mut pre_b_iters = 0
  let probe_dispositions : Array[ProbeDisposition] = []
  let mut post_a5_qt = empty_pkg_query_types()
  if run_probes {
    let (pre_files, pre_it, _, pre_qt) = run_stage_b_with_ops_deps_and_qt(
      gen_files,
      api_map,
      op_lookup,
      symtab.dep_method_names,
      check_fn,
      Some(query_types_cb),
      empty_pkg_query_types(),
      ctx.diags,
      ctx.drift_ledger,
    )
    gen_files = pre_files
    pre_b_iters = pre_it
    let combined_val_fields : Map[String, String] = Map()
    for k in ctx.struct_val_fields.keys() {
      match ctx.struct_val_fields.get(k) {
        Some(v) => combined_val_fields[k] = v
        None => ()
      }
    }
    for k in symtab.dep_struct_val_fields.keys() {
      match symtab.dep_struct_val_fields.get(k) {
        Some(v) => combined_val_fields[k] = v
        None => ()
      }
    }
    let (a5_files, pr, pi, pres, pkg_qt) = run_stage_a5_with_query_types_and_seed(
      gen_files,
      recipes,
      api_map,
      combined_val_fields,
      ctx.val_probe_sites,
      init_origins_by_file,
      check_fn,
      query_types_cb,
      pre_qt,
      ctx.diags,
      ctx.drift_ledger,
      probe_dispositions,
      64,
    )
    gen_files = a5_files
    post_a5_qt = pkg_qt
    probe_rounds = pr
    probes_instrumented = pi
    probes_resolved = pres
    // §D1-3: Active type-directed `Neg` (`-p`) lowering (zero overhead when no `Neg` impl exists)
    if has_any_neg_impl(op_lookup) {
      let (neg_files, neg_ch) = run_neg_probe_pass(gen_files, op_lookup, check_fn, ctx.diags)
      gen_files = neg_files
      if neg_ch {
        post_a5_qt = empty_pkg_query_types()
      }
    }
  }

  // Stage B: Type-Directed Fixpoint Pass (`pionc check --json`)
  let (b_files, post_b_iters, init_diag_hist, _) = if run_probes {
    run_stage_b_with_ops_deps_and_qt(
      gen_files,
      api_map,
      op_lookup,
      symtab.dep_method_names,
      check_fn,
      Some(query_types_cb),
      post_a5_qt,
      ctx.diags,
      ctx.drift_ledger,
    )
  } else {
    (gen_files, 0, [], empty_pkg_query_types())
  }
  let mut stage_b_iters = pre_b_iters + post_b_iters
  let mut diag_hist = init_diag_hist
  gen_files = b_files
  if run_probes && post_b_iters > 1 && has_any_neg_impl(op_lookup) {
    let (neg_files2, neg_changed2) = run_neg_probe_pass(gen_files, op_lookup, check_fn, ctx.diags)
    gen_files = neg_files2
    if neg_changed2 {
      let (b_files2, post_b_iters2, diag_hist2) = run_stage_b_with_ops_and_deps(gen_files, api_map, op_lookup, symtab.dep_method_names, check_fn, ctx.diags, ctx.drift_ledger)
      gen_files = b_files2
      stage_b_iters = stage_b_iters + post_b_iters2
      diag_hist = diag_hist2
    }
  }

  // Final post-convergence audit: every `mbt_compat::arr_push_iter(dst, arg)` MUST have its
  // 2nd argument proven as `mbt_compat::arr_iter(...)` (runs ONCE after Stage A.5 + final Stage B).
  if run_probes {
    stage_b_audit_final_push_iter_calls(gen_files, ctx.diags)
    stage_b_audit_final_sort_keys_with_deps(gen_files, symtab.dep_method_names, ctx.diags)
  }

  // Compute pre-header blockers so `--mode audit` with blockers marks `publishable: false` (Opus P2)
  let mut pre_blockers = 0
  for d in ctx.diags {
    if d.severity == "error" {
      pre_blockers = pre_blockers + 1
    }
  }
  for e in ctx.drift_ledger {
    if e.status != "resolved" {
      pre_blockers = pre_blockers + 1
    }
  }
  let is_publishable = !(opts.mode == "audit" && (pre_blockers > 0 || diag_hist.length() > 0))

  // Build deterministic PackageAbi (v2) and embed `// abi-sha256: <hex>` in every emitted `.pion` header!
  let abi_comps : Array[AbiCompanionFile] = []
  for cf in companion_files {
    abi_comps.push(AbiCompanionFile::{ path: cf.0, sha256: cf.2 })
  }
  let exported_abi_structs = collect_exported_abi_structs(
    err_selected,
    ctx.self_pkg_name,
    ctx.symtab,
    recipes,
    ctx.struct_field_renames,
    opts.target,
  )
  let exported_abi_values = collect_exported_abi_values(
    err_selected,
    ctx.self_pkg_name,
    ctx.symtab,
    recipes,
    opts.target,
  )
  let pkg_abi = PackageAbi::{
    package_name: ctx.self_pkg_name,
    enums: ctx.exported_abi_enums,
    struct_val_fields: ctx.exported_abi_struct_vals,
    structs: Some(exported_abi_structs),
    companion_files: abi_comps,
    op_impls: local_op_impls,
    reexports: local_reexports,
    values: exported_abi_values,
    raising_fns: exported_abi_raising_fns,
    publishable: is_publishable,
  }
  let abi_sha = compute_abi_payload_sha256(pkg_abi)
  let opts_with_abi = TranspileOptions::{
    target: opts.target,
    mode: opts.mode,
    with_tests: opts.with_tests,
    src_prefix: opts.src_prefix,
    moon_pkg_content: opts.moon_pkg_content,
    header: HeaderMeta::{
      mbt2pion_commit: opts.header.mbt2pion_commit,
      toolchain_lock: opts.header.toolchain_lock,
      source_commit: opts.header.source_commit,
      api_map_sha256: opts.header.api_map_sha256,
      recipes_sha256: opts.header.recipes_sha256,
      abi_sha256: abi_sha,
      target: opts.header.target,
    },
  }

  // Prepend platform-neutral headers + auto-emitted `import "<pkg>"` block to every generated file
  let final_files = prepend_headers_and_imports(gen_files, opts_with_abi, ctx.val_probe_sites, ctx.diags)

  // Count blockers: any error diagnostic or unresolved drift entry
  let mut blockers = 0
  for d in ctx.diags {
    if d.severity == "error" {
      blockers = blockers + 1
    }
  }
  for e in ctx.drift_ledger {
    if e.status != "resolved" {
      blockers = blockers + 1
    }
  }

  let emitted_sources : Array[FileAccountingEntry] = []
  for sf in selected {
    let orig_sha = match orig_source_shas.get(sf.rel_path) {
      Some(s) => s
      None => content_sha256(sf.content)
    }
    emitted_sources.push(FileAccountingEntry::{
      path: sf.rel_path,
      sha256: orig_sha,
      reason: "emitted",
    })
  }
  let synthesized_files : Array[String] = []
  for gf in final_files {
    if gf.source_file == "<package-init-order>" {
      synthesized_files.push(gf.rel_path)
    }
  }

  TranspileResult::{
    files: final_files,
    span_map: ctx.span_map,
    diagnostics: ctx.diags,
    drift_ledger: ctx.drift_ledger,
    dispositions: ctx.dispositions,
    probe_dispositions: probe_dispositions,
    excluded_manifest_assets: excluded_manifest_assets,
    excluded_by_target: excluded_by_target,
    emitted_sources: emitted_sources,
    synthesized_files: synthesized_files,
    pionc_diag_histogram: diag_hist,
    probe_rounds: probe_rounds,
    probes_instrumented: probes_instrumented,
    probes_resolved: probes_resolved,
    stage_b_iterations: stage_b_iters,
    blockers: blockers,
    abi: pkg_abi,
    abi_sha256: abi_sha,
  }
}
