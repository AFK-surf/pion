///| Unit tests for arity-shape constructor disambiguation, expected-type isolation,
///| pipe arg offset & LHS guidance, spread/chained array literals, `Json::object`,
///| array literal cascades, `@pkg.fn(...) is <Or-Pattern>`, `Map::from_iter`,
///| Stage B custom-iterable `for-in`, float literal match patterns, and
///| cross-package / named-arg / container closure parameter inference.

test "arity-shape ctor disambiguation: unit vs payload succeeds, same-arity fails closed" {
  let dep_json = "{\"packages\":[{\"name\":\"mbt_compat\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"MbtJson\",\"sig\":\"pub enum MbtJson { Null; True; False; Number(Double, Option[String]); String(String); Array(Array[MbtJson]); Object(OrderedMap[String, MbtJson]) }\"}" +
  "]}]}"
  let dep_u = "{\"packages\":[{\"name\":\"u\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"TokenKind\",\"sig\":\"pub enum TokenKind { Number; Text }\"}" +
  "]}]}"
  // Case 1: external unit `u::TokenKind::Number` (arity 0) vs `mbt_compat::MbtJson::Number` (arity 2)
  let src1 = SourceFile::{
    rel_path: "arity_ext.mbt",
    content: "pub fn extract_num(v : Any) -> Double {\n" +
    "  match v {\n" +
    "    Number(n, ..) => n\n" +
    "    _ => 0.0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res1 = transpile_package_ex([src1], empty_api_map(), default_recipes(), [], [], [dep_json, dep_u], [], default_options(), [], false, noop_check)
  let d1_msg = if res1.diagnostics.length() > 0 { res1.diagnostics[0].code + ": " + res1.diagnostics[0].message } else { "" }
  assert_true(res1.blockers == 0, "res1 blockers=" + res1.blockers.to_string() + " " + d1_msg)
  let out1 = res1.files[0].content
  assert_true(str_has(out1, "mbt_compat::MbtJson::Number(n, _)"), "Number(n, ..) disambiguates to MbtJson::Number(n, _): " + out1)

  // Case 2: local unit `pub(all) enum Kind { Number }` (arity 0) coexisting with `MbtJson::Number` (arity 2)
  let src2 = SourceFile::{
    rel_path: "arity_local_ext.mbt",
    content: "pub(all) enum Kind {\n  Number\n  Text\n}\n\n" +
    "pub fn check_kind(k : Kind) -> Bool {\n  k is Number\n}\n\n" +
    "pub fn get_num(x : Any) -> Double {\n" +
    "  match x {\n" +
    "    Number(v, ..) => v\n" +
    "    _ => 0.0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res2 = transpile_package_ex([src2], empty_api_map(), default_recipes(), [], [], [dep_json], [], default_options(), [], false, noop_check)
  let d2_msg = if res2.diagnostics.length() > 0 { res2.diagnostics[0].code + ": " + res2.diagnostics[0].message } else { "" }
  assert_true(res2.blockers == 0, "res2 blockers=" + res2.blockers.to_string() + " " + d2_msg)
  let out2 = res2.files[0].content
  assert_true(str_has(out2, "mbt_compat::MbtJson::Number(v, _)"), "local arity-0 Number does not block MbtJson::Number(v, ..): " + out2)

  // Case 3 (negative): two external arity-2 constructors named `Pair` must fail closed with MBT2PION_AMBIGUOUS_CTOR
  let dep_a = "{\"packages\":[{\"name\":\"pa\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"EA\",\"sig\":\"pub enum EA { Pair(Int, Int) }\"}" +
  "]}]}"
  let dep_b = "{\"packages\":[{\"name\":\"pb\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"EB\",\"sig\":\"pub enum EB { Pair(String, String) }\"}" +
  "]}]}"
  let src3 = SourceFile::{
    rel_path: "arity_ambig.mbt",
    content: "pub fn bad(x : Any) -> Int {\n" +
    "  match x {\n" +
    "    Pair(_, _) => 1\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res3 = transpile_package_ex([src3], empty_api_map(), default_recipes(), [], [], [dep_a, dep_b], [], default_options(), [], false, noop_check)
  assert_true(res3.blockers > 0, "two same-arity ctors must fail closed")
  let mut saw_ambig = false
  for d in res3.diagnostics {
    if d.code == "MBT2PION_AMBIGUOUS_CTOR" {
      saw_ambig = true
    }
  }
  assert_true(saw_ambig, "must emit MBT2PION_AMBIGUOUS_CTOR when two candidates share arity 2")

  // Case 4 (negative builtin guard): local arity-0 `Status::Ok` + dep `dep::Dep::Ok(Int)` must NOT hijack `Ok(42)`
  let dep_ok = "{\"packages\":[{\"name\":\"dep\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Dep\",\"sig\":\"pub enum Dep { Ok(Int) }\"}" +
  "]}]}"
  let src4 = SourceFile::{
    rel_path: "arity_builtin_ok.mbt",
    content: "pub(all) enum Status {\n  Ok\n  Fail\n}\n\n" +
    "pub fn make_res() -> Result[Int, String] {\n" +
    "  let v = Ok(42)\n" +
    "  v\n" +
    "}\n",
    is_test: false,
  }
  let res4 = transpile_package_ex([src4], empty_api_map(), default_recipes(), [], [], [dep_ok], [], default_options(), [], false, noop_check)
  assert_eq(res4.blockers, 0)
  let out4 = res4.files[0].content
  assert_true(!str_has(out4, "dep::Dep::Ok"), "builtin Ok(42) must never be hijacked by dep::Dep::Ok: " + out4)
}

test "expected_type_stack and cur_fn_ret_ty isolation in closures, loops, if-without-else, and assignments" {
  let src = SourceFile::{
    rel_path: "iso_json.mbt",
    content: "pub fn build_val(xs : Array[String]) -> Json {\n" +
    "  let pred = fn(s : String) -> Bool {\n" +
    "    if s == \"\" {\n" +
    "      return false\n" +
    "    }\n" +
    "    true\n" +
    "  }\n" +
    "  let mut found = false\n" +
    "  let _kept = xs.filter(fn(m) {\n" +
    "    if m == \"\" {\n" +
    "      return false\n" +
    "    }\n" +
    "    true\n" +
    "  })\n" +
    "  let _kept2 = xs.filter(m => {\n" +
    "    if m == \"\" {\n" +
    "      return false\n" +
    "    }\n" +
    "    true\n" +
    "  })\n" +
    "  for k in [\"a\", \"b\"] {\n" +
    "    if pred(k) {\n" +
    "      found = true\n" +
    "    }\n" +
    "  }\n" +
    "  let mut n = 0\n" +
    "  while n < xs.length() {\n" +
    "    found = true\n" +
    "    n = n + 1\n" +
    "  }\n" +
    "  let mut j : Json = Json::null()\n" +
    "  j = true\n" +
    "  if found {\n" +
    "    \"ok\"\n" +
    "  } else {\n" +
    "    j\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "return false"), "closure return false must not be wrapped as MbtJson::False: " + out)
  assert_true(!str_has(out, "return mbt_compat::MbtJson::False"), "filter/arrow closure return false must never become MbtJson::False: " + out)
  assert_true(str_has(out, "for k in [\"a\", \"b\"]"), "for-in array literal must not be wrapped as MbtJson::Array: " + out)
  assert_true(str_has(out, "found = true"), "Bool assignment must not be wrapped as MbtJson::True: " + out)
  assert_true(str_has(out, "j = mbt_compat::MbtJson::True"), "Json-typed variable assignment still wraps true as MbtJson::True: " + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::String(\"ok\")"), "if-with-else still propagates outer Json return type: " + out)
}

test "pipe RHS arg offset, pipe LHS Json guidance, chained array literal, spread array, and Json::object" {
  let src = SourceFile::{
    rel_path: "pipe_json_arr.mbt",
    content: "fn tag_json(v : Json, key : String) -> Json {\n" +
    "  let _ = key\n" +
    "  v\n" +
    "}\n\n" +
    "fn take_pairs(ps : Array[(String, Json)]) -> Int {\n" +
    "  ps.length()\n" +
    "}\n\n" +
    "pub fn run_pipe(xs : Array[Json], extra : Array[(String, Json)]) -> Json {\n" +
    "  let a = [1, \"x\"] |> tag_json(\"label\")\n" +
    "  let b = Json::array([\"k1\", \"k2\"].map(fn(s) { Json::string(s) }))\n" +
    "  let c : Array[Json] = [..xs, \"tail\"]\n" +
    "  let d = Json::object({ \"k\": \"v\", \"sub\": { \"ok\": true } })\n" +
    "  let e = take_pairs([(\"k\", [])] + extra)\n" +
    "  let _ = (a, b, c, e)\n" +
    "  d\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::MbtJson::Array([mbt_compat::MbtJson::Number(") && str_has(out, "mbt_compat::MbtJson::String(\"x\")]) |> tag_json(\"label\")"), "pipe LHS wraps Json array and pipe RHS arg 1 stays String: " + out)
  assert_true(str_has(out, "[\"k1\", \"k2\"].map("), "chained array literal inside Json::array does not wrap elements as MbtJson: " + out)
  assert_true(str_has(out, ".push(mbt_compat::MbtJson::String(\"tail\"))"), "spread array literal propagates Array[MbtJson] element type: " + out)
  assert_true(str_has(out, "(\"k\", mbt_compat::MbtJson::String(\"v\"))"), "Json::object propagates OrderedMap[String, MbtJson] value type: " + out)
  assert_true(str_has(out, "(\"ok\", mbt_compat::MbtJson::True)"), "Json::object propagates recursively into nested object: " + out)
  assert_true(str_has(out, "take_pairs([(\"k\", mbt_compat::MbtJson::Array([]))] + extra)"), "binary + concat preserves array element expected type: " + out)
}

test "array literal cascade lowers via cascade chain and does not wrap as MbtJson::Array" {
  let src = SourceFile::{
    rel_path: "arr_cascade.mbt",
    content: "pub fn make_arr(xs : Array[Int]) -> Array[Int] {\n" +
    "  let a = [1, 2]..push(3)\n" +
    "  let b = []..push(4)\n" +
    "  let c : Array[Int] = [..xs, 5]..push(6)\n" +
    "  let _ = (a, b)\n" +
    "  c\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "[1, 2]; __mbt_cas_"), "plain array cascade uses temp binding: " + out)
  assert_true(str_has(out, "[]; __mbt_cas_"), "empty array cascade uses temp binding: " + out)
  assert_true(str_has(out, ".push(6);"), "spread array cascade emits chained push: " + out)
}

test "package-qualified call with is or-pattern lowers to match expression" {
  let dep_p = "{\"packages\":[{\"name\":\"p\",\"items\":[" +
  "{\"kind\":\"enum\",\"name\":\"Tok\",\"sig\":\"pub enum Tok { Alpha(Int); Beta; Gamma; Delta }\"}," +
  "{\"kind\":\"fn\",\"name\":\"parse_val\",\"sig\":\"pub fn parse_val(s : String) -> Option[(Tok, Int, Int)]\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "pkg_is_or.mbt",
    content: "pub fn check(s : String) -> Bool {\n" +
    "  @p.parse_val(s) is Some((Alpha(_) | Beta | Gamma, _, _))\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_p], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "(match p::parse_val(s)"), "@pkg.fn(...) is <Or-Pattern> lowers to match: " + out)
  assert_true(str_has(out, "Option::Some((.Alpha(_), _, _)) | Option::Some((.Beta, _, _)) | Option::Some((.Gamma, _, _)) => true, _ => false })"), "nested or-pattern distributes to top-level | arms: " + out)
}

test "Map::from_iter lowers to mbt_compat::ordered_map_from_iter with tuple suffix and shadowing guard" {
  let src = SourceFile::{
    rel_path: "map_from_iter.mbt",
    content: "pub fn build(it : Iter[(String, Int)], it2 : Iter[((Int, String), Int)]) -> (Map[String, Int], Map[(Int, String), Int]) {\n" +
    "  let m1 : Map[String, Int] = Map::from_iter(it)\n" +
    "  let m2 : Map[(Int, String), Int] = Map::from_iter(it2)\n" +
    "  (m1, m2)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::ordered_map_from_iter(it)"), "Map::from_iter lowers: " + out)
  assert_true(str_has(out, "mbt_compat::ordered_map_from_iter_pair(it2)"), "pair-keyed Map::from_iter uses _pair suffix: " + out)

  let shadow_src = SourceFile::{
    rel_path: "map_shadow.mbt",
    content: "struct Map { n : Int }\nfn Map::from_iter(x : Int) -> Map { Map::{ n: x } }\npub fn keep(x : Int) -> Map { Map::from_iter(x) }\n",
    is_test: false,
  }
  let sres = transpile_package([shadow_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(sres.blockers, 0)
  assert_true(!str_has(sres.files[0].content, "ordered_map_from_iter"), "local struct Map must not be rewritten")
}

test "Stage B rewrites 1-var for-in via iter(), 2-var for-in via iter2(), and fails closed when iter2() is absent" {
  let local_file = GeneratedFile::{
    rel_path: "custom_iter.pion",
    content: "struct Bag {\n  xs : Array[(String, Int)]\n}\n" +
    "pub fn Bag::iter(self : Bag) -> mbt_compat::MbtIter[Int] {\n" +
    "  mbt_compat::arr_iter([])\n" +
    "}\n" +
    "pub fn Bag::iter2(self : Bag) -> mbt_compat::MbtIter2[String, Int] {\n" +
    "  mbt_compat::mbt_iter2_new(fn() { None })\n" +
    "}\n" +
    "struct OnlyIter {\n  xs : Array[Int]\n}\n" +
    "pub fn OnlyIter::iter(self : OnlyIter) -> mbt_compat::MbtIter[Int] {\n" +
    "  mbt_compat::arr_iter(self.xs)\n" +
    "}\n" +
    "struct NoIter { n : Int }\n" +
    "pub fn sum_items(bag : Bag, only1 : OnlyIter, plain : NoIter) -> Int {\n" +
    "  let mut acc = 0\n" +
    "  for v in bag {\n" +
    "    acc = acc + v\n" +
    "  }\n" +
    "  for k, v in bag {\n" +
    "    let _ = k\n" +
    "    acc = acc + v\n" +
    "  }\n" +
    "  for k, v in only1 {\n" +
    "    let _ = (k, v)\n" +
    "  }\n" +
    "  for y in plain {\n" +
    "    let _ = y\n" +
    "  }\n" +
    "  acc\n" +
    "}\n",
    source_file: "custom_iter.mbt",
    anchors: [],
  }
  let mock_check = fn(fs : Array[(String, String)]) -> String {
    let src = fs[0].1
    if str_has(src, "for v in bag {") {
      return "{\"ok\":false,\"diagnostics\":[{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":19,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"Bag\"},{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":22,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"Bag\"},{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":26,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"OnlyIter\"},{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":29,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"NoIter\"}]}"
    }
    "{\"ok\":false,\"diagnostics\":[{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":26,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"OnlyIter\"},{\"severity\":\"error\",\"code\":\"E_TYPE_MISMATCH\",\"file\":\"custom_iter.pion\",\"line\":29,\"col\":3,\"message\":\"`for ... in` requires an `Array[T]`\",\"expected\":\"Array[T]\",\"found\":\"NoIter\"}]}"
  }
  let diags : Array[Diag] = []
  let drift : Array[DriftEntry] = []
  let (out_files, _, _) = run_stage_b_with_ops_and_deps([local_file], empty_api_map(), Map(), Map(), mock_check, diags, drift)
  let out = out_files[0].content
  assert_true(str_has(out, "(bag).iter(); while true { match (") && str_has(out, "Some(v) =>"), "1-var for-in uses .iter() with Some(v): " + out)
  assert_true(str_has(out, "(bag).iter2(); while true { match (") && str_has(out, "Some((k, v)) =>"), "2-var for-in uses .iter2() with Some((k, v)): " + out)
  assert_true(str_has(out, "for k, v in only1 {"), "type with only iter() (no iter2()) must fail closed on 2-var for-in: " + out)
  assert_true(str_has(out, "for y in plain {"), "type without iter() is not blindly rewritten: " + out)
}

test "match float literal patterns lower to guarded fresh bindings preserving IEEE-754 and existing guards" {
  let src = SourceFile::{
    rel_path: "float_match.mbt",
    content: "pub fn classify(d : Double, ok : Bool) -> Int {\n" +
    "  match d {\n" +
    "    0.0 => 1\n" +
    "    -1.5 => 2\n" +
    "    2.0 | 3.0 if ok => 3\n" +
    "    _ => 0\n" +
    "  }\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "if (__mbt_fp_"), "float literal arm lowers to guarded binding: " + out)
  assert_true(str_has(out, "== 0.0)"), "0.0 arm emits == 0.0: " + out)
  assert_true(str_has(out, "== -1.5)"), "-1.5 arm emits == -1.5: " + out)
  assert_true(str_has(out, "== 2.0) || (") && str_has(out, "== 3.0)) && (ok)"), "OR float pattern merges existing if guard: " + out)
}

test "infer_closure_param_type_from_body supports cross-pkg calls, trailing named args, and container/tuple types" {
  let dep_ui = "{\"packages\":[{\"name\":\"ui\",\"items\":[" +
  "{\"kind\":\"struct\",\"name\":\"Span\",\"sig\":\"pub struct Span { id : Int }\"}," +
  "{\"kind\":\"fn\",\"name\":\"make_span\",\"sig\":\"pub fn make_span(label : String, weight~ : Int = 400, color~ : String = \\\"\\\") -> Span\"}," +
  "{\"kind\":\"fn\",\"name\":\"join_pairs\",\"sig\":\"pub fn join_pairs(pairs : Array[(String, String)], sep~ : String = \\\",\\\") -> String\"}" +
  "]}]}"
  let src = SourceFile::{
    rel_path: "closure_infer.mbt",
    content: "pub fn test_infer() -> Unit {\n" +
    "  let f = fn(n) { @ui.make_span(n, weight=600, color=\"red\") }\n" +
    "  let g = fn(ps) { @ui.join_pairs(ps, sep=\";\") }\n" +
    "  let h = fn(x) { @ui.make_span(weight=600, x) }\n" +
    "  let _ = (f, g, h)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package_ex([src], empty_api_map(), default_recipes(), [], [], [dep_ui], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "fn(n : String)"), "cross-pkg call with trailing named args infers String: " + out)
  assert_true(str_has(out, "fn(ps : Array[(String, String)])"), "container+tuple param type Array[(String, String)] is inferred: " + out)
  assert_true(str_has(out, "fn(x) {"), "named arg preceding pname fails closed and leaves x unannotated: " + out)
}
