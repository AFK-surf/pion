test "F5-1-8: range pattern rejects binder Ident & empty pipe alts, adds catchall for exhaustive ranges" {
  // 1. `0..=5 | x => x` must NOT rewrite `x` to `(__mbt_rp_N == x)`
  let binder_src =
  "pub fn f(n : Int) -> Int {\n" +
  "  match n {\n" +
  "    0..=5 | x => x\n" +
  "  }\n" +
  "}\n"
  let binder_res = transpile_package(
    [SourceFile::{ rel_path: "rng_bind.mbt", content: binder_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let binder_out = binder_res.files[0].content
  assert_true(!str_has(binder_out, "== x"), "binder Ident in range or-pattern must not lower to == x:\n" + binder_out)

  // 2. Leading/trailing empty pipe alt `| 0..=5` must NOT silently drop the empty alt and trigger B2b
  let empty_pipe_src =
  "pub fn g(n : Int) -> Int {\n" +
  "  match n {\n" +
  "    | 0..=5 => 1\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n"
  let ep_res = transpile_package(
    [SourceFile::{ rel_path: "rng_ep.mbt", content: empty_pipe_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let ep_out = ep_res.files[0].content
  assert_true(!str_has(ep_out, "if (__mbt_rp_"), "leading empty pipe alt must not silently trigger range guard:\n" + ep_out)

  // 3. Exhaustive range match without `_` must emit `_ => panic(\"unreachable\")`
  let exh_src =
  "pub fn h(b : Byte) -> Int {\n" +
  "  match b {\n" +
  "    0..=127 => 1\n" +
  "    128..=255 => 2\n" +
  "  }\n" +
  "}\n"
  let exh_res = transpile_package(
    [SourceFile::{ rel_path: "rng_exh.mbt", content: exh_src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let exh_out = exh_res.files[0].content
  assert_true(str_has(exh_out, "_ => panic(\"unreachable\")"), "exhaustive range match must append catchall:\n" + exh_out)
}

test "F5-1-9: Repr(Show::to_string(x).length()) stays __mbt_debug_fmt (not debug_string)" {
  let src =
  "pub struct Tag {\n  name : String\n}\n" +
  "pub impl Show for Tag with output(self, logger) {\n" +
  "  logger.write_string(self.name)\n" +
  "}\n" +
  "pub fn repr_len(x : Tag) -> String {\n" +
  "  Repr(Show::to_string(x).length())\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "repr_len.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::__mbt_debug_fmt("), "compound Show::to_string(x).length() must use __mbt_debug_fmt:\n" + out)
  assert_true(!str_has(out, "mbt_compat::debug_string("), "compound Show::to_string(x).length() must NOT use debug_string:\n" + out)
}

