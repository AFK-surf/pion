///| Wave M2-F5 Track F5-1 unit tests:
///| 1. P0 `String::code_unit_at(i)` Stage A.5 probe -> `mbt_compat::utf16_code_unit_at(s, i)`
///|    while preserving non-`String` receivers (e.g. `Bytes::code_unit_at(i)`).
///| 2. Match-arm sibling tuple type inference + explicit qualification for ambiguous local constructors.
///| 3. `match recv.field.get(...)` arm-first type inference feeding struct update `{ ..g, ... }`.
///| 4. Unqualified `Number(d, ..)` pattern without outer expected type.
///| 5. Integer and char range patterns (`lo..=hi`, `lo..<hi`, `|`-combined).

test "F5-1-1: String::code_unit_at(i) routes to utf16_code_unit_at while Bytes::code_unit_at stays intact" {
  let src =
  "pub fn check_cu(s : String, b : Bytes, i : Int) -> Int {\n" +
  "  let a = s.code_unit_at(i)\n" +
  "  let c = b.code_unit_at(i)\n" +
  "  a + c\n" +
  "}\n"
  let check_fn = fn(files : Array[(String, String)]) -> String {
    let diags : Array[String] = []
    for pair in files {
      if pair.0 == "cu.pion" {
        let txt = pair.1
        let needle = "mbt_code_unit_at_probe__"
        let mut pos = 0
        while pos < txt.length() {
          let rest = txt.slice(pos, txt.length())
          let idx = rest.index_of(needle)
          if idx < 0 { break }
          let abs_i = pos + idx
          let mut end_i = abs_i + needle.length()
          while end_i < txt.length() {
            let ch = txt.code_unit_at(end_i)
            if (ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 122) || ch == 95 {
              end_i = end_i + 1
            } else {
              break
            }
          }
          let mname = txt.slice(abs_i, end_i)
          let before = if abs_i >= 2 { txt.slice(abs_i - 2, abs_i) } else { "" }
          let ty = if before.starts_with("s.") { "String" } else { "Bytes" }
          diags.push("{\"file\":\"cu.pion\",\"line\":2,\"col\":1,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `" + mname + "` on type `" + ty + "`\"}")
          pos = end_i
        }
      }
    }
    "{\"ok\":false,\"diagnostics\":[" + join_comma(diags) + "]}"
  }
  let res = transpile_package(
    [SourceFile::{ rel_path: "cu.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    true,
    check_fn,
  )
  assert_true(res.blockers == 0, "code_unit_at probe must resolve with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::utf16_code_unit_at(s, i)"), "String::code_unit_at rewritten to utf16_code_unit_at: " + out)
  assert_true(str_has(out, "b.code_unit_at(i)"), "Bytes::code_unit_at kept intact: " + out)
  assert_true(!str_has(out, "mbt_code_unit_at_probe"), "no probe residual")
}

test "F5-1-2: match-arm sibling tuple inference disambiguates ambiguous local ctors without leading dot" {
  let src =
  "enum AnchorSide {\n  Below\n  Above\n  Right\n  Left\n}\n" +
  "enum DrawerEdge {\n  Top\n  Bottom\n  Left\n  Right\n}\n" +
  "pub fn flip(asked : AnchorSide, a : Double, b : Double) -> AnchorSide {\n" +
  "  let (_, _, other) = match asked {\n" +
  "    Below => (a, b, Above)\n" +
  "    Above => (b, a, Below)\n" +
  "    Right => (a, b, Left)\n" +
  "    Left => (b, a, Right)\n" +
  "  }\n" +
  "  other\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "anc.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let mut amb_cnt = 0
  for d in res.diagnostics {
    if d.code == "MBT2PION_AMBIGUOUS_CTOR" {
      amb_cnt = amb_cnt + 1
    }
  }
  let out = res.files[0].content
  assert_true(amb_cnt == 0, "expected 0 AMBIGUOUS_CTOR, got " + amb_cnt.to_string() + "\nout:\n" + out)
  assert_true(str_has(out, "AnchorSide::Left"), "Left qualified as AnchorSide::Left:\n" + out)
  assert_true(str_has(out, "AnchorSide::Right"), "Right qualified as AnchorSide::Right:\n" + out)
}

test "F5-1-3: match recv.field.get(...) infers arm type before map value fallback for struct update" {
  let src =
  "pub struct GroundShape {\n  dx : Double\n  dh : Double\n}\n" +
  "struct Look {\n  mut ground_drawn : GroundShape\n}\n" +
  "struct Node {\n  look : Look\n  h : Double\n}\n" +
  "pub struct Tree {\n  nodes : Array[Node]\n  shown_bys : Map[Int, (Int, (Double) -> GroundShape)]\n}\n" +
  "pub fn Tree::drawn(self : Tree, idx : Int, less : Double) -> GroundShape {\n" +
  "  let g = match self.shown_bys.get(idx) {\n" +
  "    Some((of, f)) if of >= 0 => f(self.nodes[of].h)\n" +
  "    _ => self.nodes[idx].look.ground_drawn\n" +
  "  }\n" +
  "  let g = if less != 0.0 { { ..g, dh: g.dh - less } } else { g }\n" +
  "  g\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "tr.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let mut amb_su = 0
  for d in res.diagnostics {
    if d.code == "MBT2PION_AMBIGUOUS_STRUCT_UPDATE" {
      amb_su = amb_su + 1
    }
  }
  let out = res.files[0].content
  assert_true(amb_su == 0, "expected 0 AMBIGUOUS_STRUCT_UPDATE, got " + amb_su.to_string() + "\nout:\n" + out)
  assert_true(str_has(out, "GroundShape::{"), "struct update lowered to GroundShape::{}:\n" + out)
}

test "F5-1-4: unqualified Number(d, ..) pattern in untyped closure lowers to MbtJson::Number" {
  let src =
  "pub fn nums(a : Array[Json]) -> Array[Double] {\n" +
  "  a.map(fn(v) {\n" +
  "    match v {\n" +
  "      Number(d, ..) => d\n" +
  "      _ => 0.0\n" +
  "    }\n" +
  "  })\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "jn.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let mut man_cnt = 0
  for d in res.diagnostics {
    if d.code == "MBT2PION_MANUAL" {
      man_cnt = man_cnt + 1
    }
  }
  let out = res.files[0].content
  assert_true(man_cnt == 0, "expected 0 MBT2PION_MANUAL, got " + man_cnt.to_string() + "\nout:\n" + out)
  assert_true(str_has(out, "mbt_compat::MbtJson::Number(d, _)"), "Number(d, ..) lowered cleanly:\n" + out)
}

test "F5-1-5: integer and char range patterns lower to guarded match arms" {
  let src =
  "pub fn classify(code : Int) -> Int {\n" +
  "  match code {\n" +
  "    0..=15 => 1\n" +
  "    16..=231 => 2\n" +
  "    232..=255 => 3\n" +
  "    _ => 0\n" +
  "  }\n" +
  "}\n" +
  "pub fn is_hex(c : Char) -> Bool {\n" +
  "  match c {\n" +
  "    '0'..='9' | 'a'..='f' | 'A'..='F' => true\n" +
  "    _ => false\n" +
  "  }\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "rng.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_true(res.blockers == 0, "range patterns must transpile with 0 blockers")
  let out = res.files[0].content
  assert_true(str_has(out, ">= 16 &&") && str_has(out, "<= 231"), "int range lowered:\n" + out)
  assert_true(str_has(out, ">= '0' &&") && str_has(out, "<= '9'"), "char range lowered:\n" + out)
}

test "F5-1-6: impl Debug for T with to_repr lowers to T::to_repr and resolves nested Show+Debug probes" {
  let src =
  "pub struct Tag {\n  name : String\n}\n" +
  "pub impl Show for Tag with output(self, logger) {\n" +
  "  logger.write_string(self.name)\n" +
  "}\n" +
  "pub impl Debug for Tag with to_repr(self) {\n" +
  "  Repr(Show::to_string(self))\n" +
  "}\n"
  let check_fn = fn(files : Array[(String, String)]) -> String {
    let diags : Array[String] = []
    for pair in files {
      if pair.0 == "dbg.pion" {
        let txt = pair.1
        let needles = ["mbt_show_trait_probe__", "mbt_debug_probe__", "mbt_show_probe__"]
        for needle in needles {
          let mut pos = 0
          while pos < txt.length() {
            let rest = txt.slice(pos, txt.length())
            let idx = rest.index_of(needle)
            if idx < 0 { break }
            let abs_i = pos + idx
            let mut end_i = abs_i + needle.length()
            while end_i < txt.length() {
              let ch = txt.code_unit_at(end_i)
              if (ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 122) || ch == 95 {
                end_i = end_i + 1
              } else {
                break
              }
            }
            let mname = txt.slice(abs_i, end_i)
            let ty = if needle == "mbt_show_trait_probe__" {
              "Tag"
            } else if needle == "mbt_show_probe__" {
              "StringBuilder"
            } else {
              "String"
            }
            diags.push("{\"file\":\"dbg.pion\",\"line\":10,\"col\":1,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `" + mname + "` on type `" + ty + "`\"}")
            pos = end_i
          }
        }
      }
    }
    if diags.length() == 0 {
      "{\"ok\":true,\"diagnostics\":[]}"
    } else {
      "{\"ok\":false,\"diagnostics\":[" + join_comma(diags) + "]}"
    }
  }
  let res = transpile_package(
    [SourceFile::{ rel_path: "dbg.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    true,
    check_fn,
  )
  let out = res.files[0].content
  assert_true(res.blockers == 0, "Debug::to_repr with nested Show::to_string must resolve with 0 blockers:\n" + out)
  assert_true(str_has(out, "pub fn Tag::to_repr(self : Tag) -> String"), "impl Debug lowered to Tag::to_repr:\n" + out)
  assert_true(!str_has(out, "impl Debug"), "no Pion impl Debug emitted:\n" + out)
  assert_true(!str_has(out, "__mbt_debug_fmt") && !str_has(out, "__mbt_show_trait"), "all nested probes resolved:\n" + out)
}

test "F5-1-7: unresolved code_unit_at probe fails closed (negative)" {
  let src =
  "pub fn bad_cu(s : String, i : Int) -> Int {\n" +
  "  s.code_unit_at(i)\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "neg_cu.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    true,
    noop_check,
  )
  assert_true(res.blockers > 0, "unresolved code_unit_at probe must fail closed with blockers > 0")
}
