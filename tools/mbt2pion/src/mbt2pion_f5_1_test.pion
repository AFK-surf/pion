test "F5-1-14: local fn abort() is not treated as diverging in infer_match_arms_common_type" {
  let src =
  "enum SideA {\n  OnlyA\n  Shared\n}\n" +
  "enum SideB {\n  OnlyB\n  Shared\n}\n" +
  "fn abort() -> SideA {\n  OnlyA\n}\n" +
  "pub fn pick(flag : Bool) -> SideA {\n" +
  "  let x = match flag {\n" +
  "    true => abort()\n" +
  "    false => Shared\n" +
  "  }\n" +
  "  x\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "loc_abort.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let out = res.files[0].content
  assert_true(str_has(out, "SideA::Shared"), "local fn abort() return type SideA must disambiguate Shared:\n" + out)
}
