test "F5-1-12: infer_match_arms_common_type skips diverging return/panic arm" {
  let src =
  "enum AnchorSide {\n  Below\n  Above\n  Right\n  Left\n}\n" +
  "enum DrawerEdge {\n  Top\n  Bottom\n  Left\n  Right\n}\n" +
  "pub fn pick_or_ret(asked : AnchorSide, stop : Bool) -> Int {\n" +
  "  let side = match asked {\n" +
  "    Below => if stop { return 0 } else { Above }\n" +
  "    Above => return 1\n" +
  "    Right => Left\n" +
  "    Left => Right\n" +
  "  }\n" +
  "  match side {\n" +
  "    AnchorSide::Below => 1\n" +
  "    AnchorSide::Above => 2\n" +
  "    AnchorSide::Right => 3\n" +
  "    AnchorSide::Left => 4\n" +
  "  }\n" +
  "}\n"
  let res = transpile_package(
    [SourceFile::{ rel_path: "div_arm.mbt", content: src, is_test: false }],
    empty_api_map(),
    default_recipes(),
    [],
    [],
    default_options(),
    [],
    false,
    noop_check,
  )
  let out = res.files[0].content
  assert_true(str_has(out, "AnchorSide::Left") && str_has(out, "AnchorSide::Right"), "diverging return arm must not block sibling ctor inference:\n" + out)
}

