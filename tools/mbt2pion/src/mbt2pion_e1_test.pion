///| Wave M2-E1 unit tests: chained call scrut_ty + impl self binding,
///| deterministic enum disambiguation (Layer 1/2/3 + has_probe_residual),
///| leading/middle array rest patterns, and strictly whitelisted read-only slices.

test "e1-1: chained method call clears scrut_ty and impl binds self" {
  let src = SourceFile::{
    rel_path: "e11.mbt",
    content: "fn pk_info() -> String { \"a\\tb\\tc\" }\npub fn parse_info() -> Int {\n  let info = pk_info().split(\"\\t\").to_array()\n  match info {\n    [a, b, c] => a.length() + b.length() + c.length()\n    _ => 0\n  }\n}\npub enum Tab { Downloads; Photos }\npub enum Other { Downloads; Photos }\nimpl Show for Tab with output(self, logger) {\n  match self {\n    Downloads => logger.write_string(\"d\")\n    Photos => logger.write_string(\"p\")\n  }\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::__mbt_arrpat_len("), "chained call defers array pattern check to Stage A.5 probe")
  assert_true(str_has(out, "Tab::Downloads"), "impl self binding disambiguates Tab::Downloads")
  assert_true(str_has(out, "Tab::Photos"), "impl self binding disambiguates Tab::Photos")
  for d in res.diagnostics {
    assert_true(d.code == "MBT2PION_PROBE_RESIDUAL", "only expected deferred Stage A.5 probe residual with run_probes=false")
  }
}

test "e1-2: Layer 1 intersection, Layer 2 opt-default/call-arg, Layer 3 probe & residual" {
  let src = SourceFile::{
    rel_path: "e12.mbt",
    content: "pub(all) enum KindA { Single(collapsible~ : Bool); Multi }\npub(all) enum KindB { Single(collapsible~ : Bool); Other }\npub fn mk(kind? : KindA = Single(collapsible=true)) -> Int {\n  match kind { Single(collapsible~) => if collapsible { 1 } else { 0 }, Multi => 2 }\n}\npub fn pick_b(x : KindB) -> Int {\n  match x { Single(collapsible~) => if collapsible { 3 } else { 4 }, Other => 5 }\n}\npub fn call_site() -> Int { pick_b(Single(collapsible=true)) }\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "KindA::Single(true)"), "optional param default propagates KindA before label reorder")
  assert_true(str_has(out, "KindB::Single(true)"), "call arg propagates KindB before label reorder")

  // Layer 3: ambiguous match with reversed label order and opaque scrutinee emits __mbt_match_scrut placeholder
  let amb = SourceFile::{
    rel_path: "e12_amb.mbt",
    content: "pub(all) enum E1 { C(x~ : Int, y~ : Int) }\npub(all) enum E2 { C(y~ : Int, x~ : Int) }\npub fn run(w : Int) -> Int {\n  match @ext.fetch(w) {\n    C(x~, y~) => 10 * x + y\n  }\n}\n",
    is_test: false,
  }
  let amb_res = transpile_package([amb], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(str_has(amb_res.files[0].content, "mbt_compat::__mbt_match_scrut("), "ambiguous match emits __mbt_match_scrut probe")
  // Exact residual checks: user identifiers allowed; real probe calls rejected
  assert_true(!has_probe_residual("fn mbt_match_scrut_probe_count() -> Int { 1 }\n"), "user fn must not trigger residual")
  assert_true(has_probe_residual("pub fn f(x : Int) -> Int { (x).mbt_match_scrut_probe__p1() }\n"), "real .mbt_match_scrut_probe__p1() flagged")
  assert_true(has_probe_residual("pub fn f(x : Int) -> Int { mbt_compat::__mbt_match_scrut(x, \"{}\") }\n"), "real __mbt_match_scrut flagged")
}

test "e1-3: leading/middle rest patterns and double-rest fail-closed" {
  let ok = SourceFile::{
    rel_path: "e13.mbt",
    content: "pub fn last_elem(xs : Array[Int]) -> Int {\n  match xs {\n    [.., last] => last\n    _ => -1\n  }\n}\npub fn mid_borrow() -> Int {\n  let xs = [10, 20, 30]\n  match xs {\n    [_, .. as mid, _] => { xs[1] = 50; mid[0] }\n    _ => -1\n  }\n}\n",
    is_test: false,
  }
  let res = transpile_package([ok], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let out = res.files[0].content
  assert_true(str_has(out, "ArrayBuf::from_array"), "local xs promoted to ArrayBuf for .. as mid")
  assert_true(str_has(out, "mbt_compat::__mbt_slice_borrow("), ".. as mid uses borrowed slice helper")
  for d in res.diagnostics {
    assert_true(d.code == "MBT2PION_PROBE_RESIDUAL", "only expected deferred Stage A.5 probe residual with run_probes=false")
  }

  let bad = SourceFile::{
    rel_path: "e13_bad.mbt",
    content: "pub fn bad(xs : Array[Int]) -> Int { match xs { [.., _, ..] => 1, _ => 0 } }\n",
    is_test: false,
  }
  let bad_res = transpile_package([bad], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "double rest pattern must fail closed")
  assert_true(bad_res.diagnostics[0].code == "MBT2PION_UNSUPPORTED_SYNTAX", "must emit MBT2PION_UNSUPPORTED_SYNTAX")
}

test "e1-4: read-only slice consumer classification" {
  let src = SourceFile::{
    rel_path: "e14.mbt",
    content: "pub struct H { arr : Array[Int]; strs : Array[String] }\npub fn ok(h : H, sep : String) -> (Int, Bool, Array[Int], String, String, String) {\n  (h.arr[0:2].length(), h.arr[0:2].is_empty(), h.arr[0:2].to_array(), h.strs[:2].join(\"-\"), h.strs[:2].join(sep), \"\\{h.arr[0:2]}\")\n}\npub fn bad_join(h : H) -> String { h.strs[:].join({ h.strs[0] = \"z\"; \"-\" }) }\npub fn bad_iter(h : H) -> Int { let it = h.arr[0:2].iter(); it.count() }\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  let out = res.files[0].content
  assert_true(str_has(out, "__mbt_slice_owned(h.arr, 0, 2).length()"), ".length() uses __mbt_slice_owned")
  assert_true(str_has(out, "__mbt_slice_owned(h.arr, 0, 2, \"__IS_EMPTY__\")"), ".is_empty() uses __mbt_slice_owned")
  assert_true(str_has(out, "__mbt_slice_ro_join(h.strs, 0, 2, \"-\")"), "pure literal .join uses __mbt_slice_ro_join")
  assert_true(str_has(out, "__mbt_slice_ro_join(h.strs, 0, 2, sep)"), "pure ident .join uses __mbt_slice_ro_join")
  assert_true(str_has(out, "__mbt_slice_ro_show(h.arr, 0, 2)"), "interp slice uses __mbt_slice_ro_show")
  assert_true(str_has(out, "__mbt_slice_borrow(__mbt_sl_"), "impure .join stays __mbt_slice_borrow")
  assert_true(str_has(out, "__mbt_slice_borrow(h.arr, 0, 2).iter()"), ".iter() stays __mbt_slice_borrow")
  // Exact residual checks for ro_join / ro_show: user identifiers allowed; real probe calls rejected
  assert_true(!has_probe_residual("fn mbt_slice_ro_join_probe_count() -> Int { 1 }\n"), "user fn mbt_slice_ro_join_probe_count must not trigger residual")
  assert_true(!has_probe_residual("fn mbt_slice_ro_show_probe_count() -> Int { 1 }\n"), "user fn mbt_slice_ro_show_probe_count must not trigger residual")
  assert_true(has_probe_residual("pub fn f(x : Int) -> Int { (x).mbt_slice_ro_join_probe__p1() }\n"), "real .mbt_slice_ro_join_probe__p1() flagged")
  assert_true(has_probe_residual("pub fn f(x : Int) -> Int { mbt_compat::__mbt_slice_ro_show(x, 0, 1) }\n"), "real __mbt_slice_ro_show flagged")
}
