///| Wave M2-F3d-1a: `Array::shrink_to_fit()` on an array kept as a Pion `Array`.
///|
///| MoonBit's `shrink_to_fit` moves the elements to an exact-size buffer when the capacity exceeds the length.
///| A borrowed view promotes the array to `mbt_compat::ArrayBuf` (whose `shrink_to_fit` reallocates exactly) and
///| `.capacity()` has no Pion `Array` lowering, so the one remaining observer is a buffer snapshot that outlives
///| the call: `Array::iter()` (`self[:].iter()`), `for x in xs` and the `each`-style callbacks all read the buffer
///| they started with, so after a shrink they stop seeing in-place writes that a Pion `Array` (one live storage)
///| still shows:
///|
///|   for x in xs { if x == 1 { xs.shrink_to_fit(); xs[1] = 9 } }   // MoonBit visits [1, 2, 3], live storage [1, 9, 3]
///|
///| `mbt_compat::arr_shrink_to_fit` (evaluate the receiver, nothing else) is therefore only emitted when the
///| enclosing function has no such snapshot around the call: the call is not inside a `for .. in` loop body nor
///| inside a closure handed to an iteration helper (`each`, `fold`, `map`, ..., any `mbt_compat::` helper), and the
///| function keeps no array iterator beyond the expression that creates it (`arr_iter(..)` / `.iter()` not
///| immediately consumed through `.method(..)`); a kept iterator may not leave its function either
///| (`kept_iter_hazard`, `MBT2PION_ARRAY_ITER_MUTATION`). Anything else fails closed with
///| `MBT2PION_ARRAY_SHRINK_ITER`.

fn is_iteration_callee(name : String) -> Bool {
  name == "each" || name == "eachi" || name == "rev_each" || name == "rev_eachi" || name == "map" ||
  name == "mapi" || name == "map_in_place" || name == "filter" || name == "filter_map" || name == "flat_map" ||
  name == "fold" || name == "rev_fold" || name == "any" || name == "all" || name == "find_first" ||
  name == "find_index" || name == "search_by" || name == "retain" || name == "sort_by" ||
  name == "sort_by_key" || name == "iter" || name == "iter2" || name == "each_while" || name == "dedup" ||
  name == "take_while" || name == "drop_while" || name == "tap" || name == "for_each" || name == "foldi"
}

///| Index of the token matching the delimiter that closes at `close_idx` (scanning backwards), or -1.
fn find_open_before(tokens : Array[Token], close_idx : Int, lo : Int) -> Int {
  let mut d = 0
  let mut k = close_idx
  while k >= lo {
    let kk = tokens[k].kind
    if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d + 1
    } else if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d - 1
      if d == 0 {
        return k
      }
    }
    k = k - 1
  }
  -1
}

///| Innermost unmatched opener of kind `want` before `idx` (not past `lo`), or -1.
fn enclosing_open(tokens : Array[Token], idx : Int, lo : Int, want : TokenKind) -> Int {
  let mut d = 0
  let mut k = idx - 1
  while k >= lo {
    let kk = tokens[k].kind
    if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d + 1
    } else if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 {
        if kk == want {
          return k
        }
      } else {
        d = d - 1
      }
    }
    k = k - 1
  }
  -1
}

fn is_terminal_iter_consumer(name : String) -> Bool {
  name == "any" || name == "all" || name == "count" || name == "collect" || name == "to_array" ||
  name == "fold" || name == "each" || name == "eachi" || name == "find_first" || name == "join" ||
  name == "contains" || name == "last" || name == "head" || name == "nth" || name == "is_empty"
}

///| The iterator ending at `close_p` (the `)` of `arr_iter(..)` / `.iter()`) is consumed by the same expression:
///| a chain of `.m(..)` calls (all on the same line run) ending in a terminal consumer.
fn iter_chain_is_consumed(tokens : Array[Token], close_p : Int) -> Bool {
  let n = tokens.length()
  let mut c = close_p
  while c + 3 < n && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
  tokens[c + 3].kind == TokenKind::LParen {
    // The first terminal consumer ends the iterator (what follows works on its result).
    if is_terminal_iter_consumer(tokens[c + 2].raw) {
      return true
    }
    c = find_matching_delim(tokens, c + 3)
    if c < 0 {
      return false
    }
  }
  false
}

///| The `for .. in g` (iterable `(in_i, open)`) iterates `g`, a local bound once to a fresh array
///| (an array literal, `mbt_compat::arr_copy(..)`, or `<path>.field.copy()` where every `field` the package
///| declares is an `Array[..]`, i.e. the built-in copy) and used nowhere else: no other array can be that buffer,
///| so a shrink of any array inside the loop is unobservable by the loop. 1 = proven, -1 = not proven.
fn loop_iterable_private_copy(
  tokens : Array[Token],
  body_open : Int,
  body_close : Int,
  in_i : Int,
  open : Int,
  array_fields : Map[String, Bool],
) -> Int {
  if in_i < 0 || open != in_i + 2 || tokens[in_i + 1].kind != TokenKind::Ident {
    return -1
  }
  let g = tokens[in_i + 1].raw
  let mut status = -1
  let mut uses = 0
  let mut k = body_open + 1
  while k < body_close {
    let tk = tokens[k]
    let qualified = k > 0 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)
    if tk.kind == TokenKind::Ident && tk.raw == g && !qualified {
      let is_binder = k > 0 && (tokens[k - 1].raw == "let" || tokens[k - 1].raw == "mut")
      if is_binder {
        if status != -1 || k > in_i {
          return -1
        }
        // `let g = <rhs>` (no annotation): the rhs runs to the next statement.
        if k + 2 >= body_close || tokens[k + 1].kind != TokenKind::Eq {
          return -1
        }
        let rs = k + 2
        if tokens[rs].kind == TokenKind::LBracket {
          let c = find_matching_delim(tokens, rs)
          status = if c + 1 < body_close && tokens[c + 1].newline_before { 1 } else { -1 }
        } else if tokens[rs].raw == "mbt_compat" && rs + 3 < body_close && tokens[rs + 1].kind == TokenKind::ColonColon &&
        tokens[rs + 2].raw == "arr_copy" && tokens[rs + 3].kind == TokenKind::LParen {
          let c = find_matching_delim(tokens, rs + 3)
          status = if c + 1 < body_close && tokens[c + 1].newline_before { 1 } else { -1 }
        } else {
          // `<path>.field.copy()` closing the statement, `field` an array everywhere: the built-in copy.
          let mut e = rs
          while e + 1 < body_close && !tokens[e + 1].newline_before {
            e = e + 1
          }
          let is_copy = e >= rs + 5 && tokens[e].kind == TokenKind::RParen && tokens[e - 1].kind == TokenKind::LParen &&
          tokens[e - 2].raw == "copy" && tokens[e - 3].kind == TokenKind::Dot && tokens[e - 4].kind == TokenKind::Ident &&
          tokens[e - 5].kind == TokenKind::Dot
          let field_is_array = is_copy &&
          (match array_fields.get(tokens[e - 4].raw) {
            Some(v) => v
            None => false
          })
          status = if field_is_array { 1 } else { -1 }
        }
      } else if k != in_i + 1 {
        uses = uses + 1
      }
    }
    k = k + 1
  }
  if uses > 0 { -1 } else { status }
}

///| Why the block structure around token `idx` (inside the function body `(body_open, body_close)`) iterates a
///| buffer snapshot -- a `for .. in` body (unless over a private copy) or a closure handed to an iteration helper --
///| or "".
fn iteration_scope_reason(
  tokens : Array[Token],
  idx : Int,
  body_open : Int,
  body_close : Int,
  array_fields : Map[String, Bool],
  private_names : Map[String, Bool],
) -> String {
  let mut b = idx
  while true {
    let o = enclosing_open(tokens, b, body_open, TokenKind::LBrace)
    if o < 0 || o <= body_open {
      break
    }
    // Header of this block: walk back over its statement to find `for .. in` or `fn(..)`; a block expression in
    // the header (`for x in if c { xs } else { ys } {`) is stepped over as a unit.
    let mut h = o - 1
    let mut d = 0
    let mut saw_in = false
    let mut in_i = -1
    let mut kind = ""
    while h > body_open {
      let hk = tokens[h].kind
      if hk == TokenKind::RBrace && d == 0 {
        if tokens[h].newline_before {
          break
        }
        let ob = find_open_before(tokens, h, body_open)
        if ob <= body_open {
          break
        }
        h = ob - 1
        continue
      }
      if hk == TokenKind::RParen || hk == TokenKind::RBracket || hk == TokenKind::RBrace {
        d = d + 1
      } else if hk == TokenKind::LParen || hk == TokenKind::LBracket || hk == TokenKind::LBrace {
        if d == 0 {
          break
        }
        d = d - 1
      } else if d == 0 && tokens[h].raw == "in" {
        saw_in = true
        in_i = h
      } else if d == 0 && tokens[h].raw == "for" {
        if saw_in {
          kind = "for"
        }
        break
      } else if d == 0 && tokens[h].raw == "fn" {
        kind = "fn"
        break
      } else if d == 0 && tokens[h].newline_before && (tokens[h].raw == "let" || tokens[h].raw == "if" ||
        tokens[h].raw == "while" || tokens[h].raw == "match" || tokens[h].raw == "else") {
        break
      }
      h = h - 1
    }
    // A loop over something that cannot be the private array (`private_names`: its names) reads another buffer.
    let other = private_names.length() > 0 && kind == "for" && !span_mentions(tokens, in_i + 1, o, private_names)
    if kind == "for" && !other {
      if loop_iterable_private_copy(tokens, body_open, body_close, in_i, o, array_fields) != 1 {
        return "it runs inside a `for .. in` loop body (the loop reads the buffer it started with)"
      }
    }
    if kind == "fn" {
      // A closure: what call is it an argument of?
      let p = enclosing_open(tokens, h, body_open, TokenKind::LParen)
      if p > 0 {
        let callee_i = p - 1
        let callee = tokens[callee_i].raw
        let via_compat = callee_i >= 2 && tokens[callee_i - 1].kind == TokenKind::ColonColon &&
        tokens[callee_i - 2].raw == "mbt_compat"
        if via_compat || is_iteration_callee(callee) {
          return "it runs inside a callback passed to `" + callee + "(...)` (an iteration reads the buffer it started with)"
        }
      }
    }
    b = o
  }
  ""
}

///| Outermost `{` around `idx` (its top-level function or test body), or -1.
fn outermost_body_open(tokens : Array[Token], idx : Int) -> Int {
  let mut body_open = -1
  let mut k = idx
  while true {
    let o = enclosing_open(tokens, k, 0, TokenKind::LBrace)
    if o < 0 {
      break
    }
    body_open = o
    k = o
  }
  body_open
}

///| What the whole package tells about buffer snapshots that a `shrink_to_fit` in one function could meet in
///| another (`collect_shrink_pkg`).
pub struct ShrinkPkg {
  array_fields : Map[String, Bool]
  // Last name of every path iterated (a `for .. in` body, an iteration callback, a kept iterator) where the
  // iteration may call a function of the package (which could shrink that array).
  iterated_tails : Map[String, String]
  // `pub` functions / methods of the package (callers outside it may iterate what they are given).
  risky_fns : Map[String, String]
  // Functions / methods a snapshot of the package could be live around: called inside an iteration scope or used as
  // a value, and (transitively) everything they call.
  iter_fns : Map[String, String]
  // Fields readable outside the package (a `pub struct` field without `priv`), plus internal
  // `" confined_field:<f>"` / `" confined_global:<g>"` proofs for package-confined private arrays.
  visible_fields : Map[String, Bool]
}

pub fn ShrinkPkg::empty() -> ShrinkPkg {
  ShrinkPkg::{ array_fields: Map(), iterated_tails: Map(), risky_fns: Map(), iter_fns: Map(), visible_fields: Map() }
}

///| Name of the path ending at `end_idx` (`a.b.c` -> `c`; `f(x).c` -> `c`), or "".
fn path_tail(tokens : Array[Token], end_idx : Int) -> String {
  if end_idx >= 0 && tokens[end_idx].kind == TokenKind::Ident { tokens[end_idx].raw } else { "" }
}

///| Package function / method names declared in `ts` (`fn f(`, `fn T::m(`), with whether they are `pub`.
fn declared_fns(ts : Array[Token], out : Map[String, Bool]) -> Unit {
  let n = ts.length()
  let mut i = 0
  while i + 1 < n {
    if ts[i].raw == "fn" && ts[i + 1].kind != TokenKind::LParen {
      let mut j = i + 1
      if j + 2 < n && ts[j + 1].kind == TokenKind::ColonColon {
        j = j + 2
      }
      if ts[j].kind == TokenKind::Ident {
        let is_pub = i > 0 && ts[i - 1].raw == "pub"
        let prev = match out.get(ts[j].raw) {
          Some(v) => v
          None => false
        }
        out[ts[j].raw] = prev || is_pub
      }
    }
    i = i + 1
  }
}

///| `[s, e)` calls a function or method the package declares.
fn calls_package_fn(ts : Array[Token], s : Int, e : Int, fns : Map[String, Bool]) -> Bool {
  let mut k = s
  while k + 1 < e {
    if ts[k].kind == TokenKind::Ident && ts[k + 1].kind == TokenKind::LParen && fns.contains(ts[k].raw) &&
    !(k > 0 && ts[k - 1].raw == "fn") {
      return true
    }
    k = k + 1
  }
  false
}

///| `[s, e)` calls a package function/method OR an opaque callback/closure/indirect/cross-package call
///| that could re-enter a `pub fn` in this package while an iteration snapshot is live (P1-5).
fn calls_package_fn_or_opaque(
  ts : Array[Token],
  s : Int,
  e : Int,
  fns : Map[String, Bool],
  body_open : Int,
) -> Bool {
  if calls_package_fn(ts, s, e, fns) {
    return true
  }
  let callables = if body_open >= 0 { callable_locals(ts, body_open) } else { Map() }
  let mut k = s
  while k + 1 < e {
    let tk = ts[k]
    // Indirect call `(...)(...)` or `arr[i](...)`
    if (tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket) &&
    ts[k + 1].kind == TokenKind::LParen && !ts[k + 1].newline_before {
      return true
    }
    // Opaque closure variable/parameter call `cb(...)` or passing a closure value
    if is_opaque_call_at(ts, k, e, callables) || passes_closure_value(ts, k, e, callables) {
      return true
    }
    // Cross-package qualified call `dep::f(...)` (excluding `mbt_compat::` and constructors)
    if tk.kind == TokenKind::Ident && ts[k + 1].kind == TokenKind::LParen && !ts[k + 1].newline_before &&
    k >= 2 && ts[k - 1].kind == TokenKind::ColonColon && ts[k - 2].raw != "mbt_compat" && !is_ctor_name(tk.raw) {
      return true
    }
    k = k + 1
  }
  false
}

///| Builds `ShrinkPkg` from the package's generated files (lexes each file once).
pub fn collect_shrink_pkg(contents : Array[String]) -> ShrinkPkg {
  let all_tokens : Array[Array[Token]] = []
  for c in contents {
    all_tokens.push(lex_moonbit(c))
  }
  collect_shrink_pkg_from_tokens(all_tokens)
}

///| Builds `ShrinkPkg` directly from pre-lexed package token streams (zero re-lexing).
pub fn collect_shrink_pkg_from_tokens(all_tokens : Array[Array[Token]]) -> ShrinkPkg {
  let pkg = ShrinkPkg::empty()
  let fns : Map[String, Bool] = Map()
  for ts in all_tokens {
    declared_fns(ts, fns)
  }
  for k in fns.keys() {
    if fns.get(k) == Some(true) {
      pkg.risky_fns[k] = "it is `pub` (a caller outside the package may iterate the array)"
    }
  }
  let afs = collect_array_fields_from_tokens(all_tokens)
  for k in afs.keys() {
    match afs.get(k) {
      Some(v) => pkg.array_fields[k] = v
      None => ()
    }
  }
  for ts in all_tokens {
    let n = ts.length()
    // Visible fields: `pub struct S { f : T }` without `priv`.
    let mut i = 0
    while i < n {
      if ts[i].raw == "struct" && i > 0 && ts[i - 1].raw == "pub" {
        let mut o = i + 1
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          while k > 0 && k + 1 < close {
            if ts[k].kind == TokenKind::Ident && ts[k + 1].kind == TokenKind::Colon &&
            (ts[k].newline_before || ts[k - 1].raw == "mut") {
              let hidden = ts[k - 1].raw == "priv" || k >= 2 && ts[k - 1].raw == "mut" && ts[k - 2].raw == "priv"
              if !hidden {
                pkg.visible_fields[ts[k].raw] = true
              }
            }
            k = k + 1
          }
        }
      }
      i = i + 1
    }
    // Iterations and the functions called inside them.
    let mut t = 0
    while t + 2 < n {
      let tk = ts[t]
      // Calls inside an iteration scope; functions used as values.
      if tk.kind == TokenKind::Ident && fns.contains(tk.raw) && !(t > 0 && ts[t - 1].raw == "fn") &&
      !(t >= 2 && ts[t - 1].kind == TokenKind::ColonColon && ts[t - 2].raw == "fn") {
        let is_call = ts[t + 1].kind == TokenKind::LParen
        let is_decl = t >= 2 && ts[t - 1].kind == TokenKind::ColonColon && t >= 3 && ts[t - 3].raw == "fn"
        if !is_call && !is_decl && !pkg.iter_fns.contains(tk.raw) &&
        !(t > 0 && ts[t - 1].kind == TokenKind::Dot) {
          pkg.iter_fns[tk.raw] = "it is used as a function value"
        } else if is_call && !pkg.iter_fns.contains(tk.raw) {
          let bo = outermost_body_open(ts, t)
          if bo >= 0 {
            let bc = find_matching_delim(ts, bo)
            if iteration_scope_reason(ts, t, bo, bc, pkg.array_fields, Map()).length() > 0 {
              pkg.iter_fns[tk.raw] = "it is called inside an iteration (line " + tk.line.to_string() + ")"
            }
          }
        }
      }
      // `for .. in <path> {` whose body calls a package function.
      if tk.raw == "for" && (tk.kind == TokenKind::Keyword || tk.kind == TokenKind::Ident) {
        let mut j = t + 1
        let mut in_i = -1
        while j < n && ts[j].kind != TokenKind::LBrace && !ts[j].newline_before {
          if ts[j].raw == "in" {
            in_i = j
          }
          j = j + 1
        }
        if in_i > 0 && j < n && ts[j].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, j)
          let bo = outermost_body_open(ts, t)
          let private = bo >= 0 &&
          loop_iterable_private_copy(ts, bo, find_matching_delim(ts, bo), in_i, j, pkg.array_fields) == 1
          let mut tail_i = j - 1
          if tail_i >= 3 && ts[tail_i].kind == TokenKind::RParen && ts[tail_i - 1].kind == TokenKind::LParen &&
          ts[tail_i - 2].raw == "iter" && ts[tail_i - 3].kind == TokenKind::Dot {
            tail_i = tail_i - 4
          }
          let tail = path_tail(ts, tail_i)
          if !private && tail.length() > 0 && calls_package_fn_or_opaque(ts, j, close, fns, bo) {
            pkg.iterated_tails[tail] = "line " + tk.line.to_string()
          }
        }
      }
      // `<path>.each(fn ..)` (and other iteration callees) / `mbt_compat::arr_each(<path>, fn ..)`.
      if tk.kind == TokenKind::Dot && ts[t + 1].kind == TokenKind::Ident && ts[t + 2].kind == TokenKind::LParen &&
      (is_iteration_callee(ts[t + 1].raw) || ts[t + 1].raw == "iter" || ts[t + 1].raw == "search_by") && t > 0 {
        let close = find_matching_delim(ts, t + 2)
        let mut chain_end = close
        while chain_end + 3 < n && ts[chain_end + 1].kind == TokenKind::Dot && ts[chain_end + 3].kind == TokenKind::LParen {
          chain_end = find_matching_delim(ts, chain_end + 3)
        }
        let tail = path_tail(ts, t - 1)
        let bo = outermost_body_open(ts, t)
        let kept = ts[t + 1].raw == "iter" && !iter_chain_is_consumed(ts, close)
        let scope_end = if kept {
          if bo >= 0 { find_matching_delim(ts, bo) } else { chain_end }
        } else {
          chain_end
        }
        if tail.length() > 0 && chain_end > t && calls_package_fn_or_opaque(ts, t + 1, scope_end, fns, bo) {
          pkg.iterated_tails[tail] = "line " + tk.line.to_string()
        }
      }
      if tk.raw == "mbt_compat" && ts[t + 1].kind == TokenKind::ColonColon && t + 4 < n &&
      ts[t + 2].raw.starts_with("arr_") && ts[t + 3].kind == TokenKind::LParen &&
      (is_iteration_callee(ts[t + 2].raw.slice(4, ts[t + 2].raw.length())) || ts[t + 2].raw == "arr_iter" ||
        ts[t + 2].raw == "arr_search_by") {
        let close = find_matching_delim(ts, t + 3)
        let mut chain_end = close
        while chain_end + 3 < n && ts[chain_end + 1].kind == TokenKind::Dot && ts[chain_end + 3].kind == TokenKind::LParen {
          chain_end = find_matching_delim(ts, chain_end + 3)
        }
        let mut a = t + 4
        while a + 1 < close && ts[a + 1].kind != TokenKind::Comma && ts[a + 1].kind != TokenKind::RParen {
          a = a + 1
        }
        let tail = path_tail(ts, a)
        let bo = outermost_body_open(ts, t)
        let kept = ts[t + 2].raw == "arr_iter" && !iter_chain_is_consumed(ts, close)
        let scope_end = if kept {
          if bo >= 0 { find_matching_delim(ts, bo) } else { chain_end }
        } else {
          chain_end
        }
        if tail.length() > 0 && chain_end > t && calls_package_fn_or_opaque(ts, t + 2, scope_end, fns, bo) {
          pkg.iterated_tails[tail] = "line " + tk.line.to_string()
        }
      }
      t = t + 1
    }
  }
  // Call graph (top-level function name -> package functions its body calls), then everything reachable from a
  // function called inside an iteration (or used as a value) can run inside that iteration too.
  let callees : Map[String, Array[String]] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i + 1 < n {
      if ts[i].raw == "fn" && ts[i + 1].kind != TokenKind::LParen && outermost_body_open(ts, i) < 0 {
        let mut j = i + 1
        if j + 2 < n && ts[j + 1].kind == TokenKind::ColonColon {
          j = j + 2
        }
        let name = ts[j].raw
        let mut o = j + 1
        let mut d = 0
        while o < n {
          let ok = ts[o].kind
          if ok == TokenKind::LParen || ok == TokenKind::LBracket {
            d = d + 1
          } else if ok == TokenKind::RParen || ok == TokenKind::RBracket {
            d = d - 1
          } else if d == 0 && ok == TokenKind::LBrace {
            break
          }
          o = o + 1
        }
        if o < n {
          let close = find_matching_delim(ts, o)
          let list = match callees.get(name) {
            Some(l) => l
            None => []
          }
          let mut k = o + 1
          while k + 1 < close {
            if ts[k].kind == TokenKind::Ident && fns.contains(ts[k].raw) && ts[k + 1].kind == TokenKind::LParen {
              list.push(ts[k].raw)
            }
            k = k + 1
          }
          callees[name] = list
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  let mut changed = true
  while changed {
    changed = false
    for f in pkg.iter_fns.keys() {
      let list = match callees.get(f) {
        Some(l) => l
        None => []
      }
      for g in list {
        if !pkg.iter_fns.contains(g) {
          pkg.iter_fns[g] = "it is reached from `" + f + "`, which may run inside an iteration"
          changed = true
        }
      }
    }
  }
  collect_package_confined_arrays(all_tokens, pkg)
  pkg
}

///| Why `recv.shrink_to_fit()` at token `name_i` (the `shrink_to_fit` token) could be observed by a buffer
///| snapshot -- in its function, or (through `pkg`) in a caller -- or "" when none can.
pub fn shrink_snapshot_hazard(tokens : Array[Token], name_i : Int, pkg : ShrinkPkg) -> String {
  let n = tokens.length()
  let body_open = outermost_body_open(tokens, name_i)
  if body_open < 0 {
    return ""
  }
  let body_close = find_matching_delim(tokens, body_open)
  // A private receiver: allocated here (`let a = [..]` / `Array::new(..)`), never handed out or stored in the
  // function: only an iteration over one of its names (`array_aliases`) can hold its buffer.
  let mut h0 = name_i - 2
  while h0 >= 2 && tokens[h0 - 1].kind == TokenKind::Dot && tokens[h0 - 2].kind == TokenKind::Ident {
    h0 = h0 - 2
  }
  let head0 = if h0 >= 0 && tokens[h0].kind == TokenKind::Ident { tokens[h0].raw } else { "" }
  // (Handed out after the shrink, outside any loop around it, it cannot hold the old buffer.)
  let in_loop = kept_iter_region_start(tokens, name_i, body_open) < line_start(tokens, name_i, body_open)
  let private = h0 == name_i - 2 && head0.length() > 0 &&
  fresh_local_binding(tokens, head0, body_open, name_i, false) &&
  !name_handed_out(tokens, head0, body_open, if in_loop { body_close } else { name_i })
  let private_names : Map[String, Bool] = if private { array_aliases(tokens, head0, body_open, body_close) } else { Map() }
  // 1. Inside a `for .. in` loop body or a closure given to an iteration helper.
  let in_iter = iteration_scope_reason(tokens, name_i, body_open, body_close, pkg.array_fields, private_names)
  if in_iter.length() > 0 {
    return in_iter
  }
  // 2. An array iterator kept beyond the expression that creates it (of the private receiver's names, or of
  //    anything when the receiver is not private).
  let mut t = body_open + 1
  while t + 2 < body_close && t + 2 < n {
    let is_arr_iter = tokens[t].raw == "arr_iter" && tokens[t + 1].kind == TokenKind::LParen && t >= 2 &&
    tokens[t - 1].kind == TokenKind::ColonColon
    let is_dot_iter = tokens[t].kind == TokenKind::Dot && tokens[t + 1].raw == "iter" &&
    tokens[t + 2].kind == TokenKind::LParen
    if is_arr_iter || is_dot_iter {
      let open_p = if is_arr_iter { t + 1 } else { t + 2 }
      let mine = if !private {
        true
      } else if is_arr_iter {
        span_mentions(tokens, t + 2, find_matching_delim(tokens, t + 1), private_names)
      } else {
        let r = receiver_root(tokens, t - 1)
        r.length() == 0 || private_names.contains(r)
      }
      if mine && !iter_chain_is_consumed(tokens, find_matching_delim(tokens, open_p)) {
        return "its function keeps an `Array::iter()` (line " + tokens[t].line.to_string() +
        ") that reads the buffer it was created with"
      }
    }
    t = t + 1
  }
  // 3. Snapshots in other functions: an iteration elsewhere in the package over an array of this name that calls
  //    package functions, or a receiver a caller can hand in or reach (a parameter, a visible field) while the
  //    function may run inside a caller's iteration.
  let tail = path_tail(tokens, name_i - 2)
  match if private { None } else { pkg.iterated_tails.get(tail) } {
    Some(at) => return "the package iterates an array named `" + tail + "` (" + at + ") around calls that may reach it"
    None => ()
  }
  // Receiver path head and length.
  let mut h = name_i - 2
  while h >= 2 && tokens[h - 1].kind == TokenKind::Dot && tokens[h - 2].kind == TokenKind::Ident {
    h = h - 2
  }
  let head = if h >= 0 && tokens[h].kind == TokenKind::Ident { tokens[h].raw } else { "" }
  let is_field = h < name_i - 2
  // Enclosing function: name and parameters.
  let mut f = body_open - 1
  while f > 0 && tokens[f].raw != "fn" {
    f = f - 1
  }
  let mut fname = ""
  let params : Map[String, Bool] = Map()
  if f >= 0 && tokens[f].raw == "fn" && f + 1 < body_open {
    let mut j = f + 1
    if j + 2 < body_open && tokens[j + 1].kind == TokenKind::ColonColon {
      j = j + 2
    }
    fname = tokens[j].raw
    let mut d = 0
    let mut k = j + 1
    while k + 1 < body_open {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket {
        d = d + 1
      } else if kk == TokenKind::RParen || kk == TokenKind::RBracket {
        d = d - 1
      } else if d == 1 && kk == TokenKind::Ident && tokens[k + 1].kind == TokenKind::Colon {
        params[tokens[k].raw] = true
      }
      k = k + 1
    }
  }
  // A receiver this function did not allocate itself (`let xs = [..]` / `Array::new(..)` / a copy, never rebound):
  // a parameter (`self` included), a field, `let buf = src`, a module-level or captured array.
  let fresh_local = !is_field && fresh_local_binding(tokens, head, body_open, name_i, false)
  let non_local = !fresh_local
  // Inside a closure the shrink runs whenever that closure is called -- from anywhere.
  let in_closure = enclosing_closure_open(tokens, name_i, body_open) >= 0
  let iter_why = if in_closure {
    Some("it runs in a closure, which may be called from anywhere")
  } else {
    pkg.iter_fns.get(fname)
  }
  match iter_why {
    Some(why) =>
    if non_local {
      return "its receiver comes from outside `" + fname + "`, which may run inside a caller's iteration: " + why
    }
    None => ()
  }
  if non_local {
    // A package-confined private field or private module-level array is strictly proven never to leave the
    // package and always initialized with a fresh array, so an external caller of a `pub fn` cannot hold a
    // buffer snapshot of it.
    let pkg_confined = (is_field && pkg.visible_fields.contains(" confined_field:" + tail)) ||
    (!is_field && pkg.visible_fields.contains(" confined_global:" + head))
    if !pkg_confined {
      match pkg.risky_fns.get(fname) {
        Some(why) =>
        return "its receiver comes from a caller and `" + fname + "` may run inside a caller's iteration: " + why
        None => ()
      }
    }
  }
  ""
}

///| First token of the line of `idx` (not before `body_open + 1`).
fn line_start(tokens : Array[Token], idx : Int, body_open : Int) -> Int {
  let mut k = idx
  while k > body_open + 1 && !tokens[k].newline_before {
    k = k - 1
  }
  k
}

///| For a field iteration `root.tail`, check whether `[s, e)` passes:
///|   2 -> `root.tail` directly (an `Array` value),
///|   1 -> `root` as a whole struct value (NOT a different field like `root.kind` or `root.font_size`),
///|   0 -> neither.
fn span_passes_owner_or_field(tokens : Array[Token], s : Int, e : Int, root : String, tail : String) -> Int {
  if root.length() == 0 {
    return 0
  }
  let mut res = 0
  let mut k = s
  while k < e {
    if tokens[k].kind == TokenKind::Ident && tokens[k].raw == root &&
    !(k > 0 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) {
      if k + 2 < e && tokens[k + 1].kind == TokenKind::Dot && tokens[k + 2].kind == TokenKind::Ident {
        if tokens[k + 2].raw == tail {
          return 2
        }
        // `root.other_field` — does NOT pass `root` or `root.tail`
      } else {
        res = 1
      }
    }
    k = k + 1
  }
  res
}

///| Some identifier of `names` occurs (unqualified) in `[s, e)`.
fn span_mentions(tokens : Array[Token], s : Int, e : Int, names : Map[String, Bool]) -> Bool {
  let mut k = s
  while k < e {
    if tokens[k].kind == TokenKind::Ident && names.contains(tokens[k].raw) &&
    !(k > 0 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) {
      return true
    }
    k = k + 1
  }
  false
}

///| `name` (a path rooted at it) is handed to a call, stored (`a.f = xs`, `[xs]`, `{ f: xs }`), returned, or captured
///| by a closure in the function before `limit` -- so something else may hold its buffer.
fn name_handed_out(tokens : Array[Token], name : String, body_open : Int, limit : Int) -> Bool {
  let body_close = find_matching_delim(tokens, body_open)
  let mut j = body_open + 1
  while j < limit {
    let tk = tokens[j]
    if tk.kind == TokenKind::Ident && tk.raw == name &&
    !(tokens[j - 1].kind == TokenKind::Dot || tokens[j - 1].kind == TokenKind::ColonColon) {
      let nx = if j + 1 < body_close { tokens[j + 1].kind } else { TokenKind::RBrace }
      let read_through = nx == TokenKind::Dot || nx == TokenKind::LBracket
      let pk = tokens[j - 1]
      // (`mbt_compat::` helpers do not keep their arguments.)
      let o = enclosing_open(tokens, j, body_open, TokenKind::LParen)
      let compat = o >= 3 && tokens[o - 2].kind == TokenKind::ColonColon && tokens[o - 3].raw == "mbt_compat"
      let arg = !compat && (pk.kind == TokenKind::LParen || pk.kind == TokenKind::Comma) &&
      (nx == TokenKind::RParen || nx == TokenKind::Comma)
      let stored = !read_through && (pk.kind == TokenKind::Eq || pk.kind == TokenKind::LBracket ||
        pk.kind == TokenKind::Colon || pk.kind == TokenKind::Comma || pk.raw == "return")
      // The last expression of the body (its value), or inside a closure.
      let tail = !read_through && nx == TokenKind::RBrace && j + 1 == body_close
      if arg || stored || tail || enclosing_closure_open(tokens, j, body_open) >= 0 {
        return true
      }
    }
    j = j + 1
  }
  false
}

///| `{` of the innermost closure body (`fn(..) { .. }`) around `idx` inside the function body, or -1.
fn enclosing_closure_open(tokens : Array[Token], idx : Int, body_open : Int) -> Int {
  let mut b = idx
  while true {
    let o = enclosing_open(tokens, b, body_open, TokenKind::LBrace)
    if o < 0 || o <= body_open {
      return -1
    }
    // `fn ( .. ) [-> T] {`
    let mut h = o - 1
    while h > body_open && !tokens[h].newline_before && tokens[h].kind != TokenKind::RParen {
      h = h - 1
    }
    if tokens[h].kind == TokenKind::RParen {
      let op = find_open_before(tokens, h, body_open)
      if op > 0 && tokens[op - 1].raw == "fn" {
        return o
      }
    }
    b = o
  }
  -1
}

///| `Array()` / `Array(capacity=e)` / `Array::new()` / `Array::new(capacity=e)` starting at `s`: the index of its
///| closing `)` and the capacity expression range (`(-1, -1)` without one); `close == -1` for anything else.
///| A local whose borrowed views make it an `ArrayBuf` keeps MoonBit's reserved capacity this way
///| (`ArrayBuf::with_capacity`), so a later `shrink_to_fit` / growth reallocates exactly where MoonBit does.
pub fn array_ctor_capacity_range(tokens : Array[Token], s : Int, end : Int) -> (Int, Int, Int) {
  if s >= end || tokens[s].raw != "Array" {
    return (-1, -1, -1)
  }
  let open = if s + 1 < end && tokens[s + 1].kind == TokenKind::LParen {
    s + 1
  } else if s + 3 < end && tokens[s + 1].kind == TokenKind::ColonColon && tokens[s + 2].raw == "new" &&
  tokens[s + 3].kind == TokenKind::LParen {
    s + 3
  } else {
    -1
  }
  if open < 0 {
    return (-1, -1, -1)
  }
  let close = find_matching_delim(tokens, open)
  if close < 0 || close >= end {
    return (-1, -1, -1)
  }
  if close == open + 1 {
    return (close, -1, -1)
  }
  if open + 3 < close && tokens[open + 1].kind == TokenKind::Ident && tokens[open + 1].raw == "capacity" &&
  tokens[open + 2].kind == TokenKind::Eq {
    let cap_e = if tokens[close - 1].kind == TokenKind::Comma { close - 1 } else { close }
    let mut d = 0
    let mut k = open + 3
    while k < cap_e {
      let kk = tokens[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
        d = d + 1
      } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
        d = d - 1
      } else if d == 0 && kk == TokenKind::Comma {
        return (-1, -1, -1)
      }
      k = k + 1
    }
    if cap_e > open + 3 {
      return (close, open + 3, cap_e)
    }
  }
  (-1, -1, -1)
}

///| `mbt_compat::ArrayBuf::with_capacity(<cap>)` / `ArrayBuf::new()` for the array constructor at `s` when it is
///| the whole initializer (`find_expr_end`), with the index after it.
fn lower_array_ctor_as_buf(
  ctx : StageAContext,
  tokens : Array[Token],
  s : Int,
  end : Int,
  file : String,
) -> Option[(String, Int)] {
  let (close, cap_s, cap_e) = array_ctor_capacity_range(tokens, s, end)
  if close < 0 || find_expr_end(tokens, s, end) != close + 1 {
    return None
  }
  if cap_s < 0 {
    return Some(("mbt_compat::ArrayBuf::new()", close + 1))
  }
  let cap = lower_expr_range(ctx, tokens, cap_s, cap_e, file, false).trim()
  Some(("mbt_compat::ArrayBuf::with_capacity(" + cap + ")", close + 1))
}

///| Struct fields declared in `contents` whose type is an `Array[..]` (true) or something else under the same name
///| (false): `x.field.copy()` is the built-in `Array::copy` (a fresh array) only when every such field is an array.
pub fn collect_array_fields(contents : Array[String]) -> Map[String, Bool] {
  let all_tokens : Array[Array[Token]] = []
  for c in contents {
    all_tokens.push(lex_moonbit(c))
  }
  collect_array_fields_from_tokens(all_tokens)
}

///| Same as `collect_array_fields`, operating on pre-lexed token streams (zero re-lexing).
pub fn collect_array_fields_from_tokens(all_tokens : Array[Array[Token]]) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      if ts[i].raw == "struct" && (ts[i].kind == TokenKind::Keyword || ts[i].kind == TokenKind::Ident) {
        let mut o = i + 1
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          let mut d = 0
          while k > 0 && k < close {
            let kk = ts[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
              d = d + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
              d = d - 1
            } else if d == 0 && kk == TokenKind::Ident && k + 2 < close && ts[k + 1].kind == TokenKind::Colon &&
            (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "priv" ||
              ts[k - 1].raw == "pub" || ts[k - 1].kind == TokenKind::RParen ||
              ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
              let is_arr = ts[k + 2].raw == "Array" && k + 3 < close && ts[k + 3].kind == TokenKind::LBracket
              let prev = match out.get(ts[k].raw) {
                Some(v) => v
                None => true
              }
              out[ts[k].raw] = prev && is_arr
            }
            k = k + 1
          }
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  out
}

///| Root identifier of the receiver path ending at `end_idx` (`a.b.c` -> `a`), or "".
fn receiver_root(tokens : Array[Token], end_idx : Int) -> String {
  if end_idx < 0 || tokens[end_idx].kind != TokenKind::Ident {
    return ""
  }
  let mut h = end_idx
  while h >= 2 && tokens[h - 1].kind == TokenKind::Dot && tokens[h - 2].kind == TokenKind::Ident {
    h = h - 2
  }
  if h >= 1 && (tokens[h - 1].kind == TokenKind::Dot || tokens[h - 1].kind == TokenKind::ColonColon) {
    return ""
  }
  tokens[h].raw
}

///| A kept iterator must stay in its function, where `kept_iter_hazard` sees every change of its array: bound by
///| `let it = xs.iter()` and only used as `it.m(..)`. Returned, stored, passed on or left as the function's value,
///| it could be read after changes made elsewhere.
fn kept_iter_escapes(tokens : Array[Token], dot_i : Int, close_p : Int, body_open : Int, body_close : Int) -> String {
  // Start of the receiver path (`a.b[i].c`).
  let mut h = dot_i - 1
  while h > 0 {
    if tokens[h].kind == TokenKind::RBracket {
      let lb = find_open_before(tokens, h, 0)
      if lb > 0 && (tokens[lb - 1].kind == TokenKind::Ident || tokens[lb - 1].kind == TokenKind::RBracket) {
        h = lb - 1
        continue
      }
      h = lb
      break
    }
    if h >= 2 && tokens[h - 1].kind == TokenKind::Dot &&
    (tokens[h - 2].kind == TokenKind::Ident || tokens[h - 2].kind == TokenKind::RBracket) {
      h = h - 2
      continue
    }
    break
  }
  // End of the chain the iterator heads.
  let mut c = close_p
  while c + 3 < body_close && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
  tokens[c + 3].kind == TokenKind::LParen {
    c = find_matching_delim(tokens, c + 3)
  }
  if h >= 3 && tokens[h - 1].kind == TokenKind::Eq && tokens[h - 2].kind == TokenKind::Ident &&
  tokens[h - 3].raw == "let" && c + 1 < body_close && tokens[c + 1].newline_before {
    let nm = tokens[h - 2].raw
    let mut k = c + 1
    while k < body_close {
      let tk = tokens[k]
      let qualified = tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon
      if tk.kind == TokenKind::Ident && tk.raw == nm && !qualified {
        if k > 0 && (tokens[k - 1].raw == "let" || tokens[k - 1].raw == "mut") {
          // Rebound: later uses are another value.
          return ""
        }
        // Only `it.m(..)..` chains that end in a terminal consumer (or `next()`) read it in place; a lazy
        // `it.map(f)` is another iterator over the same snapshot.
        let mut ends_in_consumer = false
        let mut c2 = k
        while c2 + 3 < body_close && tokens[c2 + 1].kind == TokenKind::Dot && tokens[c2 + 2].kind == TokenKind::Ident &&
        tokens[c2 + 3].kind == TokenKind::LParen {
          let m = tokens[c2 + 2].raw
          if is_terminal_iter_consumer(m) || m == "next" {
            ends_in_consumer = true
            break
          }
          c2 = find_matching_delim(tokens, c2 + 3)
        }
        if !ends_in_consumer {
          return "the iterator `" + nm + "` leaves its expression (line " + tk.line.to_string() + ")"
        }
      }
      k = k + 1
    }
    return ""
  }
  // `for x in xs.iter() { .. }`: read in place by the loop.
  if h >= 1 && tokens[h - 1].raw == "in" && c + 1 < body_close && tokens[c + 1].kind == TokenKind::LBrace {
    return ""
  }
  "the iterator is not bound by `let` and used in place"
}

///| `xs.iter()` ending at `close_p` is a whole argument that its call consumes at once: `push_iter(xs.iter())` /
///| `mbt_compat::arr_push_iter(d, xs.iter())` (`#72` checks those), or `.zip(xs.iter())` / `.chain(..)` inside an
///| iterator chain that a terminal consumer ends.
fn iter_is_consumed_argument(tokens : Array[Token], dot_i : Int, close_p : Int) -> Bool {
  // The argument may continue as a chain (`.zip(ys.iter().map(f))`).
  let mut c = close_p
  while c + 3 < tokens.length() && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
  tokens[c + 3].kind == TokenKind::LParen {
    c = find_matching_delim(tokens, c + 3)
    if c < 0 {
      return false
    }
  }
  if c + 1 >= tokens.length() || tokens[c + 1].kind != TokenKind::RParen {
    return false
  }
  let mut h = dot_i - 1
  if tokens[h].kind == TokenKind::RBracket {
    h = find_open_before(tokens, h, 0)
  } else {
    while h >= 2 && tokens[h - 1].kind == TokenKind::Dot && tokens[h - 2].kind == TokenKind::Ident {
      h = h - 2
    }
  }
  if h < 1 || !(tokens[h - 1].kind == TokenKind::LParen || tokens[h - 1].kind == TokenKind::Comma) {
    return false
  }
  let p = enclosing_open(tokens, h, 0, TokenKind::LParen)
  if p < 1 || find_matching_delim(tokens, p) != c + 1 {
    return false
  }
  let callee = tokens[p - 1].raw
  if callee == "push_iter" || callee == "arr_push_iter" {
    return true
  }
  (callee == "zip" || callee == "chain") && p >= 2 && tokens[p - 2].kind == TokenKind::Dot &&
  iter_chain_is_consumed(tokens, c + 1)
}

///| `[..]` ending at `rb` is an array literal (a fresh array nothing else can reach), not an index `xs[i]`.
fn is_array_literal_end(tokens : Array[Token], rb : Int) -> Bool {
  if rb < 0 || tokens[rb].kind != TokenKind::RBracket {
    return false
  }
  let lb = find_open_before(tokens, rb, 0)
  if lb < 0 {
    return false
  }
  lb == 0 || !(tokens[lb - 1].kind == TokenKind::Ident || tokens[lb - 1].kind == TokenKind::RParen ||
    tokens[lb - 1].kind == TokenKind::RBracket || tokens[lb - 1].kind == TokenKind::UpperIdent)
}

///| `xs.length()`-style reads that cannot change an array (other names on an array path count as possible
///| mutations: a user method on `self` may clear `self.xs`).
fn is_read_only_array_method(m : String) -> Bool {
  m == "length" || m == "get" || m == "contains" || m == "is_empty" || m == "iter" || m == "copy" ||
  m == "to_string" || m == "map" || m == "mapi" || m == "filter" || m == "filter_map" || m == "fold" ||
  m == "any" || m == "all" || m == "join" || m == "last" || m == "first" || m == "search" ||
  m == "search_by" || m == "each" || m == "eachi" || m == "rev_each" || m == "unsafe_get" ||
  m == "to_array" || m == "count" || m == "next" || m == "unwrap_or" || m == "unwrap" || m == "op_get" ||
  m == "compare" || m == "equal" || m == "hash" || m == "rev" || m == "starts_with" || m == "ends_with"
}

///| Names of the array the iterator reads: `root` and the locals bound to it (`let ys = xs`, `ys = xs`, either way).
fn array_aliases(tokens : Array[Token], root : String, body_open : Int, body_close : Int) -> Map[String, Bool] {
  let names : Map[String, Bool] = Map()
  names[root] = true
  let mut changed = true
  while changed {
    changed = false
    let mut k = body_open + 1
    while k + 2 < body_close {
      // `let [mut] <a> [: T] = <b>[.f]*` ending the statement: `<a>` names (part of) the same array.
      if (tokens[k].raw == "let" || tokens[k].raw == "mut") && tokens[k + 1].kind == TokenKind::Ident {
        let a = tokens[k + 1].raw
        let mut q = k + 2
        if q < body_close && tokens[q].kind == TokenKind::Colon {
          let mut d = 0
          while q < body_close && !(d == 0 && tokens[q].kind == TokenKind::Eq) {
            let qk = tokens[q].kind
            if qk == TokenKind::LBracket || qk == TokenKind::LParen {
              d = d + 1
            } else if qk == TokenKind::RBracket || qk == TokenKind::RParen {
              d = d - 1
            }
            q = q + 1
          }
        }
        // Any right-hand side that mentions one of the names (`xs`, `(xs)`, `b.items`, `if c { xs } else { ys }`)
        // may be the same array, unless it is a copy.
        if q + 1 < body_close && tokens[q].kind == TokenKind::Eq && !names.contains(a) {
          let re = statement_end(tokens, q + 1, body_close)
          let mut mentions = false
          let mut r = q + 1
          while r < re {
            if tokens[r].kind == TokenKind::Ident && names.contains(tokens[r].raw) &&
            !(tokens[r - 1].kind == TokenKind::Dot || tokens[r - 1].kind == TokenKind::ColonColon) {
              // The value itself (or a field path of it) flows, not something read through it (`xs.iter()`,
              // `xs[0]`, `xs.length()`).
              let mut p = r
              while p + 2 < re && tokens[p + 1].kind == TokenKind::Dot && tokens[p + 2].kind == TokenKind::Ident &&
              !(p + 3 < re && tokens[p + 3].kind == TokenKind::LParen) {
                p = p + 2
              }
              let next = if p + 1 < re { tokens[p + 1].kind } else { TokenKind::Eof }
              if next != TokenKind::LParen && next != TokenKind::LBracket && next != TokenKind::Dot {
                mentions = true
              }
            }
            r = r + 1
          }
          if mentions && !is_fresh_array_rhs(tokens, q + 1, re) {
            names[a] = true
            changed = true
          }
        }
      }
      // `<a> = <b>` with `<b>` a bare name ending the statement.
      if tokens[k].kind == TokenKind::Ident && tokens[k + 1].kind == TokenKind::Eq &&
      tokens[k + 2].kind == TokenKind::Ident &&
      (k + 3 >= body_close || tokens[k + 3].newline_before || tokens[k + 3].kind == TokenKind::Semi) &&
      !(k > 0 && tokens[k - 1].kind == TokenKind::Dot) {
        let a = tokens[k].raw
        let b = tokens[k + 2].raw
        if names.contains(a) && !names.contains(b) {
          names[b] = true
          changed = true
        } else if names.contains(b) && !names.contains(a) {
          names[a] = true
          changed = true
        }
      }
      k = k + 1
    }
  }
  names
}

///| Start of the region a kept iterator created at `idx` lives through: the statement creating it, or the
///| outermost loop (inside the function body) around it, whose back edge brings earlier statements round again.
fn kept_iter_region_start(tokens : Array[Token], idx : Int, body_open : Int) -> Int {
  // The creating statement: back to the first token of its line.
  let mut start = idx
  while start > body_open + 1 && !tokens[start].newline_before {
    start = start - 1
  }
  let mut b = idx
  while true {
    let o = enclosing_open(tokens, b, body_open, TokenKind::LBrace)
    if o < 0 || o <= body_open {
      break
    }
    // A loop header on the line of this `{`.
    let mut h = o - 1
    while h > body_open {
      let r = tokens[h].raw
      if r == "for" || r == "while" || r == "loop" {
        start = h
        break
      }
      if tokens[h].newline_before {
        break
      }
      h = h - 1
    }
    b = o
  }
  start
}

///| Why a change to the iterated array inside `[s, e)` could differ between MoonBit's snapshot and the live array
///| (`names`: the array's root names; "" for a computed receiver, where any array counts), or "".
fn kept_iter_mutations(
  tokens : Array[Token],
  names : Map[String, Bool],
  computed : Bool,
  s : Int,
  e : Int,
  body_open : Int,
  head : String,
  callables : Map[String, Bool],
  user_methods : Map[String, Bool],
  flags : Array[Bool],
) -> String {
  // `flags`: [appended, written in place] so far, shared by every part that runs while it is kept (interpolation
  // holes, closures defined before it, the region): only both together are a hazard (`appends_and_writes`).
  let sort_env_local = SortKeyEnv::{ methods: user_methods }
  let mut t = s
  while t < e {
    let tk = tokens[t]
    let qualified = t > 0 && (tokens[t - 1].kind == TokenKind::Dot || tokens[t - 1].kind == TokenKind::ColonColon)
    // `"\{xs.pop()}"`: the holes of an interpolation run code too.
    if tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline || tk.kind == TokenKind::StringLit {
      for sub in interp_holes(tk.raw) {
        let why = kept_iter_mutations(sub, names, computed, 0, sub.length() - 1, 0, head, callables, user_methods, flags)
        if why.length() > 0 {
          return why + " (in a string interpolation)"
        }
      }
    }
    if computed {
      if tk.kind == TokenKind::Dot && t + 2 < e && tokens[t + 1].kind == TokenKind::Ident &&
      tokens[t + 2].kind == TokenKind::LParen {
        let m = tokens[t + 1].raw
        let recv_r = receiver_root(tokens, t - 1)
        let recv_is_builtin = (recv_r.length() > 0 && fresh_local_binding(tokens, recv_r, body_open, t, false)) ||
        receiver_is_builtin(tokens, t - 1, body_open, t, sort_env_local)
        if m != "iter" && (is_cap_arr_shrink_or_shift_method(m) || m == "shrink_to_fit") {
          return "`." + m + "(..)` runs while an iterator of a computed array is kept"
        } else if !recv_is_builtin && user_methods.contains(m) &&
        (is_cap_arr_growth_method(m) || is_cap_arr_write_method(m)) {
          return "`." + m + "(..)` may invoke a user/dependency method while an iterator of a non-local array is kept"
        } else if is_cap_arr_growth_method(m) {
          flags[0] = true
        } else if is_cap_arr_write_method(m) {
          flags[1] = true
        } else if !is_read_only_array_method(m) && head.length() > 0 && recv_r == head {
          return "`." + m + "(..)` on `" + head + "` may change the array of a kept iterator over a non-local array"
        }
      } else if tk.kind == TokenKind::Ident && t > 1 && tokens[t - 1].kind == TokenKind::ColonColon &&
      tokens[t - 2].raw == "mbt_compat" && t + 1 < e && tokens[t + 1].kind == TokenKind::LParen {
        if is_cap_compat_growth_fn(tk.raw) {
          flags[0] = true
        } else if is_cap_compat_write_fn(tk.raw) {
          flags[1] = true
        } else if is_cap_compat_shrink_or_shift_fn(tk.raw) || tk.raw == "arr_shrink_to_fit" {
          return "`" + tk.raw + "(..)` runs while an iterator of a computed array is kept"
        }
      } else if head.length() > 0 && tk.kind == TokenKind::Ident && tk.raw == head && !qualified &&
      t > 0 && (tokens[t - 1].kind == TokenKind::LParen || tokens[t - 1].kind == TokenKind::Comma) &&
      kept_iter_path_is_whole_arg(tokens, t, e) {
        let o = enclosing_open(tokens, t, body_open, TokenKind::LParen)
        let callee = if o > 0 { tokens[o - 1].raw } else { "" }
        if callee != "arr_iter" && callee != "length" && !is_cap_compat_growth_fn(callee) {
          return "`" + head + "` is passed to `" + callee + "(..)` while it is kept"
        }
      } else if is_opaque_call_at(tokens, t, e, callables) {
        return opaque_call_desc(tokens, t) + " may change the array of a kept iterator over a non-local array"
      } else if passes_closure_value(tokens, t, e, callables) {
        return passed_closure_desc(tokens, t) + " may change the array of a kept iterator over a non-local array"
      } else if tk.kind == TokenKind::RBracket && t + 1 < e &&
      (tokens[t + 1].kind == TokenKind::Eq || tokens[t + 1].kind == TokenKind::AssignOp) {
        flags[1] = true
      }
    } else if tk.kind == TokenKind::Ident && names.contains(tk.raw) && !qualified {
      let nm = tk.raw
      // Walk the path `nm.a.b` (fields) and look at what follows it.
      let mut p = t
      while p + 2 < e && tokens[p + 1].kind == TokenKind::Dot && tokens[p + 2].kind == TokenKind::Ident &&
      !(p + 3 < e && tokens[p + 3].kind == TokenKind::LParen) {
        p = p + 2
      }
      if p + 3 < e && tokens[p + 1].kind == TokenKind::Dot && tokens[p + 2].kind == TokenKind::Ident &&
      tokens[p + 3].kind == TokenKind::LParen {
        let m = tokens[p + 2].raw
        let recv_is_builtin = (p == t && ((head.length() > 0 && nm == head) || fresh_local_binding(tokens, nm, body_open, t, false))) ||
        receiver_is_builtin(tokens, p, body_open, t, sort_env_local)
        if !recv_is_builtin && user_methods.contains(m) &&
        (is_cap_arr_growth_method(m) || is_cap_arr_write_method(m)) {
          return "`" + nm + "." + m + "(..)` may invoke a user/dependency method while it is kept"
        } else if is_cap_arr_growth_method(m) {
          flags[0] = true
        } else if is_cap_arr_write_method(m) {
          flags[1] = true
        } else if is_cap_arr_shrink_or_shift_method(m) || m == "shrink_to_fit" {
          return "`" + nm + "." + m + "(..)` runs while it is kept"
        } else if !is_read_only_array_method(m) {
          return "`" + nm + "." + m + "(..)` may change it while it is kept"
        }
      } else if p + 1 < e && tokens[p + 1].kind == TokenKind::LBracket {
        let cb = find_matching_delim(tokens, p + 1)
        if cb + 1 < e && (tokens[cb + 1].kind == TokenKind::Eq || tokens[cb + 1].kind == TokenKind::AssignOp) {
          flags[1] = true
        }
      }
      // The path as a whole argument of a call (`f(xs)`, `arr_truncate(h.items, 0)`): could change it.
      if t > 0 && (tokens[t - 1].kind == TokenKind::LParen || tokens[t - 1].kind == TokenKind::Comma) &&
      p + 1 < e && (tokens[p + 1].kind == TokenKind::RParen || tokens[p + 1].kind == TokenKind::Comma) {
        let o = enclosing_open(tokens, t, body_open, TokenKind::LParen)
        let callee = if o > 0 { tokens[o - 1].raw } else { "" }
        if is_cap_compat_growth_fn(callee) {
          flags[0] = true
        } else if is_cap_compat_write_fn(callee) {
          flags[1] = true
        } else if callee != "arr_iter" && callee != "length" {
          return "`" + nm + "` is passed to `" + callee + "(..)` while it is kept"
        }
      }
    }
    t = t + 1
  }
  ""
}

fn appends_and_writes(flags : Array[Bool]) -> String {
  if flags[0] && flags[1] {
    "the array is appended to and written in place while it is kept"
  } else {
    ""
  }
}

///| A kept `xs.iter()` (`dot_i`: its `.`) reads the buffer and length `xs` had when it was created (MoonBit:
///| `self[:].iter()`); `mbt_compat::arr_iter` reads the live array up to that length. They agree while the array
///| is only appended to (the length is snapshotted) or only written in place (one shared buffer) -- not after a
///| removal (`pop`, `truncate`, `clear`, `remove`, `drain`, ...: MoonBit still yields the old elements), a
///| reordering or shrink, a write after an append (the append may have reallocated), a call that may do any of
///| those (a user method on the root, the array passed to a function), or once the iterator leaves its `let`.
///| Changes are looked for from its creation (or the loop around it) to the end of the function, through `let`
///| aliases of the root; an iterator consumed in its expression is checked for changes made by its own callbacks.
///| Why the iterator could observe a difference, or "".
pub fn kept_iter_hazard(tokens : Array[Token], dot_i : Int) -> String {
  let env = sort_key_env_of_with_deps([tokens], Map())
  kept_iter_hazard_with_env(tokens, dot_i, env)
}

pub fn kept_iter_hazard_with_env(tokens : Array[Token], dot_i : Int, env : SortKeyEnv) -> String {
  let close_p = find_matching_delim(tokens, dot_i + 2)
  if close_p < 0 {
    return "unbalanced `.iter(`"
  }
  if is_array_literal_end(tokens, dot_i - 1) {
    return ""
  }
  let root = receiver_root(tokens, dot_i - 1)
  let body_open = outermost_body_open(tokens, dot_i)
  if body_open < 0 {
    return ""
  }
  let body_close = find_matching_delim(tokens, body_open)
  // Only an array this function allocated (and has not handed out before the iterator) has all its names here;
  // any other (a parameter, a field, a module-level array) may be aliased anywhere: every change counts.
  let fresh_root = root.length() > 0 && fresh_local_binding(tokens, root, body_open, dot_i, true)
  let names = if fresh_root { array_aliases(tokens, root, body_open, body_close) } else { Map() }
  let computed = !fresh_root
  let callables = callable_locals(tokens, body_open)
  let flags = [false, false]
  if iter_chain_is_consumed(tokens, close_p) || iter_is_consumed_argument(tokens, dot_i, close_p) {
    // Consumed at once: only the chain's own callbacks run while it reads.
    let mut c = close_p
    while c + 3 < body_close && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
    tokens[c + 3].kind == TokenKind::LParen {
      c = find_matching_delim(tokens, c + 3)
    }
    // An argument (`push_iter(xs.iter())`, `.zip(ys.iter())`): up to the end of the enclosing call's chain.
    if c + 1 < body_close && tokens[c + 1].kind == TokenKind::RParen {
      c = c + 1
      while c + 3 < body_close && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
      tokens[c + 3].kind == TokenKind::LParen {
        c = find_matching_delim(tokens, c + 3)
      }
    }
    let cb = chain_callbacks_opacity(tokens, close_p, c + 1, body_open, callables)
    if cb.length() > 0 {
      return cb
    }
    let pre = pre_closure_mutations(tokens, names, computed, body_open, close_p, root, callables, env.methods, close_p + 1, c + 1, true, flags)
    if pre.length() > 0 {
      return pre
    }
    let why = kept_iter_mutations(tokens, names, computed, close_p + 1, c + 1, body_open, root, callables, env.methods, flags)
    if why.length() > 0 {
      return why + " (inside the iterator chain's callbacks)"
    }
    return appends_and_writes(flags)
  }
  let esc = kept_iter_escapes(tokens, dot_i, close_p, body_open, body_close)
  if esc.length() > 0 {
    return esc
  }
  let start = kept_iter_region_start(tokens, dot_i, body_open)
  // Closures defined before the iterator may run after it: their bodies count too.
  let pre = pre_closure_mutations(tokens, names, computed, body_open, start, root, callables, env.methods, start, body_close, false, flags)
  if pre.length() > 0 {
    return pre
  }
  let why = kept_iter_mutations(tokens, names, computed, start, body_close, body_open, root, callables, env.methods, flags)
  if why.length() > 0 {
    return why
  }
  appends_and_writes(flags)
}

///| End (exclusive) of the statement starting at `s`: the next depth-0 token that starts a line, a `;`, or `limit`.
fn statement_end(tokens : Array[Token], s : Int, limit : Int) -> Int {
  let mut d = 0
  let mut k = s
  while k < limit {
    let kk = tokens[k].kind
    if k > s && d == 0 && (tokens[k].newline_before || kk == TokenKind::Semi) {
      return k
    }
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d == 0 {
        return k
      }
      d = d - 1
    }
    k = k + 1
  }
  limit
}

///| `[s, e)` allocates a new array: `[..]`, `Array(..)` / `Array::new(..)`, `{ mbt_compat::arr_capacity_check(..); [] }`,
///| or `mbt_compat::arr_copy(..)`.
fn is_fresh_array_rhs(tokens : Array[Token], s : Int, e : Int) -> Bool {
  if s >= e {
    return false
  }
  let whole = fn(open : Int) -> Bool { find_matching_delim(tokens, open) == e - 1 }
  if tokens[s].kind == TokenKind::LBracket {
    return whole(s)
  }
  if tokens[s].raw == "Array" && s + 1 < e {
    if tokens[s + 1].kind == TokenKind::LParen {
      return whole(s + 1)
    }
    if s + 3 < e && tokens[s + 1].kind == TokenKind::ColonColon && tokens[s + 2].raw == "new" &&
    tokens[s + 3].kind == TokenKind::LParen {
      return whole(s + 3)
    }
  }
  if tokens[s].kind == TokenKind::LBrace && whole(s) && s + 3 < e && tokens[s + 1].raw == "mbt_compat" &&
  tokens[s + 3].raw == "arr_capacity_check" && tokens[e - 2].kind == TokenKind::RBracket &&
  tokens[e - 3].kind == TokenKind::LBracket {
    return true
  }
  // (Not `<path>.copy()`: a user `copy` method may hand back the array it holds.)
  tokens[s].raw == "mbt_compat" && s + 3 < e && tokens[s + 2].raw == "arr_copy" &&
  tokens[s + 3].kind == TokenKind::LParen && whole(s + 3)
}

///| No `{ .. }` around `k` closes before `before` (`k`'s block is still open there).
fn block_open_through(tokens : Array[Token], k : Int, before : Int) -> Bool {
  if k >= before {
    return false
  }
  let mut d = 0
  let mut j = k
  while j < before {
    if tokens[j].kind == TokenKind::LBrace {
      d = d + 1
    } else if tokens[j].kind == TokenKind::RBrace {
      d = d - 1
      if d < 0 {
        return false
      }
    }
    j = j + 1
  }
  true
}

///| `name` is bound in the function body (before `before`) by `let [mut] name [: T] = <fresh array>`, never
///| assigned again, and (with `check_escape`) not handed to a call or stored before `before`.
fn fresh_local_binding(tokens : Array[Token], name : String, body_open : Int, before : Int, check_escape : Bool) -> Bool {
  let body_close = find_matching_delim(tokens, body_open)
  // The binding in scope at `before`: the last `let name` whose block is still open there (one in a block closed
  // before `before` -- `if c { let xs = [..] }` -- names another array).
  let mut bind = -1
  let mut k = body_open + 1
  while k + 1 < before {
    if tokens[k].kind == TokenKind::Ident && tokens[k].raw == name && (tokens[k - 1].raw == "let" ||
      tokens[k - 1].raw == "mut" && k >= 2 && tokens[k - 2].raw == "let") && block_open_through(tokens, k, before) {
      bind = k
    }
    k = k + 1
  }
  if bind < 0 {
    return false
  }
  // Bound some other way too (a parameter, a pattern, a `for` or closure variable): it may name another array
  // where it is used.
  let mut lets = 0
  let mut z = body_open + 1
  while z < body_close {
    if tokens[z].kind == TokenKind::Ident && tokens[z].raw == name && (tokens[z - 1].raw == "let" || tokens[z - 1].raw == "mut") {
      lets = lets + 1
    }
    z = z + 1
  }
  if name_binding_count(tokens, body_open, name) > lets {
    return false
  }
  // Optional annotation, then `=`.
  let mut q = bind + 1
  if q < body_close && tokens[q].kind == TokenKind::Colon {
    let mut d = 0
    while q < body_close && !(d == 0 && tokens[q].kind == TokenKind::Eq) {
      let qk = tokens[q].kind
      if qk == TokenKind::LBracket || qk == TokenKind::LParen {
        d = d + 1
      } else if qk == TokenKind::RBracket || qk == TokenKind::RParen {
        d = d - 1
      }
      q = q + 1
    }
  }
  if q >= body_close || tokens[q].kind != TokenKind::Eq {
    return false
  }
  let re = let_init_end(tokens, q + 1, body_close)
  // (Used inside its own initializer, `name` is another binding.)
  if re > before || !is_fresh_array_rhs(tokens, q + 1, re) {
    return false
  }
  let mut j = re
  while j < body_close {
    let tk = tokens[j]
    if tk.kind == TokenKind::Ident && tk.raw == name &&
    !(tokens[j - 1].kind == TokenKind::Dot || tokens[j - 1].kind == TokenKind::ColonColon) {
      // Rebound: `name = ..` (not `==`).
      if j + 1 < body_close && tokens[j + 1].kind == TokenKind::Eq {
        return false
      }
      if check_escape && j < before {
        let arg = (tokens[j - 1].kind == TokenKind::LParen || tokens[j - 1].kind == TokenKind::Comma) &&
        j + 1 < body_close && (tokens[j + 1].kind == TokenKind::RParen || tokens[j + 1].kind == TokenKind::Comma)
        // Stored whole (`a.f = xs`, `[xs]`, `{ f: xs }`), not read through (`= xs.iter()`, `= xs[0]`).
        let read_through = j + 1 < body_close && (tokens[j + 1].kind == TokenKind::Dot ||
          tokens[j + 1].kind == TokenKind::LBracket)
        let stored = !read_through && (tokens[j - 1].kind == TokenKind::Eq || tokens[j - 1].kind == TokenKind::LBracket ||
          tokens[j - 1].kind == TokenKind::Colon || tokens[j - 1].kind == TokenKind::Comma)
        if arg || stored {
          return false
        }
      }
    }
    j = j + 1
  }
  true
}

///| The `\{ .. }` holes of a string token, lexed.
fn interp_holes(raw : String) -> Array[Array[Token]] {
  let out : Array[Array[Token]] = []
  let n = raw.length()
  let mut i = 0
  while i + 1 < n {
    if raw.code_unit_at(i) == 92 && raw.code_unit_at(i + 1) == 123 {
      let mut d = 1
      let mut j = i + 2
      while j < n && d > 0 {
        let ch = raw.code_unit_at(j)
        if ch == 123 {
          d = d + 1
        } else if ch == 125 {
          d = d - 1
        }
        j = j + 1
      }
      out.push(lex_moonbit(raw.slice(i + 2, j - 1)))
      i = j
    } else {
      i = i + 1
    }
  }
  out
}

///| A call at `t` that may run code the transpiler cannot see: a free function / closure call `f(..)`, an indirect
///| call `(..)(..)`, or a qualified call other than a non-mutating `mbt_compat::` helper.
///| In a `callables` map: calls of closure values are not followed at all (`pre_closure_mutations`' light check).
let light_mark : String = " light"

fn is_opaque_call_at(tokens : Array[Token], t : Int, e : Int, callables : Map[String, Bool]) -> Bool {
  if t + 1 >= e || tokens[t + 1].kind != TokenKind::LParen || tokens[t + 1].newline_before {
    return false
  }
  let tk = tokens[t]
  if tk.kind == TokenKind::RParen {
    return !callables.contains(light_mark)
  }
  // Calling a closure value (a parameter, a local, a closure parameter): its body is out of sight.
  tk.kind == TokenKind::Ident && !(t > 0 && (tokens[t - 1].kind == TokenKind::Dot ||
    tokens[t - 1].kind == TokenKind::ColonColon || tokens[t - 1].raw == "fn")) && callables.contains(tk.raw)
}

///| A call at `t` (`f(..)`, `@p.f(..)`, `x.m(..)`) that hands on a closure value -- a parameter, local or closure
///| parameter (`apply(touch)`) -- or, to a function that is not a method, a closure literal (`apply(fn() { .. })`):
///| what the callee does with it is out of sight. Not in the light check (`light_mark`).
fn passes_closure_value(tokens : Array[Token], t : Int, e : Int, callables : Map[String, Bool]) -> Bool {
  if callables.contains(light_mark) || t + 1 >= e || tokens[t + 1].kind != TokenKind::LParen ||
  tokens[t + 1].newline_before {
    return false
  }
  let tk = tokens[t]
  if !(tk.kind == TokenKind::RParen || tk.kind == TokenKind::Ident && tk.raw != "fn" && !(t > 0 && tokens[t - 1].raw == "fn")) {
    return false
  }
  let method = t > 0 && tokens[t - 1].kind == TokenKind::Dot
  let close = find_matching_delim(tokens, t + 1)
  let mut a = t + 2
  while a < close && a < e {
    let ak = tokens[a]
    if ak.kind == TokenKind::Ident && callables.contains("&" + ak.raw) &&
    !(tokens[a - 1].kind == TokenKind::Dot || tokens[a - 1].kind == TokenKind::ColonColon) &&
    !(a + 1 < close && (tokens[a + 1].kind == TokenKind::LParen || tokens[a + 1].kind == TokenKind::Dot ||
      tokens[a + 1].kind == TokenKind::LBracket)) {
      return true
    }
    if !method && ak.raw == "fn" && a + 1 < close && tokens[a + 1].kind == TokenKind::LParen {
      return true
    }
    a = a + 1
  }
  false
}

fn passed_closure_desc(tokens : Array[Token], t : Int) -> String {
  if tokens[t].kind == TokenKind::RParen {
    "an indirect call given a closure"
  } else {
    "a call handing `" + tokens[t].raw + "(..)` a closure value"
  }
}

///| The path starting at `t` (`a`, `a.b.c`) ends an argument (followed by `)` or `,`).
fn kept_iter_path_is_whole_arg(tokens : Array[Token], t : Int, e : Int) -> Bool {
  let mut p = t
  while p + 2 < e && tokens[p + 1].kind == TokenKind::Dot && tokens[p + 2].kind == TokenKind::Ident {
    p = p + 2
  }
  p + 1 < e && (tokens[p + 1].kind == TokenKind::RParen || tokens[p + 1].kind == TokenKind::Comma)
}

///| Names in the function (its parameters, its `let`s, every closure's parameters) a call could invoke as a closure
///| value -- as opposed to a top-level function, whose body cannot reach this function's locals.
fn callable_locals(tokens : Array[Token], body_open : Int) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  if body_open < 0 {
    return out
  }
  let body_close = find_matching_delim(tokens, body_open)
  // Function parameters: `fn name(p : T, ..)` before the body.
  let mut f = body_open - 1
  while f > 0 && tokens[f].raw != "fn" {
    f = f - 1
  }
  let mut k = f + 1
  while k < body_open {
    if tokens[k].kind == TokenKind::Ident && k + 1 < body_open && tokens[k + 1].kind == TokenKind::Colon &&
    (tokens[k - 1].kind == TokenKind::LParen || tokens[k - 1].kind == TokenKind::Comma) {
      out[tokens[k].raw] = true
    }
    k = k + 1
  }
  k = body_open + 1
  while k < body_close {
    let tk = tokens[k]
    // A `let` bound to a closure literal is not opaque: its body is in sight (`local_closure_body`), checked
    // where it is called -- only for an immutable binding whose name nothing else in the function binds.
    if tk.kind == TokenKind::Ident && (tokens[k - 1].raw == "let" || tokens[k - 1].raw == "mut") &&
    !(tokens[k - 1].raw == "let" && k + 2 < body_close && tokens[k + 1].kind == TokenKind::Eq &&
      tokens[k + 2].raw == "fn" && possible_binding_count(tokens, body_open, tk.raw) == 1) {
      out[tk.raw] = true
    }
    // A local `fn name(..)`: called by name, out of sight.
    if tk.raw == "fn" && k + 1 < body_close && tokens[k + 1].kind == TokenKind::Ident {
      out[tokens[k + 1].raw] = true
    }
    if tk.raw == "fn" && k + 1 < body_close && tokens[k + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, k + 1)
      let mut q = k + 2
      while q < cp {
        if tokens[q].kind == TokenKind::Ident && (tokens[q - 1].kind == TokenKind::LParen ||
          tokens[q - 1].kind == TokenKind::Comma) {
          out[tokens[q].raw] = true
        }
        q = q + 1
      }
    }
    k = k + 1
  }
  // Which of them hold closures (`&name`, for `passes_closure_value`): a function-typed parameter, a name called
  // somewhere, a `let` bound to a closure literal.
  let mut p = f + 1
  while p + 1 < body_open {
    if tokens[p].kind == TokenKind::Ident && tokens[p + 1].kind == TokenKind::Colon &&
    (tokens[p - 1].kind == TokenKind::LParen || tokens[p - 1].kind == TokenKind::Comma) {
      let mut q = p + 2
      let mut d = 0
      while q < body_open && !(d == 0 && (tokens[q].kind == TokenKind::Comma || tokens[q].kind == TokenKind::RParen)) {
        let qk = tokens[q].kind
        if qk == TokenKind::LParen || qk == TokenKind::LBracket {
          d = d + 1
        } else if qk == TokenKind::RParen || qk == TokenKind::RBracket {
          d = d - 1
        } else if tokens[q].raw == "->" {
          out["&" + tokens[p].raw] = true
        }
        q = q + 1
      }
    }
    p = p + 1
  }
  k = body_open + 1
  while k + 1 < body_close {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && !(tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon) {
      if tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before && tokens[k - 1].raw != "fn" &&
      out.contains(tk.raw) {
        out["&" + tk.raw] = true
      }
      if (tokens[k - 1].raw == "let" || tokens[k - 1].raw == "mut") && k + 2 < body_close &&
      tokens[k + 1].kind == TokenKind::Eq && tokens[k + 2].raw == "fn" {
        out["&" + tk.raw] = true
      }
    }
    k = k + 1
  }
  out
}

///| Changes to the iterated array inside closures defined in `(body_open, before)` that may run while the iterator
///| reads (`[span_s, span_e)`: the region it is kept through, or a consumed chain's callbacks). A `let g = fn ..` runs
///| there only where `g` is named in that span or in another closure that does (transitively); one handed out as a
///| value (or an anonymous closure) could be run by any call there: with a fresh local root its body is checked,
///| with a non-local root only an unflagged call (a top-level function or a method not on the root) could reach it,
///| as it could reach the array itself (the cross-package residual).
fn pre_closure_mutations(
  tokens : Array[Token],
  names : Map[String, Bool],
  computed : Bool,
  body_open : Int,
  before : Int,
  root : String,
  callables : Map[String, Bool],
  user_methods : Map[String, Bool],
  span_s : Int,
  span_e : Int,
  consumed : Bool,
  flags : Array[Bool],
) -> String {
  let body_close = find_matching_delim(tokens, body_open)
  // Code that runs while it reads and could run a closure it does not name: any call (in a consumed chain, one
  // inside its callbacks), also in an interpolation hole.
  let mut span_calls = false
  let mut d = 0
  let mut z = span_s
  while z < span_e && !span_calls {
    let zk = tokens[z].kind
    if zk == TokenKind::LParen || zk == TokenKind::LBracket || zk == TokenKind::LBrace {
      d = d + 1
    } else if zk == TokenKind::RParen || zk == TokenKind::RBracket || zk == TokenKind::RBrace {
      d = d - 1
    }
    if (!consumed || d > 0) && z + 1 < span_e && tokens[z + 1].kind == TokenKind::LParen &&
    !tokens[z + 1].newline_before && (zk == TokenKind::RParen || zk == TokenKind::Ident && tokens[z].raw != "fn") {
      span_calls = true
    }
    if zk == TokenKind::InterpString || zk == TokenKind::InterpMultiline || zk == TokenKind::StringLit {
      for sub in interp_holes(tokens[z].raw) {
        for y, st in sub {
          if y + 1 < sub.length() && sub[y + 1].kind == TokenKind::LParen &&
          (st.kind == TokenKind::RParen || st.kind == TokenKind::Ident) {
            span_calls = true
          }
        }
      }
    }
    z = z + 1
  }
  // Closures defined before the iterator (outermost ones): body `{` and the name they are bound to ("" if none).
  let opens : Array[Int] = []
  let binds : Array[Int] = []
  let mut q = body_open + 1
  while q + 1 < before {
    if tokens[q].raw == "fn" && tokens[q + 1].kind == TokenKind::LParen {
      let cp = find_matching_delim(tokens, q + 1)
      let mut o = cp + 1
      while o < before && tokens[o].kind != TokenKind::LBrace && !tokens[o].newline_before {
        o = o + 1
      }
      if o < body_close && tokens[o].kind == TokenKind::LBrace {
        opens.push(o)
        let named = q >= 3 && tokens[q - 1].kind == TokenKind::Eq && tokens[q - 2].kind == TokenKind::Ident &&
        (tokens[q - 3].raw == "let" || tokens[q - 3].raw == "mut")
        binds.push(if named { q - 2 } else { -1 })
        q = find_matching_delim(tokens, o)
      }
    }
    q = q + 1
  }
  // Names mentioned where the iterator reads, grown through the bodies of the closures that may run there.
  // `reach`: named by code that runs in full sight (the span, closures checked in full); `reach_any`: also by
  // closures only some call could run (checked lightly, as is what they name).
  let reach : Map[String, Bool] = Map()
  let reach_any : Map[String, Bool] = Map()
  let mark = fn(s : Int, e : Int, full : Bool) {
    let mut k = s
    while k < e {
      if tokens[k].kind == TokenKind::Ident &&
      !(k > 0 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) {
        reach_any[tokens[k].raw] = true
        if full {
          reach[tokens[k].raw] = true
        }
      }
      k = k + 1
    }
  }
  mark(span_s, span_e, true)
  // A bound closure is handed out where its name is used other than as a call.
  let escapes = fn(bind : Int) -> Bool {
    let nm = tokens[bind].raw
    let mut k = body_open + 1
    while k < body_close {
      if k != bind && tokens[k].kind == TokenKind::Ident && tokens[k].raw == nm &&
      !(tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon) &&
      !(k + 1 < body_close && tokens[k + 1].kind == TokenKind::LParen) {
        return true
      }
      k = k + 1
    }
    false
  }
  // 0: does not run there, 1: checked lightly, 2: checked in full.
  let level : Array[Int] = []
  let handed : Array[Bool] = []
  for b in binds {
    level.push(0)
    handed.push(b < 0 || escapes(b))
  }
  let mut changed = true
  while changed {
    changed = false
    for i, o in opens {
      let b = binds[i]
      let want = if (b >= 0 && reach.contains(tokens[b].raw)) || handed[i] && !computed {
        2
      } else if (b >= 0 && reach_any.contains(tokens[b].raw)) || handed[i] && computed && span_calls {
        1
      } else {
        0
      }
      if want > level[i] {
        level[i] = want
        changed = true
        mark(o + 1, find_matching_delim(tokens, o), want == 2)
      }
    }
  }
  // A closure only some call there could run (non-local root): its own changes to arrays and to the root count,
  // not the closure values it calls in turn (those are as far from the array as the call that ran it).
  let light_callables : Map[String, Bool] = Map()
  light_callables[light_mark] = true
  for i, o in opens {
    if level[i] > 0 {
      let cs = if level[i] == 1 { light_callables } else { callables }
      let why = kept_iter_mutations(tokens, names, computed, o + 1, find_matching_delim(tokens, o), body_open, root, cs, user_methods, flags)
      if why.length() > 0 {
        return why + " (in a closure defined before the iterator)"
      }
    }
  }
  ""
}

///| Methods a key may call: no callback, no change to the receiver.
fn is_pure_key_method(m : String) -> Bool {
  m == "get" || m == "unwrap_or" || m == "unwrap" || m == "length" || m == "is_empty" || m == "contains" ||
  m == "to_int" || m == "to_double" || m == "to_float" || m == "to_string" || m == "to_int64" || m == "to_uint" ||
  m == "to_byte" || m == "abs" || m == "is_none" || m == "is_some" || m == "is_nan" || m == "is_inf" ||
  m == "is_finite" || m == "code_unit_at" || m == "char_at" || m == "reinterpret_as_int" ||
  m == "reinterpret_as_uint" || m == "compare" || m == "neg"
}

///| Of `is_pure_key_method`, those whose result is always a built-in value (`Option`, `String`, a number, `Bool`).
fn is_builtin_result_method(m : String) -> Bool {
  is_pure_key_method(m) && m != "unwrap_or" && m != "unwrap"
}

///| `mbt_compat::` helpers a key may call: not changing an array, not taking a callback.
fn is_pure_key_compat_helper(f : String) -> Bool {
  if is_mbt_compat_arr_mutating(f) {
    return false
  }
  let words = [
    "map", "filter", "each", "fold", "any", "all", "find", "sort", "retain", "search", "iter", "_by", "push", "set", "insert",
    "remove", "clear", "drain", "append", "pop", "truncate", "swap", "reverse", "shrink",
  ]
  for w in words {
    if str_has(f, w) {
      return false
    }
  }
  true
}

fn is_call_keyword(r : String) -> Bool {
  r == "fn" || r == "if" || r == "match" || r == "while" || r == "for" || r == "return" || r == "guard" ||
  r == "else" || r == "in" || r == "is" || r == "not" || r == "let" || r == "loop" || r == "break" || r == "continue"
}

fn is_ctor_name(r : String) -> Bool {
  let c0 = if r.length() > 0 { r.code_unit_at(0) } else { 0 }
  c0 >= 65 && c0 <= 90
}

///| What a `sort_by_key` key could reach besides built-ins: method names user types define (this package's
///| generated sources, its dependencies'), and `" eq"` when one of them has an `impl Eq`.
pub struct SortKeyEnv {
  methods : Map[String, Bool]
}

///| `SortKeyEnv` of generated sources (`fn T::m(`, methods of `impl .. for T { .. }`, `impl Eq`) with no dep methods.
///| Callers with dependency context should call `sort_key_env_of_with_deps` directly.
pub fn sort_key_env_of(files : Array[Array[Token]]) -> SortKeyEnv {
  sort_key_env_of_with_deps(files, Map())
}

///| Explicit-context `SortKeyEnv` builder combining package-local and dependency method names.
pub fn sort_key_env_of_with_deps(files : Array[Array[Token]], dep_methods : Map[String, Bool]) -> SortKeyEnv {
  let methods : Map[String, Bool] = Map()
  for k in dep_methods.keys() {
    methods[k] = true
  }
  for ts in files {
    let n = ts.length()
    let mut i = 0
    while i + 3 < n {
      if ts[i].raw == "fn" && ts[i + 1].kind == TokenKind::UpperIdent && ts[i + 2].kind == TokenKind::ColonColon &&
      ts[i + 3].kind == TokenKind::Ident {
        methods[ts[i + 3].raw] = true
      }
      if (ts[i].raw == "struct" || ts[i].raw == "enum" || ts[i].raw == "type") && ts[i + 1].kind == TokenKind::UpperIdent {
        methods[" type:" + ts[i + 1].raw] = true
        if ts[i].raw == "enum" {
          let mut j = i + 2
          while j < n && ts[j].kind != TokenKind::LBrace && !ts[j].newline_before {
            j = j + 1
          }
          if j < n && ts[j].kind == TokenKind::LBrace {
            let jc = find_matching_delim(ts, j)
            let mut d = 0
            let mut q = j + 1
            while q < jc {
              let qk = ts[q].kind
              if qk == TokenKind::LParen || qk == TokenKind::LBrace || qk == TokenKind::LBracket {
                d = d + 1
              } else if qk == TokenKind::RParen || qk == TokenKind::RBrace || qk == TokenKind::RBracket {
                d = d - 1
              } else if d == 0 && qk == TokenKind::UpperIdent {
                methods[" ctor:" + ts[q].raw] = true
              }
              q = q + 1
            }
          }
        }
      }
      if ts[i].raw == "impl" {
        let mut j = i + 1
        while j < n && ts[j].kind != TokenKind::LBrace && !ts[j].newline_before {
          if ts[j].raw == "Eq" {
            methods[" eq"] = true
          }
          j = j + 1
        }
        if j < n && ts[j].kind == TokenKind::LBrace {
          let jc = find_matching_delim(ts, j)
          let mut q = j + 1
          while q + 1 < jc {
            if ts[q].raw == "fn" && ts[q + 1].kind == TokenKind::Ident {
              methods[ts[q + 1].raw] = true
            }
            q = q + 1
          }
        }
      }
      i = i + 1
    }
  }
  SortKeyEnv::{ methods, }
}

///| `sort_by_key(fn(..) { .. })` (`open`: its `(`): why the key closure is not pure (`sort_key_purity_rec`), or "".
pub fn sort_key_closure_opacity(tokens : Array[Token], open : Int, env : SortKeyEnv) -> String {
  let root = if open >= 3 { receiver_root(tokens, open - 3) } else { "" }
  sort_key_closure_purity_at(tokens, open + 1, root, env)
}

///| The key closure literal whose `fn` is at `fn_i`, sorting the array rooted at `root` ("" if unknown).
pub fn sort_key_closure_purity_at(tokens : Array[Token], fn_i : Int, root : String, env : SortKeyEnv) -> String {
  if fn_i + 1 >= tokens.length() || tokens[fn_i].raw != "fn" || tokens[fn_i + 1].kind != TokenKind::LParen {
    return "the key is not a closure literal"
  }
  let cp = find_matching_delim(tokens, fn_i + 1)
  let mut o = cp + 1
  while o < tokens.length() && tokens[o].kind != TokenKind::LBrace && !tokens[o].newline_before {
    o = o + 1
  }
  if o >= tokens.length() || tokens[o].kind != TokenKind::LBrace {
    return "the key closure has no body"
  }
  let body_open = outermost_body_open(tokens, fn_i)
  // The sorted array and its names: a key may only append to another, private, array (a trace).
  let sorted : Map[String, Bool] = if root.length() > 0 && body_open >= 0 {
    array_aliases(tokens, root, body_open, find_matching_delim(tokens, body_open))
  } else {
    Map()
  }
  sort_key_purity_rec(tokens, o, find_matching_delim(tokens, o), body_open, fn_i, sorted, env, 0)
}

///| A `sort_by_key` key is run by the sort a number of times and in an order Pion cannot promise to match, so it
///| must be pure: why the body `(o, oc)` is not (a strict allow-list), or "". Calls allowed: single-binding immutable
///| local closures (checked the same way, depth <= 8), `mbt_compat::` helpers that neither change an array nor take a
///| callback, constructors (`Some(..)`), the read-only methods of `is_pure_key_method` (on a receiver proven built-in
///| when a user type defines a method of that name), and `.push` onto a private array this function allocated that
///| is not the sorted one. Anything else fails closed whatever its arguments are: an indirect call (`(f)(..)`,
///| `fs[0](..)`, `{ .. }(..)`), any other free / qualified / method call, `|>`, a string interpolation (a user
///| `Show`), a write to an element or field (a Stage A ref cell's `.v` / `.val` aside), `==` / `!=` when a user type
///| has an `impl Eq`.
fn sort_key_purity_rec(
  tokens : Array[Token],
  o : Int,
  oc : Int,
  body_open : Int,
  open : Int,
  sorted : Map[String, Bool],
  env : SortKeyEnv,
  depth : Int,
) -> String {
  let mut k = o + 1
  while k < oc {
    let tk = tokens[k]
    let kk = tk.kind
    if kk == TokenKind::InterpString || kk == TokenKind::InterpMultiline {
      return "the callback interpolates a string (a `Show` implementation may run)"
    }
    if kk == TokenKind::PipeGt {
      return "the callback pipes a value into a call (`|>`)"
    }
    if (kk == TokenKind::EqEq || tk.raw == "!=") && env.methods.contains(" eq") {
      return "the callback compares with `" + tk.raw + "` while a user type has an `impl Eq`"
    }
    if (kk == TokenKind::Eq || kk == TokenKind::AssignOp) && k > o + 1 {
      let pk = tokens[k - 1]
      if pk.kind == TokenKind::RBracket {
        return "the callback writes an element"
      }
      if pk.kind == TokenKind::Ident && k >= 3 && tokens[k - 2].kind == TokenKind::Dot &&
      !((pk.raw == "v" || pk.raw == "val") && tokens[k - 3].kind == TokenKind::Ident &&
        is_ref_cell(tokens, tokens[k - 3].raw, body_open, k - 3)) {
        return "the callback writes the field `" + pk.raw + "`"
      }
    }
    if k + 1 < oc && tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before {
      let why = sort_key_call_purity(tokens, k, body_open, open, sorted, env, depth)
      if why.length() > 0 {
        return why
      }
    }
    k = k + 1
  }
  ""
}

///| The `fn` keyword of the function whose body opens at `body_open` (depth 0 before it), or -1.
fn fn_start_of(tokens : Array[Token], body_open : Int) -> Int {
  let mut d = 0
  let mut f = body_open - 1
  while f >= 0 {
    let fk = tokens[f].kind
    if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace {
      d = d + 1
    } else if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
      if d == 0 {
        return -1
      }
      d = d - 1
    } else if d == 0 && tokens[f].raw == "fn" {
      return f
    }
    f = f - 1
  }
  -1
}

///| The occurrence of a name at `j` certainly does not bind it: a path suffix (`.h`, `::h`), a receiver (`h.m`,
///| `h[i]`), a direct call (`h(..)`), or a whole argument of a lowercase function or method call (`f(a, h)`, not
///| `fn f(h)`). Anything else -- a pattern (`h =>`, `Some(h)`, `(h, _)`, `[h, ..]`, `{ h }`), `for h in`, a
///| parameter, an assignment -- may.
fn is_definitely_non_binding_use(tokens : Array[Token], j : Int, fn_start : Int, limit : Int) -> Bool {
  if j <= 0 || j + 1 >= tokens.length() {
    return false
  }
  let pk = tokens[j - 1]
  let nx = tokens[j + 1]
  if pk.kind == TokenKind::Dot || pk.kind == TokenKind::ColonColon {
    return true
  }
  if (nx.kind == TokenKind::Dot || nx.kind == TokenKind::LBracket) && pk.raw != "fn" {
    return true
  }
  if nx.kind == TokenKind::LParen && !nx.newline_before && pk.raw != "fn" {
    return true
  }
  if (pk.kind == TokenKind::LParen || pk.kind == TokenKind::Comma) &&
  (nx.kind == TokenKind::RParen || nx.kind == TokenKind::Comma) && j + 1 < limit {
    // The innermost open bracket around `j` must be a call's `(`.
    let mut d = 0
    let mut o = j - 1
    while o > fn_start {
      let ok = tokens[o].kind
      if ok == TokenKind::RParen || ok == TokenKind::RBracket || ok == TokenKind::RBrace {
        d = d + 1
      } else if ok == TokenKind::LParen || ok == TokenKind::LBracket || ok == TokenKind::LBrace {
        if d == 0 {
          break
        }
        d = d - 1
      }
      o = o - 1
    }
    if o <= fn_start || tokens[o].kind != TokenKind::LParen || o < 1 {
      return false
    }
    let callee = tokens[o - 1]
    if callee.kind != TokenKind::Ident || is_call_keyword(callee.raw) {
      return false
    }
    // Not the parameter list of a function (`fn f(h)`, `fn[T] f(h)`, `fn T::f(h)`).
    let mut b = o - 2
    while b > fn_start {
      let bk = tokens[b].kind
      if bk == TokenKind::RBracket {
        let ob = find_open_before(tokens, b, fn_start)
        if ob <= fn_start {
          return false
        }
        b = ob - 1
        continue
      }
      if bk == TokenKind::Ident || bk == TokenKind::UpperIdent || bk == TokenKind::ColonColon {
        b = b - 1
        continue
      }
      break
    }
    return !(b >= 0 && tokens[b].raw == "fn")
  }
  false
}

///| Occurrences of `name` in `(fn_start, limit)` that may bind it (`is_definitely_non_binding_use` is false).
fn possible_binding_sites(tokens : Array[Token], name : String, fn_start : Int, limit : Int) -> Array[Int] {
  let out : Array[Int] = []
  let mut j = fn_start + 1
  while j < limit {
    if tokens[j].kind == TokenKind::Ident && tokens[j].raw == name && !is_definitely_non_binding_use(tokens, j, fn_start, limit) {
      out.push(j)
    }
    j = j + 1
  }
  out
}

///| How many occurrences of `name` in the whole function may bind it (`possible_binding_sites`).
fn possible_binding_count(tokens : Array[Token], body_open : Int, name : String) -> Int {
  let fs = fn_start_of(tokens, body_open)
  possible_binding_sites(tokens, name, if fs >= 0 { fs } else { body_open }, find_matching_delim(tokens, body_open)).length()
}

///| The only possible binding of `name` in its function before `before` (the function body opening at `body_open`),
///| or -1 when there is none or more than one.
fn sole_binding_before(tokens : Array[Token], name : String, body_open : Int, before : Int) -> Int {
  if body_open < 0 {
    return -1
  }
  let fs = fn_start_of(tokens, body_open)
  let sites = possible_binding_sites(tokens, name, if fs >= 0 { fs } else { body_open }, before)
  if sites.length() == 1 { sites[0] } else { -1 }
}

///| `name` is bound (only) by `let name = mbt_compat::ref_new(..)` (a Stage A cell for a captured `let mut`), in a
///| block still open at `before`.
fn is_ref_cell(tokens : Array[Token], name : String, body_open : Int, before : Int) -> Bool {
  let k = sole_binding_before(tokens, name, body_open, before)
  let eq_i = let_visible_at(tokens, k, body_open, before)
  eq_i == k + 1 && tokens[k - 1].raw == "let" && k + 5 < before && tokens[k + 2].raw == "mbt_compat" &&
  tokens[k + 3].kind == TokenKind::ColonColon && tokens[k + 4].raw == "ref_new" && tokens[k + 5].kind == TokenKind::LParen &&
  find_matching_delim(tokens, k + 5) == let_init_end(tokens, k + 2, find_matching_delim(tokens, body_open)) - 1
}

///| The call whose callee ends at `k` (`tokens[k + 1]` is its `(`) inside a sort key: why it is not allowed, or "".
fn sort_key_call_purity(
  tokens : Array[Token],
  k : Int,
  body_open : Int,
  open : Int,
  sorted : Map[String, Bool],
  env : SortKeyEnv,
  depth : Int,
) -> String {
  let tk = tokens[k]
  if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket || tk.kind == TokenKind::RBrace {
    return "the callback makes an indirect call"
  }
  if !(tk.kind == TokenKind::Ident || tk.kind == TokenKind::UpperIdent) || is_call_keyword(tk.raw) ||
  k > 0 && tokens[k - 1].raw == "fn" {
    return ""
  }
  let pk = tokens[k - 1]
  if pk.kind == TokenKind::Dot {
    let m = tk.raw
    if is_pure_key_method(m) && (!env.methods.contains(m) || receiver_is_builtin(tokens, k - 2, body_open, open, env)) {
      return ""
    }
    // `trace.push(x)` onto a private array that is not the sorted one.
    if m == "push" && k >= 2 && tokens[k - 2].kind == TokenKind::Ident && !(k >= 3 && tokens[k - 3].kind == TokenKind::Dot) &&
    private_trace(tokens, tokens[k - 2].raw, body_open, open, k - 2, sorted) {
      return ""
    }
    if is_pure_key_method(m) {
      return "the callback calls `." + m + "(..)` on a value not proven built-in (a user type defines `" + m + "`)"
    }
    return "the callback calls `." + m + "(..)`, which is not a known pure method"
  }
  if pk.kind == TokenKind::ColonColon {
    let q = if k >= 2 { tokens[k - 2].raw } else { "" }
    if q == "mbt_compat" && is_pure_key_compat_helper(tk.raw) || is_ctor_name(tk.raw) {
      return ""
    }
    // `mbt_compat::arr_push(trace, x)` as `trace.push(x)`.
    if q == "mbt_compat" && tk.raw == "arr_push" && k + 3 < tokens.length() && tokens[k + 2].kind == TokenKind::Ident &&
    tokens[k + 3].kind == TokenKind::Comma && private_trace(tokens, tokens[k + 2].raw, body_open, open, k + 2, sorted) {
      return ""
    }
    return "the callback makes a call to `" + q + "::" + tk.raw + "(..)`"
  }
  if is_ctor_name(tk.raw) {
    return ""
  }
  // A single-binding immutable local closure literal: the same rules inside it.
  let lb = local_closure_body(tokens, k, tk.raw)
  if lb >= 0 && !(lb < k && k < find_matching_delim(tokens, lb)) {
    if depth >= 8 {
      return "the callback calls nested local closures too deeply"
    }
    let why = sort_key_purity_rec(tokens, lb, find_matching_delim(tokens, lb), body_open, open, sorted, env, depth + 1)
    if why.length() > 0 {
      return why + " (through `" + tk.raw + "`)"
    }
    return ""
  }
  "the callback makes a call to `" + tk.raw + "(..)`"
}

///| The value ending at `e` is of a built-in type: a literal, an array literal, a constructor, a built-in-result
///| method on a built-in value, or a name declared with a built-in type (`x : Map[..]`, `let x : Int = ..`,
///| `let x = [..]` / `mbt_compat::ordered_map_..`).
fn receiver_is_builtin(tokens : Array[Token], e : Int, body_open : Int, before : Int, env : SortKeyEnv) -> Bool {
  if e < 0 {
    return false
  }
  let tk = tokens[e]
  let kk = tk.kind
  if kk == TokenKind::IntLit || kk == TokenKind::FloatLit || kk == TokenKind::StringLit || kk == TokenKind::CharLit {
    return true
  }
  if kk == TokenKind::RBracket {
    let ob = find_open_before(tokens, e, if body_open >= 0 { body_open } else { 0 })
    if ob < 1 {
      return false
    }
    let pk = tokens[ob - 1].kind
    // An array literal, not an index (`a[i]`, `f()[i]`, `{ .. }[i]`).
    return !(pk == TokenKind::Ident || pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::UpperIdent ||
      pk == TokenKind::RBrace)
  }
  if kk == TokenKind::RParen {
    let op = find_open_before(tokens, e, if body_open >= 0 { body_open } else { 0 })
    if op < 1 {
      return false
    }
    let callee = tokens[op - 1]
    // `Some(..)` / `Ok(..)` / `Err(..)` unqualified, and no user enum has a variant of that name.
    if (callee.raw == "Some" || callee.raw == "Ok" || callee.raw == "Err") &&
    !(op >= 2 && (tokens[op - 2].kind == TokenKind::ColonColon || tokens[op - 2].kind == TokenKind::Dot)) &&
    !env.methods.contains(" ctor:" + callee.raw) {
      return true
    }
    if callee.kind == TokenKind::Ident && op >= 3 && tokens[op - 2].kind == TokenKind::Dot &&
    is_builtin_result_method(callee.raw) {
      return receiver_is_builtin(tokens, op - 3, body_open, before, env)
    }
    return false
  }
  if kk == TokenKind::Ident && !(e > 0 && (tokens[e - 1].kind == TokenKind::Dot || tokens[e - 1].kind == TokenKind::ColonColon)) {
    return declared_builtin(tokens, tk.raw, body_open, e, env)
  }
  false
}

fn is_builtin_type_start(t : String) -> Bool {
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" || t == "Float" || t == "String" ||
  t == "Bool" || t == "Char" || t == "Byte" || t == "Array" || t == "FixedArray" || t == "Option" || t == "Result" ||
  t == "Map" || t == "Bytes"
}

///| `name` is declared in the function around `before` with a built-in type (parameter or `let` annotation, or a
///| `let` of an array literal / `mbt_compat::ordered_map_..` / `mbt_compat::OrderedMap`) and bound nowhere else.
fn declared_builtin(tokens : Array[Token], name : String, body_open : Int, before : Int, env : SortKeyEnv) -> Bool {
  // The one place that may bind it before its use at `before` (a pattern, a later or inner `let` count too).
  let k = sole_binding_before(tokens, name, body_open, before)
  if k < 0 {
    return false
  }
  let body_close = find_matching_delim(tokens, body_open)
  if k + 2 >= before {
    return false
  }
  // A parameter of the function itself, or a local `let` in sight at the use (`let_visible_at`).
  let decl = if k < body_open {
    is_top_param(tokens, fn_start_of(tokens, body_open), k)
  } else {
    let_visible_at(tokens, k, body_open, before) >= 0
  }
  if !decl {
    return false
  }
  if tokens[k + 1].kind == TokenKind::Colon {
    // An unqualified built-in type no user type shadows, or `mbt_compat::OrderedMap`.
    let t = tokens[k + 2]
    let qualified = k + 3 < body_close && tokens[k + 3].kind == TokenKind::ColonColon
    return is_builtin_type_start(t.raw) && !qualified && !env.methods.contains(" type:" + t.raw) ||
    t.raw == "mbt_compat" && k + 4 < body_close && tokens[k + 4].raw == "OrderedMap"
  }
  if tokens[k + 1].kind == TokenKind::Eq && k + 2 < body_close {
    // The whole initializer: one literal, one array literal, one `mbt_compat::ordered_map_..(..)` call.
    let r = tokens[k + 2]
    let re = let_init_end(tokens, k + 2, body_close)
    if r.kind == TokenKind::LBracket {
      return find_matching_delim(tokens, k + 2) == re - 1
    }
    if r.kind == TokenKind::IntLit || r.kind == TokenKind::FloatLit || r.kind == TokenKind::StringLit ||
    r.kind == TokenKind::CharLit {
      return k + 3 == re
    }
    return r.raw == "mbt_compat" && k + 5 < re && tokens[k + 4].raw.starts_with("ordered_map_") &&
    tokens[k + 5].kind == TokenKind::LParen && find_matching_delim(tokens, k + 5) == re - 1
  }
  false
}

///| `name` at `use_at` is an array this function allocated (its sole possible binding before the use, a `let` in a
///| block still open there), has not handed out before `open`, and is not the sorted one.
fn private_trace(
  tokens : Array[Token],
  name : String,
  body_open : Int,
  open : Int,
  use_at : Int,
  sorted : Map[String, Bool],
) -> Bool {
  let dk = sole_binding_before(tokens, name, body_open, use_at)
  body_open >= 0 && !sorted.contains(name) && fresh_local_binding(tokens, name, body_open, open, true) &&
  dk > body_open && let_visible_at(tokens, dk, body_open, open) >= 0 && block_open_through(tokens, dk, use_at)
}

fn opaque_call_desc(tokens : Array[Token], t : Int) -> String {
  if tokens[t].kind == TokenKind::RParen { "an indirect call" } else { "a call to `" + tokens[t].raw + "(..)`" }
}

///| Why the closure body `(o, oc)` of a callback could run code that changes arrays behind the transpiler's back:
///| an opaque call (free / indirect / qualified), an interpolation that calls something, or a non-read-only method
///| on a receiver neither allocated by the enclosing function (`fresh`) nor bound inside the closure. "" if none.
pub fn closure_body_opacity(tokens : Array[Token], o : Int, oc : Int, callables : Map[String, Bool]) -> String {
  closure_body_opacity_rec(tokens, o, oc, callables, 0)
}

///| How many places in the function whose body opens at `body_open` may bind `name`: its parameters, `let` /
///| `let mut`, local `fn`s, closure parameters, `for` variables, and pattern positions (inside a constructor's
///| parentheses, a `let (..)` / `=>` tuple, after `as`). Only a name bound once is followed to its closure.
fn name_binding_count(tokens : Array[Token], body_open : Int, name : String) -> Int {
  let body_close = find_matching_delim(tokens, body_open)
  let mut f = body_open - 1
  while f > 0 && tokens[f].raw != "fn" {
    f = f - 1
  }
  let mut n = 0
  let mut k = f + 1
  while k < body_close {
    let tk = tokens[k]
    if tk.kind == TokenKind::Ident && tk.raw == name &&
    !(tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon) &&
    !(k + 1 < body_close && tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before &&
      tokens[k - 1].raw != "fn") {
      let pk = tokens[k - 1]
      let nx = if k + 1 < body_close { tokens[k + 1] } else { tk }
      let mut binds = pk.raw == "let" || pk.raw == "mut" || pk.raw == "fn" || pk.raw == "for" || pk.raw == "as"
      // `for i, x in` / `|> fn(a, b)` / `(a, g) =>` / `let (a, g) =` / `Some(g)` / `fn(x : T)`.
      if !binds && (pk.kind == TokenKind::LParen || pk.kind == TokenKind::Comma) {
        let o = enclosing_open(tokens, k, f, TokenKind::LParen)
        if o > 0 {
          let before = tokens[o - 1]
          let close = find_matching_delim(tokens, o)
          let after = if close + 1 < body_close { tokens[close + 1].raw } else { "" }
          let c0 = if before.raw.length() > 0 { before.raw.code_unit_at(0) } else { 0 }
          binds = before.raw == "let" || before.raw == "fn" || after == "=>" || after == "=" ||
          before.kind == TokenKind::Ident && c0 >= 65 && c0 <= 90
        }
        if !binds && nx.kind == TokenKind::Colon {
          binds = true
        }
        if !binds && pk.kind == TokenKind::Comma && nx.raw == "in" {
          binds = true
        }
      }
      if binds {
        n = n + 1
      }
    }
    k = k + 1
  }
  n
}

///| `{` of the closure literal `let name = fn(..) [-> T] { .. }` in the function around `idx` (its only binding),
///| or -1.
fn local_closure_body(tokens : Array[Token], idx : Int, name : String) -> Int {
  let body_open = outermost_body_open(tokens, idx)
  if body_open < 0 || possible_binding_count(tokens, body_open, name) != 1 {
    return -1
  }
  // The `let name = fn(..)` in sight at the call (`let_visible_at`), not `let mut`.
  let dk = sole_binding_before(tokens, name, body_open, idx)
  let eq_i = let_visible_at(tokens, dk, body_open, idx)
  if eq_i < 0 || tokens[dk - 1].raw != "let" || eq_i + 2 >= tokens.length() || tokens[eq_i + 1].raw != "fn" ||
  tokens[eq_i + 2].kind != TokenKind::LParen {
    return -1
  }
  let body_close = find_matching_delim(tokens, body_open)
  let cp = find_matching_delim(tokens, eq_i + 2)
  let mut o = cp + 1
  while o < body_close && tokens[o].kind != TokenKind::LBrace {
    o = o + 1
  }
  // The literal is the whole initializer (not `fn(..) { .. }(touch)`, `|> ..`, `.m()`).
  if o < body_close && find_matching_delim(tokens, o) == let_init_end(tokens, eq_i + 1, body_close) - 1 { o } else { -1 }
}

///| `=` of the `let` binding `tokens[dk]` (past an optional `: T`), or -1.
fn let_eq_index(tokens : Array[Token], dk : Int, limit : Int) -> Int {
  let mut q = dk + 1
  if q < limit && tokens[q].kind == TokenKind::Colon {
    let mut d = 0
    while q < limit && !(d == 0 && tokens[q].kind == TokenKind::Eq) {
      let qk = tokens[q].kind
      if qk == TokenKind::LParen || qk == TokenKind::LBracket || qk == TokenKind::LBrace {
        d = d + 1
      } else if qk == TokenKind::RParen || qk == TokenKind::RBracket || qk == TokenKind::RBrace {
        d = d - 1
        if d < 0 {
          return -1
        }
      }
      q = q + 1
    }
  }
  if q < limit && tokens[q].kind == TokenKind::Eq { q } else { -1 }
}

///| End (exclusive) of the initializer starting at `rhs`: a depth-0 `;`, the enclosing closer, or a line break
///| where the line ends an expression (`can_end_expr`) and the next does not continue it (`continues_expr`).
fn let_init_end(tokens : Array[Token], rhs : Int, body_close : Int) -> Int {
  let mut d = 0
  let mut k = rhs
  while k < body_close {
    let kk = tokens[k].kind
    if d == 0 && k > rhs {
      if kk == TokenKind::Semi {
        return k
      }
      if tokens[k].newline_before && can_end_expr(tokens[k - 1]) && !continues_expr(tokens, k) {
        return k
      }
    }
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      if d == 0 {
        return k
      }
      d = d - 1
    }
    k = k + 1
  }
  body_close
}

fn can_end_expr(t : Token) -> Bool {
  let k = t.kind
  if k == TokenKind::Ident {
    let r = t.raw
    return !(r == "else" || r == "in" || r == "is" || r == "as" || r == "if" || r == "while" || r == "match" ||
      r == "for" || r == "let" || r == "mut" || r == "return" || r == "guard" || r == "break" || r == "continue" ||
      r == "fn" || r == "not" || r == "loop")
  }
  k == TokenKind::UpperIdent || k == TokenKind::IntLit || k == TokenKind::FloatLit || k == TokenKind::StringLit ||
  k == TokenKind::CharLit || k == TokenKind::InterpString || k == TokenKind::InterpMultiline ||
  k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace || t.raw == "true" || t.raw == "false"
}

///| `tokens[k]`, first on its line, continues the expression of the line before -- as Pion's parser reads it: a `+`
///| does (there is no unary `+`), a `-` (unary) or `.Variant` (a constructor) starts a new expression.
fn continues_expr(tokens : Array[Token], k : Int) -> Bool {
  let t = tokens[k]
  let r = t.raw
  if t.kind == TokenKind::Dot {
    return !(k + 1 < tokens.length() && tokens[k + 1].kind == TokenKind::UpperIdent)
  }
  t.kind == TokenKind::ColonColon || t.kind == TokenKind::PipeGt || t.kind == TokenKind::AssignOp ||
  t.kind == TokenKind::Eq || t.kind == TokenKind::EqEq || r == "else" || r == "as" || r == "is" || r == "in" ||
  r == "+" || r == "*" || r == "/" || r == "%" || r == "&&" || r == "||" ||
  r == "!=" || r == "<" || r == "<=" || r == ">" || r == ">=" || r == "&" || r == "|" || r == "^" || r == "<<" ||
  r == ">>" || r == ".." || r == "..<" || r == "..=" || r == "?" || r == "=>"
}

///| The local `let [mut] name [: T] = init` at `dk` is in sight at `use_at`: its whole initializer ends before
///| `use_at` and its block is still open there. `=`'s index, or -1.
fn let_visible_at(tokens : Array[Token], dk : Int, body_open : Int, use_at : Int) -> Int {
  if body_open < 0 || dk <= body_open || !(tokens[dk - 1].raw == "let" || tokens[dk - 1].raw == "mut") {
    return -1
  }
  let body_close = find_matching_delim(tokens, body_open)
  let eq_i = let_eq_index(tokens, dk, body_close)
  if eq_i < 0 || let_init_end(tokens, eq_i + 1, body_close) > use_at || !block_open_through(tokens, dk, use_at) {
    return -1
  }
  eq_i
}

///| `tokens[k]` is directly in the parameter list of the function starting at `fn_start` (depth 1, inside `(`).
fn is_top_param(tokens : Array[Token], fn_start : Int, k : Int) -> Bool {
  if fn_start < 0 {
    return false
  }
  let opens : Array[TokenKind] = []
  let mut j = fn_start + 1
  while j < k {
    let jk = tokens[j].kind
    if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace {
      opens.push(jk)
    } else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace {
      if opens.length() == 0 {
        return false
      }
      let _ = opens.pop()
    }
    j = j + 1
  }
  opens.length() == 1 && opens[0] == TokenKind::LParen
}

fn closure_body_opacity_rec(tokens : Array[Token], o : Int, oc : Int, callables : Map[String, Bool], depth : Int) -> String {
  let mut k = o + 1
  while k < oc {
    let tk = tokens[k]
    if is_opaque_call_at(tokens, k, oc, callables) {
      return "the callback makes " + opaque_call_desc(tokens, k)
    }
    if passes_closure_value(tokens, k, oc, callables) {
      return "the callback makes " + passed_closure_desc(tokens, k)
    }
    // A call to a local closure literal: look inside it.
    if tk.kind == TokenKind::Ident && k + 1 < oc && tokens[k + 1].kind == TokenKind::LParen &&
    !(k > 0 && (tokens[k - 1].kind == TokenKind::Dot || tokens[k - 1].kind == TokenKind::ColonColon)) {
      let lb = local_closure_body(tokens, k, tk.raw)
      if lb >= 0 && !(lb < k && k < find_matching_delim(tokens, lb)) {
        if depth >= 8 {
          return "the callback calls nested local closures too deeply"
        }
        let why = closure_body_opacity_rec(tokens, lb, find_matching_delim(tokens, lb), callables, depth + 1)
        if why.length() > 0 {
          return why + " (through `" + tk.raw + "`)"
        }
      }
    }
    if tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline || tk.kind == TokenKind::StringLit {
      for sub in interp_holes(tk.raw) {
        let mut q = 0
        while q < sub.length() {
          if is_opaque_call_at(sub, q, sub.length(), callables) {
            return "the callback interpolates " + opaque_call_desc(sub, q)
          }
          // `"\{g()}"` with `g` a local closure literal: look inside it too.
          if sub[q].kind == TokenKind::Ident && q + 1 < sub.length() && sub[q + 1].kind == TokenKind::LParen &&
          !(q > 0 && (sub[q - 1].kind == TokenKind::Dot || sub[q - 1].kind == TokenKind::ColonColon)) {
            let lb = local_closure_body(tokens, k, sub[q].raw)
            if lb >= 0 && !(lb < k && k < find_matching_delim(tokens, lb)) {
              if depth >= 8 {
                return "the callback calls nested local closures too deeply"
              }
              let why = closure_body_opacity_rec(tokens, lb, find_matching_delim(tokens, lb), callables, depth + 1)
              if why.length() > 0 {
                return why + " (through `" + sub[q].raw + "` in a string interpolation)"
              }
            }
          }
          q = q + 1
        }
      }
    }
    k = k + 1
  }
  ""
}

///| Arrays the function body allocated itself before `before` (`let xs = [..]` and other fresh right-hand sides).
pub fn fresh_locals_before(tokens : Array[Token], body_open : Int, before : Int) -> Map[String, Bool] {
  let out : Map[String, Bool] = Map()
  let mut k = body_open + 1
  while k + 1 < before {
    if tokens[k].kind == TokenKind::Ident && (tokens[k - 1].raw == "let" || tokens[k - 1].raw == "mut") &&
    fresh_local_binding(tokens, tokens[k].raw, body_open, before, false) {
      out[tokens[k].raw] = true
    }
    k = k + 1
  }
  out
}

fn is_callback_method(m : String) -> Bool {
  m == "map" || m == "filter" || m == "filter_map" || m == "each" || m == "eachi" || m == "fold" || m == "any" ||
  m == "all" || m == "find_first" || m == "flat_map" || m == "take_while" || m == "drop_while" || m == "tap" ||
  m == "map_while" || m == "mapi" || m == "count_by" || m == "find"
}

///| A consumed iterator chain from `close_p` to `end`: every callback method (`map`, `filter`, `each`, ..) must take an
///| inline closure literal whose body runs no opaque code (`closure_body_opacity`). Why not, or "".
fn chain_callbacks_opacity(
  tokens : Array[Token],
  close_p : Int,
  end : Int,
  body_open : Int,
  callables : Map[String, Bool],
) -> String {
  let mut c = close_p
  while c + 3 < end && tokens[c + 1].kind == TokenKind::Dot && tokens[c + 2].kind == TokenKind::Ident &&
  tokens[c + 3].kind == TokenKind::LParen {
    let m = tokens[c + 2].raw
    let ap = c + 3
    let ac = find_matching_delim(tokens, ap)
    if is_callback_method(m) {
      // The callback is the last argument (`fold(init=.., f)`).
      let mut s = ac - 1
      let mut d = 0
      while s > ap {
        let sk = tokens[s].kind
        if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace {
          d = d + 1
        } else if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace {
          d = d - 1
        } else if d == 0 && sk == TokenKind::Comma {
          break
        }
        s = s - 1
      }
      let a = s + 1
      // A top-level function cannot reach this function's locals; a closure value or another expression can.
      let named_top = tokens[a].kind == TokenKind::Ident && a + 1 == ac && !callables.contains(tokens[a].raw)
      if tokens[a].raw != "fn" && !named_top {
        return "`." + m + "(..)` takes a named callback (fail-closed: it could change the array while it is read)"
      }
      if named_top {
        let lb = local_closure_body(tokens, a, tokens[a].raw)
        if lb >= 0 {
          let why = closure_body_opacity(tokens, lb, find_matching_delim(tokens, lb), callables)
          if why.length() > 0 {
            return "`." + m + "(..)`: " + why + " (in `" + tokens[a].raw + "`)"
          }
        }
      }
      let mut o = a + 1
      while o < ac && tokens[o].kind != TokenKind::LBrace {
        o = o + 1
      }
      if o < ac {
        let why = closure_body_opacity(tokens, o, find_matching_delim(tokens, o), callables)
        if why.length() > 0 {
          return "`." + m + "(..)`: " + why
        }
      }
    }
    c = ac
  }
  ""
}

// =============================================================================
// Wave M2-F4 Track F4-1: Complete Slot-Stability Taxonomy, Package-Confined
// Escape Analysis, Declaration-Bound Effect Summaries, Sound `search_by`, and
// `for .. in` Array Hazard Analysis.
// =============================================================================

///| Array methods that may grow/reallocate the buffer without shifting/shrinking `0..init_len-1`.
pub fn is_cap_arr_growth_method(m : String) -> Bool {
  m == "push" || m == "append" || m == "reserve" || m == "push_iter"
}

///| Array methods that overwrite an existing slot in place without reallocating or shifting.
pub fn is_cap_arr_write_method(m : String) -> Bool {
  m == "set" || m == "unsafe_set"
}

///| Array methods that shrink length OR shift/reorder slots in a single call (unconditionally hazardous
///| during any `(buf, init_len)` snapshot iteration: `Array::iter`, `Array::search_by`, `for .. in`).
pub fn is_cap_arr_shrink_or_shift_method(m : String) -> Bool {
  m == "pop" || m == "pop_exn" || m == "unsafe_pop" || m == "clear" || m == "truncate" || m == "remove" ||
  m == "drain" || m == "retain" || m == "insert" || m == "splice" || m == "resize" || m == "swap" ||
  m == "sort" || m == "sort_by" || m == "sort_by_key" || m == "rev_in_place" || m == "map_in_place" ||
  m == "dedup"
}

pub fn is_cap_compat_growth_fn(m : String) -> Bool {
  m == "arr_push" || m == "arr_append" || m == "arr_push_iter"
}

pub fn is_cap_compat_write_fn(m : String) -> Bool {
  m == "arr_set" || m == "arr_unsafe_set"
}

pub fn is_cap_compat_shrink_or_shift_fn(m : String) -> Bool {
  m == "arr_pop" || m == "arr_clear" || m == "arr_truncate" || m == "arr_remove" || m == "arr_drain" ||
  m == "arr_retain" || m == "arr_insert" || m == "arr_splice" || m == "arr_resize" || m == "arr_swap" ||
  m == "arr_sort" || m == "arr_sort_by" || m == "arr_sort_by_key" || m == "arr_rev_in_place" ||
  m == "arr_map_in_place" || m == "arr_dedup"
}

///| True iff outermost `{` at `bo` opens a `struct` / `enum` / `trait` type declaration (not a `fn`/`test` body).
fn is_type_decl_brace(ts : Array[Token], bo : Int) -> Bool {
  if bo <= 0 {
    return false
  }
  let mut h = bo - 1
  let mut d = 0
  while h >= 0 {
    let hk = ts[h].kind
    if hk == TokenKind::RParen || hk == TokenKind::RBracket || hk == TokenKind::RBrace {
      d = d + 1
    } else if hk == TokenKind::LParen || hk == TokenKind::LBracket || hk == TokenKind::LBrace {
      if d == 0 {
        return false
      }
      d = d - 1
    } else if d == 0 {
      let r = ts[h].raw
      if r == "struct" || r == "enum" || r == "trait" {
        return true
      }
      if r == "fn" || r == "test" || r == "impl" {
        return false
      }
    }
    h = h - 1
  }
  false
}

///| Strictly prove which private array fields and private module-level arrays never escape the package:
///| 1. Field is not in `visible_fields` (private struct or `priv` field) and every declaration of that field
///|    name is `Array[..]`; module-level `let name [: Array[..]] = <fresh>` is non-`pub`.
///| 2. Every struct-literal initializer (`f: <rhs>`) and field assignment (`.f = <rhs>`) in the package
///|    assigns a freshly allocated array (`is_fresh_array_rhs`), ruling out caller-provided arrays that may
///|    already have an active iterator before being stored.
///| 3. Every use of `.f` (or the module-level `name`) in the package is a non-escaping array operation
///|    (index read/write, `.length()`/`.is_empty()`/`.push()`/`.pop()`/`.clear()`/`.shrink_to_fit()`/etc.,
///|    `mbt_compat::arr_*` non-escaping call, or `for .. in` / consumed `.iter()`): NEVER returned, NEVER
///|    passed to another function/closure, NEVER stored into another field/`Ref`/global/alias, NEVER sliced
///|    (`[:]`), NEVER kept as an escaping iterator.
fn collect_package_confined_arrays(all_tokens : Array[Array[Token]], pkg : ShrinkPkg) -> Unit {
  // Candidate private array fields: declared as Array[..] everywhere and not in visible_fields.
  let cand_fields : Map[String, Bool] = Map()
  for f in pkg.array_fields.keys() {
    if pkg.array_fields.get(f) == Some(true) && !pkg.visible_fields.contains(f) {
      cand_fields[f] = true
    }
  }
  // Candidate private module-level arrays: top-level `let [mut] name [: Array[..]] = <fresh>` without `pub`.
  let cand_globals : Map[String, Bool] = Map()
  let global_counts : Map[String, Int] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    let mut d = 0
    while i < n {
      let tk = ts[i]
      if tk.kind == TokenKind::LBrace {
        d = d + 1
      } else if tk.kind == TokenKind::RBrace {
        if d > 0 { d = d - 1 }
      } else if d == 0 && tk.raw == "let" && !(i > 0 && ts[i - 1].raw == "pub") {
        let mut ni = i + 1
        if ni < n && ts[ni].raw == "mut" { ni = ni + 1 }
        if ni < n && ts[ni].kind == TokenKind::Ident {
          let gname = ts[ni].raw
          let prev_c = match global_counts.get(gname) { Some(c) => c, None => 0 }
          global_counts[gname] = prev_c + 1
          let eq_i = let_eq_index(ts, ni, n)
          if eq_i > 0 && eq_i + 1 < n {
            let re = let_init_end(ts, eq_i + 1, n)
            if prev_c == 0 && is_fresh_array_rhs(ts, eq_i + 1, re) {
              cand_globals[gname] = true
            } else {
              cand_globals.remove(gname)
            }
          } else {
            cand_globals.remove(gname)
          }
        }
      }
      i = i + 1
    }
  }

  // Helper: check if a field/global use ending at token `p` is strictly non-escaping.
  let use_is_non_escaping = fn(ts : Array[Token], start_i : Int, p : Int, n : Int) -> Bool {
    if p + 1 >= n {
      return false
    }
    let nx = ts[p + 1]
    // 1. Direct indexing `x.f[i]` (NOT slice `x.f[a:b]` / `x.f[:]`)
    if nx.kind == TokenKind::LBracket {
      let cb = find_matching_delim(ts, p + 1)
      if cb < 0 {
        return false
      }
      let mut s = p + 2
      let mut bd = 0
      while s < cb {
        let sk = ts[s].kind
        if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { bd = bd + 1 }
        else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { bd = bd - 1 }
        else if bd == 0 && sk == TokenKind::Colon {
          // Slice `[:]` creates an ArrayView borrowing the buffer!
          return false
        }
        s = s + 1
      }
      return true
    }
    // 2. Method call `x.f.m(...)` — strictly first-order (no higher-order callback array methods, which
    //    could invoke an external closure that re-enters a `pub fn` calling `shrink_to_fit`!)
    if nx.kind == TokenKind::Dot && p + 3 < n && ts[p + 2].kind == TokenKind::Ident &&
    ts[p + 3].kind == TokenKind::LParen {
      let m = ts[p + 2].raw
      if is_higher_order_arr_method(m) || m == "iter" {
        return false
      }
      return is_read_only_array_method(m) || is_cap_arr_growth_method(m) ||
      is_cap_arr_write_method(m) || is_cap_arr_shrink_or_shift_method(m) ||
      m == "shrink_to_fit" || m == "release_unused"
    }
    // 3. `for .. in x.f {`
    if nx.kind == TokenKind::LBrace {
      let mut h = start_i - 1
      while h >= 0 && !ts[h].newline_before {
        if ts[h].raw == "in" {
          return true
        }
        h = h - 1
      }
    }
    // 4. First argument of a first-order non-escaping `mbt_compat::arr_*` helper
    if start_i >= 4 && ts[start_i - 1].kind == TokenKind::LParen &&
    ts[start_i - 2].kind == TokenKind::Ident && ts[start_i - 2].raw.starts_with("arr_") &&
    ts[start_i - 3].kind == TokenKind::ColonColon && ts[start_i - 4].raw == "mbt_compat" &&
    (nx.kind == TokenKind::Comma || nx.kind == TokenKind::RParen) {
      let cname = ts[start_i - 2].raw
      let suffix = cname.slice(4, cname.length())
      if cname == "arr_to_array" || cname == "arr_iter" || is_higher_order_arr_method(suffix) {
        return false
      }
      return true
    }
    // 5. Reassignment `x.f = <fresh>`
    if nx.kind == TokenKind::Eq && p + 2 < n {
      let re = let_init_end(ts, p + 2, n)
      return is_fresh_array_rhs(ts, p + 2, re)
    }
    false
  }

  // Verify every occurrence of every candidate field & global across all files.
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      let tk = ts[i]
      // Check struct literal field init `f: <rhs>` (outside struct type declarations).
      if tk.kind == TokenKind::Ident && cand_fields.contains(tk.raw) && i + 1 < n && ts[i + 1].kind == TokenKind::Colon {
        // Skip struct definition `struct S { f : Array[T] }`
        let bo = outermost_body_open(ts, i)
        if bo >= 0 && !is_type_decl_brace(ts, bo) {
          // Inside a function/test body: this is a struct literal field init `f: <rhs>` or pattern.
          // Find end of field initializer at depth 0 (`,` or `}`).
          let rhs_s = i + 2
          let mut rhs_e = rhs_s
          let mut fd = 0
          while rhs_e < n {
            let rk = ts[rhs_e].kind
            if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { fd = fd + 1 }
            else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
              if fd == 0 { break }
              fd = fd - 1
            } else if fd == 0 && rk == TokenKind::Comma {
              break
            }
            rhs_e = rhs_e + 1
          }
          if !is_fresh_array_rhs(ts, rhs_s, rhs_e) {
            cand_fields.remove(tk.raw)
          }
        }
      }
      // Check struct literal punning `{ .., f, .. }` inside a function body (could store a caller array!).
      if tk.kind == TokenKind::Ident && cand_fields.contains(tk.raw) && i > 0 && i + 1 < n &&
      (ts[i - 1].kind == TokenKind::LBrace || ts[i - 1].kind == TokenKind::Comma) &&
      (ts[i + 1].kind == TokenKind::Comma || ts[i + 1].kind == TokenKind::RBrace) {
        let bo = outermost_body_open(ts, i)
        if bo >= 0 {
          cand_fields.remove(tk.raw)
        }
      }
      // Check field access `<recv>.f`
      if tk.kind == TokenKind::Ident && cand_fields.contains(tk.raw) && i > 0 && ts[i - 1].kind == TokenKind::Dot {
        // Walk back to start of receiver path `a.b.f`
        let mut s = i - 2
        while s >= 2 && ts[s - 1].kind == TokenKind::Dot && ts[s - 2].kind == TokenKind::Ident {
          s = s - 2
        }
        if s < 0 { s = 0 }
        if !use_is_non_escaping(ts, s, i, n) {
          cand_fields.remove(tk.raw)
        }
      }
      // Check global array use inside function bodies
      if tk.kind == TokenKind::Ident && cand_globals.contains(tk.raw) &&
      !(i > 0 && (ts[i - 1].kind == TokenKind::Dot || ts[i - 1].kind == TokenKind::ColonColon)) {
        let bo = outermost_body_open(ts, i)
        if bo >= 0 {
          if !use_is_non_escaping(ts, i, i, n) {
            cand_globals.remove(tk.raw)
          }
        }
      }
      i = i + 1
    }
  }

  for f in cand_fields.keys() {
    pkg.visible_fields[" confined_field:" + f] = true
  }
  for g in cand_globals.keys() {
    pkg.visible_fields[" confined_global:" + g] = true
  }
}

///| Built-in type qualifiers whose static constructors / helpers (`Array::make`, `Double::from_int`, etc.)
///| are first-order stdlib operations and never mutate a caller's iterated array.
fn is_builtin_type_qualifier(q : String) -> Bool {
  q == "Array" || q == "FixedArray" || q == "Bytes" || q == "Int" || q == "Int64" ||
  q == "UInt" || q == "UInt64" || q == "Double" || q == "Float" || q == "Char" ||
  q == "String" || q == "StringBuilder" || q == "Map" || q == "Set" ||
  q == "Option" || q == "Result" || q == "OrderedMap" || q == "OrderedSet" ||
  q == "Math" || q == "Iter" || q == "Byte" || q == "Bool"
}

///| Declaration-bound effect summary for one package function or method.
pub struct CapFnEffect {
  decl_key : String
  is_pub : Bool
  mut may_shrink_or_shift : Bool
  mut may_grow : Bool
  mut may_write : Bool
  mut may_shrink_to_fit : Bool
  // True for any unknown call (opaque closure, indirect call, cross-package dep call, etc.).
  mut may_call_unknown : Bool
  // True specifically for opaque / non-dep-helper unknown calls (indirect, closure param, `|>`, `InterpString`,
  // 3-seg dep call, or mutating/unknown `impl Eq`).
  mut may_call_opaque : Bool
  // True iff this function (or a callee) passes a function parameter directly to a cross-package `dep::f(param)` call.
  mut may_pass_param_to_dep : Bool
  // Positional parameter indices (0-based) passed directly to a cross-package `dep::f(param)` call.
  dep_escaped_params : Map[Int, Bool]
  // Package-level global array names mutated (shrink/shift/shrink_to_fit) directly or transitively.
  mutated_globals : Map[String, Bool]
  // Struct field names (`.field`) mutated (shrink/shift/shrink_to_fit), grown, or written directly or transitively.
  mutated_fields : Map[String, Bool]
  grew_fields : Map[String, Bool]
  wrote_fields : Map[String, Bool]
}

pub fn CapFnEffect::is_pure_read_only(self : CapFnEffect) -> Bool {
  !self.may_shrink_or_shift && !self.may_grow && !self.may_write &&
  !self.may_shrink_to_fit && !self.may_call_unknown
}

///| Higher-order array methods that take a user callback (may re-enter `pub fn` during active snapshot).
fn is_higher_order_arr_method(m : String) -> Bool {
  m == "each" || m == "eachi" || m == "rev_each" || m == "rev_eachi" ||
  m == "map" || m == "mapi" || m == "filter" || m == "filter_map" ||
  m == "fold" || m == "foldi" || m == "rev_fold" || m == "rev_foldi" ||
  m == "any" || m == "all" || m == "search_by" || m == "sort_by" ||
  m == "sort_by_key" || m == "retain" || m == "retain_map" || m == "zip" ||
  m == "flat_map" || m == "find_index" || m == "find_first" || m == "count_by"
}

///| First-order built-in container / primitive methods that cannot invoke user callbacks when called on a
///| proven built-in or fresh local receiver (even if a dependency like `mbt_compat` defines a same-name method).
fn is_builtin_first_order_method(m : String) -> Bool {
  is_pure_key_method(m) || is_read_only_array_method(m) ||
  is_cap_arr_growth_method(m) || is_cap_arr_write_method(m) || is_cap_arr_shrink_or_shift_method(m) ||
  m == "get" || m == "set" || m == "remove" || m == "contains" || m == "contains_key" ||
  m == "keys" || m == "values" || m == "size" || m == "len" ||
  m == "write_string" || m == "write_char" || m == "write_byte" || m == "write_int" ||
  m == "is_some" || m == "is_none" || m == "is_ok" || m == "is_err" || m == "unwrap" || m == "unwrap_or" ||
  m == "abs" || m == "floor" || m == "ceil" || m == "round" || m == "trunc" || m == "sqrt" ||
  m == "min" || m == "max" || m == "clamp" || m == "to_double" || m == "to_float" || m == "to_int64" ||
  m == "to_uint" || m == "to_uint64" || m == "to_byte" || m == "to_bytes" ||
  m == "has_prefix" || m == "has_suffix" || m == "starts_with" || m == "ends_with" ||
  m == "trim" || m == "trim_start" || m == "trim_end" || m == "to_lower" || m == "to_upper" ||
  m == "index_of" || m == "last_index_of" || m == "slice" || m == "substring" || m == "split"
}

///| Declaration-bound package effect summary for sound `search_by`, `kept_iter`, and `for .. in` analysis.
pub struct CapPkgSummary {
  // Keyed by canonical `recv_type + "::" + method_name` (or `"::" + fn_name` for free functions).
  effects : Map[String, CapFnEffect]
  // Bare method/fn name -> list of canonical decl_keys declaring it.
  by_name : Map[String, Array[String]]
  // User-defined methods + dependency methods (for built-in method shadowing / `impl Eq` checks).
  sort_env : SortKeyEnv
  // Dependency method names explicitly passed into `collect_cap_pkg_summary` (no hidden global reads).
  dep_methods : Map[String, Bool]
  // True iff any user type in this package or its deps defines `impl Eq`.
  has_custom_eq : Bool
  // True iff a type declared IN THIS PACKAGE defines `impl Eq`.
  local_has_custom_eq : Bool
  // True iff a dependency defines `op_equal` / `eq` / `equal`.
  dep_has_custom_eq : Bool
  // Local types whose `impl Eq` is NOT proven free of array/opaque hazards (or "*" if unattributed).
  impure_eq_types : Map[String, Bool]
  // Local types whose `Eq` (manual or derived non-generic struct/enum) IS proven free of array/opaque hazards.
  pure_eq_types : Map[String, Bool]
  // Unambiguous variant constructor names uniquely owned by a local enum in `pure_eq_types`.
  pure_enum_ctors : Map[String, Bool]
  // All struct type names declared in this package.
  local_struct_names : Map[String, Bool]
  // Unambiguous local free-function return types (`fn f(..) -> Int` -> `"Int"`, `-> Array[Rule]` -> `"Array:Rule"`).
  fn_return_types : Map[String, String]
  // Struct field name -> unambiguous type string ("Int", "Array:Int", "Node", or "" if ambiguous).
  field_types : Map[String, String]
  // Struct field name -> true iff EVERY struct declaration of this field has a built-in scalar or Option[built-in] type.
  field_all_builtin : Map[String, Bool]
  // Struct `Array[Elem]` field name -> unambiguous `Elem` type across all `Array[..]` declarations of that field.
  array_elem_types : Map[String, String]
  // Struct `Array[Elem]` field name -> true iff EVERY `Array[..]` declaration of this field has a built-in scalar `Elem`.
  array_elem_all_builtin : Map[String, Bool]
  // Struct `Array[Elem]` field name -> set of all declared `Elem` types across structs (disjoint sets cannot alias).
  array_elem_type_sets : Map[String, Map[String, Bool]]
  // Struct `Array[Elem]` field name -> true iff any `Array[..]` declaration of this field has an unresolved/generic `Elem`.
  array_elem_unknown : Map[String, Bool]
  // Struct `Array[Array[Inner]]` field name -> canonical `Inner` type (or "" if ambiguous/unresolved).
  nested_array_elem_types : Map[String, String]
  // Non-pub struct `Array` fields initialized only with fresh arrays, never reassigned, and never escaping.
  distinct_array_fields : Map[String, Bool]
  // Package functions/methods whose every return path yields a fresh, non-escaping `Array`.
  fn_ret_fresh_array : Map[String, Bool]
  // Package functions/methods whose every return path yields either a fresh `Array` or the same struct `Array` field `F`.
  fn_ret_field : Map[String, String]
  // Struct closure fields `(e.f)()` proven safe: struct is non-pub or field is `priv`, and every
  // construction/assignment in the package assigns a pure closure literal.
  safe_closure_fields : Map[String, Bool]
  // Array-typed fields map (from `collect_array_fields_from_tokens`).
  array_fields : Map[String, Bool]
  // Top-level module-level `let` bindings declared in this package.
  pkg_globals : Map[String, Bool]
}

pub fn CapPkgSummary::empty() -> CapPkgSummary {
  CapPkgSummary::{
    effects: Map(),
    by_name: Map(),
    sort_env: SortKeyEnv::{ methods: Map() },
    dep_methods: Map(),
    has_custom_eq: false,
    local_has_custom_eq: false,
    dep_has_custom_eq: false,
    impure_eq_types: Map(),
    pure_eq_types: Map(),
    pure_enum_ctors: Map(),
    local_struct_names: Map(),
    fn_return_types: Map(),
    field_types: Map(),
    field_all_builtin: Map(),
    array_elem_types: Map(),
    array_elem_all_builtin: Map(),
    array_elem_type_sets: Map(),
    array_elem_unknown: Map(),
    nested_array_elem_types: Map(),
    distinct_array_fields: Map(),
    fn_ret_fresh_array: Map(),
    fn_ret_field: Map(),
    safe_closure_fields: Map(),
    array_fields: Map(),
    pkg_globals: Map(),
  }
}

fn is_type_ident_tok(k : TokenKind) -> Bool {
  k == TokenKind::Ident || k == TokenKind::UpperIdent
}

fn is_builtin_eq_type_name(t : String) -> Bool {
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" || t == "Double" ||
  t == "Float" || t == "Bool" || t == "Char" || t == "Byte" || t == "String" || t == "Unit"
}

fn is_pure_eq_type_name(t : String, summary : CapPkgSummary) -> Bool {
  is_builtin_eq_type_name(t) || summary.pure_eq_types.contains(t)
}

///| Extract local type dependencies from a type expression slice `ts[s..e)`.
///| Returns `true` iff every leaf is a built-in scalar or a plain local type name (no generics, no `pkg::Ty`, no `->`).
fn extract_pure_type_deps(ts : Array[Token], s_in : Int, e_in : Int, deps : Array[String]) -> Bool {
  let mut s = s_in
  let mut e = e_in
  // Skip trailing `?` (Option sugar)
  while e > s && ts[e - 1].raw == "?" {
    e = e - 1
  }
  if s >= e {
    return false
  }
  if e == s + 1 {
    if !is_type_ident_tok(ts[s].kind) {
      return false
    }
    if !is_builtin_eq_type_name(ts[s].raw) {
      deps.push(ts[s].raw)
    }
    return true
  }
  // `Option[T]` / `Array[T]` / `FixedArray[T]`
  if (ts[s].raw == "Option" || ts[s].raw == "Array" || ts[s].raw == "FixedArray") &&
  s + 2 < e && ts[s + 1].kind == TokenKind::LBracket && find_matching_delim(ts, s + 1) == e - 1 {
    return extract_pure_type_deps(ts, s + 2, e - 1, deps)
  }
  // Tuple `(T1, T2, ...)` — note: `(A) -> B` will NOT have `find_matching_delim(ts, s) == e - 1`.
  if ts[s].kind == TokenKind::LParen && find_matching_delim(ts, s) == e - 1 {
    let mut cur = s + 1
    let mut k = s + 1
    let mut d = 0
    while k < e - 1 {
      let kk = ts[k].kind
      if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
      else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
      else if d == 0 && kk == TokenKind::Comma {
        if !extract_pure_type_deps(ts, cur, k, deps) {
          return false
        }
        cur = k + 1
      }
      k = k + 1
    }
    if cur < e - 1 {
      return extract_pure_type_deps(ts, cur, e - 1, deps)
    }
    return true
  }
  false
}

///| Collect local non-generic `struct` / `enum` type dependencies for monotone `pure_eq_types` fixpoint,
///| all local struct names (`local_struct_names`), and all local enum variant constructor owners (`ctor_owner`).
fn collect_local_pure_type_candidates(
  all_tokens : Array[Array[Token]],
) -> (Map[String, Bool], Map[String, Array[String]], Map[String, String]) {
  let local_structs : Map[String, Bool] = Map()
  let candidates : Map[String, Array[String]] = Map()
  let invalid_candidates : Map[String, Bool] = Map()
  let ctor_owner : Map[String, String] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      let is_struct = ts[i].raw == "struct" && (ts[i].kind == TokenKind::Keyword || ts[i].kind == TokenKind::Ident)
      let is_enum = ts[i].raw == "enum" && (ts[i].kind == TokenKind::Keyword || ts[i].kind == TokenKind::Ident)
      if (is_struct || is_enum) && i + 1 < n && is_type_ident_tok(ts[i + 1].kind) {
        let tname = ts[i + 1].raw
        if is_struct {
          local_structs[tname] = true
        }
        let mut o = i + 2
        let mut is_generic = false
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          if ts[o].kind == TokenKind::LBracket {
            is_generic = true
          }
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          if is_generic {
            invalid_candidates[tname] = true
          }
          let deps : Array[String] = []
          let mut all_ok = !is_generic
          if is_struct {
            // Fail-closed struct field scan: every top-level token inside `{ ... }` must be a separator,
            // visibility/mutability modifier (`pub`, `pub(...)`, `priv`, `mut`), or a recognized `name : Type` field.
            let mut k = o + 1
            let mut d = 0
            while k > 0 && k < close {
              let kk = ts[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
                if d == 0 {
                  all_ok = false
                }
                d = d + 1
              } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
                d = d - 1
              } else if d == 0 {
                if kk == TokenKind::Comma || kk == TokenKind::Semi || ts[k].raw == "mut" || ts[k].raw == "priv" {
                  k = k + 1
                  continue
                }
                if ts[k].raw == "pub" {
                  if k + 1 < close && ts[k + 1].kind == TokenKind::LParen {
                    let rp_v = find_matching_delim(ts, k + 1)
                    if rp_v > k + 1 && rp_v < close {
                      k = rp_v + 1
                      continue
                    }
                    all_ok = false
                  }
                  k = k + 1
                  continue
                }
                if kk == TokenKind::Ident && k + 2 < close && ts[k + 1].kind == TokenKind::Colon &&
                (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "priv" ||
                  ts[k - 1].raw == "pub" || ts[k - 1].kind == TokenKind::RParen ||
                  ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
                  let ty_s = k + 2
                  let mut ty_e = ty_s
                  let mut td = 0
                  while ty_e < close {
                    let tk = ts[ty_e].kind
                    if td == 0 && (tk == TokenKind::Comma || tk == TokenKind::Semi || (ty_e > ty_s && ts[ty_e].newline_before)) {
                      break
                    }
                    if tk == TokenKind::LParen || tk == TokenKind::LBracket || tk == TokenKind::LBrace { td = td + 1 }
                    else if tk == TokenKind::RParen || tk == TokenKind::RBracket || tk == TokenKind::RBrace { td = td - 1 }
                    ty_e = ty_e + 1
                  }
                  if all_ok && !extract_pure_type_deps(ts, ty_s, ty_e, deps) {
                    all_ok = false
                  }
                  k = ty_e
                  continue
                }
                // Unrecognized top-level token in struct body -> fail closed!
                all_ok = false
              }
              k = k + 1
            }
          } else {
            // `enum E { Variant1; Variant2(T1, label~ : T2); ... }`
            let mut k = o + 1
            let mut d = 0
            while k > 0 && k < close {
              let kk = ts[k].kind
              if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
              else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
              else if d == 0 && kk == TokenKind::UpperIdent &&
              (k == o + 1 || ts[k].newline_before || ts[k - 1].kind == TokenKind::Semi || ts[k - 1].kind == TokenKind::Comma) {
                let vname = ts[k].raw
                if vname != "Some" && vname != "None" && vname != "Ok" && vname != "Err" {
                  match ctor_owner.get(vname) {
                    Some(prev) => if prev != tname { ctor_owner[vname] = "" }
                    None => ctor_owner[vname] = tname
                  }
                }
                if k + 1 < close && ts[k + 1].kind == TokenKind::LParen && !ts[k + 1].newline_before {
                  let rp = find_matching_delim(ts, k + 1)
                  if rp > k + 1 && rp < close {
                    if all_ok {
                      let mut cur = k + 2
                      let mut pk = k + 2
                      let mut pd = 0
                      while pk <= rp {
                        let at_end = pk == rp
                        let pkk = ts[pk].kind
                        if !at_end && (pkk == TokenKind::LParen || pkk == TokenKind::LBracket || pkk == TokenKind::LBrace) { pd = pd + 1 }
                        else if !at_end && (pkk == TokenKind::RParen || pkk == TokenKind::RBracket || pkk == TokenKind::RBrace) { pd = pd - 1 }
                        else if at_end || (pd == 0 && pkk == TokenKind::Comma) {
                          if cur < pk {
                            // Handle optional `[mut] label~ : Type`
                            let mut ts_ = cur
                            if ts_ < pk && ts[ts_].raw == "mut" { ts_ = ts_ + 1 }
                            let mut colon_i = -1
                            let mut scan = ts_
                            let mut sd = 0
                            while scan < pk {
                              let sk = ts[scan].kind
                              if sk == TokenKind::LParen || sk == TokenKind::LBracket || sk == TokenKind::LBrace { sd = sd + 1 }
                              else if sk == TokenKind::RParen || sk == TokenKind::RBracket || sk == TokenKind::RBrace { sd = sd - 1 }
                              else if sd == 0 && sk == TokenKind::Colon { colon_i = scan; break }
                              scan = scan + 1
                            }
                            if colon_i >= 0 {
                              ts_ = colon_i + 1
                            }
                            if !extract_pure_type_deps(ts, ts_, pk, deps) {
                              all_ok = false
                            }
                          }
                          cur = pk + 1
                        }
                        pk = pk + 1
                      }
                    }
                    k = rp + 1
                    continue
                  } else {
                    all_ok = false
                  }
                }
              }
              k = k + 1
            }
          }
          if all_ok && !invalid_candidates.contains(tname) {
            candidates[tname] = deps
          } else {
            invalid_candidates[tname] = true
            candidates.remove(tname)
          }
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  (local_structs, candidates, ctor_owner)
}

fn canonical_type_span(ts : Array[Token], s : Int, e : Int) -> String {
  let mut res = ""
  let mut i = s
  while i < e {
    res = res + ts[i].raw
    i = i + 1
  }
  res
}

fn elem_sets_may_overlap(s1 : Map[String, Bool], u1 : Bool, s2 : Map[String, Bool], u2 : Bool) -> Bool {
  if u1 || u2 || s1.length() == 0 || s2.length() == 0 {
    return true
  }
  for t in s1.keys() {
    if s2.contains(t) {
      return true
    }
  }
  false
}

///| Extract `(is_field, root, tail)` for either `<x>.<f>` or nested `<x>.<f>[<idx>]`.
fn indexed_field_tail(tokens : Array[Token], end_i : Int, limit_s : Int) -> (Bool, String, String) {
  if end_i >= limit_s + 2 && tokens[end_i].kind == TokenKind::Ident && tokens[end_i - 1].kind == TokenKind::Dot {
    return (true, receiver_root(tokens, end_i), tokens[end_i].raw)
  }
  if end_i >= limit_s + 4 && tokens[end_i].kind == TokenKind::RBracket {
    let lb = find_open_before(tokens, end_i, limit_s)
    if lb >= limit_s + 2 && tokens[lb - 1].kind == TokenKind::Ident && tokens[lb - 2].kind == TokenKind::Dot {
      return (true, receiver_root(tokens, lb - 1), tokens[lb - 1].raw)
    }
  }
  (false, receiver_root(tokens, end_i), path_tail(tokens, end_i))
}

///| Collect unambiguous struct field types, per-field `Array` element type sets, and nested `Array[Array[Inner]]` types.
fn collect_struct_field_types_from_tokens(
  all_tokens : Array[Array[Token]],
) -> (
  Map[String, String],
  Map[String, Bool],
  Map[String, String],
  Map[String, Bool],
  Map[String, Map[String, Bool]],
  Map[String, Bool],
  Map[String, String],
) {
  let out : Map[String, String] = Map()
  let field_bi : Map[String, Bool] = Map()
  let arr_elems : Map[String, String] = Map()
  let arr_bi : Map[String, Bool] = Map()
  let arr_elem_sets : Map[String, Map[String, Bool]] = Map()
  let arr_elem_unk : Map[String, Bool] = Map()
  let nested_arr_elems : Map[String, String] = Map()
  let add_elem_set = fn(fname : String, ty : String) {
    let set = match arr_elem_sets.get(fname) {
      Some(m) => m
      None => Map()
    }
    set[ty] = true
    arr_elem_sets[fname] = set
  }
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      if ts[i].raw == "struct" && (ts[i].kind == TokenKind::Keyword || ts[i].kind == TokenKind::Ident) {
        let mut o = i + 1
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          let mut d = 0
          while k > 0 && k < close {
            let kk = ts[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
              d = d + 1
            } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
              d = d - 1
            } else if d == 0 && kk == TokenKind::Ident && k + 2 < close && ts[k + 1].kind == TokenKind::Colon &&
            (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "priv" ||
              ts[k - 1].raw == "pub" || ts[k - 1].kind == TokenKind::RParen ||
              ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
              let fname = ts[k].raw
              let is_plain_arr = ts[k + 2].raw == "Array" && k + 5 < close && ts[k + 3].kind == TokenKind::LBracket &&
              is_type_ident_tok(ts[k + 4].kind) && ts[k + 5].kind == TokenKind::RBracket &&
              !(k + 6 < close && ts[k + 6].raw == "?")
              let is_plain_opt = ts[k + 2].raw == "Option" && k + 5 < close && ts[k + 3].kind == TokenKind::LBracket &&
              is_type_ident_tok(ts[k + 4].kind) && ts[k + 5].kind == TokenKind::RBracket
              let ty_str = if is_plain_arr {
                "Array:" + ts[k + 4].raw
              } else if is_plain_opt {
                ts[k + 4].raw
              } else if is_type_ident_tok(ts[k + 2].kind) &&
              !(k + 3 < close && (ts[k + 3].kind == TokenKind::LBracket || ts[k + 3].kind == TokenKind::ColonColon)) {
                ts[k + 2].raw
              } else {
                ""
              }
              match out.get(fname) {
                Some(prev) => if prev != ty_str { out[fname] = "" }
                None => out[fname] = ty_str
              }
              let this_bi = is_builtin_eq_type_name(ty_str)
              let prev_bi = match field_bi.get(fname) { Some(v) => v, None => true }
              field_bi[fname] = prev_bi && this_bi
              if is_plain_arr {
                let elem = ts[k + 4].raw
                match arr_elems.get(fname) {
                  Some(prev) => if prev != elem { arr_elems[fname] = "" }
                  None => arr_elems[fname] = elem
                }
                let prev_abi = match arr_bi.get(fname) { Some(v) => v, None => true }
                arr_bi[fname] = prev_abi && is_builtin_eq_type_name(elem)
                add_elem_set(fname, elem)
              } else if ts[k + 2].raw == "Array" && k + 3 < close && ts[k + 3].kind == TokenKind::LBracket {
                arr_elems[fname] = ""
                arr_bi[fname] = false
                let rb_arr = find_matching_delim(ts, k + 3)
                if rb_arr > k + 4 && rb_arr < close && !(rb_arr + 1 < close && ts[rb_arr + 1].raw == "?") {
                  if ts[k + 4].raw == "Array" && k + 5 < rb_arr && ts[k + 5].kind == TokenKind::LBracket &&
                  find_matching_delim(ts, k + 5) == rb_arr - 1 {
                    let inner_ty = canonical_type_span(ts, k + 6, rb_arr - 1)
                    if inner_ty.length() > 0 {
                      add_elem_set(fname, "Array[" + inner_ty + "]")
                      match nested_arr_elems.get(fname) {
                        Some(prev) => if prev != inner_ty { nested_arr_elems[fname] = "" }
                        None => nested_arr_elems[fname] = inner_ty
                      }
                    } else {
                      arr_elem_unk[fname] = true
                    }
                  } else if ts[k + 4].kind == TokenKind::LParen && find_matching_delim(ts, k + 4) == rb_arr - 1 {
                    let tup_ty = canonical_type_span(ts, k + 4, rb_arr)
                    if tup_ty.length() > 0 {
                      add_elem_set(fname, tup_ty)
                    } else {
                      arr_elem_unk[fname] = true
                    }
                  } else {
                    arr_elem_unk[fname] = true
                  }
                } else {
                  arr_elem_unk[fname] = true
                }
              } else {
                // Any non-`Array[Plain]` declaration of `fname` (e.g. `Bag` with custom `op_get`) poisons array elem tables
                arr_elems[fname] = ""
                arr_bi[fname] = false
              }
            }
            k = k + 1
          }
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  (out, field_bi, arr_elems, arr_bi, arr_elem_sets, arr_elem_unk, nested_arr_elems)
}

///| Check whether a bare method or free function name is proven pure read-only across ALL package declarations
///| of that name (returns false if undeclared, shadowed by a dep method, or any declaration has effects).
fn summary_fn_is_pure_read_only(summary : CapPkgSummary, name : String, is_method : Bool) -> Bool {
  if is_method {
    match summary.by_name.get(name) {
      Some(keys) => {
        if keys.length() == 0 {
          return false
        }
        // If a dependency also defines a method of this name, we lack its body -> fail closed.
        if summary.dep_methods.contains(name) {
          return false
        }
        for dk in keys {
          match summary.effects.get(dk) {
            Some(ef) => if !ef.is_pure_read_only() { return false }
            None => return false
          }
        }
        true
      }
      None => false
    }
  } else {
    let dk = "::" + name
    match summary.effects.get(dk) {
      Some(ef) => ef.is_pure_read_only()
      None => false
    }
  }
}

///| Check whether a package function/method may perform a hazardous array op (shrink/shift/shrink_to_fit or grow+write).
fn summary_fn_may_hazard_array(summary : CapPkgSummary, name : String) -> Bool {
  match summary.by_name.get(name) {
    Some(keys) => {
      for dk in keys {
        match summary.effects.get(dk) {
          Some(ef) =>
          if ef.may_shrink_or_shift || ef.may_shrink_to_fit || (ef.may_grow && ef.may_write) {
            return true
          }
          None => ()
        }
      }
      false
    }
    None => false
  }
}

///| True iff expression slice `ts[s..e]` (inclusive) is a syntactically fresh array constructor.
fn expr_is_fresh_array_init(ts : Array[Token], s_in : Int, e_in : Int) -> Bool {
  let mut s = s_in
  let mut e = e_in
  while s < e && ts[s].kind == TokenKind::LParen && find_matching_delim(ts, s) == e {
    s = s + 1
    e = e - 1
  }
  if e < s {
    return false
  }
  if ts[s].kind == TokenKind::LBracket && find_matching_delim(ts, s) == e {
    return true
  }
  if ts[e].kind == TokenKind::RParen {
    let lp = find_open_before(ts, e, s)
    if lp >= s + 3 && ts[lp - 2].kind == TokenKind::ColonColon {
      let q = ts[lp - 3].raw
      let f = ts[lp - 1].raw
      if q == "Array" && (f == "new" || f == "make" || f == "makei" || f == "from_iter") && lp - 3 == s {
        return true
      }
      if q == "mbt_compat" && (f == "arr_new" || f == "arr_make" || f == "arr_copy" || f == "arr_to_array" || f == "arr_map" || f == "arr_filter") && lp - 3 == s {
        return true
      }
    }
    if lp >= s + 2 && ts[lp - 2].kind == TokenKind::Dot && (ts[lp - 1].raw == "copy" || ts[lp - 1].raw == "to_array") {
      return true
    }
  }
  false
}

///| Collect non-pub struct `Array` fields that are exclusively initialized with fresh arrays,
///| never reassigned, and never escape (only accessed via `.method(..)`, `[idx]`, `for .. in`, or `mbt_compat::arr_*`).
fn collect_distinct_array_fields(
  all_tokens : Array[Array[Token]],
  array_fields : Map[String, Bool],
) -> Map[String, Bool] {
  let cand : Map[String, Bool] = Map()
  let disqualified : Map[String, Bool] = Map()
  // 1. Check all struct declarations: field must appear ONLY in non-pub structs and ONLY as Array[..].
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      if ts[i].raw == "struct" && (ts[i].kind == TokenKind::Keyword || ts[i].kind == TokenKind::Ident) {
        let is_pub_struct = i > 0 && (ts[i - 1].raw == "pub" || ts[i - 1].kind == TokenKind::RParen)
        let mut o = i + 1
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          let mut d = 0
          while k > 0 && k + 2 < close {
            let kk = ts[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { d = d + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { d = d - 1 }
            else if d == 0 && kk == TokenKind::Ident && ts[k + 1].kind == TokenKind::Colon &&
            (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "priv" ||
              ts[k - 1].raw == "pub" || ts[k - 1].kind == TokenKind::RParen ||
              ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
              let fname = ts[k].raw
              let is_arr_decl = ts[k + 2].raw == "Array" && k + 3 < close && ts[k + 3].kind == TokenKind::LBracket
              let is_pub_field = ts[k - 1].raw == "pub" || (k >= 2 && ts[k - 1].raw == "mut" && ts[k - 2].raw == "pub")
              if is_pub_struct || is_pub_field || !is_arr_decl || array_fields.get(fname) != Some(true) {
                disqualified[fname] = true
              } else {
                cand[fname] = true
              }
            }
            k = k + 1
          }
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  for df in disqualified.keys() {
    cand.remove(df)
  }
  if cand.length() == 0 {
    return cand
  }
  // 2-4. Audit every struct literal init, punning, reassignment, and `.f` usage across the package.
  let seen_init : Map[String, Bool] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      let tk = ts[i]
      if tk.kind == TokenKind::Ident && cand.contains(tk.raw) {
        let bo = outermost_body_open(ts, i)
        if bo >= 0 && !is_type_decl_brace(ts, bo) {
          if i > 0 && ts[i - 1].kind == TokenKind::Dot {
            // Field access `<x>.f`: must NOT be reassigned and must NOT escape!
            let next_i = i + 1
            if next_i < n && (ts[next_i].kind == TokenKind::Eq || ts[next_i].kind == TokenKind::AssignOp) {
              cand.remove(tk.raw)
            } else {
              let safe_dot_method = next_i + 2 < n && ts[next_i].kind == TokenKind::Dot &&
              ts[next_i + 1].kind == TokenKind::Ident && ts[next_i + 2].kind == TokenKind::LParen
              let safe_index = next_i < n && ts[next_i].kind == TokenKind::LBracket
              let safe_for_in = next_i < n && ts[next_i].kind == TokenKind::LBrace &&
              is_loop_body_brace(ts, next_i, bo)
              let mut safe_compat_arg = false
              if next_i < n && (ts[next_i].kind == TokenKind::Comma || ts[next_i].kind == TokenKind::RParen) {
                let lp = enclosing_open(ts, i, bo, TokenKind::LParen)
                if lp >= 3 && ts[lp - 2].kind == TokenKind::ColonColon && ts[lp - 3].raw == "mbt_compat" &&
                ts[lp - 1].raw.starts_with("arr_") {
                  safe_compat_arg = true
                }
              }
              if !(safe_dot_method || safe_index || safe_for_in || safe_compat_arg) {
                cand.remove(tk.raw)
              }
            }
          } else if i + 1 < n && ts[i + 1].kind == TokenKind::Colon {
            // Struct literal field init `f: <rhs>` (skip `let f : Type` and param `f : Type`!)
            let is_let_or_param = (i > 0 && (ts[i - 1].raw == "let" || ts[i - 1].raw == "mut")) ||
            (enclosing_open(ts, i, bo, TokenKind::LParen) > enclosing_open(ts, i, bo, TokenKind::LBrace))
            if !is_let_or_param {
              seen_init[tk.raw] = true
              let rhs_s = i + 2
              let mut rhs_e = rhs_s
              let mut fd = 0
              while rhs_e < n {
                let rk = ts[rhs_e].kind
                if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { fd = fd + 1 }
                else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                  if fd == 0 { break }
                  fd = fd - 1
                } else if fd == 0 && rk == TokenKind::Comma {
                  break
                }
                rhs_e = rhs_e + 1
              }
              if !expr_is_fresh_array_init(ts, rhs_s, rhs_e - 1) {
                cand.remove(tk.raw)
              }
            }
          } else if i > 0 && (ts[i - 1].kind == TokenKind::LBrace || ts[i - 1].kind == TokenKind::Comma) &&
          i + 1 < n && (ts[i + 1].kind == TokenKind::Comma || ts[i + 1].kind == TokenKind::RBrace) {
            // Struct literal punning `{ f }` passes a variable/param -> disqualify!
            let ob = enclosing_open(ts, i, bo, TokenKind::LBrace)
            if ob > bo && ob > 0 && ts[ob - 1].kind == TokenKind::ColonColon {
              cand.remove(tk.raw)
            }
          }
        }
      }
      i = i + 1
    }
  }
  let out : Map[String, Bool] = Map()
  for f in cand.keys() {
    if seen_init.contains(f) {
      out[f] = true
    }
  }
  out
}

///| Collect top-level tail expression spans `(start, end_inclusive)` of block `(blk_open, blk_close)`.
fn collect_block_tail_exprs(ts : Array[Token], blk_open : Int, blk_close : Int, out : Array[(Int, Int)], depth : Int) -> Unit {
  if depth > 6 || blk_open < 0 || blk_close <= blk_open + 1 {
    return
  }
  // Walk top-level statements in `(blk_open + 1, blk_close)` to find the last one.
  let mut cur = blk_open + 1
  let mut last_s = -1
  let mut last_e = -1
  while cur < blk_close {
    while cur < blk_close && ts[cur].kind == TokenKind::Semi {
      cur = cur + 1
    }
    if cur >= blk_close {
      break
    }
    let se = statement_end(ts, cur, blk_close)
    if se <= cur {
      break
    }
    last_s = cur
    last_e = se - 1
    cur = se
  }
  if last_s < 0 || last_e < last_s {
    return
  }
  while last_e >= last_s && ts[last_e].kind == TokenKind::Semi {
    last_e = last_e - 1
  }
  if last_e < last_s {
    return
  }
  let head = ts[last_s].raw
  if head == "return" || head == "let" || head == "for" || head == "while" {
    return
  }
  if ts[last_s].kind == TokenKind::LBrace && find_matching_delim(ts, last_s) == last_e {
    collect_block_tail_exprs(ts, last_s, last_e, out, depth + 1)
    return
  }
  if head == "if" {
    // Collect tail of every `if ... { ... } else if ... { ... } else { ... }` branch.
    let mut k = last_s
    let mut saw_else = false
    while k <= last_e {
      let mut lb = k
      let mut d = 0
      while lb <= last_e {
        let lk = ts[lb].kind
        if d == 0 && lk == TokenKind::LBrace { break }
        if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { d = d + 1 }
        else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { d = d - 1 }
        lb = lb + 1
      }
      if lb > last_e || ts[lb].kind != TokenKind::LBrace {
        break
      }
      let rb = find_matching_delim(ts, lb)
      if rb < 0 || rb > last_e {
        break
      }
      collect_block_tail_exprs(ts, lb, rb, out, depth + 1)
      if rb + 1 <= last_e && ts[rb + 1].raw == "else" {
        if rb + 2 <= last_e && ts[rb + 2].raw == "if" {
          k = rb + 2
        } else if rb + 2 <= last_e && ts[rb + 2].kind == TokenKind::LBrace {
          let erb = find_matching_delim(ts, rb + 2)
          if erb > rb + 2 && erb <= last_e {
            collect_block_tail_exprs(ts, rb + 2, erb, out, depth + 1)
            saw_else = true
          }
          break
        } else {
          break
        }
      } else {
        break
      }
    }
    if !saw_else {
      out.push((last_s, last_e))
    }
    return
  }
  if head == "match" {
    let mut lb = last_s + 1
    let mut d = 0
    while lb <= last_e {
      let lk = ts[lb].kind
      if d == 0 && lk == TokenKind::LBrace { break }
      if lk == TokenKind::LParen || lk == TokenKind::LBracket || lk == TokenKind::LBrace { d = d + 1 }
      else if lk == TokenKind::RParen || lk == TokenKind::RBracket || lk == TokenKind::RBrace { d = d - 1 }
      lb = lb + 1
    }
    if lb <= last_e && ts[lb].kind == TokenKind::LBrace {
      let rb = find_matching_delim(ts, lb)
      if rb > lb && rb <= last_e {
        let mut k = lb + 1
        let mut md = 0
        while k < rb {
          let kk = ts[k].kind
          if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { md = md + 1 }
          else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { md = md - 1 }
          else if md == 0 && ts[k].raw == "=>" && k + 1 < rb {
            let as_ = k + 1
            if ts[as_].kind == TokenKind::LBrace {
              let arb = find_matching_delim(ts, as_)
              if arb > as_ && arb < rb {
                collect_block_tail_exprs(ts, as_, arb, out, depth + 1)
                k = arb + 1
                continue
              }
            }
            let ae = statement_end(ts, as_, rb)
            if ae > as_ {
              let mut ae_i = ae - 1
              while ae_i >= as_ && (ts[ae_i].kind == TokenKind::Comma || ts[ae_i].kind == TokenKind::Semi) {
                ae_i = ae_i - 1
              }
              if ae_i >= as_ {
                if ts[as_].raw == "return" && ae_i > as_ {
                  ()
                } else {
                  out.push((as_, ae_i))
                }
              }
              k = ae
              continue
            }
          }
          k = k + 1
        }
        return
      }
    }
  }
  out.push((last_s, last_e))
}

///| Collect all return expressions (explicit `return <expr>` at closure depth 0 + block tail expressions).
fn collect_fn_return_spans(ts : Array[Token], body_open : Int, body_close : Int) -> Array[(Int, Int)] {
  let out : Array[(Int, Int)] = []
  let mut k = body_open + 1
  while k < body_close {
    if ts[k].raw == "return" && enclosing_closure_open(ts, k, body_open) < 0 {
      let se = statement_end(ts, k + 1, body_close)
      let mut re = se - 1
      while re > k && (ts[re].kind == TokenKind::Semi || ts[re].kind == TokenKind::Comma) {
        re = re - 1
      }
      if re >= k + 1 {
        out.push((k + 1, re))
      }
    }
    k = k + 1
  }
  collect_block_tail_exprs(ts, body_open, body_close, out, 0)
  out
}

///| Check whether identifier `nm` used inside `(body_open, body_close)` never escapes into any field, global,
///| return value (other than the explicit `allowed_ret_pos` set), dep call, or opaque closure.
fn local_or_param_never_escapes(
  ts : Array[Token],
  nm : String,
  body_open : Int,
  body_close : Int,
  allowed_ret_pos : Map[Int, Bool],
  by_name : Map[String, Array[String]],
  dep_methods : Map[String, Bool],
  param_safe : Map[String, Map[Int, Bool]],
  decl_is_known : Map[String, Bool],
) -> Bool {
  let mut i = body_open + 1
  while i < body_close {
    let tk = ts[i]
    if tk.kind == TokenKind::Ident && tk.raw == nm &&
    !(i > body_open && (ts[i - 1].kind == TokenKind::Dot || ts[i - 1].kind == TokenKind::ColonColon)) {
      // Skip its own `let [mut] nm ... =` binding site or param declaration
      if i > body_open && (ts[i - 1].raw == "let" || (i > body_open + 1 && ts[i - 1].raw == "mut" && ts[i - 2].raw == "let")) {
        i = i + 1
        continue
      }
      if allowed_ret_pos.contains(i) {
        i = i + 1
        continue
      }
      // Safe 1: built-in Array method call `nm.<m>(...)` (caller only invokes this on proven `Array` locals/params)
      if i + 3 < body_close && ts[i + 1].kind == TokenKind::Dot && ts[i + 2].kind == TokenKind::Ident &&
      ts[i + 3].kind == TokenKind::LParen {
        let m = ts[i + 2].raw
        if is_builtin_first_order_method(m) {
          i = i + 1
          continue
        }
        // Or same-package method `nm.m(...)` where param 0 (self) never escapes
        if !dep_methods.contains(m) {
          match by_name.get(m) {
            Some(keys) =>
            if keys.length() > 0 {
              let mut all_ok = true
              for dk in keys {
                match param_safe.get(dk) {
                  Some(ps) => if ps.get(0) != Some(true) { all_ok = false }
                  None => all_ok = false
                }
              }
              if all_ok {
                i = i + 1
                continue
              }
            }
            None => ()
          }
        }
        return false
      }
      // Safe 2: index read/write `nm[...]`
      if i + 1 < body_close && ts[i + 1].kind == TokenKind::LBracket {
        i = i + 1
        continue
      }
      // Safe 3: `for _ in nm {`
      if i + 1 < body_close && ts[i + 1].kind == TokenKind::LBrace && is_loop_body_brace(ts, i + 1, body_open) {
        i = i + 1
        continue
      }
      // Safe 4: direct argument to `mbt_compat::arr_*` OR to a same-package fn/method whose param index is in `param_safe`!
      if i + 1 < body_close && (ts[i + 1].kind == TokenKind::Comma || ts[i + 1].kind == TokenKind::RParen) &&
      (i > body_open && (ts[i - 1].kind == TokenKind::LParen || ts[i - 1].kind == TokenKind::Comma)) {
        let lp = enclosing_open(ts, i, body_open, TokenKind::LParen)
        if lp > body_open {
          // Compute 0-based argument ordinal inside `lp`
          let mut arg_ord = 0
          let mut ai = lp + 1
          let mut ad = 0
          while ai < i {
            let ak = ts[ai].kind
            if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
            else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
            else if ad == 0 && ak == TokenKind::Comma { arg_ord = arg_ord + 1 }
            ai = ai + 1
          }
          if lp >= 3 && ts[lp - 2].kind == TokenKind::ColonColon && ts[lp - 3].raw == "mbt_compat" &&
          ts[lp - 1].raw.starts_with("arr_") {
            i = i + 1
            continue
          }
          if lp >= 2 && ts[lp - 2].kind == TokenKind::Dot && ts[lp - 1].kind == TokenKind::Ident {
            let m = ts[lp - 1].raw
            if !dep_methods.contains(m) {
              match by_name.get(m) {
                Some(keys) =>
                if keys.length() > 0 {
                  let mut all_ok = true
                  for dk in keys {
                    match param_safe.get(dk) {
                      Some(ps) => if ps.get(arg_ord + 1) != Some(true) { all_ok = false }
                      None => all_ok = false
                    }
                  }
                  if all_ok {
                    i = i + 1
                    continue
                  }
                }
                None => ()
              }
            }
          } else if lp >= 3 && ts[lp - 2].kind == TokenKind::ColonColon && ts[lp - 1].kind == TokenKind::Ident &&
          !(lp >= 4 && ts[lp - 4].kind == TokenKind::ColonColon) {
            let dk = ts[lp - 3].raw + "::" + ts[lp - 1].raw
            if decl_is_known.contains(dk) {
              match param_safe.get(dk) {
                Some(ps) => if ps.get(arg_ord) == Some(true) { i = i + 1; continue }
                None => ()
              }
            }
          } else if lp >= 1 && ts[lp - 1].kind == TokenKind::Ident &&
          !(lp >= 2 && (ts[lp - 2].kind == TokenKind::Dot || ts[lp - 2].kind == TokenKind::ColonColon)) {
            let dk = "::" + ts[lp - 1].raw
            if decl_is_known.contains(dk) {
              match param_safe.get(dk) {
                Some(ps) => if ps.get(arg_ord) == Some(true) { i = i + 1; continue }
                None => ()
              }
            }
          }
        }
      }
      return false
    }
    i = i + 1
  }
  true
}

///| Extract root identifier of the first argument inside `lp+1 .. rp`.
fn first_arg_root(tokens : Array[Token], as_ : Int, ae_ : Int) -> String {
  if as_ >= ae_ {
    return ""
  }
  let mut a0_end = as_
  let mut ad = 0
  while a0_end < ae_ {
    let ak = tokens[a0_end].kind
    if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
    else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
    else if ad == 0 && ak == TokenKind::Comma { break }
    a0_end = a0_end + 1
  }
  let mut s = as_
  let mut e = a0_end - 1
  while s < e && tokens[s].kind == TokenKind::LParen && find_matching_delim(tokens, s) == e {
    s = s + 1
    e = e - 1
  }
  if e >= s { receiver_root(tokens, e) } else { "" }
}

///| Build declaration-bound `CapPkgSummary` from pre-lexed package tokens (zero re-lexing).
pub fn collect_cap_pkg_summary(
  all_tokens : Array[Array[Token]],
  dep_methods : Map[String, Bool],
) -> CapPkgSummary {
  let sort_env = sort_key_env_of_with_deps(all_tokens, dep_methods)
  let has_custom_eq = sort_env.methods.contains(" eq")
  let local_sort_env = sort_key_env_of_with_deps(all_tokens, Map())
  let local_has_custom_eq = local_sort_env.methods.contains(" eq")
  let array_fields = collect_array_fields_from_tokens(all_tokens)
  let pkg_globals : Map[String, Bool] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut gi = 0
    let mut gd = 0
    while gi < n {
      let gtk = ts[gi]
      if gtk.kind == TokenKind::LBrace { gd = gd + 1 }
      else if gtk.kind == TokenKind::RBrace { if gd > 0 { gd = gd - 1 } }
      else if gd == 0 && gtk.raw == "let" {
        let mut ni = gi + 1
        if ni < n && ts[ni].raw == "mut" { ni = ni + 1 }
        if ni < n && ts[ni].kind == TokenKind::Ident {
          pkg_globals[ts[ni].raw] = true
        }
      }
      gi = gi + 1
    }
  }
  let effects : Map[String, CapFnEffect] = Map()
  let by_name : Map[String, Array[String]] = Map()
  let call_edges : Map[String, Array[String]] = Map()
  let decl_tokens_map : Map[String, Array[Token]] = Map()
  let decl_open_map : Map[String, Int] = Map()
  let decl_close_map : Map[String, Int] = Map()
  let decl_params_map : Map[String, Array[(Int, String)]] = Map()
  let decl_is_known : Map[String, Bool] = Map()

  let register_decl = fn(
    decl_key : String,
    bare_name : String,
    is_pub : Bool,
    ts : Array[Token],
    body_open : Int,
    body_close : Int,
  ) {
    let ef = CapFnEffect::{
      decl_key: decl_key,
      is_pub: is_pub,
      may_shrink_or_shift: false,
      may_grow: false,
      may_write: false,
      may_shrink_to_fit: false,
      may_call_unknown: false,
      may_call_opaque: false,
      may_pass_param_to_dep: false,
      dep_escaped_params: Map(),
      mutated_globals: Map(),
      mutated_fields: Map(),
      grew_fields: Map(),
      wrote_fields: Map(),
    }
    let edges : Array[String] = []
    // Collect positional parameter index for each parameter name of this declaration
    // (to detect `fn w(b : Box) { dep::mutate(b) }` per-parameter without false positives on sibling params).
    let fn_param_idx : Map[String, Int] = Map()
    let fn_arr_params : Map[String, Int] = Map()
    let fs_decl = fn_start_of(ts, body_open)
    if fs_decl >= 0 {
      let mut pk = fs_decl + 1
      let mut paren_d = 0
      let mut brack_d = 0
      let mut p_ord = 0
      while pk + 1 < body_open {
        let pkk = ts[pk].kind
        if pkk == TokenKind::LParen { paren_d = paren_d + 1 }
        else if pkk == TokenKind::RParen { paren_d = paren_d - 1 }
        else if pkk == TokenKind::LBracket { brack_d = brack_d + 1 }
        else if pkk == TokenKind::RBracket { brack_d = brack_d - 1 }
        else if paren_d == 1 && brack_d == 0 && (pkk == TokenKind::Ident || ts[pk].raw == "self") && ts[pk + 1].kind == TokenKind::Colon {
          fn_param_idx[ts[pk].raw] = p_ord
          if pk + 2 < body_open && ts[pk + 2].raw == "Array" {
            fn_arr_params[ts[pk].raw] = p_ord
          }
          p_ord = p_ord + 1
        }
        pk = pk + 1
      }
    }
    let collect_passed_param_indices = fn(as_ : Int, ae_ : Int) -> Array[Int] {
      let out : Array[Int] = []
      let mut j = as_
      while j < ae_ {
        if (ts[j].kind == TokenKind::Ident || ts[j].raw == "self") &&
        !(j > 0 && (ts[j - 1].kind == TokenKind::Dot || ts[j - 1].kind == TokenKind::ColonColon)) &&
        !(j + 1 < ae_ && ts[j + 1].kind == TokenKind::Dot) {
          match fn_param_idx.get(ts[j].raw) {
            Some(idx) => out.push(idx)
            None => ()
          }
        }
        j = j + 1
      }
      out
    }
    let local_fresh = fresh_locals_before(ts, body_open, body_close)
    let mut k = body_open + 1
    while k < body_close {
      let tk = ts[k]
      if tk.kind == TokenKind::InterpString || tk.kind == TokenKind::InterpMultiline || tk.kind == TokenKind::PipeGt {
        ef.may_call_unknown = true
        ef.may_call_opaque = true
      } else if (tk.kind == TokenKind::EqEq || tk.raw == "!=") && has_custom_eq {
        let lhs_lit = k > body_open + 1 && (ts[k - 1].kind == TokenKind::IntLit || ts[k - 1].kind == TokenKind::FloatLit ||
          ts[k - 1].kind == TokenKind::StringLit || ts[k - 1].kind == TokenKind::CharLit ||
          ts[k - 1].raw == "true" || ts[k - 1].raw == "false")
        let rhs_lit = k + 1 < body_close && (ts[k + 1].kind == TokenKind::IntLit || ts[k + 1].kind == TokenKind::FloatLit ||
          ts[k + 1].kind == TokenKind::StringLit || ts[k + 1].kind == TokenKind::CharLit ||
          ts[k + 1].raw == "true" || ts[k + 1].raw == "false")
        let lhs_bi = lhs_lit || (k > body_open + 1 && receiver_is_builtin(ts, k - 1, body_open, k, sort_env))
        let rhs_bi = rhs_lit || (k + 1 < body_close && receiver_is_builtin(ts, k + 1, body_open, k, sort_env))
        if !(lhs_bi || rhs_bi) {
          edges.push("EQ")
        }
      } else if tk.kind == TokenKind::Dot && k + 2 < body_close && ts[k + 1].kind == TokenKind::Ident &&
      ts[k + 2].kind == TokenKind::LParen {
        let m = ts[k + 1].raw
        let (recv_is_field, recv_r, recv_tail) = indexed_field_tail(ts, k - 1, body_open)
        let is_own_fresh = !recv_is_field && recv_r.length() > 0 && local_fresh.contains(recv_r)
        let is_arr_op = is_cap_arr_shrink_or_shift_method(m) || is_cap_arr_growth_method(m) ||
        is_cap_arr_write_method(m) || m == "shrink_to_fit"
        if is_cap_arr_shrink_or_shift_method(m) {
          if !is_own_fresh {
            ef.may_shrink_or_shift = true
            if recv_is_field && recv_tail.length() > 0 { ef.mutated_fields[recv_tail] = true }
            else if !recv_is_field && pkg_globals.contains(recv_r) { ef.mutated_globals[recv_r] = true }
          }
        } else if is_cap_arr_growth_method(m) {
          if !is_own_fresh {
            ef.may_grow = true
            if recv_is_field && recv_tail.length() > 0 { ef.grew_fields[recv_tail] = true }
          }
        } else if is_cap_arr_write_method(m) {
          if !is_own_fresh {
            ef.may_write = true
            if recv_is_field && recv_tail.length() > 0 { ef.wrote_fields[recv_tail] = true }
          }
        } else if m == "shrink_to_fit" {
          if !is_own_fresh {
            ef.may_shrink_to_fit = true
            if recv_is_field && recv_tail.length() > 0 { ef.mutated_fields[recv_tail] = true }
            else if !recv_is_field && pkg_globals.contains(recv_r) { ef.mutated_globals[recv_r] = true }
          }
        } else if is_higher_order_arr_method(m) {
          ef.may_call_unknown = true
        } else if is_builtin_first_order_method(m) && (is_own_fresh || receiver_is_builtin(ts, k - 1, body_open, k, sort_env)) {
          ()
        } else if !is_pure_key_method(m) || sort_env.methods.contains(m) {
          edges.push("M:" + m)
        }
        // If a user/dep defines a same-name method (e.g. `Hook::push`), also propagate its effects
        // whenever the receiver is not proven to be a built-in/fresh `Array`!
        if is_arr_op && !is_own_fresh && sort_env.methods.contains(m) &&
        !receiver_is_builtin(ts, k - 1, body_open, k, sort_env) {
          edges.push("M:" + m)
        }
      } else if tk.kind == TokenKind::RBracket && k + 1 < body_close &&
      (ts[k + 1].kind == TokenKind::Eq || ts[k + 1].kind == TokenKind::AssignOp) {
        let lb = find_open_before(ts, k, body_open)
        let (wr_is_field, wr_r, wr_tail) = if lb > body_open { indexed_field_tail(ts, lb - 1, body_open) } else { (false, "", "") }
        let is_own_fresh = !wr_is_field && wr_r.length() > 0 && local_fresh.contains(wr_r)
        if !is_own_fresh {
          ef.may_write = true
          if wr_is_field && wr_tail.length() > 0 { ef.wrote_fields[wr_tail] = true }
        }
      } else if (tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket) &&
      k + 1 < body_close && ts[k + 1].kind == TokenKind::LParen && !ts[k + 1].newline_before {
        ef.may_call_unknown = true
        ef.may_call_opaque = true
      } else if tk.kind == TokenKind::Ident && k + 1 < body_close && ts[k + 1].kind == TokenKind::LParen &&
      !ts[k + 1].newline_before && !is_call_keyword(tk.raw) && !(k > 0 && ts[k - 1].raw == "fn") {
        if k >= 2 && ts[k - 1].kind == TokenKind::ColonColon {
          let q = ts[k - 2].raw
          if q == "mbt_compat" {
            let cp = find_matching_delim(ts, k + 1)
            let mut a0_end = k + 2
            let mut ad = 0
            while a0_end + 1 < cp {
              let ak = ts[a0_end].kind
              if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
              else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
              if ad == 0 && (ts[a0_end + 1].kind == TokenKind::Comma || ts[a0_end + 1].kind == TokenKind::RParen) {
                break
              }
              a0_end = a0_end + 1
            }
            let (a0_is_field, a0_r, a0_tail) = if k + 2 < cp { indexed_field_tail(ts, a0_end, k + 2) } else { (false, "", "") }
            let a0_fresh = !a0_is_field && a0_r.length() > 0 && local_fresh.contains(a0_r) &&
            (k + 3 >= cp || ts[k + 3].kind == TokenKind::Comma || ts[k + 3].kind == TokenKind::RParen)
            if is_cap_compat_shrink_or_shift_fn(tk.raw) {
              if !a0_fresh {
                ef.may_shrink_or_shift = true
                if a0_is_field && a0_tail.length() > 0 { ef.mutated_fields[a0_tail] = true }
                else if !a0_is_field && pkg_globals.contains(a0_r) { ef.mutated_globals[a0_r] = true }
              }
            } else if is_cap_compat_growth_fn(tk.raw) {
              if !a0_fresh {
                ef.may_grow = true
                if a0_is_field && a0_tail.length() > 0 { ef.grew_fields[a0_tail] = true }
              }
            } else if is_cap_compat_write_fn(tk.raw) {
              if !a0_fresh {
                ef.may_write = true
                if a0_is_field && a0_tail.length() > 0 { ef.wrote_fields[a0_tail] = true }
              }
            } else if tk.raw == "arr_shrink_to_fit" {
              if !a0_fresh {
                ef.may_shrink_to_fit = true
                if a0_is_field && a0_tail.length() > 0 { ef.mutated_fields[a0_tail] = true }
                else if !a0_is_field && pkg_globals.contains(a0_r) { ef.mutated_globals[a0_r] = true }
              }
            } else if !is_pure_key_compat_helper(tk.raw) && !is_pure_first_order_mbt_compat_fn(tk.raw) {
              ef.may_call_unknown = true
            }
          } else if is_ctor_name(tk.raw) || is_builtin_type_qualifier(q) {
            ()
          } else if k >= 3 && ts[k - 3].kind == TokenKind::ColonColon {
            // 3-segment cross-package call `dep::Type::method(...)`: opaque (never collide with local `Type::method`)
            ef.may_call_unknown = true
            ef.may_call_opaque = true
            let cp_q = find_matching_delim(ts, k + 1)
            if cp_q > k + 1 {
              for pidx in collect_passed_param_indices(k + 2, cp_q) {
                ef.may_pass_param_to_dep = true
                ef.dep_escaped_params[pidx] = true
              }
            }
          } else {
            let cp_q = find_matching_delim(ts, k + 1)
            let pidxs = if cp_q > k + 1 { collect_passed_param_indices(k + 2, cp_q) } else { [] }
            if pidxs.length() > 0 {
              for pidx in pidxs {
                edges.push("QP:" + pidx.to_string() + ":" + q + "::" + tk.raw)
              }
            } else {
              edges.push("Q:" + q + "::" + tk.raw)
            }
          }
        } else if !(k > 0 && ts[k - 1].kind == TokenKind::Dot) && !is_ctor_name(tk.raw) &&
        !is_pure_builtin_free_fn(tk.raw) {
          // Local closure literals are already inside `body_open..body_close` and scanned directly by this loop.
          if local_closure_body(ts, k, tk.raw) < 0 {
            edges.push("F:" + tk.raw)
          }
        }
      }
      k = k + 1
    }
    effects[decl_key] = ef
    let prev_list = match by_name.get(bare_name) {
      Some(l) => l
      None => []
    }
    prev_list.push(decl_key)
    by_name[bare_name] = prev_list
    call_edges[decl_key] = edges
    decl_tokens_map[decl_key] = ts
    decl_open_map[decl_key] = body_open
    decl_close_map[decl_key] = body_close
    let plist : Array[(Int, String)] = []
    for pnm in fn_arr_params.keys() {
      match fn_arr_params.get(pnm) {
        Some(pi) => plist.push((pi, pnm))
        None => ()
      }
    }
    decl_params_map[decl_key] = plist
    decl_is_known[decl_key] = true
  }

  // Pass 1: Scan every top-level `fn`, `fn T::m`, and `impl Trait for T { fn m }` declaration.
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    let mut d = 0
    while i < n {
      let tk = ts[i]
      if tk.kind == TokenKind::LBrace {
        d = d + 1
      } else if tk.kind == TokenKind::RBrace {
        if d > 0 { d = d - 1 }
      } else if d == 0 && tk.raw == "fn" && i + 1 < n && ts[i + 1].kind != TokenKind::LParen {
        let is_pub = i > 0 && ts[i - 1].raw == "pub"
        let mut ni = i + 1
        if ni < n && ts[ni].kind == TokenKind::LBracket {
          ni = find_matching_delim(ts, ni) + 1
        }
        let mut decl_key = ""
        let mut bare_name = ""
        let mut pi = ni + 1
        if ni + 2 < n && ts[ni].kind == TokenKind::UpperIdent && ts[ni + 1].kind == TokenKind::ColonColon &&
        ts[ni + 2].kind == TokenKind::Ident {
          decl_key = ts[ni].raw + "::" + ts[ni + 2].raw
          bare_name = ts[ni + 2].raw
          pi = ni + 3
        } else if ni < n && ts[ni].kind == TokenKind::Ident {
          decl_key = "::" + ts[ni].raw
          bare_name = ts[ni].raw
          pi = ni + 1
        }
        if decl_key.length() > 0 {
          let mut lb = pi
          let mut pd = 0
          while lb < n {
            let lk = ts[lb].kind
            if lk == TokenKind::LParen || lk == TokenKind::LBracket { pd = pd + 1 }
            else if lk == TokenKind::RParen || lk == TokenKind::RBracket { pd = pd - 1 }
            else if pd == 0 && lk == TokenKind::LBrace { break }
            lb = lb + 1
          }
          if lb < n && ts[lb].kind == TokenKind::LBrace {
            let rb = find_matching_delim(ts, lb)
            if rb > lb {
              register_decl(decl_key, bare_name, is_pub, ts, lb, rb)
              i = rb + 1
              continue
            }
          }
        }
      } else if d == 0 && tk.raw == "impl" {
        let mut ti = i + 1
        if ti < n && ts[ti].kind == TokenKind::LBracket {
          ti = find_matching_delim(ts, ti) + 1
        }
        let mut ty_name = ""
        while ti < n && ts[ti].kind != TokenKind::LBrace {
          if ts[ti].kind == TokenKind::UpperIdent {
            ty_name = ts[ti].raw
          }
          ti = ti + 1
        }
        if ty_name.length() > 0 && ti < n && ts[ti].kind == TokenKind::LBrace {
          let impl_rb = find_matching_delim(ts, ti)
          let mut mi = ti + 1
          let mut md = 0
          while mi < impl_rb {
            let mtk = ts[mi]
            if mtk.kind == TokenKind::LBrace { md = md + 1 }
            else if mtk.kind == TokenKind::RBrace { if md > 0 { md = md - 1 } }
            else if md == 0 && mtk.raw == "fn" && mi + 1 < impl_rb {
              let mut mni = mi + 1
              if mni < impl_rb && ts[mni].kind == TokenKind::LBracket {
                mni = find_matching_delim(ts, mni) + 1
              }
              if mni < impl_rb && ts[mni].kind == TokenKind::Ident {
                let mname = ts[mni].raw
                let mut mlb = mni + 1
                let mut mpd = 0
                while mlb < impl_rb {
                  let mlk = ts[mlb].kind
                  if mlk == TokenKind::LParen || mlk == TokenKind::LBracket { mpd = mpd + 1 }
                  else if mlk == TokenKind::RParen || mlk == TokenKind::RBracket { mpd = mpd - 1 }
                  else if mpd == 0 && mlk == TokenKind::LBrace { break }
                  mlb = mlb + 1
                }
                if mlb < impl_rb && ts[mlb].kind == TokenKind::LBrace {
                  let mrb = find_matching_delim(ts, mlb)
                  if mrb > mlb {
                    register_decl(ty_name + "::" + mname, mname, true, ts, mlb, mrb)
                    mi = mrb + 1
                    continue
                  }
                }
              }
            }
            mi = mi + 1
          }
          i = impl_rb + 1
          continue
        }
      }
      i = i + 1
    }
  }

  // Pass 2: Monotone conservative fixpoint over call edges (handles mutual recursion cleanly).
  let merge_effect = fn(ef : CapFnEffect, cef : CapFnEffect) -> Bool {
    let mut ch = false
    if cef.may_shrink_or_shift && !ef.may_shrink_or_shift { ef.may_shrink_or_shift = true; ch = true }
    if cef.may_grow && !ef.may_grow { ef.may_grow = true; ch = true }
    if cef.may_write && !ef.may_write { ef.may_write = true; ch = true }
    if cef.may_shrink_to_fit && !ef.may_shrink_to_fit { ef.may_shrink_to_fit = true; ch = true }
    if cef.may_call_unknown && !ef.may_call_unknown { ef.may_call_unknown = true; ch = true }
    if cef.may_call_opaque && !ef.may_call_opaque { ef.may_call_opaque = true; ch = true }
    if cef.may_pass_param_to_dep && !ef.may_pass_param_to_dep { ef.may_pass_param_to_dep = true; ch = true }
    for g in cef.mutated_globals.keys() {
      if !ef.mutated_globals.contains(g) { ef.mutated_globals[g] = true; ch = true }
    }
    for f in cef.mutated_fields.keys() {
      if !ef.mutated_fields.contains(f) { ef.mutated_fields[f] = true; ch = true }
    }
    for f in cef.grew_fields.keys() {
      if !ef.grew_fields.contains(f) { ef.grew_fields[f] = true; ch = true }
    }
    for f in cef.wrote_fields.keys() {
      if !ef.wrote_fields.contains(f) { ef.wrote_fields[f] = true; ch = true }
    }
    ch
  }
  let mut changed = true
  while changed {
    changed = false
    for dk in effects.keys() {
      match effects.get(dk) {
        Some(ef) => {
          let edges = match call_edges.get(dk) {
            Some(es) => es
            None => []
          }
          for edge in edges {
            if edge.starts_with("F:") {
              let fnm = edge.slice(2, edge.length())
              match effects.get("::" + fnm) {
                Some(cef) => if merge_effect(ef, cef) { changed = true }
                None =>
                if !ef.may_call_unknown {
                  ef.may_call_unknown = true
                  ef.may_call_opaque = true
                  changed = true
                }
              }
            } else if edge.starts_with("QP:") {
              let rest = edge.slice(3, edge.length())
              let sep = rest.index_of(":")
              let pidx_s = if sep > 0 { rest.slice(0, sep) } else { "0" }
              let qk = if sep > 0 { rest.slice(sep + 1, rest.length()) } else { rest }
              let mut pidx = 0
              let mut pi = 0
              while pi < pidx_s.length() {
                let c = pidx_s.code_unit_at(pi)
                if c >= 48 && c <= 57 { pidx = pidx * 10 + (c - 48) }
                pi = pi + 1
              }
              match effects.get(qk) {
                Some(cef) => if merge_effect(ef, cef) { changed = true }
                None => {
                  if !ef.may_call_unknown { ef.may_call_unknown = true; changed = true }
                  if !ef.may_pass_param_to_dep { ef.may_pass_param_to_dep = true; changed = true }
                  if !ef.dep_escaped_params.contains(pidx) { ef.dep_escaped_params[pidx] = true; changed = true }
                }
              }
            } else if edge.starts_with("Q:") {
              let qk = edge.slice(2, edge.length())
              match effects.get(qk) {
                Some(cef) => if merge_effect(ef, cef) { changed = true }
                None =>
                if !ef.may_call_unknown { ef.may_call_unknown = true; changed = true }
              }
            } else if edge == "EQ" {
              if dep_methods.contains("op_equal") || dep_methods.contains("eq") || dep_methods.contains("equal") {
                if !ef.may_call_unknown { ef.may_call_unknown = true; changed = true }
              } else {
                let mut found_eq = false
                for eq_nm in ["op_equal", "eq", "equal"] {
                  match by_name.get(eq_nm) {
                    Some(eq_keys) =>
                    if eq_keys.length() > 0 {
                      found_eq = true
                      for tdk in eq_keys {
                        match effects.get(tdk) {
                          Some(cef) => if merge_effect(ef, cef) { changed = true }
                          None => ()
                        }
                      }
                    }
                    None => ()
                  }
                }
                if !found_eq && !ef.may_call_unknown {
                  ef.may_call_unknown = true
                  changed = true
                }
              }
            } else if edge.starts_with("M:") {
              let mn = edge.slice(2, edge.length())
              let targets = match by_name.get(mn) {
                Some(l) => l
                None => []
              }
              if targets.length() > 0 {
                for tdk in targets {
                  match effects.get(tdk) {
                    Some(cef) => if merge_effect(ef, cef) { changed = true }
                    None => ()
                  }
                }
              } else {
                if !ef.may_call_unknown { ef.may_call_unknown = true; changed = true }
                if !is_builtin_first_order_method(mn) && !ef.may_call_opaque {
                  ef.may_call_opaque = true
                  changed = true
                }
              }
              if dep_methods.contains(mn) && !ef.may_call_unknown {
                ef.may_call_unknown = true
                changed = true
              }
            }
          }
        }
        None => ()
      }
    }
  }

  // Pass 3: Private struct closure fields `(e.f)()`, keyed by `"StructName.field"`:
  // Safe ONLY if struct is non-pub (or field `priv`) AND every construction/assignment in the package assigns
  // a closure literal whose body has no mutations/unknown calls.
  let safe_closure_fields : Map[String, Bool] = Map()
  let safe_field_to_keys : Map[String, Array[String]] = Map()
  let pub_closure_fields : Map[String, Bool] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i < n {
      if ts[i].raw == "struct" && i + 1 < n && is_type_ident_tok(ts[i + 1].kind) {
        let sname = ts[i + 1].raw
        let is_pub_struct = i > 0 && (ts[i - 1].raw == "pub" || ts[i - 1].kind == TokenKind::RParen)
        let mut o = i + 2
        while o < n && ts[o].kind != TokenKind::LBrace && ts[o].kind != TokenKind::LParen && ts[o].kind != TokenKind::Eof {
          o = o + 1
        }
        if o < n && ts[o].kind == TokenKind::LBrace {
          let close = find_matching_delim(ts, o)
          let mut k = o + 1
          let mut fd = 0
          while k > 0 && k + 2 < close {
            let kk = ts[k].kind
            if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace { fd = fd + 1 }
            else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace { fd = fd - 1 }
            else if fd == 0 && kk == TokenKind::Ident && ts[k + 1].kind == TokenKind::Colon &&
            (k == o + 1 || ts[k].newline_before || ts[k - 1].raw == "mut" || ts[k - 1].raw == "priv" ||
              ts[k - 1].raw == "pub" || ts[k - 1].kind == TokenKind::RParen ||
              ts[k - 1].kind == TokenKind::Comma || ts[k - 1].kind == TokenKind::Semi) {
              // Check if field type contains `->` (function/closure type)
              let mut q = k + 2
              let mut is_fn_ty = false
              let mut td = 0
              while q < close {
                let qk = ts[q].kind
                if td == 0 && (ts[q].newline_before || qk == TokenKind::Comma || qk == TokenKind::Semi) { break }
                if qk == TokenKind::LParen || qk == TokenKind::LBracket { td = td + 1 }
                else if qk == TokenKind::RParen || qk == TokenKind::RBracket { td = td - 1 }
                else if ts[q].raw == "->" { is_fn_ty = true }
                q = q + 1
              }
              if is_fn_ty {
                let fname = ts[k].raw
                let skey = sname + "." + fname
                let is_priv_field = ts[k - 1].raw == "priv" || (k >= 2 && ts[k - 1].raw == "mut" && ts[k - 2].raw == "priv")
                if is_pub_struct && !is_priv_field {
                  pub_closure_fields[fname] = true
                } else {
                  safe_closure_fields[skey] = true
                  let arr = match safe_field_to_keys.get(fname) { Some(a) => a, None => [] }
                  arr.push(skey)
                  safe_field_to_keys[fname] = arr
                }
              }
            }
            k = k + 1
          }
          i = if close > i { close } else { i + 1 }
          continue
        }
      }
      i = i + 1
    }
  }
  let drop_closure_field = fn(fname : String) -> Unit {
    match safe_field_to_keys.get(fname) {
      Some(keys) => {
        for sk in keys {
          safe_closure_fields.remove(sk)
        }
      }
      None => ()
    }
  }
  for pf in pub_closure_fields.keys() {
    drop_closure_field(pf)
  }
  if safe_closure_fields.length() > 0 {
    // Audit every struct literal field init `f: <rhs>`, punning `{ f }`, and assignment `.f = <rhs>` in the package.
    let seen_init : Map[String, Bool] = Map()
    for ts in all_tokens {
      let n = ts.length()
      let mut i = 0
      while i < n {
        let tk = ts[i]
        if tk.kind == TokenKind::Ident && safe_field_to_keys.contains(tk.raw) {
          let bo = outermost_body_open(ts, i)
          if bo >= 0 && !is_type_decl_brace(ts, bo) {
            if i + 1 < n && ts[i + 1].kind == TokenKind::Colon {
              seen_init[tk.raw] = true
              let rhs_s = i + 2
              let mut rhs_e = rhs_s
              let mut fd = 0
              while rhs_e < n {
                let rk = ts[rhs_e].kind
                if rk == TokenKind::LParen || rk == TokenKind::LBracket || rk == TokenKind::LBrace { fd = fd + 1 }
                else if rk == TokenKind::RParen || rk == TokenKind::RBracket || rk == TokenKind::RBrace {
                  if fd == 0 { break }
                  fd = fd - 1
                } else if fd == 0 && rk == TokenKind::Comma {
                  break
                }
                rhs_e = rhs_e + 1
              }
              if !(rhs_s + 1 < rhs_e && ts[rhs_s].raw == "fn" && ts[rhs_s + 1].kind == TokenKind::LParen) {
                drop_closure_field(tk.raw)
              } else {
                let cp = find_matching_delim(ts, rhs_s + 1)
                let mut lb = cp + 1
                while lb < rhs_e && ts[lb].kind != TokenKind::LBrace { lb = lb + 1 }
                if lb >= rhs_e || ts[lb].kind != TokenKind::LBrace {
                  drop_closure_field(tk.raw)
                } else {
                  let rb = find_matching_delim(ts, lb)
                  let dummy_flags = [false, false]
                  let cs = callable_locals(ts, bo)
                  if closure_body_opacity(ts, lb, rb, cs).length() > 0 ||
                  kept_iter_mutations(ts, Map(), true, lb + 1, rb, bo, "", cs, sort_env.methods, dummy_flags).length() > 0 ||
                  dummy_flags[0] || dummy_flags[1] {
                    drop_closure_field(tk.raw)
                  }
                }
              }
            } else if i > 0 && ts[i - 1].kind == TokenKind::Dot && i + 1 < n && ts[i + 1].kind == TokenKind::Eq {
              // Assignment `.f = rhs`
              drop_closure_field(tk.raw)
            } else if i > 0 && (ts[i - 1].kind == TokenKind::LBrace || ts[i - 1].kind == TokenKind::Comma) &&
            i + 1 < n && (ts[i + 1].kind == TokenKind::Comma || ts[i + 1].kind == TokenKind::RBrace) {
              // Punning `{ f }` passes a variable/parameter
              drop_closure_field(tk.raw)
            }
          }
        }
        i = i + 1
      }
    }
    for f in safe_field_to_keys.keys() {
      if !seen_init.contains(f) {
        drop_closure_field(f)
      }
    }
  }

  // Collect unambiguous local free-function return types (`fn f(..) -> T` / `-> Array[T]`)
  let fn_return_types : Map[String, String] = Map()
  for ts in all_tokens {
    let n = ts.length()
    let mut i = 0
    while i + 4 < n {
      if ts[i].raw == "fn" && ts[i + 1].kind == TokenKind::Ident && ts[i + 2].kind == TokenKind::LParen {
        let fname = ts[i + 1].raw
        let cp = find_matching_delim(ts, i + 2)
        if cp > i + 2 && cp + 2 < n && ts[cp + 1].raw == "->" {
          let rs = cp + 2
          let rty = if ts[rs].raw == "Array" && rs + 3 < n && ts[rs + 1].kind == TokenKind::LBracket &&
          is_type_ident_tok(ts[rs + 2].kind) && ts[rs + 3].kind == TokenKind::RBracket &&
          !(rs + 4 < n && ts[rs + 4].raw == "?") {
            "Array:" + ts[rs + 2].raw
          } else if is_type_ident_tok(ts[rs].kind) &&
          !(rs + 1 < n && (ts[rs + 1].kind == TokenKind::LBracket || ts[rs + 1].kind == TokenKind::ColonColon || ts[rs + 1].raw == "?")) {
            ts[rs].raw
          } else {
            ""
          }
          match fn_return_types.get(fname) {
            Some(prev) => if prev != rty { fn_return_types[fname] = "" }
            None => fn_return_types[fname] = rty
          }
        }
      }
      i = i + 1
    }
  }

  let (field_types, field_all_builtin, array_elem_types, array_elem_all_builtin, array_elem_type_sets, array_elem_unknown, nested_array_elem_types) = collect_struct_field_types_from_tokens(all_tokens)
  let distinct_array_fields = collect_distinct_array_fields(all_tokens, array_fields)
  // Pass 4: Non-escaping parameter fixpoint + package function return provenance (`fn_ret_fresh_array` / `fn_ret_field`).
  let param_safe : Map[String, Map[Int, Bool]] = Map()
  for dk in decl_params_map.keys() {
    let m : Map[Int, Bool] = Map()
    match decl_params_map.get(dk) {
      Some(plist) => {
        for pair in plist {
          m[pair.0] = true
        }
      }
      None => ()
    }
    param_safe[dk] = m
  }
  let empty_allowed : Map[Int, Bool] = Map()
  let mut ps_iter = 0
  let mut ps_changed = true
  while ps_changed && ps_iter < 6 {
    ps_changed = false
    ps_iter = ps_iter + 1
    for dk in decl_params_map.keys() {
      match (decl_tokens_map.get(dk), decl_open_map.get(dk), decl_close_map.get(dk), decl_params_map.get(dk), param_safe.get(dk)) {
        (Some(ts_d), Some(bo_d), Some(bc_d), Some(plist), Some(pmap)) => {
          for pair in plist {
            if pmap.get(pair.0) == Some(true) {
              if !local_or_param_never_escapes(ts_d, pair.1, bo_d, bc_d, empty_allowed, by_name, dep_methods, param_safe, decl_is_known) {
                pmap[pair.0] = false
                ps_changed = true
              }
            }
          }
        }
        _ => ()
      }
    }
  }
  let fn_ret_fresh_array : Map[String, Bool] = Map()
  let fn_ret_field : Map[String, String] = Map()
  let mut ret_iter = 0
  let mut ret_changed = true
  while ret_changed && ret_iter < 6 {
    ret_changed = false
    ret_iter = ret_iter + 1
    for dk in decl_tokens_map.keys() {
      if fn_ret_fresh_array.contains(dk) {
        continue
      }
      match (decl_tokens_map.get(dk), decl_open_map.get(dk), decl_close_map.get(dk)) {
        (Some(ts_d), Some(bo_d), Some(bc_d)) => {
          let spans = collect_fn_return_spans(ts_d, bo_d, bc_d)
          if spans.length() == 0 {
            continue
          }
          // Pre-build set of token positions that are direct return expressions `out`
          let ret_ident_pos : Map[Int, Bool] = Map()
          for sp in spans {
            let mut s0 = sp.0
            let mut e0 = sp.1
            while s0 < e0 && ts_d[s0].kind == TokenKind::LParen && find_matching_delim(ts_d, s0) == e0 {
              s0 = s0 + 1
              e0 = e0 - 1
            }
            if s0 == e0 && ts_d[s0].kind == TokenKind::Ident {
              ret_ident_pos[s0] = true
            }
          }
          let mut all_fresh = true
          let mut common_field = ""
          let mut all_fresh_or_same_field = true
          for sp in spans {
            let mut rs = sp.0
            let mut re = sp.1
            while rs < re && ts_d[rs].kind == TokenKind::LParen && find_matching_delim(ts_d, rs) == re {
              rs = rs + 1
              re = re - 1
            }
            if re < rs {
              all_fresh = false
              all_fresh_or_same_field = false
              break
            }
            let mut sp_fresh = false
            let mut sp_field = ""
            if expr_is_fresh_array_init(ts_d, rs, re) {
              sp_fresh = true
            } else if rs == re && ts_d[rs].kind == TokenKind::Ident {
              let vnm = ts_d[rs].raw
              if fresh_local_binding(ts_d, vnm, bo_d, rs, false) &&
              local_or_param_never_escapes(ts_d, vnm, bo_d, bc_d, ret_ident_pos, by_name, dep_methods, param_safe, decl_is_known) {
                sp_fresh = true
              }
            } else if ts_d[re].kind == TokenKind::RParen {
              let lp = find_open_before(ts_d, re, rs)
              if lp >= rs + 2 && ts_d[lp - 2].kind == TokenKind::Dot && ts_d[lp - 1].kind == TokenKind::Ident {
                let cm = ts_d[lp - 1].raw
                if (cm == "map" || cm == "filter") && !by_name.contains(cm) && !dep_methods.contains(cm) {
                  sp_fresh = true
                } else if !dep_methods.contains(cm) {
                  match by_name.get(cm) {
                    Some(ckeys) =>
                    if ckeys.length() > 0 {
                      let mut cf = true
                      let mut cfield = ""
                      let mut cfield_ok = true
                      for cdk in ckeys {
                        if !fn_ret_fresh_array.contains(cdk) {
                          cf = false
                          match fn_ret_field.get(cdk) {
                            Some(fnm) =>
                            if cfield.length() == 0 { cfield = fnm }
                            else if cfield != fnm { cfield_ok = false }
                            None => cfield_ok = false
                          }
                        }
                      }
                      if cf { sp_fresh = true }
                      else if cfield_ok && cfield.length() > 0 { sp_field = cfield }
                    }
                    None => ()
                  }
                }
              } else if lp >= rs + 3 && ts_d[lp - 2].kind == TokenKind::ColonColon && ts_d[lp - 1].kind == TokenKind::Ident &&
              !(lp >= rs + 4 && ts_d[lp - 4].kind == TokenKind::ColonColon) {
                let cdk = ts_d[lp - 3].raw + "::" + ts_d[lp - 1].raw
                if fn_ret_fresh_array.contains(cdk) { sp_fresh = true }
                else {
                  match fn_ret_field.get(cdk) {
                    Some(fnm) => sp_field = fnm
                    None => ()
                  }
                }
              } else if lp == rs + 1 && ts_d[rs].kind == TokenKind::Ident {
                let cdk = "::" + ts_d[rs].raw
                if fn_ret_fresh_array.contains(cdk) { sp_fresh = true }
                else {
                  match fn_ret_field.get(cdk) {
                    Some(fnm) => sp_field = fnm
                    None => ()
                  }
                }
              }
            } else if re >= rs + 2 && ts_d[re - 1].kind == TokenKind::Dot && ts_d[re].kind == TokenKind::Ident {
              let fnm = ts_d[re].raw
              if array_fields.get(fnm) == Some(true) {
                sp_field = fnm
              }
            }
            if sp_fresh {
              ()
            } else if sp_field.length() > 0 {
              all_fresh = false
              if common_field.length() == 0 {
                common_field = sp_field
              } else if common_field != sp_field {
                all_fresh_or_same_field = false
                break
              }
            } else {
              all_fresh = false
              all_fresh_or_same_field = false
              break
            }
          }
          if all_fresh {
            fn_ret_fresh_array[dk] = true
            fn_ret_field.remove(dk)
            ret_changed = true
          } else if all_fresh_or_same_field && common_field.length() > 0 {
            if fn_ret_field.get(dk) != Some(common_field) {
              fn_ret_field[dk] = common_field
              ret_changed = true
            }
          }
        }
        _ => ()
      }
    }
  }
  let (local_struct_names, pure_type_candidates, ctor_owner) = collect_local_pure_type_candidates(all_tokens)
  let impure_eq_types : Map[String, Bool] = Map()
  let pure_eq_types : Map[String, Bool] = Map()
  let mut found_local_eq = false
  for eq_nm in ["op_equal", "eq", "equal"] {
    match by_name.get(eq_nm) {
      Some(keys) => {
        for dk in keys {
          let sep = dk.index_of("::")
          if sep > 0 {
            found_local_eq = true
            let ty = dk.slice(0, sep)
            match effects.get(dk) {
              Some(ef) =>
              if ef.may_grow || ef.may_write || ef.may_shrink_or_shift || ef.may_shrink_to_fit || ef.may_call_opaque || ef.may_call_unknown || ef.may_pass_param_to_dep {
                impure_eq_types[ty] = true
              } else if !impure_eq_types.contains(ty) {
                pure_eq_types[ty] = true
              }
              None => impure_eq_types[ty] = true
            }
          }
        }
      }
      None => ()
    }
  }
  for ty in impure_eq_types.keys() {
    pure_eq_types.remove(ty)
  }
  if local_has_custom_eq && !found_local_eq {
    impure_eq_types["*"] = true
  }
  // Monotone fixpoint: local non-generic `struct` / `enum` whose fields/payloads are transitively built-in or pure_eq_types.
  if !impure_eq_types.contains("*") {
    let mut changed = true
    while changed {
      changed = false
      for tname in pure_type_candidates.keys() {
        if pure_eq_types.contains(tname) || impure_eq_types.contains(tname) {
          continue
        }
        match pure_type_candidates.get(tname) {
          Some(deps) => {
            let mut ok = true
            for d in deps {
              if !is_builtin_eq_type_name(d) && !pure_eq_types.contains(d) {
                ok = false
                break
              }
            }
            if ok {
              pure_eq_types[tname] = true
              changed = true
            }
          }
          None => ()
        }
      }
    }
  }
  let pure_enum_ctors : Map[String, Bool] = Map()
  for vname in ctor_owner.keys() {
    match ctor_owner.get(vname) {
      Some(owner) =>
      if owner.length() > 0 && pure_eq_types.contains(owner) {
        pure_enum_ctors[vname] = true
      }
      None => ()
    }
  }

  let dep_methods_copy : Map[String, Bool] = Map()
  for dm in dep_methods.keys() {
    match dep_methods.get(dm) {
      Some(true) => dep_methods_copy[dm] = true
      _ => ()
    }
  }
  let dep_has_custom_eq = dep_methods_copy.contains(" eq") ||
  dep_methods_copy.contains("op_equal") ||
  dep_methods_copy.contains("eq") ||
  dep_methods_copy.contains("equal")
  CapPkgSummary::{
    effects: effects,
    by_name: by_name,
    sort_env: sort_env,
    dep_methods: dep_methods_copy,
    has_custom_eq: has_custom_eq,
    local_has_custom_eq: local_has_custom_eq,
    dep_has_custom_eq: dep_has_custom_eq,
    impure_eq_types: impure_eq_types,
    pure_eq_types: pure_eq_types,
    pure_enum_ctors: pure_enum_ctors,
    local_struct_names: local_struct_names,
    fn_return_types: fn_return_types,
    field_types: field_types,
    field_all_builtin: field_all_builtin,
    array_elem_types: array_elem_types,
    array_elem_all_builtin: array_elem_all_builtin,
    array_elem_type_sets: array_elem_type_sets,
    array_elem_unknown: array_elem_unknown,
    nested_array_elem_types: nested_array_elem_types,
    distinct_array_fields: distinct_array_fields,
    fn_ret_fresh_array: fn_ret_fresh_array,
    fn_ret_field: fn_ret_field,
    safe_closure_fields: safe_closure_fields,
    array_fields: array_fields,
    pkg_globals: pkg_globals,
  }
}

///| Find the body `{` of the innermost enclosing named `fn` containing `pos` (handles `impl T { fn m(..) { .. } }`,
///| where `outermost_body_open` returns `impl T`'s `{` instead of the method's `{`).
fn innermost_fn_body_open(tokens : Array[Token], pos : Int, fallback : Int) -> Int {
  let mut b = pos
  while b > 0 {
    let o = enclosing_open(tokens, b, 0, TokenKind::LBrace)
    if o < 0 {
      break
    }
    let fs = fn_start_of(tokens, o)
    if fs >= 0 && !(fs + 1 < o && tokens[fs + 1].kind == TokenKind::LParen) {
      return o
    }
    b = o
  }
  fallback
}

///| True iff identifier `nm` is bound in the match-arm pattern ending before `arrow_i` (`=>`),
///| ignoring any `if <guard>` expression between the pattern and `=>`.
fn match_arm_pattern_binds(tokens : Array[Token], arrow_i : Int, limit : Int, nm : String) -> Bool {
  // Scan backward from `arrow_i - 1` to find the start of this arm's pattern (and skip any `if <guard>`).
  let mut arm_s = arrow_i - 1
  let mut d = 0
  let mut guard_if = -1
  while arm_s > limit {
    let k = tokens[arm_s].kind
    if k == TokenKind::RParen || k == TokenKind::RBracket || k == TokenKind::RBrace {
      d = d + 1
    } else if k == TokenKind::LParen || k == TokenKind::LBracket || k == TokenKind::LBrace {
      if d == 0 {
        break
      }
      d = d - 1
    } else if d == 0 {
      if k == TokenKind::Semi || k == TokenKind::FatArrow {
        break
      }
      if tokens[arm_s].raw == "if" {
        guard_if = arm_s
      }
      if tokens[arm_s].newline_before && arm_s < arrow_i - 1 {
        // Check if previous line ended an arm (no trailing `|` or `,`)
        if tokens[arm_s - 1].kind != TokenKind::Pipe && tokens[arm_s - 1].kind != TokenKind::Comma {
          break
        }
      }
    }
    arm_s = arm_s - 1
  }
  let pat_s = arm_s + 1
  let pat_e = if guard_if > pat_s { guard_if } else { arrow_i }
  let mut i = pat_s
  while i < pat_e {
    if tokens[i].kind == TokenKind::Ident && tokens[i].raw == nm &&
    !(i > pat_s && (tokens[i - 1].kind == TokenKind::Dot || tokens[i - 1].kind == TokenKind::ColonColon)) &&
    !(i + 1 < pat_e && tokens[i + 1].kind == TokenKind::Colon) {
      return true
    }
    i = i + 1
  }
  false
}

///| Resolve the declared type string of identifier `nm` in the enclosing function (`body_open`, `site_i`),
///| walking strictly from the innermost enclosing lexical scope outward to `fn_bo`:
///| inside each `{ ... }` block, any local `let [mut] nm ...`, destructuring `let (... nm ...) = ...`,
///| or `match` arm pattern binding `nm` shadows outer scopes immediately (returning `""` if its type is unknown);
///| when leaving a `{`, checks `for` / closure `fn(...)` / `pat => {` binders before moving outward;
///| only after reaching `fn_bo` checks the function parameter signature.
fn resolve_local_type_name(
  tokens : Array[Token],
  nm : String,
  body_open : Int,
  site_i : Int,
  summary : CapPkgSummary,
) -> String {
  if body_open < 0 || nm.length() == 0 {
    return ""
  }
  let fn_bo = innermost_fn_body_open(tokens, site_i, body_open)
  let mut cur_pos = site_i
  while cur_pos > fn_bo {
    let blk_open = enclosing_open(tokens, cur_pos, fn_bo, TokenKind::LBrace)
    let stop_at = if blk_open >= fn_bo { blk_open } else { fn_bo }
    // 1. Scan inside `(stop_at, cur_pos)` backwards (skipping closed nested `{ ... }`) for `let` & inline `match` arm binders.
    let mut li = cur_pos - 1
    while li > stop_at {
      if tokens[li].kind == TokenKind::RBrace {
        let lb = find_open_before(tokens, li, stop_at)
        if lb < 0 {
          break
        }
        li = lb - 1
        continue
      }
      if tokens[li].kind == TokenKind::FatArrow {
        if match_arm_pattern_binds(tokens, li, stop_at, nm) {
          return ""
        }
      }
      if tokens[li].raw == "is" {
        // Check `guard expr is Pat(nm)` / `if expr is Pat(nm)` pattern binders
        let mut ip = li + 1
        let mut ipd = 0
        while ip < cur_pos {
          let ik = tokens[ip].kind
          if ipd == 0 && (ik == TokenKind::LBrace || ik == TokenKind::Semi || tokens[ip].raw == "else" || tokens[ip].raw == "&&" || tokens[ip].raw == "||" || (ip > li + 1 && tokens[ip].newline_before)) {
            break
          }
          if ik == TokenKind::LParen || ik == TokenKind::LBracket || ik == TokenKind::LBrace { ipd = ipd + 1 }
          else if ik == TokenKind::RParen || ik == TokenKind::RBracket || ik == TokenKind::RBrace {
            if ipd == 0 { break }
            ipd = ipd - 1
          } else if ik == TokenKind::Ident && tokens[ip].raw == nm &&
          !(ip > li + 1 && (tokens[ip - 1].kind == TokenKind::Dot || tokens[ip - 1].kind == TokenKind::ColonColon)) &&
          !(ip + 1 < cur_pos && tokens[ip + 1].kind == TokenKind::Colon) {
            return ""
          }
          ip = ip + 1
        }
      }
      if tokens[li].raw == "let" {
        let mut ni = li + 1
        if ni < cur_pos && tokens[ni].raw == "mut" { ni = ni + 1 }
        if ni < cur_pos && tokens[ni].kind == TokenKind::Ident && tokens[ni].raw == nm &&
        (ni + 1 >= cur_pos || tokens[ni + 1].kind == TokenKind::Colon || tokens[ni + 1].kind == TokenKind::Eq) {
          if ni + 2 < cur_pos && tokens[ni + 1].kind == TokenKind::Colon {
            if tokens[ni + 2].raw == "Array" && ni + 5 < cur_pos && tokens[ni + 3].kind == TokenKind::LBracket &&
            is_type_ident_tok(tokens[ni + 4].kind) && tokens[ni + 5].kind == TokenKind::RBracket {
              return "Array:" + tokens[ni + 4].raw
            }
            if is_type_ident_tok(tokens[ni + 2].kind) &&
            !(ni + 3 < cur_pos && (tokens[ni + 3].kind == TokenKind::LBracket || tokens[ni + 3].kind == TokenKind::ColonColon)) {
              return tokens[ni + 2].raw
            }
            return ""
          } else if ni + 2 < cur_pos && tokens[ni + 1].kind == TokenKind::Eq {
            let mut rhs = ni + 2
            let mut paren_end = -1
            while rhs < cur_pos && tokens[rhs].kind == TokenKind::LParen {
              let rp_l = find_matching_delim(tokens, rhs)
              if rp_l <= rhs + 1 || rp_l >= cur_pos || !paren_is_single_expr(tokens, rhs, rp_l) {
                break
              }
              paren_end = rp_l
              rhs = rhs + 1
            }
            let rk = tokens[rhs].kind
            let is_stmt_boundary = fn(end_pos : Int) -> Bool {
              if paren_end >= 0 {
                if end_pos + 1 != paren_end {
                  return false
                }
                let nxt_p = paren_end + 1
                return nxt_p >= cur_pos || tokens[nxt_p].newline_before || tokens[nxt_p].kind == TokenKind::Semi || tokens[nxt_p].kind == TokenKind::RBrace
              }
              let nxt = end_pos + 1
              nxt >= cur_pos || tokens[nxt].newline_before || tokens[nxt].kind == TokenKind::Semi || tokens[nxt].kind == TokenKind::RBrace
            }
            if rk == TokenKind::IntLit && is_stmt_boundary(rhs) { return "Int" }
            if tokens[rhs].raw == "-" && rhs + 1 < cur_pos && tokens[rhs + 1].kind == TokenKind::IntLit && is_stmt_boundary(rhs + 1) { return "Int" }
            if rk == TokenKind::FloatLit && is_stmt_boundary(rhs) { return "Double" }
            if tokens[rhs].raw == "-" && rhs + 1 < cur_pos && tokens[rhs + 1].kind == TokenKind::FloatLit && is_stmt_boundary(rhs + 1) { return "Double" }
            if rk == TokenKind::StringLit && is_stmt_boundary(rhs) { return "String" }
            if rk == TokenKind::CharLit && is_stmt_boundary(rhs) { return "Char" }
            if (tokens[rhs].raw == "true" || tokens[rhs].raw == "false") && is_stmt_boundary(rhs) { return "Bool" }
            // `let nm = if <cond> { <scalar_lit> } else { <scalar_lit> }`
            if tokens[rhs].raw == "if" {
              let mut ib = rhs + 1
              let mut id = 0
              while ib < cur_pos && !(id == 0 && tokens[ib].kind == TokenKind::LBrace) {
                let ik = tokens[ib].kind
                if ik == TokenKind::LParen || ik == TokenKind::LBracket || ik == TokenKind::LBrace { id = id + 1 }
                else if ik == TokenKind::RParen || ik == TokenKind::RBracket || ik == TokenKind::RBrace { id = id - 1 }
                ib = ib + 1
              }
              if ib < cur_pos && tokens[ib].kind == TokenKind::LBrace {
                let rb1 = find_matching_delim(tokens, ib)
                if rb1 == ib + 2 && rb1 + 2 < cur_pos && tokens[rb1 + 1].raw == "else" && tokens[rb1 + 2].kind == TokenKind::LBrace {
                  let rb2 = find_matching_delim(tokens, rb1 + 2)
                  if rb2 == rb1 + 4 && rb2 < cur_pos && is_stmt_boundary(rb2) {
                    let k1 = tokens[ib + 1].kind
                    let k2 = tokens[rb1 + 3].kind
                    if k1 == TokenKind::IntLit && k2 == TokenKind::IntLit { return "Int" }
                    if k1 == TokenKind::FloatLit && k2 == TokenKind::FloatLit { return "Double" }
                    if k1 == TokenKind::StringLit && k2 == TokenKind::StringLit { return "String" }
                    if (tokens[ib + 1].raw == "true" || tokens[ib + 1].raw == "false") &&
                    (tokens[rb1 + 3].raw == "true" || tokens[rb1 + 3].raw == "false") { return "Bool" }
                  }
                }
              }
            }
            if rk == TokenKind::Ident && tokens[rhs].raw != nm {
              // `Array::make(n, <lit>)` or `mbt_compat::arr_make(n, <lit>)`
              if (tokens[rhs].raw == "Array" || tokens[rhs].raw == "mbt_compat") && rhs + 4 < cur_pos &&
              tokens[rhs + 1].kind == TokenKind::ColonColon && (tokens[rhs + 2].raw == "make" || tokens[rhs + 2].raw == "arr_make") &&
              tokens[rhs + 3].kind == TokenKind::LParen {
                let cp = find_matching_delim(tokens, rhs + 3)
                if cp > rhs + 3 && cp < cur_pos && is_stmt_boundary(cp) {
                  let last_arg = cp - 1
                  if tokens[last_arg].kind == TokenKind::IntLit { return "Array:Int" }
                  if tokens[last_arg].kind == TokenKind::FloatLit { return "Array:Double" }
                  if tokens[last_arg].kind == TokenKind::StringLit { return "Array:String" }
                  if tokens[last_arg].raw == "true" || tokens[last_arg].raw == "false" { return "Array:Bool" }
                }
              }
              // `let x = e.f`
              if rhs + 1 < cur_pos && tokens[rhs + 1].kind == TokenKind::Dot {
                let mut cur = rhs
                while cur + 2 < cur_pos && tokens[cur + 1].kind == TokenKind::Dot && tokens[cur + 2].kind == TokenKind::Ident {
                  cur = cur + 2
                  if cur + 1 < cur_pos && tokens[cur + 1].kind == TokenKind::LBracket {
                    let rb = find_matching_delim(tokens, cur + 1)
                    if rb > cur + 1 && rb + 2 < cur_pos && tokens[rb + 1].kind == TokenKind::Dot && tokens[rb + 2].kind == TokenKind::Ident {
                      cur = rb + 2
                    } else {
                      break
                    }
                  }
                }
                if is_stmt_boundary(cur) && eq_field_recv_is_local(tokens, cur - 1, fn_bo, li, summary) {
                  match summary.field_types.get(tokens[cur].raw) {
                    Some(ft) => if ft.length() > 0 { return ft }
                    None => ()
                  }
                }
              } else if rhs + 1 < cur_pos && tokens[rhs + 1].kind == TokenKind::LParen && !tokens[rhs + 1].newline_before {
                let cp_fn = find_matching_delim(tokens, rhs + 1)
                if cp_fn > rhs + 1 && cp_fn < cur_pos && is_stmt_boundary(cp_fn) {
                  match summary.fn_return_types.get(tokens[rhs].raw) {
                    Some(rty) => if rty.length() > 0 { return rty }
                    None => ()
                  }
                }
              } else if is_stmt_boundary(rhs) {
                return resolve_local_type_name(tokens, tokens[rhs].raw, fn_bo, li, summary)
              }
            }
          }
          // Innermost `let nm = <untyped/unknown>` shadows outer scopes -> fail closed!
          return ""
        } else if ni < cur_pos {
          // Check destructuring `let (a, nm) = ...` / `let { nm } = ...` / `let Some(nm) = ...`
          let mut pi = ni
          let mut pd = 0
          let mut hit_eq = false
          let mut binds_nm = false
          while pi < cur_pos {
            let pk = tokens[pi].kind
            if pd == 0 && pk == TokenKind::Eq {
              hit_eq = true
              break
            }
            if pd == 0 && (pk == TokenKind::Semi || (pi > ni && tokens[pi].newline_before)) {
              break
            }
            if pk == TokenKind::LParen || pk == TokenKind::LBracket || pk == TokenKind::LBrace { pd = pd + 1 }
            else if pk == TokenKind::RParen || pk == TokenKind::RBracket || pk == TokenKind::RBrace { pd = pd - 1 }
            else if pk == TokenKind::Ident && tokens[pi].raw == nm &&
            !(pi > ni && (tokens[pi - 1].kind == TokenKind::Dot || tokens[pi - 1].kind == TokenKind::ColonColon)) &&
            !(pi + 1 < cur_pos && tokens[pi + 1].kind == TokenKind::Colon) {
              binds_nm = true
            }
            pi = pi + 1
          }
          if hit_eq && binds_nm {
            return ""
          }
        }
      }
      li = li - 1
    }
    if stop_at <= fn_bo {
      break
    }
    let o = stop_at
    // 2a. Check if `{` at `o` is a `match` arm block `pat => {` or `if/while ... is Pat(nm) {`
    if o > fn_bo && tokens[o - 1].kind == TokenKind::FatArrow {
      if match_arm_pattern_binds(tokens, o - 1, fn_bo, nm) {
        return ""
      }
    }
    let mut isi = o - 1
    let mut isd = 0
    while isi > fn_bo {
      let isk = tokens[isi].kind
      if isk == TokenKind::RParen || isk == TokenKind::RBracket || isk == TokenKind::RBrace { isd = isd + 1 }
      else if isk == TokenKind::LParen || isk == TokenKind::LBracket || isk == TokenKind::LBrace {
        if isd == 0 { break }
        isd = isd - 1
      } else if isd == 0 {
        if isk == TokenKind::Semi || tokens[isi].raw == "for" || tokens[isi].raw == "fn" { break }
        if tokens[isi].raw == "is" {
          let mut ip2 = isi + 1
          let mut ipd2 = 0
          while ip2 < o {
            let ik2 = tokens[ip2].kind
            if ipd2 == 0 && (ik2 == TokenKind::LBrace || tokens[ip2].raw == "else" || tokens[ip2].raw == "&&" || tokens[ip2].raw == "||") { break }
            if ik2 == TokenKind::LParen || ik2 == TokenKind::LBracket || ik2 == TokenKind::LBrace { ipd2 = ipd2 + 1 }
            else if ik2 == TokenKind::RParen || ik2 == TokenKind::RBracket || ik2 == TokenKind::RBrace {
              if ipd2 == 0 { break }
              ipd2 = ipd2 - 1
            } else if ik2 == TokenKind::Ident && tokens[ip2].raw == nm &&
            !(ip2 > isi + 1 && (tokens[ip2 - 1].kind == TokenKind::Dot || tokens[ip2 - 1].kind == TokenKind::ColonColon)) &&
            !(ip2 + 1 < o && tokens[ip2 + 1].kind == TokenKind::Colon) {
              return ""
            }
            ip2 = ip2 + 1
          }
        }
        if tokens[isi].raw == "if" || tokens[isi].raw == "while" { break }
      }
      isi = isi - 1
    }
    // 2b. Check if `{` at `o` is a `for ... in <iter> {`
    let mut fi = o - 1
    let mut hd = 0
    let mut in_i = -1
    let mut for_i = -1
    let mut is_range = false
    while fi > fn_bo {
      let fk = tokens[fi].kind
      if fk == TokenKind::RParen || fk == TokenKind::RBracket || fk == TokenKind::RBrace { hd = hd + 1 }
      else if fk == TokenKind::LParen || fk == TokenKind::LBracket || fk == TokenKind::LBrace {
        if hd == 0 { break }
        hd = hd - 1
      } else if hd == 0 {
        if tokens[fi].raw == "in" && in_i < 0 { in_i = fi }
        else if in_i < 0 && (tokens[fi].raw == "..<" || tokens[fi].raw == "..=") { is_range = true }
        else if tokens[fi].raw == "for" { for_i = fi; break }
        else if fk == TokenKind::Semi { break }
      }
      fi = fi - 1
    }
    if for_i >= 0 && in_i > for_i {
      if for_i + 2 < in_i && tokens[for_i + 1].kind == TokenKind::Ident && tokens[for_i + 1].raw == nm && tokens[for_i + 2].kind == TokenKind::Comma &&
      for_i + 4 == in_i {
        return "Int"
      }
      let is_simple_elem = (for_i + 2 == in_i && tokens[for_i + 1].kind == TokenKind::Ident) ||
      (for_i + 4 == in_i && tokens[for_i + 2].kind == TokenKind::Comma && tokens[for_i + 3].kind == TokenKind::Ident)
      if !is_simple_elem {
        // Destructuring `for (a, b) in ... {` — any binder matching `nm` shadows outer scopes with unknown type!
        let mut fp = for_i + 1
        while fp < in_i {
          if tokens[fp].kind == TokenKind::Ident && tokens[fp].raw == nm &&
          !(fp > for_i + 1 && (tokens[fp - 1].kind == TokenKind::Dot || tokens[fp - 1].kind == TokenKind::ColonColon)) &&
          !(fp + 1 < in_i && tokens[fp + 1].kind == TokenKind::Colon) {
            return ""
          }
          fp = fp + 1
        }
      }
      let elem_i = if for_i + 3 < in_i && tokens[for_i + 2].kind == TokenKind::Comma { for_i + 3 } else { for_i + 1 }
      if is_simple_elem && elem_i < in_i && tokens[elem_i].raw == nm {
        if is_range {
          return "Int"
        }
        let mut is_ = in_i + 1
        let mut ie_ = o - 1
        while is_ < ie_ && tokens[is_].kind == TokenKind::LParen && find_matching_delim(tokens, is_) == ie_ {
          is_ = is_ + 1
          ie_ = ie_ - 1
        }
        if ie_ >= is_ + 2 && tokens[ie_ - 1].kind == TokenKind::Dot && tokens[ie_].kind == TokenKind::Ident &&
        eq_field_recv_is_local(tokens, ie_ - 1, fn_bo, for_i, summary) {
          if summary.array_elem_all_builtin.get(tokens[ie_].raw) == Some(true) {
            return "Int"
          }
          match summary.array_elem_types.get(tokens[ie_].raw) {
            Some(elem) => if elem.length() > 0 { return elem }
            None => ()
          }
          match summary.field_types.get(tokens[ie_].raw) {
            Some(ft) => if ft.starts_with("Array:") { return ft.slice(6, ft.length()) }
            None => ()
          }
        } else if ie_ == is_ && tokens[ie_].kind == TokenKind::Ident {
          let arr_ty = resolve_local_type_name(tokens, tokens[ie_].raw, fn_bo, for_i, summary)
          if arr_ty.starts_with("Array:") {
            return arr_ty.slice(6, arr_ty.length())
          }
        }
        return ""
      }
    }
    // 2c. Check if `{` at `o` is a closure `fn(a [: T], ...) {`
    let mut ci = o - 1
    while ci > fn_bo && tokens[ci].kind != TokenKind::RParen && tokens[ci].kind != TokenKind::Semi &&
    tokens[ci].kind != TokenKind::LBrace {
      ci = ci - 1
    }
    if ci > fn_bo && tokens[ci].kind == TokenKind::RParen {
      let lp = find_open_before(tokens, ci, fn_bo)
      if lp > fn_bo && tokens[lp - 1].raw == "fn" {
        let mut pk = lp + 1
        let mut pd = 0
        let mut untyped_match = false
        while pk < ci {
          let pkk = tokens[pk].kind
          if pkk == TokenKind::LParen || pkk == TokenKind::LBracket { pd = pd + 1 }
          else if pkk == TokenKind::RParen || pkk == TokenKind::RBracket { pd = pd - 1 }
          else if pd == 0 && pkk == TokenKind::Ident && tokens[pk].raw == nm {
            if pk + 2 < ci && tokens[pk + 1].kind == TokenKind::Colon {
              if tokens[pk + 2].raw == "Array" && pk + 5 < ci && tokens[pk + 3].kind == TokenKind::LBracket &&
              is_type_ident_tok(tokens[pk + 4].kind) && tokens[pk + 5].kind == TokenKind::RBracket {
                return "Array:" + tokens[pk + 4].raw
              }
              return tokens[pk + 2].raw
            }
            untyped_match = true
          }
          pk = pk + 1
        }
        if untyped_match {
          // Untyped closure param `arr.search_by(fn(r) { ... })` / `.any`/`.all`/`.find_first`/`.each`
          if lp >= 5 && tokens[lp - 2].kind == TokenKind::LParen &&
          tokens[lp - 3].kind == TokenKind::Ident && tokens[lp - 4].kind == TokenKind::Dot {
            let ho_m = tokens[lp - 3].raw
            if ho_m == "search_by" || ho_m == "any" || ho_m == "all" || ho_m == "find_first" || ho_m == "each" {
              let recv_i = lp - 5
              if recv_i >= 2 && tokens[recv_i].kind == TokenKind::Ident && tokens[recv_i - 1].kind == TokenKind::Dot &&
              eq_field_recv_is_local(tokens, recv_i - 1, fn_bo, lp - 2, summary) {
                match summary.array_elem_types.get(tokens[recv_i].raw) {
                  Some(ae) => if ae.length() > 0 { return ae }
                  None => ()
                }
                match summary.field_types.get(tokens[recv_i].raw) {
                  Some(ft) => if ft.starts_with("Array:") { return ft.slice(6, ft.length()) }
                  None => ()
                }
              } else if recv_i >= fn_bo && tokens[recv_i].kind == TokenKind::Ident &&
              !(recv_i >= 1 && (tokens[recv_i - 1].kind == TokenKind::Dot || tokens[recv_i - 1].kind == TokenKind::ColonColon)) {
                let arr_ty = resolve_local_type_name(tokens, tokens[recv_i].raw, fn_bo, lp - 2, summary)
                if arr_ty.starts_with("Array:") {
                  return arr_ty.slice(6, arr_ty.length())
                }
              }
            }
          }
          // Unannotated closure param shadows outer scopes -> fail closed!
          return ""
        }
      }
    }
    cur_pos = o
  }
  // 3. Function parameter signature `fn f[..](..., nm : Ty, ...) {`
  let fs = fn_start_of(tokens, fn_bo)
  if fs >= 0 {
    let mut pk = fs + 1
    let mut paren_d = 0
    let mut brack_d = 0
    while pk + 2 < fn_bo {
      let pkk = tokens[pk].kind
      if pkk == TokenKind::LParen { paren_d = paren_d + 1 }
      else if pkk == TokenKind::RParen { paren_d = paren_d - 1 }
      else if pkk == TokenKind::LBracket { brack_d = brack_d + 1 }
      else if pkk == TokenKind::RBracket { brack_d = brack_d - 1 }
      else if paren_d == 1 && brack_d == 0 && (pkk == TokenKind::Ident || tokens[pk].raw == "self") && tokens[pk].raw == nm &&
      tokens[pk + 1].kind == TokenKind::Colon {
        if tokens[pk + 2].raw == "Array" && pk + 5 < fn_bo && tokens[pk + 3].kind == TokenKind::LBracket {
          if is_type_ident_tok(tokens[pk + 4].kind) && tokens[pk + 5].kind == TokenKind::RBracket {
            return "Array:" + tokens[pk + 4].raw
          }
          if tokens[pk + 4].kind == TokenKind::LParen {
            return "Array:("
          }
        }
        if is_type_ident_tok(tokens[pk + 2].kind) &&
        !(pk + 3 < fn_bo && (tokens[pk + 3].kind == TokenKind::LBracket || tokens[pk + 3].kind == TokenKind::ColonColon)) {
          return tokens[pk + 2].raw
        }
        return ""
      }
      pk = pk + 1
    }
  }
  ""
}

///| True iff `(tokens[lp+1 .. rp])` contains no top-level tuple comma, semicolon, block, `if`, or `match`.
fn paren_is_single_expr(tokens : Array[Token], lp : Int, rp : Int) -> Bool {
  if lp < 0 || rp <= lp + 1 {
    return false
  }
  let mut k = lp + 1
  let mut d = 0
  while k < rp {
    let kk = tokens[k].kind
    if kk == TokenKind::LParen || kk == TokenKind::LBracket || kk == TokenKind::LBrace {
      if d == 0 && kk == TokenKind::LBrace {
        return false
      }
      d = d + 1
    } else if kk == TokenKind::RParen || kk == TokenKind::RBracket || kk == TokenKind::RBrace {
      d = d - 1
    } else if d == 0 {
      if kk == TokenKind::Comma || kk == TokenKind::Semi || tokens[k].raw == "if" || tokens[k].raw == "match" {
        return false
      }
    }
    k = k + 1
  }
  true
}

///| Resolve the exact local struct type name immediately before `dot_pos` (or `""` if unknown/foreign).
fn resolve_local_struct_name(
  tokens : Array[Token],
  dot_pos : Int,
  body_open : Int,
  site_i : Int,
  summary : CapPkgSummary,
) -> String {
  if dot_pos <= 0 {
    return ""
  }
  let prev = tokens[dot_pos - 1]
  // Direct `r.f` or `self.f`
  if (prev.kind == TokenKind::Ident || prev.raw == "self") &&
  !(dot_pos >= 2 && (tokens[dot_pos - 2].kind == TokenKind::Dot || tokens[dot_pos - 2].kind == TokenKind::ColonColon)) {
    if body_open < 0 {
      return ""
    }
    let rty = resolve_local_type_name(tokens, prev.raw, body_open, site_i, summary)
    if rty.length() > 0 && summary.local_struct_names.contains(rty) {
      return rty
    }
    if prev.raw == "self" {
      // Fallback: `fn StructName::method(self, ...)` without explicit `: StructName` on `self`
      let fn_bo = innermost_fn_body_open(tokens, site_i, body_open)
      let fs = fn_start_of(tokens, fn_bo)
      if fs >= 0 && fs + 3 < fn_bo && is_type_ident_tok(tokens[fs + 1].kind) && tokens[fs + 2].kind == TokenKind::ColonColon &&
      summary.local_struct_names.contains(tokens[fs + 1].raw) {
        return tokens[fs + 1].raw
      }
    }
    return ""
  }
  // Chained `e.mid.f`
  if prev.kind == TokenKind::Ident && dot_pos >= 2 && tokens[dot_pos - 2].kind == TokenKind::Dot {
    if resolve_local_struct_name(tokens, dot_pos - 2, body_open, site_i, summary).length() == 0 {
      return ""
    }
    match summary.field_types.get(prev.raw) {
      Some(ft) => if summary.local_struct_names.contains(ft) { return ft }
      None => ()
    }
    return ""
  }
  // Indexed `e.arr[i].f` or `arr[i].f`
  if prev.kind == TokenKind::RBracket && dot_pos >= 2 {
    let lb = find_open_before(tokens, dot_pos - 1, if body_open >= 0 { body_open } else { 0 })
    if lb >= 2 && tokens[lb - 1].kind == TokenKind::Ident && tokens[lb - 2].kind == TokenKind::Dot {
      if resolve_local_struct_name(tokens, lb - 2, body_open, site_i, summary).length() == 0 {
        return ""
      }
      match summary.array_elem_types.get(tokens[lb - 1].raw) {
        Some(ae) => if ae.length() > 0 && summary.local_struct_names.contains(ae) { return ae }
        None => ()
      }
      match summary.field_types.get(tokens[lb - 1].raw) {
        Some(ft) => if ft.starts_with("Array:") {
          let el = ft.slice(6, ft.length())
          if summary.local_struct_names.contains(el) { return el }
        }
        None => ()
      }
      return ""
    } else if lb >= 1 && tokens[lb - 1].kind == TokenKind::Ident && body_open >= 0 {
      let arr_ty = resolve_local_type_name(tokens, tokens[lb - 1].raw, body_open, site_i, summary)
      if arr_ty.starts_with("Array:") {
        let el = arr_ty.slice(6, arr_ty.length())
        if summary.local_struct_names.contains(el) { return el }
      }
    }
    return ""
  }
  ""
}

///| True iff the struct field receiver immediately before `dot_pos` is proven to be a local struct
///| (prevents cross-package same-name field pollution, e.g. `dep::Ref[BadEq].val` vs local `struct Local { val : Int }`).
fn eq_field_recv_is_local(
  tokens : Array[Token],
  dot_pos : Int,
  body_open : Int,
  site_i : Int,
  summary : CapPkgSummary,
) -> Bool {
  if dot_pos <= 0 {
    return false
  }
  let prev = tokens[dot_pos - 1]
  // Direct `r.f`
  if (prev.kind == TokenKind::Ident || prev.raw == "self") &&
  !(dot_pos >= 2 && (tokens[dot_pos - 2].kind == TokenKind::Dot || tokens[dot_pos - 2].kind == TokenKind::ColonColon)) {
    if prev.raw == "self" {
      return true
    }
    if body_open < 0 {
      return false
    }
    let rty = resolve_local_type_name(tokens, prev.raw, body_open, site_i, summary)
    return rty.length() > 0 && summary.local_struct_names.contains(rty)
  }
  // Chained `e.mid.f`
  if prev.kind == TokenKind::Ident && dot_pos >= 2 && tokens[dot_pos - 2].kind == TokenKind::Dot {
    if !eq_field_recv_is_local(tokens, dot_pos - 2, body_open, site_i, summary) {
      return false
    }
    match summary.field_types.get(prev.raw) {
      Some(ft) => return summary.local_struct_names.contains(ft)
      None => return false
    }
  }
  // Indexed `e.arr[i].f` or `arr[i].f`
  if prev.kind == TokenKind::RBracket && dot_pos >= 2 {
    let lb = find_open_before(tokens, dot_pos - 1, if body_open >= 0 { body_open } else { 0 })
    if lb >= 2 && tokens[lb - 1].kind == TokenKind::Ident && tokens[lb - 2].kind == TokenKind::Dot {
      if !eq_field_recv_is_local(tokens, lb - 2, body_open, site_i, summary) {
        return false
      }
      match summary.array_elem_types.get(tokens[lb - 1].raw) {
        Some(ae) => if ae.length() > 0 && summary.local_struct_names.contains(ae) { return true }
        None => ()
      }
      match summary.field_types.get(tokens[lb - 1].raw) {
        Some(ft) => return ft.starts_with("Array:") && summary.local_struct_names.contains(ft.slice(6, ft.length()))
        None => return false
      }
    } else if lb >= 1 && tokens[lb - 1].kind == TokenKind::Ident && body_open >= 0 {
      let arr_ty = resolve_local_type_name(tokens, tokens[lb - 1].raw, body_open, site_i, summary)
      return arr_ty.starts_with("Array:") && summary.local_struct_names.contains(arr_ty.slice(6, arr_ty.length()))
    }
    return false
  }
  false
}

///| Strict whitelist of built-in methods guaranteed to return a built-in scalar (never `Option[T]` or user type).
fn is_pure_scalar_eq_method(m : String) -> Bool {
  m == "length" || m == "is_empty" || m == "to_int" || m == "to_double" || m == "to_float" ||
  m == "to_string" || m == "to_int64" || m == "to_uint" || m == "to_uint64" || m == "code_unit_at" ||
  m == "contains" || m == "starts_with" || m == "ends_with" || m == "index_of" || m == "last_index_of" ||
  m == "is_some" || m == "is_none" || m == "is_ok" || m == "is_err" || m == "abs" || m == "floor" ||
  m == "ceil" || m == "round" || m == "trunc" || m == "sqrt" || m == "compare"
}

///| True iff the operand ending at `idx` (`is_lhs == true`) or starting at `idx` (`is_lhs == false`)
///| of `==`/`!=` is proven to have a built-in scalar or pure-`Eq` type (fail-closed on containers of unverified types).
fn eq_operand_is_pure(
  tokens : Array[Token],
  idx : Int,
  body_open : Int,
  site_i : Int,
  summary : CapPkgSummary,
  is_lhs : Bool,
) -> Bool {
  let n = tokens.length()
  if idx < 0 || idx >= n {
    return false
  }
  let mut p = idx
  let mut bound_lo = -1
  let mut bound_hi = -1
  // Strip outer parens on the operand side, or handle `()` Unit literal / scalar-result calls / enum ctors.
  if is_lhs {
    while tokens[p].kind == TokenKind::RParen && p > 0 {
      let lp = find_open_before(tokens, p, if body_open >= 0 { body_open } else { 0 })
      if lp < 0 {
        return false
      }
      if lp == p - 1 {
        // Either `()` unit literal or `expr.m()` call
        if lp >= 2 && tokens[lp - 1].kind == TokenKind::Ident && tokens[lp - 2].kind == TokenKind::Dot {
          if is_pure_scalar_eq_method(tokens[lp - 1].raw) && !summary.sort_env.methods.contains(tokens[lp - 1].raw) {
            return true
          }
          return false
        }
        if !(lp >= 1 && (is_type_ident_tok(tokens[lp - 1].kind) || tokens[lp - 1].kind == TokenKind::RParen ||
          tokens[lp - 1].kind == TokenKind::RBracket || tokens[lp - 1].kind == TokenKind::RBrace)) {
          return true
        }
        return false
      }
      // `expr.m(...)` scalar-result method call
      if lp >= 2 && tokens[lp - 1].kind == TokenKind::Ident && tokens[lp - 2].kind == TokenKind::Dot {
        if is_pure_scalar_eq_method(tokens[lp - 1].raw) && !summary.sort_env.methods.contains(tokens[lp - 1].raw) {
          return true
        }
        return false
      }
      // Qualified pure enum payload constructor `E::V(...)`
      if lp >= 3 && tokens[lp - 1].kind == TokenKind::UpperIdent && tokens[lp - 2].kind == TokenKind::ColonColon &&
      is_type_ident_tok(tokens[lp - 3].kind) && !(lp >= 4 && tokens[lp - 4].kind == TokenKind::ColonColon) {
        return summary.pure_eq_types.contains(tokens[lp - 3].raw)
      }
      // Unambiguous bare pure enum payload constructor `V(...)`
      if lp >= 1 && tokens[lp - 1].kind == TokenKind::UpperIdent &&
      !(lp >= 2 && (tokens[lp - 2].kind == TokenKind::Dot || tokens[lp - 2].kind == TokenKind::ColonColon)) {
        return summary.pure_enum_ctors.get(tokens[lp - 1].raw) == Some(true)
      }
      // Other call `f(...)` or indirect call `(f)(...)` / `fns[0](...)` — cannot strip parens
      if lp >= 1 && (is_type_ident_tok(tokens[lp - 1].kind) || tokens[lp - 1].kind == TokenKind::RParen ||
        tokens[lp - 1].kind == TokenKind::RBracket || tokens[lp - 1].kind == TokenKind::RBrace) {
        return false
      }
      // Grouping parens `(expr)`: reject tuples, blocks, `if`, `match`
      if !paren_is_single_expr(tokens, lp, p) {
        return false
      }
      bound_lo = lp + 1
      bound_hi = p - 1
      p = p - 1
    }
  } else {
    while p < n && tokens[p].kind == TokenKind::LParen {
      let rp = find_matching_delim(tokens, p)
      if rp < 0 {
        return false
      }
      if rp == p + 1 {
        let after_u = rp + 1
        if after_u < n && (tokens[after_u].kind == TokenKind::Dot || tokens[after_u].raw == "|>" || tokens[after_u].kind == TokenKind::ColonColon) {
          return false
        }
        return true
      }
      if !paren_is_single_expr(tokens, p, rp) {
        return false
      }
      if rp + 1 < n && (tokens[rp + 1].kind == TokenKind::Dot || tokens[rp + 1].raw == "|>" || tokens[rp + 1].kind == TokenKind::ColonColon) {
        return false
      }
      bound_lo = p + 1
      bound_hi = rp - 1
      p = p + 1
    }
    if tokens[p].raw == "-" && p + 1 < n &&
    (tokens[p + 1].kind == TokenKind::IntLit || tokens[p + 1].kind == TokenKind::FloatLit) {
      if bound_hi >= 0 && p + 1 != bound_hi {
        return false
      }
      let after_n = p + 2
      if after_n < n && (tokens[after_n].kind == TokenKind::Dot || tokens[after_n].raw == "|>" || tokens[after_n].kind == TokenKind::ColonColon) {
        return false
      }
      return true
    }
  }
  let tk = tokens[p]
  let kk = tk.kind
  // When inside stripped parens `(expr)`, literals must occupy the entire parenthesized span.
  let lit_fits_bounds = if bound_lo >= 0 && bound_hi >= 0 {
    if is_lhs {
      p == bound_lo || (p == bound_lo + 1 && tokens[bound_lo].raw == "-")
    } else {
      p == bound_hi
    }
  } else {
    true
  }
  if kk == TokenKind::IntLit || kk == TokenKind::FloatLit || kk == TokenKind::StringLit ||
  kk == TokenKind::CharLit || tk.raw == "true" || tk.raw == "false" || tk.raw == "None" {
    if !lit_fits_bounds {
      return false
    }
    if is_lhs {
      // Reject tuple field projection like `pair.0` or qualified `pkg::None`
      if p > 0 && (tokens[p - 1].kind == TokenKind::Dot || tokens[p - 1].kind == TokenKind::ColonColon) {
        return false
      }
    } else {
      // Reject method call / pipe on literal like `0.to_bad()` or `0 |> to_bad()`
      if p + 1 < n && (tokens[p + 1].kind == TokenKind::Dot || tokens[p + 1].raw == "|>" || tokens[p + 1].kind == TokenKind::ColonColon) {
        return false
      }
    }
    return true
  }
  if is_lhs {
    // Qualified pure enum unit variant `E::V`
    if kk == TokenKind::UpperIdent && p >= 2 && tokens[p - 1].kind == TokenKind::ColonColon &&
    is_type_ident_tok(tokens[p - 2].kind) && !(p >= 3 && tokens[p - 3].kind == TokenKind::ColonColon) {
      if bound_lo >= 0 && p - 2 != bound_lo {
        return false
      }
      return summary.pure_eq_types.contains(tokens[p - 2].raw)
    }
    // Unambiguous bare pure enum unit variant `V`
    if kk == TokenKind::UpperIdent && !(p >= 1 && (tokens[p - 1].kind == TokenKind::Dot || tokens[p - 1].kind == TokenKind::ColonColon)) {
      if bound_lo >= 0 && p != bound_lo {
        return false
      }
      return summary.pure_enum_ctors.get(tk.raw) == Some(true)
    }
    // Field access `e.f`
    if kk == TokenKind::Ident && p >= 1 && tokens[p - 1].kind == TokenKind::Dot {
      if bound_lo >= 0 {
        let mut s_walk = p - 2
        while s_walk > bound_lo && (tokens[s_walk].kind == TokenKind::Ident || tokens[s_walk].kind == TokenKind::Dot || tokens[s_walk].raw == "self") {
          s_walk = s_walk - 1
        }
        if s_walk != bound_lo || !(tokens[s_walk].kind == TokenKind::Ident || tokens[s_walk].raw == "self") {
          return false
        }
      }
      if !eq_field_recv_is_local(tokens, p - 1, body_open, site_i, summary) {
        return false
      }
      if summary.field_all_builtin.get(tk.raw) == Some(true) {
        return true
      }
      match summary.field_types.get(tk.raw) {
        Some(ft) => if is_pure_eq_type_name(ft, summary) { return true }
        None => ()
      }
      return false
    }
    // Index access `e[i]` where `e` is `Array[Pure]`
    if kk == TokenKind::RBracket && p > 0 {
      let lb = find_open_before(tokens, p, if body_open >= 0 { body_open } else { 0 })
      if lb > 0 && tokens[lb - 1].kind == TokenKind::Ident {
        if lb >= 2 && tokens[lb - 2].kind == TokenKind::Dot {
          if !eq_field_recv_is_local(tokens, lb - 2, body_open, site_i, summary) {
            return false
          }
          if summary.array_elem_all_builtin.get(tokens[lb - 1].raw) == Some(true) {
            return true
          }
          match summary.array_elem_types.get(tokens[lb - 1].raw) {
            Some(ae) => if ae.length() > 0 && is_pure_eq_type_name(ae, summary) { return true }
            None => ()
          }
          match summary.field_types.get(tokens[lb - 1].raw) {
            Some(ft) => if ft.starts_with("Array:") && is_pure_eq_type_name(ft.slice(6, ft.length()), summary) { return true }
            None => ()
          }
        } else {
          if bound_lo >= 0 && lb - 1 != bound_lo {
            return false
          }
          let arr_ty = resolve_local_type_name(tokens, tokens[lb - 1].raw, body_open, site_i, summary)
          if arr_ty.starts_with("Array:") && is_pure_eq_type_name(arr_ty.slice(6, arr_ty.length()), summary) {
            return true
          }
        }
      }
      return false
    }
    // Bare identifier `x`
    if kk == TokenKind::Ident && !(p >= 1 && tokens[p - 1].kind == TokenKind::ColonColon) {
      if bound_lo >= 0 && p != bound_lo {
        return false
      }
      let ty = resolve_local_type_name(tokens, tk.raw, body_open, site_i, summary)
      if ty.length() > 0 && is_pure_eq_type_name(ty, summary) {
        return true
      }
    }
  } else {
    // Qualified pure enum variant `E::V` or `E::V(...)`
    if is_type_ident_tok(kk) && p + 2 < n && tokens[p + 1].kind == TokenKind::ColonColon &&
    tokens[p + 2].kind == TokenKind::UpperIdent && !(p >= 1 && tokens[p - 1].kind == TokenKind::ColonColon) {
      let end_pos = if p + 3 < n && tokens[p + 3].kind == TokenKind::LParen && !tokens[p + 3].newline_before {
        find_matching_delim(tokens, p + 3)
      } else {
        p + 2
      }
      if end_pos < 0 || (bound_hi >= 0 && end_pos != bound_hi) {
        return false
      }
      if end_pos + 1 < n && (tokens[end_pos + 1].kind == TokenKind::Dot || tokens[end_pos + 1].raw == "|>" || tokens[end_pos + 1].kind == TokenKind::ColonColon) {
        return false
      }
      return summary.pure_eq_types.contains(tk.raw)
    }
    // Unambiguous bare pure enum variant `V` or `V(...)`
    if kk == TokenKind::UpperIdent && !(p + 1 < n && tokens[p + 1].kind == TokenKind::ColonColon) {
      let end_pos = if p + 1 < n && tokens[p + 1].kind == TokenKind::LParen && !tokens[p + 1].newline_before {
        find_matching_delim(tokens, p + 1)
      } else {
        p
      }
      if end_pos < 0 || (bound_hi >= 0 && end_pos != bound_hi) {
        return false
      }
      if end_pos + 1 < n && (tokens[end_pos + 1].kind == TokenKind::Dot || tokens[end_pos + 1].raw == "|>" || tokens[end_pos + 1].kind == TokenKind::ColonColon) {
        return false
      }
      return summary.pure_enum_ctors.get(tk.raw) == Some(true)
    }
    // Walk forward through `a.b[i].c` on RHS to find the terminal segment
    if kk == TokenKind::Ident || tk.raw == "self" {
      let mut cur = p
      let mut end_tok = p
      let mut is_call = false
      let mut is_idx = false
      while cur + 1 < n {
        if tokens[cur + 1].kind == TokenKind::Dot && cur + 2 < n && tokens[cur + 2].kind == TokenKind::Ident {
          cur = cur + 2
          end_tok = cur
          is_idx = false
        } else if tokens[cur + 1].kind == TokenKind::LBracket {
          let rb = find_matching_delim(tokens, cur + 1)
          if rb > cur + 1 {
            if rb + 2 < n && tokens[rb + 1].kind == TokenKind::Dot && tokens[rb + 2].kind == TokenKind::Ident {
              cur = rb + 2
              end_tok = cur
              is_idx = false
            } else {
              end_tok = rb
              is_idx = true
              break
            }
          } else {
            break
          }
        } else if tokens[cur + 1].kind == TokenKind::LParen && !tokens[cur + 1].newline_before {
          let rp = find_matching_delim(tokens, cur + 1)
          end_tok = if rp > cur + 1 { rp } else { cur + 1 }
          is_call = true
          break
        } else {
          break
        }
      }
      if bound_hi >= 0 && end_tok != bound_hi {
        return false
      }
      if end_tok + 1 < n && (tokens[end_tok + 1].kind == TokenKind::Dot || tokens[end_tok + 1].raw == "|>" || tokens[end_tok + 1].kind == TokenKind::ColonColon) {
        return false
      }
      if is_call {
        if cur >= 1 && tokens[cur - 1].kind == TokenKind::Dot &&
        is_pure_scalar_eq_method(tokens[cur].raw) && !summary.sort_env.methods.contains(tokens[cur].raw) {
          return true
        }
        return false
      }
      if is_idx {
        if cur >= 1 && tokens[cur - 1].kind == TokenKind::Dot {
          if !eq_field_recv_is_local(tokens, cur - 1, body_open, site_i, summary) {
            return false
          }
          if summary.array_elem_all_builtin.get(tokens[cur].raw) == Some(true) {
            return true
          }
          match summary.array_elem_types.get(tokens[cur].raw) {
            Some(ae) => if ae.length() > 0 && is_pure_eq_type_name(ae, summary) { return true }
            None => ()
          }
          match summary.field_types.get(tokens[cur].raw) {
            Some(ft) => if ft.starts_with("Array:") && is_pure_eq_type_name(ft.slice(6, ft.length()), summary) { return true }
            None => ()
          }
        } else {
          let arr_ty = resolve_local_type_name(tokens, tokens[cur].raw, body_open, site_i, summary)
          if arr_ty.starts_with("Array:") && is_pure_eq_type_name(arr_ty.slice(6, arr_ty.length()), summary) {
            return true
          }
        }
        return false
      }
      if cur > p && tokens[cur - 1].kind == TokenKind::Dot {
        if !eq_field_recv_is_local(tokens, cur - 1, body_open, site_i, summary) {
          return false
        }
        if summary.field_all_builtin.get(tokens[cur].raw) == Some(true) {
          return true
        }
        match summary.field_types.get(tokens[cur].raw) {
          Some(ft) => if is_pure_eq_type_name(ft, summary) { return true }
          None => ()
        }
        return false
      }
      // Bare identifier `x`
      let ty = resolve_local_type_name(tokens, tk.raw, body_open, site_i, summary)
      if ty.length() > 0 && is_pure_eq_type_name(ty, summary) {
        return true
      }
    }
  }
  false
}

///| Sound `Array::search_by(pred)` hazard checker enforcing MoonBit's `(buf, init_len)` slot-stability invariant.
///| Returns "" when live-array `mbt_compat::arr_search_by` is proven 100% semantically identical to MoonBit,
///| or a concrete diagnostic reason otherwise (fail-closed).
pub fn search_by_hazard(tokens : Array[Token], dot_i : Int, summary : CapPkgSummary) -> String {
  if dot_i <= 0 || dot_i + 2 >= tokens.length() || tokens[dot_i + 2].kind != TokenKind::LParen {
    return "malformed `.search_by(` call"
  }
  let close_p = find_matching_delim(tokens, dot_i + 2)
  if close_p < 0 || dot_i + 3 >= close_p {
    return "unbalanced `.search_by(` call"
  }
  let body_open = outermost_body_open(tokens, dot_i)
  if body_open < 0 {
    return "search_by outside function body"
  }
  let body_close = find_matching_delim(tokens, body_open)
  let root = receiver_root(tokens, dot_i - 1)
  let fresh_root = is_array_literal_end(tokens, dot_i - 1) ||
  (root.length() > 0 && fresh_local_binding(tokens, root, body_open, dot_i, true))
  let names : Map[String, Bool] = if fresh_root && root.length() > 0 {
    array_aliases(tokens, root, body_open, body_close)
  } else {
    Map()
  }
  let computed = !fresh_root
  let callables = callable_locals(tokens, body_open)
  let arg_s = dot_i + 3
  let arg_e = close_p

  // Callback must be an inline closure literal `fn(...) { ... }`, a single-binding local closure literal,
  // or a pure package-local free function (not shadowed by a local/param).
  let mut cb_open = -1
  let mut cb_close = -1
  let mut cb_tokens = tokens
  let mut cb_body_open = body_open
  if tokens[arg_s].raw == "fn" && arg_s + 1 < arg_e && tokens[arg_s + 1].kind == TokenKind::LParen {
    let cp = find_matching_delim(tokens, arg_s + 1)
    let mut lb = cp + 1
    while lb < arg_e && tokens[lb].kind != TokenKind::LBrace { lb = lb + 1 }
    if lb < arg_e && tokens[lb].kind == TokenKind::LBrace {
      cb_open = lb
      cb_close = find_matching_delim(tokens, lb)
    } else {
      return "`search_by` closure has no body"
    }
  } else if arg_e == arg_s + 1 && tokens[arg_s].kind == TokenKind::Ident {
    let cname = tokens[arg_s].raw
    let lb = local_closure_body(tokens, arg_s, cname)
    if lb >= 0 {
      cb_open = lb
      cb_close = find_matching_delim(tokens, lb)
    } else if !callables.contains(cname) && summary_fn_is_pure_read_only(summary, cname, false) {
      return ""
    } else {
      return "`search_by` takes an opaque callback `" + cname + "`"
    }
  } else {
    return "`search_by` takes a non-literal callback expression"
  }

  let flags = [false, false]
  let why = search_by_body_hazard(cb_tokens, cb_open + 1, cb_close, cb_body_open, dot_i, root, names, computed, callables, summary, flags, 0)
  if why.length() > 0 {
    return why
  }
  appends_and_writes(flags)
}

fn search_by_body_hazard(
  tokens : Array[Token],
  s : Int,
  e : Int,
  body_open : Int,
  site_i : Int,
  root : String,
  names : Map[String, Bool],
  computed : Bool,
  callables : Map[String, Bool],
  summary : CapPkgSummary,
  flags : Array[Bool],
  depth : Int,
) -> String {
  let mut k = s
  while k < e {
    let tk = tokens[k]
    let kk = tk.kind
    if kk == TokenKind::InterpString || kk == TokenKind::InterpMultiline {
      return "the callback interpolates a string (may run arbitrary `Show` code)"
    }
    if kk == TokenKind::PipeGt {
      return "the callback uses `|>` pipe"
    }
    if (kk == TokenKind::EqEq || tk.raw == "!=") && summary.has_custom_eq {
      let lhs_pure = k > s && eq_operand_is_pure(tokens, k - 1, body_open, k, summary, true)
      let rhs_pure = k + 1 < e && eq_operand_is_pure(tokens, k + 1, body_open, k, summary, false)
      if !(lhs_pure || rhs_pure) {
        return "the callback compares with `" + tk.raw + "` while a user type has an `impl Eq`"
      }
    }
    // Index write `arr[i] = v`
    if kk == TokenKind::RBracket && k + 1 < e &&
    (tokens[k + 1].kind == TokenKind::Eq || tokens[k + 1].kind == TokenKind::AssignOp) {
      let lb = find_open_before(tokens, k, s)
      let wr_root = if lb > s { receiver_root(tokens, lb - 1) } else { "" }
      let is_disjoint = !computed && wr_root.length() > 0 && !names.contains(wr_root)
      if !is_disjoint {
        flags[1] = true
      }
    }
    // Indirect call `(...)(...)` or `arr[0](...)`
    if (kk == TokenKind::RParen || kk == TokenKind::RBracket) && k + 1 < e &&
    tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before {
      // Check proven-safe private struct closure field `(e.off)()` keyed by `StructName.field`
      let mut safe_field_call = false
      if kk == TokenKind::RParen {
        let op = find_open_before(tokens, k, s)
        if op >= s && k - op >= 3 && tokens[k - 1].kind == TokenKind::Ident &&
        tokens[k - 2].kind == TokenKind::Dot {
          let sname = resolve_local_struct_name(tokens, k - 2, body_open, k, summary)
          if sname.length() > 0 && summary.safe_closure_fields.contains(sname + "." + tokens[k - 1].raw) {
            safe_field_call = true
          }
        }
      }
      if !safe_field_call {
        return "the callback makes an indirect call"
      }
    }
    // Method call `recv.m(...)`
    if kk == TokenKind::Dot && k + 2 < e && tokens[k + 1].kind == TokenKind::Ident &&
    tokens[k + 2].kind == TokenKind::LParen {
      let m = tokens[k + 1].raw
      let recv_r = receiver_root(tokens, k - 1)
      let is_disjoint = !computed && recv_r.length() > 0 && !names.contains(recv_r)
      let recv_is_builtin_arr = (recv_r.length() > 0 && fresh_local_binding(tokens, recv_r, body_open, site_i, false)) ||
      receiver_is_builtin(tokens, k - 1, body_open, site_i, summary.sort_env)
      let shadowed_user_arr_op = !recv_is_builtin_arr && (summary.by_name.contains(m) || summary.dep_methods.contains(m)) &&
      (is_cap_arr_shrink_or_shift_method(m) || is_cap_arr_growth_method(m) || is_cap_arr_write_method(m) || m == "shrink_to_fit")
      if shadowed_user_arr_op && !summary_fn_is_pure_read_only(summary, m, true) {
        return "the callback calls `." + m + "(..)`, which may invoke a user/dependency method that mutates arrays"
      }
      if is_cap_arr_shrink_or_shift_method(m) || m == "shrink_to_fit" {
        if !is_disjoint {
          return "`." + m + "(..)` mutates the array during `search_by`"
        }
      } else if is_cap_arr_growth_method(m) {
        if !is_disjoint {
          flags[0] = true
        }
      } else if is_cap_arr_write_method(m) {
        if !is_disjoint {
          flags[1] = true
        }
      } else if m == "capacity" {
        return "`.capacity()` may observe buffer reallocation during `search_by`"
      } else {
        // Check if method is proven pure built-in or proven pure package method
        let pure_bi = (is_pure_key_method(m) || m == "has_prefix" || m == "has_suffix" || m == "starts_with" ||
          m == "ends_with" || m == "trim" || m == "trim_end" || m == "to_lower" || m == "to_upper") &&
        (!summary.sort_env.methods.contains(m) || receiver_is_builtin(tokens, k - 1, body_open, site_i, summary.sort_env))
        let pure_iter_chain = m == "iter" && iter_chain_is_consumed(tokens, find_matching_delim(tokens, k + 2))
        let cp_m = find_matching_delim(tokens, k + 2)
        let mut pure_iter_term = false
        if !summary.sort_env.methods.contains(m) {
          if m == "count" && cp_m == k + 3 {
            pure_iter_term = true
          } else if (m == "any" || m == "all" || m == "find_first") && cp_m > k + 3 {
            if tokens[k + 3].raw == "fn" {
              // Inline closure literal: outer loop scans its body token-by-token.
              pure_iter_term = true
            } else if cp_m == k + 4 && tokens[k + 3].kind == TokenKind::Ident {
              let cb_nm = tokens[k + 3].raw
              let lb = local_closure_body(tokens, k + 3, cb_nm)
              if lb >= 0 && !(lb < k && k < find_matching_delim(tokens, lb)) {
                if depth >= 8 {
                  return "the callback nests local closures too deeply"
                }
                let cb_why = search_by_body_hazard(tokens, lb + 1, find_matching_delim(tokens, lb), body_open, site_i, root, names, computed, callables, summary, flags, depth + 1)
                if cb_why.length() > 0 {
                  return cb_why + " (through `" + cb_nm + "` in `." + m + "(..)`)"
                }
                pure_iter_term = true
              } else if !callables.contains(cb_nm) && summary_fn_is_pure_read_only(summary, cb_nm, false) {
                pure_iter_term = true
              } else {
                return "the callback passes opaque `" + cb_nm + "` to `." + m + "(..)`"
              }
            }
          }
        }
        if !pure_bi && !pure_iter_chain && !pure_iter_term && !summary_fn_is_pure_read_only(summary, m, true) {
          return "the callback calls `." + m + "(..)`, which is not proven mutation-free"
        }
      }
    }
    // Free or qualified call
    if kk == TokenKind::Ident && k + 1 < e && tokens[k + 1].kind == TokenKind::LParen &&
    !tokens[k + 1].newline_before && !is_call_keyword(tk.raw) && !(k > 0 && tokens[k - 1].raw == "fn") &&
    !(k > 0 && tokens[k - 1].kind == TokenKind::Dot) {
      if k >= 2 && tokens[k - 1].kind == TokenKind::ColonColon {
        let q = tokens[k - 2].raw
        if q == "mbt_compat" {
          if is_cap_compat_shrink_or_shift_fn(tk.raw) || tk.raw == "arr_shrink_to_fit" {
            return "`mbt_compat::" + tk.raw + "(..)` mutates the array during `search_by`"
          } else if is_cap_compat_growth_fn(tk.raw) {
            flags[0] = true
          } else if is_cap_compat_write_fn(tk.raw) {
            flags[1] = true
          } else if !is_pure_key_compat_helper(tk.raw) && !is_pure_first_order_mbt_compat_fn(tk.raw) {
            return "the callback calls `mbt_compat::" + tk.raw + "(..)`"
          }
        } else if is_ctor_name(tk.raw) {
          ()
        } else if !(k >= 3 && tokens[k - 3].kind == TokenKind::ColonColon) {
          // 2-segment `Type::method(...)` in same package
          match summary.effects.get(q + "::" + tk.raw) {
            Some(ef) => if !ef.is_pure_read_only() {
              return "the callback calls `" + q + "::" + tk.raw + "(..)`, which may mutate arrays"
            }
            None => return "the callback calls unknown `" + q + "::" + tk.raw + "(..)`"
          }
        } else {
          return "the callback makes a cross-package call to `" + q + "::" + tk.raw + "(..)`"
        }
      } else if is_ctor_name(tk.raw) || is_pure_builtin_free_fn(tk.raw) {
        if callables.contains(tk.raw) {
          return "the callback calls shadowed `" + tk.raw + "(..)`"
        }
      } else {
        // Local closure literal or package free function
        let lb = local_closure_body(tokens, k, tk.raw)
        if lb >= 0 && !(lb < k && k < find_matching_delim(tokens, lb)) {
          if depth >= 8 {
            return "the callback nests local closures too deeply"
          }
          let why = search_by_body_hazard(tokens, lb + 1, find_matching_delim(tokens, lb), body_open, site_i, root, names, computed, callables, summary, flags, depth + 1)
          if why.length() > 0 {
            return why + " (through `" + tk.raw + "`)"
          }
        } else if callables.contains(tk.raw) {
          return "the callback calls opaque closure `" + tk.raw + "(..)`"
        } else if !summary_fn_is_pure_read_only(summary, tk.raw, false) {
          return "the callback calls `" + tk.raw + "(..)`, which is not proven mutation-free"
        }
      }
    }
    k = k + 1
  }
  ""
}

///| True iff the `{` at `brace_i` is the body brace of a `for` or `while` loop header.
fn is_loop_body_brace(tokens : Array[Token], brace_i : Int, limit_open : Int) -> Bool {
  let mut h = brace_i - 1
  let mut d = 0
  while h > limit_open {
    let hk = tokens[h].kind
    if hk == TokenKind::RBrace && d == 0 {
      if tokens[h].newline_before {
        break
      }
      let ob = find_open_before(tokens, h, limit_open)
      if ob <= limit_open {
        break
      }
      h = ob - 1
      continue
    }
    if hk == TokenKind::RParen || hk == TokenKind::RBracket || hk == TokenKind::RBrace {
      d = d + 1
    } else if hk == TokenKind::LParen || hk == TokenKind::LBracket || hk == TokenKind::LBrace {
      if d == 0 {
        break
      }
      d = d - 1
    } else if d == 0 {
      let r = tokens[h].raw
      if r == "for" || r == "while" {
        return true
      }
      if r == "if" || r == "else" || r == "match" || r == "fn" || hk == TokenKind::Semi {
        return false
      }
    }
    if tokens[h].newline_before && d == 0 {
      break
    }
    h = h - 1
  }
  false
}

///| True iff the statement starting at `stmt_i` inside block `(block_open, block_close)` of the audited
///| `for .. in` loop (`loop_open`) unconditionally exits the OUTER `for .. in` loop before another iteration
///| can read a slot:
///| - Never true inside an inner closure (neither `break` nor `return` exits the outer loop);
///| - Inside an inner `for`/`while` loop between `stmt_i` and `loop_open`, ONLY `return` exits the outer loop
///|   (`break` only exits the inner loop!).
fn stmt_immediately_exits_loop(tokens : Array[Token], stmt_i : Int, loop_open : Int, block_close : Int) -> Bool {
  if loop_open < 0 || stmt_i <= loop_open || stmt_i >= block_close {
    return false
  }
  // Inside a closure within the loop body: neither `break` nor `return` exits the outer `for .. in`.
  if enclosing_closure_open(tokens, stmt_i, loop_open) >= 0 {
    return false
  }
  // Check whether any enclosing `{` strictly between `stmt_i` and `loop_open` is an inner `for`/`while`.
  let mut in_inner_loop = false
  let mut b = stmt_i
  while true {
    let o = enclosing_open(tokens, b, loop_open, TokenKind::LBrace)
    if o < 0 || o <= loop_open {
      break
    }
    if is_loop_body_brace(tokens, o, loop_open) {
      in_inner_loop = true
      break
    }
    b = o
  }
  let exits_outer = fn(r : String) -> Bool {
    r == "return" || (!in_inner_loop && r == "break")
  }
  let span_clean = fn(from : Int, to : Int) -> Bool {
    let mut ti = from
    while ti < to {
      let tr = tokens[ti].raw
      if tr == "continue" || tr == "for" || tr == "while" {
        return false
      }
      ti = ti + 1
    }
    true
  }
  // Walk to end of current statement, then check the next statement in the same block.
  let se = statement_end(tokens, stmt_i, block_close)
  let mut k = se
  while k < block_close && tokens[k].kind == TokenKind::Semi {
    k = k + 1
  }
  if k >= block_close {
    return false
  }
  if exits_outer(tokens[k].raw) {
    return span_clean(stmt_i, k)
  }
  // Allow up to 3 simple non-looping statements before `break`/`return` as long as none of them contain
  // a nested loop or branch that could skip the exit.
  let mut steps = 0
  let mut cur = k
  while cur < block_close && steps < 4 {
    let r = tokens[cur].raw
    if exits_outer(r) {
      return span_clean(stmt_i, cur)
    }
    if r == "if" || r == "while" || r == "for" || r == "match" || r == "continue" || r == "break" {
      return false
    }
    let nxt = statement_end(tokens, cur, block_close)
    cur = nxt
    while cur < block_close && tokens[cur].kind == TokenKind::Semi {
      cur = cur + 1
    }
    steps = steps + 1
  }
  false
}

///| True iff all custom `Eq` methods declared in this package are proven free of array hazards.
fn summary_custom_eq_is_pure(summary : CapPkgSummary) -> Bool {
  let mut found = false
  for eq_nm in ["op_equal", "eq", "equal"] {
    match summary.by_name.get(eq_nm) {
      Some(keys) =>
      if keys.length() > 0 {
        found = true
        for dk in keys {
          match summary.effects.get(dk) {
            Some(ef) =>
            if ef.may_shrink_or_shift || ef.may_shrink_to_fit || ef.may_call_opaque || (ef.may_grow && ef.may_write) {
              return false
            }
            None => return false
          }
        }
      }
      None => ()
    }
  }
  found
}

///| Sound `for x in xs { ... }` / `for i, x in xs { ... }` hazard checker enforcing `(buf, init_len)` slot-stability.
///| Catches any shrink (`clear`/`pop`/`remove`/`truncate`/`drain`/`retain`), compound shift
///| (`insert`/`splice`/`resize`/etc.), `shrink_to_fit`, grow+write (including cross-function),
///| opaque/indirect/cross-package calls, or custom `impl Eq` on `xs` or its aliases when another
///| iteration may still read a slot of `xs`. Returns "" if safe, or a diagnostic reason.
pub fn for_in_array_hazard(tokens : Array[Token], for_i : Int, summary : CapPkgSummary) -> String {
  let n = tokens.length()
  // Find `in` and `{` of this `for ... in <iter> {`
  let mut j = for_i + 1
  let mut in_i = -1
  let mut hd = 0
  while j < n {
    let jk = tokens[j].kind
    if hd == 0 && jk == TokenKind::LBrace {
      break
    }
    if jk == TokenKind::LParen || jk == TokenKind::LBracket || jk == TokenKind::LBrace { hd = hd + 1 }
    else if jk == TokenKind::RParen || jk == TokenKind::RBracket || jk == TokenKind::RBrace { hd = hd - 1 }
    else if hd == 0 && tokens[j].raw == "in" {
      in_i = j
    } else if hd == 0 && in_i > 0 && (tokens[j].raw == "..<" || tokens[j].raw == "..=") {
      // Range loop `for i in a..<b` — not an array iteration
      return ""
    }
    j = j + 1
  }
  if in_i < 0 || j >= n || tokens[j].kind != TokenKind::LBrace {
    return ""
  }
  let loop_open = j
  let loop_close = find_matching_delim(tokens, loop_open)
  if loop_close <= loop_open {
    return ""
  }
  // Strip any balanced outer parentheses around the iterable expression `(xs)` / `((b.items))`.
  let mut iter_s = in_i + 1
  let mut iter_e = loop_open - 1
  while iter_s < iter_e && tokens[iter_s].kind == TokenKind::LParen &&
  find_matching_delim(tokens, iter_s) == iter_e {
    iter_s = iter_s + 1
    iter_e = iter_e - 1
  }
  if iter_e < iter_s {
    return ""
  }
  // Array literal `for x in [1, 2, 3]` or fresh String split/iter or private copy `for x in copy`: cannot be mutated through any name.
  if is_array_literal_end(tokens, iter_e) {
    return ""
  }
  if tokens[iter_e].kind == TokenKind::RParen {
    let lp_it = find_open_before(tokens, iter_e, iter_s)
    if lp_it >= iter_s + 3 && tokens[lp_it - 2].kind == TokenKind::ColonColon && tokens[lp_it - 3].raw == "mbt_compat" &&
    (tokens[lp_it - 1].raw == "str_split" || tokens[lp_it - 1].raw == "str_iter" || tokens[lp_it - 1].raw == "str_chars") {
      return ""
    }
    if lp_it >= iter_s + 2 && tokens[lp_it - 2].kind == TokenKind::Dot &&
    (tokens[lp_it - 1].raw == "split" || tokens[lp_it - 1].raw == "chars") &&
    !summary.by_name.contains(tokens[lp_it - 1].raw) && !summary.dep_methods.contains(tokens[lp_it - 1].raw) {
      return ""
    }
  }
  let body_open = outermost_body_open(tokens, for_i)
  if body_open < 0 {
    return ""
  }
  let body_close = find_matching_delim(tokens, body_open)
  if loop_iterable_private_copy(tokens, body_open, body_close, in_i, loop_open, summary.array_fields) == 1 {
    return ""
  }
  let mut root = receiver_root(tokens, iter_e)
  let mut tail = path_tail(tokens, iter_e)
  let mut is_field_iter = iter_e >= 2 && tokens[iter_e - 1].kind == TokenKind::Dot
  let iter_has_call_or_idx = tokens[iter_e].kind == TokenKind::RParen || tokens[iter_e].kind == TokenKind::RBracket
  let mut is_computed_iter = iter_has_call_or_idx || (!is_field_iter && root.length() == 0)
  let mut is_nested_field_iter = false
  // Refinement 3: Package function/method return provenance (`fn_ret_fresh_array` / `fn_ret_field`).
  if is_computed_iter && tokens[iter_e].kind == TokenKind::RParen {
    let lp_it = find_open_before(tokens, iter_e, iter_s)
    if lp_it >= iter_s + 2 && tokens[lp_it - 2].kind == TokenKind::Dot && tokens[lp_it - 1].kind == TokenKind::Ident {
      let m = tokens[lp_it - 1].raw
      if !summary.dep_methods.contains(m) {
        let sname = resolve_local_struct_name(tokens, lp_it - 2, body_open, for_i, summary)
        let exact_dk = if sname.length() > 0 && summary.effects.contains(sname + "::" + m) {
          sname + "::" + m
        } else {
          ""
        }
        let cand_keys : Array[String] = if exact_dk.length() > 0 {
          [exact_dk]
        } else {
          match summary.by_name.get(m) {
            Some(ks) => ks
            None => []
          }
        }
        if cand_keys.length() > 0 {
          let mut all_fresh = true
          let mut common_f = ""
          let mut all_same_f = true
          for dk in cand_keys {
            if !summary.fn_ret_fresh_array.contains(dk) {
              all_fresh = false
              match summary.fn_ret_field.get(dk) {
                Some(fnm) =>
                if common_f.length() == 0 { common_f = fnm }
                else if common_f != fnm { all_same_f = false }
                None => all_same_f = false
              }
            }
          }
          if all_fresh {
            return ""
          }
          if all_same_f && common_f.length() > 0 {
            is_field_iter = true
            is_computed_iter = false
            tail = common_f
            root = receiver_root(tokens, lp_it - 3)
          }
        }
      }
    } else if lp_it >= iter_s + 3 && tokens[lp_it - 2].kind == TokenKind::ColonColon && tokens[lp_it - 1].kind == TokenKind::Ident &&
    !(lp_it >= iter_s + 4 && tokens[lp_it - 4].kind == TokenKind::ColonColon) {
      let dk = tokens[lp_it - 3].raw + "::" + tokens[lp_it - 1].raw
      if summary.fn_ret_fresh_array.contains(dk) {
        return ""
      }
      match summary.fn_ret_field.get(dk) {
        Some(fnm) => {
          is_field_iter = true
          is_computed_iter = false
          tail = fnm
          root = first_arg_root(tokens, lp_it + 1, iter_e)
        }
        None => ()
      }
    } else if lp_it == iter_s + 1 && tokens[iter_s].kind == TokenKind::Ident {
      let dk = "::" + tokens[iter_s].raw
      if summary.fn_ret_fresh_array.contains(dk) {
        return ""
      }
      match summary.fn_ret_field.get(dk) {
        Some(fnm) => {
          is_field_iter = true
          is_computed_iter = false
          tail = fnm
          root = first_arg_root(tokens, lp_it + 1, iter_e)
        }
        None => ()
      }
    }
  } else if is_computed_iter && tokens[iter_e].kind == TokenKind::RBracket {
    // Refinement 4: Nested struct array field indexing `for x in self.stages[ti]` (`Array[Array[Inner]]`).
    let lb_it = find_open_before(tokens, iter_e, iter_s)
    if lb_it >= iter_s + 2 && tokens[lb_it - 1].kind == TokenKind::Ident && tokens[lb_it - 2].kind == TokenKind::Dot {
      let fnm = tokens[lb_it - 1].raw
      if summary.nested_array_elem_types.contains(fnm) {
        is_field_iter = true
        is_computed_iter = false
        is_nested_field_iter = true
        tail = fnm
        root = receiver_root(tokens, lb_it - 1)
      }
    }
  }
  let fresh_root = !is_computed_iter && !is_field_iter && root.length() > 0 &&
  fresh_local_binding(tokens, root, body_open, for_i, true) &&
  !name_handed_out(tokens, root, body_open, for_i)
  let iter_field_elem_set : Map[String, Bool] = Map()
  let mut iter_field_elem_unk = false
  if is_field_iter && tail.length() > 0 {
    if is_nested_field_iter {
      match summary.nested_array_elem_types.get(tail) {
        Some(nt) => if nt.length() > 0 { iter_field_elem_set[nt] = true } else { iter_field_elem_unk = true }
        None => iter_field_elem_unk = true
      }
    } else {
      match summary.array_elem_type_sets.get(tail) {
        Some(s) => {
          for t in s.keys() { iter_field_elem_set[t] = true }
        }
        None => ()
      }
      if summary.array_elem_unknown.get(tail) == Some(true) || iter_field_elem_set.length() == 0 {
        iter_field_elem_unk = true
      }
    }
  }
  let names : Map[String, Bool] = if !is_computed_iter && !is_field_iter && root.length() > 0 {
    array_aliases(tokens, root, body_open, body_close)
  } else if !is_computed_iter && is_field_iter && tail.length() > 0 {
    // Collect local aliases of the iterated field (`let ys [: Ty] = (b.items)` or another compatible array field)
    // and their transitive aliases.
    let fa : Map[String, Bool] = Map()
    let mut ai = body_open + 1
    while ai + 3 < body_close {
      if tokens[ai].raw == "let" {
        let mut ni = ai + 1
        if ni < body_close && tokens[ni].raw == "mut" { ni = ni + 1 }
        if ni + 2 < body_close && tokens[ni].kind == TokenKind::Ident {
          let mut eq_i = ni + 1
          let mut td = 0
          while eq_i < body_close {
            let ek = tokens[eq_i].kind
            if td == 0 && ek == TokenKind::Eq { break }
            if td == 0 && (ek == TokenKind::Semi || ek == TokenKind::LBrace || (eq_i > ni + 1 && tokens[eq_i].newline_before)) {
              eq_i = -1
              break
            }
            if ek == TokenKind::LParen || ek == TokenKind::LBracket { td = td + 1 }
            else if ek == TokenKind::RParen || ek == TokenKind::RBracket { td = td - 1 }
            eq_i = eq_i + 1
          }
          if eq_i > ni && eq_i + 1 < body_close && tokens[eq_i].kind == TokenKind::Eq {
            let se = statement_end(tokens, eq_i + 1, body_close)
            let mut rs = eq_i + 1
            let mut re = se - 1
            while rs < re && tokens[rs].kind == TokenKind::LParen && find_matching_delim(tokens, rs) == re {
              rs = rs + 1
              re = re - 1
            }
            let (rhs_is_f, _, rhs_tail) = indexed_field_tail(tokens, re, rs)
            if rhs_is_f && rhs_tail.length() > 0 {
              let rhs_aliases_tail = if rhs_tail == tail {
                true
              } else if summary.distinct_array_fields.contains(rhs_tail) || summary.distinct_array_fields.contains(tail) {
                false
              } else if summary.array_fields.get(rhs_tail) == Some(true) {
                let r_set = match summary.array_elem_type_sets.get(rhs_tail) { Some(s) => s, None => Map() }
                let r_unk = summary.array_elem_unknown.get(rhs_tail) == Some(true)
                elem_sets_may_overlap(iter_field_elem_set, iter_field_elem_unk, r_set, r_unk)
              } else {
                !summary.field_types.contains(rhs_tail)
              }
              if rhs_aliases_tail {
                let alias_nm = tokens[ni].raw
                for an in array_aliases(tokens, alias_nm, body_open, body_close).keys() {
                  fa[an] = true
                }
              }
            }
          }
        }
      }
      ai = ai + 1
    }
    fa
  } else {
    Map()
  }
  // Collect parameter names of the enclosing function whose type is `Array[..]` (potential aliases of a param array).
  let arr_params : Map[String, Bool] = Map()
  let fs = fn_start_of(tokens, body_open)
  if fs >= 0 {
    let mut pk = fs + 1
    let mut paren_d = 0
    let mut brack_d = 0
    while pk + 2 < body_open {
      let pkk = tokens[pk].kind
      if pkk == TokenKind::LParen { paren_d = paren_d + 1 }
      else if pkk == TokenKind::RParen { paren_d = paren_d - 1 }
      else if pkk == TokenKind::LBracket { brack_d = brack_d + 1 }
      else if pkk == TokenKind::RBracket { brack_d = brack_d - 1 }
      else if paren_d == 1 && brack_d == 0 && pkk == TokenKind::Ident && tokens[pk + 1].kind == TokenKind::Colon {
        if tokens[pk + 2].raw == "Array" {
          arr_params[tokens[pk].raw] = true
        }
      }
      pk = pk + 1
    }
  }
  let fresh_before = fresh_locals_before(tokens, body_open, loop_open)
  let callables = callable_locals(tokens, body_open)
  let flags = [false, false]
  let why = for_in_body_hazard(tokens, loop_open + 1, loop_close, loop_open, body_open, root, tail, is_field_iter, is_nested_field_iter, is_computed_iter, fresh_root, names, arr_params, fresh_before, callables, summary, flags, 0)
  if why.length() > 0 {
    return why
  }
  appends_and_writes(flags)
}

fn for_in_body_hazard(
  tokens : Array[Token],
  s : Int,
  e : Int,
  loop_open : Int,
  body_open : Int,
  root : String,
  tail : String,
  is_field_iter : Bool,
  is_nested_field_iter : Bool,
  is_computed_iter : Bool,
  fresh_root : Bool,
  names : Map[String, Bool],
  arr_params : Map[String, Bool],
  fresh_before : Map[String, Bool],
  callables : Map[String, Bool],
  summary : CapPkgSummary,
  flags : Array[Bool],
  depth : Int,
) -> String {
  let can_exit = fn(pos : Int) -> Bool {
    if depth > 0 || loop_open < 0 {
      return false
    }
    let blk_open = enclosing_open(tokens, pos, loop_open, TokenKind::LBrace)
    let blk_close = if blk_open >= 0 { find_matching_delim(tokens, blk_open) } else { e }
    stmt_immediately_exits_loop(tokens, pos, loop_open, blk_close)
  }
  let is_global_iter = !fresh_root && !is_field_iter && root.length() > 0 && summary.pkg_globals.contains(root)
  let is_local_fresh_recv = fn(r : String, r_is_field : Bool, pos : Int) -> Bool {
    !r_is_field && r.length() > 0 && r != root && !names.contains(r) && body_open >= 0 &&
    fresh_local_binding(tokens, r, body_open, pos, true) && !name_handed_out(tokens, r, body_open, pos)
  }
  let iter_elem_set : Map[String, Bool] = Map()
  let mut iter_elem_unk = false
  if is_field_iter && tail.length() > 0 {
    if is_nested_field_iter {
      match summary.nested_array_elem_types.get(tail) {
        Some(nt) => if nt.length() > 0 { iter_elem_set[nt] = true } else { iter_elem_unk = true }
        None => iter_elem_unk = true
      }
    } else {
      match summary.array_elem_type_sets.get(tail) {
        Some(ms) => {
          for t in ms.keys() { iter_elem_set[t] = true }
        }
        None => ()
      }
      if summary.array_elem_unknown.get(tail) == Some(true) || iter_elem_set.length() == 0 {
        iter_elem_unk = true
      }
    }
  } else if !is_field_iter && root.length() > 0 && body_open >= 0 {
    let rty = resolve_local_type_name(tokens, root, body_open, loop_open, summary)
    if rty.starts_with("Array:") {
      iter_elem_set[rty.slice(6, rty.length())] = true
    } else {
      iter_elem_unk = true
    }
  } else {
    iter_elem_unk = true
  }
  let other_field_can_alias = fn(f : String) -> Bool {
    if f == tail {
      true
    } else if summary.distinct_array_fields.contains(f) || (is_field_iter && summary.distinct_array_fields.contains(tail)) {
      false
    } else if summary.array_fields.get(f) == Some(true) {
      let f_set = match summary.array_elem_type_sets.get(f) { Some(ms) => ms, None => Map() }
      let f_unk = summary.array_elem_unknown.get(f) == Some(true)
      elem_sets_may_overlap(iter_elem_set, iter_elem_unk, f_set, f_unk)
    } else if !summary.field_types.contains(f) {
      // Field not declared in this package (e.g. foreign `dep::Box.items`) -> conservatively may alias.
      true
    } else {
      false
    }
  }
  let may_alias_target = fn(r : String, r_tail : String, r_is_field : Bool, pos : Int) -> Bool {
    if is_computed_iter {
      !is_local_fresh_recv(r, r_is_field, pos)
    } else if fresh_root {
      !r_is_field && names.contains(r)
    } else if is_local_fresh_recv(r, r_is_field, pos) {
      false
    } else if is_field_iter {
      let param_can_alias = if !r_is_field && arr_params.contains(r) && !fresh_before.contains(r) {
        if summary.distinct_array_fields.contains(tail) {
          false
        } else {
          let rty = if body_open >= 0 { resolve_local_type_name(tokens, r, body_open, pos, summary) } else { "" }
          let re = if rty.starts_with("Array:") { rty.slice(6, rty.length()) } else { "" }
          if re.length() > 0 && !iter_elem_unk && iter_elem_set.length() > 0 {
            iter_elem_set.contains(re)
          } else {
            true
          }
        }
      } else {
        false
      }
      (r_is_field && other_field_can_alias(r_tail)) || (!r_is_field && names.contains(r)) || param_can_alias
    } else {
      let field_can_alias = r_is_field && other_field_can_alias(r_tail)
      (!r_is_field && (names.contains(r) || (arr_params.contains(r) && !fresh_before.contains(r)))) || field_can_alias
    }
  }
  let check_pkg_effect = fn(ef : CapFnEffect, pass_kind : Int, arg_open : Int, arg_close : Int, is_method_call : Bool, recv_is_root : Bool, pos : Int, label : String) -> String {
    // pass_kind: 2 = iterated Array itself passed/received; 1 = owner struct of `root.tail` passed/received; 0 = neither
    if pass_kind == 2 {
      if (ef.may_shrink_or_shift || ef.may_shrink_to_fit || ef.may_call_opaque || ef.may_pass_param_to_dep) && !can_exit(pos) {
        return label + " may mutate the array during `for .. in`"
      }
      if ef.may_grow { flags[0] = true }
      if ef.may_write { flags[1] = true }
    } else if pass_kind == 1 {
      if is_field_iter && tail.length() > 0 {
        // Check if `root` is passed at a parameter position that `ef` passes to a cross-package `dep::f(param)`.
        let mut root_escapes_to_dep = false
        if ef.may_pass_param_to_dep {
          if is_method_call && recv_is_root && ef.dep_escaped_params.contains(0) {
            root_escapes_to_dep = true
          }
          if !root_escapes_to_dep && arg_open >= 0 && arg_close > arg_open {
            let mut ai = arg_open + 1
            let mut ad = 0
            let mut arg_ord = if is_method_call { 1 } else { 0 }
            while ai < arg_close {
              let ak = tokens[ai].kind
              if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
              else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
              else if ad == 0 && ak == TokenKind::Comma { arg_ord = arg_ord + 1 }
              else if ad == 0 && ak == TokenKind::Ident && tokens[ai].raw == root &&
              !(ai > 0 && (tokens[ai - 1].kind == TokenKind::Dot || tokens[ai - 1].kind == TokenKind::ColonColon)) &&
              !(ai + 1 < arg_close && tokens[ai + 1].kind == TokenKind::Dot) {
                if ef.dep_escaped_params.contains(arg_ord) {
                  root_escapes_to_dep = true
                  break
                }
              }
              ai = ai + 1
            }
          }
        }
        if (ef.mutated_fields.contains(tail) || root_escapes_to_dep) && !can_exit(pos) {
          return label + " may mutate field `." + tail + "` during `for .. in`"
        }
        if ef.grew_fields.contains(tail) { flags[0] = true }
        if ef.wrote_fields.contains(tail) { flags[1] = true }
      }
    } else {
      if is_global_iter && ef.mutated_globals.contains(root) && !can_exit(pos) {
        return label + " mutates global `" + root + "` during `for .. in`"
      }
      if is_field_iter && tail.length() > 0 {
        if ef.mutated_fields.contains(tail) && !can_exit(pos) {
          return label + " mutates field `." + tail + "` during `for .. in`"
        }
        if ef.grew_fields.contains(tail) { flags[0] = true }
        if ef.wrote_fields.contains(tail) { flags[1] = true }
      }
    }
    ""
  }
  let args_pass_kind = fn(as_ : Int, ae_ : Int) -> Int {
    if ae_ <= as_ {
      return 0
    }
    if is_computed_iter {
      // Computed iterable (`ident(xs)` / `bag[0]`): any non-literal argument may pass the array or its owner.
      let mut ai = as_
      while ai < ae_ {
        let ak = tokens[ai].kind
        if (ak == TokenKind::Ident || tokens[ai].raw == "self") && !is_local_fresh_recv(tokens[ai].raw, false, ai) {
          return 2
        }
        ai = ai + 1
      }
      return 0
    }
    if is_field_iter {
      span_passes_owner_or_field(tokens, as_, ae_, root, tail)
    } else if span_mentions(tokens, as_, ae_, names) {
      2
    } else {
      0
    }
  }
  let mut k = s
  while k < e {
    let tk = tokens[k]
    let kk = tk.kind
    // Interpolation holes run code too
    if kk == TokenKind::InterpString || kk == TokenKind::InterpMultiline || kk == TokenKind::StringLit {
      for sub in interp_holes(tk.raw) {
        let why = for_in_body_hazard(sub, 0, sub.length() - 1, -1, 0, root, tail, is_field_iter, is_nested_field_iter, is_computed_iter, fresh_root, names, arr_params, fresh_before, callables, summary, flags, depth + 1)
        if why.length() > 0 {
          return why + " (in a string interpolation)"
        }
      }
    }
    // Custom `impl Eq` on `==` / `!=` for non-local/escaped arrays (per-type impure Eq tracking + dep Eq)
    if !fresh_root && (summary.dep_has_custom_eq || (summary.local_has_custom_eq && summary.impure_eq_types.length() > 0)) &&
    (kk == TokenKind::EqEq || tk.raw == "!=") {
      let lhs_pure = k > s && eq_operand_is_pure(tokens, k - 1, body_open, k, summary, true)
      let rhs_pure = k + 1 < e && eq_operand_is_pure(tokens, k + 1, body_open, k, summary, false)
      if !(lhs_pure || rhs_pure) && !can_exit(k) {
        return "`" + tk.raw + "` may invoke a custom `impl Eq` that mutates the array during `for .. in`"
      }
    }
    // Indirect call `(...)(...)` or `arr[i](...)` passing the iterated array or its owner
    if (kk == TokenKind::RParen || kk == TokenKind::RBracket) && k + 1 < e &&
    tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before {
      let cp_i = find_matching_delim(tokens, k + 1)
      let passes_iter = args_pass_kind(k + 2, cp_i) > 0
      if passes_iter {
        let mut safe_field_call = false
        if kk == TokenKind::RParen {
          let op = find_open_before(tokens, k, s)
          if op >= s && k - op >= 3 && tokens[k - 1].kind == TokenKind::Ident &&
          tokens[k - 2].kind == TokenKind::Dot {
            let sname = resolve_local_struct_name(tokens, k - 2, body_open, k, summary)
            if sname.length() > 0 && summary.safe_closure_fields.contains(sname + "." + tokens[k - 1].raw) {
              safe_field_call = true
            }
          }
        }
        if !safe_field_call && !can_exit(k) {
          return "an indirect call given the iterated array may mutate it during `for .. in`"
        }
      }
    }
    // Check method call `<recv>.m(...)`
    if kk == TokenKind::Dot && k + 2 < e && tokens[k + 1].kind == TokenKind::Ident &&
    tokens[k + 2].kind == TokenKind::LParen {
      let m = tokens[k + 1].raw
      let (recv_is_field, recv_r, recv_tail) = indexed_field_tail(tokens, k - 1, s)
      let may_alias = may_alias_target(recv_r, recv_tail, recv_is_field, k)
      if may_alias {
        if is_cap_arr_shrink_or_shift_method(m) || m == "shrink_to_fit" {
          if !can_exit(k) {
            return "`." + m + "(..)` mutates the array during `for .. in` (MoonBit snapshots `(buf, init_len)`)"
          }
        } else if is_cap_arr_growth_method(m) {
          flags[0] = true
        } else if is_cap_arr_write_method(m) {
          flags[1] = true
        }
      }
      let cp_m = find_matching_delim(tokens, k + 2)
      let apk = args_pass_kind(k + 3, cp_m)
      let recv_is_root = !recv_is_field && recv_r == root
      let pass_kind = if may_alias || apk == 2 {
        2
      } else if (is_field_iter && recv_is_root) || apk == 1 {
        1
      } else {
        0
      }
      let recv_is_builtin_arr_or_val = (recv_is_field && summary.array_fields.get(recv_tail) == Some(true)) ||
      (!recv_is_field && recv_r.length() > 0 && body_open >= 0 &&
        (fresh_local_binding(tokens, recv_r, body_open, k, false) ||
          resolve_local_type_name(tokens, recv_r, body_open, k, summary).starts_with("Array:"))) ||
      (body_open >= 0 && receiver_is_builtin(tokens, k - 1, body_open, k, summary.sort_env))
      let recv_proven_disjoint_builtin = !may_alias && is_builtin_first_order_method(m) && apk == 0 &&
      (!summary.by_name.contains(m) || recv_is_builtin_arr_or_val)
      if !recv_proven_disjoint_builtin {
        match summary.by_name.get(m) {
          Some(keys) => {
            for dk in keys {
              match summary.effects.get(dk) {
                Some(ef) => {
                  let why = check_pkg_effect(ef, pass_kind, k + 2, cp_m, true, recv_is_root, k, "`." + m + "(..)`")
                  if why.length() > 0 { return why }
                }
                None => ()
              }
            }
          }
          None =>
          if summary.dep_methods.contains(m) {
            let inline_iter_pred = !may_alias && (m == "any" || m == "all" || m == "find_first") &&
            cp_m > k + 3 && tokens[k + 3].raw == "fn"
            let handled_arr_builtin = is_read_only_array_method(m) || is_cap_arr_growth_method(m) ||
            is_cap_arr_write_method(m) || is_cap_arr_shrink_or_shift_method(m) || m == "shrink_to_fit"
            if pass_kind > 0 && !inline_iter_pred && !(handled_arr_builtin && recv_is_builtin_arr_or_val) && !can_exit(k) {
              return "dependency method `." + m + "(..)` may mutate the array during `for .. in`"
            }
          }
        }
      }
    }
    // Check index write `<recv>[i] = v`
    if kk == TokenKind::RBracket && k + 1 < e &&
    (tokens[k + 1].kind == TokenKind::Eq || tokens[k + 1].kind == TokenKind::AssignOp) {
      let lb = find_open_before(tokens, k, s)
      let (wr_is_field, wr_r, wr_tail) = if lb > s { indexed_field_tail(tokens, lb - 1, s) } else { (false, "", "") }
      let may_alias = may_alias_target(wr_r, wr_tail, wr_is_field, lb)
      if may_alias {
        flags[1] = true
      }
    }
    // Check qualified calls `mbt_compat::*`, `Type::method(...)`, and cross-package `dep::f(...)`
    if kk == TokenKind::Ident && k >= 2 && tokens[k - 1].kind == TokenKind::ColonColon &&
    k + 1 < e && tokens[k + 1].kind == TokenKind::LParen && !tokens[k + 1].newline_before {
      let q = tokens[k - 2].raw
      let cp = find_matching_delim(tokens, k + 1)
      if q == "mbt_compat" {
        let mut a0_end = k + 2
        let mut ad = 0
        while a0_end < cp {
          let ak = tokens[a0_end].kind
          if ak == TokenKind::LParen || ak == TokenKind::LBracket || ak == TokenKind::LBrace { ad = ad + 1 }
          else if ak == TokenKind::RParen || ak == TokenKind::RBracket || ak == TokenKind::RBrace { ad = ad - 1 }
          else if ad == 0 && ak == TokenKind::Comma { break }
          a0_end = a0_end + 1
        }
        let mut a0_s = k + 2
        let mut a0_e = a0_end - 1
        while a0_s < a0_e && tokens[a0_s].kind == TokenKind::LParen &&
        find_matching_delim(tokens, a0_s) == a0_e {
          a0_s = a0_s + 1
          a0_e = a0_e - 1
        }
        let (arg0_is_field, arg0_r, arg0_tail) = if a0_e >= a0_s { indexed_field_tail(tokens, a0_e, a0_s) } else { (false, "", "") }
        let may_alias = may_alias_target(arg0_r, arg0_tail, arg0_is_field, k)
        if may_alias {
          if is_cap_compat_shrink_or_shift_fn(tk.raw) || tk.raw == "arr_shrink_to_fit" {
            if !can_exit(k) {
              return "`mbt_compat::" + tk.raw + "(..)` mutates the array during `for .. in`"
            }
          } else if is_cap_compat_growth_fn(tk.raw) {
            flags[0] = true
          } else if is_cap_compat_write_fn(tk.raw) {
            flags[1] = true
          }
        }
      } else if is_ctor_name(tk.raw) || is_builtin_type_qualifier(q) {
        ()
      } else {
        let pk = args_pass_kind(k + 2, cp)
        if k >= 3 && tokens[k - 3].kind == TokenKind::ColonColon {
          if pk > 0 && !can_exit(k) {
            return "cross-package call `" + q + "::" + tk.raw + "(..)` may mutate the array during `for .. in`"
          }
        } else {
          match summary.effects.get(q + "::" + tk.raw) {
            Some(ef) => {
              let why = check_pkg_effect(ef, pk, k + 1, cp, false, false, k, "call to `" + q + "::" + tk.raw + "(..)`")
              if why.length() > 0 { return why }
            }
            None =>
            if pk > 0 && !can_exit(k) {
              return "cross-package call `" + q + "::" + tk.raw + "(..)` may mutate the array during `for .. in`"
            }
          }
        }
      }
    }
    // Check local closure call, opaque closure call (passing array/owner), or package free function call
    if kk == TokenKind::Ident && k + 1 < e && tokens[k + 1].kind == TokenKind::LParen &&
    !tokens[k + 1].newline_before && !is_call_keyword(tk.raw) && !(k > 0 && (tokens[k - 1].kind == TokenKind::Dot ||
      tokens[k - 1].kind == TokenKind::ColonColon || tokens[k - 1].raw == "fn")) {
      let cp = find_matching_delim(tokens, k + 1)
      let pk = args_pass_kind(k + 2, cp)
      let lb = if body_open >= 0 { local_closure_body(tokens, k, tk.raw) } else { -1 }
      if lb >= 0 && depth < 8 && !(lb < k && k < find_matching_delim(tokens, lb)) {
        let why = for_in_body_hazard(tokens, lb + 1, find_matching_delim(tokens, lb), loop_open, body_open, root, tail, is_field_iter, is_nested_field_iter, is_computed_iter, fresh_root, names, arr_params, fresh_before, callables, summary, flags, depth + 1)
        if why.length() > 0 {
          return why + " (through `" + tk.raw + "`)"
        }
      } else if callables.contains(tk.raw) {
        if pk > 0 && !can_exit(k) {
          return "opaque closure call `" + tk.raw + "(..)` given the iterated array may mutate it during `for .. in`"
        }
      } else if is_ctor_name(tk.raw) || is_pure_builtin_free_fn(tk.raw) {
        ()
      } else {
        match summary.effects.get("::" + tk.raw) {
          Some(ef) => {
            let why = check_pkg_effect(ef, pk, k + 1, cp, false, false, k, "call to `" + tk.raw + "(..)`")
            if why.length() > 0 { return why }
          }
          None =>
          if pk > 0 && !can_exit(k) {
            return "unknown call `" + tk.raw + "(..)` may mutate the array during `for .. in`"
          }
        }
      }
    }
    k = k + 1
  }
  ""
}
