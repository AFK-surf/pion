///| Generic C-ABI FFI lowering for opt-in Pion `(ptr, len)` C shims.
///|
///| C-ABI contract:
///| - Intended strictly for explicit opt-in Pion `(ptr, len)` C shims (does NOT auto-rewrite
///|   standard MoonBit `moonbit_string_t` / `moonbit_bytes_t` `extern "C" fn` declarations).
///| - Direct scalar/pointer C-ABI declarations (`Int`, `Int64`, `UInt`, `UInt64`,
///|   `Byte`, `Int8`, `Bool`, `Double`, `Float`, `Float32`, `Ptr`, `Unit`) pass through with zero wrapper overhead.
///| - Bridged C-ABI declarations using explicit `#borrow(...)` attributes
///|   and `String` / `Bytes` parameters or return types:
///|   - `String` param (must be in `#borrow`) -> C prototype `(const char *ptr, int32_t len)` via `s.as_cstr(), s.to_bytes().length()`
///|   - `Bytes` param (must be in `#borrow`) -> C prototype `(const uint8_t *ptr, int32_t len)` via `mbt_compat::mbt_ffi_ptr_alloc` + `mbt_compat::mbt_ffi_bytes_copy_to_ptr` + `mbt_compat::mbt_ffi_ptr_free`
///|     - Copy-in only: C shims must treat the temporary buffer as read-only input; mutations
///|       made in C are NOT written back to the caller's `Bytes` value, and passing the same
///|       `Bytes` value to two parameters allocates independent temporary buffers (no pointer aliasing guarantee).
///|   - `String` return -> C return `const char *` (borrowed/static, not auto-freed), converted via `if mbt_compat::mbt_ffi_ptr_is_null(p) { "" } else { mbt_compat::mbt_ffi_cstr_to_str(p) }`
///|     - NUL-terminated C string domain: conversion stops at the first NUL byte (`'\0'`);
///|       strings containing embedded NUL bytes cannot be returned through `String` (use `Bytes` return instead).
///|   - `Bytes` return -> trailing C parameter `int32_t *out_len` + C return `const uint8_t *` (borrowed/static, not auto-freed), converted via `if mbt_compat::mbt_ffi_ptr_is_null(p) || n <= 0 { "".to_bytes() } else { mbt_compat::mbt_ffi_bytes_from_ptr(p, n) }`
///| - Fail-closed rejection (`ok: false`) for `#owned(...)`, unannotated `String`/`Bytes` params,
///|   unknown FFI attributes, malformed return annotations, invalid/duplicate parameter names,
///|   invalid `#borrow` parameter references, or unsupported non-C-ABI types.

pub enum FfiParamKind {
  Direct
  Str
  Bytes
}

pub enum FfiRetKind {
  Unit
  Direct
  Str
  Bytes
}

pub struct FfiParamSpec {
  name : String
  ty : String
  kind : FfiParamKind
}

pub struct FfiAttrInfo {
  borrowed : Map[String, Bool]
  owned : Map[String, Bool]
}

pub struct FfiLowerResult {
  ok : Bool
  needs_bridge : Bool
  code : String
  c_symbol : String
  emitted_pion_fn : String
  error_msg : String
}

///| Single source of truth for Pion direct scalar/pointer C-ABI types.
pub fn is_pion_c_abi_scalar_type(ty : String) -> Bool {
  let t = ty.trim()
  t == "Int" || t == "Int64" || t == "UInt" || t == "UInt64" ||
  t == "Byte" || t == "Int8" || t == "Bool" || t == "Double" ||
  t == "Float" || t == "Float32" || t == "Ptr"
}

///| Classify a Pion parameter type for C-ABI FFI lowering.
pub fn classify_ffi_param_type(ty : String) -> Option[FfiParamKind] {
  let t = ty.trim()
  if is_pion_c_abi_scalar_type(t) {
    Some(FfiParamKind::Direct)
  } else if t == "String" {
    Some(FfiParamKind::Str)
  } else if t == "Bytes" {
    Some(FfiParamKind::Bytes)
  } else {
    None
  }
}

///| Classify a Pion return type for C-ABI FFI lowering.
pub fn classify_ffi_ret_type(ty : String) -> Option[FfiRetKind] {
  let t = ty.trim()
  if t.length() == 0 || t == "Unit" {
    Some(FfiRetKind::Unit)
  } else if is_pion_c_abi_scalar_type(t) {
    Some(FfiRetKind::Direct)
  } else if t == "String" {
    Some(FfiRetKind::Str)
  } else if t == "Bytes" {
    Some(FfiRetKind::Bytes)
  } else {
    None
  }
}

///| Parse `#borrow(a, b)` FFI attributes into validated parameter sets.
///| Rejects `#owned(...)`, unknown attributes, malformed syntax, or empty lists fail-closed.
pub fn parse_ffi_attr_params(attrs : Array[String]) -> Result[FfiAttrInfo, String] {
  let borrowed : Map[String, Bool] = Map()
  let owned : Map[String, Bool] = Map()
  for raw in attrs {
    let s = raw.trim()
    if s.starts_with("#owned(") && s.ends_with(")") {
      return Err("unsupported MoonBit FFI `#owned` attribute (only `#borrow` is supported for C-ABI bridging)")
    }
    let is_borrow = s.starts_with("#borrow(") && s.ends_with(")")
    if !is_borrow {
      return Err("unsupported MoonBit FFI attribute `" + s + "`")
    }
    let inner = s.slice(8, s.length() - 1).trim()
    if inner.length() == 0 {
      return Err("empty parameter list in FFI attribute `" + s + "`")
    }
    let parts = inner.split(",")
    for part in parts {
      let pname = part.trim()
      if pname.length() == 0 {
        return Err("malformed parameter list in FFI attribute `" + s + "`")
      }
      borrowed[pname] = true
    }
  }
  Ok(FfiAttrInfo::{ borrowed, owned })
}

pub fn is_valid_ffi_ident(name : String) -> Bool {
  let n = name.length()
  if n == 0 {
    return false
  }
  let c0 = name.code_unit_at(0)
  if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122) || c0 == 95) {
    return false
  }
  let mut i = 1
  while i < n {
    let c = name.code_unit_at(i)
    if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95) {
      return false
    }
    i = i + 1
  }
  true
}

///| Decode a Pion double-quoted string literal strictly matching `compiler/src/core/lexer.pion`:
///| special escapes are `\n`, `\r`, `\t`, `\\`, `\"`, `\0`, `\xHH`, and `\u{H...}`;
///| `\{` (interpolation) and malformed `\x`/`\u` return `Err`; any other `\c` decodes to literal `c`.
pub fn decode_pion_string_lit(raw : String) -> Result[String, String] {
  let n = raw.length()
  if n < 2 || raw.code_unit_at(0) != 34 || raw.code_unit_at(n - 1) != 34 {
    return Err("unterminated string literal")
  }
  let sb = StringBuilder()
  let end = n - 1
  let mut i = 1
  while i < end {
    let b = raw.code_unit_at(i)
    if b != 92 {
      sb.write_byte(b.to_byte())
      i = i + 1
      continue
    }
    i = i + 1
    if i >= end {
      return Err("truncated escape sequence in string literal")
    }
    let esc = raw.code_unit_at(i)
    if esc == 110 {
      sb.write_byte(10.to_byte())
      i = i + 1
    } else if esc == 114 {
      sb.write_byte(13.to_byte())
      i = i + 1
    } else if esc == 116 {
      sb.write_byte(9.to_byte())
      i = i + 1
    } else if esc == 92 {
      sb.write_byte(92.to_byte())
      i = i + 1
    } else if esc == 34 {
      sb.write_byte(34.to_byte())
      i = i + 1
    } else if esc == 48 {
      sb.write_byte(0.to_byte())
      i = i + 1
    } else if esc == 123 {
      return Err("string interpolation `\\{` is not allowed in extern string literal")
    } else if esc == 120 {
      if i + 2 >= end {
        return Err("truncated \\xHH escape in string literal")
      }
      let h1 = hex_digit_val(raw.code_unit_at(i + 1))
      let h2 = hex_digit_val(raw.code_unit_at(i + 2))
      if h1 < 0 || h2 < 0 {
        return Err("invalid hex digit in \\xHH escape")
      }
      let bv = (h1 << 4) | h2
      if bv < 128 {
        sb.write_byte(bv.to_byte())
      } else {
        sb_write_utf8_cp(sb, 57344 + bv)
      }
      i = i + 3
    } else if esc == 117 {
      if i + 1 >= end || raw.code_unit_at(i + 1) != 123 {
        return Err("invalid \\u escape in Pion string literal (expected \\u{H...})")
      }
      let mut j = i + 2
      let mut cp = 0
      let mut digits = 0
      while j < end && raw.code_unit_at(j) != 125 {
        let hv = hex_digit_val(raw.code_unit_at(j))
        if hv < 0 {
          return Err("invalid hex digit in \\u{...} escape")
        }
        digits = digits + 1
        if digits > 6 {
          return Err("overlong \\u{...} escape")
        }
        cp = (cp << 4) | hv
        j = j + 1
      }
      if j >= end || raw.code_unit_at(j) != 125 || digits == 0 {
        return Err("malformed \\u{...} escape in string literal")
      }
      if cp > 1114111 || (cp >= 55296 && cp <= 57343) {
        return Err("invalid Unicode scalar in \\u{...} escape")
      }
      sb_write_utf8_cp(sb, cp)
      i = j + 1
    } else {
      // Matches `compiler/src/core/lexer.pion`: unknown `\c` decodes to literal `c`.
      sb.write_byte(esc.to_byte())
      i = i + 1
    }
  }
  Ok(sb.to_string())
}

///| Validate a C identifier prefix for `--ffi-shim-prefix` (`[A-Za-z_][A-Za-z0-9_]*`).
pub fn is_valid_ffi_shim_prefix(prefix : String) -> Bool {
  is_valid_ffi_ident(prefix)
}

///| Parse a Pion parameter list string `a : T1, b : T2` into `Array[FfiParamSpec]`.
///| Validates ASCII identifier names and rejects duplicate parameter names fail-closed.
pub fn parse_ffi_params(p_str : String) -> Result[Array[FfiParamSpec], String] {
  let out : Array[FfiParamSpec] = []
  let seen_names : Map[String, Bool] = Map()
  let s = p_str.trim()
  if s.length() == 0 {
    return Ok(out)
  }
  let mut start = 0
  let mut depth = 0
  let mut i = 0
  while i <= s.length() {
    let at_end = i == s.length()
    let c = if at_end { 44 } else { s.code_unit_at(i) }
    if !at_end && (c == 40 || c == 91 || c == 123) {
      depth = depth + 1
    } else if !at_end && (c == 41 || c == 93 || c == 125) {
      if depth > 0 { depth = depth - 1 }
    } else if depth == 0 && c == 44 {
      let part = s.slice(start, i).trim()
      if part.length() > 0 {
        let ci = part.index_of(":")
        if ci <= 0 {
          return Err("FFI parameter `" + part + "` requires explicit `name : Type` annotation")
        }
        let raw_name = part.slice(0, ci).trim()
        if !is_valid_ffi_ident(raw_name) {
          return Err("invalid FFI parameter name `" + raw_name + "`")
        }
        if seen_names.contains(raw_name) {
          return Err("duplicate FFI parameter name `" + raw_name + "`")
        }
        seen_names[raw_name] = true
        let raw_ty = part.slice(ci + 1, part.length()).trim()
        match classify_ffi_param_type(raw_ty) {
          Some(kind) => out.push(FfiParamSpec::{ name: raw_name, ty: raw_ty, kind })
          None => return Err("unsupported FFI parameter type `" + raw_ty + "` on parameter `" + raw_name + "`")
        }
      }
      start = i + 1
    }
    i = i + 1
  }
  Ok(out)
}

fn ffi_fresh_ident(used : Map[String, Bool], base : String) -> String {
  if !used.contains(base) {
    used[base] = true
    return base
  }
  let mut k = 1
  while true {
    let cand = base + "_" + k.to_string()
    if !used.contains(cand) {
      used[cand] = true
      return cand
    }
    k = k + 1
  }
  base
}

///| Lower a MoonBit `extern "C" fn` declaration (optionally with `#borrow(...)` attributes
///| and `String`/`Bytes` parameters or return types) into valid Pion C-ABI declarations + wrapper.
///| Bridged declarations bind an explicit adapted C shim symbol (`"pion_<raw_sym>"` by default)
///| so they never silently collide with an unadapted MoonBit C stub of different arity/ABI.
pub fn try_lower_extern_c_fn(
  vis : String,
  fn_name : String,
  p_str : String,
  ret_str : String,
  c_sym_lit : String,
  pending_ffi_attrs : Array[String],
  used_idents : Map[String, Bool],
) -> FfiLowerResult {
  try_lower_extern_c_fn_with_prefix(
    vis,
    fn_name,
    p_str,
    ret_str,
    c_sym_lit,
    pending_ffi_attrs,
    used_idents,
    "pion_",
  )
}

///| Configurable-prefix variant of `try_lower_extern_c_fn`. `shim_prefix` must be non-empty
///| whenever `needs_bridge` is true so bridged `(ptr, len)` externs never alias raw MoonBit C stubs.
pub fn try_lower_extern_c_fn_with_prefix(
  vis : String,
  fn_name : String,
  p_str : String,
  ret_str : String,
  c_sym_lit : String,
  pending_ffi_attrs : Array[String],
  used_idents : Map[String, Bool],
  shim_prefix : String,
) -> FfiLowerResult {
  let sym_trimmed = c_sym_lit.trim()
  if sym_trimmed.length() < 3 || !sym_trimmed.starts_with("\"") || !sym_trimmed.ends_with("\"") {
    return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: "FFI C symbol must be a non-empty double-quoted string literal, got `" + c_sym_lit + "`",
    }
  }
  let raw_sym = sym_trimmed.slice(1, sym_trimmed.length() - 1)
  if !is_valid_ffi_ident(raw_sym) {
    return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: "FFI C symbol `" + raw_sym + "` must be a valid C identifier (`[A-Za-z_][A-Za-z0-9_]*`)",
    }
  }
  let attr_info = match parse_ffi_attr_params(pending_ffi_attrs) {
    Ok(info) => info
    Err(msg) => return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: msg,
    }
  }
  let params = match parse_ffi_params(p_str) {
    Ok(ps) => ps
    Err(msg) => return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: msg,
    }
  }
  let rt = ret_str.trim()
  let ret_ty = if rt.length() == 0 {
    "Unit"
  } else if rt.starts_with("->") {
    let rest = rt.slice(2, rt.length()).trim()
    if rest.length() == 0 {
      return FfiLowerResult::{
        ok: false,
        needs_bridge: false,
        code: "",
        c_symbol: c_sym_lit,
        emitted_pion_fn: "",
        error_msg: "malformed FFI return type annotation `" + ret_str + "` on `" + fn_name + "`",
      }
    }
    rest
  } else {
    return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: "malformed FFI return type annotation `" + ret_str + "` on `" + fn_name + "`",
    }
  }
  let ret_kind = match classify_ffi_ret_type(ret_ty) {
    Some(rk) => rk
    None => return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: c_sym_lit,
      emitted_pion_fn: "",
      error_msg: "unsupported FFI return type `" + ret_ty + "` on `" + fn_name + "`",
    }
  }
  // Validate that every `String`/`Bytes` parameter is explicitly listed in `#borrow(...)`
  // (unannotated MoonBit FFI params default to owned and must fail closed).
  let param_kinds : Map[String, FfiParamKind] = Map()
  let mut needs_bridge = false
  for p in params {
    param_kinds[p.name] = p.kind
    match p.kind {
      FfiParamKind::Direct => ()
      FfiParamKind::Str | FfiParamKind::Bytes => {
        needs_bridge = true
        if !attr_info.borrowed.contains(p.name) {
          return FfiLowerResult::{
            ok: false,
            needs_bridge: false,
            code: "",
            c_symbol: c_sym_lit,
            emitted_pion_fn: "",
            error_msg: "FFI parameter `" + p.name + "` of type `" + p.ty + "` must be explicitly listed in `#borrow(...)`",
          }
        }
      }
    }
  }
  match ret_kind {
    FfiRetKind::Unit | FfiRetKind::Direct => ()
    FfiRetKind::Str | FfiRetKind::Bytes => needs_bridge = true
  }
  for bname in attr_info.borrowed.keys() {
    match param_kinds.get(bname) {
      Some(FfiParamKind::Str) | Some(FfiParamKind::Bytes) => ()
      Some(FfiParamKind::Direct) => return FfiLowerResult::{
        ok: false,
        needs_bridge: false,
        code: "",
        c_symbol: c_sym_lit,
        emitted_pion_fn: "",
        error_msg: "`#borrow(" + bname + ")` is only valid on `String` or `Bytes` parameters",
      }
      None => return FfiLowerResult::{
        ok: false,
        needs_bridge: false,
        code: "",
        c_symbol: c_sym_lit,
        emitted_pion_fn: "",
        error_msg: "`#borrow(" + bname + ")` references unknown parameter `" + bname + "`",
      }
    }
  }
  for oname in attr_info.owned.keys() {
    match param_kinds.get(oname) {
      Some(FfiParamKind::Str) | Some(FfiParamKind::Bytes) => ()
      Some(FfiParamKind::Direct) => return FfiLowerResult::{
        ok: false,
        needs_bridge: false,
        code: "",
        c_symbol: c_sym_lit,
        emitted_pion_fn: "",
        error_msg: "`#owned(" + oname + ")` is only valid on `String` or `Bytes` parameters",
      }
      None => return FfiLowerResult::{
        ok: false,
        needs_bridge: false,
        code: "",
        c_symbol: c_sym_lit,
        emitted_pion_fn: "",
        error_msg: "`#owned(" + oname + ")` references unknown parameter `" + oname + "`",
      }
    }
  }
  if !needs_bridge {
    let decoded_sym_lit = "\"" + raw_sym + "\""
    let direct_code = vis + "extern \"C\" fn " + fn_name + "(" + p_str + ")" + ret_str + " = " + decoded_sym_lit
    return FfiLowerResult::{
      ok: true,
      needs_bridge: false,
      code: direct_code,
      c_symbol: decoded_sym_lit,
      emitted_pion_fn: fn_name,
      error_msg: "",
    }
  }
  if !is_valid_ffi_shim_prefix(shim_prefix) {
    return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: sym_trimmed,
      emitted_pion_fn: "",
      error_msg: "bridged C-ABI FFI requires a valid non-empty C identifier shim prefix (`[A-Za-z_][A-Za-z0-9_]*`), got `" + shim_prefix + "`",
    }
  }
  let final_sym = shim_prefix + raw_sym
  if !is_valid_ffi_ident(final_sym) {
    return FfiLowerResult::{
      ok: false,
      needs_bridge: false,
      code: "",
      c_symbol: sym_trimmed,
      emitted_pion_fn: "",
      error_msg: "bridged C-ABI FFI symbol `" + final_sym + "` is not a valid C identifier",
    }
  }
  let bridged_sym_lit = "\"" + final_sym + "\""

  // Build underlying C-ABI extern declaration + safe Pion wrapper.
  let c_fn_name = ffi_fresh_ident(used_idents, "__mbt_c_ffi_" + fn_name)
  let c_used : Map[String, Bool] = Map()
  let wrap_used : Map[String, Bool] = Map()
  for k in used_idents.keys() {
    wrap_used[k] = true
  }
  wrap_used[fn_name] = true
  wrap_used[c_fn_name] = true
  for p in params {
    wrap_used[p.name] = true
    match p.kind {
      FfiParamKind::Direct => c_used[p.name] = true
      FfiParamKind::Str | FfiParamKind::Bytes => ()
    }
  }
  let c_params : Array[String] = []
  let call_args : Array[String] = []
  let pre_stmts : Array[String] = []
  let post_frees : Array[String] = []

  for p in params {
    match p.kind {
      FfiParamKind::Direct => {
        c_params.push(p.name + " : " + p.ty)
        call_args.push(p.name)
      }
      FfiParamKind::Str => {
        let cp = ffi_fresh_ident(c_used, p.name + "_ptr")
        let cl = ffi_fresh_ident(c_used, p.name + "_len")
        c_params.push(cp + " : Ptr")
        c_params.push(cl + " : Int")
        call_args.push(p.name + ".as_cstr()")
        call_args.push(p.name + ".to_bytes().length()")
      }
      FfiParamKind::Bytes => {
        let cp = ffi_fresh_ident(c_used, p.name + "_ptr")
        let cl = ffi_fresh_ident(c_used, p.name + "_len")
        let len_var = ffi_fresh_ident(wrap_used, "__ffi_" + p.name + "_len")
        let buf_var = ffi_fresh_ident(wrap_used, "__ffi_" + p.name + "_buf")
        c_params.push(cp + " : Ptr")
        c_params.push(cl + " : Int")
        pre_stmts.push("  let " + len_var + " = " + p.name + ".length()")
        pre_stmts.push("  let " + buf_var + " = mbt_compat::mbt_ffi_ptr_alloc(if " + len_var + " > 0 { " + len_var + ".to_int64() } else { 1L })")
        pre_stmts.push("  if " + len_var + " > 0 { mbt_compat::mbt_ffi_bytes_copy_to_ptr(" + p.name + ", 0, " + buf_var + ", " + len_var + ") }")
        post_frees.push("  mbt_compat::mbt_ffi_ptr_free(" + buf_var + ")")
        call_args.push(buf_var)
        call_args.push(len_var)
      }
    }
  }

  let mut out_len_box = ""
  let c_ret_str = match ret_kind {
    FfiRetKind::Unit => " -> Unit"
    FfiRetKind::Direct => " -> " + ret_ty
    FfiRetKind::Str => " -> Ptr"
    FfiRetKind::Bytes => {
      out_len_box = ffi_fresh_ident(wrap_used, "__ffi_out_len")
      let out_len_param = ffi_fresh_ident(c_used, "__out_len")
      c_params.push(out_len_param + " : Ptr")
      pre_stmts.push("  let " + out_len_box + " = mbt_compat::mbt_ffi_ptr_alloc(4L)")
      pre_stmts.push("  mbt_compat::mbt_ffi_ptr_write_i32(" + out_len_box + ", 0L, 0)")
      call_args.push(out_len_box)
      " -> Ptr"
    }
  }

  let sb = StringBuilder()
  sb.write_string("extern \"C\" fn " + c_fn_name + "(" + c_params.join(", ") + ")" + c_ret_str + " = " + bridged_sym_lit + "\n")
  let wrap_ret = if ret_str.length() > 0 { ret_str } else { " -> Unit" }
  sb.write_string(vis + "fn " + fn_name + "(" + p_str + ")" + wrap_ret + " {\n")
  for st in pre_stmts {
    sb.write_string(st + "\n")
  }
  let call_expr = c_fn_name + "(" + call_args.join(", ") + ")"
  match ret_kind {
    FfiRetKind::Unit => {
      sb.write_string("  " + call_expr + "\n")
      for pf in post_frees {
        sb.write_string(pf + "\n")
      }
    }
    FfiRetKind::Direct => {
      let res_var = ffi_fresh_ident(wrap_used, "__ffi_res")
      sb.write_string("  let " + res_var + " = " + call_expr + "\n")
      for pf in post_frees {
        sb.write_string(pf + "\n")
      }
      sb.write_string("  " + res_var + "\n")
    }
    FfiRetKind::Str => {
      let ptr_var = ffi_fresh_ident(wrap_used, "__ffi_ret_ptr")
      let str_var = ffi_fresh_ident(wrap_used, "__ffi_ret_str")
      sb.write_string("  let " + ptr_var + " = " + call_expr + "\n")
      sb.write_string("  let " + str_var + " = if mbt_compat::mbt_ffi_ptr_is_null(" + ptr_var + ") { \"\" } else { mbt_compat::mbt_ffi_cstr_to_str(" + ptr_var + ") }\n")
      for pf in post_frees {
        sb.write_string(pf + "\n")
      }
      sb.write_string("  " + str_var + "\n")
    }
    FfiRetKind::Bytes => {
      let ptr_var = ffi_fresh_ident(wrap_used, "__ffi_ret_ptr")
      let rlen_var = ffi_fresh_ident(wrap_used, "__ffi_ret_len")
      let bytes_var = ffi_fresh_ident(wrap_used, "__ffi_ret_bytes")
      sb.write_string("  let " + ptr_var + " = " + call_expr + "\n")
      sb.write_string("  let " + rlen_var + " = mbt_compat::mbt_ffi_ptr_read_i32(" + out_len_box + ", 0L)\n")
      sb.write_string("  mbt_compat::mbt_ffi_ptr_free(" + out_len_box + ")\n")
      sb.write_string("  let " + bytes_var + " = if mbt_compat::mbt_ffi_ptr_is_null(" + ptr_var + ") || " + rlen_var + " <= 0 { \"\".to_bytes() } else { mbt_compat::mbt_ffi_bytes_from_ptr(" + ptr_var + ", " + rlen_var + ") }\n")
      for pf in post_frees {
        sb.write_string(pf + "\n")
      }
      sb.write_string("  " + bytes_var + "\n")
    }
  }
  sb.write_string("}")
  FfiLowerResult::{
    ok: true,
    needs_bridge: true,
    code: sb.to_string(),
    c_symbol: bridged_sym_lit,
    emitted_pion_fn: c_fn_name,
    error_msg: "",
  }
}

///| Canonicalize a C-ABI prototype `(param_types)->ret_type`, ignoring parameter names and whitespace.
pub fn canonical_c_abi_sig(p_str : String, ret_str : String) -> String {
  let ptys : Array[String] = []
  let s = p_str.trim()
  if s.length() > 0 {
    let mut start = 0
    let mut depth = 0
    let mut i = 0
    while i <= s.length() {
      let at_end = i == s.length()
      let c = if at_end { 44 } else { s.code_unit_at(i) }
      if !at_end && (c == 40 || c == 91 || c == 123) {
        depth = depth + 1
      } else if !at_end && (c == 41 || c == 93 || c == 125) {
        if depth > 0 { depth = depth - 1 }
      } else if depth == 0 && c == 44 {
        let part = s.slice(start, i).trim()
        if part.length() > 0 {
          let ci = part.index_of(":")
          let raw_ty = if ci >= 0 { part.slice(ci + 1, part.length()).trim() } else { part }
          ptys.push(raw_ty)
        }
        start = i + 1
      }
      i = i + 1
    }
  }
  let rt = ret_str.trim()
  let rty = if rt.length() == 0 {
    "Unit"
  } else if rt.starts_with("->") {
    let rest = rt.slice(2, rt.length()).trim()
    if rest.length() == 0 { "Unit" } else { rest }
  } else {
    rt
  }
  "(" + ptys.join(",") + ")->" + rty
}

///| True if `tok` starts a new top-level Pion declaration (used to terminate body-less `extern "C"` decls
///| that omit `= "<sym>"`).
fn is_pion_top_level_decl_starter(tok : Token) -> Bool {
  if tok.kind == TokenKind::Attr {
    return true
  }
  if tok.kind == TokenKind::Keyword || tok.kind == TokenKind::Ident {
    let r = tok.raw
    return r == "pub" || r == "priv" || r == "fn" || r == "extern" || r == "struct" ||
    r == "enum" || r == "type" || r == "trait" || r == "impl" || r == "let" ||
    r == "const" || r == "import" || r == "test"
  }
  false
}

///| Parsed top-level Pion `extern "C" fn` declaration with decoded C symbol and source location.
pub struct PionExternCDecl {
  fn_name : String
  c_symbol : String
  canonical_sig : String
  has_body : Bool
  line : Int
  col : Int
}

fn join_token_raws(tokens : Array[Token], start : Int, end : Int) -> String {
  let sb = StringBuilder()
  let mut k = start
  while k < end {
    if k > start {
      sb.write_string(" ")
    }
    sb.write_string(tokens[k].raw)
    k = k + 1
  }
  sb.to_string()
}

///| Scan a `.pion` file for top-level `extern "C" fn <name>(<params>)[-> <ret>][= "<sym>"][{ ... }]`
///| declarations (decoding Pion string escapes, ignoring comments via token stream, supporting multiline
///| return annotations, optional body blocks, and omitted `= "<sym>"` defaulting to `<name>`).
///| Emits `MBT2PION_UNSUPPORTED_FFI_SIGNATURE` fail-closed on malformed ABI or C symbol string escapes.
pub fn collect_pion_extern_c_decls(file : String, content : String, diags : Array[Diag]) -> Array[PionExternCDecl] {
  let out : Array[PionExternCDecl] = []
  let tokens = lex_moonbit(content)
  let n = tokens.length() - 1
  let mut i = 0
  let mut depth = 0
  while i < n {
    let t = tokens[i]
    if t.kind == TokenKind::LBrace {
      depth = depth + 1
      i = i + 1
      continue
    }
    if t.kind == TokenKind::RBrace {
      if depth > 0 { depth = depth - 1 }
      i = i + 1
      continue
    }
    if depth == 0 && (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "extern" &&
    i + 4 < n && (tokens[i + 1].kind == TokenKind::StringLit || tokens[i + 1].kind == TokenKind::InterpString) &&
    tokens[i + 2].kind == TokenKind::Keyword && tokens[i + 2].raw == "fn" &&
    (tokens[i + 3].kind == TokenKind::Ident || tokens[i + 3].kind == TokenKind::UpperIdent || tokens[i + 3].kind == TokenKind::Keyword) &&
    tokens[i + 4].kind == TokenKind::LParen {
      let abi_ok = match decode_pion_string_lit(tokens[i + 1].raw) {
        Ok(abi_s) => abi_s == "C"
        Err(msg) => {
          diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
            file,
            t.line,
            t.col,
            "invalid extern ABI string literal `" + tokens[i + 1].raw + "`: " + msg,
          ))
          false
        }
      }
      if !abi_ok {
        i = i + 1
        continue
      }
      let fn_name = tokens[i + 3].raw
      let open_p = i + 4
      let close_p = find_matching_delim(tokens, open_p)
      let p_str = join_token_raws(tokens, open_p + 1, close_p)
      let mut cur = close_p + 1
      let mut pd = 0
      let mut found_eq = false
      let mut found_lbrace = false
      while cur < n {
        let tk = tokens[cur]
        if tk.kind == TokenKind::LParen || tk.kind == TokenKind::LBracket {
          pd = pd + 1
          cur = cur + 1
          continue
        }
        if tk.kind == TokenKind::RParen || tk.kind == TokenKind::RBracket {
          if pd > 0 { pd = pd - 1 }
          cur = cur + 1
          continue
        }
        if pd == 0 {
          if tk.kind == TokenKind::Eq {
            found_eq = true
            break
          }
          if tk.kind == TokenKind::LBrace {
            found_lbrace = true
            break
          }
          if tk.kind == TokenKind::Semi || is_pion_top_level_decl_starter(tk) {
            break
          }
        }
        cur = cur + 1
      }
      let ret_str = join_token_raws(tokens, close_p + 1, cur)
      let csig = canonical_c_abi_sig(p_str, ret_str)
      if found_eq && cur + 1 < n && (tokens[cur + 1].kind == TokenKind::StringLit || tokens[cur + 1].kind == TokenKind::InterpString) {
        let sym_lit = tokens[cur + 1].raw.trim()
        let has_body = cur + 2 < n && tokens[cur + 2].kind == TokenKind::LBrace
        match decode_pion_string_lit(sym_lit) {
          Ok(sym) =>
          out.push(PionExternCDecl::{
            fn_name: fn_name,
            c_symbol: sym,
            canonical_sig: csig,
            has_body: has_body,
            line: t.line,
            col: t.col,
          })
          Err(msg) =>
          diags.push(diag_error(
            "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
            file,
            t.line,
            t.col,
            "invalid extern \"C\" symbol string literal `" + sym_lit + "` on `" + fn_name + "`: " + msg,
          ))
        }
        i = if has_body { find_matching_delim(tokens, cur + 2) + 1 } else { cur + 2 }
        continue
      } else {
        // Omitted `= "<sym>"`: Pion defaults the C symbol to `fn_name` (both body-less and `{ body }` forms).
        out.push(PionExternCDecl::{
          fn_name: fn_name,
          c_symbol: fn_name,
          canonical_sig: csig,
          has_body: found_lbrace,
          line: t.line,
          col: t.col,
        })
        i = if found_lbrace {
          find_matching_delim(tokens, cur) + 1
        } else if cur < n && tokens[cur].kind == TokenKind::Semi {
          cur + 1
        } else {
          cur
        }
        continue
      }
    }
    i = i + 1
  }
  out
}

///| Record original pre-preprocess `(line, col)` for every active (matching `#cfg`) top-level
///| `extern "C" fn <name>` in raw `.mbt` sources so collision diagnostics always point to the
///| exact original source line/col even after pre-passes rewrite earlier lines.
pub fn collect_orig_mbt_extern_c_locs(sources : Array[SourceFile], target : String) -> Map[String, (Int, Int)] {
  let out : Map[String, (Int, Int)] = Map()
  for sf in sources {
    let tokens = lex_moonbit(sf.content)
    let n = tokens.length() - 1
    let mut i = 0
    let mut depth = 0
    let mut next_cfg_excluded = false
    while i < n {
      let t = tokens[i]
      if t.kind == TokenKind::LBrace {
        depth = depth + 1
        i = i + 1
        continue
      }
      if t.kind == TokenKind::RBrace {
        if depth > 0 { depth = depth - 1 }
        i = i + 1
        continue
      }
      if depth == 0 && t.kind == TokenKind::Attr {
        if t.raw.starts_with("#cfg") {
          match eval_cfg_attr(t.raw, target) {
            Some(true) => ()
            _ => next_cfg_excluded = true
          }
        }
        i = i + 1
        continue
      }
      if depth == 0 && next_cfg_excluded {
        next_cfg_excluded = false
        i = skip_top_level_decl(tokens, i, n)
        continue
      }
      if depth == 0 && (t.kind == TokenKind::Keyword || t.kind == TokenKind::Ident) && t.raw == "extern" &&
      i + 4 < n && tokens[i + 1].kind == TokenKind::StringLit && tokens[i + 1].raw == "\"C\"" &&
      tokens[i + 2].kind == TokenKind::Keyword && tokens[i + 2].raw == "fn" &&
      (tokens[i + 3].kind == TokenKind::Ident || tokens[i + 3].kind == TokenKind::UpperIdent || tokens[i + 3].kind == TokenKind::Keyword) {
        let fn_name = tokens[i + 3].raw
        let mut start_i = i
        if start_i >= 1 && tokens[start_i - 1].line == t.line && tokens[start_i - 1].kind == TokenKind::Keyword &&
        (tokens[start_i - 1].raw == "pub" || tokens[start_i - 1].raw == "priv") {
          start_i = start_i - 1
        } else if start_i >= 4 && tokens[start_i - 4].line == t.line && tokens[start_i - 4].kind == TokenKind::Keyword &&
        tokens[start_i - 4].raw == "pub" && tokens[start_i - 3].kind == TokenKind::LParen && tokens[start_i - 1].kind == TokenKind::RParen {
          start_i = start_i - 4
        }
        let loc = (tokens[start_i].line, tokens[start_i].col)
        let mut raw_sym = ""
        if i + 4 < n && tokens[i + 4].kind == TokenKind::LParen {
          let close_p = find_matching_delim(tokens, i + 4)
          let mut eq_i = close_p + 1
          let mut pd = 0
          while eq_i < n {
            let ek = tokens[eq_i].kind
            if ek == TokenKind::LParen || ek == TokenKind::LBracket {
              pd = pd + 1
            } else if ek == TokenKind::RParen || ek == TokenKind::RBracket {
              if pd > 0 { pd = pd - 1 }
            } else if pd == 0 && (ek == TokenKind::Eq || ek == TokenKind::LBrace || ek == TokenKind::Semi || is_pion_top_level_decl_starter(tokens[eq_i])) {
              break
            }
            eq_i = eq_i + 1
          }
          if eq_i + 1 < n && tokens[eq_i].kind == TokenKind::Eq && tokens[eq_i + 1].kind == TokenKind::StringLit {
            let sl = tokens[eq_i + 1].raw.trim()
            if sl.length() >= 2 && sl.starts_with("\"") && sl.ends_with("\"") {
              raw_sym = sl.slice(1, sl.length() - 1)
            }
          }
        }
        let renamed_fn = rename_keyword_ident(fn_name)
        if raw_sym.length() > 0 {
          let exact_key = sf.rel_path + "::" + fn_name + "::" + raw_sym
          if !out.contains(exact_key) {
            out[exact_key] = loc
          }
          if renamed_fn != fn_name {
            let exact_renamed = sf.rel_path + "::" + renamed_fn + "::" + raw_sym
            if !out.contains(exact_renamed) {
              out[exact_renamed] = loc
            }
          }
        }
        let key = sf.rel_path + "::" + fn_name
        if !out.contains(key) {
          out[key] = loc
        }
        if renamed_fn != fn_name {
          let renamed_key = sf.rel_path + "::" + renamed_fn
          if !out.contains(renamed_key) {
            out[renamed_key] = loc
          }
        }
        i = i + 4
        continue
      }
      i = i + 1
    }
  }
  out
}

///| Reconcile `ffi_symbols` against final post-overlay `.pion` files (preserving `.mbt` `raw_c_symbol`
///| while updating `emitted_c_symbol` / `bridged` after overlays) and run a final package-wide C symbol
///| collision check across all generated `.pion` files and `[[abi.companions]]`.
pub fn reconcile_final_ffi_symbols_and_check_collisions(
  gen_files : Array[GeneratedFile],
  companion_files : Array[(String, String, String)],
  initial_symbols : Array[FfiSymbolMapping],
  diags : Array[Diag],
) -> Array[FfiSymbolMapping] {
  let final_symbols : Array[FfiSymbolMapping] = []
  let final_c_syms : Map[String, (String, String, String, Bool)] = Map()

  let check_and_record = fn(
    file : String,
    fn_name : String,
    sym : String,
    sig : String,
    must_be_unique : Bool,
    line : Int,
    col : Int,
  ) -> Unit {
    match final_c_syms.get(sym) {
      Some(prev) =>
      if prev.3 || must_be_unique || prev.2 != sig {
        diags.push(diag_error(
          "MBT2PION_UNSUPPORTED_FFI_SIGNATURE",
          file,
          line,
          col,
          "extern \"C\" symbol `" + sym + "` on `" + file + "` fn `" + fn_name + "` collides with `" + prev.0 + "` fn `" + prev.1 + "`",
        ))
      }
      None => final_c_syms[sym] = (file, fn_name, sig, must_be_unique)
    }
  }

  for gf in gen_files {
    let decls = collect_pion_extern_c_decls(gf.rel_path, gf.content, diags)
    let matched_init : Map[Int, Bool] = Map()
    for d in decls {
      let pion_fn = d.fn_name
      let c_sym = d.c_symbol
      let c_sig = d.canonical_sig
      let mut found_idx = -1
      let mut is_bridged = false
      let mut logical_fn = pion_fn
      let mut raw_sym = c_sym
      let mut diag_file = gf.rel_path
      let mut diag_line = d.line
      let mut diag_col = d.col
      let mut idx = 0
      while idx < initial_symbols.length() {
        if !matched_init.contains(idx) {
          let fm = initial_symbols[idx]
          if fm.file == gf.source_file {
            if pion_fn == fm.emitted_pion_fn {
              found_idx = idx
              is_bridged = fm.bridged
              logical_fn = fm.fn_name
              raw_sym = fm.raw_c_symbol
              diag_file = gf.source_file
              diag_line = fm.line
              diag_col = fm.col
              break
            } else if pion_fn == fm.fn_name {
              found_idx = idx
              is_bridged = false
              logical_fn = fm.fn_name
              raw_sym = fm.raw_c_symbol
              diag_file = gf.source_file
              diag_line = fm.line
              diag_col = fm.col
              break
            }
          }
        }
        idx = idx + 1
      }
      if found_idx >= 0 {
        matched_init[found_idx] = true
      } else if pion_fn.starts_with("__mbt_c_ffi_") {
        is_bridged = true
      }
      check_and_record(diag_file, logical_fn, c_sym, c_sig, is_bridged || d.has_body, diag_line, diag_col)
      final_symbols.push(FfiSymbolMapping::{
        file: gf.source_file,
        line: diag_line,
        col: diag_col,
        fn_name: logical_fn,
        emitted_pion_fn: pion_fn,
        raw_c_symbol: raw_sym,
        emitted_c_symbol: c_sym,
        bridged: is_bridged,
      })
    }
  }

  for cf in companion_files {
    let cname = cf.0
    let ctxt = cf.1
    let cdecls = collect_pion_extern_c_decls(cname, ctxt, diags)
    for cd in cdecls {
      check_and_record(cname, cd.fn_name, cd.c_symbol, cd.canonical_sig, cd.has_body, cd.line, cd.col)
    }
  }

  final_symbols
}
