///| Wave M2-E3 unit tests: MbtIter::join, Array::search_by,
///| anonymous shorthand struct literal field expected-type + scoped rename,
///| and preserving `Eq` alongside `mbt_compat::MapKey` for `[K : Hash + Eq]`.

test "e3-1: iter map join lowers cleanly" {
  let src = SourceFile::{
    rel_path: "e31.mbt",
    content: "pub fn join_args(args : Array[String]) -> String {\n  args.iter().map(fn(s) { s + \"!\" }).join(\"\")\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, ".join(\"\")"), "iter().map(...).join(\"\") preserved for MbtIter::join")
}

test "e3-2: Array::search_by stage_b mapping does not affect non-array receivers" {
  match lookup_missing_method_helper("Array[Int]", "search_by") {
    Some(h) => assert_true(h == "mbt_compat::arr_search_by", "Array[Int].search_by must map to mbt_compat::arr_search_by")
    None => assert_true(false, "Array[Int].search_by must map to mbt_compat::arr_search_by")
  }
  match lookup_missing_method_helper("CustomBox", "search_by") {
    Some(_) => assert_true(false, "non-array CustomBox.search_by must not be rewritten")
    None => ()
  }
}

test "e3-3: anonymous shorthand struct literal pushes field expected type and resolves scoped ident" {
  let src = SourceFile::{
    rel_path: "e33.mbt",
    content: "pub struct Store[K, V] {\n  order : Array[K]\n  vals : Map[K, V]\n  same : (V, V) -> Bool\n}\npub fn[K, V] Store::new(same : (V, V) -> Bool) -> Store[K, V] {\n  { order: [], vals: {}, same }\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "vals: mbt_compat::ordered_map_new()"),
    "shorthand struct literal must propagate Map field expected type to empty map literal",
  )
  assert_true(str_has(out, "same: same"), "shorthand field expands cleanly")
}

test "e3-4: generic bound [K : Hash + Eq] preserves Eq alongside MapKey" {
  let src = SourceFile::{
    rel_path: "e34.mbt",
    content: "pub fn[K : Eq] find(xs : Array[K], k : K) -> Bool {\n  let mut i = 0\n  while i < xs.length() {\n    if xs[i] == k { return true }\n    i = i + 1\n  }\n  false\n}\npub fn[K : Hash + Eq] put(xs : Array[K], k : K) -> Bool {\n  find(xs, k)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(
    str_has(out, "K : mbt_compat::MbtHash + Eq + mbt_compat::MapKey"),
    "[K : Hash + Eq] must emit Eq alongside MbtHash and MapKey",
  )
}
