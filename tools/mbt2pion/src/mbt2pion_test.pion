///| Comprehensive public-safe unit tests for `tools/mbt2pion` (zero project-specific identifiers).

fn assert_true(cond : Bool, msg : String) -> Unit {
  if !cond {
    panic("ASSERTION FAILED: " + msg)
  }
}

fn assert_eq(a : Int, b : Int) -> Unit {
  if a != b {
    panic("ASSERTION FAILED: expected " + b.to_string() + ", got " + a.to_string())
  }
}

fn noop_check(_batch : Array[(String, String)]) -> String {
  "{\"ok\":true,\"diagnostics\":[]}"
}

test "lexer lossless round-trip across MoonBit touchstone matrix" {
  let src = "// line comment\n" +
  "///| doc comment\n" +
  "/* nested /* block */ comment */\n" +
  "#callsite(autofill(loc))\n" +
  "pub(all) fn demo(x? : Int = 1_000, f : () -> Int?) -> String {\n" +
  "  let hex = 0xFF_00L\n" +
  "  let bin = 0b1010_0101\n" +
  "  let flt = 1.5e-7\n" +
  "  let ch = '\\u{1F600}'\n" +
  "  let by = b'A'\n" +
  "  let bs = b\"hi\"\n" +
  "  let raw = #|raw \\{no_interp}\n" +
  "  let interp = \"a=\\{x + 1} b=\\{\"inner\"}\"\n" +
  "  let mline = $|line \\{x}\n" +
  "  let r = 0..<10\n" +
  "  let r2 = 0..=10\n" +
  "  let a = xs\n" +
  "    |> f\n" +
  "  let b = obj\n" +
  "    ..push(1)\n" +
  "  interp\n" +
  "}\n"
  let toks = lex_moonbit(src)
  let rebuilt = tokens_to_source(toks)
  assert_true(rebuilt == src, "lossless lexer round-trip must preserve every byte")
  let mut saw_interp = false
  let mut saw_raw_ml = false
  let mut saw_interp_ml = false
  let mut saw_dotdot_lt = false
  let mut saw_dotdot_eq = false
  let mut saw_nl_pipegt = false
  let mut saw_nl_dotdot = false
  for t in toks {
    if t.kind == TokenKind::InterpString { saw_interp = true }
    if t.kind == TokenKind::RawMultiline { saw_raw_ml = true }
    if t.kind == TokenKind::InterpMultiline { saw_interp_ml = true }
    if t.kind == TokenKind::DotDotLt { saw_dotdot_lt = true }
    if t.kind == TokenKind::DotDotEq { saw_dotdot_eq = true }
    if t.kind == TokenKind::PipeGt && t.newline_before { saw_nl_pipegt = true }
    if t.kind == TokenKind::DotDot && t.newline_before { saw_nl_dotdot = true }
  }
  assert_true(saw_interp, "must lex InterpString")
  assert_true(saw_raw_ml, "must lex RawMultiline #|")
  assert_true(saw_interp_ml, "must lex InterpMultiline $|")
  assert_true(saw_dotdot_lt, "must lex ..<")
  assert_true(saw_dotdot_eq, "must lex ..=")
  assert_true(saw_nl_pipegt, "must track newline_before on |>")
  assert_true(saw_nl_dotdot, "must track newline_before on ..")
}

test "stage A: value-returning guard (bool and is-pattern) vs diverging guard" {
  let src = SourceFile::{
    rel_path: "guards.mbt",
    content: "pub fn val_g(ok : Bool) -> Int {\n  guard ok else { 17 }\n  42\n}\n\npub fn guard_is(opt : Int?) -> Int {\n  guard opt is Some(v) else { 17 }\n  v + 1\n}\n\npub fn div_g(ok : Bool) -> Int {\n  guard ok else { return 0 }\n  42\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "if ok {"), "value-returning bool guard must rewrite to if/else")
  assert_true(str_has(out, "match opt {"), "value-returning guard-is must rewrite to match")
  assert_true(str_has(out, "Some(v) => {"), "guard-is binds pattern variable v")
  assert_true(str_has(out, "guard ok else { return 0 }"), "diverging guard must remain Pion-native")
}

test "stage A: topological init order with indirect fn reads and cycle detection" {
  let f1 = SourceFile::{
    rel_path: "a.mbt",
    content: "let first : Int = helper()\n\nfn helper() -> Int {\n  second + 1\n}\n\nfn init {\n  let _ = first\n}\n",
    is_test: false,
  }
  let f2 = SourceFile::{
    rel_path: "b.mbt",
    content: "let second : Int = 42\n",
    is_test: false,
  }
  let res = transpile_package([f1, f2], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let mut init_code = ""
  for gf in res.files {
    if gf.rel_path == "00_init_order.pion" {
      init_code = gf.content
    }
  }
  assert_true(init_code.length() > 0, "00_init_order.pion must be emitted")
  let pos_second = init_code.index_of("let second")
  let pos_first = init_code.index_of("let first")
  let pos_init = init_code.index_of("__mbt_init_a_mbt_1")
  assert_true(pos_second >= 0 && pos_first > pos_second, "second must initialize before first")
  assert_true(pos_init > pos_first, "fn init must initialize after first")

  let cyc = SourceFile::{
    rel_path: "cyc.mbt",
    content: "let x : Int = y + 1\nlet y : Int = x + 1\n",
    is_test: false,
  }
  let cyc_res = transpile_package([cyc], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(cyc_res.blockers > 0, "cyclic init must produce blocker")
  let mut found_cycle_code = false
  for d in cyc_res.diagnostics {
    if d.code == "MBT2PION_INIT_CYCLE" {
      found_cycle_code = true
    }
  }
  assert_true(found_cycle_code, "must emit MBT2PION_INIT_CYCLE")
}

test "stage A: leading generics, rest patterns, chained cascade, optional forwarding, and canonical mbt_compat" {
  let api_json = "{\"pkg_aliases\":{\"ext\":\"acme_ext\"},\"symbols\":[" +
  "{\"src_pkg\":\"ext\",\"src_name\":\"FixedTag\",\"kind\":\"ctor\",\"target_pkg\":\"acme_ext\",\"target_name\":\"FixedTag\",\"target_enum\":\"Tag\"}," +
  "{\"src_pkg\":\"ext\",\"src_name\":\"ext_tally\",\"kind\":\"fn\",\"target_pkg\":\"acme_ext\",\"target_name\":\"ext_tally\",\"external_tilde_default\":true}" +
  "]}"
  let pre_diags : Array[Diag] = []
  let am = parse_api_map(api_json, "api_map.json", pre_diags)
  assert_eq(pre_diags.length(), 0)

  let src = SourceFile::{
    rel_path: "syntax.mbt",
    content: "pub enum Tri {\n  Tri(Int, Int, Int)\n  Empty\n}\n\n" +
    "pub fn[T] id(x : T) -> T {\n  x\n}\n\n" +
    "pub fn first_of(t : Tri) -> Int {\n  match t {\n    Tri(a, ..) => a\n    Empty => 0\n  }\n}\n\n" +
    "#callsite(autofill(loc))\n" +
    "pub fn trace(msg : String, loc~ : SourceLoc) -> String {\n  msg + loc\n}\n\n" +
    "pub fn tally(base : Int, x? : Int = 17) -> Int {\n  base + x\n}\n\n" +
    "pub fn relay(a : Int, x? : Int) -> Int {\n  let _ = trace(\"one\")\n  let _ = trace(\"two\")\n  let _ = @ext.ext_tally(a, x?)\n  tally(a, x?)\n}\n\n" +
    "pub fn syntax_mix(f : () -> Int?, val : Int, xs : Array[Int], box_ : Box) -> Array[Int] {\n" +
    "  let g = (n) => n + val\n" +
    "  let _ = FixedTag\n" +
    "  let _ = b\"ok\"\n" +
    "  let _ = xs[1:3]\n" +
    "  let _ = { \"k\": 1 }\n" +
    "  let _ = box_.items..push(9)\n" +
    "  xs..push(g(1))..push(2)\n" +
    "}\n",
    is_test: false,
  }
  let res = transpile_package([src], am, default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "pub fn id[T](x : T) -> T"), "leading generics moved after fn name")
  assert_true(str_has(out, "Tri(a, _, _) => a"), "ctor rest pattern expanded to exact arity")
  assert_true(str_has(out, "loc~ : String = \"\""), "SourceLoc lowered to String default")
  assert_true(str_has(out, "loc=\"syntax.mbt:"), "callsites get SourceLoc")
  assert_true(str_has(out, "match x { Some(__mbt_v) => __mbt_v, None => 17 }"), "migrated default lazy None branch")
  assert_true(str_has(out, "tally(a, x?=x)"), "optional forwarding to migrated callee")
  assert_true(str_has(out, "acme_ext::ext_tally(__mbt_arg_"), "external tilde default call-site branch")
  assert_true(str_has(out, "() -> Option[Int]"), "T? precedence in function return type")
  assert_true(str_has(out, "val_ : Int"), "keyword val renamed consistently")
  assert_true(str_has(out, "fn(n) { n + val_ }"), "arrow fn lowered and keyword renamed")
  assert_true(str_has(out, "acme_ext::Tag::FixedTag"), "cross-package constructor qualified")
  assert_true(str_has(out, "\"ok\".to_bytes()"), "byte string lowered")
  assert_true(str_has(out, "mbt_compat::array_slice_clamp(xs, 1, 3)"), "canonical slice helper")
  assert_true(str_has(out, "mbt_compat::ordered_map_from_array([(\"k\", 1)])"), "canonical map literal helper")
  assert_true(str_has(out, "box_.items;"), "chained field cascade receiver supported")

  // Unknown constructor arity in rest pattern MUST hard-fail with MBT2PION_MANUAL
  let unk = SourceFile::{
    rel_path: "unk_rest.mbt",
    content: "pub fn f(x : Any) -> Int {\n  match x {\n    Mystery(a, ..) => a\n    _ => 0\n  }\n}\n",
    is_test: false,
  }
  let unk_res = transpile_package([unk], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(unk_res.blockers > 0, "unknown rest pattern arity must hard-fail")
}

test "stage A: derive Eq handles non-primitive struct Option/Array fields and enum trait_recipes" {
  let recipes_toml = "[ref]\n" +
  "enabled = true\n" +
  "ctor_call = \"acme::cell_new\"\n" +
  "field_name = \"v\"\n" +
  "type_name = \"acme::Cell\"\n\n" +
  "[[trait_impl]]\n" +
  "derive = \"Eq\"\n" +
  "target_trait = \"acme::ReactiveEq\"\n" +
  "method = \"eq\"\n"
  let rdiags : Array[Diag] = []
  let rec = parse_recipes_toml(recipes_toml, "recipes.toml", rdiags)
  assert_eq(rdiags.length(), 0)

  let ok_src = SourceFile::{
    rel_path: "rec.mbt",
    content: "#derive(Eq)\npub(all) struct Complex {\n  opt : Int?\n  arr : Array[Int]\n}\n\n#derive(Eq)\npub enum State {\n  Idle\n  Data(Option[Int])\n}\n\npub fn mk() -> Ref[Int] {\n  { val: 9 }\n}\n",
    is_test: false,
  }
  let res = transpile_package([ok_src], empty_api_map(), rec, [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "impl acme::ReactiveEq for Complex"), "recipe synthesized struct trait impl")
  assert_true(str_has(out, "impl acme::ReactiveEq for State"), "recipe synthesized enum trait impl")
  assert_true(str_has(out, "match (a.opt, b.opt)"), "Option field uses match, not raw ==")
  assert_true(str_has(out, "while __ai_"), "Array field uses element loop, not raw ==")
  assert_true(str_has(out, "(.Idle, .Idle) => true"), "enum match arms generated")
  assert_true(str_has(out, "acme::cell_new(9)"), "recipe bound Ref literal")

  let bad_src = SourceFile::{
    rel_path: "bad_derive.mbt",
    content: "#derive(Mystery)\npub struct Bad { x : Int }\n",
    is_test: false,
  }
  let bad_res = transpile_package([bad_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(bad_res.blockers > 0, "unknown derive must block")
  assert_true(bad_res.diagnostics[0].code == "MBT2PION_UNKNOWN_DERIVE", "must emit MBT2PION_UNKNOWN_DERIVE")
}

test "stage A.5: nonzero literal check, same-line multi-probes, complex receivers, and canonical div helpers" {
  // B.3: is_statically_nonzero_literal edge cases
  assert_true(!is_statically_nonzero_literal(lex_moonbit("0.0e5")[0]), "0.0e5 must be zero")
  assert_true(!is_statically_nonzero_literal(lex_moonbit("0L")[0]), "0L must be zero")
  assert_true(!is_statically_nonzero_literal(lex_moonbit("0U")[0]), "0U must be zero")
  assert_true(!is_statically_nonzero_literal(lex_moonbit("0x0")[0]), "0x0 must be zero")
  assert_true(is_statically_nonzero_literal(lex_moonbit("0x1")[0]), "0x1 must be nonzero")
  assert_true(is_statically_nonzero_literal(lex_moonbit("1.5e-7")[0]), "1.5e-7 must be nonzero")

  // B.1 + B.2 + A.1: same-line `s.length() + arr.length()`, complex receiver `self.text.length()`, `(a + b) / n`, `a / 0`
  let src = SourceFile::{
    rel_path: "drift.mbt",
    content: "pub fn run(s : String, arr : Array[Int], a : Int, b : Int, d : Double) -> Unit {\n" +
    "  let _ = s.length() + arr.length()\n" +
    "  let _ = (a + b) / b\n" +
    "  let _ = a / 0\n" +
    "  let _ = a / 2\n" +
    "  let _ = d.to_string()\n" +
    "}\n",
    is_test: false,
  }
  let mock_check = fn(batch : Array[(String, String)]) -> String {
    let mut txt = ""
    for p in batch {
      if p.0 == "drift.pion" { txt = p.1 }
    }
    let items : Array[String] = []
    if str_has(txt, "s.mbt_len_probe()") {
      items.push("{\"file\":\"drift.pion\",\"line\":2,\"col\":13,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe` on type `String`\"}")
    }
    if str_has(txt, "arr.mbt_len_probe()") {
      items.push("{\"file\":\"drift.pion\",\"line\":2,\"col\":35,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_len_probe` on type `Array[Int]`\"}")
    }
    if str_has(txt, "(a + b).mbt_div_probe(b)") {
      items.push("{\"file\":\"drift.pion\",\"line\":3,\"col\":19,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_div_probe` on type `Int`\"}")
    }
    if str_has(txt, "a.mbt_div_probe(0)") {
      items.push("{\"file\":\"drift.pion\",\"line\":4,\"col\":13,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_div_probe` on type `Int`\"}")
    }
    if str_has(txt, "d.mbt_show_probe()") {
      items.push("{\"file\":\"drift.pion\",\"line\":6,\"col\":13,\"code\":\"E_TYPE_MISMATCH\",\"message\":\"unknown method `mbt_show_probe` on type `Double`\"}")
    }
    if items.length() == 0 {
      return "{\"ok\":true,\"diagnostics\":[]}"
    }
    let sb = StringBuilder()
    sb.write_string("{\"ok\":false,\"diagnostics\":[")
    let mut k = 0
    while k < items.length() {
      if k > 0 { sb.write_string(",") }
      sb.write_string(items[k])
      k = k + 1
    }
    sb.write_string("]}")
    sb.to_string()
  }
  let res = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], true, mock_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "mbt_compat::utf16_len(s) + arr.length()"), "same-line multi-probe must NOT misclassify arr.length()")
  assert_true(str_has(out, "mbt_compat::div_checked_i32((a + b), b)"), "complex receiver (a + b) / b uses canonical div_checked_i32")
  assert_true(str_has(out, "mbt_compat::trap_div_zero()"), "known-zero uses canonical trap_div_zero()")
  assert_true(str_has(out, "a / 2"), "statically non-zero divisor stays fast")
  assert_true(str_has(out, "mbt_compat::double_to_string(d)"), "Double.to_string() rewritten")
  assert_true(!has_probe_residual(out), "0 probe residuals")
}

test "stage B: 2-arg utf16_to_utf8_off with str_param, missing str_param error, and col-precise coercion" {
  let bad_map = "{\"symbols\":[{\"src_pkg\":\"p\",\"src_name\":\"hit\",\"kind\":\"fn\",\"params\":[{\"name\":\"offset\",\"ty\":\"Int\"}]}]}"
  let diags : Array[Diag] = []
  let _ = parse_api_map(bad_map, "bad_api_map.json", diags)
  assert_true(diags.length() == 1 && diags[0].code == "MBT2PION_UNTAGGED_UNIT", "untagged offset param must hard-fail")

  // Missing `str_param` on `utf8` boundary conversion MUST emit MBT2PION_MISSING_STR_PARAM (never illegal 1-arg call!)
  let no_str_map = "{\"symbols\":[{\"src_pkg\":\"p\",\"src_name\":\"hit\",\"kind\":\"fn\",\"target_pkg\":\"p\",\"target_name\":\"hit\",\"params\":[{\"name\":\"offset\",\"ty\":\"Int\",\"unit\":\"utf8\"}]}]}"
  let d_ns : Array[Diag] = []
  let am_ns = parse_api_map(no_str_map, "ns.json", d_ns)
  let drift_ns : Array[DriftEntry] = []
  let _ = apply_api_boundary_conversions("let _ = p::hit(offset=pos)\n", am_ns, "f.pion", d_ns, drift_ns)
  assert_true(d_ns.length() == 1 && d_ns[0].code == "MBT2PION_MISSING_STR_PARAM", "missing str_param must hard-fail")

  // With `str_param`: emits 2-arg `mbt_compat::utf16_to_utf8_off(text, pos)`
  let good_map = "{\"symbols\":[{\"src_pkg\":\"p\",\"src_name\":\"hit\",\"kind\":\"fn\",\"target_pkg\":\"p\",\"target_name\":\"hit\",\"params\":[{\"name\":\"text\",\"ty\":\"String\",\"unit\":\"none\"},{\"name\":\"offset\",\"ty\":\"Int\",\"unit\":\"utf8\",\"str_param\":\"text\"}]}]}"
  let diags2 : Array[Diag] = []
  let am = parse_api_map(good_map, "good_api_map.json", diags2)
  assert_eq(diags2.length(), 0)
  let drift : Array[DriftEntry] = []
  let rewritten = apply_api_boundary_conversions("let _ = p::hit(text=my_s, offset=pos)\n", am, "f.pion", diags2, drift)
  assert_eq(diags2.length(), 0)
  assert_true(str_has(rewritten, "mbt_compat::utf16_to_utf8_off(my_s, pos)"), "2-arg utf16_to_utf8_off emitted")

  // Token-precise numeric coercion preserves trailing comment!
  let coerced = match coerce_numeric_token_at_col("  let x : Double = 42 // keep comment", 20, "to_double") {
    Some(s) => s
    None => ""
  }
  assert_true(coerced == "  let x : Double = 42.to_double() // keep comment", "coercion must not append after trailing comment")
}

test "double-hash overlay exact match and stale source rejection" {
  let src = SourceFile::{
    rel_path: "ov.mbt",
    content: "pub fn compute(x : Int) -> Int {\n  x + 1\n}\n",
    is_test: false,
  }
  let base = transpile_package([src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(base.blockers, 0)
  assert_true(base.files[0].anchors.length() == 1, "one anchor emitted")
  let anc = base.files[0].anchors[0]

  let ov = OverlaySpec::{
    id: "ov-1",
    source_file: "ov.mbt",
    decl_identity: anc.decl_identity,
    target: "native",
    normalized_source_cst_hash: anc.normalized_source_cst_hash,
    pre_overlay_generated_hash: anc.pre_overlay_generated_hash,
    replacement: "pub fn compute(x : Int) -> Int {\n  x + 100\n}",
    reason: "test override",
    behavior_test: "ov_test",
    upstream_issue_or_removal_condition: "issue#1",
  }
  let applied = transpile_package([src], empty_api_map(), default_recipes(), [ov], [], default_options(), [], false, noop_check)
  assert_eq(applied.blockers, 0)
  assert_true(str_has(applied.files[0].content, "x + 100"), "overlay applied cleanly")

  let mutated_src = SourceFile::{
    rel_path: "ov.mbt",
    content: "pub fn compute(x : Int) -> Int {\n  x + 2\n}\n",
    is_test: false,
  }
  let stale = transpile_package([mutated_src], empty_api_map(), default_recipes(), [ov], [], default_options(), [], false, noop_check)
  assert_true(stale.blockers > 0, "mutated upstream source must reject stale overlay")
  assert_true(stale.diagnostics[0].code == "MBT2PION_OVERLAY_STALE_SOURCE", "must emit MBT2PION_OVERLAY_STALE_SOURCE")
}

test "BUG-1: extract_mbti_pkg_name handles package header, pkg.generated.mbti, and foo.mbti" {
  assert_true(
    extract_mbti_pkg_name("foo/pkg.generated.mbti", "package \"org/repo/ui/layout\"\n\npub enum Mode {\n  Auto\n}\n") == "layout",
    "package header takes precedence",
  )
  assert_true(
    extract_mbti_pkg_name("libs/theme/pkg.generated.mbti", "pub enum Tone {\n  Warm\n}\n") == "theme",
    "pkg.generated.mbti falls back to parent dir",
  )
  assert_true(
    extract_mbti_pkg_name("deps/canvas.mbti", "pub enum Brush {\n  Flat\n}\n") == "canvas",
    "foo.mbti strips dir and .mbti suffix",
  )
  let src = SourceFile::{
    rel_path: "use.mbt",
    content: "pub fn f() -> Int { let _ = Auto; 1 }\n",
    is_test: false,
  }
  let res = transpile_package(
    [src],
    empty_api_map(),
    default_recipes(),
    [],
    [("layout.mbti", "package \"org/repo/layout\"\npub enum Mode {\n  Auto\n}\n")],
    default_options(),
    [],
    false,
    noop_check,
  )
  assert_eq(res.blockers, 0)
  assert_true(str_has(res.files[0].content, "layout::Mode::Auto"), "clean package name without .mbti suffix")
  assert_true(!str_has(res.files[0].content, ".mbti::"), "must never emit .mbti::")
  assert_true(str_has(res.files[0].content, "import \"layout\""), "BUG-2 auto-emits import for referenced pkg")
}

test "BUG-2 & BUG-3 & BUG-4: auto-imports, nested generic T?, and direct Ref(expr) lowering" {
  let diags : Array[Diag] = []
  let recipes = parse_recipes_toml(
    "[ref]\nenabled = true\nctor_call = \"acme_ns::make_ref\"\nfield_name = \"v\"\ntype_name = \"acme_ns::Cell\"\n",
    "recipes.toml",
    diags,
  )
  assert_eq(diags.length(), 0)
  let src = SourceFile::{
    rel_path: "types_ref.mbt",
    content: "pub struct Box[T] { pub item : T }\npub fn f(a : Box[Int?], b : Box[acme_ns::Item?], c : Array[(Int?, String?)]) -> Ref[Int] {\n  let x : Array[(Int?, String?)] = c\n  let _ = (a, b, x)\n  Ref(42)\n}\n",
    is_test: false,
  }
  let res = transpile_package([src], empty_api_map(), recipes, [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "import \"acme_ns\""), "auto-emits import \"acme_ns\"")
  assert_true(str_has(out, "Box[Option[Int]]"), "Box[Int?] -> Box[Option[Int]]")
  assert_true(str_has(out, "Box[Option[acme_ns::Item]]"), "Box[acme_ns::Item?] -> Box[Option[acme_ns::Item]]")
  assert_true(str_has(out, "Array[(Option[Int], Option[String])]"), "Array[(Int?, String?)] lowered in params and local let")
  assert_true(str_has(out, "acme_ns::make_ref(42)"), "Ref(42) directly lowered by [ref] recipe in Stage A")
}

test "BUG-5: init_order skips closures and uncalled fn values without false cycles, keeps real cycles" {
  let ok_src = SourceFile::{
    rel_path: "closures.mbt",
    content: "let a : () -> Int = fn() { b }\nlet b : Int = 1\nlet cb : () -> Int = read_cb\nfn read_cb() -> Int { let _ = cb; b }\nlet arrow_cb : (Int) -> Int = (x) => x + b\n",
    is_test: false,
  }
  let ok_res = transpile_package([ok_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_eq(ok_res.blockers, 0)
  assert_true(ok_res.files[0].rel_path == "00_init_order.pion", "00_init_order.pion emitted without false cycle")

  let cyc_src = SourceFile::{
    rel_path: "real_cyc.mbt",
    content: "let x : Int = y + 1\nlet y : Int = x + 1\n",
    is_test: false,
  }
  let cyc_res = transpile_package([cyc_src], empty_api_map(), default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(cyc_res.blockers > 0, "real immediate cycle must still block")
  assert_true(cyc_res.diagnostics[0].code == "MBT2PION_INIT_CYCLE", "real cycle emits MBT2PION_INIT_CYCLE")
}

test "BUG-6: ambiguous cross-package ctor uses leading-dot .Case in exprs, blocks in patterns" {
  let mbti1 = ("p1/pkg.generated.mbti", "package \"org/p1\"\npub enum AlignA {\n  Top\n  Middle\n  Bottom\n}\n")
  let mbti2 = ("p2/pkg.generated.mbti", "package \"org/p2\"\npub enum AlignB {\n  Left\n  Middle\n  Right\n}\n")
  let expr_src = SourceFile::{
    rel_path: "expr.mbt",
    content: "pub fn use_expr() -> Int { let _ = @p1.take_a(Middle); let _ = @p2.take_b(Middle); 1 }\n",
    is_test: false,
  }
  let expr_res = transpile_package([expr_src], empty_api_map(), default_recipes(), [], [mbti1, mbti2], default_options(), [], false, noop_check)
  assert_eq(expr_res.blockers, 0)
  let out = expr_res.files[0].content
  assert_true(str_has(out, "p1::take_a(.Middle)"), "ambiguous expr ctor lowered to .Middle")
  assert_true(str_has(out, "p2::take_b(.Middle)"), "second ambiguous expr ctor lowered to .Middle")
  assert_true(str_has(out, "import \"p1\"") && str_has(out, "import \"p2\""), "auto-emits sorted imports for p1 and p2")

  let pat_src = SourceFile::{
    rel_path: "pat.mbt",
    content: "pub fn use_pat(x : Int) -> Int { match x { Middle => 1, _ => 0 } }\n",
    is_test: false,
  }
  let pat_res = transpile_package([pat_src], empty_api_map(), default_recipes(), [], [mbti1, mbti2], default_options(), [], false, noop_check)
  assert_true(pat_res.blockers > 0, "ambiguous ctor in pattern must still error")
  assert_true(pat_res.diagnostics[0].code == "MBT2PION_AMBIGUOUS_CTOR", "pattern ambiguity emits MBT2PION_AMBIGUOUS_CTOR")
}

test "BUG-7: recipes [derives] ignore and Ctor(..)/Ctor(.., ..) rest patterns with mbti/api_map arity" {
  let diags : Array[Diag] = []
  let recipes = parse_recipes_toml("[derives]\nignore = [\"Debug\"]\n", "recipes.toml", diags)
  assert_eq(diags.length(), 0)
  let am = parse_api_map("{\"symbols\":[{\"src_pkg\":\"ext\",\"src_name\":\"Quad\",\"kind\":\"ctor\",\"target_pkg\":\"ext\",\"target_name\":\"Quad\",\"target_enum\":\"Shape\",\"arity\":4}]}", "api_map.json", diags)
  assert_eq(diags.length(), 0)
  let src = SourceFile::{
    rel_path: "rest.mbt",
    content: "#derive(Debug, Eq)\npub struct Pt { x : Int }\npub enum Tri { Tri(Int, Int, Int) }\npub fn m1(t : Tri) -> Int { match t { Tri(..) => 1 } }\npub fn m2(t : Tri) -> Int { match t { Tri(.., ..) => 2 } }\npub fn m3(q : Int) -> Int { match q { Quad(a, ..) => a, _ => 0 } }\n",
    is_test: false,
  }
  let res = transpile_package([src], am, recipes, [], [], default_options(), [], false, noop_check)
  assert_eq(res.blockers, 0)
  let out = res.files[0].content
  assert_true(str_has(out, "#derive(Eq)"), "Eq kept while Debug ignored via recipe")
  assert_true(!str_has(out, "Debug"), "ignored Debug stripped")
  assert_true(str_has(out, "Tri(_, _, _)"), "Ctor(..) and Ctor(.., ..) expanded to 3 wildcards")
  assert_true(str_has(out, ".Quad(a, _, _, _)"), "cross-pkg Quad(a, ..) expanded using api_map arity=4")

  // Without recipe ignore, #derive(Debug) must still hard-fail!
  let no_rec = transpile_package([src], am, default_recipes(), [], [], default_options(), [], false, noop_check)
  assert_true(no_rec.blockers > 0, "Debug without ignore recipe must still hard-fail")
  assert_true(no_rec.diagnostics[0].code == "MBT2PION_UNKNOWN_DERIVE", "emits MBT2PION_UNKNOWN_DERIVE")
}
